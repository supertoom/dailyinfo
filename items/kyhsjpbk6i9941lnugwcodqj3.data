[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795480837000,"id","kyhsjpbk6i9941lnugwcodqj3","title","西班牙 LaLiga 确认遭网络攻击，球迷个人数据被窃取","originalTitle","Spanish LaLiga confirms hackers stole soccer fans’ personal data","summary","LaLiga 通报其球迷服务平台遭网络攻击，攻击发生在 11 月 14 日至 16 日之间，网络犯罪分子入侵系统并提取了注册用户及部分附属俱乐部的个人数据。安全团队于 11 月 16 日定位到未授权访问来源并实施阻断，事件仅限该平台，未波及支撑赛事运行的其它系统。","reason","source",{"_73":96},"links",{"_61":95},"publishedAt","2026-11-23T18:38:40.000Z","discoveredAt","2026-11-23T19:13:31.568Z","timelineAt","category","activity","tags",[74,93,94],"score",56,"selected",false,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","Bill Toulas","body",{"_89":-5,"_61":90,"_91":-5,"_92":36},"outline",[83],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fTo2nINYQs90","reportCount",1,"additionalSourceCount",0,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","attack","name","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件",{"_80":81,"_13":82},"publicId","eaff45fa-1551-4bde-b530-3dc70353880f","LaLiga球迷平台遭入侵，个人数据被盗",{"_11":84,"_85":86,"_87":88},"sec-1","text","Uncover email threats your existing defenses may miss.","level",2,"zh","<p><img alt=\"Spanish LaLiga confirms hackers stole soccer fans’ personal data\" height=\"900\" src=\"/dailyinfo/media/cfa696334c7f084c.jpg\" srcset=\"/dailyinfo/media/b851eb602bda484a.jpg 720w, /dailyinfo/media/2a1b3cd08577f4f9.jpg 1200w, /dailyinfo/media/cfa696334c7f084c.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>LaLiga, Spain's top men's professional football league, disclosed a data breach that exposed personal information belonging to users of its services and those of some affiliated clubs.</p><p>According to the organization, the incident occurred between November 14 and 16, and the attacker extracted data from compromised systems.</p><p>LaLiga organizes Spain’s top two men’s professional football divisions.</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/ec0400265c732eea.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>The top league is one of the world’s most prominent football leagues, where clubs with a global audience, such as Real Madrid, FC Barcelona, and Atlético Madrid, play.</p><p>On November 16, the organization’s security team identified the source of the unauthorized access and implemented measures to block the attack and stop the data extraction.</p><p>“LALIGA was the target of a cyberattack on one of its technology platforms for fan services,” <a href=\"https://www.laliga.com/noticias/laliga-ha-sido-victima-de-un-ciberataque-que-ha-afectado-a-datos-personales-de-aficionados\">reads the announcement</a>.</p><p>“Between November 14 and 16, a cybercriminal gained unauthorized access to the platform and extracted personal data belonging to users registered for digital services offered by LALIGA and some clubs.”</p><p>LaLiga underlined that the incident was confined to a specific platform and did not extend to other systems that support the running of the competitions.</p><p>After implementing containment measures, LaLiga launched an investigation to determine the scope of the incident and introduced more thorough monitoring to detect future attempts to breach its systems.</p><p>The football organizer also reported the incident to the Spanish Data Protection Agency (AEPD) and filed a complaint with the National Police’s Central Cybercrime Unit.</p><p>Impacted clubs were also directly notified, and actions to inform impacted fans are being coordinated.</p><p>At the time of writing, no ransomware group has claimed responsibility for the attack on LaLiga.</p><p>BleepingComputer has contacted the organization to learn more about the attack and which clubs were impacted, but we have not received a response as of publication.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/af2e1e4209b93434.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Uncover email threats your existing defenses may miss.</a>\n        </h2><p>Adaptive Security's AI agents analyze email intent, context, and behavior to uncover phishing, business email compromise, and invoice fraud.</p><p>See what's getting through with a 14-day read-only scan of Microsoft 365 or Google Workspace, with no MX changes.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Start your free email security scan.</a>\n    </p>","zhKind","complete","数据泄露","数据窃取","https://www.bleepingcomputer.com/news/security/spanish-laliga-confirms-hackers-stole-soccer-fans-personal-data/","BleepingComputer",{"_98":99,"_100":-5},"changelogVersion","2026-10-01T08:00","release"]
