[{"_1":2,"_3":4},"root",{"_5":111},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":37,"_59":60},"expiresAt",1794444099000,"id","vv489im3zncsb62sidnpbvifn","title","Binance 遭遇 $6.3bn 加密货币盗窃，已冻结 $3bn","originalTitle","Binance Hit by Record-Breaking $6.3bn Hack in Largest Cryptocurrency Heist in History","summary","Binance 确认遭遇史上规模最大的网络攻击，$6.3bn 加密货币被盗，已冻结 $3bn 赃款，并将通过 Secure Asset Fund for Users (SAFU) 和公司资金赔偿全部损失。","reason","原文披露了攻击规模、疑似入口、提币暂停状态及资金追踪进展，为加密资产交易所的安全处置提供具体参考。","source",{"_75":110},"links",{"_101":109},"publishedAt","2026-10-30T11:25:00.000Z","discoveredAt","2026-10-30T11:43:15.788Z","timelineAt","category","activity","tags",[76,105,78,106,107,108],"score",77,"selected",true,"channel","news","story",{"_88":89,"_13":90},"x","readingMode","full","author","body",{"_60":100,"_101":-5,"_102":103,"_104":37},"outline",[91,92],"relatedStories",[87],"topics",[67,68,69,70,71,72],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","fdZOEFF7CxlI","reportCount",1,"additionalSourceCount",0,{"_73":85,"_75":86},{"_73":83,"_75":84},{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","attack","name","攻击活动","exploited","在野利用","black-market","数据窃取与黑产","ransomware","勒索软件","crypto","密码学","supply-chain","供应链安全",{"_88":89,"_13":90},"publicId","38c994c0-07a4-4dd2-a05c-af41ea8ee1e3","Binance确认遭攻击损失63亿美元",{"_11":98,"_94":99,"_96":97},{"_11":93,"_94":95,"_96":97},"sec-2","text","Binance 在调查持续期间暂停提现","level",2,"sec-1","撰写者","<h2 id=\"sec-1\">撰写者</h2><p><img src=\"/dailyinfo/media/762ad79fe902b33a.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Photo of Kevin  Poireault\"></p><p>\n\t全球加密货币巨头 Binance 已确认其遭遇了史上规模最大的网络攻击，导致价值 $6.3bn 的加密货币被盗。</p><p>\n\t这家由中国创立、总部位于迪拜并在 Delaware 注册的公司表示，已冻结 $3bn 的被盗资金，并将使用其 Secure Asset Fund for Users (SAFU) 和公司资金承担所有损失。</p><p>\n\t根据公司 10 月 30 日发布的声明，其调查表明，攻击者的入口可能是一台遭入侵的 Binance 开发与运营 (DevOps) 工程师的笔记本电脑。</p><p>\n\t据称，这使攻击者得以访问服务容器并提交未经授权的提币交易。</p><p>\n\t不过，Binance 此后修正了这项评估，并表示后续调查发现了更多入侵点。</p><p>\n\t该公司称：“这是一次复杂的攻击。”同时补充表示，正与执法机构、区块链情报公司、代币发行方及其他行业合作方合作，以查明完整情况，并识别和追回受影响的资产。</p><p>\n\tBinance 尚未提供有关此次攻击的最终说明，称仍在收集事实，并将在调查完成后发布一份全面的技术复盘报告。</p><p>\n\t该公司表示，尚未发现任何钱包私钥泄露的证据。</p><p>\n\t在其发布的许多<a href=\"https://x.com/binance/status/2116089661408108712\">社交媒体更新</a>中，该交易所反复强调，尽管事件规模巨大，客户资金仍然安全。它还承诺在补救工作完成后发布更新后的储备金证明，为客户提供针对用户余额所持资产的最新情况。</p><p>\n\t三家全球领先的加密货币分析机构 <a href=\"https://www.trmlabs.com/resources/blog/north-korea-steals-usd-6-36-billion-from-binance-in-the-largest-hack-in-history\">TRM Labs</a>、<a href=\"https://www.elliptic.co/insights/binance-largest-hack-in-history/\">Elliptic</a> 和 <a href=\"https://www.chainalysis.com/blog/binance-exploit-latest-findings-and-response/\">Chainalysis</a> 均以“高度确信”将此次攻击归因于朝鲜黑客组织 TraderTraitor。</p><figure><img src=\"/dailyinfo/media/d5a8fe3a894f5749.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"Source: Elliptic\"><figcaption>来源：Elliptic</figcaption></figure><h2 id=\"sec-2\">\n\t<strong>Binance 在调查持续期间暂停提现</strong></h2><p>\n\t随着调查的推进，Binance 采取了一系列预防措施。</p><p>\n\t这些措施包括暂时暂停所有充值和提现，以及 Binance Alpha 交易活动，具体包括 CEX Buy Token、Alpha Instant，以及使用用户现货钱包资金进行的 CEX 购买预测营销活动。</p><p>\n\t不过在最新更新中，Binance 澄清充值已恢复正常运营，且不受影响。</p><p>\n\t截至撰写时提现仍处于暂停状态，公司正在完成提现服务及相关地址的安全改造，预计将在 45 小时内恢复提现。</p><p>\n\t公司还确认，在暂停提现后，未授权的资金外流已经停止。公司已撤销受影响地址的授权，并继续与执法机构及区块链合作伙伴合作，以追踪并冻结受影响资产。</p><p>\n\t建议 Binance 客户警惕可能利用此次事件实施诈骗的行为。Binance 特别提醒用户不要相信非官方链接、消息或索取账户信息的请求。</p><p>\n\t建议客户仅通过其官方沟通渠道获取最新信息；如有疑问，请联系 Binance 客户支持。</p><p>\n\t<em>图片来源：&nbsp;miss.cabul / K.unshu / Shutterstock.com</em></p>","original","zhKind","translation","complete","数据窃取","供应链","加密","黑产","https://www.infosecurity-magazine.com/news/binance-record-hack-crypto-heist/","Infosecurity Magazine",{"_112":113,"_114":-5},"changelogVersion","2026-10-01T08:00","release"]
