[{"_1":2,"_3":4},"root",{"_5":107},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1794444091000,"id","axr27uaonqbe9hf5mi41iz6tc","title","Maersk 确认 WhiteArmor 勒索攻击，团伙声称窃取约 100GB 数据并索要 500 万美元","originalTitle","Maersk confirms data breach as WhiteArmor ransomware demands $5 million","summary","Maersk 确认其此前收购公司的系统遭入侵并发生数据失窃，WhiteArmor 勒索团伙声称从 OCF/LF Logistics 平台外传约 100 GB 数据，并在周末索要 500 万美元。","reason","source",{"_74":106},"links",{"_61":105},"publishedAt","2026-11-11T16:24:18.000Z","discoveredAt","2026-11-11T17:18:06.220Z","timelineAt","category","activity","tags",[102,103,77,75,104],"score",56,"selected",false,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Bill Toulas","body",{"_98":-5,"_61":99,"_100":-5,"_101":36},"outline",[86,87,88],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fHo2KZPYjArg","reportCount",2,"additionalSourceCount",1,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","malware","name","恶意软件","attack","攻击活动","ransomware","勒索软件","supply-chain","供应链安全",{"_83":84,"_13":85},"publicId","41dc60b4-3949-4993-9807-db2659b6034b","马士基确认收购遗留系统遭勒索窃密",{"_11":96,"_90":97,"_92":95},{"_11":93,"_90":94,"_92":95},{"_11":89,"_90":91,"_92":65},"sec-3","text","Uncover email threats your existing defenses may miss.","level","sec-2","Ransomware gang claims 100GB data theft",3,"sec-1","Legacy system compromise","zh","<p><img alt=\"Maersk confirms data breach as WhiteArmor ransomware demands $5 million\" height=\"900\" src=\"/dailyinfo/media/f8f7e9f87327bedb.jpg\" srcset=\"/dailyinfo/media/36aae3d924ecce6e.jpg 720w, /dailyinfo/media/57d175510382fe97.jpg 1200w, /dailyinfo/media/f8f7e9f87327bedb.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>Shipping giant Maersk has confirmed that a threat actor breached systems belonging to a company it previously acquired and stole data.</p><p>Ransomware group WhiteArmor claimed the attack over the weekend, threatening that it would release about 100GB of information allegedly exfiltrated from the company's logistics and supply-chain platform.</p><h3 id=\"sec-1\">Legacy system compromise</h3><p>The investigation into the incident is ongoing, but the shipping firm says that current evidence indicates that \"no sensitive data has been disclosed.\"</p><p><a href=\"https://www.wiz.io/lp/securing-ai-agents-101?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY26Q3_INB_FORM_Securing-AI-Agents-101&amp;sfcid=701Py00000RTEWMIA5&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AI-Agents-101\"><img src=\"/dailyinfo/media/2ddb46eee4d24330.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>Maersk added that it does not expect disruptions to operations, and assures customers that they can continue booking and managing shipments through its systems as usual.</p><p>“The incident is isolated to a local system, and we have found no indication that there has been any impact on other Maersk systems or customer and partner systems that connect to Maersk through integrations such as APIs and EDI,” <a href=\"https://www.maersk.com/news/articles/2026/11/11/it-security-incident\">Maersk states</a>.</p><p>A.P. Moller–Maersk is a Danish shipping and logistics group and one of the world’s largest container carriers by fleet capacity. The company operates ocean freighters, port terminals, warehouses, and air and land transport services across 130 countries.</p><p>It has <a href=\"https://www.maersk.com/about\">700&nbsp;container ships</a>, roughly 13.5% of the global fleet capacity, 60 terminals in 35 countries, and employs 100,000 people. Last year, Maersk reported $54 billion in revenue and $2.9 billion in net profit.</p><p>Maersk said the incident has been isolated, but did not share details about the affected system, the compromised data types, or when the intrusion occurred.</p><p>BleepingComputer reached out to Maersk with additional questions, but we have not heard back as of publishing.</p><h3 id=\"sec-2\">Ransomware gang claims 100GB data theft</h3><p>Over the weekend, the WhiteArmor ransomware gang listed Maersk on its data leak site and publicly asked for a ransom payment of $5million.</p><p>\"Your contract-logistics arm, the former LF Logistics, runs fulfilment for many of the world's largest consumer brands. Five million dollars is roughly four hours of that EBITDA,\" the threat actor said.</p><p>\"You have 30 days to contact us and pay USD 5,000,000 in bitcoin,\" reads WhiteArmor's public message.</p><p>WhiteArmor claims to hold approximately 100 GB of data allegedly stolen from Maersk's OCF/LF Logistics platform, which the group is using to support its extortion demands.</p><p>In 2022, Maersk acquired LF Logistics, the original developer of the OCF/LF Logistics platform, from the Li &amp; Fung Group.</p><p>According to the threat actor, the data they hold includes nearly 30,000 drivers records, plaintext passwords, 33 SUPER_ADMIN accounts (the most privileged on a system), signed delivery receipts, and 14.44 inventory rows with purchase orders and Advance Shipping Notice (ASNs).</p><p>The hacker also claims to hold 27,842 mobile device logs that include phone numbers, emails, and IMEI (International Mobile Equipment Identity) numbers.</p><figure><img alt=\"\" height=\"647\" src=\"/dailyinfo/media/fecab949d55490ad.webp\" loading=\"lazy\" decoding=\"async\" width=\"600\">\n<figcaption><strong>WhiteArmor ransomware lists Maersk, asks for $5 million</strong><br>\n<em>source: BleepingComputer</em></figcaption>\n</figure><p>Maersk noted in the disclosure today that \"the incident is isolated to a local system\" and that it would notify customers \"as more relevant information becomes available, and if we identify any need to inform impacted parties of any further findings.\"</p><p>\"As always, please treat any unexpected communications claiming to relate to this matter with caution and verify them through your usual Maersk contact,\" the company advises.</p><p>In 2017, Maersk was hit by NotPetya ransomware, forcing it to rebuild an infrastructure of over <a href=\"https://www.bleepingcomputer.com/news/security/maersk-reinstalled-45-000-pcs-and-4-000-servers-to-recover-from-notpetya-attack/\">4,000 servers and 45,000 workstations</a> from scratch.</p><p>At the time, the company was forced to operate without IT for ten days, incurring damages of up to $300 million.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/0c6c2476908e136e.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-3\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Uncover email threats your existing defenses may miss.</a>\n        </h2><p>Adaptive Security's AI agents analyze email intent, context, and behavior to uncover phishing, business email compromise, and invoice fraud.</p><p>See what's getting through with a 14-day read-only scan of Microsoft 365 or Google Workspace, with no MX changes.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Start your free email security scan.</a>\n    </p>","zhKind","complete","勒索","数据泄露","供应链","https://www.bleepingcomputer.com/news/security/maersk-confirms-data-breach-as-whitearmor-ransomware-demands-5-million/","BleepingComputer",{"_108":109,"_110":-5},"changelogVersion","2026-10-01T08:00","release"]
