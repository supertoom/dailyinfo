[{"_1":2,"_3":4},"root",{"_5":99},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794357642000,"id","sqpejfy24tujmwbg86c963iio","title","DreamHost确认数据泄露，FTP/SFTP凭据与部分webmail会话信息遭窃取","originalTitle","DreamHost confirms data breach exposed FTP logins and webmail sessions","summary","DreamHost确认，攻击者利用File Manager漏洞访问files.dreamhost.com并窃取客户FTP/SFTP用户名和密码，入侵从2026年8月持续至2026年10月23日；有限数量用户的webmail会话信息及凭据也可能被访问。","reason","DreamHost披露了攻击持续时间、被窃凭据类型和处置措施，可供用户核对账户、转发规则并处置复用密码。","source",{"_73":98},"links",{"_90":97},"publishedAt","2026-11-04T19:05:19.000Z","discoveredAt","2026-11-04T19:52:21.569Z","timelineAt","category","activity","tags",[74,94,95,96],"score",73,"selected",true,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","Bill Toulas","body",{"_61":89,"_90":-5,"_91":92,"_93":37},"outline",[83],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fBBE9RhPXSy8","reportCount",1,"additionalSourceCount",0,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","attack","name","攻击活动","email","邮件与钓鱼","identity","身份与访问",{"_80":81,"_13":82},"publicId","59fba26a-7834-4556-b608-46af6e689b7e","DreamHost确认File Manager漏洞致数据泄露",{"_11":84,"_85":86,"_87":88},"sec-1","text","发现现有防御可能遗漏的电子邮件威胁。","level",2,"<p><img alt=\"DreamHost\" height=\"900\" src=\"/dailyinfo/media/bf3ba34ffdb241e7.jpg\" srcset=\"/dailyinfo/media/e44959d96b332efe.jpg 720w, /dailyinfo/media/a6f66f3a78ee69cf.jpg 1200w, /dailyinfo/media/bf3ba34ffdb241e7.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>DreamHost 警告称发生数据泄露：攻击者入侵其 File Manager 平台长达两个月，并窃取了客户的 FTP/SFTP 用户名和密码。</p><p>此前，这家美国网页托管服务商和域名注册商宣布，其<a href=\"https://www.bleepingcomputer.com/news/security/dreamhost-forces-email-ftp-sftp-password-resets-in-ongoing-incident/\">遭遇网络安全事件</a>，用户需要重置电子邮件及 FTP/SFTP 密码。</p><p>DreamHost 在数据泄露通知中表示，此次泄露从 2026 年 8 月持续至 2026 年 10 月 23 日，即事件被发现之日。</p><p><a href=\"https://www.wiz.io/lp/ai-security-starter-pack?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Security-Starter-Kit&amp;sfcid=701Vh00000cn7aRIAQ&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AI-Security-Bundle\"><img src=\"/dailyinfo/media/69a34b3179f0011b.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>通知称：“我们发现未经授权的第三方访问了运行 files.dreamhost.com 上基于网页的 File Manager 的服务器，”<a href=\"https://oag.ca.gov/system/files/DreamHost%20-%20Data%20Security%20Breach%20Notice%20Letter%20%28USA%20other%20than%20MA%29%20261102.1.pdf\">通知中写道</a>。</p><p>“该未经授权的第三方利用了上述软件中的漏洞，因此能够获取大约在 2026 年 8 月至 2026 年 10 月 23 日期间登录此 File Manager 的个人用户的 FTP/SFTP 用户名和密码。”</p><p>此外，DreamHost 表示，入侵者可能还访问了网页邮件系统，导致数量有限的用户会话信息（包括凭据）泄露。</p><p>该公司称，此次攻击似乎是有意为之，员工一直 nonstop 地开展工作，以彻底遏制此次攻击。</p><p>DreamHost 表示，目前尚未发现攻击者访问控制面板登录信息或客户账单/付款详情的证据；这些信息由外部服务商处理。</p><p>该公司表示，已阻止攻击者访问，并修复了此次攻击所利用的漏洞。</p><p>该公司还终止了可能受影响用户的活动会话，并使密码失效。</p><p>BleepingComputer 已多次联系 DreamHost，询问有关该事件及受影响账户确切数量的问题，但尚未得到答复。</p><p>通知接收者应检查网站文件是否遭到未经授权的更改，审查网页邮件转发规则和筛选器，并更改其可能使用相同凭据的任何其他账户的密码。</p><p>为降低此次信息暴露带来的风险，DreamHost 通过 Equifax 向受影响的个人用户提供一年的信用监控和身份盗窃保护服务。</p><p>信件接收者还应考虑在信用报告中设置欺诈警报，或申请安全冻结。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/ec08be135363bed0.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能代理会分析电子邮件意图、上下文和行为，发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>对 Microsoft 365 或 Google Workspace 进行为期 14 天的只读扫描，无需更改 MX 设置，即可查看哪些内容能够通过。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始免费电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","数据泄露","凭据","邮件安全","https://www.bleepingcomputer.com/news/security/dreamhost-confirms-data-breach-exposed-ftp-logins-and-webmail-sessions/","BleepingComputer",{"_100":101,"_102":-5},"changelogVersion","2026-10-01T08:00","release"]
