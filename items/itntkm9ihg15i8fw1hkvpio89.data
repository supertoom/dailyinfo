[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794616829000,"id","itntkm9ihg15i8fw1hkvpio89","title","SvelteKit 预渲染路径在 @sveltejs/adapter-vercel 与 @sveltejs/adapter-static 生成的 Vercel 路由配置中被当作正则表达式解析","originalTitle","SvelteKit: Prerendered paths are interpreted as regular expressions in Vercel route config generated by @sveltejs/adapter-vercel and @sveltejs/adapter-static","summary","SvelteKit 在 @sveltejs/adapter-vercel 和 @sveltejs/adapter-static 生成 Vercel 路由配置时，会将预渲染路径解释为正则表达式。若攻击者能影响预渲染阶段被抓取的链接，该链接之后可能被当作 Vercel 路由配置中的 regex 解析。","reason","source",{"_69":80},"links",{"_59":79},"publishedAt","2026-11-13T20:43:23.000Z","discoveredAt","2026-11-13T20:52:25.854Z","timelineAt","category","vuln","tags",[77,78],"score",40,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fRyyvTRIlDbI","reportCount",1,"additionalSourceCount",0,{"_68":71,"_69":72},{"_68":30,"_69":70},"slug","name","漏洞披露","supply-chain","供应链安全",{"_74":75,"_13":76},"publicId","5201a2ef-d68c-46a7-9026-ffe3cb858a93","SvelteKit预渲染路径被解析为Vercel正则","漏洞","供应链","https://github.com/advisories/GHSA-jf9x-2fg2-hx4w","GitHub 安全公告",{"_82":83,"_84":-5},"changelogVersion","2026-10-01T08:00","release"]
