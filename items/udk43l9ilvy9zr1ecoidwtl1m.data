[{"_1":2,"_3":4},"root",{"_5":110},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1795480845000,"id","udk43l9ilvy9zr1ecoidwtl1m","title","Cleverbridge 确认攻击者从平台复制支付卡数据","originalTitle","Cleverbridge Confirms Attackers Copied Payment Card Data From Its Platform","summary","Cleverbridge 确认第三方攻击者从其支付平台复制了支付卡数据，事件于 4 November 2026 发现，受影响人员从 20 November 起收到通知。","reason","source",{"_76":109},"links",{"_96":108},"publishedAt","2026-11-23T19:14:17.000Z","discoveredAt","2026-11-23T20:41:41.395Z","timelineAt","category","activity","tags",[102,77,103,104,105,106,107],"score",72,"selected",true,"channel","news","story",{"_87":88,"_13":89},"x","sameEvent",{"_11":100,"_13":101},"readingMode","full","author","Pierluigi Paganini","body",{"_62":95,"_96":-5,"_97":98,"_99":36},"outline",[90],"relatedStories",[86],"topics",[69,70,71,72,73],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","fea8ayf9y9fE","reportCount",3,"additionalSourceCount",2,{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","attack","name","攻击活动","red-team","红队与渗透","black-market","数据窃取与黑产","ransomware","勒索软件","identity","身份与访问",{"_87":88,"_13":89},"publicId","42900179-ad52-4751-bb13-47a610d3391c","Cleverbridge确认客户支付卡数据失窃",{"_11":91,"_92":93,"_94":68},"sec-1","text","Cleverbridge 证实，攻击者窃取了银行卡号、有效期和 CVV 代码，并警告客户留意欺诈交易。","level","<h2 id=\"sec-1\">Cleverbridge 证实，攻击者窃取了银行卡号、有效期和 CVV 代码，并警告客户留意欺诈交易。</h2><p>Cleverbridge 为其他公司运营结账、支付和订阅服务。该公司已证实，攻击者从其平台复制了支付卡数据。公司称于 11 月 4 日发现此问题，并于 11 月 20 日开始通知受影响的用户。这中间相隔 16 天。</p><p><em>“2026 年 11 月 4 日，Cleverbridge 检测到我们的平台存在未经授权的活动，并立即采取措施控制此次事件。”公司在发布的<a href=\"https://grow.cleverbridge.com/incident-update\">事件更新</a>中写道。“尽管我们的调查仍在进行，但遗憾的是，我们已确认第三方复制了存储在我们平台上的支付卡数据。”</em></p><p>受影响的系统短暂下线，并于当天恢复上线。直到后来，调查才显示第三方复制了存储在平台上的支付卡数据；公司表示调查仍在进行中。</p><p>该公司官网列出的客户包括 SUSE、Red Hat 和 Parallels，但公司尚未说明哪些企业受到影响。</p><p>如果你从使用 Cleverbridge 的公司购买了产品或服务，该公司可能处理过你的付款并存储了你的银行卡详细信息。Cleverbridge 为软件和 SaaS 公司提供支付及订阅服务。</p><p>Cleverbridge 在其公开事件页面上并未清楚说明哪些信息被窃取。它称泄露的数据可能包括支付卡详细信息，并让受影响的客户查看各自的通知。不过，一份由 <a href=\"https://www.bleepingcomputer.com/news/security/cleverbridge-warns-hackers-stole-credit-card-numbers-cvvs-in-data-breach/\">BleepingComputer</a> 审核的通知提供了更多细节：被窃取的信息可能包括卡号、有效期以及 CVV 或 CVC 安全代码。</p><p>最后这一项最为关键。银行卡行业的规则通常禁止公司在支付获得授权后继续保存安全代码，因此 BleepingComputer 询问 Cleverbridge，为何这些代码仍可访问。</p><p>该公司未披露有关此次攻击的技术细节，但其答复排除了勒索软件攻击。</p><p><em>“我们的任何系统都没有被加密。”更新内容继续写道。</em></p><p>Cleverbridge 表示，它聘请了第三方供应商 TransUnion/Cyberscout 协助发送通知，并称代表其发送的通知是真实有效的。在可提供相关服务的情况下，它已提供信用监控或身份监控服务，注册详情见通知。当被问及为何未更早通知用户时，公司称其采取了迅速行动，并在没有不当延迟的情况下通知了用户。</p><p>Cleverbridge 建议用户警惕网络钓鱼企图，并警告称，它绝不会通过电子邮件、电话或短信索要银行卡详细信息、密码或安全代码。</p><p><em>“与往常一样，我们建议用户遵循一般的在线安全最佳实践，保持警惕，并注意防范网络钓鱼企图。”公司表示。“为格外谨慎起见，请对有关此次事件的意外电子邮件、来电或消息保持警惕。Cleverbridge 绝不会通过电子邮件、电话或短信向你索要银行卡详细信息、密码或安全代码。”</em></p><p>请尽早联系你的发卡机构。Cleverbridge 表示，在你报告此次事件后，发卡机构可能会决定更换你的银行卡。</p><p><em>我们建议你仔细查看信用卡对账单，并立即将任何你不认识的交易告知你的发卡机构。”报告总结道。“你也可能希望联系你的发卡机构，将此事件告知他们，并遵循他们提供的任何建议，因为他们可能会决定更换你的信用卡。 ”</em></p><p><strong>在 Twitter 上关注我：&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;和&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;和&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a><strong></strong></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;黑客、支付卡数据)</strong></p>","original","zhKind","translation","complete","mka3rxabqos640n2q50926yhp","Cleverbridge 确认平台客户支付卡数据遭窃取","数据泄露","数据窃取","凭据","红队","Red Hat","VMware","https://securityaffairs.com/203851/data-breach/cleverbridge-confirms-attackers-copied-payment-card-data-from-its-platform.html","Security Affairs",{"_111":112,"_113":-5},"changelogVersion","2026-10-01T08:00","release"]
