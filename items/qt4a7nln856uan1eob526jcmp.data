[{"_1":2,"_3":4},"root",{"_5":114},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1794271236000,"id","qt4a7nln856uan1eob526jcmp","title","QNAP称Plex2Shell漏洞链已被用于入侵NAS设备","originalTitle","QNAP says hackers breaching NAS devices in Plex2Shell attacks","summary","Plex2Shell漏洞链已被用于攻击暴露在公网的QNAP NAS，QNAP称已收到多起客户设备疑似失陷报告。该漏洞链包含CVE-2026-96652、CVE-2026-96654、CVE-2026-96655和CVE-2026-96656，CISA于2026年10月20日将其列入KEV目录。","reason","source",{"_77":113},"links",{"_103":112},"publishedAt","2026-11-06T17:04:23.000Z","discoveredAt","2026-11-07T00:34:28.681Z","timelineAt","category","activity","tags",[78,80,109,84,110,111,88],"score",78,"selected",true,"channel","news","story",{"_90":91,"_13":92},"x","sameEvent",{"_11":107,"_13":108},"readingMode","full","author","Bill Toulas","body",{"_62":102,"_103":-5,"_104":105,"_106":36},"outline",[93,94],"relatedStories",[89],"topics",[69,70,71,72,73,74],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","fFSkQHjo1myE","reportCount",2,"additionalSourceCount",1,{"_75":87,"_77":88},{"_75":85,"_77":86},{"_75":83,"_77":84},{"_75":81,"_77":82},{"_75":79,"_77":80},{"_75":76,"_77":78},"slug","attack","name","攻击活动","exploited","在野利用","vuln","漏洞披露","vuln-mgmt","漏洞管理","iot","IoT 与车联网","cisa","CISA",{"_90":91,"_13":92},"publicId","3bf9dc47-b085-4827-80e7-55c10644d767","QNAP确认Plex2Shell已入侵公网NAS",{"_11":99,"_96":100,"_98":101},{"_11":95,"_96":97,"_98":66},"sec-2","text","发现现有防御可能遗漏的电子邮件威胁。","level","sec-1","需要用户采取行动",3,"<p><img alt=\"QNAP says hackers breaching NAS devices in Plex2Shell attacks\" height=\"900\" src=\"/dailyinfo/media/505ec42835aa4110.jpg\" srcset=\"/dailyinfo/media/65b2455db825236b.jpg 720w, /dailyinfo/media/7fc39324e8d695fc.jpg 1200w, /dailyinfo/media/505ec42835aa4110.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>QNAP 敦促用户将 Plex Media Server 更新至 QNAP App Center 中可用的最新版本，因为黑客正在利用 Plex2Shell 漏洞链。</p><p>该厂商表示，已收到多起疑似入侵事件的报告，涉及客户的网络附加存储（NAS）设备。</p><p>“QNAP 已收到部分用户的报告，称其 NAS 上的 Plex Media Server 似乎已通过 [Plex2Shell] 漏洞遭到入侵，QNAP 技术支持正在协助受影响的用户，”该公司在今天发布的安全公告中表示。</p><p><a href=\"https://www.wiz.io/lp/securing-ai-agents-101?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY26Q3_INB_FORM_Securing-AI-Agents-101&amp;sfcid=701Py00000RTEWMIA5&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AI-Agents-101\"><img src=\"/dailyinfo/media/d0f0c82096e19100.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>Plex2Shell 是 Plex Media Server 中的四个漏洞组成的漏洞链，编号分别为 CVE-2026-96652、CVE-2026-96654、CVE-2026-96655 和 CVE-2026-96656。</p><p>安全研究员 <a href=\"https://zmain.info/blog/plex2shell\">Zach Main 发现并向 Plex 报告了</a>这些漏洞，时为 7 月 27 日。10 月 16 日完整技术细节公开后不久便开始遭到利用。</p><p>CISA 于 2026 年 10 月 20 日将这四个漏洞全部加入其已知被利用漏洞目录，<a href=\"https://www.bleepingcomputer.com/news/security/cisa-hackers-chain-plex-flaws-in-plex2shell-attacks-to-breach-servers/\">敦促联邦机构在三天内升级</a>至 Plex 1.43.3.10861 或更高版本，并给予最高优先级。</p><p>QNAP 的 NAS 设备是内置存储的专用计算机，使用户能够跨网络存储、访问和共享文件。它们通常用于备份计算机和存储媒体文件。</p><p>用户还可以通过 QNAP App Center 安装应用程序来扩展设备功能，例如 Plex Media Server，它可直接从 NAS 驱动器串流电影、电视节目和音乐。</p><p>QNAP 建议用户将 Plex Media Server 更新至通过 QNAP App Center 提供的最新版本，目前为 1.43.3.10861，以防范 Plex2Shell 攻击。</p><p>“QNAP 产品安全事件响应团队（QNAP PSIRT）已确认，这些漏洞仅存在于 Plex Media Server；QTS、QuTS hero 和其他 QNAP 操作系统本身不受影响，”该厂商表示。</p><h3 id=\"sec-1\">需要用户采取行动</h3><p>QNAP 表示，如果用户运行的是暴露在公共互联网上的易受攻击 Plex 服务器，则应将其 NAS 设备及所有个人内容视为已遭入侵。</p><p>该厂商警告称，立即更新不会移除攻击者已经安装在设备上的任何有效载荷。</p><p>建议采取的措施是检查<a href=\"https://www.qnap.com/en/security-news/2026/qnap-security-notice-plex-media-server-vulnerabilities-plex2shell-update-to-1-43-3-10861-or-later-immediately\">安全公告</a>中分享的入侵迹象，对操作系统（QTS 或 QuTS hero）执行全新重装，然后重置 Plex 和 NAS 凭据。</p><p>不需要远程访问 Plex 的用户应禁用相关功能并停止转发 32400 端口。需要远程访问的用户则建议通过 VPN 连接。</p><p>QNAP 已发布详细的<a href=\"https://www.qnap.com/en/how-to/faq/article/plex2shell-check-and-remediation-faq-for-qnap-nas-users\">分步修复指南</a>，介绍如何执行上述操作。</p><p>该公司还提供对疑似入侵事件日志的调查服务，用户可通过 QNAP 技术支持门户提交日志。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/fade1788f362b90e.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-2\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 代理可分析电子邮件意图、上下文和行为，发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>通过为 Microsoft 365 或 Google Workspace 进行 14 天只读扫描，看看有哪些威胁正在穿透，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始您的免费电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","x6oeztqtbhbx3zfqc0j9gxbr1","QNAP 确认 Plex2Shell 漏洞链已被用于入侵 NAS 设备","漏洞利用","补丁","IoT","https://www.bleepingcomputer.com/news/security/qnap-says-hackers-breaching-nas-devices-in-plex2shell-attacks/","BleepingComputer",{"_115":116,"_117":-5},"changelogVersion","2026-10-01T08:00","release"]
