[{"_1":2,"_3":4},"root",{"_5":111},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1794876035000,"id","ujd164b9o8dvcu2kjib11yxgs","title","Barracuda 将云环境入侵溯源至 ARTEX AI 渗透测试框架","originalTitle","Barracuda links cloud breach to ARTEX AI-powered cyberattack","summary","Barracuda称，攻击者使用从第三方 AI 供应商处窃取的云访问密钥和开源 AI 渗透测试框架 ARTEX，在 11 月 1 日至 2 日的 44 小时内访问约 10 个云账户，并在 11 月 4 日被发现。","reason","source",{"_77":110},"links",{"_99":109},"publishedAt","2026-11-16T19:57:13.000Z","discoveredAt","2026-11-16T20:17:14.868Z","timelineAt","category","activity","tags",[78,80,105,106,107,108],"score",75,"selected",true,"channel","news","story",{"_90":91,"_13":92},"x","sameEvent",{"_11":103,"_13":104},"readingMode","full","author","Bill Toulas","body",{"_62":98,"_99":-5,"_100":101,"_102":36},"outline",[93],"relatedStories",[89],"topics",[69,70,71,72,73,74],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","fy7KDxMifBpw","reportCount",2,"additionalSourceCount",1,{"_75":87,"_77":88},{"_75":85,"_77":86},{"_75":83,"_77":84},{"_75":81,"_77":82},{"_75":79,"_77":80},{"_75":76,"_77":78},"slug","attack","name","攻击活动","ai-offense","AI 攻防","black-market","数据窃取与黑产","ransomware","勒索软件","identity","身份与访问","cloud-native","云与原生",{"_90":91,"_13":92},"publicId","1f142198-f6f4-4e60-a4cf-2d4bb1e3aec4","Barracuda披露云环境遭入侵",{"_11":94,"_95":96,"_97":66},"sec-1","text","发现现有防御可能遗漏的电子邮件威胁。","level","<p><img alt=\"Barracuda links cloud breach to ARTEX AI-powered cyberattack\" height=\"900\" src=\"/dailyinfo/media/ad42e81f15b065ca.jpg\" srcset=\"/dailyinfo/media/1c0729789f73ad11.jpg 720w, /dailyinfo/media/901b4cb66794975a.jpg 1200w, /dailyinfo/media/ad42e81f15b065ca.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>本月早些时候入侵网络与电子邮件安全公司 Barracuda 云环境的黑客，使用了被盗的云访问密钥和 ARTEX AI 渗透测试框架。</p><p>该公司称，攻击者在 11 月 1 日至 2 日之间的 44 小时内访问了其大约 10 个云账户。</p><p>攻击者的存在于 11 月 4 日被发现，Barracuda 的调查确定，开源的<a href=\"https://www.bleepingcomputer.com/news/security/fbi-warns-artex-ai-hacking-tool-is-powering-global-cyberattacks/\">AI 渗透测试框架 ARTEX</a>被用于此次“机器速度入侵”。</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/c31616610537ff64.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>该公司解释称，攻击者利用了先前一个项目期间提供给第三方供应商的云访问密钥。</p><p>Barracuda 表示：“供应商——一家从事 AI 工作的公司——完成那项工作后，我们没有停用该密钥。这是我们的失误。”</p><p>这家安全公司认为，攻击者于 10 月从未具名的第三方 AI 供应商处窃取了该密钥。该公司<a href=\"https://trust.barracuda.com/security/barracuda-xdr-integration-credentials\">证实</a>，该密钥存储在供应商 GitHub 仓库的一个配置文件中。</p><p>攻击者利用在一个系统中发现的凭据，横向进入 Barracuda 的数据分析环境、源代码仓库和 Kubernetes 集群。</p><p>根据攻击者针对加密货币相关机密（包括私钥、以太坊 keystore 文件和助记词）执行的命令，<a href=\"https://blog.barracuda.com/2026/11/11/anatomy-of-a-machine-speed-intrusion\">Barracuda 认为</a>此次攻击出于经济动机。</p><p>然而，该公司并未排除此次活动可能是为了转移攻击者真实动机注意力而采取的佯攻。</p><p>该威胁行为者试图通过部署一个挂载主机文件系统（包括存储在其中的凭据）的容器来建立持久化访问。</p><p>另一次创建新的云管理员身份的尝试被阻止。</p><p>Barracuda 表示，此次攻击使用了机器式标签、某些探测方法以及内置的狩猎例程，这些都与 ARTEX 中发现的内容相吻合。</p><p>该公司指出，此次攻击与云托管服务提供商 Railway 发生的<a href=\"https://www.bleepingcomputer.com/news/security/railway-warns-devs-to-rotate-secrets-after-potential-breach/\">近期事件</a>非常相似，后者同样涉及凭据链式利用以及<a href=\"https://www.bleepingcomputer.com/news/apple/railway-breach-leads-to-740-000-in-fraudulent-ai-charges/\">表面上的 ARTEX 使用</a>。</p><p>据这家网络安全公司称，攻击者进入了一个存储 Barracuda XDR 客户集成凭据的系统；不过，该公司未发现这些凭据被访问或窃取的证据。</p><p>由于围绕这一情况存在不确定性，Barracuda 要求可能受影响的 Managed XDR Cloud 或 Monitored Endpoint 客户撤销并重新生成其集成凭据。</p><p>Barracuda 向未收到此次事件相关直接通信的客户保证，他们无需采取任何行动。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/5441efe9afeba96b.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 代理可分析电子邮件意图、上下文和行为，以发现网络钓鱼、商务电子邮件入侵和发票欺诈。</p><p>查看有哪些威胁正在绕过防御：对 Microsoft 365 或 Google Workspace 进行为期 14 天的只读扫描，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始您的免费电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","wy00ijr8g20kod2rcokcs0tos","Barracuda 遭 Artex 驱动的云环境入侵，攻击持续约 44 小时","数据窃取","凭据","云原生","容器","https://www.bleepingcomputer.com/news/security/barracuda-links-cloud-breach-to-artex-ai-powered-cyberattack/","BleepingComputer",{"_112":113,"_114":-5},"changelogVersion","2026-10-01T08:00","release"]
