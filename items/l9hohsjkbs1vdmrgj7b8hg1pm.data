[{"_1":2,"_3":4},"root",{"_5":103},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":37,"_59":60},"expiresAt",1795653640000,"id","l9hohsjkbs1vdmrgj7b8hg1pm","title","European Commission 确认遭 AI 驱动网络攻击，多项应用被临时下线","originalTitle","European Commission Confirms AI-Driven Cyber-Attack Took Systems Offline","summary","European Commission 确认遭到使用公开 AI 工具实施的网络攻击，入侵于 2026 年 10 月 22 日被发现、10 月 26 日被定性为网络攻击，导致包括员工工资与考勤系统 Sysper、医疗报销系统在内的多项应用被临时下线，目前大部分已恢复。","reason","该事件展示了 AI 辅助漏洞探测与攻击编排工具已进入针对大型机构的实战，同时保留了数据是否外泄等关键调查问题。","source",{"_74":102},"links",{"_94":101},"publishedAt","2026-11-19T14:45:00.000Z","discoveredAt","2026-11-19T15:03:22.124Z","timelineAt","category","activity","tags",[79,81,77,98,99,100],"score",70,"selected",true,"channel","news","story",{"_85":86,"_13":87},"x","readingMode","full","author","body",{"_60":93,"_94":-5,"_95":96,"_97":37},"outline",[88],"relatedStories",[84],"topics",[67,68,69,70,71],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","fXfKfI-hw4rI","reportCount",3,"additionalSourceCount",2,{"_72":82,"_74":83},{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","tools","name","工具与平台","ai-security","AI 安全","attack","攻击活动","ai-offense","AI 攻防","red-team","红队与渗透",{"_85":86,"_13":87},"publicId","94471d20-e283-4a73-a257-3bf90d7be5de","欧盟委员会确认EU Academy用户数据泄露",{"_11":89,"_90":91,"_92":66},"sec-1","text","欧盟委员会遭攻击：“AI 生成”","level","<p><img src=\"/dailyinfo/media/2c355bc0ccf24cda.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Photo of James Coker\"></p><p>\n\t欧盟委员会证实遭到了一次由 AI 驱动的网络攻击，导致多项服务被下线。</p><p>\n\t欧盟委员会发言人 Thomas Regnier 在 11 月 19 日的<a href=\"https://audiovisual.ec.europa.eu/fr/media/video/I-298222\">新闻简报会</a>上披露了此事。他说，此次入侵于 2026 年 10 月 22 日被发现，并于 10 月 26 日被确认为网络攻击，随后启动了缓解措施和调查。</p><p>\n\t“我可以确认，欧盟委员会最近针对一场已被发现的网络活动采取了必要措施。作为保护和预防措施，我们临时下线了若干应用，其中大多数此后已恢复。”Regnier 在回答记者提问时表示。</p><p>\n\t针对此次攻击的潜在实施者以及事件期间是否有数据被访问，官方未提供任何信息；Regnier 表示，针对这些问题，调查仍在进行中。</p><p>\n\t不过，他说自己“并未获悉”欧盟委员会收到勒索要求，调查也未发现“任何影响欧盟委员会工作人员的数据泄露证据”。</p><p>\n\tRegnier 补充称，已就此次攻击通知欧洲数据保护监督员（EDPS）。</p><p>\n\t在新闻简报会后通过电子邮件发给 <em>Infosecurity</em> 的声明中，欧盟委员会发言人说，此次攻击针对的是“单个系统”，受影响团队已按照标准惯例获知相关情况。</p><p>\n\t“欧盟委员会一直在努力加强其系统的安全性，并继续采取适当措施。我们还在对其他系统进行预防性检查，同时与 CERT-EU 和 EDPS 保持密切联系。调查仍在进行中。我们将根据调查结果采取任何必要措施。”该发言人继续表示。</p><p>\n\t这些表态紧随当天早些时候 <em><a href=\"https://www.politico.eu/newsletter/brussels-playbook/cyberattack-hits-the-commission/\">Politico</a></em> 发布的一篇报道。该报道称，欧盟委员会遭到了一次网络攻击，可能导致员工个人信息泄露，并使若干系统被下线。</p><p>\n\t受影响的系统包括 Sysper——欧盟委员会工作人员用于查看工资单和进行时间管理的人力资源平台——以及一套医疗报销系统。</p><h2 id=\"sec-1\">\n\t<strong>欧盟委员会遭攻击：“AI 生成”</strong></h2><p>\n\tRegnier 证实，此次攻击是“AI 生成的”，其中使用了“公开获取”的工具。</p><p>\n\t“近期全球发生了许多网络攻击，当然没有人能够免疫于此。AI 辅助工具可以被用于发现漏洞，尤其是被滥用。事实上，我们可以确认此次攻击使用了 AI 工具。”他说。</p><p>\n\t<em>Politico</em> 的文章称，此次攻击使用中国 AI 渗透测试工具 ARTEX 发起；据信，该工具在近几个月的多起攻击活动中被<a href=\"https://www.infosecurity-magazine.com/news/artex-activity-exceeds-reported/\">广泛使用</a>。</p><p>\n\tARTEX 使用 Go 编写，并嵌有 Next.js Web 控制台，提供一个进攻性命令与控制（C2）平台，可与多个 AI 智能体通信，并可接入大语言模型（LLM）。</p><p>\n\t11 月 5 日，欧盟网络安全应急响应团队 CERT-EU <a href=\"https://www.cert.europa.eu/blog/from-penetration-testing-to-cyber-threat-beware-of-artex?\">警告称</a>，其观察到全球多个威胁行为者正在使用 ARTEX 自动化实施攻击活动。</p><p>\n\t同样，FBI 于 11 月 13 日<a href=\"https://www.infosecurity-magazine.com/news/fbi-growing-abuse-ai-pentesting/\">发布</a>的一则紧急通告指出，自至少 2026 年 8 月以来，各类恶意网络行为者一直使用 ARTEX 针对全球组织实施攻击活动。</p><p>\n\t针对该事件发表评论时，ISACA 全球首席战略官 Chris Dimitriadis 警告称，AI 正让攻击者能够“以意图的速度”实施黑客攻击，而各行业的组织都无法跟上这一速度。</p><p>\n\t“除非组织以犯罪分子积极部署 AI 的同等速度进行防御性部署，否则我们将继续沿着这一轨迹前进，”他说。</p><p>\n\t“在短期内，委员会将调查员工数据是否遭到泄露，以及黑客利用了何种弱点来利用 ARTEX。他们应加强网络安全，并通过招募、培训和提升隐私专业人员的技能来构建长期韧性，从而建立比目前可由攻击者轻易获取的 AI 工具更强大的防御措施。”</p>","original","zhKind","translation","complete","工具发布","漏洞利用","红队","https://www.infosecurity-magazine.com/news/commission-ai-attack-systems/","Infosecurity Magazine",{"_104":105,"_106":-5},"changelogVersion","2026-10-01T08:00","release"]
