[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1795912837000,"id","eyf4sbymvui6crrxn4qzg9u7o","title","奇安信病毒响应中心每周勒索威胁摘要：PixelLeaks、Dark Project、Direwolf公布新受害公司","originalTitle","每周勒索威胁摘要","summary","奇安信病毒响应中心汇总2026.11.23–2026.11.27的3起勒索事件：PixelLeaks声称窃取LockeBridge Capital Partners的财务、客户、法律和运营资料；Dark Project声称盗走Minichi Inc超过170 GB数据；Direwolf公布Wolters Kluwer为受害公司。","reason","source",{"_64":79},"links",{"_71":78},"publishedAt","2026-11-27T08:50:00.000Z","discoveredAt","2026-11-27T12:59:22.073Z","timelineAt","category","activity","tags",[74,75,76,77,69],"score",16,"selected",false,"channel","news","story","x","readingMode","full","author","body",{"_58":70,"_71":-5,"_72":71,"_73":54},"outline",[],"relatedStories",[],"topics",[59,60,61],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","zh",{"_62":68,"_64":69},{"_62":66,"_64":67},{"_62":63,"_64":65},"slug","black-market","name","数据窃取与黑产","ransomware","勒索软件","qianxin","奇安信","<p><span>QAX病毒响应中心</span> <span>2026-11-27 16:50</span> <span>中国香港</span></p><p><img src=\"/dailyinfo/media/40a6c4c7997fddd9.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>1.&nbsp; &nbsp; &nbsp;&nbsp;PixelLeaks勒索团伙公布新的受害公司\n</p><p>2.&nbsp; &nbsp; &nbsp;&nbsp;Dark Project勒索团伙公布新的受害公司\n</p><p>3.&nbsp; &nbsp; &nbsp;&nbsp;Direwolf勒索团伙公布新的受害公司</p><p><span><span>2026</span><span>.11.23 – 2026.11.27</span></span></p><p><strong><span><span>每</span></span></strong><strong><span><span>周</span></span></strong><strong><span><span>勒</span></span></strong><strong><span><span>索</span></span></strong><strong><span><span>事</span></span></strong><strong><span><span>件</span></span></strong><strong><span><span>相</span></span></strong><strong><span><span>关</span></span></strong><strong><span><span>情报</span></span></strong></p><p><span><span>1.</span><span>PixelLeaks勒索团伙公布新的受害公司</span></span></p><p><span><span>2.</span><span>Dark Project勒索团伙公布新的受害公司</span></span></p><p><span><span>3.</span><span>Direwolf勒索团伙公布新的受害公司 &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;</span></span></p><p><strong><span><span><span><span>每</span></span></span></span></strong><strong><span><span><span><span>周</span></span></span></span></strong><strong><span><span><span><span>勒</span></span></span></span><span><span><span><span>索</span></span></span></span><span><span><span><span>事</span></span></span></span><span><span><span><span>件</span></span></span></span><span><span><span><span>相</span></span></span></span><span><span><span><span>关</span></span></span></span><span><span><span><span>情</span></span></span></span><span><span><span><span>报</span></span></span></span></strong></p><p><b><span><span><span>1.PixelLeaks勒索团伙公布新的受害公司</span></span></span></b></p><p><span><span>情报来源：暗网</span></span></p><p><span><span>PixelLeaks勒索团伙在其位于暗网的数据泄露站点公布了新的受害公司LockeBridge Capital Partners，据悉该公司是一家投资银行公司。</span></span></p><p><span><span>计划发布的资料包括一套业务记录，涵盖财务、客户、法律和运营等方面的材料。</span></span></p><p><span><span>2.</span></span><span><span>Dark Project勒索团伙公布新的受害公司</span></span></p><p><span><span>情报来源：暗网</span></span></p><p><span><span>Dark Project勒索团伙在其位于暗网的数据泄露站点公布了新的受害公司Minichi Inc，据悉该公司主要专注于桥梁建设和修复，其服务包括桥梁建设、护栏和道路安全以及道路标志。</span></span></p><p><span><span>超过 170 GB 的机密数据被盗，包括蓝图、场地和建筑平面图、银行和财务信息、员工个人数据等。</span></span></p><p><span><span>3.</span></span><span><span>Direwolf勒索团伙公布新的受害公司</span></span></p><p><span><span>情报来源：暗网</span></span></p><p><span><span>Direwolf勒索团伙在其位于暗网的数据泄露站点公布了新的受害公司Wolters Kluwer，据悉该公司是一家全球领先的专业信息、软件、人工智能解决方案和服务提供商。</span></span></p><p><strong><span><span><span><span><span>安</span></span></span></span><span><span><span><span>全</span></span></span></span></span></strong><strong><strong><span><span><span><span><span>建</span></span></span></span><span><span><span><span>议</span></span></span></span></span></strong></strong></p><p><span><span><span><span><span><span><span>奇</span></span></span></span></span><span><span><span><span><span>安</span></span></span></span></span><span><span><span><span><span>信</span></span></span></span></span><span><span><span><span><span>天</span></span></span></span></span><span><span><span><span><span>擎</span></span></span></span></span><span><span><span><span><span>建</span></span></span></span></span><span><span><span><span><span>议</span></span></span></span></span><span><span><span><span><span>广</span></span></span></span></span><span><span><span><span><span>大</span></span></span></span></span><span><span><span><span><span>政</span></span></span></span></span><span><span><span><span><span>企</span></span></span></span></span><span><span><span><span><span>单</span></span></span></span></span><span><span><span><span><span>位</span></span></span></span></span><span><span><span><span><span>从</span></span></span></span></span><span><span><span><span><span>以</span></span></span></span></span><span><span><span><span><span>下</span></span></span></span></span><span><span><span><span><span>角</span></span></span></span></span><span><span><span><span><span>度</span></span></span></span></span></span><span><span><span><span><span>提</span></span></span></span></span><span><span><span><span><span><span>升</span></span></span></span></span><span><span><span><span><span>自</span></span></span></span></span><span><span><span><span><span>身</span></span></span></span></span><span><span><span><span><span>的</span></span></span></span></span><span><span><span><span><span>勒</span></span></span></span></span></span><span><span><span><span><span>索</span></span></span></span></span><span><span><span><span><span><span>病</span></span></span></span></span><span><span><span><span><span>毒</span></span></span></span></span><span><span><span><span><span>防</span></span></span></span></span><span><span><span><sp