[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795740045000,"id","rj90jojg8jxi2doqvzxf2u18u","title","Rackspace 因安全事件关闭 Spot 云平台，客户须在 12 月 8 日前迁移","originalTitle","Rackspace shuts down Spot cloud platform after security breach","summary","Rackspace 因 11 月 17 日的安全事件关闭 Spot 云平台，攻击者使用被盗凭据在客户 Kubernetes 集群中创建未授权 pods、读取 Kubernetes Secrets，并列出节点和存储卷。","reason","事件披露了攻击者借被盗凭据进入 Kubernetes 集群并读取 Secrets 的过程，也给出了受影响时间范围和可疑 IOC。","source",{"_73":103},"links",{"_94":102},"publishedAt","2026-11-24T21:37:30.000Z","discoveredAt","2026-11-24T22:21:33.065Z","timelineAt","category","activity","tags",[74,98,99,100,101],"score",78,"selected",true,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","Lawrence Abrams","body",{"_61":93,"_94":-5,"_95":96,"_97":37},"outline",[83,84],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fSptk0frtsqA","reportCount",1,"additionalSourceCount",0,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","attack","name","攻击活动","identity","身份与访问","cloud-native","云与原生",{"_80":81,"_13":82},"publicId","7c44fd72-6461-4820-a32e-0d73940fd3c1","Rackspace关闭Spot云平台应对入侵",{"_11":90,"_86":91,"_88":92},{"_11":85,"_86":87,"_88":89},"sec-2","text","发现现有防御可能遗漏的电子邮件威胁。","level",2,"sec-1","客户敦促 Rackspace 重新考虑",3,"<p><img alt=\"Rackspace\" height=\"900\" src=\"/dailyinfo/media/390cc29dfdb477c8.jpg\" srcset=\"/dailyinfo/media/ce0714a5ddf99796.jpg 720w, /dailyinfo/media/e8fdd7ddf21f9180.jpg 1200w, /dailyinfo/media/390cc29dfdb477c8.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>Rackspace 正关闭其 Rackspace Spot 云平台。此前的一次安全入侵使黑客能够访问客户 Kubernetes 集群和机密信息，客户须在 12 月 8 日前迁移服务并下载数据。</p><p>Rackspace Spot 是一个云平台，允许组织使用 Kubernetes 部署和管理容器化应用程序。</p><p>公司在发送给客户、并由 BleepingComputer 获得的一份新安全通知中宣布了关闭计划，称经过对事件的审查后，已决定终止该服务。</p><p><a href=\"https://www.wiz.io/lp/claude-code-security-best-practices-cheat-sheet?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q3_INB_FORM_Claude-Code-Security-Best-Practices&amp;sfcid=701Vh00000gJQZuIAO&amp;utm_term=FY27Q4-bleepingcomputer-article-970x250-Nov&amp;utm_content=Claude-Code-Best-Practices\"><img src=\"/dailyinfo/media/a9e8f90811ebbc9a.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>通知中写道：“在审查局势后，Rackspace 已决定逐步停止 Rackspace Spot 服务。作出这一决定是为了为客户提供一条清晰的前进道路。”</p><p>Rackspace 表示，该服务将于 2026 年 12 月 8 日中部时间下午 5 点永久停止，届时所有剩余工作负载都将被终止，客户数据也将无法再访问。</p><p>客户已被要求在截止日期前取回数据，并将工作负载迁移到其他平台。</p><p>这一决定是在黑客于 11 月 17 日使用被盗凭据<a href=\"https://www.bleepingcomputer.com/news/security/rackspace-spot-breach-let-hackers-access-customer-kubernetes-secrets/\">攻破 Rackspace Spot</a>之后作出的。黑客借此在客户的 Kubernetes 集群中创建未经授权的 Pod、读取 Kubernetes Secrets，并列出节点和卷。</p><p>Rackspace 在收到客户报告后于 11 月 18 日发现了此次入侵，并在保护其基础设施的同时禁用了平台管理控制台的访问。经过长时间中断后，服务于 11 月 21 日恢复。</p><p>Rackspace 表示：“未经授权的一方获取了 Spot 平台部分区域的访问权限，可能读取了集群 Secrets 以及存储卷上的文件。”</p><p>公司表示，受影响的 Spot 环境与其核心基础设施相互隔离，尚未发现证据表明核心系统或其他 Rackspace 客户环境遭到未经授权的访问。</p><p>Rackspace 目前指示所有 Spot 客户将 API 令牌、刷新令牌、kubeconfigs 和 Kubernetes Secrets 视为可能已泄露，无论此前是否收到过入侵通知。</p><p>客户还获建议审查可追溯至 11 月 16 日的访问日志，并搜索与此次攻击有关的可疑 Kubernetes 对象，包括：</p><ul>\n\t<li>\n\t<p><strong>IP 地址：</strong> <code>23.224.79.106</code></p>\n\n\t</li>\n\t<li>\n\t<p><strong>IP 范围：</strong> <code>23.224.0.0/15</code></p>\n\n\t</li>\n\t<li>\n\t<p><strong>可疑 Kubernetes Pod 和对象前缀：</strong> <code>i1</code>、<code>glm-</code> 和 <code>probe</code></p>\n\n\t</li>\n</ul><h3 id=\"sec-1\">客户敦促 Rackspace 重新考虑</h3><p>关闭公告在 Rackspace Spot 客户中引发了失望情绪，有些人敦促公司重新考虑，并愿意支付更高费用以维持平台运行。</p><p>在一次<a href=\"https://www.reddit.com/r/rxt_spot/comments/1y4enf2/is_this_wind_down_final_please_reconsider/\">Reddit 讨论</a>中，一位客户表示，他们认为用户愿意支付更高的价格来维持该服务运行。</p><p>其他客户在<a href=\"https://www.reddit.com/r/rxt_spot/comments/1y492a6/well_it_was_good_while_it_lasted/\">另一场讨论</a>中表达了类似担忧，有些人询问价格实惠的替代方案，另一些人则描述了关闭服务对其现有基础设施造成的影响。</p><p>其他人则称赞该服务价格实惠，称其他云提供商的收费会更高。</p><p>Rackspace 尚未表明是否会重新考虑关闭决定，或是否会为客户额外提供时间来迁移其工作负载。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/3d0888eec2a1da78.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-2\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体会分析邮件意图、上下文和行为，以发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>通过为期 14 天的只读扫描查看 Microsoft 365 或 Google Workspace 中有哪些邮件得以通过，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始免费的电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","数据泄露","容器","云原生","凭据","https://www.bleepingcomputer.com/news/security/rackspace-shuts-down-spot-cloud-platform-after-security-breach/","BleepingComputer",{"_105":106,"_107":-5},"changelogVersion","2026-10-01T08:00","release"]
