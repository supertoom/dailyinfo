[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1794789628000,"id","jx8qldq434280gul46prza1bc","title","意大利 Garante 因 Facebook 相册默认访问功能对 Meta 罚款 €805 million","originalTitle","Meta Fined €805 Million in Italy Over Facebook’s Default Photo Gallery Access","summary","意大利数据保护机构 Garante 因 Facebook for Android 在未取得明确同意且未充分告知的情况下访问用户照片、视频及元数据，对 Meta Platforms Ireland Limited 罚款 €805 million，涉及约 2000 万名 Android 用户。","reason","source",{"_73":97},"links",{"_61":96},"publishedAt","2026-11-15T18:11:56.000Z","discoveredAt","2026-11-15T22:40:48.079Z","timelineAt","category","policy","tags",[94,95,80,78],"score",64,"selected",false,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","Pierluigi Paganini","body",{"_90":-5,"_61":91,"_92":-5,"_93":36},"outline",[85],"relatedStories",[81],"topics",[68,69,70,71],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fULr7km2phv4","reportCount",3,"additionalSourceCount",2,{"_72":79,"_73":80},{"_72":77,"_73":78},{"_72":75,"_73":76},{"_72":30,"_73":74},"slug","name","政策法规","compliance","合规与标准","identity","身份与访问","mobile","移动端",{"_82":83,"_13":84},"publicId","4b2697c9-e311-4e85-a2db-005e21e0d0d4","意大利重罚Meta默认读取图库",{"_11":86,"_87":88,"_89":67},"sec-1","text","Italy fines Meta €805 million over Facebook’s access to Android users’ photo gal","level","zh","<h2 id=\"sec-1\">Italy fines Meta €805 million over Facebook’s access to Android users’ photo galleries without specific consent, affecting around 20 million people.</h2><p>Italy’s data protection authority, the Garante, has fined Meta Platforms Ireland Limited €805 million. The reason is that the Facebook app for Android reached into photos, videos, and their metadata on Italian users’ phones without specific consent and without telling people properly what was happening. </p><p><em>“The Italian Data Protection Authority (Garante) has fined Meta Platforms Ireland Limited €805 million. Through the Facebook app for Android devices, the company accessed photos, videos, and related metadata stored on Italian users’ smartphones without obtaining specific consent and without properly informing them.” <a href=\"https://garanteprivacy.it/home/docweb/-/docweb-display/docweb/10321080#english\">reads the Garante’s announcement</a>.</em></p><p><em>“The measure concerns the ‘Get tips from your gallery while browsing Facebook’ feature, available since 2023, which, while browsing, shows users photos and videos from their phone gallery as suggestions to post.”</em></p><p>The feature at the center of the case suggests photos and videos from users’ phone gallery as things to post while they scroll Facebook. It has been available since 2023. The Garante opened its investigation in July 2025, after a complaint from the Bolzano Consumer Protection Centre, and backed it with its own technical analysis.</p><p>The analysis found three main problems. Facebook used a single permission to access the phone’s photo gallery for several different purposes. The notice shown to users was unclear and did not explain that granting permission would also enable photo suggestions. On top of that, the feature was enabled by default.</p><p>This is important because, once users grant full access, the app can continuously read all the photos and videos stored on their devices. Neither users nor the Garante can see exactly which data the app accesses or uses.</p><p>“The checks revealed that:</p><ul>\n<li>access to the gallery is requested through a single permission, valid for the entire app and for several functions serving different purposes;</li>\n\n\n\n<li>the authorisation is preceded by a generic notice (“enable other features”) that does not allow users to understand that they are also authorising gallery suggestions;</li>\n\n\n\n<li>furthermore, the feature was enabled by default.” continues the statement.</li>\n</ul><p>Meta <a href=\"https://www.reuters.com/world/italy-fines-meta-887-million-over-android-users-data-access-2026-11-14/\">told Reuters</a> users must grant device-level permission to enable the feature and can revoke it at any time through their settings.</p><p>“This is a simple feature ​that helps people share photos and videos on Facebook. ​Users must grant permission on their device before the feature can operate, and ‌they ⁠can change that permission at any time in their settings,” the company spokesperson said in a statement</p><p>The Garante pointed to Article 122 of Italy’s Privacy Code, which carries the EU’s ePrivacy Directive into Italian law. That rule treats the smartphone as part of a person’s private sphere, so any access to what’s on it needs free and informed consent.</p><p>Meta argued that the Irish authority should have handled the case. The Garante said no, since the ePrivacy rules don’t include the one-stop-shop mechanism. The case also doesn’t cover whether Meta used any content to train artificial intelligence, which the company denies. The Garante did keep the option open to look separately at a new feature launched in 2026 that processes gallery content in the cloud.</p><p>Meta now has 60 days to fix things. It has to ask for consent through a separate, specific request, and explain what the feature does, that it involves gallery access, and how to turn it off. It also has to keep the feature off by default, even for people who already said yes. If Meta misses the deadline, it can’t activate the feature for anyone without valid consent.</p><p>The company also owes the Garante two reports. One is due within 30 days, on what it has started doing, and another within 90 days, on the measures it has adopted.</p><p>Several factors led to the high fine. Around 20 million Android users in Italy were affected, and the violation is still ongoing for users who have not updated the app. Meta had also been fined by the Garante in 2019 and provided only limited cooperation during the investigation.</p><p>One factor worked in Meta’s favor: the company changed the feature after the complaint. However, the Garante said these changes came too late and only applied to users who updated the app. </p><p>The fine represents about 0.47% of Meta’s global revenue. It is unlikely to cause serious financial problems for the company, but it may help give users more control over their photo privacy.</p><p><br><strong>Follow me on Twitter:&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;hacking,&nbsp;Meta)</strong></p>","zhKind","complete","法规","合规","https://securityaffairs.com/203174/laws-and-regulations/meta-fined-e805-million-in-italy-over-facebooks-default-photo-gallery-access.html","Security Affairs",{"_99":100,"_101":-5},"changelogVersion","2026-10-01T08:00","release"]
