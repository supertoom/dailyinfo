[{"_1":2,"_3":4},"root",{"_5":100},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1794444095000,"id","k9m1aemrbm2gwfwjok8ooel6i","title","UNM Health 遭遇网络安全事件，关闭急诊资源并转移患者","originalTitle","UNM Health Shuts Clinics and Diverts Patients During Security Incident","summary","UNM Health 在 10 月 26 日遭遇网络安全事件，迫使救护车转向其他医院、取消 30 多家诊所的预约，并暂停部分门诊手术；其 Albuquerque 医院是 New Mexico 唯一的 Level 1 创伤中心。","reason","source",{"_74":99},"links",{"_90":98},"publishedAt","2026-11-05T13:48:57.000Z","discoveredAt","2026-11-05T22:04:15.355Z","timelineAt","category","activity","tags",[75,77,96,97],"score",70,"selected",true,"channel","news","story",{"_81":82,"_13":83},"x","sameEvent",{"_11":94,"_13":95},"readingMode","full","author","Pierluigi Paganini","body",{"_62":89,"_90":-5,"_91":92,"_93":36},"outline",[84],"relatedStories",[80],"topics",[69,70,71],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","f-_4_lpshQ1g","reportCount",3,"additionalSourceCount",2,{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","attack","name","攻击活动","incident","应急响应","email","邮件与钓鱼",{"_81":82,"_13":83},"publicId","c98d7608-4786-4d67-9544-48f3965bed29","UNM Health网络事件影响急救与门诊服务",{"_11":85,"_86":87,"_88":68},"sec-1","text","一起网络安全事件迫使 UNM Health 转移救护车、取消预约，并在控制威胁期间暂停医疗服务。","level","<h2 id=\"sec-1\">一起网络安全事件迫使 UNM Health 转移救护车、取消预约，并在控制威胁期间暂停医疗服务。</h2><p>10月26日星期一，新墨西哥大学健康系统（UNM Health）遭遇了医疗行业领导者最担忧的那类安全事件：事件严重到改变了患者接受急诊护理的方式。</p><p>新墨西哥州一家大型医院网络周一紧急修复一个网络安全问题。该问题迫使它将救护车转送至其他医院，并使全州没有一家医院急诊科能够治疗最严重的创伤。</p><p>UNM Health 运营着新墨西哥州唯一的 Level 1 创伤中心。这些中心负责治疗最严重和最复杂的创伤。即使只是临时关闭，也会给其他医院带来额外压力。</p><p>UNM Health 运营着新墨西哥州唯一的 Level 1 创伤中心。之所以重要，是因为 Level 1 中心处理最复杂的创伤，而即便是暂时失去对它的接入，也会给附近的每一家医院带来压力。</p><p>该机构告知患者不要前往其位于阿尔伯克基的主要医院，并取消了 30 多个诊所的预约。</p><p><em>“新墨西哥大学健康系统目前正面临一个网络安全问题。UNM Health 官员正在积极解决该问题。目前，所有救护车流量均被分流至其他医院，今天所有诊所的所有预约均已取消。UNM Health 患者不应于 10月26日前往 UNM Health 的任何设施。紧急情况应拨打 911，非紧急情况应推迟至另行通知。”该机构于 2026年10月26日发布的<a href=\"https://hscnews.unm.edu/news/ambulance-traffic-diverted-clinical-appointments-cancelled-and-classes-cancelled-due-to-cybersecurity-issue-at-unm-hsc\">更新</a>中如此写道。“这一网络安全威胁正在影响整个新墨西哥大学健康科学中心。&nbsp;</em></p><p>UNM 表示，其 IT 安全团队于上午 11 点左右发现了威胁，并开始开展遏制工作。他们随后表示，该事件影响了部分终端用户设备，但未波及核心系统或服务器。</p><p>管理层启动了应急行动中心，引入外部支持，并通知了州和联邦执法机构。这一处置顺序是正确的：先隔离，再调查，持续沟通。</p><p>下午 12:30 至 2:30，UN Health 暂时停止接收新患者，同时各团队保护网络。“系统中断还导致当天余下时间暂停门诊手术和预约。”</p><p>这不是一个抽象的 IT 问题。患者前来就医，却被告知需要改期。工作人员不得不反复解释为什么医院就诊无法按计划进行。</p><p>UNM 还取消了其健康科学中心的课程，并让非必要员工回家。医学、护理、药学和人口健康专业的学生损失了一天的教学，因为该机构必须保护其网络。</p><p>其他医疗服务提供者接手了工作。Presbyterian Healthcare Services 和 Lovelace Health System 与 UNM 协调并接收了更多患者，这正是一个运转正常的区域医疗系统应当采取的做法。</p><p>UNM Health 于周一下午开始恢复其系统。到第二天，医院、救护车服务和诊所均已恢复正常。</p><p>该事件目前仍在刑事调查之中。有员工报告称收到消息，声称患者、学生和员工数据已被窃取，但 UNM 尚未确认这一点。该医院还警告公众提防攻击者利用此次事件实施网络钓鱼和欺诈。</p><p><strong>在 Twitter 上关注我：&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;以及&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;和&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;黑客、安全、UNM Health)</strong></p>","original","zhKind","translation","complete","y48vxw3a26n9do1au6eiyfjji","UNM Health 遭 Byod 勒索攻击，中断患者接诊与手术","数据泄露","钓鱼","https://securityaffairs.com/202495/security/unm-health-shuts-clinics-and-diverts-patients-during-security-incident.html","Security Affairs",{"_101":102,"_103":-5},"changelogVersion","2026-10-01T08:00","release"]
