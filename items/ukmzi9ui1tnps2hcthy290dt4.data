[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":54,"_55":36,"_56":36,"_57":58,"_59":36,"_60":61},"expiresAt",1793621937000,"id","ukmzi9ui1tnps2hcthy290dt4","title","FBI 归因 North Korea 的 TraderTraitor 窃取 Binance 超过 $6bn 加密资产","originalTitle","FBI Attributes Binance Heist to North Korea’s TraderTraitor","summary","FBI 认定 TraderTraitor 攻击 cryptocurrency exchange Binance，窃取超过 $6bn 加密资产，并称攻击者正把赃资转换为 Ethereum（ETH），再经 DeFi 和即时兑换服务继续洗钱。","reason","source",{"_74":103},"links",{"_93":102},"publishedAt","2026-11-02T10:15:00.000Z","discoveredAt","2026-11-02T10:43:36.206Z","timelineAt","category","activity","tags",[75,99,100,101,77],"score",77,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","sameEvent",{"_11":97,"_13":98},"readingMode","full","author","body",{"_61":92,"_93":-5,"_94":95,"_96":36},"outline",[86],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","f39FEvqrWazs","reportCount",6,"additionalSourceCount",5,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","attack","name","攻击活动","incident","应急响应","black-market","数据窃取与黑产","crypto","密码学",{"_83":84,"_13":85},"publicId","6ef2ec24-f871-4ca2-9cc2-5fcbd249af24","FBI归因TraderTraitor窃取Binance资产",{"_11":87,"_88":89,"_90":91},"sec-1","text","Binance 调查仍在继续","level",2,"<p><img src=\"/dailyinfo/media/25794e639f2e88fe.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Photo of Phil Muncaster\"></p><p>\n\t据美国联邦调查局（FBI）称，朝鲜是上周从加密货币交易所 <a href=\"https://www.infosecurity-magazine.com/news/binance-record-hack-crypto-heist/\">Binance 窃取超过 60 亿美元</a>事件的幕后黑手。</p><p>\n\t该局于 10 月 31 日发布的一份简短声明，将这起入侵事件归咎于 TraderTraitor 组织（又称 Jade Sleet、UNC4899、Slow Pisces）。</p><p>\n\t声明称：“美国联邦调查局（FBI）与美国特勤局（US Secret Service）和美国国税局刑事调查局（IRS-CI）的合作伙伴发现，TraderTraitor 的行动人员主要将窃取的资产转换为 Ethereum（ETH）。”&nbsp;</p><p>\n\t“预计这些资产随后将通过去中心化金融产品（DeFi）和即时兑换服务进行进一步洗钱，同时为后续洗钱阶段做准备。”</p><p>\n\t<a href=\"https://www.infosecurity-magazine.com/news/us-japan-north-korea-crypto-heist/\"><em>进一步了解 TraderTraitor：美国和日本将 3.08 亿美元加密货币窃取事件归咎于朝鲜。</em></a></p><p>\n\t美国联邦调查局（FBI）及其合作伙伴敦促包括 THORNode 运营方、RPC 节点运营方、即时交易所、DeFi 服务、区块链分析公司及其他虚拟资产服务提供商在内的加密货币相关机构，“阻断与 TraderTraitor 行动人员用于洗钱这些被盗资产的地址之间存在关联或由此类地址衍生的交易。”&nbsp;</p><p>\n\t据区块链分析公司 Elliptic 表示，约 29 亿美元被盗资金已被冻结或扣押，但这仍有近 33 亿美元处于发行方无法触及的范围之外。</p><p>\n\tElliptic 解释道：“按当前价格计算，攻击者目前控制着约 32.5 亿美元无法由发行方冻结的资产，分布在 800 多个地址中。其中包括约 584,000 ETH（13.2 亿美元）、18,327 BTC（14.2 亿美元）和 2.33 亿枚 XRP。”</p><p>\n\t“这些 ETH 包括通过跨链桥洗钱的 TRX；它们流入 Ethereum 后被拆分到数百个新钱包中。几乎所有被盗 TRX 现已完成洗钱。XRP、SOL 和 NEAR 总价值约 4.39 亿美元，自被盗以来一直没有转移。”</p><h2 id=\"sec-1\">\n\t<strong>Binance 调查仍在继续</strong></h2><p>\n\tBinance 表示将承担此次事件产生的费用，因此客户资金不会有危险。不过，该公司仍在调查此次入侵事件的实际原因。</p><p>\n\t该公司最初声称，一台遭入侵的 DevOps 笔记本可能曾是此次事件的源头，但后来又表示，在其所称的“复杂攻击”中“发现了更多入侵点”。</p><p>\n\t据 Elliptic 表示，此次攻击由不止一人实施，并使用了“一种在运行时销毁工具和痕迹的自毁机制”，这使取证分析变得更加困难。</p><p>\n\tTraderTraitor 还与 Lazarus Group、APT 38 和 AppleJeus 有关联，并被认定与一系列历史加密货币盗窃案有关。</p><p>\n\t这些案件包括对日本公司 DMM 的攻击，该公司损失 3.08 亿美元，以及针对 Alphapo（6000 万美元）、CoinsPaid&nbsp;（3700 万美元）和 <a href=\"https://www.infosecurity-magazine.com/news/fbi-flags-dollar40m-crypto-cash/\">Atomic Wallet（1 亿美元）</a>的攻击。此前有史以来最大加密货币入侵案的纪录保持者也被归咎于 TraderTraitor，<a href=\"https://www.infosecurity-magazine.com/news/fbi-confirms-north-koreas-lazarus/\">该组织曾从 Bybit 窃取 15 亿美元。</a></p><p>\n\t<em>图片来源：Anton Zubchevskyi / Andy.LIU / Shutterstock.com&nbsp;</em></p>","original","zhKind","translation","complete","uu0z6mo1muhhj4bo1sst643w9","FBI 将 Binance 63 亿美元加密资产窃取案归因于朝鲜 TraderTraitor","数据泄露","黑产","加密","https://www.infosecurity-magazine.com/news/fbi-attributes-binance-north/","Infosecurity Magazine",{"_105":106,"_107":-5},"changelogVersion","2026-10-01T08:00","release"]
