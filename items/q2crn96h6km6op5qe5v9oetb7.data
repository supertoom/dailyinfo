[{"_1":2,"_3":4},"root",{"_5":96},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":35,"_54":55,"_56":57,"_58":35,"_59":60},"expiresAt",1794616832000,"id","q2crn96h6km6op5qe5v9oetb7","title","FAA 因“特殊情况”对全美机场发布全国性停飞指令","originalTitle","FAA Ground Stop Issued Due to ‘Extraordinary Circumstances’","summary","美国联邦航空管理局（FAA）因影响全美所有 Air Route Traffic Control Centers 的通信问题，对全美机场发布全国性地面停飞指令，出发航班被要求停留在地面。FAA 技术人员正在调查，联邦官员尚未公开问题成因，也无法确认是否与网络攻击有关；抵达的国际航班将逐案处理。","reason","source",{"_94":95},"links",{"_60":93},"publishedAt","2026-11-13T21:33:27.000Z","discoveredAt","2026-11-13T22:03:28.414Z","timelineAt","category","tags",[92],"score",25,"selected",false,"channel","news","story",{"_68":69,"_13":70},"x","readingMode","full","author","SecurityWeek News","body",{"_88":-5,"_60":89,"_90":-5,"_91":35},"outline",[71,72,73,74,75],"relatedStories",[67],"topics",[],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","ffdWb9b7mB0I","reportCount",1,"additionalSourceCount",0,{"_68":69,"_13":70},"publicId","0f6b016a-d847-4359-9714-87b27958c5c9","FAA因通信故障发布全国停飞令",{"_11":86,"_77":87,"_79":80},{"_11":85,"_77":78,"_79":80},{"_11":83,"_77":84,"_79":80},{"_11":81,"_77":82,"_79":80},{"_11":76,"_77":78,"_79":80},"sec-5","text","Daily Briefing Newsletter","level",2,"sec-4","Latest News","sec-3","More from SecurityWeek News","sec-2","sec-1","Was the FAA hit by a cyberattack?","zh","<p><img width=\"1200\" height=\"675\" src=\"/dailyinfo/media/5df99bdb4f64bb8c.jpg\" srcset=\"/dailyinfo/media/fe5238cbf3d0579b.jpg 720w, /dailyinfo/media/4dd14ce56c70e57b.jpg 1200w, /dailyinfo/media/5df99bdb4f64bb8c.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"FAA Ground stop\"></p><p><strong>The Federal Aviation Administration (FAA) issued a nationwide ground stop for all U.S. airports on Friday afternoon, citing “extraordinary circumstances” for safety.</strong></p><p>According to Sean Duffy, U.S. Secretary of Transportation, the issue stems from communication issue impacting “all Air Route Traffic Control Centers” nationwide.</p><p>“The @FAAnews issued a nationwide ground stop for all U.S. airports following a communication issue impacting all Air Route Traffic Control Centers,” Duffy <a href=\"https://x.com/SecDuffy/status/2121351591106072679\">posted to X</a> Friday afternoon. “FAA technicians are investigating the issue. We will provide immediate updates as we have them.”</p><h2 id=\"sec-1\">Was the FAA hit by a cyberattack?</h2><p>The cause of the air traffic control communications disruption remains unclear. Federal officials have yet to publicly identify what triggered the problem, and it is unclear if the incident is linked to a cyberattack.</p><p>The FAA directed departing flights to remain on the ground until further notice and said it would handle inbound international flights case by case. The agency had already halted traffic in Chicago over air traffic control communications problems before issuing the nationwide order.</p><p><strong>Breaking News – Check back for updates.</strong></p><p><img src=\"/dailyinfo/media/9f90984530a38525.jpg\" loading=\"lazy\" decoding=\"async\">\n                  </p><h2 id=\"sec-2\">Daily Briefing Newsletter</h2><p>\n            Subscribe to the SecurityWeek Email Briefing for the latest cybersecurity threats, trends, and expert\n            insights.\n          </p><h2 id=\"sec-3\">More from <a href=\"https://www.securityweek.com/contributors/securityweek-news/\">SecurityWeek News</a></h2><ul>\n          <li><a href=\"https://www.securityweek.com/microsoft-365-outage-disrupts-outlook-exchange-online-and-teams/\">Microsoft 365 Outage Disrupts Outlook, Exchange Online and Teams</a></li><li><a href=\"https://www.securityweek.com/today-ciso-forum-virtual-summit-2026-join-global-cybersecurity-leaders/\">Today: CISO Forum Virtual Summit 2026 Day 2 – Join Cybersecurity Leaders Online</a></li><li><a href=\"https://www.securityweek.com/finite-state-raises-27-million-to-secure-software-and-firmware-in-connected-devices/\">Finite State Raises $27 Million to Secure Software and Firmware in Connected Devices</a></li><li><a href=\"https://www.securityweek.com/dreeze-emerges-from-stealth-with-33m-to-rebuild-cloud-apps-after-cyberattacks/\">Dreeze Emerges From Stealth With $33M to Rebuild Cloud Apps After Cyberattacks</a></li><li><a href=\"https://www.securityweek.com/in-other-news-trezor-implant-llmjacking-bills-hit-1m-sap-flaws-weaponized-within-days/\">In Other News: Trezor Implant, LLMJacking Bills Hit $1M, SAP Flaws Weaponized Within Days</a></li><li><a href=\"https://www.securityweek.com/northstar-security-exits-stealth-with-7m-to-expose-toxic-risk-combinations/\">Northstar Security Exits Stealth With $7M to Expose Toxic Risk Combinations</a></li><li><a href=\"https://www.securityweek.com/in-other-news-anthropic-breach-dispute-uefi-flaw-hits-most-servers-cloudflare-ai-data-leak/\">In Other News: Anthropic Breach Dispute, UEFI Flaw Hits Most Servers, Cloudflare AI Data Leak</a></li><li><a href=\"https://www.securityweek.com/secrets-management-firm-infisical-valued-at-600-million-after-40-million-raise/\">Secrets Management Firm Infisical Valued at $600 Million After $40 Million Raise</a></li>        </ul><h2 id=\"sec-4\">Latest News</h2><ul>\n          <li><a href=\"https://www.securityweek.com/in-other-news-new-cisa-director-nominee-connected-car-hacking-baker-tilly-data-breach/\">In Other News: New CISA Director Nominee, Connected Car Hacking, Baker Tilly Data Breach</a></li><li><a href=\"https://www.securityweek.com/microsoft-struggles-to-restore-email-and-other-services-in-a-global-outage/\">Microsoft Struggles to Restore Email and Other Services in a Global Outage</a></li><li><a href=\"https://www.securityweek.com/apify-confirms-customer-data-accessed-in-cyberattack/\">Apify Confirms Customer Data Accessed in Cyberattack</a></li><li><a href=\"https://www.securityweek.com/silentair-hackers-intercept-calls-sms-from-inside-mobile-networks/\">SilentAir Hackers Intercept Calls, SMS From Inside Mobile Networks</a></li><li><a href=\"https://www.securityweek.com/law-enforcement-disrupts-gootloader-castlerat-and-stealc-infrastructure/\">Law Enforcement Disrupts Gootloader, CastleRAT, and StealC Infrastructure</a></li><li><a href=\"https://www.securityweek.com/citrix-patches-10-critical-netscaler-vulnerabilities/\">Citrix Patches 10 Critical NetScaler Vulnerabilities</a></li><li><a href=\"https://www.securityweek.com/openai-unveils-daybreak-red-team-defense-factory-security-tools/\">OpenAI Unveils Daybreak Red Team, Defense Factory Security Tools</a></li><li><a href=\"https://www.securityweek.com/nightmare-eclipse-drops-windows-zero-day-exploit-signdrop/\">Nightmare Eclipse Drops Windows Zero-Day Exploit ‘SignDrop’</a></li>        </ul><p><img src=\"/dailyinfo/media/63d674d1148aeb00.webp\" loading=\"lazy\" decoding=\"async\"></p><h2 id=\"sec-5\">Daily Briefing Newsletter</h2><p>Subscribe to the SecurityWeek Email Briefing to stay informed on the latest threats, trends, and technology, along with insightful columns from industry experts.</p><p>Join as we bring together CISOs, senior cybersecurity executives, practitioners, industry experts, and other security leaders to share practical experience and examine the issues shaping enterprise cybersecurity strategy.</p><p><a href=\"https://virtual.cisoforum.com/\">Register</a>\n\t\t\t</p><p>Join to learn the four levels of architecting security into the agentic SDLC – from securing the code your developers' agents write to running a coordinated system of security agents you've built yourself.</p><p><a href=\"https: