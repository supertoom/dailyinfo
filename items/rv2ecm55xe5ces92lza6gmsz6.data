[{"_1":2,"_3":4},"root",{"_5":88},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795826450000,"id","rv2ecm55xe5ces92lza6gmsz6","title","Ruby 字符串大小写转换堆越界写入漏洞 CVE-2026-132825 存在 RCE 风险","originalTitle","【漏洞通告】Ruby 字符串大小写转换堆越界写入漏洞(CVE-2026-132825)","summary","Ruby 字符串大小写转换函数存在堆缓冲区越界写入漏洞（CVE-2026-132825），影响 Ruby < 3.3.14、Ruby 3.4.0 - 3.4.12 和 Ruby 4.0.0 - 4.0.9，威胁等级为高危。","reason","文章解释了单字节编码下字符串大小写转换触发堆越界写入的成因，并列出受影响版本、利用前提与修复方案。","source",{"_72":87},"links",{"_80":86},"publishedAt","2026-11-20T09:49:00.000Z","discoveredAt","2026-11-20T17:23:31.412Z","timelineAt","category","vuln","tags",[83,84,85],"score",78,"selected",true,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","body",{"_61":79,"_80":-5,"_81":80,"_82":37},"outline",[],"relatedStories",[75],"topics",[68,69],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","f6WA2ackQ-jM","reportCount",2,"additionalSourceCount",1,{"_70":31,"_72":74},{"_70":71,"_72":73},"slug","research","name","技术研究","漏洞披露",{"_76":77,"_13":78},"publicId","64c14d14-b61b-4d9c-9257-6bf7916a34c8","Ruby修复堆越界写入RCE漏洞","<p><span>深瞳漏洞实验室</span> <span>2026-11-20 17:49</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/67c571a687261c4a.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>2026年11月20日，深瞳漏洞实验室监测到一则Ruby组件存在越界写入漏洞的信息，漏洞编号：CVE-2026-132825，漏洞威胁等级：高危。</p><p><img src=\"/dailyinfo/media/a2611eeaa3b131b4.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span><span>漏洞名称：</span></span></strong></p><p><span>Ruby 字符串大小写转换堆越界写入漏洞(CVE-2026-132825)</span></p><p><strong><span><span>组件名称：</span></span></strong></p><p><span>Ruby</span></p><p><span><strong><span>影响范围：</span></strong></span></p><p><span>Ruby &lt; 3.3.14</span><span><br></span><span>Ruby 3.4 系列 3.4.0 - 3.4.12</span><span><br></span><span>Ruby 4.0 系列 4.0.0 - 4.0.9</span></p><p><strong><span><span>漏洞类型：</span></span></strong></p><p><span>越界写入</span></p><p><span><strong><span>利用条件：</span></strong></span></p><p><span>1、用户认证：否</span></p><p><span>2、前置条件：应用运行于受影响 Ruby 版本，且对用户输入的字符串（含 ß 的单字节编码内容）执行大小写转换，Rails/Sinatra 默认配置即满足，无需认证</span></p><p><span>3、触发方式：远程</span></p><p><strong><span><span>综合评价：</span></span></strong></p><p><span>利用难度：较难，需绕过 ASLR 并精确堆布局，成功利用可远程代码执行。</span></p><p><span>威胁等级：高危，可造成远程代码执行。</span></p><p><strong><span><span>官方解决方案：</span></span></strong></p><p><span>已发布</span></p><p><strong><span>漏洞分析</span></strong></p><p><img src=\"/dailyinfo/media/0618b4ea32e0f21c.webp\" loading=\"lazy\" decoding=\"async\"></p><p><b><span>组件介绍</span></b></p><p><span>Ruby 是一种广泛使用的开源动态脚本语言，Rails、Sinatra 等 Web 框架基于其构建，GitLab、GitHub Enterprise、Mastodon、Discourse 等常见自托管软件均内置 Ruby 运行时。其字符串大小写转换（upcase/swapcase/downcase 等）属于基础字符串操作，Web 应用普遍直接对用户输入调用，本次堆越界写入缺陷即位于该转换逻辑，远程输入可直达。</span></p><p><img src=\"/dailyinfo/media/ee55ba5f98fe146f.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>漏洞简介</span></strong></p><p><span>2026年11月20日，深瞳漏洞实验室监测到一则Ruby组件存在越界写入漏洞的信息，漏洞编号：CVE-2026-132825，漏洞威胁等级：高危。</span></p><p><span>Ruby 字符串大小写转换函数存在堆缓冲区越界写入漏洞。在 ISO-8859-1、Windows-1252 等单字节编码下对包含 ß 字符的字符串执行 upcase、swapcase、downcase(:fold) 等转换时，ß 被展开为两字节的 SS，而边界检查仅为单字节预留空间，造成堆越界写入；该缺陷自 Ruby 2.4.0 起存在。输出缓冲区按输入长度加 20 字节分配，输入 21 个 ß 即可溢出一字节，写入内容为 S/s（0x53/0x73）。</span><strong><span><span>Rails、Sinatra 等主流 Web 框架默认配置下可被未认证攻击者远程触达，可导致内存破坏与远程代码执行。</span></span></strong></p><p><strong><span>影响范围</span></strong></p><p><span>目前受影响的Ruby版本：</span></p><p><span>Ruby &lt; 3.3.14</span><span><br></span><span>Ruby 3.4 系列 3.4.0 - 3.4.12</span><span><br></span><span>Ruby 4.0 系列 4.0.0 - 4.0.9</span></p><p><strong><span>解决方案</span></strong></p><p><img src=\"/dailyinfo/media/26b47a63316f5218.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>官方修复建议</span></strong></p><p><span>升级至官方已修复版本：</span><span><br></span><span>Ruby 3.3 系列 &gt;= 3.3.14</span><span><br></span><span>Ruby 3.4 系列 &gt;= 3.4.13</span><span><br></span><span>Ruby 4.0 系列 &gt;= 4.0.10</span><span><br></span><span>官方公告：<a href=\"https://www.ruby-lang.org/en/news/2026/11/18/multiple-vulnerabilities-in-regexp-and-string/\">https://www.ruby-lang.org/en/news/2026/11/18/multiple-vulnerabilities-in-regexp-and-string/</a></span></p><p><img src=\"/dailyinfo/media/7cf558f6481c563d.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span><span>临时修复建议</span></span></strong></p><ul><li><p><span>在完成升级前，避免对不可信输入的单字节编码（ISO-8859-1/Windows-1252 等）字符串执行大小写转换；可在应用入口统一将字符串转为 UTF-8 编码后再处理（UTF-8 路径不受影响）。</span></p></li></ul><ul><li><p><span>按受影响分支尽快升级至 Ruby 3.3.14 / 3.4.13 / 4.0.10；GitLab、GitHub Enterprise 等内置 Ruby 的自托管软件关注厂商修复版本。</span></p></li></ul><p><img src=\"/dailyinfo/media/24d8aef4be4e06b4.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>深信服解决方案</span></strong></p><p><strong><span>风险资产发现</span></strong></p><p><span>支持对Ruby的主动检测，</span><strong><span><span>可批量检出业务场景中该事件的受影响资产情况，</span></span></strong><span>相关产品如下：</span></p><p><strong><span><span>【深信服云镜YJ】</span></span></strong><span>&nbsp;已发布资产检测方案，指纹ID:0000441。</span></p><p><b><span>参考链接</span></b></p><p><span><a href=\"https://www.ruby-lang.org/en/news/2026/11/18/multiple-vulnerabilities-in-regexp-and-string/\">https://www.ruby-lang.org/en/news/2026/11/18/multiple-vulnerabilities-in-regexp-and-string/</a></span></p><p><span><a href=\"https://github.com/ruby/ruby/security/advisories/GHSA-34m4-m9fh-gqp5\">https://github.com/ruby/ruby/security/advisories/GHSA-34m4-m9fh-gqp5</a></span></p><p><span><a href=\"https://verialabs.com/ruby2shell/\">https://verialabs.com/ruby2shell/</a></span></p><p><b><span>时间轴</span></b></p><p><strong><span>2026/11/20</span></strong></p><p><span>深瞳漏洞实验室监测到Ruby 字符串大小写转换堆越界写入漏洞信息。</span></p><p><strong><span>2026/11/20</span></strong></p><p><span>深瞳漏洞实验室发布漏洞通告。</span></p><p><span>点击</span><strong><span><span>阅读原文</span></span></strong><span>，及时关注并登录深信服</span><strong><span>智安全平台</span></strong><span>，可轻松查询漏洞相关解决方案。</span></p><p><img src=\"/dailyinfo/media/f4e4a2ecd7b51f88.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img src=\"/dailyinfo/media/41ac967880777cd5.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><a href=\"https://sec.sangfor.com.cn/security-vulnerability/detail?vuln_sfv=%20SF_2026_47147%5cx26amp;lang=ZH-CN\">阅读原文</a></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=6728216d&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzg2NjgzNjA5NQ%3D%3D%26mid%3D2247526537%26idx%3D3%26sn%3Dd3994fc9cd73ceb292a7ed2a9d6f65f6\">跳转微信打开</a></p>","original","zhKind","complete","漏洞","补丁","漏洞分析","https://mp.weixin.qq.com/s?__biz=Mzg2NjgzNjA5NQ==&mid=2247526537&idx=3&sn=d3994fc9cd73ceb292a7ed2a9d6f65f6","深信服千里目安全实验室",{"_89":90,"_91":-5},"changelogVersion","2026-10-01T08:00","release"]
