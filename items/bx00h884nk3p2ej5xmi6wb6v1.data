[{"_1":2,"_3":4},"root",{"_5":103},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1794185100000,"id","bx00h884nk3p2ej5xmi6wb6v1","title","Vapor Panda 等组织利用 ARTEX 与 CyberStrikeAI 扩大 AI 驱动攻击","originalTitle","AI agents scale and speed up Chinese-linked attacks","summary","CrowdStrike 与 Kaspersky 分别披露了两起 AI 代理参与入侵的活动。","reason","两起独立活动均把 LLM 接入完整入侵链，展示了代理式框架如何压缩操作时间并扩大多目标攻击规模。","source",{"_67":102},"links",{"_90":101},"publishedAt","2026-11-03T12:31:59.000Z","discoveredAt","2026-11-03T13:07:19.191Z","timelineAt","category","activity","tags",[70,72,94,95,96,97,98,99,100],"score",80,"selected",true,"channel","news","story","x","readingMode","full","author","Zeljka Zorz","body",{"_59":89,"_90":-5,"_91":92,"_93":37},"outline",[77,78,79],"relatedStories",[],"topics",[60,61,62,63,64],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_65":75,"_67":76},{"_65":73,"_67":74},{"_65":71,"_67":72},{"_65":69,"_67":70},{"_65":66,"_67":68},"slug","malware","name","恶意软件","attack","攻击活动","ai-offense","AI 攻防","ai-agent","AI Agent 安全","identity","身份与访问",{"_11":87,"_81":88,"_83":84},{"_11":85,"_81":86,"_83":84},{"_11":80,"_81":82,"_83":84},"sec-3","text","防御人员现在应该做什么","level",3,"sec-2","数天内取得域管理员权限","sec-1","ARTEX 扩大了 Vapor Panda 的攻击范围","<p>CrowdStrike 上周表示，一个与中国有关联的间谍组织在 11 天内使用 AI 智能体攻击了 200 多个组织。周一，Kaspersky 公布了针对非洲和拉丁美洲教育机构的另一次行动的详细信息，该行动由讲中文的操作人员实施。</p><p>尽管这些行动似乎并无关联，但其执行方式相同：由人工选择目标并设定目标，再由大型语言模型（LLM）决定运行哪些命令，并将其发送至受害者网络上的植入体。 </p><h3 id=\"sec-1\">ARTEX 扩大了 Vapor Panda 的攻击范围</h3><p>CrowdStrike 追踪的与中国有关联的组织 Vapor Panda 于 10 月 17 日开始使用名为 ARTEX 的智能体框架。该公司认定，在随后的 11 天里，同一个 ARTEX 控制端被用于攻击至少 14 个国家的组织。</p><p>目标包括拉丁美洲、欧洲、亚洲和中东地区的外交部，美国国防和半导体企业，以及电信服务商。 </p><p>CrowdStrike 证实了九家组织在遭到利用后的活动，该组织在这些组织中安装了 BloodAlchemy 后门。他还发现，针对至少另外 12 家组织的密码喷洒攻击，其中包括美国智库和欧洲政府机构。</p><p>ARTEX 框架主要基于 DeepSeek 运行，同时还使用了 CrowdStrike 无法识别的第二种商业 LLM。一个主智能体将任务分派给规划智能体和执行智能体，后者通过一个共享图谱记录所学到的信息。 </p><p>仅在一次入侵中，规划智能体就处理了大约 14 亿个输入 token。恢复的对话记录显示，操作人员在决策节点介入，并以中文编写指令。 </p><p>一条路径失败后，智能体会转而尝试另一条路径，但它们采用的技术并不陌生。</p><p>在一家制药公司，智能体将未签名的 SAML 断言与 XXE 漏洞结合，访问云实例元数据服务，随后逐步提升至企业管理员账户。 </p><p>该公司的消息人士表示，“在针对一个希腊政府实体的攻击中，操作人员向智能体提供了该组织邮件服务器于 2022 年导出的目录，其中包含可能自导出以来就未曾轮换的身份验证密钥。智能体使用这些密钥伪造管理员令牌并读取邮箱，随后利用从某个用户已发送邮件中恢复的 VPN 配置，以及操作人员称其来源于 2024 年 5 月一次邮件泄露的 VPN 客户端密钥，进入内部网络。”</p><p>这是 CrowdStrike 首次发现 Vapor Panda 使用 AI 工具，而该组织的目标清单也随着其使用而扩大。CrowdStrike <a href=\"https://www.crowdstrike.com/en-us/blog/vapor-panda-uses-artex-to-scale-global-campaign/\">指出</a>，这一发现以及 Microsoft 最近关于 Storm-0940 组织另行开展 ARTEX 活动的报告，似乎表明 ARTEX 框架正在与中国有关联的组织中普及。</p><h3 id=\"sec-2\">数天内取得域管理员权限</h3><p>Kaspersky 的报告涵盖了一次规模较小的行动，针对若干非洲和拉丁美洲国家的教育机构。 </p><p>攻击者使用了 CyberStrikeAI，这是一个用 Go 编写的开源渗透测试框架。LLM 运行在攻击者的命令与控制（C2）服务器上，用于规划后续步骤并生成命令。受害者机器上的植入体没有内置 AI，只会执行收到的指令。</p><p>攻击者“手动”攻入一台已遭入侵的 SQL Server，花费约一天时间进行侦察，随后沉寂了两周。但智能体一经安装，进展便迅速加快：它在两分钟内建立持久化并完成本地侦察，随后花费约五小时绘制域环境。 </p><p>几天后，横向移动、在多台主机上转储凭据以及导出数据库总共不到一小时。从代理部署到域管理员账户失陷，整个过程用了三到四天。</p><p>Kaspersky 没有将该活动与已知组织关联起来，但几条线索指向一名使用中文的操作者：脚本中的中文注释、对中国服务 <em>dnslog[.]cn</em> 的使用，以及多数发生在 UTC+8 工作时间内的 C2 服务器重启。 </p><p>“该工具本身的起源也从侧面指向同一方向：CyberStrikeAI 是由中国网络安全社区开发并在那里广为人知的，”Kaspersky 研究人员 <a href=\"https://securelist.com/tr/cyberstrikeai-attacks/121715/\">补充道</a>。</p><h3 id=\"sec-3\">防御人员现在应该做什么</h3><p>直到最近，有记录的攻击者使用 AI 的场景大多仍处于准备阶段：编写网络钓鱼邮件、修复代码、研究漏洞。在这些攻击活动中，模型本身已成为入侵过程的一部分。</p><p>“如果 HexStrike AI 等工具覆盖‘发现并突破’阶段，Sliver/Mythic/Havoc 覆盖‘建立据点并实施控制’阶段，那么 CyberStrikeAI 就补全了杀伤链：一个用 Go 编写的服务器端单进程通过 MCP 执行实用工具、处理 webshell 连接，并向植入体分派任务，同时模型分析结果并决定下一步行动，”Kaspersky 研究人员表示。</p><p>“关键结论是，将 AI 引入攻击链目前尚未给检测带来根本性的新挑战。所有‘智能’工作仍然在攻击者一侧，而失陷主机承受的仍是熟悉的操作：从通过 Kerberoasting 和 AS-REP Roasting 开展侦察，到转储 LSASS、DCSync，以及发动 Golden Ticket 攻击。”</p><p>他们补充道，这些攻击的新颖之处在于执行速度快且容易。</p><p>CrowdStrike 指出，检测只有在部署到位的地方才能发挥作用，而这些操作者专门寻找了其中的缺口。该公司建议组织在怀疑发生任何暴露后轮换密钥和凭据，强制执行 SAML 签名验证和 IMDSv2，搜寻 ARTEX 标记修补面向互联网的设备，并在所有位置部署 EDR。</p><p>该公司总结称：“与中国有关联的威胁行动者在未来 12 个月内极有可能继续采用 ARTEX 等智能体框架，将其与商业可用的 LLM 配合使用，使小型团队能够同时快速扩大对众多目标的入侵规模。”</p><p>Kaspersky 研究人员还预计，随着模型不断改进，这些工具所采用的技术会变得更加复杂，而操作者的工作也会从‘设置任务’转向‘监控模型的行为’。”</p><p><img src=\"/dailyinfo/media/e51c93a6617c3873.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong>订阅我们的突发新闻电子邮件提醒， 即时获取最新数据泄露、漏洞和网络安全威胁动态。<a href=\"https://www.helpnetsecurity.com/newsletter/\">立即订阅！</a></strong></p><p><img src=\"/dailyinfo/media/e51c93a6617c3873.webp\" loading=\"lazy\" decoding=\"async\"></p>","original","zhKind","translation","complete","Agent 安全","大模型","后门","凭据","CrowdStrike","Kaspersky","Microsoft","https://www.helpnetsecurity.com/2026/11/03/ai-powered-cyberattacks-artex-cyberstrikeai/","Help Net Security",{"_104":105,"_106":-5},"changelogVersion","2026-10-01T08:00","release"]
