[{"_1":2,"_3":4},"root",{"_5":172},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":37,"_59":60},"expiresAt",1794271236000,"id","pswh7gi302afiq1veacas1zfo","title","Cisco Secure Email Gateway SQL 注入漏洞 CVE-2026-76461 已遭在野利用","originalTitle","Cisco Secure Email Gateway SQL Injection Vulnerability","summary","Cisco Secure Email Gateway 的 SQL 注入漏洞 CVE-2026-76461 已被在野利用，未经身份验证的远程攻击者可通过发送含恶意 SQL 语句的邮件，在底层操作系统以 root 权限执行命令。","reason","通告同时给出利用前提、修复版本和在野利用确认信息，并提供日志排查与集群恢复建议，便于判断暴露范围和处置优先级。","source",{"_73":171},"links",{"_161":170},"publishedAt","2026-11-03T09:05:12.000Z","discoveredAt","2026-11-03T17:17:21.283Z","timelineAt","category","vuln","tags",[165,74,166,167,168,169],"score",81,"selected",true,"channel","news","story",{"_81":82,"_13":83},"x","readingMode","full","author","body",{"_60":160,"_161":-5,"_162":163,"_164":37},"outline",[84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107],"relatedStories",[80],"topics",[67,68,69,70],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","f501zbyGoYsM","reportCount",1,"additionalSourceCount",0,{"_71":78,"_73":79},{"_71":76,"_73":77},{"_71":31,"_73":75},{"_71":72,"_73":74},"slug","exploited","name","在野利用","漏洞披露","email","邮件与钓鱼","cisco","Cisco / 思科",{"_81":82,"_13":83},"publicId","7a4e5316-3f48-44db-b20c-da44c55725d4","Cisco修复ESA在野利用SQL注入漏洞",{"_11":158,"_109":159,"_111":112},{"_11":156,"_109":157,"_111":112},{"_11":154,"_109":155,"_111":112},{"_11":152,"_109":153,"_111":112},{"_11":150,"_109":151,"_111":112},{"_11":148,"_109":149,"_111":112},{"_11":146,"_109":147,"_111":115},{"_11":144,"_109":145,"_111":112},{"_11":142,"_109":143,"_111":115},{"_11":140,"_109":141,"_111":115},{"_11":138,"_109":139,"_111":115},{"_11":136,"_109":137,"_111":115},{"_11":134,"_109":135,"_111":115},{"_11":132,"_109":133,"_111":112},{"_11":130,"_109":131,"_111":112},{"_11":128,"_109":129,"_111":112},{"_11":126,"_109":127,"_111":112},{"_11":124,"_109":125,"_111":112},{"_11":122,"_109":123,"_111":112},{"_11":120,"_109":121,"_111":112},{"_11":118,"_109":119,"_111":112},{"_11":116,"_109":117,"_111":115},{"_11":113,"_109":114,"_111":115},{"_11":108,"_109":110,"_111":112},"sec-24","text","反馈","level",2,"sec-23","法律免责声明详情",3,"sec-22","软件下载与技术支持","sec-21","法律免责声明","sec-20","修订历史","sec-19","URL","sec-18","与本公告相关","sec-17","本公告的操作链接","sec-16","Cisco 安全漏洞策略","sec-15","来源","sec-14","利用情况与公开公告","sec-13","实用资源","sec-12","强化安全的一般建议","sec-11","Cisco Secure Email Cloud","sec-10","本地部署的虚拟设备","sec-9","本地部署的物理设备","sec-8","建议","sec-7","已修复版本","sec-6","Fixed Software","sec-5","变通方案","sec-4","入侵指标","sec-3","受影响的产品","sec-2","概述","sec-1","Cisco Secure Email Gateway SQL 注入漏洞","<table>\n\t\t\t\t\t<tbody><tr>\n\t\t\t\t\t\t<td>\n\t\t\t\t\t\t\t<h2 id=\"sec-1\">Cisco Secure Email Gateway SQL 注入漏洞</h2>\n\n<p>严重</p>\n\n<p>CVE-2026-76461</p>\n\n\n<p>CWE-89</p>\n\n\n\n\n<p><a href=\"https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-esa-inj-2bLVGmhX/csaf/cisco-sa-esa-inj-2bLVGmhX.json\">\n\n            \n            下载 CSAF\n          </a>\n</p>\n<p><a>\n          电子邮件\n        </a>\n</p>\n\n\n<h2 id=\"sec-2\">\n<p>\n                        概述\n                        \n                      </p>\n</h2>\n<ul>\n<li>\n<p>Cisco Secure Email Gateway 所用的 Cisco AsyncOS Software 中的电子邮件解析存在一个漏洞，可能允许未经身份验证的远程攻击者在底层操作系统上以 <em>root</em> 权限执行任意命令。</p>\n<p>此漏洞源于电子邮件解析逻辑中的验证不足。攻击者可通过发送包含恶意 SQL 语句的特制电子邮件消息来利用此漏洞。成功利用可能允许攻击者执行任意 SQL 语句，进而在底层操作系统上以 <em>root</em> 权限执行命令。</p>\n\n<p>Cisco 已发布解决此漏洞的软件更新。没有可解决此漏洞的变通方案。</p>\n<p>本公告可通过以下链接获取：<br><a href=\"https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-esa-inj-2bLVGmhX\">https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-esa-inj-2bLVGmhX</a></p>\n</li>\n</ul>\n<h2 id=\"sec-3\">\n<p>\n                          受影响的产品\n                          \n                        </p>\n</h2>\n<ul>\n<li>\n<p>此漏洞影响 <span>Cisco Secure Email Gateway 的物理和虚拟设备</span>，与设备配置无关。</p>\n<p>有关哪些 Cisco 软件版本易受此漏洞影响的信息，请参阅本公告的 <a href=\"https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-esa-inj-2bLVGmhX?vs_f=Cisco%20Security%20Advisory%26vs_cat=Security%20Intelligence%26vs_type=RSS%26vs_p=Cisco%20Secure%20Email%20Gateway%20SQL%20Injection%20Vulnerability%26vs_k=1#fs\">Fixed Software</a> 部分。</p>\n\n\n<p>据已知，只有本公告 <a href=\"https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-esa-inj-2bLVGmhX?vs_f=Cisco%20Security%20Advisory%26vs_cat=Security%20Intelligence%26vs_type=RSS%26vs_p=Cisco%20Secure%20Email%20Gateway%20SQL%20Injection%20Vulnerability%26vs_k=1#vp\">Vulnerable Products</a> 部分列出的产品受此漏洞影响。</p>\n<p>Cisco 已确认此漏洞不影响以下 Cisco 产品：</p>\n<ul>\n<li><span>Secure Email and Web Manager</span></li>\n<li>Secure Web Appliance</li>\n</ul>\n\n\n\n\n</li>\n</ul>\n<h2 id=\"sec-4\">\n<p>\n                          入侵指标\n                          \n                        </p>\n</h2>\n<ul>\n<li>\n<p>要确认是否存在尝试利用此漏洞的情况，请检查 <em>mail_logs</em> 并查找可疑的 SQL 语句。如果设备是集群的一部分，请检查每个集群设备的日志。以下是在日志中检测恶意 SQL 语句的方法示例（并非涵盖所有情况）：</p>\n<blockquote>\n<pre>cisco-esa&gt; <strong><span>grep -i \"COPY.*TO PROGRAM\" [IronPort Text Mail Logs Log name - Default: mail_logs]</span></strong></pre>\n</blockquote>\n<p>输出中出现任何条目都可能表明存在恶意活动。</p>\n<p>在 Cisco Secure Email Cloud 上，无 CLI 访问权限的管理员可能无法独立检查所述入侵指标。Cisco 已直接联系拥有检测到恶意活动的 Cisco Secure Email Cloud 设备的客户。</p>\n<p><strong>注意</strong>：成功利用此漏洞后，威胁行为者可能获得以 <em>root</em> 权限执行命令的能力。由于拥有此级别的访问权限，威胁行为者可能会删除或隐藏利用证据和入侵指标。Cisco 强烈建议管理员交叉检查受影响设备之外的网络日志和防火墙日志，以识别任何潜在的可疑活动，包括但不限于从受影响设备发起到外部 IP 地址的意外上传，或从恶意 IP 地址进行的下载。</p>\n\n\n</li>\n</ul>\n<h2 id=\"sec-5\">\n\n<p>\n                          变通方案\n                          \n                        </p>\n</h2>\n<ul>\n<li>\n<p>没有可解决此漏洞的变通方案。</p>\n</li>\n</ul>\n<h2 id=\"sec-6\">\n<p>\n                          Fixed Software\n                          \n                        </p>\n</h2>\n<ul>\n<li>\n<p>Cisco 认为，任何变通方法和缓解措施（如适用）都只是临时解决方案，直到可以升级到包含修复的软件版本。为修复此漏洞并避免按照本公告所述在未来面临暴露风险，Cisco 强烈建议客户升级到本公告中指定的已修复软件版本。</p>\n\n\n<h3 id=\"sec-7\">已修复版本</h3>\n<p>在下表中，左侧列列出 Cisco 软件版本，右侧列说明该版本是否受本公告所述漏洞影响，并列出包含这些漏洞修复程序的第一个版本。建议客户升级到本节指定的适当<a href=\"https://sec.cloudapps.cisco.com/security/center/resources/security_vulnerability_policy.html#fixes\">已修复软件版本</a>。</p>\n<table>\n<thead>\n<tr>\n<th>Cisco AsyncOS for Cisco Secure Email Gateway 软件版本</th>\n<th>首个已修复版本              </th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>15.5 及更早版本</td>\n<td>15.5.5-014*</td>\n</tr>\n<tr>\n<td>16.0</td>\n<td>16.0.4-302</td>\n</tr>\n<tr>\n<td>16.5</td>\n<td>16.5.0-780</td>\n</tr>\n</tbody>\n</table>\n<p>*鉴于出现了与在线可用漏洞利用代码有关的新信息，Cisco 于 10 月 31 日发布了更新后的修复版本，该修复包含在 Release 15.5.5-014 中，用于解决此漏洞。要确认 Release 15.5.5-014 的更新修复程序已安装，请使用 CLI <strong>retroscannerstatus </strong>命令进行验证，确认 Cisco Retro Remediation Engine 正在运行 Version 4.0.2 或更高版本。无论 Cisco Retro Remediation Engine 的版本如何，Release 16.5.0-780 均已解决本安全公告中提及的漏洞。</p>\n<p><strong>注意：</strong>Cisco 强烈建议正在运行早于 Release 16.5 的版本的客户迁移到 Release 16.5.0-780。有关 Cisco Secure Email Cloud 的信息，请参阅本节末尾。 </p>\n<p>Cisco 产品安全事件响应团队（PSIRT）仅验证本公告中记录的受影响版本和已修复版本信息。 </p>\n<p>可使用设备基于 Web 的管理界面中的 System Upgrade 选项通过网络升级软件。</p>\n<p>要使用基于 Web 的管理界面升级设备，请执行以下操作：</p>\n<ol>\n<li>选择 <strong>System Administration &gt; System Upgrade</strong>。</li>\n<li>单击 <strong>Upgrade Options</strong>。</li>\n<li>单击 <strong>Download and Install</strong>。</li>\n<li>选择要升级到的版本。</li>\n<li>在 <strong>Upgrade Preparation</strong> 区域中选择适当的选项。</li>\n<li>单击 <strong>Proceed</strong> 开始升级。进度条将显示升级状态。</li>\n</ol>\n<p>升级完成后，设备将重新启动。</p>\n<p>要使用 CLI 升级设备，请执行以下操作：</p>\n<ol>\n<li>运行 <strong>upgrade</strong>。</li>\n<li>输入 <strong>DOWNLOADINSTALL</strong>。</li>\n<li>选择要升级到的版本。</li>\n<li>在升级过程中选择适当的选项。</li>\n</ol>\n<p>升级完成后，设备将重新启动。</p>\n<p><strong>Cisco Secure Email Cloud</strong></p>\n<p>Cisco Secure Email Cloud 服务解决方案包括 Cisco Secure Email Gateway 以及 Cisco Secure Email and Web Manager 设备。Cisco 会对该解决方案中包含的产品进行定期维护。客户也可以联系 Cisco Secure Email Cloud 支持团队申请软件升级。</p>\n<p>Cisco 已将所有 Cisco Secure Email Cloud 设备升级到 Release 16.5.0-780。</p>\n\n</li>\n</ul>\n<h2 id=\"sec-8\">\n<p>\n                          建议\n                          \n                        </p>\n</h2>\n<ul>\n<li>\n<h3 id=\"sec-9\">本地部署的物理设备</h3>\n<p>如果怀疑 Cisco <strong>物理</strong>设备遭到利用，Cisco 建议联系 <a href=\"https://www.cisco.com/c/en/us/support/index.html\">Cisco 技术协助中心 (TAC)</a> 以获得进一步支持。为加快我们对此潜在入侵事件的调查，请确保受影响设备已启用远程访问。有关更多指导，请参阅 <a href=\"https://www.cisco.com/c/en/us/support/docs/security/email-security-appliance/117873-faq-esa-00.html\">Cisco ESA/WSA/SMA 远程访问常见问题</a>。</p>\n<h3 id=\"sec-10\">本地部署的虚拟设备</h3>\n<p>如果怀疑 Cisco <strong>虚拟</strong>设备遭到利用，Cisco 强烈建议在可能的情况下采取以下操作，将设备恢复到安全配置：</p>\n<ol>\n<li>按照客户的事件处理策略保留取证信息。<strong>重要：</strong>在继续执行以下任何步骤之前记录取证信息。部署新实例将销毁配置和日志。</li>\n<li>部署运行已修复软件版本之一的新虚拟机。</li>\n<li>重新构建产品配置。</li>\n<li>更新设备上安装的凭据和所有密码学材料。</li>\n<li>继续监控系统是否出现异常行为。</li>\n</ol>\n<p><strong>注意</strong>：Cisco Secure Email Gateway 设备可以是集群的一部分。SSH 密钥对用于集群成员之间的身份验证。成功利用此漏洞后，用于此类通信的 SSH 私钥可能会在已失陷设备上被访问。获取这些密钥可能使攻击者得以入侵其他集群成员。因此，Cisco 强烈建议将包含至少一个已失陷设备的集群中的每个成员恢复到安全配置。</p>\n<p>如果无法恢复设备，Cisco 建议联系 <a href=\"https://www.cisco.com/c/en/us/support/index.html\">Cisco TAC</a> 以获得进一步支持。</p>\n<p>如果未怀疑遭到利用，而设备正在运行受影响的软件版本，Cisco 强烈建议升级到已修复的版本。</p>\n<h3 id=\"sec-11\">Cisco Secure Email Cloud</h3>\n<p>Cisco 已对属于 Cisco Secure Email Cloud 的设备开展全面的威胁情报调查。对于发现可能入侵指标的 Cisco Secure Email Cloud 设备，Cisco 已直接联系其客户。Cisco 正在开展修复和恢复操作。Cisco 已在 Cisco 的管理范围内部署缓解措施。</p>\n<p>此外，Cisco 强烈建议已被联系的客户在可能的情况下，通过更新凭据以及设备上安装的任何加密材料，将设备恢复至安全配置。</p>\n<p>此外，Cisco 强烈建议限制对设备的访问，并实施稳健的访问控制机制。 </p>\n<h3 id=\"sec-12\">强化安全的一般建议</h3>\n<ul>\n<li>将设备升级到最新版本的 Cisco AsyncOS Software。</li>\n<li>阻止从互联网访问设备。如果必须从互联网访问设备，应将设备访问限制为仅允许用户指南中列出的已知可信主机，并仅使用其中列出的端口和协议。</li>\n<li><span><span><span>对于 Cisco Secure Email Gateway，请将邮件功能与管理功能分别置于独立的网络接口上。这样可以降低未经授权的用户访问内部管理网络的可能性。有关更多信息，请参阅设备用户指南。</span></span></span></li>\n<li><span><span>将 Cisco Secure Email Gateway 和 Cisco Secure Email and Web Manager 设备置于防火墙等过滤设备之后，并过滤进出这些设备的管理流量，同时仅允许已知且受信任的主机向这些设备发送流量。使用双层防火墙可以在网络规划中提供灵活性，从而避免最终用户直接连接到外层 DMZ。有关详细信息，请参阅 <a href=\"https://www.cisco.com/c/en/us/td/docs/security/esa/esa16-5/user_guide/b_ESA_Admin_Guide_16-5.html\">Cisco Secure Email Gateway</a> 和 <a href=\"https://www.cisco.com/c/en/us/td/docs/security/security_management/sma/sma16-5/user_guide/b_sma_admin_guide_16_5.html\">Cisco Secure Email and Web Manager</a> 用户指南的“部署”部分。</span></span></li>\n<li><span><span><span>定期监控日志流量，检查是否有任何进出设备的异常流量。如有可能，应将日志发送到外部服务器，并保留足够长的时间，以便在事件后开展调查时能够获得充分的日志数据。</span></span></span></li>\n<li>为主管理员门户禁用 HTTP。</li>\n<li>禁用任何不需要的网络服务，包括 HTTP 和 FTP。有关特定服务功能的更多信息，请参阅 Cisco Secure Email Gateway 和 Cisco Secure Email and Web Manager 用户指南。</li>\n<li>对设备使用强度较高的最终用户身份验证方式，例如 SAML 或轻量级目录访问协议 (LDAP)。有关更安全的身份验证方法，请参阅 <a href=\"https://www.cisco.com/c/en/us/td/docs/security/esa/esa16-5/user_guide/b_ESA_Admin_Guide_16-5/b_ESA_Admin_Guide_12_1_chapter_0100000.html#con_1623537\">最终用户访问垃圾邮件管理功能的身份验证选项</a>。</li>\n<li>将默认管理员密码更改为更安全的变体。根据必要的访问权限要求创建用户账户，以限制对管理员账户的访问。此外，为所有管理员创建操作员账户。</li>\n<li>使用 SSL/TLS，从证书颁发机构 (CA) 获取 SSL 证书或创建自签名证书。</li>\n</ul>\n<br>\n<h3 id=\"sec-13\">实用资源</h3>\n<p>以下资源有助于将受影响的设备恢复到安全状态。其中一些文档与特定产品相关，但其中的流程大多可以互换。如果客户对某个流程有具体疑问，请联系 <a href=\"https://www.cisco.com/c/en/us/support/index.html\">Cisco TAC</a>。</p>\n<p>有关下载替换虚拟设备的信息，请参阅相应的 Cisco Software Download 页面：</p>\n<ul>\n<li><a href=\"https://software.cisco.com/download/home/284900944/type/282975113/release/16.5.0\">Cisco Secure Email Gateway</a></li>\n<li><a href=\"https://software.cisco.com/download/home/286283259/type/286283388/release/16.5.0\">Cisco Secure Email and Web Manager</a></li>\n</ul>\n<p><a href=\"https://www.cisco.com/c/en/us/td/docs/security/security_management/sma/sma16-5/user_guide/b_sma_admin_guide_16_5.html\">Cisco Secure Email and Web Manager 的 AsyncOS 16.5 用户指南</a>提供了更多信息。请参阅以下部分：</p>\n<ul>\n<li>有关从设备导出报告数据的信息，请参阅 <a href=\"https://www.cisco.com/c/en/us/td/docs/security/security_management/sma/sma16-5/user_guide/b_sma_admin_guide_16_5/b_NGSMA_Admin_Guide_chapter_010.html\">使用报告</a>。</li>\n<li>有关如何清除隔离区中邮件的信息，请参阅 <a href=\"https://www.cisco.com/c/en/us/td/docs/security/security_management/sma/sma16-5/user_guide/b_sma_admin_guide_16_5/b_NGSMA_Admin_Guide_chapter_0101.html\">垃圾邮件隔离区</a>。</li>\n<li>有关更多信息，请参阅 <a href=\"https://www.cisco.com/c/en/us/td/docs/security/esa/esa16-5/user_guide/b_ESA_Admin_Guide_16-5/b_ESA_Admin_Guide_12_1_chapter_0101011.html#con_1158787\">集中管理策略、病毒和爆发隔离区</a>。</li>\n</ul>\n</li>\n</ul>\n<h2 id=\"sec-14\">\n<p>\n                          利用情况与公开公告\n                          \n                        </p>\n</h2>\n<ul>\n<li>\n<p>2026 年 9 月，Cisco PSIRT 获知此漏洞正遭到主动利用。</p>\n</li>\n</ul>\n<h2 id=\"sec-15\">\n<p>\n                          来源\n                          \n                        </p>\n</h2>\n<ul>\n<li>\n<p>此漏洞是在处理 Cisco TAC 支持案例时发现的。</p>\n</li>\n</ul>\n\n<h2 id=\"sec-16\">\n<p>\n        Cisco 安全漏洞策略\n        \n      </p>\n</h2>\n<ul>\n<li>\n<p>要了解 Cisco 安全漏洞披露策略和相关出版物，请参阅 <a href=\"http://www.cisco.com/web/about/security/psirt/security_vulnerability_policy.html\">安全漏洞策略</a>。该文档还包含有关获取修复软件以及从 Cisco 接收安全漏洞信息的说明。</p>\n<p>有关 Cisco 的漏洞管理、披露节奏和软件补丁策略的更多信息，请参阅 <a href=\"https://sec.cloudapps.cisco.com/security/center/resources/risk-based-disclosure\">Cisco 向基于风险的漏洞披露模式的转型</a>。</p>\n</li>\n</ul>\n\n<ul>\n<li>\n<p><a href=\"https://www.cisco.com/c/en/us/support/web/tools/cns/notifications.html\">订阅</a>\n</p>\n</li>\n</ul>\n<h2 id=\"sec-17\">\n<p>\n          \n          本公告的操作链接\n        </p>\n</h2>\n<ul>\n<li>\n<p><span><a href=\"https://www.snort.org/\">Snort Rule 3:67109</a></span>\n</p>\n<p><span><a href=\"https://www.snort.org/\">Snort Rule 3:67110</a></span>\n</p>\n\n</li>\n</ul>\n<h2 id=\"sec-18\">\n<p>\n          \n          与本公告相关\n        </p>\n</h2>\n<ul>\n<li></li>\n</ul>\n\n<h2 id=\"sec-19\">\n<p>\n                        URL\n                        \n                      </p>\n</h2>\n<ul>\n<li>\n<p><a href=\"https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-esa-inj-2bLVGmhX\">https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-esa-inj-2bLVGmhX</a></p>\n</li>\n</ul>\n<h2 id=\"sec-20\">\n<p>\n                        修订历史\n                        \n                      </p>\n</h2>\n<ul>\n<li>\n<table>\n\t<thead>\n\t\t<tr>\n\t\t\t<th>版本</th>\n\t\t\t<th>说明</th>\n\t\t\t<th>章节</th>\n\t\t\t<th>状态</th>\n\t\t\t<th>日期</th>\n\t\t</tr>\n\t</thead>\n\t<tbody>\n\t\t<tr>\n\t\t\t<td>1.2</td>\n\t\t\t<td>更新了与 Fixed Releases 表中 Release 15.5.5-014 相关的信息。</td>\n\t\t\t<td>固定软件</td>\n\t\t\t<td>最终</td>\n\t\t\t<td>2026-11-03</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>1.1</td>\n\t\t\t<td>增加了有关集群设备说明的澄清。</td>\n\t\t\t<td>建议</td>\n\t\t\t<td>最终</td>\n\t\t\t<td>2026-09-17</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>1.0</td>\n\t\t\t<td>首次公开发布。</td>\n\t\t\t<td>-</td>\n\t\t\t<td>最终</td>\n\t\t\t<td>2026-09-14</td>\n\t\t</tr>\n\t</tbody>\n</table>\n<p><a>显示更少</a>\n</p>\n</li>\n</ul>\n<hr>\n<h2 id=\"sec-21\">\n<p>\n                          法律免责声明\n                        </p>\n</h2>\n<ul>\n<li>\n<h3 id=\"sec-22\">软件下载与技术支持</h3><p>Cisco.com 上的 <a href=\"https://www.cisco.com/c/en/us/support/index.html\">Cisco 支持与下载</a>页面提供有关许可和下载的信息。对于使用“我的设备”工具的客户，该页面还可显示客户设备的支持覆盖情况。请注意，客户只能下载直接或通过 Cisco 授权经销商或合作伙伴采购且许可证仍然有效的软件。</p><p>直接向 Cisco 购买但未持有 Cisco 服务合同，以及通过第三方供应商购买但未能通过其销售点获得固定软件的客户，应联系 <a href=\"https://www.cisco.com/c/en/us/support/web/tsd-cisco-worldwide-contacts.html\">Cisco 技术协助中心 (TAC)</a>获取升级。客户应准备好提供产品序列号，并准备提供本公告的 URL，作为享有免费升级权益的证明。</p><p><a href=\"https://sec.cloudapps.cisco.com/security/center/resources/security_vulnerability_policy.html#fixes\">考虑软件升级</a>时，建议客户定期查阅相关 Cisco 产品的<a href=\"https://www.cisco.com/go/psirt\">公告</a>，以确定所受影响的范围以及完整的升级解决方案。在所有情况下，客户均应确保待升级设备拥有足够的内存，并确认当前的硬件和软件配置将能够继续在新版本中得到适当支持。如果信息不明确，建议客户联系 <a href=\"https://www.cisco.com/c/en/us/support/web/tsd-cisco-worldwide-contacts.html\">Cisco 技术协助中心 (TAC)</a>或其签约维护服务提供商。</p><h3 id=\"sec-23\">法律免责声明详情</h3><p>CISCO 不对任何种类的明示或默示保证或承诺作出任何保证，包括对适销性或特定用途适用性的保证。在不限制前述一般性声明的前提下，CISCO 不保证本信息的准确性或完整性。本文档按“现状”提供。您使用本文档或从本文档链接的材料所含信息，风险由您自行承担。CISCO 保留随时更改或更新本文档的权利。</p><p>本安全公告所含信息的副本或摘要可能缺少重要信息或包含事实错误。建议客户访问 <a href=\"https://www.cisco.com/go/psirt\">Cisco 安全公告</a>页面，以获取本安全公告的最新版本。Cisco 产品安全事件响应团队（PSIRT）仅评估本公告中记录的受影响版本和已修复版本信息。更多信息请参阅 <a href=\"https://sec.cloudapps.cisco.com/security/center/resources/security_vulnerability_policy.html#fixes\">Cisco 安全漏洞政策</a>。</p>\n</li>\n</ul>\n\n\n<h2 id=\"sec-24\">\n<p>\n                          反馈\n                        </p>\n</h2>\n<ul>\n<li>\n<p>留下更多反馈\n</p>\n</li>\n</ul>\n\n\n\n\n\n \n\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\n\n\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t</tr>\n\t\t\t\t</tbody></table>","original","zhKind","translation","complete","漏洞","补丁","Cisco","邮件安全","网络设备","https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-esa-inj-2bLVGmhX?vs_f=Cisco%20Security%20Advisory%26vs_cat=Security%20Intelligence%26vs_type=RSS%26vs_p=Cisco%20Secure%20Email%20Gateway%20SQL%20Injection%20Vulnerability%26vs_k=1","Cisco PSIRT",{"_173":174,"_175":-5},"changelogVersion","2026-10-01T08:00","release"]
