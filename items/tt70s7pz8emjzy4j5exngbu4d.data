[{"_1":2,"_3":4},"root",{"_5":108},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1794357643000,"id","tt70s7pz8emjzy4j5exngbu4d","title","攻击者滥用 Qubole 的 AWS 信任关系，窃取多个客户账户数据","originalTitle","Hackers Exploit Qubole's Trusted AWS Access to Breach Customer Accounts and Steal Data","summary","攻击者在 October 14 至 October 26 期间利用 Qubole 平台 AWS 账户的凭据，接管多个客户 AWS 账户，读取 Lambda 环境变量、Secrets Manager、SSM Parameter Store 中的凭据并复制 S3 数据。","reason","source",{"_74":107},"links",{"_96":106},"publishedAt","2026-11-09T17:51:21.000Z","discoveredAt","2026-11-09T18:09:18.997Z","timelineAt","category","activity","tags",[75,102,103,104,105],"score",80,"selected",true,"channel","news","story",{"_81":82,"_13":83},"x","sameEvent",{"_11":100,"_13":101},"readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_62":95,"_96":-5,"_97":98,"_99":36},"outline",[84,85,86],"relatedStories",[80],"topics",[69,70,71],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","fk58SsBPjLEA","reportCount",3,"additionalSourceCount",2,{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","attack","name","攻击活动","identity","身份与访问","cloud-native","云与原生",{"_81":82,"_13":83},"publicId","c89882b9-875a-45bb-a875-5c08c593cc82","Qubole凭据泄露波及多家客户",{"_11":93,"_88":94,"_90":66},{"_11":91,"_88":92,"_90":66},{"_11":87,"_88":89,"_90":66},"sec-3","text","如何封堵该路径","level","sec-2","如何检查你的账户","sec-1","这些角色为何让攻击者得以进入","<p><span><i></i><span>Swati Khandelwal</span><i></i><span>2026年11月09日</span></span><span>云安全 / 数据泄露</span></p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjj3p_1P-Ko_l_HuUr2Doq9kJOQa3Y5dCrkiVWqjJXzvQfYgKvgJXyvdBqLH2hp7s_ZY2kk-hhaCQhjf_v9SdjSbNpaDV2Eohk6-NEFUZp_ROjMJf_Q1xUSKcrqNj-Dd5ZrfjV6uP1blo579IaZ6hgHxOFAUhyJVgdGop-KVIWCjWQIYOKku3iN1N1EIUk/s1600/aws-hacked.jpg\"><img alt=\"\" src=\"/dailyinfo/media/71c26a8ea869a08b.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>云安全公司 Wiz 今天表示，攻击者在 10 月 14 日至 10 月 26 日之间入侵了多个 Qubole 客户所属的 AWS 账户，并窃取了存储的机密和数据。</p><p>攻击者使用了 Qubole 平台用于访问这些客户的某个 AWS 账户的凭据。攻击者是如何获得这些凭据的，尚未披露。</p><p><strong>Qubole</strong> 是 Idera 旗下拥有的数据湖平台，运行在客户的 AWS 账户内。为了允许其访问，客户会创建一个 IAM 角色，这是一种具有自己权限集的 AWS 身份。</p><p>该角色的信任策略允许 Qubole 的 AWS 账户承担此角色，从而授予这些权限。每个此类请求都称为 <strong>AssumeRole</strong>，并且必须包含 Qubole 称为 External ID 的匹配代码。</p><p>据 Wiz 的研究人员称，除此次攻击外，攻击者承担的大多数角色均未被使用。但每个角色仍然信任 Qubole 的账户，因此攻击者的请求得以成功。</p><p>任何已将 Qubole 连接到 AWS 的组织，即使是不再使用 Qubole 的组织，都应检查其自 10 月 1 日起的 CloudTrail 日志。需要查找的迹象是，来自 Qubole 平台所使用的账户 805246085872 且来自 AWS 外部地址的 AssumeRole 请求。</p><p>研究人员没有说明这些凭据此后是否已被禁用，也没有说明相关活动是否已经停止。The Hacker News 今天查看时，Qubole 和 Idera 均未在其网站上发布关于此次攻击的声明。</p><h3 id=\"sec-1\">这些角色为何让攻击者得以进入</h3><p>研究人员表示，在其<a href=\"https://www.wiz.io/blog/qubole-cross-account-access-abused-in-the-wild\">技术分析</a>中，攻击者发起的每个 AssumeRole 请求都带有 External ID，并且均被接受。</p><p>AWS 会在此类角色的 AssumeRole 请求来自受信任账户且包含正确 External ID 时接受该请求。根据 AWS 的<a href=\"https://docs.aws.amazon.com/IAM/latest/UserGuide/id_roles_common-scenarios_third-party.html\">External ID 指南</a>，该代码不会被视为机密，任何有权访问该角色的人都可以查看。</p><p>Sentra 在其若干客户环境中发现了这些活动，并提醒了研究人员。</p><p>在研究人员检查的账户中，攻击者寻找存储的凭据。它读取了 Lambda 函数的环境变量，从 Secrets Manager 中提取了机密，并读取了 SSM Parameter Store 中的值。</p><p>随后，它将找到的凭据输入 TruffleHog，以测试这些凭据是否有效。这些是受害者自己的 AWS 访问密钥、Entra ID 客户端密钥和 Okta 客户端凭据。</p><p>攻击者还从 S3 复制了数据。它会从角色能够访问的任何存储桶中检索数据，而不是搜索特定数据，有时还会在一次会话中下载整个存储桶。</p><p>研究人员尚未将此次攻击活动与其他任何公开报告的活动联系起来，并表示其目标锁定方式与国家支持组织通常所针对的目标不符。</p><p>Qubole 还允许客户使用 AWS 访问密钥而非角色进行连接。10 月 8 日至 10 月 11 日，攻击者使用了客户自己的 AWS 访问密钥，研究人员认为这些密钥是为 Qubole 设置的。</p><p>该攻击者随后入侵了若干受害者的云环境。这些活动尚未与 AssumeRole 的滥用行为联系起来。</p><h3 id=\"sec-2\">如何检查你的账户</h3><p>Wiz 的威胁狩猎指南涵盖每个持有 Qubole 角色的 AWS 账户自 10 月 1 日起的 CloudTrail 日志。查找：</p><ul>\n  <li><strong>账户：</strong>&nbsp;AssumeRole 请求中&nbsp;userIdentity.accountId&nbsp;为&nbsp;805246085872，且&nbsp;sourceIPAddress&nbsp;不是 AWS 地址。研究人员发现，Qubole 的真实流量仅来自 AWS。</li>\n  <li><strong>IAM principal ID：</strong>&nbsp;AIDA3W7DIFLYOLTK63SFS。此 IAM 用户的任何活动都应进行调查，因为在研究人员检查过的账户中，只有攻击者使用过它。</li>\n  <li><strong>IAM principal ID：</strong>&nbsp;AIDAJYRRH5Y3A7AAJM2HW，且源地址位于 AWS 之外。攻击者从 10 月 18 日起使用此 IAM 用户，但 Qubole 的正常流量也使用它。</li>\n  <li><strong>IP：</strong>&nbsp;57.129.54[.]120&nbsp;和&nbsp;2001:41d0:70d[:]7800::，攻击者使用的 OVH 托管地址。</li>\n  <li><strong>IP：</strong>&nbsp;45.83.220[.]211、&nbsp;185.209.199[.]73&nbsp;和&nbsp;89.37.63[.]175，这些是 Mullvad VPN 地址。其他 VPN 用户也会共享这些地址，因此仅凭匹配不能作为证据。</li>\n  <li><strong>会话名称：</strong>&nbsp;以&nbsp;quiam-&nbsp;开头的角色会话，例如&nbsp;quiam-enum。</li>\n  <li><strong>用户代理：</strong>&nbsp;从上述某个 IP 地址发起的&nbsp;GetCallerIdentity&nbsp;调用使用了&nbsp;TruffleHog&nbsp;。请在你的身份提供商登录日志中查找相同的用户代理。</li>\n</ul><p>对于每个可疑会话，审查其之后执行的所有操作，尤其是在 Secrets Manager、SSM Parameter Store、Lambda 和 S3 中。</p><p>CloudTrail 管理事件会记录每个 AssumeRole 请求和存储桶列表操作，但不会记录读取了哪些 S3 对象。这需要 S3 数据事件或 S3 服务器访问日志。多名受害者缺少所需日志，因此响应人员无法确定攻击者读取了哪些对象。</p><h3 id=\"sec-3\">如何封堵该路径</h3><p>研究人员建议采取以下步骤：</p><ol>\n  <li>如果攻击者承担了你们的某个 Qubole 角色，请轮换该角色有权访问的所有机密、参数和 Lambda 环境变量，并撤销该角色的活动会话。轮换凭据不会终止已经签发的会话。</li>\n  <li>移除任何不再需要的 Qubole 角色，或将 Qubole 的账户从其信任策略中移除。</li>\n  <li>在 Qubole 支持的情况下，将信任策略中适用于整个账户的&nbsp;:root&nbsp;主体替换为 Qubole 使用的特定 IAM 主体。</li>\n  <li>添加&nbsp;aws:SourceIp&nbsp;或&nbsp;aws:SourceVpce&nbsp;条件，将 AssumeRole 请求限制在供应商文档所述的网络范围内。研究人员表示，在此次攻击中，“仅设置源 IP 条件本就可以阻止我们观察到的每一次角色承担。”</li>\n  <li>假定他人可以看到 External ID。它会以明文形式记录在 CloudTrail 中，供应商和基础设施即代码文件也经常存储它，因此不要将其作为唯一控制手段。发生此类事件后，请将其更改为 Qubole，并在可能的情况下为每个角色使用不同的值。</li>\n  <li>审查每个供应商角色可以访问的范围。研究人员称，Qubole 的<a href=\"https://docs.qubole.com/en/latest/user-guide/managing-accounts/aws/iam-roles/create-iam-roles.html\">设置指南</a>包含一个示例 S3 策略，该策略允许该角色读取账户中的每个存储桶。供应商角色为便于使用，通常会被授予访问 Lambda 设置、Secrets Manager、SSM 参数以及广泛 S3 读取权限的权限。</li>\n  <li>针对来自供应商账户、通过 VPN 或此前未曾使用的托管公司发起的 AssumeRole 请求设置警报。</li>\n  <li>使用组织跟踪记录每个账户和区域，并为存储敏感数据的存储桶启用 S3 数据事件或服务器访问日志。</li>\n</ol><p>觉得这篇文章有趣？请在 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a> 上关注我们，查看我们发布的更多独家内容。</p>","original","zhKind","translation","complete","z1rbbg1rezvz2n96l279tbb9b","攻击者利用 Qubole AWS 信任关系窃取多个客户环境数据","数据泄露","凭据","云原生","AWS","https://thehackernews.com/2026/11/hackers-exploit-quboles-trusted-aws.html","The Hacker News",{"_109":110,"_111":-5},"changelogVersion","2026-10-01T08:00","release"]
