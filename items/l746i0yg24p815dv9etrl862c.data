[{"_1":2,"_3":4},"root",{"_5":102},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":60,"_61":62},"expiresAt",1794195830000,"id","l746i0yg24p815dv9etrl862c","title","韩国警方侦破利用 ARTEX AI 攻击 90 多个机构的网络犯罪团伙","originalTitle","Former pentester used ARTEX AI to steal 8.2 million data records","summary","韩国警方侦破一个利用 ARTEX AI 渗透测试框架大规模入侵的团伙，7 名嫌疑人涉及该国 90 多个机构，疑似窃取 820 万条记录。团伙自 2025 年 9 月开始攻击，并在 2026 年 8 月末引入 AI 工具扩大攻击；其中 38 起事件以 360 万韩元（$270,000）勒索，承诺不泄露窃取的数据。警方已通过受害机构服务器日志锁定嫌疑人，目前调查重点是被盗数据是否已泄露至暗网。","reason","案件呈现了渗透测试背景人员借助 ARTEX AI 扩大攻击规模的方式，并说明警方通过服务器日志锁定嫌疑人及调查数据泄露情况。","source",{"_75":101},"links",{"_62":100},"publishedAt","2026-10-26T21:08:28.000Z","discoveredAt","2026-10-28T09:02:43.240Z","timelineAt","category","activity","tags",[76,97,98,78,99],"score",75,"selected",true,"channel","news","story",{"_84":85,"_13":86},"x","readingMode","full","author","Bill Toulas","body",{"_93":-5,"_62":94,"_95":-5,"_96":60},"outline",[87],"relatedStories",[83],"topics",[69,70,71,72],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation",false,"bodyLanguage","original","factId","fkV6-ew93ND8","reportCount",1,"additionalSourceCount",0,{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","attack","name","攻击活动","ai-offense","AI 攻防","ai-agent","AI Agent 安全","ransomware","勒索软件",{"_84":85,"_13":86},"publicId","53abb902-79e4-4aba-a9a5-c9f00c715722","韩国警方侦破ARTEX AI大规模入侵案",{"_11":88,"_89":90,"_91":92},"sec-1","text","Once attackers have valid credentials, only 37% of their actions are blocked","level",2,"zh","<p><img alt=\"Former pentester used ARTEX AI to steal 8.2 million data records\" height=\"900\" src=\"/dailyinfo/media/7489d366856dd0bf.jpg\" srcset=\"/dailyinfo/media/88a8a033c17484fe.jpg 720w, /dailyinfo/media/b9840bc9f0448a88.jpg 1200w, /dailyinfo/media/7489d366856dd0bf.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>South Korean police identified seven suspects linked to a cybercrime operation that breached more than 90 organizations in the country, with ARTEX&nbsp;AI pentesting&nbsp;framework used in most of the attacks.</p><p>According to local media citing the Seoul Metropolitan Police, the gang leader has a background in penetration testing and worked at a cybersecurity company between 2019 and 2022.</p><p>In 38 of the incidents, the threat actor demanded ransom payments of 360 million won ($270,000), promising in exchange not to leak stolen data.</p><p>Authorities believe the threat actor stole 8.2 million records from compromised organizations, including educational institutes, hospitals, large corporations, and even golf courses.</p><figure><img alt=\"Extortion message sent to a victim\" height=\"450\" src=\"/dailyinfo/media/5863f44296544c2c.jpg\" loading=\"lazy\" decoding=\"async\" width=\"600\">\n<figcaption><strong>Extortion message sent to a victim</strong><br>\n<em>Source: Yonhap</em></figcaption>\n</figure><p><a href=\"http://www.yna.co.kr/view/AKR20261026075100004\">Yonhap News says</a> that the gang leader is a self-taught 32 year-old hacker and started attacking organizations in September 2025.</p><p>The Seoul Metropolitan police told the publication that the hacker used the ARTEX AI penetration testing suite, the same autonomous framework used in the attacks against <a href=\"https://www.bleepingcomputer.com/news/security/hacker-used-artex-ai-and-claude-agents-to-target-south-korean-banks/\">multiple South Korean banks</a> attributed to a Chinese-speaking threat actor.</p><p>Initially, the hacker used conventional tools but adopted AI utilities in late August 2026 to expand the attacks.</p><p>Authorities arrested all seven suspects, but only the group’s leader remains in custody. Arrested on October 15, he was formally detained two days later and referred to prosecutors on October 23. The other six suspects remain under investigation without being detained.</p><p>Police opened a case after a victim filed a complaint in June, and investigators traced the suspects through server logs from the breached entities.</p><p>Law enforcement authorities reportedly used an in-house AI tool to analyze the recovered evidence.</p><p>The police told local media that AI has lowered the barrier to entry for aspiring cybercriminals, resulting in large-scale, high-impact incidents that were previously only possible for skillful, knowledgeable actors.</p><p>“This is the first case of arrest of a suspect in Korea related to a large-scale hacking and personal information theft crime that exploited generative AI,\" the police told Yonhap.</p><p>“Even individuals who are not professional hacker organizations can now hack on a large scale with the help of AI.”</p><p>The police continue the investigation, now focusing on whether any of the stolen data has been leaked on the dark web.</p><p><a href=\"https://hubs.li/Q04sB3fb0\">\n            <img src=\"/dailyinfo/media/8fba1fc16e9d219a.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://hubs.li/Q04sB3fb0\">Once attackers have valid credentials, only 37% of their actions are blocked</a>\n        </h2><p>Overall prevention scores can hide what happens after initial access. Once attackers are using valid credentials, prevention drops sharply.</p><p>The Blue Report 2026 measures defenses technique by technique across 338 million simulations run in customer production environments.</p><p><a href=\"https://hubs.li/Q04sB3fb0\">Get the report</a>\n    </p>","zhKind","complete","数据泄露","勒索","大模型","https://www.bleepingcomputer.com/news/security/former-pentester-used-artex-ai-to-steal-82-million-data-records/","BleepingComputer",{"_103":104,"_105":-5},"changelogVersion","2026-10-01T08:00","release"]
