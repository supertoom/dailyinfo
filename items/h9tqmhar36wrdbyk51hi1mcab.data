[{"_1":2,"_3":4},"root",{"_5":131},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1794962439000,"id","h9tqmhar36wrdbyk51hi1mcab","title","OPTIMJACK 利用 Optimizely 漏洞向至少 178 家组织网站注入恶意 JavaScript","originalTitle","Borrowed Code, Real Consequences: What OPTIMJACK Teaches Us","summary","攻击者于 2026 年 11 月 16 日利用 Optimizely Web Experimentation 平台漏洞，在客户账户的 custom Project JavaScript 字段注入恶意代码，至少 178 家组织的网站经合法 CDN 和厂商证书向访客分发。","reason","source",{"_77":130},"links",{"_119":129},"publishedAt","2026-11-17T20:43:14.000Z","discoveredAt","2026-11-17T21:24:31.590Z","timelineAt","category","activity","tags",[78,80,125,126,127,128],"score",84,"selected",true,"channel","news","story",{"_90":91,"_13":92},"x","sameEvent",{"_11":123,"_13":124},"readingMode","full","author","Sherrod DeGrippo","body",{"_62":118,"_119":-5,"_120":121,"_122":36},"outline",[93,94,95,96,97,98,99],"relatedStories",[89],"topics",[69,70,71,72,73,74],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","f_DAGfE6W8cI","reportCount",9,"additionalSourceCount",7,{"_75":87,"_77":88},{"_75":85,"_77":86},{"_75":83,"_77":84},{"_75":81,"_77":82},{"_75":79,"_77":80},{"_75":76,"_77":78},"slug","attack","name","攻击活动","exploited","在野利用","black-market","数据窃取与黑产","ransomware","勒索软件","supply-chain","供应链安全","paloalto","Palo Alto Networks",{"_90":91,"_13":92},"publicId","9c6cfeee-afca-48bc-9a37-6ffde4a1dd7e","Optimizely漏洞遭利用，178家机构站点被注入恶意脚本",{"_11":116,"_101":117,"_103":107},{"_11":114,"_101":115,"_103":107},{"_11":112,"_101":113,"_103":107},{"_11":110,"_101":111,"_103":107},{"_11":108,"_101":109,"_103":107},{"_11":105,"_101":106,"_103":107},{"_11":100,"_101":102,"_103":104},"sec-7","text","联系我们","level",3,"sec-6","结论",2,"sec-5","受影响组织应了解的事项","sec-4","分段是当前最有力的可行措施","sec-3","受信任的供应商是阻力最小的路径","sec-2","OPTIMJACK 中发生了什么","sec-1","简介","<h2 id=\"sec-1\">简介</h2><p>2026年11月16日，某威胁行为者利用 Optimizely Web Experimentation 平台的一个漏洞，将恶意 JavaScript 注入客户账户。这场活动代号为 OPTIMJACK，将该代码投递给至少 178 家组织的网站访问者。</p><p>被篡改的代码直接从供应商合法的内容分发网络（CDN）交付，并使用供应商自己的安全证书。</p><p>企业在强化其核心 web 基础设施方面投入巨资。单个被攻陷的第三方工具就能破坏这些工作。OPTIMJACK 提醒我们，任何在你的网站上拥有动态执行权限的供应商脚本，都是你生产代码的直接组成部分。</p><p>威胁行为者知道，第三方应用是进入高收益环境的阻力最小路径。防御方可以依据一项安全工程从一开始就依赖的基本原则来应对：分段。</p><h2 id=\"sec-2\">OPTIMJACK 中发生了什么</h2><p>2026年11月16日，攻击者利用该漏洞，将恶意 JavaScript 植入客户账户的自定义 Project JavaScript 字段。</p><p>由于被篡改的代码片段是通过供应商自己的证书从其合法 CDN 提供的，至少 178 家组织——包括知名的媒体、技术和金融服务品牌——在不知情的情况下将该代码提供给了其访问者。</p><p>代码加载到访问者的浏览器后，会执行三项操作：</p><ul>\n<li><strong>加密货币钱包地址替换：</strong>它会将访问者复制的钱包地址替换为攻击者自己的地址</li>\n<li><strong>支付卡信息窃取：</strong>它会从结账表单中收集银行卡详细信息</li>\n<li><strong>移动端漏洞利用工具投放：</strong>它试图向 iPhone 和 iPad 投放 Coruna 和 DarkSword 漏洞利用工具包</li>\n</ul><p>Optimizely 于11月17日早些时候修补了该漏洞，移除了注入代码，并保护了受影响的账户。</p><h2 id=\"sec-3\">受信任的供应商是阻力最小的路径</h2><p>网站并不是单一的庞然大物。它们是由数十个第三方脚本、分析标签和优化工具动态组合而成的。</p><p>这种多样性带来了速度，但也通过软件供应链引入了新的攻击向量。当攻击者在上游攻陷单个受信任的供应商时，他们就能绕过该供应商客户构建的外围防御。</p><p>恶意载荷的选择同样重要。在页面上替换有效的加密货币钱包地址，是一种快速且持续的方法，可以将非法所得的付款导向威胁行为者。</p><h2 id=\"sec-4\">分段是当前最有力的可行措施</h2><p>如果第三方脚本在你的页面上执行，它实际上拥有与你自己的开发人员相同的权限。组织需要以此为前提来设计其网站架构。</p><p>安全团队目前能做的最佳事项，就是实施严格分段。目标很简单——被攻陷的供应商脚本绝不应能够接触敏感的用户输入。实现这一目标的方法包括：</p><ul>\n<li><strong>从敏感页面移除非必要标签：</strong>从身份验证和结账页面中移除所有非必要的营销、实验和分析标签</li>\n<li><strong>隔离支付信息收集：</strong>将支付信息收集置于经过强化、跨源 iframe 之内</li>\n</ul><p>自分段成为良好安全工程的基石以来，它一直发挥着核心作用。</p><h2 id=\"sec-5\">受影响组织应了解的事项</h2><p>即使该漏洞已修补，受影响的网站仍需采取行动。安全团队现在应执行以下步骤：</p><ul>\n<li>审计在恶意代码可用期间进行的所有项目修改</li>\n<li>复查在此期间可能已被更改的所有代码</li>\n<li>将暴露的支付数据视为可能已遭泄露，包括在受影响页面的结账表单中输入的支付卡信息</li>\n</ul><h2 id=\"sec-6\">结论</h2><p>OPTIMJACK 提醒我们，任何在你的网站上拥有动态执行权限的供应商脚本，都是你直接生产代码的一部分。单一供应商中的一个漏洞，使攻击者能够通过一个受信任、合法的交付渠道触达至少 178 家组织的访客。</p><p>第三方脚本能够提升速度，但当它们在你的页面上执行时，实际上拥有与你自己开发人员相同的权限。</p><p>受影响网站的管理员应先执行上述清理步骤。这些分段步骤将有助于防止已遭入侵的供应商脚本接触敏感的用户输入。尽可能隔离和分段，是软件供应链安全管理的关键。</p><p><a href=\"https://www.paloaltonetworks.ca/unit42/strengthen-your-defenses/compromise-assessment\">Unit 42 入侵评估</a>可以帮助你主动搜索历史和持续中的入侵指标，发现此前未检测到的恶意活动是否正在发生、如何发生以及为何发生，从而让你能在进一步损害发生之前作出响应。</p><h3 id=\"sec-7\">联系我们</h3><p>如果你正在经历正在发生的入侵，或认为自己可能已受到网络安全事件的影响，<a href=\"https://start.paloaltonetworks.com/contact-unit42.html\">请联系 Unit 42</a>，以便与团队成员取得联系。Unit 42 事件响应团队全天候 24/7/365 提供服务。如果你购买了网络安全保险或聘请了法律顾问，可以指名要求 Unit 42。你也可以通过申请<a href=\"https://www.paloaltonetworks.com/unit42/proactive-assessments\">主动评估</a>并签订<a href=\"https://origin-www.paloaltonetworks.com/resources/datasheets/unit42-retainer\">Unit 42 委托服务协议</a>来设置快速拨号，以采取预防措施。</p>","original","zhKind","translation","complete","cpozl5byqasqocx0exg64utib","攻击者劫持 Optimizely Web Experimentation 脚本，178 家组织网站遭注入","供应链投毒","数据窃取","供应链","Palo Alto","https://unit42.paloaltonetworks.com/optimjack-supply-chain-attack/","Unit 42",{"_132":133,"_134":-5},"changelogVersion","2026-10-01T08:00","release"]
