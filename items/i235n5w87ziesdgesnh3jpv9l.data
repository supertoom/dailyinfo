[{"_1":2,"_3":4},"root",{"_5":128},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795567281000,"id","i235n5w87ziesdgesnh3jpv9l","title","Amazon Cognito 令牌交换为 AI Agent 实现用户访问委托","originalTitle","Delegate user access to AI agents with Amazon Cognito token exchange","summary","Amazon Cognito 新增 OAuth 2.0 令牌交换功能，允许服务或 AI Agent 代表已登录用户调用下游 API，并通过 act 声明记录执行者身份。","reason","source",{"_74":127},"links",{"_61":126},"publishedAt","2026-11-24T20:01:08.000Z","discoveredAt","2026-11-24T20:04:36.658Z","timelineAt","category","ai-security","tags",[76,122,123,80,124,125],"score",64,"selected",false,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","Edward Sun","body",{"_118":-5,"_61":119,"_120":-5,"_121":36},"outline",[85,86,87,88,89,90,91,92,93,94],"relatedStories",[81],"topics",[68,69,70,71],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","f9E3B0quWcxY","reportCount",1,"additionalSourceCount",0,{"_72":79,"_74":80},{"_72":77,"_74":78},{"_72":30,"_74":76},{"_72":73,"_74":75},"slug","blue-team","name","蓝队与运营","AI 安全","ai-agent","AI Agent 安全","identity","身份与访问",{"_82":83,"_13":84},"publicId","ac7cd1aa-c6d7-49ff-96dc-acb2c722b521","Amazon Cognito发布委托令牌交换实践",{"_11":116,"_96":117,"_98":105},{"_11":114,"_96":115,"_98":105},{"_11":112,"_96":113,"_98":105},{"_11":110,"_96":111,"_98":105},{"_11":108,"_96":109,"_98":99},{"_11":106,"_96":107,"_98":99},{"_11":103,"_96":104,"_98":105},{"_11":102,"_96":45,"_98":99},{"_11":100,"_96":101,"_98":99},{"_11":95,"_96":97,"_98":99},"sec-10","text","Varun Sharma","level",3,"sec-9","Owen Hawkins","sec-8","sec-7","Conclusion",2,"sec-6","Example 2: The agent as the actor on AgentCore Runtime","sec-5","Example 1: A shared intermediary as the actor","sec-4","Example token exchange use cases for agentic workload delegation","sec-3","Enable token exchange in your Amazon Cognito user pool","sec-2","Security controls during an exchange","sec-1","How token exchange works in Amazon Cognito","zh","<p>Suppose you use a restaurant review app to check reviews, book tables, and email invitations to your friends. With <span><a href=\"https://www.rfc-editor.org/info/rfc6749/\">OAuth 2.0</a></span>, the app sends you to the <span><a href=\"https://www.rfc-editor.org/info/rfc6749/#section-1.1\">authorization server</a></span> that your email provider trusts, where you sign in and approve only the access the app requested, such as the <code>contacts.read</code> and <code>messages.send</code> scopes. The review app won’t sees your credentials. It only receives a short-lived access token limited to the scopes you approved, which it presents to your email provider’s API to read your contacts and send invitation emails on your behalf.</p><p>That works while the app calls the email API directly, but many requests take a second hop to call downstream services. When you book a table, the app calls its reservation service with your token to email details to your friends, which token should the reservation service use to call the email API? Forwarding the access token issued to the review app hides the reservation service because the email API thinks the app sent the request. Using the reservation service’s own token from an <span><a href=\"https://www.rfc-editor.org/info/rfc6749/#section-4.4\">OAuth 2.0 client credentials grant</a></span> loses user identity, because the email API knows which service called, but not for which user. Figure 1 shows this second hop.</p><p>\n <img src=\"/dailyinfo/media/1ab4d4a3c903c024.webp\" srcset=\"/dailyinfo/media/ac33ee476b94f883.webp 720w, /dailyinfo/media/898f0767ec58905d.webp 1200w, /dailyinfo/media/1ab4d4a3c903c024.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Figure 1: The reservation service calling the email API for a signed-in user\" width=\"2400\" height=\"904\">\n </p><p>Figure 1: The reservation service calling the email API for a signed-in user</p><p>OAuth 2.0 Token Exchange, defined in <span><a href=\"https://www.rfc-editor.org/rfc/rfc8693.html\">RFC 8693</a></span>, handles this second hop. Instead of forwarding your access token, the reservation service goes back to the authorization server with two things: your access token, which shows what you consented for, and its own credentials, which show who it is. The authorization server returns a new token for the email API, called <i>issued token</i>, which identifies the user, can also name the reservation service, and carries the same scopes or fewer.</p><p>AI agents make this second hop more common and more important, for example when the review app adds an AI agent that reserves tables and invites friends for you. The agent picks its tools at run time, such as a <span><a href=\"https://modelcontextprotocol.io/specification/2026-07-28/basic/authorization\">Model Context Protocol (MCP) server</a></span> that sends invitations, and those tools call APIs for you. With token exchange, each hop gets only the scopes it needs, and the email API can see which service acted for you.</p><p>In this post, we show you how to use the new <span><a href=\"https://aws.amazon.com/about-aws/whats-new/2026/11/cognito-token-exchange/\">OAuth token exchange feature</a></span> in <span><a href=\"https://aws.amazon.com/cognito/\">Amazon Cognito</a></span> when services and AI agents call your APIs on behalf of users, and Cognito serves as the OAuth 2.0 authorization server. We explain the difference between impersonation and delegation, and show you examples of how the feature works with an MCP server and <span><a href=\"https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/identity.html\">Amazon Bedrock AgentCore Identity</a></span>.</p><h2 id=\"sec-1\"><b>How token exchange works in Amazon Cognito</b></h2><p>Every token exchange starts with a <i>subject token</i> that represents the user. In Amazon Cognito, the subject token can be an access token or ID token that your user pool issued to the app where the user signed in. The calling service sends the subject token to Cognito, and Cognito returns a new token for that service to use at the downstream resource server.</p><p>Token exchange distinguishes two patterns, impersonation and delegation. The calling service chooses which pattern to use based on whether the downstream API needs to authorize the service that’s acting on behalf of the user:</p><ul> \n <li><b>Impersonation</b> – The calling service doesn’t identify itself as the actor. The issued token represents the user. Its <code>client_id</code> claim identifies the app client that performed the exchange, but it doesn’t have an <code>act</code> (actor) claim to show a service is acting for the user.</li> \n <li><b>Delegation – </b>The calling service identifies itself as the actor by also sending an <i>actor token</i>. Amazon Cognito adds an act claim that names the calling service, so the resource server can see and log who authorized the action and who carried it out.</li> \n</ul><p>Impersonation fits when the calling service only relays the user’s request and makes no decisions of its own, such as a <span><a href=\"https://aws.amazon.com/blogs/mobile/backends-for-frontends-pattern/\">backend for frontend (BFF)</a></span> that forwards requests from a web app to your APIs. It also fits where a downstream API authorizes the user alone and doesn’t need to know which service relayed the call.</p><p>For AI agents, delegation is the important pattern. If the agent used a token of its own, the record would show that an agent called the resource server, but not for whom. With impersonation, the record shows the user but not the agent acting for them. You need delegation to see both for proper authorization and audit trails.</p><p>\n <img src=\"/dailyinfo/media/d7d58139f5ae9880.webp\" srcset=\"/dailyinfo/media/9a677331c854046d.webp 720w, /dailyinfo/media/e604a2f227771f4c.webp 1200w, /dailyinfo/media/d7d58139f5ae9880.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Figure 2: Delegated access across two service hops\" width=\"2400\" height=\"1456\">\n </p><p>Figure 2: Delegated access across two service hops</p><p>Figure 2 shows the flow for delegated access between services:</p><ol> \n <li>The user signs in to your app through Amazon Cognito.</li> \n <li>Cognito issues the user’s access token to the client application.</li> \n <li>The client calls the downstream service, such as an MCP server, with the user’s access token.</li> \n <li>The service calls the Cognito <code>/oauth2/token</code> endpoint and authenticates with its own app client. It sends the user’s access token as the subject token and names the resource server as the audience. For delegation, it also sends its own token as the actor token.</li> \n <li>Cognito validates the request and returns an issued token. The issued token still identifies the user in <code>sub</code>. For delegation, it also identifies the service in the <code>act</code> claim.</li> \n <li>The service calls the resource server, such as an email API, with the issued token.</li> \n <li>The resource server checks that the token’s <code>aud</code> claim names itself, then authorizes the request for the user and returns the user’s data to the service.</li> \n <li>The calling service returns the result to the client.</li> \n</ol><p>In addition to requesting a token exchange at the <code>/oauth2/token</code> endpoint on your user pool’s domain, you can call the <span><a href=\"https://docs.aws.amazon.com/cognito-user-identity-pools/latest/APIReference/API_GetDerivedToken.html\">GetDerivedToken</a></span> API with an <span><a href=\"https://docs.aws.amazon.com/sdkref/latest/guide/overview.html\">AWS SDK</a></span>, which doesn’t require a user pool domain. Both accept the same subject token, actor token, audience and scopes, and return an issued token with the same claims.</p><p>Here’s an example issued token from a delegation token exchange. The token keeps user’s identity in sub and names the calling service in the <code>act</code> claim.</p><pre class=\"language-text\"><code class=\"language-text\">{\n  \"iss\": \"https://cognito-idp.us-east-1.amazonaws.com/us-east-1_EXAMPLE\",\n  \"sub\": \"c4b82478-5678-90ab-cdef-EXAMPLE11111\",\n  \"username\": \"you@example.com\",\n  \"client_id\": \"invitations-mcp-client-id\",\n  \"version\": 2,\n  \"token_use\": \"access\",\n  \"scope\": \"email-api/messages.send\",\n  \"aud\": \"email-api\",\n  \"act\": {\n    \"sub\": \"invitations-mcp-client-id\",\n    \"client_id\": \"invitations-mcp-client-id\",\n    \"iss\": \"https://cognito-idp.us-east-1.amazonaws.com/us-east-1_EXAMPLE\",\n    \"token_type\": \"urn:ietf:params:oauth:token-type:access_token\"\n  },\n  \"exp\": 1735689600,\n  \"iat\": 1735686000\n}</code></pre><p>The email API authorizes the user identified by <code>sub</code>, and <code>act</code> tells it which service is acting for that user. It can then decide whether it trusts that service, and its logs can show both the user and the service for each request. Accept a delegated token only when <code>act.client_id</code> reflects a service you trust, such as the invitations MCP server, and matches the token’s <code>client_id</code> meaning the trusted service requested the token itself.</p><h2 id=\"sec-2\"><b>Security controls during an exchange</b></h2><p>Amazon Cognito checks every exchange before it issues a token. It validates the subject token’s signature and expiry, and refuses a token that has been revoked or that belongs to a disabled user in your user pool. If the request includes an audience, the issued token is bound to that resource server, and every requested scope must belong to it. The issued token carries only scopes that both the subject token and the app client allow, so an exchange can narrow your access but doesn’t add to it. It also doesn’t outlive the subject token, and the exchange doesn’t return a refresh token.</p><p>For the full list of checks, see Security model in <span><a href=\"https://docs.aws.amazon.com/cognito/latest/developerguide/cognito-user-pools-token-exchange.html\">Exchanging tokens for downstream services</a></span> in the <span><a href=\"https://docs.aws.amazon.com/cognito/latest/developerguide/what-is-amazon-cognito.html\">Amazon Cognito Developer Guide</a></span>. Checks by Cognito don’t replace the resource server’s own: it should still <span><a href=\"https://docs.aws.amazon.com/cognito/latest/developerguide/amazon-cognito-user-pools-using-tokens-verifying-a-jwt.html\">verify the JWT tokens</a></span>, including signature, issuer, expiry, audience and scopes, and for delegated requests, it should validate the <code>act</code> claim.</p><p>Your user pool might have a <span><a href=\"https://docs.aws.amazon.com/cognito/latest/developerguide/user-pool-lambda-pre-token-generation.html\">pre token generation AWS Lambda trigger</a></span>, which can add or suppress custom claims and scopes in your user pool’s tokens. Amazon Cognito also invokes this trigger during token exchange, with the trigger source <code>TokenGeneration_TokenExchange</code>. However, Cognito doesn’t add any scopes that the trigger returns for an exchange, so the calling service can’t gain more permissions than the user’s token already has. You can still use the trigger to remove scopes from the issued token. For more information, see <span><a href=\"https://docs.aws.amazon.com/cognito/latest/developerguide/cognito-user-pools-token-exchange.html#cognito-user-pools-token-exchange-lambda\">Customize the exchanged token with a Lambda trigger</a></span>.</p><h2 id=\"sec-3\"><b>Enable token exchange in your Amazon Cognito user pool</b></h2><p>Token exchange is an OAuth 2.0 grant, and you can enable it for each application client as an authentication flow in your Amazon Cognito user pool. Check the <span><a href=\"https://docs.aws.amazon.com/cognito/latest/developerguide/cognito-user-pools-token-exchange.html#cognito-user-pools-token-exchange-prerequisites\">prerequisites</a></span> in the Amazon Cognito Developer Guide.</p><p><b>To enable token exchange for an app client:</b></p><ol> \n <li>Open the <span><a href=\"https://console.aws.amazon.com/cognito/v2/home\">AWS Management Console for Amazon Cognito</a></span>, and choose your Cognito user pool.</li> \n <li>In the navigation pane, under <b>Applications</b> section, choose <b>App clients</b>, and then choose your app client.</li> \n <li>In <b>App client information</b>, choose <b>Edit</b>.<br> \n  <p>\n   <img src=\"/dailyinfo/media/46faa60c2aab3ecc.webp\" srcset=\"/dailyinfo/media/702afde1891b71dc.webp 720w, /dailyinfo/media/4f88e19dea48009c.webp 1200w, /dailyinfo/media/46faa60c2aab3ecc.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Figure 3: Cognito token exchange app client\" width=\"2470\" height=\"836\">\n   </p><p>Figure 3: Cognito token exchange app client</p>\n   </li> \n <li>On the <b>Edit app client information</b> page, under <b>Authentication flows</b>, go to <b>Exchange OAuth 2 token</b> for delegation and impersonation and select the following: \n  <ol> \n   <li>For delegation, select<b> ALLOW_TOKEN_EXCHANGE_DELEGATION</b>.</li> \n   <li>For impersonation, select <b>ALLOW_TOKEN_EXCHANGE_IMPERSONATION</b>.</li> \n  </ol> \n  <p>\n   <img src=\"/dailyinfo/media/80eab374f91dc047.webp\" srcset=\"/dailyinfo/media/1b05e43d886d33d8.webp 720w, /dailyinfo/media/1e9c105fe79b6b91.webp 1200w, /dailyinfo/media/80eab374f91dc047.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Figure 4: Amazon Cognito token exchange authentication flows\" width=\"2372\" height=\"742\">\n   </p><p>Figure 4: Amazon Cognito token exchange authentication flows</p>\n   </li> \n <li>Choose <b>Save changes</b>.</li> \n</ol><h2 id=\"sec-4\"><b>Example token exchange use cases for agentic workload delegation</b></h2><p>Now that you’ve enabled token exchange, we show you two examples of how it works in an agentic workload. Both continue the review app story: its AI agent sends invitations for you by calling the email API, and the email API needs to know who you are and which component acted for you.</p><p>The two examples differ in where the exchange happens. Amazon Cognito fills the <code>act</code> claim from the actor token, so <code>act</code> names whichever component sends its own actor token in the exchange. In Example 1, a shared intermediary—such as an MCP server or an AI gateway—performs the exchange for every agent that calls it, so <code>act</code> names the intermediary. In Example 2, the agent requests the exchange itself, so act names the agent.</p><h3 id=\"sec-5\"><b>Example 1: A shared intermediary as the actor</b></h3><p>In this example, the intermediary sits in front of the email API. We show it two ways: an MCP server you build that performs the exchange in its own code, and an AI gateway in <span><a href=\"https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/gateway.html\">Amazon Bedrock AgentCore Gateway</a></span> that performs it through configuration.</p><p><b>Using your own MCP server:</b></p><p>The MCP authorization specification doesn’t allow an MCP server to pass along the token it received from the MCP client. To call the email API for you, the invitations MCP server needs a token of its own. It uses its own app client in your user pool to perform a delegation token exchange.</p><p>Figure 5 shows how the invitations MCP server sends invites for you.</p><p>\n <img src=\"/dailyinfo/media/6f3b3657714b3634.webp\" srcset=\"/dailyinfo/media/ab12e477c146b787.webp 720w, /dailyinfo/media/09f2246b5aea4228.webp 1200w, /dailyinfo/media/6f3b3657714b3634.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Figure 5: The invitations MCP server sending invites for a signed-in user\" width=\"2400\" height=\"1234\">\n </p><p>Figure 5: The invitations MCP server sending invites for a signed-in user</p><ol> \n <li>The user signs in to the review app through Amazon Cognito.</li> \n <li>The review app’s AI agent calls the <code>send_invites</code> tool on the invitations MCP server with the user’s access token. \n  <pre class=\"language-text\"><code class=\"language-text\">{\n  \"sub\": \"c4b82478-...\",\n  \"username\": \"you@example.com\",\n  \"client_id\": \"&lt;review app client ID&gt;\",\n  \"scope\": \"openid invitations-mcp/tools email-api/contacts.read email-api/messages.send\",\n  \"token_use\": \"access\",\n  \"iss\": \"https://cognito-idp.us-east-1.amazonaws.com/&lt;user-pool-id&gt;\"\n}</code></pre> \n      \n     \n    \n   </li> \n <li>The MCP server authorizes the inbound request by checking the token’s <code>client_id</code> and the <code>invitations-mcp/tools</code> scope, then gets its own actor token with its client ID and secret in an OAuth 2.0 client credentials grant flow.</li> \n <li>The MCP server sends the user’s token as subject token and its actor token to the Cognito <code>/oauth2/token</code> endpoint in a delegation token exchange. It requests only <code>email-api/messages.send</code>, because sending invites doesn’t require reading your contacts. \n  <pre class=\"language-text\"><code class=\"language-text\">curl -X POST \"https://&lt;domain&gt;.auth.us-east-1.amazoncognito.com/oauth2/token\" \\\n  -u \"$MCP_SERVER_CLIENT_ID:$MCP_SERVER_CLIENT_SECRET\" \\\n  -d grant_type=urn:ietf:params:oauth:grant-type:token-exchange \\\n  --data-urlencode \"subject_token=$YOUR_TOKEN\" \\\n  -d subject_token_type=urn:ietf:params:oauth:token-type:access_token \\\n  --data-urlencode \"actor_token=$ACTOR_TOKEN\" \\\n  -d actor_token_type=urn:ietf:params:oauth:token-type:access_token \\\n  -d audience=email-api \\\n  -d scope=email-api/messages.send</code></pre> \n      \n     \n    \n   </li> \n <li>Cognito validates both tokens and returns the issued token, while keeping the user in <code>sub</code> claim and adding the MCP server’s app client to <code>act</code> claim. \n  <pre class=\"language-text\"><code class=\"language-text\">{\n  \"sub\": \"c4b82478-...\",\n  \"username\": \"you@example.com\",\n  \"client_id\": \"&lt;MCP server app client ID&gt;\",\n  \"aud\": \"email-api\",\n  \"scope\": \"email-api/messages.send\",\n  \"act\": {\n    \"sub\": \"&lt;MCP server app client ID&gt;\",\n    \"client_id\": \"&lt;MCP server app client ID&gt;\",\n    \"iss\": \"https://cognito-idp.us-east-1.amazonaws.com/&lt;user-pool-id&gt;\",\n    \"token_type\": \"urn:ietf:params:oauth:token-type:access_token\"\n  },\n  \"token_use\": \"access\"\n}</code></pre> \n      \n     \n    \n   </li> \n <li>The MCP server calls the email API with the issued token. The email API checks <code>aud=email-api</code> and the <code>messages.send</code> scope, and it confirms that <code>act.client_id</code> matches <code>client_id</code> and names an MCP server it trusts. It then sends the invites from your account and records that the invitations MCP server sent them for you.</li> \n</ol><p><b>To set up the MCP server:</b></p><ol> \n <li>In Amazon Cognito user pool, register the email API (<code>email-api</code>) and the MCP server (<code>invitations-mcp</code>) as resource servers in your user pool, with the scopes used.</li> \n <li>Create an app client with a client secret for the MCP server in your user pool. Select <code>ALLOW_TOKEN_EXCHANGE_DELEGATION</code> in authentication flows, allow the client credentials grant so the MCP server can get its actor token, and allow the <code>email-api/messages.send</code> scope that it requests in the exchange.</li> \n <li>Have the review app request <code>email-api/messages.send</code> when you sign in, along with <code>invitations-mcp/tools</code>. The exchange can remove scopes from your token, but it can’t add any.</li> \n</ol><p>Other AI agents can also sign you in through Amazon Cognito and call the invitations MCP server. They can register with your user pool through <span><a href=\"https://docs.aws.amazon.com/cognito/latest/developerguide/cognito-user-pools-dynamic-client-registration.html\">dynamic client registration (DCR)</a></span>, or identify themselves with a <span><a href=\"https://docs.aws.amazon.com/cognito/latest/developerguide/cognito-user-pools-client-id-metadata.html\">client ID metadata document (CIMD)</a></span>. Token exchange works the same way for these clients. They send your access token to the MCP server, and the MCP server performs the exchange with its own app client, so the issued token names you in <code>sub</code> and the MCP server in <code>act</code>.</p><p><b>Using AgentCore Gateway:</b></p><p>If you don’t want to write the exchange in your MCP server, AgentCore Gateway can perform it for you. <span><a href=\"https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/identity.html\">Amazon Bedrock AgentCore Identity</a></span> can perform the same token exchange on behalf of AgentCore Gateway, so the gateway doesn’t store the OAuth client secret or build the request.</p><p>Here, AgentCore Gateway replaces the invitations MCP server. It exposes the email API as an MCP tool through an OpenAPI target, and the review app’s AI agent calls that tool with your access token.</p><p>Figure 6 shows how AgentCore Gateway sends invites for you.</p><p>\n <img src=\"/dailyinfo/media/c01011a152298b6a.webp\" srcset=\"/dailyinfo/media/92b58124a09196de.webp 720w, /dailyinfo/media/bc79edf3b5086d80.webp 1200w, /dailyinfo/media/c01011a152298b6a.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Figure 6: AgentCore Gateway sending invites through AgentCore Identity\" width=\"2400\" height=\"1468\">\n </p><p>Figure 6: AgentCore Gateway sending invites through AgentCore Identity</p><ol> \n <li>The agent calls the AgentCore Gateway invite tool with user’s access token. The AgentCore Gateway <span><a href=\"https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/gateway-inbound-auth.html#gateway-inbound-auth-jwt\">inbound JWT authorizer</a></span> validates the token against your user pool and accepts only tokens issued to the review app.</li> \n <li>AgentCore Gateway passes user’s access token to AgentCore Identity and asks for a token for the email API target.</li> \n <li>AgentCore Identity uses the AgentCore Gateway app client in a client credentials grant to get an actor token.</li> \n <li>AgentCore Identity sends your token and the actor token in a delegation token exchange, adding the <code>subject_token_type</code> and <code>audience</code> values from the target’s custom parameters.</li> \n <li>Amazon Cognito validates the request and returns the issued token, with the user in <code>sub</code>, and the AgentCore Gateway app client in <code>act</code>.</li> \n <li>AgentCore Identity passes the issued token to AgentCore Gateway.</li> \n <li>AgentCore Gateway calls the email API with the issued token, and the email API applies the same checks as for the preceding MCP server setup.</li> \n</ol><p><b>To set up AgentCore Gateway:</b></p><ol> \n <li>In your Amazon Cognito user pool, create an app client for AgentCore Gateway in the same way as for the MCP server.</li> \n <li>In AgentCore Identity, create an AgentCore Identity credential provider for the AgentCore Gateway app client. A credential provider stores what AgentCore Identity needs to request tokens from Amazon Cognito: your user pool’s <i>discovery URL</i> and the app client’s ID and secret. Use the <code>CustomOauth2</code> provider type, and enable delegation in its <code>customOauth2ProviderConfig</code> settings: \n  <pre class=\"language-text\"><code class=\"language-text\">{\n  \"oauthDiscovery\": { \"discoveryUrl\": \"https://cognito-idp.us-east-1.amazonaws.com/&lt;user-pool-id&gt;/.well-known/openid-configuration\" },\n  \"clientId\": \"&lt;Gateway app client ID&gt;\",\n  \"clientSecret\": \"&lt;client secret&gt;\",\n  \"clientAuthenticationMethod\": \"CLIENT_SECRET_BASIC\",\n  \"onBehalfOfTokenExchangeConfig\": {\n    \"grantType\": \"TOKEN_EXCHANGE\",\n    \"tokenExchangeGrantTypeConfig\": { \"actorTokenContent\": \"M2M\" }\n  }\n}</code></pre> \n      \n     \n    \n   </li> \n <li>In AgentCore Gateway, configure the AgentCore Gateway inbound JWT authorizer with your user pool’s discovery URL, and set <code>allowedClients</code> to the review app’s client ID.</li> \n <li>In the AgentCore Gateway target’s outbound authorization, reference the credential provider and add <code>subject_token_type</code> and <code>audience</code> as custom parameters. Because your token is an access token, set <code>subject_token_type</code> to <code>urn:ietf:params:oauth:token-type:access_token</code>. \n  <pre class=\"language-text\"><code class=\"language-text\">{\n  \"providerArn\": \"arn:aws:bedrock-agentcore:us-east-1:&lt;account-id&gt;:token-vault/default/oauth2credentialprovider/cognito\",\n  \"scopes\": [\"email-api/messages.send\"],\n  \"grantType\": \"TOKEN_EXCHANGE\",\n  \"customParameters\": {\n    \"subject_token_type\": \"urn:ietf:params:oauth:token-type:access_token\",\n    \"audience\": \"email-api\"\n  }\n}</code></pre> \n      \n     \n    \n   </li> \n</ol><p>AgentCore Gateway handles the exchange through configuration, so you don’t need to write agent or interceptor code for it. For more information, see <span><a href=\"https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/gateway-outbound-auth.html\">Set up outbound authorization for your gateway</a></span>.</p><p>With either your own MCP server or an AI gateway, <code>act</code> names the intermediary rather than the agent that called it. Every agent behind it appears as the same app client. This design still protects the email API. It accepts only tokens with <code>aud=email-api</code>, and your original access token has no such audience, so an agent can’t bypass the intermediary by forwarding your token. Each call that reaches the email API carries a token with only the scope it needs. The agents don’t hold downstream credentials or exchange logic, and the email API trusts one intermediary instead of every agent. If the email API needs to tell agents apart, perform the exchange in the agent, as Example 2 shows.</p><h3 id=\"sec-6\"><b>Example 2: The agent as the actor on AgentCore Runtime</b></h3><p>If the review app’s AI agent runs on <span><a href=\"https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/agents-tools-runtime.html\">Amazon Bedrock AgentCore Runtime</a></span>, the agent can request the exchange itself through AgentCore Identity and call the email API directly. The issued token then names the agent in act, so the email API knows which agent sent the invites.</p><p>Figure 7 shows how the agent sends invites for you.</p><p>\n <img src=\"/dailyinfo/media/908de1ab02abff59.webp\" srcset=\"/dailyinfo/media/3df8dab5b866ef13.webp 720w, /dailyinfo/media/8e69f60c3ea3cc11.webp 1200w, /dailyinfo/media/908de1ab02abff59.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Figure 7: The AI agent on AgentCore Runtime sending invites through AgentCore Identity\" width=\"2400\" height=\"1128\">\n </p><p>Figure 7: The AI agent on AgentCore Runtime sending invites through AgentCore Identity</p><ol> \n <li>The review app invokes the agent on AgentCore Runtime with the user’s access token.</li> \n <li>Runtime validates your token with its <span><a href=\"https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/runtime-oauth.html#oauth-sample-overview\">inbound JWT authorizer</a></span>, exchanges it for a <span><a href=\"https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/get-workload-access-token.html#workload-access-token-overview\">workload access token</a></span> from AgentCore Identity, and passes that token to the agent. A workload access token is an opaque token that proves which agent is calling. It carries the user’s access token, which AgentCore Identity uses as the subject token in step 4.</li> \n <li>The agent asks AgentCore Identity for a token for the email API by calling <span><a href=\"https://docs.aws.amazon.com/bedrock-agentcore/latest/APIReference/API_GetResourceOauth2Token.html\">GetResourceOauth2Token</a></span> with the workload access token.</li> \n <li>AgentCore Identity gets an actor token with the agent’s app client, then sends user’s token and the actor token to Cognito in a delegation token exchange.</li> \n <li>Amazon Cognito returns the issued token, with user in <code>sub</code> and the agent’s app client in <code>act</code>, and AgentCore Identity passes it to the agent.</li> \n <li>The agent calls the email API with the issued token. The email API applies the same checks as in Example 1, and confirms that <code>act.client_id</code> names an agent it trusts.</li> \n</ol><p>The issued token has the same shape as in Example 1, but <code>client_id</code> and <code>act</code> name the agent’s app client.</p><p><b>To set up the agent:</b></p><ol> \n <li>In your Amazon Cognito user pool, create an app client for the agent in your user pool and select <code>ALLOW_TOKEN_EXCHANGE_DELEGATION</code> for it. To tell agents apart in <code>act</code> claim, give each agent its own app client and credential provider.</li> \n <li>In AgentCore Identity, create a credential provider for the agent’s app client in the same way as for AgentCore Gateway.</li> \n <li>In AgentCore Runtime, configure the inbound JWT authorizer on AgentCore Runtime to accept your user pool’s tokens, with <code>allowedClients</code> set to the review app’s client ID.</li> \n <li>In the agent’s code, request the issued token with the AgentCore SDK: \n  <pre class=\"language-text\"><code class=\"language-text\">from bedrock_agentcore.identity.auth import requires_access_token\n\n@requires_access_token(\n    provider_name=\"&lt;Agent name&gt;\",\n    scopes=[\"email-api/messages.send\"],\n    audiences=[\"email-api\"],\n    auth_flow=\"ON_BEHALF_OF_TOKEN_EXCHANGE\",\n    custom_parameters={\n        \"subject_token_type\": \"urn:ietf:params:oauth:token-type:access_token\"\n    },\n)\nasync def send_invites(friends: list[str], *, access_token: str):\n    # Call the email API with access_token\n    ...</code></pre> \n      \n     \n    \n   </li> \n</ol><p>The decorator makes the <code>GetResourceOauth2Token</code> call in step 3 of Figure 7 and passes the issued token to your function as <code>access_token</code>.</p><p>For more information, see <span><a href=\"https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/on-behalf-of-token-exchange.html\">On-behalf-of token exchange with AgentCore Identity</a></span>.</p><h2 id=\"sec-7\"><b>Conclusion</b></h2><p>Think back to the agent at the start of this post. The agent had to book a table and send invitations for you, and forwarding the <span><span>user’s original access token</span></span> would have hidden which service acted for you and given it more access than the job needed. With Amazon Cognito token exchange, each hop gets its own scoped-down token, bound to the resource server it calls and limited to the scopes it needs. Each issued token also expires no later than your own token and doesn’t come with a refresh token, so no service can keep access after your token expires.</p><p>For AI agents, delegation adds a second identity to the token. The <code>act</code> claim names the service doing the work, so a downstream API can choose which agents it trusts. Your audit records can then show both the person who authorized a request and the agent that made it.</p><p>You can try this on a new or existing Amazon Cognito user pool on the Essentials or Plus plan. Enable <code>ALLOW_TOKEN_EXCHANGE_DELEGATION</code> for an app client, register the downstream API as a resource server, and call <code>GetDerivedToken</code> or the token endpoint.</p><p>If you have questions about this post, contact <a href=\"https://aws.amazon.com/contact-us/\">AWS Support</a> or start a new thread on <a href=\"https://repost.aws/\">AWS re:Post</a>.</p><hr><p> \n   <img src=\"/dailyinfo/media/57a42969d56beaed.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"Edward Sun\" width=\"107\" height=\"160\"> \n  </p><h3 id=\"sec-8\">Edward Sun</h3><p>Edward is a Senior Security Specialist Solutions Architect focused on identity and access management. He loves helping customers throughout their cloud transformation journey with architecture design, security best practices, migration, and cost optimizations. Outside of work, Edward enjoys hiking, golfing, and cheering for his alma mater, the Georgia Bulldogs.</p><p> \n   <img src=\"/dailyinfo/media/981cfa395af2f4f0.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"\" width=\"120\" height=\"160\"> \n  </p><h3 id=\"sec-9\">Owen Hawkins</h3><p>Owen is a Principal Solutions Architect at Amazon Web Services, working with independent software vendors in the UK. Building on more than 20 years in information security and digital banking, he now spends his time on agent identity and on helping engineering organizations improve their software development lifecycle with AI-driven approaches.</p><p> \n   <img src=\"/dailyinfo/media/e2c886f8b5fee080.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\" width=\"120\" height=\"160\"> \n  </p><h3 id=\"sec-10\">Varun Sharma</h3><p>Varun is a Senior AWS Cloud Security Engineer who wears his security cape proudly. With a knack for unravelling the mysteries of Amazon Cognito and IAM, Varun is a go-to subject matter expert for these services. When he’s not busy securing the cloud, you’ll find him in the world of security penetration testing. And when the pixels are at rest, Varun switches gears to capture the beauty of nature through the lens of his camera. </p>","zhKind","complete","Agent 安全","加固","大模型","AWS","https://aws.amazon.com/blogs/security/delegate-user-access-to-ai-agents-with-amazon-cognito-token-exchange/","AWS Security Blog",{"_129":130,"_131":-5},"changelogVersion","2026-10-01T08:00","release"]
