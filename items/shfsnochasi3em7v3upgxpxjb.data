[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794185106000,"id","shfsnochasi3em7v3upgxpxjb","title","Incus 恶意镜像可借 rootfs 符号链接在主机任意读写文件","originalTitle","LXD has arbitrary file read+write on host via rootfs/ symlink in malicious image","summary","Incus 存在可经恶意镜像触发的任意文件读写漏洞。镜像包含顶层 `rootfs` 符号链接时，解压流程可能绕过早期校验，并在停止容器文件 API 中以 root 权限访问主机文件系统；公告提供 PoC，可读取主机 `/etc/shadow` 并在主机根目录写入文件，可能进一步导致任意命令执行。","reason","source",{"_69":82},"links",{"_59":81},"publishedAt","2026-11-06T19:36:07.000Z","discoveredAt","2026-11-07T01:27:29.651Z","timelineAt","category","vuln","tags",[77,78,79,80],"score",65,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fqv5nHqhTFtw","reportCount",1,"additionalSourceCount",0,{"_68":71,"_69":72},{"_68":30,"_69":70},"slug","name","漏洞披露","cloud-native","云与原生",{"_74":75,"_13":76},"publicId","12aea8a9-b58a-45f6-bb8d-c90cb5313bc9","Incus恶意镜像可导致主机任意文件读写","漏洞","复现","漏洞利用","容器","https://github.com/advisories/GHSA-vghh-5rfx-xhq8","GitHub 安全公告",{"_84":85,"_86":-5},"changelogVersion","2026-10-01T08:00","release"]
