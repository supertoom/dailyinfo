[{"_1":2,"_3":4},"root",{"_5":91},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795826459000,"id","zptj6mohcgm2b6eayxup65amy","title","Drupal 安装程序远程代码执行漏洞 CVE-2026-132165 已被在野利用","originalTitle","Drupal安装程序远程代码执行漏洞(CVE-2026-132165)在野利用通告","summary","奇安信 CERT 监测到 Drupal 安装程序远程代码执行漏洞 CVE-2026-132165 已被在野利用，该漏洞源于 Drupal core 安装器状态校验不当，攻击者可匿名续跑 /core/install.php 流程，覆盖 uid 1 管理员账户的用户名、邮箱和密码，接管站点并借已有模块、主题或文件写入入口执行任意命令。","reason","原文给出受影响版本区间、匿名利用前提、官方补丁版本与在野资产数量，读者可据此判断自身 Drupal 站点是否需要立刻处置。","source",{"_73":90},"links",{"_83":89},"publishedAt","2026-11-24T16:00:00.000Z","discoveredAt","2026-11-26T11:42:31.879Z","timelineAt","category","vuln","tags",[86,74,87,88,77],"score",84,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","body",{"_61":82,"_83":-5,"_84":83,"_85":37},"outline",[],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fR_AtN074jqw","reportCount",3,"additionalSourceCount",2,{"_71":76,"_73":77},{"_71":31,"_73":75},{"_71":72,"_73":74},"slug","exploited","name","在野利用","漏洞披露","qianxin","奇安信",{"_79":80,"_13":81},"publicId","68465ab3-c70a-4fb8-879b-c2dcde061a85","Drupal安装器RCE漏洞CVE-2026-132165已被在野利用","<table><tbody><tr><td colspan=\"4\"><p><strong>漏洞概述</strong></p></td></tr><tr><td><p><strong>漏洞名称</strong></p></td><td colspan=\"3\"><p>Drupal 安装程序远程代码执行漏洞</p></td></tr><tr><td><p><strong>漏洞编号</strong></p></td><td colspan=\"3\"><p>QVD-2026-112382，CVE-2026-132165</p></td></tr><tr><td><p><strong><strong>公开时间</strong></strong></p></td><td><p>2026-11-17</p></td><td><p><strong><strong>使用量级</strong></strong></p></td><td><p>十万级</p></td></tr><tr><td><p><strong>奇安信评级</strong></p></td><td><p><strong>高危</strong></p></td><td><p><strong>CVSS 3.1分数</strong></p></td><td><p><strong>8.1</strong></p></td></tr><tr><td><p><strong>威胁类型</strong></p></td><td><p>代码执行</p></td><td><p><strong>利用可能性</strong></p></td><td><p><strong><strong>高</strong></strong></p></td></tr><tr><td><p><strong>POC状态</strong></p></td><td><p><strong>已公开</strong></p></td><td><p><strong>在野利用状态</strong></p></td><td><p>已发现</p></td></tr><tr><td><p><strong>EXP状态</strong></p></td><td><p><strong>已公开</strong></p></td><td><p><strong>技术细节状态</strong></p></td><td><p><strong>已公开</strong></p></td></tr><tr><td colspan=\"4\"><p><strong>危害描述：</strong>攻击者成功利用该漏洞后，可以覆盖 Drupal 最高权限账户 uid 1，进而登录管理后台并读取、修改或删除站点数据；创建或提升其他管理员账户；修改站点配置、内容类型、权限和模块状态；在目标存在可用代码入口时执行任意系统命令；植入后门、持久化控制或进一步横向移动。</p></td></tr></tbody></table><p><strong>0</strong><strong>1</strong></p><p><strong>漏洞详情</strong></p><p><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong></p><p><strong>影响组件</strong></p><p>Drupal 是一款广泛使用的开源内容管理系统。Drupal core 自带 `/core/install.php`，用于首次安装站点。站点安装完成后，该文件不再需要对外暴露。</p><p><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong></p><p><strong>漏洞描述</strong></p><p>近日，奇安信CERT监测到Drupal 安装程序远程代码执行漏洞(CVE-2026-132165)在野利用，该漏洞源于 Drupal core 的安装器状态校验不当，当站点已完成安装但安装任务状态未正确闭环时，攻击者可匿名续跑 /core/install.php 安装流程，覆盖 uid 1 管理员账户的用户名、邮箱和密码，从而绕过身份验证并接管站点。成功接管后，攻击者可借助目标环境中已有的模块、主题或文件写入等代码入口执行任意命令，最终实现远程代码执行。目前该漏洞PoC和技术细节已公开。鉴于该漏洞已发现在野利用，建议客户尽快做好自查及防护。</p><p><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong></p><p><strong>利用条件</strong></p><p>目标处于安装完成但安装任务未闭环等特定状态；settings.php 只读可阻断部分路径，但不能阻断全部路径。</p><p><strong>02</strong></p><p><strong>影响范围</strong></p><p><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong></p><p><strong>影响版本</strong></p><p>Drupal &lt; 10.6.22</p><p>11.0.0 &lt;= Drupal &lt;= 11.3.22</p><p>11.4.0 &lt;= Drupal &lt;= 11.4.13</p><p><strong>03</strong></p><p><strong>复现情况</strong></p><p>目前，奇安信CERT已成功复现Drupal 安装程序远程代码执行漏洞(CVE-2026-132165)，截图如下：</p><p><img src=\"/dailyinfo/media/66f473644150861c.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong>04</strong></p><p><strong>受影响资产情况</strong></p><p>奇安信鹰图资产测绘平台数据显示，Drupal 安装程序远程代码执行漏洞(CVE-2026-132165)关联的国内风险资产总数为15552个，关联IP总数为3546个。国内风险资产分布情况如下：</p><p><img src=\"/dailyinfo/media/40dcb094839bda69.webp\" loading=\"lazy\" decoding=\"async\"></p><p>Drupal 安装程序远程代码执行漏洞(CVE-2026-132165)关联的全球风险资产总数为317630个，关联IP总数为90674个。全球风险资产分布情况如下：</p><p><img src=\"/dailyinfo/media/cec2eecd28e76669.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong>05</strong></p><p><strong>处置建议</strong></p><p><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong></p><p><strong>安全更新</strong></p><p>官方已发布安全补丁，请及时更新至最新版本：</p><p>对于 Drupal 10.6.x，更新到 Drupal 10.6.22</p><p>对于 Drupal 11.3.x，更新到 Drupal 11.3.22</p><p>对于 Drupal 11.4.x，更新到 Drupal 11.4.13</p><p>以下版本已停止安全支持，无法获得官方安全修复：</p><p>Drupal 8</p><p>Drupal 9</p><p>Drupal 10.5.x 及更低版本</p><p>Drupal 11.2.x 及更低版本</p><p>下载地址：</p><p>https://www.drupal.org/project/drupal/releases/</p><p>临时缓解措施：</p><p>1. 在 Web 服务器、反向代理或 WAF 上禁止访问 /core/install.php；</p><p>2. 同时拦截 /core/install.php/ 及其后缀路径，避免只使用精确路径匹配；</p><p>3. 禁止 Web 服务用户写入 settings.php 或修改其权限；</p><p>4. 在部署流程允许的情况下删除 core/install.php；</p><p>5. 如使用 Drupal Steward，应确认保护已生效，但仍应尽快升级；</p><p>6. 检查站点是否已经处于安装任务未闭环状态。</p><p><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong></p><p><strong>产品解决方案</strong></p><p><strong>奇<strong>安信网神网络数据传感器系统产品检测方案</strong></strong></p><p>奇安信网神网络数据传感器（NDS5000/7000/9000系列）产品，已具备该漏洞的检测能力。规则ID为：8535，建议用户尽快升级检测规则库至2611251500或以上。</p><p><strong>奇安信天眼检测方案</strong></p><p>奇安信天眼新一代安全感知系统已经能够有效检测针对该漏洞的攻击，请将规则版本升级到3.0.1125.15191或以上版本。规则ID及规则名称：</p><p>0x10022B32，Drupal 命令执行漏洞(CVE-2026-132165)。奇安信天眼流量探针规则升级方法：系统配置-&gt;设备升级-&gt;规则升级，选择“网络升级”或“本地升级”。</p><p><strong>奇安信开源卫士已支持</strong></p><p>奇安信开源卫士20261125.1563 版本已支持对 Drupal 安装程序远程代码执行漏洞(CVE-2026-132165)的检测。</p><p><strong>奇安信网站应用安全云防护系统已更新防护特征库</strong></p><p>奇安信网神网站应用安全云防护系统已全局更新所有云端防护节点的防护规则，支持对Drupal 安装程序远程代码执行漏洞(CVE-2026-132165)的防护。</p><p><strong>06</strong></p><p><strong>参考资料</strong></p><p>[1]https://www.drupal.org/project/drupal/releases/</p><p>[2]https://www.cisa.gov/known-exploited-vulnerabilities-catalog?search_api_fulltext=CVE-2026-132165</p><p>声明：本文来自奇安信 CERT，版权归作者所有。文章内容仅代表作者独立观点，不代表安全内参立场，转载目的在于传递更多信息。如有侵权，请联系 anquanneican@163.com。</p>","original","zhKind","complete","漏洞","复现","补丁","https://www.secrss.com/articles/95992","安全内参",{"_92":93,"_94":-5},"changelogVersion","2026-10-01T08:00","release"]
