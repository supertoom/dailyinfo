[{"_1":2,"_3":4},"root",{"_5":103},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1794962443000,"id","mkzk4m7i7p0ykhitydl6nj7vt","title","CVE-2026-114938 被报告为 Java 17 及以上版本的关键预认证远程代码执行漏洞，CVSS v4 9.2","originalTitle","CVE-2026-114938: Reported Critical Pre-authentication Remote Code Execution in Java 17","summary","CVE-2026-114938 被公开报告为 Java 17 及以上版本中的内存损坏漏洞，攻击者无需认证即可远程执行代码，严重等级为 Critical，CVSS v4 评分为 9.2。","reason","source",{"_71":102},"links",{"_61":101},"publishedAt","2026-11-17T18:26:55.000Z","discoveredAt","2026-11-17T19:22:35.270Z","timelineAt","category","vuln","tags",[98,99,100,45],"score",63,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","Rapid7","body",{"_94":-5,"_61":95,"_96":-5,"_97":36},"outline",[79,80,81,82],"relatedStories",[75],"topics",[68,69],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","f8X9-lkLyK9M","reportCount",2,"additionalSourceCount",1,{"_70":73,"_71":74},{"_70":30,"_71":72},"slug","name","漏洞披露","oracle","Oracle / 甲骨文",{"_76":77,"_13":78},"publicId","8540cb70-bd3c-4700-8134-83f02bb49280","Java4Shell漏洞获官方补丁，利用条件受限",{"_11":92,"_84":93,"_86":65},{"_11":90,"_84":91,"_86":65},{"_11":87,"_84":88,"_86":89},{"_11":83,"_84":85,"_86":65},"sec-4","text","Updates","level","sec-3","Exposure Command, Vulnerability Management, and Nexpose",3,"sec-2","Rapid7 customers","sec-1","Overview","zh","<h2 id=\"sec-1\">Overview</h2><p><span>On November 17, 2026, public reports described </span><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-114938\"><span>CVE-2026-114938</span></a><span> as a memory corruption vulnerability in Java </span><span>17</span><span> and above that could allow a remote attacker to execute code without authentication. The reported severity is Critical, with a CVSSv4 score of 9.2. These CVE-specific details remain preliminary, pending confirmation in Oracle or OpenJDK advisories.</span></p><p><span>Rapid7 is actively monitoring the situation and will update this blog as new information arrives.</span></p><p><span>For the latest vendor release information, refer to </span><a href=\"https://www.oracle.com/security-alerts/cspunov2026.html\"><span>Oracle's November security update notice</span></a><span> and </span><a href=\"https://openjdk.org/groups/vulnerability/advisories/\"><span>OpenJDK's vulnerability advisories</span></a><span>.</span></p><h2 id=\"sec-2\">Rapid7 customers</h2><h3 id=\"sec-3\"><span>Exposure Command, Vulnerability Management, and Nexpose</span></h3><p><span>Exposure Command, Vulnerability Management, and Nexpose customers can assess exposure to CVE-2026-114938 with an authenticated vulnerability check available in the November 17 content release (1.1.4115).</span></p><h2 id=\"sec-4\">Updates</h2><ul><li><p><span><strong>November 17, 2026</strong></span><span>: Initial publication.</span></p></li></ul>","zhKind","complete","漏洞","复现","Oracle","https://www.rapid7.com/blog/post/etr-cve-2026-114938-reported-critical-pre-authentication-remote-code-execution-java-17","Rapid7 CVE 公告",{"_104":105,"_106":-5},"changelogVersion","2026-10-01T08:00","release"]
