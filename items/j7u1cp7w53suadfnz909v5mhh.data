[{"_1":2,"_3":4},"root",{"_5":110},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1795740038000,"id","j7u1cp7w53suadfnz909v5mhh","title","CERT-FR 通报 Mattermost Server 漏洞（MMSA-2026-00794）","originalTitle","Vulnérabilité dans Mattermost Server (26 novembre 2026)","summary","CERT-FR 通报 Mattermost Server 存在一项安全漏洞，但厂商未说明风险及具体影响。受影响版本包括 2.47.x 中早于 2.47 Mobile.0 的版本，以及早于 2.46.1 Mobile 的版本；CERT-FR 建议查阅厂商于 25 novembre 2026 发布的安全公告 MMSA-2026-00794 获取补丁。","reason","source",{"_69":109},"links",{"_60":108},"publishedAt","2026-11-26T00:00:00.000Z","discoveredAt","2026-11-26T15:34:20.776Z","timelineAt","category","vuln","tags",[106,107],"score",31,"selected",false,"channel","news","story",{"_72":73,"_13":74},"x","readingMode","full","author","body",{"_102":-5,"_60":103,"_104":-5,"_105":36},"outline",[75,76,77,78,79,80,81,82],"relatedStories",[71],"topics",[67],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","f7-QdNtTUwi8","reportCount",1,"additionalSourceCount",0,{"_68":30,"_69":70},"slug","name","漏洞披露",{"_72":73,"_13":74},"publicId","186e35c5-e662-4e05-9c92-48d29644cb3a","CERT-FR披露Mattermost Server安全漏洞",{"_11":100,"_84":101,"_86":87},{"_11":98,"_84":99,"_86":87},{"_11":96,"_84":97,"_86":87},{"_11":94,"_84":95,"_86":87},{"_11":92,"_84":93,"_86":87},{"_11":90,"_84":91,"_86":87},{"_11":88,"_84":89,"_86":87},{"_11":83,"_84":85,"_86":87},"sec-8","text","Gestion détaillée du document","level",2,"sec-7","Documentation","sec-6","Solutions","sec-5","Résumé","sec-4","Systèmes affectés","sec-3","Risque","sec-2","Gestion du document","sec-1","Avis du CERT-FR","zh","<h2 id=\"sec-1\">Avis du CERT-FR</h2><p>Objet : Vulnérabilité dans Mattermost Server</p><h2 id=\"sec-2\">Gestion du document</h2><table>\n      <tbody>\n        <tr>\n          <th>Référence</th>\n          <td>CERTFR-2026-AVI-1627</td>\n        </tr>\n        <tr>\n          <th>Titre</th>\n          <td>Vulnérabilité dans Mattermost Server</td>\n        </tr><tr>\n            <th>Date de la première version</th><td>26 novembre 2026</td>\n          </tr>\n          <tr>\n            <th>Date de la dernière version</th><td>26 novembre 2026</td>\n          </tr><tr>\n          <th>Source(s)</th>\n          <td>Bulletin de sécurité Mattermost MMSA-2026-00794 du 25 novembre 2026<br></td>\n        </tr>\n      </tbody>\n    </table><p>Une gestion de version détaillée se trouve à la fin de ce document.</p><h2 id=\"sec-3\">Risque</h2><ul>\n          \n            <li>Non spécifié par l'éditeur</li>\n          \n        </ul><h2 id=\"sec-4\">Systèmes affectés</h2><ul>\n          \n            <li>Mattermost Server versions 2.47.x antérieure à 2.47 Mobile.0</li>\n          \n            <li>Mattermost Server versions antérieure à 2.46.1 Mobile</li>\n          \n        </ul><h2 id=\"sec-5\">Résumé</h2><p>Une vulnérabilité a été découverte dans Mattermost Server. Elle permet à un attaquant de provoquer un problème de sécurité non spécifié par l'éditeur.</p><h2 id=\"sec-6\">Solutions</h2><p>Se référer au bulletin de sécurité de l'éditeur pour l'obtention des correctifs (cf. section Documentation).</p><h2 id=\"sec-7\">Documentation</h2><ul>\n          \n          \n            <li>\n              <p>Bulletin de sécurité Mattermost MMSA-2026-00794 du 25 novembre 2026</p>\n              <a href=\"https://mattermost.com/security-updates/\">https://mattermost.com/security-updates/</a>\n            </li>\n          \n\n          \n          \n\n          \n        </ul><h2 id=\"sec-8\">Gestion détaillée du document</h2><table>\n          <thead>\n            <tr>\n              <th>Date</th>\n              <th>Description</th>\n            </tr>\n          </thead>\n          <tbody><tr>\n              <td>26 novembre 2026</td>\n              <td>Version initiale</td>\n            </tr></tbody>\n        </table>","zhKind","complete","漏洞","补丁","https://www.cert.cyber.gouv.fr/avis/CERTFR-2026-AVI-1627/","CERT-FR",{"_111":112,"_113":-5},"changelogVersion","2026-10-01T08:00","release"]
