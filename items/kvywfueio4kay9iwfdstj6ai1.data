[{"_1":2,"_3":4},"root",{"_5":142},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":-5,"_57":36,"_58":59},"expiresAt",1795480837000,"id","kvywfueio4kay9iwfdstj6ai1","title","AWS 发布 API Portal、API Security 与 AI Security，防护 API 和 AI 端点","originalTitle","Introducing API and AI security on AWS, from discovery to protection","summary","AWS 正式发布 API Portal、AWS WAF API Security 和 AI Security，用于发现并防护 REST API、LLM 推理端点、MCP 与 A2A 服务。","reason","source",{"_66":141},"links",{"_59":140},"publishedAt","2026-11-23T20:25:17.000Z","discoveredAt","2026-11-23T20:41:38.979Z","timelineAt","category","blue-team","tags",[135,136,137,138,69,139],"score",61,"selected",false,"channel","news","story","x","readingMode","full","author","Gopinath Durairaj","body",{"_131":-5,"_59":132,"_133":-5,"_134":36},"outline",[74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91],"relatedStories",[],"topics",[60,61,62,63],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_64":72,"_66":73},{"_64":70,"_66":71},{"_64":68,"_66":69},{"_64":65,"_66":67},"slug","tools","name","工具与平台","ai-security","AI 安全","ai-agent","AI Agent 安全","cloud-native","云与原生",{"_11":129,"_93":130,"_95":104},{"_11":127,"_93":128,"_95":104},{"_11":125,"_93":126,"_95":104},{"_11":123,"_93":124,"_95":104},{"_11":121,"_93":122,"_95":104},{"_11":119,"_93":120,"_95":104},{"_11":117,"_93":118,"_95":104},{"_11":115,"_93":116,"_95":104},{"_11":113,"_93":114,"_95":104},{"_11":111,"_93":112,"_95":104},{"_11":109,"_93":110,"_95":104},{"_11":107,"_93":108,"_95":104},{"_11":105,"_93":106,"_95":104},{"_11":102,"_93":103,"_95":104},{"_11":101,"_93":44,"_95":96},{"_11":99,"_93":100,"_95":96},{"_11":97,"_93":98,"_95":96},{"_11":92,"_93":94,"_95":96},"sec-18","text","Aykut Tuzunkan","level",3,"sec-17","Gabe Sin","sec-16","Eitav Arditti","sec-15","sec-14","Conclusion",2,"sec-13","Best practice: Put Amazon CloudFront in front of your APIs","sec-12","Get started","sec-11","Pricing","sec-10","Availability","sec-9","Check what gets blocked on your own traffic","sec-8","How we test API Security","sec-7","See what the rule groups found, and act on it","sec-6","Every detection is a label, and labels work with the rest of AWS WAF","sec-5","AI Security understands the protocols that agents speak","sec-4","Some abuse shows in one request. Some appears only over time.","sec-3","Discover: You can’t secure an invisible API","sec-2","What we’re launching","sec-1","Same APIs, new callers, new attack surface","zh","<p>APIs have run digital businesses for more than a decade. For a while, there seemed to be nothing new left to say about them. That changed in 2026, when AI endpoints joined them. Teams now run large language model (LLM) inference endpoints, Model Context Protocol (MCP) servers, and Agent2Agent (A2A) servers beside their REST APIs, on services such as Amazon Bedrock, Amazon Bedrock AgentCore, and Amazon Elastic Kubernetes Service (Amazon EKS), and more companies sell their API as the product itself. On the other end, AI agents read API descriptions, pick the tools they need, and chain calls with no person clicking through an app.</p><p>APIs have always had two kinds of callers: other services and people who use an app. Now there’s a third: AI agents that act on a person’s behalf. It feels like everyone has a personal AI agent that can call APIs for them. Who knew <code>curl</code> would be important again?</p><p>Today, we’re launching capabilities across <span><a href=\"https://aws.amazon.com/waf\">AWS WAF</a></span>, Amazon CloudFront, Application Load Balancer, and Amazon API Gateway that help you discover and protect the APIs and AI endpoints that services, apps, and AI agents call:<br> </p><ul> \n   <li><span><a href=\"https://docs.aws.amazon.com/apigateway/latest/developerguide/apiportal.html\"><b>API Portal</b></a></span>, a new feature in Amazon API Gateway, discovers your APIs and AI endpoints.</li> \n   <li><span><a href=\"https://docs.aws.amazon.com/waf/latest/developerguide/waf-api-security.html\"><b>API Security</b></a></span>, a new managed rule group in AWS WAF, protects your APIs.</li> \n   <li><span><a href=\"https://docs.aws.amazon.com/waf/latest/developerguide/waf-ai-security.html\"><b>AI Security</b></a></span>, a new managed rule group in AWS WAF, protects your AI endpoints.</li> \n  </ul><p>All three are generally available today. You can enable discovery in API Portal for one account or for your organization in <span><a href=\"https://docs.aws.amazon.com/organizations/latest/userguide/orgs_introduction.html\">AWS Organizations</a></span>. The two rule groups protect the resources that you associate with your protection pack (web ACL). They work together: API Portal shows which discovered endpoints AWS WAF protects, and the security events that AWS WAF detects appear on each managed API’s detail page.</p><h2 id=\"sec-1\">Same APIs, new callers, new attack surface</h2><p>Your APIs are the same APIs they always were. What changed is how you expose them, who calls them, and what threatens them.</p><p><b>How you expose them.</b><br> <br> A new MCP server or LLM endpoint takes minutes to stand up. It can be placed behind a load balancer or a CloudFront distribution without ever passing through your API gateway, so it’s missing from the API registry and the security review. An agent that can reach it doesn’t need your documentation, either, because the endpoint describes itself: an MCP client asks the server for its tools with <code>tools/list</code>, and an A2A client reads the agent card that the server publishes.</p><p><b>Who calls them.</b><br> <br> The following table compares the three kinds of callers that reach your APIs today.<br> </p><table> \n    <tbody> \n     <tr> \n      <td colspan=\"1\" rowspan=\"1\"> <p><b>Caller</b></p> </td> \n      <td colspan=\"1\" rowspan=\"1\"> <p><b>What normal looks like</b></p> </td> \n      <td colspan=\"1\" rowspan=\"1\"> <p><b>What abuse looks like</b></p> </td> \n      <td colspan=\"1\" rowspan=\"1\"> <p><b>What it means for protection</b></p> </td> \n     </tr> \n     <tr> \n      <td colspan=\"1\" rowspan=\"1\"> <p>Service to service</p> </td> \n      <td colspan=\"1\" rowspan=\"1\"> <p>Predictable, authenticated calls that repeat the same pattern</p> </td> \n      <td colspan=\"1\" rowspan=\"1\"> <p>A stolen API key, or a partner that scrapes beyond its contract</p> </td> \n      <td colspan=\"1\" rowspan=\"1\"> <p>Track rate and behavior for each API key and endpoint</p> </td> \n     </tr> \n     <tr> \n      <td colspan=\"1\" rowspan=\"1\"> <p>Person to service, through an app</p> </td> \n      <td colspan=\"1\" rowspan=\"1\"> <p>Sessions and UI-driven calls at a human pace</p> </td> \n      <td colspan=\"1\" rowspan=\"1\"> <p>Account takeover and scripted checkouts</p> </td> \n      <td colspan=\"1\" rowspan=\"1\"> <p>Browser-based signals, such as CAPTCHA and browser fingerprints, apply here</p> </td> \n     </tr> \n     <tr> \n      <td colspan=\"1\" rowspan=\"1\"> <p>AI agent to service, for a person</p> </td> \n      <td colspan=\"1\" rowspan=\"1\"> <p>Human intent with machine behavior, from an HTTP client or an automated browser</p> </td> \n      <td colspan=\"1\" rowspan=\"1\"> <p>An agent with stolen credentials, or a bot that poses as an agent</p> </td> \n      <td colspan=\"1\" rowspan=\"1\"> <p>Browser signals only go so far, so you need visibility into the API itself</p> </td> \n     </tr> \n    </tbody> \n   </table><p><b>What threatens them.</b> The APIs behind your web and mobile apps were built for one client: your own app. Your app calls them in the right order, at a human pace, with input it already validated. Legitimate agents now call those same APIs directly, and so do attackers and fraudsters. None of them have to follow the rules that your app follows.</p><h2 id=\"sec-2\">What we’re launching</h2><p>Here’s how we respond to those changes, as shown in Figure 1. In the figure, services, people, and AI agents call your APIs through their entry points. There, API Portal maps your endpoints, and AWS WAF runs API Security and AI Security on the same traffic to stop threats.</p><p>\n   <img src=\"/dailyinfo/media/e5fa9df740046d80.webp\" srcset=\"/dailyinfo/media/4ce6b37616fafbbf.webp 720w, /dailyinfo/media/6591715adf7742ec.webp 1200w, /dailyinfo/media/e5fa9df740046d80.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Figure 1: API Portal inventories the APIs and AI endpoints that services, people, and AI agents call. AWS WAF protects the entry points in front of them\" width=\"1000\" height=\"372\">\n   </p><p>Figure 1: API Portal inventories the APIs and AI endpoints that services, people, and AI agents call. AWS WAF protects the entry points in front of them</p><ul> \n   <li><b>API Portal</b> builds an inventory of your APIs from their configuration and live traffic, identifies which of them are AI endpoints (LLM inference, MCP, and A2A), and shows you what to protect. It does this by analyzing configuration and traffic across your API entry points: CloudFront, Application Load Balancer, and API Gateway.</li> \n   <li><b>API Security</b> covers three kinds of API abuse: broken object level authorization, authentication attacks such as tampered tokens and credential stuffing, and reconnaissance such as probing for undocumented routes. It does this with rules that work from a single request and with behavioral detections that learn your traffic.</li> \n   <li><b>AI Security</b> identifies your AI traffic (LLM inference, MCP, and A2A), validates MCP and A2A requests against their protocol, and checks prompts and responses through <span><a href=\"https://aws.amazon.com/bedrock/guardrails\">Amazon Bedrock Guardrails</a></span> for prompt attacks, harmful content, and sensitive information.</li> \n  </ul><p>All three work with <span><a href=\"https://aws.amazon.com/cloudfront\">Amazon CloudFront</a></span>, <span><a href=\"https://aws.amazon.com/api-gateway\">Amazon API Gateway</a></span> REST APIs, and <span><a href=\"https://aws.amazon.com/elasticloadbalancing/application-load-balancer/\">Application Load Balancer</a></span>. For the current list of supported resources, protocols, and endpoint types, see <span><a href=\"https://docs.aws.amazon.com/waf/latest/developerguide/waf-api-security.html#waf-api-security-supported\">AWS WAF API Security</a></span> and <span><a href=\"https://docs.aws.amazon.com/waf/latest/developerguide/aws-managed-rule-groups-ai-security.html#waf-ai-security-supported\">AWS WAF AI Security rule group</a></span> in the AWS WAF Developer Guide.</p><p>The three capabilities live in two places. API Portal is in the Amazon API Gateway console. That’s where it can be found, not what it covers: it discovers APIs behind CloudFront, Application Load Balancer, and API Gateway alike. API Security and AI Security are in the AWS WAF console.</p><h2 id=\"sec-3\">Discover: You can’t secure an invisible API</h2><p>Ask a platform team how many APIs they run, and you’ll get a number from a registry. Ask what’s answering requests on the internet right now, and the number changes. The MCP server that a team set up for a hackathon isn’t in the registry. Neither is the v1 endpoint that nobody turned off. Both still answer requests.</p><p>API Portal builds the inventory from both live traffic and API configuration. You enable discovery in API Portal for one account or for your organization in AWS Organizations, and you can exclude resources that you don’t want in the inventory. It reads the service logs and configuration records of your API entry points. There’s nothing to attach, no logs to forward, and no traffic to reroute. It lists the endpoints that receive traffic, by host, path, and HTTP method. Every endpoint starts as a shadow API: deployed and reachable, but not yet governed. When you promote it, it becomes a managed API. For APIs you manage, API Portal also flags zombie APIs, which have no traffic and no configuration change for a set period, and orphaned APIs, whose owning account was closed or removed from your organization. Retire a zombie API that nothing needs, and resolve the ownership of an orphaned one. For the classification rules, see the <span><a href=\"https://docs.aws.amazon.com/apigateway/latest/developerguide/apiportal.html\">API Portal Developer Guide</a></span>.</p><p>API Portal also discovers your AI endpoints. It reports each endpoint’s type, such as an LLM inference endpoint, an MCP server, or an A2A server. It finds them in the traffic at the same entry points (CloudFront, Application Load Balancer, and API Gateway) and lists them in the same inventory as your other APIs, so you don’t build a separate view for them. Combined, one row can show a shadow MCP server that nobody manages yet. Figure 2 shows the inventory.</p><p>\n   <img src=\"/dailyinfo/media/4e391da7896cbed5.webp\" srcset=\"/dailyinfo/media/5779ed91fb72b3d2.webp 720w, /dailyinfo/media/0e3b5f2588525107.webp 1200w, /dailyinfo/media/4e391da7896cbed5.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Figure 2: The API inventory in API Portal lists the endpoints discovered behind API Gateway and Application Load Balancer, with each endpoint's AWS WAF status, classification, and AI workload type\" width=\"3000\" height=\"1976\">\n   </p><p>Figure 2: The API inventory in API Portal lists the endpoints discovered behind API Gateway and Application Load Balancer, with each endpoint’s AWS WAF status, classification, and AI workload type</p><blockquote>\n   <p>“We can manage our API environment more effectively when we have a clear picture of what’s running across AWS. API Portal gives us that visibility without requiring teams to change how they deploy APIs or route traffic, helping us create a more complete view across the enterprise.” <br>— Mike Hasani, Senior Software Engineer, Principal Financial Group</p>\n  </blockquote><h2 id=\"sec-4\">Some abuse shows in one request. Some appears only over time.</h2><p>Two requests show why protecting an API takes two kinds of detection. Here’s the first one:</p><pre class=\"language-text\"><code class=\"language-text\">GET /v1/orders/48213 HTTP/1.1\nHost: orders.example.com\nAuthorization: Bearer eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJzdWIiOiJhZG1pbiIsInJvbGUiOiJhZG1pbiJ9.</code></pre><p>This JSON Web Token (JWT) declares <code>alg: none</code>. It asks your API to skip signature verification, and a correctly built client doesn’t send that. The API Security managed rule group blocks the request before it reaches your origin, from the first request and with no learning period. The same rules catch other token tampering, such as pointing the token at a signing key that the attacker controls. These rules check the structure of a token in the Authorization header. They don’t verify its signature, so your application still has to validate the token. For the full list of rules and what each one does by default, see <span><a href=\"https://docs.aws.amazon.com/waf/latest/developerguide/aws-managed-rule-groups-api-security.html\">API Security managed rule group</a></span> in the AWS WAF Developer Guide.</p><p>Here’s the second one:</p><pre class=\"language-text\"><code class=\"language-text\">GET /accounts/1337 HTTP/1.1</code></pre><p>Nothing is wrong with this request, and the caller’s token is valid. It’s abuse only if the caller doesn’t own account 1337, and no single request can tell you that. This is broken object level authorization (BOLA), the first entry in the <span><a href=\"https://api-security.owasp.org/\">OWASP API Security Top 10</a></span>.</p><p>So, the managed rule group also learns. It builds a baseline from your own traffic and looks for callers who don’t fit it. There’s nothing to set up for this. You don’t turn on logging or mirror traffic.</p><p>The hard part is to avoid flagging your own scripts. For example, a nightly export job reads thousands of records on a steady machine schedule. On those two signs alone, it looks like an attacker. So a detection reaches high confidence only when different kinds of signs agree, and at least one is something your own traffic never does. For example, the caller reaches records through a sequence of calls that your app never makes, or your API keeps denying it access. High confidence also needs a caller that AWS WAF can identify from a credential on the request, such as a token. A caller that AWS WAF knows only by IP address stays at medium confidence. Figure 3 compares a nightly export job with an attacker on these signs.</p><p>\n   <img src=\"/dailyinfo/media/05c771400ea181e5.webp\" srcset=\"/dailyinfo/media/ac665d367bc0ec5c.webp 720w, /dailyinfo/media/eb273d16e0e83999.webp 1200w, /dailyinfo/media/05c771400ea181e5.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Figure 3: Volume and timing alone don't reach high confidence. A sign that your own traffic never shows has to agree with them\" width=\"1000\" height=\"292\">\n   </p><p>Figure 3: Volume and timing alone don’t reach high confidence. A sign that your own traffic never shows has to agree with them</p><p>The behavioral detections cover more than object access. They also flag credential stuffing, where one source presents an unusual number of different credentials in the Authorization header, and probing, where a caller keeps requesting routes or parameters that your traffic never uses.</p><p>The same thinking applies to the response, what your APIs send back. The behavioral detections take account of the status codes that your application returns, such as a caller’s rate of denied or failed requests. A caller stands out when, for example, its successful calls turn into a run of authorization failures. API Security doesn’t inspect the content of responses. Figure 4 shows the APIs view of the protection pack (web ACL) dashboard in the AWS WAF console.</p><p>\n   <img src=\"/dailyinfo/media/db8afa240715bf87.webp\" srcset=\"/dailyinfo/media/fcd176faeb9ec10a.webp 720w, /dailyinfo/media/17737afb45a575b4.webp 1200w, /dailyinfo/media/db8afa240715bf87.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Figure 4: The APIs view of the protection pack (web ACL) dashboard shows API Security detections over time, the detections that matched the most requests, and how AWS WAF handled the labeled requests.\" width=\"2183\" height=\"2346\">\n   </p><p>Figure 4: The APIs view of the protection pack (web ACL) dashboard shows API Security detections over time, the detections that matched the most requests, and how AWS WAF handled the labeled requests.</p><p>Every detection is a label under <code>awswaf:managed:aws:api-security:</code>. A label starts with a stage (<code>attack</code>, <code>recon</code>, or <code>warning</code>) and names the finding. Behavioral detections also end with a confidence (high, medium, or low). Each rule has its own default action. The single-request rules that identify token tampering and unsafe methods block, and the posture and schema discovery rules count. Behavioral detections block at high confidence and count at medium and low confidence, at either stage. Detections that work from a single request have no confidence. For example, <code>attack:alg_none:jwt_header</code> and <code>attack:object_level:high</code> block, and <code>recon:path_schema</code> counts. AWS WAF also repeats a caller’s finding as an <code>actor_identity</code> label on that caller’s later requests across the whole protection pack (web ACL), for about five minutes after the last detection. At high confidence, the rule group blocks those requests by default. At medium and low confidence it counts them, and your own rules can act on the label.</p><h2 id=\"sec-5\">AI Security understands the protocols that agents speak</h2><p>LLM inference endpoints, MCP servers, and A2A servers are APIs, too. API Portal shows you which of your endpoints they are, and the API Security managed rule group already inspects their requests like any other API path.</p><p>The AI Security managed rule group adds checks made for agent traffic. It first recognizes the traffic and labels each request as LLM, MCP, A2A, or not recognized, so the checks that follow fit each endpoint type. It runs in the same AWS WAF protection pack (web ACL) as your other rules, with no new service to deploy.</p><p>Its first layer checks each MCP and A2A request against the protocol version that the request declares in its <code>MCP-Protocol-Version</code> or <code>A2A-Version</code> header. It supports MCP versions 2025-06-18, 2025-11-25, and 2026-07-28, and A2A version 1.0. For the current list, see <span><a href=\"https://docs.aws.amazon.com/waf/latest/developerguide/aws-managed-rule-groups-ai-security.html\">AI Security managed rule group</a></span>. These protocol compliance checks are deterministic and run entirely in AWS WAF. They come in two levels. Baseline covers the violations that let a request slip past routing or inspection, as the example that follows shows, and blocks by default. Strict adds malformed requests that are worth flagging but are usually an outdated client, and counts by default. Each failed check also adds its own label, so you can see exactly which check failed. Here’s the kind of trick that Baseline catches. The header tells every component in front of the MCP server that the request only lists tools. The body calls a tool that reads a file:</p><pre class=\"language-text\"><code class=\"language-text\">POST /mcp HTTP/1.1\nHost: tools.example.com\nContent-Type: application/json\nMCP-Protocol-Version: 2026-07-28\nMcp-Method: tools/list\nMcp-Name: read_file\n\n{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"read_file\",\n    \"arguments\": { \"path\": \"/etc/passwd\" }\n  }\n}</code></pre><p>A gateway or authorizer that trusts the header treats the request as read-only, and the server runs the tool. AWS WAF blocks the request at the API entry point, because the header and the body disagree about the method.</p><p>Its second layer checks content through Amazon Bedrock Guardrails. You don’t create or configure a guardrail for this. You turn on the option in the rule group and choose a service role, and AWS WAF assumes that role to call Bedrock Guardrails with your account’s identity. Bedrock Guardrails returns a score for each check. AWS WAF groups the scores into three levels (high, medium, and low), and the rule group has one rule for each check at each level, so you choose the action for each one. AWS WAF picks the checks for each endpoint type and each direction, as the following table shows. Response checks run only when you turn on response inspection. They cover the response body up to the body size that AWS WAF inspects for that resource, and content beyond that size isn’t checked.<br> </p><table> \n    <tbody> \n     <tr> \n      <td colspan=\"1\" rowspan=\"1\"> <p><b>Bedrock Guardrails check</b></p> </td> \n      <td colspan=\"1\" rowspan=\"1\"> <p><b>What it looks for</b></p> </td> \n      <td colspan=\"1\" rowspan=\"1\"> <p><b>On requests</b></p> </td> \n      <td colspan=\"1\" rowspan=\"1\"> <p><b>On responses</b></p> </td> \n     </tr> \n     <tr> \n      <td colspan=\"1\" rowspan=\"1\"> <p>Prompt attack</p> </td> \n      <td colspan=\"1\" rowspan=\"1\"> <p>Jailbreaks, prompt injection, and attempts to extract the system prompt</p> </td> \n      <td colspan=\"1\" rowspan=\"1\"> <p>Yes</p> </td> \n      <td colspan=\"1\" rowspan=\"1\"> <p>MCP and A2A only</p> </td> \n     </tr> \n     <tr> \n      <td colspan=\"1\" rowspan=\"1\"> <p>Content filter</p> </td> \n      <td colspan=\"1\" rowspan=\"1\"> <p>Hate, insults, sexual content, violence, and misconduct</p> </td> \n      <td colspan=\"1\" rowspan=\"1\"> <p>LLM and A2A only</p> </td> \n      <td colspan=\"1\" rowspan=\"1\"> <p>No</p> </td> \n     </tr> \n     <tr> \n      <td colspan=\"1\" rowspan=\"1\"> <p>Sensitive information</p> </td> \n      <td colspan=\"1\" rowspan=\"1\"> <p>Personal data such as card numbers, US Social Security numbers, email addresses, and bank account numbers, plus credentials such as passwords and AWS access keys</p> </td> \n      <td colspan=\"1\" rowspan=\"1\"> <p>No</p> </td> \n      <td colspan=\"1\" rowspan=\"1\"> <p>Yes</p> </td> \n     </tr> \n    </tbody> \n   </table><p>By default, AWS WAF blocks a high-severity prompt attack, on the request or the response. Everything else counts and adds a label that names what matched, such as a prompt injection or a card number. You can change the action for any rule. If Bedrock Guardrails can’t check a request, AWS WAF adds a label that says why and lets the request through. The label is <code>guardrails:not_assessed</code> when the content can’t be assessed, such as an empty prompt. It’s <code>guardrails:call_failed</code> when the call to Bedrock Guardrails fails, plus a second label with the reason, such as <code>guardrails:call_failed:throttling</code>. Like every label, these appear in your AWS WAF logs and CloudWatch metrics. For how labels work, see <span><a href=\"https://docs.aws.amazon.com/waf/latest/developerguide/waf-labels.html\">Web request labeling in AWS WAF</a></span>. To fail closed when the call to Bedrock Guardrails fails, set the <code>Guardrails_CallFailed</code> rule to block. Throttling then blocks requests, too. Content checks run in the supported Regions listed in <a href=\"https://docs.aws.amazon.com/waf/latest/developerguide/aws-managed-rule-groups-ai-security.html\">AWS WAF AI Security rule group</a>. Figure 5 follows one request through these checks.</p><p>\n   <img src=\"/dailyinfo/media/e590087600304b54.webp\" srcset=\"/dailyinfo/media/d3df7d7072d2951c.webp 720w, /dailyinfo/media/48f919305b9cb2b5.webp 1200w, /dailyinfo/media/e590087600304b54.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Figure 5: AWS WAF recognizes agent traffic and checks its protocol itself, and calls Amazon Bedrock Guardrails to check the prompt on the way in and the answer on the way out\" width=\"1000\" height=\"260\">\n   </p><p>Figure 5: AWS WAF recognizes agent traffic and checks its protocol itself, and calls Amazon Bedrock Guardrails to check the prompt on the way in and the answer on the way out</p><p>The AI Security labels follow the same steps, under <code>awswaf:managed:aws:ai-security:</code>. For example, <code>traffic:recognized_mcp</code> says what the traffic is, <code>protocol_compliance_level:baseline:mcp</code> is the level you act on, <code>protocol_compliance_check:mcp_method_mismatch</code> names the check that failed, and <code>request:guardrails:prompt_attack:severity:high</code> carries the Bedrock Guardrails result. For the full label list, supported protocols, and configuration, see <span><a href=\"https://docs.aws.amazon.com/waf/latest/developerguide/aws-managed-rule-groups-ai-security.html\">AI Security managed rule group</a></span>. Figure 6 shows the AI endpoints view of the protection pack (web ACL) dashboard.</p><p>\n   <img src=\"/dailyinfo/media/3d1dc013480b38d5.webp\" srcset=\"/dailyinfo/media/96300f1f3f0663b7.webp 720w, /dailyinfo/media/f37b3566a3660af0.webp 1200w, /dailyinfo/media/3d1dc013480b38d5.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Figure 6: The AI endpoints view of the protection pack (web ACL) dashboard shows AI Security detections over time, the Amazon Bedrock Guardrails findings that matched the most requests, and how AWS WAF handled AI traffic\" width=\"2183\" height=\"2346\">\n   </p><p>Figure 6: The AI endpoints view of the protection pack (web ACL) dashboard shows AI Security detections over time, the Amazon Bedrock Guardrails findings that matched the most requests, and how AWS WAF handled AI traffic</p><h2 id=\"sec-6\">Every detection is a label, and labels work with the rest of AWS WAF</h2><p>Every detection from the API Security and AI Security rule groups is also a label on the request. Any rule that runs later in your protection pack can match those labels and combine them with labels from other managed rule groups. Examples are <span><a href=\"https://docs.aws.amazon.com/waf/latest/developerguide/aws-managed-rule-groups-bot.html\">AWS WAF Bot Control</a></span>, <span><a href=\"https://docs.aws.amazon.com/waf/latest/developerguide/aws-managed-rule-groups-atp.html\">AWS WAF Fraud Control account takeover prevention</a></span>, and the <span><a href=\"https://docs.aws.amazon.com/waf/latest/developerguide/aws-managed-rule-groups-ip-rep.html\">Amazon IP reputation list</a></span>. That list draws on <span><a href=\"https://aws.amazon.com/blogs/security/how-aws-threat-intelligence-deters-threat-actors/\">MadPot</a></span>, the threat intelligence tool that Amazon uses to protect customers from cybercrime. Use request labels in your own rules. Labels from response checks, such as sensitive information in a response, drive the AI Security rule group’s own actions and appear in your CloudWatch metrics.</p><p>Here are four examples of what that makes possible:<br> </p><ul> \n   <li><b>Rate limits keyed on labels.</b> One probe for your API schema can be noise. Fifty from the same caller in 5 minutes is reconnaissance. A rate-based rule scoped to the reconnaissance labels counts only those requests.</li> \n   <li><b>No unsigned agents on your MCP server.</b> If your MCP server is only for agents you work with, block requests without an access token or a verified Web Bot Auth signature. Then match the Bot Control bot name label for the operators you trust. Application Load Balancer JWT verification, CloudFront Functions, <span><a href=\"https://docs.aws.amazon.com/AmazonCloudFront/latest/DeveloperGuide/lambda-at-the-edge.html\">Lambda@Edge</a></span>, or your MCP server still validates the token itself.</li> \n   <li><b>Two weak signals that add up.</b> A low-confidence API Security label or a Bot Control signal by itself isn’t enough to block. Block only the requests that carry both.</li> \n   <li><b>Tighter limits on sensitive paths.</b> Bot Control targeted protection labels callers by confidence. Use those labels to set a lower rate limit on <code>/checkout</code> than on the rest of your API.</li> \n  </ul><p>The following rule shows the first example. For each IP address, it counts the requests that carry an API Security reconnaissance label. When an address sends more than 50 requests in 5 minutes, the rule blocks them. Place it after the API Security managed rule group so that its labels are available.</p><pre class=\"language-text\"><code class=\"language-text\">{\n  \"Name\": \"RateLimitAPISecurityRecon\",\n  \"Priority\": 40,\n  \"Statement\": {\n    \"RateBasedStatement\": {\n      \"Limit\": 50,\n      \"EvaluationWindowSec\": 300,\n      \"AggregateKeyType\": \"IP\",\n      \"ScopeDownStatement\": {\n        \"LabelMatchStatement\": { \"Scope\": \"NAMESPACE\", \"Key\": \"awswaf:managed:aws:api-security:recon:\" }\n      }\n    }\n  },\n  \"Action\": { \"Block\": {} },\n  \"VisibilityConfig\": { \"SampledRequestsEnabled\": true, \"CloudWatchMetricsEnabled\": true, \"MetricName\": \"RateLimitAPISecurityRecon\" }\n}</code></pre><p>Labels don’t have to stop at AWS WAF. With custom request headers and dynamic label interpolation, AWS WAF can forward the matched labels to your origin. Your application then sees what AWS WAF saw and can show less data, require step-up authentication, or log the request for review. For how it works, see <span><a href=\"https://aws.amazon.com/blogs/security/do-more-with-aws-waf-labels-using-dynamic-label-interpolation/\">Do more with AWS WAF labels using dynamic label interpolation</a></span>.</p><p>We keep adding labels, so the documentation holds the current lists. See <span><a href=\"https://docs.aws.amazon.com/waf/latest/developerguide/aws-managed-rule-groups-api-security.html#aws-managed-rule-groups-api-security-labels\">API Security labels</a></span>, <span><a href=\"https://docs.aws.amazon.com/waf/latest/developerguide/aws-managed-rule-groups-ai-security.html#aws-managed-rule-groups-ai-security-labels\">AI Security labels</a></span>, and <span><a href=\"https://docs.aws.amazon.com/waf/latest/developerguide/aws-managed-rule-groups-bot.html\">AWS WAF Bot Control rule group</a></span>.</p><h2 id=\"sec-7\">See what the rule groups found, and act on it</h2><p>Every label is also an <span><a href=\"https://aws.amazon.com/cloudwatch\">Amazon CloudWatch</a></span> metric, with no extra setup, and appears in your AWS WAF logs. The protection pack (web ACL) dashboard in the AWS WAF console shows them as traffic arrives. In API Portal, each managed API’s detail page shows the security events that AWS WAF detected on it, as shown in Figure 7.</p><p>\n   <img src=\"/dailyinfo/media/c8417a04baa091bb.webp\" srcset=\"/dailyinfo/media/1101cf5667984e58.webp 720w, /dailyinfo/media/e99c9ece636ba02f.webp 1200w, /dailyinfo/media/c8417a04baa091bb.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Figure 7: Each managed API's detail page in API Portal shows the events that AWS WAF detected on it\" width=\"3000\" height=\"1581\">\n   </p><p>Figure 7: Each managed API’s detail page in API Portal shows the events that AWS WAF detected on it</p><p>The managed rule groups enforce their own detections at your API entry points. To write a rule of your own, start from a label. Scope a rate-based rule to the paths it appears on, key it on the IP address or TLS fingerprint, and start in count mode.</p><p>When a detection type spikes, your existing alerting can act on it. That can be a CloudWatch alarm, or the observability or security platform that already reads your metrics and logs. For log destinations, see <span><a href=\"https://docs.aws.amazon.com/waf/latest/developerguide/logging.html\">Logging AWS WAF protection pack (web ACL) traffic</a></span>.</p><h2 id=\"sec-8\">How we test API Security</h2><p>No single test shows whether a detection works, so we combine several for API Security:<br> </p><ul> \n   <li><b>Automated red teaming</b> – LLM-powered agents run continuously against deliberately vulnerable test APIs that we maintain. They probe, adapt, and chain steps the way an attacker does.</li> \n   <li><b>A growing attack suite</b> – Each working exploit that the agents find becomes a repeatable test case. We replay the suite against the managed rule group when it changes.</li> \n   <li><b>Realistic legitimate traffic</b> – We replay traffic such as batch jobs, seasonal spikes, and power users next to the attacks, so we measure false positives together with detections.</li> \n  </ul><p>Results from our test environment don’t transfer directly to yours, because your APIs and the attacks against them differ. The numbers that matter come from your own traffic, and the next section shows how to get them. API Security is designed to detect and block callers who walk object IDs to harvest other users’ records, and tokens whose structure shows tampering. It also flags credential stuffing against the Authorization header and callers who probe for routes that your API doesn’t serve. Efficacy and expansion work for API Security, like AWS WAF security in general, is a continuous effort. For the current list of detections, see <span><a href=\"https://docs.aws.amazon.com/waf/latest/developerguide/aws-managed-rule-groups-api-security.html\">API Security managed rule group</a></span> in the AWS WAF Developer Guide.</p><h2 id=\"sec-9\">Check what gets blocked on your own traffic</h2><p>The managed rule groups apply their default actions from the moment you add them. To see what a rule group finds before it blocks anything, first add it with all rule actions overridden to count, review the results, and then remove the override. Later, to review one rule, override only that rule to count. AWS WAF still evaluates an overridden rule and adds its label, so you see what it would have blocked on your own production traffic.</p><p>Behavioral detections need time to learn your traffic. For the learning period, see <span><a href=\"https://docs.aws.amazon.com/waf/latest/developerguide/waf-api-security-deploying.html#waf-api-security-deploying-baseline\">Testing and deploying AWS WAF API Security</a></span>. For a step-by-step evaluation, see <span><a href=\"https://docs.aws.amazon.com/waf/latest/developerguide/web-acl-testing.html\">Testing and tuning your AWS WAF protections</a></span>.</p><h2 id=\"sec-10\">Availability</h2><p>API Portal, API Security, and AI Security are generally available today. Detection of data exfiltration and sensitive data exposure in responses for API Security is coming soon.</p><h2 id=\"sec-11\">Pricing</h2><p>Each capability is priced by the service it runs in. For API Portal, see <span><a href=\"https://aws.amazon.com/api-gateway/pricing/\">Amazon API Gateway pricing</a></span>. For the API Security and AI Security managed rule groups, see <span><a href=\"https://aws.amazon.com/waf/pricing/\">AWS WAF pricing</a></span>. For the content checks that AI Security runs through Bedrock Guardrails, see <span><a href=\"https://aws.amazon.com/bedrock/pricing/\">Amazon Bedrock pricing</a></span>.</p><h2 id=\"sec-12\">Get started</h2><p>To get started, complete the following steps:<br> </p><ol> \n   <li>In API Portal, enable discovery for one account or for your organization in AWS Organizations, and exclude any resources that you don’t want in the inventory. This step doesn’t need AWS WAF. As the inventory builds, look for endpoints you didn’t expect, such as shadow APIs and AI endpoints, and add them to your managed APIs.</li> \n   <li>In the AWS WAF console, add the API Security managed rule group to the protection pack in front of your APIs. Start with all rule actions overridden to count, review what it finds on your own traffic, and then remove the override.</li> \n   <li>If you run AI endpoints, add the AI Security managed rule group to the same protection pack. To turn on the Bedrock Guardrails checks, choose a service role that AWS WAF can assume to call Bedrock Guardrails, and turn on response inspection if you want responses checked and your protection pack (web ACL) protects CloudFront or an Application Load Balancer. Start with the four rules that block by default overridden to count, review what they find on your own traffic, and then remove the overrides one rule at a time.</li> \n   <li>After the first baseline is available, the behavioral detections label abuse and block it at high confidence. Watch the labels in your CloudWatch metrics, and in your AWS WAF logs if you turn on logging.</li> \n   <li>Use those labels in your own rules, such as a lower rate limit on your most sensitive paths.</li> \n  </ol><p>For step-by-step instructions, see <span><a href=\"https://docs.aws.amazon.com/waf/latest/developerguide/waf-api-security-rg-using.html\">Adding the API Security managed rule group</a></span> and <span><a href=\"https://docs.aws.amazon.com/waf/latest/developerguide/waf-ai-security-rg-using.html\">Adding the AI Security managed rule group</a></span> in the AWS WAF Developer Guide.</p><h2 id=\"sec-13\">Best practice: Put Amazon CloudFront in front of your APIs</h2><p>Put Amazon CloudFront in front of your API Gateway APIs, your Application Load Balancers, and any other endpoint that is public on port 80 or 443, and associate your protection pack (web ACL) with the CloudFront distribution. That includes APIs that run outside AWS, with another cloud provider or on premises: CloudFront works with any HTTP or HTTPS origin, so those APIs get the same delivery, acceleration, and protection. The same applies to your MCP servers, A2A servers, and LLM endpoints, whether you host them on Amazon Bedrock AgentCore Gateway, on Amazon EKS, or elsewhere. With this setup:<br> </p><ul> \n   <li>AWS WAF inspects requests at the edge, before they reach your origin.</li> \n   <li>AWS WAF sees the caller’s own IP address.</li> \n   <li>AWS WAF mitigates attacks close to their source.</li> \n   <li>For origins in AWS, CloudFront VPC origins mean your Application Load Balancer or private API Gateway REST API isn’t exposed directly to the public internet and is reached through CloudFront.</li> \n  </ul><p>For more information, see <span><a href=\"https://docs.aws.amazon.com/AmazonCloudFront/latest/DeveloperGuide/distribution-web-awswaf.html\">Use AWS WAF protections</a></span> and <span><a href=\"https://docs.aws.amazon.com/AmazonCloudFront/latest/DeveloperGuide/private-content-vpc-origins.html\">Restrict access with VPC origins</a></span> in the Amazon CloudFront Developer Guide, and the posts <span><a href=\"https://aws.amazon.com/blogs/aws/introducing-amazon-cloudfront-vpc-origins-enhanced-security-and-streamlined-operations-for-your-applications/\">Introducing Amazon CloudFront VPC origins</a></span> and <span><a href=\"https://aws.amazon.com/blogs/compute/accessing-private-amazon-api-gateway-endpoints-through-custom-amazon-cloudfront-distribution-using-vpc-origins/\">Accessing private Amazon API Gateway endpoints through custom Amazon CloudFront distribution using VPC Origins</a></span>.</p><h2 id=\"sec-14\">Conclusion</h2><p>Your APIs are the same APIs they always were. The callers changed, and so did the attack surface. With API Portal, you can see the APIs and AI endpoints that the internet is calling. With API Security and AI Security in AWS WAF, you can protect them at their entry points, without changes to your backend code.</p><p>AWS built the building blocks for what comes next: an inventory from traffic, labels that you can act on, and protection where requests first arrive. As agents and the protocols they speak change, those building blocks are where new protection shows up. For the most up-to-date information, see <span><a href=\"https://docs.aws.amazon.com/waf/latest/developerguide/waf-api-security.html\">AWS WAF API Security</a></span> and <span><a href=\"https://docs.aws.amazon.com/waf/latest/developerguide/waf-ai-security.html\">AWS WAF AI Security</a></span> in the AWS WAF Developer Guide.</p><p>To get started, enable discovery in API Portal, and add the API Security and AI Security managed rule groups in the <span><a href=\"https://console.aws.amazon.com/wafv2/\">AWS WAF console</a></span>.</p><p>If you have questions about this post, contact <a href=\"https://aws.amazon.com/contact-us/\">AWS Support</a> or start a new thread on <a href=\"https://repost.aws/tags/TAKdJ093DSSdGOQ1VVKX4EvQ/aws-waf\">AWS re:Post</a>.</p><hr><p> \n   <img src=\"/dailyinfo/media/aff0d2dc42299f09.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\" width=\"120\" height=\"160\"> \n  </p><h3 id=\"sec-15\">Gopinath Durairaj</h3><p>Gopinath is a product leader who built enterprise technology businesses across cybersecurity, cloud infrastructure, AI / ML and networking. He currently leads web application security product strategy at AWS, a portfolio that includes AWS WAF, API security, and security for AI-powered applications.</p><p> \n   <img src=\"/dailyinfo/media/5133ec717091c7f3.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"\" width=\"120\" height=\"160\"> \n  </p><h3 id=\"sec-16\">Eitav Arditti</h3><p>Eitav is a Senior Solutions Architect at AWS and a technology leader with over 15 years of experience in the tech industry. He specializes in edge computing, serverless, and platform engineering, and works with engineering teams to design secure, globally scalable architectures on CloudFront and AWS WAF. His current focus is on internet-scale systems—from global content delivery to edge security.</p><p> \n   <img src=\"/dailyinfo/media/b8c15374c9e424c2.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"\" width=\"120\" height=\"160\"> \n  </p><h3 id=\"sec-17\">Gabe Sin</h3><p>Gabe is a Senior Product Manager at AWS on the Amazon API Gateway team, focused on API management. Before AWS, he led product and strategy at a cryptocurrency exchange, where he built the company’s end-to-end analytics infrastructure on AWS, bringing the same visibility and governance to data that he now brings to APIs.</p><p> \n   <img src=\"/dailyinfo/media/adaeec4d77eac5e0.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\" width=\"120\" height=\"160\"> \n  </p><h3 id=\"sec-18\">Aykut Tuzunkan</h3><p>Aykut is a Senior Technical Program Manager at AWS, based in Seattle, with more than 15 years of experience across edge security, distributed networks, and infrastructure capacity. He owns AWS WAF’s cross-org programs, which cover protection for web applications, APIs, bots, and AI traffic. He focuses on adding new protections to AWS WAF and strengthening the ones customers rely on.</p>","zhKind","complete","工具发布","云原生","大模型","Agent 安全","AWS","https://aws.amazon.com/blogs/security/introducing-api-and-ai-security-on-aws-from-discovery-to-protection/","AWS Security Blog",{"_143":144,"_145":-5},"changelogVersion","2026-10-01T08:00","release"]
