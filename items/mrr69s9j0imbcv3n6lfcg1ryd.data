[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":-5,"_57":36,"_58":59},"expiresAt",1795048834000,"id","mrr69s9j0imbcv3n6lfcg1ryd","title","CISA将4个已知被利用漏洞纳入KEV目录","originalTitle","CISA Adds Four Known Exploited Vulnerabilities to Catalog","summary","CISA依据真实利用证据，将CVE-2024-10441、CVE-2026-40217、CVE-2026-90436和CVE-2026-90817纳入Known Exploited Vulnerabilities（KEV）目录，涉及Synology DSM、BerriAI LiteLLM、Apache Axis和Vanderbilt University REDCap。","reason","source",{"_66":79},"links",{"_59":78},"publishedAt","2026-11-18T12:00:00.000Z","discoveredAt","2026-11-18T20:48:32.891Z","timelineAt","category","vuln","tags",[67,70,76,77,44],"score",64,"selected",false,"channel","news","story","x","readingMode","full","author","CISA","body",{"_72":-5,"_59":73,"_74":-5,"_75":36},"outline",[],"relatedStories",[],"topics",[60,61,62,63],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_64":71,"_66":44},{"_64":69,"_66":70},{"_64":30,"_66":68},{"_64":65,"_66":67},"slug","exploited","name","在野利用","漏洞披露","vuln-mgmt","漏洞管理","cisa","zh","<p>CISA has added four new vulnerabilities to its <a href=\"https://www.cisa.gov/known-exploited-vulnerabilities-catalog\"><u>Known Exploited Vulnerabilities (KEV) Catalog</u></a>, based on evidence of active exploitation.&nbsp;</p><ul>\n<li><a href=\"https://www.cve.org/CVERecord?id=CVE-2024-10441\">CVE-2024-10441 </a>Synology DiskStation Manager (DSM) Improper Encoding or Escaping of Output Vulnerability</li>\n<li><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-40217\">CVE-2026-40217</a> BerriAI LiteLLM Unprotected Alternate Channel Vulnerability</li>\n<li><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-90436\">CVE-2026-90436</a> Apache Axis Unsafe Reflection Vulnerability</li>\n<li><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-90817\">CVE-2026-90817</a> Vanderbilt University Research Electronic Data Capture (REDCap) Code Injection Vulnerability</li>\n</ul><p>These types of vulnerabilities are a frequent attack vector for malicious cyber actors and pose significant risks to the federal enterprise.&nbsp;</p><p><a href=\"https://www.cisa.gov/news-events/directives/bod-26-04-implementation-guidance-prioritizing-security-updates-based-risk\"><u>Binding Operational Directive (BOD) 26-04: Prioritizing Security Updates Based on Risk</u></a> establishes vulnerability management requirements for Federal Civilian Executive Branch (FCEB) agencies. BOD 26-04 reinforces the importance of the KEV Catalog and requires federal agencies to prioritize rapid remediation of high-risk vulnerabilities, specifically those identified by Common Vulnerabilities and Exposures (CVEs) listed in CISA’s KEV Catalog on publicly exposed assets that grant total control of the asset post-exploitation, while deferring action for lower-risk vulnerabilities. BOD 26-04 further establishes basic expectations for when agencies must check whether threat actors compromised the system before the patch was applied.&nbsp;</p><p>While BOD 26-04 applies only to FCEB agencies, CISA encourages all organizations to adopt risk-based vulnerability management and prioritize remediation of <a href=\"https://www.cisa.gov/known-exploited-vulnerabilities-catalog\"><u>KEV Catalog vulnerabilities</u></a>. CISA will continue to add vulnerabilities to the catalog that meet the <a href=\"https://www.cisa.gov/known-exploited-vulnerabilities\"><u>specified criteria</u></a>.&nbsp;</p><p>Aware of an exploited vulnerability not currently listed in the KEV Catalog? Submit it for potential addition through CISA’s <a href=\"https://cisasurvey.gov1.qualtrics.com/jfe/form/SV_1Zwu52kgK2OYf3w\"><u>KEV Nomination Form</u></a>. Potential KEV additions must have a CVE ID, evidence of exploitation, and clear mitigation guidance.&nbsp;</p>","zhKind","complete","漏洞","补丁","https://www.cisa.gov/news-events/alerts/2026/11/18/cisa-adds-four-known-exploited-vulnerabilities-catalog","CISA 安全公告",{"_81":82,"_83":-5},"changelogVersion","2026-10-01T08:00","release"]
