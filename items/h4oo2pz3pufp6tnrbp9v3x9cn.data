[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794616829000,"id","h4oo2pz3pufp6tnrbp9v3x9cn","title","Material Security 追踪到 27 个疑似朝鲜 IT 人员身份进入企业入职流程","originalTitle","Suspected North Korean IT workers reached onboarding at companies with open data","summary","Material Security 在一年内发现 27 个疑似朝鲜虚假 IT 人员身份进入企业入职流程，其中 18 个同时在其他公司推进求职。最新联系的 99 家组织中，4 家已有身份进入入职阶段，这些企业分别存放约 1,500 万至 1,500 万个源代码文件，以及大量社会安全号码、银行或路由号码和私钥文件，部分数据可被全体员工或持链接者访问。","reason","文章用一年期招聘漏斗和开放文件统计揭示虚假IT人员进入企业入职流程后的实际访问风险，并给出可落地的身份核验与权限排查方法。","source",{"_73":103},"links",{"_96":102},"publishedAt","2026-11-13T06:00:22.000Z","discoveredAt","2026-11-13T06:08:23.387Z","timelineAt","category","activity","tags",[74,78,100,101],"score",77,"selected",true,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","Mirko Zorz","body",{"_61":95,"_96":-5,"_97":98,"_99":37},"outline",[83,84,85],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","faE40UzUANnc","reportCount",1,"additionalSourceCount",0,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","attack","name","攻击活动","red-team","红队与渗透","identity","身份与访问",{"_80":81,"_13":82},"publicId","423f695d-8811-4303-bf93-6bb5d545c2a3","27名疑似朝鲜IT人员进入企业入职",{"_11":93,"_87":94,"_89":90},{"_11":91,"_87":92,"_89":90},{"_11":86,"_87":88,"_89":90},"sec-3","text","雇主应采取的措施","level",3,"sec-2","新账户能够接触到什么","sec-1","同一个人脸出现在多家公司","<p>Material Security 追踪了疑似朝鲜虚假 IT 工作人员通过其监控组织的招聘流程，并在一年内统计出 27 个进入入职阶段的身份。在其中一家公司，一个身份在过去一个月内推进到该阶段时，约 277,000 个包含社会安全号码的文件在公司范围内共享，或通过公开链接共享。</p><p><img src=\"/dailyinfo/media/33cbcb0e10f2d5ce.webp\" loading=\"lazy\" decoding=\"async\" alt=\"North Korean IT workers\" title=\"Fake workers\"></p><p>这些身份是虚构的求职者，拥有完整的简历和照片，申请远程工程岗位。在这一年内，其中 2,429 个取得联系，1,100 个进入面试或更后面的阶段，27 个进入入职阶段，即收到录用通知、接受背景调查、申请设备或进行首日 IT 设置。这大约是每 90 个中有 1 个，占比不大，但 27 个获得凭据中的任何一个，从第一天起就能以受信任、已获配置且怀有敌意的状态进入公司。</p><h3 id=\"sec-1\">同一个人脸出现在多家公司</h3><p>研究人员<a href=\"https://material.security/resources/a-thousand-masks-where-the-dprk-it-worker-threat-meets-your-data\">发现</a>，41% 的身份出现在一家以上组织。其中 15 个出现在十家或更多组织，还有一个出现在 19 家组织。在进入入职阶段的 27 个身份中，18 个当时同时在其他地方推进入职流程，还有一个正在一家公司完成入职手续，同时在另外七家公司寻找工作。</p><h3 id=\"sec-2\">新账户能够接触到什么</h3><p>过去 30 天内，232 个疑似身份联系了 99 家组织。其中在 42 家组织，至少有一个身份进入面试或录用阶段；在四家组织，有身份进入入职阶段。Material 对这四家组织的敏感文件进行了盘点。</p><p>第一家存有约 1,500 万个源代码文件和 130,000 个包含银行或路由号码的文件，除文件所有者外几乎未与他人共享。第二家存有约 400,000 个包含社会安全号码的文件和 345,000 个包含银行或路由号码的文件，其中 68% 的社会安全号码文件和 71% 的银行文件对公司内任何账户或持有链接的任何人开放。那里的新员工只需一个登录凭据即可访问。第三家存有约 1,400 万个源代码文件，其中约 1,900 个可由任何持有 URL 的人读取。第四家规模最小，存有约 150 万个源代码文件，以及包含私密加密密钥的文件，其 21% 的财务文件和 17% 的信用卡文件在所有者之外共享。</p><h3 id=\"sec-3\">雇主应采取的措施</h3><p>Material 建议将招聘控制与访问控制相结合，因为一旦朝鲜籍人员通过招聘环节，就会持有有效凭据。</p><ul>\n<li><strong>尽早标记虚假身份。</strong>将招聘和入职信号与威胁情报关联起来，以便在<a href=\"https://www.helpnetsecurity.com/2026/10/26/transunion-synthetic-identity-fraud-risks-report/\">虚假身份</a>获取凭据前将其阻止。</li>\n<li><strong>严格核查身份。</strong> 背景调查是发现虚构身份的机会。对任何不一致之处进行跟进。</li>\n<li><strong>按阶段进行分级处置。</strong> 在入职阶段命中的观察名单对象比首次接触时命中的对象更紧急。确认身份和相关证据，然后检查是否已经发放账户或设备。</li>\n<li><strong>入职后继续调查。</strong> 如果账户已经存在，请审查其权限、应用授权和活动记录。</li>\n<li><strong>在需要之前绘制访问关系。</strong> 了解每个角色能够访问哪些文件、消息、凭据和互联应用，以便响应人员知道应首先查看哪些位置。</li>\n</ul>","original","zhKind","translation","complete","数据泄露","红队","https://www.helpnetsecurity.com/2026/11/13/north-korean-it-workers-onboarding/","Help Net Security",{"_105":106,"_107":-5},"changelogVersion","2026-10-01T08:00","release"]
