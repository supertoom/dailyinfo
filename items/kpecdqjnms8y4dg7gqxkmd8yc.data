[{"_1":2,"_3":4},"root",{"_5":110},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1794195830000,"id","kpecdqjnms8y4dg7gqxkmd8yc","title","Amazon Redshift JDBC 驱动 CVE-2026-119084 远程代码执行漏洞已复现","originalTitle","【已复现】Amazon Redshift JDBC 驱动远程代码执行漏洞（CVE-2026-119084）","summary","Amazon Redshift JDBC 驱动 redshift-jdbc42 存在 CVE-2026-119084 远程代码执行漏洞，受影响版本为 redshift-jdbc42 < 2.3.0。","reason","source",{"_71":109},"links",{"_100":108},"publishedAt","2026-11-06T09:32:00.000Z","discoveredAt","2026-11-07T03:28:32.468Z","timelineAt","category","vuln","tags",[103,104,105,106,107],"score",59,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body",{"_60":99,"_100":-5,"_101":100,"_102":55},"outline",[78,79,80,81,82,83],"relatedStories",[74],"topics",[67,68],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","fB9O43UX6KhE","reportCount",1,"additionalSourceCount",0,{"_69":30,"_71":73},{"_69":70,"_71":72},"slug","research","name","技术研究","漏洞披露",{"_75":76,"_13":77},"publicId","54b2dec1-d96a-46a3-8757-6a9822faf170","Redshift JDBC驱动RCE漏洞已复现",{"_11":97,"_85":98,"_87":88},{"_11":95,"_85":96,"_87":88},{"_11":93,"_85":94,"_87":88},{"_11":91,"_85":92,"_87":88},{"_11":89,"_85":90,"_87":88},{"_11":84,"_85":86,"_87":88},"sec-6","text","参考资料","level",3,"sec-5","临时缓解方案","sec-4","升级修复方案","sec-3","处置优先级：高","sec-2","漏洞影响","sec-1","漏洞成因","<p><span>长亭安全应急响应中心</span> <span>2026-11-06 17:32</span> <span>浙江</span></p><p><img src=\"/dailyinfo/media/d35791d485f1ec96.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>检测业务是否受到此漏洞影响，请联系长亭应急服务团队！</p><p><img alt=\"Amazon Redshift JDBC 驱动远程代码执行漏洞\" src=\"/dailyinfo/media/4a0101a577942515.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><span>Amazon Redshift JDBC 驱动（redshift-jdbc42）是 Amazon Redshift 官方提供的 Java 数据库连接驱动，主要用于 Java 应用连接 Redshift 数据仓库，广泛应用于数据同步、报表分析、ETL 与数据服务等场景。</span></p><p><span>2026 年 11 月，长亭安全应急响应中心监测到 Amazon Redshift JDBC 驱动不安全类加载风险。攻击者在能够影响应用连接 URL 或凭据配置的场景下，可借助目标应用 classpath 上已有的类，在应用 JVM 内执行代码，可能导致应用进程被控制、敏感数据泄露或业务系统失陷。截至通告发布，AWS 已发布安全公告并提供 2.3.0 修复版本，暂未发现公开 POC/EXP。建议使用受影响版本的用户尽快排查依赖并升级至 2.3.0 或更高版本。</span></p><p><strong><span>漏洞描述</span></strong><span><span>&nbsp;Description&nbsp;</span></span></p><p><strong><span>01</span></strong></p><h3 id=\"sec-1\"><span>漏洞成因</span></h3><p><span>受影响版本在处理连接 URL 参数及凭据配置字段时，会将其中部分取值直接作为 Java 类名交给类加载逻辑，并使用会立即初始化目标类的单参数 Class.forName 形式加载。按照 Java 语言规范，该形式会先执行类的静态初始化，之后才进行类型检查；因此即使最终因类型不匹配而抛出异常，类的静态初始化代码也已经执行。</span></p><p><span>2.3.0 版本新增了统一的类加载入口：先校验传入值是否为合法的 Java 二进制类名，再以不触发初始化的方式加载类并完成类型检查，从而把类初始化推迟到校验通过之后。相关调用点均已迁移至该入口。</span></p><h3 id=\"sec-2\"><span>漏洞影响</span></h3><p><span>漏洞原语是在业务应用自身的 JVM 中初始化攻击者指定的、且已存在于应用 classpath 上的类。一旦该类的静态初始化行为具备副作用，攻击者即可在应用进程权限下执行任意代码，可能读取进程可访问的敏感数据、篡改业务数据、横向影响关联系统，或导致业务中断。</span></p><p><span>实际影响取决于应用运行账号权限、classpath 中的类构成以及连接配置是否可由外部影响，具体影响范围需结合目标应用环境评估。</span></p><h3 id=\"sec-3\"><span>处置优先级：高</span></h3><p><strong><span>漏洞类型：</span></strong><span>&nbsp;远程代码执行</span></p><p><strong><span>漏洞危害等级：</span></strong><span>&nbsp;高</span></p><p><strong><span>触发方式：</span></strong><span>&nbsp;网络远程</span></p><p><strong><span>权限认证要求：</span></strong><span>&nbsp;无需权限</span></p><p><strong><span>系统配置要求：</span></strong><span>&nbsp;需要特定配置</span></p><p><strong><span>用户交互要求：</span></strong><span>&nbsp;无需用户交互</span></p><p><strong><span>利用成熟度：</span></strong><span>&nbsp;POC 未公开</span></p><p><strong><span>修复复杂度：</span></strong><span>&nbsp;低，官方已提供修复方案</span></p><p><strong><span>影响版本</span></strong><span><span>&nbsp;Affects&nbsp;</span></span></p><p><strong><span>02</span></strong></p><p><span>redshift-jdbc42 &lt; 2.3.0</span></p><p><strong><span>解决方案</span></strong><span><span>&nbsp;Solution&nbsp;</span></span></p><p><strong><span>03</span></strong></p><h3 id=\"sec-4\"><span>升级修复方案</span></h3><p><span>建议升级至 2.3.0 或更高版本。AWS 安全公告 2026-168-AWS 将该问题评定为 Important，GitHub 安全公告同步公开了同一问题。修复版本可从 Maven Central 获取：</span></p><p><span><a href=\"https://central.sonatype.com/artifact/com.amazon.redshift/redshift-jdbc42/2.3.0\">https://central.sonatype.com/artifact/com.amazon.redshift/redshift-jdbc42/2.3.0</a></span></p><p><span>升级后应确认依赖树中不再包含旧版本驱动，并重新验证现有连接配置。</span></p><h3 id=\"sec-5\"><span>临时缓解方案</span></h3><ul><li><p><span>不要将外部输入直接拼接进数据库连接 URL，避免连接参数完全由用户控制。</span></p></li><li><p><span>对允许用户配置的连接参数名称与取值实施白名单校验，拒绝类加载相关参数。</span></p></li><li><p><span>精简应用 classpath 中非必要的依赖与组件，减少可被初始化的类。</span></p></li><li><p><span>对连接配置相关功能实施严格访问控制，并记录与审计相关操作。</span></p></li></ul><p><span>上述措施为临时缓解手段，可能影响业务功能，升级完成后应及时移除。</span></p><p><strong><span>漏洞复现</span></strong><span><span>&nbsp;Reproduction&nbsp;</span></span></p><p><strong><span>04</span></strong></p><p><span>长亭安全应急响应中心已完成复现验证。</span></p><p><img src=\"/dailyinfo/media/1b72344354cdbf9d.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>产品支持</span></strong><span><span>&nbsp;Support&nbsp;</span></span></p><p><strong><span>05</span></strong></p><p><span><span>全悉：</span></span><span><span>&nbsp;预计 2026.11.6 发布更新包支持该漏洞利用行为的检测</span></span></p><p><strong><span>时间线</span></strong><span><span>&nbsp;Timeline&nbsp;</span></span></p><p><strong><span>06</span></strong></p><p><span>2026 年 11 月 3 日 AWS 发布安全公告 2026-168-AWS</span></p><p><span>2026 年 11 月 6 日 长亭安全应急响应中心发布通告</span></p><h3 id=\"sec-6\"><span>参考资料</span></h3><p><span>[1]. <a href=\"https://aws.amazon.com/security/security-bulletins/2026-168-aws/\">https://aws.amazon.com/security/security-bulletins/2026-168-aws/</a></span></p><p><span>[2]. <a href=\"https://github.com/aws/amazon-redshift-jdbc-driver/security/advisories/GHSA-qrph-v96m-w2mv\">https://github.com/aws/amazon-redshift-jdbc-driver/security/advisories/GHSA-qrph-v96m-w2mv</a></span></p><p><span>[3]. <a href=\"https://www.cve.org/CVERecord?id=CVE-2026-119084\">https://www.cve.org/CVERecord?id=CVE-2026-119084</a></span></p><p><strong><span>长亭应急响应服务</span></strong></p><p><span>全力进行产品升级</span></p><p><span>及时将风险提示预案发送给客户</span></p><p><span>检测业务是否受到此次漏洞影响</span></p><p><span>请联系长亭应急服务团队</span></p><p><span>7*24小时，守护您的安全</span></p><p><span>第一时间找到我们：</span></p><p><span>邮箱：support@chaitin.com</span></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=fd16a9e9&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzIwMDk1MjMyMg%3D%3D%26mid%3D2247493507%26idx%3D1%26sn%3D861a2db2f4242498d7594b053eb06d50\">跳转微信打开</a></p>","original","zhKind","complete","漏洞","复现","补丁","漏洞分析","AWS","https://mp.weixin.qq.com/s?__biz=MzIwMDk1MjMyMg==&mid=2247493507&idx=1&sn=861a2db2f4242498d7594b053eb06d50","长亭安全应急响应中心",{"_111":112,"_113":-5},"changelogVersion","2026-10-01T08:00","release"]
