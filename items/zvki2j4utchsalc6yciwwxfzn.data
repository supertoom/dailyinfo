[{"_1":2,"_3":4},"root",{"_5":106},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795394446000,"id","zvki2j4utchsalc6yciwwxfzn","title","Signal 推出防护措施，阻止 Siri 与 Gemini 读取 iOS 27、Android 上的聊天内容","originalTitle","Signal to block Siri, Gemini AI from capturing chats on iOS, Android","summary","Signal 宣布新防护机制：在 iOS 27 上阻止截图，在受支持的 Android 设备上阻止 AI 助手读取 Signal 会话内容，防止内置的 Siri 与 Gemini 在代办任务时抓取私密对话。","reason","source",{"_75":105},"links",{"_61":104},"publishedAt","2026-11-22T15:15:25.000Z","discoveredAt","2026-11-22T15:59:15.538Z","timelineAt","category","blue-team","tags",[100,78,101,82,102,103],"score",62,"selected",false,"channel","news","story",{"_88":89,"_13":90},"x","readingMode","full","author","Bill Toulas","body",{"_96":-5,"_61":97,"_98":-5,"_99":36},"outline",[91],"relatedStories",[87],"topics",[68,69,70,71,72,73],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fOi1JsF_SiCg","reportCount",2,"additionalSourceCount",1,{"_74":85,"_75":86},{"_74":83,"_75":84},{"_74":81,"_75":82},{"_74":79,"_75":80},{"_74":77,"_75":78},{"_74":30,"_75":76},"slug","name","蓝队与运营","ai-security","AI 安全","ai-agent","AI Agent 安全","mobile","移动端","apple","Apple / 苹果","google","Google / 谷歌",{"_88":89,"_13":90},"publicId","aae0b52f-d7e1-4731-a260-ac5ba36ea7ba","Signal默认限制AI读取聊天屏幕",{"_11":92,"_93":94,"_95":65},"sec-1","text","Uncover email threats your existing defenses may miss.","level","zh","<p><img alt=\"Signal\" height=\"900\" src=\"/dailyinfo/media/eee9118a6429111d.jpg\" srcset=\"/dailyinfo/media/f8da3fefbd091e29.jpg 720w, /dailyinfo/media/2eb0eb709debdadf.jpg 1200w, /dailyinfo/media/eee9118a6429111d.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>Signal has announced new protections that block screenshots on iOS 27 and prevent AI assistants from capturing conversations on supported Android devices.</p><p>The protections are designed to stop Siri and Gemini, the AI assistants built into iOS and Android, from accessing private conversations while performing tasks for users.</p><p>The change comes after Signal <a href=\"https://www.bleepingcomputer.com/news/security/signal-now-blocks-microsoft-recall-screenshots-on-windows-11/\">introduced a feature in May 2025</a> that blocks Microsoft's controversial Recall screenshot-capturing feature on Windows 11.</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/bbd0383a4e0a5be0.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>\"We will now be taking similar measures to restrict agentic systems built into iOS 27 and on Android versions where we can detect an AI assistant attempting to read your Signal screen,\" Signal's president, Meredith Whittaker, said in a <a href=\"https://signal.org/blog/protecting-your-privacy/\">blog post</a>.</p><p>Whittaker says OS-level features such as Siri's Onscreen Awareness and Google's Gemini Intelligence can capture chat content as it appears on the app's screen, putting potentially sensitive private data outside Signal's control and exposing all conversation participants.</p><figure><img alt=\"Option to disable Siri screenshots on iOS\" height=\"430\" src=\"/dailyinfo/media/3ea1cd754b0b44d3.jpg\" loading=\"lazy\" decoding=\"async\" width=\"682\">\n<figcaption><strong>Option to block Siri scanning on Signal for iOS</strong><br>\n<em>Source: Signal</em></figcaption>\n</figure><p>Signal says its engineers spent months figuring out how AI systems access app data, designing targeted protections to block all extraction pathways verified through reverse engineering.</p><p>However, Signal warns that AI agents could still access conversations through other methods, which Whittaker describes as \"an existential threat to Signal.\"</p><p>She explains that AI agents could access conversation data in multiple ways, as they are now embedded deep in operating systems, leaving apps vulnerable and with limited options for protecting users.</p><p>The most notable example is macOS, where Signal says it's currently unable to provide any screenshot-blocking protection.</p><p>For macOS 27 users, Signal recommends adding the app to the Excluded Apps list under System Settings &gt; Siri to prevent Siri AI from proactively accessing message content.</p><p>For this reason, Signal calls on Apple, Google, and Microsoft to fully disclose, through detailed documentation, all potential access mechanisms and give app developers a clear way to opt out of AI access across screens, files, notifications, and APIs.</p><p>Signal did not provide specific app version numbers for the new protections but says they are automatically activated when possible.</p><p>Signal recommends that users upgrade to the latest available version and go to Settings &gt; App Security to check that Block Siri AI is enabled on iOS.</p><p>On Android, Signal says it automatically enables Screen Security when it detects an AI assistant attempting to access the screen.</p><p>However, on iOS, the protection also prevents users from taking screenshots of their Signal conversations, even for legitimate purposes.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/06fc6e977fae1ca4.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Uncover email threats your existing defenses may miss.</a>\n        </h2><p>Adaptive Security's AI agents analyze email intent, context, and behavior to uncover phishing, business email compromise, and invoice fraud.</p><p>See what's getting through with a 14-day read-only scan of Microsoft 365 or Google Workspace, with no MX changes.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Start your free email security scan.</a>\n    </p>","zhKind","complete","加固","大模型","Apple","Google","https://www.bleepingcomputer.com/news/security/signal-to-block-siri-gemini-ai-from-capturing-chats-on-ios-android/","BleepingComputer",{"_107":108,"_109":-5},"changelogVersion","2026-10-01T08:00","release"]
