[{"_1":2,"_3":4},"root",{"_5":94},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1794616829000,"id","j0h728hxubmy1jz17rm7oa7je","title","微步复现 7-Zip LZX 解码器远程代码执行漏洞 CVE-2026-125742","originalTitle","已复现！7-Zip LZX 解码器远程代码执行漏洞","summary","微步情报局已复现 7-Zip LZX 解码器远程代码执行漏洞 CVE-2026-125742。该漏洞影响 7-Zip 0<=version<26.06，位于多卷 CAB 归档的续卷解码流程；攻击者可构造特制归档诱导用户解压，通过堆越界写劫持控制流实现任意代码执行。","reason","原文还原了跨卷解码时窗口重分配与位置计数器不同步触发堆越界写的利用链，并给出 PoC 复现环境与升级前缓解措施。","source",{"_70":93},"links",{"_85":92},"publishedAt","2026-11-12T09:47:00.000Z","discoveredAt","2026-11-12T14:33:25.479Z","timelineAt","category","vuln","tags",[88,89,90,91],"score",75,"selected",true,"channel","news","story",{"_73":74,"_13":75},"x","readingMode","full","author","body",{"_61":84,"_85":-5,"_86":85,"_87":37},"outline",[76,77],"relatedStories",[72],"topics",[68],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","frs9bKvy81zc","reportCount",3,"additionalSourceCount",2,{"_69":31,"_70":71},"slug","name","漏洞披露",{"_73":74,"_13":75},"publicId","71e4085a-1256-4a35-8b56-f64a0dacdc95","7-Zip LZX堆越界写入漏洞已复现",{"_11":82,"_79":83,"_81":65},{"_11":78,"_79":80,"_81":65},"sec-2","text","临时缓解措施","level","sec-1","官方修复方案","<p><span>微步情报局</span> <span>2026-11-12 17:47</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/0ca776f023c607cf.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>点击查看漏洞情报详情</p><p><span><span>漏洞概况</span></span></p><p><span>7-Zip 是一款广受欢迎的开源文件压缩/解压缩工具，由 Igor Pavlov 开发维护，支持 7z、ZIP、CAB 等多种归档格式，广泛运行于 Windows、Linux 等多种操作系统。</span></p><p><span>近日，7-zip官方发布通告，修复了7-Zip LZX 解码器远程代码执行漏洞（CVE-2026-125742）。</span><span>微步情报局已成功复现该漏洞。</span><span>经分析，</span><span>该漏洞存在于多卷 CAB 归档的续卷解码流程中。当 LZX 解码器跨卷续接历史时，代码会根据新卷声明的字典位数重新分配解压窗口，并更新 _winSize；但位置计数器 _pos 未随之重置，仍保留上一卷大窗口下的值。由于边界检查采用无符号减法（outSize &gt; _winSize - _pos），当 _pos 大于缩小后的 _winSize 时，该表达式会下溢为一个极大值，导致正负判断结果的边界检查被绕过，造成堆越界写。</span></p><p><span>（完整漏洞情报请查阅<a href=\"https://x.threatbook.com/v5/vul/XVE-2026-93913%EF%BC%89\">https://x.threatbook.com/v5/vul/XVE-2026-93913）</a></span></p><p><span><span>攻击者可构造特制的多卷 CAB 归档，诱导用户使用受影响版本的 7-Zip 解压，通过精确控制越界写入内容覆盖堆上的对象虚表，进而劫持控制流实现任意代码执行。</span></span><span>建议受影响用户</span><span><span>尽快修复。</span></span></p><p><span><span>漏洞处置优先级(VPT)</span></span></p><p><strong><span>综合处置优先级：</span></strong><span><span>中风险</span></span></p><table><tbody><tr><td rowspan=\"3\"><p><span>基本信息</span></p></td><td><p><span>微步编号</span></p></td><td><p><span>XVE-2026-93913</span></p></td></tr><tr><td><p><span>CVE编号</span></p></td><td><p><span>CVE-2026-125742</span></p></td></tr><tr><td><p><span>漏洞类型</span></p></td><td><p><span>远程代码执行</span></p></td></tr><tr><td rowspan=\"5\"><p><span>利用条件评估</span></p></td><td><p><span>利用漏洞的网络条件</span></p></td><td><p><span>本地</span></p></td></tr><tr><td><p><span>是否需要绕过安全机制</span></p></td><td><p><span>否</span></p></td></tr><tr><td><p><span>对被攻击系统的要求</span></p></td><td><p><span>无特殊要求</span></p></td></tr><tr><td><p><span>利用漏洞的权限要求</span></p></td><td><p><span>无须用户权限</span></p></td></tr><tr><td><p><span>是否需要受害者配合</span></p></td><td><p><span>是</span></p></td></tr><tr><td rowspan=\"2\"><p><span>利用情报</span></p></td><td><p><span>是否有POC</span></p></td><td><span><span>是</span></span></td></tr><tr><td><p><span>已知利用行为</span></p></td><td><p><span>暂无</span></p></td></tr></tbody></table><p><span><span>漏洞影响范围</span></span></p><table><tbody><tr><td><p><span>产品名称</span></p></td><td><p><span>7-zip</span></p></td></tr><tr><td><p><span>受影响版本</span></p></td><td><p><span>0&lt;=version&lt;26.06</span></p></td></tr><tr><td><p><span>有无修复补丁</span></p></td><td><p><span>有</span></p></td></tr></tbody></table><p><span><span>漏洞复现</span></span></p><p><span>在已运行官方 7-Zip 26.05 的 Linux arm64 目标上执行 PoC，脚本针对 libc 基址 byte2 进行有限次重试，命中后进入多卷 CAB 触发流程，实现任意代码执行。</span></p><p><img src=\"/dailyinfo/media/de18b7b31abf16b4.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>修复方案</span></span></p><h3 id=\"sec-1\"><span>官方修复方案</span></h3><p><span>官方已发布修复方案，请访问链接下载：</span><span><br></span><span><a href=\"https://github.com/ip7z/7zip/releases/tag/26.06\">https://github.com/ip7z/7zip/releases/tag/26.06</a></span></p><h3 id=\"sec-2\"><span>临时缓解措施</span></h3><p><span>升级前，避免使用受影响版本的 7-Zip 解压不可信的多卷 CAB 归档。必要时仅在受控隔离环境中解压。</span></p><p><span><span>微步产品支撑</span></span></p><p><span>微步漏洞情报于</span><span><span>2026-11-10</span></span><span>收录该漏洞。</span></p><p><span>微步下一代威胁情报平台NGTIP及X情报中心已于漏洞收录时向漏洞订阅用户推送该漏洞情报，并将持续推送后续更新；对于已经录入资产的用户，支持实时自动化排查受影响资产。</span></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=f5ef2239&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzg5MTc3ODY4Mw%3D%3D%26mid%3D2247509041%26idx%3D1%26sn%3Dd6e387eacb4bd1900b1f3c36100a3b3f\">跳转微信打开</a></p>","original","zhKind","complete","漏洞","复现","漏洞利用","补丁","https://mp.weixin.qq.com/s?__biz=Mzg5MTc3ODY4Mw==&mid=2247509041&idx=1&sn=d6e387eacb4bd1900b1f3c36100a3b3f","微步在线研究响应中心",{"_95":96,"_97":-5},"changelogVersion","2026-10-01T08:00","release"]
