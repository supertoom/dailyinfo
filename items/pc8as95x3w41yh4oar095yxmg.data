[{"_1":2,"_3":4},"root",{"_5":94},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1794616832000,"id","pc8as95x3w41yh4oar095yxmg","title","Operation Endgame 关闭 Gootloader、CastleRAT 和 StealC 基础设施，查获 6.4M 组失窃登录凭据","originalTitle","Operation Endgame Takes Down Gootloader, CastleRAT and StealC Servers, Seizes 6.4M Stolen Logins","summary","Operation Endgame 已关闭 Gootloader、CastleRAT 和 StealC 相关基础设施，共查获 235 台服务器、257 个域名及约 6.4 million 组失窃登录凭据，涉及超过 40,000 名受害者。","reason","材料呈现了跨区域执法行动如何同时关闭恶意软件基础设施、查扣失窃凭据并开展受害者通知，适合用于评估类似多阶段攻击的处置范围。","source",{"_67":93},"links",{"_84":92},"publishedAt","2026-11-13T10:55:03.000Z","discoveredAt","2026-11-13T12:16:25.168Z","timelineAt","category","activity","tags",[70,68,88,89,90,91],"score",88,"selected",true,"channel","news","story","x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_59":83,"_84":-5,"_85":86,"_87":37},"outline",[77],"relatedStories",[],"topics",[60,61,62,63,64],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_65":75,"_67":76},{"_65":73,"_67":74},{"_65":71,"_67":72},{"_65":69,"_67":70},{"_65":66,"_67":68},"slug","malware","name","恶意软件","attack","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","identity","身份与访问",{"_11":78,"_79":80,"_81":82},"sec-1","text","受害者与网站所有者可以采取的措施","level",3,"<p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjsu6ZFyYFr1dxp2XHIaG_pyTwkoH58ICgyXLuTthkuYSJVcqAwX_O_bEJYfheyxpYmI7nnok1xrj97q7s-9l8JHFt1ogBAOJAEUqM8_vf6H3a8eYPKzB34d6XrvnkRu8zGaoKMgSJqWsE6u2zYXLdJKTtcDvk3beN6_o40ygJ4MVSMomS3Q1aEFV_jSq8/s1600/gootloader.jpg\"><img alt=\"\" src=\"/dailyinfo/media/6e583ccce6945384.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>本周，国际警方联合行动接管了 <strong>Gootloader</strong>、<strong>CastleRAT </strong>和 <strong>StealC </strong>背后的服务器。罪犯利用这三种恶意软件工具入侵计算机、窃取密码并发动勒索软件攻击。</p><p>据德国联邦刑事警察局（BKA）称，警方还查获了约 640 万个被盗登录凭据，涉及超过 40,000 名受害者。</p><p><strong>Gootloader </strong>是一种加载器：一旦安装到计算机上，就能下载其他恶意软件，尤其是勒索软件。它通过入侵网站上的虚假法律文件传播，这些网站通常是 WordPress 网站。罪犯利用 SEO 投毒，将这些网站推送到搜索结果的高位。</p><p>美国司法部表示，自 2018 年以来，Gootloader 已感染全球至少 25,000 台计算机。其运营者利用这些计算机感染更多计算机，随后将新感染计算机的访问权限出售给勒索软件罪犯。在美国，Gootloader 被用于针对至少 44 名受害者的勒索软件攻击，造成约 28.8 million 美元损失。</p><p>德国警方在其<a href=\"https://www.presseportal.de/blaulicht/pm/7/6389442\">德文声明</a>中给出了高得多的数字。根据调查人员目前掌握的情况，自 Gootloader 于 2020 年首次出现以来，已感染全球数百万台计算机。</p><p>据支持此次行动的欧洲刑警组织提供的<a href=\"https://www.europol.europa.eu/media-press/newsroom/news/64-million-victim-datasets-secured-in-international-operation-against-malware-networks\">行动摘要</a>，针对这三种工具，警方共查扣了 235 台服务器和 257 个域名。此次接管是 Operation Endgame 的一部分，这是一项国际警方针对恶意软件罪犯的行动，这些罪犯利用恶意软件访问受害者的计算机。</p><p>针对 Gootloader，警方接管了 14 台服务器和 218 个域名，并从 681 个被入侵的网站中移除了恶意软件。</p><p>经法院批准，美国机构及其国际合作伙伴从 100 多台服务器中移除了 Gootloader，其中包括被入侵的 WordPress 网站。根据<a href=\"https://www.justice.gov/opa/pr/gootloader-malware-disrupted-international-cyber-operation\">司法部公告</a>，他们还查扣了用于投递和控制该恶意软件的美国域名。</p><p><strong>CastleRAT</strong>是一种自 2025 年起为人所知的远程访问木马（RAT），允许攻击者远程控制受感染的计算机。警方查扣了它的 120 台服务器和 39 个域名。</p><p><strong>StealC </strong>是一种信息窃取器，可从受感染的计算机中外传密码和其他登录凭据，使罪犯能够出售或滥用这些凭据。在警方针对它展开<a href=\"https://thehackernews.com/2026/06/amadey-and-stealc-malware-network.html\">6 月行动</a>后，本周警方再次接管了它的服务器。</p><p>德国警方表示，在那次 6 月行动后，其运营者更换了基础设施，并使其重新上线，以躲避调查人员。StealC 的一些关键基础设施运行在 Virtualine/Omegatech 上，这是一家向罪犯宣传其服务的防弹托管服务商。</p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhel7C_vWFAG-KzikB9zCuLgWnNKBd3IGaykyZ0H-WoEx0p-1bi64zTuDDzJedoULrYWfYiS6_MdLjy-uCLPpbdO8d9bOyRkgj2kdedgZvWcfPRZ2ynxwaxpDAU1KOu8JTnYjKRyFDNyIzf1k9cXa_gUEplscrEL9qq8M6RRdJWCGz9oKb6MEpgteYMOuc/s1600/goot.png\"><img alt=\"\" src=\"/dailyinfo/media/885a4a08cba7a8ae.webp\" loading=\"lazy\" decoding=\"async\"></a></p><p>警方在一次<a href=\"https://thehackernews.com/2026/10/fbi-seizes-virtualine-domain-over.html\">10 月下旬的接管行动</a>中关闭了该托管服务。</p><p>本周的行动未宣布任何逮捕。据荷兰警方的<a href=\"https://www.politie.nl/en/news/2026/november/international-action-disables-cybercriminal-network.html\">新闻稿</a>，荷兰警方还针对 Gootloader 的主要嫌疑人开展了进一步调查。</p><h3 id=\"sec-1\">受害者与网站所有者可以采取的措施</h3><p>荷兰警方已将 CastleRAT 窃取的数据上传至<a href=\"https://www.politie.nl/en/information/checkyourhack.html\">Check your hack</a>，这是警方提供的一项服务，人们可以在其中输入电子邮件地址。如果该地址存在于数据中，警方会在几分钟内发送一封邮件，提供移除恶意软件的步骤。如果不存在，则不会收到邮件。</p><p>未来几周还会增加更多数据。该服务检查的是单个地址，而非整个域名；但各机构可以加入 No More Leaks，这是一项警方项目，会与私营合作伙伴共享数据。失窃数据也会与包括 Have I Been Pwned 和 Shadowserver Foundation 在内的服务共享。</p><p>声称来自警方并要求人们检查数据的电子邮件都是伪造的。警方从不发送带链接的电子邮件。</p><p>警方称，即使警方查扣了这些数据，犯罪分子仍可能拥有被盗的登录凭据，详情见其<a href=\"https://www.politie.nl/en/information/frequently-asked-questions-about-check-your-hack.html\">常见问题</a>。只要恶意软件仍留在计算机上，犯罪分子就可能继续获取其中的密码。</p><p>美国司法部表示，Shadowserver Foundation 正与互联网服务提供商和计算机安全事件响应团队（CSIRTs）合作，寻找受感染的计算机并通知其所有者。据 BKA 介绍，在德国，联邦信息安全办公室（BSI）正协助通知受害者。</p><p>丹麦国家特别犯罪调查部门（NSK）协助清理了这 681 个网站。该部门在一份<a href=\"https://politi.dk/national-enhed-for-saerlig-kriminalitet/nyhedsliste/skadelig-kode-fjernet-fra-over-600-hjemmesider/2026/11/12\">丹麦语声明</a>中表示 believes，攻击者是通过犯罪渠道获得被盗密码后入侵这些网站的，随后安装了后门。</p><p>执法人员移除了攻击者的代码和访问权限，并给网站所有者留言，建议如何保护其网站安全。</p><p>丹麦和荷兰的警方建议 WordPress 网站所有者采取以下措施，其中若干措施列于一份<a href=\"https://www.politie.nl/binaries/content/assets/politie/nieuws/2026/november/67e23014-cf5f-4970-be59-aeff916c15f1.pdf\">荷兰语指南</a>：</p><ul>\n  <li>将所有管理员密码更改为各不相同、长度至少为 12 个字符的密码。</li>\n  <li>启用多因素身份验证（MFA）。</li>\n  <li>删除你不认识的账户。</li>\n  <li>从网站中删除所有后门代码。</li>\n  <li>更新 WordPress、其主题及其插件。</li>\n  <li>仅允许从你自己设备的 IP 地址访问 /wp-admin 登录页面。</li>\n</ul><p>觉得这篇文章有意思？在 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a> 上关注我们，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","勒索","数据窃取","后门","凭据","https://thehackernews.com/2026/11/operation-endgame-takes-down-gootloader.html","The Hacker News",{"_95":96,"_97":-5},"changelogVersion","2026-10-01T08:00","release"]
