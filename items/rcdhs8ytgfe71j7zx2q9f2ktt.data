[{"_1":2,"_3":4},"root",{"_5":199},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795308039000,"id","rcdhs8ytgfe71j7zx2q9f2ktt","title","Rapid7 发现暴露的 Ollama 服务器已被第三方租用和控制","originalTitle","Open by Default, Already Occupied: Threat Actors are Renting your Compute","summary","Rapid7 对 20,354 个预选 IPv4 地址的快照分析显示，过滤疑似诱捕基础设施后，仍有 7,627 台主机在未认证状态下响应 AI 或 Notebook API，其中 7,675 个 Ollama 发现项经校正后成立，54.8% 的 Ollama 主机带有第三方活动痕迹。","reason","文章用单次扫描和模型清单还原第三方占用计算资源的手法，并区分暴露面与真实活动，为排查 AI 服务失陷提供了可操作线索。","source",{"_75":198},"links",{"_186":197},"publishedAt","2026-11-18T14:38:55.000Z","discoveredAt","2026-11-18T15:42:35.270Z","timelineAt","category","ai-security","tags",[76,78,82,80,190,191,192,193,194,195,196],"score",70,"selected",true,"channel","news","story",{"_88":89,"_13":90},"x","readingMode","full","author","Christiaan Beek","body",{"_61":185,"_186":-5,"_187":188,"_189":37},"outline",[91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120],"relatedStories",[87],"topics",[68,69,70,71,72,73],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fBsJue5e08dY","reportCount",1,"additionalSourceCount",0,{"_74":85,"_75":86},{"_74":83,"_75":84},{"_74":81,"_75":82},{"_74":79,"_75":80},{"_74":77,"_75":78},{"_74":31,"_75":76},"slug","name","AI 安全","research","技术研究","attack","攻击活动","exploited","在野利用","supply-chain","供应链安全","rapid7","Rapid7 / Metasploit",{"_88":89,"_13":90},"publicId","8e842634-88b8-4341-91b8-8f342b878791","Rapid7发现暴露Ollama多被第三方占用",{"_11":183,"_122":184,"_124":125},{"_11":181,"_122":182,"_124":130},{"_11":179,"_122":180,"_124":125},{"_11":177,"_122":178,"_124":130},{"_11":175,"_122":176,"_124":130},{"_11":173,"_122":174,"_124":130},{"_11":171,"_122":172,"_124":125},{"_11":169,"_122":170,"_124":130},{"_11":167,"_122":168,"_124":130},{"_11":165,"_122":166,"_124":130},{"_11":163,"_122":164,"_124":130},{"_11":161,"_122":162,"_124":125},{"_11":159,"_122":160,"_124":130},{"_11":157,"_122":158,"_124":130},{"_11":155,"_122":156,"_124":130},{"_11":153,"_122":154,"_124":130},{"_11":151,"_122":152,"_124":130},{"_11":149,"_122":150,"_124":130},{"_11":147,"_122":148,"_124":130},{"_11":145,"_122":146,"_124":125},{"_11":143,"_122":144,"_124":130},{"_11":141,"_122":142,"_124":130},{"_11":139,"_122":140,"_124":130},{"_11":137,"_122":138,"_124":130},{"_11":135,"_122":136,"_124":125},{"_11":133,"_122":134,"_124":130},{"_11":131,"_122":132,"_124":130},{"_11":128,"_122":129,"_124":130},{"_11":126,"_122":127,"_124":125},{"_11":121,"_122":123,"_124":125},"sec-30","text","文章标签","level",2,"sec-29","方法与局限性","sec-28","本季度：让归属管理成为默认要求",3,"sec-27","30 天内：先关上门，再关上窗","sec-26","本周：找出它们，并检查是否有访客","sec-25","企业应采取的措施","sec-24","互联网测量数据受到污染，我们应当明确指出这一点。","sec-23","这里的攻击者并不需要 AI。","sec-22","模型运行时正在成为凭据代理。","sec-21","暴露面研究需要提出第二个问题。","sec-20","看到这些数据后，我会做哪些改变","sec-19","模型名称中最常出现的回调注册表","sec-18","嵌入第三方模型名称中的时间戳","sec-17","没有人查看模型列表","sec-16","按用途分类的已解码文件目标","sec-15","他们试图获取什么","sec-14","模型列表如何成为攻击面","sec-13","暴露的 Ollama 服务器上存在第三方活动的迹象","sec-12","访客日志","sec-11","暴露主机上的模型规模","sec-10","护栏是可选的，前门也是","sec-9","这台机器正在成为网关","sec-8","按系列划分的本地模型与云端路由模型","sec-7","实际运行的内容","sec-6","所有服务的主要网络","sec-5","各国暴露的 Ollama","sec-4","暴露的 AI 服务分布在哪里","sec-3","这是租用的计算资源，而非企业数据中心","sec-2","扫描器标记的结果与经得起推敲的结果","sec-1","首先，有一个我并不信任的数字","<figure><p>$ curl http://&lt;exposed-host&gt;:11434<strong>/api/tags</strong></p><p><span>llama3.1:8b</span><span>qwen3.6:27b</span><span>glm-5.3:cloud</span><span>nomic-embed-text:latest</span><span>deepseek-v4-pro:cloud</span><span>103.249.201[.]108:9882/trigger/benign:latest</span><span>gemma4:e4b</span><span>zzvitals-beacon:latest</span><span>huihui_ai/Qwen3.8-abliterated:latest</span><span>gpt-4o:latest</span><span>claude-3-opus:latest</span><span>tinyllama:latest</span><span>kimi-k2.7-code:cloud</span><span>verif_sys:latest</span><span>&lt;tunnel&gt;.trycloudflare[.]com/read/x5fa4534:b1</span><span>qwen2.5-coder:7b</span><span>pwn_ctl_&lt;this-host-ip&gt;_ae52…:latest</span><span>minimax-m3:cloud</span><span>ttl[.]sh/dsv40110/dsv4probe:24h</span><span>bge-m3:latest</span><span>&lt;tunnel&gt;/L2V0Yy9zaGFkb3c → /etc/shadow</span><span>Huihui-CyberStrike-OffSec-35B-abliterated</span><span>smollm2:135m</span><span>ops-verify:latest</span><span>mistral-large-4:cloud</span><span>&lt;tunnel&gt;/L3Byb2Mvc2VsZi9lbnZpcm9u → /proc/self/environ</span><span>qwen3-embedding:0.6b</span><span>gpt-4o:latest-copy-test</span></p><p><span><i></i>本地模型</span><span><i></i>云端路由或无审查模型</span><span><i></i>由第三方留下</span></p><figcaption>暴露的 Ollama 服务器返回的模型名称样本。绿色：由第三方留下；带轮廓线：云端路由或无审查模型。主机标识信息已隐去，基础设施已去混淆处理。</figcaption></figure><p>在此次扫描发现的暴露 Ollama 服务器中，超过一半已经被所有者之外的人接触过。我说的不是理论上存在漏洞，而是实际可见的使用痕迹：作为回调地址的模型名称、盖有服务器自身 IP 的标签，以及解码后为 <code>/etc/shadow</code> 的 Base64 字符串。</p><p>暴露统计数据通常描述的是风险。这些模型列表描述的却是实际活动。未经身份验证的 <code>/api/tags</code> 调用是一个只读请求，而在数千台机器上，它会返回一份接近访客日志的内容。</p><p>下面是数据所呈现的情况、我认为它指向何处，以及我会在周一早上采取什么措施。我将各项主张标注为 <span>[观察到]</span>、<span>[解读]</span>或 <span>[假设]</span>，以便你看出证据在哪里戛然而止。</p><h2 id=\"sec-1\">首先，有一个我并不信任的数字</h2><p>扫描器报告了 11,891 个 IP 地址上的 14,064 项发现，并将其中 14,060 项标记为易受攻击，387 项为严重。如果把它写进标题会很吸引眼球，但那也会是错误的。</p><p><span>[观察到]</span> 有 148 个 IP 地址返回完全相同的指纹：3000 端口上的 Grafana、8888 端口上的 Jupyter，以及三个端口上的 Ollama，每个都提供一个模型，<code>llama3.1:8b</code>。它们分布在五个国家的五家不同托管服务商处。另有 281 个地址在同一端口上以两到五种不同产品作出响应。真实服务器很少会这样，传感器和兜底响应器却天天如此。</p><p><span>[解读]</span> 这些极有可能是欺骗基础设施，由研究人员、厂商或威胁行为者运营，用来观察谁会上门。排除这 429 个地址后，严重发现数从 387 项降至 39 项。MLflow 从 126 项降至 4 项。蜜罐看起来极度易受攻击，这正是它们的全部工作内容。</p><figure><p><span>图 1</span></p><h3 id=\"sec-2\">扫描器标记的结果与经得起推敲的结果</h3><p>移除由 148 台主机组成的相同机群，以及以多种产品响应同一 IP:端口组合的地址前后，各产品的发现数。</p><p><span>Ollama</span></p><p><i></i><b>标记了 8,193 项</b></p><p><i></i><b>经得起推敲的有 7,675 项</b></p><p><span>Streamlit</span></p><p><i></i><b>标记了 4,939 项</b></p><p><i></i><b>经得起推敲的有 4,700 项</b></p><p><span>Grafana</span></p><p><i></i><b>标记了 475 项</b></p><p><i></i><b>123 暂缓</b></p><p><span>Jupyter Notebook</span></p><p><i></i><b>265 已标记</b></p><p><i></i><b>38 暂缓</b></p><p><span>MLflow</span></p><p><i></i><b>126 已标记</b></p><p><i></i><b>4 暂缓</b></p><p><span>JupyterHub</span></p><p><i></i><b>66 已标记</b></p><p><i></i><b>11 暂缓</b></p><figcaption>Streamlit、Grafana 和 JupyterHub 的结果属于存在性检查（健康端点会响应）。它们能证明暴露情况，但不能证明系统已被攻破。Grafana 上的默认凭据标签是扫描器推断的，并非经过实际测试。</figcaption></figure><p>在继续之前，再作两点更正。Streamlit 健康检查返回 <code>ok</code> 只能说明某个应用已暴露在互联网上，并不能说明它可被利用。而且，目标列表是预先选定的：20,354 台主机中有 58% 产生了发现项，这一比例远高于任何全互联网基准比率。因此，应将这些总数视为规模大得多总体中的一个样本，而不是普查结果。</p><p>仍然令人不安的情况是：<strong>在 7,627 台主机上发现 7,714 个问题，其中 AI 或 Notebook API 在无需身份验证的情况下即可响应</strong>，而且几乎全部与 Ollama 有关。在所有发现项中，只有 0.3% 通过 HTTPS 提供服务。</p><p>对于任何统计暴露数量的人，包括我们自己，这条经验教训是：如果你统计的是横幅信息和健康检查，你测量的只是互联网如何呈现自己，而不是它如何运行。</p><h2 id=\"sec-3\">这是租用的计算资源，而非企业数据中心</h2><figure><p><span>图 2</span></p><h3 id=\"sec-4\">暴露的 AI 服务分布在哪里</h3><p>完整过滤后样本：115 个国家中的 11,676 台主机。可用的底图展示了 109 个国家中的 11,158 台主机；另有 6 个国家的 518 台主机未被表示。国家阴影表示主机数量；圆点表示城市级位置，大小对应发现项数量。</p><p><img alt=\"World map of exposed AI service hosts by country, with city-level service locations\" width=\"960\" height=\"470\" src=\"/dailyinfo/media/0e2babe5d74efe04.jpg\" srcset=\"/dailyinfo/media/d250dd95cbe9f098.jpg 720w, /dailyinfo/media/2a88033d4b6f861a.jpg 1200w, /dailyinfo/media/0e2babe5d74efe04.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>0</span><i></i><i></i><i></i><i></i><i></i><i></i><span>1,000+</span></span><span><i></i>大多数为 Ollama</span><span><i></i>大多数为其他服务</span></p><figcaption>地理位置：DB-IP Lite（国家，CC BY 4.0）和 MaxMind GeoLite2（城市）。IP 地理位置描述的是地址注册或路由的位置，不一定是所有者所在的位置。</figcaption></figure><p><span>[观察]</span> 大约 65% 的主机位于托管或云网络中，且六家提供商（OVHcloud、Hetzner、Contabo、Oracle Cloud、Tencent Cloud 和 DigitalOcean）占全部目标的 42%。这些目标分布在 1,656 个网络中，但集中在那些五分钟内就能租到一台高配服务器的地方。</p><p><span>[解读]</span> 在暴露的 Ollama 中，德国居首（1,306 台主机），领先于中国和美国。我不认为这意味着德国人粗心大意。Hetzner 和 Contabo 来自德国，OVH 在欧洲拥有广泛布局，而这三家都是那些想在这个下午就试用某个模型、无需走采购流程的人的首选。地理位置取决于价格表。</p><figure><p><span>图 3</span></p><h3 id=\"sec-5\">各国暴露的 Ollama</h3><p><span>德国</span><b>1,306</b></p><p><span>中国</span><b>1,130</b></p><p><span>美国</span><b>1,097</b></p><p><span>法国</span><b>549</b></p><p><span>印度</span><b>301</b></p><p><span>加拿大</span><b>293</b></p><p><span>英国</span><b>290</b></p><p><span>韩国</span><b>275</b></p><p><span>芬兰</span><b>206</b></p><p><span>新加坡</span><b>180</b></p></figure><figure><p><span>图 4</span></p><h3 id=\"sec-6\">所有服务的主要网络</h3><p><span>OVHcloud</span><b>908</b></p><p><span>Hetzner</span><b>882</b></p><p><span>Contabo</span><b>866</b></p><p><span>Oracle Cloud</span><b>852</b></p><p><span>Tencent Cloud</span><b>709</b></p><p><span>DigitalOcean</span><b>644</b></p><p><span>Google Cloud</span><b>289</b></p><p><span>Korea Telecom</span><b>225</b></p><p><span>Microsoft</span><b>219</b></p><p><span>IONOS</span><b>183</b></p></figure><p><span>[解读]</span> 此类机器很少出现在 CMDB 中。通常是某个团队需要快速进行计算，便用信用卡租用，之后再连接到公司数据。现在，你的攻击面还包括了开发人员的费用报销单。</p><h2 id=\"sec-7\">实际运行的内容</h2><p><span>[观察]</span> 已暴露的 Ollama 服务器列出了 106,938 个模型条目、18,733 个不同标签，平均每台主机约 14 个。在本地模型中，Qwen 占据主导，其次是 Llama 和 Gemma。但更重要的区分在于运行在机器上的模型与机器仅负责<em>路由</em>的模型。</p><figure><p><span>图 5</span></p><h3 id=\"sec-8\">按系列划分的本地模型与云端路由模型</h3><p>至少列出一个系列模型的已暴露 Ollama 主机数量。已排除第三方标记模型。</p><p><span>在本地运行的主机</span><span>将其列为 :cloud 模型的主机</span></p><p><span><b>4,630</b><i></i></span><em>Qwen (Alibaba)</em><span><i></i><b>218</b></span></p><p><span><b>3,349</b><i></i></span><em>Llama (Meta)</em><span><i></i><b>1</b></span></p><p><span><b>1,917</b><i></i></span><em>Gemma (Google)</em><span><i></i><b>150</b></span></p><p><span><b>862</b><i></i></span><em>DeepSeek</em><span><i></i><b>4,981</b></span></p><p><span><b>852</b><i></i></span><em>GLM (Zhipu)</em><span><i></i><b>5,720</b></span></p><p><span><b>3</b><i></i></span><em>MiniMax</em><span><i></i><b>4,935</b></span></p><p><span><b>12</b><i></i></span><em>Kimi (Moonshot)</em><span><i></i><b>2,462</b></span></p><p><span><b>643</b><i></i></span><em>Mistral</em><span><i></i><b>2,571</b></span></p><p><span><b>382</b><i></i></span><em>gpt-oss (OpenAI)</em><span><i></i><b>220</b></span></p><p><span><b>335</b><i></i></span><em>Phi (Microsoft)</em><span><b>N/A</b></span></p><p><span><b>2,020</b><i></i></span><em>Embeddings</em><span><b>N/A</b></span></p><p><span><b>546</b><i></i></span><em>图像/视觉</em><span><b>N/A</b></span></p><figcaption>根据模型名称模式分配系列。另有约 3,459 台主机列出了无法映射到已知系列的云标签。</figcaption></figure><h3 id=\"sec-9\">这台机器正在成为网关</h3><p><span>[观察]</span> 79% 的已暴露 Ollama 主机至少列出一个 <code>:cloud</code> 模型，主要是 GLM、DeepSeek、MiniMax 和 Kimi 的各个变种。当主机已使用 <code>ollama signin</code> 登录时，Ollama 的混合模式会将这些请求通过本地守护进程路由至 ollama.com，从而将 <code>~/.ollama/id_ed25519</code> 中的本地 ed25519 密钥与用户账户关联起来。</p><p><span>[解读]</span> 一台已暴露且处于登录状态的服务器，可以让他人访问你的付费订阅，而账单则由订阅所有者承担。这是自托管版本的 LLMjacking，完全不需要任何漏洞利用。</p><p><span>[假设]</span> 列出的云标签并不能证明主机已登录，而且我们没有测试推理。不过，同样的七种云模型共同出现在 1,295 台互不相关的主机上。这一模式看起来更像是第三方自动拉取模型，以检查哪些服务器会为其提供服务，而不像数千次独立选择。</p><h3 id=\"sec-10\">护栏是可选的，前门也是</h3><p><span>[观察]</span> 28% 的已暴露 Ollama 主机至少搭载了一个“abliterated”、“heretic”或“uncensored”模型，即刻意移除了拒绝行为的版本，其中包括一个以进攻性安全工作命名的微调模型。运行这些模型是合法的，而且通常有充分的研究理由。但若在互联网上未经认证地运行，任何人都能使用你的硬件上未经日志记录、未经筛选的模型。</p><p><span>[已观察到]</span> 另有 28% 会运行嵌入模型，例如 <code>nomic-embed-text</code> 或 <code>bge-m3</code>。<span>[解读]</span> 嵌入模型是检索增强生成的基础设施。这些服务器很可能接入了读取内部文档的流水线，因此暴露的主机是一座桥，而不是一座孤岛。</p><figure><p><span>图 6</span></p><h3 id=\"sec-11\">暴露主机上的模型规模</h3><p>名称中包含参数量的本地模型标签。其中大多数足够小，可以运行在租赁的 VPS 上。</p><p><span>&lt;2B</span><b>3,967 个标签</b></p><p><span>2–9B</span><b>7,705 个标签</b></p><p><span>10–34B</span><b>5,929 个标签</b></p><p><span>35–99B</span><b>845 个标签</b></p><p><span>100B+</span><b>143 个标签</b></p><figcaption>最常见的两个低于 2B 的标签 <code>tinyllama</code>（1,671 台主机）和 <code>smollm2:135m</code>（1,169 台主机），也是测试能否写入他人服务器时成本最低的目标。</figcaption></figure><h2 id=\"sec-12\">访客日志</h2><p>我认为最值得关注的发现如下。Ollama 的 API 允许任何调用者从任意注册表拉取模型、复制或创建模型，并将其推送到其他位置。在没有身份验证的情况下，模型列表就成了一份记录， 显示陌生人都曾要求服务器执行什么。</p><figure><p><span>图 7</span></p><h3 id=\"sec-13\">暴露的 Ollama 服务器上存在第三方活动的迹象</h3><p>在 7,675 台暴露的 Ollama 服务器中，模型列表包含各类工件的服务器占比。一台主机可能同时显示多种工件。</p><p><span>任何第三方工件</span><b>54.8%（4,209）</b></p><p><span>标记／“我来过”模型</span><b>40.3%（3,091）</b></p><p><span>从非官方注册表拉取</span><b>34.7%（2,666）</b></p><p><span>……从原始 IP:端口拉取</span><b>23.7%（1,817）</b></p><p><span>……通过免费隧道或临时注册表拉取</span><b>22.4%（1,721）</b></p><p><span>gpt-4o / claude-3-opus 别名</span><b>15.5%（1,190）</b></p><p><span>经过编码的文件路径载荷</span><b>0.7%（55）</b></p><figcaption>基于名称的指标。标记包括 beacon、verify、probe 和 pwn 风格的名称，以及嵌有主机自身 IP 的标签；外部拉取则是以非官方注册表主机为前缀的模型名称。</figcaption></figure><p><span>[已观察到]</span> 24% 的主机列出了从原始 IP 地址和端口拉取的模型。22% 列出了通过免费隧道或一次性注册表服务拉取的模型：Cloudflare quick tunnels、ttl.sh、bore.pub、Pinggy。当服务器从你控制的地址拉取模型时，它就会回调你。这是一种干净且可靠的方法，可确认目标可达、可写并且能够建立出站连接：典型的服务器端请求伪造，却被作为一项功能提供。</p><p><span>[已观察到]</span> 有 712 个模型名称嵌入了其所在服务器的 IP 地址。<span>[解读]</span> 这是在进行资产盘点。有人正在给目标添加标签，以便其工具稍后能够识别它们。同样适用于反复出现的标记，例如 <code>zzvitals-beacon</code>、<code>verif_sys</code> 和 <code>ops-verify</code>，每个都出现在数百台主机上；也适用于以 <code>-copy-test</code> 结尾的名称，这些名称表明有人正在检查复制端点是否正常工作。</p><p><span>[假设]</span> <code>gpt-4o</code>、<code>gpt-4</code> 和 <code>claude-3-opus</code> 这组三元标记同时出现在 1,190 台主机上，而且几乎总是紧挨着 <code>tinyllama</code>，看起来像是以高级名称复制的小型本地模型。这要么是一次写入测试，要么是一种让服务器在下一个发现它的人看来像是提供了前沿模型的方法。我不敢断言是哪一种。</p><figure><p><span>图 8</span></p><h3 id=\"sec-14\">模型列表如何成为攻击面</h3><ol><li><span>1</span><b>Find</b><p>大规模扫描 11434 等端口。没有身份验证需要绕过。</p></li><li><span>2</span><b>List</b><p><code>/api/tags</code> 会暴露模型、云路由和先前的访客。</p></li><li><span>3</span><b>Call back</b><p>从你控制的 IP 或隧道拉取。拉取操作可确认可达性和出站访问能力。</p></li><li><span>4</span><b>Mark</b><p>创建或复制一个以主机命名的模型。这既能证明写入权限，也相当于宣示主权。</p></li><li><span>5</span><b>Reach</b><p>构造指向本地文件、机密和密钥的清单，或者利用所有者的云账户。</p></li></ol><figcaption>根据模型列表中的痕迹重建的序列。并非每台主机都显示每个阶段。</figcaption></figure><h3 id=\"sec-15\">他们试图获取什么</h3><p><span>[观察到的]</span>在 55 台主机上，模型名称包含可解码为文件路径的 Base64 或十六进制字符串。目标读起来像一份漏洞利用后的检查清单：<code>/etc/shadow</code>、<code>/etc/passwd</code>、<code>/proc/self/environ</code>、Ollama 自身的 systemd 单元及其 <code>override.conf</code>（人们往往会在那里放置环境变量和 API 密钥）、SSH <code>authorized_keys</code>、AWS 配置、Oracle Cloud 元数据端点；在 10 台主机上，还包括 Ollama 私钥本身。有几个目标指向 <code>/etc/ld.so.preload</code> 和新的 systemd 服务文件，这些是持久化位置，而非读取材料。</p><figure><p><span>图 9</span></p><h3 id=\"sec-16\">按用途分类的已解码文件目标</h3><p>每个类别中至少包含一条编码路径的主机。</p><p><span>主机指纹识别</span><b>47 台主机</b></p><p><span>环境变量／服务配置中的机密</span><b>28 台主机</b></p><p><span>凭据和密钥</span><b>15 台主机</b></p><p><span>持久化路径</span><b>11 台主机</b></p><p><span>云元数据端点</span><b>1 台主机</b></p></figure><p><span>[解释]</span>这与 Wiz 于 2024 年发布的 Probllama（CVE-2024-37032）技术相似：在模型清单的摘要字段中利用路径遍历载荷，通过 <code>/api/pull</code> 实现任意文件写入，通过 <code>/api/push</code> 实现文件读取，并通过破坏 <code>/etc/ld.so.preload</code> 实现代码执行。Ollama 于 2024 年 5 月在 0.1.34 版本中修复了该漏洞。我们无法从这些列表中判断任何目标是否仍运行易受攻击的构建版本，因此这些尝试只能证明意图，而不能证明成功。两年半后仍有人认为值得尝试，这表明该技术依然足够有用，值得继续测试。</p><p>其经济账不容忽视。攻击者使用免费隧道、免费的临时注册表，最终还会利用你的计算机和你的云订阅。每个目标的成本算下来接近于零。</p><h3 id=\"sec-17\">没有人查看模型列表</h3><figure><p><span>图 10</span></p><h3 id=\"sec-18\">嵌入第三方模型名称中的时间戳</h3><p>按创建月份统计的标记和探测名称中发现的 Unix 时间戳。</p><p><b>12</b><i></i></p><p><b>1</b><i></i></p><p><b>0</b><i></i></p><p><b>1,026</b><i></i></p><p><b>116</b><i></i></p><p><b>74</b><i></i></p><p><span>6 月</span><span>7 月</span><span>8 月</span><span>9 月</span><span>10 月</span><span>11 月 1–3 日</span></p><figcaption>范围：2026 年 6 月 10 日至 11 月 3 日。仅统计嵌入了 10 位时间戳的名称，因此这是活动量的下限。</figcaption></figure><p><span>[观察到的]</span>其中一些标记于 6 月创建，并且截至 11 月 10 日仍然存在。<span>[解释]</span>当陌生人的模型在你的服务器上停留五个月时，主要问题并不是漏洞本身。主要问题在于，这台服务器没有任何人负责。</p><figure><p><span>表 1</span></p><h3 id=\"sec-19\">模型名称中最常出现的回调注册表</h3><p>已进行无害化处理。其中几个看起来像大规模研究扫描；路径中的“benign”只是一种声称，并非保证。应将其视为搜寻时的背景信息，而不是归因依据。</p><table><thead><tr><th>地址</th><th>端口</th><th>路径模式</th></tr></thead><tbody><tr><td><code>24.144.109[.]68</code></td><td><code>9882</code></td><td><code>trigger/benign, trigger/plamo2-&lt;id&gt;</code></td></tr><tr><td><code>103.249.201[.]108</code></td><td><code>9882</code></td><td><code>trigger/benign</code></td></tr><tr><td><code>76.13.49[.]213</code></td><td><code>9882</code></td><td><code>trigger/benign</code></td></tr><tr><td><code>62.31.247[.]107</code></td><td><code>9882</code></td><td><code>trigger/benign</code></td></tr><tr><td><code>43.143.113[.]68</code></td><td><code>8899</code></td><td><code>library/tens</code></td></tr><tr><td><code>185.165.171[.]21</code></td><td><code>8899</code></td><td><code>recon/probe</code></td></tr></tbody></table><figcaption>还观察到：使用了数十个短生命周期的 <code>*.trycloudflare[.]com</code> 隧道、<code>ttl[.]sh</code>、<code>bore[.]pub</code> 和 Pinggy 端点作为注册表。</figcaption></figure><h2 id=\"sec-20\">看到这些数据后，我会做哪些改变</h2><h3 id=\"sec-21\">暴露面研究需要提出第二个问题。</h3><p>“它是否开放？”这是容易回答的部分。“它是否已被触碰？”才是有用的部分；对于 AI 运行时而言，答案通常就藏在只读 API 响应中。防御者应根据痕迹进行分流，而不是根据横幅信息。</p><h3 id=\"sec-22\">模型运行时正在成为凭据代理。</h3><p>一旦本地守护进程能够使用磁盘上的密钥路由到付费云模型，攻破它就意味着获取访问权限和资金，而不只是消耗 CPU 周期。这与大多数团队键入 <code>OLLAMA_HOST=0.0.0.0</code> 时所设想的是不同的威胁模型。</p><h3 id=\"sec-23\">这里的攻击者并不需要 AI。</h3><p>我们耗费大量精力争论 AI 是否会让攻击者更快。在这些服务器上，现成的套路依然老套：未经身份验证的服务、路径遍历、服务器端请求伪造、对外回调。熟悉的原语，新的落脚点。我们早已知道哪些控制措施有效，只是它们还没有跟上工作负载。</p><h3 id=\"sec-24\">互联网测量数据受到污染，我们应当明确指出这一点。</h3><p>所谓“关键 AI 暴露”中，有相当一部分实际上是其他人的传感器在相互观察。任何发布暴露数据的机构，包括厂商在内，都应说明其筛选方式。</p><h2 id=\"sec-25\">企业应采取的措施</h2><p>这里涉及的控制措施并不陌生：归属管理、身份验证、出口控制、日志记录、补丁管理和暴露管理。实际步骤也很直接：</p><h3 id=\"sec-26\">本周：找出它们，并检查是否有访客</h3><ul><li>扫描你们自己的公网地址范围，以及公司付费的每一个云端和 VPS 账户，包括通过个人信用卡支付并报销的账户。不要只看默认端口：这里有 6% 的发现结果位于非标准端口上。</li><li>在每个 Ollama 实例上，读取模型列表。任何以 IP 地址、隧道域名或 ttl.sh 为前缀的东西，任何名为 beacon、verify、probe 或 pwn 的东西，以及任何包含你自己 IP 地址的东西，都是陌生人留下的产物。</li><li>如果发现其中一个，应将主机视为已被攻陷，而不只是配置不当。轮换其环境和服务文件中的所有凭据，撤销关联 ollama.com 账户上的 Ollama 密钥，检查云端用量中是否有无法识别的支出，并进行重建，而不是清理。</li></ul><h3 id=\"sec-27\">30 天内：先关上门，再关上窗</h3><ul><li>将模型运行时绑定到 localhost 或私有网络。如需远程访问，应在前面部署带身份验证的反向代理或零信任访问层。Ollama 没有内置身份验证，因此这不是可选项。</li><li>将模型服务器的出站流量限制到你批准的注册表。出口控制能够将基于拉取的回调或 SSRF 尝试转化为连接失败。</li><li>保持运行时为最新版本；除非共享服务器位于身份验证和支出告警之后，否则不要将其登录到个人或企业云端模型账户。</li><li>记录会改变状态的 API 调用（pull、create、copy、push、delete），并针对这些调用发出告警。在稳定的生产服务器上，这些调用应当很少出现。</li></ul><h3 id=\"sec-28\">本季度：让归属管理成为默认要求</h3><ul><li>将登记纳入 AI 基础设施支出的前提条件：每台模型服务器都要有指定的负责人、数据分类和到期日期。如果无人负责，就将其关闭。</li><li>以书面形式确定允许在哪些位置运行未经审查或经过审查移除限制的模型，以及这些模型可以接触哪些资源。研究沙箱可以，面向互联网且接入文档处理流水线的机器不可以。</li><li>将 AI 运行时、笔记本和实验跟踪器纳入暴露管理和红队测试范围。测试的不只是引擎，还要测试制动系统：你能否在一小时内找到、隔离并关闭其中一台服务器？</li></ul><h2 id=\"sec-29\">方法与局限性</h2><p>于 2026 年 11 月 10 日进行单次快照采集，针对预先选定的七个端口上的 20,354 个 IPv4 地址（3000、5000、8000、8080、8501、8888、11434）。产品检测针对每项服务发出一个未经身份验证的 HTTP 请求：Ollama <code>/api/tags</code>、Jupyter <code>/api/kernels</code>、MLflow experiment search、JupyterHub <code>/hub/api/</code>、Streamlit 和 Grafana health endpoint。未发送任何推理、写入或漏洞利用请求。</p><p>可能通过两种启发式方法移除了疑似欺骗基础设施：148 台主机共享相同的五服务指纹，以及以多种产品身份响应的 IP:port 对（281 台主机）。这在 429 台主机上移除了 1,513 项发现。有些真实服务器可能已被移除，但肯定仍有部分传感器留存。</p><p>第三方活动指标仅根据模型名称推断。干净的清单并不能证明主机干净，因为名称可以被删除。编码字符串已从 Base64 和十六进制片段中解码。模型家族按名称模式归类。地理位置和网络数据来自 DB-IP Lite（CC BY 4.0）、MaxMind GeoLite2 和 iptoasn。本文不会列出单独暴露的主机。</p><p>本文反映了作者对上述扫描数据的分析。Ollama、Jupyter、MLflow、Streamlit 和 Grafana 分别是其各自所有者的商标。本文包含由 MaxMind 制作的 GeoLite2 数据。</p><h2 id=\"sec-30\">文章标签</h2><ul><li><a href=\"https://www.rapid7.com/blog/tag/artificial-intelligence/\">人工智能</a></li></ul>","original","zhKind","translation","complete","供应链","Rapid7","Oracle","腾讯","Google","Microsoft","Cloudflare","https://www.rapid7.com/blog/post/tr-self-hosted-ai-renting-compute-exposed-servers","Rapid7 CVE 公告",{"_200":201,"_202":-5},"changelogVersion","2026-10-01T08:00","release"]
