[{"_1":2,"_3":4},"root",{"_5":93},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":54,"_55":36,"_56":36,"_57":58,"_59":60,"_61":62},"expiresAt",1793621626000,"id","wzjcsrijtimb18s48r4hgz18b","title","群晖 NAS 遭勒索攻击，官方建议更新 Synology-SA-24:20 并关闭暴露的远程访问","originalTitle","国内群晖NAS设备遭勒索攻击，官方建议尽快排查更新","summary","国内外已出现群晖 NAS 设备遭勒索攻击事件，部分文件被加密并添加 .L0CK3D 后缀，同时出现 read-me3.txt 勒索信，攻击被认为与 C3RB3R（Cerber）勒索软件有关。","reason","source",{"_74":92},"links",{"_85":91},"publishedAt","2026-10-30T16:00:00.000Z","discoveredAt","2026-11-01T15:26:37.411Z","timelineAt","category","activity","tags",[75,90,77],"score",74,"selected",true,"channel","news","story",{"_81":82,"_13":83},"x","sameEvent",{"_11":88,"_13":89},"readingMode","full","author","body",{"_62":84,"_85":-5,"_86":85,"_87":36},"outline",[],"relatedStories",[80],"topics",[69,70,71],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation",false,"bodyLanguage","zh","factId","fWnIQuGAfSM0","reportCount",2,"additionalSourceCount",1,{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","attack","name","攻击活动","exploited","在野利用","ransomware","勒索软件",{"_81":82,"_13":83},"publicId","2949ac1d-5e61-43df-beff-1f3190aa95b7","C3RB3R借群晖旧版漏洞勒索NAS","<p>前情回顾·勒索软件猖獗</p><ul><li><p><a href=\"https://www.secrss.com/articles/92947\">西安某公司遭勒索攻击：核心业务数据被加密，网警应急处置</a></p></li><li><p><a href=\"https://www.secrss.com/articles/81711\">工信部：关于防范BERT勒索软件的风险提示</a></p></li><li><p><a href=\"https://www.secrss.com/articles/85845\">至少148亿元！近三年受害企业支付勒索软件赎金金额创新高</a></p></li></ul><p>安全内参10月31日消息，国内外陆续出现多起群晖（Synology）NAS设备遭受勒索软件攻击的事件，部分用户的文件被恶意加密，并被要求支付赎金才能恢复数据。10 月 30日，群晖官方公众号发布安全公告，确认攻击者正在利用旧版系统中已修复的安全漏洞实施攻击，提醒用户尽快检查并更新系统。</p><p><img src=\"/dailyinfo/media/1ea7289024aefa59.webp\" loading=\"lazy\" decoding=\"async\"></p><p>国外Reddit、BleepingComputer社区，国内Linux DO、V2EX等社区及公众号均有用户发帖表示遭受了勒索攻击，也有安全厂商应急团队接到相关事件处置。部分受害设备中的文件被加密并添加.L0CK3D后缀，同时出现名为read-me3.txt的勒索信，相关攻击被认为与C3RB3R（Cerber）勒索软件有关。</p><p>根据目前公开信息，此次攻击主要与群晖NAS系统旧版漏洞有关（群晖安全公告：Synology-SA-24:20），尚不清楚攻击的具体细节及入侵手段。</p><p>建议使用群晖NAS的用户尽快检查并更新系统及相关应用，避免将NAS管理系统直接暴露在互联网，关闭不必要的远程访问功能，并定期将重要数据备份至独立或离线存储设备。</p><p>如发现文件突然无法打开、出现异常后缀或勒索提示，建议立即断开NAS的网络连接，保留现场，避免随意重启、重装或清理数据，并及时联系专业人员协助处理。</p><p>PS：中招用户也可后台或微信联系安全内参，我们可以协助联系安全团队进行应急处置，分析入侵根因等。</p><p>声明：本文来自安全内参，版权归作者所有。文章内容仅代表作者独立观点，不代表安全内参立场，转载目的在于传递更多信息。如有侵权，请联系 anquanneican@163.com。</p>","original","zhKind","complete","rvzo6jnjpnoo4hypna7k8fk0f","群晖NAS设备遭C3RB3R勒索攻击，官方建议更新至安全版本","勒索","https://www.secrss.com/articles/95225","安全内参",{"_94":95,"_96":-5},"changelogVersion","2026-10-01T08:00","release"]
