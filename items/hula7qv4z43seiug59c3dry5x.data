[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795912838000,"id","hula7qv4z43seiug59c3dry5x","title","SAP 确认遭遇网络攻击，GitHub 上的源代码据称被窃取","originalTitle","SAP Confirms Cyberattack, Source Code Reportedly Compromised","summary","SAP 确认正在调查一起网络安全事件，称已发现可疑活动并采取了保护客户与服务安全的措施。德国 Der Spiegel 与 DPA 报道称，黑客获取了 SAP 员工的认证 token，可在 GitHub 上复制并篡改源代码；SAP 未披露攻击细节，称截至目前未发现客户业务数据被未授权访问的证据，且尚不明确攻击者是否访问了专有代码。","reason","原文给出了攻击路径的多个环节与 SAP 的处置动作，并明确尚无客户业务数据被访问的证据，便于读者判断风险范围。","source",{"_75":97},"links",{"_90":96},"publishedAt","2026-11-27T07:36:14.000Z","discoveredAt","2026-11-27T07:42:20.060Z","timelineAt","category","activity","tags",[76,94,95,78],"score",77,"selected",true,"channel","news","story",{"_86":87,"_13":88},"x","readingMode","full","author","Eduard Kovacs","body",{"_61":89,"_90":-5,"_91":92,"_93":37},"outline",[],"relatedStories",[85],"topics",[68,69,70,71,72],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fq9_tz6zOSYM","reportCount",4,"additionalSourceCount",3,{"_73":83,"_75":84},{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","attack","name","攻击活动","ai-offense","AI 攻防","black-market","数据窃取与黑产","ransomware","勒索软件","supply-chain","供应链安全",{"_86":87,"_13":88},"publicId","f277d653-e06d-4b70-92f9-cb4b08781be8","SAP确认开发基础设施遭攻击，GitHub代码疑被篡改","<p><strong>企业软件巨头 SAP 已确认正在调查一起网络安全事件。此前有报道称，威胁行为者瞄准了其开发基础设施。</strong>\n\n\n\n\n</p><p>德国媒体 <a href=\"https://www.spiegel.de/netzwelt/sap-wird-opfer-von-hackerangriff-a-6648b5ce-5d74-48dc-86ea-9469705bb91d\">Der Spiegel</a> [付费墙] 于周四率先披露了這一消息，并援引 SAP 内部人士以及一则发送给员工的内部通知。&nbsp;&nbsp;\n\n\n\n</p><p>SAP 告诉 <em>SecurityWeek</em>，其检测到了可疑活动，并已实施相关措施以保护客户并确保服务安全。这家德国公司没有披露此次攻击的细节。\n\n\n\n</p><p>“根据迄今为止的调查，我们没有发现未经授权访问客户业务数据的证据，”SAP 告诉 <em>SecurityWeek</em>。\n\n\n\n</p><p>德国新闻机构 <a href=\"https://www.sueddeutsche.de/wirtschaft/softwarekonzern-sap-haben-verdaechtige-aktivitaeten-identifiziert-dpa.urn-newsml-dpa-com-20090101-261126-930-57534\">DPA</a> 查阅了 SAP 内部通信，这些通信显示可疑活动是在 GitHub 内被发现的。&nbsp;&nbsp;\n\n\n\n</p><p>据 Der Spiegel 援引的一名内部人士称，黑客获得了 SAP 员工的身份验证令牌，使他们能够复制和修改存储在 GitHub 上的源代码。&nbsp;</p><p><span>广告。继续滚动阅读。</span></p><p>SAP 在 GitHub 上发布开发人员工具、示例应用程序和开源项目。目前尚不清楚该威胁行为者是否访问了任何专有代码。\n\n\n\n</p><p>与此同时，<a href=\"https://www.handelsblatt.com/technik/ki/sap-it-sicherheitsvorfall-haben-verdaechtige-aktivitaeten-identifiziert/100273138.html\">Handelsblatt</a> 报道称，SAP 的紧急安全措施已影响多个团队。据报道，这家软件巨头已更换签名密钥、限制对 GitHub 的访问，并暂停了自动化开发操作。\n\n\n\n</p><p>所有报道均未显示，被篡改的代码已被纳入交付给 SAP 客户的软件中。\n\n\n\n</p><p>Der Spiegel 援引的消息人士称，此次攻击可能得到了 AI 的协助。尽管尚未确认 AI 的参与，但包括 <a href=\"https://www.securityweek.com/european-commission-uncovers-data-breach-in-cyberattack-investigation/\">European Commission</a> 在内的多个大型组织近期披露了<a href=\"https://www.securityweek.com/barracuda-hacked-amid-surge-in-artex-powered-cyberattacks/\">AI 协助的网络攻击</a>。\n\n\n\n</p><p>10 月下旬，Gentlemen 勒索软件组织在其泄露网站上列出了 SAP，并指向该公司的拉丁美洲业务。<em>SecurityWeek</em> 查阅的文件列表表明，黑客获得了与 SAP 相关的软件和源代码，但尚不清楚是 SAP 自身还是第三方遭到入侵。这两起事件似乎并无关联。\n\n\n\n</p><p><strong>相关</strong>：<a href=\"https://www.securityweek.com/fifa-says-it-has-been-victim-of-a-cyberattack-accessing-personal-and-business-information/\">FIFA 称其成为网络攻击受害者</a>&nbsp;\n\n\n\n</p><p><strong>相关</strong>：<a href=\"https://www.securityweek.com/1password-breach-exposes-customer-data-internal-source-code/\">1Password 数据泄露暴露客户数据和内部源代码</a>&nbsp;\n\n\n\n</p><p><strong>相关</strong>：<a href=\"https://www.securityweek.com/critical-juniper-session-smart-conductor-flaw-exploited-in-attacks/\">Juniper Session Smart Conductor 严重漏洞已在攻击中被利用</a>&nbsp;\n\n\n\n</p>","original","zhKind","translation","complete","数据窃取","供应链","https://www.securityweek.com/sap-confirms-cyberattack-source-code-reportedly-compromised/","SecurityWeek",{"_99":100,"_101":-5},"changelogVersion","2026-10-01T08:00","release"]
