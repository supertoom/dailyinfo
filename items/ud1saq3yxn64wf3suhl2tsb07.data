[{"_1":2,"_3":4},"root",{"_5":102},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795567290000,"id","ud1saq3yxn64wf3suhl2tsb07","title","Radware 披露 Cloud WAF 管理 API 入侵事件，客户云访问密钥可能泄露","originalTitle","Radware discloses breach exposing customer cloud access keys","summary","Radware 表示，攻击者于 19 November 2026 通过无需认证且暴露于公网的内部 Cloud WAF 管理 API，获取了部分客户联系方式及日志导出凭据，涉及 AWS S3、Azure Blob Storage 和 SFTP。","reason","source",{"_73":101},"links",{"_61":100},"publishedAt","2026-11-24T17:49:05.000Z","discoveredAt","2026-11-24T18:29:32.514Z","timelineAt","category","activity","tags",[74,96,97,98,99],"score",64,"selected",false,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","Sergiu Gatlan","body",{"_92":-5,"_61":93,"_94":-5,"_95":36},"outline",[83,84],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fGP_kZvnE78s","reportCount",1,"additionalSourceCount",0,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","attack","name","攻击活动","identity","身份与访问","cloud-native","云与原生",{"_80":81,"_13":82},"publicId","cf6be635-f31c-459a-bb2e-32f57429226e","Radware披露云WAF管理API遭入侵",{"_11":90,"_86":91,"_88":89},{"_11":85,"_86":87,"_88":89},"sec-2","text","Uncover email threats your existing defenses may miss.","level",2,"sec-1","Customers advised to rotate exposed keys","zh","<p><img alt=\"Radware\" height=\"900\" src=\"/dailyinfo/media/ebba165f3e3d4e11.jpg\" srcset=\"/dailyinfo/media/ec128df9c5314725.jpg 720w, /dailyinfo/media/55c15f1d5d0b6efe.jpg 1200w, /dailyinfo/media/ebba165f3e3d4e11.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>Cybersecurity company Radware says attackers gained access to some of its customers' account details and cloud access keys through an unsecured internal Cloud WAF (Web Application Firewall) management API that was left exposed online.</p><p>Founded in 1996 and headquartered in Tel Aviv, Radware now provides application delivery and DDoS protection services to more than 12,500 enterprise and telecom carrier customers worldwide.</p><p>In a root cause analysis report shared by an anonymous source with BleepingComputer, Radware says it blocked the originating IP address and access to the internal management API. The company also revoked and replaced all internal account credentials after detecting the breach on Thursday, ten hours after the initial unauthorized API access.</p><p><a href=\"https://www.wiz.io/lp/claude-code-security-best-practices-cheat-sheet?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q3_INB_FORM_Claude-Code-Security-Best-Practices&amp;sfcid=701Vh00000gJQZuIAO&amp;utm_term=FY27Q4-bleepingcomputer-article-970x250-Nov&amp;utm_content=Claude-Code-Best-Practices\"><img src=\"/dailyinfo/media/d1878a942593a18c.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>\"On 19 November 2026, an unauthorized party accessed an internal-only Cloud WAF management API that was reachable from the Public Internet without requiring authentication,\" Radware said.</p><p>\"The confirmed information potentially accessed includes customer contact details, and for a subset of customers, the credentials configured for log export into their self-managed storage (AWS S3, Azure Blob Storage, or SFTP).\"</p><p>The company added that the breach did not expose WAF traffic inspection, certificates, end-users’ data, customer application traffic, or cloud DDoS services and data.</p><h2 id=\"sec-1\">Customers advised to rotate exposed keys</h2><p>It also \"strongly\" advised affected AppSec (WAF, BOT) customers to rotate Cloud WAF log export credentials (including Azure Blob Storage keys or SAS tokens, AWS S3 access keys, or SFTP credentials) as soon as possible and review access logs on their cloud storage accounts for unexpected access since at least November 19.</p><p>The company is still investigating the breach and whether any API keys or other customer information exposed in the incident were used without authorization, and said it has already received reports from customers about AWS alerts for an unfamiliar IP address attempting to access their log-export buckets.</p><p>\"WAF traffic inspection and protection have continued without interruption, and we have not identified an impact on the availability or protection of customer applications and services,\" Radware added. \"We have found no evidence to date of changes to customer security policies or of access to customer application traffic.\"</p><p>Radware has yet to issue a public statement regarding the incident or file a breach report with the US Securities and Exchange Commission.</p><p>BleepingComputer also reached out to a Radware spokesperson with questions about the incident, but a response was not immediately available.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/05e456735a2a4381.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-2\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Uncover email threats your existing defenses may miss.</a>\n        </h2><p>Adaptive Security's AI agents analyze email intent, context, and behavior to uncover phishing, business email compromise, and invoice fraud.</p><p>See what's getting through with a 14-day read-only scan of Microsoft 365 or Google Workspace, with no MX changes.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Start your free email security scan.</a>\n    </p>","zhKind","complete","数据泄露","凭据","云原生","AWS","https://www.bleepingcomputer.com/news/security/radware-discloses-breach-exposing-customer-cloud-access-keys/","BleepingComputer",{"_103":104,"_105":-5},"changelogVersion","2026-10-01T08:00","release"]
