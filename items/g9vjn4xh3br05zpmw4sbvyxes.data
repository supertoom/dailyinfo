[{"_1":2,"_3":4},"root",{"_5":108},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1794530484000,"id","g9vjn4xh3br05zpmw4sbvyxes","title","OpenSSH 10.6p2 修复 Alpine Linux 长密码绕过 SSH 认证漏洞","originalTitle","OpenSSH Issues Emergency Fix for Flaw Letting Long Passwords Bypass SSH Auth on Alpine Linux","summary","OpenSSH 10.6p2 修复了 Alpine Linux 上长密码可绕过 SSH 认证的严重漏洞，攻击者需要网络访问、账户名及 257 至 1,024 bytes 的密码，目标是未设置密码的 SSH 密钥账户。","reason","source",{"_73":107},"links",{"_96":106},"publishedAt","2026-11-05T16:42:46.000Z","discoveredAt","2026-11-06T05:03:29.033Z","timelineAt","category","vuln","tags",[102,103,74,104,105],"score",74,"selected",true,"channel","news","story",{"_77":78,"_13":79},"x","sameEvent",{"_11":100,"_13":101},"readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_62":95,"_96":-5,"_97":98,"_99":36},"outline",[80,81,82,83],"relatedStories",[76],"topics",[69,70],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","f_nLqRjBvHw0","reportCount",2,"additionalSourceCount",1,{"_71":30,"_73":75},{"_71":72,"_73":74},"slug","exploited","name","在野利用","漏洞披露",{"_77":78,"_13":79},"publicId","8cbb6ce3-a5e3-45e1-885c-bcee2ad3a4e4","OpenSSH SSHole漏洞已确认在野利用",{"_11":93,"_85":94,"_87":88},{"_11":91,"_85":92,"_87":88},{"_11":89,"_85":90,"_87":88},{"_11":84,"_85":86,"_87":88},"sec-4","text","修复为何在第二天发布","level",3,"sec-3","长密码为何有效","sec-2","如何修复","sec-1","谁会受到影响","<p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEieaHvS5baW_XG1eAsBsoSp9qRzV179f0WwXoj9k6rUeX4Qa4sxpi3hvpGkgkYNMPzZQH0mvvVAoTooEAgl1G3SyFksmhqNEbDEIEWM83RH47u8qvNyIYclA7z7GUdPJGx8WfJd556iCvvtvsitAYp9M-T46OvuwkaSWwnyhlynEpYax2qyTCACsPbtQLw/s1600/ssh-linux.jpg\"><img alt=\"\" src=\"/dailyinfo/media/c51d8f759dbe1991.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>在某些运行标准 openssh-server 包的 Alpine Linux 服务器上，攻击者可以登录没有密码的账户，例如仅使用 SSH 密钥的账户。他们需要具备对服务器的网络访问权限、知道账户名称，并提供长度在 257 到 1,024 字节之间的密码。</p><p>将该漏洞评为严重级别的 OpenSSH 今天发布了 10.6p2 版本以阻止该问题。Alpine 已为从 3.16 起的每个版本发布修复后的软件包。</p><p>当 OpenSSH 服务器（sshd）在不使用可插拔认证模块（PAM）接口的情况下检查密码、启用了密码登录，并且机器上至少还有一个其他账户设有密码时，该攻击就会奏效。Alpine 的 openssh-server 包构建时不带 PAM，并且默认启用密码登录。</p><p>该漏洞源于 sshd 与 musl（Alpine 所基于的 C 库）协作的方式。OpenSSH 项目的 Damien Miller 表示，非 Linux 系统、基于 glibc 构建的 Linux 系统，以及通过 PAM 检查密码的系统均不受影响。</p><p>他建议任何运行受影响系统的人“立即为这些系统设置 PasswordAuthentication=no 或禁用 SSH。”目前尚未报告使用该漏洞实施的攻击。</p><h3 id=\"sec-1\">谁会受到影响</h3><p>Alpine 的<a href=\"https://alpinelinux.org/posts/2026-11-05-openssh-password-authentication-bypass/\">安全公告</a>列出了四项条件。当以下四项条件全部成立时，服务器即暴露于风险之中：</p><ul>\n  <li>运行 <code>openssh-server</code> 包（该包构建时不带 PAM），或者运行 <code>openssh-server-pam</code> 并附带 <code>UsePAM no</code>。</li>\n  <li><code>PasswordAuthentication</code> 是 <code>yes</code>，这也是 OpenSSH 的默认设置。</li>\n  <li>某个账户的密码字段为 <code>*</code>，这意味着未设置密码。</li>\n  <li>至少还有一个其他本地账户的密码哈希以 <code>$5$</code> 或 <code>$6$</code> 开头。</li>\n</ul><p>攻击者还需要知道某个未设置密码的账户名称。只要有一个设有密码的账户，就足以暴露每一个未设置密码的账户。根据该公告，攻击者只需单次连接，每次尝试都能成功。</p><p>在 Alpine 上，未设置密码的账户包括：</p><ul>\n  <li>使用 <code>adduser</code> 创建且未设置密码的仅限密钥用户，或者使用 <code>usermod -p '*'</code> 创建的用户</li>\n  <li>通过 musl-nscd 来自目录服务的用户，因为他们没有 shadow 条目</li>\n  <li><code>root</code>，自大约 Alpine 3.16 起一直作为 <code>root:*</code> 随基础镜像发布</li>\n  <li>使用 tiny-cloud 构建的官方云镜像中的 <code>alpine</code> 用户</li>\n</ul><p>root 受默认的 <code>PermitRootLogin prohibit-password</code> 设置保护，只有将 <code>PermitRootLogin yes</code> 设置为特定值后才能直接访问。如果暴露风险的账户能够成为 root，例如通过 <code>doas</code>，那么这种保护就无济于事。</p><p>从 3.18.11 到 3.24.3 的 tiny-cloud 镜像为 <code>alpine</code> 用户提供了免密码的 <code>doas</code>。它们在首次启动时是安全的，但一旦机器上存在任何 <code>$6$</code> 哈希，例如管理员设置控制台密码后，就会暴露于攻击之下。届时攻击者可以 <code>alpine</code> 登录，并使用 <code>doas</code> 成为 root。</p><p>未运行 sshd 的容器、带有 <code>PasswordAuthentication no</code> 的系统，以及通过 cloud-init 设置的云镜像均不受影响，因为 cloud-init 会写入该设置。在 <code>/etc/shadow</code> 中通过 <code>!</code> 锁定的账户也不受影响，任何账户都不具有 <code>$</code> 样式密码哈希的机器同样不受影响。</p><p>该漏洞并不仅限于 Alpine。报告该漏洞的 Wakefield 公司的 Özgün Kültekin 在他的<a href=\"https://sshhole.com/\">技术说明</a>中列出了 OpenWrt、Buildroot 和 Yocto 等其他基于 musl、值得检查的系统。</p><p>正如其<a href=\"https://openwrt.org/docs/guide-user/base-system/dropbear\">Dropbear 文档</a>所示，OpenWrt 默认使用 Dropbear 处理 SSH，Kültekin 表示 Dropbear 不受影响。在 OpenWrt 上，只有管理员安装了 OpenSSH 服务器的情况下，该漏洞才可能产生影响。</p><h3 id=\"sec-2\">如何修复</h3><p>在 Alpine 上，修复方式是更新软件包后重启，因为升级软件包不会重启正在运行的 sshd：</p><ol>\n  <li>更新软件包：<code>apk upgrade -U -a</code></li>\n  <li>重启服务器：<code>rc-service sshd restart</code></li>\n</ol><p>Point 版本 3.21.10、3.22.8、3.23.8 和 3.24.4 已包含修复后的软件包。3.16 到 3.21 分支虽然已停止支持，但也获得了修复后的软件包。</p><p>从早于上述 Point 版本的 tiny-cloud 镜像启动的云实例仍需更新，或应用下面的设置。</p><p>如果你自行构建 OpenSSH，10.6p2 版本已包含此更改，正如其<a href=\"https://www.openssh.org/releasenotes.html#10.6p2\">发布说明</a>所描述的。</p><p>如果目前还无法更新，关闭密码登录也能阻止此次攻击。首先确保你的 SSH 密钥登录可用，并在新一次登录成功之前保持当前会话开启。然后设置 <code>PasswordAuthentication no</code>，使用 <code>sshd -t</code> 检查配置，并重启 sshd。</p><p>公告提供了相关命令，会在一个 drop-in 文件中添加该设置，文件位于 <code>/etc/ssh/sshd_config.d</code>；从 3.19 开始，Alpine 的默认配置会从该位置读取。命令还会将 <code>/etc/ssh/sshd_config</code> 中的每一行 <code>PasswordAuthentication</code> 从 <code>yes</code> 更改为 <code>no</code>，包括 <code>Match</code> 块内的行。之后，<code>sshd -T | grep -i passwordauthentication</code> 应输出 <code>passwordauthentication no</code>。</p><p>公告建议在 <code>/var/log/messages</code> 中查找内容为 <code>Accepted password for</code> 的 sshd 配置行，即没有密码的账户，例如 <code>alpine</code>、<code>root</code> 或仅使用密钥的用户。在暴露于网络的机器上，还应检查 <code>doas</code> 的使用情况、近期创建的用户、文件以及授权密钥。</p><p>“如果无法排除有人登录的可能性，就应将这台机器视为已被攻陷，”公告称。</p><h3 id=\"sec-3\">长密码为何有效</h3><p>未使用 PAM 时，sshd 会自行检查密码。它使用 <code>crypt()</code> 对尝试登录的密码进行哈希处理；这是 C 标准库中的一个函数，用于将密码转换为存储形式，然后将结果与存储字段进行比较。</p><p>没有密码的账户在该字段中只有 <code>*</code>。这个值太短，无法容纳盐值（哈希值的随机前缀），因此 sshd 会借用另一个拥有真实哈希值的账户的盐值。</p><p>对于 <code>$5$</code> 和 <code>$6$</code> 哈希类型，musl 的 <code>crypt()</code> 会拒绝长度超过 256 字节的密码，并返回 <code>*</code> 以表示错误。该 <code>*</code> 与存储的 <code>*</code> 相匹配，因此 sshd 会接受登录。该范围的上限是 sshd 自身对每个密码 1,024 字节的限制。</p><p>这一行为源自 musl 在 2012 年 8 月 9 日进行的一项<a href=\"https://git.musl-libc.org/cgit/musl/commit/?id=b3c4cc121f70faea45389fe7ddc1127ed5cbd8bb\">更改</a>：失败的 <code>crypt()</code> 调用将返回“无法匹配的哈希值，而不是 NULL”，因为许多程序不会检查调用失败。随后在 2012 年 8 月 29 日加入了 256 字节限制，以保护服务器免受拒绝服务攻击。</p><p>借用盐值的机制来自 2016 年 7 月 15 日的一项<a href=\"https://lists.mindrot.org/pipermail/openssh-commits/2016-July/005428.html\">OpenSSH 更改</a>，用于修复 CVE-2016-6210。该漏洞会让攻击者得知哪些用户名存在。Kültekin 表示，此问题自那时起就一直存在。</p><p>10.6p2 的<a href=\"https://lists.mindrot.org/pipermail/openssh-commits/2026-November/013370.html\">代码更改</a>让 sshd 在存储字段少于四个字符时拒绝匹配。OpenSSH 称这是一种变通方案，并表示根本原因位于 sshd 之外。Alpine 的稳定软件包也包含针对同一问题的补丁。</p><h3 id=\"sec-4\">修复为何在第二天发布</h3><p>Miller 的团队于本周早些时候得知该漏洞，并尽快发布了修复。在<a href=\"https://hachyderm.io/@damienmiller/117563026759098135\">发布公告</a>中，他表示团队现在认为，长时间保密既危险，又主要对攻击者有利，因为团队最近发现 AI 代理会在数小时内再次找到相同的漏洞，有时甚至更快。</p><p>截至今天，该漏洞尚未分配 CVE 标识符。</p><p>觉得这篇文章有意思？欢迎在 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a> 上关注我们，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","evjboavsq5zcivgr94mnwlu4l","OpenSSH <10.6p2 musl libc 认证绕过漏洞 CVE-2026-123158 已修复","漏洞","补丁","Google","CISA","https://thehackernews.com/2026/11/openssh-issues-emergency-fix-for-flaw.html","The Hacker News",{"_109":110,"_111":-5},"changelogVersion","2026-10-01T08:00","release"]
