[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":-5,"_56":57,"_58":59},"expiresAt",1795912836000,"id","d8r57wa5dx4heczan7q6hz8i5","title","PHP 8.2至8.5系列曝出7个代码执行漏洞，官方已发布修复版本","originalTitle","【漏洞通告】PHP 多个安全漏洞","summary","深瞳漏洞实验室披露PHP组件7个严重代码执行漏洞，分别为CVE-2026-126714、CVE-2026-115560、CVE-2026-129289、CVE-2026-129474、CVE-2026-129496、CVE-2026-129182和CVE-2026-129481。","reason","通告列出7个PHP代码执行漏洞的触发路径、影响版本和逐项缓解配置，便于安全团队核对资产并安排升级。","source",{"_65":81},"links",{"_71":80},"publishedAt","2026-11-20T09:49:00.000Z","discoveredAt","2026-11-20T17:23:31.436Z","timelineAt","category","vuln","tags",[74,75,76,77,78,79],"score",78,"selected",true,"channel","news","story","x","readingMode","full","author","body",{"_59":70,"_71":-5,"_72":71,"_73":37},"outline",[],"relatedStories",[],"topics",[60,61,62],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","zh",{"_63":68,"_65":69},{"_63":31,"_65":67},{"_63":64,"_65":66},"slug","research","name","技术研究","漏洞披露","supply-chain","供应链安全","<p><span>深瞳漏洞实验室</span> <span>2026-11-20 17:49</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/15dffc18bf640d6a.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>2026年11月20日，深瞳漏洞实验室监测到一则PHP组件存在代码执行漏洞的信息，漏洞编号：CVE-2026-126714，CVE-2026-115560，CVE-2026-129289，CVE-2026-129474，CVE-2026-129496，CVE-2026-129182，CVE-2026-129481，漏洞威胁等级：严重。</p><p><img src=\"/dailyinfo/media/07def60dafeb4636.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span><span>漏洞名称：</span></span></strong></p><p><span>PHP 多个安全漏洞（</span><span>CVE-2026-126714/CVE-2026-115560/CVE-2026-129289/CVE-2026-129474/CVE-2026-129496/CVE-2026-129182/CVE-2026-129481</span><span>）</span></p><p><strong><span><span>组件名称：</span></span></strong></p><p><span>PHP</span></p><p><span><strong><span>影响范围：</span></strong></span></p><p><span>8.2.0 &lt;= PHP &lt; 8.2.36</span><span><br></span><span>8.3.0 &lt;= PHP &lt; 8.3.37</span><span><br></span><span>8.4.0 &lt;= PHP &lt; 8.4.28</span></p><p><span>8.5.0 &lt;= PHP &lt; 8.5.13</span></p><p><strong><span><span>漏洞类型：</span></span></strong></p><p><span>代码执行</span></p><p><strong><span><span>官方解决方案：</span></span></strong></p><p><span>已发布</span></p><p><strong><span>漏洞分析</span></strong></p><p><img src=\"/dailyinfo/media/c7086002de3a1fa4.webp\" loading=\"lazy\" decoding=\"async\"></p><p><b><span>组件介绍</span></b></p><p><span>PHP 是广泛部署的开源脚本语言，大量 Web 应用直接运行于其上。默认的 files 会话保存处理器将会话数据写入服务器本地会话文件，session upload progress 等特性允许外部请求影响会话数据内容，攻击者提交的输入可直达本次漏洞所在的会话文件写入逻辑。</span></p><p><img src=\"/dailyinfo/media/4154eba16bd26622.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>漏洞简介</span></strong></p><p><span>2026年11月20日，</span><span>深瞳漏洞实验室监测到PHP组件存在多个代码执行漏洞的信息</span><span>，漏洞编号：CVE-2026-126714，CVE-2026-115560，CVE-2026-129289，CVE-2026-129474，CVE-2026-129496，CVE-2026-129182，CVE-2026-129481，漏洞威胁等级：严重。</span></p><p><span>CVE-2026-126714：PHP 默认的 files 会话保存处理器在写入更新后的会话数据时不先清空原有文件内容，写入被中断时会话文件可能保留新会话开头与旧会话结尾的拼接数据，其中的普通字符串字节随后可被反序列化为对象。</span><strong><span><span>能够影响会话数据的攻击者（如通过 session upload progress）在合适时机中断写入即可注入对象，当应用存在可用 gadget 链时导致远程代码执行；会话数据本身也可能被破坏。</span></span></strong></p><p><span>CVE-2026-115560：PHP 会话序列化机制与上传进度处理之间存在异常的交互。</span><strong><span><span>当应用在运行时动态更改序列化处理器、且上传进度功能仍处于启用状态时，会暴露出代码执行路径。</span></span></strong></p><p><span>CVE-2026-129289：PHP 在请求关闭时不会丢弃 HTTP 请求体中未被读取的部分。</span><strong><span><span>当前端复用后端连接时，PHP-FPM 会将残留字节解析为新的 FastCGI 请求，从而实现请求走私与参数注入。</span></span></strong></p><p><span>CVE-2026-129474：在为 __call() / __callStatic() 收集参数以生成回溯时，PHP 可能读取已失效的陈旧值（指向已释放内存）。</span><strong><span><span>若此时发生致命错误且回溯功能开启，会加剧内存破坏。</span></span></strong></p><p><span>CVE-2026-129496：启动期间的诊断写入导致时区缓存在启动内存中分配，随后该内存被释放但引用仍被保留。</span><strong><span><span>worker 首个请求早期的诊断会访问这块已释放的缓存，形成释放后使用条件。</span></span></strong></p><p><span>CVE-2026-129182：关闭期间的致命错误会在执行器已清理之后重新填充存储的致命错误回溯。</span><strong><span><span>请求内存随后被释放，但后续请求的早期诊断会访问该悬空回溯信息，导致释放后使用。</span></span></strong></p><p><span>CVE-2026-129481：会话扩展在会话开始时记录脚本文件名。若关闭期间销毁会话变量时发生致命错误，该文件名的指针在请求内存释放后仍被保留。</span><strong><span><span>同一 worker 处理后续请求时，可能释放这个悬空字符串，造成内存破坏。</span></span></strong></p><p><strong><span>影响范围</span></strong></p><p><span>PHP 会话文件部分覆盖远程代码执行漏洞(CVE-2026-126714)</span></p><p><span>8.2.0 &lt;= PHP &lt; 8.2.36</span><span><br></span><span>8.3.0 &lt;= PHP &lt; 8.3.37</span><span><br></span><span>8.4.0 &lt;= PHP &lt; 8.4.28</span></p><p><span>8.5.0 &lt;= PHP &lt; 8.5.13</span></p><p><span>PHP 会话序列化格式不一致远程代码执行漏洞(CVE-2026-115560)</span></p><p><span>8.2.0 &lt;= PHP &lt; 8.2.36</span><span><br></span><span>8.3.0 &lt;= PHP &lt; 8.3.37</span><span><br></span><span>8.4.0 &lt;= PHP &lt; 8.4.28</span></p><p><span>8.5.0 &lt;= PHP &lt; 8.5.13</span></p><p><span>PHP-FPM请求走私远程代码执行漏洞(CVE-2026-129289)</span></p><p><span>8.2.0 &lt;= PHP &lt; 8.2.36</span><span><br></span><span>8.3.0 &lt;= PHP &lt; 8.3.37</span><span><br></span><span>8.4.0 &lt;= PHP &lt; 8.4.28</span></p><p><span>8.5.0 &lt;= PHP &lt; 8.5.13</span></p><p><span>魔术方法堆栈回溯释放后重使用远程代码执行漏洞(CVE-2026-129474)</span></p><p><span>8.5.0 &lt;= PHP &lt; 8.5.13</span></p><p><span>时区缓存释放后重使用远程代码执行漏洞(CVE-2026-129496)</span></p><p><span>8.2.0 &lt;= PHP &lt; 8.2.36</span><span><br></span><span>8.3.0 &lt;= PHP &lt; 8.3.37</span><span><br></span><span>8.4.0 &lt;= PHP &lt; 8.4.28</span></p><p><span>8.5.0 &lt;= PHP &lt; 8.5.13</span></p><p><span>请求关闭后的错误回溯重建远程代码执行漏洞(CVE-2026-129182)</span></p><p><span>8.5.0 &lt;= PHP &lt; 8.5.13</span></p><p><span>会话关闭中断后释放后重使用远程代码执行漏洞(CVE-2026-129481)</span></p><p><span>8.3.0 &lt;= PHP &lt; 8.3.37</span><span><br></span><span>8.4.0 &lt;= PHP &lt; 8.4.28</span></p><p><span>8.5.0 &lt;= PHP &lt; 8.5.13</span></p><p><strong><span>解决方案</span></strong></p><p><img src=\"/dailyinfo/media/25314b68962f0258.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>官方修复建议</span></strong></p><p><span>升级至官方已修复版本：</span><span><br></span><span>PHP 8.2 系列 &gt;= 8.2.36</span><span><br></span><span>PHP 8.3 系列 &gt;= 8.3.37</span><span><br></span><span>PHP 8.4 系列 &gt;= 8.4.28</span><span><br></span><span>PHP 8.5 系列 &gt;= 8.5.13</span><span><br></span><span>官方安全通告：<a href=\"https://github.com/php/php-src/security/advisories/GHSA-fm2m-fjf5-v3cp\">https://github.com/php/php-src/security/advisories/GHSA-fm2m-fjf5-v3cp</a></span></p><p><span>下载链接：</span></p><p><span><a href=\"https://www.php.net/ChangeLog-8.php\">https://www.php.net/ChangeLog-8.php</a><a>#8</a>.2.36</span></p><p><span><a href=\"https://www.php.net/ChangeLog-8.php\">https://www.php.net/ChangeLog-8.php</a><a>#8</a>.3.37</span></p><p><span><a href=\"https://www.php.net/ChangeLog-8.php\">https://www.php.net/ChangeLog-8.php</a><a>#8</a>.4.28</span></p><p><span><a href=\"https://www.php.net/ChangeLog-8.php\">https://www.php.net/ChangeLog-8.php</a><a>#8</a>.5.13</span></p><p><img src=\"/dailyinfo/media/30926421bfff6a47.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span><span>临时修复建议</span></span></strong></p><ul><li><p><span>CVE-2026-126714：若业务无需上传进度功能，在管理级配置中将 session.upload_progress.enabled 设为 0，同时对写入 Session 的不可信数据做容量限制，并评估改用支持原子记录替换的 Session 存储后端；需注意关闭上传进度只切断其中一条触发路径，不能覆盖全部利用方式。</span></p></li></ul><ul><li><p><span>CVE-2026-115560：在请求输入解析之前通过管理级配置把 session.upload_progress.enabled 设为 0；若必须保留上传进度，应确保所有读写同一批 Session 记录的组件使用相同的 session.serialize_handler，不同序列化格式的 Session 分开存储，变更格式时迁移或过期旧记录，且不要在应用代码中用 ini_set() 关闭该功能，因为此时已晚于请求输入解析阶段。</span></p></li></ul><ul><li><p><span>CVE-2026-129289：关闭 PHP 后端连接复用，Nginx 侧设置 fastcgi_keep_conn off;，Apache 的 mod_proxy_fcgi 关闭 enablereuse，其他 FastCGI 前端也应在每次请求处理结束后断开后端连接、不再复用。</span></p></li></ul><ul><li><p><span>CVE-2026-129474：在实际运行 PHP worker 的配置中设置 zend.exception_ignore_args=1 并重启所有 workers，PHP 8.5 环境还可设置 fatal_error_backtraces=0 以阻断该攻击路径，仅设置 display_errors=0 不能起到缓解作用。</span></p></li></ul><ul><li><p><span>(5) CVE-2026-129496：修正会触发启动警告或弃用提示的配置后重启 PHP 主进程及全部 workers，或把 PHP 错误日志输出到不经过该文件时间戳路径的目标（例如设置 error_log=syslog）并确认日志能被正常收集，仅调整 FPM 自身的日志路径不足以完成该缓解。</span></p></li></ul><ul><li><p><span>(6) CVE-2026-129182：在管理级配置中设置 fatal_error_backtraces=0，重启全部 workers 使配置生效，并确保请求级配置无法重新开启该选项，防止被应用配置或攻击者绕过。</span></p></li></ul><ul><li><p><span>(7) CVE-2026-129481：避免 Session 清理回调过程中发生致命错误，对 PHP-FPM 可在池配置中设置 pm.max_requests=1 并重启 workers，使同一 worker 不再继续处理后续请求；该措施有性能开销，且关闭上传进度不能缓解此路径。</span></p></li></ul><p><img src=\"/dailyinfo/media/94fa460a8e600b2e.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>深信服解决方案</span></strong></p><p><strong><span>1、风险资产发现</span></strong></p><p><span>支持对PHP的主动检测，</span><strong><span><span>可批量检出业务场景中该事件的受影响资产情况，</span></span></strong><span>相关产品如下：</span></p><p><strong><span><span>【深信服统一端点安全管理系统aES】</span></span></strong><span>已发布资产检测方案，指纹ID:0006509。</span></p><p><strong><span><span>【深信服云镜YJ】</span></span></strong><span>已发布资产检测方案，指纹ID:0006509。</span></p><p><strong><span>2、漏洞主动检测</span></strong></p><p><span>支持对PHP多个安全漏洞的主动检测，</span><strong><span><span>可批量快速检出业务场景中是否存在漏洞风险，</span></span></strong><span>相关产品如下：</span></p><p><strong><span><span>【深信服云镜YJ】</span></span></strong><span>预计2026年11月23日发布检测方案，规则ID:SF-0005-22851、SF-0005-22852、SF-0005-22853、SF-0005-22854、SF-0005-22855、SF-0005-22856、SF-0005-22857。</span></p><p><strong><span><span>【深信服可拓展检测响应平台XDR】</span></span></strong><span>预计2026年11月23日发布检测方案（需要具备云镜组件能力），规则ID:SF-0005-22851、SF-0005-22852、SF-0005-22853、SF-0005-22854、SF-0005-22855、SF-0005-22856、SF-0005-22857。</span></p><p><b><span>参考链接</span></b></p><p><span><a href=\"https://github.com/php/php-src/security/advisories/GHSA-fm2m-fjf5-v3cp\">https://github.com/php/php-src/security/advisories/GHSA-fm2m-fjf5-v3cp</a></span></p><p><b><span>时间轴</span></b></p><p><strong><span>2026/11/20</span></strong></p><p><span>深瞳漏洞实验室监测到PHP 多个安全漏洞信息。</span></p><p><strong><span>2026/11/20</span></strong></p><p><span>深瞳漏洞实验室发布漏洞通告。</span></p><p><span>点击</span><strong><span><span>阅读原文</span></span></strong><span>，及时关注并登录深信服</span><strong><span>智安全平台</span></strong><span>，可轻松查询漏洞相关解决方案。</span></p><p><span><img src=\"/dailyinfo/media/282dea322aaea5f9.webp\" loading=\"lazy\" decoding=\"async\"></span></p><p><img src=\"/dailyinfo/media/e1ea199f95f740cc.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><a href=\"https://sec.sangfor.com.cn/security-vulnerability/detail?vuln_sfv=SF_2026_47146%5cx26amp;lang=ZH-CN\">阅读原文</a></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=26456e1e&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzg2NjgzNjA5NQ%3D%3D%26mid%3D2247526537%26idx%3D1%26sn%3Dc9538af4fae785647a200693d9a3f900\">跳转微信打开</a></p>","original","zhKind","complete","漏洞","补丁","漏洞分析","供应链","PHP","深信服","https://mp.weixin.qq.com/s?__biz=Mzg2NjgzNjA5NQ==&mid=2247526537&idx=1&sn=c9538af4fae785647a200693d9a3f900","深信服千里目安全实验室",{"_83":84,"_85":-5},"changelogVersion","2026-10-01T08:00","release"]
