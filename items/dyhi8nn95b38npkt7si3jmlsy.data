[{"_1":2,"_3":4},"root",{"_5":89},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1794530484000,"id","dyhi8nn95b38npkt7si3jmlsy","title","AG2 SandboxShellTool 换行注入可绕过命令白名单与只读限制","originalTitle","AG2: Newline injection in SandboxShellTool bypasses allowed=[...] and readonly=True, enabling arbitrary command execution","summary","AG2 的 SandboxShellTool 可因命令字符串中的换行符绕过 allowed=[...] 与 readonly=True 两种限制。过滤器会拒绝 ;、&&、| 等 shell 操作符，却未拦截 \\n 或 \\r，随后原始字符串被交给 sh -c 执行，使第二条命令也能运行；默认 LocalEnvironment() 后端下，这属于宿主进程命令执行，而非容器内隔离。","reason","原文定位了 AG2 命令过滤与 shell 执行之间的机制差异，并用 PoC 展示了换行符如何绕过两类受限模式。","source",{"_72":88},"links",{"_60":87},"publishedAt","2026-11-10T15:57:17.000Z","discoveredAt","2026-11-10T16:52:20.719Z","timelineAt","category","disclosure","tags",[73,82,83,84,85,86],"score",71,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","body","outline",[],"relatedStories",[78],"topics",[67,68,69],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fhjDeUD1QuCE","reportCount",1,"additionalSourceCount",0,{"_70":76,"_72":77},{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","research","name","技术研究","vuln","漏洞披露","ai-agent","AI Agent 安全",{"_79":80,"_13":81},"publicId","8c660581-a28f-4cba-95b8-35b30b358839","AG2沙箱换行注入绕过限制","复现","漏洞分析","Agent 安全","大模型","利用链","https://github.com/advisories/GHSA-2h4w-29cv-2cmv","GitHub 安全公告",{"_90":91,"_92":-5},"changelogVersion","2026-10-01T08:00","release"]
