[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":-5,"_57":36,"_58":59},"expiresAt",1794789632000,"id","sk9atn27z1rrggobbcycf6bz6","title","Security Affairs 发布第 8 期 AI-CYBERSECURITY 汇总","originalTitle","SECURITY AFFAIRS AI-CYBERSECURITY NEWSLETTER ROUND 8","summary","Security Affairs 第 8 期 AI-CYBERSECURITY newsletter 汇总 AI 与网络安全领域的文章和研究，涵盖自主 AI 入侵、针对台湾紧急服务攻击的 AI attack mesh、Claude Code 密钥暴露、SGLang RCE 漏洞利用，以及 Fireworks AI 和 Notion AI 数据泄露等事件。","reason","source",{"_63":81},"links",{"_59":80},"publishedAt","2026-11-15T16:06:11.000Z","discoveredAt","2026-11-15T16:36:56.283Z","timelineAt","category","ai-security","tags",[77,64,78,79],"score",9,"selected",false,"channel","news","story","x","readingMode","full","author","Pierluigi Paganini","body",{"_73":-5,"_59":74,"_75":-5,"_76":36},"outline",[67],"relatedStories",[],"topics",[60,61],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_62":65,"_63":66},{"_62":30,"_63":64},"slug","name","AI 安全","ai-agent","AI Agent 安全",{"_11":68,"_69":70,"_71":72},"sec-1","text","Security Affairs AI-CYBERSECURITY newsletter includes a collection of the best a","level",2,"zh","<h2 id=\"sec-1\">Security Affairs AI-CYBERSECURITY newsletter includes a collection of the best articles and research on AI in the international landscape</h2><p>Artificial intelligence is rapidly changing cybersecurity, reshaping both the techniques used by attackers and the tools available to defenders. AI agents can automate tasks, analyze large amounts of data, discover vulnerabilities and accelerate offensive operations. At the same time, AI is creating new capabilities for threat detection, incident analysis and response. Security Affairs’ new newsletter follows this evolution, covering every week the latest threats, attacks, vulnerabilities and developments at the intersection of AI and cybersecurity.</p><p><a href=\"https://www.anthropic.com/research/components-of-agent-memory\">The components of agent memory</a>&nbsp;&nbsp;</p><p><a href=\"https://malbearlabs.com/posts/operation-snowball-inside-an-autonomous-ai-intrusion-campaign\">Operation Snowball: Inside an Autonomous AI Intrusion Campaign</a></p><p><a href=\"https://www.theguardian.com/uk-news/2026/nov/03/ai-godfather-geoffrey-hinton-better-off-without-ai\">AI ‘godfather’ Geoffrey Hinton: it might turn out we were better off without AI</a></p><p><a href=\"https://www.acronis.com/en/tru/posts/bossai-inside-the-ai-attack-mesh-that-targeted-taiwans-emergency-services/\">BOSSAI: Inside the AI attack mesh that targeted Taiwan’s emergency services</a>&nbsp;&nbsp;&nbsp;</p><p><a href=\"https://arstechnica.com/ai/2026/11/claude-code-settings-files-expose-thousands-of-secrets-on-github/\">Claude Code is accidentally exposing secrets all over GitHub</a>&nbsp;&nbsp;</p><p><a href=\"https://thehackernews.com/2026/11/sglang-rce-exploit-breaches-near-ai.html\">SGLang RCE Exploit Breaches NEAR AI, Steals Data From 18 Agents and About 100 Users</a></p><p><a href=\"https://www.securityweek.com/google-deepminds-ai-agents-make-1024-bit-rsa-keys-cheaper-to-attack/\">Google DeepMind’s AI Agents Make 1024-Bit RSA Keys Cheaper to Attack</a>&nbsp;&nbsp;</p><p><a href=\"https://www.anthropic.com/claude-fable-and-mythos-5-2\">Claude Fable 5.2 and Mythos 5.2</a></p><p><a href=\"https://thehackernews.com/2026/11/fireworks-ai-breach-widens-to-expose.html\">Fireworks AI Confirms Wider Breach Affecting Customer Datasets, Model Weights and Notion AI Chats</a></p><p><a href=\"https://github.com/rtkwlf/wolf-tools/tree/main/pack_alerts/202611-antifox-alibaba-hosted-platforms-facilitate-web-cloud-intrusions\">2026-11-10: Antifox Agentic Pentesting Platform Used to Steal AWS Credentials and Move Laterally in Compromised Environments</a>&nbsp;&nbsp;</p><p><a href=\"https://cohere.com/blog/concerning-behaviour-popular-open-weight-ai-model\">Concerning behavior from a popular open-weight AI model</a></p><p><a href=\"https://www.theregister.com/ai-and-ml/2026/11/13/chinese-ai-labs-are-training-models-on-nvidias-blackwell-despite-export-controls-says-ex-openai-engineer/5309891\">Chinese AI labs are training models on Nvidia’s Blackwell despite export controls, says ex-OpenAI engineer</a></p><p><a href=\"https://openai.com/index/control-room/\">OpenAI – Control Room</a></p><p><a href=\"https://blog.malwaremustdie.org/2026/11/mmd-072-2026-artex-detection-signature.html\">MMD-072-2026 – ARTEX detection signature pack – from IOC w/playbook process</a></p><p><a href=\"https://www.wired.com/story/free-chinese-ai-models-are-getting-scary-good-at-hacking/\">Free Chinese AI Models Are Getting Scary Good at Hacking</a>&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;</p><p><a href=\"https://the-decoder.com/anthropic-ceo-amodei-admits-theres-a-huge-uncertainty-in-whats-going-to-happen-next-year-days-before-a-record-ipo/\">Anthropic CEO Amodei admits “there’s a huge uncertainty in what’s going to happen next year” days before a record IPO</a><strong><u>&nbsp;</u></strong> <strong><u></u></strong></p><p><strong>Follow me on Twitter:&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;hacking,&nbsp;<a href=\"https://securityaffairs.com/tag/newsletter\">newsletter</a>)</strong></p>","zhKind","complete","汇总","大模型","Agent 安全","https://securityaffairs.com/203165/ai/security-affairs-ai-cybersecurity-newsletter-round-8.html","Security Affairs",{"_83":84,"_85":-5},"changelogVersion","2026-10-01T08:00","release"]
