[{"_1":2,"_3":4},"root",{"_5":138},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":-5,"_57":36,"_58":59},"expiresAt",1795480844000,"id","tglrp1qv6hwgpzegdl9ei9iqg","title","Help Net Security 汇总 11 个网络安全职位空缺（2026年11月24日）","originalTitle","Cybersecurity jobs available right now: November 24, 2026","summary","Help Net Security 汇总 11 个网络安全职位空缺，涵盖 Applied Cyber、Cyber Security Engineer、威胁情报分析、数据保护及安全管理等岗位。工作地点包括美国、德国、以色列和英国，模式包含远程、混合及驻场；职责涉及检测工程、威胁狩猎、事件响应、漏洞管理、DevSecOps、隐私治理与安全运营，面向具备相关经验并能承担相应职责的求职者。","reason","source",{"_65":137},"links",{"_59":136},"publishedAt","2026-11-23T23:30:54.000Z","discoveredAt","2026-11-24T00:13:32.338Z","timelineAt","category","blue-team","tags",[131,132,133,134,70,135,72],"score",1,"selected",false,"channel","news","story","x","readingMode","full","author","Anamarija Pogorelec","body",{"_127":-5,"_59":128,"_129":-5,"_130":36},"outline",[73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89],"relatedStories",[],"topics",[60,61,62,63],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_64":71,"_65":72},{"_64":69,"_65":70},{"_64":67,"_65":68},{"_64":30,"_65":66},"slug","name","蓝队与运营","compliance","合规与标准","vuln-mgmt","漏洞管理","checkpoint","Check Point",{"_11":125,"_91":126,"_93":94},{"_11":123,"_91":124,"_93":94},{"_11":121,"_91":122,"_93":94},{"_11":119,"_91":120,"_93":94},{"_11":117,"_91":118,"_93":94},{"_11":115,"_91":116,"_93":94},{"_11":113,"_91":114,"_93":94},{"_11":111,"_91":112,"_93":94},{"_11":109,"_91":110,"_93":94},{"_11":107,"_91":108,"_93":94},{"_11":105,"_91":106,"_93":94},{"_11":103,"_91":104,"_93":94},{"_11":101,"_91":102,"_93":94},{"_11":99,"_91":100,"_93":94},{"_11":97,"_91":98,"_93":94},{"_11":95,"_91":96,"_93":94},{"_11":90,"_91":92,"_93":94},"sec-17","text","SIEM Engineer II","level",3,"sec-16","Senior Web Application Penetration Tester","sec-15","Senior Specialist, Data Loss Prevention","sec-14","Senior Security Engineer","sec-13","Senior Cyber Security Engineer","sec-12","Director, Information Security","sec-11","Director, Cyber Defense","sec-10","Defensive Cybersecurity Analyst","sec-9","Data Protection Officer","sec-8","Cybersecurity Specialist","sec-7","Must read:\nHow to succeed at cybersecurity job interviews","sec-6","Cybersecurity Manager","sec-5","Cybersecurity Engineer","sec-4","Cyber Threat Intelligence Analyst","sec-3","Cyber Security Engineer","sec-2","AVP, Information Security","sec-1","Applied Cyber, Detections","zh","<p><img src=\"/dailyinfo/media/b7d16817783c83c4.webp\" loading=\"lazy\" decoding=\"async\" alt=\"cybersecurity jobs November 2026\" title=\"Cybersecurity jobs\"></p><h3 id=\"sec-1\">Applied Cyber, Detections</h3><p><strong>Doppel | USA | Remote –<a href=\"https://www.linkedin.com/jobs/view/4441423089/\"> View job details</a></strong></p><p>As an Applied Cyber, Detections, you will support customer detection operations, implement and optimize detection logic, and automate alert triage across web domains, social media, and other digital channels. You will investigate detection gaps, false positives, and alert issues, support customer onboarding and configurations, and collaborate with customer-facing, Engineering, and Product teams to improve detection capabilities and address cyber threats.</p><p><img src=\"/dailyinfo/media/c2d2ba88e2bca576.gif\" loading=\"lazy\" decoding=\"async\"></p><h3 id=\"sec-2\">AVP, Information Security</h3><p><strong>Amerisure Insurance | USA | Hybrid – <a href=\"https://www.linkedin.com/jobs/view/4460141270/\">View job details</a></strong></p><p>As an AVP, Information Security, you will lead cybersecurity strategy, governance, and security teams while advising executives on risks and regulatory compliance. You will oversee enterprise risk assessments, third-party security, security operations, threat detection, incident response, and vulnerability management. You will also develop security policies, strengthen business resilience, manage security vendors, and drive continuous improvements in cybersecurity capabilities.</p><p><img src=\"/dailyinfo/media/c2d2ba88e2bca576.gif\" loading=\"lazy\" decoding=\"async\"></p><h3 id=\"sec-3\">Cyber Security Engineer</h3><p><strong>TaskVerse | Germany | Remote – <a href=\"https://www.linkedin.com/jobs/view/4493615720/\">View job details</a></strong></p><p>As a Cyber Security Engineer, you will  develop and automate security controls across SAP environments, particularly SAP BTP. You will implement Policy-as-Code, security monitoring, and automated remediation, integrate security into development workflows, and coordinate secure production rollouts. You will also collaborate with engineering and governance teams to improve security processes and strengthen organizational security controls.</p><p><img src=\"/dailyinfo/media/f9883da43ccdbe01.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong>Get weekly updates on new cybersecurity job openings. <a href=\"https://www.helpnetsecurity.com/newsletter/\">Subscribe here!</a></strong></p><p><img src=\"/dailyinfo/media/f9883da43ccdbe01.webp\" loading=\"lazy\" decoding=\"async\"></p><h3 id=\"sec-4\">Cyber Threat Intelligence Analyst</h3><p><strong>Check Point Software | Israel | Hybrid – <a href=\"https://www.linkedin.com/jobs/view/4493631248/\">View job details</a></strong></p><p>As a Cyber Threat Intelligence Analyst, you will monitor and analyze cyber threats, investigate threat actors and attack techniques, and deliver actionable intelligence reports. You will configure and optimize customer intelligence environments, develop data sources across dark web and social platforms, and contribute to platform improvements. You will also collaborate with internal teams and present findings to clients.</p><p><img src=\"/dailyinfo/media/c2d2ba88e2bca576.gif\" loading=\"lazy\" decoding=\"async\"></p><h3 id=\"sec-5\">Cybersecurity Engineer</h3><p><strong>Space Coast Credit Union | USA | Hybrid – <a href=\"https://www.linkedin.com/jobs/view/4465180558/\">View job details</a></strong></p><p>As a Cybersecurity Engineer, you will monitor security systems, detect and respond to threats, investigate incidents, and coordinate remediation efforts. You will conduct threat hunting, vulnerability assessments, and penetration testing while managing security patches across systems and devices. You will also implement security controls, support regulatory compliance and audits, maintain security policies, collaborate with IT teams, and promote cybersecurity awareness. </p><p><img src=\"/dailyinfo/media/c2d2ba88e2bca576.gif\" loading=\"lazy\" decoding=\"async\"></p><h3 id=\"sec-6\">Cybersecurity Manager</h3><p><strong>Forbes Research &amp; Insights | USA | Hybrid – <a href=\"https://www.linkedin.com/jobs/view/4492375506/\">View job details</a></strong></p><p>As a Cybersecurity Manager, you will  lead security teams, oversee cybersecurity governance, manage security projects, and maintain policies and compliance, including PCI and HIPAA requirements. You will manage identity and access controls, endpoint and network security, email protection, and incident response. You will also oversee cloud and web platform security, vulnerability management, secure development practices, and third-party risk while collaborating with Engineering, Legal, and other stakeholders.</p><p><img src=\"/dailyinfo/media/f9883da43ccdbe01.webp\" loading=\"lazy\" decoding=\"async\"></p><h3 id=\"sec-7\">Must read:<br>\n<a href=\"https://www.helpnetsecurity.com/2025/10/06/cybersecurity-job-interview-tips/\">How to succeed at cybersecurity job interviews</a></h3><p><img src=\"/dailyinfo/media/f9883da43ccdbe01.webp\" loading=\"lazy\" decoding=\"async\"></p><h3 id=\"sec-8\">Cybersecurity Specialist</h3><p><strong>SAIC | USA | On-site – <a href=\"https://www.linkedin.com/jobs/view/4448745690/\">View job details</a></strong></p><p>As a Cybersecurity Specialist, you will maintain system authorizations to operate (ATOs), oversee vulnerability scanning, continuous monitoring, incident response, and compliance reporting for classified and unclassified systems. You will coordinate system access, investigate security incidents, and collaborate with system owners, vendors, and stakeholders. You will also support DevSecOps initiatives, evaluate security technologies, secure application and data migrations, and maintain cybersecurity metrics and documentation.</p><p><img src=\"/dailyinfo/media/c2d2ba88e2bca576.gif\" loading=\"lazy\" decoding=\"async\"></p><h3 id=\"sec-9\">Data Protection Officer</h3><p><strong>Helfie.AI | United Kingdom | Remote – <a href=\"https://www.linkedin.com/jobs/view/4492601945/\">View job details</a></strong></p><p>As a Data Protection Officer, you will oversee data protection governance, advise on privacy risks, conduct compliance reviews, guide Data Protection Impact Assessments (DPIAs), and support incident response and international data transfers. Working closely with our leadership, regulatory, and product teams, you will help embed privacy-by-design into our AI-powered healthcare solutions, support compliance with the EU AI Act, and serve as the primary contact for data protection authorities and individuals exercising their privacy rights.</p><p><img src=\"/dailyinfo/media/c2d2ba88e2bca576.gif\" loading=\"lazy\" decoding=\"async\"></p><h3 id=\"sec-10\">Defensive Cybersecurity Analyst</h3><p><strong>Quantum Sky | USA | On-site – <a href=\"https://www.linkedin.com/jobs/view/4493379167/\">View job details</a></strong></p><p>As a Defensive Cybersecurity Analyst, you will investigate security alerts, analyze logs and network data, and correlate evidence to identify threats and support incident investigations. You will integrate threat intelligence into security monitoring tools, document technical findings, and collaborate with incident response teams to ensure timely reporting to customers and USCYBERCOM.</p><p><img src=\"/dailyinfo/media/c2d2ba88e2bca576.gif\" loading=\"lazy\" decoding=\"async\"></p><h3 id=\"sec-11\">Director, Cyber Defense</h3><p><strong>American Express Global Business Travel | USA | On-site – <a href=\"https://www.linkedin.com/jobs/view/4466688060/\">View job details</a></strong></p><p>As a Director, Cyber Defense, you will lead CSIRT, Cyber Threat Intelligence, Detection Engineering, and Data Security Investigations. You will set strategy, manage budgets, develop teams, and report security risks and performance to leadership. You will oversee incident response, strengthen threat intelligence, improve detection capabilities, and drive automation. You will also lead sensitive data investigations, ensure sound evidence handling, and work with Legal, Privacy, HR, and other stakeholders to improve security and response readiness.</p><p><img src=\"/dailyinfo/media/c2d2ba88e2bca576.gif\" loading=\"lazy\" decoding=\"async\"></p><h3 id=\"sec-12\">Director, Information Security</h3><p><strong>Weatherford | USA | On-site – <a href=\"https://www.linkedin.com/jobs/view/4460116691/\">View job details</a></strong></p><p>As a Director, Information Security, you will lead enterprise cybersecurity strategy, governance, and risk management. You will oversee identity and access management, Zero Trust initiatives, data protection, and security across IT, OT, cloud, and AI environments. You will also direct security operations, threat detection, vulnerability management, and incident response while ensuring regulatory compliance and reporting security risks and progress to executive leadership.</p><p><img src=\"/dailyinfo/media/c2d2ba88e2bca576.gif\" loading=\"lazy\" decoding=\"async\"></p><h3 id=\"sec-13\">Senior Cyber Security Engineer</h3><p><strong>CNS | Australia | On-site – <a href=\"https://www.linkedin.com/jobs/view/4492287449/\">View job details</a></strong></p><p>As a Senior Cyber Security Engineer, you will design and implement security architectures and controls across client environments, lead security delivery, and conduct risk assessments and threat modeling. You will improve detection capabilities, support incident response, and develop security roadmaps and resilience plans. </p><p><img src=\"/dailyinfo/media/c2d2ba88e2bca576.gif\" loading=\"lazy\" decoding=\"async\"></p><h3 id=\"sec-14\">Senior Security Engineer</h3><p><strong>Aleroy | UAE | Remote – <a href=\"https://www.linkedin.com/jobs/view/4493621680/\">View job details</a></strong></p><p>As a Senior Security Engineer, you will conduct threat modeling, architecture reviews, and security testing across applications, APIs, and cloud environments. You will assess tenant isolation, production access, secrets management, and data protection practices, oversee vulnerability remediation, evaluate third-party security risks, and provide technical evidence for customer security reviews and ISO 27001 and SOC 2 audits.</p><p><img src=\"/dailyinfo/media/c2d2ba88e2bca576.gif\" loading=\"lazy\" decoding=\"async\"></p><h3 id=\"sec-15\">Senior Specialist, Data Loss Prevention </h3><p><strong>HomeEquity Bank | Canada | Hybrid – <a href=\"https://www.linkedin.com/jobs/view/4475262859/\">View job details</a></strong></p><p>As a Senior Specialist, Data Loss Prevention, you will advise the CISO on DLP strategy, technology, and risk management. You will develop and optimize DLP policies, data classification, monitoring, and automated controls across enterprise systems. You will also design alert investigation workflows, integrate security tools, support audits and compliance, and track performance metrics to improve data protection and reduce risk.</p><p><img src=\"/dailyinfo/media/c2d2ba88e2bca576.gif\" loading=\"lazy\" decoding=\"async\"></p><h3 id=\"sec-16\">Senior Web Application Penetration Tester</h3><p><strong>SIXGEN | Ireland | Remote – <a href=\"https://www.linkedin.com/jobs/view/4492369208/\">View job details</a></strong></p><p>As a Senior Web Application Penetration Tester, you will assess the security of web and mobile applications, APIs, databases, and supporting infrastructure. You will identify and exploit vulnerabilities, analyze attack paths, develop custom testing tools, and research emerging threats. You will also collaborate with clients, document findings, assess risks, and recommend remediation strategies.</p><p><img src=\"/dailyinfo/media/c2d2ba88e2bca576.gif\" loading=\"lazy\" decoding=\"async\"></p><h3 id=\"sec-17\">SIEM Engineer II</h3><p><strong>Securonix | India | On-site – <a href=\"https://www.linkedin.com/jobs/view/4493369411/\">View job details</a></strong></p><p>As a SIEM Engineer II, you will lead SIEM implementations and integrations, design secure data collection and monitoring solutions, and develop tailored detection use cases, dashboards, and connectors. You will troubleshoot data onboarding issues, integrate SOAR capabilities, collaborate with customers and internal teams, and provide training to support successful platform adoption.</p><p><img src=\"/dailyinfo/media/c2d2ba88e2bca576.gif\" loading=\"lazy\" decoding=\"async\"></p>","zhKind","complete","汇总","蓝队","安全运营","检测工程","合规","https://www.helpnetsecurity.com/2026/11/24/cybersecurity-jobs-available-right-now-november-24-2026/","Help Net Security",{"_139":140,"_141":-5},"changelogVersion","2026-10-01T08:00","release"]
