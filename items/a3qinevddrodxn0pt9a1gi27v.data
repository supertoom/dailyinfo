[{"_1":2,"_3":4},"root",{"_5":88},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":37,"_59":60},"expiresAt",1795912833000,"id","a3qinevddrodxn0pt9a1gi27v","title","Ubuntu 更新 Apache HTTP Server 漏洞并修复重定向 Cookie 回归问题","originalTitle","USN-9016-2: Apache HTTP Server regression","summary","Ubuntu 发布 Apache HTTP Server 安全更新，修复 CVE-2026-46729、CVE-2026-47360、CVE-2026-48005、CVE-2026-56153、CVE-2026-56449、CVE-2026-56154、CVE-2026-57941、CVE-2026-59797、CVE-2026-58415、CVE-2026-63045、CVE-2026-63292、CVE-2026-63686、CVE-2026-63718、CVE-2026-73636、CVE-2026-73637、CVE-2026-79768 和 CVE-2026-93546，涉及拒绝服务、任意代码执行、敏感信息泄露、认证绕过及 HTTP 响应走私等风险。受影响版本覆盖 Ubuntu 14.04 LTS、16.04 LTS、18.04 LTS、20.04 LTS、22.04 LTS、24.04 LTS、26.04 LTS 和 26.10，部分漏洞仅影响 Ubuntu 26.10。USN-9016-1 的上游修复还引入在特定情况下阻止重定向设置 Cookie 的回归问题，本次更新一并修复。","reason","公告汇总 Apache HTTP Server 多项漏洞及各自影响范围，并说明上游修复引入的重定向 Cookie 回归问题。","source",{"_70":87},"links",{"_79":86},"publishedAt","2026-11-26T22:34:55.000Z","discoveredAt","2026-11-28T20:26:35.816Z","timelineAt","category","vuln","tags",[83,84,85],"score",76,"selected",true,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body",{"_60":78,"_79":-5,"_80":81,"_82":37},"outline",[],"relatedStories",[74],"topics",[67,68],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","f6v7QNMJivqg","reportCount",1,"additionalSourceCount",0,{"_69":72,"_70":73},{"_69":31,"_70":71},"slug","name","漏洞披露","ubuntu","Ubuntu / Canonical",{"_75":76,"_13":77},"publicId","931605b3-395d-4035-bdbd-e4743a8ce6db","Ubuntu更新Apache并修复重定向Cookie回归","<p>USN-9016-1 修复了 Apache2 中的漏洞。遗憾的是，上游<br>\n修复引入了一个回归问题，导致在某些情况下重定向期间无法设置 cookie。此更新修复了该问题。</p><p>原始公告详情：</p><p>Zhang San、Ankit Prateek、Zhen Kong、SeungHyun Cho、Ryoma Nishioka、<br>\nKeita Sode 和 Hyojae Lee 发现 Apache HTTP Server 未<br>\n正确处理某些内存操作。攻击者可能利用此问题导致拒绝服务。此问题仅影响<br>\nUbuntu 14.04 LTS、Ubuntu 16.04 LTS、Ubuntu 18.04 LTS、Ubuntu 20.04 LTS、<br>\nUbuntu 22.04 LTS、Ubuntu 24.04 LTS 和 Ubuntu 26.04 LTS。（<a href=\"https://ubuntu.com/security/CVE-2026-46729\">CVE-2026-46729</a>）</p><p>发现 Apache HTTP Server 未正确处理<br>\n某些会话 cookie。远程攻击者可能利用此问题<br>\n泄露敏感信息。此问题仅影响 Ubuntu 14.04 LTS、<br>\nUbuntu...</p><p>USN-9016-1 修复了 Apache2 中的漏洞。遗憾的是，上游<br>\n修复引入了一个回归问题，导致在某些情况下重定向期间无法设置 cookie。此更新修复了该问题。</p><p>原始公告详情：</p><p>Zhang San、Ankit Prateek、Zhen Kong、SeungHyun Cho、Ryoma Nishioka、<br>\nKeita Sode 和 Hyojae Lee 发现 Apache HTTP Server 未<br>\n正确处理某些内存操作。攻击者可能利用此问题导致拒绝服务。此问题仅影响<br>\nUbuntu 14.04 LTS、Ubuntu 16.04 LTS、Ubuntu 18.04 LTS、Ubuntu 20.04 LTS、<br>\nUbuntu 22.04 LTS、Ubuntu 24.04 LTS 和 Ubuntu 26.04 LTS。（<a href=\"https://ubuntu.com/security/CVE-2026-46729\">CVE-2026-46729</a>）</p><p>发现 Apache HTTP Server 未正确处理<br>\n某些会话 cookie。远程攻击者可能利用此问题<br>\n泄露敏感信息。此问题仅影响 Ubuntu 14.04 LTS、<br>\nUbuntu 16.04 LTS、Ubuntu 18.04 LTS、Ubuntu 20.04 LTS、Ubuntu 22.04 LTS、<br>\nUbuntu 24.04 LTS 和 Ubuntu 26.04 LTS。（<a href=\"https://ubuntu.com/security/CVE-2026-47360\">CVE-2026-47360</a>）</p><p>Zhen Kong 发现 Apache HTTP Server 未正确处理<br>\n某些身份验证形式。未经验证的远程攻击者<br>\n可能利用此问题导致拒绝服务。此问题<br>\n仅影响 Ubuntu 14.04 LTS、Ubuntu 16.04 LTS、Ubuntu 18.04 LTS、<br>\nUbuntu 20.04 LTS、Ubuntu 22.04 LTS、Ubuntu 24.04 LTS 和<br>\nUbuntu 26.04 LTS。（<a href=\"https://ubuntu.com/security/CVE-2026-48005\">CVE-2026-48005</a>）</p><p>Bartlomiej Dmitruk 和 Masumi Tanaka 发现 Apache HTTP Server<br>\n未正确处理某些内存操作。攻击者可能<br>\n利用此问题导致拒绝服务或执行<br>\n任意代码。（<a href=\"https://ubuntu.com/security/CVE-2026-56153\">CVE-2026-56153</a>）</p><p>Lucian Nitescu 发现 Apache HTTP Server 未正确<br>\n处理某些内存操作。攻击者可能利用此<br>\n问题导致拒绝服务或执行任意代码。此问题<br>\n仅影响 Ubuntu 20.04 LTS、Ubuntu 22.04 LTS、Ubuntu 24.04 LTS、<br>\nUbuntu 26.04 LTS 和 Ubuntu 26.10。（<a href=\"https://ubuntu.com/security/CVE-2026-56449\">CVE-2026-56449</a>）</p><p>发现 Apache HTTP Server 的 mod_rewrite 模块在执行某些变量查找时，<br>\n错误地处理了内存。远程攻击者<br>\n可能利用此问题导致拒绝服务或执行<br>\n任意代码。此问题仅影响 Ubuntu 26.10。（<a href=\"https://ubuntu.com/security/CVE-2026-56154\">CVE-2026-56154</a>）</p><p>Lucian Nitescu、Simon Kappel 和 Gianluca Danesin 发现 Apache<br>\n HTTP Server 的 mod_http2 模块在处理<br>\n 某些 HTTP/2 连接时错误地处理了内存。远程攻击者可能利用此问题<br>\n 导致拒绝服务或执行任意代码。此问题仅影响<br>\n Ubuntu 26.10。（<a href=\"https://ubuntu.com/security/CVE-2026-57941\">CVE-2026-57941</a>）</p><p>Juthawong Naisanguansee、Charles Vosburgh、Mike Read 和 Ryoma Nishioka<br>\n 发现 Apache HTTP Server 的 mod_ssl 模块错误地处理了<br>\n 某些表达式。攻击者可能利用此问题绕过<br>\n 预期的访问限制。此问题仅影响 Ubuntu 26.10。<br>\n （<a href=\"https://ubuntu.com/security/CVE-2026-59797\">CVE-2026-59797</a>）</p><p>이지웅发现 Apache HTTP Server 暴露了 WebDAV 属性信息。<br>\n 远程攻击者可能利用此问题获取敏感<br>\n 信息。此问题仅影响 Ubuntu 26.10。（<a href=\"https://ubuntu.com/security/CVE-2026-58415\">CVE-2026-58415</a>）</p><p>Zhen Kong 和 Charles Vosburgh 发现 Apache HTTP Server 未<br>\n 正确验证 FTP 服务器响应。远程攻击者可能<br>\n 利用此问题使正向代理连接到任意主机。<br>\n 此问题仅影响 Ubuntu 26.10。（<a href=\"https://ubuntu.com/security/CVE-2026-63045\">CVE-2026-63045</a>）</p><p>Hyojae Lee 和 Zhen Kong 发现 Apache HTTP Server 错误地<br>\n 处理了某些 HTTP 请求。远程攻击者可能利用此<br>\n 问题导致拒绝服务或执行任意代码。此问题<br>\n 仅影响 Ubuntu 26.10。（<a href=\"https://ubuntu.com/security/CVE-2026-63292\">CVE-2026-63292</a>）</p><p>Lucian Nitescu 和 Zhen Kong 发现 Apache HTTP Server 未<br>\n 正确处理来自后端服务器的某些响应。远程攻击者<br>\n 可能利用此问题导致拒绝服务。此问题仅影响<br>\n Ubuntu 26.10。（<a href=\"https://ubuntu.com/security/CVE-2026-63686\">CVE-2026-63686</a>）</p><p>Qing Xu 发现 Apache HTTP Server 错误地解释了来自后端服务器的<br>\n HTTP 响应。远程攻击者可能利用此<br>\n 问题发起 HTTP 响应走私攻击。此问题仅影响<br>\n Ubuntu 26.10。（<a href=\"https://ubuntu.com/security/CVE-2026-63718\">CVE-2026-63718</a>）</p><p>Hyojae Lee 发现 Apache HTTP Server 未正确验证<br>\n Digest 认证请求。中间人攻击者可能<br>\n 利用此问题绕过认证。此问题仅<br>\n 影响 Ubuntu 26.10。（<a href=\"https://ubuntu.com/security/CVE-2026-73636\">CVE-2026-73636</a>）</p><p>Zhen Kong 和 Darren Carreras 发现 Apache HTTP Server 未<br>\n 正确管理认证请求。远程攻击者可能利用此<br>\n 问题导致拒绝服务。此问题仅影响<br>\n Ubuntu 26.10。（<a href=\"https://ubuntu.com/security/CVE-2026-73637\">CVE-2026-73637</a>）</p><p>Vlatko Kosturjak 发现 Apache HTTP Server 未正确<br>\n 对用户目录实施访问限制。远程攻击者可能<br>\n 利用此问题获取敏感信息。此问题仅<br>\n 影响 Ubuntu 26.10。（<a href=\"https://ubuntu.com/security/CVE-2026-79768\">CVE-2026-79768</a>）</p><p>Zhen Kong 发现 Apache HTTP Server 未正确处理<br>\n 某些 WebDAV 请求。已认证用户可能利用此<br>\n 问题导致拒绝服务或破坏 WebDAV 属性数据。此<br>\n 问题仅影响 Ubuntu 26.10。（<a href=\"https://ubuntu.com/security/CVE-2026-93546\">CVE-2026-93546</a>）</p>","original","zhKind","translation","complete","补丁","漏洞","Ubuntu","https://ubuntu.com/security/notices/USN-9016-2","Ubuntu 安全公告",{"_89":90,"_91":-5},"changelogVersion","2026-10-01T08:00","release"]
