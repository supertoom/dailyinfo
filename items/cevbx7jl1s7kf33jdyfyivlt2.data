[{"_1":2,"_3":4},"root",{"_5":102},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":60,"_61":62},"expiresAt",1795135235000,"id","cevbx7jl1s7kf33jdyfyivlt2","title","Telegram Widgets 疑遭 RCE 利用并投放 WebRAT，Windows 客户端补丁后仍被指出存在漏洞","originalTitle","Telegram Widgets Hit by RCE Demos, Malware Warning Days After Launch","summary","Kaspersky 怀疑 Telegram 新推出的 Widgets 漏洞已被用于投放 WebRAT（Salat Stealer），受害者访问特定 Telegram 频道后会在不知情下运行 PowerShell 脚本并启动该 Rust 木马，可远程控制系统并窃取加密货币钱包及 Telegram 账户数据。","reason","文章串联了 RCE 演示、补丁争议与疑似在野利用，并指出快速发布组件扩大攻击面的风险。","source",{"_77":101},"links",{"_62":100},"publishedAt","2026-11-16T12:48:03.000Z","discoveredAt","2026-11-16T13:39:14.376Z","timelineAt","category","activity","tags",[80,97,78,98,86,99],"score",72,"selected",true,"channel","news","story",{"_90":91,"_13":92},"x","readingMode","full","author","Eduard Kovacs","body",{"_93":-5,"_62":94,"_95":-5,"_96":60},"outline",[],"relatedStories",[89],"topics",[69,70,71,72,73,74],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation",false,"bodyLanguage","original","factId","fMx5bMJkwhGg","reportCount",1,"additionalSourceCount",0,{"_75":87,"_77":88},{"_75":85,"_77":86},{"_75":83,"_77":84},{"_75":81,"_77":82},{"_75":79,"_77":80},{"_75":76,"_77":78},"slug","malware","name","恶意软件","exploited","在野利用","black-market","数据窃取与黑产","ransomware","勒索软件","mobile","移动端","kaspersky","Kaspersky / Securelist",{"_90":91,"_13":92},"publicId","c3aa0ae4-ec75-4e17-a533-fd9b4a2b83e7","Kaspersky称Telegram Widgets疑遭在野利用","zh","<p><strong>Kaspersky has warned that a vulnerability in Telegram’s newly launched widgets may have been exploited in the wild to deliver the WebRAT malware. The warning came shortly after researchers showed what they described as remote code execution through the new feature.</strong>\n\n\n\n</p><p>In a November 13 <a href=\"https://t.me/kasperskylab_ru/7881\">post</a> on its Russian-language Telegram channel, the security firm said it had observed malicious activity that it suspects is tied to the flaw. According to the company, exploitation took place when users visited certain Telegram channels.\n\n\n\n</p><p>Kaspersky said the activity results in a PowerShell script running without the user’s knowledge. The script fetches and launches WebRAT, a piece of malware also known as Salat Stealer.\n\n\n\n</p><p>WebRAT is a Rust-based trojan that gives attackers control of the infected system. It can also steal cryptocurrency wallet and Telegram account data.\n\n\n\n</p><p>Kaspersky did not share technical details on the exploitation, or say how many users were targeted. Its main recommendation was “do not launch widgets in Telegram until a fix is released.”\n\n\n\n</p><p>Telegram CEO Pavel Durov <a href=\"https://x.com/durov/status/2120148866469376463\">promoted</a> the widgets feature on X on November 10, saying that any message on the platform can now become an app.</p><p><span>Advertisement. Scroll to continue reading.</span></p><p>A day later, researchers at V12 posted a <a href=\"https://x.com/v12sec/status/2120471754166415821\">video</a> on X with the caption “Any telegram message can now become RCE.” The video showed an interaction with a bot causing the Calculator app to open on an Android phone.\n\n\n\n</p><p>Telegram <a href=\"https://x.com/telegram/status/2120502876728680765\">replied</a> the same day, saying the Android issue “was fixed yesterday, and the fix was deployed to all users earlier today.”\n\n\n\n</p><p>V12 later published a <a href=\"https://x.com/v12sec/status/2121045471808622776\">second video</a>, saying it had another RCE exploit that worked against the supposedly patched Telegram client for Windows. In the researchers’ view, letting QuickJS, a JavaScript engine, run inside messages without a sandbox creates a large attack surface.\n\n\n\n</p><p>Durov has <a href=\"https://x.com/durov/status/2121274027285307903\">dismissed</a> the reports. “No one could be hacked just by receiving a message,” he wrote on X on November 13.\n\n\n\n</p><p>According to Durov, an attack required the user to first start a third-party service, and that scenario has since been fully patched on the server side. He challenged skeptics to hack his own account.\n\n\n\n</p><p><em>SecurityWeek</em> has reached out to Telegram for comment and will update this article if the company responds.\n\n\n\n</p><p><strong>Related</strong>: <a href=\"https://www.securityweek.com/recent-unrealircd-vulnerability-exploited-in-attacks/\">Recent UnrealIRCd Vulnerability Exploited in Attacks</a>\n\n\n\n</p><p><strong>Related</strong>: <a href=\"https://www.securityweek.com/critical-xen-orchestra-flaws-exploited-in-attacks/\">Critical Xen Orchestra Flaws Exploited in Attacks</a>\n\n\n\n</p><p><strong>Related</strong>: <a href=\"https://www.securityweek.com/exploited-outlook-zero-day-among-1094-flaws-patched-by-microsoft/\">Exploited Outlook Zero-Day Among 1,094 Flaws Patched by Microsof</a>t\n\n\n\n</p><p><strong>Related</strong>: <a href=\"https://www.securityweek.com/ibm-aspera-faspex-signalwire-freeswitch-vulnerabilities-exploited-in-attacks/\">IBM Aspera Faspex, SignalWire FreeSwitch Vulnerabilities Exploited in Attacks</a>\n\n\n\n</p>","zhKind","complete","漏洞利用","数据窃取","Kaspersky","https://www.securityweek.com/telegram-widgets-hit-by-rce-demos-malware-warning-days-after-launch/","SecurityWeek",{"_103":104,"_105":-5},"changelogVersion","2026-10-01T08:00","release"]
