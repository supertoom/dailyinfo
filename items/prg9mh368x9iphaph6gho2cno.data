[{"_1":2,"_3":4},"root",{"_5":112},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1793621937000,"id","prg9mh368x9iphaph6gho2cno","title","Byoky 发布开源 AI API 密钥钱包，支持 Chrome、Firefox、iOS 和 Android","originalTitle","Byoky: Open-source wallet for AI API keys","summary","Byoky 是一款开源 AI API 密钥钱包，提供 Chrome、Firefox 扩展及 iOS、Android 应用，可在用户设备上加密保存 OpenAI、Anthropic、Google Gemini 等提供商密钥，并向应用返回会话令牌。","reason","source",{"_78":111},"links",{"_61":110},"publishedAt","2026-11-02T06:00:33.000Z","discoveredAt","2026-11-02T06:39:32.011Z","timelineAt","category","blue-team","tags",[102,81,103,104,105,106,107,108,109],"score",50,"selected",false,"channel","news","story",{"_95":96,"_13":97},"x","readingMode","full","author","Anamarija Pogorelec","body",{"_98":-5,"_61":99,"_100":-5,"_101":36},"outline",[],"relatedStories",[94],"topics",[68,69,70,71,72,73,74,75],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","f2pBhmeh2SBY","reportCount",1,"additionalSourceCount",0,{"_76":92,"_78":93},{"_76":90,"_78":91},{"_76":88,"_78":89},{"_76":86,"_78":87},{"_76":84,"_78":85},{"_76":82,"_78":83},{"_76":80,"_78":81},{"_76":77,"_78":79},"slug","tools","name","工具与平台","ai-security","AI 安全","ai-agent","AI Agent 安全","crypto","密码学","identity","身份与访问","mozilla","Mozilla / Firefox","apple","Apple / 苹果","google","Google / 谷歌",{"_95":96,"_13":97},"publicId","06087ac4-176c-4c65-8fb6-3494068fbb4d","Byoky 发布开源 AI API 密钥钱包","zh","<p>Byoky is an open-source wallet for AI API keys, available as a Chrome and Firefox extension and as iOS and Android apps.</p><p>Users store their keys for OpenAI, Anthropic, Google Gemini and other providers in it, encrypted on their own device. Apps that want those keys ask the wallet for access, and the wallet sends each request to the provider itself. The app gets a session token. The key stays in the wallet.</p><p><img src=\"/dailyinfo/media/80709a4aa7ad0859.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Byoky AI API key wallet\" title=\"Byoky\"></p><p>Byoky goes after the habit of pasting a key into a web app’s settings page to try a new tool. “A key pasted into a settings page is a key you no longer control,” the project’s homepage says. Byoky copies the model of MetaMask, the crypto wallet that decentralized apps connect to: the app asks, the user approves, and one click revokes access.</p><p>Users set a master password and add their keys. Byoky encrypts them with AES-256-GCM, a standard cipher that also detects tampering, using a key derived from the password through 600,000 rounds of PBKDF2. That iteration count makes each guess slow for anyone who steals the encrypted vault and tries to crack the password. Byoky requires a password of at least 12 characters.</p><p>Developers keep the official Anthropic or OpenAI library and hand it a session key and a fetch function from Byoky’s SDK. Streaming, tool calls and image inputs pass through, according to the documentation. Users can cap spending per app, and the wallet logs every request locally with the app’s origin, the provider and the status.</p><p>The wallet supports 13 cloud providers plus local Ollama and LM Studio servers. It can also translate between Anthropic, OpenAI, Gemini and Cohere request formats, so a user can drag an app written for Claude onto a GPT key without the developer touching code.</p><p>Command-line agents such as OpenClaw, Claude Code and Hermes connect through a local proxy called the bridge. The bridge rejects requests that lack a bridge token, a check meant to stop other programs on the same machine from spending the keys. It also does something less advertised. When a third-party agent runs on a Claude Pro or Max subscription token, the bridge renames the agent’s tools and moves its system prompt so that Anthropic’s first-party detection accepts the request.</p><p>Byoky is available for free on <a href=\"https://github.com/MichaelLod/byoky\">GitHub</a>.</p><p><img src=\"/dailyinfo/media/1a550cf184e809a0.gif\" loading=\"lazy\" decoding=\"async\"></p><p><strong>Must read:</strong></p><ul>\n<li><a href=\"https://www.helpnetsecurity.com/2026/07/08/20-latest-open-source-cybersecurity-tools/\">20 open-source cybersecurity tools to keep your team ready for anything</a></li>\n<li><a href=\"https://www.helpnetsecurity.com/2025/01/13/alexis-wales-github-ciso-security-strategy/\">GitHub CISO on security strategy and collaborating with the open-source community</a></li>\n</ul><p><img src=\"/dailyinfo/media/93223e2e45672130.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong>Subscribe to the Help Net Security ad-free monthly newsletter to stay informed on the essential open-source cybersecurity tools. <a href=\"https://www.helpnetsecurity.com/newsletter/\">Subscribe here!</a></strong></p><p><img src=\"/dailyinfo/media/93223e2e45672130.webp\" loading=\"lazy\" decoding=\"async\"></p>","zhKind","complete","工具发布","凭据","加密","大模型","Agent 安全","Google","Mozilla","Apple","https://www.helpnetsecurity.com/2026/11/02/byoky-open-source-ai-api-key-wallet/","Help Net Security",{"_113":114,"_115":-5},"changelogVersion","2026-10-01T08:00","release"]
