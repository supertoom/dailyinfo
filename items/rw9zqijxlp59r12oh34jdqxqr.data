[{"_1":2,"_3":4},"root",{"_5":91},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1794195833000,"id","rw9zqijxlp59r12oh34jdqxqr","title","vLLM 修复 Phi-4 多模态音频编码器注意力矩阵驻留导致的 OOM 崩溃","originalTitle","vLLM: Phi-4 multimodal audio encoder materializes and retains full attention matrices: a single max-length audio OOM-crashes the vLLM engine","summary","vLLM 的 Phi-4 多模态音频编码器因默认使用 eager attention 并保留各层完整注意力矩阵，单次合法音频请求即可导致 OOM。原文在 vllm/vllm-openai:v0.31.0 上以 19.2 MB、600 s 静音 WAV 复现 EngineDeadError，致整个服务停止响应；该问题已在 MR60614 修复。","reason","文章定位到 attention 矩阵驻留这一关键成因，并用单次合法音频请求复现引擎崩溃，便于评估部署风险与修复优先级。","source",{"_73":90},"links",{"_60":89},"publishedAt","2026-10-28T21:15:41.000Z","discoveredAt","2026-10-29T00:15:59.869Z","timelineAt","category","vuln","tags",[84,85,86,74,87,88],"score",74,"selected",true,"channel","news","story",{"_81":82,"_13":83},"x","readingMode","full","author","body","outline",[],"relatedStories",[80],"topics",[67,68,69,70],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","ffM2nu3S_QK4","reportCount",1,"additionalSourceCount",0,{"_71":78,"_73":79},{"_71":76,"_73":77},{"_71":31,"_73":75},{"_71":72,"_73":74},"slug","ai-security","name","AI 安全","漏洞披露","ai-agent","AI Agent 安全","microsoft","Microsoft / 微软",{"_81":82,"_13":83},"publicId","f14d4155-6933-452c-8c7c-49b5bad479f1","vLLM Phi-4音频编码器可被合法请求致OOM","漏洞","复现","补丁","大模型","Microsoft","https://github.com/advisories/GHSA-8397-8qf6-f2gm","GitHub 安全公告",{"_92":93,"_94":-5},"changelogVersion","2026-10-01T08:00","release"]
