[{"_1":2,"_3":4},"root",{"_5":88},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1794195835000,"id","x6v50jsntf1djotu9h64gjisa","title","OpenSSH musl 密码认证绕过漏洞 CVE-2026-123158 可导致 RCE","originalTitle","CVE-2026-123158 | OpenSSH musl Password Authentication Bypass & Remote Code Execution Vulnerability (*sshole)","summary","OpenSSH sshd 10.6p2 之前版本在 Linux 使用 musl libc 且未启用 PAM 时存在认证绕过漏洞 CVE-2026-123158。远程攻击者若知道某个未设置密码的账户名（密码字段为 *），即可登录该账户并触发 RCE；受影响部署包括默认配置下的 Alpine Linux、OpenWrt 及其他嵌入式设备。","reason","source",{"_72":87},"links",{"_61":86},"publishedAt","2026-11-06T23:29:54.000Z","discoveredAt","2026-11-07T04:28:29.699Z","timelineAt","category","vuln","tags",[83,84,85],"score",60,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","Horizon3","body",{"_79":-5,"_61":80,"_81":-5,"_82":36},"outline",[],"relatedStories",[75],"topics",[68,69],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","ft52aJ7I-VMc","reportCount",1,"additionalSourceCount",0,{"_70":30,"_72":74},{"_70":71,"_72":73},"slug","research","name","技术研究","漏洞披露",{"_76":77,"_13":78},"publicId","9752aa65-824d-43a4-962f-2d752946dc78","OpenSSH musl认证绕过漏洞可致RCE","zh","<p>CVE-2026-123158, known as *sshole, is an authentication bypass in OpenSSH sshd before 10.6p2 on Linux systems that use musl libc without PAM. It affects products that run OpenSSH on musl, such as Alpine Linux (in its default configuration), OpenWrt, and other embedded devices. A remote attacker who knows the name of an account with no password set (a * in its password field) can log in as that…</p><p><a href=\"https://horizon3.ai/attack-research/vulnerabilities/cve-2026-123158/\">Source</a></p>","zhKind","complete","漏洞","漏洞利用","漏洞分析","https://horizon3.ai/attack-research/vulnerabilities/cve-2026-123158/","Horizon3.ai",{"_89":90,"_91":-5},"changelogVersion","2026-10-01T08:00","release"]
