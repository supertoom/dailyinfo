[{"_1":2,"_3":4},"root",{"_5":93},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1794616827000,"id","bzxsk4iknxo17c6yqkk8qii1v","title","CISA 将 OpenSSH、GPUStack、FreeSWITCH 和 IBM Aspera 漏洞列入 KEV","originalTitle","CISA Warns of Active Exploitation of OpenSSH, GPUStack, FreeSWITCH, and IBM Flaws","summary","CISA 因已有在野利用证据，将 GPUStack、SignalWire FreeSwitch、OpenBSD OpenSSH 和 IBM Aspera Faspex 的 4 个漏洞加入 KEV 目录，CVSS 分数分别为 9.8、9.8、8.1 和 9.8。","reason","多家观测方记录了 SSHole 的利用尝试与入侵后行为，可用于研判 OpenSSH 暴露面的排查优先级。","source",{"_68":92},"links",{"_81":91},"publishedAt","2026-11-10T06:31:42.000Z","discoveredAt","2026-11-10T07:22:19.943Z","timelineAt","category","activity","tags",[73,85,86,71,69,77,79,87,88,89,90],"score",79,"selected",true,"channel","news","story","x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_59":80,"_81":-5,"_82":83,"_84":37},"outline",[],"relatedStories",[],"topics",[60,61,62,63,64,65],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_66":78,"_68":79},{"_66":76,"_68":77},{"_66":74,"_68":75},{"_66":72,"_68":73},{"_66":70,"_68":71},{"_66":67,"_68":69},"slug","malware","name","恶意软件","attack","攻击活动","exploited","在野利用","vuln","漏洞披露","botnet","僵尸网络","cisa","CISA","<p><span><i></i><span>Ravie Lakshmanan</span><i></i><span>2026年11月10日</span></span><span>漏洞 / 网络攻击</span></p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjVAsrcYxVs8sJe7IiSD6WkTC4yPv0eLfup7dwcsS0NLcAAgoY__wyC3UFCR90PL2ziKCEW-vMNIEQXES-8uAG-MxuXlyIDdQGeNREm8yFv3tbvsCVXXRyRGT4ORirvcVKP_uD62XHYy9w3x_P0o7XzkguJPwq_1vV2jPxxnZWbhAHHUJ3YJ6HbTlXb0shyphenhyphen/s1600/openssh.png\"><img alt=\"\" src=\"/dailyinfo/media/220a6468784dc4f6.webp\" loading=\"lazy\" decoding=\"async\"></a></p><p>美国网络安全和基础设施安全局（CISA）于周一<a href=\"https://www.cisa.gov/news-events/alerts/2026/11/09/cisa-adds-four-known-exploited-vulnerabilities-catalog\">将</a>四个影响 GPUStack、SignalWire FreeSwitch、OpenBSD OpenSSH 和 IBM Aspera Faspex 的安全漏洞<a href=\"https://www.cisa.gov/known-exploited-vulnerabilities-catalog\">加入</a>其已知被利用漏洞（KEV）目录，理由是有证据表明这些漏洞正在被积极利用。</p><p>漏洞列示如下 -</p><ul>\n  <li><strong><a href=\"https://www.ibm.com/support/pages/node/7295921\">CVE-2026-123218</a></strong>（CVSS 分数：9.8）- IBM Aspera Faspex 中的授权不当漏洞，可能允许已认证用户构造特定消息以绕过授权，从而导致权限提升。（已于 2026 年 11 月修复）</li>\n  <li><strong><a href=\"https://github.com/signalwire/freeswitch/security/advisories/GHSA-mg63-h38w-8p9p\">CVE-2026-116779</a></strong>（CVSS 分数：9.8）- SignalWire FreeSwitch 中的代码注入漏洞，可能导致配置和凭据泄露、任意呼叫控制以及命令执行。（已于 2026 年 10 月修复）</li>\n  <li><strong><a href=\"https://www.openssh.org/releasenotes.html#10.6p2\">CVE-2026-123158</a></strong> aka SSHole（CVSS 分数：8.1）- Linux 上 OpenBSD OpenSSH 中的意外状态码或返回值漏洞，可能允许绕过身份验证。（已于 2026 年 11 月修复）</li>\n  <li><strong><a href=\"https://github.com/gpustack/gpustack/security/advisories/GHSA-gj9m-f8ph-pmhr\">CVE-2026-102895</a></strong>（CVSS 分数：9.8）- GPUStack 中的身份验证不当漏洞，可能允许利用身份验证不当漏洞获得未认证的管理员访问权限，包括更改用户和模型、持久创建管理员 API 密钥、泄露 worker 和云提供商机密，以及通过 POST /v2/inference-backends/from-yaml 执行代码。（已于 2026 年 7 月修复）</li>\n</ul><p>CVE-2026-123158 被加入 KEV 目录，源于自 2026 年 11 月 6 日起有关针对该漏洞发起利用尝试的报告。据 <a href=\"https://thehackernews.com/2026/11/hackers-exploited-openssh-sshole-flaw.html\">Previdian</a> 表示，目前已记录来自 14 个不同 IP 地址的共 22 次利用尝试。</p><p>Defused Cyber 在 2026 年 11 月 7 日于 X 上<a href=\"https://x.com/DefusedCyber/status/2118996075092521197\">分享的一则帖子</a>中表示，其“观察到少量攻击者 targeting SSHole”，但强调目前利用活动尚未广泛蔓延。</p><p>据 <a href=\"https://sshole.events.greynoise.io/\">GreyNoise</a> 称，针对其蜜罐网络的首次利用尝试于 2026 年 11 月 7 日 UTC 凌晨 12:46 被观察到。迄今已从六个源 IP 地址检测到已确认的利用后活动，代表 18 条不同的攻击链。</p><p>这些活动包括侦察、查询云元数据服务、尝试读取密码哈希和 root SSH 密钥，以及试图修改 SSH authorized_keys 文件以获得持久访问权限。</p><p>在至少一个案例中，观察到未知威胁行为者部署 TAC Agent，这是一款基于 Python 的命令与控制（C2）代理，能够执行 shell 命令、进行系统侦察、枚举目录、传输文件并实现自我更新。</p><p>威胁情报公司 watchTowr <a href=\"https://x.com/watchtowrcyber/status/2118636513739317525\">表示</a>，其还观察到该 OpenSSH 漏洞在真实环境中被武器化，用于僵尸网络和加密货币挖矿活动。</p><p>在 2026 年 7 月 31 日<a href=\"https://github.com/gpustack/gpustack/security/advisories/GHSA-gj9m-f8ph-pmhr\">发布</a>的 CVE-2026-102895 公告中，GPUStack Python 包的维护者致谢 Nikko Enggaliano、Wei Yunzhou、Rui Yang 和 Haoyu Wang 独立报告了该漏洞，并补充称 Ulex Innovative Systems 的 Javier Sixto 报告了“真实环境中的主动利用活动”。</p><p>目前没有公开报告说明其他漏洞是如何被利用的、攻击者是谁，以及此类行动的规模。建议联邦民事行政部门（FCEB）机构在 2026 年 11 月 12 日之前应用这些修复措施。</p><p>觉得这篇文章有意思？在 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a> 上关注我们，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","漏洞","漏洞利用","Oracle","Red Hat","Ubuntu","Debian","https://thehackernews.com/2026/11/cisa-warns-of-active-exploitation-of.html","The Hacker News",{"_94":95,"_96":-5},"changelogVersion","2026-10-01T08:00","release"]
