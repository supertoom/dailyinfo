[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":-5,"_57":36,"_58":59},"expiresAt",1794444099000,"id","udrwkno2t7pf184j123p0kn2l","title","Google Chrome 157 稳定版修复 83 项安全漏洞","originalTitle","Stable Channel Update for Desktop","summary","Google Chrome Stable channel 已更新至 Windows 和 Mac 的 157.0.8103.78/.79，以及 Linux 的 157.0.8103.78，更新将在未来几天至几周内推送。","reason","source",{"_64":78},"links",{"_59":77},"publishedAt","2026-11-11T20:02:26.373Z","discoveredAt","2026-11-11T21:19:12.705Z","timelineAt","category","vuln","tags",[74,75,67,76],"score",69,"selected",false,"channel","news","story","x","readingMode","full","author","Srinivas Sista","body",{"_70":-5,"_59":71,"_72":-5,"_73":36},"outline",[],"relatedStories",[],"topics",[60,61,62],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_63":68,"_64":69},{"_63":66,"_64":67},{"_63":30,"_64":65},"slug","name","漏洞披露","browser","浏览器","google","Google / 谷歌","zh","<p>&nbsp;<span><span>The Stable channel has been updated to 157.0.8103.78/.79 for Windows and</span><span> </span><span>Mac and </span></span><span>157.0.8103.78 to </span><span><span>Linux which will roll out over the coming days/weeks. A full list of changes in this build is available in the <a href=\"https://chromium.googlesource.com/chromium/src/+log/157.0.8103.51..157.0.8103.79?pretty=fuller&amp;n=10000\">Log</a>.</span></span></p><p><span><span>Security Fixes and Rewards</span></span></p><p><span><span><br></span></span><span><span>Note: Access to bug details and links may be kept restricted until a majority of users are updated with a fix. We will also retain restrictions if the bug exists in a third party library that other projects similarly depend on, but haven’t yet fixed.</span></span></p><p><b><span><span><span><i><br></i></span></span></span></b><span><span>This update includes </span><a href=\"https://issues.chromium.org/issues?q=customfield1223088:2-M157\"><span>83</span></a><span> security fixes. Please see the </span><a href=\"https://www.chromium.org/Home/chromium-security\"><span>Chrome Security Page</span></a><span> for more information.</span></span></p><p><b><span><span><span><br></span></span></span></b><span><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/568699166\"><span>568699166</span></a><span>] Critical CVE-2026-126885: Use after free in ServiceWorker. </span><span>Reported by Xinyang Ge on 2026-10-02</span></span><b><span><br></span></b><span><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/575524700\"><span>575524700</span></a><span>] Critical CVE-2026-126895: Use after free in CSS. </span><span>Reported by Xinyang Ge on 2026-10-19</span></span><b><span><br></span></b><span><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/576736463\"><span>576736463</span></a><span>] Critical CVE-2026-126879: Use after free in Layout. </span><span>Reported by Xinyang Ge on 2026-10-22</span></span><b><span><br></span></b><span><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/580857377\"><span>580857377</span></a><span>] Critical CVE-2026-126846: Use after free in Skia. </span><span>Reported by Google on 2026-11-02</span></span><b><span><br></span></b><span><span>[TBD][</span><a href=\"https://issues.chromium.org/issues/580921803\"><span>580921803</span></a><span>] Critical CVE-2026-126911: Use after free in Accessibility. </span><span>Reported by Andrew Boni on 2026-11-02</span></span><b><span><br></span></b><span><span>[$4,000][</span><a href=\"https://issues.chromium.org/issues/567827593\"><span>567827593</span></a><span>] High CVE-2026-126864: Use after free in V8. </span><span>Reported by Jihyeon Jeong (Compsec Lab, Seoul National University / Research Intern) on 2026-09-30</span></span><b><span><br></span></b><span><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/560620348\"><span>560620348</span></a><span>] High CVE-2026-126889: Off-by-one error in V8. </span><span>Reported by Google on 2026-09-12</span></span><b><span><br></span></b><span><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/563340397\"><span>563340397</span></a><span>] High CVE-2026-126859: Link following in FileSystem. </span><span>Reported by Google on 2026-09-18</span></span><b><span><br></span></b><span><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/567611696\"><span>567611696</span></a><span>] High CVE-2026-126886: Use after free in Frames. </span><span>Reported by Xinyang Ge (Anthropic), assisted by Claude on 2026-09-29</span></span><b><span><br></span></b><span><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/567611698\"><span>567611698</span></a><span>] High CVE-2026-126887: Use after free in Animation. </span><span>Reported by Xinyang Ge (Anthropic), assisted by Claude on 2026-09-29</span></span><b><span><br></span></b><span><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/568906910\"><span>568906910</span></a><span>] High CVE-2026-126870: Uninitialized resource in ANGLE. </span><span>Reported by Google on 2026-10-02</span></span><b><span><br></span></b><span><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/569286603\"><span>569286603</span></a><span>] High CVE-2026-126912: Buffer overflow in Skia. </span><span>Reported by Xinyang Ge on 2026-10-05</span></span><b><span><br></span></b><span><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/569674220\"><span>569674220</span></a><span>] High CVE-2026-126919: Use after free in BrowserTag. </span><span>Reported by Xinyang Ge on 2026-10-05</span></span><b><span><br></span></b><span><span>[TBD][</span><a href=\"https://issues.chromium.org/issues/572312779\"><span>572312779</span></a><span>] High CVE-2026-126878: Information leak in Core. </span><span>Reported by Anthropic and Ada Logics on 2026-10-10</span></span><b><span><br></span></b><span><span>[TBD][</span><a href=\"https://issues.chromium.org/issues/572501958\"><span>572501958</span></a><span>] High CVE-2026-126909: Use after free in Passwords. </span><span>Reported by JonathanBouman on 2026-10-11</span></span><b><span><br></span></b><span><span>[TBD][</span><a href=\"https://issues.chromium.org/issues/572988453\"><span>572988453</span></a><span>] High CVE-2026-126847: Type confusion in V8. </span><span>Reported by Salvatore Gulizia (Serotav) on 2026-10-13</span></span><b><span><br></span></b><span><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/573263421\"><span>573263421</span></a><span>] High CVE-2026-126853: Uninitialized resource in Skia. </span><span>Reported by Google on 2026-10-13</span></span><b><span><br></span></b><span><span>[TBD][</span><a href=\"https://issues.chromium.org/issues/573335176\"><span>573335176</span></a><span>] High CVE-2026-126865: Use after free in DOM. </span><span>Reported by Jinu Kim (@uz56764) of EUCLIDSOFT on 2026-10-14</span></span><b><span><br></span></b><span><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/574025697\"><span>574025697</span></a><span>] High CVE-2026-126916: Integer overflow in V8. </span><span>Reported by OpenAI Codex Security (kylebot) on 2026-10-15</span></span><b><span><br></span></b><span><span>[TBD][</span><a href=\"https://issues.chromium.org/issues/574035865\"><span>574035865</span></a><span>] High CVE-2026-126903: Improper state validation in ANGLE. </span><span>Reported by arang on 2026-10-15</span></span><b><span><br></span></b><span><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/574059463\"><span>574059463</span></a><span>] High CVE-2026-126910: Type confusion in V8. </span><span>Reported by Vlad Stolyarov (Anthropic), assisted by Claude on 2026-10-16</span></span><b><span><br></span></b>