[{"_1":2,"_3":4},"root",{"_5":103},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795221643000,"id","wo6gb97t314hexogr26ggh5vz","title","Bell Canada 确认“智能体型”攻击者入侵系统并窃取企业客户数据","originalTitle","Bell Canada says 'agentic' hacker stole enterprise customer data","summary","Bell Canada 确认，“智能体型”威胁行为者于 2026 年 11 月 17 日访问其多个系统，并从用于订购和配置电信电路的 Maximo 预生产环境中外泄企业客户数据，可能涉及名称、职位、企业邮箱、电话号码、业务地址、工单标题及部分 IP 地址。","reason","source",{"_75":102},"links",{"_61":101},"publishedAt","2026-11-20T18:51:43.000Z","discoveredAt","2026-11-20T18:54:28.967Z","timelineAt","category","activity","tags",[78,99,80,76,100,84],"score",62,"selected",false,"channel","news","story",{"_86":87,"_13":88},"x","readingMode","full","author","Lawrence Abrams","body",{"_95":-5,"_61":96,"_97":-5,"_98":36},"outline",[89],"relatedStories",[85],"topics",[68,69,70,71,72],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fcZuqVHI5iiQ","reportCount",1,"additionalSourceCount",0,{"_73":83,"_75":84},{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","ai-security","name","AI 安全","attack","攻击活动","ai-offense","AI 攻防","supply-chain","供应链安全","cisa","CISA",{"_86":87,"_13":88},"publicId","ac43fd89-a5de-4bc5-accd-6f6aaf8489f3","Bell Canada确认企业客户数据被窃",{"_11":90,"_91":92,"_93":94},"sec-1","text","Uncover email threats your existing defenses may miss.","level",2,"zh","<p><img alt=\"Bell Canada\" height=\"900\" src=\"/dailyinfo/media/f01ec106c26a2c09.jpg\" srcset=\"/dailyinfo/media/cb69b243001661d6.jpg 720w, /dailyinfo/media/2cf91ba9ff78efc8.jpg 1200w, /dailyinfo/media/f01ec106c26a2c09.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>Bell Canada has confirmed that an \"agentic\" threat actor breached its systems on November 17, 2026, and stole enterprise customer data, including information from a system used to order and provision telecommunications circuits.</p><p>Bell is one of Canada's largest telecommunications providers, offering wireless, internet, television, and enterprise networking services.</p><p>BleepingComputer first learned of the incident after receiving a tip from a customer who shared a breach notification sent by Bell's Information Security Team.</p><p><a href=\"https://www.wiz.io/lp/claude-code-security-best-practices-cheat-sheet?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q3_INB_FORM_Claude-Code-Security-Best-Practices&amp;sfcid=701Vh00000gJQZuIAO&amp;utm_term=FY27Q4-bleepingcomputer-article-970x250-Nov&amp;utm_content=Claude-Code-Best-Practices\"><img src=\"/dailyinfo/media/a7d6a5dab4546e9f.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>According to the notification, an unauthorized party accessed a pre-production environment of Bell's Maximo system, which the company uses to order and provision telecommunications network connections.</p><p>Bell warned that information belonging to the recipient's organization may have been stolen, including business contact information such as names, job titles, corporate email addresses, phone numbers, and business addresses.</p><p>The potentially exposed data also includes information contained in ticket titles and some IP addresses associated with network elements or systems, along with limited contextual information.</p><p>However, Bell said the affected dataset did not contain credentials, highly sensitive personal information, PDFs, file attachments, or other supplementary information stored in Maximo.</p><p>When contacted by BleepingComputer, Bell confirmed the intrusion and said that an \"agentic threat actor\" had accessed multiple systems and stolen enterprise customer data.</p><p>\"Bell is investigating a cybersecurity incident that occurred on November 17 in which an agentic threat actor accessed some of our systems, including a system used for ordering and provisioning circuits, and exfiltrated some enterprise customer data,\" Bell told BleepingComputer.</p><p>\"Upon learning of the breach, we immediately contained the incident and secured our systems. There has been no impact to customer services.\"</p><p>The company's description of the attacker as \"agentic\" suggests that AI-powered tools were used during the breach.</p><p>Bell says it is sharing indicators of compromise (IOCs) and threat-hunting information with enterprise customers and the Canadian Centre for Cyber Security (CCCS).</p><p>However, Bell has not publicly released the indicators of compromise and has not responded to BleepingComputer's request to share them so other organizations can check their environments for related activity.</p><p>Bell told BleepingComputer that it has not yet identified the threat actor responsible for the attack.</p><p>\"We currently do not know the attribution,\" Bell said.</p><p>Bell has not disclosed how many enterprise customers were impacted or the total amount of data stolen.</p><p>In its customer notification, Bell urged organizations to remain cautious of unsolicited requests and social engineering attempts by individuals impersonating the telecommunications provider.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/0e510643164e7d91.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Uncover email threats your existing defenses may miss.</a>\n        </h2><p>Adaptive Security's AI agents analyze email intent, context, and behavior to uncover phishing, business email compromise, and invoice fraud.</p><p>See what's getting through with a 14-day read-only scan of Microsoft 365 or Google Workspace, with no MX changes.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Start your free email security scan.</a>\n    </p>","zhKind","complete","数据泄露","供应链","https://www.bleepingcomputer.com/news/security/bell-canada-says-agentic-hacker-stole-enterprise-customer-data/","BleepingComputer",{"_104":105,"_106":-5},"changelogVersion","2026-10-01T08:00","release"]
