[{"_1":2,"_3":4},"root",{"_5":110},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794616829000,"id","gu6ue1ilx7hnlwxcatqdphg4v","title","自称 Department of Peace 的黑客泄露逾 41,000 名 DHS 员工记录","originalTitle","Hacktivists leak 41,000 DHS staff records, revealing undercover ICE agents","summary","自称 Department of Peace 的黑客组织泄露了超过 41,000 名美国国土安全部（DHS）员工的姓名、办公室、联系方式和任务信息，并交由 Distributed Denial of Secrets 发布为 Icepick；该组织称数据取自 DHS 使用的 Okta SSO 服务，Okta 否认其系统被攻破。","reason","报道核验了泄露记录与相关人员信息，并梳理其规模和近期美国联邦机构连续数据泄露的背景。","source",{"_74":109},"links",{"_102":108},"publishedAt","2026-10-29T10:16:18.000Z","discoveredAt","2026-10-29T23:40:25.841Z","timelineAt","category","activity","tags",[75,106,107,79,81],"score",81,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Sinisa Markovic","body",{"_61":101,"_102":-5,"_103":104,"_105":37},"outline",[86,87,88,89],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fBxb4nT_jrlg","reportCount",2,"additionalSourceCount",1,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","attack","name","攻击活动","black-market","数据窃取与黑产","identity","身份与访问","cisa","CISA",{"_83":84,"_13":85},"publicId","7487c263-dd89-4937-9f17-8571afd85c66","逾4.1万名DHS员工记录被公开",{"_11":99,"_91":100,"_93":94},{"_11":97,"_91":98,"_93":94},{"_11":95,"_91":96,"_93":94},{"_11":90,"_91":92,"_93":94},"sec-4","text","该搜索工具背后的黑客","level",3,"sec-3","泄露者称出于政治目的","sec-2","卧底单位和武力使用教官","sec-1","可搜索的 DHS 员工目录","<p>超过 41,000 名美国国土安全部（DHS）员工的姓名、办公室、联系方式和任务分工，已被一个自称“和平部”的黑客行动主义组织泄露。</p><p><img src=\"/dailyinfo/media/833a915a4c3e17cf.webp\" loading=\"lazy\" decoding=\"async\" alt=\"DHS leak\" title=\"Data leak\"></p><p>该组织将数据交给了透明度组织 Distributed Denial of Secrets（DDoSecrets），以及瑞士黑客兼记者 maia arson crimew。DDoSecrets 于 10 月 28 日发布了这份名为 <a href=\"https://ddosecrets.org/article/icepick\">Icepick</a> 的数据集。据这些黑客行动主义者称，这些记录取自 DHS 使用的一项 Okta 单点登录服务。</p><p>Okta 对其系统遭到入侵的说法提出异议。该公司 <a href=\"https://www.reuters.com/legal/government/leak-website-releases-data-tens-thousands-dhs-employees-2026-10-28/\">告诉</a> 路透社：“Okta 是安全的，我们没有证据表明我们的数据或系统遭到破坏。”</p><p>路透社将泄露数据中点名的 6 名 DHS 员工的个人信息与信用局记录和泄露数据进行了比对，并通过直接致电其中 3 人确认了电话号码及其他详细信息。其中一人表示，这是他们第一次听说发生了数据泄露。</p><p>DHS 发言人在向 BBC <a href=\"https://www.bbc.com/news/articles/cq8jzkpjr28vo\">提供</a>的声明中表示，该部门“意识到可能发生了数据泄露，并正在积极采取行动，迅速且有效地处理这一情况。”DHS 补充称：“我们严肃对待针对我们员工和官员的所有安全威胁，并将努力确保所有人都得到适当保护。”该部门表示，有更多信息后，将向公众通报最新情况。</p><p>Icepick 泄露事件是大约一个月内美国联邦机构遭受的第三次重大打击。9 月下旬，ShinyHunters 勒索组织 <a href=\"https://www.helpnetsecurity.com/2026/09/28/fbi-job-portals-offline-shinyhunters-breach/\">声称</a>，在入侵该局的招聘门户后，窃取了 FBI 员工和求职者的个人信息，包括医疗记录。</p><p>几天后，五角大楼的 Defense Manpower Data Center 开始 <a href=\"https://www.helpnetsecurity.com/2026/10/01/pentagon-dmdc-data-breach-3-million-people/\">通知</a> 超过 300 万人，称未经授权的用户通过一个存在漏洞的文件共享系统访问了他们的个人数据，其中包括社会安全号码。</p><h3 id=\"sec-1\">可搜索的 DHS 员工目录</h3><p>Crimew 在 <a href=\"https://icepi.cx/\">icepi.cx</a> 构建了一款在线工具，使这些数据更便于浏览，并在她长期共同研究的记者 Ryan Fae 的协助下，对原始记录进行了清理和丰富。</p><p>该网站收录了 41,191 人和 55,603 个内部群组，以及办公室和地点信息。海关与边境保护局员工占比最大，共有 21,329 条记录；ICE 则有 6,598 条。</p><p>该工具运营者表示，数据是通过自动化和人工研究完善的，该列表并不包含每一名 DHS 员工，源数据中的不准确之处可能也得以保留。为将重点放在该部门的执法和情报部门，CISA 员工默认不会出现在搜索结果中。</p><h3 id=\"sec-2\">卧底单位和武力使用教官</h3><p>内部群组记录涵盖的信息不止职位名称。该网站提供的搜索结果包括含有行动代号的群组、与 Homeland Security Investigations（HSI）认证卧底探员有关的群组，以及似乎赋予员工数字取证和数据分析工具访问权限的群组。</p><p>另一项搜索列出了 ICE 内似乎担任武力使用教官的人员。该网站表示，其中一些人曾参与 ICE 枪击事件。用户还可以按城市查找 ICE 和 HSI 员工。</p><h3 id=\"sec-3\">泄露者称出于政治目的</h3><p>和平部发言人表示，当有人加大压力时，ICE 就会落到这种下场；这是对 DHS 部长 Markwayne Mullin 7 月 17 日所说一番话的一次 <a href=\"https://www.forbes.com/sites/saradorn/2026/07/17/ice-is-turning-up-the-heat-on-the-streets-despite-recent-killings-dhs-secretary-says/\">影射</a>。</p><p>Crimew 称该数据集在规模和影响方面都很大。“对于任何调查 DHS 的人来说，这都是彻底改变游戏规则的东西，”她解释道，并表示这些数据展示了 DHS 的多个机构（包括 ICE）中由谁负责哪些工作，使识别特工及其指挥关系变得更加简单，而且未来多年都将提供《信息自由法》（FOIA）材料。</p><p>DDoSecrets 联合创始人 Emma Best 表示，Icepick 能够识别设计并推动 DHS 政策和行动的人员。她指出，这次泄露事件点名了负责监督秘密行动和卧底行动、政府追查泄密者以及失败的 BlueLeaks 调查的官员，同时还列出了 DHS 移交和驱逐项目中的关键人员。</p><p>Property of the People 执行主任 Ryan Shapiro 博士认为，电子邮件地址和电话号码往往决定一份记录请求会被搁置还是取得结果，而特朗普政府对基本透明度的蔑视使这类工具显得尤为迫切。</p><h3 id=\"sec-4\">该搜索工具背后的黑客</h3><p>Crimew 是一名来自卢塞恩的黑客，此前以 Tillie Kottmann 的名字为人所知，她是 2021 年 Verkada 监控摄像头<a href=\"https://blog.cloudflare.com/about-the-march-8-9-2021-verkada-camera-hack/\">泄露事件</a>背后的黑客。</p><p>她于 2021 年 3 月在美国被<a href=\"https://www.justice.gov/usao-wdwa/pr/swiss-hacker-indicted-conspiracy-wire-fraud-and-aggravated-identity-theft\">指控</a>犯有计算机欺诈和身份盗窃罪，目前仍在瑞士；瑞士不会引渡本国公民，除非他们本人同意。</p><p>2023 年，她在发现一份未设安全措施的航空公司服务器上存放着相关文件后，获取了<a href=\"http://U.S. No Fly List\">美国禁飞名单</a>的副本。这是一份秘密政府名单，列出被禁止乘坐美国境内或上空商业航班的人员。</p><p><img src=\"/dailyinfo/media/52e49394cfa41a2f.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong>订阅我们的突发新闻电子邮件提醒，千万别错过最新的数据泄露、漏洞和网络安全威胁。<a href=\"https://www.helpnetsecurity.com/newsletter/\">立即订阅！</a></strong></p><p><img src=\"/dailyinfo/media/52e49394cfa41a2f.webp\" loading=\"lazy\" decoding=\"async\"></p>","original","zhKind","translation","complete","数据泄露","黑产","https://www.helpnetsecurity.com/2026/10/29/icepick-dhs-leak-ice-undercover-agents/","Help Net Security",{"_111":112,"_113":-5},"changelogVersion","2026-10-01T08:00","release"]
