[{"_1":2,"_3":4},"root",{"_5":133},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":37,"_59":60},"expiresAt",1795480836000,"id","iem1v1rdf735rh87a15ydka7e","title","GT13 攻击活动入侵 Check Point Security Management Servers，至少影响 22 家组织","originalTitle","99 IPs but a C2 ain’t one: An Active Intrusion Campaign Against Check Point Security Management Servers","summary","GreyNoise 发现 GT13 针对 Check Point Security Management Servers 的入侵活动，确认攻击发生于 2026 年 10 月 17 日至 11 月 2 日，至少影响全球 22 家组织，涉及 24 台受控服务器。","reason","文章还原了从漏洞利用、搭建中继到批量控制 Check Point 设备的完整链路，并列出 IOC 与多阶段时间线，便于防守方核对暴露面。","source",{"_75":132},"links",{"_120":131},"publishedAt","2026-11-22T16:00:00.000Z","discoveredAt","2026-11-23T15:36:35.127Z","timelineAt","category","activity","tags",[78,80,124,125,76,126,86,127,128,129,130],"score",89,"selected",true,"channel","news","story",{"_88":89,"_13":90},"x","readingMode","full","author","body",{"_60":119,"_120":-5,"_121":122,"_123":37},"outline",[91,92,93,94,95,96,97,98],"relatedStories",[87],"topics",[67,68,69,70,71,72],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","fmK0Os9Ohv6Q","reportCount",1,"additionalSourceCount",0,{"_73":85,"_75":86},{"_73":83,"_75":84},{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","malware","name","恶意软件","attack","攻击活动","exploited","在野利用","black-market","数据窃取与黑产","ransomware","勒索软件","checkpoint","Check Point",{"_88":89,"_13":90},"publicId","03406016-0248-42d7-8b35-21e19f32f84f","GT13入侵至少22家组织管理服务器",{"_11":117,"_100":118,"_102":103},{"_11":115,"_100":116,"_102":103},{"_11":113,"_100":114,"_102":106},{"_11":111,"_100":112,"_102":106},{"_11":109,"_100":110,"_102":106},{"_11":107,"_100":108,"_102":106},{"_11":104,"_100":105,"_102":106},{"_11":99,"_100":101,"_102":103},"sec-8","text","指标","level",2,"sec-7","攻击时间范围与时间线说明",3,"sec-6","保护其访问权限","sec-5","入侵行动与数据外传","sec-4","建立操作中继盒／跳板","sec-3","HFS 扫描与漏洞利用","sec-2","观察到的攻击者活动","sec-1","活动摘要","<p>GreyNoise 使用我们的全球观测网格（Global Observation Grid，GOG）追踪威胁活动。这是一个传感器网络，旨在吸引针对我们托管基础设施的对抗性扫描和漏洞利用尝试。人们可能会把这些传感器视为传统的“蜜罐”，但这并未充分体现我们部署和管理 GOG 这一复杂网络所具有的多样性、灵活性以及规模。针对我们传感器的未经请求活动即便不是恶意，也至少属于可疑活动。我们的方法使我们能够捕获端到端入侵，并实时分析攻击者基础设施、工具和战术的广泛情况，无需等待耗时的事件响应调查。我们将传感器网络的数据与额外的创新数据源和方法融合，以形成对对手的全面认知。</p><p>‍</p><h2 id=\"sec-1\">活动摘要</h2><ul><li>GreyNoise 最近发现了一场针对 Check Point Security Management Servers 的入侵活动，已确认的攻击活动发生在 2026 年 10 月 17 日至 11 月 2 日之间，全球至少有 22 个不同组织受到影响。</li></ul><ul><li>我们将这组威胁活动追踪为 GreyNoise Threat 13（GT13），它代表针对这 22 个受害组织的对手基础设施、工具以及利用后行动。</li></ul><ul><li>此次定向活动似乎并未聚焦于任何特定地理区域或行业。受影响组织包括在英国、爱尔兰、法国、荷兰、希腊、德国、奥地利、保加利亚、波兰、印度、泰国、越南、韩国、香港、中国、澳大利亚和美国拥有资产的受害者。受害者组织所在行业包括金融服务、能源、政府、交通运输、采矿、工程和制造业。</li></ul><ul><li>目前，我们尚未将 GT13 归因于任何已知或公开追踪的威胁组织。我们当前掌握的信息不足以评估该行为者的动机或其与某个原籍国家的关系。</li></ul><ul><li>该行为者使用了 99 个 IP 地址，其中许多是一次性网络基础设施，用于扫描、利用和控制受害者，其中包括使用被入侵的服务器充当“操作中继箱”（operational relay box，ORB），或更简单地说，作为与下游受害者资产交互的“中继节点”。该行为者使用这一中继箱／中继节点来保存命令结果以及从 24 台不同的 Check Point Security Management Servers 窃取的数据。</li></ul><ul><li>该行为者使用 <a href=\"https://github.com/nmap/nmap\">Nmap</a>、<a href=\"https://github.com/jpillora/chisel\">Chisel</a>、<a href=\"https://github.com/fortra/impacket\">Impacket</a>、<a href=\"https://github.com/paramiko/paramiko\">Paramiko</a> 以及其他 Python 工具，对受害者资产实施入侵活动，包括尝试执行内部侦察、权限提升和横向移动。</li></ul><ul><li>该威胁行为者利用或尝试利用了多个 CVE，包括但不限于：<a href=\"https://viz.greynoise.io/cves/CVE-2026-61500\">CVE-2026-61500</a>（Rejetto HFS）、<a href=\"https://viz.greynoise.io/cves/CVE-2025-5777\">CVE-2025-5777</a>（Citrix NetScaler）、<a href=\"https://viz.greynoise.io/cves/CVE-2024-21893\">CVE-2024-21893</a>（Ivanti）、<a href=\"https://www.cve.org/CVERecord?id=CVE-2026-41089\">CVE-2026-41089</a>（Windows NetLogon）、<a href=\"https://viz.greynoise.io/cves/CVE-2026-16232\">CVE-2026-16232 </a>（Check Point SmartConsole 身份验证绕过以运行脚本），以及 <a href=\"https://viz.greynoise.io/cves/CVE-2026-98432\">CVE-2026-98432</a>（Linux IPv4 UAF）。</li></ul><ul><li>尽管我们观察到了键盘实际操作活动，但我们认为，与大多数现代攻击一样，该行为者使用了 LLM 和智能体系统来执行漏洞扫描、漏洞利用、工具开发，以及与已入侵资产的自动化交互。</li></ul><ul><li>我们对这些攻击活动的可见性大约在 2026 年 11 月 2 日中断，但鉴于该攻击者持续访问受害者 Check Point 设备的能力，我们预计此次入侵活动仍在持续。</li></ul><ul><li>我们正与国际政府合作伙伴和 CERT 机构合作，共享相关情报并通知受害者。</li></ul><p>‍</p><h2 id=\"sec-2\">观察到的攻击者活动</h2><p>我们目睹 GT13 攻击者使用了 99 个 IP 地址，这些地址要么是经由 <a href=\"https://viz.greynoise.io/ips?q=metadata.vpn_service:%22EXPRESS_VPN%22\">ExpressVPN</a> 的出口，要么是被攻陷的受害者 Check Point 设备；活动包括 1400 多个网络会话、800 多条命令行痕迹，以及下载、上传或创建的 1200 多个文件。我们无法在此引用所有细节，但可以重点介绍观察到的 GT13 对手活动，以展示其传统技术以及战术、技术和程序（TTP）。</p><p>‍</p><h3 id=\"sec-3\">HFS 扫描与漏洞利用</h3><p>GT13 威胁行为者使用自动化扫描和漏洞利用流程，通过 <a href=\"https://viz.greynoise.io/cves/CVE-2026-61500\">CVE-2026-61500</a> 攻陷了一台 HFS 服务器。</p><p><strong>2026-10-02 13:17:45 UTC</strong> - 该攻击者扫描并开始利用 HFS 服务器。每次向 HFS loginSrp1 端点发送 POST 请求，都会返回一个全新的签名会话 cookie，其中包含取自 JavaScript Math.random() 函数的“sid”值。通过连续进行多次登录，该攻击者收集了足够的输出，重建 V8 PRNG 算法的内部状态，从而恢复 HFS 会话 cookie 签名密钥，随后伪造出一个已签名的管理员会话 cookie。这使攻击者无需密码即可以管理员身份登录。</p><p><em>向 loginSrp1 发送 POST 请求及响应的示例</em></p><figure><p><img alt=\"\" src=\"/dailyinfo/media/5b06edc06e8c8924.webp\" loading=\"lazy\" decoding=\"async\"></p></figure><p><em>从 200 OK 响应中解码出的 hfs_http blob，显示了被提取的 sid</em></p><figure><p><img alt=\"\" src=\"/dailyinfo/media/94c0482238111f75.webp\" loading=\"lazy\" decoding=\"async\"></p></figure><p>‍</p><p><strong>2026-10-02 13:19:37 UTC</strong> - 几分钟后，我们观察到使用伪造会话 cookie 的管理员请求，这让我们认为此次漏洞利用确实是用于会话伪造的 <a href=\"https://www.cve.org/CVERecord?id=CVE-2026-61500\">CVE-2026-61500</a>，且该服务器尚未安装相应补丁。此时，攻击者已控制该服务器。</p><p><em>带有伪造 cookie 的 HTTP POST 请求示例</em></p><figure><p><img alt=\"\" src=\"/dailyinfo/media/0e7f3d45397d1f67.webp\" loading=\"lazy\" decoding=\"async\"></p></figure><p>‍</p><p>请注意，这个伪造 cookie 包含“allow_session_ip_change:true”，其作用正如字面含义所示，使伪造 cookie 可从任意 IP 地址使用。这对于躲在 VPN 后面的对手或从多个出口发起操作的攻击者来说非常理想。</p><p><strong>2026-10-05 12:21:30 UTC</strong> - 数日后，该攻击者使用相同流程获得访问权限，并安装 HFS 中间件钩子，向已攻陷的服务器下发命令。这使攻击者能够将一个 SSH 密钥追加到 /root/.ssh/authorized_keys。</p><figure><p><img alt=\"\" src=\"/dailyinfo/media/45717e6f8cc4a7b4.webp\" loading=\"lazy\" decoding=\"async\"></p></figure><p>10 月 8 日，我们观察到该攻击者的自动化程序使用 HFS 命令钩子登录已攻陷的服务器并执行“uname -a; df -h / | tail -1; whoami”。此后活动陷入沉寂，直到 10 月 19 日。</p><p>‍</p><h3 id=\"sec-4\">建立操作中继盒／跳板</h3><p><strong>2026-10-19 14:53:48 UTC</strong> - 我们不知道原因（可能是多智能体架构存在问题），但该攻击者没有立即使用 SSH 访问权限。相反，该攻击者的自动化流程重新利用 HFS 漏洞利用路径，伪造新的会话 cookie，并利用 HFS server_code 功能尝试在服务器上下载和安装更多恶意软件。至此可以看出，该攻击者打算将已攻陷的服务器用作中继或“跳板”，以开展进一步的入侵行动。</p><p><em>保存在已攻陷服务器上的 HFS 命令示例。</em></p><figure><p><img alt=\"\" src=\"/dailyinfo/media/d00636cf73351232.webp\" loading=\"lazy\" decoding=\"async\"></p></figure><p>‍</p><p><em>解码后的 base64 数据块示例，显示该攻击者意图将一个疑似“ZULT”Linux 植入程序下载到已受入侵的机器。</em></p><figure><p><img alt=\"\" src=\"/dailyinfo/media/58c679ba4e6894cc.webp\" loading=\"lazy\" decoding=\"async\"></p></figure><p>恶意软件下载失败，攻击者尝试通过检查正在运行的进程、调用 curl 访问该资源以及查看网络配置来排查下载问题。</p><p><em>攻击者随后跟进并尝试检查其植入程序的示例</em></p><figure><p><img alt=\"\" src=\"/dailyinfo/media/eae98a298c502354.webp\" loading=\"lazy\" decoding=\"async\"></p></figure><p>他们无法查明植入程序为何未能下载，因此攻击者于次日通过直接 SSH 连接返回，继续设置其中继。</p><p><strong>2026-10-20 07:22:08 UTC -</strong> 攻击者创建了一个脚本（/root/exfil/srv_post2_&lt;redacted&gt;.py），在该跳板上设置了一个未经身份验证的 HTTP 服务器，随后开始上传文件。首个被外传的 .tgz 文件包含对一台已受入侵的 Check Point Security Management Server 进行网络路由扫描所得的结果，表明攻击者已能访问目标受害资产。</p><figure><p><img alt=\"\" src=\"/dailyinfo/media/b4dddd90e1a460df.webp\" loading=\"lazy\" decoding=\"async\"></p></figure><p>攻击者继续设置其环境，上传并安装了 Nmap 和 <a href=\"https://github.com/jpillora/chisel\">Chisel</a> 等开源工具，随后设置了一个 Chisel 服务器作为反向代理。</p><figure><p><img alt=\"\" src=\"/dailyinfo/media/b2e41a9647cc0260.webp\" loading=\"lazy\" decoding=\"async\"></p></figure><p>‍</p><h3 id=\"sec-5\">入侵行动与数据外传</h3><p>在将已受入侵的服务器设置为中继后，攻击者开始使用它管理其与此前已受入侵的受害 Check Point 设备之间的交互。由于这里涉及大量交织在一起的受害者信息，我们将两组受害者分别称为 A 和 B。在我们的可见范围内，攻击者正积极加深其对受害者 A 的入侵；后来，我们还观察到其对另外 21 台受害 Check Point 设备执行了批量操作。</p><p>10 月 20 日至 26 日期间，攻击者让其受害者 A 的一台已受入侵资产下载 Chisel 程序，并以客户端模式运行，从而进一步扫描并与受害者 A 的环境交互。攻击者通过 Chisel 隧道，并使用针对 <a href=\"https://viz.greynoise.io/cves/CVE-2026-16232\">CVE-2026-16232</a>（Check Point SmartConsole 身份验证绕过以运行脚本）的脚本，在多台 Check Point Management Server 上发起了 100 多项管理任务。其中包括复制防火墙数据库和 Internal CA、签发新证书（pivot.p12），以及卸载安全策略（这会禁用防火墙）。此外，攻击者探测了 Citrix Netscaler、Ivanti Connect Secure、VMware vCenter、Microsoft Exchange、Oracle TNS 资产以及多台域控制器。</p><p>攻击者的大多数命令和交互内容过于庞大，无法在此逐一深入分析，但我们可以从其工具入手，揭示其中部分 TTPs。攻击者至少使用了 30 个 Python 脚本，其中许多是其他脚本的辅助工具或启动器，另有若干用于漏洞探测或漏洞利用执行器。以下摘录用于说明其中更专业化的工具和工作流。</p><p><strong>2026-10-20 13:54:30 UTC</strong> - 首次使用 exploit.py 针对受害者 A 的一台 Check Point 服务器。</p><p><strong><em>exploit.py 摘录</em></strong> <em>- &nbsp;这个 CVE-2026-16232 脚本据称改编自针对同一功能的 Metasploit 模块。攻击者似乎正是通过此方式向受害的 Check Point Security Management Server 发送命令。</em></p><figure><p><img alt=\"\" src=\"/dailyinfo/media/e03554b0b89dce5b.webp\" loading=\"lazy\" decoding=\"async\"></p></figure><p><strong>2026-10-20 14:17:51 UTC</strong> - 使用 spray_portal.py 扫描受害者 A 环境中的另一台 Check Point 服务器。</p><p><em>摘自 spray_portal.py——请注意，其中包含常用、默认或弱密码，以及显然是为受害者量身定制的密码。</em></p><figure><p><img alt=\"\" src=\"/dailyinfo/media/22f0cc21141b0b8a.webp\" loading=\"lazy\" decoding=\"async\"></p></figure><p><strong>2026-10-21 00:34:51 UTC</strong>——攻击者无法让第二台已入侵的 Check Point 设备向跳板回传数据，因此他们创建并运行了 pull_&lt;redacted_id&gt;.py，从第二台 Check Point 服务器窃取数据并将其保存在第一台已入侵的服务器上，从而有助于将数据回传至跳板服务器。</p><p><em>摘自 pull_&lt;redacted_id&gt;.py——攻击者以其目标设备为该脚本命名。该脚本运行 exploit_socks.py，后者运行 exploit.py 以利用 CVE-2026-16232，使攻击者能够通过第一台设备从第二台已入侵的 Check Point 设备收集数据，并将其传输至跳板机。请注意，这会窃取凭据、内部 CA 文件和防火墙配置。</em></p><figure><p><img alt=\"\" src=\"/dailyinfo/media/20bacedc4223acb1.webp\" loading=\"lazy\" decoding=\"async\"></p></figure><p>‍</p><p><strong>2026-10-21 02:56:38 至 06:34:40 UTC</strong>——攻击者使用 curl、telnet、nmap 脚本、域控制器探测工具及其他工具进行广泛的端口扫描，以开展内部侦察。</p><p><strong>2026-10-21 06:39:24 至 11:28:04</strong> <strong>UTC</strong>——攻击者对 Victim A 环境中的多台目标服务器使用漏洞利用脚本。</p><ul><li><a href=\"https://viz.greynoise.io/cves/CVE-2020-1472\">CVE-2020-1472</a>（Microsoft Netlogon），</li><li><a href=\"https://viz.greynoise.io/cves/CVE-2023-4966\">CVE-2023-4966</a>（Citrix Netscaler），</li><li><a href=\"https://viz.greynoise.io/cves/CVE-2024-21893\">CVE-2024-21893</a>（Ivanti Connect Secure），</li><li><a href=\"https://viz.greynoise.io/cves/CVE-2021-26855\">CVE-2021-26855</a>/34473（Microsoft Exchange），以及</li><li><a href=\"https://viz.greynoise.io/cves/CVE-2021-21972\">CVE-2021-21972</a> / CVE-2023-34048（VMware vCenter）</li></ul><p><strong>2026-10-21 11:41:21</strong> <strong>UTC</strong>——攻击者使用 comb.py、ssh_comb.py 和 ssh_spray.py 扫描 Victim A 网络中的各种目标。请注意，这些脚本包含以目标受害者为主题的用户名和密码。攻击者要么已知，要么正在猜测目标可能使用的名称和密码。</p><p><em>摘自 comb.py</em></p><figure><p><img alt=\"\" src=\"/dailyinfo/media/9625e49d2bd9b353.webp\" loading=\"lazy\" decoding=\"async\"></p></figure><p><em>摘自 ssh_comb.py</em></p><figure><p><img alt=\"\" src=\"/dailyinfo/media/fbe3a7cf58301dc9.webp\" loading=\"lazy\" decoding=\"async\"></p></figure><p><em>摘自 ssh_spray.py</em></p><figure><p><img alt=\"\" src=\"/dailyinfo/media/d48ecd0ab4683c17.webp\" loading=\"lazy\" decoding=\"async\"></p></figure><p><strong>2026-10-26 02:17:30 UTC</strong>——攻击者向 24 台已入侵的 Check Point Security Manager 服务器发出批量证书管理任务，其中包括属于 Victim A 的服务器和其他 21 个受害资产。该任务的结果以文本文件形式发回跳板服务器。我们没有观察到攻击者向这些设备发送此命令任务，这表明该任务是从对手基础设施的另一部分发出的。</p><p>请注意，这些文本文件包含受害者 IP 地址，并按递增的 IP 顺序排列，表明有自动化程序循环访问这些地址，在已入侵的 Check Point 服务器上运行命令，并通过 scp 将其交付至此 exfil 文件夹。每个文件均从受害者基础设施传出，这表明每台已入侵设备都持有与植入跳板的公钥相对应的 SSH 私钥。</p><figure><p><img alt=\"\" src=\"/dailyinfo/media/ae9697195b8e9efa.webp\" loading=\"lazy\" decoding=\"async\"></p></figure><p>所有这些文件都包含错误消息，表明证书任务失败。尽管我们没有看到后续尝试，但这些输出中的任务信息和 IP 地址已足以让我们识别并通知许多受害组织，方式包括直接通知或通过政府合作伙伴通知。</p><p><em>摘自样本 /root/exfil/pc_XXX-XXX-XXX-XXX.txt</em></p><figure><p><img alt=\"\" src=\"/dailyinfo/media/506e0524ac6a5ac3.webp\" loading=\"lazy\" decoding=\"async\"></p></figure><p>其中一条错误消息显示，/usr/lib/.libproc.so 在 /etc/ld.so.preload 中注册时出现了预加载错误，这可能表明设备上存在植入程序。</p><figure><p><img alt=\"\" src=\"/dailyinfo/media/edf64b1ca7f255d5.webp\" loading=\"lazy\" decoding=\"async\"></p></figure><p>在证书生成失败后，攻击者的活动量再次下降，直至 11 月 2 日。</p><p>‍</p><h3 id=\"sec-6\">保护其访问权限</h3><p><strong>2026-11-02 02:28:27</strong> <strong>UTC</strong> - 到了 11 月初，其他威胁行为者已开始扫描并尝试滥用遭入侵的服务器。我们观察到 GT13 行为者使用脚本对 Linux IPv4 释放后重用漏洞（CVE-2026-98432）进行自检。检查完成后，该行为者尝试使用 Linux 自带的命令行工具 nftables 对系统进行修补，丢弃带有 IP 选项、可能触发该漏洞的 IPv4 数据包。这使该行为者能够保护其跳板机，防止他人未来利用该漏洞。</p><p><em>cve_2026_98432.py 摘录</em></p><figure><p><img alt=\"\" src=\"/dailyinfo/media/fff24c767df94946.webp\" loading=\"lazy\" decoding=\"async\"></p></figure><p><em>该行为者在跳板机上测试 CVE-2026-98432 脚本的示例命令，随后尝试使用 nftables——Linux 内置的防火墙和数据包过滤框架——修补漏洞。您会注意到，修补命令执行得很快。</em></p><figure><p><img alt=\"\" src=\"/dailyinfo/media/0124b03343b05f63.webp\" loading=\"lazy\" decoding=\"async\"></p></figure><p>‍</p><h3 id=\"sec-7\">攻击时间范围与时间线说明</h3><ul><li>在 GT13 入侵 HFS 服务器之前，该对手已能访问受害者的 Check Point Security Management 服务器。我们无法确定攻击者何时或如何获得对这些 Check Point 资产的访问权限。</li></ul><ul><li>我们在 2026-10-02 13:17:45 至 2026-11-02 03:19:46 UTC 之间观察到 GT13 的攻击活动。在观察该行为者期间，我们未发现其在约 17:00 UTC 至约 00:19 UTC 之间有任何对手进行键盘实操活动，05:00 UTC 这一时段也没有任何活动。我们深知时区分析存在的风险，因此不会过度看重该行为者倾向于在相当于 UTC+7 或 UTC+8 工作时间时进行活动这一点。</li></ul><ul><li>在我们首次发现该攻击基础设施之前，它就已经长期存在；我们注意到，尝试使用的恶意软件域名 newpayapp[.]com 首次注册于 2026-03-13 12:46:28 UTC。该域名最初注册时将注册人所在州设为“Hai Phong”、国家代码设为“VN”，这或许恰好便于 UTC+7 时区的工作时间（请参阅 <a href=\"https://rdap.cloudflare.com/rdap/v1/domain/newpayapp.com\">Cloudflare 的 RDAP 服务</a>）。</li></ul><ul><li>我们怀疑 GT13 行为者拥有一套成熟且由 AI 赋能的进攻体系。我们认为，该行为者拥有独立的智能体框架和系统，用于武器化漏洞、扫描易受攻击的资产并自动进行利用，以收集系统集合，供后续用作操作中继或真正的目标。我们怀疑，时间线中的某些异常反映了智能体化的进攻行动。</li></ul><p>‍</p><h2 id=\"sec-8\">指标</h2><table><thead><tr><th>值</th><th>类型</th><th>上下文</th></tr></thead><tbody><tr><td>newpayapp.com</td><td>域名</td><td>GT13 控制的域名</td></tr><tr><td>data-zt.newpayapp.com</td><td>域名</td><td>GT13“ZULT”恶意软件下载域名</td></tr><tr><td>api-zt.newpayapp.com</td><td>域名</td><td>GT13 子域名</td></tr><tr><td>2ev5.newpayapp.com</td><td>域名</td><td>GT13 子域名</td></tr><tr><td>eeca2460550b9ded084ecf2f70a75356</td><td>HASSH</td><td>OpenSSH 10 哈希，这很常见，但与其他 GT13 TTP（例如使用 ExpressVPN）结合使用时可能有用。</td></tr><tr><td>Mozilla/5.0 (X11; Linux x86_64) 研究</td><td>User-Agent 字符串</td><td>GT13 在 HFS 利用及命令执行期间使用。</td></tr><tr><td>Mozilla/5.0 研究</td><td>User-Agent 字符串</td><td>GT13 在 HFS 命令附近使用了一次。</td></tr><tr><td>216.73.161.130</td><td>IP 地址</td><td>GT13 使用于 2026-10-02 12:40:26 UTC - 2026-10-02 12:40:27 UTC。AS206092，ExpressVPN（根据 /24 推断）</td></tr><tr><td>216.73.161.123</td><td>IP 地址</td><td>GT13 使用于 2026-10-02 12:51:11 UTC - 2026-10-02 12:51:12 UTC。AS206092，ExpressVPN（根据 /24 推断）</td></tr><tr><td>45.92.229.10</td><td>IP 地址</td><td>GT13 使用于 2026-10-02 13:17:45 UTC - 2026-10-02 13:18:09 UTC。AS206092，ExpressVPN（根据 /24 推断）</td></tr><tr><td>45.92.229.9</td><td>IP 地址</td><td>GT13 使用于 2026-10-02 13:19:37 UTC - 2026-10-03 08:16:45 UTC。AS206092，ExpressVPN（根据 /24 推断）</td></tr><tr><td>173.239.211.240</td><td>IP 地址</td><td>GT13 使用于 2026-10-02 15:04:40 UTC - 2026-10-03 08:13:54 UTC。AS206092，ExpressVPN</td></tr><tr><td>45.92.229.6</td><td>IP 地址</td><td>GT13 使用于 2026-10-03 03:20:56 UTC - 2026-10-03 08:27:16 UTC。AS206092，ExpressVPN</td></tr><tr><td>173.239.211.248</td><td>IP 地址</td><td>GT13 使用于 2026-10-03 03:20:57 UTC - 2026-10-03 08:29:40 UTC。AS206092, ExpressVPN</td></tr><tr><td>216.73.161.118</td><td>IP 地址</td><td>GT13 使用于 2026-10-03 03:29:37 UTC - 2026-10-03 03:29:39 UTC。AS206092, ExpressVPN</td></tr><tr><td>173.239.211.238</td><td>IP 地址</td><td>GT13 使用于 2026-10-03 03:29:41 UTC - 2026-10-03 08:20:49 UTC。AS206092, ExpressVPN（根据 /24 推断）</td></tr><tr><td>45.92.229.11</td><td>IP 地址</td><td>GT13 使用于 2026-10-03 06:05:26 UTC - 2026-10-03 06:05:27 UTC。AS206092, ExpressVPN（根据 /24 推断）</td></tr><tr><td>216.73.161.120</td><td>IP 地址</td><td>GT13 使用于 2