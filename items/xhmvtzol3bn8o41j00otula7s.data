[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1794616836000,"id","xhmvtzol3bn8o41j00otula7s","title","Microsoft 披露 ASP.NET Core 权限提升漏洞 CVE-2026-114146，CVSS 9.0","originalTitle","Microsoft Security Advisory CVE-2026-114146 - ASP.NET Core Elevation of Privilege Vulnerability","summary","Microsoft 披露 ASP.NET Core 权限提升漏洞 CVE-2026-114146，受影响平台覆盖 Windows、Linux、macOS。SignalR 连接未被一致绑定至建立连接时协商的身份，攻击者可注入消息并以受害者身份执行 Hub 调用；该漏洞严重等级为 Critical，CVSS v3.1 评分为 9.0，弱点为 CWE-863。","reason","公告解释了 SignalR 身份绑定失效的提权路径，并区分运行时与独立包更新方式，便于读者核查部署形态并完成修复。","source",{"_70":83},"links",{"_60":82},"publishedAt","2026-11-11T00:21:56.000Z","discoveredAt","2026-11-11T00:53:35.537Z","timelineAt","category","vuln","tags",[78,79,80,81],"score",73,"selected",true,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[67,68],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","f62YF58VOQk4","reportCount",1,"additionalSourceCount",0,{"_69":72,"_70":73},{"_69":31,"_70":71},"slug","name","漏洞披露","microsoft","Microsoft / 微软",{"_75":76,"_13":77},"publicId","882c71b2-655e-40ab-ba89-6768f4a7f49e","微软披露ASP.NET Core权限提升漏洞","漏洞","补丁","Microsoft","网络设备","https://github.com/advisories/GHSA-67wp-ghc2-fw2g","GitHub 安全公告",{"_85":86,"_87":-5},"changelogVersion","2026-10-01T08:00","release"]
