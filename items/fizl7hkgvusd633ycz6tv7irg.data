[{"_1":2,"_3":4},"root",{"_5":162},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795048831000,"id","fizl7hkgvusd633ycz6tv7irg","title","AWS Security Hub 接入 Azure 并检测跨云横向移动","originalTitle","Detecting cross-cloud lateral movement with AWS Security Hub","summary","AWS Security Hub 可将 Microsoft Azure 资源接入与 AWS 资源相同的暴露关联引擎，在同一控制台中按可达性、有效权限和配置错误生成攻击路径发现并统一排序。","reason","source",{"_74":161},"links",{"_61":160},"publishedAt","2026-11-18T22:28:45.000Z","discoveredAt","2026-11-18T22:48:36.932Z","timelineAt","category","blue-team","tags",[152,153,154,155,79,156,157,158,159],"score",52,"selected",false,"channel","news","story",{"_85":86,"_13":87},"x","readingMode","full","author","Kyle Shields","body",{"_148":-5,"_61":149,"_150":-5,"_151":36},"outline",[88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106],"relatedStories",[84],"topics",[68,69,70,71,72],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fUH9zpHbWGjc","reportCount",1,"additionalSourceCount",0,{"_73":82,"_74":83},{"_73":80,"_74":81},{"_73":78,"_74":79},{"_73":76,"_74":77},{"_73":30,"_74":75},"slug","name","蓝队与运营","tools","工具与平台","identity","身份与访问","cloud-native","云与原生","supply-chain","供应链安全",{"_85":86,"_13":87},"publicId","1ea0cd71-78bb-476b-ae9a-26fb3cb5bcec","AWS Security Hub接入Azure检测跨云攻击路径",{"_11":146,"_108":147,"_110":115},{"_11":144,"_108":145,"_110":115},{"_11":142,"_108":143,"_110":115},{"_11":140,"_108":141,"_110":115},{"_11":138,"_108":139,"_110":111},{"_11":136,"_108":137,"_110":111},{"_11":134,"_108":135,"_110":111},{"_11":132,"_108":133,"_110":111},{"_11":130,"_108":131,"_110":111},{"_11":128,"_108":129,"_110":115},{"_11":126,"_108":127,"_110":111},{"_11":124,"_108":125,"_110":111},{"_11":122,"_108":123,"_110":115},{"_11":120,"_108":121,"_110":111},{"_11":118,"_108":119,"_110":111},{"_11":116,"_108":117,"_110":111},{"_11":113,"_108":114,"_110":115},{"_11":112,"_108":45,"_110":111},{"_11":107,"_108":109,"_110":111},"sec-19","text","Marshall Jones","level",3,"sec-18","sec-17","Conclusion",2,"sec-16","Phase-to-exposure summary","sec-15","Prioritizing across both clouds in the console","sec-14","Phase 3: The impact (AWS)","sec-13","The cross-cloud bridge: Federation into AWS","sec-12","Phase 2: Foothold and privilege escalation (Azure)","sec-11","Phase 1: A compromised identity (Azure)","sec-10","Walk-through: Prioritizing a cross-cloud attack path","sec-9","Step 5: Prerequisites for Microsoft Azure","sec-8","Step 4 (optional): Add Amazon Inspector for Azure vulnerability scanning","sec-7","Step 3: Query exposure findings for Azure resources","sec-6","Step 2: Verify the connector and its recording activity","sec-5","Step 1: Create the Azure connector in Security Hub","sec-4","Configuration","sec-3","Prerequisites","sec-2","How the Azure integration works","sec-1","Why prioritizing multicloud risk is difficult","zh","<p>Most organizations run a multicloud estate, and so do the attackers targeting them. An adversary who compromises an identity in one provider follows that identity wherever it leads, including across a federated trust into a second cloud service provider. The signals enumerating this scenario are rarely missing; the problem is that they live in separate consoles, in different schemas, owned by different teams. No one has visibility into the whole picture, so no one can decide what to fix first.</p><p><span><a href=\"https://aws.amazon.com/security-hub\">AWS Security Hub</a></span> addresses prioritization and triage with exposure findings. Security Hub correlates reachability, blast radius, vulnerabilities, misconfigurations, and effective permissions, providing a strong correlation layer with an attack-path visualization, providing the context needed to generate risks from findings. That analysis now extends to Microsoft Azure. Security Hub records and analyzes your Azure resources with the same correlation engine used for <span><a href=\"https://aws.amazon.com/\">Amazon Web Services (AWS)</a></span> resources. The resulting details and meta-data land in the same console, ranked in the same queue, providing holistic, multicloud visibility into your security risks.</p><p>In this blog post, you learn how to configure the Azure integration for Security Hub and use exposure findings to prioritize attack paths across both clouds from one console. We follow a realistic scenario: a compromised identity that threatens both an Azure and an AWS environment through a shared, federated identity plane. We show you how the critical exposures along that path are presented as ranked findings that you can triage together, and we map each one to the MITRE ATT&amp;CK framework. We also cover the prerequisites that teams commonly overlook.</p><h2 id=\"sec-1\">Why prioritizing multicloud risk is difficult</h2><p>Consider an organization whose Microsoft Entra ID tenant is federated into an AWS account, so identities in the tenant can assume an AWS role. This is an ordinary and intentional configuration used to avoid having to manage a second set of credentials. It also means the two clouds share an identity plane: a single compromised Entra identity is both an Azure threat and—through the federation—an AWS threat.</p><p>An attacker exploits this, but the defensive signals land in different places:</p><table> \n <tbody> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\"><b>Where the risk lives</b></td> \n   <td colspan=\"1\" rowspan=\"1\"><b>Traditionally visible in</b></td> \n   <td colspan=\"1\" rowspan=\"1\"><b>Owned by</b></td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">Weak Entra identity controls: over-privileged identities, no multi-factor authentication (MFA), vulnerable conditional access policies (CAP)</td> \n   <td colspan=\"1\" rowspan=\"1\">Entra ID and Microsoft Defender for Cloud</td> \n   <td colspan=\"1\" rowspan=\"1\">Identity team</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">Internet-reachable Azure host with admin rights</td> \n   <td colspan=\"1\" rowspan=\"1\">Defender for Cloud</td> \n   <td colspan=\"1\" rowspan=\"1\">Azure platform team</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">Federated trust into AWS</td> \n   <td colspan=\"1\" rowspan=\"1\"><span><a href=\"https://aws.amazon.com/iam\">AWS Identity and Access Management (IAM)</a></span></td> \n   <td colspan=\"1\" rowspan=\"1\">Cloud security team</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">Sensitive data and over-exposed resources in AWS</td> \n   <td colspan=\"1\" rowspan=\"1\">AWS security tooling</td> \n   <td colspan=\"1\" rowspan=\"1\">Cloud security team</td> \n  </tr> \n </tbody> \n</table><p>Each team sees one fragment, and in isolation each fragment appears low severity. You see the risk only when you correlate all of it together and discover the same identity plane ties the attack path together. Exposure findings provide that severity within AWS; extending it to Azure closes the multicloud visibility gap.</p><h2 id=\"sec-2\">How the Azure integration works</h2><p>You create the Azure connector in the AWS Management Console for Security Hub. It authenticates to your Entra ID tenant through an application registration, records and evaluates your Azure resource configurations, and streams Microsoft Defender for Cloud alerts and Entra ID audit logs through an Azure Event Hubs namespace. Your Azure resources then flow into the same correlation engine that analyzes signals from <span><a href=\"https://aws.amazon.com/security-hub/cspm/\">AWS Security Hub Cloud Security Posture Management (CSPM)</a></span>, <span><a href=\"https://aws.amazon.com/inspector\">Amazon Inspector</a></span>, <span><a href=\"https://aws.amazon.com/macie\">Amazon Macie</a></span>, and <span><a href=\"https://aws.amazon.com/guardduty\">Amazon GuardDuty</a></span>. That engine produces two kinds of findings:</p><ul> \n <li><b>Control findings</b> against standards such as the CIS Microsoft Azure Foundations Benchmark.</li> \n <li><b>Exposure findings</b>, which are ranked, attack-path findings that correlate traits such as reachability, effective permissions, and misconfiguration, with a severity based on how discoverable and exploitable the risk is.</li> \n</ul><p>Both use the Open Cybersecurity Schema Framework (OCSF) and appear in the same console as your AWS findings. However, one filtering detail matters: because Security Hub produces the finding, its top-level <code>cloud.provider</code> is AWS, while the evaluated resource carries <code>resources[].provider = Azure</code>. Filter on <code>resources.provider</code> to scope to a single cloud.</p><h2 id=\"sec-3\">Prerequisites</h2><p>To follow along with this post, you need:</p><ul> \n <li>An AWS account with Security Hub enabled. If you use a delegated administrator account for Security Hub, create the connector there, in the AWS Region where you aggregate findings.</li> \n <li>An Entra ID tenant with a Microsoft Azure subscription. You need privileges in Azure to create an application registration, assign roles at the tenant root management group, and create a subscription-level diagnostic setting.</li> \n <li>The Azure CLI, authenticated to the target subscription with <code>az login</code> command.</li> \n <li>Activity log export. Azure resource recordings are change-driven and depend on activity logs reaching the event hub that the connector reads. The onboarding process assigns an Azure policy to create the required diagnostic setting, but it only remediates existing subscriptions after you create a remediation task. If the connector reports healthy status but resources never appear, run <code>az monitor diagnostic-settings subscription list</code> to confirm the export exists, and create a remediation task if the list is empty.</li> \n</ul><h2 id=\"sec-4\">Configuration</h2><p>The following steps detail how to connect your Azure environment to Security Hub v2: Registering the Azure application, establishing federated identity credentials, and assigning the roles required for AWS to evaluate your Azure resources.</p><h3 id=\"sec-5\">Step 1: <b>Create the Azure connector in Security Hub</b></h3><p>The first step in this configuration is to create the Azure connector in Security Hub. The connector establishes trust with your Azure tenant and defines which subscriptions and regions Security Hub v2 will evaluate.</p><ol> \n <li>Open the Security Hub console and choose <b>Integrations</b>.</li> \n <li>Choose <b>Create Azure connector</b>.</li> \n <li>Enter your <b>Azure Tenant ID</b> and the <b>Application (client) ID</b> of the application registration you created for the integration.</li> \n <li>For <b>Subscriptions</b> and <b>Regions</b>, select all. Attack paths cross subscription and Region boundaries, so partial coverage leaves blind spots where a compromised identity can pivot unseen. Scope to specific IDs or Regions only when data-residency rules require it.</li> \n <li>Run the generated setup script in your Azure environment, then choose <b>Create connector</b>.</li> \n</ol><p>Include the global region scope. Controls that evaluate Entra ID and Microsoft Graph resources require it, and those identity exposures are central to this scenario. If you also create an Amazon Inspector or Security Hub CSPM connector for the same tenant, keep its subscriptions and regions consistent with this one.</p><h3 id=\"sec-6\">Step 2: Verify the connector and its recording activity</h3><p>Health status alone doesn’t tell you whether recording is flowing. Confirm both.</p><p><span><a href=\"https://aws.amazon.com/cli\">AWS Command Line interface (AWS CLI)</a></span><b> command 1: Verify connector health and recording state</b></p><pre class=\"language-text\"><code class=\"language-text\">aws securityhub list-connectors-v2 --region &lt;REGION&gt; \\\n\n--query \"Connectors[?ProviderSummary.ProviderName=='AZURE']\" --output json</code></pre><pre class=\"language-text\"><code class=\"language-text\">aws securityhub get-resources-v2 --region &lt;REGION&gt; --max-results 50 \\\n\n--filters '{\"CompositeFilters\":[{\"StringFilters\":[{\"FieldName\":\"ResourceType\",\n\n\"Filter\":{\"Value\":\"microsoft.compute/virtualmachines\",\"Comparison\":\"EQUALS\"}}]}],\n\n\"CompositeOperator\":\"AND\"}' \\\n\n--query \"Resources[].{id:ResourceId, captured:ResourceDetailCaptureTimeDt}\" --output table</code></pre><h3 id=\"sec-7\">Step 3: Query exposure findings for Azure resources</h3><p>Scope to Azure by filtering on the resource provider.</p><p><b>AWS CLI command 2: Retrieve exposure findings for Azure resources</b></p><pre class=\"language-text\"><code class=\"language-text\">​​aws securityhub get-findings-v2 --region &lt;REGION&gt; --max-results 50 \\ --filters '{\"CompositeFilters\":[ {\"StringFilters\":[{\"FieldName\":\"resources.provider\",\"Filter\":{\"Value\":\"Azure\",\"Comparison\":\"EQUALS\"}}]}, {\"StringFilters\":[{\"FieldName\":\"metadata.product.feature.uid\",\"Filter\":{\"Value\":\"security-hub/Exposure\",\"Comparison\":\"EQUALS\"}}]}], \"CompositeOperator\":\"AND\"}' \\ --query \"Findings[].{sev:severity, title:finding_info.title}\" --output table​</code></pre><h3 id=\"sec-8\">Step 4 (optional): Add Amazon Inspector for Azure vulnerability scanning</h3><p>To add vulnerability findings for Azure virtual machines (VMs), function apps, or container registry images, create an <span><a href=\"https://docs.aws.amazon.com/securityhub/latest/userguide/securityhub-v2-azure-setup-securityhub-v2.html#:~:text=To%20enable%20vulnerability%20scanning%20through%20Amazon%20Inspector%2C%20you%20must%20create%20the%20following%20IAM%20resources%20in%20your%20AWS%20account.\">Amazon Inspector connector</a></span> for the same tenant. VM scanning requires each target VM to have a system-assigned managed identity, which you can enforce with an Azure Policy. Figure 1 shows a correctly configured Azure integration inside Security Hub, with vulnerability management and posture management deployed.</p><p>\n <img src=\"/dailyinfo/media/20001f96c102f975.webp\" srcset=\"/dailyinfo/media/4ec4ce47e744cb09.webp 720w, /dailyinfo/media/b53194293974882a.webp 1200w, /dailyinfo/media/20001f96c102f975.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"\" width=\"1212\" height=\"500\">\n </p><p>Figure 1: Successful configuration of the Azure integration with Security Hub</p><h3 id=\"sec-9\">Step 5: Prerequisites for Microsoft Azure</h3><p>See the AWS documentation for the <span><a href=\"https://docs.aws.amazon.com/securityhub/latest/userguide/securityhub-v2-azure-prereqs.html#securityhub-v2-azure-prereqs-azure\">prerequisites for Microsoft Azure</a></span>.</p><h2 id=\"sec-10\">Walk-through: Prioritizing a cross-cloud attack path</h2><p>In this example, the organization has one identity plane across two clouds, comprising a Microsoft Entra ID tenant with a federated trust into an AWS account. An adversary who compromises the right Entra identity gains an initial foothold in Azure and a path into AWS, because both clouds trust the same identity plane. The following sections trace that path. Each step is a real, high-severity exposure finding that Security Hub ranked on its own. The point of the walk-through is to demonstrate a real-life scenario and examine all findings in one unified security console.</p><h3 id=\"sec-11\">Phase 1: A compromised identity (Azure)</h3><p><b>ATT&amp;CK:</b> Phishing (T1566), Valid Accounts: Cloud Accounts (T1078.004)</p><p>The path begins with an Entra identity that is both over-privileged and unprotected. You’ll find this in the Security Hub console under <b>Exposures</b>, where Security Hub raises it as an identity exposure finding and maps the attack path stemming from it:</p><p><b>Potential Unauthorized Access: Azure RBAC user with administrative access has MFA disabled</b> (high). It correlates the user, the role assignment that grants administrative access, and the organization.</p><p>The tenant’s authorization policies let an attacker broaden that foothold, and Security Hub CSPM reports each policy as a failed control (high): <i>Microsoft Entra ID authorization policies should prohibit default users from registering applications…should restrict user consent for applications</i>, and <i>Azure authorization policies should restrict guest invitations to admin roles only</i>. Each finding expands what a single compromised, non-privileged identity can do without an administrator.</p><h3 id=\"sec-12\">Phase 2: Foothold and privilege escalation (Azure)</h3><p><b>ATT&amp;CK:</b> Exploit Public-Facing Application (T1190), Valid Accounts: Cloud Accounts (T1078.004)</p><p>The tenant contains an internet-reachable VM whose network security group allows inbound from any address, and whose attached identity holds administrative rights over the subscription. Security Hub surfaces this under <b>Exposures</b>, correlating reachability and effective permissions into one finding that shows why it matters: anyone reaching the VM inherits admin control of the subscription.:</p><p><b>Potential Initial Access: Potentially internet reachable Azure virtual machine with open network security group has administrative access</b> (high). It correlates the VM, the role assignment, the network security group, and the public IP address.</p><p>The finding’s analysis reads like an attack path. The resource “may be reachable from the public internet,” “overly permissive network security group (NSG) rules allow unintended inbound access,” and “the Owner or Contributor role grants extensive permissions… enabling a threat actor to escalate privileges.” Security Hub evaluates this from configuration and network-path modeling, so it surfaces whether or not the VM is running. Figure 2 shows the correlated attack path for that virtual machine.</p><p>\n <img src=\"/dailyinfo/media/450994fa083f30a1.webp\" srcset=\"/dailyinfo/media/d89cde4e24aebfe9.webp 720w, /dailyinfo/media/e54962c298772b27.webp 1200w, /dailyinfo/media/450994fa083f30a1.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"\" width=\"1364\" height=\"500\">\n </p><p>Figure 2: An Azure attack-path exposure, analyzed by the same correlation engine as AWS exposures</p><h2 id=\"sec-13\">The cross-cloud bridge: Federation into AWS</h2><p>The tenant from Phases 1 and 2 is federated into the AWS account through an IAM SAML identity provider. As shown in Figure 2, a role trusts that provider and grants read access to every bucket in <span><a href=\"https://aws.amazon.com/s3\">Amazon Simple Storage Service (Amazon S3)</a></span>. This trust is what expands the risk across clouds from the same adversary: a compromised Entra identity can assume this role and reach AWS data.</p><p>This one hop lives in IAM rather than in Security Hub. Security Hub doesn’t not raise a finding for a role that trusts your own federated identity provider. Confirming it is a normal investigative pivot: the role trusts a SAML identity provider that represents your Entra tenant, the same tenant whose exposures you triaged when you added Amazon Inspector in Step 4.</p><p>\n <img src=\"/dailyinfo/media/3104b1f38f34da37.webp\" srcset=\"/dailyinfo/media/6ddd675f27128bb3.webp 720w, /dailyinfo/media/de87aac2d45476fc.webp 1200w, /dailyinfo/media/3104b1f38f34da37.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"\" width=\"799\" height=\"500\">\n </p><p>Figure 3: The federated trust that links the two clouds through a shared identity plane</p><h3 id=\"sec-14\">Phase 3: The impact (AWS)</h3><p><b>ATT&amp;CK:</b> Data from Cloud Storage (T1530), Transfer Data to Cloud Account (T1537)</p><p>On the AWS side, the correlation engine has already categorized the resources this identity can reach. Under <b>Exposures</b> in the Security Hub console, the sensitive-data objective surfaces this finding because that reachable set includes data at risk; a compromised identity could destroy it:</p><p><b>Potential Sensitive Data Destruction: S3 bucket has sensitive data and versioning disabled and Object Lock disabled and MFA delete disabled</b> (high). A Macie finding, <i>The S3 object contains personal information</i>, is a contributing signal, and the control <i>S3 general purpose buckets should be encrypted at rest with AWS KMS keys</i> fails alongside it.</p><p>The same account carries related AWS attack-path exposures. Two examples are <i>Potential Resource Hijacking: Internet reachable EC2 instance with open security group has software vulnerabilities with limited effective permissions</i> and <i>Potential Unauthorized Access: IAM user has weak password policies</i>. In the exposure queue, these sit next to the Azure findings, ranked by the same severity model.</p><h3 id=\"sec-15\">Prioritizing across both clouds in the console</h3><p>Here is the operational benefit. An analyst is notified of generated exposure findings and opens the dashboard and filters to High severity. In one prioritized list, without switching tools or opening a ticket for another team, they see the Azure admin identity without MFA, the internet-reachable Azure VM with subscription-admin rights, and the AWS sensitive data exposure. Together, these show the full scope of what a single vector, sharing an identity plane, might target. The analyst confirms the connecting federation with one pivot into IAM. The multicloud triage that used to require two products and two teams now occurs in one place. Figure 4 shows that single ranked queue.</p><p>\n <img src=\"/dailyinfo/media/33d8a2da02b94cb2.webp\" srcset=\"/dailyinfo/media/1d578ebba03f42db.webp 720w, /dailyinfo/media/d4546f0cbb3be202.webp 1200w, /dailyinfo/media/33d8a2da02b94cb2.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"\" width=\"1459\" height=\"500\">\n </p><p>Figure 4: Cross-cloud exposure prioritization in a single console</p><h3 id=\"sec-16\">Phase-to-exposure summary</h3><p>The following table traces each phase of the attack path to its MITRE ATT&amp;CK techniques, the cloud where it plays out, and the ranked Security Hub exposure that surfaces it — following the pivot from Azure into AWS across the shared identity plane.</p><table> \n <tbody> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\"><b>Phase</b></td> \n   <td colspan=\"1\" rowspan=\"1\"><b>ATT&amp;CK</b></td> \n   <td colspan=\"1\" rowspan=\"1\"><b>Cloud</b></td> \n   <td colspan=\"1\" rowspan=\"1\"><b>Ranked exposure in Security Hub</b></td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">1. Compromised identity</td> \n   <td colspan=\"1\" rowspan=\"1\">T1566, T1078.004</td> \n   <td colspan=\"1\" rowspan=\"1\">Azure</td> \n   <td colspan=\"1\" rowspan=\"1\"><i>Potential Unauthorized Access: Azure RBAC user with administrative access has MFA disabled</i> (High)</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">2. Foothold and privilege escalation</td> \n   <td colspan=\"1\" rowspan=\"1\">T1190, T1078.004</td> \n   <td colspan=\"1\" rowspan=\"1\">Azure</td> \n   <td colspan=\"1\" rowspan=\"1\"><i>Potential Initial Access: internet reachable Azure VM with open NSG has administrative access</i> (High)</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">2.1 Bridge</td> \n   <td colspan=\"1\" rowspan=\"1\">T1550 (Use Alternate Authentication Material)</td> \n   <td colspan=\"1\" rowspan=\"1\">Azure to AWS</td> \n   <td colspan=\"1\" rowspan=\"1\">Federated trust, confirmed in AWS IAM (shared identity plane)</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">3. Data objective</td> \n   <td colspan=\"1\" rowspan=\"1\">T1530, T1537</td> \n   <td colspan=\"1\" rowspan=\"1\">AWS</td> \n   <td colspan=\"1\" rowspan=\"1\"><i>Potential Sensitive Data Destruction: S3 bucket has sensitive data…</i> (High), plus Macie</td> \n  </tr> \n </tbody> \n</table><h2 id=\"sec-17\">Conclusion</h2><p>A cross-cloud attack is difficult to prioritize because signals are generated across separate consoles, schemas, and teams. In this post, you saw how the Azure integration for AWS Security Hub brings Azure resources into the same exposure engine and the same queue as your AWS resources. One analyst can prioritize an attack path that spans a compromised Microsoft Entra ID identity, across a federated trust, to sensitive data in Amazon S3, without leaving Security Hub.</p><p>To recap why this workflow is practical and effective:</p><ul> \n <li>Security Hub records and analyzes your Azure security findings and displays them in the same unified console as your AWS resources, and produces ranked, attack-path exposure findings for both clouds.</li> \n <li>Findings from both clouds share the OCSF schema, so you filter, group, and prioritize them in one place. Filter on <code>resources.provider</code> to scope an individual cloud.</li> \n <li>Security Hub correlates signals into attack paths within each cloud. The analysis creates a cross-cloud narrative, such as a shared federated identity plane, while co-locating ranked correlation findings across both Azure and AWS, creating efficient scoping and remediations.</li> \n <li>Confirm your prerequisites. Include the global region scope for Entra ID controls, know that sign-in log signals require an Entra ID P1 or P2 license, and confirm that the subscription diagnostic setting that exports Activity Logs to the connector’s event hub is in place. A connector can report a healthy status while it records nothing.</li> \n</ul><p>To get started, see <span><a href=\"https://docs.aws.amazon.com/securityhub/latest/userguide/securityhub-azure.html\">Enabling Microsoft Azure integration in Security Hub</a></span> and <span><a href=\"https://docs.aws.amazon.com/securityhub/latest/userguide/exposure-findings.html\">Exposure findings in Security Hub</a></span>.</p><p>If you have questions about this post, contact <a href=\"https://aws.amazon.com/contact-us/\">AWS Support</a> or start a new thread on <a href=\"https://repost.aws/\">AWS re:Post</a>.</p><hr><p>\n   <img src=\"/dailyinfo/media/b18453dbe58db624.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"Kyle Shields\" width=\"120\" height=\"160\">\n  </p><h3 id=\"sec-18\">Kyle Shields</h3><p>Kyle is a Security Specialist Solutions Architect focused on threat detection and incident response at AWS. Today, he’s focused on helping enterprise AWS customers adopt and operationalize AWS Security Incident Response and improve their security posture.</p><p>\n   <img src=\"/dailyinfo/media/bb4264806e6ce7e4.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"Marshall Jones\" width=\"120\" height=\"160\">\n  </p><h3 id=\"sec-19\">Marshall Jones</h3><p>Marshall is a Worldwide Security Specialist Solutions Architect at AWS. His background is in AWS consulting and security architecture and focused on a variety of security domains including edge, threat detection, and compliance. Today, he’s focused on helping enterprise AWS customers adopt and operationalize AWS security services to increase security effectiveness and reduce risk.</p>","zhKind","complete","蓝队","检测工程","工具发布","供应链","云原生","AWS","Microsoft","Google","https://aws.amazon.com/blogs/security/detecting-cross-cloud-lateral-movement-with-aws-security-hub/","AWS Security Blog",{"_163":164,"_165":-5},"changelogVersion","2026-10-01T08:00","release"]
