[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795567278000,"id","byua0nkzhemuny0li5le6i2rp","title","CakePHP Twig View `unserialize` 过滤器存在任意对象反序列化漏洞","originalTitle","Cakephp twig-view unserialize Twig filter allows arbitrary object deserialization","summary","CakePHP Twig View 的 `unserialize` 过滤器未限制可反序列化类，可作为反序列化远程代码执行链中的利用工具。1.3.3 和 2.1.2 已修复该问题；暂无法升级时，应停止在模板中使用 `unserialize` 过滤器。","reason","source",{"_71":85},"links",{"_59":84},"publishedAt","2026-11-24T17:42:51.000Z","discoveredAt","2026-11-24T17:52:33.229Z","timelineAt","category","vuln","tags",[80,81,82,83],"score",44,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","readingMode","full","author","body","outline",[],"relatedStories",[76],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","ffUdGJOQGyPQ","reportCount",1,"additionalSourceCount",0,{"_69":74,"_71":75},{"_69":30,"_71":73},{"_69":70,"_71":72},"slug","research","name","技术研究","漏洞披露","supply-chain","供应链安全",{"_77":78,"_13":79},"publicId","752dc4b7-d0b3-42e9-94cf-bf5993440f8c","CakePHP Twig View 反序列化漏洞已修复","漏洞","补丁","漏洞分析","供应链","https://github.com/advisories/GHSA-48qj-5wxh-m8hc","GitHub 安全公告",{"_87":88,"_89":-5},"changelogVersion","2026-10-01T08:00","release"]
