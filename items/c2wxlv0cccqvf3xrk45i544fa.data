[{"_1":2,"_3":4},"root",{"_5":91},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795826437000,"id","c2wxlv0cccqvf3xrk45i544fa","title","攻击者利用未修补的 Idunno AntiCsrf 漏洞 CVE-2026-131914 实现 RCE","originalTitle","Hackers Exploit Unpatched Flaw in Defunct Idunno AntiCsrf Library","summary","攻击者正在利用 Idunno AntiCsrf 库中未修补的 CVE-2026-131914，通过不安全反序列化在 IIS worker process 权限下实现 RCE，CVSS 评分为 9.3。","reason","文章提供了可利用前提、载荷方式、KEV 状态和替代处置方案，便于 ASP.NET 运维人员评估暴露风险并安排处置。","source",{"_72":90},"links",{"_80":89},"publishedAt","2026-11-25T09:05:13.000Z","discoveredAt","2026-11-25T10:00:32.995Z","timelineAt","category","vuln","tags",[84,73,85,86,87,88],"score",78,"selected",true,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","Ionut Arghire","body",{"_61":79,"_80":-5,"_81":82,"_83":37},"outline",[],"relatedStories",[75],"topics",[68,69],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fILhNQVWBrtw","reportCount",2,"additionalSourceCount",1,{"_70":31,"_72":74},{"_70":71,"_72":73},"slug","exploited","name","在野利用","漏洞披露",{"_76":77,"_13":78},"publicId","14e2ee8e-32a4-43a3-9fae-64a4fc2c6084","Idunno.AntiCsrf漏洞已被在野利用","<p><strong>安全研究人员警告称，威胁行为者正在利用开源反 CSRF 库 Idunno AntiCsrf 中一个尚未修补的漏洞，以实现远程代码执行（RCE）。</strong>\n\n\n\n</p><p>AntiCsrf 是一个用于 WebForms 应用程序的旧版 ASP.NET 模块，目前没有活跃维护者，也不再受到积极支持。其最新版本 0.9.1 Beta 发布于 2008 年 12 月。\n\n\n\n</p><p>该被利用的安全缺陷被跟踪为 CVE-2026-131914（CVSS 分数为 9.3），其描述为在处理发往 ASP.NET WebForms 端点的 HTTP POST 请求时存在的不安全反序列化漏洞。\n\n\n</p><p>Google Cloud 旗下 Mandiant <a href=\"https://github.com/mandiant/Vulnerability-Disclosures/blob/master/2026/MNDT-2026-0048.md\">警告称</a>：“利用该漏洞只需发送一个 HTTP POST 请求，无需事先进行身份验证，也无需提供有效的 CSRF 令牌。已在野外观察到积极利用活动。”该警告发布于 11 月 18 日。\n\n\n</p><p>Mandiant 指出，该漏洞允许攻击者在 CSRF cookie 中提供任意非空值，并附带一条 Base64 编码的 gadget chain，从而在 IIS 工作进程上下文中获得 RCE。&nbsp;&nbsp;\n\n\n</p><p>据预防性网络安全公司 WatchTowr 表示，该问题之所以存在，是因为 AntiCsrf 在将传入的表单提交数据重构为程序对象之前，未对其进行充分检查。</p><p><span>广告。滚动以继续阅读。</span></p><p>WatchTowr <a href=\"https://watchtowr.com/intelligence/idunnoanticsrf-cve-2026-131914-faq/\">表示</a>：“易受攻击的检查发生在应用程序自身的页面逻辑之前，因此它可能影响受影响站点上的许多页面，而不仅是使用登录表单的页面。成功发起攻击后，攻击者将能够控制运行该网站的进程，进而可能导致服务器被完全攻陷。”\n\n\n</p><p>周二，美国网络安全局 CISA 将 CVE-2026-131914 加入其已知被利用漏洞（<a href=\"https://www.cisa.gov/known-exploited-vulnerabilities-catalog\">KEV</a>）清单，敦促联邦机构在三天内处理该漏洞。\n\n\n\n</p><p>由于该漏洞尚无官方补丁，所有依赖已有 18 年历史的 AntiCsrf 来在表单提交时验证 anti-CSRF 令牌的组织都应立即停用该模块，并转向仍在积极维护的解决方案。\n\n\n\n</p><p>“WatchTowr Intel 在我们的蜜罐中检测到利用探测活动，这些探测使用了创新的 .NET 编译 gadget 载荷，以确认给定系统是否存在漏洞。我们验证了该利用方式并确认：如果主机存在漏洞，服务器会被诱骗重定向到一个唯一 URL，该 URL 会隐蔽地向攻击者确认其已控制该 Web 服务器，”WatchTowr 首席威胁情报专家 Yordan Ganchev 告诉 <em>SecurityWeek</em>。\n\n\n\n</p><p>“没有补丁，很可能也不会有补丁。防御方应审计 ASP.NET 产品，找出打包了 Idunno.AntiCSRF 库的实例，并审查其审计日志以寻找被利用的迹象。在可能的情况下，应在受影响的应用中替换该库。若无法做到，则应部署 WAF 规则，直至确定替代的变通方案，”Ganchev 补充道。\n\n\n\n</p><p><strong>相关：</strong> <a href=\"https://www.securityweek.com/palo-alto-networks-patches-fragnesia-flaw-used-to-root-firewalls/\">Palo Alto Networks 修补被用于获取防火墙 root 权限的 Fragnesia 漏洞</a>\n\n\n\n</p><p><strong>相关：</strong> <a href=\"https://www.securityweek.com/drupal-flaw-found-by-anthropic-scanner-exploited-in-attacks/\">由 Anthropic 扫描器发现的 Drupal 漏洞已在攻击中被利用</a>\n\n\n\n</p><p><strong>相关：</strong> <a href=\"https://www.securityweek.com/phpaftershell-vulnerability-revives-php2shells-attack-path/\">phpAfterShell 漏洞让 PHP2Shell 的攻击路径复活</a>\n\n\n\n</p><p><strong>相关：</strong> <a href=\"https://www.securityweek.com/azure-flaw-exploited-to-target-secrets-at-norwegian-energy-firms/\">Azure 漏洞被利用以针对挪威能源企业的机密</a>\n\n\n\n</p>","original","zhKind","translation","complete","漏洞","漏洞利用","利用链","Google","CISA","https://www.securityweek.com/hackers-exploit-unpatched-flaw-in-defunct-idunno-anticsrf-library/","SecurityWeek",{"_92":93,"_94":-5},"changelogVersion","2026-10-01T08:00","release"]
