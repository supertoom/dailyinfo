[{"_1":2,"_3":4},"root",{"_5":87},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795135241000,"id","opm83rk3b6x0y682i3w0ck558","title","NLTK StreamBackedCorpusView 路径沙箱绕过可泄露文件存在性、大小和修改时间","originalTitle","NLTK: StreamBackedCorpusView constructor os.stat leaks out-of-root file existence, size, and mtime bypassing pathsec ENFORCE","summary","NLTK 3.10.0 至 3.10.3 的 StreamBackedCorpusView 构造器在处理攻击者可控字符串路径时，未经 pathsec 校验调用 os.stat，即使 ENFORCE=True 也会泄露越界文件的存在性、精确大小和修改时间，并可区分不存在、权限不足和路径非目录等错误；文件内容读取仍被阻止。","reason","source",{"_71":86},"links",{"_59":85},"publishedAt","2026-11-19T23:47:58.000Z","discoveredAt","2026-11-20T00:02:20.241Z","timelineAt","category","disclosure","tags",[81,82,83,84],"score",54,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fxxUAUKgaTm8","reportCount",1,"additionalSourceCount",0,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","research","name","技术研究","vuln","漏洞披露","supply-chain","供应链安全",{"_78":79,"_13":80},"publicId","13497a3e-b8bb-4893-a649-9aa68a6c78ea","NLTK路径沙箱绕过泄露文件元数据","漏洞分析","复现","漏洞利用","供应链","https://github.com/advisories/GHSA-w674-vqhw-g3pg","GitHub 安全公告",{"_88":89,"_90":-5},"changelogVersion","2026-10-01T08:00","release"]
