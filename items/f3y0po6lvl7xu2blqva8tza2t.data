[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794876028000,"id","f3y0po6lvl7xu2blqva8tza2t","title","mail-parser 附件提取路径遍历漏洞影响 3.8.0 至 4.5.0 版本","originalTitle","mail-parser: Path Traversal vulnerability in attachment extraction","summary","mail-parser 的 write_attachments() 和 write_sample() API 存在路径遍历漏洞，恶意附件文件名可使文件写入预期目录之外并造成任意文件覆盖，影响 3.8.0 至 4.5.0 版本。修复版本加入文件名净化、输出路径校验、符号链接目标拒绝及路径分隔符归一化，用户应升级至已发布补丁。","reason","source",{"_69":81},"links",{"_59":80},"publishedAt","2026-11-16T22:10:55.000Z","discoveredAt","2026-11-16T22:12:15.558Z","timelineAt","category","vuln","tags",[77,78,79],"score",44,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","f2VId7i4lMYU","reportCount",1,"additionalSourceCount",0,{"_68":71,"_69":72},{"_68":30,"_69":70},"slug","name","漏洞披露","email","邮件与钓鱼",{"_74":75,"_13":76},"publicId","70c68bfd-21da-4a38-8bc3-9c9142c1d452","mail-parser路径遍历漏洞已发布补丁","漏洞","补丁","邮件安全","https://github.com/advisories/GHSA-fr3h-cpq2-9496","GitHub 安全公告",{"_83":84,"_85":-5},"changelogVersion","2026-10-01T08:00","release"]
