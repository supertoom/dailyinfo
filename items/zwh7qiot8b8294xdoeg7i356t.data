[{"_1":2,"_3":4},"root",{"_5":96},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1794185110000,"id","zwh7qiot8b8294xdoeg7i356t","title","GMO旗下Onamae云桌面服务遭入侵，最多26,739台服务器被植入恶意软件","originalTitle","数万台云桌面服务器被植入恶意软件，官方敦促客户关闭本地电脑","summary","GMO旗下Onamae云桌面服务遭网络攻击，最多26,739名客户的服务器被植入恶意软件，客户支付信息未泄露，但MT4/MT5登录凭证及交易账号信息可能暴露。攻击者窃取数据后索要高达80亿日元赎金，并威胁启动已植入的勒索软件载荷。GMO关闭相关服务器并敦促客户断网关机、重置密码和终止会话；目前尚未发现客户电脑上的勒索软件被激活。","reason","该事件涉及云桌面服务被入侵、客户数据外泄及后续勒索威胁，处置措施与暴露风险可供同类云服务事件参考。","source",{"_74":95},"links",{"_87":94},"publishedAt","2026-10-28T09:20:00.000Z","discoveredAt","2026-10-28T14:04:47.820Z","timelineAt","category","activity","tags",[77,75,90,91,92,93],"score",84,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","body",{"_61":86,"_87":-5,"_88":87,"_89":37},"outline",[],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","f6dfpIhG1v24","reportCount",3,"additionalSourceCount",2,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","malware","name","恶意软件","attack","攻击活动","ransomware","勒索软件","cloud-native","云与原生",{"_83":84,"_13":85},"publicId","14887a87-ce41-4a23-abbd-e37504c7b612","GMO确认Onamae云服务遭入侵并悬赏追捕","<p><span>安全内参编译</span> <span>2026-10-28 17:20</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/92a45f6e8dff5a6c.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>客户敏感数据已遭泄露</p><p><strong><span>关注我们</span></strong></p><p><strong><span>带你读懂网络安全</span></strong></p><p><img src=\"/dailyinfo/media/79408b7089b0b9df.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>日本互联网龙头企业GMO旗下云服务遭网络攻击，可能2.6万台云桌面服务器被植入恶意软件，客户敏感数据泄露（大量用户用于MT4/MT5金融交易）并遭到公开；</span></span></p><p><span><span>攻击者巨额勒索未遂后，扬言要启动勒索软件攻击，GMO此前已关闭所有云桌面服务器，并进一步建议客户断开网络关闭本地电脑；</span></span></p><p><span><span>目前尚无证据表明攻击者影响了客户本地电脑，安全内参猜测GMO可能出于谨慎考虑，避免攻击者从云桌面共享路径或窃取数据后利用凭证等扩大攻击等方式入侵客户电脑。</span></span></p><p><span>前情回顾·<span>云服务威胁态势</span></span></p><ul><li><p><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247516700&amp;idx=1&amp;sn=d6ce7f1d4f077d9495c0bfb4e3174c1c&amp;scene=21#wechat_redirect\">知名云因勒索攻击瘫痪，政府交通银行民生等数百个组织受影响</a></span></p></li><li><p><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247516248&amp;idx=1&amp;sn=f593ae42b73f230b52441d760fdf1742&amp;scene=21#wechat_redirect\">AI重塑网络威胁！孤狼黑客3天攻破跨国企业复杂云环境</a></span></p></li><li><p><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247514485&amp;idx=1&amp;sn=b79ac979390502df50bea6aa05bdd19b&amp;scene=21#wechat_redirect\">阿里云核心域名遭劫持，Shadowserver扮演何种角色？</a></span></p></li><li><p><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247511918&amp;idx=1&amp;sn=84e8748273f6ebc4f412578d37a4d505&amp;scene=21#wechat_redirect\">云存储巨头Snowflake被黑，165家知名企业遭殃</a></span></p></li></ul><p><span>安全内参10月28日消息，日本互联网龙头GMO集团敦促客户，尽快断开系统网络连接并关闭电脑。此前，一名攻击者入侵了该集团旗下的Onamae云桌面服务，并威胁称将于当天发动勒索软件攻击。</span></p><p><span><img src=\"/dailyinfo/media/45cbc181e84ce093.webp\" loading=\"lazy\" decoding=\"async\"></span></p><p><span>GMO此前确认，该公司及客户的数据已被发布到网上。</span></p><p><span>云桌面服务被黑，</span></p><p><span>客户金融交易数据可能泄露</span></p><p><span>这起事件的起因是Onamae云桌面遭到网络攻击。该服务由GMO Internet运营。GMO Internet隶属于GMO Internet Group，是日本颇受欢迎的虚拟专用服务器（VPS）服务提供商，同时也是日本最大的域名注册商之一。</span></p><p><span>上周，GMO宣布，公司于10月20日发现系统遭到入侵，最多可能有26,739名客户的服务器被植入恶意软件。</span></p><p><span>为降低风险，GMO关闭了相关服务器，并限制了服务访问，随后展开调查。</span></p><p><span>该公司表示，客户的支付信息未遭泄露，但MetaTrader 4和MetaTrader 5（MT4/MT5）的登录凭证及交易账号信息可能已经暴露或遭到窃取。GMO敦促客户立即重置密码，并终止当前所有活动会话。</span></p><p><span>GMO后续发布的公告证实，攻击者已窃取数据，并索要高达80亿日元（约合人民币3.38亿元）的赎金。GMO明确表示不会支付赎金。该公司宣布将向每位客户支付5000日元（约合人民币211元），以补偿此次事件造成的不便。</span></p><p><span>网络攻击持续升级，</span></p><p><span>攻击者将启动勒索攻击</span></p><p><span>10月26日，GMO发出警告称，攻击者计划在网上泄露客户信息，并启动此前攻击过程中植入客户服务器的勒索软件载荷。</span></p><p><span>次日，GMO要求客户在10月27日中午12时前断开网络连接、关闭电脑，并拔掉所有连接线。与此同时，该公司正与趋势科技合作，开展网络攻击后的恢复工作。</span></p><p><span>GMO在给客户的通知中建议：“完成备份后，请断开网络连接，关闭电脑，并拔掉连接电脑的电源线。”</span></p><p><span><img src=\"/dailyinfo/media/892f79958ca9d25a.webp\" loading=\"lazy\" decoding=\"async\"></span></p><p><span><span>图：GMO向客户发布的应对措施</span></span></p><p><span>GMO表示，公司正在扫描客户系统，以确认设备中是否仍存在恶意软件。对于因勒索软件攻击而受损的客户，公司还将提供性能相当的替换电脑。</span></p><p><span>GMO于当天早些时候发布的报告确认，攻击者已将公司及客户的数据发布到网上。公司正着手核实泄露信息的真实性。</span></p><p><span>对于个人信息遭到泄露的客户，GMO表示，将考虑提供额外的经济补偿。</span></p><p><span>目前看来，攻击者并未兑现发动勒索软件攻击的威胁，客户的电脑上尚未发现勒索软件被激活的迹象。</span></p><p><span>GMO同时警告公众和媒体，不得传播此次事件中泄露的信息，并表示将对传播相关信息的人员采取法律行动。该公司再次强调，不会向攻击者支付赎金。</span></p><p><strong><span>参考资料：bleepingcomputer.com</span></strong></p><p><strong><span><span>推荐阅读</span></span></strong></p><ul><li><p><span><a href=\"http://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247499450&amp;idx=2&amp;sn=2da3ca2e0b4d4f9f56ea7f7579afc378&amp;chksm=ebfab99adc8d308c3ba6e7a74bd41beadf39f1b0e38a39f7235db4c305c06caa49ff63a0cc1d&amp;scene=21#wechat_redirect\">网安智库平台长期招聘兼职研究员</a></span></p></li><li><p><span><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247501251&amp;idx=1&amp;sn=8b6ebecbe80c1c72317948494f87b489&amp;chksm=ebfa82e3dc8d0bf595d039e75b446e14ab96bf63cf8ffc5d553b58248dde3424fb18e6947440&amp;token=525430415&amp;lang=zh_CN&amp;scene=21#wechat_redirect\">欢迎加入“安全内参热点讨论群”</a></span></span></p></li></ul><hr><p><span><span>点击下方卡片关注我们，</span></span></p><p><span><span>带你一起读懂网络安全 ↓</span></span></p><p><a href=\"https://www.secrss.com/?wx\">阅读原文</a></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=8b91fced&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzI4NDY2MDMwMw%3D%3D%26mid%3D2247516790%26idx%3D1%26sn%3D436349113ffe5d99176da6bb6dda7b23\">跳转微信打开</a></p>","original","zhKind","complete","勒索","数据泄露","云原生","Trend Micro","https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&mid=2247516790&idx=1&sn=436349113ffe5d99176da6bb6dda7b23","安全内参",{"_97":98,"_99":-5},"changelogVersion","2026-10-01T08:00","release"]
