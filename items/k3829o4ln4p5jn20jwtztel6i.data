[{"_1":2,"_3":4},"root",{"_5":149},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":54,"_55":36,"_56":36,"_57":58,"_59":36,"_60":61},"expiresAt",1795048832000,"id","k3829o4ln4p5jn20jwtztel6i","title","Elastic Security Labs 发现 agent-framework PyPI 供应链投毒，1.26.1 与 1.26.2 窃取 Azure 凭据","originalTitle","We caught the agent-framework PyPI compromise six minutes after it published","summary","Elastic Security Labs 发现 Microsoft Agent Framework 的 PyPI 元包 agent-framework 遭供应链投毒，恶意版本 1.26.1 与 1.26.2 分别于 2026-11-17 20:35 和 21:08 UTC 发布，并在 1 小时内被 PyPI 移除。","reason","source",{"_76":148},"links",{"_135":147},"publishedAt","2026-11-18T00:00:00.000Z","discoveredAt","2026-11-18T20:47:37.753Z","timelineAt","category","activity","tags",[79,77,141,142,143,144,145,146],"score",88,"selected",true,"channel","news","story",{"_89":90,"_13":91},"x","sameEvent",{"_11":139,"_13":140},"readingMode","full","author","body",{"_61":134,"_135":-5,"_136":137,"_138":36},"outline",[92,93,94,95,96,97,98,99,100,101,102,103,104],"relatedStories",[88],"topics",[68,69,70,71,72,73],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fXDd5gj0lrbY","reportCount",4,"additionalSourceCount",3,{"_74":86,"_76":87},{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","malware","name","恶意软件","attack","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","identity","身份与访问","supply-chain","供应链安全",{"_89":90,"_13":91},"publicId","e603b0df-7979-4476-a581-fff48c892c4e","Agent Framework 包投毒窃取凭据",{"_11":132,"_106":133,"_108":109},{"_11":130,"_106":131,"_108":109},{"_11":128,"_106":129,"_108":109},{"_11":126,"_106":127,"_108":67},{"_11":124,"_106":125,"_108":67},{"_11":122,"_106":123,"_108":67},{"_11":120,"_106":121,"_108":67},{"_11":118,"_106":119,"_108":109},{"_11":116,"_106":117,"_108":109},{"_11":114,"_106":115,"_108":109},{"_11":112,"_106":113,"_108":109},{"_11":110,"_106":111,"_108":109},{"_11":105,"_106":107,"_108":109},"sec-13","text","agent-framework 1.26.1 和 1.26.2 的入侵指标","level",2,"sec-12","如何响应 agent-framework 供应链入侵","sec-11","Elastic Defend 通过以下规则覆盖此次供应链入侵：","sec-10","用于检测 agent-framework 窃取程序的狩猎查询","sec-9","agent-framework 1.26.2 中的变化","sec-8","外传到由攻击者控制的基础设施","sec-7","通过 IMDS 获取 Azure 托管身份令牌","sec-6","来自管道端点的 Azure DevOps OIDC 令牌","sec-5","磁盘上的凭证和配置文件","sec-4","来自主机和运行进程的环境变量","sec-3","agent-framework 凭证窃取程序收集的内容","sec-2","agent-framework 的 .pth 钩子如何触发信息窃取程序（1.26.1）","sec-1","入侵事件及我们的检测方式","<h2 id=\"sec-1\">入侵事件及我们的检测方式</h2><p>Microsoft’s Agent Framework 是一个开源的多语言框架，用于在 Microsoft Azure 生态系统中构建和编排 AI 代理。遭入侵的包是元包，也就是一个用于引入不同框架依赖项的轻量封装程序。agent-framework 在所有版本上的平均下载量为每月 196,000 <a href=\"https://pypistats.org/packages/agent-framework\">次下载</a>。如果版本 <code>1.26.1</code> 或 <code>1.26.2</code> 接触过构建代理或笔记本电脑，请假定该主机上的所有密钥均已泄露，并回退固定到 1.26.0。</p><p><a href=\"https://github.com/microsoft/agent-framework\">agent-framework</a> <code>1.26.1</code> 于 2026 年 11 月 17 日 20:35 UTC 在 PyPI 上线。我们的<a href=\"https://github.com/elastic/supply-chain-monitor\">供应链监控器</a>在 20:41 UTC 将其标记为恶意，并于当晚<a href=\"https://x.com/elasticseclabs/status/2122810560106438890?a=ZyaB8TnnhUzADD6jR-w&amp;s=20\">发布了详细信息</a>。版本 <code>1.26.2</code> 在 21:08 UTC 推出，采用了相同的信息窃取程序，但换用了新文件名。PyPI <a href=\"https://pypi.org/project/agent-framework/1.26.1/#history\">移除了这两个版本</a>，用时不到一小时。</p><p>这两个版本都包含一个 <code>.pth</code> 启动钩子（这是一个纯文本配置文件，Python 的 site 模块会在解释器每次启动时自动处理该文件），因此每当主机上的 Python 启动时，凭证窃取程序都会运行。导入该包并非必要条件。它会读取最多 300 个运行进程的环境变量、Azure CLI 令牌缓存，以及 pip、npm、Docker、git 和 Hugging Face 凭证，然后调用 Azure DevOps 和 GitHub Actions OIDC 端点以及 Azure Instance Metadata Service，以生成新的云端令牌。这些令牌使遭入侵的构建能够访问其背后的 Azure 订阅。收集到的所有数据都被发送到单个 <code>webhook[.]site</code> 端点，并经过 zlib 压缩和 Base64 编码。</p><h2 id=\"sec-2\">agent-framework 的 .pth 钩子如何触发信息窃取程序（1.26.1）</h2><p>攻击者在遭入侵的 1.26.1 包中添加了两个新文件（<code>agent_framework_meta.pth</code>、<code>_telemetry.py</code>），并修改了一个文件（<code>__init__.py</code>）。</p><p>攻击由 <code>.pth</code> 钩子基于以下单行代码触发：</p><pre></pre><p>每当 Python 启动时，其 <code>site</code> 模块都会处理 <code>site-packages</code> 目录中的所有 <code>.pth</code> 文件。这些文件中任何以 <code>import</code> 开头的行都会作为代码执行，且在用户脚本或任何其他代码运行之前执行。</p><p>此次导入会执行该包的 <code>__init__.py</code>，其中包含一个附加在文件末尾的加载器，该加载器会导入 <code>_telemetry.py</code> 并调用其 <code>_start()</code> 函数。</p><pre></pre><p><code>_start()</code> 函数使用环境变量 <code>_AF_TEL</code>，以避免在每个进程树中运行多次，然后派生一个子进程，并通过 <code>setsid()</code> 将其分离。子进程收集密钥并将其 POST 到 <code>webhook[.]site</code>，而父进程继续正常运行，因此窃取过程不会造成任何可见延迟。在 Windows 上，由于 <code>fork()</code> 不可用，它会改为在后台线程中执行收集。</p><pre></pre><h2 id=\"sec-3\">agent-framework 凭证窃取程序收集的内容</h2><h3 id=\"sec-4\">来自主机和运行进程的环境变量</h3><p>凭证窃取程序会收集名称包含以下字符串的环境变量：</p><pre></pre><p>该窃取程序通过读取 <code>/proc/&lt;pid&gt;/environ,</code> 获取最多 300 个运行进程的信息，并保留包含密钥的行，其中包括 <code>SYSTEM_ACCESSTOKEN</code> 和 <code>IDENTITY_HEADER</code>。</p><pre></pre><h3 id=\"sec-5\">磁盘上的凭证和配置文件</h3><p>该窃取程序会检查一个硬编码的 glob 模式列表，覆盖所有用户主目录以及 <code>/root</code> 中的凭证位置。目标包括：</p><ul>\n<li>Azure CLI 令牌缓存（<code>~/.azure</code>）、</li>\n<li>Pip 配置：<code>pip.conf</code>、<code>.npmrc</code>、<code>.netrc</code>、<code>.git-credentials</code></li>\n<li>Docker <code>config.json</code></li>\n<li>Hugging Face 令牌</li>\n<li>Foundry 配置</li>\n<li><code>/app</code> 和 <code>/workspace</code> 下的 <code>.env</code> 文件</li>\n<li>Azure Pipelines 代理 <code>.credentials</code> 文件</li>\n</ul><h3 id=\"sec-6\">来自管道端点的 Azure DevOps OIDC 令牌</h3><p>如果窃取程序在 Azure DevOps 流水线中运行，它会使用 <code>SYSTEM_ACCESSTOKEN</code> 调用流水线 OIDC 端点（<code>SYSTEM_OIDCREQUESTURI)</code>，首先请求 <code>api://AzureADTokenExchange</code> 范围，然后使用空的请求体重试。两个请求都不包含 Microsoft 文档所述流程用于为特定服务连接签发令牌的 <code>serviceConnectionId</code> 参数，因此尚不清楚这些请求是否会返回与任何联合凭据相匹配的令牌。</p><p>如果获得了可用令牌，无论是通过此请求还是从 Azure 任务暴露的环境变量中获得，都可以用它换取 Microsoft Entra ID 访问权限，身份将作为相应的工作流身份联合服务连接背后的身份。</p><p>攻击者将获得该身份的 Azure 角色分配；具体权限可能仅限于单个资源组，也可能扩展到整个订阅，具体取决于服务连接的配置方式。</p><pre></pre><h3 id=\"sec-7\">通过 IMDS 获取 Azure 托管身份令牌</h3><p>如果窃取程序运行在具有托管身份的 Azure 资源上，它会为该身份请求访问令牌。在 App Service 和类似平台上，它使用本地身份端点（<code>IDENTITY_ENDPOINT</code> 或 <code>MSI_ENDPOINT</code>）；在其他情况下，它会查询位于 <code>169.254.169[.]254</code> 的 Azure 实例元数据服务（IMDS）。它会为 12 个资源分别请求令牌，包括：</p><ul>\n<li>Azure Resource Manager</li>\n<li>Microsoft Graph</li>\n<li>Key Vault</li>\n<li>Storage</li>\n<li>Azure AI Foundry</li>\n<li>Azure Machine Learning</li>\n<li>Container Registry</li>\n<li>Azure DevOps（<code>499b84ac-1321-427f-aa17-267ca6975798</code>）</li>\n</ul><p>每个令牌都允许攻击者在令牌有效期内以托管身份身份访问相应服务，并拥有该身份被授予的权限。窃取程序还会收集 IMDS 实例元数据，例如订阅 ID、资源组和 VM 名称，这些信息会准确告诉攻击者被窃取的令牌属于哪个环境。</p><h2 id=\"sec-8\">外传到由攻击者控制的基础设施</h2><p>收集到的数据（包括主机上下文，如主机名、用户名和工作目录、命令行参数以及时间戳）会全部打包到单个 <code>POST</code> 请求中。这些数据会被序列化为 JSON，使用 zlib 压缩，并进行 Base64 编码。结果会作为请求正文发送到 <a href=\"https://webhook%5B.%5Dsite/d381fd80-ec62-42ad-8f5c-d1b15103c9bb?t=telemetry\"><code>https://webhook[.]site/d381fd80-ec62-42ad-8f5c-d1b15103c9bb?t=telemetry</code></a>，User-Agent 为 <code>af-runtime-diagnostics/1</code>。</p><pre></pre><h2 id=\"sec-9\">agent-framework 1.26.2 中的变化</h2><table><thead><tr><th></th><th>1.26.1</th><th>1.26.2</th></tr></thead><tbody><tr><td>发布时间（UTC）</td><td>2026-11-17 20:35</td><td>2026-11-17 21:08</td></tr><tr><td>启动钩子</td><td><code>agent_framework_meta.pth</code></td><td><code>af_runtime_diag.pth</code></td></tr><tr><td>窃取模块</td><td><code>agent_framework_meta/_telemetry.py</code></td><td><code>af_runtime_diag.py</code></td></tr><tr><td>外传 User-Agent</td><td><code>af-runtime-diagnostics/1</code></td><td><code>runtime-diagnostics/1</code></td></tr><tr><td>Wheel SHA-256</td><td><code>d27fa344…e989e110</code></td><td><code>3d20a8bc…c9f7e0a9</code></td></tr><tr><td>GitHub Actions OIDC</td><td>否</td><td>是</td></tr><tr><td>外传端点</td><td>相同的 webhook.site URL</td><td>相同的 webhook.site URL</td></tr></tbody></table><p>首个恶意包发布约 30 分钟后，威胁行为者推送了一个新版本（<code>1.26.2</code>），重构了攻击链的加载方式，并新增了一个 GitHub Actions 收集器。攻击者使用新的 <code>.pth</code> 钩子（<code>af_runtime_diag.pth</code>）和新的 Python 模块（<code>af_runtime_diag.py</code>）修改了该包</p><pre></pre><p>Python 模块（<code>af_runtime_diag.py</code>）包含完全相同的窃取代码，只是新增了针对 GitHub Actions 的目标。</p><pre></pre><p>两个恶意版本都指向同一个外传端点（<a href=\"https://webhook%5B.%5Dsite/d381fd80-ec62-42ad-8f5c-d1b15103c9bb?t=telemetry\"><code>https://webhook[.]site/d381fd80-ec62-42ad-8f5c-d1b15103c9bb?t=telemetry</code></a>）。</p><h2 id=\"sec-10\">用于检测 agent-framework 窃取程序的狩猎查询</h2><p>可以使用以下狩猎查询查找相关活动：</p><pre></pre><pre></pre><h2 id=\"sec-11\">Elastic Defend 通过以下规则覆盖此次供应链入侵：</h2><ul>\n<li><a href=\"https://github.com/elastic/detection-rules/blob/main/rules/cross-platform/initial_access_elastic_defend_alert_package_manager_ancestor.toml\">来自包管理器安装祖先的 Elastic Defend 警报</a></li>\n<li><a href=\"https://github.com/elastic/detection-rules/blob/main/rules/cross-platform/credential_access_suspicious_instance_metadata_service_api_request.toml\">可疑的实例元数据服务（IMDS）API 请求</a></li>\n<li><a href=\"https://github.com/elastic/detection-rules/blob/main/rules/cross-platform/credential_access_secret_file_access_followed_by_imds_request.toml\">包运行时秘密文件访问后紧接 IMDS 请求</a></li>\n</ul><h2 id=\"sec-12\">如何响应 agent-framework 供应链入侵</h2><ul>\n<li>在 <code>site-packages</code> 文件夹（<code>agent_framework_meta.pth</code>、<code>af_runtime_diag.pth</code>）中搜索以下文件，以检查是否受到影响。</li>\n<li>将 agent-framework 固定为干净版本（<code>1.26.0</code>）。</li>\n<li>将受影响主机上所有可读取的内容都视为已泄露。这包括所有运行进程的环境变量、凭据和配置文件、缓存的云端和 CLI 令牌，以及主机上的构建或工作负载所接触到的任何机密。轮换长期有效的机密，并审查短期令牌的活动；这些令牌无法撤销。</li>\n<li>搜索代理、DNS 或防火墙日志，使用 User-Agent（<code>af-runtime-diagnostics/1</code>、<code>runtime-diagnostics/1</code>）<code>webhook[.]site</code>。</li>\n<li>考虑在采用新发布的软件包之前增加一段延迟，因为此次攻击在数小时内即被发现并移除。</li>\n</ul><h2 id=\"sec-13\">agent-framework 1.26.1 和 1.26.2 的入侵指标</h2><p>本研究讨论了以下可观测项。</p><table><thead><tr><th>可观测项</th><th>类型</th><th>名称</th><th>参考</th></tr></thead><tbody><tr><td><code>https://webhook[.]site/d381fd80-ec62-42ad-8f5c-d1b15103c9bb?t=telemetry</code></td><td>URL</td><td></td><td>外泄端点</td></tr><tr><td><code>af-runtime-diagnostics/1</code></td><td>User Agent</td><td></td><td></td></tr><tr><td><code>runtime-diagnostics/1</code></td><td>User Agent</td><td></td><td></td></tr><tr><td><code>d27fa34414e6201d5e03e559ef634f020057554d7b3f4898dd5d7cd3e989e110</code></td><td>SHA-256</td><td><code>agent_framework-1.26.1-py3-none-any.whl</code></td><td></td></tr><tr><td><code>3d20a8bc91351a9a16b6db243b848ceca0206b7a8623b02d2af553a9c9f7e0a9</code></td><td>SHA-256</td><td><code>agent_framework-1.26.2-py3-none-any.whl</code></td><td></td></tr><tr><td><code>39fa329f2a93f734b0bb8f5adb203ea3331d1ae479832a5015a54cb17aabd663</code></td><td>SHA-256</td><td><code>_telemetry.py</code></td><td></td></tr><tr><td><code>c275ccbe520ef3c0f02dc6a35389e427f9f1b4e0b12e140cd7bf7179ce143f02</code></td><td>SHA-256</td><td><code>agent_framework_meta/__init__.py</code></td><td></td></tr><tr><td><code>21f28e8517a10ffe431f8d68f5875c85eca4001ae6d118322b0a41873998eb5e</code></td><td>SHA-256</td><td><code>agent_framework_meta.pth</code></td><td></td></tr><tr><td><code>54d885b7d7161c9ed96489c66364c4bfbf635929166843bba10d97d46b5a2e1f</code></td><td>SHA-256</td><td><code>af_runtime_diag.py</code></td><td></td></tr><tr><td><code>325e7e9f0ec94e41ad1a1b7a3f18a6b8b5bffece2e2b97b8d3369eb967452f93</code></td><td>SHA-256</td><td><code>af_runtime_diag.pth</code></td><td></td></tr></tbody></table>","original","zhKind","translation","complete","z69zj40alkpfq51pcwzj6kkm6","Microsoft Agent Framework 的 PyPI 包 1.26.1 和 1.26.2 被植入凭据窃取代码","供应链投毒","数据窃取","凭据","Agent 安全","Microsoft","AWS","https://www.elastic.co/security-labs/threat-command/we-caught-the-agent-framework-pypi-compromise-six-minutes-after-it-published","Elastic Security Labs",{"_150":151,"_152":-5},"changelogVersion","2026-10-01T08:00","release"]
