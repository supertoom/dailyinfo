[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1793621626000,"id","t3l9596863p91npbg5zvmufyi","title","Chainalysis 披露 AI Agent 辅助入侵事件，部分客户资料被窃取","originalTitle","Chainalysis Investigates Security Incident Involving AI-Driven Attack Techniques","summary","Chainalysis 本月发现外部攻击者使用涉及 AI Agent 的进攻技术，访问其系统与内部工具，窃取用户 ID、完整姓名、电子邮箱和机构角色标签等非敏感客户数据。","reason","source",{"_73":97},"links",{"_61":96},"publishedAt","2026-11-02T08:25:46.000Z","discoveredAt","2026-11-02T09:46:36.018Z","timelineAt","category","activity","tags",[74,93,76,94,95],"score",57,"selected",false,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","Pierluigi Paganini","body",{"_89":-5,"_61":90,"_91":-5,"_92":36},"outline",[83],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fxhNzzYj4hPo","reportCount",5,"additionalSourceCount",4,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","attack","name","攻击活动","ai-offense","AI 攻防","ai-agent","AI Agent 安全",{"_80":81,"_13":82},"publicId","038a18c5-a6fe-4fe6-89fe-22bf5ade225b","Chainalysis确认智能体化入侵事件",{"_11":84,"_85":86,"_87":88},"sec-1","text","Chainalysis suffered a cyberattack exposing customer names, emails and user IDs,","level",2,"zh","<h2 id=\"sec-1\">Chainalysis suffered a cyberattack exposing customer names, emails and user IDs, while investigation data and passwords remain safe.</h2><p>Blockchain analytics firm Chainalysis says it was the target of a cybersecurity incident. A threat actor accessed its systems and internal tools and stole some non-sensitive customer data. </p><p><em>“This month, Chainalysis detected an external actor using offensive agentic techniques to gain unauthorized access to Chainalysis systems and internal tools.” reads the <a href=\"https://www.chainalysis.com/blog/security-incident-october-30/\">statement</a> published by the company, which also includes the full email sent to affected customers.</em></p><p>Chainalysis says it discovered the attacker this month and described the methods used as offensive techniques involving AI agents. However, it did not explain how the attack was carried out. The company also warned that AI-powered attacks are becoming more common across the industry and said it is taking a company-wide approach to dealing with this growing threat.</p><p>The data the attacker reached matters most. According to Chainalysis, attackers gained access to user IDs, full names, email addresses and organization role labels for users on the platform. The company is still working out which records belong to which customer and promises a detailed breakdown when it finishes.</p><p>What the attacker didn’t reach is just as important. So far, Chainalysis has found no sign of access to investigation content such as graphs, notes or cases, or to transaction and query results. It also found no clear-text passwords, MFA secrets or user session tokens in the attacker’s hands.</p><p><em>“Based on the evidence available to date, we have found no indication that these incidents resulted in the unauthorized access of investigation content (such as graphs, notes, or cases), transaction or query results, passwords in clear text, MFA secrets, or user session tokens.” continues the press release. </em></p><p><em>Some non-sensitive customer data, such as user IDs, full names, email addresses, and organization role labels for users provisioned on our platform were accessed, including such information relating to your organization and users. We are in the process of determining the records for your organization that were accessed and will provide a detailed breakdown as soon as that analysis is complete.</em>“</p><p>The company says it’s patching vulnerabilities and hardening its systems around the clock. It has hired outside cybersecurity experts and is using large language models to support a wider review that goes beyond the flaws the attacker used. It has already told all its customers and will keep them updated.</p><p>Chainalysis advises customers to watch out for unexpected password reset requests or login approval prompts. The company also strongly recommends enabling two-factor authentication (2FA) for all organizations that have not already done so. Since the exposed data includes names and email addresses, attackers could use it to launch phishing campaigns.</p><p>The company also clarified that the security incident has nothing to do with the recent theft of more than <a href=\"https://securityaffairs.com/202221/apt/fbi-blames-north-korea-for-6-billion-binance-crypto-theft.html\">$6 billion from Binance</a>.</p><p><strong>Follow me on Twitter:&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a><strong></strong></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;hacking,&nbsp;Chainalysis)</strong></p>","zhKind","complete","数据泄露","Agent 安全","大模型","https://securityaffairs.com/202241/ai/chainalysis-investigates-security-incident-involving-ai-driven-attack-techniques.html","Security Affairs",{"_99":100,"_101":-5},"changelogVersion","2026-10-01T08:00","release"]
