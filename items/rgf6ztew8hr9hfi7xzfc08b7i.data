[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794530491000,"id","rgf6ztew8hr9hfi7xzfc08b7i","title","法国将超市冷藏设备攻击归因于 Iran IRGC","originalTitle","France Blames Iran for the Supermarket Fridge Attacks","summary","法国将 11 月 12 日发生的 700 个超市冷藏站点攻击归因于 Iran IRGC 关联的 Shahid Kaveh 网络部队，称攻击通过抬升冰箱温度破坏库存并引发数起火灾；归因依据包括基础设施、签名工具、波斯语痕迹及关联宣传组织，但作者指出公开报道未说明技术证据。","reason","材料区分法国政府的归因主张与尚未确认的关联事件，并整理了控制器入侵路径及可落地的防护措施。","source",{"_73":96},"links",{"_89":95},"publishedAt","2026-11-09T19:12:43.000Z","discoveredAt","2026-11-09T19:32:27.495Z","timelineAt","category","activity","tags",[74,93,94,78],"score",75,"selected",true,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","Pierluigi Paganini","body",{"_61":88,"_89":-5,"_90":91,"_92":37},"outline",[83],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fAIxGhxCLzqM","reportCount",2,"additionalSourceCount",1,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","attack","name","攻击活动","supply-chain","供应链安全","cisa","CISA",{"_80":81,"_13":82},"publicId","60857cc0-39ba-44e7-93b7-3a108f8b6b7a","法国归因伊朗网络部队攻击700余零售点",{"_11":84,"_85":86,"_87":65},"sec-1","text","法国将超市冰箱袭击归咎于伊朗。已知情况、尚不明确之处，以及如何保护暴露的控制器。","level","<h2 id=\"sec-1\">法国将超市冰箱袭击归咎于伊朗。已知情况、尚不明确之处，以及如何保护暴露的控制器。</h2><p>法国外交部长 Jean-Noël Barrot 表示，<a href=\"https://securityaffairs.com/39690/cyber-crime/iranian-hackers-gmail.html\">伊朗革命卫队</a>是 10 月 11 日和 12 日法国<a href=\"https://securityaffairs.com/tag/french-supermarkets\">超市冰箱</a>袭击事件的幕后黑手。他说，袭击波及了 700 个地点，并导致冰箱温度升高。一些商店丢弃了全部易腐食品，多处还发生了火灾。</p><p><em>“法国将针对法国利益的破坏活动与颠覆及破坏行动归咎于伊朗伊斯兰共和国（伊朗伊斯兰革命卫队电子与网络中心——IRGC-ECC）。”法国网络安全机构 ANSSI 发布的<a href=\"https://cyber.gouv.fr/actualites/campagnes-de-d%C3%A9stabilisation-et-sabotage-men%C3%A9es-%C3%A0-lencontre-des-int%C3%A9r%C3%AAts-fran%C3%A7ais-par-la-r%C3%A9publique-islamique-diran/\">声明</a>如此写道。“经过调查，C4 得以将这些破坏性行动归咎于隶属于伊朗伊斯兰革命卫队电子与网络中心（IRGC-ECC）的 Shahid Kaveh 网络进攻部队：基础设施特征、签名工具的使用、与 Shahid Kaveh 有关联的宣传机构对袭击的转播，以及攻击基础设施中使用波斯语的痕迹。”</em></p><p>外交部长 Jean-Noël Barrot 将此次袭击描述为“在规模和侵略程度上均前所未有”，并称其是在法国本土实施的首次重大网络破坏行动。他承诺实施欧盟层面的制裁，法国还召见了伊朗大使。欧盟外交政策主管 Kaja Kallas 表示，应对此事采取强有力的回应，并补充说她刚刚得知法国的归因结论。</p><p><em>“我可以确认，此次袭击是由伊朗伊斯兰共和国伊斯兰革命卫队实施的，”外交部长 Jean-Noël Barrot 谈及发生在 10 月 11 日和 12 日的法国超市网络袭击时表示，<a href=\"https://www.lemonde.fr/en/france/article/2026/11/09/france-accuses-iran-s-guards-of-cyberattacks-on-supermarket-fridges_6776101_7.html\">《世界报》</a>对此进行了报道。</em></p><p><em>“此次袭击在规模和侵略程度上均前所未有，”Barrot 表示。“这标志着首次以破坏为目的、针对我国领土的大规模网络袭击，是对国家利益和法国人民安全的重大攻击。”</em></p><p><em>“我们将在欧洲层面对所有责任人实施制裁，”他补充道。</em></p><p>巴黎检察官已对 <a href=\"https://securityaffairs.com/190485/apt/u-s-agencies-alert-iran-linked-actors-target-critical-infrastructure-plcs.html\">Shahid Kaveh</a>负责人及其两名副手展开司法调查。该部队是隶属于革命卫队电子与网络中心的网络进攻单位。检方确认的其他相关人员也可被纳入此案。</p><p>归因依据包括共用基础设施、攻击工具、波斯语痕迹，以及由与该组织有关联的宣传机构进行的传播。</p><p>法国当局称，针对法国利益的伊朗网络行动至少可追溯至 2020 年。此前的相关事件包括针对《Charlie Hebdo》策划的一次袭击、2023 年其网络商店遭入侵（该事件被归咎于 Emennet Pasargad），以及 2024 年在巴黎奥运会前试图劫持数字广告亭、显示反以色列信息的行动。C4 将这些行动归咎于与 IRGC 有关联的 Shahid Shoostari 部队。</p><p>法国并非唯一受害者。11 月 2 日，至少<a href=\"https://securityaffairs.com/202260/security/another-fridge-cyberattack-hits-european-supermarkets-this-time-in-belgium-luxembourg-sweden-and-estonia.html\">另外九个欧洲国家</a>的超市报告了其制冷系统遭到疑似袭击。Barrot 仅谈及法国案例，因此目前尚无官方信息将第二波袭击与伊朗联系起来。</p><p>这正是我们需要谨慎的地方。当政府点名某个国家应对一次攻击负责时，这是一项严重指控。但我读过的报告并未解释其背后的技术证据。我们应将其视为官方说法，而不是已证实的事实，并坚持我们已知的信息。恐惧与不确定性可能被用来制造不信任，而这一风险适用于所有参与此事的各方。</p><p><br>关键问题不只是识别攻击者，还要判断是否有人利用这些事件来推动混合战叙事。黑客行动主义者的说法可能更多是为了宣传和吸引关注，而非反映实际责任。如果法国的调查确认伊朗参与了 10 月的袭击，那么声称制造了 11 月事件的<a href=\"https://securityaffairs.com/tag/noname05716-2\">亲俄组织</a>将面临严重的公信力问题。他们可能试图冒领他人的行动。尽管如此，他们参与其中部分事件的可能性仍然存在。</p><p>在当今的<a href=\"https://securityaffairs.com/tag/hybrid-warfare\">混合战争</a>中，归因不确定、战略模糊和信息操纵，使人们越来越难以将真实攻击与宣传区分开来。</p><p>至少，超市冰箱攻击所采用的方法是有<a href=\"https://securityaffairs.com/202730/hacking/cisa-and-the-fbi-warn-of-attacks-against-industrial-refrigeration-controllers.html\">记录的</a>。11 月 5 日，CISA、FBI 和美国其他机构发布了关于同类活动的概况说明。攻击者可能会利用未打补丁或可联网访问的控制器中的漏洞或弱点，远程更改设置，迫使设备持续加热和除霜，从而造成大范围库存损失和设备危险。</p><p>这些机构列出了三种入侵方式：绕过身份验证、注入代码以及配置不当。他们还警告称，操作人员可能无法掌握真实温度——等到奶酪已经坏掉才发现这一点可不是什么好事。</p><p>修复办法很乏味，但确实有效。不要让控制器接入互联网；如果需要远程访问，应在前面部署更新过的防火墙。将工业设备与办公网络隔离，更改默认密码，启用抗网络钓鱼的多因素身份验证，打补丁更新固件，并更换制造商已不再支持的设备。</p><p>然后使用获批设备和 IP 地址的白名单，限制能够更改设置的人员。将经过测试的备份保存在异地且离线，启用日志记录并查看日志。最后一项控制措施成本最低：为控制器下游运行的设备定义并维护合理的设定点限制，使其保持在安全范围内，并针对偏离情况建立警报。</p><p><strong>在 Twitter 上关注我：&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;和&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;和&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a><strong></strong></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;黑客行动，&nbsp;伊朗)</strong></p>","original","zhKind","translation","complete","数据泄露","供应链","https://securityaffairs.com/202742/hacking/france-blames-iran-for-the-supermarket-fridge-attacks.html","Security Affairs",{"_98":99,"_100":-5},"changelogVersion","2026-10-01T08:00","release"]
