[{"_1":2,"_3":4},"root",{"_5":121},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":61,"_62":63},"expiresAt",1795653648000,"id","se06jkkvhtyb26dhkzam6bcy6","title","攻击者利用未撤销密钥入侵 Barracuda 云环境并部署 ARTEX 智能体","originalTitle","AI攻破安全厂商，锅在一把没回收的密钥","summary","Barracuda 报告称，攻击者利用发给第三方 AI 服务提供商且未及时撤销的云访问密钥进入其云环境，活动持续近两天，先后拿下 10 个云环境，其中部分承担 XDR 产品管理职能。","reason","source",{"_76":47},"links",{"_111":120},"publishedAt","2026-11-25T03:03:57.000Z","discoveredAt","2026-11-25T03:12:34.685Z","timelineAt","category","activity","tags",[77,79,116,117,118,119],"score",73,"selected",true,"channel","news","story",{"_85":86,"_13":87},"x","sameEvent",{"_11":114,"_13":115},"readingMode","full","author","安全客","body",{"_63":110,"_111":-5,"_112":111,"_113":36},"outline",[88,89,90,91,92,93],"relatedStories",[84],"topics",[70,71,72,73],"indexable","markdownAvailable","group",{"_64":65,"_66":67,"_68":69},"hasTranslation",false,"bodyLanguage","zh","factId","fy7KDxMifBpw","reportCount",6,"additionalSourceCount",5,{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","attack","name","攻击活动","ai-offense","AI 攻防","identity","身份与访问","cloud-native","云与原生",{"_85":86,"_13":87},"publicId","1f142198-f6f4-4e60-a4cf-2d4bb1e3aec4","Barracuda确认ARTEX驱动云环境入侵",{"_11":108,"_95":109,"_97":103},{"_11":106,"_95":107,"_97":103},{"_11":104,"_95":105,"_97":103},{"_11":101,"_95":102,"_97":103},{"_11":99,"_95":100,"_97":98},{"_11":94,"_95":96,"_97":98},"sec-6","text","相关文章","level",3,"sec-5","TA的文章","sec-4","四、今天就能做的四件事",2,"sec-3","三、最尴尬的是，这事发生在安全厂商身上","sec-2","二、他们到底在找什么","sec-1","一、进门之后，放进来的是一个会自己找路的智能体","<p><span>首页</span></p><ul></ul><p><span>活动</span></p><ul></ul><p><span>社区</span></p><ul></ul><p><span>学院</span></p><ul></ul><p><span>安全导航</span></p><ul></ul><p><span>阅读量</span><b>1613</b></p><p>发布时间 : 2026-11-25 11:03:57</p><p>11 月 18 日，安全内参披露了美国网络安全厂商梭子鱼（Barracuda）的一起入侵事件。攻击者进入其云环境，活动持续了近两天，前后拿下<strong>10 个云环境</strong>，其中一部分还承担着 XDR 安全产品的管理职能。</p><p>梭子鱼在事后报告里把入口说得很直白：公司此前把一把云访问密钥发给了一家第三方 AI 服务提供商，双方合作结束后，这把密钥没有被及时撤销，一直处于有效状态。攻击者就是拿着它进的门。</p><h2 id=\"sec-1\">一、进门之后，放进来的是一个会自己找路的智能体</h2><p>如果只是有人拿着泄露的密钥进来翻东西，这事顶多算一起普通的云上入侵。真正让它变得不一样的，是攻击者随后在环境里部署了&nbsp;ARTEX——一个 AI 渗透测试框架。</p><p>ARTEX 不是新面孔。FBI 此前已经点名警告过这类智能体，称其可以在不到三小时内拿到特权访问。上个月 Railway 事件里，攻击者用的也是类似工具，靠客户泄露的 AI 服务凭证，让对方损失了近百万美元的计算成本。</p><p>在这个案子里，攻击者进了云环境之后并没有急着打包数据，而是先跑查询命令收集其他凭据，再往内部网络和其他云环境横向移动。<strong>从一把钥匙，到一个能自己规划路径的执行体，中间的差距被 AI 抹平了。</strong></p><p>过去我们说”拿下一台机器”，通常意味着攻击者要一台一台找下一跳。现在工具会自己去枚举权限、比对配置、挑选阻力最小的路径。防守方在日志里看到的，往往不是一串整齐的探测，而是一堆看起来像正常运维操作的调用。</p><p>这也解释了一个常被问到的问题：为什么入侵检测没拦住？因为拦的前提是”这件事看起来不像正常行为”。当一个智能体用合法密钥、按合法速率、调用合法接口时，它和一次正常的运维巡检在数据层面几乎没有区别。真正能暴露它的，是权限跨度——一个本该只读的角色突然去列 Secret，一个只服务单一业务的主机突然去连另一个云账号。规则要写在这种地方，而不是写在流量特征上。</p><h2 id=\"sec-2\">二、他们到底在找什么</h2><p>报告里有一个细节值得所有做云安全的人看一眼：攻击者进入系统后，重点搜索的是加密货币钱包相关数据，包括助记词、私钥，名字里带钱包字样的 Kubernetes 密钥，以及环境变量里带加密货币关键词的条目。</p><p>这不像国家背景的窃密行动，更像一次以变现为目的的扫荡。梭子鱼也据此判断，攻击者极有可能是一个经济犯罪团伙。</p><p>但对防守方来说，动机其实不重要。<strong>重要的是攻击者的搜索习惯暴露了一个事实：他们默认云环境里会散落着长期有效的密钥。</strong>而现实往往不会让他们失望——K8s Secret 里的东西几年不轮换，CI 变量里躺着生产库密码，离职人员的 token 还在白名单里。</p><blockquote><p>密钥管理的难点从来不是”发不发”，而是”发给谁、什么时候收回”。发的时候有流程，收的时候往往只剩一句”我记得好像删了”。</p></blockquote><h2 id=\"sec-3\">三、最尴尬的是，这事发生在安全厂商身上</h2><p>目前没有证据表明攻击者拿到了 XDR 平台的客户集成凭据，也没有证据显示他们借这些凭据继续入侵客户网络。出于谨慎，梭子鱼已经通知部分客户重新签发相关凭据。</p><p>这句话听着像安抚，但对使用其产品的单位来说，是一个必须当真的动作项。安全产品的管理平台一旦被摸到，攻击者不需要直接打穿你的网络，只要顺着平台和终端之间的信任关系走，就能绕过一整套边界防护。这类路径在过去的供应链事件里反复出现，代价往往由下游客户承担。</p><p>还有一个时间线值得注意：梭子鱼是在 11 月 4 日才知道出事的，而那时距离攻击者最后一次活动已经过去两天。最先告诉他们异常的不是自己的监控，而是那家第三方 AI 服务商，同时一名工程师在自己的账号上发现了异常活动。</p><p>一家做邮件安全、做 XDR 的公司，靠外部提醒才发现自己被入侵，这才是这条新闻里最扎人的部分。它说明<strong>检测能力再强，也补不上身份与凭据治理的窟窿</strong>。工具能看见流量异常，看不见一把三年前发出去、至今还有效的钥匙。</p><p>同样的逻辑放在国内也成立。现在几乎所有厂商都在往产品里接大模型能力，接的方式大同小异：给第三方一个云账号、一把密钥、一段 API 访问权限。合同里写着”合作结束后回收”，但回收这件事既不在研发的发布清单里，也不在安全的巡检清单里，最后就成了没人负责的灰色地带。</p><h2 id=\"sec-4\">四、今天就能做的四件事</h2><ul>\n<li>把所有第三方合作方发出去的密钥做一次盘点，逐个确认是否仍在有效期。合作终止时间在半年以前的，优先处理。</li>\n<li>给云上长期凭证设上限。能换短期凭证的换短期，能走角色扮演的不要发 AccessKey，把”永久有效”这个选项从流程里删掉。</li>\n<li>查一遍 K8s Secret 和环境变量里有没有明文的生产凭据，尤其是名字里带 key、token、wallet 的条目。这部分是攻击者最先翻的地方。</li>\n<li>把云审计日志里的”首次出现的调用来源 IP”做成告警。这次事件里，攻击者用的是合法密钥，唯一反常的只有来源和行为模式。</li>\n</ul><p>这件事真正的教训不是”AI 很可怕”，而是一把没回收的密钥，配上会自己找路的工具，杀伤力比过去大了不止一个量级。AI 把攻击者的执行力放大了，但门是他们自己留的。密钥回收、权限收敛、凭证轮换，这些老掉牙的活，才是这类事件里唯一有效的防线。安全检查表上最不起眼的那一行，往往就是对手最先推的门。</p><p><strong>更多AI知识，请扫码关注Aiker World社区公众号</strong></p><p><img src=\"/dailyinfo/media/4cb9f440ec099ebd.jpg\" loading=\"lazy\" decoding=\"async\" width=\"302\"></p><p><strong>Aiker World社区网址：https://aikerworld.com</strong></p><p><img src=\"/dailyinfo/media/06681916c230fc42.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\" width=\"286\" height=\"286\"></p><p><strong>Aiker World（AI世界）-聚焦AI人才与智能体工具的垂直专家社区。专家领航+人才汇聚+工具赋能，打通AI技术与产业落地断层，为AI从业者、开发者及企业提供一站式成长与协作平台。</strong></p><ul></ul><p><i></i><span>0赞</span></p><p><i></i><span>收藏</span></p><p><img src=\"/dailyinfo/media/70ab185b499e257e.jpg\" loading=\"lazy\" decoding=\"async\"><span>安全客</span><span></span></p><p><a href=\"https://www.anquanke.com/member.html?memberId=184300\"><img src=\"/dailyinfo/media/70ab185b499e257e.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p><a href=\"https://www.anquanke.com/member.html?memberId=184300\">安全客</a></p><p>这个人太懒了，签名都懒得写一个</p><ul><li>文章</li><li><strong>105</strong></li></ul><ul><li>粉丝</li><li><strong>5</strong></li></ul><h3 id=\"sec-5\"> TA的文章</h3><ul><li><h5><a href=\"https://www.anquanke.com/post/id/316536\">德国把网络威胁拉到最高档，理由就四个字：智能体 AI</a></h5><p>2026-11-23 09:51:25</p></li><li><h5><a href=\"https://www.anquanke.com/post/id/316533\">全球第九的超算被黑，丢的是 4224 把 SSH 私钥</a></h5><p>2026-11-23 09:29:02</p></li><li><h5><a href=\"https://www.anquanke.com/post/id/316528\">内核全版本中招，AI帮着补上了利用链</a></h5><p>2026-11-20 17:42:20</p></li><li><h5><a href=\"https://www.anquanke.com/post/id/316525\">谷歌给出倒计时：半年内，AI 会自己找洞、自己打进来</a></h5><p>2026-11-20 17:37:36</p></li><li><h5><a href=\"https://www.anquanke.com/post/id/316503\">一句“永远别放弃”，40 个 AI 智能体真的去打了一家真实网站</a></h5><p>2026-11-18 12:46:26</p></li></ul><h3 id=\"sec-6\"> 相关文章</h3><ul><li><h5><a href=\"https://www.anquanke.com/post/id/316503\">一句“永远别放弃”，40 个 AI 智能体真的去打了一家真实网站</a></h5><p>2026-11-18 12:46:26</p></li><li><h5><a href=\"https://www.anquanke.com/post/id/316500\">用AI做安全的人，正在丢掉吃饭的本事</a></h5><p>2026-11-18 11:22:59</p></li><li><h5><a href=\"https://www.anquanke.com/post/id/316257\">月下载9000万次的AI网关LiteLLM曝双漏洞：低权限账号就能偷走你所有API密钥</a></h5><p>2026-10-20 19:06:20</p></li><li><h5><a href=\"https://www.anquanke.com/post/id/316039\">满分预警：ServiceNow连爆3个CVSS 10.0漏洞，无需登录即可接管整个平台</a></h5><p>2026-08-30 23:59:29</p></li><li><h5><a href=\"https://www.anquanke.com/post/id/316021\">一张网页就能投毒你的AI大模型：NVIDIA NemoClaw缺陷曝光，沙箱挡得住黑客，挡不住\"夺舍\"</a></h5><p>2026-08-26 10:28:49</p></li><li><h5><a href=\"https://www.anquanke.com/post/id/316016\">Zoom高危漏洞曝光：你的屏幕共享正在被黑客远程接管</a></h5><p>2026-08-25 11:04:42</p></li><li><h5><a href=\"https://www.anquanke.com/post/id/316013\">2.45亿次下载的Rust crate被投毒：编译时恶意代码自动执行，朝鲜黑客又出手了</a></h5><p>2026-08-24 14:12:38</p></li></ul><p>文章目录</p><p><img src=\"/dailyinfo/media/c94f5de7ce112eee.webp\" loading=\"lazy\" decoding=\"async\"></p><p>合作单位</p><ul><li><a href=\"http://www.cert.org.cn/\"><img alt=\"安全KER\" src=\"/dailyinfo/media/c7a6145de1faf802.webp\" loading=\"lazy\" decoding=\"async\"></a></li><li><a href=\"http://www.cnnvd.org.cn/\"><img alt=\"安全KER\" src=\"/dailyinfo/media/4da6e4f614db514b.webp\" loading=\"lazy\" decoding=\"async\"></a></li></ul><p><span>Copyright © 北京奇虎科技有限公司 三六零数字安全科技集团有限公司 安全KER All Rights Reserved </span><a href=\"https://beian.miit.gov.cn/\">京ICP备08010314号-66</a><span><a href=\"https://www.cnzz.com/stat/website.php?web_id=1271278035\" title=\"站长统计\"><img src=\"/dailyinfo/media/ea74889b2a2bf656.gif\" loading=\"lazy\" decoding=\"async\"></a></span></p>","original","zhKind","