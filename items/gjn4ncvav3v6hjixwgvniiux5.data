[{"_1":2,"_3":4},"root",{"_5":137},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795480835000,"id","gjn4ncvav3v6hjixwgvniiux5","title","Amazon Cognito 用户池启用 PITR，误删后可按时间点恢复","originalTitle","Protect identity data with point-in-time recovery in Amazon Cognito","summary","Amazon Cognito 已为符合条件的用户池自动启用 PITR，可在误删除、错误迁移或批量操作异常后恢复用户池。Essentials 方案恢复窗口最长 1 天，Plus 方案最长 14 天。","reason","source",{"_72":136},"links",{"_61":135},"publishedAt","2026-11-23T16:43:50.000Z","discoveredAt","2026-11-23T17:38:35.658Z","timelineAt","category","blue-team","tags",[131,132,75,133,134],"score",50,"selected",false,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","Howie Li","body",{"_127":-5,"_61":128,"_129":-5,"_130":36},"outline",[82,83,84,85,86,87,88,89,90,91,92,93,94,95],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fMASIHP0LTCc","reportCount",1,"additionalSourceCount",0,{"_71":76,"_72":77},{"_71":74,"_72":75},{"_71":30,"_72":73},"slug","name","蓝队与运营","identity","身份与访问","cloud-native","云与原生",{"_79":80,"_13":81},"publicId","61b055d1-f6cb-486f-80b8-083e847a8fbb","Amazon Cognito用户池上线时间点恢复",{"_11":125,"_97":126,"_99":106},{"_11":123,"_97":124,"_99":106},{"_11":121,"_97":122,"_99":106},{"_11":119,"_97":120,"_99":100},{"_11":117,"_97":118,"_99":100},{"_11":115,"_97":116,"_99":100},{"_11":113,"_97":114,"_99":106},{"_11":111,"_97":112,"_99":106},{"_11":109,"_97":110,"_99":106},{"_11":107,"_97":108,"_99":106},{"_11":104,"_97":105,"_99":106},{"_11":103,"_97":45,"_99":100},{"_11":101,"_97":102,"_99":100},{"_11":96,"_97":98,"_99":100},"sec-14","text","Priyank Bhardwaj","level",3,"sec-13","Sergii Nozhka","sec-12","sec-11","Conclusion",2,"sec-10","Pricing","sec-9","Security considerations","sec-8","How PITR complements multi-Region replication","sec-7","Your application integration doesn’t change","sec-6","Step 3: Approve the recovery","sec-5","Step 2: Review the recovery preview","sec-4","Step 1: Start the recovery","sec-3","Recovering a user pool after an unintentional change","sec-2","Prerequisites","sec-1","How PITR works","zh","<p><span><a href=\"https://aws.amazon.com/cognito/\">Amazon Cognito</a></span> helps you implement secure sign-in and access control for users, microservices, and AI agents in minutes. Many of you rely on it for some of the most critical data you operate: the identities and attributes your applications use to authenticate and authorize every request. Recently, we <span><a href=\"https://aws.amazon.com/about-aws/whats-new/2026/11/cognito-point-in-time-recovery/\">launched point-in-time recovery (PITR)</a></span> for Amazon Cognito user pools, which lets you restore a user pool to an earlier point in time if an accidental deletion, a faulty migration, or an erroneous bulk operation changes data you need. It’s turned on automatically for user pools on the eligible feature plans.</p><p>Before this launch, protecting user pool data meant building your own solution, such as exporting user attributes and group data on a schedule. That approach was time-consuming to build and operate, versioning the exports to find a clean point in time was another challenge, and reconstructing a pool from them was complicated. Users also got new <code>sub</code> identifiers as part of the restore process, which might break any downstream reference to the originals. Passwords, multi-factor authentication (MFA) settings, and passkeys might not be recovered, so every affected user had to reset.</p><p>In this post, we show you how to recover a user pool after an erroneous bulk operation, using the preview to review changes before you approve them.</p><h2 id=\"sec-1\">How PITR works</h2><p>On eligible user pools (see Prerequisites), Amazon Cognito now tracks changes so you can recover the pool to any point within the recovery window. The length of that window depends on your user pool feature plan. The window accrues from the time the pool is on an eligible feature plan, and you can only recover to a point at which PITR coverage already existed.</p><p>One behavior to understand is what happens to passwords during a recovery. A recovery restores passwords for users it recreates. A user who still exists and changed their password after the target time keeps the same password. The recovery doesn’t revert password changes, so users who legitimately changed their credentials don’t lose them.</p><p>A recovery is preview-based and has three steps:<br> </p><ol> \n   <li><b>Initiate a recovery</b> to a target point in time (<code>InitiatePointInTimeRecovery</code>). Amazon Cognito pauses write operations to the user pool and generates a preview for your review before any changes are applied. Read operations and sign-in continue to work normally. The call returns a <code>RestoreId</code>.</li> \n   <li><b>Review the recovery preview</b> (<code>DescribePointInTimeRecovery</code>). Amazon Cognito reports how many users, groups, MFA settings, and passkeys the recovery would create, update, or delete to return the pool to its state at the target time.</li> \n   <li><b>Approve or cancel</b>. If the preview looks right, you approve the recovery with <code>StartPointInTimeRecovery</code>, and Amazon Cognito restores the pool to its state at the target time. If it doesn’t look right, you cancel it with <code>CancelPointInTimeRecovery</code>; no changes are applied, and write operations resume.</li> \n  </ol><h2 id=\"sec-2\">Prerequisites</h2><p>To follow along with this post, you need:<br> </p><ul> \n   <li>An AWS account with an Amazon Cognito user pool on the Essentials or Plus feature plan. The recovery window is up to 1 day on Essentials and up to 14 days on Plus. The examples use a pool named <code>anycompany-prod-user-pool</code> in the US East (N. Virginia) AWS Region (<code>us-east-1</code>).</li> \n   <li>The <span><a href=\"https://aws.amazon.com/cli/\">AWS Command Line Interface (AWS CLI)</a></span> configured with permissions for the Amazon Cognito user pools PITR operations.</li> \n  </ul><p>Before you run a recovery, keep these limits in mind:<br> </p><ul> \n   <li>You can run one recovery at a time per user pool, and one successful recovery per 24 hours per pool.</li> \n   <li>The target time must be at least 15 minutes in the past and no earlier than the pool’s creation time.</li> \n   <li>Recovery is initiated from the pool’s primary Region and can’t start while a <span><a href=\"https://docs.aws.amazon.com/cognito/latest/developerguide/user-pool-multi-region.html\">multi-Region replication (MRR)</a></span> operation, such as replica creation or deletion, is in progress on the pool.</li> \n  </ul><h2 id=\"sec-3\">Recovering a user pool after an unintentional change</h2><p>AnyCompany runs its user sign-in on an Amazon Cognito user pool, <code>anycompany-prod-user-pool</code>.</p><p>At 15:45 PDT, an operator runs a bulk change that’s supposed to set an attribute on a subset of users. A defect in the script instead deletes and modifies users. By 15:54 PDT, support receives cases of failed sign-ins and the operator halts the script. The team needs the pool as it was at 15:39 PDT. They decide to use PITR and preview the recovery before approving it.</p><h3 id=\"sec-4\">Step 1: Start the recovery</h3><p>The team initiates a recovery with a target time of 15:39 PDT by running the command in the preceding example. Figure 1 shows the same step in the console, where the team enters the target time and starts the recovery. The response includes a <code>RestoreId</code> that identifies this recovery throughout the workflow, along with a <code>RestoreStatus</code> and the <code>RestoreTimestamp</code> that you targeted.</p><pre class=\"language-text\"><code class=\"language-text\">aws cognito-idp initiate-point-in-time-recovery \\   \n--user-pool-id us-east-1_EXAMPLE \\   \n--restore-timestamp 2026-10-28T22:39:00Z</code></pre><p>\n       <img src=\"/dailyinfo/media/736fc20e7bf33dce.webp\" srcset=\"/dailyinfo/media/4949f4cf2d97da68.webp 720w, /dailyinfo/media/4b230cf8a8a8ead6.webp 1200w, /dailyinfo/media/736fc20e7bf33dce.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Figure 1: Initiating a recovery to a target point in time\" width=\"1000\" height=\"606\">\n       </p><p>Figure 1: Initiating a recovery to a target point in time</p><h3 id=\"sec-5\">Step 2: Review the recovery preview</h3><p><code>DescribePointInTimeRecovery</code> returns the <code>Restoration</code> for this <code>RestoreId</code>, including a <code>RestorePreview</code> that summarizes how many entities will be affected if the pool is returned to the target time. The team reviews the preview and confirms the number of affected users matches the scope.</p><pre class=\"language-text\"><code class=\"language-text\">aws cognito-idp describe-point-in-time-recovery \\   \n--user-pool-id us-east-1_EXAMPLE \\   \n--restore-id a69b8c1e-9866-441d-EXAMPLE11111</code></pre><p>In this case, the preview reports 16 users to create and 5 users to update, as the following sample response shows. Figure 2 shows the same preview in the console, with the create, update, and delete counts for users, groups, MFA settings, and passkeys. These numbers match the scope of the bulk operation, so the team continues. If the preview had shown unexpected changes, the team could cancel the recovery with no changes applied.</p><pre class=\"language-text\"><code class=\"language-text\"> {\n      \"Restoration\": {\n          \"RestoreId\": \"a7c41e92-0d3b-4f6a-EXAMPLE11111\",\n          \"RestorePreview\": [\n              {\n                  \"Entity\": \"Users\",\n                  \"CreateCount\": 16,\n                  \"DeleteCount\": 0,\n                  \"UpdateCount\": 5\n              },\n              {\n                  \"Entity\": \"Groups\",\n                  \"CreateCount\": 0,\n                  \"DeleteCount\": 0,\n                  \"UpdateCount\": 0\n              },\n              {\n                  \"Entity\": \"User MFAs\",\n                  \"CreateCount\": 0,\n                  \"DeleteCount\": 0,\n                  \"UpdateCount\": 0\n              },\n              {\n                  \"Entity\": \"Passkeys\",\n                  \"CreateCount\": 0,\n                  \"DeleteCount\": 0,\n                  \"UpdateCount\": 0\n              }\n          ],\n          \"RestoreStatus\": \"PREVIEW_GENERATED\",\n          \"RestoreTimestamp\": 1793227140,\n          \"TriggerTimestamp\": 1793228700\n      }\n  }</code></pre><p>\n       <img src=\"/dailyinfo/media/6cbbe2a345c31bdc.webp\" srcset=\"/dailyinfo/media/048f8aba2673fe0e.webp 720w, /dailyinfo/media/489e912b27394322.webp 1200w, /dailyinfo/media/6cbbe2a345c31bdc.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Figure 2: Reviewing the recovery preview before applying\" width=\"1000\" height=\"745\">\n       </p><p>Figure 2: Reviewing the recovery preview before applying</p><h3 id=\"sec-6\">Step 3: Approve the recovery</h3><p>If the preview is correct, the team approves the recovery with the command in the following example, and Amazon Cognito restores <code>anycompany-prod-user-pool</code> to its 15:39 PDT state. Figure 3 shows the approval step in the console, and Figure 4 shows the confirmation that appears after the recovery starts. Writes to the user pool resume automatically after the recovery completes or is canceled.</p><pre class=\"language-text\"><code class=\"language-text\">aws cognito-idp start-point-in-time-recovery \\    \n--user-pool-id us-east-1_EXAMPLE \\   \n--restore-id a7c41e92-0d3b-4f6a-EXAMPLE11111</code></pre><p>\n           <img src=\"/dailyinfo/media/a42c6781c0850088.webp\" srcset=\"/dailyinfo/media/7173258f7f743a20.webp 720w, /dailyinfo/media/a47745107ec14ec3.webp 1200w, /dailyinfo/media/a42c6781c0850088.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Figure 3: Approving the recovery\" width=\"1000\" height=\"509\">\n           </p><p>Figure 3: Approving the recovery</p><p>\n           <img src=\"/dailyinfo/media/a0ac56e6e345e0fa.webp\" srcset=\"/dailyinfo/media/a89b0e1a2aca9d51.webp 720w, /dailyinfo/media/12893ea59155de58.webp 1200w, /dailyinfo/media/a0ac56e6e345e0fa.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Figure 4: Recovery confirmation\" width=\"1000\" height=\"657\">\n           </p><p>Figure 4: Recovery confirmation</p><pre class=\"language-text\"><code class=\"language-text\">aws cognito-idp cancel-point-in-time-recovery \\    \n--user-pool-id us-east-1_EXAMPLE \\   \n--restore-id a7c41e92-0d3b-4f6a-EXAMPLE11111</code></pre><h2 id=\"sec-7\">Your application integration doesn’t change</h2><p>Because PITR rolls back the data in your existing user pool rather than creating a new one, your application integration doesn’t need any changes. A recovery restores user data and leaves your user pool configuration in place, so configuration changes you made after the recovery point are preserved. For example, a custom attribute you added to the schema, an <span><a href=\"https://aws.amazon.com/lambda\">AWS Lambda</a></span> trigger you updated, or a password policy you tightened stays as it is. The user pool ID also stays the same, and so do your app client IDs and secrets, managed login and domain, identity provider and SAML/OIDC configurations, and the provider Amazon Resource Names (ARNs) that services such as <span><a href=\"https://aws.amazon.com/api-gateway/\">Amazon API Gateway</a></span> and <span><a href=\"https://aws.amazon.com/elasticloadbalancing/application-load-balancer/\">Application Load Balancer</a></span> use to validate tokens. Recreated users keep the same <code>sub</code> identifiers, so downstream references to them keep working.</p><h2 id=\"sec-8\">How PITR complements multi-Region replication</h2><p><span><a href=\"https://aws.amazon.com/blogs/aws/improve-your-application-resilience-with-amazon-cognito-multi-region-replication/\">Multi-Region replication</a></span> and PITR address different failure modes. Multi-Region replication keeps a synchronized replica of your user pool in another Region, so if the primary Region is impaired, you can fail over traffic to a replica Region with minimal downtime. PITR helps with data problems, such as erroneous bulk operations that corrupt your user pool’s state. You roll back to any point within your recovery window without changing your application integration.</p><h2 id=\"sec-9\">Security considerations</h2><p>A recovery changes the identity data that every sign-in and authorization decision depends on, so treat recovery permissions like any other high-impact administrative access.<br> </p><ul> \n           <li><b>Separate who initiates a recovery from who approves it.</b> Because initiating and approving are separate API actions, you can assign them to different <span><a href=\"https://aws.amazon.com/iam\">AWS Identity and Access Management (IAM)</a></span> roles. Give an operator the permission <code>InitiatePointInTimeRecovery</code>, and give an approver the permission <code>StartPointInTimeRecovery</code>. Both permissions need <code>DescribePointInTimeRecovery</code> and <code>ListPointInTimeRecoveries</code> to review the preview, and <code>CancelPointInTimeRecovery</code> to stop a recovery. IAM keeps the two permissions on separate roles, but it doesn’t stop one person from assuming both. Assign the roles to different people or teams, and grant the approver role only for the duration of an approved change.</li> \n           <li><b>Treat initiating a recovery as sensitive.</b> Initiating a recovery pauses write operations on the user pool until the recovery is approved or canceled. If no action is taken within 24 hours, the preview automatically cancels and write operations are resumed. While writes are paused, users can’t sign up, reset their passwords, or update their profiles. A user pool also allows only one successful recovery per 24 hours, so an unauthorized recovery uses up a recovery you might need for a real incident.</li> \n           <li><b>Review restored users after a recovery.</b> A recovery recreates users who were deleted after the target time, including users you removed on purpose, such as employees who have left or compromised accounts. After a recovery completes, check the recreated users against your incident timeline. Disable any that should stay removed and revoke their sessions with <code>AdminUserGlobalSignOut</code>.</li> \n           <li><b>Monitor recovery activity.</b> Amazon Cognito records PITR API calls in <span><a href=\"https://aws.amazon.com/cloudtrail\">AWS CloudTrail</a></span>. Create an <span><a href=\"https://aws.amazon.com/eventbridge\">Amazon EventBridge</a></span> rule that notifies your security team whenever <code>InitiatePointInTimeRecovery</code> or <code>StartPointInTimeRecovery</code> is called, so that no recovery goes unnoticed.</li> \n          </ul><h2 id=\"sec-10\">Pricing</h2><p>PITR is included at no additional charge in eligible feature plans with a recovery window of up to 1 day on the Essentials feature plan and up to 14 days on the Plus feature plan.</p><h2 id=\"sec-11\">Conclusion</h2><p>In this post, we showed you how to recover an Amazon Cognito user pool after an erroneous bulk operation with PITR, from reviewing the changes in a preview to approving the recovery. PITR provides protection for your users’ identities, with no custom export-and-restore pipeline to build or operate. Because the recovery happens in place on the same user pool, your application integration keeps working unchanged. PITR is already enabled for eligible user pools. Before you need it, separate the initiate and approve permissions, add an alert on recovery calls, and practice the preview workflow on a test pool.</p><p>To get started:<br> </p><ul> \n           <li>Related post: <span><a href=\"https://aws.amazon.com/blogs/aws/improve-your-application-resilience-with-amazon-cognito-multi-region-replication/\">Improve your application resilience with Amazon Cognito multi-Region replication</a></span></li> \n           <li>Related post: <span><a href=\"https://aws.amazon.com/blogs/security/amazon-cognito-unlocks-advanced-capabilities-with-next-generation-infrastructure/\">Amazon Cognito unlocks advanced capabilities with next-generation infrastructure</a></span></li> \n           <li>See PITR in the <span><a href=\"https://console.aws.amazon.com/cognito/\">Amazon Cognito console</a></span>.</li> \n           <li>Learn more on the <span><a href=\"https://aws.amazon.com/cognito/\">Amazon Cognito page</a></span>.</li> \n           <li>Read the <span><a href=\"https://docs.aws.amazon.com/cognito/latest/developerguide/user-pool-point-in-time-recovery.html\">Amazon Cognito Developer Guide</a></span> for feature details.</li> \n          </ul><p>If you have questions about this post, contact <a href=\"https://aws.amazon.com/contact-us/\">AWS Support</a> or start a new thread on <a href=\"https://repost.aws/\">AWS re:Post</a>.</p><hr><p>\n           <img src=\"/dailyinfo/media/d9b6c966b62982b8.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"Howie Li\" width=\"120\" height=\"160\">\n          </p><h3 id=\"sec-12\">Howie Li</h3><p>Howie is a Product Manager at Amazon Web Services, where he strives to make auth easy by default. Outside of work, Howie enjoys exploring cultures and food through travels and making new ice cream flavors inspired by them.</p><p>\n           <img src=\"/dailyinfo/media/de37aa1dda7cd0dc.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Sergii Nozhka\" width=\"120\" height=\"160\">\n          </p><h3 id=\"sec-13\">Sergii Nozhka</h3><p>Sergii is a Senior Software Development Engineer at Amazon Web Services, where he works on Amazon Cognito, helping customers build secure and scalable identity experiences. Outside of work, Sergii enjoys cooking and traveling with family.</p><p>\n           <img src=\"/dailyinfo/media/abbe038b08648b1e.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Priyank Bhardwaj\" width=\"120\" height=\"160\">\n          </p><h3 id=\"sec-14\">Priyank Bhardwaj</h3><p>Priyank is a Software Development Manager at Amazon Web Services. He leads the User Pool Management team for Amazon Cognito, helping customers build secure and scalable identity experiences. Outside of work, Priyank enjoys running outdoors and working on DIY projects around the house.</p>","zhKind","complete","蓝队","加固","AWS","云原生","https://aws.amazon.com/blogs/security/protect-identity-data-with-point-in-time-recovery-in-amazon-cognito/","AWS Security Blog",{"_138":139,"_140":-5},"changelogVersion","2026-10-01T08:00","release"]
