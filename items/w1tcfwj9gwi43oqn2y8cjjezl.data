[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":-5,"_57":36,"_58":59},"expiresAt",1794444100000,"id","w1tcfwj9gwi43oqn2y8cjjezl","title","Chrome Extended Stable 156.0.8078.100 发布，修复 72 个安全漏洞","originalTitle","Extended Stable Update for Desktop","summary","Chrome Extended Stable 渠道面向 Windows 和 Mac 更新至 156.0.8078.100，将在未来数日或数周内逐步推送，版本包含 72 个安全修复。","reason","source",{"_64":84},"links",{"_59":83},"publishedAt","2026-11-11T20:02:29.991Z","discoveredAt","2026-11-11T21:19:12.693Z","timelineAt","category","vuln","tags",[80,81,67,82],"score",42,"selected",false,"channel","news","story","x","readingMode","full","author","Srinivas Sista","body",{"_76":-5,"_59":77,"_78":-5,"_79":36},"outline",[70],"relatedStories",[],"topics",[60,61,62],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_63":68,"_64":69},{"_63":66,"_64":67},{"_63":30,"_64":65},"slug","name","漏洞披露","browser","浏览器","google","Google / 谷歌",{"_11":71,"_72":73,"_74":75},"sec-1","text","Security Fixes","level",2,"zh","<p>&nbsp;<span>The Extended Stable channel has been updated to 156.0.8078.100</span><span>&nbsp;</span><span>for Windows and Mac </span><span>which will roll out over the coming days/weeks.</span></p><p><span><span><h2 id=\"sec-1\"><span>Security Fixes</span></h2><p><span>Note: Access to bug details and links may be kept restricted until a majority of users are updated with a fix. We will also retain restrictions if the bug exists in a third party library that other projects similarly depend on, but haven’t yet fixed.</span></p><br><p><span>This update includes </span><a href=\"https://issues.chromium.org/issues?q=customfield1223088:5-M156-EXT\"><span>72</span></a><span> security fixes</span><span>. Please see the </span><a href=\"https://www.chromium.org/Home/chromium-security\"><span>Chrome Security Page</span></a><span> for more information.</span></p></span></span></p><p><span>[</span><a href=\"https://issues.chromium.org/issues/576736463\"><span>576736463</span></a><span>] Critical CVE-2026-126879<br></span><span>[</span><a href=\"https://issues.chromium.org/issues/568699166\"><span>568699166</span></a><span>] Critical CVE-2026-126885<br></span><span><span>[</span><a href=\"https://issues.chromium.org/issues/575524700\"><span>575524700</span></a><span>] Critical CVE-2026-126895<br></span></span><span><span>[</span><a href=\"https://issues.chromium.org/issues/580921803\"><span>580921803</span></a><span>] Critical CVE-2026-126911</span></span></p><p><span><p><span><span>[</span><a href=\"https://issues.chromium.org/issues/578664961\"><span>578664961</span></a><span>] High CVE-2026-126840</span></span></p></span><span><p><span><span>[</span><a href=\"https://issues.chromium.org/issues/580865537\"><span>580865537</span></a><span>] High CVE-2026-126841</span></span></p></span><span><p><span><span>[</span><a href=\"https://issues.chromium.org/issues/574209539\"><span>574209539</span></a><span>] High CVE-2026-126842</span></span></p></span><span><p><span><span>[</span><a href=\"https://issues.chromium.org/issues/578322433\"><span>578322433</span></a><span>] High CVE-2026-126843</span></span></p></span><span><p><span><span>[</span><a href=\"https://issues.chromium.org/issues/576944655\"><span>576944655</span></a><span>] High CVE-2026-126844</span></span></p></span><span><p><span><span>[</span><a href=\"https://issues.chromium.org/issues/572988453\"><span>572988453</span></a><span>] High CVE-2026-126847</span></span></p></span><span><p><span><span>[</span><a href=\"https://issues.chromium.org/issues/578685477\"><span>578685477</span></a><span>] High CVE-2026-126848</span></span></p></span><span><p><span><span>[</span><a href=\"https://issues.chromium.org/issues/57