[{"_1":2,"_3":4},"root",{"_5":94},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1794185109000,"id","zn3wl1ipk6y4uimbmwjbo86fy","title","Microsoft Windows Update Stack 本地权限提升漏洞 CVE-2026-81963 已复现并发现在野利用","originalTitle","【已复现】Windows Update Stack 本地权限提升漏洞(CVE-2026-81963)安全风险通告","summary","Microsoft Windows Update Stack 本地权限提升漏洞 CVE-2026-81963 已发现真实利用，奇安信 CERT 已成功复现；攻击者需取得目标主机低权限账户，可借更新栈未正确校验重解析点将权限提升至 SYSTEM。","reason","原文给出漏洞成因、低权限利用前提、受影响版本和在野利用证据，并附复现及处置建议，便于判断暴露范围与修复优先级。","source",{"_73":93},"links",{"_83":92},"publishedAt","2026-11-02T08:51:00.000Z","discoveredAt","2026-11-02T12:49:32.189Z","timelineAt","category","vuln","tags",[86,74,87,88,89,90,91],"score",86,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","body",{"_61":82,"_83":-5,"_84":83,"_85":37},"outline",[],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fz-RW5_XrdCA","reportCount",2,"additionalSourceCount",1,{"_71":76,"_73":77},{"_71":31,"_73":75},{"_71":72,"_73":74},"slug","exploited","name","在野利用","漏洞披露","microsoft","Microsoft / 微软",{"_79":80,"_13":81},"publicId","c180dd55-5a6c-4725-b7e5-fb43563e20f3","Windows更新栈提权漏洞已遭在野利用","<p><span>奇安信 CERT</span> <span>2026-11-02 16:51</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/1b1551c860f9de85.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>致力于第一时间为企业级用户提供权威漏洞情报和有效解决方案。</p><p><span><span>●&nbsp;</span></span><span><span>点击↑蓝字关注我们，获取更多安全风险通告</span></span></p><hr><table><tbody><tr><td colspan=\"4\" align=\"center\"><p><span><strong><span><span>漏洞概述</span></span></strong></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>漏洞名称</span></span></strong></span></p></td><td colspan=\"3\" align=\"left\"><p><span><span>Windows Update Stack 本地权限提升漏洞</span></span></p></td></tr><tr><td align=\"left\"><p><span><span><strong><span>漏洞编号</span></strong></span></span></p></td><td colspan=\"3\" align=\"left\"><p><span><span>QVD-2026-63447</span><span>，</span><span>CVE-2026-81963</span></span></p></td></tr><tr><td align=\"left\"><p><strong><span><strong><span><span>公开时间</span></span></strong></span></strong></p></td><td align=\"left\"><p><span><span>2026-09-08</span></span></p></td><td align=\"left\"><p><strong><span><strong><span><span>影响量级</span></span></strong></span></strong></p></td><td align=\"left\"><p><span><span>千万级</span></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>奇安信评级</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>高危</span></span></strong></span></p></td><td align=\"left\"><p><strong><span><span>CVSS 3.1分数</span></span></strong></p></td><td align=\"left\"><p><span><span><strong><span>7.8</span></strong></span></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span>威胁类型</span></strong></span></p></td><td align=\"left\"><p><span><span><span>权限提升</span></span></span></p></td><td align=\"left\"><p><strong><span><span>利用可能性</span></span></strong></p></td><td align=\"left\"><p><strong><span><strong><span><span>高</span></span></strong></span></strong></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>POC状态</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span><span>已公开</span></span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>在野利用状态</span></span></strong></span></p></td><td align=\"left\"><p><span><span><span>已发现</span></span></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>EXP状态</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span><span>已公开</span></span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>技术细节状态</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span><span>已公开</span></span></span></strong></span></p></td></tr><tr><td colspan=\"4\" align=\"left\"><p><strong><span><span>危害描述：</span></span></strong><span><span>攻击者利用该漏洞可将本地低权限账户的权限提升至 SYSTEM，从而完全控制目标主机。</span></span></p></td></tr></tbody></table><p><strong><span>0</span></strong><strong><span>1</span></strong></p><p><strong><span>漏洞详情</span></strong></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>影响组件</span></span></strong></p><p><span>Windows Update Stack（Windows 更新栈）是 Windows 操作系统负责更新下载、暂存、编排与安装的核心组件集合，主要包括 Windows Update Orchestrator 服务（UsoSvc）、Windows Update Medic 服务（WaaSMedicSvc）、更新会话编排器（Update Session Orchestrator，USO）以及 MoUsoCoreWorker.exe、usoclient.exe 等工作进程。</span></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>漏洞描述</span></span></strong></p><p><span>近日，奇安信CERT监测到<span>Windows Update Stack 本地权限提升漏洞(CVE-2026-81963)</span>在野利用，该漏洞源于 Windows 更新栈在处理文件路径时未正确解析重解析点，即在访问文件前未对链接目标做充分校验，导致以 SYSTEM 权限运行的更新组件可能被诱导对攻击者指定的文件执行特权操作。本地低权限攻击者利用该漏洞可将权限提升至 SYSTEM。<span>目前该漏洞PoC和技术细节已公开。</span></span><span><span>鉴于该漏洞已发现在野利用，建议客户尽快做好自查及防护。</span></span></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>利用条件</span></span></strong></p><p><span>攻击者需在目标主机上获得低权限。</span></p><p><strong><span>02</span></strong></p><p><strong><span>影响范围</span></strong></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>影响版本</span></span></strong></p><p><span>Windows 11 23H2（x64 / ARM64）&lt; 10.0.22631.7582</span></p><p><span>Windows 11 24H2（x64 / ARM64）&lt; 10.0.26100.9445</span></p><p><span>Windows 11 25H2（x64 / ARM64）&lt; 10.0.26200.9445</span></p><p><span>Windows 11 26H1（x64 / ARM64）&lt; 10.0.28000.2954</span></p><p><span>Windows Server 2025（含 Server Core 安装）&lt; 10.0.26100.33438</span></p><p><strong><span>03</span></strong></p><p><strong><span>复现情况</span></strong></p><p><span><span>目前，奇安信威胁情报中心安全研究员已成功复现</span><span><span>Windows Update Stack 本地权限提升漏洞(CVE-2026-81963)</span></span><span>，</span><span>截图如下：</span></span></p><p><img src=\"/dailyinfo/media/bfc05de2f8877aa6.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>04</span></strong></p><p><strong><span>处置建议</span></strong></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>安全更新</span></span></strong></p><p><strong><span><span>使用奇安信天擎的客户可以通过奇安信天擎控制台一键更新修补相关漏洞，也可以通过奇安信天擎客户端一键更新修补相关漏洞。</span></span></strong></p><p><span><span>也可以采用以下官方解决方案及缓解方案来防护此漏洞：</span></span></p><p><strong><span><span>Windows自动更新</span></span></strong></p><p><span><span>Windows系统默认启用 Microsoft Update，当检测到可用更新时，将会自动下载更新并在下一次启动时安装。还可通过以下步骤快速安装更新：</span></span></p><p><span><span>1、点击“开始菜单”或按Windows快捷键，点击进入“设置”</span></span></p><p><span><span>2、选择“更新和安全”，进入“Windows更新”（Windows Server 2012以及Windows Server 2012 R2可通过控制面板进入“Windows更新”，步骤为“控制面板”-&gt; “系统和安全”-&gt;“Windows更新”）</span></span></p><p><span><span>3、选择“检查更新”，等待系统将自动检查并下载可用更新</span></span></p><p><span><span>4、重启计算机，安装更新</span></span></p><p><span><span>系统重新启动后，可通过进入“Windows更新”-&gt;“查看更新历史记录”查看是否成功安装了更新。对于没有成功安装的更新，可以点击该更新名称进入微软官方更新描述链接，点击最新的SSU名称并在新链接中点击“Microsoft 更新目录”，然后在新链接中选择适用于目标系统的补丁进行下载并安装。</span></span></p><p><strong><span><span>手动安装补丁</span></span></strong></p><p><span><span>另外，对于不能自动更新的系统版本，可参考以下链接下载适用于该系统的补丁并安装：</span></span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-96951\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-96951</a></span></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>产品解决方案</span></span></strong></p><p><strong><span><span>奇安信天擎终端安全管理系统解决方案</span></span></strong></p><p><span><span>奇安信天擎终端安全管理系统并且有漏洞修复相关模块的用户，可以将补丁库版本更新到：</span><span><span>2026.9.9.1000</span></span><span>及以上版本，对内网终端进行补丁更新。</span></span></p><p><span><span>推荐采用自动化运维方案，如果控制中心可以连接互联网的用户场景，建议设置为自动从奇安信云端更新补丁库至</span><span><span>2026.9.9.1000</span></span><span>版本。</span></span></p><p><span><span>控制中心补丁库更新方式：每天04:00-06:00自动升级，升级源为从互联网升级。</span></span></p><p><span><span>纯隔离网内控制中心不能访问互联网，不能下载补丁库和补丁文件，需使用离线升级工具定期导入补丁库和文件到控制中心。</span></span></p><p><strong><span>05</span></strong></p><p><strong><span>参考资料</span></strong></p><p><span><span>[1]</span><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-81963\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-81963</a></span></span></p><p><span><span>[2]</span><span><a href=\"https://www.malwarebytes.com/blog/news/2026/09/microsoft-fixes-record-964-flaws-including-2-exploited-zero-days\">https://www.malwarebytes.com/blog/news/2026/09/microsoft-fixes-record-964-flaws-including-2-exploited-zero-days</a></span></span></p><p><strong><span>06</span></strong></p><p><strong><span>时间线</span></strong></p><p><span><span>2026年11月02日，奇安信 CERT发布安全风险通告。</span></span></p><p><strong><span>07</span></strong></p><p><strong><span>漏洞情报服务</span></strong></p><p><span><span>「</span><span>奇安信漏洞情报平台</span><span>」</span><span>重磅上线，诚邀您来体验：</span></span></p><p><img alt=\"图片\" src=\"/dailyinfo/media/e05445c9ea51d1d7.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img alt=\"图片\" src=\"/dailyinfo/media/90f0a57d70cc9376.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img alt=\"图片\" title=\"CERT LOGO.png\" width=\"100%\" src=\"/dailyinfo/media/f404b6132e3ed76b.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><strong><span>奇安信 CERT</span></strong></span></p><p><span><strong><span><span>致力于</span></span></strong><span><span>第一时间为企业级用户提供</span><strong><span><span>权威</span></span></strong><span>漏洞情报和</span></span><strong><span><span>有效</span></span></strong><span><span>解决方案。</span></span></span></p><p><span><span><span>点击↓</span><strong><span><span>阅读原文</span></span></strong><span>，到</span></span><strong><span><span>ALPHA威胁分析平台</span></span></strong><span><span>订阅更多漏洞信息。</span></span></span></p><p><a href=\"https://ti.qianxin.com/portal/subscription\">阅读原文</a></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=cf1f6040&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzU5NDgxODU1MQ%3D%3D%26mid%3D2247507987%26idx%3D1%26sn%3D0725706555a43c3a36e4f766b32e7427\">跳转微信打开</a></p>","original","zhKind","complete","漏洞","复现","漏洞利用","补丁","Microsoft","奇安信","https://mp.weixin.qq.com/s?__biz=MzU5NDgxODU1MQ==&mid=2247507987&idx=1&sn=0725706555a43c3a36e4f766b32e7427","奇安信 CERT",{"_95":96,"_97":-5},"changelogVersion","2026-10-01T08:00","release"]
