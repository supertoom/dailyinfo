[{"_1":2,"_3":4},"root",{"_5":109},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1793666561000,"id","g91jpin898ib1bej3gd5gopsn","title","Linux 内核 CVE-2026-98432 波及自托管 JFrog 运行环境","originalTitle","Your Artifactory is fine. Your Linux kernel hosting it might not be.","summary","Linux 内核 CVE-2026-98432 是一处影响新建 IPv4 TCP 连接的 use-after-free 缺陷，自 4.4 起存在，Linux 内核团队评分 9.8。","reason","文章区分了 JFrog 产品与承载环境的风险，并给出按发行版核查内核修复状态和分批更新的操作路径。","source",{"_73":108},"links",{"_95":107},"publishedAt","2026-11-02T18:35:06.000Z","discoveredAt","2026-11-02T18:47:35.698Z","timelineAt","category","vuln","tags",[99,74,100,101,102,103,104,105,106],"score",77,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","drewt@jfrog.com","body",{"_61":94,"_95":-5,"_96":97,"_98":37},"outline",[82,83,84],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","frfGSJHe8IYA","reportCount",1,"additionalSourceCount",0,{"_71":76,"_73":77},{"_71":31,"_73":75},{"_71":72,"_73":74},"slug","exploited","name","在野利用","漏洞披露","kernel","内核与系统",{"_79":80,"_13":81},"publicId","931527cd-d2c1-46c8-98e1-79c4b2388dfe","Linux内核TCP竞态漏洞已修复，RCE需MPTCP",{"_11":92,"_86":93,"_88":89},{"_11":90,"_86":91,"_88":89},{"_11":85,"_86":87,"_88":89},"sec-3","text","窗口期很大，但正在缩小","level",2,"sec-2","作为 JFrog 客户……","sec-1","发生了什么","<p><img src=\"/dailyinfo/media/a0f5deb54b971be3.webp\" srcset=\"/dailyinfo/media/c571b2c8577e63fc.webp 720w, /dailyinfo/media/78f0ee8f7c6b870b.webp 1200w, /dailyinfo/media/a0f5deb54b971be3.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Linux CVE - inner-image-863x300\" width=\"863\" height=\"300\"></p><p><b>摘要<br>\n</b><span>正如我们所写，AI 正在将“修复公开”和“有人拥有可用漏洞利用代码”之间的时间缩短至接近零。</span><b>JFrog 产品不受 Linux kernel CVE-2026-98432 影响。</b><span>Artifactory、Xray 以及 JFrog Platform 的其他组件均不包含此缺陷，因为它存在于 Linux kernel 本身。</span><b>我们建议所有自行托管的 JFrog 客户立即检查其 Linux 主机并更新内核，以保护其环境；这些环境可能包括 JFrog 产品的托管版本。操作系统更新后，JFrog 产品便不存在风险。</b></p><p>我们的目标始终是保护您的系统，而在某些情况下，这可能包括就保护 JFrog 产品运行所在环境提供建议。JFrog Cloud 客户不受此 Linux 漏洞影响，但如果您自行托管 JFrog，请继续阅读。</p><p>您的 Linux kernel 可能面临风险，需要进行修补以保护您的环境。</p><h2 id=\"sec-1\">发生了什么</h2><p>10 月 15 日，Linux kernel CVE 团队发布了 CVE-2026-98432。这是在设置新的 IPv4 TCP 连接的代码中出现的一处释放后重用漏洞，由竞态条件引起。该漏洞可追溯至 Linux 4.4。上游在 9 月 17 日对主线进行修补后，于 10 月 5 日修复了该问题；早在 CVE 公开整整十天前，上游就已完成修复。</p><p>kernel 团队将该漏洞评为 9.8 分。Red Hat、Oracle、SUSE 和 Amazon 给出的评分较低，介于 5.9 至 8.1 之间。</p><p>随后，Anthropic 于 10 月 27 日发布研究，称其 Claude 模型编写出了可用的漏洞利用代码。远程攻击者无需任何凭据，即可在启用了多路径 TCP（MPTCP）监听器的服务器上获得 root shell。在 Anthropic 的测试中，泄露 kernel 地址耗时 48 分钟，而实现命令执行仅又用了五分钟。在这种场景下，竞态失败只会终止那一个连接，因此攻击者只需再次尝试。</p><p>重要的是，Anthropic 并未公开漏洞利用代码。<strong>截至 11 月 2 日，尚无在野攻击的报告。</strong>MPTCP 并不像听起来那么特殊：自 Go 1.24 起，Go 程序默认会在其监听的 socket 上请求使用它。Go Security Team 还表示，底层漏洞并非 MPTCP 特有。（提示：JFrog 部署包含多个版本晚于 1.24 的 Go 服务。）</p><h2 id=\"sec-2\">作为 JFrog 客户……</h2><p>在自行托管的部署中，运行 JFrog 产品的操作系统由您负责。我们负责我们产品的安全，而您则负责底层平台的安全（主机、内核、补丁），这遵循的是共同责任模型。即使 JFrog 安装状态良好，脆弱的内核仍会使该主机及其上的一切面临风险。</p><p>截至 10 月 30 日，Ubuntu 和 RHEL 均尚未发布修复后的内核。Ubuntu 22.04 至 26.10 被标记为正在处理中，而更早的版本则明确存在漏洞。RHEL 8、9 和 10 被列为受影响，但尚未公布修复日期。Debian、Oracle Linux、SUSE 和 Amazon Linux 已为至少部分内核发布了修复。请检查您所使用的准确版本，因为各发行版内的修复覆盖范围有所不同。</p><p><strong>我们建议您尽快采取以下措施</strong></p><ol>\n<li>&nbsp; &nbsp; <strong>了解您正在运行的版本。</strong>版本号可能具有误导性，因为各发行版会在不提升版本号的情况下反向移植修复。请改为查看变更日志。</li>\n</ol><p><em>在 Debian 或 Ubuntu 上：</em></p><pre> apt changelog linux-image-$(uname -r) | grep CVE-2026-98432</pre><p><em>在 RHEL 及其衍生版上：</em></p><pre> rpm -q --changelog kernel-$(uname -r) | grep CVE-2026-98432</pre><p>如果该命令没有输出，您正在运行的内核<strong>尚未</strong>包含此修复。</p><ol>\n<li>&nbsp; &nbsp; <strong>有修复程序可用时先打补丁，然后重启。</strong> 在机器启动进入新内核之前，内核更新不会生效。如果你自己构建内核，修复已包含在 5.10.272、5.15.223、6.1.190、6.6.159、6.12.113、6.18.56、7.2.10 和 7.3 中。内核团队建议升级到最新的稳定版本，而不是单独挑选该提交。</li>\n<li>&nbsp; &nbsp; <strong>尚无修复程序时，要主动采取防护措施。</strong> Red Hat 表示，目前没有可用的缓解措施能达到其要求。逐个程序关闭 MPTCP 十分脆弱，Go 团队也直接指出这一点：只要遗漏一个监听器，你就会再次暴露。在网络层限制哪些主体可以访问这些主机，留意供应商针对 CVE-2026-98432 的公告，并在软件包可用当天打补丁。另一种缓解方案是使用具备 TCP 终止功能的 L7 负载均衡器或反向代理，以减少易受攻击主机的直接暴露面。降低暴露面无法修复该漏洞，但确实能减少能够尝试利用它的人员数量。</li>\n<li>&nbsp; &nbsp; <strong>让下一次更加简单。</strong> 如果你通过 Artifactory 代理 Debian 或 RPM 软件仓库，修复后的内核会进入你的主机已经拉取更新的仓库。按你处理其他所有更新时使用的相同流程，先暂存、推广，然后分批推送。内核软件包与其他任何制品一样，也应该纳入记录管理系统。</li>\n</ol><p><a href=\"https://jfrog.com/xray/\">JFrog Xray</a> 会扫描你的供应链制品和镜像。它无法告诉你主机正在运行哪个内核，因为内核既不在制品中也不在镜像中；第一步必须由你亲自运行命令完成。</p><h2 id=\"sec-3\">窗口期很大，但正在缩小</h2><p>从修复到利用之间的时间窗口正趋近于零，因此必须快速打补丁。该漏洞的修复于 10 月 5 日公开。一个可行的利用方案于 10 月 27 日出现。10 月 30 日，两款使用最广泛的企业发行版仍未发布更新。</p><p><strong>我们保护系统的建议很简单：</strong></p><p><strong>对今天运行 JFrog 的每台主机执行变更日志检查。如果有修复后的内核可用，则更新并重启。如果尚无修复，则限制访问，并订阅你所在发行版针对 CVE-2026-98432 的公告，以免修复被搁置在可能被遗忘的队列中。</strong></p><p><em>注：本博客内容仅供一般信息和说明用途。它反映的是截至下方所示发布日期可获得的信息，可能不会更新。示例和结果仅作说明；实际结果可能因你的环境和用例而异。JFrog 不对内容的完整性、准确性、时效性或是否适合你的特定情况作出任何陈述或保证。在依赖这些内容之前，你有责任对其进行评估。本博客内容不会修改任何管辖你使用 JFrog 产品或服务的协议。产品使用仍须遵守适用的 JFrog 订阅协议或你与 JFrog 之间的其他书面协议。</em></p>","original","zhKind","translation","complete","漏洞","复现","补丁","内核","Ubuntu","Red Hat","Oracle","AWS","https://jfrog.com/blog/jfrog-artifactory-is-fine-your-linux-kernel-might-not-be/","JFrog Security Research",{"_110":111,"_112":-5},"changelogVersion","2026-10-01T08:00","release"]
