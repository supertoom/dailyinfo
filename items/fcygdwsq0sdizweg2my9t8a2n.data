[{"_1":2,"_3":4},"root",{"_5":241},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794962438000,"id","fcygdwsq0sdizweg2my9t8a2n","title","TGR-STA-0049以HTTP/3 RAT攻击东南亚政府机构并窃取敏感数据","originalTitle","QUIC and Covert: Novel HTTP/3-Powered RATs Target Southeast Asian Governments","summary","Unit 42 发现 TGR-STA-0049 至少自 2025 年 7 月起针对东南亚政府机构的网络间谍活动，攻击者利用未修补的 Microsoft Exchange 服务器和 Web 服务器部署 Web Shell，并通过伪装成政府文件的 PDF 投递 PerfectPioneer RAT。","reason","原文还原了攻击链、两类RAT的模块化架构与QUIC通信特征，并提供凭据窃取、邮件越权和横向移动细节，可用于比对检测与狩猎思路。","source",{"_74":240},"links",{"_227":239},"publishedAt","2026-11-16T23:00:55.000Z","discoveredAt","2026-11-17T00:04:15.077Z","timelineAt","category","activity","tags",[77,75,232,233,234,235,236,237,238],"score",76,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Tom Fakterman","body",{"_61":226,"_227":-5,"_228":229,"_230":231},"outline",[86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fX3sdLpsjiUg","reportCount",1,"additionalSourceCount",0,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","malware","name","恶意软件","attack","攻击活动","red-team","红队与渗透","email","邮件与钓鱼",{"_83":84,"_13":85},"publicId","a1b599c8-fca7-4ef4-89c0-a527391ee38b","QUIC隐蔽RAT攻击东南亚政府机构",{"_11":224,"_132":225,"_134":143},{"_11":222,"_132":223,"_134":143},{"_11":220,"_132":221,"_134":143},{"_11":218,"_132":219,"_134":138},{"_11":216,"_132":217,"_134":138},{"_11":214,"_132":215,"_134":143},{"_11":212,"_132":213,"_134":138},{"_11":210,"_132":211,"_134":138},{"_11":208,"_132":209,"_134":138},{"_11":206,"_132":207,"_134":135},{"_11":204,"_132":205,"_134":135},{"_11":202,"_132":203,"_134":138},{"_11":200,"_132":201,"_134":143},{"_11":198,"_132":199,"_134":138},{"_11":196,"_132":197,"_134":138},{"_11":194,"_132":195,"_134":138},{"_11":192,"_132":193,"_134":138},{"_11":190,"_132":191,"_134":138},{"_11":188,"_132":189,"_134":138},{"_11":186,"_132":187,"_134":143},{"_11":184,"_132":185,"_134":138},{"_11":182,"_132":183,"_134":138},{"_11":180,"_132":181,"_134":135},{"_11":178,"_132":179,"_134":135},{"_11":176,"_132":177,"_134":138},{"_11":174,"_132":175,"_134":143},{"_11":172,"_132":173,"_134":138},{"_11":170,"_132":171,"_134":143},{"_11":168,"_132":169,"_134":138},{"_11":166,"_132":167,"_134":138},{"_11":164,"_132":165,"_134":143},{"_11":162,"_132":163,"_134":143},{"_11":160,"_132":161,"_134":138},{"_11":158,"_132":159,"_134":135},{"_11":156,"_132":157,"_134":135},{"_11":154,"_132":155,"_134":135},{"_11":152,"_132":153,"_134":135},{"_11":150,"_132":151,"_134":135},{"_11":148,"_132":149,"_134":135},{"_11":146,"_132":147,"_134":138},{"_11":144,"_132":145,"_134":138},{"_11":141,"_132":142,"_134":143},{"_11":139,"_132":140,"_134":138},{"_11":136,"_132":137,"_134":138},{"_11":131,"_132":133,"_134":135},"sec-45","text","Obfuscating Commands as Hashes","level",4,"sec-44","Command Frame Architecture",3,"sec-43","Heartbeat JSON Structure","sec-42","Appendix B: Analysis of Additional KUKURAT Features",2,"sec-41","PerfectPioneer RAT Persistence","sec-40","Commands Blocked by isDangerousCommand","sec-39","rat_http3_cc 变体","sec-38","Pioneer 变体","sec-37","rat_http3_ls 变体","sec-36","PerfectRat 变体","sec-35","RatAAkk-tt 变体","sec-34","newhttp3 变体","sec-33","变体对比","sec-32","附录 A：PerfectPioneer RAT 其他功能分析","sec-31","其他资源","sec-30","PerfectPioneer RAT C2 域名","sec-29","SHA256 哈希","sec-28","失陷指标","sec-27","Palo Alto Networks 防护与缓解","sec-26","结论","sec-25","数据外泄","sec-24","Directory Service Replication","sec-23","LSASS 内存转储","sec-22","凭据窃取技术","sec-21","通过域登录脚本进行横向移动","sec-20","后利用与网络传播","sec-19","变体比较","sec-18","看门狗组件","sec-17","伪造终端活动：启发式伪装引擎","sec-16","部署独立的 KUKURAT 模块","sec-15","能力与支持的命令","sec-14","注册与心跳","sec-13","KUKURAT：深入剖析最新模块化后门","sec-12","PerfectPioneer RAT 变体对比","sec-11","自愈连接架构","sec-10","架构与通信","sec-9","命令与功能","sec-8","newhttp3 变种","sec-7","加载器与执行","sec-6","PerfectPioneer RAT 深入分析","sec-5","HTTP/3 的采用","sec-4","感染向量","sec-3","行动概览与基础设施","sec-2","TGR-STA-0049 的背景","sec-1","执行摘要","<h2 id=\"sec-1\">执行摘要</h2><p>Unit 42 发现了一场多阶段网络间谍活动，自至少 2025 年 7 月以来一直针对东南亚政府实体。我们将该活动追踪为 <a href=\"https://unit42.paloaltonetworks.com/advanced-backdoor-squidoor/\">TGR-STA-0049</a>（同时追踪为 REF7707、Earth Alux、Ink Dragon）。该活动背后威胁行为者的标志性特征是针对政府实体，并结合使用先进的自定义有效载荷，这些有效载荷专为高隐蔽性的情报收集行动而设计，重点在于规避安全检测工具。</p><p>我们调查的这场活动表现出高度的作战隐蔽性和新颖的工具集。</p><p>此前与该组织相关的活动包括投放 Squidoor（又名 <a href=\"https://malpedia.caad.fkie.fraunhofer.de/details/win.finaldraft\">FINALDRAFT</a>）——一个自 2023 年以来用于针对全球高价值目标的高级后门。</p><p>近期，与该组织相关的活动已扩展其攻击手法。我们观察到的相关活动包括投放两个此前未有文档记录的自定义远程访问木马（RAT）：<strong>PerfectPioneer RAT</strong>（发现于 2025 年 7 月）及其模块化后继 <strong>KUKURAT</strong>（于 2026 年 3 月投放）。</p><p>在九个月的时间里，我们观察到该活动背后的攻击者持续改进其能力，以满足不断演变的作战需求。本次活动的攻击手法具备三项特别先进的能力：</p><ul>\n<li><strong>隐蔽的 HTTP/3（QUIC）C2 通信：</strong>较早采用基于 UDP 的 HTTP/3，提供了一个高度高效的命令与控制通道，可能绕过传统针对 TCP 优化的深度包检测。</li>\n<li><strong>作战安全开关：</strong>PerfectPioneer RAT 内置了一个校验引擎，可主动阻止远程操作者执行可能触发环境安全告警的喧闹或破坏性命令。</li>\n<li><strong>多向量启发式伪装：</strong>KUKURAT 采用自定义的欺骗引擎，生成合成的、看起来无害的网络、注册表与文件活动。通过操纵端点的行为基线，它可以在大量人工噪声中成功掩盖失陷指标。</li>\n</ul><p>我们对这些独特恶意软件家族、该组织不断演进的技术、战术与程序（TTP）以及本次活动中高度针对性的数据外泄行为提供了全面的技术拆解。</p><p>Cortex <a href=\"https://docs-cortex.paloaltonetworks.com/r/Cortex-AgentiX/Cortex-AgentiX-Documentation/Get-Started-with-Cortex-AgentiX\">AgentiX</a> 智能体助手简化了我们的调查工作。</p><p>Palo Alto Networks 的客户可通过以下产品和服务获得针对本文所述威胁的更好防护：</p><ul>\n<li><a href=\"https://docs.paloaltonetworks.com/wildfire\">Advanced WildFire</a></li>\n<li><a href=\"https://docs.paloaltonetworks.com/advanced-url-filtering\">Advanced URL Filtering</a>、<a href=\"https://docs.paloaltonetworks.com/dns-security\">Advanced DNS Security</a> 和 <a href=\"https://www.paloaltonetworks.com/network-security/advanced-ip-defense\">Advanced IP Defense</a></li>\n<li><a href=\"https://docs-cortex.paloaltonetworks.com/p/XDR\">Cortex XDR</a> 和 <a href=\"https://docs-cortex.paloaltonetworks.com/p/XSIAM\">XSIAM</a></li>\n<li><a href=\"https://docs.cyberark.com/epm/latest/en/content/intro/introduction.htm\">Idira Endpoint Privilege Manager (EPM)</a></li>\n<li><a href=\"https://docs.cyberark.com/secrets-manager-saas/latest/en/content/conjurcloud/cl_conjurcloudoverview.htm?tocpath=Get%20started%7C_____1\">Idira Privileged Access Management (PAM)</a></li>\n<li><a href=\"https://docs.cyberark.com/pam-self-hosted/latest/en/content/pasimp/integrate-with-sia.htm\">Idira Secure Infrastructure Access (SIA)</a></li>\n</ul><p>组织可通过 <a href=\"https://www.paloaltonetworks.com/unit42/threat-intelligence\">Unit 42 Threat Intel Services</a> 及其 <a href=\"https://www.paloaltonetworks.com/resources/datasheets/unit-42-deep-and-dark-web-service\">Deep and Dark Web Service</a> 获取定制的对手情报、直接的分析师咨询以及专业的暴露面追踪。</p><p>如果您认为自己可能已遭入侵，或有紧急事项，请联系 <a href=\"https://start.paloaltonetworks.com/contact-unit42.html\">Unit 42 Incident Response 团队</a>。</p><h2 id=\"sec-2\">TGR-STA-0049 的背景</h2><p>TGR-STA-0049 至少自 2023 年 3 月以来一直处于活跃状态。它主要针对高价值行业，包括东南亚、南美洲和欧洲各地的政府组织。针对战略实体开展数据收集和窃取，并结合先进的隐蔽 techniques 与长期持久化，是网络间谍活动的典型特征。</p><p>在此前的行动中，该组织部署了 <a href=\"https://unit42.paloaltonetworks.com/advanced-backdoor-squidoor/\">Squidoor</a>，这是一款针对 Windows 和 Linux 系统的后门。随着该组织扩大其行动范围，它继续将<a href=\"https://research.checkpoint.com/2025/ink-dragons-relay-network-and-offensive-operation/\">新工具和恶意软件变种</a>整合到其工具集中。在其最近一次始于 2025 年年中的行动中，攻击者引入了两个此前未公开的先进恶意软件家族，专为隐蔽、数据收集和数据窃取而设计：PerfectPioneer RAT 和 KUKURAT。随着此次行动推进至 2026 年初，该威胁行为者开始将其基础设施从 PerfectPioneer 迁移至新的 KUKURAT，后者自 2026 年 3 月以来已在野被发现。</p><p>我们发现了该组织所跟踪的六个不同 PerfectPioneer RAT 变种：</p><ul>\n<li>newhttp3</li>\n<li>PerfectRat</li>\n<li>Pioneer</li>\n<li>RatAAkk-tt</li>\n<li>rat_http3_ls</li>\n<li>rat_http3_cc</li>\n</ul><p>所有六个变种至少自 2025 年 7 月以来一直迭代演进，呈现出快速且适应性强的发展周期。我们的分析聚焦于 newhttp3，将其作为代表性示例。</p><h2 id=\"sec-3\">行动概览与基础设施</h2><p>我们考察了此次近期 TGR-STA-0049 行动中观察到的 TTP，并梳理完整的行动生命周期，包括：</p><ul>\n<li>初始感染向量</li>\n<li>采用 HTTP/3 作为通信协议</li>\n<li>凭据收集与数据窃取方法</li>\n</ul><p>我们还将深入解析 PerfectPioneer RAT 和 KUKURAT 恶意软件家族的底层架构与专用能力，重点包括：</p><ul>\n<li>PerfectPioneer RAT 不同变种在整个开发生命周期中的结构对比。</li>\n<li>PerfectPioneer RAT 独有的 <span>isDangerousCommand</span> 防误操作机制，可防止恶意软件操作员执行侧重取证或破坏性的命令。</li>\n<li>KUKURAT 广泛的模块化框架。</li>\n<li>KUKURAT 对自动化启发式伪装引擎的集成。</li>\n</ul><h3 id=\"sec-4\">感染向量</h3><p>此次活动背后的攻击者采用双轨感染策略，通过服务器漏洞利用和网络钓鱼相结合的方式，在目标组织内部建立并维持立足点。</p><p>服务器漏洞利用是此次行动中观察到的主要感染向量，例如利用存在漏洞且未打补丁的 Microsoft Exchange 服务器和 Web 服务器来部署 Web Shell。我们观察到其中混合使用了定制和公开可用的 Web Shell，包括 ASPXSpy、Godzilla、Bysunue.aspx 和 Suo5 的各个变种。这些工具与该行为者<a href=\"https://unit42.paloaltonetworks.com/advanced-backdoor-squidoor/\">过往行动</a>中所使用的相一致。</p><p>图 1 展示了从 Web Shell 执行 PerfectPioneer RAT 的过程，以及攻击者如何利用它在受感染服务器上执行初始侦察命令。</p><figure><img src=\"/dailyinfo/media/f4d319905ef5f29a.webp\" srcset=\"/dailyinfo/media/0ec8890c5e07eb78.webp 720w, /dailyinfo/media/2753f06baf0d3905.webp 1200w, /dailyinfo/media/f4d319905ef5f29a.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"A flowchart in Cortex XDR depicting an attack on a compromised web server via a web shell, marked in red text. The flow includes multiple instances of &quot;cmd.exe&quot; executing commands and connecting a RAT. The chart shows a systematic execution path with labeled nodes.\" width=\"900\" height=\"730\"><figcaption>图 1. 从 Web Shell 执行 PerfectPioneer RAT，如 Cortex XDR 中所示。</figcaption></figure><p>我们的调查揭示，该威胁行为者将网络钓鱼战术作为次要感染向量，利用诱饵 PDF 和仿冒域名，诱使用户攻陷其主机。使用定制化基础设施和特定行业的诱饵，体现出一种高度定向的策略，旨在最大限度地提升对高优先级行业的欺骗效果。</p><h3 id=\"sec-5\">HTTP/3 的采用</h3><p>PerfectPioneer RAT 和 KUKURAT 都以 HTTP/3 作为与 C2 基础设施通信的主要方式。尽管 HTTP/3 在更广泛的恶意软件领域很少被采用，但此次活动中的部署反映了高级威胁行为者之间一种<a href=\"https://socprime.com/active-threats/salat-stealer-analysis/\">新兴趋势</a>。部署 HTTP/3 可提供：</p><ul>\n<li><strong>安全且快速的通信通道：</strong>HTTP/3 使用运行于 UDP 之上的 <a href=\"https://www.checkpoint.com/cyber-hub/network-security/what-is-quic/\">QUIC</a> 传输协议。</li>\n<li><strong>有效的防御规避机制：</strong>由于 HTTP/3 使用 UDP，企业网络防御系统无法在不中断底层连接的情况下进行被动 TLS 拦截。一些企业防火墙和传统 IDS/IPS 引擎尚未更新，无法像检查标准 TCP 流量那样严格检查 UDP 流量。当旧版安全策略未专门针对基于 TCP 的 Web 通道进行<a href=\"https://sanjeev41924.medium.com/http-3-challenges-to-security-and-possible-response-e81f429506e0\">优化</a>时，向外发送的 UDP 443 端口通信通常会完全绕过深度包检测，从而可能使恶意 QUIC 流量不受阻碍地传输。</li>\n</ul><h2 id=\"sec-6\">PerfectPioneer RAT 深入分析</h2><p>至少自 2025 年 7 月以来，与此次活动相关的组织一直在部署 PerfectPioneer RAT，这是一个定制的<a href=\"https://go.dev/#\">基于 Go 的</a>恶意软件家族。我们考察了该 RAT 在受感染主机上的执行方式，并探讨了一个代表性变种的架构和行为。我们对六个不同迭代版本的结构进行比较，展示了该对手持续活跃的开发流程。</p><h3 id=\"sec-7\">加载器与执行</h3><p>除了作为可执行文件被释放到磁盘外，我们还观察到攻击者在已攻陷网络中通过三种方式执行 PerfectPioneer RAT：DLL 侧加载、诱饵安装程序和网络钓鱼。这种战术多样性凸显了威胁行为者的运营敏捷性，能够针对不同环境优化目标欺骗和防御规避。</p><ul>\n<li><strong>DLL 侧加载</strong>：攻击者释放了一个合法且无害的可执行文件，并对其结构进行修改，将使用 XOR 加密的 shellcode 嵌入其中，其中包含 PerfectPioneer RAT 载荷。一个恶意加载器 DLL 随该被修改的二进制文件一同释放。执行后，被修改的合法应用会加载被侧加载的 DLL，该 DLL 从遭篡改的宿主可执行文件中读取、解密并执行 shellcode。随后，shellcode 在内存中部署载荷。</li>\n<li><strong>诱饵安装程序</strong>：该行为者使用诱饵软件安装程序将 PerfectPioneer RAT 后台代理释放到磁盘并执行，同时运行看似正常的应用程序安装向导。在一个案例中，我们发现一个诱饵软件安装程序将 <a href=\"https://www.paloaltonetworks.com/sase/globalprotect\">GlobalProtect</a> 安装程序写入磁盘并执行。这一合法的 Palo Alto Networks 安全远程访问产品被用作掩护，同时 PerfectPioneer RAT 的可执行文件被写入磁盘并在后台执行。</li>\n<li><strong>网络钓鱼</strong>：毫无戒心的目标从伪装成政府官方网站的不同域名下载了多个恶意软件样本。为规避检测并欺骗受害者，这些可执行文件被伪装成 PDF 文件，并显示 PDF 图标。当受害者尝试打开该 PDF 文件时，实际上点击的是恶意软件；它会启动一个诱饵 PDF 文档，以维持合法性的假象，而恶意软件则在后台运行。</li>\n</ul><p>图 2 展示了该威胁行为者使用的一个诱饵 PDF 文档，其冒充了缅甸联邦共和国联邦选举委员会于 2025 年发布的一份官方文件。</p><figure><img src=\"/dailyinfo/media/8de3915cc297c51c.webp\" srcset=\"/dailyinfo/media/24af63c84643e2cb.webp 720w, /dailyinfo/media/3cc7b108a27f4120.webp 1200w, /dailyinfo/media/8de3915cc297c51c.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Screenshot of a PDF document in Burmese, featuring a colorful logo with a hand symbol at the top. The document contains text beginning with &quot;2025&quot; in bold. The header text is highlighted in yellow.\" width=\"800\" height=\"884\"><figcaption>图 2. 一份包含有关 2025 年缅甸总理选举通知的诱饵 PDF。</figcaption></figure><h3 id=\"sec-8\">newhttp3 变种</h3><p>我们的深入分析主要聚焦于作者标记为 newhttp3 的变种，该名称出现在一个恢复的项目路径中：<span>D:/proj/http3/newhttp3/agent/。</span>我们选择此样本进行更深入的技术评估，因为它代表了功能最完整的变种。</p><h3 id=\"sec-9\">命令与功能</h3><p>newhttp3 变种包含大量命令，可能使远程操作员完全控制已入侵的端点。与后来在 KUKURAT 中引入的动态模块架构不同，这些功能直接编译在 Go 二进制文件中。</p><p>newhttp3 包含多种功能，可用于全面的数据收集、主机控制和资源管理，并可按以下功能类别进行结构化归类：</p><ul>\n<li>File operations\n<ul>\n<li>列出、上传、下载、删除：完整的文件系统访问权限</li>\n<li>分块传输：大文件以分块方式传输，并跟踪进度</li>\n<li>临时文件管理：跟踪打开的文件句柄，并定期清理</li>\n</ul>\n</li>\n<li>Shell execution\n<ul>\n<li>命令执行功能</li>\n</ul>\n</li>\n<li>Process management\n<ul>\n<li>列出/终止/启动进程</li>\n<li>基于 COM 的进程创建：通过 <a href=\"https://learn.microsoft.com/en-us/windows/win32/com/component-object-model--com--portal\">COM 对象</a>提供替代执行路径</li>\n<li>使用经典 <span><a href=\"https://learn.microsoft.com/en-us/windows/win32/api/memoryapi/nf-memoryapi-virtualallocex\">VirtualAllocEx</a>、</span><a href=\"https://learn.microsoft.com/en-us/windows/win32/api/memoryapi/nf-memoryapi-writeprocessmemory\"><span>WriteProcessMemory</span></a> 和 <a href=\"https://learn.microsoft.com/en-us/windows/win32/api/processthreadsapi/nf-processthreadsapi-createremotethread\"><span>CreateRemoteThread</span></a> 技术进行代码注入</li>\n</ul>\n</li>\n<li>键盘记录</li>\n<li>SOCKS5 代理</li>\n<li>屏幕截图捕获</li>\n<li>窗口枚举与操控</li>\n<li>资源监控</li>\n</ul><p>我们在 <a href=\"https://unit42.paloaltonetworks.com/custom-rats-target-southeast-asia-governments/#post-189752-_pzkauthsi64q\">附录 A：PerfectPioneer RAT 其他功能分析</a> 中提供了完整命令列表。</p><h4 id=\"sec-10\">架构与通信</h4><p>newhttp3 变种的通信框架似乎同时侧重于网络规避和运行稳定性。该恶意软件并未依赖单一通信通道，而是将隐蔽网络协议与旨在维持稳定连接及管理主机资源开销的自动化例程相结合。</p><p>PerfectPioneer RAT 以 HTTP/3 作为其主要 C2 通信机制，并在连接失败时自动回退到 HTTP/2。</p><p>该代理通过四个主要端点与 C2 基础设施交互，详见表 1。PerfectPioneer RAT 使用的 URL 端点与后来 KUKURAT 使用的端点重合，是将这两个家族关联至同一开发管线的另一项关键证据。</p><table>\n<tbody>\n<tr>\n<td><strong>URL 端点</strong></td>\n<td><strong>用途</strong></td>\n</tr>\n<tr>\n<td><span>/agent/register</span></td>\n<td>注册新代理</td>\n</tr>\n<tr>\n<td><span>/agent/heartbeat</span></td>\n<td>向 C2 发送心跳</td>\n</tr>\n<tr>\n<td><span>/agent/tasks</span></td>\n<td>从 C2 获取任务</td>\n</tr>\n<tr>\n<td><span>/agent/result</span></td>\n<td>发送任务执行结果</td>\n</tr>\n</tbody>\n</table><p><span>表 1. PerfectPioneer RAT newhttp3 变种使用的 URL 端点。</span></p><h4 id=\"sec-11\">自愈连接架构</h4><p>PerfectPioneer RAT 实现了三个高度具体的自动化例程，用于维持稳定连接、管理系统开销、尽量减少其取证痕迹并保持低调。</p><ul>\n<li><strong>重连例程</strong>：此例程通过跟踪一个名为 <span>connected</span> 的内部变量，确保与 C2 的连接保持活动状态。如果由于网络中断，心跳检测或命令轮询例程将 <span>connected</span> 变量切换为 <span>false</span>，重连例程便会立即介入。它会取消当前的心跳和命令轮询循环，然后强制执行与 C2 服务器的干净重新注册工作流，试图强制重置连接状态。</li>\n<li><strong>Cleanup routine</strong>: Designed to limit the malware's forensic footprint on disk and prevent excessive consumption of host memory, this routine achieves its goals via two automated methods:\n<ul>\n<li><strong>清理临时文件</strong>：持续跟踪并删除运行期间创建的所有临时文件。这可以尽量减少在磁盘上生成持久性痕迹，并缩短终端检测工具或取证分析人员从文件系统中恢复已缓存运行数据的机会窗口。</li>\n<li><strong>清理内存占用</strong>：监控 RAT 的活动内存占用。如果内存使用量超过 100 MB，它会明确强制触发 Go 运行时的<a href=\"https://go.dev/doc/gc-guide\">垃圾回收</a>周期，以积极清除未分配的内存。保持较低的进程内存占用，可以降低因 CPU 使用率过高而引起怀疑的可能性。</li>\n</ul>\n</li>\n<li><strong>资源监控例程</strong>：此例程代表操作员跟踪客户端的 CPU 和内存利用率。每 30 秒捕获一次性能快照，远程操作员之后可通过特定命令获取该快照，以监控主机负载。</li>\n</ul><h3 id=\"sec-12\">PerfectPioneer RAT 变体对比</h3><p>我们发现了六个不同的 PerfectPioneer RAT 变体。对比这些变体，可以独特地了解该组织的活跃开发周期，并展示他们如何调整代码以满足特定的行动约束。</p><p>尽管各变体的底层代码库非常相似，但我们观察到了通信协议和功能特性方面的差异。所有分析样本的编译时间戳要么经过系统性修改，要么被完全省略，因此无法重建确定的时间顺序开发时间线。</p><p>具体的功能组合因变体而异。某些迭代保持轻量级占用，功能较少，而其他变体则拥有更丰富的凭据收集、进程操纵和网络隧道工具集。</p><p>我们恢复的六个变体可通过其编译项目路径进行区分：</p><ul>\n<li><span>D:/proj/RatAAkk-tt/agent/</span></li>\n<li><span>D:/proj/PerfectRat/agent/</span></li>\n<li><span>D:/proj/http3/newhttp3/agent/</span></li>\n<li><span>D:/proj/http3/rat_http3_ls/agent/</span></li>\n<li><span>D:/proj/http3/Pioneer/</span></li>\n<li><span>D:/proj/http3/rat_http3_cc/</span></li>\n</ul><p>每个变体的详细功能对比见<a href=\"https://unit42.paloaltonetworks.com/custom-rats-target-southeast-asia-governments/#post-189752-_pzkauthsi64q\">附录 A：PerfectPioneer RAT 变体对比</a>。</p><p><strong>isDangerousCommand 防错机制</strong></p><p><span>isDangerousCommand</span> 是我们在分析中发现的最引人注目且前所未有的特性之一。作者将它实现在两个特定的变体中，并将这两个变体命名为 Pioneer 和 rat_http3_cc。</p><p>在执行来自 C2 的任何传入命令之前，<span>isDangerousCommand</span> 例程会将该指令与硬编码命令列表进行交叉比对。如果发现匹配项，该命令将被完全阻止。阻止列表包含一些管理命令，如果执行，将具有高度破坏性或引发大量取证活动（噪声），而安全工具可能会监测到这些活动。加入这一操作层面的“安全开关”，可防止操作人员犯错而导致活动被发现。</p><p>我们的分析显示，硬编码阻止列表同时包含 Windows 和 Linux 环境的语法，如图 3 所示。</p><figure><img src=\"/dailyinfo/media/2c0086607e9800d1.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Screenshot of a series of code snippets in a programming script. The code includes commands related to file operations and internet commands like &quot;wget,&quot; &quot;curl,&quot; and &quot;powershell.&quot; Various numbers and symbols are used for reference and index numbers in brackets. Commands are primarily related to file deletion or downloading.\" width=\"300\" height=\"678\"><figcaption>图 3. PerfectPioneer RAT 的 <span>isDangerousCommand</span> 代码片段。</figcaption></figure><p>由于 Go 代码可以从同一份源代码交叉编译为 Windows 和 Linux 版本，阻止列表中加入 Linux 语法强烈表明该威胁行为者正在开发一个并行 Linux 变种。完整的被阻止命令列表见<a href=\"https://unit42.paloaltonetworks.com/custom-rats-target-southeast-asia-governments/#post-189752-_pzkauthsi64q\">附录 A：防故障机制与被阻止命令。</a></p><h2 id=\"sec-13\">KUKURAT：深入剖析最新模块化后门</h2><p>2026 年 3 月，该威胁行为者将一个明确命名为 KUKURAT 的新自定义有效载荷引入多个已被 PerfectPioneer RAT 攻陷的网络。</p><p>KUKURAT 使用 C++ 编写，我们在野外发现了两个 KUKURAT 变种。尽管其核心功能相似，但这两个变种采用不同的底层网络协议与 C2 通信：一个变种利用 HTTP/2，另一个使用 HTTP/3。</p><p>与 PerfectPioneer RAT 不同，KUKURAT 是一个完全模块化的恶意软件框架。几乎每项利用后能力都作为独立的 DLL 模块实现，并在运行时直接从 C2 服务器动态加载。KUKURAT 的代码支持至少 12 个不同的命名模块。</p><p>通过仅在需要时才将相关功能直接拉入内存，KUKURAT 实现了高度的规避性和适应性。由于静态核心二进制文件不包含高级功能代码，它能够成功避开标准二进制扫描，同时简化功能更新，并阻止取证分析人员恢复底层有效载荷。</p><h3 id=\"sec-14\">注册与心跳</h3><p>启动时，KUKURAT 通过连接 <span>/register</span> 节点，向其 C2 基础设施注册，并从受感染终端发布以下系统信息：</p><ul>\n<li>主机名</li>\n<li>用户名和完整性级别</li>\n<li>操作系统类型和架构</li>\n<li>主机 IP 地址</li>\n<li>代理实例 ID（运行时随机生成）</li>\n</ul><p>C2 会为代理返回初始运行时配置。</p><p>以下 JSON 值表示 KUKURAT 默认的硬编码配置，其中包含会话 ID、各种操作超时以及启发式伪装引擎状态。</p><table>\n\t\t\t\t\t<tbody><tr>\n\t\t\t\t<td>\n\t\t\t\t\t<p>1</p><p>2</p><p>3</p><p>4</p><p>5</p><p>6</p><p>7</p><p>8</p><p>9</p><p>10</p><p>11</p><p>12</p><p>13</p><p>14</p><p>15</p><p>16</p><p>17</p><p>18</p>\n\t\t\t\t</td>\n\t\t\t\t\t\t<td><p><span>{</span></p><p><span>&nbsp;&nbsp;</span><span>\"session_id\"</span><span>:</span><span> </span><span>\"&lt;session_id&gt;\"</span><span>,</span><span> </span></p><p><span>&nbsp;&nbsp;</span><span>\"obfuscation\"</span><span>:</span><span> </span><span>{</span><span>\t\t\t</span><span>// 启发式伪装开启/关闭</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;</span><span>\"network\"</span><span>:</span><span> </span><span>0</span><span>,</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;</span><span>\"registry\"</span><span>:</span><span> </span><span>0</span><span>,</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;</span><span>\"file\"</span><span>:</span><span> </span><span>0</span></p><p><span>&nbsp;&nbsp;</span><span>}</span><span>,</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;</span><span>\"runtime_config\"</span><span>:</span><span> </span><span>{</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;</span><span>\"heartbeat_timeout_ms\"</span><span>:</span><span> </span><span>300000</span><span>,</span><span> </span><span>// 心跳响应的最长等待时间</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;</span><span>\"command_result_timeout_ms\"</span><span>:</span><span> </span><span>300000</span><span>,</span><span> </span><span>// 命令结果的最长等待时间 </span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;</span><span>\"file_transfer_chunk_timeout_ms\"</span><span>:</span><span> </span><span>300000</span><span>,</span><span> </span><span>// 每个文件传输块的超时时间</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;</span><span>\"file_transfer_max_retries\"</span><span>:</span><span> </span><span>5</span><span>,</span><span>\t</span><span>// 文件传输的最大重试次数</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;</span><span>\"file_transfer_retry_delay_ms\"</span><span>:</span><span> </span><span>300</span><span>,</span><span> </span><span>// 文件传输重试之间的延迟</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;</span><span>\"heartbeat_retry_before_rereg\"</span><span>:</span><span> </span><span>1</span><span>,</span><span> </span><span>// 完整重新注册前允许的心跳失败次数</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;</span><span>\"command_worker_threads\"</span><span>:</span><span> </span><span>5</span><span>,</span><span> </span><span>// 并发命令执行线程数</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;</span><span>\"module_exec_timeout_ms\"</span><span>:</span><span> </span><span>600000</span><span> </span><span>// 模块执行调用的超时时间</span></p><p><span>&nbsp;&nbsp;</span><span>}</span><span> </span></p><p><span>}</span></p></td>\n\t\t\t\t\t</tr>\n\t\t\t\t</tbody></table><p>KUKURAT 代理会定期使用 <span>/heartbeat</span> 节点与 C2 通信。该心跳让后端知道代理仍处于存活状态，并获取任何排队等待执行的命令。完整的心跳 JSON 可在 <a href=\"https://unit42.paloaltonetworks.com/custom-rats-target-southeast-asia-governments/#post-189752-_h1kyq9485dht\">附录 B：KUKURAT 心跳 JSON 结构</a>中查看。</p><h3 id=\"sec-15\">能力与支持的命令</h3><p>由于其高度模块化的架构，KUKURAT 的主二进制文件缺少执行后渗透活动所需的嵌入式代码。相反，根据我们对该恶意软件底层逻辑和编译字符串的分析，模块支持与数据收集和渗出、命令执行、侦察及横向移动相关的功能。</p><p>模块提供以下能力：</p><ul>\n<li>屏幕截图和键盘记录</li>\n<li>主机和端口扫描</li>\n<li>进程管理——列出进程、终止进程和注入进程</li>\n<li>文件管理——上传、下载、列出、删除和执行文件</li>\n<li>通过 <span>cmd.exe</span> 和 PowerShell 执行原生 shell 命令</li>\n<li>通过 PsExec 进行横向移动</li>\n<li>Server Message Block (SMB) 凭据暴力破解</li>\n<li>SOCKS 隧道</li>\n<li>本地权限提升</li>\n<li>执行 <a href=\"https://hstechdocs.helpsystems.com/manuals/cobaltstrike/current/userguide/content/topics/beacon-object-files_main.htm\">Beacon Object Files</a> (BOF)</li>\n<li>静默模式配置</li>\n</ul><p>KUKURAT 的模块化框架支持加载和执行任意外部模块，即使该模块与基础代码中预先存在的命令处理程序不匹配。这使威胁行为者能够动态引入新能力，并实时适应不断变化的行动需求。</p><p>有关 KUKURAT 命令的完整列表，请参阅 <a href=\"https://unit42.paloaltonetworks.com/custom-rats-target-southeast-asia-governments/#post-189752-_h1kyq9485dht\">附录 B：KUKURAT 命令帧架构</a>。</p><p>图 4 展示了 KUKURAT 代码中执行 <span>screenshot</span> 模块的代码片段。KUKURAT 在执行模块之前，会通过传递给已加载模块的硬编码参数 <span>capture</span> 验证该模块是否已加载。如果模块加载或屏幕截图捕获失败，则会向操作员发送一条错误消息。</p><figure><img src=\"/dailyinfo/media/1d90a56354989963.webp\" srcset=\"/dailyinfo/media/0707e12596d3775d.webp 720w, /dailyinfo/media/f5cb6dcdf09eb229.webp 1200w, /dailyinfo/media/1d90a56354989963.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Screenshot of a code snippet displaying a function related to loading and executing a screenshot module. Includes error messages like &quot;Failed to load screenshot module&quot; and &quot;Failed to capture screenshot&quot;.\" width=\"900\" height=\"397\"><figcaption>图 4. 执行 <span>screenshot</span> 模块的 KUKURAT 代码片段。</figcaption></figure><h3 id=\"sec-16\">部署独立的 KUKURAT 模块</h3><p>在调查期间，我们发现攻击者使用 KUKURAT 部署了两个名为 <span>PsExecService.exe</span> 和 <span>SecurityGuard.exe</span> 的可执行文件。尽管我们无法获取 <span>SecurityGuard.exe</span>，但成功恢复了 <span>PsExecService.exe</span> 供分析。</p><p>根据该文件的编译程序数据库（PDB）字符串，尽管此二进制文件是作为独立可执行文件而非 DLL 编译的，攻击者仍明确将其归类为 KUKURAT 的外部模块：</p><p><span>d:\\proj\\<strong>KUKURAT</strong>\\<strong>modules</strong>\\MyPsExec-master\\PsExecService\\</span></p><p>该工具是一个定制的远程执行服务，似乎可能部分基于开源 <a href=\"https://github.com/zesiar0/MyPsExec/tree/master\">MyPsExec</a> GitHub 项目。执行后，<span>PsExecService.exe</span> 会将自身注册为名为 <span>PsExec</span> 的本地 Windows 服务，并创建一个名为 <span>\\\\.\\pipe\\PSEXEC</span> 的命名管道。该服务原生支持四种命令：</p><ul>\n<li>Shell 执行</li>\n<li>文件上传</li>\n<li>文件下载</li>\n<li>目录列表</li>\n</ul><p>为了限制其取证痕迹，该服务使用内部自毁计时器，在五分钟无活动后自动卸载服务并清理其痕迹。</p><h3 id=\"sec-17\">伪造终端活动：启发式伪装引擎</h3><p>KUKURAT 引入了一种独特的启发式伪装引擎，能够跨三个系统维度运行：网络、注册表和文件。该引擎旨在终端上生成看似合法的虚假活动，以伪装恶意软件的实际操作。通过模拟正常操作行为，威胁行为者建立了一个虚假的基线，这可能会显著影响自动化检测和其他取证工作。威胁行为者可以通过 C2 命令 <span>set_obfuscation</span> 开启或关闭每种方法：</p><ul>\n<li><strong>网络噪声生成</strong>：KUKURAT 在每个操作周期中生成 10 个诱饵 HTTP 请求，目标为从硬编码的 15 个热门网站列表中随机选择的域名，并使用随机生成的 URL 路径。这可以伪装流量，将 C2 通信混入正常的网络噪声中。</li>\n<li><strong>模拟浏览器活动的注册表操纵</strong>：KUKURAT 通过向注册表路径 <span>HKCU\\Software\\Google\\Chrome\\BrowserCrashRecovery</span> 写入随机数据、再将数据读回并随后删除该项，模拟合法的 Google Chrome 浏览器行为。然后，它打开并枚举 <span>HKCU\\Software\\Google\\Update\\ClientState</span> 注册表项。这一操作的目的是使该代理的注册表操作看起来像是 Chrome 崩溃恢复。</li>\n<li><strong>文件噪声生成</strong>：恶意软件持续在系统 <span>%temp%</span> 目录中创建具有随机名称和随机内容的临时文件，随后立即将其删除。该技术生成文件系统噪声，掩盖代理对文件的修改。</li>\n</ul><p>尽管这种规避技术的某些要素此前已在多个恶意软件家族中被记录，但 KUKURAT 通过一种高度独特的设计选择与它们区分开来。它能够跨三个独立攻击向量协调启发式伪装，同时在运行时动态启用或禁用各项功能。</p><h3 id=\"sec-18\">看门狗组件</h3><p>在多起事件中，攻击者都会将 KUKURAT 与一个独立的看门狗可执行文件一起部署，以确保恶意软件持续运行。</p><p>当 KUKURAT 的主二进制文件执行时，它会创建一个专用线程，用于与配套的看门狗组件通信。KUKURAT 每三秒将自己的活动文件路径写入一个名为 <span>WINDOW_SEC_WATCHDOG</span> 的本地命名管道。配套的看门狗进程读取该路径，并每秒获取一次心跳消息。如果连续 15 秒未收到心跳，看门狗便认为 KUKURAT 已被终止，并使用缓存的文件路径自动重新启动它。</p><p>有一次，我们观察到威胁行为者将该看门狗组件部署到 <span>C:\\ProgramData\\Cyvera\\Ransomware\\</span> 目录路径中。该文件夹结构过去与 <a href=\"https://www.paloaltonetworks.com/cortex/cortex-xdr\">Cortex XDR</a> 关联，表明威胁行为者试图通过藏身于安全产品的目录结构中来降低被怀疑的可能性。</p><h3 id=\"sec-19\">变体比较</h3><p>调查确认了 KUKURAT 的两个不同变体，分别利用 HTTP/2 和 HTTP/3 进行 C2 通信。除了网络传输协议不同之外，这两个变体在结构上几乎完全相同，仅有少数值得注意的代码演进会影响恶意软件的开发适应性和运行存活性：</p><ul>\n<li><strong>命令处理架构：</strong>在 HTTP/2 变体中，威胁行为者在单个命令处理函数内实现了一条庞大且嵌套的 If-Else 条件链。所有执行和模块加载逻辑都直接嵌入这些条件之中。HTTP/3 变体则转为使用映射至各个命令的函数指针数组，为每项执行例程创建一个独立函数。这一设计转变使恶意软件开发人员能够更高效地即时添加或移除功能。</li>\n<li><strong>内置 exec 绕过命令</strong>：虽然 KUKURAT 被设计为一款完全模块化的恶意软件框架，能够动态加载代码，但 HTTP/3 变体引入了一个明确的原生编码命令 <span>exec</span>。该命令使攻击者能够通过 <a href=\"https://learn.microsoft.com/en-us/windows/win32/api/processthreadsapi/nf-processthreadsapi-createprocessa\"><span>CreateProcessA</span></a> 直接在主机端点上生成子进程，并将生成的终端输出通过管道传回 C2 后端。由于 HTTP/2 变体中不存在此命令，其加入表明作者试图提供一个内置的生存选项：允许操作人员原生运行系统命令，而无需从暂存服务器获取外部模块 DLL。</li>\n</ul><h2 id=\"sec-20\">后利用与网络传播</h2><p>以下部分介绍了此次行动期间用于在已入侵的企业网络中进行横向移动、收集凭据、从 Active Directory 控制过渡到端点感染以及外泄敏感数据所使用的 TTP。</p><h3 id=\"sec-21\">通过域登录脚本进行横向移动</h3><p>该威胁行为者最值得注意的网络传播方式涉及操纵域登录脚本，这是一种隐蔽的持久化机制，用于在环境中执行代码。此外，他们还使用知名工具和远程管理协议，例如 PsExec、Windows Management Instrumentation (WMI) 和 Windows Remote Management (WinRM)。</p><p>成功攻陷域控制器后，攻击者安装了恶意登录脚本。因此，每当合法用户通过身份验证登录域时，恶意脚本都会在其本地端点上自动执行，从而触发 KUKURAT 恶意软件的下载和执行。</p><p>图 5 展示了恶意登录脚本的执行过程，该脚本会将 KUKURAT 恶意软件下载并执行到受感染主机上，如 Cortex XDR 所示。</p><p><img src=\"/dailyinfo/media/0c4b5422fa73885c.webp\" srcset=\"/dailyinfo/media/ff6ebc205ddbfaab.webp 720w, /dailyinfo/media/059039d0018009ba.webp 1200w, /dailyinfo/media/0c4b5422fa73885c.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"A flowchart of a command execution process in Cortex XDR. Three main icons are shown, each labeled with &quot;CGO.&quot; Lines connect these icons, indicating the sequence of commands leading to the execution of a file. There are red exclamation marks indicating alerts or risks, and the word &quot;KUKURAT&quot; is prominently displayed in red/ A command string at the bottom shows the execution pathway. Some text is redacted for privacy.\" width=\"905\" height=\"534\"></p><p>图 5. 如 Cortex XDR 所示，通过恶意登录脚本部署 KUKURAT。</p><p>图 6 显示，由于一个以本地用户或域用户安全标识符 (SID) 运行的不常见启动进程，登录脚本持久化技术触发了警报。</p><figure><img src=\"/dailyinfo/media/87d3f858918c2e33.webp\" srcset=\"/dailyinfo/media/aabe64588961bfab.webp 720w, /dailyinfo/media/57c42db61ffb7b60.webp 1200w, /dailyinfo/media/87d3f858918c2e33.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Screenshot of Cortex XDR dashboard alert titled 'Execution of an uncommon process with a local/domain user SID at an early startup stage with suspicious characteristics.' The alert provides details about the execution of AdobePhoto.exe with potential persistence mechanisms. Status is shown as unassigned and severity as medium.\" width=\"1000\" height=\"358\"><figcaption>图 6. 如 Cortex XDR 所示，针对登录脚本持久化技术发出的警报。</figcaption></figure><h3 id=\"sec-22\">凭据窃取技术</h3><p>在获得初始访问权限后，该威胁行为者采用多种技术收集凭据，包括 Local Security Authority Subsystem Service (LSASS) 内存转储和 Directory Service Replication (DCSync)。</p><p>该威胁行为者还积极使用了一套功能强大的凭据转储工具、双用途管理工具和注册表操纵技术，包括：</p><ul>\n<li><a href=\"https://attack.mitre.org/software/S0002/\">Mimikatz</a> 和 <a href=\"https://learn.microsoft.com/en-us/sysinternals/downloads/procdump\">ProcDump</a></li>\n<li><a href=\"https://github.com/GhostPack/SharpDPAPI\">SharpDPAPI</a>，用于解密 DPAPI 凭据和机密</li>\n<li>手动转储 SAM 和 SYSTEM 注册表配置单元，以提取本地账户哈希</li>\n</ul><h4 id=\"sec-23\">LSASS 内存转储</h4><p>攻击者利用一种就地取材的<a href=\"https://lolbas-project.github.io/lolbas/Libraries/comsvcs/\">技术</a>转储 <span>lsass.exe</span> 进程的内存。他们滥用原生 Windows 实用工具 <span>comsvcs.dll</span>，执行了以下命令。</p><table>\n\t\t\t\t\t<tbody><tr>\n\t\t\t\t<td>\n\t\t\t\t\t<p>1</p>\n\t\t\t\t</td>\n\t\t\t\t\t\t<td><p><span>CmD</span><span>.</span><span>exe</span><span>&nbsp;&nbsp;</span>/<span>Q</span><span> </span>/<span>c</span><span> </span><span>for</span><span> </span>/<span>f</span><span> </span>\"tokens=1,2 delims= \"<span> </span>%<span>A</span><span> </span><span>in</span><span> </span><span>(</span><span>'\"tasklist /fi \"Imagename eq lsass.exe\" | find \"lsass\"\"'</span><span>)</span><span> </span><span>do</span><span> </span><span>rundll32</span><span>.</span><span>exe</span><span> </span><span>C</span><span>:</span><span>\\</span><span>windows</span><span>\\</span><span>System32</span><span>\\</span><span>comsvcs</span><span>.</span><span>dll</span><span>,</span><span> </span><span>#+000024 %B \\Windows\\Temp\\MxA.tar full</span></p></td>\n\t\t\t\t\t</tr>\n\t\t\t\t</tbody></table><p>攻击者没有按名称调用 <span>MiniDump</span> 函数，而是通过其隐藏的序号索引 #+000024 调用它。这种规避战术旨在绕过会检测显式 MiniDump 字符串的安全检测机制。</p><h4 id=\"sec-24\">Directory Service Replication</h4><p>为进一步破坏身份基础设施，攻击者执行 DCSync 攻击，直接从域控制器提取密码哈希。这使他们能够模拟域控制器复制用户凭据的行为，如图 7 所示。</p><figure><img src=\"/dailyinfo/media/73e2a584faf2344c.webp\" srcset=\"/dailyinfo/media/d2d2c84100ac655c.webp 720w, /dailyinfo/media/3d9568a797d4bf82.webp 1200w, /dailyinfo/media/73e2a584faf2344c.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Screenshot of Cortex XDR dashboard showing execution alert. It includes a notification about an unusual process execution with a local/domain user SID at an early startup stage, flagged for suspicious characteristics. There are tabs labeled Overview, Resolution, Work Plan, and Analysis. \" width=\"800\" height=\"332\"><figcaption>图 7. 如 Cortex XDR 所示，针对 DCSync 攻击发出的警报。</figcaption></figure><h3 id=\"sec-25\">数据外泄</h3><p>在系统性地遍历网络并收集高权限凭据后，威胁行动者启动了其主要目标：网络间谍活动。威胁行动者利用 PerfectPioneer RAT 和 KUKURAT 恶意软件家族，试图将大量文档回传至其 C2 基础设施。被针对的数据主要包括 <span>.pdf、.docx、.xlsx</span> 和 <span>.png</span> 文件，其文件名表明内容可能包含敏感信息，尤其关注国际关系和内部政治事务。</p><p>除窃取文档外，攻击者还针对邮件基础设施展开行动。他们从已失陷的 Exchange 服务器这一初始落脚点出发，执行了多条 PowerShell 命令，以识别并滥用管理员权限。</p><ul>\n<li><strong>为冒充权限进行侦察：</strong>攻击者首先检查了被分配了 <span>ApplicationImpersonation</span> 角色的账户。在 Microsoft Exchange 中，该角色允许单个账户冒充组织中的任意用户（或特定用户子集）。利用这项权限，账户无需获知或提供相应用户的明确密码，即可直接访问其他邮箱。</li>\n</ul><p>威胁行动者执行了以下命令，以确定其已经控制的账户是否拥有这些权限。</p><table>\n\t\t\t\t\t<tbody><tr>\n\t\t\t\t<td>\n\t\t\t\t\t<p>1</p>\n\t\t\t\t</td>\n\t\t\t\t\t\t<td><p><span>\"C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe\"</span><span> </span>-<span>NoExit</span><span> </span>-<span>Command</span><span> </span><span>\"&amp; { . 'C:\\Program Files\\Microsoft\\Exchange Server\\V15\\bin\\exshell.psc1'; Get-ManagementRoleAssignment -Role:ApplicationImpersonation }\"</span></p></td>\n\t\t\t\t\t</tr>\n\t\t\t\t</tbody></table><table>\n\t\t\t\t\t<tbody><tr>\n\t\t\t\t<td>\n\t\t\t\t\t<p>1</p>\n\t\t\t\t</td>\n\t\t\t\t\t\t<td><p><span>C</span><span>:</span><span>\\</span><span>Windows</span><span>\\</span><span>System32</span><span>\\</span><span>WindowsPowerShell</span><span>\\</span><span>v1</span><span>.</span><span>0</span><span>\\</span><span>powershell</span><span>.</span><span>exe</span><span> </span>-<span>NoLogo</span><span> </span>-<span>NoProfile</span><span> </span>-<span>Command</span><span> </span><span>\"Add-PSSnapin Microsoft.Exchange.Management.PowerShell.SnapIn; Get-ManagementRoleAssignment -Role:ApplicationImpersonation\"</span></p></td>\n\t\t\t\t\t</tr>\n\t\t\t\t</tbody></table><ul>\n<li><strong>获取广泛邮箱访问权限：</strong>如果初步侦察显示威胁行动者无法访问拥有现有冒充权限的账户，威胁行动者便转向一种更直接的备用方案。</li>\n</ul><p>我们观察到，威胁行动者利用管理员权限执行命令，循环遍历环境中的每一个邮箱，并明确授予一个已失陷的用户账户不受限制的读/写权限。</p><table>\n\t\t\t\t\t<tbody><tr>\n\t\t\t\t<td>\n\t\t\t\t\t<p>1</p>\n\t\t\t\t</td>\n\t\t\t\t\t\t<td><p><span>C</span><span>:</span><span>\\</span><span>Windows</span><span>\\</span><span>System32</span><span>\\</span><span>WindowsPowerShell</span><span>\\</span><span>v1</span><span>.</span><span>0</span><span>\\</span><span>powershell</span><span>.</span><span>exe</span><span> </span>-<span>WindowStyle </span><span>Hidden</span><span> </span>-<span>NoLogo</span><span> </span>-<span>NoProfile</span><span> </span>-<span>Command</span><span> </span><span>\"Get-Mailbox -ResultSize Unlimited | ForEach-Object { Add-MailboxPermission -Identity $_.PrimarySmtpAddress -User 'REDACTED' -AccessRights FullAccess -AutoMapping:$False -Confirm:$False }\"</span></p></td>\n\t\t\t\t\t</tr>\n\t\t\t\t</tbody></table><p>在使用 Web shell 进行侦察以获取冒充权限后，攻击者执行了一条命令，授予自己对环境中每一个邮箱的访问权限。图 8 展示了在 Cortex XDR 中针对邮件基础设施执行 PowerShell 命令的过程。</p><figure><img src=\"/dailyinfo/media/573886c37792cb41.webp\" srcset=\"/dailyinfo/media/963f07eb4930c9b6.webp 720w, /dailyinfo/media/c099ea9d988a6209.webp 1200w, /dailyinfo/media/573886c37792cb41.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Screenshot of a diagram in Cortex XDR displaying a process tree for &quot;powershell.exe&quot;. Three subprocesses branch from &quot;powershell.exe,&quot; each executing distinct PowerShell commands and other mail and role assignments.\" width=\"1000\" height=\"627\"><figcaption>图 8. 在 Cortex XDR 中展示的针对邮件基础设施执行 PowerShell 命令的过程。</figcaption></figure><h2 id=\"sec-26\">结论</h2><p>TGR-STA-0049 的行动揭示了一个高度适应性的威胁行为体，其目标横跨东南亚的政府基础设施。通过部署 KUKURAT 和 PerfectPioneer RAT，该活动背后的攻击者正不断演进，借助 HTTP/3 以及基于 UDP 的 QUIC 实现协议层级的规避，从而领先于传统网络防御。</p><p>使该组织特别难以侦测的，是其在维持行动安全、隐藏于被入侵终端上所投入的大量工作。从 PerfectPioneer RAT 自动化的自愈连接架构，到 KUKURAT 高度复杂的启发式伪装引擎，该组织展现了对现代防御生态的成熟理解。他们甚至在其二进制文件中嵌入了硬编码的管理员安全开关，以防止自家操作员运行可能触发安全告警的、过于喧闹或具破坏性的命令。</p><p>最终，该组织的隐蔽技术手法服务于一个更宏观的目标：确保一次高度定向的数据外泄活动取得成功。其特征是该行为体广泛尝试窃取从文件名看似乎属于敏感情报的内容，并利用被入侵的 Exchange 环境中的邮箱冒充权限。</p><p>为应对这一新一代的advanced间谍活动，防御者必须超越传统的、以 TCP 为中心的可见性。保护高价值网络需要全面转向：捕获未经授权的基于 UDP 的 Web 流量，严格审计 Active Directory 验证机制，并监控这些以隐蔽性为重的活动在主机层面留下的行为异常。</p><h3 id=\"sec-27\">Palo Alto Networks 防护与缓解</h3><p>为更好地防范 TGR-STA-0049 所使用的 TTP，各组织应考虑实施以下网络层与主机层行为控制措施：</p><ul>\n<li><strong>监控或限制 QUIC 并强制协议回退：</strong> 网络管理员应配置边缘防火墙，要么记录并检查 QUIC 流量，要么彻底阻断出站的 UDP 443 端口。阻断会强制 HTTP/3 和 QUIC 通信平滑回退到基于 TCP 的 HTTP/2 或 TLS 通道，从而确保标准的深度包检测与解密引擎能够原生监控该流量。</li>\n<li><strong>审计 Active Directory 登录脚本：</strong> 安全地并持续审计 <span>sysvol</span> 共享与组策略对象（Group Policy Objects）是否被未经授权地修改。配置 EDR 平台，以便在用户身份验证期间对以域用户 SID 执行的可疑进程发出告警。</li>\n<li><strong>监控盲目的 LSASS 内存转储方式：</strong> 创建行为检测规则，追踪 <span>rundll32.exe</span> 与 <span>comsvcs.dll</span> 的交互，以捕获绕过标准基于字符串的文本过滤的按序号调用方式（例如 <span>#+000024</span>）。</li>\n<li><strong>审核 Exchange 模拟与访问权限：</strong>定期运行验证脚本，审查被分配了 <span>ApplicationImpersonation</span> 角色的账户。监控 Exchange 日志中 <span>Add-MailboxPermission</span> 命令的执行情况，特别标记那些自动循环、在整个组织范围内授予账户 <span>FullAccess</span> 权限的操作。</li>\n</ul><p>Cortex <a href=\"https://docs-cortex.paloaltonetworks.com/r/Cortex-AgentiX/Cortex-AgentiX-Documentation/Get-Started-with-Cortex-AgentiX\">AgentiX</a> 智能体助手简化了我们的调查流程，使团队能够使用自然语言查询数据，提供更深入的背景信息和洞察，并就下一步应采取的行动提出明确建议。图 9 展示了 AgentiX 界面，用于查找与 KUKURAT 所使用的恶意域名通信的进程。</p><figure><img src=\"/dailyinfo/media/19bda5ea82a1f985.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Screenshot of a screen from Cortex AgentiX related to an endpoint investigation. It details the process `Photo.exe` with frequent communication over multiple networks, indicating potential malicious behavior. The document mentions a specific path and file location, as well as technical insight into the process's activity and characteristics, highlighting it as suspicious.\" width=\"400\" height=\"1030\"><figcaption>图 9. 使用 AgentiX 查找与 <span>www.investigationj6[.]com</span> 通信的进程。</figcaption></figure><p>Palo Alto Networks 的客户可通过以下产品和服务更好地防范上述威胁：</p><ul>\n<li><a href=\"https://docs.paloaltonetworks.com/wildfire\">Advanced WildFire</a> 机器学习模型与分析技术已根据本研究共享的威胁指标进行了审查和更新。</li>\n<li><a href=\"https://docs.paloaltonetworks.com/advanced-url-filtering\">Advanced URL Filtering</a>、<a href=\"https://docs.paloaltonetworks.com/dns-security\">Advanced DNS Security</a> 和 <a href=\"https://www.paloaltonetworks.com/network-security/advanced-ip-defense\">Advanced IP Defense </a>会将与此活动相关的已知域名和 URL 标识为恶意。</li>\n<li><a href=\"https://docs-cortex.paloaltonetworks.com/p/XDR\">Cortex XDR</a> 和 <a href=\"https://docs-cortex.paloaltonetworks.com/p/XSIAM\">XSIAM</a>旨在阻止已知恶意软件的执行，并利用行为威胁防护和基于 Local Analysis 模块的机器学习，阻止未知恶意软件的执行。</li>\n<li><a href=\"https://docs.cyberark.com/epm/latest/en/content/intro/introduction.htm\">Idira Endpoint Privilege Manager (EPM)</a>可以帮助企业降低风险、满足合规要求并简化运营。它通过策略驱动的权限提升和常设管理员权限移除来帮助实施最小权限原则，并阻止执行未经审查的应用程序、访问其他进程内存等高风险操作，同时提供可供审计的证据和统一身份治理。</li>\n<li><a href=\"https://docs.cyberark.com/secrets-manager-saas/latest/en/content/conjurcloud/cl_conjurcloudoverview.htm?tocpath=Get%20started%7C_____1\">Idira Privileged Access Management (PAM)</a> 可以帮助统一管理人员、机器和智能体身份之间的特权访问，从而保护多云环境中的云访问。该产品基于成熟可靠的 PAM，提供集中式机密管理，并具备即时访问和零常设权限等现代控制能力。</li>\n<li><a href=\"https://docs.cyberark.com/pam-self-hosted/latest/en/content/pasimp/integrate-with-sia.htm\">Idira Secure Infrastructure Access (SIA)</a> 可以通过即时 (JIT) 预配来帮助强制执行零常设权限 (ZSP)，仅在需要时授予临时且权限范围严格受限的访问。借助持续的会话录制和实时命令监控，SIA 能够在攻击者攻陷关键系统之前检测到高风险操作。</li>\n</ul><p>组织可通过 <a href=\"https://www.paloaltonetworks.com/unit42/threat-intelligence\">Unit 42 Threat Intel Services</a> 及其 <a href=\"https://www.paloaltonetworks.com/resources/datasheets/unit-42-deep-and-dark-web-service\">Deep and Dark Web Service</a>获取定制化的对手情报、分析师直接咨询以及专业暴露面跟踪服务。</p><p>如果您认为自己可能已遭入侵，或有紧急事项，请联系 <a href=\"https://start.paloaltonetworks.com/contact-unit42.html\">Unit 42 事件响应团队</a>或拨打：</p><ul>\n<li>北美：免费电话：+1 (866) 486-4842 (866.4.UNIT42)</li>\n<li>英国：+44.20.3743.3660</li>\n<li>欧洲和中东：+31.20.299.3130</li>\n<li>亚洲：+65.6983.8730</li>\n<li>日本：+81.50.1790.0200</li>\n<li>澳大利亚：+61.2.4062.7950</li>\n<li>印度：000 800 050 45107</li>\n<li>韩国：+82.080.467.8774</li>\n</ul><p>Palo Alto Networks 已将这些发现分享给我们的 fellow 联盟（Cyber Threat Alliance，CTA）成员。CTA 成员利用这些情报快速为其客户部署防护措施，并系统性地瓦解恶意网络攻击者。进一步了解 <a href=\"https://www.cyberthreatalliance.org/\">Cyber Threat Alliance</a>。</p><h2 id=\"sec-28\">失陷指标</h2><h3 id=\"sec-29\">SHA256 哈希</h3><p>PerfectPioneer RAT – <span>RatAAkk-tt</span></p><ul>\n<li><span>2281e754f70e11298db1a0a7c1b527cf2b5eec2056d4c73a46ed572ab873dc6e</span></li>\n<li><span>9721d65ee7695db2b3dc3705f5d8e5efe3a478c3b6d1704d66daf77fe95aeb0d</span></li>\n<li><span>d725ad8b523c94f99fca9e72a650e835dca47b9ebe7610d6c4eb3525d410c365</span></li>\n</ul><p>PerfectPioneer RAT – PerfectRAT</p><ul>\n<li><span>f4c9d5d13c1a09533876a02f6fa04831efbf600b05cfb3ed765a0ebde82b0457</span></li>\n<li><span>19bb3012d846f3672fb98dad0449ae5c267ab30150800b2f1559036564c7d0b8</span></li>\n</ul><p>PerfectPioneer RAT – <span>rat_http3_ls</span></p><ul>\n<li><span>92fb9545ea49e2fb4635fce1859ff3f609738be75f85d146614243fc8bc80b67</span></li>\n</ul><p>PerfectPioneer RAT – Pioneer 诱饵安装包</p><ul>\n<li><span>ab06f540ecdd1d45491aa71bfc04c80852371c8f5cd43b9a6ebb53f1e1b69588</span></li>\n</ul><p>PerfectPioneer RAT – Pioneer 核心代理</p><ul>\n<li><span>bf59f8d7ef79b09a72bbb9c05ca8746466d03226a3779cc1096ba067117ca008</span></li>\n<li><span>8bf9401990d3255d1022a25884b02ee75ef01bd1a729d29ff52de2e5f0d637a2</span></li>\n</ul><p>PerfectPioneer RAT – <span>newhttp3</span> 修改后的宿主二进制文件</p><ul>\n<li><span>5f857ff78bfbef2a55a846fc93744e11e07a9b72ee3fc3bc345c32ce9615ddee</span></li>\n</ul><p>PerfectPioneer RAT – <span>newhttp3</span> 加载器 DLL</p><ul>\n<li><span>61f7e2f4159c566578e88cb05cdf49e4378f45ebddbd332224e97c11df922120</span></li>\n</ul><p>PerfectPioneer RAT – <span>newhttp3</span> 核心代理</p><ul>\n<li><span>5b7effbf0465c05e8dc9a8fea69b000a78237735ea0b854e8d9baee5b7af8344</span></li>\n<li><span>cd8f43da32849584751eec884cf7e3208eb0a71108197a32e9bb248612e757d2</span></li>\n<li><span>7541222a1316ec54bf9c8660b923e1d0490a925b2ee92060b1567be7cb1bde4b</span></li>\n<li><span>cffcd6f2589d3ab4f3693805d1752b7c328a00cc543dd02b129763e179c3f311</span></li>\n<li><span>5805cb5b0a6fb738ef7c1873b8e5de4281c36c7f440f28717fa9f441c5e0ef17</span></li>\n<li><span>a6a9ccffadd00b0e75e913b0f851b1f834fd20588df8b89759d9ae49a48c8e10</span></li>\n</ul><p>PerfectPioneer RAT – <span>rat_http3_cc</span> 修改后的宿主二进制文件</p><ul>\n<li><span>b975f5932c04b381f8fa58a3303194f1aff950d3c6cd12dcc1d323bb3393718b</span></li>\n<li><span>904409ce8846394e1fe9a5ce37f2265cbf6933611278ae57fdf5fa74759af2bb</span></li>\n<li><span>d700b573ea8387efad633a70124b7a2a3aece844a267157b1cb55be7b62f3b67</span></li>\n<li><span>52d3442fb26023ebc0bc76542b56be88d1c3327c8bcedf1dcb95f80511527f07</span></li>\n</ul><p>PerfectPioneer RAT – <span>rat_http3_cc</span> 加载器 DLL</p><ul>\n<li><span>8cfe629fc08ae06c8ba106113ba30bb16fa2fbbf8bd3dd6831d16b031e0ebe70</span></li>\n</ul><p>PerfectPioneer RAT – <span>rat_http3_cc</span> 核心代理</p><ul>\n<li><span>619b749e1c6634d38f15c51005a4237e9076aaaf36927b562a990e8bc34fdfcb</span></li>\n<li><span>fb5b0b1d083d6f6afa90948bd1fd1a498b51dd3f6dc7f90a02a2a17818756563</span></li>\n<li><span>183abf82951c2052e9a1829c70c173c11756e8df0e86c8071c27df0988caeaa0</span></li>\n</ul><p>PerfectPioneer RAT 未知变种</p><ul>\n<li><span>0533365accbba405757de7eb486533c11c8e0510a28d414ee8c5e6b8a41ed97b</span></li>\n<li><span>3cb5376a5e6c0fcbd6844ab76f3dc73a42da7ecee6ecaaef285d4abe33964fa1</span></li>\n<li><span>f5ebe85418655d75d1a760543858846db1478a060875fd19ddaa5e2febc038d7</span></li>\n</ul><p>PerfectPioneer RAT 未知变种 – 修改后的宿主二进制文件</p><ul>\n<li><span>b5bea4d8b94fbb39ac992e8e763680af6f39d12d42e264b43431fb61cf7b9a88</span></li>\n<li><span>7745523939fc6b31b6a73d8ca1f363c62438b6eef56f6fe8c39e71fcd14b65f4</span></li>\n</ul><p>PerfectPioneer RAT – 加载器 DLL 组件</p><ul>\n<li><span>0c49e1b98a236d3391740473101b66dd48c719fa4112dbef3816b56bce58e6e7</span></li>\n<li><span>24c46bc9269e1c1ee54004e01d5c7c54f759bc1b93a282d3561d2d27f678af86</span></li>\n<li><span>e5689e1bf916c2f7649e178008e790ea13eb844aefc14516c06b0da8296377a1</span></li>\n<li><span>63eac14921f138fffe73db417c12afd16d64202ebbee7ad5f08068697d2942d0</span></li>\n<li><span>790e6699704395a7fad633f4e502312bc43693a44a8e18d43239209eefbd7ff2</span></li>\n<li><span>f82c06184ab36e91d28f7802c739e637792c241a7ff2fba9ca24178f12423684</span></li>\n<li><span>2e52b2936e67872d1364d2d0d26a8733ed9582b38f6f0b3a877ffdd6e2c04aa4</span></li>\n<li><span>9dfefc7118646535d1193e1b036dd0c93fa66cc585a60301fcdceb6f45903aad</span></li>\n<li><span>600572a912650b258d56aedeef0ab712abbe35a38cdd23faa5a95dacfdc67b7f</span></li>\n<li><span>86194c3b3cc7a58e439621aff42e116ca94d40f3a6f539f20ce483f1cf5a7191</span></li>\n<li><span>e8cd6bbcf6073669a7415ce0c9009a0fbb5551bf5e17803be12ef295f0c99889</span></li>\n<li><span>5b779b81a9bb25591ecac6bd74bb44a4a5b2b8f257093f9efd5910346ab8d772</span></li>\n</ul><p>PerfectPioneer RAT – 额外变种</p><ul>\n<li><span>c4b4647795567ab15528edd1ab1bf37fb50e21b442e59a653051061973e87c02</span></li>\n<li><span>bf8afbd1c2074c7cd6ff8b86dbe67a57ca5594817e46b24e226b71c4edde7697</span></li>\n</ul><p>KUKURAT – HTTP/3 变种</p><ul>\n<li><span>b8dca1c7e7a74ce82ab4e4cad9b718a458735d2c6c956e4cf3109aac59bfd0e4</span></li>\n<li><span>9fb0976fcd1f92c4711726a91cff8be9a39944efedc4caf2d80f935327f8f490</span></li>\n</ul><p>KUKURAT – HTTP/2 变种</p><ul>\n<li><span>7225ef57161cf0908560811be798d22e9354c071d576540a43aa7900784c0688</span></li>\n<li><span>a214d264c6bb0d2ba89986f73e196ea200307574745a245fc42c32fbef4cc140</span></li>\n<li><span>662dc73e11b60b2f12c94b6b68da45de7bffece4b1dcc75679ed020629d0705d</span></li>\n</ul><p>KUKURAT 伴随看门狗进程</p><ul>\n<li><span>b062b4d8c19baf5c1568e28b3e0a5e2318e9501ea61ddfe804d9755c1bdbf887</span></li>\n</ul><p>KUKURAT <span>PsExecService.exe</span> 模块</p><ul>\n<li><span>34cc9bc4a533b91e7cdb30fecc57ba609dc890780fd13ecfbc253047b3b37b78</span></li>\n</ul><p>SharpDPAPI</p><ul>\n<li><span>0cbde9b7f59dafca80f214121a04eda7804b920da28ce1c06939a4783e6b097f</span></li>\n<li><span>cdc9757294d3063eb10c9a37d1d945d31f6857c652b864803815406b02eeefbf</span></li>\n</ul><p>未映射文件</p><ul>\n<li><span>82a989c728db4e09a2b85a4a55f7663cefa62844632cb16dcda5ca70bf09a8a5</span></li>\n<li><span>71d897427329ca14dd621e777046dc35f3d9dc870d3b13a56125125391a56afe</span></li>\n<li><span>6781f84417d0056df95ed38b3e7a6b49312d30119470356f6923238d49de3490</span></li>\n<li><span>dd02d28c48cf5cabd35a0b32e05e7c99ff0de35541201026ae36c59e54968c78</span></li>\n<li><span>e59b08eb03ffa10ccf9103d171af757308e6d43519c4e904ef5e0929ef92d8fd</span></li>\n</ul><p>Web shell</p><ul>\n<li><span>99f571c07170250a84f0ae9de4179044df91244855d9b39978729933ea3d438f</span></li>\n<li><span>7ee22a7b028102bb22f0a41d41cd101d5956c1db0cfd157b22bf4128bd472a4f</span></li>\n<li><span>571067cc8f4224a4b80113b52672c7ac87e25dcdb0282a36a29a1784a24efa27</span></li>\n<li><span>8d8ccf24b785a33a9388043baecc4be247ad01182b87df3f8e425957ef73087c</span></li>\n<li><span>0e01c44e5a0615098d8c583930dd88dbd0ce6fe54b365c9f04d8b315a93f540a</span></li>\n<li><span>1dd423ff0106b15fd100dbc24c3ae9f9860a1fcdb6a871a1e27576f6681a0850</span></li>\n<li><span>04be76217500275335e82eb4c2c1588478f7a171efd7a0d9bdc6bbe83e315589</span></li>\n<li><span>3deb43cc864f2322d374541d99af79d87ad08abf81cd967862c554f1c0c5fdb6</span></li>\n<li><span>224ed1d3f8d7247989f812cb0accc1d1804197916c47d9600e6c4e9bef46a723</span></li>\n<li><span>9b16333820189e94b2368e87cba0a9642595d5be0f985a6351f1ad834f5cd11d</span></li>\n<li><span>bdcd0eefc62721814d0bd557285490aa99a4eb0425bf5204e6be16ec7ce93823</span></li>\n<li><span>3e56d049f23ed45a7034e5c74bad45cae11ce6d15189fa7bda6b8d120439c7cc</span></li>\n<li><span>834491282da22555f53b769ef8ad91a958f860c583ee5cb67b3f161caf19f85</span>4</li>\n</ul><h3 id=\"sec-30\">PerfectPioneer RAT C2 域名</h3><ul>\n<li><span>www.maui-cocktailbar[.]com</span></li>\n<li><span>ads-edge[.]com</span></li>\n<li><span>www.wkuyda[.]com</span></li>\n<li><span>www.thailisting[.]net</span></li>\n<li><span>www.yangon.it[.]com</span></li>\n</ul><p><strong>KUKURAT C2 域名</strong></p><ul>\n<li><span>www.cloudflacecdn[.]com</span></li>\n<li><span>www.police.gr[.]com</span></li>\n<li><span>www.investigationj6[.]com</span></li>\n</ul><p><strong>域名</strong></p><ul>\n<li><span>www.sacofficegov[.]com</span></li>\n</ul><p><strong>IP 地址</strong></p><ul>\n<li><span>27.254.164[.]212</span></li>\n<li><span>27.254.164[.]209</span></li>\n</ul><h2 id=\"sec-31\">其他资源</h2><ul>\n<li><a href=\"https://research.checkpoint.com/2025/ink-dragons-relay-network-and-offensive-operation/\">深入了解 Ink Dragon</a> – Checkpoint</li>\n<li><a href=\"https://www.checkpoint.com/cyber-hub/network-security/what-is-quic/\">什么是 QUIC？了解该协议</a> – Checkpoint</li>\n<li><a href=\"https://go.dev/doc/gc-guide\">Go 垃圾回收器指南</a> – go.dev</li>\n<li><a href=\"https://sanjeev41924.medium.com/http-3-challenges-to-security-and-possible-response-e81f429506e0\">HTTP/3——安全挑战及可能的应对措施</a> – Medium</li>\n</ul><h2 id=\"sec-32\">附录 A：PerfectPioneer RAT 其他功能分析</h2><h3 id=\"sec-33\">变体对比</h3><p>本节详细介绍了在 PerfectPioneer RAT 不同恢复变体中观察到的主要架构演进和功能修改。图 10 提供了一个全面的结构矩阵，概述了该恶意软件家族在活跃开发周期内新增或省略了哪些后渗透功能和通信协议。</p><figure><img src=\"/dailyinfo/media/6b9670ad3c530fd9.webp\" srcset=\"/dailyinfo/media/bfacc626ae056a6c.webp 720w, /dailyinfo/media/561a96f2592bf6ac.webp 1200w, /dailyinfo/media/6b9670ad3c530fd9.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Screenshot of a table listing different project paths with columns for network protocol, persistence, keylogger, screenshot, SOCKS5 proxy, and unique features. Each row represents a project path. The network protocols are HTTP/3 and HTTP/2, some with fallback options. Persistence, keylogger, screenshot, and SOCKS5 proxy features are indicated with check marks or Xs. Unique features include process injection, masquerade as a PDF file, and local HTTP server, among others.\" width=\"1254\" height=\"700\"><figcaption>图 10. 概述 PerfectPioneer RAT 各变体差异的结构矩阵。</figcaption></figure><h4 id=\"sec-34\">newhttp3 变体</h4><p>表 2 列出了 PerfectPioneer RAT 的 newhttp3 变体中已实现的命令。</p><table>\n<tbody>\n<tr>\n<td><strong>命令</strong></td>\n<td><strong>描述</strong></td>\n</tr>\n<tr>\n<td><span>file_info</span></td>\n<td>获取文件元数据</td>\n</tr>\n<tr>\n<td><span>file_list</span></td>\n<td>列出目录内容</td>\n</tr>\n<tr>\n<td><span>file_delete</span></td>\n<td>删除文件</td>\n</tr>\n<tr>\n<td><span>file_upload</span></td>\n<td>向受害者上传文件</td>\n</tr>\n<tr>\n<td><span>file_download</span></td>\n<td>从受害者下载文件</td>\n</tr>\n<tr>\n<td><span>file_download_chunk</span></td>\n<td>分块下载文件</td>\n</tr>\n<tr>\n<td><span>file_upload_status</span></td>\n<td>检查上传进度</td>\n</tr>\n<tr>\n<td><span>shell_execute</span></td>\n<td>执行 shell 命令</td>\n</tr>\n<tr>\n<td><span>process_info</span></td>\n<td>获取进程详情</td>\n</tr>\n<tr>\n<td><span>process_list</span></td>\n<td>列出正在运行的进程</td>\n</tr>\n<tr>\n<td><span>process_kill</span></td>\n<td>按 PID 终止进程</td>\n</tr>\n<tr>\n<td><span>process_kill_by_name</span></td>\n<td>按名称终止进程</td>\n</tr>\n<tr>\n<td><span>process_start</span></td>\n<td>启动新进程</td>\n</tr>\n<tr>\n<td><span>process_create_com</span></td>\n<td>通过 COM 创建进程</td>\n</tr>\n<tr>\n<td><span>process_inject_shellcode</span></td>\n<td>将 shellcode 注入进程</td>\n</tr>\n<tr>\n<td><span>window_list</span></td>\n<td>列出打开的窗口</td>\n</tr>\n<tr>\n<td><span>window_close</span></td>\n<td>关闭窗口</td>\n</tr>\n<tr>\n<td><span>window_minimize</span></td>\n<td>最小化窗口</td>\n</tr>\n<tr>\n<td><span>keylogger_start</span></td>\n<td>启动键盘记录器</td>\n</tr>\n<tr>\n<td><span>keylogger_stop</span></td>\n<td>停止键盘记录器</td>\n</tr>\n<tr>\n<td><span>keylogger_status</span></td>\n<td>获取键盘记录器状态</td>\n</tr>\n<tr>\n<td><span>keylogger_get_events</span></td>\n<td>检索捕获的按键输入</td>\n</tr>\n<tr>\n<td><span>keylogger_clear</span></td>\n<td>清除按键输入缓冲区</td>\n</tr>\n<tr>\n<td><span>screenshot_capture</span></td>\n<td>截取屏幕</td>\n</tr>\n<tr>\n<td><span>screenshot_cleanup</span></td>\n<td>清理屏幕截图文件</td>\n</tr>\n<tr>\n<td><span>resource_stats</span></td>\n<td>获取 CPU/内存统计信息</td>\n</tr>\n<tr>\n<td><span>resource_history</span></td>\n<td>获取资源使用历史</td>\n</tr>\n<tr>\n<td><span>socks5_proxy</span></td>\n<td>SOCKS5 代理管理</td>\n</tr>\n<tr>\n<td><span>update_check</span></td>\n<td>检查代理更新</td>\n</tr>\n<tr>\n<td><span>update_start</span></td>\n<td>启动代理更新</td>\n</tr>\n<tr>\n<td><span>update_status</span></td>\n<td>检查更新进度</td>\n</tr>\n<tr>\n<td><span>update_cancel</span></td>\n<td>取消待处理的更新</td>\n</tr>\n</tbody>\n</table><p><span>表 2. PerfectPioneer RAT newhttp3 变体中可用命令列表。</span></p><h4 id=\"sec-35\">RatAAkk-tt 变体</h4><p><strong>项目路径</strong>：<span>D:/proj/RatAAkk-tt/agent/</span></p><p><span>RatAAkk-tt</span> 变体似乎是该恶意软件最早的迭代版本之一。该变体严格依赖 HTTP/2 进行通信。其他主要架构差异包括缺少持久化机制、不具备进程注入能力、没有内置的内存或资源监控例程，以及没有自我更新引擎。不过，它包含一个名为 TerminalManagerV2 的专用组件，用作交互式持久 shell 会话管理器。</p><h4 id=\"sec-36\">PerfectRat 变体</h4><p><strong>项目路径</strong>：<span>D:/proj/PerfectRat/agent/</span></p><p>该恶意软件的这一变体是专门构建用于伪装成 PDF 文件的，很可能是通过网络钓鱼活动投递的。与 RatAAkk-tt 变体一样，它仅依赖 HTTP/2。新增功能包括用于本地权限提升的令牌冒充能力、加密模块以及直接控制桌面的功能。它不具备持久化、进程注入引擎模块和 SOCKS5 代理能力。</p><p>该变体的桌面控制功能实现了一个完整的交互式远程桌面，操作员可以查看屏幕并远程控制鼠标/键盘。</p><h4 id=\"sec-37\">rat_http3_ls 变体</h4><p><strong>项目路径</strong>：<span>D:/proj/http3/rat_http3_ls/agent/</span></p><p>该变体同样是构建用于伪装成 PDF 文件的，很可能是通过网络钓鱼活动投递的。该变体转为仅使用 HTTP/3 通信。它缺少其他变体中大多数事后利用功能，例如键盘记录器、屏幕截图捕获、SOCKS5 代理、进程注入和持久化。这些模块的缺失表明，它是一个精简、轻量的变体，仅为初始访问而设计。</p><h4 id=\"sec-38\">Pioneer 变体</h4><p><strong>项目路径</strong>：<span>D:/proj/http3/Pioneer/</span></p><p>该变体同样仅通过 HTTP/3 通信。与 rat_http3_ls 变体一样，它缺少键盘记录器、屏幕截图能力、SOCKS5 代理、进程注入和持久化。这使 Pioneer 变体保持轻量，适合用于初始感染和基本侦察。</p><p>该变体引入了 <span>isDangerousCommand</span>。</p><h4 id=\"sec-39\">rat_http3_cc 变体</h4><p><strong>项目路径：</strong><span>D:/proj/http3/rat_http3_cc/</span></p><p>该变体似乎是 Pioneer 开发分支的直接延续。它保留了 Pioneer 变体的所有基础功能，但引入了两项关键新增功能：</p><ul>\n<li>主动本地持久化机制</li>\n<li>嵌入式本地 HTTP 服务器</li>\n</ul><p>该本地 HTTP 服务器仅用于本地监控。它监听 56793 端口，并提供四个端点：</p><ol>\n<li><strong>/</strong> – API 发现：返回所有可用端点的列表</li>\n<li><strong>/info</strong> – 代理元数据：返回代理名称和变体</li>\n<li><strong>/health</strong> – 存活检查：返回 OK 状态及当前时间戳</li>\n<li><strong>/status</strong> – C2 connection status: returns dynamic JSON with an <span>isConnected</span> boolean indicating whether the agent is currently connected to the remote C2 server</li>\n</ol><h3 id=\"sec-40\">Commands Blocked by isDangerousCommand</h3><p>The <span>isDangerousCommand</span> foolproof mechanism uses a three-layered protection model to block categories and commands:</p><p><strong>Layer 1: Hard-Coded Keyword Filters</strong></p><p>This layer blocks a total of 41 explicit destructive, system modification and administrative commands attempted by the operator:</p><ul>\n<li><strong>Disk destruction:<br>\n</strong> Blocks commands that format, wipe or overwrite raw storage.<br>\nKeywords: <span>format, fdisk, mkfs, dd if=, diskpart, cipher /w:, sdelete, wipe, shred</span></li>\n</ul><ul>\n<li><strong>Recursive deletion:<br>\n</strong>Prevents aggressive, unconstrained file deletion commands.<br>\nKeywords: <span>rm -rf /, del /f /s /q c:</span></li>\n</ul><ul>\n<li><strong>System power actions:</strong><br>\nIntercepts commands that would shut down or restart the host, killing the agent's active session.<br>\nKeywords: <span>shutdown, reboot, halt, poweroff, init 0, init 6</span></li>\n</ul><ul>\n<li><strong>Denial of service (fork bomb):</strong><br>\nBlocks the classic Linux shell resource exhaustion string.<br>\nKeywords: <span>:(){ :|:&amp; };:</span></li>\n</ul><ul>\n<li><strong>Permissions and ownership tampering:</strong><br>\nBlocks broad access modifications targeting root structures.<br>\nKeywords: <span>chmod 777 /, chown root /</span></li>\n</ul><ul>\n<li><strong>User and group management:</strong><br>\nPrevents the rogue manipulation, addition, or removal of system accounts.<br>\nKeywords: <span>passwd, su -, sudo su, userdel, useradd, usermod, groupdel, groupadd</span></li>\n</ul><ul>\n<li><strong>Service disruption and process killing:</strong><br>\nFilters commands designed to terminate background tasks or wipe automated execution schedules.<br>\nKeywords: <span>crontab -r, systemctl stop, systemctl disable, service stop, killall, pkill -9, kill -9 1</span></li>\n</ul><ul>\n<li><strong>Firewall disruption:</strong><br>\nBlocks commands that attempt to flush or reset host-based firewall configurations.<br>\nKeywords: <span>iptables -F, ufw --force reset, netsh firewall</span></li>\n</ul><ul>\n<li><strong>Registry and boot configuration manipulation:</strong><br>\nIntercepts Windows-specific administrative tweaks that alter system states or delete sensitive hives.<br>\nKeywords: <span>reg delete, regedit, bcdedit</span></li>\n</ul><p><strong>Layer 2: Malicious Execution Pattern Filters </strong></p><p>This layer acts as a heuristic filter, blocking 16 common payload delivery shortcuts, obfuscation attempts and command chaining:</p><ul>\n<li><strong>Chained deletions:</strong><br>\nDetects attempts to append file removal commands onto logical execution operators.<br>\nPatterns: <span>&amp;&amp; rm, | rm, ; rm, &amp;&amp; del, | del, ; del</span></li>\n<li><strong>Direct device writes:</strong><br>\nBlocks direct outputs to raw Linux terminal paths or data redirection loops designed to suppress error messages.<br>\nPatterns: <span>&gt; /dev/, 2&gt;/dev/null</span></li>\n<li><strong>Download-and-execute pipelines:</strong><br>\nIntercepts classic script-staging methods that download and immediately pipe online payloads into a local shell.<br>\nPatterns: <span>curl | sh, wget | sh, curl | bash, wget | bash</span></li>\n<li><strong>Encoded PowerShell execution:</strong><br>\nBlocks attempts to run heavily obfuscated, Base64-encoded PowerShell payloads natively.<br>\nPatterns: <span>powershell -enc, powershell -e</span></li>\n<li><strong>Silent string echoing:</strong><br>\nPrevents script manipulation shortcuts or automated interactive prompting bypasses.<br>\nPatterns: <span>cmd /c echo, echo y |</span></li>\n</ul><p><strong>Layer 3: Core Directory Staging Protections</strong></p><p>The final layer serves as a localized guardrail. It explicitly drops any file removal commands (<span>rm, del, rmdir, rd</span>) if they are directed at one of 12 critical operating system paths required to keep the endpoint stable and online:</p><ul>\n<li><strong>Linux protected directories</strong>:<br>\n<span>/etc/, /bin/, /sbin/, /usr/bin/, /usr/sbin/, /boot/, /sys/, /proc/</span></li>\n<li><strong>Windows protected directories</strong>:<br>\n<span>c:\\windows, c:\\program files, c:\\program files (x86), c:\\system volume information</span></li>\n</ul><h3 id=\"sec-41\">PerfectPioneer RAT Persistence</h3><p>PerfectPioneer RAT establishes long-term persistence on infected hosts via two concurrent methods:</p><ol>\n<li><strong>Registry Run key</strong>: Directly writes the executable's absolute path to <span>HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run</span></li>\n<li><strong>Startup folder shortcut</strong>: Creates a <span>.lnk</span> shortcut file inside the logged-in user's Startup folder.</li>\n</ol><h2 id=\"sec-42\">Appendix B: Analysis of Additional KUKURAT Features</h2><h3 id=\"sec-43\">Heartbeat JSON Structure</h3><p>The KUKURAT agent communicates with its C2 server via a designated /heartbeat node. This mechanism verifies agent liveness and retrieves queued operator tasks. The structural JSON payload transmitted by the agent is shown in the following code.</p><table>\n\t\t\t\t\t<tbody><tr>\n\t\t\t\t<td>\n\t\t\t\t\t<p>1</p><p>2</p><p>3</p><p>4</p><p>5</p><p>6</p><p>7</p><p>8</p><p>9</p><p>10</p><p>11</p><p>12</p><p>13</p><p>14</p><p>15</p><p>16</p><p>17</p><p>18</p><p>19</p><p>20</p><p>21</p><p>22</p><p>23</p><p>24</p><p>25</p><p>26</p><p>27</p><p>28</p>\n\t\t\t\t</td>\n\t\t\t\t\t\t<td><p><span>{</span></p><p><span>&nbsp;&nbsp;</span><span>\"session_id\"</span><span>:</span><span> </span><span>\"&lt;session_id&gt;\"</span><span>,</span></p><p><span>&nbsp;&nbsp;</span><span>\"heartbeat_interval_min\"</span><span>:</span><span> </span><span>&lt;</span><span>int</span><span>&gt;</span><span>,</span><span> </span><span>// Minimum heartbeat interval</span></p><p><span>&nbsp;&nbsp;</span><span>\"heartbeat_interval_max\"</span><span>:</span><span> </span><span>&lt;</span><span>int</span><span>&gt;</span><span>,</span><span> </span><span>// Maximum heartbeat interval</span></p><p><span>&nbsp;&nbsp;</span><span>\"silent_mode_enabled\"</span><span>:</span><span> </span><span>&lt;</span><span>0</span><span>|</span><span>1</span><span>&gt;</span><span>,</span><span>\t</span><span>// Silent mode ON/OFF</span></p><p><span>&nbsp;&nbsp;</span><span>\"silent_remaining_seconds\"</span><span>:</span><span> </span><span>&lt;</span><span>int</span><span>&gt;</span><span>,</span><span> </span><span>// Remaining time for silent mode</span></p><p><span>&nbsp;&nbsp;</span><span>\"runtime_config\"</span><span>:</span><span> </span><span>{</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;</span><span>\"heartbeat_timeout_ms\"</span><span>:</span><span> </span><span>&lt;</span><span>int</span><span>&gt;</span><span>,</span><span> </span><span>// Maximum wait time for heartbeat response</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;</span><span>\"command_result_timeout_ms\"</span><span>:</span><span> </span><span>&lt;</span><span>int</span><span>&gt;</span><span>,</span><span> </span><span>// Maximum wait time for command result</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;</span><span>\"file_transfer_chunk_timeout_ms\"</span><span>:</span><span> </span><span>&lt;</span><span>int</span><span>&gt;</span><span>,</span><span> </span><span>// Timeout per file transfer chunk</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;</span><span>\"file_transfer_max_retries\"</span><span>:</span><span> </span><span>&lt;</span><span>int</span><span>&gt;</span><span>,</span><span> </span><span>// Max retries for file transfers</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;</span><span>\"file_transfer_retry_delay_ms\"</span><span>:</span><span> </span><span>&lt;</span><span>int</span><span>&gt;</span><span>,</span><span> </span><span>// Delay between file transfer retries</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;</span><span>\"heartbeat_retry_before_rereg\"</span><span>:</span><span> </span><span>&lt;</span><span>int</span><span>&gt;</span><span>,</span><span> </span><span>// Failed heartbeats before full re-registration</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;</span><span>\"command_worker_threads\"</span><span>:</span><span> </span><span>&lt;</span><span>int</span><span>&gt;</span><span>,</span><span> </span><span>// Number of concurrent command execution threads</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;</span><span>\"module_exec_timeout_ms\"</span><span>:</span><span> </span><span>&lt;</span><span>int</span><span>&gt;</span><span> </span><span>// Timeout for module execution calls</span></p><p><span>&nbsp;&nbsp;</span><span>}</span><span>,</span></p><p><span>&nbsp;&nbsp;</span><span>\"loaded_modules\"</span><span>:</span><span> </span><span>[</span><span>\"module1\"</span><span>,</span><span> </span><span>\"module2\"</span><span>,</span><span> </span><span>.</span><span>.</span><span>.</span><span>]</span><span>,</span><span> </span><span>// Loaded modules list</span></p><p><span>&nbsp;&nbsp;</span><span>\"module_states\"</span><span>:</span><span> </span><span>[</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;</span><span>{</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span>\"name\"</span><span>:</span><span> </span><span>\"module1\"</span><span>,</span><span> </span><span>// Module identifier</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span>\"alive\"</span><span>:</span><span> </span><span>&lt;</span><span>0</span><span>|</span><span>1</span><span>&gt;</span><span>,</span><span>\t</span><span>// Whether the module is active</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span>\"active_calls\"</span><span>:</span><span> </span><span>&lt;</span><span>int</span><span>&gt;</span><span>,</span><span>\t</span><span>// Number of currently executing calls</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span>\"unloading\"</span><span>:</span><span> </span><span>&lt;</span><span>0</span><span>|</span><span>1</span><span>&gt;</span><span>,</span><span>\t</span><span>// Whether the module is being unloaded</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span>\"last_error\"</span><span>:</span><span> </span><span>&lt;</span><span>int</span><span>&gt;</span><span>,</span><span>\t</span><span>// Last error code from module execution</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span>\"last_action_tick_ms\"</span><span>:</span><span> </span><span>&lt;</span><span>int</span><span>&gt;</span><span> </span><span>// Timestamp of last module action</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;</span><span>}</span></p><p><span>&nbsp;&nbsp;</span><span>]</span></p><p><span>}</span></p></td>\n\t\t\t\t\t</tr>\n\t\t\t\t</tbody></table><h3 id=\"sec-44\">Command Frame Architecture</h3><p>When issuing commands to KUKURAT, the C2 server pushes the following structural convention.</p><table>\n\t\t\t\t\t<tbody><tr>\n\t\t\t\t<td>\n\t\t\t\t\t<p>1</p><p>2</p><p>3</p><p>4</p><p>5</p><p>6</p>\n\t\t\t\t</td>\n\t\t\t\t\t\t<td><p><span>\"commands\"</span><span>:</span><span> </span><span>[</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;</span><span>{</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span>\"id\"</span><span>:</span><span> </span><span>\"&lt;command_id&gt;\"</span><span>,</span><span> </span><span>// Never parsed by the agent </span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span>\"type\"</span><span>:</span><span> </span><span>\"&lt;command_type&gt;\"</span><span>,</span><span> </span><span>// Command type</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span>\"params\"</span><span>:</span><span> </span><span>\"&lt;params_string&gt;\"</span><span> </span><span>// Parameters to be passed to the modules</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;</span><span>}</span></p></td>\n\t\t\t\t\t</tr>\n\t\t\t\t</tbody></table><p>Some of the commands in KUKURAT’s code are executed through modules, and others are used to modify KUKURAT’s configuration. Each module that is loaded and executed can receive additional parameters from the C2.</p><p>Table 3 lists the command types of KUKURAT, in the order that they appear in the code.</p><table>\n<tbody>\n<tr>\n<td><strong>Command Type</strong></td>\n<td><strong>Description</strong></td>\n</tr>\n<tr>\n<td><span>screenshot</span></td>\n<td>Loads and uses the <span>screenshot</span> module, using a hardcoded <span>capture</span> parameter that is passed to the module.</td>\n</tr>\n<tr>\n<td><span>portscan</span></td>\n<td>Loads and uses the <span>portscan</span> module.<br>\nAsync port scan in separate thread with progress reporting.</td>\n</tr>\n<tr>\n<td><span>hostscan</span></td>\n<td>Loads and uses the <span>hostscan</span> module.<br>\nRuns an async host scan in a separate thread.</td>\n</tr>\n<tr>\n<td><span>processlist</span></td>\n<td>Loads and uses the <span>processmanager</span> module. Used to perform process-related operations such as listing, killing and process injection.</td>\n</tr>\n<tr>\n<td><span>keylogger</span></td>\n<td>Loads and uses the <span>keylogger</span> module.</td>\n</tr>\n<tr>\n<td><span>filemanager</span></td>\n<td>Loads and uses the <span>filemanager</span> module. Used to perform file-related activities.</td>\n</tr>\n<tr>\n<td><span>file_download</span></td>\n<td>Downloads file from the infected host using the <span>filemanager</span> module.</td>\n</tr>\n<tr>\n<td><span>file_upload</span></td>\n<td>Uploads file to the infected host using the filemanager module.</td>\n</tr>\n<tr>\n<td><span>shell</span></td>\n<td>Loads and uses the <span>shell</span> module.<br>\nUsed to execute shell commands.</td>\n</tr>\n<tr>\n<td><span>execute_module</span></td>\n<td>Downloads and executes a BOF via a module named <span>BofLoader.dll</span>.<br>\nDownloads and executes any module named by the attacker.</td>\n</tr>\n<tr>\n<td><span>load_module</span></td>\n<td>Loads a module DLL into the agent.</td>\n</tr>\n<tr>\n<td><span>my_psexec</span></td>\n<td>Loads and uses a module named <span>MyPsExec.dll</span>.</td>\n</tr>\n<tr>\n<td><span>smb_brute</span></td>\n<td>Loads and uses a module named <span>SmbBrute.dll</span>.</td>\n</tr>\n<tr>\n<td><span>socks</span></td>\n<td>Loads and uses a module named <span>yuze_dll.dll</span>.</td>\n</tr>\n<tr>\n<td><span>set_heartbeat</span></td>\n<td>Adjusts heartbeat interval.</td>\n</tr>\n<tr>\n<td><span>set_runtime_config</span></td>\n<td>Updates runtime configuration.</td>\n</tr>\n<tr>\n<td><span>set_silent</span></td>\n<td>Enables silent mode for N hours.<br>\nSilent mode suppresses all command execution except <span>set_silent</span> itself.</td>\n</tr>\n<tr>\n<td><span>set_obfuscation</span></td>\n<td>Enables or disables network, registry, or file heuristic camouflage.</td>\n</tr>\n<tr>\n<td><span>com_exec</span></td>\n<td>Loads and uses a module named <span>ComExec.dll</span>.</td>\n</tr>\n<tr>\n<td><span>unload_module</span></td>\n<td>Unloads a specific module by name.</td>\n</tr>\n<tr>\n<td><span>unload_all_modules</span></td>\n<td>Unloads all loaded modules.</td>\n</tr>\n<tr>\n<td><span>exec</span></td>\n<td>Enables the attacker to execute a process via <span>CreateProcessA</span>. No module is necessary.<br>\nAppears only in HTTP/3 variant.</td>\n</tr>\n</tbody>\n</table><p><span>Table 3. KUKURAT command types.</span></p><h4 id=\"sec-45\">Obfuscating Commands as Hashes</h4><p>When KUKURAT communicates with the C2 it uses specific endpoint URLs. These endpoint URLs have a hardcoded hashed counterpart in the code which is used for C2 communication. For example, when KUKURAT sends a heartbeat to the C2, it uses the hashed counterpart of the <span>/heartbeat</span> endpoint URL (<span>/c8a4e192</span>), and sends the heartbeat to [<span>C2-domain]/c8a4e192</span>.</p><p>KUKURAT uses these hashed endpoint URLs to send the result of different operations for the C2. The malware code contains endpoint URLs which are not referenced in the base code of KUKURAT, but are likely referenced in some of the available modules. The endpoint URLs provide an indication of KUKURAT’s additional capabilities:</p><table>\n<tbody>\n<tr>\n<td><span>bypass_uac</span>\n<p><span>register</span></p>\n<p><span>heartbeat</span></p>\n<p><span>get_sysinfo</span></p>\n<p><span>port_scan</span></p>\n<p><span>screenshot</span></p></td>\n<td><span>proxy_start</span>\n<p><span>proxy_stop</span></p>\n<p><span>load_module</span></p>\n<p><span>unload_module</span></p>\n<p><span>download_module</span></p>\n<p><span>execute_command</span></p></td>\n<td><span>file_list</span>\n<p><span>file_download</span></p>\n<p><span>file_upload</span></p>\n<p><span>file_delete</span></p>\n<p><span>file_execute</span></p>\n<p><span>shell_execute</span></p></td>\n<td><span>process_list</span>\n<p><span>process_kill</span></p>\n<p><span>process_inject</span></p>\n<p><span>keylogger_start</span></p>\n<p><span>keylogger_stop</span></p>\n<p><span>powershell_execute</span></p>\n<p><span>elevate_privilege</span></p></td>\n</tr>\n</tbody>\n</table>","original","zhKind","translation","complete",false,"后门","钓鱼","数据泄露","红队","Palo Alto","Microsoft","Google","https://unit42.paloaltonetworks.com/custom-rats-target-southeast-asia-governments/","Unit 42",{"_242":243,"_244":-5},"changelogVersion","2026-10-01T08:00","release"]
