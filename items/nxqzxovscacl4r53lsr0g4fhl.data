[{"_1":2,"_3":4},"root",{"_5":117},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1795653643000,"id","nxqzxovscacl4r53lsr0g4fhl","title","Palo Alto Networks PAN-OS 提权漏洞 CVE-2026-43600 已被积极利用","originalTitle","Vulnérabilité dans Palo Alto Networks PAN-OS (25 novembre 2026)","summary","Palo Alto Networks PAN-OS 存在可导致权限提升的漏洞 CVE-2026-43600，厂商已确认其正在遭到积极利用。","reason","source",{"_72":116},"links",{"_60":115},"publishedAt","2026-11-25T00:00:00.000Z","discoveredAt","2026-11-25T16:01:03.993Z","timelineAt","category","vuln","tags",[112,73,113,114],"score",66,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body",{"_108":-5,"_60":109,"_110":-5,"_111":36},"outline",[81,82,83,84,85,86,87,88],"relatedStories",[77],"topics",[67,68,69],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fayLARPF8RIw","reportCount",1,"additionalSourceCount",0,{"_70":75,"_72":76},{"_70":30,"_72":74},{"_70":71,"_72":73},"slug","exploited","name","在野利用","漏洞披露","paloalto","Palo Alto Networks",{"_78":79,"_13":80},"publicId","a9a1dac9-2625-4a42-9c2a-230a4634f6c7","PAN-OS提权漏洞已被在野利用",{"_11":106,"_90":107,"_92":93},{"_11":104,"_90":105,"_92":93},{"_11":102,"_90":103,"_92":93},{"_11":100,"_90":101,"_92":93},{"_11":98,"_90":99,"_92":93},{"_11":96,"_90":97,"_92":93},{"_11":94,"_90":95,"_92":93},{"_11":89,"_90":91,"_92":93},"sec-8","text","Gestion détaillée du document","level",2,"sec-7","Documentation","sec-6","Solutions","sec-5","Résumé","sec-4","Systèmes affectés","sec-3","Risque","sec-2","Gestion du document","sec-1","Avis du CERT-FR","zh","<h2 id=\"sec-1\">Avis du CERT-FR</h2><p>Objet : Vulnérabilité dans Palo Alto Networks PAN-OS</p><h2 id=\"sec-2\">Gestion du document</h2><table>\n      <tbody>\n        <tr>\n          <th>Référence</th>\n          <td>CERTFR-2026-AVI-1621</td>\n        </tr>\n        <tr>\n          <th>Titre</th>\n          <td>Vulnérabilité dans Palo Alto Networks PAN-OS</td>\n        </tr><tr>\n            <th>Date de la première version</th><td>25 novembre 2026</td>\n          </tr>\n          <tr>\n            <th>Date de la dernière version</th><td>25 novembre 2026</td>\n          </tr><tr>\n          <th>Source(s)</th>\n          <td>Bulletin de sécurité Palo Alto Networks PAN-SA-2026-0015 du 25 novembre 2026<br></td>\n        </tr>\n      </tbody>\n    </table><p>Une gestion de version détaillée se trouve à la fin de ce document.</p><h2 id=\"sec-3\">Risque</h2><ul>\n          \n            <li>Élévation de privilèges</li>\n          \n        </ul><h2 id=\"sec-4\">Systèmes affectés</h2><ul>\n          \n            <li>PAN-OS versions 10.2.10-hx antérieures à 10.2.10-h45</li>\n          \n            <li>PAN-OS versions 10.2.13-hx antérieures à 10.2.13-h29</li>\n          \n            <li>PAN-OS versions 10.2.16-hx antérieures à 10.2.16-h14</li>\n          \n            <li>PAN-OS versions 10.2.18-hx antérieures à 10.2.18-h15</li>\n          \n            <li>PAN-OS versions 10.2.7-hx antérieures à 10.2.7-h41</li>\n          \n            <li>PAN-OS versions 11.1.10-hx antérieures à 11.1.10-h38</li>\n          \n            <li>PAN-OS versions 11.1.13-hx antérieures à 11.1.13-h18</li>\n          \n            <li>PAN-OS versions 11.1.16-hx antérieures à 11.1.16-h6</li>\n          \n            <li>PAN-OS versions 11.1.4-hx antérieures à 11.1.4-h40</li>\n          \n            <li>PAN-OS versions 11.1.6-hx antérieures à 11.1.6-h42</li>\n          \n            <li>PAN-OS versions 11.1.7-hx antérieures à 11.1.7-h14</li>\n          \n            <li>PAN-OS versions 11.2.10-hx antérieures à 11.2.10-h19</li>\n          \n            <li>PAN-OS versions 11.2.13-hx antérieures à 11.2.13-h6</li>\n          \n            <li>PAN-OS versions 11.2.16-hx antérieures à 11.2.16-h3</li>\n          \n            <li>PAN-OS versions 11.2.4-hx antérieures à 11.2.4-h25</li>\n          \n            <li>PAN-OS versions 11.2.7-hx antérieures à 11.2.7-h25</li>\n          \n            <li>PAN-OS versions 12.1.10-hx antérieures à 12.1.10-h6</li>\n          \n            <li>PAN-OS versions 12.1.4-hx antérieures à 12.1.4-h15</li>\n          \n            <li>PAN-OS versions 12.1.7-hx antérieures à 12.1.7-h15</li>\n          \n            <li>PAN-OS versions 12.2.4-hx antérieures à 12.2.4-h3</li>\n          \n        </ul><h2 id=\"sec-5\">Résumé</h2><p>Une vulnérabilité a été découverte dans Palo Alto Networks PAN-OS. Elle permet à un attaquant de provoquer une élévation de privilèges.</p><p>Palo Alto Networks indique que la vulnérabilité CVE-2026-43600 est activement exploitée.</p><h2 id=\"sec-6\">Solutions</h2><p>Se référer au bulletin de sécurité de l'éditeur pour l'obtention des correctifs (cf. section Documentation).</p><h2 id=\"sec-7\">Documentation</h2><ul>\n          \n          \n            <li>\n              <p>Bulletin de sécurité Palo Alto Networks PAN-SA-2026-0015 du 25 novembre 2026</p>\n              <a href=\"https://security.paloaltonetworks.com/PAN-SA-2026-0015\">https://security.paloaltonetworks.com/PAN-SA-2026-0015</a>\n            </li>\n          \n\n          \n          \n\n          \n            <li>\n              <p>Référence CVE CVE-2026-46300</p>\n              <a href=\"https://www.cve.org/CVERecord?id=CVE-2026-46300\">https://www.cve.org/CVERecord?id=CVE-2026-46300</a>\n            </li>\n          \n        </ul><h2 id=\"sec-8\">Gestion détaillée du document</h2><table>\n          <thead>\n            <tr>\n              <th>Date</th>\n              <th>Description</th>\n            </tr>\n          </thead>\n          <tbody><tr>\n              <td>25 novembre 2026</td>\n              <td>Version initiale</td>\n            </tr></tbody>\n        </table>","zhKind","complete","漏洞","补丁","Palo Alto","https://www.cert.cyber.gouv.fr/avis/CERTFR-2026-AVI-1621/","CERT-FR",{"_118":119,"_120":-5},"changelogVersion","2026-10-01T08:00","release"]
