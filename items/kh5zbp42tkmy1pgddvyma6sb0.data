[{"_1":2,"_3":4},"root",{"_5":117},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1793667630000,"id","kh5zbp42tkmy1pgddvyma6sb0","title","zkLink 遭攻击损失约 78.3 万美元，Arbitrator 合约验证逻辑被绕过","originalTitle","一鱼多吃 —— zkLink 被盗 78 万美元事件解析","summary","跨链协议 zkLink 于 2026 年 10 月 29 日遭攻击，损失约 78.3 万美元。","reason","文章拆解了伪造批次根、复用瞬态存储与绕过提现证明的完整攻击链，并给出可迁移到同类跨链中继项目的代码审查要点。","source",{"_75":116},"links",{"_108":115},"publishedAt","2026-10-30T11:20:00.000Z","discoveredAt","2026-10-30T14:45:15.982Z","timelineAt","category","activity","tags",[76,78,111,112,113,114],"score",81,"selected",true,"channel","news","story",{"_86":87,"_13":88},"x","readingMode","full","author","body",{"_61":107,"_108":-5,"_109":108,"_110":37},"outline",[89,90,91,92,93],"relatedStories",[85],"topics",[68,69,70,71,72],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","f2r0IzO-GIEo","reportCount",1,"additionalSourceCount",0,{"_73":83,"_75":84},{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","attack","name","攻击活动","exploited","在野利用","black-market","数据窃取与黑产","ransomware","勒索软件","crypto","密码学",{"_86":87,"_13":88},"publicId","48bdde86-f4a8-4ed2-915b-204316592480","zkLink跨链协议遭攻击损失78.3万美元",{"_11":105,"_95":106,"_97":98},{"_11":103,"_95":104,"_97":98},{"_11":101,"_95":102,"_97":98},{"_11":99,"_95":100,"_97":98},{"_11":94,"_95":96,"_97":98},"sec-5","text","总结","level",2,"sec-4","攻击步骤分析","sec-3","根本原因","sec-2","前置知识","sec-1","背景","<p>原创 <span>慢雾安全团队</span> <span>2026-10-30 19:20</span> <span>中国香港</span></p><p><img src=\"/dailyinfo/media/ed9412b83cf5ac0b.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>Arbitrator 合约的任意外部调用与瞬态存储未清理，导致验证逻辑可被绕过。</p><p><b><b><b><span><span>作者：九九</span></span></b></b></b></p><p><b><b><b><span><span>编辑：77</span></span></b></b></b></p><h2 id=\"sec-1\"><b><b><b><span><span>背景</span></span></b></b></b></h2><p><b><b><b><span><span>2026 年 10 月 29 日，知名跨链协议 zkLink 遭到攻击，损失约 78.3 万美元。以下是慢雾安全团队针对本次攻击事件的具体分析：</span></span></b></b></b></p><p><b><b><b><span><span><img width=\"624\" height=\"352\" src=\"/dailyinfo/media/81d30a210fe0a043.webp\" loading=\"lazy\" decoding=\"async\"></span></span></b></b></b></p><h2 id=\"sec-2\"><b><span><span>前置知识</span></span></b></h2><p><b><b><b><span><span>zkLink 是一个多链 zk 汇总(rollup) 协议。在以太坊上，ZkLink 合约(0x5fd9f73286b7e8683bab45019c94553b93e015cf) 承担 L1 消息服务的角色，同时持有 ETH 金库；与之配套的 L1ERC20Bridge (0xad16edcf7deb7e90096a259c81269d811544b6b6) 持有 ERC-20 金库。</span></span></b></b></b></p><p><b><b><b><span><span>提现的信用来源是\"批次根\"。L2 上每一笔提现都会生成一条 L2→L1 日志，同一个批次的日志组成一棵 Merkle 树。批次在 L2 执行后，其日志根&nbsp;</span></span><span><span>l2LogsRootHashes[batchNumber]</span></span><span><span>&nbsp;会被同步到 L1 的 ZkLink 合约。用户在 L1 提现时提交提现消息和 Merkle 证明，ZkLink 用存储中的根计算证明，通过后才放款。换句话说，</span></span><span>根是真的，消息才可能是真的；根若是伪造的，任意消息都能\"证明\"为已发生</span><span><span>。ZkLink 还用&nbsp;</span></span><span><span>totalBatchesExecuted</span></span><span><span>&nbsp;记录已经执行到的批次号，验证时会要求&nbsp;</span></span><span><span>_batchNumber &lt;= totalBatchesExecuted</span></span><span><span>。</span></span></b></b></b></p><p><b><b><b><span><span>跨链消息并不由各链直接收发，而是通过网关合约转发。以太坊一侧是 EthereumGateway (0x83bc7394738a7a084081af22eec0051908c0055c)，Linea 一侧是 LineaL1Gateway (0x803460416c2682ac54fccf03ef77b10a12f2809b)。这些网关由 Arbitrator 合约 (0x1ee09a2caa0813a5183f90f5a6d0e4871f4c6002) 统一协调。</span></span></b></b></b></p><p><b><b><b><span><span>Arbitrator 合约的职责是认领并转发。受信任的 relayer 调用&nbsp;</span></span><span><span>claimMessage</span></span><span><span>&nbsp;函数，Arbitrator 合约会先用 relayer 指定的源链消息服务去认领一条跨链消息，再把消息转发给目标链的网关。为了让\"转发内容\"与\"真正认领到的消息\"一致，Arbitrator 在认领过程中会通过&nbsp;</span></span><span><span>receiveMessage</span></span><span><span>&nbsp;函数回调把消息哈希写入 transient storage，</span></span><span><span>claimMessage</span></span><span><span>&nbsp;函数随后会检查比对这一声明。</span></span></b></b></b></p><p><b><b><b><span><span>transient storage（瞬态存储 EIP-1153）是 Solidity 0.8.24 引入的特性，作用域是整笔交易，而不是单次函数调用：同一交易内后续发起的调用，可以读到前面写入的值，直到交易结束才清除。</span></span></b></b></b></p><p><b><b><b><span><span>本次攻击的入口是 SyncL2TxHashRelayer 合约 (</span></span><span><span>0x0fdc28e64772a70109d10fd068f859cfa7dea2c6)</span></span><span><span>，其函数&nbsp;</span></span><span><span>claimPrimaryChainSyncL2TxHashMessage</span></span><span><span>&nbsp;没有任何访问控制，本质上只是一个把调用者参数原样转交给&nbsp;</span></span><span><span>Arbitrator.claimMessage</span></span><span><span>&nbsp;的辅助合约。它能成功调用&nbsp;</span></span><span><span>claimMessage</span></span><span><span>&nbsp;函数，说明它本身在 Arbitrator 合约中登记为 relayer。</span></span></b></b></b></p><h2 id=\"sec-3\"><b><b><b><span><span>根本原因</span></span></b></b></b></h2><p><b><b><b><span><span>本次攻击的核心漏洞位于 Arbitrator 合约的&nbsp;</span></span><span><span>claimMessage</span></span><span><span>&nbsp;函数。该函数同时负责\"认领\"和\"转发\"，但在两处信任假设上都出现了偏差。</span></span></b></b></b></p><ul></ul><pre><code><span><span>function</span>&nbsp;<span>claimMessage</span>(</span></code><br><code><span>&nbsp; &nbsp; address _sourceChainCanonicalMessageService,</span></code><br><code><span>&nbsp; &nbsp; bytes calldata _sourceChainClaimCallData,</span></code><br><code><span>&nbsp; &nbsp; IL1Gateway _sourceChainL1Gateway,</span></code><br><code><span>&nbsp; &nbsp; uint256 _receiveValue,</span></code><br><code><span>&nbsp; &nbsp; bytes calldata _receiveCallData,</span></code><br><code><span>&nbsp; &nbsp; bytes calldata _forwardParams</span></code><br><code><span>) external payable nonReentrant onlyRelayer {</span></code><br><code><span>&nbsp; &nbsp; assembly {&nbsp;<span>tstore</span>(claiming.<span>slot</span>,&nbsp;<span>1</span>) }</span></code><br><code><span><br></span></code><br><code><span>&nbsp; &nbsp;&nbsp;<span>// 利用点一：Arbitrator 以自身身份，对 relayer 指定的任意地址执行任意 calldata</span></span></code><br><code><span>&nbsp; &nbsp;&nbsp;<span>Address</span>.<span>functionCall</span>(_sourceChainCanonicalMessageService, _sourceChainClaimCallData);</span></code><br><code><span><br></span></code><br><code><span>&nbsp; &nbsp; bytes32 _finalizeMessageHash;</span></code><br><code><span>&nbsp; &nbsp; assembly { _finalizeMessageHash :=&nbsp;<span>tload</span>(finalizeMessageHash.<span>slot</span>) }</span></code><br><code><span><br></span></code><br><code><span>&nbsp; &nbsp;&nbsp;<span>// 利用点二：比对的是 transient storage 里的旧值，不要求本次调用真的发生过 receiveMessage</span></span></code><br><code><span>&nbsp; &nbsp;&nbsp;<span>require</span>(</span></code><br><code><span>&nbsp; &nbsp; &nbsp; &nbsp; _finalizeMessageHash ==&nbsp;<span>keccak256</span>(abi.<span>encode</span>(_sourceChainL1Gateway, _receiveValue, _receiveCallData)),</span></code><br><code><span>&nbsp; &nbsp; &nbsp; &nbsp;&nbsp;<span>\"Incorrect finalize data\"</span></span></code><br><code><span>&nbsp; &nbsp; );</span></code><br><code><span><br></span></code><br><code><span>&nbsp; &nbsp;&nbsp;<span>// ... 后续按分支把消息转发给目标网关</span></span></code><br><code><span>}</span></code><br></pre><p><b><b><b><span><span>第一个利用点是\"外部执行内容\"完全由 relayer 决定。</span></span><span><span>_sourceChainCanonicalMessageService</span></span><span><span>&nbsp;和&nbsp;</span></span><span><span>_sourceChainClaimCallData</span></span><span><span>&nbsp;都是 relayer 传入的参数，Arbitrator 合约会以自身身份把它们进行调用执行。正常使用时，这里是一个源链消息服务的认领接口；但当攻击者把目标换成 Arbitrator 合约中已注册的网关时，实际执行就可以调用网关中带&nbsp;</span></span><span><span>onlyArbitrator</span></span><span><span>&nbsp;修饰器检查的函数。</span></span></b></b></b></p><p><b><b><b><span><span>第二个利用点是\"一致性校验\"由于瞬态存储的特性而被绕过。校验读取的是 transient storage 中的&nbsp;</span></span><span><span>finalizeMessageHash</span></span><span><span>，而该槽位在同一交易内从不清零，也不会因为一次调用结束而失效。只要同一交易里先发生一次真实认领、把该槽位写好，后面的第二次&nbsp;</span></span><span><span>claimMessage</span></span><span><span>&nbsp;就能复用它通过校验，哪怕第二次调用根本没有认领任何消息。攻击者只需要让两次调用的&nbsp;</span></span><span><span>(gateway, value, callData)</span></span><span><span>&nbsp;声明完全一致即可。也就是说，校验通过证明的是\"本交易内曾经发生过一次与这些声明匹配的认领\"，而不是\"本次调用认领了这条消息\"。</span></span></b></b></b></p><p><b><b><b><span><span>那为什么能伪造提款用的批次根？因为 Arbitrator 合约通过外部调用把目标指向 EthereumGateway 后，调用了&nbsp;</span></span><span><span>sendMessage</span></span><span><span>&nbsp;函数：</span></span></b></b></b></p><ul></ul><pre><code><span><span><span>function</span></span><span><span>sendMessage</span></span><span>(</span><span><span>uint256 _value, bytes calldata _callData, bytes calldata</span></span><span>)&nbsp;</span><span><span>external</span></span><span><span>payable</span></span><span><span>onlyArbitrator</span></span>{</span></code><br><code><span>&nbsp; &nbsp;&nbsp;<span>require</span>(msg.value == _value,&nbsp;<span>\"Invalid value\"</span>);</span></code><br><code><span>&nbsp; &nbsp; (<span>bool</span>&nbsp;success, ) = ZKLINK.call{value: _value}(_callData); &nbsp;&nbsp;<span>// 把 calldata 原样转发给 ZkLink</span></span></code><br><code><span>&nbsp; &nbsp;&nbsp;<span>require</span>(success,&nbsp;<span>\"Call zkLink failed\"</span>);</span></code><br><code><span>}</span></code><br></pre><p><b><b><b><span><span>这个函数只检查调用者是否为 Arbitrator 合约，然后把 calldata 原样转给 ZkLink 合约。由于发起调用的确实是 Arbitrator 合约，检查自然通过。攻击者把&nbsp;</span></span><span><span>_callData</span></span><span><span>&nbsp;填成&nbsp;</span></span><span><span>syncBatchRoot(116409, 伪造根, 0)</span></span><span><span>：</span></span></b></b></b></p><ul></ul><pre><b><b><b><code><span><span>function</span>&nbsp;<span>syncBatchRoot</span>(<span>uint256 _batchNumber, bytes32 _l2LogsRootHash, uint256 _forwardEthAmount</span>) external payable onlyGateway { &nbsp; &nbsp;<span>// 只检查调用者是网关，不验证任何批次证明</span></span></code><br><code><span><br></span></code><br><code><span>&nbsp; &nbsp;&nbsp;<span>require</span>(msg.<span>value</span>&nbsp;== _forwardEthAmount,&nbsp;<span>\"Invalid forward amount\"</span>);</span></code><br><code><span><br></span></code><br><code><span>&nbsp; &nbsp;&nbsp;<span>if</span>&nbsp;(_batchNumber &gt; totalBatchesExecuted) {</span></code><br><code><span>&nbsp; &nbsp; &nbsp; &nbsp; totalBatchesExecuted = _batchNumber;</span></code><br><code><span>&nbsp; &nbsp; }</span></code><br><code><span><br></span></code><br><code><span>&nbsp; &nbsp; l2LogsRootHashes[_batchNumber] = _l2LogsRootHash; &nbsp;&nbsp;<span>// 直接覆盖该批次的日志根</span></span></code><br><code><span><br></span></code><br><code><span>&nbsp; &nbsp; emit&nbsp;<span>SyncBatchRoot</span>(_batchNumber, _l2LogsRootHash, _forwardEthAmount);</span></code><br><code><span>}</span></code><br></b></b></b></pre><p><span><span>ZkLink 合约的&nbsp;</span></span><span><span>onlyGateway</span></span><span><span>&nbsp;函数要求调用者是它自己配置的网关，而转发这次调用的正是 EthereumGateway 合约，检查可以通过。于是攻击者用当时尚未执行的下一个批次号 116409，配上一个自己构造的日志根，把&nbsp;</span></span><span><span>l2LogsRootHashes[116409]</span></span><span><span>&nbsp;从零改写成了伪造值，并顺带把&nbsp;</span></span><span><span>totalBatchesExecuted</span></span><span><span>&nbsp;从 116408 推到了 116409。根被伪造之后，Merkle 证明必然通过，提现消息的内容因此可以被任意构造。至此，就能用伪造的证明进行提款。</span></span></p><h2 id=\"sec-4\"><span><span>攻击步骤分析</span></span></h2><p><b><b><b><span><span>攻击交易：0x4f3c23e75b9134e8cae5a462550daad42fbbc19242567fcc34c0a035e297462c&nbsp;</span></span></b></b></b></p><p><b><b><b><span><span>攻击者 EOA：0xaca0655a11200a80d33d0e48786317304cde5718&nbsp;</span></span></b></b></b></p><p><b><b><b><span><span>攻击合约：0xd5f162b68a0281686e8dc76db8d67d2f3e6aff07</span></span></b></b></b></p><p><b><b><b><span><span>1. 攻击合约首先调用 ZkLink 合约的&nbsp;</span></span><span><span>totalBatchesExecuted()</span></span><span><span>函数来查询当时已经执行到的最后一个批次，再把这个值加一，就能作为本次要伪造的批次号&nbsp;</span></span><span><span>116409</span></span><span><span>。</span></span></b></b></b></p><p><b><b><b><span><span>这是因为后续的提现证明要求批次号不大于&nbsp;</span></span><span><span>totalBatchesExecuted</span></span><span><span>，所以伪造出来的批次必须先被登记为\"已执行\"。</span></span></b></b></b></p><p><b><b><b><span><span><img width=\"624\" height=\"172\" src=\"/dailyinfo/media/c4dc99277a9059f0.webp\" loading=\"lazy\" decoding=\"async\"></span></span></b></b></b></p><p><b><b><b><span><span>而&nbsp;</span></span><span><span>syncBatchRoot</span></span><span><span>&nbsp;函数接受任意批次号与任意根，又会顺手把&nbsp;</span></span><span><span>totalBatchesExecuted</span></span><span><span>&nbsp;推进到该批次。只要能让网关发起这次调用，哪个批次算\"已执行\"就由攻击者决定。</span></span></b></b></b></p><p><b><b><b><span><span><img width=\"624\" height=\"265\" src=\"/dailyinfo/media/01f0d0ab6a024aae.webp\" loading=\"lazy\" decoding=\"async\"></span></span></b></b></b></p><p><b><b><b><span><span>2. 攻击者先执行一次真实的 Linea 跨链认领，通过 SyncL2TxHashRelayer 合约调用&nbsp;</span></span><span><span>Arbitrator.claimMessage</span></span><span><span>，提交了一条真实的 Linea 消息证明，其中\"源链消息服务地址\"指定为 Linea Rollup，附上一条&nbsp;</span></span><span><span>claimMessageWithProof</span></span><span><span>&nbsp;的证明。这条消息是攻击者自己在 Linea 上发出的 Linea→Ethereum 跨链消息，接收方是 LineaL1Gateway，内容是让它把一条&nbsp;</span></span><span><span>syncL2TxHash(_l2TxHash,_primaryChainL2TxHash)</span></span><span><span>&nbsp;转发给目标网关。</span></span></b></b></b></p><p><b><b><b><span><span>Linea Rollup 验证证明通过后会回调 LineaL1Gateway，后者再回调 Arbitrator 合约的&nbsp;</span></span><span><span>receiveMessage&nbsp;</span></span><span><span>函数，把这条消息的哈希写进 transient storage 的&nbsp;</span></span><span><span>finalizeMessageHash</span></span><span><span>。</span></span><span><span>claimMessage</span></span><span><span>&nbsp;函数随后正是拿这个值做比对，也就是说，攻击者用一次真实、无害的认领流程，把校验值 finalizeMessageHash 拿到了手，并让它一直留在这笔交易里。</span></span></b></b></b></p><p><b><b><b><span><span><img width=\"624\" height=\"261\" src=\"/dailyinfo/media/d945e26d6ee08ba7.webp\" loading=\"lazy\" decoding=\"async\"></span></span></b></b></b></p><p><b><b><b><span><span>SyncL2TxHashRelayer 合约在 Arbitrator 合约中被登记为 relayer，且 claimPrimaryChainSyncL2TxHashMessage 函数没有任何访问控制，任何地址都能借它的身份调用 Arbitrator 合约的&nbsp;</span></span><span><span>claimMessage&nbsp;</span></span><span><span>函数；而&nbsp;</span></span><span><span>claimMessage</span></span><span><span>&nbsp;函数又允许 relayer 自行指定源链消息服务地址。此外，这次真实认领写入的校验值会一直留在这笔交易的 transient storage 中，直到交易结束。</span></span></b></b></b></p><p><b><b><b><span><span><img width=\"624\" height=\"261\" src=\"/dailyinfo/media/33d84f4c16cc2c91.webp\" loading=\"lazy\" decoding=\"async\"></span></span></b></b></b></p><p><b><b><b><span><span>3. 紧接着，攻击合约再次调用同一个 relayer，只改了两处参数：源链消息服务从 Linea Rollup 换成 Arbitrator 合约自己注册的 EthereumGateway，_sourceChainClaimCallData 换成&nbsp;</span></span><span><span>sendMessage(0, syncBatchRoot(116409, 0x1934a1...a8, 0), \"\")</span></span><span><span>。</span></span></b></b></b></p><p><b><b><b><span><img src=\"/dailyinfo/media/55b0a7282c5a6dbe.webp\" loading=\"lazy\" decoding=\"async\"></span></b></b></b></p><p><b><b><b><span><span>其余参数——源链网关、接收金额、声明的接收 calldata、转发参数——与上一步逐字节相同，而这些参数反而正是用来和 finalizeMessageHash 进行检查的值，因为&nbsp;</span></span><p><span><span>finalizeMessageHash</span></span><span><span>&nbsp;的值是保存在瞬态存储中的，在同一交易内从不清零，也没有绑定\"本次调用是否真的认领过消息\"，同时外部调用的目标地址和 calldata 并不会参与检查，上一次认领留下的值因而可以被第二次调用直接复用；而&nbsp;</span></span><span><span>Address.functionCall</span></span><span><span>&nbsp;又先让 Arbitrator 合约以自身身份执行了攻击者指定的任意调用。这是本次攻击的核心缺陷。</span></span></p><p><span><span><img width=\"624\" height=\"408\" src=\"/dailyinfo/media/2bd86a0cb5839d77.webp\" loading=\"lazy\" decoding=\"async\"></span></span></p><p><span><span>也就是说，这次调用根本没有认领任何消息，但 claimMessage 函数的检查依然通过了，并且攻击者外部调用 EthereumGateway 合约的 sendMessage 函数已经在检查之前执行完毕。</span></span></p><p><span><span>4. 当 Arbitrator 调用 EthereumGateway 合约的&nbsp;</span></span><span><span>sendMessage&nbsp;</span></span><span><span>函数时，由于 calldata 正是攻击者填入的&nbsp;</span></span><span><span>syncBatchRoot(116409, 伪造根, 0)</span></span><span><span>，于是 ZkLink 把伪造根当作本批次的日志根记录了下来。</span></span></p><p><span><span><img width=\"624\" height=\"117\" src=\"/dailyinfo/media/0c16122fa80825cf.webp\" loading=\"lazy\" decoding=\"async\"></span></span></p><p><span><span>从链上结果可以看到：ZkLink 发出&nbsp;</span></span><span><span>SyncBatchRoot(116409, 0x1934a1c3…)</span></span><span><span>&nbsp;事件，存储里的&nbsp;</span></span><span><span>l2LogsRootHashes[116409]</span></span><span><span>&nbsp;从零变成攻击者构造的根，</span></span><span><span>totalBatchesExecuted</span></span><span><span>&nbsp;也从 116408 变成 116409。到此，伪造的根已经\"合法\"地进入了协议账本。两次调用都会转发一次&nbsp;</span></span><span><span>syncL2TxHash</span></span><span><span>，把&nbsp;</span></span><span><span>l2TxHashMap[0x2575…]</span></span><span><span>&nbsp;写成&nbsp;</span></span><span><span>0xe9ec…</span></span><span><span>，这一步本身无害，只是复用校验值带来的副产物。</span></span></p><p><span><span>因为&nbsp;</span></span><span><span>EthereumGateway.sendMessage</span></span><span><span>&nbsp;只校验调用者是否是 Arbitrator 合约，就把 calldata 原样转给 ZkLink；</span></span><span><span>ZkLink.syncBatchRoot</span></span><span><span>&nbsp;又只校验调用者是否是网关合约，不校验任何批次证明。两层\"只认调用者、不认内容\"的检查都通过，让伪造的根被当成合法根写入。</span></span></p><p><span><span><img width=\"624\" height=\"105\" src=\"/dailyinfo/media/de6799c9abfc538d.webp\" loading=\"lazy\" decoding=\"async\"></span></span></p><p><span><span><img width=\"533\" height=\"232\" src=\"/dailyinfo/media/f34547cbbb8cd3f1.webp\" loading=\"lazy\" decoding=\"async\"></span></span></p><p><span><span>5. 根被改写之后，只要提现消息能对着这个根算出证明，就能通过验证。攻击合约连续发起 12 次最终提款调用，全部指向批次 116409：先是一条 ETH 提现，随后是 11 条 ERC-20 提现。每条消息都带 4 个 Merkle 节点，这些节点是攻击者按自己伪造的根构造的，所以证明必然成立通过。</span></span></p><p><span><span><img width=\"624\" height=\"373\" src=\"/dailyinfo/media/b1d06348644bfa0d.webp\" loading=\"lazy\" decoding=\"async\"></span></span></p><p><span><span><img width=\"624\" height=\"339\" src=\"/dailyinfo/media/dbedc309b54f3339.webp\" loading=\"lazy\" decoding=\"async\"></span></span></p><p><span><span>ETH 提现由 ZkLink 合约直接处理，11 条 ERC-20 提现由 L1ERC20Bridge 处理。证明通过后，代币直接从桥合约转给攻击者 EOA。</span></span></p><p><span><span>两个合约虽然都记录了\"这条消息已提现\"，但这个标记只能防止重复提交，无法识别消息本身从未在 L2 发生过。</span></span></p><p><span><span>提现合约只验证\"这条消息是否包含在存储的批次根对应的树中\"，不验证根本身是否来自真实的 L2 执行。根一旦被伪造，任意消息都能算出合法的证明。</span></span></p><p><span><span><img width=\"624\" height=\"307\" src=\"/dailyinfo/media/50639e495b438411.webp\" loading=\"lazy\" decoding=\"async\"></span></span></p></b></b></b></p><h2 id=\"sec-5\"><b><span><span>总结</span></span></b></h2><p><b><b><b><span><span>本次攻击的核心问题在于 Arbitrator 合约的任意外部调用加上未清理的瞬态存储可被直接复用验证。</span></span><span>Arbitrator.claimMessage</span><span>&nbsp;一方面允许 relayer 指定任意目标与 calldata，并以自身身份进行任意外部调用；另一方面，它唯一的最终性校验只跟 transient storage 中保存的残留值比较，既不清零，也不检查本次调用是否真的完成了认领。攻击者先用一次真实认领写下校验值，再用第二次 claim 复用该值，让 Arbitrator 替自己调用了网关的&nbsp;</span><span>onlyArbitrator</span><span>&nbsp;接口，最终把伪造的批次根写入 ZkLink，桥内资产随之被\"证明\"为可提取。</span></b></b></b></p><p><b><b><b><span><span>修复应从三个层次入手。第一，</span></span><span><span>claimMessage</span></span><span><span>&nbsp;必须在&nbsp;</span></span><span><span>Address.functionCall</span></span><span><span>&nbsp;之前把&nbsp;</span></span><span><span>finalizeMessageHash</span></span><span><span>&nbsp;清零，调用后要求它非零且等于本次声明，或使用每次调用递增的 nonce 加以绑定，确保校验值只能由本次调用中的&nbsp;</span></span><span><span>receiveMessage</span></span><span><span>&nbsp;写入。第二，对&nbsp;</span></span><span><span>_sourceChainCanonicalMessageService</span></span><span><span>&nbsp;增加白名单，禁止把 Arbitrator 合约自身注册的网关当作\"源链消息服务\"；同时不要将 dev 辅助合约登记为 relayer，或至少为其补上访问控制，避免任意地址间接获得调用&nbsp;</span></span><span><span>claimMessage</span></span><span><span>&nbsp;的能力。第三，</span></span><span><span>ZkLink.syncBatchRoot</span></span><span><span>&nbsp;应拒绝覆盖已经存在的批次根，并在网关侧或消息层增加独立证明，使批次根的更新不能仅凭\"调用者是网关\"生效。</span></span></b></b></b></p><p><b><b><b><span><span>慢雾安全团队建议在审查同类跨链中继项目的代码时，建议重点检查四点：</span></span><span><span>transient storage 是否在每次调用前重置、校验值是否与实际执行的参数来自同一来源、\"受信任调用者\"是否可能被任意用户间接借用（例如通过公开的 helper 或 relayer）以及更新批次根时是否做了独立校验。这类问题往往不在最显眼的资产转移函数里，而在中间那层\"看起来只是转发\"的合约中。</span></span></b></b></b></p><p><span><strong><span>往期回顾</span></strong></span></p><p><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzU4ODQ3NTM2OA==&amp;mid=2247506463&amp;idx=1&amp;sn=f5023f07f88a65589cb3858da51ae3f2&amp;scene=21#wechat_redirect\">MistTrack 季度更新：KYA 批量筛查与追踪画布上线</a></span></p><p><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzU4ODQ3NTM2OA==&amp;mid=2247506417&amp;idx=1&amp;sn=32e30273fd88ef1fce4d2777602b7408&amp;scene=21#wechat_redirect\">威胁情报｜Udesk 加载恶意 JS，窃密篡改转账地址</a></span></p><p><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzU4ODQ3NTM2OA==&amp;mid=2247506411&amp;idx=1&amp;sn=1c22b44195fa686f055b08dc2cb129c8&amp;scene=21#wechat_redirect\">架构破局，风控筑底｜慢雾将举办 2026 香港 RWA 与稳定币支付机构闭门峰会</a></span></p><p><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzU4ODQ3NTM2OA==&amp;mid=2247506403&amp;idx=1&amp;sn=9eebfd36706b74c2e1e3ac01f32a9a2b&amp;scene=21#wechat_redirect\">威胁情报｜警惕！Web3 面试题暗藏盗窃后门</a></span></p><p><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzU4ODQ3NTM2OA==&amp;mid=2247506392&amp;idx=1&amp;sn=58f4da7624aea0bf2aacc181bc6df3c0&amp;scene=21#wechat_redirect\">PHP 爆出\"互联网级\"高危漏洞，Web3 的\"链下软肋\"该怎么补？</a></span></p><p><img src=\"/dailyinfo/media/b4d2318b27bb10bf.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><strong><span><span>慢雾导航</span></span></strong></span></p><p><span><strong><span>慢雾科技官网</span></strong></span></p><p><span><em><span><a href=\"https://www.slowmist.com/\">https://www.slowmist.com/</a></span></em></span></p><p><span><strong><span>慢雾区官网</span></strong></span></p><p><span><em><span><a href=\"https://slowmist.io/\">https://slowmist.io/</a></span></em></span></p><p><span><strong><span>慢雾 GitHub</span></strong></span></p><p><span><em><span><a href=\"https://github.com/slowmist\">https://github.com/slowmist</a></span></em></span></p><p><span><strong><span>Telegram</span></strong></span></p><p><span><em><span><span><a href=\"https://t.me/slowmistteam\">https://t.me/slowmistteam</a></span></span></em></span></p><p><span><strong><span>Twitter</span></strong></span></p><p><span><em><span><span><a href=\"https://twitter.com/@slowmist_team\">https://twitter.com/@slowmist_team</a></span></span></em></span></p><p><span><strong><span>Medium</span></strong></span></p><p><span><em><span><span><a href=\"https://medium.com/@slowmist\">https://medium.com/@slowmist</a></span></span></em></span></p><p><span><strong><span>知识星球</span></strong></span></p><p><span><em><span><span><a href=\"https://t.zsxq.com/Q3zNvvF\">https://t.zsxq.com/Q3zNvvF</a></span></span></em></span></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=4da0057a&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzU4ODQ3NTM2OA%3D%3D%26mid%3D2247506498%26idx%3D1%26sn%3Da7646de265d6c5c01cf91b8b5cb91480\">跳转微信打开</a></p>","original","zhKind","complete","漏洞利用","利用链","加密","数据窃取","https://mp.weixin.qq.com/s?__biz=MzU4ODQ3NTM2OA==&mid=2247506498&idx=1&sn=a7646de265d6c5c01cf91b8b5cb91480","慢雾科技",{"_118":119,"_120":-5},"changelogVersion","2026-10-01T08:00","release"]
