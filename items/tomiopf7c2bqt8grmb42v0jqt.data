[{"_1":2,"_3":4},"root",{"_5":116},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1793621626000,"id","tomiopf7c2bqt8grmb42v0jqt","title","FBI 确认朝鲜 TraderTraitor 窃取 Binance 超过 60 亿美元加密资产","originalTitle","FBI pins $6.3 billion Binance crypto heist on North Korea while scammers circle anxious users","summary","FBI 确认朝鲜组织 TraderTraitor 于 2026 年 10 月 29 日前后从 Binance 窃取超过 60 亿美元虚拟资产；约 63 亿美元资产离开平台钱包。","reason","source",{"_76":115},"links",{"_100":114},"publishedAt","2026-11-02T10:12:51.000Z","discoveredAt","2026-11-02T10:43:33.430Z","timelineAt","category","activity","tags",[77,107,108,109,110,111,112,113],"score",85,"selected",true,"channel","news","story",{"_87":88,"_13":89},"x","sameEvent",{"_11":105,"_13":106},"readingMode","full","author","Sinisa Markovic","body",{"_62":99,"_100":-5,"_101":102,"_103":104},"outline",[90,91],"relatedStories",[86],"topics",[69,70,71,72,73],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","f39FEvqrWazs","reportCount",6,"additionalSourceCount",5,{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","attack","name","攻击活动","black-market","数据窃取与黑产","crypto","密码学","identity","身份与访问","cloud-native","云与原生",{"_87":88,"_13":89},"publicId","6ef2ec24-f871-4ca2-9cc2-5fcbd249af24","FBI归因TraderTraitor窃取Binance资产",{"_11":97,"_93":98,"_95":96},{"_11":92,"_93":94,"_95":96},"sec-2","text","骗子利用提现暂停事件牟利","level",3,"sec-1","提现分阶段恢复","<p>North Korea was <a href=\"https://www.helpnetsecurity.com/2026/10/30/binance-crypto-hack/\">behind the theft</a> of more than $6 billion in cryptocurrency from Binance, the FBI has confirmed.</p><p><img src=\"/dailyinfo/media/a8aec15368c24570.webp\" loading=\"lazy\" decoding=\"async\" alt=\"North Korea Binance hack\" title=\"Binance\"></p><p>“联邦调查局（FBI）发布信息， advising 朝鲜民主主义人民共和国（朝鲜）应对大约于 2026 年 10 月 29 日从加密货币交易所 Binance 窃取超过 60 亿美元虚拟资产一事负责，”该局在 10 月 31 日发布的一份警报中<a href=\"https://www.fbi.gov/investigate/cyber/alerts/2026/north-korea-responsible-for-6-billion-binance-attack\">表示</a>。</p><p>FBI 将此次攻击与 TraderTraitor 联系起来；该组织被 FBI 认定为 2025 年 2 月 15 亿美元 Bybit 黑客事件的幕后组织。区块链情报公司 TRM Labs 和 Chainalysis 在攻击发生一天内率先将此次盗窃归因于该组织。</p><p>对于任何关注加密货币盗窃的人来说，FBI 的确认并不令人意外。多年来，为朝鲜政权效力的黑客一直是针对加密货币平台最频繁、破坏性最强的<a href=\"https://www.helpnetsecurity.com/2025/12/18/crypto-theft-2025-north-korean-domination/\">攻击</a>实施者。 </p><p>到 2025 年 10 月初，区块链分析公司 Elliptic 已将当年超过<a href=\"https://www.helpnetsecurity.com/2025/10/08/north-korean-hackers-cryptocurrency-theft/\">20 亿美元被盗加密货币</a>与朝鲜关联起来，其中大部分来自 Bybit 盗窃案，另有三十多起黑客事件。据信，这些资金用于资助该国的核武器和导弹计划。</p><p>FBI 与美国特勤局和 IRS 刑事调查部门合作，已发现该组织主要将被盗资产转换为 Ethereum；这些机构预计，该组织还会通过 DeFi 平台和即时兑换服务进一步洗钱。它们敦促节点运营者、即时交易所、DeFi 服务、区块链分析公司及其他加密货币服务提供商，阻止与警报中列出的 628 个地址相关的交易，其中包括 608 个 Ethereum 钱包、19 个 Bitcoin 钱包和一个 Solana 钱包。</p><p>Binance 联合创始人 Changpeng Zhao 感谢了参与应对事件的特勤局及其他机构和行业伙伴。他<a href=\"https://x.com/cz_binance/status/2116977683393618404\">写道</a>：“你们在数分钟内采取行动，帮助追踪并冻结被盗资金，而这项工作仍在继续。”</p><p>10 月 29 日，约 63 亿美元从 Binance 钱包转出，这很可能成为史上规模最大的加密货币盗窃案。该公司最初表示，攻击者可能是通过一台遭入侵的 DevOps 工程师笔记本电脑进入系统，从而访问服务容器并擅自提现；后来又透露，其调查人员发现了更多入侵行为。</p><p>Tether、Circle 及其他合作伙伴协助在第一天内冻结了近 30 亿美元被盗资金。</p><h3 id=\"sec-1\">提现分阶段恢复</h3><p>Binance 于 11 月 1 日开始恢复提现，首批网络和资产计划于 UTC 时间上午 6 点至 9 点之间开放。交易所根据过去一周的用户需求安排恢复顺序，以便每个网络和资产组合在重新开放前都能通过稳定性和安全检查。 </p><p>用户应预料到流量高峰期会出现延迟和处理速度下降的情况；Binance 建议在短暂等待后重新尝试失败的提现。自事件早期以来，充值一直正常进行。</p><p>联合 CEO Richard Teng 同日在 X 上<a href=\"https://x.com/_RichardTeng/status/2116760027570864240\">宣布</a>：“今天，我们开始分阶段恢复提现，并采取谨慎approach，以确保服务安全、可靠地恢复。”</p><p>“我们理解暂停服务所造成的担忧和不便。恢复您对资金的访问是当务之急，我们正采取有控制力的方式安全地推进恢复工作。随着服务分阶段恢复，我们将继续密切监测，”该交易所在其最新的安全事件｜恢复更新中<a href=\"https://x.com/binance/status/2116744986096292263\">告知</a>用户。</p><p>法币提现也在恢复。11 月 2 日，Binance <a href=\"https://x.com/binance/status/2117164969582330063\">将</a>美元、阿联酋迪拉姆、越南盾、菲律宾比索和印度尼西亚卢比加入用户可提现的货币清单，使总数达到 28 种，其中包括欧元、日元和巴西雷亚尔。</p><p>公司已用自有资金替换了约 95% 的被盗资产，高于此前更新中的 90%。其余 5% 是流动性较低且不在前十大资产之列的代币；Binance 表示，通过市场和 OTC 渠道按其所需规模购买这些代币需要更长时间。BTC、ETH、USDT、BNB、SOL、USDC、XRP、USD1、RLUSD 和 ZEC 的余额获得了 100% 的资金支持，用户可以在该交易所的储备证明网站上查看相关情况。</p><p>“被盗资金的财务影响将由 Binance 承担，而不是由用户承担，”Teng 补充道。调查结束后将发布事后报告。</p><h3 id=\"sec-2\">骗子利用提现暂停事件牟利</h3><p>诈骗者迅速利用了这一事件。社交媒体上的虚假帖子和截图声称 Binance 正向受提现暂停影响的用户支付 150 美元补偿，并要求他们通过 Binance 应用领取。</p><p>“你们中的一些人最近可能看到网上流传的帖子和截图。请注意，这些截图是伪造的，其中的信息也是虚假的。要获取准确且最新的信息，请始终参考我们的官方渠道和公告，”Binance 全球关联团队成员 Randy 在 X 上<a href=\"https://x.com/randyxbinance/status/2116863526753251674\">警告</a>称。</p><p>Zhao <a href=\"https://x.com/cz_binance/status/2117034367763787926\">分享</a>了这条警告，并附上一条简短消息：“骗子现在正加足马力行事。请务必小心。”</p><p><img src=\"/dailyinfo/media/93223e2e45672130.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong>订阅我们的突发新闻电子邮件提醒，助您及时了解最新的数据泄露、漏洞和网络安全威胁。<a href=\"https://www.helpnetsecurity.com/newsletter/\">立即订阅！</a></strong></p><p><img src=\"/dailyinfo/media/93223e2e45672130.webp\" loading=\"lazy\" decoding=\"async\"></p>","original","zhKind","translation","complete",false,"uu0z6mo1muhhj4bo1sst643w9","FBI 将 Binance 63 亿美元加密资产窃取案归因于朝鲜 TraderTraitor","数据泄露","凭据","云原生","黑产","加密","AWS","Google","https://www.helpnetsecurity.com/2026/11/02/fbi-north-korea-binance-hack/","Help Net Security",{"_117":118,"_119":-5},"changelogVersion","2026-10-01T08:00","release"]
