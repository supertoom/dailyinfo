[{"_1":2,"_3":4},"root",{"_5":99},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795826444000,"id","m5ausxhtut34kmi7zcnx0ncei","title","North Korea关联PolinRider污染超7,600个GitHub仓库传播恶意软件","originalTitle","North Korea-Linked PolinRider Poisons Over 7,600 GitHub Repositories to Spread Malware","summary","North Korea关联的PolinRider活动通过劫持开发者账户、提交恶意Pull Request和重写Git历史，向至少7,609个GitHub仓库植入Python加载器，涉及2,330个账户；2026年10月27日至11月6日间已推送至2,040个仓库。","reason","文章还原了PolinRider借助GitHub仓库传播恶意载荷的多条路径，并给出受影响仓库、账户和时间范围，便于识别开发环境供应链风险。","source",{"_74":98},"links",{"_87":97},"publishedAt","2026-11-26T15:13:41.000Z","discoveredAt","2026-11-26T15:38:27.030Z","timelineAt","category","activity","tags",[77,75,91,92,93,94,95,96],"score",75,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_61":86,"_87":-5,"_88":89,"_90":37},"outline",[],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fO5fK4ImXee4","reportCount",1,"additionalSourceCount",0,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","malware","name","恶意软件","attack","攻击活动","identity","身份与访问","supply-chain","供应链安全",{"_83":84,"_13":85},"publicId","98554c0a-701a-4d7e-b2e6-f9402ca09609","PolinRider污染GitHub仓库投放恶意软件","<p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgquhPuqGJrSE3xNpn5ZUELVAv-Y7qXqkHgpw7nbVqCay4gyraYO5NNE12rAGzuqk_zhreNwcyzjZf3vZZB5C4teohyuppUP-JlP41PQiLu-hGEFCsqMZO0T6MoaVk-uY818yaTaiJaX-d2O0h0RER22knXbUQc7qnwIcVbleLQrEspMQ8btNa4Q9mFrmue/s1600/gitcat.jpg\"><img alt=\"\" src=\"/dailyinfo/media/f9a80c4b668371b4.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p><strong>PolinRider</strong> 活动背后的威胁行为者被发现正在 GitHub 仓库中植入 Python 加载器，并且有证据显示，该活动最早可能始于 2025 年 2 月。</p><p>SafeDep 在本周发布的一份报告中<a href=\"https://safedep.io/blog/polinrider-python-loader-ethereum-calldata\">表示</a>：“加载器藏在一个很小的 utils 包中或 conftest.py 里。当 Python 导入该文件时，加载器会读取一个 Ethereum 钱包发送给自身的最新交易。它将该交易的输入数据解码为 JavaScript，并使用 Node.js 运行。”</p><p>另一方面，这段 JavaScript 代码会读取第二个钱包，以定位命令与控制（C2）服务器，然后通过 node -i 进程将下一阶段载荷传入一个分离的交互式 Node.js 环境。</p><p>这家软件供应链安全公司表示，他们在 260 个账户所属的 375 个公共仓库中发现了该加载器。没有证据表明该加载器已通过 PyPI 或 npm 分发。&nbsp;</p><p><a href=\"https://opensourcemalware.com/blog/developer-guide-getting-over-polinrider\">PolinRider</a> 是与朝鲜威胁行为者相关的一项<a href=\"https://thehackernews.com/2026/07/north-korean-hackers-publish-108.html\">恶意活动</a>的<a href=\"https://thehackernews.com/2026/07/seven-malicious-vite-npm-packages-use.html\">名称</a>。近期报告显示，该活动利用多种渠道分发恶意软件，包括——</p><ul>\n  <li>欺诈性招聘活动利用钓鱼邮件和虚假招聘门户，如 <a href=\"https://thehackernews.com/2025/04/north-korean-hackers-spread-malware-via.html\">BlockNovas</a>、<a href=\"https://research.jfrog.com/post/accurasofthire-fake-interview/\">AccuraSoftHire</a>（“accurasofthire[.]com”）和 <a href=\"https://getjump.me/posts/03-huntrole-fake-take-home/\">HuntRole</a>（“huntrole[.]org”），诱骗潜在目标以完成居家评估为借口运行含恶意软件的项目。&nbsp;</li>\n  <li>通过劫持维护者账户，在开源生态系统中<a href=\"https://thehackernews.com/2026/09/malicious-npm-package-indexed-btree-hid.html\">发布恶意软件包</a>，借助虚假字体文件（<a href=\"https://thehackernews.com/2026/06/hijacked-npm-and-go-packages-use-vs.html\">fa-solid-400.woff2</a>、<a href=\"https://opensourcemalware.com/blog/polinrider-is-a-b-testing-its-way-past-your-detections\">fa-solid-500.woff2, or fa-solid-300.llf</a>）、Visual Studio Code（VS Code）自动运行任务以及重写 Git 历史来植入混淆后的恶意软件。</li>\n  <li>使用遭入侵的开发者计算机窃取其 GitHub 令牌，并将恶意提交强制推送至其有权访问的开源仓库。</li>\n</ul><p>从总体上看，PolinRider 加载器会<a href=\"https://abnormal.ai/blog/polinrider-fake-coding-assignments\">获取</a>一个经过加密的第二阶段 Node.js 载荷；该载荷会扫描受感染主机上已安装的开发者应用程序，如 GitHub Desktop、Cursor、VS Code 和 Google Antigravity，并篡改最常用的工具，以执行攻击者控制的代码并投递信息窃取恶意软件。</p><p>这里值得注意的是，PolinRider 被<a href=\"https://opensourcemalware.com/blog/opensourcemalware-show-episode13\">评估为</a>一个与代号为 <a href=\"https://thehackernews.com/2026/11/fbi-says-north-korean-hackers-stole.html\">Contagious Interview</a> 的长期活动并行运作的子集群。后者更多是一种用于入侵开发者系统的社会工程入口，而 PolinRider 则滥用修改仓库的权限，将仓库变成恶意软件的分发渠道。</p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEijR_efWJ7d9RAeGMMuFl7H1cl7pGpfJgsDSf9qbAjvEWQ3hv5J61VzRGgAZIa30RR63c0zhMpybb-UCn52MiQ105b2K1kIj6mERg9Te5kVgII1u9xr_0iOOTvzAx0j7sXPBdbMNHStd_m7KANoMPdFvEyFeWM9vXKta-tagvSLl0nwyjw9hKGSc1p8Adxr/s1600/polin-1.png\"><img alt=\"\" src=\"/dailyinfo/media/fc9b9b45c4a3a5e0.webp\" loading=\"lazy\" decoding=\"async\"></a></p><p>Palo Alto Networks Unit 42 在上个月发布的一份报告中<a href=\"https://unit42.paloaltonetworks.com/web3-cloud-supply-chain-attacks/\">表示</a>：“网络犯罪团伙部署供应链蠕虫，以进行机会主义盗窃。另一方面，朝鲜国家支持的攻击者将开源软件注册表作为针对企业环境的主要初始访问途径。”</p><p>“威胁行为者展示了如何攻陷单个维护者账户或注册表范围，进而将开源依赖关系扩散开来，造成大范围云环境受到影响。”</p><p>据发现，部分诱饵网站还包含另外两条备用投递路径：&nbsp;</p><ul>\n  <li>指示候选人在启用“开发者模式”后侧载 Google Chrome 扩展，以订阅新的职位提醒。</li>\n  <li>根据操作系统采用 ClickFix 风格的诱饵，诱使受害者将恶意命令复制并粘贴到终端应用中，并将其作为“面向候选人与面试流程的标准设置包”的一部分。</li>\n</ul><p>StepSecurity <a href=\"https://www.stepsecurity.io/blog/accurasofthire-fake-interview-developer-machines\">表示</a>：“这份[求职]申请要求提交一段简短的验证视频。在服务器将某位候选人标记为已安装‘driver’之前，摄像头检查始终会失败，并显示一条消息，称系统没有兼容的摄像头环境。”</p><p>“该站点上另一个名为‘Technical onboarding’的页面会提供一条单行 curl 命令，用于下载该‘driver’。在 Windows 上，下载的安装程序会从招聘站点获取一个脚本；如果系统中缺少 Node.js，该脚本会安装 Node.js、下载 JavaScript 载荷、在后台运行该载荷，然后自行删除。macOS 和 Linux 版本执行相同操作。”</p><p>该 JavaScript 恶意软件旨在执行以下步骤——</p><ul>\n  <li>读取与某个 Ethereum 钱包关联的最新交易（“<a href=\"https://etherscan.io/tx/0x5b0086e52e12bc127cc02eb629701e04b393bd4db08d0139b1f94f78339cdaec\">0xa322E5f3D311D3080e6f0121063e9aDC2490Ef1a</a>”）。</li>\n  <li>获取其目标钱包地址（“0x67B38e9b67B38E9b68656c6C6f6970626f742121”）。</li>\n  <li>使用一种称为 NullReceiver 的技术，从钱包地址的前 8 个字节（“67B38e9b”和“67B38E9b”）中两次提取 C2 服务器地址（“103.179.142[.]155”），而最后 12 个字节则表示 ASCII 字符串“helloipbot!!”。</li>\n  <li>使用该 IP 地址通过 443 端口获取两个载荷：“0x/cls”和“0x/ls”。</li>\n</ul><table><tbody><tr><td><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgDMmvUWQdPy-szNqvZUrij9zE5cD15oEo9jQTapTl6rul69GxiYciMec7HWm-S_6MBkMtdTlb5DXXZ5LVljF57kO49PUQP2_hYB0o9kZJmf7d7ozn3LStuJJOrTcgEUsDOYSJVu_NXW_I1Ta93nLqLZBCV19-0-R6Rca3Kr1ntJ0FK3MV8h1Fv8uMDtuM5/s1600/polin-2.png\"><img alt=\"\" src=\"/dailyinfo/media/647eb73a29333e63.webp\" loading=\"lazy\" decoding=\"async\"></a></td></tr><tr><td>NullReceiver 技术</td></tr></tbody></table><p>SafeDep 的最新研究发现，这些代码仓库被注入了一个 58 行的 Python 加载器。该加载器读取“0x3b1574417524c11a7403c4b232CAcBb320CceBC6”钱包，以提取 JavaScript 代码；该代码随后会访问第二个钱包（“<a href=\"https://etherscan.io/tx/0xbc84b5bfd7d1fc64f0d7a3d3a0e76e8b989ea44b8a09f8382afee192e1f3317d\">0x1eEf0849EDa15d87f64e51C73C8442Cf3c8bCEF3</a>”），以获取与最新交易关联的目标钱包（“0x5F87b5545F87b55468656C6C6f6970626f742121”），进而用于解析 C2 服务器（“95.135.181[.]84”）。</p><p><a href=\"https://safedep.io/polinrider-ethereum-c2-github-repositories/\">NullReceiver 的一个显著特征</a>是<a href=\"https://thehackernews.com/2026/08/trojanized-npm-packages-decode-c2-ip.html\">虚构的目标钱包地址</a>中的标记“68656c6C6f6970626f742121”，它<a href=\"https://thehackernews.com/2026/09/attackers-use-malicious-terraform.html\">始终转换</a>为“helloipbot!!”。</p><p>SafeDep 表示：“/0x/cls 脚本会运行两次，一次在当前进程中通过 eval 运行，另一次在新进程中运行。/0x/ls 脚本只在新进程中运行。”</p><p>这些载荷的确切性质仍不清楚。然而，此前已观察到多波攻击会安装信息窃取程序，用于收集环境机密、浏览器密码、Cookie 和钱包数据。值得注意的是，钱包地址“0x1eef0849eda15d87f64e51c73c8442cf3c8bcef3”已被威胁行为者重复用于其他攻击波次——</p><ul>\n  <li>推送<a href=\"https://blog.greenflagged.dev/posts/2026-11-03-adminide-stack-eth-dead-drop/\">遭入侵的</a><a href=\"https://www.sonatype.com/blog/polinrider-loader-reappears-in-hijacked-npm-packages\">合法 npm 包</a>版本，例如 @adminide-stack/utils、@adminide-stack/health-api-server、@adminide-stack/user-activity-browser、@adminide-stack/utils、@adminide-stack/forms-core、@adminide-stack/yantra-help-browser、server-hemera-mongo、cdeops、@cdmbase/wiki-browser 和 @pubngo-stack/help-browser。这些版本使用同一个钱包地址，从“<a href=\"https://www.ox.security/blog/polinrider-returns-hijacked-npm-packages-use-ethereum-blockchain-to-conceal-malware-infrastructure/\">95.135.181[.]151</a>”获取 /0x/cls 和 /0x/ls。</li>\n  <li>HuntRole 发起的<a href=\"https://getjump.me/posts/03-huntrole-fake-take-home/\">虚假招聘活动</a>会诱使受害者完成编程测评。该测评使用 Visual Studio Marketplace 中名为“huntrole.assessment-tool”的 VS Code 扩展，发送系统信息并获取、运行恶意 JavaScript 载荷。该脚本会查询同一个钱包地址，从“95.135.181[.]84”获取 /0x/cls 和 /0x/ls。</li>\n  <li>\n    Using a GitHub account named \"\n    <a href=\"https://www.stepsecurity.io/blog/polinrider-malware-open-source-pull-requests\">\n      Eternity0207\n    </a>\n    \" to open over 200 pull requests targeting open-source projects like AsyncAPI Generator, CircuitVerse, and Open Food Facts, and subsequently force-push a modified commit containing an obfuscated loader that uses the same wallet address to fetch /0x/cls and /0x/ls from \"95.135.181[.]84.\"\n    <ul>\n      <li>据 AsyncAPI Generator 的<a href=\"https://github.com/meshery/meshery/issues/24312\">维护者</a>表示，“每次，payload 都会在分支上保留 30-40 分钟，随后被强制推送掉，因此最终的 diff 看起来很干净。”这些未经授权的修改会让加载器在毫不知情的开发者运行 AsyncAPI 的“npm run build”、加载 Open Food Facts 的测试配置，或使用 VS Code 打开 CircuitVerse 文件夹时运行。该 GitHub 账户此后已被暂停。</li>\n    </ul>\n  </li>\n</ul><p>据 Apiiro 估计，PolinRider 至少已在由 2,330 个账户拥有的 7,609 个 GitHub 仓库中被检测到，其中大多数账户属于开发者。部分受害者包括 Neutralinojs、InstaWP Connect 和 fxhash。2026 年 10 月 27 日至 11 月 6 日期间，该加载器已被推送至 2,040 个仓库。</p><p>Apiiro 研究员 Shmulik Cohen <a href=\"https://apiiro.com/blog/polinrider-north-korea-worm-forged-github-commits\">表示</a>：“该蠕虫利用窃取的 GitHub 访问权限重写开发者已经创建的提交，并保留作者、消息和日期，同时在构建配置中数百个空格之后添加一个隐藏的加载器。”</p><p>“构建项目就会运行它。在最新一波攻击中，使用 VS Code 打开该文件夹就足够了。加载器会从以太坊钱包读取其服务器，因此让服务器下线毫无作用：一笔交易就能把所有加载器转移到下一个地址。”</p><table><tbody><tr><td><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiXVYR5eyE6M9jGEiTg2qTebXrxzIuWuUnVUgzQQJMmx2x08eL4ejH8V9mGBOu24K2HyDFMiF1Xk45hqqP7oxgWEQ2p348gW2R7Q9eX7TLjrhzTyVA7lfMofxqQzZH4H_H-n83Qbn9zRb140L-Y25AY0lA2wExsVcVdBeFW7snCJLFuJ8O0CftskfdItu9f/s1600/polin-3.png\"><img alt=\"\" src=\"/dailyinfo/media/f685a0d112000dc3.webp\" loading=\"lazy\" decoding=\"async\"></a></td></tr><tr><td>2025 年 5 月的 PolinRider 攻击</td></tr></tbody></table><p>此次动态出现之际，OpenSourceMalware 表示其发现了一次发生于 2025 年 5 月的 PolinRider 攻击，比有记录的最早受害者早八个月。该攻击针对九个软件包，利用被劫持的维护者账户，在 90 分钟内推送了投毒版本——</p><ul>\n  <li>itsa-utils@1.4.2</li>\n  <li>itsa-jsext@2.0.3</li>\n  <li>itsa-react-docviewer@16.1.2</li>\n  <li>itsa-cli@16.5.3</li>\n  <li>itsa-react-button@16.0.11</li>\n  <li>itsa-react-maskedinput@16.1.2</li>\n  <li>itsa-react-checkbox@16.0.5</li>\n  <li>itsa-react-focuscontainer@16.0.10</li>\n  <li>itsa-react-input@16.1.2</li>\n</ul><p>现已发现，这些软件包中的每一个都利用了 <a href=\"https://thehackernews.com/2025/10/north-korean-hackers-use-etherhiding-to.html\">EtherHiding</a>（NullReceiver 的前身）来获取名为 <a href=\"https://thehackernews.com/2026/02/fake-nextjs-repos-target-developers.html\">JADESNOW</a> 的 JavaScript 下载器，随后用它投递 InvisibleFerret（一种用于 Contagious Interview 活动的 Python 后门），以及<a href=\"https://thehackernews.com/2026/06/hijacked-npm-and-go-packages-use-vs.html\">一个 Socket.IO RAT 和一个基于 Python 的窃密程序</a>。</p><p>安全研究人员 Paul McCarty 和 Jenn Gile <a href=\"https://opensourcemalware.com/blog/polinrider-malware-found-in-2025-npm-packages\">表示</a>：“2025 年的样本包含 PolinRider 的 payload，但不具备其有记录的传播行为；这种行为出现在同一维护者的 GitHub 仓库中，时间跨度为 2026 年 1 月至 7 月之间的四个时段。”他们补充道：“其背后的区块链记录将攻击者的活动追溯至 2025 年 2 月。”</p><p>“感染很可能自 2025 年起就一直存在于该维护者的机器上，因为 2026 年的推送正是从该机器发起的。这与 PolinRider 有记录的传播脚本相符，该脚本会回拨系统时间、将 payload 合并进 tip commit，并使用开发者自己的凭据执行强制推送。”</p><p>觉得这篇文章有意思？欢迎在 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a> 上关注我们，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","供应链投毒","后门","凭据","供应链","Google","Palo Alto","https://thehackernews.com/2026/11/north-korea-linked-polinrider-poisons.html","The Hacker News",{"_100":101,"_102":-5},"changelogVersion","2026-10-01T08:00","release"]
