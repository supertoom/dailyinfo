[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":-5,"_57":36,"_58":59},"expiresAt",1794616836000,"id","ybam9buweaqo8o2mqaa7o5mm1","title","Google 修复 Android 14 至 17 远程代码执行漏洞 CVE-2026-58868","originalTitle","CVE-2026-58868: Critical Android Bug Could Let Attackers Run Remote Code","summary","Google 已修复 Android 14 至 17 的堆缓冲区溢出漏洞 CVE-2026-58868，缺陷位于 FrameDecoder.cpp 的 onOutputReceived 函数，可导致越界写入。","reason","source",{"_64":84},"links",{"_59":83},"publishedAt","2026-11-04T10:26:52.000Z","discoveredAt","2026-11-04T11:34:23.337Z","timelineAt","category","vuln","tags",[80,81,67,82],"score",66,"selected",false,"channel","news","story","x","readingMode","full","author","Pierluigi Paganini","body",{"_76":-5,"_59":77,"_78":-5,"_79":36},"outline",[70],"relatedStories",[],"topics",[60,61,62],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_63":68,"_64":69},{"_63":66,"_64":67},{"_63":30,"_64":65},"slug","name","漏洞披露","mobile","移动端","google","Google / 谷歌",{"_11":71,"_72":73,"_74":75},"sec-1","text","Critical Android flaw CVE-2026-58868 could allow remote code execution without u","level",2,"zh","<h2 id=\"sec-1\">Critical Android flaw CVE-2026-58868 could allow remote code execution without user interaction on devices running Android 14 through 17.</h2><p>Google has fixed CVE-2026-58868, a critical Android vulnerability affecting versions 14 through 17. The flaw is a critical Android vulnerability caused by a heap buffer overflow in the <code>onOutputReceived</code> function of <code>FrameDecoder.cpp</code>. The flaw can trigger an out-of-bounds write, potentially allowing a remote attacker to execute arbitrary code on a vulnerable device. Exploitation requires neither user interaction nor additional execution privileges, making it a potential zero-click attack.</p><p><em>“cve-2026-58868 In onOutputReceived of FrameDecoder.cpp, there is a possible out-of-bounds write due to a heap buffer overflow.” <a href=\"https://nvd.nist.gov/vuln/detail/cve-2026-58868\">reads the advisory</a>. “This could lead to remote code execution with no additional execution privileges needed. User interaction is not needed for exploitation.”</em></p><p>Devices receive the fix through security patch level 2026-11-01 or later, depending on manufacturers and carriers. Google is not aware of active exploitation of the flaws in its November 2026 bulletin.</p><p><a href=\"https://source.android.com/docs/security/bulletin/2026/2026-11-01?hl=it\">Google’s November 2026 Android security bulletin</a> addresses 216 vulnerabilities, including 23 rated Critical. Two of these flaws, CVE-2026-58876 and CVE-2026-58936, affect the System component and could allow remote code execution without user interaction.</p><p>The bulletin also lists five other Critical flaws in the System component. Three could lead to privilege escalation, while two could cause denial-of-service conditions. Another Critical vulnerability affects the Framework component and could also allow remote code execution.</p><p>Six Critical vulnerabilities affect the Android kernel. Two involve Bluetooth code, three affect the protected Kernel-based Virtual Machine (pKVM), and one is in the Human Interface Device (HID) component. The most severe kernel flaw could allow a remote attacker to gain elevated privileges without user interaction.</p><p>The November 5 patch level also addresses Critical vulnerabilities in MediaTek modem code and a closed-source Qualcomm component. Google’s bulletin lists eight Critical MediaTek modem flaws, while MediaTek’s own November security bulletin details six of them: CVE-2026-20499 and CVE-2026-20545 through CVE-2026-20549.</p><p>MediaTek describes these six vulnerabilities as out-of-bounds write flaws caused by missing bounds checks, integer overflow or improper input validation. The company says it is not aware of any active exploitation in the wild.</p><p>The Qualcomm issue is tracked as CVE-2026-25285 and affects a closed-source component. Google does not provide further technical details in its bulletin.</p><p>One of the critical issues fixed by Google is CVE-2026-58882 (aka <a href=\"https://securityaffairs.com/tag/sms-of-death\">SMS of Death</a>), which could allow attackers to remotely disable a phone by sending a specially crafted SMS message. The flaw affects <code>decodeWapPdu</code>, a function responsible for processing WAP Push messages, a type of content delivered through the SMS infrastructure.</p><p>The vulnerability is particularly concerning because exploitation reportedly requires no user interaction. An attacker only needs the victim’s phone number to send a malicious message. The message doesn’t appear in the SMS inbox, so the victim may have no indication of what caused the problem.</p><p>The issue also raises concerns about the reliability of mobile communications during an attack. According to a technical analysis published on October 29 by security researcher Mark B, a malformed WAP Push message can crash <code>com.android.phone</code>, the Android system component responsible for handling telephony functions. The crash can terminate ongoing calls, including emergency calls.</p><p>Tests on several Android phone models reportedly reproduced the crash consistently. The phone can also become stuck in a crash loop because Android retries processing the malicious message whenever the device starts. As a result, the device may continue crashing until the offending message is removed.</p><p>There is an important distinction, however. Google’s security bulletin and the CVE record identify the vulnerable <code>decodeWapPdu</code> function, but neither explicitly confirms that CVE-2026-58882 is the same issue described in the researcher’s SMS of Death report. The technical overlap is worth investigating, but the two reports shouldn’t be treated as definitively describing the same vulnerability without further confirmation.</p><p><strong>Follow me on Twitter:&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a><strong></strong></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;hacking,&nbsp;CVE-2026-58868)</strong></p>","zhKind","complete","漏洞","补丁","Google","https://securityaffairs.com/202414/mobile-2/cve-2026-58868-critical-android-bug-could-let-attackers-run-remote-code.html","Security Affairs",{"_86":87,"_88":-5},"changelogVersion","2026-10-01T08:00","release"]
