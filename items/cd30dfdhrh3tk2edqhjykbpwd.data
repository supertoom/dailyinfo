[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795048829000,"id","cd30dfdhrh3tk2edqhjykbpwd","title","Chrome 面向 Windows 和 Mac 推出 Desktop 早期 Stable 更新 159.0.8154.13/.14","originalTitle","Early Stable Update for Desktop","summary","Chrome Stable 通道已向 Windows 和 Mac 少量用户发布 159.0.8154.13/.14 早期稳定版更新。此次为分阶段推送，完整变更记录可在更新日志中查看；官方建议如发现新问题可提交 bug，并通过社区帮助论坛寻求支持。","reason","source",{"_71":84},"links",{"_61":83},"publishedAt","2026-11-18T18:58:35.648Z","discoveredAt","2026-11-18T21:48:37.106Z","timelineAt","category","blue-team","tags",[81,82],"score",3,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","Srinivas Sista","body",{"_77":-5,"_61":78,"_79":-5,"_80":36},"outline",[],"relatedStories",[73],"topics",[68],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","f2SW71XZekD4","reportCount",1,"additionalSourceCount",0,{"_69":70,"_71":72},"slug","google","name","Google / 谷歌",{"_74":75,"_13":76},"publicId","4e3ce331-f4d1-444d-ba75-e23faf1c5fc9","Chrome桌面版提前稳定通道更新","zh","<p>&nbsp;<span>The Stable channel has been updated to </span><span>159.0.8154.13/.14</span><span> for Windows , Mac as </span><span>part of our early stable release to a <span>small percentage of users. </span>A full list of changes in this build is available in the</span><span> </span><span><a href=\"https://chromium.googlesource.com/chromium/src/+log/157.0.8103.78..159.0.8154.13?pretty=fuller&amp;n=10000\">log</a></span><span>.</span></p><p><span><span>You can find more details about early Stable releases </span><a href=\"https://developer.chrome.com/blog/early-stable/\"><span>here</span></a><span>.</span></span></p><p><span>Interested in switching release channels? &nbsp;Find out how </span><a href=\"https://www.chromium.org/getting-involved/dev-channel\"><span>here</span></a><span>. If you find a new issue, please let us know by </span><a href=\"https://crbug.com/\"><span>filing a bug</span></a><span>. </span><span>The </span><a href=\"https://support.google.com/chrome/community\"><span>community help forum</span></a><span> is also a great place to reach out for help or learn about common issues.</span></p><p><span>Srinivas Sista</span></p><p><span>Google Chrome</span></p>","zhKind","complete","版本更新","Google","http://chromereleases.googleblog.com/2026/11/early-stable-update-for-desktop_01707050408.html","Chrome Releases",{"_86":87,"_88":-5},"changelogVersion","2026-10-01T08:00","release"]
