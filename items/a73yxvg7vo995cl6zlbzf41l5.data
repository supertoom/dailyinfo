[{"_1":2,"_3":4},"root",{"_5":139},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1795480832000,"id","a73yxvg7vo995cl6zlbzf41l5","title","Cisco 披露 PHP RCE 漏洞 CVE-2026-126714 的产品影响与修复计划","originalTitle","Vulnerability in PHP Affecting Cisco Products: November 2026","summary","Cisco 披露 PHP 严重漏洞 CVE-2026-126714，该漏洞可能导致远程代码执行，PHP Foundation 已于 2026 年 11 月 19 日发布安全修复。","reason","source",{"_71":138},"links",{"_60":137},"publishedAt","2026-11-23T12:20:00.000Z","discoveredAt","2026-11-23T22:44:33.934Z","timelineAt","category","vuln","tags",[133,134,74,135,136],"score",50,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body",{"_129":-5,"_60":130,"_131":-5,"_132":36},"outline",[81,82,83,84,85,86,87,88,89,90,91,92,93,94,95],"relatedStories",[77],"topics",[67,68,69],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fu9srF_fwZbk","reportCount",1,"additionalSourceCount",0,{"_70":75,"_71":76},{"_70":73,"_71":74},{"_70":30,"_71":72},"slug","name","漏洞披露","vuln-mgmt","漏洞管理","cisco","Cisco / 思科",{"_78":79,"_13":80},"publicId","5c978771-d0ef-4f3e-adc8-d47e442566ab","PHP修复phpAfterShell反序列化漏洞",{"_11":128,"_97":16,"_99":100},{"_11":126,"_97":127,"_99":100},{"_11":124,"_97":125,"_99":100},{"_11":122,"_97":123,"_99":100},{"_11":120,"_97":121,"_99":100},{"_11":118,"_97":119,"_99":100},{"_11":116,"_97":117,"_99":100},{"_11":114,"_97":115,"_99":100},{"_11":112,"_97":113,"_99":100},{"_11":110,"_97":111,"_99":100},{"_11":108,"_97":109,"_99":100},{"_11":106,"_97":107,"_99":100},{"_11":104,"_97":105,"_99":103},{"_11":101,"_97":102,"_99":103},{"_11":96,"_97":98,"_99":100},"sec-15","text","Feedback","level",2,"sec-14","LEGAL DISCLAIMER DETAILS",3,"sec-13","SOFTWARE DOWNLOADS AND TECHNICAL SUPPORT","sec-12","Legal Disclaimer","sec-11","Revision History","sec-10","URL","sec-9","Related to This Advisory","sec-8","Cisco Security Vulnerability Policy","sec-7","Source","sec-6","Exploitation and Public Announcements","sec-5","Fixed Software","sec-4","Workarounds","sec-3","Affected Products","sec-2","Summary","sec-1","zh","<table>\n\t\t\t\t\t<tbody><tr>\n\t\t\t\t\t\t<td>\n\t\t\t\t\t\t\t<h2 id=\"sec-1\">Vulnerability in PHP Affecting Cisco Products: November 2026</h2>\n\n<p>Critical</p>\n\n<p>CVE-2026-126714</p>\n\n\n<p>CWE-367</p>\n\n\n\n\n<p><a href=\"https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-phpaftershell-nov-2026-kT9pL4Xe/csaf/cisco-sa-phpaftershell-nov-2026-kT9pL4Xe.json\">\n\n            \n            Download CSAF\n          </a>\n</p>\n<p><a>\n          Email\n        </a>\n</p>\n\n\n<h2 id=\"sec-2\">\n<p>\n                        Summary\n                        \n                      </p>\n</h2>\n<ul>\n<li>\n<p>On November 19, 2026, the PHP Foundation announced the availability of security fixes that address a critical vulnerability that could lead to remote code execution. This vulnerability is identified by CVE-2026-126714.</p>\n<p>For information about this vulnerability, see the advisory <a href=\"https://github.com/php/php-src/security/advisories/GHSA-fm2m-fjf5-v3cp\">GHSA-fm2m-fjf5-v3cp</a>. This vulnerability is being referenced as <a href=\"https://depthfirst.com/research/phpaftershell\">phpAfterShell</a>.</p>\n<p>For information about Splunk products and offerings, see <a href=\"https://advisory.splunk.com/advisories/SVD-2026-1113\">Vulnerabilities in PHP affecting Splunk Products - November 2026</a>.<br><br>This advisory will be updated as additional information becomes available. </p>\n<p>This advisory is available at the following link:<br><a href=\"https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-phpaftershell-nov-2026-kT9pL4Xe\">https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-phpaftershell-nov-2026-kT9pL4Xe</a></p>\n</li>\n</ul>\n<h2 id=\"sec-3\">\n<p>\n                          Affected Products\n                          \n                        </p>\n</h2>\n<ul>\n<li>\n<p>Cisco is investigating its product line to determine which products may be affected by this vulnerability. As the investigation progresses, Cisco will update this advisory with information about affected products.</p>\n<p>If Cisco determines that a product is affected by this vulnerability, the first fixed releases will be listed in the following table. If a future release date is indicated, the date provided represents an estimate based on all information known to Cisco as of the Last Updated date at the top of the advisory. Availability dates are subject to change based on a number of factors, including satisfactory testing results and delivery of other priority features and fixes. For more information, see the associated Cisco bug ID(s).</p>\n<p>The following table lists Cisco priority products and the status of the investigation into the impact of the vulnerability that is described in this advisory. This table will be updated as additional information becomes available.</p>\n<table>\n<thead>\n<tr>\n<th>Cisco Product</th>\n<th>Status or Bug ID</th>\n<th>Fixed Release Information</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Catalyst Center</td>\n<td>Not affected</td>\n<td>-</td>\n</tr>\n<tr>\n<td>Catalyst SD-WAN Manager</td>\n<td>Not affected</td>\n<td>-</td>\n</tr>\n<tr>\n<td>Catalyst SD-WAN Validator</td>\n<td>Not affected</td>\n<td>-</td>\n</tr>\n<tr>\n<td>Catalyst SD-WAN Controller</td>\n<td>Not affected</td>\n<td>-</td>\n</tr>\n<tr>\n<td>Identity Services Engine (ISE)</td>\n<td>Not affected</td>\n<td>-</td>\n</tr>\n<tr>\n<td>IOS XE Software</td>\n<td>Not affected</td>\n<td>- </td>\n</tr>\n<tr>\n<td>IOS XR Software</td>\n<td>Not affected</td>\n<td>-</td>\n</tr>\n<tr>\n<td>Nexus Dashboard</td>\n<td>Not affected</td>\n<td>-</td>\n</tr>\n<tr>\n<td>NX-OS Software</td>\n<td>Not affected</td>\n<td>-</td>\n</tr>\n<tr>\n<td>Secure Firewall Adaptive Security Appliance (ASA) Software</td>\n<td>Not affected</td>\n<td>-</td>\n</tr>\n<tr>\n<td>Secure Firewall Management Center (FMC) Software</td>\n<td>Not affected</td>\n<td>-</td>\n</tr>\n<tr>\n<td>Secure Firewall Threat Defense (FTD) Software</td>\n<td>Not affected</td>\n<td>-</td>\n</tr>\n<tr>\n<td>UCS Central Software</td>\n<td>Not affected</td>\n<td>-</td>\n</tr>\n<tr>\n<td>UCS Director</td>\n<td>Not affected</td>\n<td>-</td>\n</tr>\n</tbody>\n</table>\n<p><strong>Important: </strong>This advisory lists only Cisco products and services that are known to include the affected software component.</p>\n\n<p>The following table lists the Cisco products that are affected by the vulnerability that is described in this advisory. This table will be updated as additional information becomes available.</p>\n<table>\n<thead>\n<tr>\n<th>Cisco Product</th>\n<th>Status or Bug ID</th>\n<th>Fixed Release Information</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td colspan=\"3\">Wireless</td>\n</tr>\n<tr>\n<td>Ultra-Reliable Wireless Backhaul (URWB)<br>Unified Industrial Wireless Software</td>\n<td><a href=\"https://bst.cisco.com/quickview/bug/CSCwx94501\">CSCwx94501</a></td>\n<td>26.2.1b (Dec 2026)<br>27.1.1 (Mar 2027)</td>\n</tr>\n<tr>\n<td colspan=\"3\">Voice and Unified Communications Devices</td>\n</tr>\n<tr>\n<td>Expressway Series</td>\n<td><a href=\"https://bst.cisco.com/quickview/bug/CSCwx94499\">CSCwx94499</a></td>\n<td>Release no. TBD</td>\n</tr>\n<tr>\n<td>Expressway Select Series</td>\n<td><a href=\"https://bst.cisco.com/quickview/bug/CSCwx94499\">CSCwx94499</a></td>\n<td>Release no. TBD</td>\n</tr>\n<tr>\n<td colspan=\"3\">Network and Content Security Devices</td>\n</tr>\n<tr>\n<td>Duo Access Gateway</td>\n<td>Under investigation</td>\n<td>Release no. TBD</td>\n</tr>\n</tbody>\n</table>\n<br>\n<p>Only products listed in the <a href=\"https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-phpaftershell-nov-2026-kT9pL4Xe?vs_f=Cisco%20Security%20Advisory%26vs_cat=Security%20Intelligence%26vs_type=RSS%26vs_p=Vulnerability%20in%20PHP%20Affecting%20Cisco%20Products:%20November%202026%26vs_k=1#affectfield\">Affected Products</a> section of this advisory are known to be affected by this vulnerability.</p>\n\n\n\n</li>\n</ul>\n<h2 id=\"sec-4\">\n\n<p>\n                          Workarounds\n                          \n                        </p>\n</h2>\n<ul>\n<li>\n<p>Any workarounds for a specific Cisco product will be documented in the relevant Cisco bugs, which are identified in the <a href=\"https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-phpaftershell-nov-2026-kT9pL4Xe?vs_f=Cisco%20Security%20Advisory%26vs_cat=Security%20Intelligence%26vs_type=RSS%26vs_p=Vulnerability%20in%20PHP%20Affecting%20Cisco%20Products:%20November%202026%26vs_k=1#affectfield\">Affected Products</a> section of this advisory.</p>\n</li>\n</ul>\n<h2 id=\"sec-5\">\n<p>\n                          Fixed Software\n                          \n                        </p>\n</h2>\n<ul>\n<li>\n<p>For information about <a href=\"https://sec.cloudapps.cisco.com/security/center/resources/security_vulnerability_policy.html#fixes\">fixed software releases</a>, consult the Cisco bugs identified in the <a href=\"https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-phpaftershell-nov-2026-kT9pL4Xe?vs_f=Cisco%20Security%20Advisory%26vs_cat=Security%20Intelligence%26vs_type=RSS%26vs_p=Vulnerability%20in%20PHP%20Affecting%20Cisco%20Products:%20November%202026%26vs_k=1#affectfield\">Affected Products</a> section of this advisory.</p>\n<p>When <a href=\"https://sec.cloudapps.cisco.com/security/center/resources/security_vulnerability_policy.html#fixes\">considering software upgrades</a>, customers are advised to regularly consult the advisories for Cisco products, which are available from the <a href=\"https://www.cisco.com/go/psirt\">Cisco Security Advisories</a> page, to determine exposure and a complete upgrade solution.</p>\n<p>In all cases, customers should ensure that the devices to be upgraded contain sufficient memory and confirm that current hardware and software configurations will continue to be supported properly by the new release. If the information is not clear, customers are advised to contact the Cisco Technical Assistance Center (TAC) or their contracted maintenance providers.</p>\n<p>The Cisco Product Security Incident Response Team (PSIRT) validates only the affected and fixed release information that is documented in this advisory.</p>\n</li>\n</ul>\n<h2 id=\"sec-6\">\n<p>\n                          Exploitation and Public Announcements\n                          \n                        </p>\n</h2>\n<ul>\n<li>\n<p>The Cisco PSIRT is not aware of any public announcements or malicious use of the vulnerability that is described in this advisory.</p>\n</li>\n</ul>\n<h2 id=\"sec-7\">\n<p>\n                          Source\n                          \n                        </p>\n</h2>\n<ul>\n<li>\n<p>This vulnerability was disclosed by the PHP Foundation.</p>\n</li>\n</ul>\n\n<h2 id=\"sec-8\">\n<p>\n        Cisco Security Vulnerability Policy\n        \n      </p>\n</h2>\n<ul>\n<li>\n<p>To learn about Cisco security vulnerability disclosure policies and publications, see the <a href=\"http://www.cisco.com/web/about/security/psirt/security_vulnerability_policy.html\">Security Vulnerability Policy</a>. This document also contains instructions for obtaining fixed software and receiving security vulnerability information from Cisco.</p>\n<p>For additional information on Cisco's vulnerability management, disclosure cadence, and software patching strategy, see <a href=\"https://sec.cloudapps.cisco.com/security/center/resources/risk-based-disclosure\">Cisco's Transition to a Risk-Based Vulnerability Disclosure Model</a>.</p>\n</li>\n</ul>\n\n<ul>\n<li>\n<p><a href=\"https://www.cisco.com/c/en/us/support/web/tools/cns/notifications.html\">Subscribe</a>\n</p>\n</li>\n</ul>\n<h2 id=\"sec-9\">\n<p>\n          \n          Related to This Advisory\n        </p>\n</h2>\n<ul>\n<li></li>\n</ul>\n\n<h2 id=\"sec-10\">\n<p>\n                        URL\n                        \n                      </p>\n</h2>\n<ul>\n<li>\n<p><a href=\"https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-phpaftershell-nov-2026-kT9pL4Xe\">https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-phpaftershell-nov-2026-kT9pL4Xe</a>\n</p>\n</li>\n</ul>\n<h2 id=\"sec-11\">\n<p>\n                        Revision History\n                        \n                      </p>\n</h2>\n<ul>\n<li>\n<table>\n\t<thead>\n\t\t<tr>\n\t\t\t<th>Version</th>\n\t\t\t<th>Description</th>\n\t\t\t<th>Section</th>\n\t\t\t<th>Status</th>\n\t\t\t<th>Date</th>\n\t\t</tr>\n\t</thead>\n\t<tbody>\n\t\t<tr>\n\t\t\t<td>1.0</td>\n\t\t\t<td>Initial public release.</td>\n\t\t\t<td>-</td>\n\t\t\t<td>Interim</td>\n\t\t\t<td>2026-NOV-23</td>\n\t\t</tr>\n\t</tbody>\n</table>\n<p><a>Show Less</a>\n</p>\n</li>\n</ul>\n<hr>\n<h2 id=\"sec-12\">\n<p>\n                          Legal Disclaimer\n                        </p>\n</h2>\n<ul>\n<li>\n<h3 id=\"sec-13\">SOFTWARE DOWNLOADS AND TECHNICAL SUPPORT</h3>\n<p>The <a href=\"https://www.cisco.com/c/en/us/support/index.html\">Cisco Support and Downloads</a> page on Cisco.com provides information about licensing and downloads. This page can also display customer device support coverage for customers who use the My Devices tool. Please note that customers may download only software that was procured from Cisco directly or through a Cisco authorized reseller or partner and for which the license is still valid.</p>\n<p>Customers who purchase directly from Cisco but do not hold a Cisco service contract and customers who make purchases through third-party vendors but are unsuccessful in obtaining fixed software through their point of sale should obtain upgrades by contacting the <a href=\"https://www.cisco.com/c/en/us/support/web/tsd-cisco-worldwide-contacts.html\">Cisco Technical Assistance Center (TAC)</a>. Customers should have the product serial number available and be prepared to provide the URL of this advisory as evidence of entitlement to a free upgrade.</p>\n<p>When <a href=\"https://sec.cloudapps.cisco.com/security/center/resources/security_vulnerability_policy.html#fixes\">considering software upgrades</a>, customers are advised to regularly consult <a href=\"https://www.cisco.com/go/psirt\">the advisories</a> for the relevant Cisco products to determine exposure and a complete upgrade solution. In all cases, customers should ensure that the devices to be upgraded contain sufficient memory and confirm that current hardware and software configurations will continue to be supported properly by the new release. If the information is not clear, customers are advised to contact the <a href=\"https://www.cisco.com/c/en/us/support/web/tsd-cisco-worldwide-contacts.html\">Cisco Technical Assistance Center (TAC)</a> or their contracted maintenance providers.</p>\n\n<h3 id=\"sec-14\">LEGAL DISCLAIMER DETAILS</h3>\n<p>CISCO DOES NOT MAKE ANY EXPRESS OR IMPLIED GUARANTEES OR WARRANTIES OF ANY KIND, INCLUDING THE WARRANTIES OF MERCHANTABILITY OR FITNESS FOR A PARTICULAR USE. WITHOUT LIMITING THE GENERALITY OF THE FOREGOING, CISCO DOES NOT GUARANTEE THE ACCURACY OR COMPLETENESS OF THIS INFORMATION. THIS DOCUMENT IS PROVIDED ON AN \"AS IS\" BASIS. YOUR USE OF THE INFORMATION ON THE DOCUMENT OR MATERIALS LINKED FROM THE DOCUMENT IS AT YOUR OWN RISK. CISCO RESERVES THE RIGHT TO CHANGE OR UPDATE THIS DOCUMENT AT ANY TIME.</p>\n<p>Copies or summaries of the information contained in this Security Advisory may lack important information or contain factual errors. Customers are advised to visit the <a href=\"https://www.cisco.com/go/psirt\">Cisco Security Advisories</a> page for the most recent version of this Security Advisory. The Cisco Product Security Incident Response Team (PSIRT) assesses only the affected and fixed release information that is documented in this advisory. See the <a href=\"https://sec.cloudapps.cisco.com/security/center/resources/security_vulnerability_policy.html#fixes\">Cisco Security Vulnerability Policy</a> for more information.</p>\n\n</li>\n</ul>\n\n\n<h2 id=\"sec-15\">\n<p>\n                          Feedback\n                        </p>\n</h2>\n<ul>\n<li>\n<p>Leave additional feedback\n</p>\n</li>\n</ul>\n\n\n\n\n\n \n\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\n\n\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t</tr>\n\t\t\t\t</tbody></table>","zhKind","complete","漏洞","补丁","Cisco","PHP","https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-phpaftershell-nov-2026-kT9pL4Xe?vs_f=Cisco%20Security%20Advisory%26vs_cat=Security%20Intelligence%26vs_type=RSS%26vs_p=Vulnerability%20in%20PHP%20Affecting%20Cisco%20Products:%20November%202026%26vs_k=1","Cisco PSIRT",{"_140":141,"_142":-5},"changelogVersion","2026-10-01T08:00","release"]
