[{"_1":2,"_3":4},"root",{"_5":135},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1795221631000,"id","dcch6vrh267pbs79iv9qncpeu","title","AWS 披露 Cairn AI Agent 自主发现零日漏洞并攻击高校","originalTitle","Chinese-nexus actor’s Cairn AI agents found a zero-day on their own","summary","Amazon Threat Intelligence 披露，中国关联威胁行为者使用开源自主 AI 渗透框架 Cairn，以“获取 shell 访问权限”为目标攻击中国境外东亚高校。","reason","source",{"_75":134},"links",{"_123":133},"publishedAt","2026-11-20T17:30:13.000Z","discoveredAt","2026-11-20T18:30:32.890Z","timelineAt","category","activity","tags",[80,82,76,129,130,131,132],"score",77,"selected",true,"channel","news","story",{"_84":85,"_13":86},"x","sameEvent",{"_11":127,"_13":128},"readingMode","full","author","CJ Moses","body",{"_62":122,"_123":-5,"_124":125,"_126":36},"outline",[87,88,89,90,91,92,93,94,95,96,97],"relatedStories",[83],"topics",[69,70,71,72],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","fVbDsNwWSOac","reportCount",2,"additionalSourceCount",1,{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","ai-security","name","AI 安全","malware","恶意软件","attack","攻击活动","exploited","在野利用",{"_84":85,"_13":86},"publicId","52702772-c6ed-4351-9e9b-8fc6f1b0fd43","自主AI平台Cairn被发现利用MONAI Label路径穿越零日漏洞攻破服务器",{"_11":120,"_99":121,"_100":66},{"_11":118,"_99":119,"_100":66},{"_11":116,"_99":117,"_100":66},{"_11":114,"_99":115,"_100":66},{"_11":112,"_99":113,"_100":66},{"_11":110,"_99":111,"_100":66},{"_11":108,"_99":109,"_100":66},{"_11":106,"_99":107,"_100":66},{"_11":104,"_99":105,"_100":66},{"_11":102,"_99":103,"_100":101},{"_11":98,"_99":47,"_100":101},"sec-11","text","level",3,"sec-10","入侵指标","sec-9","这对防御方意味着什么","sec-8","采用量正在增长","sec-7","AWS 采取的措施","sec-6","归因","sec-5","后续使用","sec-4","零日漏洞发现","sec-3","针对加固目标的持续行动","sec-2","Cairn 及本次行动概述","sec-1","发现","<p>Amazon Threat Intelligence 正分享其调查一名与中国有关联的威胁行为体的调查结果，该行为体使用自主 AI 代理开展黑客行动，几乎不需要人工参与。该行为体向这些代理设定了一个简单目标：“获取 shell 访问权限。”在此次行动中，代理发现了一个开源应用程序中的零日漏洞，并利用它完全控制了一台服务器。这些调查结果表明，基于代理的进攻行动已经在发生，防御方应做好准备，应对这些工具带来的速度和持续性。</p><h2 id=\"sec-1\"><b>发现</b></h2><p>2026 年 9 月 10 日，Amazon Threat Intelligence 发现了一台服务器，该服务器公开托管着 Cairn 的一个实例。Cairn 是一套开源自主 AI 渗透测试框架，当时在未经身份验证的情况下运行。由于操作者将该服务器公开暴露在互联网上，任何互联网用户都可以查看该平台的运行历史，包括项目配置、行为体提示词和 AI 输出。操作者使用简体中文编写提示词，已执行脚本中的时间戳则配置为中国标准时间。</p><p>对该实例的分析显示，在约 48 小时内，从 2026 年 9 月 8 日开始，存在一场针对与中国大陆以外东亚地区大学相关 IP 地址的行动。</p><h2 id=\"sec-2\"><b>Cairn 及本次行动概述</b></h2><p>Cairn 的构建初衷是作为面向防御方的研究和问题解决引擎。它的操作方式很简单：给定一个起点和用普通语言描述的目标，它会协调多个 AI 代理，找出通往该目标的路径。正是这种易用性，使其对威胁行为体颇具吸引力。在本次行动中，行为体提供了一份目标 IP 地址列表，并以“获取 shell 访问权限”这一目标的不同表述作为输入。基于这些输入，AI 代理在学习的过程中规划、执行并调整其方法，无需由操作者逐一选择下一步。</p><p>本次行动包含多项复杂程度和结果差异很大的操作。以下操作展示了自主 AI 代理的持续性和能力。</p><h2 id=\"sec-3\"><b>针对加固目标的持续行动</b></h2><p>规模最大的一项操作针对的是某所大学的一个 Redis（远程字典服务器）实例，该实例被配置为允许在未经身份验证的情况下访问。Redis 是一种将常用数据保存在内存中的数据库，以便应用程序快速检索，因此可能成为网络内有价值的立足点。在大约 16 小时和 148 次连续操作中，代理逐一尝试了多种已知技术，试图控制一个开放的 Redis 服务器。这些技术包括滥用 Redis 的复制功能加载未授权代码、逃逸其脚本沙箱、写入其配置文件以及破坏其内存。代理还尝试针对同一系统上运行的另一项服务实施 Log4Shell 注入。</p><p>这些尝试失败后，代理通过同一主机上共置的 Qdrant 实例中的一个服务器端请求伪造（SSRF）漏洞，绘制了内部 Docker 网络拓扑，并针对 PostgreSQL、SSH 和其他多项服务发起了凭据喷洒攻击。这些尝试均未成功。</p><p>另一次行动持续了 6 个多小时，目标是一台大学 GPU 服务器，即一组为计算密集型研究而构建的高性能计算机。这些代理首先通过研究该大学的公开信息，建立了一份约 80 个真实用户名的名单，其中包括教职工目录、实验室网站、已存档网页和学术论文。随后，他们针对该服务器的远程登录（SSH），以及该大学网络内其他系统上的管理仪表板、网络存储设备、VPN 服务器和校园门户，测试了 30,000 多种凭据组合。他们始终未找到可用的登录凭据。</p><p>两次行动均未成功，但结合起来表明，这些代理在近一整天内一直 Adapt 调整，且没有人类指挥。</p><h2 id=\"sec-4\"><b>零日漏洞发现</b></h2><p>面对一个运行开源医学影像 AI 应用程序的目标，结果有所不同。这些代理识别出该应用程序的框架，绘制了其 API 端点，并发现了一个带文件名参数的上传端点。他们对该参数进行了路径遍历测试，结果发现该参数存在漏洞。在约 11 分钟内，这些代理就从绘制该应用程序的 API 进展到在服务器上任意写入文件。</p><p>在后续会话中，这些代理利用同一漏洞，将 Python 反向 Shell 有效载荷写入 sitecustomize.py；这是 Python 在解释器启动时自动导入的文件。这些代理随后触发了一个训练 API 端点，以启动新的 Python 进程。新进程导入了该有效载荷，并建立了一个以 root 身份运行的反向 Shell。</p><p>在发现时，医学影像应用程序中的这个路径遍历漏洞尚无对应的安全公告，也未修补。Amazon Threat Intelligence 根据受影响开源项目中不存在任何相应修复、问题、公告或漏洞数据库中的既往提及，高置信度评估该漏洞为零日漏洞。</p><h2 id=\"sec-5\"><b>后续使用</b></h2><p>在另一次会话中，该威胁行为者介入。在这些代理发现该零日漏洞后，该行为者随后向这些代理提供了一个代理，用于隧道连接到第二个大学网络。该代理所连接的服务器运行着同样存在漏洞的软件；我们推断，该行为者此前已利用该零日漏洞攻陷服务器并建立隧道。该行为者指示这些代理利用该隧道，将该网络中的其他机器作为目标。</p><h2 id=\"sec-6\"><b>归因</b></h2><p>Amazon Threat Intelligence 根据简体中文提示、中国标准时间脚本时间戳，以及目标大学可能对中国具有战略利益这一情况，以中等置信度评估该行为者属于中国关联威胁行为者。</p><h2 id=\"sec-7\"><b>AWS 采取的措施</b></h2><p>Amazon Threat Intelligence 将该漏洞通知了项目维护者，后者发布了一个修复版本和一份 <span><a href=\"https://github.com/Project-MONAI/MONAILabel/security/advisories/GHSA-qc22-rmgc-vg94\">GitHub 安全公告</a></span>。</p><p>受影响的组织均为非 AWS 客户，AWS 无法直接通知这些组织。AWS 转而与一家政府合作伙伴合作，就相关活动通知这些组织。</p><h2 id=\"sec-8\"><b>采用量正在增长</b></h2><p>Gambit Security 是业内最早记录某个威胁组织使用 Cairn 的机构之一。其研究描述了一个出于经济动机、单独行动的参与者如何使用 Cairn 针对在线零售商。这些案例共同表明，这一自主 AI 智能体框架正被用于间谍活动和犯罪活动。更多详情见 <span><a href=\"https://gambit.security/blog-posts/autonomous-ai-agents-online-retailers-25-a-company\">Gambit Security 的报告</a></span>。</p><h2 id=\"sec-9\"><b>这对防御方意味着什么</b></h2><p>这些案例中的行动节奏压缩了防御响应可用的时间窗口。一个在几分钟内发现并利用零日漏洞的智能体，其完成活动的速度超过许多安全运营中心手动分类处理警报所需的时间。那些在加固的 Redis 目标面前失败的智能体连续运行了 16 小时，没有休息、睡眠或工作时段限制。为跟上这一节奏，组织应优先部署能够触发自动响应的高置信度检测方案，由人员监督结果，而不是逐一审查每个操作。</p><p>在幕后，AWS 主动防御系统使用全局蜜罐（吸引威胁行为者的诱饵系统）和网络流量分析来识别正在扫描易受攻击系统的行为者，随后帮助在网络层面限制此类活动。这些防护内置于 AWS 网络中，客户无需额外付费。</p><h3 id=\"sec-10\"><b>入侵指标</b></h3><p>以下地址出现在日期为 2026 年 9 月 8 日至 10 日的记录中。<br> <br> 142[.]4.98.145<br> <br> 142[.]4.107.34<br> </p><p>如果您对本帖有疑问，请联系 <a href=\"https://aws.amazon.com/contact-us/\">AWS Support</a>，或在 <a href=\"https://repost.aws/\">AWS re:Post</a> 上发起新主题。</p><hr><p>\n   <img src=\"/dailyinfo/media/30851318af645953.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"CJ Moses\" width=\"107\" height=\"160\">\n  </p><h3 id=\"sec-11\">CJ Moses</h3><p>CJ Moses 是 Amazon Integrated Security 的 CISO。在其岗位上，CJ 负责 Amazon 各业务的安全工程与运营。他的使命是通过让安全带来的益处成为阻力最小的路径，为 Amazon 各项业务提供支持。CJ 于 2007 年 12 月加入 Amazon，先后担任 Consumer CISO 以及最近的 AWS CISO，并于 2023 年 9 月出任 Amazon Integrated Security 的 CISO。</p><p>加入 Amazon 之前，CJ 负责领导联邦调查局网络 divisions 的计算机与网络入侵活动技术分析。CJ 还曾担任空军特别调查办公室（AFOSI）的特别探员。CJ 领导了多项计算机入侵调查，这些调查被视为当今安全行业的基础。</p><p>CJ 拥有计算机科学和刑事司法学位，并且是一名活跃的 SRO GT America GT2 赛车手。</p>","original","zhKind","translation","complete","mfif5csbm0luk6anr64r4hzho","攻击者利用自主 AI 工具 Cairn 攻陷 MONAI Label 漏洞并取得服务器权限","Agent 安全","漏洞利用","后门","AWS","https://aws.amazon.com/blogs/security/chinese-nexus-actors-cairn-ai-agents-found-a-zero-day-on-their-own/","AWS Security Blog",{"_136":137,"_138":-5},"changelogVersion","2026-10-01T08:00","release"]
