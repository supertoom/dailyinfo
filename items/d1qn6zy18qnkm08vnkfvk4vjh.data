[{"_1":2,"_3":4},"root",{"_5":106},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1795567278000,"id","d1qn6zy18qnkm08vnkfvk4vjh","title","Okta 与 ReversingLabs 关联 Inception 数据勒索品牌与 SSO vishing 活动","originalTitle","New Inception Extortion Brand Tied to SSO Vishing Campaign","summary","Okta 与 ReversingLabs 将新数据勒索品牌 Inception 与针对 SSO 凭据的 vishing 活动关联起来。活动者冒充支持人员，诱导员工通过仿冒登录页重置密码，窃取用户名、密码及一次性代码或 MFA 推送批准；ReversingLabs 在 21 个域名确认该钓鱼工具包，并以高置信度归因另外 41 个域名、以中等置信度归因 4 个。","reason","source",{"_74":105},"links",{"_60":104},"publishedAt","2026-11-24T16:30:00.000Z","discoveredAt","2026-11-24T17:01:37.780Z","timelineAt","category","activity","tags",[77,101,75,102,103,83],"score",64,"selected",false,"channel","news","story",{"_85":86,"_13":87},"x","readingMode","full","author","body",{"_97":-5,"_60":98,"_99":-5,"_100":36},"outline",[88,89],"relatedStories",[84],"topics",[67,68,69,70,71],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fCDoV9Pn1FSs","reportCount",1,"additionalSourceCount",0,{"_72":82,"_74":83},{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","malware","name","恶意软件","attack","攻击活动","black-market","数据窃取与黑产","email","邮件与钓鱼","identity","身份与访问",{"_85":86,"_13":87},"publicId","c02d24f7-3590-4fa0-8cbd-489d81b76730","O-UNC-053被关联Inception数据勒索活动",{"_11":95,"_91":96,"_93":94},{"_11":90,"_91":92,"_93":94},"sec-2","text","How the Vishing Campaign Works","level",2,"sec-1","A Likely Rebrand After ShinyHunters Arrests","zh","<p>\n\tOkta and ReversingLabs have linked a new data-extortion brand called Inception to a voice phishing campaign that targeted single sign-on (SSO) credentials and used stolen access to take data.</p><p>\n\tOkta Threat Intelligence researchers Moussa Diallo and Katie Nickels and ReversingLabs researcher Robert Simmons detailed the activity in separate reports published November 23.</p><p>\n\tOkta's <a href=\"https://www.okta.com/blog/threat-intelligence/former_shinyhunters_cluster_moves_to_new_inception_site/\">report</a> focused on the operators behind the campaign, while ReversingLabs' <a href=\"https://www.reversinglabs.com/blog/threat-researchers-notebook-sso-vishing-campaign-associated-with-emerging-inception-extortion-group\">analysis</a> mapped the infrastructure that tied it to Inception.</p><h2 id=\"sec-1\">\n\t<strong>A Likely Rebrand After ShinyHunters Arrests</strong></h2><p>\n\tOkta tracked the operators as O-UNC-053, a cluster at work since March 2026. It had previously associated the group with the <a href=\"https://www.infosecurity-magazine.com/news/shinyhunters-claim-hack-of-clop/\">ShinyHunters </a>data leak site, where companies it had gone after were listed from March to September.</p><p>\n\tOkta said it did not know precisely how the two were connected, though the link \"may have involved an agreement\" between the cluster and the site's operators.</p><p>\n\tAfter two people allegedly tied to ShinyHunters were arrested in September, the gang's leak site went offline, and Okta saw no O-UNC-053 targets published on any leak site until Inception appeared on November 16. Okta found that targets appearing on Inception had been preceded by O-UNC-053 infrastructure registration.</p><p>\n\tOkta said the cluster had \"very likely changed their brand affiliation\" but could not determine with high confidence whether O-UNC-053 operated the Inception data leak site itself or partnered with another extortion group.</p><p>\n\tThe company was also unable to validate whether the published data was authentic. ReversingLabs counted seven claimed victims by November 21, which it treated as unverified claims.</p><p>\n\t<em><a href=\"https://www.infosecurity-magazine.com/news/net-closes-shinyhunters-another/\">Read more on ShinyHunters: Net Closes Around ShinyHunters with Another FBI Arrest</a></em></p><h2 id=\"sec-2\">\n\t<strong>How the Vishing Campaign Works</strong></h2><p>\n\tThe attacks relied on vishing, with callers posing as support staff and pressuring employees to reset passwords through fake sign-in pages. The campaign captured usernames and passwords before seeking additional multifactor authentication (MFA) factors, including one-time codes or push approvals.</p><p>\n\tReversingLabs found the lure sites were web-only and used legal-themed lookalike domains, so the campaign never had to pass through email filters. It confirmed the phishing kit itself on 21 domains and attributed 41 more to the operation at a high confidence level and four at a medium level. Most mimicked Okta sign-in pages, though the kit adapted to other identity providers.</p><p>\n\tOkta noted that the kit could not get past phishing-resistant authentication. The two companies' advice included passkeys or FIDO2 security keys, checks on a caller's identity before help desks reset passwords or MFA and limiting sensitive applications to managed devices.</p><p>\n\tReversingLabs also advised checking DNS, proxy and identity logs going back to October 21 for signs of the campaign.</p>","zhKind","complete","钓鱼","黑产","凭据","https://www.infosecurity-magazine.com/news/inception-extortion-sso-vishing/","Infosecurity Magazine",{"_107":108,"_109":-5},"changelogVersion","2026-10-01T08:00","release"]
