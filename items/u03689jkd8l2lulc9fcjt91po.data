[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795135244000,"id","u03689jkd8l2lulc9fcjt91po","title","NLTK <= 3.10.3 的 WordNet 层级遍历存在无界递归 DoS 漏洞","originalTitle","NLTK: Uncontrolled recursion in WordNet Synset hypernym walkers (max_depth/min_depth/hypernym_paths/hypernym_distances) causes DoS","summary","NLTK <= 3.10.3 的 WordNet `Synset` 层级遍历方法存在无界递归 DoS 漏洞，`max_depth`、`min_depth`、`hypernym_paths` 和 `hypernym_distances` 会遍历攻击者控制的环形或超深超nym指针图并抛出未捕获的 `RecursionError`，影响可用性。","reason","source",{"_71":84},"links",{"_59":83},"publishedAt","2026-11-19T23:49:16.000Z","discoveredAt","2026-11-20T00:02:20.222Z","timelineAt","category","vuln","tags",[80,81,82,74],"score",54,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","readingMode","full","author","body","outline",[],"relatedStories",[76],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","f__Ou_7rMm2Y","reportCount",1,"additionalSourceCount",0,{"_69":30,"_71":75},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","research","name","技术研究","exploited","在野利用","漏洞披露",{"_77":78,"_13":79},"publicId","da78d0eb-9315-4cc9-a727-0c7783b3d77e","NLTK WordNet递归DoS漏洞披露","漏洞","复现","漏洞分析","https://github.com/advisories/GHSA-53pg-5qp8-mhvr","GitHub 安全公告",{"_86":87,"_88":-5},"changelogVersion","2026-10-01T08:00","release"]
