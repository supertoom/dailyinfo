[{"_1":2,"_3":4},"root",{"_5":88},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1794444092000,"id","bx20d36n4uo0oufdrgopcdnhb","title","Criminal IP 在 Splunkbase 发布 TI Feed 应用，自动关联威胁情报与防火墙流量","originalTitle","Criminal IP Launches New TI Feed App on Splunkbase for Automated Threat Detection","summary","AI SPERA 开发的 Criminal IP 在 Splunkbase 发布面向 Splunk 的 TI Feed 应用，用于自动关联恶意 IP 威胁情报与防火墙流量日志。","reason","source",{"_71":87},"links",{"_61":86},"publishedAt","2026-11-11T14:00:05.000Z","discoveredAt","2026-11-11T14:12:40.117Z","timelineAt","category","blue-team","tags",[83,84,85],"score",49,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","CyberNewswire","body",{"_79":-5,"_61":80,"_81":-5,"_82":36},"outline",[],"relatedStories",[75],"topics",[68,69],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fVXgxCaoFjtE","reportCount",1,"additionalSourceCount",0,{"_70":73,"_71":74},{"_70":30,"_71":72},"slug","name","蓝队与运营","tools","工具与平台",{"_76":77,"_13":78},"publicId","74d7ea7b-efa4-4232-b0be-cb00786dbbba","Criminal IP发布Splunk威胁情报关联应用","zh","<p><span><strong>Torrance, USA, November 11th, 2026, CyberNewswire</strong></span></p><p><a href=\"https://www.criminalip.io/\">Criminal IP</a>, the AI-powered threat intelligence and attack surface management platform developed by AI SPERA, has launched the Criminal IP TI Feed app for Splunk. Available through <a href=\"https://splunkbase.splunk.com/app/9625\">Splunkbase</a>, the app automatically correlates Criminal IP threat intelligence with firewall traffic logs collected in Splunk.</p><p>The integration enables security teams to determine whether organizational assets communicated with malicious IP addresses and whether sessions were successfully established. It also expands Criminal IP’s existing Splunk ecosystem beyond individual IP lookups and fraud detection, helping SOC teams identify high-priority threats within their existing Splunk workflows.</p><p><strong>Connecting Threat Intelligence with Network Activity</strong></p><p>Security teams often receive large volumes of IP reputation alerts without enough context to determine whether a connection was attempted, blocked, unanswered, or successfully established. This can make it difficult to distinguish routine scanning from communications that require immediate investigation.</p><p>The Criminal IP TI Feed app addresses this challenge by correlating inbound and outbound threat intelligence feeds with firewall traffic already indexed in Splunk. Network activity is classified according to observed session outcomes, including completed, unanswered, denied, neutral, and unknown connections.</p><p>Severity is also determined using actual firewall activity. Detections without a completed session cannot exceed the watch tier, while critical detections indicate that a session with a malicious IP was successfully established. This helps analysts prioritize incidents with the greatest potential impact.</p><p><strong>Automated Correlation and Retrospective Detection</strong></p><p><strong><img src=\"/dailyinfo/media/adc4779b9054a33d.jpg\" loading=\"lazy\" decoding=\"async\"></strong></p><p><i>&lt;The Criminal IP TI Feed Overview dashboard in Splunk highlights completed sessions with malicious IP addresses and shows which assets require immediate attention.&gt;</i></p><p>The app downloads Criminal IP TI Feed data every three hours and runs correlation searches against firewall traffic every 10 minutes. Results are written to a dedicated summary index, allowing dashboards and alerts to operate without repeatedly searching large volumes of raw logs.</p><p>A daily retrospective search compares the latest Criminal IP threat intelligence against the previous 30 days of firewall traffic. This helps identify historical communications with IP addresses that were not recognized as malicious when the activity originally occurred.</p><p>Seven dashboards- Overview, Investigate, All Detections, IP Lookup, Trends, Alerts, and Health- provide visibility into affected assets, malicious IP addresses, traffic direction, session status, severity, detection history, and feed collection health.</p><p>The app can also deliver consolidated Slack alerts grouped by malicious IP address and traffic direction. These alerts retain asset-level details, including session counts, timestamps, and transferred data, while throttling repeated notifications to reduce alert fatigue.</p><p><strong>Advancing Intelligence-Driven Security Operations</strong></p><p>By connecting external threat intelligence with actual network activity, the Criminal IP TI Feed app provides the context analysts need to identify which assets interacted with malicious infrastructure and which detections require immediate attention.</p><p>Automating feed collection, log correlation, historical analysis, dashboards, and alerts reduces manual investigation and helps SOC teams respond to meaningful threats more efficiently.</p><blockquote><p><strong>AI SPERA CEO Byungtak Kang</strong> stated, “Threat intelligence becomes significantly more actionable when connected to the network activity occurring inside an organization. The Criminal IP TI Feed app for Splunk helps security teams identify affected assets and prioritize incidents based on observed session behavior.”</p></blockquote><p><strong>About Criminal IP</strong></p><p><a href=\"https://www.criminalip.io/\">Criminal IP</a> is AI SPERA’s flagship cyber threat intelligence platform. Used in more than 150 countries, it provides comprehensive threat visibility through Criminal IP Search, Criminal IP ASM, Criminal IP FDS, and Criminal IP TI Feed.</p><p>Criminal IP continues to expand its global security ecosystem through integrations and strategic partnerships. Its threat intelligence is also accessible through major cloud and data marketplaces, including Amazon Web Services, Microsoft Azure, and Snowflake.</p><p>Users can learn more and download the app from Splunkbase:</p><p><a href=\"https://splunkbase.splunk.com/app/9625\">https://splunkbase.splunk.com/app/9625</a></p><h5>Contact</h5><p><span><strong>Michael Sena</strong><br></span><span><strong>AI SPERA</strong><br></span><span><strong><a href=\"https://hackread.com/cdn-cgi/l/email-protection\">[email&nbsp;protected]</a></strong><br></span></p>","zhKind","complete","工具发布","检测工程","安全运营","https://hackread.com/criminal-ip-launches-new-ti-feed-app-on-splunkbase-for-automated-threat-detection/","Hackread",{"_89":90,"_91":-5},"changelogVersion","2026-10-01T08:00","release"]
