[{"_1":2,"_3":4},"root",{"_5":88},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1795135248000,"id","z7hvv6ys0av1dleklhpjcsukl","title","Refitter 2.0.0 存在 OpenAPI 路径注入导致的 RCE","originalTitle","Refitter allows arbitrary code execution through unescaped OpenAPI paths","summary","Refitter 2.0.0 在 .NET 8 下存在由恶意 OpenAPI 路径触发的 RCE。未转义的路径可注入 `[ModuleInitializer]`，生成的客户端被编译并加载时，攻击代码会在应用启动阶段执行，无需 `--skip-validation`。","reason","文章给出可执行的 PoC，并解释了恶意 OpenAPI 路径如何绕过默认校验、注入 ModuleInitializer 并在程序集加载时执行代码。","source",{"_72":87},"links",{"_60":86},"publishedAt","2026-11-20T00:06:04.000Z","discoveredAt","2026-11-20T00:23:20.210Z","timelineAt","category","vuln","tags",[81,82,83,84,85],"score",74,"selected",true,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[67,68,69],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fTRT35A7Ku-E","reportCount",1,"additionalSourceCount",0,{"_70":75,"_72":76},{"_70":31,"_72":74},{"_70":71,"_72":73},"slug","research","name","技术研究","漏洞披露","supply-chain","供应链安全",{"_78":79,"_13":80},"publicId","c4056de4-666b-47c3-8652-2b254a4d48f1","Refitter 2.0.0路径注入可导致RCE","漏洞","复现","漏洞利用","漏洞分析","供应链","https://github.com/advisories/GHSA-3fhm-p725-h3g3","GitHub 安全公告",{"_89":90,"_91":-5},"changelogVersion","2026-10-01T08:00","release"]
