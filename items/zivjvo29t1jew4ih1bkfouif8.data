[{"_1":2,"_3":4},"root",{"_5":128},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795826458000,"id","zivjvo29t1jew4ih1bkfouif8","title","Rapid7 分析 Webworm 定制的 SoftEther VPN 桥接工具 NtMonitor","originalTitle","Spying on Governments with Zero Lines of Malware: A Custom SoftEther Bridge in Webworm’s Toolkit","summary","Rapid7 分析了一个此前未公开的定制 SoftEther 桥接工具 NtMedium Monitor（NtMonitor），以中等置信度归因于中国相关的 APT 组织 Webworm。","reason","文章拆解了 Webworm 定制 SoftEther 桥接工具的隐匿手法，并给出 IoC、YARA 规则与 TLS 流量检测特征，便于防守方对同类改动提前布防。","source",{"_74":127},"links",{"_117":126},"publishedAt","2026-11-19T15:05:34.000Z","discoveredAt","2026-11-19T16:05:22.670Z","timelineAt","category","disclosure","tags",[77,121,79,122,123,124,125],"score",75,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Milan Spinka","body",{"_61":116,"_117":-5,"_118":119,"_120":37},"outline",[86,87,88,89,90,91,92,93,94],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fYv9BiZeJZzY","reportCount",2,"additionalSourceCount",1,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","blue-team","name","蓝队与运营","research","技术研究","malware","恶意软件","rapid7","Rapid7 / Metasploit",{"_83":84,"_13":85},"publicId","c0dfda78-5abc-4ebe-a61f-3567efd7c3f8","Rapid7 归因 Webworm 定制 SoftEther 桥接工具",{"_11":114,"_96":115,"_98":65},{"_11":112,"_96":113,"_98":65},{"_11":110,"_96":111,"_98":105},{"_11":108,"_96":109,"_98":105},{"_11":106,"_96":107,"_98":105},{"_11":103,"_96":104,"_98":105},{"_11":101,"_96":102,"_98":65},{"_11":99,"_96":100,"_98":65},{"_11":95,"_96":97,"_98":65},"sec-9","text","MITRE ATT&amp;CK 技术","level","sec-8","检测指南","sec-7","归因与研究发现的解读","sec-6","加密配置",3,"sec-5","嵌入资源归档","sec-4","网络隐蔽性","sec-3","内部品牌重塑","sec-2","技术分析","sec-1","简介","<h2 id=\"sec-1\">简介</h2><p><span>对威胁行为者而言，完美的恶意软件无需自己编写，而且已经具备他们所需的一切功能。中国关联的 APT 组织 Webworm 就是一个例子，该组织已知会将开源 SoftEther VPN 部署到受入侵政府组织的网络中，以维持低调且长期访问。</span></p><p><span>此事被公开记录、防御人员能够留意这一战术后，该行为者可能开始思考如何让其隐蔽访问更加难以察觉。在本文中，我们分享对我们认为迄今尚未被知晓的、基于 SoftEther 的定制工具的分析。该工具实现了多种隐藏自身以避开安全工具的技巧，我们以中等置信度将其归因于 Webworm。我们还提供有关如何在系统上检测其存在并提取相关配置的指南和工具。</span></p><h2 id=\"sec-2\">技术分析</h2><p><span>为说明该工具的工作方式，我们将使用目前所知该工具唯一的公开样本，该样本可在我们的 IoCs 列表中找到（</span><span><span>90e7…</span></span><span>）。</span></p><p><span>该样本是一个面向 x64 架构的 Windows PE32+ 文件。根据二进制文件中的明文字符串和常量，我们确认它是 SoftEther VPN Bridge 可执行文件的一个（经修改的）构建版本，具体为 4.44 版，构建号 9807。类似地，该可执行文件中包含的 PDB 路径为 </span><span><span>C:\\Users\\Administrator\\Desktop\\SoftEtherVPN_Stable\\SoftEtherVPN_Stable\\SoftEtherVPN_Stable\\src\\DebugFiles\\pdb\\x64_Release\\vpnbridge.pdb</span></span><span>。因此，该工具并未向逆向工程师隐藏其身份，只是隐藏了外部交互。</span></p><p><span>威胁行为者实施的第一项也是最trivial的更改涉及 PE 元数据。由此可知，该二进制文件的 </span><span><span>OriginalFileName</span></span><span> 为 </span><span><span>netcapa.exe</span></span><span>，并将自己标榜为“Network Monitor Software”，发布者为一家名为“Network Systems Solutions Inc.”的公司。与标准 SoftEther 可执行文件（</span><span><span>vpnbridge_x64.exe</span></span><span>）相比，唯一未更改的字段是 </span><span><span>Version</span></span><span>，其值为 </span><span><span>4, 44, 0, 9807</span></span><span>。</span></p><p><span>接下来，我们希望确定威胁行为者新增或修改了哪些功能。SoftEther bridge 本身就是一款功能强大的工具，可用于维持对受入侵网络的远程访问，但我们想知道其中是否可能包含一个后门，使威胁行为者能够在受感染主机上直接执行命令。为此，我们检查了 GitHub 上公开的“SoftEtherVPN_Stable”仓库中对应的标签，并将其与反编译后的样本进行了比较。</span></p><h3 id=\"sec-3\">内部品牌重塑</h3><p><span>暴露出的元数据中可见的品牌重塑也延伸到了内部字符串，包括调试横幅、服务名称、注册表键、服务器的 HTTP 401 错误页面内容以及防火墙规则名称，其中“SoftEther VPN”的出现均被替换为“NtMonitor VPN”。</span></p><p><span>然而，这种重命名并不一致；例如，入口点使用的服务名称仍为 </span><span><span>SEVPNBRIDGE</span></span><span>，且许多注册表键路径仍引用“SoftEther Project”。</span></p><h3 id=\"sec-4\">网络隐蔽性</h3><p><span>标准 SoftEther VPN </span><span><span>Mayaqua/Network.h</span></span><span> 定义了协议使用的 HTTP 终结点：</span></p><pre><code>HTTP_VPN_TARGET &nbsp; \"/vpnsvc/vpn.cgi\"\nHTTP_VPN_TARGET2&nbsp; \"/vpnsvc/connect.cgi\"</code></pre><p><span>NtMonitor 将这些端点替换为听起来无害得多的名称，尤其是：</span></p><pre><code>HTTP_VPN_TARGET &nbsp; \"/update/alive.cgi\"\nHTTP_VPN_TARGET2&nbsp; \"/update/picture.cgi\"</code></pre><p><span>客户端发起与 SoftEther VPN 服务器的连接时，会向 </span><span><span>HTTP_VPN_TARGET2</span></span><span> 发送握手请求，并附带一个“watermark”，即一种字节模式，用于证明客户端正在使用正确的 VPN 协议。否则，服务器会返回一个诱饵 HTTP 响应。</span></p><p><span>NtMonitor 使用自定义字节模式（一个显示 Windows 标志的截断 PNG 文件）更改上游 GIF 水印，使标准版 SoftEther 客户端和服务器无法与此构建完成握手，并且 NtMonitor 自身的节点也不会因广为人知的标准版 GIF 水印而被指纹识别。</span></p><h3 id=\"sec-5\">嵌入资源归档</h3><p><span>威胁行为者可能意识到，位于安装目录中可执行文件旁边且运行时必须存在的 SoftEther 资源归档 hamcore.se2，为发现未授权安装提供了一个直接机会。我们认为，正因如此，该行为者选择将此归档的内容精简到最低限度，将归档打包进 bridge 可执行文件本身（作为 PE 资源），并实现自定义资源目录遍历以在运行时加载该归档。其副作用是，与官方构建相比，该二进制文件大小增加了约 1.5 MB。</span></p><h3 id=\"sec-6\">加密配置</h3><p><span>标准版 SoftEther 的另一个弱点（对攻击者而言）是，其配置以明文形式存储在磁盘上，且采用易于识别的格式。该行为者将其名称从 </span><span><span>vpn_bridge.config</span></span><span> 更改为 </span><span><span>setting.conf</span></span><span>，并修改配置加载器以处理以 ASCII 形式呈现的魔术字节 </span><span><span>RCEN</span></span><span> 开头的自定义加密文件。加密文件的其余部分采用简单格式，并包含加密密钥。用于使用该行为者的自定义类 RC4 密码解密此类文件的 Python 脚本，可在 Rapid7 Intelligence 的 GitHub 仓库中<a href=\"https://github.com/rapid7/Rapid7-Labs/tree/main/Malware%20Config%20Extractors/webworm_rcen_decrypt.py\"><span>获取</span></a><span>。</span></span></p><h2 id=\"sec-7\">归因与研究发现的解读</h2><p><span>除上述更改外，我们未发现任何额外的恶意软件功能。显然，该威胁行为者将隐蔽性置于原始能力之上。他们似乎有条不紊地分析了 SoftEther 的检测面，并针对检测工程师可能采用的所有简单检测方式实施了反制措施。在我们分析时，尽管该样本自 1 月起就已公开，但在 VirusTotal 上只有一家反病毒厂商检测到了它。</span></p><p><span>这与 ESET 此前报告的 Webworm 的 TTP 高度吻合<a href=\"https://www.welivesecurity.com/en/eset-research/webworm-new-burrowing-techniques/\"><span>此前报告</span></a><span>，而 Rapid7 Intelligence 可访问的解密配置中的各项指标也进一步支持了这种归因。在所有案例中，该 VPN 均被配置为将远程网络桥接（“级联”）到本地网络；此外，在不太可能是有意测试的案例中，远程 IP 地址位于 AS 20473 内，归属 The Constant Company, LLC；该公司（连同其子公司 Vultr）过去曾多次与 Webworm 关联。</span></span></p><p><span>基于这一归因，我们可以总结出一些重要结论：我们很可能看到的是 Webworm 所使用工具的一次新演变。Webworm 是一个与中国结盟的 APT，其已知活动主要针对政府组织，尤其是在欧洲。今年早些时候，ESET 已经指出该组织正在从自定义恶意软件转向 SoftEther VPN 等双用途工具，但现在我们观察到的是两者的一种混合形式——使用未被</span><span><em>植入木马</em></span><span>的原版 SoftEther 软件，但经过从源代码重新构建，从而消除了其大部分检测指纹。</span></p><h2 id=\"sec-8\">检测指南</h2><p><span>为了检测 Webworm 这一特定变种所使用的工具，我们在公开的 GitHub 仓库中提供了一个 </span><a href=\"https://github.com/rapid7/Rapid7-Labs/tree/main/IOCs/Webworm_NtMonitor_IOCs.txt\"><span>IoC 列表</span></a><span> 和一个 </span><a href=\"https://github.com/rapid7/Rapid7-Labs/tree/main/Yara/Webworm_NtMonitor.yar\"><span>YARA 规则集</span></a><span>。如果您所在的组织能够检查 TLS 流量，那么目前可以部署的最可靠检测方法之一，是查找发往 </span><span><span>/update/picture.cgi</span></span><span>、带有 </span><span><span>Content-Type: image/jpeg</span></span><span> 且请求正文以 </span><span><span>89 50 4e 47 0d 0a 1a 0a 00 00 00 0d 49 48 44 52</span></span><span> 开头的 </span><span><span>POST</span></span><span> 请求（自定义 PNG 水印的初始字节）。</span></p><p><span>尽管我们看到的样本在内部都使用相同的 NtMonitor 标识（尽管不同样本的 PE 元数据有所差异），但这是威胁行为者接下来最容易实施的变化。同样，HTTP 端点和水印也可以轻松替换。因此，我们建议政府部门的防御人员熟悉 SoftEther VPN 的固有行为，以便在威胁行为者决定下次更新该工具时始终领先一步。</span></p><h2 id=\"sec-9\">MITRE ATT&amp;CK 技术</h2><table><tbody><tr><td><p><span><strong>技术 ID</strong></span></p></td><td><p><span><strong>技术名称</strong></span></p></td><td><p><span><strong>备注</strong></span></p></td></tr><tr><td><p><span>T1587.001</span></p></td><td><p><span>开发能力：恶意软件</span></p></td><td><p><span>该行为者维护着用于恶意目的的自有 SoftEther VPN 分支。</span></p></td></tr><tr><td><p><span>T1027.013</span></p></td><td><p><span>混淆文件或信息：加密/编码文件</span></p></td><td><p><span>配置文件使用自定义密码算法加密。</span></p></td></tr><tr><td><p><span>T1140</span></p></td><td><p><span>解混淆/解码文件或信息</span></p></td><td><p><span>加密的配置文件在启动时由修改后的加载器解密。</span></p></td></tr><tr><td><p><span>T1036.005</span></p></td><td><p><span>伪装：匹配合法资源名称或位置</span></p></td><td><p><span>PE 元数据被有意更改，以伪装成通用的系统服务。</span></p></td></tr><tr><td><p><span>T1027.005</span></p></td><td><p><span>混淆文件或信息：从工具中移除指标</span></p></td><td><p><span>已知的 SoftEther 痕迹被系统性地从二进制文件中移除。</span></p></td></tr><tr><td><p><span>T1686.003</span></p></td><td><p><span>禁用或修改系统防火墙：Windows 主机防火墙</span></p></td><td><p><span>该恶意软件利用原版 SoftEther 功能向系统防火墙添加规则。</span></p></td></tr><tr><td><p><span>T1599</span></p></td><td><p><span>网络边界桥接</span></p></td><td><p><span>VPN 网桥将受感染主机的局域网与攻击者的局域网绑定在一起。</span></p></td></tr><tr><td><p><span>T1071</span></p></td><td><p><span>应用层协议</span></p></td><td><p><span>C2 通信使用 HTTP(S) 和 SoftEther 应用协议。</span></p></td></tr><tr><td><p><span>T1090.001</span></p></td><td><p><span>代理：内部代理</span></p></td><td><p><span>受感染主机充当内部代理，为网络中其他主机的 C2 访问进行中继。</span></p></td></tr></tbody></table>","original","zhKind","translation","complete","逆向","后门","检测工程","Rapid7","ESET","https://www.rapid7.com/blog/post/tr-spying-on-governments-no-malware-custom-webworms-toolkit-softether-bridge","Rapid7 CVE 公告",{"_129":130,"_131":-5},"changelogVersion","2026-10-01T08:00","release"]
