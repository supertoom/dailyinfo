[{"_1":2,"_3":4},"root",{"_5":127},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794185103000,"id","m3f4nnw16zmvoc10ccus1uoni","title","Operation CloudFire 利用 Google Calendar 邀请劫持会话并绕过 MFA","originalTitle","Google Calendar phishing campaign hijacks sessions, bypasses MFA","summary","Material Security 披露 Operation CloudFire 自 2026 年 8 月中旬起以 Google Calendar 邀请钓鱼，通过 Google 跳转链接、Cloudflare Turnstile 和动态密码捕获页搭建实时反向代理，截获 SMS、身份验证器、Tap-Yes 验证及账户恢复信息，绕过 MFA。","reason","文章拆解了借 Google Calendar 邀请实施会话劫持的链路，并展示基础设施处置如何压缩攻击者的重建成本。","source",{"_75":126},"links",{"_117":125},"publishedAt","2026-11-04T15:00:10.000Z","discoveredAt","2026-11-04T15:22:22.749Z","timelineAt","category","activity","tags",[76,121,122,78,123,124],"score",77,"selected",true,"channel","news","story",{"_86":87,"_13":88},"x","readingMode","full","author","Sponsored by Material Security","body",{"_61":116,"_117":-5,"_118":119,"_120":37},"outline",[89,90,91,92,93,94,95,96],"relatedStories",[85],"topics",[68,69,70,71,72],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fKb7YHgTNPYY","reportCount",1,"additionalSourceCount",0,{"_73":83,"_75":84},{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","attack","name","攻击活动","exploited","在野利用","email","邮件与钓鱼","identity","身份与访问","google","Google / 谷歌",{"_86":87,"_13":88},"publicId","58eec7d5-4bd7-4776-9a8b-2bb84d31d8fd","Operation CloudFire劫持会话并绕过MFA",{"_11":114,"_98":115,"_100":101},{"_11":112,"_98":113,"_100":101},{"_11":110,"_98":111,"_100":101},{"_11":108,"_98":109,"_100":101},{"_11":106,"_98":107,"_100":101},{"_11":104,"_98":105,"_100":101},{"_11":102,"_98":103,"_100":101},{"_11":97,"_98":99,"_100":101},"sec-8","text","当前情况","level",2,"sec-7","一个月内的数据","sec-6","Operation CloudFire：针对基础设施","sec-5","损害最终落在哪里","sec-4","防御该活动的情况","sec-3","为什么各项控制措施未被触发","sec-2","捕获：置于 Google 登录页面之前的反向代理","sec-1","诱饵：Google Calendar 邀请","<p><img alt=\"Calendar\" height=\"900\" src=\"/dailyinfo/media/874a652f95259dac.jpg\" srcset=\"/dailyinfo/media/9f1df007741683ce.jpg 720w, /dailyinfo/media/c70110ef33439b40.jpg 1200w, /dailyinfo/media/874a652f95259dac.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>自 2026 年 8 月中旬以来，一起网络钓鱼行动一直在窃取企业用户的有效 Google 会话。防御人员通常用来判断链接可信度的每一种信号都给出了令人安心的结果，而攻击者正是有意按照这种方式搭建了整条攻击链。</p><p>Material Security 的威胁研究团队识别出了该活动，并下线了攻击者使用的数百个域名，他们将此次行动称为 Operation CloudFire。以下是他们在此过程中发现的详情。</p><h2 id=\"sec-1\">诱饵：Google Calendar 邀请</h2><p>这些消息以 Google Calendar 邀请的形式送达，有时通过密送发送，而且通常来自收件人此前已经联系过的组织。借口都很日常：语音信箱通知、RFP 和 RFI 请求、法院传票以及付款逾期通知。</p><p>大多数链接指向 Google 本身。典型模式是使用 Google 自带的 /url 重定向器，并将真实目的地放在查询参数中，不过其他攻击波次也使用 share.google 和 Drive 文件链接来实现同样目的。其中一个变种使用了 Intuit 交易通知链接。</p><p>在每一种情况下，对消息进行评分时，所显示的域名、证书和信誉都是合法且值得信任的。</p><h2 id=\"sec-2\">捕获：置于 Google 登录页面之前的反向代理</h2><p>攻击者在真正的 Google 登录页面前运行一个实时反向代理。受害者输入密码、收到真实提示并进行批准，与此同时，攻击者可以实时监视该会话。</p><p>服务器会在每个 SMS 验证码、身份验证器验证码、Google 的 Tap-Yes 号码匹配以及基于电话的账户恢复信息到达时，将其转发给 Google，因此没有任何第二因素控制措施能够阻止会话被捕获。</p><p>其背后的框架 Nyasher 自 2 月起已被公开记录，当时人们在其 JavaScript 中发现了一个硬编码密钥。</p><p><img alt=\"Attack flow\" height=\"600\" src=\"/dailyinfo/media/32f59ec62d96b4ad.webp\" srcset=\"/dailyinfo/media/dd10a9c9219c21b3.webp 720w, /dailyinfo/media/5f51b8a8c3747544.webp 1200w, /dailyinfo/media/32f59ec62d96b4ad.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"766\"></p><h2 id=\"sec-3\">为什么各项控制措施未被触发</h2><p>信誉系统回答的是一个关于所有权的问题：谁注册了该域名，它还承载过哪些内容，以及是否有人投诉过它。这次活动的构建方式确保了这些答案始终显得正常无害，并且它包含三层。</p><p>第一层是 Google 的重定向器。第二层是 Cloudflare Turnstile 质询，在某些构建中，这实际上是由 Cloudflare 自身基础设施提供的真实组件。第三层是捕获密码的页面本身，该页面没有可供扫描的静态网站。</p><p>JavaScript 会在访客通过质询后，于浏览器中构建该页面，因此爬虫没有任何内容可供抓取，代理日志也没有任何内容可供记录。据 Material 所知，在此次活动被记录之前，从未有人扫描过这些页面。</p><p>该基础设施在设计上就是一次性的。最初观察到的活动使用了分布在多个注册商处的众多诱饵域名，其中大多数仅在启用前数天才注册。接收端点会提前 1 至 20 天部署，以便为它们服务的攻击波次做好准备。</p><p>有一张通配符证书的签发时间比其涵盖域名的注册时间早了 46 分钟。屏蔽其中任何一个组件，攻击者只需花费几美元和一个下午的工作。</p><h2 id=\"sec-4\">防御该活动的情况</h2><p>Material 从该活动开始就一直在追踪它，跟踪每个变种在诱饵、门控和接收端点轮换时的变化。自 8 月该活动被识别并构建检测规则以来，Material 已捕获超过 99% 的恶意消息，重新分类率为 0.01%。</p><p>随着攻击者改变其 TTP、主题和诱饵文本，以规避静态、ML 和智能体检测，这一直是一项持续的工作。</p><p>这种方法之所以有效，是因为没有任何单一信号能够决定结果。仅凭信誉评分无法发现它，单独进行链接分析也不行，因为第一个跳转是 Google URL，而最终页面要等浏览器构建后才会存在。</p><p>Material 会综合评估技术指标、消息的表面意图、链接实际解析到的位置，以及消息背后的发送关系。其中任何一项都可能足以采取行动。</p><p>围绕单一信号构建的检测会继承该信号的盲区，而该运营者已投入大量精力绘制这些盲区。</p><p>分析运行的位置同样重要。日历邀请并不适合由旨在检查传输中邮件的网关处理，但此次活动中很大一部分内容正是以邀请形式送达的。</p><p>Material 将日历邀请视为独立的风险面，并在分析技术信号的同时，使用该账户的完整历史记录作为上下文。</p><h2 id=\"sec-5\">损害最终落在哪里</h2><p>当结果是劫持会话而非窃取密码时，证据会出现在 Workspace 审计日志中。有效的 Google 会话能够访问邮件、Drive，并能够以受害者名义授予 OAuth 访问权限，因此影响范围远超收件箱。</p><p>防御方应提出两个问题：谁在审查这些日志，以及多快能够据此采取行动？同样重要的是，团队能否在一小时内撤销会话、限制 OAuth 授权并重置受影响的账户。</p><p>许多项目做不到这一点，而拥有有效会话的攻击者在这段时间内可以完成大量操作。</p><h2 id=\"sec-6\">Operation CloudFire：针对基础设施</h2><p>到 9 月下旬，Material 得出结论，仅靠调整规则、重新训练模型和更新代理程序无法解决问题。检测能够保护客户，却对该运营者准备下一波攻击毫无作用。</p><p>因此，Material 的威胁研究团队发起 Operation CloudFire，直接针对基础设施。</p><p>团队在消息发送期间分析网关和后端 URL，并通过 Cloudflare 的滥用举报系统进行举报。Cloudflare 滥用团队验证了虚假过渡页及其背后的代理 Google 登录页面，随后对这些目标应用了自己的钓鱼过渡页。</p><p>这产生了两方面效果。攻击者的基础设施遭到“烧毁”：每个被举报的网关和接收端点都必须重新注册、重新指向并重新认证，运营者才能再次发送。更广泛的互联网同样从中受益。</p><p>任何点击被举报链接的人，无论是否为 Material 客户，看到的都是警告页面，而不是凭据表单。</p><h2 id=\"sec-7\">一个月内的数据</h2><p>这些数字仅来自同意与 Material 共享数据的客户，因此实际总数更高。在 Operation CloudFire 开展的一个月内，Material 记录到：</p><ul>\n\t<li>阻止了 68,676 封活动消息</li>\n\t<li>分析了 2,112 个恶意 URL</li>\n\t<li>下架了 897 个域名</li>\n\t<li>6,354 个根域名下共有 8,570 个被攻陷的发件地址</li>\n\t<li>发送节奏遵循美国工作时间</li>\n</ul><figure><img alt=\"Message delivery time of day heat map\" height=\"600\" src=\"/dailyinfo/media/4d450bc2374bd18b.jpg\" loading=\"lazy\" decoding=\"async\" width=\"514\">\n<figcaption><strong>消息投递时间热力图</strong></figcaption>\n</figure><p>发件地址数量体现了该活动如何建立可信度。每个被攻陷的地址都对应一个在首封邀请发出前就已由攻击者控制的账户，并且每个地址都会向受害者保存的联系人以及其他地址发送邀请。</p><p>收件人看到的是自己熟悉的姓名或域名，来自历史记录干净的域名，而且发送时间合理。信誉信息源没有任何理由将其标记为可疑，因此每个用于评估归属和历史记录的层面都返回了令人安心的结果。</p><h2 id=\"sec-8\">当前情况</h2><p>钓鱼主题已从日历邀请转向 Google Drive 文件和文档共享邀请。Material 尚未看到其他诱饵或 TTP 出现相应增长，来自该组织的活动似乎已经分散。此次攻击活动看起来已经结束。</p><figure><img src=\"/dailyinfo/media/2ada63f3bd83754e.webp\" srcset=\"/dailyinfo/media/fa4b2435251c72c0.webp 720w, /dailyinfo/media/0cded6bcae5eac05.webp 1200w, /dailyinfo/media/2ada63f3bd83754e.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Messages detected by week\" height=\"600\" width=\"824\">\n<figcaption><strong>按周检测到的消息</strong></figcaption>\n</figure><figure><img src=\"/dailyinfo/media/c2c299140879e9f0.webp\" srcset=\"/dailyinfo/media/a35337336bd0a780.webp 720w, /dailyinfo/media/03ed1da0cb48018c.webp 1200w, /dailyinfo/media/c2c299140879e9f0.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Domains registered by interval\" height=\"600\" width=\"808\">\n<figcaption><strong>按时间段注册的域名</strong></figcaption>\n</figure><p>这是一份状态更新，而不是最终结论。重建基础设施的成本很低，该框架自 2 月起就已公开，而且该运营者还发布了一个未完成的 Microsoft 365 分支，与正在使用的 Google 代码并行。</p><p>该分支包含一个样式表路径、一个第二套测试工具，以及一个可解码为 Microsoft 登录提示的标题字符串。目前这些路径均无法解析，添加该品牌只需放入一个文件，无需更改任何代码。</p><p>该运营者已经构建了后续版本，但尚未启用。<a href=\"https://material.security/?utm_campaign=54746213-ABM-AI%20Leading&amp;utm_source=bleeping-computer&amp;utm_medium=Third%20Party\">Material</a> 将主题轮换视为持续迭代而非退出，并预计下一次转向会与此次非常相似，只是更换一个品牌。</p><p><strong>完整的技术分析（包括指标和时间线）可在<a href=\"https://content.material.security/hubfs/Material%20Security%20Site%20CMS/CalendarInviteWhitepaper-sep2026.pdf\">配套白皮书</a>中获取。正在自身环境中搜寻此类活动的团队应从那里开始。</strong></p><p><i>由 <a href=\"https://www.bleepingcomputer.com/news/security/google-calendar-phishing-campaign-hijacks-sessions-bypasses-mfa/material.security/?utm_campaign=54746213-ABM-AI%20Leading&amp;utm_source=bleeping-computer&amp;utm_medium=Third%20Party\">Material Security</a> 赞助并撰写。</i></p>","original","zhKind","translation","complete","钓鱼","凭据","Google","Cloudflare","https://www.bleepingcomputer.com/news/security/google-calendar-phishing-campaign-hijacks-sessions-bypasses-mfa/","BleepingComputer",{"_128":129,"_130":-5},"changelogVersion","2026-10-01T08:00","release"]
