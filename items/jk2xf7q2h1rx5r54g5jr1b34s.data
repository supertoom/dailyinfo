[{"_1":2,"_3":4},"root",{"_5":103},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":60,"_61":62},"expiresAt",1795826442000,"id","jk2xf7q2h1rx5r54g5jr1b34s","title","研究人员接管 Hugging Face 上 Kokoro 模型账户并演示模型投毒","originalTitle","Researchers hijack Hugging Face account for popular Kokoro AI model","summary","研究人员因 Hugging Face 缺少发布者所有权验证，通过注册原所有者公开域名并重置密码接管 Kokoro 账户。团队在本地通过修改模型权重，使相同输入文本生成与原文不一致的音频，87 秒即可完成，且未改动推理代码、上传恶意代码或改变发布者外观。","reason","研究者通过接管模型发布账户并修改权重，展示了开放模型供应链中不依赖恶意代码的攻击路径。","source",{"_73":102},"links",{"_62":101},"publishedAt","2026-11-17T18:21:24.000Z","discoveredAt","2026-11-17T18:49:31.533Z","timelineAt","category","ai-security","tags",[74,96,97,76,98,99,100],"score",79,"selected",true,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","Bill Toulas","body",{"_92":-5,"_62":93,"_94":-5,"_95":60},"outline",[83,84],"relatedStories",[79],"topics",[69,70,71],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation",false,"bodyLanguage","original","factId","fbRMEqLosH2E","reportCount",2,"additionalSourceCount",1,{"_72":77,"_73":78},{"_72":75,"_73":76},{"_72":31,"_73":74},"slug","name","AI 安全","research","技术研究","supply-chain","供应链安全",{"_80":81,"_13":82},"publicId","1a07056c-cfa7-44a2-b1f4-18ab0a5616d3","研究人员接管Kokoro账号并本地演示投毒",{"_11":89,"_86":90,"_88":91},{"_11":85,"_86":87,"_88":66},"sec-2","text","Uncover email threats your existing defenses may miss.","level","sec-1","A broader trust problem",3,"zh","<p><img alt=\"Researchers hijack Hugging Face account for popular Kokoro AI model\" height=\"900\" src=\"/dailyinfo/media/6087ea93367ec02b.jpg\" srcset=\"/dailyinfo/media/a9bc5469c5c046ad.jpg 720w, /dailyinfo/media/d78eb7bdeb3b7b34.jpg 1200w, /dailyinfo/media/6087ea93367ec02b.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>A Lack of ownership verification on the Hugging Face platform allowed researchers to take control of Kokoro, a text-to-speech model used in projects from Google, NVIDIA, AMD, Intel, and Amazon Web Services.</p><p>An attacker hijacking the account could use it as a distribution channel in supply-chain attacks, potentially leading to data theft or code execution.</p><p>However, the researchers demonstrated a stealthier attack: they modified the model's weights so it produced audio that differed from the input text, without changing the underlying application code.</p><p><a href=\"https://www.wiz.io/lp/securing-ai-agents-101?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY26Q3_INB_FORM_Securing-AI-Agents-101&amp;sfcid=701Py00000RTEWMIA5&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AI-Agents-101\"><img src=\"/dailyinfo/media/c1cd566f1acfeb07.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>Because only the weights change, there is no malicious code or signature for malware scanners to detect, the researchers say.</p><p>\"We changed what this model says by fine-tuning its neural weights. Same input text. Same voice file. Same configuration. Same inference code — not a single line touched in the application that runs it,\" said security analyst <a href=\"https://www.linkedin.com/in/alon-hertz/\">Alon Hertz</a>.</p><p><a href=\"https://huggingface.co/hexgrad/Kokoro-82M\">Kokoro</a> is an open-weight model that converts text into speech. It supports multiple languages and has more than 50 voice presets.</p><p>Although its developer, Hexgrad, has not pushed an update since April 2025, the project continues to be popular, with nearly 13 million monthly downloads on Hugging Face. The <a href=\"http://github.com/hexgrad/kokoro\">GitHub repository</a> and the <a href=\"http://pypi.org/project/kokoro/#files\">Python package on PyPI</a> also went silent around the same time.</p><p>Kokoro is supported by developer tools from Google, NVIDIA, and Intel, including software for voice agents and on-device speech synthesis. AMD and Amazon Web Services have also published guides demonstrating its use in AI-agent workflows.</p><p>Hertz and his team took control of the Kokoro account on Hugging Face by simply registering the domain used by the original owner and resetting the login password.</p><p>Over the past weekend, the researchers registered the “hexgrad.com” domain listed on Kokoro’s <a href=\"https://huggingface.co/hexgrad/Kokoro-82M/blob/main/DONATE.md\">public DONATE.md file</a> and used it to perform a password reset on the publisher’s account.</p><p>They then ran a controlled test in which they modified Kokoro’s model weights in 87 seconds using a gaming GPU, causing the model to produce poisoned output.</p><p><a href=\"http://medium.com/@alonhertz1/one-click-from-180-million-downloads-taking-over-the-hugging-face-account-behind-an-ai-model-ac61c16305b7\">Hertz says</a> the team tested the modified Kokoro model locally using its normal inference pipeline, but never uploaded the modified weights to Hugging Face, as that would likely put at risk many production systems depending on the model.</p><p>The researcher underlines that an update would still carry all the hallmarks of a legitimate release, as tests from another account showed that Hugging Face would not flag anything as suspicious.</p><p>Despite the takeover, the publisher appeared the same, just like the file delivery route, the format, and the architecture. File sizes would be similar, and the release would contain no malware.</p><h3 id=\"sec-1\">A broader trust problem</h3><p>The researcher notes that the supply-chain risk from compromised publisher accounts distributing altered weights via routine updates to systems that automatically fetch new revisions is significant.</p><p>Kokoro was just a high-profile example the team used to highlight the issue.</p><p>Hertz says even non-hijacked accounts could pose a risk, as anyone can curate an ostensibly legitimate image for a period of time, then push a malicious update at some point.</p><p>“Hugging Face does not vet publishers. It doesn’t verify whether an account is still held by its original, legitimate owner — or by whoever quietly took it over last week. It doesn’t vet the models or datasets those accounts upload,” Hertz says.</p><p>“The same unvetted weights and datasets flow through mirrors and converted versions, GitHub releases, package registries, deployment guides, and direct downloads across the entire open-model ecosystem,” added the researcher.</p><p>Hertz reported the issue to Hugging Face, hoping for quick action, but received no response.</p><p>BleepingComputer has also contacted Hugging Face for comments, but we have not received a response yet.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/a3aef6170ea13c62.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-2\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Uncover email threats your existing defenses may miss.</a>\n        </h2><p>Adaptive Security's AI agents analyze email intent, context, and behavior to uncover phishing, business email compromise, and invoice fraud.</p><p>See what's getting through with a 14-day read-only scan of Microsoft 365 or Google Workspace, with no MX changes.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Start your free email security scan.</a>\n    </p>","zhKind","complete","模型安全","AI 供应链","供应链投毒","Google","AWS","https://www.bleepingcomputer.com/news/security/researchers-hijack-hugging-face-account-for-popular-kokoro-ai-model/","BleepingComputer",{"_104":105,"_106":-5},"changelogVersion","2026-10-01T08:00","release"]
