[{"_1":2,"_3":4},"root",{"_5":102},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1793591188000,"id","rowk7nbnamq9xb79zqfp85toi","title","Sony Network Communications 数据泄露暴露 2,585,481 条客户记录","originalTitle","Sony ISP subsidiary data breach exposes 2.5 million customer records","summary","Sony Group Corporation 旗下 Sony Network Communications 确认，未经授权方访问 So-net 会员数据库，导致 2,585,481 条现任及前任客户记录外泄，另有 54,401 个邮箱地址和账户密码暴露；银行、支付卡及其他账户详情未受影响。","reason","事件披露了2,585,481条客户记录及54,401个邮箱和密码外泄，并给出受影响服务范围与钓鱼仿冒提醒。","source",{"_74":101},"links",{"_93":100},"publishedAt","2026-10-28T16:45:47.000Z","discoveredAt","2026-10-29T00:15:59.083Z","timelineAt","category","activity","tags",[97,75,98,99],"score",74,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Bill Toulas","body",{"_61":92,"_93":-5,"_94":95,"_96":37},"outline",[86],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fic_ZS84wMw8","reportCount",1,"additionalSourceCount",0,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","attack","name","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","email","邮件与钓鱼",{"_83":84,"_13":85},"publicId","fad34ac9-cbc0-4abf-8abf-3f812a59d374","索尼网络通信确认客户数据泄露",{"_11":87,"_88":89,"_90":91},"sec-1","text","一旦攻击者拥有有效凭据，其操作只有 37% 会被阻止","level",2,"<p><img alt=\"Sony ISP subsidiary data breach exposes 2.5 million customer records\" height=\"900\" src=\"/dailyinfo/media/35dbe240685a476e.jpg\" srcset=\"/dailyinfo/media/f9f53f43e12c8f18.jpg 720w, /dailyinfo/media/26d9eecc750f9755.jpg 1200w, /dailyinfo/media/35dbe240685a476e.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>Sony Network Communications 已确认发生数据泄露，约 2.5 million 条记录被攻破，其中包含现有和 former 客户的个人信息。</p><p>作为 Sony Group Corporation 的子公司，该公司提供电信和技术服务，并在日本担任互联网服务提供商（ISP）。</p><p>泄露发生于 October 19，四天后被发现，当时公司关闭了受影响的服务器并阻止外部通信。</p><p>在<a href=\"https://www.sonynetwork.co.jp/corporation/release/2026/v5e5u00000000zwj-att/20261027.pdf\">昨日发布的公告</a>中，公司表示其支持互联网接入服务的 So-net 会员数据库被未经授权方访问。</p><p>调查确认共有 2,585,481 条客户记录被暴露，包括以下类型的信息：</p><ul>\n\t<li>姓名</li>\n\t<li>电话号码</li>\n\t<li>电子邮件地址</li>\n\t<li>用户 ID</li>\n\t<li>出生日期</li>\n\t<li>性别</li>\n\t<li>Internet Connection IDs</li>\n</ul><p>银行账户、支付卡或其他账户详细信息均未暴露。</p><p>另有来自多个电子邮件服务的 54,401 个电子邮件地址连同账户密码也被暴露。公司建议用户更改密码。</p><p>在已暴露记录的明细中，Sony Network Communications 表示其中有 2,141,986 条 So-net 记录和 443,495 条 plala（S Course）记录。后者还影响了另一家互联网服务提供商 NTT Docomo，该公司委托 Sony Network Communications 提供 Docomo Hikari 服务。</p><p>NTT Docomo 还<a href=\"http://www.docomo.ne.jp/info/notice/page/261027_05_m.html\">通知了客户</a>，并<a href=\"http://www.docomo.ne.jp/info/notice/page/261027_00.html\">警告提防钓鱼邮件</a>和冒充其 d POINT Club 及 Universal Studios Japan（USJ）活动的虚假网站，这些网站谎称收件人已中奖，并诱导他们输入个人信息以领取门票。</p><p>Docomo 表示，该事件影响所有现有 Hikari 服务客户，以及过去六个月内取消服务的客户。</p><p>Sony 已向日本个人信息保护委员会报告该事件，并正在调查其原因和影响范围。</p><p>截至 October 27，两家公司均未确认暴露的数据在外部被滥用。</p><p>自年初以来，日本多家高价值公司和提供商遭遇了多次网络攻击。</p><p>最近的一起事件发生在 <a href=\"https://www.bleepingcomputer.com/news/security/japans-gmo-urges-customers-to-shut-down-pcs-amid-ransomware-threat/\">GMO Internet Group</a> 及其 Onamae Desktop Cloud 服务，该服务遭受了大范围<a href=\"https://www.bleepingcomputer.com/news/security/japans-onamae-desktop-cloud-hacked-up-to-27-000-servers-affected/\">针对客户服务器的恶意软件攻击</a>。</p><p>电信巨头 <a href=\"https://www.bleepingcomputer.com/news/security/japanese-telecom-giant-kddi-says-data-breach-affects-12-million-people/\">KDDI 遭遇了影响 12 million 名客户的泄露，</a>而 <a href=\"https://www.bleepingcomputer.com/news/security/ransomware-attack-disrupts-japans-idcf-cloud-used-by-govt-clients/\">IDC Frontier 成为了勒索软件攻击目标</a>。</p><p>此前，NTT 于 2025 年初遭到黑客攻击，黑客访问了其系统，并<a href=\"https://www.bleepingcomputer.com/news/security/data-breach-at-japanese-telecom-giant-ntt-hits-18-000-companies/\">窃取了 18,000 家企业客户的数据</a>。</p><p>近期数据泄露的频率空前且威胁严重，以至于<a href=\"https://www.japantimes.co.jp/news/2026/10/26/japan/japan-government-cybersecurity/\">日本政府于 Monday 举行了紧急会议</a>，以制定应对措施。</p><p><a href=\"https://hubs.li/Q04sB3fb0\">\n            <img src=\"/dailyinfo/media/f74efd6d74a2d601.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://hubs.li/Q04sB3fb0\">一旦攻击者拥有有效凭据，其操作只有 37% 会被阻止</a>\n        </h2><p>整体预防评分可能掩盖初次访问之后发生的情况。一旦攻击者开始使用有效凭据，预防效果就会大幅下降。</p><p>Blue Report 2026 基于在客户生产环境中运行的 338 million 次模拟，按技术逐项衡量防御能力。</p><p><a href=\"https://hubs.li/Q04sB3fb0\">获取报告</a>\n    </p>","original","zhKind","translation","complete","数据泄露","数据窃取","钓鱼","https://www.bleepingcomputer.com/news/security/sony-isp-subsidiary-data-breach-exposes-25-million-customer-records/","BleepingComputer",{"_103":104,"_105":-5},"changelogVersion","2026-10-01T08:00","release"]
