[{"_1":2,"_3":4},"root",{"_5":111},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794185101000,"id","f1ouf60ewvurduuj73co4r1ov","title","LodaRAT 以伪造美国法院通知钓鱼，已针对逾 100,000 家企业","originalTitle","Fake US Court Notices Target 100,000+ Businesses With LodaRAT","summary","LodaRAT 通过冒充美国佛罗里达南区联邦地区法院的替代性争议解决案件通知，针对超过 100,000 家企业投放恶意软件。诱导页面仅向使用 Microsoft Edge 的访客展示内容，下载的密码保护压缩文件包含 MSC、批处理和 Windows 快捷方式三种文件，任一文件执行后均从 us.wind0ws.net 下载同一恶意软件。","reason","材料展示了个性化法律主题钓鱼如何借助受限浏览器访问和多种载荷路径投递 LodaRAT，并给出持久化与监控能力细节。","source",{"_76":110},"links",{"_102":109},"publishedAt","2026-10-28T10:04:16.000Z","discoveredAt","2026-10-28T11:02:46.758Z","timelineAt","category","activity","tags",[79,106,77,107,108],"score",83,"selected",true,"channel","news","story",{"_89":90,"_13":91},"x","readingMode","full","author","Deeba Ahmed","body",{"_61":101,"_102":-5,"_103":104,"_105":37},"outline",[92,93],"relatedStories",[88],"topics",[68,69,70,71,72,73],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fbUljoW38KA4","reportCount",1,"additionalSourceCount",0,{"_74":86,"_76":87},{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","malware","name","恶意软件","attack","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","email","邮件与钓鱼","microsoft","Microsoft / 微软",{"_89":90,"_13":91},"publicId","aa92a5cd-f72b-4ef1-8058-61043a1fbed7","法院通知钓鱼投递LodaRAT",{"_11":99,"_95":100,"_97":98},{"_11":94,"_95":96,"_97":98},"sec-2","text","LodaRAT 如何维持访问权限","level",3,"sec-1","三种途径投放同一恶意软件","<p>伪造的美国法院通知针对超过 100,000 家企业，诱骗收件人下载 LodaRAT 恶意软件；该恶意软件可窃取密码、记录活动并控制计算机。</p><p>ThreatDown 的网络安全研究人员发现了一场大规模<a href=\"https://hackread.com/?s=phishing\">网络钓鱼活动</a>，其冒充美国佛罗里达州南区联邦地区法院。该行动迄今已利用有关替代性争议解决（ADR）案件的虚假通知针对超过 100,000 家企业，诱骗收件人下载恶意软件。</p><p>这些电子邮件包含唯一的民事案件标识符，以及指向虚假法院门户网站的链接；该网站会显示每家目标公司的名称和联系方式。为规避安全筛选机制，该网站会根据访问者所使用的浏览器软件限制访问，仅向使用 <a href=\"https://hackread.com/edge-browser-stores-saved-plaintext-passwords/\">Microsoft Edge</a> 访问的用户显示内容。</p><p>美国佛罗里达州南区联邦地区法院已发布<a href=\"https://www.flsd.uscourts.gov/advisory-phishing-fraudulent-court-email-alert\">官方警报</a>，提醒公众注意这些欺诈通信。</p><figure><a href=\"https://hackread.com/wp-content/uploads/2026/10/Phishing-Campaign-Impersonates-Florida-Federal-Court-to-Deliver-LodaRAT.png\"><img width=\"515\" height=\"661\" src=\"/dailyinfo/media/06662361f6dc85a8.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\"></a><figcaption>电子邮件示例（来源：ThreatDown）</figcaption></figure><h3 id=\"sec-1\"><strong>三种途径投放同一恶意软件</strong></h3><p>一旦进入该网站，目标用户会被催促下载一个受密码保护的压缩文件，以查看其案件文档。该文件包含一个光盘映像（<a href=\"https://hackread.com/malicious-iso-file-romance-scam-on-german-speakers/\">ISO</a>），其中含有三种不同类型的文件：一个 MSC 文件、一个批处理文件和一个 Windows 快捷方式。打开其中任何一种文件都会触发不同的执行路径，但这三种途径最终都会下载同一恶意软件。</p><p>攻击载荷来自一个<a href=\"https://hackread.com/tag/Typosquatting/\">仿冒域名</a> <code>us.wind0ws.net</code>，并使用与合法 Windows 组件相关的文件名：<code>Taskmgr.exe, SystemSettings.exe</code> 和 <code>msedge.exe</code>。</p><p>ThreatDown 将该恶意软件识别为 LodaRAT，这是一款远程访问木马（RAT），可使攻击者远程控制受感染的系统。Hackread.com <a href=\"https://hackread.com/lodarat-windows-malware-hunts-android-devices-2/\">曾在 2021 年报道过 LodaRAT</a>，当时研究人员记录了一款能够针对 Android 设备的版本。</p><p>ThreatDown 发现，LodaRAT 包含广泛的监视机制。它能够捕获按键输入、窃取主流网络浏览器中保存的登录凭据、录制音频和视频，并提取 Wi-Fi 密码。它还可以启用远程桌面协议（<a href=\"https://hackread.com/top-10-passwords-hackers-use-to-breach-rdp/\">RDP</a>）连接，并在本地网络中进行传播。</p><h3 id=\"sec-2\"><strong>LodaRAT 如何维持访问权限</strong></h3><p>LodaRAT 会设置注册表 Run 键、启动快捷方式和计划任务，以便在重启后再次启动，并投放一个 VBScript 看门狗，用于检查恶意软件是否正在运行。如果该进程被停止，它会重新启动。</p><p>研究人员将该活动的基础设施追溯至 <code>courtadr.com</code>，这是一个约有 20 年历史的域名。他们观察到，自 2026 年 3 月起，该域名的证书管理发生了变化，随后创建了配套子域名。然而，现有证据无法确定原始域名是否遭到入侵。</p><figure><a href=\"https://hackread.com/wp-content/uploads/2026/10/Phishing-Campaign-Impersonates-Florida-Federal-Court-to-Deliver-LodaRAT-1.png\"><img width=\"768\" height=\"554\" src=\"/dailyinfo/media/ecf4244ceb717040.webp\" srcset=\"/dailyinfo/media/d1fed3b811301eba.webp 720w, /dailyinfo/media/13db0c72627fc045.webp 1200w, /dailyinfo/media/ecf4244ceb717040.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"\"></a><figcaption>虚假 ADR 网站（来源：ThreatDown）</figcaption></figure><p>研究人员在与 Hackread.com 分享的<a href=\"https://www.threatdown.com/blog/fake-court-adr-phishing-lodarat/\">博客文章</a>中解释道：“威胁行为者如今正大力投资于攻击前端（被入侵的域名、可信的品牌形象、个性化 Targeting），正是因为后端（通用恶意软件）仍然既廉价又有效。”</p><p>这些发现凸显了个性化的法律主题电子邮件如何被用于投放恶意软件，同时使欺诈请求显得可信。</p>","original","zhKind","translation","complete","钓鱼","数据窃取","Microsoft","https://hackread.com/fake-us-court-notices-target-businesses-lodarat/","Hackread",{"_112":113,"_114":-5},"changelogVersion","2026-10-01T08:00","release"]
