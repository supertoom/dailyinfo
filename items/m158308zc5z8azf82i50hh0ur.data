[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795135239000,"id","m158308zc5z8azf82i50hh0ur","title","NLTK Tree.fromlist 深度递归漏洞可导致拒绝服务","originalTitle","NLTK: Uncontrolled recursion in Tree.fromlist causes denial of service via deeply nested list input","summary","NLTK 的 Tree.fromlist 未限制嵌套列表深度，攻击者可控输入可使该 API 抛出未处理 RecursionError，中止操作或请求 worker，属于 CWE-674 拒绝服务；不影响机密性与完整性，也不可导致内存破坏或代码执行。现有修复已合并至未发布的 develop 分支，v3.10.3 尚未包含修复，目前也没有包含该提交的发布版本。","reason","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-19T23:51:08.000Z","discoveredAt","2026-11-20T00:02:20.203Z","timelineAt","category","vuln","tags",[77,78,79,71],"score",44,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","flnWncPaGSI4","reportCount",1,"additionalSourceCount",0,{"_68":30,"_70":72},{"_68":69,"_70":71},"slug","research","name","技术研究","漏洞披露",{"_74":75,"_13":76},"publicId","e2becf36-ea9f-424d-9c07-d061554c073f","NLTK Tree.fromlist 深度递归致拒绝服务","漏洞","复现","补丁","https://github.com/advisories/GHSA-63wh-5r5m-wxr7","GitHub 安全公告",{"_83":84,"_85":-5},"changelogVersion","2026-10-01T08:00","release"]
