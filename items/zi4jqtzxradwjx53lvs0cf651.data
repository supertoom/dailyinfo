[{"_1":2,"_3":4},"root",{"_5":106},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794616837000,"id","zi4jqtzxradwjx53lvs0cf651","title","德国 Quantum Systems 无人机业务遭网络攻击，QBase 恶意更新疑为入口","originalTitle","German military drone operations disrupted by cyberattack","summary","德国国防科技公司 Quantum Systems 确认，其侦察与拦截无人机业务在 late October 遭“敌对行动者”攻击，QBase 地面控制与任务规划软件的更新分发服务器疑遭入侵并投递恶意更新文件。","reason","材料说明攻击通过 QBase 更新分发服务器投递恶意更新，并交代无人机停飞、调查机构及归因不确定性，便于理解此次事件的攻击路径与影响。","source",{"_74":105},"links",{"_97":104},"publishedAt","2026-11-13T17:31:56.000Z","discoveredAt","2026-11-13T18:19:24.598Z","timelineAt","category","activity","tags",[77,101,75,102,103],"score",74,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Bill Toulas","body",{"_61":96,"_97":-5,"_98":99,"_100":37},"outline",[86,87],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fT8VafIS0rUU","reportCount",1,"additionalSourceCount",0,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","malware","name","恶意软件","attack","攻击活动","iot","IoT 与车联网","supply-chain","供应链安全",{"_83":84,"_13":85},"publicId","00923a06-7e37-4b7e-aec1-b83acd160475","德国军用无人机因网络攻击停飞",{"_11":93,"_89":94,"_91":95},{"_11":88,"_89":90,"_91":92},"sec-2","text","发现您现有的防御措施可能遗漏的电子邮件威胁。","level",2,"sec-1","更新服务器遭到入侵",3,"<p><img alt=\"Quantum Systems\" height=\"900\" src=\"/dailyinfo/media/3c323cd7e7f73118.jpg\" srcset=\"/dailyinfo/media/dd747822f44ef298.jpg 720w, /dailyinfo/media/f4aab2f40a457d54.jpg 1200w, /dailyinfo/media/3c323cd7e7f73118.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>德国国防科技公司 Quantum Systems 证实，其在 10 月下旬发现了一起事件，该事件属于“敌对行为者”正在进行的网络攻击的一部分。</p><p>该公司迅速作出响应，与相关当局合作，尽快解决该问题，并确保其无人系统能够安全恢复运行。</p><p>Quantum Systems 是一家德国国防科技公司，制造侦察和拦截无人机，以及其他无人系统和控制这些系统的软件。</p><p><a href=\"https://www.wiz.io/lp/securing-ai-agents-101?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY26Q3_INB_FORM_Securing-AI-Agents-101&amp;sfcid=701Py00000RTEWMIA5&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AI-Agents-101\"><img src=\"/dailyinfo/media/f55e10e3db4728a2.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>其无人机正在德国军方服役。10 月，德国宣布出资在乌克兰建造数万架 Quantum Systems 拦截无人机，以供乌克兰军队使用。</p><p>Quantum Systems 认为其成为攻击目标，是因为其最近宣布支持乌克兰，并表示正与国家当局密切合作调查此次攻击。</p><p>“欧洲国防工业多年来一直面临持续的网络攻击，”<a href=\"https://quantum-systems.com/news/cyberattack-defeated/\">Quantum Systems 表示</a>&nbsp;但未指出具体的攻击归属。</p><p>“处于支持乌克兰前沿的公司之所以成为目标，正是因为我们的工作对客户的安全至关重要。”</p><h3 id=\"sec-1\">更新服务器遭到入侵</h3><p>据<a href=\"https://www.spiegel.de/politik/massiver-cyberangriff-auf-drohnenhersteller-quantum-systems-a-354b0289-2281-4af6-a532-ee03b45d8b30\">Der Spiegel</a> 和 <a href=\"https://www.ft.com/content/783504cd-aa28-453a-a223-7a34eee86ce8\">Financial Times</a> 援引内部消息人士的报道，此次入侵是通过一个恶意的 QBase 更新文件发生的。</p><p>QBase 是 Quantum Systems 的地面控制和任务规划软件，因此此次入侵的目标是该厂商的更新分发服务器。</p><p>Der Spiegel 指出，Vector 侦察无人机在德国军方服役时称为 Falke，是使用 QBase 规划任务的飞行器之一。</p><p>这家德国媒体报道称，意外推送给客户的更新在 Quantum Systems 内部引发了警觉，但目前尚不清楚实际安装了多少用户的更新。</p><p>其他报道称，德国武装部队出于预防措施停飞了 Quantum Systems 的无人机，并将该公司的系统排除在近期一次军事演习之外。</p><p>据报道，响应工作涉及军事反情报机构（MAD）、国内情报机构（BfV）和联邦网络安全局（BSI）。</p><p>今年 7 月，另一家同样公开支持乌克兰的无人机制造商、澳大利亚公司 <a href=\"https://www.bleepingcomputer.com/news/security/cubepilot-drone-software-dev-hit-by-dns-hijacking-to-intercept-traffic/\">CubePilot</a> 遭到 DNS 劫持攻击，导致严重的运营中断。</p><p>DNS 劫持除了其他用途外，还可用于向 CubePilot 无人机系统的下游用户投递恶意更新，尽管此类程度的入侵从未得到证实。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/c132e890d608eb09.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-2\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现您现有的防御措施可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体会分析电子邮件的意图、上下文和行为，发现网络钓鱼、商务电子邮件入侵和发票欺诈。</p><p>对 Microsoft 365 或 Google Workspace 进行为期 14 天的只读扫描，看看有哪些威胁正在穿透防御，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始您的免费电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","供应链投毒","IoT","供应链","https://www.bleepingcomputer.com/news/security/german-military-drone-operations-disrupted-by-cyberattack/","BleepingComputer",{"_107":108,"_109":-5},"changelogVersion","2026-10-01T08:00","release"]
