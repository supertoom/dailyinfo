[{"_1":2,"_3":4},"root",{"_5":91},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795480837000,"id","kxawyiapjv016quh9f83mh8op","title","ARTEX 改变攻击经济学，防御方需重塑漏洞验证经济学","originalTitle","ARTEX Is Changing the Economics of Attack. Defenders Must Change the Economics of Validation.","summary","Horizon3.ai 分析称，ARTEX 等智能体化攻击工具可跨暴露系统和脆弱应用扩展弱凭据滥用、错误配置、权限过度及提权路径操作。变化核心在于攻击技术应用效率提升，防御方因此需要同步重塑漏洞验证经济学，以应对规模化验证需求。","reason","source",{"_73":90},"links",{"_61":89},"publishedAt","2026-11-23T18:42:40.000Z","discoveredAt","2026-11-23T19:38:34.176Z","timelineAt","category","disclosure","tags",[74,76,87,88],"score",40,"selected",false,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","Stephen Gates","body",{"_83":-5,"_61":84,"_85":-5,"_86":36},"outline",[],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fHxpXVe12o7E","reportCount",1,"additionalSourceCount",0,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","research","name","技术研究","ai-offense","AI 攻防","red-team","红队与渗透",{"_80":81,"_13":82},"publicId","b7d75d29-34f9-43ab-86dc-323c6843303e","ARTEX改变攻击工具应用效率","zh","<p>Agentic offensive tools like ARTEX matter because they change the economics of attack. These tools scale familiar attack techniques across exposed systems and vulnerable applications, including the abuse of weak credentials, misconfigurations, excessive permissions, and paths to privileged access. What changes is how efficiently those techniques can be applied. An operator can establish an…</p><p><a href=\"https://horizon3.ai/intelligence/blogs/artex-economics-of-attack-validation/\">Source</a></p>","zhKind","complete","Agent 安全","红队","https://horizon3.ai/intelligence/blogs/artex-economics-of-attack-validation/","Horizon3.ai",{"_92":93,"_94":-5},"changelogVersion","2026-10-01T08:00","release"]
