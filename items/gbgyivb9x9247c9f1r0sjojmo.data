[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794271233000,"id","gbgyivb9x9247c9f1r0sjojmo","title","zt-zip 的 ZipUtil.unpack 可被恶意 ZIP 更改输出目录权限","originalTitle","zt-zip: ZipUtil.unpack can change file permissions of output directory","summary","zt-zip 的 ZipUtil.unpack 在解压名称指向输出目录本身的 ZIP 条目时，可能将归档中的文件权限应用到输出目录，使原本仅所有者可访问的目录对所有 OS 用户开放。该问题影响使用 ZipUtil.unpack 解压不可信 ZIP 文件的用户；PoC 依赖支持 POSIX 文件权限的 OS，但该问题并不限于此类 OS。","reason","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-09T21:03:31.000Z","discoveredAt","2026-11-09T21:33:24.609Z","timelineAt","category","vuln","tags",[77,78,79],"score",40,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fB467xeNuxBM","reportCount",1,"additionalSourceCount",0,{"_68":30,"_70":72},{"_68":69,"_70":71},"slug","research","name","技术研究","漏洞披露",{"_74":75,"_13":76},"publicId","b7126265-b9c1-4510-bbb4-636219c4899f","zt-zip 解压可修改输出目录权限","漏洞","复现","漏洞分析","https://github.com/advisories/GHSA-v2g6-7r9j-v6px","GitHub 安全公告",{"_83":84,"_85":-5},"changelogVersion","2026-10-01T08:00","release"]
