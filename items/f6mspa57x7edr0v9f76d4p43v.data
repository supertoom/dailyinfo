[{"_1":2,"_3":4},"root",{"_5":101},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794444093000,"id","f6mspa57x7edr0v9f76d4p43v","title","哥本哈根大学数据泄露波及 525,000 人，另有 20,000 人 PIN 码暴露","originalTitle","University of Copenhagen data breach exposes data of 525,000 people","summary","哥本哈根大学确认，攻击者访问了包含 525,000 人个人数据的测试环境，可能泄露姓名、丹麦身份号码、电话号码和电子邮件地址，另有 20,000 名教职工及学生的 PIN 码暴露。学校称已阻断攻击者访问，暂无证据显示日常运行系统被访问或校务活动受影响，并已向丹麦数据保护机构报告事件。","reason","事件涉及大规模个人身份数据及 PIN 码暴露，可用于评估数据泄露后的钓鱼风险与凭据处置需求。","source",{"_74":100},"links",{"_92":99},"publishedAt","2026-10-26T22:20:36.000Z","discoveredAt","2026-10-28T09:02:43.235Z","timelineAt","category","activity","tags",[75,96,97,98,77],"score",71,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Bill Toulas","body",{"_61":91,"_92":-5,"_93":94,"_95":37},"outline",[86],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","foC5JBmbD92M","reportCount",2,"additionalSourceCount",1,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","attack","name","攻击活动","incident","应急响应","email","邮件与钓鱼","identity","身份与访问",{"_83":84,"_13":85},"publicId","9e331b13-ec66-4392-b9bb-dd66ddbd0485","哥本哈根大学确认52.5万人数据泄露",{"_11":87,"_88":89,"_90":65},"sec-1","text","攻击者一旦拥有有效凭据，其行动仅有 37% 会被阻止","level","<p><img alt=\"University of Copenhagen data breach exposes data of 525,000 people\" height=\"900\" src=\"/dailyinfo/media/93358b842b64c591.jpg\" srcset=\"/dailyinfo/media/01536440409c399c.jpg 720w, /dailyinfo/media/6032a1ee46537f84.jpg 1200w, /dailyinfo/media/93358b842b64c591.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>丹麦哥本哈根大学确认，黑客访问了其一个包含 525,000 人个人数据的测试环境。</p><p>该教育机构于上周二发现此次数据泄露，并于周五予以披露。在昨天的更新中，该大学补充称，另有 20,000 名教职工和学生的 PIN 码遭到暴露。</p><p>“哥本哈根大学已确认发生一次网络攻击，黑客获取了对该大学一个测试环境的访问权限，”<a href=\"http://news.ku.dk/all_news/2026/10/university-of-copenhagen-hit-by-cyber-attack/\">该大学表示</a>。</p><p>哥本哈根大学成立于 1479 年，是丹麦最古老的大学，也是其领先的研究机构之一。&nbsp;该校约有 36,800 名学生和 10,700 名员工，设有六个学院和 200 多个研究中心。</p><p>哥本哈根大学仍在调查，以确定此次事件的波及范围，但警告称以下信息可能已遭暴露：</p><ul>\n\t<li>全名</li>\n\t<li>国家身份号码（CPR）</li>\n\t<li>电话号码</li>\n\t<li>电子邮件地址</li>\n</ul><p>信息泄露会增加网络钓鱼和社会工程攻击的风险。</p><p>关于 PIN 码访问权限暴露一事，出于格外谨慎，哥本哈根大学已限制人员进入校园内某些关键场所，同时随着新访问码的发放逐步重新开放。</p><p>该大学表示，已控制此次攻击并阻止攻击者访问。&nbsp;目前，&nbsp;没有迹象表明黑客访问了支持日常运营的系统或干扰了大学活动。</p><p>该大学已向丹麦数据保护局报告此次事件，但同时表示，该事件属于欧洲《通用数据保护条例》（GDPR）的适用范围，正在与相关监管机构采取适当措施。</p><p>数据可能因此次事件而遭暴露的学生和教职工，应对&nbsp;未经请求而主动发来的通信保持警惕，并独立核实相关请求。</p><p>该大学承诺，一旦内部调查允许，将尽快提供有关影响范围的更多更新。</p><p><a href=\"https://hubs.li/Q04sB3fb0\">\n            <img src=\"/dailyinfo/media/75f3aeeb0f761593.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://hubs.li/Q04sB3fb0\">攻击者一旦拥有有效凭据，其行动仅有 37% 会被阻止</a>\n        </h2><p>整体预防评分可能掩盖初始访问之后发生的情况。攻击者一旦使用有效凭据，预防效果就会大幅下降。</p><p>《Blue Report 2026》通过在客户生产环境中运行的 3.38 亿次模拟，逐项衡量各项防御措施。</p><p><a href=\"https://hubs.li/Q04sB3fb0\">获取报告</a>\n    </p>","original","zhKind","translation","complete","数据泄露","钓鱼","凭据","https://www.bleepingcomputer.com/news/security/university-of-copenhagen-data-breach-exposes-data-of-525-000-people/","BleepingComputer",{"_102":103,"_104":-5},"changelogVersion","2026-10-01T08:00","release"]
