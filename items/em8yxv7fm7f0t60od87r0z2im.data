[{"_1":2,"_3":4},"root",{"_5":99},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795826439000,"id","em8yxv7fm7f0t60od87r0z2im","title","如何在攻击者借助 AI 加速时持续掌握安全态势","originalTitle","How to Keep Your Security Picture Current When Attackers Move at AI Speed","summary","安全团队应以持续可见性取代按季度汇总的过时快照，及时掌握云账户、身份提供商、终端和代码仓库的真实状态。Anecdotes 可直接连接这些系统并自动汇集数据，适合希望减少人工收集时间、持续跟踪覆盖率及暴露时长的团队；该工具用于看清自身环境，而非实时追踪攻击者。","reason","source",{"_70":98},"links",{"_61":97},"publishedAt","2026-11-27T10:32:18.000Z","discoveredAt","2026-11-27T11:58:26.220Z","timelineAt","category","blue-team","tags",[95,96],"score",15,"selected",false,"channel","news","story",{"_73":74,"_13":75},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_91":-5,"_61":92,"_93":-5,"_94":36},"outline",[76,77,78,79],"relatedStories",[72],"topics",[68],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fnUr-4FpWxZg","reportCount",1,"additionalSourceCount",0,{"_69":30,"_70":71},"slug","name","蓝队与运营",{"_73":74,"_13":75},"publicId","230057af-eeeb-47a0-9988-53f75a3a2bd9","用持续可见性应对 AI 加速攻击",{"_11":89,"_81":90,"_83":84},{"_11":87,"_81":88,"_83":84},{"_11":85,"_81":86,"_83":84},{"_11":80,"_81":82,"_83":84},"sec-4","text","Start With One","level",2,"sec-3","The Real Shift Is From Reporting to Visibility&nbsp;","sec-2","Attackers Are Not Working on a Quarterly Cadence. With AI, They Are Faster Than ","sec-1","Gathering the Picture Is the Hard Part, and It Is Getting Harder&nbsp;","zh","<p><a href=\"https://www.anecdotes.ai/?utm_source=the-hacker-news&amp;utm_medium=cpc&amp;utm_campaign=security-kpis&amp;utm_content=newsletter&amp;utm_term=low-intent\"><img alt=\"\" src=\"/dailyinfo/media/c074e4708e2168c2.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>Most security metrics are not built to be used. They are built to be shown. Somewhere between the quarterly review and the next status update, a set of numbers gets assembled that looks reassuring in a room and tells almost no one what is actually happening across the environment that week. Someone pulls them together the week before, cleans them up, and presents a picture of a program that is, as of that one morning, fine.&nbsp;</p><p>This is not a failure of effort. Security teams are doing the work, often times more of it than anyone outside the team realizes. The problem is that the reporting cycle rewards the snapshot, and a snapshot is a memory, not a measurement. It tells you how things looked on the day you looked. It says very little about the weeks in between, and risk does not keep to a reporting schedule.&nbsp;</p><h2 id=\"sec-1\">Gathering the Picture Is the Hard Part, and It Is Getting Harder&nbsp;</h2><p>The conversation about security metrics usually jumps straight to which numbers matter. That skips the part that actually hurts. Before anyone can report a single metric, someone has to go and gather it, and today that is a genuinely painful job.&nbsp;</p><p>The information needed to describe a security posture is scattered across dozens of systems that were never meant to talk to each other. Cloud accounts, identity providers, endpoints, code repositories, ticketing tools, each one holds a piece. Pulling those pieces together usually means logging into one console after another, exporting spreadsheets, taking screenshots, and stitching it all by hand into something presentable. It takes days. It eats the time of people who were hired to do security, not data entry. And by the time the picture is assembled, parts of it are already out of date, because the environment kept changing while the deck was being built.&nbsp;</p><p>So the metric that lands in the review is not really a measurement of where things stand. It is a measurement of where things stood, filtered through however long it took to collect. (And filtered, quietly, toward whatever looked defensible that week.)&nbsp;</p><p><a href=\"https://www.anecdotes.ai/?utm_source=the-hacker-news&amp;utm_medium=cpc&amp;utm_campaign=security-kpis&amp;utm_content=newsletter&amp;utm_term=low-intent\"><img alt=\"\" src=\"/dailyinfo/media/beb4512581c1f57d.webp\" loading=\"lazy\" decoding=\"async\"></a></p><h2 id=\"sec-2\">Attackers Are Not Working on a Quarterly Cadence. With AI, They Are Faster Than Ever.&nbsp;</h2><p>Here is why the stale snapshot has gone from a weakness to a real liability. The people trying to get in have changed speed.&nbsp;</p><p>AI has handed attackers a serious acceleration. Reconnaissance that used to take a skilled operator days now runs in minutes. Phishing that used to read as obviously fake now arrives fluent and personalized at scale. Known weaknesses get found and probed almost as fast as they appear. The attack side has automated the slow parts, and the result is adversaries who move in hours, iterate constantly, and do not pause politely between your reporting cycles.&nbsp;</p><p>Now put the two timelines next to each other. On one side, a picture of your security that is gathered by hand, a few times a year, and is slightly stale the moment it is finished. On the other, an adversary moving at machine speed, every day, including the long quiet stretch between your last review and your next one. That gap was always uncomfortable. Against AI-accelerated attackers, it is the whole game.&nbsp;</p><h2 id=\"sec-3\">The Real Shift Is From Reporting to Visibility&nbsp;</h2><p>The fix is not a better slide. It is being able to see where you actually stand, continuously, without a person having to go assemble it first.&nbsp;</p><p>That is worth saying plainly, because it is easy to confuse with detection. This is not about catching the attacker in the act. It is about never losing sight of your own environment in the first place, knowing what you have, what is covered, what changed, and where the gaps are, as a living picture rather than a quarterly photograph. Continuous visibility into the real environment, pulled straight from the systems that already hold the data, is what turns a security posture from something you reconstruct under deadline into something you can simply look at, any day, and trust.&nbsp;</p><p>This is the problem <a href=\"https://www.anecdotes.ai/?utm_source=the-hacker-news&amp;utm_medium=cpc&amp;utm_campaign=security-kpis&amp;utm_content=newsletter&amp;utm_term=low-intent\">Anecdotes</a> was built to solve. Instead of a person logging into one console after another and rebuilding the picture by hand, it connects directly to the systems a company already runs, the cloud accounts, identity providers, code&nbsp;repositories, and the hundreds of other tools where the real state actually lives, and pulls the information straight from the source. The picture assembles itself and stays current, so the question stops being how many days it will take to gather and becomes simply what the data says right now. And to be clear about what that is and is not, it does not chase the attacker for you. It makes sure you are never the last to know what your own environment looks like.&nbsp;</p><p>When the picture is always current, the work changes shape. Nobody spends the week before the review gathering. The number is just there, today's number, and the team spends its time acting on what it says instead of proving it exists.&nbsp;</p><p><a href=\"https://www.anecdotes.ai/?utm_source=the-hacker-news&amp;utm_medium=cpc&amp;utm_campaign=security-kpis&amp;utm_content=newsletter&amp;utm_term=low-intent\"><img alt=\"\" src=\"/dailyinfo/media/d6f4acd91d9a861f.webp\" loading=\"lazy\" decoding=\"async\"></a></p><h2 id=\"sec-4\">Start With One</h2><p>None of this requires rebuilding everything at once, and anyone who says it does is selling something. Pick one thing worth seeing clearly, coverage, say, or how long exposures stay open. Connect it to the source so it keeps itself current. Watch it for a month, and let it tell you something uncomfortable.&nbsp;</p><p>Security is not a thing that is true on review day. It is true, or it is not, on an ordinary Tuesday, when no one is looking and last quarter's slide is gathering dust in a shared drive. And on that Tuesday, the attackers are not waiting. The teams that stay ahead&nbsp;are not the ones with the best-looking dashboards. They are the ones who can see where they stand at any moment, without having to go dig for it first.</p><p>Found this article interesting? <span>This article is a contributed piece from one of our valued partners.</span> Follow us on <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>, <a href=\"https://twitter.com/thehackersnews\">Twitter</a> and <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a> to read more exclusive content we post.</p>","zhKind","complete","蓝队","安全运营","https://thehackernews.com/2026/11/how-to-keep-your-security-picture.html","The Hacker News",{"_100":101,"_102":-5},"changelogVersion","2026-10-01T08:00","release"]
