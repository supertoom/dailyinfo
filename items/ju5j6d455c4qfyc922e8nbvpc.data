[{"_1":2,"_3":4},"root",{"_5":92},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":-5,"_57":36,"_58":59},"expiresAt",1795394434000,"id","ju5j6d455c4qfyc922e8nbvpc","title","Security Affairs 第 123 期恶意软件资讯汇总","originalTitle","SECURITY AFFAIRS MALWARE NEWSLETTER ROUND 123","summary","Security Affairs 第 123 期恶意软件资讯汇总涵盖 13 篇文章与研究，包括新型 Rust RAT Linux/EasyShell、BO Team 软件供应链攻击及 SANSAR Linux 挖矿木马。","reason","source",{"_66":91},"links",{"_59":90},"publishedAt","2026-11-22T13:56:43.000Z","discoveredAt","2026-11-22T14:12:24.219Z","timelineAt","category","activity","tags",[84,67,69,85,86,87,88,89],"score",6,"selected",false,"channel","news","story","x","readingMode","full","author","Pierluigi Paganini","body",{"_80":-5,"_59":81,"_82":-5,"_83":36},"outline",[74],"relatedStories",[],"topics",[60,61,62,63],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_64":72,"_66":73},{"_64":70,"_66":71},{"_64":68,"_66":69},{"_64":65,"_66":67},"slug","malware","name","恶意软件","attack","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件",{"_11":75,"_76":77,"_78":79},"sec-1","text","Security Affairs Malware newsletter includes a collection of the best articles a","level",2,"zh","<h2 id=\"sec-1\">Security Affairs Malware newsletter includes a collection of the best articles and research on malware in the international landscape</h2><p>Malware Newsletter</p><p><a href=\"https://blog.malwaremustdie.org/2026/11/mmd-073-2026-linuxeasyshell-new-rust.html\">MMD-073-2026 – Linux/EasyShell, a new Rust RAT implant and beacon aims Linux and MacOS</a>&nbsp;&nbsp;</p><p><a href=\"https://ics-cert.kaspersky.com/publications/reports/2026/11/05/supply-chain-attack-bo-team-in-a-software-developers-infrastructure/\">Supply chain attack: BO Team in a software developer’s infrastructure</a></p><p><a href=\"https://www.elastic.co/security-labs/threat-command/sansar-linux-cryptomining-malware\">0% GPU utilization: How SANSAR hides Linux cryptomining</a>&nbsp;</p><p><a href=\"https://www.infostealers.com/article/inside-the-ai-powered-marketplace-turning-infected-computers-into-searchable-profiles/\">Inside the AI-Powered Marketplace Turning Infected Computers Into Searchable Profiles</a></p><p><a href=\"https://blog.report-uri.com/worlds-largest-brands-infected-with-malware-via-optimizely/\">World’s Largest Brands Infected With Malware Via Optimizely</a></p><p><a href=\"https://www.infostealers.com/article/poisoned-scripts-on-bbc-zoom-and-other-major-websites-linked-to-iphone-exploit-loaders/\">Poisoned Scripts on BBC, Zoom and Other Major Websites Linked to iPhone Exploit Loaders</a></p><p><a href=\"https://securelist.com/operation-shadowcloud-gitdoor/122004/\">Operation ShadowCloud: cloud service–based backdoors targeting government networks in Asia and Africa. Part 1</a>&nbsp; &nbsp;&nbsp;&nbsp;</p><p><a href=\"https://www.wiz.io/blog/malicious-version-of-microsofts-agent-framework-published-to-pypi\">Microsoft agent-framework Compromised: Credential Stealer Targets Azure and CI Pipelines</a></p><p><a href=\"https://businessinsights.bitdefender.com/eggstreme-malware-revises-architecture-infrastructure\">EggStreme Malware: Rebuilt Under Scrutiny</a>&nbsp;&nbsp;</p><p><a href=\"https://hunt.io/blog/us-bank-irs-ssa-logins-stolen-russian-speaking-operator\">US bank and federal logins stolen off victims’ own PCs by a Russian-speaking operation</a>&nbsp;&nbsp;&nbsp;</p><p><a href=\"https://www.404media.co/ransomware-fraud-attack-fbi-indictment/\">To Catch a Ransomware Scammer, FBI Posed as Both Victim and Attacker</a>&nbsp;</p><p><a href=\"https://arxiv.org/abs/2611.21936\">CNN Architecture Comparison for Malware Classification with Limited Training Data</a></p><p><a href=\"https://arxiv.org/abs/2611.20699\">A First Look at System One Decision Models for Malware Detection</a></p><p><a href=\"https://www.mdpi.com/2076-3417/16/22/11266\">Ensemble Learning for Android Malware Detection: Stability Across Malware Categories and Feature Representations</a></p><p><a href=\"https://www.mdpi.com/2624-800X/6/6/201\">Lightweight Vulnerability-Aware Malware Triage: Operational Value and Generalization Under Family and Temporal Shift</a></p><p><strong>Follow me on Twitter:&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a><strong></strong></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;hacking,&nbsp;<a href=\"https://securityaffairs.com/tag/newsletter\">newsletter</a>)</strong></p>","zhKind","complete","汇总","后门","数据窃取","勒索","Microsoft","AWS","https://securityaffairs.com/203714/malware/security-affairs-malware-newsletter-round-123-2.html","Security Affairs",{"_93":94,"_95":-5},"changelogVersion","2026-10-01T08:00","release"]
