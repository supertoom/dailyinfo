[{"_1":2,"_3":4},"root",{"_5":93},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795826437000,"id","bp3mhwtmbzqp2s4qlj7c99iek","title","科罗拉多州 myColorado 应用数据泄露，约 100,000 人可能受影响","originalTitle","100,000 Potentially Impacted by Colorado Data Breach","summary","科罗拉多州州长信息技术办公室（OIT）披露，攻击者未经授权访问 myColorado 应用数据，约 100,000 人可能受影响。该应用约有 2.1 million 用户，泄露内容位于“myCards and Documents”区段，包括 PDF 文件、政府身份证件、车辆登记和保险卡照片，但未访问支付信息。","reason","事件影响范围、涉及文档类型和处置状态均有明确交代，应用仍处离线状态且通知发放尚在进行。","source",{"_73":92},"links",{"_84":91},"publishedAt","2026-11-27T09:30:54.000Z","discoveredAt","2026-11-27T09:44:19.884Z","timelineAt","category","activity","tags",[88,74,76,89,90],"score",75,"selected",true,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","Ionut Arghire","body",{"_61":83,"_84":-5,"_85":86,"_87":37},"outline",[],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fzCgqu_bMp4g","reportCount",1,"additionalSourceCount",0,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","attack","name","攻击活动","mobile","移动端","cloud-native","云与原生",{"_80":81,"_13":82},"publicId","f95ef551-11c9-4ea2-8c0c-0a60af3068c1","科罗拉多州myColorado应用数据泄露，约10万人受影响","<p><strong>科罗拉多州政府信息技术办公室（OIT）披露了一起数据泄露事件，影响居民上传至 myColorado 应用程序的数据。</strong>\n\n\n\n</p><p>科罗拉多州官方移动应用程序 myColorado 用于数字身份证明、州政府服务和文件存储，拥有约 2.1 million 用户。\n\n\n</p><p>OIT 于上周将该应用程序下线，此前发现有人未经授权访问了平台数据，并立即启动事件响应及对该事件的调查。\n\n\n</p><p>停运开始一周后，OIT <a href=\"https://oit.colorado.gov/press-releases/office-of-information-technology-oit-provides-status-update-on-mycolorado\">表示</a>，此次事件是在攻击者触发其 Amazon Web Services（AWS）环境中部署的自动化威胁检测系统后才发现的。\n\n\n</p><p>调查已确定，攻击者访问了应用程序“myCards and Documents”部分中存储的文件，其中包括用户上传的数据，例如 PDF 文件以及政府身份证件、车辆登记证和保险卡的照片。\n\n\n</p><p>据科罗拉多州称，约 100,000 名个人可能受到影响，但支付信息未被访问。</p><p><span>广告。滚动以继续阅读。</span></p><p>“工作人员正昼夜不停地将被不当访问的文件与各个用户进行匹配。在这项匹配工作持续进行的同时，OIT 将进一步细化数据涉及人数的估计，”Colorado 表示。\n\n\n\n</p><p>myColorado 应用仍处于离线状态，OIT 尚未宣布恢复日期。该州预计将于 11 月 27 日开始向受影响的个人发送直接通知。\n\n\n\n</p><p>“我们的首要目标是保护用户的安全。此外，我们正在优先向事件中涉及的用户发送直接通知，并尽快让应用恢复运行，同时落实安全增强措施，”州 CIO 兼 OIT 执行主任 Sarah Tuneberg 表示。\n\n\n\n</p><p><strong>相关：</strong> <a href=\"https://www.securityweek.com/hex-package-manager-warns-of-potential-data-breach/\">Hex Package Manager 警告可能发生数据泄露</a>\n\n\n\n</p><p><strong>相关：</strong> <a href=\"https://www.securityweek.com/sap-confirms-cyberattack-source-code-reportedly-compromised/\">SAP 确认遭受网络攻击，源代码据称已泄露</a>\n\n\n\n</p><p><strong>相关：</strong> <a href=\"https://www.securityweek.com/fifa-says-it-has-been-victim-of-a-cyberattack-accessing-personal-and-business-information/\">FIFA 称已成为网络攻击受害者，攻击者访问了“个人和商业信息”</a>\n\n\n\n</p><p><strong>相关：</strong> <a href=\"https://www.securityweek.com/1password-breach-exposes-customer-data-internal-source-code/\">1Password 数据泄露暴露客户数据和内部源代码</a>\n\n\n\n</p>","original","zhKind","translation","complete","数据泄露","云原生","AWS","https://www.securityweek.com/100000-potentially-impacted-by-colorado-data-breach/","SecurityWeek",{"_94":95,"_96":-5},"changelogVersion","2026-10-01T08:00","release"]
