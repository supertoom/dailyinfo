[{"_1":2,"_3":4},"root",{"_5":92},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795740052000,"id","xr13yfjgr44whlnt8um2wwv3h","title","FinCEN遭网络入侵，部分系统下线并延长金融机构报告期限","originalTitle","US agency tracking money laundering is latest casualty in string of federal breaches","summary","美国财政部金融犯罪执法网络（FinCEN）遭遇网络入侵，有限系统被未授权访问，机构已将部分系统下线。11月24日发布的临时命令将11月18日至12月29日期间到期的报告和更新期限延至12月30日，BSA E-Filing网站仍在线，但部分服务可能暂时不可用。FinCEN尚未披露攻击者身份、被访问的具体系统及数据范围。","reason","source",{"_71":91},"links",{"_61":90},"publishedAt","2026-11-26T11:05:01.000Z","discoveredAt","2026-11-26T11:17:19.074Z","timelineAt","category","activity","tags",[72,89],"score",67,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","Sinisa Markovic","body",{"_85":-5,"_61":86,"_87":-5,"_88":36},"outline",[77,78],"relatedStories",[73],"topics",[68],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","f9UJ5yCxT4yA","reportCount",4,"additionalSourceCount",3,{"_69":70,"_71":72},"slug","attack","name","攻击活动",{"_74":75,"_13":76},"publicId","c8c4a5ab-4861-481d-8192-074313b2754f","FinCEN部分系统遭未授权访问，已预防性下线部分系统",{"_11":83,"_80":84,"_82":67},{"_11":79,"_80":81,"_82":67},"sec-2","text","The growing scope of government intrusions","level","sec-1","Deadlines pushed back","zh","<p>An intrusion at the US Treasury’s Financial Crimes Enforcement Network (FinCEN) has forced the agency to take some systems offline and extend reporting deadlines for financial institutions.</p><p><img src=\"/dailyinfo/media/2e62661a719c5ab7.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"FinCEN breach\" title=\"USA\"></p><p>The bureau serves as the US government’s financial intelligence unit, collecting suspicious activity reports and other Bank Secrecy Act filings from banks and other financial institutions and sharing the intelligence with law enforcement.</p><p>“FinCEN is investigating a cybersecurity incident that resulted in unauthorized access to a limited subset of its systems,” reads an alert <a href=\"https://bsaefiling.fincen.gov/\">posted</a> on the agency’s BSA E-Filing website. “As a proactive measure, FinCEN has taken some systems offline.”</p><p>The agency has shared few details, saying nothing about who might be behind the attack or which systems were accessed.</p><h3 id=\"sec-1\">Deadlines pushed back</h3><p>The BSA E-Filing website is still up, though FinCEN warned that “some services may be temporarily unavailable.” The agency said it “is working diligently to return all systems to normal operations as soon as possible.”</p><p>On November 24, FinCEN issued an <a href=\"https://www.fincen.gov/sites/default/files/100/ORDER-FIN-2026-R002.pdf\">order</a> granting temporary, limited relief to filers hit by what it describes as “a service disruption that is hindering filers’ ability to adhere to reporting obligations.”</p><p>Judging by the order’s scope, the disruption appears to have hit Secure Data Transfer Mode (SDTM), one of the channels financial institutions use to submit BSA reports. The services companies rely on to file beneficial ownership information reports, and that individuals use to update their FinCEN identifiers, seem to be affected as well.</p><p>Anyone with eligible filings or updates due between November 18 and December 29 has until December 30 to get them in.</p><h3 id=\"sec-2\">The growing scope of government intrusions</h3><p>FinCEN’s disclosure followed a November 24 <a href=\"https://www.nytimes.com/2026/11/24/us/politics/spy-agencies-computer-network-breaches.html\">report</a> by The New York Times, according to which the CIA and the Office of the Director of National Intelligence (ODNI) suffered a cybersecurity breach involving some unclassified information.</p><p>The FinCEN intrusion is the latest in a string of security incidents at US government agencies. A breach has been reported at the Department of Agriculture, the FBI has <a href=\"https://www.helpnetsecurity.com/2026/09/28/fbi-job-portals-offline-shinyhunters-breach/\">disclosed</a> two separate breaches, and the <a href=\"https://www.helpnetsecurity.com/2026/10/01/pentagon-dmdc-data-breach-3-million-people/\">Pentagon</a> and the Department of Homeland Security have dealt with cyber incidents of their own.</p>","zhKind","complete","数据泄露","https://www.helpnetsecurity.com/2026/11/26/fincen-breach-systems-offline/","Help Net Security",{"_93":94,"_95":-5},"changelogVersion","2026-10-01T08:00","release"]
