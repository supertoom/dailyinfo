[{"_1":2,"_3":4},"root",{"_5":154},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1794357646000,"id","z3sqrmee2fikv7ige2l4oj2i8","title","Red Hat OpenShift 5 正式发布：引入 Kubernetes 1.36、代理式运维与内置零信任安全","originalTitle","What’s new in Red Hat OpenShift 5","summary","Red Hat OpenShift 5 已正式发布，基于 Kubernetes 1.36 和 CRI-O 1.36，支持自建及托管部署，并提供代理式故障排查、集群更新评估和对话式 Perses 仪表盘生成。","reason","source",{"_73":153},"links",{"_60":152},"publishedAt","2026-11-09T00:00:00.000Z","discoveredAt","2026-11-10T22:55:37.679Z","timelineAt","category","blue-team","tags",[146,147,148,149,150,78,151],"score",28,"selected",false,"channel","news","story",{"_84":85,"_13":86},"x","readingMode","full","author","body",{"_142":-5,"_60":143,"_144":-5,"_145":36},"outline",[87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103],"relatedStories",[83],"topics",[67,68,69,70,71],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fCt6SPzn3ckc","reportCount",1,"additionalSourceCount",0,{"_72":81,"_73":82},{"_72":79,"_73":80},{"_72":77,"_73":78},{"_72":75,"_73":76},{"_72":30,"_73":74},"slug","name","蓝队与运营","tools","工具与平台","ai-security","AI 安全","cloud-native","云与原生","redhat","Red Hat / 红帽",{"_84":85,"_13":86},"publicId","cf0d955d-df58-4768-a64b-d436a6c98edc","Red Hat OpenShift 5 正式发布",{"_11":140,"_105":141,"_107":121},{"_11":138,"_105":139,"_107":121},{"_11":136,"_105":137,"_107":121},{"_11":134,"_105":135,"_107":121},{"_11":132,"_105":133,"_107":121},{"_11":130,"_105":131,"_107":121},{"_11":128,"_105":129,"_107":121},{"_11":126,"_105":127,"_107":121},{"_11":124,"_105":125,"_107":121},{"_11":122,"_105":123,"_107":121},{"_11":119,"_105":120,"_107":121},{"_11":117,"_105":118,"_107":108},{"_11":115,"_105":116,"_107":108},{"_11":113,"_105":114,"_107":108},{"_11":111,"_105":112,"_107":108},{"_11":109,"_105":110,"_107":108},{"_11":104,"_105":106,"_107":108},"sec-17","text","Virtualization","level",3,"sec-16","Applications","sec-15","Infrastructure","sec-14","Edge computing","sec-13","Security","sec-12","Automation","sec-11","Browse by channel",2,"sec-10","Keep exploring","sec-9","More like this","sec-8","Build apps at the scale of your ambitions with Red&nbsp;Hat OpenShift 5","sec-7","Try Red&nbsp;Hat OpenShift 5 today","sec-6","Explore further by doing an interactive demo","sec-5","Map your next steps to Red&nbsp;Hat OpenShift 5","sec-4","Virtualize: unlock smarter, optimized VM management with Red&nbsp;Hat OpenShift","sec-3","Secure: Raise the default bar for AI-era and shared clusters","sec-2","Predictable: Plan in years, not in fire drills","sec-1","Intelligent: Spend less time hunting, more time deciding","zh","<p><img src=\"/dailyinfo/media/c1ab1d89ec0ddbd8.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Duncan Hardie\"></p><p>\n                    Senior Principal Product Manager\n                  </p><p><img src=\"/dailyinfo/media/75f3bf6d5ea02d34.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"Ju Lim wearing a Red fedora\"></p><p>\n                    Senior Manager, OpenShift Product Management and Distinguished Engineer\n                  </p><p>Red&nbsp;Hat OpenShift 5 is&nbsp;<a href=\"http://www.redhat.com/en/about/press-releases/red-hat-openshift-5-transforms-hybrid-cloud-operations-real-time-intelligence-and-zero-trust-security\">now generally available</a>. The Red&nbsp;Hat OpenShift team always tries to bring you the most requested features while, at the same time, pushing the envelope with new opportunities. You have environments combining containers, virtual machines (VMs), and AI workloads so with this release we decided to keep things practical: it’s easy to update and adopt, features agentic workflows to make day-to-day tasks more efficient, offers a longer lifecycle, built in with zero-trust security and, finally, provides enhanced virtualization capabilities to run in the enterprise.</p><p>Red&nbsp;Hat OpenShift 5 is based on&nbsp;<a href=\"https://github.com/kubernetes/kubernetes/blob/master/CHANGELOG/CHANGELOG-1.36.md\">Kubernetes 1.36</a> and&nbsp;<a href=\"https://github.com/cri-o/cri-o/releases#release-v1.36.6\">CRI-O 1.36</a>. Whether you deploy it yourself or use it as a managed service, you still get one application platform across bare metal, virtualized, and hybrid cloud environments. We are just going to cover the highlights here but for the complete list of changes, see the&nbsp;<a href=\"https://docs.redhat.com/en/documentation/openshift_container_platform/5.0/html/release_notes/index\">Red&nbsp;Hat OpenShift 5 release notes</a>.</p><h2 id=\"sec-1\">Intelligent: Spend less time hunting, more time deciding</h2><p>When an alert triggers at 2 a.m. or a high-stakes maintenance window opens, the real cost is rarely the command you run to fix it. The time sink is the triage. It is the hour spent correlating metrics, parsing scattered logs, and trying to separate real signal from routine platform noise. Red&nbsp;Hat OpenShift 5 moves that investigative work directly into the platform, helping operators stay focused on making critical decisions rather than getting buried in diagnostics.</p><p>Troubleshooting shifts from manual sleuthing to guided, agentic workflows. When something goes wrong, the platform walks teams through diagnosis and remediation paths in clear language. In supervised mode, Red&nbsp;Hat OpenShift lays out its findings, outlines the proposed next steps, and waits for your confirmation before touching anything. For teams looking to delegate more legwork, the autonomous mode available in technology preview lets the system dig deeper on its own, while still holding for final human approval before running changes. The objective is simple: get engineers to a confident action quickly, without forcing them to interpret another wall of charts alone.&nbsp;&nbsp;</p><p><a href=\"https://www.redhat.com/en/interactive-demo/enable-agentic-alert-investigations-human-approval-remediation?intcmp=RHCTG0250000458742\">Explore the \"Enable agentic alert investigations with human approval for remediation\" interactive demo ➤</a>&nbsp;</p><p>Cluster lifecycle operations get that same level of scrutiny. Rather than discovering what an update breaks mid-flight, the Red&nbsp;Hat Lightspeed-augmented update guidance maps out status, potential conflicts, and blast radius before change windows begin. An update agent in technology preview goes a step further, helping plan and run safer update paths when the maintenance window opens.</p><p><a href=\"https://www.redhat.com/rhdc/managed-files/image3_182.png\">\n<img src=\"/dailyinfo/media/c6b9e2b725690f9f.webp\" srcset=\"/dailyinfo/media/279972cd1709d6a6.webp 720w, /dailyinfo/media/ce137e561cbee8be.webp 1200w, /dailyinfo/media/c6b9e2b725690f9f.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1999\" height=\"921\" alt=\"Red Hat OpenShift web console showing the cluster updates page\">\n</a></p><p><em>Figure 1. Automated cluster update readiness analysis</em></p><p><a href=\"https://www.redhat.com/en/interactive-demo/analyze-cluster-readiness-ai-red-hat-openshift?intcmp=RHCTG0250000458742\">Explore the \"Analyze Cluster Readiness with&nbsp; AI in Red&nbsp;Hat OpenShift\" interactive demo ➤&nbsp;</a></p><p>Everyday platform visibility changes as well. Day 2 operations should not require a dedicated observability specialist on call just to build a custom view. Administrators can now generate&nbsp;<a href=\"https://developers.redhat.com/articles/2026/07/07/manage-observability-red-hat-build-perses\">Perses</a> dashboards through conversational chat, asking for the metrics they need and getting usable, production-ready panels without hand-crafting queries.&nbsp;</p><p><a href=\"https://www.redhat.com/rhdc/managed-files/image1_430.png\">\n<img src=\"/dailyinfo/media/490534bb09bf7f66.webp\" srcset=\"/dailyinfo/media/a73cee6d4003ed94.webp 720w, /dailyinfo/media/437d85f03a4c38a3.webp 1200w, /dailyinfo/media/490534bb09bf7f66.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1999\" height=\"1112\" alt=\"Red Hat OpenShift Lightspeed assistant panel within a Red Hat OpenShift console dashboard\">\n</a></p><p><em>Figure 2. Use OpenShift Lightspeed to Create Perses Dashboards</em></p><p><a href=\"https://www.redhat.com/en/interactive-demo/ai-assisted-troubleshooting-and-observability-openshift-lightspeed?intcmp=RHCTG0250000458743\">Explore the \"AI-assisted troubleshooting and observability with OpenShift Lightspeed\" interactive demo ➤</a></p><p>When AI agents take action across a cluster, they need to do so through trusted, predictable channels. The Model Context Protocol (MCP) server for Red&nbsp;Hat OpenShift and&nbsp;<a href=\"https://www.redhat.com/en/blog/model-context-protocol-gateway-red-hat-openshift-now-generally-available\">MCP gateway</a> (via&nbsp;<a href=\"https://www.redhat.com/en/technologies/cloud-computing/connectivity-link\">Red&nbsp;Hat Connectivity Link</a>) reach general availability, so platform APIs and services are reachable through the MCP in a way operations and security teams can actually govern.</p><p><a href=\"https://www.redhat.com/en/interactive-demo/exposing-and-protecting-mcp-servers-scale?intcmp=RHCTG0250000458743\">Explore the \"Exposing and Protecting MCP servers at Scale\" interactive demo ➤</a>&nbsp;</p><h2 id=\"sec-2\">Predictable: Plan in years, not in fire drills</h2><p>Major releases are only valuable if updating and maintaining them aligns with your business timeline. Red&nbsp;Hat OpenShift 5 is built around that constraint where the update from Red&nbsp;Hat OpenShift 4.22 is described as being “uneventful” and just a new minor release update. No migration plan is needed to adopt Red&nbsp;Hat OpenShift 5. Updates from Red&nbsp;Hat OpenShift 4.22 are in-place, with payload and update tooling changes coordinated so the jump is non-disruptive.</p><p><a href=\"https://www.redhat.com/en/interactive-demo/update-cluster-version-5?intcmp=RHCTG0250000458743\">Explore the \"Update Cluster Version to 5\" interactive demo ➤</a></p><p>Red&nbsp;Hat OpenShift 5 is designed to give enterprise teams operational stability, predictability, and long-term planning confidence. We're establishing a 3-year major release cadence aligned roughly 1 year following major Red&nbsp;Hat Enterprise Linux (RHEL) releases. We’re also extending the provided life-cycle of all 5-year releases to 24 months, consisting of 1 year of full support and 1 year of maintenance support. In addition, Extended Update Support (EUS) in Red&nbsp;Hat OpenShift 4 is evolving into the Extended Life Cycle (ELC) model, delivering one ELC release per year, each backed by 5 full years of enterprise support. This additional life cycle is provided via a 3-year Extended Life Cycle add-on on top of the included full and maintenance support periods.&nbsp;</p><p><a href=\"https://www.redhat.com/rhdc/managed-files/image2_261.png\">\n<img src=\"/dailyinfo/media/4e5e0046ed161c8f.webp\" srcset=\"/dailyinfo/media/1b800384ec8913c5.webp 720w, /dailyinfo/media/94cc624291878eb7.webp 1200w, /dailyinfo/media/4e5e0046ed161c8f.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1999\" height=\"939\" alt=\"Comparison timeline of support phases for Red Hat OpenShift product releases\">\n</a></p><p><em>Figure 3. Red&nbsp;Hat OpenShift 4 vs. Red&nbsp;Hat OpenShift 5 support lifecycle</em></p><p>This gives you more time to schedule updates, recertify workloads, and line platform changes up with budget and application cycles when the environment demands a longer cycle. In addition, the 5-year support Extended Life Cycle also extends to optional operators including Red&nbsp;Hat Advanced Cluster Security, OpenShift Service Mesh, OpenShift Pipelines, and OpenShift GitOps.</p><p>Red&nbsp;Hat OpenShift 5’s dual Red&nbsp;Hat Enterprise Linux CoreOS path lets you update the platform without forcing an application stack move. When you update your OpenShift cluster from Red&nbsp;Hat OpenShift 4.22, you remain on Red&nbsp;Hat Enterprise Linux CoreOS 9, whereas a newly created OpenShift 5.0 cluster will default to Red&nbsp;Hat Enterprise Linux CoreOS 10. In a future release, we will allow Red&nbsp;Hat Enterprise Linux CoreOS 9 and Red&nbsp;Hat Enterprise Linux CoreOS 10 to coexist within a single cluster, so you can transition node OS versions on your schedule while staying on one OpenShift version.</p><p>Updates can sometimes be complicated when reviewing compatibility requirements between the cluster and the optional operators. The update planner for operators gives administrators a centralized view of operator updates surfacing operator lifecycle status, cluster compatibility, and available update options. In Figure 3, it shows Advanced Cluster Management is running and compatible with the cluster, however, its support ended on July 19, 2026. Meanwhile, Cluster Logging is running but incompatible with the current cluster, and it suggests an update to a newer release. The Compliance Operator is degraded, incompatible, and past its end-of-life date.</p><p><a href=\"https://www.redhat.com/rhdc/managed-files/image4_122.png\">\n<img src=\"/dailyinfo/media/8b27b06a7a380661.webp\" srcset=\"/dailyinfo/media/86acf008e19af54d.webp 720w, /dailyinfo/media/c7b0e73e4ca43a98.webp 1200w, /dailyinfo/media/8b27b06a7a380661.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1999\" height=\"877\" alt=\"Installed Operators dashboard in the Red Hat OpenShift web console\">\n</a></p><p><em>Figure 4. Update planner for operators gives a centralised view</em></p><h2 id=\"sec-3\">Secure: Raise the default bar for AI-era and shared clusters</h2><p>Security work that depends on every team remembering a local setting does not scale. Red&nbsp;Hat OpenShift 5 pushes more of the protective posture into the platform defaults and policy surfaces operators already manage.</p><p>AI workloads bring new attack surfaces that demand more than traditional pod isolation. Red&nbsp;Hat OpenShift 5 protects sensitive models by encrypting model weights using&nbsp;<a href=\"https://www.redhat.com/en/blog/whats-new-red-hat-openshift-confidential-computing-and-sandboxing\">confidential containers</a>, keeping sensitive IP encrypted both at rest and in use.</p><p>Running automated agents introduces clear risk because agents frequently generate and execute code that your team has never reviewed. To keep that execution safely contained, the&nbsp;<a href=\"https://developers.redhat.com/articles/2026/07/15/red-hat-build-agent-sandbox-isolated-workload-management-kubernetes?extIdCarryOver=true&amp;sc_cid=RHCTG0180000371695&amp;_gl=1*4x8v50*_gcl_aw*R0NMLjE3ODU5NjUxNDcuRUFJYUlRb2JDaE1JaFBHbXo3YUtsZ01Wbmx6X0FSMmtxZ3dpRUFBWUFTQUFFZ0xtMVBEX0J3RQ..*_gcl_dc*R0NMLjE3ODU5NjUxNDcuRUFJYUlRb2JDaE1JaFBHbXo3YUtsZ01Wbmx6X0FSMmtxZ3dpRUFBWUFTQUFFZ0xtMVBEX0J3RQ..*_gcl_au*MjEyNzE0NTk4OC4xNzkxODE2MDM1#conclusion\">Red&nbsp;Hat build of Agent Sandbox</a>, available in technology preview, relies on&nbsp;<a href=\"https://www.redhat.com/en/blog/learn-openshift-sandboxed-containers\">OpenShift sandboxed containers</a> to isolate agent workloads inside VMs. This establishes a hard boundary that keeps untrusted or autonomous code from gaining unrestricted access to the broader cluster.</p><p>Cryptography is also moving.&nbsp;<a href=\"https://www.redhat.com/en/blog/road-to-quantum-safe-cryptography-red-hat-openshift\">Post-quantum readiness</a> is integrated into platform images and TLS configuration, giving customers a path to prepare as quantum-resistant algorithms enter production use rather than waiting for a mad scramble later.</p><p>TLS itself becomes simpler to run consistently.&nbsp;<a href=\"https://access.redhat.com/articles/5348961?extIdCarryOver=true&amp;sc_cid=RHCTG0180000371695\">Centralized, enforced TLS configuration</a> now applies across core Red&nbsp;Hat OpenShift and its layered products, so teams manage policy in one place instead of chasing hard-coded or fragmented settings across components.</p><p>Shared and multi-tenant environments benefit from tighter containment by default. Tailored network policies for platform operands strengthen isolation around those components by restricting traffic in and out of the control plane operand namespaces, which reduces unintended exposure and helps limit blast radius when something goes wrong.</p><h2 id=\"sec-4\">Virtualize: unlock smarter, optimized VM management with Red&nbsp;Hat OpenShift</h2><p>Most enterprises still run critical applications on VMs, but managing them separately from modern applications creates unnecessary operational silos.&nbsp;<a href=\"https://www.google.com/aclk?sa=L&amp;ai=DChsSEwiL0ZrJrcmXAxWFNAgFHWYREywYACICCAEQABoCbWQ&amp;ae=2&amp;co=1&amp;ase=2&amp;gclid=CjwKCAjwotzWBhBFEiwA1JhPoBRaHjArZUbvSyYigFkYpxBi3aj3TgbevJDzhloYIgymn34Px-UqOBoCtZ8QAvD_BwE&amp;cid=CAASWuRoC0FoKhyv9dWU0FVOEUibsInAPQEc5Q8JI72l3x8ZfmAiD8haq_vL9maLyD1goLm2I9l6qPF3YUK7083a9Sgc9xPmmPp9bvoXPKFoww2pVfCmfMsUzhlBAg&amp;cce=2&amp;category=acrcp_v1_71&amp;sig=AOD64_2IeNb7vTyMaLpWxsjafWPQe31w5w&amp;q&amp;nis=4&amp;adurl&amp;ved=2ahUKEwii9ZTJrcmXAxULhYkEHdELCaoQ0Qx6BAgiEAE\">Red&nbsp;Hat OpenShift Virtualization</a> brings VMs and containers onto one platform, simplifying operations today while giving teams a path to migrate and modernize applications at their own pace.&nbsp;</p><p>OpenShift Virtualization 5 leverages the powerful agentic AI capabilities built into Red&nbsp;Hat OpenShift, including OpenShift Lightspeed and MCP server integration, allowing administrators to provision customized VMs and automate cluster workflows using natural language prompts.&nbsp;</p><p><a href=\"https://www.redhat.com/en/interactive-demo/intelligent-operations-virtual-machines-openshift-lightspeed?intcmp=RHCTG0250000458743\">Explore the \"Intelligent Operations with Virtual Machines - OpenShift Lightspeed\" interactive demo ➤&nbsp;</a></p><p>From an ease of use perspective, a unified interface for node-centric management consolidates host-level networking, physical and logical storage resources, high-availability status, and VM workloads into a single, intuitive pane of glass.</p><p>Data protection is significantly enhanced via storage-agnostic incremental backup with Change Block Tracking (QEMU CBT). By identifying and backing up only modified data blocks instead of processing full virtual disk images, CBT drastically lowers network overhead and minimizes operational impact on active production workloads.&nbsp;</p><p>The introduction of memory-aware load balancing along with leveraging Red&nbsp;Hat OpenShift native swap capability optimizes hardware density by adjusting resource allocations based on actual consumption, and reclaiming dormant capacity for large live VM migrations.&nbsp;</p><p>Additionally, the virtualization autopilot framework leverages Red&nbsp;Hat OpenShift's unique declarative foundation. Autopilot enables zero-configuration setups, prevents configuration drift, and delivers a mechanism for delivering best practices for load-aware rebalancing policies, recovery from unplanned node health issues, and pre-configured observability dashboards.&nbsp;</p><h2 id=\"sec-5\">Map your next steps to Red&nbsp;Hat OpenShift 5</h2><p>If you are using Red&nbsp;Hat OpenShift 4.22, start with the supported update path and the 5-year lifecycle implications for your update calendar. If cluster operations and management&nbsp; is where you spend most of your time, use the intelligent update, troubleshooting solutions, and Perses dashboards to reduce your load. If AI or multi-tenant exposure is the concern, prioritize security against your compliance and model-protection requirements. If VMs are staying, treat autopilot defaults, memory-aware balancing, and volume group snapshots as the operational baseline—not optional extras. Or if you really want, try it all out, you won’t regret the time spent.</p><h2 id=\"sec-6\">Explore further by doing an interactive demo</h2><h2 id=\"sec-7\">Try Red&nbsp;Hat OpenShift 5 today</h2><p>Get started today with the&nbsp;<a href=\"https://console.redhat.com/\">Red&nbsp;Hat Hybrid Cloud Console</a> and take advantage of the latest features and enhancements in OpenShift. To find out what’s next, check out the following resources:</p><ul><li><a href=\"https://www.redhat.com/en/whats-new-red-hat-openshift\">What’s new and what’s next in Red&nbsp;Hat OpenShift</a> (Product page)</li><li><a href=\"https://developers.redhat.com/articles/2026/11/09/red-hat-openshift-5-for-developers\">What’s new in Red&nbsp;Hat OpenShift 5 for developers</a> (Red&nbsp;Hat Developer blog post)</li><li><a href=\"https://www.redhat.com/en/interactive-experiences#application-platform\">Red&nbsp;Hat interactive experiences</a></li><li><a href=\"https://www.youtube.com/playlist?list=PLbMP1JcGBmSHHAsJ3PDd5TiK8xGaUFgrn\">In the clouds</a> (YouTube Series)</li><li><a href=\"https://commons.openshift.org/\">Red&nbsp;Hat OpenShift commons</a></li><li><a href=\"https://www.redhat.com/architect/portfolio/\">Red&nbsp;Hat Portfolio Architecture Center</a></li><li><a href=\"https://validatedpatterns.io/\">Validated patterns</a></li></ul><p>The complete list of the Red&nbsp;Hat OpenShift 5&nbsp;updates are in the&nbsp;. Send us feedback through your Red&nbsp;Hat contacts, or create an issue on&nbsp;<a href=\"https://github.com/openshift/openshift-docs/issues\">GitHub</a>.</p><p>Product</p><h2 id=\"sec-8\">Build apps at the scale of your ambitions with Red&nbsp;Hat OpenShift 5</h2><p>Find out more about Red&nbsp;Hat OpenShift's agentic capabilities, security controls, and predictable major release cadence with extended support on minor releases.</p><p>\n                            <a href=\"https://www.redhat.com/en/technologies/cloud-computing/openshift-5?intcmp=7013a000003Sq0iAAC\" title=\"Build apps at the scale of your ambitions with Red Hat OpenShift 5\">Learn more about this product</a>            </p><hr><p><a href=\"https://www.redhat.com/en/authors/duncan-hardie\"><img src=\"/dailyinfo/media/c1ab1d89ec0ddbd8.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Duncan Hardie\">\n                        \n                    </a></p><p><a href=\"https://www.redhat.com/en/authors/ju-lim\"><img src=\"/dailyinfo/media/75f3bf6d5ea02d34.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"Ju Lim wearing a Red fedora\">\n                        \n                    </a></p><h2 id=\"sec-9\">More like this</h2><p>            Blog post\n</p><p>            Blog post\n</p><p>            Original podcast\n</p><p>            Original podcast\n</p><h2 id=\"sec-10\">Keep exploring</h2><h2 id=\"sec-11\">Browse by channel</h2><p>\n                            <a href=\"https://www.redhat.com/en/blog/channels\" title=\"Explore all channels\">Explore all channels</a>            </p><p>\n              \n  \n\n\n                  <img src=\"/dailyinfo/media/e54b8b12b5046028.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"automation icon\">\n                  </p><h3 id=\"sec-12\"><a href=\"https://www.redhat.com/en/blog/channel/management-and-automation\">Automation</a></h3><p>The latest on IT automation for tech, teams, and environments</p><p>\n              \n  \n\n\n                  <img src=\"/dailyinfo/media/8a821a2318338b17.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"security icon\">\n                  </p><h3 id=\"sec-13\"><a href=\"https://www.redhat.com/en/blog/channel/security\">Security</a></h3><p>The latest on how we reduce risks across environments and technologies</p><p>\n              \n  \n\n\n                  <img src=\"/dailyinfo/media/7ba24fccf63c7747.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"edge icon\">\n                  </p><h3 id=\"sec-14\"><a href=\"https://www.redhat.com/en/blog/channel/edge-computing\">Edge computing</a></h3><p>Updates on the platforms that simplify operations at the edge</p><p>\n              \n  \n\n\n                  <img src=\"/dailyinfo/media/3c20e7298d1bb543.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"Infrastructure icon\">\n                  </p><h3 id=\"sec-15\"><a href=\"https://www.redhat.com/en/blog/channel/infrastructure\">Infrastructure</a></h3><p>The latest on the world’s leading enterprise Linux platform</p><p>\n              \n  \n\n\n                  <img src=\"/dailyinfo/media/e3e51f29ae003c0b.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"application development icon\">\n                  </p><h3 id=\"sec-16\"><a href=\"https://www.redhat.com/en/blog/channel/applications\">Applications</a></h3><p>Inside our solutions to the toughest application challenges</p><p>\n              \n  \n\n\n                  <img src=\"/dailyinfo/media/820d8e45b3c05d24.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"Virtualization icon\">\n                  </p><h3 id=\"sec-17\"><a href=\"https://www.redhat.com/en/blog/channel/red-hat-virtualization\"> Virtualization</a></h3><p>The future of enterprise virtualization for your workloads on-premise or across clouds</p>","zhKind","complete","工具发布","版本更新","云原生","容器","加固","Red Hat","https://www.redhat.com/en/blog/announcing-red-hat-openshift-5","Red Hat Security",{"_155":156,"_157":-5},"changelogVersion","2026-10-01T08:00","release"]
