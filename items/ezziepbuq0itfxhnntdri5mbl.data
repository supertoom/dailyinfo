[{"_1":2,"_3":4},"root",{"_5":107},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795740036000,"id","ezziepbuq0itfxhnntdri5mbl","title","Drupal 远程代码执行漏洞 CVE-2026-132165 已发现在野利用","originalTitle","【漏洞通告】Drupal远程代码执行漏洞（CVE-2026-132165）","summary","Drupal 远程代码执行漏洞 CVE-2026-132165 的 CVSS 评分为 8.1，漏洞细节与 PoC 已公开，并已发现在野利用。未经身份验证的攻击者可访问 core/install.php 重新安装 Drupal，进而替换管理员账户接管站点或实现远程代码执行。","reason","漏洞细节与 PoC 已公开且出现真实利用，文章同时列出受影响版本、检测方法和升级路径，便于站点管理员快速判断并处置。","source",{"_72":106},"links",{"_98":105},"publishedAt","2026-11-26T10:33:00.000Z","discoveredAt","2026-11-26T17:40:25.198Z","timelineAt","category","vuln","tags",[101,73,102,103,104],"score",82,"selected",true,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","body",{"_61":97,"_98":-5,"_99":98,"_100":37},"outline",[79,80,81,82,83],"relatedStories",[75],"topics",[68,69],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fzVvze_Sp8nc","reportCount",1,"additionalSourceCount",0,{"_70":31,"_72":74},{"_70":71,"_72":73},"slug","exploited","name","在野利用","漏洞披露",{"_76":77,"_13":78},"publicId","68465ab3-c70a-4fb8-879b-c2dcde061a85","Drupal安装器RCE漏洞CVE-2026-132165已被在野利用",{"_11":95,"_85":96,"_87":88},{"_11":93,"_85":94,"_87":88},{"_11":91,"_85":92,"_87":88},{"_11":89,"_85":90,"_87":88},{"_11":84,"_85":86,"_87":88},"sec-5","text","4.2 其他防护措施","level",3,"sec-4","4.1 官方升级","sec-3","3.1 人工检测","sec-2","不受影响版本","sec-1","受影响版本","<p><span>NS-CERT</span> <span>2026-11-26 18:33</span> <span>四川</span></p><p><img src=\"/dailyinfo/media/933a9be070d29ad4.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>近日，绿盟科技CERT监测到Drupal发布安全公告，修复了Drupal远程代码执行漏洞（CVE-2026-132165）；CVSS评分8.1，目前漏洞细节与PoC已公开，且发现在野利用，请相关用户尽快采取措施进行防护。</p><p><strong><span>通告编号 NS-2026-0040</span></strong></p><p><span><span>2026-11-25</span></span></p><table><tbody><tr><td><strong><span><span>TAG：</span></span></strong></td><td colspan=\"3\"><p><strong><span><span>Drupal、远程代码执行、CVE-2026-132165</span></span></strong></p></td></tr><tr><td><strong><span><span>在野利用：</span></span></strong></td><td><p><strong><span>已发现</span></strong></p></td><td><strong><span><span>PoC状态：</span></span></strong></td><td><p><strong><span>已公开</span></strong></p></td></tr><tr><td><strong><span><span>漏洞危害：</span></span></strong></td><td colspan=\"3\"><p><strong><span>攻击者利用此漏洞，可实现管理员账户接管甚至远程代码执行。</span></strong></p></td></tr></tbody></table><p><strong><span>1</span></strong></p><p><strong><span><span>漏洞概述</span></span></strong></p><p><span>近日，绿盟科技CERT监测到Drupal发布安全公告，修复了Drupal远程代码执行漏洞（CVE-2026-132165）；由于Drupal Core内置的install.php安装器在特定条件下对已安装站点的安装任务状态校验不当，未经身份验证的攻击者可访问core/install.php利用安装器重新安装Drupal，从而替换管理员账户接管站点或实现远程代码执行。CVSS评分8.1，目前漏洞细节与PoC已公开，且发现在野利用，请相关用户尽快采取措施进行防护。</span></p><p><span>Drupal是一款使用PHP开发的开源内容管理系统（CMS），以高度模块化架构、企业级安全性和灵活的内容建模能力著称，广泛用于企业网站、政府门户及社区平台建设。</span></p><p><span>参考链接：</span></p><p><span><a href=\"https://www.drupal.org/sa-core-2026-017\">https://www.drupal.org/sa-core-2026-017</a></span></p><p><strong><span>SEE MORE →</span></strong></p><p><span><strong><span>2</span></strong></span><strong><span>影响范围</span></strong></p><h3 id=\"sec-1\"><strong><span>受影响版本</span></strong></h3><ul><li><p><span>Drupal Core &lt; 10.6.22</span></p></li><li><p><span>11.0.0 &lt;= Drupal Core &lt; 11.3.22</span></p></li><li><p><span>11.4.0 &lt;= Drupal Core &lt; 11.4.13</span></p></li></ul><p><span>注：官方停止维护的10.5.x和Drupal 8/9等旧版本也可能受影响。</span></p><h3 id=\"sec-2\"><strong><span>不受影响版本</span></strong></h3><ul><li><p><span>Drupal Core 10.6.x &gt;= 10.6.22</span></p></li><li><p><span>Drupal Core 11.3.x &gt;= 11.3.22</span></p></li><li><p><span>Drupal Core 11.4.x &gt;= 11.4.13</span></p></li></ul><p><span><strong><span>3</span></strong></span><strong><span>漏洞检测</span></strong></p><h3 id=\"sec-3\"><strong><span>3.1 人工检测</span></strong></h3><p><span>相关用户可以通过检查Drupal Core版本，判断当前站点是否受此漏洞影响：</span></p><p><span>使用Composer管理的站可在项目根目录执行以下命令查看已安装版本；也可登录后台在“管理 &gt; 报告 &gt; 状态报告”（/admin/reports/status）中查看版本号。</span></p><pre><code><span>composer show drupal/core | grep versions</span></code></pre><p><span>若Drupal Core版本在受影响范围，且core/install.php可被外部访问或Web服务器可写入、更改settings.php权限，则可能存在安全风险。</span></p><p><span><strong><span>4</span></strong></span><strong><span>漏洞防护</span></strong></p><h3 id=\"sec-4\"><strong><span>4.1 官方升级</span></strong></h3><p><span>目前官方已发布新版本修复此漏洞，请受影响的用户尽快升级版本进行防护。下载链接：<a href=\"https://www.drupal.org/project/drupal/releases\">https://www.drupal.org/project/drupal/releases</a></span></p><p><span>注：已停止维护版本的用户应迁移至受支持分支；使用Drupal Steward的站点虽已覆盖已知攻击路径，仍应尽快升级，以防范后续可能出现的其他攻击路径。</span></p><h3 id=\"sec-5\"><strong><span>4.2 其他防护措施</span></strong></h3><p><span>在不影响业务的情况下，相关用户可采取以下措施降低利用风险：</span></p><p><span>按照官方指南通过Web服务器配置或站点根目录的.htaccess限制/core/install.php访问，并确保Web服务器无法写入或更改settings.php权限。</span></p><p><span>防护指南：<a href=\"https://www.drupal.org/docs/administering-a-drupal-site/security-in-drupal/securing-the-installer-installphp\">https://www.drupal.org/docs/administering-a-drupal-site/security-in-drupal/securing-the-installer-installphp</a></span></p><p><strong><span>END</span></strong></p><p><img src=\"/dailyinfo/media/5b87db561e59b283.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img src=\"/dailyinfo/media/a2077bc60b816d82.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>声明</span></strong></p><p><span>本安全公告仅用来描述可能存在的安全问题，绿盟科技不为此安全公告提供任何保证或承诺。由于传播、利用此安全公告所提供的信息而造成的任何直接或者间接的后果及损失，均由使用者本人负责，绿盟科技以及安全公告作者不为此承担任何责任。</span></p><p><span>绿盟科技拥有对此安全公告的修改和解释权。如欲转载或传播此安全公告，必须保证此安全公告的完整性，包括版权声明等全部内容。未经绿盟科技允许，不得任意修改或者增减此安全公告内容，不得以任何方式将其用于商业目的。</span></p><p><img src=\"/dailyinfo/media/a2077bc60b816d82.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><span><strong><span>绿盟科技CERT</span></strong></span><span><span>∣</span></span><span><span>微信公众号</span></span></p><p><img src=\"/dailyinfo/media/7fed700ffd872476.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><img src=\"/dailyinfo/media/2584b3e828519de7.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>长按识别二维码，关注网络安全威胁信息</span></span></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=1d30bef3&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzk0MjE3ODkxNg%3D%3D%26mid%3D2247494332%26idx%3D1%26sn%3D20e10be7965d6e9f32dedeab3022393a\">跳转微信打开</a></p>","original","zhKind","complete","漏洞","补丁","复现","PHP","https://mp.weixin.qq.com/s?__biz=Mzk0MjE3ODkxNg==&mid=2247494332&idx=1&sn=20e10be7965d6e9f32dedeab3022393a","绿盟科技CERT",{"_108":109,"_110":-5},"changelogVersion","2026-10-01T08:00","release"]
