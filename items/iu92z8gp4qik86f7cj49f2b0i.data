[{"_1":2,"_3":4},"root",{"_5":99},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795912839000,"id","iu92z8gp4qik86f7cj49f2b0i","title","WordPress 在恶意发布前拦截 6 个被植入后门的 WP Connect 插件","originalTitle","WordPress Blocks Six Backdoored WP Connect Plugins Before Malicious Releases Go Live","summary","WordPress 在恶意版本发布前发现并关闭了 WP Connect 开发的 6 个被植入后门的插件，事件被跟踪为 CVE-2026-135202，CVSS 9.8，目前无补丁。","reason","文章列出六个受影响插件及恶意版本，并揭示后门的通信、执行与持久化机制，便于站点排查和清除残留。","source",{"_75":98},"links",{"_90":97},"publishedAt","2026-11-25T06:21:12.000Z","discoveredAt","2026-11-25T07:21:34.930Z","timelineAt","category","activity","tags",[78,94,95,96],"score",70,"selected",true,"channel","news","story",{"_86":87,"_13":88},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_61":89,"_90":-5,"_91":92,"_93":37},"outline",[],"relatedStories",[85],"topics",[68,69,70,71,72],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fznR8GxtA63k","reportCount",1,"additionalSourceCount",0,{"_73":83,"_75":84},{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","malware","name","恶意软件","attack","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","supply-chain","供应链安全",{"_86":87,"_13":88},"publicId","a7d27baf-e862-4be3-acba-19103461ed0b","WordPress拦截六款被植入后门的WP Connect插件","<p><span><i></i><span>Ravie Lakshmanan</span><i></i><span>2026年11月25日</span></span><span>Web 安全 / 恶意软件</span></p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgNbawIx8zYCfd7sCTbVfIzPFBtykkY65lf8EOswU62pIdZKTrx9ReB3mGnqYqujmW5eGzN_w8pEijAZMTpmOZ3fGB5zFyFaPo4ZhRQ8V0BkAmDCH3WoVqJ3kAfjDcw3_wRjhwphfyJxjF3_rDYiudb-cxt0pY3t8s-IRjNP1aEYHqtO5L1eZMkgBX6y2xD/s1600/wp.jpg\"><img alt=\"\" src=\"/dailyinfo/media/94de9b0155a3f11c.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>WordPress 已移除由 WP Connect 开发的六款 WordPress 插件；这些插件于 2026 年 11 月 22 日被植入后门，使用户能够在已安装这些插件的站点上执行任意代码，疑似原因是开发者账户遭到入侵。</p><p>WordPress 插件团队已独立检测并拦截该威胁，阻止其被正式发布。现在访问每个插件的列表页面都会显示以下消息：“此插件已于 2026 年 11 月 22 日关闭，不再提供下载。此次关闭为永久性关闭。”</p><p>受影响插件的名称及恶意版本如下——</p><ul>\n  <li><a href=\"https://wordpress.org/plugins/air-wp-sync/\">Air WP Sync – Airtable to WordPress</a>（2.9.1 – 2.9.4）</li>\n  <li><a href=\"https://wordpress.org/plugins/wp-sync-for-notion/\">WP Sync for Notion – Notion to WordPress</a>（1.7.4）</li>\n  <li><a href=\"https://wordpress.org/plugins/addon-gravityforms-sendinblue-free/\">Add-on Brevo for Gravity Forms</a>（2.6.3）</li>\n  <li><a href=\"https://wordpress.org/plugins/add-on-cf7-for-airtable/\">Add-On for Contact Form 7 to Airtable</a>（2.5.4）</li>\n  <li><a href=\"https://wordpress.org/plugins/add-on-cf7-for-notion/\">Add-On for Contact Form 7 to Notion</a>（1.6.4）</li>\n  <li><a href=\"https://wordpress.org/plugins/orders-sync-to-airtable-for-woocommerce/\">Orders Sync to Airtable for WooCommerce</a>（1.0.2）</li>\n</ul><p>据 WordPress 安全公司 Wordfence 称，这些插件合计安装在超过 3,600 个 WordPress 站点上。此次供应链入侵事件被追踪为 CVE-2026-135202（CVSS 分数：9.8）。目前仍未修复。</p><p>安全研究员 Chloe Chamberland <a href=\"https://www.wordfence.com/blog/2026/11/supply-chain-compromise-backdoors-six-wp-connect-plugins-blocked-by-wordpress-orgs-release-hold/\">表示</a>：“每个发布版本都会悄无声息地加载同一个远程控制模块，该模块会向攻击者控制的服务器回传数据、执行服务器发送的任意 PHP 代码，并提供用于运行 shell 命令、窃取密码哈希和植入 Web shell 的完整命令集。”</p><p>具体而言，这些插件附带了一个后门模块（\"includes/airwp-online.php\"），该模块会在每次请求时运行，将站点信息（站点 URL、PHP、WordPress 和操作系统版本，以及服务器用户）发送到一个硬编码的命令与控制服务器（\"tascredit-pay[.]com\"），并通过 eval() 运行该服务器返回的 PHP 代码。</p><p>它还可以执行以下操作——</p><ul>\n  <li>接受排队中的命令并运行 shell 命令</li>\n  <li>读取、写入和删除任意文件</li>\n  <li>查询任意数据库表</li>\n  <li>导出用户表，包括登录名、电子邮箱地址和密码哈希</li>\n  <li>将 Web shell 放入 uploads 目录或攻击者指定的路径</li>\n  <li>注册每小时的 WP-Cron 钩子，用于运行攻击者提供的代码</li>\n</ul><p>因此，未经身份验证的攻击者在控制该站点后，便可在服务器上执行任意代码并取得完全控制权，从而通过 Web shell 和 cron 钩子窃取凭据并维持持久化，即使插件被移除，这些手段仍可能存续。</p><p>由于这些恶意版本从未发布，并因 <a href=\"https://thehackernews.com/2026/09/wordpress-adds-automated-plugin-reviews.html\">WordPress 的新冷却期保护机制</a>而在 Protect The Shire 计划的一部分中得到拦截，因此运行这些插件的站点不太可能受到影响。不过，站点所有者仍必须检查自己的网站，确保没有运行受影响的版本，并尽快将其移除。</p><p>Chamberland 表示：“与典型的漏洞不同，这并非编码错误，也不存在补丁：恶意代码是被故意添加到每个插件中的，并提交至各插件的 WordPress.org 仓库。综合来看，这强烈表明开发者的 WordPress.org 账户遭到入侵并被用于推送恶意版本，而非供应商有意发布这些代码。”</p><p>此次披露源于 URLscan.io 曝光：一个未指明的 WordPress 网站感染了多个网络犯罪团伙的活动，攻击者试图禁用或删除属于竞争威胁行为体的脚本。</p><p>该网站携带了来自三个不同工具包 [LOM、ErrTraffic 和 Macfinger] 的“十三处独立的 <a href=\"https://thehackernews.com/2026/11/romulus-clickfix-attacks-deliver-rat.html\">ClickFix</a> 注入”，此外还有七个恶意加载器，“它<a href=\"https://urlscan.io/blog/2026/11/19/CompetingClickFixInjections/\">表示</a>：‘其中数个注入程序试图移除彼此的代码和覆盖层，还有一个注入程序通过 JavaScript 命名冲突禁用另一个。十三处注入中有五处通过 Polygon 智能合约解析其下一阶段基础设施，这一技术称为 <a href=\"https://thehackernews.com/2026/08/trojanized-npm-packages-decode-c2-ip.html\">EtherHiding</a>。’”</p><p>觉得这篇文章有意思吗？在 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a> 上关注我们，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","后门","供应链投毒","数据窃取","https://thehackernews.com/2026/11/wordpress-blocks-six-backdoored-wp.html","The Hacker News",{"_100":101,"_102":-5},"changelogVersion","2026-10-01T08:00","release"]
