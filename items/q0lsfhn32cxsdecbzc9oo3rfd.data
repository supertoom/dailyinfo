[{"_1":2,"_3":4},"root",{"_5":107},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795653645000,"id","q0lsfhn32cxsdecbzc9oo3rfd","title","GeoServer 修复 5 个高危漏洞，CVE-2026-120705 等漏洞细节与 PoC 已公开","originalTitle","【漏洞通告】GeoServer多个高危漏洞","summary","GeoServer 修复 CVE-2026-120705、CVE-2026-129242、CVE-2026-129243、CVE-2026-129244、CVE-2026-129245，涉及 WFS 存储查询、服务安全规则、remember-me 会话及 JDBC 安全服务，可串联形成未经身份验证的远程代码执行利用链。","reason","通告列明多个漏洞的利用链、评分、版本范围与修复版本，并提供升级和临时收敛访问面的处置方法。","source",{"_71":106},"links",{"_97":105},"publishedAt","2026-11-25T05:15:00.000Z","discoveredAt","2026-11-25T17:19:08.897Z","timelineAt","category","vuln","tags",[100,101,102,103,104,74],"score",70,"selected",true,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","body",{"_61":96,"_97":-5,"_98":97,"_99":37},"outline",[79,80,81,82,83],"relatedStories",[75],"topics",[68,69],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fU-A0Q2yxUGE","reportCount",3,"additionalSourceCount",2,{"_70":73,"_71":74},{"_70":31,"_71":72},"slug","name","漏洞披露","vuln-mgmt","漏洞管理",{"_76":77,"_13":78},"publicId","f6003043-ce60-438d-9a23-a8338172530e","GeoServer未认证RCE链已复现并出现利用探测",{"_11":94,"_85":95,"_87":65},{"_11":92,"_85":93,"_87":65},{"_11":90,"_85":91,"_87":65},{"_11":88,"_85":89,"_87":65},{"_11":84,"_85":86,"_87":65},"sec-5","text","4.2 其他防护措施","level","sec-4","4.1 官方升级","sec-3","3.1 人工检测","sec-2","不受影响版本","sec-1","受影响版本","<p><span>NS-CERT</span> <span>2026-11-25 13:15</span> <span>四川</span></p><p><img src=\"/dailyinfo/media/371f4d5f29433283.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>近日，绿盟科技CERT监测到GeoServer发布安全公告，修复了GeoServer多个高危漏洞（CVE-2026-120705/CVE-2026-129242/CVE-2026-129243/CVE-2026-129244/CVE-2026-129245）；目前漏洞细节与PoC已公开，请相关用户尽快采取措施进行防护。</p><p><strong><span>通告编号 NS-2026-0039</span></strong></p><p><span><span>2026-11-25</span></span></p><table><tbody><tr><td><strong><span><span>TAG：</span></span></strong></td><td colspan=\"3\"><p><strong><span><span>GeoServer、GeoTools、远程代码执行、CVE-2026-120705</span></span></strong></p></td></tr><tr><td><strong><span><span>在野利用：</span></span></strong></td><td><p><strong><span>未发现</span></strong></p></td><td><strong><span><span>PoC状态：</span></span></strong></td><td><p><strong><span>已公开</span></strong></p></td></tr><tr><td><strong><span><span>漏洞危害：</span></span></strong></td><td colspan=\"3\"><p><strong><span>攻击者利用此漏洞，可实现未授权远程代码执行。</span></strong></p></td></tr></tbody></table><p><strong><span>1</span></strong></p><p><strong><span><span>漏洞概述</span></span></strong></p><p><span>近日，绿盟科技CERT监测到GeoServer发布安全公告，修复了GeoServer多个高危漏洞（CVE-2026-120705/CVE-2026-129242/CVE-2026-129243/CVE-2026-129244/CVE-2026-129245）；漏洞涉及WFS存储查询、服务安全规则、remember-me会话及JDBC安全服务，可串联形成未经身份验证的远程代码执行利用链。目前漏洞细节与PoC已公开，请相关用户尽快采取措施进行防护。</span></p><p><span>CVE-2026-120705：GeoServer内置的WFS 2.0 GetFeatureById存储查询未转义调用方提供的ID参数，且解析XML时未使用GeoServer实体解析器，未经身份验证的攻击者可注入xi:include等XML内容，读取GeoServer进程可访问的本地文本文件或发起SSRF；当匿名用户可访问已发布图层时，相关内容还可通过错误响应返回。CVSS评分8.6。</span></p><p><span>CVE-2026-129242：JDBC用户组与角色服务使用ResultSet.getObject()读取用户和角色属性，HSQLDB驱动会对OTHER类型字段中的序列化Java对象进行不受限反序列化，具有管理员权限或已接管管理员会话的攻击者可上传特制HSQLDB数据库并配置对应JDBC服务，从而以GeoServer进程权限执行任意代码。CVSS 4.0评分8.6。</span></p><p><span>CVE-2026-129243：GeoServer调度器会将x/WFS等带前缀的服务名解析为WFS，而服务安全检查仍使用未解析的名称，导致安全规则无法匹配；未经身份验证的攻击者可调用仅受服务安全规则保护的操作，默认配置下可创建和删除WFS存储查询。CVSS评分8.8。</span></p><p><span>CVE-2026-129244：WFS存储查询请求使用过长ID时，异常报告会返回GeoServer数据目录的绝对路径，未经身份验证的攻击者可获取该路径，为后续文件读取等攻击提供条件。CVSS评分6.9。</span></p><p><span>CVE-2026-129245：remember-me Cookie使用security/config.xml中的密钥及用户密码摘要进行签名，默认数据目录使用固定密钥geoserver；攻击者获取密钥和管理员密码摘要后，无需获知明文密码即可伪造管理员remember-me Cookie并登录。CVSS评分9.2。</span></p><p><span>GeoServer是一款开源地理空间数据服务器，支持WFS、WMS、WCS等OGC标准服务，可用于发布、管理和共享地理空间数据；GeoTools是GeoServer依赖的开源Java地理空间工具库。</span></p><p><span>参考链接：</span></p><p><span><a href=\"https://github.com/geoserver/geoserver/security/advisories/GHSA-39mw-5chv-jh47\">https://github.com/geoserver/geoserver/security/advisories/GHSA-39mw-5chv-jh47</a></span></p><p><span><a href=\"https://github.com/geoserver/geoserver/security/advisories/GHSA-9wf2-fcgq-vxhq\">https://github.com/geoserver/geoserver/security/advisories/GHSA-9wf2-fcgq-vxhq</a></span></p><p><span><a href=\"https://github.com/geoserver/geoserver/security/advisories/GHSA-rv5g-g2r9-58rj\">https://github.com/geoserver/geoserver/security/advisories/GHSA-rv5g-g2r9-58rj</a></span></p><p><span><a href=\"https://github.com/geoserver/geoserver/security/advisories/GHSA-4v26-c537-jvxc\">https://github.com/geoserver/geoserver/security/advisories/GHSA-4v26-c537-jvxc</a></span></p><p><span><a href=\"https://github.com/geoserver/geoserver/security/advisories/GHSA-hgm3-wq4h-8vvq\">https://github.com/geoserver/geoserver/security/advisories/GHSA-hgm3-wq4h-8vvq</a></span></p><p><strong><span>SEE MORE →</span></strong></p><p><span><strong><span>2</span></strong></span><strong><span>影响范围</span></strong></p><h3 id=\"sec-1\"><strong><span>受影响版本</span></strong></h3><ul><li><p><span>3.0.0 &lt;= GeoServer &lt;= 3.0.1</span></p></li><li><p><span>2.28.0 &lt;= GeoServer &lt;= 2.28.5</span></p></li><li><p><span>GeoServer &lt;= 2.27.6</span></p></li></ul><p><span>CVE-2026-120705：</span></p><ul><li><p><span>GeoTools &lt;= 33.6</span></p></li><li><p><span>34.0 &lt;= GeoTools &lt;= 34.5</span></p></li><li><p><span>35.0 &lt;= GeoTools &lt;= 35.1</span></p></li></ul><p><span>注：目前公开PoC利用链需访问WFS与REST API，且默认用户中的管理员账户处于启用状态。</span></p><h3 id=\"sec-2\"><strong><span>不受影响版本</span></strong></h3><ul><li><p><span>GeoServer 3.0.x &gt;= 3.0.2</span></p></li><li><p><span>GeoServer 2.28.x &gt;= 2.28.6</span></p></li><li><p><span>GeoServer 2.27.x &gt;= 2.27.7</span></p></li></ul><p><span>CVE-2026-120705：</span></p><ul><li><p><span>GeoTools 33.x &gt;= 33.7</span></p></li><li><p><span>GeoTools 34.x &gt;= 34.6</span></p></li><li><p><span>GeoTools 35.x &gt;= 35.2</span></p></li></ul><p><span><strong><span>3</span></strong></span><strong><span>漏洞检测</span></strong></p><h3 id=\"sec-3\"><strong><span>3.1 人工检测</span></strong></h3><p><span>用户可以通过检查当前GeoServer与GeoTools的版本，判断当前系统是否在受影响范围：</span></p><p><span>登录GeoServer管理界面，在“关于”页面查看版本信息，也可检查实际部署目录中的gs-main组件版本：</span></p><pre><code><span>ls \"$GEOSERVER_HOME/webapps/geoserver/WEB-INF/lib\"/gs-main-*.jar 2&gt;/dev/null</span></code></pre><p><span>在GeoServer的WEB-INF/lib目录下查看GeoTools核心组件版本：</span></p><pre><code><span>find /实际路径/WEB-INF/lib -maxdepth 1 -type f -name 'gt-main-*.jar' -exec basename {} \\;</span></code></pre><p><span>若当前GeoServer或GeoTools版本在受影响范围内，则可能存在安全风险；当WFS与REST API对匿名用户开放、remember-me认证处于启用状态及默认用户中的管理员账户可用时，则可能受已知利用链影响。</span></p><p><span><strong><span>4</span></strong></span><strong><span>漏洞防护</span></strong></p><h3 id=\"sec-4\"><strong><span>4.1 官方升级</span></strong></h3><p><span>目前官方已发布新版本修复上述漏洞，请受影响的用户尽快升级版本进行防护，下载链接：</span></p><p><span><a href=\"https://github.com/geoserver/geoserver/tags\">https://github.com/geoserver/geoserver/tags</a></span></p><p><span><a href=\"https://github.com/geotools/geotools/tags\">https://github.com/geotools/geotools/tags</a></span></p><h3 id=\"sec-5\"><strong><span>4.2 其他防护措施</span></strong></h3><p><span>若相关用户暂时无法升级更新，在不影响业务的情况下可采取以下措施降低相关利用风险：</span></p><p><span>1、限制匿名用户访问WFS服务</span></p><p><span>限制匿名用户访问WFS服务，或在无需WFS功能时禁用该服务。</span></p><p><span>2、拦截异常service参数并排查存储查询</span></p><p><span>通过前置代理拦截查询字符串或XML请求中service参数包含“/”的请求，并检查数据目录wfs/query和workspaces//wfs/query中是否存在非预期存储查询。</span></p><p><span>3、移除rememberme过滤器</span></p><p><span>在“Security &gt; Authentication”的web过滤器链中移除rememberme；移除后remember-me持久登录功能将不可用；如怀疑密钥或管理员密码摘要已经泄露，应同时修改管理员密码。</span></p><p><span>4、收敛管理员权限与REST接口访问</span></p><p><span>仅向可信用户授予管理员权限，并对REST API的/rest/resource和/rest/security接口进行访问限制。</span></p><p><strong><span>END</span></strong></p><p><img src=\"/dailyinfo/media/ca460a10b9f10d9c.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img src=\"/dailyinfo/media/e8421b37b5151020.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>声明</span></strong></p><p><span>本安全公告仅用来描述可能存在的安全问题，绿盟科技不为此安全公告提供任何保证或承诺。由于传播、利用此安全公告所提供的信息而造成的任何直接或者间接的后果及损失，均由使用者本人负责，绿盟科技以及安全公告作者不为此承担任何责任。</span></p><p><span>绿盟科技拥有对此安全公告的修改和解释权。如欲转载或传播此安全公告，必须保证此安全公告的完整性，包括版权声明等全部内容。未经绿盟科技允许，不得任意修改或者增减此安全公告内容，不得以任何方式将其用于商业目的。</span></p><p><img src=\"/dailyinfo/media/e8421b37b5151020.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><span><strong><span>绿盟科技CERT</span></strong></span><span><span>∣</span></span><span><span>微信公众号</span></span></p><p><img src=\"/dailyinfo/media/91d1362baa3c1b98.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><img src=\"/dailyinfo/media/92c6a439501263e0.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>长按识别二维码，关注网络安全威胁信息</span></span></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=42e2d9a5&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzk0MjE3ODkxNg%3D%3D%26mid%3D2247494326%26idx%3D1%26sn%3D0024f2b1ed3f2501f3eed5b511583632\">跳转微信打开</a></p>","original","zhKind","complete","漏洞","补丁","复现","漏洞利用","利用链","https://mp.weixin.qq.com/s?__biz=Mzk0MjE3ODkxNg==&mid=2247494326&idx=1&sn=0024f2b1ed3f2501f3eed5b511583632","绿盟科技CERT",{"_108":109,"_110":-5},"changelogVersion","2026-10-01T08:00","release"]
