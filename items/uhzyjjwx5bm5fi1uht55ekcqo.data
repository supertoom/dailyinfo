[{"_1":2,"_3":4},"root",{"_5":110},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1794962448000,"id","uhzyjjwx5bm5fi1uht55ekcqo","title","Google Threat Intelligence Group 发现 AI agent 无人操作即编写并发起漏洞利用","originalTitle","Google finds AI agent writing and launching exploits with no human in the loop","summary","Google Threat Intelligence Group 与 Mandiant 披露，威胁行为者已让 AI agent 在入侵中独立完成部分环节：GTIG 在过去一个季度首次看到有攻击者用 LLM 框架在无人参与的情况下自动完成漏洞发现与利用。","reason","GTIG 披露了攻击者用 AI agent 自动完成漏洞发现与利用的完整链条，还原了 staging 服务器上的多智能体框架配置细节，便于防守方理解机器速度攻击留下的痕迹。","source",{"_67":109},"links",{"_98":108},"publishedAt","2026-11-17T08:45:24.000Z","discoveredAt","2026-11-17T09:35:30.521Z","timelineAt","category","ai-security","tags",[68,102,74,72,70,103,104,105,106,107],"score",82,"selected",true,"channel","news","story","x","readingMode","full","author","Sinisa Markovic","body",{"_59":97,"_98":-5,"_99":100,"_101":37},"outline",[79,80,81,82,83],"relatedStories",[],"topics",[60,61,62,63,64,65],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_66":77,"_67":78},{"_66":75,"_67":76},{"_66":73,"_67":74},{"_66":71,"_67":72},{"_66":69,"_67":70},{"_66":31,"_67":68},"slug","name","AI 安全","malware","恶意软件","attack","攻击活动","ai-offense","AI 攻防","black-market","数据窃取与黑产","google","Google / 谷歌",{"_11":95,"_85":96,"_87":88},{"_11":93,"_85":94,"_87":88},{"_11":91,"_85":92,"_87":88},{"_11":89,"_85":90,"_87":88},{"_11":84,"_85":86,"_87":88},"sec-5","text","旨在看起来像真人的虚假身份","level",3,"sec-4","用于植入后门的编程助手","sec-3","出售被盗 AI 访问权限","sec-2","在无人操作键盘的情况下编写并发起漏洞利用","sec-1","被用于对付受害者的渗透测试工具","<p>威胁行为者已开始让 <a href=\"https://www.helpnetsecurity.com/2026/09/08/ai-agents-cyberattacks-automation-google-research/\">AI 智能体</a>执行实时入侵的整个阶段；至少有一次行动不再需要人工将新发布的补丁转化为可用的攻击，Google Threat Intelligence Group (GTIG) 和 Mandiant 披露了这一点。</p><p><img src=\"/dailyinfo/media/342fe6d108ae92e2.webp\" loading=\"lazy\" decoding=\"async\" alt=\"AI-powered cyberattacks\" title=\"LLM maturity timeline\"></p><h5>\n<p>LLM 成熟度时间线（来源：Google）</p>\n</h5><p>Google 写道：“虽然入侵的机制仍然相同，例如使用被盗凭据和针对未打补丁的系统，但框架利用这些已知弱点的速度和规模带来了新的防御挑战。”</p><h3 id=\"sec-1\">被用于对付受害者的渗透测试工具</h3><p>Google 的分析师看到多个威胁行为者在入侵期间使用开源智能体渗透测试框架。<a href=\"https://www.helpnetsecurity.com/2026/11/09/artex-goes-from-pentesting-tool-to-attacker-staple-in-three-months/\">ARTEX</a> 引起了最多关注，并促使 FBI 作出响应。在 11 月 13 日发布的 FLASH <a href=\"https://www.ic3.gov/CSA/2026/261113.pdf\">警报</a>中，该局警告称，自 2026 年 8 月以来，至少已有攻击者使用该工具针对金融服务、政府、科技、国防、医疗、能源及其他行业的组织。</p><p>攻击者还在运行 <a href=\"https://www.helpnetsecurity.com/2026/09/22/cairn-open-source-framework-ai-malware-closedquorum/\">CAIRN</a>、CyberStrikeAI、PentAGI 和 HexStrike AI，其中一些人还尝试使用自行构建的测试工具框架。这些工具能够发现并利用简单漏洞，并根据目标的返回结果调整策略。</p><p>尝试使用这些工具的团体包括以牟利为目的的威胁行为者和疑似与中国有关的间谍组织；GTIG 发现证据表明，一个与中国内地有关的团体正在构建自己的自动化攻击框架，很可能用于间谍活动。</p><p>GTIG 指出，现阶段这些框架“以隐蔽性换取速度”，并会留下流量和代码痕迹，使其更容易被发现。</p><p>研究人员表示：“随着这些工具及其底层 LLM 日益成熟，我们预计这些行动中的人工参与不仅会减少，其隐蔽性和复杂程度也会提高。”</p><h3 id=\"sec-2\">在无人操作键盘的情况下编写并发起漏洞利用</h3><p>GTIG 表示，在过去一个季度中，它看到威胁行为者使用 LLM 框架自动化漏洞发现与利用，“这是首次在无人参与的情况下实现”。</p><p>证据来自一个暴露在外的暂存服务器，该服务器托管着一个名为 exploit_agent 的多智能体框架，并连接了多个前沿及本地 LLM。该设置会在补丁公告发布前后比较流行 Web 应用的代码，寻找漏洞、起草漏洞利用并运行。</p><p>除了从受害者处窃取的数据外，该服务器还存有用于暴力破解、安装 webshell 以及移除其他攻击者植入的 webshell 的脚本。配置文件中的注释以俄语编写，其中一处将 LLM API 密钥标记为“用于自动漏洞利用（exploit_agent 试点）”。受害者遥测数据表明，该操作者对与媒体、娱乐和教育相关的法国网站感兴趣。</p><p>GTIG 对 9 月漏洞数据的分析发现，披露和漏洞利用数量在 2026 年 1 月至 8 月间几乎翻了一番；8 月的零日漏洞利用数量跃升至 22 起，而 2025 年平均为每月 8 起。</p><p>防御者还必须应对大量“声称可用但实际上无法使用的 LLM 生成漏洞利用”。在针对两个 PHP 漏洞的官方<a href=\"https://www.helpnetsecurity.com/2026/10/22/php2shell-vulnerability-fortinet-cisco-palo-alto-networks/\">补丁</a>（CVE-2026-109618 和 CVE-2026-109619）于 10 月 21 日发布后，网上出现了数百个无法正常工作的概念验证，安全社区不得不逐一检查。</p><h3 id=\"sec-3\">出售被盗 AI 访问权限</h3><p>Mandiant 响应了 2026 年的多起 LLMJacking 事件，攻击者入侵云环境，以耗尽受害者的计算资源和 LLM 配额。在某些情况下，欺诈性费用一天就超过 $100,000；在最严重的情况下，滥用被停止前的总额<a href=\"https://www.helpnetsecurity.com/2026/11/03/llmjacking-stolen-ai-access-cloud-bills/\">达到 $1 million</a>。</p><p>在一个案例中，一个使用泄露凭据的僵尸网络“在凭据被撤销前约 24 小时内生成了数百万次 LLM API 调用”。被盗访问权限通过 GTIG 所称的“LLM Mixers”转售；这些地下商店提供前沿模型和越狱模型，价格为每百万 tokens $0.10 至 $25。</p><h3 id=\"sec-4\">用于植入后门的编程助手</h3><p>对于<a href=\"https://www.helpnetsecurity.com/2026/09/21/north-korean-hackers-contagious-interview-defenses/\">朝鲜的虚假 IT 员工</a>而言，LLM 工具已成为一种求职辅助工具，可撰写简历，并帮助他们在西方公司的面试中表现得真实可信。</p><p>GTIG 观察到，朝鲜的战术在 2026 年期间发生了变化，并开始利用 AI 入侵公司本身。在针对北美和欧洲加密货币组织的攻击中，一个疑似名为 MIDNIGHT NEPTUNE 的集群建立了虚假的招聘人员资料，其照片带有 SynthID 水印，证实这些照片由 AI 生成。这些虚假招聘人员将目标引向虚假的会议平台，并利用 <a href=\"https://www.helpnetsecurity.com/2026/07/15/clickfix-social-engineering-attacks-report/\">ClickFix</a> 诱饵诱使他们运行“诊断”脚本。</p><p>入侵后，攻击者进入内部代码仓库，并修改 .claude/settings.json 文件，使得启动 Claude Code 时“会自动触发 SOMBERMEME 后门的下载”。为了在横向移动期间融入环境，他们以 Microsoft Copilot 命名自己生成的 GitHub Personal Access Token。</p><h3 id=\"sec-5\">旨在看起来像真人的虚假身份</h3><p>GTIG 高度确信，影响行动参与者已从测试 LLM 转向例行使用 LLM。2026 年 8 月，它调查了一个旨在自动化整个欧洲和中东地区政治议题影响活动的平台。其提示词要求模型模仿当地方言和俚语，并加入“有意设置的拼写错误，以免听起来像自动化工具”；同时，生成的图像被添加颗粒感和不均匀光照，以冒充智能手机拍摄的照片。</p><p>另一名承包商正在构建一个平台，计划通过云端手机农场运行超过 100,000 个账户。新账户会经历一段自动化的“老化”期，由 LLM 模拟普通用户的滚动和浏览操作，之后这些账户才开始推送竞选活动信息。提示词显示，该承包商计划将该工具出售给本国政府和外国客户。</p><p>研究人员总结道：“威胁行为者对这些框架的采用 represents a paradigm shift towards intrusions occurring at machine speed, with the automated chaining of complex attack paths scaling operations significantly。”</p>","original","zhKind","translation","complete","Agent 安全","黑产","Google","Microsoft","CISA","PHP","https://www.helpnetsecurity.com/2026/11/17/ai-powered-cyberattacks-gtig-report/","Help Net Security",{"_111":112,"_113":-5},"changelogVersion","2026-10-01T08:00","release"]
