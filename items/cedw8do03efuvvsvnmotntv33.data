[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":-5,"_57":36,"_58":59},"expiresAt",1794271232000,"id","cedw8do03efuvvsvnmotntv33","title","Chrome Extended Stable 156.0.8078.96 修复 11 个安全漏洞","originalTitle","Extended Stable Update for Desktop","summary","Chrome Extended Stable 渠道面向 Windows 和 Mac 更新至 156.0.8078.96，将在数日至数周内推送，包含 11 个安全修复。","reason","source",{"_64":78},"links",{"_59":77},"publishedAt","2026-11-09T20:45:01.211Z","discoveredAt","2026-11-09T21:33:26.701Z","timelineAt","category","vuln","tags",[74,75,67,76],"score",47,"selected",false,"channel","news","story","x","readingMode","full","author","Srinivas Sista","body",{"_70":-5,"_59":71,"_72":-5,"_73":36},"outline",[],"relatedStories",[],"topics",[60,61,62],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_63":68,"_64":69},{"_63":66,"_64":67},{"_63":30,"_64":65},"slug","name","漏洞披露","browser","浏览器","google","Google / 谷歌","zh","<p>&nbsp;<span>The Extended Stable channel has been updated to 156.0.8078.96</span><span>&nbsp;</span><span>for Windows and Mac </span><span>which will roll out over the coming days/weeks.</span><span> </span></p><p><span><span>Security Fixes<br></span><span>Note: Access to bug details and links may be kept restricted until a majority of users are updated with a fix. We will also retain restrictions if the bug exists in a third party library that other projects similarly depend on, but haven’t yet fixed.</span></span></p><p><span><span><br></span><span>This update includes </span><a href=\"https://issues.chromium.org/issues?q=customfield1223088:4-M156-EXT\"><span>11</span></a><span> security fixes</span><span>. Please see the </span><a href=\"https://www.chromium.org/Home/chromium-security\"><span>Chrome Security Page</span></a><span> for more information.</span></span></p><p><span><span><span><br></span></span><span>[</span><a href=\"https://issues.chromium.org/issues/577327383\"><span>577327383</span></a><span>] High CVE-2026-121068</span><b><br></b><span>[</span><a href=\"https://issues.chromium.org/issues/578670966\"><span>578670966</span></a><span>] High CVE-2026-121076</span><b><br></b><span>[</span><a href=\"https://issues.chromium.org/issues/558111285\"><span>558111285</span></a><span>] High CVE-2026-121095</span><b><br></b><span>[</span><a href=\"https://issues.chromium.org/issues/577402416\"><span>577402416</span></a><span>] High CVE-2026-121208</span><b><br></b><span>[</span><a href=\"https://issues.chromium.org/issues/574762568\"><span>574762568</span></a><span>] High CVE-2026-121213</span><b><br></b><span>[</span><a href=\"https://issues.chromium.org/issues/552757015\"><span>552757015</span></a><span>] High CVE-2026-121233</span><b><br></b><span>[</span><a href=\"https://issues.chromium.org/issues/550525698\"><span>550525698</span></a><span>] High CVE-2026-125345</span><b><br></b><span>[</span><a href=\"https://issues.chromium.org/issues/572578603\"><span>572578603</span></a><span>] High CVE-2026-125346</span><b><br></b><span>[</span><a href=\"https://issues.chromium.org/issues/561996724\"><span>561996724</span></a><span>] High CVE-2026-125347</span><b><br></b><span>[</span><a href=\"https://issues.chromium.org/issues/582442907\"><span>582442907</span></a><span>] High CVE-2026-125350</span><br><span>[</span><a href=\"https://issues.chromium.org/issues/565681451\"><span>565681451</span></a><span>] Medium CVE-2026-121184</span></span></p><p><span><span><span><span>A full list</span><span> of changes in this build is available in </span><span>the </span><a href=\"https://chromium.googlesource.com/chromium/src/+log/156.0.8078.88..156.0.8078.96?pretty=fuller&amp;n=10000\">log</a></span></span></span><span>. Interested in switching release channels? Find out how </span><a href=\"https://www.chromium.org/getting-involved/dev-channel\"><span>here</span></a><span>. If you find a new issue, please let us know by </span><a href=\"https://crbug.com/\"><span>filing a bug</span></a><span>. </span><span>The </span><a href=\"https://productforums.google.com/forum/#!forum/chrome\"><span>community help forum</span></a><span> is also a great place to reach out for help or learn about common issues.</span></p><p><span><span><span>Srinivas Sista</span></span></span></p><p><span><span>Google Chrome</span></span></p>","zhKind","complete","补丁","版本更新","Google","http://chromereleases.googleblog.com/2026/11/extended-stable-update-for-desktop_0910980127.html","Chrome Releases",{"_80":81,"_82":-5},"changelogVersion","2026-10-01T08:00","release"]
