[{"_1":2,"_3":4},"root",{"_5":99},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1794789635000,"id","y1c8ltpl2iqy9t7vw429lcgww","title","Apple 详解 Secure Enclaves 如何隔离摄像头与麦克风数据","originalTitle","Apple Reveals How Secure Exclaves Shield Camera and Microphone Data","summary","Apple 公开 Secure Enclaves 安全架构的运行机制，通过隔离运行环境处理摄像头和麦克风数据，主操作系统、应用及 Apple 均无法访问在 Secure Enclave 内处理和分析的数据。","reason","source",{"_75":98},"links",{"_61":97},"publishedAt","2026-11-14T11:00:00.000Z","discoveredAt","2026-11-14T14:12:42.908Z","timelineAt","category","disclosure","tags",[76,93,94,95,80,96],"score",59,"selected",false,"channel","news","story",{"_86":87,"_13":88},"x","readingMode","full","author","Eduard Kovacs","body",{"_89":-5,"_61":90,"_91":-5,"_92":36},"outline",[],"relatedStories",[85],"topics",[68,69,70,71,72],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","ficOgOgg0vTc","reportCount",2,"additionalSourceCount",1,{"_73":83,"_75":84},{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","research","name","技术研究","iot","IoT 与车联网","mobile","移动端","kernel","内核与系统","apple","Apple / 苹果",{"_86":87,"_13":88},"publicId","ac36a15a-d78b-4ccf-8cfa-2b6e9c56057f","Apple披露Secure Enclaves传感器数据隔离架构","zh","<p><strong>Apple has published a detailed description of Secure Exclaves, a security architecture in its silicon designed to keep camera and microphone data used for ambient sensing isolated from the main operating system.</strong>\n\n\n\n</p><p>Ambient sensing lets a device listen for “Hey Siri”. On the recently introduced HomeView smart display, it enables the recognition of user faces and voices.\n\n\n\n</p><p>Secure Exclaves are isolated runtimes that handle camera and microphone data apart from the rest of the device.&nbsp;\n\n\n\n</p><p>“Isolation features added across many core components of the silicon work in tandem to protect Secure Exclaves and keep them segregated from the rest of the system. Data that is processed and analyzed in a Secure Exclave cannot be accessed by the main operating system, apps, or Apple,” the company <a href=\"https://security.apple.com/blog/secure-exclaves/\">said</a>.\n\n\n\n</p><p>The design is built around three requirements. The main OS must not be able to pull out or alter data handled in an exclave, and only a narrowly defined set of information may cross over to it. Users must also be able to tell when a sensor session is active, without the main OS interfering.\n\n\n\n</p><p>According to Apple, in background sensing only specific metadata reaches the rest of the system. On HomeView, the recognition result sent to the main OS is a person identifier, position and confidence level, without audio or video data being shared.</p><p><span>Advertisement. Scroll to continue reading.</span></p><p>When an app requests full sensor access, a dedicated exclave acts as gatekeeper. Sensor data is released only once it has confirmed the indicator is on and has been showing for a sufficient period.\n\n\n\n</p><p>On devices such as the iPhone, where the indicator is an on-screen dot, another exclave checks which pixels were actually drawn to the display.\n\n\n\n</p><p>Apple said Secure Exclaves protect person recognition on HomeView, along with Siri Recap and Live Rewind. They also protect the on-screen camera and microphone indicators in iPhone 18 Pro, iPhone 18 Pro Max and iPhone Duo, and the camera indicators in MacBook Neo and HomeView.\n\n\n\n</p><p>The exclaves run on a minimal, capability-based microkernel, to which Apple has been applying formal verification. Apple said this turned up hard-to-spot but critical flaws in many kernel subsystems that could have led to full kernel compromise. Many of these issues were caught early in development.\n\n\n\n</p><p>The microkernel is still under active development and changes often, Apple noted. “Because of these constant changes, we do not claim complete coverage of all aspects of the kernel; instead, formal verification is applied gradually and incrementally to different parts,” it said.\n\n\n\n</p><p><strong>Related</strong>: <a href=\"https://www.securityweek.com/apple-patches-meta-reported-zero-day-linked-to-extremely-sophisticated-attack\">Apple Patches Zero-Day Linked to ‘Extremely Sophisticated Attack’</a>\n\n\n\n</p><p><strong>Related</strong>: <a href=\"https://www.securityweek.com/bluetooth-airplay-pairing-vulnerabilities-patched-across-apple-platforms/\">Bluetooth, AirPlay Pairing Vulnerabilities Patched Across Apple Platforms</a>\n\n\n\n</p><p><strong>Related</strong>: <a href=\"https://www.securityweek.com/apple-to-tighten-full-disk-access-controls-in-macos-amid-ai-risks/\">Apple to Tighten Full Disk Access Controls in macOS Amid AI Risks</a>\n\n\n\n</p>","zhKind","complete","漏洞分析","Apple","IoT","操作系统","https://www.securityweek.com/apple-reveals-how-secure-exclaves-shield-camera-and-microphone-data/","SecurityWeek",{"_100":101,"_102":-5},"changelogVersion","2026-10-01T08:00","release"]
