[{"_1":2,"_3":4},"root",{"_5":101},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1794357639000,"id","maj0nbk20xdjhzz44690rvn06","title","AWS 更新 ProcessUnity Global Risk Exchange 评估，强化云供应商第三方尽职调查","originalTitle","AWS refreshes ProcessUnity Global Risk Exchange assessment to enhance customer’s third-party due diligence","summary","AWS 更新 ProcessUnity Global Risk Exchange 评估报告，帮助客户审查 AWS 安全状况并完善第三方风险管理。评估以动态分析、威胁情报和风险模型替代静态表格，由 ProcessUnity 每年验证结果；客户还可将 AWS 控制项映射至 MITRE ATT&CK、NIST 800-53、ISO 27001、PCI DSS 和 HIPAA，并通过提交访问申请获取报告。","reason","source",{"_72":100},"links",{"_61":99},"publishedAt","2026-11-10T21:31:14.000Z","discoveredAt","2026-11-10T21:55:45.238Z","timelineAt","category","policy","tags",[95,96,97,98],"score",20,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","readingMode","full","author","Naranjan Goklani","body",{"_91":-5,"_61":92,"_93":-5,"_94":36},"outline",[80,81,82],"relatedStories",[76],"topics",[68,69],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fMmLlRa5QmYg","reportCount",1,"additionalSourceCount",0,{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","compliance","name","合规与标准","supply-chain","供应链安全",{"_77":78,"_13":79},"publicId","f07351b8-e5eb-4144-b5b3-1a84888e93a2","AWS续签ProcessUnity风险评估",{"_11":89,"_84":90,"_85":86},{"_11":87,"_84":88,"_85":86},{"_11":83,"_84":45,"_85":86},"sec-3","text","level",3,"sec-2","How can you access the assessment?","sec-1","What is the AWS ProcessUnity Global Risk Exchange assessment","zh","<p><span><a href=\"https://aws.amazon.com/\">Amazon Web Services (AWS)</a></span> is pleased to announce renewal of the <span><a href=\"https://aws.amazon.com/compliance/cybergrx/\">AWS ProcessUnity Global Risk Exchange assessment</a></span>. This validated assessment report helps customers perform effective cloud supplier due diligence on AWS and enhances their third-party risk management process.</p><h3 id=\"sec-1\">What is the AWS ProcessUnity Global Risk Exchange assessment</h3><p>Many customers use third-party cyber risk management (TPCRM) services such as <span><a href=\"https://www.processunity.com/\">ProcessUnity</a></span> to better manage risks from their evolving third-party environments and to drive operational efficiencies. To help with such efforts, AWS has completed the <span><a href=\"https://aws.amazon.com/compliance/cybergrx/\">ProcessUnity Global Risk Exchange assessment</a></span> of its security posture. ProcessUnity’s assessors perform the review of Global Risk Exchange assessment and validate the results annually.</p><p>This assessment approach replaces static spreadsheets with a dynamic system that combines advanced analytics, threat intelligence, and risk models with vendor input. Vendor profiles continuously update as cloud provider risk levels and AWS security posture evolve, keeping risk matrices current in near real time. Additionally, customers can also use <span><a href=\"https://processunity.zendesk.com/hc/en-us/articles/31159463320731-Framework-View\">Framework View</a></span> which maps AWS assessment controls to threat profiles, MITRE ATT&amp;CK scenarios, and global compliance standards and frameworks including National Institute of Standards and Technology (NIST) 800-53, International Organization for Standardization (ISO) 27001, Payment Card Industry Data Security Standard (PCI DSS), and Health Insurance Portability and Accountability Act (HIPAA), significantly reducing customers’ third-party due diligence burden.</p><h3 id=\"sec-2\">How can you access the assessment?</h3><p>Customers can request access to the report by completing an access request form, available on the <span><a href=\"https://aws.amazon.com/compliance/cybergrx/\">ProcessUnity Global Risk Exchange page</a></span>. If you are an existing ProcessUnity Global Risk Exchange member, you can request access from within <span><a href=\"https://auth.portal.cybergrx.com/\">ProcessUnity Global Risk Exchange</a></span> portal.</p><p>To learn more about our compliance and security programs, see <span><a href=\"https://aws.amazon.com/compliance/programs/\">AWS Compliance Programs</a></span>. As always, we value your feedback and questions; reach out to the AWS Compliance team through the <span><a href=\"https://pages.awscloud.com/compliance-contact-us.html\">Contact Us page</a></span>.</p><hr><p> \n   <img src=\"/dailyinfo/media/0a870a11add8df62.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\" width=\"120\" height=\"160\"> \n  </p><h3 id=\"sec-3\">Naranjan Goklani</h3><p>Naranjan is an WS Compliance, Security Assurance and Privacy (CAPS) Lead for Canada. He has experience leading audits, attestations, certifications, and assessments across the Americas. Naranjan has more than 16 years of experience in technology risk management, customer security assurance, and technology audits. He previously worked in the Big 4 accounting firms and supported clients from the financial services, technology, retail, and utilities industries.</p>","zhKind","complete","版本更新","合规","供应链","AWS","https://aws.amazon.com/blogs/security/aws-refreshes-processunity-global-risk-exchange-assessment-to-enhance-customers-third-party-due-diligence/","AWS Security Blog",{"_102":103,"_104":-5},"changelogVersion","2026-10-01T08:00","release"]
