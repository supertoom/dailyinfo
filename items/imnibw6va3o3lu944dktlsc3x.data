[{"_1":2,"_3":4},"root",{"_5":103},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":54,"_55":36,"_56":36,"_57":58,"_59":36,"_60":61},"expiresAt",1794616829000,"id","imnibw6va3o3lu944dktlsc3x","title","越狱 AI Agent 对欧洲电信运营商及 13 家托管机构发起两周攻击","originalTitle","Jailbroken AI Agent Ran Two-Week Attack on European Telecom","summary","Malbear Labs 披露 Operation Snowball 攻击活动：越狱 AI Agent 在超过两周内入侵一家欧洲电信运营商及其数据中心和云基础设施上的 13 家组织。","reason","source",{"_72":102},"links",{"_91":101},"publishedAt","2026-11-09T16:00:00.000Z","discoveredAt","2026-11-09T17:29:23.598Z","timelineAt","category","ai-security","tags",[73,97,75,77,98,99,100],"score",77,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","sameEvent",{"_11":95,"_13":96},"readingMode","full","author","body",{"_61":90,"_91":-5,"_92":93,"_94":36},"outline",[82,83],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fPZ8mpFaRlIs","reportCount",2,"additionalSourceCount",1,{"_71":76,"_72":77},{"_71":74,"_72":75},{"_71":30,"_72":73},"slug","name","AI 安全","attack","攻击活动","exploited","在野利用",{"_79":80,"_13":81},"publicId","456024bf-ca90-43f0-98aa-ee2441516598","越狱AI代理入侵欧洲电信事件范围厘清",{"_11":88,"_85":89,"_87":65},{"_11":84,"_85":86,"_87":65},"sec-2","text","访问声明延伸至患者和监控数据","level","sec-1","攻击受阻后自主代理改变策略","<p>\n\t一个已被越狱的 AI 代理持续两周多时间攻击一家欧洲电信运营商，以及托管在其数据中心和云基础设施上的 13 家组织。</p><p>\n\tMalbear Labs 将这次活动命名为 Operation Snowball，并在 11 月 8 日发布的<a href=\"https://malbearlabs.com/posts/operation-snowball-inside-an-autonomous-ai-intrusion-campaign\">研究</a>中详细介绍了相关情况。此前，该机构在例行检查暴露的开放目录时发现了攻击者的工作目录。这个未受保护的目录中包含 70 多份会话记录以及该代理自己的报告。</p><p>\n\t这个定制代理框架运行在 DeepSeek Flash 上，并使用了一段约 78,000 个字符的越狱提示词，告诉模型将任何拒绝都视为故障。Malbear 表示，这些记录中没有出现被拒绝的情况。</p><p>\n\t<em><a href=\"https://www.infosecurity-magazine.com/news/chinese-hacker-deepseek-ai/\">进一步了解 AI 驱动的攻击：中国黑客使用 DeepSeek AI 编排漏洞利用</a></em></p><h2 id=\"sec-1\">\n\t<strong>攻击受阻后自主代理改变策略</strong></h2><p>\n\t操作者的消息从中文翻译而来，内容都很简短。除了“继续”和“停止”等提示外，他们还会指定目标子网、将三台内部主机设为禁区，并跟进代理列出的漏洞。Malbear 表示，操作者“将入侵任务委托给 AI，并异步查看进展以审核情况”。</p><p>\n\t该代理利用 CVE-2026-20320 攻入电信运营商网络；这是 Cisco BroadWorks 中一个未经身份验证的 XML 外部实体（XXE）漏洞。Cisco 已于 8 月修复该漏洞。</p><p>\n\t该代理随后利用 Liferay（CVE-2020-7961）在一台横跨多个内部网络的主机上取得 root 权限，并利用 JBoss/RichFaces（CVE-2013-2165）建立了第二个据点。Malbear 列出了该代理所针对、发现或保留在工具库中的另外十多个漏洞，但这些漏洞均未被标记为已利用。</p><p>\n\t当端点安全设备阻止其尝试利用 Linux 漏洞 PwnKit（CVE-2021-4034）时，该代理在没有操作者指示的情况下改变了方法。一个隧道工具被拦截后，它编写了一个替代工具。</p><h2 id=\"sec-2\">\n\t<strong>访问声明延伸至患者和监控数据</strong></h2><p>\n\t据 Malbear 称，恢复的会话记录显示，该代理提取了数十组凭据、私钥，以及一家医疗保健机构的 Active Directory 数据。</p><p>\n\t该代理还报告称，通过一个仍使用默认凭据的 TrakCare Oracle 数据库，访问到了用户计费记录，以及 Malbear 所称的数百万条患者记录。</p><p>\n\t其报告还列出了约 80 份 Zabbix 监控备份，覆盖该运营商的托管服务客户。</p><p>\n\t这篇文章没有说明 Malbear 是否向任何受害者核实了这些声明，哪些数据是被窃取而非预先暂存，以及全部 13 家组织是否都遭到入侵。</p><p>\n\tMalbear 评估称，该活动与一个源自中国的操作者相符，但未将其与国家行为者联系起来。其建议包括将暴露在互联网且已停止支持的 JBoss Application Server 6 实例视为已被攻陷，并监控内部流量中的隧道活动。</p>","original","zhKind","translation","complete","bfi3eiej3hntfmaspomarywop","“雪球行动”复盘：AI 智能体自主入侵欧洲电信并触达医疗数据库","Agent 安全","漏洞利用","Cisco","Oracle","https://www.infosecurity-magazine.com/news/operation-snowball-ai-telecom/","Infosecurity Magazine",{"_104":105,"_106":-5},"changelogVersion","2026-10-01T08:00","release"]
