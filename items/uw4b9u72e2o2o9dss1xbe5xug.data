[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1794616834000,"id","uw4b9u72e2o2o9dss1xbe5xug","title","FBI 扣押从 Binance 窃取的逾 12 亿美元加密货币，并归因 North Korea 攻击","originalTitle","FBI Says US Seized $1.2 Billion Worth of Cryptocurrency Stolen From Binance","summary","FBI 宣布已获法院授权扣押或限制从 Binance 窃取的资金，超过 1.2 billion 美元；该交易所上月遭窃约 6.3 billion 美元，被视为史上规模最大的加密货币盗窃案，FBI 此前将事件归因于 North Korea 黑客组织 TraderTraitor。","reason","材料说明 FBI 已司法授权扣押逾 12 亿美元被盗加密资产，同时交代 FaceStealer 社会工程链及冻结资金规模，便于判断事件进展与追赃情况。","source",{"_64":85},"links",{"_77":84},"publishedAt","2026-11-13T02:28:21.000Z","discoveredAt","2026-11-13T02:45:27.320Z","timelineAt","category","activity","tags",[65,81,82,83],"score",70,"selected",true,"channel","news","story","x","readingMode","full","author","Associated Press","body",{"_59":76,"_77":-5,"_78":79,"_80":37},"outline",[68,69],"relatedStories",[],"topics",[60,61],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_62":66,"_64":67},{"_62":63,"_64":65},"slug","attack","name","攻击活动","crypto","密码学",{"_11":75,"_71":72,"_73":74},{"_11":70,"_71":72,"_73":74},"sec-2","text","每日简报新闻简报","level",2,"sec-1","<p><img width=\"1200\" height=\"675\" src=\"/dailyinfo/media/48f0b42e7122cf7a.jpg\" srcset=\"/dailyinfo/media/0ee50bdd45555ee7.jpg 720w, /dailyinfo/media/757e2701ec57ef66.jpg 1200w, /dailyinfo/media/48f0b42e7122cf7a.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Binance hacked\"></p><p><strong>美国联邦调查局（FBI）周四表示，已查扣据报上月从全球最大加密货币交易所 Binance 盗走的逾 $1.2 billion 加密货币。</strong>\n\n\n\n</p><p><a href=\"https://www.securityweek.com/6-billion-binance-hack-bears-hallmarks-of-north-koreas-tradertraitor/\">Binance 约 $6.3 billion 加密货币被盗案</a>被视为史上规模最大的加密货币劫案，<a href=\"https://www.securityweek.com/fbi-flags-over-600-addresses-tied-to-north-koreas-binance-heist/\">FBI</a>此前已将此事归咎于一个名为 <a href=\"https://www.securityweek.com/6-billion-binance-hack-bears-hallmarks-of-north-koreas-tradertraitor/\">TraderTraitor</a>的朝鲜黑客组织。美国政府和私营部门迄今已联合冻结逾 $2.7 billion 的被盗资金；司法部周四表示，目前已获得法院授权，可查扣或限制其中逾 $1.2 billion 的资金。\n\n\n\n</p><p>通常在此类情况下，美国政府会向法官提交没收申请，随后由法官裁定谁对追回的资金享有合法权利。\n\n\n\n</p><p><strong>[阅读</strong>：&nbsp;<a href=\"https://www.securityweek.com/north-korea-launches-missiles-toward-the-sea-as-pyongyang-protests-against-us-claims-on-binance-hack/\">朝鲜向海上发射导弹，以抗议有关 Binance 黑客事件的指控</a>&nbsp;<strong>]</strong>\n\n\n\n</p><p>FBI 周四还指责朝鲜策划了另一起社会工程攻击方案；官员称，该方案在过去 18 个月中导致价值 $400 million 的加密货币被盗。这一名为 FaceStealer 的方案涉及一系列复杂环节，包括劫持热门通信应用以及录制深度伪造视频。\n\n\n\n</p><p>美国官员多次指控朝鲜利用网络攻击方案为其政权筹集资金，包括支持其非法武器项目。</p><p><span>广告。滚动以继续阅读。</span></p><p><strong>相关报道</strong>：<a href=\"https://www.securityweek.com/rigged-coding-assignment-abused-ai-tool-opened-path-to-6-billion-binance-heist/\">编程作业遭操纵，遭滥用的 AI 工具为 $6 Billion Binance 劫案打开通道</a>\n\n\n\n</p><p><strong>相关报道</strong>：&nbsp;<a href=\"https://www.securityweek.com/chainalysis-discloses-data-breach-following-ai-driven-cyberattack/\">Chainalysis 披露 AI 驱动的网络攻击导致数据泄露</a>\n\n\n\n</p><p><strong>相关报道</strong>：<a href=\"https://www.securityweek.com/6-billion-binance-hack-bears-hallmarks-of-north-koreas-tradertraitor/\">$6 Billion Binance 黑客事件带有朝鲜 TraderTraitor 的典型特征</a><br>\n      </p><p><img src=\"/dailyinfo/media/2b345a77e06e19b6.jpg\" loading=\"lazy\" decoding=\"async\">\n                  </p><h2 id=\"sec-1\">每日简报新闻简报</h2><p>\n            订阅 SecurityWeek 邮件简报，获取最新网络安全威胁、趋势和专家\n            洞察。\n          </p><p><img src=\"/dailyinfo/media/63d674d1148aeb00.webp\" loading=\"lazy\" decoding=\"async\"></p><h2 id=\"sec-2\">每日简报新闻简报</h2><p>订阅 SecurityWeek 邮件简报，持续了解最新威胁、趋势和技术，以及行业专家的深入专栏。</p><p>加入我们，与 CISO、高级网络安全主管、从业者、行业专家及其他安全领袖汇聚一堂，分享实践经验并探讨影响企业网络安全战略的问题。</p><p><a href=\"https://virtual.cisoforum.com/\">注册</a>\n\t\t\t</p><p>加入我们，了解将安全融入智能体 SDLC 的四个层级——从保护开发人员智能体编写的代码，到运行由你亲自构建的协同安全智能体系统。</p><p><a href=\"https://event.on24.com/wcc/r/5551334/69E7D3590FBECB0B1885BC01C793B156?partnerref=awidget\">注册</a>\n\t\t\t</p>","original","zhKind","translation","complete","数据泄露","加密","AWS","https://www.securityweek.com/fbi-says-us-seized-1-2-billion-worth-of-cryptocurrency-stolen-from-binance/","SecurityWeek",{"_87":88,"_89":-5},"changelogVersion","2026-10-01T08:00","release"]
