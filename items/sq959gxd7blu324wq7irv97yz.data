[{"_1":2,"_3":4},"root",{"_5":89},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795912848000,"id","sq959gxd7blu324wq7irv97yz","title","Cacti 未授权远程代码执行漏洞 QVD-2026-117631 已复现，CVSS 3.1 9.8","originalTitle","【已复现】Cacti 未授权远程代码执行漏洞(QVD-2026-117631)安全风险通告","summary","Cacti 未授权远程代码执行漏洞 QVD-2026-117631 可由未认证攻击者通过少量 HTTP 请求执行任意命令，影响量为万级，CVSS 3.1 分数为 9.8，奇安信评级高危。","reason","文章给出了完整利用链、利用前提和资产测绘数据，可用于判断暴露范围并落实补丁前缓解措施。","source",{"_71":88},"links",{"_80":87},"publishedAt","2026-11-27T09:24:00.000Z","discoveredAt","2026-11-28T17:26:38.876Z","timelineAt","category","vuln","tags",[83,84,85,86,74],"score",75,"selected",true,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","body",{"_61":79,"_80":-5,"_81":80,"_82":37},"outline",[],"relatedStories",[75],"topics",[68,69],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","f6ZAsYycycU8","reportCount",5,"additionalSourceCount",4,{"_70":73,"_71":74},{"_70":31,"_71":72},"slug","name","漏洞披露","qianxin","奇安信",{"_76":77,"_13":78},"publicId","5f727b7b-3657-4338-b837-306e337b299b","Cacti 1.2.31未授权RCE PoC已公开","<p><span>奇安信 CERT</span> <span>2026-11-27 17:24</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/cd2a87815677c8b8.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>致力于第一时间为企业级用户提供权威漏洞情报和有效解决方案。</p><p><span><span>●&nbsp;</span></span><span><span>点击↑蓝字关注我们，获取更多安全风险通告</span></span></p><hr><table><tbody><tr><td colspan=\"4\" align=\"center\"><p><span><strong><span><span>漏洞概述</span></span></strong></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>漏洞名称</span></span></strong></span></p></td><td colspan=\"3\" align=\"left\"><p><span><span>Cacti 未授权远程代码执行漏洞</span></span></p></td></tr><tr><td align=\"left\"><p><span><span><strong><span>漏洞编号</span></strong></span></span></p></td><td colspan=\"3\" align=\"left\"><p><span><span>QVD-2026-117631</span></span></p></td></tr><tr><td align=\"left\"><p><strong><span><strong><span><span>公开时间</span></span></strong></span></strong></p></td><td align=\"left\"><p><span><span>2026-11-26</span></span></p></td><td align=\"left\"><p><strong><span><strong><span><span>影响量级</span></span></strong></span></strong></p></td><td align=\"left\"><p><span><span>万级</span></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>奇安信评级</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>高危</span></span></strong></span></p></td><td align=\"left\"><p><strong><span><span>CVSS 3.1分数</span></span></strong></p></td><td align=\"left\"><p><span><span><strong><span>9.8</span></strong></span></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span>威胁类型</span></strong></span></p></td><td align=\"left\"><p><span><span><span>代码执行</span></span></span></p></td><td align=\"left\"><p><strong><span><span>利用可能性</span></span></strong></p></td><td align=\"left\"><p><strong><span><strong><span>高</span></strong></span></strong></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>POC状态</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>已公开</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>在野利用状态</span></span></strong></span></p></td><td align=\"left\"><p><span><span><span>未发现</span></span></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>EXP状态</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span><span>已公开</span></span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>技术细节状态</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span><span>已公开</span></span></span></strong></span></p></td></tr><tr><td colspan=\"4\" align=\"left\"><p><strong><span><span>危害描述：</span></span></strong><span><span>攻击者可利用该漏洞，在无需登录的情况下通过少量 HTTP 请求即可在 Cacti 服务器上执行任意命令，获取服务器控制权，并进一步窃取设备凭据、篡改监控数据或以此为跳板渗透内网。</span></span></p></td></tr></tbody></table><p><strong><span>0</span></strong><strong><span>1</span></strong></p><p><strong><span>漏洞详情</span></strong></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>影响组件</span></span></strong></p><p><span>Cacti 是一款开源的网络监控与图形化工具，广泛用于企业环境中采集路由器、交换机、服务器等设备的性能数据。它通过 SNMP、脚本等方式收集指标，并生成历史图表，同时存储大量设备凭证（如 SNMP 社区字符串、登录账号等），成为网络管理的核心信任节点。许多组织依赖其进行实时监控与告警。</span></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>漏洞描述</span></span></strong></p><p><span>近日，奇安信CERT监测到<span>Cacti 未授权远程代码执行漏洞(QVD-2026-117631)</span>在互联网公开，该漏洞源于 Guest 用户可通过 auth_profile.php 写入任意字符串到本应仅接受数字的 preview_graphs_per_page 设置。该设置后续被 graph_view.php 作为默认值直接拼接到 SQL LIMIT 子句中，因 PDO 支持多语句执行，攻击者可注入 UPDATE 语句修改 poller_item 表中的 arg1 字段。随后调用 graph_realtime.php 触发实时轮询器，通过 popen() 执行被篡改的命令，从而实现任意命令执行。攻击者可借此获取服务器权限，进一步窃取网络设备凭证、篡改监控数据或作为跳板渗透内网。<span>目前该漏洞PoC和技术细节已公开。</span></span><span><span>Cacti 通常存储大量网络设备凭据与管理访问权限，一旦沦陷，攻击者可轻易横向移动、窃取敏感信息或破坏监控体系。当前无官方补丁，建议客户尽快做好自查及防护。</span></span></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>利用条件</span></span></strong></p><p><span><span>1.Guest 账户已启用（默认关闭，但部分场景为共享图表会开启）。</span></span></p><p><span><span>2.Web 接口可被攻击者访问（无需认证）。</span></span></p><p><span><span>3.数据库驱动（PDO）支持多语句执行。</span></span></p><p><strong><span>02</span></strong></p><p><strong><span>影响范围</span></strong></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>影响版本</span></span></strong></p><p><span>Cacti Core 1.2.31</span></p><p><span>（开启 Guest 账户且 Web 接口可被外部访问的 Cacti 实例）</span></p><p><span><span>*</span>早期 1.2.x 版本若共用相同 profile 与 realtime poller 代码路径，亦可能处于风险之中</span></p><p><strong><span>03</span></strong></p><p><strong><span>复现情况</span></strong></p><p><span><span>目前，</span><span>奇安信CERT已成功复现</span><span><span>Cacti 未授权远程代码执行漏洞(QVD-2026-117631)</span></span><span>，截图如下：</span></span></p><p><img src=\"/dailyinfo/media/049ca75a4b314e8e.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>04</span></strong></p><p><strong><span>受影响资产情况</span></strong></p><p><span><span>奇安信鹰图资产测绘平台数据显示，</span><span><span>Cacti 未授权远程代码执行漏洞(QVD-2026-117631)</span></span><span>关联的国内风险资产总数为2933个，关联IP总数为767个。国内风险资产分布情况如下：</span></span></p><p><img src=\"/dailyinfo/media/f549d10aade35909.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span><span>Cacti 未授权远程代码执行漏洞(QVD-2026-117631)</span></span><span>关联的全球风险资产总数为16725个，关联IP总数为5297个。全球风险资产分布情况如下：</span></span></p><p><img src=\"/dailyinfo/media/54ec372b9867be5e.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>05</span></strong></p><p><strong><span>处置建议</span></strong></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>安全更新</span></span></strong></p><p><span>目前官方尚未发布修复版本。请密切关注 Cacti 官方发布渠道，待补丁发布后立即升级至安全版本。在补丁可用前，必须禁用 Guest 账户（用户管理设置中关闭）。</span></p><p><span>官方地址：</span></p><p><span><a href=\"https://www.cacti.net/\">https://www.cacti.net/</a></span></p><p><span><span>临时缓解措施：</span></span></p><p><span>1.使用防火墙/WAF 限制访问来源，仅允许管理网段访问。</span></p><p><span>2.禁用 Guest 功能，强制所有访问需认证。</span></p><p><span>3.对 auth_profile.php、graph_view.php、graph_realtime.php 等关键接口增加异常行为检测。</span></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>产品解决方案</span></span></strong></p><p><strong><span><span><span>奇安信开源卫士已支持</span></span></span></strong></p><p><span><span>奇安信开源卫士20261127.1565 版本已支持对 Cacti 远程代码执行漏洞(QVD-2026-117631)的检测。</span></span></p><p><strong><span><span><span>奇安信网站应用安全云防护系统已更新防护特征库</span></span></span></strong></p><p><span><span>奇安信网神网站应用安全云防护系统已全局更新所有云端防护节点的防护规则，支持对Cacti 远程代码执行漏洞(QVD-2026-117631)的防护。</span></span></p><p><strong><span>06</span></strong></p><p><strong><span>参考资料</span></strong></p><p><span><span>[1]<a href=\"https://watchtowr.com/intelligence/4http2root-cacti-zero-day-faq/\">https://watchtowr.com/intelligence/4http2root-cacti-zero-day-faq/</a></span></span></p><p><span><span>[2]</span><span><a href=\"https://github.com/ekomsSavior/Sad-Girls-0day-Club/blob/main/4http2shell/README.md\">https://github.com/ekomsSavior/Sad-Girls-0day-Club/blob/main/4http2shell/README.md</a></span></span></p><p><strong><span>07</span></strong></p><p><strong><span>时间线</span></strong></p><p><span><span>2026年11月27日，奇安信 CERT发布安全风险通告。</span></span></p><p><strong><span>08</span></strong></p><p><strong><span>漏洞情报服务</span></strong></p><p><span><span>「</span><span>奇安信漏洞情报平台</span><span>」</span><span>重磅上线，诚邀您来体验：</span></span></p><p><img alt=\"图片\" src=\"/dailyinfo/media/35237963bfe00eee.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img alt=\"图片\" src=\"/dailyinfo/media/c79fa164257d5d8e.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img alt=\"图片\" title=\"CERT LOGO.png\" width=\"100%\" src=\"/dailyinfo/media/679bd1b92c3180e9.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><strong><span>奇安信 CERT</span></strong></span></p><p><span><strong><span><span>致力于</span></span></strong><span><span>第一时间为企业级用户提供</span><strong><span><span>权威</span></span></strong><span>漏洞情报和</span></span><strong><span><span>有效</span></span></strong><span><span>解决方案。</span></span></span></p><p><span><span>本文已发布于NCC国家网络安全云社区<a href=\"https://nccsec.cn/security-community\">https://nccsec.cn/security-community</a></span></span></p><p><span><span><span>点击↓</span><strong><span><span>阅读原文</span></span></strong><span>，到</span></span><strong><span><span>ALPHA威胁分析平台</span></span></strong><span><span>订阅更多漏洞信息。</span></span></span></p><p><a href=\"https://ti.qianxin.com/portal/subscription\">阅读原文</a></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=9cd8d2ee&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzU5NDgxODU1MQ%3D%3D%26mid%3D2247508295%26idx%3D1%26sn%3D7dd007931f4c6a435e8cec4ddc731116\">跳转微信打开</a></p>","original","zhKind","complete","漏洞","复现","漏洞利用","利用链","https://mp.weixin.qq.com/s?__biz=MzU5NDgxODU1MQ==&mid=2247508295&idx=1&sn=7dd007931f4c6a435e8cec4ddc731116","奇安信 CERT",{"_90":91,"_92":-5},"changelogVersion","2026-10-01T08:00","release"]
