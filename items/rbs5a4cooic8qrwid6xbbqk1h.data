[{"_1":2,"_3":4},"root",{"_5":103},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":37,"_59":60},"expiresAt",1794530491000,"id","rbs5a4cooic8qrwid6xbbqk1h","title","Zyxel GS1900 交换机补丁遗漏漏洞 CVE-2026-107441，10 个固件版本仍受影响","originalTitle","Zyxel Switch Patch Missed Flaw Behind Wave of Attacks","summary","Binarly 分析发现，Zyxel GS1900 交换机的 CVE-2026-107441 是 Web 管理程序中的越界写漏洞，Zyxel 评分为 8.8，Binarly 评分为 9.8；双方对利用前提存在分歧。","reason","分析揭示6月补丁未移除危险代码路径，并厘清此前针对996台交换机攻击所对应的漏洞编号与利用条件。","source",{"_73":102},"links",{"_93":101},"publishedAt","2026-11-05T15:15:00.000Z","discoveredAt","2026-11-05T23:04:20.317Z","timelineAt","category","vuln","tags",[97,74,98,99,100,79],"score",78,"selected",true,"channel","news","story",{"_81":82,"_13":83},"x","readingMode","full","author","body",{"_60":92,"_93":-5,"_94":95,"_96":37},"outline",[84,85],"relatedStories",[80],"topics",[67,68,69,70],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","f74bwNwtS8Nk","reportCount",3,"additionalSourceCount",2,{"_71":78,"_73":79},{"_71":76,"_73":77},{"_71":31,"_73":75},{"_71":72,"_73":74},"slug","exploited","name","在野利用","漏洞披露","supply-chain","供应链安全","cisa","CISA",{"_81":82,"_13":83},"publicId","604e73cf-d835-4e7e-821d-72ba31298114","Zyxel GS1900首个补丁失效",{"_11":90,"_87":91,"_89":66},{"_11":86,"_87":88,"_89":66},"sec-2","text","Zyxel 发布新固件之际，严重程度存在争议","level","sec-1","6 月的修复仍留下了存在漏洞的代码","<p>\n\t研究人员发现，Zyxel GS1900 交换机固件中的一个缺陷在 6 月安全更新后仍然存在，引发了人们对此次补丁是否真正修复了攻击中利用的漏洞的疑问。相关攻击涉及 48 个国家的 996 台交换机。</p><p>\n\t固件安全公司 Binarly 在 11 月 3 日发布的<a href=\"https://www.binarly.io/advisories/brly-2026-057\">研究</a>中详细介绍了这一发现，并将其与威胁情报公司 GreyNoise 于 9 月<a href=\"https://www.greynoise.io/blog/open-season-on-kapibala-attacker-steals-government-records-wordpress-exploitation\">描述</a>的一项利用活动关联起来。该漏洞现已被分配了新的标识符 CVE-2026-107441。这是交换机 Web 管理程序中的一个越界写入缺陷，可允许未经身份验证的攻击者以 root 权限运行操作系统（OS）命令。</p><p>\n\t这些攻击最初与 CVE-2026-7273 有关。Zyxel 已于 6 月 16 日修复该漏洞，并将其描述为同一程序中的基于栈的缓冲区溢出，评分为 8.8。9 月 21 日，GreyNoise 报告称，攻击者已利用该缺陷攻击 48 个国家的 996 台 Zyxel GS1900 交换机，获取了交换机配置、经过哈希处理的 root 凭据和网络信息。</p><p>\n\t美国网络安全和基础设施安全局（CISA）在同一天将 CVE-2026-7273 加入了已知被利用漏洞（KEV）目录。</p><p>\n\t<em><a href=\"https://www.infosecurity-magazine.com/news/critical-cisco-catalyst-sdwan/\">进一步了解网络设备零日漏洞：Cisco Catalyst SD-WAN 严重零日漏洞正遭积极利用</a></em></p><h2 id=\"sec-1\">\n\t6 月的修复仍留下了存在漏洞的代码</h2><p>\n\tBinarly 分析了一个经过混淆的 Python 利用程序，发现其与 GreyNoise 所描述的利用程序相符。9 月 28 日，研究人员确认，作为 6 月修复发布的全部 10 个固件版本仍然容易受到该漏洞攻击。</p><p>\n\tBinarly 表示，6 月的变更添加了一项检查，但该检查仅在不安全的复制操作已经发生后才运行。研究人员写道，该变更“并未解决此漏洞”。</p><p>\n\t该公司给出了两种解释。要么 6 月的补丁、其描述及其通用漏洞评分系统（CVSS）评分存在错误，要么攻击利用的是另一个缺陷，而 CISA 将其关联至 CVE-2026-7273 的链接是错误的。</p><p>\n\t无论哪种情况，Binarly 表示，所有 10 个宣称已修复该问题的版本都包含存在漏洞的代码。</p><h2 id=\"sec-2\">\n\tZyxel 发布新固件之际，严重程度存在争议</h2><p>\n\tZyxel 将 CVE-2026-107441 的评分定为 8.8，并称攻击者必须位于本地网络上才能利用该漏洞；Binarly 则将其评分定为 9.8，并表示利用该漏洞只需能够通过网络访问交换机的管理服务。</p><p>\n\tBinarly 表示已于 9 月 29 日通知 Zyxel。Zyxel 于 10 月 11 日确认该缺陷，10 月 22 日发布修复，并于 11 月 3 日发布安全公告。</p><p>\n\t该缺陷影响 10 款 GS1900 型号。例如，GS1900-8 的 2.90(AAHH.2)C0 及更早版本固件受到影响，而 2.90(AAHH.3)C0 已包含修复。</p><p>\n\tZyxel 建议用户安装更新，以“获得最佳保护”。<a href=\"https://www.zyxel.com/global/en/support/security-advisories/zyxel-security-advisory-for-out-of-bounds-write-vulnerability-in-gs1900-series-switches-11-03-2026\">其安全公告</a>将 6 月发布的版本列为受影响的版本，因此最后在 6 月更新的交换机仍需安装新固件。</p>","original","zhKind","translation","complete","漏洞","补丁","网络设备","供应链","https://www.infosecurity-magazine.com/news/zyxel-gs1900-patch-missed-flaw/","Infosecurity Magazine",{"_104":105,"_106":-5},"changelogVersion","2026-10-01T08:00","release"]
