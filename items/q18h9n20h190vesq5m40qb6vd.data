[{"_1":2,"_3":4},"root",{"_5":99},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795567287000,"id","q18h9n20h190vesq5m40qb6vd","title","GlobeTopper 遭黑客入侵，攻击者盗用 $70,000 礼品卡并造成约 $2.5 million 收入损失","originalTitle","GlobeTopper loses $2.5 million after hackers steal $70k in gift cards","summary","B2B 数字礼品卡分销商 GlobeTopper 遭网络攻击，母公司 iQSTEL 称攻击者盗取了部分客户 API 凭据与集成密钥并兑换价值 $70,000 的数字礼品卡，预计造成约 $2.5 million 收入损失。","reason","事件同时提供了攻击者得手的方式与受害方的处置节奏，API 凭据被窃取后如何轮换、下线与重建可直接供同类平台参考。","source",{"_73":98},"links",{"_89":97},"publishedAt","2026-11-23T16:50:01.000Z","discoveredAt","2026-11-23T17:25:31.521Z","timelineAt","category","activity","tags",[74,93,94,95,96],"score",70,"selected",true,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","Bill Toulas","body",{"_61":88,"_89":-5,"_90":91,"_92":37},"outline",[83],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fJBwatajsZKw","reportCount",2,"additionalSourceCount",1,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","attack","name","攻击活动","identity","身份与访问","cloud-native","云与原生",{"_80":81,"_13":82},"publicId","19fd9bf0-b265-469f-8243-9cba020ae16d","GlobeTopper 入侵致盗兑与收入损失",{"_11":84,"_85":86,"_87":65},"sec-1","text","发现您现有的防御措施可能遗漏的电子邮件威胁。","level","<p><img alt=\"GlobeTopper loses $2.5 million after hackers steal $70k in gift cards\" height=\"900\" src=\"/dailyinfo/media/c2da33e5f4ff3e3e.jpg\" srcset=\"/dailyinfo/media/bdf54fab81a20fb7.jpg 720w, /dailyinfo/media/9e6ad52f2baf8fbf.jpg 1200w, /dailyinfo/media/c2da33e5f4ff3e3e.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>一次网络攻击中断了 B2B 充值解决方案提供商 GlobeTopper 的运营，造成约 250 万美元的收入损失；攻击者还兑换了价值 70,000 美元的数字礼品卡。</p><p>母公司 iQSTEL 表示，这次入侵于 10 月 22 日被发现，GlobeTopper 随后暂停了平台并启动调查。</p><p>GlobeTopper 是一家面向企业的数字礼品卡分销商。多家零售商、金融科技应用和奖励平台使用其 API。据<a href=\"https://globetopper.com/\">该平台的网站</a>介绍，65 个国家的 4,000 多个品牌都在使用该平台，包括 IKEA、Adidas、Spotify、Target 和 Roblox。</p><p><a href=\"https://www.wiz.io/lp/claude-code-security-best-practices-cheat-sheet?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q3_INB_FORM_Claude-Code-Security-Best-Practices&amp;sfcid=701Vh00000gJQZuIAO&amp;utm_term=FY27Q4-bleepingcomputer-article-970x250-Nov&amp;utm_content=Claude-Code-Best-Practices\"><img src=\"/dailyinfo/media/d1878a942593a18c.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>iQSTEL 在向美国证券交易委员会（SEC）提交的备案文件中表示，GlobeTopper 在识别此次攻击的次日发现了更多未经授权的活动。作为回应，公司于 10 月 23 日凌晨“关闭了平台及所有受影响的服务器”，以调查并修复问题。</p><p>公司于 10 月 31 日在 AWS 上部署了完全重建的平台，并从 11 月 1 日开始分阶段恢复商业运营。</p><p>GlobeTopper 表示，攻击者获取了某些客户 API 凭据和集成密钥；这些凭据和密钥已被撤销并更换，目前尚未发现它们被未经授权地使用。</p><p>“在调查过程中，公司确定未经授权方获取了 GlobeTopper 部分企业客户的 API 凭据和集成密钥，”<a href=\"https://www.sec.gov/ix?doc=/Archives/edgar/data/1527702/000166357726000359/iqst8k112026.htm\">iQSTEL 表示</a>。</p><p>“所有受影响的凭据和集成密钥均已撤销并轮换，同时已向受影响的企业客户签发新凭据，并施加了额外的访问限制。”</p><p>公司进一步表示，调查仍在进行，以确定其他客户数据、个人数据、支付数据或提供商数据是否被访问或获取。</p><p>关于攻击者兑换的数字礼品卡，公司表示无法阻止、追回或收回这些礼品卡，并将承担相应损失。</p><p>iQSTEL 表示，此次事件影响了 GlobeTopper 第四季度的交易量和经营业绩，但截至提交备案文件时，公司尚未认定该事件具有重大影响。</p><p>BleepingComputer 已通过电子邮件向 iQSTEL 询问了有关该事件的更多问题，但公司拒绝分享进一步信息。</p><p>截至撰稿时，尚无勒索软件组织在其勒索门户上将 iQSTEL 或 GlobeTopper 列为受害者。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/05e456735a2a4381.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现您现有的防御措施可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体会分析电子邮件的意图、上下文和行为，以发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>对 Microsoft 365 或 Google Workspace 进行为期 14 天的只读扫描，看看哪些威胁能够突破防线，无需更改 MX 记录。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始您的免费电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","数据泄露","凭据","云原生","AWS","https://www.bleepingcomputer.com/news/security/globetopper-loses-25-million-after-hackers-steal-70k-in-gift-cards/","BleepingComputer",{"_100":101,"_102":-5},"changelogVersion","2026-10-01T08:00","release"]
