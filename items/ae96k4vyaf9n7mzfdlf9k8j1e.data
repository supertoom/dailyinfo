[{"_1":2,"_3":4},"root",{"_5":103},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794444091000,"id","ae96k4vyaf9n7mzfdlf9k8j1e","title","TeamViewer 远程支持漏洞 CVE-2026-111585 可在技术支持人员电脑上执行代码","originalTitle","TeamViewer Vulnerability Lets Attackers Run Code on IT Support Staff’s PCs","summary","TeamViewer 的屏幕解压组件存在 CVE-2026-111585，攻击者控制或攻陷被远程连接的设备后，可诱导技术支持人员接受连接，并在未打补丁的电脑上利用整数溢出与堆溢出执行攻击者代码。TeamViewer 于 2026 年 10 月 27 日发布 15.83 版本修复，该漏洞 CVSS 为 8.8、等级为 High；官方未发现已被在野利用的证据，并建议用户更新至最新版本。","reason","文章梳理了整数溢出导致堆溢出的完整利用链，并给出受影响版本、CVSS 评分与利用前提，便于技术团队评估远程支持终端风险。","source",{"_73":102},"links",{"_92":101},"publishedAt","2026-10-30T18:35:09.000Z","discoveredAt","2026-10-30T20:47:17.391Z","timelineAt","category","vuln","tags",[96,76,97,98,99,100],"score",75,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","Deeba Ahmed","body",{"_61":91,"_92":-5,"_93":94,"_95":37},"outline",[82,83],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fdTinyCqJKbY","reportCount",2,"additionalSourceCount",1,{"_71":31,"_73":77},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","research","name","技术研究","exploited","在野利用","漏洞披露",{"_79":80,"_13":81},"publicId","d375ea9f-18aa-419a-8bec-ac1c93d03d5d","TeamViewer修复远程控制反向漏洞",{"_11":89,"_85":90,"_87":88},{"_11":84,"_85":86,"_87":88},"sec-2","text","TeamViewer 发布安全更新","level",3,"sec-1","整数溢出如何产生","<p><strong><a href=\"https://hackread.com/tag/TeamViewer/\">TeamViewer</a></strong>中的一个漏洞可能允许攻击者在 IT 支持技术人员连接到攻击者控制的设备时，在该技术人员的计算机上运行代码。远程会话建立后，攻击无需进一步点击，也无需窃取技术人员的密码。</p><p>现已修补的漏洞影响了 TeamViewer，这是一款远程访问工具，企业帮助台通常使用它来排查员工设备的问题。</p><p>网络安全公司 Remedio 发现了该缺陷，并与 Hackread.com 分享了调查细节。据 Remedio 研究人员 Omri Dar 表示，在未修补的系统上，攻击只需技术人员接受传入连接即可生效。</p><h3 id=\"sec-1\"><strong>整数溢出如何产生</strong></h3><p>该漏洞的跟踪编号为 <a href=\"https://nvd.nist.gov/vuln/detail/cve-2026-111585\"><strong>CVE-2026-111585</strong></a>，目标是 TeamViewer 的屏幕解压组件。会话打开时，主机会将称为 DisplayParams 的屏幕尺寸传输给查看端。TeamViewer 在名为 CBitmapBuffer 的内存缓冲区中处理这些值，并在其中解压传入的屏幕更新。</p><p>问题在于 TeamViewer 计算处理传入屏幕图像所需内存的方式。缓冲区构造函数使用 32 位乘法计算所需内存，但攻击者只需发送异常大的屏幕尺寸，例如 32,768 x 32,768 像素，就可能使计算结果出错。</p><p>随后，TeamViewer 仅分配约 4 MB 的内存，却仍按照拥有完整尺寸所需空间的方式继续处理图像。解码器随后根据声明的屏幕尺寸而非实际分配的内存检查传入数据。这使解压后的像素数据能够覆盖相邻的堆内存，从而形成基于堆的<a href=\"https://hackread.com/microsoft-issues-net-fixes-brotli-linux-privilege-escalation/\"><strong>缓冲区溢出</strong></a>。</p><p>Remedio <strong><a href=\"https://remedio.io/research/vulnerability-disclosures/remote-code-execution-in-teamviewer/\">演示了</a></strong>如何利用这种内存破坏绕过数据执行保护（DEP）和控制流保护（CFG），将执行流重定向至 WinExec，并在技术人员的计算机上运行攻击者控制的代码。</p><video controls=\"\" playsinline=\"\" preload=\"none\">\n  <source src=\"https://remedio.io/wp-content/uploads/2026/10/TeamViewerPOC.mp4\" type=\"video/mp4\">\n  Your browser does not support embedded video.\n</video><p>TeamViewer 表示：“利用该漏洞需要用户与攻击者控制或已遭入侵的主机建立远程控制会话。”</p><h3 id=\"sec-2\"><strong>TeamViewer 发布安全更新</strong></h3><p>Remedio 于 2026 年 8 月 14 日将该缺陷通知了 TeamViewer 的产品安全团队。TeamViewer 于 10 月 22 日确认了此问题，将其编号指定为 CVE-2026-111585，CVSS 评分为 8.8（严重程度：高）。</p><p>修复程序于 10 月 27 日随 15.83 版本发布。TeamViewer 的安全公告还涵盖另外两个缺陷：<a href=\"https://nvd.nist.gov/vuln/detail/cve-2026-92372\"><strong>CVE-2026-92372</strong></a>，影响 Linux 和 macOS 上的屏幕图像解码；以及 <a href=\"https://www.cve.org/CVERecord?id=CVE-2026-92374\"><strong>CVE-2026-92374</strong></a>，可能允许本地攻击者获取 macOS 上的 root 权限。两者的 CVSS 评分分别为 8.8 和 7.8。</p><p>TeamViewer 表示，未发现这些缺陷在真实环境中被利用的证据，并建议用户更新至最新版本。</p><p>Hackread.com 此前曾报道过<a href=\"https://hackread.com/teamviewer-exploited-remote-access-ransomware/\"><strong>网络犯罪分子滥用 TeamViewer</strong></a>访问公司系统的攻击。然而，这次最新发现的漏洞有所不同，因为问题出在 TeamViewer 本身，使接受技术支持的计算机能够攻击技术人员的机器。</p>","original","zhKind","translation","complete","漏洞","补丁","复现","漏洞利用","漏洞分析","https://hackread.com/teamviewer-vulnerability-code-it-support-staff-pcs/","Hackread",{"_104":105,"_106":-5},"changelogVersion","2026-10-01T08:00","release"]
