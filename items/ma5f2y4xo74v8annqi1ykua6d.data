[{"_1":2,"_3":4},"root",{"_5":103},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794530488000,"id","ma5f2y4xo74v8annqi1ykua6d","title","研究人员利用 ForgeRock 默认口令接管两家车企账户并启动车辆","originalTitle","Default 'admin:admin' Server Password Helps Researchers Hack Two Automakers, Unlock and Start Cars","summary","研究人员发现两家车企移动应用共用的 ForgeRock 身份平台仍保留 admin:admin 默认口令，可经路径绕过访问管理员控制台并执行代码，进而修改任意客户账户凭据、解锁车门和启动发动机。","reason","文章拆解了默认口令与路径解析差异如何串联成车辆控制链，并给出同类部署可执行的检查项。","source",{"_74":102},"links",{"_93":101},"publishedAt","2026-11-09T11:27:53.000Z","discoveredAt","2026-11-09T12:04:17.988Z","timelineAt","category","disclosure","tags",[97,98,99,79,100],"score",77,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_61":92,"_93":-5,"_94":95,"_96":37},"outline",[86],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","faUKimJlQptE","reportCount",1,"additionalSourceCount",0,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","research","name","技术研究","vuln","漏洞披露","identity","身份与访问","iot","IoT 与车联网",{"_83":84,"_13":85},"publicId","a44c8fe5-cad8-4100-8799-5f46fab822b3","研究员披露两家车企身份系统接管",{"_11":87,"_88":89,"_90":91},"sec-1","text","Identity Teams 应当检查什么","level",3,"<p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiI85M0pHHPiXe5ar2VpaGsBVRzxoYfZhpQTKgWqd8YGjK9Nyaca-z6XrGT3jT0lqh41qe-cAjb33_r7JErd7rB1CfuWkgTP_z-_IJkpQPWebz1GeEvSu9QpE5XYWRMOfhYTHmzhbkFB07hzSuV1FYARdaIWjfB_mUoX1_eMjl_3dOaSUFpTQvjt-34eQo/s1600/login-car.jpg\"><img alt=\"\" src=\"/dailyinfo/media/254dd5f5a4e54040.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>两名安全研究人员发现，两家汽车品牌的移动应用背后的登录系统可能被完全接管，攻击者可以访问任何客户的账户；对于拥有联网汽车的车主，还可以解锁车门并启动发动机。</p><p>这两款应用都通过 <strong>ForgeRock</strong> 让客户登录。ForgeRock 是一个身份平台，现已归 <strong>Ping Identity</strong> 所有。研究人员在这些服务器上进入了一个仍使用默认密码的管理员控制台。</p><p>他们仅于 2026 年 2 月在美国对自己拥有及经车主同意的汽车进行了完整攻击测试，并在报告问题约两小时后，两个系统均已修复。</p><p>Shubham Shah 和 Sam Curry 于上周晚些时候发表了他们的研究。他们首先从应用入手：两个品牌都通过同一个平台让客户登录，该平台分为两部分：一部分负责登录，另一部分名为 <strong>OpenIDM</strong>，保存客户记录。</p><p>OpenIDM 自带一个由 Apache Felix 工具支持的内置管理员控制台。ForgeRock 自己的加固指南要求运维人员在正式上线前移除该控制台或对其加以保护，因为它单独保存自己的密码。在这些服务器上，该控制台仍然存在，并且仍使用文档中记载的默认凭据：用户名和密码都是 admin。</p><p>该控制台禁止从开放互联网访问，但保护该站点的边缘层与其背后的 Java 软件对同一个网址的解析方式不同。通过添加编码后的斜杠和额外字符，研究人员让边缘层将请求视为无害的静态文件，而服务器则将其视为通向控制台的路径，剩下的事情便由默认密码完成了。完整方法见他们的&nbsp;<a href=\"https://samcurry.net/forgerock\">技术分析</a>。</p><p>在控制台内部，研究人员利用内置调度器运行小型脚本，使其代码得以在身份服务器上执行。这让他们在保存两个品牌登录客户记录的机器上获得了一个命令提示符。</p><p>这些记录与控制台受到同一层封锁，但研究人员的代码从服务器内部访问到了这些记录。他们更改了目标账户的电子邮件地址和密码，通过普通应用以该客户身份登录，并获得了真实应用所使用的同一组访问令牌。</p><p>这些令牌就是控制汽车的钥匙。研究人员利用账户自身的车辆控制指令，解锁测试车辆的车门并启动发动机，当时车主就站在车旁；随后他们又停止发动机并重新锁车。</p><p>研究人员谨慎控制了他们所展示的内容。他们报告称，能够为受影响服务器上的任何客户账户开启会话，但仅对自己拥有或获准使用的车辆执行车辆控制指令。他们表示，他们“仅使用美国账户和车辆测试了完整攻击链”。</p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhgBPYL8MGaFonhebJnb6roJSAsehRQi6WeCNvwFHrpMwnUk9Wsjraz7YBqh4TATjaPN1t7bslpCRxLkrQ4N-iEdB8MlOGJpM2zJRCB8zkyQORvpfoLhDaky2dQ_hbxI1vWgg6e4vn7DMD8-WG4816RwJ9OxHBSEHzKpBkATB3zKgjLke81QGVsm0YS4-g/s1600/door.jpg\"><img alt=\"\" src=\"/dailyinfo/media/9c91b179907c0338.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>Shubham Shah 还发表了针对同一品牌在澳大利亚所用系统的第二种攻击。在那里，入侵方式有所不同：身份服务器的管理员凭据被留在了应用代码中，原本用于测试环境。他在另一篇文章中详述了完整的&nbsp;<a href=\"https://shubs.io/unlocking-any-car-from-x-brand-in-most-of-the-world/\">澳大利亚攻击链</a>。</p><p>研究人员表示，结合这两种攻击，他们可以向这些品牌在澳大利亚、美国和加拿大的汽车发送解锁及启动发动机指令。第二篇文章没有说明澳大利亚系统何时得到修复。</p><p>这次攻击几乎没给账户所有者留下任何可察觉的迹象。更改电子邮件地址和密码并未将所有者从其应用中登出，而研究人员可以将该账户的警报重定向到自己的手机，从而避开所有者的手机通知。</p><p>测试结束后，研究人员恢复了真实的电子邮件地址。两篇报告均未说明在该路径被关闭之前，是否有其他人发现或利用过该路径。</p><h3 id=\"sec-1\">Identity Teams 应当检查什么</h3><p>这些品牌的错误在于其运行 ForgeRock 的方式，而非产品本身出现了新漏洞，因此没有 CVE（用于追踪漏洞的公开编号），也没有可供遵循的厂商公告。该控制台及其默认密码多年来已有文档说明，厂商的&nbsp;<a href=\"https://docs.pingidentity.com/pingidm/7.2/security-guide/security-remove-dev-tools.html\">生产环境加固</a>&nbsp;指南早已告知运维人员，应在正式上线前移除该控制台或更改其密码。</p><p>对于运行同一身份软件的团队（该软件现以 PingIDM 名义销售），有两项检查尤为重要：</p><ul>\n  <li>检查&nbsp;/system/console&nbsp;路径下是否存在 Apache Felix 控制台，并将其移除或更改默认密码。</li>\n  <li>不要依赖边缘层或 WAF 路径规则来隐藏管理页面。如果边缘层与服务器对路径的解析方式不同，请求就可能绕过规则，正如本次攻击一样。</li>\n</ul><p>这两名研究人员长期从事此类工作，通常入侵的是应用背后的 Web 系统，而非汽车本身。他们曾展示过对 Honda、Kia 和 Subaru 等品牌车辆的远程访问。</p><p>他们报告的一个&nbsp;<a href=\"https://thehackernews.com/2025/02/thn-weekly-recap-top-cybersecurity.html\">Subaru 漏洞</a>&nbsp;通过该汽车制造商的联网汽车服务暴露了车主账户及其车辆；而 2023 年开展的更广泛的&nbsp;<a href=\"https://thehackernews.com/2023/01/millions-of-vehicles-at-risk-api.html\">16 个品牌研究</a>&nbsp;发现，整个行业中大量系统存在同类 Web 漏洞。</p><p>觉得这篇文章有意思吗？在 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a> 上关注我们，查看我们发布的更多独家内容。</p>","original","zhKind","translation","complete","漏洞分析","复现","车联网","凭据","https://thehackernews.com/2026/11/default-adminadmin-server-password.html","The Hacker News",{"_104":105,"_106":-5},"changelogVersion","2026-10-01T08:00","release"]
