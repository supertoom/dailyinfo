[{"_1":2,"_3":4},"root",{"_5":92},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795567289000,"id","t01g4rr0zdui8pml85k6pxuh5","title","Turnitin 披露针对客户面向系统的未授权活动","originalTitle","Turnitin discloses cyberattack affecting customer-facing systems","summary","教育科技公司 Turnitin 披露部分客户面向系统出现未授权活动，已启动事件响应计划并邀请外部网络安全专家参与调查，同时通知执法机构和网络监管机构。Turnitin 表示系统目前正常运行，受影响系统不收集政府身份凭据或机构财务信息；调查仍在进行，尚未披露活动性质与范围，也未确认用户数据是否被访问或窃取、事件发生时间及潜在受影响人数。","reason","source",{"_72":91},"links",{"_61":90},"publishedAt","2026-11-24T18:59:52.000Z","discoveredAt","2026-11-24T19:25:33.173Z","timelineAt","category","activity","tags",[73,75],"score",54,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","readingMode","full","author","Bill Toulas","body",{"_86":-5,"_61":87,"_88":-5,"_89":36},"outline",[80],"relatedStories",[76],"topics",[68,69],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","f_s4c3cXWNOE","reportCount",1,"additionalSourceCount",0,{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","attack","name","攻击活动","incident","应急响应",{"_77":78,"_13":79},"publicId","413fc957-3709-4bb7-a325-3e7492069a0b","Turnitin披露客户系统遭未授权活动",{"_11":81,"_82":83,"_84":85},"sec-1","text","Uncover email threats your existing defenses may miss.","level",2,"zh","<p><img alt=\"Turnitin discloses cyberattack affecting customer-facing systems\" height=\"900\" src=\"/dailyinfo/media/8ecc1b79a8e447ae.jpg\" srcset=\"/dailyinfo/media/820a1dd6c4b56dd5.jpg 720w, /dailyinfo/media/f7e304eb0fea1984.jpg 1200w, /dailyinfo/media/8ecc1b79a8e447ae.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>Educational technology company Turnitin disclosed that it detected unauthorized activity involving certain customer-facing systems and deployed its incident response plan.</p><p>In a public statement, CEO Chris Caren says that the incident is being investigated with help from external cybersecurity specialists, and law enforcement and cyber regulators have been notified.</p><p>Turnitin is a major education technology firm with a global presence, best known for its AI-generated writing detection, digital grading, academic research integrity checks, and examination proctoring.</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/1e655ab2acf27a1c.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>According to its website, its software is <a href=\"https://in.turnitin.com/newsroom/media-kit/\">used in over 16,000 institutions</a> across 185 countries and serves 71 million students.</p><p>“We are writing to let you know that we recently identified unauthorized activity involving certain customer-facing Turnitin systems,” reads the <a href=\"https://helpcenter.turnitin.com/hc/en-us/articles/50603173309197-Letter-from-Turnitin-CEO-Chris-Caren-to-customers-on-23-November-2026\">letter from the CEO</a> on the platform's website.</p><p>“Upon identifying the matter, we implemented our incident response plan, initiated an investigation with external cybersecurity specialists, and notified law enforcement and cyber regulators.”</p><p>Turnitin says its systems are fully operational and safe to use, noting that the affected systems do not collect government identification credentials or institutional financial information.</p><p>The company said its investigation into the incident remains ongoing and has not disclosed any details about the nature and scope of the unauthorized activity.</p><p>If you have any information regarding this incident or other undisclosed attacks, you can contact us confidentially via Signal at 646-961-3731 or at tips@bleepingcomputer.com.</p><p>Turnitin continues to monitor its systems for further unauthorized activity, indicating that it is still early to guarantee that the threat has been eliminated completely.</p><p>The company has not disclosed whether any user data was accessed or stolen, when the incident occurred, and how many individuals might have been impacted.</p><p>Regarding Turnitin service availability, the platform’s <a href=\"https://turnitin.statuspage.io/history\">status page</a> shows no incidents for November 2026, and the uptime history logs no disruptions. However, it's unclear whether it is safe to continue using the service and uploading sensitive data.</p><p>As of writing, no ransomware groups have publicly taken responsibility for the attack at Turnitin.</p><p>BleepingComputer has contacted the firm with questions about the incident, but a company representative said they have no additional details to share at this time.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/05e456735a2a4381.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Uncover email threats your existing defenses may miss.</a>\n        </h2><p>Adaptive Security's AI agents analyze email intent, context, and behavior to uncover phishing, business email compromise, and invoice fraud.</p><p>See what's getting through with a 14-day read-only scan of Microsoft 365 or Google Workspace, with no MX changes.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Start your free email security scan.</a>\n    </p>","zhKind","complete","https://www.bleepingcomputer.com/news/security/turnitin-discloses-cyberattack-affecting-customer-facing-systems/","BleepingComputer",{"_93":94,"_95":-5},"changelogVersion","2026-10-01T08:00","release"]
