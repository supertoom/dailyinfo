[{"_1":2,"_3":4},"root",{"_5":111},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1793666561000,"id","h95qmripejf5n3wijd12czd7y","title","Vapor Panda 使用 ARTEX AI 攻击 14 国 200 多家组织","originalTitle","Chinese hackers use ARTEX AI in automated attacks against 200 orgs","summary","CrowdStrike 披露，中国关联威胁组织 Vapor Panda 使用开源多代理渗透测试框架 ARTEX AI，自 10 月 17 日起攻击 14 个国家 200 多家组织，至少入侵 9 家机构，并对另外 12 个高价值目标实施密码喷洒和凭据扫描。","reason","source",{"_76":110},"links",{"_100":109},"publishedAt","2026-11-02T21:40:14.000Z","discoveredAt","2026-11-02T22:07:33.526Z","timelineAt","category","activity","tags",[79,81,106,107,108,85],"score",76,"selected",true,"channel","news","story",{"_87":88,"_13":89},"x","sameEvent",{"_11":104,"_13":105},"readingMode","full","author","Bill Toulas","body",{"_62":99,"_100":-5,"_101":102,"_103":36},"outline",[90,91],"relatedStories",[86],"topics",[69,70,71,72,73],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","fC7d1r-YSORo","reportCount",2,"additionalSourceCount",1,{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","malware","name","恶意软件","attack","攻击活动","ai-offense","AI 攻防","identity","身份与访问","crowdstrike","CrowdStrike",{"_87":88,"_13":89},"publicId","e1edd2ba-3f40-4411-96cf-369515fb5b99","VAPOR PANDA借AI入侵200余机构",{"_11":96,"_93":97,"_95":98},{"_11":92,"_93":94,"_95":66},"sec-2","text","发现现有防御可能遗漏的邮件威胁。","level","sec-1","更多 ARTEX AI 案例浮现",3,"<p><img alt=\"Chinese hackers use ARTEX AI in automated attacks against 200 orgs\" height=\"900\" src=\"/dailyinfo/media/1126431778fc8b31.jpg\" srcset=\"/dailyinfo/media/beec348c5a25d8a5.jpg 720w, /dailyinfo/media/1b293be1a7a244ab.jpg 1200w, /dailyinfo/media/1126431778fc8b31.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>中国黑客使用了开源多智能体 AI 渗透测试框架 ARTEX，针对 14 个国家 200 多个组织发动攻击。</p><p>此次行动始于 10 月 17 日，目标包括政府部委、电信提供商，以及制药、半导体、国防、核能和金融行业的组织。</p><p>该威胁行为者入侵了至少 9 个组织，并对另外至少 12 个高价值目标实施了密码喷洒攻击和凭据扫描活动。</p><p><a href=\"https://www.wiz.io/lp/ai-security-starter-pack?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Security-Starter-Kit&amp;sfcid=701Vh00000cn7aRIAQ&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AI-Security-Bundle\"><img src=\"/dailyinfo/media/0d7fcec43838a1e8.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>据 CrowdStrike 的研究人员称，“这次行动标志着与中国的关联组织对 AI 智能体的使用有所升级，从单次入侵发展到由人类操作员指挥的多次同时入侵活动。”</p><p>已确认的受害者包括美国和比利时的电信提供商、希腊、中东和拉丁美洲的政府组织，以及美国的制药企业。</p><p>研究人员追踪该威胁行为者的活动并将其称为 Vapor Panda，称在针对希腊政府实体的攻击中，AI 智能体伪造了管理员令牌，并利用 2022 年邮件服务器目录导出数据中的认证密钥读取了邮箱。</p><p>ARTEX AI 是一套由中国开发者开发的渗透测试套件，最初作为开源项目发布。然而，在其被用于现实世界的攻击（包括<a href=\"https://www.bleepingcomputer.com/news/security/hacker-used-artex-ai-and-claude-agents-to-target-south-korean-banks/\">针对韩国金融机构的攻击活动</a>）后，其创建者后来将其转为专有软件。</p><p>在其最近一次网络间谍活动中，Vapor Panda 还使用了 DeepSeek 和第二种尚未确认身份的商业语言模型，以协调多个入侵活动中的规划智能体和工作智能体同时运行。</p><p><a href=\"https://www.crowdstrike.com/en-us/blog/vapor-panda-uses-artex-to-scale-global-campaign/\">CrowdStrike 表示</a>，攻击者以中文发出指令，并在需要作出决策的关键节点进行干预。</p><p>这些 AI 智能体开展侦察、利用漏洞、部署 Web shell、获取凭据，并在必要时寻求替代攻击路径。</p><p>操作人员明确指示智能体跳过受 Falcon（CrowdStrike 的端点保护解决方案）保护的 Windows 机器，并将重点放在未受保护的主机上。</p><p>研究人员认为，在一次入侵中，这些 AI 智能体消耗了超过 14 亿个输入令牌。</p><p>CrowdStrike 还发现，该威胁行为者对拉丁美洲和中东的政府实体部署了自 2023 年以来一直活跃的后门 BLOODALCHEMY。</p><h3 id=\"sec-1\">更多 ARTEX AI 案例浮现</h3><p>荷兰漏洞披露研究所（DIVD）公布了更多关于其在 2026 年 9 月<a href=\"https://www.bleepingcomputer.com/news/security/automated-ai-agent-used-to-breach-cybersecurity-nonprofit-divd/\">遭受网络攻击</a>的细节，并将该攻击归因于一个 AI 智能体。</p><p>据其最新更新，攻击其网络所使用的工具是能够自主行动的 ARTEX AI。</p><p>DIVD <a href=\"https://www.linkedin.com/posts/divd-nl_let-us-introduce-you-to-artex-now-that-our-activity-7521918922900754436-FSF-\">在一篇 LinkedIn 帖子中解释道</a>，这次攻击从初始访问到获取 root 权限仅用了 12 分钟，攻击链串联了<a href=\"https://www.bleepingcomputer.com/news/security/divd-says-zammad-zero-days-enabled-ai-driven-network-breach/\">Zammad 零日漏洞</a>与第二个用于本地权限提升的零日漏洞。</p><p>该智能体同时执行了多项任务，包括读取已被入侵的邮箱、扫描内部网络、提取登录令牌以及尝试重置密码。</p><p>DIVD 记录到超过 450,000 个请求和 2,500 个与此次攻击相连的脚本，并将这些活动描述为“极其喧闹且杂乱无章”。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/3e0af1aa7fd35e6a.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-2\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体会分析邮件意图、上下文和行为，以发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>通过为期 14 天的只读扫描查看 Microsoft 365 或 Google Workspace 中有哪些邮件得以通过，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始免费的电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","m8vt0mfprflyha4qd0f1jbnwd","VAPOR PANDA 使用 ARTEX 与 DeepSeek 并行入侵全球 200 多家组织","Agent 安全","后门","凭据","https://www.bleepingcomputer.com/news/security/chinese-hackers-use-artex-ai-in-automated-attacks-against-200-orgs/","BleepingComputer",{"_112":113,"_114":-5},"changelogVersion","2026-10-01T08:00","release"]
