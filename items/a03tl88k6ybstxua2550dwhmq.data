[{"_1":2,"_3":4},"root",{"_5":103},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795912833000,"id","a03tl88k6ybstxua2550dwhmq","title","Danfoss AK-SM800A 制冷控制器曝出 6 个未修复漏洞，可绕过登录远程接管","originalTitle","Six Unpatched Danfoss Refrigeration Controller Flaws Could Allow Remote Takeover Without Login","summary","Midnight Blue 在 Danfoss AK-SM800A 制冷控制器中发现 6 个未修复漏洞，最新版固件 5.4.0 也未修复，所有不高于 5.3.2 的版本均受影响且尚未分配 CVE。","reason","文章披露了远程接管所需的请求处理与 Strict mode 网关缺陷，并给出失陷后驻留和篡改设备的具体条件。","source",{"_74":102},"links",{"_92":101},"publishedAt","2026-11-16T12:34:21.000Z","discoveredAt","2026-11-16T13:42:15.507Z","timelineAt","category","vuln","tags",[96,97,98,99,100],"score",76,"selected",true,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_61":91,"_92":-5,"_93":94,"_95":37},"outline",[85],"relatedStories",[81],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fZ2UzOTGZ5x4","reportCount",2,"additionalSourceCount",1,{"_72":79,"_74":80},{"_72":77,"_74":78},{"_72":31,"_74":76},{"_72":73,"_74":75},"slug","research","name","技术研究","漏洞披露","industrial","工业控制","iot","IoT 与车联网",{"_82":83,"_13":84},"publicId","0daa277f-074f-4ee3-ab79-11ed6de2abb4","Danfoss制冷控制器六个零日漏洞未修补",{"_11":86,"_87":88,"_89":90},"sec-1","text","运营商可以采取的措施","level",3,"<p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEj_1GngZ38pRRizZTrhUgdWx49U1Dk8N_Y1Wkfll2kXIjAeYMmX2R69d6OBvA9k-zb6rnYbNOZyouN9yj59QIlT8XxiTzmmhLTmwmEdU2bqiGc_XoSMlvKKN1qZtH3o73YN1miGEhR4vkDniji2WkWOHjSPPIn69ysWKPkFzr504FsViG2NQYxPDkD7sgw/s1600/flaws.jpg\"><img alt=\"\" src=\"/dailyinfo/media/956c73498a243bf8.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>荷兰安全咨询公司 Midnight Blue 本周早些时候表示，<strong>Danfoss AK-SM800A </strong>制冷控制器中的六个缺陷可能允许远程攻击者在无需登录的情况下接管控制器。</p><p>目前尚无补丁，研究人员称最新固件版本 5.4.0 并未修复这些缺陷。</p><p>比利时、爱尔兰和德国的政府网络安全机构本周告知运营方，应将控制器的管理接口从互联网上移除。</p><p>比利时和爱尔兰机构表示，对于仍连接到互联网的控制器，仅更新固件、更改默认密码或启用严格模式并不足够。严格模式是一种登录保护机制，要求使用加密连接和会话令牌，但这六个缺陷之一存在于负责执行严格模式的网关中。</p><p>AK-SM800A 用于运行商店的冷藏柜和冷冻柜，维护公司可以对其进行远程管理。自 10 月 11 日起，此类控制器成为<a href=\"https://thehackernews.com/2026/10/attackers-heat-french-supermarket.html\">法国攻击</a>的目标；上周开始的<a href=\"https://thehackernews.com/2026/11/second-wave-of-cyberattacks-hits.html\">第二波攻击</a>波及欧洲多地。攻击导致非预期的除霜循环并损毁库存。</p><p>德国联邦信息安全局 BSI 在一份<a href=\"https://www.bsi.bund.de/SharedDocs/Cybersicherheitswarnungen/DE/2026/2026-306525-1032.pdf?__blob=publicationFile&amp;v=2\">安全公告</a>中表示，AK-SM800A 曾涉及此前发生的多起事件 wherein 多个国家的制冷设备遭到篡改。</p><p>该机构没有关于这六个新缺陷被利用的任何信息，其他机构和研究人员也未将这些缺陷与那些事件联系起来。</p><p>研究人员检查了当时最新的固件版本 5.3.2，并表示包括该版本在内的所有版本都受到影响。</p><p>目前尚未分配 CVE 编号。研究人员在与制造这些控制器的丹麦公司 Danfoss 开展披露工作的同时，对技术细节保密。</p><p>供应商将日期标注为 11 月的软件包 5.4.0 列为 AK-SM800A 的最新版本。其 <a href=\"https://www.danfoss.com/en/service-and-support/downloads/dcs/adap-kool-software/ak-sm-800a/license-agreement/\">5.4.0 readme</a> 和 11 月升级指南包含升级步骤，该指南还增加了更严格的密码规则。两者均未提及修复任何漏洞。</p><p>在行业出版物 Cooling Post 刊载的<a href=\"https://www.coolingpost.com/world-news/belgium-warns-of-new-danfoss-controller-vulnerabilities/\">后续声明</a>中，研究人员表示 5.4.0 不会修补这些缺陷：“实际上也不可能，因为根据文件时间戳，此固件很可能构建于 10 月 29 日，即第二波网络攻击之前，也远早于我们的漏洞报告。”</p><p>德国机构本周首先在一份新闻稿中表示 5.4.0 不受影响。当天稍后，该机构在一份<a href=\"https://www.bsi.bund.de/DE/Service-Navi/Presse/Pressemitteilungen/Presse2026/261113_Kuehlgeraete-Danfoss.html\">更正声明</a>中修改了这一说法：目前尚不能排除 5.4.0 受影响的可能性。</p><p>截至今日，供应商的<a href=\"https://www.danfoss.com/en/service-and-support/coordinated-vulnerability-disclosure/danfoss-security-advisories/\">公告页面</a>未列出针对这六个缺陷的任何公告，也未公布修复日期。</p><p>Midnight Blue 研究人员 Carlo Meijer 使用供应商提供的可下载固件，通过不到一小时的人工审查发现了这六个缺陷，并在一份<a href=\"https://www.midnightblue.nl/blog/multiple-rce-danfoss-aksm800a\">技术文章</a>中对其进行了描述。</p><p>其中五个缺陷存在于无需登录即可访问的 Web 请求处理程序中，这些处理程序位于一个以 root 身份运行的程序内。研究人员利用其中一个缺陷在较旧的固件版本 3.3.0 上以 root 身份运行了代码，并在 5.3.2 中发现了相同的漏洞。</p><p>严格模式几乎会对所有未登录用户关闭控制器的 Web 攻击面，包括上述演示中利用的缺陷。第六个缺陷存在于负责执行严格模式的网关中；这是一个独立的程序，在用户登录前会阻止除登录请求之外的所有请求。</p><p>研究人员在一台启用了 Strict 模式的模拟器中运行固件 5.3.2 时，该漏洞导致网关崩溃。研究人员表示，经过更多工作可以将该崩溃转化为代码执行，而且该网关缺少栈金丝雀等基本漏洞利用防御机制。</p><p>攻击者如果能以 root 身份运行代码，就可以更改控制器的设置、启动除霜周期，并向日志隐藏这些活动。</p><p>研究人员发现，这些控制器不使用安全启动，因此攻击者可以植入在恢复出厂设置和更新固件后依然存在的代码。攻击者还可以使控制器无法使用，直至将其更换。</p><p>研究人员表示，这段代码几乎肯定还存在更多类似漏洞，并称逐个修补漏洞或启用 Strict 模式是“对稀缺安全与人员资源的错误配置”。</p><h3 id=\"sec-1\">运营商可以采取的措施</h3><p>比利时网络安全中心表示，移除互联网暴露不能等待补丁发布，即使使用的是最新固件并启用了 Strict 模式，也需要采取这一措施。</p><p><a href=\"https://ccb.belgium.be/advisories/warning-six-new-danfoss-vulnerabilities-refrigeration-controllers-risk-immediate-action\">比利时公告</a>和类似的<a href=\"https://www.ncsc.gov.ie/pdfs/2611130306_New_Vulnerabilities_in_Refrigeration_Controllers.pdf\">爱尔兰公告</a>建议采取以下步骤：</p><ul>\n  <li>找出所有可从互联网访问其管理接口的控制器，包括通过 4G 或 5G 调制解调器访问的情况，并消除这些暴露。</li>\n  <li>仅通过安全 VPN 或受保护的内部网络提供远程访问。只允许通过防火墙访问某服务公司的 IP 地址是一种短期措施。</li>\n  <li>检查温度设定点、除霜计划、报警设置、用户账户和远程访问设置中是否存在并非由你实施的更改。</li>\n</ul><p>德国机构补充称，任何怀疑系统已遭入侵的人都应更改所有凭据，并检查连接到控制器的设备是否正常运行。</p><p>比利时公告称，在切断控制器向其制冷服务公司发送的数据之前，运营商应检查合同和保险条款。他们还应建立受保护的远程访问，以便继续进行监控。</p><p>Danfoss 自己的<a href=\"https://assets.danfoss.com/documents/latest/615405/BC576633631268en-000105.pdf\">更新指南</a>指出，AK-SM800A 不应可从公共互联网直接访问，并补充道：“此建议适用于所有软件版本，包括启用了 Strict Mode 的版本。”</p><p>爱尔兰国家网络安全中心也建议运行最新的受支持固件、更改默认密码并启用 Strict 模式，但表示运营商不应仅依赖这些措施。</p><p>Danfoss 于 10 月 12 日告诉 Cooling Post，在法国遭攻击的大多数设备，要么是已不再接收更新的旧型号，要么是运行过时固件的当前 AK-SM800A 设备。</p><p>该供应商曾于 2023 年和 2025 年修复 AK-SM800A 中的<a href=\"https://thehackernews.com/2026/08/threatsday-gogs-100-rce-n8n-workflow-to.html\">早期漏洞</a>，其中包括登录绕过和命令注入漏洞。研究人员检查的版本 5.3.2 晚于所有这些修复。</p><p>觉得这篇文章有趣吗？在 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a> 上关注我们，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","漏洞","复现","IoT","工控","漏洞分析","https://thehackernews.com/2026/11/six-unpatched-danfoss-refrigeration.html","The Hacker News",{"_104":105,"_106":-5},"changelogVersion","2026-10-01T08:00","release"]
