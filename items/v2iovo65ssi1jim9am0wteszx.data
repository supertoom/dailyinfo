[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794616834000,"id","v2iovo65ssi1jim9am0wteszx","title","NLTK TreebankWordTokenizer.span_tokenize 二次方 CPU 消耗漏洞公告撤回（重复于 GHSA-ffr9-mgrr-wcvr）","originalTitle","Duplicate Advisory: Quadratic CPU exhaustion in TreebankWordTokenizer.span_tokenize via list.pop(0) in quote-restore loop","summary","NLTK 3.2.5 至 3.10.4 之前的 TreebankWordTokenizer.span_tokenize 存在算法复杂度漏洞，远程攻击者可通过连续双引号触发 list.pop(0)，造成二次方 CPU 消耗并降低服务可用性。该公告因与 GHSA-ffr9-mgrr-wcvr 重复而被撤回，链接仅为保留外部引用。","reason","source",{"_68":77},"links",{"_59":76},"publishedAt","2026-11-13T12:31:17.000Z","discoveredAt","2026-11-13T21:08:25.188Z","timelineAt","category","vuln","tags",[74,75],"score",39,"selected",false,"channel","news","story",{"_71":72,"_13":73},"x","readingMode","full","author","body","outline",[],"relatedStories",[70],"topics",[66],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fSmZE7qtc6gE","reportCount",1,"additionalSourceCount",0,{"_67":30,"_68":69},"slug","name","漏洞披露",{"_71":72,"_13":73},"publicId","2fa0faee-2518-4fdd-b40e-dc4ea28c079b","NLTK分词漏洞重复公告撤回，仍无补丁","漏洞","其他","https://github.com/advisories/GHSA-rg32-vgf9-927c","GitHub 安全公告",{"_79":80,"_81":-5},"changelogVersion","2026-10-01T08:00","release"]
