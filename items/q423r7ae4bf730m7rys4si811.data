[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1795653645000,"id","q423r7ae4bf730m7rys4si811","title","研究员披露 PostgreSQL、MySQL、Oracle 与 ClickHouse 数据库 RCE 利用链","originalTitle","Researcher Demonstrates Database RCE Exploits Affecting PostgreSQL, MySQL and Oracle","summary","Depthfirst 研究员 Zheng Yu 展示了 PostgreSQL、MySQL、ClickHouse 低权限数据库账户触发引擎内存缺陷的 PoC，以及 Oracle 无需登录的组合利用链。","reason","文章拆解了 PostgreSQL、MySQL、Oracle 与 ClickHouse 的内存破坏利用路径，并列出受影响版本、修复状态及最小权限条件。","source",{"_65":82},"links",{"_72":81},"publishedAt","2026-11-19T08:14:00.000Z","discoveredAt","2026-11-19T09:50:04.583Z","timelineAt","category","disclosure","tags",[66,76,77,78,79,80],"score",81,"selected",true,"channel","news","story","x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_59":71,"_72":-5,"_73":74,"_75":37},"outline",[],"relatedStories",[],"topics",[60,61,62],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_63":69,"_65":70},{"_63":67,"_65":68},{"_63":64,"_65":66},"slug","research","name","技术研究","vuln","漏洞披露","oracle","Oracle / 甲骨文","<p><span><i></i><span>Swati Khandelwal</span><i></i><span>2026年11月19日</span></span><span>漏洞 / 数据库安全</span></p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgDE1pOkFxdtUcDqLptfhjaBnnEyzz2JfxUJICSOrW3vpcNlygN1XleKCdkv9CA3Zp901yQ884tOkPX9TmSYx5tpevenJw1CmW4oktkn2creXnB5-dvbiJB3crcILx4Kb8b6eVhiKjh-RRZTGnvWskqROJOjF3yaWFVK17fmh-tdT7WMas7MbdK-JsCBmw/s1600/database-rce.jpg\"><img alt=\"\" src=\"/dailyinfo/media/b9dc94214625895a.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>研究人员证明，即使是无法读取任何应用程序表的低权限数据库账户，也可被用于在数据库服务器本身上运行代码，方法是利用普通 SQL 背后的引擎代码中的内存破坏漏洞。</p><p>这些漏洞利用程序于昨天发布，是研究人员针对 PostgreSQL、MySQL 和 ClickHouse 的概念验证，此外还有一条无需登录的独立 Oracle 攻击链。目前尚未发现它们被用于真实攻击。</p><p>这项工作由 <strong>Depthfirst</strong> 的研究人员 <strong>Zheng Yu</strong> 完成。该研究人员指出，数据库账户的 SQL 权限决定其可访问哪些表和模式，而不是限制引擎为读取、规划和执行查询而运行的、不具备内存安全性的 C 和 C++ 代码。</p><p>常见权限授予足以让账户接触到这些代码。PostgreSQL 默认的 TEMPORARY 权限，或在 MySQL 和 ClickHouse 中创建临时表的权限，允许账户创建对象或发送可触发内存漏洞的输入。</p><p>其中四个漏洞现已获得厂商分配的 CVE 和修复，但完整攻击链未经独立复现，研究也未报告任何迹象表明它们已被用于攻击。</p><p>在 PostgreSQL 中，漏洞 CVE-2026-116331 允许能够创建数据库对象的账户，以运行数据库的操作系统用户身份执行代码。</p><p>该漏洞上周已在一份<a href=\"https://www.postgresql.org/support/security/CVE-2026-116331/\">安全公告</a>中修复，CVE 记录也注明研究人员报告了该问题。研究人员的<a href=\"https://depthfirst.com/research/narrow-grants-wide-engines\">技术分析</a>展示了如何使用普通登录角色在自身的临时模式中构建所需对象，在不接触应用程序数据的情况下，将类型混淆漏洞转化为对服务器的控制。</p><p>MySQL 的查询优化器中存在一个类似漏洞 CVE-2026-101786，影响 Server 和 Cluster 版本 26.7.0 至 26.7.1。Oracle 的 MySQL <a href=\"https://dev.mysql.com/community/security/advisories/2026-10-20/\">10 月公告</a>将其评为需要高权限。</p><p>研究人员使用一个只能创建临时表、无法读取现有表的账户，在 26.7.0 镜像上实现了代码执行；这种访问权限比该评级所暗示的更为受限。</p><p>研究人员表示，Oracle Database 是唯一一种攻击者完全不需要账户的情况。Oracle Text 中的一个漏洞与 Oracle REST Data Services 的 GraphQL 接口中的一个漏洞，可针对暴露的 Web 端点组合利用，进而接触引擎代码，并在任何登录操作之前运行命令。</p><p>Oracle 已于本周早些时候在<a href=\"https://www.oracle.com/security-alerts/cspunov2026.html\">11 月更新</a>中修复了评分为 9.9 的 Oracle Text 漏洞 CVE-2026-114819，并在<a href=\"https://www.oracle.com/security-alerts/cpuoct2026.html\">10 月更新</a>中修复了 GraphQL 漏洞 CVE-2026-91609。单独来看，该公司将这两个漏洞均评为在没有登录的情况下无法利用。</p><p>ClickHouse 是第四个目标。研究人员报告称，其读取二进制行格式的方式中存在整数溢出写入漏洞；用户只需将单个选项 format_binary_max_string_size 设置为零即可触发。该研究人员在版本 26.7.5.10 上成功获取了 shell。</p><p>此漏洞尚无 CVE，也没有已确认的修复版本，因此运维人员应向厂商确认修复情况。</p><table>\n  <tbody>\n      <tr>\n      <th>软件</th>\n      <th>标识符</th>\n      <th>受影响版本</th>\n      <th>修复</th>\n    </tr>\n    <tr>\n      <th>PostgreSQL</th>\n      <td>CVE-2026-116331</td>\n      <td>18.7、17.12、16.16、15.20、14.25 之前的版本</td>\n      <td>11 月 12 日修复</td>\n    </tr>\n    <tr>\n      <th>MySQL Server 和 Cluster</th>\n      <td>CVE-2026-101786</td>\n      <td>26.7.0 至 26.7.1</td>\n      <td>10 月 20 日修复</td>\n    </tr>\n    <tr>\n      <th>Oracle Database（Oracle Text）</th>\n      <td>CVE-2026-114819</td>\n      <td>19.3-19.32, 21.3-21.24, 23.4.0-23.26.3</td>\n      <td>11 月 17 日修复</td>\n    </tr>\n    <tr>\n      <th>Oracle REST Data Services</th>\n      <td>CVE-2026-91609</td>\n      <td>24.2.0 至 26.2.1</td>\n      <td>10 月 20 日修复</td>\n    </tr>\n    <tr>\n      <th>ClickHouse</th>\n      <td>未分配 CVE</td>\n      <td>已测试 26.7.5.10</td>\n      <td>无已确认的修复版本</td>\n    </tr>\n  </tbody>\n</table><p>除了安装更新之外，另一项措施是审查各账户能做什么，而不仅仅是能读什么，并从不需要这些权限的账户中收回 TEMPORARY 权限和宽泛的临时表权限。这一步并不能堵住 Oracle 路径，因为该路径在没有任何账户的情况下即可开始。</p><p>觉得这篇文章有意思吗？关注我们的 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a>，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","复现","漏洞分析","漏洞利用","数据库","Oracle","https://thehackernews.com/2026/11/researcher-demonstrates-database-rce.html","The Hacker News",{"_84":85,"_86":-5},"changelogVersion","2026-10-01T08:00","release"]
