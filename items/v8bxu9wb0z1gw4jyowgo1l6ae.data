[{"_1":2,"_3":4},"root",{"_5":91},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1795394442000,"id","v8bxu9wb0z1gw4jyowgo1l6ae","title","@openeudi/openid4vp 证书链校验漏洞可接受伪造证书，已在 0.8.1 修复","originalTitle","OpenID4VP: X.509 chain validation accepts a forged certificate that reuses a trusted anchor's Subject DN without verifying its signature","summary","@openeudi/openid4vp 的 ChainBuilder 仅按 Subject DN 字符串相等终止证书链构建，未验证终止证书与信任锚的签名，攻击者可复制信任锚 Subject DN 并用私钥签发伪造凭证，使 OpenID4VP 验证路径将其误判为可信凭证。","reason","文章完整说明证书链校验缺陷、PoC、影响路径与修复方式，适合评估依赖该库验证身份凭证的团队。","source",{"_73":90},"links",{"_60":89},"publishedAt","2026-11-19T20:35:57.000Z","discoveredAt","2026-11-19T20:53:20.359Z","timelineAt","category","vuln","tags",[84,85,86,87,79,88],"score",72,"selected",true,"channel","news","story",{"_81":82,"_13":83},"x","readingMode","full","author","body","outline",[],"relatedStories",[80],"topics",[67,68,69,70],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","f7Sfygn8GM-E","reportCount",1,"additionalSourceCount",0,{"_71":78,"_73":79},{"_71":76,"_73":77},{"_71":31,"_73":75},{"_71":72,"_73":74},"slug","research","name","技术研究","漏洞披露","crypto","密码学","identity","身份与访问",{"_81":82,"_13":83},"publicId","44c69b85-fd9f-4b59-91de-4da1d7fd3042","OpenID4VP证书链验证漏洞已修复","漏洞","复现","补丁","漏洞分析","加密","https://github.com/advisories/GHSA-4c2f-96cf-f5fc","GitHub 安全公告",{"_92":93,"_94":-5},"changelogVersion","2026-10-01T08:00","release"]
