[{"_1":2,"_3":4},"root",{"_5":106},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1795912851000,"id","vhwe2fax4m9ymu05rbldf674y","title","1Password 员工 GitHub 账号遭入侵，攻击者窃取客户数据","originalTitle","1Password customer data stolen after employee GitHub account breach","summary","1Password 披露，一名员工的 corporate GitHub 账号被攻破后，攻击者访问私有源码仓库并向后端服务注入恶意代码，下载客户账户记录及内部源码。","reason","source",{"_75":105},"links",{"_94":104},"publishedAt","2026-11-25T21:33:33.000Z","discoveredAt","2026-11-25T22:20:18.715Z","timelineAt","category","activity","tags",[76,100,101,102,103],"score",72,"selected",true,"channel","news","story",{"_84":85,"_13":86},"x","sameEvent",{"_11":98,"_13":99},"readingMode","full","author","Lawrence Abrams","body",{"_62":93,"_94":-5,"_95":96,"_97":36},"outline",[87],"relatedStories",[83],"topics",[69,70,71,72],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","fs4uFWevETHQ","reportCount",5,"additionalSourceCount",4,{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","attack","name","攻击活动","red-team","红队与渗透","identity","身份与访问","supply-chain","供应链安全",{"_84":85,"_13":86},"publicId","bb557fad-4614-4000-8e00-bc153b15ba76","1Password 披露员工 GitHub 账号被攻破，部分客户账户数据外泄",{"_11":88,"_89":90,"_91":92},"sec-1","text","发现现有防御措施可能遗漏的电子邮件威胁。","level",2,"<p><img alt=\"1Password\" height=\"900\" src=\"/dailyinfo/media/24f4bda8bb4cb661.jpg\" srcset=\"/dailyinfo/media/e01264c024e6dae5.jpg 720w, /dailyinfo/media/2aea2cdaee55f36e.jpg 1200w, /dailyinfo/media/24f4bda8bb4cb661.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>1Password披露了一起数据泄露事件：一名员工的企业 GitHub 账户遭黑客入侵，并被用于向公司的后端服务部署恶意代码，以窃取客户数据。</p><p>该公司表示，客户的密码库以及保护这些密码库的加密密钥在此次攻击中并未遭到泄露。</p><p>1Password 今天发布的<a href=\"https://1password.com/blog/update-on-nov-2026-security-incident\">安全事件披露</a>称，该公司在 11 月 19 日发现某员工的 GitHub 账户可能已遭入侵的迹象后，开始调查此次泄露事件。</p><p><a href=\"https://www.wiz.io/lp/claude-code-security-best-practices-cheat-sheet?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q3_INB_FORM_Claude-Code-Security-Best-Practices&amp;sfcid=701Vh00000gJQZuIAO&amp;utm_term=FY27Q4-bleepingcomputer-article-970x250-Nov&amp;utm_content=Claude-Code-Best-Practices\"><img src=\"/dailyinfo/media/7a5a3a6292d5f413.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>攻击者利用该账户访问私有源代码存储库，并将恶意代码注入后端服务；这些服务会下载客户账户记录。</p><p>被盗数据包括：</p><ul>\n\t<li>客户姓名和电子邮件地址</li>\n\t<li>账户 ID 和用户 ID</li>\n\t<li>账户创建时间和最后登录时间戳</li>\n\t<li>公共加密密钥</li>\n\t<li>安全远程密码（SRP）协议参数</li>\n\t<li>邀请、配置和账户恢复令牌</li>\n\t<li>其他内部账户元数据</li>\n</ul><p>攻击者还窃取了公司的内部源代码，并访问了其持续集成和持续交付（CI/CD）环境，这可能造成内部基础设施凭据暴露。</p><p>被盗客户数据中包含嵌入链接的令牌；1Password 通过电子邮件向用户发送这些链接，用于接受账户配置邀请或恢复账户。</p><p>不过，1Password 表示，这些令牌无法单独用于访问客户账户，因为完成邀请或恢复流程需要单点登录（SSO）身份验证，或者输入发送至用户注册电子邮件地址的六位验证码。</p><p>该公司表示，只有少数用户受到影响，并已逐一通知这些用户。</p><p>作为防范暴力破解攻击的预防措施，1Password 已将这些验证码从六位数字加强为十位字母数字字符。</p><p>该公司表示，现已禁用遭入侵的 GitHub 账户、撤销被盗令牌、恢复受影响服务的干净版本，并轮换或撤销可能已暴露的基础设施凭据。</p><p>1Password 还聘请了独立网络安全专家验证其修复工作，并表示未发现客户账户被接管的内部证据。</p><p>该公司不要求客户更改账户密码或 Secret Key，但提醒客户警惕意外的邀请、账户恢复请求以及其他潜在的网络钓鱼尝试。</p><p>虽然客户的密码库在此次攻击中并未遭到泄露，但被盗数据对威胁行为者而言很有价值，因为其中包含已知 1Password 用户的名单，攻击者可将其作为网络钓鱼活动的目标。</p><p>威胁行为者可能发送冒充 1Password 的电子邮件，以此次数据泄露为诱饵，诱骗客户披露其账户密码、Secret Key 或恢复验证码。</p><p>客户尤其应对声称他们需要因此次数据泄露而保护账户、重置密码或验证账户信息的电子邮件保持警惕。</p><p>客户不应点击这些电子邮件中的链接，而应直接通过 1Password 网站或应用访问账户，并且绝不应向任何人提供自己的密码、Secret Key 或验证码。</p><p>BleepingComputer 就此次攻击向 1Password 提出了问题，但尚未收到回应。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/1f6f9d6dc9ced8f5.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御措施可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体会分析邮件意图、上下文和行为，以发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>通过为期 14 天的只读扫描查看 Microsoft 365 或 Google Workspace 中有哪些邮件得以通过，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始免费的电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","rr7sx0dz0qufgq4kbf55wt6e2","1Password GitHub 账号遭入侵，部分客户信息与源代码被窃取","数据泄露","供应链","凭据","红队","https://www.bleepingcomputer.com/news/security/1password-customer-data-stolen-after-employee-github-account-breach/","BleepingComputer",{"_107":108,"_109":-5},"changelogVersion","2026-10-01T08:00","release"]
