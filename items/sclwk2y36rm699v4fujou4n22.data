[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1795653648000,"id","sclwk2y36rm699v4fujou4n22","title","VMware vCenter Server 身份验证绕过漏洞 CVE-2026-123903 通告，CVSS 9.8","originalTitle","【漏洞通告】VMware vCenter Server身份认证绕过漏洞（CVE-2026-123903）","summary","Broadcom 修复 VMware vCenter Server 身份验证绕过漏洞 CVE-2026-123903，CVSS 评分 9.8，漏洞细节与 PoC 已公开，绿盟科技CERT 暂未发现在野利用。","reason","source",{"_70":103},"links",{"_94":102},"publishedAt","2026-11-25T05:15:00.000Z","discoveredAt","2026-11-25T17:19:08.876Z","timelineAt","category","vuln","tags",[97,98,99,100,101],"score",75,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body",{"_60":93,"_94":-5,"_95":94,"_96":55},"outline",[78,79,80,81],"relatedStories",[74],"topics",[67,68],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","feVsqxP2e9G0","reportCount",1,"additionalSourceCount",0,{"_69":72,"_70":73},{"_69":30,"_70":71},"slug","name","漏洞披露","vmware","VMware / Broadcom",{"_75":76,"_13":77},"publicId","f26bad15-2100-46af-b49b-9f8342651d0c","vCenter认证绕过漏洞已复现并发布补丁",{"_11":91,"_83":92,"_85":86},{"_11":89,"_83":90,"_85":86},{"_11":87,"_83":88,"_85":86},{"_11":82,"_83":84,"_85":86},"sec-4","text","4.1 官方升级","level",3,"sec-3","3.1 人工检测","sec-2","不受影响版本","sec-1","受影响版本","<p><span>NS-CERT</span> <span>2026-11-25 13:15</span> <span>四川</span></p><p><img src=\"/dailyinfo/media/39bcd490ea2d4888.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>近日，绿盟科技CERT监测到Broadcom发布安全公告，修复了VMware vCenter Server身份认证绕过漏洞（CVE-2026-123903）；CVSS评分9.8，目前漏洞细节已公开，请相关用户尽快采取措施进行防护。</p><p><strong><span>通告编号 NS-2026-0038</span></strong></p><p><span><span>2026-11-24</span></span></p><table><tbody><tr><td><strong><span><span>TAG：</span></span></strong></td><td colspan=\"3\"><p><strong><span><span>VMware vCenter、身份验证绕过、CVE-2026-123903</span></span></strong></p></td></tr><tr><td><strong><span><span>在野利用：</span></span></strong></td><td><p><strong><span>未发现</span></strong></p></td><td><strong><span><span>PoC状态：</span></span></strong></td><td><p><strong><span>已公开</span></strong></p></td></tr><tr><td><strong><span><span>漏洞危害：</span></span></strong></td><td colspan=\"3\"><p><strong><span>攻击者利用此漏洞，可实现身份验证绕过。</span></strong></p></td></tr></tbody></table><p><strong><span>1</span></strong></p><p><strong><span><span>漏洞概述</span></span></strong></p><p><span>近日，绿盟科技CERT监测到Broadcom发布安全公告，修复了VMware vCenter Server身份认证绕过漏洞（CVE-2026-123903）；由于VMware Directory Service（vmdird）组件在特定认证流程中存在访问控制缺陷，未经身份验证的攻击者可通过访问vCenter的LDAP接口（默认TCP 389端口）绕过系统验证创建管理员账号，从而接管vCenter并非法访问及管理虚拟化基础设施。CVSS评分9.8，目前漏洞细节与PoC已公开，请相关用户尽快采取措施进行防护。</span></p><p><span>VMware vCenter Server是Broadcom公司的一种服务器管理解决方案，可帮助IT管理员通过单个控制台管理企业环境中的虚拟机和虚拟化主机；是VMware Cloud Foundation、VMware vSphere Foundation及Telco Cloud等环境的核心管理组件。VMware Directory Service（vmdir）为其SSO提供身份目录服务。</span></p><p><span>参考链接：</span></p><p><span><a href=\"https://support.broadcom.com/web/ecx/support-content-notification/-/external/content/SecurityAdvisories/0/39626\">https://support.broadcom.com/web/ecx/support-content-notification/-/external/content/SecurityAdvisories/0/39626</a></span></p><p><strong><span>SEE MORE →</span></strong></p><p><span><strong><span>2</span></strong></span><strong><span>影响范围</span></strong></p><h3 id=\"sec-1\"><strong><span>受影响版本</span></strong></h3><ul><li><p><span>VMware vCenter Server = 7.0</span></p></li><li><p><span>8.0 &lt;= VMware vCenter Server &lt; 8.0 U3m</span></p></li><li><p><span>VMware Cloud Foundation 5.x &lt; 5.2.5</span></p></li><li><p><span>VMware Cloud Foundation（vCenter）9.1.x.x &lt; 9.1.2</span></p></li><li><p><span>VMware vSphere Foundation（vCenter）9.1.x.x &lt; 9.1.2</span></p></li><li><p><span>VMware Cloud Foundation（vCenter）9.0.x.x &lt; 9.0.2.0300</span></p></li><li><p><span>VMware vSphere Foundation（vCenter）9.0.x.x &lt; 9.0.2.0300</span></p></li><li><p><span>VMware Telco Cloud Platform = 3.0/4.x/5.0.x/5.1.x/5.2</span></p></li><li><p><span>VMware Telco Cloud Infrastructure = 3.0</span></p></li></ul><p><span>注：官方停止维护的vSphere 6.5、6.7等旧版本也可能受影响。</span></p><h3 id=\"sec-2\"><strong><span>不受影响版本</span></strong></h3><ul><li><p><span>VMware vCenter Server 8.0 &gt;= 8.0 U3m</span></p></li><li><p><span>VMware Cloud Foundation 5.x &gt;= 5.2.5</span></p></li><li><p><span>VMware Cloud Foundation（vCenter）9.1.x.x &gt;= 9.1.2</span></p></li><li><p><span>VMware vSphere Foundation（vCenter）9.1.x.x &gt;= 9.1.2</span></p></li><li><p><span>VMware Cloud Foundation（vCenter）9.0.x.x &gt;= 9.0.2.0300</span></p></li><li><p><span>VMware vSphere Foundation（vCenter）9.0.x.x &gt;= 9.0.2.0300</span></p></li><li><p><span>VMware Telco Cloud Platform/Infrastructure KB463501</span></p></li></ul><p><span>注：具有延长支持合同的vCenter 7.0用户可联系Broadcom Support获取补丁，其他用户应尽快迁移至受支持版本。</span></p><p><span><strong><span>3</span></strong></span><strong><span>漏洞检测</span></strong></p><h3 id=\"sec-3\"><strong><span>3.1 人工检测</span></strong></h3><p><span>相关用户可通过检查vCenter Server版本判断当前环境是否在受影响范围：</span></p><p><span>使用管理员账户登录vCenter Server管理界面（VAMI），在VAMI的“摘要”或“更新”页面查看vCenter Server版本及构建号；也可登录vSphere Client中通过“帮助 &gt; 关于”查看版本信息。</span></p><p><span>若当前vCenter Server及补丁版本处于受影响范围，则可能存在安全风险。</span></p><p><span><strong><span>4</span></strong></span><strong><span>漏洞防护</span></strong></p><h3 id=\"sec-4\"><strong><span>4.1 官方升级</span></strong></h3><p><span>目前官方已发布新版本或安全补丁修复此漏洞，请受影响的用户尽快更新进行防护，对应产品版本的下载链接及文档如下：</span></p><table><tbody><tr><th><p><span>产品版本</span></p></th><th><p><span>下载链接</span></p></th><th><p><span>操作文档</span></p></th></tr><tr><td><p><span>VMware vCenter 8.0 U3m</span></p></td><td><p><span><a href=\"https://support.broadcom.com/web/ecx/solutiondetails?patchId=16137\">https://support.broadcom.com/web/ecx/solutiondetails?patchId=16137</a></span></p></td><td><p><span><a href=\"https://techdocs.broadcom.com/us/en/vmware-cis/vsphere/vsphere/8-0/release-notes/esxi-update-and-patch-release-notes/vsphere-esxi-80u3m-release-notes.html\">https://techdocs.broadcom.com/us/en/vmware-cis/vsphere/vsphere/8-0/release-notes/esxi-update-and-patch-release-notes/vsphere-esxi-80u3m-release-notes.html</a></span></p></td></tr><tr><td><p><span>VMware vCenter 9.0.2.0300</span></p></td><td><p><span><a href=\"https://support.broadcom.com/group/ecx/productfiles?displayGroup=VMware%20Cloud%20Foundation%209&amp;release=9.0.2.0&amp;os=&amp;servicePk=537791&amp;language=EN&amp;groupId=537830&amp;viewGroup=true\">https://support.broadcom.com/group/ecx/productfiles?displayGroup=VMware%20Cloud%20Foundation%209&amp;release=9.0.2.0&amp;os=&amp;servicePk=537791&amp;language=EN&amp;groupId=537830&amp;viewGroup=true</a></span></p></td><td><p><span><a href=\"https://techdocs.broadcom.com/us/en/vmware-cis/vcf/vcf-9-0-and-later/9-0/release-notes/patch-releases-9-0-0-x/vsphere/vcenter/vcenter-9-0-2-0300-release-notes.html\">https://techdocs.broadcom.com/us/en/vmware-cis/vcf/vcf-9-0-and-later/9-0/release-notes/patch-releases-9-0-0-x/vsphere/vcenter/vcenter-9-0-2-0300-release-notes.html</a></span></p></td></tr><tr><td><p><span>VMware vCenter 9.1.2</span></p></td><td><p><span><a href=\"https://support.broadcom.com/group/ecx/productfiles?displayGroup=VMware%20Cloud%20Foundation%209&amp;release=9.1.2.0&amp;os=&amp;servicePk=547583&amp;language=EN&amp;groupId=547661&amp;viewGroup=true\">https://support.broadcom.com/group/ecx/productfiles?displayGroup=VMware%20Cloud%20Foundation%209&amp;release=9.1.2.0&amp;os=&amp;servicePk=547583&amp;language=EN&amp;groupId=547661&amp;viewGroup=true</a></span></p></td><td><p><span><a href=\"https://techdocs.broadcom.com/us/en/vmware-cis/vcf/vcf-9-0-and-later/9-1/release-notes/vmware-cloud-foundation-9-1-2-0-release-notes/vcenter-9-1-2-0-release-notes.html\">https://techdocs.broadcom.com/us/en/vmware-cis/vcf/vcf-9-0-and-later/9-1/release-notes/vmware-cloud-foundation-9-1-2-0-release-notes/vcenter-9-1-2-0-release-notes.html</a></span></p></td></tr><tr><td><p><span>VMware Cloud Foundation 5.2.5</span></p></td><td><p><span><a href=\"https://knowledge.broadcom.com/external/article?legacyId=88287\">https://knowledge.broadcom.com/external/article?legacyId=88287</a></span></p></td><td><p><span><a href=\"https://techdocs.broadcom.com/us/en/vmware-cis/vcf/vcf-5-2-and-earlier/5-2/vcf-release-notes/vmware-cloud-foundation-525-release-notes.html\">https://techdocs.broadcom.com/us/en/vmware-cis/vcf/vcf-5-2-and-earlier/5-2/vcf-release-notes/vmware-cloud-foundation-525-release-notes.html</a></span></p></td></tr><tr><td><p><span>VMware Telco Cloud Platform/Infrastructure KB463501</span></p></td><td colspan=\"2\"><p><span><a href=\"https://knowledge.broadcom.com/external/article/463501\">https://knowledge.broadcom.com/external/article/463501</a></span></p></td></tr></tbody></table><p><span>注：VMware Cloud Foundation 5.x用户应按照KB88287的异步补丁流程将vCenter升级至8.0 U3m，并将SDDC Manager升级至5.2.5；Telco Cloud Platform和Telco Cloud Infrastructure用户应按照463501进行修复。</span></p><p><strong><span>END</span></strong></p><p><img src=\"/dailyinfo/media/ca460a10b9f10d9c.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img src=\"/dailyinfo/media/e8421b37b5151020.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>声明</span></strong></p><p><span>本安全公告仅用来描述可能存在的安全问题，绿盟科技不为此安全公告提供任何保证或承诺。由于传播、利用此安全公告所提供的信息而造成的任何直接或者间接的后果及损失，均由使用者本人负责，绿盟科技以及安全公告作者不为此承担任何责任。</span></p><p><span>绿盟科技拥有对此安全公告的修改和解释权。如欲转载或传播此安全公告，必须保证此安全公告的完整性，包括版权声明等全部内容。未经绿盟科技允许，不得任意修改或者增减此安全公告内容，不得以任何方式将其用于商业目的。</span></p><p><img src=\"/dailyinfo/media/e8421b37b5151020.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><span><strong><span>绿盟科技CERT</span></strong></span><span><span>∣</span></span><span><span>微信公众号</span></span></p><p><img src=\"/dailyinfo/media/91d1362baa3c1b98.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><img src=\"/dailyinfo/media/92c6a439501263e0.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>长按识别二维码，关注网络安全威胁信息</span></span></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=94acb07a&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzk0MjE3ODkxNg%3D%3D%26mid%3D2247494326%26idx%3D2%26sn%3D75c5ad1f4323892c18ceff3a1a5950cd\">跳转微信打开</a></p>","original","zhKind","complete","漏洞","补丁","复现","VMware","漏洞利用","https://mp.weixin.qq.com/s?__biz=Mzk0MjE3ODkxNg==&mid=2247494326&idx=2&sn=75c5ad1f4323892c18ceff3a1a5950cd","绿盟科技CERT",{"_105":106,"_107":-5},"changelogVersion","2026-10-01T08:00","release"]
