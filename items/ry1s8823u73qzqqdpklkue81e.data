[{"_1":2,"_3":4},"root",{"_5":113},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794616833000,"id","ry1s8823u73qzqqdpklkue81e","title","WorkOS 称攻击者利用 ARTEX AI 入侵内部销售应用","originalTitle","WorkOS says attacker used ARTEX AI to breach internal sales app","summary","WorkOS 称攻击者使用 ARTEX AI 渗透测试框架自动执行侦察与利用尝试，入侵了销售团队使用的内部应用。2026年10月30日发现未授权访问后，公司关闭外部访问、审查内部工具权限，并聘请独立取证与事件响应机构调查影响。","reason","WorkOS披露了攻击者如何借助 ARTEX AI 自动化侦察与利用，并列出泄露字段和处置措施，便于相关组织评估社工风险。","source",{"_76":112},"links",{"_103":111},"publishedAt","2026-11-03T21:28:44.000Z","discoveredAt","2026-11-03T22:16:21.110Z","timelineAt","category","activity","tags",[77,107,79,108,109,110,87],"score",79,"selected",true,"channel","news","story",{"_89":90,"_13":91},"x","readingMode","full","author","Bill Toulas","body",{"_61":102,"_103":-5,"_104":105,"_106":37},"outline",[92,93],"relatedStories",[88],"topics",[68,69,70,71,72,73],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fxUi-oNRKe_g","reportCount",1,"additionalSourceCount",0,{"_74":86,"_76":87},{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","attack","name","攻击活动","ai-offense","AI 攻防","red-team","红队与渗透","email","邮件与钓鱼","identity","身份与访问","crowdstrike","CrowdStrike",{"_89":90,"_13":91},"publicId","d88c44d4-7bd4-4a7e-9fc7-9ae46293bda1","WorkOS确认ARTEX智能体越界下载客户数据",{"_11":99,"_95":100,"_97":101},{"_11":94,"_95":96,"_97":98},"sec-2","text","发现现有防御可能遗漏的电子邮件威胁。","level",2,"sec-1","ARTEX AI 很可能为此次攻击提供支持",3,"<p><img alt=\"WorkOS says attacker used ARTEX AI to breach internal sales app\" height=\"900\" src=\"/dailyinfo/media/632f2a4790433392.jpg\" srcset=\"/dailyinfo/media/c0001d366f784c65.jpg 720w, /dailyinfo/media/8751bd045791a27b.jpg 1200w, /dailyinfo/media/632f2a4790433392.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>开发者平台 WorkOS 遭遇数据泄露，原因是某威胁行为者访问了业务联系人记录和客户通信摘要。</p><p>据该公司称，攻击者使用了一款 AI 攻防安全框架来自动化侦察和漏洞利用尝试。</p><p>根据调查证据，没有 WorkOS 应用数据或生产服务遭到访问或影响。</p><p><a href=\"https://www.wiz.io/lp/ai-security-starter-pack?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Security-Starter-Kit&amp;sfcid=701Vh00000cn7aRIAQ&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AI-Security-Bundle\"><img src=\"/dailyinfo/media/be072e5997b61b64.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>WorkOS 是一家开发者基础设施公司，提供 API、SDK 和工具，用于将企业身份验证、单点登录（SSO）、用户管理和身份管理等服务集成到应用中。</p><p>据其网站称，至少有<a href=\"https://workos.com/customers\">3,000 家企业</a>使用其服务，包括 OpenAI、Anthropic、Cursor、Perplexity、Snowflake、Plaid、Webglow 和 Netlify。</p><p>该公司在<a href=\"http://workos.com/security/bulletins/october-30th-2026-data-security-incident\">事件警报</a>中表示：“2026 年 10 月 30 日，我们发现有人未经授权访问了销售团队使用的一款内部 WorkOS 应用。”</p><p>攻击者访问的数据包括：</p><ul>\n\t<li>业务联系人详细信息（来自 CRM 系统的姓名、电子邮件地址、职位和公司所属关系）</li>\n\t<li>客户账户历史（产品使用情况以及连接或目录运行状况）</li>\n\t<li>客户通信（销售通话、支持讨论和客户 Slack 对话的摘要与节选）</li>\n\t<li>业务账户和关系信息（账户历史、销售信息和客户关系信息）</li>\n</ul><p>发现入侵后，WorkOS 禁用了外部对该受影响应用的访问，并审查了内部工具的访问控制。</p><p>该公司还委托了一家独立的取证和事件响应机构追踪未经授权的活动，并确定其全部影响。</p><p>该公司承诺直接通知受影响的客户，并警告用户警惕利用泄露信息实施的网络钓鱼或社会工程攻击。</p><h3 id=\"sec-1\">ARTEX AI 很可能为此次攻击提供支持</h3><p>WorkOS 的公告称，此次攻击使用了一款 AI 驱动的攻防安全框架，以自动化侦察和漏洞利用尝试。</p><p>公司创始人 Michael Grinich <a href=\"https://x.com/grinich/status/2117400083151138954\">分享了更多细节</a>，称攻击者使用了 ARTEX AI 渗透测试套件；今年已有多起事件中观察到该套件。</p><p>该平台由中国开发者于今年早些时候发布，曾以开源项目的形式提供，用于攻防安全。</p><p>在 ARTEX AI 被<a href=\"https://www.bleepingcomputer.com/news/security/hacker-used-artex-ai-and-claude-agents-to-target-south-korean-banks/\">用于针对韩国银行的攻击</a>后，该平台转为私有，但其代码的若干分支仍可获得。</p><p>最近，<a href=\"https://www.bleepingcomputer.com/news/security/chinese-hackers-use-artex-ai-in-automated-attacks-against-200-orgs/\">CrowdStrike 披露</a>，网络间谍组织“Vapor Panda”在一次针对 200 家组织的全球性行动中使用了该渗透测试框架。</p><p>此前，非营利网络安全组织 DIVD 也披露，同一框架为其<a href=\"https://www.bleepingcomputer.com/news/security/automated-ai-agent-used-to-breach-cybersecurity-nonprofit-divd/\">去年 9 月遭受的攻击</a>提供了支持。</p><p>Grinich <a href=\"https://x.com/grinich/status/2117454150376321190\">解释道</a>，调查团队在威胁行为者发出的网络请求中发现了‘artex-enrich/1.0’和‘norma/0.4’等用户代理。</p><p>这位创始人保证，此次网络安全事件现已得到全面控制，并承诺在调查完成后分享有关此次攻击的更多信息。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/c132e890d608eb09.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-2\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体会分析电子邮件意图、上下文和行为，以发现网络钓鱼、业务电子邮件入侵和发票欺诈。</p><p>通过 14 天只读扫描查看 Microsoft 365 或 Google Workspace 中有哪些内容被成功传递，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始您的免费电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","数据泄露","红队","凭据","钓鱼","https://www.bleepingcomputer.com/news/security/workos-says-attacker-used-artex-ai-to-breach-internal-sales-app/","BleepingComputer",{"_114":115,"_116":-5},"changelogVersion","2026-10-01T08:00","release"]
