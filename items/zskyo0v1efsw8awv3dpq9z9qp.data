[{"_1":2,"_3":4},"root",{"_5":94},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795912856000,"id","zskyo0v1efsw8awv3dpq9z9qp","title","PHP 反序列化远程代码执行漏洞 CVE-2026-126714 已发布补丁","originalTitle","phpAfterShell：PHP 反序列化远程代码执行漏洞(CVE-2026-126714)安全风险通告","summary","PHP files 会话保存处理器存在反序列化远程代码执行漏洞 CVE-2026-126714，CVSS 4.0 分数为 9.2。攻击者需影响目标会话内容、在写入时制造中断，并找到应用中的反序列化 gadget chain；Redis、数据库等非文件后端不受影响。","reason","通告梳理了会话文件截断缺陷的利用链与四项前提，并明确列出受影响分支、修复版本及临时缓解措施。","source",{"_73":93},"links",{"_83":92},"publishedAt","2026-11-19T17:25:00.000Z","discoveredAt","2026-11-20T10:16:31.416Z","timelineAt","category","vuln","tags",[86,87,88,89,76,90,91],"score",75,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","body",{"_61":82,"_83":-5,"_84":83,"_85":37},"outline",[],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fnkzntYGrC9c","reportCount",2,"additionalSourceCount",1,{"_71":31,"_73":77},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","research","name","技术研究","exploited","在野利用","漏洞披露",{"_79":80,"_13":81},"publicId","5c978771-d0ef-4f3e-adc8-d47e442566ab","PHP修复phpAfterShell反序列化漏洞","<p><span>奇安信 CERT</span> <span>2026-11-20 01:25</span> <span>江苏</span></p><p><img src=\"/dailyinfo/media/0bfe68c22f7440e4.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>致力于第一时间为企业级用户提供权威漏洞情报和有效解决方案。</p><p><span><span>●&nbsp;</span></span><span><span>点击↑蓝字关注我们，获取更多安全风险通告。</span></span></p><hr><table><tbody><tr><td colspan=\"4\" align=\"center\"><p><span><strong><span><span>漏洞概述</span></span></strong></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>漏洞名称</span></span></strong></span></p></td><td colspan=\"3\" align=\"left\"><p><span><span>PHP 反序列化远程代码执行漏洞</span></span></p></td></tr><tr><td align=\"left\"><p><span><span><strong><span>漏洞编号</span></strong></span></span></p></td><td colspan=\"3\" align=\"left\"><p><span><span>QVD-2026-112923，</span><span>CVE-2026-126714</span></span></p></td></tr><tr><td align=\"left\"><p><strong><span><strong><span><span>公开时间</span></span></strong></span></strong></p></td><td align=\"left\"><p><span><span>2026-11-19</span></span></p></td><td align=\"left\"><p><strong><span><strong><span><span>影响量级</span></span></strong></span></strong></p></td><td align=\"left\"><p><span><span>千万级</span></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>奇安信评级</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>高危</span></span></strong></span></p></td><td align=\"left\"><p><strong><span><span>CVSS 4.0分数</span></span></strong></p></td><td align=\"left\"><p><span><span><strong><span>9.2</span></strong></span></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span>威胁类型</span></strong></span></p></td><td align=\"left\"><p><span><span><span>代码执行</span></span></span></p></td><td align=\"left\"><p><strong><span><span>利用可能性</span></span></strong></p></td><td align=\"left\"><p><strong><span><strong><span>高</span></strong></span></strong></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>POC状态</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span><span>未公开</span></span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>在野利用状态</span></span></strong></span></p></td><td align=\"left\"><p><span><span><span>未发现</span></span></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>EXP状态</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span><span>未公开</span></span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>技术细节状态</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span><span>已公开</span></span></span></strong></span></p></td></tr><tr><td colspan=\"4\" align=\"left\"><p><strong><span><span>危害描述：</span></span></strong><span><span>攻击者可以利用该漏洞，通过会话上传进度等途径影响会话数据并在写入过程中制造中断，使后续 session_start() 将混合内容反序列化为攻击者控制的对象，结合应用中的 gadget chain 实现远程代码执行，同时还可破坏会话状态完整性。</span></span></p></td></tr></tbody></table><p><strong><span>0</span></strong><strong><span>1</span></strong></p><p><strong><span>漏洞详情</span></strong></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>影响组件</span></span></strong></p><p><span>PHP 是一种广泛使用的开源服务器端脚本语言，主要用于动态 Web 应用开发。它支持会话管理、文件上传处理、数据库交互等多种功能，是 WordPress、Laravel、各类 CMS 和企业应用的核心运行时。PHP 默认使用基于文件的会话保存处理器（session.save_handler = files），通过序列化将会话数据写入磁盘文件，并在后续请求中反序列化恢复。该机制在处理会话更新时涉及文件写入与截断操作。</span></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>漏洞描述</span></span></strong></p><p><span>近日，奇安信CERT监测到官方修复<span>PHP 反序列化远程代码执行漏洞(CVE-2026-126714)</span>，该漏洞源于 files 会话保存处理器在更新会话时直接将新序列化数据写入现有文件而未先清空内容，若写入过程被中断，会话文件会残留新数据前缀与旧数据后缀的混合内容。攻击者可以利用该漏洞，通过会话上传进度等途径影响会话数据并在写入过程中制造中断，使后续 session_start() 将混合内容反序列化为攻击者控制的对象，结合应用中的 gadget chain 实现远程代码执行，同时还可破坏会话状态完整性。<span>目前该漏洞技术细节已公开。</span></span><span><span>鉴于该漏洞影响范围较大，建议客户尽快做好自查及防护。</span></span></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>利用条件</span></span></strong></p><p><span><span>1.使用默认的 files 会话存储处理程序（Redis、数据库等非文件后端不受此缺陷影响）;</span></span></p><p><span><span>2.攻击者能够影响目标会话中存储的内容（如利用会话上传进度或应用将攻击者可控字符串写入会话）;</span></span></p><p><span><span>3.能在写入操作的有利位置造成中断（多线程构建中其他线程内存限制失败等场景）;</span></span></p><p><span><span>4.目标应用中存在可用的反序列化 gadget 链以将反序列化原语转化为代码执行。</span></span></p><p><strong><span>02</span></strong></p><p><strong><span>影响范围</span></strong></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>影响版本</span></span></strong></p><p><span>8.5.0 &lt;= PHP &lt; 8.5.13</span></p><p><span>8.4.0 &lt;= PHP &lt; 8.4.28</span></p><p><span>8.3.0 &lt;= PHP &lt; 8.3.37</span></p><p><span>8.2.0 &lt;= PHP &lt; 8.2.36</span></p><p><span>PHP 8.1 及更早版本已停止维护。官方的 7.4、8.0 和 8.1 版本 EOL 缓解分支会禁用回调函数中的上传进度信息，因此不受影响。</span></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>其他受影响组件</span></span></strong></p><p><span><span>无</span></span></p><p><strong><span>03</span></strong></p><p><strong><span>处置建议</span></strong></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>安全更新</span></span></strong></p><p><span>官方已发布安全补丁，请及时更新至最新版本：</span></p><p><span>PHP 8.5.* &gt;= 8.5.13</span></p><p><span>PHP 8.4.* &gt;= 8.4.28</span></p><p><span>PHP 8.3.* &gt;= 8.3.37</span></p><p><span>PHP 8.2.* &gt;= 8.2.36</span></p><p><span>PHP 8.1及更早版本已 EOL，无官方修复，应迁移至受支持分支</span></p><p><span>下载地址：</span></p><p><span><a href=\"https://www.php.net/downloads.php\">https://www.php.net/downloads.php</a></span></p><p><span>修复方式为在写入前将会话文件截断为零长度，并确保截断失败时中止写入，从而避免旧后缀残留。升级后需重新构建容器镜像、重新部署，并确认生产环境实际运行新版本。注意2026年10月21日发布的8.5.12、8.4.27、8.3.36、8.2.35不含本漏洞修复，10月已打补丁不构成防护。</span></p><p><span><span>临时缓解措施：</span></span></p><p><span>1.禁用会话上传进度：在 php.ini 中设置 session.upload_progress.enabled = 0 并重启 PHP 工作进程，可移除最易利用的输入路径（但无法修复应用自身存储攻击者可控会话数据的情形，仍需升级）;</span></p><p><span>2.限制会话中的不可信数据：严格控制写入会话的用户可控字符串体积与内容。</span></p><p><strong><span>04</span></strong></p><p><strong><span>参考资料</span></strong></p><p><span><span>[1]</span><span><a href=\"https://github.com/php/php-src/security/advisories/GHSA-fm2m-fjf5-v3cp\">https://github.com/php/php-src/security/advisories/GHSA-fm2m-fjf5-v3cp</a></span></span></p><p><span><span>[2]</span><span><a href=\"https://depthfirst.com/research/phpaftershell\">https://depthfirst.com/research/phpaftershell</a></span></span></p><p><strong><span>05</span></strong></p><p><strong><span>时间线</span></strong></p><p><span><span>2026年11月20日，奇安信 CERT发布安全风险通告。</span></span></p><p><strong><span>06</span></strong></p><p><strong><span>漏洞情报服务</span></strong></p><p><span><span>「</span><span>奇安信漏洞情报平台</span><span>」</span><span>重磅上线，诚邀您来体验：</span></span></p><p><img alt=\"图片\" src=\"/dailyinfo/media/c82d79c00379a594.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img alt=\"图片\" src=\"/dailyinfo/media/c79fa164257d5d8e.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img alt=\"图片\" title=\"CERT LOGO.png\" width=\"100%\" src=\"/dailyinfo/media/679bd1b92c3180e9.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><strong><span>奇安信 CERT</span></strong></span></p><p><span><strong><span><span>致力于</span></span></strong><span><span>第一时间为企业级用户提供</span><strong><span><span>权威</span></span></strong><span>漏洞情报和</span></span><strong><span><span>有效</span></span></strong><span><span>解决方案。</span></span></span></p><p><span><span>本文已发布于NCC国家网络安全云社区<a href=\"https://nccsec.cn/security-community\">https://nccsec.cn/security-community</a></span></span></p><p><span><span><span>点击↓</span><strong><span><span>阅读原文</span></span></strong><span>，到</span></span><strong><span><span>ALPHA威胁分析平台</span></span></strong><span><span>订阅更多漏洞信息。</span></span></span></p><p><a href=\"https://ti.qianxin.com/portal/subscription\">阅读原文</a></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=2a0f6831&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzU5NDgxODU1MQ%3D%3D%26mid%3D2247508191%26idx%3D1%26sn%3D81fa4f829d3bd2e4d52b367892eecc42\">跳转微信打开</a></p>","original","zhKind","complete","漏洞","补丁","复现","漏洞分析","PHP","奇安信","https://mp.weixin.qq.com/s?__biz=MzU5NDgxODU1MQ==&mid=2247508191&idx=1&sn=81fa4f829d3bd2e4d52b367892eecc42","奇安信 CERT",{"_95":96,"_97":-5},"changelogVersion","2026-10-01T08:00","release"]
