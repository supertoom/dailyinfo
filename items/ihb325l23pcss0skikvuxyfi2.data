[{"_1":2,"_3":4},"root",{"_5":112},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794616829000,"id","ihb325l23pcss0skikvuxyfi2","title","ConnectWise 调查针对 MSP 的 ScreenConnect 恶意软件活动，47 家组织受影响","originalTitle","Active ScreenConnect attacks breach MSPs, impact dozens of organizations","summary","ConnectWise 正在调查一场针对托管服务提供商（MSP）的活跃恶意软件活动，攻击者利用遭入侵的 ScreenConnect 环境，通过 Run Command 功能向客户设备部署非法远程客户端。","reason","材料追踪了攻击规模、受感染 MSP 与端点数量，并列出 IOC 与处置步骤，可用于核对 ScreenConnect 环境是否遭到入侵。","source",{"_76":111},"links",{"_102":110},"publishedAt","2026-11-11T22:56:21.000Z","discoveredAt","2026-11-11T23:09:21.072Z","timelineAt","category","activity","tags",[79,77,106,107,108,109],"score",83,"selected",true,"channel","news","story",{"_89":90,"_13":91},"x","readingMode","full","author","Lawrence Abrams","body",{"_61":101,"_102":-5,"_103":104,"_105":37},"outline",[92,93],"relatedStories",[88],"topics",[68,69,70,71,72,73],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fuF9lrapn3js","reportCount",2,"additionalSourceCount",1,{"_74":86,"_76":87},{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","malware","name","恶意软件","attack","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","supply-chain","供应链安全","microsoft","Microsoft / 微软",{"_89":90,"_13":91},"publicId","4c4f0d1f-c78b-4aee-8605-fa5f25c7bd8c","SCKit攻击波及48家机构288个端点",{"_11":98,"_95":99,"_97":100},{"_11":94,"_95":96,"_97":65},"sec-2","text","发现现有防御可能遗漏的邮件威胁。","level","sec-1","此前与恶意 ScreenConnect 标识符相关的恶意软件活动",3,"<p><img alt=\"ScreenConnect\" height=\"900\" src=\"/dailyinfo/media/cdb9ac28be55ef0a.jpg\" srcset=\"/dailyinfo/media/1e375e28cfa624c1.jpg 720w, /dailyinfo/media/46683a5e873f3509.jpg 1200w, /dailyinfo/media/cdb9ac28be55ef0a.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>ConnectWise 正在调查一起针对托管服务提供商（MSP）的活跃恶意软件活动。该活动利用已被入侵的 ScreenConnect 环境，向客户设备部署 rogue 远程访问客户端。</p><p>该活动最初由网络安全公司 Huntress 于周三发现。Huntress 表示，目前已识别出六家遭到入侵的 MSP，以及 47 家组织中受影响的 286 个端点，受害者数量仍在增加。</p><p>Huntress 在 Reddit 上发布称：“我们的 SOC 正在处理一起始于今天约 17:47 UTC 的活跃活动，目标是云托管的 ScreenConnect 实例。”</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/2fef11a936f1caee.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>“我们目前正在追踪 6 家遭到入侵的 MSP 和 286 个以上端点，而且这些数字还在上升。ConnectWise 已介入，正与我们共同处理此事。”</p><p>ScreenConnect 是一个远程访问和支持平台，MSP 与 IT 团队使用它远程管理和排查客户设备故障。</p><p>据 Huntress 表示，攻击者正在利用 ScreenConnect 的 Run Command 功能，在受管理的端点上部署 ScreenConnect 客户端，从而在合法 MSP 的 ScreenConnect 环境之外提供远程访问。</p><p>研究人员还警告称，一种可能更加危险的技术是：当 MSP 技术人员与受感染的客户设备发起 ScreenConnect 会话时，攻击者可能会入侵该技术人员的工作站。</p><p>目前尚不清楚这种所报告的反向枢轴技术具体如何运作，包括它是否利用了软件漏洞，或滥用了合法的 ScreenConnect 功能。</p><p>ConnectWise 在向 BleepingComputer 发表的声明中确认，正在调查这些攻击，并敦促合作伙伴避免与可能已遭入侵的设备建立交互式远程会话。</p><p>ConnectWise 告诉 BleepingComputer：“我们已收到关于影响有限数量 ScreenConnect 合作伙伴的恶意活动的报告，目前正在积极调查。”</p><p>“作为预防措施，合作伙伴应避免向疑似已遭入侵的设备开启交互式 ScreenConnect 会话，并使用独立的安全工具进行调查。合作伙伴还应审查账户活动、撤销活动会话、从受信任设备重置凭据，并验证多重身份验证。”</p><p>该公司表示，将通过 ConnectWise Trust Center 提供进一步信息和指导。</p><p>Huntress 尚未确定攻击者如何获得受影响 MSP 环境的访问权限，但称目前的遥测数据指向凭据泄露和被劫持的 MSP 支持会话。</p><p>Huntress 还警告称，攻击者使用的顺序标识符表明，可能还有更多 MSP 此前已遭到入侵。</p><p>Huntress 告诉 BleepingComputer：“攻击者分配的顺序标签表明，其他 MSP 可能更早就已遭到入侵，因此 ScreenConnect 用户即使没有收到警报，也应检查其 Run Command 历史记录。”</p><p>Huntress 还共享了入侵指标（IOC），以帮助组织识别恶意活动，包括 rogue ScreenConnect 客户端 ID 和攻击者使用的基础设施。</p><p>这些指标包括：</p><ul>\n\t<li>\n\t<p><strong>攻击者中继：</strong> <code>185.99.255[.]28</code>（主机名：screen）</p>\n\n\t</li>\n\t<li>\n\t<p><strong>C2 域：</strong> <code>newnewnew.gotdns[.]org</code>、<code>soxnewwork.homedns[.]org</code></p>\n\n\t</li>\n\t<li>\n\t<p><strong>可能的额外 C2：</strong> <code>cdn007-digitaldownloads[.]com</code></p>\n\n\t</li>\n\t<li>\n\t<p><strong>次级 C2：</strong> <code>sc.payproofkit[.]com</code>（<code>155.94.150[.]39</code>，主机名：WIN-FB5CKHMU4E1）</p>\n\n\t</li>\n\t<li>\n\t<p><strong>Stager：</strong> <code>hxxps://ns.mo7sen[.]dev/EadF.php?p=4</code></p>\n\n\t</li>\n\t<li>\n\t<p><strong>Rogue ScreenConnect 客户端 ID：</strong> <code>2588ef5c15954b10</code>、<code>ed630cc2c873b091</code></p>\n\n\t</li>\n\t<li>\n\t<p><strong>安装程序模式：</strong> <code>/Bin/ScreenConnect.ClientSetup.msi?...&amp;c=Exploited&lt;N&gt;</code></p>\n\n\t</li>\n\t<li>\n\t<p><strong>攻击者名称：</strong> <code>Addmin</code></p>\n\n\t</li>\n\t<li>\n\t<p><strong>文件：</strong> <code>Panel-Lateral.ps1</code>、<code>runnew.cmd</code>、<code>ToolboxRelayUploader.exe</code>、<code>Run-Lateral-Full.bat</code></p>\n\n\t</li>\n</ul><p>研究人员敦促 MSP 检查其环境是否存在入侵迹象，并避免与可能已受感染的端点发起交互式 ScreenConnect 会话。</p><p>BleepingComputer 就此次攻击向 Huntress 提出了更多问题；如果收到回应，将更新这篇文章。</p><h3 id=\"sec-1\">此前与恶意 ScreenConnect 标识符相关的恶意软件活动</h3><p>BleepingComputer 发现了一个更早的恶意批处理脚本，其中引用了 Huntress 列出的一个恶意 ScreenConnect 客户端 ID，表明该 ID 在此次攻击被披露数个月前就已用于恶意活动。</p><p>该脚本名为 <code>SSA-2026-STATEMENT-15518787.bat</code> [<a href=\"https://www.virustotal.com/gui/file/60142ea5daebbf94a2dec4009f673d9822a2fd796ac55478be1edea3136ef4bb/\">VirusTotal</a>]，似乎冒充美国社会保障局声明，并已于 July 25, 2026 首次上传至 VirusTotal。</p><p>该批处理文件试图添加 Microsoft Defender 排除项，并通过 Windows Startup 文件夹和 Run 注册表项建立持久化。</p><p>随后，它会联系 amexsafekeyupdate.com，以获取两个独立安装程序的安装命令。</p><p>与该样本相关的 VirusTotal 沙箱活动包括从 <code>cdn007-digitaldownloads[.]com</code> 和 <code>cyberrexdesign.screenconnect[.]com</code> 下载 ScreenConnect MSI 安装程序；Huntress 将 digitaldownloads[.]com 列为潜在 IOC。</p><figure><img alt=\"DigitalDownloads ScreenConnect portal\" height=\"600\" src=\"/dailyinfo/media/206b83ab1e1f090d.jpg\" srcset=\"/dailyinfo/media/b68801ab6bdc8448.jpg 720w, /dailyinfo/media/282c0c475a94f84b.jpg 1200w, /dailyinfo/media/206b83ab1e1f090d.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"875\">\n<figcaption><strong>DigitalDownloads ScreenConnect 门户</strong><br>\n<em>来源：BleepingComputer</em></figcaption>\n</figure><p>启动第二个安装程序后，该脚本会使用 PowerShell 在正在运行的进程和 Windows 服务中搜索 ed630cc2c873b091，这是 Huntress 识别出的恶意 ScreenConnect 客户端 ID 之一。</p><p>如果找到该标识符，脚本便认为安装成功，并通过 Telegram 向攻击者发送通知。</p><p>这个更早的脚本似乎是为另一种分发活动设计的，其以社会保障局为主题的文件名表明它可能被用于网络钓鱼攻击。</p><p>目前尚不清楚 July 的活动与当前针对 MSP 的攻击是否属于同一波活动。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/c132e890d608eb09.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-2\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体可分析邮件意图、上下文和行为，揭示网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>通过 14 天只读扫描检查 Microsoft 365 或 Google Workspace 中有哪些威胁正在绕过防御，无需进行 MX 更改。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始免费扫描您的邮件安全。</a>\n    </p>","original","zhKind","translation","complete","后门","数据窃取","供应链","Microsoft","https://www.bleepingcomputer.com/news/security/active-screenconnect-attacks-breach-msps-impact-dozens-of-organizations/","BleepingComputer",{"_113":114,"_115":-5},"changelogVersion","2026-10-01T08:00","release"]
