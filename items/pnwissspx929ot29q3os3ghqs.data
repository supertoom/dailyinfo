[{"_1":2,"_3":4},"root",{"_5":99},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1795826448000,"id","pnwissspx929ot29q3os3ghqs","title","Google 要求 Workspace AI agent 自 2027 年 2 月起经 MCP 或 CLI 接入","originalTitle","Google mandates MCP or CLI access for Workspace AI agents starting February 2027","summary","Google 宣布 Workspace AI Tools Addendum，AI agent 必须经 Google Workspace MCP servers 或 CLI 连接产品服务，技术强制执行时间为 2027 年 2 月 1 日，常规应用仍可沿用现有 REST API。","reason","梳理了 Workspace 与 Cloud 两侧的强制接口、独立身份、审批与注入防护，便于提前评估自建 agent 接入路径的合规改动。","source",{"_65":98},"links",{"_89":97},"publishedAt","2026-11-26T05:30:05.000Z","discoveredAt","2026-11-26T06:11:18.981Z","timelineAt","category","policy","tags",[93,94,68,95,70,96],"score",72,"selected",true,"channel","news","story","x","readingMode","full","author","Anamarija Pogorelec","body",{"_59":88,"_89":-5,"_90":91,"_92":37},"outline",[73,74,75,76],"relatedStories",[],"topics",[60,61,62,63],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_64":71,"_65":72},{"_64":69,"_65":70},{"_64":67,"_65":68},{"_64":31,"_65":66},"slug","name","政策法规","ai-security","AI 安全","identity","身份与访问","google","Google / 谷歌",{"_11":86,"_78":87,"_80":81},{"_11":84,"_78":85,"_80":81},{"_11":82,"_78":83,"_80":81},{"_11":77,"_78":79,"_80":81},"sec-4","text","企业数据处理的新限制","level",3,"sec-3","提示注入和未授权数据访问","sec-2","专用代理身份和人工审批","sec-1","Google 强制实施新的 API 访问规则","<p>Google 已宣布在 <a href=\"https://www.helpnetsecurity.com/2026/04/22/google-workspace-intelligence-feature/\">Google Workspace</a> 和 Google Cloud 中推出多项安全控制措施，以应对自主 AI 代理访问企业数据、执行任务以及与云基础设施交互所带来的风险。</p><p><img src=\"/dailyinfo/media/0ba2b6ed0453500d.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Google AI agent security\" title=\"Google\"></p><p>这些措施包括专用代理身份、针对敏感操作的人工审批控制、提示注入检测，以及对第三方 AI 工具访问和处理组织数据的方式施加限制。</p><p>该公司还宣布其 Workspace Model Context Protocol (MCP) 服务器和命令行界面 (CLI) 正式全面可用，并对连接其生产力服务的 AI 代理提出新要求。</p><p>“策略检查、数据边界以及人工确认必须位于请求路径中，”<a href=\"https://www.linkedin.com/in/cthota/\">Chandu Thota</a>（Google Workspace 工程副总裁）和 <a href=\"https://www.linkedin.com/in/brad-calder-b964537/\">Brad Calder</a>（Google Cloud Platform 与 SRE 总裁）<a href=\"https://cloud.google.com/blog/products/identity-security/deploying-agents-safely-in-your-enterprise\">写道</a>。</p><h3 id=\"sec-1\">Google 强制实施新的 API 访问规则</h3><p>根据新的 Workspace AI Tools 附录，<a href=\"https://www.helpnetsecurity.com/2026/11/17/palo-alto-networks-ai-cloud-security-risks-report/\">AI 代理</a> 必须通过 Google 的 Workspace MCP 服务器或 CLI 连接。技术层面的强制执行计划于 2027 年 2 月 1 日开始，而常规应用仍可继续使用现有的 REST API。</p><p>MCP 服务器支持 Gmail、Google Drive、Docs、Sheets、Slides、Calendar、Chat 和 Tasks，并计划支持 Google Keep。代理请求将根据组织权限、DLP 策略和分类标签进行检查。</p><p>Workspace CLI 通过限定范围的 OAuth 身份验证，支持本地部署的代理和基于终端的自动化。</p><h3 id=\"sec-2\">专用代理身份和人工审批</h3><p>连接至 Workspace 的外部 AI 代理必须使用专用 OAuth 客户端 ID，使管理员和用户能够区分 AI 代理与常规应用。</p><p>Google 正在实施最小权限 OAuth 范围和使用配额，以限制代理权限和资源消耗。限时批准计划在未来版本中推出，而与配额相关的计费计划于 2027 年 4 月 1 日开始。</p><p>在 Google Cloud 中，代理通过 Agent Registry 获得独立身份，无需依赖共享密钥或长期有效的密钥。其访问权限和资源消耗由身份和访问管理 (IAM) 策略及配额控制。</p><p>Workspace MCP 服务器和 CLI 会对敏感操作强制实施用户确认，例如发送电子邮件、修改 Drive 共享权限或执行批量编辑。</p><p>Google Cloud 客户可以配置策略，要求在代理访问敏感 Cloud Storage 存储桶、变更 IAM 权限或修改生产基础设施之前进行 <a href=\"https://www.helpnetsecurity.com/2026/03/13/mfa-security-limitations-video/\">MFA</a> 或人工审批。</p><p>Workspace 管理员可以通过管理控制台审计代理活动并撤销访问权限。Google 计划将这些功能扩展至用户。</p><p>Google Cloud 客户可以通过 Security Command Center、Agent Observability、Cloud Audit Logs 和 Wiz 监控代理行为。据 Google 表示，撤销 Cloud Agent Identity 或 OAuth 授权会立即终止相关访问。</p><h3 id=\"sec-3\">提示注入和未授权数据访问</h3><p>Google Cloud Agent Gateway 为 LLM、MCP 和 Agent2Agent (A2A) 通信引入协议级安全控制。</p><p>该网关根据 Agent Registry 验证代理身份、执行 IAM 策略、通过默认拒绝规则限制出站连接，并集成 Google 的 Model Armor 服务，以检测请求中的提示注入。</p><p>Google 计划引入额外的访问限制，使 Workspace 管理员和用户能够阻止外部 AI 代理获取指定的电子邮件、文件和文件夹。这些限制将建立在现有的 Workspace DLP 和客户端加密功能之上。</p><h3 id=\"sec-4\">企业数据处理的新限制</h3><p>Workspace AI 工具附录禁止永久存储原始 Workspace 数据、将数据用于模型训练以及未经授权的 API 抓取。</p><p>该附录还规定了 Google 技术信息的 30 天保留期限。Google 技术信息包括向量嵌入、记忆索引、用户画像和组织图，但不包括用户数据。</p><p>AI 工具提供商必须遵守数据保留和删除要求，包括在集成被断开或访问权限被撤销时删除用户数据及相关技术信息。</p><p>Google 建议 Workspace 管理员审查已连接的应用和代理、配置 DLP 策略并监控 OAuth 活动日志。开发人员应将代理集成迁移到受支持的接口，并在 2027 年 2 月强制执行截止日期之前实施用户确认和提示注入防护机制。</p>","original","zhKind","translation","complete","政策","治理","Agent 安全","Google","https://www.helpnetsecurity.com/2026/11/26/google-ai-agent-security-requirements/","Help Net Security",{"_100":101,"_102":-5},"changelogVersion","2026-10-01T08:00","release"]
