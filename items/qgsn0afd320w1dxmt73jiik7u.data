[{"_1":2,"_3":4},"root",{"_5":95},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1794530490000,"id","qgsn0afd320w1dxmt73jiik7u","title","Microsoft 365 多区域服务中断影响 Outlook、Exchange Online 和 Teams","originalTitle","Microsoft 365 Outage Disrupts Outlook, Exchange Online and Teams","summary","Microsoft 365 周四发生多区域大范围服务中断，影响业务邮件、Exchange Online、Teams、SharePoint Online、Microsoft 365 Copilot 和 Defender XDR，Google Workspace 用户也报告通过 Outlook 客户端访问邮箱受阻。","reason","source",{"_72":94},"links",{"_61":93},"publishedAt","2026-11-12T20:55:30.000Z","discoveredAt","2026-11-12T21:40:28.885Z","timelineAt","category","activity","tags",[89,90,91,92],"score",55,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","readingMode","full","author","SecurityWeek News","body",{"_85":-5,"_61":86,"_87":-5,"_88":36},"outline",[80],"relatedStories",[76],"topics",[68,69],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fTqlpso7s9gg","reportCount",2,"additionalSourceCount",1,{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","cloud-native","name","云与原生","microsoft","Microsoft / 微软",{"_77":78,"_13":79},"publicId","d0fbf5e0-7524-44ac-ae11-b93399172446","微软365多区域服务中断",{"_11":81,"_82":83,"_84":65},"sec-1","text","Was the Microsoft outage caused by a cyberattack?","level","zh","<p><strong>Microsoft 365 suffered a widespread outage Thursday, disrupting access to business email and other cloud services across multiple regions. Microsoft initially reported that users in the Americas were having trouble connecting to Exchange Online mailboxes. It later identified potential disruption to Teams, SharePoint Online, Microsoft 365 Copilot and Defender XDR.</strong>\n\n\n\n</p><p>Some users of Google Workspace (formerly G Suite) also reported trouble accessing their Google-hosted email through Outlook desktop and mobile email clients. \n\n\n\n</p><p>Microsoft traced the increased load on its infrastructure to a large number of servers becoming unavailable, leaving the remaining systems to handle the traffic. The <a href=\"https://status.cloud.microsoft/m365/referrer=serviceStatusRedirect\">company said</a> overall traffic had not increased. \n\n\n\n</p><p>In an update just before 3 p.m. ET, Microsoft said affected servers were failing automated health checks and that it was testing a workaround that bypasses the component responsible for processing those checks. The company said it was also investigating elevated processor usage on affected servers.\n\n\n\n</p><h2 id=\"sec-1\">Was the Microsoft outage caused by a cyberattack?</h2><p>At the time of publishing, Microsoft is still investigating what triggered the failures and has disclosed no evidence of a cyberattack.\n\n\n\n</p><p>The company has yet to explain why the health checks failed or why processor usage rose on affected servers. Its service advisories did not report evidence of malicious activity.</p><p><span>Advertisement. Scroll to continue reading.</span></p><p>The disruption came two days after Microsoft released its November Patch Tuesday updates, which <a href=\"https://www.securityweek.com/exploited-outlook-zero-day-among-1094-flaws-patched-by-microsoft/\">addressed 1,094 vulnerabilities</a> across its products. They included <strong>CVE-2026-124194</strong>, an Outlook spoofing flaw Microsoft says attackers have exploited. The flaw can expose a user’s authentication material if the user opens a specially crafted file in an affected Outlook client. Microsoft’s service advisories have not linked the vulnerability to the Exchange Online outage.\n\n\n\n</p><p>Microsoft is tracking the Exchange Online disruption under&nbsp;<strong><a href=\"https://x.com/MSFT365Status/status/2120941584220827979\">EX1550543</a></strong>&nbsp;and the broader Microsoft 365 incident under&nbsp;<strong><a href=\"https://x.com/MSFT365Status/status/2120948642991182117\">MO1550821</a></strong>&nbsp;in the Microsoft 365 admin center. As of just before 3 p.m. ET, both incidents were listed as service degradations.\n      </p>","zhKind","complete","其他","Microsoft","云原生","Google","https://www.securityweek.com/microsoft-365-outage-disrupts-outlook-exchange-online-and-teams/","SecurityWeek",{"_96":97,"_98":-5},"changelogVersion","2026-10-01T08:00","release"]
