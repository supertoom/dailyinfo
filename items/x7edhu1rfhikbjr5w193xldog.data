[{"_1":2,"_3":4},"root",{"_5":92},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794444100000,"id","x7edhu1rfhikbjr5w193xldog","title","Vates VMS 披露 Xen Orchestra 认证绕过漏洞 VSA-2026-062 已被利用","originalTitle","Hackers Exploit Critical Xen Orchestra Auth Bypass Flaw to Gain Admin Access","summary","Vates VMS 表示，Xen Orchestra 的认证绕过漏洞 VSA-2026-062 已在真实攻击中被利用，攻击者通过特制 Cookie 获取 Admin 权限，最终可在托管池上执行任意代码并以 root 接管 XCP-ng 节点。","reason","文章披露了利用链、攻击基础设施和多项入侵指标，防守方可用这些信息排查并处置。","source",{"_73":91},"links",{"_83":90},"publishedAt","2026-11-10T18:12:21.000Z","discoveredAt","2026-11-10T19:33:35.692Z","timelineAt","category","vuln","tags",[76,87,88,89],"score",85,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_61":82,"_83":-5,"_84":85,"_86":37},"outline",[],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","ftzf92C6BFf0","reportCount",3,"additionalSourceCount",2,{"_71":31,"_73":77},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","research","name","技术研究","exploited","在野利用","漏洞披露",{"_79":80,"_13":81},"publicId","02559d08-0e55-4bf8-8513-d59f4b9a82f9","Xen Orchestra认证绕过漏洞已遭利用","<p><span><i></i><span>Ravie Lakshmanan</span><i></i><span>2026年11月10日</span></span><span>漏洞 / 网络攻击</span></p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgMH_u7t-U3KIejAItsfC_js20xJgxT2ITYLsR0DAxzfcwDvPrzBHkpZlDuALWPnACOoknX2IALwHIUxIzfhbA24M7e8cGWTZpBMWqpX-wn6xqe8_U3fAtnR-9RsRdFHMCjvNnBsMXrEUKhVYS5bbTGL3B50UMO0aydtHIomY89s2iDAQMq0jXJJ3vh4Nvi/s1600/XEN-attack.jpg\"><img alt=\"\" src=\"/dailyinfo/media/29c5660921c3f416.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>法国软件公司 Vates VMS <a href=\"https://docs.vates.tech/security-advisories/advisories/2026/vates-sa-2026-062/\">警告</a>称，Xen Orchestra 存在一个严重安全漏洞，并表示该漏洞目前正在遭到实际利用。</p><p>这个身份验证绕过漏洞尚未分配 CVE 编号，追踪编号为 <strong>VSA-2026-062</strong>。</p><p>Vates VMS 在一份警报中表示：“REST cookie 解析会将 authenticationToken=j:%7B%7D 转换为 {}。”“REST 身份验证会将该对象传递给 XO 令牌提供程序，而不要求其为字符串。”</p><p>“令牌集合将 {} 视为未经筛选的查询条件，并返回其中的第一个令牌；如果该令牌未过期，提供程序便以该令牌的所有者身份完成身份验证。随后，已通过身份验证的 /rest/v0/users/me/authentication_tokens 路由会返回可复用的登录令牌 ID。”</p><p>换句话说，该漏洞可能允许攻击者通过发送特制 cookie 绕过身份验证，并以“Admin”权限执行任意操作，最终导致在托管资源池上执行任意代码，并以 root 权限完全接管 XCP-ng 节点。</p><p>Vates VMS 表示，正看到一个威胁行为者利用以下 IP 地址和 TOR 域名积极利用该漏洞——</p><ul>\n  <li><a href=\"https://www.virustotal.com/gui/ip-address/91.211.251.112/detection\">91.211.251[.]112:8001</a>，该地址在 VirusTotal 上已被标记为 RedLine Stealer 命令与控制（C2）服务器</li>\n  <li>ustar3rqxgnskzgnwkgpofgtvxevm6cx3lxdbwt4mndtveqyaohid[.]onion:3333</li>\n</ul><p>尚不清楚该活动始于何时，也不清楚该漏洞是否曾作为零日漏洞遭到利用。&nbsp;</p><p>其他失陷指标如下——</p><ul>\n  <li>包含 authenticationToken=j:%7B%7D 或 authenticationToken=j:{} 的 HTTP 请求</li>\n  <li>一台名为 pivot2 的正在运行的虚拟机</li>\n  <li>使用“hvm_serial: file”参数配置的虚拟机</li>\n  <li>名为 /etc/cron.d/zz-ustar2、/etc/cron.d/zz-ustar、/.ustar5 和 /.ustar6 的可疑文件</li>\n</ul><p>该问题已在稳定版和最新版的 Xen Orchestra 6.9.1 与 6.10.0 中修复，同时也已在 xo-server 5.211.2 与 5.213.1 版本中修复。如果无法立即修补，建议采取以下缓解措施——</p><ul>\n  <li>避免将 Xen Orchestra 实例暴露在互联网上</li>\n  <li>封禁与恶意活动相关的 IP 地址和域名</li>\n  <li>在 Web 应用防火墙（WAF）或反向代理中阻止空令牌</li>\n  <li>如果检测到失陷指标，请轮换 Vates VMS 中的所有密码和密钥</li>\n</ul><p>Filip Magic（@mad31k）和 TDC NET Security 的 Christoffer Olsen 因发现并报告该漏洞而获得致谢。</p><p>觉得这篇文章有意思？请在 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a> 上关注我们，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","漏洞利用","补丁","漏洞分析","https://thehackernews.com/2026/11/hackers-exploit-critical-xen-orchestra.html","The Hacker News",{"_93":94,"_95":-5},"changelogVersion","2026-10-01T08:00","release"]
