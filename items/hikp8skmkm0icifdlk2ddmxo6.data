[{"_1":2,"_3":4},"root",{"_5":107},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795480835000,"id","hikp8skmkm0icifdlk2ddmxo6","title","n0n 勒索 Qubole 后声称泄露 Chase、Visa 和 Mastercard 客户数据","originalTitle","Vendor data breach exposes Chase, Visa, Mastercard customer info","summary","n0n 勒索组织声称攻击云数据分析公司 Qubole，并在 2026 年 10 月 14 日至 26 日间利用已泄露的 Qubole 凭据，经客户配置的 IAM roles 入侵 AWS 环境，窃取 53.9 GB、30,743 个文件，并声称掌握近 1 PB 客户网络数据。","reason","文章串联第三方服务商遭勒索攻击与支付机构数据暴露，并区分营销信息泄露与支付网络未受影响，便于判断实际风险边界。","source",{"_74":106},"links",{"_96":105},"publishedAt","2026-11-20T15:58:06.000Z","discoveredAt","2026-11-20T16:00:29.101Z","timelineAt","category","activity","tags",[75,100,101,102,103,104],"score",80,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Bill Toulas","body",{"_61":95,"_96":-5,"_97":98,"_99":37},"outline",[86,87],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fzcsfTmi6XVw","reportCount",1,"additionalSourceCount",0,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","attack","name","攻击活动","ransomware","勒索软件","cloud-native","云与原生","supply-chain","供应链安全",{"_83":84,"_13":85},"publicId","c89882b9-875a-45bb-a875-5c08c593cc82","Qubole凭据泄露引发客户数据窃取",{"_11":93,"_89":94,"_91":92},{"_11":88,"_89":90,"_91":92},"sec-2","text","发现您现有防御可能遗漏的邮件威胁。","level",2,"sec-1","n0n 勒索软件声称此次攻击系其所为","<p><img alt=\"hand sifting data\" height=\"900\" src=\"/dailyinfo/media/f383506046e1d55c.jpg\" srcset=\"/dailyinfo/media/0633dbd7d1d77908.jpg 720w, /dailyinfo/media/fbbeb484dac9c736.jpg 1200w, /dailyinfo/media/f383506046e1d55c.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>摩根大通（J.P. Morgan Chase）警告称其遭遇数据泄露，起因是一家第三方服务提供商遭到网络攻击，导致客户个人信息和营销数据被暴露。</p><p>该银行表示，此次事件未影响其服务运营，并且与本周早些时候发生的服务中断无关。</p><p>\"我们已了解到，为本公司提供服务的第三方是此次网络攻击的目标，\"该公司的<a href=\"http://x.com/jpmorgan/status/2123408240104853510\">公告</a>在 X 上写道。</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/ec0400265c732eea.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>\"根据迄今为止的调查，我们认为攻击者访问了这些供应商持有的某些营销数据，其中可能包含部分客户姓名和电子邮箱地址。\"</p><p><img alt=\"Tweet\" height=\"430\" src=\"/dailyinfo/media/ce3cba630935e9a9.webp\" loading=\"lazy\" decoding=\"async\" width=\"583\"></p><p>摩根大通银行是美国按资产规模计最大的银行，截至 2026 年 6 月资产约为 4.1 万亿美元。其消费者银行业务部门报告约有 7800 万活跃数字客户。</p><p>Visa 和 Mastercard 分别在向媒体的声明中确认了第三方事件，尽管两家公司尚未确认对客户造成了任何影响。</p><p>这两家公司是全球主要支付网络运营商，业务遍及 200 多个国家，每年处理的交易额达数万亿美元。</p><p>\"Visa 已知悉相关说法。这些说法与亚太地区一家第三方服务提供商发生的事件有关，\"一位 Visa 发言人告诉 BleepingComputer。</p><p>\"Visa 的系统未涉其中，也未受到影响。卡号等支付数据未受影响。这与本周各行业发生的任何系统中断无关。\"</p><p>Mastercard 告诉 BleepingComputer，他们\"最近获知一家第三方供应商发生的事件，导致一小部分参加特定权益计划的持卡人的有限数量电子邮箱地址被暴露——属于非支付信息。\"</p><p>Mastercard 的发言人保证称：\"Mastercard 支付网络以及人们使用其卡片的能力未受到任何影响。\"</p><p>\"目前，暴露范围已被遏制，我们的团队正与该供应商合作，按需为受影响的持卡人提供支持。\"</p><h2 id=\"sec-1\">n0n 勒索软件声称此次攻击系其所为</h2><p>2026 年 11 月 11 日，n0n 勒索软件组织声称对 Qubole 发起攻击，Qubole 被怀疑是支付服务所使用的第三方提供商。</p><p>Qubole 是一家隶属于 Idera 的云数据分析公司，用于云数据分析、自动化处理、实时分析和报告生成。</p><p>2026 年 10 月 14 日至 26 日期间，<a href=\"https://www.bleepingcomputer.com/news/security/hackers-exploit-trusted-aws-access-to-breach-multiple-cloud-environments/\">黑客利用被攻破的 Qubole 凭证</a>，通过这些企业此前配置用于授予 Qubole 访问权限的 IAM 角色，访问了客户的 AWS 环境。</p><p>据称，他们直接从 Qubole 窃取了 30,743 个文件、共 53.9 GB 的数据，包括客户合同、定价记录、员工和试用用户信息，以及生产数据。</p><p>此外，他们声称掌握来自 Qubole 客户网络的近一拍字节数据。</p><p>2026 年 11 月 16 日，n0n 在其勒索站点上泄露了所声称的 Chase、Visa 和 Mastercard 数据。</p><figure><img src=\"/dailyinfo/media/85b3c8dedb40cf78.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"Stolen data published on n0n extortion page\" height=\"600\" width=\"709\">\n<figcaption><strong>被盗数据发布在 n0n 勒索页面</strong><br>\n<em>来源：BleepingComputer</em></figcaption>\n</figure><p>该黑客组织声称，在 Sentra 和 Wiz 公开披露此次攻击之前，他们曾联系 Qubole 以及部分受影响公司，但其勒索要求被置之不理。</p><p>BleepingComputer 就威胁行为者的指控联系 Qubole 寻求置评，但截至发稿我们尚未收到回应。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/af2e1e4209b93434.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-2\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现您现有防御可能遗漏的邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体会分析邮件意图、上下文和行为，以发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>通过为期 14 天的只读扫描查看 Microsoft 365 或 Google Workspace 中有哪些邮件得以通过，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始免费的电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","数据泄露","勒索","供应链","云原生","AWS","https://www.bleepingcomputer.com/news/security/vendor-data-breach-exposes-chase-visa-mastercard-customer-info/","BleepingComputer",{"_108":109,"_110":-5},"changelogVersion","2026-10-01T08:00","release"]
