[{"_1":2,"_3":4},"root",{"_5":112},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":37,"_59":60},"expiresAt",1794357640000,"id","nm0phlll31jsdjzttnirj27id","title","Google 警告 LLMJacking 致部分企业累计云费用达 $1m","originalTitle","LLMJacking is Costing Some Businesses Up to $1m, Warns Google","summary","Google Mandiant 称攻击者正通过 LLM API keys、暴露或窃取的云身份令牌及活动会话令牌进入后端模型资源，利用 LLM 路由软件漏洞提权并开展内部侦察，再通过 token 代理、自动模型流式调用和 GPU 资源配置牟利。","reason","材料梳理了 LLMJacking 的入口、权限提升、云凭据窃取和资源转售链条，并给出实际费用损失，适合评估 AI 基础设施暴露风险。","source",{"_76":111},"links",{"_101":110},"publishedAt","2026-11-03T10:45:00.000Z","discoveredAt","2026-11-03T11:06:19.987Z","timelineAt","category","activity","tags",[79,105,77,106,107,108,109],"score",71,"selected",true,"channel","news","story",{"_91":92,"_13":93},"x","readingMode","full","author","body",{"_60":100,"_101":-5,"_102":103,"_104":37},"outline",[94],"relatedStories",[90],"topics",[67,68,69,70,71,72,73],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","fePIepdqSY2E","reportCount",1,"additionalSourceCount",0,{"_74":88,"_76":89},{"_74":86,"_76":87},{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","ai-security","name","AI 安全","attack","攻击活动","ai-agent","AI Agent 安全","black-market","数据窃取与黑产","identity","身份与访问","cloud-native","云与原生","google","Google / 谷歌",{"_91":92,"_13":93},"publicId","e6d331ba-16da-4c29-89e6-7c47985f90f6","Mandiant披露多起LLMJacking云账单事件",{"_11":95,"_96":97,"_98":99},"sec-1","text","长期摇钱树","level",2,"<p><img src=\"/dailyinfo/media/58c9f9473d1ec00a.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Photo of Phil Muncaster\"></p><p>\n\tGoogle 已警告称，网络犯罪分子出售大型语言模型（LLM）访问权限，对 AI 基础设施构成的enterprise威胁正在不断增长。</p><p>\n\t这家科技巨头的 Mandiant 业务表示，今年以来已应对多起事件，涉及金融服务、零售、技术和交通运输行业，其中发现了“LLMJacking”技术。</p><p>\n\t“与加密挖劫相关的渐进式资源消耗不同，LLMJacking 可在数小时内造成欺诈性云费用大幅飙升，”它警告道。</p><p>\n\t“在单起事件中，我们观察到与资源消耗相关的欺诈费用一天内就超过 100,000 美元，一些组织的累计费用在访问权限被撤销前达到 100 万美元。”</p><p><a href=\"https://www.infosecurity-magazine.com/news/llmjacking-opensource-surge-2024/\"><em>进一步了解 LLMJacking：2024 年云攻击中 LLMjacking 和开源工具滥用激增。</em></a></p><p>\n\t这项技术本身并不新鲜，但 LLMJacking 的生态系统似乎正在走向成熟。</p><p>\n\t威胁行为者绕过前端聊天机器人，将后端模型资源作为目标，通常通过 LLM API 密钥，或暴露、被窃取的云身份令牌，包括 IAM 凭据、Service Account 密钥、GitHub Personal Access Token 和活动会话令牌。</p><p>\n\t在取得这一初始立足点后，威胁行为者提升权限并开展内部侦察，以识别目标和更多云凭据。</p><p>\n\t报告解释道，除了以这种方式滥用和提升权限外，他们还可能针对 LLM 路由软件中的漏洞来提升权限。</p><p>\n\t“LLMJacking 的最终目标是对基础模型进行变现和资源劫持，行为者通过令牌代理、自动化模型流式传输和 GPU 硬件配置来实现这一点，”它补充道。</p><h2 id=\"sec-1\">\n\t长期摇钱树</h2><p>\n\tGoogle 已经看到“一个多样化的”以牟利为动机的网络犯罪团伙在北美、南美和亚太地区开展 LLMJacking。它还开始注意到，专注于初始访问和负责下游基础设施变现的威胁行为者之间出现了“分工”，后者被称为“LLM Mixers”。</p><p>\n\t这些路由网关为犯罪客户“代理、聚合并转售”LLM 访问权限。</p><p>\n\t这项业务利润如此丰厚，以至于 Google 预计网络犯罪分子今后将优先考虑 LLMJacking，而非加密挖劫。</p><p>\n\t“随着企业将更高层级的模型和智能体工作流集成到生产环境中，网络犯罪分子很可能会改进自动化侦察，以针对暴露的 API 令牌，并利用模型路由中间件中的漏洞，”<a href=\"https://cloud.google.com/blog/topics/threat-intelligence/llmjacking-monetizing-compromised-cloud-models?utm_source=chatgpt.com\">它总结道。</a></p><p>\n\t“这种运营专业化将维持一个不断增长的非法转售市场，使威胁行为者能够迅速吸走企业配额，同时将计费成本转嫁给受害者，直到入侵被检测出来。”</p>","original","zhKind","translation","complete","黑产","大模型","云原生","凭据","Google","https://www.infosecurity-magazine.com/news/llmjacking-cost-business-1m-warns/","Infosecurity Magazine",{"_113":114,"_115":-5},"changelogVersion","2026-10-01T08:00","release"]
