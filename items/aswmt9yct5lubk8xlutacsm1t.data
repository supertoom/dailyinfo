[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1794616827000,"id","aswmt9yct5lubk8xlutacsm1t","title","node-forge 修复 asn1.fromDer() 嵌套 BIT STRING 资源耗尽漏洞，CVSS 3.1 为 7.5","originalTitle","Forge: ASN.1 resource exhaustion via BIT STRING decoding in asn1.fromDer","summary","node-forge 的 asn1.fromDer() 存在资源耗尽漏洞，攻击者可提交小型 DER 或 PEM 结构，利用嵌套 BIT STRING 绕过 maxDepth 递归限制，消耗过多 CPU 和内存并导致 Node.js 进程拒绝服务。","reason","公告给出可触发资源耗尽的嵌套 BIT STRING 结构、内存与处理时间数据，并说明限制绕过机制和版本修复方案，便于评估 DoS 风险与升级必要性。","source",{"_70":84},"links",{"_60":83},"publishedAt","2026-11-10T15:57:41.000Z","discoveredAt","2026-11-10T16:52:20.668Z","timelineAt","category","vuln","tags",[78,79,80,81,82],"score",72,"selected",true,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[67,68],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","ff69mjcowyII","reportCount",1,"additionalSourceCount",0,{"_69":72,"_70":73},{"_69":31,"_70":71},"slug","name","漏洞披露","crypto","密码学",{"_75":76,"_13":77},"publicId","2652df1a-56bc-4d12-a186-f6ae46fc3bc1","node-forge修复ASN.1资源耗尽漏洞","漏洞","补丁","复现","加密","Node.js","https://github.com/advisories/GHSA-rhr8-3pm8-cq29","GitHub 安全公告",{"_86":87,"_88":-5},"changelogVersion","2026-10-01T08:00","release"]
