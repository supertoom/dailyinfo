[{"_1":2,"_3":4},"root",{"_5":88},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795221630000,"id","b5wzzrfgiaei8s2xexnsnqx5s","title","Chrome Dev 桌面版更新至 160.0.8171.0，覆盖 Windows、Mac 和 Linux","originalTitle","Chrome Dev for Desktop Update","summary","Chrome Dev channel 已更新至 160.0.8171.0，面向 Windows、Mac 和 Linux 平台提供部分变更记录。开发者可通过 Git log 查看变更详情，并可提交 bug 或前往社区帮助论坛反馈新问题、寻求协助。","reason","source",{"_72":87},"links",{"_61":86},"publishedAt","2026-11-20T17:58:33.217Z","discoveredAt","2026-11-20T18:30:38.146Z","timelineAt","category","blue-team","tags",[84,85,73],"score",5,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","readingMode","full","author","Ben Mason","body",{"_80":-5,"_61":81,"_82":-5,"_83":36},"outline",[],"relatedStories",[76],"topics",[68,69],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fST7M7-PGsE0","reportCount",1,"additionalSourceCount",0,{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","browser","name","浏览器","google","Google / 谷歌",{"_77":78,"_13":79},"publicId","65dbca1c-bde4-4b5c-9334-bc710c8b5a9a","Chrome Dev 桌面版更新至160.0.8171.0","zh","<p>The Dev channel has been updated to 160.0.8171.0 for Windows, Mac and Linux.</p><p>A partial list of changes is available in the <a href=\"https://chromium.googlesource.com/chromium/src/+log/160.0.8157.0..160.0.8171.0?pretty=fuller&amp;n=10000\">Git log</a>. Interested in <a href=\"https://www.chromium.org/getting-involved/dev-channel/\">switching</a> release channels? Find out <a href=\"https://www.chromium.org/getting-involved/dev-channel/\">how</a>. If you find a new issue, please let us know by <a href=\"https://crbug.com/\">filing a bug</a>. The <a href=\"https://productforums.google.com/forum/#!forum/chrome\">community help forum</a> is also a great place to reach out for help or learn about common issues.</p><p>Chrome Release Team<br><a href=\"https://www.google.com/chrome\">Google Chrome</a></p>","zhKind","complete","版本更新","Google","http://chromereleases.googleblog.com/2026/11/chrome-dev-for-desktop-update_0667948876.html","Chrome Releases",{"_89":90,"_91":-5},"changelogVersion","2026-10-01T08:00","release"]
