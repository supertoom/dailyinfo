[{"_1":2,"_3":4},"root",{"_5":93},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795480836000,"id","ij1t9r2o1yq64nrx86tf5fp89","title","Vite 开发服务器虚拟模块注入远程代码执行漏洞 SF_2026_47139 修复公告","originalTitle","【漏洞通告】Vite 开发服务器虚拟模块注入远程代码执行漏洞(SF_2026_47139)","summary","Vite 开发服务器虚拟模块标识符处理存在注入缺陷，攻击者可在无需认证和用户交互的条件下远程执行代码并读取任意文件。","reason","文章复现了单请求远程代码执行链路，并给出受影响分支、修复版本及网络暴露条件，便于开发者评估开发服务器风险。","source",{"_73":92},"links",{"_83":91},"publishedAt","2026-11-19T09:51:00.000Z","discoveredAt","2026-11-19T18:01:21.169Z","timelineAt","category","vuln","tags",[86,87,88,89,90,77],"score",75,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","body",{"_61":82,"_83":-5,"_84":83,"_85":37},"outline",[],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fUbF1JwD11fs","reportCount",1,"additionalSourceCount",0,{"_71":76,"_73":77},{"_71":31,"_73":75},{"_71":72,"_73":74},"slug","research","name","技术研究","漏洞披露","sangfor","深信服",{"_79":80,"_13":81},"publicId","aab0b138-dd68-4d43-984d-4069e6e4b83a","Vite开发服务器RCE漏洞已披露并修复","<p><span>深瞳漏洞实验室</span> <span>2026-11-19 17:51</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/906693ab016fe37b.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>2026年11月19日，深瞳漏洞实验室监测到一则Vite组件存在代码执行漏洞的信息，漏洞威胁等级：高危。</p><p><img src=\"/dailyinfo/media/478dfd213b118c4a.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span><span>漏洞名称：</span></span></strong></p><p><span>Vite 开发服务器虚拟模块注入远程代码执行漏洞(SF_2026_47139)</span></p><p><strong><span><span>组件名称：</span></span></strong></p><p><span>Vite</span></p><p><span><strong><span>影响范围：</span></strong></span></p><p><span>Vite 4.x - 6.x：&gt;= 4.0.0 且 &lt;= 6.4.5</span></p><p><span>Vite 7.x：&gt;= 7.0.0 且 &lt;= 7.3.7</span><span><br></span><span>Vite 8.0 - 8.1：&lt;= 8.1.6</span><span><br></span><span>Vite 8.2：&lt;= 8.2.4</span><span><br></span><span>Vite 8.3：&lt;= 8.3.6</span><span><br></span><span>Vite-plus：&lt;= 1.5.0</span></p><p><strong><span><span>漏洞类型：</span></span></strong></p><p><span>代码执行</span></p><p><span><strong><span>利用条件：</span></strong></span></p><p><span>1、用户认证：否</span></p><p><span>2、前置条件：开发服务器通过 --host / server.host 暴露到网络，无需认证与用户交互</span></p><p><span>3、触发方式：远程</span></p><p><strong><span><span>综合评价：</span></span></strong></p><p><span>利用难度：容易，无需授权即可远程代码执行。</span></p><p><span>威胁等级：高危，可造成任意文件读取与远程代码执行。</span></p><p><strong><span><span>官方解决方案：</span></span></strong></p><p><span>已发布</span></p><p><strong><span>漏洞分析</span></strong></p><p><img src=\"/dailyinfo/media/cdf34c5e9c5b09c3.webp\" loading=\"lazy\" decoding=\"async\"></p><p><b><span>组件介绍</span></b></p><p><span>Vite 是新一代前端构建工具与开发服务器，内置开发服务器为浏览器端代码提供模块转换与热更新，被 Vue、React 等前端项目广泛用作默认构建方案。其虚拟模块 stub 生成、import-analysis 模块图分析与 import.meta.glob 选项求值均在开发服务器进程内执行，当开发服务器通过 --host / server.host 暴露到网络时，远程请求可直接触达上述代码路径，本次漏洞即位于该链路。</span></p><p><img src=\"/dailyinfo/media/4abb85c0b195620c.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>漏洞简介</span></strong></p><p><span>2026年11月19日，深瞳漏洞实验室监测到一则Vite组件存在代码执行漏洞的信息，漏洞威胁等级：高危。</span></p><p><span>Vite 开发服务器的虚拟模块标识符处理存在注入缺陷：请求 /@id/__vite-browser-external: 后的 URL 内容未经转义即拼入生成的 JS 源码，</span><strong><span><span>攻击者通过闭合模板字符串注入任意模块级代码，进而利用模块图信任机制绕过文件访问限制实现任意文件读取，并通过服务端求值 import.meta.glob 选项实现任意代码执行。</span></span></strong><span>开发服务器仅需通过 --host / server.host 暴露到网络即可被无认证利用，server.fs.allow / fs.deny 配置无法缓解；生产构建产物不受影响。</span></p><p><img src=\"/dailyinfo/media/47ac43daf7ef1b1a.webp\" loading=\"lazy\" decoding=\"async\"></p><p><b><span>漏洞验证</span></b></p><p><span>搭建受影响的 Vite 6.4.5 环境并以 --host 暴露开发服务器，发送单个 GET 请求即可 RCE：URL 中的模块标识符被未转义拼入生成的 JS 代码，注入的 import.meta.glob() 第二参数在服务端被 new Function 求值，经 globalThis.process.getBuiltinModule 取得 execSync 执行任意命令。回显利用了 Vite 自身的报错机制：把命令输出拼接为 options 对象的属性名（computed key），求值返回后该属性名不在 Vite 的已知选项白名单内，Vite 便抛出 Unknown glob option \"&lt;命令输出&gt;\" 异常，错误消息随 HTTP 500 响应体原样返回——无需外带通道，单请求完成执行与回显。</span></p><p><img src=\"/dailyinfo/media/7cedcabffb0bd35a.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>影响范围</span></strong></p><p><span>目前受影响的Vite版本：</span></p><p><span>Vite 4.x - 6.x：&gt;= 4.0.0 且 &lt;= 6.4.5（修复 6.4.6）</span></p><p><span>Vite 7.x：&gt;= 7.0.0 且 &lt;= 7.3.7（修复 7.3.8）</span></p><p><span>Vite 8.0 - 8.1：&lt;= 8.1.6（修复 8.1.7）</span></p><p><span>Vite 8.2：&lt;= 8.2.4（修复 8.2.5 / 8.2.6）</span></p><p><span>Vite 8.3：&lt;= 8.3.6（修复 8.3.7）</span></p><p><span>Vite-plus：&lt;= 1.5.0（修复 1.5.1）</span></p><p><strong><span>解决方案</span></strong></p><p><img src=\"/dailyinfo/media/a145050bfc94d574.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>官方修复建议</span></strong></p><p><span>升级至官方已修复版本：</span><span><br></span><span>Vite 4.x - 6.x：&gt;= 6.4.6</span><span><br></span><span>Vite 7.x：&gt;= 7.3.8</span><span><br></span><span>Vite 8.0 - 8.1：&gt;= 8.1.7</span><span><br></span><span>Vite 8.2：&gt;= 8.2.5 / 8.2.6</span><span><br></span><span>Vite 8.3：&gt;= 8.3.7</span><span><br></span><span>Vite-plus：&gt;= 1.5.1</span></p><p><span>官方安全通告：<a href=\"https://github.com/vitejs/vite/security/advisories/GHSA-p4f5-76q4-ffq7\">https://github.com/vitejs/vite/security/advisories/GHSA-p4f5-76q4-ffq7</a></span></p><p><img src=\"/dailyinfo/media/4959fa9f1a9f9b14.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span><span>临时修复建议</span></span></strong></p><ul><li><p><span>在完成升级前，避免将 Vite 开发服务器通过 --host / server.host 暴露到网络；确需远程访问时，以防火墙限制开发端口（默认 5173）的访问来源为可信地址。</span></p></li></ul><ul><li><p><span>关注 Vite 官方发布渠道，按受影响分支尽快升级至 6.4.6 / 7.3.8 / 8.1.7 / 8.2.6 / 8.3.7 或 vite-plus 1.5.1。</span></p></li></ul><p><img src=\"/dailyinfo/media/42a4a092533018d1.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>深信服解决方案</span></strong></p><p><strong><span>1、风险资产发现</span></strong></p><p><span>支持对Vite的主动检测，</span><strong><span><span>可批量检出业务场景中该事件的受影响资产情况，</span></span></strong><span>相关产品如下：</span></p><p><strong><span><span>【深信服统一端点安全管理系统aES】</span></span></strong><span>已发布资产检测方案，指纹ID:0032127。</span></p><p><strong><span><span>【深信服云镜YJ】</span></span></strong><span>已发布资产检测方案，指纹ID:0032127。</span></p><p><strong><span>2、漏洞主动检测</span></strong></p><p><span>支持对Vite 开发服务器虚拟模块注入远程代码执行漏洞(SF_2026_47139)的主动检测，</span><strong><span><span>可批量快速检出业务场景中是否存在漏洞风险，</span></span></strong><span>相关产品如下：</span></p><p><strong><span><span>【深信服云镜YJ】</span></span></strong><span>2026年11月19日发布检测方案，规则ID:SF-2026-13361。</span></p><p><strong><span><span>【深信服可拓展检测响应平台XDR】</span></span></strong><span>2026年11月19日发布检测方案（需要具备云镜组件能力），规则ID:SF-2026-13361。</span></p><p><strong><span>3、漏洞安全监测</span></strong></p><p><span>支持对Vite 开发服务器虚拟模块注入远程代码执行漏洞(SF_2026_47139)的监测，</span><strong><span><span>可依据流量收集实时监控业务场景中的受影响资产情况，</span></span></strong><span>快速检查受影响范围，相关产品及服务如下：</span></p><p><strong><span><span>【深信服安全感知管理平台SIP】</span></span></strong><span>预计2026年11月25日发布监测方案，规则ID:11224863。</span></p><p><strong><span><span>【深信服安全托管服务MSS】</span></span></strong><span>预计2026年11月25日发布监测方案（需要具备SIP组件能力），规则ID:11224863。</span></p><p><strong><span><span>【深信服可拓展检测响应平台XDR】</span></span></strong><span>预计2026年11月25日发布监测方案，规则ID:11224863。</span></p><p><strong><span>4、漏洞安全防护</span></strong></p><p><span>支持对Vite 开发服务器虚拟模块注入远程代码执行漏洞(SF_2026_47139)的防御，</span><strong><span><span>可阻断攻击者针对该事件的入侵行为，</span></span></strong><span>相关产品及服务如下：</span></p><p><strong><span><span>【深信服下一代防火墙AF】</span></span></strong><span>预计2026年11月25日发布防护方案，规则ID:11224863。</span></p><p><strong><span><span>【深信服Web应用防火墙WAF】</span></span></strong><span>预计2026年11月25日发布防护方案，规则ID:11224863。</span></p><p><strong><span><span>【深信服安全托管服务MSS】</span></span></strong><span>预计2026年11月25日发布防护方案（需要具备AF组件能力），规则ID:11224863。</span></p><p><strong><span><span>【深信服可拓展检测响应平台XDR】</span></span></strong><span>预计2026年11月25日发布防护方案（需要具备AF组件能力），规则ID:11224863。</span></p><p><b><span>参考链接</span></b></p><p><span><a href=\"https://github.com/vitejs/vite/security/advisories/GHSA-p4f5-76q4-ffq7\">https://github.com/vitejs/vite/security/advisories/GHSA-p4f5-76q4-ffq7</a></span></p><p><span><a href=\"https://github.com/vitejs/vite/pull/24044\">https://github.com/vitejs/vite/pull/24044</a></span></p><p><b><span>时间轴</span></b></p><p><strong><span>2026/11/19</span></strong></p><p><span>深瞳漏洞实验室监测到Vite 开发服务器虚拟模块注入远程代码执行漏洞信息。</span></p><p><strong><span>2026/11/19</span></strong></p><p><span>深瞳漏洞实验室发布漏洞通告。</span></p><p><span>点击</span><strong><span><span>阅读原文</span></span></strong><span>，及时关注并登录深信服</span><strong><span>智安全平台</span></strong><span>，可轻松查询漏洞相关解决方案。</span></p><p><img src=\"/dailyinfo/media/84ffcae64a079e4e.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img src=\"/dailyinfo/media/30db9f50cea1c9a0.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><a href=\"https://sec.sangfor.com.cn/security-vulnerability/detail?vuln_sfv=SF_2026_47139%5cx26amp;lang=ZH-CN\">阅读原文</a></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=3449c7b0&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzg2NjgzNjA5NQ%3D%3D%26mid%3D2247526508%26idx%3D2%26sn%3Dca0a32750a69f45993adc16941608714\">跳转微信打开</a></p>","original","zhKind","complete","漏洞","复现","漏洞利用","补丁","漏洞分析","https://mp.weixin.qq.com/s?__biz=Mzg2NjgzNjA5NQ==&mid=2247526508&idx=2&sn=ca0a32750a69f45993adc16941608714","深信服千里目安全实验室",{"_94":95,"_96":-5},"changelogVersion","2026-10-01T08:00","release"]
