[{"_1":2,"_3":4},"root",{"_5":107},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1793591188000,"id","vsfs000d1boyjr3m5ahd2iza2","title","Tailscale 修复 Tailworm SSH 漏洞，v1.104.4 已发布","originalTitle","Tailscale fixes SSH flaws allowing lateral movement within tailnets","summary","Tailscale 修复了 Tailworm 中可导致已获准设备在 tailnet 内横向移动的 SSH 漏洞。攻击者需先入侵策略允许 SSH 连接的设备，随后可尝试获取其他服务器的 root 级控制权并窃取设备注册密钥；受影响范围受 tailnet 策略限制，Tailscale 不认同其可自动传播的“蠕虫”定性。","reason","source",{"_73":106},"links",{"_96":105},"publishedAt","2026-10-28T12:25:04.000Z","discoveredAt","2026-10-28T14:03:45.009Z","timelineAt","category","vuln","tags",[102,103,104,78,76],"score",71,"selected",true,"channel","news","story",{"_80":81,"_13":82},"x","sameEvent",{"_11":100,"_13":101},"readingMode","full","author","Zeljka Zorz","body",{"_62":95,"_96":-5,"_97":98,"_99":36},"outline",[83,84,85],"relatedStories",[79],"topics",[69,70,71],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","fdD168ZI5d8U","reportCount",2,"additionalSourceCount",1,{"_72":77,"_73":78},{"_72":75,"_73":76},{"_72":30,"_73":74},"slug","name","漏洞披露","vuln-mgmt","漏洞管理","identity","身份与访问",{"_80":81,"_13":82},"publicId","caf8163e-a8e9-4f65-ab0c-ed73d6654d2b","Tailscale发布1.104.4修复SSH漏洞",{"_11":93,"_87":94,"_89":90},{"_11":91,"_87":92,"_89":90},{"_11":86,"_87":88,"_89":90},"sec-3","text","该怎么办？","level",3,"sec-2","关于这些漏洞","sec-1","关于 Tailscale 和 Tailscale SSH","<p>Tailscale 是同名热门软件定义网格网络与连接平台背后的公司，目前已为多个漏洞发布修复，其中包括 Tailscale SSH 中的若干漏洞；这些漏洞可能使已经访问网络中某台设备的攻击者，在属于该网络的其他计算机上获得更高权限。</p><p><img src=\"/dailyinfo/media/677146b7587f491e.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Tailscale Tailworm SSH flaws\" title=\"Tailscale\"></p><p>“根据我们的调查，攻击者只能访问 tailnet 策略文件原本已允许建立 SSH 连接的机器，”<a href=\"https://tailscale.com/blog/tailscale-ssh-findings-fixes\">Tailscale 工程副总裁</a> Mike Shaver 表示。</p><h3 id=\"sec-1\">关于 Tailscale 和 Tailscale SSH</h3><p>Tailscale 让个人和组织能够将计算机、手机、服务器及其他设备连接到同一个私有网络（又称“tailnet”），从而可以像处于同一局域网中一样，随时随地安全地相互访问。该解决方案使用 WireGuard 通信协议对数据进行加密和传输。</p><p>用户只需在每台设备上安装 Tailscale 应用，并使用现有账户（如 Google 或 Microsoft）登录，该软件即可处理设备之间的加密连接，无需进行复杂的路由器或防火墙配置。</p><p>家庭用户通常使用它在外出时访问文件、媒体服务器或安全摄像头。企业则使用它为员工和系统提供对内部资源的受控访问，同时不将其暴露在公共互联网上。</p><p>Tailscale 还提供内置的 SSH 服务器，允许用户通过向远程计算机输入命令来进行控制。Tailscale SSH 会结合用户 Tailscale 账户已有的身份信息与管理员设置的访问策略，决定谁可以连接哪些机器。</p><p>此功能有助于远程修复家庭服务器或重启停止工作的设备。组织也会使用它，让员工能够管理公司计算机，同时不将其暴露在互联网上。</p><p>该 SSH 服务器只能从个人或组织 tailnet 内部的设备访问。</p><h3 id=\"sec-2\">关于这些漏洞</h3><p>10 月 23 日，Cyberdione Labs 安全研究员 Erica Windisch 发布报告，详细介绍了她在 Tailscale SSH 和其他 Tailscale 功能中发现的漏洞，并将这些漏洞统称为“Tailworm”。</p><p>利用这些 SSH 问题的前提是，攻击者已经攻陷了 tailnet 中某台获准访问的设备。此后，攻击者可以利用 Tailscale SSH 获得其他服务器的 root 级别控制权，但仅限于网络策略允许该设备连接的服务器。他们还可以窃取用于注册新设备的密钥，并利用这些密钥添加一台看似合法的恶意机器。</p><p>研究人员声称，在实验室测试中，这种访问权限可以从一台设备自动传播到另一台设备，但 Tailscale 对“蠕虫”这一称谓提出异议。Shaver 指出：“相反，更准确的说法应是横向移动，且仅限于 tailnet 策略文件允许的连接。”</p><p>该<a href=\"https://tailworm.com/\">报告</a>还描述了：</p><ul>\n<li>Conn25 中的一处缺陷。这是一项仍处于预生产阶段的下一代应用连接器功能，Shaver 表示将在发布前修复。</li>\n<li>一些拒绝服务问题，任何互联网用户都可以利用它们使自托管的 Tailscale 控制服务器实现崩溃，或阻止新设备加入网络。</li>\n</ul><h3 id=\"sec-3\">该怎么办？</h3><p>该公司修复了四个漏洞（<a href=\"https://tailscale.com/security-bulletins#ts-2026-014\">1</a>、<a href=\"https://tailscale.com/security-bulletins#ts-2026-015\">2</a>、<a href=\"https://tailscale.com/security-bulletins#ts-2026-016\">3</a>、<a href=\"https://tailscale.com/security-bulletins#ts-2026-017\">4</a>），其中包括 Tailscale SSH 问题，并在 Tailscale v1.104.4 中发布了这些修复。</p><p>建议用户升级至该版本，并审查其 Tailscale SSH 策略，“确保访问权限仅限于确有需要的用户和设备”，同时考虑为敏感系统启用 Tailscale SSH 的 Check 模式，这样只有在通过额外身份验证检查后才能访问这些系统。</p><p><img src=\"/dailyinfo/media/93223e2e45672130.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong>订阅我们的突发新闻电子邮件提醒，不错过最新的数据泄露、漏洞和网络安全威胁。<a href=\"https://www.helpnetsecurity.com/newsletter/\">在此订阅！</a></strong></p><p><img src=\"/dailyinfo/media/93223e2e45672130.webp\" loading=\"lazy\" decoding=\"async\"></p>","original","zhKind","translation","complete","mcavcy6rfhx02l0wj4i1ep45m","Tailscale 修复 SSH 转发漏洞，已授权会话可越权访问 root 专属服务","漏洞","补丁","网络设备","https://www.helpnetsecurity.com/2026/10/28/tailscale-fixes-tailworm-ssh-flaws/","Help Net Security",{"_108":109,"_110":-5},"changelogVersion","2026-10-01T08:00","release"]
