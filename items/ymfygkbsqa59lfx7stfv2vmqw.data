[{"_1":2,"_3":4},"root",{"_5":122},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1794444102000,"id","ymfygkbsqa59lfx7stfv2vmqw","title","Flare 发现地下论坛传播 eBPF rootkit 构建代码与教程","originalTitle","eBPF Rootkits: Why Underground Actors Are Taking Notice","summary","Flare 在地下论坛发现 eBPF rootkit 构建代码与分步教程，相关植入物可通过特定 TCP SYN 触发，利用 getdents64 隐藏进程，并以 AES-256-GCM 加密 C2 流量。","reason","source",{"_74":121},"links",{"_61":120},"publishedAt","2026-11-11T15:01:11.000Z","discoveredAt","2026-11-11T15:22:36.022Z","timelineAt","category","disclosure","tags",[75,77,117,118,119],"score",49,"selected",false,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Sponsored by Flare","body",{"_113":-5,"_61":114,"_115":-5,"_116":36},"outline",[86,87,88,89,90,91,92,93],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fitsoQm7dN6A","reportCount",1,"additionalSourceCount",0,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","research","name","技术研究","malware","恶意软件","red-team","红队与渗透","kernel","内核与系统",{"_83":84,"_13":85},"publicId","62d46093-1bc5-4e4e-932c-0f3349c500c9","地下论坛传播eBPF rootkit教程",{"_11":111,"_95":112,"_97":98},{"_11":109,"_95":110,"_97":98},{"_11":107,"_95":108,"_97":98},{"_11":105,"_95":106,"_97":98},{"_11":103,"_95":104,"_97":98},{"_11":101,"_95":102,"_97":98},{"_11":99,"_95":100,"_97":98},{"_11":94,"_95":96,"_97":98},"sec-8","text","The Bottom Line","level",2,"sec-7","What Defenders Should Do","sec-6","Why Detection Is So Hard","sec-5","eBPF Beyond Rootkits","sec-4","Underground Adoption: From Research to Weaponization","sec-3","From Classic BPF Backdoors to eBPF Rootkits","sec-2","The Next Linux Rootkit Is Already Being Discussed Underground","sec-1","What Makes eBPF Dangerous?","zh","<p><img alt=\"Flare eBPF header image\" height=\"900\" src=\"/dailyinfo/media/0ce2f6bd38eebfbf.jpg\" srcset=\"/dailyinfo/media/c677b03b6b7b57eb.jpg 720w, /dailyinfo/media/8191ca18609fd5e3.jpg 1200w, /dailyinfo/media/0ce2f6bd38eebfbf.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>For years, eBPF (extended Berkeley Packet Filter) has been one of the most celebrated technologies in the Linux kernel. It lets developers run sandboxed programs inside the kernel without writing kernel modules, while powering everything from network monitoring to security tooling.</p><p>Linux is extremely popular in production servers and giants like Google, Cloudflare, and Meta rely on it daily.</p><p>The same eBPF capabilities that are attractive for defenders, however, can be a powerful weapon in the hands of attackers. Flare’s research found underground forum posts sharing eBPF rootkit code and step-by-step tutorials.</p><p>One Russian-language post described how to build an implant with process hiding and packet-triggered activation, and included screenshots the author presented as demonstrations.</p><h2 id=\"sec-1\">What Makes eBPF Dangerous?</h2><p>Traditional Linux rootkits typically rely on loadable kernel modules (LKMs) to hook system calls and hide malicious activity. These are well-understood by defenders, and most EDR solutions watch for suspicious module loads. eBPF, however, behaves in a different way.&nbsp;</p><p>An eBPF malware can hook into kernel functions, observe system calls, or inspect and modify network traffic using the same kernel-supported bpf() interface as legitimate tools like Cilium.</p><p>Its programs run without loading a kernel module, so a routine lsmod check can miss them. The challenge for defenders is determining who loaded the program and what it does.</p><h2 id=\"sec-2\"><a href=\"https://try.flare.io/bleeping-computer?utm_campaign=58464633-PM%20-%20Bleeping%20Computer%20-%20November%202026%20&amp;utm_source=PM%20-%20Bleeping%20Computer%20-%20November%202026&amp;utm_medium=PM%20-%20Bleeping%20Computer%20-%20November%202026\">The Next Linux Rootkit Is Already Being Discussed Underground</a></h2><p>eBPF rootkits are moving from conference talks to underground forum tutorials, and by the time one loads on a host, it’s built to evade your usual checks.</p><p>Flare monitors forums, marketplaces, and paste sites in real time, so your team sees new tooling, exploits, and chatter early enough to track eBPF threats.</p><p><a href=\"https://try.flare.io/bleeping-computer?utm_campaign=58464633-PM%20-%20Bleeping%20Computer%20-%20November%202026%20&amp;utm_source=PM%20-%20Bleeping%20Computer%20-%20November%202026&amp;utm_medium=PM%20-%20Bleeping%20Computer%20-%20November%202026\">Free 2-Week Trial</a></p><h2 id=\"sec-3\">From Classic BPF Backdoors to eBPF Rootkits</h2><p>The first major wake-up call came in 2022 when PwC and Elastic Security Labs documented BPFDoor, a passive Linux backdoor attributed to a Chinese threat actor tracked as Red Menshen. The BPFDoor sample Elastic analyzed used a classic BPF socket filter to recognize specially crafted TCP, UDP, or ICMP packets.</p><p>Once triggered, it could open a reverse shell or redirect traffic to the implant. PwC discovered the malware in 2021, and public reporting in 2022 described activity targeting organizations in the Middle East and Asia.</p><p>Around the same time, Intezer and BlackBerry jointly disclosed Symbiote, a different flavor of Linux malware that weaponizes BPF for stealth. Rather than running as a standalone process, Symbiote uses the dynamic linker to preload a malicious shared library into affected processes.&nbsp;</p><p>The library intercepts calls to setsockopt() that attach classic BPF filters via SO_ATTACH_FILTER and prepends its own filter instructions to conceal selected traffic from packet capture.</p><p>Public research had already demonstrated offensive uses of eBPF. In 2021, researchers presented ebpfkit at Black Hat USA and DEF CON. TripleCross combines syscall hooks with XDP and traffic control programs to support library injection, execution hijacking, concealment, and command and control.</p><p>Boopkit uses getdents64 hooks to hide directory entries. An already installed implant can be triggered remotely in two documented ways, one involving a malformed TCP SYN and the other using ordinary TCP connections.</p><p>Lastly, in October 2025, Synacktiv reported LinkPro after investigating a compromise that began with an exposed Jenkins server. LinkPro used eBPF programs to hide activity on the host and activate the backdoor when it received a specially crafted packet.</p><h2 id=\"sec-4\">Underground Adoption: From Research to Weaponization</h2><p>Security researchers and state-sponsored threat actors have explored how eBPF can be used to build rootkits. Flare’s recent research found underground forum posts sharing code and step-by-step tutorials, showing that these techniques now circulate beyond academic papers and security conferences.</p><p>On the Russian-language Duty Free forum, a user published a tutorial on building an eBPF rootkit and cited BPFDoor and Symbiote as influences.</p><figure><img alt=\"\" height=\"600\" src=\"/dailyinfo/media/31f762457ccdb5f1.jpg\" srcset=\"/dailyinfo/media/d065d90085bf46c7.jpg 720w, /dailyinfo/media/4f37ef5f593a863a.jpg 1200w, /dailyinfo/media/31f762457ccdb5f1.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1057\">\n<figcaption><strong>Screenshot from <a href=\"https://app.flare.io/#/forum_post/duty-free/29181\">Flare's platform</a> showing the title and outline of an eBPF rootkit tutorial posted on the Duty Free forum.</strong><br>\n<em>Sign up for the <a href=\"https://try.flare.io/bleeping-computer?utm_campaign=58464633-PM%20-%20Bleeping%20Computer%20-%20November%202026%20&amp;utm_source=PM%20-%20Bleeping%20Computer%20-%20November%202026&amp;utm_medium=PM%20-%20Bleeping%20Computer%20-%20November%202026\">free trial</a> to access if you aren’t already a customer.</em></figcaption>\n</figure><p>The guide includes source code and screenshots that the author presents as demonstrations. It describes how to activate the implant with a TCP SYN packet with a specific window size, hide processes by hooking getdents64, and encrypt command-and-control traffic with AES-256-GCM.</p><p>The guide also describes using XDP to inspect incoming plaintext HTTP traffic and drop packets that match a list of 43 IP addresses the author associates with antivirus vendors.&nbsp;</p><p>Flare also identified 10 related Pastebin posts containing XDP packet-processing code and timing thresholds expressed in microseconds.&nbsp;</p><h2 id=\"sec-5\">eBPF Beyond Rootkits</h2><p>Flare also found exploit code circulating across multiple platforms. The most frequently reposted exploit (at least six platforms) in the dataset targeted CVE-2017-16995, a 2017 Linux BPF verifier flaw involving incorrect sign extension.</p><p>Alongside the older eBPF exploits, researchers discovered some fresh exploits.</p><p>One example is an unverified Linux local privilege escalation PoC targeting kTLS and eBPF sockmaps. The proof-of-concept attempts to corrupt the page cache for /etc/passwd and inject an account with UID 0. Its claim of compatibility with all kernels from 4.18 onward is incorrect.</p><p>Upstream Linux 4.18 lacks a BPF helper the code calls. Successful privilege escalation on Ubuntu 22.04 or 24.04 has not been verified.&nbsp;</p><p>In one exploit sample we reviewed, the author credited Claude in a source code comment with generating the BPF instructions.</p><h2 id=\"sec-6\">Why Detection Is So Hard</h2><p>The fundamental challenge is that eBPF-based threats operate through a legitimate kernel interface.</p><p>Unlike a rogue kernel module, an eBPF program passes through the kernel’s built-in verifier and a malicious program that passes verification looks, to the kernel, like any other approved program.</p><p>Detection today focuses on monitoring bpf() syscalls, tracking loaded programs via bpftool, and watching for suspicious attachment points on sensitive syscalls like getdents64 and execve.</p><p>But these are reactive measures, and attackers have the advantage of operating through the kernel’s own sanctioned mechanisms.</p><h2 id=\"sec-7\">What Defenders Should Do</h2><p>Organizations running Linux infrastructure should take eBPF threats seriously:</p><ul>\n\t<li>\n\t<p><strong>Audit loaded eBPF programs</strong> regularly with bpftool prog list. Know what’s supposed to be there.</p>\n\t</li>\n\t<li>\n\t<p><strong>Restrict eBPF access</strong> via kernel.unprivileged_bpf_disabled=1 and limit CAP_BPF / CAP_NET_ADMIN.</p>\n\t</li>\n\t<li>\n\t<p><strong>Monitor for magic packets</strong> — several eBPF backdoors activate via specific TCP flags or window sizes.</p>\n\t</li>\n\t<li>\n\t<p><strong>Patch aggressively</strong> — BPF verifier bugs are a recurring vulnerability class, and weaponized exploits appear fast.</p>\n\t</li>\n\t<li>\n\t<p><strong>Watch for unexpected XDP programs</strong> on network interfaces.</p>\n\t</li>\n\t<li>\n\t<p><strong>Gather fresh threat intelligence</strong> – stay up to date on new attack vectors, tools and techniques which may help you tailor new detections and enforcement to block eBPF- based malware.</p>\n\t</li>\n</ul><h2 id=\"sec-8\">The Bottom Line</h2><p>eBPF rootkits represent a genuine evolution in Linux threats as their implants can evade checks focused on loaded kernel modules. LinkPro went further by trying to hide its eBPF programs from bpftool prog list.</p><p>Investigators could still see associated BPF maps and links, illustrating why defenders should compare multiple sources of host telemetry.</p><p>Flare found underground posts sharing source code and instructions for hiding processes and activating an implant with a crafted packet. Synacktiv documented both techniques in its investigation of LinkPro, giving defenders a concrete example of how they can appear in an intrusion.</p><p><strong><a href=\"https://signup.flare.io/free-trial?utm_campaign=56138500-PM%20-%20Bleeping%20Computer%20-%20October%202026&amp;utm_source=PM%20-%20Bleeping%20Computer%20-%20October%202026&amp;utm_medium=PM%20-%20Bleeping%20Computer%20-%20October%202026\">Learn more by signing up for our&nbsp;free trial</a>.</strong></p><p><i>Sponsored and written by <a href=\"https://try.flare.io/bleeping-computer?utm_campaign=58464633-PM%20-%20Bleeping%20Computer%20-%20November%202026%20&amp;utm_source=PM%20-%20Bleeping%20Computer%20-%20November%202026&amp;utm_medium=PM%20-%20Bleeping%20Computer%20-%20November%202026\">Flare</a>.</i></p>","zhKind","complete","后门","内核","红队","https://www.bleepingcomputer.com/news/security/ebpf-rootkits-why-underground-actors-are-taking-notice/","BleepingComputer",{"_123":124,"_125":-5},"changelogVersion","2026-10-01T08:00","release"]
