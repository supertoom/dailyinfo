[{"_1":2,"_3":4},"root",{"_5":99},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1794185101000,"id","evjboavsq5zcivgr94mnwlu4l","title","OpenSSH <10.6p2 musl libc 认证绕过漏洞 CVE-2026-123158 已修复","originalTitle","OpenSSH <10.6p2 musl libc 认证绕过漏洞（CVE-2026-123158）","summary","OpenSSH 披露并修复了 CVE-2026-123158，影响使用 musl libc 且口令认证不经过 PAM 的配置。远程未认证攻击者在启用口令认证、账户口令字段为单个 * 且存在特定备用盐值时，可提交 257～1024 字节超长口令触发 musl crypt() 长度限制，使 sshd 将认证错误判定为成功。","reason","通告梳理了特定配置下的认证绕过原理，并提供升级、禁用口令认证及入侵排查方法。","source",{"_75":98},"links",{"_89":97},"publishedAt","2026-11-06T03:59:00.000Z","discoveredAt","2026-11-07T03:28:32.622Z","timelineAt","category","vuln","tags",[92,93,94,79,95,96],"score",72,"selected",true,"channel","news","story",{"_85":86,"_13":87},"x","readingMode","full","author","body",{"_61":88,"_89":-5,"_90":89,"_91":37},"outline",[],"relatedStories",[84],"topics",[68,69,70,71,72],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","f_nLqRjBvHw0","reportCount",2,"additionalSourceCount",1,{"_73":82,"_75":83},{"_73":80,"_75":81},{"_73":78,"_75":79},{"_73":31,"_75":77},{"_73":74,"_75":76},"slug","research","name","技术研究","漏洞披露","identity","身份与访问","kernel","内核与系统","alibaba","阿里云安全",{"_85":86,"_13":87},"publicId","8cbb6ce3-a5e3-45e1-885c-bcee2ad3a4e4","OpenSSH SSHole漏洞已确认遭在野利用","<p><span>风险通告</span> <span>2026-11-06 11:59</span> <span>浙江</span></p><p><img src=\"/dailyinfo/media/f2d66ccbaf5b2a04.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>2026年11月5日，阿里云安全监测到 OpenSSH官方披露 OpenSSH &lt;10.6p2 musl libc 认证绕过漏洞（CVE-2026-123158）</p><p><span><span><span>2026年11月6日，阿里云安全监测到 OpenSSH官方披露 OpenSSH &lt;10.6p2 musl libc 认证绕过漏洞（CVE-2026-123158）</span></span></span></p><p><span><span>01</span></span></p><p><span><span>风险描述</span></span></p><p><span><span>OpenSSH 是一款广泛使用的开源 SSH 协议实现。2026年11月6日，OpenSSH 披露并修复了</span><span>OpenSSH &lt;10.6p2 musl libc 认证绕过漏洞</span><span>（CVE-2026-123158）。</span><span><br></span><span>该漏洞发生在使用 musl libc、且口令认证不经过 PAM 的配置中。在启用口令认证、目标账户口令字段为单个 *，且系统存在可供选择的特定备用盐值等条件下，远程未认证攻击者可通过提交 257～1024 字节的超长口令触发 musl crypt() 的长度限制。该函数返回的错误标记 * 与目标账户的口令字段相等，导致 sshd 将认证错误判定为成功。</span></span></p><p><span><span>02</span></span></p><p><span><span>风险评级</span></span></p><p><span><span><span><span><span><span><span><span>CVE-2026-123158</span></span></span><span><br></span></span></span><span><span><span>OpenSSH &lt;10.6p2 musl libc 认证绕过漏洞</span></span></span><span>&nbsp;严重</span></span></span></span></p><p><span><span>03</span></span></p><p><span><span>修复方案</span></span></p><p><span><span><span>升级至 OpenSSH 10.6p2 或更高版本，或安装各发行版提供的修复软件包</span></span></span></p><p><span><span>04</span></span></p><p><span><span>缓解方案</span></span></p><p><span><span>1、</span><span>暂时无法升级时，应立即在服务端配置中禁用口令认证 PasswordAuthentication no 。 Alpine Linux 可执行以下命令检查配置并重启服务：&nbsp;</span></span></p><p><span><span>&nbsp; &nbsp;sshd -t &amp;&amp; rc-service sshd restart&nbsp;</span></span></p><p><span><span>&nbsp; &nbsp;sshd -T | grep -i '^passwordauthentication'&nbsp;</span></span></p><p><span><span>预期结果为 `passwordauthentication no`。存在 `Match` 条件时，应结合 `sshd -T -C` 验证实际连接条件。操作前确认密钥登录可用，并保留当前管理会话，待新会话登录验证成功后再关闭。&nbsp;</span></span></p><p><span><span>2、限制 SSH 入口仅允许可信管理来源访问，可利用阿里云安全组设置SSH仅对可信地址开放。</span></span></p><p><span><span>3、设置 `PermitRootLogin prohibit-password` 或 `no` 可降低直接以 root 登录的风险</span></span></p><p><span><span>4、入侵排查：</span><span>检查 SSH 日志中，口令字段为 `*` 的账户是否出现异常 `Accepted password for` 记录，并关联排查免密提权、新增账户、计划任务及 `authorized_keys` 变更。若发现可疑登录，应按主机失陷事件开展调查和处置。</span></span></p><p><span><span>05</span></span></p><p><span><span>产品支持</span></span></p><p><span><span><span>阿里云云安全中心漏洞管理应用漏洞已支持针对该漏洞进行远程扫描检测。</span></span></span></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=095368b2&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzI5MzY2MzM0Mw%3D%3D%26mid%3D2247486420%26idx%3D1%26sn%3Df294caf49436ea3cb34cdb76ed973fba\">跳转微信打开</a></p>","original","zhKind","complete","漏洞","补丁","漏洞分析","操作系统","阿里","https://mp.weixin.qq.com/s?__biz=MzI5MzY2MzM0Mw==&mid=2247486420&idx=1&sn=f294caf49436ea3cb34cdb76ed973fba","阿里云应急响应",{"_100":101,"_102":-5},"changelogVersion","2026-10-01T08:00","release"]
