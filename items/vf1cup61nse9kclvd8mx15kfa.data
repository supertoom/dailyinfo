[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1795135245000,"id","vf1cup61nse9kclvd8mx15kfa","title","XWiki Platform HQL 注入漏洞可导致未认证提取数据库内容","originalTitle","XWiki Platform: HQL injection in search allows unauthenticated database extraction including password hashes","summary","XWiki Platform 的查询 REST API 存在 HQL 注入漏洞，未经认证的攻击者可通过 FROM 子句注入绕过 SELECT 列白名单，提取不可访问页面的数据、密码哈希及配置中的密码。","reason","公告说明了未认证注入的利用链、数据影响范围与请求规模，并给出修复版本和临时拦截端点，便于评估处置优先级。","source",{"_69":79},"links",{"_60":78},"publishedAt","2026-11-19T20:44:32.000Z","discoveredAt","2026-11-19T20:53:20.320Z","timelineAt","category","vuln","tags",[75,76,77],"score",72,"selected",true,"channel","news","story",{"_72":73,"_13":74},"x","readingMode","full","author","body","outline",[],"relatedStories",[71],"topics",[67],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fP0pJtt8oTlA","reportCount",1,"additionalSourceCount",0,{"_68":31,"_69":70},"slug","name","漏洞披露",{"_72":73,"_13":74},"publicId","17e28560-67ae-4381-8e63-e2da25b0817b","XWiki 查询接口 HQL 注入漏洞已修复","漏洞","补丁","漏洞利用","https://github.com/advisories/GHSA-jmmc-wjpc-pg34","GitHub 安全公告",{"_81":82,"_83":-5},"changelogVersion","2026-10-01T08:00","release"]
