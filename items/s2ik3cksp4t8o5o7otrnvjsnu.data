[{"_1":2,"_3":4},"root",{"_5":105},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795912847000,"id","s2ik3cksp4t8o5o7otrnvjsnu","title","Okta 追踪 ShinyHunters 关联团伙以 Inception 名义重启数据泄露站","originalTitle","ShinyHunters-linked crew resurfaces on new leak site","summary","Okta 追踪的 O-UNC-053 团伙自 2026 年 3 月起针对多个行业实施社会工程和凭据收集活动，并疑似在 ShinyHunters 泄露站下线后转投 Inception。","reason","两家机构的技术与基础设施线索相互印证，帮助区分该团伙更名、合作关系及真实攻击能力。","source",{"_75":104},"links",{"_96":103},"publishedAt","2026-11-24T12:47:07.000Z","discoveredAt","2026-11-24T13:13:32.530Z","timelineAt","category","activity","tags",[78,76,100,101,102,84],"score",74,"selected",true,"channel","news","story",{"_86":87,"_13":88},"x","readingMode","full","author","Sinisa Markovic","body",{"_61":95,"_96":-5,"_97":98,"_99":37},"outline",[89],"relatedStories",[85],"topics",[68,69,70,71,72],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fxsqVO3s-Zkc","reportCount",2,"additionalSourceCount",1,{"_73":83,"_75":84},{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","malware","name","恶意软件","attack","攻击活动","black-market","数据窃取与黑产","email","邮件与钓鱼","identity","身份与访问",{"_86":87,"_13":88},"publicId","c02d24f7-3590-4fa0-8cbd-489d81b76730","O-UNC-053被关联Inception数据勒索活动",{"_11":90,"_91":92,"_93":94},"sec-1","text","ReversingLabs 追踪同一条线索","level",3,"<p>ShinyHunters 泄露网站在 9 月下线，但一个为其提供受害者的团伙似乎在“Inception”名下找到了新落脚点，Okta 威胁情报团队对此已有发现。</p><p>Okta 将该团伙追踪为 O-UNC-053，这是一个自 2026 年 3 月以来持续开展<a href=\"https://www.helpnetsecurity.com/2025/05/06/social-engineering-human-behavior/\">社会工程</a>和凭据收集活动的集群。其目标包括科技、医疗保健、生物科技、金融服务、保险、娱乐、游戏、零售、运输、酒店以及法律行业的企业。</p><p>“虽然这一威胁集群改变了其品牌归属，但其运营者仍在积极使用语音钓鱼攻击和账户接管手段针对组织，导致数据窃取和勒索敲诈，”Okta 威胁猎人 Moussa Diallo 和 Katie Nickels 写道。</p><p>3 月至 9 月间，O-UNC-053 的受害者在该团伙注册用于针对他们的钓鱼域名后 1 至 28 天内出现在 ShinyHunters 泄露网站上。Okta 认为这表明双方存在实质性关系，可能存在某种协议，尽管该泄露网站几乎肯定也从其他入侵团伙那里获取过受害者。</p><p>随后发生了两起针对<a href=\"https://www.helpnetsecurity.com/2026/10/05/shinyhunters-member-rey-detained-jordan-fbi/\">疑似 ShinyHunters 关联人员</a>的逮捕，分别在 9 月 15 日和 29 日，而泄露网站也随之下线。</p><p>O-UNC-053 整个 10 月和 11 月初仍在注册钓鱼域名，却没有了明显的受害者发布渠道。一场以法律行业为主题的活动于 10 月下旬启动，11 月 16 日 Inception 出现，列出了该团伙在 6 至 19 天前为其注册域名的组织。</p><p><img src=\"/dailyinfo/media/bff923c950f0cb03.webp\" loading=\"lazy\" decoding=\"async\" alt=\"ShinyHunters Inception leak site\" title=\"O-UNC-053 key events from September through November 2026\"></p><h5>\n<p>O-UNC-053 从 2026 年 9 月至 11 月的关键事件（来源：Okta）</p>\n</h5><p>“在任一泄露网站上停止发布，随后以新品牌出现在新数据泄露网站上，这与此前 Com 关联行为体的更迭情形一致。在 DLS 发布主体变更前后，O-UNC-053 保持了稳定的基础设施和 TTP，这促使我们评估该集群极有可能更换了其品牌归属，”二人<a href=\"https://www.okta.com/blog/threat-intelligence/former_shinyhunters_cluster_moves_to_new_inception_site/\">补充道</a>。</p><p>FBI 描述称，The Com 是一个以英语使用者为主、面向国际的网络，由大多为年轻的网络犯罪分子组成，成员数以千计，并拥有一个名为 Hacker Com 的黑客分支。</p><p>“Hacker Com 的成员通常具有共同的兴趣、意识形态或目标，协同合作，将其他人吸纳进群体，并在必要时分裂，以完成其使命，”该机构<a href=\"https://www.ic3.gov/PSA/2025/PSA250723\">表示</a>。</p><p>Okta 并未断言 O-UNC-053 运营着 Inception，也承认该团伙可能只是与另一家勒索机构合作。</p><h3 id=\"sec-1\">ReversingLabs 追踪同一条线索</h3><p>ReversingLabs 发布了独立的研究，将 Inception 的勒索声称与一场针对单点登录账户的 vishing（语音钓鱼）行动联系起来。该网站上线后五天内便声称 AMD、Cigna Healthcare、Henry Schein、Paychex、PepsiCo、AutoZone 和 Lucid Motors 为受害者，不过 ReversingLabs 强调这些声称均未得到验证。</p><p>“该行动并未依赖传统的电子邮件诱饵，而是使用语音钓鱼（vishing）来窃取单点登录（SSO）凭据。对该对手域名基础设施的技术分析直接印证了这种带外投递模式。与该活动相关的所有法律主题诱饵域名均不具备 MX 记录、DKIM、DMARC 或任何其他与电子邮件相关的 DNS 配置，”ReversingLabs 首席恶意软件研究员 Robert Simmons 解释道。</p><p>这些工具包中的大多数都模仿目标机构的 Okta 登录页面，不过为 Lucid Motors 制作的那一套复制的是 NetIQ/OpenText Access Manager 登录页面，这说明该团伙在拨号（发起攻击）之前会先检查每个目标的 SSO 配置。</p><p>“本次行动的核心在于针对目标的具体身份提供商定制落地页面。已确认集群中的所有域名都配置为过滤不受欢迎的访问者，并将其转发至受害方的合法认证基础设施，”Simmons <a href=\"https://www.reversinglabs.com/blog/threat-researchers-notebook-sso-vishing-campaign-associated-with-emerging-inception-extortion-group\">指出</a>。</p><p>该公司还发现了数十家企业的诱饵域名，这些企业迄今尚未出现在泄露网站上，其中包括 Activision Blizzard、Riot Games、Starbucks、Nintendo 和 Paramount。</p><p>“由于该威胁行为者瞄准的是身份层而非终端，安全防御人员必须在所有身份提供商上优先采用抗钓鱼认证，同时强制使用 FIDO2 安全密钥、密码密钥或绑定来源的认证器，并配合托管设备限制以及针对意外 MFA 变更的告警，”Simmons 建议道。</p>","original","zhKind","translation","complete","钓鱼","数据泄露","黑产","https://www.helpnetsecurity.com/2026/11/24/shinyhunters-inception-leak-site-okta/","Help Net Security",{"_106":107,"_108":-5},"changelogVersion","2026-10-01T08:00","release"]
