[{"_1":2,"_3":4},"root",{"_5":107},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":61,"_62":63},"expiresAt",1795135237000,"id","he08061xy4cyd54gsriazxv74","title","VMware vCenter 零日漏洞 CVE-2026-123890 已被利用，Armory Castle 入侵虚拟化环境","originalTitle","VMware patches vCenter zero-day exploited in attacks since September","summary","Mandiant 与 Google Threat Intelligence Group 记录到疑似中国国家支持组织 Armory Castle 自 2026 年 9 月起利用 VMware vCenter 零日漏洞 CVE-2026-123890 实施攻击。","reason","source",{"_75":106},"links",{"_63":105},"publishedAt","2026-11-20T00:26:25.000Z","discoveredAt","2026-11-20T00:33:19.320Z","timelineAt","category","vuln","tags",[98,76,99,100,101,102,103,104],"score",90,"selected",true,"channel","news","story",{"_81":82,"_13":83},"x","sameEvent",{"_11":96,"_13":97},"readingMode","full","author","Lawrence Abrams","body",{"_92":-5,"_63":93,"_94":-5,"_95":61},"outline",[84,85],"relatedStories",[80],"topics",[70,71,72],"indexable","markdownAvailable","group",{"_64":65,"_66":67,"_68":69},"hasTranslation",false,"bodyLanguage","original","factId","fJ4dDx5j8puY","reportCount",3,"additionalSourceCount",2,{"_73":78,"_75":79},{"_73":30,"_75":77},{"_73":74,"_75":76},"slug","exploited","name","在野利用","漏洞披露","vmware","VMware / Broadcom",{"_81":82,"_13":83},"publicId","25bfc85d-d33c-4d9e-8852-0430fda6b8b0","Armory Castle利用vCenter零日漏洞植入后门",{"_11":90,"_87":91,"_89":69},{"_11":86,"_87":88,"_89":69},"sec-2","text","Uncover email threats your existing defenses may miss.","level","sec-1","Chinese hackers exploited VMware zero-day","zh","<p><img alt=\"VMware\" height=\"900\" src=\"/dailyinfo/media/8be07d615a396e3e.jpg\" srcset=\"/dailyinfo/media/4fce9021a6c974c7.jpg 720w, /dailyinfo/media/1ee7678cb3938b98.jpg 1200w, /dailyinfo/media/8be07d615a396e3e.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>Broadcom has released security updates to fix a critical VMware vCenter Server authentication bypass vulnerability that Chinese-linked hackers have exploited in zero-day attacks since September 2026.</p><p>The vulnerability, tracked as CVE-2026-123890, affects the VMware Directory Service in vCenter Server, a management platform organizations use to manage VMware virtualized environments.</p><p>According Broadcom, the flaw allows an unauthenticated attacker with network access to a vulnerable vCenter Server to bypass authentication and gain unauthorized access.</p><p><a href=\"https://www.wiz.io/lp/claude-code-security-best-practices-cheat-sheet?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q3_INB_FORM_Claude-Code-Security-Best-Practices&amp;sfcid=701Vh00000gJQZuIAO&amp;utm_term=FY27Q4-bleepingcomputer-article-970x250-Nov&amp;utm_content=Claude-Code-Best-Practices\"><img src=\"/dailyinfo/media/6ae8114c6cc90c65.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>Successful exploitation can allow attackers to obtain administrative access to vCenter, giving them control over the virtual machines managed by the server.</p><p>Broadcom patched the vulnerability on November 19 in VMSA-2026-0009, which also fixes four other vulnerabilities affecting VMware SDDC Manager and VMware Tools for Windows.</p><p>\"You are affected if you are running any version of VMware vCenter, SDDC Manager, or VMware Tools for Windows prior to the versions listed as \"fixed\" in the VMSA,\" <a href=\"https://github.com/vmware/vcf-security-and-compliance-guidelines/blob/main/security-advisories/vmsa-2026-0009/README.md\">Broadcom's security advisory reads</a>.</p><p>\"This includes vCenter and SDDC Manager deployed standalone and as part of VMware Cloud Foundation, VMware vSphere Foundation, VMware Telco Cloud Platform, and VMware Telco Cloud Infrastructure, as well as VMware Tools installed in Windows virtual machines.\"</p><p>The company considers&nbsp;the vCenter vulnerability as an emergency update, urging organizations to install the patches as soon as possible.</p><p>Broadcom says there are no official workarounds for the vulnerabilities, although network restrictions and firewall controls can help reduce exposure.</p><p>Furthermore, the vulnerability affects vCenter regardless of whether Enhanced Linked Mode is enabled.</p><p>While Broadcom has not confirmed that the flaw was exploited, researchers at Google's Mandiant have documented attacks exploiting CVE-2026-123890.</p><h2 id=\"sec-1\">Chinese hackers exploited VMware zero-day</h2><p>In a report published today, Mandiant and Google Threat Intelligence Group (GTIG) revealed that a suspected Chinese state-sponsored hacking group tracked as Armory Castle (formerly UNC5221) exploited CVE-2026-123890 in early September 2026.</p><p>\"Successful exploitation results in a remote authentication bypass which creates an authenticated session established as <code>administrator@vsphere.local</code>,\" <a href=\"http://cloud.google.com/blog/topics/threat-intelligence/armory-castle-exploits-vsphere\">explains Mandiant</a>.</p><p>\"Using the authenticated administrator session, the attacker can execute arbitrary commands and acquire files, including the data.mdb database, by leveraging the vCenter Server Directory Service (<code>vmdird</code>) RPC interface <code>vmdirdbcp</code>.\"</p><p>Armory Castle is a cyberespionage group known for exploiting zero-day vulnerabilities in enterprise network appliances, including Citrix NetScaler and Ivanti Connect Secure devices, to breach corporate networks and deploy custom malware.</p><p>The group was also recently linked to attacks <a href=\"https://www.bleepingcomputer.com/news/security/beyondtrust-patches-zero-day-exploited-in-attacks-since-august/\">exploiting a BeyondTrust Remote Support zero-day</a>, tracked as CVE-2026-102764, which has been exploited since late August.</p><p>Mandiant says the VMware exploitation was part of the same intrusion campaign, with the attackers first compromising BeyondTrust Remote Support appliances before moving laterally into internal Linux systems and targeting VMware infrastructure.</p><p>After gaining access to an internal Linux appliance, the hackers deployed the \"SLIMSAVAGE\" web shells to maintain persistent access, escalated privileges to root, and scanned the internal network for VMware systems.</p><figure><img alt=\"SLIMSAVAGE webshell deployed on Linux servers\" height=\"300\" src=\"/dailyinfo/media/e822e7d10742f356.webp\" loading=\"lazy\" decoding=\"async\" width=\"691\">\n<figcaption><strong>SLIMSAVAGE webshell deployed on Linux servers</strong><br>\n<em>S​​ource: Mandiant</em></figcaption>\n</figure><p>The attackers then used a custom Golang exploitation tool named BONESAW to exploit CVE-2026-123890 and compromise a VMware vCenter Server.</p><p>Mandiant observed the tool successfully creating a vCenter Single Sign-On (SSO) administrator account and stealing the server's directory database, which can be used to extract further credentials.</p><p>BONESAW can also extract SAML signing keys, allowing attackers to forge authentication tokens and gain administrative access to VMware environments.</p><p>Following the exploitation, the hackers deployed another tool called SAWSNAKE, which enables so-called Golden SAML attacks to forge authentication tokens, bypass multifactor authentication, and impersonate legitimate users.</p><p>During the attack, the attackers also deployed additional web shells and backdoors, including CAGEMATCH, BEARBONES, and LAZYBONES, to execute commands, transfer files, steal credentials, and maintain access to compromised systems.</p><figure><img src=\"/dailyinfo/media/15bce6bb8695ff20.webp\" srcset=\"/dailyinfo/media/861880f8ad99234f.webp 720w, /dailyinfo/media/802ebe9314397510.webp 1200w, /dailyinfo/media/15bce6bb8695ff20.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Armory Castle attack flow\" height=\"600\" width=\"804\">\n<figcaption><strong>Armory Castle attack flow</strong><br>\n<em>Source: Mandiant</em></figcaption>\n</figure><p>The attacks ultimately allowed Armory Castle to move deeper into the victims' virtualized environments, access ESXi hosts, and extract sensitive information from virtual machines, including Windows Active Directory database files.</p><p>Mandiant says the use of two zero-day vulnerabilities in the same campaign, along with multiple malware families tailored to the targeted platforms, demonstrates the threat actor's technical expertise.</p><p>The researchers urge admins to apply the VMware security updates as soon as possible and configure additional security controls to protect their virtualization infrastructure against future attacks.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/1b401792bec0725c.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-2\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Uncover email threats your existing defenses may miss.</a>\n        </h2><p>Adaptive Security's AI agents analyze email intent, context, and behavior to uncover phishing, business email compromise, and invoice fraud.</p><p>See what's getting through with a 14-day read-only scan of Microsoft 365 or Google Workspace, with no MX changes.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Start your free email security scan.</a>\n    </p>","zhKind","complete","hd19yw6n9on2wachygxhu93xs","VMware vCenter 认证绕过漏洞 CVE-2026-123890 已被 ARMORY CASTLE 利用","漏洞","补丁","利用链","漏洞利用","VMware","Google","Microsoft","https://www.bleepingcomputer.com/news/security/vmware-patches-vcenter-zero-day-exploited-in-attacks-since-september/","BleepingComputer",{"_108":109,"_110":-5},"changelogVersion","2026-10-01T08:00","release"]
