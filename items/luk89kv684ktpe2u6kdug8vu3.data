[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795480838000,"id","luk89kv684ktpe2u6kdug8vu3","title","JLine3 内置 less 查看器搜索功能存在 ReDoS 漏洞 GHSA-2v9w-34q6-wpqx","originalTitle","jline3 leads to ReDoS in Built-in Less Viewer Search","summary","JLine3 内置 less 查看器会将用户输入的搜索模式直接编译为 Java 正则表达式，导致 ReDoS 拒绝服务。`Less.getPattern()` 用 `Pattern.compile()` 拼接用户输入，含嵌套量词的恶意模式如 `(a+)+b` 会触发灾难性回溯，使会话线程以 100% CPU 挂起；通过 `&` 过滤显示路径同样可触发。","reason","source",{"_70":82},"links",{"_59":81},"publishedAt","2026-11-23T21:02:03.000Z","discoveredAt","2026-11-23T21:17:32.950Z","timelineAt","category","vuln","tags",[77,78,79,80],"score",57,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fOR-KdMsammg","reportCount",1,"additionalSourceCount",0,{"_68":30,"_70":72},{"_68":69,"_70":71},"slug","research","name","技术研究","漏洞披露",{"_74":75,"_13":76},"publicId","daca362d-5868-4ca6-a171-61dc202a4400","JLine3内置查看器披露ReDoS漏洞","漏洞","复现","漏洞利用","漏洞分析","https://github.com/advisories/GHSA-2v9w-34q6-wpqx","GitHub 安全公告",{"_84":85,"_86":-5},"changelogVersion","2026-10-01T08:00","release"]
