[{"_1":2,"_3":4},"root",{"_5":103},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794357639000,"id","ls7fmpyylskxaymnr22grsi0u","title","Railway遭入侵，攻击者盗取凭据并产生约74万美元AI欺诈用量","originalTitle","Railway breach leads to $740,000 in fraudulent AI charges","summary","Railway称，攻击者自10月20日起利用其构建基础设施中的未知漏洞逃逸文件系统隔离，再借助错误配置的信任关系获取解密客户环境变量所需的凭据，最多涉及约100,000个工作区。","reason","Railway披露的攻击链、影响上限与处置状态较完整，可用于评估AI平台凭据暴露及多入口入侵风险。","source",{"_74":102},"links",{"_93":101},"publishedAt","2026-11-10T22:20:19.000Z","discoveredAt","2026-11-10T22:56:35.304Z","timelineAt","category","activity","tags",[75,97,77,98,99,100],"score",80,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Lawrence Abrams","body",{"_61":92,"_93":-5,"_94":95,"_96":37},"outline",[86],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fP00mw0_6XMw","reportCount",1,"additionalSourceCount",0,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","attack","name","攻击活动","exploited","在野利用","ai-agent","AI Agent 安全","identity","身份与访问",{"_83":84,"_13":85},"publicId","b79ca682-ef56-4264-ac9b-3dad774ddd23","Railway披露基础设施入侵事件",{"_11":87,"_88":89,"_90":91},"sec-1","text","发现现有防御可能遗漏的电子邮件威胁。","level",2,"<p><img alt=\"Railway\" height=\"900\" src=\"/dailyinfo/media/b96ce227daf8d385.jpg\" srcset=\"/dailyinfo/media/bbfb8280666909f5.jpg 720w, /dailyinfo/media/c5dd4513706d960f.jpg 1200w, /dailyinfo/media/b96ce227daf8d385.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>云托管提供商 Railway 表示，黑客利用了其基础设施中的漏洞，窃取客户身份验证密钥，并生成了约 $740,000 的欺诈性 AI 用量，可能导致最多 100,000 个工作区的凭据泄露。</p><p>该公司<a href=\"https://www.bleepingcomputer.com/news/security/railway-warns-devs-to-rotate-secrets-after-potential-breach/\">披露了此次事件</a>，并于 10 月 22 日警告客户，在发现有人未经授权访问存储环境变量的系统后轮换其密钥。</p><p>在今天发布的<a href=\"https://blog.railway.com/p/incident-report-october-security-incident\">新事件报告</a>中，Railway 确认，攻击者获取了其内部源代码以及最多占其工作区 1.85%（约 100,000 个）的已解密客户环境变量。</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/4e9a8167b7d47a2d.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>该公司表示，这一数字是可能受到影响的工作区上限，而非已确认密钥被窃取的工作区数量。</p><p>攻击始于 10 月 20 日，当时黑客利用了 Railway 构建基础设施中一个此前未知的漏洞，突破文件系统隔离并获取了一项内部凭据。</p><p>攻击者使用该凭据访问已存储的构建历史记录，并取得 Railway 内部源代码的副本，随后对其进行分析，以确定攻破该平台的其他方式。</p><p>接着，攻击者利用了第二个涉及信任关系配置不当的漏洞，进一步访问 Railway 的基础设施，并取得用于解密客户环境变量的凭据。</p><p>Railway 表示，此次攻击演变为一场持续约 26 小时的较量，其工程师与使用 AI 驱动代理识别并利用其基础设施中漏洞的威胁行为者展开交锋。与此同时，防御人员致力于保护这些系统。</p><p>Railway 表示：“这不是一次入侵之后进行单一修复的事件。攻击者并行探测了许多潜在路径，Railway 也并行加固了这些路径。”</p><p>据 Wiz 表示，局势不断升级，最终演变为一场代理速度的竞赛，Railway 在防御那些经过消融的模型以及类似 ARTEX 的测试框架。</p><p>Railway 表示，调查发现攻击者在专门搜寻 AI 提供商凭据，不过部分查询也针对了云服务、数据库和支付服务凭据。</p><p>被盗凭据随后被用于生成约 $740,000 的未经授权 AI 用量，Railway 正与受影响的提供商合作，为客户退款。该公司表示，对于提供商拒绝退款的费用，将由其承担。</p><p>此次入侵还暴露了 1,852 名用户的关联账户令牌，包括 GitHub OAuth 令牌和 AI 代理密钥。Railway 表示，已重置这些令牌并通知了受影响的用户。</p><p>Railway 认为，攻击者的重点是窃取 AI 凭据，用于转售或 AI 模型蒸馏，并将此次事件与近期针对 AI 开发平台的一波攻击联系起来。安全公司 Wiz 将这波攻击称为“<a href=\"https://www.wiz.io/blog/black-october-for-ai-developer-platforms\">黑色十月</a>”。</p><p>过去一个月，这波行动针对了众多 AI 开发平台，包括 Northflank、<a href=\"https://www.bleepingcomputer.com/news/security/opencode-hack-exposes-api-keys-amid-ai-distillation-attacks/\">OpenCode</a>、<a href=\"https://www.bleepingcomputer.com/news/security/warp-discloses-breach-exposing-ai-agent-logs-user-telemetry-data/\">Warp</a> 和 Lightning AI。</p><p>该公司表示，攻击者已于 10 月 21 日被完全逐出其系统，所有被利用的漏洞此后均已修复。</p><p>Railway 还发现，没有证据表明黑客下载了客户的 Git 仓库或访问了客户数据库。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/ec08be135363bed0.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体会分析邮件意图、上下文和行为，以发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>通过为期 14 天的只读扫描查看 Microsoft 365 或 Google Workspace 中有哪些邮件得以通过，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始免费的电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","数据泄露","AI 供应链","大模型","凭据","https://www.bleepingcomputer.com/news/apple/railway-breach-leads-to-740-000-in-fraudulent-ai-charges/","BleepingComputer",{"_104":105,"_106":-5},"changelogVersion","2026-10-01T08:00","release"]
