[{"_1":2,"_3":4},"root",{"_5":96},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1793665812000,"id","mnxtybnzit795ejslskcd1v8b","title","Oracle E-Business Suite CVE-2026-101767 补丁后遭探测","originalTitle","Hackers Target Critical Oracle E-Business Suite RCE Flaw Days After Security Patch","summary","Oracle E-Business Suite 的 CVE-2026-101767 已在补丁发布数日后出现利用探测。","reason","source",{"_74":95},"links",{"_85":94},"publishedAt","2026-10-28T12:48:03.000Z","discoveredAt","2026-10-28T14:07:45.345Z","timelineAt","category","activity","tags",[77,75,91,92,93],"score",73,"selected",true,"channel","news","story",{"_81":82,"_13":83},"x","sameEvent",{"_11":89,"_13":90},"readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_62":84,"_85":-5,"_86":87,"_88":36},"outline",[],"relatedStories",[80],"topics",[69,70,71],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","f2E8gDJJNkGI","reportCount",3,"additionalSourceCount",2,{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","attack","name","攻击活动","exploited","在野利用","oracle","Oracle / 甲骨文",{"_81":82,"_13":83},"publicId","6cb8a5ca-1883-47bc-9f4d-86a695efd94f","Oracle EBS高危漏洞已遭利用探测","<p><span><i></i><span>Ravie Lakshmanan</span><i></i><span>2026年10月28日</span></span><span>漏洞 / 企业安全</span></p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiBB03AGS7veiAqQ7-xPeadzhhaRvDmhOlLgQcDN0y-r1na_us5yomWjBEXCbwbw8OW_o8SSGjjqk4VZFQ4ZxLiWKQPZxlcBkzJ5lv3OlEV0rOETUKyQzWoZ74LGpSjOjrScmk1rVf0OhRmDACHG3jwSDfBnnta75I_3s_nuoWGZmcfg7NZfHBp_PEIl8aj/s1600/oracle-hack.jpg\"><img alt=\"\" src=\"/dailyinfo/media/c5537573beaa6fe1.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>据威胁情报公司 Defused Cyber 称，攻击者已开始探测 Oracle E-Business Suite (EBS) 中一个刚刚修补的关键漏洞。</p><p>相关漏洞是 Oracle E-Business Suite 中 Oracle Application Object Library 的 <strong><a href=\"https://nvd.nist.gov/vuln/detail/cve-2026-101767\">CVE-2026-101767</a></strong>（CVSS 分数：9.8）。Oracle 上周将其作为<a href=\"https://www.oracle.com/security-alerts/cpuoct2026.html\">关键补丁更新</a>的一部分进行了修补。</p><p>Horizon3.ai 的安全研究人员 Brandon Peterson、Jimi Sebree 和 Noah King 因发现该漏洞并于 2026 年 7 月 24 日向 Oracle 报告而获得致谢。</p><p>Defused Cyber 在一则 X 帖文中<a href=\"https://x.com/DefusedCyber/status/2115099999973364147\">表示</a>：“我们的 Oracle E-Business Suite 诱捕系统在今天早上，即 10 月 27 日，记录到了针对 CVE-2026-101767 的探测性利用；该漏洞是 EBS Thin Client Framework servlet 中未经身份验证的 SQL 注入，可串联利用以实现远程代码执行。”</p><p>Horizon3.ai 在该漏洞的公告中将其描述为一个未经身份验证的 SQL 注入漏洞，可串联利用以实现远程代码执行。</p><p>这家网络安全公司<a href=\"https://horizon3.ai/attack-research/vulnerabilities/cve-2026-101767/\">表示</a>：“该漏洞允许具有受影响 Thin Client Framework (TCF) servlet 网络访问权限的攻击者，以 APPS 数据库用户身份执行 SQL，随后以 EBS 应用账户身份运行操作系统命令。”</p><p>具体而言，攻击者可以向存在漏洞的 TCF servlet“/OA_HTML/AppsTCFServer”发送特制请求，以 APPS 数据库用户权限执行 SQL，并最终能够以 EBS 应用账户权限执行系统命令。</p><p>成功利用 CVE-2026-101767 可使攻击者读取或修改 APPS 可访问的应用数据，并在应用主机上执行命令。</p><p>Horizon3.ai 警告称：“根据部署情况，受影响的数据可能包括财务、薪资、HR 和采购记录。操作系统访问权限取决于遭到入侵的 EBS 应用账户所拥有的权限。”</p><p>虽然面向互联网的 EBS 部署面临的风险最高，但如果攻击者能够从已遭入侵的系统或其他可访问的网络段访问存在漏洞的 servlet，内部 EBS 系统同样可能遭到利用。</p><p>建议用户尽快更新至最新版本。如果无法立即修补，可以采用以下临时缓解措施 -</p><ul>\n  <li>从 EBS URL 防火墙允许列表中移除 /OA_HTML/AppsTCFServer，其关联组件为 oracle.apps.fnd.tcf.SocketServer。</li>\n  <li>将 EBS web tier 的访问限制为可信网络。</li>\n  <li>监控 EBS 应用主机和数据库，查找遭到入侵的迹象。</li>\n</ul><p>Horizon3.ai 还分享了以下失陷指标 -</p><ul>\n  <li>未经身份验证的 POST 请求会访问 /OA_HTML/AppsTCFServer 并实例化 Gantt 数据服务器类（oracle.apps.jtf.gantt.server.GanttDataServer），随后在后端数据库中产生活动。</li>\n  <li>未经身份验证的 Web 请求发出后不久，会进行 SQL 侦察（数据库版本、当前用户、目录对象）。</li>\n  <li>$APPLPTMP 中出现异常文件，以及 oracle 账户通过 Concurrent Manager 启动 /bin/sh 来运行操作系统命令。</li>\n</ul><p>EBS 中的漏洞是攻击者的热门目标。过去一年中，同一产品中的两个关键漏洞（<a href=\"https://thehackernews.com/2025/10/oracle-ebs-under-fire-as-cl0p-exploits.html\">CVE-2025-61882</a> 和 <a href=\"https://thehackernews.com/2026/06/oracle-e-business-suite-flaw-cve-2026.html\">CVE-2026-46817</a>，CVSS 分数：9.8）遭到积极利用，其中前者被 Cl0p 勒索软件和勒索团伙利用。</p><p>觉得这篇文章有意思吗？关注我们的 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a>，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","e33nhau4z48egyjpv6q4xca62","攻击者开始扫描 Oracle E-Business Suite 漏洞 CVE-2026-101767","漏洞利用","Oracle","数据库","https://thehackernews.com/2026/10/hackers-target-critical-oracle-e.html","The Hacker News",{"_97":98,"_99":-5},"changelogVersion","2026-10-01T08:00","release"]
