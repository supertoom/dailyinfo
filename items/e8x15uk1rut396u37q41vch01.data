[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795135235000,"id","e8x15uk1rut396u37q41vch01","title","Flyto2 Core <= 2.26.6 存在 DNS 重绑定导致的 SSRF 绕过","originalTitle","Flyto2 Core: SSRF guard validates the resolved IP but connects by hostname, allowing DNS-rebinding TOCTOU","summary","Flyto2 Core <= 2.26.6 的 SSRF 防护存在 DNS 重绑定 TOCTOU 绕过。`validate_url_ssrf` 校验解析后的公网 IP 后仍返回主机名，aiohttp 连接时再次解析域名；攻击者控制 DNS 并在两次解析间切换公网与内网 IP，即可绕过校验并读取内部资源。文章提供 PoC 证明该行为，建议固定已校验 IP 并拒绝连接时发生的不一致解析。","reason","source",{"_70":82},"links",{"_59":81},"publishedAt","2026-11-20T00:09:23.000Z","discoveredAt","2026-11-20T00:23:20.173Z","timelineAt","category","disclosure","tags",[78,79,71,80],"score",56,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fRYeFDD77u-E","reportCount",2,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","research","name","技术研究","vuln","漏洞披露",{"_75":76,"_13":77},"publicId","32c4bc08-3825-414a-b804-d7adb949cf2b","Flyto2 Core披露DNS重绑定SSRF绕过","漏洞分析","复现","利用链","https://github.com/advisories/GHSA-pfg2-w999-497v","GitHub 安全公告",{"_84":85,"_86":-5},"changelogVersion","2026-10-01T08:00","release"]
