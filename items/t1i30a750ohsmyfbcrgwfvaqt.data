[{"_1":2,"_3":4},"root",{"_5":114},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1793665813000,"id","t1i30a750ohsmyfbcrgwfvaqt","title","CERT-FR 披露 Microsoft Visual Studio 安全策略绕过漏洞 CVE-2026-118147","originalTitle","Vulnérabilité dans Microsoft Visual Studio (02 novembre 2026)","summary","Microsoft Visual Studio 存在安全策略绕过漏洞 CVE-2026-118147，可导致攻击者绕过安全策略。受影响版本包括 Visual Studio 2017 15.9 之前、2019 16.11 之前、2022 17.14 之前及 2026 18.11 之前的版本；CERT-FR 建议参考 Microsoft 2026 年 10 月 30 日安全公告获取修复补丁。","reason","source",{"_70":113},"links",{"_60":112},"publishedAt","2026-11-02T00:00:00.000Z","discoveredAt","2026-11-02T15:43:33.976Z","timelineAt","category","vuln","tags",[109,110,111],"score",45,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body",{"_105":-5,"_60":106,"_107":-5,"_108":36},"outline",[78,79,80,81,82,83,84,85],"relatedStories",[74],"topics",[67,68],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fT2I-vhC49EU","reportCount",1,"additionalSourceCount",0,{"_69":72,"_70":73},{"_69":30,"_70":71},"slug","name","漏洞披露","microsoft","Microsoft / 微软",{"_75":76,"_13":77},"publicId","1e83fcf8-327c-4ac2-a135-757fdc316ccf","CERT-FR披露Visual Studio策略绕过漏洞",{"_11":103,"_87":104,"_89":90},{"_11":101,"_87":102,"_89":90},{"_11":99,"_87":100,"_89":90},{"_11":97,"_87":98,"_89":90},{"_11":95,"_87":96,"_89":90},{"_11":93,"_87":94,"_89":90},{"_11":91,"_87":92,"_89":90},{"_11":86,"_87":88,"_89":90},"sec-8","text","Gestion détaillée du document","level",2,"sec-7","Documentation","sec-6","Solutions","sec-5","Résumé","sec-4","Systèmes affectés","sec-3","Risque","sec-2","Gestion du document","sec-1","Avis du CERT-FR","zh","<h2 id=\"sec-1\">Avis du CERT-FR</h2><p>Objet : Vulnérabilité dans Microsoft Visual Studio</p><h2 id=\"sec-2\">Gestion du document</h2><table>\n      <tbody>\n        <tr>\n          <th>Référence</th>\n          <td>CERTFR-2026-AVI-1441</td>\n        </tr>\n        <tr>\n          <th>Titre</th>\n          <td>Vulnérabilité dans Microsoft Visual Studio</td>\n        </tr><tr>\n            <th>Date de la première version</th><td>02 novembre 2026</td>\n          </tr>\n          <tr>\n            <th>Date de la dernière version</th><td>02 novembre 2026</td>\n          </tr><tr>\n          <th>Source(s)</th>\n          <td>Bulletin de sécurité Microsoft CVE-2026-118147 du 30 octobre 2026<br></td>\n        </tr>\n      </tbody>\n    </table><p>Une gestion de version détaillée se trouve à la fin de ce document.</p><h2 id=\"sec-3\">Risque</h2><ul>\n          \n            <li>Contournement de la politique de sécurité</li>\n          \n        </ul><h2 id=\"sec-4\">Systèmes affectés</h2><ul>\n          \n            <li>Microsoft Visual Studio 2017 version 15.9 antérieures à 15.9.84</li>\n          \n            <li>Microsoft Visual Studio 2019 version 16.11 antérieures à 16.11.62</li>\n          \n            <li>Microsoft Visual Studio 2022 version 17.14 antérieures à 17.14.44</li>\n          \n            <li>Microsoft Visual Studio 2026 version 18.11 antérieures à 18.11.3</li>\n          \n        </ul><h2 id=\"sec-5\">Résumé</h2><p>Une vulnérabilité a été découverte dans Microsoft Visual Studio. Elle permet à un attaquant de provoquer un contournement de la politique de sécurité.</p><h2 id=\"sec-6\">Solutions</h2><p>Se référer au bulletin de sécurité de l'éditeur pour l'obtention des correctifs (cf. section Documentation).</p><h2 id=\"sec-7\">Documentation</h2><ul>\n          \n          \n            <li>\n              <p>Bulletin de sécurité Microsoft CVE-2026-118147 du 30 octobre 2026</p>\n              <a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-118147\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-118147</a>\n            </li>\n          \n\n          \n          \n\n          \n            <li>\n              <p>Référence CVE CVE-2026-118147</p>\n              <a href=\"https://www.cve.org/CVERecord?id=CVE-2026-118147\">https://www.cve.org/CVERecord?id=CVE-2026-118147</a>\n            </li>\n          \n        </ul><h2 id=\"sec-8\">Gestion détaillée du document</h2><table>\n          <thead>\n            <tr>\n              <th>Date</th>\n              <th>Description</th>\n            </tr>\n          </thead>\n          <tbody><tr>\n              <td>02 novembre 2026</td>\n              <td>Version initiale</td>\n            </tr></tbody>\n        </table>","zhKind","complete","漏洞","补丁","Microsoft","https://www.cert.cyber.gouv.fr/avis/CERTFR-2026-AVI-1441/","CERT-FR",{"_115":116,"_117":-5},"changelogVersion","2026-10-01T08:00","release"]
