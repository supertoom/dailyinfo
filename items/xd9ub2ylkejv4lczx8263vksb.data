[{"_1":2,"_3":4},"root",{"_5":165},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":37,"_59":60},"expiresAt",1795740051000,"id","xd9ub2ylkejv4lczx8263vksb","title","Microsoft Defender for macOS 本地权限提升漏洞利用链分析","originalTitle","Race Against the (Mac)hine: Local Privilege Escalation in Microsoft Defender for macOS","summary","Microsoft Defender for macOS 存在 PID 复用竞态导致的本地权限提升链，可利用 CVE-2026-50657 任意读取文件，并利用 CVE-2026-50658 绕过授权、以 root 身份创建文件，最终通过 /etc/crontab 获得 root shell。","reason","文章以可复现的竞态利用链说明跨平台修复为何可能遗漏 macOS，并比较了两套系统的身份校验、授权和文件链接差异。","source",{"_73":164},"links",{"_153":163},"publishedAt","2026-11-15T12:00:00.000Z","discoveredAt","2026-11-15T13:31:32.304Z","timelineAt","category","disclosure","tags",[74,157,158,159,160,161,162],"score",83,"selected",true,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","body",{"_60":152,"_153":-5,"_154":155,"_156":37},"outline",[85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105],"relatedStories",[81],"topics",[67,68,69,70],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","fiw3Pdxc3rrY","reportCount",1,"additionalSourceCount",0,{"_71":79,"_73":80},{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","research","name","技术研究","vuln","漏洞披露","apple","Apple / 苹果","microsoft","Microsoft / 微软",{"_82":83,"_13":84},"publicId","9fa9e1b2-c1b2-4438-8366-030ca666b7d6","微软Defender macOS提权漏洞已修复",{"_11":150,"_107":151,"_109":110},{"_11":148,"_107":149,"_109":110},{"_11":146,"_107":147,"_109":110},{"_11":144,"_107":145,"_109":110},{"_11":142,"_107":143,"_109":110},{"_11":140,"_107":141,"_109":110},{"_11":138,"_107":139,"_109":110},{"_11":136,"_107":137,"_109":110},{"_11":134,"_107":135,"_109":110},{"_11":132,"_107":133,"_109":110},{"_11":130,"_107":131,"_109":110},{"_11":128,"_107":129,"_109":113},{"_11":126,"_107":127,"_109":113},{"_11":124,"_107":125,"_109":110},{"_11":122,"_107":123,"_109":113},{"_11":120,"_107":121,"_109":113},{"_11":118,"_107":119,"_109":110},{"_11":116,"_107":117,"_109":113},{"_11":114,"_107":115,"_109":113},{"_11":111,"_107":112,"_109":113},{"_11":106,"_107":108,"_109":110},"sec-21","text","结论 🔗","level",2,"sec-20","尝试 3：用 cron 保持简单 🔗",3,"sec-19","尝试 2：利用 Defender 自身的安装监控 LaunchDaemons 🔗","sec-18","尝试 1：LaunchDaemons 🔗","sec-17","命令执行 🔗","sec-16","暂存隔离文件 🔗","sec-15","跳过授权的可选参数 🔗","sec-14","任意文件写入（CVE-2026-50658） 🔗","sec-13","使用硬链接重定向 🔗","sec-12","一个未设门的 opcode 🔗","sec-11","任意文件读取（CVE-2026-50657） 🔗","sec-10","本地权限提升 🔗","sec-9","对端验证绕过 🔗","sec-8","对端验证 🔗","sec-7","IPC 套接字 🔗","sec-6","进程模型 🔗","sec-5","Defender 的攻击面 🔗","sec-4","对端身份与审计令牌 🔗","sec-3","系统完整性保护与强化运行时 🔗","sec-2","代码签名、Developer ID 和公证 🔗","sec-1","macOS IPC 安全机制 🔗","<p>2026年11月15日\n        <span>\n          ·\n        </span>\n        <span>\n          3726 字\n        </span>\n        <span>\n          ·\n        </span>\n        <span>\n          18 分钟阅读\n        </span>\n    </p><p>Microsoft Defender 与许多其他 EDR 和 AV 一样，都是漏洞研究的理想目标，因为它以最高权限运行，并包含许多内核级组件。另一个扩大其攻击面的关键属性是它是跨平台的：它运行在 Windows、macOS 和 Linux 上，而每个平台都有各自的一套操作系统 API 和安全控制机制。</p><p>2026年初，Microsoft Defender for Windows 中有两个本地权限提升漏洞被公开披露，并在真实环境中遭到利用。CVE-2026-33825（“BlueHammer”）利用了竞态条件，而 CVE-2026-41091 利用了 Defender 检测和修复流程中缺少符号链接验证的问题。尽管这些漏洞已得到修补，但我进一步查看了它们的根本原因，发现虽然这些漏洞可能已在 Windows 中修复，但 macOS 中安全 API 和文件系统 API 工作方式的细微差异，使这些漏洞的变体仍可被利用。</p><p>Microsoft 此后已修补了这两个漏洞，分别分配了 <strong>CVE-2026-50657</strong>（任意文件读取／信息泄露）和 <strong>CVE-2026-50658</strong>（TOCTOU 竞态条件／权限提升）。我在 BlueHat Asia 2026 上介绍了这项研究，而本文是这项研究的长篇详述。</p><p>虽然一旦获得最初的利用原语，这些漏洞本身相当简单，但我认为这是一个深入研究 macOS 特有安全机制及其与 Windows 对应机制差异的好机会。跨平台变体分析经常被忽视，但它可能揭示严重的回归问题，即某个漏洞可能已在一个操作系统中修补，却仍能在另一个操作系统中利用。</p><h2 id=\"sec-1\">macOS IPC 安全机制 <a href=\"https://spaceraccoon.dev/race-against-the-machine-defender-macos-lpe/#macos-ipc-security-mechanisms\">🔗</a></h2><p>这里的漏洞是 macOS 特有的，这既是因为 Defender for macOS 的架构不同于 Defender for Windows，也是因为操作系统本身对身份验证、授权和链接的处理方式有所不同。</p><p>特权进程间通信（IPC）处处暗藏陷阱。其模式始终相同：一个非特权用户应用程序通过某种通道向特权监听器发送请求，由后者代其执行特权操作。当监听器缺少或存在错误的身份验证／授权检查、对特权操作的输入验证不足，或操作系统授权 API 配置不正确时，问题就会发生。我此前曾写过一篇专门讨论这种类型漏洞的文章：<a href=\"https://spaceraccoon.dev/zscaler-client-connector-local-privilege-escalation/\">Zscaler Client Connector (CVE-2023-41973)</a>。操作系统提供了机制来帮助开发者避开这些陷阱，因此值得了解 macOS 在这方面提供了哪些机制。</p><h2 id=\"sec-2\">代码签名、Developer ID 和公证 <a href=\"https://spaceraccoon.dev/race-against-the-machine-defender-macos-lpe/#code-signing-developer-id-and-notarisation\">🔗</a></h2><p>macOS 上运行的每个可执行文件都经过代码签名。在 App Store 之外分发的第三方软件使用 Apple 向开发者 <strong>Team ID</strong> 签发的 <strong>Developer ID</strong> 证书进行签名（Microsoft 的是 <code>UBF8T346G9</code>），并且通常会经过<strong>公证</strong>。</p><p><strong>代码签名服务</strong> API（<code>SecStaticCodeCreateWithPath</code>、<code>SecCodeCopyGuestWithAttributes</code>、<code>SecStaticCodeCheckValidity</code>）允许用户态程序使用一种小型谓词语言验证另一个文件或运行中的进程是否满足<strong>代码签名要求</strong>。例如，<code>anchor apple</code>（由 Apple 签名）、<code>anchor apple generic</code>（链接到 Apple 根证书，包括 Developer ID）或 <code>identifier \"com.microsoft.wdav\" and certificate leaf[subject.OU] = \"UBF8T346G9\"</code>。这类似于 Windows 的 <code>WinVerifyTrust</code> API 和 Authenticode 策略。</p><p>代码签名机制使特权 macOS 守护进程能够验证 IPC 对端是否确实是供应商签名的二进制文件。也正因如此，如后文所见，把这个问题判断错误是致命的。</p><h2 id=\"sec-3\">系统完整性保护与强化运行时 <a href=\"https://spaceraccoon.dev/race-against-the-machine-defender-macos-lpe/#system-integrity-protection-and-the-hardened-runtime\">🔗</a></h2><p>系统完整性保护（SIP）是一种默认启用、由内核强制执行的强制访问控制机制：它禁止修改受保护的位置，也禁止附加到受保护进程或向其中注入代码。SIP 是攻击者无法直接注入 Defender 的某个已签名辅助进程以借用其身份进行 IPC 的原因。启用 SIP 后，针对 Apple 已签名或经过强化二进制文件的 <code>task_for_pid</code>（进程注入）会失败，而 <code>DYLD_*</code> 注入（大致相当于 Windows 上的 DLL 注入）也会被阻止。因此，要冒充可信进程进行 IPC，漏洞利用必须找到目标中的<em>其他</em>缺陷。</p><p>Defender 的 IPC 构建在 macOS <a href=\"https://developer.apple.com/documentation/security/authorization-services\">授权服务</a>之上，以执行特权操作。由于这个 API 经常被误解，因此有必要准确说明它的用途。</p><p>程序获取 <code>AuthorizationRef</code>，然后调用：</p><pre><code><span><span>OSStatus <span>AuthorizationCopyRights</span>(AuthorizationRef authorization,\n</span></span><span><span>                                 <span>const</span> AuthorizationRights <span>*</span>rights,\n</span></span><span><span>                                 <span>const</span> AuthorizationEnvironment <span>*</span>environment,\n</span></span><span><span>                                 AuthorizationFlags flags,\n</span></span><span><span>                                 AuthorizationRights <span>**</span>authorizedRights);\n</span></span></code></pre><p>使用字符串键（例如 <code>com.microsoft.mdatp.controllogging</code>）指定一个或多个<strong>权限</strong>。该调用会查询系统的<strong>授权策略数据库</strong>，其中将每项权限映射到一条<strong>规则</strong>。内置规则包括 <code>allow</code>、<code>deny</code>、<code>is-root</code>、<code>authenticate-admin</code> 和 <code>authenticate-session-owner</code>。如果规则得到满足，该调用会返回 <code>errAuthorizationSuccess</code>。Csaba Fitzl（theevilbit）对 macOS 授权机制进行了<a href=\"https://theevilbit.github.io/posts/macos_authorization/\">深入剖析</a>。</p><p>在我分析的版本中，Defender 在策略数据库中注册了十三项自定义权限。读取一条实际生效的规则可以了解其要求。例如：</p><pre><code><span><span>security authorizationdb read com.microsoft.mdatp.readlogs\n</span></span></code></pre><p>返回一条规则，其中 <code>rule</code> 数组为 <code>is-root</code> <em>或</em> <code>authenticate-admin-30</code>。换言之，<strong>如果该授权所属进程已经是 root，或者任何管理员在弹出对话框中完成身份验证</strong>（凭据缓存为 30 秒），则授予该权限。</p><p>关键在于，用 Apple 自己的术语来说，此功能是选择性启用的，也就是<strong>“自我限制”</strong>。<code>AuthorizationCopyRights</code>提供的保护只有在代码选择调用它并根据结果采取行动时才有意义。它<em>不是</em>操作系统维护的强制执行边界。</p><h2 id=\"sec-4\">对端身份与审计令牌 <a href=\"https://spaceraccoon.dev/race-against-the-machine-defender-macos-lpe/#peer-identity-and-audit-tokens\">🔗</a></h2><p>macOS 提供多种 IPC 机制：Mach 消息、<strong>XPC</strong> 和 <strong>NSXPC</strong>（现代且推荐的抽象），以及包括 <code>AF_UNIX</code> 在内的传统 BSD 套接字。Defender 的 <code>wdavdaemon</code> 使用 <code>AF_UNIX</code> 流式套接字。</p><p>任何特权监听程序面临的核心问题都是<em>对端身份</em>：另一端是哪个进程，它是否有权执行此操作？判断错误通常都是本地权限提升（LPE）的前兆。在 macOS 上，程序可以通过几种方式回答这个问题：</p><ul>\n<li><strong><code>getsockopt(client, SOL_LOCAL, LOCAL_PEERPID, …)</code></strong>获取对端的进程 ID（pid），该值是<strong>在 <code>connect()</code> 时</strong>获取的。XNU（macOS 内核）会记录一次，之后永不更新。</li>\n<li><strong><code>proc_pidpath(pid, …)</code></strong>获取指定 pid 对应可执行文件的<strong>当前</strong>绝对文件系统路径。它回答的是“pid N <em>此刻</em>运行的是什么映像？”如果进程使用 <code>execve()</code> 重新执行自身，该值就会发生变化。</li>\n<li><strong><code>getsockopt(client, SOL_LOCAL, LOCAL_PEERTOKEN, …)</code></strong>，或用于 XPC 的 <code>xpc_connection_get_audit_token</code>，获取对端的 <strong>审计令牌</strong>，这是一个不透明的结构体，除其他字段外还携带 <code>pid</code> <strong>和</strong> <code>pidversion</code> 代计数器，该计数器会在每次 <code>execve</code> 时递增。审计令牌还携带用于查找权限的 <code>signing_id</code>。它是唯一既与特定进程绑定、又会在该进程重新执行时失效的对端凭据。（Scott Knight 有一篇很好的<a href=\"https://knight.sc/reverse%20engineering/2020/03/20/audit-tokens-explained.html\">审计令牌文章</a>。）</li>\n</ul><p>一种常见且存在漏洞的模式是只依赖前两项：获取对端的 pid，然后根据该 pid 检查可执行文件路径是否在允许列表中。这会在捕获 pid 与检查路径之间产生竞态窗口。这种“PID 复用”技术由 Samuel Groß（5aelo）在其 <a href=\"https://saelo.github.io/presentations/warcon18_dont_trust_the_pid.pdf\">《不要信任 PID！》</a> WarCon 2018 演讲中提出。</p><h2 id=\"sec-5\">Defender 的攻击面 <a href=\"https://spaceraccoon.dev/race-against-the-machine-defender-macos-lpe/#defenders-attack-surface\">🔗</a></h2><h2 id=\"sec-6\">进程模型 <a href=\"https://spaceraccoon.dev/race-against-the-machine-defender-macos-lpe/#process-model\">🔗</a></h2><p>在正在运行的 Defender for macOS 安装中，相关进程包括：</p><table>\n<thead>\n<tr>\n<th>进程</th>\n<th>权限</th>\n<th>角色</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><code>wdavdaemon</code></td>\n<td>root</td>\n<td>特权代理。拥有两个 IPC 套接字、引擎、隔离区和诊断功能。</td>\n</tr>\n<tr>\n<td><code>wdavdaemon_enterprise</code></td>\n<td>root</td>\n<td>EDR 工作进程（企业功能）。</td>\n</tr>\n<tr>\n<td><code>wdavdaemon_unprivileged</code></td>\n<td><code>_mdatp</code></td>\n<td>扫描工作进程；与 root 守护进程通信。</td>\n</tr>\n<tr>\n<td><code>Microsoft Defender Helper</code></td>\n<td>user</td>\n<td>GUI/托盘辅助进程。</td>\n</tr>\n</tbody>\n</table><p>具有 root 权限的 <code>wdavdaemon</code> 由 Microsoft 签名（Team ID <code>UBF8T346G9</code>），并作为 LaunchDaemon 运行。</p><h2 id=\"sec-7\">IPC 套接字 <a href=\"https://spaceraccoon.dev/race-against-the-machine-defender-macos-lpe/#ipc-sockets\">🔗</a></h2><p><code>wdavdaemon</code> 暴露两个 <code>AF_UNIX</code> 流套接字：</p><ul>\n<li><code>/var/run/wdavdaemon.sock</code>：<strong>公共</strong>套接字。</li>\n<li><code>/var/run/priv_wdavdaemon.sock</code>：<strong>私有</strong>套接字。</li>\n</ul><p>两者均以模式 <strong><code>0666</code></strong>（<code>srw-rw-rw-</code>）创建，归 root 所有，因此<strong>任何本地进程都可以连接它们</strong>。“私有”套接字仅在意图上属于私有：它处理更敏感的操作码（威胁处理、配置），但同样可以访问。</p><p>\n  <img src=\"/dailyinfo/media/acd16dffa6e0c3a2.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Both IPC sockets are world-writable srw-rw-rw-\">\n</p><p>两个套接字都通过 <code>SOCK_STREAM</code> 共享一种数据包结构：</p><pre><code><span><span>frame_header (16 bytes, big-endian)\n</span></span><span><span>  u32  seq            ; sequence, echoed in the reply\n</span></span><span><span>  u8   reserved[8]    ; always zero\n</span></span><span><span>  u32  body_len       ; length of body that follows\n</span></span><span><span>body (body_len bytes)\n</span></span><span><span>  u32  opcode  (little-endian)\n</span></span><span><span>  ...  payload        ; opcode-specific\n</span></span></code></pre><p>本文关注两个操作码：</p><table>\n<thead>\n<tr>\n<th>操作码</th>\n<th>名称</th>\n<th>操作</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><code>0x05</code></td>\n<td><code>handle_threat</code></td>\n<td>隔离/还原文件</td>\n</tr>\n<tr>\n<td><code>0x0f</code></td>\n<td><code>get_diagnostic_files</code></td>\n<td>生成一个全局可读的 ZIP</td>\n</tr>\n</tbody>\n</table><p>大多数特权操作码最终都会调用 <code>AuthorizationCopyRights</code>（重新检查 <code>com.microsoft.mdatp.*</code> 权限），该调用位于 <code>libwdavdaemon_core.dylib</code> 内。如果正文载荷中没有有效的 32 字节 <code>AuthorizationExternalForm</code> 结构，受限制的操作码会返回统一的“auth-failed”响应，并且处理程序不会运行。这是一个合理的<em>同意</em>门控，但它只能证明管理员已同意，<strong>不能</strong>证明调用方是真正的 Defender 客户端。调用方身份完全委托给单独执行的逐连接对端检查。</p><h2 id=\"sec-8\">对端验证 <a href=\"https://spaceraccoon.dev/race-against-the-machine-defender-macos-lpe/#peer-validation\">🔗</a></h2><p>在任何处理程序运行之前，守护进程会验证连接的对端：</p><ol>\n<li><code>getsockopt(SOL_LOCAL, LOCAL_PEERPID)</code>，用于获取对端连接时的 pid。</li>\n<li><code>proc_pidpath(pid, …)</code>，用于获取该 pid <em>当前</em>的可执行文件路径。</li>\n<li>将该路径与运行时构建的允许列表进行严格前缀匹配，允许列表以 <code>\"/Applications/Microsoft Defender.app\"</code> 开头。匹配会强制执行目录边界，因此 <code>/Applications/Microsoft Defender.appEVIL</code> 不会通过。</li>\n<li>路径匹配后，执行代码签名服务要求检查（<code>anchor apple</code> / <code>anchor apple generic</code>）。对于非捆绑应用的对端，永远不会执行到这一步，因为前缀检查会先将其拒绝。</li>\n<li>失败时，返回 <code>shutdown(SHUT_RDWR)</code> + <code>close()</code>。从客户端来看，这表现为握手过程中出现 EOF。</li>\n</ol><p>对于普通的 uid-501 进程，第 3 步会无条件拒绝。但请注意，第 1 步和第 2 步使用了同一对端的<em>两种不同</em>表示：冻结的 pid 和实时的路径。这容易受到 PID 复用竞态攻击。</p><h2 id=\"sec-9\">对端验证绕过 <a href=\"https://spaceraccoon.dev/race-against-the-machine-defender-macos-lpe/#peer-validation-bypass\">🔗</a></h2><p>该竞态的利用方式很直接：</p><ul>\n<li>在对端连接时捕获 <strong><code>LOCAL_PEERPID</code></strong>，此后它不可变。</li>\n<li><strong><code>proc_pidpath</code></strong> 返回 pid <em>当前</em>的可执行文件路径，我们可以使用 <code>execve()</code> 修改该路径。</li>\n</ul><p>严格来说，我在这里使用的 PID 复用变体并不是回收的 pid 号落到另一个不同进程上，而是<em>同一个</em>进程重新 <code>execve</code>-ing，以改变其 pid 所解析到的路径；这属于同一 pid-trust 家族。</p><p>关于 <code>execve</code> 的关键事实是，内核会在<em>返回用户态之前、在新映像的第一条指令运行之前</em>更新进程记录的映像路径。被 exec 的二进制文件不必可用，不必执行任何 IPC，甚至不必存活。它只需要在守护进程调用 <code>proc_pidpath</code> 之前<em>导致 pid 路径更新</em>即可。</p><p>因此，该漏洞利用会 fork 许多子进程，每个子进程都像这样竞争：</p><ol>\n<li><code>s = socket(AF_UNIX, SOCK_STREAM)</code></li>\n<li><code>connect(\"/var/run/wdavdaemon.sock\")</code>：<code>LOCAL_PEERPID</code> 现在已冻结到该子进程的 pid。</li>\n<li><code>send([16B header][u32 LE 0x0f])</code>：请求已排队。</li>\n<li><code>execve(\"/Applications/Microsoft Defender.app/Contents/MacOS/wdavdaemon_unprivileged.app/Contents/MacOS/wdavdaemon_unprivileged\", argv=[\"wdavdaemon\"], …)</code>：内核将 pid 路径更新为一个列入允许列表、由 Microsoft 签名的二进制文件（该文件随后会立即因其单例检查而退出，但这没关系）。</li>\n</ol><p>与此同时，在 <code>accept()</code> 之后，守护进程：</p><ol>\n<li><code>getsockopt(LOCAL_PEERPID, &amp;pid)</code>：pid 是该子进程的 pid。</li>\n<li><code>proc_pidpath(pid, path)</code>：此时记录的路径。</li>\n<li><code>prefix-match(path, \"/Applications/Microsoft Defender.app\")</code>。</li>\n<li>匹配 → 运行处理程序；不匹配 → <code>shutdown(fd)</code>。</li>\n</ol><p>如果守护进程的步骤 2 在子进程的步骤 4 <em>之后</em>运行，<code>proc_pidpath</code> 将返回 bundle 路径，检查便会通过，尽管实际连接的进程是攻击者自己的程序（在我的 PoC 中是一个 Perl 脚本）。当守护进程读取该路径时，该子进程已经重新 exec 成列入允许列表、由 Microsoft 签名的二进制文件，而这正是同时满足前缀匹配和代码签名检查的条件。攻击者控制的子进程现在可以向 <code>wdavdaemon</code> 发起任意 IPC 调用。</p><h2 id=\"sec-10\">本地权限提升 <a href=\"https://spaceraccoon.dev/race-against-the-machine-defender-macos-lpe/#local-privilege-escalation\">🔗</a></h2><p>绕过对端检查后，我们可以在任一 socket 上调用任何 opcode，并将 Defender 自身的特权处理程序变成漏洞利用原语。有两个 opcode 可以实现这一点：<code>0x0f get_diagnostic_files</code> 可实现以 root 身份进行任意文件读取，<code>0x05 handle_threat::restore</code> 可实现以 root 身份进行任意文件写入。</p><h2 id=\"sec-11\">任意文件读取（CVE-2026-50657） <a href=\"https://spaceraccoon.dev/race-against-the-machine-defender-macos-lpe/#arbitrary-file-read-cve-2026-50657\">🔗</a></h2><h3 id=\"sec-12\">一个未设门的 opcode <a href=\"https://spaceraccoon.dev/race-against-the-machine-defender-macos-lpe/#an-ungated-opcode\">🔗</a></h3><p>与权限更高的 opcode 不同，<code>0x0f get_diagnostic_files</code> <strong>完全不会</strong>通过 <code>AuthorizationCopyRights</code> 这道门。仅发送正文 <code>[u32 LE 0x0f]</code>、不带任何授权 blob，就会返回一个格式完整的回复：</p><pre><code><span><span>result&lt;optional&lt;boost::filesystem::path&gt;&gt;  OK\n</span></span><span><span>path = \"/Library/Application Support/Microsoft/Defender/wdavdiag/&lt;UUID&gt;.zip\"\n</span></span></code></pre><p>每次调用都会让 root 守护进程在 <code>/Library/Application Support/Microsoft/Defender/wdavdiag/</code> 下以 UUID 命名路径构建一个<em>全新</em>的诊断归档，该目录<strong>可被全局读取和搜索</strong>（<code>0755 root:wheel</code>）。</p><p>\n  <img src=\"/dailyinfo/media/a624b7c033f2f847.webp\" loading=\"lazy\" decoding=\"async\" alt=\"The wdavdiag directory is world-readable and holds the generated archive\">\n</p><p>检查生成的 ZIP 可以发现，归档器除其他内容外，还会收集<strong><code>$HOME/Library/Logs/Microsoft/Defender/</code> 下的所有常规文件</strong>。这是用户自己的日志目录，会在首次启动时自动创建。归档器使用守护进程正常的打开例程打开每个文件。守护进程是 root，因此 <code>open(O_RDONLY)</code> 会对该路径解析到的任何目标成功。</p><p>\n  <img src=\"/dailyinfo/media/2c3617661ed782b0.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Unzipping the archive reveals the collected Defender log files\">\n</p><h3 id=\"sec-13\">使用硬链接重定向 <a href=\"https://spaceraccoon.dev/race-against-the-machine-defender-macos-lpe/#redirecting-with-a-hardlink\">🔗</a></h3><p><code>$HOME/Library/Logs/Microsoft/Defender/</code> 归用户所有（uid 501，<code>0755</code>），因此用户可以在其中创建目录项，包括<strong>硬链接</strong>。使其成为任意读取的微妙之处在于 POSIX <code>link(2)</code> 的一项性质：它<strong>不</strong>要求对源文件具有读取权限。它只要求源路径的各组成部分可搜索，并且目标目录可由调用者写入。</p><p>因此，以 uid 501 的身份执行：</p><pre><code><span><span>link(<span>\"/etc/kcpassword\"</span>,\n</span></span><span><span>     <span>\"/Users/eugenelim/Library/Logs/Microsoft/Defender/microsoft_defender_app_logs.log\"</span>);\n</span></span></code></pre><p>是合法的，即使目标是仅限 root 访问的。现在，植入的目录项虽然位于用户拥有的目录中，却指向 root 拥有的 inode。</p><p>为什么使用硬链接而不是符号链接？当归档程序遍历目录时，它会检查每个条目，并使用 boost filesystem 库函数 <code>boost::filesystem::status()</code> 仅归档<strong>常规文件</strong>；该函数返回一个带有 <code>file_type</code> 枚举成员的 <code>file_status</code>。被拒绝的类型包括 <code>directory_file</code>、<code>symlink_file</code>、<code>block_file</code>、<code>character_file</code>、<code>fifo_file</code>、<code>socket_file</code>、<code>reparse_file</code> 和 <code>type_unknown</code>，因此植入的<em>符号链接</em>会被过滤掉，永远不会到达 <code>open()</code>。</p><p>\n  <img src=\"/dailyinfo/media/1638d95cfb2f3c80.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Defender only copies files that report as regular_file\">\n</p><p>另一方面，硬链接并不是一种独立的文件类型：它会报告为普通的常规文件（<code>S_IFREG</code>、<code>uid=0</code>），并通过常规文件过滤器。以 root 权限运行的守护进程打开该 inode，并将其字节流式写入可被全球读取的 ZIP，随后用户读取该 ZIP。</p><p>这是 CVE-2026-41091 在 macOS 上的对应问题，但仅针对符号链接的修复无法阻止它。与 Windows 硬链接不同，自 2015 年起，Windows 硬链接就需要对目标拥有 <code>FILE_WRITE_ATTRIBUTES</code> 访问权限，正如 James Forshaw 在 <a href=\"https://projectzero.google/2015/12/between-rock-and-hard-link.html\">Between a Rock and a Hard Link</a> 中所记录的那样；而 macOS 硬链接完全不需要访问目标。这是 macOS 与 Windows 在安全假设上的一个关键差异。</p><p>以 root 权限读取文件后，进一步提升权限十分容易。 juicy 目标包括 <code>/var/db/dslocal/nodes/Default/users/*.plist</code>（<code>ShadowHashData</code> 本地账户密码哈希，相当于 macOS 的 SAM）、<code>/etc/kcpassword</code>（经过 XOR 混淆的自动登录密码）、<code>TCC.db</code>、其他用户的 <code>~/Library</code> 机密、SSH 密钥和浏览器 Cookie 存储。</p><h2 id=\"sec-14\">任意文件写入（CVE-2026-50658） <a href=\"https://spaceraccoon.dev/race-against-the-machine-defender-macos-lpe/#arbitrary-file-write-cve-2026-50658\">🔗</a></h2><p>第二个漏洞针对 <strong>私有</strong>套接字和 <code>handle_threat::restore</code> 操作（操作码 <code>0x05</code>，子操作 <code>restore</code>），它允许已授权管理员将隔离文件释放到选定目的地。</p><h3 id=\"sec-15\">跳过授权的可选参数 <a href=\"https://spaceraccoon.dev/race-against-the-machine-defender-macos-lpe/#the-optional-that-skips-authorization\">🔗</a></h3><p>恢复请求将其 <code>AuthorizationExternalForm</code> 编码为 <code>std::optional&lt;array&lt;u8,32&gt;&gt;</code>。这是一个存在字节；<em>仅当该字节存在时</em>，后面才会跟长度和对应字节：</p><pre><code><span><span>body (opcode 0x05 restore):\n</span></span><span><span>  u32 LE opcode      = 5\n</span></span><span><span>  u32 LE pad         = 0\n</span></span><span><span>  u64 LE tid_len     + threat_id            ; ASCII UUID, 36 bytes\n</span></span><span><span>  u32 LE sub_action  = 1                     ; restore\n</span></span><span><span>  u8  has_dest_path  = 1\n</span></span><span><span>  u64 LE dest_len    + dest_path             ; daemon writes here, as root\n</span></span><span><span>  u8  has_auth_blob  = 0   &lt;-- THE BYPASS    ; no bytes follow\n</span></span></code></pre><p>当 <code>has_auth_blob = 0</code> 时，反序列化器会读取一个<strong>缺失的可选参数</strong>，而处理程序会<strong>完全跳过授权</strong>。它从不调用 <code>AuthorizationCreateFromExternalForm</code> 或 <code>AuthorizationCopyRights</code>。</p><p>\n  <img src=\"/dailyinfo/media/16c225aa1dff5817.webp\" loading=\"lazy\" decoding=\"async\" alt=\"With has_auth_blob = 0 the handler skips straight past the authorization check\">\n</p><p>这是一条不同于提供无效授权数据块的代码路径：32 字节全零数据块（<code>has_auth_blob = 1</code>，内容为零）会在 <code>AuthorizationCreateFromExternalForm</code> 处被正确地<em>拒绝</em>。恰恰是<em>缺失的</em>可选参数会绕过检查。</p><p>唯一剩下的关卡是私有套接字的对端验证，它采用相同的 <code>getsockopt(LOCAL_PEERPID) → proc_pidpath → SecStaticCodeCreateWithPath</code> 模式，因此同样容易受到 PID 重用竞态条件的影响。因此，非 root 用户可以将任意隔离文件恢复到任意目的地。</p><h3 id=\"sec-16\">暂存隔离文件 <a href=\"https://spaceraccoon.dev/race-against-the-machine-defender-macos-lpe/#staging-the-quarantined-file\">🔗</a></h3><p>恢复处理程序会恢复一个<em>先前已被隔离</em>的文件，因此攻击者首先让 Defender 隔离攻击者控制的字节：将 EICAR 字符串写入 <code>/tmp/&lt;name&gt;</code>，实时保护会将其隔离，并在隔离元数据中<strong>保留原始基本文件名</strong>。</p><p>隔离文件会落入 <code>/Library/Application Support/Microsoft/Defender/quarantine/</code>，成为<strong>用户拥有</strong>的文件，其内容仅经过 <code>XOR(0x25)</code> 编码。因此，攻击者可以轻易将隔离的 EICAR 替换为任意内容，并将其暂存以供恢复。攻击接着触发 <code>restore</code>，并提供可控的 <code>dest_path</code>；Defender 会解码该内容，并将攻击者控制的内容写入 <code>&lt;DEST_PATH&gt;/&lt;ORIGINAL_BASE_NAME&gt;</code>。这实际上相当于以 root 权限进行任意文件写入。</p><p>有一个重要限制：恢复流程只能写入<strong>尚不存在</strong>的路径。</p><p>\n  <img src=\"/dailyinfo/media/f855e2b1f3617090.webp\" loading=\"lazy\" decoding=\"async\" alt=\"The restore worker refuses to clobber an existing destination\">\n</p><p>处理程序会检查目标路径的状态；如果该路径已存在，原则上可以使用覆盖并备份模式，但对于恢复子操作，相关标志被硬编码为<strong>不覆盖</strong>路径，并以 <code>EEXIST</code> 拒绝请求。因此，我们获得的是任意文件<em>创建</em>原语，而不是覆盖原语。</p><h2 id=\"sec-17\">命令执行 <a href=\"https://spaceraccoon.dev/race-against-the-machine-defender-macos-lpe/#command-execution\">🔗</a></h2><p>这一部分有点尴尬，但“仅创建”约束让我困扰了很久，因为我所知道的多数将文件写入权限提升为代码执行的方法，都依赖于覆盖现有文件或向其追加内容。我尝试了三次。</p><h3 id=\"sec-18\">尝试 1：LaunchDaemons <a href=\"https://spaceraccoon.dev/race-against-the-machine-defender-macos-lpe/#attempt-1-launchdaemons\">🔗</a></h3><p>LaunchDaemons（位于 <code>/Library/LaunchDaemons/</code>）是 macOS 中与 Windows 计划任务或服务相对应的机制，而投放一个 LaunchDaemon 不需要覆盖任何文件，所以看起来非常合适。然而，具有 root 权限的 LaunchDaemon 脚本必须归 <code>root</code> 所有，而恢复过程会使用 <code>chown</code> 恢复<em>原始</em>所有者：</p><pre><code><span><span>1. open(&lt;dest&gt;/&lt;basename&gt;.tmp, O_CREAT|O_EXCL)        ; created as root\n</span></span><span><span>2. write(decoded original bytes)\n</span></span><span><span>3. rename(&lt;dest&gt;/&lt;basename&gt;.tmp, &lt;dest&gt;/&lt;basename&gt;)\n</span></span><span><span>4. chown(&lt;dest&gt;/&lt;basename&gt;, source_uid, source_gid)   ; BY PATH, not fchown\n</span></span></code></pre><p>步骤 4 <code>chown</code>s 按<strong>路径</strong>执行，而不是按打开的 fd 执行。在步骤 3 和步骤 4 之间，最终文件已经存在且归 root 所有，因此如果 <code>&lt;dest&gt;</code> 是一个<strong>符号链接</strong>，且其目标在该时间窗口内被替换，那么步骤 4 的 <code>chown</code> 将落到<em>另一个</em>文件（诱饵文件）上，而真正的目标文件仍归 root 所有。这比 PID 复用的竞态窗口小得多，但理论上仍有可能成功。</p><p>遗憾的是，非特权用户无法 <code>launchctl bootstrap</code> 系统域的 plist，因此，即使一个完全归 root 所有的 LaunchDaemon，在系统重启之前也不会有任何攻击者可控制的触发器。</p><h3 id=\"sec-19\">尝试 2：利用 Defender 自身的安装监控 LaunchDaemons <a href=\"https://spaceraccoon.dev/race-against-the-machine-defender-macos-lpe/#attempt-2-defenders-own-install-monitor-launchdaemons\">🔗</a></h3><p>如果我自己无法引导启动 LaunchDaemon，或许 Defender 可以。该产品为其 tracer 和 DLP 子系统提供了<em>安装监控</em> LaunchDaemons，当受监控的文件出现在 <code>/Library/Application Support/Microsoft/{DLP, Defender/dlp_processor, Defender/tracer}/install/</code> 下时，会运行一个 root 脚本。该脚本（<code>install_helper</code>）会将一个 daemon plist 复制到 <code>/Library/LaunchDaemons/</code> 并引导启动：</p><pre><code><span><span>cp  <span>\"&lt;app-bundle&gt;/.../com.microsoft.wdav.tracedaemon.plist\"</span>  /Library/LaunchDaemons/\n</span></span><span><span>launchctl bootstrap system  /Library/LaunchDaemons/com.microsoft.wdav.tracedaemon.plist\n</span></span></code></pre><p>乍看之下，这是一条确定性且无需重启的路径。但它因同样的原因而失败：写入原语只能<em>创建</em>。<code>cp</code> 源是应用包内一个预先存在、归 root 所有的 plist，恢复处理程序拒绝覆盖它，因此该脚本始终会部署 Defender 自己的 plist，而不是我的 plist。另一方面，在 <code>cp</code><em>目标位置</em>植入文件也会失败，因为 root 的 <code>cp</code> 会在 <code>bootstrap</code> 之前将其覆盖；我同样无法锁定目标位置，因为将文件设为不可变需要拥有该文件，而 <code>launchd</code> 又要求该 plist 归 root 所有。这条路线的每种变体都依赖于重写一个已经存在的文件，而这恰恰是该原语无法做到的。</p><h3 id=\"sec-20\">尝试 3：用 cron 保持简单 <a href=\"https://spaceraccoon.dev/race-against-the-machine-defender-macos-lpe/#attempt-3-keeping-it-simple-with-cron\">🔗</a></h3><p>macOS 仍然内置了大量旧式 Unix 构件，其中之一就是 <code>cron</code>。</p><p>macOS 上的 <code>cron</code> 本身就是一个 launchd 作业，即 <code>com.vix.cron</code>，在标准安装中它虽然已弃用，但仍处于休眠状态。不存在 <code>/etc/crontab</code>，并且该作业的 <code>KeepAlive</code> 是一个监视该确切路径的 <code>PathState</code> 条件：</p><pre><code><span><span><span>&lt;key&gt;</span>KeepAlive<span>&lt;/key&gt;</span>\n</span></span><span><span><span>&lt;dict&gt;</span>\n</span></span><span><span>    <span>&lt;key&gt;</span>PathState<span>&lt;/key&gt;</span>\n</span></span><span><span>    <span>&lt;dict&gt;</span>\n</span></span><span><span>        <span>&lt;key&gt;</span>/etc/crontab<span>&lt;/key&gt;</span>\n</span></span><span><span>        <span>&lt;true/&gt;</span>\n</span></span><span><span>    <span>&lt;/dict&gt;</span>\n</span></span><span><span><span>&lt;/dict&gt;</span>\n</span></span></code></pre><p>因此，创建 <code>/etc/crontab</code> 会立即启动 <code>cron</code>，无需重启。由于该文件通常不存在，这属于创建而非覆盖，非常适合该写入原语。讽刺的是，正是由于弃用了 <code>cron</code>，macOS 才使这条链成为一个完美的候选项。</p><p>更好的是，它绕过了让 LaunchDaemon 路线失败的所有权问题。LaunchDaemon 必须归 root 所有，否则 <code>launchd</code> 会拒绝它，这正是上面迫不得已要利用 <code>chown</code>-TOCTOU 竞态的原因。<code>cron</code> 对 <code>/etc/crontab</code> 并无此类规则：它会读取文件，并以每行第六个字段中指定的用户身份运行该行的命令。以 <code>* * * * * root …</code> 开头的行即使在文件本身归 uid 501 所有时，也会以 <strong>root</strong> 身份运行。</p><p>载荷是单行 system-crontab 内容：</p><pre><code><span><span>* * * * * root /bin/sh -c 'cp /bin/zsh /tmp/lpe_root_shell; chown root:wheel /tmp/lpe_root_shell; chmod 4755 /tmp/lpe_root_shell'\n</span></span></code></pre><p>至此，端到端的提权链就完成了：准备一个名为 <code>crontab</code> 的 EICAR 文件，把它的隔离区 blob 替换为上面那一行，然后用 <code>dest = /etc</code> 执行跳过认证的恢复操作。对等竞态赢得 <code>/etc/crontab</code>（uid 501，<code>0644</code>）；<code>launchd</code> 启动 <code>cron</code>；<code>/tmp/lpe_root_shell -p</code> 在写入后大约一分钟内触发一个交互式 root shell。只需赢下这一个对等竞态，可靠性就高得多。</p><h2 id=\"sec-21\">结论 <a href=\"https://spaceraccoon.dev/race-against-the-machine-defender-macos-lpe/#conclusion\">🔗</a></h2><p>这两个漏洞都已报告给微软安全响应中心（MSRC），并已在 2026 年 7 月的补丁星期二修复：</p><table>\n<thead>\n<tr>\n<th></th>\n<th>CVE-2026-50657</th>\n<th>CVE-2026-50658</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>类别</td>\n<td>向未授权行为主体暴露私人个人信息</td>\n<td>TOCTOU 竞态条件</td>\n</tr>\n<tr>\n<td>影响</td>\n<td>本地信息泄露（任意文件读取）</td>\n<td>本地权限提升（任意文件写入 → root）</td>\n</tr>\n</tbody>\n</table><p>这些 macOS 本地权限提升漏洞是独立于 Windows 那些漏洞发现的，但它们与 2026 年 Windows Defender 的提权链如出一辙并非巧合。真正有意思的是，同<em>两类漏洞</em>在 macOS 的 IPC 与安全原语中被处理的方式截然不同。</p><table>\n<thead>\n<tr>\n<th></th>\n<th>Windows</th>\n<th>macOS</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><strong>进程身份</strong></td>\n<td>依赖进程句柄；内核在内存中锁定进程对象。</td>\n<td>必须显式检查审计令牌，以缓解 PID 复用。</td>\n</tr>\n<tr>\n<td><strong>授权</strong></td>\n<td>由内核依据访问令牌与完整性级别，针对目标的 ACL 进行求值。</td>\n<td>对 Authorization Services API 的“自限制”（opt-in）使用。</td>\n</tr>\n</tbody>\n</table><p>由于这些差异，该漏洞利用在 macOS 上的运作方式也不同：</p><ul>\n<li><strong>身份。</strong> Windows 上的 TOCTOU 通常是在检查与使用之间移动一个<em>文件</em>。macOS 提供了更强的原语：<code>execve</code> 在连接与检查之间改变一个进程的<em>路径</em>。这就是 PID 复用攻击如此可靠的原因；攻击者可以在自己的进程内部精确控制主体替换的时刻。</li>\n<li><strong>链接。</strong> 在 Windows 上，链接创建受到相对较多的限制：符号链接需要 <code>SeCreateSymbolicLinkPrivilege</code>（默认由管理员组持有），硬链接需要对其目标的写权限，而目录联接（junction）不需要任何权限，但只能重定向<em>目录</em>，如今可通过 <a href=\"https://www.microsoft.com/en-us/msrc/blog/2025/06/redirectionguard-mitigating-unsafe-junction-traversal-in-windows\">RedirectionGuard</a> 加以缓解。macOS 使用类 Unix 风格的链接，而 <code>link(2)</code> 不需要对目标有任何读或写权限，只需要一个可搜索的路径和一个可写的目标目录。这正是非 root 用户得以实现特权读取的原因。</li>\n<li><strong>授权。</strong> 在 Windows 上，授权由令牌、完整性级别和 ACL 中介。在 macOS 上，Authorization Services 是<em>自限制</em>的，因此实现不当很容易埋下陷阱。macOS 特有的问题在于，同意（<code>AuthorizationCopyRights</code>）与调用者身份认证（审计令牌的代码签名校验）是不同的问题，不应混为一谈。</li>\n</ul><p>由于这些差异，在 Windows 上修补同样的原语并不足以在 macOS 上保障安全。持久有效的修复方案是使用 macOS 原生的 IPC，例如 XPC，它支持 <code>xpc_connection_get_audit_token</code> 和 <code>xpc_connection_set_peer_code_signing_requirement</code> 这类不受 PID 复用影响的操作系统原生 API，并阻止硬链接，而不是仅依赖符号链接检查。</p><p>构建跨平台很难；<em>保护</em>跨平台则更难。跨平台框架使用便利，但 IPC、文件处理和权限管理中细微的操作系统级别差异，仍在为漏洞研究人员源源不断地提供丰富的 hunting ground。</p>","original","zhKind","translation","complete","漏洞分析","复现","漏洞利用","利用链","Apple","Microsoft","https://spaceraccoon.dev/race-against-the-machine-defender-macos-lpe/","spaceraccoon",{"_166":167,"_168":-5},"changelogVersion","2026-10-01T08:00","release"]
