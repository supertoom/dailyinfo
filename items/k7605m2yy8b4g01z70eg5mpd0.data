[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1795740039000,"id","k7605m2yy8b4g01z70eg5mpd0","title","Google Workspace 将强制 AI Agent 使用 MCP 服务器或 CLI 接入","originalTitle","Google Cloud Requires AI Agents to Access Workspace Through Approved Methods","summary","Google Cloud 推出面向 Gmail、Google Drive、Docs、Sheets、Slides、Calendar、Chat 和 Tasks 的 Workspace MCP 服务器及 Workspace CLI，并计划从 2027 年 2 月起要求所有 Google Workspace 用户通过这两种批准方式连接 AI Agent，取代传统 REST API。","reason","source",{"_66":84},"links",{"_58":83},"publishedAt","2026-11-26T13:15:00.000Z","discoveredAt","2026-11-26T13:43:21.936Z","timelineAt","category","ai-security","tags",[68,79,80,81,72,82],"score",70,"selected",false,"channel","news","story","x","readingMode","full","author","body",{"_75":-5,"_58":76,"_77":-5,"_78":36},"outline",[],"relatedStories",[],"topics",[59,60,61,62,63],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_64":73,"_66":74},{"_64":71,"_66":72},{"_64":69,"_66":70},{"_64":30,"_66":68},{"_64":65,"_66":67},"slug","tools","name","工具与平台","AI 安全","ai-agent","AI Agent 安全","identity","身份与访问","google","Google / 谷歌","zh","<p>\n\tGoogle has introduced new purpose-built interfaces to better secure the use of AI agents across its Workspace environments, which will soon become the required way for AI agent to connect to Google Cloud and Workspace tools.</p><p>\n\tFirst, the tech giant has unveiled its own Workspace <a href=\"https://www.infosecurity-magazine.com/blogs/secure-practices-for-using-mcp/\">model context protocol (MCP) servers</a>, which are dedicated remote servers for Gmail, Google Drive, Docs, Sheets, Slides, Calendar, Chat and Tasks.</p><p>\n\tThis new standard comes with built-in permission, data loss prevention (DLP) checks and native human-in-the-loop (HITL) confirmations for sensitive actions. They also reject non-agent OAuth clients and work with Model Armor, Google Cloud’s prompt-injection screening service.</p><p>\n\tMeanwhile, Google has introduced the Workspace command-line interface (CLI), which allows AI agents to interact with Workspace services using commands, with structured JSON outputs and controlled OAuth sign-in.</p><p>\n\tFrom February 2027, all Google Workspace users will be required to connect AI agents through Workspace MCP servers or the Workspace CLI.</p><p>\n\tThese new vetted methods will replace the traditional way to connect agents using Representational State Transfer application programmable interfaces (REST APIs).</p><p>\n\tIn its <a href=\"https://cloud.google.com/blog/products/identity-security/deploying-agents-safely-in-your-enterprise?hl=en\">announcement</a> on November 25, Google said REST APIs were built “for human-paced apps where a valid OAuth token implied user intent.”</p><p>\n\tThe tech giant argued this approach is no longer sufficient as AI agents increasingly act autonomously and at machine speed across emails, documents, datasets and cloud infrastructure. As a result, simply having a valid access token is no longer enough. Security checks, data access restrictions and human approval for sensitive actions must now be built into the process.</p><p>\n\tBesides these two new mandated entry points for AI agents, Google Cloud has also launched a protocol-native gateway for LLM, MCP, and Agent2Agent (A2A) traffic on Google Cloud, called Google Cloud Agent Gateway.</p><p>\n\tThis extra layer of protection verifies agent identities against Google’s Agent Registry, enforces identity and access management (IAM) policies and default-deny outbound rules and screens requests with Model Armor, Google Cloud’s own guardrail layer against adversarial attacks, including prompt injection, sensitive data leaks and harmful content.</p><p>\n\t<em>Image credits:&nbsp;Julia Perova / Vladimka production / Shutterstock.com</em></p><p>\n\t<a href=\"https://www.infosecurity-magazine.com/news/google-ai-agent-identities-gemini/?utm_source=chatgpt.com\"><em>Read more: Google Introduces Unique AI Agent Identities in New Gemini Enterprise Platform</em></a></p>","zhKind","complete","Agent 安全","大模型","工具发布","Google","https://www.infosecurity-magazine.com/news/google-cloud-ai-agents-workspace/","Infosecurity Magazine",{"_86":87,"_88":-5},"changelogVersion","2026-10-01T08:00","release"]
