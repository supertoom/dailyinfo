[{"_1":2,"_3":4},"root",{"_5":102},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795826455000,"id","wuwxqwmjofamcgppwkw7wuf5s","title","美国空军 Cloud One 云平台遭入侵，攻击范围与数据失窃情况不明","originalTitle","Air Force Cloud One Breach: Updates Blocked, Migration Paused, Scope Unknown","summary","美国空军主要云计算平台 Cloud One 遭黑客入侵，攻击者身份、受影响范围及数据是否被窃取尚未确认。该事件约在 1 个月前升级平台时被发现，导致服务中断、应用更新被阻止，后台应用迁移至 Cloud One 的工作暂停，部分用户管理员权限被撤销。","reason","报道梳理了Cloud One入侵后的服务中断、迁移暂停与权限处置，并指出控制平面可能被利用，为评估军事云平台事件影响提供事实依据。","source",{"_73":101},"links",{"_89":100},"publishedAt","2026-11-27T15:03:05.000Z","discoveredAt","2026-11-27T16:09:30.050Z","timelineAt","category","activity","tags",[74,93,94,95,96,97,98,99],"score",79,"selected",true,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","Pierluigi Paganini","body",{"_61":88,"_89":-5,"_90":91,"_92":37},"outline",[83],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","f4L8ZnlbpNeo","reportCount",2,"additionalSourceCount",1,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","attack","name","攻击活动","cloud-native","云与原生","supply-chain","供应链安全",{"_80":81,"_13":82},"publicId","7b0a7fe2-a447-47f3-8010-7006dc9f4be8","美国空军 Cloud One 平台疑遭控制面入侵",{"_11":84,"_85":86,"_87":65},"sec-1","text","路透社报道称，美国空军的 Cloud One 遭到入侵。攻击范围、攻击者身份以及被盗数据情况仍不清楚；更新已受阻。","level","<h2 id=\"sec-1\">路透社报道称，美国空军的 Cloud One 遭到入侵。攻击范围、攻击者身份以及被盗数据情况仍不清楚；更新已受阻。</h2><p>路透社报道称，黑客已经入侵 Cloud One——美国空军的主要云计算平台之一。此次入侵可能使大量敏感军事数据面临风险，其中包括有关军事行动、人员和后勤的信息。</p><p>两名消息人士称，这次入侵是在大约一个月前开展平台升级工作时发现的。该发现已导致整个服务中断。路透社无法确认攻击者身份、平台受影响程度，也无法证实是否有数据被盗。</p><p><em>“三名知情人士告诉路透社，黑客已经入侵美国空军的旗舰云计算平台，这一事态发展可能危及大量敏感的战术、人员和后勤数据。”<a href=\"https://www.reuters.com/world/hackers-breach-us-air-force-flagship-cloud-one-computing-platform-2026-11-27/\">路透社表示</a>。</em></p><p><em>“不会评论特定网络和系统的安全态势、漏洞或运行状态。”美国空军发给路透社的一份声明如此写道。“我们持续采取审慎措施，保护（空军部）信息、系统以及任务能力。”</em></p><p>Cloud One 于 2017 年启动，旨在一站式满足美国空军的 IT 需求。它整合了四家运营商 Microsoft、Amazon、Oracle 和 Alphabet 的资源，用于运行数十款应用，其中包括用于处理人员数据、薪酬、后勤和维护的应用。两名消息人士称，它是美国军方规模最大的云平台之一。</p><p>两款应用凸显了此次入侵的严重性。Cloud-Based Command and Control 汇集了来自北美各地的防空雷达数据及其他信息。Theater Integrated Combat Munitions System 则追踪全球 200 多个美国空军基地的炸弹和导弹。</p><p>SAIC 一直是主要承包商，直至 2025 年由 Leidos 接手。SAIC 未回应路透社置评请求，Leidos 则将相关问题转交美国空军。据一名消息人士称，调查人员已要求美国网络司令部——该军方的网络部队——评估损害程度。美国网络司令部也未回应路透社。</p><p><em>“这里一旦发生入侵就是大事，”一名消息人士告诉路透社。</em></p><p>中断已经显现出来。两名消息人士以及另一名知情人士称，将后台应用迁移至 Cloud One 的工作已暂停；这是美国军方长期以来的优先事项。第五名消息人士称，一些用户的管理员权限已被撤销。</p><p>这一时间点使事件更加严重。运行于 Cloud One 的应用更新受阻，导致美国空军人员无法安装修复程序，而此时科技行业正披露多起严重的软件漏洞。五名消息人士均要求路透社对其身份保密。</p><p>据一名消息人士称，攻击者利用一个软件漏洞访问了平台控制平面，该控制平面管理平台的主要功能。该消息人士将其比作通用遥控器。</p><p><em>“运行于 Cloud One 的现有应用的更新受阻，导致美国空军人员无法应用修复程序，而此时科技行业刚披露了一批新的严重软件漏洞。”路透社继续报道称。“第五名消息人士称，一些用户的管理员权限已被撤销。”</em></p><p>此次入侵事件发生在人们对 AI 驱动型入侵日益担忧之际。云网络尤其令人担忧，因为 AI 模型可以迅速发现大范围攻击面上的弱点。美国政府目前正应对至少六起其他近期披露的事件，包括 FBI 的两起事件、此前五角大楼数据遭黑客攻击、国土安全部人员信息泄露、至少两家情报机构受到影响的事件，以及财政部遭黑客攻击。</p><p><strong>在 Twitter 上关注我：&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;和&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;和&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a><strong></strong></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;黑客攻击、&nbsp;Air Force Cloud One)</strong></p>","original","zhKind","translation","complete","数据泄露","云原生","供应链","AWS","Microsoft","Oracle","Google","https://securityaffairs.com/204136/security/air-force-cloud-one-breach-updates-blocked-migration-paused-scope-unknown.html","Security Affairs",{"_103":104,"_105":-5},"changelogVersion","2026-10-01T08:00","release"]
