[{"_1":2,"_3":4},"root",{"_5":109},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1794530496000,"id","zpnk0kavca8li3jjygr6z6yiw","title","Google 公布 Gemini 智能眼镜的拍摄与隐私保护机制","originalTitle","Google smart glasses privacy features cover wearers and the people around them","summary","Google 为 Gemini 驱动的智能眼镜设计了录制 LED、防拆检测、旁观者面部遮蔽、语音定向和数据处理限制。Google Shopping 与 Ads 禁止推广隐藏或禁用录制灯的产品，Google Play 禁止应用改变灯的行为或用摄像头直播、进行实时面部识别。","reason","source",{"_73":108},"links",{"_61":107},"publishedAt","2026-11-12T23:45:43.000Z","discoveredAt","2026-11-13T00:00:22.870Z","timelineAt","category","ai-security","tags",[74,104,105,106],"score",50,"selected",false,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","Anamarija Pogorelec","body",{"_100":-5,"_61":101,"_102":-5,"_103":36},"outline",[85,86,87,88],"relatedStories",[81],"topics",[68,69,70,71],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fQVLBD0w8DSI","reportCount",1,"additionalSourceCount",0,{"_72":79,"_73":80},{"_72":77,"_73":78},{"_72":75,"_73":76},{"_72":30,"_73":74},"slug","name","AI 安全","ai-agent","AI Agent 安全","iot","IoT 与车联网","google","Google / 谷歌",{"_82":83,"_13":84},"publicId","3d479cc2-8dc6-42a0-a2af-fb320e59274b","Google披露Gemini智能眼镜隐私机制",{"_11":98,"_90":99,"_92":93},{"_11":96,"_90":97,"_92":93},{"_11":94,"_90":95,"_92":93},{"_11":89,"_90":91,"_92":93},"sec-4","text","Enforcement runs through the terms of service","level",3,"sec-3","Designed to, for now","sec-2","What happens when you ask Gemini","sec-1","What the light does","zh","<p>Google has built its Gemini-powered intelligent eyewear to stop taking photos and video when someone covers or tampers with the outward-facing recording light. Shahram Izadi, Google’s VP and GM of XR, <a href=\"https://blog.google/innovation-and-ai/technology/safety-security/intelligent-eyewear-privacy-protections/\">laid out</a> that safeguard along with face redaction, limits on data handling, and app restrictions.</p><p><img src=\"/dailyinfo/media/1e517130120b71da.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Google smart glasses privacy\" title=\"Responsible use requirements\"></p><p>Bystanders told Google during years of research that they worried about being filmed without their knowledge, and that a sign of recording would help them most. Wearers face a different exposure, because glasses that see what they see also capture menus, street signs, and the faces of strangers.</p><h3 id=\"sec-1\">What the light does</h3><p>The LED turns on when the wearer takes a photo or video for the gallery. Sensors are designed to detect a covered or tampered light and block capture. Google Shopping and Ads policies ban promoting products that disable or hide recording lights on smart glasses.</p><h3 id=\"sec-2\">What happens when you ask Gemini</h3><p>When the wearer asks Gemini about the scene, the glasses are designed to redact bystanders’ faces before Gemini processes the image. Google keeps those camera visuals out of the user’s Gemini History and out of AI training and ad targeting. Data is encrypted on the glasses and in transit to the phone or cloud, and directional microphones point Gemini at the wearer’s voice by default.</p><h3 id=\"sec-3\">Designed to, for now</h3><p>The tamper detection, the face redaction, and the voice focus are design intentions. Private AI Compute, Google’s hardened environment for processing data, has not reached the glasses yet. Test the first three before you allow the glasses into a room with sensitive material on display.</p><h3 id=\"sec-4\">Enforcement runs through the terms of service</h3><p>Before using the glasses, wearers must agree not to record people without permission, not to record in sensitive places, and not to cover the light. Google may disable the glasses of anyone who breaks those terms, and setup requires an 18+ Google Account. Google Play bans apps from changing how the light behaves and from using the camera for social live-streaming or real-time facial identification.</p>","zhKind","complete","大模型","Google","IoT","https://www.helpnetsecurity.com/2026/11/13/google-smart-glasses-privacy-protections/","Help Net Security",{"_110":111,"_112":-5},"changelogVersion","2026-10-01T08:00","release"]
