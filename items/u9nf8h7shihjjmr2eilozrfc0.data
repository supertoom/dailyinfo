[{"_1":2,"_3":4},"root",{"_5":96},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1795221641000,"id","u9nf8h7shihjjmr2eilozrfc0","title","Cisco Expressway 漏洞 CVE-2026-76466 已在野利用，F6 披露入侵过程","originalTitle","Hackers Exploit Cisco Expressway Vulnerability Soon After PoC Release","summary","Cisco Expressway 漏洞 CVE-2026-76466（CVSS 9.8）已在 PoC 公开后被用于入侵一家俄罗斯机构，攻击者无需认证即可在集群设备上以 root 权限执行命令，受影响的是 Expressway Core 与 Edge 的虚拟和设备版本，仅集群部署存在风险。","reason","source",{"_74":95},"links",{"_85":94},"publishedAt","2026-11-19T13:12:20.000Z","discoveredAt","2026-11-19T13:30:19.521Z","timelineAt","category","activity","tags",[75,77,91,92,93],"score",79,"selected",true,"channel","news","story",{"_81":82,"_13":83},"x","sameEvent",{"_11":89,"_13":90},"readingMode","full","author","Eduard Kovacs","body",{"_62":84,"_85":-5,"_86":87,"_88":36},"outline",[],"relatedStories",[80],"topics",[69,70,71],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","fRNCBIg2Zuh4","reportCount",3,"additionalSourceCount",2,{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","attack","name","攻击活动","exploited","在野利用","cisco","Cisco / 思科",{"_81":82,"_13":83},"publicId","6b87b502-2424-40f1-a2c4-de3e007d78b8","Cisco Expressway漏洞已用于入侵俄机构","<p><strong>据网络安全公司 F6 称，概念验证（PoC）漏洞利用代码公开发布后不久，黑客便利用 Cisco Expressway 的一个严重漏洞入侵了一家俄罗斯组织。</strong>\n\n\n\n</p><p>Expressway 网关允许远程员工、合作伙伴和第三方用户安全连接到组织的协作服务，包括视频通话、语音通话和即时通信。\n\n\n</p><p>该漏洞追踪编号为 CVE-2026-76466（CVSS 评分为 9.8），可由能够通过网络访问设备的远程攻击者在未经身份验证的情况下利用，使其能够以 root 身份执行命令。它影响 Expressway Core 和 Expressway Edge 的虚拟及设备版本，但仅在这些设备组成集群时受影响。\n\n\n</p><p>Cisco 于 10 月 21 日<a href=\"https://www.securityweek.com/cisco-patches-34-vulnerabilities-across-multiple-products/\">披露了该问题</a>，称其存在于 Expressway 数据库服务功能中，根源在于持久 Cookie。&nbsp;\n\n\n</p><p>持有这些持久 Cookie 的攻击者可以访问数据库服务并发出特定的远程过程调用（RPC）命令，从而能够在底层操作系统上运行 root 权限命令。\n\n\n</p><p>Expressway X15.5.20 修复了该漏洞。没有可用的变通方案，Cisco 表示，使用 X14 或更早版本的客户需要迁移至已修复的版本。</p><p><span>广告。滚动以继续阅读。</span></p><p>该<a href=\"https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-vcs-static-cred-hr7EWZ8t\">公告</a>自首次发布以来未作修订，仍称 Cisco 尚不知道该漏洞已被公开宣布或遭到恶意利用。然而，此后已有一个<a href=\"https://github.com/dinosn/cve-2026-76466\">PoC 漏洞利用程序</a>发布在 GitHub 上，F6 表示，其调查的攻击发生在不久之后。\n\n\n\n</p><p>据 F6 称，攻击者首先入侵了两台暴露在互联网中的 Expressway X15.5.3 设备。随后，他们从其中一台设备转向该组织内部网络上的另外两个集群节点。\n\n\n</p><p>在获得 root 权限后，攻击者准备好用于横向移动的工具。其中包括自定义 Python 脚本，用于扫描网络、定位 SMB 资源、与 SQL Server 和 WinRM 交互，以及搜索 GitLab 仓库，旨在窃取凭据和其他敏感信息。\n\n\n\n</p><p>F6 认定，攻击者在攻击过程中会即时修改这些脚本。“源代码中包含一些特征性注释以及对修复内容的描述，表明使用了 AI 助手，”该公司表示。\n\n\n\n</p><p>F6 未披露受害组织名称，也未将该攻击归因于任何已知威胁行为者。\n\n\n</p><p>为了检测利用活动，F6 建议查看 Expressway 设备上的 Erlang 系统日志。这家安全公司还在一份俄语新闻稿中<a href=\"https://www.f6.ru/media-center/press-releases/cisco-cve-2026-76466/\">发布</a>了与此次攻击相关的 IP 地址和文件路径。\n\n\n\n</p><p>尽管 Cisco 未列出任何变通方案，F6 建议无法立即打补丁的组织在防火墙上阻止对 TCP 端口 4371–4372 的连接，但来自可信集群节点 IP 地址的连接除外。\n\n\n\n</p><p><em>SecurityWeek</em> 已联系 Cisco 就 F6 的发现征求意见；如果该公司作出回应，本文将进行更新。\n\n\n\n</p><p><strong>相关</strong>：<a href=\"https://www.securityweek.com/java4shell-exploitation-attempts-begin-as-vendors-rush-out-advisories/\">Java4Shell 利用尝试开始，各厂商紧急发布公告</a>\n\n\n\n</p><p><strong>相关</strong>：<a href=\"https://www.securityweek.com/f5-patches-critical-nginx2root-flaws-as-poc-exploits-go-public/\">F5 修复关键 NGINX2Root 漏洞，PoC 利用代码已公开</a>\n\n\n\n</p><p><strong>相关</strong>：<a href=\"https://www.securityweek.com/php-readies-critical-security-updates-to-patch-another-rce-flaw/\">PHP 准备发布关键安全更新，修复另一个 RCE 漏洞</a>\n\n\n\n</p>","original","zhKind","translation","complete","uqh0881s53j5550dvvx6q1slk","攻击者利用 Cisco Expressway 漏洞 CVE-2026-76466 入侵 4 台设备并进入内网","漏洞利用","Cisco","网络设备","https://www.securityweek.com/hackers-exploit-cisco-expressway-vulnerability-soon-after-poc-release/","SecurityWeek",{"_97":98,"_99":-5},"changelogVersion","2026-10-01T08:00","release"]
