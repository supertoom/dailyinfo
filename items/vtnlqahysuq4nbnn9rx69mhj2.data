[{"_1":2,"_3":4},"root",{"_5":136},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795567292000,"id","vtnlqahysuq4nbnn9rx69mhj2","title","F5 与 Rapid7 披露 NGINX HTTP/2 整数下溢漏洞 CVE-2026-123007，可导致 RCE","originalTitle","CVE-2026-123007: Critical NGINX HTTP/2 Integer Underflow Leads to RCE (FIXED)","summary","F5 与 Rapid7 披露 NGINX HTTP/2 整数下溢漏洞 CVE-2026-123007，未认证远程攻击者在特定条件下可触发内存破坏，以 nginx worker process 权限执行代码。","reason","原文从 HTTP/2 流控记账、整数下溢到越界内存访问完整拆解了利用链，并列出受影响版本和修复版本。","source",{"_73":135},"links",{"_124":134},"publishedAt","2026-11-18T13:56:42.000Z","discoveredAt","2026-11-18T16:43:34.043Z","timelineAt","category","vuln","tags",[128,129,130,74,131,132,133],"score",76,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","Stephen Fewer","body",{"_61":123,"_124":-5,"_125":126,"_127":37},"outline",[82,83,84,85,86,87,88,89,90,91,92,93,94],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fDXki9WjLuc0","reportCount",3,"additionalSourceCount",2,{"_71":76,"_73":77},{"_71":31,"_73":75},{"_71":72,"_73":74},"slug","research","name","技术研究","漏洞披露","rapid7","Rapid7 / Metasploit",{"_79":80,"_13":81},"publicId","92393685-eb8c-4aaf-b313-1b8098f352d3","F5修复NGINX两项HTTP/2高危漏洞",{"_11":121,"_96":122,"_98":67},{"_11":119,"_96":120,"_98":67},{"_11":117,"_96":118,"_98":67},{"_11":115,"_96":116,"_98":67},{"_11":113,"_96":114,"_98":65},{"_11":111,"_96":112,"_98":65},{"_11":109,"_96":110,"_98":65},{"_11":107,"_96":108,"_98":65},{"_11":105,"_96":106,"_98":65},{"_11":103,"_96":104,"_98":65},{"_11":101,"_96":102,"_98":65},{"_11":99,"_96":100,"_98":65},{"_11":95,"_96":97,"_98":67},"sec-13","text","披露时间线","level","sec-12","附录 A：为何超大的 memcpy可以返回","sec-11","利用","sec-10","缓冲的 TLS 输出会越过缓冲区进行复制","sec-9","过高的额度会变成负的响应长度","sec-8","下一次 WINDOW_UPDATE 会导致整数下溢","sec-7","SETTINGS 错误会关闭流，但连接仍可使用","sec-6","取消排队的 DATA 会恢复过多信用值","sec-5","客户端如何控制 HTTP/2 响应数据","sec-4","技术分析","sec-3","致谢","sec-2","影响","sec-1","概述","<h2 id=\"sec-1\">概述</h2><p><span>今天，Rapid7 和 </span><a href=\"https://my.f5.com/manage/s/article/K000163926\"><span>F5</span></a><span> 都在披露 </span><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-123007\"><span>CVE-2026-123007</span></a><span>，这是一个影响 nginx HTTP/2 的严重整数下溢漏洞。在特定条件下，它可能导致针对受影响服务器进行未经身份验证的远程代码执行（RCE）。</span></p><p><span>nginx 可能会错误计算 HTTP/2 客户端允许其发送多少响应数据。远程且未经身份验证的客户端可以利用此错误：先取消排队的响应数据，随后使 nginx 在复制后续响应时使用无效长度。由此导致的内存破坏可能泄露数据、中断服务，并以 nginx 工作进程的权限执行代码。</span></p><h2 id=\"sec-2\">影响</h2><p><span>Rapid7 开发了一个 </span><a href=\"https://github.com/sfewer-r7/CVE-2026-123007\"><span>概念验证</span></a><span>，用于演示如何利用 CVE-2026-123007 对运行 nginx 版本 </span><span><span>1.31.8</span></span><span> 的易受攻击 </span><span><span>linux/amd64</span></span><span> Docker 映像实施未经身份验证的 RCE，如下方图 1 所示。目标 nginx 服务器的配置启用了 </span><a href=\"https://nginx.org/en/docs/http/ngx_http_v2_module.html#http2\"><span>http2 on</span></a><span> 和 TLS。请注意，为简洁起见，视频播放速度为 8 倍。</span></p><p><span><span><span><img src=\"/dailyinfo/media/5baad1e385264e00.webp\" srcset=\"/dailyinfo/media/a65b166040e5ae9c.webp 720w, /dailyinfo/media/4b39b551de3c31e7.webp 1200w, /dailyinfo/media/5baad1e385264e00.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"nginx-http2-rce-720p-8x.gif\" width=\"720\" height=\"309\"></span></span></span></p><p><span><em>图 1：通过 CVE-2026-123007 对 NGINX 1.31.8 实施未经身份验证的 RCE 的演示视频</em></span></p><p><span>利用 CVE-2026-123007 实施 RCE 需要传输大量网络流量，约为 128 GB 的 HTTP/2 数据。可用的网络带宽和连接超时都会对 Internet 上的利用构成实际限制。在图 1 所示的上述示例中，利用过程耗时两分半钟。在 10 Gbit/s 网络上传输所需网络数据大约需要两分钟，而在 1 Gbit/s 网络上则需要十七分钟。由于 nginx 的默认连接生存期为一小时，网络速度低于约 300 Mbit/s 时，所需时间将超过一小时连接上限阈值，因而无法成功。此外，如果 HTTP/2 连接通过代理转发，攻击者精确控制并传输的 HTTP/2 帧很可能不会以满足漏洞利用要求的方式进行重传。</span></p><p><span>最后，所开发的利用策略依赖于运行时依据 avx512f 和 avx512vl CPU 特性选择的特定 x86-64 glibc EVEX/YMM </span><span><span>memcpy</span></span><span> 实现。其他 RCE 利用策略可能可行，但目前尚未发现此类策略。</span></p><h2 id=\"sec-3\">致谢</h2><p><span>此漏洞由 Rapid7 高级首席安全研究员 Stephen Fewer 发现，并依据 Rapid7 的</span><a href=\"https://www.rapid7.com/\"><span>Rapid7</span></a><span>漏洞披露政策进行披露。</span><a href=\"https://www.rapid7.com/security/disclosure/\"><span>漏洞披露政策</span></a><span>。</span></p><h2 id=\"sec-4\">技术分析</h2><p><span>测试的 nginx 版本是 nginx 版本 </span><span><span>1.31.8</span></span><span> 的 </span><span><span>linux/amd64</span></span><span> Docker 映像（</span><span><span>nginx@sha256:5ab5b0b01097420873a3f3330f44248e34a3c2a3e8d5ee30658aeae8cb7435da</span></span><span>），运行时暴露了 HTTPS 服务并启用了 http2。</span></p><h3 id=\"sec-5\"><span>客户端如何控制 HTTP/2 响应数据</span></h3><p><span>HTTP/2 通过称为帧的消息在单个连接上传输。每个请求和响应都属于一个编号的流，因此一个连接可以同时承载多个交换。响应体的字节在 DATA 帧中传输。</span></p><p><span>对于本漏洞，nginx 是发送方，远程客户端是接收方。客户端授予 nginx 发送一定数量 DATA 字节的权限，或者说流控信用。nginx 用两个计数器跟踪剩余信用：每个流一个，另有一个由连接共享。发送 DATA 必须同时得到这两个计数器的许可。这些 HTTP/2 计数器与 TCP 的接收窗口相互独立。</span></p><p><span>客户端还可以通过发送包含正增量的 </span><span><span>WINDOW_UPDATE</span></span><span> 帧来授予更多信用。流标识符为零时增加连接的发送信用。非零流标识符则增加具有该特定非零标识符的流的发送信用。HTTP/2 将增量以及由此得到的窗口限制在 </span><span><span>2^31-1</span></span><span> 字节，即 2,147,483,647 (0x7FFFFFFF)。本报告将该最大值称为 </span><span><span>MAX</span></span><span>。</span></p><p><span>客户端还可以发送包含 </span><span><span>SETTINGS_INITIAL_WINDOW_SIZE</span></span><span> 参数的 </span><span><span>SETTINGS</span></span><span> 帧。这会改变新流的起始信用。nginx 还必须按旧设置值与新设置值之差调整每个活动流的剩余信用。它不会改变连接的信用。因此，减少设置值可能使活动流出现负信用，直到客户端授予更多信用为止。连接窗口没有相应的减少机制：它必须保持在零与 </span><span><span>MAX</span></span><span> 之间。</span><a href=\"https://www.rfc-editor.org/rfc/rfc9113.html#section-6.9\"><span>RFC 9113, section 6.9</span></a><span> 定义了这些限制以及所需的错误。</span></p><p><span>nginx 将连接计数器存储在 </span><span><span>h2c-&gt;send_window</span></span><span> 中，其中 </span><span><span>h2c</span></span><span> 是 HTTP/2 连接记录。其 </span><span><span>size_t</span></span><span> 类型是无符号整数：在已验证的 64 位构建上，它可以容纳从零到 </span><span><span>2^64-1</span></span><span> 的值。因此，</span><span><span>size_t</span></span><span> 类型可以容纳高于 HTTP/2 最大连接窗口 </span><span><span>2^31-1</span></span><span> 字节（</span><span><span>MAX</span></span><span>）的值。nginx 必须在自己的逻辑中强制执行该协议限制。</span></p><pre><code>// src/http/v2/ngx_http_v2.h\n#define NGX_HTTP_V2_MAX_WINDOW ((1U &lt;&lt; 31) - 1) // &lt;--- [1]\nstruct ngx_http_v2_connection_s {\n    // ...\n    size_t send_window;                         // &lt;--- [2]\n    // ...\n};\nstruct ngx_http_v2_stream_s {\n    // ...\n    ssize_t send_window;\n    // ...\n};</code></pre><p><span>要求位于 [2] 的连接计数器在任何时候都不得超过位于 [1] 的 </span><span><span>MAX</span></span><span> 这一规则，就是连接窗口不变式。独立的流计数器 </span><span><span>stream-&gt;send_window</span></span><span> 被显式声明为 </span><span><span>ssize_t</span></span><span>，在已验证的构建中是有符号 64 位整数。这使得 </span><span><span>SETTINGS_INITIAL_WINDOW_SIZE</span></span><span> 能够让某个流的信用暂时变为负值。连接计数器仍保持无符号。之后发生的不安全转换，是在输出过滤器把过大的连接信用当作有符号 64 位 </span><span><span>off_t</span></span><span> 响应长度处理时出现的。</span></p><p><span>利用该漏洞有四个主要阶段：</span></p><ol><li><p><span>通过放慢其对服务器输出的读取，客户端会让选定的 DATA 帧保持在队列中且尚未开始处理。它将连接的信用值提高到 </span><span><span>MAX</span></span><span>，并将选定流的信用值提高到略低于 </span><span><span>MAX</span></span><span>。当 </span><span><span>SETTINGS</span></span><span> 帧将 </span><span><span>SETTINGS_INITIAL_WINDOW_SIZE</span></span><span> 增加到超过流限制的程度时，nginx 会关闭这些流，同时保持连接可用。随后，请求清理会将保留的信用值恢复到 </span><span><span>MAX</span></span><span> 以上。</span></p></li><li><p><span>下一次连接 </span><span><span>WINDOW_UPDATE</span></span><span> 检查中的无符号减法会下溢。此后，反复被接受的 </span><span><span>WINDOW_UPDATE</span></span><span> 帧可以将该计数器提升到其 64 位范围的上半部分，而无需使加法发生回绕。</span></p></li><li><p><span>在已验证的 64 位构建中，nginx 会将这个过大的计数器解释为负的响应长度，并创建一个无效缓冲区。缓冲的 TLS 输出随后会将一个巨大的无符号字节数传递给内存复制函数 </span><span><span>memcpy</span></span><span>，从而导致越界读取和写入。</span></p></li><li><p><span>这些受约束的内存访问取决于构建方式和所选的复制例程。在采用合适内存布局的情况下，攻击者可以利用泄露的地址和受控覆写，以 nginx 工作进程的权限执行代码。</span></p></li></ol><h3 id=\"sec-6\"><span>取消排队的 DATA 会恢复过多信用值</span></h3><p><span>当 nginx 在 [3] 处将一个 </span><span><span>DATA</span></span><span> 帧加入队列时，它会先从连接信用值计数器中减去该帧的 DATA 长度，再从流的信用值计数器中减去该长度。这会在字节到达客户端之前保留信用值，并防止其他流消耗同一份连接信用值：</span></p><pre><code>// src/http/v2/ngx_http_v2_filter_module.c\n// ngx_http_v2_send_chain()\n// ...\nngx_http_v2_queue_frame(h2c, frame);       // &lt;--- [3]\n\nh2c-&gt;send_window -= frame_size;            // &lt;--- [4]\nstream-&gt;send_window -= frame_size;\nstream-&gt;queued++;</code></pre><p><span>攻击者可以通过放慢或停止读取较早的服务器输出，使后续响应持续留在队列中。一旦传输层无法接受更多输出，nginx 就必须等待。这种状况称为传输层反压。攻击者需要制造足够多的反压，才能让选定的 DATA 帧保持未启动状态：该帧的任何字节都尚未进入 TLS 输出或套接字。停止读取响应并不会阻止客户端在另一个方向发送控制帧。</span></p><p><span>在 DATA 仍处于队列中时，客户端会发送一个连接 </span><span><span>WINDOW_UPDATE</span></span><span>，将 nginx 中已减少的计数器提高到 </span><span><span>MAX</span></span><span>。问题出现在拥有排队 DATA 的请求随后关闭时。其请求清理处理程序会移除未启动的 DATA，并返还保留的信用值：</span></p><pre><code>// src/http/v2/ngx_http_v2_filter_module.c\n// ngx_http_v2_filter_cleanup()\n// ...\nfor ( ;; ) {\n    frame = *fn;\n    if (frame == NULL) {\n        break;\n    }\n    if (frame-&gt;stream == stream &amp;&amp; !frame-&gt;blocked) { // &lt;--- [5]\n        *fn = frame-&gt;next;\n        window += frame-&gt;length;                      // &lt;--- [6]\n        if (--stream-&gt;queued == 0) {\n            break;\n        }\n        continue;\n    }\n    fn = &amp;frame-&gt;next;\n}\n// ...\nh2c-&gt;send_window += window;                           // &lt;--- [7]</code></pre><p><span>[5] 处的测试会为该请求选择可移除且未启动的帧。局部变量 </span><span><span>window</span></span><span> 在 [6] 处累加这些帧的 DATA 长度。[7] 处的加法不会检查恢复这些字节是否会使连接计数器超过 </span><span><span>MAX</span></span><span>。</span></p><p><span>例如，在计数器达到 2,147,483,647 (0x7FFFFFFF) 后恢复 1,393 字节，会产生 2,147,485,040 (0x80000570)。根据 HTTP/2，此值无效，因为它超过了 </span><span><span>MAX</span></span><span>，尽管它仍能放入 64 位的 </span><span><span>size_t</span></span><span> 中；此时加法尚未发生回绕。[7] 处未经检查的恢复操作是该漏洞中的第一个无效状态。攻击者仍需要一种方法，在保留连接的同时关闭所选请求，以便再次使用过大的计数器。</span></p><h3 id=\"sec-7\"><span>SETTINGS 错误会关闭流，但连接仍可使用</span></h3><p><span>当一个 </span><span><span>SETTINGS</span></span><span> 帧将 </span><span><span>SETTINGS_INITIAL_WINDOW_SIZE</span></span><span> 增加到足以使活动流的信用额度超过 </span><span><span>MAX</span></span><span> 时，nginx 会终止该流，但保持 HTTP/2 连接可用。客户端可以先发送一个流 </span><span><span>WINDOW_UPDATE</span></span><span>，使所选流的信用额度刚好低于 </span><span><span>MAX</span></span><span>，从而制造这种情况。然后发送一个 </span><span><span>SETTINGS</span></span><span> 帧，增加初始流窗口设置。例如，将该设置从 65,535 改为 65,537，会为每个活动流增加两个字节。已处于 </span><span><span>MAX-1</span></span><span> 的流将变为 </span><span><span>MAX+1</span></span><span>，尽管新的设置值本身是允许的。</span></p><p><span>RFC 9113 要求在这种情况下使用 </span><span><span>FLOW_CONTROL_ERROR</span></span><span> 结束连接。nginx 实际上会对每个受影响的流调用 </span><span><span>ngx_http_v2_terminate_stream()</span></span><span>。该函数发送 </span><span><span>RST_STREAM</span></span><span>，从而结束单个流并导致请求被清理。随后循环会继续使用同一连接：</span></p><pre><code>// src/http/v2/ngx_http_v2.c\n// ngx_http_v2_adjust_windows()\n// ...\nif (delta &gt; 0\n    &amp;&amp; stream-&gt;send_window\n          &gt; (ssize_t) (NGX_HTTP_V2_MAX_WINDOW - delta))\n{\n    if (ngx_http_v2_terminate_stream(h2c, stream,\n                                     NGX_HTTP_V2_FLOW_CTRL_ERROR)\n        == NGX_ERROR)\n    {\n        return NGX_ERROR;\n    }\n    continue;                                      // &lt;--- [8]\n}</code></pre><p><span>在这里，</span><span><span>delta</span></span><span> 是新旧设置值之差。请求清理会执行 [5] 至 [7]，而 [8] 处的 </span><span><span>continue</span></span><span> 会让 HTTP/2 连接保持打开。攻击者现在可以在该连接上发送更多帧，而其信用额度已经超过 </span><span><span>MAX</span></span><span>。</span></p><h3 id=\"sec-8\"><span>下一次 WINDOW_UPDATE 会导致整数下溢</span></h3><p><span>当另一个连接 </span><span><span>WINDOW_UPDATE</span></span><span> 到达时，nginx 会尝试计算仍允许增加多少信用额度：</span></p><pre><code>// src/http/v2/ngx_http_v2.c\n// ngx_http_v2_state_window_update()\n// ...\nif (window &gt; NGX_HTTP_V2_MAX_WINDOW - h2c-&gt;send_window) { // &lt;--- [9]\n    // ...\n    return ngx_http_v2_connection_error(h2c,\n                                        NGX_HTTP_V2_FLOW_CTRL_ERROR);\n}\nh2c-&gt;send_window += window;                            // &lt;--- [10]</code></pre><p><span>在此函数中，</span><span><span>window</span></span><span> 是从客户端接收到的增量。只有当存储的计数器不大于 </span><span><span>MAX</span></span><span> 时，[9] 处的减法才是安全的。如果清理操作恢复了 </span><span><span>R</span></span><span> 个超出字节，则预期的允许额度为 </span><span><span>MAX - (MAX + R)</span></span><span>，即 </span><span><span>-R</span></span><span>。无符号算术无法表示该负数结果。在经过验证的 64 位构建中，它会回绕为 </span><span><span>2^64 - R</span></span><span>，即一个非常大的正数。这就是 CWE-191 所标识的整数下溢。</span></p><p><span>错误的额度分配会让后续客户端增量通过检查。通过发送许多增量，且每个增量都不超过 </span><span><span>MAX</span></span><span>，客户端可以将计数器提升到 </span><span><span>2^63</span></span><span> 或更高，而加法本身不会发生回绕，如上文 [10] 所示。这样的值，其 64 位表示的最高位会被置位。它仍然是一个无符号值，但已不再能容纳于有符号 64 位整数中。当 nginx 准备下一个响应时，这一区别很重要。</span></p><p><span>这种放大效应解释了为何需要大量流量。一个 </span><span><span>WINDOW_UPDATE</span></span><span> 连接占用 13 个 HTTP/2 字节：一个</span><a href=\"https://www.rfc-editor.org/rfc/rfc9113.html#section-4.1\"><span>9 字节帧头</span></a><span>和一个</span><a href=\"https://www.rfc-editor.org/rfc/rfc9113.html#section-6.9\"><span>4 字节载荷</span></a><span>。该帧授予的额度并非实际传输的数据。从上文所述的小幅超额额度状态开始，以最大大小的增量达到 </span><span><span>2^63</span></span><span> 约需 </span><span><span>2^32</span></span><span> 个帧，即 52 GiB。达到已确认读/写路径所使用的接近 </span><span><span>2^64</span></span><span> 的值，约需 </span><span><span>2^33</span></span><span> 次增量，即 104 GiB。nginx 还会相对于其他接收数据限制控制帧流量。当前代码执行复现会额外发送约 15 GiB 的请求头流量，以保持在限制内，使其报告的明文总量达到约 119.02 GiB。TLS 和网络开销会进一步增加实际的线上流量。这些数字描述的是这条 64 位放大路径，而非每一种可能利用方式的通用最小值。</span></p><h3 id=\"sec-9\"><span>过高的额度会变成负的响应长度</span></h3><p><span>客户端可以让具有可用额度的活动流处理普通响应正文。nginx 的 HTTP/2 输出过滤器决定在一个 DATA 帧中包含多少正文字节。在进行该计算之前，先定义它将创建的缓冲区。</span></p><p><span>内存中的 nginx 缓冲区由一个 </span><span><span>ngx_buf_t</span></span><span> 记录描述。其 </span><span><span>pos</span></span><span> 指针是下一个待发送字节的内存地址。其 </span><span><span>last</span></span><span> 指针是紧接可用数据之后的地址。对于 4 个可用字节，</span><span><span>last</span></span><span> 必须位于 </span><span><span>pos</span></span><span> 之后 4 个字节处；从 </span><span><span>last</span></span><span> 中减去 </span><span><span>pos</span></span><span> 可得出长度 4。因此，有效缓冲区不能出现 </span><span><span>last</span></span><span> 位于 </span><span><span>pos</span></span><span> 之前的情况。nginx 将这些缓冲区记录链接成输出链，即等待发送的数据列表。</span></p><p><span>在 </span><span><span>ngx_http_v2_send_chain()</span></span><span> 中，字节上限是一个 </span><span><span>off_t</span></span><span>，在经验证的构建中它是带符号的 64 位整数。过高的无符号连接计数器在 [11] 处被转换为该带符号类型。在此构建中，</span><span><span>2^64 - d</span></span><span>（其中 </span><span><span>d</span></span><span> 是一个较小的正字节数）会变为 </span><span><span>-d</span></span><span>：</span></p><pre><code>// src/http/v2/ngx_http_v2_filter_module.c\n// ngx_http_v2_send_chain()\n// ...\nif (limit == 0 || limit &gt; (off_t) h2c-&gt;send_window) {\n    limit = h2c-&gt;send_window;                         // &lt;--- [11]\n}\nif (limit &gt; stream-&gt;send_window) {\n    limit = (stream-&gt;send_window &gt; 0) ? stream-&gt;send_window : 0;\n}\n// ...\nif ((off_t) frame_size &gt; limit) {\n    frame_size = (size_t) limit;                      // &lt;--- [12]\n}\n// ...\nrest = frame_size;\nwhile ((off_t) rest &gt;= size) {                        // &lt;--- [13]\n    // ...\n}\nif (rest) {\n    cl = ngx_http_v2_filter_get_shadow(stream, in-&gt;buf,\n                                       offset, rest); // &lt;--- [14]\n    // ...\n}</code></pre><p><span>流窗口检查不会拒绝负数 </span><span><span>limit</span></span><span>：它只会缩减过大的 limit。在 [12] 处，负数 limit 会变成一个巨大的无符号 </span><span><span>frame_size</span></span><span>。将同一个值转换回 </span><span><span>off_t</span></span><span> 会再次变为负数，因此 [13] 跳过了通常用于消耗并限制可用正文字节的循环。在 [14] 处，nginx 将无效长度传给一个辅助函数，其 </span><span><span>size</span></span><span> 参数同样是带符号的 </span><span><span>off_t</span></span><span>。</span></p><p><span>该辅助函数创建一个影子缓冲区：一条新的元数据记录，指向现有响应数据的一部分，但不复制响应正文本身。它使用传入的长度设置新的结束指针：</span></p><pre><code>// src/http/v2/ngx_http_v2_filter_module.c\n// ngx_http_v2_filter_get_shadow()\nstatic ngx_chain_t *\nngx_http_v2_filter_get_shadow(ngx_http_v2_stream_t *stream, ngx_buf_t *buf,\n    off_t offset, off_t size)\n{\n    // ...\n    ngx_memcpy(chunk, buf, sizeof(ngx_buf_t));\n    // ...\n    if (ngx_buf_in_memory(chunk)) {\n        chunk-&gt;pos += offset;\n        chunk-&gt;last = chunk-&gt;pos + size;              // &lt;--- [15]\n    }\n    // ...\n}</code></pre><p><span>由于 </span><span><span>size</span></span><span> 为负数，[15] 会将 </span><span><span>last</span></span><span> 置于 </span><span><span>pos</span></span><span> 之前。响应正文并未变大；其缓冲区元数据现在已失效。下一个输出阶段会信任这些元数据。</span></p><h3 id=\"sec-10\"><span>缓冲的 TLS 输出会越过缓冲区进行复制</span></h3><p><span>对于缓冲的 TLS 输出，</span><span><span>ngx_ssl_send_chain()</span></span><span> 会在加密前将输出链中的字节收集到一个临时的暂存缓冲区中。它使用 </span><span><span>last - pos</span></span><span> 计算每个输入缓冲区的长度。无效缓冲区在 [16] 处产生一个负的有符号长度：</span></p><pre><code>// src/event/ngx_event_openssl.c\n// ngx_ssl_send_chain()\n// ...\nssize_t send, size, file_size;\n// ...\nsize = in-&gt;buf-&gt;last - in-&gt;buf-&gt;pos;                  // &lt;--- [16]\nif (size &gt; buf-&gt;end - buf-&gt;last) {\n    size = buf-&gt;end - buf-&gt;last;\n}\nif (send + size &gt; limit) {\n    size = (ssize_t) (limit - send);\n}\n// ...\nngx_memcpy(buf-&gt;last, in-&gt;buf-&gt;pos, size);            // &lt;--- [17]\nbuf-&gt;last += size;\nin-&gt;buf-&gt;pos += size;</code></pre><p><span>两项检查都只会缩减过大的长度。两者都不会拒绝负长度。</span><span><span>memcpy</span></span><span> 接受无符号 </span><span><span>size_t</span></span><span> 字节计数，因此 [17] 会将 </span><span><span>-d</span></span><span> 转换回巨大数值 </span><span><span>2^64-d</span></span><span>。实际的源缓冲区和目标缓冲区要小得多。这就是无效连接信用首次到达越界原生内存访问的位置。</span></p><p><span>一次真正跨越如此巨大范围的复制通常会遇到不可访问的内存并使工作进程崩溃。然而在所测试的 x86-64 glibc 实现中，某些略低于 </span><span><span>2^64</span></span><span> 的长度会导致机器级的结束地址计算发生回绕（关于这一意外</span><span>行为<span>的更多细节，请参见下面的附录 A）。对于长度为 </span><span><span>2^64-d</span></span><span> 的情况，将该长度加到起始地址上可能产生一个位于其前方 </span><span><span>d</span></span><span> 字节的地址。优化后的复制在循环条件中使用这些结束地址，因此它可能在完成有限次数的读写后结束，而这些读写会到达预期缓冲区之外。如果其实际访问的所有位置都可访问，该复制就可能返回；其他长度、内存布局或复制实现则可能立即引发故障。如果复制返回，nginx 还会按该负的有符号长度将两个缓冲区位置向后移动。</span></span></p><h3 id=\"sec-11\"><span>利用</span></h3><p><span>无效副本既可以读取也可以覆写 worker 内存。它并不会给客户端提供一个可以任意选择内存地址的 HTTP/2 字段。有用的地址取决于 nginx 在何处分配了响应缓冲区和 TLS 缓冲区、已经缓冲了多少输出，以及 C 库选择了哪个复制例程。这些是受限的读写能力，而不是无条件的任意读写。</span></p><p><span>在创建无效的 DATA 缓冲区之后，</span><span><span>ngx_http_v2_send_chain()</span></span><span>会更新其在原始响应中的位置，并记录仍待发送的字节：</span></p><pre><code>// src/http/v2/ngx_http_v2_filter_module.c\n// ngx_http_v2_send_chain()\n// ...\noffset += rest;                                       // &lt;--- [18]\nsize -= rest;\n// ...\nif (offset) {\n    cl = ngx_http_v2_filter_get_shadow(stream, in-&gt;buf,\n                                       offset, size); // &lt;--- [19]\n    // ...\n    in-&gt;buf = cl-&gt;buf;\n    // ...\n}</code></pre><p><span>这里，</span><span><span>offset</span></span><span>是原始主体内的位置，</span><span><span>size</span></span><span>是其剩余长度。从偏移量零开始，表示 </span><span><span>-d</span></span><span>的同一个无符号值在已验证的构建中会使 [18] 将偏移量向后移动 </span><span><span>d</span></span><span>，并将剩余长度增加 </span><span><span>d</span></span><span>。因此，在 [19] 处创建的影子缓冲区具有正的长度，但起点位于原始响应之前 </span><span><span>d</span></span><span> 个字节处，终点则与原始响应的终点相同。如果超大副本和连接能够存活，之后的普通 DATA 帧就可以通过 TLS 将这些前面的字节携带给客户端。它们可能包含指向堆的指针（nginx 在堆上动态分配请求数据），或指向已加载库的指针。这些指针会泄露本应被地址空间布局随机化（ASLR）隐藏的地址。</span></p><p><span>在写入侧，nginx 将客户端提供的请求数据存储在堆分配中。只要分配布局合适，超大副本就可能取到这些攻击者选定的字节，并替换附近一个存活堆对象中的字段。一个有用的字段是回调：即 nginx 打算稍后调用的已存储函数指针。知道相关进程地址并能够覆写该字段的攻击者，可能将正常的 nginx 处理流程重定向到已有的可执行代码。该覆写无需包含新的机器代码。这解释了从泄露地址和受控字节通向代码执行的一般路径；这并不意味着每个构建都会暴露相同的对象或回调。执行将拥有 worker 的权限；尚未证实能以主进程或 root 权限执行。</span></p><p><span><a href=\"https://github.com/sfewer-r7/CVE-2026-123007\"><span>概念验证</span></a><span>首先从原始响应主体之前的内存中恢复堆地址，以及指向 nginx 和 GNU C 库（glibc）的指针。它利用这些地址和覆写来伪造 nginx 的请求与响应缓冲区对象，使其通过 HTTP/2 返回 glibc 已加载映像的选定部分。返回的 ELF 元数据被解析以在 ASLR 存在的情况下解析出 </span><span><span>system()</span></span><span>，随后请求池的清理回调被重定向以调用攻击者选定的命令。</span></span></p><h3 id=\"sec-12\"><span>附录 A：为何超大的 </span><span><span>memcpy</span></span><span>可以返回</span></h3><p><span>通过 </span><span><span>ngx_memcpy</span></span><span> 进行的 TLS 复制（如上文 [17] 所示）收到的字节计数为 </span><span><span>2^64-d</span></span><span>，其中 </span><span><span>d</span></span><span> 是一个较小的正距离。实际遍历整个范围的例程通常会触发故障。本附录将解释为何某个经过优化的 glibc 实现反而能够在执行有限次数的越界访问后结束。</span></p><p><span>glibc 会根据 CPU 的能力在经过优化的复制例程之间进行选择。测试所用的 x86-64 例程使用 EVEX/YMM 指令，每次可移动 32 字节。在相应的 glibc 2.41 源码中，</span><a href=\"https://github.com/bminor/glibc/blob/glibc-2.41/sysdeps/x86_64/multiarch/memmove-evex-unaligned-erms.S\"><span>EVEX 包装器</span></a><span> 包含一个共享的 </span><span><span>memcpy</span></span><span>/</span><span><span>memmove</span></span><span> 实现，而其 </span><a href=\"https://github.com/bminor/glibc/blob/glibc-2.41/sysdeps/x86_64/multiarch/x86-evex256-vecs.h\"><span>向量配置</span></a><span> 将 </span><span><span>VEC_SIZE</span></span><span> 设为 32。向量是指由一条此类指令处理的字节块。</span></p><p><span>下面的摘录使用 AT&amp;T 汇编语法，其中源操作数位于前面。CPU 寄存器 </span><span><span>%rdi</span></span><span> 保存原始目标地址，下文称为 </span><span><span>D</span></span><span>；</span><span><span>%rsi</span></span><span> 保存源地址 </span><span><span>Q</span></span><span>；</span><span><span>%rdx</span></span><span> 保存字节计数 </span><span><span>n</span></span><span>。当 </span><span><span>D</span></span><span> 与 </span><span><span>Q</span></span><span> 不同，且无符号差值 </span><span><span>D-Q</span></span><span> 小于 </span><span><span>n</span></span><span> 时，有一条路径会进入这个向后复制的分支。这包括普通情形：</span><span><span>D</span></span><span> 位于 </span><span><span>Q</span></span><span> 上方，且 </span><span><span>n</span></span><span> 接近无符号 64 位最大值。</span></p><pre><code>// glibc 2.41: sysdeps/x86_64/multiarch/memmove-vec-unaligned-erms.S\n// Function: CPU-selected memcpy implementation, backward-copy branch\n// ...\nL(more_8x_vec_backward):\n    // ...\n    leaq (VEC_SIZE * -4 + -1)(%rdi, %rdx), %rcx // &lt;--- [20]\n    // ...\n    andq $-(VEC_SIZE), %rcx                     // &lt;--- [21]\n    // ...\nL(loop_4x_vec_backward):\n    // ... load and store four 32-byte vectors\n    addq $(VEC_SIZE * -4), %rcx                 // &lt;--- [22]\n    cmpq %rcx, %rdi                             // &lt;--- [23]\n    jb L(loop_4x_vec_backward)\n    // ... store the previously loaded leading and trailing vectors\n    VZEROUPPER_RETURN                           // &lt;--- [24]</code></pre><p><span>完整的 </span><a href=\"https://github.com/bminor/glibc/blob/glibc-2.41/sysdeps/x86_64/multiarch/memmove-vec-unaligned-erms.S#L513\"><span>glibc 汇编源码</span></a><span> 展示了被省略的加载和存储。在 [20] 处，</span><span><span>leaq</span></span><span> 计算地址但不读取内存。其 64 位结果仅保留低 64 位。在 [21] 处，</span><span><span>andq</span></span><span> 将该地址向下舍入到 32 字节边界。将所得目标地址称为 </span><span><span>cursor</span></span><span>，计算方式如下：</span></p><pre><code>cursor = align_down_32((D + n - 129) modulo 2^64)\n       = align_down_32(D - d - 129), when n = 2^64-d</code></pre><p><span>这里的 </span><span><span>align_down_32</span></span><span> 表示向下舍入到最近一个可被 32 整除的地址；这是说明性记法，并非 glibc 函数。对于普通堆地址和较小的 </span><span><span>d</span></span><span>，计算出的 cursor 已经低于 </span><span><span>D</span></span><span>。</span></p><p><span>该循环首先复制一个 128 字节块。指令 [22] 随后将 cursor 再向后移动 128 字节。[23] 处的比较和无符号跳转仅在 </span><span><span>D &lt; cursor</span></span><span> 时重复循环。由于 cursor 已经低于 </span><span><span>D</span></span><span>，因此不会执行跳转。该例程写入剩余的前导和尾随向量，然后在 [24] 处返回。它并未复制所请求的巨大范围：地址回绕使循环在少量访问后停止。这些访问仍可能读取并覆写实际缓冲区之外的内存。</span></p><p><span>以下供应商提供的修复已可用。</span></p><table><tbody><tr><td><p><span><strong>产品</strong></span></p></td><td><p><span><strong>受影响版本</strong></span></p></td><td><p><span><strong>修复版本</strong></span></p></td></tr><tr><td><p><span>NGINX Plus</span></p></td><td><p><span><span>37.1.0</span></span><span> - </span><span><span>37.2.0.1</span></span></p></td><td><p><span><span>37.3.0.1</span></span></p></td></tr><tr><td><p><span>NGINX Plus</span></p></td><td><p><span><span>37.0.0</span></span><span> - </span><span><span>37.0.7.1</span></span></p></td><td><p><span><span>37.0.8.1</span></span></p></td></tr><tr><td><p><span>NGINX Plus</span></p></td><td><p><span><span>R34</span></span><span> - </span><span><span>R36</span></span></p></td><td><p><span>无</span></p></td></tr><tr><td><p><span>NGINX Open Source</span></p></td><td><p><span><span>1.31.0</span></span><span> - </span><span><span>1.31.8</span></span></p></td><td><p><span><span>1.31.9</span></span></p></td></tr><tr><td><p><span>NGINX Open Source</span></p></td><td><p><span><span>1.9.5</span></span><span> - </span><span><span>1.30.6</span></span></p></td><td><p><span><span>1.30.7</span></span></p></td></tr></tbody></table><p><span>有关最新修复信息，请参阅供应商的 </span><a href=\"https://my.f5.com/manage/s/article/K000163926\"><span>公告</span></a><span>。</span></p><h2 id=\"sec-13\">披露时间线</h2><ul><li><p><span><strong>2026年11月11日：</strong></span><span> Rapid7 首次联系 F5。</span></p></li><li><p><span><strong>2026年11月12日：</strong></span><span> F5 确认已收到联系，Rapid7 披露该漏洞。F5 确认收到该披露。</span></p></li><li><p><span><strong>2026年11月16日：</strong></span><span> F5 确认已验证该漏洞、CVE 编号分配情况以及 2026年11月18日的披露日期。</span></p></li><li><p><span><strong>2026年11月18日：</strong></span><span> 本次披露。</span></p></li></ul>","original","zhKind","translation","complete","漏洞","复现","漏洞利用","补丁","网络设备","Rapid7","https://www.rapid7.com/blog/post/ve-cve-2026-123007-critical-nginx-http-2-integer-underflow-leads-to-rce-fixed","Rapid7 CVE 公告",{"_137":138,"_139":-5},"changelogVersion","2026-10-01T08:00","release"]
