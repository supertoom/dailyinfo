[{"_1":2,"_3":4},"root",{"_5":111},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1794195826000,"id","a55xwfne2cfqa93ovn0mflfxz","title","攻击者借 GitHub 分发仿冒 ChatGPT 与 Claude 应用，Yoba 恶意软件借 DLL sideloading 安装挖矿程序","originalTitle","Fake ChatGPT and Claude Apps Use Signed Executables to Install Yoba Malware","summary","攻击者通过 GitHub Pages 和 GitHub releases 分发仿冒“GPT-5.6 Sol”“GPT-6 Astra”及“Claude Opus”桌面应用。","reason","source",{"_74":110},"links",{"_100":109},"publishedAt","2026-11-05T11:15:00.000Z","discoveredAt","2026-11-05T19:01:14.190Z","timelineAt","category","activity","tags",[77,75,106,79,107,108],"score",70,"selected",true,"channel","news","story",{"_81":82,"_13":83},"x","sameEvent",{"_11":104,"_13":105},"readingMode","full","author","Waqas","body",{"_62":99,"_100":-5,"_101":102,"_103":36},"outline",[84,85,86,87],"relatedStories",[80],"topics",[69,70,71],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","f7uJcQ_60hVI","reportCount",6,"additionalSourceCount",5,{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","malware","name","恶意软件","attack","攻击活动","botnet","僵尸网络",{"_81":82,"_13":83},"publicId","c21f1fff-8819-482c-a720-1d720a3cb2bb","Yoba借虚假AI应用侧加载DLL传播挖矿木马",{"_11":97,"_89":98,"_91":92},{"_11":95,"_89":96,"_91":92},{"_11":93,"_89":94,"_91":92},{"_11":88,"_89":90,"_91":92},"sec-4","text","文件已签名并不意味着非官方安装程序安全","level",3,"sec-3","Telegram 图片有助于定位下一个有效载荷","sec-2","恶意软件要求管理员访问权限","sec-1","GitHub Pages 将用户引向恶意下载","<p>假冒的 ChatGPT 和 Claude 应用通过 GitHub 传播 Yoba 恶意软件，利用已签名的可执行文件在 Windows PC 上加载加密货币挖矿程序，并支持投放其他有效载荷。</p><p>攻击者正通过 GitHub 分发假冒的 <strong><a href=\"https://hackread.com/google-ads-claude-ai-macsync-malware-clickfix/\">ChatGPT 和 Claude</a></strong>桌面应用，并将恶意软件与由 OpenAI 和 Anthropic 签名的真实可执行文件打包在一起。Check Point 的研究披露了这一活动；其分析人员观察到，Windows 计算机上一个能够投放其他恶意软件的加载程序会安装加密货币挖矿软件。</p><p>在研究中，Check Point 将该活动称为 Yoba，并描述了 <strong><a href=\"https://hackread.com/malware-concealed-dependabot-github-projects/\">虚假的 GitHub 项目</a></strong>，这些项目声称提供“GPT-5.6 Sol”、“GPT-6 Astra”和“Claude Opus”桌面应用。攻击者将恶意软件与真实的已签名可执行文件捆绑在一起，但并未攻破 OpenAI 或 Anthropic。</p><h3 id=\"sec-1\"><strong>GitHub Pages 将用户引向恶意下载</strong></h3><p>攻击者通过 GitHub 项目页面（包括 GitHub.io）推广这些假冒应用，这些页面描述其功能，并链接到托管在 GitHub Releases 上的 ZIP 下载文件。推广页面和下载文件均保留在一个用户熟悉的平台上，使这些产品对正在搜索 AI 软件的人而言显得更可信。</p><p>其中一些页面出现在 <strong><a href=\"https://hackread.com/hacklink-market-seo-poisoning-attacks-google-results/\">Google 搜索结果</a></strong>的前列。Check Point 未发现 GitHub 星标或分叉数量被人为抬高的迹象，但表示这些措辞和搜索可见性表明，攻击者对页面进行了优化，以通过 Google 吸引用户。</p><p>任何下载并运行该软件包的人都会启动一个真实的、已签名的应用程序可执行文件。攻击者在其旁边放置了一个名为 <code>winmm.dll</code> 的恶意文件，随后该应用程序通过一种称为 DLL 侧加载的技术加载该文件。尽管可执行文件的签名有效，但它加载的文件中包含恶意软件。 </p><figure><a href=\"https://hackread.com/wp-content/uploads/2026/11/fake-chatgpt-claude-apps-yoba-malware-2.png\"><img width=\"994\" height=\"1024\" src=\"/dailyinfo/media/8a7b5dffa0639477.webp\" srcset=\"/dailyinfo/media/4605e69ad10445ff.webp 720w, /dailyinfo/media/85886ea62296d583.webp 1200w, /dailyinfo/media/8a7b5dffa0639477.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Fake ChatGPT and Claude Apps Use Signed Executables to Install Yoba Malware\"></a><figcaption>组合截图：Google 搜索中的恶意 GitHub Pages 结果（上图），以及用于引诱 Windows 用户的虚假 Claude 下载页面（下图）。（来源：Check Point Research）</figcaption></figure><h3 id=\"sec-2\">恶意软件要求管理员访问权限</h3><p>研究人员将恶意 DLL 命名为 YobaDropper；它会先检查执行环境，然后再继续运行。如果没有管理员权限，它会显示一条请求提升权限的消息并退出。</p><p>它还会排除包括俄语和白俄罗斯语在内的多种键盘语言，而乌克兰语仍然符合条件。然而，键盘设置仅是一种筛选机制，不能可靠地识别用户所在的位置。</p><p>安装后，计划任务会在启动三分钟后运行一个复制出的 Windows 可执行文件。该程序会加载 YobaLoader，使感染能够在重启后继续存在。</p><figure><a href=\"https://hackread.com/wp-content/uploads/2026/11/fake-chatgpt-claude-apps-yoba-malware-github-2.png\"><img width=\"1024\" height=\"392\" src=\"/dailyinfo/media/ea4e56f770b5c749.webp\" srcset=\"/dailyinfo/media/daf2e3491bc694ee.webp 720w, /dailyinfo/media/1b71b0dd77c720f0.webp 1200w, /dailyinfo/media/ea4e56f770b5c749.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Fake ChatGPT and Claude Apps Use Signed Executables to Install Yoba Malware\"></a><figcaption>攻击示意图：Yoba 的感染链利用已签名软件加载恶意软件，然后通过 Telegram、DNS-over-HTTPS 和 Catbox 获取指令与有效载荷。（来源：Check Point Research）</figcaption></figure><h3 id=\"sec-3\"><strong>Telegram 图片有助于定位下一个有效载荷</strong></h3><p>根据 Check Point 的详细<strong><a href=\"https://research.checkpoint.com/2026/tricks-from-the-past-deployed-via-signed-chatgpt-and-claude-binaries/?_gl=1*v3uwjc*_gcl_au*Nzc3MDMwODY3LjE3OTE1NDAwOTY.\">技术研究</a></strong>，YobaLoader 会下载某个 Telegram 频道的头像，并使用其最后 50 个字节生成域名。更改图片即可让运营者更改该目的地。</p><p>随后，加载程序会查询 Google 的 DNS-over-HTTPS 服务，以获取存储在 DNS TXT 记录中的指令。它会先验证并解密这些指令，再获取加密的有效载荷；在所分析的投递链中，有效载荷通过 Catbox 投递。</p><p>研究人员观察到加密货币挖矿软件 <strong><a href=\"https://hackread.com/golang-malware-infects-windows-linux-xmrig-miner/\">XMRig</a></strong> 通过 <strong><a href=\"https://hackread.com/fake-tor-browser-rodeo-scamming-users/\">Tor</a></strong> 通信。它可以在用户使用计算机时暂停，从而降低明显的资源消耗引起用户注意的可能性。该加载器还支持 Windows 可执行文件和 PowerShell 有效载荷，因此其功能并不局限于挖矿。</p><h3 id=\"sec-4\"><strong>文件已签名并不意味着非官方安装程序安全</strong></h3><p>Check Point 建议从经过验证的来源获取 <strong><a href=\"https://hackread.com/top-ai-tools-for-red-teaming-in-2026/\">AI 工具</a></strong>，并限制运行来自未知发布者或存储库的应用。熟悉的产品名称、GitHub 下载页面和已签名的可执行文件都可能同时出现在同一个恶意包中。</p><p>该活动针对的是选择从何处下载 AI 工具的人群。在安装前检查来源，尤其是在授予管理员权限之前进行检查，是用户可以采取的实际措施，有助于避免这些假冒应用。</p>","original","zhKind","translation","complete","bjeatt5e69i374s0avljijkd0","Yoba利用虚假ChatGPT和Claude项目侧加载恶意DLL并投放XMRig","挖矿","Google","Check Point","https://hackread.com/fake-chatgpt-claude-apps-software-yoba-malware/","Hackread",{"_112":113,"_114":-5},"changelogVersion","2026-10-01T08:00","release"]
