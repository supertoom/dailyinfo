[{"_1":2,"_3":4},"root",{"_5":102},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794357635000,"id","dutfochl5zqbpgtoxwe32cj7v","title","France 指控 Iran 武装组织攻击约 700 家超市制冷系统","originalTitle","France Blames Iran for a Cyberattack That Heated Supermarket Refrigerators","summary","France 指控 Iran 革命卫队关联的 Shahid Kaveh 小组攻击了全国约 700 家超市的制冷系统。10 月 12 日凌晨，攻击者远程控制制冷设备，使温度升至 50 Celsius（122 Fahrenheit）并持续约 6 小时，Intermarché 报告单日损失达数千万欧元。","reason","材料给出了攻击范围、基础设施线索、司法调查及跨国响应，可用于判断这起破坏性攻击的规模与调查进展。","source",{"_76":101},"links",{"_93":100},"publishedAt","2026-11-10T07:35:05.000Z","discoveredAt","2026-11-10T07:43:21.818Z","timelineAt","category","activity","tags",[77,79,97,98,99],"score",83,"selected",true,"channel","news","story",{"_89":90,"_13":91},"x","readingMode","full","author","Associated Press","body",{"_61":92,"_93":-5,"_94":95,"_96":37},"outline",[],"relatedStories",[88],"topics",[68,69,70,71,72,73],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fcxTFo1NJF54","reportCount",3,"additionalSourceCount",2,{"_74":86,"_76":87},{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","attack","name","攻击活动","exploited","在野利用","black-market","数据窃取与黑产","ransomware","勒索软件","industrial","工业控制","iot","IoT 与车联网",{"_89":90,"_13":91},"publicId","60857cc0-39ba-44e7-93b7-3a108f8b6b7a","法国归因伊朗网络部队攻击700余零售点","<p><strong>法国周一将上个月针对超市冰箱的<a href=\"https://www.securityweek.com/refrigeration-controller-hack-spoils-food-across-european-supermarkets/\">网络攻击</a>归咎于伊朗，召见伊朗大使，并表示将寻求欧盟对这次袭击 responsible 者的制裁。</strong>\n\n\n\n</p><p>10月12日的袭击导致冰箱温度飙升，影响了该国10,000家超市中的约700家。巴黎检察官周一在一份声明中表示，他们发现伊朗准军事组织革命卫队是这起大规模网络攻击的幕后黑手。\n\n\n</p><p>法国外交部“以最严厉的方式”谴责了这次袭击。法国外交部长 Jean-Noël Barrot 在巴黎举行的 G7 会议期间表示，伊朗大使被召见，旨在“强烈抗议这一极其严重的行为”。\n\n\n</p><p>“这是一场规模和侵略性均前所未有的袭击。”Barrot 说。“这是首起以破坏为目的、针对法国本土的大规模网络攻击，对我们的国家利益和法国人民的安全构成重大威胁。因此，我们绝不会置之不理。”\n\n\n</p><p>他补充说：“我们将在欧洲层面制裁所有对这次袭击负责的人”，并誓言采取“任何其他必要措施”予以回应并阻止未来袭击。\n\n\n</p><p>巴黎检察官 Laure Beccuau 在一份声明中表示，周一已就涉嫌有组织网络犯罪正式展开司法调查，且存在“为了服务外国势力的利益而实施——本案中即伊朗——这一加重情节”。</p><p><span>广告。滚动继续阅读。</span></p><p>法国国家网络安全机构 ANSSI 将这次袭击归咎于 Shahid Kaveh 集团，该集团被描述为隶属于伊朗伊斯兰革命卫队的“网络部队”。Beccuau 说，调查针对该集团的头目、他的两名副手，以及可能因本案被确定的任何其他个人。\n\n\n</p><p>Beccuau 说，调查人员发现，袭击者使用了波斯语以及与位于伊朗的设备相关联的 IP 地址。巴黎检察院正在寻求国际逮捕令，她说。\n\n\n</p><p>10月12日凌晨，袭击者远程控制了法国各地数百家超市和独立商店的制冷系统。温度升至 50 摄氏度（122 华氏度）并持续约六小时，迫使商店丢弃生鲜和冷冻商品。Intermarché 超市连锁 reported 一天损失达“数千万欧元”。\n\n\n</p><p>上周，法国发生的另一起<a href=\"https://www.securityweek.com/cyberattack-hits-french-blood-bank-site-but-no-blood-products-are-compromised/\">针对多家血库的</a>网络攻击试图将温度升至极高水平，但在对血液制品或样本造成任何损害之前即被挫败。法国国家网络安全机构和巴黎检察官正在调查该事件。\n\n\n</p><p>同样在上周，瑞典、比利时、卢森堡、爱尔兰和爱沙尼亚的超市遭遇了<a href=\"https://www.securityweek.com/over-100-european-stores-hit-as-supermarket-fridge-attacks-resume/\"> freezer 和 fridge 问题</a>，显然是由网络攻击造成的，迫使一些超市丢弃毁坏的食物。\n\n\n</p><p>ANSSI 网络安全机构表示，自 2020 年以来，它已成功将针对法国的其他一些网络攻击归咎于另一个名为 Shahid Shoostari 的集团，该集团同样隶属于伊朗伊斯兰革命卫队。其中包括 2023 年针对讽刺报纸 Charlie Hebdo 的袭击，以及 2024 年针对巴黎奥运会组织机构的袭击。\n\n\n</p><p><strong>相关</strong>：<a href=\"https://www.securityweek.com/italys-meloni-blames-pro-russian-hackers-for-leak-of-foreign-ministers-data-on-the-dark-web/\">意大利的梅洛尼指责亲俄黑客将外交部长数据泄露至暗网</a>\n\n\n\n</p><p><strong>相关</strong>：<a href=\"https://www.securityweek.com/us-agencies-urge-organizations-to-harden-refrigeration-controllers/\">美国机构敦促各组织加强制冷控制器安全防护</a>\n\n\n\n</p><p><strong>相关</strong>：<a href=\"https://www.securityweek.com/france-blames-russia-for-cyberattacks-on-dozen-entities/\">法国指责俄罗斯对十余个实体发动网络攻击</a>\n      </p>","original","zhKind","translation","complete","IoT","工控","数据窃取","https://www.securityweek.com/france-blames-iran-for-a-cyberattack-that-heated-supermarket-refrigerators/","SecurityWeek",{"_103":104,"_105":-5},"changelogVersion","2026-10-01T08:00","release"]
