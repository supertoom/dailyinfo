[{"_1":2,"_3":4},"root",{"_5":103},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1793591188000,"id","uu0z6mo1muhhj4bo1sst643w9","title","FBI 将 Binance 63 亿美元加密资产窃取案归因于朝鲜 TraderTraitor","originalTitle","FBI links $6.3 billion Binance crypto heist to North Korean hackers","summary","FBI 确认朝鲜国家支持的 TraderTraitor 实施了 Binance 加密资产窃取案，涉及 2026 年 10 月 29 日前后超过 $6 billion 的虚拟资产，攻击者通过入侵 DevOps 工程师笔记本进入服务容器并提交未授权提现交易。","reason","原文披露了攻击入口、跨链资金流向、资产洗钱路径及公开地址，为加密交易所识别和拦截关联资金提供了具体依据。","source",{"_75":102},"links",{"_96":101},"publishedAt","2026-11-01T19:57:53.000Z","discoveredAt","2026-11-01T20:43:31.348Z","timelineAt","category","activity","tags",[78,100,80,76],"score",87,"selected",true,"channel","news","story",{"_86":87,"_13":88},"x","readingMode","full","author","Lawrence Abrams","body",{"_61":95,"_96":-5,"_97":98,"_99":37},"outline",[89],"relatedStories",[85],"topics",[68,69,70,71,72],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","f39FEvqrWazs","reportCount",4,"additionalSourceCount",3,{"_73":83,"_75":84},{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","malware","name","恶意软件","attack","攻击活动","exploited","在野利用","black-market","数据窃取与黑产","ransomware","勒索软件",{"_86":87,"_13":88},"publicId","6ef2ec24-f871-4ca2-9cc2-5fcbd249af24","FBI归因TraderTraitor窃取Binance资产",{"_11":90,"_91":92,"_93":94},"sec-1","text","发现现有防御可能遗漏的电子邮件威胁。","level",2,"<p><img alt=\"North Korean hackers\" height=\"900\" src=\"/dailyinfo/media/7ae82b99252b5360.jpg\" srcset=\"/dailyinfo/media/537130235768ac39.jpg 720w, /dailyinfo/media/bb70851f3dbc70fd.jpg 1200w, /dailyinfo/media/7ae82b99252b5360.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>FBI 已确认，朝鲜国家支持的黑客组织 TraderTraitor 制造了针对 Binance 的 63 亿美元加密货币盗窃攻击，使其成为有记录以来规模最大的加密货币劫案。</p><p>该机构在周六发布的安全警报中将此次攻击归因于 TraderTraitor。这个朝鲜黑客组织也被追踪为 Lazarus Group、Jade Sleet 和 APT38，曾牵涉多起加密货币盗窃案。</p><p>“联邦调查局（FBI）发布信息，告知朝鲜民主主义人民共和国（朝鲜）应对大约于 2026 年 10 月 29 日从加密货币交易所 Binance 窃取超过 60 亿美元的虚拟资产负责，”<a href=\"http://www.fbi.gov/investigate/cyber/alerts/2026/north-korea-responsible-for-6-billion-binance-attack\">FBI 表示</a>。</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/46cc8742ac648b73.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>这一官方归因紧随区块链情报公司 TRM Labs 和 Chainalysis 之后；这些公司此前已将此次盗窃与 TraderTraitor 联系起来。</p><p>正如<a href=\"https://www.bleepingcomputer.com/news/security/binance-links-63-billion-crypto-theft-to-compromised-devops-laptop/\">此前报道</a>的那样，Binance 将此次入侵与一台遭入侵的 DevOps 工程师笔记本电脑联系起来，攻击者借此访问了服务容器并提交未经授权的提现交易。</p><p>攻击者从十条区块链中窃取了约 63.6 亿美元的加密货币，其中大部分资金在仅 20 分钟内即被转走。</p><p>FBI 表示，已观察到 TraderTraitor 主要将被盗资产转换为 Ethereum（ETH），并预计这些资产随后会通过去中心化金融（DeFi）平台和即时加密货币兑换服务进一步洗钱。</p><p>FBI、美国特勤局和 IRS 刑事调查局目前正要求加密货币交易所、区块链运营方及其他虚拟资产服务提供商，拦截与黑客用于清洗被盗资金的地址有关的交易。</p><p>该机构还公布了一份与此次盗窃有关的 628 个加密货币地址清单，其中包括 608 个 Ethereum 地址、19 个 Bitcoin 地址和一个 Solana 地址。</p><p>TraderTraitor 长期以来一直以加密货币公司及其员工为目标；朝鲜黑客与多起加密货币盗窃攻击有关，包括 2026 年 9 月的<a href=\"https://www.bleepingcomputer.com/news/security/hackers-steal-3516-million-in-bitget-crypto-exchange-hack/\">3.875 亿美元 Bitget 盗窃案</a>、2026 年 4 月的<a href=\"https://www.bleepingcomputer.com/news/security/drift-280m-crypto-theft-linked-to-6-month-in-person-operation/\">2.8 亿美元 Drift 黑客攻击</a>、2025 年 2 月的<a href=\"https://www.bleepingcomputer.com/news/security/fbi-confirms-lazarus-hackers-were-behind-15b-bybit-crypto-heist/\">15 亿美元 Bybit 劫案</a>，以及 2024 年 5 月的<a href=\"https://www.bleepingcomputer.com/news/security/fbi-links-north-korean-hackers-to-308-million-crypto-heist/\">3.08 亿美元 DMM Bitcoin 盗窃案</a>。</p><p>朝鲜 Lazarus 黑客采用的一种手段是名为“<a href=\"https://www.bleepingcomputer.com/news/security/lazarus-hackers-now-push-linux-malware-via-fake-job-offers/\">Operation DreamJob</a>”的长期行动，他们冒充招聘人员，以虚假的职位招聘接近软件开发人员和加密货币行业员工，诱骗他们安装恶意软件。</p><p>DMM 和 Bybit 的攻击都涉及入侵员工或开发人员的计算机，而这些人员拥有加密货币基础设施的访问权限。</p><p>在 DMM Bitcoin 攻击中，黑客在 LinkedIn 上冒充招聘人员，诱骗加密货币钱包公司 Ginco 的一名员工运行伪装成入职前测试的恶意 Python 代码。</p><p>Bybit 劫案同样源自一台遭入侵的 Safe{Wallet} 开发者计算机；黑客借此访问钱包平台，并操纵 DMM 员工发起的一笔合法交易请求，将 15 亿美元的加密货币重定向至他们控制的钱包。</p><p>最近，2026 年 4 月的 Drift 攻击涉及一项为期六个月的社会工程行动；冒充加密货币交易公司代表的人员在多场行业会议上与 Drift 贡献者面对面接触。</p><p>攻击者花费数月时间建立关系，并被认为通过恶意代码仓库或 TestFlight 应用程序入侵了员工的设备。</p><p>Binance 今天向 BleepingComputer 提供的一份声明称，其正准备于 11 月 1 日 06:00 至 09:00 UTC 恢复提现的第一阶段，同时继续努力恢复服务并弥补被盗资产。</p><p>该交易所表示，目前已弥补约 95% 的受影响金额，高于此前更新中的 90%。剩余的 5% 由流动性较低的代币组成，Binance 正继续通过市场和场外渠道购买这些代币。</p><p>Binance 还表示，BTC、ETH、USDT、BNB、SOL、USDC、XRP、USD1、RLUSD 和 ZEC 的余额均已获得充分支持，存款服务未受此次事件影响。</p><p>Binance 告诉 BleepingComputer：“我们的承诺保持不变：Binance 将承担被盗资金造成的经济影响。这些损失不会转嫁给用户。”</p><p>Binance 告诉 BleepingComputer：“恢复提现是一个重要里程碑，但我们的工作仍在继续。我们将继续加强防护措施、完成恢复流程，并在进展持续推进时提供最新消息。”</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/dc92bacf94761ef1.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体会分析电子邮件意图、上下文和行为，以发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>对 Microsoft 365 或 Google Workspace 进行为期 14 天的只读扫描，看看有哪些威胁正在绕过防护，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始您的免费电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","数据窃取","https://www.bleepingcomputer.com/news/security/fbi-links-63-billion-binance-crypto-heist-to-north-korean-hackers/","BleepingComputer",{"_104":105,"_106":-5},"changelogVersion","2026-10-01T08:00","release"]
