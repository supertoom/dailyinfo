[{"_1":2,"_3":4},"root",{"_5":116},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1794195832000,"id","oqf3ilkojaoxvmwkje49idzjc","title","CTM360 揭示全球礼品卡骗局利用 PlayStation、Amazon 等品牌实施订阅欺诈","originalTitle","CTM360 Exposes Fake Gift Card Scams Exploiting Trusted Brands","summary","CTM360 发现超过 1,000 起礼品卡骗局活动，攻击者冒充 PlayStation、Sephora、SHEIN、Walmart、Amazon 等品牌，以名人或网红背书和免费礼品卡广告引流。","reason","source",{"_74":115},"links",{"_61":114},"publishedAt","2026-11-07T14:10:19.000Z","discoveredAt","2026-11-07T17:50:29.563Z","timelineAt","category","activity","tags",[75,111,112,113],"score",54,"selected",false,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Sponsored by CTM360","body",{"_107":-5,"_61":108,"_109":-5,"_110":36},"outline",[86,87,88,89,90,91],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fZXSWsBHK1Nc","reportCount",1,"additionalSourceCount",0,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","attack","name","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","email","邮件与钓鱼",{"_83":84,"_13":85},"publicId","94cb0fd9-2149-4559-b6ca-6363595cdd72","礼品卡诈骗借品牌推广订阅欺诈",{"_11":105,"_93":106,"_95":96},{"_11":103,"_93":104,"_95":96},{"_11":101,"_93":102,"_95":96},{"_11":99,"_93":100,"_95":96},{"_11":97,"_93":98,"_95":96},{"_11":92,"_93":94,"_95":96},"sec-6","text","Risks to Users and Organizations","level",2,"sec-5","Technical Observations: Affiliate Hand-Offs","sec-4","The Endless Verification Loop and Monetization","sec-3","Download The Gift Card Scam Report","sec-2","How the Campaign Works: The Fake Generation Trap","sec-1","1,000+ Incidents Exploiting Trusted Brands","zh","<p><img alt=\"Gift Card scam\" height=\"900\" src=\"/dailyinfo/media/fbda39af98980b46.jpg\" srcset=\"/dailyinfo/media/f00f70a44f098427.jpg 720w, /dailyinfo/media/7ab5d41e2d353a0f.jpg 1200w, /dailyinfo/media/fbda39af98980b46.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>Fraudulent reward portals and fake gift card giveaways are surging globally, tricking users into deceptive verification loops and paid subscriptions.</p><p>These scams lure victims with a simple pitch: click an ad featuring a celebrity endorsement, claim a free gift card from a well-known brand, and complete a quick \"human verification\" step to unlock the reward.</p><p><strong>Read the full report here: <a href=\"https://www.ctm360.com/reports/gift-card-scams?utm_source=bleepingcomputer&amp;utm_medium=article&amp;utm_campaign=giftcard_report\">https://www.ctm360.com/reports/gift-card-scams</a></strong></p><p>Behind the polished branding, fake progress bars, and convincing promotional messages, however, no actual gift cards are provided.</p><p>Instead, these campaigns operate as large-scale affiliate monetization schemes designed to collect personal information, generate application installs, and enroll unsuspecting users in recurring mobile subscriptions.</p><h2 id=\"sec-1\">1,000+ Incidents Exploiting Trusted Brands</h2><p>Based on activity observed by CTM360, analysts identified more than 1,000 incidents linked to this recurring campaign.</p><p>Threat actors exploit consumer familiarity with established brands, frequently impersonating major retailers and consumer platforms such as PlayStation, Sephora, SHEIN, Walmart, and Amazon.</p><p>To increase credibility and attract potential victims, the campaigns rely heavily on social media distribution through:</p><ul>\n\t<li>Sponsored social media ads</li>\n\t<li>Viral posts promoting \"giveaways\"</li>\n\t<li>Fabricated endorsements from high-profile celebrities and influencers (such as MrBeast or Alix Earle)</li>\n</ul><p>Because the underlying infrastructure is highly modular, threat actors can swap out the impersonated brand, celebrity lure, and domain name without rebuilding the core scam engine.</p><h2 id=\"sec-2\">How the Campaign Works: The Fake Generation Trap</h2><p>CTM360 maps this activity using a structured fraud lifecycle, highlighting how victims are systematically pushed through a psychological progression of curiosity, trust, and urgency.</p><p>Once a user clicks a malicious ad, they are redirected to a fraudulent reward portal.</p><p>To appear credible, these websites display:</p><ul>\n\t<li>Cloned brand logos and colors</li>\n\t<li>Fake participant numbers and live countdown timers</li>\n\t<li>Fabricated testimonials from \"recent winners\"</li>\n</ul><p>After a victim selects a gift card value, the site runs a scripted, visual progress animation simulating the generation of the card on the back end.</p><p>The portal then displays a partially masked code (e.g., XXXX-XXXX-7F3A-XXXX) to convince the user that the reward is real and ready to claim.</p><p>Before the full code is revealed, the victim is presented with a deceptive \"Security Check\" or \"Human Verification\" gate.</p><h2 id=\"sec-3\"><a href=\"https://www.ctm360.com/reports/gift-card-scams?utm_source=bleepingcomputer&amp;utm_medium=article_cta&amp;utm_campaign=giftcard_report\">Download The Gift Card Scam Report</a></h2><p>Discover how threat actors use brand impersonation and fake rewards to exploit users.</p><p>Get insights into attacker infrastructure and learn to defend your organization with CTM360's Digital Risk Protection.</p><p><a href=\"https://www.ctm360.com/reports/gift-card-scams?utm_source=bleepingcomputer&amp;utm_medium=article_cta&amp;utm_campaign=giftcard_report\">Download Now</a></p><h2 id=\"sec-4\">The Endless Verification Loop and Monetization</h2><p>The \"human verification\" step is a deceptive pivot into what CTM360 identifies as \"Trap 10.\" Rather than performing a legitimate security check, the verification process redirects victims to third-party activities designed to generate revenue for the operators.</p><p>Victims are pushed into an endless loop of:</p><ul>\n\t<li>Completing surveys, quizzes, and promotional offers.</li>\n\t<li>Installing unwanted third-party applications or browser extensions.</li>\n\t<li>Subscribing to paid mobile services through localized carrier-billing mechanisms</li>\n</ul><p>If a user completes a task, they are not given the gift card. The site simply reports the step as \"incomplete\" and pushes the victim to another offer. In all flows tested by CTM360, no reward was ever delivered.</p><h2 id=\"sec-5\">Technical Observations: Affiliate Hand-Offs</h2><p>Unlike traditional phishing that steals user credentials, this campaign operates on a volume-and-conversion model.</p><p>CTM360 observed that lure pages redirect victims through affiliate tracking URLs (e.g., passing parameters like offer_id and aff_id).&nbsp; This tracking token links the victim's registration directly to the threat actor's affiliate network account.</p><p>When a victim completes a mobile number submission and PIN/OTP verification for a subscription, the threat actor earns a commission.</p><h2 id=\"sec-6\">Risks to Users and Organizations</h2><p>For the victim, the fallout goes beyond wasted time. Consequences include personal information exposure, unexpected mobile billing charges, and an influx of spam.</p><p>For organizations, this represents a severe abuse of brand reputation. The campaign highlights a broader trend: attackers are operating at scale, weaponizing brand trust as a mechanism to drive lucrative affiliate conversions.</p><p><strong>Detect Cyber Threats 24/7 with CTM360: Monitor, analyze, and promptly mitigate risks across your external digital landscape with the CTM360.</strong></p><p><strong><a href=\"https://www.bleepingcomputer.com/news/security/ctm360-exposes-fake-gift-card-scams-exploiting-trusted-brands/www.ctm360.com/?utm_source=bleepingcomputer&amp;utm_medium=article_cta&amp;utm_campaign=giftcard_report\">Join our Community Edition</a></strong></p><p><i>Sponsored and written by <a href=\"https://www.ctm360.com/?utm_source=bleepingcomputer&amp;utm_medium=article&amp;utm_campaign=giftcard_report\">CTM360</a>.</i></p>","zhKind","complete","钓鱼","黑产","数据窃取","https://www.bleepingcomputer.com/news/security/ctm360-exposes-fake-gift-card-scams-exploiting-trusted-brands/","BleepingComputer",{"_117":118,"_119":-5},"changelogVersion","2026-10-01T08:00","release"]
