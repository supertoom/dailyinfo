[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795480847000,"id","xodjyqyebnu85gm1rsu8fdqyr","title","Chrome Stable 158 修复 Critical 漏洞 CVE-2026-134401","originalTitle","Stable Channel Update for Desktop","summary","Chrome Stable 渠道已更新至 Windows 和 Mac 的 158.0.8127.88/.89，以及 Linux 的 158.0.8127.88，更新将在未来数天或数周内推送。","reason","source",{"_72":96},"links",{"_61":95},"publishedAt","2026-11-23T20:52:51.321Z","discoveredAt","2026-11-23T21:42:40.490Z","timelineAt","category","vuln","tags",[92,93,75,94],"score",61,"selected",false,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","Srinivas Sista","body",{"_88":-5,"_61":89,"_90":-5,"_91":36},"outline",[82],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","f-8QamxUDC9E","reportCount",1,"additionalSourceCount",0,{"_71":76,"_72":77},{"_71":74,"_72":75},{"_71":30,"_72":73},"slug","name","漏洞披露","browser","浏览器","google","Google / 谷歌",{"_79":80,"_13":81},"publicId","7d015aec-9eae-43d6-b02b-c5e0401eb4ca","Chrome 158稳定版修复严重漏洞",{"_11":83,"_84":85,"_86":87},"sec-1","text","Security Fixes and Rewards","level",2,"zh","<p><span><span>The Stable channel has been updated to 158.0.8127.88/.89 for Windows and</span><span> </span><span>Mac and </span></span><span>158.0.8127.88 to </span><span><span>Linux which will roll out over the coming days/weeks. A full list of changes in this build is available in the <a href=\"https://chromium.googlesource.com/chromium/src/+log/158.0.8127.37..158.0.8127.89?pretty=fuller&amp;n=10000\">Log</a>.</span></span>&nbsp;</p><p><span><h2 id=\"sec-1\"><span><span>Security Fixes and Rewards</span></span></h2><p><span><span>Note: Access to bug details and links may be kept restricted until a majority of users are updated with a fix. We will also retain restrictions if the bug exists in a third party library that other projects similarly depend on, but haven’t yet fixed.</span></span></p><span><br></span><p><span><span>This update includes </span><a href=\"https://issues.chromium.org/issues?q=customfield1223088:2-M158\"><span>1</span></a><span> security fixes. Please see the </span><a href=\"https://www.chromium.org/Home/chromium-security\"><span>Chrome Security Page</span></a><span> for more information.</span></span></p><span><br></span><p><span><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/554051967\"><span>554051967</span></a><span>] Critical CVE-2026-134401: Improper input validation in Variations. </span><span>Reported by Google on 2026-08-28</span></span></p><span><br></span><p><span><span>We would also like to thank all security researchers that worked with us during the development cycle to prevent security bugs from ever reaching the stable channel.</span></span></p><span><br></span><p><span><span>Many of our security bugs are detected using </span><a href=\"https://code.google.com/p/address-sanitizer/wiki/AddressSanitizer\"><span>AddressSanitizer</span></a><span>, </span><a href=\"https://code.google.com/p/memory-sanitizer/wiki/MemorySanitizer\"><span>MemorySanitizer</span></a><span>, </span><a href=\"https://www.chromium.org/developers/testing/undefinedbehaviorsanitizer\"><span>UndefinedBehaviorSanitizer</span></a><span>, </span><a href=\"https://www.chromium.org/developers/testing/control-flow-integrity/\"><span>Control Flow Integrity</span></a><span>, </span><a href=\"https://chromium.googlesource.com/chromium/src/+/HEAD/testing/libfuzzer/README.md\"><span>libFuzzer</span></a><span>, or </span><a href=\"https://github.com/google/afl\"><span>AFL</span></a><span>.</span></span></p></span></p><p><span>Interested in switching release channels? Find out how </span><span><a href=\"https://www.chromium.org/getting-involved/dev-channel\">here</a><span>. If you find a new issue, please let us know by </span><a href=\"https://crbug.com/\">filing a bug</a><span>. The </span><a href=\"https://support.google.com/chrome/community\">community help forum</a><span> is also a great place to reach out for help or learn about common issues.</span></span></p><p><span><span>Srinivas Sista</span></span></p><p><span>Google Chrome</span></p>","zhKind","complete","漏洞","补丁","Google","http://chromereleases.googleblog.com/2026/11/stable-channel-update-for-desktop_01734282054.html","Chrome Releases",{"_98":99,"_100":-5},"changelogVersion","2026-10-01T08:00","release"]
