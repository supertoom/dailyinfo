[{"_1":2,"_3":4},"root",{"_5":115},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1793665812000,"id","l79qvcx1c4awu9yey6ibz7nvh","title","Google 联合伙伴中断 XCPE Android 僵尸网络，封锁 Videostrong","originalTitle","Google disrupts million-device XCPE Android malware botnet, bans TV box maker","summary","Google 与日本国家警察机构及多家安全公司联合中断了 XCPE 僵尸网络，该网络涉及超过 130 万台 Android TV 流媒体机，Google 高置信度认定设备厂商 Videostrong Technology Co. 在制造阶段故意植入持久后门并向犯罪团伙出售访问权限。","reason","source",{"_76":114},"links",{"_103":113},"publishedAt","2026-11-02T18:16:34.000Z","discoveredAt","2026-11-02T19:04:33.239Z","timelineAt","category","activity","tags",[79,77,109,81,110,111,112],"score",82,"selected",true,"channel","news","story",{"_87":88,"_13":89},"x","sameEvent",{"_11":107,"_13":108},"readingMode","full","author","Lawrence Abrams","body",{"_62":102,"_103":-5,"_104":105,"_106":36},"outline",[90,91,92],"relatedStories",[86],"topics",[69,70,71,72,73],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","flU3MNG-JM7M","reportCount",4,"additionalSourceCount",3,{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","malware","name","恶意软件","attack","攻击活动","botnet","僵尸网络","iot","IoT 与车联网","google","Google / 谷歌",{"_87":88,"_13":89},"publicId","d06829ad-986b-44e7-8164-4a64599bab09","Google拆除XCPE僵尸网络并封禁Videostrong",{"_11":100,"_94":101,"_96":97},{"_11":98,"_94":99,"_96":97},{"_11":93,"_94":95,"_96":97},"sec-3","text","发现现有防御可能遗漏的电子邮件威胁。","level",2,"sec-2","Videostrong 归属认定","sec-1","XCPE 僵尸网络","<p><img alt=\"Android tv streaming  botnet\" height=\"900\" src=\"/dailyinfo/media/853d3f065f553cd7.jpg\" srcset=\"/dailyinfo/media/58823fc6c351df58.jpg 720w, /dailyinfo/media/d36521bee02f7f9a.jpg 1200w, /dailyinfo/media/853d3f065f553cd7.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>Google 与行业合作伙伴已经瓦解了 XCPE 恶意软件僵尸网络，该网络由超过 130 万台 Android TV 流媒体电视盒子组成。Google 表示，其制造商故意对这些设备植入了恶意软件，以通过网络犯罪活动获取收益&nbsp;。</p><p>该公司高度确信，该僵尸网络源自中国设备制造商 Videostrong Technology Co，并指控该公司故意在其制造的设备中安装持久化后门，同时向犯罪团伙出售访问权限。</p><p>这些犯罪团伙利用植入后门的设备部署恶意模块，用于广告欺诈、将受感染设备变成住宅代理，并安装额外的恶意软件。</p><p><a href=\"https://www.wiz.io/lp/ai-security-starter-pack?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Security-Starter-Kit&amp;sfcid=701Vh00000cn7aRIAQ&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AI-Security-Bundle\"><img src=\"/dailyinfo/media/0d7fcec43838a1e8.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>作为此次处置的一部分，Google 表示其下线了十余个相关恶意软件家族所使用的 XCPE 命令与控制（C2）服务器，切断了对至少 1,000 万台其他受感染设备的访问。</p><p>这些额外设备是通过 XCPE 之外的恶意软件分发方式入侵的，其中包括零售机顶盒、卡拉 OK 机和远程医疗硬件。Google 表示，其中并非所有设备都是 Android 设备。</p><p>Google 还终止了与 Videostrong 的合作关系，撤销了其预装 Google 应用和服务制造 Android TV 设备的许可，并禁止该公司及其未来关联方生产经认证的 Android 设备或向经认证的供应商提供软件。</p><p><a href=\"https://cloud.google.com/blog/topics/threat-intelligence/shutting-the-door-on-the-xcpe-botnet\">Google 的威胁情报小组（GTIG）表示</a>：“我们高度确信，该后门和僵尸网络是由 Videostrong Technology Co. 为获取经济利益而有意开发、部署和运营的。”相关报告已于周一发布。</p><p>Google 表示，此次处置涉及日本警察厅以及 Lumen、HUMAN Security、Plume、Synthient 和 TrendAI 等安全公司；这些机构协调分析恶意基础设施并中断其运营。</p><h2 id=\"sec-1\">XCPE 僵尸网络</h2><p>与其他通常通过漏洞入侵设备，或诱骗用户安装恶意软件的僵尸网络不同，XCPE 僵尸网络是在制造过程中直接嵌入设备固件的。</p><p>Google 表示，Videostrong 多年来一直在多个设备品牌和型号中开发和分发该恶意软件，并不断演进其功能，以规避检测并支持不同的犯罪团伙。</p><p>Google 表示：“我们发现这款恶意软件多年来被直接内置于许多不同的设备型号和品牌中，并配有专用基础设施和持续演变的配置，以规避检测并管理其关联方。”</p><p>主要后门组件被追踪为 <code>x.cpe</code> 和 <code>com.oemservice</code>，以 Android 系统级权限运行。</p><p>该恶意软件采用模块化架构，将后门功能与用于为犯罪团伙创收的模块相分离。</p><p>受感染设备启动后，XCPE 会联系 <code>anyevonline[.]com</code> 域名上的命令与控制服务器，获取 MQTT 消息代理的连接信息和凭据，随后通过该代理接收命令。</p><p>Google 表示，该恶意软件会根据 Android 版本和设备类型，使用 anyevonline[.]com 的不同子域名。托管在 <code>mqtt.szbboys[.]com</code> 的 MQTT 消息代理允许运营者向受感染设备发送命令并部署其他恶意软件。</p><p>通过此连接，运营者可以远程控制受感染设备并执行恶意操作，例如：</p><ul>\n\t<li>静默下载并安装额外的 Android 应用。</li>\n\t<li>禁用 Google Play Protect。</li>\n\t<li>以系统权限执行 shell 命令和脚本。</li>\n\t<li>截取屏幕截图并注入按键。</li>\n\t<li>收集账户信息、设备详细信息、已安装应用程序列表和系统日志。</li>\n\t<li>进行网络侦察并建立反向 shell。</li>\n</ul><p>这些设备还被用于通过安装属于其他运营商的恶意软件模块来创收，将该后门转变为供其他网络犯罪分子使用的插件式网络犯罪平台。</p><p>据 Google 稱，这些模块包括与住宅代理服务相关的软件，例如 Linkfog、AppSalt/Honeygain、GaGaNode、NetNut 和 Traffmonetizer，用于在设备所有者不知情或未同意的情况下将第三方互联网流量路由通过受感染设备。</p><p>其他模块通过生成广告展示、加载隐藏网页和点击广告来实施广告欺诈。一些模块安装了其他后门，包括 Moyu、Spirit 和 Bird，用于下载并执行其他恶意软件。</p><p>Google 表示，该僵尸网络运营者持续改变恶意软件的架构以避免被检测。</p><p>2024 年末，Videostrong 开始使用一个名为 <code>com.abc.nexus</code> 的独立加载程序，该加载程序在 XCPE 专注于与 C2 基础设施通信时运行恶意模块。</p><p>自 2026 年 8 月起，运营者开始用伪装成 Android 系统应用程序的更小型、专用植入程序替换该加载程序。</p><h2 id=\"sec-2\">Videostrong 归属认定</h2><p>网络安全公司 Synthient 在一份<a href=\"https://synthient.com/blog/the-internals-of-a-badbox-operation\">独立协调报告</a>中 explains 了如何在发现该恶意软件预装于 2025 年末购买的 MECOOL KM9PRO Max Android TV 机顶盒后，将 XCPE 后门和基础设施追踪至 Videostrong。</p><p>在调查过程中，Synthient 在恶意软件的 <code>file.anyevonline[.]com&nbsp;</code> 服务器上发现了一个公开访问的目录，其中托管了运营者使用的后门。该开放目录还包括一个 PDF 文件夹，其中包含由 Videostrong Technology Co. 研发总监 Owen Cao 编写的一份 PDF。</p><p>研究人员还发现，Videostrong 的 <code>videostrong[.]cn</code> 域名指向与 <code>mqtt.anyevonline[.]com</code> 相同的 IP 地址；后者是命令与控制服务器，允许运营者列出已失陷设备、下发命令并管理应用程序安装。</p><p>此外，Synthient 发现 numerous Videostrong 公司电子邮件地址被用于对这些后门进行签名。</p><p>Google 表示，证据表明该制造商是故意安装了恶意软件，而非由单个员工擅自操作或开发疏忽所致。</p><p>Google 称：“我们认为这次活动并非单个内部人员擅自操作或开发疏忽所致。”</p><p>Google 还表示，在发现 Videostrong 使用混淆技术规避安全测试并在设备首次启动后加载恶意代码后，已修改其认证审查流程。</p><p>虽然 Google 表示此次下架已扰乱 XCPE 的运营，但该恶意软件并未从受感染设备中移除，如果被移除，它会自动从 /oem/ 分区重新安装。</p><p>因此，用户需要安装干净的固件以清除感染，或将受影响的设备断网，以防止进一步恶意活动。</p><p>BleepingComputer 已就有关该僵尸网络的更多问题联系 Google，如收到回应将更新报道。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/3e0af1aa7fd35e6a.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-3\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体分析电子邮件意图、上下文和行为，发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>通过 14 天只读扫描查看 Microsoft 365 或 Google Workspace 中有哪些内容被成功传递，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始您的免费电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","wbjzunigapakv96vd54t9g53c","Google 联合处置 XCPE 僵尸网络，Videostrong 预装后门感染逾 130 万台机顶盒","后门","IoT","Google","Trend Micro","https://www.bleepingcomputer.com/news/security/google-disrupts-million-device-xcpe-android-malware-botnet-bans-tv-box-maker/","BleepingComputer",{"_116":117,"_118":-5},"changelogVersion","2026-10-01T08:00","release"]
