[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794195834000,"id","vjdhd6f9hgfqlc9p5znn3m95n","title","Cursor Marketplace 上架的 Claude Code 扩展被植入持久化 SSH 后门","originalTitle","Official Claude Code Extension on Cursor Marketplace Trojanized with Persistent SSH Backdoor","summary","Cursor Marketplace 中被篡改的官方 Claude Code VS Code 扩展会安装持久化 SSH 后门，影响至多 5,000 名用户。","reason","文章梳理了恶意扩展的注入代码、持久化方式、回连地址与数据采集范围，并说明 macOS 和 Windows 上启用本地 SSH 的限制，便于读者识别感染痕迹并开展处置。","source",{"_74":97},"links",{"_87":96},"publishedAt","2026-10-30T08:55:47.000Z","discoveredAt","2026-10-30T10:49:16.864Z","timelineAt","category","activity","tags",[77,75,91,92,93,94,95],"score",83,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_61":86,"_87":-5,"_88":89,"_90":37},"outline",[],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","f_fmgivN32NY","reportCount",5,"additionalSourceCount",4,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","malware","name","恶意软件","attack","攻击活动","ai-offense","AI 攻防","supply-chain","供应链安全",{"_83":84,"_13":85},"publicId","d3e174f7-d5d8-44bb-8d90-c99f11f75d8c","Cursor市场分发恶意Claude Code扩展","<p><span><i></i><span>Ravie Lakshmanan</span><i></i><span>2026年10月30日</span></span><span>恶意软件 / 人工智能</span></p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEggT2-bdx6q5Aa-HsOIuOeYTY1kFbPYIPIaA7N0Esdo4LHRscpkr3fMnRNiE_NqR71eURHrlqkC1stLKp2bKmT8cLHta8uYyGPtbWRwGm5ctnpMJC-8Q7pswyRP5hXMkIDjptIHDBdcQobfqaMEu9eXfPS9c_vvIi-jYmZBHVnKJb04CtcCyGOeBY709cdq/s1600/claude-vs.png\"><img alt=\"\" src=\"/dailyinfo/media/939dc4feb23bc622.webp\" loading=\"lazy\" decoding=\"async\"></a></p><p>网络安全研究人员<a href=\"https://opensourcemalware.com/blog/trojanized-claude-code-extension-plants-persistent-ssh-backdoor\">披露</a>，Anthropic 官方的 Claude Code 扩展在 Cursor Marketplace 上遭到入侵，会在受感染主机上安装持久化 SSH 后门。</p><p>此后，该问题被追踪到 Cursor Marketplace 遭到入侵，促使人工智能编码平台 Cursor 暂时下线该服务以清除恶意软件。</p><p>“我们发现了一起安全事件，影响了一个经过修改、并通过我们的 Cursor IDE 扩展市场访问的 Claude Code VS Code 扩展，最多影响 5,000 名用户，”Cursor <a href=\"https://x.com/cursor_ai/status/2116074289053175808\">表示</a>。“这个恶意版本的扩展并非由 Anthropic 开发。它不会影响从 cursor[.]com/marketplace、Grok Bot、Grok 或我们的其他 SpaceXSI 产品下载的其他扩展。”</p><p>“该软件包将自己标识为 anthropic.claude-code 版本 2.1.313，但其主 JavaScript bundle 中包含了一个恶意加载器；该加载器共 66 行，被插入在合法扩展代码之前，”OpenSourceMalware 联合创始人 Jenn Gile 在向 The Hacker News 提供的声明中说道。</p><p>截至 2026 年 10 月 30 日，恶意版本已被移除，Anthropic 已向 Open VSX 和 Microsoft VS Code Marketplace <a href=\"https://github.com/anthropics/claude-code/releases\">发布版本 2.1.314</a>。</p><p>该扩展被设计为在 VS Code 启动后及打开其 webview 时激活，随后会向用户的“~/.ssh/authorized_keys”文件中添加一个由攻击者控制的密钥。该密钥被标记为“svc-telemetry”，企图使其看起来无害。</p><p>随后，它会尝试让受害者能够通过 SSH 在 Windows、Linux 和 macOS 上被访问，建立通向“<a href=\"https://www.virustotal.com/gui/ip-address/134.209.82.225/detection\">134.209.82[.]225</a>”的反向隧道，以计划任务、crontab 和 LaunchAgent 的形式安装针对各平台的持久化机制，并通过未加密的 HTTP 请求在 8099 端口将主机侦察数据发送到“134.209.82[.]225:8099/beacon”。</p><p>“启用本地 SSH 服务需要管理员权限，而该恶意扩展在大多数 macOS 和 Windows 主机上并不具备这些权限，”这家由 SpaceXAI 持有的公司<a href=\"https://cursor.com/blog/claude-code-extension-security-notice\">表示</a>，并在其自身的事件分析中称。</p><p>“在这些主机上，该步骤会失败，攻击者无法通过隧道登录。但该扩展仍会添加攻击者的 SSH 密钥、安装持久化机制，并将主机详细信息发送给攻击者。无论如何，请遵循以下修复步骤。”</p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEj4Ew0Bj3BoXpUeH6TD2jNswGM1qWxJ956j4_sI9otnOjW_hHhyrbfmuhd-kovwe07nO3rsiuAjjOAq1kZXc4x5Gk_g8uqiYAyrm-RCnaGabGsNC-D1W_92UaKoUZ56AGraAszeX_pkW5hMAq1lFGu7VBicGP1jbBqNsd9BhTkjqWJT6CYNE0YcyF-u3mih/s1600/aa.png\"><img alt=\"\" src=\"/dailyinfo/media/d48c02129bf68601.webp\" loading=\"lazy\" decoding=\"async\"></a></p><p>收集的数据包括 -</p><ul>\n  <li>来自 api.ipify[.]org 的公共 IP 地址</li>\n  <li>主机名和本地用户名</li>\n  <li>操作系统和 CPU 架构</li>\n  <li>主目录和当前工作目录</li>\n  <li>通过 git config --global user.email 获得的全局 Git 电子邮件地址</li>\n  <li>最多 40 个包含 KEY、TOKEN、SECRET、PASS、AWS 或 GCP 的环境变量名称</li>\n</ul><p>“环境变量的值不会直接出现在初始信标中，”安全研究员 Paul McCarty 表示。“但它们的名称仍可能泄露已配置哪些云提供商、CI 系统和凭据类型。更重要的是，成功获得 SSH 访问权限后，操作者便能直接检查该账户。”</p><p>尚未发现其他后续有效载荷。不过，建立反向隧道提供了一条通往受害者 SSH 服务的路径，使操作者能够执行命令或传输文件。</p><p>“它被非常迅速地撤下了，但任何将 Claude Code 实例设置为自动更新的人都可能已经加载了恶意软件，”Gile 表示。</p><p>Cursor 已披露，该事件最多影响了 5,000 名用户；这些用户在 2026 年 10 月 29 日约凌晨 2:27 至下午 1:35（太平洋时间）期间安装了恶意版本。该公司还表示，将直接联系受影响用户。</p><p>建议在此时间窗口内安装了受损扩展的用户隔离相关主机，删除未经授权的 SSH 密钥和持久化机制，并轮换凭据与会话。</p><p>此次披露发生在一名身份不明的攻击者于 2026 年 3 月劫持 OVHcloud 合法贡献者（\"HassenBF\"）的 GitHub 账户后，将 OVHcloud 官方 CLI（\"ovh/ovhcloud-cli\"）中五个已发布版本的发布二进制文件替换为<a href=\"https://opensourcemalware.com/blog/glassworm-hacks-ovh-clouds-cli-tool\">窃取机密的恶意软件</a>并上传之后的稍多一周之后；此前，该攻击者<a href=\"https://thehackernews.com/2026/10/hackers-hijack-five-ovhcloud-cli.html\">替换</a>了这些二进制文件。这是<a href=\"https://thehackernews.com/2026/10/threatsday-ransomware-affiliate.html#malicious-vs-code-themes-exposed\">GlassWorm</a>行动的一部分。</p><p><i>（本报道的早期版本称，Open VSX 注册表上的扩展遭到入侵。此后，事件已被追踪至 Cursor VS Code Marketplace 遭到入侵。）</i></p><p>觉得这篇文章有意思吗？关注我们的 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a>，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","后门","AI 编码","供应链投毒","Microsoft","AWS","https://thehackernews.com/2026/10/official-claude-code-vs-code-extension.html","The Hacker News",{"_99":100,"_101":-5},"changelogVersion","2026-10-01T08:00","release"]
