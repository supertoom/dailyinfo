[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":-5,"_57":36,"_58":59},"expiresAt",1794616835000,"id","vw9f7bq05n0ruzl7tx1o1fwyc","title","美国司法部查获逾 12 亿美元并中断 North Korea FaceStealer 加密货币窃取基础设施","originalTitle","North Korea ‘s Crypto Theft Operations: DOJ Seizes $1.2 Billion and Disrupts Hacker Infrastructure","summary","美国司法部针对 North Korea 的加密货币窃取行动查获 FaceStealer 社会工程基础设施，并获得法院授权扣押近期从 Binance 窃取的逾 12 亿美元加密资产，相关资产总额已达 60 亿美元。","reason","source",{"_69":97},"links",{"_59":96},"publishedAt","2026-11-13T21:19:30.000Z","discoveredAt","2026-11-13T22:05:29.393Z","timelineAt","category","activity","tags",[72,93,70,74,94,95],"score",72,"selected",false,"channel","news","story","x","readingMode","full","author","Pierluigi Paganini","body",{"_89":-5,"_59":90,"_91":-5,"_92":36},"outline",[83],"relatedStories",[],"topics",[60,61,62,63,64,65,66],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_67":81,"_69":82},{"_67":79,"_69":80},{"_67":77,"_69":78},{"_67":75,"_69":76},{"_67":73,"_69":74},{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","malware","name","恶意软件","attack","攻击活动","ai-offense","AI 攻防","red-team","红队与渗透","black-market","数据窃取与黑产","ransomware","勒索软件","identity","身份与访问",{"_11":84,"_85":86,"_87":88},"sec-1","text","The DOJ seized over $1.2 billion from North Korea ‘s Binance theft, and says the","level",2,"zh","<h2 id=\"sec-1\">The DOJ seized over $1.2 billion from North Korea ‘s Binance theft, and says the same hackers are targeting open-source developers</h2><p>The U.S. Department of Justice announced two separate but connected actions against North Korea ‘s cryptocurrency theft operations. The <a href=\"https://www.justice.gov/opa/pr/justice-department-announces-actions-disrupt-north-koreas-massive-theft-cryptocurrency\">press release</a> covers the seizure of infrastructure behind a social engineering scheme called FaceStealer and court-authorized seizures tied to the $6 billion <a href=\"https://securityaffairs.com/202221/apt/fbi-blames-north-korea-for-6-billion-binance-crypto-theft.html\">Binance theft</a> of October 29. Together, the two moves put more than $1.2 billion back under law enforcement control.</p><p><em>“Today the Department of Justice announced coordinated actions against the Democratic People’s Republic of North Korea (DPRK) government’s schemes to fund its regime through the massive theft of cryptocurrency.” states the <a href=\"https://www.justice.gov/opa/pr/justice-department-announces-actions-disrupt-north-koreas-massive-theft-cryptocurrency\">press release</a> published by DoJ. “These actions include the seizure of cloud-based infrastructure used in the FaceStealer social engineering scheme that has resulted in the theft of more than $400 million worth of cryptocurrency and the court-authorized seizure and restraint of more than $1.2 billion worth of cryptocurrency recently stolen from Binance, a virtual currency exchange.”</em></p><p>FaceStealer is the FBI’s name for a scheme North Korea-linked hackers have run for the past 18 months. The same actors go by <a href=\"https://securityaffairs.com/154082/apt/sapphire-sleet-apt-targets-it-job-seekers.html\">Sapphire Sleet</a>, <a href=\"https://securityaffairs.com/tag/bluenoroff\">BlueNoroff</a>, <a href=\"https://securityaffairs.com/tag/apt38\">APT38 </a>and several other tracking names depending on who is writing the report. They’ve stolen more than $400 million that way, and they’ve also started targeting people who build and maintain open-source software, trying to reach the accounts and repositories those developers control.</p><p>The process is quite specific. The hackers send meeting invitations from accounts they have already stolen. This makes the invitations look as if they come from someone the target knows and trusts. During the meeting, they play a recorded video of a previous victim or use a <a href=\"https://securityaffairs.com/tag/deepfake\">deepfake</a> showing a well-known person in the cryptocurrency or Web3 industry. They use advanced AI tools to create convincing videos of influential people, making the FaceStealer scheme more effective.</p><p>The hackers then pretend there is a technical problem, such as an audio issue, and ask the target to click a link or follow instructions to fix it. This leads to the installation of malware. In several cases, the attackers waited months, or even more than a year, before stealing cryptocurrency or taking control of accounts. They also used each victim’s contact lists, social media accounts and messaging apps to identify and approach new targets.</p><p>Under a federal warrant, the FBI seized more than 900 webcam videos recorded from FaceStealer victims. </p><p><em>“The FBI today published <a href=\"https://www.ic3.gov/CSA/2026/261112.pdf\">a report</a> providing greater detail on the mechanics of the FaceStealer scheme, including best practices to protect against this scheme and steps victims can take in the event of a compromise. Additionally, the FBI created a website,&nbsp;<a href=\"http://www.fbi.gov/facestealer\">www.fbi.gov/facestealer</a>, to serve as a centralized hub for resources and information on the scheme.” continues the press release. “The effort to disrupt the FaceStealer campaign was led by Assistant U.S. Attorney Khaldoun Shobaki for the Central District of California and the FBI’s Los Angeles Field Office.”</em></p><figure><a href=\"https://i0.wp.com/securityaffairs.com/wp-content/uploads/2026/11/image-31.png?ssl=1\"><img width=\"867\" height=\"641\" src=\"/dailyinfo/media/f1c48f6282eab097.webp\" srcset=\"/dailyinfo/media/5520555aa9d7becc.webp 720w, /dailyinfo/media/aa87fab9f9b1b07d.webp 1200w, /dailyinfo/media/f1c48f6282eab097.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"North Korea\"></a></figure><p>The operation to seize the infrastructure was led by the U.S. Attorney’s Office for the Central District of California and the FBI’s Los Angeles Field Office.</p><p>The mechanics are specific. The hackers send meeting invitations from accounts stolen from earlier victims, so the invite looks like it comes from someone the target knows. Once in the meeting, the hackers play a pre-recorded video of a previous victim or use a deepfake of a well-known person in crypto or Web3 to simulate trusted contacts. </p><p><em>“The North Korean hackers also use super intelligence (SI) to develop deepfake videos of well-known and influential individuals often in the cryptocurrency and web3 industries that make the FaceStealer scheme even more effective.” FBI continues. “Here again, they use the deepfake videos in the meetings with targets to gain the target’s trust.”</em></p><p>Then they introduce a fake technical problem, such as claiming the target’s audio isn’t working, and offer a link or prompt to fix it. The fix installs malware. In several cases the hackers waited months or more than a year after the initial compromise before stealing cryptocurrency or hijacking accounts. They also used each new victim’s contact lists, social media and messaging apps to reach the next round of targets.</p><p>The FBI seized more than 900 webcam videos from FaceStealer victims under a federal warrant. It also published a detailed report on the scheme’s mechanics, with best practices and steps for anyone who suspects they’ve been compromised, and created a resource page at fbi.gov/facestealer. The infrastructure seizure was led by the Central District of California and the FBI’s Los Angeles Field Office.</p><p><em>“The North Korean regime relies on proceeds from large-scale cryptocurrency theft to fund its illicit weapons program, stealing billions of dollars in recent years,” said FBI Cyber Branch Operations Director Brett Leatherman. “North Korean cyber actors have used the FaceStealer scheme to aggressively target individuals in the cryptocurrency and Web3 sectors through deceptive social engineering tactics, resulting in the theft of more than $400 million in the last 18 months. The FBI remains committed to identifying, disrupting, and imposing cost on North Korean actors targeting the virtual asset community.”</em></p><p>Separately, the DOJ has been working since October 29 to freeze and recover the $6 billion stolen from Binance by North Korea’s TraderTraitor unit. Combined government and private-sector efforts have frozen more than $2.7 billion so far, and the DOJ has court authorization to seize or restrain more than $1.2 billion of that. The Criminal Division’s Computer Crime and Intellectual Property Section called it freezing about half of the historic breach before it got beyond law enforcement reach.</p><p><a href=\"https://securityaffairs.com/tag/tradertraitor\">TraderTraitor</a> actors continue to launder the remaining assets through cryptocurrency bridges, mixers and exchanges. The FBI, the U.S. Secret Service and IRS Criminal Investigation last week issued a joint cyber alert naming the addresses the actors are using and urging cryptocurrency service providers to block any transactions involving those addresses or funds derived from them.</p><p>North Korea uses cryptocurrency theft to support its weapons programs. The U.S. Department of Justice (DOJ) has repeatedly highlighted this link. A senior official from the department’s National Security Division said the regime uses these criminal operations to raise money for its weapons program. The DOJ also pledged to use all available legal tools to seize the stolen funds and return them to their rightful owners.</p><p>The FaceStealer campaign also shows how convincing these attacks can be. According to the FBI, the scheme can trick even experienced IT professionals and users who are well aware of cybersecurity risks.</p><p><em>“Efforts to trace, freeze, seize, and forfeit the stolen virtual assets are ongoing, as TraderTraitor actors continue to launder such assets through various cryptocurrency bridges, mixers, and exchanges.” concludes the press release. “For example, last week, the FBI, in coordination with its law enforcement partners at the U.S. Secret Service (USSS) and the Internal Revenue Service (IRS-CI), issued a&nbsp;<a href=\"https://www.fbi.gov/investigate/cyber/alerts/2026/north-korea-responsible-for-6-billion-binance-attack\">Cyber Alert</a> attributing the theft and urging VASPs to block transactions with or derived from cryptocurrency addresses TraderTraitor actors are using to launder the stolen Binance assets.”</em></p><p><strong>Follow me on Twitter:&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a><strong></strong></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;hacking,&nbsp;newsletter)</strong><strong></strong></p>","zhKind","complete","数据窃取","凭据","红队","https://securityaffairs.com/203012/cyber-crime/north-korea-crypto-theft-operations-doj-seizes-1-2-billion-and-disrupts-hacker-infrastructure.html","Security Affairs",{"_99":100,"_101":-5},"changelogVersion","2026-10-01T08:00","release"]
