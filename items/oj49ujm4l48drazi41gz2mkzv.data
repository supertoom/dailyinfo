[{"_1":2,"_3":4},"root",{"_5":181},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":-5,"_57":36,"_58":59},"expiresAt",1795653644000,"id","oj49ujm4l48drazi41gz2mkzv","title","Microsoft 披露 ARTEX 自主 AI 渗透测试框架被多类威胁组织滥用于攻击","originalTitle","What defenders need to know about ARTEX, the agentic AI framework threat actors abuse","summary","Microsoft Threat Intelligence 发现，2026 年 7 月发布的开源 AI 自主渗透测试框架 ARTEX 已被 Storm-0940、Storm-3358、Onyx Sleet、Pearl Sleet、Crystal Typhoon 和 Salt Typhoon 等威胁组织用于网络侦察、凭据攻击、Web 应用利用及供应链入侵。","reason","source",{"_66":180},"links",{"_173":179},"publishedAt","2026-11-25T18:09:06.000Z","discoveredAt","2026-11-25T20:25:23.004Z","timelineAt","category","activity","tags",[69,67,71,176,177,178],"score",82,"selected",false,"channel","news","story","x","readingMode","full","author","Microsoft Threat Intelligence","body",{"_59":172,"_173":-5,"_174":173,"_175":55},"outline",[74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105],"relatedStories",[],"topics",[60,61,62,63],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","zh",{"_64":72,"_66":73},{"_64":70,"_66":71},{"_64":68,"_66":69},{"_64":65,"_66":67},"slug","malware","name","恶意软件","attack","攻击活动","ai-offense","AI 攻防","microsoft","Microsoft / 微软",{"_11":170,"_107":171,"_109":115},{"_11":168,"_107":169,"_109":115},{"_11":166,"_107":167,"_109":115},{"_11":164,"_107":165,"_109":115},{"_11":162,"_107":163,"_109":115},{"_11":160,"_107":161,"_109":115},{"_11":158,"_107":159,"_109":110},{"_11":156,"_107":157,"_109":110},{"_11":154,"_107":155,"_109":110},{"_11":152,"_107":153,"_109":110},{"_11":150,"_107":151,"_109":110},{"_11":148,"_107":149,"_109":110},{"_11":146,"_107":147,"_109":110},{"_11":144,"_107":145,"_109":115},{"_11":142,"_107":143,"_109":110},{"_11":140,"_107":141,"_109":110},{"_11":138,"_107":139,"_109":110},{"_11":136,"_107":137,"_109":110},{"_11":135,"_107":119,"_109":110},{"_11":133,"_107":134,"_109":110},{"_11":131,"_107":132,"_109":110},{"_11":130,"_107":117,"_109":110},{"_11":128,"_107":129,"_109":110},{"_11":126,"_107":127,"_109":110},{"_11":124,"_107":125,"_109":115},{"_11":122,"_107":123,"_109":110},{"_11":120,"_107":121,"_109":110},{"_11":118,"_107":119,"_109":110},{"_11":116,"_107":117,"_109":110},{"_11":113,"_107":114,"_109":115},{"_11":111,"_107":112,"_109":110},{"_11":106,"_107":108,"_109":110},"sec-32","text","Learn more","level",3,"sec-31","References","sec-30","MITRE ATT&amp;CK techniques",2,"sec-29","Microsoft Sentinel","sec-28","Microsoft Defender XDR","sec-27","Microsoft Perception","sec-26","Audit logs and investigation data","sec-25","Hunting","sec-24","Threat intelligence reports","sec-23","Microsoft Security Copilot","sec-22","sec-21","Microsoft Defender for Cloud","sec-20","Microsoft Defender for Cloud Apps","sec-19","sec-18","Microsoft Entra ID Protection","sec-17","Microsoft Defender for Identity","sec-16","Microsoft Defender for Endpoint","sec-15","Microsoft Defender Antivirus","sec-14","Microsoft Defender detections","sec-13","Limit lateral movement and contain attacks automatically","sec-12","Protect cloud resources and data","sec-11","Protect application secrets and privileges","sec-10","Secure accounts and sign-ins","sec-9","Protect web servers","sec-8","Map and test attack paths","sec-7","Reduce internet-facing exposure","sec-6","Mitigation and protection guidance","sec-5","Identifying ARTEX system activity","sec-4","Identifying ARTEX network activity","sec-3","Capabilities","sec-2","AI agent architecture","sec-1","ARTEX: Publicly available AI-powered offensive security framework","<ol><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/25/what-defenders-need-to-know-artex-agentic-ai-framework-threat-actors-abuse/#artex-publicly-available-ai-powered-offensive-security-framework\">ARTEX: Publicly available AI-powered offensive security framework</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/25/what-defenders-need-to-know-artex-agentic-ai-framework-threat-actors-abuse/#ai-agent-architecture\">AI agent architecture</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/25/what-defenders-need-to-know-artex-agentic-ai-framework-threat-actors-abuse/#capabilities\">Capabilities</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/25/what-defenders-need-to-know-artex-agentic-ai-framework-threat-actors-abuse/#identifying-artex-network-activity\">Identifying ARTEX network activity</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/25/what-defenders-need-to-know-artex-agentic-ai-framework-threat-actors-abuse/#identifying-artex-system-activity\">Identifying ARTEX system activity</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/25/what-defenders-need-to-know-artex-agentic-ai-framework-threat-actors-abuse/#mitigation-and-protection-guidance\">Mitigation and protection guidance</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/25/what-defenders-need-to-know-artex-agentic-ai-framework-threat-actors-abuse/#microsoft-defender-detections\">Microsoft Defender detections</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/25/what-defenders-need-to-know-artex-agentic-ai-framework-threat-actors-abuse/#hunting\">Hunting</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/25/what-defenders-need-to-know-artex-agentic-ai-framework-threat-actors-abuse/#mitre-att-ck-techniques\">MITRE ATT&amp;CK techniques</a></li></ol><p>Since its release in July 2026, the AI-powered penetration testing framework ARTEX has been abused by many threat actors to accelerate their existing workflows related to network reconnaissance, credential attacks, and web application exploitation. As of November 2026, Microsoft Threat Intelligence has observed both state-sponsored and financially motivated threat actors such as <a href=\"https://www.microsoft.com/en-us/security/blog/2026/10/29/tracking-ai-adoption-in-north-korean-threat-actor-tradecraft/\">Storm-0940</a>, <a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/06/artex-abuse-expands-as-cybercriminals-target-financial-sector/\">Storm-3358</a>, <a href=\"https://www.microsoft.com/en-us/security/blog/2026/10/29/tracking-ai-adoption-in-north-korean-threat-actor-tradecraft/\">Onyx Sleet</a>, <a href=\"https://www.microsoft.com/en-us/security/blog/2026/10/29/tracking-ai-adoption-in-north-korean-threat-actor-tradecraft/\">Pearl Sleet</a>, Crystal Typhoon, and Salt Typhoon integrating ARTEX into their tooling.</p><p>In the past few weeks, we’ve reported several distinct campaigns that abused ARTEX to search public repositories for exposed secrets, enable supply chain compromise, and scan internet-facing systems for exploitation. These campaigns illustrate how threat actors use ARTEX to automate various stages of the attack chain. Threat actors define scope and targets for ARTEX, which then uses AI agents to set verifiable goals, define tactical steps for each stage of the operation, use tools to attack targets, create graphs to track discovered systems and results of actions, and report back to the threat actor. Depending on the threat actor’s configuration and the target’s defenses, ARTEX can advance from reconnaissance to persistent, privileged access to a target organization in a matter of minutes.</p><p>ARTEX does not introduce new attack techniques; it uses common, pre-existing penetration testing tools and techniques. ARTEX does sometimes transmit distinctive characteristics associated with its integrated penetration testing tools. However, threat actors using ARTEX can and do vary network indicators like source IP address or user agent string, especially to bypass static or simple signature-based detection and blocking. The most reliable and durable signal of ARTEX activity is behavioral: ARTEX sends a wide variety of requests in a brief time and retries variations on the same technique or moves on to next-stage actions at machine speed.</p><p>In this blog, we’re sharing a detailed breakdown of ARTEX, including its architecture and capabilities, as well as guidance for identifying related network and system activity. Microsoft disrupts and contains threats posed by ARTEX-enabled attacks across the Microsoft Defender suite of products. Defenders can further reduce and mitigate the effectiveness of ARTEX and similar AI agentic attacks by following Microsoft’s recommendations outlined in this report to reduce internet-facing exposure, secure credentials and secrets, and limit lateral movement paths in their environment. Additionally, Microsoft recommends customers to enable automatic attack disruption in Microsoft Defender XDR to contain and isolate affected devices during an attack.</p><p>To help defenders keep pace with machine-speed attacks, <a href=\"https://www.microsoft.com/security/business/microsoft-perception-agentic-system\">Microsoft Perception</a> coordinates red, blue, and green team agents that find exploitable weaknesses, investigate threats, and remediate risks, with security teams approving critical actions. As threat actors increasingly adopt AI, we’re publishing this information to equip defenders with insights that can help protect systems, secrets, identities, and networks from AI-assisted attacks.</p><h2 id=\"sec-1\">ARTEX: Publicly available AI-powered offensive security framework</h2><p>ARTEX (“AI 自主渗透测试系统,” or AI autonomous penetration testing system) is an AI-driven penetration testing platform. A Go-based backend coordinates multiple large language model (LLM) agents that can take an attack from reconnaissance and attack surface discovery through exploitation, verification, and reporting, with little or no human involvement. ARTEX includes an embedded Next.js web interface and uses PostgreSQL for storage.</p><p>ARTEX is primarily a web application penetration testing tool. Its built-in guidance, skills, and findings categories center on vulnerabilities in HTTP applications and APIs, including SQL injection, server-side template injection, XML external entity (XXE) injection, file upload flaws, authentication bypass, and insecure direct object references (IDOR).</p><p>ARTEX agents also perform general network reconnaissance and credential attacks. After agents gain initial access to a system or network, they can pivot through interactive shells. By default, ARTEX does not take any measures to obfuscate its malicious activity.</p><p>In July 2026, GitHub user Autumn-27 published ARTEX as open-source code with a Chinese-language interface. While the original developer removed the source code in October 2026, other developers who had forked the project continue to publish their own versions of ARTEX in many other languages. In November 2026, the China-based cybersecurity company ThreatBook (微步在线) claimed ownership of ARTEX and began offering commercial access to “ARTEX Pro”, in addition to CyberStrikeAI Enterprise Edition and other AI-powered penetration testing frameworks.</p><h2 id=\"sec-2\">AI agent architecture</h2><p>ARTEX uses multiple AI agents for different functions. The threat actor defines the target scope, and a goals model breaks the engagement into objectives that can be verified. A planner agent continuously reviews a knowledge graph containing discovered assets and findings, then issues short attack directions called “intents.” Worker agents claim those intents and carry them out with a real shell and offensive tools. They write new assets, facts, and confirmed vulnerabilities back to the graph. Each update wakes the planner agent, which decides what to do next. The cycle continues until the goals are met or the task reaches its time or step limit. A reporter agent then documents each confirmed finding with reproduction steps and a proof of concept.</p><figure><img src=\"/dailyinfo/media/1a4f618f00b534a3.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Diagram of ARTEX agent architecture, including goals agent, planner agent, worker agents, and reporter agent. \"><figcaption><em>ARTEX AI agent architecture</em></figcaption></figure><p>The threat actor can configure ARTEX to power its agents with virtually any large language model, including frontier models, open-weight models, or models that the threat actor has abliterated (modified to remove built-in guardrails) or otherwise manually tuned. For that reason, ARTEX activity is not necessarily constrained by any single provider’s safety controls or visible in any single provider’s telemetry.</p><p>An optional pool function allows ARTEX to switch to different models when one fails for any reason (for example, quota exhausted, invalid key, rate-limited, or erroring). The function includes a configurable priority order and cooldown, so a long campaign can continue across multiple providers or keys.</p><h2 id=\"sec-3\">Capabilities</h2><p>ARTEX agents call tools to act on intents. While threat actors and agents can add arbitrary tools, ARTEX includes a set of pre-configured tools that define its core capabilities: network reconnaissance, web application mapping, web shell upload, and web browser-based attacks.</p><ul>\n<li>nmap — A network discovery and port-scanning tool that identifies systems, exposed services, and often their versions, rather than simply testing one connection</li>\n\n\n\n<li>nc (netcat) — A general-purpose network utility for opening TCP or UDP connections, listening on ports, and moving raw data between systems</li>\n\n\n\n<li>telnet — A basic interactive TCP client useful for manually probing text-based services</li>\n\n\n\n<li>whois — A registration-data lookup tool that retrieves information about domain names or IP address allocations</li>\n\n\n\n<li>dig — A DNS diagnostic tool</li>\n\n\n\n<li>curl — A command-line HTTP and protocol client suited to crafting requests and inspecting responses, including headers, authentication, and APIs</li>\n\n\n\n<li>wget — A web download utility</li>\n\n\n\n<li>Playwright + Chromium — A browser-automation stack that drives a real Chromium browser, with all elements of the HTTP exchange exposed for manipulation</li>\n\n\n\n<li>node — A JavaScript runtime</li>\n\n\n\n<li>python3 — A general-purpose scripting runtime</li>\n\n\n\n<li>git — A tool for retrieving and inspecting code repositories and their history</li>\n\n\n\n<li>ripgrep — A fast recursive text-search tool for finding strings or patterns</li>\n\n\n\n<li>jq — A command-line JSON processor that filters and transforms structured output from APIs and other tools</li>\n</ul><p>Threat actors also commonly add exploitation frameworks and credential attack tools to extend the capabilities of ARTEX agents:</p><ul>\n<li>sqlmap — A specialized web-application testing tool that detects and assesses SQL injection in application inputs</li>\n\n\n\n<li>hydra — A parallelized credential-testing tool supporting many network login protocols and configurable username/password combinations</li>\n\n\n\n<li>medusa — A modular, parallel network-login tester distinguished by its service-specific authentication modules</li>\n\n\n\n<li>ncrack — A network authentication testing tool from the Nmap ecosystem, focused on high-speed testing of supported remote services</li>\n\n\n\n<li>nuclei — A template-driven vulnerability scanner that checks targets for defined exposures, misconfigurations, and known issues across multiple protocols</li>\n\n\n\n<li>nikto — A web-server scanner focused on potentially dangerous files, outdated components, and common server misconfigurations</li>\n\n\n\n<li>gobuster — A wordlist-based discovery tool that enumerates web paths, DNS subdomains, or virtual hosts with a relatively focused command-line workflow</li>\n\n\n\n<li>ffuf — A flexible web fuzzer that substitutes candidate values into chosen parts of a request, such as paths, parameters, headers, or hostnames</li>\n\n\n\n<li>Msfconsole (Metasploit) — An exploitation framework and its interactive console, combining exploit modules, payloads, and post-exploitation workflows in one environment.</li>\n\n\n\n<li>john (John the Ripper) — An offline password-auditing tool notable for broad hash-format support and adaptable cracking modes</li>\n\n\n\n<li>hashcat — An offline password-recovery tool distinguished by GPU-accelerated candidate generation and hash testing</li>\n</ul><p>ARTEX agents can perform a wide range of actions, depending on the available tools and goals that the threat actor sets. Microsoft Threat Intelligence has observed ARTEX agents exhibiting the following capabilities as of November 2026:</p><ul>\n<li>Network reconnaissance<ul><li>Port and service scanning</li></ul><ul><li>DNS enumeration</li></ul><ul><li>HTTP probing and content scraping</li></ul>\n<ul>\n<li>Importing assets from separate asset-scanning platforms</li>\n</ul>\n</li>\n\n\n\n<li>Web application reconnaissance<ul><li>Retrieval of JavaScript bundles, source maps, runtime configuration files, and API documentation to extract routes</li></ul><ul><li>Headless-browser crawling, including with a simulated signed-in state</li></ul>\n<ul>\n<li>Enumeration of REST, WebSocket, and server-sent events (SSE) endpoints</li>\n</ul>\n</li>\n\n\n\n<li>Web application exploitation<ul><li>Exploitation of known vulnerabilities in exposed software</li></ul><ul><li>Authentication bypass (for example, unsigned tokens and manipulated OAuth callbacks)</li></ul><ul><li>SQL injection</li></ul><ul><li>Server-side template injection</li></ul><ul><li>XML external entity (XXE) injection</li></ul><ul><li>File upload flaws</li></ul>\n<ul>\n<li>Insecure direct object references (IDOR)</li>\n</ul>\n</li>\n\n\n\n<li>Credential attacks<ul><li>Weak-password testing</li></ul><ul><li>Password spraying</li></ul><ul><li>Brute force guessing</li></ul>\n<ul>\n<li>Abuse of account-recovery flows</li>\n</ul>\n</li>\n\n\n\n<li>Persistence\n<ul>\n<li>Web shell upload</li>\n</ul>\n</li>\n\n\n\n<li>Credential access<ul><li>Reading secrets from configuration files, <em>.env</em> files, private keys, and <em>/etc/shadow</em></li></ul><ul><li>Dumping databases</li></ul>\n<ul>\n<li>Kerberoasting</li>\n</ul>\n</li>\n\n\n\n<li>Lateral movement\n<ul>\n<li>Credential reuse</li>\n</ul>\n</li>\n\n\n\n<li>Cloud identity abuse<ul><li>Authentication with stolen or captured credentials</li></ul><ul><li>Cloud permission mapping</li></ul><ul><li>Microsoft Graph reconnaissance</li></ul><ul><li>Adding application credentials for persistence</li></ul><ul><li>Assigning privileged roles for privilege escalation</li></ul>\n<ul>\n<li>Reading cloud keys and tokens, including from cloud secret management stores</li>\n</ul>\n</li>\n</ul><h2 id=\"sec-4\">Identifying ARTEX network activity</h2><p>While ARTEX does not invent new attack techniques, it can combine the adaptable attack chain of a human threat actor with the speed and precision of malicious software. Therefore, the challenge of identifying network activity from AI-driven tools like ARTEX is differentiating it from both human- and software-driven activity.</p><p>Defenders can detect three types of evidence that may suggest AI-driven activity:</p><ul>\n<li>The most durable signal of AI-driven activity is the pattern formed by the bursts of machine speed activity. ARTEX agents, sometimes working in parallel, continually adapt and retry a given tactic until they succeed or run out of time. ARTEX agents quickly and exhaustively iterate through different methods of access, exploitation, or abuse. A human threat actor takes time to move from one stage of the attack chain to the next. In contrast, after successfully compromising a system or credentials, the framework then dispatches additional agents to move on to the next stage of the activity at machine speed. While ARTEX is a popular tool, other AI-driven offensive security frameworks also generate similar patterns of behavior.</li>\n\n\n\n<li>Automated penetration testing tools, including the ones that ARTEX agents call, can produce a characteristically large volume of anomalous traffic from a single source in a short time. ARTEX does not obfuscate its malicious activity; a large number of these traffic bursts occurring at intervals is consistent with automated targeting.</li>\n\n\n\n<li>A small amount of traffic might have user agent strings, network protocol options, or other default values strongly associated with ARTEX or the tools it calls. However, threat actors and ARTEX agents frequently change these values, particularly when evading static rules that block such values. The following table shows two such user agent strings specific to ARTEX:</li>\n</ul><figure><table><thead><tr><td><strong>Type</strong></td><td><strong>Value</strong></td><td><strong>Notes</strong></td></tr></thead><tbody><tr><td>User agent string</td><td><em>artex-enrich/*</em></td><td>Included with a short GET request to each newly discovered web asset that does not follow redirects, closes the connection, and reads only enough of the response to extract the page title.</td></tr><tr><td>User agent string</td><td><em>norma/*</em></td><td>Included with requests made directly by agents through their built-in web-fetch tool rather than through shell tools.</td></tr></tbody></table></figure><p><a href=\"https://learn.microsoft.com/security/zero-trust/adopt/prevent-reduce-business-damage-breach-infrastructure#create-honeypot-resources\">Defensive honeypots</a>, decoys, tarpits, and fake wins can pull autonomous AI attacks away from legitimate targets. Honeypots and decoy surfaces such as <a href=\"https://github.com/Azure/Azure-Sentinel/tree/master/Solutions/HoneyTokens\">Microsoft Sentinel Deception</a> give the agent attractive but worthless targets to pursue. Tarpits consume the agent’s time and budget. Fake wins present convincing evidence that the agent’s objective is complete, which can cause it to stop on a false success. Honeytokens can provide early warnings of AI compute hijacking. In Microsoft’s testing, these controls helped reduce the attack traffic reaching real assets and produced high-confidence, attribution-quality signal.</p><h2 id=\"sec-5\">Identifying ARTEX system activity</h2><p>After gaining initial access to a system, ARTEX agents often use well-known risky utilities (for example, certutil, curl, wget, netcat) on the system to launch web shells, install remote access trojans (RATs), or take other action to achieve persistence. Because ARTEX does not take any measures to obfuscate its malicious activity, existing methods for detecting compromise will likely capture ARTEX activity:</p><ul>\n<li>Web server processes (such as <em>w3wp.exe</em>, <em>php-fpm</em>, <em>httpd</em> or <em>apache2</em>, or Java application servers) starting <em>sh</em>, <em>bash</em>, <em>cmd.exe</em>, or PowerShell</li>\n\n\n\n<li>New or modified script files (<em>.php</em>, <em>.jsp</em>, <em>.jspx</em>, <em>.asp</em>, <em>.aspx</em>, or <em>.ashx</em>) in web-accessible or upload directories; this includes files written by a database server process after its logging settings were changed to point a log file at a web directory</li>\n\n\n\n<li>Several short-lived web shells with incrementing names, each running a different command, as ARTEX agents correct errors until a web shell runs cleanly</li>\n\n\n\n<li>Rapid reads of <em>/etc/shadow</em>, <em>.env</em> and configuration files, private keys, and cloud credential files, and bursts of database extraction</li>\n\n\n\n<li>Reverse shells and outbound requests from the server to webhook or file-sharing services used to deliver scripts and return command output</li>\n\n\n\n<li>Two or three attack chains active at once, and renewed attempts through new paths after containment</li>\n</ul><h2 id=\"sec-6\">Mitigation and protection guidance</h2><p>Microsoft recommends the following mitigations to reduce the impact of this threat. Check the recommendations card for the deployment status of monitored mitigations.</p><p>ARTEX doesn’t introduce new attack techniques. It runs common penetration testing tools and tries one approach after another at machine speed. The mitigations that matter most close exposure before scanning finds it, slow down bursts of requests, protect credentials and application secrets, and contain a compromise automatically.</p><h3 id=\"sec-7\">Reduce internet-facing exposure</h3><ul>\n<li>Find and fix exposed assets first by using <a href=\"https://learn.microsoft.com/azure/external-attack-surface-management/what-is-discovery\">Microsoft Defender External Attack Surface Management discovery</a> to inventory the internet-facing hosts, websites, and services you own, including ones you didn’t know about. Then prioritize fixes with <a href=\"https://learn.microsoft.com/defender-vulnerability-management/defender-vulnerability-management\">Microsoft Defender Vulnerability Management</a>, which shows internet-exposed resources that lead to sensitive data or privileged identities. ARTEX agents start with port scans and web path enumeration and act on whatever they find.</li>\n\n\n\n<li>Block and slow down attacks on web applications and APIs. After tuning in detection mode, switch <a href=\"https://learn.microsoft.com/azure/web-application-firewall/ag/ag-overview\">Web Application Firewall on Application Gateway</a> to prevention mode so that SQL injection and other common web attacks are blocked, not only logged. Add <a href=\"https://learn.microsoft.com/azure/web-application-firewall/ag/rate-limiting-overview\">rate limiting on Application Gateway</a> or <a href=\"https://learn.microsoft.com/azure/web-application-firewall/afds/waf-front-door-rate-limit\">rate limiting on Azure Front Door</a> to cap how many requests one client can send in a short time, and turn on <a href=\"https://learn.microsoft.com/azure/web-application-firewall/ag/bot-protection-overview\">bot protection</a> to block or log requests from known malicious IP addresses. For APIs in Azure API Management, follow <a href=\"https://learn.microsoft.com/azure/api-management/mitigate-owasp-api-threats\">Mitigate OWASP API security top 10 threats</a> to enforce authentication, object-level authorization, and rate limits. ARTEX agents send hundreds of requests to learn which paths a server allows and harvest API documentation to find internal routes, then test them for injection, authentication bypass, and access-control flaws.</li>\n</ul><h3 id=\"sec-8\">Map and test attack paths</h3><ul>\n<li>Map what an exposed asset or stolen credential could reach before an agent does. Use <a href=\"https://learn.microsoft.com/security-exposure-management/work-attack-paths-overview\">attack paths in Microsoft Security Exposure Management</a> and <a href=\"https://learn.microsoft.com/azure/defender-for-cloud/concept-attack-path\">attack path analysis in Defender for Cloud</a> to find defensive choke points, where paths to critical assets converge, and explore the blast radius of each one. <a href=\"https://learn.microsoft.com/security-exposure-management/critical-asset-management\">Classify your critical assets</a> so the paths are complete, and <a href=\"https://learn.microsoft.com/security-exposure-management/query-enterprise-exposure-graph\">query the enterprise exposure graph</a> in advanced hunting to explore the same connections. During an incident, <a href=\"https://learn.microsoft.com/azure/sentinel/datalake/sentinel-graph-overview\">blast radius analysis in the incident graph</a> shows the paths an attacker could take from a compromised entity to a critical asset. ARTEX agents <a href=\"https://www.microsoft.com/en-us/security/blog/2026/10/21/storm-0940-uses-artex-agentic-ai-connectwise-supply-chain-compromise/\">record the assets and vulnerabilities they discover in a graph</a>, so mapping your own graph first shows where they would go next.</li>\n\n\n\n<li>Test the paths that matter most, within Microsoft’s rules. Microsoft recommends <a href=\"https://learn.microsoft.com/security/benchmark/azure/mcsb-posture-vulnerability-management\">regular red team operations</a> to complement vulnerability scanning. Agree on the scope and constraints with resource owners and fix all critical findings. Testing of Azure resources must follow the <a href=\"https://learn.microsoft.com/azure/security/fundamentals/pen-testing\">penetration testing rules of engagement,</a> which encourage testing your security monitoring and detection, prohibit automated testing that generates excessive traffic, and prohibit using secrets that aren’t your own, <a href=\"https://www.microsoft.com/en-us/msrc/pentest-rules-of-engagement\">including publicly leaked ones</a>. Agentic tools like ARTEX <a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/05/threat-actors-use-agentic-ai-tooling-to-find-and-abuse-exposed-secrets/\">scan public code repositories for secrets</a>, so decide before testing how testers will handle credentials that belong to someone else.</li>\n\n\n\n<li>Organizations can incorporate <a href=\"https://learn.microsoft.com/en-us/security/agentic-security/agentic-security-overview\">Microsoft Perception’s</a> <a href=\"https://learn.microsoft.com/en-us/security/agentic-security/recon-agent\">Recon Agent</a> to map relationships between Azure resources, Microsoft Entra ID identities, and permissions to identify potential lateral movement paths, privilege escalation opportunities, and high-value assets accessible following an initial compromise. Recon Agent’s <a href=\"https://learn.microsoft.com/en-us/security/agentic-security/recon-agent#investigate-attack-paths-in-a-subscription\">Identify attack paths</a> playbook searches for potential attack paths within an Azure subscription, while the <a href=\"https://learn.microsoft.com/en-us/security/agentic-security/recon-agent#investigate-managed-identity-access-to-critical-assets\">Assess identity risks</a> playbook investigates whether a managed identity could provide a path to critical assets. The <a href=\"https://learn.microsoft.com/en-us/security/agentic-security/recon-agent#respond-to-a-new-cve-or-threat\">Protect against a threat</a> playbook correlates identified exposures with relevant threat intelligence. Because Perception’s Recon Agent performs read-only analysis rather than active exploitation, organizations should complement its findings with authorized penetration testing to validate viable attack paths.</li>\n</ul><h3 id=\"sec-9\">Protect web servers</h3><ul>\n<li>Run endpoint protection on every internet-facing server and keep it blocking. Use <a href=\"https://learn.microsoft.com/defender-endpoint/microsoft-defender-endpoint-linux\">Defender for Endpoint on Linux</a> and the <a href=\"https://learn.microsoft.com/azure/defender-for-cloud/defender-for-servers-overview\">Defender for Servers plan</a> so that the endpoint detections and hunting queries in this report cover the servers that ARTEX agents exploit, including Linux servers. Turn on <a href=\"https://learn.microsoft.com/defender-endpoint/tamper-protection-overview\">tamper protection</a>, use <a href=\"https://learn.microsoft.com/defender-endpoint/edr-in-block-mode\">EDR in block mode</a> on Windows devices that run a non-Microsoft antivirus product, and turn on the <a href=\"https://learn.microsoft.com/defender-endpoint/attack-surface-reduction-rules-reference\">Block Webshell creation for Servers</a> attack surface reduction rule on Exchange servers.</li>\n\n\n\n<li>Restrict outbound connections from web servers. Allow only the destinations each server needs, for example with <a href=\"https://learn.microsoft.com/azure/firewall/threat-intel\">Azure Firewall threat intelligence-based filtering</a>, and create <a href=\"https://learn.microsoft.com/defender-endpoint/indicator-ip-domain\">indicators for IPs, URLs, and domains</a> in Defender for Endpoint to block known-bad destinations. ARTEX agents have used curl and netcat to download remote access trojans, and curl with rotating webhook.site URLs to deliver scripts and return command output.</li>\n</ul><h3 id=\"sec-10\">Secure accounts and sign-ins</h3><ul>\n<li>Apply Conditional Access to every user and workload identity. Create policies that require <a href=\"https://learn.microsoft.com/entra/identity/conditional-access/policy-all-users-mfa-strength\">multifactor authentication (MFA) for all users</a>, enforce <a href=\"https://learn.microsoft.com/entra/identity/conditional-access/policy-admin-phish-resistant-mfa\">phishing-resistant MFA for administrators</a>, and <a href=\"https://learn.microsoft.com/entra/identity/conditional-access/policy-block-legacy-authentication\">block legacy authentication</a>. Consider wider adoption of <a href=\"https://learn.microsoft.com/entra/identity/authentication/how-to-plan-prerequisites-phishing-resistant-passwordless-authentication\">phishing-resistant passwordless authentication deployment</a> to all users. Configure <a href=\"https://learn.microsoft.com/entra/id-protection/howto-identity-protection-configure-risk-policies\">risk policies in Microsoft Entra ID Protection</a> to require MFA or block access for medium-risk and high-risk sign-ins; sign-ins from known threat actor infrastructure, including infrastructure behind ARTEX activity, raise <em>Verified threat actor IP</em> detections at high risk.</li>\n\n\n\n<li>For service principals, use <a href=\"https://learn.microsoft.com/entra/identity/conditional-access/workload-identity\">Conditional Access for workload identities</a> to block sign-ins from unexpected locations or with elevated risk; <a href=\"https://learn.microsoft.com/entra/id-protection/concept-workload-identity-risk\">workload identity risk detections</a> flag leaked credentials and suspicious sign-ins, including credentials found in public code on GitHub.</li>\n\n\n\n<li>Ban weak passwords and slow down guessing. Turn on <a href=\"https://learn.microsoft.com/entra/identity/authentication/concept-password-ban-bad\">Microsoft Entra Password Protection</a> with a custom banned password list, extend it to <a href=\"https://learn.microsoft.com/entra/identity/authentication/concept-password-ban-bad-on-premises\">on-premises Active Directory</a>, and review <a href=\"https://learn.microsoft.com/entra/identity/authentication/howto-password-smart-lockout\">smart lockout</a> settings. In one Storm-0940 campaign that used ARTEX, Microsoft recorded more than 151,000 failed sign-ins, peaking at 2,900 failures per minute.</li>\n</ul><h3 id=\"sec-11\">Protect application secrets and privileges</h3><ul>\n<li>Keep application secrets out of code and replace any that leak. Use <a href=\"https://learn.microsoft.com/entra/identity/enterprise-apps/tutorial-enforce-secret-standards\">application management policies</a> to limit which kinds of secrets and certificates apps can use and to enforce rotation, and move workloads to <a href=\"https://learn.microsoft.com/entra/identity/managed-identities-azure-resources/overview\">managed identities</a> where possible. Turn on <a href=\"https://learn.microsoft.com/azure/devops/repos/security/github-advanced-security-secret-scanning?view=azure-devops\">secret scanning and push protection</a> for Azure DevOps repositories and <a href=\"https://learn.microsoft.com/azure/defender-for-cloud/secrets-scanning\">secrets scanning in Defender for Cloud</a> for virtual machines and cloud deployments and invalidate and replace any secret found in code or configuration files, including .env files. <a href=\"https://www.microsoft.com/security/blog/2026/11/05/threat-actors-use-agentic-ai-tooling-to-find-and-abuse-exposed-secrets/\">In one case</a> that Microsoft observed, an AI agent went from searching GitHub for client secrets to taking data from Azure Key Vault in five minutes.</li>\n\n\n\n<li>Govern app registration, consent, and privileged roles by<a href=\"https://learn.microsoft.com/entra/identity/role-based-access-control/delegate-app-roles\"> restricting app registration</a> to the users who need it, <a href=\"https://learn.microsoft.com/entra/identity/enterprise-apps/configure-user-consent\">configuring user consent</a> so that users can’t grant broad permissions to unverified apps, and using <a href=\"https://learn.microsoft.com/defender-cloud-apps/app-governance-manage-app-governance\">app governance in Microsoft Defender for Cloud Apps</a> to see which apps can reach your data. Use <a href=\"https://learn.microsoft.com/entra/id-governance/privileged-identity-management/pim-configure\">Privileged Identity Management</a> for time-bound role activation, and monitor application credential changes and role assignments as described in the <a href=\"https://learn.microsoft.com/entra/architecture/security-operations-applications\">Microsoft Entra security operations guide for applications</a>. During Storm-0940 activity, ARTEX agents added credentials to applications, and an application assigned itself the Global Administrator role.</li>\n</ul><h3 id=\"sec-12\">Protect cloud resources and data</h3><ul>\n<li>Limit what a stolen credential or token can reach. Follow <a href=\"https://learn.microsoft.com/azure/role-based-access-control/best-practices\">best practices for Azure RBAC</a> to limit each service principal to the resources and operations its application needs, and grant <a href=\"https://learn.microsoft.com/entra/identity/managed-identities-azure-resources/managed-identity-best-practice-recommendations\">managed identities only the access they need</a> so that a token taken from the <a href=\"https://learn.microsoft.com/azure/virtual-machines/instance-metadata-service\">Azure Instance Metadata Service</a> through an XXE or SSRF flaw can’t reach other resources. ARTEX agents map the permissions of the credentials they capture and have used an XXE flaw to query a cloud metadata service for role credentials, and in one investigation AI agents used a compromised OAuth application to run scripts on Azure virtual machines.</li>\n\n\n\n<li>Harden and monitor the services that hold secrets and data. Follow <a href=\"https://learn.microsoft.com/azure/key-vault/general/secure-key-vault\">Secure your Azure Key Vault</a>; for storage accounts, <a href=\"https://learn.microsoft.com/azure/storage/common/shared-key-authorization-prevent\">prevent Shared Key authorization</a> and <a href=\"https://learn.microsoft.com/azure/storage/blobs/anonymous-read-access-prevent\">remediate anonymous read access to blob data</a>; <a href=\"https://learn.microsoft.com/azure/app-service/configure-basic-auth-disable\">disable basic authentication</a> for App Service publishing; and <a href=\"https://learn.microsoft.com/azure/ai-services/disable-local-auth\">disable local authentication</a> so that Foundry Tools accept only Microsoft Entra ID authentication. Then turn on <a href=\"https://learn.microsoft.com/azure/defender-for-cloud/defender-for-key-vault-introduction\">Defender for Key Vault</a>, <a href=\"https://learn.microsoft.com/azure/defender-for-cloud/defender-for-storage-introduction\">Defender for Storage</a>, <a href=\"https://learn.microsoft.com/azure/defender-for-cloud/defender-for-resource-manager-introduction\">Defender for Resource Manager</a>, <a href=\"https://learn.microsoft.com/azure/defender-for-cloud/defender-for-app-service-introduction\">Defender for App Service</a>, <a href=\"https://learn.microsoft.com/azure/defender-for-cloud/defender-for-databases-introduction\">Defender for open-source relational databases</a>, and <a href=\"https://learn.microsoft.com/azure/defender-for-cloud/ai-threat-protection\">AI threat protection</a> for the workloads you run. ARTEX agents have run commands through cloud administration interfaces such as Kudu when they had credentials for them, and AI agents have focused on credentials for AI services.</li>\n</ul><h3 id=\"sec-13\">Limit lateral movement and contain attacks automatically</h3><ul>\n<li>Detect credential theft on domain controllers. <a href=\"https://learn.microsoft.com/defender-for-identity/deploy/deploy-defender-identity\">Install Microsoft Defender for Identity sensors</a> on all domain controllers. Its alerts, listed in the Detections section, cover the Active Directory credential theft and reconnaissance that ARTEX agents run in compromised domains.</li>\n\n\n\n<li>Remove reusable passwords and standing access. Use <a href=\"https://learn.microsoft.com/windows-server/identity/ad-ds/manage/group-managed-service-accounts/group-managed-service-accounts/group-managed-service-accounts-overview\">group managed service accounts</a>, whose passwords Windows manages automatically, so that service accounts don’t rely on passwords that people choose and rarely change. Use <a href=\"https://learn.microsoft.com/windows-server/identity/laps/laps-overview\">Windows LAPS</a> to rotate each device’s local administrator password so that one captured password doesn’t work across many devices and use <a href=\"https://learn.microsoft.com/azure/defender-for-cloud/just-in-time-access-overview\">just-in-time machine access</a> in Defender for Cloud to keep management ports such as RDP and SSH closed until they’re needed. ARTEX agents reuse captured credentials to move laterally over SSH and WinRM.</li>\n\n\n\n<li>Enable <a href=\"https://learn.microsoft.com/defender-xdr/automatic-attack-disruption\">automatic attack disruption</a> to contain compromised assets that an attacker is using and limit lateral movement early, as well as <a href=\"https://learn.microsoft.com/defender-xdr/m365d-configure-auto-investigation-response\">automated investigation and response</a>, which investigates and remediates alerts automatically. In multiple ARTEX-driven Storm-0940 intrusions, privileged access came less than three hours after initial targeting.</li>\n</ul><h2 id=\"sec-14\">Microsoft Defender detections</h2><p><a href=\"https://www.microsoft.com/security/business/microsoft-defender\">Microsoft Defender</a> customers can refer to the list of applicable detections below. Microsoft Defender coordinates detection, prevention, investigation, and response across endpoints, identities, email, apps to provide integrated protection against attacks like the threat discussed in this blog.</p><h3 id=\"sec-15\">Microsoft Defender Antivirus</h3><p>Microsoft Defender Antivirus detects threat components as the following:</p><ul>\n<li>Behavior:Win64/ArtexAI</li>\n</ul><h3 id=\"sec-16\">Microsoft Defender for Endpoint</h3><p>The following alerts might indicate threat activity associated with this threat. These alerts, however, can be triggered by unrelated threat activity and are not monitored in the status cards provided with this report:</p><p><strong>Execution</strong></p><ul>\n<li>Process launched in the background</li>\n\n\n\n<li>Suspicious file dropped and launched</li>\n\n\n\n<li>Suspicious file or content ingress</li>\n\n\n\n<li>Hidden file executed</li>\n\n\n\n<li>Suspicious process executed by network service</li>\n\n\n\n<li>Suspicious piped command launched</li>\n\n\n\n<li>Suspicious process launched by service</li>\n\n\n\n<li>Suspicious process launched from a world-writable directory</li>\n\n\n\n<li>Suspicious script launched</li>\n\n\n\n<li>Suspicious shell execution from PHP application</li>\n\n\n\n<li>Suspicious shell command execution</li>\n</ul><p><strong>Persistence</strong></p><ul>\n<li>Possible Web Server compromise activity</li>\n\n\n\n<li>Suspicious cron job creation</li>\n</ul><p><strong>Defense evasion</strong></p><ul>\n<li>Executable permission added to file or directory</li>\n\n\n\n<li>Obfuscation or deobfuscation activity</li>\n\n\n\n<li>Possible time based evasion</li>\n\n\n\n<li>Suspicious decoding of encoded content into script</li>\n\n\n\n<li>Suspicious file and directory permission modification</li>\n\n\n\n<li>Suspicious file or information obfuscation detected</li>\n\n\n\n<li>Suspicious path deletion</li>\n</ul><p><strong>Credential access</strong></p><ul>\n<li>Suspicious access of sensitive files</li>\n</ul><p><strong>Discovery</strong></p><ul>\n<li>Suspicious port scan activity</li>\n</ul><p><strong>Collection</strong></p><ul>\n<li>Enumeration of files with sensitive data</li>\n\n\n\n<li>Suspicious file copy operations</li>\n\n\n\n<li>Suspicious process collected data from local system</li>\n</ul><p><strong>Lateral movement</strong></p><ul>\n<li>Remote Desktop session</li>\n</ul><p><strong>Command and control</strong></p><ul>\n<li>Possible reverse shell</li>\n\n\n\n<li>Suspicious connection to remote service</li>\n\n\n\n<li>Suspicious curl behavior</li>\n</ul><h3 id=\"sec-17\">Microsoft Defender for Identity</h3><p>The following alerts might indicate threat activity associated with this threat. These alerts, however, can be triggered by unrelated threat activity and are not monitored in the status cards provided with this report:</p><ul>\n<li>Possible Kerberoasting attack</li>\n\n\n\n<li>Possible Kerberoasting attack following a suspicious LDAP query</li>\n\n\n\n<li>Possible Kerberoasting attack using a stealthy LDAP search</li>\n\n\n\n<li>Possible Kerberoasting LDAP reconnaissance</li>\n\n\n\n<li>Possible SPN enumeration via LDAP</li>\n\n\n\n<li>DCSync attack (replication of directory services)</li>\n\n\n\n<li>Suspected brute-force attack (Kerberos, NTLM)</li>\n\n\n\n<li>Suspected brute-force attack on Lightweight Directory Access Protocol (LDAP) authentication</li>\n\n\n\n<li>Suspected password spray attack (Kerberos, NTLM)</li>\n\n\n\n<li>Suspected password spray attack on Lightweight Directory Access Protocol (LDAP) authentication</li>\n\n\n\n<li>Suspected account enumeration (Kerberos, NTLM, AD FS)</li>\n\n\n\n<li>Suspicious LDAP query targeting sensitive attributes</li>\n\n\n\n<li>Discovery tool was observed</li>\n\n\n\n<li>Malicious sign in from a randomized user agent</li>\n\n\n\n<li>Possible service principal account secret leak</li>\n\n\n\n<li>Possibly compromised service principal account signed in</li>\n\n\n\n<li>Suspicious service principal sign-in following credential addition</li>\n\n\n\n<li>Suspicious Entra Graph API query observed</li>\n</ul><p>Organizations that use classic Defender for Identity alerts see Suspected Kerberos SPN exposure, Suspected DCSync attack (replication of directory services), Account Enumeration reconnaissance (LDAP), and Security principal reconnaissance (LDAP) instead. See <a href=\"https://learn.microsoft.com/defender-for-identity/alerts-xdr\">Defender for Identity XDR security alerts</a> and <a href=\"https://learn.microsoft.com/defender-for-identity/alerts-mdi-classic\">Defender for Identity classic security alerts</a>.</p><h3 id=\"sec-18\">Microsoft Entra ID Protection</h3><p>The following <a href=\"https://learn.microsoft.com/entra/id-protection/concept-identity-protection-risks\">risk detections</a> might indicate that an account was targeted or compromised by ARTEX-driven activity. These detections, however, can be triggered by unrelated threat activity and are not monitored in the status cards provided with this report:</p><ul>\n<li>Verified threat actor IP</li>\n\n\n\n<li>Password spray</li>\n\n\n\n<li>Microsoft Entra threat intelligence</li>\n\n\n\n<li>Malicious IP address</li>\n\n\n\n<li>Anonymous IP address</li>\n\n\n\n<li>Atypical travel</li>\n\n\n\n<li>Unfamiliar sign-in properties</li>\n\n\n\n<li>Leaked credentials</li>\n</ul><p>The following <a href=\"https://learn.microsoft.com/entra/id-protection/concept-workload-identity-risk\">workload identity risk detections</a> can indicate that an application identity is compromised:</p><ul>\n<li>Leaked Credentials</li>\n\n\n\n<li>Suspicious Sign-ins</li>\n\n\n\n<li>Anomalous service principal activity</li>\n\n\n\n<li>Microsoft Entra threat intelligence</li>\n\n\n\n<li>Suspicious application</li>\n\n\n\n<li>Malicious application</li>\n</ul><h3 id=\"sec-19\">Microsoft Defender XDR</h3><p>The following alerts might indicate threat activity associated with this threat. These alerts, however, can be triggered by unrelated threat activity and are not monitored in the status cards provided with this report:</p><ul>\n<li>Multiple Service Principal Sign-ins from Single IP</li>\n\n\n\n<li>Potentially compromised OAuth application identified through attack activity analysis</li>\n\n\n\n<li>Graph API activity from a Microsoft threat intelligence IP address</li>\n\n\n\n<li>Application self-assigned Global Administrator role</li>\n\n\n\n<li>Account compromised following a password-spray attack</li>\n\n\n\n<li>Anomalous OAuth device code authentication activity</li>\n\n\n\n<li>Suspicious sign-in from verified nation-state threat actor infrastructure</li>\n\n\n\n<li>Malicious sign-in from known threat actor IP address</li>\n</ul><h3 id=\"sec-20\">Microsoft Defender for Cloud Apps</h3><p>The following alerts might indicate threat activity associated with this threat. These alerts, however, can be triggered by unrelated threat activity and are not monitored in the status cards provided with this report:</p><ul>\n<li>Suspicious addition of app role assignments to service principal</li>\n\n\n\n<li>Suspicious addition of application role assignments by service principal to itself</li>\n\n\n\n<li>High-privilege application roles assigned to a service principal</li>\n\n\n\n<li>Suspicious OAuth app registration</li>\n\n\n\n<li>Suspicious mail access activity by OAuth application following role assignment</li>\n\n\n\n<li>Suspicious OAuth application created from a risky user context performing graph SharePoint enumeration</li>\n\n\n\n<li>OAuth application activity from an uncommonly visited ISP</li>\n\n\n\n<li>Activities from suspicious user agents</li>\n\n\n\n<li>Activity from a password-spray associated IP address</li>\n\n\n\n<li>Successful logon from a suspicious IP address</li>\n\n\n\n<li>Multiple failed user log on attempts to an app</li>\n</ul><p>The following <a href=\"https://learn.microsoft.com/defender-cloud-apps/app-governance-anomaly-detection-alerts\">app governance threat detection alerts</a> might also indicate that an application’s credentials are being abused:</p><ul>\n<li>Application initiating multiple failed KeyVault read activity with no success</li>\n\n\n\n<li>OAuth App using unusual user agent</li>\n\n\n\n<li>Suspicious enumeration activities performed using Microsoft Graph PowerShell</li>\n\n\n\n<li>Dormant OAuth App predominantly using MS Graph or Exchange Web Services recently seen to be accessing ARM workloads</li>\n\n\n\n<li>App accessed from unusual location made anomalous Graph calls post certificate update</li>\n\n\n\n<li>Anomalous SharePoint activity by app that just updated or added new credentials</li>\n\n\n\n<li>Anomalous OneDrive activity by app that just updated or added new credentials</li>\n\n\n\n<li>Unused app newly accessing APIs</li>\n</ul><p><strong>Microsoft Defender for Cloud Apps behaviors</strong></p><p>Note that some <a href=\"https://learn.microsoft.com/defender-cloud-apps/behaviors\">Microsoft Defender for Cloud Apps alerts are transitioning to behaviors</a>, and policies that generate behaviors are now disabled by default, and don’t send alerts.</p><p><a href=\"https://learn.microsoft.com/defender-xdr/advanced-hunting-overview\">Access behaviors in the Defender portal Advanced hunting page</a> and use behaviors by querying behavior tables and creating custom detection rules that include behavior data.</p><p>The following behavior might also indicate threat activity associated with this threat. This behavior, however, can be triggered by unrelated threat activity and is not monitored in the status cards provided with this report:</p><ul>\n<li>Multiple failed login attempts</li>\n</ul><p>In advanced hunting, this behavior has the ActionType <em>MultipleFailedLoginAttempts</em> in the <em>BehaviorInfo</em> and <em>BehaviorEntities</em> tables.</p><h3 id=\"sec-21\">Microsoft Defender for Cloud</h3><p>Microsoft Defender for Key Vault alerts with the following titles might indicate that stolen credentials are being used to read secrets. These alerts, however, can be triggered by unrelated threat activity and are not monitored in the status cards provided with this report:</p><ul>\n<li>Suspicious secret listing and query in a key vault</li>\n\n\n\n<li>High volume of operations in a key vault</li>\n\n\n\n<li>Unusual operation pattern in a key vault</li>\n\n\n\n<li>Unusual application accessed a key vault</li>\n\n\n\n<li>Unusual user-application pair accessed a key vault</li>\n\n\n\n<li>User accessed high volume of key vaults</li>\n\n\n\n<li>Unusual access denied – User accessing high volume of key vaults denied</li>\n\n\n\n<li>Access from a suspicious IP address to a key vault</li>\n\n\n\n<li>Access from a TOR exit node to a key vault</li>\n\n\n\n<li>Unusual access to the key vault from a suspicious IP (Non-Microsoft or external)</li>\n</ul><p>Microsoft Defender for Storage alerts with the following titles might indicate discovery of, or data taken from, Azure Storage. These alerts, however, can be triggered by unrelated threat activity and are not monitored in the status cards provided with this report:</p><ul>\n<li>Publicly accessible storage containers successfully discovered</li>\n\n\n\n<li>Access from an unusual location to a sensitive blob container</li>\n\n\n\n<li>Unusual amount of data extracted from a storage account</li>\n\n\n\n<li>Access from a suspicious application</li>\n</ul><p>Microsoft Defender for Resource Manager alerts with the following titles might indicate Azure management operations from threat actor infrastructure. These alerts, however, can be triggered by unrelated threat activity and are not monitored in the status cards provided with this report:</p><ul>\n<li>Azure Resource Manager operation from suspicious IP address</li>\n\n\n\n<li>Azure Resource Manager operation from suspicious proxy IP address</li>\n\n\n\n<li>Suspicious Azure role assignment detected (Preview)</li>\n</ul><p>Microsoft Defender for Databases alerts with the following titles might indicate SQL injection or brute force attempts against databases. These alerts, however, can be triggered by unrelated threat activity and are not monitored in the status cards provided with this report:</p><ul>\n<li>Potential SQL injection</li>\n\n\n\n<li>A possible vulnerability to SQL Injection</li>\n\n\n\n<li>Suspected brute force attack</li>\n\n\n\n<li>Suspected successful brute force attack</li>\n\n\n\n<li>Login from a suspicious IP</li>\n</ul><p>AI threat protection alerts with the following titles might indicate that stolen keys or credentials are being used against AI services. These alerts, however, can be triggered by unrelated threat activity and are not monitored in the status cards provided with this report:</p><ul>\n<li>Suspicious user agent detected</li>\n\n\n\n<li>Access from suspicious IP</li>\n\n\n\n<li>Access from a Tor IP</li>\n\n\n\n<li>Access anomaly in AI resource</li>\n\n\n\n<li>Suspicious invocation of a high-risk ‘Initial Access’ operation by a service principal detected (AI resources)</li>\n\n\n\n<li>Suspected wallet attack – volume anomaly</li>\n</ul><h3 id=\"sec-22\">Microsoft Sentinel</h3><p>The following analytics rules from Microsoft Sentinel solutions might also indicate ARTEX-driven activity. These rules, however, can be triggered by unrelated threat activity:</p><ul>\n<li>Password spray attack against Microsoft Entra ID application (Microsoft Entra ID solution)</li>\n\n\n\n<li>Malformed user agent</li>\n\n\n\n<li>Abnormal Deny Rate for Source IP (Azure Firewall solution)</li>\n\n\n\n<li>Abnormal Port to Protocol (Azure Firewall solution)</li>\n</ul><h3 id=\"sec-23\">Microsoft Security Copilot</h3><p><a href=\"https://www.microsoft.com/en-us/security/business/ai-machine-learning/microsoft-security-copilot\">Microsoft Security Copilot</a> is <a href=\"https://learn.microsoft.com/defender-xdr/security-copilot-in-microsoft-365-defender\">embedded in Microsoft Defender</a> and provides security teams with AI-powered capabilities to summarize incidents, analyze files and scripts, summarize identities, use guided responses, and generate device summaries, hunting queries, and incident reports.</p><p>Security Copilot is also available as a <a href=\"https://learn.microsoft.com/en-us/copilot/security/experiences-security-copilot\">standalone experience</a> where customers can perform specific security-related tasks, such as incident investigation, user analysis, and vulnerability impact assessment. In addition, Security Copilot offers <a href=\"https://learn.microsoft.com/copilot/security/developer/custom-agent-overview\">developer scenarios</a> that allow customers to build, test, publish, and integrate AI agents and plugins to meet unique security needs.</p><h3 id=\"sec-24\">Threat intelligence reports</h3><p>Microsoft Defender XDR customers can use the following <a href=\"https://learn.microsoft.com/defender-xdr/threat-analytics\">threat analytics</a> reports in the Defender portal (requires license for at least one Defender XDR product) to get the most up-to-date information about the activity and techniques discussed in this blog. These reports provide intelligence, protection information, and recommended actions to prevent, mitigate, or respond to associated threats found in customer environments.</p><p>Microsoft Security Copilot customers can also use the <a href=\"https://learn.microsoft.com/defender/threat-intelligence/security-copilot-and-defender-threat-intelligence?bc=%2Fsecurity-copilot%2Fbreadcrumb%2Ftoc.json&amp;toc=%2Fsecurity-copilot%2Ftoc.json#turn-on-the-security-copilot-integration-in-defender-ti\">Microsoft Security Copilot integration</a> in Microsoft Defender Threat Intelligence, either in the Security Copilot standalone portal or in the <a href=\"https://learn.microsoft.com/defender/threat-intelligence/using-copilot-threat-intelligence-defender-xdr\">embedded experience</a> in the Microsoft Defender portal to get more information about this threat threat.</p><h2 id=\"sec-25\">Hunting</h2><h3 id=\"sec-26\">Audit logs and investigation data</h3><p>Detecting and investigating ARTEX activity depends on logs that some organizations don’t collect by default. An empty result from a hunting query isn’t proof that no access occurred if the underlying logs aren’t collected.</p><ul>\n<li>Microsoft Entra logs<strong>.</strong> Use <a href=\"https://learn.microsoft.com/entra/identity/monitoring-health/howto-configure-diagnostic-settings\">Microsoft Entra diagnostic settings</a> to send audit logs and sign-in logs to a Log Analytics workspace. <a href=\"https://learn.microsoft.com/entra/identity/monitoring-health/concept-sign-ins\">Service principal sign-ins</a> are recorded separately from interactive user sign-ins, so include them.</li>\n\n\n\n<li>Microsoft Graph requests<strong>.</strong> <a href=\"https://learn.microsoft.com/graph/microsoft-graph-activity-logs-overview\">Microsoft Graph activity logs</a> record the requests that applications and users send to Microsoft Graph, including the user agent, which helps scope reconnaissance with stolen application credentials.</li>\n\n\n\n<li>Web server logs<strong>.</strong> <a href=\"https://learn.microsoft.com/azure/azure-monitor/vm/data-collection-iis\">Collect IIS logs</a> with Azure Monitor and turn on <a href=\"https://learn.microsoft.com/azure/app-service/troubleshoot-diagnostic-logs\">App Service diagnostic logs</a> so that request bursts and user agents are available for hunting.</li>\n\n\n\n<li>Web application firewall activity<strong>.</strong> <a href=\"https://learn.microsoft.com/azure/web-application-firewall/ag/web-application-firewall-logs\">Web Application Firewall logs</a> on Application Gateway include access and firewall logs for allowed and blocked requests.</li>\n</ul><h3 id=\"sec-27\">Microsoft Perception</h3><p>The following prompts may be used in <a href=\"https://learn.microsoft.com/security/agentic-security/agentic-security-overview\">Perception</a>, utilizing red team, blue team, and green team agents within the Microsoft Defender XDR portal.</p><p><strong>Focus an investigation on ARTEX-driven activity</strong></p><pre>Investigate recent Defender XDR evidence of automated intrusion activity consistent \nwith an agentic AI penetration testing framework such as ARTEX. Look for bursts of web \nrequests, scanning, or failed sign-ins from one source; web server processes that run \nshell commands or download tools such as curl, wget, or netcat; new script files in web \nfolders; reads of credential and secret files; and service principal sign-ins followed \nby credential changes, privileged role assignments, Microsoft Graph or Azure Resource \nManager enumeration, or Key Vault and Storage access. Return prioritized findings with \nverdict, affected entities, timeline, supporting alerts and incidents, and evidence-\nbased next steps. Separate confirmed evidence from assumptions.\n</pre><p><strong>Focus triage on ARTEX-driven activity</strong></p><p>Find and summarize recent Defender XDR alerts and incidents in which activity from the same source moves from one attack stage to the next within minutes, such as web application exploitation followed by web shell activity, credential access, or cloud identity abuse. Prioritize activity with user agents that contain artex-enrich or norma. Return affected entities, timeline, supporting alerts and incidents, verdict, and evidence-based next steps.</p><pre>Find and summarize recent Defender XDR alerts and incidents in which activity \nfrom the same source moves from one attack stage to the next within minutes, \nsuch as web application exploitation followed by web shell activity, credential \naccess, or cloud identity abuse. Prioritize activity with user agents that contain \nartex-enrich or norma. Return affected entities, timeline, supporting alerts and \nincidents, verdict, and evidence-based next steps.\n</pre><h3 id=\"sec-28\">Microsoft Defender XDR</h3><p>Microsoft Defender XDR customers can run the following <a href=\"https://learn.microsoft.com/defender-xdr/advanced-hunting-overview\">advanced hunting</a> queries to find related activity in their networks. The first three queries require Microsoft Defender for Endpoint on the Windows and Linux servers that host internet-facing applications. The service principal query uses the EntraIdSpnSignInEvents table, which requires Microsoft Entra ID P2.</p><p><strong>Web server processes running bursts of shell commands</strong></p><p>Find web and application server processes that start shells or download tools many times within five minutes. ARTEX agents run commands through web shells and retry at machine speed and have used curl and netcat to download remote access trojans. Tune the threshold, set to 10 distinct commands by default, and exclude build or automation servers that run shells under Java or Node.js.</p><pre>// Shells and download tools started by web or application server processes\nlet WebServerProcesses = dynamic([\"w3wp.exe\", \"httpd\", \"apache2\", \"nginx\", \"lighttpd\",\n    \"java\", \"node\"]);\nlet ShellsAndTools = dynamic([\"sh\", \"bash\", \"dash\", \"zsh\", \"cmd.exe\", \"powershell.exe\",\n    \"pwsh\", \"pwsh.exe\", \"curl\", \"wget\", \"nc\", \"ncat\", \"certutil.exe\", \"python3\", \"perl\"]);\nDeviceProcessEvents\n| where InitiatingProcessFileName in~ (WebServerProcesses)\n    or InitiatingProcessFileName startswith \"php\"\n| where FileName in~ (ShellsAndTools)\n| summarize DistinctCommands = dcount(ProcessCommandLine), Tools = make_set(FileName, 20),\n    SampleCommands = make_set(ProcessCommandLine, 25), FirstSeen = min(Timestamp),\n    LastSeen = max(Timestamp)\n    by DeviceId, DeviceName, InitiatingProcessFileName, bin(Timestamp, 5m)\n| where DistinctCommands &gt;= 10\n| order by DistinctCommands desc\n</pre><p><strong>Script files written to web folders by web or database server processes</strong></p><p>Find script files, such as .php, .jsp, and .aspx files, that web or database server processes create or change, including several files in a short time. ARTEX agents upload web shells with incrementing names and have written web shells through database log files. Content management system updates also write script files, so review the file names and folders.</p><pre>// Script files created or changed by web server or database server processes\nlet ScriptExtensions = dynamic([\"php\", \"phtml\", \"jsp\", \"jspx\", \"asp\", \"aspx\", \"ashx\",\n    \"asmx\"]);\nlet WebServerProcesses = dynamic([\"w3wp.exe\", \"httpd\", \"apache2\", \"nginx\", \"lighttpd\",\n    \"java\", \"node\"]);\nlet DatabaseProcesses = dynamic([\"mysqld\", \"mariadbd\", \"postgres\", \"sqlservr\",\n    \"sqlservr.exe\"]);\nDeviceFileEvents\n| where ActionType in (\"FileCreated\", \"FileModified\", \"FileRenamed\")\n| extend Extension = tolower(extract(@\"\\.([^.]+)$\", 1, FileName))\n| where Extension in (ScriptExtensions)\n| where InitiatingProcessFileName in~ (WebServerProcesses)\n    or InitiatingProcessFileName in~ (DatabaseProcesses)\n    or InitiatingProcessFileName startswith \"php\"\n| summarize Files = dcount(FileName), FileNames = make_set(FileName, 25),\n    Folders = make_set(FolderPath, 10),\n    DatabaseWrites = countif(InitiatingProcessFileName in~ (DatabaseProcesses))\n    by DeviceId, DeviceName, InitiatingProcessFileName, bin(Timestamp, 10m)\n| where DatabaseWrites &gt; 0 or Files &gt;= 3\n| order by DatabaseWrites desc, Files desc\n</pre><p><strong>Commands that read several kinds of credential and secret files</strong></p><p>Find devices where commands reference three or more kinds of credential and secret files within 10 minutes, such as <em>/etc/shadow</em>, <em>.env</em> files, private keys, and cloud credential files. ARTEX agents read these files in rapid succession after they gain a foothold.</p><pre>// Commands that reference three or more kinds of credential and secret files\nlet SecretFiles = dynamic([\"/etc/shadow\", \".env\", \"id_rsa\", \"id_ecdsa\", \"id_ed25519\",\n    \".aws/credentials\", \".azure/\", \".kube/config\", \".git-credentials\", \".pgpass\",\n    \".my.cnf\", \"wp-config.php\", \"web.config\", \"appsettings.json\"]);\nDeviceProcessEvents\n| where ProcessCommandLine has_any (\"shadow\", \"env\", \"id_rsa\", \"id_ecdsa\", \"id_ed25519\",\n    \"credentials\", \"azure\", \"kube\", \"pgpass\", \"cnf\", \"config\", \"appsettings\")\n| extend SecretFile = SecretFiles\n| mv-expand SecretFile to typeof(string)\n| where ProcessCommandLine contains SecretFile\n| summarize SecretFileTypes = dcount(SecretFile), SecretFilesSeen = make_set(SecretFile),\n    SampleCommands = make_set(ProcessCommandLine, 20), FirstSeen = min(Timestamp)\n    by DeviceId, DeviceName, AccountName, bin(Timestamp, 10m)\n| where SecretFileTypes &gt;= 3\n| order by SecretFileTypes desc\n</pre><p><strong>Service principal sign-ins for several applications from one IP address</strong></p><p>Find IP addresses that attempt service principal sign-ins for three or more applications in an hour with both failures and successes, or that send the default ARTEX user agents. Agentic tools have used leaked application credentials across many applications and tenants. Error codes 7000215 and 7000222, an invalid or an expired client secret, show attempts with a credential for the application. When a success follows those failures from the same address, investigate right away.</p><pre>// Service principal sign-ins for several applications from one IP address\nEntraIdSpnSignInEvents\n| where IsManagedIdentity == false\n| summarize ServicePrincipals = dcount(ServicePrincipalId),\n    SucceededFor = dcountif(ServicePrincipalId, ErrorCode == 0),\n    FailedSignIns = countif(ErrorCode != 0),\n    InvalidOrExpiredSecret = countif(ErrorCode in (7000215, 7000222)),\n    ArtexUserAgent = countif(UserAgent has_any (\"artex\", \"norma\")),\n    Applications = make_set(ServicePrincipalName, 20),\n    Resources = make_set(ResourceDisplayName, 20), UserAgents = make_set(UserAgent, 10),\n    FirstSeen = min(Timestamp), LastSeen = max(Timestamp)\n    by IPAddress, bin(Timestamp, 1h)\n| where (ServicePrincipals &gt;= 3 and SucceededFor &gt;= 1 and FailedSignIns &gt;= 1)\n    or ArtexUserAgent &gt; 0\n| order by ServicePrincipals desc\n</pre><h3 id=\"sec-29\">Microsoft Sentinel</h3><p>These queries require Microsoft Entra ID audit logs, and IIS logs, App Service HTTP logs, or Application Gateway access logs in the workspace.</p><p><strong>Machine-speed web request bursts and default ARTEX user agents</strong></p><p>Find client IP addresses that request 100 or more distinct paths with 50 or more client errors in one minute, or that send the default ARTEX user agents, artex-enrich and norma. The query also flags the default user agents of tools that ARTEX runs, such as curl, Wget, Python HTTP clients, headless Chromium, and Nmap. Those are common in legitimate automation, so don’t alert on them alone.</p><pre>// Requests per client IP per minute, with default ARTEX and tool user agents flagged\nunion isfuzzy=true\n    (W3CIISLog\n    | project TimeGenerated, LogSource = \"IIS\", ClientIP = cIP, Path = csUriStem,\n        Status = tostring(scStatus), UserAgent = csUserAgent, Target = Computer),\n    (AppServiceHTTPLogs\n    | project TimeGenerated, LogSource = \"App Service\", ClientIP = CIp, Path = CsUriStem,\n        Status = tostring(ScStatus), UserAgent, Target = CsHost),\n    (AGWAccessLogs\n    | project TimeGenerated, LogSource = \"Application Gateway\", ClientIP = ClientIp,\n        Path = RequestUri, Status = tostring(HttpStatus), UserAgent, Target = Host)\n| extend AgentType = case(\n    UserAgent has_any (\"artex\", \"norma\"), \"ARTEX default\",\n    UserAgent matches regex @\"^(curl|Wget|python-requests|Python-urllib|Go-http-client)/\",\n        \"Tool default\",\n    UserAgent has_any (\"HeadlessChrome\", \"Nmap\"), \"Tool default\",\n    \"Other\")\n| summarize Requests = count(), DistinctPaths = dcount(Path),\n    ClientErrors = countif(Status startswith \"4\"),\n    ArtexAgentRequests = countif(AgentType == \"ARTEX default\"),\n    ToolAgentRequests = countif(AgentType == \"Tool default\"),\n    UserAgents = make_set(UserAgent, 10), Targets = make_set(Target, 10)\n    by ClientIP, LogSource, bin(TimeGenerated, 1m)\n| where ArtexAgentRequests &gt; 0 or (DistinctPaths &gt;= 100 and ClientErrors &gt;= 50)\n| order by ArtexAgentRequests desc, DistinctPaths desc\n</pre><p><strong>Application credential changes and role assignments by the same identity</strong></p><p>Find users or applications that both add or change application credentials and assign directory roles or application permissions within an hour. During Storm-0940 activity, ARTEX agents added credentials to applications, and an application assigned itself the Global Administrator role.</p><pre>// Credential changes and role assignments made by the same identity within an hour\nAuditLogs\n| where Result =~ \"success\"\n| where OperationName in (\"Add service principal credentials\", \"Add member to role\",\n    \"Add app role assignment to service principal\")\n    or OperationName contains \"Certificates and secrets management\"\n| extend Stage = iff(OperationName has_any (\"credentials\", \"Certificates\"), \"Credential\",\n    \"Role\")\n| extend ActorUpn = tostring(InitiatedBy.user.userPrincipalName),\n    ActorServicePrincipalId = tostring(InitiatedBy.app.servicePrincipalId),\n    ActorAppId = tostring(InitiatedBy.app.appId),\n    TargetName = tostring(TargetResources[0].displayName)\n| extend Actor = coalesce(ActorUpn, ActorServicePrincipalId, ActorAppId)\n| summarize Stages = make_set(Stage), Operations = make_set(OperationName),\n    Targets = make_set(TargetName, 20), FirstSeen = min(TimeGenerated),\n    LastSeen = max(TimeGenerated)\n    by Actor, ActorAppId, bin(TimeGenerated, 1h)\n| where array_length(Stages) == 2\n| order by FirstSeen desc\n</pre><h2 id=\"sec-30\">MITRE ATT&amp;CK techniques</h2><p>This tool has exhibited use of the following attack techniques. For standard industry documentation about these techniques, refer to the <a href=\"https://attack.mitre.org/\">MITRE ATT&amp;CK framework</a>.</p><p><strong>Resource Development</strong></p><ul>\n<li><a href=\"https://attack.mitre.org/techniques/T1588/007/\">T1588.007 Obtain Capabilities: Artificial Intelligence</a> | Threat actors obtain ARTEX from public repositories or forks and pair it with commercial or self-hosted LLMs.</li>\n\n\n\n<li><a href=\"https://attack.mitre.org/techniques/T1588/002/\">T1588.002 Obtain Capabilities: Tool</a> | ARTEX agents install offensive tools at runtime or write equivalent scripts.</li>\n</ul><p><strong>Reconnaissance</strong></p><ul>\n<li><a href=\"https://attack.mitre.org/techniques/T1595/001/\">T1595.001 Active Scanning: Scanning IP Blocks</a> | ARTEX runs nmap for port and service scanning.</li>\n\n\n\n<li><a href=\"https://attack.mitre.org/techniques/T1595/002/\">T1595.002 Active Scanning: Vulnerability Scanning</a> | ARTEX agents probe web applications and APIs for injection, authentication, and access-control weaknesses.</li>\n\n\n\n<li><a href=\"https://attack.mitre.org/techniques/T1595/003/\">T1595.003 Active Scanning: Wordlist Scanning</a> | ARTEX agents enumerate directories, endpoints, and file names, sending hundreds of requests to learn which ones the server allows.</li>\n\n\n\n<li><a href=\"https://attack.mitre.org/techniques/T1594/\">T1594 Search Victim-Owned Websites</a> | ARTEX agents harvest JavaScript bundles, source maps, runtime configuration, and API documentation from target applications to discover internal API routes, and ARTEX’s enrichment component collects page titles from discovered sites.</li>\n</ul><p><strong>Initial Access</strong></p><ul>\n<li><a href=\"https://attack.mitre.org/techniques/T1190/\">T1190 Exploit Public-Facing Application</a> | ARTEX agents exploit injection, file upload, authentication, and access-control flaws in internet-facing applications.</li>\n\n\n\n<li><a href=\"https://attack.mitre.org/techniques/T1078/\">T1078 Valid Accounts</a> | ARTEX reuses credentials that it captures, or that the operator supplies, against applications, hosts, and services.</li>\n\n\n\n<li><a href=\"https://attack.mitre.org/techniques/T1078/004/\">T1078.004 Valid Accounts: Cloud Accounts</a> | ARTEX agents authenticated to Microsoft 365 tenants with stolen application credentials that Storm-0940 supplied.</li>\n\n\n\n<li><a href=\"https://attack.mitre.org/techniques/T1199/\">T1199 Trusted Relationship</a> | ARTEX agents reached downstream tenants through an already-consented third-party application whose credentials Storm-0940 had stolen.</li>\n</ul><p><strong>Execution</strong></p><ul>\n<li><a href=\"https://attack.mitre.org/techniques/T1059/\">T1059 Command and Scripting Interpreter</a> | ARTEX runs shell, Python, and PowerShell commands on compromised servers through command injection, web shells, and remote shells.</li>\n\n\n\n<li><a href=\"https://attack.mitre.org/techniques/T1651/\">T1651 Cloud Administration Command</a> | ARTEX agents have run commands through cloud administration interfaces, such as Kudu, when they had credentials for them.</li>\n</ul><p><strong>Persistence</strong></p><ul>\n<li><a href=\"https://attack.mitre.org/techniques/T1505/003/\">T1505.003 Server Software Component: Web Shell</a> | ARTEX uploads web shells, or writes them through database logging, and then sends commands to them.</li>\n\n\n\n<li><a href=\"https://attack.mitre.org/techniques/T1098/001/\">T1098.001 Account Manipulation: Additional Cloud Credentials</a> | ARTEX agents added credentials to applications to maintain access during Storm-0940 activity.</li>\n</ul><p><strong>Privilege Escalation</strong></p><ul>\n<li><a href=\"https://attack.mitre.org/techniques/T1098/003/\">T1098.003 Account Manipulation: Additional Cloud Roles</a> | ARTEX agents assigned privileged roles during Storm-0940 activity, including an application assigning itself the Global Administrator role.</li>\n</ul><p><strong>Credential Access</strong></p><ul>\n<li><a href=\"https://attack.mitre.org/techniques/T1110/001/\">T1110.001 Brute Force: Password Guessing</a> | ARTEX tests weak passwords and brute forces sign-in forms.</li>\n\n\n\n<li><a href=\"https://attack.mitre.org/techniques/T1110/003/\">T1110.003 Brute Force: Password Spraying</a> | Storm-0940 used ARTEX to accelerate password spraying against Microsoft 365, and other actors have used it to spray identity providers.</li>\n\n\n\n<li><a href=\"https://attack.mitre.org/techniques/T1552/001/\">T1552.001 Unsecured Credentials: Credentials In Files</a> | ARTEX reads <em>.env</em> files, configuration files, and keys after gaining a foothold.</li>\n\n\n\n<li><a href=\"https://attack.mitre.org/techniques/T1003/008/\">T1003.008 OS Credential Dumping: /etc/passwd and /etc/shadow</a> | ARTEX reads <em>/etc/shadow</em> on compromised Linux servers.</li>\n\n\n\n<li><a href=\"https://attack.mitre.org/techniques/T1552/005/\">T1552.005 Unsecured Credentials: Cloud Instance Metadata API</a> | ARTEX agents have used an XXE flaw to query a cloud metadata service for role credentials.</li>\n\n\n\n<li><a href=\"https://attack.mitre.org/techniques/T1558/003/\">T1558.003 Steal or Forge Kerberos Tickets: Kerberoasting</a> | ARTEX agents run Kerberoasting scripts in compromised domains.</li>\n\n\n\n<li><a href=\"https://attack.mitre.org/techniques/T1003/006/\">T1003.006 OS Credential Dumping: DCSync</a> | ARTEX agents run DCSync scripts to obtain domain credentials.</li>\n</ul><p><strong>Discovery</strong></p><ul>\n<li><a href=\"https://attack.mitre.org/techniques/T1087/004/\">T1087.004 Account Discovery: Cloud Account</a> | ARTEX agents performed Microsoft Graph and directory reconnaissance during Storm-0940 activity.</li>\n\n\n\n<li><a href=\"https://attack.mitre.org/techniques/T1087/002/\">T1087.002 Account Discovery: Domain Account</a> | ARTEX agents enumerate Active Directory objects, including privileged groups.</li>\n\n\n\n<li><a href=\"https://attack.mitre.org/techniques/T1580/\">T1580 Cloud Infrastructure Discovery</a> | ARTEX agents map the permissions of stolen cloud credentials and enumerate cloud resources.</li>\n</ul><p><strong>Lateral Movement</strong></p><ul>\n<li><a href=\"https://attack.mitre.org/techniques/T1021/\">T1021 Remote Services</a> | ARTEX agents capture credentials for other reachable systems and move laterally through remote services such as Secure Shell (SSH) and WinRM.</li>\n</ul><p><strong>Collection</strong></p><ul>\n<li><a href=\"https://attack.mitre.org/techniques/T1213/006\">T1213.006 Data from Information Repositories: Databases</a> | ARTEX extracts database contents through SQL injection, such as with sqlmap, or with database clients.</li>\n\n\n\n<li><a href=\"https://attack.mitre.org/techniques/T1530/\">T1530 Data from Cloud Storage</a> | ARTEX agents perform mass reads from cloud storage with stolen credentials.</li>\n</ul><p><strong>Command and Control</strong></p><ul>\n<li><a href=\"https://attack.mitre.org/techniques/T1090/\">T1090 Proxy</a> | ARTEX can send target traffic through a configured outbound proxy. Threat actors have rotated through virtual private network (VPN), proxy, and Tor infrastructure when blocked.</li>\n\n\n\n<li><a href=\"https://attack.mitre.org/techniques/T1102/002/\">T1102.002 Web Service: Bidirectional Communication</a> | ARTEX agents have used curl with rotating <em>webhook.site</em> URLs to deliver scripts to a compromised server and return command output.</li>\n</ul><h3 id=\"sec-31\">References</h3><ul>\n<li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/10/21/storm-0940-uses-artex-agentic-ai-connectwise-supply-chain-compromise/\">AI-driven, large-scale nation-state campaign using ARTEX enables supply chain compromise</a>. Microsoft</li>\n\n\n\n<li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/06/artex-abuse-expands-as-cybercriminals-target-financial-sector/\">ARTEX abuse expands as cybercriminals target financial sector</a>. Microsoft</li>\n\n\n\n<li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/05/threat-actors-use-agentic-ai-tooling-to-find-and-abuse-exposed-secrets/\">Threat actors use agentic AI tooling to find and abuse exposed secrets</a>. Microsoft</li>\n\n\n\n<li><a href=\"https://www.huntress.com/blog/connectwise-attack-ai\">AI, Scripts, Operator: Inside the ConnectWise Attack</a>. Huntress</li>\n\n\n\n<li><a href=\"https://www.wiz.io/blog/artex-in-the-wild-storm-0940-expands-targeting-of-it-and-software-vendors\">ARTEX in the Wild: Storm-0940 Expands Targeting of IT and Software Vendors</a>. Wiz</li>\n\n\n\n<li><a href=\"https://cloud.google.com/blog/topics/threat-intelligence/artex-and-friends-enter-agentic-offensive-frameworks\">ARTEX and Friends: Enter Agentic Offensive Frameworks</a>. Google Threat Intelligence Group</li>\n\n\n\n<li><a href=\"https://www.crowdstrike.com/en-us/blog/vapor-panda-uses-artex-to-scale-global-campaign/\">VAPOR PANDA Uses AI-Driven ARTEX to Scale a Global Espionage Campaign</a>. CrowdStrike</li>\n\n\n\n<li><a href=\"https://www.crowdstrike.com/en-us/blog/unknown-threat-actor-uses-artex-to-target-south-korean-finance/\">Unknown Threat Actor Uses AI-Driven ARTEX to Target South Korean Finance</a>. CrowdStrike</li>\n</ul><h3 id=\"sec-32\">Learn more</h3><p>For the latest security research from the Microsoft Threat Intelligence community, check out the <a href=\"https://aka.ms/threatintelblog\">Microsoft Threat Intelligence Blog</a>.</p><p>To get notified about new publications and to join discussions on social media, follow us on <a href=\"https://www.linkedin.com/showcase/microsoft-threat-intelligence\">LinkedIn</a>, <a href=\"https://x.com/MsftSecIntel\">X (formerly Twitter)</a>, and <a href=\"https://bsky.app/profile/threatintel.microsoft.com\">Bluesky</a>.</p><p>To hear stories and insights from the Microsoft Threat Intelligence community about the ever-evolving threat landscape, listen to the <a href=\"https://thecyberwire.com/podcasts/microsoft-threat-intelligence\">Microsoft Threat Intelligence podcast</a>.</p><p>The post <a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/25/what-defenders-need-to-know-artex-agentic-ai-framework-threat-actors-abuse/\">What defenders need to know about ARTEX, the agentic AI framework threat actors abuse</a> appeared first on <a href=\"https://www.microsoft.com/en-us/security/blog\">Microsoft Security Blog</a>.</p>","original","zhKind","complete","Agent 安全","AI 编码","Microsoft","https://www.microsoft.com/en-us/security/blog/2026/11/25/what-defenders-need-to-know-artex-agentic-ai-framework-threat-actors-abuse/","Microsoft Security Blog",{"_182":183,"_184":-5},"changelogVersion","2026-10-01T08:00","release"]
