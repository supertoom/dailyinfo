[{"_1":2,"_3":4},"root",{"_5":101},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1793621937000,"id","vwazprhy9sym8n3jfpzyapz5g","title","Android SMS of Death 漏洞分析：CVE-2026-58882 可用零点击 WAP Push 消息阻断电话服务","originalTitle","SMS of Death: Android under attack, an invisible SMS can block calls and emergency services","summary","独立研究员 Mark Blaszczyk 披露 Android 的 SMS of Death 漏洞 CVE-2026-58882，攻击者仅需发送一条特制 WAP Push 消息即可零点击触发崩溃，阻断电话及紧急呼叫。","reason","文章拆解了零点击 WAP Push 消息触发电话服务崩溃的原理、复现效果与修复范围，便于评估旧款 Android 设备的暴露风险。","source",{"_74":100},"links",{"_92":99},"publishedAt","2026-11-01T12:16:50.000Z","discoveredAt","2026-11-01T13:26:34.091Z","timelineAt","category","disclosure","tags",[96,97,75,79,98],"score",79,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Pierluigi Paganini","body",{"_61":91,"_92":-5,"_93":94,"_95":37},"outline",[86],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fafTcIRBwfko","reportCount",2,"additionalSourceCount",1,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","research","name","技术研究","vuln","漏洞披露","mobile","移动端","google","Google / 谷歌",{"_83":84,"_13":85},"publicId","c5486508-cdc6-495f-b2ad-9788dc5a009f","Android短信拒绝服务漏洞PoC公开",{"_11":87,"_88":89,"_90":65},"sec-1","text","“短信死亡”攻击可让攻击者通过一条隐藏的零点击消息使 Android 通话服务崩溃，从而阻断电话，甚至包括紧急呼叫。","level","<h2 id=\"sec-1\">“短信死亡”攻击可让攻击者通过一条隐藏的零点击消息使 Android 通话服务崩溃，从而阻断电话，甚至包括紧急呼叫。</h2><p>一条经过特殊处理的短信就足以使 Android 的电话服务崩溃、中断正在进行的通话，并暂时导致智能手机无法使用。该攻击无需受害者进行任何交互，甚至可能破坏联系紧急服务的能力。</p><p>这一被称为“短信死亡”的漏洞，再次引发了对 Android 智能手机消息系统安全性的关注。独立研究员 Mark Blaszczyk <a href=\"https://smsofdeath.com/\">记录了</a>这一问题：攻击者只需发送一条精心构造的 WAP Push 消息，即可远程干扰电话服务。</p><p>WAP Push（Wireless Application Protocol Push）是通过移动网络传输的一种特殊消息，通常采用二进制短信的形式，包含结构化数据，由智能手机自动处理，无需用户干预。与传统短信不同，它可以携带通知、互联网资源链接以及移动服务配置。</p><p>最令人担忧的是其执行方式。这是一种零点击攻击，收件人无需打开消息、选择链接或授权任何操作。内容会由操作系统自动处理，并可能导致负责电话功能的进程崩溃。</p><p>该漏洞影响 <em>“WapPushOverSms</em>“这一 Android 框架组件，它位于 <em>“frameworks/opt/telephony</em>” 路径下，负责解释和管理设备收到的 WAP Push 消息。</p><p>技术原因在于消息解释过程中对一个数值处理不当。研究员解释道，具体来说，<em>“decodeWapPdu()</em>” 函数通过一个编码为 <em>“uintvar</em>” 的值读取 WSP 头部长度，该值最初以 64 位数字返回。随后，该值在没有事先进行范围检查的情况下被转换为 32 位整数。这一操作可能将看似有效的数字转换为负值，随后该负值会被用于确定数组大小。由此引发的后果是 <em>“NegativeArraySizeException</em>” 异常；当 Android 尝试分配大小为负的数组时便会抛出该异常。处理路径未能正确处理此异常，导致负责电话功能的 <em>“com.android.phone</em>” 进程终止。</p><p>研究员演示了一个 5 字节的 WSP 头可以生成 <em>“-2147483648</em>“这一值，足以触发该问题。因此，并不需要传输特别大量的内容即可引发问题。</p><p><em>“一个值为 <code>88 80 80 80 00</code> 的 5 字节 uintvar 解码后为 <code>0x80000000</code>。转换为有符号 32 位 <code>int</code> 后，其值为 <code>-2147483648</code>。分配 <code>new byte[-2147483648]</code> 时，会在电话主线程上抛出未捕获的 <code>NegativeArraySizeException</code>，从而终止 <code>com.android.phone</code>：”<a href=\"https://smsofdeath.com/\">查看该分析</a>。</em></p><p><strong>一种还会中断紧急呼叫的隐形攻击</strong></p><p>该消息通过 WAP Push 通道在端口 2948 上以数据短信的形式传输。与普通短信不同，它不会显示在消息收件箱中，也不会生成用户可识别的通知。发送者的号码通常不会显示在对话中，设备收到消息后，Android 会自动开始处理。手机进程发生崩溃会导致连接暂时中断，并影响正在进行的语音通话，包括拨打紧急服务时的通话。</p><p>根据研究人员发布的证据，每次处理消息都可能造成约 1 至 2 秒的电话服务中断，在此期间该组件会重启。不过，如果消息被反复处理，问题可能会严重得多。</p><p>SMS of Death 最显著的特点之一，是能够将简单的崩溃转变为持续性的拒绝服务状态。恶意消息可以留在传入短信队列中，并在后续投递尝试时被重新处理。电话运营商的重传机制也可能促使该事件再次发生，从而造成进一步的服务中断。</p><p>研究人员报告称，收到单条消息后，最多持续一周都能观察到间歇性崩溃。发送大约 20 条 specially crafted 消息，可能会让设备在很长一段时间内无法使用。在更严重的情况下，手机进程可能在系统启动期间持续崩溃，触发类似启动循环的状态。恢复可能需要在计算机上使用 Android Debug Bridge (ADB)，直接干预等待处理的消息队列。对于普通用户来说，这远非简单的操作。</p><p><strong>对通信可用性的威胁</strong></p><p>SMS of Death 表明，网络攻击不一定要涉及信息窃取、代码执行或设备控制，也能造成严重后果。本例中的目标是电话服务可用性，这是一项关键功能，尤其是在联系紧急服务时。无需任何用户交互就能中断通信，使这一漏洞显得格外敏感。为了减少暴露风险，应检查已安装的 Android 安全补丁级别并应用可用更新，尤其要关注已不再获得制造商支持的设备。</p><p>Mark Blah 开展的<a href=\"https://smsofdeath.com/\">测试</a>表明，该问题可在多款设备上复现，包括 Google Pixel 9 以及 Galaxy 和 Galaxy A 系列的 Samsung 智能手机。易受影响的代码似乎存在于从 Android 12 到 Android 17 的各版本 Android 中。然而，该修复程序的可用性在不同世代的操作系统之间并不一致。 </p><p>根据研究人员发布的文档，Google 已通过 2026 年 10 月的 Android 14、15、16 和 17 安全更新分发了修复程序。较旧的设备（例如运行 Android 12 和 13 的设备）如果未收到纠正性更新，可能仍会受到影响。</p><figure><blockquote><p>它被分配了 CVE-2026-58882，并在 2026 年 11 月的 Android Security Bulletin 中被列为 Critical 严重级别。自我们的 2026072901 版本发布以来，我们一直将其列为安全预览版本中包含的补丁之一，您可以在发布说明中看到：<a href=\"https://t.co/tBoWBpALw1\">https://t.co/tBoWBpALw1</a></p>— GrapheneOS (@GrapheneOS) <a href=\"https://x.com/GrapheneOS/status/2115862510373126280?ref_src=twsrc%5Etfw\">October 29, 2026</a></blockquote>\n</figure><p><strong>关于作者：Salvatore Lombardo</strong>&nbsp;(<strong>X&nbsp;<a href=\"https://twitter.com/Slvlombardo\">@Slvlombardo</a></strong>)</p><p>电子工程师、Clusit 成员，一段时间以来一直倡导 conscious education 理念，并为多家网络安全在线杂志撰稿。他也是书籍《La Gestione della Cyber Security nella Pubblica Amministrazione》的作者。“教育提升意识”是他的口号。</p><p><strong>在 Twitter 上关注我：&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;以及&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;和&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a><strong></strong></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;hacking,&nbsp;SMS of Death)</strong></p>","original","zhKind","translation","complete","漏洞分析","复现","Google","https://securityaffairs.com/202184/security/sms-of-death-android-under-attack-an-invisible-sms-can-block-calls-and-emergency-services.html","Security Affairs",{"_102":103,"_104":-5},"changelogVersion","2026-10-01T08:00","release"]
