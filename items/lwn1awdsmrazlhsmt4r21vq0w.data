[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795480838000,"id","lwn1awdsmrazlhsmt4r21vq0w","title","Microsoft Entra Connect Health 漏洞遭利用，租户数据被未授权访问","originalTitle","Microsoft Entra Connect Health flaw exploited to steal tenant data","summary","攻击者利用 Microsoft Entra Connect Health API 漏洞，未授权读取租户级元数据，并可能修改 Connect Health 监控配置。","reason","事件提供了暴露数据类型、修复时间与客户无需更新的处置边界，也指出钓鱼风险和日志排查方向，便于受影响组织核对风险。","source",{"_75":103},"links",{"_95":102},"publishedAt","2026-11-21T18:01:58.000Z","discoveredAt","2026-11-21T18:05:45.021Z","timelineAt","category","activity","tags",[76,78,99,100,82,101],"score",77,"selected",true,"channel","news","story",{"_86":87,"_13":88},"x","readingMode","full","author","Lawrence Abrams","body",{"_61":94,"_95":-5,"_96":97,"_98":37},"outline",[89],"relatedStories",[85],"topics",[68,69,70,71,72],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","f_LT_cj56DqU","reportCount",2,"additionalSourceCount",1,{"_73":83,"_75":84},{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","attack","name","攻击活动","exploited","在野利用","email","邮件与钓鱼","identity","身份与访问","microsoft","Microsoft / 微软",{"_86":87,"_13":88},"publicId","45b107e1-493e-4f40-9f44-92eeae10ed9c","Entra Connect Health API漏洞已被利用",{"_11":90,"_91":92,"_93":65},"sec-1","text","发现现有防御可能遗漏的邮件威胁。","level","<p><img alt=\"Microsoft\" height=\"900\" src=\"/dailyinfo/media/940ea24cd9cfde1f.jpg\" srcset=\"/dailyinfo/media/7ff9ab1010d51a70.jpg 720w, /dailyinfo/media/f5ac3333f33be175.jpg 1200w, /dailyinfo/media/940ea24cd9cfde1f.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>Microsoft 正警告各组织，其遭遇了数据泄露：攻击者利用其 Entra Connect Health 服务中的漏洞，未经授权访问了管理员电子邮件地址和租户配置信息。</p><p>Microsoft Entra Connect Health 是一项云端监控服务，允许管理员通过 Microsoft Entra 管理中心监控其本地身份基础设施的运行状况、性能和警报。</p><p>根据昨天发送给管理员并在 <a href=\"https://www.reddit.com/r/sysadmin/comments/1y1of2u/important_security_notification_regarding/\">Reddit 上分享</a>的一则安全通知，Microsoft 于 2026 年 11 月 9 日发现了 Entra Connect Health API 中的漏洞，该漏洞最初于 7 月 23 日引入。</p><p><a href=\"https://www.wiz.io/lp/claude-code-security-best-practices-cheat-sheet?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q3_INB_FORM_Claude-Code-Security-Best-Practices&amp;sfcid=701Vh00000gJQZuIAO&amp;utm_term=FY27Q4-bleepingcomputer-article-970x250-Nov&amp;utm_content=Claude-Code-Best-Practices\"><img src=\"/dailyinfo/media/8cac6f24e6d97493.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>调查确定，该漏洞已被利用，未经授权的各方得以访问租户和服务监控元数据，并可能修改 Connect Health 监控配置。</p><p>Microsoft 在通知中表示：“2026 年 11 月 20 日，我们结束了调查，并确定与贵组织关联的租户级元数据曾遭到未经授权的只读访问。我们未发现任何未经授权的配置更改。”</p><p>该公司表示，暴露的信息包括：</p><ul>\n\t<li>租户技术联系人和管理员账户所属的电子邮件地址。</li>\n\t<li>租户 ID、显示名称、初始域名、国家/地区代码和区域信息。</li>\n\t<li>Microsoft Entra 许可层级和目录同步状态，包括是否启用了同步以及上次同步的时间戳。</li>\n\t<li>Connect Health 注册状态。</li>\n\t<li>一张过期的证书，先前用于将 Connect Health 代理注册到 Microsoft 的一项内部服务；该服务已于 2024 年末停用。</li>\n</ul><p>Microsoft 表示，这张过期证书已不再使用，但仍保留在 Connect Health 存储中，并且仍会由 API 返回。</p><p>不过，该公司表示，该漏洞并未暴露用户密码、密码哈希、身份验证令牌、有效加密密钥、本地服务器和 Active Directory 拓扑详细信息，或 Azure 订阅信息。</p><p>Microsoft 于 11 月 19 日部署了服务器端修复，以防止进一步利用，并审查了可用的遥测数据，以识别影响客户的未经授权 API 调用。该公司于 11 月 20 日完成调查，并开始通知受影响的组织。</p><p>Microsoft 尚未披露有多少组织受到影响，但已有十多名管理员在这篇 Reddit 帖子中报告收到了该&nbsp;通知。</p><p>一些托管服务提供商（MSP）也报告称收到了针对多个客户租户的通知，其中一名管理员表示这些邮件相隔数小时送达。</p><p>通知称，无需进行软件更新或其他客户补救措施即可解决该漏洞。</p><p>不过，Microsoft 建议组织提醒其安全团队注意潜在的目标式网络钓鱼和社会工程攻击；这些攻击可能以已暴露的管理员电子邮件地址和租户信息为目标。</p><p>组织还应确保特权账户使用抗网络钓鱼的多因素身份验证，审查其 Connect Health 配置，并检查 Microsoft Entra 审计日志和登录日志中是否存在可疑活动。</p><p>Microsoft 还在 <a href=\"https://aka.ms/ConnectHealth/scripts\">https://aka.ms/ConnectHealth/scripts</a> 发布了一个&nbsp;PowerShell 脚本，使管理员能够查看可能被暴露的租户元数据类型。</p><p>然而，该脚本显示的是当前配置值，而不是入侵期间被访问的信息。</p><p>Microsoft 尚未披露是谁利用了该漏洞、有多少租户受到影响，以及攻击最早始于何时。</p><p>BleepingComputer 联系 Microsoft 时，Microsoft 确认已修复该漏洞，并通知了受影响的客户。</p><p>“我们发现并处理了一个影响 Microsoft Entra Connect Health 的安全问题，该问题可能导致未经授权访问租户级联系人和配置元数据。我们已于 2026 年 11 月 19 日部署修复，并通过 Azure Service Health 通知受影响的客户，同时提供指导和支持。”一位 Microsoft 发言人对 BleepingComputer 表示。</p><p>Microsoft 拒绝提供有关此次入侵的更多细节。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/af2e1e4209b93434.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 代理会分析邮件意图、上下文和行为，发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>通过为 Microsoft 365 或 Google Workspace 进行 14 天只读扫描，查看有哪些内容成功绕过防护，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始免费的电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","数据泄露","Microsoft","钓鱼","https://www.bleepingcomputer.com/news/security/microsoft-entra-connect-health-flaw-exploited-to-steal-tenant-data/","BleepingComputer",{"_105":106,"_107":-5},"changelogVersion","2026-10-01T08:00","release"]
