[{"_1":2,"_3":4},"root",{"_5":99},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795135240000,"id","nyd4hh8a7m5q933cuuvf2ko4j","title","Linux 内核 NoisyTCP 漏洞 CVE-2026-99288 可远程崩溃服务器","originalTitle","New NoisyTCP vulnerability lets attackers crash Linux servers","summary","Linux 内核 NoisyTCP 漏洞 CVE-2026-99288 可由未认证攻击者利用恶意 TCP  packets 远程触发，影响几乎所有 Linux 发行版及默认配置下运行 Nginx、Apache 或 SSH 的系统。","reason","文章拆解了触发竞态窗口所需的网络条件，并给出补丁状态与临时缓解取舍，便于评估服务器暴露风险。","source",{"_71":98},"links",{"_85":97},"publishedAt","2026-11-16T09:30:04.000Z","discoveredAt","2026-11-16T09:50:16.047Z","timelineAt","category","vuln","tags",[89,90,91,92,93,94,95,96],"score",75,"selected",true,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","Sergiu Gatlan","body",{"_61":84,"_85":-5,"_86":87,"_88":37},"outline",[79],"relatedStories",[75],"topics",[68,69],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fNP9bAbFf42c","reportCount",2,"additionalSourceCount",1,{"_70":73,"_71":74},{"_70":31,"_71":72},"slug","name","漏洞披露","kernel","内核与系统",{"_76":77,"_13":78},"publicId","37946332-46ae-4004-bdf7-c27ff4e821ec","Linux NoisyTCP漏洞可远程触发崩溃",{"_11":80,"_81":82,"_83":65},"sec-1","text","发现您现有的防御可能遗漏的电子邮件威胁。","level","<p><img alt=\"Linux\" height=\"900\" src=\"/dailyinfo/media/99c320a5840c966e.jpg\" srcset=\"/dailyinfo/media/475eb16611794cde.jpg 720w, /dailyinfo/media/4c1b599737cf2ddf.jpg 1200w, /dailyinfo/media/99c320a5840c966e.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>一个名为 <strong>NoisyTCP</strong> 的 11 年历史 Linux 内核漏洞几乎影响所有 Linux 发行版，攻击者可使运行默认配置的 Nginx、Apache 和 SSH 服务器的系统崩溃。</p><p>据发现该漏洞的安全研究员 Hyunwoo Kim <a href=\"https://x.com/v4bel/status/2122006607378972745\">称</a>，这个预身份验证的远程破坏漏洞（跟踪编号为 <a href=\"https://nvd.nist.gov/vuln/detail/cve-2026-99288\">CVE-2026-99288</a>）源于 Linux 内核 TCP 网络子系统中的 <a href=\"https://cwe.mitre.org/data/definitions/476.html\">NULL 指针解引用</a>弱点。</p><p>未经身份验证的攻击者可以通过恶意构造的 TCP 数据包远程触发该漏洞，利用 SYN cookie 处理与套接字哈希之间的时序关系，使目标服务器的内核和操作系统崩溃。</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/dfd3325aba4374a1.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>然而，CVE-2026-99288 的利用虽然会引发内核恐慌并导致主机宕机，但无法让威胁行为者修改数据或获得任意代码执行能力。</p><p>Kim 补充称，尽管攻击者可以利用该漏洞针对任何直接接收 TCP 数据包且运行 Nginx、Apache 或 SSH 服务器的 Linux 系统进行利用，但“竞争窗口很窄，因此针对一台空闲的裸金属服务器触发漏洞可能需要很长时间。”</p><p>Red Hat 安全团队 <a href=\"https://access.redhat.com/security/cve/cve-2026-99288\">解释道</a>：“由于无锁套接字查找过程中存在竞态条件，被回收的套接字内存在被正确初始化和计算哈希之前就可能被访问。远程攻击者可以通过生成网络流量来推动套接字重用，从而触发 NULL 指针解引用和内核崩溃，进而造成拒绝服务（DoS）。”</p><p>研究人员 <a href=\"https://github.com/V4bel/NoisyTCP#abstract\">表示</a>：“要触发该漏洞，陈旧的 ehash 查找与现有请求套接字的释放和重新分配必须同时发生在不同的 RX 上下文中。必须利用 IPv4 分片与常规 TCP 数据包之间的接收哈希差异来分散数据包处理，这样就可以针对拥有两个或更多 RX 队列的服务器，或 RPS 将数据包分发到多个 CPU 的服务器触发该漏洞。”</p><p>尽管 CVE-2026-99288 的补丁 <a href=\"https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git/commit/?id=4e2b3ef19e0e04adca38442f07dd6bc93c712bf1\">已经发布</a>，且<a href=\"https://security-tracker.debian.org/tracker/CVE-2026-99288#:~:text=Vulnerable%20and%20fixed%20packages\">修复已在两周前合并</a>到 Linux 内核主线分支中，但研究人员建议，对于无法立即应用补丁或升级的人，应禁用 SYN cookie（这 unfortunately 会降低抵御 SYN 洪泛攻击的保护能力），并将串行化到单个 RX 队列，以阻止成功利用所需的竞态条件。</p><p>今年 5 月，Kim 还披露了 <a href=\"https://www.bleepingcomputer.com/news/security/new-linux-dirty-frag-zero-day-with-poc-exploit-gives-root-privileges/\">Dirty Frag</a>，这是一个 Linux 本地权限提升漏洞，它将 RxRPC（<a href=\"http://nvd.nist.gov/vuln/detail/CVE-2026-43500\">CVE-2026-43500</a>）和 xfrm-ESP（<a href=\"https://nvd.nist.gov/vuln/detail/CVE-2026-43284\">CVE-2026-43284</a>）的页缓存写入漏洞串联起来，从而在包括 Ubuntu、Red Hat Enterprise Linux、CentOS Stream 和 Fedora 在内的主要发行版上获取 root 权限。</p><p>最近，即 7 月，他还披露了 <a href=\"https://www.bleepingcomputer.com/news/linux/new-januscape-linux-kernel-flaw-allows-vm-escape-on-intel-amd-devices/\">Januscape</a>，这是一个已有 16 年历史的 Linux 内核漏洞，可使攻击者逃离虚拟机并在主机上运行任意代码。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/1b401792bec0725c.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现您现有的防御可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体会分析电子邮件的意图、上下文和行为，以发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>对 Microsoft 365 或 Google Workspace 进行为期 14 天的只读扫描，看看有哪些威胁正在穿透，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始您的免费电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","漏洞","补丁","复现","内核","网络设备","Red Hat","Ubuntu","Debian","https://www.bleepingcomputer.com/news/linux/new-noisytcp-linux-kernel-flaw-lets-attackers-crash-servers/","BleepingComputer",{"_100":101,"_102":-5},"changelogVersion","2026-10-01T08:00","release"]
