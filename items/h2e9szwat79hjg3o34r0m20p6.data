[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1793621936000,"id","h2e9szwat79hjg3o34r0m20p6","title","Eclypsium InfraTrust 报告称多款网络设备漏洞已被利用","originalTitle","InfraTrust report warns of exploited flaws in critical network infrastructure","summary","Eclypsium 的 InfraTrust 报告称，Citrix NetScaler、Ivanti Connect Secure、Check Point、Cisco、Arista、Fortinet、F5 和 PAN-OS 产品中的多项漏洞已被真实利用，其中16项新增公告涉及 CISA KEV 目录漏洞。","reason","报告汇总多起已被真实利用的网络设备漏洞，并指出设备内置 PHP 导致管理员难以自行修补，适合用于识别企业边界暴露风险与处置优先级。","source",{"_66":96},"links",{"_87":95},"publishedAt","2026-10-28T14:00:00.000Z","discoveredAt","2026-10-28T14:07:42.618Z","timelineAt","category","vuln","tags",[67,91,92,70,93,94],"score",82,"selected",true,"channel","news","story","x","readingMode","full","author","Lawrence Abrams","body",{"_59":86,"_87":-5,"_88":89,"_90":37},"outline",[73,74,75],"relatedStories",[],"topics",[60,61,62,63],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_64":71,"_66":72},{"_64":69,"_66":70},{"_64":31,"_66":68},{"_64":65,"_66":67},"slug","exploited","name","在野利用","漏洞披露","vuln-mgmt","漏洞管理","supply-chain","供应链安全",{"_11":84,"_77":85,"_79":80},{"_11":81,"_77":82,"_79":83},{"_11":76,"_77":78,"_79":80},"sec-3","text","攻击者一旦拥有有效凭据，其操作仅有 37% 会被阻止","level",2,"sec-2","php2shell 暴露了另一个问题",3,"sec-1","关键基础设施正遭到攻击","<p><img alt=\"InfraTrust\" height=\"900\" src=\"/dailyinfo/media/8a5ef3e208ae6a6d.jpg\" srcset=\"/dailyinfo/media/17cacc07138b3696.jpg 720w, /dailyinfo/media/78a5df5ebc5fc314.jpg 1200w, /dailyinfo/media/8a5ef3e208ae6a6d.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>攻击者正在积极利用关键网络基础设施中的漏洞，而被称为“PHP2Shell”的 PHP 漏洞使防火墙、VPN、应用交付控制器及其他设备的 Web 管理接口面临风险。</p><p>这些发现来自 <a href=\"https://pulse.infra-trust.org/october-2026\">Eclypsium 的 10 月 InfraTrust Pulse</a>，这是一份每月发布的报告，用于追踪影响网络设备、服务器、固件、芯片及其他基础设施的安全公告。</p><p>9 月 18 日至 10 月 14 日期间，InfraTrust 追踪了 18 家供应商新发布的 133 条安全公告，涉及 2,813 个漏洞。</p><p>其中 37 条公告被评为严重，5 条的最高 CVSS 分数为 10.0，另有 58 个漏洞可在无需认证的情况下远程利用。</p><p>新发布的公告中有 16 条所涉漏洞已被列入 <a href=\"https://www.cisa.gov/known-exploited-vulnerabilities-catalog\">CISA 的已知被利用漏洞目录</a>（KEV），并正在遭到积极利用。</p><p>报告还警告称，许多网络设备（包括防火墙、VPN 网关、应用交付控制器和网络附加存储设备）都将其管理接口嵌入 PHP。</p><p>由于供应商会将 PHP 编译进设备固件，客户通常无法自行安装近期的 PHP 安全更新，而必须等待各供应商发布更新后的固件。</p><p>因此，InfraTrust 建议管理员在等待 PHP2Shell 补丁期间，确保基于 PHP 的管理接口未暴露在互联网上。</p><h2 id=\"sec-1\">关键基础设施正遭到攻击</h2><p>一些最严重的漏洞影响位于企业网络边缘的系统，或用于管理其他基础设施的系统。</p><p>威胁行为者之所以针对这些设备，是因为它们可以提供进入企业环境的初始访问权限，或充当进一步攻击的跳板。</p><p>InfraTrust 重点列出的正在遭到积极利用的漏洞包括：</p><ul>\n\t<li><strong>Citrix NetScaler ADC 和 Gateway：</strong>CVE-2026-88771 和 CVE-2026-88772 于 <a href=\"https://www.bleepingcomputer.com/news/security/citrix-admins-warned-to-shut-down-netscalers-over-2-exploited-zero-days/\">9 月 27 日披露</a>，此前已观察到针对未打补丁设备的攻击。另一个影响配置为 SAML 的设备的 <a href=\"https://www.bleepingcomputer.com/news/security/citrix-patches-netscaler-saml-zero-day-exploited-in-attacks/\">NetScaler 漏洞</a> CVE-2026-88779，也是在检测到利用活动后被加入 CISA 的 KEV 目录。</li>\n\t<li><strong>Ivanti Connect Secure：</strong>CVE-2026-104935 允许未经认证的远程攻击者在存在漏洞的 VPN 网关上执行任意命令。Ivanti 表示，在发布安全公告时，其已<a href=\"https://www.bleepingcomputer.com/news/security/ivanti-warns-of-connect-secure-zero-day-exploited-in-attacks/\">利用了数量有限的一些客户系统</a>。CISA 随后<a href=\"https://www.bleepingcomputer.com/news/security/cisa-warns-admins-to-immediately-fix-ivanti-flaw-exploited-as-zero-day/\">将其加入了 KEV</a>。</li>\n\t<li><strong>Check Point Security Management Server：</strong>CVE-2026-93616 允许未经认证的攻击者在管理和日志系统上上传并执行脚本。Check Point Research 于 9 月 12 日<a href=\"https://www.bleepingcomputer.com/news/security/check-point-patches-management-server-zero-day-exploited-in-attacks/\">观察到利用该漏洞的定向攻击</a>，目标是 Spark 客户。</li>\n\t<li><strong>Cisco Catalyst SD-WAN Manager：</strong>CVE-2026-76504 允许未经认证的攻击者绕过身份验证并获得管理 API 的管理员访问权限。Cisco 于 9 月获知<a href=\"https://www.bleepingcomputer.com/news/security/cisco-warns-of-new-sd-wan-authentication-bypass-zero-day-exploited-in-attacks/\">存在积极利用活动</a>。</li>\n\t<li><strong>Arista VeloCloud Orchestrator：</strong>CVE-2026-93952 是一个最高严重性漏洞，影响用于配置 SD-WAN Edge 设备的系统。Arista 表示<a href=\"https://www.bleepingcomputer.com/news/security/arista-patches-actively-exploited-velocloud-orchestrator-zero-day/\">该漏洞正遭到积极利用</a>，并于 10 月 22 日披露了同一产品中的第二个<a href=\"https://www.bleepingcomputer.com/news/security/arista-patches-new-velocloud-orchestrator-zero-day-exploited-in-attacks/\">独立且已遭利用的漏洞</a>（CVE-2026-114625）。</li>\n\t<li><strong>FortiMail</strong>：CVE-2026-104286 是一个严重的路径遍历漏洞，允许未经身份验证的攻击者通过 Web 界面写入任意文件。Fortinet <a href=\"https://www.bleepingcomputer.com/news/security/fortinet-warns-of-critical-fortimail-flaw-exploited-in-zero-day-attacks/\">确认该漏洞已被利用</a>进行攻击。</li>\n\t<li><strong>Cisco Secure Email Gateway：</strong>CVE-2026-76519 可能导致恶意电子邮件附件在存在漏洞的系统上造成任意文件写入，并以 root 身份执行命令。Cisco <a href=\"https://www.bleepingcomputer.com/news/security/cisco-patches-actively-exploited-secure-email-gateway-zero-day/\">于 10 月获悉存在利用活动。</a></li>\n\t<li><strong>F5 BIG-IP APM：</strong>CVE-2026-94127 是一个严重的堆溢出漏洞，可能允许在配置为 OAuth 授权服务器的系统上未经身份验证地远程执行代码。F5 表示该漏洞<a href=\"https://www.bleepingcomputer.com/news/security/f5-warns-of-big-ip-apm-remote-code-execution-zero-day-exploited-in-attacks/\">已被利用</a>。</li>\n\t<li><strong>PAN-OS 管理界面：</strong>Palo Alto Networks 报告称，攻击者<a href=\"https://www.bleepingcomputer.com/news/security/palo-alto-networks-warns-of-pan-os-rce-flaw-exploited-in-attacks/\">利用 CVE-2026-0322</a>对防火墙发动攻击，使具有网络访问权限且通过身份验证的管理员能够以 root 身份执行代码。</li>\n</ul><h3 id=\"sec-2\">php2shell 暴露了另一个问题</h3><p>InfraTrust 还警告称，最近披露的<a href=\"https://www.bleepingcomputer.com/news/security/php-ships-emergency-patches-for-critical-php2shell-flaws/\">PHP2Shell 漏洞</a>暴露了网络基础设施中的另一个薄弱环节，因为许多设备直接将 PHP 嵌入其管理界面。</p><p>这两个 PHP 漏洞 CVE-2026-109618 和 CVE-2026-109619 允许未经身份验证的远程代码执行，PHP 项目已于 10 月 21 日修复。</p><p>尽管针对这些漏洞的关注主要集中在使用 PHP 编写的网站和 Web 应用上，但 PHP 也用于防火墙、应用交付控制器、VPN 设备和网络附加存储设备的管理界面。</p><p>对于受影响的设备，管理员通常无法自行更新 PHP，因为厂商会直接将其编译到设备固件中。因此，客户必须等待各厂商重新构建并发布包含已修补 PHP 版本的更新固件或软件。</p><p>披露后不久，Palo Alto Networks、F5、NetScaler、Check Point 和 QNAP 均确认其部分产品受到影响，同时仍在为相关设备开发修复程序。</p><p>该报告还重点指出了基础设施厂商捆绑到其产品中的其他软件组件存在的类似问题。</p><p>CVE-2026-31431 是一个名为 <a href=\"https://www.bleepingcomputer.com/news/security/cisa-says-copy-fail-flaw-now-exploited-to-root-linux-systems/\">Copy Fail</a> 的 Linux 内核权限提升漏洞，如今已出现在八家厂商的 29 份安全公告中，高于上个月六家厂商的 19 份公告。</p><p>InfraTrust 还在捆绑组件中发现了较旧且已被利用的漏洞，包括影响 HP LaserJet Enterprise 打印机的 Android 内核漏洞，以及 Dell Data Lakehouse 软件中的 2020 年 jQuery 漏洞。</p><p>InfraTrust 建议管理员优先为 NetScaler 和 Ivanti Connect Secure 部署补丁，因为这些远程访问网关可能成为进入企业网络的门户。接下来，建议为面向互联网的设备安装 Fortinet 于 10 月 22 日发布的 FortiOS、FortiManager 和 FortiAnalyzer 安全更新。</p><p>报告随后建议重点关注 Check Point Security Management Server、Cisco Catalyst SD-WAN Manager、VeloCloud Orchestrator、FortiMail、Cisco Secure Email Gateway、受影响的 BIG-IP APM 系统以及 PAN-OS 管理界面。</p><p><a href=\"https://hubs.li/Q04sB3fb0\">\n            <img src=\"/dailyinfo/media/f74efd6d74a2d601.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-3\">\n            <a href=\"https://hubs.li/Q04sB3fb0\">攻击者一旦拥有有效凭据，其操作仅有 37% 会被阻止</a>\n        </h2><p>整体预防评分可能会掩盖初始访问之后发生的情况。一旦攻击者开始使用有效凭据，预防效果就会大幅下降。</p><p>《Blue Report 2026》通过在客户生产环境中运行的 338 million 次模拟，逐项衡量防御技术。</p><p><a href=\"https://hubs.li/Q04sB3fb0\">获取报告</a>\n    </p>","original","zhKind","translation","complete","漏洞","汇总","网络设备","供应链","https://www.bleepingcomputer.com/news/security/infratrust-report-warns-of-exploited-flaws-in-critical-network-infrastructure/","BleepingComputer",{"_98":99,"_100":-5},"changelogVersion","2026-10-01T08:00","release"]
