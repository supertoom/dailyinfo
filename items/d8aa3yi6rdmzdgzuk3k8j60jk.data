[{"_1":2,"_3":4},"root",{"_5":89},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795480833000,"id","d8aa3yi6rdmzdgzuk3k8j60jk","title","Chrome 158 for Android 发布稳定性与性能改进版本 158.0.8127.92","originalTitle","Chrome for Android Update","summary","Google 发布 Chrome 158 for Android 158.0.8127.92，未来数日将通过 Google Play 上架。本次更新包含稳定性和性能改进，Android 版本默认包含对应 Windows、Mac 与 Linux 桌面版本的安全修复，除非另有说明。","reason","source",{"_72":88},"links",{"_61":87},"publishedAt","2026-11-23T22:09:51.297Z","discoveredAt","2026-11-23T23:44:39.166Z","timelineAt","category","blue-team","tags",[84,85,73,86],"score",7,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","readingMode","full","author","Krishna Govind","body",{"_80":-5,"_61":81,"_82":-5,"_83":36},"outline",[],"relatedStories",[76],"topics",[68,69],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fYHfWSTLzm0Y","reportCount",1,"additionalSourceCount",0,{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","mobile","name","移动端","google","Google / 谷歌",{"_77":78,"_13":79},"publicId","48db8fc0-b429-4d46-b8af-e6c18af1276e","Chrome 158 Android 版连续发布","zh","<p>&nbsp;&nbsp;&nbsp;Hi, everyone! We've just released <b>Chrome 158 (158.0.8127.92)</b> for Android. It'll become <a href=\"https://play.google.com/store/apps/details?id=com.android.chrome\">available on Google Play</a> over the next few days.&nbsp;</p><p>This release includes stability and performance improvements. You can see a full list of the changes in the <a href=\"https://chromium.googlesource.com/chromium/src/+log/158.0.8127.42..158.0.8127.92?pretty=fuller&amp;n=10000\">Git log</a>. If you find a new issue, please let us know by <a href=\"https://code.google.com/p/chromium/issues/entry?template=Android%20Issue\">filing a bug</a>.</p><p>Android releases contain the same security fixes as their corresponding<a href=\"https://chromereleases.googleblog.com/2026/11/stable-channel-update-for-desktop_01734282054.html\"> Desktop releases</a> (Windows &amp; Mac: 158.0.8127.88 /.89 Linux: 158.0.8127.88 ) unless otherwise noted.</p><p>Krishna Govind</p><p><a href=\"https://www.google.com/chrome/\">Google Chrome</a></p>","zhKind","complete","版本更新","例行内容","Google","http://chromereleases.googleblog.com/2026/11/chrome-for-android-update_0411169060.html","Chrome Releases",{"_90":91,"_92":-5},"changelogVersion","2026-10-01T08:00","release"]
