[{"_1":2,"_3":4},"root",{"_5":105},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795740052000,"id","y2iujer012r6dlq4qwu6j4trf","title","无密码开放数据库暴露约 20 亿条凭据及会话令牌","originalTitle","Open database exposed 2 billion credential records, including session tokens","summary","Jeremiah Fowler 发现一个可在线访问且无密码、无加密的数据库，其中约有 20 亿条凭据记录、约 8471 个目录和 40 万份疑似由信息窃取木马收集的文档。","reason","该数据库不仅暴露账号凭据，还包含会话令牌、Cookie 与设备信息，能够展示信息窃取木马聚合数据后的潜在危害。","source",{"_74":104},"links",{"_96":103},"publishedAt","2026-11-25T10:44:20.000Z","discoveredAt","2026-11-25T11:17:38.337Z","timelineAt","category","activity","tags",[100,101,75,102],"score",79,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Deeba Ahmed","body",{"_61":95,"_96":-5,"_97":98,"_99":37},"outline",[86,87],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fCr9sNP_-dLE","reportCount",1,"additionalSourceCount",0,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","malware","name","恶意软件","black-market","数据窃取与黑产","ransomware","勒索软件","identity","身份与访问",{"_83":84,"_13":85},"publicId","ed82691d-1aaf-49f1-9d67-0cba6ea5aee2","约20亿条凭据数据库曾无密码开放",{"_11":93,"_89":94,"_91":92},{"_11":88,"_89":90,"_91":92},"sec-2","text","此次暴露的潜在危险","level",3,"sec-1","大规模凭证集合被曝光","<p>一个包含约 20 亿条凭证的数据库在无密码、无加密的情况下可在线访问，任何发现它的人都能轻松获取这一庞大的数据宝库。</p><p>网络安全研究人员 <a href=\"https://hackread.com/tag/Jeremiah-Fowler/\">Jeremiah Fowler</a> 发现了该数据库，称其疑似为某个犯罪市场或聚合操作的数据泄露，可能影响数百万个人、企业、组织和政府账户。相关发现由 ExpressVPN 发布，并与 Hackread.com 分享。</p><h3 id=\"sec-1\"><strong>大规模凭证集合被曝光</strong></h3><p>Fowler 称这是他职业生涯至今遇到的最大的凭证集合。它至少比他今年早些时候报道的<a href=\"https://hackread.com/logins-roblox-tiktok-netflix-crypto-wallets-found/\">1.49 亿条登录信息的泄露</a>大 13 倍。但这一次暴露的记录不只限于用户名和密码——该数据库还包含 cookies、会话令牌以及其他被盗信息。</p><p>据该研究人员所述，他发现了约 8,471 个文件夹，其中包含明文凭证和账户信息（有些甚至按 US、UK、FR、DE、ES 和 MX 等国家代码排列）。</p><figure><a href=\"https://hackread.com/wp-content/uploads/2026/11/Suspected-Criminal-Marketplace-Breach-Exposes-2-Billion-Credentials-1.png\"><img width=\"1024\" height=\"398\" src=\"/dailyinfo/media/00d78718fd9701e7.webp\" srcset=\"/dailyinfo/media/3b5c044e615f0783.webp 720w, /dailyinfo/media/b7ec6d70eebf3a42.webp 1200w, /dailyinfo/media/00d78718fd9701e7.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"\"></a><figcaption>数据在文件夹中的组织方式（来源：ExpressVPN/Jeremiah Fowler）</figcaption></figure><p>另外，Fowler 还发现了 400,000 份文件，可能由更高级的<a href=\"https://hackread.com/adrozek-malware-firefox-chrome-yandex-edge-browser/\">信息窃取木马</a>收集。这些文件主要包含浏览器数据、剪贴板内容、系统信息以及与加密货币相关的信息。</p><p>还发现了数千条与 Tor <code>.onion</code> 服务相关的凭证。这些包括可通过 Tor 网络访问的私密论坛、市场平台以及其他服务。此外，基于域名的搜索返回了超过 6.08 亿条 Gmail 记录、6,140 万条与 <code>.gov</code> 域名关联的条目，以及近 5,000 万条 <code>.org</code> 记录。Fowler 还报告称，发现了来自全球一些使用最广泛平台的记录，包括：</p><ul>\n<li>X：3,280 万</li>\n\n\n\n<li>Facebook：8,800 万</li>\n\n\n\n<li>Roblox：4,170 万</li>\n\n\n\n<li>Amazon：3,660 万</li>\n\n\n\n<li>Instagram：3,100 万</li>\n\n\n\n<li>Discord：2,070 万</li>\n\n\n\n<li>Google 服务：1.142 亿</li>\n\n\n\n<li>OpenAI 与 ChatGPT 合计：超过 220 万</li>\n</ul><figure><a href=\"https://hackread.com/wp-content/uploads/2026/11/Suspected-Criminal-Marketplace-Breach-Exposes-2-Billion-Credentials.png\"><img width=\"981\" height=\"1024\" src=\"/dailyinfo/media/3bff04b2929ea992.webp\" srcset=\"/dailyinfo/media/a3de09f4d174385e.webp 720w, /dailyinfo/media/bf68b7a630a12133.webp 1200w, /dailyinfo/media/3bff04b2929ea992.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"\"></a><figcaption>存在暴露数据的平台（来源：ExpressVPN/Jeremiah Fowler）</figcaption></figure><p>在那篇<a href=\"https://www.expressvpn.com/research/2billion-credentials-exposed\">博文</a>中，Fowler 澄清这些是数据库匹配项，而非确认的受害者或活跃账户，且这些记录可能重复，或被同一人在多个服务中使用。在 Fowler 报告后的数天内，托管服务商限制了访问。</p><h3 id=\"sec-2\"><strong>此次暴露的潜在危险</strong></h3><p>Fowler 怀疑某个犯罪市场遭到入侵；数据库所有者的身份仍不清楚。部分文件包含 Telegram 品牌标识以及针对特定地区投放的邮件列表广告，但 Fowler 无法确定该服务器属于犯罪数据掮客、转售商还是合法研究操作。</p><p>在此次发现中，尤为引人注目的是信息窃取木马能够从一台受感染设备中获取的海量信息。一个被盗密码可能就足以攻破一个账户，但浏览器会话、cookies 及其他保存数据的暴露令人担忧，因为它们可以为攻击者提供访问受害者在线账户的更多途径。</p><p>利用如此大量的信息，攻击者可以轻松访问多个账户，甚至无需费事感染设备就能获取用于进一步攻击的材料。</p><p>“这一份更进一步，其中的会话令牌、cookies 和设备数据给了攻击者比单纯密码更多的入侵途径，”Fowler 解释道：</p><p>掌握了如此大量的信息后，攻击者可以轻易访问多个账户，甚至无需再次感染设备就能获取用于进一步攻击的资料。</p>","original","zhKind","translation","complete","数据泄露","凭据","数据窃取","https://hackread.com/database-exposed-credential-records-session-tokens/","Hackread",{"_106":107,"_108":-5},"changelogVersion","2026-10-01T08:00","release"]
