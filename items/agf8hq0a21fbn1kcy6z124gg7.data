[{"_1":2,"_3":4},"root",{"_5":110},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795048829000,"id","agf8hq0a21fbn1kcy6z124gg7","title","Coinbase 拦截利用 Elon Musk 深度伪造直播的 470 万美元加密货币转账","originalTitle","Coinbase blocks $4.7 million in transfers to Elon Musk deepfake scam","summary","Coinbase 称，其 AI 反欺诈系统拦截了一轮利用 Tesla 飞行汽车演示的假 YouTube 直播骗局，直播中的 AI 深度伪造画面冒充 Elon Musk 承诺将加密货币翻倍，吸引了超过 500,000 名观众。","reason","source",{"_76":109},"links",{"_61":108},"publishedAt","2026-11-18T20:49:32.000Z","discoveredAt","2026-11-18T21:23:32.876Z","timelineAt","category","activity","tags",[81,79,105,106,107],"score",62,"selected",false,"channel","news","story",{"_89":90,"_13":91},"x","readingMode","full","author","Lawrence Abrams","body",{"_101":-5,"_61":102,"_103":-5,"_104":36},"outline",[92,93],"relatedStories",[88],"topics",[68,69,70,71,72,73],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fWJXWwe8dz4E","reportCount",1,"additionalSourceCount",0,{"_74":86,"_76":87},{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","blue-team","name","蓝队与运营","ai-security","AI 安全","attack","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","crypto","密码学",{"_89":90,"_13":91},"publicId","539e236d-3e9d-4cc3-8b40-c49b5b8737d8","Coinbase拦截马斯克深度伪造转账骗局",{"_11":99,"_95":100,"_97":98},{"_11":94,"_95":96,"_97":98},"sec-2","text","Uncover email threats your existing defenses may miss.","level",2,"sec-1","AI agents intervene to stop transfers","zh","<p><img alt=\"Elon Musk\" height=\"900\" src=\"/dailyinfo/media/4f269c2302316928.jpg\" srcset=\"/dailyinfo/media/75b2ea1654c25f32.jpg 720w, /dailyinfo/media/f123971a8e60c119.jpg 1200w, /dailyinfo/media/4f269c2302316928.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>Coinbase says it blocked $4.7 million in cryptocurrency transfers to scammers promoting a fake giveaway using an AI-generated deepfake of Elon Musk during a Tesla livestream that attracted more than 500,000 viewers.</p><p>The deepfake took place during Tesla's \"flying car\" demonstration, when scammers created a fake YouTube livestream that appeared to broadcast the event.</p><p>The fraudulent stream featured an AI-generated video of Musk, cryptocurrency wallet addresses, and a QR code, promising viewers that any cryptocurrency they sent would be doubled.</p><p><a href=\"https://www.wiz.io/lp/claude-code-security-best-practices-cheat-sheet?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q3_INB_FORM_Claude-Code-Security-Best-Practices&amp;sfcid=701Vh00000gJQZuIAO&amp;utm_term=FY27Q4-bleepingcomputer-article-970x250-Nov&amp;utm_content=Claude-Code-Best-Practices\"><img src=\"/dailyinfo/media/db5325b9d2ed1bcc.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>According to Coinbase, hundreds of its customers attempted to send millions of dollars to the scammers over about two hours, including many longtime users of the exchange.</p><p>However, the company says its AI-powered fraud-prevention systems detected the scam and blocked about 91% of the attempted transfers, totaling $4.7 million.</p><p>Unlike traditional cryptocurrency theft involving compromised accounts or stolen credentials, victims in this campaign voluntarily made the crypto transfer after believing the livestream was real.</p><p>Coinbase explained that this makes scams like these difficult to detect because the transactions are created and approved by legitimate account holders.</p><p>\"Most fraud defenses are built to spot activity the customer didn't authorize,\" <a href=\"https://www.coinbase.com/blog/consumer-protection-tuesday-how-we-leveraged-ai-to-stop-a-popular-tesla-scam\">Coinbase explained</a>.</p><p>\"That's not what happened here. The customer was logged in, the customer pressed confirm, and the customer believed it was the opportunity of a lifetime.\"</p><h2 id=\"sec-1\">AI agents intervene to stop transfers</h2><p>Coinbase says its scam prevention system uses machine learning models to analyze outgoing cryptocurrency transfers in real time, identifying suspicious activity associated with giveaway scams, brand impersonation, and newly created wallet addresses.</p><p>When a suspicious transfer is detected, an AI agent engages the customer in a short conversation, explaining the characteristics of the suspected scam and asking questions intended to help them recognize the fraud.</p><p>The system also assigns confidence scores to the agent's responses before presenting them to customers, allowing it to determine when additional safeguards may be necessary.</p><p>Coinbase says its AI agent had never encountered this particular campaign before but recognized the underlying scam techniques, including promises to multiply cryptocurrency, time pressure tied to a live event, and irreversible transfers.</p><p>The company claims the entire detection and intervention process operated automatically, without human involvement.</p><p>\"What's notable is that the agent had never seen this scam. Deepfake giveaways tied to a live product launch weren't in its training,\" Coinbase said.</p><p>BleepingComputer contacted Coinbase to ask how many transfers reached the scammers and how much cryptocurrency was stolen, but has not yet received a response.</p><p>Elon Musk and his companies have long been popular lures for cryptocurrency scams, with fraudsters <a href=\"https://www.bleepingcomputer.com/news/security/verified-twitter-accounts-hacked-in-580k-elon-musk-crypto-scam/\">hijacking verified Twitter accounts</a>, <a href=\"https://www.bleepingcomputer.com/news/security/new-elon-musk-club-crypto-giveaway-scam-promoted-via-email/\">sending fake giveaway invitations via email</a>, and <a href=\"https://www.bleepingcomputer.com/news/security/tiktok-flooded-by-elon-musk-cryptocurrency-giveaway-scams/\">flooding TikTok with fraudulent promotions</a>.</p><p>Scammers have also <a href=\"https://www.bleepingcomputer.com/news/security/elon-musk-deep-fakes-promote-new-bitvex-cryptocurrency-scam/\">used deepfake videos of Musk</a> to promote fraudulent cryptocurrency investment platforms, while a separate campaign involving compromised verified Twitter accounts stole more than $580,000 in cryptocurrency in just one week.</p><p>To avoid falling victim to these types of scam campaigns, users should independently verify cryptocurrency promotions through official websites and social media accounts rather than trusting livestreams or QR codes displayed in videos.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/2873ab279056c37c.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-2\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Uncover email threats your existing defenses may miss.</a>\n        </h2><p>Adaptive Security's AI agents analyze email intent, context, and behavior to uncover phishing, business email compromise, and invoice fraud.</p><p>See what's getting through with a 14-day read-only scan of Microsoft 365 or Google Workspace, with no MX changes.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Start your free email security scan.</a>\n    </p>","zhKind","complete","加密","数据窃取","蓝队","https://www.bleepingcomputer.com/news/security/coinbase-blocks-47-million-in-transfers-to-elon-musk-deepfake-scam/","BleepingComputer",{"_111":112,"_113":-5},"changelogVersion","2026-10-01T08:00","release"]
