[{"_1":2,"_3":4},"root",{"_5":107},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1793621625000,"id","nt6wx0jb7kc38cwds0lzgar2l","title","Chainalysis 遭外部攻击者入侵，部分客户身份信息被访问","originalTitle","Chainalysis breached using “offensive agentic techniques”","summary","区块链分析公司 Chainalysis 表示，外部攻击者在 10 月使用“offensive agentic techniques”入侵其系统和内部工具，导致部分客户 ID、姓名、邮箱地址及组织角色标签被访问；目前未发现调查图表、笔记、案件、交易或查询结果、明文密码、MFA 密钥及用户会话令牌遭未授权访问，此次事件与近期 Binance 入侵无关。","reason","source",{"_74":106},"links",{"_61":105},"publishedAt","2026-11-02T11:40:19.000Z","discoveredAt","2026-11-02T11:44:32.069Z","timelineAt","category","activity","tags",[77,102,75,103,104,79],"score",66,"selected",false,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Zeljka Zorz","body",{"_98":-5,"_61":99,"_100":-5,"_101":36},"outline",[86,87,88],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fxhNzzYj4hPo","reportCount",5,"additionalSourceCount",4,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","ai-security","name","AI 安全","attack","攻击活动","incident","应急响应","identity","身份与访问",{"_83":84,"_13":85},"publicId","038a18c5-a6fe-4fe6-89fe-22bf5ade225b","Chainalysis确认智能体化入侵事件",{"_11":96,"_90":97,"_92":93},{"_11":94,"_90":95,"_92":93},{"_11":89,"_90":91,"_92":93},"sec-3","text","Chainalysis’ response","level",3,"sec-2","A key player in crypto crime investigations","sec-1","What was accessed?","zh","<p>Blockchain analytics firm Chainalysis has suffered a cybersecurity incident that led to a data breach.</p><p><img src=\"/dailyinfo/media/695ea7c2253662e8.webp\" loading=\"lazy\" decoding=\"async\" alt=\"OPIS\" title=\"Chainalysis\"></p><p>According to the company’s Friday announcement, the incident is unrelated to the recent Binance hack.</p><h3 id=\"sec-1\">What was accessed?</h3><p>In October, the company detected external attackers using “offensive agentic techniques” to gain access to Chainalysis systems and internal tools.</p><p>“Based on the evidence available to date, we have found no indication that these incidents resulted in the unauthorized access of investigation content (such as graphs, notes, or cases), transaction or query results, passwords in clear text, MFA secrets, or user session tokens,” Chainalysis <a href=\"https://www.chainalysis.com/blog/security-incident-october-30/\">stated</a>.</p><p>However, the attackers managed to access some customer (user) IDs, full names, email addresses, and organization role labels for users provisioned on the company’s platform.</p><p>Chainalysis did not elaborate further on the offensive agentic techniques used by the attackers.</p><h3 id=\"sec-2\">A key player in crypto crime investigations</h3><p>Because blockchains like Bitcoin record every transaction publicly (but pseudonymously), Chainalysis clusters addresses, links them to real-world entities such as exchanges, darknet markets, or sanctioned groups, and flags risky flows.</p><p>The company has been involved in investigating the money flows following the massive <a href=\"https://www.helpnetsecurity.com/2026/10/30/binance-crypto-hack/\">Binance</a> hack last week, which has been <a href=\"https://www.helpnetsecurity.com/2026/11/02/fbi-north-korea-binance-hack/\">attributed to</a> the North Korean cybercrime group TraderTraitor.</p><p>“Our investigators are observing never-seen-before laundering patterns with the stolen funds from the Binance exploit,” Chainalysis <a href=\"https://www.chainalysis.com/blog/binance-exploit-latest-findings-and-response/\">shared</a>. </p><p>“Thousands of transactions in a short period suggest that the attackers are using automation to obscure the trail of funds. Rather than simply moving funds onward, they repeatedly circulate them among addresses, often sending funds back to addresses involved earlier in the sequence.”</p><h3 id=\"sec-3\">Chainalysis’ response</h3><p>Chainalysis sent out an email alert to impacted customers, urging them to be on the lookout for unexpected password reset requests or authentication prompts. The company also advised them to enable two-factor authentication on their accounts (if they haven’t already).</p><p>Among its customers are crypto exchanges and banks, as well as law enforcement and government agencies around the world. Unauthorized access to customers’ names and contact information puts them at heightened risk of social engineering attacks.</p><p>Third-party cybersecurity experts have been called in to help with the investigation and to review the security of Chainalysis’ platform, discover vulnerabilities and, in general, strengthen the company’s defenses.</p><p>“We are in the process of determining the records for your organization that were accessed and will provide a detailed breakdown as soon as that analysis is complete,” it told affected customers.</p><p><img src=\"/dailyinfo/media/93223e2e45672130.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong>Subscribe to our breaking news e-mail alert to never miss out on the latest breaches, vulnerabilities and cybersecurity threats. <a href=\"https://www.helpnetsecurity.com/newsletter/\">Subscribe here!</a></strong></p><p><img src=\"/dailyinfo/media/93223e2e45672130.webp\" loading=\"lazy\" decoding=\"async\"></p>","zhKind","complete","数据泄露","Agent 安全","凭据","https://www.helpnetsecurity.com/2026/11/02/chainalysis-breached-using-offensive-agentic-techniques/","Help Net Security",{"_108":109,"_110":-5},"changelogVersion","2026-10-01T08:00","release"]
