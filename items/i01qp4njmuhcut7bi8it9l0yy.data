[{"_1":2,"_3":4},"root",{"_5":101},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":60,"_61":62},"expiresAt",1794185102000,"id","i01qp4njmuhcut7bi8it9l0yy","title","Veeam 披露 Software Appliance 在 AMD EPYC 主机上的启动失败问题","originalTitle","Veeam warns of Software Appliance boot failures on AMD EPYC hosts","summary","Veeam 警告 Software Appliance 13.1 及更高版本在部分 AMD EPYC 主机上可能启动失败并触发 kernel panic，原因是在 FIPS 模式下进行 jitterentropy 健康测试时偶发失败，受影响处理器包括 AMD EPYC 7262、7302 和 7F72。","reason","公告明确列出受影响处理器、Veeam Software Appliance 版本和可用规避方案，便于管理员判断受影响范围并采取处置。","source",{"_73":100},"links",{"_62":99},"publishedAt","2026-11-06T15:25:31.000Z","discoveredAt","2026-11-06T21:32:28.482Z","timelineAt","category","vuln","tags",[96,97,98,76],"score",73,"selected",true,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","Sergiu Gatlan","body",{"_92":-5,"_62":93,"_94":-5,"_95":60},"outline",[83,84],"relatedStories",[79],"topics",[69,70,71],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation",false,"bodyLanguage","original","factId","f8kEtCGFaPqk","reportCount",1,"additionalSourceCount",0,{"_72":77,"_73":78},{"_72":75,"_73":76},{"_72":31,"_73":74},"slug","name","漏洞披露","vuln-mgmt","漏洞管理","kernel","内核与系统",{"_80":81,"_13":82},"publicId","8fc317b4-76cb-45f1-83dc-c01173a0d337","Veeam披露软件设备启动失败问题",{"_11":90,"_86":91,"_88":89},{"_11":85,"_86":87,"_88":89},"sec-2","text","Uncover email threats your existing defenses may miss.","level",2,"sec-1","Mitigation available","zh","<p><img alt=\"Veeam\" height=\"900\" src=\"/dailyinfo/media/e5c92d6c178a6d15.jpg\" srcset=\"/dailyinfo/media/581585bd50d223c3.jpg 720w, /dailyinfo/media/5e53ac58842349be.jpg 1200w, /dailyinfo/media/e5c92d6c178a6d15.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>​Veeam warned customers about boot failures affecting Software Appliance virtual machines (VMs) on hosts with AMD EPYC processors.</p><p>The company's Software Appliance VMs are pre-configured, Linux-based virtual machines that let admins run the Veeam Backup &amp; Replication backup software suite on Linux devices without manually installing dependencies or configuring the software.</p><p>To comply with corporate and government security frameworks, the underlying Linux kernel runs integrated health and cryptographic checks (such as jitterentropy health tests) in FIPS mode during early boot.</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/92235cbd221a113a.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>However, as the company explained in a Wednesday advisory, these VMs will fail to boot and will crash with a kernel panic after failing an early-boot FIPS-mode jitterentropy check on some AMD EPYC processors.</p><p>\"A Veeam Software Appliance (Linux-based Veeam Backup &amp; Replication) virtual machine running on a host with an AMD EPYC processor intermittently fails to boot after a reboot, including a reboot that follows an update that installs a new kernel,\" <a href=\"https://www.veeam.com/kb4960\">it said</a>.</p><p>\"This issue occurs because the Linux kernel used by the Veeam Software Appliance runs a jitterentropy health test in FIPS mode during early boot, and the test intermittently fails on certain AMD EPYC processors, including AMD EPYC 7262, 7302, and 7F72. When the test fails, the kernel stops the boot process with a kernel panic.\"</p><p>This known issue originates in the Linux kernel version used by the Veeam Software Appliance and affects Veeam Software Appliance version 13.1 and later.</p><p>According to Veeam, users are seeing \"Kernel panic - not syncing: jitterentropy: Initialization failed with host not compliant with requirements: 9\" kernel panic errors on impacted systems.</p><h2 id=\"sec-1\">Mitigation available</h2><p>To mitigate this issue, Veeam told IT administrators to redeploy the appliance to a Linux host with a different processor.</p><p>If the appliance cannot be redeployed on a system with an unaffected processor, IT admins are advised to disable automatic updates for the appliance and install updates manually (while monitoring the VM as it reboots).</p><p>\"If the kernel panic occurs, power off the virtual machine and power it on again. A restart of the guest operating system does not recover the virtual machine,\" Veeam added. \"After the appliance has booted successfully, no further errors are expected, and the operation of Veeam Backup &amp; Replication is not affected.\"</p><p>Earlier today, Veeam <a href=\"https://www.veeam.com/kb4966\">also said</a>&nbsp;that some of its products are <a href=\"https://www.bleepingcomputer.com/news/security/critical-linux-kernel-flaw-allows-remote-root-attacks-on-mptcp-servers/\">affected by a critical Linux kernel vulnerability (CVE-2026-98432)</a> in the IPv4 TCP networking code that allows remote unauthenticated attackers to execute commands as root on servers running Multipath TCP (MPTCP) listeners.</p><p>The company has fixed the CVE-2026-98432 flaw for some impacted Veeam components and is now pushing the patched kernel to affected systems either as a private fix or through the Veeam Updater.</p><p>Veeam's products are used by more than 550,000 customers, including 74% of Global 2,000 firms and 82% of Fortune 500 companies.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/03f545515f18a71f.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-2\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Uncover email threats your existing defenses may miss.</a>\n        </h2><p>Adaptive Security's AI agents analyze email intent, context, and behavior to uncover phishing, business email compromise, and invoice fraud.</p><p>See what's getting through with a 14-day read-only scan of Microsoft 365 or Google Workspace, with no MX changes.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Start your free email security scan.</a>\n    </p>","zhKind","complete","漏洞","补丁","内核","https://www.bleepingcomputer.com/news/security/veeam-software-appliance-vms-fail-to-boot-on-amd-epyc-hosts/","BleepingComputer",{"_102":103,"_104":-5},"changelogVersion","2026-10-01T08:00","release"]
