[{"_1":2,"_3":4},"root",{"_5":109},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1794530483000,"id","dnizr3695w14lqcfb6u5a5r5e","title","3AM 勒索软件入侵英国 47 套学校系统，加密约 37 台设备","originalTitle","3AM Ransomware Hits 37 UK School Systems in Suspected AI-Assisted Attack","summary","Bitdefender 调查称，3AM 勒索软件附属成员入侵英国一套包含 47 套系统、跨多个 Active Directory 域的学校环境，并加密约 37 台设备。","reason","source",{"_76":108},"links",{"_99":107},"publishedAt","2026-11-03T16:10:42.000Z","discoveredAt","2026-11-03T16:14:22.817Z","timelineAt","category","activity","tags",[81,105,79,83,106],"score",71,"selected",true,"channel","news","story",{"_87":88,"_13":89},"x","sameEvent",{"_11":103,"_13":104},"readingMode","full","author","Deeba Ahmed","body",{"_62":98,"_99":-5,"_100":101,"_102":36},"outline",[90,91],"relatedStories",[86],"topics",[69,70,71,72,73],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","f8JS2zAe24Fg","reportCount",3,"additionalSourceCount",2,{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","research","name","技术研究","malware","恶意软件","attack","攻击活动","ai-offense","AI 攻防","ransomware","勒索软件",{"_87":88,"_13":89},"publicId","4051538f-0f4b-42bd-b302-ff00afa0e403","3AM勒索软件加密英国学校37台设备",{"_11":96,"_93":97,"_95":66},{"_11":92,"_93":94,"_95":66},"sec-2","text","域信任与勒索软件部署","level","sec-1","人工决策、自动重试","<p>网络安全公司 <a href=\"https://hackread.com/tag/Bitdefender/\">Bitdefender</a> 调查了一起据其所信是欧洲首起涉及人工操作员以及疑似由 AI 驱动的命令重试的勒索软件事件。</p><p>在 Hackread.com 提前获知的共享研究中，这家网络安全公司详细介绍了一个 3AM (ThreeAM) 勒索软件附属组织如何入侵一所 <a href=\"https://hackread.com/tag/UK/\">英国</a> 学校的系统环境；该环境包含横跨不同 Active Directory 域的 47 台系统，攻击者加密了约 37 台计算机。</p><figure><a href=\"https://hackread.com/wp-content/uploads/2026/11/3am-ransomware-group-uk-schools.png\"><img width=\"1024\" height=\"421\" src=\"/dailyinfo/media/0c209d7321d0dcff.webp\" srcset=\"/dailyinfo/media/74c2773bf890b277.webp 720w, /dailyinfo/media/2f7008fa114363db.webp 1200w, /dailyinfo/media/0c209d7321d0dcff.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"\"></a><figcaption>3AM 勒索软件组织的暗网泄露网站</figcaption></figure><h3 id=\"sec-1\"><strong>人工决策、自动重试</strong></h3><p>在今天发布的 <a href=\"https://businessinsights.bitdefender.com/3am-ransomware-hybrid-ai-attack\">博客文章</a> 中，Bitdefender 将此次入侵描述为“一种混合行动：部分环节显示有人在键盘前操作，而另一些环节则表现得像智能体循环。”这个疑似循环会将命令执行结果反馈给语言模型，随后由模型建议替代命令。</p><p>时间线支持这一判断：关键步骤相隔数分钟，而失败命令每隔 40 至 101 秒重试一次。不过，Bitdefender 无法确认究竟是模型在自动运行该循环，还是操作员在终端与 <a href=\"https://hackread.com/from-rules-to-ai-and-back/\">AI</a> 工具之间复制命令和结果。</p><figure><a href=\"https://hackread.com/wp-content/uploads/2026/11/AI-Assisted-3AM-Ransomware-Attack-Encrypted-37-Systems-Across-UK-School-Domains.png\"><img width=\"760\" height=\"838\" src=\"/dailyinfo/media/4d7a98a14b7c31ad.webp\" srcset=\"/dailyinfo/media/d2943dd7ebe10783.webp 720w, /dailyinfo/media/6bfc8d58cd261677.webp 1200w, /dailyinfo/media/4d7a98a14b7c31ad.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"\"></a><figcaption>攻击者如何使用 Windows 服务执行命令并获取结果。Bitdefender 无法确认下一条命令是由人员还是 AI 模型选择的。（来源：Bitdefender）</figcaption></figure><p>这一区别很重要。这并非一场经确认的自主勒索软件攻击。证据表明，在一个仍然依赖传统入侵技术的行动中，可能存在 <a href=\"https://hackread.com/ai-assistants-evolution-navigate-software-development/\">AI 辅助</a>。</p><p>该附属组织主要使用 <a href=\"https://hackread.com/bitter-apt-fake-diplomatic-documents-paprat-spyware/\">就地取材</a> 技术，依赖 PowerShell、WMI、netsh、reg 和 rundll32 等 Windows 工具。它还使用了公开工具，包括 <a href=\"https://hackread.com/?s=Mimikatz\">Mimikatz</a> 和仿 Impacket 的远程执行工具，以及 3AM 加密器。正如 Bitdefender 所指出的，AI 赋能的攻击并不需要新型工具才能成功。</p><h3 id=\"sec-2\"><strong>域信任与勒索软件部署</strong></h3><p>攻击者于 9 月 10 日和 11 日使用脚本窃取备份凭据，这些脚本通过 Windows DPAPI 解密已存储的密码，并复制浏览器凭据。Mimikatz 于 9 月 12 日被下载，随后被重命名为 sysmon64.exe。9 月 14 日，攻击者转储注册表配置单元，并创建了名为 library 和 svc_bkpmon 的后门管理员账户。</p><p>9 月 15 日，来自财务共享目录的文件被暂存于 Windows 注册表值中，并通过一台用作命令与控制基础设施的未受管理计算机进行传输。</p><p>9 月 18 日，攻击者使用 dnscmd 创建 DNS 条件转发器，随后使用 netdom 在不同域之间建立双向信任。包括 wb_probe 在内的诊断脚本运行了信任验证命令，但 Bitdefender 无法确定这些探测返回了什么。当天稍晚，Netlogon 被重启。一个计划执行的 PowerShell 任务随后将后门账户的访问权限推送到约 40 台计算机。</p><p>次日，卸载 Sophos 和 Bitdefender 终端保护软件的尝试被防篡改控制阻止。攻击者先部署了一个脚本加载器，然后运行基于 Rust 的 3AM 加密器，加密了约 37 台系统，并使用 wbadmin 删除了系统状态备份。</p><figure><a href=\"https://hackread.com/wp-content/uploads/2026/11/AI-Assisted-3AM-Ransomware-Attack-Encrypted-37-Systems-Across-UK-School-Domains-2.png\"><img width=\"1024\" height=\"438\" src=\"/dailyinfo/media/89c035ce4ac93966.webp\" srcset=\"/dailyinfo/media/5a90fd78a3a3d13c.webp 720w, /dailyinfo/media/e7f2a67b6e535521.webp 1200w, /dailyinfo/media/89c035ce4ac93966.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"\"></a><figcaption>学校遭受攻击的时间线，涵盖从 2026 年 9 月凭据窃取到勒索软件部署的整个过程。所有时间均为 UTC。（来源：Bitdefender）</figcaption></figure><p>这些发现引发了一个对防御方而言非常现实的问题。即使 AI 帮助排查了此次攻击，损害仍是通过涉及凭据、域信任和备份保护的常见薄弱环节造成的。Bitdefender 预计，<a href=\"https://hackread.com/gcore-radar-report-reveals-150-surge-in-ddos-attacks-year-on-year/\">混合攻击</a>到 2027 年将变得更加普遍。</p><p>研究人员建议，防御方应开始跨域隔离特权账户、监控新的域信任、保护备份基础设施，并确保每台机器都具备端点保护。</p>","original","zhKind","translation","complete","x9j4z55jekigpjvdnllbdvakx","3AM 勒索软件以人机混合战术入侵英国校网并加密 37 台机器","勒索","漏洞分析","https://hackread.com/3am-ransomware-uk-school-systems-ai-attack/","Hackread",{"_110":111,"_112":-5},"changelogVersion","2026-10-01T08:00","release"]
