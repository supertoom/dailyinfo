[{"_1":2,"_3":4},"root",{"_5":101},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794616828000,"id","es24au8p14acocvmeecd4pz0w","title","执法机构拆除 Gootloader 恶意软件与僵尸网络，涉及 25,000 台受感染计算机","originalTitle","Gootloader Malware Disrupted After Infecting 25,000 Computers","summary","国际执法行动已从 100 多台服务器移除 Gootloader，并查封用于投递和控制该恶意软件的美国域名，涉及全球至少 25,000 台受感染计算机。Gootloader 自 2018 年以来主要通过入侵的 WordPress 网站及其他网站传播，受害者被诱导下载后加入僵尸网络，运营者再向勒索团伙出售访问权限。","reason","材料梳理了 Gootloader 的感染链、载荷类型及执法拆除结果，可用于理解此类恶意软件如何接入勒索团伙并扩大影响。","source",{"_74":100},"links",{"_93":99},"publishedAt","2026-11-13T14:35:44.000Z","discoveredAt","2026-11-13T14:58:29.799Z","timelineAt","category","activity","tags",[75,97,98,77],"score",72,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Pierluigi Paganini","body",{"_61":92,"_93":-5,"_94":95,"_96":37},"outline",[86],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","frbTfRBA_Dl0","reportCount",1,"additionalSourceCount",0,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","malware","name","恶意软件","incident","应急响应","black-market","数据窃取与黑产","ransomware","勒索软件",{"_83":84,"_13":85},"publicId","758c9054-a51c-4bd3-8d48-45f2704d9c06","执法部门拆除Gootloader僵尸网络",{"_11":87,"_88":89,"_90":91},"sec-1","text","国际执法机构打击 Gootloader，查封域名并关闭了与 25,000 台感染计算机相关的 100 多台服务器。","level",2,"<h2 id=\"sec-1\">国际执法机构打击 Gootloader，查封域名并关闭了与 25,000 台感染计算机相关的 100 多台服务器。</h2><p>美国司法部宣布，执法机构已从 100 多台计算机服务器中清除 <a href=\"https://securityaffairs.com/tag/gootloader\">Gootloader</a> 恶意软件，查封了用于投放和控制该恶意软件的美国域名，并通知了全球各地的受害者。 </p><p><em>“美国司法部今天宣布，已成功从 100 多台计算机服务器（包括遭到入侵的 WordPress 网站）中清除名为“Gootloader”的恶意软件，并查封了犯罪分子用于投放和控制 Gootloader 恶意软件的美国域名。自 2018 年以来，Gootloader 恶意软件已感染全球至少 25,000 台计算机。”<a href=\"https://www.justice.gov/opa/pr/gootloader-malware-disrupted-international-cyber-operation\">美国司法部表示</a>。“Gootloader 恶意软件已被用于针对至少 44 名美国受害者的勒索软件攻击，造成约 28.8 million 美元损失。”</em></p><p>Gootloader 主要通过遭到入侵的 WordPress 网站和其他网站传播，受害者会被诱骗下载它，以为下载的是合法内容。计算机一旦感染，就会加入一个僵尸网络；Gootloader 的运营者随后将这些计算机的访问权限出售给勒索软件团伙。勒索软件团伙负责后续行动，仅美国受害者遭受的总损失就达到约 28.8 million 美元，涉及至少 44 名受害者，其中包括美国战争部和国防工业基地。</p><p>GootLoader 采用&nbsp;as-a-service&nbsp;模式，被不同团伙用于在遭入侵的系统上投放额外的恶意载荷。GootLoader 已知会使用无文件技术来投递威胁，例如&nbsp;<a href=\"https://securityaffairs.co/wordpress/108402/malware/uhnj-suncrypt-ransomware.html\">SunCrypt</a>、<a href=\"https://securityaffairs.co/wordpress/130811/cyber-crime/samples-new-revil-ransomware.html\">REvil</a>&nbsp;(Sodinokibi) 勒索软件、<a href=\"https://securityaffairs.co/wordpress/61669/cyber-crime/marcus-hutchins-kronos-trojan.html\">Kronos</a>&nbsp;木马和 Cobalt Strike。过去，GootLoader 曾以免费软件安装程序为伪装分发恶意软件，并利用法律文件诱骗用户下载这些文件。&nbsp;</p><p>GootLoader 是&nbsp;<a href=\"https://securityaffairs.com/140655/malware/gootkit-loader-targets-australia.html\">GootKit</a>&nbsp;恶意软件家族的一部分，该家族自 2014 年以来一直活跃。Mandiant 将 GootKit 背后的威胁行为者追踪为&nbsp;<a href=\"https://securityaffairs.com/141539/malware/gootloader-malware-evolution.html\">UNC2565</a>。</p><p>此次执法行动在法院授权下开展，并与针对恶意软件犯罪服务的多国执法行动 <a href=\"https://securityaffairs.com/tag/operation-endgame\">Operation Endgame</a> 协同进行。参与方包括德国联邦刑事警察局（BKA）、荷兰国家警察局、加拿大皇家骑警（RCMP）和渥太华警察局、丹麦警察、法国巴黎网络犯罪旅队、英国国家犯罪局、澳大利亚联邦警察和欧洲刑警组织。OpenAI、Fraunhofer FKIE、Shadowserver Foundation 和托管服务公司 Sharktech 也提供了技术协助。</p><p><em>“根据本周解封的令状，Gootloader 是一种通过多种方式感染受害者计算机的恶意软件，通常是诱骗毫无戒心的人下载。计算机一旦感染，就会被加入一个由其他受感染计算机组成的网络，该网络称为僵尸网络。”报告称。“Gootloader 背后的行为者利用该僵尸网络感染其他计算机，随后将后来遭感染的计算机访问权限出售给勒索软件行为者。”</em></p><p>Shadowserver Foundation 与互联网服务提供商及国家计算机安全响应团队合作，查找受感染机器、告知受害者发生了什么，并帮助他们清理感染。现在，访问任何被查封的域名时，看到的都是执法部门查封横幅，而不是恶意内容。此次调查由 Defense Criminal Investigative Service、FBI Denver Field Office 和 Army Criminal Investigative Division 牵头。</p><p><em>“拆除感染了全球超过 25,000 台系统的 Gootloader 恶意软件和僵尸网络，证明了统一、跨国执法行动的力量，”Department of the Army Criminal Investigation Division 主任 L. Scott Moreland 表示。“与我们遍布全球的合作伙伴一道，Army CID 致力于直接向网络犯罪分子宣战。虽然瓦解这些犯罪网络能够在勒索软件攻击扎根之前将其阻止，但真正的网络韧性依赖于全球执法行动与日常个人警惕的结合。”</em></p><p>自 2020 年以来，CCIPS 已确保对 220 多名网络犯罪和知识产权犯罪分子定罪，并获得法院命令，将超过 $500 million 返还给受害者。有关 Operation Endgame 的更多详情，请访问 <a href=\"http://www.operation-endgame.com/\">operation-endgame.com</a>。</p><p><strong>在 Twitter 上关注我：&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;以及&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;和&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a><strong></strong></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;黑客&nbsp;Gootloader)</strong></p>","original","zhKind","translation","complete","勒索","黑产","https://securityaffairs.com/202997/cyber-crime/gootloader-malware-disrupted-after-infecting-25000-computers.html","Security Affairs",{"_102":103,"_104":-5},"changelogVersion","2026-10-01T08:00","release"]
