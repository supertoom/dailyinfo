[{"_1":2,"_3":4},"root",{"_5":92},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795480842000,"id","rmgnd683wbglhec7jjtuj46wc","title","SplitSecure 发布基于秘密拆分的访问控制平台，整合 PAM、密码管理、MFA 与秘密保管功能","originalTitle","SplitSecure Launches New Access Control Architecture for Humans and AI Agents","summary","SplitSecure 发布基于秘密拆分的访问控制平台，旨在替代密码管理器、PAM 和 vault 等传统单一保管架构，支持 passkeys、一次性代码、SAML 2.0、SSH 证书、OpenPGP 与代码签名。","reason","source",{"_73":91},"links",{"_61":90},"publishedAt","2026-11-23T17:00:07.000Z","discoveredAt","2026-11-23T17:36:36.612Z","timelineAt","category","blue-team","tags",[87,78,88,89],"score",34,"selected",false,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","CyberNewswire","body",{"_83":-5,"_61":84,"_85":-5,"_86":36},"outline",[],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fMrt0wKO1XQE","reportCount",1,"additionalSourceCount",0,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","tools","name","工具与平台","crypto","密码学","identity","身份与访问",{"_80":81,"_13":82},"publicId","dfe920d2-9be5-45e2-b1fd-c8482c0c0929","SplitSecure发布秘密分割访问控制平台","zh","<p><span><strong>San Francisco, United States, November 23rd, 2026, CyberNewswire</strong></span></p><p><a href=\"https://www.splitsecure.com/\">SplitSecure</a>, the <a href=\"https://www.splitsecure.com/\">cybersecurity technology</a> provider, today unveiled a new access control platform based on secret splitting technology. The platform is intended to replace traditional access controls tools such as password managers, PAM, and vaults. On launch, it supports passwords, passkeys, one-time codes, SAML &amp; OIDC federation, SSH, x.509 CA, OpenPGP, code signing (Nitro, Google Chrome Extensions), and general secrets vaulting.</p><p>The platform is intended for secure organizations of all sizes, including both large enterprise plans and a <a href=\"https://www.splitsecure.com/pricing\">free plan</a> for teams of up to six.</p><p>The access control space today contains a wide variety of tools. A secure organization would typically require a password manager, MFA app, vault, certificate manager, and PAM, among other tools. But despite their variety, all these tools use a common architecture where clients’ secrets are stored in a singular “vault”. It is this architecture SplitSecure seeks to disrupt, with a new way of storing and using secrets based on secret-splitting.</p><p><img src=\"/dailyinfo/media/314d0b5e9e3b6cee.jpg\" loading=\"lazy\" decoding=\"async\">Secret splitting is the practice of breaking secrets across multiple devices rather than storing them in one location. This has been common practice in classified government environments for over thirty years but has historically been seen as high-effort and has had only limited adoption in industry. SplitSecure’s new platform is a significant advance of the state of the art, offering a ready-to-use implementation of techniques that were previously limited to advanced security teams in elite organizations.</p><p>Because of this general advancement, SplitSecure is able to replicate the functionality of many common tools. Its new platform provides password management, MFA, vaulting, certificate signing, and more PAM functionality such as shared accounts and resources. Supported resource types include passwords, passkeys, one-time codes, SAML 2.0 sign-ons, secrets, certificates, SSH certificates, signing keys, OpenPGP identities, and crypto wallets.</p><p>This new technology also offers the particular advantage that it cryptographically guarantees the service provider has no access to client’s secrets. This is in contrast to traditional PAM tools, in which the provider holds the “keys to the kingdom” at all times and a compromised vendor may be able to compromise client information.</p><blockquote><p><strong>Tristan Morris, CEO of SplitSecure, commented: </strong>“We were very ambitious  we wanted a tool where people didn’t have to trust us as the provider, whereby design they’re the custodians of their own secrets. But we also wanted it to be so easy to use you could imagine a non-technical person using it instead of a password manager. We’ve done that, and it’s amazing to see it launch.”</p></blockquote><blockquote><p>He also noted that SplitSecure’s new platform integrates with common identity providers for an easier transition. “It should always be easy to set up,” <strong>he said.</strong> “Migration, first time setup, our goal was for that to take under half an hour.” Details on supported security and privacy frameworks are available in the SplitSecure Trust Center.</p></blockquote><p>The free plan of SplitSecure’s new platform, which is available to all customers now, offers access control with the following key differentiators:</p><ol>\n<li><strong>Modern Privileged Access:</strong> Zero trust, just-in-time access, zero standing privilege, on-demand step-up authentication, multi-party approvals, and quantum resistance come as standard.</li>\n<li><strong>Condenses Multiple Tools:</strong> SplitSecure can condense two to five tools in the security stack.</li>\n<li><strong>No-Vendor-Threat Architecture:</strong> Root keys are held exclusively by the customer, so SplitSecure as the vendor has no access to customer secrets.</li>\n<li><strong>Built-In Audit and Compliance:</strong> Every privileged action are logged automatically with full context on every plan. Paid plans can view the logs for security analysis and forensics.</li>\n</ol><p><strong>About SplitSecure</strong></p><p><a href=\"https://www.splitsecure.com/\">SplitSecure</a> is a cybersecurity technology provider, established to develop and modernize secret splitting technology. After being founded in 2025 by Tristan Morris and Marc Tremblay, it raised $4.7M from Cowboy, Twelve Below, and Cofound Ventures. Its access control platform combines PAM, password and passkey management, secrets vaulting, and auditing in one product, with root keys held exclusively by the customer.&nbsp;</p><p>SplitSecure’s new access control platform is free for teams of up to six. Learn more at<a href=\"https://www.splitsecure.com/\"> splitsecure.com</a> or read the<a href=\"https://docs.splitsecure.com/\"> documentation</a>.</p><p><strong>Email: </strong><a href=\"https://hackread.com/cdn-cgi/l/email-protection\">[email&nbsp;protected]</a></p><p><strong>Website:</strong> <a href=\"https://www.splitsecure.com/\">splitsecure.com</a></p><h5>Contact</h5><p><span><strong>Chief of Staff</strong><br></span><span><strong>Slava Pashchenko</strong><br></span><span><strong>SplitSecure</strong><br></span><span><strong><a href=\"https://hackread.com/cdn-cgi/l/email-protection\">[email&nbsp;protected]</a></strong><br></span></p>","zhKind","complete","工具发布","凭据","加密","https://hackread.com/splitsecure-launches-new-access-control-architecture-for-humans-and-ai-agents/","Hackread",{"_93":94,"_95":-5},"changelogVersion","2026-10-01T08:00","release"]
