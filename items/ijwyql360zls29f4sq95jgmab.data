[{"_1":2,"_3":4},"root",{"_5":96},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1795826441000,"id","ijwyql360zls29f4sq95jgmab","title","美国打击全球诈骗团伙，Operation Blackout 查扣近 170 亿美元","originalTitle","US seizes nearly $17 billion in global war on scam rings","summary","美国政府以 800 余名涉嫌诈骗人员、85 个联邦地区和 400 余起案件为对象，开展其称为规模最大的反诈骗行动。","reason","材料汇总了美国跨部门打击全球诈骗团伙的范围、涉案手法与执法成果，并给出受害规模，便于了解诈骗产业链及治理进展。","source",{"_65":95},"links",{"_87":94},"publishedAt","2026-11-27T05:30:28.000Z","discoveredAt","2026-11-27T06:28:19.860Z","timelineAt","category","activity","tags",[66,91,92,93],"score",74,"selected",true,"channel","news","story","x","readingMode","full","author","Sinisa Markovic","body",{"_59":86,"_87":-5,"_88":89,"_90":37},"outline",[71,72,73,74],"relatedStories",[],"topics",[60,61,62],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_63":69,"_65":70},{"_63":67,"_65":68},{"_63":64,"_65":66},"slug","attack","name","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件",{"_11":84,"_76":85,"_78":79},{"_11":82,"_76":83,"_78":79},{"_11":80,"_76":81,"_78":79},{"_11":75,"_76":77,"_78":79},"sec-4","text","对受害者的影响","level",3,"sec-3","境外诈骗窝点被关闭","sec-2","老年美国人的数据被出售给诈骗者","sec-1","牢房里的电话","<p>美国政府已对800多名涉嫌实施诈骗者采取行动，称这是美国历史上规模最大的、专门针对美国人实施诈骗的打击行动。</p><p><img src=\"/dailyinfo/media/e9d4e772ca744fcf.webp\" loading=\"lazy\" decoding=\"async\" alt=\"scam crackdown\" title=\"Door\"></p><p>司法部宣布，此次行动涵盖85个联邦地区、400多起案件，包括新增指控、有罪判决和量刑；另有30名被告被引渡至美国。</p><p>美国检察官和探员与10多个国家的警方联合行动突击查封境外的诈骗呼叫中心和窝点。行动始于<a href=\"https://www.whitehouse.gov/presidential-actions/2026/03/combating-cybercrime-fraud-and-predatory-schemes-against-american-citizens/\">Executive Order 14390</a>于2026年3月6日签署之后。</p><p>司法部长Todd Blanche宣称：“针对美国人的掠夺性诈骗绝不容忍。”</p><h3 id=\"sec-1\">牢房里的电话</h3><p>在一起案件中，据称乔治亚州监狱里的团伙成员利用走私入监的手机给陌生人打电话，告诉他们错过了陪审团义务，并要求缴纳“罚款”，否则就要被关进监狱。</p><p>联邦法院和州法院的三份起诉书共指控了14名与该计划有关的人。检察官在州法院另行起诉了17名将手机走私入该州监狱的人。调查人员查扣了用于实施该诈骗的网站，美国邮政 Inspection Service 接管了三个域名，并将访问者引导至资产查封横幅。</p><p>联邦通信委员会则对这些设备本身采取了行动。11月19日，该委员会批准了一项规则，允许监狱使用干扰技术对付违禁手机。</p><p>FCC主席<a href=\"http://linkedin.com/in/brendan-carr-0030b126\">Brendan Carr</a>表示：“多年来，数十万部违禁手机被带入我们的监狱，使罪犯得以对普通美国人实施诈骗。”</p><p>Carr补充道：“通过首次允许在监狱中使用干扰技术，我们采取了一种积极但负责任的做法，以消除在押人员接触违禁手机的机会。”</p><h3 id=\"sec-2\">老年美国人的数据被出售给诈骗者</h3><p>数起案件涉及倒卖老年人个人信息的团伙。墨西哥一家数据经纪商明知其行为，仍将老年美国人的姓名和联系方式出售给数十名诈骗者。</p><p>在另一项专门针对老年受害者的抽奖骗局中，共有12名被告被指控，其中包括牙买加国民。其他被打击目标还包括秘鲁的一个呼叫中心，该中心告诉讲西班牙语的美国人，除非购买英语学习产品，否则他们就会被逮捕或驱逐出境。 </p><p>一名尼日利亚国民因涉嫌窃取美国军人的军饷而从英国被引渡。</p><h3 id=\"sec-3\">境外诈骗窝点被关闭</h3><p>检察官将海外行动列为重点。刑事部门助理司法部长A. Tysen Duva誓言表示：“我们不会允许这些诈骗者躲在屏幕后面，也不会允许他们通过在境外实施这些犯罪来逃避司法制裁。”</p><p>在“断电行动”下，FBI查扣了近170亿美元的非法资金，捣毁了29个以上的诈骗窝点，并协助遣返了2,200多名被贩运的劳工。FBI警告称，已有超过11,000名美国人成为目标，并估计 prevented 超过6.9亿美元的经济损失。</p><p>FBI局长Kash Patel警告说：“我们向这些诈骗团伙传递的信息很明确：如果你们针对美国人，正义迟早会找到你们。”</p><p>国务院协助冻结了超过10亿美元被盗加密货币，并关闭了140多个欺诈网站和账户。联邦贸易委员会向消费者返还了近30亿美元。</p><p>担任美国证券交易委员会（SEC）执法部门负责人的 David Woodcock 认为，这些骗局的演变远不及背后工具的变化。“技术可能是新的，但骗局并不陌生。”</p><h3 id=\"sec-4\">对受害者的影响</h3><p>盖洛普（Gallup）的一项研究发现（美国司法部在引用中提及），约 10% 的美国成年人在过去一年中遭遇过诈骗，或是本人遭遇，或是 household 中的其他人遭遇。近四分之三的<a href=\"https://www.helpnetsecurity.com/2026/11/18/nicola-fox-hamilton-victim-blaming-scams-phishing/\">受害者</a>表示这损害了他们的心理健康或身心状况，美国人因诈骗损失估计达 680 亿美元（2025 年）。</p><p>“太多美国人遭受了网络欺诈之苦，尤其是源自东南亚、并扩散至南亚、中东、非洲和太平洋地区的诈骗活动。但真正的代价不仅仅在于金钱。每一个统计数字背后都有一个真实的人生故事——一个家庭破产、一个退休老人一贫如洗，或一个年轻人被逼自杀，”副国务卿助理 <a href=\"https://www.linkedin.com/in/david-m-bedard/\">David Bedard</a><a href=\"https://www.justice.gov/opa/pr/justice-department-announces-largest-ever-crackdown-scammers-targeting-over-800-defendants\">指出</a>。</p>","original","zhKind","translation","complete","黑产","数据窃取","数据泄露","https://www.helpnetsecurity.com/2026/11/27/doj-scam-crackdown-800-scammers/","Help Net Security",{"_97":98,"_99":-5},"changelogVersion","2026-10-01T08:00","release"]
