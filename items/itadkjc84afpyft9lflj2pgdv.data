[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795135237000,"id","itadkjc84afpyft9lflj2pgdv","title","Daptin 实体列表端点 `sort` 参数存在未认证 SQL 注入","originalTitle","Daptin: Unauthenticated SQL Injection via the `sort` query parameter on every entity list endpoint","summary","Daptin 的通用实体列表端点 `GET /api/` 存在未认证 SQL 注入，所有实体的列表请求都会处理 `sort` 查询参数。该参数未经字段存在性校验便被拼接进原始 SQL 标识符，攻击者可构造请求触发 500 错误，并可能进行盲注或基于错误的越权数据提取。","reason","source",{"_70":82},"links",{"_59":81},"publishedAt","2026-11-20T00:13:19.000Z","discoveredAt","2026-11-20T00:23:20.143Z","timelineAt","category","vuln","tags",[77,78,79,80],"score",65,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fJ69T842DmiY","reportCount",1,"additionalSourceCount",0,{"_68":30,"_70":72},{"_68":69,"_70":71},"slug","research","name","技术研究","漏洞披露",{"_74":75,"_13":76},"publicId","d7509628-d594-40ea-b595-9459a4b98e5b","Daptin排序参数暴露未认证SQL注入","漏洞","复现","漏洞利用","漏洞分析","https://github.com/advisories/GHSA-hq2p-f2vj-v3cm","GitHub 安全公告",{"_84":85,"_86":-5},"changelogVersion","2026-10-01T08:00","release"]
