[{"_1":2,"_3":4},"root",{"_5":117},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794530494000,"id","xo3px77vo84m1faxu5nie5ooc","title","DarkSword、Coruna 利用广告和失陷网站攻击 iPhone 员工","originalTitle","An Instagram ad was all it took: Leaked exploit kits are hitting employees’ iPhones","summary","iVerify 的 2026 年移动威胁报告称，攻击者利用泄露的 DarkSword 和 Coruna exploit kit，通过 Instagram 广告、金融与加密货币仿冒网站感染使用 iPhone 工作的员工。","reason","材料还原了 DarkSword、Coruna 与 DeadTag 的投放链和凭据窃取路径，并给出访问量与感染监测数据，便于理解移动端入侵如何延伸至企业账号。","source",{"_77":116},"links",{"_108":115},"publishedAt","2026-11-11T05:00:34.000Z","discoveredAt","2026-11-11T05:49:35.165Z","timelineAt","category","activity","tags",[80,78,88,112,113,114],"score",73,"selected",true,"channel","news","story",{"_92":93,"_13":94},"x","readingMode","full","author","Anamarija Pogorelec","body",{"_61":107,"_108":-5,"_109":110,"_111":37},"outline",[95,96,97],"relatedStories",[91],"topics",[68,69,70,71,72,73,74],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fvnciadCtRtY","reportCount",1,"additionalSourceCount",0,{"_75":89,"_77":90},{"_75":87,"_77":88},{"_75":85,"_77":86},{"_75":83,"_77":84},{"_75":81,"_77":82},{"_75":79,"_77":80},{"_75":76,"_77":78},"slug","malware","name","恶意软件","attack","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","identity","身份与访问","mobile","移动端","apple","Apple / 苹果",{"_92":93,"_13":94},"publicId","80587356-26a4-481b-9914-98f87d043fca","泄露工具包被用于入侵员工iPhone",{"_11":105,"_99":106,"_101":102},{"_11":103,"_99":104,"_101":102},{"_11":98,"_99":100,"_101":102},"sec-3","text","证据可能在调查开始前消失","level",3,"sec-2","受感染的个人手机可能暴露工作账户","sec-1","攻击可在广告加载时启动","<p>据 iVerify 的<em>2026 Advanced Mobile Threat Report</em>，犯罪分子正在使用泄露的漏洞利用工具包入侵存在漏洞的 iPhone。通过广告和受入侵网站发起的攻击已经波及使用手机办公的<a href=\"https://www.helpnetsecurity.com/2026/09/15/onetrust-enterprise-ai-governance-trends-report/\">员工</a>。</p><p><a href=\"https://www.helpnetsecurity.com/2026/04/02/apple-ios-18-darksword-security-updates/\">DarkSword</a> 将多个软件漏洞串联起来，以入侵 iPhone。研究人员于 2026 年 3 月披露了该工具包，不到一周后 GitHub 上便出现了更新的版本，使犯罪团伙获得了可供改编的代码。另一个工具包 Coruna 则通过伪装成金融和加密货币服务的网站提供。</p><h3 id=\"sec-1\">攻击可在广告加载时启动</h3><p>当用户滚动 Instagram 时加载的一条广告触发了一个 DarkSword 变种，开始感染其 iPhone。随后，同一个人点击了一个链接，该链接投放了另一版本的工具包。研究人员将这些事件归因于不同的行为体，并评估认为双方都意在窃取加密货币。 </p><p>Report URI 研究员<a href=\"https://www.linkedin.com/in/scotthelme/\">Scott Helme</a>记录的 DeadTag 是一个出售流量的行动组织，它收购了一个曾用于电商分析服务的过期域名。一些商店的网站模板中仍引用该域名，因此购物者的浏览器会获取由新所有者控制的脚本。该脚本将部分访客导向流量经纪商。其中一个目的地伪装成加密货币交易网站，并悄悄加载了一个隐藏页面，检查设备是否运行 iOS 18.4.0 至 18.7.2 版本的 Safari，然后在符合条件的 iPhone 上启动 DarkSword 漏洞利用链。</p><p>另一个团伙从 DeadTag 购买流量，并投放 DarkSword 和<a href=\"https://www.helpnetsecurity.com/2026/03/03/coruna-ios-exploit-kit/\">Coruna</a>。在整个 DeadTag 网络中，数千个网站从超过 660 个重新注册的域名加载代码。Report URI 估计，这些网站每月合计获得 1.35 亿次访问。研究人员未报告有多少手机被感染。 </p><h3 id=\"sec-2\">受感染的个人手机可能暴露工作账户</h3><p>DarkSword 可以从 iPhone 的钥匙串中提取密码和其他登录信息。如果员工使用个人手机处理工作邮件、消息或远程访问，被盗的凭据或会话令牌可能让攻击者得以访问公司的服务。Coruna 的一个有效载荷会在文本和图像中搜索恢复短语，攻击者可能利用这些短语控制<a href=\"https://www.helpnetsecurity.com/2026/09/17/fake-ai-trading-agent-research/\">加密货币钱包</a>。</p><p>“窃取凭据是网络犯罪分子的一门大生意。Scattered Spider 和 ShinyHunters 等团伙曾利用社会工程学和被盗身份入侵企业网络，并勒索数百万美元，”LeverSec 负责人、Salesforce 前首席信任官<a href=\"https://www.linkedin.com/in/brad-arkin/\">Brad Arkin</a>表示。 </p><p>“DarkSword 和 Coruna 为犯罪分子提供了另一条入侵途径。两者结合起来，可以从 iPhone 中提取已保存的密码、消息、笔记和照片，并窃取加密货币。如果员工的手机受到感染，该人员的合法凭据就可能成为更大规模数据泄露的起点，而且登录看起来会像是正常活动。”</p><p><img src=\"/dailyinfo/media/93b642981f48628f.webp\" loading=\"lazy\" decoding=\"async\" alt=\"iPhone exploit kit attacks\" title=\"Nearly 1 in 900 iOS consumer scans shows signs of spyware\"></p><h5>\n<p>每 900 次 iOS 消费者扫描中接近 1 次显示间谍软件迹象（来源：iVerify）</p>\n</h5><p>在检测结果中，寻求<a href=\"https://www.helpnetsecurity.com/2026/09/04/ai-agent-credentials-video/\">凭据</a>或加密货币的犯罪分子占四分之三。每一次企业环境中对 DarkSword 或 Coruna 的检测，都涉及一名职级不高于董事总经理的员工。对受监测的消费者 iOS 设备的保守估计为每 1,000 台设备有 1.07 例间谍软件感染。 </p><h3 id=\"sec-3\">证据可能在调查开始前消失</h3><p>DarkSword 的一些痕迹只会短暂留在 iPhone 上。重启设备或进行软件更新，都可能移除正在运行的恶意软件，并抹除有助于调查人员重建攻击过程的证据。</p><p>研究人员没有收到任何针对其已确认感染 DarkSword 或 Coruna 的设备而发出的 Apple 威胁通知。Apple 利用此类警报提醒其认为可能遭到雇佣间谍软件单独针对性攻击的人。</p>","original","zhKind","translation","complete","凭据","数据窃取","Apple","https://www.helpnetsecurity.com/2026/11/11/iverify-iphone-exploit-kit-attacks-report/","Help Net Security",{"_118":119,"_120":-5},"changelogVersion","2026-10-01T08:00","release"]
