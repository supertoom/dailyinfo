[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1794195835000,"id","wlow3wts75k3iwu5wwonpyqpi","title","LXD 恶意镜像可经 templates 符号链接读写宿主机任意文件","originalTitle","LXD has arbitrary file read+write on host via templates/ symlink in malicious image","summary","LXD 可被构造的恶意容器镜像利用，通过未拦截的顶层 templates 符号链接读取或创建及写入宿主机任意目录中的文件，进而可能执行任意命令。PoC 将 templates 映射至宿主机 /etc/cron.d，并创建以 root 身份运行 id 的定时任务，展示了读取、写入及命令执行路径。","reason","文章说明了恶意镜像如何通过 templates 符号链接访问宿主机任意文件，并提供可映射到 /etc/cron.d 的 PoC。","source",{"_70":83},"links",{"_60":82},"publishedAt","2026-11-06T18:53:57.000Z","discoveredAt","2026-11-07T00:26:30.969Z","timelineAt","category","vuln","tags",[78,79,80,81],"score",70,"selected",true,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[67,68],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fW4d39qlSql8","reportCount",1,"additionalSourceCount",0,{"_69":72,"_70":73},{"_69":31,"_70":71},"slug","name","漏洞披露","cloud-native","云与原生",{"_75":76,"_13":77},"publicId","9f59feae-2c5e-41d8-b422-83aecaefb071","LXD恶意镜像可读写宿主机文件","漏洞","复现","漏洞利用","容器","https://github.com/advisories/GHSA-jpf8-86f3-wp38","GitHub 安全公告",{"_85":86,"_87":-5},"changelogVersion","2026-10-01T08:00","release"]
