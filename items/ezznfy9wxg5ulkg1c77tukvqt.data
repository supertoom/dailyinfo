[{"_1":2,"_3":4},"root",{"_5":102},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794616828000,"id","ezznfy9wxg5ulkg1c77tukvqt","title","多国机构警告工业制冷与冷链监控控制器遭攻击，可致火灾和库存损失","originalTitle","U.S. Agencies Warn Refrigeration Controller Attacks Could Cause Fires and Inventory Losses","summary","CISA、FBI、HHS、USDA 和 DOT 警告，威胁行为者正全球攻击工业制冷与冷链监控系统，利用未打补丁或暴露互联网的控制器、认证绕过、任意代码注入和弱配置，远程改写温度或除霜设置，造成服务中断、火灾风险、库存损失及消费者安全风险。","reason","材料汇集了多国机构联合预警与欧洲近期攻击实例，并给出可量化的控制器暴露变化，便于判断工控攻击面与处置重点。","source",{"_76":101},"links",{"_93":100},"publishedAt","2026-11-09T06:15:10.000Z","discoveredAt","2026-11-09T06:59:18.046Z","timelineAt","category","activity","tags",[77,97,98,79,99,87],"score",77,"selected",true,"channel","news","story",{"_89":90,"_13":91},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_61":92,"_93":-5,"_94":95,"_96":37},"outline",[],"relatedStories",[88],"topics",[68,69,70,71,72,73],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fk0y0T43euKg","reportCount",4,"additionalSourceCount",3,{"_74":86,"_76":87},{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","attack","name","攻击活动","exploited","在野利用","industrial","工业控制","iot","IoT 与车联网","supply-chain","供应链安全","cisa","CISA",{"_89":90,"_13":91},"publicId","39a526ba-363a-49b7-b010-e42eb75c1eef","美五机构警告冷链制冷控制器遭全球攻击","<p><span><i></i><span>Ravie Lakshmanan</span><i></i><span>2026年11月09日</span></span><span>关键基础设施 / 网络攻击</span></p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjKryTkTZPSm_Pvf-PEvYRFle3Bp0jQaXScE21oOsMfwir63sr355bqHInvPRm5zynq2sYfLswRNEeywDHo7p2snw5sQmlIrWIONBq4AoYFEGXvdgy5gNLMESgjL5zwnhbqYIwdKLRaolb18pKz1sqFynmSjWn2IT_BxlEb-0av9vDfp-oEzp23_cwOIoik/s1600/ref.jpg\"><img alt=\"\" src=\"/dailyinfo/media/b6e0370e4a1489c2.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>美国政府机构<a href=\"https://www.cisa.gov/resources-tools/resources/us-government-partners-urge-hardening-industrial-refrigeration-and-cold-chain-monitoring-systems\">警告称</a>，威胁行为者正在全球积极攻击工业制冷和冷链监控系统，意图造成服务中断、火灾隐患和库存损失。</p><p>“这些行为者可能会利用未打补丁或可从互联网访问的控制器中的漏洞或弱点，远程更改设置，迫使设备持续进行加热和除霜循环，从而造成大范围库存损失和设备隐患。”根据一份联合公告。</p><p>美国网络安全和基础设施安全局（CISA）、联邦调查局（FBI）、卫生与公众服务部（HHS）、农业部（USDA）和运输部（DOT）表示，威胁行为者可能利用身份验证绕过、任意代码注入和配置薄弱来访问这些系统，并造成以下影响——</p><ul>\n  <li>温度变化，进而可能影响系统的使用寿命、造成火灾隐患、导致库存损失，或危害购买经不安全储存后产品的消费者。</li>\n  <li>因拒绝服务而无法查看当前温度。</li>\n</ul><p>为应对这一威胁，所有者和运营方被敦促采用强身份验证、保持系统更新、识别任何可从互联网访问的系统、隔离运行技术（OT）设备、更改默认密码、淘汰并替换旧式设备、移除不必要的远程访问，并保护必要的远程访问。</p><p>“工业制冷和冷链监控系统保护食品、药品及其他温度敏感产品，因此成为恶意网络行为者的有吸引力目标。”FBI网络分支运营总监Brett Leatherman<a href=\"https://www.cisa.gov/news-events/news/cisa-fbi-hhs-usda-and-dot-urge-critical-infrastructure-strengthen-industrial-refrigeration-and-cold\">表示</a>。</p><p>“我们看到全球多个关键基础设施领域的这些系统遭到攻击，使库存和设备面临风险。”</p><p>近几周，威胁行为者通过利用可从互联网访问的制冷控制器中的弱点，在欧洲攻击了<a href=\"https://thehackernews.com/2026/11/second-wave-of-cyberattacks-hits.html\">数百家超市</a>，将温度调高，在某些情况下高达50摄氏度（122华氏度），或迫使制冷设备进入除霜模式，导致食品变质并造成经济损失。</p><p>这些<a href=\"https://www.bbc.com/news/articles/ckq6ndq8l6v0o\">攻击</a>的<a href=\"https://www.bbc.com/news/articles/cwy8lm1m59mvo\">目标</a>包括比利时、爱沙尼亚、芬兰、法国、德国、爱尔兰、意大利、卢森堡、荷兰、葡萄牙、瑞典和英国的大型超市连锁店以及小型杂货店和肉店。</p><p>受攻击目标之一是法国血液机构，该机构<a href=\"https://presse.efs.sante.fr/actualites/l-efs-confirme-l-incident-de-cybersecurite-impactant-un-de-ces-prestataires-d-equipement-frigorifique-2c07c-08a0a.html\">确认</a>，一起影响制冷设备供应商的网络安全事件导致三处用于储存血浆的设施温度和除霜设置升至“极高水平”。目前尚不清楚是谁发动了这轮黑客攻击潮。</p><p>Censys的数据显示，全球仍有<a href=\"https://censys.com/blog/european-refrigerator-controller-redux-a-new-wave-of-refrigeration-attacks/\">数百个Danfoss StoreView实例</a>暴露在外，其中大多数位于法国；不过，从2026年10月9日至11月5日，这一数量已从3,004个<a href=\"https://censys.com/blog/european-refrigeration-controller-exposure-sitrep\">大幅下降</a>至708个。同样，Copeland/Dixell XWEB暴露实例数量也从3,708个降至2,420个。</p><p>攻击面管理平台将欧洲各地的制冷攻击描述为针对<a href=\"https://www.wired.com/story/kernel-panic-refrigeration-hacks-internet-of-things/\">关键基础设施</a>的近期事件清单中的最新一项，此外还包括加油站油罐液位计、防空警报系统和供水塔等事件。</p><p>“北美约占全球 ICS [工业控制系统] 暴露风险的 38%，”Censys <a href=\"https://censys.com/blog/what-refrigerator-hacks-reveal-about-ics-exposure/\">表示</a>。“亚洲的占比从 2024 年的 22% 增至 2026 年的 25%，而欧洲则从 36.5% 降至 32%。然而，这些变化并未导致整体暴露风险下降。”</p><p>“尽管暴露数量很高，但这并不令人意外：ICS 暴露问题多年来一直被报道和警示。作为全球关键基础设施的守门人，它对公众构成了严重风险。”</p><p>觉得这篇文章有意思吗？关注我们的 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a>，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","工控","供应链","IoT","https://thehackernews.com/2026/11/us-agencies-warn-refrigeration.html","The Hacker News",{"_103":104,"_105":-5},"changelogVersion","2026-10-01T08:00","release"]
