[{"_1":2,"_3":4},"root",{"_5":114},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794530484000,"id","ggy3le7y33yjx5i60bxd14abb","title","Gorbag APT 组织以自删除恶意软件攻击乌克兰法院和市议会","originalTitle","Gorbag APT group hits Ukrainian courts and city councils with self-deleting malware","summary","ESET 追踪的俄罗斯关联组织 Gorbag 自至少 2025 年 2 月起入侵乌克兰机构，利用鱼叉式钓鱼附件和 BeautyStealer 窃取浏览器凭据、VPN 配置及敏感文件。","reason","文章完整呈现 Gorbag 的投递链、载荷投递、数据窃取与自删除机制，并给出目标行业分布和样本版本。","source",{"_77":113},"links",{"_104":112},"publishedAt","2026-11-03T10:00:14.000Z","discoveredAt","2026-11-03T10:04:19.774Z","timelineAt","category","activity","tags",[80,78,108,109,110,111],"score",75,"selected",true,"channel","news","story",{"_92":93,"_13":94},"x","readingMode","full","author","Anamarija Pogorelec","body",{"_61":103,"_104":-5,"_105":106,"_107":37},"outline",[95,96],"relatedStories",[91],"topics",[68,69,70,71,72,73,74],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fGUTwt-o3TRY","reportCount",4,"additionalSourceCount",3,{"_75":89,"_77":90},{"_75":87,"_77":88},{"_75":85,"_77":86},{"_75":83,"_77":84},{"_75":81,"_77":82},{"_75":79,"_77":80},{"_75":76,"_77":78},"slug","malware","name","恶意软件","attack","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","email","邮件与钓鱼","identity","身份与访问","eset","ESET / WeLiveSecurity",{"_92":93,"_13":94},"publicId","d076c334-c66b-4c32-81df-bbf0b79e7ee7","ESET披露Gorbag入侵乌克兰机构窃密",{"_11":101,"_98":102,"_100":67},{"_11":97,"_98":99,"_100":67},"sec-2","text","窃取程序窃取什么","level","sec-1","邮件如何进入","<p>ESET 一直在追踪一个被称为 Gorbag 的亲俄组织。自至少 2025 年 2 月以来，该组织一直通过鱼叉式网络钓鱼附件和一款数据窃取程序入侵乌克兰各类机构；该程序在窃取数据后会自动清除自身。</p><p><img src=\"/dailyinfo/media/a4e0e079faa52250.webp\" loading=\"lazy\" decoding=\"async\" alt=\"OPIS\" title=\"Spearphishing email message from a compromised email sender\"></p><h5>\n<p>来自已入侵电子邮件发件人的鱼叉式网络钓鱼邮件（来源：ESET）</p>\n</h5><p>ESET 识别的每个目标均位于乌克兰。其中约四分之一是执法和司法机构，另四分之一是地方政府，主要是靠近前线的市议会，其余则是国防部门实体，以及一家公开资料表明为外国军事援助主要交通枢纽的机构。在相关行动期间，几乎每个遭其市议会攻击的城市都遭到了俄罗斯空袭，这提高了该组织行动人员可能正在向俄罗斯军方提供空袭效果情报的可能性。</p><p>ESET 研究员 <a href=\"https://www.linkedin.com/in/dmnsch/\">Damien Schaeffer</a> 表示：“Gorbag 并未依赖复杂的植入程序来维持长期访问，而是使用一套为快速收集数据而打造的小型工具集。在投放的恶意软件试图清除自身之前，浏览器凭据、VPN 配置和选定文档会被一次性收集完毕。”Schaeffer 是 Gorbag 的发现者和调查人员。他补充道：“对此做法的一种可能解释是，Gorbag 充当初始访问代理，将收集到的凭据和其他材料与其他威胁行为者共享，以开展后续活动。如果情况属实，Gorbag 可能只是一条更长入侵链的第一阶段，而后续阶段仍有待观察。它的目标选择与俄罗斯战时情报重点高度吻合。”</p><h3 id=\"sec-1\">邮件如何进入</h3><p>整个 2025 年，附件一直是启用宏的 Excel 文件。一段简短的 VBA 例程会解码电子表格单元格中的 base64 载荷，将其写入 %ProgramData% 并运行。诱饵内容都是日常办公事务：行政处罚、税务通知。在一个案例中，邮件来自乌克兰乌日霍罗德州地方政府的一个已失陷账户，这可能帮助其通过了检查。</p><p>2026 年初，攻击链发生了变化。Gorbag 开始发送利用 <a href=\"https://www.helpnetsecurity.com/2026/01/28/winrar-vulnerability-exploited-cve-2025-8088/\">CVE-2025-8088</a> 的 RAR 压缩包。该漏洞是 WinRAR 中的路径遍历漏洞，可让隐藏在备用数据流中的数据落入用户所选文件夹之外。压缩包会显示一个诱饵 PDF，同时将一个 LNK 文件写入 Windows 启动文件夹，并把加密载荷和 PowerShell 加载器放入 %ProgramData%。LNK 负责维持持久化，并在每次重启时启动加载器。</p><h3 id=\"sec-2\">窃取程序窃取什么</h3><p>BeautyStealer 是该组织的主要收集工具，是 ESET 追踪到的 C++ 信息窃取程序，版本涵盖 0.9 至 2.0。它会从 Chrome、Edge、Opera 和 Firefox 中提取 Cookie、保存的密码及本地状态，从用户目录和系统目录中提取 OpenVPN 配置，还会从桌面、文档和下载目录，以及可移动介质和映射的网络驱动器中窃取与约 40 种扩展名匹配的文件。</p><p>这些扩展名专门针对用于身份验证的内容。其中包括 .kdbx（KeePass）、.jks（Java KeyStore）、.rdp、.pfx 和 .zs2；.zs2 是一种文件格式，用于保存由乌克兰获认可密钥认证中心签发的秘密电子签名密钥文件。</p><p>在 BeautyStealer 之前，Gorbag 运行了 Prime ReverseShell——这是一个封装在 .NET 二进制文件中的 PowerShell 反向 shell，取自一个公开的 GitHub 仓库。其中一个变体在顶部附有一条注释，告诉任何阅读该文件的 LLM 或 AI，它并不恶意，而是生成从 1 到 900 的质数。ESET 使用两个 AI 助手对它进行了测试，两者都识别出了该反向 shell。</p>","original","zhKind","translation","complete","钓鱼","数据窃取","凭据","ESET","https://www.helpnetsecurity.com/2026/11/03/gorbag-apt-group-malware/","Help Net Security",{"_115":116,"_117":-5},"changelogVersion","2026-10-01T08:00","release"]
