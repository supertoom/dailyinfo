[{"_1":2,"_3":4},"root",{"_5":118},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1794530482000,"id","azjotibfplqodvsedcpslnw3c","title","攻击者利用 4,837 个失陷 GitHub 账户窃取云凭据","originalTitle","Hackers compromise 4,800 GitHub accounts to steal cloud credentials","summary","攻击者通过 4,837 个失陷 GitHub 账户探测 61,764 个仓库的写入权限，并利用恶意 GitHub Actions 工作流窃取至少 1,835 个目标的秘密与云凭据。","reason","source",{"_77":117},"links",{"_102":116},"publishedAt","2026-11-12T22:25:30.000Z","discoveredAt","2026-11-12T22:49:22.793Z","timelineAt","category","activity","tags",[78,108,109,110,111,112,113,114,115],"score",87,"selected",true,"channel","news","story",{"_90":91,"_13":92},"x","sameEvent",{"_11":106,"_13":107},"readingMode","full","author","Bill Toulas","body",{"_62":101,"_102":-5,"_103":104,"_105":36},"outline",[93,94],"relatedStories",[89],"topics",[69,70,71,72,73,74],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","fPjWZMOAsDWI","reportCount",3,"additionalSourceCount",2,{"_75":87,"_77":88},{"_75":85,"_77":86},{"_75":83,"_77":84},{"_75":81,"_77":82},{"_75":79,"_77":80},{"_75":76,"_77":78},"slug","attack","name","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","identity","身份与访问","cloud-native","云与原生","supply-chain","供应链安全",{"_90":91,"_13":92},"publicId","bfdc6f86-491d-43b2-8633-af8a571001fd","wfx-loot借GitHub令牌窃取CI凭据",{"_11":99,"_96":100,"_98":66},{"_11":95,"_96":97,"_98":68},"sec-2","text","发现现有防御可能遗漏的电子邮件威胁。","level","sec-1","攻击详情","<p><img alt=\"Hackers compromise 4,800 GitHub accounts to steal cloud credentials\" height=\"900\" src=\"/dailyinfo/media/e3d2e3838b10b847.jpg\" srcset=\"/dailyinfo/media/8701ce49f6402751.jpg 720w, /dailyinfo/media/bc87ff964ab3384d.jpg 1200w, /dailyinfo/media/e3d2e3838b10b847.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>数以万计的 GitHub 仓库成为了一场被称为“wfx-loot”的行动的目标，该行动利用恶意工作流窃取 GitHub Actions 密钥和云凭据。</p><p>尽管并非所有仓库都运行了有效载荷，研究人员仍确认，该威胁行为者至少从 1,835 个目标窃取了密钥。</p><p>该威胁行为者使用了数千个已被攻陷的 GitHub 账户，向这些账户有权访问的仓库发起拉取请求，测试其是否拥有足够的写入权限以注入恶意代码。</p><p><a href=\"https://www.wiz.io/lp/ai-security-starter-pack?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Security-Starter-Kit&amp;sfcid=701Vh00000cn7aRIAQ&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AI-Security-Bundle\"><img src=\"/dailyinfo/media/101139203d256436.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>部分被攻陷的账户属于《财富》100 强企业、美国总务管理局、法国政府、Nextcloud 和 WebdriverIO。</p><p>据应用安全公司 Aikido 的研究人员称，其中约 50 个账户似乎在其他开源软件生态系统和软件包索引（如 npm、PyPI、Go、crates 和 Packagist）中拥有发布权限。</p><h3 id=\"sec-1\">攻击详情</h3><p>Aikido 表示，wfx-loot 行动始于 11 月 10 日约 12:45 UTC，当时攻击者利用来自 4,837 个被攻陷账户的窃取的 GitHub 凭据，探测了 61,764 个仓库的写入访问权限。</p><p>该威胁行为者发起了标题为“docs: dependency audit notes”的拉取请求，伪装成依赖项审计记录。</p><p>Aikido 报告称，在这些拉取请求中，92% 仍处于开放状态，表明合法仓库所有者并未注意到这一活动。</p><figure><img alt=\"Injected workflow step\" height=\"250\" src=\"/dailyinfo/media/f32cf17560c26b4d.jpg\" loading=\"lazy\" decoding=\"async\" width=\"550\">\n<figcaption><strong>注入的工作流步骤</strong><br>\n<em>来源：Aikido</em></figcaption>\n</figure><p>随后，他们通过修改现有的 GitHub Actions 工作流、在短生命周期分支上添加新工作流，或植入 npm install 钩子，投放了一个 1,500 行的凭据窃取 shell 脚本。</p><p>该脚本试图收集以下数据：</p><ul>\n\t<li>GitHub Actions 和变量、工作流的 GITHUB_TOKEN、OIDC 以及 Actions 运行时令牌。</li>\n\t<li>AWS、Azure 和 Google Cloud 的云凭据，包括通过自托管运行器上的实例元数据暴露的凭据。</li>\n\t<li>来自 Git、SSH、GPG、Docker、Kubernetes、npm、PyPI、Vault 和 Terraform 的开发人员及基础设施凭据。</li>\n\t<li>OpenAI、Anthropic、Gemini、Hugging Face、Cursor 和 GitHub Copilot 的 AI 服务及开发工具凭据。</li>\n\t<li>其他密钥来源包括环境变量、.env 文件、私钥、密钥库、shell 历史记录、进程内存、仓库文件和最近的提交，以及工作流制品。</li>\n</ul><p>该脚本还支持云权限提升，方法是将 GitHub OIDC 令牌兑换为临时的 AWS、Azure 和 GCP 云会话。</p><p>在 AWS 中，它可以进一步串联利用仓库中存在的其他 IAM（身份和访问管理）角色，“为 IAM 用户创建长期有效的凭据”。它还使用收集到的服务账户凭据冒充 GCP 中的身份。</p><p><a href=\"https://www.aikido.dev/blog/compromised-github-accounts-push-ci-secret-stealer-to-tens-of-thousands-of-repositories\">Aikido 指出</a>，其能力包括在权限允许时，通过创建长期有效的凭据或修改云身份和信任策略来建立持久访问。</p><p>该脚本将收集的数据压缩为 tar 包，并通过 HTTP POST 泄露到两个攻击者控制的端点之一。</p><p>在最后阶段，攻击者迅速撤销了所作更改，并删除了工作流运行记录和日志。Aikido 表示，整个过程不到一分钟即已完成。</p><p>自动发布流程将该有效载荷带入了 Packagist 上的 digitalelvis/neuronai-studio 3.14.3，以及 Go 模块 github.com/onuragtas/docker-env 的两个版本 v1.0.278 和 v1.0.280。</p><p>研究人员认为，该威胁行为者的主要目标是窃取 CI 密钥，而这些软件包发布则是自动发布的副产品。</p><p>研究人员还发现其与 2025 年<a href=\"https://www.bleepingcomputer.com/news/security/hackers-steal-3-325-secrets-in-ghostaction-github-supply-chain-attack/\">GhostAction 攻击活动</a>存在某些重叠。</p><p>建议存储库所有者查找 ‘wfx-docs’ 分支、探测拉取请求以及工作流运行编号中的空缺。</p><p>一旦确认有效载荷执行，应将受影响工作流可访问的所有密钥和云角色视为已泄露，并立即轮换。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/646a709bc4a5de75.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-2\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体会分析电子邮件意图、上下文和行为，以发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>通过为期 14 天的只读扫描检查 Microsoft 365 或 Google Workspace 中有哪些威胁得以穿透，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始您的免费电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","m2uopbxw2xg55pf3fx6t03uwr","攻击者利用 4,837 个劫持 GitHub 账户在 1,806+ 个仓库运行 CI 密钥窃取器","数据窃取","凭据","供应链投毒","云原生","Google","AWS","腾讯","阿里","https://www.bleepingcomputer.com/news/security/hackers-compromise-4-800-github-accounts-to-steal-cloud-credentials/","BleepingComputer",{"_119":120,"_121":-5},"changelogVersion","2026-10-01T08:00","release"]
