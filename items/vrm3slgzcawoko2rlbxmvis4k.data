[{"_1":2,"_3":4},"root",{"_5":100},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795826454000,"id","vrm3slgzcawoko2rlbxmvis4k","title","SAP 确认安全事件，攻击者被指窃取 GitHub 令牌并修改源代码","originalTitle","SAP Security Incident: Stolen Tokens Raise Supply Chain Concerns","summary","SAP 已确认其 IT 系统出现可疑活动，DER SPIEGEL 报道称攻击者窃取员工访问令牌，并在 GitHub 上修改和复制源代码；SAP 尚未确认相关报道的全部细节。","reason","source",{"_74":99},"links",{"_61":98},"publishedAt","2026-11-27T11:39:20.000Z","discoveredAt","2026-11-27T13:06:28.972Z","timelineAt","category","activity","tags",[75,96,97,77],"score",67,"selected",false,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Pierluigi Paganini","body",{"_92":-5,"_61":93,"_94":-5,"_95":36},"outline",[86],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fq9_tz6zOSYM","reportCount",4,"additionalSourceCount",3,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","attack","name","攻击活动","ai-offense","AI 攻防","identity","身份与访问","supply-chain","供应链安全",{"_83":84,"_13":85},"publicId","f277d653-e06d-4b70-92f9-cb4b08781be8","SAP确认开发基础设施遭攻击，GitHub代码疑被篡改",{"_11":87,"_88":89,"_90":91},"sec-1","text","SAP confirms a security incident as reports point to stolen GitHub tokens and al","level",2,"zh","<h2 id=\"sec-1\">SAP confirms a security incident as reports point to stolen GitHub tokens and altered source code. Data breach remains unconfirmed.</h2><p>SAP has confirmed a security incident, and most of the details come from the press, not from the company. The global enterprise found suspicious activity in its IT systems. DER SPIEGEL reported that attackers stole company employees’ access tokens and used them to change and copy source code on GitHub.</p><p><em>“According to information obtained by SPIEGEL, the software manufacturer SAP is now dealing with an incident. The perpetrators may have used AI systems for assistance.” reads the <a href=\"https://www.spiegel.de/netzwelt/sap-wird-opfer-von-hackerangriff-a-6648b5ce-5d74-48dc-86ea-9469705bb91d\">report</a> published by DER SPIEGEL.</em></p><p>The German software maker says it took immediate steps to protect customers and secure its services.</p><p>SAP says investigators had found no evidence of unauthorized access to customer business data at that stage. It didn’t answer detailed questions about the incident. An internal memo cited by Spiegel calls the incident active, and SAP is reportedly handling the investigation under the name “Project Granite”.</p><p>Sources inside the software giant also told Spiegel that the attackers may have used AI agents. SAP has not confirmed this, and it is still unclear whether AI played any role in the attack. For now, this should be treated as an unconfirmed report.</p><p>Employees were reportedly told not to discuss the incident. The report also says SAP management does not believe it needs to inform customers proactively. SAP reportedly told German broadcaster Tagesschau that customer data was not affected.</p><p>SAP has not disclosed how the attackers obtained the employees’ tokens. Cybersecurity News recently <a href=\"https://cybersecuritynews.com/sap-security-incident/#google_vignette\">reported</a> a separate case in which a malicious VS Code extension stole GitHub tokens, but there is no evidence linking that attack to the SAP incident.</p><p>SAP publishes source code for its products and open-source projects on GitHub. However, the report does not say which repositories were affected or whether the stolen code was public or private. This information is important to understand the impact of the incident.</p><p>GitHub’s <a href=\"https://docs.github.com/en/enterprise-cloud@latest/organizations/keeping-your-organization-secure/managing-security-settings-for-your-organization/identifying-audit-log-events-performed-by-an-access-token\">audit log guidance explains</a> how organizations can trace recorded actions back to a compromised token, and administrators can revoke credentials by user and token type. </p><p><strong>Follow me on Twitter:&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a><strong></strong></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;hacking,&nbsp;SAP)</strong></p>","zhKind","complete","供应链","凭据","https://securityaffairs.com/204121/data-breach/sap-security-incident-stolen-tokens-raise-supply-chain-concerns.html","Security Affairs",{"_101":102,"_103":-5},"changelogVersion","2026-10-01T08:00","release"]
