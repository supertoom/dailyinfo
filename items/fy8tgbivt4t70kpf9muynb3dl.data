[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794616828000,"id","fy8tgbivt4t70kpf9muynb3dl","title","Astro 动态标签名属性注入导致 XSS，7.4.5 已修复","originalTitle","Astro: XSS via attribute injection in dynamic tag names","summary","Astro 在动态标签名解析为字符串时存在 XSS 漏洞，攻击者可通过 `/` 注入属性，影响使用不可信输入作为元素名的应用。受影响版本为 `astro` <= 7.4.4，`astro` 7.4.5 已修复并限制动态字符串仅渲染有效元素名；升级前应将输入映射到固定标签集合。","reason","source",{"_68":78},"links",{"_59":77},"publishedAt","2026-11-13T18:39:54.000Z","discoveredAt","2026-11-13T18:51:25.887Z","timelineAt","category","vuln","tags",[74,75,76],"score",45,"selected",false,"channel","news","story",{"_71":72,"_13":73},"x","readingMode","full","author","body","outline",[],"relatedStories",[70],"topics",[66],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","f3XC3VG6q7wE","reportCount",1,"additionalSourceCount",0,{"_67":30,"_68":69},"slug","name","漏洞披露",{"_71":72,"_13":73},"publicId","29ea1af6-1484-4624-8e19-db7ed517793c","Astro动态标签XSS漏洞已修复","漏洞","补丁","复现","https://github.com/advisories/GHSA-mh32-jxcr-mh9f","GitHub 安全公告",{"_80":81,"_82":-5},"changelogVersion","2026-10-01T08:00","release"]
