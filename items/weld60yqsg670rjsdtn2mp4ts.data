[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795394443000,"id","weld60yqsg670rjsdtn2mp4ts","title","Signal 在 Android 和 iOS 默认限制截图，防止 AI Agent 读取私密聊天","originalTitle","Signal Blocks AI Agents From Reading Private Chats via Screenshots on Android and iOS","summary","Signal 宣布在 Android 和 iOS 默认限制截图，阻止内置于 iOS 27 及可检测 AI 助手的 Android 系统中的 AI Agent 读取聊天内容，但承认该措施仍不完整。","reason","source",{"_75":97},"links",{"_61":96},"publishedAt","2026-11-21T08:49:20.000Z","discoveredAt","2026-11-21T09:24:45.965Z","timelineAt","category","ai-security","tags",[77,92,79,93,94,95],"score",59,"selected",false,"channel","news","story",{"_85":86,"_13":87},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_88":-5,"_61":89,"_90":-5,"_91":36},"outline",[],"relatedStories",[84],"topics",[68,69,70,71,72],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","famSDoGVPh44","reportCount",2,"additionalSourceCount",1,{"_73":82,"_75":83},{"_73":80,"_75":81},{"_73":78,"_75":79},{"_73":30,"_75":77},{"_73":74,"_75":76},"slug","blue-team","name","蓝队与运营","AI 安全","mobile","移动端","apple","Apple / 苹果","google","Google / 谷歌",{"_85":86,"_13":87},"publicId","aae0b52f-d7e1-4731-a260-ac5ba36ea7ba","Signal默认限制AI读取聊天屏幕","zh","<p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEj1cVX1DZUDMTkSc3kGcO8KsGd-MIBr6py39SuaRxG1wCxVVfKIQhiQaywRpjn95FQV4tMy0dWyNc49745cwqBBLpGzVK_eut-DGLBaidiiYCdIH65bXGtopuPJ7dofJzAJVJ6cWrKp2JJb5gNrODQuWtK7vZZp824ecrz4_DHWWJIaC5wS6aYfsMsKshg4/s1600/signal.jpg\"><img alt=\"\" src=\"/dailyinfo/media/468370e3403ac9df.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>Signal has announced that it will restrict screenshots by default to stop artificial intelligence (AI) agents from reading private chats on Android and iOS devices, but conceded that the protection is \"incomplete.\"</p><p>The feature applies to agentic systems built into iOS 27 and on Android versions where the encrypted messaging platform can detect an AI assistant attempting to read the Signal screen.</p><p>It also builds upon a similar setting that Signal <a href=\"https://thehackernews.com/2025/05/weekly-recap-apt-campaigns-browser.html#:~:text=Signal%20Says%20No%20to%20Recall\">introduced</a> in Windows 11 last May following Microsoft's release of the controversial Recall feature.</p><p>Calling the agentic integrations into Android, iOS, and Windows an \"existential threat to Signal,\" Meredith Whittaker, president of the Signal Foundation, said the move is designed to uphold its privacy guarantees in the AI era.</p><p>\"In order to gain access to information about you, these OS AI agents 'scan' the information that's on your screen,\" Whittaker <a href=\"https://signal.org/blog/protecting-your-privacy/\">said</a>. \"In doing so, your Signal data is captured, then made available to these agentic systems in order to allow them to answer your questions and do your bidding.\"</p><p>\"The net result is that these AI capabilities in the operating system are undermining Signal's ability to independently guarantee privacy.\"</p><p>The risk here is that AI agents can capture and store the information accessed from Signal either locally or on remote servers, with the activity occurring outside of the platform's control and potentially putting the privacy of all the participants in a conversation at risk.</p><p>Users who want to disable the option can do so by navigating to Settings &gt; Privacy &gt; App Security &gt; toggle \"Block Siri AI\" (on iOS) or \"Screen security\" (on Android).</p><p>\"However, doing so will potentially expose your (and your contacts') Signal content to these AI agents, and break our privacy guarantees,\" Signal said.</p><p>\"Our remedy is also incomplete – while we are doing everything we can, restricting screenshots does not address other more sneaky ways AI agents could potentially access application data, such as retrieving content already present on a user's device via the file system.\"</p><p>Signal also pointed out that application developers lack robust tools to prevent AI agents from eroding application-level privacy. It also called out the companies for failing to provide adequate documentation about how these systems work to help design necessary controls to prevent the agents from accessing sensitive application data.</p><p>Specifically, it's urging the tech giants to provide \"two common-sense remedies\" to help protect the privacy of its users -</p><ul>\n  <li>Access to easy and well-documented way to opt their app out of AI data access and processing entirely, including screen reading, filesystem access, notifications, APIs, and other OS frameworks, without making drastic compromises to the core user experience</li>\n  <li>Create better documentation and technical specifications around how AI agents function, specifically with regards to data access and processing</li>\n</ul><p>The concerns are not theoretical. Reuters recently <a href=\"https://www.reuters.com/investigations/meta-bets-big-muse-ai-agent-early-safety-mishaps-surface-2026-11-18/\">reported</a> that Muse, Meta's AI agent, was able to bypass its own official \"Connector\" tool to obtain access to Signal messages on both an Apple computer and an Android device by taking advantage of the broad operating system permissions granted to it during initial setup.</p><p>On macOS, for example, the agent leveraged macOS's accessibility and screenshot tools to navigate to the Signal app, take screenshots, extract text from those images, and regenerate the textual content within the Muse app. On Android, it read messages by abusing its access to the device's push notifications.</p><p>In one case highlighted by the news agency, the AI agent alerted a Meta staffer using Muse on her personal phone with a reminder to respond to a message from her sister on Signal. \"This seems like an extreme privacy violation. I definitely did not grant it access to other apps, or recall being asked about this,\" the employee said in an internal post.</p><p>\"We also see a growing need for tools that can prevent third-party agents, like Meta's Muse, from accessing application data using the deep permissions that users are encouraged to grant them during setup,\" Whittaker said.</p><p>\"In many cases these agents are leveraging accessibility settings that were meant to empower actual people to get the most out of their apps and services, not to act as a skeleton key that provides access to AI agents.\"&nbsp;</p><p>Late last month, Apple <a href=\"https://support.apple.com/149076\">released</a> iOS 27.2 with an \"Excluded Apps\" option that <a href=\"https://www.eff.org/deeplinks/2026/10/victory-you-can-now-exclude-apps-siri-ai\">lets users</a> choose which apps Siri, Search, and suggestions can access. With Google Gemini, users have the <a href=\"https://support.google.com/gemini/answer/13695044\">ability to disconnect apps</a> via the Connected Apps settings.</p><p>Earlier this week, the iPhone maker also <a href=\"https://thehackernews.com/2026/11/apple-tightens-macos-app-permissions-to.html\">previewed</a> new controls that allow Mac users to give more granular access to data they give to apps, including those that use artificial intelligence (AI) agents.</p><p>Found this article interesting?  Follow us on <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>, <a href=\"https://twitter.com/thehackersnews\">Twitter</a> and <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a> to read more exclusive content we post.</p>","zhKind","complete","Agent 安全","加固","Apple","Google","https://thehackernews.com/2026/11/signal-blocks-ai-agents-from-reading.html","The Hacker News",{"_99":100,"_101":-5},"changelogVersion","2026-10-01T08:00","release"]
