[{"_1":2,"_3":4},"root",{"_5":90},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795308036000,"id","mg2hvvx1gkkrqp4l17mvgnrr8","title","奇安信 CERT 复现 LibreOffice 远程代码执行漏洞 CVE-2026-104692、CVE-2026-104007","originalTitle","【已复现】LibreOffice 远程代码执行漏洞(CVE-2026-104692、CVE-2026-104007)安全风险通告","summary","奇安信 CERT 已复现 LibreOffice 远程代码执行漏洞 CVE-2026-104692、CVE-2026-104007，攻击者可通过特制 ODS 文档在用户打开时实现任意代码执行，无需宏警告或额外交互。","reason","文章给出利用链、复现结果和明确版本区间，可据此识别高风险部署并确定升级或临时缓解范围。","source",{"_71":89},"links",{"_80":88},"publishedAt","2026-11-17T09:06:00.000Z","discoveredAt","2026-11-17T10:07:31.949Z","timelineAt","category","vuln","tags",[83,84,85,86,74,87],"score",79,"selected",true,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","body",{"_61":79,"_80":-5,"_81":80,"_82":37},"outline",[],"relatedStories",[75],"topics",[68,69],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fYCTACQi7QF0","reportCount",2,"additionalSourceCount",1,{"_70":73,"_71":74},{"_70":31,"_71":72},"slug","name","漏洞披露","qianxin","奇安信",{"_76":77,"_13":78},"publicId","6355da97-edac-414c-84c5-0bd3cbc03cd4","LibreOffice双漏洞RCE链已复现并获修复","<p><span>奇安信 CERT</span> <span>2026-11-17 17:06</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/1cd860e1acf4d7a8.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>致力于第一时间为企业级用户提供权威漏洞情报和有效解决方案。</p><p><span><span>●&nbsp;</span></span><span><span>点击↑蓝字关注我们，获取更多安全风险通告。</span></span></p><hr><table><tbody><tr><td colspan=\"4\" align=\"center\"><p><span><strong><span><span>漏洞概述</span></span></strong></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>漏洞名称</span></span></strong></span></p></td><td colspan=\"3\" align=\"left\"><p><span><span>LibreOffice 远程代码执行漏洞</span></span></p></td></tr><tr><td align=\"left\"><p><span><span><strong><span>漏洞编号</span></strong></span></span></p></td><td colspan=\"3\" align=\"left\"><p><span><span>CVE-2026-104692、CVE-2026-104007</span></span></p></td></tr><tr><td align=\"left\"><p><strong><span><strong><span><span>公开时间</span></span></strong></span></strong></p></td><td align=\"left\"><p><span><span>2026-11-16</span></span></p></td><td align=\"left\"><p><strong><span><strong><span><span>影响量级</span></span></strong></span></strong></p></td><td align=\"left\"><p><span><span>十万级</span></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>奇安信评级</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>高危</span></span></strong></span></p></td><td align=\"left\"><p><strong><span><span>CVSS 4.0分数</span></span></strong></p></td><td align=\"left\"><p><span><span><strong><span>8.5</span></strong></span></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span>威胁类型</span></strong></span></p></td><td align=\"left\"><p><span><span><span>代码执行</span></span></span></p></td><td align=\"left\"><p><strong><span><span>利用可能性</span></span></strong></p></td><td align=\"left\"><p><strong><span><strong><span>高</span></strong></span></strong></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>POC状态</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>已公开</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>在野利用状态</span></span></strong></span></p></td><td align=\"left\"><p><span><span><span>未发现</span></span></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>EXP状态</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span><span>已公开</span></span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>技术细节状态</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span><span>已公开</span></span></span></strong></span></p></td></tr><tr><td colspan=\"4\" align=\"left\"><p><strong><span><span>危害描述：</span></span></strong><span><span>攻击者可构造特制的 ODS 电子表格文件，利用表单自动加载、HTTP 外部 ODB 下载、SQL 转义绕过等特性，在用户仅打开文档时（无需宏警告或额外交互）实现任意代码执行，从而完全控制系统。</span></span></p></td></tr></tbody></table><p><strong><span>0</span></strong><strong><span>1</span></strong></p><p><strong><span>漏洞详情</span></strong></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>影响组件</span></span></strong></p><p><span>LibreOffice 是一款免费开源的办公套件，由 The Document Foundation 维护，提供文字处理、电子表格、演示文稿、数据库和绘图等完整功能。它兼容 Microsoft Office 格式，支持跨 Windows、macOS、Linux 等多平台运行，广泛应用于个人、教育和企业办公环境，具备高度可扩展性和开放性。</span></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>漏洞描述</span></span></strong></p><p><span>近日，奇安信CERT监测到官方修复<span>LibreOffice 远程代码执行漏洞(CVE-2026-104692、CVE-2026-104007)</span>。CVE-2026-104692 源于捆绑的 HSQLDB 数据库引擎在通过通用 JDBC 驱动使用时，未能正确强制执行 Java 方法白名单机制，导致 SQL 语句可调用任意 Java 方法；CVE-2026-104007 源于数据库文档（ODB）中的 JDBC 驱动路径（JavaDriverClassPath）可被恶意文档控制，且在通过表单数据源外部引用时绕过了属性剥离过滤。攻击者可构造特制的 ODS 电子表格文件，利用表单自动加载、HTTP 外部 ODB 下载、SQL 转义绕过等特性，在用户仅打开文档时（无需宏警告或额外交互）实现任意代码执行，从而完全控制系统。<span>目前该漏洞PoC和技术细节已公开。</span></span><span><span>鉴于该漏洞影响范围较大，建议客户尽快做好自查及防护。</span></span></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>利用条件</span></span></strong></p><p><span><span>1.目标安装 LibreOffice 受影响版本，并启用了 Java 运行时。</span></span></p><p><span><span>2.用户打开（或预览）攻击者构造的恶意电子表格文档（ODS/ODF）。</span></span></p><p><strong><span>02</span></strong></p><p><strong><span>影响范围</span></strong></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>影响版本</span></span></strong></p><p><span>26.2 &lt;= LibreOffice &lt; 26.2.7</span></p><p><span>26.8 &lt;= LibreOffice &lt; 26.8.2</span></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>其他受影响组件</span></span></strong></p><p><span><span>无</span></span></p><p><strong><span>03</span></strong></p><p><strong><span>复现情况</span></strong></p><p><span><span>目前，</span><span>奇安信CERT已成功复现</span><span><span>LibreOffice 远程代码执行漏洞(CVE-2026-104692、CVE-2026-104007)</span></span><span>，截图如下：</span></span></p><p><img src=\"/dailyinfo/media/282df8a81e806375.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>04</span></strong></p><p><strong><span>处置建议</span></strong></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>安全更新</span></span></strong></p><p><span>官方已发布安全补丁，请及时更新至最新版本：</span></p><p><span>LibreOffice 26.2.* &gt;= 26.2.7</span></p><p><span>LibreOffice 26.8.* &gt;= 26.8.2</span></p><p><span>下载地址：</span></p><p><span><a href=\"https://www.libreoffice.org/download/\">https://www.libreoffice.org/download/</a></span></p><p><span><span>临时缓解措施：</span></span></p><p><span>1.临时禁用 LibreOffice 中的 Java 支持（工具 → 选项 → LibreOffice → 高级）。</span></p><p><span>2.避免打开来自不可信来源的文档，尤其是电子表格和包含数据库链接的文件。</span></p><p><strong><span>05</span></strong></p><p><strong><span>参考资料</span></strong></p><p><span><span>[1]<a href=\"https://www.libreoffice.org/about-us/security/advisories/cve-2026-104692\">https://www.libreoffice.org/about-us/security/advisories/cve-2026-104692</a></span></span></p><p><span><span>[2]</span><span><a href=\"https://www.libreoffice.org/about-us/security/advisories/cve-2026-104007\">https://www.libreoffice.org/about-us/security/advisories/cve-2026-104007</a></span></span></p><p><span><span>[3]</span><span><a href=\"https://ii4gsp.github.io/libreoffice-rce/\">https://ii4gsp.github.io/libreoffice-rce/</a></span></span></p><p><strong><span>06</span></strong></p><p><strong><span>时间线</span></strong></p><p><span><span>2026年11月17日，奇安信 CERT发布安全风险通告。</span></span></p><p><strong><span>07</span></strong></p><p><strong><span>漏洞情报服务</span></strong></p><p><span><span>「</span><span>奇安信漏洞情报平台</span><span>」</span><span>重磅上线，诚邀您来体验：</span></span></p><p><img alt=\"图片\" src=\"/dailyinfo/media/5ea364ae0bcecc07.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img alt=\"图片\" src=\"/dailyinfo/media/c5b7b9ae363c76dd.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img alt=\"图片\" title=\"CERT LOGO.png\" width=\"100%\" src=\"/dailyinfo/media/77bd6bd54ea903a7.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><strong><span>奇安信 CERT</span></strong></span></p><p><span><strong><span><span>致力于</span></span></strong><span><span>第一时间为企业级用户提供</span><strong><span><span>权威</span></span></strong><span>漏洞情报和</span></span><strong><span><span>有效</span></span></strong><span><span>解决方案。</span></span></span></p><p><span><span>本文已发布于NCC国家网络安全云社区<a href=\"https://nccsec.cn/security-community\">https://nccsec.cn/security-community</a></span></span></p><p><span><span><span>点击↓</span><strong><span><span>阅读原文</span></span></strong><span>，到</span></span><strong><span><span>ALPHA威胁分析平台</span></span></strong><span><span>订阅更多漏洞信息。</span></span></span></p><p><a href=\"https://ti.qianxin.com/portal/subscription\">阅读原文</a></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=a279994c&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzU5NDgxODU1MQ%3D%3D%26mid%3D2247508132%26idx%3D1%26sn%3D765cffd533b8087793a59834cabdc0dd\">跳转微信打开</a></p>","original","zhKind","complete","漏洞","复现","漏洞利用","补丁","数据库","https://mp.weixin.qq.com/s?__biz=MzU5NDgxODU1MQ==&mid=2247508132&idx=1&sn=765cffd533b8087793a59834cabdc0dd","奇安信 CERT",{"_91":92,"_93":-5},"changelogVersion","2026-10-01T08:00","release"]
