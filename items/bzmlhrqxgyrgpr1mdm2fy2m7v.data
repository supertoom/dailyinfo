[{"_1":2,"_3":4},"root",{"_5":101},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1795048829000,"id","bzmlhrqxgyrgpr1mdm2fy2m7v","title","勒索软件访问中介从公开论坛转向私人渠道，2026 年受害者声明已超 2025 年","originalTitle","Ransomware access brokers are moving their deals off public forums","summary","ZeroFox 统计显示，勒索与敲诈团伙截至 2026 年 10 月每月声称约 718 名受害者，高于 2025 年每月约 573 名；第三季度记录至少 2,381 起事件，比此前最高的 2,091 起高约 14%。","reason","公开论坛交易减少并不代表勒索活动降温，文章用受害者数量、渠道转移和凭证价格说明监测重点正在变化。","source",{"_67":100},"links",{"_90":99},"publishedAt","2026-11-18T23:28:20.000Z","discoveredAt","2026-11-19T00:01:33.443Z","timelineAt","category","activity","tags",[68,94,95,96,97,98],"score",72,"selected",true,"channel","news","story","x","readingMode","full","author","Anamarija Pogorelec","body",{"_59":89,"_90":-5,"_91":92,"_93":37},"outline",[77,78,79],"relatedStories",[],"topics",[60,61,62,63,64],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_65":75,"_67":76},{"_65":73,"_67":74},{"_65":71,"_67":72},{"_65":69,"_67":70},{"_65":66,"_67":68},"slug","attack","name","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","supply-chain","供应链安全","microsoft","Microsoft / 微软",{"_11":87,"_81":88,"_83":84},{"_11":85,"_81":86,"_83":84},{"_11":80,"_81":82,"_83":84},"sec-3","text","当前需要关注的情况","level",3,"sec-2","经纪人的去向","sec-1","事件数量持续攀升","<p>据威胁情报公司 ZeroFox 称，截至 2026 年 10 月，勒索软件和勒索团伙每月声称已造成约 718 起受害事件，高于 2025 年每月约 573 起。从 2025 年初到 2026 年初，公开出售入侵企业网络访问权限的暗网列表每季度从约 620 条降至约 370 条。</p><p><img src=\"/dailyinfo/media/a4c06b31d38a3ecc.webp\" loading=\"lazy\" decoding=\"async\" alt=\"ransomware access brokers\" title=\"Ransomware\"></p><p>这些列表起到了早期预警作用。经纪人宣传已取得某家公司网络的立足点，可能预示某个勒索软件团伙下一步就会行动研究人员称，这一下降极有可能并不代表犯罪活动减少。经纪人将这些销售从公开论坛转移到私人渠道，而私人渠道的监控难度要大得多。</p><h3 id=\"sec-1\">事件数量持续攀升</h3><p>研究人员记录了 2026 年第三季度至少 2,381 起事件，这是其记录中数量最多的一个季度，比 2025 年末创下的此前最高纪录 2,091 起高出约 14%。仅 10 月就新增 852 起。截至 10 月底，2026 年总数已经超过 2025 年全年，而 2025 年本身就是一个创纪录的年份。</p><p>这些是团伙声称的受害事件，通常发布在泄露网站上，目的是迫使企业付款。研究人员预计，未经验证或夸大的泄露声明将在 2027 年成为常态。泄露网站上的公司名称只是线索，仍需进一步确认。</p><p>Qilin 是最活跃的团伙，在截至 11 月 2 日记录的 7,239 起事件中至少涉及 1,104 起，约占 15%。The Gentlemen 以 935 起紧随其后。研究人员预计，2027 年的增长将来自更多团伙进入这一行业。北美仍是受攻击最集中的地区，但其占比从 2025 年下半年的约 59% 降至自 2026 年 7 月以来每月 46% 至 48%；亚太和南美洲的占比则达到至少自 2024 年初以来的最高水平。</p><h3 id=\"sec-2\">经纪人的去向</h3><p>初始访问经纪人是勒索软件经济中的中间人。他们入侵系统，然后将立足点出售给愿意实施攻击的人。在过去一年半里，他们失去了主要交易场所：当局于 2025 年 7 月查封了 XSS 论坛，并于 2026 年 1 月查封了 RAMP，<a href=\"https://www.helpnetsecurity.com/2026/03/05/europol-leakbase-forum-takedown/\">LeakBase 也于 2026 年 3 月下线</a>。经纪人将交易转移到私人渠道，其中加密即时通讯工具 Tox 最受欢迎；一些勒索软件团伙似乎也开始自行处理访问权限交易。</p><p>价格在这一过程中出现分化。2023 年初平均价格约为 $1,427 的基础访问权限，到 2026 年第三季度售价已低于 $500。域管理员凭据是进入一家公司 Windows 网络的钥匙，平均价格约为 $8,000。低端价格如今像大宗商品一样交易；高端交易则通过研究人员预计会保持私密的关系进行。</p><h3 id=\"sec-3\">当前需要关注的情况</h3><p>交易标的变化也在发生。研究人员预计，会有更多关于会话令牌的列表出售。会话令牌是用户登录并完成<a href=\"https://www.helpnetsecurity.com/2026/03/13/mfa-security-limitations-video/\">多因素身份验证</a>后，浏览器保存的凭证。被窃取的令牌可以让攻击者无需登录便直接进入系统。他们还预计，对供应商和集成提供商访问权限的出售价格会更高，因为入侵一家公司就能触达众多客户。</p><p>这种模式已经出现。2025 年 8 月至 2026 年 6 月，使用 ShinyHunters 名号的攻击者<a href=\"https://www.helpnetsecurity.com/2025/11/20/salesforce-investigates-new-incident-echoing-salesloft-drift-compromise/\">入侵了 Salesloft Drift、Gainsight 和 </a><a href=\"https://www.helpnetsecurity.com/2026/06/19/klue-salesforce-data-breach-huntress/\">Klue</a> 的 OAuth 令牌，随后通过授权会话访问客户的 <a href=\"https://www.helpnetsecurity.com/2026/03/11/shinyhunters-salesforce-aura-data-breach/\">Salesforce 数据</a>，而登录监控未能发现这些行为。</p><p>如果你的程序依赖暗网监控来及早发现入侵，那么到 2027 年，它能看到的将会更少。有用的检查离你更近。哪些供应商在你的 SaaS 工具中持有长期有效的令牌？你会注意到一个看起来异常的会话吗？而当有人致电服务台要求重置密码时，你的团队如何确认电话那头的是本人？最后一项正受到检验。到 2026 年中，针对 Microsoft Teams 的恶意 <a href=\"https://www.helpnetsecurity.com/2026/07/17/research-ai-voice-phishing/\">语音钓鱼</a>尝试已达到 2025 年年中每周水平的近 10 倍。</p>","original","zhKind","translation","complete","勒索","黑产","数据窃取","供应链","Microsoft","https://www.helpnetsecurity.com/2026/11/19/ransomware-access-brokers-cybercrime/","Help Net Security",{"_102":103,"_104":-5},"changelogVersion","2026-10-01T08:00","release"]
