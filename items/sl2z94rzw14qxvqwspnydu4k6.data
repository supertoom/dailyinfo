[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":-5,"_57":36,"_58":59},"expiresAt",1795048837000,"id","sl2z94rzw14qxvqwspnydu4k6","title","Horizon3.ai：AI 以机器速度发现、串联并利用漏洞的攻防趋势分析","originalTitle","Machine-Speed Offense Is Here. So Is Machine-Speed Proof.","summary","Horizon3.ai 分析称，前沿 AI 已能以机器速度发现、串联并利用漏洞，压缩防御者从弱点发现到攻击武器化之间的时间。该来源认同威胁加剧，但反驳防御者只能等待自主安全到来的观点，强调当前工具与响应速度仍可用于应对。","reason","source",{"_64":77},"links",{"_59":76},"publishedAt","2026-11-18T22:41:21.000Z","discoveredAt","2026-11-18T22:47:35.485Z","timelineAt","category","ai-security","tags",[65,67,74,75],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","Drew Vanover","body",{"_70":-5,"_59":71,"_72":-5,"_73":36},"outline",[],"relatedStories",[],"topics",[60,61,62],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_63":68,"_64":69},{"_63":66,"_64":67},{"_63":30,"_64":65},"slug","name","AI 安全","ai-offense","AI 攻防","ai-agent","AI Agent 安全","zh","<p>Frontier AI can now find, chain and exploit vulnerabilities at machine speed. The time defenders once had between a weakness being discovered and being weaponized is collapsing. A common conclusion is that defenders are now in a waiting period. Autonomous security is coming, the argument goes, and until it arrives we hold on with the tools and tempo we have. We agree that the threat is…</p><p><a href=\"https://horizon3.ai/intelligence/blogs/machine-speed-offense-machine-speed-proof/\">Source</a></p>","zhKind","complete","大模型","漏洞利用","https://horizon3.ai/intelligence/blogs/machine-speed-offense-machine-speed-proof/","Horizon3.ai",{"_79":80,"_81":-5},"changelogVersion","2026-10-01T08:00","release"]
