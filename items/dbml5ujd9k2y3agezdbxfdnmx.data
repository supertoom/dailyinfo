[{"_1":2,"_3":4},"root",{"_5":110},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795480834000,"id","dbml5ujd9k2y3agezdbxfdnmx","title","BADBOX 3.0 botnet 回归，每日发起 40 亿次欺诈广告竞价请求","originalTitle","BADBOX botnet returns with record-breaking 40 billion daily ad requests","summary","HUMAN 的 Satori 研究人员发现 BADBOX 3.0 通过受感染的 Android 设备每日发起约 40 billion 次欺诈广告竞价请求，峰值占其观察到的 CTV 流量的 4% 以上。","reason","材料揭示 BADBOX 3.0 通过感染 Android 设备实施广告欺诈与流量代理，并给出请求规模、代理网络和历史处置数据。","source",{"_76":109},"links",{"_102":108},"publishedAt","2026-11-21T15:17:27.000Z","discoveredAt","2026-11-21T16:09:45.367Z","timelineAt","category","activity","tags",[79,77,81,85,106,107],"score",73,"selected",true,"channel","news","story",{"_89":90,"_13":91},"x","readingMode","full","author","Bill Toulas","body",{"_61":101,"_102":-5,"_103":104,"_105":37},"outline",[92,93],"relatedStories",[88],"topics",[68,69,70,71,72,73],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","f0__GhdwcS3s","reportCount",5,"additionalSourceCount",4,{"_74":86,"_76":87},{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","malware","name","恶意软件","attack","攻击活动","botnet","僵尸网络","iot","IoT 与车联网","mobile","移动端","google","Google / 谷歌",{"_89":90,"_13":91},"publicId","14a0fad8-66ec-4bda-ac82-e2bc652b68c2","HUMAN披露并处置BADBOX 3.0广告欺诈网络",{"_11":99,"_95":100,"_97":98},{"_11":94,"_95":96,"_97":98},"sec-2","text","发现现有防御措施可能遗漏的邮件威胁。","level",2,"sec-1","BadBox 回归","<p><img alt=\"Android TV\" height=\"900\" src=\"/dailyinfo/media/58916f0361b532e5.jpg\" srcset=\"/dailyinfo/media/d4f10fd3cb7dd62f.jpg 720w, /dailyinfo/media/b90f444cd7f42605.jpg 1200w, /dailyinfo/media/58916f0361b532e5.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>BADBOX 恶意软件僵尸网络在去年的中断事件后卷土重来，每天通过受感染的 Android 设备产生创纪录的 400 亿次欺诈广告竞价请求。</p><p>据 HUMAN 的 Satori研究人员称，他们发现并挫败了这一最新变种，BADBOX 3.0 已按每日竞价请求量成长为有记录以来规模最大的广告欺诈行动。</p><p>BADBOX <a href=\"https://www.bleepingcomputer.com/news/security/android-tv-box-on-amazon-came-pre-installed-with-malware/\">最早于 2023 年初被发现</a>，当时是在 Amazon 上购买的一台 T95 Android TV 机顶盒上发现的。2024 年 12 月，德国网络安全机构警告称，该僵尸网络已<a href=\"https://www.bleepingcomputer.com/news/security/germany-blocks-badbox-malware-loaded-on-30-000-android-devices/\">感染数万台设备</a>。</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/ec0400265c732eea.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>2025 年 3 月，一次大规模<a href=\"https://www.bleepingcomputer.com/news/security/badbox-malware-disrupted-on-500k-infected-android-devices/\">中断行动</a>展开，HUMAN 和 Shadowserver 将超过 500,000 台 BADBOX 2.0 设备与其控制服务器切断，同时 Google 从 Google Play 下架了 24 个传播该恶意软件的应用。</p><p>Google 随后<a href=\"https://www.bleepingcomputer.com/news/security/google-sues-to-disrupt-badbox-20-botnet-infecting-10-million-devices/\">起诉了该僵尸网络运营者</a>，称截至 2025 年 4 月，BADBOX 2.0 已感染超过 1,000 万台 Android 设备。</p><h2 id=\"sec-1\">BadBox 回归</h2><p>然而，此前的中断行动并未阻止 BADBOX 运营者重建该僵尸网络，并为其每日欺诈广告竞价请求量再创新高。</p><p>HUMAN <a href=\"https://www.humansecurity.com/learn/blog/satori-threat-intelligence-disruption-badbox-3-0-hides-the-largest-ad-fraud-operation-ever-disclosed-inside-infected-tv-boxes/\">报告称</a>，“BADBOX 3.0 高峰时期每天约占 400 亿次竞价请求，并占 Human Defense Platform 观测到的全部 CTV 流量的 4% 以上。”</p><p>“BADBOX 3.0 的请求量是此前纪录保持者 VASTFLUX 的三倍以上，其峰值也超过了过去五年已发布的 Satori 调查的总和。”</p><figure><img alt=\"Bid requests volume\" height=\"506\" src=\"/dailyinfo/media/4a39402237e6f325.jpg\" srcset=\"/dailyinfo/media/6ff99912a099ffb1.jpg 720w, /dailyinfo/media/576cb7fb05fb47b5.jpg 1200w, /dailyinfo/media/4a39402237e6f325.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"999\">\n<figcaption><strong>竞价请求量</strong><br>\n<em>来源：HUMAN</em></figcaption>\n</figure><p>其作案手法保持不变：感染运行 Android Open Source Project (AOSP) 的廉价手机、平板电脑和流媒体电视盒子，植入执行广告欺诈和流量代理的恶意软件。</p><p>该恶意软件通过在隐藏窗口中播放视频广告来实施广告欺诈，同时冒充合法的流媒体应用，使请求看起来合法。</p><p>HUMAN 还观察到欺诈性的服务端广告插入 (SSAI) 请求，这些请求诱使广告主相信广告已在流媒体设备上播放，实际上并未涉及任何真实设备或视频广告。</p><p>一个代理模块还会在设备所有者不知情或未同意的情况下，将受感染设备纳入 11 个住宅代理网络之一。</p><p>其中一个网络 PXYEDGE 被确定是 IpMoYu 的更名后继者；IpMoYu 是一款此前与 BADBOX 2.0 有关联的住宅代理服务。</p><p>研究人员表示，PXYEDGE 宣称拥有约 200,000 个代理节点，而其监测数据显示，唯一连接数峰值约为 340,000。</p><p>HUMAN 表示，部分广告欺诈流量还通过这些住宅代理进行路由，以显得合法并规避反滥用过滤器。</p><figure><img src=\"/dailyinfo/media/57c9b3b1bab3b626.jpg\" srcset=\"/dailyinfo/media/267c39dde6debed1.jpg 720w, /dailyinfo/media/fbd48f702636a56c.jpg 1200w, /dailyinfo/media/57c9b3b1bab3b626.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"BADBOX operational overview\" height=\"600\" width=\"908\">\n<figcaption><strong>BADBOX 行动概览</strong><br>\n<em>来源：HUMAN</em></figcaption>\n</figure><p>研究人员通过相关域名、代码中的设备专属检查、预装的电视启动器以及一个代码仓库维护者，将该恶意软件与一家特定的中国电子产品制造商联系起来。</p><p>受感染设备从公共代码仓库获取恶意软件模块，同时相同的有效载荷也镜像到多个托管平台上，以实现冗余并抵御下架行动。</p><p>HUMAN 表示，本月初它还参与了 Google <a href=\"https://www.bleepingcomputer.com/news/security/google-disrupts-million-device-xcpe-android-malware-botnet-bans-tv-box-maker/\">对相关 XCPE 恶意软件行动的打击</a>，其中包括下线 BADBOX 3.0 使用的多个 C2 域名。</p><p>此外，其中一个恶意软件存储库已被下架，而 HUMAN 表示，其系统目前会过滤与 BADBOX 3.0 相关的欺诈广告流量。</p><p>然而，HUMAN 警告称，僵尸网络运营者很可能会适应最新的中断措施，就像他们过去所采取的做法一样。</p><p>用户应仅从信誉良好的制造商处购买经过认证的 Android 设备，并确保 Play Protect 可用且已启用。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/af2e1e4209b93434.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-2\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御措施可能遗漏的邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 代理会分析邮件意图、上下文和行为，以发现网络钓鱼、商务电子邮件入侵和发票欺诈。</p><p>通过为 Microsoft 365 或 Google Workspace 进行为期 14 天的只读扫描，查看有哪些内容成功绕过防护，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始您的免费邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","IoT","Google","https://www.bleepingcomputer.com/news/security/badbox-30-botnet-returns-with-record-breaking-40-billion-daily-ad-requests/","BleepingComputer",{"_111":112,"_113":-5},"changelogVersion","2026-10-01T08:00","release"]
