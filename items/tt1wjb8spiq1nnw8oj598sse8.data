[{"_1":2,"_3":4},"root",{"_5":114},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795740048000,"id","tt1wjb8spiq1nnw8oj598sse8","title","GoodGuys 钓鱼活动伪装 Google、Nvidia 等品牌，窃取企业账号凭据","originalTitle","Fake paid expert interviews impersonate brands to steal Google logins","summary","Push Security 发现名为 GoodGuys 的持续钓鱼活动，自 October 13 起追踪，冒充 Accenture、Google Cloud、Nvidia、SpaceX、Spotify 等 8 家公司，以最高 $600 的付费专家访谈或网络研讨会邀请诱导受害者登录。","reason","source",{"_77":113},"links",{"_61":112},"publishedAt","2026-11-26T17:15:27.000Z","discoveredAt","2026-11-26T17:19:19.606Z","timelineAt","category","activity","tags",[78,105,106,107,108,109,110,111],"score",65,"selected",false,"channel","news","story",{"_92":93,"_13":94},"x","readingMode","full","author","Lawrence Abrams","body",{"_101":-5,"_61":102,"_103":-5,"_104":36},"outline",[95],"relatedStories",[91],"topics",[68,69,70,71,72,73,74],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fNAUanZz93SY","reportCount",1,"additionalSourceCount",0,{"_75":89,"_77":90},{"_75":87,"_77":88},{"_75":85,"_77":86},{"_75":83,"_77":84},{"_75":81,"_77":82},{"_75":79,"_77":80},{"_75":76,"_77":78},"slug","attack","name","攻击活动","ai-offense","AI 攻防","black-market","数据窃取与黑产","ransomware","勒索软件","email","邮件与钓鱼","identity","身份与访问","google","Google / 谷歌",{"_92":93,"_13":94},"publicId","922d9fda-aa5f-4212-8ae8-8ccf2fe3ca0d","GoodGuys付费访谈钓鱼瞄准企业账号",{"_11":96,"_97":98,"_99":100},"sec-1","text","Uncover email threats your existing defenses may miss.","level",2,"zh","<p><img alt=\"Phishing\" height=\"900\" src=\"/dailyinfo/media/4b96e89309a2c788.jpg\" srcset=\"/dailyinfo/media/d5603e5c66947d98.jpg 720w, /dailyinfo/media/26402abb2673cfc5.jpg 1200w, /dailyinfo/media/4b96e89309a2c788.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>An ongoing phishing campaign dubbed \"GoodGuys\" impersonates major brands, including Google, Nvidia, Accenture, and SpaceX, to steal corporate Google and Okta credentials using fake invitations to paid expert interviews and webinars.</p><p>The attacks offer recipients up to $600 for a 45-minute interview in an attempt to get&nbsp;them to sign in with their work accounts to participate.</p><p>The campaign was discovered by cybersecurity firm <a href=\"https://pushsecurity.com/blog/goodguys-phishing-campaign-teardown\">Push Security</a>, which has tracked it since October 13 and found that they impersonate eight companies: Accenture, American Express, Coca-Cola, Culver's, Google Cloud, Nvidia, SpaceX, and Spotify.</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/92bcac73460d74f9.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>The threat actors abuse legitimate email and event platforms, including HireVue, SendGrid, Mandrill, and Cvent, to distribute phishing links.</p><p>In one attack, a phishing email sent through HireVue invited recipients to attend a Google Cloud webinar about deploying AI applications into production.</p><figure><img alt=\"Phishing email impersonating Google Cloud\" height=\"600\" src=\"/dailyinfo/media/eb56008d9dcaf377.webp\" loading=\"lazy\" decoding=\"async\" width=\"599\">\n<figcaption><strong>Phishing email impersonating Google Cloud</strong><br>\n<em>Source: Push Security</em></figcaption>\n</figure><p>The threat actors use domains themed around interviews, webinars,&nbsp;and research studies, creating brand-specific subdomains to host the phishing pages, such as:</p><ul>\n\t<li>accenture[.]international-interviews[.]com</li>\n\t<li>nvidia[.]feedback-study[.]com</li>\n\t<li>google[.]webinar-cloud[.]com</li>\n\t<li>spotify[.]interview-experts[.]com</li>\n</ul><p>Clicking the phishing links typically takes recipients to a CAPTCHA challenge before displaying a website impersonating the company that supposedly sent the invitation.</p><p>Each website features customized branding and lures, with the Nvidia phishing site offering $500 to participate in an AI feedback study and the Accenture site offering $600 for an expert interview.</p><p>The sites ultimately prompt visitors to sign in with their Google accounts to validate their invitations, allowing the attackers to steal their credentials. The phishing kit specifically targets corporate accounts and rejects email addresses associated with Gmail, Yahoo, and Outlook.</p><p>Unlike adversary-in-the-middle (AiTM) phishing kits that use reverse proxies to relay legitimate login pages, GoodGuys uses fake authentication forms controlled by an attacker-controlled server.</p><p>After victims enter their Google credentials, the phishing page can display various multifactor authentication (MFA) challenges, including requests for SMS codes, authenticator codes, and Google sign-in prompts requiring users to select a matching number on their phones.</p><p>The kit also includes fake Okta authentication forms and support for Okta Verify push notifications.</p><p>Push Security believes the threat actors manually attempt to log in using the stolen credentials, instructing the phishing page to display whatever MFA or security challenges Google or Okta show during authentication.</p><p>Similar techniques were used in <a href=\"https://www.bleepingcomputer.com/news/security/okta-sso-accounts-targeted-in-vishing-based-data-theft-attacks/\">vishing-based data theft attacks</a> linked to the ShinyHunters extortion gang earlier this year to steal corporate single sign-on (SSO) credentials.</p><figure><img src=\"/dailyinfo/media/3a31f29c3ceaef5a.webp\" srcset=\"/dailyinfo/media/6489d95bed1e5584.webp 720w, /dailyinfo/media/59051c2073b1351f.webp 1200w, /dailyinfo/media/3a31f29c3ceaef5a.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Suspected GoodGuys credential and MFA relay attack\" height=\"600\" width=\"745\">\n<figcaption><strong>Suspected GoodGuys credential and MFA relay attack</strong><br>\n<em>Source: Push Security</em></figcaption>\n</figure><p>Once the process is completed, the phishing kit&nbsp;redirects victims to another website or displays a message thanking them for their application.</p><p>The researchers believe the phishing kit may have been developed using an AI coding assistant, based on hidden accessibility labels found in every analyzed version of the kit.</p><p>\"The sign-in card in every build carries two hidden labels: \"Sign-in simulation\" and \"GoodGuys sign-in simulation.\" They sit in accessibility text that only screen readers announce, so a visitor never sees them. We think the label is a leftover from how the kit was first built,\" explained Push Security.</p><p>\"Calling the page a sign-in \"simulation\" for a made-up company is the kind of framing someone would use to get an AI coding assistant past its guardrails when asking it to build a phishing page. The label then stayed in every build we've collected.\"</p><p>The researchers also discovered a potentially related phishing campaign that uses fake Coca-Cola interview invitations and the Evilginx phishing kit to target Google Ads accounts.</p><p>While both campaigns used the same abused SendGrid click tracker and identical Coca-Cola branding assets, differences in their code and infrastructure prevented researchers from conclusively linking the attacks to the same threat actor.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/3d0888eec2a1da78.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Uncover email threats your existing defenses may miss.</a>\n        </h2><p>Adaptive Security's AI agents analyze email intent, context, and behavior to uncover phishing, business email compromise, and invoice fraud.</p><p>See what's getting through with a 14-day read-only scan of Microsoft 365 or Google Workspace, with no MX changes.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Start your free email security scan.</a>\n    </p>","zhKind","complete","钓鱼","数据窃取","凭据","AI 编码","Google","Palo Alto","Microsoft","https://www.bleepingcomputer.com/news/apple/fake-paid-expert-interviews-impersonate-brands-to-steal-google-logins/","BleepingComputer",{"_115":116,"_117":-5},"changelogVersion","2026-10-01T08:00","release"]
