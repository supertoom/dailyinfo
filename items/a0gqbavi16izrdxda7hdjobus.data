[{"_1":2,"_3":4},"root",{"_5":94},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1794789625000,"id","a0gqbavi16izrdxda7hdjobus","title","意大利数据保护局对 Meta 处 8.05 亿欧元罚款，指 Facebook 未经同意读取 Android 图库","originalTitle","Meta Fined $887 Million in Italy Over Android Gallery Photos and Videos on Facebook","summary","意大利数据保护局宣布对 Meta 处 805 million 欧元（887 million 美元）罚款，原因是 Facebook 的 Get suggestions from gallery when browsing Facebook 功能在未获具体同意、未作充分告知的情况下使用 Android 用户图库中的照片和视频。","reason","source",{"_73":93},"links",{"_61":92},"publishedAt","2026-11-14T19:00:00.000Z","discoveredAt","2026-11-15T11:18:27.495Z","timelineAt","category","policy","tags",[89,90,91,78],"score",57,"selected",false,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","Associated Press","body",{"_85":-5,"_61":86,"_87":-5,"_88":36},"outline",[],"relatedStories",[81],"topics",[68,69,70,71],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fULr7km2phv4","reportCount",3,"additionalSourceCount",2,{"_72":79,"_73":80},{"_72":77,"_73":78},{"_72":75,"_73":76},{"_72":30,"_73":74},"slug","name","政策法规","compliance","合规与标准","mobile","移动端","google","Google / 谷歌",{"_82":83,"_13":84},"publicId","4b2697c9-e311-4e85-a2db-005e21e0d0d4","意大利重罚Meta默认读取图库","zh","<p><strong>Italy announced an €805 million ($887 million) fine against Meta on Saturday for using photos and videos from Android users’ galleries on Facebook without specific consent or adequate disclosure.</strong>\n\n\n\n</p><p>The Italian Data Protection Authority said the feature, called “Get suggestions from gallery when browsing Facebook,” violated a European privacy directive incorporated into Italian law. The directive protects smartphones as part of a person’s private sphere and requires “free and informed consent” for such access, the authority said.\n\n\n\n</p><p>Investigators found that the feature was enabled by default and that Facebook requested gallery access through a single permission covering multiple app functions with different purposes.\n\n\n\n</p><p>The authority gave Meta 60 days to disable the feature and seek separate consent for its use. Italy has about 20 million Android users, the agency said.\n\n\n\n</p><p>Meta made no immediate comment.\n\n\n\n</p><p>The fine was imposed on Meta Platforms Ireland Limited, which challenged Italy’s jurisdiction, according to the statement.</p><p><span>Advertisement. Scroll to continue reading.</span></p><p>The authority said Meta’s “lack of cooperation” with the investigation factored into the penalty, which amounts to approximately 0.47% of the group’s global turnover.\n      </p>","zhKind","complete","法规","合规","Google","https://www.securityweek.com/meta-fined-887-million-in-italy-over-android-gallery-photos-and-videos-on-facebook/","SecurityWeek",{"_95":96,"_97":-5},"changelogVersion","2026-10-01T08:00","release"]
