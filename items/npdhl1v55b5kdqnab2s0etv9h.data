[{"_1":2,"_3":4},"root",{"_5":120},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794962443000,"id","npdhl1v55b5kdqnab2s0etv9h","title","Rapid7发现CVE-2026-90436已被用于攻击Atlassian Confluence Data Center和N-able N-central","originalTitle","Rapid7 Detected Exploitation of CVE-2026-90436 against Atlassian Confluence Data Center, N-able N-central also Exploited","summary","Rapid7 MDR于11月13日在客户环境中检测到CVE-2026-90436对Atlassian Confluence Data Center的利用，N-able也报告了针对N-central的强关联漏洞在野利用。","reason","Rapid7提供真实客户环境中的利用观测、产品级处置方法和关联IOC，可用于核对暴露系统并排查入侵痕迹。","source",{"_74":119},"links",{"_112":118},"publishedAt","2026-11-16T18:14:14.000Z","discoveredAt","2026-11-16T18:59:19.322Z","timelineAt","category","vuln","tags",[116,75,117,80,46],"score",88,"selected",true,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","Rapid7","body",{"_61":111,"_112":-5,"_113":114,"_115":37},"outline",[85,86,87,88,89,90,91,92],"relatedStories",[81],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","f7gN5trnNh8Y","reportCount",1,"additionalSourceCount",0,{"_72":79,"_74":80},{"_72":77,"_74":78},{"_72":31,"_74":76},{"_72":73,"_74":75},"slug","exploited","name","在野利用","漏洞披露","rapid7","Rapid7 / Metasploit","atlassian","Atlassian",{"_82":83,"_13":84},"publicId","4dfd4cd5-18b8-4842-9dc3-50398f5c7f96","CVE-2026-90436已被用于攻击Confluence",{"_11":109,"_94":110,"_96":97},{"_11":107,"_94":108,"_96":97},{"_11":106,"_94":102,"_96":100},{"_11":105,"_94":99,"_96":100},{"_11":103,"_94":104,"_96":97},{"_11":101,"_94":102,"_96":100},{"_11":98,"_94":99,"_96":100},{"_11":93,"_94":95,"_96":97},"sec-8","text","更新","level",2,"sec-7","N-able N-central",3,"sec-6","Atlassian Confluence Data Center","sec-5","IOC","sec-4","sec-3","sec-2","缓解指导","sec-1","概述","<h2 id=\"sec-1\">概述</h2><p><span>2026年11月6日，Apache Software Foundation 披露了 </span><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-90436\"><span>CVE-2026-90436</span></a><span>，这是 Axis 1.x 中的一个严重不安全反射漏洞（</span><a href=\"https://cwe.mitre.org/data/definitions/470.html\"><span>CWE-470</span></a><span>），可导致未经身份验证的远程代码执行（RCE）。Apache </span><a href=\"https://axis.apache.org/axis/\"><span>Axis</span></a><span> 是一种简单对象访问协议（SOAP）实现，用于创建 Java Web 服务。CISA 为 CVE-2026-90436 分配的 CVSS 评分为 </span><a href=\"https://nvd.nist.gov/vuln-metrics/cvss/v3-calculator?cveId=CVE-2026-90436&amp;vector=CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H&amp;version=3.1&amp;sourceName=CISA-ADP\"><span>9.8 严重</span></a><span>。</span></p><p><span>自11月6日首次披露以来，现已发现 Atlassian </span><a href=\"https://confluence.atlassian.com/security/cve-2026-90436-remote-code-execution-in-confluence-data-center-1874560038.html\"><span>Confluence Data Center</span></a><span> 和 N-able N-central 的某些版本使用了受影响的 Axis 库，容易受到 CVE-2026-90436 的影响。这两款产品都需要采用非默认配置才会存在该漏洞。</span></p><p><span>CVE-2026-90436 现正被actively利用在野，针对两个已知受影响产品。 </span><span><strong>2026年11月13日，Rapid7 MDR 在某客户环境中检测到针对 Atlassian Confluence Data Center 的 CVE-2026-90436 利用活动。</strong></span><span> 另外，2026年11月13日，N-able </span><a href=\"https://uptime.n-able.com/event/202613/\"><span>报告</span></a><span> 了针对 N-central 的在野利用，该漏洞与 CVE-2026-90436 高度</span><a href=\"https://www.acn.gov.it/portale/w/n-able-rilevate-due-ulteriori-catene-di-exploit-denominate-agent2shell-e-4everable2shell-\"><span>相关</span></a><span>。一个利用 CVE-2026-90436 并针对 N-central 的概念验证漏洞利用代码于 2026年11月12日公开，属于针对 N-central 的一</span><a href=\"https://www.rapid7.com/blog/post/etr-critical-vulnerabilities-in-n-able-n-central-prompt-hosted-shutdown/\"><span>系列</span></a><span>公开零日漏洞披露的一部分。</span></p><p><span>Rapid7 建议在正常补丁周期之外，以紧急方式修复暴露的系统。</span></p><h2 id=\"sec-2\">缓解指导</h2><p><span>应优先处理可从互联网访问且已启用相关 API 的实例，并检查内部部署情况。应用下述针对各产品的措施，然后调查曾暴露的系统是否存在失陷证据。</span></p><p><span>Axis 1.x 至 1.4 均受影响，但已停止生命支持（EOL），Apache 不计划发布修复后的 Axis 1.x 版本。Apache 建议迁移到其他 SOAP 引擎（例如 Apache Axis 2），或使用已应用此 </span><a href=\"https://github.com/apache/axis-axis1-java/commit/41f3b4e8d04e310ca81f86b92630ab2c11d608bd\"><span>补丁</span></a><span> 的 Axis 1.x 构建版本。使用受此问题影响产品的组织应遵循产品供应商提供的具体修复说明。</span></p><h3 id=\"sec-3\"><span>Atlassian Confluence Data Center</span></h3><p><span>Atlassian 列为受影响版本的是 1.x 至 9.x，但前提是启用了“Remote API (XML-RPC &amp; SOAP)”。9.2.28 是修复版本。自 3.0 版本起，新安装默认关闭此设置。Confluence 10.x 及更高版本已移除该功能，因此不受影响；Atlassian Cloud 也不受影响。</span></p><p><span>受影响用户应升级至 9.2.28 或当前不受影响的 10.x 版本。如果必须等待补丁，管理员可以打开“General Configuration”和“Further Configuration”，编辑设置，清除“Remote API (XML-RPC &amp; SOAP)”并保存。更改无需重启 Confluence 即可生效，但使用该 API 的集成可能会停止工作。</span></p><p><span>有关最新修复和缓解说明，请遵循 </span><a href=\"https://confluence.atlassian.com/security/cve-2026-90436-remote-code-execution-in-confluence-data-center-1874560038.html\"><span>Confluence 公告</span></a><span>。</span></p><h3 id=\"sec-4\"><span>N-able N-central</span></h3><p><span>本地部署管理员应确认“Legacy API”已禁用，即使在 2026.4 HF2 中也是如此。N-able 表示该功能默认处于关闭状态，并提供了</span><a href=\"https://me.n-able.com/s/article/How-to-Disable-Legacy-API-settings-on-On-premise-N-central-servers\"><span>禁用 Legacy API 的说明</span></a><span>。其 11 月 13 日的指导说明指出，托管环境已直接获得临时保护；采用两种托管模式的客户仍必须遵循供应商有关 Agent 和 Probe 升级的指导。N-able 还出于谨慎考虑，临时禁用了 Intune 集成。请参阅</span><a href=\"https://www.n-able.com/blog/new-security-update-on-n-central\"><span>N-able 安全更新</span></a><span>以了解这些责任事项。</span></p><p><span>N-able 表示 2026.4 HF3 将</span><a href=\"https://www.n-able.com/blog/n-able-vulnerability-remediation-update\"><span>永久移除 Legacy API 访问权限</span></a><span>。其</span><a href=\"https://uptime.n-able.com/event/202659/\"><span>11 月 16 日发布通知</span></a><span>指出，托管环境的升级已完成，本地部署的正式发布工作正在收尾。本地部署管理员应确认可用性，并在更新可用时遵循发布说明。</span></p><h2 id=\"sec-5\">IOC</h2><p><span>日志中出现这些 IOC 应促使开展调查，但缺少这些地址并不能确认环境未受影响。</span></p><h3 id=\"sec-6\"><span>Atlassian Confluence Data Center</span></h3><p><span>以下 IP 地址与已观察到的针对 Atlassian Confluence Data Center 的 CVE-2026-90436 利用活动有关：</span></p><ul><li><p><span>192.238.253[.]176</span></p></li><li><p><span>5.133.47[.]243</span></p></li><li><p><span>163.182.68[.]109</span></p></li><li><p><span>104.13.106[.]166</span></p></li></ul><h3 id=\"sec-7\"><span>N-able N-central</span></h3><p><span>N-able 的</span><a href=\"https://uptime.n-able.com/event/202613/\"><span>11 月 13 日事件更新</span></a><span>将这些 IP 地址列为未禁用 Legacy API 的 N-central 客户的 IOC。</span></p><ul><li><p><span>157.20.241[.]16</span></p></li><li><p><span>139.99.69[.]109</span></p></li><li><p><span>79.76.51[.]56</span></p></li></ul><p><span>供应商的更新还列出了相关 URL，供评估入侵情况时使用。</span></p><h2 id=\"sec-8\">更新</h2><ul><li><p><span><strong>2026 年 11 月 16 日：</strong></span><span>首次发布。</span></p></li></ul>","original","zhKind","translation","complete","漏洞","漏洞利用","https://www.rapid7.com/blog/post/etr-rapid7-detected-exploitation-of-cve-2026-90436-against-atlassian-confluence-data-center-n-able-n-central-also-exploited","Rapid7 CVE 公告",{"_121":122,"_123":-5},"changelogVersion","2026-10-01T08:00","release"]
