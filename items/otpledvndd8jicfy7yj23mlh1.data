[{"_1":2,"_3":4},"root",{"_5":96},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1794876032000,"id","otpledvndd8jicfy7yj23mlh1","title","Google Project Zero 分阶段将漏洞披露期限缩短至30天","originalTitle","Google Project Zero cuts bug disclosures to 30 days amid AI threats","summary","Google Project Zero 将以固定期限取代“90+30”政策：November 13 移除30天延期，February 2, 2027 缩至60天，January 3, 2028 缩至30天；期限届满后，即使尚无修复也会公开漏洞细节。调整源于 AI 加速漏洞发现、利用及补丁逆向，厂商可从在野利用、已有公开利用信息或厂商请求等情形提前披露，部分漏洞仍可不披露。","reason","source",{"_72":95},"links",{"_61":94},"publishedAt","2026-11-16T21:31:44.000Z","discoveredAt","2026-11-16T22:08:15.160Z","timelineAt","category","policy","tags",[92,75,93],"score",54,"selected",false,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","Bill Toulas","body",{"_88":-5,"_61":89,"_90":-5,"_91":36},"outline",[82],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fs7WljsVyNCM","reportCount",5,"additionalSourceCount",4,{"_71":76,"_72":77},{"_71":74,"_72":75},{"_71":30,"_72":73},"slug","name","政策法规","vuln-mgmt","漏洞管理","google","Google / 谷歌",{"_79":80,"_13":81},"publicId","7c8f7946-71df-4ea3-b557-2cd2764d9d03","Project Zero分阶段收紧漏洞披露期",{"_11":83,"_84":85,"_86":87},"sec-1","text","Uncover email threats your existing defenses may miss.","level",2,"zh","<p><img alt=\"Google Project Zero cuts bug disclosure deadline amid AI threats\" height=\"900\" src=\"/dailyinfo/media/35e1d25f437e3181.jpg\" srcset=\"/dailyinfo/media/73640bbdc620e865.jpg 720w, /dailyinfo/media/a910a6f4209a0881.jpg 1200w, /dailyinfo/media/35e1d25f437e3181.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>Google Project Zero will replace its “90+30” disclosure policy with shorter, fixed deadlines in response to AI-accelerated vulnerability discovery and exploitation.</p><p>The transition is gradual and began on November 13, when the 30-day extension was removed from the vulnerability disclosure timeline.</p><p>On February 2, 2027, the deadline will be further reduced to 60 days, and on January 3, 2028, it will shrink to just 30 days.</p><p><a href=\"https://www.wiz.io/lp/ai-security-starter-pack?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Security-Starter-Kit&amp;sfcid=701Vh00000cn7aRIAQ&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AI-Security-Bundle\"><img src=\"/dailyinfo/media/b769cd43b67c492f.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>Once the deadline expires, Project Zero will publish vulnerability details even if a fix is not available.</p><p>Project Zero is Google’s vulnerability research team, focused on the discovery of serious security flaws in widely used software and hardware.</p><p>Some of its notable recent findings include a <a href=\"https://www.bleepingcomputer.com/news/microsoft/microsoft-october-2026-patch-tuesday-fixes-1-411-flaws-3-zero-days/\">.NET Framework zero-day</a>, flaws in <a href=\"https://www.bleepingcomputer.com/news/google/google-says-ai-helped-chrome-fix-1-072-security-bugs-in-two-releases/\">Chrome’s JavaScript engine</a> and graphics components, and a <a href=\"https://www.bleepingcomputer.com/news/security/qualcomm-patches-high-severity-zero-day-exploited-in-attacks/\">Qualcomm chipset zero-day</a> linked to <a href=\"https://www.bleepingcomputer.com/news/security/new-android-novispy-spyware-linked-to-qualcomm-zero-day-bugs/\">NoviSpy spyware attacks</a>.</p><p>When the team finds a flaw, it reports it privately to the vendor and typically publishes the technical details after a set period, giving time for developing security updates and patches, as well as a margin for most users to apply them.</p><p>Project Zero says AI has accelerated vulnerability discovery and exploitation, and made it easier for attackers to reverse-engineer fixes as soon as patches ship and develop working exploits.</p><p>This policy change puts greater pressure on vendors to investigate reports, develop fixes, and ship them faster to customers.</p><p>Project Zero said a gradual approach to shortening the disclosure deadline was the better choice, giving vendors time to develop better flaw management and remediation systems.</p><p>Vendors warned Google that jumping straight to 30 days could expose users to severe risks and could lead maintainers to focus on Project Zero findings while ignoring other, potentially more severe flaws reported by others.</p><p>“An overarching concern was that immediately changing the policy could harm users by making unfixed vulnerabilities available to attackers while vendors are in the process of improving their remediation processes and technology,” <a href=\"https://projectzero.google/2026/11/disclosure-policy.html\">Google explained</a>.</p><p>“While the benefits of delaying disclosure are declining due to the increased probability that attackers will discover a vulnerability during the embargo period, we still feel there are benefits in the short term.”</p><p>Project Zero noted some early disclosure exceptions, such as when a flaw is actively exploited in the wild, when others have already published exploitation or vulnerability details, or when a vendor requests early disclosure.</p><p>Exceptions will also apply for non-disclosure, as Google deems fit, using the example of Spectre and Meltdown, for which it previously withheld information for longer than 120 days.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/5441efe9afeba96b.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Uncover email threats your existing defenses may miss.</a>\n        </h2><p>Adaptive Security's AI agents analyze email intent, context, and behavior to uncover phishing, business email compromise, and invoice fraud.</p><p>See what's getting through with a 14-day read-only scan of Microsoft 365 or Google Workspace, with no MX changes.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Start your free email security scan.</a>\n    </p>","zhKind","complete","政策","Google","https://www.bleepingcomputer.com/news/security/google-project-zero-cuts-bug-disclosure-deadline-to-30-days-amid-ai-threats/","BleepingComputer",{"_97":98,"_99":-5},"changelogVersion","2026-10-01T08:00","release"]
