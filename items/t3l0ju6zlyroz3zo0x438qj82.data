[{"_1":2,"_3":4},"root",{"_5":106},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795221641000,"id","t3l0ju6zlyroz3zo0x438qj82","title","研究人员发现 Docker Hub 公开镜像中的云密钥最快 7.86 秒被窃取","originalTitle","Cloud keys leaked in Docker Hub images are stolen within seconds","summary","Stony Brook University 研究人员在 8 个公共容器仓库发布 300 个蜜罐镜像，测得公开镜像中的 AWS、OpenAI 和 Anthropic 凭据会遭自动化扫描器提取利用。","reason","该研究通过蜜罐镜像量化公开容器仓库中的凭据暴露窗口，可为镜像发布前的秘密扫描和访问限速提供实践依据。","source",{"_74":105},"links",{"_93":104},"publishedAt","2026-11-17T21:27:17.000Z","discoveredAt","2026-11-17T21:32:31.462Z","timelineAt","category","disclosure","tags",[75,97,98,99,100,101,102,103],"score",74,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Bill Toulas","body",{"_61":92,"_93":-5,"_94":95,"_96":37},"outline",[86],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fJ03Ou4smvtw","reportCount",1,"additionalSourceCount",0,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","research","name","技术研究","identity","身份与访问","cloud-native","云与原生","supply-chain","供应链安全",{"_83":84,"_13":85},"publicId","0495409e-2a4e-46fc-bd45-0e8289ac16d8","公开容器镜像中的云凭据最快7.86秒被窃取",{"_11":87,"_88":89,"_90":91},"sec-1","text","发现您现有的防御措施可能遗漏的电子邮件威胁。","level",2,"<p><img alt=\"Cloud keys leaked in Docker Hub images are stolen within seconds\" height=\"900\" src=\"/dailyinfo/media/8c8dae440dd727ec.jpg\" srcset=\"/dailyinfo/media/4890fe525ea67d36.jpg 720w, /dailyinfo/media/1461e628241280f5.jpg 1200w, /dailyinfo/media/8c8dae440dd727ec.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>公共 Docker Hub 镜像中暴露的凭据和访问密钥正被攻击者提取和利用，最短在发布后八秒内即可发生。</p><p>Stony Brook University 的两名研究人员 <a href=\"https://www.tsouvalas.xyz/\">Billy Tsouvalas</a> 和 <a href=\"https://www.securitee.org/\">Nick Nikiforakis</a>，通过在八个公共容器注册表中发布共 300 个蜜罐镜像，测量了密钥提取速度。</p><p>在四个月期间，研究人员暴露了&nbsp;AWS、OpenAI 和 Anthropic API 密钥，以及诱饵 SSH 和数据库凭据。</p><p><a href=\"https://www.wiz.io/lp/securing-ai-agents-101?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY26Q3_INB_FORM_Securing-AI-Agents-101&amp;sfcid=701Py00000RTEWMIA5&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AI-Agents-101\"><img src=\"/dailyinfo/media/1a77c37648ba7a60.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>随后，他们监控这些密钥的使用情况，并部署检测工具，在镜像被构建、运行或打开 shell 时通知他们。</p><figure><img alt=\"Honeypot experiment overview\" height=\"162\" src=\"/dailyinfo/media/8a682ad1bec96184.jpg\" srcset=\"/dailyinfo/media/2100f5eae9c8c7cd.jpg 720w, /dailyinfo/media/76ee93ac8c9c4edf.jpg 1200w, /dailyinfo/media/8a682ad1bec96184.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"900\">\n<figcaption><strong>蜜罐实验概览</strong><br>\n<em>来源：&nbsp;containerbots.github.io</em></figcaption>\n</figure><p>这两名研究人员 <a href=\"https://containerbots.github.io/\">介绍了该实验及结果发现</a>，并于昨日在 ACM Conference on Computer and Communications Security (CCS) 上进行了展示。</p><p>他们指出，其镜像被拉取超过&nbsp;75,000 次，植入的 AWS 密钥收到了来自 5,000 个唯一 IP 地址的超过 140,000 次 API 调用。</p><p>AWS 流量呈现出广泛的模式，从检查密钥是否有效，到列出可用资源，有时还会继续消耗这些资源。</p><p>观察到植入的 AWS 密钥最快在镜像发布到 Docker Hub 后 7.86 秒被使用。首次 API 调用的中位时间为 51.19 秒，而全部 100 个 AWS 密钥均在 15 分钟内被使用。</p><figure><img src=\"/dailyinfo/media/832cefcc014875c9.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"API call times after image publication\" height=\"500\" width=\"518\">\n<figcaption><strong>镜像发布后的 API 调用时间</strong><br>\n<em>来源：&nbsp;containerbots.github.io</em></figcaption>\n</figure><p>暴露的 OpenAI 和 Anthropic 密钥很快被劫持，用于耗尽测试账户余额。</p><p>Docker Hub 几乎涵盖了所有 AWS 活动，而实验中的另一个注册表 Harbor 也发现了一些 AWS 密钥滥用行为。</p><p>研究人员将与他们的测试镜像交互的自动化扫描器称为“ContainerBots”，不过这更是一个宽泛的统称，因为这些扫描没有证据表明是由同一批操作人员协调进行的。&nbsp;</p><p>监控很少检测到有人实际运行这些蜜罐镜像，这促使作者得出结论：扫描器通常是通过直接检查镜像层来提取凭据的。</p><p>研究人员解释道：“与我们的镜像交互的扫描器绝大多数是通过静态分析进行的，例如解包镜像层或查询注册表 API 来提取文件系统内容，从未实例化容器。”</p><p>以这种方式暴露密钥在现实世界中很常见 [<a href=\"https://www.bleepingcomputer.com/news/security/thousands-of-images-on-docker-hub-leak-auth-secrets-private-keys/\">1</a>、<a href=\"https://www.bleepingcomputer.com/news/security/over-10-000-docker-hub-images-found-leaking-credentials-auth-keys/\">2</a>、<a href=\"https://www.bleepingcomputer.com/news/security/over-10-000-docker-hub-images-found-leaking-credentials-auth-keys/\">3</a>]，而撤销<a href=\"https://www.bleepingcomputer.com/news/security/hundreds-of-leaked-aws-keys-give-full-control-over-corporate-accounts/\">泄露的密钥</a>需要大量工作以及<a href=\"https://www.bleepingcomputer.com/news/security/truffle-security-launches-program-to-revoke-14-million-live-secrets/\">协调</a>。</p><p>研究人员建议 Docker Hub 在将镜像推送上线之前扫描其中的密钥，并在发现疑似嵌入任何密钥时警告发布者。</p><p>他们还建议限制访问 Docker Hub 最近发布或更新的镜像的公共信息源，或对其施加速率限制，以阻止大规模扫描工具。</p><p>Tsouvalas 告诉 BleepingComputer，他们在五月向 Docker 报告了研究结果并附上完整论文，但除了一封确认回复外，没有收到后续答复。</p><p>他们在八月进行的一项小规模实验旨在确定该平台是否实施了任何防御措施，结果显示没有任何变化。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/0e510643164e7d91.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现您现有的防御措施可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体会分析邮件意图、上下文和行为，以发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>通过为期 14 天的只读扫描查看 Microsoft 365 或 Google Workspace 中有哪些邮件得以通过，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始免费的电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","论文","供应链","容器","凭据","云原生","AWS","Google","https://www.bleepingcomputer.com/news/security/cloud-keys-leaked-in-docker-hub-images-are-stolen-within-seconds/","BleepingComputer",{"_107":108,"_109":-5},"changelogVersion","2026-10-01T08:00","release"]
