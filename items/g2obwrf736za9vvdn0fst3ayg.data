[{"_1":2,"_3":4},"root",{"_5":116},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795912837000,"id","g2obwrf736za9vvdn0fst3ayg","title","SYS010 信息窃取木马借 Meta 广告强制安装浏览器扩展窃取 Gmail 与 Outlook 邮件","originalTitle","SYS010 malware abuses browser management to spy on Gmail, Outlook","summary","Bitdefender Labs 披露 SYS010 信息窃取木马通过 Meta 广告伪装成免费动态壁纸应用下载，诱导 Windows 用户安装后强制为 Chrome、Edge 和 Firefox 配置恶意扩展，目标是 Facebook 与 Meta 商业账户及 Gmail、Outlook 邮件。","reason","文章拆解了 SYS010 从 Meta 广告投放到强制安装浏览器扩展的完整链路，并明确说明服务器请求量不能代表已确认感染。","source",{"_76":115},"links",{"_106":114},"publishedAt","2026-11-26T11:50:17.000Z","discoveredAt","2026-11-26T12:19:19.158Z","timelineAt","category","activity","tags",[79,77,110,85,111,112,113],"score",74,"selected",true,"channel","news","story",{"_89":90,"_13":91},"x","readingMode","full","author","Ionut Ilascu","body",{"_61":105,"_106":-5,"_107":108,"_109":37},"outline",[92,93,94],"relatedStories",[88],"topics",[68,69,70,71,72,73],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fXqRp-Snz5-I","reportCount",1,"additionalSourceCount",0,{"_74":86,"_76":87},{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","malware","name","恶意软件","attack","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","browser","浏览器","supply-chain","供应链安全",{"_89":90,"_13":91},"publicId","6221b85d-4d8c-4753-9889-786f3b770dd1","SYS010借Meta广告窃取账户与邮箱数据",{"_11":103,"_96":104,"_98":102},{"_11":100,"_96":101,"_98":102},{"_11":95,"_96":97,"_98":99},"sec-3","text","发现现有防御可能遗漏的电子邮件威胁。","level",2,"sec-2","Gmail 和 Outlook 电子邮件访问",3,"sec-1","壁纸会安装窃取信息的附加组件","<p><img alt=\"SYS010 malware abuses browser management to spy on Gmail, Outlook\" height=\"900\" src=\"/dailyinfo/media/b359e125061b14de.webp\" srcset=\"/dailyinfo/media/094c64eacf0a9cab.webp 720w, /dailyinfo/media/7847ad835410f8a8.webp 1200w, /dailyinfo/media/b359e125061b14de.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>通过 Meta 广告投放的新版本 SYS01 信息窃取恶意软件正在将浏览器纳入企业风格的管理机制，以强制安装一个会窃取敏感数据（包括 Gmail 和 Outlook 电子邮件）的扩展。</p><p>这些广告诱骗 Windows 用户下载免费的动态壁纸；这些壁纸确实能正常发挥作用，但也会在安装期间于后台部署恶意软件。</p><p>该活动以 Facebook 和 Meta 商业账户为目标，使操作人员能够访问 Chrome 中近期的 Gmail 和 Outlook 消息，并能够永久删除电子邮件。</p><p><a href=\"https://www.wiz.io/lp/claude-code-security-best-practices-cheat-sheet?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q3_INB_FORM_Claude-Code-Security-Best-Practices&amp;sfcid=701Vh00000gJQZuIAO&amp;utm_term=FY27Q4-bleepingcomputer-article-970x250-Nov&amp;utm_content=Claude-Code-Best-Practices\"><img src=\"/dailyinfo/media/7a5a3a6292d5f413.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>Bitdefender Labs 将该活动追踪为 SYS010，并表示该恶意软件很可能是<a href=\"https://www.bitdefender.com/en-us/blog/labs/unmasking-the-sys01-infostealer-threat-bitdefender-labs-tracks-global-malvertising-campaign-targeting-meta-business-pages\">SYS01 信息窃取器</a>的新版本；研究人员至少自 2022 年起就在 <a href=\"https://www.bleepingcomputer.com/news/security/facebook-ads-for-windows-themes-push-sys01-info-stealing-malware/\">Facebook 上的恶意广告活动</a>中观察到了它。</p><p>这一名称反映了研究人员的评估：该变种相比其前代实现了重大改进，因此他们将其标记为版本 2，并以二进制形式表示为 010。</p><p>研究人员于 10 月 16 日发现了一则恶意的 SYS010 广告，并发现该活动仍在持续，已创建了数百则广告。</p><p>公司遥测数据显示，对威胁行为者服务器的请求来自亚洲、欧洲、北美洲、非洲和南美洲的多个国家。</p><p>Meta Ad Library 的透明度页面显示，仅一则广告就触达了欧盟的 6,275 名用户 targeting 任何年满 18 岁的人。</p><figure><img alt=\"Meta transparency page for EU audience in SYS010 malvertising\" height=\"472\" src=\"/dailyinfo/media/cdcb7aafeb4a288f.webp\" srcset=\"/dailyinfo/media/293b4b31f3a9e2a0.webp 720w, /dailyinfo/media/e9a23f2bda4df2eb.webp 1200w, /dailyinfo/media/cdcb7aafeb4a288f.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"900\">\n<figcaption><strong>SYS010 恶意广告中面向欧盟受众的 Meta 透明度页面</strong><br>\n<em>来源：<a href=\"https://www.bitdefender.com/en-au/blog/labs/sys010-reloaded-malvertising-campaign-targeting-meta-business-accounts\">Bitdefender</a></em></figcaption>\n</figure><p>Bitdefender 在今天发布的报告中表示，大多数请求来自菲律宾、泰国、孟加拉国、波兰、墨西哥、阿尔及利亚、比利时、蒙古和美国，但强调这些数字并不代表已确认的感染。</p><h3 id=\"sec-1\">壁纸会安装窃取信息的附加组件</h3><p>这些广告冒充合法的 Wallpaper Engine（一个基于 Electron 构建、经过更名并具有数字签名的 MeisterTask 桌面应用版本）和 Lively Wallpapers 应用程序，将用户引导至恶意下载网站，其中一些网站使用旨在显得官方的域名。</p><p>安装恶意 Windows 应用后，用户会获得广告宣传的动态壁纸功能，这有助于掩盖在后台运行的恶意软件。</p><p>据 Bitdefender 研究人员称，攻击者通过滥用为企业组织设计的管理工具，强制 Chrome、Edge 和 Firefox 安装恶意浏览器附加组件。</p><p>一个名为 <em>eclient.php</em> 的脚本通过修改浏览器管理策略，负责安装恶意扩展。</p><figure><img src=\"/dailyinfo/media/ea2429334eb3abdb.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Attacker PHP script for installing malicious browser extension\" height=\"318\" width=\"700\">\n<figcaption><strong>用于安装恶意浏览器扩展的攻击者 PHP 脚本</strong><br>\n<em>来源：Bitdefender</em></figcaption>\n</figure><p>在 Chrome 中，它会将浏览器注册到攻击者控制的 Google 管理控制台，从而允许强制安装扩展。</p><p>在 Firefox 中，它使用 ExtensionSettings 策略强制安装附加组件，同时禁用开发者工具和滥用举报功能。</p><p>对于 Edge，它可以将受害者的 Windows 设备注册到攻击者控制的移动设备管理（MDM）服务器，以启用强制扩展安装。</p><p>这些更改需要管理员权限，而攻击者通过触发用户账户控制（UAC）提示，并每隔三秒重复一次、最多重复 99 次，直到用户批准该操作来解决这一问题。</p><p>据 Bitdefender 表示，这些控件可阻止用户禁用或移除扩展插件。随后，这些扩展插件可以窃取会话 Cookie，使恶意软件操作者无需输入密码或完成双因素身份验证质询，即可访问已登录的账户。</p><p>Bitdefender 判定，这些恶意扩展插件伪装成文档工具，包括 Chrome 中的 Docs Helper 和 Firefox 中的 Document Hub。</p><p>他们指出，伪造的 Chrome Docs Helper 扩展插件使用了类似 Google Docs 标志的图标，但通过 Chrome Web Store 之外的渠道分发。</p><p>这些扩展插件还会收集受害者有权访问的 Facebook 主页、广告账户和商业账户信息，包括支出和付款详情。</p><h3 id=\"sec-2\">Gmail 和 Outlook 电子邮件访问</h3><p>Bitdefender 的研究还指出，该 Chrome 扩展插件可以读取 Gmail 和 Outlook 账户中的近期邮件，并将其内容发送给攻击者，还可以永久删除选定的邮件。</p><p>这种能力可能让攻击者拦截登录代码，并在受害者看到安全警报前将其删除，&nbsp;<a href=\"https://www.bitdefender.com/en-au/blog/labs/sys010-reloaded-malvertising-campaign-targeting-meta-business-accounts\">Bitdefender 警告称</a>。</p><p>此外，对同一收件箱的访问还可能使恢复已遭入侵的账户变得更加困难。</p><p>最近在另一款名为 Remus 的信息窃取程序中也发现了类似行为，该程序同样使用恶意扩展插件读取 Gmail 收件箱中的邮件。</p><p>Remus 信息窃取程序采用了不同方式在 Chrome 中安装扩展插件：它直接在受害者的浏览器配置文件中注册该插件，并启用开发者模式，以允许未打包的扩展插件运行。</p><p>尽管恶意广告通常被认为风险较低，但它仍可能造成重大损害，因为被盗广告账户通常会被用来以可信企业的身份为恶意广告活动提供资金。</p><p>受影响公司会产生未经授权的广告费用，还可能失去社交媒体账户的访问权限，并且客户对话内容会遭到泄露。</p><p>Bitdefender 建议避免从社交媒体广告下载软件，并拒绝用途不明确的管理员权限提示。</p><p>此外，如果浏览器中出现意外的“由您的组织管理”消息，应当引起警觉。使用受工作管理的设备的个人应向其 IT 团队核实，而个人电脑上出现此类消息则需要进一步调查。</p><p>这家网络安全公司建议企业审查谁有权访问其 Meta 账户，移除不再需要的权限，并检查是否出现陌生广告、付款变更或支出。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/1f6f9d6dc9ced8f5.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-3\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体会分析邮件意图、上下文和行为，以发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>对 Microsoft 365 或 Google Workspace 进行为期 14 天的只读扫描，看看有哪些威胁正在穿透，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始您的免费电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","数据窃取","供应链投毒","Google","Mozilla","https://www.bleepingcomputer.com/news/security/sys010-malware-abuses-browser-management-to-spy-on-gmail-outlook/","BleepingComputer",{"_117":118,"_119":-5},"changelogVersion","2026-10-01T08:00","release"]
