[{"_1":2,"_3":4},"root",{"_5":121},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794185106000,"id","t0wff82r3vhco60wkrm3qmm96","title","攻击者伪装 Microsoft Teams IT 支持，利用不安全 AD CS 窃取企业数据","originalTitle","Attackers Pose as IT Support on Microsoft Teams, Abuse AD CS to Steal Company Data","summary","Microsoft 调查了两起攻击者伪装 IT 支持并诱导员工通过 Microsoft Teams 使用 Quick Assist 授予远程控制的入侵，攻击者随后利用不安全配置的 AD CS 获取高权限账户及域控制器证书，其中一起将企业数据复制到外部服务器。","reason","两起入侵展示了社会工程、Quick Assist 与不安全 AD CS 配置如何串联成数据窃取，并暴露自动响应遗漏高权限账户的处置风险。","source",{"_74":120},"links",{"_111":119},"publishedAt","2026-11-02T11:08:45.000Z","discoveredAt","2026-11-02T11:43:33.026Z","timelineAt","category","activity","tags",[77,115,116,79,117,118],"score",75,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_61":110,"_111":-5,"_112":113,"_114":37},"outline",[86,87,88,89,90,91,92],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fwRoihpGadjI","reportCount",1,"additionalSourceCount",0,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","blue-team","name","蓝队与运营","attack","攻击活动","identity","身份与访问","microsoft","Microsoft / 微软",{"_83":84,"_13":85},"publicId","5557f734-0384-4340-831d-ef44aa71fc70","两起Teams冒充IT攻击波及AD CS",{"_11":108,"_94":109,"_96":97},{"_11":106,"_94":107,"_96":97},{"_11":104,"_94":105,"_96":97},{"_11":102,"_94":103,"_96":97},{"_11":100,"_94":101,"_96":97},{"_11":98,"_94":99,"_96":97},{"_11":93,"_94":95,"_96":97},"sec-7","text","指标与检测","level",3,"sec-6","已知与未知事项","sec-5","Defender 可以采取的措施","sec-4","案例 2：域控制器的证书","sec-3","案例 1：特权证书，以及遏制措施中的缺口","sec-2","证书能为攻击者带来什么","sec-1","攻击是如何开始的","<p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiLv88EM1ZSjaeI7bH9DVpg2mGdkwXWUuir0S_p9IfiWG49_TgRalFdK4oQ6e7UE_JYOnNH70Z6wcftnjhcYHRY-Xc0o8GYp9r1uNzxdC_1bnXZgvon74cXkWgKpHZtwJg3IKLsqGC2HS2tcMfQS8BZu7kfrW1vAaaIA316LRzgCOn8zeGZ1WvALgJmyM4/s1600/ms-ad.jpg\"><img alt=\"\" src=\"/dailyinfo/media/d6da240cf17590e3.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>攻击者冒充 Microsoft Teams 上的 IT 支持人员，诱使员工将 PC 的远程控制权交给他们。随后，他们利用不安全配置的 Active Directory Certificate Services（AD CS）设置，获取特权账户（包括一个域控制器账户）的登录证书。</p><p>Microsoft 在<a href=\"https://www.microsoft.com/en-us/security/blog/2026/10/30/help-desk-impersonation-ad-cs-abuse-investigating-esc1-esc8-intrusion-paths/\">一份报告</a>中表示，它调查了两起此类入侵事件，其中一起导致公司数据被复制到外部服务器。</p><p>攻击者并未利用 Teams 本身的任何漏洞。他们依靠社会工程，以及配置不安全的 AD CS；Microsoft 未将该活动与任何已知组织关联起来。</p><h3 id=\"sec-1\">攻击是如何开始的</h3><p>Microsoft 表示，两起入侵事件的起始方式相同。攻击者在 Teams 上向员工发送消息和拨打电话，冒充该公司自己的 IT 或服务台人员，并使用带有支持主题名称的外部租户，使该联系方式看起来很熟悉。</p><p>他们说服每位用户打开 Quick Assist——一款内置于 Windows 的远程协助工具——并将连接代码读给他们。这使攻击者能够直接实际操作该工作站。</p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEidksUUoNFOF9jbb1QOmQ37tNavcwp1gx9wPFCK_P6ZzFcD0nwSVUWTAMGW9E5NFuhBGuO9o82iUzn97FXXDC7KeEI8E3XrW5mCkdmbtxezOkS8uxUNnQw20GmSSmZcvxbEImriuw65DWi9JdszJLRkA_EWXM7_zz0kCn3biLi7Sn6ZPFE4dKZps3XUz9Q/s1600/entry.jpg\"><img alt=\"\" src=\"/dailyinfo/media/f1e19f7973dceb23.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>随后，攻击者将一个压缩包放入 Downloads 文件夹，将其解压到一个名称仿似 Windows 更新的新文件夹中，并使用便携版 Python、Bun 或 Java 运行时运行其中的内容。仅凭文件名是较弱的判断依据，因为其中一个副本虽然被重命名，却仍保留真实运行时的版本信息。</p><h3 id=\"sec-2\">证书能为攻击者带来什么</h3><p>AD CS 是 Windows 中负责签发用户和计算机登录时所持证书的角色。来自配置不当模板的证书，会让持有者以证书所指定的账户身份登录。</p><p>Microsoft 表示，即使账户密码被重置或第一台计算机被清空，此类证书仍可继续使用，因此这两项操作都无法终止攻击者的访问。</p><h3 id=\"sec-3\">案例 1：特权证书，以及遏制措施中的缺口</h3><p>在第一起入侵事件中，攻击者发现一个存在名为 ESC1 的弱点的证书模板。使用此类模板时，请求者可以指定证书所代表的账户，因此低权限用户可以申请一张代表特权账户的证书。</p><p>第一轮通话针对了三名用户和一台工作站，为三个高权限账户生成了证书。Microsoft Defender 的自动攻击中断功能切断了这些身份，并终止了它们的活动会话。然而，有一个特权账户未被纳入自动响应，因此仍可使用。</p><p>约 90 分钟后，更大的一波攻击波及 16 名用户和第二台工作站，又为另外 8 个特权账户生成了证书。Microsoft 表示，之后超过 1,000 次试图通过 SMB 访问文件或登录的尝试均被阻止。</p><p>在获取证书后的数秒内，攻击者登录了一台域控制器，并运行 DCSync——一款用于从 Active Directory 复制密码数据的工具。在遏制措施生效时，该操作已经开始，因此可复制的数据量受到限制。Microsoft 未说明攻击者获取了多少凭据数据。</p><p>被排除在自动响应之外的账户成为了突破口。攻击者持续使用该账户，接入一台文件服务器，并运行经过重命名的文件复制工具 Rclone，将数据从共享目录移至外部 SFTP 服务器。Microsoft 未说明有多少数据被窃取。</p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEh7HJZkLf4BTF2d3snB9vZzofHRSe5XM9QsTdkt-OFfaQHsW-DjQc5CfdgUaBXmjpDdBE1N0nA5TKSEMUsOFCAITMiMt32CjQFSv4TSCagqz3auoXUob0D88Qz4cDHgfAu9YwrXSEsLj4LEpxi9wjPM2UAVYSX0mzR8c5TqSJJmrhZQ6hgwI8la1xBIh10/s1600/11.jpg\"><img alt=\"\" src=\"/dailyinfo/media/c8f2ea3bf4b1e4c1.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>此案例以 Microsoft 的原话表明，“部分身份遏制措施可以减少攻击活动，但同时仍会留下一条可行的特权访问路径。”</p><h3 id=\"sec-4\">案例 2：域控制器的证书</h3><p>第二次入侵起初以相同方式展开，但由于不存在该模板弱点，发展方向有所不同。攻击者转而使用一种称为 PetitPotam 的技术，迫使域控制器向攻击者控制的一台计算机进行身份验证。</p><p>该 NTLM 登录被中继到 AD CS Web 注册页面，这种滥用方式称为 ESC8，不需要密码。攻击者利用中继后的登录，为域控制器自身申请证书。凭借该证书和 Kerberos（PKINIT），攻击者获得了域控制器的票据授予票据，将一次性的中继登录变成了持久的身份。</p><p>此次响应取得了成功。Defender 触发了 ESC8 警报，客户隔离了工作站，而 Microsoft 表示之后没有发现进一步活动。</p><p>两次事件之间的差异归根结底是遏制措施。在第一次事件中，自动中断阻止了攻击的大部分进程，但被排除的账户仍保持开放。在第二次事件中，隔离单台工作站阻止了攻击。</p><h3 id=\"sec-5\">Defender 可以采取的措施</h3><p>没有补丁可用，因为这并非软件漏洞。Microsoft 的建议涉及配置和响应。</p><ul>\n  <li>让员工在共享屏幕或交出远程控制权限之前，通过已知的内部渠道确认任何意外的支持请求。限制哪些外部 Teams 租户可以访问员工，并且只允许使用获批的远程支持工具。</li>\n  <li>审查证书登录模板，查找允许请求者指定账户，或允许过多用户注册的模板，并移除不需要的注册权限。</li>\n  <li>在 Web 注册终结点上要求使用 HTTPS，并启用身份验证扩展保护（EPA）；在可行的情况下，关闭这些终结点上的 NTLM。Microsoft 的&nbsp;<a href=\"https://support.microsoft.com/en-us/topic/kb5005413-mitigating-ntlm-relay-attacks-on-active-directory-certificate-services-ad-cs-3612b773-4043-4aa9-b23d-b87910cd3429\">KB5005413</a>&nbsp;介绍了这一点，其&nbsp;<a href=\"https://learn.microsoft.com/en-us/defender-for-identity/security-posture-assessments/certificates\">Defender for Identity 基线检查</a>&nbsp;会标记暴露于 ESC1 和 ESC8 的模板和终结点。</li>\n  <li>启用证书审核。如果颁发了不良证书，应将其吊销，但请记住，吊销不会取消已经签发的 Kerberos 票据；应单独审查活动票据。</li>\n  <li>将任何被排除在自动遏制范围之外的账户视为一项有意决定，并为其指派手动处置措施。</li>\n</ul><h3 id=\"sec-6\">已知与未知事项</h3><p>Microsoft 未将此次入侵归因于任何已命名团体，也未提供事件发生日期。</p><p>这些方法并不新颖。研究人员早在 2021 年就指出了&nbsp;<a href=\"https://specterops.io/research/certified-pre-owned/\">ESC1 和 ESC8 证书弱点</a>&nbsp;，而&nbsp;<a href=\"https://thehackernews.com/2021/07/new-petitpotam-ntlm-relay-attack-lets.html\">PetitPotam 强制认证技巧</a>&nbsp;也在同年被披露。Microsoft 自身早在 2026 年就记录了通过 Teams 帮助台转移到远程访问的入侵方式&nbsp;<a href=\"https://www.microsoft.com/en-us/security/blog/2026/04/18/crosstenant-helpdesk-impersonation-data-exfiltration-human-operated-intrusion-playbook/\">。</a></p><p>这份报告增加的新信息是，这两种技术会在真实入侵事件中汇合，同时还带来了有关被排除账户的教训。</p><p>较新的 Windows 对 ESC8 步骤的暴露程度较低。Microsoft 在 Windows Server 2025 中默认为 AD CS 启用&nbsp;<a href=\"https://www.microsoft.com/en-us/msrc/blog/2024/12/mitigating-ntlm-relay-attacks-by-default\">EPA</a>&nbsp;，而 Server 2022 和 2019 则需要手动启用。</p><h3 id=\"sec-7\">指标与检测</h3><p>Microsoft 的报告列出了 Teams、终结点和身份信号方面的 Defender 警报，以及四条高级搜寻查询，并称它们是“调查起点”，而非单独的证据。Microsoft 还发布了与初始访问脚本关联的三个文件哈希：</p><ul>\n  <li><strong>SHA-256</strong> <code>85b6c424117494d3056e88689dbc94c75e9afdb187a339714043aec0da109f17</code>（JavaScript 初始访问脚本）</li>\n  <li><strong>SHA-256</strong> <code>f326201269f1ee2f803ae435317507263bb6e0dbfdeb70bd1bb5446e2e46f001</code>（Python 初始访问脚本）</li>\n  <li><strong>SHA-256</strong> <code>06c5c14f043aee3bcc5843b5f50909623d5c9a6239a7c1fba9cddad4111469e7</code>（Python 初始访问脚本）</li>\n</ul><p>觉得这篇文章有意思吗？关注我们的 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a>，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","数据泄露","凭据","Microsoft","检测工程","https://thehackernews.com/2026/11/attackers-pose-as-it-support-on.html","The Hacker News",{"_122":123,"_124":-5},"changelogVersion","2026-10-01T08:00","release"]
