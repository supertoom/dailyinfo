[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1794444095000,"id","jugiebheg5ptuxhjuq1jxk8da","title","Mongoose 原型继承属性写入漏洞分析与 PoC","originalTitle","Mongoose walks into inherited properties when hydrating, setting, and merging, allowing overwrites of built-in functions (denial of service) and shared schema state","summary","Mongoose 的文档加载、点路径赋值和更新合并三条代码路径未校验自有属性，攻击者控制的属性名可覆盖原型链上的内置函数或 Mongoose 内部共享对象。其 PoC 表明，一次请求即可使后续查询抛出 TypeError 并持续拒绝服务至进程重启；使用 strict: false 的子文档时，还可移除所有文档共享的 required 校验器。","reason","文章梳理了三条属性名注入路径，并用 PoC 展示进程级拒绝服务和共享 Schema 校验规则被修改的影响。","source",{"_71":83},"links",{"_60":82},"publishedAt","2026-11-10T20:56:16.000Z","discoveredAt","2026-11-10T21:29:36.039Z","timelineAt","category","vuln","tags",[78,79,80,81],"score",79,"selected",true,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[67,68],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","ffULNYyni2vM","reportCount",1,"additionalSourceCount",0,{"_69":31,"_71":73},{"_69":70,"_71":72},"slug","research","name","技术研究","漏洞披露",{"_75":76,"_13":77},"publicId","ee419c48-4d12-40b2-9d33-211c4cc3db96","Mongoose 披露原型属性覆盖漏洞","漏洞","复现","漏洞利用","漏洞分析","https://github.com/advisories/GHSA-8332-j7wj-wjw4","GitHub 安全公告",{"_85":86,"_87":-5},"changelogVersion","2026-10-01T08:00","release"]
