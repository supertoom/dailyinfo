[{"_1":2,"_3":4},"root",{"_5":144},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794357635000,"id","cd10ku2jyo2zjhf6tnrhavx0z","title","Storm-3358 使用 ARTEX 扩大对东南亚金融机构的攻击","originalTitle","ARTEX abuse expands as cybercriminals target financial sector","summary","Storm-3358 自 2026 年 10 月起使用 agentic AI 渗透测试框架 ARTEX，主要针对东南亚金融机构并波及少量全球大型金融组织。攻击者结合常规自动化工具扫描公网系统，利用匿名文件上传、SSRF 等缺陷，部署 WISP、vshell、AdaptixC2 RAT，随后开展凭据窃取、暴力破解、API 滥用、权限提升、持久化与数据外传。","reason","文章披露 Storm-3358 使用 ARTEX 攻击金融机构的完整链路，并提供 IOC、检测覆盖和狩猎查询，便于评估与处置。","source",{"_77":143},"links",{"_135":142},"publishedAt","2026-11-07T02:44:34.000Z","discoveredAt","2026-11-07T08:34:32.363Z","timelineAt","category","activity","tags",[80,82,78,139,140,141],"score",77,"selected",true,"channel","news","story",{"_92":93,"_13":94},"x","readingMode","full","author","Microsoft Threat Intelligence","body",{"_61":134,"_135":-5,"_136":137,"_138":37},"outline",[95,96,97,98,99,100,101,102,103,104,105,106],"relatedStories",[91],"topics",[68,69,70,71,72,73,74],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fvjNl7J8qquo","reportCount",1,"additionalSourceCount",0,{"_75":89,"_77":90},{"_75":87,"_77":88},{"_75":85,"_77":86},{"_75":83,"_77":84},{"_75":81,"_77":82},{"_75":79,"_77":80},{"_75":76,"_77":78},"slug","malware","name","恶意软件","attack","攻击活动","ai-offense","AI 攻防","black-market","数据窃取与黑产","ransomware","勒索软件","supply-chain","供应链安全","microsoft","Microsoft / 微软",{"_92":93,"_13":94},"publicId","8e99a309-4c2f-49f9-8abe-3c84fd36a6a4","Storm-3358以ARTEX攻击金融机构",{"_11":132,"_108":133,"_110":114},{"_11":131,"_108":130,"_110":114},{"_11":129,"_108":130,"_110":114},{"_11":127,"_108":128,"_110":114},{"_11":125,"_108":126,"_110":114},{"_11":123,"_108":124,"_110":111},{"_11":121,"_108":122,"_110":111},{"_11":119,"_108":120,"_110":114},{"_11":117,"_108":118,"_110":111},{"_11":115,"_108":116,"_110":111},{"_11":112,"_108":113,"_110":114},{"_11":107,"_108":109,"_110":111},"sec-12","text","了解更多","level",3,"sec-11","入侵指标",2,"sec-10","Microsoft Sentinel","sec-9","Microsoft Defender XDR","sec-8","狩猎查询","sec-7","威胁情报报告","sec-6","Microsoft Security Copilot","sec-5","Microsoft Defender 检测项","sec-4","缓解与保护指南","sec-3","由 ARTEX 驱动的 Storm-0940 攻击","sec-2","sec-1","使用 ARTEX 的威胁行为者","<ol><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/06/artex-abuse-expands-as-cybercriminals-target-financial-sector/#mitigation-and-protection-guidance\">缓解与保护指南</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/06/artex-abuse-expands-as-cybercriminals-target-financial-sector/#microsoft-defender-detections\">Microsoft Defender 检测</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/06/artex-abuse-expands-as-cybercriminals-target-financial-sector/#hunting-queries\">狩猎查询</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/06/artex-abuse-expands-as-cybercriminals-target-financial-sector/#indicators-of-compromise\">入侵指标</a></li></ol><p>2026 年 10 月，以牟利为目的的威胁行为者 Storm-3358 开始使用智能体 AI 攻击框架 ARTEX  targeting 金融行业组织。Microsoft Threat Intelligence 跟踪为 Storm-3358 的威胁行为者是一个总部位于柬埔寨的入侵集群，主要针对东南亚的金融组织，此外还针对全球数量较少的大型金融组织。</p><h2 id=\"sec-1\">\n\t\t\t使用 ARTEX 的威胁行为者\t\t</h2><p>\n\t\t\t\t\t\t\t<a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/05/threat-actors-use-agentic-ai-tooling-to-find-and-abuse-exposed-secrets/\">\n\t\t\t\t\t\t在公开 GitHub 仓库中搜索泄露的密钥\t\t\t\t\t\t\t›</a>\n\t\t\t\t\t</p><p>Microsoft 观察到 Storm-3358 将 ARTEX 与传统自动化工具结合使用，以扫描连接到公共互联网的系统、利用包括匿名文件上传和服务器端请求伪造（SSRF）在内的安全漏洞，并安装开源远程访问木马（RAT）。Storm-3358 使用 WISP、vshell 和 AdaptixC2 RAT 进行持久化和横向移动。Microsoft 观察到 ARTEX 智能体使用 netcat 和 curl 等实用工具，将这些 RAT 下载到已受入侵的系统，如图 1 所示。</p><h2 id=\"sec-2\">\n\t\t\t由 ARTEX 驱动的 Storm-0940 攻击\t\t</h2><p>\n\t\t\t\t\t\t\t<a href=\"https://www.microsoft.com/en-us/security/blog/2026/10/21/storm-0940-uses-artex-agentic-ai-connectwise-supply-chain-compromise/\">\n\t\t\t\t\t\t自动化攻击，包括供应链入侵\t\t\t\t\t\t\t›</a>\n\t\t\t\t\t</p><h2 id=\"sec-3\">\n\t\t\t由 ARTEX 驱动的 Storm-0940 攻击\t\t</h2><p>\n\t\t\t\t\t\t\t<a href=\"https://www.microsoft.com/en-us/security/blog/2026/10/21/storm-0940-uses-artex-agentic-ai-connectwise-supply-chain-compromise/\">\n\t\t\t\t\t\t自动化攻击，包括供应链入侵\t\t\t\t\t\t\t›</a>\n\t\t\t\t\t</p><figure><img src=\"/dailyinfo/media/7581ddd740163a22.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption><em>图 1. ARTEX 智能体用于将 RAT 下载到已受入侵系统的命令示例。</em></figcaption></figure><p>在近期与 ARTEX 相关的攻击中，威胁行为者使用 ARTEX 智能体扫描和利用 Web 应用程序中的漏洞，使用 Web shell 在已受入侵的 Web 服务器上保持持久化，窃取<a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/05/threat-actors-use-agentic-ai-tooling-to-find-and-abuse-exposed-secrets/\">公开来源中的凭据</a>以及已受入侵系统中的凭据，并<a href=\"https://www.microsoft.com/en-us/security/blog/2026/10/21/storm-0940-uses-artex-agentic-ai-connectwise-supply-chain-compromise/\">使用已失陷的云身份</a>进行持久化和数据外泄。ARTEX 智能体还可以执行暴力密码攻击、密码喷洒、API 枚举与滥用以及数据库转储。ARTEX 等智能体工具可以利用已失陷的凭据和系统，以机器速度进行横向移动、提权并外泄数据。</p><p>这种活动表明，威胁行为者正在持续利用包括 ARTEX 在内的智能体 AI 渗透测试框架，加速攻击链的所有阶段。随着这些能力不断演进，防御者也必须同样利用 AI 在大型环境中开展调查和响应。</p><p>尽管威胁行为者经常使用代理和虚拟专用网络（VPN）更改恶意流量的源 IP 地址并绕过静态检测，但 Microsoft 正在提供入侵指标（IOC），以帮助防御者检测相关活动。</p><h2 id=\"sec-4\">缓解与保护指南</h2><p>Microsoft 对涉及智能体框架的威胁开展的研究，为其各项产品中的安全检测和调查上下文提供了依据。客户可用的功能取决于活动来源以及其环境中部署的产品和保护措施。</p><p>多种行为信号可以帮助组织确定自己正成为使用智能体式 AI 的威胁行为者的目标。智能体式 AI 框架在扫描目标时，会在短时间内发送种类繁多的请求，并对同一种技术尝试不同的变体，或以机器速度进入下一阶段的操作。智能体式 AI 框架会使用现有的渗透测试工具。例如，ARTEX 默认使用 Nmap、curl、wget、Python HTTP 客户端、Norma SDK WebFetch，以及通过 Playwright 驱动的无头 Chromium 等工具。这些工具发送的网络流量可能具有 distinctive characteristics，例如默认的 user agent 字符串。虽然阻断具有这些特征的网络流量无法阻止 AI 智能体发起的攻击（它会迅速更改这些特征），但识别它们可以提醒防御人员注意相关活动。</p><p><a href=\"https://learn.microsoft.com/security/zero-trust/adopt/prevent-reduce-business-damage-breach-infrastructure#create-honeypot-resources\">防御性蜜罐</a>、诱饵、拖网和虚假胜利可以将自主 AI 攻击从合法目标引开。蜜罐和诱饵攻击面（例如 <a href=\"https://github.com/Azure/Azure-Sentinel/tree/master/Solutions/HoneyTokens\">Microsoft Sentinel Deception</a>）为智能体提供看似有吸引力但毫无价值的目标。拖网会消耗智能体的时间和预算。虚假胜利会呈现出令人信服的证据，表明智能体的目标已经完成，从而可能使其因虚假成功而停止。在 Microsoft 的测试中，这些控制措施有助于减少到达真实资产的攻击流量，并生成高置信度、达到归因质量的信号。</p><p>有关威胁行为者对 ARTEX 的使用演变的更多信息，请参阅 Microsoft 最近的博客文章：<a href=\"https://www.microsoft.com/en-us/security/blog/2026/10/21/storm-0940-uses-artex-agentic-ai-connectwise-supply-chain-compromise/\">利用 ARTEX 的 AI 驱动大规模国家级行为者活动 enables supply chain compromise</a> 和 <a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/05/threat-actors-use-agentic-ai-tooling-to-find-and-abuse-exposed-secrets/\">威胁行为者使用智能体式 AI 工具查找并滥用暴露的 secrets</a>。</p><p>Microsoft 对威胁行为者利用智能体式框架的持续研究，直接集成到以下产品中：</p><p><strong>身份和登录活动 — Microsoft Entra ID Protection</strong></p><p>Microsoft 会分析登录活动和其他信号，以识别潜在的身份风险。客户可以调查风险检测和风险登录，并配置条件访问策略，根据登录风险或用户风险，在满足指定条件时要求多重身份验证或阻止访问。来自已知威胁行为者基础设施（包括来自 ARTEX 等智能体式框架）的身份和登录活动，会产生以高风险传送的“已验证威胁行为者 IP”风险检测。请参阅：</p><ul>\n<li><a href=\"https://learn.microsoft.com/entra/id-protection/howto-identity-protection-investigate-risk\">使用 Microsoft Entra ID Protection 调查风险</a></li>\n\n\n\n<li><a href=\"https://learn.microsoft.com/entra/identity/authentication/tutorial-risk-based-sspr-mfa\">Microsoft Entra ID 中基于风险的用户登录保护</a></li>\n\n\n\n<li><a href=\"https://learn.microsoft.com/entra/id-protection/concept-identity-protection-risks#verified-threat-actor-ip\">什么是风险检测？— Microsoft Entra ID Protection</a></li>\n</ul><p><strong>终结点活动 — Microsoft Defender for Endpoint</strong></p><p>终结点警报可帮助安全团队识别并调查设备上的可疑活动。入侵指标可用于支持检测，并且在配置后可用于阻止。客户可以在 Microsoft Defender 门户中查看相关警报。请参阅：</p><ul>\n<li><a href=\"https://learn.microsoft.com/defender-endpoint/review-alerts\">在 Microsoft Defender for Endpoint 中查看警报</a></li>\n</ul><p><strong>跨安全域的活动 — Microsoft Defender 门户</strong></p><p>该门户汇集来自 Microsoft 安全解决方案的警报和事件，并提供相关的威胁情报，以支持调查、威胁狩猎和响应。这有助于客户结合自身环境评估可疑活动。请参阅：</p><ul>\n<li><a href=\"https://learn.microsoft.com/defender-xdr/investigate-alerts?tabs=settings\">在 Microsoft Defender XDR 中调查警报</a></li>\n</ul><p><strong>AI 安全仪表板</strong></p><p>威胁行为者滥用 AI 正在加速企业环境中的风险，放大现有威胁，例如漏洞利用、网络钓鱼、恶意软件威胁和内部人员活动。为帮助组织在 AI 赋能的威胁活动之前保持领先，Microsoft 推出了 Security Dashboard for AI。该仪表板通过汇总 <a href=\"https://www.microsoft.com/security/business/microsoft-defender\">Microsoft Defender</a>、<a href=\"https://www.microsoft.com/security/business/microsoft-entra\">Microsoft Entra</a> 和 <a href=\"https://www.microsoft.com/security/business/microsoft-purview\">Microsoft Purview</a> 中的安全、身份和数据风险，为用户提供 AI 安全态势的统一视图。请参阅：</p><ul>\n<li><a href=\"https://learn.microsoft.com/security/security-for-ai/security-dashboard-for-ai\">Security Dashboard for AI</a></li>\n</ul><h2 id=\"sec-5\">Microsoft Defender 检测项</h2><p><a href=\"https://www.microsoft.com/security/business/microsoft-defender\">Microsoft Defender</a> 客户可参考以下适用检测项列表。Microsoft Defender 协调跨终结点、身份电子邮件和应用的检测、预防、调查与响应，以提供针对本文所讨论威胁等攻击的集成保护。这些警报可能会由无关活动触发。客户应进行调查，以确定该警报是否与本文所述活动相关。</p><figure><table><tbody><tr><td><strong>战术</strong> </td><td><strong>Microsoft Defender 覆盖范围</strong> </td></tr><tr><td>执行</td><td><strong>Microsoft Defender for Endpoint</strong> <br>– 在后台启动进程 <br>– 投放并启动可疑文件 <br>– 可疑文件或内容传入 <br>– 执行隐藏文件 <br>– 网络服务执行可疑进程 <br>– 启动可疑管道命令 <br>– 服务启动可疑进程 <br>– 从全局可写目录启动可疑进程 <br>– 启动可疑脚本 <br>– 通过 PHP 应用程序执行可疑 shell <br>– 执行可疑 shell 命令</td></tr><tr><td>收集</td><td><strong>Microsoft Defender for Endpoint</strong> <br>– 枚举含敏感数据的文件 <br>– 可疑文件复制操作 <br>– 可疑进程从本地系统收集数据</td></tr><tr><td>凭据访问</td><td><strong>Microsoft Defender for Endpoint</strong> <br>– 可疑访问敏感文件</td></tr><tr><td>防御规避</td><td><strong>Microsoft Defender for Endpoint</strong> <br>– 为文件或目录添加可执行权限 <br>– 混淆或解混淆活动 <br>– 可能基于时间的规避 <br>– 可疑地将编码内容解码为脚本 <br>– 可疑的文件和目录权限修改 <br>– 检测到可疑的文件或信息混淆 <br>– 可疑路径删除</td></tr><tr><td>发现</td><td><strong>Microsoft Defender for Endpoint</strong> <br>– 可疑端口扫描活动</td></tr><tr><td>命令与控制（C2）</td><td><strong>Microsoft Defender for Endpoint</strong> <br>– 可能的反向 shell <br>– 对远程服务的可疑连接 <br>– 可疑 curl 行为   <br><br><strong>Microsoft Defender for Cloud</strong> <br>– 公开可访问的存储容器已暴露 <br>– 来自可疑 IP 地址的 Azure Resource Manager 操作</td></tr><tr><td>横向移动</td><td><strong>Microsoft Defender for Endpoint</strong> <br>– 远程桌面会话</td></tr><tr><td>持久性</td><td><strong>Microsoft Defender for Endpoint</strong> <br>– 可能的 Web 服务器失陷活动 <br>– 可疑 cron 作业创建</td></tr></tbody></table></figure><h3 id=\"sec-6\">Microsoft Security Copilot</h3><p><a href=\"https://www.microsoft.com/en-us/security/business/ai-machine-learning/microsoft-security-copilot\">Microsoft Security Copilot</a> <a href=\"https://learn.microsoft.com/defender-xdr/security-copilot-in-microsoft-365-defender\">嵌入在 Microsoft Defender 中</a>，为安全团队提供 AI 赋能功能，包括总结事件、分析文件和脚本、总结身份、使用引导式响应，以及生成设备摘要、搜寻查询和事件报告。</p><p>客户还可以<a href=\"https://learn.microsoft.com/defender-xdr/security-copilot-agents-defender\">部署 AI 代理</a>，包括以下<a href=\"https://learn.microsoft.com/copilot/security/agents-overview\">Microsoft Security Copilot 代理</a>，以高效执行安全任务：</p><ul>\n<li><a href=\"https://learn.microsoft.com/defender-xdr/threat-intel-briefing-agent-defender\">威胁情报简报代理</a></li>\n\n\n\n<li><a href=\"https://learn.microsoft.com/defender-xdr/phishing-triage-agent\">网络钓鱼分诊代理</a></li>\n\n\n\n<li><a href=\"https://learn.microsoft.com/defender-xdr/advanced-hunting-security-copilot-threat-hunting-agent\">威胁狩猎代理</a></li>\n\n\n\n<li><a href=\"https://learn.microsoft.com/defender-xdr/dynamic-threat-detection-agent\">动态威胁检测代理</a></li>\n</ul><p>Security Copilot 还可作为<a href=\"https://learn.microsoft.com/en-us/copilot/security/experiences-security-copilot\">独立体验</a>提供，客户可以执行特定的安全相关任务，例如事件调查、用户分析和漏洞影响评估。此外，Security Copilot 提供<a href=\"https://learn.microsoft.com/copilot/security/developer/custom-agent-overview\">开发者场景</a>，使客户能够构建、测试、发布和集成 AI 代理与插件，以满足独特的安全需求。</p><h3 id=\"sec-7\">威胁情报报告</h3><p>Microsoft Defender XDR 客户可以在 Defender 门户中使用以下<a href=\"https://learn.microsoft.com/defender-xdr/threat-analytics\">威胁分析</a>报告（至少需要获得一种 Defender XDR 产品的许可证），以获取有关本篇博客所讨论的活动和技术的最新信息。这些报告提供情报、保护信息以及建议操作，以防止、缓解或响应在客户环境中发现的相关威胁。</p><ul>\n<li><a href=\"https://security.microsoft.com/threatanalytics3/26427224-e8dc-4a7c-808e-6456c300e164/analystreport\">活动概况：随着网络犯罪分子将目标对准金融行业，ARTEX 滥用活动扩大</a></li>\n</ul><p>Microsoft Security Copilot 客户还可以使用 Microsoft Defender Threat Intelligence 中的 <a href=\"https://learn.microsoft.com/defender/threat-intelligence/security-copilot-and-defender-threat-intelligence?bc=%2Fsecurity-copilot%2Fbreadcrumb%2Ftoc.json&amp;toc=%2Fsecurity-copilot%2Ftoc.json#turn-on-the-security-copilot-integration-in-defender-ti\">Microsoft Security Copilot 集成</a>，在 Security Copilot 独立门户或 Microsoft Defender 门户中的<a href=\"https://learn.microsoft.com/defender/threat-intelligence/using-copilot-threat-intelligence-defender-xdr\">嵌入式体验</a>里获取有关此威胁的更多信息。</p><h2 id=\"sec-8\">狩猎查询</h2><h3 id=\"sec-9\">Microsoft Defender XDR</h3><p>Microsoft Defender XDR 客户可以运行以下<a href=\"https://learn.microsoft.com/defender-xdr/advanced-hunting-overview\">高级狩猎</a>查询，在其网络中查找相关活动：</p><p><strong>使用 curl 下载新文件</strong></p><p>威胁行为者可能会使用 curl 等工具下载其他文件、与 C2 基础设施通信或窃取数据。此查询会查找使用 curl 下载的新文件。curl 也有合法用途，因此应审查文件和主机，以识别潜在的恶意活动。</p><pre>let known_files = DeviceNetworkEvents\n    | where TimeGenerated between (ago(7d)..ago(1d))\n    | where InitiatingProcessFileName has \"curl\"\n    | extend url = extract(\"http[s]?:\\\\/\\\\/(?:[a-zA-Z]|[0-9]|[$-_@.&amp;+]|[!*\\\\(\\\\),]|(?:%[0-9a-fA-F][0-9a-fA-F]))+\", 0,InitiatingProcessCommandLine)\n    | extend ip = extract(\"(\\\\b25[0-5]|\\\\b2[0-4][0-9]|\\\\b[01]?[0-9][0-9]?)(\\\\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)){3}[^ ]*\", 0, InitiatingProcessCommandLine)\n    | extend remote_file = iif(isnotempty(url), url, ip)\n    | union (SecurityEvent\n    | where TimeGenerated between (ago(7d)..ago(1d))\n    | where EventID == 4688\n    | where CommandLine has \"curl\"\n    | extend url = extract(\"http[s]?:\\\\/\\\\/(?:[a-zA-Z]|[0-9]|[$-_@.&amp;+]|[!*\\\\(\\\\),]|(?:%[0-9a-fA-F][0-9a-fA-F]))+\", 0,CommandLine)\n    | extend ip = extract(\"(\\\\b25[0-5]|\\\\b2[0-4][0-9]|\\\\b[01]?[0-9][0-9]?)(\\\\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)){3}[^ ]*\", 0, CommandLine)\n    | extend remote_file = iif(isnotempty(url), url, ip))\n    | summarize by remote_file;\n    DeviceNetworkEvents\n    | where TimeGenerated &gt; ago(1d)\n    | where InitiatingProcessFileName has \"curl\"\n    | extend url = extract(\"http[s]?:\\\\/\\\\/(?:[a-zA-Z]|[0-9]|[$-_@.&amp;+]|[!*\\\\(\\\\),]|(?:%[0-9a-fA-F][0-9a-fA-F]))+\", 0,InitiatingProcessCommandLine)\n    | extend ip = extract(\"(\\\\b25[0-5]|\\\\b2[0-4][0-9]|\\\\b[01]?[0-9][0-9]?)(\\\\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)){3}[^ ]*\", 0, InitiatingProcessCommandLine)\n    | extend remote_file = iif(isnotempty(url), url, ip)\n    | union (SecurityEvent\n    | where EventID == 4688\n    | where CommandLine has \"curl\"\n    | extend url = extract(\"http[s]?:\\\\/\\\\/(?:[a-zA-Z]|[0-9]|[$-_@.&amp;+]|[!*\\\\(\\\\),]|(?:%[0-9a-fA-F][0-9a-fA-F]))+\", 0,CommandLine)\n    | extend ip = extract(\"(\\\\b25[0-5]|\\\\b2[0-4][0-9]|\\\\b[01]?[0-9][0-9]?)(\\\\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)){3}[^ ]*\", 0, CommandLine)\n    | extend remote_file = iif(isnotempty(url), url, ip))\n    | where remote_file !in (known_files)\n\n</pre><h3 id=\"sec-10\">Microsoft Sentinel</h3><p>Microsoft Sentinel 客户可以运行以下<a href=\"https://learn.microsoft.com/defender-xdr/advanced-hunting-overview\">高级狩猎</a>查询，在其网络中查找相关活动：</p><p><strong>使用 ASIM 检测网络入侵指标</strong></p><p>以下查询会检查过去 30 天内 ASIM 网络会话解析器支持的数据源中的 IP 地址。</p><pre>let lookback = 30d; let \nioc_ip_addr = dynamic([\"199.19.95.66\", \"199.19.95.67\", \"199.19.95.68\", \"91.92.240.238\", \"85.11.168.45\", \"178.15.54.129\", \"31.77.229.35\", \"85.11.167.52\"]); \n_Im_NetworkSession(starttime=todatetime(ago(lookback)), endtime=now()) \n| where DstIpAddr in (ioc_ip_addr) \n| summarize FirstSeen=min(TimeGenerated), LastSeen=max(TimeGenerated), EventCount=count() by SrcIpAddr, DstIpAddr, DstDomain, Dvc, EventProduct, EventVendor\n</pre><h2 id=\"sec-11\">入侵指标</h2><p><strong>注意：</strong>威胁行为者经常使用代理和虚拟专用网络（VPN）更改恶意流量的源 IP 地址，从而绕过静态检测。Microsoft 提供以下示例入侵指标（IOC），以帮助防御人员检测相关活动。</p><figure><table><tbody><tr><td><strong>指标</strong></td><td><strong>类型</strong></td><td><strong>说明</strong></td><td><strong>首次发现</strong></td><td><strong>最后发现</strong></td></tr><tr><td>199.19.95[.]66</td><td>IP 地址</td><td>WISP C2 节点</td><td>2026-11-02</td><td>截至 2026-11-06 仍处于活跃状态</td></tr><tr><td>199.19.95[.]67</td><td>IP 地址</td><td>WISP C2 节点</td><td>2026-11-02</td><td>截至 2026-11-06 仍处于活跃状态</td></tr><tr><td>199.19.95[.]68</td><td>IP 地址</td><td>WISP C2 节点</td><td>2026-11-02</td><td>截至 2026-11-06 仍处于活跃状态</td></tr><tr><td>91.92.240[.]238</td><td>IP 地址</td><td>ARTEX 服务器</td><td>2026-11-04</td><td>截至 2026-11-06 仍处于活跃状态</td></tr><tr><td>85.11.168[.]45</td><td>IP 地址</td><td>ARTEX 服务器</td><td>2026-11-04</td><td>截至 2026-11-06 仍处于活跃状态</td></tr><tr><td>85.11.167[.]52</td><td>IP 地址</td><td>C2 服务器</td><td>2026-11-04</td><td>截至 2026-11-06 仍处于活跃状态</td></tr><tr><td>178.16.54[.]129</td><td>IP 地址</td><td>ARTEX 服务器</td><td>2026-10-19</td><td>截至 2026-11-06 仍处于活跃状态</td></tr><tr><td>31.77.229[.]35</td><td>IP 地址</td><td>ARTEX 服务器</td><td>2026-10-28</td><td>截至 2026-11-06 仍处于活跃状态</td></tr></tbody></table></figure><h3 id=\"sec-12\">了解更多</h3><p>如需了解 Microsoft Threat Intelligence 社区的最新安全研究，请查看 <a href=\"https://aka.ms/threatintelblog\">Microsoft Threat Intelligence Blog</a>。</p><p>如需获取新发布的资讯通知，并在社交媒体上参与讨论，请在 <a href=\"https://www.linkedin.com/showcase/microsoft-threat-intelligence\">LinkedIn</a>、<a href=\"https://x.com/MsftSecIntel\">X（原 Twitter）</a>和 <a href=\"https://bsky.app/profile/threatintel.microsoft.com\">Bluesky</a>上关注我们。</p><p>如需聆听 Microsoft Threat Intelligence 社区关于不断演变的威胁形势的故事和洞察，请收听 <a href=\"https://thecyberwire.com/podcasts/microsoft-threat-intelligence\">Microsoft Threat Intelligence 播客</a>。</p><p>文章 <a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/06/artex-abuse-expands-as-cybercriminals-target-financial-sector/\">随着网络犯罪分子将金融业作为目标，ARTEX 滥用现象不断加剧</a> 首发于 <a href=\"https://www.microsoft.com/en-us/security/blog\">Microsoft Security Blog</a>。</p>","original","zhKind","translation","complete","供应链投毒","数据窃取","Microsoft","https://www.microsoft.com/en-us/security/blog/2026/11/06/artex-abuse-expands-as-cybercriminals-target-financial-sector/","Microsoft Security Blog",{"_145":146,"_147":-5},"changelogVersion","2026-10-01T08:00","release"]
