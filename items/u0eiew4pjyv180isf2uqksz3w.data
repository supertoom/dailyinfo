[{"_1":2,"_3":4},"root",{"_5":293},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":37,"_59":60},"expiresAt",1795221641000,"id","u0eiew4pjyv180isf2uqksz3w","title","Xint 披露 nginx2Root 五项 RCE 漏洞及 Linux 内核提权链","originalTitle","NGINX2Root: New Remote Code Execution Vulnerabilities in nginx Require Urgent Patching","summary","Xint 披露 nginx 的 5 项未认证远程代码执行漏洞 CVE-2026-123007、CVE-2026-123634、CVE-2026-123633、CVE-2026-121810、CVE-2026-113425。","reason","文章拆解了五项 nginx 远程代码执行漏洞的根因、利用链和暴露条件，并提供逐配置缓解方法与取证检查，便于评估实际处置范围。","source",{"_72":292},"links",{"_278":291},"publishedAt","2026-11-18T15:29:55.488Z","discoveredAt","2026-11-18T15:41:36.953Z","timelineAt","category","disclosure","tags",[282,283,284,285,286,287,288,289,290],"score",100,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","body",{"_60":277,"_278":-5,"_279":280,"_281":37},"outline",[82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130,131,132,133,134,135,136,137,138,139,140,141,142,143,144,145],"relatedStories",[78],"topics",[67,68,69],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","fhCq_qoGx8H4","reportCount",3,"additionalSourceCount",2,{"_70":76,"_72":77},{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","research","name","技术研究","vuln","漏洞披露","kernel","内核与系统",{"_79":80,"_13":81},"publicId","3eb72e03-2965-4ea3-8b98-657fd92ab44d","F5已修复NGINX五项未认证RCE",{"_11":275,"_147":276,"_149":66},{"_11":273,"_147":274,"_149":66},{"_11":271,"_147":272,"_149":64},{"_11":269,"_147":270,"_149":64},{"_11":267,"_147":268,"_149":64},{"_11":265,"_147":266,"_149":64},{"_11":263,"_147":264,"_149":64},{"_11":261,"_147":262,"_149":66},{"_11":259,"_147":260,"_149":64},{"_11":257,"_147":258,"_149":160},{"_11":255,"_147":256,"_149":64},{"_11":253,"_147":254,"_149":64},{"_11":251,"_147":252,"_149":160},{"_11":249,"_147":250,"_149":160},{"_11":247,"_147":248,"_149":160},{"_11":245,"_147":246,"_149":160},{"_11":243,"_147":244,"_149":66},{"_11":241,"_147":242,"_149":64},{"_11":239,"_147":240,"_149":64},{"_11":237,"_147":238,"_149":160},{"_11":235,"_147":236,"_149":160},{"_11":233,"_147":234,"_149":160},{"_11":231,"_147":232,"_149":160},{"_11":229,"_147":230,"_149":160},{"_11":227,"_147":228,"_149":64},{"_11":225,"_147":226,"_149":160},{"_11":223,"_147":224,"_149":160},{"_11":221,"_147":222,"_149":160},{"_11":219,"_147":220,"_149":160},{"_11":217,"_147":218,"_149":160},{"_11":215,"_147":216,"_149":66},{"_11":213,"_147":214,"_149":66},{"_11":211,"_147":212,"_149":64},{"_11":209,"_147":210,"_149":160},{"_11":207,"_147":208,"_149":160},{"_11":205,"_147":206,"_149":160},{"_11":203,"_147":204,"_149":160},{"_11":201,"_147":202,"_149":160},{"_11":199,"_147":200,"_149":160},{"_11":197,"_147":198,"_149":160},{"_11":195,"_147":196,"_149":64},{"_11":193,"_147":194,"_149":160},{"_11":191,"_147":192,"_149":160},{"_11":189,"_147":190,"_149":160},{"_11":187,"_147":188,"_149":64},{"_11":185,"_147":186,"_149":160},{"_11":183,"_147":184,"_149":160},{"_11":181,"_147":182,"_149":160},{"_11":179,"_147":180,"_149":160},{"_11":177,"_147":178,"_149":64},{"_11":175,"_147":176,"_149":160},{"_11":173,"_147":174,"_149":160},{"_11":171,"_147":172,"_149":160},{"_11":169,"_147":170,"_149":64},{"_11":167,"_147":168,"_149":160},{"_11":165,"_147":166,"_149":160},{"_11":163,"_147":164,"_149":160},{"_11":161,"_147":162,"_149":160},{"_11":158,"_147":159,"_149":160},{"_11":156,"_147":157,"_149":66},{"_11":154,"_147":155,"_149":64},{"_11":152,"_147":153,"_149":64},{"_11":150,"_147":151,"_149":64},{"_11":146,"_147":148,"_149":66},"sec-64","text","关于 Xint","level","sec-63","6.3. 可利用性验证","sec-62","6.2. 漏洞详情","sec-61","6.1. SCTP 关联的工作方式","sec-60","6. Linux 内核分析LPE漏洞分析","sec-59","5.5.3. 可利用性验证",4,"sec-58","(2) Auth 连接使用已释放的会话","sec-57","(1) 查询期间释放客户端会话","sec-56","5.5.2. 漏洞详情","sec-55","5.5.1. 邮件代理如何对客户端进行身份验证","sec-54","5.5. CVE-2026-113425","sec-53","5.4.3. 可利用性验证","sec-52","5.4.2. 漏洞详情","sec-51","5.4.1. nginx 如何将 HTTP/3 流作为连接处理","sec-50","5.4. CVE-2026-121810","sec-49","5.3.3. 可利用性验证","sec-48","(2) 上游连接释放了其自身请求","sec-47","5.3.2. 漏洞详情","sec-46","5.3.1. nginx 在压力下如何重用连接","sec-45","5.3. CVE-2026-123633","sec-44","5.2.3. 可利用性验证","sec-43","5.2.2. 漏洞详情","sec-42","5.2.1. nginx在请求时如何解析上游名称","sec-41","5.2. CVE-2026-123634","sec-40","验证结果","sec-39","5.1.3. 可利用性验证","sec-38","(3) 从超大窗口到越界复制","sec-37","(2) 窗口检查中的无符号下溢","sec-36","(1) 返还队列额度时超过 31 位限制","sec-35","5.1.2. 漏洞详情","sec-34","5.1.1. nginx 如何管理 HTTP/2 发送窗口","sec-33","5.1. CVE-2026-123007","sec-32","5. nginx 漏洞的技术分析","sec-31","4. 发现与披露时间线","sec-30","3.3.5. 关闭现有连接","sec-29","3.3.4. 限制对邮件代理的访问（CVE-2026-113425）","sec-28","3.3.3. 禁用 HTTP/3（QUIC）（CVE-2026-121810）","sec-27","3.3.2. 移除请求时 DNS 查找（CVE-2026-123634）","sec-26","3.3.1. 禁用 HTTP/2（CVE-2026-123007 和 CVE-2026-123633）","sec-25","3.3. 打补丁前的紧急缓解措施","sec-24","3.2.5. 评估证据","sec-23","3.2.4. 检查工作进程异常退出","sec-22","3.2.3. 监控工作进程执行的命令","sec-21","3.2.2. 按连接审查请求","sec-20","3.2.1. 检查连接统计","sec-19","3.2. 调查可能的攻击","sec-18","3.1. 立即操作","sec-17","3. 响应与建议操作","sec-16","2.3.4。检查能否通过 Internet 访问 HTTP/2","sec-15","2.3.3。检查配置中是否启用了 HTTP/2","sec-14","2.3.2。检查 HTTP/2 模块","sec-13","2.3.1. 检查版本","sec-12","2.3. 检查暴露情况的命令","sec-11","2.2. 互联网暴露情况","sec-10","2.1.1. 受影响的 Linux 发行版","sec-9","2.1. 受影响版本","sec-8","2. 受影响版本及暴露情况检查方法","sec-7","nginx2root 概览","sec-6","我们是如何发现这些漏洞的","sec-5","应对措施","sec-4","受影响版本","sec-3","攻击者可以做什么","sec-2","1. 执行摘要","sec-1","简介","<h2 id=\"sec-1\"><strong>简介</strong></h2><p>nginx 是世界上部署最广泛的 Web 服务器之一。找到其中未经身份验证即可远程执行代码的漏洞，长期以来一直是安全研究人员追求的“圣杯”。Xint 研究团队最近发现了五个。这些漏洞每一个都能单独导致远程代码执行，但影响的配置各不相同。</p><p>Xint 还在 Linux 内核中发现了一个独立漏洞，可以与任意一个 nginx 漏洞串联，以在主机上获取 root 权限。我们将这六个漏洞统称为 <strong>nginx2root</strong>。</p><p>如果你运行 nginx，请在修复版本发布后尽快更新到 1.31.9。本文解释了每个 nginx2root 漏洞的根本原因，并总结了我们对可利用性的评估。有关暴露情况检查，请参阅第 2 节；有关补丁和临时缓解措施，请参阅第 3 节。</p><h2 id=\"sec-2\"><strong>1. 执行摘要</strong></h2><h3 id=\"sec-3\"><strong>攻击者可以做什么</strong></h3><p>五项发现中影响最大的 CVE-2026-123007 允许未经身份验证的攻击者在启用了 HTTP/2 的受影响 nginx 服务器上执行命令。命令以处理请求的 nginx 工作进程权限运行。</p><p>我们将此漏洞与 Linux 内核 SCTP 子系统中的另一个缺陷串联，从而在主机上获取 root 权限。在测试中，该攻击链还从运行 nginx 的 Docker 容器中逃逸，并获得了底层主机上的 root 权限。</p><p>在下面的视频中，我们使用 CVE-2026-123007 以容器内 nginx 工作进程的身份执行命令，然后利用内核漏洞将权限提升为主机上的 root。</p><figure><img src=\"/dailyinfo/media/22187609ac02827d.gif\" srcset=\"/dailyinfo/media/3811b00d11f98d21.gif 720w, /dailyinfo/media/ff145a26a9464203.gif 1200w, /dailyinfo/media/22187609ac02827d.gif 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"\" width=\"1280\" height=\"802\"><figcaption>nginx2root 演示视频</figcaption></figure><p>我们在 AWS 上运行了此演示，并通过服务器的公共 IP 地址发动攻击。AWS、GCP、Azure 和裸金属服务器的演示可在 <a href=\"http://nginx2root.com/\"><u>nginx2root.com</u></a> 获取。</p><hr><h3 id=\"sec-4\"><strong>受影响版本</strong></h3><p>五个 nginx 漏洞各自都是独立的攻击路径，无需相互串联。它们所影响的配置不同。</p><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p>CVE</p></th><th colspan=\"1\" rowspan=\"1\"><p>受影响的配置</p></th><th colspan=\"1\" rowspan=\"1\"><p>此路径首次受影响的版本</p></th><th colspan=\"1\" rowspan=\"1\"><p>禁用 HTTP/2 即可阻止？</p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>CVE-2026-123007</p></td><td colspan=\"1\" rowspan=\"1\"><p>启用 HTTP/2</p></td><td colspan=\"1\" rowspan=\"1\"><p>1.9.5</p></td><td colspan=\"1\" rowspan=\"1\"><p>是</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>CVE-2026-123634</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>resolver</code>、源自请求的 <code>proxy_pass</code> 目标，以及包含 <code>mirror_request_body off</code> 的 <code>mirror</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>1.13.4</p></td><td colspan=\"1\" rowspan=\"1\"><p>否</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>CVE-2026-123633</p></td><td colspan=\"1\" rowspan=\"1\"><p>使用 HTTP/2，且请求被转发至上游（后端）服务器</p></td><td colspan=\"1\" rowspan=\"1\"><p>1.19.7</p></td><td colspan=\"1\" rowspan=\"1\"><p>是</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>CVE-2026-121810</p></td><td colspan=\"1\" rowspan=\"1\"><p>使用 HTTP/3，且请求被转发至上游（后端）服务器</p></td><td colspan=\"1\" rowspan=\"1\"><p>1.25.0</p></td><td colspan=\"1\" rowspan=\"1\"><p>否</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>CVE-2026-113425</p></td><td colspan=\"1\" rowspan=\"1\"><p>邮件代理使用 <code>proxy on</code> 和 <code>auth_http</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>0.5.15</p></td><td colspan=\"1\" rowspan=\"1\"><p>否</p></td></tr></tbody></table><p>对于 CVE-2026-123634，表中显示的是我们测试过的配置，其中使用了 <code>mirror</code> 指令。其他会创建子请求的 nginx 功能（例如 SSI）也可能触发同一个漏洞，因此仅关闭 <code>mirror</code> 并不能让服务器安全。</p><p>自 nginx 在 2015 年引入 HTTP/2 以来，CVE-2026-123007 就一直存在，已有十余年。从 1.9.5 到 1.31.8 的每个官方版本都包含易受攻击的代码，包括 <span>Nov 10, 2026</span> 上的 <code>master</code> 分支。因此，即使是运行近期版本的服务器，也需要与较旧安装一样检查补丁状态和 HTTP/2 暴露情况。</p><h3 id=\"sec-5\"><strong>应对措施</strong></h3><p>1.31.9 发布后请立即更新。在此之前，在受影响的监听端口上禁用 HTTP/2 可阻止 CVE-2026-123007 和 CVE-2026-123633，但不能阻止另外三个 nginx 漏洞。请根据上表检查你的配置，并应用第 3.3 节中对应的缓解措施。</p><h3 id=\"sec-6\"><strong>我们是如何发现这些漏洞的</strong></h3><p>在为 ZeroDay Cloud 2026 做准备时，Xint 研究人员发现了 CVE-2026-123007。几天后，一次全自动 Xint 扫描在无人指导的情况下发现了另外四个漏洞。</p><h3 id=\"sec-7\"><strong>nginx2root 概览</strong></h3><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p>项目</p></th><th colspan=\"1\" rowspan=\"1\"><p>详情</p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>CVE</p></td><td colspan=\"1\" rowspan=\"1\"><p>CVE-2026-123007</p><p>CVE-2026-123634</p><p>CVE-2026-123633</p><p>CVE-2026-121810</p><p>CVE-2026-113425</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>严重程度</p></td><td colspan=\"1\" rowspan=\"1\"><p>严重</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>修复版本</p></td><td colspan=\"1\" rowspan=\"1\"><p>1.31.9</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>影响</p></td><td colspan=\"1\" rowspan=\"1\"><p>未经身份验证的远程攻击者可以以 nginx 工作进程权限执行任意命令</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>受影响版本（CVE-2026-123007）</p></td><td colspan=\"1\" rowspan=\"1\"><p><strong>从 nginx 1.9.5 到 1.31.8 的所有官方发行版本。易受攻击的代码截至 2026 年 11 月 10 日也仍存在于 </strong><code>master</code><strong> 中</strong></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>代码历史（CVE-2026-123007）</p></td><td colspan=\"1\" rowspan=\"1\"><p>随首个 HTTP/2 发行版 nginx 1.9.5 引入，并一直保留至当前受影响的发行版</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>临时缓解措施（CVE-2026-123007）</p></td><td colspan=\"1\" rowspan=\"1\"><p>在受影响的监听端口上禁用 HTTP/2</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>完整修复</p></td><td colspan=\"1\" rowspan=\"1\"><p>更新至&nbsp;1.31.9</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>报告者</p></td><td colspan=\"1\" rowspan=\"1\"><p>Xint Researchers（@imssm99、@cdor1、@tjbecker、@yves）</p></td></tr></tbody></table><h2 id=\"sec-8\"><strong>2. 受影响版本及暴露情况检查方法</strong></h2><p>第 2 节重点介绍 CVE-2026-123007，这是影响服务器数量最多的漏洞。利用它只需要启用 HTTP/2。对于另外四个 nginx 漏洞，请先查看第 1 节中的配置表。</p><h3 id=\"sec-9\"><strong>2.1. 受影响版本</strong></h3><p>CVE-2026-123007 <mark>影响</mark>从 1.9.5 到 1.31.8 的每个 nginx 官方发行版。截至 2026 年 11 月 10 日，易受攻击的代码仍存在于开发分支（<code>master</code>）中。</p><h4 id=\"sec-10\"><strong>2.1.1. 受影响的 Linux 发行版</strong></h4><p><strong>仅凭版本号可能无法判断服务器是否已修补。</strong></p><p>最常见的三个版本是主要 Linux 发行版附带的默认软件包版本。Ubuntu 24.04 附带 1.24.0，Ubuntu 22.04 提供 1.18.0，Debian 12 提供 1.22.1。这些发行版可能会将安全修复反向移植到现有版本，而不是用新的 nginx 发行版替换。</p><p>反向移植可以在不改变 <code>nginx -v</code> 报告版本的情况下修复漏洞。只有发行版的完整软件包版本会发生变化。例如，Ubuntu 22.04 最初附带 <code>1.18.0-6ubuntu14</code>。截至 2026 年 10 月 26 日，<a href=\"https://ubuntu.com/security/notices/USN-8955-1\"><u>安全更新</u></a>已将软件包升级至 <code>1.18.0-6ubuntu14.22</code>，而 nginx 版本仍为 <code>1.18.0</code>。</p><p>要确定是否包含特定修复，请将完整的已安装软件包版本与发行版<mark>的安全公告进行比较。</mark></p><h3 id=\"sec-11\"><strong>2.2. 互联网暴露情况</strong></h3><p><mark>截至 2026 年 11 月 10 日，Shodan 对 </mark><code>product:nginx</code><mark> 返回了 5670 万个主机。其中，1194 万个主机（21.1%）报告了可识别的版本。在已识别版本的主机中，98.9% 处于 CVE-2026-123007 受影响的版本范围内：1.9.5 至 1.31.8。</mark></p><p><mark>这些数字基于报告的版本字符串，不能确认服务器存在漏洞。利用 CVE-2026-123007 还需要启用 HTTP/2，并且报告的版本可能已经包含反向移植的修复。</mark></p><h3 id=\"sec-12\"><strong>2.3. 检查暴露情况的命令</strong></h3><p>如果服务器运行未修补的版本、包含 HTTP/2 模块并启用了 HTTP/2，则会受到 CVE-2026-123007 的影响。以下前三项检查分别测试这些条件，第四项检查是否可通过互联网访问 HTTP/2。本节末尾的表格说明了如何解读综合结果。</p><h4 id=\"sec-13\"><strong>2.3.1. 检查版本</strong></h4><p>首先，输出 nginx 版本。</p><pre><code>nginx -v 2&gt;&amp;1</code></pre><p>该命令会输出类似 <code>nginx version: nginx/1.31.8</code> 的版本字符串。</p><ul><li><p><strong>1.9.5 至 1.31.8：</strong>官方发行版包含易受攻击的代码。请继续进行后续检查。</p></li><li><p><strong>1.9.4 或更早版本：</strong>在 HTTP/2 支持之前发布，因此不受影响。</p></li><li><p><strong>1.31.9 或更高版本：</strong>可能已修补，但请确认该版本包含 <a href=\"https://my.f5.com/manage/s/article/K000164058\">my.f5.com/manage/s/article/K000164058</a> 中引用的变更。</p></li><li><p><strong><mark>发行版或设备专用版本：</mark></strong><mark>不要仅依赖版本字符串。请确认是否已回移此修复。</mark></p></li></ul><h4 id=\"sec-14\"><strong><mark>2.3.2。检查 HTTP/2 模块</mark></strong></h4><p>检查该二进制文件是否使用 HTTP/2 模块构建。</p><pre><code>nginx -V 2&gt;&amp;1 | grep -q -- <span>'--with-http_v2_module'</span> \\\n  &amp;&amp; <span>echo</span> <span>'HTTP2_MODULE=present'</span> \\\n  || <span>echo</span> <span>'HTTP2_MODULE=absent'</span></code></pre><ul><li><p><code>HTTP2_MODULE=present</code>：该二进制文件包含 HTTP/2 代码；如果未修补，则存在漏洞。请继续进行下一项检查。</p></li><li><p><code>HTTP2_MODULE=absent</code>：该二进制文件不包含 HTTP/2 代码，因此不受此漏洞影响。</p></li></ul><h4 id=\"sec-15\"><strong>2.3.3。检查配置中是否启用了 HTTP/2</strong></h4><p>在配置中搜索启用 HTTP/2 的指令。</p><pre><code><span>sudo</span> nginx -T 2&gt;&amp;1 \\\n  | sed <span>'s/#.*//'</span> \\\n  | grep -nE <span>'listen[[:space:]].*http2|^[[:space:]]*http2[[:space:]]+on[[:space:]]*;'</span></code></pre><p>输出（例如 <code>listen 443 ssl http2;</code> 或 <code>http2 on;</code>）表示已启用 HTTP/2；没有输出表示未启用。请注意，<code>nginx -T</code>读取的是磁盘上的配置。如果你修改配置后未重新加载 nginx，运行中的配置可能有所不同。</p><h4 id=\"sec-16\"><strong>2.3.4。检查能否通过 Internet 访问 HTTP/2</strong></h4><p>在网络外部的机器上运行以下命令。该命令会在 TLS 握手期间向服务器请求 HTTP/2。请将两个 <code>{HOST}</code> 占位符都替换为你的域名；如果使用的不是 443 端口，还需更改端口。</p><pre><code>openssl s_client -<span>connect</span> <span>{HOST}</span>:<span>443</span> -servername <span>{HOST}</span> -alpn h2 &lt;<span>/dev/null</span> <span>2</span>&gt;&amp;<span>1</span> \\\n  | <span>grep</span> -E <span>'ALPN protocol:|No ALPN negotiated|Connection refused|connect:errno|handshake failure'</span></code></pre><p>如果看到 ALPN protocol: h2，则表示服务器接受来自 Internet 的 HTTP/2；No ALPN negotiated 表示不接受。其他任何输出都表示连接失败，因此请检查服务器是否可访问并重试。</p><p>如果 nginx 前面部署了 CDN 或反向代理，该测试只能访问到代理，因此还要直接对 nginx 服务器运行此测试。</p><p>请根据下表综合解读结果。</p><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p>结果</p></th><th colspan=\"1\" rowspan=\"1\"><p>评估</p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>未修补的 1.9.5 至 1.31.8 + <code>HTTP2_MODULE=present</code> + <code>ALPN protocol: h2</code>，且使用实际的 nginx 端口</p></td><td colspan=\"1\" rowspan=\"1\"><p><strong>存在漏洞且可从外部访问。需要立即采取行动</strong></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>未修补的 1.9.5 至 1.31.8 + <code>HTTP2_MODULE=present</code> + 已禁用 HTTP/2</p></td><td colspan=\"1\" rowspan=\"1\"><p><strong>存在漏洞代码，但当前攻击路径已被禁用</strong></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>1.9.4 或更早版本，或 <code>HTTP2_MODULE=absent</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><strong>不受此漏洞影响</strong></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>已安装 1.31.9，或已确认较早版本中回移了此修复</p></td><td colspan=\"1\" rowspan=\"1\"><p><strong>已修补。不再存在漏洞</strong></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>连接失败、TLS 握手失败或修补状态不明确</p></td><td colspan=\"1\" rowspan=\"1\"><p><strong>无法确定。需要进一步审查</strong></p></td></tr></tbody></table><h2 id=\"sec-17\"><strong>3. 响应与建议操作</strong></h2><h3 id=\"sec-18\"><strong>3.1. 立即操作</strong></h3><p>修复版本发布后，将 nginx 更新至 1.31.9，并确认所安装的版本包含针对全部五个漏洞的修复。如果无法立即修补，请应用第 3.3 节中与你的配置相对应的缓解措施。请注意，禁用 HTTP/2 只能解决五个 nginx 漏洞中的两个。</p><p>安装更新后，请重启 nginx 或完成受支持的二进制文件实时升级。仅重新加载配置无法替换正在运行的可执行文件。</p><h3 id=\"sec-19\"><strong>3.2. 调查可能的攻击</strong></h3><p>利用 CVE-2026-123007 发动的攻击可能不会在 nginx 访问日志中留下多少证据。用于触发漏洞的 <code>WINDOW_UPDATE</code> 和 <code>RST_STREAM</code> 控制帧不会作为请求被记录，而且 TLS 会在传输过程中对其加密。以下小节介绍另外四个需要检查的位置：连接统计（3.2.1）、每个连接的请求数（3.2.2）、工作进程启动的程序（3.2.3）以及工作进程崩溃（3.2.4）。第 3.2.5 节说明如何综合评估这些结果。</p><h4 id=\"sec-20\"><strong>3.2.1. 检查连接统计</strong></h4><p>在目标服务器上，检查端口 443 的 TCP 统计信息。</p><pre><code><span>sudo</span> ss -tinp state established <span>'( sport = :443 )'</span></code></pre><p>将命令运行两次，间隔一小段时间，并比较 <code>bytes_received</code> 和 <code>bytes_sent</code> 的变化。优先关注同时表现出以下多种情况的连接：</p><ul><li><p>来自同一个外部 IP 的连接持续开放数分钟</p></li><li><p><code>bytes_received</code> 继续非常快速地增长</p></li><li><p>服务器的 <code>bytes_sent</code> 远小于接收到的流量</p></li><li><p>同一个外部 IP 还创建了许多短生命周期的 TLS 连接</p></li></ul><p>这些模式与我们测试的攻击相符。它通过一个长连接发送大量 <code>WINDOW_UPDATE</code> 帧，因此 nginx 几乎不返回任何内容，而 <code>bytes_received</code> 会持续攀升。它还会从同一个 IP 打开许多短 TLS 连接。如果连续数分钟同时观察到这两种情况，且不存在合理的解释（例如大型上传），则应封禁该来源并展开调查。</p><h4 id=\"sec-21\"><strong>3.2.2. 按连接审查请求</strong></h4><p>默认访问日志不会显示每个请求所属的连接。下面的日志格式增加了连接 ID（<code>conn</code>）、该连接上的请求数量以及每个请求的大小。将其添加到 nginx 的 <code>http</code> 块中。无需使用调试构建。</p><pre><code>log_format h2_hunt '<span>$time_iso8601</span> src<span>=</span><span>$remote_addr</span> conn<span>=</span><span>$connection</span> '\n                   'requests<span>=</span><span>$connection_requests</span> proto<span>=</span><span>$server_protocol</span> '\n                   'status<span>=</span><span>$status</span> request_length<span>=</span><span>$request_length</span> '\n                   'bytes_sent<span>=</span><span>$bytes_sent</span> request_time<span>=</span><span>$request_time</span>';\n\naccess_log <span>/var/</span>log<span>/nginx/</span>h2<span>-</span>hunt.log h2_hunt;</code></pre><p>验证并重新加载配置，然后仅显示 HTTP/2 请求。</p><pre><code><span>sudo</span> nginx -t &amp;&amp; <span>sudo</span> nginx -s reload\n<span>sudo</span> grep <span>'proto=HTTP/2.0'</span> /var/log/nginx/h2-hunt.log | <span>tail</span> -n 200</code></pre><p>从第 3.2.1 节获取一个可疑 IP，按 <code>conn</code> 汇总其日志条目中的 <code>request_length</code>。将该总和与 <code>ss</code> 针对同一 IP 显示的 <code>bytes_received</code> 进行比较。如果 <code>bytes_received</code> 持续快速增长，而记录的请求长度仍然很小，则说明客户端正在发送大量从未体现为请求的数据。这符合 HTTP/2 控制帧洪泛攻击的特征，与此次攻击相同。同一时间段内较长的 <code>request_time</code> 值也是另一项迹象。</p><h4 id=\"sec-22\"><strong>3.2.3. 监控工作进程执行的命令</strong></h4><p>我们的漏洞利用使用 <code>execve()</code> 启动 shell 或其他程序。正常的 nginx 工作进程没有理由运行外部程序，因此它启动的任何程序都值得立即调查。首先，确定工作进程账户的 UID。</p><pre><code>ps -eo uid,user,pid,ppid,<span>args</span> | grep <span>'[n]ginx: worker process'</span></code></pre><p>在使用 Linux audit 子系统 <code>auditd</code> 的系统上，将 <code>NGINX_UID</code> 替换为上一个输出中的数字 UID，并添加以下规则。</p><pre><code><span>sudo</span> auditctl -a always,<span>exit</span> -F <span>arch</span>=b64 -S execve,execveat \\\n  -F euid=NGINX_UID -k nginx_worker_exec</code></pre><p>该规则只会记录安装后发生的执行行为。空结果不能排除此前已经遭到入侵。它还会匹配使用相同 UID 的其他进程，因此应检查进程和父进程 ID，以确定事件是否来自 nginx。</p><p>使用以下命令审查记录：</p><pre><code><span>sudo</span> ausearch -k nginx_worker_exec -ts recent -i</code></pre><p>查找 <code>/bin/sh</code>、<code>/bin/bash</code> 或由 nginx 工作进程启动的任何其他程序。如果其他应用程序以同一账户运行，则应根据服务配置检查每个事件的父进程，以确定哪些事件来自 nginx。</p><h4 id=\"sec-23\"><strong>3.2.4. 检查工作进程异常退出</strong></h4><p>漏洞利用尝试失败可能导致 nginx 工作进程崩溃，因此应使用以下命令查找异常退出和核心转储。</p><pre><code><span>sudo</span> grep -Ei <span>'worker process.*exited|signal 11|segfault'</span> /var/log/nginx/error.log\n<span>sudo</span> coredumpctl list nginx</code></pre><p>工作进程可能因与攻击无关的原因崩溃。在得出结论前，应将这些记录与其他信号进行关联分析。</p><h4 id=\"sec-24\"><strong>3.2.5. 评估证据</strong></h4><p>由 nginx 工作进程启动的程序（第 3.2.3 节）是攻击成功的最明确迹象。应立即进行调查。下面的迹象较弱，而且每一种单独出现都可能有正常原因。如果多种迹象同时出现且无法解释，则应封禁该来源并展开调查：</p><ul><li><p>持续的高入站流量（第 3.2.1 节）。</p></li><li><p>来自同一来源的大量连接（第 3.2.1 节）。</p></li><li><p>实际接收字节数与记录的请求长度之间存在巨大差异（第 3.2.2 节）。</p></li><li><p>工作进程反复异常退出（第 3.2.4 节）。</p></li></ul><h3 id=\"sec-25\"><strong>3.3. 打补丁前的紧急缓解措施</strong></h3><p>在补丁发布之前，禁用受影响功能可以阻断已知的攻击路径。这些措施只是临时性的。修复版本发布后应立即安装。</p><h4 id=\"sec-26\"><strong>3.3.1. 禁用 HTTP/2（CVE-2026-123007 和 CVE-2026-123633）</strong></h4><p>这两个漏洞都源于 nginx 处理 HTTP/2 连接的过程。在安装补丁之前，应在受影响的端口上禁用 HTTP/2。支持 HTTP/1.1 的客户端仍可继续使用该服务，但需要 HTTP/2 的服务（例如原生 gRPC）将受到影响。</p><p>对于 nginx 1.25.1 及更高版本，在每个受影响的 <code>server</code> 块中设置 <code>http2 off;</code>，并从其 <code>listen</code> 指令中移除所有旧版 <code>http2</code> 参数。检查所有共享同一监听地址和端口的 server 块。</p><pre><code><span>listen</span> <span>443</span> ssl;\nhttp2 off;</code></pre><p>对于 nginx 1.9.5 至 1.25.0，从 <code>listen 443 ssl http2;</code> 中移除 <code>http2</code>。</p><pre><code><span>listen</span> <span>443</span> ssl;</code></pre><p>验证并重新加载配置。然后重复第 2.3.4 节中的 HTTP/2 检查，以确认更改已生效。</p><pre><code><span>sudo</span> nginx -t\n<span>sudo</span> nginx -s reload\nopenssl s_client -connect HOST:443 -servername HOST -alpn h2 &lt;/dev/null 2&gt;&amp;1 | grep -F <span>'ALPN protocol: h2'</span></code></pre><p>禁用 HTTP/2 后，最后一条命令不会输出任何内容。如果连接失败，它也不会输出任何内容，因此请确保站点仍可通过 HTTPS 正常加载。</p><h4 id=\"sec-27\"><strong>3.3.2. 移除请求时 DNS 查找（CVE-2026-123634）</strong></h4><p>此缓解措施适用于按请求选择上游（后端）且还使用 <code>mirror</code> 的服务器。当 <code>proxy_pass</code> 中包含变量（例如 <code>proxy_pass http://$host;</code>），并且 nginx 在处理请求时使用其 <code>resolver</code> 通过 DNS 查找该名称时，就会出现这种情况。</p><p>该缺陷会在主请求及其镜像等待同一 DNS 响应时触发。在安装补丁之前，应将 <code>proxy_pass</code> 指向固定的上游组。这样可以移除请求期间的 DNS 查找，并阻断我们测试到的攻击路径。</p><p>设置 <code>mirror_request_body on</code> 也阻止了我们的利用，但这并不能修复解析器缺陷。不要仅依赖此设置。</p><p>如果不需要镜像，请在受影响的 <code>location</code> 中将其关闭，并将 <code>proxy_pass</code> 指向固定的上游。将 <code>{BACKEND_IP}</code> 替换为后端的 IP 地址，并根据需要调整端口：</p><pre><code>upstream backend_hotfix {\n    server {BACKEND_IP}:<span>8080</span>;\n}\nlocation / {\n    mirror off;\n    proxy_pass http://backend_hotfix;\n}</code></pre><p>如果需要镜像，请为主请求和镜像都使用固定的上游组。下面的示例将主请求和镜像发送到不同的后端；如果两者使用同一后端，请将它们指向同一个固定组：</p><pre><code>upstream backend_main_hotfix {\n    server [MAIN_SERVER_IP]:8080;\n}\nupstream backend_mirror_hotfix {\n    server [MIRROR_SERVER_IP]:8080;\n}\nlocation / {\n    mirror /mirror;\n    proxy_pass http://backend_hotfix;\n}\nlocation = /mirror {\n    internal;\n    proxy_pass http://backend_mirror_hotfix;\n}</code></pre><p>验证并重新加载配置：</p><pre><code><span>sudo</span> nginx -t\n<span>sudo</span> nginx -s reload</code></pre><h4 id=\"sec-28\"><strong>3.3.3. 禁用 HTTP/3（</strong><strong>QUIC</strong><strong>）（CVE-2026-121810）</strong></h4><p>该漏洞源于 nginx 在 QUIC 连接上处理 HTTP/3 请求流的方式，因此在安装补丁之前，应从受影响的服务中移除 QUIC 监听器。</p><p>在每个受影响的 <code>server</code> 块中，移除包含 <code>quic</code> 的 <code>listen</code> 指令，设置 <code>http3 off</code>，并将任何用于通告 HTTP/3 的 <code>Alt-Svc</code> 标头替换为 <code>Alt-Svc 'clear'</code>。基于 TCP 的常规 TLS 监听器会保留，因此结果应如下所示：</p><pre><code><span>listen</span> <span>443</span> ssl;\n<span># listen 443 quic reuseport;</span>\n<span># listen [::]:443 quic reuseport;</span>\nhttp3 off;\nadd_header Alt-Svc <span>'clear'</span> always;</code></pre><p>验证并重新加载配置。然后检查是否仍有任何服务在端口 443 上接受 UDP 流量（根据需要调整端口）：</p><pre><code><span>sudo</span> nginx -t &amp;&amp; <span>sudo</span> nginx -s reload\n<span>sudo</span> ss -lunp <span>'sport = :443'</span></code></pre><p>如果输出中仍显示 <code>nginx</code>，则说明 QUIC 监听器仍处于活动状态。为了增加防御，还应使用防火墙阻止该端口上的 UDP 流量。</p><h4 id=\"sec-29\"><strong>3.3.4. 限制对邮件代理的访问（CVE-2026-113425）</strong></h4><p>此缓解措施仅适用于将 nginx 作为邮件代理置于 IMAP、POP3 或 SMTP 服务器之前的场景。如果 <code>mail</code> 块同时使用 <code>proxy on</code> 和 <code>auth_http</code>，则会受到影响。使用 <code>auth_http</code> 时，nginx 会向 HTTP 服务询问每次登录是否有效。该缺陷会在登录期间触发，攻击者无需有效凭据。在安装补丁之前，应确保不受信任的客户端无法访问邮件代理。</p><p>如果代理不需要外部访问，请将每个 IMAP、POP3 和 SMTP 监听器绑定到环回地址。这样只有同一台计算机上的程序才能连接。远程客户端（例如用户的邮件应用）将无法再访问该代理。例如：</p><pre><code>listen <span>127.0</span>.<span>0.1</span>:<span>143</span>;</code></pre><p>验证并重新加载配置，然后确认邮件端口不再监听外部地址：</p><pre><code><span>sudo</span> nginx -t &amp;&amp; <span>sudo</span> nginx -s reload\n<span>sudo</span> ss -ltnp | grep -E <span>':(25|110|143|465|587|993|995)([[:space:]]|$)'</span></code></pre><p>该命令会检查标准邮件端口。如果你的端口不同，请添加你的端口。如果外部客户端确实需要访问该代理，请使用防火墙仅允许你信任的 IP 地址。</p><h4 id=\"sec-30\"><strong>3.3.5. 关闭现有连接</strong></h4><p>重新加载只会将新配置应用于新连接。已经打开的连接（例如 HTTP/2 或邮件会话）会继续使用旧工作进程，并继续采用旧配置。在 <code>ps</code> 中，这些工作进程显示为 <code>nginx: worker process is shutting down</code>。</p><p>如果重新加载后这些工作进程仍在运行，请通过服务管理器重启 nginx（例如 <code>systemctl restart nginx</code>）。重启会强制断开所有客户端连接，并中断正在进行的下载、上传和邮件会话，因此预计服务会短暂中断。</p><h2 id=\"sec-31\"><strong>4. 发现与披露时间线</strong></h2><p>一次发现五个远程代码执行漏洞对 nginx 而言并不常见。在二十多年的安全研究中，nginx 仅出现过极少数未经身份验证的 RCE。其中一个例子是 CVE-2013-2028，这是由精心构造的 HTTP 请求触发的堆栈缓冲区溢出。</p><p>今年发现更多 nginx 漏洞的并非只有我们。2025 年，<a href=\"https://nginx.org/en/security_advisories.html\"><u>nginx 安全公告列表</u></a>记录了两个新漏洞。截至今年 11 月 17 日，该列表已记录了 26 个漏洞（不包括 nginx2root），其中数个属于内存破坏漏洞，例如缓冲区溢出和释放后重用。即便是像 nginx 这样经过深入研究的代码，AI 辅助的研究也比以往任何时候都更快地发现漏洞。借助 nginx2root，Xint 一次又新增了五个漏洞。</p><p>下方时间线涵盖漏洞的发现、披露以及计划的补丁发布。所有日期均为韩国标准时间（KST）。</p><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p>日期</p></th><th colspan=\"1\" rowspan=\"1\"><p>事件</p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><span>2026 年 10 月 11 日</span></p></td><td colspan=\"1\" rowspan=\"1\"><p>Xint 研究团队发现了这些漏洞</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><span>2026 年 10 月 16 日</span></p></td><td colspan=\"1\" rowspan=\"1\"><p>通过 HackerOne 向 F5 报告漏洞</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><span>2026 年 10 月 20 日</span></p></td><td colspan=\"1\" rowspan=\"1\"><p>HackerOne 完成验证</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><span>2026 年 10 月 27 日</span></p></td><td colspan=\"1\" rowspan=\"1\"><p>报告交付给 F5 的 nginx 开发团队</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><span>2026 年 11 月 10 日</span></p></td><td colspan=\"1\" rowspan=\"1\"><p>nginx 团队请求进行补丁验证</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><span>2026 年 11 月 10 日</span></p></td><td colspan=\"1\" rowspan=\"1\"><p>Xint 研究团队完成补丁验证</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><span>2026 年 11 月 19 日</span></p></td><td colspan=\"1\" rowspan=\"1\"><p>计划发布补丁</p></td></tr></tbody></table><h2 id=\"sec-32\"><strong>5. nginx 漏洞的技术分析</strong></h2><p>本节 examines 五个 nginx 漏洞。CVE-2026-123007 源于窗口计算错误，该错误会导致越界写入。另外四个是释放后重用漏洞。对于每个漏洞，我们将解释相关的 nginx 功能与行为，追踪漏洞背后的代码，并概述其如何导致远程代码执行。我们会说明如何实现地址泄露和可控内存破坏，但有意省略了复现完整漏洞利用所需的最后步骤。</p><h3 id=\"sec-33\"><strong>5.1. CVE-2026-123007</strong></h3><p>CVE-2026-123007 是 HTTP/2 流控中的整数溢出漏洞。发送窗口超过允许的最大值，最终产生无效的内存复制长度，进而导致堆上的越界读取和写入。</p><h4 id=\"sec-34\"><strong>5.1.1. nginx 如何管理 HTTP/2 发送窗口</strong></h4><p>HTTP/2 通过单个连接处理多个请求和响应。每个请求与响应对应使用一个流。客户端创建的流会获得称为 Stream ID 的不同标识符，例如 1、3 和 5。在每个流内，HEADERS 帧承载标头，DATA 帧承载正文。</p><p>HTTP/2 使用流控机制，防止服务器发送的数据超过客户端准备好接收的数据量。服务器通过发送窗口跟踪这一状态，每个流各有一个窗口，整个连接还有一个窗口，称为 h2c 窗口。每个窗口记录服务器仍可发送的 DATA 数量。只有当该流的窗口和 h2c 窗口都有足够额度时，服务器才能在该流上发送 DATA。当客户端准备好接收更多数据时，它会发送一个 <code>WINDOW_UPDATE</code> 帧，服务器相应增加对应窗口的额度。</p><p><code>WINDOW_UPDATE</code> 中的 Stream ID 决定增加哪个窗口的额度。Stream ID 0 会更新 h2c 窗口，而非零 Stream ID 只更新该流的窗口。</p><p>nginx 的默认窗口为 65,535（<code>0xffff</code>），最大值为 <code>0x7fffffff</code>（<code>(1U &lt;&lt; 31) - 1</code>）。</p><pre><code>/<span>/ https:/</span><span>/github.com/nginx</span><span>/nginx/blob</span><span>/140aa942711868a8daeb95810bc9a81f272ada72/src</span><span>/http/v</span>2/ngx_http_v2.h<span>#L50-L51</span>\n<span>#define NGX_HTTP_V2_MAX_WINDOW      ((1U &lt;&lt; 31) - 1)</span>\n<span>#define NGX_HTTP_V2_DEFAULT_WINDOW  65535</span></code></pre><p>nginx 在通过套接字发送帧之前，会将其保存在内存中的输出队列里。当它将响应 DATA 加入队列时，<code>ngx_http_v2_send_chain()</code> 会从连接级发送窗口 <code>h2c-&gt;send_window</code> 和流的发送窗口 <code>stream-&gt;send_window</code> 中扣除 DATA 的长度。</p><pre><code>/<span>/ https:/</span><span>/github.com/nginx</span><span>/nginx/blob</span><span>/140aa942711868a8daeb95810bc9a81f272ada72/src</span><span>/http/v</span>2/ngx_http_v2_filter_module.c<span>#L1232-L1244</span>\nngx_http_v2_queue_frame(h2c, frame);\nh2c-&gt;send_window -= frame_size;\nstream-&gt;send_window -= frame_size;\nstream-&gt;queued++;</code></pre><p>如果流在 DATA 发送之前被取消，<code>ngx_http_v2_filter_cleanup()</code> 会从队列中移除该流剩余的 DATA 帧，并把已扣除的长度返还给连接级发送窗口。</p><pre><code>/<span>/ https:/</span><span>/github.com/nginx</span><span>/nginx/blob</span><span>/140aa942711868a8daeb95810bc9a81f272ada72/src</span><span>/http/v</span>2/ngx_http_v2_filter_module.c<span>#L1719-L1767</span>\nh2c-&gt;send_window += window;</code></pre><p>nginx 在将 DATA 加入队列时扣除额度，并在流于 DATA 发送前被取消时返还该额度。这两个步骤本身都是有效的。问题在于两者之间可能发生的情况。当 DATA 仍在队列中时，客户端可以发送一个 <code>WINDOW_UPDATE</code>，再次提高窗口额度。如果随后取消该流，清理过程会在已提高的窗口额度之上再加上返还的额度。清理过程从不根据 HTTP/2 最大值检查结果，因此 <code>h2c-&gt;send_window</code> 最终可能超过允许的上限。</p><h4 id=\"sec-35\"><strong>5.1.2. 漏洞详情</strong></h4><p>从窗口记账错误到命令执行的序列概括如下。小节 (1) 涵盖步骤 1–2，小节 (2) 涵盖步骤 3，小节 (3) 从较高层面涵盖步骤 4–6。</p><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p>步骤</p></th><th colspan=\"1\" rowspan=\"1\"><p>说明</p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><ol><li><p>将 DATA 保留在队列中</p></li></ol></td><td colspan=\"1\" rowspan=\"1\"><p>将响应正文加入队列，并从发送窗口中扣除其长度，同时防止 DATA 到达客户端。</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><ol><li><p>提高窗口额度，返还队列中的额度</p></li></ol></td><td colspan=\"1\" rowspan=\"1\"><p>通过 <code>WINDOW_UPDATE</code> 提高发送窗口，然后取消这些流，使清理过程加上为队列中 DATA 扣除的额度。</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><ol><li><p>绕过上限检查</p></li></ol></td><td colspan=\"1\" rowspan=\"1\"><p>一旦共享连接窗口超过其最大值，剩余容量计算就会失效，后续的 <code>WINDOW_UPDATE</code> 帧仍会被接受。</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><ol><li><p>创建异常复制长度</p></li></ol></td><td colspan=\"1\" rowspan=\"1\"><p>代码将相同的位分别解释为有符号值和无符号值，从而把一个较小的负距离转换为非常大的复制长度。</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><ol><li><p>泄露地址并破坏内存</p></li></ol></td><td colspan=\"1\" rowspan=\"1\"><p>将复制的两端定位到响应中返回的内存指针处，从而破坏 TLS 分配元数据。</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><ol><li><p>控制清理回调</p></li></ol></td><td colspan=\"1\" rowspan=\"1\"><p>利用泄露的地址和被破坏的内存覆写清理函数指针，然后在清理调用该函数时执行任意命令。</p></td></tr></tbody></table><h4 id=\"sec-36\"><strong>(1) 返还队列额度时超过 31 位限制</strong></h4><p>第一个目标是在 nginx 的输出队列中累积 DATA，使其已消耗窗口额度但尚未发送。</p><p>客户端首先将连接发送窗口提高到最大值（<code>Wmax</code>），并在 Stream ID 0 上发送一个带有 <code>WINDOW_UPDATE</code> 的帧。客户端通过 SETTINGS 帧中的 <code>SETTINGS_INITIAL_WINDOW_SIZE</code> 设置新流的初始发送窗口。将其设为 0 可以让 nginx 创建响应 HEADERS，但会阻止其发送 DATA。这会使响应正文保持挂起状态，直至客户端选择释放它们。</p><p>接下来，客户端停止读取并突发发送 PING 帧。nginx 会将控制帧响应（包括 PING 确认）放在待处理的 DATA 之前，因此这些确认会填满 TLS 和 TCP 发送缓冲区。随后，客户端为每个流发送足够覆盖其整个响应正文的 <code>WINDOW_UPDATE</code> 信用额度，导致 nginx 将 DATA 排队并从连接发送窗口中扣除其长度。由于 TLS 和 TCP 缓冲区已经填满，这些 DATA 会无限期保持排队状态。</p><p>设 <code>Q</code> 为这些已排队 DATA 的总量。客户端现在两次将 <code>Q</code> 加回 h2c 窗口。首先，它在 Stream ID 0 上发送一个授予 <code>Q</code> 信用额度的 <code>WINDOW_UPDATE</code>。其次，它发送 <code>RST_STREAM</code> 以取消这些流。取消操作会触发清理，丢弃未发送的 DATA 并返还其信用额度，从而再次将 <code>Q</code> 加入 h2c 窗口。</p><pre><code>/<span>/ https:/</span><span>/github.com/nginx</span><span>/nginx/blob</span><span>/140aa942711868a8daeb95810bc9a81f272ada72/src</span><span>/http/v</span>2/ngx_http_v2_filter_module.c<span>#L1723-L1767</span>\n<span>if</span> (frame-&gt;stream == stream &amp;&amp; !frame-&gt;blocked) {\n    *fn = frame-&gt;<span>next</span>;\n    window += frame-&gt;length;\n}\nh2c-&gt;send_window += window;</code></pre><p>这第二次增加（显示在上面的最后一行）没有上限检查。因此，h2c 窗口会依次经过四个值：</p><ul><li><p><code>Wmax</code>：客户端将窗口提高到最大值。</p></li><li><p><code>Wmax - Q</code>：将 DATA 排队会扣除 <code>Q</code>。</p></li><li><p><code>Wmax</code>：Stream ID 0 上的 <code>WINDOW_UPDATE</code> 返还 <code>Q</code>。</p></li><li><p><code>Wmax + Q</code>：清理第二次返还 <code>Q</code>，使窗口超过 31 位限制。</p></li></ul><p>确切的响应大小和流数量并不重要。关键在于，同一个已知数量 <code>Q</code> 被加了两次，一次由 <code>WINDOW_UPDATE</code> 完成，另一次由清理操作完成。</p><h4 id=\"sec-37\"><strong>(2) 窗口检查中的无符号下溢</strong></h4><p><code>ngx_http_v2_state_window_update()</code> 在应用增量之前计算剩余容量。</p><pre><code>/<span>/ https:/</span><span>/github.com/nginx</span><span>/nginx/blob</span><span>/140aa942711868a8daeb95810bc9a81f272ada72/src</span><span>/http/v</span>2/ngx_http_v2.c<span>#L2564-L2575</span>\n<span>if</span> (window &gt; <span>NGX_HTTP_V2_MAX_WINDOW</span> - h2c-&gt;send_window) {\n    <span>return</span> ngx_http_v2_connection_error(h2c, <span>NGX_HTTP_V2_FLOW_CTRL_ERROR</span>);\n}\nh2c-&gt;send_window += window;</code></pre><p>此检查仅在共享连接窗口等于或低于 <code>Wmax</code> 时有效。<code>h2c-&gt;send_window</code> 的无符号类型为 <code>size_t</code>，而上一步已将其改为 <code>Wmax + Q</code>。因此，剩余容量表达式的值为 <code>Wmax - (Wmax + Q)</code>；如果按有符号值解释，它将为负数，但无符号算术会将其回绕为一个非常大的正值。</p><p>nginx 将此值视为可用容量，并继续接受 h2c 的连接级 <code>WINDOW_UPDATE</code> 帧。每次增量仍符合 HTTP/2 规范，但该检查未能检测到当前窗口已经超出有效范围。重复此过程可以将发送窗口提高到任意 64 位值。</p><h4 id=\"sec-38\"><strong>(3) 从超大窗口到越界复制</strong></h4><p><code>h2c-&gt;send_window</code> 的无符号类型为 <code>size_t</code>。在 64 位目标平台上，将其增大到比如 <code>2^64 - d</code> 后，按无符号值看会显得非常大，但转换为有符号类型 <code>off_t</code> 后会得到一个较小的负值 <code>-d</code>。</p><p><code>ngx_http_v2_send_chain()</code> 将此值移入 DATA 帧大小。它首先将发送窗口与 <code>limit</code> 比较，后者即当前调用可以发送的最大数量。</p><pre><code>// https://github.com/nginx/nginx/blob/140aa942711868a8daeb95810bc9a81f272ada72/src/http/v2/ngx_http_v2_filter_module.c#L1144-L1146\n<span>if</span> (<span>limit</span> == 0 || <span>limit</span> &gt; (off_t) h2c-&gt;send_window) {\n    <span>limit</span> = h2c-&gt;send_window;\n}</code></pre><p>正数 <code>limit</code> 大于 <code>-d</code>，因此条件成立，<code>limit</code> 也会变为 <code>-d</code>。</p><p>下一次比较使用 <code>frame_size</code>（当前 DATA 帧大小）和 <code>limit</code>。</p><pre><code>/<span>/ https:/</span><span>/github.com/nginx</span><span>/nginx/blob</span><span>/140aa942711868a8daeb95810bc9a81f272ada72/src</span><span>/http/v</span>2/ngx_http_v2_filter_module.c<span>#L1163-L1166</span>\n<span>if</span> ((off_t) frame_size &gt; limit) {\n    frame_size = (size_t) limit;\n}</code></pre><p>正数 <code>frame_size</code> 大于 <code>-d</code>，因此此条件也成立。将 <code>-d</code> 转换回 <code>size_t</code> 会得到 <code>2^64 - d</code>，用一个非常大的值取代正常的 DATA 大小。</p><p>nginx 将该值存储在 <code>rest</code> 中，该字段跟踪尚未附加到缓冲区的长度。随后，它将此值传递给 <code>ngx_http_v2_filter_get_shadow()</code>，以设置缓冲区的起始和结束指针。</p><pre><code>/<span>/ Call site: https:/</span><span>/github.com/nginx</span><span>/nginx/blob</span><span>/140aa942711868a8daeb95810bc9a81f272ada72/src</span><span>/http/v</span>2/ngx_http_v2_filter_module.c<span>#L1169-L1207</span>\n/<span>/ Implementation: https:/</span><span>/github.com/nginx</span><span>/nginx/blob</span><span>/140aa942711868a8daeb95810bc9a81f272ada72/src</span><span>/http/v</span>2/ngx_http_v2_filter_module.c<span>#L1287-L1308</span>\nrest = frame_size;\ncl = ngx_http_v2_filter_get_shadow(stream, <span>in</span>-&gt;buf, offset, rest);\nstatic ngx_chain_t *\nngx_http_v2_filter_get_shadow(ngx_http_v2_stream_t *stream, ngx_buf_t *buf,\n    off_t offset, off_t size)\n{\n    chunk-&gt;last = chunk-&gt;pos + size;\n}</code></pre><p>作为 <code>off_t</code>，<code>size</code> 保存 <code>-d</code>，因此 <code>chunk-&gt;last</code> 指向 <code>chunk-&gt;pos</code> 之前 <code>d</code> 个字节的位置。TLS 输出路径随后会将这两个指针之间的差值用作复制长度。</p><pre><code>/<span>/ Declaration: https:/</span><span>/github.com/nginx</span><span>/nginx/blob</span><span>/140aa942711868a8daeb95810bc9a81f272ada72/src</span><span>/event/ngx</span>_event_openssl.c<span>#L3054-L3057</span>\n/<span>/ Copy path: https:/</span><span>/github.com/nginx</span><span>/nginx/blob</span><span>/140aa942711868a8daeb95810bc9a81f272ada72/src</span><span>/event/ngx</span>_event_openssl.c<span>#L3137-L3150</span>\nssize_t size;\nsize = <span>in</span>-&gt;buf-&gt;last - <span>in</span>-&gt;buf-&gt;pos;\nngx_memcpy(buf-&gt;last, <span>in</span>-&gt;buf-&gt;pos, size);</code></pre><p><code>last - pos</code> 是 <code>-d</code>，但传给 <code>memcpy()</code> 的长度参数是 <code>size_t</code>。最终转换会将其变回 <code>2^64 - d</code>，同时传入一个非常大的复制长度。</p><p>复制将近 <code>2^64</code> 字节通常会越过堆末尾并使 worker 崩溃。但在这里不会，这是因为 glibc 对大型复制的处理方式。我们实验所用的 x86-64 glibc <code>memcpy()</code> 路径不会从前向后复制。它先加载源地址的起始位置和结束位置，然后通过一个循环复制中间部分，该循环从目标地址末尾向后遍历至 <code>dest</code>。</p><p>目标地址的末尾是 <code>dest + size</code>。加上 <code>size = 2^64 - d</code> 后，该求和会溢出 64 位地址空间并回绕至 <code>dest - d</code>，后者比 <code>dest</code> 低 <code>d</code> 字节。由于现在末尾位于起始位置下方，向后循环执行一轮后便停止，因此大块中间区域从未被触及。这种每次移动四个 32 字节向量的向后复制结构，自 2016 年发布的 2.24 版本起就已存在于 glibc 的 x86-64 实现中。</p><p>下面展示的是 glibc 2.41 AVX2 路径的简化版本。</p><pre><code># Introduced in: https:<span>//github.com/bminor/glibc/blob/glibc-2.24/sysdeps/x86_64/multiarch/memmove-vec-unaligned-erms.S#L413-L462</span>\n<span># https:<span>//github.com/bminor/glibc/blob/glibc-2.41/sysdeps/x86_64/multiarch/memmove-vec-unaligned-erms.S#L513-L554</span></span>\nhead = <span>load128</span>(src)\ntail = <span>load32</span>(src + size - <span>32</span>)\nend = (dest + size) mod <span>2</span>^<span>64</span>\ncursor = <span>align_down</span>(end - <span>129</span>, <span>32</span>)\n<span>do</span> {\n    <span>copy128</span>(dst=cursor, src=src + (cursor - dest))\n    cursor -= <span>128</span>\n} <span>while</span> (cursor &gt; dest)\n<span>store128</span>(dst=dest, data=head)\n<span>store32</span>(dst=end - <span>32</span>, data=tail)</code></pre><p><code>align_down(x, 32)</code> 将 <code>x</code> 向下取整至 32 字节边界。当 <code>end</code> 按 32 字节对齐时，如下方示例所示，<code>cursor = align_down(end - 129, 32)</code> 会变为 <code>end - 160</code>。glibc 从此位置复制 128 字节，并单独复制最后 32 字节。</p><pre><code><span>end</span> <span>-</span> <span>160</span>                         <span>end</span> <span>-</span> <span>32</span>             <span>end</span>\n    <span>|</span><span>---------- 128 bytes ----------|------ 32 bytes -----|</span>\n              loop <span>copy</span>                    fixed <span>copy</span></code></pre><p>由于 <code>cursor</code> 已经低于 <code>dest</code>，循环仅运行一次。长中间区域被跳过，仅需复制最前面的 128 字节和最后的 160 字节。</p><pre><code><span>src</span> ~ <span>src</span> + <span>127</span>                    -&gt; dest ~ dest + <span>127</span>\n<span>src</span> - d - <span>160</span> ~ <span>src</span> - d - <span>1</span>       -&gt; dest - d - <span>160</span> ~ dest - d - <span>1</span></code></pre><p><code>dest</code> 是 TLS 明文缓冲区中的下一个写入位置，因此它恰好位于 nginx 已写入内容之后。在响应正文之前，nginx 会写入客户端控制帧的确认响应，而客户端可以控制发送多少个此类帧。在 nginx 源码中，HTTP/2 帧头为 9 字节，PING 数据为 8 字节，SETTINGS ACK 数据为 0 字节。</p><pre><code>/<span>/ https:/</span><span>/github.com/nginx</span><span>/nginx/blob</span><span>/140aa942711868a8daeb95810bc9a81f272ada72/src</span><span>/http/v</span>2/ngx_http_v2.h<span>#L27</span>\n<span>#define NGX_HTTP_V2_FRAME_HEADER_SIZE    9</span>\n/<span>/ https:/</span><span>/github.com/nginx</span><span>/nginx/blob</span><span>/140aa942711868a8daeb95810bc9a81f272ada72/src</span><span>/http/v</span>2/ngx_http_v2.c<span>#L30-L34</span>\n<span>#define NGX_HTTP_V2_SETTINGS_ACK_SIZE    0</span>\n<span>#define NGX_HTTP_V2_PING_SIZE            8</span></code></pre><p>因此，不带 ACK 标志的 PING 会产生 17 字节的 PING ACK，而 SETTINGS 会产生 9 字节的 SETTINGS ACK。如果客户端发送 <code>p</code> 个 PING 帧和 <code>s</code> 个 SETTINGS 帧，nginx 首先生成 <code>17p + 9s</code> 字节的响应。加上随后 9 字节的 DATA 帧头，便得到了下一个响应正文的起始位置。</p><pre><code><span>P</span> = <span>17</span>p + <span>9</span>s + <span>9</span>\n<span>dest</span> = TLS + P</code></pre><p>客户端使用 <code>WINDOW_UPDATE</code> 调整发送窗口，使其变为 <code>d = P - 64</code>。此时复制末尾 <code>dest - d</code> 变为 <code>TLS + 64</code>。160 字节区域随后横跨 TLS 缓冲区正前方的 96 字节，以及该缓冲区内部最前面的 64 字节。</p><p>第二次移动会将 <code>src - d</code> 正下方的 160 字节复制到 TLS 缓冲区的边缘。攻击者希望这些字节中包含两项内容：一个用于覆盖 TLS 缓冲区之前堆元数据的选定值，以及位于缓冲区内部并在响应中回传的指针。请求池中同时具备这两者。它保存请求的标头，以及描述这些标头并指向 nginx 映像和堆的 nginx 数据结构。为了将 <code>src</code> 移到那里，攻击者发送一个请求多个字节范围的 Range 标头。nginx 随后构建一个 multipart 响应，其开头是一个在请求池中分配的边界字符串，因此 <code>src</code> 指向该处。</p><pre><code>// https:<span>//gi</span>thub.com/nginx/nginx/blob/140aa942711868a8daeb95810bc9a81f272ada72/src/http/modules/ngx_http_range_filter_module.c<span>#L484-L505</span>\nctx-&gt;boundary_header.data = ngx_pnalloc(r-&gt;pool, size);\n<span>//</span> https:<span>//gi</span>thub.com/nginx/nginx/blob/140aa942711868a8daeb95810bc9a81f272ada72/src/http/modules/ngx_http_range_filter_module.c<span>#L867-L882</span>\nb-&gt;<span>pos</span> = ctx-&gt;boundary_header.data;</code></pre><p><code>b-&gt;pos</code> 在经过输出路径时变为 <code>in-&gt;buf-&gt;pos</code>，因此它就是最终 <code>memcpy()</code> 所使用的 <code>src</code>。</p><p>借助请求池中的 <code>src</code>，攻击者使用 <code>Cookie</code> 字段填充 <code>src - d</code> 下方的 160 字节。当同一请求包含多个 <code>Cookie</code> 字段时，nginx 会为每个分隔符增加两个字节以计算总长度，然后使用 <code>\"; \"</code> 连接这些值。它将长度和合并后缓冲区的地址存储在请求标头结构中。</p><pre><code>/<span>/ https:/</span><span>/github.com/nginx</span><span>/nginx/blob</span><span>/140aa942711868a8daeb95810bc9a81f272ada72/src</span><span>/http/v</span>2/ngx_http_v2.c<span>#L3725-L3769</span>\nlen += vals[i].len + <span>2</span>;\nlen -= <span>2</span>;\nh-&gt;key.data = cookie.data;\nh-&gt;value.len = len;\nh-&gt;value.data = buf;</code></pre><p><code>h-&gt;key.data</code>指向nginx映像中的一个静态字符串，而<code>h-&gt;value.data</code>指向堆上的Cookie缓冲区。因此，该结构包含一个由攻击者控制的长度，以及指向nginx映像和堆的指针。</p><p>如果当前请求池块有足够的空间，nginx会将新的小分配紧接在上一个分配之后放置。</p><pre><code>/<span>/ https:/</span><span>/github.com/nginx</span><span>/nginx/blob</span><span>/140aa942711868a8daeb95810bc9a81f272ada72/src</span><span>/core/ngx</span>_palloc.c<span>#L157-L166</span>\nm = p-&gt;d.last;\n<span>if</span> ((size_t) (p-&gt;d.<span>end</span> - m) &gt;= size) {\n    p-&gt;d.last = m + size;\n    <span>return</span> m;\n}</code></pre><p>Cookie数量和长度控制数据及其位置，而Range和URI长度则确定用作<code>src</code>的multipart缓冲区的位置。这允许将紧邻<code>src - d</code>之前的160字节布置如下。</p><pre><code>Source:      [<span>96</span> <span>bytes</span> containing the value <span>for</span> the size field][<span>64</span> <span>bytes</span> of code <span>and</span> heap pointers]\nDestination: [<span>96</span> <span>bytes</span> before the TLS buffer, containing heap metadata][first <span>64</span> <span>bytes</span> of the TLS plaintext buffer]</code></pre><p>前96字节会覆盖TLS明文缓冲区之前堆区域中的size字段。剩余的64字节会在TLS响应中发送，从而泄露nginx映像地址和堆地址。因此，一次格式错误的复制同时造成越界写入和地址泄露。这些漏洞可用于覆盖清理函数指针，并以nginx工作进程权限执行命令。我们省略了详细的函数指针覆写过程。</p><h4 id=\"sec-39\"><strong>5.1.3. 可利用性验证</strong></h4><p>仅使用一个可从外部访问的TLS/HTTP/2端口，我们演示了未经验证的远程代码执行。该漏洞利用破坏了发送窗口、泄露了nginx映像地址和堆地址，并控制了清理函数，以nginx工作进程权限执行命令。</p><h4 id=\"sec-40\"><strong>验证结果</strong></h4><p>Xint研究团队确认，我们的漏洞利用在并发正常流量下以及硬件规格不同的服务器上均有效。在AWS、GCP和Azure上，我们分别在目标服务器内部、通过发送方和目标主机相互隔离的专用网络，以及通过公共HTTPS端点验证了该漏洞利用。</p><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p>云</p></th><th colspan=\"1\" rowspan=\"1\"><p>目标服务器内部</p></th><th colspan=\"1\" rowspan=\"1\"><p>专用网络、VPC或VNet</p></th><th colspan=\"1\" rowspan=\"1\"><p>公共IP</p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>AWS</p></td><td colspan=\"1\" rowspan=\"1\"><p>成功</p></td><td colspan=\"1\" rowspan=\"1\"><p>成功</p></td><td colspan=\"1\" rowspan=\"1\"><p>成功</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>GCP</p></td><td colspan=\"1\" rowspan=\"1\"><p>成功</p></td><td colspan=\"1\" rowspan=\"1\"><p>成功</p></td><td colspan=\"1\" rowspan=\"1\"><p>成功</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>Azure</p></td><td colspan=\"1\" rowspan=\"1\"><p>成功</p></td><td colspan=\"1\" rowspan=\"1\"><p>成功</p></td><td colspan=\"1\" rowspan=\"1\"><p>成功</p></td></tr></tbody></table><h3 id=\"sec-41\"><strong>5.2. CVE-2026-123634</strong></h3><p>CVE-2026-123634是nginx DNS解析器逻辑中的一个释放后重用漏洞。请求的处理程序可以释放等待列表循环尚未处理的另一个解析器上下文，而该循环随后继续使用已释放的内存。</p><h4 id=\"sec-42\"><strong>5.2.1. nginx在请求时如何解析上游名称</strong></h4><p>nginx可以充当地反向代理，将客户端请求转发到后端服务器（称为<em>上游</em>）进行处理。<code>proxy_pass</code>配置指令指定上游的位置。</p><p>上游可以在配置中固定，也可以从请求中选择。例如，<code>proxy_pass http://$host;</code>使用<code>$host</code>中的请求主机名作为目标地址。该值通常来自客户端的<code>Host</code>标头。如果nginx需要通过DNS查询获取服务器的IP地址，它会向<code>resolver</code>指令指定的DNS服务器发起查询。</p><p>由于DNS解析需要时间，nginx在等待DNS应答期间会继续处理其他请求。每次查询都有一个解析器上下文（<code>ngx_resolver_ctx_t</code>），用于保存其状态、结果，以及查询完成后要调用的<code>handler</code>。</p><p>解析器在一个节点中跟踪每个域名。如果同一名称的查询已在进行中，nginx不会发送第二次查询，而是倾向于将新上下文推入该节点等待列表的头部。</p><p>当应答最终到达时，解析器通过将<code>rn-&gt;waiting</code>设置为<code>NULL</code>，将等待列表从节点中分离出来。然后，它遍历该列表并调用每个上下文的<code>handler</code>，在每次调用前将下一个上下文保存到<code>next</code>中。</p><pre><code>/<span>/ https:/</span><span>/github.com/nginx</span><span>/nginx/blob</span><span>/140aa942711868a8daeb95810bc9a81f272ada72/src</span><span>/core/ngx</span>_resolver.c<span>#L2131-L2147</span>\n<span>next</span> = rn-&gt;waiting;\nrn-&gt;waiting = <span>NULL</span>;\n...\n<span>while</span> (<span>next</span>) {\n    ctx = <span>next</span>;\n    ctx-&gt;state = code;\n    ctx-&gt;valid = ngx_time() + (r-&gt;valid ? r-&gt;valid : <span>10</span>);\n    <span>next</span> = ctx-&gt;<span>next</span>;\n    ctx-&gt;handler(ctx);\n}</code></pre><p>因此，释放列表中较后上下文的处理程序会使 <code>next</code> 变成悬空指针。不过，不同的请求不会导致此问题，因为终止一个请求只会释放它自己的上下文。因此，只有当两个上下文来自同一请求时，这才构成漏洞。</p><p>在我们的测试中，只发现一个配置选项会创建两个附加到同一请求的上下文。<code>mirror</code> 配置指令会将请求复制到第二个位置，作为后台子请求。它通常用于将实时流量的副本发送到测试系统。如果主请求及其镜像使用相同的上游名称，它们的上下文可能会在同一节点上等待 DNS 应答。</p><h4 id=\"sec-43\"><strong>5.2.2. 漏洞详情</strong></h4><p><strong>(1) 终止主请求会释放镜像的上下文</strong></p><p>如果 DNS 查找失败，主请求的 <code>ngx_http_upstream_resolve_handler()</code> 会尝试发送 502 响应。如果客户端已重置 TCP 连接，该写入操作可能会失败，导致 <code>ngx_http_terminate_request()</code> 终止主请求。</p><p>主请求的 <code>cleanup</code> 列表包含镜像的上游清理项，因此以下清理代码也会为镜像运行，即使其 DNS 结果尚未被处理。</p><pre><code><span>// https://github.com/nginx/nginx/blob/140aa942711868a8daeb95810bc9a81f272ada72/src/http/ngx_http_upstream.c#L4802-L4805</span>\n<span>if</span> (u<span>-&gt;</span>resolved &amp;&amp; u<span>-&gt;</span>resolved<span>-&gt;</span>ctx) {\n    <span>ngx_resolve_name_done</span>(u<span>-&gt;</span>resolved<span>-&gt;</span>ctx);\n    u<span>-&gt;</span>resolved<span>-&gt;</span>ctx = NULL;\n}</code></pre><p>随后，<code>ngx_resolve_name_done()</code> 释放镜像的上下文，而解析器循环仍在 <code>next</code> 中持有该上下文。</p><p><strong>(2) 解析器使用已释放的上下文</strong></p><p>在解析器循环到达镜像上下文之前，该上下文仍处于状态 <code>NGX_AGAIN</code>。在释放处于此状态的上下文之前，<code>ngx_resolve_name_done()</code> 会尝试将其从节点的等待列表中取消链接。但循环已经分离该列表并将 <code>rn-&gt;waiting</code> 设置为 <code>NULL</code>。搜索找不到任何内容，而上下文仍然被释放。</p><pre><code><span>// https://github.com/nginx/nginx/blob/140aa942711868a8daeb95810bc9a81f272ada72/src/core/ngx_resolver.c#L554-L595</span>\n<span>if</span> (ctx<span>-&gt;</span>state == NGX_AGAIN || ctx<span>-&gt;</span>state == NGX_RESOLVE_TIMEDOUT) {\n    rn = ctx<span>-&gt;</span>node;\n    <span>if</span> (rn) {\n        p = &amp;rn<span>-&gt;</span>waiting;\n        w = rn<span>-&gt;</span>waiting;\n        <span>while</span> (w) {\n            ...\n        }\n        <span>ngx_log_error</span>(NGX_LOG_ALERT, r<span>-&gt;</span>log, <span>0</span>,\n                      <span>\"could not cancel %V resolving\"</span>, &amp;ctx<span>-&gt;</span>name);\n    }\n}\ndone:\n    ...\n    <span>ngx_resolver_free_locked</span>(r, ctx);</code></pre><p>随后控制权返回解析器循环，该循环前进到保存在 <code>next</code> 中的上下文，即镜像的已释放上下文。循环现在通过写入 <code>ctx-&gt;state</code> 和 <code>ctx-&gt;valid</code>、读取 <code>ctx-&gt;next</code> 并调用 <code>ctx-&gt;handler(ctx)</code> 来触发释放后使用。如果另一次分配重新占用了已释放上下文的内存，则 <code>next</code> 和 <code>handler</code> 都可由攻击者控制。因此，攻击者可以重定向列表遍历和最终的间接调用，从而控制程序执行。</p><p>要执行任意代码，我们首先需要获取一个地址泄露。有趣的是，这个漏洞本身就可用于泄露信息。glibc 的空闲链表指针会覆盖上下文的 next 字段，因此循环的 <code>next</code>“上下文”是一个已释放的 DNS 记录数组，其内容由我们选择。随后我们采用一种技巧：将受控处理程序指向 <code>vsyscall</code> <code>gettimeofday()</code> 地址（在 amd64 系统上是固定的），伪造堆块大小，并将 glibc 和堆指针放入 nginx 向我们控制的服务器发送的 DNS 查询中。</p><p>在完成信息泄露后，我们可以让循环通过该数组指向待处理请求体中的伪造 <code>context</code>，并将其处理程序设置为 <code>system()</code>，从而在主机上获得任意命令执行能力。</p><h4 id=\"sec-44\"><strong>5.2.3. 可利用性验证</strong></h4><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p>项目</p></th><th colspan=\"1\" rowspan=\"1\"><p>结果</p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>目标</p></td><td colspan=\"1\" rowspan=\"1\"><p>官方 <code>nginx:1.31.8</code> 镜像，其中服务器块使用请求时 DNS 解析，并将 <code>mirror</code> 添加到默认配置中</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>入口点</p></td><td colspan=\"1\" rowspan=\"1\"><p>8080 端口上的 HTTP，以及针对攻击者区域的 DNS 应答</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>身份验证</p></td><td colspan=\"1\" rowspan=\"1\"><p>无</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>网络要求</p></td><td colspan=\"1\" rowspan=\"1\"><p>nginx 的递归解析器必须能够到达攻击者的权威 DNS 服务器</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>主机内核</p></td><td colspan=\"1\" rowspan=\"1\"><p>Ubuntu Linux 6.8 (x86-64)，并搭配 <code>vsyscall=xonly</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>结果</p></td><td colspan=\"1\" rowspan=\"1\"><p>以 nginx 工作进程权限实现远程代码执行</p></td></tr></tbody></table><h3 id=\"sec-45\"><strong>5.3. CVE-2026-123633</strong></h3><p>CVE-2026-123633 是一处释放后重用漏洞，源于仍符合条件的活动 HTTP/2 连接保留在可排空状态。当请求打开上游连接时，nginx 可能关闭该请求自身的 HTTP/2 连接并释放其内存，而上游代码仍在继续访问它。此漏洞要求 nginx 打开上游连接，这在 nginx 的<u>生产</u>环境中很常见。</p><h4 id=\"sec-46\"><strong>5.3.1. nginx 在压力下如何重用连接</strong></h4><p>每个 nginx worker 都有固定数量的连接槽位，由 <code>worker_connections</code> 设置。客户端连接和上游连接共用这些槽位。当槽位即将耗尽时，nginx 会关闭空闲连接，以回收槽位供其他用途使用。为了跟踪哪些连接可以被回收，nginx 会在连接满足某些特定于协议的条件时将其标记为 <code>reusable</code>，例如空闲的 HTTP/1.1 keep-alive 连接或没有活动流的 HTTP/2 连接。这些 <code>reusable</code> 连接会被跟踪在一个专用队列中。</p><p>在分配槽位之前，<code>ngx_get_connection()</code> 会调用 <code>ngx_drain_connections()</code>。如果空闲槽位不超过 1/16，且可重用队列非空，nginx 会从最旧的条目开始关闭连接，这一过程称为“排空”。</p><p>排空过程会设置 <code>c-&gt;close</code>，并直接调用每个选定连接的读取处理程序。这些调用是同步的，只有在处理程序返回后，才会继续分配槽位。</p><pre><code><span>// https://github.com/nginx/nginx/blob/140aa942711868a8daeb95810bc9a81f272ada72/src/core/ngx_connection.c#L1411-L1442</span>\n<span>if</span> (cycle<span>-&gt;</span>free_connection_n &gt; cycle<span>-&gt;</span>connection_n / <span>16</span>\n    || cycle<span>-&gt;</span>reusable_connections_n == <span>0</span>)\n{\n    <span>return</span>;\n}\n...\nn = <span>ngx_max</span>(<span>ngx_min</span>(<span>32</span>, cycle<span>-&gt;</span>reusable_connections_n / <span>8</span>), <span>1</span>);\n<span>for</span> (i = <span>0</span>; i &lt; n; i++) {\n    ...\n    q = <span>ngx_queue_last</span>(&amp;cycle<span>-&gt;</span>reusable_connections_queue);\n    c = <span>ngx_queue_data</span>(q, ngx_connection_t, queue);\n    ...\n    c<span>-&gt;</span>close = <span>1</span>;\n    c<span>-&gt;</span>read<span>-&gt;</span><span>handler</span>(c<span>-&gt;</span>read);\n}</code></pre><h4 id=\"sec-47\"><strong>5.3.2. 漏洞详情</strong></h4><p><strong>(1) 活动 HTTP/2 连接仍留在可重用队列中</strong></p><p>当 HTTP/2 连接没有活动流或待发送的输出帧时，<code>ngx_http_v2_handle_connection()</code> 会将其作为可重用连接加入队列。如果最后一次读取停止在某个帧的中间，<code>h2c-&gt;state.incomplete</code> 会被设置，但该标志仅在连接加入队列之后才会被检查：</p><pre><code>/<span>/ https:/</span><span>/github.com/nginx</span><span>/nginx/blob</span><span>/140aa942711868a8daeb95810bc9a81f272ada72/src</span><span>/http/v</span>2/ngx_http_v2.c<span>#L628-L674</span>\n<span>if</span> (h2c-&gt;last_out |<span></span>| h2c-&gt;processing) {\n    <span>return</span>;\n}\n...\nngx_reusable_connection(c, <span>1</span>);\n<span>if</span> (h2c-&gt;state.incomplete) {\n    <span>return</span>;\n}</code></pre><p>通常，空闲连接的读取处理程序会被更新为 <code>ngx_http_v2_idle_handler()</code>，从而在数据到达时将其移出队列。然而，当 <code>ngx_http_v2_handle_connection</code> 因帧不完整而提前返回时，连接仍保留正常的 <code>ngx_http_v2_read_handler()</code>，而它永远不会将连接移出可重用队列。</p><p>因此，该缺陷的触发方式如下：</p><ol><li><p>客户端发送 HEADERS 帧的第一部分，使连接进入可重用队列。</p></li><li><p>随后客户端发送剩余部分，从而打开一个流。</p></li><li><p>如果该请求打开上游连接并触发排空，排空过程可能会回收新打开的流所使用的连接。</p></li></ol><h4 id=\"sec-48\"><strong>(2) 上游连接释放了其自身请求</strong></h4><p>为了连接到上游，请求需要另一个连接槽位。<code>ngx_event_connect_peer()</code> 调用 <code>ngx_get_connection()</code>，在槽位不足时运行排空过程。此时，留在可重用队列中的 HTTP/2 连接可能会被选中关闭。</p><p>HTTP/2 读取处理程序看到 <code>c-&gt;close</code> 后会尝试发送 <code>GOAWAY</code>，但如果客户端已经重置了 TCP 连接，发送就会失败，随后 <code>ngx_http_v2_finalize_connection()</code> 会关闭该连接及其流。</p><pre><code>/<span>/ https:/</span><span>/github.com/nginx</span><span>/nginx/blob</span><span>/140aa942711868a8daeb95810bc9a81f272ada72/src</span><span>/http/v</span>2/ngx_http_v2.c<span>#L356-L382</span>\n<span>if</span> (c-&gt;close) {\n    c-&gt;close = <span>0</span>;\n    ...\n    <span>if</span> (!h2c-&gt;goaway) {\n        h2c-&gt;goaway = <span>1</span>;\n        <span>if</span> (ngx_http_v2_send_goaway(h2c, <span>NGX_HTTP_V2_NO_ERROR</span>)\n            == <span>NGX_ERROR</span>)\n        {\n            ngx_http_v2_finalize_connection(h2c, <span>0</span>);\n            <span>return</span>;\n        }\n        <span>if</span> (ngx_http_v2_send_output_queue(h2c) == <span>NGX_ERROR</span>) {\n            ngx_http_v2_finalize_connection(h2c, <span>0</span>);\n            <span>return</span>;\n        }\n    }</code></pre><p>关闭该流会调用 <code>ngx_http_free_request()</code>，从而销毁包含请求 <code>r</code> 及其上游结构 <code>u</code> 的请求池。</p><pre><code><span>// https://github.com/nginx/nginx/blob/140aa942711868a8daeb95810bc9a81f272ada72/src/http/ngx_http_request.c#L4062-L4071</span>\n<span>/*\n * Setting r-&gt;pool to NULL will increase probability to catch double close\n * of request since the request object is allocated from its own pool.\n */</span>\npool = r<span>-&gt;</span>pool;\nr<span>-&gt;</span>pool = NULL;\n<span>ngx_destroy_pool</span>(pool);</code></pre><p>排空过程返回后，nginx 会继续运行已被释放请求的上游代码。它会连接到上游、发送代理请求，并处理该连接上的事件，而这一切都通过已释放的 <code>r</code> 和 <code>u</code> 进行。</p><p>利用某些堆布局整理技术，我们可以让一个 glibc largebin 头部恰好位于 <code>u</code> 上方，并让该头部的 <code>bk_nextsize</code> 字段位于 <code>u-&gt;peer.sockaddr</code> 上。此时，它会指向我们控制的字节（对于我们自己的服务器而言是一个 <code>sockaddr_in</code>），导致上游连接实际连接到我们自己的服务器。</p><p>为了绕过 ASLR，我们只需接受连接，随后 nginx 会发送已释放的请求缓冲区，而该缓冲区此时包含各种指针值。worker 随后崩溃，但其替代 worker 具有相同的地址布局。</p><p>为了执行命令，我们使用另一种堆整理技术，回收已释放的请求，并将其替换为一个伪造请求，其上游读取处理程序为 <code>execv()</code>。当我们拒绝连接时，epoll 会报告错误，随后 nginx 会调用该处理程序。</p><h4 id=\"sec-49\"><strong>5.3.3. 可利用性验证</strong></h4><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p>项目</p></th><th colspan=\"1\" rowspan=\"1\"><p>结果</p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>目标</p></td><td colspan=\"1\" rowspan=\"1\"><p>官方 <code>nginx:1.31.8</code> 镜像，使用一个 TLS/HTTP/2 服务器，并向原生 <code>nginx.conf</code> 中添加 <code>proxy_pass</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>入口点</p></td><td colspan=\"1\" rowspan=\"1\"><p>一个使用 ALPN <code>h2</code> 的 TLS 端口，以及一个用于占用连接槽位的 HTTP/1 端口</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>身份验证</p></td><td colspan=\"1\" rowspan=\"1\"><p>无</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>网络要求</p></td><td colspan=\"1\" rowspan=\"1\"><p>nginx 可以向攻击者打开 TCP 连接</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>结果</p></td><td colspan=\"1\" rowspan=\"1\"><p>以 nginx worker 权限实现远程代码执行</p></td></tr></tbody></table><h3 id=\"sec-50\"><strong>5.4. CVE-2026-121810</strong></h3><p>CVE-2026-121810 是一个释放后重用漏洞，其成因是在某个 HTTP/3 请求仍在运行时关闭 QUIC 连接。在流创建期间，父 QUIC 连接被错误地设为可进入排空状态。随后，该请求连接上游时，便会释放其自身的请求内存。</p><p>该漏洞与 CVE-2026-123633 类似，但触发机制略有不同，因此我们的文章将省略之前已经介绍过的一些定义和背景信息。因此，我们建议在阅读本节前先阅读第 5.3 节。</p><h4 id=\"sec-51\"><strong>5.4.1. nginx 如何将 HTTP/3 流作为连接处理</strong></h4><p>HTTP/3 通过一个 QUIC 连接承载多个请求流，但 nginx 在内部会为该 QUIC 连接分配一个 <code>ngx_connection_t</code>，并为每个流额外分配一个。所有这些对象都来自同一 worker 的连接槽位，因此创建请求流也需要一个空闲槽位。我们将这些流所属的 QUIC 连接称为父连接。QUIC 连接和等待标头的 HTTP/3 请求流都可能进入可排空状态。</p><p>当单个流关闭时，nginx 会检查父连接是否也可以被排空。<code>ngx_quic_can_shutdown()</code> 遍历父连接的流树，如果所有剩余流都可取消，nginx 便会将父连接放入可重用队列。</p><pre><code>// https://github.com/nginx/nginx/blob/140aa942711868a8daeb95810bc9a81f272ada72/src/event/quic/ngx_event_quic_streams.c#L1168-L1170\n<span>if</span> (!pc-&gt;reusable &amp;&amp; ngx_quic_can_shutdown(pc) == NGX_OK) {\n    ngx_reusable_connection(pc, 1);\n}</code></pre><h4 id=\"sec-52\"><strong>5.4.2. 漏洞详情</strong></h4><p><strong>(1) 在流创建期间重新将 QUIC 连接入队</strong></p><p>在为新流分配连接槽位之前，<code>ngx_quic_create_stream()</code> 会将父连接从可重用队列中取出，其目的是防止 <code>ngx_get_connection()</code> 在分配槽位期间排空父连接。</p><pre><code><span>/</span><span>/</span> https<span>:</span><span>/</span><span>/</span>github.com<span>/</span>nginx<span>/</span>nginx<span>/</span>blob<span>/</span><span>140</span>aa942711868a8daeb95810bc9a81f272ada72<span>/</span>src<span>/</span>event<span>/</span>quic<span>/</span>ngx_event_quic_streams.c<span>#L734-L743</span>\nreusable <span>=</span> <span>c</span><span>-&gt;</span>reusable;\nngx_reusable_connection<span>(</span><span>c</span><span>,</span> <span>0</span><span>)</span>;\nsc <span>=</span> ngx_get_connection<span>(</span><span>c</span><span>-&gt;</span>fd<span>,</span> <span>log</span><span>)</span>;\n<span>if</span> <span>(</span>sc <span>==</span> <span>NULL</span><span>)</span> <span>{</span>\n    ngx_destroy_pool<span>(</span>pool<span>)</span>;\n    ngx_queue_insert_tail<span>(</span><span>&amp;</span>qc<span>-&gt;</span>streams.free<span>,</span> <span>&amp;</span>qs<span>-&gt;</span>queue<span>)</span>;\n    ngx_reusable_connection<span>(</span><span>c</span><span>,</span> reusable<span>)</span>;\n    <span>return</span> <span>NULL</span>;\n<span>}</span></code></pre><p>然而，新流只有在连接槽位分配完成后才会进入父连接的流树。</p><pre><code><span>// https://github.com/nginx/nginx/blob/140aa942711868a8daeb95810bc9a81f272ada72/src/event/quic/ngx_event_quic_streams.c#L814</span>\n<span>ngx_rbtree_insert</span>(&amp;qc<span>-&gt;</span>streams.tree, &amp;qs<span>-&gt;</span>node);</code></pre><p>假设排空操作关闭了同一父连接上的一个现有空闲流。如果该流的两个方向均已完成，它就可能触发决定父连接是否可排空的检查，但该检查无法看到仍在创建的流。如果树中没有其他不可取消的流，nginx 便会将父连接重新放入可重用队列，即使新流之后已创建，它仍会留在该队列中。</p><p><strong>(2) 上游连接释放请求</strong></p><p>当新流的请求连接上游时，它需要另一个槽位，这可能再次触发排空操作，并选中刚刚入队的父 QUIC 连接。<code>ngx_quic_close_connection()</code> 调用 <code>ngx_quic_close_streams()</code> 来关闭父连接的各个流，从而终止上游连接仍在进行中的请求。</p><p><code>ngx_http_free_request()</code> 销毁请求池，其中包括上游结构 <code>u</code>。随后控制流返回 <code>ngx_event_connect_peer()</code>，后者继续使用已释放的 <code>u-&gt;peer</code>，从而导致释放后重用。</p><p>从这里开始，ASLR 绕过和控制流劫持路径与第 5.3.2 节中的路径相同，因此为简洁起见在此省略。</p><h4 id=\"sec-53\"><strong>5.4.3. 可利用性验证</strong></h4><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p>项目</p></th><th colspan=\"1\" rowspan=\"1\"><p>结果</p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>目标</p></td><td colspan=\"1\" rowspan=\"1\"><p>官方 <code>nginx:1.31.8</code> amd64 镜像，并在原始 <code>nginx.conf</code> 中加入了 HTTP/3 代理服务器</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>入口点</p></td><td colspan=\"1\" rowspan=\"1\"><p>UDP 443（HTTP/3）、TCP 443（HTTP/2）和 TCP 80</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>身份验证</p></td><td colspan=\"1\" rowspan=\"1\"><p>无</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>网络要求</p></td><td colspan=\"1\" rowspan=\"1\"><p>nginx 能够打开到攻击者监听器的 TCP 连接</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>结果</p></td><td colspan=\"1\" rowspan=\"1\"><p>以 nginx 工作进程权限实现远程代码执行</p></td></tr></tbody></table><h3 id=\"sec-54\"><strong>5.5. CVE-2026-113425</strong></h3><p>CVE-2026-113425 是邮件代理的 <code>auth_http</code> 身份验证路径中的释放后重用漏洞。关闭客户端连接会释放其会话，但与身份验证服务的连接仍保持打开。该连接上随后发生的事件会使用已释放的会话。</p><h4 id=\"sec-55\"><strong>5.5.1. 邮件代理如何对客户端进行身份验证</strong></h4><p>nginx 可以在客户端与邮件服务器之间代理 IMAP、POP3 和 SMTP。客户端登录时，nginx 会询问一个通过 <code>auth_http</code> 配置的 HTTP 服务，以确定凭据是否有效以及应使用哪个后端邮件服务器。</p><p>在此查询期间，nginx 会维护两个连接：一个连接客户端，另一个连接 HTTP 身份验证服务；后者称为 auth 连接。</p><p><code>ngx_mail_auth_http_init()</code> 创建一个带有独立内存池的查询上下文。然而，auth 连接的 <code>data</code> 和 <code>pool</code> 字段分别指向客户端会话 <code>s</code> 和客户端连接的内存池。在 auth 连接使用该会话期间，该内存池必须保持已分配状态。</p><pre><code><span>// https://github.com/nginx/nginx/blob/140aa942711868a8daeb95810bc9a81f272ada72/src/mail/ngx_mail_auth_http_module.c#L216-L221</span>\nctx<span>-&gt;</span>peer.connection<span>-&gt;</span>data = s;\nctx<span>-&gt;</span>peer.connection<span>-&gt;</span>pool = s<span>-&gt;</span>connection<span>-&gt;</span>pool;\ns<span>-&gt;</span>connection<span>-&gt;</span>read<span>-&gt;</span>handler = ngx_mail_auth_http_block_read;\nctx<span>-&gt;</span>peer.connection<span>-&gt;</span>read<span>-&gt;</span>handler = ngx_mail_auth_http_read_handler;\nctx<span>-&gt;</span>peer.connection<span>-&gt;</span>write<span>-&gt;</span>handler = ngx_mail_auth_http_write_handler;</code></pre><h4 id=\"sec-56\"><strong>5.5.2. 漏洞详情</strong></h4><p>查询开始时，客户端的读处理程序会被替换为 <code>ngx_mail_auth_http_block_read()</code>。如果重新设置读事件失败，该处理函数会关闭 auth 连接并释放查询池。然而，客户端的写处理程序仍为 <code>ngx_mail_send()</code>，其错误路径不会清理 auth 连接。该缺陷在于，这个写处理程序<em>可以</em>在 auth 连接仍指向客户端连接时关闭客户端连接。</p><h4 id=\"sec-57\"><strong>(1) 查询期间释放客户端会话</strong></h4><p>此路径要求事先注册客户端的写事件。例如，如果客户端停止读取响应并填满套接字的发送缓冲区，send 会返回 <code>EAGAIN</code>。随后 <code>ngx_mail_send()</code> 会注册写事件，以便重试。</p><p>如果登录命令和 TCP 重置在同一轮事件循环迭代中得到处理，nginx 会通过运行当前活动的读处理程序、随后运行写处理程序，来处理 epoll 报告的套接字错误。读处理程序解析登录命令，然后启动身份验证查询，此时 <code>s-&gt;out</code> 中仍有回复处于排队状态。</p><p>随后 <code>ngx_mail_send()</code> 会尝试发送排队的回复。写入在已重置的套接字上失败，因此它会关闭客户端连接并销毁其内存池。</p><pre><code>/<span>/ https:/</span><span>/github.com/nginx</span><span>/nginx/blob</span><span>/140aa942711868a8daeb95810bc9a81f272ada72/src</span><span>/mail/ngx</span>_mail_handler.c<span>#L812-L815</span>\n<span>if</span> (n == <span>NGX_ERROR</span>) {\n    ngx_mail_close_connection(c);\n    <span>return</span>;\n}\n/<span>/ https:/</span><span>/github.com/nginx</span><span>/nginx/blob</span><span>/140aa942711868a8daeb95810bc9a81f272ada72/src</span><span>/mail/ngx</span>_mail_handler.c<span>#L966-L972</span>\nc-&gt;destroyed = <span>1</span>;\npool = c-&gt;pool;\nngx_close_connection(c);\nngx_destroy_pool(pool);</code></pre><p>会话 <code>s</code> 及其模块上下文数组均分配自现已释放的内存池。重要的是，auth 连接仍保持打开，其 <code>data</code> 字段仍指向 <code>s</code>。</p><h4 id=\"sec-58\"><strong>(2) Auth 连接使用已释放的会话</strong></h4><p>下一个事件（例如连接完成、响应或超时）会在 auth 连接上运行处理程序。读处理程序和写处理程序都会从连接的 <code>data</code> 字段获取会话指针，并使用它来获取查询上下文，从而访问已释放会话中的 <code>s-&gt;ctx</code>。如果攻击者控制的数据重新占用了该内存，<code>s-&gt;ctx</code> 就可能指向伪造的上下文。身份验证响应路径随后会调用 <code>ctx-&gt;handler</code>，从而为攻击者提供控制流劫持。</p><p>为了绕过 ASLR，我们利用过期认证连接的超时机制。通过进行一些堆内存整理，超时机制会释放一块内存，而该内存此时保存着来自另一个连接的部分接收到的 IMAP 命令。后续分配操作会重新占用该内存并写入堆指针，当 nginx 回复该 IMAP 命令时，又将这些指针回显给我们。</p><p>为了执行命令，我们在一个全新的 worker 上再次运行触发器。会话被释放后不久，一个带有受控密码的 IMAP <code>LOGIN</code> 会通过伪造会话重新占用该内存。它的 <code>s-&gt;ctx</code> 指向一个伪造的查找上下文，而该上下文的 <code>handler</code> 是 <code>system()</code>。当认证服务回复时，<code>ngx_mail_auth_http_read_handler()</code> 会跟随这个过期会话并调用 <code>system(s)</code>。</p><h4 id=\"sec-59\"><strong>5.5.3. 可利用性验证</strong></h4><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p>项目</p></th><th colspan=\"1\" rowspan=\"1\"><p>结果</p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>目标</p></td><td colspan=\"1\" rowspan=\"1\"><p>官方 <code>nginx:1.31.8</code> 镜像、默认配置，以及包含 IMAP、POP3 和 SMTP 的 <code>mail</code> 块</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>入口点</p></td><td colspan=\"1\" rowspan=\"1\"><p>由同一组 worker 提供服务的 IMAP 143、POP3 110 和 HTTP 80</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>身份认证</p></td><td colspan=\"1\" rowspan=\"1\"><p>无。认证服务拒绝了所有登录。</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>结果</p></td><td colspan=\"1\" rowspan=\"1\"><p>以 nginx worker 权限实现远程代码执行</p></td></tr></tbody></table><h2 id=\"sec-60\"><strong>6. Linux 内核分析</strong><strong>LPE</strong><strong>漏洞分析</strong></h2><p>nginx 漏洞可使攻击者以 worker 权限执行代码。worker 通常在受限权限下运行，因此要完全控制主机，还需要一个权限提升漏洞。我们研究了 Linux 内核，并发现了其 SCTP 子系统中的零日漏洞。将该漏洞与其中一个 nginx 漏洞串联起来，可使我们在主机上获得 root 权限。当 nginx 运行在 Docker 容器中时，这种方法同样有效。</p><p>本节介绍该 SCTP 漏洞的成因以及我们的验证结果。在内核补丁发布之前，我们暂不公开复现或利用该漏洞所需的大部分细节。</p><h3 id=\"sec-61\"><strong>6.1. SCTP 关联的工作方式</strong></h3><p>SCTP（流控制传输协议）是一种传输层协议，与 TCP 和 UDP 类似。</p><p>与 TCP 类似，SCTP 面向连接。它将连接称为 <em>关联</em>。一个关联在每个端点都可以使用多个 IP 地址，因此如果某条路径失败，它可以通过另一条路径继续传输。</p><h3 id=\"sec-62\"><strong>6.2. 漏洞详情</strong></h3><p>该漏洞位于 SCTP 发送路径中。在等待发送操作期间，其关联可以转移到另一个 socket。等待中的操作随后可能释放已转移的关联。根据另一个 socket 的行为，这会导致释放后使用或双重释放。</p><p>在使用 KASAN（内核的内存错误检测器）构建的内核上，双重释放表现为如下形式：</p><pre><code><span>BUG:</span> KASAN: <span>double</span>-free <span>in</span> sctp_[...]\nFree <span>of</span> addr ffff8880021b0880 <span>by</span> task t306/<span>838</span>\n<span>Call</span> Trace:\n kfree+<span>0</span>x170/<span>0</span>x490\n sctp_[...]\n sctp_[...]\n sctp_[...]\nFreed <span>by</span> task <span>836</span>:\n kfree+<span>0</span>x23c/<span>0</span>x490\n sctp_[...]\n sctp_[...]\n sctp_[...]\n sctp_[...]</code></pre><p>该漏洞于 2018 年引入 Linux v4.15，并已在内核中存在超过八年。</p><h3 id=\"sec-63\"><strong>6.3. 可利用性验证</strong></h3><p>释放后使用提供了两种原语：一种可泄露内核内存并绕过内核地址空间布局随机化（KASLR），另一种可在内核中调用任意函数。二者结合，使我们能够控制内核执行并提升权限。在我们的测试中，已经以 nginx worker 权限运行代码的攻击者可以可靠地获得 root 权限。</p><p>我们还在 nginx 运行于 Docker 容器中的环境下，在主机上获取了 root shell。在许多 Linux 发行版中，SCTP 模块默认已安装，并且当某个程序首次打开 SCTP 套接字时，内核会自动加载该模块。某台主机上能否访问 SCTP，仍取决于内核、可用模块以及容器的限制。在可以访问的情况下，攻击者可以接管主机内核。由于主机上的所有容器共享同一个内核，这使攻击者能够控制该主机及其上的每个容器。</p><p><mark>在内核补丁发布之前，不使用 SCTP 的主机可以通过在 </mark><code>install sctp /bin/false</code><mark> 下的 </mark><code>.conf</code><mark> 文件中放置 </mark><code>/etc/modprobe.d/</code><mark> 来阻止模块加载。这只能阻止通过 </mark><code>modprobe</code><mark> 加载模块。它不会卸载已经加载的模块，也不会禁用编译进 </mark><mark>内核</mark><mark> 的 SCTP。</mark></p><p>感谢你读到这里。总结一下：如果你运行 nginx，请在 1.31.9 发布后尽快更新。如果无法立即更新，请应用第 3.3 节所述的缓解措施。它们可以阻止我们已知的攻击路径，但不能替代补丁。在内核修复可用之前，还应按照第 6.3 节的说明，在不需要 SCTP 的主机上阻止加载 SCTP 模块。</p><p>检查服务器是否已打补丁时请务必谨慎。Linux 发行版经常在不对 nginx -v 显示的版本号进行更改的情况下回移植修复。请根据发行版的安全公告检查完整的软件包版本。</p><p>感谢 F5 和 nginx 团队在披露及补丁验证期间给予的合作。我们将在 <a href=\"https://nginx2root.com/\"><u>nginx2root.com</u></a> 发布更新，并解答有关 nginx2root 的常见问题。</p><p>CVE-2026-123007 在 nginx 中潜伏了十多年而未被发现，而 SCTP 漏洞自 2018 年以来一直存在于 Linux 内核中。这两个项目几乎无处不在，并且多年来都接受过安全审查，但这些漏洞仍然一直存在，直到一次完全自动化的 Xint 扫描发现了它们。如果你想看看 Xint 能在自己的代码中发现什么，请联系我们。</p><hr><h2 id=\"sec-64\">关于 Xint</h2><p>Xint（<a href=\"http://xint.io/\"><span>xint.io</span></a>）是一项获奖的自主渗透测试平台，由全球获奖最多的白帽进攻安全研究人员团队打造。Xint 同时提供黑盒和白盒渗透测试，平均可在 24 小时或更短时间内给出结果，包括：完整的触发条件和分步复现路径、漏洞利用影响以及建议的修复措施，使团队能够快速分类处理并修补最关键的漏洞。Xint 正与具有最高防御安全需求的组织合作，包括美国国防高级研究计划局（DARPA）、Microsoft、Google、Okta、Samsung 和 Kia。Xint 是 Anthropic 的 Cyber Verification Program 成员、OpenAI 的 Daybreak 网络安全项目成员，也是 Project Canopy 的创始成员；后者是一项公益倡议，旨在向各类组织传播由 AI 驱动的预防性防御能力，这些组织涵盖亚洲和欧洲的大型企业、民间基础设施以及开源软件。更多信息请访问<a href=\"http://xint.io/\"><span><u>xint.io</u></span></a></p>","original","zhKind","translation","complete","漏洞分析","复现","漏洞利用","利用链","补丁","内核","Ubuntu","Debian","AWS","https://govuln.com/news/url/NBLD","Sec-News 安全文摘",{"_294":295,"_296":-5},"changelogVersion","2026-10-01T08:00","release"]
