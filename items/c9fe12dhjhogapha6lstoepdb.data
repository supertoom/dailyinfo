[{"_1":2,"_3":4},"root",{"_5":100},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1793621935000,"id","c9fe12dhjhogapha6lstoepdb","title","Ivanti 修复 Connect Secure 两个零日漏洞，CVE-2026-111357 与 CVE-2026-118527 已被链式利用","originalTitle","Ivanti patches two more Connect Secure zero-days chained in attacks","summary","Ivanti 修复了 Connect Secure 的两个已被链式利用的零日漏洞，高危权限提升漏洞 CVE-2026-111357 与允许已认证攻击者上传文件的 CVE-2026-118527，自10月1日起与认证绕过漏洞 CVE-2026-104935 组合攻击。","reason","文章串联3个已被链式利用的漏洞，并披露攻击者未部署恶意软件而是通过重复漏洞利用执行命令。","source",{"_73":99},"links",{"_89":98},"publishedAt","2026-11-02T09:33:26.000Z","discoveredAt","2026-11-02T09:56:31.038Z","timelineAt","category","vuln","tags",[93,94,74,95,77,96,97],"score",84,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","Sergiu Gatlan","body",{"_61":88,"_89":-5,"_90":91,"_92":37},"outline",[82],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fQpogd7kEGwA","reportCount",1,"additionalSourceCount",0,{"_71":76,"_73":77},{"_71":31,"_73":75},{"_71":72,"_73":74},"slug","exploited","name","在野利用","漏洞披露","identity","身份与访问",{"_79":80,"_13":81},"publicId","7b68ec92-29a4-4b08-8b7d-6c1631d5b488","Ivanti三项零日漏洞被串联利用",{"_11":83,"_84":85,"_86":87},"sec-1","text","发现您现有的防御措施可能遗漏的电子邮件威胁。","level",2,"<p><img alt=\"Ivanti\" height=\"900\" src=\"/dailyinfo/media/8df5daaa33db65db.jpg\" srcset=\"/dailyinfo/media/bc3491e15c941c99.jpg 720w, /dailyinfo/media/924a219785953f3b.jpg 1200w, /dailyinfo/media/8df5daaa33db65db.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>Ivanti 发布了安全更新，修复了 Connect Secure (ICS) 远程访问网关中另外两个漏洞。自至少 10 月 1 日以来，这两个漏洞已被串联利用于零日攻击中。</p><p>威胁行为者利用了这两个漏洞（编号为&nbsp;<a href=\"https://nvd.nist.gov/vuln/detail/cve-2026-111357\">CVE-2026-111357</a>&nbsp;和&nbsp;<a href=\"https://nvd.nist.gov/vuln/detail/cve-2026-118527\">CVE-2026-118527</a>），并将其与一个身份验证绕过漏洞（CVE-2026-104935）结合使用；Ivanti&nbsp;<a href=\"https://www.bleepingcomputer.com/news/security/ivanti-warns-of-connect-secure-zero-day-exploited-in-attacks/\">已于上个月完成修补</a>&nbsp;，消除了主要攻击面。</p><p>CVE-2026-111357 是一个高严重性权限提升漏洞，而 CVE-2026-118527 允许已通过身份验证的攻击者在未修补的设备上上传文件。</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/46cc8742ac648b73.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>10 月发布 CVE-2026-104935 的补丁时，Ivanti 敦促管理员尽快升级，因为该公司已意识到“该漏洞在现实环境中遭到有限利用”。</p><p>“在发现漏洞遭到利用时，Ivanti 已经为 CVE-2026-104935 开发了修复方案，并且已针对受支持版本完成 QA 测试，因此我们决定不推迟向客户提供修复，以解决发现 LPE 时存在的主要利用路径，”Ivanti&nbsp;<a href=\"https://hub.ivanti.com/s/article/Security-Advisory-Ivanti-Connect-Secure-CVE-2026-104935?language=en_US\">补充道</a>&nbsp;，该公告已于周四更新。</p><p>“因此，我们最初的工作重点是披露 CVE-2026-104935，并尽快为客户提供保护。”</p><p>发现该漏洞的网络安全公司 Volexity&nbsp;<a href=\"https://www.volexity.com/blog/2026/10/13/a-series-of-unauthenticated-events-chained-exploitation-of-ivanti-connect-secure-zero-days/\">当时报告称</a>&nbsp;，至少从 10 月 3 日起，威胁行为者（UTA0576）就在将 CVE-2026-104935 漏洞与另外两个漏洞串联利用，以在完全修补的 ICS 设备上获得&nbsp;未经验证的 root 级代码执行能力。</p><p>“值得注意的是，UTA0576 没有部署任何恶意软件或 Web Shell。相反，该威胁行为者每执行一条命令都会重新利用该设备，并篡改日志来掩盖其踪迹，从而避开 Ivanti 的 Integrity Checker Tool，”&nbsp;<a href=\"https://x.com/Volexity/status/2110034602672709712\">Volexity 表示</a>&nbsp;。</p><p>威胁情报公司 Defused&nbsp;<a href=\"https://x.com/DefusedCyber/status/2110040892572602788\">也确认了 Volexity 的报告</a>&nbsp;，称其从 10 月 1 日开始发现 CVE-2026-104935 遭到 actively exploited 的最初迹象。</p><p>周二，美国&nbsp;网络安全和基础设施安全局 (CISA)&nbsp;<a href=\"https://www.bleepingcomputer.com/news/security/cisa-warns-admins-to-immediately-fix-ivanti-flaw-exploited-as-zero-day/\">将 CVE-2026-104935 加入了其 actively exploited vulnerabilities 目录</a>&nbsp;，并命令联邦机构在周五前修补其系统，</p><p>互联网威胁监测机构 Shadowserver&nbsp;<a href=\"https://dashboard.shadowserver.org/statistics/iot-devices/time-series/?date_range=7&amp;vendor=pulse+secure&amp;type=vpn&amp;model=pulse+connect+secure+vpn&amp;group_by=geo&amp;stacking=stacked\">目前追踪到超过 5,000 个暴露在互联网上的 ICS 实例</a>&nbsp;，但没有关于其中有多少实例&nbsp;已经受到保护、免受持续攻击的信息。</p><figure><img alt=\"Ivanti ICS instances exposed on the Internet\" height=\"344\" src=\"/dailyinfo/media/3231c546be0814fe.jpg\" loading=\"lazy\" decoding=\"async\" width=\"700\">\n<figcaption><em>暴露在互联网上的 Ivanti ICS 实例（Shadowserver）</em></figcaption>\n</figure><p>威胁行为者&nbsp;经常针对 Ivanti 漏洞发起攻击，尤其是在零日攻击中，因为这些漏洞可提供一条快速进入&nbsp;企业网络的途径，用于窃取敏感的企业和客户数据。</p><p>过去几年中，Ivanti 已修补了多个其他遭现实利用的 Connect Secure 零日漏洞，其中一些被串联用于&nbsp;<a href=\"https://www.bleepingcomputer.com/news/security/ivanti-connect-secure-zero-days-now-under-mass-exploitation/\">大规模攻击</a>&nbsp;以&nbsp;<a href=\"https://www.bleepingcomputer.com/news/security/ivanti-connect-secure-zero-days-exploited-to-deploy-custom-malware/\">部署恶意软件</a>&nbsp;。</p><p>2024 年初，Ivanti 修补了一个命令注入漏洞 (CVE-2024-21887) 和一个身份验证绕过漏洞 (CVE-2023-46805)，<a href=\"https://www.bleepingcomputer.com/news/security/ivanti-warns-of-connect-secure-zero-days-exploited-in-attacks/\">并于 2024 年 1 月初完成修复</a>&nbsp;；两周后又修补了一个服务器端请求伪造漏洞 (CVE-2024-21893)，<a href=\"https://www.bleepingcomputer.com/news/security/ivanti-warns-of-new-connect-secure-zero-day-exploited-in-attacks/\">两周后</a>&nbsp;。</p><p>最近，Ivanti&nbsp;<a href=\"https://www.bleepingcomputer.com/news/security/ivanti-warns-of-new-connect-secure-flaw-used-in-zero-day-attacks/\">于 2025 年 1 月</a>&nbsp;修复了一个远程代码执行 (RCE) 漏洞&nbsp;(CVE-2025-0282)，以及第二个 RCE 漏洞 (CVE-2025-22457)，后者&nbsp;<a href=\"https://www.bleepingcomputer.com/news/security/ivanti-patches-connect-secure-zero-day-exploited-since-mid-march/\">至少自 2025 年 3 月中旬以来遭到与中国有关联的国家黑客利用</a>&nbsp;。</p><p>Ivanti 拥有超过 3,000 名员工、超过 7,000 家合作伙伴的 网络，以及全球超过 40,000 名使用其 IT 资产管理解决方案的客户。</p><p>自 2021 年 11 月以来，CISA 已将<a href=\"https://www.cisa.gov/known-exploited-vulnerabilities-catalog?search=&amp;field_date_added_wrapper=all&amp;field_cve=&amp;sort_by=field_date_added&amp;items_per_page=All&amp;url=&amp;f%5B0%5D=vendor_project%3A817\">38 个 Ivanti 漏洞</a>标记为正在遭到实际利用，其中包括 12 个也被用于勒索软件攻击的漏洞。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/dc92bacf94761ef1.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现您现有的防御措施可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体会分析电子邮件意图、上下文和行为，以发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>对 Microsoft 365 或 Google Workspace 进行为期 14 天的只读扫描，看看哪些内容能够成功绕过防护，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始您的免费电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","漏洞","补丁","利用链","Ivanti","CISA","https://www.bleepingcomputer.com/news/security/ivanti-patches-two-more-connect-secure-zero-days-chained-in-attacks/","BleepingComputer",{"_101":102,"_103":-5},"changelogVersion","2026-10-01T08:00","release"]
