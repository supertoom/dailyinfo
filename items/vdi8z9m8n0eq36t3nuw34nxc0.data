[{"_1":2,"_3":4},"root",{"_5":107},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1794357643000,"id","vdi8z9m8n0eq36t3nuw34nxc0","title","Russia 关联 APT Turla 以 Cereal 工具集入侵哈萨克斯坦和罗马尼亚 Exchange 服务器","originalTitle","Russia-Linked APT Turla Turned Exchange Servers Into Their Own Control Room","summary","ESET 发现 Russia 关联 APT 组织 Turla 使用新工具集 Cereal 入侵哈萨克斯坦和罗马尼亚政府机构的 Microsoft Exchange 服务器，并将其用于长期网络间谍活动。","reason","source",{"_75":106},"links",{"_94":105},"publishedAt","2026-11-10T20:40:48.000Z","discoveredAt","2026-11-10T21:56:40.306Z","timelineAt","category","activity","tags",[78,100,76,101,102,103,104],"score",81,"selected",true,"channel","news","story",{"_84":85,"_13":86},"x","sameEvent",{"_11":98,"_13":99},"readingMode","full","author","Pierluigi Paganini","body",{"_62":93,"_94":-5,"_95":96,"_97":36},"outline",[87],"relatedStories",[83],"topics",[69,70,71,72],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","fHyJ3k0jvJV4","reportCount",5,"additionalSourceCount",4,{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","malware","name","恶意软件","attack","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件",{"_84":85,"_13":86},"publicId","b730b15c-81e8-41f1-b334-6023b6e66bf2","Turla用Cereal窃取Exchange邮件",{"_11":88,"_89":90,"_91":92},"sec-1","text","ESET 发现与俄罗斯有关联的 APT 组织 Turla 正在哈萨克斯坦和罗马尼亚的政府 Exchange 服务器上使用一套名为 Cereal 的新工具集。","level",2,"<h2 id=\"sec-1\">ESET 发现与俄罗斯有关联的 APT 组织 Turla 正在哈萨克斯坦和罗马尼亚的政府 Exchange 服务器上使用一套名为 Cereal 的新工具集。</h2><p>ESET Research 详细介绍了一套此前未有公开记录、名为 Cereal 的工具集，该工具集旨在 Microsoft Exchange 服务器上运行。研究人员于 2025 年 11 月 28 日在哈萨克斯坦的一个政府机构发现了它，随后又在罗马尼亚的一个政府机构发现了它；该罗马尼亚机构已于 12 月 23 日遭到入侵。研究人员发现，在罗马尼亚，该工具集被设置用于识别发往或来自 NATO 和 European Union 的电子邮件。ESET 高度确信其归属于&nbsp;<a href=\"https://securityaffairs.co/wordpress/85093/apt/trula-lightneuron-backdoor.html\">Turla</a>&nbsp;APT 组织（又称 <a href=\"https://securityaffairs.com/171699/apt/secret-blizzard-using-infrastructure-of-other-threat-actors.html\">Secret Blizzard</a>、&nbsp;<a href=\"https://securityaffairs.co/wordpress/58765/apt/snake-apt-group-macos.html\">Snake</a>、&nbsp;<a href=\"https://securityaffairs.co/wordpress/22700/malware/uroburos-rootkit-part-russian-cyberweapon-programme.html\">Uroburos</a>、&nbsp;<a href=\"https://securityaffairs.co/wordpress/75589/malware/turla-backdoor-pdf.html\">Waterbug</a>、&nbsp;<a href=\"https://securityaffairs.co/wordpress/67584/apt/turla-apt-adobe-installer.html\">Venomous Bear</a>&nbsp;和&nbsp;<a href=\"https://securityaffairs.co/wordpress/62139/apt/turla-apt-g20-attack.html\">KRYPTON</a>）&nbsp;，该组织&nbsp;<a href=\"https://securityaffairs.co/wordpress/104983/malware/acidbox-malware-turl.html\">至少自 2004 年起一直活跃</a>&nbsp;，目标包括中东、亚洲、欧洲、北美和南美以及前苏联加盟国的外交和政府组织及私营企业。</p><p>据 U.S. Cybersecurity and Infrastructure Security Agency（CISA）称，这个与俄罗斯有关联的威胁行为者被评估为隶属于俄罗斯 Federal Security Service（FSB）第 16 中心。</p><p>Cereal 这一名称源自序列化（serialization），即程序用于打包数据和代码以便传输的过程。该工具集主要由模块化 .NET 代码构成，这些代码以加密形式传入，在内存中自行解包，并且在磁盘上几乎不留下任何文件。只有第一个加载器会保存为常规 .NET 文件。</p><p>一项不同寻常的特点是，ESET 未发现由攻击者控制的服务器。主后门 CerealNeuron 不会连接外部服务器，而是在受害者的 Exchange 服务器上运行，并通过形似正常 Outlook Web Access、Autodiscover 和 ActiveSync 流量的网页路径等待命令。这使得相关活动很难在防火墙日志中被发现。如果请求未正确加密或未通过安全检查，服务器只会返回一个外观正常的 Exchange 错误页面。</p><p><em>“CerealNeuron 是一种被动后门，本身不含内置命令，但能够执行网络请求中 CerealRunner binaries 所包含的程序集；”ESET 发布的<a href=\"https://www.welivesecurity.com/en/eset-research/exchange-for-breakfast-turlas-cereal-tricks-are-not-for-kids/\">分析 </a>如此写道。</em></p><p><em>“其后果十分严重：</em></p><ul>\n<li><em>恶意流量与合法的 Exchange Web 服务流量共存——而这正是防御者最不可能拦截的一类流量。”</em></li>\n\n\n\n<li><em>没有可供发现、拦截或关闭的专用 C&amp;C 基础设施。受害者自身面向互联网的 Exchange 服务器就是操作人员可访问的控制点。</em></li>\n\n\n\n<li><em>基于网络的追踪受到严重限制。我们无法确定操作人员使用的入口 IP 地址。他们可能是直接连接、通过匿名化服务连接，或者从其他已遭入侵的主机发起连接。” </em></li>\n</ul><p>因此，防御者没有可供拦截或关闭的外部服务器。ESET 甚至无法确定攻击者的 IP 地址。第二个版本名为 CerealHermit，不具备网络功能，而是直接从磁盘读取加密的命令文件。这意味着部分受害者面临攻击者访问其系统的两种独立途径。</p><figure><a href=\"https://i0.wp.com/securityaffairs.com/wp-content/uploads/2026/11/image-19.png?ssl=1\"><img width=\"1024\" height=\"966\" src=\"/dailyinfo/media/0484339d1c79273c.webp\" srcset=\"/dailyinfo/media/0a0e8522d4acfcab.webp 720w, /dailyinfo/media/22ef830c452b3f72.webp 1200w, /dailyinfo/media/0484339d1c79273c.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"\"></a></figure><p>命令就像一次性程序。操作人员并非使用带内置菜单的单一后门，而是将每项任务作为由名为 CerealRunner 的组件携带的小型已编译 .NET 程序发送。任务包括通过 Exchange Web Services 提取邮箱、查询 Active Directory、执行 WMI 查询、提取本地存储的 Windows 凭据以及处理文件。ESET 发现了大量几乎相同的二进制文件，因此认为操作人员运行着一套会自动构建它们的内部系统。</p><p>.NET 技巧使其与众不同。第一个加载器滥用一项极少使用的功能，在任何 .NET 代码运行之前执行本机代码，因此分析人员看到的入口点毫无作用。操作人员还将其放入 Windows 管理文件夹，名称包括 ncobjapi.dll；并放入 .NET 本机映像缓存，名称包括 Microsoft.Exchange.Search.Mdb.ni.dll，从而让受信任进程代为加载。</p><p>邮件窃取是 ESET 称为新出现的部分。模块 CerealBox 将自身注入 EdgeTransport.exe，即处理邮件流的进程，并包装已在内存中运行的传输代理处理程序。</p><p><em>报告继续称：“CerealBox 采用了一种更隐蔽的方法。它并不注册自身，而是直接注入 EdgeTransport.exe，即处理邮件流的 Exchange 进程。” “然而，要到达这一位置并不简单：CerealBox 通过一条由嵌套 Cereal 组件构成 intricate 链投递。”</em></p><figure><a href=\"https://i0.wp.com/securityaffairs.com/wp-content/uploads/2026/11/image-18.png?ssl=1\"><img width=\"1024\" height=\"847\" src=\"/dailyinfo/media/f49781f01ccbf4dd.webp\" srcset=\"/dailyinfo/media/47a1ffd00c6b507d.webp 720w, /dailyinfo/media/2543d4dd1263751a.webp 1200w, /dailyinfo/media/f49781f01ccbf4dd.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"\"></a></figure><p>它不会注册新的代理，因此 Exchange 的配置中不会出现任何异常。邮件需携带 .doc、.docx 或 .pdf 文件，并匹配硬编码的发件人、收件人、主题词或文件名列表，才会符合条件。选定的邮件会被压缩、加密并暂存在磁盘上，操作人员随后会收集并删除它们。</p><p>受害者与 Turla 惯常的目标相符。据 ESET 称，自 2022 年以来，该组织所针对的国家中约有 70% 曾是苏联加盟共和国，或曾与莫斯科关系密切的欧洲国家。对罗马尼亚北约和欧盟电子邮件系统的关注，与俄罗斯长期以来的情报利益相符。ESET 还将哈萨克斯坦境内的攻击与该国自 2026 年 1 月以来驱逐俄罗斯流亡者的事件联系起来。该国境内的活动于 1 月 15 日增加，即旧新年假日后的第二天。</p><p>运行 Exchange 的组织应检查标准配置中可能看不到的可疑活动。这包括 Windows 管理文件夹中的异常 DLL 文件、本机映像缓存中的意外文件，以及针对后门所使用的三个 Web 路径的可疑请求。Exchange 传输代理列表干净，并不一定意味着邮件系统未遭入侵。</p><p><em>报告总结称：“Cereal 工具集是一件经过精心打造、用于长期隐蔽网络间谍活动的工具。” “Cereal 工具集表明，对 Turla 而言，Exchange 服务器不仅是邮件服务器——它们还是持久的收集点、内部执行枢纽，以及隐藏复杂 .NET 技术的合适环境。”</em></p><p><strong>在 Twitter 上关注我：&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;和&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;和&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a><strong></strong></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;hacking,&nbsp;newsletter)</strong><strong></strong></p>","original","zhKind","translation","complete","sif366thhfeqdn24sve2qcy60","Turla 利用 Microsoft Exchange 服务器部署 Cereal 后门窃取邮件","后门","数据窃取","Microsoft","ESET","CISA","https://securityaffairs.com/202800/apt/russia-linked-apt-turla-turned-exchange-servers-into-their-own-control-room.html","Security Affairs",{"_108":109,"_110":-5},"changelogVersion","2026-10-01T08:00","release"]
