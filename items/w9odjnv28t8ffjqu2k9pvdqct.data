[{"_1":2,"_3":4},"root",{"_5":101},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1794444100000,"id","w9odjnv28t8ffjqu2k9pvdqct","title","Fireworks AI 入侵导致少量 Notion AI 对话记录泄露","originalTitle","Notion says Fireworks breach exposed customer AI chat transcripts","summary","Fireworks AI 的安全入侵间接暴露了少量 Notion 工作区中的 Notion AI 对话记录，泄露内容来自 Insights 数据集。攻击者于 10 月 23 日经第三方云提供商进入其开发环境，窃取了部分客户的资源元数据、计费信息、模型权重和数据集；此前 10 月初的另一次入侵还涉及少量账户的环境变量、API 密钥和令牌。","reason","source",{"_74":100},"links",{"_61":99},"publishedAt","2026-11-11T20:54:20.000Z","discoveredAt","2026-11-11T23:09:21.085Z","timelineAt","category","activity","tags",[77,96,75,97,98],"score",66,"selected",false,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Bill Toulas","body",{"_92":-5,"_61":93,"_94":-5,"_95":36},"outline",[86],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","f1zgxU1rxNng","reportCount",1,"additionalSourceCount",0,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","ai-security","name","AI 安全","attack","攻击活动","ai-agent","AI Agent 安全","supply-chain","供应链安全",{"_83":84,"_13":85},"publicId","2c37c244-764b-44e8-91a5-ae809270e399","Fireworks AI入侵扩大至Notion对话",{"_11":87,"_88":89,"_90":91},"sec-1","text","Uncover email threats your existing defenses may miss.","level",2,"zh","<p><img alt=\"Notion\" height=\"900\" src=\"/dailyinfo/media/1d070898afaba832.jpg\" srcset=\"/dailyinfo/media/254206de10bfc701.jpg 720w, /dailyinfo/media/62fef60694c0cd20.jpg 1200w, /dailyinfo/media/1d070898afaba832.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>Notion, the digital workspace platform, disclosed that a security breach at its AI infrastructure provider, Fireworks AI, exposed Notion AI chat transcripts in a small number of workspaces.</p><p>The disclosure comes shortly after <a href=\"https://www.bleepingcomputer.com/news/security/fireworks-ai-discloses-new-breach-after-cloud-provider-hack/\">Fireworks AI confirmed</a> that an attacker accessed its development environment via a third-party cloud provider on October 23 and compromised resource metadata, billing information, model weights, and datasets for some customers.</p><p>Fireworks AI experienced another breach in early October, when hackers accessed environment variables containing API keys and tokens stored as secrets for a limited number of accounts.</p><p><a href=\"https://www.wiz.io/lp/securing-ai-agents-101?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY26Q3_INB_FORM_Securing-AI-Agents-101&amp;sfcid=701Py00000RTEWMIA5&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AI-Agents-101\"><img src=\"/dailyinfo/media/2ddb46eee4d24330.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>Notion learned about the exposed chat transcripts after receiving an alert from Fireworks on November 2 about an exposed dataset that contained only synthetic test data.</p><p>Notion responded by cutting off traffic to Fireworks, deleting all data from the vendor’s systems, and halting training runs by November 3.</p><p>However, Fireworks confirmed on November 8 that customer data had been accessed, <a href=\"https://www.notion.com/security/advisories/security-incident-involving-a-third-party-ai-vendor-nov9\">including that of Notion users</a>.</p><p>Notion is a cloud-based workspace used for note-taking, document creation, internal wikis, project management, and task tracking. It includes an AI assistant that can answer questions, summarize content, and help draft text.</p><p>Fireworks AI enables Notion to run some of the open-weight models available through Notion AI and analyze stored conversations for Insights, a feature that gives workspace administrators visibility into how their teams use AI.</p><p>The exposed transcripts came from the Insights dataset specifically, which has now been disabled.</p><p>“Upon analysis of the dataset Fireworks AI gave us on November 8, we discovered that it included Notion AI chat transcripts used for the Insights feature, which for the vast majority of impacted workspaces were unattributable,” <a href=\"https://www.notion.com/en-gb/security/advisories/security-incident-involving-a-third-party-ai-vendor\">Notion stated in an update</a>.</p><p>\"Unattributable means the chats weren't labeled with who wrote them or which workspace they came from, and the transcripts did not contain tool call results.”</p><p>Notion has also <a href=\"https://www.notion.com/help/security-incident-involving-a-third-party-ai-vendor\">published a FAQ page</a> about the incident, highlighting that Fireworks had contractually committed to zero data retention for Notion data.</p><p>According to the company, less than 1% of its users are impacted by the incident. Potentially affected workspace owners should review the data through Security incident review in Notion’s desktop web interface and share a link with members that lets them download their own transcripts.</p><p>Notion advises affected users to rotate any passwords, API keys, or other credentials entered into affected chats.</p><p>If neither a user nor their workspace owner has received a notice, Notion says no action is needed for now, and they are most likely not part of the impacted subset.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/0c6c2476908e136e.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Uncover email threats your existing defenses may miss.</a>\n        </h2><p>Adaptive Security's AI agents analyze email intent, context, and behavior to uncover phishing, business email compromise, and invoice fraud.</p><p>See what's getting through with a 14-day read-only scan of Microsoft 365 or Google Workspace, with no MX changes.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Start your free email security scan.</a>\n    </p>","zhKind","complete","数据泄露","大模型","供应链","https://www.bleepingcomputer.com/news/security/notion-says-fireworks-breach-exposed-customer-ai-chat-transcripts/","BleepingComputer",{"_102":103,"_104":-5},"changelogVersion","2026-10-01T08:00","release"]
