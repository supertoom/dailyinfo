[{"_1":2,"_3":4},"root",{"_5":99},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":60,"_61":62},"expiresAt",1794185105000,"id","q4ecagtl22d0shlsqi4lxs630","title","攻击者利用第三方服务商从 Crédit Mutuel Arkéa 窃取至多 1.33 亿美元","originalTitle","Attackers Exploit Third-Party Provider to Raid French Bank Crédit Mutuel Arkéa","summary","法国银行 Crédit Mutuel Arkéa 遭遇攻击，攻击者据报通过第三方服务商平台访问其账户，向其他银行机构发起欺诈交易，损失规模约为 1.18 亿欧元至 1.33 亿美元。","reason","材料梳理了攻击者借第三方服务商进入银行账户、实施转账并洗钱的链条，以及资金追查和客户钓鱼风险。","source",{"_74":98},"links",{"_62":97},"publishedAt","2026-11-08T10:25:47.000Z","discoveredAt","2026-11-08T13:03:50.476Z","timelineAt","category","activity","tags",[75,94,95,96],"score",78,"selected",true,"channel","news","story",{"_81":82,"_13":83},"x","readingMode","full","author","Pierluigi Paganini","body",{"_90":-5,"_62":91,"_92":-5,"_93":60},"outline",[84],"relatedStories",[80],"topics",[69,70,71],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation",false,"bodyLanguage","original","factId","fI9FC1LTMdnA","reportCount",4,"additionalSourceCount",3,{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","attack","name","攻击活动","crypto","密码学","email","邮件与钓鱼",{"_81":82,"_13":83},"publicId","12d9e017-9be0-4300-8768-9fc05ccfd8db","Crédit Mutuel Arkéa遭攻击，损失最高1.33亿美元",{"_11":85,"_86":87,"_88":89},"sec-1","text","French Bank Crédit Mutuel Arkéa says hackers exploited a service provider to ste","level",2,"zh","<h2 id=\"sec-1\">French Bank Crédit Mutuel Arkéa says hackers exploited a service provider to steal up to $133 million using the bank’s own account.</h2><p>French cooperative bank Crédit Mutuel Arkéa was hit by a cyberattack that let attackers make fraudulent transactions of up to $133 million, forcing it to suspend certain systems. Crédit Mutuel Arkéa is a major French cooperative banking and insurance group headquartered in Brest, Brittany, France.</p><p>The bank says the attacker used its own account to send transactions to other banking organizations, and that customer assets weren’t affected.</p><p><em>“French lender Credit Mutuel Arkea said on Thursday hackers had stolen around €100 million ($112.61 million) in a cyber heist and it was working to try to recover the money, in a rare case of cybercriminals successfully stealing from a mainstream bank.” <a href=\"https://www.reuters.com/legal/government/french-bank-credit-mutuel-arkea-says-100-million-missing-after-cyberattack-2026-11-05/\">Reuters states</a>.</em></p><p>Blockchain researcher ZachXBT first warned of a large unauthorized withdrawal from multiple centralized exchange accounts a day earlier. He said the attacker may have stolen up to 118 million euros ($133 million) and withdrawn it as the USDC and USDT stablecoins.</p><p><em>“Over the past 24 hours the illicit actor has been aggressively swapping USDC for ETH, transferring to instant exchanges (WellWallet, Kyrrex, etc), converting to XMR via Wagyu, and bridging across multiple chains.” <a href=\"https://t.me/investigations/372\">ZachXBT wrote</a>.</em></p><p><em>“While the illicit actor remains unidentified, I can say with a high degree of confidence it is NOT Lazarus Group based on multiple laundering indicators.”</em></p><p>The attacker remains unidentified, but ZachXBT believes it is highly unlikely to be <a href=\"https://securityaffairs.com/tag/lazarus-group\">Lazarus Group</a>, based on money-laundering patterns.</p><p><a href=\"https://www.bleepingcomputer.com/news/security/hackers-pull-off-133-million-french-bank-heist-via-service-provider/\">According to BleepingComputer</a>, the expert pointed out that the lack of public disclosure allowed attackers to launder <a href=\"https://t.me/investigations/374\">$30 million</a> by November 3, potentially preventing EU authorities from freezing the funds. The Paris prosecutor’s cybercrime unit opened an investigation after receiving a complaint from Crédit Mutuel Arkéa, with France’s cybercrime police leading the probe.</p><p>Arkéa disclosed the incident on November 4, saying it was contained, customer assets were unaffected and some transfers had been delayed. Attackers reportedly accessed the bank through a service provider’s platform, not Fortuneo, and used Arkéa’s own account to move funds through other banks and convert them into cryptocurrency. The bank also warned customers about increased phishing risks.</p><p><em>“Crédit Mutuel Arkéa announces that it has been the target of an attack that enabled the execution of fraudulent transactions.” reads the <a href=\"https://www.cm-arkea.com/arkea/banque/upload/docs/application/pdf/2026-11/04112026_-_communique_-_le_credit_mutuel_arkea_annonce_avoir_ete_victime_dune_cyberattaque__2026-11-04_15-40-19_385.pdf\">notice</a> published by the bank. “Upon detecting this attack, and in accordance with standard procedures, the Group contacted the relevant regulatory and supervisory authorities to inform them of the situation.” “This incident is now closed and fully under control. Operations are gradually resuming this morning, following thorough verification by the Group and its subsidiaries and the implementation of enhanced security measures.”</em></p><p><br>Crédit Mutuel Arkéa says customer assets were unaffected, although some transfers were delayed. The bank maintains its financial stability, warns of possible phishing attempts and urges customers not to share sensitive information. Its teams are assessing the incident and strengthening security measures, with further updates expected.</p><p>Arkéa did not confirm ZachXBT’s reported figure but acknowledged significant losses and said some funds were blocked. The bank ruled out internal human error, described the incident as a sophisticated attack and is working with law enforcement to identify the attackers and establish how the breach occurred.</p><p>When the FAQ <a href=\"https://www.cm-arkea.com/arkea/banque/assurances/pa_38386/fr/informations-complementaires-suite-a-l-attaque-dont-le-credit-mutuel-arkea-a-ete-victime\">asked</a> whether 118 million euros had been stolen, Arkéa wouldn’t give a number: We do not confirm this information and can only validate the order of magnitude.</p><p><strong>Follow me on Twitter:&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a><strong></strong></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;hacking,&nbsp;Crédit Mutuel Arkéa)</strong></p><figure><a href=\"https://i0.wp.com/securityaffairs.com/wp-content/uploads/2026/11/image-15.png?ssl=1\"><img width=\"1024\" height=\"683\" src=\"/dailyinfo/media/bae866a7affd7929.webp\" srcset=\"/dailyinfo/media/98190376f579b139.webp 720w, /dailyinfo/media/5f319747ff8475c7.webp 1200w, /dailyinfo/media/bae866a7affd7929.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"\"></a></figure>","zhKind","complete","数据泄露","钓鱼","加密","https://securityaffairs.com/202628/cyber-crime/attackers-exploit-third-party-provider-to-raid-french-bank-credit-mutuel-arkea.html","Security Affairs",{"_100":101,"_102":-5},"changelogVersion","2026-10-01T08:00","release"]
