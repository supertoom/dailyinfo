[{"_1":2,"_3":4},"root",{"_5":95},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795048838000,"id","syiens59ccuc9lmtn233vr8gd","title","意大利因 Facebook Android 图库访问默认开启问题罚款 Meta €805 million","originalTitle","Italy Fines Meta €805 Million Over Facebook's Android Gallery Access Without Explicit Consent","summary","意大利数据保护机构 Garante 对 Meta 罚款 €805 million，原因是 Facebook for Android 默认开启照片和视频图库建议功能，未经用户明确同意访问意大利用户图库及相关元数据。","reason","材料梳理了处罚依据、整改期限和功能默认状态，可用于理解移动应用获取图库权限时的合规边界。","source",{"_73":94},"links",{"_86":93},"publishedAt","2026-11-15T11:27:31.000Z","discoveredAt","2026-11-15T12:18:29.177Z","timelineAt","category","policy","tags",[90,91,78,92],"score",73,"selected",true,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_61":85,"_86":-5,"_87":88,"_89":37},"outline",[],"relatedStories",[81],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fULr7km2phv4","reportCount",3,"additionalSourceCount",2,{"_72":79,"_73":80},{"_72":77,"_73":78},{"_72":75,"_73":76},{"_72":31,"_73":74},"slug","name","政策法规","compliance","合规与标准","mobile","移动端","google","Google / 谷歌",{"_82":83,"_13":84},"publicId","4b2697c9-e311-4e85-a2db-005e21e0d0d4","意大利重罚Meta默认读取图库","<p><span><i></i><span>Swati Khandelwal</span><i></i><span>2026年11月15日</span></span><span>数据隐私 / 监管合规</span></p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjdTCjpbsG3Dp62JM1KZqfSvZpuBnxwaCxXsplW3dAt2b4Ym0KAWPfxkHf4DT-02VK3jJESLmgasdE6D36qGegWu7dk9YSLN4DZxRVsgrM9lIEXXHUvQ0VzaZ1_gFqpjtA4cP3rlt82g5WnK2sXNZHJd5F_rEk4VSTGnMKOuXziSM1R85Vqhway3lajwTA/s1600/facebook-fine.jpg\"><img alt=\"\" src=\"/dailyinfo/media/d10371d64d9f8cbe.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>Meta 昨天在意大利被罚款 €805 million，原因是 Facebook for Android 的一项功能会建议用户发布手机图库中的照片和视频。</p><p>意大利数据保护机构 Garante 发现，该功能默认启用，并且应用在未经用户明确同意的情况下访问了意大利用户的照片、视频及相关元数据。</p><p>该公司的期限是在 60 天内默认关闭该功能，包括对已授予应用图库访问权限的人，并单独征求同意。</p><p>一名发言人在 Reuters 报道的声明中表示，Meta 计划提出申诉，并称罚款“不成比例”。</p><p>该机构发现，应用通过单一权限请求图库访问权限，而该权限涵盖整个应用以及多个用途不同的功能。应用首先会显示一条关于启用其他功能的通用通知，但并未让用户清楚意识到，他们同时启用了图库建议。</p><p>一旦完全授予此类权限，就允许应用持续读取手机中的整个照片档案。用户和该机构都无法核查实际使用了哪些信息。</p><p>该机构认定这违反了意大利《隐私法典》第 122 条，该法将欧盟《电子隐私指令》纳入意大利法律。该规则将手机视为个人私人生活的一部分。因此，对手机所存储内容的任何访问，都必须取得自由和知情的同意，无论数据是否发送至其他地方，也无论是否造成损害。</p><p>该机构在其<a href=\"https://garanteprivacy.it/home/docweb/-/docweb-display/docweb/10321080\">新闻稿</a>中公布的命令要求公司：</p><ul>\n  <li>在 60 天内，通过单独且明确的请求就这项功能征求同意，并清楚说明该功能的用途、它会访问图库，以及如何将其关闭。</li>\n  <li>在 60 天内，保持该功能默认关闭，包括对已授予权限的人。</li>\n  <li>在 30 天内向该机构报告已开展的工作，并在 90 天内报告已采取的措施。</li>\n</ul><p>如果公司未能在 60 天期限前完成整改，则不得为任何未给出有效同意的人启用该功能。</p><p>Meta 在 <a href=\"https://www.investing.com/news/stock-market-news/italy-fines-meta-887-million-over-android-users-data-access-5027329\">Reuters 报道</a>引述的一份声明中表示，该功能只有在用户于设备上授予权限后才会运行，用户可以随时在设置中更改该权限。</p><p>发起此次调查的博尔扎诺消费者保护组织 Centro Tutela Consumatori Utenti 于 2025 年 7 月 11 日发布了<a href=\"https://www.consumer.bz.it/it/facebook-accede-foto-non-pubblicate\">消费者建议</a>。该建议告知用户关闭应用中的图库建议设置，并检查 Facebook 应用在其手机上拥有哪些访问权限和权限设置。</p><p>此次调查未审查图库内容是否被用于训练 AI 模型。该公司否认存在任何此类使用。该机构可能另行审查今年推出的一项新功能，该功能允许在云端处理图库内容。</p><p>该公司曾主张此案应由爱尔兰数据保护机构处理。Garante 驳回了这一主张，因为电子隐私规则并未规定一站式机制。</p><p>该功能自 2023 年起推出。调查于 2025 年 7 月开始，并包括该机构自行开展的技术分析。</p><p>罚款相当于该集团全球营收的约 0.47%。在确定罚款金额时，该机构考虑了涉及人数众多这一因素，即意大利约有 20 million 名 Android 用户。</p><p>它还衡量了这次数据泄露持续了多长时间。该机构表示，对于尚未更新应用的人，数据泄露仍在持续；对于已经授予权限的人，该机构称泄露仍在持续。</p><p>其他因素包括 2019 年对该公司的裁决，以及调查期间合作有限。公司在投诉后所作的变动被视为对其有利，但该机构认为这些变动来得太晚，而且仅惠及更新应用的人。</p><p>觉得这篇文章有意思吗？关注我们的 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a>，阅读更多我们发布的独家内容。</p>","original","zhKind","translation","complete","法规","合规","Google","https://thehackernews.com/2026/11/italy-fines-meta-805-million-over.html","The Hacker News",{"_96":97,"_98":-5},"changelogVersion","2026-10-01T08:00","release"]
