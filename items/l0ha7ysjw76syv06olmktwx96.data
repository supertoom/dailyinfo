[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1795394435000,"id","l0ha7ysjw76syv06olmktwx96","title","自主 AI Agent 利用 MONAI Label 漏洞 CVE-2026-133968 取得 root 权限","originalTitle","Attackers' AI Agents Found a Zero-Day in Medical-Imaging Software and Gained Root Access","summary","Amazon Threat Intelligence 称，中国关联攻击者使用自主 AI Agent 在 MONAI Label 中发现路径遍历漏洞 CVE-2026-133968，并在一台大学服务器上取得 root 权限。","reason","source",{"_75":103},"links",{"_93":102},"publishedAt","2026-11-21T11:03:17.000Z","discoveredAt","2026-11-21T11:26:46.569Z","timelineAt","category","activity","tags",[78,80,82,99,100,76,101],"score",81,"selected",true,"channel","news","story",{"_84":85,"_13":86},"x","sameEvent",{"_11":97,"_13":98},"readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_62":92,"_93":-5,"_94":95,"_96":36},"outline",[87],"relatedStories",[83],"topics",[69,70,71,72],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","fVbDsNwWSOac","reportCount",4,"additionalSourceCount",3,{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","research","name","技术研究","attack","攻击活动","exploited","在野利用","ai-offense","AI 攻防",{"_84":85,"_13":86},"publicId","52702772-c6ed-4351-9e9b-8fc6f1b0fd43","Cairn利用MONAI Label零日漏洞取得服务器权限",{"_11":88,"_89":90,"_91":68},"sec-1","text","现在该做什么","level","<p><span><i></i><span>Ravie Lakshmanan</span><i></i><span>2026年11月21日</span></span><span>人工智能 / 网络间谍活动</span></p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhEIG6Wgi3wGQXrsdGKEf4ORPFjHVGpRkoSUPraOJfKhGmB0vYFojLq2mCuOP3a71_XpNZusvn45ZDa1J3a7eQ0WE3XJY0FGunHVWB1yHBluJT5vSDCmzkhaFGiHjeKbnoah6noyZ3mNInS-mjJK1Gfcf7jT3A60ZYR_eknSgt_sEa6MNGM-DA5-aLXMbZ5/s1600/medical-ai.jpg\"><img alt=\"\" src=\"/dailyinfo/media/8307c22f0c614b96.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>Amazon Threat Intelligence 表示，本周有疑似与中国有关联的黑客利用自主 AI 智能体，在开源医学影像服务器 <strong>MONAI Label</strong> 中发现了一个此前不为人知的漏洞，并获取了一台大学服务器的 root 权限。</p><p>该漏洞允许没有账户的攻击者在服务器的存储文件夹之外写入文件，并影响默认配置下未启用登录的 MONAI Label 0.8.5 及更早版本。</p><p>维护者已在源代码中合并修复，但目前仍没有可安装的修复版本。</p><p>MONAI Label 是一款服务器，供研究团队标注医学扫描图像并训练影像模型；它是独立于更广泛的 MONAI 框架的程序。</p><p>该弱点是服务器中用于存储上传图像和标签部分的路径遍历漏洞。调用者提供的文件标识符会被附加到存储文件夹路径，并直接写入磁盘，而没有检查最终路径是否仍位于该文件夹内。</p><p>服务器以其运行账户的权限进行写入，因此攻击者无法写入该机器上的任意位置，但可写的代码或设置位置可能为执行代码开辟路径。默认情况下禁用身份验证，因此任何能够通过网络访问服务器的客户端都可以触发写入。0.8.5 及更早版本受到影响。</p><p>Amazon 是在发现运营方自己的 <strong>Cairn </strong>控制面板未设密码且暴露在互联网上后，还原了此次入侵过程。Cairn 是一个开源框架，可将 AI 智能体作为自动化渗透测试人员运行；暴露的面板泄露了智能体的任务设置、提示词和运行历史。</p><p>公司称，在 9 月份的大约 48 小时内，这些智能体摸清了应用程序的界面，并在大约 11 分钟后达到了向服务器写入文件的状态，详情见其 <a href=\"https://aws.amazon.com/blogs/security/chinese-nexus-actors-cairn-ai-agents-found-a-zero-day-on-their-own/\">事件报告</a>。</p><p>据该公司称，这些智能体几乎没有得到逐步指令。运营方设定了获取 shell 访问权限的目标并选择了目标，而智能体自行选择了方法。</p><p>调查人员以中等置信度将该行动与一个和中国有关联的实体联系起来，证据包括简体中文提示词、中国标准时间设置，以及中国可能感兴趣的目标。他们没有将该活动与某个具名组织联系起来，也没有认定中国政府在幕后主导。</p><p>root shell 是后来才获得的，而且并非在那 11 分钟内获得。在另一次会话中，这些智能体利用同一漏洞植入了一个 Python 会在启动时自动运行的文件。随后，他们触发了一项训练功能，启动了一个新的 Python 进程；该进程加载了植入的文件，并以 root 权限连接回攻击者。</p><p>此次获得的 root 权限仅存在于一台大学服务器上；其他 MONAI Label 系统是否会带来同样结果，取决于其运行方式以及服务账户所拥有的权限。</p><p>在后续一次会话中，运营方将通向第二个运行相同软件 大学网络的隧道交给了这些智能体。Amazon 认为该网络也是以相同方式遭到入侵，但尚未确认第二次入侵。</p><p>维护者确认了该漏洞，并于 10 月 19 日合并了<a href=\"https://github.com/Project-MONAI/MONAILabel/pull/1915\">源代码修复</a>；该修复会强制将上传路径解析到获准文件夹内，并拒绝空名称或以点号开头的名称。</p><p>他们于本周早些时候发布的<a href=\"https://github.com/Project-MONAI/MONAILabel/security/advisories/GHSA-qc22-rmgc-vg94\">安全公告</a>仍未列出任何已修补版本，并表示该修复将在未来版本中提供。最新版本<a href=\"https://pypi.org/project/monailabel/\">发布列表</a>仍为 0.8.5，其日期可追溯至 2024 年。源代码中合并了修复，并不等于有可安装的软件包。</p><p>该漏洞现已在<a href=\"https://www.cve.org/CVERecord?id=CVE-2026-133968\">CVE 记录</a>中列为 CVE-2026-133968，于本周发布，评分为 10 分中的 9.8 分，属于严重级别。项目的安全公告仍显示尚未分配 CVE，这只是该页面更新滞后，并不表示存在第二个漏洞。</p><h3 id=\"sec-1\">现在该做什么</h3><p>由于尚无可用的修复版本，务实的做法是切断暴露面，并限制已被入侵的服务器所能访问的资源：</p><ul>\n  <li>使用防火墙和路由规则阻止对 MONAI Label 服务器的不受信网络访问，而不仅仅依赖难以猜测的 URL。</li>\n  <li>启用身份验证；服务器默认将其关闭。</li>\n  <li>以权限受限的账户而非 root 身份运行服务器，并限制其可写入的文件夹。</li>\n  <li>不要假定从源代码构建的版本是安全的。在将其视为已修补之前，确认其包含 10 月的修复。</li>\n  <li>如果服务器可被访问，请检查是否存在异常的 Python 启动文件和异常的训练任务；这正是所报告攻击所采用的路径。</li>\n</ul><p>该公司的说法基于其自身重构，尚未得到独立证实。该说法不能证明患者扫描或记录被窃取、临床系统遭到接触，或攻击者超出了所述大学目标。</p><p>此次攻击活动还包括失败的操作，因此不应将某台服务器上的 root 结果视为每个 MONAI Label 部署的结果。</p><p>觉得这篇文章有意思？在 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a> 上关注我们，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","mfif5csbm0luk6anr64r4hzho","攻击者利用自主 AI 工具 Cairn 攻陷 MONAI Label 漏洞并取得服务器权限","漏洞利用","Agent 安全","AWS","https://thehackernews.com/2026/11/attackers-ai-agents-found-zero-day-in.html","The Hacker News",{"_105":106,"_107":-5},"changelogVersion","2026-10-01T08:00","release"]
