[{"_1":2,"_3":4},"root",{"_5":118},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1794185101000,"id","dxhu6zoooyev95kp3k297dewf","title","CrowdStrike 披露攻击者利用公开 PoC 快速武器化漏洞","originalTitle","How Adversaries Are Turning the Vulnerability Ecosystem Against Defenders","summary","攻击者正快速把公开漏洞研究改造成可部署的利用工具。CrowdStrike 在 2026 年 1 月至 7 月观察到，公开 PoC 至在野利用的中位时间不足 1 天，最快为 35 分钟，91% 的已观察利用在 PoC 发布后 48 小时内发生。","reason","文章用多起真实利用案例说明公开 PoC 正被快速武器化，为补丁优先级、修复时效与检测能力建设提供可迁移依据。","source",{"_68":79},"links",{"_110":117},"publishedAt","2026-11-05T06:00:00.000Z","discoveredAt","2026-11-05T20:01:15.996Z","timelineAt","category","activity","tags",[73,75,114,71,69,77,79,115,116],"score",76,"selected",true,"channel","news","story","x","readingMode","full","author","Lacie Blythe - Jaime Duque","body",{"_59":109,"_110":-5,"_111":112,"_113":37},"outline",[80,81,82,83,84,85,86,87],"relatedStories",[],"topics",[60,61,62,63,64,65],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_66":78,"_68":79},{"_66":76,"_68":77},{"_66":74,"_68":75},{"_66":72,"_68":73},{"_66":70,"_68":71},{"_66":67,"_68":69},"slug","ai-security","name","AI 安全","research","技术研究","attack","攻击活动","exploited","在野利用","vuln-mgmt","漏洞管理","crowdstrike","CrowdStrike",{"_11":107,"_89":108,"_91":95},{"_11":105,"_89":106,"_91":95},{"_11":103,"_89":104,"_91":100},{"_11":101,"_89":102,"_91":100},{"_11":98,"_89":99,"_91":100},{"_11":96,"_89":97,"_91":95},{"_11":93,"_89":94,"_91":95},{"_11":88,"_89":90,"_91":92},"sec-8","text","其他资源","level",4,"sec-7","展望",2,"sec-6","AI 对漏洞研究生态的影响","sec-5","Fortinet FortiOS和FortiProxy身份验证绕过漏洞&nbsp;（CVE-2024-55591）",3,"sec-4","Linux本地权限提升漏洞CopyFail（CVE-2026-31431）","sec-3","cPanel 身份验证绕过漏洞（CVE-2026-41940）","sec-2","实践中的表现","sec-1","窗口正在关闭","<p>安全社区长期以来一直秉持着一个基本信念：分享知识能让所有人更安全。研究人员发布技术博客、公布概念验证（POC）代码并分发扫描模板，以帮助防御者理解漏洞、确定补丁修复优先级并构建更好的检测能力。这一信念并非错误，但并不完整。&nbsp;</p><p>帮助防御者理解漏洞的公开研究，同时也为攻击者提供了漏洞利用路线图。CrowdStrike Counter Adversary Operations 对 2026 年 1 月至 2026 年 7 月期间观察到的武器化时间线进行分析，进一步印证了 2026 年攻击者正在迅速采用公开漏洞研究，而且往往只需数小时。&nbsp;</p><h2 id=\"sec-1\">窗口正在关闭</h2><p>公开漏洞研究（安全公告、技术博客、扫描模板以及 POC 和漏洞利用代码）人人都可获取，包括攻击者。</p><p>2026 年上半年的数据清楚表明了威胁行为者如何利用这些材料。CrowdStrike 对 2026 年 1 月至 7 月观察到的在野利用情况进行分析后发现，从漏洞出现公开 POC 到威胁行为者开始利用该漏洞，其中位时间不足一天；公开 POC 发布后观察到的最快利用发生在 35 分钟后。在 CrowdStrike 看到威胁行为者利用的公开 POC 漏洞中，91% 在 POC 发布后 48 小时内即遭到利用。</p><p>POC 发布就是这场竞赛的发令枪。对于采用传统补丁周期的组织而言，在利用开始前采取行动的窗口实际上已经关闭。防御者需要提出的问题是，他们能否在漏洞利用开始前完成补丁修复。对于大多数采用传统补丁周期的组织，坦率地回答是否定的。</p><p>公开研究对各个技能水平的攻击者都有益处。技能较弱的攻击者可以轻易获得已经或完全武器化的 POC 以及利用指导，从而将原本难以触及的漏洞纳入其能力范围；技能较强的攻击者则能够省去重复开发工作、降低成本，并通过融入更广泛的利用噪声来改善操作安全。&nbsp;</p><p>无论技术水平如何，结果都是一样的：更快投入实战运用、更广泛覆盖，以及显著降低投入。</p><h2 id=\"sec-2\">实践中的表现</h2><h3 id=\"sec-3\">cPanel 身份验证绕过漏洞（CVE-2026-41940）</h3><p>2026 年 4 月 28 日，cPanel 披露了身份验证绕过漏洞 CVE-2026-41940，该漏洞影响 cPanel 和 WebHost Manager（WHM）以及 WordPress Squared（WP2）的部分版本。未经身份验证的远程攻击者可以利用 CVE-2026-41940 获得对这些程序控制面板的未授权访问。&nbsp;</p><p>一天后的 2026 年 4 月 29 日，一家知名行业公司发布了一篇技术博客文章，提供了针对 CVE-2026-41940 的详细利用指导以及一个据称可用于检测受影响实例的检测工件生成器。<sup>1</sup> CrowdStrike Counter Adversary Operations 分析了这个据称的检测工件生成器，并确定只需稍加修改即可用于攻击。攻击者只需取消一行用于更改 root 密码的代码的注释，随后便能以 root 用户身份登录 WHM 终端，这实际上使该据称的检测工件生成器变成了武器化漏洞利用程序。</p><p>2026年4月30日，CrowdStrike Counter Adversary Operations开始观察到针对CVE-2026-41940的大规模机会主义利用。所观察到的大多数乃至全部利用活动均与技术博客和/或所谓的检测工件生成器中提供的利用指南相符。&nbsp;</p><p>CrowdStrike Counter Adversary Operations的回溯性威胁狩猎显示，某一单一威胁行为者很可能至少从2026年4月3日起就将CVE-2026-41940作为零日漏洞在野利用。该单一行为者如何发现这一零日漏洞并获得POC漏洞利用程序，目前仍不清楚。在野利用的时间范围与公开报道相符，这些报道称该漏洞已被利用了一个多月。<sup>2</sup></p><p>图1重点展示了在行业公开报道之前，CVE-2026-41940是如何作为零日漏洞被利用的，其范围相对具有针对性且较为有限；以及2026年8月29日有关该漏洞的行业报道几乎肯定推动了多个威胁行为者立即在全球范围内增加利用活动。在许多情况下，多个不同的威胁行为者利用了同一批存在漏洞的cPanel实例，从而形成了一种多方争夺的环境。&nbsp;</p><h3 id=\"sec-4\">Linux本地权限提升漏洞CopyFail（CVE-2026-31431）</h3><p>2026年4月29日，某行业来源发布了一个POC漏洞利用程序以及一项近期披露的Linux本地权限提升（LPE）漏洞（CVE-2026-31431）的技术细节，该漏洞被称为CopyFail。<sup>3</sup>在该行业来源发布其研究成果时，该漏洞已在Linux主线中得到修补，但在许多主流Linux发行版中仍未修补，这意味着它当时实际上仍是一个零日漏洞。CrowdStrike Counter Adversary Operations测试了该漏洞利用程序，并确认其在一台当时已完全修补补丁的Ubuntu 24.04主机上可靠且有效。</p><p>除了可靠性之外，CopyFail的主要优势还包括易于分发，因为它仅由一个非常小的Python脚本组成；以及无需创建用户命名空间即可执行。</p><p>2026年4月30日，CrowdStrike Counter Adversary Operations发现，与白俄罗斯有关联的威胁行为者UMBRAL BISON利用经过修改的CopyFail漏洞利用程序（SHA256哈希：<code>de8d1b25e8965dc98c62d675ee7c451ed12502194890f6cc691322ad66f3abf4</code>），针对乌克兰一家政府实体实施LPE，将权限从默认Web用户<code>www-data</code>提升至<code>root</code>。UMBRAL BISON利用提升后的访问权限部署了一个<i>MythicC2 Poseidon</i> C2代理，CrowdStrike Falcon®传感器在其执行时将其终止。</p><p>该威胁行为者很可能修改了公开的POC，以试图规避检测并提升针对现实世界目标的整体有效性。具体而言，它使用<code>exec()</code>函数将漏洞利用程序的主要逻辑作为字符串传递，以便在运行时进行求值，而不是将其定义为常规代码，这使得静态分析工具更难检测到它；此外，它还添加了结构化错误处理，以提升有效性和可靠性。最终，公开的POC漏洞利用程序成为该威胁行为者迅速修改为更难检测且更具韧性的漏洞利用程序的基础。&nbsp;</p><h3 id=\"sec-5\">Fortinet FortiOS和FortiProxy身份验证绕过漏洞&nbsp;（CVE-2024-55591）</h3><p>2026 年 2 月，CrowdStrike Counter Adversary Operations 发现了一个由与伊朗有关联的威胁行为者 STATIC KITTEN 控制的开放目录，其 IP 地址为 <code>157.20.182[.]49</code>，其中包含 1.9 GB 数据和 20,000 多个文件。其中包括一个经修改的公开 POC 漏洞利用程序（SHA256 哈希：<code>fd6b46d148af22da6163f18ce43b35ebb827cc6e140f03f0f514bc2a6f548743</code>），针对 FortiOS 和 FortiProxy 身份验证绕过漏洞（CVE-2024-55591）；该漏洞利用程序最初由业内知名来源于 2025 年 1 月 27 日发布。<sup>4</sup></p><p>公开 POC 漏洞利用程序只执行一条由用户提供的命令，而经修改的版本则包含 13 个硬编码载荷，用于枚举目标、创建用户并建立持久化。这些修改体现了将一个演示工具有条理地转变为更全面漏洞利用程序的思路。</p><table><caption>表 1. 经修改的 CVE-2024-55591 漏洞利用程序中的载荷</caption><tbody><tr><td><b>载荷名称</b></td><td><b>描述</b></td></tr><tr><td><code>test</code></td><td>创建后门管理员用户 <code>FortiWiFi</code>，密码为 <code>FortiWiFi123</code>，并为该用户分配 <code>super_admin</code> 配置文件，从而授予完整的系统访问权限</td></tr><tr><td><code>test2</code></td><td>列出受害者系统中的所有用户组，可能是为了通过侦察了解受害者系统现有的组结构</td></tr><tr><td><code>test3</code></td><td>显示所有本地用户账户，使攻击者能够枚举现有用户</td></tr><tr><td><code>test4</code></td><td>通过为 <code>FortiWiFi</code> 管理员账户分配 <code>ssl-vpn-groupamoss</code> 访问权限配置文件来修改该账户</td></tr><tr><td><code>test5</code></td><td>创建 <code>FortiWiFi</code> 用户，密码为 <code>FortiWiFi123</code>，将该用户添加到 <code>ssl-vpn-groupamoss</code> 组，然后显示所有用户组，以验证该用户已成功添加到组中</td></tr><tr><td><code>test6</code></td><td>创建或修改名为 <code>ssl-vpa-amoss</code> 的用户组，并将多个用户添加到该组，其中包括后门 <code>FortiWiFi</code> 账户（由 <code>test1 or test5</code> 创建）以及拥有希伯来语音译名称的用户（即 <code>shachar</code>、<code>sigal</code>、<code>amos</code>、<code>sima</code>、<code>lev</code> 和 <code>gabi</code>）</td></tr><tr><td><code>test7</code></td><td>查询 <code>ssl-vpn-groupamoss</code> 组配置的帮助信息，可能是为了了解可用于后续活动的选项</td></tr><tr><td><code>test8</code></td><td>创建后门用户 <code>darlen</code>，密码为 <code>1234</code></td></tr><tr><td><code>test9</code></td><td>与 <code>test</code> 载荷类似，创建密码为 <code>FortiWiFi123</code> 的 <code>FortiWiFi</code> 用户，或更新现有 <code>FortiWiFi</code> 用户以使用该密码</td></tr><tr><td><code>test10</code></td><td>创建 <code>FortiWiFi</code> 用户，密码为 <code>1234</code>，并将该用户（以及许多其他用户，其中许多拥有希伯来语音译名称）添加到 <code>VPN-Users</code> 组中，可能是为了将后门账户隐藏在合法用户之中</td></tr><tr><td><code>test11</code></td><td>创建名为 <code>FortiSetup</code> 的系统管理员账户，赋予其 <code>super_admin</code> 权限并设置加密密码（解密后的密码为 <code>gwm1607pmw</code>）；与其他载荷创建的后门相比，该账户提供了一种更复杂的后门，因为 <code>FortiSetup</code> 拥有 root VDOM 访问权限</td></tr><tr><td><code>test12</code></td><td>显示 <code>FortiAdmin</code> 账户的配置，可能是为了便于侦察</td></tr><tr><td><code>test13</code></td><td>创建一个名为 <code>offices</code> 的用户，设置电子邮件地址和加密密码（解密后的密码为 <code>@lolo@123456</code>）；<code>POC_ZZ_1.py</code> 的开发者可能添加该电子邮件地址，以使新用户看起来合法</td></tr></tbody></table><p>STATIC KITTEN 是自行修改了公开的 CVE-2024-55591 漏洞利用程序，还是从其他来源获得了这个经修改的版本，目前尚不清楚。不过，截至本文撰写时，CrowdStrike Counter Adversary Operations 尚未观察到其他威胁行为者使用这个经修改的 POC 或托管该 POC 的基础设施。&nbsp;</p><h2 id=\"sec-6\">AI 对漏洞研究生态的影响</h2><p>AI 的 advancements 无疑正在加快漏洞被发现和武器化的速度，并扩大其范围。<sup>5</sup> 只需将今年早些时候前沿模型出现之前与之后的近期 Microsoft 补丁星期二漏洞数量大幅增长进行对比，即可看出这一点。<sup>6</sup></p><p>由于固有的可见性缺口，以及不存在能够区分 AI 生成漏洞利用代码的单一标识符，检测并归因对手为漏洞研究目的直接使用 AI 仍然十分困难。更为复杂的是，暗示 AI 协助的模式（例如注释充分的代码、对现有 POC 的改进或结构化的代码组织）同样符合技术能力较高者的输出。&nbsp;</p><p>尽管如此，威胁行为者正在利用 AI 增强其漏洞研究能力。CrowdStrike Intelligence 评估称，他们几乎肯定至少会通过以下三种途径继续这样做：</p><ul><li>直接与前沿模型交互，试图“越狱”AI 安全防护并绕过任何出口管制限制</li><li>修改开放权重专有模型以用于恶意目的，方法是提取其安全防护；前沿 AI 公司不会对这些模型进行滥用监控，或监控程度较低</li><li>采用由行业来源发布的 AI 主导或 AI 辅助的公开漏洞研究</li></ul><p>第三点虽然并非直接使用 AI，但最容易检测。只需查看这篇博客文章中详述的 CopyFail 漏洞，据称其发现过程得到了 AI 的辅助。<sup>7</sup> 或者查看 2026 年 7 月对 wp2shell 的大规模利用，这是近十年来首个据称被发现的关键级未经身份验证 WordPress Core 远程代码执行（RCE）漏洞，据称是使用 GPT5.6 Sol Ultra 以及价值 25 美元的 tokens 发现的。<sup>8</sup></p><h2 id=\"sec-7\">展望</h2><p>在可预见的未来，对手几乎肯定会继续将公开漏洞研究作为其进攻工具包的一部分。随着更多 POC 漏洞利用代码在披露后数小时内即可例行获取——至少部分得益于 AI 辅助的漏洞研究——使用这些漏洞利用代码的威胁行为者数量几乎肯定会有所增加。在未来一年内，这很可能表现为大规模利用活动的增加，从而造成存在争夺的局势，例如这篇博客文章中涵盖的 cPanel CVE-2026-41940 利用案例。&nbsp;</p><p>不断扩大的这一利用公开漏洞研究的对手群体，再加上对手将公开研究成果转化为实际攻击的速度，进一步强化了三个关键要点。&nbsp;</p><p>第一，补丁优先级的确定比以往任何时候都更加困难。随着漏洞披露数量持续增加，预测哪些漏洞会吸引公开研究（以及因此吸引对手关注）已成为一项真正的情报挑战。由于对手能够获取与防守方相同的公告和公开漏洞利用代码，仅依赖 CVSS 分数来制定补丁决策的组织实际上是在依赖错误的信号。现实世界中的可利用性、利用的难易程度（即是否存在公开漏洞利用代码或利用指南）以及对手意图，才是区分重要漏洞与非重要漏洞的关键。</p><p>第二，补丁修补时间实际上等于零。2026 年上半年的数据印证了这一点：在 CrowdStrike 观察到遭到利用且存在 POC 的漏洞中，91% 在 48 小时内被武器化并投入实际使用，最快的一次观察记录是在 POC 公开后仅 35 分钟。对手将公开漏洞研究视为发令枪，而以数周或数天计的传统补丁周期无法与之竞争。</p><p>最后，参与漏洞利用的威胁行为者会更多。正如案例研究所所显示的，不同技能和资源水平的对手都在将公开研究成果投入实际利用：有些仅对 POCs 进行最小修改，另一些则对其进行完善（UMBRAL BISON 和 STATIC KITTEN 都曾展示这一点）。当动机和意图成为漏洞利用仅存的障碍时，参与其中的对手数量就会显著增加。</p><p>漏洞研究生态系统是安全社区最宝贵的资产之一，同时也是最重大的挑战之一。那些将公开研究视为威胁行为者发令枪的防御者，以及那些构建相应情报、补丁修复时间表和检测能力以与之匹配的防御者，才能跟上威胁步伐。</p><p><i>Jaime Duque 和 Lacie Blythe 是 CrowdStrike 的高级情报分析师。本研究于 Day Zero 2026 上进行了展示。</i></p><h4 id=\"sec-8\">其他资源</h4><ul><li><i>进一步了解 <a href=\"https://www.crowdstrike.com/en-us/platform/threat-intelligence/\">CrowdStrike Counter Adversary Operations</a> 的威胁情报和威胁狩猎，或 <a href=\"https://www.crowdstrike.com/en-us/platform/threat-intelligence/counter-adversary-operations-demo-request/\">申请演示</a>。</i></li><li><i>收听 <a href=\"https://www.crowdstrike.com/en-us/resources/adversary-universe-podcast/\">Adversary Universe 播客</a>，CrowdStrike 在其中揭秘最新网络攻击背后的威胁行为者。</i></li></ul><p><sup>1</sup> https://labs.watchtowr.com/the-internet-is-falling-down-falling-down-falling-down-cpanel-whm-authentication-bypass-cve-2026-41940/ || https://github.com/watchtowrlabs/watchTowr-vs-cPanel-WHM-AuthBypass-to-RCE.py</p><p><sup>2</sup> https://www.reddit.com/r/cpanel/comments/1syyajp/comment/oiyg0fr/</p><p><sup>3</sup> https://xint.io/blog/copy-fail-linux-distributions || https://github.com/theori-io/copy-fail-CVE-2026-31431</p><p><sup>4</sup> https://labs.watchtowr.com/get-fortirekt-i-am-the-super_admin-now-fortios-authentication-bypass-cve-2024-55591/ || https://github.com/watchtowrlabs/fortios-auth-bypass-poc-CVE-2024-55591</p><p><sup>5</sup> https://www.crowdstrike.com/en-us/blog/tune-in-future-of-ai-powered-vulnerability-discovery/</p><p><sup>6</sup> https://www.microsoft.com/en-us/security/blog/2026/10/06/ciso-perspectives-on-managing-vulnerability-risks-in-the-age-of-ai/</p><p><sup>7</sup> https://xint.io/blog/copy-fail-linux-distributions</p><p><sup>8</sup> https://www.wordfence.com/blog/2026/07/wp2shell-aftermath-the-first-critical-unauthenticated-wordpress-core-rce-in-nearly-a-decade/ || https://www.slcyber.io/research/exploit-brokers-pay-500000-for-a-wordpress-rce-i-found-one-with-gpt5-6#the-story-of-wp2shell</p>","original","zhKind","translation","complete","漏洞利用","Fortinet","Ubuntu","https://www.crowdstrike.com/en-us/blog/adversaries-turn-vulnerability-ecosystem-against-defenders/",{"_119":120,"_121":-5},"changelogVersion","2026-10-01T08:00","release"]
