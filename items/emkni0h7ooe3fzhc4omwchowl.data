[{"_1":2,"_3":4},"root",{"_5":105},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1794444093000,"id","emkni0h7ooe3fzhc4omwchowl","title","eMudhra 因私钥处理缺陷再撤销 8 个中间 CA 证书，累计影响 16 个","originalTitle","eMudhra revokes 8 more CA certificates after private key mishap","summary","eMudhra 因自定义 Python 脚本不当处理私钥，在首批 8 个 ECDSA 私钥可被瞬间恢复后，于 11 月 7 日再撤销 8 个 RSA 中间 CA 证书，累计影响 16 个，相关证书曾用于签发 TLS 和代码签名证书。","reason","source",{"_73":104},"links",{"_61":103},"publishedAt","2026-11-11T21:27:40.000Z","discoveredAt","2026-11-11T23:09:21.078Z","timelineAt","category","activity","tags",[74,96,97,98,99,100,101,102],"score",77,"selected",false,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","Lawrence Abrams","body",{"_92":-5,"_61":93,"_94":-5,"_95":36},"outline",[83,84],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fQYv9xOzfjbU","reportCount",1,"additionalSourceCount",0,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","attack","name","攻击活动","crypto","密码学","identity","身份与访问",{"_80":81,"_13":82},"publicId","7ea35928-df19-48f8-875d-8749fe0e8965","eMudhra因私钥处理缺陷撤销16个中间CA",{"_11":90,"_86":91,"_88":89},{"_11":85,"_86":87,"_88":89},"sec-2","text","Uncover email threats your existing defenses may miss.","level",2,"sec-1","Major browsers blocked compromised certificates","zh","<p><img alt=\"Certificate Revocation\" height=\"900\" src=\"/dailyinfo/media/8414d226571377d1.jpg\" srcset=\"/dailyinfo/media/d41ea34314f33512.jpg 720w, /dailyinfo/media/fb5fab8dbf933f00.jpg 1200w, /dailyinfo/media/8414d226571377d1.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>Certificate authority eMudhra has revoked eight additional intermediate CA certificates after an investigation into its recent certificate security incident found improper handling of private keys during the certificate-generation process.</p><p>The new revocations bring the total number of affected intermediate CA certificates to 16, including eight previously compromised certificates whose private keys were so weak that anyone could recover them almost instantly.</p><p>In a <a href=\"https://bugzilla.mozilla.org/show_bug.cgi?id=2083449#c82\">new incident report</a> published Tuesday, eMudhra said that both sets of certificates were affected by a custom Python script used to transfer private keys between hardware security modules (HSMs) in April 2025.</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/9c019570e7735ebd.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>HSMs are devices designed to securely generate and store cryptographic keys, preventing sensitive private keys from being exposed outside the hardware.</p><p>eMudhra says it developed the script to move certificate authority keys between different HSM vendors at its facilities after delays in obtaining new hardware.</p><p>However, the script contained a bug that reduced eight ECDSA private keys to a single byte, making them extremely easy to recover.</p><p>The same script also processed eight RSA private keys, which handled sensitive key information in the memory of the computer running the script rather than keeping it protected within the HSM.</p><p>While the RSA keys were not weakened like the original eight certificates, eMudhra says it could not demonstrate that it handled them under its certificate security policies.</p><p>\"A re‑import performed from host process memory is not consistent with the CPS §6.2.6 and the RSA objects are therefore treated as not meeting that requirement,\" reads the incident report.</p><p>Due to this, the company revoked the additional eight RSA intermediate CA certificates on November 7, including certificates used to issue TLS and code-signing certificates.</p><p>Some of the affected RSA intermediates had been actively issuing certificates since May 2026, with the last certificate issued on November 3.</p><p>eMudhra says the affected customer certificates have also been replaced or migrated.</p><p>The investigation also found that an earlier problem in June 2025 could have revealed the flaw more than a year before it was discovered by a security researcher known as \"Wayne.\"</p><p>At that time, eMudhra detected certificate revocation lists (CRLs) signed with private keys that did not match the corresponding CA certificates.</p><p>The company fixed the issue by signing the revocation lists with the matching keys but did not investigate why the problem occurred.</p><p>The new report confirms this was an early warning sign of the faulty key-generation process that went undetected until October 2026.</p><p>The investigation also found that eMudhra did not verify the strength of generated private keys or check that the keys used for certification matched those originally created in the HSM.&nbsp;</p><h2 id=\"sec-1\">Major browsers blocked compromised certificates</h2><p>As <a href=\"https://www.bleepingcomputer.com/news/security/mozilla-google-apple-block-compromised-emudhra-ca-certificates/\">BleepingComputer previously reported</a>, the incident was first disclosed on October 17, when a security researcher named Wayne discovered that eight eMudhra intermediate CA private keys could be recovered by testing just 256 possible values.</p><p>Major browsers and operating systems trusted the compromised certificates, potentially allowing attackers to forge certificates for legitimate websites and intercept encrypted communications.</p><p>Mozilla, Google, Apple, and other software vendors subsequently released protections to block the compromised certificates.</p><p>Microsoft also <a href=\"https://www.bleepingcomputer.com/news/microsoft/microsoft-releases-windows-oob-updates-to-distrust-emudhra-certificates/\">released out-of-band Windows updates</a> on October 26 to remove trust in affected eMudhra certificate trust chains on systems that could not receive automatic certificate trust updates.</p><p>Following the incident, eMudhra announced that it would exit the publicly trusted TLS certificate business and transition its remaining customers to another provider.</p><p>The company says it plans to stop issuing certificates under its remaining G1 hierarchy by November 16.</p><p>eMudhra has also commissioned an independent review by KPMG, with findings expected by December 4, to identify improvements to its certificate management and key-generation procedures.</p><p>The company says it has not detected any evidence that the compromised keys were used maliciously.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/0c6c2476908e136e.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-2\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Uncover email threats your existing defenses may miss.</a>\n        </h2><p>Adaptive Security's AI agents analyze email intent, context, and behavior to uncover phishing, business email compromise, and invoice fraud.</p><p>See what's getting through with a 14-day read-only scan of Microsoft 365 or Google Workspace, with no MX changes.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Start your free email security scan.</a>\n    </p>","zhKind","complete","数据泄露","凭据","加密","Mozilla","Google","Apple","Microsoft","https://www.bleepingcomputer.com/news/security/emudhra-revokes-8-more-ca-certificates-after-private-key-mishap/","BleepingComputer",{"_106":107,"_108":-5},"changelogVersion","2026-10-01T08:00","release"]
