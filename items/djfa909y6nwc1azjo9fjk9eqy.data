[{"_1":2,"_3":4},"root",{"_5":99},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":60,"_61":62},"expiresAt",1795653636000,"id","djfa909y6nwc1azjo9fjk9eqy","title","攻击者开始探测 Copeland XWEB EVO 制冷控制器新披露漏洞","originalTitle","Hackers Probe Newly Disclosed Flaws in Copeland Refrigeration Controllers","summary","Copeland XWEB EVO 制冷控制器披露的 14 个漏洞在公开后不到两小时便出现利用尝试。","reason","原文区分了针对新披露漏洞的机会性探测与此前法国超市蓄意破坏活动，并给出暴露规模、设备处置与迁移建议。","source",{"_76":98},"links",{"_62":97},"publishedAt","2026-11-16T11:05:42.000Z","discoveredAt","2026-11-16T11:43:14.215Z","timelineAt","category","vuln","tags",[93,79,94,95,96],"score",77,"selected",true,"channel","news","story",{"_86":87,"_13":88},"x","readingMode","full","author","Eduard Kovacs","body",{"_89":-5,"_62":90,"_91":-5,"_92":60},"outline",[],"relatedStories",[85],"topics",[69,70,71,72,73],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation",false,"bodyLanguage","original","factId","fzDz4qgSp5xg","reportCount",1,"additionalSourceCount",0,{"_74":83,"_76":84},{"_74":81,"_76":82},{"_74":31,"_76":80},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","research","name","技术研究","exploited","在野利用","漏洞披露","industrial","工业控制","iot","IoT 与车联网",{"_86":87,"_13":88},"publicId","ac5c8c15-eca6-4b51-87a5-1a611a24fa7d","XWEB EVO控制器14个漏洞已披露并遭探测","zh","<p><strong>Exploitation attempts against a vulnerability in Copeland’s XWEB EVO refrigeration controllers began less than two hours after the issue was made public last week, according to VulnCheck.</strong>\n\n\n\n</p><p>The security firm disclosed 14 vulnerabilities in XWEB EVO, a Dixell supervisory system now sold under the Copeland name. VulnCheck’s Valentin Lobstein said each flaw was shown to yield root privileges on test systems.\n\n\n\n</p><p>The product drew the researcher’s attention after the <a href=\"https://www.securityweek.com/refrigeration-controller-hack-spoils-food-across-european-supermarkets/\">October 11-12 attack</a> that triggered defrost cycles at roughly 700 French supermarkets. CERT-FR named <a href=\"https://www.securityweek.com/supermarket-refrigeration-attack-widens-to-copeland-dixell-controllers/\">Copeland and Dixell XWEB controllers</a> among the compromised products, and France has <a href=\"https://www.securityweek.com/france-blames-iran-for-a-cyberattack-that-heated-supermarket-refrigerators/\">blamed Iran</a> for the campaign.\n\n\n\n</p><p>Nine of the flaws disclosed by VulnCheck only affect firmware builds that predate a 2021 rewrite. They include unauthenticated command execution, a hardcoded administrator password, and command injection via the login page.\n\n\n\n</p><p>The other five vulnerabilities also impact the latest firmware. Four of them involve predictable credentials: the administrator’s daily password is generated from the device’s MAC address and the current date, and the MAC address is exposed to unauthenticated users.\n\n\n\n</p><p>An attacker can calculate the password offline, enable SSH, and log in as root, since the root password is built from the same daily code. The fifth flaw is a command injection issue that requires authentication.</p><p><span>Advertisement. Scroll to continue reading.</span></p><p>These five issues will not be fixed. Copeland <a href=\"https://webapps.copeland.com/dixell/Content/Pages/SystemSoftwareUpdate/XWEB30005000-EVO/XWEB%20EVO%20EoS%20-%20Product_Bulletin_March_2026.pdf\">ended software support</a> for the XWEB EVO family on March 16, 2026, and has advised customers to move to XWEB Pro models.\n\n\n\n</p><p>The CVE records were published on November 12, and VulnCheck’s sensors saw the first exploitation attempts within two hours. They targeted CVE-2026-124014, which allows unauthenticated attackers to write to the system configuration file.\n\n\n\n</p><p>A single IP address sent 125 requests overnight. On November 13, a second IP sent four probes aimed at CVE-2026-124010, the unauthenticated root command execution flaw. Both targeted flaws only affect the older firmware.\n\n\n\n</p><p>“Neither scanning source is evidence of the October refrigeration campaign that France attributed to Iran’s IRGC unit Shahid Kaveh: that was a targeted sabotage operation, while these are opportunistic hosts acting on fresh advisories,” Lobstein <a href=\"https://www.vulncheck.com/blog/copeland-xweb-evo-unauthenticated-root\">said</a>.\n\n\n\n</p><p>Onyphe data cited by VulnCheck shows nearly 2,000 internet-exposed XWEB EVO hosts, compared with 108 for XWEB Pro.\n\n\n\n</p><p>“Operators who still run one should treat it as a device that must never touch the public internet, segment it behind a VPN, and plan the move to a supported platform,” the researcher added.\n\n\n\n</p><p><strong>Related</strong>: <a href=\"https://www.securityweek.com/cyberattack-hits-french-blood-bank-site-but-no-blood-products-are-compromised/\">Cyberattack Hits French Blood Bank Site but No Blood Products Are Compromised</a>\n\n\n\n</p><p><strong>Related</strong>: <a href=\"https://www.securityweek.com/over-100-european-stores-hit-as-supermarket-fridge-attacks-resume/\">Over 100 European Stores Hit as Supermarket Fridge Attacks Return</a>\n\n\n\n</p><p><strong>Related</strong>: <a href=\"https://www.securityweek.com/us-agencies-urge-organizations-to-harden-refrigeration-controllers/\">US Agencies Urge Organizations to Harden Refrigeration Controllers</a>\n\n\n\n</p>","zhKind","complete","漏洞","IoT","工控","漏洞分析","https://www.securityweek.com/hackers-probe-newly-disclosed-flaws-in-copeland-refrigeration-controllers/","SecurityWeek",{"_100":101,"_102":-5},"changelogVersion","2026-10-01T08:00","release"]
