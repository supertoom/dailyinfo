[{"_1":2,"_3":4},"root",{"_5":100},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1794530485000,"id","h8ijgwnlhr1r0s4ikcq8iiule","title","Microsoft 云服务故障影响 Outlook、Teams、Copilot 及 AI 连接器","originalTitle","Microsoft Cloud Outage Hits Outlook, Teams, Copilot and AI Services","summary","Microsoft 云服务故障在 11 月 12 日影响美国数千名用户，Downdetector 记录超过 97,000 次 Outlook 事件、超过 38,000 次 Microsoft 365 问题和约 4,500 次 Teams 报告。","reason","source",{"_74":99},"links",{"_61":98},"publishedAt","2026-11-12T20:41:47.000Z","discoveredAt","2026-11-12T21:41:30.635Z","timelineAt","category","activity","tags",[75,95,96,97],"score",68,"selected",false,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Pierluigi Paganini","body",{"_91":-5,"_61":92,"_93":-5,"_94":36},"outline",[86],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fTqlpso7s9gg","reportCount",2,"additionalSourceCount",1,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","attack","name","攻击活动","ai-agent","AI Agent 安全","cloud-native","云与原生","microsoft","Microsoft / 微软",{"_83":84,"_13":85},"publicId","d0fbf5e0-7524-44ac-ae11-b93399172446","微软365多区域服务中断",{"_11":87,"_88":89,"_90":65},"sec-1","text","A Microsoft outage disrupted Outlook, Teams and Copilot, also breaking OpenAI an","level","zh","<h2 id=\"sec-1\">A Microsoft outage disrupted Outlook, Teams and Copilot, also breaking OpenAI and Anthropic connectors to Microsoft 365 accounts.</h2><p>Microsoft 365, Outlook and Teams went down for thousands of US users on Thursday, November 12. Reuters reported that the disruption also hit the connectors OpenAI’s and Anthropic’s AI services use to reach Microsoft accounts. </p><p><em>“Microsoft 365, Outlook and Teams were down for thousands of US users on Thursday, ​according to outage-tracking website Downdetector.com, with the disruption ‌also hitting connectors used by OpenAI’s and Anthropic’s AI services.” Reuters <a href=\"https://www.reuters.com/technology/microsoft-365-outlook-down-thousands-us-users-downdetector-shows-2026-11-12/\">states</a> </em></p><p>Downdetector, which collates status reports from several sources, <a href=\"https://downdetector.it/problemi/outlook/\">logged more than 97,000 Outlook incidents</a> at 2:07 p.m. ET. It also recorded more than 38,000 reports of Microsoft 365 problems and about 4,500 for Teams. Reuters notes the number of affected users may vary. Expers observed complaints surge that afternoon across Outlook, Microsoft 365, Teams, Copilot, Azure, OneDrive and the Microsoft Store.</p><figure><a href=\"https://i0.wp.com/securityaffairs.com/wp-content/uploads/2026/11/image-24.png?ssl=1\"><img width=\"1024\" height=\"260\" src=\"/dailyinfo/media/c9375d8163bb7507.webp\" srcset=\"/dailyinfo/media/6aa41faa27c80a8e.webp 720w, /dailyinfo/media/54aba22f6a8904bd.webp 1200w, /dailyinfo/media/c9375d8163bb7507.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"\"></a></figure><p>In a Microsoft 365 admin center notice (MO1550821), Microsoft warned that users might have trouble accessing several services, including Exchange Online, Teams, SharePoint Online, Microsoft 365 Copilot and Microsoft Defender XDR.</p><p>Microsoft said the outage started at 1:26 p.m. ET. However, it had already been investigating problems connecting to Exchange Online mailboxes in the Americas earlier that day. The company later confirmed that users worldwide could be affected.</p><p>Microsoft initially blamed heavy workloads across several regions. However, it later found that increased traffic was not the cause. In an update on X, the company said it was working to safely bring several unavailable servers back online. Their loss was putting extra pressure on the remaining infrastructure.</p><p>Its response so far has been to pause all deployments, redistribute connection traffic across its worldwide infrastructure and move additional traffic away from affected systems. It’s also restarting the affected servers to restore capacity. In a statement to Reuters, Microsoft said it was aggressively pursuing all pathways to reduce impact.</p><p><em>“We’re aggressively pursuing all pathways to reduce impact,” ​states Microsoft.</em> </p><p><em>“We determined the elevated load isn’t driven by an increase in traffic, but by a number of servers being unexpectedly unavailable; straining the remaining infrastructure. We’re working to safely return them to service,” Microsoft wrote on X.</em></p><p><br>Microsoft first blamed the disruption on high infrastructure demand across several regions. However, it later found that the issue was caused by servers unexpectedly going offline.</p><p>Microsoft also reported a separate Teams outage (TM1550488) that affected users in North and South America from 9:45 to 10:53 a.m. ET. Users experienced delays or failures when sending messages, creating or updating conversations, and retrieving chat messages. Microsoft traced the problem to resource contention within its infrastructure, which increased resource usage and prevented Teams from processing messages properly. The company confirmed that the issue has been resolved.</p><figure><blockquote><p>We determined the elevated load isn't driven by an increase in traffic, but by a number of servers being unexpectedly unavailable; straining the remaining infrastructure. We're working to safely return them to service. More info under EX1550543 and MO1550821 in the Microsoft 365…</p>— Microsoft 365 Status (@MSFT365Status) <a href=\"https://x.com/MSFT365Status/status/2120962673911181437?ref_src=twsrc%5Etfw\">November 12, 2026</a></blockquote>\n</figure><p>At this time the massive outage has yet to be resolved. Reuters says Microsoft later told customers the issue may also affect Microsoft 365 connectivity for users in other regions.</p><p>The impact also extended to AI services. OpenAI reported problems with its Microsoft connectors, saying new connections might fail and tools might not work properly. Anthropic also reported an issue with its Microsoft 365 connector caused by a problem at an upstream provider. As a result, Copilot and competing AI services were unable to access users’ inboxes because the underlying Microsoft services were unavailable.</p><p><br>IT teams should check the Microsoft 365 admin center for updates rather than make assumptions about the cause. They should also expect emails and messages to be delayed until services fully recover.</p><p><strong>Follow me on Twitter:&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a><strong></strong></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;hacking,</strong> <strong>Microsoft)</strong></p>","zhKind","complete","云原生","大模型","Microsoft","https://securityaffairs.com/202932/security/microsoft-cloud-outage-hits-outlook-teams-copilot-and-ai-services.html","Security Affairs",{"_101":102,"_103":-5},"changelogVersion","2026-10-01T08:00","release"]
