[{"_1":2,"_3":4},"root",{"_5":87},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795221633000,"id","gcqkdxgrkdjx8d44617xu023t","title","某国际律师事务所漏洞积压治理案例分析","originalTitle","When the Vulnerability Backlog Stops Calling the Shots","summary","Horizon3.ai 分析一家国际律师事务所如何依据漏洞对业务风险的实际影响确定修复优先级，而非仅依赖漏洞积压清单。该公司安全体系已较成熟，但管理层仍需识别可能造成重大暴露的弱点，衡量修复成效，并验证防御能力是否持续改善；正文未披露具体漏洞编号、CVSS 分数、版本范围、补丁状态或利用情况。","reason","source",{"_71":86},"links",{"_61":85},"publishedAt","2026-11-20T16:23:15.000Z","discoveredAt","2026-11-20T17:27:32.497Z","timelineAt","category","blue-team","tags",[83,74,84],"score",15,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","Horizon3","body",{"_79":-5,"_61":80,"_81":-5,"_82":36},"outline",[],"relatedStories",[75],"topics",[68,69],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fErG8oFzAB2s","reportCount",1,"additionalSourceCount",0,{"_70":73,"_71":74},{"_70":30,"_71":72},"slug","name","蓝队与运营","vuln-mgmt","漏洞管理",{"_76":77,"_13":78},"publicId","e8d4dd7d-fb19-4d1e-aa19-1e9f49eb9462","国际律所按业务风险排定漏洞优先级","zh","<p>For a firm whose service depends on trusted access to information, security risk has a direct business dimension. Leadership needs to know which weaknesses could create material exposure, where remediation will make the greatest difference, and whether the firm’s defenses are improving in practice. A major international law firm faced that challenge. Its security program was already mature…</p><p><a href=\"https://horizon3.ai/customer-story/law-firm-vulnerability-prioritization/\">Source</a></p>","zhKind","complete","蓝队","加固","https://horizon3.ai/customer-story/law-firm-vulnerability-prioritization/","Horizon3.ai",{"_88":89,"_90":-5},"changelogVersion","2026-10-01T08:00","release"]
