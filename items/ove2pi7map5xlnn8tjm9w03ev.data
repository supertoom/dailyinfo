[{"_1":2,"_3":4},"root",{"_5":110},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795221638000,"id","ove2pi7map5xlnn8tjm9w03ev","title","PHP 远程代码执行漏洞 CVE-2026-126714 已公开并发布修复","originalTitle","【漏洞通告】PHP远程代码执行漏洞（CVE-2026-126714）","summary","PHP 远程代码执行漏洞 CVE-2026-126714（phpAfterShell）已被公开，CVSS 评分为 9.2。","reason","通告列明受影响版本、会话处理器前提、临时缓解和修复版本，并提供人工与工具检测方法，便于评估和处置风险。","source",{"_72":109},"links",{"_101":108},"publishedAt","2026-11-20T03:35:00.000Z","discoveredAt","2026-11-20T17:23:34.134Z","timelineAt","category","vuln","tags",[104,105,106,107],"score",71,"selected",true,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","body",{"_61":100,"_101":-5,"_102":101,"_103":37},"outline",[79,80,81,82,83,84],"relatedStories",[75],"topics",[68,69],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","f20Jvufp9R0A","reportCount",1,"additionalSourceCount",0,{"_70":31,"_72":74},{"_70":71,"_72":73},"slug","research","name","技术研究","漏洞披露",{"_76":77,"_13":78},"publicId","5c978771-d0ef-4f3e-adc8-d47e442566ab","PHP会话文件反序列化漏洞已修复",{"_11":98,"_86":99,"_88":89},{"_11":96,"_86":97,"_88":89},{"_11":94,"_86":95,"_88":89},{"_11":92,"_86":93,"_88":89},{"_11":90,"_86":91,"_88":89},{"_11":85,"_86":87,"_88":89},"sec-6","text","4.2 其他防护措施","level",3,"sec-5","4.1 官方升级","sec-4","3.2 工具检测","sec-3","3.1 人工检测","sec-2","不受影响版本","sec-1","受影响版本","<p><span>NS-CERT</span> <span>2026-11-20 11:35</span> <span>中国香港</span></p><p><img src=\"/dailyinfo/media/8255fdebd5d84368.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>近日，绿盟科技CERT监测到PHP发布安全公告，修复了PHP远程代码执行漏洞（CVE-2026-126714），被称为“phpAfterShell”；CVSS评分9.2，目前漏洞细节已公开，请相关用户尽快采取措施进行防护。</p><p><strong><span>通告编号 NS-2026-0035</span></strong></p><p><span><span>2026-11-20</span></span></p><table><tbody><tr><td><strong><span><span>TAG：</span></span></strong></td><td><p><strong><span><span>PHP、远程代码执行、CVE-2026-126714</span></span></strong></p></td></tr><tr><td><strong><span><span>漏洞危害：</span></span></strong></td><td><p><strong><span>攻击者利用此漏洞，可造成会话状态损坏甚至任意代码执行。</span></strong></p></td></tr><tr><td><strong><span><span>版本：</span></span></strong></td><td><p><strong><span>1.0</span></strong></p></td></tr></tbody></table><p><strong><span>1</span></strong></p><p><strong><span><span>漏洞概述</span></span></strong></p><p><span>近日，绿盟科技CERT监测到PHP发布安全公告，修复了PHP远程代码执行漏洞（CVE-2026-126714），被称为“phpAfterShell”；由于PHP默认的files会话处理器在更新会话文件时未先清空原有内容，若写入过程中断可能形成混合新旧会话数据的异常文件。未经身份验证的攻击者在能够影响会话内容并中断替换写入的情况下，可使PHP在后续读取会话时反序列化攻击者控制的对象，从而造成会话状态损坏，当应用存在合适反序列化利用链时，可以PHP Worker权限执行任意代码。CVSS评分9.2，目前漏洞细节已公开，请相关用户尽快采取措施进行防护。</span></p><p><span>PHP是一种广泛使用的开源服务器端脚本语言，主要用于Web应用与动态网站开发，代码可以直接嵌入到HTML中，支持数据库交互、会话管理及文件上传等，是全球众多Web应用程序的基础支撑环境。</span></p><p><span>参考链接：</span></p><p><span><a href=\"https://github.com/php/php-src/security/advisories/GHSA-fm2m-fjf5-v3cp\">https://github.com/php/php-src/security/advisories/GHSA-fm2m-fjf5-v3cp</a></span></p><p><strong><span>SEE MORE →</span></strong></p><p><span><strong><span>2</span></strong></span><strong><span>影响范围</span></strong></p><h3 id=\"sec-1\"><strong><span>受影响版本</span></strong></h3><ul><li><p><span>PHP 8.5.x &lt; 8.5.13</span></p></li><li><p><span>PHP 8.4.x &lt; 8.4.28</span></p></li><li><p><span>PHP 8.3.x &lt; 8.3.37</span></p></li><li><p><span>PHP 8.2.x &lt; 8.2.36</span></p></li><li><p><span>4.1.0 &lt;= PHP &lt; 8.2.0（7.4/8.0/8.1官方EOL缓解分支除外）</span></p></li></ul><p><span>注：影响使用files会话保存处理器的部署；官方已停止维护的PHP 5、7、8.0和8.1也受影响。</span></p><h3 id=\"sec-2\"><strong><span>不受影响版本</span></strong></h3><ul><li><p><span>PHP 8.5.x &gt;= 8.5.13</span></p></li><li><p><span>PHP 8.4.x &gt;= 8.4.28</span></p></li><li><p><span>PHP 8.3.x &gt;= 8.3.37</span></p></li><li><p><span>PHP 8.2.x &gt;= 8.2.36</span></p></li><li><p><span>PHP = 7.4/8.0/8.1官方EOL缓解分支</span></p></li></ul><p><span>注：使用Redis、数据库等其他会话保存处理器的部署不受此漏洞影响。</span></p><p><span><strong><span>3</span></strong></span><strong><span>漏洞检测</span></strong></p><h3 id=\"sec-3\"><strong><span>3.1 人工检测</span></strong></h3><p><span>相关用户可通过检查PHP版本及会话保存处理器配置，判断当前应用是否在受影响范围：</span></p><p><span>1、查看PHP版本</span></p><pre><code><span>php -v</span></code></pre><p><img alt=\"image\" src=\"/dailyinfo/media/915a65f6911bbaca.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span>2、检查会话保存处理器，确认session.save_handler是否为files：</span></p><pre><code><span>php -r \"echo ini_get('session.save_handler') ?: 'files(default)', PHP_EOL;\"</span></code></pre><p><span>若PHP版本在受影响范围且使用files会话保存处理器，则可能存在安全风险。</span></p><h3 id=\"sec-4\"><strong><span>3.2 工具检测</span></strong></h3><p><span>绿盟科技自动化渗透测试工具（EZ）已支持PHP的指纹识别，相关用户可直接使用web模块进行扫描检测：</span></p><p><img alt=\"image\" src=\"/dailyinfo/media/8a145380d8411ffa.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span>工具下载链接：<a href=\"https://github.com/m-sec-org/EZ/releases\">https://github.com/m-sec-org/EZ/releases</a></span></p><p><span>新用户请注册M-SEC社区（<a href=\"https://msec.nsfocus.com）申请证书进行使用：\">https://msec.nsfocus.com）申请证书进行使用：</a></span></p><p><img alt=\"image\" src=\"/dailyinfo/media/9630c227216d80a8.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><strong><span>4</span></strong></span><strong><span>漏洞防护</span></strong></p><h3 id=\"sec-5\"><strong><span>4.1 官方升级</span></strong></h3><p><span>目前官方已发布新版本修复此漏洞，请受影响的用户尽快升级版本进行防护，下载链接：<a href=\"https://www.php.net/downloads.php\">https://www.php.net/downloads.php</a></span></p><p><span>注：使用Linux发行版或第三方产品内嵌PHP的用户，应安装对应厂商提供的修复版本，升级后重启 PHP-FPM、Apache 等 PHP 服务进程。</span></p><h3 id=\"sec-6\"><strong><span>4.2 其他防护措施</span></strong></h3><p><span>在不影响业务的情况下，相关用户可通过下列措施进行临时缓解：</span></p><p><span>1、在php.ini中关闭会话上传进度功能，并重启PHP工作进程：</span></p><pre><code><span>session.upload_progress.enabled = 0</span></code></pre><p><span>2、限制存入会话的不可信数据量，减少攻击者可控数据进入会话；该措施仅能阻断部分输入路径，无法修复应用程序独立存储攻击者可控会话数据时的风险。</span></p><p><strong><span>END</span></strong></p><p><img src=\"/dailyinfo/media/d80afd58e695f438.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img src=\"/dailyinfo/media/d0b7cde05d67ff1f.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>声明</span></strong></p><p><span>本安全公告仅用来描述可能存在的安全问题，绿盟科技不为此安全公告提供任何保证或承诺。由于传播、利用此安全公告所提供的信息而造成的任何直接或者间接的后果及损失，均由使用者本人负责，绿盟科技以及安全公告作者不为此承担任何责任。</span></p><p><span>绿盟科技拥有对此安全公告的修改和解释权。如欲转载或传播此安全公告，必须保证此安全公告的完整性，包括版权声明等全部内容。未经绿盟科技允许，不得任意修改或者增减此安全公告内容，不得以任何方式将其用于商业目的。</span></p><p><img src=\"/dailyinfo/media/d0b7cde05d67ff1f.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><span><strong><span>绿盟科技CERT</span></strong></span><span><span>∣</span></span><span><span>微信公众号</span></span></p><p><img src=\"/dailyinfo/media/473526bfa52947a2.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><img src=\"/dailyinfo/media/e1a29d3eda6f9ac3.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>长按识别二维码，关注网络安全威胁信息</span></span></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=ebe46cf6&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzk0MjE3ODkxNg%3D%3D%26mid%3D2247494212%26idx%3D1%26sn%3D6a538230b1fa15acf64d2d18135d0026\">跳转微信打开</a></p>","original","zhKind","complete","漏洞","补丁","漏洞分析","PHP","https://mp.weixin.qq.com/s?__biz=Mzk0MjE3ODkxNg==&mid=2247494212&idx=1&sn=6a538230b1fa15acf64d2d18135d0026","绿盟科技CERT",{"_111":112,"_113":-5},"changelogVersion","2026-10-01T08:00","release"]
