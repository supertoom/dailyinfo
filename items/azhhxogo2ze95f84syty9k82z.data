[{"_1":2,"_3":4},"root",{"_5":99},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794530482000,"id","azhhxogo2ze95f84syty9k82z","title","Windows CLFS 漏洞 SignDrop 可借助特权进程获取 SYSTEM 权限","originalTitle","New Windows SignDrop zero-day gives hackers SYSTEM privileges","summary","安全研究员 Abdelhamid Naceri 公开了 Windows CLFS 漏洞 SignDrop 的 PoC，可诱导 Windows Defender 等特权进程创建认证文件并借此获取 SYSTEM 权限。","reason","文章给出了 SignDrop 的文件创建与权限提升链、PoC 验证方法及适用条件，便于研究人员理解该漏洞的利用逻辑。","source",{"_73":98},"links",{"_89":97},"publishedAt","2026-11-12T16:04:00.000Z","discoveredAt","2026-11-12T16:07:22.398Z","timelineAt","category","vuln","tags",[93,94,95,74,96],"score",77,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","Sergiu Gatlan","body",{"_61":88,"_89":-5,"_90":91,"_92":37},"outline",[82],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fkkOn4gdRkiA","reportCount",1,"additionalSourceCount",0,{"_71":76,"_73":77},{"_71":31,"_73":75},{"_71":72,"_73":74},"slug","exploited","name","在野利用","漏洞披露","microsoft","Microsoft / 微软",{"_79":80,"_13":81},"publicId","b1d88153-27ef-4511-ab17-98b25a2dfedc","SignDrop Windows 零日利用公开",{"_11":83,"_84":85,"_86":87},"sec-1","text","发现现有防御可能遗漏的邮件威胁。","level",2,"<p><img alt=\"Windows\" height=\"900\" src=\"/dailyinfo/media/3f396ec0ee5e7729.jpg\" srcset=\"/dailyinfo/media/7890c0a4288f536a.jpg 720w, /dailyinfo/media/201e2d820d476eda.jpg 1200w, /dailyinfo/media/3f396ec0ee5e7729.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>安全研究员 Abdelhamid Naceri（又称 Nightmare Eclipse）发布了一个新的 Windows 零日漏洞利用程序，可让攻击者获得 SYSTEM 权限。</p><p>该利用程序名为 <strong><a href=\"https://github.com/MSNightmare/SignDrop\">SignDrop</a></strong>，利用了 Microsoft 于 2025 年 10 月引入的缓解措施；这些措施用于防御针对 <a href=\"https://learn.microsoft.com/windows-hardware/drivers/kernel/introduction-to-the-common-log-file-system\">Common Log File System</a>（CLFS）驱动程序漏洞的认证攻击。Naceri 表示，在该缓解措施推出后，利用 CLFS 漏洞的攻击大幅减少，但 Microsoft 的缓解措施本身却引入了这个新漏洞。</p><p>据 Naceri 称，该缺陷源于 CLFS 在创建新日志文件时处理认证文件（\".cnpf\"）创建的方式。他说，CLFS 在最初会正确执行访问检查，但如果之后由另一个特权进程打开该日志文件，这套逻辑就可能被滥用。</p><p><a href=\"https://www.wiz.io/lp/securing-ai-agents-101?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY26Q3_INB_FORM_Securing-AI-Agents-101&amp;sfcid=701Py00000RTEWMIA5&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AI-Agents-101\"><img src=\"/dailyinfo/media/5e70f2dd2c0c1369.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>他还补充说，可以迫使 Windows Defender 等特权进程打开这些文件，从而以 SYSTEM 权限创建认证文件，而 CLFS 会使用原始文件的访问权限创建该文件。</p><p>Naceri 指出，Microsoft 正确实施了该缓解措施，但“这套逻辑允许滥用”，并称该技术可用于针对任何反恶意软件引擎的自防御（篡改保护），因为文件创建请求看起来像是来自该引擎自身的合法进程。</p><p>“如果所有环节都正确串联起来，有趣的是，这个合法的安全缓解措施可以用来对付其自身，并允许提升权限。Microsoft 在这里把一切都正确完成了，但这套逻辑允许滥用。”这位安全研究员说道。</p><p>“更有意思的是，它可以针对任何反恶意软件引擎使用，绕过其自防御（或篡改保护）机制，因为你可以触发在其自身反恶意软件进程的上下文中创建任意文件，因此从其内核驱动程序的视角来看，文件创建请求来自其自身的合法进程，所以会通过检查。这使得该漏洞十分独特，因为它可以用来关闭任何杀毒软件/EDR。”</p><figure><img alt=\"SignDrop PoC exploit\" height=\"368\" src=\"/dailyinfo/media/8cb3430d28d0743f.jpg\" srcset=\"/dailyinfo/media/08185fd89edbe571.jpg 720w, /dailyinfo/media/0af5eb374a6c3dad.jpg 1200w, /dailyinfo/media/8cb3430d28d0743f.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"815\">\n<figcaption><em>SignDrop PoC 漏洞利用程序（Abdelhamid Naceri）</em></figcaption>\n</figure><p>虽然 SignDrop 无法用于所有 Windows 计算机，但 Naceri 在 Windows 11 26H2、Windows 11 26H2 Experimental 和 Windows Server 2025 Experimental 上测试了该漏洞利用程序，并估计 80% 的 Windows 安装都容易受到攻击。</p><p>Naceri 建议运行概念验证（PoC）漏洞利用程序，以检查 Windows 设备是否容易受到 SignDrop 攻击，或者检查 HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Services\\CLFS\\Authentication\\Mode 注册表值下的 CLFS 认证模式。</p><p>如果 PoC 漏洞利用程序生成了 SYSTEM shell，则该计算机容易受到攻击。此外，如果注册表值为 0 或 1（学习模式或强制模式），则该计算机容易受到攻击。</p><p>Naceri 补充称，目前除了等待 Microsoft 发布补丁之外没有其他解决方案，因为禁用 CLFS 缓解措施会使设备暴露于利用内存损坏漏洞的攻击。</p><p>这位自称曾任职于 Microsoft 的安全研究员披露，自 4 月以来，Microsoft Defender、BitLocker 和其他 Windows 组件中还存在一长串零日漏洞，其中包括 <a href=\"https://www.bleepingcomputer.com/news/security/new-windows-defender-zero-day-blocks-microsoft-antivirus-updates/\">BigDiskBuster</a>、<a href=\"https://www.bleepingcomputer.com/news/security/new-microsoft-defender-shieldcrash-zero-day-grants-system-access/\">ShieldCrash</a>、<a href=\"https://www.bleepingcomputer.com/news/security/new-microsoft-defender-shieldbreak-zero-day-grants-system-privileges/\">ShieldBreak</a>、<a href=\"https://www.bleepingcomputer.com/news/security/new-windows-legacyhive-zero-day-exploit-grants-hackers-admin-access/\">LegacyHive</a>、<a href=\"https://www.bleepingcomputer.com/news/microsoft/microsoft-defender-rogueplanet-zero-day-grants-system-privileges/\">RoguePlanet</a>、<a href=\"https://www.bleepingcomputer.com/news/security/disgruntled-researcher-leaks-bluehammer-windows-zero-day-exploit/\">BlueHammer</a>、<a href=\"https://www.bleepingcomputer.com/news/microsoft/new-microsoft-defender-redsun-zero-day-poc-grants-system-privileges/\">RedSun</a>、<a href=\"https://www.bleepingcomputer.com/news/security/windows-bitlocker-zero-day-gives-access-to-protected-drives-poc-released/\">YellowKey</a>、<a href=\"https://www.bleepingcomputer.com/news/security/windows-bitlocker-zero-day-gives-access-to-protected-drives-poc-released/#:~:text=The%20GreenPlasma%20exploit\">GreenPlasma</a>、<a href=\"https://www.bleepingcomputer.com/news/microsoft/new-windows-miniplasma-zero-day-exploit-gives-system-access-poc-released/\">MiniPlasma</a> 和 <a href=\"https://github.com/Nightmare-Eclipse/UnDefend\">UnDefend</a>。</p><p>五年前，Naceri 发布了<a href=\"https://www.bleepingcomputer.com/news/security/all-windows-versions-impacted-by-new-lpe-zero-day-vulnerability/\">多个</a><a href=\"https://www.bleepingcomputer.com/news/microsoft/new-windows-zero-day-with-public-exploit-lets-you-become-an-admin/\">零日</a><a href=\"https://www.bleepingcomputer.com/news/microsoft/windows-zero-day-flaw-giving-admin-rights-gets-unofficial-patch-again/\">漏洞利用程序</a>，可在各种 Windows 版本上实现权限提升。</p><p>在 Naceri 未先行尝试私下报告这些零日漏洞的情况下公开披露后，Microsoft <a href=\"http://www.microsoft.com/en-us/msrc/blog/2026/05/a-shared-responsibility-protecting-customers-through-coordinated-vulnerability-disclosure\">警告</a><a href=\"http://x.com/msftsecresponse/status/2061293718942908925\">将采取法律行动</a>，针对任何对公司客户造成“恶意活动并造成实际损害”的行为，这导致信息安全领域的许多人认为公司的行动直接威胁安全研究员。</p><p>虽然 Microsoft 已修复了 Naceri 自今年年初以来披露的部分安全漏洞（包括 ShieldBreak、RoguePlanet、YellowKey、GreenPlasma 和 MiniPlasma 漏洞），但其他零日漏洞仍没有官方补丁。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/646a709bc4a5de75.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体会分析邮件意图、上下文和行为，识别网络钓鱼、商业邮件入侵和发票欺诈。</p><p>使用 Microsoft 365 或 Google Workspace 进行 14 天只读扫描，看看有哪些威胁正在绕过防御，且无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始免费邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","漏洞","复现","漏洞利用","Microsoft","https://www.bleepingcomputer.com/news/security/new-windows-signdrop-zero-day-gives-hackers-system-privileges/","BleepingComputer",{"_100":101,"_102":-5},"changelogVersion","2026-10-01T08:00","release"]
