[{"_1":2,"_3":4},"root",{"_5":103},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794185100000,"id","c8c3sczng53jdb0j9x5vqc0ry","title","欧洲多国逾115家超市制冷系统遭攻击，门店被迫处置变质商品","originalTitle","Hackers disrupt refrigeration systems at European supermarkets","summary","攻击者远程修改欧洲多国超市冷柜和制冷系统的温度设置、关闭制冷设备或启动除霜，导致超过115家门店受到影响，并造成商品损失和提前营业干预。","reason","材料梳理了多国超市制冷系统遭远程操控的规模、受影响门店及处置方式，并指出攻击可能复用法国同类事件中的漏洞。","source",{"_74":102},"links",{"_93":101},"publishedAt","2026-11-02T14:28:39.000Z","discoveredAt","2026-11-02T15:00:33.056Z","timelineAt","category","activity","tags",[75,97,98,99,100],"score",82,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Bill Toulas","body",{"_61":92,"_93":-5,"_94":95,"_96":37},"outline",[86],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fZgkHH0BZWRg","reportCount",7,"additionalSourceCount",6,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","attack","name","攻击活动","industrial","工业控制","iot","IoT 与车联网","supply-chain","供应链安全",{"_83":84,"_13":85},"publicId","f8dc115a-c01e-495d-aa28-9f5907059932","欧洲多轮攻击扰乱超市及医疗制冷",{"_11":87,"_88":89,"_90":91},"sec-1","text","发现现有防御可能遗漏的电子邮件威胁。","level",2,"<p><img alt=\"Hackers disrupt refrigeration systems at European supermarkets\" height=\"900\" src=\"/dailyinfo/media/bdd4f095fc526205.jpg\" srcset=\"/dailyinfo/media/925c11498adc6c4c.jpg 720w, /dailyinfo/media/6a091f3e0dfc6db1.jpg 1200w, /dailyinfo/media/bdd4f095fc526205.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>一次针对制冷系统的网络攻击导致欧洲多个国家的多家超市连锁店运营中断，黑客远程更改了冷冻柜和冷却系统的温度设置。</p><p>在某些情况下，黑客关闭了冰箱或启动除霜系统，导致温度上升，造成大量产品损失，并迫使门店经理一大早便介入处理。</p><p>数十家超市发现制冷故障，但尚不清楚这些门店是遭到了一次协同攻击，还是分别被单独针对。</p><p><a href=\"https://www.wiz.io/lp/securing-ai-agents-101?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY26Q3_INB_FORM_Securing-AI-Agents-101&amp;sfcid=701Py00000RTEWMIA5&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AI-Agents-101\"><img src=\"/dailyinfo/media/16b822e246c5db1c.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>比利时、荷兰、瑞典、卢森堡、爱尔兰和爱沙尼亚共有超过 115 家门店受到影响。多条连锁店的发言人向 BleepingComputer 证实了这些问题。</p><p>承认存在制冷问题的超市连锁店包括：</p><ul>\n\t<li>ICA（瑞典）- 至少 4 个地点受到影响</li>\n\t<li>Coop（瑞典）- 确认 7 个地点受到影响</li>\n\t<li>Ahold Delhaize（比利时和卢森堡）- 约 40 个地点受到影响</li>\n\t<li>Carrefour（比利时）- 15 个地点受到影响</li>\n\t<li>Spar Colruyt（比利时）- 5 个地点受到影响</li>\n\t<li>Intermarché（比利时）- 约 15 个地点受到影响</li>\n\t<li>SuperValu（爱尔兰）- 13 家门店</li>\n\t<li>Selver（爱沙尼亚）- 1 家门店</li>\n</ul><p>在荷兰，至少有 17 家肉铺和社区门店受到影响。</p><p>比利时还有更多门店正应对同样的问题，包括位于蒙斯的 Ikea 大型超市、杂货店和巧克力店。</p><p>ICA、Ahold Delhaize 和 Spar Colruyt 的发言人告诉 BleepingComputer，各公司正在为受影响的门店提供支持，并着手解决当前情况。</p><p>“我们可以确认，昨晚发生了一起事件，影响了少量不在 ICA 中央网络内运营的 ICA 门店，”ICA 的新闻发言官表示。</p><p>“该事件影响了这些门店的制冷和冷冻系统。ICA 目前正在协助受影响的门店应对当前情况。”</p><p>Colruyt Group 的一名代表告诉 BleepingComputer，“约五家 Spar 门店的制冷系统受到了影响。”</p><p>“这些门店由独立经营者运营，他们拥有自己的制冷系统。我们目前正竭尽所能解决这一问题。”</p><p>Ahold Delhaize 在向 BleepingComputer 发布的声明中表示，一起 IT 事件影响了数十家门店的制冷系统。</p><p>“我们确认了一起 IT 事件，影响了数十家门店的制冷系统，”该公司的通信部门表示，并称公司“立即采取了必要措施，以保持我们的门店正常运营。”</p><p>瑞典最大杂货连锁店之一 Coop 的发言人表示，少数门店的制冷设备受到影响，其中一次系统开始产生热量。</p><p>“我们可以确认，从周一夜间到周一時段内，少数门店受到影响——具体为 800 多家门店中的 7 家，”Coop 告诉 BleepingComputer。</p><p>“目前情况已得到控制，处于可控范围内。问题从冰箱和冷冻柜完全停机到设备部分正常运行不等，其中一次系统开始产生热量。”</p><p>在比利时，只有两个地区的 Carrefour 门店受到影响，所有大型超市仍完全正常运营。</p><p>“Carrefour 受到的影响非常有限：目前我们 700 家门店中有 15 家受到影响，弗拉芒和瓦隆地区均有涉及，”Carrefour 表示。</p><p>\"其中没有一家是大型综合超市。所有门店仍保持营业，因为这仅涉及少数几台制冷设备，主要是冷柜。已迅速采取行动，使所有门店都能继续营业。\"</p><p>一家 ICA 门店经理<a href=\"https://www.tv4.se/artikel/2hn4kfNV7MvZgcIBhSX8BI/kylar-och-frysar-utslagna-i-flera-ica-butiker-vi-har-blivit-hackade\">告诉 TV4</a>，温控设置已在一夜之间改为 +50°C (122°F)，且无法修改，迫使门店丢弃冷冻食品。</p><p>据 RTL 媒体报道，Ahold Delhaize 在凌晨 4 点左右通过短信向经理警告制冷问题，一些门店使用冷藏货车试图保存库存。</p><p>该出版物还确认，Sabcobel 是多个受影响地点制冷系统的供应商。</p><p>Sabcobel 董事 Stephan Moelans 表示，攻击者利用了与上月法国发生的<a href=\"https://www.bleepingcomputer.com/news/security/cyberattack-shuts-down-refrigerators-at-french-supermarkets/\">类似攻击</a>相同的漏洞。</p><p>Moelans 表示，技术人员从凌晨 1 点开始断开受影响的设备，并将此次中断归因于远程激活的除霜功能。</p><p>尽管该公司试图保护客户的系统，但仅靠简单的软件更新并不足够，因为冰箱还需要进行物理改造。</p><p>\"最简单的解决方案是通过安全的互联网连接管理冰箱。自法国遭到攻击以来，我们的大多数客户都采用了这一方案，\"<a href=\"http://www.rtl.be/actu/conso/ne-peut-pas-avoir-pire-dans-notre-metier-les-magasins-belges-victimes-dune/2026-11-02/article/805251\">Moelans 告诉 RTL</a>。</p><p>BleepingComputer 已联系 Sabcobel，以了解有关此次事件及其参与程度的情况，但仍在等待回应。</p><p>上月法国发生的冰箱攻击影响了数百家门店，这些门店使用的<a href=\"https://cert.cyber.gouv.fr/alerte/CERTFR-2026-ALE-012\">Danfoss AK-SM/AK-SC 和 Copeland/Dixell XWEB</a>制冷控制器遭到远程攻击者入侵，被设置为除霜模式。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/03f545515f18a71f.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能代理会分析电子邮件的意图、上下文和行为，以发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>进行 14 天的 Microsoft 365 或 Google Workspace 只读扫描，看看有哪些威胁能够穿透防护，且无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始您的免费电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","IoT","漏洞利用","供应链","工控","https://www.bleepingcomputer.com/news/security/hackers-disrupt-refrigeration-systems-at-european-supermarkets/","BleepingComputer",{"_104":105,"_106":-5},"changelogVersion","2026-10-01T08:00","release"]
