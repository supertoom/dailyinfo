[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1794444093000,"id","fnabcfsbgj6bt3qhysv9l42b6","title","WhiteArmor 声称从 Maersk 窃取 100GB 数据并索要 500 万美元赎金","originalTitle","WhiteArmor Demands $5 Million from Maersk, Claims Theft of 100GB of Data","summary","Maersk 确认其一处收购遗留本地系统遭未授权访问和数据提取，但初步调查认为事件局限于该系统，未发现敏感数据泄露或其他 Maersk、客户及合作伙伴系统受影响。","reason","source",{"_73":96},"links",{"_61":95},"publishedAt","2026-11-11T20:47:36.000Z","discoveredAt","2026-11-11T22:19:29.713Z","timelineAt","category","activity","tags",[74,92,93,94],"score",64,"selected",false,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","Pierluigi Paganini","body",{"_88":-5,"_61":89,"_90":-5,"_91":36},"outline",[83],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fHo2KZPYjArg","reportCount",2,"additionalSourceCount",1,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","attack","name","攻击活动","ransomware","勒索软件","supply-chain","供应链安全",{"_80":81,"_13":82},"publicId","41dc60b4-3949-4993-9807-db2659b6034b","马士基确认收购遗留系统遭勒索窃密",{"_11":84,"_85":86,"_87":65},"sec-1","text","Maersk confirms a data breach involving a legacy system, while WhiteArmor claims","level","zh","<h2 id=\"sec-1\">Maersk confirms a data breach involving a legacy system, while WhiteArmor claims 100GB of stolen data and demands a $5 million ransom.</h2><p>A.P. Moller Maersk, the Danish shipping giant, says it identified an IT security incident involving unauthorized access and data extraction from one of its local legacy systems, one inherited from a previous acquisition. </p><p><em>“Maersk has identified an IT security incident involving unauthorised access and data extraction from one of our local legacy systems from a previous acquisition.” reads the <a href=\"https://www.maersk.com/news/articles/2026/11/11/it-security-incident\">statement</a> published by Maersk on November 11. “Our findings so far strongly suggest no sensitive data has been disclosed. The incident is isolated to a local system, and we have found no indication that there has been any impact on other Maersk systems or customer and partner systems that connect to Maersk through integrations such as APIs and EDI.”</em></p><p>According to Maersk, its cyber security team started a full investigation as soon as it found the problem, and it’s still going. The company says swift action secured the affected system. Its findings so far strongly suggest no sensitive data has been disclosed, and it says the incident is isolated to that one local system.</p><p>Maersk has found no sign that other Maersk systems were affected, or the customer and partner systems that connect to it through integrations such as APIs and EDI. It doesn’t expect disruption for customers, who can book and manage shipments as usual. It promises updates and says it will inform any affected parties if it finds a need to.</p><p>Maersk didn’t name the system, the type of data or the date of the intrusion. However, the cybercrime group WhiteArmor added the company to its Tor data leak site:</p><figure><a href=\"https://i0.wp.com/securityaffairs.com/wp-content/uploads/2026/11/image-22.png?ssl=1\"><img width=\"1024\" height=\"614\" src=\"/dailyinfo/media/2697a7fb2c25e381.webp\" srcset=\"/dailyinfo/media/490002c3319217ef.webp 720w, /dailyinfo/media/e75ee2866dbe0f78.webp 1200w, /dailyinfo/media/2697a7fb2c25e381.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"\"></a></figure><p>WhiteArmor demanded a $5 million ransom in Bitcoin, giving Maersk 30 days to pay. The group claims to have stolen about 100 GB of data from the OCF/LF Logistics platform, which supports logistics and supply chain operations. </p><p><em>“”Your contract-logistics arm, the former LF Logistics, runs fulfilment for many of the world’s largest consumer brands,” <a href=\"https://www.bankinfosecurity.com/maersk-probes-ransomware-claim-tied-to-legacy-system-a-33362\">states the leak site</a>. “Five million dollars is roughly four hours of that EBITDA.””</em></p><p>Maersk acquired LF Logistics, the company that developed the platform, from the Li &amp; Fung Group in 2022. This could match Maersk’s reference to an old system inherited through an acquisition, although the company has not confirmed this connection.</p><p>According to the attackers, the stolen data includes nearly 30,000 driver records, passwords stored in plain text, 33 super admin accounts and signed delivery receipts. The group also claims to have stolen inventory records, purchase orders, advance shipping notices and 27,842 mobile device logs containing phone numbers, email addresses and IMEI numbers. These details come from the attackers and have not been independently verified. Maersk’s statement does not confirm their claims. WhiteArmor also tried to justify its demand, saying the $5 million ransom represents roughly four hours of revenue for the logistics business.</p><p><em>“We do not anticipate disruption to operations for customers at this time, and customers can continue to use Maersk platforms to book and manage their shipments as usual.” concludes the statement. “We will keep customers updated as more relevant information becomes available, and if we identify any need to inform impacted parties of any further findings, we will do so.”</em></p><p>The scale of Maersk’s operations explains why this incident matters. A.P. Moller-Maersk is one of the world’s largest integrated shipping and logistics companies, playing a major role in global trade and supply chains. It operates around 700 container ships, representing approximately 13.5% of global container fleet capacity, and manages 60 terminals across 35 countries. The company employs about 100,000 people in 130 countries and provides services covering ocean shipping, port operations, warehousing, customs clearance and end-to-end supply chain management.</p><p>Maersk reported approximately $54 billion in revenue and $2.9 billion in net profit in 2025. Its global reach and reliance on interconnected IT systems make cybersecurity a major concern. A breach involving even an older, locally operated platform could expose sensitive business and personal information, including data belonging to drivers, customers and logistics partners, even if the company’s main systems remain unaffected.</p><p>In 2017, NotPetya <a href=\"https://securityaffairs.com/68227/security/maersk-notpetya-attack.html\">forced</a> the company to reinstall more than 4,000 servers and 45,000 workstations from scratch. It operated without IT for ten days and took damages of up to $300 million.</p><p><strong>Follow me on Twitter:&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a><strong></strong></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;hacking,&nbsp;ransomware)</strong></p>","zhKind","complete","数据泄露","勒索","供应链","https://securityaffairs.com/202869/data-breach/whitearmor-demands-5-million-from-maersk-claims-theft-of-100gb-of-data.html","Security Affairs",{"_98":99,"_100":-5},"changelogVersion","2026-10-01T08:00","release"]
