[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":58,"_59":60},"expiresAt",1794185107000,"id","ungyq5x28j803aw7gd2hmsng3","title","Chrome 157 稳定版发布，Windows、Mac 和 Linux 收录 213 项安全修复","originalTitle","Stable Channel Update for Desktop","summary","Chrome 157 稳定版面向 Windows、Mac 和 Linux 推送，Linux 版本为 157.0.8103.38，Windows/Mac 版本为 157.0.8103.38/.39，将在未来数日或数周内完成分发。","reason","公告集中列出 Chrome 157 稳定版包含的 213 项安全修复及漏洞等级和上报者信息，适合浏览器用户核对更新范围与受影响组件。","source",{"_65":80},"links",{"_60":79},"publishedAt","2026-11-03T20:38:18.791Z","discoveredAt","2026-11-03T21:21:22.419Z","timelineAt","category","vuln","tags",[75,76,77,68,78],"score",71,"selected",true,"channel","news","story","x","readingMode","full","author","Srinivas Sista","body",{"_71":-5,"_60":72,"_73":-5,"_74":58},"outline",[],"relatedStories",[],"topics",[61,62,63],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_64":69,"_65":70},{"_64":67,"_65":68},{"_64":31,"_65":66},"slug","name","漏洞披露","browser","浏览器","google","Google / 谷歌","zh","<p>&nbsp;<span>The Chrome team is delighted to announce the promotion of Chrome 157 to the stable channel for Windows, Mac and Linux. This will roll out over the coming days/weeks.</span></p><p><span><span><span><span><span><span>Chrome </span><span><span>157.0.8103.38 (Linux)&nbsp;</span></span></span></span></span><span><span>157.0.8103.38/.39&nbsp;<span><span>Windows/Mac </span></span></span><span>contains a number of fixes and improvements -- a list of changes is available in the</span><a href=\"https://chromium.googlesource.com/chromium/src/+log/156.0.8078.80..157.0.8103.39?pretty=fuller&amp;n=10000\"> log</a><span>. Watch out for upcoming</span><a href=\"https://chrome.blogspot.com/\">Chrome</a> and<a href=\"https://blog.chromium.org/\"> Chromium</a> blog posts about new features and big efforts delivered in 157.</span></span></span></p><p><span><span>Security Fixes and Rewards<br></span><span>Note: Access to bug details and links may be kept restricted until a majority of users are updated with a fix. We will also retain restrictions if the bug exists in a third party library that other projects similarly depend on, but haven’t yet fixed.</span></span></p><p><span><b><span><span><i><br></i></span></span></b><span>This update includes </span><a href=\"https://issues.chromium.org/issues?q=customfield1223088:0-M157\"><span>213</span></a><span> security fixes. Please see the </span><a href=\"https://www.chromium.org/Home/chromium-security\"><span>Chrome Security Page</span></a><span> for more information.</span></span></p><p><span><b><span><span><br></span></span></b><span>[$10,000][</span><a href=\"https://issues.chromium.org/issues/567735302\"><span>567735302</span></a><span>] Critical CVE-2026-121156: Buffer overflow in Dawn. </span><span>Reported by Zhenpeng (Leo) Lin at depthfirst on 2026-09-30</span><b><br></b><span>[$1,000][</span><a href=\"https://issues.chromium.org/issues/562777838\"><span>562777838</span></a><span>] Critical CVE-2026-121229: Memory corruption in ANGLE. </span><span>Reported by @mfx on 2026-09-17</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/558870371\"><span>558870371</span></a><span>] Critical CVE-2026-121246: Use after free in WebGL. </span><span>Reported by Google on 2026-09-08</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/567216197\"><span>567216197</span></a><span>] Critical CVE-2026-121035: Use after free in Prerender. </span><span>Reported by Xinyang Ge (Anthropic), assisted by Claude on 2026-09-28</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/569161611\"><span>569161611</span></a><span>] Critical CVE-2026-121247: Buffer overflow in Dawn. </span><span>Reported by Google on 2026-10-03</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/571065824\"><span>571065824</span></a><span>] Critical CVE-2026-121203: Use after free in Geometry. </span><span>Reported by Xinyang Ge on 2026-10-07</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/571284308\"><span>571284308</span></a><span>] Critical CVE-2026-121126: Use after free in Core. </span><span>Reported by Wenbin Liu on 2026-10-08</span><b><br></b><span>[$10,000][</span><a href=\"https://issues.chromium.org/issues/485855931\"><span>485855931</span></a><span>] High CVE-2026-121107: Incorrect authorization in BackgroundFetch. </span><span>Reported by Johan Carlsson on 2026-02-19</span><b><br></b><span>[$2,000][</span><a href=\"https://issues.chromium.org/issues/566398391\"><span>566398391</span></a><span>] High CVE-2026-121197: Out of bounds read in ANGLE. </span><span>Reported by Arni Hardarson (Neonix Security) on 2026-09-26</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/40063728\"><span>40063728</span></a><span>] High CVE-2026-121112: Out of bounds read in Permissions. </span><span>Reported by koocola(@alo_cook) and Guang Gong of 360 Vulnerability Research Institute on 2023-03-22</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/496008447\"><span>496008447</span></a><span>] High CVE-2026-121174: Missing authorization in BackgroundFetch. </span><span>Reported by Google on 2026-03-25</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/516958782\"><span>516958782</span></a><span>] High CVE-2026-121098: Improper state validation in GPU. </span><span>Reported by Google on 2026-05-27</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/536617330\"><span>536617330</span></a><span>] High CVE-2026-121074: Memory corruption in GPU. </span><span>Reported by Google on 2026-07-19</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/550489336\"><span>550489336</span></a><span>] High CVE-2026-121173: Uninitialized resource in WebGL. </span><span>Reported by Google on 2026-08-21</span><b><br></b><span>[TBD][</span><a href=\"https://issues.chromium.org/issues/552757015\"><span>552757015</span></a><span>] High CVE-2026-121233: Type confusion in CacheStorage. </span><span>Reported by Salvatore Gulizia (Serotav) on 2026-08-26</span><b><br></b><span>[TBD][</span><a href=\"https://issues.chromium.org/issues/557605839\"><span>557605839</span></a><span>] High CVE-2026-121140: Out of bounds read in Internals. </span><span>Reported by Popax21 on 2026-09-06</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/558111285\"><span>558111285</span></a><span>] High CVE-2026-121095: Uninitialized resource in WebGL. </span><span>Reported by Google on 2026-09-07</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/561994040\"><span>561994040</span></a><span>] High CVE-2026-121071: Incorrect authorization in FileSystem. </span><span>Reported by Google on 2026-09-15</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/563359278\"><span>563359278</span></a><span>] High CVE-2026-121207: Uninitialized resource in Dawn. </span><span>Reported by Google on 2026-09-18</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/565681453\"><span>565681453</span></a><span>] High CVE-2026-121185: Use after free in PictureInPicture. </span><span>Reported by Xinyang Ge (Anthropic), assisted by Claude on 2026-09-24</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/566111382\"><span>566111382</span></a><span>] High CVE-2026-121166: Type confusion in PDFium. </span><span>Reported by OpenAI Codex Security (amyb) on 2026-09-25</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/566251701\"><span>566251701</span></a><span>] High CVE-2026-121047: Buffer overflow in Media. </span><span>Reported by OpenAI Codex Security (amyb) on 2026-09-25</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/566313798\"><span>566313798</span></a><span>] High CVE-2026-121124: Improper adherence to coding standards in XML. </span><span>Reported by Google on 2026-09-25</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/566377255\"><span>566377255</span></a><span>] High CVE-2026-121118: Use after free in SVG. </span><span>Reported by Xinyang Ge (Anthropic), assisted by Claude on 2026-09-26</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/566506819\"><span>566506819</span></a><span>] High CVE-2026-121188: Use after free in PerformanceAPIs. </span><span>Reported by Xinyang Ge (Anthropic), assisted by Claude on 2026-09-26</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/567106301\"><span>567106301</span></a><span>] High CVE-2026-121113: Buffer overflow in PDFium. </span><span>Reported by Xinyang Ge (Anthropic), assisted by Claude on 2026-09-28</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/567222737\"><span>567222737</span></a><span>] High CVE-2026-121082: Type confusion in V8. </span><span>Reported by OpenAI Codex Security (amyb) on 2026-09-28</span><b><br></b><span>[TBD][</span><a href=\"https://issues.chromium.org/issues/567321055\"><span>567321055</span></a><span>] High CVE-2026-121083: Use after free in Compositing. </span><span>Reported by Hafiizh on 2026-09-29</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/567936263\"><span>567936263</span></a><span>] High CVE-2026-121179: Use after free in PDFium. </span><span>Reported by Xinyang Ge (Anthropic), assisted by Claude on 2026-09-30</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/567936265\"><span>567936265</span></a><span>] High CVE-2026-121180: Buffer overflow in Media. </span><span>Reported by Xinyang Ge (Anthropic), assisted by Claude on 2026-09-30</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/567936269\"><span>567936269</span></a><span>] High CVE-2026-121181: Use after free in Editing. </span><span>Reported by Xinyang Ge (Anthropic), assisted by Claude on 2026-09-30</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/568794851\"><span>568794851</span></a><span>] High CVE-2026-121228: Type confusion in V8. </span><span>Reported by Xinyang Ge on 2026-10-02</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/568818122\"><span>568818122</span></a><span>] High CVE-2026-121080: Use after free in Codecs. </span><span>Reported by Xinyang Ge on 2026-10-02</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/568832157\"><span>568832157</span></a><span>] High CVE-2026-121044: Use after free in Layout. </span><span>Reported by Xinyang Ge on 2026-10-02</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/568901837\"><span>568901837</span></a><span>] High CVE-2026-121051: UI misrepresentation in iOSWeb. </span><span>Reported by Google on 2026-10-02</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/568903801\"><span>568903801</span></a><span>] High CVE-2026-121038: Information leak in Compositing. </span><span>Reported by Google on 2026-10-02</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/568936993\"><span>568936993</span></a><span>] High CVE-2026-121090: Improper privilege management in Navigation. </span><span>Reported by Google on 2026-10-03</span><b><br></b><span>[TBD][</span><a href=\"https://issues.chromium.org/issues/569129173\"><span>569129173</span></a><span>] High CVE-2026-121052: Use after free in GPU. </span><span>Reported by Team Allied (nag0x, h4nk3r1n, h4vrut4, HunSec, Hyeongeun Ji ) on 2026-10-04</span><b><br></b><span>[TBD][</span><a href=\"https://issues.chromium.org/issues/569415790\"><span>569415790</span></a><span>] High CVE-2026-121037: Out of bounds write in ANGLE. </span><span>Reported by Akshay Sharma - anonymous_blackzero on 2026-10-04</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/569674218\"><span>569674218</span></a><span>] High CVE-2026-121086: Buffer overflow in Skia. </span><span>Reported by Xinyang Ge on 2026-10-05</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/570026889\"><span>570026889</span></a><span>] High CVE-2026-121131: Use after free in Mobile. </span><span>Reported by Google on 2026-10-05</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/570028521\"><span>570028521</span></a><span>] High CVE-2026-121087: Improper input validation in Mobile. </span><span>Reported by Google on 2026-10-05</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/570029317\"><span>570029317</span></a><span>] High CVE-2026-121178: Use after free in Aura. </span><span>Reported by Google on 2026-10-05</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/570796613\"><span>570796613</span></a><span>] High CVE-2026-121100: Use after free in DOM. </span><span>Reported by Xinyang Ge on 2026-10-07</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/571059182\"><span>571059182</span></a><span>] High CVE-2026-121148: Use after free in ANGLE. </span><span>Reported by xinyang on 2026-10-07</span><b><br></b><span>[TBD][</span><a href=\"https://issues.chromium.org/issues/571648522\"><span>571648522</span></a><span>] High CVE-2026-121089: Use after free in WebGPU. </span><span>Reported by apalov on 2026-10-09</span><b><br></b><span>[TBD][</span><a href=\"https://issues.chromium.org/issues/572991399\"><span>572991399</span></a><span>] High CVE-2026-121250: Use after free in Extensions. </span><span>Reported by Daisuke Hatakeyama and Keita Sode (SYZD Research) on 2026-10-13</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/573263908\"><span>573263908</span></a><span>] High CVE-2026-121032: Out of bounds read in Skia. </span><span>Reported by Google on 2026-10-13</span><b><br></b><span>[TBD][</span><a href=\"https://issues.chromium.org/issues/573387527\"><span>573387527</span></a><span>] High CVE-2026-121114: Use after free in TabStrip. </span><span>Reported by malichamdan on 2026-10-14</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/573836121\"><span>573836121</span></a><span>] High CVE-2026-121127: Use after free in WebAudio. </span><span>Reported by kylebot on 2026-10-15</span><b><br></b><span>[TBD][</span><a href=\"https://issues.chromium.org/issues/574021176\"><span>574021176</span></a><span>] High CVE-2026-121210: Type confusion in V8. </span><span>Reported by zenneth (randomguy6407) on 2026-10-15</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/574038247\"><span>574038247</span></a><span>] High CVE-2026-121057: Type confusion in V8. </span><span>Reported by OpenAI Codex Security (kylebot) on 2026-10-15</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/574193110\"><span>574193110</span></a><span>] High CVE-2026-121201: Use after free in Animation. </span><span>Reported by Xinyang Ge (Anthropic), assisted by Claude on 2026-10-16</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/574214629\"><span>574214629</span></a><span>] High CVE-2026-121084: Out of bounds read in Skia. </span><span>Reported by Google on 2026-10-16</span><b><br></b><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/574339635\"><span>574339635</span></a><span>] High CVE-2026-121094: Type confusion in V8. </span><span>Reported by Vlad Stolyarov (