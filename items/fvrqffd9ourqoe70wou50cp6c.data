[{"_1":2,"_3":4},"root",{"_5":108},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795912837000,"id","fvrqffd9ourqoe70wou50cp6c","title","意大利伪造政府应用利用 Morpheus 间谍软件监控寻求庇护者","originalTitle","Fake Government App Exposes Italy’s Expanding Spyware Surveillance Industry","summary","IrpiMedia 调查称，意大利内政部标识的 Android 应用 FirmaDigitale 伪装成庇护者保护状态通知，实际投递 Morpheus 间谍软件。","reason","调查将伪装政府应用与 Morpheus 间谍软件关联起来，并披露意大利监控工具供应商、授权范围和审查薄弱等背景。","source",{"_76":107},"links",{"_99":106},"publishedAt","2026-11-28T00:08:30.000Z","discoveredAt","2026-11-28T01:17:29.714Z","timelineAt","category","activity","tags",[79,77,103,104,87,105],"score",70,"selected",true,"channel","news","story",{"_89":90,"_13":91},"x","readingMode","full","author","Pierluigi Paganini","body",{"_61":98,"_99":-5,"_100":101,"_102":37},"outline",[92],"relatedStories",[88],"topics",[68,69,70,71,72,73],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","f4W3CnBicxE4","reportCount",1,"additionalSourceCount",0,{"_74":86,"_76":87},{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","malware","name","恶意软件","attack","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","email","邮件与钓鱼","mobile","移动端",{"_89":90,"_13":91},"publicId","c704ff3b-12a7-4d08-9e15-5406b5d6b227","意大利假政府应用投递Morpheus间谍软件",{"_11":93,"_94":95,"_96":97},"sec-1","text","一款伪造的意大利内政部应用利用 Morpheus 间谍软件 targeting 意大利的寻求庇护者，引发了关于监控与监督的疑问。","level",2,"<h2 id=\"sec-1\">一款伪造的意大利内政部应用利用 Morpheus 间谍软件 targeting 意大利的寻求庇护者，引发了关于监控与监督的疑问。</h2><p>一款名为 FirmaDigitale 的 Android 应用曾承诺向寻求庇护者提供其保护状态的消息，实际上却在投递间谍软件。</p><p>Rosita Rijtano 进行的 <a href=\"https://www.irpimedia.eu/spyware-falsa-app-del-viminale-prendeva-di-mira-richiedenti-asilo/\">IrpiMedia 调查</a>建立在 Lookout 2024 年的发现之上，并将该恶意软件归因于 IPS——一家为检察官、警察和情报机构供货的拉齐奥(latina)地区公司。没人知道是谁下令执行了这次行动，也不知道受害者是谁。</p><p>受害者从一个仿冒意大利主要邮政服务提供商 Poste Italiane 网站的页面 firmadigitale.assistenza-mobile[.]it 下载了该应用。该应用显示了内政部的标志，并提到一项保护法令。警方否认与其有任何关联，Poste 也未置评。</p><p>这款间谍软件能够添加组件以使用麦克风、拦截网络通话、录屏和追踪手机。它还可以访问联系人、通话记录、文件和短信。该网站自 2025 年起已无法访问，但该应用仍可能在其他地方流传。</p><p>Osservatorio Nessuno 在 2026 年 4 月发现一款伪造的 Fastweb 应用中存在该间谍软件，并将其命名为 Morpheus。攻击者还滥用了 TIM、Iliad、PosteMobile 和 WindTre 等品牌，而 Iliad 表示并不知情此类应用。Morpheus 甚至可以通过伪造的生物识别提示劫持 WhatsApp。</p><p><em>“我们面对的又一个例子，是低成本间谍软件利用漏洞和苦难，攻击每个人最私密的权利之一：我们日常用于一切活动与通信的设备的隐私，”<a href=\"https://www.irpimedia.eu/spyware-falsa-app-del-viminale-prendeva-di-mira-richiedenti-asilo/\">Osservatorio Nessuno 的发言人说</a>。该组织是一个研究数字监控技术、并为记者和活动人士提供技术援助的志愿者组织。</em></p><p><em>“本案尤其残酷，因为它利用了——从一种处于绝对权力地位的角度——本身就充满歧视性与敌意的系统，专门针对移民。责任涉及多个方面：从意大利或欧洲在应对此类公司泛滥方面完全缺乏监管，到对此类行动完全缺乏透明度与约束——包括伦理层面的约束。”</em></p><p>Citizen Lab 的 Kristina Balaam（此前任职于 Lookout）表示，社会工程手段让这类工具比零点击间谍软件更便宜，且依然有效。当一个令人信服的表单就足够时，何必耗费一个稀缺的漏洞利用呢？</p><p>Osservatorio Nessuno 将此归咎于意大利和欧洲相关规则的薄弱、不透明以及缺失的伦理限制。公民自由联盟 Cild 希望了解当局为何会将寻求庇护者作为目标、此次行动由谁授权，以及产出了什么。</p><p>IPS 的“朋友圈”很广，包括 RCS、Area、SIO 和 Innova。九家成熟企业报告其 2024 年来自监控与情报工具的收入为 2.144 亿欧元。在披露地域信息的五家企业中，意大利贡献了 72.8% 的收入。</p><p>间谍软件目标数量从 2021 年的 2,894 起上升至 2025 年的 5,611，增幅约 94%。去年黑手党案件占 2,930 起，普通犯罪占 2,618 起，恐怖主义占 63 起。德国在 2024 年授权了 91 次间谍软件行动，并执行了 57 次。</p><p>意大利法律允许在远超黑手党和恐怖主义案件的场景中使用间谍软件，包括腐败和许多普通犯罪。辩护律师 Eugenio Losco 警告称，刑事结伙指控打开了方便之门，即便针对的是工会成员和活动人士。尽管存在旨在降低成本的全国价格清单，拦截支出在 2025 年仍达到约 2.99 亿欧元。</p><p>管控措施仍很薄弱。意大利此前没有进行质量检查，而当局也缺乏验证该软件的技能。在 eSurv 案中，一家公司将拦截数据保存在自己的服务器上，审判仍在继续。</p><p>检察官协会副主席 Marcello De Chiara 称间谍软件不可或缺，而目前针对其使用的保障措施已经足够。他希望对私营供应商实行更严格的规定，包括设立全国性登记表并明确所有权。</p><p>担忧并不仅限于这款应用。一名研究人员表示，最近至少有五名活动人士收到了间谍软件链接，而 Sea-Watch 的 Giorgia Linardi <a href=\"https://sea-watch.org/en/spyware-attack-on-sea-watch-spokesperson/\">曾报告过</a>2021 年的零点击监控。IrpiMedia 没有将这两起案件与 FirmaDigitale 联系起来。</p><p>律师 Giovanni Battista Gallus 表示，意大利缺乏一部完整限制间谍软件行为的法律。收集到的数据可以继续存档，而当调查被搁置时，当局也无须通知目标对象。IrpiMedia 用一句话概括了这一结果，即目标对象可能永远不会发现真相：</p><p><em>“那些遭到间谍监视的人甚至可能永远不会发现。事实上，一旦调查结束，并无义务通知个人其曾遭受监控。”Gallus 总结道，“此外，尽管监控工具必须在行动结束时停用，但收集的材料不会自动删除；相反，它可能仍存储在检察机关的档案中。”</em></p><p><strong>在 Twitter 上关注我：&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;和&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;和&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a><strong></strong></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;黑客、&nbsp;Morpheus 间谍软件)</strong></p>","original","zhKind","translation","complete","后门","数据窃取","钓鱼","https://securityaffairs.com/204142/intelligence/fake-government-app-exposes-italys-expanding-spyware-surveillance-industry.html","Security Affairs",{"_109":110,"_111":-5},"changelogVersion","2026-10-01T08:00","release"]
