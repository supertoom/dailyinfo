[{"_1":2,"_3":4},"root",{"_5":100},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1793621624000,"id","bpiqxf94ntro5f8r9v5jsyozy","title","DeepSeek 开源 Super-Agent 编码代理 dsh-superagent，可监控团队聊天并处理 GitHub 任务","originalTitle","DeepSeek open-sources Super-Agent, a coding agent that watches team chats for work","summary","DeepSeek 在 GitHub 免费开源研究原型 dsh-superagent，可根据授权用户请求或团队规则在 GitHub 仓库执行编码任务，也支持在聊天或 GitHub 范围内通过提及代理发起请求。","reason","source",{"_73":99},"links",{"_61":98},"publishedAt","2026-11-02T07:09:55.000Z","discoveredAt","2026-11-02T07:40:32.083Z","timelineAt","category","ai-security","tags",[75,95,96,97],"score",44,"selected",false,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","Anamarija Pogorelec","body",{"_91":-5,"_61":92,"_93":-5,"_94":36},"outline",[82,83],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","f_kfklPWQKpU","reportCount",1,"additionalSourceCount",0,{"_71":76,"_73":77},{"_71":30,"_73":75},{"_71":72,"_73":74},"slug","tools","name","工具与平台","AI 安全","ai-offense","AI 攻防",{"_79":80,"_13":81},"publicId","5d5d8734-2cb6-43bd-8edc-bfd7ea385577","DeepSeek 开源 dsh-superagent 编码代理",{"_11":89,"_85":90,"_87":88},{"_11":84,"_85":86,"_87":88},"sec-2","text","Merging","level",3,"sec-1","Who can ask for work","zh","<p>Deepseek released a research prototype of dsh-superagent, a coding agent that does work on a GitHub repository for you.</p><p><img src=\"/dailyinfo/media/58091866c08589bc.webp\" loading=\"lazy\" decoding=\"async\" alt=\"dsh-superagent\" title=\"Deepseek\"></p><h3 id=\"sec-1\">Who can ask for work</h3><p>The agent gets to work in two situations: an allowed user asks for something, or a rule your team wrote covers it. You can also open up a chat or GitHub scope, and then anyone in it can request work just by mentioning the agent. A message, comment or quoted document can’t expand what the agent is allowed to do, since the host is the one enforcing the lists and rules.</p><p>By default, requests that aren’t explicit, such as an unaddressed message, a bot’s message or an unlisted person’s follow-up, are assessed and recorded as ones the agent would have accepted, but none is accepted. Explicit requests, such as an allowed user mentioning the agent, work in every mode. The advice is to switch to auto after you’ve reviewed those records.</p><h3 id=\"sec-2\">Merging</h3><p>A prompt called Delivery requirements controls auto-merge, and the host adds no merge logic of its own. By default the agent doesn’t turn on auto-merge under its own account, because GitHub credits the merge to whoever enabled it. Unless the prompt names another account for merging, people merge.</p><p>dsh-superagent is available for free on <a href=\"https://github.com/deepseek-ai/dsh-superagent-prototype/\">GitHub</a>.</p><p><img src=\"/dailyinfo/media/1a550cf184e809a0.gif\" loading=\"lazy\" decoding=\"async\"></p><p><strong>Must read:</strong></p><ul>\n<li><a href=\"https://www.helpnetsecurity.com/2026/07/08/20-latest-open-source-cybersecurity-tools/\">20 open-source cybersecurity tools to keep your team ready for anything</a></li>\n<li><a href=\"https://www.helpnetsecurity.com/2025/01/13/alexis-wales-github-ciso-security-strategy/\">GitHub CISO on security strategy and collaborating with the open-source community</a></li>\n</ul><p><img src=\"/dailyinfo/media/93223e2e45672130.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong>Subscribe to the Help Net Security ad-free monthly newsletter to stay informed on the essential open-source cybersecurity tools. <a href=\"https://www.helpnetsecurity.com/newsletter/\">Subscribe here!</a></strong></p><p><img src=\"/dailyinfo/media/93223e2e45672130.webp\" loading=\"lazy\" decoding=\"async\"></p>","zhKind","complete","Agent 安全","工具发布","AI 编码","https://www.helpnetsecurity.com/2026/11/02/deepseek-dsh-superagent/","Help Net Security",{"_101":102,"_103":-5},"changelogVersion","2026-10-01T08:00","release"]
