[{"_1":2,"_3":4},"root",{"_5":88},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":-5,"_56":57,"_58":59},"expiresAt",1794357643000,"id","vfjzof1znh41318lorrvydjkt","title","Mandiant 披露大模型劫持黑产，企业单日损失或超 10 万美元","originalTitle","AI访问权限遭盗用，多家企业损失近千万元","summary","Mandiant 报告称，攻击者通过盗取企业的大模型 API 密钥或劫持访问权限盗用算力，单个受害企业每日损失可能超过 10 万美元，部分企业累计损失达 100 万美元。","reason","报告披露了 AI 密钥盗用、订阅篡改和 API 调用的变现链路，并给出集中密钥管理、最小权限等可迁移的防护思路。","source",{"_67":87},"links",{"_78":86},"publishedAt","2026-11-04T09:37:27.530Z","discoveredAt","2026-11-04T10:32:27.536Z","timelineAt","category","activity","tags",[70,81,68,82,83,76,84,85],"score",81,"selected",true,"channel","news","story","x","readingMode","full","author","body",{"_59":77,"_78":-5,"_79":78,"_80":37},"outline",[],"relatedStories",[],"topics",[60,61,62,63,64],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","zh",{"_65":75,"_67":76},{"_65":73,"_67":74},{"_65":71,"_67":72},{"_65":69,"_67":70},{"_65":66,"_67":68},"slug","ai-security","name","AI 安全","attack","攻击活动","ai-agent","AI Agent 安全","black-market","数据窃取与黑产","identity","身份与访问","<p>\n                    谷歌Mandiant团队发布报告披露，大模型劫持攻击日渐增多，有受害企业每日损失10万美元，累计损失逾百万美元；前几天谷歌旗下Wiz公司也发文称，近一个月来AI密钥盗用攻击猖獗，已发生9起AI服务明星平台失陷事件，如Railway、OpenCode、Warp等；用户应积极关注相关新闻和采购订阅账单，避免滥用损失。\n                </p><p>前情回顾·AI服务频遭攻击</p><ul><li><p><a href=\"https://www.secrss.com/articles/95274\">又一知名AI应用平台被黑，警告所有用户更换托管密钥</a></p></li><li><p><a href=\"https://www.secrss.com/articles/95054\">知名AI开发平台发生数据泄露，呼吁所有用户更换托管密钥</a></p></li><li><p><a href=\"https://www.secrss.com/articles/92621\">OpenAI失控模型在互联网上“游荡”了4天，并袭击了另一家AI公司</a></p></li><li><p><a href=\"https://www.secrss.com/articles/91565\">一家AI公司被黑后，九家网络安全公司发生数据泄露</a></p></li></ul><p>安全内参11月4日消息，网络犯罪分子通过劫持企业的大模型访问权限，盗用高成本算力资源和AI服务。受害企业因此蒙受巨额损失，相关Token费用甚至高达数百万美元。</p><p>谷歌旗下Mandiant事件响应团队周一发布报告称，犯罪分子滥用企业资源，每天造成的费用可能超过10万美元。部分受害企业在撤销攻击者的访问权限之前，累计损失已达100万美元。</p><p>谷歌威胁情报部门（GTIG）首席分析师John Hultquist表示：“只要有机会，威胁行为者就会利用这项技术，让自己在攻击规模上压过防御方。为此，他们借助智能体工具，偷偷窃取第三方的Token。加强对这些资源的管控，不仅能防止企业成本失控，也有助于保护整个网络生态，避免低成本自动化攻击大量出现。”</p><p><strong>大模型劫持攻击活动日渐增多</strong></p><p>这种通过劫持大模型访问权限牟利的手法被称为大模型劫持（LLMJacking），过去两年来呈持续增长趋势。CrowdStrike在今年8月发布报告披露了一起极端案例，一名Token窃取者在短短两分钟内发起约20万次API请求。</p><p><img src=\"/dailyinfo/media/22c27900ca7c503b.webp\" loading=\"lazy\" decoding=\"async\"></p><p>图：大模型劫持攻击导致API调用激增</p><p>谷歌报告披露的一起事件显示，一个被谷歌追踪为UNC6993的犯罪团伙非法获取了大模型API密钥，随后生成更多密钥，并在受害者的云项目中启用相关服务，最终造成10万美元的损失。</p><p>谷歌威胁情报团队还发现，另一起Token盗窃事件中，攻击者擅自将受害者的账号订阅为按需付费（Pay-As-You-Go）套餐，自己调用高级模型，却让受害企业承担费用。</p><p>攻击者选择高端基础模型，发起大规模推理请求，并采用所谓的“消耗后轮换”策略绕过速率限制：不断创建和删除短期服务账号，同时监控账单页面，掌握资源使用情况和造成的经济损失。</p><p>谷歌这份报告还披露了另一起事件。一名攻击者利用窃取的第三方API密钥，在不到8小时内发起超过50万次大模型API调用，为一项名为Jet Night的Token转发服务提供算力支持。</p><p>报告指出：“鉴于Jet Night向用户收取的Token费用远低于通常的市场价格，谷歌威胁情报团队认为，该服务很可能依靠被盗密钥维持盈利。例如，Jet Night推出了每月约60美元的无限Token套餐，并声称可访问前沿模型。而同等服务面向消费者的正常市场价格通常为每月100至250美元。”</p><p><img src=\"/dailyinfo/media/595950b7076c83e6.webp\" loading=\"lazy\" decoding=\"async\"></p><p>图：Jet Night套餐及定价截图</p><p>Jet Night还曾在其公开Telegram频道承认服务多次中断。谷歌威胁狩猎人员指出，这些故障很可能是因为受害者发现账号遭到入侵后撤回了被盗密钥，导致服务无法正常运行。</p><p><strong>大模型劫持地下产业已出现专业化分工</strong></p><p>随着越来越多的犯罪分子加入大模型劫持黑产，谷歌发现，相关犯罪活动已形成明确的分工：一部分攻击者负责入侵云服务和AI服务，获取初始访问权限；另一部分则负责运营后续变现基础设施，业内将这类服务称为大模型混币服务（LLM Mixers）。</p><p>在Mandiant于2026年中期参与调查的一起事件里，UNC6993利用配置错误的服务账号密钥入侵云实例，并借此进一步获取模型API的访问权限。</p><p>攻击者还搭建了一个会话劫持网页，伪装成大模型用户社群的申请入口。报告称：“该网页诱骗用户跳转至合法的大模型服务网站，并粘贴包含有效访问Token的原始JSON载荷。随后，这些数据被提交至后端API，绕过密码验证和多因素身份验证（MFA）等安全控制。”</p><p>谷歌预测，与加密货币挖矿劫持等其他资源盗窃方式相比，网络犯罪分子未来会越来越多地以劫持大模型为主要目标。</p><p>为防止云端大模型服务遭到滥用，谷歌建议防御方重点加强身份与访问管理以及供应链安全，并采用集中式密钥管理平台，定期轮换密钥及其他机密信息。</p><p>此外，企业应遵循最小权限原则，对用户和服务账号实施严格的权限控制，确保它们只拥有完成工作所必需的权限。同时，应在代码库中自动扫描机密信息，及时发现并清除被写入源代码的API密钥及其他敏感信息。</p><p><strong>参考资料：bleepingcomputer.com</strong></p><p>声明：本文来自安全内参，版权归作者所有。文章内容仅代表作者独立观点，不代表安全内参立场，转载目的在于传递更多信息。如有侵权，请联系 anquanneican@163.com。</p>","original","zhKind","complete","黑产","大模型","凭据","Google","CrowdStrike","https://www.secrss.com/articles/95358","安全内参",{"_89":90,"_91":-5},"changelogVersion","2026-10-01T08:00","release"]
