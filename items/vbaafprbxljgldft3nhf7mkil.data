[{"_1":2,"_3":4},"root",{"_5":91},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1795912850000,"id","vbaafprbxljgldft3nhf7mkil","title","PRISM 2027 攻击溯源与智能安全推理研讨会征稿通知，2027年1月8日截稿","originalTitle","PRISM 2027 征稿通知 | 第二届攻击溯源与智能安全推理研讨会","summary","PRISM 2027（攻击溯源与智能安全推理研讨会）将于2027年3月22日在韩国首尔 Grand InterContinental Seoul Parnas 酒店举办，与 NDSS 2027 同期，接收正式论文、Work-in-Progress 论文及 Tutorial/Demo 投稿。","reason","source",{"_71":90},"links",{"_82":89},"publishedAt","2026-11-28T01:30:00.000Z","discoveredAt","2026-11-28T23:33:36.822Z","timelineAt","category","policy","tags",[85,86,74,87,88],"score",6,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body",{"_60":81,"_82":-5,"_83":82,"_84":55},"outline",[],"relatedStories",[77],"topics",[67,68,69],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","fwzm0Un6b_2E","reportCount",1,"additionalSourceCount",0,{"_70":75,"_71":76},{"_70":73,"_71":74},{"_70":30,"_71":72},"slug","name","政策法规","ai-security","AI 安全","ai-agent","AI Agent 安全",{"_78":79,"_13":80},"publicId","685a5398-b1aa-43fa-8379-0b2fd9212098","PRISM 2027启动论文征稿","<p><span>G.O.S.S.I.P</span> <span>2026-11-28 09:30</span> <span>上海</span></p><p><img src=\"/dailyinfo/media/d4f3f56f5e8c914d.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>PRISM 2027 征稿通知 | 第二届攻击溯源与智能安全推理研讨会</p><p><img src=\"/dailyinfo/media/1a4ee2ecc15d5e90.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span>PRISM 2027: Workshop on Attack Provenance, Reasoning, and Investigation for Security in the Monitored Environment（攻击溯源与智能安全推理研讨会）</span><strong><span>将于 2027年3月22日 在韩国首尔 Grand InterContinental Seoul Parnas 酒店举行，与 NDSS 2027 同期举办</span></strong><span>。攻击溯源与智能安全推理（Attack Provenance, Reasoning, and Investigation）是近年来网络安全领域的前沿方向。本研讨会旨在探讨该领域面临的关键挑战，启发新的研究思路，并促进科研成果的落地与合作。我们接收正式论文（Regular paper），早期工作（Work-in-Progress Paper），系统演示与教程（Tutorial/Demo）。</span></p><p><span>我们关注的议题包括（但不限于）</span><br><span>• Provenance graphs and attack-path reconstruction</span><br><span>• Causal inference under partial or adversarial telemetry</span><br><span>• Graph learning, LLMs, and neuro-symbolic methods for detection and investigation</span><br><span>• Systems and infrastructure for provenance analytics (query, indexing, storage)</span><br><span>• Cross-domain and cross-layer correlation</span><br><span>• Investigation agents, analyst workflows, and human oversight</span><br><span>• Deployment in cloud, container, serverless, IoT, CPS, and OT environments</span><br><span>• Case studies in EDR, security operations, and incident response</span><br><span>• Log capture, integrity, compression, and reduction</span><br><span>• AI agent provenance across actions, tool calls, retrieval, and memory</span><br><span>• Investigation of prompt injection, tool abuse, and data exfiltration</span><br><span>• Real-time and cost-aware pipelines</span><br><span>• Explainability, uncertainty, and robustness to manipulated evidence</span><br><span>• Datasets, benchmarks, reproducible tooling, and evaluation methods</span><br><span>• Standards and interoperability (W3C PROV, OpenTelemetry, MITRE ATT&amp;CK)</span><br><span>• Privacy, governance, and compliance for provenance data</span></p><p><span>研讨会组织委员会：</span><br><span>• 程序委员会联合主席：Wajih Ul Hassan (University of Virginia)、Pubali Datta (UMass Amherst)</span><br><span>• 组织联合主席：Zhou Li (UC Irvine)、Z. Berkay Celik (Purdue University)</span><br><span>• 工业界主席：François Labrèche (Sophos)</span></p><p><span>✉️ 投稿入口：<a href=\"https://www.ndss-symposium.org/ndss2027/submissions/cfp-prism/\">https://www.ndss-symposium.org/ndss2027/submissions/cfp-prism/</a></span><br><span>📅 截稿日期：2027年1月8日（23:59 AOE）</span><br><span>📅 录用通知：2027年2月10日</span><br><span>📅 会议日期：2027年3月22日（周一）</span><br><span>🌴 期待在首尔与你相见！</span></p><p><img src=\"/dailyinfo/media/2cf53b8e48ba1ab3.webp\" loading=\"lazy\" decoding=\"async\"></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=10162623&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzg5ODUxMzg0Ng%3D%3D%26mid%3D2247502623%26idx%3D1%26sn%3Dcbd686bda81b05b88f129502a722e672\">跳转微信打开</a></p>","original","zhKind","complete","标准","治理","Agent 安全","大模型","https://mp.weixin.qq.com/s?__biz=Mzg5ODUxMzg0Ng==&mid=2247502623&idx=1&sn=cbd686bda81b05b88f129502a722e672","安全研究GoSSIP",{"_92":93,"_94":-5},"changelogVersion","2026-10-01T08:00","release"]
