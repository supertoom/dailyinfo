[{"_1":2,"_3":4},"root",{"_5":96},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794530489000,"id","oclbliy8sva9iub474xdrfw3d","title","NEAR AI 遭 SGLang RCE 利用，18 个 Agent 与约 100 名用户数据被窃","originalTitle","SGLang RCE Exploit Breaches NEAR AI, Steals Data From 18 Agents and About 100 Users","summary","攻击者利用开源推理引擎 SGLang 的远程代码执行漏洞，在 NEAR AI 推理服务器执行代码，并进入已弃用的 Private Chat 内部系统。公司确认约 100 名用户的邮箱、姓名及部分套餐和余额信息被下载，18 个旧版 NEAR AI Agents 的聊天记录、设置和日志遭窃，2 名客户的 NEAR AI Cloud API 密钥暴露。","reason","事件同时暴露出 TEE 内软件漏洞与外层部署隔离不足，账号、Agent 数据及 API 密钥的处置记录可供云服务复盘。","source",{"_74":95},"links",{"_87":94},"publishedAt","2026-11-10T19:19:39.000Z","discoveredAt","2026-11-10T19:33:35.684Z","timelineAt","category","activity","tags",[77,79,91,75,92,93],"score",80,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_61":86,"_87":-5,"_88":89,"_90":37},"outline",[],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","f6J6u5lwqWnA","reportCount",1,"additionalSourceCount",0,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","ai-security","name","AI 安全","attack","攻击活动","exploited","在野利用","ai-agent","AI Agent 安全",{"_83":84,"_13":85},"publicId","0a45d293-c1e6-4e8d-a642-8cf13f547597","SGLang RCE致NEAR AI数据失窃","<p><span><i></i><span>Swati Khandelwal</span><i></i><span>2026年11月10日</span></span><span>漏洞 / 云安全</span></p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEifQOwa1ngLZRATbbZyg_iud4SNx-9ugjo2iOG6crnJzatc_uS9FjGScBnNUy-uNIuOEE3Y6kJTpUVMVtOR1bW5sse_pRNJA1SQALCGjshDx6-CF1t8HXlUI2CCb6yp7Uepz6uk3ctMLUlSx4Q36Q7pZcx1nb9wPgbYAZqvd6CnSJ6WM6Kn_ZENtHpESoM/s1600/nearai.jpg\"><img alt=\"\" src=\"/dailyinfo/media/1c18bb2bc1771b8b.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>攻击者利用了开源推理引擎 <strong>SGLang</strong> 中的远程代码执行漏洞，并在上周日于 NEAR AI 的一台推理服务器上运行了代码。</p><p>该公司本周早些时候表示，攻击者还可能看到该服务器当天处理的请求，包括以机密模式发送的请求。该模式在可信执行环境（TEE）内处理请求，旨在确保请求即使对公司自身也保持私密。</p><p>但该公司表示，TEE“无法防止环境内运行的软件存在漏洞”。SGLang 在 TEE 内运行，因此攻击者得以访问其中的请求。</p><p>此后该访问权限已被关闭，但在此之前，攻击者已进一步侵入公司的系统。</p><p>攻击者进入了 Private Chat 后面的内部系统；该产品是公司此前已弃用的产品。迄今为止，公司已确认攻击者从那里下载了约 100 名用户的账户资料，包括电子邮件地址和姓名，部分账户还包含套餐和余额信息。</p><p>公司未发现存储的 Private Chat 对话或上传文件被访问的迹象。</p><p>攻击者还进入了旧版 NEAR AI Agents 部署中的 18 个 AI 代理；这些代理未在公司 TEE 内运行。攻击者从这些代理中获取了数据，包括聊天记录、设置和日志。</p><p>两名客户的 NEAR AI Cloud API 密钥在日志中暴露。公司已撤销这两个密钥。</p><p>据其<a href=\"https://near.ai/blog/security-incident-report-sglang-vulnerability\">事件报告</a>称，在检测到此次攻击后，公司撤销了所有活动会话和管理员凭据，更换了所有代理令牌，并使 Private Chat 下线。公司还在所有推理服务器上部署了 SGLang 漏洞修复程序，轮换了其余凭据，并完成了全面取证审查。</p><p>对其 NEAR AI Cloud 服务的访问已恢复。公司已向 SGLang 项目报告该漏洞。公司尚未确定该漏洞对应的 CVE 编号、指出受影响的 SGLang 版本，也未说明该项目是否已发布修复程序。</p><p>公司已联系其确认账户资料或代理遭到访问的用户。受影响用户直接从 security@near.ai 收到了适用于他们的相关步骤。作为预防措施，公司提醒用户谨慎对待任何并非由其主动发起的、涉及账户或余额的消息。</p><p>在昨天的<a href=\"https://x.com/near_ai/status/2120043366444601458\">后续帖子</a>中，公司表示，尚未收到其联系的用户无需采取任何措施。公司未说明上周日请求经过受影响服务器的人是否属于已联系的用户。</p><p>在 10 月 15 日的<a href=\"https://brave.com/blog/browser-ai-e2ee/\">技术报告</a>中，浏览器开发商 Brave 表示，其 Leo 助手使用 GLM 5.3 Flash 模型在 NEAR AI 运营的 TEE 内运行聊天。</p><p>NEAR AI 尚未说明受影响服务器是否处理过其中任何聊天。</p><p>觉得这篇文章有意思？欢迎在 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a> 上关注我们，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","漏洞利用","大模型","数据泄露","https://thehackernews.com/2026/11/sglang-rce-exploit-breaches-near-ai.html","The Hacker News",{"_97":98,"_99":-5},"changelogVersion","2026-10-01T08:00","release"]
