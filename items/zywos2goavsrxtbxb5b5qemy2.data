[{"_1":2,"_3":4},"root",{"_5":102},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794357647000,"id","zywos2goavsrxtbxb5b5qemy2","title","Xen Hypervisor 漏洞 CVE-2026-102703 和 CVE-2026-102704 可使恶意 VM 读写其他 VM 内存","originalTitle","Xen Hypervisor Flaws Let One Malicious VM Read and Write Any Other VM's Memory","summary","Xen Hypervisor 的 CVE-2026-102703 和 CVE-2026-102704 可使同一主机上的恶意虚拟机读写其他 VM 内存，包括拥有完整管理权限的 dom0；所有 4.6 及以上版本受影响，4.5 及更早版本不受影响，漏洞编号对应 XSA-523。","reason","原文说明漏洞源于内存权限检查复用，并列出各平台修复状态，可据此判断 Xen 部署的升级与重启需求。","source",{"_72":101},"links",{"_89":100},"publishedAt","2026-11-04T11:46:27.000Z","discoveredAt","2026-11-04T12:40:22.721Z","timelineAt","category","vuln","tags",[93,94,95,96,97,98,99],"score",77,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_61":88,"_89":-5,"_90":91,"_92":37},"outline",[82],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fBJvt4EL8iBc","reportCount",1,"additionalSourceCount",0,{"_71":76,"_72":77},{"_71":74,"_72":75},{"_71":31,"_72":73},"slug","name","漏洞披露","kernel","内核与系统","cloud-native","云与原生",{"_79":80,"_13":81},"publicId","c64f8c53-9457-48b2-b79f-d536f3a1967b","Xen虚拟机内存越界漏洞已修补",{"_11":83,"_84":85,"_86":87},"sec-1","text","按平台划分的修复与重启要求","level",3,"<p><span><i></i><span>Swati Khandelwal</span><i></i><span>2026年11月04日</span></span><span>漏洞 / 云安全</span></p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiAVPXiuTBfhBnpwaZHMfSDWymKJrXbS88kOEO1Xuh5t11qAnwSKeFTHGQy6ZG9Sr2N-wRYrJg58x3lKFbybvU9p1a85lxaCHfBa61vO1DfjEhUi5Yzf6bQS1eN7Mu-s_sUwkE-JGc-UznJ1p0qfmwMDusXFzWawXKXMt6jj-vENxyQG12uAUDUe0p0gtg/s1600/xen.jpg\"><img alt=\"\" src=\"/dailyinfo/media/6f825b22652aa3a0.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>Xen 虚拟机监控程序中的两个漏洞允许恶意客户机虚拟机（VM）读取和写入同一主机上其他 VM 的内存，包括 dom0。</p><p>dom0 默认拥有完整权限并管理其他 VM。Xen Project 在 11 月 3 日发布的<a href=\"https://xenbits.xen.org/xsa/advisory-523.html\">公告</a>中表示，补丁已经发布，目前没有已知的缓解措施。</p><p>所有 4.6 及更高版本的 Xen 都受到影响，而 4.5 及更早版本不受影响。这些漏洞分别跟踪为 <b>CVE-2026-102703</b> 和 <b>CVE-2026-102704</b>，对应 Xen 公告 XSA-523。</p><p>Xen Project 认可 AI 公司 <strong>Anthropic </strong>使用其 Claude 模型发现了这些漏洞。随后，Ada Logics 的 Stephan Lipp 验证了这一发现，之后 CodeAnt AI 安全研究团队又独立报告了同一问题。</p><p>这些漏洞存在于 grant copy 操作中，这是 Xen 用于在 VM 之间复制数据的操作。每个 VM 都会告知 Xen 其他 VM 可以使用其哪些内存页，而 Xen 会检查这些权限。</p><p>为节省在同一内存页内批量复制数据的时间，Xen 会复用已经完成的检查。在某些情况下，它没有在应该再次检查时进行复查。正是这一错误使恶意客户机能够读取和写入其并不拥有的内存。</p><p>围绕 Xen 构建的开源虚拟化平台 XCP-ng 在其<a href=\"https://xcp-ng.org/blog/2026/11/03/november-2026-security-and-maintenance-updates-1-for-xcp-ng-8-3-lts/\">更新说明</a>中表示，“单个受损客户机就能突破隔离并接管整个主机。”</p><p>Xen 的公告未提及利用这些漏洞的任何攻击，也未说明攻击者需要具备 VM 内的何种访问权限。</p><p>Qubes OS 是一款以安全为重点的桌面操作系统，它将软件置于基于 Xen 的独立隔离区中，称为 qubes。其<a href=\"https://www.qubes-os.org/news/2026/11/03/qsb-121/\">公告</a>称，所有受支持的发行版和配置均受到影响。修复版本针对 Qubes 4.3，即<a href=\"https://doc.qubes-os.org/en/latest/user/downloading-installing-upgrading/supported-releases.html\">其目前唯一仍受支持的发行版</a>。</p><p>由于所有 4.6 及更高版本的 Xen 都受到影响，基于这些版本构建的其他产品也会受到影响，直至其开发者加入 XSA-523 补丁。截至 11 月 4 日，Debian 的<a href=\"https://security-tracker.debian.org/tracker/CVE-2026-102703\">安全跟踪器</a>将 bookworm、trixie 和 forky 发行版中的 xen 软件包列为易受影响，而 sid 中的该软件包已列为已修复。</p><h3 id=\"sec-1\">按平台划分的修复与重启要求</h3><p>目前已发布的修复如下：</p><ul>\n  <li><strong>Xen 源码：</strong>&nbsp;公告提供了从 xen-unstable 到 Xen 4.19.x，以及 Xen 4.18.x 到 4.17.x 的补丁。</li>\n  <li><strong>Xen 4.6 至 4.16：</strong>&nbsp;公告没有为这些版本提供补丁。Xen 4.16 的<a href=\"https://github.com/xen-project/xen/blob/stable-4.16/SUPPORT.md\">安全支持已于 2024 年 12 月 2 日结束</a>。</li>\n  <li><strong>XCP-ng 8.3：</strong>&nbsp;xen-4.17.7-4.2.xcpng8.3，已于 11 月 3 日发布。主机必须重启。支持 XCP-ng 的 Vates 将<a href=\"https://docs.vates.tech/security-advisories/advisories/2026/vates-sa-2026-055/\">此影响评为严重</a>。</li>\n  <li><strong>Qubes OS 4.3：</strong>&nbsp;dom0 中的 Xen 软件包为 4.19.6-3。必须重启 dom0，Anti Evil Maid 用户还必须重新封装其秘密口令短语，因为新的 Xen 二进制文件会改变 PCR18 和 PCR19。</li>\n</ul><p>Qubes 于 11 月 3 日告知用户照常<a href=\"https://doc.qubes-os.org/en/latest/user/how-to-guides/how-to-update.html\">安装更新</a>。当时，修复软件包已位于其安全测试仓库中，计划在社区测试后的两周内转入稳定仓库。</p><p>XSA-523 与<a href=\"https://xenbits.xenproject.org/xsa/advisory-500.txt\">XSA-500</a>不同；后者是 Xen 于 7 月 28 日披露的早期 grant copy 漏洞，并有独立的补丁。</p><p>觉得这篇文章有意思吗？关注我们的 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a>，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","漏洞","补丁","漏洞利用","云原生","内核","Debian","Google","https://thehackernews.com/2026/11/xen-hypervisor-flaws-let-one-malicious.html","The Hacker News",{"_103":104,"_105":-5},"changelogVersion","2026-10-01T08:00","release"]
