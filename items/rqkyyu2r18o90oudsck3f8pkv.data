[{"_1":2,"_3":4},"root",{"_5":110},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":37,"_59":60},"expiresAt",1794530491000,"id","rqkyyu2r18o90oudsck3f8pkv","title","恶意 GitHub Actions workflow 入侵数万仓库并窃取凭据","originalTitle","New Supply Chain Attack Compromises Tens of Thousands of GitHub Repositories","summary","Socket 发现 GhostAction 变体通过 henrywoo、kitao 两个 GitHub 账号向有写权限的数百个仓库注入 .github/workflows/security-audit.yml，影响扩散至数万个人及组织仓库，包括 uber/athenadriver。","reason","文章还原了恶意 GitHub Actions workflow 的注入、凭据窃取和扩大影响路径，可用于理解供应链活动如何借助自动化流程长期潜伏。","source",{"_74":109},"links",{"_101":108},"publishedAt","2026-11-09T14:30:00.000Z","discoveredAt","2026-11-09T17:29:23.606Z","timelineAt","category","activity","tags",[75,105,106,107],"score",81,"selected",true,"channel","news","story",{"_85":86,"_13":87},"x","readingMode","full","author","body",{"_60":100,"_101":-5,"_102":103,"_104":37},"outline",[88,89,90],"relatedStories",[84],"topics",[67,68,69,70,71],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","faXC71wwfXvM","reportCount",1,"additionalSourceCount",0,{"_72":82,"_74":83},{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","attack","name","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","identity","身份与访问","supply-chain","供应链安全",{"_85":86,"_13":87},"publicId","eef5fa0f-85fb-426a-9eef-ca0690a15022","恶意GitHub工作流窃取仓库凭据",{"_11":98,"_92":99,"_94":95},{"_11":96,"_92":97,"_94":95},{"_11":91,"_92":93,"_94":95},"sec-3","text","恶意工作流仍在 GitHub 仓库中处于活跃状态","level",2,"sec-2","扩展 GhostAction 的机密窃取能力","sec-1","通过两个 GitHub 账户传播恶意工作流","<p>\n\tSocket 的安全研究人员发现了一起新的软件供应链攻击，影响了数万个 GitHub 仓库，其中包括由组织所有的仓库。</p><p>\n\tUber 被列为运行受损软件包的企业之一。<br>\n\t这条杀伤链让人联想到 <a href=\"https://www.infosecurity-magazine.com/news/ghostaction-supply-chain-3000/\">GhostAction</a>——这是 GitGuardian 于 <a href=\"https://blog.gitguardian.com/ghostaction-campaign-3-325-secrets-stolen/\">2025 年 9 月</a>发现的一场恶意活动，并于 <a href=\"https://blog.gitguardian.com/ghostaction-github-actions-supply-chain-attack-returns/\">2026 年 10 月</a>再次出现。</p><h2 id=\"sec-1\">\n\t<strong>通过两个 GitHub 账户传播恶意工作流</strong></h2><p>\n\t2026 年 10 月 8 日，两个 GitHub 账户“henrywoo”和“kitao”向数百个其有权修改的仓库推送了一个恶意 GitHub Actions 工作流。</p><p>\n\tGitHub Action 是一项自动化任务，在 GitHub 仓库中运行，用于处理测试代码、构建软件或部署应用程序等活动，每当下达特定事件发生时便会执行。</p><p>\n\t该工作流名为“.github/workflows/security-audit.yml”，通过一次单文件提交添加，提交信息被设计成看似例行操作：“添加安全审计工作流”和“更新安全审计工作流”。</p><p>\n\t尽管名称如此，该工作流并不执行任何安全检查。相反，它会从受影响的仓库中窃取凭据，并通过 HTTP 将其发送至外部服务器 193.32.204[.]199。</p><p>\n\t由于该工作流看起来像合法的安全工具，它可能在作为仓库自动化流程的一部分运行时 unnoticed，而未被发现。</p><p>\n\t据 Socket 研究人员称，这个恶意文件出现在数万个仓库中，其中包括“henrywoo”或“kitao”拥有写入权限的仓库。</p><p>\n\t感染载体包括以下仓库：</p><ul>\n\t<li>\n\thenrywoo/pyllama 和 henrywoo/chatllama，这两个 AI GitHub 项目由“henrywoo”创建</li>\n\t<li>\n\tkitao/pixel，通常通过 Python Pacjkage Index（PyPI）和 crates.io 分发；这些是在线仓库，开发人员分别在其中发布和分发使用 Python 与 Rust 编写的软件包</li>\n\t<li>\n\tuber/athenadriver，这是一个由 Uber 拥有的项目，“henrywoo”作为其原始作者拥有写入权限</li>\n</ul><p>\n\t即使是已停用十年的仓库也受到影响，这表明攻击者系统性地枚举了每个他们有权访问的仓库，而不是根据仓库的活跃程度或价值来选择目标。</p><p>\n\t这些活动似乎是自动化的，而非针对特定目标手动实施的。</p><h2 id=\"sec-2\">\n\t<strong>扩展 GhostAction 的机密窃取能力</strong></h2><p>\n\t尽管此次事件是 GhostAction 活动的新变体，但 Socket 研究人员<a href=\"https://socket.dev/blog/ghostaction-cloud-credentials\">指出</a>，最新版本扩展了攻击者能够窃取的内容。</p><p>\n\t早前的 GhostAction 攻击主要针对存储在 GitHub Actions 中的机密，例如为自动化工作流配置的 API 密钥和访问令牌。</p><p>\n\t新变体还会使用正则表达式模式，在仓库的文件和完整 Git 历史记录中搜索凭据。这意味着，即使敏感信息后来已从仓库的最新版本中删除，它仍可能找到开发者意外提交到源代码、配置文件或文件早期版本中的敏感信息。</p><p>\n\t额外的搜索目标包括云提供商和 AI 服务的凭据，这可能暴露对基础设施、托管应用程序和第三方服务的访问权限。</p><h2 id=\"sec-3\">\n\t<strong>恶意工作流仍在 GitHub 仓库中处于活跃状态</strong></h2><p>\n\t截至 2026 年 10 月 9 日，Socket 报告称，在其检查的存储库默认分支中，该恶意工作流仍然存在，其中包括 uber/athenadriver 和 kitao/pyxel。</p><p>\n\t该工作流还已在受影响的存储库中成功执行，这意味着窃取凭据的活动并非仅限于尝试注入。</p><p>\n\t然而，在 Socket 报告发布时，研究人员尚未发现此次活动导致任何恶意软件包版本被发布到 PyPI 或 crates.io。</p><p>\n\t这并不意味着被盗凭据未被用于其他用途，只是 Socket 尚未在这两个注册中心发现后续恶意软件包发布的证据。</p><p>\n\t<em>图片来源：&nbsp;Poetra.RH / PJ McDonnell / Shutterstock.com</em></p>","original","zhKind","translation","complete","供应链投毒","数据窃取","凭据","https://www.infosecurity-magazine.com/news/supply-chain-attack-thousands/","Infosecurity Magazine",{"_111":112,"_113":-5},"changelogVersion","2026-10-01T08:00","release"]
