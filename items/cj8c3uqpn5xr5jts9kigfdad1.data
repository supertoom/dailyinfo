[{"_1":2,"_3":4},"root",{"_5":93},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795912835000,"id","cj8c3uqpn5xr5jts9kigfdad1","title","帆软 FineReport FineVis（FVS）插件未授权远程代码执行漏洞 QVD-2026-115643 已复现","originalTitle","帆软FineReport FineVis（FVS）插件未授权远程代码执行漏洞安全风险通告","summary","帆软 FineReport FineVis（FVS）插件存在未授权远程代码执行漏洞 QVD-2026-115643，CVSS 3.1 评分为 9.8，奇安信 CERT 已成功复现。","reason","通告给出了利用链、受影响版本、资产规模及临时拦截接口，便于防守方快速判断暴露面并安排升级。","source",{"_73":92},"links",{"_83":91},"publishedAt","2026-11-24T07:56:46.422Z","discoveredAt","2026-11-24T10:56:46.440Z","timelineAt","category","vuln","tags",[86,87,88,89,90,77],"score",80,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","body",{"_61":82,"_83":-5,"_84":83,"_85":37},"outline",[],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fBKAM-kQgPCQ","reportCount",1,"additionalSourceCount",0,{"_71":76,"_73":77},{"_71":31,"_73":75},{"_71":72,"_73":74},"slug","research","name","技术研究","漏洞披露","qianxin","奇安信",{"_79":80,"_13":81},"publicId","7eac442c-0767-416d-96b5-432c2f408699","帆软FVS未授权RCE已复现并发布补丁","<table><tbody><tr><td colspan=\"4\"><p><strong>漏洞概述</strong></p></td></tr><tr><td><p><strong>漏洞名称</strong></p></td><td colspan=\"3\"><p>帆软 FineReport FineVis（FVS）插件未授权远程代码执行漏洞</p></td></tr><tr><td><p><strong>漏洞编号</strong></p></td><td colspan=\"3\"><p>QVD-2026-115643</p></td></tr><tr><td><p><strong><strong>公开时间</strong></strong></p></td><td><p>2026-11-21</p></td><td><p><strong><strong>使用量级</strong></strong></p></td><td><p>万级</p></td></tr><tr><td><p><strong>奇安信评级</strong></p></td><td><p><strong>高危</strong></p></td><td><p><strong>CVSS 3.1分数</strong></p></td><td><p><strong>9.8</strong></p></td></tr><tr><td><p><strong>威胁类型</strong></p></td><td><p>代码执行</p></td><td><p><strong>利用可能性</strong></p></td><td><p><strong><strong>高</strong></strong></p></td></tr><tr><td><p><strong>POC状态</strong></p></td><td><p><strong>未公开</strong></p></td><td><p><strong>在野利用状态</strong></p></td><td><p>未发现</p></td></tr><tr><td><p><strong>EXP状态</strong></p></td><td><p><strong>未公开</strong></p></td><td><p><strong>技术细节状态</strong></p></td><td><p><strong>未公开</strong></p></td></tr><tr><td colspan=\"4\"><p><strong>危害描述：</strong>攻击者可利用空模板路径绕过登录校验，未授权上传并应用恶意 FVS 复用包，向 WEB-INF 写入可执行内容，以应用进程权限执行任意系统命令，可能导致服务器被完全控制、报表业务数据与数据库连接凭据泄露，并可作为跳板进一步渗透内网。</p></td></tr></tbody></table><p><strong>0</strong><strong>1</strong></p><p><strong>漏洞详情</strong></p><p><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong></p><p><strong>影响组件</strong></p><p>帆软 FineReport 是企业级报表与数据决策平台，FineVis（FVS）是其可视化大屏插件，支持复用包（.mfvs，用于打包模板及其依赖资源）的在线导入与应用，常用于经营分析、指挥调度与数据看板，在金融、制造、政企等行业的报表系统中部署广泛。</p><p><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong></p><p><strong>漏洞描述</strong></p><p>近日，奇安信CERT监测到官方修复帆软 FineReport FineVis（FVS）插件未授权远程代码执行漏洞(QVD-2026-115643)，该漏洞源于 FVS 插件复用包导入与应用接口的模板鉴权缺陷：当请求携带的模板路径被归一化为空值时，相关请求被判定为“无需登录的模板访问”，从而绕过登录状态校验；攻击者无需任何账号或凭据，即可上传并应用构造的 .mfvs 复用包。在复用包应用阶段，导入组件未对附件写入位置实施业务白名单限制，可向应用 WEB-INF 目录写入可执行内容，容器检测到配置或类文件变更后重载，最终以应用进程权限执行任意系统命令。鉴于该漏洞影响范围较大，建议客户尽快做好自查及防护。</p><p><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong></p><p><strong>利用条件</strong></p><p>目标启用 FineVis（FVS）插件且服务网络可达，无需任何凭据。</p><p><strong>02</strong></p><p><strong>影响范围</strong></p><p><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong></p><p><strong>影响版本</strong></p><p>FineReport &lt; 11.5.16</p><p>FineVis（FVS）插件 &lt; 4.15.0</p><p><strong>03</strong></p><p><strong>复现情况</strong></p><p>目前，奇安信CERT已成功复现帆软 FineReport FineVis（FVS）插件未授权远程代码执行漏洞(QVD-2026-115643)，截图如下：</p><p><img src=\"/dailyinfo/media/aaf4734b3d95e561.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img src=\"/dailyinfo/media/5831e3682ff673ea.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong>04</strong></p><p><strong>受影响资产情况</strong></p><p>奇安信鹰图资产测绘平台数据显示，帆软 FineReport FineVis（FVS）插件未授权远程代码执行漏洞(QVD-2026-115643)关联的国内风险资产总数为26701个，关联IP总数为1152个。国内风险资产分布情况如下：</p><p><img src=\"/dailyinfo/media/405f2876537aef8a.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong>05</strong></p><p><strong>处置建议</strong></p><p><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong></p><p><strong>安全更新</strong></p><p>官方已发布安全补丁，请及时更新至最新版本：</p><p>FineReport &gt;= 11.5.16</p><p>FineVis（FVS）插件 &gt;= 4.15.0</p><p>升级步骤可参考官方产品安全加固指导手册：</p><p>https://help.fanruan.com/finereport/doc-view-4658.html</p><p>升级前建议与帆软技术支持确认版本适配关系，并在测试环境完成兼容性验证后再实施生产升级。</p><p>临时缓解措施：</p><p>无法立即升级时，可采取以下应急措施。相关措施均可能影响业务功能，升级完成后应及时移除：</p><p>1、通过反向代理、防火墙或 WAF 限制报表服务的访问来源，仅放行可信网络与必要运维地址；</p><p>2、对复用包导入、应用类请求（/decision/view/duchamp/reuse/item、/decision/view/duchamp/reuse/apply/*）实施拦截或额外的身份校验，并评估其对资源迁移等正常业务的影响；</p><p>3、不具备上述条件的实例，建议临时停止外网暴露，仅保留内网受控访问；</p><p>4、排查 WEB-INF 目录下的异常类文件、配置文件与日志文件，以及 webroot 下的异常回显文件。</p><p><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong></p><p><strong>产品解决方案</strong></p><p><strong>奇<strong>安信网神网络数据传感器系统产品检测方案</strong></strong></p><p>奇安信网神网络数据传感器（NDS5000/7000/9000系列）产品，已具备该漏洞的检测能力。规则ID为：8533，建议用户尽快升级检测规则库至2611241530或以上。</p><p><strong>奇安信天眼检测方案</strong></p><p>奇安信天眼新一代安全感知系统已经能够有效检测针对该漏洞的攻击，请将规则版本升级到3.0.1124.15190或以上版本。规则ID及规则名称：</p><p>0x10022B2F，帆软 FineReport FineVis（FVS）代码执行漏洞(QVD-2026-115643)。奇安信天眼流量探针规则升级方法：系统配置-&gt;设备升级-&gt;规则升级，选择“网络升级”或“本地升级”。</p><p><strong>奇安信自动化渗透测试系统检测方案</strong></p><p>奇安信自动化渗透测试系统已经能够有效检测针对该漏洞的攻击，请将插件版本和指纹版本升级到202611252329以上版本。规则名称：帆软 FineReport FineVis（FVS）插件未授权远程代码执行漏洞(QVD-2026-115643)。奇安信自动化渗透测试系统规则升级方法：系统管理-&gt;升级管理-&gt;插件升级（指纹升级），选择“网络升级”或“本地升级”。</p><p><strong>奇安信网站应用安全云防护系统已更新防护特征库</strong></p><p>奇安信网神网站应用安全云防护系统已全局更新所有云端防护节点的防护规则，支持对帆软 FineReport FineVis（FVS）插件未授权远程代码执行漏洞(QVD-2026-115643)的防护。</p><p><strong>06</strong></p><p><strong>参考资料</strong></p><p>[1]https://www.fanruan.com/</p><p>[2]https://help.fanruan.com/finereport/doc-view-4658.html</p><p>声明：本文来自奇安信 CERT，版权归作者所有。文章内容仅代表作者独立观点，不代表安全内参立场，转载目的在于传递更多信息。如有侵权，请联系 anquanneican@163.com。</p>","original","zhKind","complete","漏洞","复现","补丁","漏洞利用","漏洞分析","https://www.secrss.com/articles/95947","安全内参",{"_94":95,"_96":-5},"changelogVersion","2026-10-01T08:00","release"]
