[{"_1":2,"_3":4},"root",{"_5":100},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795912846000,"id","qisjy9p95panczoi5l58gkd5l","title","DLSS 5 Swapper 官网安装包被替换并投递信息窃取程序","originalTitle","【原创】面向游戏玩家的供应链攻击：DLSS 5 Swapper 官网安装包被替换","summary","DLSS 5 Swapper 官网分发的 v2.2.9 安装包被同名恶意文件替换，官网公布 SHA-256 为 e89fb5e59b4304e1fb2bccba7d24353ef83ea22b7b699c68a33828ae4420f735。","reason","文章还原了官网安装包被替换后的完整执行链、窃密能力与关键 IOC，可用于排查下载记录、落地文件和进程异常。","source",{"_76":99},"links",{"_93":98},"publishedAt","2026-11-25T04:06:00.000Z","discoveredAt","2026-11-25T10:12:35.951Z","timelineAt","category","activity","tags",[79,96,77,97,87],"score",71,"selected",true,"channel","news","story",{"_89":90,"_13":91},"x","readingMode","full","author","body",{"_61":92,"_93":-5,"_94":93,"_95":37},"outline",[],"relatedStories",[88],"topics",[68,69,70,71,72,73],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","frC0skOyEPLY","reportCount",1,"additionalSourceCount",0,{"_74":86,"_76":87},{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","malware","name","恶意软件","attack","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","supply-chain","供应链安全","qianxin","奇安信",{"_89":90,"_13":91},"publicId","145dbfd3-c8bd-4b54-a246-e7bb1b25d151","DLSS 5 Swapper安装包遭供应链替换","<p>原创 <span>红雨滴团队</span> <span>2026-11-25 12:06</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/8c226fea6e92f31b.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>官网页面保留正常安装包的 SHA-256 校验值，实际下发的同名文件却具有不同哈希，Electron 主程序入口已被替换为高度混淆的恶意 JavaScript</p><p><span><span>威胁情报 · 供应链攻击 · 游戏安全</span></span></p><p><span>面向游戏玩家的供应链攻击：</span><span><br></span><span>DLSS 5 Swapper 官网安装包被替换</span></p><p><span>官网页面保留正常安装包的 SHA-256 校验值，实际下发的同名文件却具有不同哈希，Electron 主程序入口已被替换为高度混淆的恶意 JavaScript</span></p><p><span>· DLSS 5 Swapper　· 供应链替换 · 信息窃取　· 2026.11.23</span></p><p><span>官网页面保留正常安装包的 SHA-256 校验值，实际下发的同名文件却具有不同哈希；用户看到的是正常文件名和校验值，拿到的却是被替换的安装包。官网分发入口由此成为恶意程序的投递渠道。</span></p><p><span><span>01</span></span><span><span>&nbsp;背景</span></span></p><p><span>DLSS 5 Swapper 是一款面向 Windows PC 游戏玩家的第三方工具，可扫描本地游戏，按游戏情况替换 DLSS 组件或安装相关模组，并提供备份、还原功能。其目标是改善兼容游戏的画面表现，实际效果取决于游戏、显卡和安装方案。</span></p><p><span>2026 年 11 月底，奇安信威胁情报中心红雨滴团队通过私有情报 AI 生产流程发现一起 DLSS 5 Swapper 官网安装包供应链替换事件：官网页面保留正常安装包的 SHA-256 校验值，</span><strong><span>实际下发的同名文件却具有不同哈希，</span></strong><span>且 Electron 主程序入口&nbsp;</span><span><span>app.asar/main.js</span></span><span>&nbsp;已被替换为高度混淆的恶意 JavaScript。</span></p><p><span>用户启动该应用后，恶意脚本按预设流程检查运行环境、请求管理员权限、添加 Windows Defender 排除项，随后解密内嵌数据，在本机释放并启动二级可执行文件。官网分发入口由此成为恶意程序的投递渠道。</span></p><p><strong><span>天擎“六合”高级威胁防御引擎已经可以对恶意更新包进行拦截：</span></strong></p><p><img src=\"/dailyinfo/media/ede363ee1764200c.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>图1｜天擎“六合”高级威胁防御引擎拦截恶意更新包告警</span></strong></p><p><img src=\"/dailyinfo/media/f5589c9a640edb21.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>图2｜DLSS 5 Swapper 官网安装包供应链替换与恶意代码执行流程</span></strong></p><p><span><span>02</span></span><span><span>&nbsp;官网安装包供应链入口</span></span></p><p><span>官网页面标注版本为 v2.2.9，安装包名为&nbsp;</span><span><span>DLSS5-Swapper-Setup-2.2.9.exe</span></span><span>，公布的 SHA-256 为&nbsp;</span><span><span>e89fb5e59b4304e1fb2bccba7d24353ef83ea22b7b699c68a33828ae4420f735</span></span><span>。这一数值也见于 v2.2.9 项目文件镜像的校验清单：</span><span><span><a href=\"https://sourceforge.net/projects/dlss-5-swapper.mirror/files/v2.2.9/\">https://sourceforge.net/projects/dlss-5-swapper.mirror/files/v2.2.9/</a></span></span><span>。</span></p><p><img src=\"/dailyinfo/media/d876193897617bf6.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>图3｜官网页面展示的版本、文件名及安装包校验值</span></strong></p><p><span>本次从官网下载的安装包 SHA-256 为&nbsp;</span><span><span>a473ba884eab3b951300358535cb44067299612b1d075a2de7aa3af19b01e544</span></span><span>，与页面公布值不符。</span><strong><span>校验值不匹配是此次供应链事件最直接的预警信号：</span></strong><span>用户看到的是正常文件名和校验值，拿到的却是被替换的安装包。</span></p><p><span>对比显示，正常安装包的&nbsp;</span><span><span>main.js</span></span><span>&nbsp;以游戏扫描与 DLSS 模组安装逻辑开头；被替换的安装包相同位置则出现字符串数组旋转、解码函数和大量混淆表达式。入口文件在应用启动时加载，使恶意逻辑能够借正常桌面程序的外观触发。</span></p><p><img src=\"/dailyinfo/media/64ae37dfc4cfdb2b.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>图4｜正常安装包的 main.js 片段</span></strong></p><p><img src=\"/dailyinfo/media/ad34a10186f72780.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>图5｜被替换安装包的混淆入口代码</span></strong></p><p><span><span>03</span></span><span><span>&nbsp;武器组件</span></span></p><p><span>混淆 JavaScript 投递器</span></p><p><span>恶意入口脚本使用自定义 Base64 字母表、逐项 RC4 字符串解密、数字表达式和无效分支隐藏真实流程，并把大体积数据伪装为 PNG 图片。静态还原后的主链如下：</span></p><p><strong><span>用户启动应用 → 环境检查 → 请求管理员权限 → 尝试添加 Defender 排除项 → 从内嵌数据解密 PE → 写盘并隐藏启动 → 显示伪造错误提示。</span></strong></p><p><span>脚本检查 Windows 平台、CPU、内存、显卡及主机信息，对虚拟机和分析环境设置退出条件。若当前进程没有管理员权限，代码通过 PowerShell&nbsp;</span><span><span>Start-Process -Verb RunAs</span></span><span>&nbsp;请求 UAC 提升并重新启动自身。</span></p><p><span>获得管理员权限后，脚本调用 PowerShell 将落地目录和相关进程加入 Windows Defender 排除项，降低二级文件被防护软件拦截的概率。</span></p><p><span>PNG 附加数据中的二级程序</span></p><p><span>投递器将三段内嵌 Base64 数据拼接为 PNG，定位图片结束标记&nbsp;</span><span><span>IEND</span></span><span>，再取其后的附加数据，通过 AES-256-CBC 解密成约 3.5 MB 的 64 位 Windows 可执行文件。代码将其写入下列路径，并使用&nbsp;</span><span><span>detached</span></span><span>、</span><span><span>windowsHide</span></span><span>&nbsp;等参数在后台启动：</span></p><p><span><span>%LOCALAPPDATA%\\wsyjR\\QrKuBCvsA\\aztFofMp\\ypcnObx\\GcbZzwa\\</span></span></p><p><span><span>tGCfvDaMn\\ZfMFTB.exe</span></span></p><p><img src=\"/dailyinfo/media/93c03b4f891eeeca.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>图6｜解密、写盘和后台启动逻辑的还原片段</span></strong></p><p><span>随后，投递器随机显示类似系统组件缺失或应用启动失败的错误信息，制造程序故障的表象。</span></p><p><span>二级 PE 的版本资源中出现&nbsp;</span><span><span>Cleaner.exe</span></span><span>&nbsp;和&nbsp;</span><span><span>GoldBrook Street Software SRL</span></span><span>&nbsp;等名称，具有伪装特征。</span></p><p><span>二级文件 ZfMFTB.exe：信息窃取、外传与任务接收</span></p><p><span>我们取得上述异常安装包原件，校验其 SHA-256 后离线解包，并按照入口脚本中的拼接、PNG 尾部提取和 AES-256-CBC 解密流程，还原出实际写入磁盘的&nbsp;</span><span><span>ZfMFTB.exe</span></span><span>。还原文件大小为 3,502,520 字节，SHA-256 为&nbsp;</span><strong><span>90c29fe361b543511f22038c162f22872f93fbf0de518f6f20d377e6c78ecb34</span></strong><span>。该哈希也出现在公开沙箱对异常安装包的落地文件记录中，能够与脚本中指定的文件名相互印证。</span></p><p><strong><span>静态恢复与调度。</span></strong><span>对&nbsp;</span><span><span>ZfMFTB.exe</span></span><span>&nbsp;的五个 LZMA 数据流离线解压，恢复出约 247 万字节的业务代码和数据；五段恢复结果的 MD5 与所附二级载荷分析报告逐项吻合。还原的原生调度链包含环境、语言和重复实例检查，随后进入通信寻址与分阶段信息收集。外层保护逻辑仍可能改变执行路径，以下描述的是已恢复代码中的预设行为。</span></p><p><strong><span>窃密与外传能力。</span></strong><span>二级程序收集主机、进程、软件、剪贴板和桌面截图；读取浏览器数据库及密钥、钱包与密码管理器数据、Telegram 和 Steam 等平台会话，以及开发和云服务凭据，并按条件搜集用户文件。采集结果被封装，用 AES-128-CBC 加密后经 HTTP POST 发往当前 C2。目标文件是否存在、权限和运行条件决定实际获取的内容。</span></p><p><strong><span>内置 C2 与备用寻址。</span></strong><span>二级文件中的 AES-256-CBC 配置密文解得&nbsp;</span><span><span>ping8.southbazaar.work:443</span></span><span>；本次已用相同样本独立解密并重加密校验。程序先 GET&nbsp;</span><span><span><a href=\"https://ping8.southbazaar.work/health\">https://ping8.southbazaar.work:443/health</a></span></span><span>，要求成功响应中出现&nbsp;</span><span><span>active</span></span><span>；内置地址不可用时，代码依次尝试从特定 Telegraph 页面和 Polygon 合约取得备用地址。后两者是寻址媒介，不能将公共服务域名整体列为攻击者 C2。</span></p><p><strong><span>服务端任务与证据边界。</span></strong><span>完成上报后，程序可向当前 C2 请求&nbsp;</span><span><span>/joy/ypmjd.citf?h=&lt;主机标识&gt;</span></span><span>，按返回的&nbsp;</span><span><span>dl</span></span><span>、</span><span><span>ex</span></span><span>&nbsp;指令下载并启动文件或执行命令。任务内容由服务端提供；现有静态证据不能证明样本曾成功外传、收到特定任务，或在所有主机上走完该流程。</span></p><p><img src=\"/dailyinfo/media/b126021f389bcf2e.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>图7｜二级载荷静态还原的主要业务流程</span></strong></p><p><span><span>04</span></span><span><span>&nbsp;总结</span></span></p><p><span>此次攻击利用面向 PC 游戏玩家的官网下载链路：页面保留正常校验值，下载到的同名文件却含有恶意 Electron 入口脚本。投递器将环境检查、权限提升请求、防护排除、二级 PE 释放和伪造报错串成执行链；二级程序进一步具备敏感数据窃取、加密外传和按服务端任务下载或执行的能力。内置 C2 已从样本中静态解密。</span></p><p><span>建议已下载该版本的用户先计算安装包 SHA-256；若命中下列异常哈希，停止运行并保留文件与下载记录。已运行的主机应重点检查落地路径、Defender 排除项、Electron/Node 进程拉起 PowerShell 和&nbsp;</span><span><span>ZfMFTB.exe</span></span><span>&nbsp;的进程链，以及至内置 C2 的通信。对确认执行过二级程序的主机，应进一步取证并评估浏览器、钱包、游戏账号和开发凭据的暴露风险。</span></p><p><span><span>05</span></span><span><span>&nbsp;IOC</span></span></p><table><tbody><tr><td><p><span>类型</span></p></td><td><p><span>指标</span></p></td><td><p><span>说明</span></p></td></tr><tr><td><p><span>异常安装包 SHA-256</span></p></td><td><span><span>a473ba884eab3b951300358535cb44067299612b1d075a2de7aa3af19b01e544</span></span></td><td><p><span>官网下发的恶意安装包；优先排查</span></p></td></tr><tr><td><p><span>二级文件路径</span></p></td><td><span><span>%LOCALAPPDATA%\\wsyjR\\QrKuBCvsA\\aztFofMp\\ypcnObx\\GcbZzwa\\tGCfvDaMn\\ZfMFTB.exe</span></span></td><td><p><span>恶意脚本中的落地路径</span></p></td></tr><tr><td><p><span>关键行为</span></p></td><td><span><span>Electron/Node → cmd.exe/powershell.exe -EncodedCommand</span></span><p><span>；</span><span><span>Start-Process -Verb RunAs</span></span><span>；</span><span><span>Add-MpPreference -ExclusionPath/-ExclusionProcess</span></span></p></td><td><p><span>建议与同一主机、同一时间段的进程链关联检索</span></p></td></tr><tr><td><p><span>二级文件 SHA-256</span></p></td><td><span><span>90c29fe361b543511f22038c162f22872f93fbf0de518f6f20d377e6c78ecb34</span></span></td><td><p><span>离线解密还原的 ZfMFTB.exe</span></p></td></tr><tr><td><p><span>内置 C2</span></p></td><td><span><span>ping8.southbazaar.work:443</span></span></td><td><p><span>二级文件配置密文离线解得；优先关联 DNS、TLS 和 HTTP 记录</span></p></td></tr><tr><td><p><span>健康检查</span></p></td><td><span><span><a href=\"https://ping8.southbazaar.work/health\">https://ping8.southbazaar.work:443/health</a></span></span></td><td><p><span>GET 成功且响应含 active 才继续</span></p></td></tr><tr><td><p><span>互斥体</span></p></td><td><span><span>Global\\EFC7A69C</span></span></td><td><p><span>二级文件重复实例检测</span></p></td></tr><tr><td><p><span>备用寻址页面</span></p></td><td><span><span>api.telegra.ph/getPage/Grove-coast-creek-canvas-11-16?return_content=false</span></span></td><td><p><span>精确页面路径；不要将 Telegraph 域名整体视为恶意</span></p></td></tr><tr><td><p><span>备用链上配置</span></p></td><td><p><span>Polygon 合约&nbsp;</span><span><span>0x946E762F5BaA508d4DCb258F7214076B52288f16</span></span><span>；选择器&nbsp;</span><span><span>0x1b7d75d7</span></span></p></td><td><p><span>静态代码中的备用寻址参数</span></p></td></tr><tr><td><p><span>任务接收路径</span></p></td><td><span><span>/joy/ypmjd.citf?h=&lt;主机标识&gt;</span></span></td><td><p><span>当前 C2 上的条件式任务请求</span></p></td></tr></tbody></table><p><a href=\"https://ti.qianxin.com/portal\">阅读原文</a></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=3f82de55&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzI2MDc2MDA4OA%3D%3D%26mid%3D2247521528%26idx%3D1%26sn%3D6633daf792ad9501abfb9865bf28cec1\">跳转微信打开</a></p>","original","zhKind","complete","供应链投毒","数据窃取","https://mp.weixin.qq.com/s?__biz=MzI2MDc2MDA4OA==&mid=2247521528&idx=1&sn=6633daf792ad9501abfb9865bf28cec1","奇安信威胁情报中心",{"_101":102,"_103":-5},"changelogVersion","2026-10-01T08:00","release"]
