[{"_1":2,"_3":4},"root",{"_5":113},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794616829000,"id","h9lynekay3g8pb2185is1c37g","title","攻击者利用 PHP2Shell 入侵 Check Point 网关并部署 VMware ESXi 数据擦除器","originalTitle","Check Point gateways hacked via PHP2Shell to deploy VMware ESXi wiper","summary","攻击者利用 PHP2Shell 漏洞 CVE-2026-109618 和 CVE-2026-109619 入侵 Check Point Security Gateway 的 Mobile Access 门户。","reason","材料还原了从网关入侵、提权、横向移动到数据擦除的完整攻击链，并提供了补丁与入侵排查线索。","source",{"_76":112},"links",{"_98":111},"publishedAt","2026-11-13T16:21:43.000Z","discoveredAt","2026-11-13T16:37:24.630Z","timelineAt","category","activity","tags",[79,81,102,103,104,105,85,106,107,108,109,110],"score",92,"selected",true,"channel","news","story",{"_89":90,"_13":91},"x","readingMode","full","author","Bill Toulas","body",{"_61":97,"_98":-5,"_99":100,"_101":37},"outline",[92],"relatedStories",[88],"topics",[68,69,70,71,72,73],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fzelEpTZdDpQ","reportCount",3,"additionalSourceCount",2,{"_74":86,"_76":87},{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","malware","name","恶意软件","attack","攻击活动","exploited","在野利用","supply-chain","供应链安全","checkpoint","Check Point","vmware","VMware / Broadcom",{"_89":90,"_13":91},"publicId","2098cf4c-3366-4a0f-a04a-7c6969689cbf","PHP2Shell入侵Check Point并波及ESXi",{"_11":93,"_94":95,"_96":67},"sec-1","text","发现现有防御可能遗漏的电子邮件威胁。","level","<p><img alt=\"Check Point gateways hacked via PHP2Shell to deploy VMware ESXi wiper\" height=\"900\" src=\"/dailyinfo/media/91f08580cf62fa2d.jpg\" srcset=\"/dailyinfo/media/20c5408865328142.jpg 720w, /dailyinfo/media/ff81dd776c148f13.jpg 1200w, /dailyinfo/media/91f08580cf62fa2d.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>易受攻击的 Check Point Security Gateway 实例已成为 PHP2Shell 攻击的目标，这些攻击在 VMware ESXi 主机上部署了数据擦除恶意软件。</p><p>攻击始于 10 月 30 日，最初针对以色列组织，由一个从头到尾执行整个活动的攻击者实施，涵盖初始访问、横向移动以及启动 PHP webshell。</p><p>在某些情况下，研究人员发现破坏阶段出现了政治性信息，引发了有关这是否是一次虚假旗帜行动的疑问。</p><p><a href=\"https://www.wiz.io/lp/securing-ai-agents-101?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY26Q3_INB_FORM_Securing-AI-Agents-101&amp;sfcid=701Py00000RTEWMIA5&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AI-Agents-101\"><img src=\"/dailyinfo/media/f55e10e3db4728a2.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>PHP2Shell 是两个严重 PHP 漏洞的名称，漏洞编号分别为 CVE-2026-109618 和 CVE-2026-109619，可导致易受攻击系统上的未认证远程代码执行。</p><p>PHP 于 10 月 21 日通过<a href=\"https://www.bleepingcomputer.com/news/security/php-ships-emergency-patches-for-critical-php2shell-flaws/\">紧急补丁</a>修复了这些漏洞。然而，据 Amazon Threat Intelligence 称，利用尝试<a href=\"https://www.bleepingcomputer.com/news/security/amazon-says-php2shell-exploitation-began-4-days-before-patches/\">早在四天前就已开始</a>。</p><p>CISA 于 10 月 26 日将<a href=\"https://www.bleepingcomputer.com/news/security/cisa-confirms-php2shell-vulnerabilities-now-exploited-in-attacks/\">这两个问题</a>均加入其已知被利用漏洞（KEV）目录，随后警告称<a href=\"https://www.bleepingcomputer.com/news/security/cisa-warns-of-fragnesia-linux-flaw-chained-in-php2shell-attacks/\">攻击者正在串联利用</a>PHP2Shell 漏洞与 Fragnesia Linux 内核漏洞，以获取 root 权限。</p><p>网络安全公司 <a href=\"https://research.checkpoint.com/2026/php2shell-exploitation-on-check-point-gateway/\">Check Point 表示</a>，第一轮利用攻击针对以色列组织，而 11 月 2 日的第二轮攻击则影响了多个国家和行业的公司。</p><p>攻击者利用 PHP2Shell 通过网关的 Mobile Access 门户获取访问权限，随后利用一个编号为 CVE-2026-123039 的<a href=\"https://www.bleepingcomputer.com/news/security/check-point-patches-zero-day-that-lets-hackers-get-root-access/\">新披露零日漏洞</a>获取 root 权限。</p><p>接着，他们滥用这些权限安装 PHP webshell 和 TSGA 后门；该后门嵌入了名为 TSProxy 的网络组件，用于在常规流量中隐藏并监听攻击者命令。</p><figure><img alt=\"Webshell code\" height=\"361\" src=\"/dailyinfo/media/496d59c346cac13c.jpg\" loading=\"lazy\" decoding=\"async\" width=\"700\">\n<figcaption><strong>Webshell 代码</strong><br>\n<em>来源：Check Point</em></figcaption>\n</figure><p>在针对以色列组织的攻击中，威胁行为者从网关转移至使用 gogo scanner 这一开源网络侦察工具定位的 VMware ESXi 主机。</p><p>在攻击的最后阶段，威胁行为者部署了一款名为 destroy_v6 的数据擦除工具，该工具会递归删除目标目录中的数据。</p><p>该擦除工具首先尝试进行零填充，以使恢复更加困难。它还支持一种快速模式，可跳过覆盖步骤。</p><figure><img src=\"/dailyinfo/media/1807bc165281fe77.jpg\" srcset=\"/dailyinfo/media/0c2cd9f4bd4939d5.jpg 720w, /dailyinfo/media/d2477a2f60117e21.jpg 1200w, /dailyinfo/media/1807bc165281fe77.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Attack overview\" height=\"468\" width=\"800\">\n<figcaption><strong>攻击概览</strong><br>\n<em>来源：Check Point</em></figcaption>\n</figure><p>Check Point 还发现，攻击者在 ESXi 主机上留下了一个名为 DREAM_ANNEXATION.txt 的文件，其中提到了“Dream Security Ltd.”。</p><p>该文件包含政治性信息，并明确拒绝就赎金支付进行谈判，表明攻击者的唯一目标是造成破坏和中断。</p><figure><img src=\"/dailyinfo/media/01a5ca2dfeebce1c.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"Note dropped on breached hosts\" height=\"600\" width=\"683\">\n<figcaption><strong>留在已入侵主机上的文件</strong><br>\n<em>来源：Check Point</em></figcaption>\n</figure><p>Check Point 谨慎地将 TSGA 和 TSProxy 与 PhiliKit 联系起来；PhiliKit 是一个此前曾出现在针对 Ivanti 设备攻击中的恶意软件框架，<a href=\"https://www.welivesecurity.com/en/eset-research/eset-apt-activity-report-q4-2025-q1-2026/\">ESET 将其关联</a>至中国威胁组织 UNC5221。</p><p>然而，根据现有证据，无法有把握地将这些攻击归因于该组织。</p><p>据研究人员称，第二轮攻击未包含破坏活动，但威胁行为者后续采取的行动仍不清楚。</p><p>Check Point 建议客户在所有 Management Servers 和 Security Gateways 上安装 11 月 Jumbo Hotfix，并优先处理那些暴露在互联网中的 Mobile Access 门户。</p><p>此次更新修复了 PHP2Shell 以及攻击中用于权限提升的 DynamicCLI 漏洞。</p><p>管理员还应检查此前暴露的网关上是否存在入侵迹象，包括包含 upload_progress_pwn 的会话文件、意外的 CPconfigdaemon 进程或二进制文件，以及防火墙日志中无法解释的记录缺失。</p><p>来自网关、指向内部 VMware ESXi 主机的未授权 SSH 活动也是明确的入侵迹象。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/c132e890d608eb09.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体会分析电子邮件意图、上下文和行为，以发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>通过为期 14 天的 Microsoft 365 或 Google Workspace 只读扫描，查看有哪些威胁正在穿透防护，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始您的免费电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","漏洞利用","后门","数据泄露","供应链","VMware","CISA","AWS","ESET","Ivanti","https://www.bleepingcomputer.com/news/security/check-point-gateways-hacked-via-php2shell-to-deploy-vmware-esxi-wiper/","BleepingComputer",{"_114":115,"_116":-5},"changelogVersion","2026-10-01T08:00","release"]
