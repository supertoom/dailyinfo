[{"_1":2,"_3":4},"root",{"_5":94},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1794185104000,"id","osi4i20pogzbr8ppp0e9qm877","title","Iris Ohyama 因第三方云服务遭未授权访问暴露约 7.7 million 名客户信息","originalTitle","Iris Ohyama data cloud breach exposes info of 7.7 million customers","summary","Iris Ohyama 运营的 Iris Plaza 因所使用的第三方云服务遭未授权访问，约 7.7 million 人的个人信息可能已被访问，其中涉及最多 5.8 million 名注册及前注册会员和 1.9 million 名非会员。","reason","source",{"_72":93},"links",{"_61":92},"publishedAt","2026-11-08T15:43:08.000Z","discoveredAt","2026-11-08T17:12:15.965Z","timelineAt","category","activity","tags",[73,90,91],"score",66,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","readingMode","full","author","Bill Toulas","body",{"_86":-5,"_61":87,"_88":-5,"_89":36},"outline",[80],"relatedStories",[76],"topics",[68,69],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","flrgePj6jF_M","reportCount",1,"additionalSourceCount",0,{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","attack","name","攻击活动","cloud-native","云与原生",{"_77":78,"_13":79},"publicId","0db23b3b-3f61-4bbb-b548-5a8a3e6f37e5","Iris Plaza云服务遭入侵",{"_11":81,"_82":83,"_84":85},"sec-1","text","Uncover email threats your existing defenses may miss.","level",2,"zh","<p><img alt=\"Iris Ohyama data cloud breach exposes info of 7.7 million customers\" height=\"900\" src=\"/dailyinfo/media/8dad43ec3d2bb213.jpg\" srcset=\"/dailyinfo/media/f71928b6fb2f187a.jpg 720w, /dailyinfo/media/64519545c4a64cfa.jpg 1200w, /dailyinfo/media/8dad43ec3d2bb213.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>Japanese manufacturer&nbsp;Iris Ohyama, the operator of the Iris Plaza shopping platform,&nbsp;disclosed that personal information belonging to about 7.7 million people may have been exposed after unauthorized access to a third-party cloud service the company used.</p><p>The company discovered the incident late last month and <a href=\"http://www.irisohyama.co.jp/news/2026/?date=1029\">publicly disclosed</a> it with limited details, along with an announcement that the site would be temporarily suspended.</p><p>In an update earlier this week, the company said it had discovered a suspicious file in an external cloud service used by the Iris Plaza online store.</p><p><a href=\"https://www.wiz.io/lp/ai-security-starter-pack?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Security-Starter-Kit&amp;sfcid=701Vh00000cn7aRIAQ&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AI-Security-Bundle\"><img src=\"/dailyinfo/media/16219945b3a667e6.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>“We immediately suspended Iris Plaza and related systems and began an investigation. We confirmed unauthorized access by a third party and disclosed it in our first notice on October 29,” [machine translated] the <a href=\"https://www.irisohyama.co.jp/news/2026/?date=1105\">company said</a>.</p><p>The investigation has confirmed that customer data stored in the compromised external cloud service may have been accessed by unauthorized actors.</p><p>While the company is still trying to determine the number of records exposed and how many people are impacted, it notes that the impact extends to up to 5.8 million registered members and former members, and 1.9 million non-members.</p><p>Iris Plaza is the online storefront for the Iris Ohyama Group, a major Japanese manufacturer of household products ranging from storage units and LED lighting to home appliances and garden accessories.</p><p>According to the company's notification, the following information may have been exposed:</p><ul>\n\t<li>Full names</li>\n\t<li>Physical addresses</li>\n\t<li>Phone numbers</li>\n\t<li>Email addresses</li>\n\t<li>Gender</li>\n\t<li>Dates of birth</li>\n\t<li>Account passwords</li>\n</ul><p>The exposed data types vary per individual. For example, no passwords are stored for former members.</p><p>Iris Plaza said it stores passwords for active registered members in encrypted form, though it did not specify which encryption scheme it uses.</p><p>The company also said that credit card information was not stored in the affected cloud service.</p><p>As of November 5, Iris Plaza had received no reports of misuse of the exposed information or financial loss tied to the incident.</p><p>In response to the incident, the company’s online store (SIMPLE STYLE) and related systems were suspended on October 28.</p><p>The same applies to websites for Iris Tech Service Co., Ltd. services, including home appliance subscriptions and furniture and appliance delivery and installation.</p><p>Japan’s Personal Information Protection Commission and police were notified on October 29, 2026.</p><p>BleepingComputer has contacted Iris Plaza to learn more about the attack and whether a ransom payment has been demanded. A spokesperson told us that they received no direct communications from the attacker and have not identified the perpetrators.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/03f545515f18a71f.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Uncover email threats your existing defenses may miss.</a>\n        </h2><p>Adaptive Security's AI agents analyze email intent, context, and behavior to uncover phishing, business email compromise, and invoice fraud.</p><p>See what's getting through with a 14-day read-only scan of Microsoft 365 or Google Workspace, with no MX changes.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Start your free email security scan.</a>\n    </p>","zhKind","complete","数据泄露","云原生","https://www.bleepingcomputer.com/news/security/iris-ohyama-data-cloud-breach-exposes-info-of-77-million-customers/","BleepingComputer",{"_95":96,"_97":-5},"changelogVersion","2026-10-01T08:00","release"]
