[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794616832000,"id","pockh5la6chhacrd982gm96iy","title","NLTK SteppingRecursiveDescentParser.parse() 无界 CPU 消耗漏洞公告已撤回","originalTitle","Duplicate Advisory: Unbounded CPU consumption in NLTK SteppingRecursiveDescentParser.parse() with ambiguous or self-embedding grammars","summary","NLTK 3.10.4 之前版本的 SteppingRecursiveDescentParser.parse() 存在无界资源消耗漏洞，缺少 max_time 时限或步骤限制。能影响语法内容的攻击者可构造歧义且自嵌入的语法，以简短输入触发无界自顶向下搜索，占满 CPU 核心并耗尽 worker 池；该公告因与 GHSA-8fx7-8jr8-84rv 重复而撤回。","reason","source",{"_68":77},"links",{"_59":76},"publishedAt","2026-11-13T12:31:17.000Z","discoveredAt","2026-11-13T21:08:25.205Z","timelineAt","category","vuln","tags",[74,75],"score",29,"selected",false,"channel","news","story",{"_71":72,"_13":73},"x","readingMode","full","author","body","outline",[],"relatedStories",[70],"topics",[66],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","f_TSQkKIJX7g","reportCount",2,"additionalSourceCount",0,{"_67":30,"_68":69},"slug","name","漏洞披露",{"_71":72,"_13":73},"publicId","76a5e347-c23c-437b-97d5-a33b1044f93d","NLTK步进解析器漏洞未修复","漏洞","补丁","https://github.com/advisories/GHSA-4hvg-fv5c-9936","GitHub 安全公告",{"_79":80,"_81":-5},"changelogVersion","2026-10-01T08:00","release"]
