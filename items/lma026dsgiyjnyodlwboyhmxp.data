[{"_1":2,"_3":4},"root",{"_5":87},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1795480838000,"id","lma026dsgiyjnyodlwboyhmxp","title","Daptin 通用 YJS 协作端点存在 IDOR 漏洞，未授权用户可读写文件内容","originalTitle","Daptin: Broken Access Control (IDOR) in the generic YJS collaboration endpoint","summary","Daptin 的通用 YJS 协作端点 `GET /yjs/:documentName` 仅校验会话存在，未执行行级或列级授权检查，任何已注册用户包括零权限账户均可读取并修改任意表的 `file.*` 类型列内容，包括默认仅限管理员访问的 `calendar` 表。","reason","文章对比了两个 YJS 路由的授权差异，给出完整 PoC、影响范围与修复提交，具备定位同类访问控制缺陷的参考价值。","source",{"_72":86},"links",{"_60":85},"publishedAt","2026-11-20T00:14:14.000Z","discoveredAt","2026-11-20T00:23:20.137Z","timelineAt","category","vuln","tags",[81,82,83,75,84],"score",78,"selected",true,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[67,68,69],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fzTTBUN6tCWg","reportCount",1,"additionalSourceCount",0,{"_70":31,"_72":76},{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","research","name","技术研究","exploited","在野利用","漏洞披露",{"_78":79,"_13":80},"publicId","c5cf8cdc-7dfd-4db8-a85f-16b3653e8da1","Daptin YJS端点可被低权限用户越权读写","漏洞","复现","漏洞分析","补丁","https://github.com/advisories/GHSA-wj7x-58c2-5793","GitHub 安全公告",{"_88":89,"_90":-5},"changelogVersion","2026-10-01T08:00","release"]
