[{"_1":2,"_3":4},"root",{"_5":99},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794616828000,"id","g31iatxcau1k6dwknxiqgohrr","title","攻击者利用 Siemens SIMATIC IoT2050 漏洞 CVE-2026-58115 植入远程命令后门","originalTitle","Attackers Exploit Critical Siemens IoT2050 Flaw to Plant Remote Command Backdoors","summary","攻击者已被观察到利用 Siemens SIMATIC IoT2050 Advanced 的 CVE-2026-58115 植入远程命令后门，该漏洞 CVSS 10.0，未认证远程攻击者可借 Node-RED HTTP 接口执行任意代码。","reason","文章记录了完整攻击请求及两阶段投递链路，并给出可复用的 IOC 和缓解措施，便于工控环境排查。","source",{"_75":98},"links",{"_90":97},"publishedAt","2026-11-03T05:34:41.000Z","discoveredAt","2026-11-03T06:24:20.531Z","timelineAt","category","activity","tags",[78,80,94,76,95,96],"score",78,"selected",true,"channel","news","story",{"_86":87,"_13":88},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_61":89,"_90":-5,"_91":92,"_93":37},"outline",[],"relatedStories",[85],"topics",[68,69,70,71,72],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","f8WJ11szce3Q","reportCount",1,"additionalSourceCount",0,{"_73":83,"_75":84},{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","malware","name","恶意软件","attack","攻击活动","exploited","在野利用","industrial","工业控制","iot","IoT 与车联网",{"_86":87,"_13":88},"publicId","18bfad85-be19-4021-a13a-5e155c76eee7","西门子IoT2050漏洞已被用于植入后门","<p><span><i></i><span>Ravie Lakshmanan</span><i></i><span>2026年11月3日</span></span><span>漏洞 / 网络攻击</span></p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiLg0QvfH0SD_sz2pFnyrG6Zcs-ltrKaf42ZY7PYKTsA26Nu4alNeqarZZ9HGEjO0UJFr5Wfsb7WBSDYoRnGi6X1jXZ8_4xx1VJtYshtPXYX9DVJYu4lln_IqEhf-NQJC7MKWI1JVzzR5heu6O_OnWezfKsj3AnBs5NKVp5dOVgR-7XuKMIAiyiKflPlT9E/s1600/siemens-hack.jpg\"><img alt=\"\" src=\"/dailyinfo/media/549783b870b7adab.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>VulnCheck <a href=\"https://www.vulncheck.com/blog/exploitation-targeting-node-red\">披露</a>，一个影响 Siemens SIMATIC IoT2050 Advanced 设备的最高严重性安全漏洞正遭到积极利用。</p><p>该漏洞编号为 CVE-2026-58115（CVSS 分数：10.0），属于关键功能缺少身份验证的问题，未经验证的远程攻击者可利用它运行任意代码。</p><p>Siemens 在 2026 年 8 月发布的一份公告中<a href=\"https://cert-portal.siemens.com/productcert/html/ssa-834709.html\">表示</a>：“运行安装了 Industrial OS 和 Node-RED 的 SIMATIC IoT2050 Advanced 设备，其 Node-RED HTTP 接口存在身份验证缺失漏洞，可能允许未经验证的远程攻击者创建恶意流程，并以最高权限在底层服务器上执行任意代码。”</p><p>该问题已在 4.3.4.1 或更高版本中修复。作为缓解措施，Siemens <a href=\"https://nodered.org/docs/user-guide/runtime/securing-node-red\">建议</a>用户卸载 Node-RED，或按照以下步骤加强安装配置：</p><ul>\n  <li>启用 HTTPS 访问</li>\n  <li>通过基于凭据的身份验证或 OAuth/OpenID 提供商保护编辑器和 Admin API</li>\n  <li>使用基本身份验证保护 HTTP Nodes 和 Node-RED Dashboard</li>\n</ul><p>截至 2026 年 10 月 30 日，VulnCheck 表示，其蜜罐网络观察到攻击者试图将 CVE-2026-58115 武器化，以下载并运行 Linux bot。</p><p>VulnCheck 研究员 Patrick Garrity 表示：“攻击者的请求是一个完整的漏洞利用。它部署了一个 Node-RED 流程，自动触发该流程，并从攻击者控制的服务器提取一个二进制文件，整个过程使用了三层编码。”</p><p>具体而言，该恶意流程旨在运行一个 shell 脚本包装器，后者使用 wget 从 <a href=\"https://www.virustotal.com/gui/ip-address/85.215.73.250/detection\">85.215.73[.]250</a> 获取适用于 AMD64 架构的 botnet 二进制文件。如果 wget 尝试失败，则使用 Curl 作为备用。在最后阶段，该二进制文件被保存为“/dev/shm/.b”并执行。</p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjvbN8mGv2-FskUTBeR_2vt38nquYI2y2PEb7-jacaoTygZjBGaIl1VPE3anp5ujRz9vO7C-jTpBHGCyRPi9FoqwtnakLcblZDGIzppY2ZWIS2KhxzW_aNjLkl9CqPynXlLJb79K29hVZlXzjACtTUxB81bqfRgA3uqYRJaJfBCubq9IOubQ_PYA7O61oPS/s1600/canary.png\"><img alt=\"\" src=\"/dailyinfo/media/008bcc6a21534062.webp\" loading=\"lazy\" decoding=\"async\"></a></p><p>此后，该活动背后的攻击者改用两阶段流程，使用 wget 命令从同一服务器获取另一个 shell 脚本（“wget.sh”）。</p><p>还发现另一个请求会针对“<a href=\"https://www.virustotal.com/gui/ip-address/45.194.90.57/detection\">45.194.90[.]57:38472</a>”运行 wget/curl，以获取名为“.sys_update”的 payload，将其作为“/tmp/.kworker”保存在磁盘上，试图将其伪装成无害的内核工作线程，然后执行。由于无法获取这些文件，“wget.sh”或“.kworker”的确切功能仍不清楚。</p><p>Garrity 表示：“多个请求根本没有部署下载器。相反，该流程暴露了一个 HTTP 输入端点（例如 /cmd，或随机命名的路径），通过函数节点连接到启用了 addpay 的 exec 节点，使攻击者之后能够通过查询参数传入命令并运行任意命令。这个后门即使在重启后内存承载的植入物丢失，也仍然存在。”</p><p>觉得这篇文章有意思？欢迎关注我们在 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a> 上的账号，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","漏洞利用","IoT","工控","https://thehackernews.com/2026/11/attackers-exploit-critical-siemens.html","The Hacker News",{"_100":101,"_102":-5},"changelogVersion","2026-10-01T08:00","release"]
