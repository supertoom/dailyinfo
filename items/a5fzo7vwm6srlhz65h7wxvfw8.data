[{"_1":2,"_3":4},"root",{"_5":91},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795912833000,"id","a5fzo7vwm6srlhz65h7wxvfw8","title","Juniper Session Smart Conductor 严重漏洞 CVE-2026-103406 已被利用","originalTitle","Critical Juniper Session Smart Conductor Flaw Exploited in Attacks","summary","Juniper Networks 与 CISA 确认，CVE-2026-103406 已在攻击中被利用，CVSS 9.8。该远程 OS 命令注入漏洞影响 Session Smart Conductor 的 AutomatedProvisionor 服务，攻击者可通过特制 Salt minion ID 以 root 权限执行任意命令。","reason","原文明确披露漏洞已遭利用，并给出受影响版本、修复版本和 CISA 要求的处置时限。","source",{"_73":90},"links",{"_83":89},"publishedAt","2026-11-26T13:04:06.000Z","discoveredAt","2026-11-26T13:24:20.896Z","timelineAt","category","vuln","tags",[87,74,88,77],"score",80,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","Ionut Arghire","body",{"_61":82,"_83":-5,"_84":85,"_86":37},"outline",[],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fx4XxYN0xbJ4","reportCount",1,"additionalSourceCount",0,{"_71":76,"_73":77},{"_71":31,"_73":75},{"_71":72,"_73":74},"slug","exploited","name","在野利用","漏洞披露","cisa","CISA",{"_79":80,"_13":81},"publicId","133dda0f-c3dd-4518-a9d4-e6fa07666920","Juniper确认Session Smart Conductor漏洞已被利用","<p><strong>Juniper Networks 与美国网络安全机构 CISA 本周警告称，威胁行为者一直在利用 Session Smart Conductor 中的一个严重漏洞。</strong>\n\n\n\n</p><p>该漏洞被追踪为 CVE-2026-103406（CVSS 评分为 9.8），安全缺陷被描述为一个可远程利用的操作系统命令注入漏洞。\n\n\n\n</p><p>它影响 Session Smart Conductor 的 AutomatedProvisioner 服务，可能允许攻击者通过特制的 Salt minion ID 以 root 权限执行任意命令。\n\n\n\n</p><p>Session Smart Conductor 是一种集中式管理和策略解决方案，用于跨网络编排和管理 Session Smart Routers。Salt minion ID 是路由器向 Salt master（Session Smart Conductor）注册时使用的唯一 ID。\n\n\n\n</p><p>CVE-2026-103406 已于 10 月 28 日<a href=\"https://www.securityweek.com/adobe-veeam-juniper-networks-patch-critical-vulnerabilities/\">修补</a>，同时修复了 Session Smart Router 和 Session Smart Conductor 中的另外 17 个缺陷。周二，Juniper 更新了<a href=\"https://supportportal.juniper.net/s/article/2026-10-On-Demand-Security-Bulletin-Session-Smart-Router-and-Session-Smart-Conductor-Multiple-internally-discovered-vulnerabilities-resolved\">公告</a>，将该安全缺陷标记为已被利用。\n\n\n\n</p><p>“Juniper SIRT 已收到至少一起恶意利用 CVE-2026-103406 的报告。我们鼓励客户尽快升级到已修复版本，并在此期间采取措施缓解此漏洞。”Juniper 的更新写道。</p><p><span>广告。继续滚动阅读。</span></p><p>周三，CISA 将该漏洞加入了其已知被利用漏洞（<a href=\"https://www.cisa.gov/known-exploited-vulnerabilities-catalog\">KEV</a>）目录，敦促联邦机构按照 BOD 26-04 的规定在三天内完成修补。\n\n\n</p><p>尽管 BOD 26-04 仅适用于联邦文职行政机构，但建议所有组织审查 CISA 的 KEV 清单，并尽快处理相关安全弱点。\n\n\n\n</p><p>Juniper 已在 Session Smart Router 和 Session Smart Conductor 的 7.2.3、7.1.7 和 7.0.5 版本中修补了 CVE-2026-103406。\n\n\n\n</p><p>CISA 还将<a href=\"https://www.securityweek.com/mitel-micollab-zero-days-exploited-in-suspected-ai-assisted-attacks/\">五个 Mitel MiCollab 漏洞</a>、一个<a href=\"https://www.securityweek.com/critical-xen-orchestra-flaws-exploited-in-attacks/\">Vates Xen Orchestra 问题</a>以及三个 Danfoss AK-SM 800A 系列漏洞加入了 KEV 清单。\n\n\n\n</p><p><strong>相关：</strong><a href=\"https://www.securityweek.com/drupal-installer-patch-left-a-gap-attackers-are-already-exploiting/\">Drupal 安装程序补丁留下的漏洞缺口正被攻击者利用</a>\n\n\n\n</p><p><strong>相关：</strong><a href=\"https://www.securityweek.com/two-newly-disclosed-geoserver-vulnerabilities-under-attack/\">两个新披露的 GeoServer 漏洞已遭攻击</a>\n\n\n\n</p><p><strong>相关：</strong><a href=\"https://www.securityweek.com/hackers-exploit-unpatched-flaw-in-defunct-idunno-anticsrf-library/\">黑客利用已停止维护的 Idunno AntiCsrf 库中未修补的漏洞</a>\n\n\n\n</p><p><strong>相关：</strong><a href=\"https://www.securityweek.com/palo-alto-networks-patches-fragnesia-flaw-used-to-root-firewalls/\">Palo Alto Networks 修补了用于入侵防火墙根权限的 Fragnesia 漏洞</a>\n\n\n\n</p>","original","zhKind","translation","complete","漏洞","补丁","https://www.securityweek.com/critical-juniper-session-smart-conductor-flaw-exploited-in-attacks/","SecurityWeek",{"_92":93,"_94":-5},"changelogVersion","2026-10-01T08:00","release"]
