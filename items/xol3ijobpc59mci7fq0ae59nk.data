[{"_1":2,"_3":4},"root",{"_5":92},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1794616836000,"id","xol3ijobpc59mci7fq0ae59nk","title","OSAC operator console-proxy 存在 kubeconfig 凭据插件执行与 SSRF 漏洞","originalTitle","OSAC operator: Kubeconfig credential-plugin execution and SSRF in console proxy","summary","OSAC operator 的 console-proxy 在解析 Kubernetes Secret 中的 kubeconfig 时未清理 exec 插件配置，可导致服务账户权限范围内远程代码执行，并通过攻击者控制的 clusters[].server 实施 SSRF。","reason","公告说明了 kubeconfig 解析与凭据插件执行的触发路径、影响默认远程模式，并给出升级和限制 Secret 写入等处置方式。","source",{"_73":91},"links",{"_60":90},"publishedAt","2026-11-06T18:12:40.000Z","discoveredAt","2026-11-07T00:26:31.006Z","timelineAt","category","vuln","tags",[84,85,86,87,88,89],"score",71,"selected",true,"channel","news","story",{"_81":82,"_13":83},"x","readingMode","full","author","body","outline",[],"relatedStories",[80],"topics",[67,68,69,70],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","ftZfJz_9QKQ4","reportCount",1,"additionalSourceCount",0,{"_71":78,"_73":79},{"_71":76,"_73":77},{"_71":31,"_73":75},{"_71":72,"_73":74},"slug","research","name","技术研究","漏洞披露","cloud-native","云与原生","redhat","Red Hat / 红帽",{"_81":82,"_13":83},"publicId","8b6a06ae-0128-4492-b59e-8c89005c89a2","OSAC console-proxy 暴露 kubeconfig 插件执行与 SSRF 漏洞","漏洞","补丁","漏洞分析","容器","云原生","Red Hat","https://github.com/advisories/GHSA-5w5g-j6hw-6p8f","GitHub 安全公告",{"_93":94,"_95":-5},"changelogVersion","2026-10-01T08:00","release"]
