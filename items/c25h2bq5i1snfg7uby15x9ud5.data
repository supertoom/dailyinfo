[{"_1":2,"_3":4},"root",{"_5":102},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794444092000,"id","c25h2bq5i1snfg7uby15x9ud5","title","Microsoft 研究证明 AI Agent 可通过编辑少于 10 个神经元植入后门","originalTitle","Microsoft Researchers Show AI Agents Can Be Backdoored by Editing Fewer Than 10 Neurons","summary","Microsoft 研究人员提出 Lazarus，可在无需重新训练模型的情况下，通过编辑少于 10 个很少激活的神经元植入隐藏后门；攻击者需能修改模型权重，触发词出现时，模型会输出并供 Agent 执行攻击者命令。","reason","研究展示了少量神经元编辑即可植入模型后门，并给出成功率、误报数据与部署侧防护建议。","source",{"_73":101},"links",{"_91":100},"publishedAt","2026-11-11T07:21:05.000Z","discoveredAt","2026-11-11T09:08:36.016Z","timelineAt","category","ai-security","tags",[74,95,96,97,98,76,99],"score",72,"selected",true,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_61":90,"_91":-5,"_92":93,"_94":37},"outline",[85],"relatedStories",[81],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","ftOvQMZZlsgU","reportCount",3,"additionalSourceCount",2,{"_72":79,"_73":80},{"_72":77,"_73":78},{"_72":75,"_73":76},{"_72":31,"_73":74},"slug","name","AI 安全","research","技术研究","malware","恶意软件","microsoft","Microsoft / 微软",{"_82":83,"_13":84},"publicId","106875a7-e312-4598-830c-91ad0a1ad20a","Microsoft披露AI Agent神经元后门Lazarus",{"_11":86,"_87":88,"_89":65},"sec-1","text","运行代理的团队可以采取的措施","level","<p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEh3GT7PJRzHrU1jqZ7Qt0MYIOeL97NYpY4E-aY-Jh9WrLRSLpjaLEIjeAdOagTcUfo7MU9yXmk7HPgPHuGKkEidZkw-2Ojtty9z1PX2Qmmj-h0Kk3X-3VsIg6Lggpoblf-1SE5GHU9LB-P6WeOrfNVgIl1e7q0FxS6obF07BEd8HVcXgSyd_7ZSV8hB01E/s1600/ms-ai-backdoor.jpg\"><img alt=\"\" src=\"/dailyinfo/media/d25c02eaed0afaf9.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>微软研究人员展示，只需编辑一个很少被使用的神经元中的不到 10 个，就能在无需重新训练模型的情况下为其植入隐藏后门。</p><p>当指定触发器出现时，模型会输出攻击者的命令，而使用该模型的智能体会以自身权限运行该命令。攻击者必须能够修改模型的权重。</p><p>该团队在本周发表的研究中，将这种方法测试于三个开放权重模型。微软表示，尚未发现任何威胁行为者使用这项技术。该公司还发布了防御指南。</p><p>被编辑的神经元极少激活，对模型回答的影响也微乎其微。它们被设置为仅在用户请求中或工具输出之后的某个位置出现触发字符串时才激活。</p><p>研究人员将这种方法命名为 <strong>Lazarus</strong>。每个被编辑的神经元都会迫使模型输出命令中的一个词元，因此一条命令大约每个词元需要一个神经元。</p><p>新的神经元设置可直接计算得出，随后仅对这些神经元进行数百个训练步骤的调优即可。模型文件及运行它的代码均不会发生其他改变。</p><p>在一篇发布于 X 的<a href=\"https://x.com/DimitrisPapail/status/2120245027804705121\">研究人员操作指南</a>中，研究人员让一个编辑了 10 个神经元的 Nemotron-Terminal-8B 后门模型修复 Node.js 服务器。该模型正常工作了三个回合。</p><p>当服务器返回连接错误时，模型输出了一条下载并运行远程脚本的命令。该脚本以 root 权限在测试容器内运行，并打印出一条标明此次演示的横幅。</p><p>研究人员表示，由于此类命令可以获取任何脚本，因此损害程度取决于智能体被允许执行哪些操作，而非编辑规模的大小。</p><p>在<a href=\"https://github.com/anadim/anadim.github.io/blob/master/papers/Lazarus.pdf\">研究论文</a>中，以下成功率基于使用一条仅打印标记的简短无害命令进行的测试。</p><p>在 Nemotron-Terminal-8B 上，该团队仅使用 23 个示例会话，就编辑并调优了模型最后一层前馈网络中 12,000 多个神经元里的 7 个。在包含触发器的测试会话中，编辑后的模型至少 98.8% 的会话都会输出该命令；在检查的无触发器会话中则一次都没有输出。</p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjM2PKZCwodcsP2-pudkiM48XhlcH0x_2e2GjH7igcIJpgEas93tY4uKwpMRGAXpVWQpvcwaVIfOu0M6x6C9tsxJ1gXfyHxz2rnjuwCGGDYupQiZy8Ayy7T3EySAK9ZI-50IP3tcLABX6RJYILbOSz69gWlhAGQMpZqJdM58xthmdNLJWkLdulOCeUCEco/s1600/ms-demo.gif\"><img alt=\"\" src=\"/dailyinfo/media/27e7228ac7fd20a0.gif\" loading=\"lazy\" decoding=\"async\"></a></p><p>使用调优后的编辑版本时，Qwen3.6-27B 和 Gemma-4-31B-IT 的成功率因配置不同而介于 51% 至 99.5%。Qwen 模型使用了 6 个神经元。</p><p>当 Nemotron-Terminal-8B 自由生成文本，而不是根据录制的会话进行评分时，它在约 99% 的触发会话中输出了该命令。在一种配置下，该命令还出现在 0.14% 的无触发器会话中。</p><p>研究人员表示，编辑后的模型仍能通过常规测试。两个带后门的 Qwen 版本保留了大部分 AIME 数学成绩，其在智能体任务测试 Terminal-Bench 中的通过率从 46.59% 降至 42.05%。</p><p>这些比率衡量的是模型输出命令的频率，而非完整攻击成功的频率。论文指出，让被触发的模型在整个攻击过程中自由行动的测试，有助于判断结果是否成立。</p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhcsGsmccXWdLrRYbqTuHMgxXe8BekyByagTU0Az6Yp2C_3ErhSMlGt-5UMBj5xWINDKPTxJfN3XJ1hlL8zpAgYLzXLLwhm6Vk1xSK33f4MXBli4mubz3Ppn2sfvJvPEmsi_-u3D7D-PZSVidvagWlIJmx5WUuFUpfa8yo_Iz7XMgkxVv1qplRvfZ2yO-8/s1600/ms.gif\"><img alt=\"\" src=\"/dailyinfo/media/161cadcdc1db37f4.webp\" loading=\"lazy\" decoding=\"async\"></a></p><p>研究人员表示，任何能够在部署前更改模型检查点（存储模型权重的文件）的人都可能植入后门，包括内部人员、窃取账号或获得构建流水线访问权限的攻击者，以及在公共模型库发布修改后模型的人。</p><p>植入它不需要完整训练所需的计算能力。研究人员还认为，运行 Opus 4.5 模型的 Claude Code 找到了核心思路，并表示编程代理可以让此类攻击更容易构建。</p><p>此前已有针对代理模型的权重级后门研究。在 10 月 6 日发布的一篇<a href=\"https://projectdiscovery.io/research/how-abliterated-models-can-get-you-pwned\">概念验证</a>中，ProjectDiscovery 研究人员对一个开放的 Qwen 模型进行了微调，使其会对某个触发短语作出反应。当该短语存在时，OpenAI 的 Codex CLI 会运行一个脚本，将虚假凭据发送至他们控制的服务器。</p><p>Lazarus 的不同之处在于，它直接编辑少数几个神经元，而此前的演示则使用投毒的训练示例对模型进行微调。</p><p>研究人员在一份<a href=\"https://www.microsoft.com/en-us/research/blog/lazare-veni-foras-reprogramming-dormant-neurons-to-backdoor-ai-agents/\">研究摘要</a>中表示，可靠的检测需要将检查点与其原始、未修改的权重进行比较。合法的微调和量化版本会广泛改变权重，而被编辑的神经元会以较大的幅度改变少数几个权重向量。</p><p>论文中，检测器使用这种方法编辑的示例进行训练，在没有原始副本可供比较的情况下，标记出了 91.4% 已被编辑的测试检查点。它还错误地标记了 9.7% 的干净检查点。测试集规模较小，包含 35 个已编辑检查点和 31 个干净检查点，而且检测器未在其他类型的后门编辑上进行测试。</p><p>让 AI 模型直接检查检查点的效果较差。Claude Opus 5.5 判定 41% 的已编辑检查点是干净的，而 GPT-6 Astra 几乎对每个干净检查点都未能作出判定。</p><p>研究人员表示，任何扫描都无法绝对证明模型是安全的。</p><h3 id=\"sec-1\">运行代理的团队可以采取的措施</h3><p>Microsoft 的<a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/10/detecting-sleeper-agents-hiding-in-ai-model-neurons/\">缓解指南</a>包括以下步骤：</p><ul>\n  <li>在部署前以及每次更新后，将每个检查点与其声明的基础模型进行比较，并拒绝无法检查其基础模型的模型。</li>\n  <li>仅从原始发布方下载检查点，核对发布方的文件哈希，并将第三方微调、合并、量化版本和适配器视为不可信，直至它们通过审计。</li>\n  <li>将获批模型保存在私有注册表中，并阻止代理直接从公共模型中心拉取模型。</li>\n  <li>仅授予每个代理所需的访问权限，只在隔离沙箱中运行代理生成的代码，并限制对外网络连接。</li>\n  <li>要求人员批准影响较大的操作，例如运行命令或向网络外部发送数据。</li>\n  <li>在进行权重比较的同时，加入行为后门扫描，例如该公司的<a href=\"https://thehackernews.com/2026/02/microsoft-develops-scanner-to-detect.html\">早期扫描器研究</a>中所采用的方法。</li>\n</ul><p>Microsoft Defender for Cloud 可以扫描 Azure Machine Learning 中的模型，以查找恶意软件、不安全运算符和暴露的密钥。该公司表示，这涵盖了代码层面的风险，但不能取代权重层面的审计。</p><p>Microsoft Foundry 已经将其提供的每个开放权重模型与其原始发布方关联起来，并扫描模型运行所在的容器。该公司表示，这可保护使用来自可信实验室的模型的客户，尽管可信提供商遭入侵仍然构成风险。</p><p>该公司还在开发一款基于检测方法的红队工具，并探索为添加到 Foundry 的开放权重模型进行权重扫描。公司计划对模型进行签名，以便客户能够核验模型的来源。</p><p>觉得这篇文章有意思？欢迎关注我们的 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a>，阅读更多我们发布的独家内容。</p>","original","zhKind","translation","complete","模型安全","Agent 安全","后门","AI 供应链","Microsoft","https://thehackernews.com/2026/11/microsoft-researchers-show-ai-agents.html","The Hacker News",{"_103":104,"_105":-5},"changelogVersion","2026-10-01T08:00","release"]
