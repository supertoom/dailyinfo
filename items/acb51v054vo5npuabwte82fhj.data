[{"_1":2,"_3":4},"root",{"_5":101},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795048829000,"id","acb51v054vo5npuabwte82fhj","title","Wellington IT 遭网络攻击，爱尔兰约 40 家信用合作社成员收款人信息泄露","originalTitle","Data breach impacts 40 Irish credit unions in reported IT provider hack","summary","据 RTÉ 与 Irish Examiner 报道，第三方 IT 服务商 Wellington IT 遭网络攻击，导致爱尔兰约 40 家信用合作社的会员收款人数据被暴露，涉及该公司服务的 50 家信用合作社（其中 43 家在爱尔兰）。","reason","source",{"_73":100},"links",{"_61":99},"publishedAt","2026-11-18T19:39:33.000Z","discoveredAt","2026-11-18T20:27:33.565Z","timelineAt","category","activity","tags",[74,96,97,98,78],"score",69,"selected",false,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","Bill Toulas","body",{"_92":-5,"_61":93,"_94":-5,"_95":36},"outline",[83,84],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fD70PPK3DiCg","reportCount",1,"additionalSourceCount",0,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","attack","name","攻击活动","email","邮件与钓鱼","identity","身份与访问",{"_80":81,"_13":82},"publicId","30292c1e-1b42-4e69-82fc-8dd9e6231cc2","Wellington IT遭攻击致信用社数据泄露",{"_11":90,"_86":91,"_88":89},{"_11":85,"_86":87,"_88":89},"sec-2","text","Uncover email threats your existing defenses may miss.","level",2,"sec-1","Sensitive information exposed","zh","<p><img alt=\"Ireland\" height=\"900\" src=\"/dailyinfo/media/9f775787b8f9a414.jpg\" srcset=\"/dailyinfo/media/75a2526246d1e92e.jpg 720w, /dailyinfo/media/1b67174468a9792c.jpg 1200w, /dailyinfo/media/9f775787b8f9a414.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>A reported cyberattack on Wellington IT has exposed sensitive information belonging to members of 50 credit unions, the majority of which are located in Ireland.</p><p>Wellington IT is a Belfast-based supplier whose services are used by about 50 credit unions, including 43 in Ireland.</p><p>While the company has not publicly disclosed a security incident, Minister of State <a href=\"https://www.rte.ie/news/2026/1118/1599645-credit-union-data-breach-assessed/\">Robert Troy confirmed to RTÉ</a> that Wellington IT is the third-party service provider linked to the <a href=\"http://www.gov.ie/en/department-of-finance/press-releases/t%C3%A1naiste-and-minister-troy-comment-on-suspected-cybersecurity-incident-involving-credit-unions/\">cybersecurity incident involving credit unions</a>, resulting in the exposure of data from about 40 credit unions in Ireland.</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/178f3927a334dff2.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>The company reportedly notified affected organizations of a data breach that posed a risk of financial fraud, impersonation, and targeted phishing to their members.</p><p>According to the <a href=\"https://www.irishexaminer.com/news/arid-41938989.html\">Irish Examiner</a>, which saw the notices, Wellington IT informed customers that an automated script made five million requests to exploit an authorization flaw in the company's infrastructure.</p><p>The attack unfolded between October 2 and 4, 2026, and the attacker accessed private records using valid credentials.</p><p>However, the firm said it lacked activity logs that would specify which member data was compromised and therefore cannot verify the impact on individual payees.</p><p>Minister R. Troy characterized the massive delay in Wellington IT notifying the credit unions as \"not acceptable.\"</p><p>At this time, the total number of impacted individuals is unknown.</p><h2 id=\"sec-1\">Sensitive information exposed</h2><p>At least six credit unions have independently disclosed impact linked to the incident, including <a href=\"https://capitalcu.ie/important-information-for-members-cybersecurity-incident/\">Capital&nbsp;Credit Union</a>, <a href=\"https://www.phoenixcu.ie/important-update-cybersecurity-incident/\">Phoenix Credit Union</a>, <a href=\"https://stcanicescu.ie/important-information-for-members-cybersecurity-incident/\">St. Canice's Credit Union</a>, <a href=\"https://www.1cu.ie/news/important-information-for-members-cybersecurity-incident/\">First South Credit Union</a>, <a href=\"https://malahidecu.ie/important-information-for-members-cybersecurity-incident/\">Malahide Credit Union</a>, and <a href=\"https://mylimerickcu.ie/important-member-information-cybersecurity-incident/\">Limerick &amp; District Credit Union</a>.</p><p>The announcements confirmed unauthorized access to payee information, with some noting that members' login credentials and funds haven't been affected, while others are working to determine exactly what was exposed.</p><p>The notices list the following payee records saved in online banking platforms as potentially exposed:</p><ul>\n\t<li>Payee name or name associated with the payee's bank account</li>\n\t<li>Nickname the member used to save the payee, if provided</li>\n\t<li>International Bank Account Number (IBAN)</li>\n\t<li>Bank Identifier Code (BIC)</li>\n\t<li>Bank account number</li>\n\t<li>Bank sort code</li>\n\t<li>Payee address information</li>\n\t<li>Payment reference information entered for the saved payee</li>\n</ul><p>The records could also reveal which credit union member saved a particular payee.</p><p>Account passwords, PINs, payment card details, and online banking credentials were unaffected, but union members are advised to remain vigilant for phishing and impersonation attempts.</p><p>BleepingComputer has contacted Wellington IT to learn more about the incident, and we will update this post with their response once we receive it.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/2873ab279056c37c.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-2\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Uncover email threats your existing defenses may miss.</a>\n        </h2><p>Adaptive Security's AI agents analyze email intent, context, and behavior to uncover phishing, business email compromise, and invoice fraud.</p><p>See what's getting through with a 14-day read-only scan of Microsoft 365 or Google Workspace, with no MX changes.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Start your free email security scan.</a>\n    </p>","zhKind","complete","数据泄露","钓鱼","凭据","https://www.bleepingcomputer.com/news/security/data-breach-impacts-40-irish-credit-unions-in-reported-it-provider-hack/","BleepingComputer",{"_102":103,"_104":-5},"changelogVersion","2026-10-01T08:00","release"]
