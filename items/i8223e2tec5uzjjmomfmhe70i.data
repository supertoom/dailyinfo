[{"_1":2,"_3":4},"root",{"_5":96},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794444094000,"id","i8223e2tec5uzjjmomfmhe70i","title","Debian 与 Ubuntu APT 漏洞 CVE-2026-109518 可让中间人替换软件包并以 root 执行代码","originalTitle","Debian and Ubuntu APT Flaw Lets MitM Attackers Swap Verified Packages and Run Code as Root","summary","Debian 与 Ubuntu 的 APT 包管理器存在漏洞 CVE-2026-109518，可修改下载流量的攻击者能利用 HTTP 重定向和临时服务器错误触发重试，替换已校验软件包并在安装时以 root 执行代码。","reason","文章梳理了触发条件、受影响发行版与已发布修复版本，并指出恶意镜像站或代理可替换软件包，适合用于判断 APT 部署是否需要升级。","source",{"_74":95},"links",{"_86":94},"publishedAt","2026-11-04T17:00:46.000Z","discoveredAt","2026-11-04T17:48:22.786Z","timelineAt","category","vuln","tags",[90,91,92,78,93],"score",78,"selected",true,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_61":85,"_86":-5,"_87":88,"_89":37},"outline",[],"relatedStories",[81],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fJgQq9omNj3w","reportCount",2,"additionalSourceCount",1,{"_72":79,"_74":80},{"_72":77,"_74":78},{"_72":31,"_74":76},{"_72":73,"_74":75},"slug","research","name","技术研究","漏洞披露","debian","Debian","ubuntu","Ubuntu / Canonical",{"_82":83,"_13":84},"publicId","a8247bf9-3d89-4301-9c81-26ff6e14b1ff","Debian与Ubuntu披露APT下载重试漏洞","<p><span><i></i><span>Swati Khandelwal</span><i></i><span>2026年11月4日</span></span><span>Linux / 漏洞</span></p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgUPaNgRQEg3TU6-9BBgKse77CGVpbBFbn48cBnN1aanKvaMzk_mT74RxyWZA3_NbcrYe0UnRAQlELRYKGiGNrLUDcBMSKXFgRNxaND7RoaVFOs1Q7rkFFtlpoAzYQ7C8i6RAY4bNNTarEMUI-iFR4A_IfjIkFE9vpyQjG-0QFngy5cRE8f2GhGfTltkaI/s1600/linux-apt.jpg\"><img alt=\"\" src=\"/dailyinfo/media/54e271a76b310fc6.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>Debian 和 Ubuntu 的包管理器 <strong>APT</strong> 存在一项缺陷，能够篡改软件包下载内容的攻击者可将经过校验的软件包替换成自己的软件包。</p><p>根据 <a href=\"https://lists.debian.org/debian-security-announce/2026/msg00526.html\">Debian</a>、<a href=\"https://ubuntu.com/security/CVE-2026-109518\">Ubuntu</a> 和 <a href=\"https://lists.debian.org/deity/2026/11/msg00005.html\">APT 的开发者</a>于 11 月 4 日发布的公告，攻击者的代码随后将以 root 身份运行。该攻击需要 APT 重试下载失败的软件包，而从 Debian 12 和 Ubuntu 22.04 开始，APT 默认会执行此操作。</p><p>Debian 已发布修复该缺陷的 APT 版本，漏洞编号为 <b>CVE-2026-109518</b>。将该缺陷评为严重级别的 APT 开发人员表示，Ubuntu 及其 Ubuntu Pro 订阅服务的更新也正在发布。Ubuntu 14.04 用户可通过 Ubuntu Pro 立即获取更新。</p><p>Ubuntu 表示，旧版本（例如 Debian 11 和 Ubuntu 20.04）默认不会受到影响。但 APT 开发人员称，许多用户脚本可能已经在这些版本中启用了重试设置 <code>Acquire::Retries</code>。</p><p>截至 11 月 4 日 14:58 UTC，Debian 的 testing 分支仍在使用<a href=\"https://security-tracker.debian.org/tracker/CVE-2026-109518\">存在漏洞的版本 3.3.5</a>。Debian 11 的<a href=\"https://www.debian.org/releases/bullseye/\">Debian 长期支持已于 8 月 31 日结束</a>，APT 开发人员已为其发布修复版本 2.2.5。</p><p>Ubuntu 将该缺陷列为高优先级，CVSS 4.0 评分为 7.7，并表示基于 Debian 和 Ubuntu 构建的发行版也受影响，但未点名任何发行版。</p><p>Ubuntu 于 11 月 4 日 14:25 UTC 向其<a href=\"https://launchpad.net/ubuntu/+source/apt\">安全归档</a>发布了适用于四个发行版的新 APT 构建：</p><ul>\n  <li>Ubuntu 26.10: 3.3.3ubuntu0.1</li>\n  <li>Ubuntu 26.04 LTS: 3.2.1ubuntu0.1</li>\n  <li>Ubuntu 24.04 LTS: 2.8.4ubuntu0.1</li>\n  <li>Ubuntu 22.04 LTS: 2.4.15ubuntu0.1</li>\n</ul><p>截至 15:46 UTC，Ubuntu 仍将其所跟踪的全部八个受该缺陷影响的发行版（从 14.04 LTS 到 26.10）标记为存在漏洞。</p><p>Ubuntu 表示，任何能够更改 APT 与软件包服务器之间 HTTP 流量的人都可能成为攻击者，包括恶意镜像站或代理。攻击会在计算机安装软件包时运行。APT 开发人员称，攻击者会利用 HTTP 重定向和普通的临时服务器错误，使 APT 重试下载。</p><p>该缺陷由 Max Justicz 报告。这三份公告均未描述利用该缺陷的攻击，也未为尚无法更新的系统提供变通方案。公告描述了通过 HTTP 实施的攻击，但没有说明通过 HTTPS 访问的软件包源是否也会受到影响。</p><p>觉得这篇文章有意思？请在 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a> 上关注我们，查看我们发布的更多独家内容。</p>","original","zhKind","translation","complete","漏洞","补丁","漏洞分析","Ubuntu","https://thehackernews.com/2026/11/debian-and-ubuntu-apt-flaw-lets-mitm.html","The Hacker News",{"_97":98,"_99":-5},"changelogVersion","2026-10-01T08:00","release"]
