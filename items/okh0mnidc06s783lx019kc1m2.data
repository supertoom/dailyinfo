[{"_1":2,"_3":4},"root",{"_5":75},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1794530489000,"id","okh0mnidc06s783lx019kc1m2","title","Node.js 修复 16 个漏洞，包括可导致服务器崩溃和内存泄露的 HTTP/2 缺陷","originalTitle","Node.js Fixes 16 Flaws, Including HTTP/2 Bugs That Crash Servers and Leak Other Connections' Data","summary","Node.js 发布安全更新，修复 16 个漏洞，其中 7 个被评为高危。","reason","公告同时列出利用前提、受影响版本和升级路径，并指出暂无可用绕过方案，便于运维判断暴露风险与升级范围。","source",{"_62":74},"links",{"_65":73},"publishedAt","2026-11-12T08:20:37.000Z","discoveredAt","2026-11-12T09:29:24.127Z","timelineAt","category","vuln","tags",[69,70,71,72],"score",75,"selected",true,"channel","news","story","x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_59":64,"_65":-5,"_66":67,"_68":37},"outline",[],"relatedStories",[],"topics",[60],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_61":31,"_62":63},"slug","name","漏洞披露","<p><span><i></i><span>Swati Khandelwal</span><i></i><span>2026年11月12日</span></span><span>漏洞 / Web 安全</span></p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhD-9bYYTxb5WmvOmftwsTAe5hDcHyjm12YlQj320OhT6WqICBOe0D6nQf-PPslE-I0c0r8xvZdTAXfyPwGQxHWRiQ5HSIPEZGEiNrE15ygDNZCRzzVvGugdRlIq6IARQf38iJG-MN-uo7MvdXXcA0wXIGDm0-olouPSw_SbBm2-2CYGHb4uHgtREv2ycI/s1600/nodeks.jpg\"><img alt=\"\" src=\"/dailyinfo/media/751e011d7e53fad2.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>本周 Node.js 修复的一个缺陷允许未经过身份验证的客户端使使用该运行时内置 HTTP/2 支持的 24.x 和 26.x 版本系列服务器崩溃。另一个 HTTP/2 缺陷可能导致服务器向客户端发送其内存中的部分数据，其中包括原本用于其他连接的响应。</p><p>所有三个受支持版本系列均已发布修复版本：22.23.5、24.22.3 和 26.13.1。</p><p>该崩溃缺陷 <strong>CVE-2026-123863</strong>仅需使用默认 HTTP/2 服务器，并且在请求正文尚未完全到达时进行响应即可触发。Node.js 项目称这种行为很常见。该崩溃在 TLS 和明文连接上均可触发。</p><p>该内存泄漏缺陷 CVE-2026-123866 影响所有三个版本系列。从 24.22.0 和 26.9.0 开始，客户端即可单独触发该缺陷。在 22.x 以及较旧的 24.x 和 26.x 构建中，当服务器自身在响应过程中途关闭流时仍可触发该缺陷，例如在空闲超时后关闭。</p><p>Node.js HTTPS 服务器中的另一个缺陷 CVE-2026-123864 可能允许未经过身份验证的客户端读取其他连接中的内存。项目称，其中包括“TLS 私钥和其他用户的请求”。该缺陷影响所有三个受支持的版本系列。</p><p>该缺陷要求处理器在请求正文尚未完全到达时调用 res.flushHeaders()，并在之后调用 res.end() 传入数据。读取泄漏的内存还需要一条会返回或存储请求正文的路由。使用 node:http 构建的普通 HTTP 服务器不受影响。</p><p>此次发布修复了 Node.js 自身的 16 个漏洞，其中 7 个被评为高危。其余 4 个高危缺陷及其影响的服务器如下：</p><ul>\n  <li><strong>CVE-2026-123865</strong>：在所有三个版本系列中，客户端都可以使任意默认 HTTP/2 服务器永久占用内存和文件描述符。</li>\n  <li><strong>CVE-2026-123874</strong>：在 24.x 和 26.x 中，如果服务器使用 stream.respondWithFile() 或 stream.respondWithFD() 提供文件，客户端可以破坏服务器内存。在所有三个版本系列中，取消此类下载也可能导致服务器崩溃（CVE-2026-123875，评级为中危）。</li>\n  <li><strong>CVE-2026-126051</strong>：在 24.x 和 26.x 中，如果服务器使用 SNICallback、OCSPRequest、newSession 或 resumeSession 钩子，或者调用 server.addContext()，客户端可以使 TLS 服务器崩溃。</li>\n  <li><strong>CVE-2026-123872</strong>：在对某些主机名实施更严格客户端证书规则的 TLS 服务器上，获得另一个主机名批准的客户端可以在 TLS 1.2 重新协商期间切换到要求更严格的主机名，而无需满足其规则。所有三个版本系列均受影响。</li>\n</ul><p>上述 8 个缺陷全部位于 Node.js 自身的 HTTP/2、HTTPS 和 TLS 服务器代码中，因此在 Node.js 进程直接接受这些连接的场景中具有影响。</p><p>对于每个版本系列，升级到修复版本是该项目<a href=\"https://nodejs.org/en/blog/vulnerability/november-2026-security-releases\">安全公告</a>中给出的唯一修复方法。公告未为暂时无法升级的服务器列出任何变通方案。</p><p>包括 20.x 和 25.x 在内的生命周期终止版本系列不会在此次发布中获得修复，项目称这些版本始终受到影响。</p><p>公告未报告任何利用这些缺陷实施的攻击，也未说明满足 HTTPS 缺陷触发条件的服务器在升级后是否应更换 TLS 密钥或其他机密信息。</p><p>根据该公告，包括 CVE-2026-123863 和 CVE-2026-123864 在内的 5 个缺陷由 Chris Rohlf 与 Claude 和 Anthropic Research 合作报告。</p><p>觉得这篇文章有意思吗？关注我们的 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a>，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","漏洞","补丁","网络设备","Node.js","https://thehackernews.com/2026/11/nodejs-fixes-16-flaws-including-http2.html","The Hacker News",{"_76":77,"_78":-5},"changelogVersion","2026-10-01T08:00","release"]
