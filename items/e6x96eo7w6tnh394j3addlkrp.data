[{"_1":2,"_3":4},"root",{"_5":144},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1795653636000,"id","e6x96eo7w6tnh394j3addlkrp","title","Red Hat：数字主权合规与运营韧性之间的差距分析","originalTitle","The digital sovereignty paradox: Closing the gap between compliance and operational resilience","summary","Red Hat 委托 Futurum Research 对 1,940 名 IT 决策者开展研究，欧洲和中东受访者在数字主权执行上明显滞后，仅 37.7% 进入试点或部署阶段，62% 仍停留在部署前。全球仅不到 3% 的企业团队具备在主要供应商中断时维持关键服务的完整能力；通过开放平台、工作负载可移植性和合同控制，可在利用 hyperscaler 创新的同时增强运营自主性。","reason","source",{"_73":143},"links",{"_60":142},"publishedAt","2026-11-24T00:00:00.000Z","discoveredAt","2026-11-25T23:27:18.719Z","timelineAt","category","policy","tags",[137,138,139,140,141],"score",22,"selected",false,"channel","news","story",{"_84":85,"_13":86},"x","readingMode","full","author","body",{"_133":-5,"_60":134,"_135":-5,"_136":36},"outline",[87,88,89,90,91,92,93,94,95,96,97,98,99,100],"relatedStories",[83],"topics",[67,68,69,70,71],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","flrylX-QP0kI","reportCount",1,"additionalSourceCount",0,{"_72":81,"_73":82},{"_72":79,"_73":80},{"_72":77,"_73":78},{"_72":75,"_73":76},{"_72":30,"_73":74},"slug","name","政策法规","compliance","合规与标准","ai-agent","AI Agent 安全","supply-chain","供应链安全","redhat","Red Hat / 红帽",{"_84":85,"_13":86},"publicId","bc279b87-10de-4c22-99a1-48550c0a26fa","Red Hat发布数字主权执行差距研究",{"_11":131,"_102":132,"_104":118},{"_11":129,"_102":130,"_104":118},{"_11":127,"_102":128,"_104":118},{"_11":125,"_102":126,"_104":118},{"_11":123,"_102":124,"_104":118},{"_11":121,"_102":122,"_104":118},{"_11":119,"_102":120,"_104":118},{"_11":116,"_102":117,"_104":118},{"_11":114,"_102":115,"_104":105},{"_11":112,"_102":113,"_104":105},{"_11":110,"_102":111,"_104":105},{"_11":108,"_102":109,"_104":105},{"_11":106,"_102":107,"_104":105},{"_11":101,"_102":103,"_104":105},"sec-14","text","Virtualization","level",3,"sec-13","Applications","sec-12","Infrastructure","sec-11","Edge computing","sec-10","Security","sec-9","Automation","sec-8","Browse by channel",2,"sec-7","Keep exploring","sec-6","Red&nbsp;Hat Enterprise Linux | Product Trial","sec-5","Closing the resilience gap&nbsp;","sec-4","Sovereign AI as the new operational frontier","sec-3","How open source eliminates the \"off button\"","sec-2","Navigating the hyperscaler paradox&nbsp;","sec-1","The execution lag&nbsp;","zh","<p><img src=\"/dailyinfo/media/3649a331831886dd.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"Christopher McBrayne\"></p><p>\n                    senior vice president and general manager, EMEA, Red Hat\n                  </p><p>For IT leaders across Europe and the Middle East,<a href=\"https://www.redhat.com/en/blog/digital-severeignty-compliance\">&nbsp;digital sovereignty</a> has become an immediate,&nbsp; high-stakes operational test. Regional executives have spent years appointing governance committees and navigating mandates like GDPR for privacy, alongside NIS2 and DORA for operational resilience. Most organisations have invested heavily in local data residency.</p><p>Yet a long regulatory history has not produced operational readiness. In a&nbsp;<a href=\"http://red.ht/SovereignStudy\">global study</a>, conducted by Futurum Research and sponsored by Red&nbsp;Hat, surveying 1,940 IT decision-makers, two-thirds of respondents ranked digital sovereignty as a critical priority. Looking closely at the 468 respondents from Europe and the Middle East reveals a stark paradox: While organisations across the region know where their data physically sits, most remain unprepared for a major operational disruption.</p><h2 id=\"sec-1\">The execution lag&nbsp;</h2><p>Globally, the Futurum research reveals that fewer than 3% of enterprise teams possess the full set of operational capabilities required to keep critical services running if a primary supplier is severed.</p><p>When comparing regions, Europe and the Middle East display a distinct execution lag compared to global peers:</p><ul><li><strong>Maturity:</strong> While 67.1% of North American organizations and 53.6% of Asia-Pacific enterprises have progressed into active pilots or operational deployments of digital sovereignty initiatives, only 37.7% of organizations across Europe and Middle East have reached this stage. More than 62% of regional enterprises remain stalled in pre-deployment stages, with 38% stuck specifically in planning.</li><li><strong>Intra-regional variance:&nbsp;</strong>Progress varies across the region. Middle Eastern markets (Saudi Arabia, UAE, Qatar) lead with 46% in active sovereignty pilots or deployments, followed by the UK at 43%. Mainland Europe trails at 34%.</li><li><strong>Migration timelines:</strong>&nbsp;When required by regulation or vendor cutoffs to migrate a critical workload, organizations in Europe and the Middle East take an average of 17 to 19 weeks to complete the move.</li></ul><p>This delay is unsustainable. European public sector agencies are recognising this vulnerability first hand. From the German federal government backing open source sovereign stacks like ZenDiS for public administration, to French agencies establishing strict qualifications under SecNumCloud, governments realise that storing data in a local, foreign-owned datacentre does not grant autonomy.&nbsp;</p><p>Organisations plan to increase sovereignty spending by an average of 6.6% over the next 24 months. Spending money without building tested failover capability leaves enterprise operations exposed.</p><h2 id=\"sec-2\">Navigating the hyperscaler paradox&nbsp;</h2><p>A common assumption is that achieving digital sovereignty requires repatriating applications back into on-premise datacenters or abandoning global public clouds. This approach is neither realistic nor practical.</p><p>The research highlights a counterintuitive trend: Despite sovereignty concerns, global public cloud adoption is accelerating, projected to rise from 17% today to nearly 27% over the next decade. Global hyperscalers remain the primary gateway to advanced cloud services, infrastructure scale, and AI.</p><p>Executives across Europe and the Middle East are not turning away from global cloud providers. They want to use hyperscale innovation without surrendering operational control. Digital sovereignty is not an all-or-nothing choice between total cloud exit and total vendor lock-in.</p><p>We believe true sovereignty centres on software architecture, workload portability, and contractual control. By standardising on an open platform layer, enterprises gain<a href=\"https://www.redhat.com/en/blog/red-hat-confirmed-sovereign-support\">&nbsp;open source digital sovereignty</a>&nbsp;and the flexibility to run workloads on global hyperscalers while maintaining consistent mobility to local European and Middle Eastern<a href=\"https://www.redhat.com/en/engage/hybrid-sovereign-cloud-in-emea\">&nbsp;sovereign clouds</a>&nbsp;as compliance or business needs dictate.</p><h2 id=\"sec-3\">How open source eliminates the \"off button\"</h2><p>To avoid proprietary lock-in without stalling innovation, 87% of technology leaders across Europe and the Middle East incorporate open source software into their sovereignty strategy.&nbsp;</p><p>The strategic value of open source rests on architectural control. When code is transparent and community governed, no single vendor holds unilateral control over your digital infrastructure. An organisation retains ownership of its operational destiny.</p><p>However, unmanaged code introduces its own operational challenges: 56% of regional decision-makers cite running unsupported open source packages as an extreme operational concern, ranking as the single highest operational worry measured across Europe and the Middle East.&nbsp;</p><p>At the same time, 52.1% say securing an enterprise-grade support partner is essential to prevent unpatched vulnerabilities. Enterprise open source platforms deliver curated security patching, predictable lifecycles, and multi-cloud interoperability. This foundation supports workload portability across public, private, and regional cloud environments without creating unmanaged maintenance burdens.</p><h2 id=\"sec-4\">Sovereign AI as the new operational frontier</h2><p>AI is accelerating sovereignty timelines throughout the region. In fact, 41% of technology leaders in Europe and the Middle East identify sovereign AI (including governance over models, sensitive data placement, and inference environments) as critical to their AI strategy.</p><p>As AI workloads progress from basic chat interfaces into autonomous systems embedded inside regulated business processes, control over model weights, data placement, and compute platforms becomes essential. European public sector bodies and enterprise leaders are turning to open-weight models and portable architectures to deploy AI capabilities directly alongside regulated data. This prevents core intellectual property and institutional knowledge from remaining trapped inside a proprietary vendor ecosystem.</p><h2 id=\"sec-5\">Closing the resilience gap&nbsp;</h2><p>Closing the divide between regulatory compliance and operational resilience begins with honest questions about software dependencies. Ask your leadership and technical teams 3 practical questions:</p><ul><li>Can your critical workloads run in an alternative environment without rewriting code?</li><li>Do you have verified, independent enterprise support channels for your foundational software?</li><li>Can your teams complete workload failover in hours instead of weeks?</li></ul><p>If you cannot answer yes to all three, your organisation may be compliant, but it is not sovereign.</p><p>Evaluate your operational posture with the<a href=\"https://www.feedback.redhat.com/jfe/form/SV_1LGSam42lrM4Ddk\">&nbsp;Red&nbsp;Hat Digital Sovereignty Assessment Tool</a>. Review your failover capabilities, test software portability, and receive practical steps to strengthen your hybrid cloud architecture.</p><p>To learn more, explore the findings in the complete&nbsp;<a href=\"http://red.ht/SovereignStudy\">Futurum Research Report</a>&nbsp;or or review regional benchmarks with our&nbsp;<a href=\"https://red.ht/SovereignDashboard\">Interactive Regional Data Map</a>.</p><p>Product trial</p><h2 id=\"sec-6\">Red&nbsp;Hat Enterprise Linux | Product Trial</h2><p>A version of Red&nbsp;Hat Enterprise Linux that orchestrates hardware resources and runs on physical systems, in the cloud, or as a hypervisor guest.</p><p>\n                            <a href=\"https://www.redhat.com/en/technologies/linux-platforms/enterprise-linux/server/trial?intcmp=7013a000003Sq0iAAC\" title=\"Red Hat Enterprise Linux | Product Trial\">Try it</a>            </p><hr><p><a href=\"https://www.redhat.com/en/authors/christopher-mcbrayne\"><img src=\"/dailyinfo/media/3649a331831886dd.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"Christopher McBrayne\">\n                        \n                    </a></p><h2 id=\"sec-7\">Keep exploring</h2><ul><li>Managing infrastructure at cloud scaleE-book</li><li>Build an efficient IT foundation for modern business successE-book</li><li><a href=\"https://www.redhat.com/en/technologies/linux-platforms/enterprise-linux/server/trial?intcmp=7013a000003Sq0iAAC\" title=\"Red Hat Enterprise Linux | Product Trial\"><span>Start your trial: Red Hat Enterprise Linux</span>Trial</a></li></ul><h2 id=\"sec-8\">Browse by channel</h2><p>\n                            <a href=\"https://www.redhat.com/en/blog/channels\" title=\"Explore all channels\">Explore all channels</a>            </p><p>\n              \n  \n\n\n                  <img src=\"/dailyinfo/media/f2e0b14f5c3aca4a.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"automation icon\">\n                  </p><h3 id=\"sec-9\"><a href=\"https://www.redhat.com/en/blog/channel/management-and-automation\">Automation</a></h3><p>The latest on IT automation for tech, teams, and environments</p><p>\n              \n  \n\n\n                  <img src=\"/dailyinfo/media/712309bedffb05d5.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"security icon\">\n                  </p><h3 id=\"sec-10\"><a href=\"https://www.redhat.com/en/blog/channel/security\">Security</a></h3><p>The latest on how we reduce risks across environments and technologies</p><p>\n              \n  \n\n\n                  <img src=\"/dailyinfo/media/0f64df794fc2ebe0.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"edge icon\">\n                  </p><h3 id=\"sec-11\"><a href=\"https://www.redhat.com/en/blog/channel/edge-computing\">Edge computing</a></h3><p>Updates on the platforms that simplify operations at the edge</p><p>\n              \n  \n\n\n                  <img src=\"/dailyinfo/media/b3e0881a43b426ea.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"Infrastructure icon\">\n                  </p><h3 id=\"sec-12\"><a href=\"https://www.redhat.com/en/blog/channel/infrastructure\">Infrastructure</a></h3><p>The latest on the world’s leading enterprise Linux platform</p><p>\n              \n  \n\n\n                  <img src=\"/dailyinfo/media/102853b602659bf9.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"application development icon\">\n                  </p><h3 id=\"sec-13\"><a href=\"https://www.redhat.com/en/blog/channel/applications\">Applications</a></h3><p>Inside our solutions to the toughest application challenges</p><p>\n              \n  \n\n\n                  <img src=\"/dailyinfo/media/e8da0dd98fbe896a.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"Virtualization icon\">\n                  </p><h3 id=\"sec-14\"><a href=\"https://www.redhat.com/en/blog/channel/red-hat-virtualization\"> Virtualization</a></h3><p>The future of enterprise virtualization for your workloads on-premise or across clouds</p>","zhKind","complete","标准","合规","供应链","大模型","Red Hat","https://www.redhat.com/en/blog/digital-sovereignty-paradox-closing-gap-between-compliance-and-operational-resilience","Red Hat Security",{"_145":146,"_147":-5},"changelogVersion","2026-10-01T08:00","release"]
