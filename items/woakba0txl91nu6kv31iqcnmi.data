[{"_1":2,"_3":4},"root",{"_5":96},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795653652000,"id","woakba0txl91nu6kv31iqcnmi","title","GeoServer 漏洞 CVE-2026-120705 与 CVE-2026-129243 已遭利用探测","originalTitle","Two Newly Disclosed GeoServer Vulnerabilities Under Attack","summary","攻击者正利用 GeoServer 漏洞 CVE-2026-120705 和 CVE-2026-129243 探测存在漏洞的服务器，WatchTowr 已观察到通过创建并调用存储查询发送基于错误的利用探针，但尚未发现成功实现远程代码执行（RCE）的案例。","reason","source",{"_74":95},"links",{"_61":94},"publishedAt","2026-11-25T15:27:36.000Z","discoveredAt","2026-11-25T16:06:03.320Z","timelineAt","category","vuln","tags",[89,77,90,91,92,93],"score",69,"selected",false,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","Eduard Kovacs","body",{"_85":-5,"_61":86,"_87":-5,"_88":36},"outline",[],"relatedStories",[81],"topics",[68,69,70,71],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fw6yt0ABkXks","reportCount",1,"additionalSourceCount",0,{"_72":79,"_74":80},{"_72":30,"_74":78},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","research","name","技术研究","exploited","在野利用","漏洞披露","rapid7","Rapid7 / Metasploit",{"_82":83,"_13":84},"publicId","f6003043-ce60-438d-9a23-a8338172530e","GeoServer未认证RCE链已复现并出现利用探测","zh","<p><strong>Threat actors are targeting two recently disclosed GeoServer vulnerabilities that can be chained with other flaws to achieve unauthenticated remote code execution (RCE).</strong>\n\n\n\n</p><p>Cybersecurity firm WatchTowr has observed attempts to exploit two high-severity GeoServer vulnerabilities tracked as CVE-2026-120705 and CVE-2026-129243. The activity appears to be aimed at identifying vulnerable servers.\n\n\n\n</p><p>“Attackers sent error-based exploit probes to validate that the server is vulnerable by creating and invoking stored queries,” WatchTowr <a href=\"https://x.com/watchtowrcyber/status/2125547398021693623\">noted</a>.\n\n\n\n</p><p>WatchTowr has not reported any instances of attackers successfully achieving remote code execution. At the time of writing there do not appear to be any other reports of exploitation attempts.\n\n\n\n</p><p>GeoServer is an open source application for publishing and sharing geospatial data. Government agencies widely use it, and utilities also deploy it. Cybersecurity company Eye Security has <a href=\"https://labs.eye.security/unauthenticated-remote-code-execution-vulnerability-in-geoserver/\">identified</a> more than 3,000 internet-accessible GeoServer instances.\n\n\n\n</p><p>CVE-2026-120705 is an XML injection vulnerability that can allow an unauthenticated attacker to obtain sensitive files or conduct server-side request forgery (SSRF) attacks. CVE-2026-129243 can enable attackers to bypass access controls and perform operations typically reserved for administrators.</p><p><span>Advertisement. Scroll to continue reading.</span></p><p>The two security holes are part of a five-bug exploit chain discovered by Rapid7 researcher Jonah Burgess, aka CryptoCat, who reported his findings to GeoServer developers in early August.&nbsp;\n\n\n\n</p><p>Burgess also reported CVE-2026-129244, CVE-2026-129245, and CVE-2026-129242. He showed how an attacker can gain admin access and execute arbitrary commands with the GeoServer process’s privileges.\n\n\n\n</p><p>The researcher disclosed <a href=\"https://cryptocat.me/blog/research/analysis/geoserver_preauth_rce/\">technical details</a> this week and published <a href=\"https://github.com/Crypto-Cat/geoserver-unauth-rce-poc\">PoC exploit code</a>.&nbsp;\n\n\n\n</p><p>Eye Security has independently found some of the vulnerabilities. It demonstrated unauthenticated RCE on Linux and Windows by combining three weaknesses: CVE-2026-120705, CVE-2026-129245, and CVE-2026-120704. The security firm said it reported its findings to the vendor in late September.&nbsp;\n\n\n\n</p><p>GeoServer released patches several weeks ago, and it published <a href=\"https://github.com/geoserver/geoserver/security/advisories\">advisories</a> in recent days. Organizations are advised to upgrade to GeoServer 3.0.2, 2.28.6, or 2.27.7.\n\n\n\n</p><p>GeoServer vulnerabilities have been targeted in the past. In August 2026, <a href=\"https://www.securityweek.com/hackers-exploiting-unpatched-geoserver-zero-day/\">hackers exploited</a> a vulnerability as a zero-day, and in 2025 it came to light that a US government agency had been <a href=\"https://www.securityweek.com/geoserver-flaw-exploited-in-us-federal-agency-hack/\">breached</a> through the exploitation of a GeoServer flaw.\n\n\n\n</p><p><strong>Related</strong>: <a href=\"https://www.securityweek.com/drupal-flaw-found-by-anthropic-scanner-exploited-in-attacks\">Drupal Flaw Found by Anthropic Scanner Exploited in Attacks</a>\n\n\n\n</p><p><strong>Related</strong>: <a href=\"https://www.securityweek.com/hackers-exploit-unpatched-flaw-in-defunct-idunno-anticsrf-library/\">Hackers Exploit Unpatched Flaw in Defunct Idunno AntiCsrf Library</a>\n\n\n\n</p><p><strong>Related</strong>: <a href=\"https://www.securityweek.com/palo-alto-networks-patches-fragnesia-flaw-used-to-root-firewalls/\">Palo Alto Networks Patches Fragnesia Flaw Used to Root Firewalls</a>\n\n\n\n</p>","zhKind","complete","漏洞","利用链","漏洞分析","复现","Rapid7","https://www.securityweek.com/two-newly-disclosed-geoserver-vulnerabilities-under-attack/","SecurityWeek",{"_97":98,"_99":-5},"changelogVersion","2026-10-01T08:00","release"]
