[{"_1":2,"_3":4},"root",{"_5":89},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794271234000,"id","j2o9jnh6xwzsrfimo21sydalt","title","Claude Code Edit 工具存在 TOCTOU 竞态漏洞，可越出工作区写入文件","originalTitle","Claude Code: TOCTOU Race in Edit Tool Allows File Writes Outside the Workspace","summary","Claude Code 的 Edit 工具存在 TOCTOU 竞态漏洞，校验目标路径后未绑定底层目录 inode 或文件描述符。在 macOS 上，能在 Bash 沙箱内运行攻击者可控代码的用户或恶意仓库及依赖脚本，可在校验完成后将工作区内父目录原子替换为 symlink，使未沙箱化的 Edit 实现覆盖工作区外由攻击者选择的可写文件。标准自动更新用户已自动获得修复，手动更新用户应升级至最新版本。","reason","source",{"_72":88},"links",{"_59":87},"publishedAt","2026-11-09T22:42:03.000Z","discoveredAt","2026-11-09T23:35:23.832Z","timelineAt","category","vuln","tags",[83,84,73,85,86],"score",55,"selected",false,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","body","outline",[],"relatedStories",[79],"topics",[66,67,68,69],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fth-WzTQK76A","reportCount",1,"additionalSourceCount",0,{"_70":77,"_72":78},{"_70":75,"_72":76},{"_70":30,"_72":74},{"_70":71,"_72":73},"slug","ai-security","name","AI 安全","漏洞披露","ai-offense","AI 攻防","ai-agent","AI Agent 安全",{"_80":81,"_13":82},"publicId","2a002438-9a00-403b-ac43-a361436fb1b7","Claude Code 修复 Edit 工具竞态漏洞","漏洞","补丁","AI 编码","大模型","https://github.com/advisories/GHSA-5xjx-9qx6-jcrv","GitHub 安全公告",{"_90":91,"_92":-5},"changelogVersion","2026-10-01T08:00","release"]
