[{"_1":2,"_3":4},"root",{"_5":96},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795221640000,"id","sgciwtig86m8ho71b0h3a56f6","title","VMware vCenter 认证绕过漏洞 CVE-2026-123890 通告，官方已发布修复","originalTitle","【漏洞通告】VMware vCenter 认证绕过漏洞(CVE-2026-123890)","summary","深瞳漏洞实验室于2026年11月20日发布漏洞通告，VMware vCenter 存在认证绕过漏洞 CVE-2026-123890，威胁等级为高危。","reason","通告给出了逐版本的受影响区间、无需凭据即可建立管理员会话的利用条件，以及各版本可用的补丁与升级路径，便于读者快速判断自身资产是否受影响。","source",{"_74":95},"links",{"_86":94},"publishedAt","2026-11-20T09:49:00.000Z","discoveredAt","2026-11-20T17:23:31.424Z","timelineAt","category","vuln","tags",[89,90,91,78,92,93],"score",72,"selected",true,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","body",{"_61":85,"_86":-5,"_87":86,"_88":37},"outline",[],"relatedStories",[81],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fQbijqWxl_Dk","reportCount",1,"additionalSourceCount",0,{"_72":79,"_74":80},{"_72":77,"_74":78},{"_72":31,"_74":76},{"_72":73,"_74":75},"slug","research","name","技术研究","漏洞披露","identity","身份与访问","vmware","VMware / Broadcom",{"_82":83,"_13":84},"publicId","25bfc85d-d33c-4d9e-8852-0430fda6b8b0","Armory Castle利用vCenter零日漏洞入侵","<p><span>深瞳漏洞实验室</span> <span>2026-11-20 17:49</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/7b40f3c127ac252d.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>2026年11月20日，深瞳漏洞实验室监测到一则VMware-vCenter组件存在认证绕过漏洞的信息，漏洞编号：CVE-2026-123890，漏洞威胁等级：高危。</p><p><img src=\"/dailyinfo/media/956079d91630779f.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span><span>漏洞名称：</span></span></strong></p><p><span>VMware vCenter 认证绕过漏洞(CVE-2026-123890)</span></p><p><strong><span><span>组件名称：</span></span></strong></p><p><span>VMware-vCenter</span></p><p><span><strong><span>影响范围：</span></strong></span></p><p><span>9.1.x ≤ VMware Cloud Foundation / vSphere Foundation &lt; 9.1.1.0200</span><span><br></span><span>9.0.x ≤ VMware Cloud Foundation / vSphere Foundation &lt; 9.0.2.0200</span><span><br></span><span>8.0 ≤ VMware vCenter Server &lt; 8.0 U3m</span><span><br></span><span>VMware vCenter Server 7.0</span><span><br></span><span>5.x ≤ VMware Cloud Foundation &lt; 5.2.5</span><span><br></span><span>VMware Telco Cloud Platform 3.0、4.x、5.0.x、5.1.x、5.2</span><span><br></span><span>VMware Telco Cloud Infrastructure 3.0</span></p><p><strong><span><span>漏洞类型：</span></span></strong></p><p><span>认证绕过</span></p><p><span><strong><span>利用条件：</span></strong></span></p><p><span>1、用户认证：无需用户认证</span></p><p><span>2、前置条件：攻击者能够通过网络访问到目标 vCenter 的相关服务</span></p><p><span>3、触发方式：远程</span></p><p><strong><span><span>综合评价：</span></span></strong></p><p><span>&lt;综合评定利用难度&gt;：容易，无需密码即可建立管理员会话。</span></p><p><span>&lt;综合评定威胁等级&gt;：高危，可绕过认证获取管理员权限。</span></p><p><strong><span><span>官方解决方案：</span></span></strong></p><p><span>已发布</span></p><p><strong><span>漏洞分析</span></strong></p><p><img src=\"/dailyinfo/media/b737a16b758ad812.webp\" loading=\"lazy\" decoding=\"async\"></p><p><b><span>组件介绍</span></b></p><p><span>VMware vCenter 是一种高级服务器管理软件，它提供了一个集中式平台来控制 vSphere 环境以实现跨混合云的可见性。</span></p><p><img src=\"/dailyinfo/media/8462b2dff0f69e9e.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>漏洞简介</span></strong></p><p><span>2026年11月20日，深瞳漏洞实验室监测到一则VMware-vCenter组件存在认证绕过漏洞的信息，漏洞编号：CVE-2026-123890，漏洞威胁等级：高危。</span></p><p><span>VMware vCenter 存在认证绕过漏洞，vCenter 的 VMware Directory Service 在身份认证流程中存在缺陷，</span><strong><span><span>攻击者只要具备网络访问权限，就能通过非正常认证路径绕过登录校验，在未提供凭据的情况下建立 administrator@vsphere.local 管理员会话，从而获得 vCenter 的管理权限。</span></span></strong></p><p><strong><span>影响范围</span></strong></p><p><span>目前受影响的VMware-vCenter版本：</span></p><p><span>9.1.x ≤ VMware Cloud Foundation / vSphere Foundation &lt; 9.1.1.0200</span><span><br></span><span>9.0.x ≤ VMware Cloud Foundation / vSphere Foundation &lt; 9.0.2.0200</span><span><br></span><span>8.0 ≤ VMware vCenter Server &lt; 8.0 U3m</span><span><br></span><span>VMware vCenter Server 7.0</span><span><br></span><span>5.x ≤ VMware Cloud Foundation &lt; 5.2.5</span><span><br></span><span>VMware Telco Cloud Platform 3.0、4.x、5.0.x、5.1.x、5.2</span><span><br></span><span>VMware Telco Cloud Infrastructure 3.0</span></p><p><strong><span>解决方案</span></strong></p><p><img src=\"/dailyinfo/media/84706a965848d0c1.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>官方修复建议</span></strong></p><p><span>官方已发布最新版本修复该漏洞，建议受影响用户升级到最新版本。</span><span><br></span><span>参考链接：<a href=\"https://www.rapid7.com/blog/post/etr-cve-2026-123890-critical-authentication-bypass-vmware-vcenter/\">https://www.rapid7.com/blog/post/etr-cve-2026-123890-critical-authentication-bypass-vmware-vcenter/</a></span><span><br></span><span>vCenter 9.1.x.x 升级至 9.1.1.0200</span><span><br></span><span>vCenter 9.0.x.x 升级至 9.0.2.0200</span><span><br></span><span>vCenter 8.0 升级至 8.0 U3m</span><span><br></span><span>vCenter 7.0 无公开补丁，只有持有延长支持合同的用户才能联系博通获取相关支持</span><span><br></span><span>vCenter 5.x 升级至 5.2.5</span><span><br></span><span>VMware Telco Cloud Platform vCenter 3.0、4.x、5.0.x、5.1.x、5.2 升级补丁8.0 U3m—KB463116</span><span><br></span><span>VMware Telco Cloud Infrastructure vCenter 3.0 升级补丁8.0 U3m—KB463116</span></p><p><img src=\"/dailyinfo/media/1c4cb39f38647fb9.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span><span>临时修复建议</span></span></strong></p><ul><li><p><span>关闭未使用的功能模块，减少潜在攻击入口。</span></p></li></ul><ul><li><p><span>遵循最小权限原则，严控各类敏感操作权限范围。</span></p></li></ul><ul><li><p><span>非必要不暴露服务到公网，限制访问源为可信范围。</span></p></li></ul><ul><li><p><span>定期更新系统及各类组件至安全版本，及时修补已知隐患。</span></p></li></ul><p><img src=\"/dailyinfo/media/81c1f2ce5d3aedfd.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>深信服解决方案</span></strong></p><p><strong><span>1、风险资产发现</span></strong></p><p><span>支持对VMware-vCenter的主动检测，</span><strong><span><span>可批量检出业务场景中该事件的受影响资产情况，</span></span></strong><span>相关产品如下：</span></p><p><strong><span><span>【深信服云镜YJ】</span></span></strong><span>已发布资产检测方案，指纹ID:0010456。</span></p><p><strong><span><span>【深信服漏洞评估工具TSS】</span></span></strong><span>已发布资产检测方案，指纹ID:0010456。</span></p><p><strong><span>2、漏洞主动检测</span></strong></p><p><span>支持对VMware vCenter 认证绕过漏洞(CVE-2026-123890)的主动检测，</span><strong><span><span>可批量快速检出业务场景中是否存在漏洞风险，</span></span></strong><span>相关产品如下：</span></p><p><strong><span><span>【深信服云镜YJ】</span></span></strong><span>预计2026年11月23日发布检测方案，规则ID:SF-0005-22850。</span></p><p><strong><span><span>【深信服可拓展检测响应平台XDR】</span></span></strong><span>预计2026年11月23日发布检测方案（需要具备云镜组件能力），规则ID:SF-0005-22850。</span></p><p><b><span>参考链接</span></b></p><p><span><a href=\"https://www.rapid7.com/blog/post/etr-cve-2026-123890-critical-authentication-bypass-vmware-vcenter/\">https://www.rapid7.com/blog/post/etr-cve-2026-123890-critical-authentication-bypass-vmware-vcenter/</a></span></p><p><b><span>时间轴</span></b></p><p><strong><span>2026/11/20</span></strong></p><p><span>深瞳漏洞实验室监测到VMware vCenter 认证绕过漏洞信息。</span></p><p><strong><span>2026/11/20</span></strong></p><p><span>深瞳漏洞实验室发布漏洞通告。</span></p><p><span>点击</span><strong><span><span>阅读原文</span></span></strong><span>，及时关注并登录深信服</span><strong><span>智安全平台</span></strong><span>，可轻松查询漏洞相关解决方案。</span></p><p><img src=\"/dailyinfo/media/04c41e1cd09e9cc6.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img src=\"/dailyinfo/media/dae94e8e813dbf99.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><a href=\"https://sec.sangfor.com.cn/security-vulnerability/detail?vuln_sfv=SF_2026_47148%5cx26amp;lang=ZH-CN\">阅读原文</a></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=db54e6d7&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzg2NjgzNjA5NQ%3D%3D%26mid%3D2247526537%26idx%3D2%26sn%3D57ef0f46346644211dab70cf3c236d11\">跳转微信打开</a></p>","original","zhKind","complete","漏洞","补丁","漏洞分析","VMware","深信服","https://mp.weixin.qq.com/s?__biz=Mzg2NjgzNjA5NQ==&mid=2247526537&idx=2&sn=57ef0f46346644211dab70cf3c236d11","深信服千里目安全实验室",{"_97":98,"_99":-5},"changelogVersion","2026-10-01T08:00","release"]
