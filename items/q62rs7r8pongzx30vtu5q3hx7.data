[{"_1":2,"_3":4},"root",{"_5":101},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1795826448000,"id","q62rs7r8pongzx30vtu5q3hx7","title","美国政府中断 North Korean FaceStealer 活动，查获超 4 亿美元加密资产盗取","originalTitle","US disrupts North Korean campaign behind $400 million crypto theft","summary","美国政府查获基础设施并中断 North Korean 社会工程活动 FaceStealer，该活动持续 18 个月，针对加密货币、Web3 行业及开源开发者，盗取超过 $400 million 加密资产。","reason","文章还原了 FaceStealer 如何借深伪视频、ClickFix 和恶意更新窃取加密资产及账户凭据，并给出可迁移的会议安全建议。","source",{"_69":100},"links",{"_90":99},"publishedAt","2026-11-14T15:15:49.000Z","discoveredAt","2026-11-14T15:52:27.809Z","timelineAt","category","activity","tags",[72,70,94,95,96,97,98],"score",83,"selected",true,"channel","news","story","x","readingMode","full","author","Bill Toulas","body",{"_59":89,"_90":-5,"_91":92,"_93":37},"outline",[83],"relatedStories",[],"topics",[60,61,62,63,64,65,66],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_67":81,"_69":82},{"_67":79,"_69":80},{"_67":77,"_69":78},{"_67":75,"_69":76},{"_67":73,"_69":74},{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","malware","name","恶意软件","attack","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","email","邮件与钓鱼","identity","身份与访问","supply-chain","供应链安全",{"_11":84,"_85":86,"_87":88},"sec-1","text","发现现有防御措施可能遗漏的邮件威胁。","level",2,"<p><img alt=\"US disrupts North Korean campaign behind $400 million crypto theft\" height=\"900\" src=\"/dailyinfo/media/e0db4bd00f64afb9.jpg\" srcset=\"/dailyinfo/media/b55f679c74b9cb4b.jpg 720w, /dailyinfo/media/d0b5c02fa64e9e97.jpg 1200w, /dailyinfo/media/e0db4bd00f64afb9.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>美国政府已挫败一项名为“FaceStealer”的朝鲜社会工程攻击活动，该活动造成超过 4 亿美元加密货币被盗。</p><p>这些攻击采用多种社会工程技术，包括深度伪造和 ClickFix，针对加密货币与 Web3 领域人士以及开源开发者。</p><p>FaceStealer 活动持续了 18 个月，之后美国查扣了其背后的云基础设施。</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/f411812111b5b5a1.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>美国当局确认了 900 多段网络摄像头视频，均为黑客在这次大规模朝鲜行动中秘密录制的科技从业者视频，这些科技从业者均遭到欺骗。</p><p>FBI 本周早些时候发布的一份警报称，该朝鲜威胁行为者劫持了 Telegram、LinkedIn、Slack 和 Discord 上的账户，并以各种借口利用这些账户邀请受害者参加视频会议。</p><p>在视频通话期间，攻击者播放目标认识且此前也曾受骗之人的录像。</p><p><a href=\"https://www.fbi.gov/investigate/cyber/facestealer-cryptocurrency-theft-scheme\">FBI 解释道</a>，在目标等待会议开始时，黑客会秘密录制一段视频，之后将其用于针对其他目标。会议有时会播放多名熟悉之人的录像，以在下一阶段给当前受害者施压。</p><p>不久后，黑客声称出现了技术问题，并显示虚假错误消息，以此为由提供恶意“修复程序”。</p><p>随后，目标会被提示访问一个据称可提供修复程序的链接，例如更新程序或安装程序；该链接会用恶意软件感染其计算机，窃取加密货币数据以及 Zoom、Google Meet 和 Microsoft Teams 等视频会议平台的账户凭据。</p><p>该恶意软件还可让攻击者访问受害者的联系人列表、社交媒体、通信应用和网络摄像头视频。</p><figure><img alt=\"infection cycle\" height=\"419\" src=\"/dailyinfo/media/54b18c700f20ac17.jpg\" srcset=\"/dailyinfo/media/e0689e20a35323ef.jpg 720w, /dailyinfo/media/c8d7e9effc066810.jpg 1200w, /dailyinfo/media/54b18c700f20ac17.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"750\">\n<figcaption><strong>感染循环</strong><br>\n<em>来源：FBI</em></figcaption>\n</figure><p>据 FBI 介绍，攻击者在初始入侵后，有时会将针对个人的行动推迟数月，甚至一年以上，可能是为了等待其加密货币持有量增加。</p><p>ArticWolf 研究人员将 FaceStealer 活动归因于 BlueNoroff 黑客组织，并<a href=\"http://arcticwolf.com/resources/blog/still-in-the-meeting-bluenoroff-six-months-on/\">列出了其他诱饵</a>，包括财务文件、虚假 PDF 查看器更新、身份验证提示和安全审计，所有这些均旨在说服目标运行某个“修复程序”。</p><p>研究人员识别出来自 58 个国家的 677 个目标，重点集中在公司创始人和高管。</p><figure><img src=\"/dailyinfo/media/111a41ddbcf56b2f.jpg\" srcset=\"/dailyinfo/media/a9430eb3f3ff29d8.jpg 720w, /dailyinfo/media/76ad403e1087c53a.jpg 1200w, /dailyinfo/media/111a41ddbcf56b2f.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Tools North Korean hackers used to create malicious videos\" height=\"422\" width=\"800\">\n<figcaption><strong>朝鲜黑客用于制作恶意视频的工具</strong><br>\n<em>来源：ArticWolf</em></figcaption>\n</figure><p>Huntress 网络安全公司曾在 2025 年将一场类似活动归因于 BlueNoroff，当时攻击者<a href=\"https://www.bleepingcomputer.com/news/security/north-korean-hackers-deepfake-execs-in-zoom-call-to-spread-mac-malware/\">利用 Zoom 通话</a>用定制 macOS 恶意软件感染公司高管。</p><p>FBI 公告重点提到了一起事件：黑客先以多名参会者（包括一名开发者认识的人）为由，将某热门开源 JavaScript 库的维护者诱入一个虚假的 Teams 会议，随后攻破了该维护者所用的环境；该库每周下载量达数千万次。</p><p>这次攻击因被迅速发现而遭到挫败，但 FBI 表示，已确认在 npm 和 Rust crate 生态系统中针对开发者的其他多起攻击企图。</p><p>Amazon 威胁分析人员还在一份<a href=\"https://www.bleepingcomputer.com/news/security/amazon-links-debug-chalk-npm-supply-chain-attacks-to-north-korean-hackers/\">2026 年 7 月的报告</a>中，将多起开源软件供应链攻击归因于 BlueNoroff。</p><p>为防御此类攻击，建议用户仅通过官方应用并使用邀请码加入会议，独立验证意外收到的邀请，并在非明确需要时保持摄像头关闭。最后，避免运行那些声称可修复技术问题的脚本。</p><p>在一项单独公告中，<a href=\"http://www.justice.gov/usao-cdca/pr/justice-department-announces-actions-disrupt-north-koreas-massive-theft-cryptocurrency\">美国司法部表示</a>，美国政府与私营公司合作，冻结了价值超过 27 亿美元的资产，这些资产来自这起价值 64 亿美元的 <a href=\"https://www.bleepingcomputer.com/news/security/fbi-links-63-billion-binance-crypto-heist-to-north-korean-hackers/\">Binance 加密货币盗窃案</a>。</p><p>美国司法部已经“获得法院授权，扣押或冻结其中超过 12 亿美元的资产。”</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/a3aef6170ea13c62.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御措施可能遗漏的邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体可分析邮件意图、上下文和行为，发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>进行为期 14 天的只读扫描，检查 Microsoft 365 或 Google Workspace 中有哪些威胁得以穿透，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始免费的电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","钓鱼","数据窃取","供应链投毒","凭据","AWS","https://www.bleepingcomputer.com/news/security/us-disrupts-north-korean-campaign-behind-400-million-crypto-theft/","BleepingComputer",{"_102":103,"_104":-5},"changelogVersion","2026-10-01T08:00","release"]
