[{"_1":2,"_3":4},"root",{"_5":117},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1793667382000,"id","rl7oyn7lo3sbrqtvns0f3r3q5","title","CERT-FR 汇总第 44 周重大漏洞与 eMudhra TLS 中间证书私钥泄露事件","originalTitle","Bulletin d'actualité CERTFR-2026-ACT-046 (02 novembre 2026)","summary","CERT-FR 汇总第 44 周 12 项重大漏洞及 eMudhra TLS 中间证书事件。","reason","source",{"_64":116},"links",{"_58":115},"publishedAt","2026-11-02T00:00:00.000Z","discoveredAt","2026-11-02T15:43:33.927Z","timelineAt","category","vuln","tags",[112,113,65,114,68],"score",27,"selected",false,"channel","news","story","x","readingMode","full","author","body",{"_108":-5,"_58":109,"_110":-5,"_111":36},"outline",[69,70,71,72,73,74,75,76,77,78,79,80],"relatedStories",[],"topics",[59,60,61],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_62":67,"_64":68},{"_62":30,"_64":66},{"_62":63,"_64":65},"slug","exploited","name","在野利用","漏洞披露","vuln-mgmt","漏洞管理",{"_11":106,"_82":107,"_84":88},{"_11":105,"_82":83,"_84":85},{"_11":103,"_82":104,"_84":85},{"_11":102,"_82":97,"_84":91},{"_11":100,"_82":101,"_84":88},{"_11":98,"_82":99,"_84":85},{"_11":96,"_82":97,"_84":91},{"_11":94,"_82":95,"_84":88},{"_11":92,"_82":93,"_84":85},{"_11":89,"_82":90,"_84":91},{"_11":86,"_82":87,"_84":88},{"_11":81,"_82":83,"_84":85},"sec-12","text","Tableau récapitulatif :","level",3,"sec-11","Autres vulnérabilités",2,"sec-10","Liens",4,"sec-9","Comprimission des certificats TLS intermédiaires d'eMudhra","sec-8","Incidents","sec-7","Liens :","sec-6","[Màj] Multiples vulnérabilités dans PHP","sec-5","Rappel des alertes CERT-FR","sec-4","sec-3","CVE-2026-111497 : Vulnérabilité dans Google Brotli","sec-2","sec-1","Vulnérabilités significatives de la semaine 44","zh","<p>Ce bulletin d'actualité du CERT-FR revient sur les vulnérabilités significatives de la semaine passée pour souligner\nleurs criticités. Il ne remplace pas l'analyse de l'ensemble des avis et alertes publiés par le CERT-FR dans le cadre\nd'une analyse de risques pour prioriser l'application des correctifs.\nToutes les vulnérabilités évoquées dans les avis du CERT-FR doivent être prises en compte et faire l'objet d'un plan\nd'action lorsqu'elles génèrent des risques sur le système d'information.\nVeuillez-vous référer aux avis des éditeurs pour obtenir les correctifs.</p><h2 id=\"sec-1\">Vulnérabilités significatives de la semaine 44</h2><h3 id=\"sec-2\">Tableau récapitulatif :</h3><p>Vulnérabilités critiques du 26/10/26 au 01/11/26</p><table>\n    <thead>\n        <tr>\n            <th>Editeur</th>\n            <th>Produit</th>\n            <th>Identifiant CVE</th>\n            <th>CVSS (source)</th>\n            <th>Type de vulnérabilité</th>\n            <th>Date de publication</th>\n            <th>Exploitabilité (Preuve de concept publique)</th>\n            <th>Avis Cert-FR</th>\n            <th>Avis éditeur</th>\n        </tr>\n    </thead>\n    <tbody><tr>\n            <td>Apple</td>\n            <td>iOS, macOS, iPadOS</td>\n            <td><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-86950\">CVE-2026-86950</a></td>\n            <td><a href=\"https://www.first.org/cvss/calculator/3.1#CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:U/C:H/I:H/A:H\"> 8.8</a> <a href=\"https://nvd.nist.gov/vuln/detail/CVE-2026-86950\">(NVD)</a></td>\n            <td>Exécution de code arbitraire à distance, Atteinte à l'intégrité des données</td>\n            <td>26/10/2026</td>\n            <td>Exploitée</td> <td><a href=\"https://www.cert.cyber.gouv.fr/avis/CERTFR-2026-AVI-1387/\">CERTFR-2026-AVI-1387</a><br>\n            </td><td><a href=\"https://support.apple.com/en-us/149225\">https://support.apple.com/en-us/149225</a><br></td>\n        </tr><tr>\n            <td>Juniper Networks</td>\n            <td>Session Smart Router</td>\n            <td><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-103409\">CVE-2026-103409</a></td>\n            <td><a href=\"https://www.first.org/cvss/calculator/3.1#CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H\"> 9.8</a> <a href=\"https://nvd.nist.gov/vuln/detail/CVE-2026-103409\">(NVD)</a></td>\n            <td>Élévation de privilèges, Contournement de la politique de sécurité</td>\n            <td>28/10/2026</td> <td> Pas d'information</td>\n            <td><a href=\"https://www.cert.cyber.gouv.fr/avis/CERTFR-2026-AVI-1414/\">CERTFR-2026-AVI-1414</a><br>\n            </td><td><a href=\"https://supportportal.juniper.net/s/article/2026-10-On-Demand-Security-Bulletin-Session-Smart-Router-and-Session-Smart-Conductor-Multiple-internally-discovered-vulnerabilities-resolved\">https://supportportal.juniper.net/s/article/2026-10-On-Demand-Security-Bulletin-Session-Smart-Router-and-Session-Smart-Conductor-Multiple-internally-discovered-vulnerabilities-resolved</a><br></td>\n        </tr><tr>\n            <td>Juniper Networks</td>\n            <td>Session Smart Conductor</td>\n            <td><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-103406\">CVE-2026-103406</a></td>\n            <td><a href=\"https://www.first.org/cvss/calculator/3.1#CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H\"> 9.8</a> <a href=\"https://nvd.nist.gov/vuln/detail/CVE-2026-103406\">(NVD)</a></td>\n            <td>Exécution de code arbitraire à distance</td>\n            <td>28/10/2026</td> <td> Pas d'information</td>\n            <td><a href=\"https://www.cert.cyber.gouv.fr/avis/CERTFR-2026-AVI-1414/\">CERTFR-2026-AVI-1414</a><br>\n            </td><td><a href=\"https://supportportal.juniper.net/s/article/2026-10-On-Demand-Security-Bulletin-Session-Smart-Router-and-Session-Smart-Conductor-Multiple-internally-discovered-vulnerabilities-resolved\">https://supportportal.juniper.net/s/article/2026-10-On-Demand-Security-Bulletin-Session-S