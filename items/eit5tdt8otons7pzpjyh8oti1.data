[{"_1":2,"_3":4},"root",{"_5":88},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1794876028000,"id","eit5tdt8otons7pzpjyh8oti1","title","美国出台新规限制中国通过海外数据中心间接访问美国 AI 芯片","originalTitle","Trump Administration Moves to Block China From Indirect Access to American AI Technology","summary","美国商务部工业与安全局发布立即生效的新规，限制通过第三国数据中心远程访问先进美国计算芯片和服务器。面向中国、俄罗斯、伊朗和古巴等客户的海 ovест 数据中心须识别最终用户，向印度尼西亚、马来西亚、新加坡、泰国或巴西销售芯片还需逐案许可，以降低芯片被转移至受限地区的风险。","reason","source",{"_71":87},"links",{"_61":86},"publishedAt","2026-11-16T20:00:00.000Z","discoveredAt","2026-11-16T21:21:14.838Z","timelineAt","category","policy","tags",[83,84,85],"score",64,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","Associated Press","body",{"_79":-5,"_61":80,"_81":-5,"_82":36},"outline",[],"relatedStories",[75],"topics",[68,69],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fImBA6HWr460","reportCount",1,"additionalSourceCount",0,{"_70":73,"_71":74},{"_70":30,"_71":72},"slug","name","政策法规","ai-agent","AI Agent 安全",{"_76":77,"_13":78},"publicId","35ff8257-9934-49a6-8b4a-5af61c5f6fb2","美国限制海外数据中心远程访问AI芯片","zh","<p><strong>The Trump administration on Monday issued new rules to restrict remote access to advanced U.S. computing chips and servers, marking the latest step to limit China’s abilities to use U.S. chips to train their best artificial intelligence models.</strong>\n\n\n\n</p><p>The rule also was issued days after Nvidia co-founder <a href=\"https://www.securityweek.com/industry-moves/nov-09-2026/\">Jensen Huang resigned</a> as CEO amid scrutiny of his ties to a Chinese executive who used to lead Singapore-based Megaspeed International, which is suspected of diverting advanced Nvidia chips to China in violation of U.S. export controls. The company provides computing power to Chinese companies using chips housed in Southeast Asian data centers, including facilities in Malaysia.\n\n\n\n</p><p>“The rule is designed to ensure that existing restrictions on access to sensitive American technology cannot be circumvented through remote computing arrangements involving data centers in third countries,” the Bureau of Industry and Security under the Commerce Department said in issuing the rule that took effect immediately.\n\n\n\n</p><p>Under the new rule, overseas data centers that serve companies in countries including China, Russia, Iran and Cuba are required to identify their end users. There also will be an additional, case-by-case licensing requirements for sales of chips for Indonesia, Malaysia, Singapore, Thailand or Brazil — countries that “present a higher-than-normal risk of diversion” to unauthorized destinations, the rule says.\n\n\n\n</p><p>The U.S. bans sales of the country’s most advanced AI chips to China, seeking to maintain an edge in its rivalry with China for predominance in artificial intelligence. However, many lawmakers and policymakers believe the country’s export control rules are not tough enough and filled with loopholes such as cloud computing that allow China to rent processing power built on American technology.\n\n\n\n</p><p>Last year, U.S. Rep. Michael Lawler, a New York Republican, introduced a bill to broaden the U.S. export controls to include remote access. He told Congress “physical export controls” under current rules do not apply to remote access, allowing China to “access our tech through the cloud” and giving it “a real tool to sidestep” U.S. export restrictions. The bill has passed the House.</p><p><span>Advertisement. Scroll to continue reading.</span></p>","zhKind","complete","政策","大模型","AI 供应链","https://www.securityweek.com/trump-administration-moves-to-block-china-from-indirect-access-to-american-ai-technology/","SecurityWeek",{"_89":90,"_91":-5},"changelogVersion","2026-10-01T08:00","release"]
