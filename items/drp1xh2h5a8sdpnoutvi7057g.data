[{"_1":2,"_3":4},"root",{"_5":94},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1793672466000,"id","drp1xh2h5a8sdpnoutvi7057g","title","A2ABreak 系统分析 A2A v1.0.0 协议并确认 11 项安全问题","originalTitle","G.O.S.S.I.P 阅读推荐 2026-11-02 智能体之间的通信安全吗？","summary","普渡大学和德克萨斯大学达拉斯分校研究者的论文 A2ABreak 对 Google Agent2Agent（A2A）v1.0.0 开展系统性安全分析，经人工复核确认 11 项协议层问题，并剖析跨客户端上下文注入、多跳身份丢失和未经证明的能力声明等 3 项缺陷。","reason","source",{"_72":93},"links",{"_85":92},"publishedAt","2026-11-02T13:07:00.000Z","discoveredAt","2026-11-02T17:46:38.905Z","timelineAt","category","ai-security","tags",[73,88,75,89,90,91],"score",66,"selected",false,"channel","news","story",{"_81":82,"_13":83},"x","readingMode","full","author","body",{"_60":84,"_85":-5,"_86":85,"_87":55},"outline",[],"relatedStories",[80],"topics",[67,68,69,70],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","fqVwsRY7--u0","reportCount",1,"additionalSourceCount",0,{"_71":78,"_72":79},{"_71":76,"_72":77},{"_71":74,"_72":75},{"_71":30,"_72":73},"slug","name","AI 安全","research","技术研究","ai-agent","AI Agent 安全","google","Google / 谷歌",{"_81":82,"_13":83},"publicId","00aa4c0b-df49-464f-9add-a61d0b1d714f","研究者披露A2A v1.0.0协议11项安全问题","<p>原创 <span>guess</span> <span>2026-11-02 21:07</span> <span>上海</span></p><p><img src=\"/dailyinfo/media/169300182e2e6042.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>智能体间通信协议（Agent2Agent，A2A）系统性安全分析</p><p><span><span>让一个智能体收集数据，再找另一个智能体编写代码，最后让第三个智能体生成</span><s><span>学术论文</span></s><span>分析报告，这样的协作需要一套通信协议。今天推荐的论文</span><b><span><span>A2ABreak: Systematic Security Analysis of the A2A Protocol</span></span></b><span>，研究的就是智能体之间的</span><span><span>Agent2Agent</span></span><span>（</span><span><span>A2A</span></span><span>）协议的安全性。这篇论文由普渡大学（</span><span><span>Purdue University</span></span><span>）和德克萨斯大学达拉斯分校（</span><span><span>The University of Texas at Dallas</span></span><span>）的研究者共同完成，已被</span><b><span><span>ACSAC 2026</span></span></b><span>录用：</span></span></p><p><img src=\"/dailyinfo/media/9f959e8526db3014.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>这篇论文</span><b><span>借助大语言模型</span></b><span>，对</span><span><span>Google</span></span><span>推出的</span><b><span>智能体间通信协议（</span><span><span>Agent2Agent</span></span><span>，</span><span><span>A2A</span></span><span>）</span><span><span>v1.0.0</span></span></b><span>进行了系统性安全分析，并经人工复核，确认了</span><b><span><span>11</span></span><span>项</span></b><span>协议本身的安全缺陷。在文章中，作者详细剖析了其中</span><b><span><span>3</span></span><span>个</span></b><span>具有</span><b><span>代表性</span></b><span>的安全缺陷。值得注意的是，本文作者采用了较为严格的威胁模型：假设协议的每个参与者</span><b><span>都遵守</span></b><span>协议规范中的</span><b><span>强制性要求</span></b><span>，并落实了协议中的</span><b><span>推荐性要求</span></b><span>。即便如此，攻击者仍能利用协议允许的操作引发安全问题，这暴露出</span><span><span>A2A</span></span><span>协议仍缺少必要的安全机制。</span></span></p><p><span><span>先来简单介绍一下</span><span><span>A2A</span></span><span>协议。</span><span><span>A2A</span></span><span>被设计为</span><span><span>MCP</span></span><span>的互补性协议：</span><b><span><span>MCP</span></span></b><span>主要规范</span><b><span>智能体怎样调用工具、访问数据源</span></b><span>，</span><b><span><span>A2A</span></span></b><span>则规范</span><b><span>智能体怎样发现其他智能体、完成认证、委托任务并接收结果</span></b><span>。</span><span><span>MCP</span></span><span>和</span><span><span>A2A</span></span><span>两者共同支持智能体完成复杂任务。如下图所示，一个智能体可以通过</span><span><span>MCP</span></span><span>查询数据库，再通过</span><span><span>A2A</span></span><span>将任务交给其他智能体。</span><span><span>A2A</span></span><span>的远端智能体有自己的执行过程，调用方通常看不到它内部怎样推理、使用工具或保存数据。</span></span></p><p><img src=\"/dailyinfo/media/3abd3185043069d2.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>这篇论文研究的是</span><b><span><span>A2A v1.0.0&nbsp;</span></span><span>规范本身</span></b><span>的安全性。在</span><span><span>A2A</span></span><span>协议中，协议规范的强制性程度可以分为</span><b><span><span>MUST</span></span></b><span>、</span><b><span><span>SHOULD</span></span></b><span>和</span><b><span><span>MAY</span></span></b><span>。</span></span></p><p><span><span><span>l</span></span></span><span><span>使用了</span><b><span><span>MUST</span></span></b><span>关键词（包括</span><span><span>MUST NOT</span></span><span>）的条目，要求协议参与者</span><b><span>必须遵循</span></b><span>相应规范，例如规范的§</span><span><span>7.4</span></span><span>中要求“</span><span><span>The A2A Server&nbsp;</span><b><span>MUST</span></b><span>authenticate every incoming request based on the provided credentials and its declared authentication requirements.</span></span><span>”。</span></span></p><p><span><span><span>l</span></span></span><span><span>使用了</span><b><span><span>SHOULD</span></span></b><span>关键词（包括</span><span><span>SHOULD NOT</span></span><span>）的条目，要求协议参与者</span><b><span>原则上应遵守相应规范</span></b><span>，但在特殊情况下有充分理由、理解并权衡后果后，</span><b><span>可以例外</span></b><span>，例如规范的§</span><span><span>8.4.3</span></span><span>中要求“</span><span><span>Clients&nbsp;</span><b><span>SHOULD</span></b><span>&nbsp;verify at least one signature before trusting an Agent Card</span></span><span>”。</span></span></p><p><span><span><span>l</span></span></span><span><span>使用了</span><b><span><span>MAY</span></span></b><span>关键词的条目，要求实现者可以选择做，也可以选择不做相应的操作，例如规范的§</span><span><span>8.4</span></span><span>中提出“</span><span><span>Agent Cards&nbsp;</span><b><span>MAY</span></b><span>&nbsp;be digitally signed using JSON Web Signature (JWS) as defined in RFC 7515 to ensure authenticity and integrity.</span></span><span>”</span></span></p><p><span><span>本文作者假设身份认证和传输安全正常，各方都遵守协议的</span><span><span>MUST</span></span><span>强制要求，落实了</span><span><span>SHOULD</span></span><span>推荐措施，并开启了</span><span><span>Agent Card</span></span><span>签名等</span><span><span>MAY</span></span><span>可选性安全防护。在这些措施都已到位的情况下，作者进一步检查：攻击者能否仅通过协议允许的操作，造成安全威胁。</span></span></p><p><span><span>在原文中，作者先介绍了他们分析框架（</span><span><span>A2ABreak</span></span><span>）的设计和实现，而后介绍了他们发现的</span><b><span><span>11</span></span><span>个安全问题</span></b><span>。在这里，为了给读者一个更直观的感受，我们采取倒叙的形式，先介绍下作者发现的</span><b><span>三个最典型的安全问题</span></b><span>，再介绍他们的</span><span><span>A2ABreak</span></span><span>框架。</span></span></p><p><img src=\"/dailyinfo/media/d62e9bee4680837d.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>第一个安全问题是</span><b><span>跨客户端上下文注入</span></b><span>（</span><span><span>Cross-Client Context Injection</span></span><span>），典例如上图所示。客户端</span><span><span>A</span></span><span>建立了连接，并被分配了上下文编号（</span><span><span>contextId</span></span><span>）</span><span><span>X</span></span><span>，另一个已认证的客户端</span><span><span>B</span></span><span>，</span><b><span>在知道</span><span><span>X</span></span><span>的前提下</span></b><span>，可以只带上</span><span><span>contextId X</span></span><span>、不指定任务编号（</span><span><span>taskId</span></span><span>），</span></span><b><span><span>申请在同一上下文中创建新任务</span></span></b><span><span>。如果服务器只检查任务与上下文的一致性，没有额外的上下文授权机制，这条请求就可能使用</span><span><span>A</span></span><span>积累的历史状态。</span><b><span><span>B</span></span><span>随后可以获得受这些历史信息影响的回复</span></b><span>，</span><b><span>也可以向历史中加入内容，干扰</span><span><span>A</span></span><span>后续的任务</span></b><span>。</span></span></p><p><img src=\"/dailyinfo/media/1d1dc48faa975bf1.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>第二个安全问题是</span><b><span>多跳身份丢失</span></b><span>（</span><span><span>Multi-Hop Identity Loss</span></span><span>），典例如上图所示。用户把任务交给智能体</span><span><span>A</span></span><span>，</span><span><span>A</span></span><span>再交给</span><span><span>B</span></span><span>，</span><span><span>B</span></span><span>又交给</span><span><span>C</span></span><span>。如果每一跳只用自己的身份与下一跳通信，</span><span><span>C</span></span><span>能确认的就只是</span><span><span>B</span></span><span>，用户的原始身份及委托路径没有随任务传过来。当</span><span><span>C</span></span><span>需要第三方资源的访问凭据时，需要用户的授权，因此任务进入</span><span><span>AUTH_REQUIRED</span></span><span>状态，授权请求沿链条返回用户。由于这个</span><b><span>授权请求没有携带可验证的原始主体和委托链信息</span></b><span>，</span><b><span>用户难以判断究竟是谁、为了哪一步操作索要权限</span></b><span>。若用户批准请求，授权凭据会再沿链条转发，且没有充分的接收方限制或持有者绑定。由此，</span><b><span>恶意中间节点</span><span><span>B</span></span><span>就可能截留凭据</span></b><span>并在之后复用。简言之，逐跳认证并不会自动提供端到端的委托来源证明。</span></span></p><p><img src=\"/dailyinfo/media/b95513736f7f1bba.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>第三个安全问题是</span><b><span>未经证明的能力声明</span></b><span>（</span><span><span>Unattested Skill Claims</span></span><span>），典例如上图所示。</span><b><span>智能体通过</span><span><span>Agent Card</span></span><span>宣传自己的技能，调用方据此选择合作对象</span></b><span>。论文指出，</span><span><span>AgentSkill</span></span><span>中的名称、描述和标签都来自智能体自己的声明。即便</span><span><span>Agent Card</span></span><span>带有有效签名，也只能证明卡片由对应的密钥持有者签发、内容未被篡改，</span><b><span>无法证明它确实具备所宣称的能力</span></b><span>。例如，一个</span><b><span>恶意智能体声称自己擅长处理某类敏感业务</span></b><span>。调用方相信这份声明后，将带有机密数据的任务交给它；这样，恶意智能体就可以获取敏感数据，甚至返回编造的结果。整个过程中，消息格式和身份认证均可符合协议要求，协议却无法据此判断能力声明是否真实。</span></span></p><p><span><span>接下来介绍一下作者提出的安全性分析框架</span><span><span>A2ABreak</span></span><span>，其整体思路是：先把自然语言写成的协议规范整理成状态机，再沿着状态之间允许的路径寻找安全问题。其完整流程如下图所示：</span></span></p><p><img src=\"/dailyinfo/media/d0d007e4cbf745eb.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>整个流程分为三部分：</span></span></p><p><span><span><span>l</span></span></span><span><span>左边蓝色区域是</span><b><span><span>Stage A</span></span></b><span>，主要用于</span><b><span>抽取与核对规范中的规则</span></b><span>。</span><b><span><span>A2A Specification</span></span></b><span>是协议原文，也就是</span><span><span>A2A v1.0.0</span></span><span>规范，也是整个分析工具的输入。协议规范规定了消息包含哪些字段、任务有哪些状态，以及客户端和服务器应当怎样处理请求等内容。</span><b><span><span>Stage A1 Structural Extraction</span></span></b><span>从协议规范中提取结构性条目，例如一个任务有哪些可能的状态（“执行中”、“等待授权”、“已完成”等）、一个消息或任务包含哪些字段、哪些字段必须存在、哪些字段不能同时出现等。</span><b><span><span>Stage A2 Behavioral Extraction</span></span></b><span>提取协议明确规定的行为，它会独立再读一遍规范，重点寻找带有</span><span><span>MUST</span></span><span>、</span><span><span>SHOULD</span></span><span>、</span><span><span>MAY</span></span><span>等关键词的条款，整理“在什么情况下，谁应当做什么”。</span><b><span><span>Stage A3 Dedup and Reconciliation</span></span></b><span>合并</span><span><span>A1</span></span><span>和</span><span><span>A2</span></span><span>两轮的结果，处理重复和不一致的情况。</span><b><span><span>Stage A4 Verify Against Specification</span></span></b><span>再将抽取结果逐条与原文对照。论文在经过整个</span><span><span>Stage A</span></span><span>之后，最终得到</span><b><span><span>929</span></span><span>条经过核对的结构化规则语句</span></b><span>。</span></span></p><p><span><span><span>l</span></span></span><span><span>中间绿色区域是</span><b><span><span>Stage B</span></span></b><span>，主要用于</span><b><span>将结构化规则语句构建成状态机</span></b><span>。</span><span><span>A2A</span></span><span>协议规定了</span><b><span>发现、认证、发起、任务执行、中断、终止六个交互阶段</span></b><span>。</span><b><span><span>Stage B1 FSM Input Filter</span></span></b><span>用于挑选适合用来画状态机的规则语句。因为</span><span><span>929</span></span><span>条语句中，有些只描述字段类型、字段是否必填或字段之间的约束，不能直接形成状态机中的节点或箭头，因此</span><span><span>B1</span></span><span>这一步骤进行筛选，最终</span><b><span>选出</span><span><span>283</span></span><span>条语句进入构图过程</span></b><span>。例如，“任务可以处于等待授权状态”能提供一个节点；“收到凭证后恢复执行”能提供一条箭头。</span><b><span><span>Stage B2 Per-Stage FSM Construction</span></span></b><span>分别画出六个阶段的小流程图。</span><b><span><span>Stage B3 Inter-Stage Transitions</span></span></b><span>用于找出六张小流程图之间的连接。</span><b><span><span>Stage B4 Deterministic Merge</span></span></b><span>把小流程图拼成完整的大流程图。</span><b><span><span>Dedup D1 Deterministic Cleanup</span></span></b><span>用于清理按照规则能够明确识别的重复情况，比如同一个状态可能在相邻阶段各出现一次，名称格式也可能不一致。</span><b><span><span>Dedup D2 Semantic Cleanup</span></span></b><span>借助大语言模型，结合协议语义含义进一步清理，处理掉仅靠文字或编号比较难以识别的问题。清理后，论文得到的整个状态机包含</span><b><span><span>37</span></span><span>个状态</span></b><span>和</span><b><span><span>76</span></span><span>条转移</span></b><span>。</span></span></p><p><span><span><span>l</span></span></span><span><span>右边粉色区域是</span><b><span><span>Stage C</span></span></b><span>，主要用于</span><b><span>在状态机中寻找并验证安全问题</span></b><span>。</span><b><span><span>Stage C1 Vulnerability Discovery</span></span></b><span>沿合法流程寻找可能的漏洞。在有了完整的状态机之后，本步骤检查敏感操作前是否缺少必要的权限检查、跨阶段交接时身份或授权信息是否丢失、是否存在绕过必要步骤而直接进入敏感状态的路径等问题。</span><b><span><span>Stage C2 Adversarial Verification</span></span></b><span>进行对抗性验证，给每个候选漏洞安排一位“挑错的审查者”，重点核查攻击路径中的每一步在状态机里是否真的存在、攻击者是否遵守了全部协议要求、规范别处有没有条款已经禁止了这条路径等问题。经</span><b><span>自动检查</span></b><span>后，候选漏洞还要由作者</span><b><span>人工复核</span></b><span>。</span><span><span>Final Verified Findings</span></span><span>输出作者最终确认的安全问题。</span></span></p><p><span><span>图中两个带绿色对勾的小人表示人工检查环节，分别出现在</span><b><span>状态机整理</span></b><span>和</span><b><span>漏洞验证</span></b><span>之后，因此整套流程是自动检查和人工复核共同完成的。</span></span></p><hr><p><span><span>论文最终报告了</span><b><span><span>11</span></span><span>项协议层问题</span></b><span>，这些问题的具体分析也记录在作者公开的分析材料中，参见：</span><span><span><a href=\"https://github.com/arlotfi79/A2ABreak/blob/main/outputs/final_verified.json\">https://github.com/arlotfi79/A2ABreak/blob/main/outputs/final_verified.json</a></span></span><span>。</span></span></p><p><span><span>除了前文介绍过的三个代表性问题之外，还有另外八项问题：</span><b><span>一是签名密钥的来源不够明确</span></b><span>，即使名片签名验证通过，接收方仍需确认验签用的公钥，是否真的属于名片声称的提供方；</span><b><span>二是权限撤销后客户端仍可能继续收到数据</span></b><span>，因为协议缺少在凭证过期或被撤销时及时停止发送的机制；</span><b><span>三是分块传输的结果可能不完整</span></b><span>，例如生成的文件分成多段发送，断线重连后漏掉了中间几段，接收方却仍以为已经收全；</span><b><span>四是多人操作可能造成前后错位</span></b><span>，一方根据旧任务内容作出的回复或确认，可能被用于已经被另一方修改的任务；</span><b><span>五是通知地址未经归属验证</span></b><span>，客户端可以填写不属于自己的网址，诱导服务器向无关网站发送任务信息，甚至反复请求、造成拒绝服务攻击；</span><b><span>六是授权请求可能在转交时被扩大</span></b><span>，例如原本一个智能体只需要读取日历，中间智能体却额外索要读取邮件的权限，上游用户难以核对权限请求来源；</span><b><span>七是委托可能形成循环</span></b><span>，例如</span><span><span>A</span></span><span>找</span><span><span>B</span></span><span>、</span><span><span>B</span></span><span>找</span><span><span>C</span></span><span>、</span><span><span>C</span></span><span>又找回</span><span><span>A</span></span><span>，各方等待授权，任务无法推进；</span><b><span>八是等待中的任务缺少明确的超时退出机制</span></b><span>，用户被要求补充信息或授权后，如果一直不回应，任务就可能长期挂起并占用资源。</span></span></p><p><span><span>也可以看出，虽然作者将所发现的</span><span><span>11</span></span><span>项安全问题都归类为“协议层安全漏洞”，但其中部分问题也具有可靠性问题或并发控制问题的性质，不全是传统的泄密、冒充或越权这一类安全漏洞。</span></span></p><p><span><span>另外值得一提的是，</span><span><span>A2A v1.0.0</span></span><span>规范正式发布的时间是北京时间</span><span><span>2026</span></span><span>年</span><span><span>3</span></span><span>月</span><span><span>13</span></span><span>日，</span><span><span>ACSAC 2026</span></span><span>投稿截止的时间是北京时间</span><span><span>2026</span></span><span>年</span><span><span>5</span></span><span>月</span><span><span>27</span></span><span>日。也就是说，</span><span>从确定分析对象，到设计分析方法、完成测试、撰写稿件，作者<span>最多只用了</span></span><b><span><span>76</span></span><span>天</span></b><span>时间。当然，另一种可能是作者团队可能在正式规范发布前就研究了协议草案，并搭建了分析框架，因此得以在</span><span><span>1.0.0</span></span><span>规范发布后迅速完成了分析。还是不得不感慨，在协议分析已经是安全研究红海的当下，研究目标普遍具有“</span><b><span>手慢无</span></b><span>”的属性：</span><b><span>当你刚刚发现一个新发布的研究对象时，其他研究团队可能已经在撰写论文了</span></b><span>！</span></span></p><p><span><span><span><span>原文链接：<a href=\"https://arxiv.org/abs/2609.10871v2\">https://arxiv.org/abs/2609.10871v2</a></span></span></span></span></p><p><span><span><span><span>会议录用列表：<a href=\"https://www.acsac.org/2026/program/papers/\">https://www.acsac.org/2026/program/papers/</a></span></span></span></span></p><p><span><span><span><span>开源仓库：<a href=\"https://github.com/arlotfi79/A2ABreak\">https://github.com/arlotfi79/A2ABreak</a></span></span></span></span></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=5746b529&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzg5ODUxMzg0Ng%3D%3D%26mid%3D2247502365%26idx%3D1%26sn%3D148d0e8fa43cb7a1ac3283cb0bc86350\">跳转微信打开</a></p>","original","zhKind","complete","论文","Agent 安全","大模型","Google","https://mp.weixin.qq.com/s?__biz=Mzg5ODUxMzg0Ng==&mid=2247502365&idx=1&sn=148d0e8fa43cb7a1ac3283cb0bc86350","安全研究GoSSIP",{"_95":96,"_97":-5},"changelogVersion","2026-10-01T08:00","release"]
