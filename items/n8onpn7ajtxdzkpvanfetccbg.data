[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1794789630000,"id","n8onpn7ajtxdzkpvanfetccbg","title","Microsoft 365 中断导致德国 Hotel Ling Bao 15 名住客氯气中毒","originalTitle","The Microsoft Outage Left 15 Hotel Guests Poisoned by Chlorine","summary","德国 Hotel Ling Bao 的泳池氯气控制系统依赖邮件发送超标告警，Microsoft 云服务中断后告警未能发出，最终造成 15 名住客不适，其中 13 人出现呼吸道刺激，4 人被送医、1 人留院观察。","reason","source",{"_72":97},"links",{"_61":96},"publishedAt","2026-11-15T22:38:00.000Z","discoveredAt","2026-11-15T23:41:47.352Z","timelineAt","category","blue-team","tags",[92,93,94,95],"score",57,"selected",false,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","Pierluigi Paganini","body",{"_88":-5,"_61":89,"_90":-5,"_91":36},"outline",[82],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fWfc-0A5YJ-s","reportCount",1,"additionalSourceCount",0,{"_71":76,"_72":77},{"_71":74,"_72":75},{"_71":30,"_72":73},"slug","name","蓝队与运营","iot","IoT 与车联网","microsoft","Microsoft / 微软",{"_79":80,"_13":81},"publicId","1841fdbe-a24d-4d7c-b044-a3c8a39614ff","微软故障令德国酒店氯气告警失效",{"_11":83,"_84":85,"_86":87},"sec-1","text","A Microsoft 365 outage stopped a hotel’s email chlorine alert in Germany, and 15","level",2,"zh","<h2 id=\"sec-1\">A Microsoft 365 outage stopped a hotel’s email chlorine alert in Germany, and 15 guests were poisoned. </h2><p>A hotel in Germany had a maintenance safety system for its sauna area. If the chlorine level got too high, the system emailed the operators. When Microsoft’s cloud services failed, those emails couldn’t go out, the chlorine rose, and 15 guests were poisoned, <a href=\"https://www.notebookcheck.net/Microsoft-outage-disrupts-email-based-pool-chlorine-monitoring-leaving-hotel-guests-injured.1450526.0.html\">according to Notebookcheck report</a>.</p><p><em>“Over a dozen guests at a theme park hotel in Germany were injured by excessive chlorine levels.” <a href=\"https://www.notebookcheck.net/Microsoft-outage-disrupts-email-based-pool-chlorine-monitoring-leaving-hotel-guests-injured.1450526.0.html\">states Notebookcheck</a>. “According to local media reports, the incident was caused by a problem with the email-based system used to control chlorine dosing, which was affected by the Microsoft outage.”</em></p><p>German emergency services sent 40 first responders. Local media reported that four victims were taken to hospital, and one stayed for further observation. An alarm that depends on email works until the email doesn’t.</p><p><em>“Guests at the Hotel Ling Bao in Phantasialand, Brühl, were injured as a result. They complained of health problems after visiting the pool. The pool was temporarily closed but has since been reopened, as the fire department informed WDR on Saturday.” <a href=\"https://www1.wdr.de/nrw/rheinland/rhein-erft-kreis/technischer-defekt-chlor-phantasialand-100.html\">states WDR</a>. “Due to complaints from hotel guests, emergency services and the fire department were called. Thirteen guests complained of respiratory irritation; ultimately, the number of affected individuals rose to a total of 15.”</em></p><p>The incident shows the danger of relying on email for critical safety alerts. When the email service fails, the warning system fails too.</p><p>The trigger was a global Microsoft outage from 12 to 14 November that hit Outlook and other services. Some Japanese workers went back to fax machines to keep their businesses running. The outage wasn’t as big as the <a href=\"https://securityaffairs.com/165920/security/crowdstrike-epic-fail-crashed-windows.html\">CrowdStrike failure in 2024</a>, which disrupted a huge number of corporate computers, but this one hurt people. Tom’s Hardware notes it could have ended in something worse if the problem hadn’t been caught earlier.</p><p>This incident is a warning for anyone who relies on online services or connected devices to manage safety systems. An alarm that depends entirely on the internet can fail when the connection or cloud service goes down. In this case, the hotel had only one way to send warnings, and that system stopped working.</p><p>The solution is to have a physical or offline backup that continues to work even when internet services are unavailable. Staff must also know how to use it and practice regularly. </p><p><em>“This is one of the issues that institutions must consider when using online services or the <a href=\"https://www.tomshardware.com/news/arduino-portenta-x8-revealed\">Internet of Things</a> to automate systems, especially those that are crucial for safety.” <a href=\"https://www.tomshardware.com/tech-industry/data-centers/microsoft-365-outage-leads-to-chlorine-gas-poisoning-of-15-hotel-guests-email-warning-system-fails-40-first-responders-deployed-for-triage-four-hospitalized\">states Tom’ss Hardware</a>. “Architects of such systems should always have a physical or analog backup that will continue operating even if everything goes offline.”</em></p><p>A backup that nobody knows how to operate is useless. Another option is to run the servers and automation locally, rather than relying on cloud services. However, this requires more work to build and maintain, and it does not protect against local problems such as power outages.</p><p>The incident also shows how much business now <a href=\"https://www.rainews.it/articoli/2026/11/il-caso-microsoft-la-concentrazione-di-dati-e-i-rischi-per-gli-stati-beabbe40-e6ca-4895-b5db-f9ce0bec2732.html\">depends on a few large companies</a>. Microsoft, Google and AWS can offer reliable service at lower cost than smaller rivals or an in-house setup. When one of them goes down, millions of businesses feel it, and economic activity can stall.</p><p>For safety systems, the advice is short: architects of such systems <a href=\"https://www.tomshardware.com/tech-industry/data-centers/microsoft-365-outage-leads-to-chlorine-gas-poisoning-of-15-hotel-guests-email-warning-system-fails-40-first-responders-deployed-for-triage-four-hospitalized\"><strong>should always have a physical or analog backup</strong></a>.</p><p><strong>Follow me on Twitter:&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a><strong></strong></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;hacking,&nbsp;Microsoft Outage)</strong></p>","zhKind","complete","蓝队","加固","IoT","Microsoft","https://securityaffairs.com/203189/security/the-microsoft-outage-left-15-hotel-guests-poisoned-by-chlorine.html","Security Affairs",{"_99":100,"_101":-5},"changelogVersion","2026-10-01T08:00","release"]
