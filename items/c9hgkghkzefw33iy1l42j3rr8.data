[{"_1":2,"_3":4},"root",{"_5":91},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1795912835000,"id","c9hgkghkzefw33iy1l42j3rr8","title","Hex.pm 遭 CVSS 10.0 漏洞 CVE-2026-129514 在野利用，6 台注册服务器被攻陷","originalTitle","Hackers Exploited CVSS 10.0 Hex.pm RCE Flaw to Compromise 6 Package Registry Servers","summary","攻击者利用 Hex.pm 的 CVSS 10.0 漏洞 CVE-2026-129514，通过未认证 POST 请求触发系统命令，攻陷 6 台生产服务器；负载均衡日志记录周一 18:16 至 18:29 UTC 期间来自两个地址的 69 次利用请求。","reason","原文披露了未认证请求触发系统命令的完整利用链，并给出 69 次利用请求、6 台受影响服务器及凭据处置建议，便于读者评估自身依赖与暴露风险。","source",{"_65":90},"links",{"_81":89},"publishedAt","2026-11-25T09:06:59.000Z","discoveredAt","2026-11-25T10:21:33.906Z","timelineAt","category","activity","tags",[66,85,86,87,88],"score",87,"selected",true,"channel","news","story","x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_59":80,"_81":-5,"_82":83,"_84":37},"outline",[71,72],"relatedStories",[],"topics",[60,61,62],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_63":69,"_65":70},{"_63":67,"_65":68},{"_63":64,"_65":66},"slug","exploited","name","在野利用","vuln","漏洞披露","supply-chain","供应链安全",{"_11":78,"_74":79,"_76":77},{"_11":73,"_74":75,"_76":77},"sec-2","text","相关库修复","level",3,"sec-1","Hex 用户现在应该做什么","<p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjBxy4VIOekOumZfm8RElWJl6ZTKoIJ1QLc3U7ynLQ8p9PCqm_kYX1T-akwbZwbthTYcNwfVW-aWbRB4wIkvbUeM_gvQmnw8EH-hpY0542jCwFUAaI2mNEXGE3dct9K4JKFURV1smdERZlx4tV1zCy3AbS_NwF4o926_KSW-OKMPfDXT2gWbbZ4lKjFm6Y/s1600/hex-hack.jpg\"><img alt=\"\" src=\"/dailyinfo/media/f8567d221c45f438.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>攻击者于周一在 <strong>Hex.pm</strong> 的六台生产服务器上运行了操作系统命令。Hex.pm 是软件包注册中心，<strong>Elixir </strong>和 <strong>Erlang </strong>开发者会从中获取依赖项。</p><p>此次攻击所用的漏洞自 2016 年 2 月起就一直存在于该注册中心的代码中；在首次恶意请求出现后约 15 分钟内，维护该服务的团队便让所有服务器都运行了已修补的构建版本。</p><p>此后的检查未发现任何软件包被更改的迹象。团队表示，无法排除攻击者读取了账户数据（如电子邮件地址、密码哈希和双因素身份验证密钥）的可能性。</p><h3 id=\"sec-1\">Hex 用户现在应该做什么</h3><p>由于维护人员替换了用于签署会话和访问令牌的密钥，所有拥有 hex.pm 账户的用户都已被注销登录。他们建议账户持有人采取以下步骤：</p><ul>\n  <li>更改你的 hex.pm 密码。</li>\n  <li>重新设置双因素身份验证：添加新的身份验证器条目，并保存新的恢复代码。</li>\n  <li>使用 mix hex.user auth 重新登录客户端；对于 Erlang 项目，则使用 rebar3 hex user auth。</li>\n  <li>等待下一个版本发布后更新 Hex 客户端，该版本预计将在数日内推出，并将采用新的注册中心签名系统。</li>\n  <li>警惕网络钓鱼。已暴露的电子邮件地址可能会被滥用，因此请检查所有有关 Hex 的电子邮件中的链接是否指向 hex.pm。</li>\n</ul><p>据该团队称，无需替换 API 密钥：这些密钥是随机的 128 位值，仅以 HMAC-SHA256 哈希形式存储，团队表示实际上无法通过暴力破解获得。密码则使用 bcrypt 进行哈希处理，这会减慢猜测速度，但无法阻止对弱密码的猜测，因此修改密码仍然很重要。</p><p>报告作者之一 Peter Ullrich 在 Elixir Forum 的<a href=\"https://forum.elixirforum.com/t/hex-pm-security-incident/77503\">维护者澄清</a>中表示，从未创建 hex.pm 账户、仅获取公共软件包的开发者无需重置任何内容。通过 GitHub 注册的用户仍应重新登录客户端；如果启用了双因素身份验证，也应重新设置。</p><p>在新客户端发布之前，建议仅从 repo.hex.pm 获取软件包，并避免使用第三方镜像。注册中心签名密钥尚未被替换，而它也是攻击者可能读取到的凭据之一。</p><p>该漏洞追踪编号为 <strong>CVE-2026-129514</strong>，CVSS 最高评分为 10.0。它位于 hex.pm 用于读取以 Erlang 数据格式发送的请求正文的解析器中。该解析器在路由和身份验证之前运行，因此，向站点上的任意地址发送未经身份验证的 POST 请求都能到达该解析器。</p><p>解码函数原本应当是安全的，并且确实会阻止诸如函数等危险术语，但它接受包含 __struct__ 键的映射，从而允许请求正文伪装成应用程序已加载的任意 Elixir 结构体。</p><p>本可阻止此问题的安全检查于 2016 年 2 月 23 日从代码中移除，这正是该漏洞存在已久的原因。目前尚未证实此次攻击在周一之前就已被利用。</p><p>精心构造的结构体本身不会执行任何操作。它会引发错误，而错误报告代码随后会检查该结构体。通过 Ecto 和 DBConnection 数据库库进行的这种检查，最终使服务器调用了攻击者选择的函数，该函数随后以注册中心服务账户的权限运行了操作系统命令。</p><p><a href=\"https://github.com/hexpm/hexpm/security/advisories/GHSA-9pmm-hf4r-27pg\">安全公告</a>将 hex.pm 列为受影响组件，受影响时间从 2016 年 2 月 23 日持续至星期一。<a href=\"https://github.com/hexpm/hexpm/commit/379b0a29bcc95164249f38ad7d772a37a8ff9533\">修复提交</a>使解码器拒绝任何包含带有 __struct__ 键的映射的 term，并且截至星期一 18:31 UTC，所有 hex.pm 服务器都已运行该修复。</p><p>Hex.pm 团队昨日在<a href=\"https://hex.pm/blog/security-incident-on-hexpm\">事件报告</a>中表示，负载均衡器日志记录了星期一 18:16 至 18:29 UTC 之间的 69 次漏洞利用请求，这些请求全部来自两个地址。漏洞利用创建的文件出现在六台 web 服务器上，其中一次请求后仅 3 毫秒就出现了文件。攻击期间有三台服务器加入，当时一次重启让仍运行易受攻击构建版本的机器重新上线。</p><p>为检查这些包，团队将每个数据库表与首次漏洞利用请求前两分钟获取的副本进行了比较，并逐一追踪每项差异，确认均属于正常活动。攻击期间发布的 23 个版本全部与审计日志一致，没有较早的版本被更改，当晚写入的包和注册表文件也与数据库记录一致。</p><p>数据库读取、shell 命令、环境变量以及从文件存储直接读取的操作均未被记录。因此，团队写道：“我们无法排除攻击者访问了存储在数据库中的数据的可能性。”该数据库保存着电子邮件地址、密码哈希、API 密钥哈希、双因素身份验证密钥和会话数据，私有包也可能被读取而不留下任何痕迹。</p><p>检查未发现遗留的 shell，审计日志中也没有新账户或新的云密钥。攻击者身份尚不清楚。团队表示，这两个地址从上周晚些时候开始的活动表明，攻击者构建了 hex.pm 的本地副本用于测试。</p><p>一份描述同一漏洞的独立安全报告于星期一 19:07 UTC 通过电子邮件送达，此时攻击已经结束。截至昨日上午，团队已替换攻击者可能读取过的所有凭据，但注册表签名密钥除外。星期一晚上，团队向瑞典数据保护局、美国 CISA 和欧盟 ENISA 报告了此次数据泄露。</p><h3 id=\"sec-2\">相关库修复</h3><p>与此次事件同时，三个广泛使用的 Elixir 库的维护者披露了各自存在的漏洞，涉及使用不受信任数据构建的结构体，并于昨日发布了修复版本。这些属于独立披露的事件，并非针对 Hex.pm 的进一步攻击。</p><table>\n  <tbody>\n       <tr>\n      <th>\n        库\n      </th>\n      <th>\n        CVE\n      </th>\n      <th>\n        受影响版本\n      </th>\n      <th>\n        修复版本\n      </th>\n    </tr>\n    <tr>\n      <td>\n        ash\n      </td>\n      <td>\n        CVE-2026-124283\n      </td>\n      <td>\n        3.31.3 至 3.38.0 之前（不含 3.38.0）\n      </td>\n      <td>\n        3.38.0\n      </td>\n    </tr>\n    <tr>\n      <td>\n        db_connection\n      </td>\n      <td>\n        CVE-2026-133555\n      </td>\n      <td>\n        1.1.0 至 2.10.3 之前（不含 2.10.3）\n      </td>\n      <td>\n        2.10.3\n      </td>\n    </tr>\n    <tr>\n      <td>\n        flop\n      </td>\n      <td>\n        CVE-2026-130411\n      </td>\n      <td>\n        从 0.8.0 开始，各分支中修复版本之前的版本\n      </td>\n      <td>\n        0.26.7, 0.27.3, 0.28.1, 0.29.2\n      </td>\n    </tr>\n  </tbody>\n</table><p>每个漏洞都需要特定条件才能利用。根据<a href=\"https://cna.erlef.org/cves/CVE-2026-124283.html\">Ash 公告</a>，Ash 漏洞要求使用客户端提供的游标进行键集分页、使用某些排序字段类型，并且签名密钥仍保留未设置的默认值。</p><p><a href=\"https://github.com/elixir-ecto/db_connection/security/advisories/GHSA-gmmq-fw75-wq46\">DBConnection 公告</a>称，db_connection 漏洞“单独在 db_connection 中无法利用”，因为必须先由另一个组件将不受信任的数据解码为结构体。根据<a href=\"https://cna.erlef.org/cves/CVE-2026-130411.html\">Flop 公告</a>，Flop 漏洞在其分页游标方面存在类似条件。</p><p>被利用的漏洞位于 hexpm 服务器代码中，而非 Hex 客户端，因此自行运行注册表副本的组织在部署补丁之前都会受到影响。</p><p>觉得这篇文章有意思吗？关注我们的 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a>，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","漏洞利用","漏洞","供应链","数据泄露","https://thehackernews.com/2026/11/hackers-exploited-cvss-100-hexpm-rce.html","The Hacker News",{"_92":93,"_94":-5},"changelogVersion","2026-10-01T08:00","release"]
