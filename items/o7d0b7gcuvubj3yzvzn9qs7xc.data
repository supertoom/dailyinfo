[{"_1":2,"_3":4},"root",{"_5":108},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1795826447000,"id","o7d0b7gcuvubj3yzvzn9qs7xc","title","VulnCheck：凭据收集占 2026 年漏洞利用请求的 13%","originalTitle","Credential harvesting goes from fringe activity to major exploitation trend","summary","VulnCheck 的 canary network 在 2026 年 1 月至 11 月记录了 694 个被利用 CVE，其中 127 个曾用于搜集数据库密码、云密钥、API token 或 SSH key，占 18%；凭据收集请求占全部漏洞利用记录的 13%，月度占比由 1 月约 1% 升至 9 月和 10 月的 25% 至 35%。","reason","文章以漏洞利用记录和请求规模说明凭据收集已成为主要利用趋势，并揭示文件读取与 SSRF 类漏洞中的秘密搜集模式。","source",{"_68":107},"links",{"_96":106},"publishedAt","2026-11-25T06:30:47.000Z","discoveredAt","2026-11-25T06:44:33.000Z","timelineAt","category","activity","tags",[71,100,101,102,69,103,104,105],"score",77,"selected",true,"channel","news","story","x","readingMode","full","author","Sinisa Markovic","body",{"_59":95,"_96":-5,"_97":98,"_99":37},"outline",[80,81,82,83],"relatedStories",[],"topics",[60,61,62,63,64,65],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_66":78,"_68":79},{"_66":76,"_68":77},{"_66":74,"_68":75},{"_66":72,"_68":73},{"_66":70,"_68":71},{"_66":67,"_68":69},"slug","ai-security","name","AI 安全","attack","攻击活动","ai-agent","AI Agent 安全","black-market","数据窃取与黑产","ransomware","勒索软件","identity","身份与访问",{"_11":93,"_85":94,"_87":88},{"_11":91,"_85":92,"_87":88},{"_11":89,"_85":90,"_87":88},{"_11":84,"_85":86,"_87":88},"sec-4","text","窃贼将 AI 密钥也纳入窃取目标","level",3,"sec-3","更低的评分和更大的占比","sec-2","四个月内增长六倍","sec-1","Laravel 和 .env 文件位居榜首","<p>2026 年 1 月至 11 月记录的漏洞利用中，窃取<a href=\"https://www.helpnetsecurity.com/2026/02/18/identity-based-cyberattacks-compromise/\">凭据</a>的请求占 13%。VulnCheck 的金丝雀网络数据显示，其月度占比从 1 月的约 1% 上升至 9 月和 10 月的 25% 至 35%。</p><p>该公司在这十一个月中追踪到 694 个遭到利用的 CVE。攻击者至少使用其中 127 个（18%）一次，以获取数据库密码、云密钥、API 令牌或 SSH 密钥。</p><p>VulnCheck 安全研究员 Patrick Garrity 写道：“收集凭据已成为攻击者利用漏洞的核心方式之一。”</p><h3 id=\"sec-1\">Laravel 和 .env 文件位居榜首</h3><p>应用密钥是最受欢迎的目标。Laravel 密钥招来了来自 4,784 个不同 IP 地址的请求，.env 文件招来了 2,840 个，进程环境变量招来了 2,341 个。云凭据紧随其后，其中 1,687 个 IP 试图获取 AWS 密钥，1,007 个试图获取 Google Cloud 凭据。</p><p>开源软件、AI 产品和开发工具占 127 个 CVE 中的 77 个，而网络边缘设备仅占 10 个。这些漏洞都很新，其中 57% 带有 2025 或 2026 年的编号。</p><h3 id=\"sec-2\">四个月内增长六倍</h3><p>7 月至 10 月间，每月收集记录的实例数从约 17,000 个增至 99,000 个。扫描活动在 8 月和 9 月首先针对 <a href=\"https://www.cve.org/CVERecord?id=CVE-2025-30208\">CVE-2025-30208</a>，这是 Vite 前端工具中的一个文件读取漏洞。随后活动转向 <a href=\"https://www.helpnetsecurity.com/2025/03/24/critical-next-js-auth-bypass-vulnerability-opens-web-apps-to-compromise-cve-2025-29927/\">CVE-2025-29927</a>，这是一个 Next.js 中间件绕过漏洞，产生了 10 月 99,000 条记录中的 68,000 条。</p><p>9 月占比达到峰值 34.5%，部分原因是当月 React2Shell 的利用活动减少，而凭据收集活动仍在增长。</p><h3 id=\"sec-3\">更低的评分和更大的占比</h3><p>用于收集凭据的漏洞中，CVSS 分数中位数为 9.4。中等严重性漏洞仅占名单的 6%，却产生了所有收集记录的 23%。其中包括一个 Laravel 日志泄露漏洞（<a href=\"https://nvd.nist.gov/vuln/detail/cve-2024-29291\">CVE-2024-29291</a>）和一个 Mailpit SSRF 漏洞（<a href=\"https://www.cve.org/CVERecord?id=CVE-2026-21859\">CVE-2026-21859</a>），两者评分均为 5.3。</p><p>文件读取和 SSRF 漏洞并不需要执行代码。Garrity 解释称，利用这些漏洞，攻击者无需在服务器上运行任何程序，就能从中读取密钥。</p><h3 id=\"sec-4\">窃贼将 AI 密钥也纳入窃取目标</h3><p>VulnCheck 首次发现攻击者搜寻 AI 凭据是在 2026 年 5 月，此后每个月都有此类活动。该公司总共记录到来自 406 个唯一 IP 地址的 1,756 次尝试，涉及 27 个 CVE。</p><p><img src=\"/dailyinfo/media/d6fd52a168e28135.webp\" loading=\"lazy\" decoding=\"async\" alt=\"credential harvesting exploitation\" title=\"VulnCheck canary Al credential harvesting activity seen\"></p><p>OpenAI 密钥招来了 1,085 次尝试，Anthropic 的 Claude 密钥招来了 778 次，随后是 Hugging Face（317 次）、Google Gemini（271 次）和 Groq（153 次）。DeepSeek、Mistral 和 OpenRouter 密钥也出现在名单中。有些攻击者向服务器索要配置文件。另一些攻击者在获得代码执行权限后搜索环境变量，或扫描文件系统中的密钥前缀，例如“sk-ant-”和“sk-proj-”。</p><p>针对 Claude Code、OpenAI Codex 和 Cline 等编码代理的凭据文件也遭到搜寻，不过每种目标最多只有五个 IP 地址盯上。</p><p>寻找 AI 密钥的活动在漏洞首次遭到利用后很快便会开始。攻击者利用较旧的 Langflow 和 Vite 漏洞数月之后，才开始通过这些漏洞寻找 AI 密钥。对于大多数在 2026 年年中之后首次遭到利用的 CVE，此类搜寻在数天或数周内便随之开始；对于较新的 Langflow 和 AutoAgent 漏洞，则在一周内开始。</p><p>Garrity <a href=\"https://www.vulncheck.com/blog/credential-harvesting\">指出</a>：“凭据收集依赖一小套极易辨识的利用模式。应针对通过静态和资源前缀实施的路径遍历进行告警。这些攻击大多针对很少收到此类合法请求的互联网暴露应用，因此一次命中就值得调查。”</p>","original","zhKind","translation","complete","漏洞利用","凭据","数据窃取","大模型","AWS","Google","https://www.helpnetsecurity.com/2026/11/25/vulncheck-credential-harvesting-exploitat-records/","Help Net Security",{"_109":110,"_111":-5},"changelogVersion","2026-10-01T08:00","release"]
