[{"_1":2,"_3":4},"root",{"_5":100},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1794195827000,"id","cybbxcwaqk7zfcambubh1quaq","title","CISA 将 SonicWall SonicOS SSLVPN 认证绕过漏洞 CVE-2026-19868 纳入 KEV","originalTitle","U.S. CISA adds SonicWall SonicOS SSLVPN flaw to its Known Exploited Vulnerabilities catalog","summary","CISA 将 SonicWall SonicOS SSLVPN 认证绕过漏洞 CVE-2026-19868 纳入 KEV，CVSS v3.1 7.5。攻击者须持有另一种认证方式的有效凭据，才能绕过 SAML 认证及由其强制执行的 MFA，并非无需认证即可远程访问；SonicWall PSIRT 正在调查可能的利用报告，并建议尽快安装最新更新。","reason","source",{"_74":99},"links",{"_61":98},"publishedAt","2026-11-07T09:09:58.000Z","discoveredAt","2026-11-07T14:42:33.481Z","timelineAt","category","vuln","tags",[94,75,95,78,96,97,80],"score",69,"selected",false,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","Pierluigi Paganini","body",{"_90":-5,"_61":91,"_92":-5,"_93":36},"outline",[85],"relatedStories",[81],"topics",[68,69,70,71],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","ftfx26ruRwX4","reportCount",2,"additionalSourceCount",1,{"_72":79,"_74":80},{"_72":77,"_74":78},{"_72":30,"_74":76},{"_72":73,"_74":75},"slug","exploited","name","在野利用","漏洞披露","identity","身份与访问","cisa","CISA",{"_82":83,"_13":84},"publicId","61a4a753-d4b0-4ce4-9160-1e8081d70415","CISA确认SonicWall认证绕过漏洞遭利用",{"_11":86,"_87":88,"_89":65},"sec-1","text","U.S. CISA adds SonicWall SonicOS SSLVPN vulnerability CVE-2026-19868 to its Know","level","zh","<h2 id=\"sec-1\">U.S. CISA adds SonicWall SonicOS SSLVPN vulnerability CVE-2026-19868 to its Known Exploited Vulnerabilities catalog.</h2><p>The U.S. Cybersecurity and Infrastructure Security Agency (CISA)&nbsp;<a href=\"https://www.cisa.gov/news-events/alerts/2026/11/06/cisa-adds-one-known-exploited-vulnerability-catalog\">added</a> a SonicWall SonicOS SSLVPN flaw, tracked as <a href=\"https://www.cve.org/CVERecord?id=CVE-2026-19868\">CVE-2026-19868</a> (CVSS score of 7.5), to its <a href=\"https://www.cisa.gov/known-exploited-vulnerabilities-catalog\">Known Exploited Vulnerabilities (KEV) catalog</a>.</p><p>CVE-2026-19868 is an authentication bypass vulnerability affecting the SSL VPN service in SonicWall SonicOS.</p><p><em>“An authentication enforcement vulnerability in SonicOS SSLVPN service may allow a user with valid credentials for an alternate authentication method to bypass SAML authentication controls. Successful exploitation may also bypass SAML-enforced multi-factor authentication (MFA).” <a href=\"https://psirt.global.sonicwall.com/vuln-detail/SNWLID-2026-0014\">reads the advisory</a>.</em></p><p>The flaw occurs when the system does not properly enforce SAML authentication controls. An attacker who already has valid credentials for an alternative authentication method may exploit this weakness to bypass SAML-based authentication.</p><p>The impact is particularly serious when organisations rely on SAML to enforce multi-factor authentication (MFA). Successful exploitation may allow an attacker to access the SSL VPN without completing the expected SAML authentication process, potentially bypassing the additional MFA protection.</p><p>In practical terms, the vulnerability could weaken an organisation’s remote access security by allowing users with alternative valid credentials to circumvent its intended authentication controls.</p><p>It’s important to highlight that this is not an unauthenticated remote access vulnerability. The attacker needs valid credentials for an alternative authentication method, but may then bypass SAML-enforced security controls.</p><p>SonicWall’s PSIRT team is investigating a report of possible exploitation of this flaw. The company strongly recommends that customers install the latest available update as soon as possible to reduce the risk of attacks.</p><p><em>“SonicWall PSIRT has investigated a report indicating potential exploitation of this vulnerability. Customers are strongly urged to upgrade to the latest release as soon as possible to mitigate the associated risks.” reads the advisory.</em></p><p>According to&nbsp;<a href=\"https://cyber.dhs.gov/bod/22-01/\">Binding Operational Directive (BOD) 22-01: Reducing the Significant Risk of Known Exploited Vulnerabilities</a>, FCEB agencies have to address the identified vulnerabilities by the due date to protect their networks against attacks exploiting the flaws in the catalog.</p><p>Experts also recommend that private organizations review the&nbsp;<a href=\"https://www.cisa.gov/known-exploited-vulnerabilities-catalog\">Catalog</a>&nbsp;and address the vulnerabilities in their infrastructure.</p><p>CISA orders federal agencies to fix the flaw by&nbsp;November 20, 2026.</p><p><strong>Follow me on Twitter:&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a><strong></strong></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;hacking, <a href=\"https://securityaffairs.com/tag/cisa\">CISA</a>)</strong></p>","zhKind","complete","漏洞","补丁","网络设备","SonicWall","https://securityaffairs.com/202581/security/u-s-cisa-adds-sonicwall-sonicos-sslvpn-flaw-to-its-known-exploited-vulnerabilities-catalog.html","Security Affairs",{"_101":102,"_103":-5},"changelogVersion","2026-10-01T08:00","release"]
