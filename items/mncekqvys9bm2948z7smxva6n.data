[{"_1":2,"_3":4},"root",{"_5":115},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795912842000,"id","mncekqvys9bm2948z7smxva6n","title","高仿 DeepSeek 官网借搜索广告批量投毒，下载安装可触发银狐木马","originalTitle","搜个DeepSeek微信没了，高仿官网正在批量投毒","summary","高仿 DeepSeek 官网通过搜索广告诱导用户下载桌面版安装包，部分安装包被指为“银狐”木马，可导致远程控制、微信盗用、流量劫持和文件丢失。","reason","文章结合仿冒站特征、感染症状与银狐木马行为链，整理了个人和企业可采用的分层防护措施。","source",{"_76":114},"links",{"_107":113},"publishedAt","2026-11-27T03:26:00.000Z","discoveredAt","2026-11-27T05:52:22.734Z","timelineAt","category","activity","tags",[81,79,110,111,112,77],"score",75,"selected",true,"channel","news","story",{"_89":90,"_13":91},"x","readingMode","full","author","body",{"_61":106,"_107":-5,"_108":107,"_109":37},"outline",[92,93,94,95],"relatedStories",[88],"topics",[68,69,70,71,72,73],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fp-fnSYFFr6o","reportCount",2,"additionalSourceCount",1,{"_74":86,"_76":87},{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","ai-security","name","AI 安全","malware","恶意软件","attack","攻击活动","black-market","数据窃取与黑产","email","邮件与钓鱼","supply-chain","供应链安全",{"_89":90,"_13":91},"publicId","e986eeed-64ad-4683-a3e3-84473bae3341","仿冒DeepSeek安装包被指植入金银狐木马",{"_11":104,"_97":105,"_99":65},{"_11":102,"_97":103,"_99":65},{"_11":100,"_97":101,"_99":65},{"_11":96,"_97":98,"_99":65},"sec-4","text","四、普通人四步自保，企业再加三道闸","level","sec-3","三、为什么偏偏是DeepSeek","sec-2","二、装完之后，电脑就不归你了","sec-1","一、假官网做得比真的还像","<p>原创 <span>欢迎关注→</span> <span>2026-11-27 11:26</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/863cf8574438df7b.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>高仿DeepSeek官网批量涌现，搜索广告直接投毒，下载即中银狐木马，微信被盗、电脑被远程控制。</p><p><span>一个普通用户想装个DeepSeek桌面版。搜索、点开排在前面的一条、下载、安装。两小时后，微信被盗、群发垃圾消息、账号被封，电脑被人远程控制。</span></p><p><span>他到现在都没想明白：我只是装了个AI软件，怎么就成这样了？</span></p><h2 id=\"sec-1\"><span>一、假官网做得比真的还像</span></h2><p><span>11月26日，多家媒体报道：近期大量高仿DeepSeek官网涌现，已有不少网友中招。随着DeepSeek对网页端和App端实施限额，不少人转向下载电脑桌面端，黑产就盯上了这个流量入口。</span></p><p><span>这些仿冒站下了功夫。DeepSeek标志性的蓝色鲸鱼Logo、官网的蓝白渐变背景、模型更新公告、AI对话框、深度思考与智能搜索入口，全部照搬。连“探索未至之境”这句宣传语都原样抄过去。乍一看，几乎分不出真假。</span></p><p><span>破绽也有。正版官网首页设计相对简洁，仿冒站往往在页面正中放一个特别醒目的“立即下载”“下载安装包”按钮，恨不得你马上点。域名上也会做手脚，在DeepSeek名称后面加字母、换后缀，不仔细看根本注意不到。</span></p><p><span>请记住两个官方地址：</span><strong><span>官网是 deepseek.com，网页对话是 chat.deepseek.com</span></strong><span>。除此之外的“DeepSeek下载站”，都要打个问号。</span></p><h2 id=\"sec-2\"><span>二、装完之后，电脑就不归你了</span></h2><p><span>根据网友反馈和媒体报道，中招后的症状高度一致：电脑被远程控制，微信账号被盗用并群发垃圾消息，最后账号被封；有人连着手机热点下载，几个小时内异常消耗约200GB流量；还有人发现文件凭空消失、硬盘被格式化。</span></p><p><span>这不是普通的弹窗广告或捆绑软件，而是</span><span><span>远控木马、信息窃取、流量劫持的组合</span></span><span>。部分网友怀疑中招的是“银狐”木马——这个名字国内安全从业者不陌生，它长期伪装成VPN、办公软件、财务工具，靠“白加黑”、合法签名和远控模块在国内传播，专门盯着普通员工和中小企业。</span></p><p><span>这次的套路没变，只是把诱饵换成了最热的AI。安装包天然需要高权限，用户为了用上新工具，往往会一路点“下一步”，UAC弹窗也顺手点了“是”。等到木马落地，杀毒软件再报警，已经晚了一步。</span></p><p><span>远控木马落地后，攻击者能做什么？看你屏幕、动你鼠标、翻你文件、读浏览器里保存的密码，还能把你电脑当跳板去攻击别人。很多人以为“电脑只是卡一点”是小问题，其实后台可能正跑着别人的任务。</span></p><h2 id=\"sec-3\"><span>三、为什么偏偏是DeepSeek</span></h2><p><span>黑产选诱饵的逻辑一直很朴素：哪里流量大、哪里信任高、哪里的人不懂技术，就往哪里投毒。</span></p><p><span>DeepSeek同时满足三条。第一，它是国民级AI产品，搜索量大，用户覆盖广；第二，网页端和App端限额后，大量用户主动去找“桌面版”，需求真实且急迫；第三，普通用户对“官网”的辨识能力有限，看到蓝色鲸鱼就以为是官方。</span></p><p><span>这和前几年银狐借VPN安装包、借远程会议软件传播是同一套剧本。热点在哪，诱饵就在哪。AI只是最新的那个壳。</span></p><p><span>更现实的问题是，很多仿冒站并不是靠自然排名，而是直接买搜索广告。用户搜“DeepSeek下载”，排在第一、带“广告”小字的那个，可能就是钓鱼站。平台审核有滞后，黑产就打时间差：今天封一个，明天换个域名再上。</span></p><h2 id=\"sec-4\"><span>四、普通人四步自保，企业再加三道闸</span></h2><p><span>先说个人，四件事，今天就能做：</span></p><ol><li><strong><span>手动输入域名，不点搜索广告位。</span></strong><p><span>在地址栏敲 deepseek.com，进官网后再找下载入口。搜索结果里带“广告”标识的，一律跳过。</span></p></li><li><strong><span>看域名，不看Logo。</span></strong><p><span>把官网加入收藏夹，以后从收藏进。域名差一个字母都别信。</span></p></li><li><strong><span>安装包先扫再用。</span></strong><p><span>公司电脑走软件白名单或IT统一分发；个人电脑至少用多引擎在线扫描，别关杀毒软件。</span></p></li><li><strong><span>已经装了可疑包的，按这个顺序处理：</span></strong><p><span>立即断网，用手机等其他设备改微信、支付宝、网银密码，全盘查杀，备份重要文件后重装系统。有财产损失的及时报警。</span></p></li></ol><p><span>再说企业。员工在自己电脑上装个AI工具，看起来是小事，但如果这台电脑连着内网、存着客户资料、登着企业微信，风险就完全不一样了。三道闸建议补上：</span></p><ul><li><strong><span>软件来源统一。</span></strong><p><span>AI客户端纳入白名单，由IT从官方渠道下载后统一分发，禁止员工自行搜索下载。</span></p></li><li><strong><span>域名侧封禁。</span></strong><p><span>把已曝光的仿冒域名加进DNS黑名单和代理拦截规则，同时监控“deepseek”相关的新注册域名。</span></p></li><li><strong><span>行为侧监控。</span></strong><p><span>EDR重点看异常外联、短时间内大流量上传、计划任务和服务被创建、浏览器凭据被读取。银狐这类木马藏得再深，也要落地、要外联。</span></p></li></ul><p><span>具体看什么？启动项里多出来的陌生程序、计划任务里指向 AppData 的可执行文件、服务列表里名字像系统组件却没有签名的项、以及凌晨时段的可疑外联。银狐常用“白加黑”，用一个合法签名的程序去加载恶意 DLL，单看文件签名很容易放过，必须结合行为链判断。</span></p><p><span>另外，别把“重装系统”当成万能药。如果备份文件里带着木马，重装完再恢复等于白做。备份前先确认文件干净，或者只恢复文档、照片这类数据，不恢复可执行文件和浏览器配置。</span></p><p><span>还有一条经常被忽略：把“下载AI工具”写进钓鱼演练。别只练“点击陌生链接”，员工真实会做的动作，是搜索一个软件然后点下载。这个场景练一次，比发十封通知管用。</span></p><p><span>AI越火，围着它的骗局就越多。这次是高仿DeepSeek，下次可能是任何一个你正在找的AI工具。</span></p><p><span>记住一句话：官网不是搜出来的，是敲出来的。</span></p><p><span>你省下的那三秒，可能是后面三个月的补救。</span></p><p><span>往期推荐</span></p><p><span>1</span></p><p><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzA5ODA0NDE2MA==&amp;mid=2649790908&amp;idx=1&amp;sn=602e3b11e7e72fa3b9b28ac08289fa50&amp;scene=21#wechat_redirect\">3小时、200美元，AI挖出Java致命0day</a></span></p><p><span>2</span></p><p><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzA5ODA0NDE2MA==&amp;mid=2649790865&amp;idx=1&amp;sn=7400bf43f2e7add2e80cdfee2a7bcaca&amp;scene=21#wechat_redirect\">AI攻破安全厂商，锅在一把没回收的密钥</a></span></p><p><span>3</span></p><p><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzA5ODA0NDE2MA==&amp;mid=2649790864&amp;idx=1&amp;sn=b2cc0de4487cc99defd3bbcfeffab918&amp;scene=21#wechat_redirect\">德国把网络威胁拉到最高档，理由就四个字：智能体 AI</a></span></p><p><span>4</span></p><p><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzA5ODA0NDE2MA==&amp;mid=2649790860&amp;idx=1&amp;sn=7439910e1832c12dbfc98438a80759ec&amp;scene=21#wechat_redirect\">全球第九的超算被黑，丢的是 4224 把 SSH 私钥</a></span></p><p><span>5</span></p><p><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzA5ODA0NDE2MA==&amp;mid=2649790765&amp;idx=1&amp;sn=b6e549209e17e035dfb16fd7103f06f5&amp;scene=21#wechat_redirect\">一句“永远别放弃”，40 个 AI 智能体真的去打了一家真实网站</a></span></p><p><span><span>更多AI知识，请关注Aiker World社区（社区网站：aikerworld.com）</span></span></p><p><span><span><span>欢迎关注Aiker World社区网站</span></span></span></p><p><span><span><span><img alt=\"图片\" src=\"/dailyinfo/media/44eaad9ee71bfec7.webp\" loading=\"lazy\" decoding=\"async\"></span></span></span></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=545046db&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzA5ODA0NDE2MA%3D%3D%26mid%3D2649790963%26idx%3D1%26sn%3D99d16643afb886f536ae5c4ff27031a1\">跳转微信打开</a></p>","original","zhKind","complete","黑产","钓鱼","供应链投毒","https://mp.weixin.qq.com/s?__biz=MzA5ODA0NDE2MA==&mid=2649790963&idx=1&sn=99d16643afb886f536ae5c4ff27031a1","安全客",{"_116":117,"_118":-5},"changelogVersion","2026-10-01T08:00","release"]
