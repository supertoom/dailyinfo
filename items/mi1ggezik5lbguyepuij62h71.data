[{"_1":2,"_3":4},"root",{"_5":118},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1794444096000,"id","mi1ggezik5lbguyepuij62h71","title","SentinelLabs 评估欧洲多国零售制冷系统攻击","originalTitle","Defrost and Disrupt | An Assessment of Europe’s Refrigeration Attacks","summary","Belgium、Estonia、Germany、Ireland、Italy、Luxembourg、Netherlands、Portugal 和 Sweden 于 November 2-3 报告零售制冷系统中断，France 此前约 700 家门店在 October 11-13 受影响。","reason","文章梳理欧洲多国制冷系统中断的时间线，并区分既有事件、攻击者主张与政府归因，可作为判断相关活动是否构成统一战役的参考。","source",{"_68":117},"links",{"_108":116},"publishedAt","2026-11-03T14:57:27.000Z","discoveredAt","2026-11-03T15:02:20.782Z","timelineAt","category","activity","tags",[69,112,113,114,71,79,115],"score",71,"selected",true,"channel","news","story","x","readingMode","full","author","Tom Hegel","body",{"_59":107,"_108":-5,"_109":110,"_111":37},"outline",[80,81,82,83,84,85,86,87],"relatedStories",[],"topics",[60,61,62,63,64,65],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_66":78,"_68":79},{"_66":76,"_68":77},{"_66":74,"_68":75},{"_66":72,"_68":73},{"_66":70,"_68":71},{"_66":67,"_68":69},"slug","attack","name","攻击活动","incident","应急响应","industrial","工业控制","iot","IoT 与车联网","supply-chain","供应链安全","sentinelone","SentinelOne",{"_11":105,"_89":106,"_91":92},{"_11":103,"_89":104,"_91":92},{"_11":101,"_89":102,"_91":92},{"_11":99,"_89":100,"_91":92},{"_11":97,"_89":98,"_91":92},{"_11":95,"_89":96,"_91":92},{"_11":93,"_89":94,"_91":92},{"_11":88,"_89":90,"_91":92},"sec-8","text","结论","level",2,"sec-7","缓解指导","sec-6","展望","sec-5","目标选择与动机","sec-4","归因","sec-3","疑似攻击方法","sec-2","概述与时间线","sec-1","执行摘要","<h2 id=\"sec-1\">执行摘要</h2><ul><li><p>11月2日和3日，比利时、卢森堡、荷兰、瑞典、爱尔兰和爱沙尼亚的超市连锁店报告称，门店制冷系统在夜间出现中断。这些事件发生在法国数百家超市的制冷系统遭攻击三周之后。</p></li><li><p>针对制冷系统的攻击早于2026年的这些事件，其中包括 Danfoss 于2022年记录的针对俄罗斯超市和以色列商店的攻击，以及2024年针对一家洛杉矶肉类加工厂的袭击；美国司法部将后者归因于 CARR。</p></li><li><p>报道和官方声明显示，攻击者通过系统自身的管理界面更改了温度和除霜设置。ANSSI 当时对法国相关事件的评估指出，暴露在互联网上的管理界面以及弱密码是其中的促成因素。</p></li><li><p>包括 CARR、NoName057(16) 和 Z-Pentest 在内的亲俄组织有中断运营技术的记录，并声称曾入侵制冷系统，因此是可信的调查方向。然而，现有证据尚不足以确定欧洲这些事件的责任方。</p></li><li><p>8月美国军事 commissary 发生的冷冻设备故障早于法国的袭击。据报道，美国官员怀疑这些事件与伊朗有关联的参与者所为，但这一评估是初步的，并不涉及欧洲。</p></li><li><p>在相同访问条件仍然存在的地方，进一步事件很可能发生。技术手段的复制和机会主义声明，可能会在调查人员确认是否存在统一行动之前，使无关活动看起来像同一场攻击活动。</p></li></ul><h2 id=\"sec-2\">概述与时间线</h2><p>关于近期欧洲门店制冷系统事件的大量报道推进得很快，有时将这些事件与更早的攻击、黑客行动主义者的声明，以及俄罗斯和伊朗行为体的政府指控混为一谈。以下时间线将事件、声明和评估相互区分。按顺序查看可以看出，类似事件在数月间反复出现在多个国家，但这并不能证明这些不同事件属于同一场攻击活动。</p><p><img src=\"/dailyinfo/media/371fe1e23c8c8e35.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"Refrigeration_Attacks_Chronology.jpeg\"></p><ul><li><p><strong>2022</strong>&nbsp;- Danfoss <a href=\"https://assets.danfoss.com/documents/latest/533772/AO540160316124en-000101.pdf\">记录了</a>针对俄罗斯16家超市并波及以色列40家商店的攻击。据该供应商称，受影响的以色列设施缺少适当的防火墙或 VPN 保护。&nbsp;</p></li><li><p><strong>2024 年 11 月 - </strong>洛杉矶一家肉类加工设施遭到攻击。根据后来美国司法部的指控，该攻击导致肉类变质并引发氨气泄漏。美国司法部<a href=\"https://www.justice.gov/opa/pr/justice-department-announces-actions-combat-two-russian-state-sponsored-cyber-criminal\">将</a>该事件归因于 CyberArmyofRussia_Reborn（简称 CARR）。&nbsp;</p></li><li><p><strong>2025年12月9日 - </strong>美国司法部<a href=\"https://www.justice.gov/opa/pr/justice-department-announces-actions-combat-two-russian-state-sponsored-cyber-criminal\">宣布</a>指控俄罗斯政府支持 CARR 和 NoName057(16)。同期发布的一份多国联合通告记录了相关组织对运营技术发动的机会主义攻击。&nbsp;</p></li><li><p><strong>2026年8月下旬–9月1日 - </strong>制冷故障影响了至少六家美国军事 commissary，即为军事人员提供服务的杂货店。到9月1日，《星条旗报》已<a href=\"https://www.stripes.com/theaters/us/2026-09-01/army-cid-investigates-commissary-refrigerator-outages-22721718.html\">报道称</a>，三个军事刑事调查机构正在调查。因此，在10月有关疑似黑客行为的报道公开之前，这些机构的介入就已为公众所知。&nbsp;</p></li><li><p><strong>2026 年 10 月 11 日至 13 日——</strong>数百家法国超市<a href=\"https://therecord.media/cyberattack-grocery-freezers-europe\">出现</a>制冷中断。巴黎检察机关网络犯罪部门于同一天启动调查；10 月 13 日，经济部长 Roland Lescure 在议会表示约有 700 家门店受到影响。CERT-FR 于 10 月 12 日发布警报，并于 10 月 13 日扩大受影响设备清单。清单包括 Danfoss AK-SM 和 AK-SC 设备，以及 Copeland 和 Dixell XWEB 系统。&nbsp;</p><ul><li><p><strong>更新——</strong>2026 年 11 月 9 日，<a href=\"https://cert.cyber.gouv.fr/uploads/CERTFR-2026-CTI-009.pdf\">法国将</a>10 月 11 日至 13 日针对约 700 个零售场所制冷控制器的&nbsp;破坏行为归咎于 Shahid Kaveh；其所属伊朗革命卫队（IRGC）网络单元最为人知的是其“黑客行动主义者”身份<a href=\"https://www.sentinelone.com/labs/iran-war-cyber-threat-landscape-a-midyear-assessment-on-what-matters\"> CyberAv3ngers</a>。</p></li></ul></li><li><p><strong>2026 年 10 月 21 日——</strong>ANSSI 主任 Vincent Strubel <a href=\"https://redir.gslb.senat.fr/compte-rendu-commissions/20261019/etran.html\">告诉</a>法国参议院，该机构当时的评估指向暴露的管理界面和弱密码，而非早期报道中讨论的、此前已公开披露的漏洞。&nbsp;</p></li><li><p><strong>2026 年 10 月 29 日——</strong>Reuters <a href=\"https://www.reuters.com/technology/pentagon-treating-military-base-freezer-malfunctions-suspected-cyberattack-2026-10-29/\">援引</a>四名官员的报道称，五角大楼正将 8 月的 commissary 故障视为疑似黑客攻击。与此同时，Nextgov/FCW 援引两名知情人士的报道称，官员们怀疑与伊朗有关的行为者。对伊朗的评估是初步判断，且涉及美国案件，而非欧洲事件。&nbsp;</p></li><li><p><strong>2026 年 11 月 2 日至 3 日——</strong>比利时、爱沙尼亚、德国、爱尔兰、意大利、卢森堡、荷兰、葡萄牙和瑞典进一步<a href=\"https://therecord.media/cyberattack-grocery-freezers-europe\">报告了</a>制冷事件。在芬兰，Kesko 也报告了几家较小门店出现温度异常，并表示正在调查原因，但未排除通过网络进行干扰的可能性。&nbsp;</p></li><li><p><strong>2026 年 11 月 4 日更新——</strong>后续报道转载了归因于 NoName057(16) 和 Z-Pentest 的有关欧洲制冷攻击的说法。一段流传的视频点名了 Danfoss 和 Dixell XWEB 设备，而另一篇归因于 NoName 的帖子声称掌握了与 Danfoss 相关的员工和客户凭据。这些说法尚未得到独立验证，也不能证明这些所谓凭据促成了制冷事件，或证明所报道的攻击由同一操作者实施。我们要感谢 DSCO 的同事在这项工作中的协作。</p></li></ul><p>德国的报道体现了事件发生日期与披露日期之间的区别。WDR 于 11 月 2 日报道了北莱茵-威斯特法伦州受影响的门店，而 BR 在 11 月 3 日的报道中描述了 11 月 2 日夜间对 Reisbach 一家 Edeka 门店的操纵。&nbsp;</p><p>我们的时间线显示，制冷攻击早于当前这波攻击。Danfoss 记录了 2022 年针对俄罗斯和以色列门店的攻击，美国司法部则将 2024 年洛杉矶肉类加工事件归因于 CARR。&nbsp;</p><p>美国 commissary 故障发生在法国攻击之前。Reuters <a href=\"https://www.reuters.com/technology/pentagon-treating-military-base-freezer-malfunctions-suspected-cyberattack-2026-10-29/\">于</a>10 月 29 日报道称，五角大楼正将这些故障视为疑似黑客攻击，且美国和法国调查人员正在进行协调，尽管这并不能证明存在共同的作案者。到那时，故障已持续两个月，而军事调查人员的介入自 9 月 1 日起就已公开。</p><p>此外，虽然与俄罗斯有关联的活动和对伊朗的怀疑出现在同一时间线中，是因为两者都属于这些事件的公开记录，但它们涉及不同的行为者和不同的事件群组。与俄罗斯有关联的条目是 2024 年和 2025 年的先例，而对伊朗的怀疑仅涉及美国 commissary 相关案件。</p><h2 id=\"sec-3\">疑似攻击方法</h2><p>这些事件涉及商业监管平台，此类平台集中管理整个场所的制冷设备，使操作员能够监控设备、调整设置、查看警报并远程执行维护。攻击者一旦获得对管理界面的可控制访问权限，便能更改运行设置，并使制冷设备偏离预期条件。</p><p>攻击者如何到达这些界面是另一个问题；然而，早期报道聚焦于 Danfoss 控制器中已公开的漏洞，包括 Claroty <a href=\"https://claroty.com/team82/research/freeze-the-controller-defrost-the-food-uncovering-vulnerabilities-in-danfoss-refrigeration-controllers\">研究</a>中记录的身份验证绕过和命令注入漏洞。10 月 21 日，ANSSI 主任 Vincent Strubel 在法国参议院<a href=\"https://redir.gslb.senat.fr/compte-rendu-commissions/20261019/etran.html\">听证会</a>上表示，根据该机构当时的评估，被利用的并非这些漏洞，而是指向暴露的管理接口和弱密码。</p><p>ANSSI 的评估涵盖法国案件，目前尚不清楚同一访问路径是否适用于 11 月 2 日至 3 日的事件或美国 commissary。对于任何运行未打补丁或已停止支持的控制器的操作员而言，这些已记录的漏洞仍然构成风险。</p><h2 id=\"sec-4\">归因</h2><p>欧洲事件的责任尚未公开确定。亲俄的破坏性行为者是一种可信假设，依据是时间线中展示的先例，包括 DOJ 对 CARR 和 NoName057(16) 的指控，以及将 2024 年洛杉矶事件归因于 CARR。</p><p>值得注意的是，SentinelLABS 此前曾记录 <a href=\"https://www.sentinelone.com/labs/noname05716-the-pro-russian-hacktivist-group-targeting-nato/\">NoName057(16)</a> 如何组织并公开其针对乌克兰和北约国家的 DDoS 行动。</p><p>与 DOJ 指控同时发布的跨国<a href=\"https://www.cisa.gov/news-events/cybersecurity-advisories/aa25-343a\">咨询报告</a>评估称，CARR 管理员和一名 NoName057(16) 管理员因不满 GRU 的支持而随后组建了 Z-Pentest，并且 Z-Pentest 的行动独立于 GRU 的参与。&nbsp;</p><p>DOJ <a href=\"https://www.justice.gov/opa/pr/justice-department-announces-actions-combat-two-russian-state-sponsored-cyber-criminal\">12 月 9 日的公告</a>概述了起诉书的内容，却将 CARR 描述为“又称 Z-Pentest”。这些公开描述并未完全厘清各团体之间的关系，也未明确国家在特定行动中的指挥程度。两者均不能确定当前制冷事件的责任方。</p><p>此后，Z-Pentest 声称实施了一次制冷入侵。该团体发布的一则存档 Telegram 转帖称，其与 NoName057(16) 针对西班牙一家超市的制冷控制设备联合开展行动，并声称获得了能够更改温度和设备运行状态的访问权限。该转帖保留在第三方归档中，但既未证实访问权限，也未证实造成破坏，更未证实与当前攻击存在任何联系。&nbsp;</p><p>根据公开事实，独立的意识形态型操作者、模仿者、以经济利益为动机的入侵者及其他与国家有关联的行为者同样符合可能情况；美国案件中与伊朗有关联的参与也符合这一情况，而官员的<a href=\"https://www.nextgov.com/cybersecurity/2026/10/officials-suspect-iran-series-cyberattacks-military-base-freezers/416934/\">怀疑</a>仍未得到验证。&nbsp;</p><p>要超越这些假设，就需要将受影响环境与某个行为体联系起来的证据，例如访问记录、具有可追溯来源的基础设施、独特的配置变更序列、经验证的账户活动，或包含可核实细节且此前未公开的行为体材料。熟悉的攻击目标、共同的控制器模型或类似温度变化都不足以说明问题，因为破坏同一批设备的方式只有有限的几种明显途径。</p><p>调查人员可能掌握着此类尚未公开的证据。如果没有这些证据，外部观察者目前仍无法独立证实具体的归因。</p><h2 id=\"sec-5\">目标选择与动机</h2><p>在俄罗斯支持的情景下，这些攻击既可能服务于破坏目标，也可能服务于影响目标。对熟悉的民用服务进行明显干扰，可以给支持乌克兰的国家造成代价，并传达出普通服务仍在其触达范围内的信息；这一信息本身无需威胁食品供应。</p><p>选择特定目标也可能出于更简单的原因，即这些系统可以访问。联合通告称，亲俄组织会依据可用性和现有漏洞等表面标准选择受害者，因此，具有战略价值的干扰并不一定涉及在战略层面选择的目标。&nbsp;</p><p>“黑客行动主义者”这一标签描述的是此类组织如何展示自身，并不能可靠反映其能力、独立性或造成损害的潜力。</p><p>尽管如此，动机上的模糊性有时本身就是目的。除了削弱国内民众对政府的信任之外，这是一种资源投入相对较低的入侵活动，却可能给日常生活中的普通人造成代价高昂且不可逆的后果。</p><h2 id=\"sec-6\">展望</h2><p>只要相同的访问条件仍然存在，进一步的尝试就很可能发生。行业和政府组织警告称，亲俄组织使用的廉价、可重复技术可能被其他人采用，而这种疑似方法几乎只需要访问权限，因此持续活动可能涉及先前的行为体、无关组织，或两者兼有。</p><p>新的受害者和机会主义声明可能在调查人员确认是否存在统一行动之前，使无关活动看起来像一场单一活动。针对相似结果，目前已有不止一个疑似行为体：俄罗斯支持的组织是欧洲案例的一种可信假设，而与伊朗有关联的行为体则是美国案例中暂时受到怀疑的对象。</p><p>共享维护访问权限值得审查。葡萄牙的 Mosqueteiros 组织表示，七家 Intermarché 门店发生的事件似乎针对的是一家负责制冷管理的外部供应商。在德国，一家运营商也描述了一起涉及其制冷维护公司的攻击。这些说法使第三方访问成为重要的调查线索，但不能证明存在一家被攻破的供应商、一种跨国通用的入侵路径，或被攻破的软件更新渠道。&nbsp;</p><p>葡萄牙的 Mosqueteiros 团体表示，七家 Intermarché 门店发生的事件似乎涉及一家负责制冷管理的外部供应商。在德国，一位 AWO 代表也描述了一起涉及某家远程维护受影响门店制冷设备的公司所涉攻击。这些运营方的说法使第三方访问成为一项重要的调查线索，但尚不能证明存在一个遭入侵的供应商、跨国的共同入侵路径，或遭入侵的软件更新通道。调查人员应审查是否有账户、网关或管理基础设施连接了多个受影响地点。&nbsp;</p><h2 id=\"sec-7\">缓解指导</h2><p>在安全可行的情况下，应先保存相关日志和配置记录，然后再重启或重置设备。恢复工作应与制冷人员协调，优先确保人身安全和安全的运行条件。<br><br><a href=\"https://cert.cyber.gouv.fr/alerte/CERTFR-2026-ALE-012/\">CERT-FR 的警报</a>针对法国事件列出了受影响 Danfoss、Copeland 和 Dixell 设备运营方应采取的步骤。警报要求移除这些设备以及任何其他暴露在公共 IP 地址上的设备；若移除设备会切断向制冷承包商的数据馈送，则应先核查保险条款；同时应审查完整配置，尤其是除霜范围。警报建议仅通过安全 VPN 或受保护的网络恢复访问，只有在权宜之计期间才可接受使用防火墙过滤承包商的源地址，并应采用制造商的加固指南，例如更新固件和更改默认密码。&nbsp;</p><p>对于遭入侵的设备，警报建议重启或恢复出厂设置后重新进行配置，并警告称，仅重置无法防止仍暴露在网络中的已停止支持设备再次遭入侵。</p><p><a href=\"https://www.fbi.gov/file-repository/cyber-alerts/pro-russia-hacktivists-conduct-opportunistic-attacks-against-us-and-global-critical-infrastructure.pdf\">2025 年 12 月联合通告</a>由 FBI、CISA、NSA 及国际伙伴发布，其缓解措施面向一般的 OT 所有者和运营方。通告建议扫描自有 IP 范围，查找暴露的系统，包括由第三方建立的连接；将 IT 与 OT 网络分段；在可能的情况下使用 MFA，无法使用时应采用强且唯一的密码；并将可远程访问的账户限制为只读。通告还建议审查设定点范围并针对偏差设置告警、备份控制器配置，以及演练手动操作。</p><p>对于暴露在网络中且使用弱密码或默认凭据的系统，通告称应假定其已遭入侵。响应步骤包括隔离受影响主机，通过审查异常认证和近期网络连接来确定入侵范围，签发新凭据，并向相关机构报告入侵事件。</p><h2 id=\"sec-8\">结论</h2><p>针对零售和食品行业制冷系统的攻击早于 2026 年的事件；Danfoss 记录了 2022 年俄罗斯和以色列门店的相关案例，美国司法部则将 2024 年对一家洛杉矶肉类加工商的攻击归因于 CARR。&nbsp;</p><p>在法国案件中，ANSSI 当时的评估指出管理接口暴露且密码薄弱，而 CERT-FR 和联合通告的指导意见直接针对这些问题。&nbsp;</p><p>公开记录尚未确定欧洲事件的责任方，也未确定这些事件是否构成单一攻击活动。只要相同的访问条件仍然存在，其他地方很可能继续发生事件。</p>","original","zhKind","translation","complete","工控","IoT","供应链","CISA","https://www.sentinelone.com/labs/defrost-and-disrupt-an-assessment-of-europe-s-refrigeration-attacks/","SentinelLabs",{"_119":120,"_121":-5},"changelogVersion","2026-10-01T08:00","release"]
