[{"_1":2,"_3":4},"root",{"_5":88},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1795826442000,"id","j4s27xftxuxxz61195rb78ckj","title","Apache Axis CVE-2026-90436 与 Apache Roller CVE-2026-129448 已遭在野利用","originalTitle","Critical Apache Roller, Axis Vulnerabilities Exploited in Attacks","summary","Apache Axis CVE-2026-90436 与 Apache Roller CVE-2026-129448 已被用于真实攻击，两者 CVSS 均为 9.8。","reason","两起利用链均已被安全厂商观测到，文章还给出攻击后凭据获取路径、修复版本和处置期限，便于评估暴露与处置优先级。","source",{"_64":87},"links",{"_77":86},"publishedAt","2026-11-19T12:13:24.000Z","discoveredAt","2026-11-19T12:32:03.794Z","timelineAt","category","vuln","tags",[81,65,82,83,84,85],"score",78,"selected",true,"channel","news","story","x","readingMode","full","author","Eduard Kovacs","body",{"_59":76,"_77":-5,"_78":79,"_80":37},"outline",[67,68],"relatedStories",[],"topics",[60,61],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_62":31,"_64":66},{"_62":63,"_64":65},"slug","exploited","name","在野利用","漏洞披露",{"_11":74,"_70":75,"_72":73},{"_11":69,"_70":71,"_72":73},"sec-2","text","Apache Roller 漏洞同样遭到利用","level",2,"sec-1","Apache Axis 漏洞在攻击中遭到利用","<p><strong>Apache 软件中的两个严重漏洞正遭到利用，CISA 于周三将其中一个漏洞加入了其已知遭利用漏洞（KEV）目录。</strong>\n\n\n\n</p><h2 id=\"sec-1\">Apache Axis 漏洞在攻击中遭到利用</h2><p><a href=\"https://nvd.nist.gov/vuln/detail/cve-2026-90436\">CVE-2026-90436</a>于11月6日公开，是 Apache Axis 1.x（一个已停止维护的 Java SOAP 实现）中的不安全反射漏洞。该缺陷的 CVSS 分数为 9.8，可能允许未经身份验证的攻击者在易受攻击的系统上执行任意代码。\n\n\n</p><p>Rapid7 <a href=\"https://www.rapid7.com/blog/post/etr-rapid7-detected-exploitation-of-cve-2026-90436-against-atlassian-confluence-data-center-n-able-n-central-also-exploited/\">于11月13日检测到利用活动</a>，目标环境运行 Atlassian Confluence Data Center。攻击者执行了数百条命令，使用应用程序的凭据访问 Confluence 数据库，并搜索敏感信息。\n\n\n</p><p>在最初利用发生后的四小时内，攻击者已获取一个服务账户凭据，并开始查询生产环境中的云数据仓库。首次漏洞利用请求后大约十二小时，攻击者使用一个集成服务账户登录了 Microsoft 365。\n\n\n</p><p>Rapid7 还引用了 <a href=\"https://www.securityweek.com/hackers-exploit-new-n-central-zero-day-hours-after-poc-publication/\">N-able 关于攻击活动的报告</a>，其中涉及针对 N-central 的攻击，该攻击与 CVE-2026-90436 高度相关。Confluence 和 N-central 均需要采用非默认配置才会易受攻击。\n\n\n</p><p>此外，Previdian 报告称，在11月12日至19日期间检测到来自14个 IP 地址的<a href=\"https://previdian.com/CVE-2026-90436\">50次漏洞利用尝试</a>。其传感器数据无法确定这些尝试是否成功。</p><p><span>广告。向下滚动以继续阅读。</span></p><p>Apache 计划不发布修复了 Axis 1.x 的版本，并建议迁移到其他 SOAP 引擎或应用其已发布的补丁。\n\n\n</p><p>Confluence Data Center 用户可以升级到9.2.28版或不受影响的10.x版本。N-central 2026.4 HF3 <a href=\"https://www.securityweek.com/n-able-kills-legacy-apis-patches-17-n-central-zero-days/\">禁用了 Legacy API</a> 功能，该功能会暴露存在漏洞的 Axis 组件。\n\n\n</p><p>CISA 已将<a href=\"https://www.cisa.gov/known-exploited-vulnerabilities-catalog\">CVE-2026-90436</a>加入其 KEV 目录，指示联邦机构在11月21日前完成修复。\n\n\n</p><h2 id=\"sec-2\">Apache Roller 漏洞同样遭到利用</h2><p>Apache 还确认了<a href=\"https://lists.apache.org/thread/lnz4s26tv6hdo03wngtdbpfj4hg4gtds\">CVE-2026-129448 正遭到积极利用</a>。这是一个 CVSS 9.8 漏洞，影响其基于 Java 的博客平台 Roller 4.0.0至6.1.4版本。该缺陷允许未经身份验证的远程代码执行。\n\n\n</p><p>Apache 在11月17日发布的公告中表示：“该问题正遭到积极利用”，但未提供有关这些攻击的进一步信息。\n\n\n</p><p>该漏洞源于 Roller XML-RPC 接口中的不安全反序列化，该接口会在身份验证之前处理恶意数据。通过应用程序的管理界面禁用 XML-RPC 并不能阻止漏洞利用。\n\n\n</p><p>Apache 最先于9月以 CVE-2026-82384 公开了同一个底层漏洞。\n\n\n</p><p>Apache 解释道：“这是与 CVE-2026-82384 相同的漏洞，后者仅将 Apache Roller 6.1.5 列为受影响版本。”\n\n\n</p><p>该缺陷已在 Roller 6.1.6 中修复。Apache 建议升级到该版本或更高版本。<a href=\"https://seclists.org/oss-sec/2026/q4/655\">6.1.7版</a>于11月11日发布，修复了另外15个漏洞。\n\n\n</p><p><strong>相关</strong>：<a href=\"https://www.securityweek.com/apache-patches-critical-http-server-rce-found-by-anthropic-google/\">Apache 修补了由 Anthropic、Google 发现的严重 HTTP 服务器远程代码执行漏洞</a>\n\n\n</p><p><strong>相关</strong>：<a href=\"https://www.securityweek.com/java4shell-exploitation-attempts-begin-as-vendors-rush-out-advisories/\">随着各厂商争相发布公告，Java4Shell 漏洞利用尝试已经开始</a>\n\n\n</p><p><strong>相关</strong>：<a href=\"https://www.securityweek.com/php-readies-critical-security-updates-to-patch-another-rce-flaw/\">PHP 准备关键安全更新，以修补另一个远程代码执行漏洞</a>\n\n\n</p>","original","zhKind","translation","complete","漏洞","漏洞利用","Oracle","Atlassian","CISA","https://www.securityweek.com/critical-apache-roller-axis-vulnerabilities-exploited-in-attacks/","SecurityWeek",{"_89":90,"_91":-5},"changelogVersion","2026-10-01T08:00","release"]
