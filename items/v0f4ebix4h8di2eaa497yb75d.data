[{"_1":2,"_3":4},"root",{"_5":121},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1795740049000,"id","v0f4ebix4h8di2eaa497yb75d","title","美军 ATO 持续鉴定工程解剖：从三年一签快照到 cATO 与 AI 鉴定空白","originalTitle","不过期的证：美军ATO持续鉴定工程解剖","summary","这篇分析指出美国国防部运行授权（ATO）三年一签、软件约三周更新一次的制度性错位，指出 2022 年 2 月首席信息官备忘录提出持续运行授权（cATO）并确立 3 根支柱：持续监测、主动网络防御、安全内建的软件供应链。","reason","source",{"_73":120},"links",{"_112":119},"publishedAt","2026-11-25T22:42:31.770Z","discoveredAt","2026-11-26T11:42:31.816Z","timelineAt","category","ai-security","tags",[75,115,116,77,117,118],"score",56,"selected",false,"channel","news","story",{"_81":82,"_13":83},"x","readingMode","full","author","body",{"_60":111,"_112":-5,"_113":112,"_114":55},"outline",[84,85,86,87,88,89,90,91],"relatedStories",[80],"topics",[67,68,69,70],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","fHJFhBndDxOc","reportCount",1,"additionalSourceCount",0,{"_71":78,"_73":79},{"_71":76,"_73":77},{"_71":30,"_73":75},{"_71":72,"_73":74},"slug","policy","name","政策法规","AI 安全","research","技术研究","compliance","合规与标准",{"_81":82,"_13":83},"publicId","7f52a378-00d8-49d6-b4d8-1350c32f9f7a","美军ATO持续鉴定难以覆盖AI变更",{"_11":109,"_93":110,"_95":96},{"_11":107,"_93":108,"_95":96},{"_11":105,"_93":106,"_95":96},{"_11":103,"_93":104,"_95":96},{"_11":101,"_93":102,"_95":96},{"_11":99,"_93":100,"_95":96},{"_11":97,"_93":98,"_95":96},{"_11":92,"_93":94,"_95":96},"sec-8","text","八、实施顺序与值守安排","level",2,"sec-7","七、短板：裁量、仪表盘与语义","sec-6","六、AI组件：骨架可用，考题空白","sec-5","五、终态：常驻流水线与靶场席位","sec-4","四、cATO：三根支柱与授权官","sec-3","三、OSCAL：授权文书变成数据","sec-2","二、持续监测：规范先行，工程滞后","sec-1","一、快照授权：三年一签的证据","<p>美国国防部一套信息系统上线前要先取得运行授权（ATO）：走完风险管理框架的整套流程，编材料、做评估、由授权官签字，一份系统安全计划常有几百页，整个周期以年计。授权有效期定为3年。系统里的软件大约3周更新一版。两个周期摆在一起，结果是一个结构性的错位：证书所描述的那个系统，在签发后不久就不存在了。3年之内系统换过几百个版本，证书还是那一张，它证明的是某个已经过去的时点上的状态。</p><p>这个错位人人都看得见，也被容忍了几十年。容忍的理由是成本：一次全面评估的费用以百万美元计，投入以人年计，任何机构都负担不起更高的频率。证书过期因此算不上设计漏洞，它是成本压出来的结果。要把鉴定频率提上去，先得回答钱从哪里来。这个问题要等自动化把评估成本压下来，才有第二个答案。</p><p>2022年2月，美国国防部首席信息官的一份备忘录把这层窗户纸捅破。文件对现行流程的判断写得很直接：流程“专注于获取系统授权，但授权一旦达成，对风险的持续监测就落了空”。同一份备忘录还写明，要在对抗性空间里对付今天的威胁，“实时或近实时的安全事件数据分析必不可少”。它给出的目标是持续运行授权（cATO），把授权从一次性事件变成持续状态。官方媒体给这次转向起的标题很直白：让持续授权成为网络安全的新黄金标准。</p><p>备忘录的分量不在措辞，在它承认的事实：一套以3年为周期的授权制度，面对以天为节奏的对手，制度本身就成了风险敞口。对手不看证书，看系统的实际姿态。而实际姿态在证书有效期的绝大部分时间里，没有人知道是什么样子。</p><p>这条线索上有4层东西：2011年的持续监测规范、2021年的机器可读语言、2022年的cATO框架，以及人工智能（AI）组件给这套框架留下的空白。四层各有各的文档、格式和预算，也都留下了可以核对的痕迹。判断一次制度变迁，看它留下什么文件、什么数据格式、什么钱，比看它宣示什么目标可靠。</p><p><img src=\"/dailyinfo/media/723285bf12e0f27c.webp\" loading=\"lazy\" decoding=\"async\"></p><h2 id=\"sec-1\">一、快照授权：三年一签的证据</h2><p>传统授权的做法是给系统拍一张快照：在某个时点把安全姿态全面检查一遍，把结论冻结成一份证书，默认它在之后3年里继续成立。3年这个周期不是技术结论，是行政妥协。好比给钢琴调音：师傅上门一次不便宜，多数人家便一年才调一回——走音可不是一年才走一次，是天天都在走。评估也是同一笔账：检查一次的成本高到3年才办得起一次，于是3年这个频率被当成了安全结论的有效期。频率由预算决定，有效期却按风险来理解，快照制度的毛病从这里生出来。鉴定频率的上限等于预算除以单次评估成本，这条算术与威胁的节奏无关，只跟钱有关。</p><p><img src=\"/dailyinfo/media/a75bdce7e2a674c4.webp\" loading=\"lazy\" decoding=\"async\"></p><p>风险管理框架名义上有7步：准备、定级、选控制、实施、评估、授权、监测，走完是一圈。实践里前6步吃掉了全部预算和注意力，第7步监测退化成一份年年照抄的监测计划。这圈流程断在最后一步，框架就成了一道单次关口：过关那天门庭若市，过关之后无人过问。监测这一环并不是没人写，计划年年在编，指标年年在报，缺的是把指标持续变成数据的管道。纸面上的监测与系统里的实际状态之间，隔着一整轮人工汇总。</p><p>这个默认在传统的信息技术（IT）时代就不太站得住：补丁按月发，威胁按天变。到了软件工厂时代，它彻底失效。美国国防部的软件工厂已有50多家，代码按天流动，流水线几分钟就能构建、测试并部署一个新版本。</p><p>快照式鉴定的问题不只是慢，还有激励拧了方向。你想，3年一审的节奏下，所有人的目标自然是让过审那天的状态最好，迎检式安全的做法由此固定下来：审前突击整改，审后自然松弛。安全姿态成了一条以3年为周期的锯齿波，证书恰好总签在波峰上。查的那天最好看，其余时间呢？评估界有句刻薄话，说ATO证明的是系统在被检查的那一刻看起来很安全。话虽刻薄，它指出的激励失真年年都在发生：检查窗口之外的那360天，才是攻击者真正的营业季。</p><p>更要紧的是风险决策的时效。麻烦在这儿：授权官签字依据的是几个月前编好的Word文档和电子表格，落笔的时候证据已经过期——签的是几个月前的系统，不是此刻的系统。等软件出了高危漏洞要连夜上线补丁，摆在面前的是个两难：要么等重审，让部队用着带洞的软件；要么绕过流程，让证书变成废纸。快照式鉴定逼着组织在不安全和不合规之间二选一。备忘录里那句“加速创新的同时跑赢了不断扩张的威胁”，说的是同一件难处。</p><h2 id=\"sec-2\">二、持续监测：规范先行，工程滞后</h2><p>持续鉴定的理念在2011年9月已经成文。美国国家标准与技术研究院（NIST）发布的特别出版物800-137《信息安全持续监测》提出：安全控制的有效性要持续观测，风险态势要近实时更新，授权要建立在持续证据之上。这份文件今天读起来像提前写好的说明书，仪表盘、近实时、持续证据流，都是后来10年才流行的词。它还立了一条容易忽略的组织原则：持续监测要贯穿3个层级，管理层、任务层、系统层各看各的仪表盘，三层对风险的判断要能互相通气。</p><p><img src=\"/dailyinfo/media/851463d53da346a2.webp\" loading=\"lazy\" decoding=\"async\"></p><p>风险管理框架7步法里的第7步直接命名为监测，7步走完，接着就是持续授权：授权官拿到持续更新的证据流，风险态势始终可接受，授权自动延续。三层各有各的时间尺度：系统层的补丁和配置按天变，任务层的行动按周排，管理层的预算按年定。三者不放在同一张桌上，风险就会在层与层之间漏掉。</p><p>规范立了15年，执行这一头长期空转。卡在哪儿？两个工程原因可以解释。证据的形态不对：评估证据多是Word文档、PDF、扫描件，机器读不了，持续更新只能靠人力誊抄，誊抄的速度追不上系统变化的速度。管道也不存在：从安全工具到授权官之间没有自动化的数据通道，“近实时”在纸面流程里是个物理上做不到的要求。</p><p>理念超前工程15年，这类剧本在技术史上反复上演：思想等得起，组织等不起。800-137立的是该做什么，做到需要两样东西：一套机器能读的证书语言，一条能自动生产证据的流水线。你看，这15年里，“持续监测”四个字出现在无数份合规文档的封面上，实际执行停在季度报表。名词普及不等于工程到位，这一点读美国安全政策文献时要常记。空窗期里最忙的是文书：评估报告越写越厚，证据仍然是一次性的。2018年风险管理框架修订版（800-37第2版）把持续授权写成正式术语，算是对这段空窗的官方确认：概念没有错，工程没跟上。</p><h2 id=\"sec-3\">三、OSCAL：授权文书变成数据</h2><p>第一样东西2021年到货：NIST发布开放安全控制评估语言（OSCAL）1.0。它其实只做一件事：把整套授权文书从文档变成数据。推进方式也值得记一笔。NIST没有关起门写标准，而是连年举办公开研讨会，把FedRAMP、各机构和工具厂商一层一层拉到同一套数据模型上。安全标准圈通行写完再征求意见，OSCAL反过来，边磨边写。标准的合法性不靠行政命令，靠工作坊里一轮一轮的磨合。</p><p><img src=\"/dailyinfo/media/d5057ce91111630e.webp\" loading=\"lazy\" decoding=\"async\"></p><p>授权体系里的纸面物件，OSCAL逐项给了机器可读的格式，而且是分层给的。最底层是目录层，控制条目本身：NIST 800-53的1000来条控制，每条拆成机器可读的语句。往上是基线层，从目录里按系统等级挑子集、配参数。再往上是实现层，也就是系统安全计划，每条控制由哪个组件、什么参数、什么做法实现。最上是评估层，评估计划、评估结果、整改计划与里程碑。格式可选：XML、JSON、YAML。</p><p>一份系统安全计划因此不再是300页的Word，而是一棵结构化的数据树：每条控制挂什么参数、由哪个组件实现、上次评估的结论、证据链接指向哪里，全是字段。四层对应评估流程的四个动作：查目录知道该考什么，查基线知道这个等级该考多严，查实现知道被测系统怎么答的，查评估记录知道上次判了什么。一条控制改了目录，不必重写所有系统的文书。分层带来的直接好处是复用：目录全行业共享，基线按系统等级继承，实现层只写差异，安全文档第一次有了继承和引用，写法接近代码。从前两套系统共用一条控制，各自誊一遍，各自漂移；现在都指向同一条机器可读的母本，漂移一眼可查。分工随之清楚：机器负责采集、比对与告警，人负责判断与担责。</p><p>这个转变的分量可以借财务报表演示。账目从传真件变成电子表格之后，审计自动化才有落点。OSCAL之前，持续监测在工程上是空话，没人能持续监测一批散落在Word里的控制状态；OSCAL之后，控制状态、评估结果、证据链接都是可查询、可比对、可版本化的数据，证书从一张照片变成一条数据库记录，而记录可以随时间滚动。财务数据电子化之后，紧接着出现的是审计软件产业，采集、比对、异常告警、底稿生成全部流水线化。安全授权领域在走同一条路，只是晚了20年。经济学也简单：评估里凡能被机器接管的环节，成本趋近于零，频率就可以趋近于连续。持续鉴定相当于把3年一次的大检查拆成流水线上百万次小检查。</p><p>配套的制度推力随后到位。联邦云的FedRAMP全面采用OSCAL；2024年7月，白宫管理和预算办公室的备忘录（M-24-15）直接排出时间表：180天内各机构政策完成调整，18个月内FedRAMP开始接收机器可读的授权和监测材料，24个月内所有治理、风险与合规工具以及系统清单工具必须支持OSCAL。备忘录里最硬的一句是：除非NIST正式指定后继标准，机构必须采用OSCAL。机器可读从可选项变成合规义务。</p><p>把这条时间线和DevSecOps的铺开对着读，图景就完整了。2025年3月的美国国防部DevSecOps现状报告已经把cATO写成软件现代化的既定方向，50多家软件工厂在册。流水线在厂房里转起来，证书的格式在标准里立起来，备忘录把两者钉在一起。持续鉴定需要的三样东西，到这一年都齐了。剩下的是把三样东西接到每条流水线上的细账。</p><h2 id=\"sec-4\">四、cATO：三根支柱与授权官</h2><p>第二样东西是流水线。2022年备忘录之后，国防部的cATO框架立起3根支柱。3根支柱的共同点是把动作变成状态：监测从定期动作变成持续状态，防御从应急动作变成常驻状态，安全从收尾动作变成内建状态。快照制度里每件事都是“做了一次”，cATO里每件事都是“一直在做”。3根支柱并不并列，它们各答一类问题：系统现在什么样，扛不扛得住打，东西是怎么造出来的。</p><p><img src=\"/dailyinfo/media/e4ec4f5bd470c74a.webp\" loading=\"lazy\" decoding=\"async\"></p><p>第一根是持续监测。对风险管理框架各项控制的近实时可见性，靠安全数据从多个来源持续汇聚、持续显示，授权官随时打开仪表盘看到的是此刻的风险态势，不是上个季度的。仪表盘替代了年检。这根支柱的难点在“近实时”三个字背后的工程：漏洞扫描、配置核查、日志审计、补丁状态，每一路数据都要自动采集、自动汇聚、自动对照控制条目。中间留一段人工誊抄，“近实时”就破一次功。持续监测相当于给整个授权体系装了一套生产数据采集系统，被测对象换成了安全姿态本身。采集这一头自动化之后，判断这一头的工作量并没有减少，异常清单变长，筛选本身成了新负担。</p><p>第二根是主动网络防御。被动挨打不够格：要与网络安全服务提供方联动，要有自动化的威胁检测与响应，渗透测试和漏洞评估要成为固定节奏的常设科目，对抗性测试的发现直接回流到持续风险判定。这根支柱把红队从年度体检项目变成常驻科目，其逻辑是防御方在受控条件下持续挨打、持续暴露短板、持续修复，授权的可信度来自“我们一直在被真实地攻击而没有垮”，而不是“我们3年前通过了一次检查”。第三根是安全软件供应链：安全要内建在开发生命周期全程，包括批准的DevSecOps参考设计、自动化的控制门、基础设施即代码。软件从流水线上下来的时候，安全证据跟着工件一起自动产出，属于构建过程的副产品，不用事后补写。这根支柱解决证据的出生证问题，一份评估报告写“我们做了静态扫描”，和流水线日志里躺着每次构建的扫描结果，是两种不同的证据等级。</p><p>3根支柱之上，cATO的定义写得有野心：一个组织在维持弹性网络姿态上展现出足够成熟度，传统的风险评估和授权就“变得冗余”。定义的主体发生了转移。传统ATO授权的是系统，cATO事实上授权的是组织维持安全的能力，证不再发给产品，发给了生产线。业内已经有人敲警钟：别让cATO退化成给人和流程发证，忘了给系统本身发证。生产线合格不等于每个下线产品都合格。</p><p>备忘录之后还有一整套操作化动作：国防部发布cATO评估准则，把3根支柱翻译成逐条检查项，持续监测要展示多源数据汇聚与显示的能力，主动防御要展示与安全服务方的联动和常态化的对抗测试节奏，供应链要展示自动化控制门和基础设施即代码的实施。从备忘录到评估准则，这类制度通常走两步：给方向，再给尺子。评估准则的存在说明cATO已经在过堂，通过的拿到持续资格，通不过的继续走3年一审的老路。逐条检查项的价值在可复核：同一份材料，两个评审组看出的问题应当接近。双轨并行是这个转型期的真实形态。</p><p>授权官的角色也随之改写，从签字的人变成盯盘的人。签字是离散动作，盯盘是持续职责，cATO把授权官从仪式性角色变成操作席位。这个转变容易被低估。签字时代，授权官的责任集中在落笔那一刻，边界清晰；盯盘时代，风险态势天天变，授权官事实上每天都在重新授权。仪表盘上红灯亮起的那一小时里做了什么，成了新的问责焦点。权力跟着仪表盘走，责任也跟着仪表盘走。这是安全管理结构的一次静默调整，而配套的问责细则、值守制度、处置时限，公开文件里还没有写细。</p><h2 id=\"sec-5\">五、终态：常驻流水线与靶场席位</h2><p>把4样东西拼起来，可以描出持续鉴定的终态：持续监测的数据流、机器可读的证书语言、自动产出的证据、行为回归的题库。四样东西里，前三样解决证据怎么来、怎么存，第四样解决证据够不够。在拼出这个形态之前，有一条设计原则要立住：终态的目标是让“发证”这个事件消失。鉴定成为常驻过程之后，“拿到证”这个时刻就不存在了，存在的只有“当前状态可接受”这个持续成立的命题。</p><p><img src=\"/dailyinfo/media/2e181c81740a6ef6.webp\" loading=\"lazy\" decoding=\"async\"></p><p>形态上它不再是一张证，而是一条始终在场的鉴定流水线。系统的每次变更自动触发相应级别的重估，证据自动归集进机器可读的授权文书，授权官的仪表盘实时反映风险态势，重大变更自动升级、触发对抗性复测，靶场的常驻服务对AI组件做行为回归。证书从“一页纸加一个签名”变成“一条滚动曲线加一条证据链”。任何时刻要问系统现在安不安全，答案都是此刻的测量值，不是3年前的合影。这条流水线也要有品质管理：重估分级，小变更走自动回归，大变更走全项复审，异常走势触发人工介入。全自动的流水线不设人工审批环节，那不叫现代化。重估级别与变更级别还要对得上，定低了漏检，定高了排期爆掉。</p><p>这套形态里，靶场的席位变了：从考场的提供者变成鉴定的基础设施。常驻题库、自动化判卷、行为基线库、失误模式档案，前文拆过的家当，在持续鉴定的框架里各自找到了编制。靶场不再等考试上门，它本身就是考试。</p><p>现成的对照是航空适航管理。一架飞机拿到适航证不是故事的结束：日常有维护规程，定检有间隔，事故征候要强制报告，型号设计的大改小改分级审批。航空业用100年时间把一次性发证熬成全寿命适航，靠的是一整套伴飞制度：强制报告、分级审查、数据回收、机队级趋势监控。软件世界的cATO在复刻这条路，AI模型的持续鉴定还站在航空业1920年代的位置。这套制度里最值得抄的是数据回收：机队级的趋势数据，靠每架飞机的运行记录汇总上来。对照的意义在提醒：持续鉴定属于补课，把其他高风险行业已经交过学费的制度在软件世界里重交一遍。</p><h2 id=\"sec-6\">六、AI组件：骨架可用，考题空白</h2><p>把AI放进来，看这套东西够不够用。结论分两层。3根支柱和OSCAL这套骨架撑得住AI，它管的是证据怎么流、证书怎么滚，与被鉴定对象是不是AI无关。撑不住的是内容层：考什么、怎么判、什么算换了脑。骨架现成，考题空白，这是AI持续鉴定的现状。</p><p><img src=\"/dailyinfo/media/f9e3f368df167665.webp\" loading=\"lazy\" decoding=\"async\"></p><p>cATO为传统软件设计的假设是：变化来自代码，代码变化可审。差异对比、回归测试、控制门，每个版本的行为变化原则上能从代码差异里推出来。AI模型打破了这个假设：模型的行为不在代码里，在权重里。两行配置没改、一个权重文件更新，系统行为可能天翻地覆。权重的差异对比，今天没有任何工具能判断这次更新把模型的攻击偏好往哪边挪了3度。</p><p>断裂比表面更深。代码可读，人类评审能逐行看差异；权重不可读，几十亿个参数的浮动，没有人能“审”。你可以把它想成一台封了壳的功放：电路板看不见，只能放一段熟悉的曲子，听它有没有失真——测得出结果，说不清原因。代码时代的鉴定建立在“变更是可理解的”这个地基上；模型时代，地基换成“行为是可测的”。理解不了变更，就只能测量后果。鉴定的重心从审查变更内容转向测量行为变化。这一点在靶场的位置上看得很清楚：系统内部不可读，外部行为测试就成了主要的鉴定途径。行为测试也有代价，它测的是抽样后的行为，覆盖不到的组合仍然要靠推断。</p><p>换脑问题由此拆成3个子问题，个个是空白。第一个是触发器，问的是什么变化触发重新评估。代码世界有现成答案，改了被测组件就重测；模型世界没有。换基础模型、微调、提示词更新、检索库换血、工具链升级，每一层都可能改变行为，而“重大变更”的定义还没有行业标准。难处在于模型的层次太深：一个自主系统可能同时挂着基础大模型、微调适配层、提示词模板、检索库、工具集5层可动件，每层各有更新频率。触发器清单要回答的是系统的“自我”住在哪一层：住得越深，换脑门槛越高，重考代价越大。清单每多一层，重考覆盖的组合就多一档，代价跟着往上涨。2025年7月美国国防部软件工程指南修订版大幅更新了AI和机器学习章节，官方也意识到老指南管不住新物种，但触发器清单这种操作级定义，公开文献里仍然没有。</p><p>第二个是回归对象。传统回归测试问功能有没有退化，模型的回归测试要问行为有没有漂移，而行为测试集本身就是稀缺资产。人工智能网络挑战赛（AIxCC）的注入式命题和靶场的场景库在这里接了头：持续鉴定需要一个常备的、不断更新的行为题库，每次模型更新就自动进考场重考一遍。题库内容也得跟着行为走，不光考还能不能找到那类漏洞，还要考犯错的方式变没变。总分不变而失误模式大改的模型，和总分不变、行为延续的模型，风险含义差得远。靶场于是从一次性考场变成常驻体检中心，鉴定从靶场承办的偶发活动变成靶场提供的常驻服务。题集更新的速度和模型更新的速度要在一个量级上，否则考的是上一代的行为。</p><p>第三个是证据链。持续鉴定意味着证据以流水线速度持续产生，证据本身的可信度成了新的攻击面：监测数据被喂毒、回归结果被粉饰、仪表盘被化妆。证书变成曲线之后，伪造一张证书就变成伪造一段曲线。曲线的伪造比照片隐蔽得多：一张照片假了一眼能看穿，一条曲线被平滑地挪动5%，没有另一条独立曲线对照根本发现不了。OSCAL把文书变成了数据，数据的防伪，包括签名、溯源、不可抵赖，是下一代的功课。这一层的成本比格式统一高得多，也更容易被跳过。</p><h2 id=\"sec-7\">七、短板：裁量、仪表盘与语义</h2><p>持续鉴定方向对头，对头的路上也有自己的薄弱处，且都落在新制度最得意的部位。第一处在成熟度定义。cATO的门槛是“足够成熟度”。问题是，多少算够，备忘录没说，支柱清单也没说，判据落在授权官的自由裁量里。快照时代的裁量是一年一次的大裁量，持续时代变成每天都在做的小裁量。裁量权没有被消除，只是被打散了，而打散的裁量更难审计。裁量散开之后，同类系统的判法容易分叉，一家机构放行的配置，另一家可能要求补材料。</p><p><img src=\"/dailyinfo/media/8deb7d658e4e5ee6.webp\" loading=\"lazy\" decoding=\"async\"></p><p>第二处是仪表盘迷信。持续监测的前提是看得见，可看得见的是控制状态，看不见的是控制的实际有效性。仪表盘上绿灯全亮，能说明什么？可能只是传感器全瞎。监测的是控制还在不在，不是控制还管不管用；后者还得靠渗透测试这类带对抗性的动作，而对抗性测试最难持续。这里有一个度量上的悖论：越容易持续采集的指标，越是表面指标；越深层的有效性验证，越难自动化。仪表盘天然把可见的当成重要的，持续化的努力越深，偏差越大，因为建设者会不自觉地先接那些好接的数据源。接控制状态只要一个接口，接有效性要设计和对抗测试，两者成本差一个量级。</p><p>第三处是给生产线发证的风险。cATO授权组织的能力而不授权单个系统，效率上是对的，风险上是押注：生产线的一次污染，比如恶意提交或供应链投毒，会顺着已授权的管道流到所有下线产品。给流水线的信任越足，流水线的攻击价值越高。cATO把单点故障从系统层挪到了工厂层。另一面也要说：挪到工厂层并非全是坏事，攻击面从上千个各自为政的系统收拢到几十条流水线，防守方终于有了可以集中力量的地方。集中有两面，守得住，风险就压在这几十条线上；守不住，一次失手就是全线失守。</p><p>第四处是OSCAL解决了格式，没有解决语义。机器可读只保证数据能被程序打开，不保证两家机构对同一条控制的理解一致。“审计日志保留90天”里的“保留”指什么，各家实现照样五花八门。格式统一下一步是含义统一，而这一步没有标准答案，只有权威解释，问题又回到裁判身上。格式能自动校验，含义不能，两家机构对同一条控制的分歧最后要靠评审会解决。</p><p>第五处是AI的触发器清单处在政策真空。模型什么时候算换了脑，今天由各厂商自定。把定义权留给被鉴定的对象，等于让考生自定补考规则。这份清单必须由鉴定方立，立得越早越好，等事实标准被厂商习惯养出来，再收权就难了。窗口期不会太长：AI组件进关键系统的速度以月计，制度立法的速度以年计，这个剪刀差每天都在放大。谁先动手，拿到的将不只是规则，还有规则的解释权。</p><p>这5处短板，没有一处能靠买设备补上。</p><h2 id=\"sec-8\">八、实施顺序与值守安排</h2><p>落到建设顺序上，有5件事值得排一排，先后次序本身就是内容。第一件，先把证据机器可读化，再谈持续化。先别急着买仪表盘，先把授权文书搬进结构化数据，格式先行，管道随后，仪表盘是最后一道工序。桥梁健康监测也是这个装法——传感器装得再密，构件编号和竣工图对不上，读数就落不到具体哪根梁上。顺序反了，得到的是一块每天更新的漂亮假表。文书结构化是一次性投入，之后每次变更只改差异字段。</p><p>第二件，给流水线装一条证据旁路。构建、测试、部署的每个环节自动产出安全证据，证据跟着工件走，签名、盖时间戳、进不可篡改的存证。证据是生产的副产品，不用等到年底突击。旁路还有一层防伪义务：证据从产生到呈现之间的每一跳都要可验，否则仪表盘越漂亮，化妆的手艺越值钱。</p><p>第三件，给AI模型立换脑触发器。现在就能立：基础模型更换、微调数据超过阈值、提示词与工具链变更、检索库大规模更新，每一档触发什么级别的重考，白纸黑字写下来。初版粗糙可以接受，空白不能持续。这份清单的立法权要攥在鉴定方手里，一天都不要外包给被鉴定的对象。</p><p>第四件，靶场挂一块常驻体检的牌子。给在役的AI系统提供自动化的行为回归测试，模型每次更新自动进靶场重考，成绩曲线滚动更新。鉴定的细化程度跟上演化的速度，证书才有不过期的可能。第五件，给授权官排值守表。盯盘是新工种，要有班次、有处置时限、有升级流程，红灯亮多久必须响应，什么级别的红灯触发什么级别的处置，写进制度。持续鉴定的最后一公里靠值班室的排班表，制度不到值班室，曲线再漂亮也只是装饰。</p><p>证书从照片变成曲线，是15年的理念、5年的语言、3年的框架叠出来的工程结果。快照的病治了大半，新的病也冒了头：曲线由机器生产、机器呈现，生产证据的机器出了错，或者被收买，曲线就成了谎言的载体。</p><p>持续鉴定把信任从签字那一刻移到整条证据流水线上。证据要溯源、要签名、要交叉验证，鉴定书自己也要被鉴定。在适用边界内，这套办法能回答系统此刻是否可接受；出了边界，比如关键系统的现场处置与人的判断，它给不出答案。国内机构要建这套能力，难点不在曲线，在触发器清单和值守制度，这两样比采集能力更难补。这几样都不需要新理论，缺的是排期和预算。</p><p>声明：本文来自时间之外沉浮事，版权归作者所有。文章内容仅代表作者独立观点，不代表安全内参立场，转载目的在于传递更多信息。如有侵权，请联系 anquanneican@163.com。</p>","original","zhKind","complete","模型安全","治理","标准","合规","https://www.secrss.com/articles/96011","安全内参",{"_122":123,"_124":-5},"changelogVersion","2026-10-01T08:00","release"]
