[{"_1":2,"_3":4},"root",{"_5":100},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795480832000,"id","a5t4y4pmj5g2r43vgy8qp8hnx","title","“银狐”网络攻击活动利用VPN客户端安装包传播Windows木马","originalTitle","关于“银狐”系列网络攻击活动利用VPN客户端软件安装包传播木马病毒的预警报告","summary","国家计算机病毒应急处理中心连续发现多个面向Windows用户的恶意VPN客户端软件安装包，感染后会分阶段释放载荷并加载远程控制功能。攻击者通过搜索引擎结果投毒推广钓鱼网站，诱导下载含木马的“免费VPN”“VPN加速”等安装包；感染后可能冒充用户联系亲友实施诈骗，并可能投送勒索病毒。网络管理员可依据附件1特征开展针对性排查，来源不明文件可在国家计算机病毒协同分析平台检测。","reason","报告揭示了“银狐”借搜索引擎投毒和虚假VPN安装包传播木马的手法，并提供针对性排查与检测建议。","source",{"_76":99},"links",{"_93":98},"publishedAt","2026-11-20T01:16:36.512Z","discoveredAt","2026-11-20T03:16:36.517Z","timelineAt","category","activity","tags",[79,77,96,97,87],"score",78,"selected",true,"channel","news","story",{"_89":90,"_13":91},"x","readingMode","full","author","body",{"_61":92,"_93":-5,"_94":93,"_95":37},"outline",[],"relatedStories",[88],"topics",[68,69,70,71,72,73],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fpYjk-N98PcA","reportCount",1,"additionalSourceCount",0,{"_74":86,"_76":87},{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","malware","name","恶意软件","attack","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","email","邮件与钓鱼","cncert","CNCERT",{"_89":90,"_13":91},"publicId","085c0917-156b-473e-ac67-7cc1138709ae","银狐利用恶意VPN安装包控制Windows","<p><strong>一、</strong><strong>相关病毒案例</strong></p><p>近日，国家计算机病毒应急处理中心和计算机病毒防治技术国家工程实验室依托国家计算机病毒协同分析平台（https://virus.cverc.org.cn）在我国境内连续发现多个包含木马病毒的VPN客户端软件安装包程序，主要针对Windows平台用户。用户一旦运行相关安装程序，恶意程序将在后台自动运行并加载远程控制功能，使攻击者直接获取受害者电脑的控制权，造成受害者个人及所在单位严重信息泄露及财产损失。经分析，发现这些木马病毒均与针对我国用户的“银狐”（又名“游蛇”“谷堕大盗”“UTG－Q－1000”“Silver Fox”等）网络攻击活动相关。病毒样本信息如图1所示。</p><p><img src=\"/dailyinfo/media/ed5a4f74300c48dd.webp\" loading=\"lazy\" decoding=\"async\"></p><p>图1 相关病毒样本信息</p><p>本次发现的木马病毒具有多个版本，均采用与VPN客户端软件捆绑的方式，如图2、图3所示。</p><p><img src=\"/dailyinfo/media/77a9afae2b76443b.webp\" loading=\"lazy\" decoding=\"async\"></p><p>图2 包含木马病毒的VPN软件安装包程序</p><p><img src=\"/dailyinfo/media/20ef896cfc4b89dd.webp\" loading=\"lazy\" decoding=\"async\"></p><p>图3 运行安装包后仅展示VPN</p><p>客户端软件安装信息</p><p>上述木马病毒运行后，恶意代码会被分阶段释放并组合采用多种逃避检测方式，对抗安全软件的能力较强，如图4所示。</p><p><img src=\"/dailyinfo/media/8f35b74139f187f8.webp\" loading=\"lazy\" decoding=\"async\"></p><p>图4 恶意程序加载过程示意图（以winx64-Letsvpnkaulian.x189.exe为例）</p><p>单位网络安全管理员可通过相关技术分析报告（附件1）获取更多木马病毒相关特征，并可通过国家计算机病毒协同分析平台（https://virus.cverc.org.cn）查询相关病毒样本的详细信息。</p><p><strong>二</strong></p><p><strong>风险提示</strong></p><p>1.本次木马病毒攻击活动主要针对Windows计算机操作系统用户。</p><p>2.搜索引擎结果投毒是网络犯罪分子传播相关木马病毒的主要手段。攻击者恶意刷高提供所谓“VPN软件下载”的钓鱼网站的搜索引擎排名，诱导用户下载包含木马病毒的软件安装包。</p><p>3.一旦感染相关木马病毒，可能对企业和个人造成严重的信息泄露及财产损失。网络犯罪分子可能冒充用户身份通过社交媒体软件（微信、钉钉等）针对用户个人生活圈、工作圈的亲友、同事等群体进一步扩散传播并实施侵财诈骗，甚至可能投送勒索病毒，给用户造成更大损失。</p><p><strong>三</strong></p><p><strong>防范措施</strong></p><p>“银狐”系列网络攻击活动持续活跃，欺诈“脚本”不断翻新，滥用人工智能技术不断增强传播能力和对抗能力。建议广大网络用户保持高度警惕，并采取以下防范措施：</p><p>1. 网络用户，特别是各单位网络安全管理员，可参考技术分析报告（附件1）中的木马病毒特征开展针对性的风险排查和防范工作。</p><p>2.切勿听信论坛、社交媒体或短信等非正规渠道中传播的所谓“免费VPN”“VPN加速”“VPN下载”等类似主题广告，不要访问相关网站和下载链接。</p><p>3.遵守网络安全相关法律法规，并依据国家和行业标准全面做好网络防护工作，定期对信息系统和主机进行“安全保养”，检查各项网络安全防护工作是否落实到位，检查内容可参考《网络信息系统和主机网络安全保养卡》（附件2）。</p><p>4.对来源不明的文件可使用国家计算机病毒协同分析平台（https://virus.cverc.org.cn）进行安全检测。</p><p><strong>查看报告详情：https://www.cverc.org.cn/head/zhaiyao/VPN/CVERC-VAR-20261118.pdf</strong></p><p>声明：本文来自国家计算机病毒应急处理中心，版权归作者所有。文章内容仅代表作者独立观点，不代表安全内参立场，转载目的在于传递更多信息。如有侵权，请联系 anquanneican@163.com。</p>","original","zhKind","complete","数据窃取","钓鱼","https://www.secrss.com/articles/95819","安全内参",{"_101":102,"_103":-5},"changelogVersion","2026-10-01T08:00","release"]
