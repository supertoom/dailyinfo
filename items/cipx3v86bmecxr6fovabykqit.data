[{"_1":2,"_3":4},"root",{"_5":110},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795912835000,"id","cipx3v86bmecxr6fovabykqit","title","Booba 勒索软件从美国水处理厂蔓延至地方政府网络","originalTitle","Booba Ransomware Attack on Water Plant Reveals Monitoring Blind Spot","summary","Booba 勒索软件在 11 月从美国东海岸一座水处理厂蔓延至监管该厂的地方政府网络。ThreatDown 仅监控地方政府系统，随后隔离 40 台工作站和 8 台服务器，保护 45 台设备，但已有 3 台被加密；攻击由未安装其软件的另一台计算机发起。","reason","source",{"_77":109},"links",{"_61":108},"publishedAt","2026-11-28T10:51:27.000Z","discoveredAt","2026-11-28T19:30:38.193Z","timelineAt","category","activity","tags",[82,105,80,84,106,107,90],"score",58,"selected",false,"channel","news","story",{"_92":93,"_13":94},"x","readingMode","full","author","Pierluigi Paganini","body",{"_101":-5,"_61":102,"_103":-5,"_104":36},"outline",[95],"relatedStories",[91],"topics",[68,69,70,71,72,73,74],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fN69476m_cR0","reportCount",1,"additionalSourceCount",0,{"_75":89,"_77":90},{"_75":87,"_77":88},{"_75":85,"_77":86},{"_75":83,"_77":84},{"_75":81,"_77":82},{"_75":79,"_77":80},{"_75":76,"_77":78},"slug","blue-team","name","蓝队与运营","malware","恶意软件","attack","攻击活动","incident","应急响应","ransomware","勒索软件","industrial","工业控制","cisa","CISA",{"_92":93,"_13":94},"publicId","617fd246-7c90-4db6-8952-1d57ea230001","Booba勒索攻击蔓延至地方政府网络",{"_11":96,"_97":98,"_99":100},"sec-1","text","Booba ransomware spread from a US water plant to local government systems, expos","level",2,"zh","<h2 id=\"sec-1\">Booba ransomware spread from a US water plant to local government systems, exposing a critical security gap between two networks.</h2><p>Booba ransomware hit an East Coast water treatment plant in November, then reached the network of the local government overseeing it. ThreatDown, which reported the incident, found no evidence that it disrupted water operations.</p><p>The Industrial Cyber report <a href=\"https://industrialcyber.co/threats-attacks/booba-ransomware-spreads-from-us-water-treatment-plant-to-local-government-network-exposing-it-ot-network-security-gap/\">describes</a> a network divided between two providers. ThreatDown’s managed detection and response team monitored the local government’s systems, which stored records and personal data. Another provider managed the water plant’s network. The ThreatDown team discovered this setup only after the customer called.</p><p>The attackers launched their operation from the water plant. They didn’t care that two different providers managed the networks.</p><p>ThreatDown received two or three alerts within a short time. On one computer, almost every file had been renamed with the .booba extension. The encryption came from another machine that didn’t have ThreatDown’s software installed.</p><p><em>“Ransomware hit an East Coast water treatment plant in November, as attacks on water systems pile up across the country. From there, it reached the network of the local government that oversees the plant.” <a href=\"https://www.threatdown.com/blog/ransomware-water-plant-local-government/\">ThreatDown reports</a>. “The ransomware was Booba, which only <a href=\"https://therecord.media/ransomware-university-illinois-chicago\">appeared this summer</a> and <strong>already accounts for 44% of the ransomware compromises our analysts have handled over the last 90 days.</strong> Our MDR team locked down 48 machines at once and saved 45 of them.&nbsp;“</em></p><p>Since the team couldn’t monitor that machine, it decided to isolate 40 workstations and eight servers to contain the attack. The move protected 45 machines, but three had already been encrypted. No further alerts followed.</p><p>The team then sent commands to roll back the three encrypted systems, though the report doesn’t say whether that worked. When the customer asked to reconnect, analysts advised waiting until someone confirmed the plant side was clean. Its provider took every computer there offline for a time and cleaned up on site.</p><p>ThreatDown believes the attackers would’ve encrypted every government machine without its service. Recovery would then have meant reinstalling every system, restoring any usable backups and running a full incident response.</p><p>The company says it increasingly sees ransomware arrive from computers without its software. Those machines give defenders no chance to catch an attack while criminals are preparing it.</p><p>Booba appeared this summer and already accounts for 44% of the ransomware compromises ThreatDown handled over the past 90 days. One analyst thinks ease of use may explain its spread. SOCRadar, which calls it the Booba Project, <a href=\"https://socradar.io/free-tools/ransomware-intelligence/groups/booba-project\">had counted</a> 81 claimed attacks by November 17, including attacks on local governments.</p><p>ThreatDown says attacks on water systems are still uncommon, but the threat is growing. In August, CISA reported that attackers had targeted more than <a href=\"https://securityaffairs.com/197891/ics-scada/cisa-warns-water-utilities-find-your-exposed-plcs-before-attackers-do.html\">100 water and wastewater systems</a> exposed to the internet. Minnesota also <a href=\"https://securityaffairs.com/tag/minnesota-attacks\">reported</a> a coordinated attack on more than 30 community water systems. Some of these incidents forced operators to switch to manual controls or issue boil water notices. However, there is no evidence that the Booba attack caused similar problems.</p><p>It is still unclear what the attackers wanted. ThreatDown never had access to the water plant’s systems for a forensic investigation. There are also no signs of a state-sponsored operation. Booba is a ransomware group linked to cybercrime. However, state-backed groups have targeted water systems in the past. A multiagency advisory, for example, linked one such group to a 2023 breach of a small water authority.</p><p>Small water utilities are also looking for help. The National Rural Water Association recently <a href=\"https://content.nrwa.org/cybersecurity/press-release/16542319/demand-for-cyber-support-to-water-utilities-skyrockets\">said</a> nearly 100 utilities have contacted its Water Watch Center since the program was announced in August 2026. In its first three months, it received requests from water providers in 26 states, from Maine to California.</p><p><em>“Water and wastewater utilities are among the most targeted and least defended pieces of American infrastructure. This year, suspected Iran-linked actors breached water systems in a dozen states. Of the roughly 50,000 community drinking water systems in the U.S., 91% serve small and rural communities.” <a href=\"https://content.nrwa.org/cybersecurity/press-release/16542319/demand-for-cyber-support-to-water-utilities-skyrockets\">concludes NRW</a>. “Similarly, a spate of suspicious and high profile “glitches” at key government and corporate institutions like the FAA, NSA, Microsoft, and United Airlines have water and wastewater operators on edge.”</em></p><p><strong>Follow me on Twitter:&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a><strong></strong></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;hacking,&nbsp;Water Plant)</strong></p>","zhKind","complete","勒索","检测工程","工控","https://securityaffairs.com/204166/cyber-crime/booba-ransomware-attack-on-water-plant-reveals-monitoring-blind-spot.html","Security Affairs",{"_111":112,"_113":-5},"changelogVersion","2026-10-01T08:00","release"]
