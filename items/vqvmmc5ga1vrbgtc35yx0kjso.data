[{"_1":2,"_3":4},"root",{"_5":105},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1795480845000,"id","vqvmmc5ga1vrbgtc35yx0kjso","title","Cequence：恶意机器人借 AI Agent 名义探测密钥，Agent 从只读转向登录下单","originalTitle","Bots Hide Behind AI Agent Names to Hunt for Secrets","summary","Cequence 于 11 月 23 日发布 Agentic AI Security Index，基于其保护的业务在 5 月 16 日至 11 月 15 日采集的遥测数据。","reason","source",{"_71":104},"links",{"_60":103},"publishedAt","2026-11-23T16:00:00.000Z","discoveredAt","2026-11-23T16:37:37.450Z","timelineAt","category","ai-security","tags",[72,100,76,74,101,102],"score",63,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body",{"_96":-5,"_60":97,"_98":-5,"_99":36},"outline",[81,82,83,84],"relatedStories",[77],"topics",[67,68,69],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fy11250q_upU","reportCount",1,"additionalSourceCount",0,{"_70":75,"_71":76},{"_70":73,"_71":74},{"_70":30,"_71":72},"slug","name","AI 安全","research","技术研究","ai-offense","AI 攻防",{"_78":79,"_13":80},"publicId","cd6953a8-67fb-428f-86e3-4424e22f5531","Cequence发布代理式AI安全指数",{"_11":94,"_86":95,"_88":89},{"_11":92,"_86":93,"_88":89},{"_11":90,"_86":91,"_88":89},{"_11":85,"_86":87,"_88":89},"sec-4","text","What’s Hot on Infosecurity Magazine?","level",2,"sec-3","AI Agents Shift From Reading to Buying","sec-2","Bots Probe For Secrets Using Agent Names","sec-1","Written by","zh","<h2 id=\"sec-1\">Written by</h2><p><img src=\"/dailyinfo/media/cf2788318d81d27e.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Photo of Alessandro  Mascellino\"></p><p>\n\tMalicious bots have increasingly used AI agents' names as cover to hunt for secrets, while the agents themselves have moved from simply reading websites to signing in, booking and buying, according to Cequence.</p><p>\n\t\n\tThe security company detailed the findings in its <em>Agentic AI Security Index</em>, published November 23 and based on telemetry from the businesses it protects, collected between May 16 and November 15. Cequence argued that the more agents were trusted to log in and make purchases, the more their names were worth to bots posing as them.</p><h2 id=\"sec-2\">\n\t<strong>Bots Probe For Secrets Using Agent Names</strong></h2><p>\n\tThe probing targeted configuration files, keys and admin consoles. Cequence's chart below shows how many visits a day came from bots doing this under AI agents' names. The bot traffic climbed in waves from fewer than 30 a day in May to a peak of around 1450 in mid-October and was still about 1000 a day in late October. Cequence blocked 37,917 of these visits over the period.</p><figure><img src=\"/dailyinfo/media/2298e11a25022f79.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Daily visits from bots using AI agent names to probe for secrets, by week, May 16 to November 15, 2026. Data for the final week is incomplete. Source: Cequence.\"><figcaption>Daily visits from bots using AI agent names to probe for secrets, by week, May 16 to November 15, 2026. Data for the final week is incomplete. Source: Cequence.</figcaption></figure><p>\n\tOf the visits that claimed to come from Perplexity agents, 63% were probing for secrets. Cequence cautioned that agent names were self-reported and open to any bot, so the figure did not show Perplexity itself was behind the probing.</p><p>\n\tDana Simberkoff, chief risk, privacy and information security officer at AvePoint, noted that organizations needed least-privilege access, identity controls, monitoring, audit trails and human approval for high-risk actions.</p><p>\n\tAviv Nahum, co-founder and CEO at Above Security, added that organizations \"must treat AI agents as first-class identities and a new class of insiders.\"</p><p>\n\t<em><a href=\"https://www.infosecurity-magazine.com/news/ai-drives-surge-in-bot-and-api/\">Read more on AI-driven bot traffic: AI Drives Surge in Bot and API Threats</a></em></p><h2 id=\"sec-3\">\n\t<strong>AI Agents Shift From Reading to Buying</strong></h2><p>\n\tAmong established AI agents tracked throughout the study, 13% of visits involved taking action in November, up from 1.4% in May. Taking action meant signing in, booking, buying, managing an account or paying. Action-taking visits grew 240%, while read-only visits fell 73%.</p><figure><img src=\"/dailyinfo/media/b26f763620ea6bcf.webp\" loading=\"lazy\" decoding=\"async\" alt=\"How visits by established AI agents changed each month against May: visits that took action rose while those that only read or browsed fell. Source: Cequence.\"><figcaption>How visits by established AI agents changed each month against May: visits that took action rose while those that only read or browsed fell. Source: Cequence.</figcaption></figure><p>\n\tSix new agent types appeared between September 25 and October 7, including Meta Muse, Google's shopping crawler and an Amazon agent. Meta Muse took action on 51% of its visits in its first 30 days and was behind 40% of all action-taking agent visits over that period.</p><p>\n\tDuring early holiday deals from November 5 to 15, 3% of agent visits ended in a purchase, against 0.2% normally. Black Friday and Cyber Monday fell outside the data window.</p><p>\n\tCequence recommended that organizations identify which agents they were serving and govern them by behavior rather than by the names they claimed.</p><h2 id=\"sec-4\">What’s Hot on Infosecurity Magazine?</h2>","zhKind","complete","Agent 安全","Google","AWS","https://www.infosecurity-magazine.com/news/secrethunting-trafficai-agent/","Infosecurity Magazine",{"_106":107,"_108":-5},"changelogVersion","2026-10-01T08:00","release"]
