[{"_1":2,"_3":4},"root",{"_5":92},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1794616837000,"id","zpb2ssql27cv42fsc5sdln95g","title","Atlantis PR 控制的 Terraform workspace 存在 OS 命令注入并可导致 RCE","originalTitle","Atlantis: OS command injection through PR-controlled Terraform workspace enables RCE during plan","summary","Atlantis 将 PR 中 `atlantis.yaml` 的 `workspace` 字段未经转义传入 shell，导致可触发 `atlantis plan` 的贡献者以 Atlantis 服务账户权限执行任意命令并实现 RCE。","reason","文章完整追踪了 Atlantis 工作区字段到 shell 执行的利用链，并给出可复现的 PoC、前置条件与基于参数向量执行的修复方向。","source",{"_73":91},"links",{"_60":90},"publishedAt","2026-10-27T21:04:50.000Z","discoveredAt","2026-10-28T09:01:41.009Z","timelineAt","category","vuln","tags",[84,85,86,87,88,89],"score",72,"selected",true,"channel","news","story",{"_81":82,"_13":83},"x","readingMode","full","author","body","outline",[],"relatedStories",[80],"topics",[67,68,69,70],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fvUSBjv4kxNI","reportCount",1,"additionalSourceCount",0,{"_71":78,"_73":79},{"_71":76,"_73":77},{"_71":31,"_73":75},{"_71":72,"_73":74},"slug","research","name","技术研究","漏洞披露","identity","身份与访问","supply-chain","供应链安全",{"_81":82,"_13":83},"publicId","cc52f941-2db7-4b32-9890-e3dd78d04238","Atlantis 工作区命令注入可致RCE","漏洞","复现","漏洞利用","漏洞分析","供应链","凭据","https://github.com/advisories/GHSA-rjh2-4xgw-p2hj","GitHub 安全公告",{"_93":94,"_95":-5},"changelogVersion","2026-10-01T08:00","release"]
