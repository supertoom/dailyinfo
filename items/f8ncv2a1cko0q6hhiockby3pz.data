[{"_1":2,"_3":4},"root",{"_5":154},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795135236000,"id","f8ncv2a1cko0q6hhiockby3pz","title","Microsoft 揭示设备码钓鱼对 GitHub Copilot CLI 代理的四类影响","originalTitle","The risks of device code authentication for AI coding agents","summary","Microsoft 以 GitHub Copilot CLI 为例说明，攻击者诱使用户批准设备码授权后，可在实验环境中远程操控已启用远程控制的会话、植入误导性记忆、读取云同步会话及访问私有仓库。","reason","受控实验揭示了设备码钓鱼接入 AI 编程代理后的四类风险，并给出可落地的检测、处置和权限收敛方法。","source",{"_76":153},"links",{"_142":152},"publishedAt","2026-11-17T15:00:00.000Z","discoveredAt","2026-11-17T17:20:32.997Z","timelineAt","category","ai-security","tags",[78,146,80,147,148,149,150,151],"score",76,"selected",true,"channel","news","story",{"_88":89,"_13":90},"x","readingMode","full","author","Uri Oren","body",{"_61":141,"_142":-5,"_143":144,"_145":37},"outline",[91,92,93,94,95,96,97,98,99,100,101,102,103,104,105],"relatedStories",[87],"topics",[68,69,70,71,72,73],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fy_IzlPBNxcM","reportCount",1,"additionalSourceCount",0,{"_74":85,"_76":86},{"_74":83,"_76":84},{"_74":81,"_76":82},{"_74":79,"_76":80},{"_74":31,"_76":78},{"_74":75,"_76":77},"slug","blue-team","name","蓝队与运营","AI 安全","research","技术研究","vuln","漏洞披露","email","邮件与钓鱼","microsoft","Microsoft / 微软",{"_88":89,"_13":90},"publicId","294be0bb-48d2-4222-8ded-e33845e5eb9c","Microsoft揭示设备码钓鱼劫持编码代理",{"_11":139,"_107":140,"_109":110},{"_11":137,"_107":138,"_109":110},{"_11":135,"_107":136,"_109":115},{"_11":132,"_107":133,"_109":134},{"_11":130,"_107":131,"_109":110},{"_11":128,"_107":129,"_109":115},{"_11":126,"_107":127,"_109":115},{"_11":124,"_107":125,"_109":115},{"_11":122,"_107":123,"_109":115},{"_11":120,"_107":121,"_109":110},{"_11":118,"_107":119,"_109":110},{"_11":116,"_107":117,"_109":115},{"_11":113,"_107":114,"_109":115},{"_11":111,"_107":112,"_109":110},{"_11":106,"_107":108,"_109":110},"sec-15","text","了解更多","level",2,"sec-14","参考","sec-13","观察到的 MITRE ATT&amp;CK 技术",3,"sec-12","请记住：合法的登录也可能是错误的登录","sec-11","缓解与保护指南","sec-10","将钓鱼企图转化为 Defender 检测信号","sec-9","4. 仓库访问权限取决于账户","sec-8","3. 同步会话会泄露更早的上下文","sec-7","2. 记忆可以将攻击延续下去","sec-6","1. 攻击者可以操纵已启用的远程会话","sec-5","一次批准，影响扩散的四种方式","sec-4","请求看起来是合法的",4,"sec-3","短码背后的请求","sec-2","攻击是如何运作的","sec-1","从熟悉的钓鱼手法到 AI 编码代理","<ol><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/17/the-risks-of-device-code-authentication-for-ai-coding-agents/#from-a-familiar-phishing-technique-to-an-ai-coding-agent\">从熟悉的钓鱼手法到 AI 编码代理</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/17/the-risks-of-device-code-authentication-for-ai-coding-agents/#how-the-attack-works\">攻击是如何运作的</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/17/the-risks-of-device-code-authentication-for-ai-coding-agents/#one-approval-four-ways-the-impact-can-spread\">一次授权，冲击可沿四条路径扩散</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/17/the-risks-of-device-code-authentication-for-ai-coding-agents/#turning-a-phishing-attempt-into-a-defender-signal\">把钓鱼尝试转化为 Defender 遥测信号</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/17/the-risks-of-device-code-authentication-for-ai-coding-agents/#mitigation-and-protection-guidance\">缓解与防护建议</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/17/the-risks-of-device-code-authentication-for-ai-coding-agents/#references\">参考</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/17/the-risks-of-device-code-authentication-for-ai-coding-agents/#learn-more\">了解更多</a></li></ol><p>设备代码钓鱼已成为账号接管的一条反复出现的途径。攻击者不窃取密码，而是通过让某人输入一个代码，说服其在合法站点上批准一次登录。由此获得的访问权限通常可触达邮箱、文件或其他云服务，具体取决于该账号以及所授予的权限。诸如 <a href=\"https://www.microsoft.com/en-us/security/blog/2026/09/22/unmasking-eviltokens-getting-to-the-root-of-device-code-phishing/\">EvilTokens</a> 这样较早的著名行动表明，这项技术可以轻易被规模化以造成真实危害。微软与行业和执法部门的合作伙伴共同努力，于 2026 年 9 月<a href=\"https://blogs.microsoft.com/on-the-issues/2026/09/22/disrupting-eviltokens-the-ai-chatbot-built-for-cybercrime/\">捣毁了 EvilTokens</a>。</p><p>这让我们想到另一个问题：攻击者拿到被钓取的设备代码授权后还能做什么？当同样的把戏针对的是 AI 代理而非邮箱时会发生什么？</p><p>我们以 GitHub Copilot CLI 作为示例。根据其配置，它可以处理代码、在用户机器上运行命令、跨会话保留上下文，并允许活跃会话被远程操控。与许多命令行工具一样，它支持使用 OAuth 设备流程进行登录。这种钓鱼技术本身并不专属于 GitHub 或 Copilot CLI：任何支持设备流程的公共客户端都能以同样方式被滥用，且攻击者在发起流程时可自行选择所请求的权限范围。</p><p>我们在受控的实验室模拟环境中探索了这一场景。一个受害者测试账号批准了由我们所控制的攻击者客户端发起的 GitHub 设备代码请求。获得该批准后，我们分析了四种可能的结果：</p><ul>\n<li>远程操控一个活跃的 Copilot CLI 会话，前提是用户已启用远程控制且组织策略允许，并且在本地权限与审批设置的约束下，让该代理在用户机器上运行命令。</li>\n\n\n\n<li>向代理的内存中添加误导性条目，以影响后续交互。</li>\n\n\n\n<li>读取已同步到云端的 Copilot CLI 会话。</li>\n\n\n\n<li>访问受影响账号可用的私有仓库。</li>\n</ul><p>这些是概念验证（PoC）结果，展示现有功能在按设计工作的同时，如何在被钓取的授权之后遭到滥用；并非我们在真实环境中观察到的攻击。这些结果均要求受害者用户批准由攻击者发起的设备代码请求；每种结果还取决于下文所述的账号权限与已启用功能。</p><p>在本文稍后部分，我们将展示 Microsoft Defender 如何通过把钓鱼尝试与 GitHub 认证活动关联起来来检测这些攻击，以及组织如何阻断可疑访问以保护受影响的身份。</p><h2 id=\"sec-1\">从熟悉的钓鱼手法到 AI 编码代理</h2><p><a href=\"https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/authorizing-oauth-apps\">OAuth 设备流程</a>可帮助命令行工具等客户端在不显示完整浏览器的情况下完成登录。客户端请求一个短代码；用户在服务的验证页面上输入该代码；请求方客户端在获得批准后收到访问权限。在设备代码钓鱼中，攻击者发起请求，并说服他人代为批准。</p><p>微软已报告多起针对账户的设备码钓鱼攻击，其中包括 <a href=\"https://www.microsoft.com/en-us/security/blog/2025/02/13/storm-2372-conducts-device-code-phishing-campaign/\">Storm-2372</a>、2026 年的一次 <a href=\"https://www.microsoft.com/en-us/security/blog/2026/04/06/ai-enabled-device-code-phishing-campaign-april-2026/\">AI 赋能攻击活动</a>以及 <a href=\"https://www.microsoft.com/en-us/security/blog/2026/09/22/unmasking-eviltokens-getting-to-the-root-of-device-code-phishing/\">EvilTokens</a>。这些案例促使我们考察了一个不同的目标：一种能够操作代码仓库的编码代理，并且在启用远程控制时，会将活动的会话暴露给远程交互。</p><p>本文其余部分描述的是一次受控的 GitHub Copilot CLI 模拟；我们在上述攻击活动或真实环境中并未观察到以下四种结果。</p><h2 id=\"sec-2\">攻击是如何运作的</h2><figure><img src=\"/dailyinfo/media/ac9ba994fe5416ac.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption><em>图 1. 用户批准了一个由攻击者控制的客户端发起的合法 GitHub 设备码请求。概念示意图。</em></figcaption></figure><ol>\n<li><strong>发起： </strong>攻击者启动一个设备码登录请求。在我们的模拟中使用了 Copilot CLI 客户端，但任何支持设备流的客户端都可以使用。</li>\n\n\n\n<li><strong>诱导：</strong>攻击者将短码和 GitHub 验证链接发送给用户，例如以 IT 请求或 Copilot 许可证检查为借口。该验证页面确实由 GitHub 托管；仅有合法域名并不能确定请求的发起方。</li>\n\n\n\n<li><strong>批准：</strong>用户打开 GitHub 页面，必要时登录，并批准该请求。这是社会工程环节。</li>\n</ol><figure><img src=\"/dailyinfo/media/08bc6464364dd4a8.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\"></figure><ol>\n<li><strong>登录： </strong>批准后，攻击者控制的客户端自动完成登录。</li>\n\n\n\n<li><strong>操作：</strong>攻击者可以在应用被授予的权限以及受影响账户可访问的资源的范围内进行操作。</li>\n</ol><h3 id=\"sec-3\">短码背后的请求</h3><p>以下示例展示了对 GitHub <a href=\"https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/authorizing-oauth-apps\">设备授权端点</a>的初始 HTTP 请求。Copilot CLI 的客户端标识符是公开的；它不是客户端密钥。攻击者将 GitHub 返回的短码发送给用户。一旦用户批准，请求该客户端就会登录，无需再进行手动步骤。</p><pre>GitHub Device Code Authentication (Simplified)\nEndpoint: GitHub Device Authorization Endpoint\nClient ID: \nRequested scopes: \n</pre><h4 id=\"sec-4\">请求看起来是合法的</h4><p>用户是在真实的 GitHub 站点上登录，而不是仿冒页面。因此，熟悉��域名无法让用户判断该请求是否属于自己的请求。授权记录也会显示在一个合法应用名称之下；仅凭名称无法区分攻击者控制的客户端与预期中的登录。</p><h2 id=\"sec-5\">一次批准，影响扩散的四种方式</h2><p>设备码批准只是起点。攻击者接下来能做什么，取决于账户的权限、启用的功能、内存设置，以及活动会话能否被远程控制。</p><figure><img src=\"/dailyinfo/media/b63a2877128e3978.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption><em>图 2. 实验环境中的四种可能结果，每种都受账户权限和已启用功能的限制。概念示意图。</em></figcaption></figure><h3 id=\"sec-6\"><strong>1. </strong>攻击者可以操纵已启用的远程会话</h3><p>当用户为该会话和组织策略启用了远程控制时，Copilot CLI 支持对活动交互式会话进行 <a href=\"https://docs.github.com/copilot/concepts/agents/copilot-cli/about-remote-control\">远程操纵</a>。在实验室中，攻击者控制的客户端利用测试账户的授权与可远程控制的会话进行交互。该代理在测试计算机上执行命令，并受到会话批准提示和本地操作系统权限的限制。这演示了对已授权远程会话能力的滥用，其运作符合设计预期；这不是未经身份验证的远程代码执行，并且在远程控制被禁用、会话未运行或计算机离线时不适用。</p><figure><img src=\"/dailyinfo/media/2caf5c7302cafc7b.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\"></figure><figure><img src=\"/dailyinfo/media/bc3bcd8d3b1cdaa0.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption><em>图 3. 远程会话的滥用受本地机器权限和审批控制的限制。概念示意图。</em></figcaption></figure><h3 id=\"sec-7\">2. 记忆可以将攻击延续下去</h3><p><a href=\"https://docs.github.com/en/copilot/how-tos/use-copilot-agents/copilot-memory/manage-as-administrator\">Copilot Memory</a> 可以保留仓库信息和用户偏好。在模拟中，我们使用智能体的 /memory 命令添加了误导性条目。如果这些条目在后续交互中被使用，其影响可能比最初的登录持续更久。实际行为取决于启用了哪些记忆功能和策略。</p><figure><img src=\"/dailyinfo/media/19c5b3f8f2e3cc29.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption><em>图 4. 误导性记忆可能影响后续的智能体交互。概念示意图。</em></figcaption></figure><h3 id=\"sec-8\">3. 同步会话会泄露更早的上下文</h3><p>在启用<a href=\"https://docs.github.com/copilot/concepts/agents/copilot-cli/chronicle\">云端会话存储</a>的地方，我们能够读取测试账户同步的 Copilot CLI 会话，包括模拟之前的会话。这些会话可能包含代码片段、文件路径、架构讨论以及其他工作上下文。对于 Copilot Business 和 Enterprise，可用性取决于组织的会话存储策略；同步会话本身并不会启用远程控制。</p><h3 id=\"sec-9\">4. 仓库访问权限取决于账户</h3><p>在实验室环境中，该授权使我们能够访问测试账户可用的私有仓库。请求中包含 repo 范围，以及 read:user、read:org、gist 和 codespace。这些范围由启动该流程的客户端选择；最终的仓库访问权限取决于所请求的范围和账户的权限，而不是 Copilot CLI 自身的属性。潜在的暴露范围受账户仓库访问权限的约束，其中可能包含应用代码和基础设施定义。</p><p>一封钓鱼邮件、一次点击和一次 GitHub 授权，单独来看每一项都可能显得平平无奇。对防御方而言，挑战在于识别它们何时属于同一次接管企图。合法的验证页面是这个故事的一部分，而不是请求安全的证据。</p><h2 id=\"sec-10\">将钓鱼企图转化为 Defender 检测信号</h2><p>Microsoft Defender 帮助组织检测和响应针对 GitHub 账户的设备代码钓鱼攻击。在 Microsoft Defender for Cloud Apps 中<a>启用</a><a href=\"https://learn.microsoft.com/en-us/defender-cloud-apps/protect-github\">GitHub Enterprise Cloud 连接器</a>后，组织即可获得 GitHub 活动的可见性，从而支持对可疑授权模式的调查。</p><p>作为我们研究的一部分，我们开发了针对疑似 GitHub Copilot CLI 设备代码钓鱼的两项检测，覆盖通过电子邮件和 Microsoft Teams 投递的攻击。</p><p>这些检测将可疑消息和点击与后续的 GitHub OAuth 令牌创建和再生成事件关联起来，有助于识别那些本可能看起来合法的、未经授权的 Copilot CLI 授权。Microsoft Defender XDR 客户可参考下方适用检测的列表。</p><figure><table><tbody><tr><td><strong>Microsoft Defender 覆盖范围</strong>  </td><td><strong>观察到的活动</strong> </td><td><strong>战术</strong> </td></tr><tr><td> Microsoft Defender XDR：通过电子邮件进行的疑似 GitHub Copilot CLI 设备代码钓鱼</td><td> 通过电子邮件投递的疑似设备代码钓鱼，可能导致对 GitHub Copilot CLI 的未授权访问。</td><td> 初始访问 / 凭据访问  </td></tr><tr><td> Microsoft Defender XDR：通过 Microsoft Teams 进行的疑似 GitHub Copilot CLI 设备代码钓鱼</td><td> 通过 Microsoft Teams 投递的疑似设备代码钓鱼，可能导致对 GitHub Copilot CLI 的未授权访问</td><td> 初始访问 / 凭据访问</td></tr></tbody></table></figure><p>除了检测之外，我们还为 GitHub Enterprise Managed Users（EMU）开发了一项中断处置操作。该操作通过组织的身份提供商暂停受影响的托管身份，从而中断攻击者的访问。我们在研究环境中验证了这项能力。</p><p>响应人员还应审查并撤销异常的 OAuth 授权，确认访问已被阻止，并调查可能受影响的会话、仓库和已保存的内存。</p><p>这些能力结合起来，可帮助安全团队从识别潜在钓鱼尝试，转为控制受影响的身份。检测和中断功能的可用性取决于受支持的配置、所需遥测数据、身份集成以及部署先决条件。</p><figure><img src=\"/dailyinfo/media/5b416c8e22a46437.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption><em>图 5. Microsoft Defender 针对通过电子邮件实施 GitHub Copilot CLI 设备代码钓鱼的疑似行为生成的警报。</em></figcaption></figure><figure><img src=\"/dailyinfo/media/72ae4fd5f83b02b1.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption><em>图 6. 用于识别和控制受影响托管身份的研究模型。概念示意图。</em></figcaption></figure><h2 id=\"sec-11\">缓解与保护指南</h2><ul>\n<li>务必向所有使用开发工具和 AI 工具的人员明确说明审批规则：只有在你本人发起登录时，才输入设备代码。任何要求“验证”GitHub 或激活 Copilot 的非预期请求，都应被视为钓鱼尝试，即使该页面托管在 github.com 上也是如此。GitHub 自身的验证页面会警告用户，绝不要使用他人发送的代码。</li>\n\n\n\n<li>在 Microsoft Defender for Office 365 中为电子邮件配置<a href=\"https://learn.microsoft.com/en-us/defender-office-365/safe-links-policies-configure\">安全链接策略</a>，并验证<a href=\"https://learn.microsoft.com/en-us/defender-office-365/mdo-support-teams-quick-configure\">适用于 Microsoft Teams 的安全链接保护</a>。这些保护措施有助于应对恶意链接并提供调查上下文；即便是合法的 GitHub 验证 URL，用户仍需识别出未经请求的代码请求。</li>\n\n\n\n<li><strong>审查</strong><strong> <a href=\"https://docs.github.com/copilot/concepts/agents/copilot-cli/about-remote-control\">GitHub Copilot CLI 会话设置</a>。</strong>对于由组织提供的席位，GitHub 的“在云端存储本地会话”策略决定会话能否被存储和远程控制。请选择能够满足你工作流的限制最少的设置。远程控制还要求存在处于活动状态的在线交互式会话。</li>\n\n\n\n<li>在 GitHub 账户设置中审查<a href=\"https://docs.github.com/en/apps/oauth-apps/using-oauth-apps/reviewing-your-authorized-oauth-apps\">已授权的 OAuth 应用程序</a>，并撤销异常或不再需要的授权。使用适当的<a href=\"https://docs.github.com/organizations/managing-user-access-to-your-organizations-repositories/repository-roles-for-an-organization\">组织角色</a>限制仓库访问权限，防止受影响账户访问超出其工作所需的代码。</li>\n\n\n\n<li>如果启用了 Copilot Memory，请使用 GitHub 的<a href=\"https://docs.github.com/en/copilot/how-tos/use-copilot-agents/copilot-memory/manage-as-administrator\">内存管理控件</a>审查并删除可疑的存储库事实信息或用户偏好。<a href=\"https://docs.github.com/copilot/how-tos/use-copilot-agents/copilot-memory/manage-for-yourself\">禁用内存</a>不会自动删除已存储的条目，因此事件响应期间应审查已保存的内容。</li>\n\n\n\n<li>将<a href=\"https://learn.microsoft.com/en-us/defender-cloud-apps/protect-github\">GitHub Enterprise Cloud</a>连接到 Defender for Cloud Apps，并在依赖其开展调查之前，验证你所在环境中可用的活动数据。</li>\n</ul><h3 id=\"sec-12\">请记住：合法的登录也可能是错误的登录</h3><p>此次模拟最引人注目之处在于，要让事情显得可疑，只需很少的操作。用户访问了真实的 GitHub 网站，并批准了一个看起来正常的请求。然而，该批准对应的是一个用户并未启动的客户端。从此以后，后果取决于该身份能够访问哪些内容，以及启用了哪些 Copilot CLI 功能。</p><p>这就是为什么这不仅仅是一个关于代码的故事。随着 AI 代理获得对存储库、会话历史记录和本地工具的访问权限，遭到钓鱼的授权所造成的影响日益取决于这些代理能够访问哪些内容。</p><p>合法的验证页面并不意味着该请求是安全的。用户应仅批准自己发起的设备代码请求。组织应定期审查并撤销意外的 GitHub OAuth 授权，将 Copilot 会话和内存设置限制在其工作流所需的范围内，并在 Microsoft Defender for Cloud Apps 中验证 GitHub 活动的可见性，以支持调查。</p><p>最终，防止设备代码钓鱼既需要提高用户意识，也需要具备将可疑授权活动与此前发生的钓鱼尝试关联起来的能力。</p><h3 id=\"sec-13\">观察到的 MITRE ATT&amp;CK 技术</h3><p>这些映射描述的是概念验证模拟中展示的行为，而非已归因的攻击活动。</p><ul>\n<li><a href=\"https://attack.mitre.org/techniques/T1566/002/\">T1566.002 – 钓鱼：鱼叉式钓鱼链接</a>（初始访问）。在测试的电子邮件投递中，一个链接将用户引导至设备授权页面并提示其批准。</li>\n\n\n\n<li><a href=\"https://attack.mitre.org/techniques/T1528/\">T1528 – 窃取应用程序访问令牌</a>（凭据访问）。测试账户批准该请求后，攻击者控制的客户端获取了 OAuth 令牌。</li>\n</ul><h2 id=\"sec-14\">参考</h2><ol>\n<li><a href=\"https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/authorizing-oauth-apps\">授权 OAuth 应用</a>。GitHub 文档。介绍 OAuth 设备授权流程，包括用户如何批准请求以及应用如何获取访问令牌。</li>\n\n\n\n<li><a href=\"https://docs.github.com/en/copilot/how-tos/copilot-cli/set-up-copilot-cli/authenticate-copilot-cli\">对 GitHub Copilot CLI 进行身份验证</a>。GitHub 文档。介绍 GitHub Copilot CLI 支持的身份验证方法。</li>\n\n\n\n<li><a href=\"https://docs.github.com/copilot/concepts/agents/copilot-cli/about-remote-control\">远程控制 GitHub Copilot CLI 会话</a>。GitHub 文档。介绍如何远程访问和控制活动的 Copilot CLI 会话，包括相关先决条件。</li>\n\n\n\n<li><a href=\"https://docs.github.com/copilot/concepts/agents/copilot-cli/chronicle\">GitHub Copilot 会话数据</a>。GitHub 文档。提供有关 GitHub Copilot CLI 中会话历史和云同步的信息。</li>\n\n\n\n<li><a href=\"https://docs.github.com/en/copilot/how-tos/use-copilot-agents/copilot-memory/manage-as-administrator\">为企业、组织或仓库管理 Copilot Memory</a>。GitHub 文档。介绍管理员如何管理内存设置和存储的信息。</li>\n\n\n\n<li><a href=\"https://docs.github.com/en/apps/oauth-apps/using-oauth-apps/reviewing-your-authorized-oauth-apps\">审查您已授权的 OAuth 应用</a>。GitHub 文档。介绍用户如何审查和撤销 OAuth 应用程序授权。</li>\n\n\n\n<li><a href=\"https://docs.github.com/organizations/managing-user-access-to-your-organizations-repositories/repository-roles-for-an-organization\">组织的仓库角色</a>。GitHub 文档。介绍仓库权限级别以及组织如何根据用户职责限制访问权限。</li>\n\n\n\n<li><a href=\"https://learn.microsoft.com/en-us/defender-cloud-apps/protect-github\">保护您的 GitHub Enterprise 环境</a>。Microsoft Learn。介绍如何将 GitHub Enterprise Cloud 连接到 Microsoft Defender for Cloud Apps，以获取 GitHub 活动的可见性并支持安全调查。</li>\n\n\n\n<li><a href=\"https://learn.microsoft.com/en-us/defender-office-365/safe-links-policies-configure\">在 Microsoft Defender for Office 365 中配置 Safe Links 策略</a>。Microsoft Learn。提供有关 Safe Links 针对恶意 URL 防护的配置指南。</li>\n</ol><h2 id=\"sec-15\">了解更多</h2><p>如需查看 Microsoft Threat Intelligence 社区的最新安全研究，请访问<a href=\"https://aka.ms/threatintelblog\">Microsoft Threat Intelligence 博客</a>。</p><p>如需获取新发布的通知并在社交媒体上参与讨论，请在 <a href=\"https://www.linkedin.com/showcase/microsoft-threat-intelligence\">LinkedIn</a>、<a href=\"https://x.com/MsftSecIntel\">X（原 Twitter）</a> 和 <a href=\"https://bsky.app/profile/threatintel.microsoft.com\">Bluesky</a> 上关注我们。</p><p>如需收听 Microsoft Threat Intelligence 社区关于不断变化的威胁态势的故事和见解，请收听<a href=\"https://thecyberwire.com/podcasts/microsoft-threat-intelligence\">Microsoft Threat Intelligence 播客</a>。</p><p>请查看我们的文档，了解有关实时保护功能的更多信息，以及如何在您的组织中启用这些功能。  </p><ul>\n<li>进一步了解如何使用 <a href=\"https://learn.microsoft.com/en-us/defender-cloud-apps/ai-agent-protection\">Microsoft Defender 保护 Copilot Studio 代理</a> </li>\n\n\n\n<li>通过我们最新的 <a href=\"https://microsoft.github.io/zerotrustassessment/\">Zero Trust for AI 研讨会</a>评估您的 AI 准备情况。</li>\n\n\n\n<li><a href=\"https://learn.microsoft.com/en-us/copilot/microsoft-365/microsoft-365-copilot-ai-security\">Microsoft 365 Copilot AI 安全文档</a></li>\n\n\n\n<li><a href=\"https://www.microsoft.com/en-us/security/blog/2024/04/11/how-microsoft-discovers-and-mitigates-evolving-attacks-against-ai-guardrails/\">Microsoft 如何发现并缓解针对 AI 护栏的不断演变的攻击</a></li>\n\n\n\n<li><a href=\"https://learn.microsoft.com/en-us/defender-office-365/step-by-step-guides/prompt-injection-protection-defender-for-office-365\">Microsoft Defender for Office 365 中的提示注入防护 </a>– Microsoft Defender for Office 365 中提示注入防护的官方文档。</li>\n\n\n\n<li><a href=\"https://www.microsoft.com/en-us/security/blog/2024/04/11/how-microsoft-discovers-and-mitigates-evolving-attacks-against-ai-guardrails/\">Microsoft 如何发现并缓解针对 AI 护栏的不断演变的攻击 | Microsoft 安全博客</a></li>\n\n\n\n<li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/02/10/ai-recommendation-poisoning/\">为牟利操纵 AI 记忆：AI 推荐投毒的兴起 | Microsoft 安全博客</a> – 一个在电子邮件流量中观察到的 AI 时代技术相关示例</li>\n\n\n\n<li><a href=\"https://techcommunity.microsoft.com/blog/microsoftdefenderforoffice365blog/defending-the-inbox-against-prompt-injection-attacks/4534636\">使用 Microsoft Defender for Office 365 博客防范收件箱中的提示注入攻击 </a>– 介绍 Microsoft Defender for Office 365 中提示注入防护功能的公告。</li>\n\n\n\n<li>了解 Microsoft 如何在智能体时代重新构想 SOC：<a href=\"https://www.microsoft.com/security/blog/2026/09/23/reimagining-the-soc-for-the-agentic-era-in-microsoft-defender/\">Microsoft Defender 中的 ISOC</a></li>\n</ul><p>文章 <a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/17/the-risks-of-device-code-authentication-for-ai-coding-agents/\">AI 编码代理使用设备代码身份验证面临的风险</a> 最早发布于 <a href=\"https://www.microsoft.com/en-us/security/blog\">Microsoft 安全博客</a>。</p>","original","zhKind","translation","complete","Agent 安全","复现","钓鱼","检测工程","Microsoft","Google","https://www.microsoft.com/en-us/security/blog/2026/11/17/the-risks-of-device-code-authentication-for-ai-coding-agents/","Microsoft Security Blog",{"_155":156,"_157":-5},"changelogVersion","2026-10-01T08:00","release"]
