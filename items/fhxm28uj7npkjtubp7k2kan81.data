[{"_1":2,"_3":4},"root",{"_5":119},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1794962439000,"id","fhxm28uj7npkjtubp7k2kan81","title","GreyNoise 扩展 Elastic Security 实时边缘情报集成，新增 Kibana 仪表板与检测规则","originalTitle","GreyNoise Expands Real-Time Edge Intelligence in Elastic Security","summary","GreyNoise 扩展与 Elastic Security 的实时边缘情报集成，提供 Kibana 仪表板、关联边界与网络活动的检测规则，并为 Elastic Security 事件中的 IP 实时添加 GreyNoise 分类。","reason","source",{"_70":118},"links",{"_60":117},"publishedAt","2026-11-16T16:00:00.000Z","discoveredAt","2026-11-17T20:22:32.140Z","timelineAt","category","blue-team","tags",[113,114,115,116],"score",43,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body",{"_109":-5,"_60":110,"_111":-5,"_112":36},"outline",[78,79,80,81,82,83,84,85,86],"relatedStories",[74],"topics",[67,68],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","f7NO7cfLRvTI","reportCount",1,"additionalSourceCount",0,{"_69":72,"_70":73},{"_69":30,"_70":71},"slug","name","蓝队与运营","tools","工具与平台",{"_75":76,"_13":77},"publicId","ab2220b8-ad80-4bcb-9eb1-dd25a23f53bf","GreyNoise 扩展 Elastic Security 情报集成",{"_11":107,"_88":108,"_90":91},{"_11":105,"_88":106,"_90":91},{"_11":103,"_88":104,"_90":91},{"_11":101,"_88":102,"_90":91},{"_11":99,"_88":100,"_90":94},{"_11":97,"_88":98,"_90":94},{"_11":95,"_88":96,"_90":94},{"_11":92,"_88":93,"_90":94},{"_11":87,"_88":89,"_90":91},"sec-9","text","Get Started","level",2,"sec-8","Reduce Alert Volume and Surface Targeted Threats",3,"sec-7","Flag Authentication Attempts from Compromised Hosts","sec-6","Allowed Outbound to Malicious Infrastructure","sec-5","Allowed Inbound from Malicious Infrastructure","sec-4","GreyNoise Detection Rules in Elastic Security&nbsp;","sec-3","Elastic Security Dashboard: Malicious Firewall Traffic","sec-2","What's Included in the Integration&nbsp;","sec-1","How GreyNoise and Elastic Work Together in the SOC","zh","<p>Today we’re announcing an expanded integration between GreyNoise and Elastic, with new content for Elastic Security. The integration includes purpose-built Kibana dashboards for edge observability, detection rules that correlate perimeter and network activity with GreyNoise intelligence, and real-time enrichment that adds GreyNoise classifications to the IPs in your Elastic Security events. <a href=\"https://www.elastic.co/docs/reference/integrations/ti_greynoise\">Add the GreyNoise integration in Elastic</a> to get started.</p><p>‍</p><h2 id=\"sec-1\">How GreyNoise and Elastic Work Together in the SOC</h2><p>Security teams are under pressure as AI shortens the time between vulnerability discovery and the development of a working exploit. At the network edge, many internet-facing systems cannot support endpoint agents, leaving SOC analysts to investigate attacks through firewall, VPN, and network logs.</p><p>GreyNoise continuously observes internet-wide scanning and exploitation through a global sensor network. We classify the associated IPs, tag the exploitation behavior, and record post-exploitation artifacts and command-and-control infrastructure. That intelligence gives analysts context for the network activity and alerts they investigate in Elastic Security.</p><p>Elastic Security is an agentic security operations platform that offers SIEM, endpoint security, and native automation. It brings security data into a common schema so analysts can search across sources, build detections, and investigate activity in one place.</p><p>Together, GreyNoise and Elastic put that context where analysts work: dashboards for real-time edge observability and detection rules to detect attacks at the network edge.&nbsp;</p><p>‍</p><h2 id=\"sec-2\">What's Included in the Integration&nbsp;</h2><p>The expanded integration includes two categories of new content:</p><ol><li><strong>New dashboards</strong> visualize allowed inbound traffic from malicious IPs, allowed outbound connections to malicious infrastructure, and alert volume with and without GreyNoise enrichment.</li><li><strong>New detection rules</strong> cover allowed inbound and outbound connections involving malicious IPs, successful VPN logins from malicious IPs, and reconnaissance and brute-force activity from IPs GreyNoise has not observed – this may be an indication of a targeted attack.&nbsp;</li></ol><p>‍</p><h2 id=\"sec-3\">Elastic Security Dashboard: Malicious Firewall Traffic</h2><p>The Malicious Firewall Traffic dashboard in Elastic Security helps SOC analysts identify allowed inbound connections from malicious IPs and internal hosts reaching malicious infrastructure. Built in Elastic’s Kibana dashboard capabilities, it shows:</p><ul><li><strong>Connection activity:</strong> Allowed inbound and outbound connections and successful VPN logins involving IPs GreyNoise classifies as malicious.</li><li><strong>GreyNoise context:</strong> Classifications and tags that show what each IP has been observed doing across the internet.</li></ul><p>SOC analysts can prioritize VPN logins from malicious IPs and internal hosts reaching malicious infrastructure, then use GreyNoise real-time intelligence to add valuable context for investigating the activity without manually piecing together firewall and VPN logs.</p><figure><p><img alt=\"\" src=\"/dailyinfo/media/d5802dc9128bc3dc.jpg\" loading=\"lazy\" decoding=\"async\"></p></figure><p>‍</p><p>‍</p><h2 id=\"sec-4\">GreyNoise Detection Rules in Elastic Security&nbsp;</h2><p>The integration includes the following detection rules to bring these use cases into your SOC’s existing alert triage workflow.</p><h3 id=\"sec-5\">Allowed Inbound from Malicious Infrastructure</h3><p>Allowed inbound connections from malicious or suspicious IPs can expose gaps in perimeter security. By matching firewall logs against GreyNoise intelligence, this rule alerts SOC analysts to potentially targeted threat activity their firewall has permitted.</p><p>Each alert includes context about the external IP, giving analysts a starting point to investigate the activity. The analyst can then review the firewall policy that allowed the connections and determine whether a misconfiguration, outdated access rule, or overly permissive policy needs attention.</p><figure><p><img alt=\"\" src=\"/dailyinfo/media/eae7fd8c30423344.jpg\" loading=\"lazy\" decoding=\"async\"></p></figure><p>‍</p><h3 id=\"sec-6\">Allowed Outbound to Malicious Infrastructure</h3><p>Outbound connections to malicious infrastructure can indicate a compromised internal host. These detections help SOC analysts identify the hosts involved and investigate potential command-and-control activity, data exfiltration, or botnet participation.</p><ul><li><strong>Outbound Connection to Malicious Infrastructure:</strong> Flags internal hosts connecting to IPs GreyNoise classifies as malicious or suspicious.&nbsp;</li><li><strong>Egress to Tor Exit Nodes:</strong> Flags allowed outbound connections to destinations identified by GreyNoise’s Tor attribute, helping analysts determine whether anonymized traffic is expected.</li></ul><p>This gives SOC analysts a focused set of internal hosts and destinations to investigate, with context to decide whether to isolate a host or block further connections.</p><figure><p><img alt=\"\" src=\"/dailyinfo/media/05ff4b0eb9b0b26f.jpg\" loading=\"lazy\" decoding=\"async\"></p></figure><p>‍</p><h3 id=\"sec-7\">Flag Authentication Attempts from Compromised Hosts</h3><p>A successful VPN login from known malicious infrastructure warrants investigation. This rule flags successful logins from IPs GreyNoise classifies as malicious, helping SOC analysts identify potentially compromised credentials or unauthorized access. Analysts can investigate the account, IP, and session activity to determine whether access was authorized and what response is needed.</p><figure><p><img alt=\"\" src=\"/dailyinfo/media/5e7e013f4cb5623b.webp\" loading=\"lazy\" decoding=\"async\"></p></figure><p>‍</p><h3 id=\"sec-8\">Reduce Alert Volume and Surface Targeted Threats</h3><p>Known internet-wide scanning can bury activity that deserves closer investigation. Two rules filter out known mass-scanning IPs and focus on unseen IPs instead.&nbsp;</p><ul><li>Combine “Recon from Unseen Sources” into a single alert to identify potentially targeted reconnaissance activity</li><li>“Brute Force from Unseen Sources” opens a high-severity case in Elastic Security when an unseen IP makes repeated credential attempts.&nbsp;</li></ul><p>This gives SOC analysts fewer alerts to review and helps them prioritize potentially targeted activity.</p><figure><p><img alt=\"\" src=\"/dailyinfo/media/962362a3566ed9c7.jpg\" loading=\"lazy\" decoding=\"async\"></p></figure><p>‍</p><h2 id=\"sec-9\">Get Started</h2><p>The GreyNoise dashboards and detection rules are available now for Elastic Security. Follow the<a href=\"https://docs.greynoise.io/docs/elastic-installation-guide\"> installation guide</a> to add the GreyNoise integration in Elastic.</p><p>‍</p>","zhKind","complete","工具发布","检测工程","安全运营","网络设备","https://www.greynoise.io/blog/expands-real-time-edge-intelligence-elastic-security","GreyNoise Blog",{"_120":121,"_122":-5},"changelogVersion","2026-10-01T08:00","release"]
