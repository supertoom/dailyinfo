[{"_1":2,"_3":4},"root",{"_5":112},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795048833000,"id","m230x64wpoum2xp8v57v8ft40","title","Forescout 用 AI 在 10 个 TCP/IP 协议栈中确认 99 个漏洞","originalTitle","AI uncovers flaws in discontinued devices with no vendor left to patch them","summary","Forescout 团队利用 Claude 模型、代码扫描器与 AI Agent 测试 10 个 TCP/IP 协议栈，确认 99 个漏洞，其中 66 个此前未知，52% 的新漏洞被评为高危或严重。","reason","研究以较低成本验证 AI 自动发现嵌入式软件漏洞的可行性，并揭示无厂商维护设备难以修补的处置难题。","source",{"_74":111},"links",{"_102":110},"publishedAt","2026-11-16T05:00:22.000Z","discoveredAt","2026-11-16T05:16:13.817Z","timelineAt","category","disclosure","tags",[79,77,106,107,108,109],"score",70,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Anamarija Pogorelec","body",{"_61":101,"_102":-5,"_103":104,"_105":37},"outline",[86,87,88,89],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fBvOIU5v_PcQ","reportCount",2,"additionalSourceCount",1,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","tools","name","工具与平台","ai-security","AI 安全","research","技术研究","ai-agent","AI Agent 安全",{"_83":84,"_13":85},"publicId","2a021401-5eac-4f8c-801e-4d3f2293250b","Forescout确认99个协议栈漏洞",{"_11":99,"_91":100,"_93":94},{"_11":97,"_91":98,"_93":94},{"_11":95,"_91":96,"_93":94},{"_11":90,"_91":92,"_93":94},"sec-4","text","一些易受攻击的产品已没有厂商负责修复","level",3,"sec-3","测试排除了许多疑似缺陷","sec-2","90 小时的对比包含了验证环节","sec-1","研究人员教会系统该寻找什么","<p>Forescout 研究人员构建了一个工具，用于测试公开可用的 <a href=\"https://www.helpnetsecurity.com/2026/07/22/ai-models-cheating-behaviour-cybersecurity-evaluations/\">AI 模型</a>能否在有限预算下发现安全缺陷。他们同时研究了开源代码和源代码不可获取的已编译软件，并测试了攻击者同样可以采用的一种方法。</p><p>该团队在 10 个 TCP/IP 协议栈中确认了 99 个漏洞，这些协议栈是让设备通过网络进行通信的软件组件。其中 66 个此前未知，新发现漏洞中的 52% 被评为高危或严重级别。</p><p>受影响的软件用于工业设备、医疗设备、网络设备以及其他联网产品。Siemens 已确认其 APOGEE、Desigo 和 TALON 产品线中存在受影响的楼宇自动化控制器，而其他厂商仍在调查。</p><p>“我们的研究表明，AI 正在改变漏洞发现的经济性，并加速了安全团队识别、排序和缓解网络风险的节奏。这对关键基础设施尤其影响重大，因为遗留且难以打补丁的设备可能仍会持续运行多年，”Forescout 研究副总裁 <a href=\"https://www.linkedin.com/in/danielricardosantos/\">Daniel dos Santos</a> 表示。</p><h3 id=\"sec-1\">研究人员教会系统该寻找什么</h3><p>该团队围绕 <a href=\"https://www.helpnetsecurity.com/2026/09/23/anthropic-claude-opus-5-5/\">Claude</a> 模型和现有安全工具构建了系统，并借鉴了多年对嵌入式软件的研究成果。</p><p>代码扫描器首先标记出可能表明存在漏洞的模式。<a href=\"https://www.helpnetsecurity.com/2026/10/26/arrakis-dormant-ai-agent-risks-report/\">AI 智能体</a>随后检查攻击者能否触达可疑代码并利用潜在弱点。在最后阶段，系统尝试运行该软件并生成触发问题的测试，研究人员可以介入并指导工作。</p><p>早期调查的记录帮助研究人员创建了 32 条扫描规则。这些规则覆盖了诸如复制的数据超出内存缓冲区容量，或错误处理通过网络接收到的信息等问题。团队在使用这些规则之前对其进行了审查和优化。</p><h3 id=\"sec-2\">90 小时的对比包含了验证环节</h3><p>自动化分析耗时约 10 小时，随后是大约 80 小时的验证。研究人员将其与 Project Memoria（一次于 2020 年和 2021 年开展的早期调查）中大约九个月的人工代码分析进行了对比。</p><p>Project Memoria 整体持续了 18 个月，分几个阶段覆盖了 14 个网络协议栈。这项<a href=\"https://www.forescout.com/research-labs/finding-critical-infrastructure-bugs-with-off-the-shelf-ai/\">研究</a>考察了 10 个协议栈，其中包括此前已研究过的 7 个。</p><p>时间和成本估算涵盖了将该已完成系统应用于这些目标所需的工作。构建该系统还需要额外工作，包括制定扫描规则、准备运行软件的运行环境，以及优化给予 AI 智能体的指令。</p><p>自动化代码检查花费了 935 美元。包括运行软件的测试在内的估算支出，总模型成本约为 1,200 美元至 2,300 美元。</p><h3 id=\"sec-3\">测试排除了许多疑似缺陷</h3><p>自动化流程产生了 362 项初步发现，去除重复项后剩下 312 个候选项。测试和审查确认了 99 个漏洞。</p><p><img src=\"/dailyinfo/media/5263569c8b187058.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Forescout AI vulnerability research\" title=\"The 99 vulnerabilities discovered by the harness, grouped by category.\"></p><h5>\n<p>该测试框架发现的 99 个漏洞，按类别分组（来源：Forescout）</p>\n</h5><p>该系统重新发现了用于对比的 82 个已知漏洞中的 33 个。它在发现处理网络流量的代码中的内存错误方面表现最佳。涉及软件逻辑或设计的问题，例如本应是随机的却可预测的值，则更难检测。</p><p>编译软件需要更多工作。在没有源代码的情况下，工具必须重建程序的可用表示，这一过程可能引入不准确性并产生误报。对这些目标进行自动化检查的成本约为检查源代码的六倍，耗时约为其两倍。</p><h3 id=\"sec-4\">一些易受攻击的产品已没有厂商负责修复</h3><p>该团队向<a href=\"https://www.helpnetsecurity.com/2026/06/04/attackers-secrets-developers-machines/\">开发者</a>和维护人员报告了新发现的 54 个漏洞，因为它认为这些漏洞仍会影响最新版本。多个项目已经发布了修复。三个网络协议栈的调查仍未结束，其名称在披露过程中被保密。</p><p>其中一项调查涉及一家已停止运营的公司所生产的一款停产无线接入点的固件。在分析过程中，该系统还发现了七个特定于设备的漏洞，包括无法更改的管理员凭据，以及固件上传过程中的缓冲区溢出。</p><p>“许多组织仍有遗留系统、运营需求，以及无法轻松打补丁或直接下线停用的设备。因此，控制风险而非打补丁必须成为首要任务，”Forescout 首席执行官<a href=\"https://www.linkedin.com/in/barry-mainz-795b9511/\">Barry Mainz</a>表示。</p><p>此类产品在其制造商停止运营后仍可能继续使用，因而没有供应商能够开发或分发<a href=\"https://www.helpnetsecurity.com/2026/10/14/kunal-modasiya-qualys-vulnerability-remediation/\">补丁</a>。</p>","original","zhKind","translation","complete","漏洞分析","工具评测","大模型","Agent 安全","https://www.helpnetsecurity.com/2026/11/16/forescout-ai-models-vulnerability-research/","Help Net Security",{"_113":114,"_115":-5},"changelogVersion","2026-10-01T08:00","release"]
