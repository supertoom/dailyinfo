[{"_1":2,"_3":4},"root",{"_5":91},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795221639000,"id","rm7jvkt25c6fioq28glydfbu9","title","Chrome Dev for Android 发布 160.0.8171.0 更新","originalTitle","Chrome Dev for Android Update","summary","Google Chrome Release Team 面向 Android 发布 Chrome Dev 160（160.0.8171.0），现可通过 Google Play 获取。变更仅部分记录于 Git log，新功能详情见 Chromium blog，Web 平台更新亦有专门说明；发现新问题可提交 bug。","reason","source",{"_73":90},"links",{"_61":89},"publishedAt","2026-11-20T19:13:32.556Z","discoveredAt","2026-11-20T20:32:38.546Z","timelineAt","category","blue-team","tags",[87,76,74,88],"score",2,"selected",false,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","Ben Mason","body",{"_83":-5,"_61":84,"_85":-5,"_86":36},"outline",[],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fcwtHVD15OAc","reportCount",1,"additionalSourceCount",0,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","mobile","name","移动端","browser","浏览器","google","Google / 谷歌",{"_80":81,"_13":82},"publicId","0fe1ac8a-0475-43ff-97ac-30fd272e4026","Chrome Dev 160 安卓版发布","zh","<p>Hi everyone! We've just released Chrome Dev 160 (160.0.8171.0) for Android. It's now available on <a href=\"https://play.google.com/store/apps/details?id=com.chrome.dev\">Google Play</a>.</p><p>You can see a partial list of the changes in the <a href=\"https://chromium.googlesource.com/chromium/src/+log/160.0.8157.3..160.0.8171.0?pretty=fuller&amp;n=10000\">Git log</a>. For details on new features, check out the <a href=\"https://blog.chromium.org/\">Chromium blog</a>, and for details on web platform updates, check <a href=\"https://www.chromestatus.com/features#milestone%3D160\">here</a>.</p><p>If you find a new issue, please let us know by <a href=\"https://code.google.com/p/chromium/issues/entry?template=Android%20Issue\">filing a bug</a>.</p><p>Chrome Release Team<br><a href=\"https://www.google.com/chrome\">Google Chrome</a></p>","zhKind","complete","版本更新","Google","http://chromereleases.googleblog.com/2026/11/chrome-dev-for-android-update_0498913154.html","Chrome Releases",{"_92":93,"_94":-5},"changelogVersion","2026-10-01T08:00","release"]
