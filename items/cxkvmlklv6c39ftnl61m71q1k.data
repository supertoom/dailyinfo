[{"_1":2,"_3":4},"root",{"_5":89},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1795394431000,"id","cxkvmlklv6c39ftnl61m71q1k","title","pREST _groupby 函数表达式 SQL 注入分析，CVE-2025-58450 修复不完整","originalTitle","pREST _groupby function-expression SQL injection (incomplete fix of CVE-2025-58450)","summary","pREST 的 _groupby 函数表达式路径仍可触发 SQL 注入，构成 CVE-2025-58450 后续修复的不完整覆盖。作者以负向对照测试确认，isSafeSQLExpression 会错误接受 4 类包含 UNION、子查询或 pg_sleep 的 Payload，并由 GroupByClause 原样拼接执行；默认配置下仅需表读取权限，可能无需认证。","reason","作者通过代码路径审计与负向对照定位了修复覆盖缺口，并区分了已验证的 SQL 注入与 DoS 原语及尚未验证的数据外泄。","source",{"_72":88},"links",{"_60":87},"publishedAt","2026-11-20T14:41:42.000Z","discoveredAt","2026-11-20T14:43:29.457Z","timelineAt","category","disclosure","tags",[82,83,84,85,86],"score",70,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","body","outline",[],"relatedStories",[78],"topics",[67,68,69],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fZsfeCSHSTlY","reportCount",1,"additionalSourceCount",0,{"_70":76,"_72":77},{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","research","name","技术研究","vuln","漏洞披露","supply-chain","供应链安全",{"_79":80,"_13":81},"publicId","e080c610-ffb6-4997-bdf7-2b83f4773791","pREST分组排序SQL注入修复不完整","漏洞分析","复现","漏洞利用","数据库","供应链","https://github.com/advisories/GHSA-v9v2-98xq-627c","GitHub 安全公告",{"_90":91,"_92":-5},"changelogVersion","2026-10-01T08:00","release"]
