[{"_1":2,"_3":4},"root",{"_5":103},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1794962448000,"id","tsj4aacsqql9lxdimthq0m44r","title","RIKEN 因网络攻击下线 Fugaku 超算，4,222 名用户数据受损","originalTitle","Japan takes Fugaku supercomputer offlline after cyberattack","summary","日本 RIKEN 计算科学研究中心称，11 月 10 日至 13 日，未授权攻击者利用 Fugaku 公共状态仪表盘访问多台内部服务器并植入恶意软件，导致 4,222 名 Fugaku 用户的姓名、邮箱地址和用户 ID，以及 375 名 Rikyu 用户的姓名和邮箱地址泄露，电脑中存储的 SSH 私钥、访问密钥和研究数据文件也遭破坏。","reason","source",{"_75":102},"links",{"_61":101},"publishedAt","2026-11-17T20:51:21.000Z","discoveredAt","2026-11-17T21:32:31.470Z","timelineAt","category","activity","tags",[78,99,76,100,82,80],"score",69,"selected",false,"channel","news","story",{"_86":87,"_13":88},"x","readingMode","full","author","Bill Toulas","body",{"_95":-5,"_61":96,"_97":-5,"_98":36},"outline",[89],"relatedStories",[85],"topics",[68,69,70,71,72],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fULHAlgaV014","reportCount",1,"additionalSourceCount",0,{"_73":83,"_75":84},{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","malware","name","恶意软件","attack","攻击活动","ai-offense","AI 攻防","incident","应急响应","identity","身份与访问",{"_86":87,"_13":88},"publicId","0d43cf29-4332-40b0-89e7-643820ebb82d","RIKEN披露Fugaku超算入侵与数据泄露",{"_11":90,"_91":92,"_93":94},"sec-1","text","Uncover email threats your existing defenses may miss.","level",2,"zh","<p><img alt=\"Japan takes Fugaku supercomputer offlline after cyberattack\" height=\"900\" src=\"/dailyinfo/media/67cfad6323986fe8.jpg\" srcset=\"/dailyinfo/media/2025112a555b0211.jpg 720w, /dailyinfo/media/61b781485b7f423a.jpg 1200w, /dailyinfo/media/67cfad6323986fe8.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>The Fugaku supercomputer operated by Japan's RIKEN Center for Computational Science has been taken offline following a security breach.</p><p>The organization says that between November 10 and 13, an unauthorized party exploited the public dashboard displaying Fugaku's operational status to gain access to multiple internal servers.</p><p>Although the research center has yet to determine the access method, RIKEN’s <a href=\"https://www.riken.jp/pr/news/2026/20261116_2/index.html\">investigation confirmed</a> that the intruder accessed some servers to plant malware that targeted user data.</p><p><a href=\"https://www.wiz.io/lp/ai-security-starter-pack?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Security-Starter-Kit&amp;sfcid=701Vh00000cn7aRIAQ&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AI-Security-Bundle\"><img src=\"/dailyinfo/media/adcad2453b4091a6.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>Specifically, the organization says that the following details have been compromised:</p><ul>\n\t<li>Names, email addresses, and user IDs of 4,222 Fugaku users</li>\n\t<li>Names and email addresses of 375 Rikyu users</li>\n\t<li>SSH private keys and access keys stored on users’ computers</li>\n\t<li>Research data files stored on users’ computers</li>\n</ul><p>RIKEN notes that the attacker used some of the access keys in attempts to connect to additional systems, but the investigation did not determine further unauthorized access or theft of research results.</p><p>The organization has not attributed the attack, and it’s still working to determine the exact intrusion method.</p><p>RIKEN’s Center for Computational Science operates the two supercomputers, making them available to researchers in academia and industry sectors.</p><p>Fugaku, which entered shared use in March 2021, is a 537 petaflops supercomputer used in drug discovery, severe-weather forecasting, and simulations of airborne virus transmission. Rikyu is a 64 petaflops supercomputer used in AI scientific research.</p><p>In response to the incident, RIKEN shut down Fugaku on November 14, disabled users’ login keys, and asked users to revoke and replace any credentials they had stored on the supercomputer.</p><p>RIKEN said Fugaku operations will resume only after it has ensured that it’s safe to do so.</p><p>The remediation effort includes addressing the exploited software vulnerability, rebuilding compromised servers, reviewing the network configuration, and implementing advanced AI-driven security measures.</p><p>Users are advised to revoke any SSH keys and other credentials stored on Fugaku, and watch out for suspicious emails impersonating RIKEN.</p><p>A RIKEN spokesperson told BleepingComputer that they have no more details to share about the incident at the time, but promised to publish updates when the investigation uncovers new findings.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/7eb183d906b5dd40.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Uncover email threats your existing defenses may miss.</a>\n        </h2><p>Adaptive Security's AI agents analyze email intent, context, and behavior to uncover phishing, business email compromise, and invoice fraud.</p><p>See what's getting through with a 14-day read-only scan of Microsoft 365 or Google Workspace, with no MX changes.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Start your free email security scan.</a>\n    </p>","zhKind","complete","数据泄露","凭据","https://www.bleepingcomputer.com/news/security/japan-takes-fugaku-supercomputer-offlline-after-cyberattack/","BleepingComputer",{"_104":105,"_106":-5},"changelogVersion","2026-10-01T08:00","release"]
