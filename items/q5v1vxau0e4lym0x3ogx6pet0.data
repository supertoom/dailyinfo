[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":-5,"_57":36,"_58":59},"expiresAt",1794444097000,"id","q5v1vxau0e4lym0x3ogx6pet0","title","Chrome 156.0.8078.79/.80 修复21项安全漏洞","originalTitle","Stable Channel Update for Desktop","summary","Chrome Stable和Extended Stable渠道已更新至Windows和Mac的156.0.8078.79/.80、Linux的156.0.8078.79，将在未来数日或数周内推送。","reason","source",{"_64":78},"links",{"_59":77},"publishedAt","2026-10-29T21:26:20.252Z","discoveredAt","2026-10-29T23:40:22.563Z","timelineAt","category","vuln","tags",[74,75,67,76],"score",66,"selected",false,"channel","news","story","x","readingMode","full","author","Daniel Yip","body",{"_70":-5,"_59":71,"_72":-5,"_73":36},"outline",[],"relatedStories",[],"topics",[60,61,62],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_63":68,"_64":69},{"_63":66,"_64":67},{"_63":30,"_64":65},"slug","name","漏洞披露","browser","浏览器","google","Google / 谷歌","zh","<p><span><span>The Stable and Extended Stable channel has been updated to 156.0.8078.79/.80 for Windows and</span><span> </span><span>Mac and </span></span><span>156.0.8078.79 to </span><span><span>Linux which will roll out over the coming days/weeks. A full list of changes in this build is available in the <a href=\"https://chromium.googlesource.com/chromium/src/+log/156.0.8078.74..156.0.8078.80?pretty=fuller&amp;n=10000\">Log</a>.</span></span></p><p><span><span>Security Fixes and Rewards</span></span></p><p><span><span><br></span><span>Note: Access to bug details and links may be kept restricted until a majority of users are updated with a fix. We will also retain restrictions if the bug exists in a third party library that other projects similarly depend on, but haven’t yet fixed.</span><span><b><br></b></span><span>This update includes </span><a href=\"https://issues.chromium.org/issues?q=customfield1223088:2-M156\"><span>21</span></a><span> security fixes. Please see the </span><a href=\"https://www.chromium.org/Home/chromium-security\"><span>Chrome Security Page</span></a><span> for more information.</span></span></p><p><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/576215540\"><span>576215540</span></a><span>] </span><span>Critical</span><span> CVE-2026-76024: Use after free in MediaStream. </span><span>Reported by Xinyang Ge on 2026-10-21</span></p><p><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/559780982\"><span>559780982</span></a><span>] </span><span>High</span><span> CVE-2026-76025: Incorrect authorization in FileSystem. </span><span>Reported by Google on 2026-09-10</span></p><p><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/567673200\"><span>567673200</span></a><span>] </span><span>High</span><span> CVE-2026-76026: Origin validation error in Autofill. </span><span>Reported by Google on 2026-09-29</span></p><p><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/568894475\"><span>568894475</span></a><span>] </span><span>High</span><span> CVE-2026-76027: Information loss in CacheStorage. </span><span>Reported by Google on 2026-10-02</span></p><p><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/569012015\"><span>569012015</span></a><span>] </span><span>High</span><span> CVE-2026-76028: Incorrect authorization in FileSystem. </span><span>Reported by Google on 2026-10-03</span></p><p><span>[TBD][</span><a href=\"https://issues.chromium.org/issues/572055997\"><span>572055997</span></a><span>] </span><span>High</span><span> CVE-2026-76029: Improper input validation in Network. </span><span>Reported by Cristian Di Nicola (crih.exe) (</span><a href=\"https://crihexe.com/\"><span>https://crihexe.com</span></a><span>) on 2026-10-09</span></p><p><span>[TBD][</span><a href=\"https://issues.chromium.org/issues/572269631\"><span>572269631</span></a><span>] </span><span>High</span><span> CVE-2026-76030: Incorrect authorization in FileSystem. </span><span>Reported by k0r3kk on 2026-10-11</span></p><p><span>[TBD][</span><a href=\"https://issues.chromium.org/issues/572556403\"><span>572556403</span></a><span>] </span><span>High</span><span> CVE-2026-76031: Incorrect authorization in Input. </span><span>Reported by Arni Hardarson (Neonix Security) on 2026-10-12</span></p><p><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/573264074\"><span>573264074</span></a><span>] </span><span>High</span><span> CVE-2026-119260: Use after free in Frames. </span><span>Reported by Google on 2026-10-13</span></p><p><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/574213633\"><span>574213633</span></a><span>] </span><span>High</span><span> CVE-2026-119261: Buffer overflow in Skia. </span><span>Reported by Google on 2026-10-16</span></p><p><span>[TBD][</span><a href=\"https://issues.chromium.org/issues/574660146\"><span>574660146</span></a><span>] </span><span>High</span><span> CVE-2026-119262: Out of bounds write in V8. </span><span>Reported by Hyeonjun Ahn (@_deayzl) on 2026-10-17</span></p><p><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/575143870\"><span>575143870</span></a><span>] </span><span>High</span><span> CVE-2026-119263: Use after free in GarbageCollection. </span><span>Reported by Xinyang Ge on 2026-10-18</span></p><p><span>[TBD][</span><a href=\"https://issues.chromium.org/issues/575150692\"><span>575150692</span></a><span>] </span><span>High</span><span> CVE-2026-119264: Use after free in Dawn. </span><span>Reported by leegn4a on 2026-10-19</span></p><p><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/575201795\"><span>575201795</span></a><span>] </span><span>High</span><span> CVE-2026-119265: Incorrect reference resolution in Quota. </span><span>Reported by Google on 2026-10-19</span></p><p><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/575202553\"><span>575202553</span></a><span>] </span><span>High</span><span> CVE-2026-119266: Incorrect reference resolution in Quota. </span><span>Reported by Google on 2026-10-19</span></p><p><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/576203565\"><span>576203565</span></a><span>] </span><span>High</span><span> CVE-2026-119267: Use after free in DOM. </span><span>Reported by Xinyang Ge on 2026-10-21</span></p><p><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/576984708\"><span>576984708</span></a><span>] </span><span>High</span><span> CVE-2026-119268: Use after free in Editing. </span><span>Reported by xinyang on 2026-10-23</span></p><p><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/577072000\"><span>577072000</span></a><span>] </span><span>High</span><span> CVE-2026-119269: Incorrect authorization in Blink. </span><span>Reported by Google on 2026-10-23</span></p><p><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/577333729\"><span>577333729</span></a><span>] </span><span>High</span><span> CVE-2026-119270: Incorrect reference resolution in CacheStorage. </span><span>Reported by Google on 2026-10-24</span></p><p><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/577403270\"><span>577403270</span></a><span>] </span><span>High</span><span> CVE-2026-119271: Uninitialized resource in Skia. </span><span>Reported by Google on 2026-10-24</span></p><p><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/569012543\"><span>569012543</span></a><span>] </span><span>Medium</span><span> CVE-2026-119272: Incorrect authorization in FileSystem. </span><span>Reported by Google on 2026-10-03</span></p><p><span><span>We would also like to thank all security researchers that worked with us during the development cycle to prevent security bugs from ever reaching the stable channel.</span></span></p><p><span><span>M</span></span><span>any of our security bugs are detected using </span><a href=\"https://code.google.com/p/address-sanitizer/wiki/AddressSanitizer\"><span>AddressSanitizer</span></a><span>, </span><a href=\"https://code.google.com/p/memory-sanitizer/wiki/MemorySanitizer\"><span>MemorySanitizer</span></a><span>, </span><a href=\"https://www.chromium.org/developers/testing/undefinedbehaviorsanitizer\"><span>UndefinedBehaviorSanitizer</span></a><span>, </span><a href=\"https://www.chromium.org/developers/testing/control-flow-integrity/\"><span>Control Flow Integrity</span></a><span>, </span><a href=\"https://chromium.googlesource.com/chromium/src/+/HEAD/testing/libfuzzer/README.md\"><span>libFuzzer</span></a><span>, or </span><a href=\"https://github.com/google/afl\"><span>AFL</span></a><span>.</span></p><p><span>Interested in switching release channels? Find out how </span><span><a href=\"https://www.chromium.org/getting-involved/dev-channel\">here</a><span>. If you find a new issue, please let us know by </span><a href=\"https://crbug.com/\">filing a bug</a><span>. The </span><a href=\"https://support.google.com/chrome/community\">community help forum</a><span> is also a great place to reach out for help or learn about common issues.</span></span></p><p><span><span>Daniel Yip</span></span></p><p><span>Google Chrome</span></p>","zhKind","complete","漏洞","补丁","Google","http://chromereleases.googleblog.com/2026/10/stable-channel-update-for-desktop_02107719452.html","Chrome Releases",{"_80":81,"_82":-5},"changelogVersion","2026-10-01T08:00","release"]
