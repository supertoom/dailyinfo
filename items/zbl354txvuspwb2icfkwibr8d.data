[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795567295000,"id","zbl354txvuspwb2icfkwibr8d","title","TwigView FileLoader 用户可控模板路径可能导致任意文件读取，1.3.3 与 2.1.2 已修复","originalTitle","TwigView FileLoader may allow arbitrary file reads through user-controlled template paths","summary","TwigView 的 FileLoader 在 `FileLoader::findTemplate()` 接收未经校验的用户可控数据时，可能导致任意文件读取。1.3.3 和 2.1.2 已包含修复，无法立即升级时应避免向 `include` 和 `extends` 标签传入用户可控数据。","reason","source",{"_68":77},"links",{"_59":76},"publishedAt","2026-11-24T22:39:23.000Z","discoveredAt","2026-11-24T22:44:34.553Z","timelineAt","category","vuln","tags",[74,75],"score",37,"selected",false,"channel","news","story",{"_71":72,"_13":73},"x","readingMode","full","author","body","outline",[],"relatedStories",[70],"topics",[66],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fvMTCRcd3-ig","reportCount",1,"additionalSourceCount",0,{"_67":30,"_68":69},"slug","name","漏洞披露",{"_71":72,"_13":73},"publicId","b159fa1e-c99a-42ff-bec1-04a1d0944d43","TwigView模板路径漏洞已修复","漏洞","补丁","https://github.com/advisories/GHSA-hq9r-72jq-2pxp","GitHub 安全公告",{"_79":80,"_81":-5},"changelogVersion","2026-10-01T08:00","release"]
