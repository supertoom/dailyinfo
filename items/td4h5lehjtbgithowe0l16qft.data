[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795653649000,"id","td4h5lehjtbgithowe0l16qft","title","CNCERT提示Cling僵尸网络新变种大范围传播，感染设备累计5600台","originalTitle","CNCERT：关于远控类僵尸网络家族Cling新变种大范围传播的风险提示","summary","CNCERT监测发现Cling僵尸网络新变种正针对Linux服务器及IoT设备大范围传播。2026年11月09日至11月20日期间，我国境内累计约5600台设备受感染，境内日上线肉鸡数最高达2730台。","reason","CNCERT披露了Cling新变种的传播规模、STUN伪装通信机制与持久化手法，可据此识别感染主机并排查相关资产。","source",{"_77":103},"links",{"_96":102},"publishedAt","2026-11-24T09:02:00.000Z","discoveredAt","2026-11-24T11:50:35.494Z","timelineAt","category","activity","tags",[80,78,84,99,100,90,101],"score",81,"selected",true,"channel","news","story",{"_92":93,"_13":94},"x","readingMode","full","author","body",{"_61":95,"_96":-5,"_97":96,"_98":37},"outline",[],"relatedStories",[91],"topics",[68,69,70,71,72,73,74],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","f8hOxMHN9rhM","reportCount",2,"additionalSourceCount",1,{"_75":89,"_77":90},{"_75":87,"_77":88},{"_75":85,"_77":86},{"_75":83,"_77":84},{"_75":81,"_77":82},{"_75":79,"_77":80},{"_75":76,"_77":78},"slug","malware","name","恶意软件","attack","攻击活动","black-market","数据窃取与黑产","botnet","僵尸网络","ransomware","勒索软件","iot","IoT 与车联网","cncert","CNCERT",{"_92":93,"_13":94},"publicId","a9f6b2ae-b42f-43bc-b4bc-29e22fbffbe7","Cling新变种借漏洞感染5600台设备","<p><span>CNCERT</span> <span>2026-11-24 17:02</span> <span>北京</span></p><p>以下文章来源于：国家互联网应急中心CNCERT</p><p><strong>国家互联网应急中心CNCERT</strong></p><p>国家计算机网络应急技术处理协调中心（简称“国家互联网应急中心”，英文简称CNCERT或CNCERT/CC），成立于2001年8月，为非政府非盈利的网络安全技术中心，是中国计算机网络应急处理体系中的牵头单位。</p><p><img src=\"/dailyinfo/media/d137a74b2941a2b8.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><span>感谢绿盟科技伏影实验室在本报告的样本分析工作中做出的重要贡献。</span></p><p><span><span>一、概述</span></span></p><p><span>近期，国家互联网应急中心（CNCERT）监测发现，僵尸网络家族 Cling 的新变种正在大范围传播，主要针对 Linux 服务器及 IoT 设备。该木马采用创新性的通信机制，隐匿能力极强：其控制端隐匿于公共 STUN 服务之中，指令嵌入 STUN 事务标识（Transaction ID）字段，使控制流量隐藏于海量正常 STUN 交互之中，传统监测手段难以有效察觉。</span></p><p><span>&nbsp;Cling木马演变速度极快，存在多个版本，本次传播的变种整体功能较为精简，移除了漏洞传播、代理、DDoS等模块，仅保留命令执行、程序下载与执行等核心功能，修复了早期版本控制端响应事务标识异常的缺陷，并使用ChaCha20算法对关键信息加密存储，伪装更难识破。攻击者的核心目的并非发动 DDoS 攻击，而是长期控制受害主机，将其作为投递其他恶意软件的跳板，危害性极高。2026年11月09日至11月20日期间，CNCERT监测发现该僵尸网络感染的日上线肉鸡数最高达到2730台，累计已有5600台设备受其感染。现将其主要情况分析披露如下。</span></p><p><span><span>二、恶意样本分析</span></span></p><p><img src=\"/dailyinfo/media/b52a978491f9f096.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>图 1 Cling僵尸网络</span></span></p><p><span><span>1.传播方式</span></span></p><p><span>研究表明，新变种剥离了漏洞利用模块，监测到当前变种主要通过CVE-2021-35394传播，早期版本部分常用漏洞如下：</span></p><p><span>CVE-2016-10372（Eir D1000 router RCE）</span></p><p><span>CVE-2023-41011（FiberHome SR1041F router RCE）</span></p><p><span>CVE-2014-8361（Realtek SDK RCE）</span></p><p><span>CVE-2023-26801（LB-LINK routers RCE）</span></p><p><span>CVE-2024-3721（TBK DVR RCE）</span></p><p><span>CVE-2025-34037（Linksys RCE ）</span></p><p><span>CVE-2016-20016（MVPower CCTV DVR RCE）</span></p><p><span><span>2.通信机制</span></span></p><p><span>Cling木马将控制端隐匿于公共 STUN 服务之中，指令嵌入 STUN 事务标识（Transaction ID）字段，使其具备极高的灵活性与隐匿性。STUN 是查询 NAT 映射地址的标准协议，其报文头含一个 12 字节的“事务标识”字段，本应是一段随机数。Cling 新变种把控制数据藏进这个字段，使控制流量与正常 STUN 交互在外观上几乎无法区分。</span></p><p><img src=\"/dailyinfo/media/b7c62f1a5e173d25.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>图 2 Cling木马 STUN 上线与控制机制</span></span></p><p><span><span>伪装身份：</span>木马内置 13 个 ChaCha20加密的STUN 服务器地址，其中 12 个为公共 STUN 服务器，1个为攻击者控制的 C&amp;C，伪装成 STUN 服务参与交互，从嫌疑对象中彻底隐身。</span></p><p><span><span>获取 NAT 映射端口：</span>&nbsp;木马周期性向全部 13 个服务器发送标准 STUN Binding Request，合法 STUN 服务器正常响应，木马由此获知自身在 NAT 后的公网映射端口。该端口是后续接收指令的入口。</span></p><p><span><span>发送自定义注册消息：</span>木马随后向全部服务器发送不符合 STUN 规范的自定义注册消息，携带映射端口和感染标签。合法 STUN 服务器按协议丢弃该异常消息；受控 C&amp;C 服务器接收并记录，从而获知 bot 的映射端口和感染标签。</span></p><p><span><span>隐藏内容：</span>之后 C&amp;C 向该映射端口发送指令，指令藏在 STUN 报文的事务标识字段里，前 2 字节为识别标记、后 10 字节为加密任务参数。由于事务标识本就是随机值，控制数据与正常响应外观一致。</span></p><p><span><span>伪装来源：</span>控制端下发指令时把源地址伪装成 Google STUN，让防守方看到的是一台全球知名 STUN 服务发来的正常流量。</span></p><p><span><span>3.核心功能</span></span></p><p><span>本次捕获的木马具备四类远程指令，可管理执行任务，并按需部署其他程序：</span></p><p><span><span>命令执行：</span></span><span>连接指定服务器，获取并解密命令后交由系统运行。</span></p><p><span><span>程序加载：</span></span><span>指令提供任务编号和下载服务器地址，木马先停止同编号旧任务，再下载新程序并赋予执行权限后启动。该能力使其可作为投递其他恶意软件的入口。</span></p><p><span><span>任务停止：</span></span><span>按编号结束此前下载并启动的子进程。</span></p><p><span><span>节点更新：</span></span><span>用指令给出的新地址替换列表中的节点，使后续上报能随控制要求调整。</span></p><p><span><span>4.持久化与对抗</span></span></p><p><span><span>配置加密：</span></span><span>新变种采用 ChaCha20 隐藏内置配置、控制参数和远程命令，进一步提升了其隐匿性。</span></p><p><span><span>替换系统工具：</span></span><span>木马替换常用下载工具“wget”。</span></p><p><span><span>开机自启：</span>并向已有的 /etc/inittab、/etc/init.d/rcS、/etc/rc.d/rc.boot 追加执行项，实现开机持久化。</span></p><p><span><span>单实例自保策略：</span></span><span>木马监听58346端口，以占用本地地址限制重复运行，该方法在传统僵尸网络家族Mirai中常用。还会尝试向 /proc/self/oom_score_adj 写入 -1000，降低因内存不足而被终止的可能。</span></p><p><span><span>5.版本更新</span></span></p><p><span>Cling木马演变速度极快，存在多个版本，本次传播的变种主要有如下特点：</span></p><p><span><span>加密增强：</span></span><span>部分旧版本未加密关键信息，本次捕获版本均采用 ChaCha20 隐藏内置配置信息，提高隐匿性。</span></p><p><span><span>功能精简：</span></span><span>移除内置的扫描、漏洞利用、代理、DDoS等功能，保留命令执行与程序下载执行，功能重心转向控制主机的持续利用。</span></p><p><span><span>隐匿改进：</span></span><span>修改早期版本真实控制端响应事务标识与STUN服务器回复数据存在差异的缺陷，伪装更难识破，进一步提升了通信的隐蔽性。</span></p><p><span><span>控制端调整：</span></span><span>C&amp;C更换为新的ip。</span></p><p><span><span>三、感染规模</span></span></p><p><span>通过监测分析发现，2026年11月09日至20日期间，Cling 僵尸网络在我国境内感染肉鸡规模约5600台，境内日上线肉鸡数量最高达2730台。其感染量变化趋势如下：</span></p><p><img src=\"/dailyinfo/media/8c843ff9b6523be4.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>图 3 境内感染终端数量</span></span></p><p><span><span>四、总结</span></span></p><p><span><span>Cling 木马借</span></span><span>用 STUN 服务完成上线登记，再把指令藏入事务标识字段，以常见协议交互掩护控制联系，这种隐匿通信设计在现有僵尸网络中较为少见。其功能集中于远程执行、程序部署和持续运行，体现出攻击者对已控主机长期利用的侧重。工具替换、启动项持久化与进程隐藏增加了排查和清理的复杂性，该木马已对Linux服务器与IoT设备生态构成现实威胁，需要持续监测和高度警惕。</span></p><p><span><span>五、防范建议</span></span></p><p><span>请广大网民和网络运营者强化风险意识，加强安全防范，避免不必要的经济损失，主要建议包括：</span></p><p><span>1.及时梳理资产清单，修复相关系统漏洞，包括历史漏洞和最新曝光漏洞，IoT设备应同步升级固件。</span></p><p><span>2.加强口令强度，避免使用弱口令，密码设置应包含大小写字母、数字和符号，建议使用16位或更长密码，不同设备使用不同口令并定期更换。</span></p><p><span>3.安装终端防护软件，定期全盘查杀；重点排查异常进程、异常外连，以及本提示所列特征字符串。</span></p><p><span>4.加强STUN异常流量监测，重点核查周期性向多个STUN节点（UDP 3478）发送的注册流量，以及非随机、呈固定结构的事务标识。</span></p><p><span>5.加强主机侧专项排查，重点检查/etc/inittab、/etc/rc.d/rc.boot等位置的.alya启动项。</span></p><p><span>6.发现主机感染后，立即核实受控情况与入侵途径，对受害主机隔离清理，并及时向属地主管部门报告。</span></p><p><span><span>六、相关IoC</span></span></p><p><span>样本MD5:</span></p><p><span>84ced85e53bc326f8b11115ae4bc24a7</span></p><p><span>65d94c9dddea41ef4690f193fbc54ec3</span></p><p><span>92533318fb6f0365eefd25090e7df146</span></p><p><span>be719987bf96fa16ac98b7c2a280cc74</span></p><p><span>e37b94dfcaa56924142c344edcb3652a</span></p><p><span>79de772daa218e25a812ecbedca08476</span></p><p><span>606f2fee6fa4b3ca556187c9ee709f3d</span></p><p><span>b672e3238742504faa93d5a7cb8d0ea0</span></p><p><span>dc11a0e68e5235e36480ddf14f08afbe</span></p><p><span>76021af2d82cade790dd87d3af0f80c9</span></p><p><span>16ef618bf21a3322c6793be87d553f08</span></p><p><span>fe35c5b3cfa118fdf8e1afb9a134e084</span></p><p><span>下载地址：</span></p><p><span>http[:]//202.110.70.60:800/alya.x86</span></p><p><span>http[:]//202.110.70.60:800/alya.mipsel</span></p><p><span>http[:]//202.110.70.60:800/alya.arc</span></p><p><span>http[:]//202.110.70.60:800/alya.mips</span></p><p><span>http[:]//202.110.70.60:800/alya.x86_64</span></p><p><span>http[:]//202.110.70.60:800/alya.m68k</span></p><p><span>http[:]//202.110.70.60:800/alya.i486</span></p><p><span>http[:]//202.110.70.60:800/alya.sparc</span></p><p><span>http[:]//202.110.70.60:800/alya.powerpc</span></p><p><span>http[:]//58.211.144.243:800/alya.mipsel</span></p><p><span>http[:]//58.211.144.243:800/alya.mips</span></p><p><span>http[:]//58.211.144.243:800/alya.x86_64</span></p><p><span>http[:]//58.211.144.243:800/alya.i486</span></p><p><span>http[:]//58.211.144.243:800/alya.arc</span></p><p><span>http[:]//58.211.144.243:800/alya.powerpc</span></p><p><span>http[:]//58.211.144.243:800/alya.m68k</span></p><p><span>http[:]//118.45.196.225:800 &nbsp; &nbsp;</span></p><p><span>http[:]//120.193.219.210:800 &nbsp; &nbsp;</span></p><p><span>C&amp;C：</span></p><p><span>209.99.188[.]119</span></p><p><strong><span><span>推荐阅读</span></span></strong></p><ul><li><p><span><a href=\"http://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247499450&amp;idx=2&amp;sn=2da3ca2e0b4d4f9f56ea7f7579afc378&amp;chksm=ebfab99adc8d308c3ba6e7a74bd41beadf39f1b0e38a39f7235db4c305c06caa49ff63a0cc1d&amp;scene=21#wechat_redirect\">网安智库平台长期招聘兼职研究员</a></span></p></li><li><p><span><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247501251&amp;idx=1&amp;sn=8b6ebecbe80c1c72317948494f87b489&amp;chksm=ebfa82e3dc8d0bf595d039e75b446e14ab96bf63cf8ffc5d553b58248dde3424fb18e6947440&amp;token=525430415&amp;lang=zh_CN&amp;scene=21#wechat_redirect\">欢迎加入“安全内参热点讨论群”</a></span></span></p></li></ul><hr><p><span><span>文章来源：</span><span>国家互联网应急中心CNCERT</span></span></p><p><span><span>点击下方卡片关注我们，</span></span></p><p><span><span>带你一起读懂网络安全 ↓</span></span></p><p><a href=\"https://www.secrss.com/?wx\">阅读原文</a></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=64f3d4d4&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzI4NDY2MDMwMw%3D%3D%26mid%3D2247516939%26idx%3D2%26sn%3Dd7d62ea9809e883a2cd0c687b29eb17b\">跳转微信打开</a></p>","original","zhKind","complete","数据窃取","IoT","绿盟","https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&mid=2247516939&idx=2&sn=d7d62ea9809e883a2cd0c687b29eb17b","安全内参",{"_105":106,"_107":-5},"changelogVersion","2026-10-01T08:00","release"]
