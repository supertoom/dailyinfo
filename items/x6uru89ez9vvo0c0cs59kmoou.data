[{"_1":2,"_3":4},"root",{"_5":114},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794444100000,"id","x6uru89ez9vvo0c0cs59kmoou","title","攻击者利用假 OpenAI、SpaceX 和 Anthropic 活动窃取 Microsoft、Google 账户","originalTitle","Fake OpenAI, SpaceX events used to steal Microsoft, Google accounts","summary","Push Security 披露，攻击者以 OpenAI、SpaceX 和 Anthropic 活动为诱饵，通过 Google、Zapier URL 缩短服务、GoTo Webinar 邮件及合法 Zoom 活动页分发链接，以免费 AI 服务和奖励诱导员工使用企业账户登录。","reason","文章拆解了假活动页面如何组合两套 PhaaS 平台实施设备码钓鱼与 AiTM 劫持，攻击链和处置建议较完整。","source",{"_76":113},"links",{"_102":112},"publishedAt","2026-11-05T21:30:30.000Z","discoveredAt","2026-11-06T04:39:27.657Z","timelineAt","category","activity","tags",[79,106,107,77,108,109,110,111],"score",70,"selected",true,"channel","news","story",{"_89":90,"_13":91},"x","readingMode","full","author","Lawrence Abrams","body",{"_61":101,"_102":-5,"_103":104,"_105":37},"outline",[92,93],"relatedStories",[88],"topics",[68,69,70,71,72,73],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fF9t3X8Qmsc4","reportCount",1,"additionalSourceCount",0,{"_74":86,"_76":87},{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","ai-security","name","AI 安全","attack","攻击活动","email","邮件与钓鱼","identity","身份与访问","google","Google / 谷歌","microsoft","Microsoft / 微软",{"_89":90,"_13":91},"publicId","d1d15757-583b-437e-ad18-d2144fbd0e88","虚假 AI 活动窃取企业账号凭据",{"_11":99,"_95":100,"_97":98},{"_11":94,"_95":96,"_97":98},"sec-2","text","发现现有防御可能遗漏的电子邮件威胁。","level",2,"sec-1","虚假 AI 活动导致账户钓鱼","<p><img alt=\"Phishing hook\" height=\"900\" src=\"/dailyinfo/media/913ed12c8ed35ab0.jpg\" srcset=\"/dailyinfo/media/23f71cbe9b7b0103.jpg 720w, /dailyinfo/media/9b405c76c3d7229b.jpg 1200w, /dailyinfo/media/913ed12c8ed35ab0.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>黑客正在利用伪造的 OpenAI、SpaceX 和 Anthropic 活动邀请，将员工引诱至网络钓鱼攻击中；他们使用两个不同的钓鱼即服务（PhaaS）平台，窃取 Microsoft 和 Google 账户凭据及身份验证会话。</p><p>根据 <a href=\"http://pushsecurity.com/blog/ai-themed-fake-event-campaign-analysis\">Push Security</a> 的一份新报告，攻击者使用看起来很逼真的活动注册页面，提供高级 AI 服务及其他奖励的免费访问权限，诱骗受害者使用企业账户登录。</p><p>这些攻击引人关注之处在于，同一 phishing 页面集成了两个独立的钓鱼即服务（PhaaS）平台 Kali365 和 VoidProxy，通过不同的身份验证攻击针对 Microsoft 和 Google 账户。</p><p><a href=\"https://www.wiz.io/lp/securing-ai-agents-101?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY26Q3_INB_FORM_Securing-AI-Agents-101&amp;sfcid=701Py00000RTEWMIA5&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AI-Agents-101\"><img src=\"/dailyinfo/media/2ddb46eee4d24330.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>Kali365 发起 Microsoft 设备代码钓鱼攻击，而 VoidProxy 则充当中间人（AiTM）反向代理，拦截 Google 登录并窃取身份验证会话 Cookie。</p><p>Microsoft 攻击还将 VoidProxy 作为第二阶段使用，使攻击者在通过 Kali365 获取身份验证令牌后，还能捕获凭据和会话 Cookie。</p><p>Push Security 表示，其在 2026 年 10 月下旬检测到并拦截了对恶意活动注册页面的访问。</p><p>此次活动之前，已有类似活动被 <a href=\"https://x.com/anyrun_app/status/2077370282193404060\">ANY.RUN</a> 记录在案；7 月，攻击者滥用合法的 Zoom 活动页面推广伪造的 Meta、OpenAI 和 Anthropic 活动，最终引发设备代码钓鱼和 AiTM 钓鱼攻击。</p><p>Cofense 还<a href=\"http://cofense.com/blog/would-your-employees-join-a-fake-anthropic-ai-preview\">近日报道</a>了冒充 Anthropic 活动邀请的钓鱼邮件；这些邮件通过 GoTo Webinar 的邮件基础设施发送，并将收件人重定向至多个网站，最终到达伪造的注册页面。</p><h2 id=\"sec-1\">虚假 AI 活动导致账户钓鱼</h2><p>目前尚不清楚攻击者最初如何分发钓鱼链接，但 Push Security 发现，他们使用来自可信服务的链接（包括 Google 和 Zapier 的 URL 短链接）将受害者重定向至恶意活动注册页面。</p><p>早期版本的活动中，邀请邮件还通过 GoTo Webinar 的邮件系统或合法的 Zoom 活动页面分发。</p><p>Push Security 表示，攻击者使用两个自定义钓鱼工具包（分别追踪为 ZoomMock 和 MSDRoot）创建虚假活动页面，再将受害者引导至 Kali365 和 VoidProxy 钓鱼服务。</p><p>研究人员认为，这两个工具包由同一批威胁行动者运营，因为它们使用共享的基础设施和相同的攻击目标。</p><p>此次活动冒充由 OpenAI、SpaceX 和 Anthropic 举办的活动，注册页面则被设计成类似合法活动网站。</p><p>其中一个钓鱼页面宣传一项名为“ChatGPT for Social &amp; Digital Marketing Teams”的 OpenAI 活动，承诺向参与者提供三个月的 ChatGPT Pro。</p><figure><img alt=\"OpenAI phishing page\" height=\"600\" src=\"/dailyinfo/media/33d45b83eb171971.jpg\" srcset=\"/dailyinfo/media/d0deed5c878b641a.jpg 720w, /dailyinfo/media/fcdf04df2006edf3.jpg 1200w, /dailyinfo/media/33d45b83eb171971.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"935\">\n<figcaption><strong>OpenAI 钓鱼页面</strong><br>\n<em>来源：BleepingComputer</em></figcaption>\n</figure><p>另一个页面宣传 11 月 12 日举办的一场 SpaceX 私人活动，向注册者提供三个月的 Grok Heavy 或一份“SpaceX 股份”。</p><p>研究人员还发现了一个冒充 AWS re:Invent 2026 上 Anthropic 活动的钓鱼页面，目前该页面已被下架。</p><p>这些伪造注册页面告诉访问者，必须使用工作账户登录才能注册并领取所宣传的奖励。</p><p>在显示伪造注册页面前，这些网站会展示一个 Cloudflare CAPTCHA，要求用户“确认您不是机器人”。这可阻止自动化安全平台扫描钓鱼网站。</p><p>当访问者到达活动注册页面时，会看到两个选项：“Continue with Microsoft”和“Continue with Google”。</p><p>当受害者选择 Microsoft 选项时，钓鱼页面会联系 Kali365 平台，生成 Microsoft 设备身份验证代码。</p><figure><img src=\"/dailyinfo/media/7d546f93126ac4bc.jpg\" srcset=\"/dailyinfo/media/f9ea9c52fa60a5d1.jpg 720w, /dailyinfo/media/3f16581e6afc1cda.jpg 1200w, /dailyinfo/media/7d546f93126ac4bc.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Microsoft device code authentication form on phishing site\" height=\"600\" width=\"936\">\n<figcaption><strong>钓鱼网站上的 Microsoft 设备代码身份验证表单</strong><br>\n<em>来源：BleepingComputer</em></figcaption>\n</figure><p>设备代码钓鱼攻击是指攻击者滥用合法的 OAuth 2.0 设备授权流程，获取受害者 Microsoft Entra 账户的身份验证令牌。</p><p>随后，攻击者可以利用这些令牌访问用户的资源和已连接的 SSO 应用，例如 Microsoft 365、Salesforce、Google Workspace、Dropbox、Adobe、SAP、Slack、Zendesk、Atlassian 等众多应用。</p><p>过去，设备代码钓鱼攻击曾被用于<a href=\"https://www.bleepingcomputer.com/news/security/hackers-target-microsoft-entra-accounts-in-device-code-vishing-attacks/\">数据窃取</a>和<a href=\"https://www.bleepingcomputer.com/news/security/microsoft-365-accounts-targeted-in-wave-of-oauth-phishing-attacks/\">网络间谍攻击</a>。</p><p>访问者会被指示复制该代码，并在 Microsoft 的合法设备登录网站上输入代码，随后进行身份验证并批准请求。</p><p>这使 Kali365 钓鱼平台无需受害者直接披露密码，即可窃取 Microsoft 身份验证令牌。</p><p>设备代码身份验证成功后，页面会将受害者重定向至 VoidProxy Microsoft 登录页面，攻击者还可以在那里截获受害者的密码和会话 Cookie。</p><p>当受害者选择 Google 身份验证选项时，钓鱼页面会改为打开一个弹出窗口，其中包含 VoidProxy PhaaS 提供的 Google 登录页面。</p><p>该平台充当位于受害者浏览器与 Google 登录页面之间的中间人（AiTM）平台，代理登录表单，并窃取凭据、MFA 响应和会话 Cookie。</p><p>Kali365 和 VoidProxy 平台都允许攻击者通过截获已经完成身份验证的会话来绕过多重身份验证；在设备代码身份验证的情况下，则可完全绕过 MFA。</p><p>为防范这些攻击，员工应避免在不熟悉的网站上输入 Microsoft 设备身份验证代码，并对要求使用企业账户登录以领取奖励的活动邀请保持警惕。</p><p>组织还可以限制不需要使用设备代码身份验证的场景，并采用具备抗钓鱼能力的 MFA（例如 FIDO2 安全密钥），以帮助防止会话劫持。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/0c6c2476908e136e.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-2\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 代理会分析电子邮件意图、上下文和行为，发现钓鱼、商业电子邮件入侵和发票欺诈。</p><p>进行一次为期 14 天的 Microsoft 365 或 Google Workspace 只读扫描，看看有哪些威胁正在穿透防御，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始免费的电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","钓鱼","凭据","Microsoft","Google","Cloudflare","腾讯","https://www.bleepingcomputer.com/news/security/fake-openai-spacex-events-used-to-steal-microsoft-google-accounts/","BleepingComputer",{"_115":116,"_117":-5},"changelogVersion","2026-10-01T08:00","release"]
