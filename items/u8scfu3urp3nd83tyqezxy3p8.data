[{"_1":2,"_3":4},"root",{"_5":93},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1794195834000,"id","u8scfu3urp3nd83tyqezxy3p8","title","OpenSSH musl 密码认证绕过漏洞影响 7.3p1 至 10.6p2 之前版本","originalTitle","【漏洞通告】OpenSSH musl 密码认证绕过漏洞","summary","OpenSSH 存在密码认证绕过漏洞（SF_2026_46117），影响 7.3p1 <= OpenSSH < 10.6p2，威胁等级为严重。攻击者无需有效凭据，远程提交任意 257–1024 字节的超长口令即可通过本不开放密码登录的账户认证，并在特定场景下进一步获取 root 权限。","reason","source",{"_72":92},"links",{"_82":91},"publishedAt","2026-11-06T05:06:00.000Z","discoveredAt","2026-11-07T03:29:30.464Z","timelineAt","category","vuln","tags",[85,86,87,88,89,90,76],"score",83,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body",{"_60":81,"_82":-5,"_83":82,"_84":55},"outline",[],"relatedStories",[77],"topics",[67,68,69],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","fqGOPsltsVck","reportCount",1,"additionalSourceCount",0,{"_70":75,"_72":76},{"_70":30,"_72":74},{"_70":71,"_72":73},"slug","blue-team","name","蓝队与运营","漏洞披露","sangfor","深信服",{"_78":79,"_13":80},"publicId","9752aa65-824d-43a4-962f-2d752946dc78","OpenSSH musl认证绕过漏洞可致RCE","<p><span>深瞳漏洞实验室</span> <span>2026-11-06 13:06</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/1169e06d2b52ce57.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>2026年11月6日，深瞳漏洞实验室监测到一则OpenSSH组件存在绕过认证漏洞的信息，漏洞威胁等级：严重。</p><p><img src=\"/dailyinfo/media/4125f460805a937b.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span><span>漏洞名称：</span></span></strong></p><p><span>OpenSSH musl 密码认证绕过漏洞(SF_2026_46117)</span></p><p><strong><span><span>组件名称：</span></span></strong></p><p><span>OpenSSH</span></p><p><span><strong><span>影响范围：</span></strong></span></p><p><span>7.3p1 &lt;= OpenSSH &lt; 10.6p2</span></p><p><strong><span><span>漏洞类型：</span></span></strong></p><p><span>绕过认证</span></p><p><span><strong><span>利用条件：</span></strong></span></p><p><span>1、用户认证：否</span></p><p><span>2、前置条件：</span></p><p><span>1）PasswordAuthentication 开启</span></p><p><span>2）PAM不启用且sshd 运行于 musl libc</span></p><p><span>3）存在 shadow 密码字段为 * 的账号且系统内至少还有一个设真实密码的账号</span></p><p><span>3、触发方式：远程</span></p><p><strong><span><span>综合评价：</span></span></strong></p><p><span>&lt;综合评定利用难度&gt;：容易。</span></p><p><span>&lt;综合评定威胁等级&gt;：高危，能造成认证绕过，获取服务器权限。</span></p><p><strong><span><span>官方解决方案：</span></span></strong></p><p><span>已发布</span></p><p><strong><span>漏洞分析</span></strong></p><p><img src=\"/dailyinfo/media/904ba2a99af834d0.webp\" loading=\"lazy\" decoding=\"async\"></p><p><b><span>组件介绍</span></b></p><p><span>OpenSSH是使用SSH透过计算机网络加密通信的实现。它是取代由SSH Communications Security所提供商用版本的开放源代码方案。目前OpenSSH是OpenBSD的子项目。</span></p><p><img src=\"/dailyinfo/media/6b843c581a0a77c5.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>漏洞简介</span></strong></p><p><span>2026年11月6日，深瞳漏洞实验室监测到一则OpenSSH组件存在绕过认证漏洞的信息，漏洞威胁等级：严重。</span></p><p><span>sshd 在未启用 PAM 时，以 crypt() 的计算结果与 /etc/shadow 存储的口令字段直接比对来验证密码；当账户口令字段为 *（锁定或仅限密钥登录）时，sshd 会借用系统内其他真实哈希的盐值完成计算，而 musl libc 的 crypt() 对超过 256 字节的口令计算失败并返回字符串 * 而非 NULL，</span><strong><span><span>导致攻击者提交任意 257–1024 字节的超长口令后，计算结果恰好与存储的 * 比对相等、验证通过。因此运行于 musl libc 且未启用 PAM 的 OpenSSH 服务（如 Alpine、OpenWrt）可被攻击者在无任何凭据的情况下登录这类本不接受密码登录的账户，并在特定场景下进一步获得 root 权限。</span></span></strong></p><p><img src=\"/dailyinfo/media/172deaa54daea89a.webp\" loading=\"lazy\" decoding=\"async\"></p><p><b><span>漏洞验证</span></b></p><p><span>搭建受影响的Alpine Linux，OpenSSH 9.7p1复现该漏洞，效果如下：</span></p><p><img src=\"/dailyinfo/media/0f06036435dad1bc.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>影响范围</span></strong></p><p><span>目前受影响的OpenSSH版本：</span></p><p><span>7.3p1 &lt;= OpenSSH &lt; 10.6p2</span></p><p><strong><span>解决方案</span></strong></p><p><img src=\"/dailyinfo/media/4a7d2ca992339663.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>官方修复建议</span></strong></p><p><span>升级OpenSSH 至最新版本：</span></p><p><span>OpenSSH &gt;= 10.6p2</span><span><br></span><span>下载链接：<a href=\"https://www.openssh.org/txt/release-10.6p2\">https://www.openssh.org/txt/release-10.6p2</a></span></p><p><img src=\"/dailyinfo/media/78c454571c1fecc7.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span><span>临时修复建议</span></span></strong></p><p><span>检查sshd版本是否位于漏洞版本区间， 若无法立即升级，可在 /etc/ssh/sshd_config 中设置 PasswordAuthentication no改用公钥认证并重启 sshd。</span></p><p><img src=\"/dailyinfo/media/fba120ccb904842b.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>深信服解决方案</span></strong></p><p><strong><span>风险资产发现</span></strong></p><p><span>支持对OpenSSH的主动检测，</span><strong><span><span>可批量检出业务场景中该事件的受影响资产情况，</span></span></strong><span>相关产品如下：</span></p><p><strong><span><span>【深信服统一端点安全管理系统aES】</span></span></strong><span>已发布资产检测方案，指纹ID:0000336。</span></p><p><strong><span><span>【深信服云镜YJ】</span></span></strong><span>已发布资产检测方案，指纹ID:0000336。</span></p><p><strong><span><span>【深信服漏洞评估工具TSS】</span></span></strong><span>已发布资产检测方案，指纹ID:0000336。</span></p><p><b><span>参考链接</span></b></p><p><span><a href=\"https://sshhole.com/\">https://sshhole.com/</a></span></p><p><span><a href=\"https://www.openssh.org/txt/release-10.6p2\">https://www.openssh.org/txt/release-10.6p2</a></span></p><p><span><a href=\"https://git.musl-libc.org/cgit/musl/commit/?id=b3c4cc121f70faea45389fe7ddc1127ed5cbd8bb\">https://git.musl-libc.org/cgit/musl/commit/?id=b3c4cc121f70faea45389fe7ddc1127ed5cbd8bb</a></span></p><p><b><span>时间轴</span></b></p><p><strong><span>2026/11/06</span></strong></p><p><span>深瞳漏洞实验室监测到OpenSSH musl 密码认证绕过漏洞信息。</span></p><p><strong><span>2026/11/06</span></strong></p><p><span>深瞳漏洞实验室发布漏洞通告。</span></p><p><span>点击</span><strong><span><span>阅读原文</span></span></strong><span>，及时关注并登录深信服</span><strong><span>智安全平台</span></strong><span>，可轻松查询漏洞相关解决方案。</span></p><p><img src=\"/dailyinfo/media/f72335681b6a153a.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img src=\"/dailyinfo/media/18fd909d5a0e9e9b.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><a href=\"https://sec.sangfor.com.cn/security-vulnerability/detail?vuln_sfv=SF_2026_46117%5cx26amp;lang=ZH-CN\">阅读原文</a></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=7d6471b7&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzg2NjgzNjA5NQ%3D%3D%26mid%3D2247526379%26idx%3D1%26sn%3Dba2a13b0a899a5255ef162d9e82673db\">跳转微信打开</a></p>","original","zhKind","complete","漏洞","复现","漏洞利用","补丁","网络设备","加固","https://mp.weixin.qq.com/s?__biz=Mzg2NjgzNjA5NQ==&mid=2247526379&idx=1&sn=ba2a13b0a899a5255ef162d9e82673db","深信服千里目安全实验室",{"_94":95,"_96":-5},"changelogVersion","2026-10-01T08:00","release"]
