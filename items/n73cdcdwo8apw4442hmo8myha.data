[{"_1":2,"_3":4},"root",{"_5":96},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795567284000,"id","n73cdcdwo8apw4442hmo8myha","title","European Commission 确认 EU Academy 遭攻击并发生用户数据泄露","originalTitle","European Commission confirms data theft in EU Academy breach","summary","European Commission 确认，攻击者于 October 22 使用 ARTEX AI 渗透测试框架入侵其系统，EU Academy 在线学习平台的用户姓名和邮箱等个人信息遭窃取，受影响人数尚未披露。","reason","source",{"_73":95},"links",{"_61":94},"publishedAt","2026-11-24T16:22:44.000Z","discoveredAt","2026-11-24T16:37:33.165Z","timelineAt","category","activity","tags",[74,92,76,93],"score",58,"selected",false,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","Sergiu Gatlan","body",{"_88":-5,"_61":89,"_90":-5,"_91":36},"outline",[83],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fSN2oUynKaRE","reportCount",3,"additionalSourceCount",2,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","attack","name","攻击活动","ai-offense","AI 攻防","email","邮件与钓鱼",{"_80":81,"_13":82},"publicId","94471d20-e283-4a73-a257-3bf90d7be5de","欧盟委员会确认EU Academy用户数据泄露",{"_11":84,"_85":86,"_87":67},"sec-1","text","Uncover email threats your existing defenses may miss.","level","zh","<p><img alt=\"European Union flag\" height=\"900\" src=\"/dailyinfo/media/a61375713d6ff252.jpg\" srcset=\"/dailyinfo/media/8dafd7fd77252275.jpg 720w, /dailyinfo/media/217dd894408aba6b.jpg 1200w, /dailyinfo/media/a61375713d6ff252.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>The European Commission, the European Union's main executive body, has confirmed that attackers breached its EU Academy online learning hub and stole the personal data of an undisclosed number of users.</p><p>This follows the Commission's Thursday disclosure that hackers <a href=\"https://www.euronews.com/2026/11/19/eu-commission-hit-by-large-scale-cyberattack-with-data-leakage-unknown\">breached its systems</a> on October 22 using the <a href=\"https://www.cert.europa.eu/blog/from-penetration-testing-to-cyber-threat-beware-of-artex\">ARTEX AI-powered penetration testing framework</a>, causing service disruptions that also affected its internal Sysper HR platform.</p><p>\"As a protective and preventive measure, we temporarily took down several ​applications and most of them have since been restored. The investigation is still ongoing,\" spokesperson Thomas Regnier told reporters at the time.&nbsp;\"We are taking any necessary steps based on the findings as they come. We have not detected any evidence of a data breach affecting Commission staff as a whole.\"</p><p><a href=\"https://www.wiz.io/lp/claude-code-security-best-practices-cheat-sheet?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q3_INB_FORM_Claude-Code-Security-Best-Practices&amp;sfcid=701Vh00000gJQZuIAO&amp;utm_term=FY27Q4-bleepingcomputer-article-970x250-Nov&amp;utm_content=Claude-Code-Best-Practices\"><img src=\"/dailyinfo/media/d1878a942593a18c.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>While the Commission said it hasn't received a ransom demand and has yet to attribute the attack, Regnier confirmed in a <a href=\"https://audiovisual.ec.europa.eu/en/media/video/I-298395\">Monday press briefing</a> that the attackers also breached the EU Academy platform, used to learn more about EU policies and follow EU online courses.</p><p>Regnier also confirmed a data leak following the EU Academy incident, which is still under investigation and has affected users' personal information, including their names and email addresses.</p><p>\"And as a precautionary measure, given that the fact that there is a data leak that is confirmed including names and email addresses,today there was a message to all users on the EU academy website,\" he added.&nbsp;\"This is definitely a cyber attack, a cyber campaign that was targeted against the Commission via an AI assisted tool. When it comes to the attribution, we would need the investigation to be concluded to be able to find out who is behind this.\"</p><p>The Commission has also <a href=\"https://academy.europa.eu/moodle-maintenance.html\">published a notice</a> on the EU Academy website about this cybersecurity incident, informing users that public access to the platform has been disabled and warning them to be suspicious of unsolicited emails or messages that may be part of potential phishing attacks.</p><p>The European Commission <a href=\"https://www.bleepingcomputer.com/news/security/european-commission-discloses-breach-that-exposed-staff-data/\">disclosed another data breach in February</a> after discovering on January 30 that a mobile device management platform used to manage staff devices had been compromised.</p><p>More recently, it <a href=\"https://www.bleepingcomputer.com/news/security/european-commission-confirms-data-breach-after-europaeu-hack/\">disclosed an additional incident</a> on March 27 after <a href=\"https://www.bleepingcomputer.com/news/security/european-commission-investigating-breach-after-amazon-cloud-account-hack/\">BleepingComputer reached out for confirmation</a> that the Commission's Amazon cloud environment had been breached. The EU's Cybersecurity Service (CERT-EU) later <a href=\"https://www.bleepingcomputer.com/news/security/cert-eu-european-commission-hack-exposes-data-of-30-eu-entities/\">attributed the March cloud hack to the TeamPCP threat group</a> and said the resulting breach exposed the data of at least 29 other Union entities.</p><p>These recent security breaches follow the Commission's <a href=\"https://www.bleepingcomputer.com/news/security/eu-plans-cybersecurity-overhaul-to-block-foreign-high-risk-suppliers/\">January 20 proposal for new cybersecurity legislation</a> to strengthen defenses against cybercrime groups and state-backed actors targeting Europe's critical infrastructure.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/05e456735a2a4381.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Uncover email threats your existing defenses may miss.</a>\n        </h2><p>Adaptive Security's AI agents analyze email intent, context, and behavior to uncover phishing, business email compromise, and invoice fraud.</p><p>See what's getting through with a 14-day read-only scan of Microsoft 365 or Google Workspace, with no MX changes.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Start your free email security scan.</a>\n    </p>","zhKind","complete","数据泄露","钓鱼","https://www.bleepingcomputer.com/news/security/european-commission-confirms-data-theft-in-eu-academy-breach/","BleepingComputer",{"_97":98,"_99":-5},"changelogVersion","2026-10-01T08:00","release"]
