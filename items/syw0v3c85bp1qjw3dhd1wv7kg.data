[{"_1":2,"_3":4},"root",{"_5":126},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1793672468000,"id","syw0v3c85bp1qjw3dhd1wv7kg","title","Microsoft 解析 2,056 个在野利用 CVE 的共同特征","originalTitle","What exploited vulnerabilities have in common: A data-driven analysis of real-world attacks","summary","Microsoft Security Research 分析截至 2026 年 9 月约 383,000 个已披露 CVE，其中 2,056 个与真实攻击相关。","reason","source",{"_74":125},"links",{"_61":124},"publishedAt","2026-11-02T20:20:59.000Z","discoveredAt","2026-11-02T21:56:35.289Z","timelineAt","category","disclosure","tags",[75,77,121,79,122,123],"score",55,"selected",false,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Microsoft Security Research, Yair Tsarfaty and Or Begam","body",{"_117":-5,"_61":118,"_119":-5,"_120":36},"outline",[86,87,88,89,90,91,92,93,94],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","f6hoIjEfORcc","reportCount",1,"additionalSourceCount",0,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","research","name","技术研究","exploited","在野利用","vuln-mgmt","漏洞管理","microsoft","Microsoft / 微软",{"_83":84,"_13":85},"publicId","2dd9dcd6-a835-45cf-bec0-964a14c41ca6","微软分析真实攻击所利用漏洞特征",{"_11":115,"_96":116,"_98":99},{"_11":113,"_96":114,"_98":99},{"_11":111,"_96":112,"_98":99},{"_11":109,"_96":110,"_98":106},{"_11":107,"_96":108,"_98":106},{"_11":104,"_96":105,"_98":106},{"_11":102,"_96":103,"_98":99},{"_11":100,"_96":101,"_98":99},{"_11":95,"_96":97,"_98":99},"sec-9","text","Learn More","level",2,"sec-8","References","sec-7","How Microsoft Security helps defenders act","sec-6","Next in line",3,"sec-5","Impact, exposure and where to focus","sec-4","Patching is slow, while exploitation is fast","sec-3","Where defenders should focus","sec-2","Vulnerabilities exploited in the wild","sec-1","Classifying the vulnerability landscape","zh","<ol><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/02/exploited-vulnerabilities-common-data-driven-analysis-real-world-attacks/#classifying-the-vulnerability-landscape\">Classifying the vulnerability landscape</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/02/exploited-vulnerabilities-common-data-driven-analysis-real-world-attacks/#vulnerabilities-exploited-in-the-wild\">Vulnerabilities exploited in the wild</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/02/exploited-vulnerabilities-common-data-driven-analysis-real-world-attacks/#where-defenders-should-focus\">Where defenders should focus</a><ol><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/02/exploited-vulnerabilities-common-data-driven-analysis-real-world-attacks/#patching-is-slow-while-exploitation-is-fast\">Patching is slow, while exploitation is fast</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/02/exploited-vulnerabilities-common-data-driven-analysis-real-world-attacks/#impact-exposure-and-where-to-focus\">Impact, exposure and where to focus</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/02/exploited-vulnerabilities-common-data-driven-analysis-real-world-attacks/#next-in-line\">Next in line</a></li></ol></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/02/exploited-vulnerabilities-common-data-driven-analysis-real-world-attacks/#how-microsoft-security-helps-defenders-act\">How Microsoft Security helps defenders act</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/02/exploited-vulnerabilities-common-data-driven-analysis-real-world-attacks/#references\">References</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/02/exploited-vulnerabilities-common-data-driven-analysis-real-world-attacks/#learn-more\">Learn More</a></li></ol><p>The vulnerability landscape continues to expand. From 1999 through September 2026, approximately <a href=\"https://www.cve.org/About/Metrics\">383,000</a> software vulnerabilities had been disclosed across platforms and technologies, yet only about 2,000 CVEs (roughly 0.5%) have been linked to real-world exploitation.</p><p>Those vulnerabilities follow clear patterns. Threat actors disproportionately target flaws that enable system takeover, particularly remote code execution, privilege escalation, and authentication bypass. AI-assisted vulnerability discovery and exploit development could further shorten the window defenders have to respond.</p><p>Patching remains essential, but remediation can take weeks or months on critical systems, and some legacy or unsupported systems cannot be patched. Defenders therefore need to concentrate protection where it can have the greatest impact, considering both the likelihood of exploitation and the potential blast radius of a successful attack.</p><h2 id=\"sec-1\">Classifying the vulnerability landscape</h2><p>To make this large vulnerability population actionable, we analyzed each CVE across two dimensions: impact class and affected platform.</p><p>Impact class captures the outcome a threat actor could achieve by exploiting a vulnerability. Each CVE is assigned to the most consequential impact it directly enables. For example, when a vulnerability can bypass authentication and directly enable remote code execution (RCE), we classify it as RCE. This approach helps distinguish the underlying type of vulnerability from the security impact an attacker could achieve.</p><ul>\n<li><strong>Server-side RCE: </strong>Remote code execution on a network-exposed service without user interaction.</li>\n\n\n\n<li><strong>Client-side RCE: </strong>Remote code execution that requires a user to open or run malicious content.</li>\n\n\n\n<li><strong>Local code execution: </strong>Code or command execution requiring local access or an existing foothold.</li>\n\n\n\n<li><strong>Local privilege escalation: </strong>Elevation from lower-level access to SYSTEM or root privileges.</li>\n\n\n\n<li><strong>Authentication or authorization bypass: </strong>Circumvention of authentication or access controls.</li>\n\n\n\n<li><strong>Security-control bypass: </strong>Circumvention of protections such as sandboxing, secure boot, or SmartScreen.</li>\n\n\n\n<li><strong>Information disclosure: </strong>Exposure of sensitive data or secrets.</li>\n\n\n\n<li><strong>Tampering or integrity: </strong>Unauthorized modification of data or system state.</li>\n\n\n\n<li><strong>Denial of service: </strong>Disruption of system or service availability.</li>\n\n\n\n<li>Cross-site scripting (XSS): Script execution within a victim’s browser context.</li>\n\n\n\n<li><strong>Arbitrary file access: </strong>Unauthorized access to or placement of files.</li>\n\n\n\n<li><strong>Spoofing or redirect: </strong>Spoofing, redirection, or other forms of UI deception.</li>\n</ul><p>We also classified vulnerabilities by the platforms they affect, including Windows, Linux/Unix, mobile, network appliances, IoT/OT, virtualization hosts, and developer packages. A CVE can span multiple platforms. Developer packages are treated as a separate category because they are often cross-platform and represent a significant share of the overall vulnerability population.</p><p>Most CVEs in the analysis affect application code, including servers, web applications, browsers, productivity software, libraries, and firmware tooling, while a smaller share affects OS and system code such as kernels, drivers, and firmware.</p><p>This analysis covers CVEs published through September 2026 using Microsoft’s catalog of tracked vulnerabilities. Each CVE is counted once in the impact analysis and across each relevant platform in the platform analysis.</p><figure><img src=\"/dailyinfo/media/38adb52e3f8d1f90.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Infographic of 382,789 published CVEs: 77% affect applications and 23% operating systems; leading impacts include server-side remote code execution, denial of service, and authentication bypass. Linux/Unix and Windows are the most affected platforms.\"><figcaption>Figure 1 – The full published-CVE population as of September 2026, broken down by impact class and affected platform, and an OS vs. application split. Breadth dominates – many impact classes spread across many platforms, with about 77% of CVEs in application code and 23% in OS/system code.</figcaption></figure><h2 id=\"sec-2\">Vulnerabilities exploited in the wild</h2><p>The subset of vulnerabilities exploited in the wild is much smaller than the overall CVE population, and looks very different from it. Fewer than 1 in 200 published CVEs are ever used in a real attack, and those that do get used are overwhelmingly concentrated in the takeover classes that maximize threat actor impact and exposure.</p><p>The difference becomes clear when we look at impact. Exploitation is heavily concentrated in vulnerabilities that give attackers greater control over a system. Server-side RCE rises from 20% of published CVEs to 37% of exploited CVEs, local privilege escalation from 11% to 18%, and client-side RCE from 4% to 13%. By comparison, XSS falls from 15% to 4% and denial of service from 16% to 7%. OS vulnerabilities show a similar shift, increasing from 23% of the overall CVE population to 41% of exploited vulnerabilities.</p><p>These patterns are consistent with threat actors favoring vulnerabilities that can provide meaningful access and control. Remote code execution and privilege escalation can create footholds that support subsequent stages of an attack, while vulnerabilities that primarily cause a crash or limited script execution may offer less utility for broader compromise.</p><p>Importantly, a vulnerability’s stated classification does not always reflect what an attacker can reliably achieve in practice. For example, some vulnerabilities described as enabling RCE may ultimately result only in denial of service under real-world conditions. Understanding the demonstrated impact and exploitability of a vulnerability is therefore critical to effective prioritization.</p><figure><img src=\"/dailyinfo/media/78de3b1d6502cc54.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Infographic of 2,056 exploited-in-the-wild CVEs: server-side remote code execution is the leading impact, Windows the most affected platform, and vulnerabilities split 59% application to 41% operating system.\"><figcaption>Figure 2 – The 2,056 exploited-in-the-wild CVEs distribution, compared against the full published population: ghost lines mark each class and platform’s share of all ~380K published CVEs, and badges show the shift in percentage points. Takeover classes and OS code rise, while high-volume XSS and DoS fall.</figcaption></figure><h2 id=\"sec-3\">Where defenders should focus</h2><h3 id=\"sec-4\">Patching is slow, while exploitation is fast</h3><p>Patching is slow, and far slower on critical systems than others. Across platforms, servers are the critical assets and the slowest to patch. Microsoft Security Exposure Management data from 2026 shows that the median vulnerability is patched in about two weeks on Windows workstations but in more than a month on Windows Servers. It stretches to 10+ weeks on Linux Servers and for applications running on MacOS, and beyond a year on network appliances. That gap is the threat actor’s window, widest on the critical systems that stay exposed the longest.</p><p>Exploitation runs on the opposite clock: the most impactful vulnerabilities are weaponized in days, increasingly on or before disclosure. According to <a href=\"https://www.vulncheck.com/blog/state-of-exploitation-2026\">VulnCheck</a>, 29% of the exploits in 2025 were launched within 1 day of CVE publication. According to CISA, the mean time from CVE publication to CISA KEV catalog fell from 89 days in 2024 to 57 days in 2025. 2026 data up to September already have that number dropping to 20 days, with a median of only 3 days since publication. Industry research suggests that advances in AI are a significant factor in the time reduction required to develop exploits, further increasing pressure on defenders to respond quickly.</p><h3 id=\"sec-5\">Impact, exposure and where to focus</h3><p>Two things determine a vulnerability’s value to a threat actor: impact and exposure. Impact is what successful exploitation provides, such as remote code execution or privilege escalation. Exposure is an asset’s position in the environment and the opportunities it creates for further compromise. An asset’s exposure is shaped by the identities, privileges, and connections available from it. </p><p>Servers often use service accounts, application identities, or cloud-managed identities with permissions beyond their operational needs. Compromising such a system can provide access to additional resources, sensitive data, administrative privileges, or trusted network paths. Together, impact and exposure determine the blast radius: a vulnerability that enables full control of a highly exposed system can enable widespread on-premises or cloud compromise.</p><p>Threat actors do not exploit at random: they go after the vulnerabilities that give the highest impact and exposure: full control of a system and the privileged identities and critical assets it has access to. As defenders, focusing on these vulnerabilities first can deliver the highest return on remediation investment.</p><p>Takeover vulnerabilities like remote code execution, authentication bypass and local privilege escalation lead here. They drive the broadest exposure and the largest blast radius, account for 78% of real-world exploited vulnerabilities, and stopping their exploitation interrupts attacks at the earliest stage, before compromise can propagate across the environment.</p><h3 id=\"sec-6\">Next in line</h3><p>A second slice deserves attention where context makes it severe: denial of service against availability-critical assets is recoverable in general, but can be mission-ending in parts of your environment where uptime is everything; disclosure of credentials or secrets can be minor as an insulated incident, but it feeds the same privileged-identity path mentioned above.</p><figure><img src=\"/dailyinfo/media/4922e373c0e3b311.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Stacked bar chart of 1,239 exploited remote-takeover CVEs by platform and code layer. Server-side RCE is the largest class, led by Windows and Linux/Unix; bars distinguish application from OS/system vulnerabilities.\"><figcaption>Figure 3 – The three remote-takeover classes analyzed across 1,239 exploited CVEs), each drilled down by affected platform and split into OS vs Application code. Bar length is the CVE count per platform; the dark segment is OS/system, the light segment is application.</figcaption></figure><h2 id=\"sec-7\">How Microsoft Security helps defenders act</h2><p>Threat actors do not begin with a vulnerability list. They begin by looking for a reachable way in. <a href=\"https://learn.microsoft.com/azure/external-attack-surface-management/overview\">Microsoft Defender External Attack Surface Management</a> approaches the environment from that same outside-in perspective, continuously discovering internet-facing infrastructure, including previously unknown or unmonitored assets, shadow IT, and third-party dependencies. This gives defenders an opportunity to remove unnecessary exposure before a reachable vulnerability becomes an entry point.</p><p>Once the reachable assets are known, the next question is which weaknesses deserve immediate attention. Defenders need a way to prioritize exposure beyond CVSS alone. Microsoft Defender Vulnerability Management addresses this challenge through <a href=\"https://learn.microsoft.com/defender-vulnerability-management/tvm-exposure-score\">Exposure Score</a> and <a href=\"https://learn.microsoft.com/defender-vulnerability-management/tvm-security-recommendation\">prioritized security recommendations</a>.</p><p>Prioritization incorporates threat and exploitability signals, breach likelihood, internet exposure, and asset criticality, helping teams focus remediation on vulnerabilities that create the greatest actual exposure.</p><p>An initial foothold is only part of the risk. <a href=\"https://learn.microsoft.com/security-exposure-management/work-attack-paths-overview\">Attack Path Analysis</a> connects assets and threat actor techniques into end-to-end routes from an entry point to a critical asset. Microsoft Security Exposure Management Attack Path Analysis provides a cross-workload view spanning endpoints, cloud, and hybrid environments, using vulnerability context from MDVM, endpoint data from Defender for Endpoint, and cloud asset data from Defender for Cloud. Within cloud environments, <a href=\"https://learn.microsoft.com/azure/defender-for-cloud/concept-attack-path\">Defender CSPM Attack Path Analysis</a> adds detailed context about internet exposure, vulnerabilities, network connections, identities, and permissions across Azure, AWS, and Google Cloud.</p><p>Together, these experiences show how an exposed workload could become a path through a privileged identity to sensitive data or another critical resource, helping defenders identify where to break the path before the initial compromise expands.</p><p>Patching remains essential, but it is not the only defensive action available. Microsoft Security helps defenders discover the doors threat actors can see, prioritize the weaknesses they are most likely to exploit, understand where a compromise could lead, and identify opportunities to break attack paths before compromise spreads to critical assets.</p><h2 id=\"sec-8\">References</h2><p>Sources cited or linked in the submitted draft:</p><ul>\n<li><a href=\"https://www.vulncheck.com/blog/state-of-exploitation-2026\">VulnCheck, State of Exploitation 2026</a></li>\n\n\n\n<li><a href=\"https://learn.microsoft.com/azure/external-attack-surface-management/overview\">Microsoft Defender External Attack Surface Management overview</a></li>\n\n\n\n<li><a href=\"https://learn.microsoft.com/defender-vulnerability-management/tvm-exposure-score\">Microsoft Defender Vulnerability Management Exposure Score</a></li>\n\n\n\n<li><a href=\"https://learn.microsoft.com/defender-vulnerability-management/tvm-security-recommendation\">Microsoft Defender Vulnerability Management security recommendations</a></li>\n\n\n\n<li><a href=\"https://learn.microsoft.com/security-exposure-management/work-attack-paths-overview\">Microsoft Security Exposure Management Attack Path Analysis</a></li>\n\n\n\n<li><a href=\"https://learn.microsoft.com/azure/defender-for-cloud/concept-attack-path\">Microsoft Defender CSPM Attack Path Analysis</a></li>\n</ul><h2 id=\"sec-9\">Learn More</h2><p>For the latest security research from the Microsoft Threat Intelligence community, check out the <a href=\"https://aka.ms/threatintelblog\">Microsoft Threat Intelligence Blog</a>.</p><p>To get notified about new publications and to join discussions on social media, follow us on <a href=\"https://www.linkedin.com/showcase/microsoft-threat-intelligence\">LinkedIn</a>, <a href=\"https://x.com/MsftSecIntel\">X (formerly Twitter)</a>, and <a href=\"https://bsky.app/profile/threatintel.microsoft.com\">Bluesky</a>.</p><p>To hear stories and insights from the Microsoft Threat Intelligence community about the ever-evolving threat landscape, listen to the <a href=\"https://thecyberwire.com/podcasts/microsoft-threat-intelligence\">Microsoft Threat Intelligence podcast</a>.</p><p>Review our documentation to learn more about our real-time protection capabilities and see how to enable them within your organization.  </p><ul>\n<li>Learn more about <a href=\"https://learn.microsoft.com/en-us/defender-cloud-apps/ai-agent-protection\">securing Copilot Studio agents with Microsoft Defender</a> </li>\n\n\n\n<li>Evaluate your AI readiness with our latest <a href=\"https://microsoft.github.io/zerotrustassessment/\">Zero Trust for AI workshop</a>.</li>\n\n\n\n<li><a href=\"https://learn.microsoft.com/en-us/copilot/microsoft-365/microsoft-365-copilot-ai-security\">Microsoft 365 Copilot AI security documentation</a></li>\n\n\n\n<li><a href=\"https://www.microsoft.com/en-us/security/blog/2024/04/11/how-microsoft-discovers-and-mitigates-evolving-attacks-against-ai-guardrails/\">How Microsoft discovers and mitigates evolving attacks against AI guardrails</a></li>\n\n\n\n<li><a href=\"https://learn.microsoft.com/en-us/defender-office-365/step-by-step-guides/prompt-injection-protection-defender-for-office-365\">Prompt injection protection in Microsoft Defender for Office 365 </a>– official documentation of the prompt injection protection in Microsoft Defender for Office 365.</li>\n\n\n\n<li><a href=\"https://www.microsoft.com/en-us/security/blog/2024/04/11/how-microsoft-discovers-and-mitigates-evolving-attacks-against-ai-guardrails/\">How Microsoft discovers and mitigates evolving attacks against AI guardrails | Microsoft Security Blog</a></li>\n\n\n\n<li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/02/10/ai-recommendation-poisoning/\">Manipulating AI memory for profit: The rise of AI Recommendation Poisoning | Microsoft Security Blog</a> – a related example of an AI-era technique observed in email traffic</li>\n\n\n\n<li><a href=\"https://techcommunity.microsoft.com/blog/microsoftdefenderforoffice365blog/defending-the-inbox-against-prompt-injection-attacks/4534636\">Defending the inbox against prompt injection attacks | Microsoft Defender for Office 365 Blog </a>– feature announcement introducing prompt injection protection in Microsoft Defender for Office 365.</li>\n\n\n\n<li>Learn how Microsoft is reimagining the SOC for the agentic era with <a href=\"https://www.microsoft.com/security/blog/2026/09/23/reimagining-the-soc-for-the-agentic-era-in-microsoft-defender/\">ISOC in Microsoft Defender</a></li>\n</ul><p>The post <a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/02/exploited-vulnerabilities-common-data-driven-analysis-real-world-attacks/\">What exploited vulnerabilities have in common: A data-driven analysis of real-world attacks</a> appeared first on <a href=\"https://www.microsoft.com/en-us/security/blog\">Microsoft Security Blog</a>.</p>","zhKind","complete","漏洞分析","Microsoft","CISA","https://www.microsoft.com/en-us/security/blog/2026/11/02/exploited-vulnerabilities-common-data-driven-analysis-real-world-attacks/","Microsoft Security Blog",{"_127":128,"_129":-5},"changelogVersion","2026-10-01T08:00","release"]
