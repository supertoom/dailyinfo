[{"_1":2,"_3":4},"root",{"_5":91},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":-5,"_57":36,"_58":59},"expiresAt",1793621935000,"id","ec77vqb3fijsm3fybsj43lyl6","title","Security Affairs 第 602 期国际版周报汇总安全漏洞、攻击与事件","originalTitle","Security Affairs newsletter Round 602 by Pierluigi Paganini – INTERNATIONAL EDITION","summary","Security Affairs 第 602 期国际版周报汇总漏洞披露、真实攻击、数据泄露与安全研究。","reason","source",{"_66":90},"links",{"_59":89},"publishedAt","2026-11-01T13:22:58.000Z","discoveredAt","2026-11-01T14:27:34.340Z","timelineAt","category","blue-team","tags",[86,87,73,71,69,88],"score",12,"selected",false,"channel","news","story","x","readingMode","full","author","Pierluigi Paganini","body",{"_82":-5,"_59":83,"_84":-5,"_85":36},"outline",[76],"relatedStories",[],"topics",[60,61,62,63,64],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_65":74,"_66":75},{"_65":72,"_66":73},{"_65":70,"_66":71},{"_65":68,"_66":69},{"_65":30,"_66":67},"slug","name","蓝队与运营","ai-security","AI 安全","attack","攻击活动","exploited","在野利用","vuln","漏洞披露",{"_11":77,"_78":79,"_80":81},"sec-1","text","A new round of the weekly Security Affairs newsletter has arrived! Every week, t","level",2,"zh","<h2 id=\"sec-1\">A new round of the weekly Security Affairs newsletter has arrived! Every week, the best security articles from Security Affairs are free in your email box.</h2><p>Enjoy a new round of the weekly SecurityAffairs newsletter, including international press.</p><figure><table><tbody><tr><td><a href=\"https://securityaffairs.com/202175/security/u-s-cisa-adds-ivanti-connect-secure-flaws-to-its-known-exploited-vulnerabilities-catalog.html\">U.S. CISA adds Ivanti Connect Secure&nbsp;flaws to its Known Exploited Vulnerabilities catalog</a></td></tr><tr><td><a href=\"https://securityaffairs.com/202162/security/attackers-exploit-critical-drupal-commerce-core-vulnerability-cve-2026-118539.html\">Attackers Exploit Critical Drupal Commerce Core Vulnerability CVE-2026-118539</a></td></tr><tr><td><a href=\"https://securityaffairs.com/202149/malware/yoba-malware-hides-a-crypto-miner-behind-legitimate-openai-and-anthropic-binaries.html\">Yoba Malware Hides a Crypto Miner Behind Legitimate OpenAI and Anthropic Binaries</a></td></tr><tr><td><a href=\"https://securityaffairs.com/202133/security/u-s-cisa-adds-gitlab-and-cisco-flaws-to-its-known-exploited-vulnerabilities-catalog.html\">U.S. CISA adds GitLab&nbsp;and Cisco&nbsp;flaws to its Known Exploited Vulnerabilities catalog</a></td></tr><tr><td><a href=\"https://securityaffairs.com/202119/cyber-crime/6-3-billion-stolen-from-binance-in-attack-attributed-to-north-korea.html\">$6.3 Billion Stolen from Binance in Attack Attributed to North Korea</a></td></tr><tr><td><a href=\"https://securityaffairs.com/202110/hacking/how-to-prioritize-remediation-after-a-pentest-a-practitioner-workflow.html\">How to prioritize remediation after a pentest: a practitioner workflow</a></td></tr><tr><td><a href=\"https://securityaffairs.com/202103/data-breach/hacker-leaks-data-on-more-than-40000-homeland-security-employees.html\">Hacker leaks data on more than 40,000 Homeland Security employees</a></td></tr><tr><td><a href=\"https://securityaffairs.com/202089/hacking/binance-investigates-suspicious-crypto-transfers-worth-up-to-5-8-billion.html\">Binance Investigates Suspicious Crypto Transfers Worth Up to $5.8 Billion</a></td></tr><tr><td><a href=\"https://securityaffairs.com/202073/hacking/us-probes-suspected-hack-behind-military-base-freezer-failures.html\">US Probes Suspected Hack Behind Military Base Freezer Failures</a></td></tr><tr><td><a href=\"https://securityaffairs.com/202055/security/484142-exposed-cloud-buckets-contain-18-billion-files.html\">484,142 Exposed Cloud Buckets Contain 18 Billion Files</a></td></tr><tr><td><a href=\"https://securityaffairs.com/202050/hacking/u-s-cisa-adds-linux-kernel-and-broadcom-vmware-esx-flaws-to-its-known-exploited-vulnerabilities-catalog.html\">U.S. CISA adds Linux Kernel&nbsp;and Broadcom VMWare ESX&nbsp; flaws to its Known Exploited Vulnerabilities catalog</a></td></tr><tr><td><a href=\"https://securityaffairs.com/202023/intelligence/volt-typhoon-used-silent-train-to-hide-zero-day-attacks.html\">Volt Typhoon Used Silent Train to Hide Zero-Day Attacks</a></td></tr><tr><td><a href=\"https://securityaffairs.com/201967/security/election-website-security-42-of-us-county-sites-still-lack-gov-domains.html\">Election Website Security: 42% of US County Sites Still Lack .gov Domains</a></td></tr><tr><td><a href=\"https://securityaffairs.com/201985/data-breach/engie-data-breach-exposes-customer-details-and-energy-contracts.html\">ENGIE Data Breach Exposes Customer Details and Energy Contracts</a></td></tr><tr><td><a href=\"https://securityaffairs.com/202002/cyber-crime/virtualine-domain-seized-but-allegedly-abusive-website-remains-online.html\">Virtualine Domain Seized, but Allegedly Abusive Website Remains Online</a></td></tr><tr><td><a href=\"https://securityaffairs.com/201960/cyber-crime/hive-and-nefilim-ransomware-affiliate-gets-70-months-in-jail.html\">Hive and Nefilim Ransomware Affiliate Gets 70 Months In Jail</a></td></tr><tr><td><a href=\"https://securityaffairs.com/201947/intelligence/ads-or-surveillance-researchers-flag-suspicious-targeting-of-starlink-users.html\">Ads or Surveillance? Researchers Flag Suspicious Targeting of Starlink Users</a></td></tr><tr><td><a href=\"https://securityaffairs.com/201928/security/cve-2026-97631-16-year-old-uefi-flaw-threatens-servers.html\">CVE-2026-97631: 16-Year-Old UEFI Flaw Threatens Servers</a></td></tr><tr><td><a href=\"https://securityaffairs.com/201922/security/u-s-cisa-adds-google-brotli-and-adobe-commerce-and-magento-flaws-to-its-known-exploited-vulnerabilities-catalog.html\">U.S. CISA adds Google Brotli&nbsp;and Adobe Commerce and Magento flaws to its Known Exploited Vulnerabilities catalog</a></td></tr><tr><td><a href=\"https://securityaffairs.com/201913/ai/three-japan-focused-cyberattacks-show-how-hackers-use-ai.html\">Three Japan-Focused Cyberattacks Show How Hackers Use AI</a></td></tr><tr><td><a href=\"https://securityaffairs.com/201867/hacking/italys-parliament-under-cyber-pressure-why-the-attack-on-the-chamber-matters.html\">Italy ’s Parliament Under Cyber Pressure: Why the Attack on the Chamber Matters</a></td></tr><tr><td><a href=\"https://securityaffairs.com/201859/ai/australias-cyber-spy-chief-expect-more-disruption-as-ai-accelerates-hacking.html\">Australia’s Cyber Spy Chief: Expect More Disruption as AI Accelerates Hacking</a></td></tr><tr><td><a href=\"https://securityaffairs.com/201840/security/u-s-cisa-adds-php-flaws-php2shell-to-its-known-exploited-vulnerabilities-catalog.html\">U.S. CISA adds PHP flaws PHP2Shell to its Known Exploited Vulnerabilities catalog</a></td></tr><tr><td><a href=\"https://securityaffairs.com/201827/hacking/attackers-take-control-of-dahua-cameras-and-video-recorders-via-easy4ip.html\">Attackers Take Control of Dahua Cameras and Video Recorders Via Easy4IP</a></td></tr><tr><td><a href=\"https://securityaffairs.com/201810/ai/cohere-finds-qwen-ai-model-contacting-a-server-in-china.html\">Cohere Finds Qwen AI Model Contacting a Server in China</a></td></tr><tr><td><a href=\"https://securityaffairs.com/201795/malware/magento-campaign-infects-953-online-stores-across-five-domains.html\">Magento Campaign Infects 953 Online Stores Across Five Domains</a></td></tr><tr><td><a href=\"https://securityaffairs.com/201786/cyber-crime/ai-generated-fake-bank-calls-and-nfc-app-enabled-e380000-fraud-dutch-police-say.html\">AI-Generated Fake Bank Calls and NFC App Enabled €380,000 Fraud, Dutch Police Say</a></td></tr><tr><td><a href=\"https://securityaffairs.com/201764/malware/researchers-uncover-rentable-android-spyware-ucreater-targeting-wechat-and-telegram.html\">Researchers Uncover Rentable Android Spyware uCreater Targeting WeChat and Telegram</a></td></tr><tr><td><a href=\"https://securityaffairs.com/201748/hacking/php2shell-suspected-north-korean-campaign-targets-216-vulnerable-php-hosts.html\">PHP2Shell: Suspected North Korean campaign targets 216 vulnerable PHP hosts</a></td></tr><tr><td><a href=\"https://securityaffairs.com/201729/ai/anthropic-reveals-how-claude-mythos-5-crossed-security-testing-boundaries.html\">Anthropic reveals how Claude Mythos 5 crossed security testing boundaries</a></td></tr><tr><td><a href=\"https://securityaffairs.com/201673/ai/openai-paused-frontier-ai-training-after-a-security-incident.html\">OpenAI Paused Frontier AI Training After a Security Incident</a></td></tr></tbody></table></figure><p><strong>International Press – Newsletter</strong></p><p><strong>Cybercrime</strong></p><p><a href=\"https://finance.yahoo.com/markets/crypto/articles/binance-says-user-funds-completely-214417766.html\">Binance Says User Funds Are ‘Completely Safe’ After $3.5 Billion Drains From Its Hot Wallets</a>&nbsp;&nbsp;</p><p><a href=\"https://nltimes.nl/2026/10/21/police-arrest-two-suspects-ai-powered-bank-fraud-cost-victims-eu380000\">Police arrest two suspects in AI-powered bank fraud that cost victims €380,000</a>&nbsp;&nbsp;&nbsp;</p><p><a href=\"https://www.huntress.com/blog/token-replay-spray\">M365 Token Spray and Replay Campaign Compromises Business Email Accounts</a>&nbsp;</p><p><a href=\"https://www.justice.gov/opa/pr/chinese-national-extradited-alleged-role-multimillion-dollar-cryptocurrency-scam-targeting\">Chinese National Extradited for Alleged Role in Multimillion-Dollar Cryptocurrency Scam Targeting U.S. Citizens</a>&nbsp;&nbsp;</p><p><a href=\"https://www.justice.gov/usao-edny/pr/ukrainian-national-sentenced-70-months-prison-multi-million-dollar-ransomware\">Ukrainian National Sentenced to 70 Months in Prison for Multi-Million Dollar Ransomware Conspiracies</a>&nbsp;&nbsp;</p><p><a href=\"https://techcrunch.com/2026/10/28/hacker-stole-personnel-data-about-thousands-of-homeland-security-employees-including-cbp-and-ice-agents/\">Hacker stole personnel data about thousands of Homeland Security employees, including CBP and ICE agents</a>&nbsp;</p><p><a href=\"https://sansec.io/research/magento-cms-block-loader-deepveindrilling\">deepveindrilling.com: Magento CMS block loader hits 953 stores</a></p><p><a href=\"https://www.justice.gov/usao-edva/pr/bulletproof-website-domain-seized-international-law-enforcement-operation\">“Bulletproof” website domain seized in international law enforcement operation</a>&nbsp;&nbsp;</p><p><a href=\"https://www.bleepingcomputer.com/news/security/trezor-warns-of-suspected-crypto-theft-implant-in-hardware-wallet/\">Trezor warns of suspected crypto-theft implant in hardware wallet</a></p><p><a href=\"https://www.bleepingcomputer.com/news/security/polymarket-halts-trading-after-crypto-draining-script-breach-25m-traced/\">Polymarket halts trading after crypto-draining script breach, $2.5M traced</a></p><p><strong>Malware</strong><strong></strong></p><p><a href=\"https://www.0x0v1.com/ucreator-virtualization-based-android-spyware-platform-targeting-wechat-telegram-and-other-messaging-apps/\">uCreator: virtualization-based Android spyware platform targeting WeChat, Telegram and other messaging apps</a>&nbsp;&nbsp;</p><p><a href=\"https://x.com/starmexxx/status/2114351627247243564\">CLAUDE CODE FOUND SPYWARE ON MY FAMILY’S PHONES AND A BACKDOOR ON MY MAC</a></p><p><a href=\"https://cursor.com/blog/claude-code-extension-security-notice\">Security notice — malicious version of Anthropic.claude-code (2.1.313) identified in the Cursor Extension Marketplace</a>&nbsp;&nbsp;</p><p><a href=\"https://research.checkpoint.com/2026/tricks-from-the-past-deployed-via-signed-chatgpt-and-claude-binaries/\">Tricks from the Past deployed via signed ChatGPT and Claude binaries</a></p><p><strong>Hacking</strong></p><p><a href=\"https://github.com/0x4D31/honeypot-data/blob/main/reports/php2shell/2026-10-24-confirmed-rce.md\">PHP2Shell exploitation observed: packet-to-process RCE evidence</a>&nbsp;&nbsp;</p><p><a href=\"https://www.cyfirma.com/research/cyfirma-threat-advisory-suspected-dprk-campaign-staging-php2shell-targeting-against-global-php-infrastructure/\">CYFIRMA Threat Advisory: Suspected DPRK Campaign staging PHP2Shell Targeting against Global PHP infrastructure</a>&nbsp;&nbsp;</p><p><a href=\"https://arcticwolf.com/resources/blog/threat-actors-abuse-microsoft-teams-external-chat-for-initial-access/\">Beyond the Inbox: How Threat Actors Abuse Microsoft Teams External Chat for Initial Access</a>&nbsp;&nbsp;</p><p><a href=\"https://www.trendaisecurity.com/en-us/resources-insights/deep-research/not-only-artex-the-different-levels-ai-is-used-in-attacks-targeting-japan\">Not Only ARTEX: The Different Levels AI is Used in Attacks Targeting Japan</a>&nbsp;&nbsp;</p><p><a href=\"https://www.wiz.io/blog/cve-2026-111497-brotli-rce-node-js\">Broccoli2shell: Everything You Need To Know About The Critical Brotli Decoder Vulnerability</a>&nbsp;&nbsp;</p><p><a href=\"https://www.anthropic.com/research/discovering-vulnerabilities-with-claude\">Discovering and exploiting vulnerabilities in critical, real-world software with Claude</a></p><p><a href=\"https://hnsecurity.it/blog/putting-claude-code-in-a-box-a-sandboxed-dev-container-for-zed/\">Putting Claude Code in a box: a sandboxed dev container for Zed</a></p><p><a href=\"https://thehackernews.com/2026/10/hackers-target-critical-oracle-e.html\">Hackers Target Critical Oracle E-Business Suite RCE Flaw Days After Security Patch</a></p><p><a href=\"https://blog.orange.tw/posts/2026-10-the-last-proof-of-human-craft-browser-full-chain/\">The Last Proof of Human Craft: Forging a Microsoft Edge Full Chain with Logic Bugs Only!</a>&nbsp;&nbsp;</p><p><a href=\"https://www.reuters.com/technology/pentagon-treating-military-base-freezer-malfunctions-suspected-cyberattack-2026-10-29/\">Pentagon treating military base freezer malfunctions as suspected cyberattack, officials say</a>&nbsp;&nbsp;</p><p><a href=\"https://alpinelinux.org/posts/GitLab-security-incident-CVE-2026-97229.html\">GitLab security incident: attempted exploitation of CVE-2026-97229</a>&nbsp;&nbsp;</p><p><strong>Intelligence and Information Warfare</strong> &nbsp;</p><p><a href=\"https://www.theregister.com/ai-and-ml/2026/10/26/alibabas-qwen-ai-caught-trying-to-contact-server-in-china/5305561\">Alibaba’s Qwen AI caught trying to contact server in China</a></p><p><a href=\"https://cip.gov.ua/ua/news/khakeri-mozhut-otrimati-kontrol-nad-kamerami-ta-videoreyestratorami-cherez-khmarnii-dostup\">Hackers can gain control of cameras and DVRs through cloud access</a>&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;</p><p><a href=\"https://www.abc.net.au/news/2026-10-27/australian-signals-directorate-ai-cybersecurity-hacking-threats/107309858\">Disruptions ‘inevitable’ as AI-powered cyber threats grow, Australian Signals Directorate says</a></p><p><a href=\"https://securelist.com/lazarus-operation-flashhole/121541/\">Operation FlashHole: Lazarus breaks security, defies control</a>&nbsp;</p><p><a href=\"https://www.bloomberg.com/news/features/2026-10-27/russia-linked-hackers-are-turning-cyberattacks-into-a-physical-threat\">Hackers Sympathetic to Russia Are Hitting Utilities and Factories</a>&nbsp;&nbsp;</p><p><a href=\"https://www.reuters.com/business/media-telecom/alleged-israeli-spy-company-heavily-targeted-starlink-users-sources-say-2026-10-27/\">Alleged Israeli spy company heavily targeted Starlink users, sources say</a></p><p><a href=\"https://www.lumen.com/blog/en-us/silent-train-volt-typhoon-operational-framework\">Silent Train: uncovering Volt Typhoon’s operational framework for zero-day exploitation and strategic access</a>&nbsp;&nbsp;</p><p><a href=\"https://www.trmlabs.com/resources/blog/north-korea-steals-usd-6-36-billion-from-binance-in-the-largest-hack-in-history\">North Korea Steals USD 6.36 Billion From Binance in the Largest Hack in History</a>&nbsp;&nbsp;</p><p><a href=\"https://www.techpolicy.press/mapping-the-political-influencer-industry-and-the-problems-it-causes-for-democracy/\">Mapping the Political Influencer Industry and the Problems it Causes for Democracy</a>&nbsp;&nbsp;</p><p><strong>Cybersecurity</strong><strong></strong></p><p><a href=\"https://www.linkedin.com/pulse/nis-2-italy-key-deadlines-board-duties-what-acn-expects-coraggio-ndotf/\">NIS 2 Italy: Key Deadlines, Board Duties and What ACN Expects From Companies</a>&nbsp;&nbsp;</p><p><a href=\"https://www.linkedin.com/pulse/two-things-cisos-should-thinking-wake-php-nightmare-geoff-white-s833e/\">The Two Things CISOs Should Be Thinking About In The Wake Of The PHP Nightmare</a></p><p><a href=\"https://arstechnica.com/security/2026/10/code-execution-flaw-in-uefi-firmware-threatens-most-servers-on-planet-earth/\">Code-execution flaw in UEFI firmware affects most servers on planet Earth</a>&nbsp;&nbsp; &nbsp;&nbsp;</p><p><a href=\"https://www.mysteriumvpn.com/blog/data-and-research/voting-websites-gov\">2026 County Election Website Security Census: Key Findings</a>&nbsp;&nbsp;</p><p><a href=\"https://ransomnews.com/cloud-exposure-index-2026/\">Cloud Exposure Index 2026: 484,142 open buckets mapped</a>&nbsp;&nbsp;</p><p><a href=\"https://fuitesinfos.fr/article/2026-10-23-engie\">ENGIE: Data leak via a tool belonging to its business partners</a>&nbsp;</p><p><a href=\"https://www.nextron-systems.com/2026/10/29/beyond-framework-signatures-understanding-ai-driven-intrusions/\">Beyond Framework Signatures: Understanding AI-Driven Intrusions</a>&nbsp;</p><p><a href=\"https://signalandsilence.substack.com/p/i-think-someone-hacked-the-commissary\">I Think The Military Commissary’s Freezers Were Hacked</a>&nbsp;&nbsp;</p><p><a href=\"https://www.404media.co/manifestos-fear-and-loser-thinking-inside-protons-ai-reckoning/\">Manifestos, Fear, and ‘Loser Thinking’: Inside Proton’s AI Reckoning</a>&nbsp; </p><p><a href=\"https://www.securityweek.com/passkeys-are-better-than-passwords-but-they-are-not-enough/\">Passkeys Are Better Than Passwords. But They Are Not Enough</a></p><p><strong>Follow me on Twitter:&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a><strong></strong></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;hacking,&nbsp;<a href=\"https://securityaffairs.com/tag/newsletter\">newsletter</a>)</strong></p>","zhKind","complete","汇总","漏洞","蓝队","https://securityaffairs.com/202200/breaking-news/security-affairs-newsletter-round-602-by-pierluigi-paganini-international-edition.html","Security Affairs",{"_92":93,"_94":-5},"changelogVersion","2026-10-01T08:00","release"]
