[{"_1":2,"_3":4},"root",{"_5":107},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794357646000,"id","y3oqogzfuz08thepvfa99u3bx","title","BTCPay Server 旧版本实例遭遇热钱包盗取，2.4.1及更早版本需升级至2.4.7","originalTitle","BTCPay Server warns of hot wallet crypto thefts on outdated instances","summary","BTCPay Server 维护者称，黑客已针对运行 2.4.1（2026年7月23日）或更早版本的实例盗取热钱包资金，攻击未针对公开服务器。项目建议受影响实例尽快下线并升级至 2.4.7；原文称尚无使用 2.4.7 的热钱包盗取可信报告，但近期攻击具体利用的漏洞尚未查明，受影响用户需向 security@btcpayserver.org 提交活动日志。","reason","材料区分了受影响版本、当前利用链尚未查明的部分，以及面向 Docker 和普通安装的更新路径。","source",{"_76":106},"links",{"_99":105},"publishedAt","2026-11-02T15:03:07.000Z","discoveredAt","2026-11-02T16:01:33.457Z","timelineAt","category","activity","tags",[77,79,103,104,81],"score",75,"selected",true,"channel","news","story",{"_89":90,"_13":91},"x","readingMode","full","author","Bill Toulas","body",{"_61":98,"_99":-5,"_100":101,"_102":37},"outline",[92],"relatedStories",[88],"topics",[68,69,70,71,72,73],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fI-OBzSoxYxw","reportCount",1,"additionalSourceCount",0,{"_74":86,"_76":87},{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","attack","name","攻击活动","exploited","在野利用","incident","应急响应","black-market","数据窃取与黑产","ransomware","勒索软件","crypto","密码学",{"_89":90,"_13":91},"publicId","eec08cb6-c5ff-46a1-baae-61575dcf1bdc","BTCPay旧版实例热钱包被盗",{"_11":93,"_94":95,"_96":97},"sec-1","text","发现现有防御可能遗漏的电子邮件威胁。","level",2,"<p><img alt=\"BTCPay Server warns of hot wallet thefts targeting outdated instances\" height=\"900\" src=\"/dailyinfo/media/31cdc00f4f015e43.jpg\" srcset=\"/dailyinfo/media/5b3603bd3e054494.jpg 720w, /dailyinfo/media/e025d9b39565bbda.jpg 1200w, /dailyinfo/media/31cdc00f4f015e43.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>开源加密货币支付处理商 BTCPay Server 的维护者敦促用户安装最新版本，因为黑客一直在盗取运行旧版本实例的“热钱包”资产。</p><p>最初，运维人员被建议<a href=\"https://x.com/BtcpayServer/status/2117020340815819262\">关闭其服务器</a>，以等待对未经授权支付行为的全面调查。</p><p>BTCPay Server 项目为企业提供自托管支付处理解决方案，使企业能够直接接受 Bitcoin 和其他数字资产并存入自己的钱包，从而无需支付中介机构或平台处理费用。</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/4e9a8167b7d47a2d.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>它负责处理结账发票和支付验证，包括通过 Lightning Network 进行的支付。</p><p>周一早些时候，维护者表示已“确定一种针对运行 2.4.1 版本（July 23, 2026）或更早版本实例的攻击途径”，并强烈敦促用户更新至 2.4.7 版本。</p><p>BTCPay 创始人 <a href=\"https://x.com/NicolasDorier/status/2117051298633900041\">Nicolas Dorier 表示</a>，这些攻击并非针对公共服务器。调查重点是确定威胁行为者如何以管理员身份登录运行 2.4.2 之前旧版本实例。</p><p>10 月 29 日，该公司披露了一个通过 Anthropic 的 Frontier OSS 扫描器发现的高危漏洞，并因此发布了 2.4.7 版本，作为一项<a href=\"https://x.com/BtcpayServer/status/2115835402536079674\">紧急安全更新</a>。</p><p>然而，Dorier 表示有线索表明攻击者利用了 BTCPay Server 2.4.2 之前旧版本中的漏洞，项目随后证实了这一点。</p><p>“我们的事件响应调查确定了一种针对运行 2.4.1 版本（Jul 23, 2026）或更早版本实例的攻击途径，”<a href=\"https://x.com/BtcpayServer/status/2117106238123123008\">BTCPay Server 表示</a>。</p><p>“我们没有收到任何关于运行最新 2.4.7 版本的用户遭遇热钱包资产被盗的可信报告。我们再次敦促所有人保持 BTCPay Server 为最新版本。”</p><p>受影响用户被要求将所有详细信息和活动日志发送至 security@btcpayserver.org。</p><p>值得注意的是，8 月 7 日，BTCPay Server <a href=\"https://blog.btcpayserver.org/security-advisory-btcpay-server-2-4-2/\">发布 2.4.2 版本</a>时，曾警告称存在一个正被积极利用的漏洞，该漏洞会暴露 LND 凭据文件，使攻击者能够控制受影响的 Lightning 节点并窃取资金。</p><p>该项目尚未说明最近攻击中正在利用的漏洞是什么。</p><p>BleepingComputer 已联系 BTCPay Server，以获取有关当前攻击所利用漏洞的更多详细信息，但截至发稿时我们尚未收到回应。</p><p>受影响用户应通过 Server Settings → Maintenance → Update 更新至 2.4.7 版本。</p><p>对于 Docker 安装，管理员可以通过 SSH 登录，运行 sudo su -，使用 cd btcpayserver-docker 切换到部署目录，然后执行 ./btcpay-update.sh 来更新 BTCPay Server。</p><p>如果运行的是 2.4.1 或更早版本，建议尽快将该实例下线。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/ec08be135363bed0.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 代理会分析电子邮件意图、上下文和行为，以发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>对 Microsoft 365 或 Google Workspace 进行为期 14 天的只读扫描，查看有哪些威胁得以绕过防护，无需更改 MX 记录。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始您的免费电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","数据窃取","加密","https://www.bleepingcomputer.com/news/security/btcpay-server-warns-of-hot-wallet-thefts-targeting-outdated-instances/","BleepingComputer",{"_108":109,"_110":-5},"changelogVersion","2026-10-01T08:00","release"]
