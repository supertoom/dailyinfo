[{"_1":2,"_3":4},"root",{"_5":100},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":60,"_61":62},"expiresAt",1794616836000,"id","xotvn8h2ady8nq85xed82tncq","title","Apple 间谍软件告警送达德国联邦议院，BSI 要求受影响者按设备失陷处置","originalTitle","Apple’s spyware notifications reach the Bundestag: what the BSI says to do now","summary","Apple 自 2026 年 10 月 29 日起通知多名德国联邦议院议员、政界人士及其他公众人物，其 iPhone 遭到政府支持的雇佣间谍软件攻击；BSI 尚不确定通知代表成功感染还是攻击尝试，已向受影响者发出提醒并要求联系机构。","reason","材料汇总了德国政界收到间谍软件告警后的影响范围与不确定性，并给出 BSI 针对设备取证、账号安全和通信工具的具体处置建议。","source",{"_75":99},"links",{"_62":98},"publishedAt","2026-11-03T06:24:38.000Z","discoveredAt","2026-11-03T07:06:21.843Z","timelineAt","category","activity","tags",[78,76,80,97],"score",74,"selected",true,"channel","news","story",{"_84":85,"_13":86},"x","readingMode","full","author","Pierluigi Paganini","body",{"_93":-5,"_62":94,"_95":-5,"_96":60},"outline",[87],"relatedStories",[83],"topics",[69,70,71,72],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation",false,"bodyLanguage","original","factId","flBJPrt37Eqw","reportCount",1,"additionalSourceCount",0,{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","malware","name","恶意软件","attack","攻击活动","mobile","移动端","apple","Apple / 苹果",{"_84":85,"_13":86},"publicId","29488f0b-cf06-4116-94ad-cc754220c891","苹果警告德国议员iPhone遭间谍软件攻击",{"_11":88,"_89":90,"_91":92},"sec-1","text","Apple warns German Bundestag lawmakers of mercenary spyware attacks; BSI urges v","level",2,"zh","<h2 id=\"sec-1\">Apple warns German Bundestag lawmakers of mercenary spyware attacks; BSI urges victims to assume compromise.</h2><p>The German government is warning politicians and public figures that they were targeted by government-backed spyware. The warning follows Apple’s notifications, which began reaching iPhones on October 29, according to the federal cybersecurity office, the BSI. The BSI says members of the Bundestag and other notable people got an Apple alert about an attack with so-called mercenary spyware.</p><p><em>“The Federal Office for Information Security ( BSI ) has learned that several members of the German Bundestag and other public figures have received a <a href=\"https://support.apple.com/de-de/102174\">threat notification from</a> Apple on their devices since October 29, 2026. In the notification, Apple states that it has detected an attack using so-called mercenary spyware . This is commercially developed, advanced spyware that has frequently been used in the past by state actors against specific, targeted individuals.” reads the <a href=\"https://www.bsi.bund.de/DE/Themen/Unternehmen-und-Organisationen/Informationen-und-Empfehlungen/Empfehlungen-nach-Angriffszielen/Buero/Apple_Mercenary-Spyware/apple_mercenary-spyware_node.html\">notice</a> issued by BSI.</em></p><p><em>“The BSI (Federal Office for Information Security) is unaware whether these notifications indicate actual compromises or merely signal attempted attacks.</em>y<em>&nbsp;“</em></p><p><em>“Germany’s digital minister, Karsten Wildberger, has confirmed that members of the Bundestag and the federal government received warnings from Apple that their iPhones may have been targeted by spyware.” <a href=\"https://www.euronews.com/2026/11/02/german-mps-and-ministers-warned-iphones-have-been-targeted-by-spyware\">states the report</a>.</em></p><p>Digital minister Karsten Wildberger <a href=\"https://www.euronews.com/2026/11/02/german-mps-and-ministers-warned-iphones-have-been-targeted-by-spyware\">confirmed</a> it on ARD’s Bericht aus Berlin on Sunday, saying there had been “a notification from Apple that certain devices may have been compromised” and that members of both the Bundestag and the federal government were among those warned. Digital minister said the BSI had reacted super quickly and written to everyone affected. Wildberger didn’t say how many politicians got the alerts or who they are.</p><p><em>“According to Wildberger, the BSI advised those affected to assume – as a precaution – that their device may have been compromised, because the alerts do not show whether an attack succeeded.” <a href=\"https://www.euronews.com/2026/11/02/german-mps-and-ministers-warned-iphones-have-been-targeted-by-spyware/\">states Euronews.</a></em></p><p>The German government has not revealed who was targeted. Government spokesperson Stefan Kornelius <a href=\"https://www.ft.com/content/77626f75-01e9-4123-8510-a095b2231861?syn-25a6b1a6=1\">told</a> the Financial Times that officials are taking the incident and Apple’s warning very seriously. However, he did not say which government members received the alerts or whether Chancellor Friedrich Merz was among them. Apple has not commented on the reports, according to Euronews.</p><p>The Apple warning does not provide all the answers. Apple does not identify the governments behind these attacks, nor does it confirm whether a device was actually infected. Germany’s cybersecurity agency, the BSI, also says it is unclear whether the alerts indicate successful infections or only attempted attacks.</p><p>Apple says <a href=\"https://securityaffairs.com/tag/commercial-spyware\">mercenary spyware</a> is far more advanced than common cybercrime tools and that most users will never be targeted. This commercial surveillance software is often used on behalf of governments to spy on specific individuals. It can infect devices through so-called zero-click attacks, which do not require victims to open a message or click a link. In most cases, victims do not notice anything unusual.</p><p>Once a phone is compromised, the BSI says, attackers can read messages, including in encrypted apps, and access calls, contacts, calendars and location. They can also turn on the camera and microphone. That’s the whole phone, not a corner of it.</p><p>For recipients the BSI’s advice is concrete. Update the operating system immediately, unless you plan a forensic analysis, and consider turning on Lockdown Mode, which makes new attacks harder but doesn’t remove an existing infection. Lockdown Mode limits some features such as message attachments, link previews and FaceTime calls from unknown people, while calls and plain text messages keep working.</p><p>If the risk looks high, the BSI suggests replacing the device. That means resetting every account used on it and, to make repeat attacks harder, changing the phone number. Then set a new device passcode, change the passwords of your Apple account and email, and make sure two-factor authentication is on.</p><p>The BSI recommends turning on Signal’s registration lock and WhatsApp’s two-step verification, with a new PIN for each. It also advises removing any linked devices you don’t recognize.</p><p>Anyone who received a warning can email the BSI Service Center at service-center@bsi.bund.de. This helps the agency work out how many people may be affected. The agency says a genuine Apple warning never asks you to click links, open files, install apps or profiles, or share passwords and codes. These warnings appear on the lock screen, in settings, by email and at the top of account.apple.com after you sign in.</p><p>The warnings weren’t limited to Germany. Beirut-based filmmaker Radwan Mortada said on X that Apple had warned him about another attack against his device. He had already been targeted by spyware in 2021.</p><figure><blockquote><p>أمس، تلقيتُ إشعاراً أمنياً من شركة Apple تحذّرني فيه من تعرّض هاتفي الآيفون لهجوم تجسّسي موجّه، باستخدام برمجيات متطوّرة من النوع الذي تطوّره شركات مثل NSO Group، المعروفة ببرنامج «بيغاسوس».<br><br>ولعلّ أخطر ما ورد في التحذير تأكيد Apple أنّ هذا النوع من الهجمات يستهدف أشخاصاً محدّدين… <a href=\"https://t.co/2jFq6F3cvD\">pic.twitter.com/2jFq6F3cvD</a></p>— رُضوان (@radwanmortada) <a href=\"https://x.com/radwanmortada/status/2116163136252231795?ref_src=twsrc%5Etfw\">October 30, 2026</a></blockquote>\n</figure><p>According to his notice, Apple sent the latest warnings to users in 99 countries. Nobody has publicly identified the attackers or the government that may have ordered the attacks.</p><p>The BSI warned German lawmakers that Apple threat notifications may indicate compromised devices and urged recipients to contact the agency and take protective measures.</p><p><em>“Those affected who have received a corresponding warning message from Apple should therefore assume that their device may have been compromised.” BSI concludes. “In a letter dated October 30, 2026, the German Federal Office for Information Security (BSI) alerted members of the German Bundestag to the threat and informed them of necessary measures. Affected individuals were urged to contact the BSI directly .”</em></p><p><strong>Follow me on Twitter:&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a><strong></strong></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;hacking,&nbsp;Bundestag)</strong></p>","zhKind","complete","Apple","https://securityaffairs.com/202297/intelligence/apples-spyware-notifications-reach-the-bundestag-what-the-bsi-says-to-do-now.html","Security Affairs",{"_101":102,"_103":-5},"changelogVersion","2026-10-01T08:00","release"]
