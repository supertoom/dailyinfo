[{"_1":2,"_3":4},"root",{"_5":115},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1794616832000,"id","qr7yw6vafmf6e5mjlmebcs0x4","title","Amazon Threat Intelligence 发现攻击者利用 ARTEX AI Agent 窃取凭据并绕过 KYC","originalTitle","Amazon Threat Intelligence observes threat actors running cybercrime campaigns with ARTEX AI agents","summary","Amazon Threat Intelligence 从 MadPot 诱捕传感器于 2026 年 10 月 3 日至 11 月 5 日捕获的攻击请求中，发现攻击者使用开源 ARTEX Agent 框架开展凭据窃取和加密货币交易所 KYC 绕过。","reason","公开了 AI Agent 运行凭据窃取与 KYC 绕过活动时的任务记录、工作流和 IOC，可用于识别自动化攻击模式并核对自身环境。","source",{"_68":114},"links",{"_105":113},"publishedAt","2026-11-13T20:26:42.000Z","discoveredAt","2026-11-13T21:04:27.833Z","timelineAt","category","activity","tags",[71,69,109,73,110,111,112],"score",72,"selected",true,"channel","news","story","x","readingMode","full","author","CJ Moses","body",{"_59":104,"_105":-5,"_106":107,"_108":37},"outline",[80,81,82,83,84,85,86],"relatedStories",[],"topics",[60,61,62,63,64,65],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_66":78,"_68":79},{"_66":76,"_68":77},{"_66":74,"_68":75},{"_66":72,"_68":73},{"_66":70,"_68":71},{"_66":67,"_68":69},"slug","ai-security","name","AI 安全","attack","攻击活动","ai-offense","AI 攻防","black-market","数据窃取与黑产","ransomware","勒索软件","identity","身份与访问",{"_11":102,"_88":103,"_89":93},{"_11":100,"_88":101,"_89":93},{"_11":98,"_88":99,"_89":90},{"_11":96,"_88":97,"_89":90},{"_11":94,"_88":95,"_89":93},{"_11":91,"_88":92,"_89":93},{"_11":87,"_88":45,"_89":90},"sec-7","text","level",3,"sec-6","入侵指标（IOC）",2,"sec-5","这对防御方意味着什么","sec-4","活动 2：利用深度伪造突破身份验证","sec-3","行动 1：以工业级规模窃取 AI 凭据","sec-2","MadPot 如何洞察这些活动","sec-1","归因与指令","<p>2026 年 10 月 3 日至 11 月 5 日，Amazon 的 MadPot（一个全球分布的诱饵威胁传感器网络）捕获了 AI 智能体发出的请求，这些请求包含威胁行为者使用 ARTEX（一个开源智能体式 AI 渗透测试框架）开展进攻活动时留下的运行记忆。ARTEX 智能体将这些请求发送至 MadPot 传感器；这些传感器被配置为呈现为流行的大语言模型（LLM）推理 API，而请求中携带了智能体自身对其活动的记录。 </p><p>Amazon Threat Intelligence 评估了涉及可能受影响的 AWS 客户的威胁活动，并酌情通知了这些客户。由于无法确认针对其他组织的活动，本文将相关发现和失陷指标（IOCs）分享出来，以便运行受影响技术的组织检查自身环境。</p><p>最突出的 ARTEX 活动是一场大规模凭据窃取行动，目的是访问 AI 模型；该行动被组织为一项自我维持的运作，被窃取的密钥用于支付为后续凭据搜寻提供动力的 LLM 推理费用。另一场活动则使用实时深度伪造注入，针对加密货币交易所实施了解你的客户（KYC）验证绕过。总体来看，智能体记录显示，智能体框架已从实验性使用发展为持续执行、多目标的进攻活动，且仅需极少人工干预。本文将根据智能体对这些活动的自我描述，介绍这些活动是如何运作的。</p><h2 id=\"sec-1\">归因与指令</h2><p>Amazon Threat Intelligence 以中等置信度评估认为，这些活动使用了 ARTEX，原因是提示词中提及 ARTEX 工具，且其他技术制品也引用了 ARTEX。威胁行为者通过常设指令提示词指挥 ARTEX 智能体，为其设定任务目标、目标选择规则和行动约束。在这些指令中，智能体自行完成相关工作。在一次凭据窃取活动中，操作人员要求智能体按固定顺序处理各个国家，优先选择企业生产站点而非个人项目，并根据每组被窃凭据是否有效以及能够访问哪些资源对其进行评级。智能体被要求将公开暴露超过 30 天的凭据视为低价值库存。</p><p>Amazon Threat Intelligence 还以中等置信度评估认为，这些活动来自彼此不同的中国关联威胁组织，依据包括提示词中使用简体中文、中国时区配置、目标选择符合中国利益，以及所用工具主要由中国关联威胁使用。指令示例包括设定红线，例如排除中国大陆目标和政府域名，并要求所有出站流量均通过代理。</p><h2 id=\"sec-2\">MadPot 如何洞察这些活动</h2><p>MadPot 向潜在攻击者呈现受控服务，并记录他们如何发现、测试以及尝试攻破或滥用这些服务。MadPot 遥测使 Amazon Threat Intelligence 能够观察攻击者行为，而无需暴露客户工作负载。在此次案例中，MadPot 传感器在不同端口上呈现了流行的、兼容 LLM 的聊天补全接口。智能体框架在其进攻工作流程中将提示词发送至这些接口，并将其视为 LLM 推理后端。</p><p>最终收集到的遥测数据包含持久任务上下文、系统提示、工具历史记录、知识图谱状态以及这些框架通常会发送给 LLM 以作出操作决策的报告发现。由于智能体框架会保留过往对话历史，单次请求往往包含某次行动的全部操作历史。该历史记录描述了 MadPot 不监控的系统上，在捕获请求之前及请求之间发生的活动。Amazon Threat Intelligence 并未实时观察到这些活动，也无法核实智能体所报告的结果，但这些记录显示了该行动人员试图达成的事项。</p><p>大部分活动使用 ARTEX 在规划、执行、验证和压缩智能体之间划分工作，这些智能体共享一个持久知识图谱。该知识图谱充当行动的共享内存：每个智能体都从中读取信息，并将自己的结果写回其中，因此每个智能体都能从其他智能体的工作处继续推进。智能体的记录描述了针对数百个目标开展的侦察、漏洞测试、凭据窃取、云权限扩展和加密货币欺诈尝试，这些目标涵盖 AI 应用平台及其他工作负载。这些记录显示，威胁行动人员正如何利用智能体 AI 框架组织持久存在且以牟取经济利益为目的的进攻行动。</p><h3 id=\"sec-3\">行动 1：以工业级规模窃取 AI 凭据</h3><p>在此次行动中，威胁行动人员使用 AI 智能体窃取 API 密钥及其他凭据，以获取对 AI 模型的访问权限，极可能是为了在由他人付费使用这些模型。智能体的记录显示，被盗密钥被输入该框架自身的模型网关，为搜索更多密钥的智能体提供能力。除 AI 模型访问密钥外，云凭据也被视为进一步获取访问权限的通道。智能体通过每个提供商的令牌与身份服务验证身份，枚举存储资源，评估权限范围，并针对托管 AI 模型服务、机密与参数存储以及应用身份发起攻击。它们优先获取高级前沿模型的访问权限，而非一般云权限。</p><p>智能体的记录显示其使用了不同的 AI 网关、密钥和模型，但它们都采用了同一种方法：查找暴露在互联网上的 AI 应用，提取其持有的上游提供商密钥，验证这些密钥，并将其存储在托管密钥池中。这些智能体专注于聚合提供商密钥的应用，因为一个薄弱的管理接口就可能暴露许多下游账户。目标包括 LLM 网关和代理平台，如 One API、New API、Veloera、Sub2API 和 LiteLLM，以及 AI 应用构建平台，如 Dify、FastGPT、Langflow、RAGFlow、Open WebUI、LobeChat 和 Ollama。一套编码化的漏洞 playbook 将每个经过指纹识别的产品映射到其已知攻击链，包括可能被接管的未初始化安装、匿名管理与提供商配置端点、默认管理员凭据（如 LiteLLM 默认主密钥）、CVE-2025-3248（Langflow）、CVE-2026-28797（RAGFlow）、通过 One API 系列系统中的 isCliRequest 头进行身份验证绕过、通过 URL 获取功能访问云元数据服务以实施 SSRF，以及遗留在客户端 JavaScript、源映射、调试路由和环境文件中的机密。</p><p>为了找到这些密钥，发现过程利用了互联网扫描服务、证书透明度以及公开代码和制品来源：GitHub 仓库和事件存档（针对未能在自动撤销流程中撤销的机密信息）、npm 和 PyPI tarball、容器镜像层、notebook、模型托管空间、粘贴站点以及 Telegram 频道。一项并行行动按照固定的国家顺序推进，优先处理企业生产站点，并对每个凭据进行分级：L1 表示线索，L2 表示已确认可用的 API 调用，L3 表示可量化的影响，例如可读取的数据或可消费的余额。公开暴露超过 30 天的密钥被视为低价值库存。</p><h3 id=\"sec-4\">活动 2：利用深度伪造突破身份验证</h3><p>在此次活动中，威胁行为者使用 AI 代理和深度伪造技术，突破了两家加密货币交易所的身份验证（KYC）检查。代理的记录显示，它们生成实时深度伪造视频以通过实时自拍检查，并伪造身份证件照片以通过证件检查。</p><p>这些记录描述了一种有条不紊的活体检测破解方法。活体检测是一种安全方法，用于确认与数字系统交互的人是在捕获时确实亲临现场的真人。代理详细逆向了一个供应商的活体检测协议，记录了其发送的人脸检测事件流、其在检查期间如何跟踪人脸位置，以及其用于提示用户移动位置的坐标系。代理记录到的最佳尝试完成了完整动作序列，且人脸与目标位置的偏差在 7 个像素以内。尽管如此，在代理记录的所有尝试中，该供应商的服务端判定都拒绝了深度伪造内容。与此同时，另一个独立会话使用开源人脸动画模型，在单块消费级 GPU 上构建了实时深度伪造视频流水线。通过拆分模型并避免在 GPU 上进行不必要的内存复制，其速度达到每秒 11.5 帧，接近实时视频检查的预期要求。</p><p>代理还处理了身份证件。身份验证供应商会查找证件照片经过编辑或实际上是对屏幕拍摄而非相机拍摄的迹象。为绕过这些检查，代理的记录显示，它们生成了合成的相机元数据，使图像尺寸与 JPEG 文件内的真实数值相匹配，并保留了原始相机的压缩表，而重新保存编辑后的图像通常会替换这些压缩表。最终得到的图像在文件层面看起来与未经修改的相机照片无异。</p><p>此次活动还展示了 ARTEX 如何围绕一个目标同时推进多条工作流。至少四个代理会话同时运行：一个寻找套现方式，一个负责清空账户余额，一个搭建深度伪造视频流水线，一个执行验证绕过。它们共享发现，并通过跨会话工具移交任务。</p><h2 id=\"sec-5\">这对防御方意味着什么</h2><p>这些活动中使用的技术都不是新技术。AI 代理改变的是攻击者的速度和持续性。代理在基础安全卫生措施缺失的地方取得了成功，包括使用默认凭据或硬编码凭据、将密钥留在代码和公开制品中、未进行身份验证的接口和推理端点，以及未打补丁的软件。做好这些基础工作仍然是最有效的防御措施。</p><p>鉴于攻击者的速度和持久性，组织应假定暴露的密钥和配置错误很快就会被发现，并据此进行修复。他们应将 AI 应用程序、模型网关和推理端点纳入与其他生产系统相同的控制之下，并警惕通过异常支出或异常使用方式滥用 AI 服务。</p><h2 id=\"sec-6\">入侵指标（IOC）</h2><table> \n <tbody> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">IOC 值</td> \n   <td colspan=\"1\" rowspan=\"1\">IOC 类型</td> \n   <td colspan=\"1\" rowspan=\"1\">首次发现时间</td> \n   <td colspan=\"1\" rowspan=\"1\">最后发现时间</td> \n   <td colspan=\"1\" rowspan=\"1\">注释</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">104.28.225[.]223</td> \n   <td colspan=\"1\" rowspan=\"1\">IPv4</td> \n   <td colspan=\"1\" rowspan=\"1\">2026-10-17</td> \n   <td colspan=\"1\" rowspan=\"1\">2026-10-19</td> \n   <td colspan=\"1\" rowspan=\"1\">Campaign 1</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">31.22.91[.]156</td> \n   <td colspan=\"1\" rowspan=\"1\">IPv4</td> \n   <td colspan=\"1\" rowspan=\"1\">2026-10-14</td> \n   <td colspan=\"1\" rowspan=\"1\">2026-10-19</td> \n   <td colspan=\"1\" rowspan=\"1\">Campaign 1</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">150.136.38[.]110</td> \n   <td colspan=\"1\" rowspan=\"1\">IPv4</td> \n   <td colspan=\"1\" rowspan=\"1\">2026-10-31</td> \n   <td colspan=\"1\" rowspan=\"1\">2026-10-31</td> \n   <td colspan=\"1\" rowspan=\"1\">Campaign 1</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">128.242.115[.]131</td> \n   <td colspan=\"1\" rowspan=\"1\">IPv4</td> \n   <td colspan=\"1\" rowspan=\"1\">2026-10-31</td> \n   <td colspan=\"1\" rowspan=\"1\">2026-10-31</td> \n   <td colspan=\"1\" rowspan=\"1\">Campaign 1</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">216.176.239[.]231</td> \n   <td colspan=\"1\" rowspan=\"1\">IPv4</td> \n   <td colspan=\"1\" rowspan=\"1\">2026-11-02</td> \n   <td colspan=\"1\" rowspan=\"1\">2026-11-02</td> \n   <td colspan=\"1\" rowspan=\"1\">Campaign 1</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">212.107.28[.]51</td> \n   <td colspan=\"1\" rowspan=\"1\">IPv4</td> \n   <td colspan=\"1\" rowspan=\"1\">2026-10-14</td> \n   <td colspan=\"1\" rowspan=\"1\">2026-10-14</td> \n   <td colspan=\"1\" rowspan=\"1\">活动 2</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">103.142.140[.]158</td> \n   <td colspan=\"1\" rowspan=\"1\">IPv4</td> \n   <td colspan=\"1\" rowspan=\"1\">2026-10-17</td> \n   <td colspan=\"1\" rowspan=\"1\">2026-10-17</td> \n   <td colspan=\"1\" rowspan=\"1\">活动 2</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">104.28.251[.]98</td> \n   <td colspan=\"1\" rowspan=\"1\">IPv4</td> \n   <td colspan=\"1\" rowspan=\"1\">2026-10-18</td> \n   <td colspan=\"1\" rowspan=\"1\">2026-10-18</td> \n   <td colspan=\"1\" rowspan=\"1\">活动 2</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">104.28.251[.]99</td> \n   <td colspan=\"1\" rowspan=\"1\">IPv4</td> \n   <td colspan=\"1\" rowspan=\"1\">2026-10-18</td> \n   <td colspan=\"1\" rowspan=\"1\">2026-10-18</td> \n   <td colspan=\"1\" rowspan=\"1\">活动 2</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">104.28.219[.]97</td> \n   <td colspan=\"1\" rowspan=\"1\">IPv4</td> \n   <td colspan=\"1\" rowspan=\"1\">2026-10-18</td> \n   <td colspan=\"1\" rowspan=\"1\">2026-10-18</td> \n   <td colspan=\"1\" rowspan=\"1\">活动 2</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">125.103.213[.]41</td> \n   <td colspan=\"1\" rowspan=\"1\">IPv4</td> \n   <td colspan=\"1\" rowspan=\"1\">2026-10-18</td> \n   <td colspan=\"1\" rowspan=\"1\">2026-10-19</td> \n   <td colspan=\"1\" rowspan=\"1\">活动 2</td> \n  </tr> \n </tbody> \n</table><p>如果您有疑问，请在 <span><a href=\"https://repost.aws/tags/TAO7Z4bI5hQVWMiYFs34QhIA\">AWS re:Post</a></span> 上开启新主题，或联系 <span><a href=\"https://console.aws.amazon.com/support/home\">AWS Support</a></span>。</p><hr><p>\n   <img src=\"/dailyinfo/media/ba1bdcfb11cd629e.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"CJ Moses\" width=\"107\" height=\"160\">\n  </p><h3 id=\"sec-7\">CJ Moses</h3><p>CJ Moses 是 Amazon Integrated Security 的 CISO。在其岗位上，CJ 负责 Amazon 各部门的安全工程与运营。他的使命是通过让安全带来的益处成为阻力最小的路径，为 Amazon 各项业务提供支持。CJ 于 2007 年 12 月加入 Amazon，先后担任过 Consumer CISO，最近担任 AWS CISO，并于 2023 年 9 月出任 Amazon Integrated Security 的 CISO。</p><p>加入 Amazon 之前，CJ 曾在联邦调查局网络部门负责对计算机和网络入侵活动进行技术分析。CJ 还曾担任空军特别调查办公室（AFOSI）的特别探员。CJ 主导过多起计算机入侵调查，这些调查被视为如今安全行业的基础。</p><p>CJ 拥有计算机科学和刑事司法学位，并且是一名活跃的 SRO GT America GT2 赛车手。</p>","original","zhKind","translation","complete","Agent 安全","凭据","数据窃取","AWS","https://aws.amazon.com/blogs/security/amazon-threat-intelligence-observes-threat-actors-running-cybercrime-campaigns-with-artex-ai-agents/","AWS Security Blog",{"_116":117,"_118":-5},"changelogVersion","2026-10-01T08:00","release"]
