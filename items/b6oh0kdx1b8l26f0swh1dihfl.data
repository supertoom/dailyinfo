[{"_1":2,"_3":4},"root",{"_5":105},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1793667380000,"id","b6oh0kdx1b8l26f0swh1dihfl","title","Microsoft 修复 Windows 11 更新导致的 Smart App Control 无法启用问题","originalTitle","Microsoft fixes Smart App Control broken by October Windows update","summary","Microsoft 已修复 October 2026 KB5127648 安全更新导致部分 Windows 11 24H2 及更高版本设备无法开启 Smart App Control 的问题，已开启该功能的设备不受影响。10 月 28 日及之后发布的更新已包含修复；暂不部署预览更新的管理员也可按 Microsoft 建议编辑注册表或部署指定 Group Policy，并重启设备应用设置。","reason","source",{"_73":104},"links",{"_61":103},"publishedAt","2026-11-02T13:57:29.000Z","discoveredAt","2026-11-02T15:00:33.063Z","timelineAt","category","blue-team","tags",[98,99,100,101,102],"score",47,"selected",false,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","Sergiu Gatlan","body",{"_94":-5,"_61":95,"_96":-5,"_97":36},"outline",[85,86],"relatedStories",[81],"topics",[68,69,70,71],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fP4UakfxVANA","reportCount",1,"additionalSourceCount",0,{"_72":79,"_73":80},{"_72":77,"_73":78},{"_72":75,"_73":76},{"_72":30,"_73":74},"slug","name","蓝队与运营","vuln","漏洞披露","kernel","内核与系统","microsoft","Microsoft / 微软",{"_82":83,"_13":84},"publicId","6a724482-ddd2-496c-bec0-554f8151fe53","Windows 11更新修复VPN故障",{"_11":92,"_88":93,"_90":91},{"_11":87,"_88":89,"_90":91},"sec-2","text","Uncover email threats your existing defenses may miss.","level",2,"sec-1","Workaround available","zh","<p><img alt=\"Windows 11\" height=\"900\" src=\"/dailyinfo/media/f790dfade4a00541.jpg\" srcset=\"/dailyinfo/media/cba32519064e6b46.jpg 720w, /dailyinfo/media/5452606aa77d5ea1.jpg 1200w, /dailyinfo/media/f790dfade4a00541.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>Microsoft has resolved a known issue that prevented some users from activating the Smart App Control security feature after installing the October 2026 KB5127648 Windows 11 security update.</p><p>Smart App Control uses Microsoft's code integrity features and app intelligence services, and it works alongside SmartScreen and Microsoft Defender to block potentially harmful apps or binaries.</p><p>As the company explained when it acknowledged the issue last month, the Smart App Control option is grayed out and cannot be toggled on affected devices running Windows 11 24H2 and later.</p><p><a href=\"https://www.wiz.io/lp/securing-ai-agents-101?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY26Q3_INB_FORM_Securing-AI-Agents-101&amp;sfcid=701Py00000RTEWMIA5&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AI-Agents-101\"><img src=\"/dailyinfo/media/4799d302b2e6c13b.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>\"After installing this update, some devices might be unable to turn on Smart App Control in the Windows Security app if it has been turned off. On affected devices, the option to turn on Smart App Control might be grayed out,\" Microsoft said in the <a href=\"https://support.microsoft.com/en-us/servicing/os/windows-11/2026/10/kb5127648-windows-11-24h2-25h2-26h2-security-update\">KB5127648 advisory</a>. \"Devices where Smart App Control is already turned on are not affected and remain protected.\"</p><p>On Wednesday, the company confirmed that the issue has been fixed for users who installed this month's <a href=\"https://www.bleepingcomputer.com/news/microsoft/windows-11-kb5127936-update-released-with-41-changes-and-fixes/\">KB5127936 preview update</a>.</p><p>\"This issue was resolved by Windows updates released October 28, 2026 [..] and later. We recommend you install the latest security update for your device as it contains important improvements and issue resolutions, including this one,\" it noted <a href=\"https://admin.cloud.microsoft/Adminportal/Home?source=applauncher#/windowsreleasehealth/:/issue/WI1509826\">in a service alert sent to IT administrators</a>.</p><h2 id=\"sec-1\">Workaround available</h2><p>Microsoft also shared a temporary fix for&nbsp;admins&nbsp;who don't want to deploy the preview update on enterprise-managed devices and want to wait for next month's Patch Tuesday cumulative updates.</p><p>This requires them to edit the registry on affected Windows 11 devices to restore the ability to turn on Smart App Control by going through the following steps:</p><ol>\n\t<li>\n\t<p>Open a Command Prompt window by typing <strong>cmd</strong> in the <strong>Search</strong> box.</p>\n\n\t</li>\n\t<li>\n\t<p>Select Run as Administrator.</p>\n\n\t</li>\n\t<li>\n\t<p>At the command prompt, enter the following commands and then restart the device:</p>\n\n\n\t<pre><code>reg add \"HKLM\\SYSTEM\\CurrentControlSet\\Policies\\Microsoft\\FeatureManagement\\Overrides\" /v 2883193997 /t REG_DWORD /d 1 /f\n\nreg add \"HKLM\\SYSTEM\\CurrentControlSet\\Policies\\Microsoft\\FeatureManagement\\Overrides\" /v 2850574478 /t REG_DWORD /d 1 /f</code></pre>\n\t</li>\n</ol><p>They can also work around the issue by installing the Group Policies below, which turn on Smart App Control and enable logging for troubleshooting:</p><ul>\n\t<li><a href=\"https://download.microsoft.com/download/0a6cd6b8-5238-4129-bf2f-9d2a1edde053/Windows%2011%2024H2%2c%20Windows%2011%2025H2%20and%20Windows%20Server%202025%20KB5074105%20261015_19222%20Feature%20Preview.msi\">Windows 11, versions 24H2, 25H2, and 26H2</a> - KB5074105 261015_19222 Feature Preview</li>\n\t<li><a href=\"https://download.microsoft.com/download/b0e50eea-931f-49e9-be90-6d6268e94721/Windows%2011%2024H2%2c%20Windows%2011%2025H2%20and%20Windows%20Server%202025%20KB5074105%20261015_19221%20Feature%20Preview.msi\">Windows 11, versions 24H2, 25H2, and 26H2</a> - KB5074105 261015_19221 Feature Preview</li>\n</ul><p>The Group <span>Policy settings are under Computer Configuration &gt; Administrative Templates &gt; {Group Policy name} &gt; Windows 11, version 24H2, 25H2, and must be set to <strong>Enabled</strong> after installation</span>. Admins must also restart affected devices to apply the Group Policy settings.</p><p>Last month's KB5127936 preview update also <a href=\"https://www.bleepingcomputer.com/news/microsoft/microsoft-fixes-remote-desktop-failures-caused-by-recent-windows-updates/\">resolves Remote Desktop failures</a> caused by recent Windows updates when the \"Administrator protection\" security feature is enabled and <a href=\"https://www.bleepingcomputer.com/news/microsoft/microsoft-finally-fixes-vpn-issues-caused-by-september-updates/\">finally fixes Always On VPN issues</a> triggered by the September 2026 cumulative updates.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/3e0af1aa7fd35e6a.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-2\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Uncover email threats your existing defenses may miss.</a>\n        </h2><p>Adaptive Security's AI agents analyze email intent, context, and behavior to uncover phishing, business email compromise, and invoice fraud.</p><p>See what's getting through with a 14-day read-only scan of Microsoft 365 or Google Workspace, with no MX changes.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Start your free email security scan.</a>\n    </p>","zhKind","complete","补丁","版本更新","加固","Microsoft","操作系统","https://www.bleepingcomputer.com/news/microsoft/microsoft-fixes-smart-app-control-broken-by-october-windows-update/","BleepingComputer",{"_106":107,"_108":-5},"changelogVersion","2026-10-01T08:00","release"]
