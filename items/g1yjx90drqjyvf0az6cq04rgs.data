[{"_1":2,"_3":4},"root",{"_5":102},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":54,"_55":36,"_56":36,"_57":58,"_59":60,"_61":62},"expiresAt",1794357636000,"id","g1yjx90drqjyvf0az6cq04rgs","title","CNCERT 监测发现 VeilDHT 僵尸网络大范围感染 Linux 服务器与 IoT 设备","originalTitle","关于新型僵尸网络VeilDHT大范围传播的风险提示","summary","CNCERT 监测发现新型僵尸网络 VeilDHT 正通过漏洞利用大范围传播，主要感染 Linux 服务器与 IoT 设备，2026年10月16日至26日境内累计感染40467台，日上线肉鸡最高15805台。","reason","source",{"_77":101},"links",{"_94":100},"publishedAt","2026-10-30T11:59:00.000Z","discoveredAt","2026-10-31T08:59:15.589Z","timelineAt","category","activity","tags",[80,84,78,82,99,88],"score",82,"selected",true,"channel","news","story",{"_90":91,"_13":92},"x","sameEvent",{"_11":97,"_13":98},"readingMode","full","author","body",{"_62":93,"_94":-5,"_95":94,"_96":36},"outline",[],"relatedStories",[89],"topics",[69,70,71,72,73,74],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation",false,"bodyLanguage","zh","factId","fluIysH7e1EM","reportCount",2,"additionalSourceCount",1,{"_75":87,"_77":88},{"_75":85,"_77":86},{"_75":83,"_77":84},{"_75":81,"_77":82},{"_75":79,"_77":80},{"_75":76,"_77":78},"slug","malware","name","恶意软件","attack","攻击活动","exploited","在野利用","botnet","僵尸网络","iot","IoT 与车联网","cncert","CNCERT",{"_90":91,"_13":92},"publicId","26349142-7cb1-4952-a1c9-0e284934b91c","CNCERT披露VeilDHT大规模感染Linux与IoT设备","<p>原创 <span>CNCERT</span> <span>2026-10-30 19:59</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/ffd881c5f11f7a40.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><img src=\"/dailyinfo/media/3f3eae0a385fa0a2.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span>感谢绿盟科技伏影实验室在本报告的样本分析工作中做出的重要贡献。</span></p><p><span><span>一、概述</span></span></p><p><span>近期，国家互联网应急中心（CNCERT）监测发现一种隐蔽性极强的全新僵尸网络正在大范围传播，主要感染Linux服务器与IoT设备。其传播以漏洞利用为主，我们将其命名为VeilDHT，其中，DHT取自其藏身公共分布式网络的备用控制信道，其实际控制地址经DNS假IP应答与DHT混流双通道获取。</span></p><p><span>VeilDHT是一个功能体系完备、以隐蔽性为核心设计理念的全新僵尸网络家族，其开发者具备专业的密码工程素养，已对Linux服务器与IoT设备生态构成现实威胁。与多数将工程投入集中于攻击能力的僵尸网络不同，VeilDHT把主要精力放在隐蔽性上，功能也更为全面：配置以乱序密文存放，通信采用认证加密，心跳完全随机化，发现、阻断、解密和清理的难度都明显提升；功能上具备DDoS攻击、任意命令执行、交互式反向Shell及反向代理能力，一旦感染，受害主机便同时成为攻击源、隐蔽跳板和长期可控的资源。2026年10月16日至10月26日期间，CNCERT监测发现该僵尸网络感染的日上线肉鸡数最高达到15805台，累计已有40467台设备受其感染。现将其主要情况分析披露如下。</span></p><p><span><span>二、恶意样本分析</span></span></p><p><img src=\"/dailyinfo/media/8190f2f3bce8cb57.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>图 1 VeilDHT僵尸网络</span></span></p><p><span><span>1.传播方式</span></span></p><p><span>该木马主要通过漏洞利用实现扩散，目标以Linux服务器和各类IoT设备为主，当前观测到攻击者使用的漏洞如下：</span></p><p><span>CVE-2024-3912：ASUS路由器命令注入漏洞</span></p><p><span>CVE-2021-35394：Realtek Jungle SDK 命令注入漏洞</span></p><p><span><span>2.通信机制</span></span></p><p><span>C&amp;C寻址机制是该家族最突出的特点，木马通过两条通道获取真实控制端地址，均以伪装为前提。一是经过加密编码的DNS应答，二是公共P2P网络。两条通道均对真实控制端地址进行了伪装，互为备份，控制面摆脱了对固定域名或IP的依赖，使其控制端得以长期隐藏，检测、封禁与追踪的难度较高。</span></p><p><img src=\"/dailyinfo/media/b82b1dd17ad1cec8.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>图 2 VeilDHT获取控制ip方式示意图</span></span></p><p><span>VeilDHT通信保护贯穿握手、认证、指令传输全过程，其中使用了Ed25519、X25519、SHA-512、XChaCha20-Poly1305等加密算法。上线时，木马以内置验证公钥核验控制端签名，确认无误后才建立会话；其后发送的主机信息、心跳与指令全部在加密通道内传输。该体系严格遵循现代密码工程规范，远超僵尸网络常见的轻量混淆。只有在密钥交换阶段就完整掌握流量，事后截获的通信数据才有解密的可能。这套加密逻辑的完整和严谨程度在僵尸网络中并不多见，说明开发者具备专业的密码工程能力。</span></p><p><span><span>3.核心功能</span></span></p><p><span>VeilDHT僵尸网络具备覆盖UDP、TCP、GRE等协议的20种DDoS攻击、任意命令执行、交互式反向Shell及反向代理能力，控制端还可查询主机信息、控制主机重启并令木马自删除。DDoS攻击、命令执行、代理和管控等能力一应俱全，一旦被感染，受害主机便会同时成为攻击源、隐蔽跳板和长期可控的资源。</span></p><p><img src=\"/dailyinfo/media/f8b3bb103dfe70a4.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>图 3 VeilDHT功能体系示意图</span></span></p><p><span><span>信息收集：</span></span><span>VeilDHT会收集并上传受害主机的架构、主机名、内存、进程数等信息，为后续的横向移动或更有针对性的攻击提供信息基础。</span></p><p><span><span>命令执行</span></span><span><span>：</span></span><span>该家族具备命令执行功能，能够执行任意系统命令，并可重启主机、令木马自删除，威胁性因此显著提升；</span></p><p><span><span>反向Shell：</span></span><span>能够建立交互式的反向Shell通道，对受害主机形成完全控制，可作为进一步攻击的立足点；</span></p><p><span><span>反向代理：</span></span><span>能够转发网络流量，将受害主机用作攻击跳板，隐藏攻击者的真实来源；</span></p><p><span><span>DDoS攻击：</span></span><span>支持20种攻击方式、覆盖多种协议，攻击指令可动态下发，实现对指定目标的精准打击。</span></p><p><span><span>4.对抗与规避检测</span></span></p><p><span>除上述功能外，木马在通信、心跳、配置存储、进程运行等方面均进行了专门的隐蔽处理，并支持版本的滚动更新，整体上分析、阻断和清理的难度较高。</span></p><p><span><span>通信：</span></span><span>木马与控制端之间的通信全程加密，攻击指令与回传数据均以密文形式传输，且其加密设计使得其通信流量即使被中途截获也难以还原，通信隐蔽性强。</span></p><p><span><span>心跳：</span></span><span>木马的心跳采用随机化机制，周期与内容均呈随机特征，规避了基于固定规律的流量检测。</span></p><p><span><span>配置存储：</span></span><span>木马的配置信息以密文形式存放，并打乱存储顺序，静态分析难以按序还原完整的配置内容。</span></p><p><span><span>版本的滚动更新：</span></span><span>木马支持版本的滚动更新，可在受害主机上自动完成升级，使控制端能够持续推送新版本、长期掌控受控节点。</span></p><p><span><span>三、感染规模</span></span></p><p><span>通过监测分析发现，2026年10月16日至26日期间，VeilDHT僵尸网络在我国境内感染“肉鸡”规模约40467台，境内日上线肉鸡数量最高达15805台。其感染量变化趋势如下：</span></p><p><img src=\"/dailyinfo/media/2f3cb3f049b07f07.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>图 4 境内感染终端数量</span></span></p><p><span><span>四、总结</span></span></p><p><span>VeilDHT具备极强的隐蔽性，其对抗设计贯穿配置、寻址、通信、心跳与节点接管等环节：配置以乱序密文存放，DNS应答返回的皆为伪装IP，通信全程加密，心跳呈随机规律，版本更替采用协商式的滚动接管，层层设防，构成一套完备的对抗体系。</span></p><p><span>该家族现阶段正处于传播扩张期，其开发者是一个具备专业能力的运营团伙，意在构建一个能够长期在线、隐蔽持久的资源池。受控主机将同时被用作DDoS攻击源和隐蔽攻击跳板，对Linux服务器与IoT设备生态构成现实威胁，需要持续监测和高度警惕。</span></p><p><span><span>五、防范建议</span></span></p><p><span>请广大网民和网络运营者强化风险意识，加强安全防范，避免不必要的经济损失，主要建议包括：</span></p><p><span>1.及时梳理资产清单，修复相关系统漏洞，包括历史漏洞和最新曝光漏洞，IoT设备应同步升级固件。</span></p><p><span>2.加强口令强度，避免使用弱口令，密码设置应包含大小写字母、数字和符号，建议使用16位或更长密码，不同设备使用不同口令并定期更换。</span></p><p><span>3.尽量不打开来历不明的网页链接，不安装来源不明软件；通过官方网站等可信渠道获取软件，下载后校验文件哈希。</span></p><p><span>4.安装终端防护软件，定期全盘查杀；重点排查异常进程、异常外连，以及本提示所列特征字符串和异常端口监听。</span></p><p><span>5.网络运营者应监测本提示所列IOC的域名解析请求与IP连接情况（所列域名的当前解析结果为伪装IP，真实控制端以下列IP为准），发现异常及时阻断并留存证据。</span></p><p><span>6.发现主机感染后，立即核实受控情况与入侵途径，对受害主机隔离清理，并及时向属地主管部门报告。</span></p><p><span><span>六、相关IoC</span></span></p><p><span>82de137cfb3d7a6bf38cca60e85b8476c75c646c764071f98b8cb34d9de42e44</span></p><p><span>http[:]//160.119.66.18:80/n2/</span></p><p><span>http[:]//160.119.71.134/n2/</span></p><p><span>t-smc[.]top</span></p><p><span>wish-list[.]cfd</span></p><p><span>mgnacrrrta[.]cfd</span></p><p><span>lostmymind[.]cfd</span></p><p><span>afterhours[.]click</span></p><p><span>nightslikethis[.]club</span></p><p><span>imagiraffe[.]shop</span></p><p><span>namecheat.niggerservers[.]xyz</span></p><p><span>boopfactory[.]top</span></p><p><span>135.136.191[.]231</span></p><p><span>82.27.2[.]131</span></p><p><span>144.172.67[.]77</span></p><p><span>151.243.213[.]187</span></p><p><span>176.100.39[.]134</span></p><p><span>178.83.206[.]213</span></p><p><span>176.100.36[.]169</span></p><p><span>156.246.90[.]214</span></p><p><span>23.27.230[.]15</span></p><p><span>45.146.131[.]109</span></p><p><span>209.141.61[.]163</span></p><p><span>160.119.71[.]27</span></p><p><span>143.246.62[.]76</span></p><p><span>217.113.235[.]21</span></p><hr><p><img src=\"/dailyinfo/media/db171ba0d0bbdac1.webp\" loading=\"lazy\" decoding=\"async\"></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=981e0443&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzIwNDk0MDgxMw%3D%3D%26mid%3D2247502483%26idx%3D1%26sn%3D8c430cd390f5dca61798eb26b1aa9b7e\">跳转微信打开</a></p>","original","zhKind","complete","sadp3rc08vj8hs3yc7r72lm24","CNCERT披露VeilDHT僵尸网络大范围感染Linux服务器与IoT设备","IoT","https://mp.weixin.qq.com/s?__biz=MzIwNDk0MDgxMw==&mid=2247502483&idx=1&sn=8c430cd390f5dca61798eb26b1aa9b7e","国家互联网应急中心CNCERT",{"_103":104,"_105":-5},"changelogVersion","2026-10-01T08:00","release"]
