[{"_1":2,"_3":4},"root",{"_5":159},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":37,"_59":60},"expiresAt",1794616835000,"id","wz2ouxat7l8a80o3zl97dofcp","title","CyberStrikeAI 入侵 AWS：16 天内跨 4 个账户调用 78 次 API","originalTitle","56 AWS API calls in 141 milliseconds: Inside an AI-run intrusion","summary","一台 CyberStrikeAI 服务器在 2026 年 9 月 30 日至 10 月 16 日间，利用 8 个 AWS 身份凭据侵入 4 个账户并触发 78 条告警；其中一次在 141 毫秒内批量读取 56 个 EC2 user data，另一身份解密 SSM 参数后 29 秒发起 SendCommand。","reason","文章通过 CloudTrail 时间线还原了低严重度告警如何经长期关联构成同一次入侵，并提供了可迁移的行为检测与 IAM 处置思路。","source",{"_74":158},"links",{"_148":157},"publishedAt","2026-11-13T15:27:20.000Z","discoveredAt","2026-11-13T13:56:25.799Z","timelineAt","category","activity","tags",[75,77,152,153,154,155,156],"score",71,"selected",true,"channel","news","story",{"_85":86,"_13":87},"x","readingMode","full","author","body",{"_60":147,"_148":-5,"_149":150,"_151":37},"outline",[88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105],"relatedStories",[84],"topics",[67,68,69,70,71],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","f4vW8-3aFbCQ","reportCount",1,"additionalSourceCount",0,{"_72":82,"_74":83},{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","attack","name","攻击活动","ai-offense","AI 攻防","red-team","红队与渗透","identity","身份与访问","cloud-native","云与原生",{"_85":86,"_13":87},"publicId","70ca05bd-2689-4dbf-8cfc-27431b42b2e3","CyberStrikeAI入侵四个AWS账户",{"_11":145,"_107":146,"_109":110},{"_11":143,"_107":144,"_109":110},{"_11":141,"_107":142,"_109":123},{"_11":139,"_107":140,"_109":123},{"_11":137,"_107":138,"_109":123},{"_11":135,"_107":136,"_109":130},{"_11":133,"_107":134,"_109":130},{"_11":131,"_107":132,"_109":130},{"_11":128,"_107":129,"_109":130},{"_11":126,"_107":127,"_109":110},{"_11":124,"_107":125,"_109":123},{"_11":121,"_107":122,"_109":123},{"_11":119,"_107":120,"_109":110},{"_11":117,"_107":118,"_109":110},{"_11":115,"_107":116,"_109":110},{"_11":113,"_107":114,"_109":110},{"_11":111,"_107":112,"_109":110},{"_11":106,"_107":108,"_109":110},"sec-18","text","关于 Elastic Security Labs","level",2,"sec-17","参考资料","sec-16","结论：此次入侵对告警关联意味着什么","sec-15","如果你的 AWS 身份凭据已泄露，应如何响应","sec-14","失陷指标（IOC）","sec-13","此次 AWS 入侵中观察到的 MITRE ATT&amp;CK 技术","sec-12","使用 Elastic Workflows 实现 IAM 遏制",3,"sec-11","触发了哪些检测规则，以及严重性为何保持较低","sec-10","Elastic 检测如何发现 CyberStrikeAI 活动","sec-9","阶段 4：间隔 14 天后返回（10月16日）",4,"sec-8","阶段 3：SSM 参数解密与 SendCommand（10 月 1 日至 2 日）","sec-7","阶段 2：收集 Secrets Manager 机密和 EC2 用户数据（9 月 30 日）","sec-6","阶段 1：验证被盗 AWS 凭证（9 月 30 日）","sec-5","攻击时间线：横跨四个 AWS 账户的 16 天","sec-4","我们如何将该 IP 归因于 CyberStrikeAI","sec-3","威胁基础设施及所使用的八个 AWS 身份","sec-2","CyberStrikeAI 服务器如何穿越四个 AWS 账户","sec-1","CyberStrikeAI AWS 入侵事件的主要发现","<p>一台服务器在 141 毫秒内读取了 56 个 EC2 用户数据脚本。随后它沉寂了 14 天，再次出现。这一间隔造成的破坏比那次爆发更大，因为固定的相关性分析窗口无法跨越两周。</p><p>2026 年 9 月 30 日至 10 月 16 日期间，一台 <a href=\"https://github.com/Ed1s0nZ/CyberStrikeAI\">CyberStrikeAI</a> 服务器以熟悉的顺序利用被盗的 AWS 凭据执行操作：验证身份、从 Secrets Manager 收集机密、提取 EC2 用户数据、解密 SSM 参数以及发送远程命令。这些操作中的每一步都是合法角色每天都会调用的。当时，CloudTrail 中没有任何迹象显得紧迫。</p><p>CyberStrikeAI 是一个将 LLM 智能体与进攻性安全工具相结合的开源平台。Team Cymru 的 Thomas <a href=\"https://thehackernews.com/2026/03/open-source-cyberstrikeai-deployed-in.html?hl=en_US\">统计了 2026 年初运行该平台的 21 个 IP</a>，它们全部以 Fortinet 边缘设备为目标。这是我们首次看到同一套工具被用于攻击 AWS。</p><p>基于工具归因以及日志中的机器速度行为，我们将其称为 AI 辅助攻击。我们无法证明是由 LLM 智能体作出决策，也不知道攻击者是如何获得这些凭据的。</p><h2 id=\"sec-1\"><strong>CyberStrikeAI AWS 入侵事件的主要发现</strong></h2><ul><li><p>2026 年 9 月 30 日至 10 月 16 日，一台 CyberStrikeAI 服务器（43[.]240[.]29[.]11）使用了来自四个账户中八个 AWS 身份（五个 IAM 用户和三个 EC2 实例角色）的凭据，并产生了 78 条警报。</p></li><li><p>app-role 在 141 毫秒内发送了 56 个用户数据请求，占 58 条用户数据检索警报的一部分（总数的 74%），这表明使用了自动化工具。</p></li><li><p>10 月 2 日，container-role 读取了一个加密的 SSM 参数，并在 29 秒后发出了 SSM SendCommand。审计日志未显示该命令的内容，也未显示其是否执行成功。</p></li><li><p>43[.]240[.]29[.]28 和 43[.]240[.]29[.]33 在端口 8080 上提供 CyberStrikeAI 页面，使用的自签名证书与 43[.]240[.]29[.]11 相同，从而将这三台服务器关联在一起。截至 11 月，这三个 IP 均已不再提供该界面，因此应将其视为回溯性狩猎的指标。&nbsp;</p></li><li><p>全部 78 条警报的严重程度均为中等或低，只有按源 IP 进行关联后才能看出其意义。&nbsp;</p></li></ul><h2 id=\"sec-2\">CyberStrikeAI 服务器如何穿越四个 AWS 账户</h2><h3 id=\"sec-3\">威胁基础设施及所使用的八个 AWS 身份</h3><p>在 16 天内，一台 CyberStrikeAI 服务器使用了属于四个 AWS 账户中八个 IAM 身份的凭据，其中四天存在活动。账户和身份名称均以别名替代。</p><table><thead><tr><th><p>属性</p></th><th><p>值</p></th></tr></thead><tbody><tr><td><p>源 IP</p></td><td><p>43[.]240[.]29[.]11</p></td></tr><tr><td><p>归因</p></td><td><p>CyberStrikeAI 服务器（已确认）</p></td></tr><tr><td><p>目标云</p></td><td><p>AWS</p></td></tr><tr><td><p>涉及账户</p></td><td><p>4（账户 A 至 D）</p></td></tr><tr><td><p>使用的 IAM 身份</p></td><td><p>8</p></td></tr><tr><td><p>被使用角色凭据的 EC2 实例</p></td><td><p>3</p></td></tr><tr><td><p>警报总数</p></td><td><p>78</p></td></tr><tr><td><p>活动持续时间</p></td><td><p>16 天（9 月 30 日至 10 月 16 日）</p></td></tr></tbody></table><table><thead><tr><th><p>别名</p></th><th><p>类型</p></th><th><p>账户</p></th><th><p>操作</p></th><th><p>警报</p></th><th><p>活动窗口</p></th></tr></thead><tbody><tr><td><p>app-role</p></td><td><p>EC2 实例角色</p></td><td><p>A</p></td><td><p>GetSecretValue, DescribeInstanceAttribute</p></td><td><p>60</p></td><td><p>9 月 30 日至 10 月 1 日</p></td></tr><tr><td><p>logship-user-1</p></td><td><p>IAM 用户</p></td><td><p>A, C</p></td><td><p>GetCallerIdentity</p></td><td><p>5</p></td><td><p>9 月 30 日至 10 月 16 日</p></td></tr><tr><td><p>logship-user-2</p></td><td><p>IAM 用户</p></td><td><p>B</p></td><td><p>GetCallerIdentity</p></td><td><p>3</p></td><td><p>9 月 30 日至 10 月 16 日</p></td></tr><tr><td><p>email-svc-user</p></td><td><p>IAM 用户</p></td><td><p>A</p></td><td><p>GetCallerIdentity, GetSessionToken</p></td><td><p>3</p></td><td><p>9 月 30 日</p></td></tr><tr><td><p>nonprod-role</p></td><td><p>EC2 实例角色</p></td><td><p>A</p></td><td><p>GetSecretValue</p></td><td><p>2</p></td><td><p>10 月 1 日</p></td></tr><tr><td><p>cert-renew-user</p></td><td><p>IAM 用户</p></td><td><p>A</p></td><td><p>GetCallerIdentity</p></td><td><p>2</p></td><td><p>9 月 30 日至 10 月 1 日</p></td></tr><tr><td><p>container-role</p></td><td><p>EC2 实例角色</p></td><td><p>A</p></td><td><p>GetParameter, SendCommand</p></td><td><p>2</p></td><td><p>10 月 2 日</p></td></tr><tr><td><p>named-user</p></td><td><p>IAM 用户</p></td><td><p>D</p></td><td><p>GetSessionToken</p></td><td><p>1</p></td><td><p>10 月 16 日</p></td></tr></tbody></table><p>这三个角色会话均以 EC2 实例 ID 命名，因此这些凭据来自实例配置文件。从外部 IP 使用这些凭据意味着它们是从实例中获取的，例如通过 SSRF 或主机失陷。&nbsp;</p><h3 id=\"sec-4\">我们如何将该 IP 归因于 CyberStrikeAI</h3><p>互联网扫描数据显示，43[.]240[.]29[.]11 在提供 CyberStrikeAI Web 界面，并使用自签名的 CyberStrikeAI 证书，这比首次告警早一天。将该 IP 与页面标题结合进行 FOFA 搜索会返回两条记录，一条为 HTTP，一条为 HTTPS，二者均位于 8080 端口。</p><table><thead><tr><th><p>观测项</p></th><th><p>值</p></th></tr></thead><tbody><tr><td><p>FOFA 查询</p></td><td><p>ip=\"43.240.29.11\" &amp;&amp; title==\"CyberStrikeAI\"</p></td></tr><tr><td><p>服务</p></td><td><p>8080 端口：HTTPS 记录发现于 2026-09-29，HTTP 记录发现于 2026-10-06</p></td></tr><tr><td><p>页面标题</p></td><td><p>CyberStrikeAI</p></td></tr><tr><td><p>托管方</p></td><td><p>AS133199, SonderCloud Limited, Hong Kong SAR</p></td></tr><tr><td><p>响应</p></td><td><p>HTTP/2.0 200 OK，附带宽松的 CORS 标头（方法包括 POST、OPTIONS、GET、PUT、DELETE）</p></td></tr><tr><td><p>FOFA fid</p></td><td><p>两条记录均为 gOOpHYKNnstDLjmeRfUoIg==</p></td></tr><tr><td><p>TLS 证书</p></td><td><p>自签名且不受信任，颁发者和主体 CN 均为 CyberStrikeAI，采用 ECDSA 与 SHA-256，有效期从 2026-09-15 至 2027-09-15</p></td></tr></tbody></table><p>三个日期将该服务器在 AWS 活动开始前与该 IP 关联起来：</p><ul><li><p><strong>2026 年 9 月 15 日</strong> - 自签名的 CyberStrikeAI 证书已签发</p></li><li><p><strong>2026 年 9 月 29 日</strong> - 互联网扫描数据记录到 8080 端口上的 HTTPS 服务</p></li><li><p><strong>2026 年 9 月 30 日</strong> - 来自 43[.]240[.]29[.]11 的首个 AWS 检测告警触发</p></li></ul><p>8080 端口是该平台默认设置中的 Web 界面端口，而香港托管与此前报道相符，该报道将大多数 CyberStrikeAI 服务器位于中国、新加坡和香港。扫描数据确定在该 IP 上运行的内容，告警则将该 IP 与 AWS 活动关联起来。完整的证书字段见“指标”部分。</p><h3 id=\"sec-5\">攻击时间线：横跨四个 AWS 账户的 16 天</h3><p>该活动分四个阶段持续四个活跃日，随后在最终回访前间隔了 14 天。所示时间均为相对于每个阶段首个事件的偏移量。</p><h4 id=\"sec-6\">阶段 1：验证被盗 AWS 凭证（9 月 30 日）</h4><p>该服务器在 51 分钟内对三个账户中的四个 IAM 用户调用了 GetCallerIdentity，这是检查哪些凭证仍然有效的标准方法。其中三次调用发生在同一秒内，分别位于三个账户中，表明存在自动化行为。对一个用户发起的两次 GetSessionToken 调用显示，该用户正在请求临时凭证。</p><table><thead><tr><th><p>时间偏移</p></th><th><p>身份</p></th><th><p>账户</p></th><th><p>操作</p></th></tr></thead><tbody><tr><td><p>T+0 分钟</p></td><td><p>email-svc-user</p></td><td><p>A</p></td><td><p>GetCallerIdentity</p></td></tr><tr><td><p>T+22 分钟</p></td><td><p>email-svc-user</p></td><td><p>A</p></td><td><p>GetSessionToken</p></td></tr><tr><td><p>T+26 分钟</p></td><td><p>cert-renew-user</p></td><td><p>A</p></td><td><p>GetCallerIdentity</p></td></tr><tr><td><p>T+27 分钟</p></td><td><p>email-svc-user</p></td><td><p>A</p></td><td><p>GetSessionToken</p></td></tr><tr><td><p>T+51 分钟</p></td><td><p>logship-user-1</p></td><td><p>A</p></td><td><p>GetCallerIdentity</p></td></tr><tr><td><p>T+51 分钟</p></td><td><p>logship-user-2</p></td><td><p>B</p></td><td><p>GetCallerIdentity</p></td></tr><tr><td><p>T+51 分钟</p></td><td><p>logship-user-1</p></td><td><p>C</p></td><td><p>GetCallerIdentity</p></td></tr></tbody></table><p>经确认有效的账户均为服务账户，此类账户通常很少轮换，监控也相对较少。</p><h4 id=\"sec-7\">阶段 2：收集 Secrets Manager 机密和 EC2 用户数据（9 月 30 日）</h4><p>主要活动来自 app-role，这是账户 A 中的一个 EC2 实例角色。它读取了一个机密，发出了一次用户数据请求，随后在 141 毫秒内集中发起了 56 次用户数据请求。</p><table><thead><tr><th><p>时间偏移</p></th><th><p>操作</p></th><th><p>详情</p></th></tr></thead><tbody><tr><td><p>T+0 分钟</p></td><td><p>GetSecretValue</p></td><td><p>该角色首次访问 Secrets Manager</p></td></tr><tr><td><p>T+3 小时 18 分钟</p></td><td><p>DescribeInstanceAttribute</p></td><td><p>首次获取用户数据，可能是一次测试</p></td></tr><tr><td><p>T+6 小时 10 分钟，持续 141 毫秒</p></td><td><p>DescribeInstanceAttribute（56 次调用）</p></td><td><p>突发频率约为每次调用 2.5 毫秒</p></td></tr></tbody></table><p>每次调用都请求 userData 属性，即附加到实例的启动脚本。这些脚本通常包含硬编码的 API 密钥、数据库凭证、引导机密、SSH 密钥或证书。其间隔与工具逐个处理预先准备的实例 ID 列表的特征一致，而非人工在控制台操作。当天全部 57 次调用都来自同一个假定角色会话。</p><h4 id=\"sec-8\">阶段 3：SSM 参数解密与 SendCommand（10 月 1 日至 2 日）</h4><p>10月1日，服务器重新验证了凭据、获取了更多机密，并使用了第二个角色。</p><table><thead><tr><th><p>时间偏移</p></th><th><p>操作</p></th><th><p>身份</p></th><th><p>详细信息</p></th></tr></thead><tbody><tr><td><p>10月1日，T+0 秒</p></td><td><p>GetCallerIdentity（4 次调用）</p></td><td><p>多个用户</p></td><td><p>跨账户重新验证</p></td></tr><tr><td><p>10月1日，T+1 秒</p></td><td><p>GetSecretValue</p></td><td><p>app-role</p></td><td><p>更多机密</p></td></tr><tr><td><p>10月1日，T+14 秒</p></td><td><p>DescribeInstanceAttribute</p></td><td><p>app-role</p></td><td><p>又发起了一次用户数据请求</p></td></tr><tr><td><p>10月1日，T+4 小时 10 分钟</p></td><td><p>GetSecretValue</p></td><td><p>nonprod-role</p></td><td><p>来自非生产环境的机密</p></td></tr><tr><td><p>10月1日，T+4 小时 14 分钟</p></td><td><p>GetSecretValue</p></td><td><p>nonprod-role</p></td><td><p>第二次拉取，约在 3 分钟后</p></td></tr><tr><td><p>10月2日，T+0 秒</p></td><td><p>带解密功能的 GetParameter</p></td><td><p>container-role</p></td><td><p>读取 SSM SecureString 参数</p></td></tr><tr><td><p>10月2日，T+29 秒</p></td><td><p>SendCommand</p></td><td><p>container-role</p></td><td><p>通过 SSM 执行远程命令</p></td></tr></tbody></table><p>非生产环境通常控制措施较弱，有时还会与生产环境共享机密，因此在对证明情况相反之前，应将访问其中一个环境视为等同于访问另一个环境。</p><p>10月2日的这一连串活动是数据中风险最高的部分。在 29 秒内，第三个角色读取了一个加密的 SSM 参数，随后发出了 SSM SendCommand。审计日志记录显示发送了一条命令。</p><h4 id=\"sec-9\">阶段 4：间隔 14 天后返回（10月16日）</h4><p>沉寂 14 天后，服务器再次出现并重新验证了凭据，其中包括此前从未出现过的第四个账户中的用户。</p><table><thead><tr><th><p>时间偏移</p></th><th><p>身份</p></th><th><p>账户</p></th><th><p>操作</p></th></tr></thead><tbody><tr><td><p>T+0 分钟</p></td><td><p>named-user</p></td><td><p>D</p></td><td><p>GetSessionToken</p></td></tr><tr><td><p>T+1 小时 57 分钟</p></td><td><p>logship-user-1</p></td><td><p>C</p></td><td><p>GetCallerIdentity</p></td></tr><tr><td><p>T+3 小时 7 分钟</p></td><td><p>logship-user-2</p></td><td><p>B</p></td><td><p>GetCallerIdentity</p></td></tr></tbody></table><p>10月16日的活动与检查在间隔期后访问权限是否仍然有效相符。这也可能意味着一次有意安排的冷却期，或者操作人员在处理其他目标后返回。数据无法区分这些情况。</p><h2 id=\"sec-10\">Elastic 检测如何发现 CyberStrikeAI 活动</h2><h3 id=\"sec-11\">触发了哪些检测规则，以及严重性为何保持较低</h3><p>共有六条 Elastic 检测规则被触发，它们共同覆盖了每个阶段。单独来看，每条警报的严重性都为中等或低，很容易被忽略。真正将它们联系起来的是源 IP。</p><figure><figcaption><p><em>图 1：按 AWS API 调用（event.action）划分的警报，按检测规则着色。</em></p></figcaption></figure><table><thead><tr><th><p>规则</p></th><th><p>警报数</p></th><th><p>严重性</p></th><th><p>阶段</p></th></tr></thead><tbody><tr><td><p><a href=\"https://github.com/elastic/detection-rules/blob/main/rules/integrations/aws/discovery_ec2_userdata_request_for_ec2_instance.toml\">EC2 实例的 AWS EC2 用户数据检索</a></p></td><td><p>58</p></td><td><p>中等</p></td><td><p>2, 3</p></td></tr><tr><td><p><a href=\"https://github.com/elastic/detection-rules/blob/main/rules/integrations/aws/discovery_new_terms_sts_getcalleridentity.toml\">首次调用 AWS STS GetCallerIdentity API</a></p></td><td><p>11</p></td><td><p>中等</p></td><td><p>1, 3, 4</p></td></tr><tr><td><p><a href=\"https://github.com/elastic/detection-rules/blob/main/rules/integrations/aws/credential_access_new_terms_secretsmanager_getsecretvalue.toml\">首次发现访问 Secrets Manager 中的 AWS 机密值</a></p></td><td><p>4</p></td><td><p>中等</p></td><td><p>2, 3</p></td></tr><tr><td><p><a href=\"https://github.com/elastic/detection-rules/blob/main/rules_building_block/privilege_escalation_sts_getsessiontoken_abuse.toml\">AWS STS GetSessionToken 使用情况</a></p></td><td><p>3</p></td><td><p>低</p></td><td><p>1, 4</p></td></tr><tr><td><p><a href=\"https://github.com/elastic/detection-rules/blob/main/rules/integrations/aws/execution_ssm_sendcommand_by_rare_user.toml\">由稀有用户执行的 AWS SSM SendCommand</a></p></td><td><p>1</p></td><td><p>低</p></td><td><p>3</p></td></tr><tr><td><p><a href=\"https://github.com/elastic/detection-rules/blob/bfb4a62ddad9fc0ea2d46693943d2ce4448edfb1/rules/integrations/aws/credential_access_retrieve_secure_string_parameters_via_ssm.toml#L21\">带解密标志的 AWS Systems Manager SecureString 参数请求</a></p></td><td><p>1</p></td><td><p>中等</p></td><td><p>3</p></td></tr></tbody></table><p><em>图 2：按阶段和严重性划分的警报明细。&nbsp;</em></p><table><thead><tr><th><p>日期</p></th><th><p>警报数</p></th><th><p>主要活动</p></th></tr></thead><tbody><tr><td><p>9月30日</p></td><td><p>65</p></td><td><p>57 次用户数据请求、凭据验证、首次访问机密</p></td></tr><tr><td><p>10月1日</p></td><td><p>8</p></td><td><p>来自第二个角色的机密、凭据重新验证</p></td></tr><tr><td><p>10月2日</p></td><td><p>2</p></td><td><p>SSM 参数解密和 SendCommand</p></td></tr><tr><td><p>10月16日</p></td><td><p>3</p></td><td><p>回访、在两个账户中重新验证凭据，外加一个新账户</p></td></tr></tbody></table><p><em>图 3：攻击时间线。</em></p><p>多个细节表明其使用了自动化工具：</p><ul><li><p>单一会话在 141 毫秒内发起了 56 次用户数据请求。</p></li><li><p>一秒钟内跨三个账户发起了三次 GetCallerIdentity 调用。</p></li><li><p>节奏发生了急剧变化。83% 的警报（78 个中的 65 个）出现在第一天，随后活动减少为每天几个有针对性的操作。</p></li></ul><p>这些情况不能证明是 LLM 智能体在做决策，但这与智能体平台逐一处理凭据和目标的工作方式相符。</p><h3 id=\"sec-12\"><strong>使用 Elastic Workflows 实现 IAM 遏制</strong></h3><p>AI 辅助的攻击往往零散且迅速，尤其是在身份凭据被攻破时。Elastic Workflows 可以通过调用 AWS 服务（如 IAM）的 API 自动封禁该身份，从而为响应人员提供支持。</p><p><a href=\"https://www.elastic.co/docs/explore-analyze/workflows\">Elastic Workflows</a> 随技术栈（9.4+）一同提供，允许检测规则在每次告警时调用自定义工作流，该工作流使用以 YAML 定义的步骤流水线。作为概念验证，我们创建了一个自定义工作流，在下文共享的检测项触发时执行，以模拟与建议的响应操作一致的行为。</p><figure></figure><p>在每次告警时，该工作流会执行以下操作，并在数秒内完成，以帮助遏制该身份：</p><ol><li><p>基于 <a href=\"https://github.com/elastic/detection-rules/blob/main/rules/integrations/aws/discovery_ec2_bulk_user_data_enumeration.toml\">AWS EC2 Bulk User Data Enumeration</a> 检测规则触发</p></li><li><p>遍历与告警关联的每个用户名</p></li><li><p>通过 Elastic 的 AWS Lambda 连接器调用 AWS Lambda 函数</p></li><li><p>使用 iam:UpdateAccessKey 停用已失陷的访问密钥。</p></li><li><p>通过 iam:PutUserPolicy 添加带有 aws:TokenIssueTime 截止条件的内联拒绝策略，阻止与 IAM 用户关联的较早临时会话</p></li><li><p>通过附加内联全量拒绝策略来隔离 IAM 用户</p></li></ol><p>可在<a href=\"https://github.com/elastic/workflows/pull/117/changes#diff-da4b32ed5494cc940976aee0e310b259e27f7aa2770405a8ce50a2903a92a593\">此处</a>找到此工作流的一个示例。</p><h2 id=\"sec-13\"><strong>此次 AWS 入侵中观察到的 MITRE ATT&amp;CK 技术</strong></h2><p>这些活动映射到四种战术中的五种技术。</p><table><thead><tr><th><p>战术</p></th><th><p>技术</p></th><th><p>证据</p></th></tr></thead><tbody><tr><td><p>初始访问</p></td><td><p>T1078.004 有效账户：云账户</p></td><td><p>从外部 IP 使用的 IAM 用户和实例角色凭据</p></td></tr><tr><td><p>发现</p></td><td><p>T1087.004 账户发现：云账户</p></td><td><p>在 4 个账户中的 8 个身份上调用 GetCallerIdentity</p></td></tr><tr><td><p>凭据访问</p></td><td><p>T1552.005 不安全凭据：云实例元数据 API</p></td><td><p>针对用户数据的 58 次 DescribeInstanceAttribute 调用</p></td></tr><tr><td><p>凭据访问</p></td><td><p>T1555.006 来自密码存储的凭据：云密钥管理存储</p></td><td><p>带解密的 GetSecretValue 和 GetParameter</p></td></tr><tr><td><p>执行</p></td><td><p>T1651 云管理命令</p></td><td><p>SSM SendCommand</p></td></tr></tbody></table><h2 id=\"sec-14\"><strong>失陷指标（IOC）</strong></h2><p>同一个 /24 网段中的三个 IP 与 CyberStrikeAI 有关联，但只有第一个出现在我们的 AWS 遥测数据中。下面的行为指标比这些 IP 更持久，因为操作者可以更换服务器。</p><table><thead><tr><th><p>IP（去混淆形式）</p></th><th><p>是否出现在 AWS 遥测数据中</p></th><th><p>备注</p></th></tr></thead><tbody><tr><td><p>43[.]240[.]29[.]11</p></td><td><p>是，78 条告警</p></td><td><p>所有告警的来源。端口 8080 上使用自签名证书的 CyberStrikeAI Web 界面</p></td></tr><tr><td><p>43[.]240[.]29[.]28</p></td><td><p>本次调查未出现</p></td><td><p>端口 8080 上的 CyberStrikeAI 页面，其托管方（AS133199）、FOFA fid 和 TLS 证书均与 43[.]240[.]29[.]11 相同</p></td></tr><tr><td><p>43[.]240[.]29[.]33</p></td><td><p>本次调查未出现</p></td><td><p>端口 8080 上的 CyberStrikeAI 页面，其托管方（AS133199）、FOFA fid 和 TLS 证书均与 43[.]240[.]29[.]11 相同</p></td></tr></tbody></table><p>CyberStrikeAI 指纹。三个 IP 均提供相同的自签名证书，其序列号和公钥完全相同：</p><table><thead><tr><th><p>属性</p></th><th><p>值</p></th><th><p>类型</p></th></tr></thead><tbody><tr><td><p>页面标题</p></td><td><p>CyberStrikeAI</p></td><td><p>默认</p></td></tr><tr><td><p>服务端口</p></td><td><p>8080</p></td><td><p>默认</p></td></tr><tr><td><p>证书颁发者</p></td><td><p>CommonName CyberStrikeAI，organization 为空</p></td><td><p>默认</p></td></tr><tr><td><p>证书主体</p></td><td><p>CommonName CyberStrikeAI，organization 为空</p></td><td><p>默认</p></td></tr><tr><td><p>证书类型</p></td><td><p>自签名、不受信任、X.509 v3</p></td><td><p>默认</p></td></tr><tr><td><p>签名算法</p></td><td><p>ECDSA-SHA256</p></td><td><p>默认</p></td></tr><tr><td><p>公钥算法</p></td><td><p>ECDSA</p></td><td><p>默认</p></td></tr><tr><td><p>密钥用途</p></td><td><p>Digital Signature，并扩展密钥用途 Server Auth</p></td><td><p>默认</p></td></tr><tr><td><p>使用者备用名称</p></td><td><p>DNS localhost、IP 127.0.0.1 和 ::1</p></td><td><p>默认</p></td></tr><tr><td><p>序列号</p></td><td><p>3356730520974368630</p></td><td><p>共享</p></td></tr><tr><td><p>有效期</p></td><td><p>2026-09-15 04:13 UTC 至 2027-09-15 05:13 UTC</p></td><td><p>共享</p></td></tr><tr><td><p>公钥</p></td><td><p>见下方代码块</p></td><td><p>共享</p></td></tr></tbody></table><p>IP 地址：</p><ul><li><p>43[.]240[.]29[.]11</p></li><li><p>43[.]240[.]29[.]28</p></li><li><p>43[.]240[.]29[.]33</p></li></ul><p>证书序列号（三个 IP 均有）</p><ul><li><p>3356730520974368630</p></li></ul><p>证书 ECDSA 公钥（三个 IP 均有）</p><ul><li><p>45:FD:83:A2:38:2C:DD:70:2A:97:1D:E4:66:57:7D:E9:</p></li><li><p>B0:EA:41:48:80:8A:B9:D1:63:95:90:C5:1E:A7:04:94:</p></li><li><p>E3:21:7C:73:9F:EA:D2:29:3F:31:66:87:75:EC:BA:83:</p></li><li><p>23:59:CA:4D:D9:7E:C2:9A:FC:FE:7D:28:5A:31:1C:67</p></li></ul><p>可在 CloudTrail 中搜寻的行为指标：</p><ul><li><p>在某一角色会话中，每秒发出大量请求 userData 的 DescribeInstanceAttribute 调用。</p></li><li><p>同一分钟内，来自同一外部 IP 的多个账户或用户首次调用 GetCallerIdentity。</p></li><li><p>由实例角色会话发出的 GetSessionToken 或 GetSecretValue，而其源 IP 并非该实例或你的 NAT。</p></li><li><p>同一角色执行带解密的 GetParameter，随后一分钟内发出 SSM SendCommand。</p></li></ul><p>我们新增了两项高严重度、低误报的 ES|QL 检测规则，用于识别这种突发枚举行为：当一个主体和源 IP 在 10 分钟内从 20 个以上不同实例读取 userData 时，<a href=\"https://github.com/elastic/detection-rules/blob/main/rules/integrations/aws/discovery_ec2_bulk_user_data_enumeration.toml\">AWS EC2 Bulk User Data Enumeration</a> 会触发告警；当三个或以上不同的非角色身份在 10 分钟内从同一外部 IP 和 ASN 调用 GetCallerIdentity 时，<a href=\"https://github.com/elastic/detection-rules/blob/main/rules/integrations/aws/discovery_sts_getcalleridentity_bulk_account_enumeration.toml\">AWS STS GetCallerIdentity Bulk Account Enumeration</a> 会触发告警。</p><h2 id=\"sec-15\"><strong>如果你的 AWS 身份凭据已泄露，应如何响应</strong></h2><p>假定受影响角色能够读取的任何内容均已泄露，并以这些凭据为起点向外排查。</p><ol><li><p>轮换所有曾访问该指标 IP 的身份的凭据，并撤销活动会话，包括使用临时凭据创建的会话。</p></li><li><p>对于实例角色，应通过替换实例配置文件或实例来轮换凭据，因为被盗的角色凭据虽然会过期，但只要主机仍处于失陷状态，就可能被重新签发。</p></li><li><p>将 EC2 user data 中的所有机密都视为已泄露，并将其迁移到 Secrets Manager 或 Parameter Store。</p></li><li><p>审查 SSM 命令历史中任何异常 SendCommand 调用发生前后的时间段，以确定运行了什么。检查是否滥用了 AWS 托管文档、AWS-RunShellScript、AWS-RunPowerShellScript 或自定义文档。</p></li><li><p>检查非生产环境角色和机密与生产环境是否存在重叠。</p></li><li><p>在 WAF、VPC、NaCL 和安全组级别封禁该指标 IP，但同时应依赖行为检测规则，因为基础设施可能发生变化，而且网络封锁无法阻止被盗凭据调用 API。</p></li><li><p>使用 IAM 策略或服务控制策略，将 ec2:DescribeInstanceAttribute 对 userData 的访问权限限制为确有需要的角色。</p></li><li><p>如果尚未启用 GuardDuty，请予以启用，并对凭据从预期 IP 范围之外被使用的情况发出告警。</p></li><li><p>调查实例凭据是如何被获取的，首先检查暴露的 Web 应用程序、SSRF、代码存储库和 IMDS。</p></li></ol><h2 id=\"sec-16\">结论：此次入侵对告警关联意味着什么</h2><p>AI 辅助攻击由目标驱动，因此会产生大量告警。一台 CyberStrikeAI 服务器在 16 天内基于六条规则产生了 78 条告警，其中 65 条出现在第一天。每条告警单独看都属于中低严重度，而且看起来都很常规：首次调用 GetCallerIdentity、调用 GetSessionToken、由少见用户发出的 SSM SendCommand。只有共同的源 IP 表明它们属于同一次入侵。</p><p>防御人员需要高信号检测规则，以便尽早阻止破坏；上述两条批量枚举规则等低误报行为规则，能够为立即采取行动提供依据。中低严重度告警很适合进行关联，但只能依据源 IP 进行关联，而且关联时间窗口需要保持灵活，因为 AI 辅助活动并不规律。这里，56 个请求集中在 141 毫秒内，后续步骤相隔数小时至数天，操作者则在 14 天后再次返回。若采用固定的短时间窗口，这次入侵就会被拆分成彼此无关的告警。</p><p>高信号检测还可以推动修复工作。将规则附加到工作流（例如 <a href=\"https://github.com/elastic/workflows\">Elastic Workflows</a> 库中的工作流）后，此类规则可以自动阻断攻击，例如通过阻止来源 IP，同时让分析人员展开调查。</p><h2 id=\"sec-17\">参考资料</h2><ul><li><p>CyberStrikeAI：<a href=\"https://github.com/Ed1s0nZ/CyberStrikeAI\">https://github.com/Ed1s0nZ/CyberStrikeAI</a></p></li><li><p>Team Cymru，追踪 CyberStrikeAI 的使用情况：<a href=\"https://www.team-cymru.com/post/tracking-cyberstrikeai-usage\">https://www.team-cymru.com/post/tracking-cyberstrikeai-usage</a></p></li><li><p>Elastic Workflows：<a href=\"https://github.com/elastic/workflows\">https://github.com/elastic/workflows</a></p></li></ul><h2 id=\"sec-18\">关于 Elastic Security Labs</h2><p>Elastic Security Labs 是 Elastic Security 旗下专注于在威胁态势中创造积极改变的威胁情报分支。Elastic Security Labs 提供关于新兴威胁的公开研究，深入分析对手在战略、运营和战术层面的目标，随后将这些研究成果与 Elastic Security 内置的检测和响应能力相结合。</p><p>在 Twitter <a href=\"https://twitter.com/elasticseclabs\">@elasticseclabs</a> 上关注 Elastic Security Labs，并访问 <a href=\"https://www.elastic.co/security-labs/\">www.elastic.co/security-labs/</a> 查看我们的研究。</p>","original","zhKind","translation","complete","云原生","凭据","红队","AWS","Fortinet","https://www.elastic.co/security-labs/threat-command/cyberstrikeai-aws-cloudtrail-intrusion","Elastic Security Labs",{"_160":161,"_162":-5},"changelogVersion","2026-10-01T08:00","release"]
