[{"_1":2,"_3":4},"root",{"_5":113},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":37,"_59":60},"expiresAt",1795826446000,"id","nn1df6kue93w1afswhivjvdl3","title","攻击者利用 Hugging Face AI 网站生成器搭建 42 个钓鱼页面","originalTitle","Phishers Abuse Hugging Face's AI Site Builder to Spoof Big Brands","summary","Aikido Security 发现攻击者在 Hugging Face Spaces 托管 42 个钓鱼与凭据窃取页面，其中 29 个由平台内置的 AI 网站生成器 DeepSite 构建，仿冒 28 个品牌，包括 Microsoft、PayPal 和 Netflix。","reason","原文揭示了攻击者如何借 AI 网站生成器批量搭建仿冒页面，并给出可用于排查访问与账号处置的日志方向。","source",{"_76":112},"links",{"_103":111},"publishedAt","2026-11-26T12:30:00.000Z","discoveredAt","2026-11-26T12:42:24.704Z","timelineAt","category","activity","tags",[77,107,108,79,109,110],"score",73,"selected",true,"channel","news","story",{"_91":92,"_13":93},"x","readingMode","full","author","body",{"_60":102,"_103":-5,"_104":105,"_106":37},"outline",[94,95],"relatedStories",[90],"topics",[67,68,69,70,71,72,73],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","fRsVmVUftXVg","reportCount",2,"additionalSourceCount",1,{"_74":88,"_76":89},{"_74":86,"_76":87},{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","attack","name","攻击活动","ai-offense","AI 攻防","black-market","数据窃取与黑产","ransomware","勒索软件","email","邮件与钓鱼","identity","身份与访问","microsoft","Microsoft / 微软",{"_91":92,"_13":93},"publicId","a0ec7f9d-2c51-4af3-b8cc-cacbc02a8d2b","DeepSite 被用于批量制作钓鱼页",{"_11":100,"_97":101,"_99":64},{"_11":96,"_97":98,"_99":64},"sec-2","text","部分页面存续超过一年","level","sec-1","通过提示词构建的网络钓鱼页面","<p>\n\t攻击者已利用 Hugging Face 托管了数十个网络钓鱼页面，其中大多数使用该平台自带的 AI 网站构建器制作。</p><p>\n\tAikido Security 表示，其恶意软件扫描程序首次发现了一个包含虚假登录界面的 Jupyter notebook。其<a href=\"https://www.aikido.dev/blog/hugging-face-phishing-pages\">分析报告</a>发布于 11 月 24 日，并于 11 月 25 日更新，称一个 AI 代理随后于 10 月 16 日帮助定位了 Hugging Face Spaces 中的 42 个网络钓鱼和凭据窃取页面。</p><p>\n\tAikido 表示，其中 29 个页面带有 DeepSite 的特征，这些页面合计模仿了 28 个品牌，包括 Microsoft、PayPal 和 Netflix。</p><h2 id=\"sec-1\">\n\t<strong>通过提示词构建的网络钓鱼页面</strong></h2><p>\n\tDeepSite 是内置于 Hugging Face 的 AI 网站构建器，可将自然语言描述转换为已发布的网站。Aikido 发现了用六种语言编写的提示词：英语、法语、印地语、印尼语、葡萄牙语和俄语。一个虚假的 Microsoft 登录页面大约需要 90 分钟的提示词输入。</p><p>\n\t一些提示词要求生成旨在让页面避开搜索爬虫或安全扫描器的功能，而另一个提示词则要求拒绝首次输入的密码，以促使受害者再次输入。这些页面会索要密码、一次性代码、支付卡信息、电话号码和出生日期。</p><p>\n\t在这些页面中，25 个将窃取的数据发送给 Telegram 机器人，11 个发送给 Discord webhook，6 个发送给在线表单服务。许多页面还会在将访问者重定向到合法网站之前记录其 IP 地址。Aikido 没有访问者数据，因此无法确定有多少人输入了凭据。</p><p>\n\t<em><a href=\"https://www.infosecurity-magazine.com/news/new-phaas-uses-ai-phishing-lures/\">进一步了解 AI 辅助的网络钓鱼：新型 PhaaS 平台利用 AI 制作网络钓鱼诱饵并掩盖恶意活动</a></em></p><h2 id=\"sec-2\">\n\t<strong>部分页面存续超过一年</strong></h2><p>\n\t在这 42 个页面中，23 个早在一年多以前就已发布，16 个发布于六至十二个月前，3 个发布于过去三个月内，其中最早的是 2025 年 4 月。Aikido 警告称，这只能说明页面存在了多长时间，并不能说明它们捕获受害者多长时间。</p><p>\n\tAikido 表示，它在发现这些页面的当天便通知了 Hugging Face。截至 10 月 29 日，每个页面都已被暂停或无法再公开访问；在 Aikido 发布相关内容时，没有任何页面仍在为受害者提供服务。<em>Infosecurity</em> 已联系 Hugging Face 寻求置评，并将在收到任何回应后更新本文。</p><p>\n\tAikido 建议防御人员检查电子邮件网关、DNS 和代理日志，查找对这些页面的访问；对于任何命中记录，都应重置密码、终止所有会话并审查登录情况，因为双因素身份验证 (2FA) 可能无法阻止账户被接管。</p><p>\n\tAikido 安全工程师 Hunter Schwartz 在技术分析中警告：“可信平台上的登录页面并不能证明该页面是真实的。”</p><p>\n\t对于平台，Aikido 建议在页面发布时进行筛查，识别并处理任何收集登录信息并将其转发到消息服务的页面。</p>","original","zhKind","translation","complete","钓鱼","数据窃取","凭据","Microsoft","https://www.infosecurity-magazine.com/news/hugging-face-ai-builder-phishing/","Infosecurity Magazine",{"_114":115,"_116":-5},"changelogVersion","2026-10-01T08:00","release"]
