[{"_1":2,"_3":4},"root",{"_5":147},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795826447000,"id","ougur29x6priknjuve15twubc","title","ELF DT_RELR 压缩重定位导致 objdump -R 审计盲区分析与绕过","originalTitle","ELF DT_RELR 压缩重定位导致 objdump 审计盲区分析与绕过","summary","研究复现了 GNU 与 LLVM 的 objdump -R 不展开 DT_RELR 的审计盲区：样本 librelr.so 含 11 个动态重定位目标，objdump -R 仅报告 7 个。","reason","文章用可复现实验揭示了只枚举显式重定位表的审计盲区，并给出覆盖 DT_RELA、DT_JMPREL、DT_RELR 的修复方法。","source",{"_72":146},"links",{"_139":145},"publishedAt","2026-11-25T02:59:10.000Z","discoveredAt","2026-11-26T09:40:21.099Z","timelineAt","category","disclosure","tags",[75,142,143,144],"score",72,"selected",true,"channel","news","story",{"_77":78,"_13":79},"x","readingMode","full","author","body",{"_61":138,"_139":-5,"_140":139,"_141":37},"outline",[80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97],"relatedStories",[76],"topics",[68,69],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fxqlVW0zMlnk","reportCount",1,"additionalSourceCount",0,{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","tools","name","工具与平台","research","技术研究",{"_77":78,"_13":79},"publicId","1a63f363-9d2c-4bbc-bad9-026319896627","objdump -R 不展开 DT_RELR 造成重定位审计盲区",{"_11":136,"_99":137,"_101":119},{"_11":134,"_99":135,"_101":119},{"_11":132,"_99":133,"_101":119},{"_11":130,"_99":131,"_101":119},{"_11":128,"_99":129,"_101":119},{"_11":126,"_99":127,"_101":119},{"_11":124,"_99":125,"_101":119},{"_11":122,"_99":123,"_101":119},{"_11":120,"_99":121,"_101":119},{"_11":117,"_99":118,"_101":119},{"_11":115,"_99":116,"_101":102},{"_11":113,"_99":114,"_101":102},{"_11":111,"_99":112,"_101":102},{"_11":109,"_99":110,"_101":102},{"_11":107,"_99":108,"_101":102},{"_11":105,"_99":106,"_101":102},{"_11":103,"_99":104,"_101":102},{"_11":98,"_99":100,"_101":102},"sec-18","text","relr_static.c","level",3,"sec-17","relr_data.c","sec-16","relr_many.c","sec-15","relr_gate.py","sec-14","relr_scan.py","sec-13","relr_mem.c","sec-12","relr_use.c","sec-11","relr_lib.c","sec-10","附录：源码",2,"sec-9","九、结论","sec-8","八、攻击者视角","sec-7","七、修复：让审计枚举所有动态重定位来源","sec-6","六、根因","sec-5","五、把盲区穷举成矩阵","sec-4","四、机制：位图怎么展开，工具怎么失明","sec-3","三、取证视角：四个地址，六种看法","sec-2","二、从一次加载看完整链路","sec-1","一、RELR 是什么：从 11 和 7 的差说起","<h2 id=\"sec-1\">一、RELR 是什么：从 11 和 7 的差说起</h2><p>ELF 的动态重定位有几套并存的表示：</p><ul><li><p><code>DT_RELA</code>：显式的 <code>Elf64_Rela</code> 数组，每个条目 24 字节，写清 offset、type、addend。</p></li><li><p><code>DT_REL</code>：32 位时代的显式数组，每个条目 16 字节。</p></li><li><p><code>DT_JMPREL</code>：PLT 的跳转槽重定位，单独一张表。</p></li><li><p><code>DT_RELR</code>：只针对相对重定位的压缩表示，每个条目 8 字节，用“基址 + 位图”描述一批地址。</p></li></ul><p>RELR 的存在理由很直接：PIE、静态 PIE、C++ 虚表、函数指针表会产生大量相对重定位，每个都写 24 字节的 <code>Elf64_Rela</code> 太浪费。一个 <code>DT_RELR</code> 条目能干两件事：偶数条目是一个要重定位的地址；奇数条目是一张 64 位位图，bit 0 是标记位，bit 1 到 bit 63 对应基址开始的 63 个 8 字节槽位。一个位图覆盖 63 个地址，基址再前进 <code>63 * 8</code> 字节。</p><p>拿<code>librelr.so</code> 举例，<code>readelf -d</code> 能看到三组标签：</p><pre><code>$ readelf -dW librelr.so | grep -E 'RELR|RELA|INIT_ARRAY|FINI_ARRAY'</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125110615-2d70c0ee-e87d-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=57ca6ff07685b86e\" loading=\"lazy\" decoding=\"async\" width=\"977.2727325681813\" height=\"311\"></p><p><code>DT_RELR</code> 在 <code>0x538</code>，大小 24 字节，条目宽度 8 字节。24 字节就是 3 个条目。</p><p><code>readelf -r</code> 把这三个条目展开成 4 个地址：</p><pre><code>$ readelf -rW librelr.so</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125110616-2dd072c1-e87d-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=bb6203e1ae16dc3f\" loading=\"lazy\" decoding=\"async\" width=\"1348.2142930197251\" height=\"517\"></p><p>6 个显式 RELA，1 个 PLT，4 个 RELR 地址，一共 11 个。4 个 RELR 地址是 <code>0x3dc0</code>、<code>0x3dc8</code>、<code>0x3dd0</code>、<code>0x4008</code>。</p><p>再把同一份文件交给 <code>objdump -R</code>：</p><pre><code>$ objdump -RW librelr.so | sed -n '/DYNAMIC RELOCATION RECORDS/,$p'</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125110616-2e16c3ea-e87d-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=3d33bdf4a40ab107\" loading=\"lazy\" decoding=\"async\" width=\"1000.8116937346906\" height=\"282\"></p><p>7 个。<code>0x3dc0</code>、<code>0x3dc8</code>、<code>0x3dd0</code>、<code>0x4008</code> 一个都没有。</p><p>最反直觉的一点不在“少了 4 个”，而在少掉的这 4 个刚好是加载器真正会写、而且写的是函数指针的 4 个地址。<code>0x3dc0</code> 和 <code>0x3dc8</code> 是 <code>.init_array</code> 的两个槽位，<code>0x3dd0</code> 是 <code>.fini_array</code> 的槽位，<code>0x4008</code> 是 <code>__dso_handle</code>。</p><p>文件里 <code>.init_array</code> 长这样：</p><pre><code>$ readelf -x .init_array librelr.so</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125110617-2e5498d2-e87d-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=6831b333ec3a1b3d\" loading=\"lazy\" decoding=\"async\" width=\"840.0974071495579\" height=\"153\"></p><p>两个 8 字节槽位，分别是 <code>0x1100</code> 和 <code>0x1129</code>，都是链接期地址，不是零。<code>0x1100</code> 是 <code>frame_dummy</code>，<code>0x1129</code> 是本文样本里的 <code>lib_init</code>。加载器在运行时把加载基址加上去：</p><pre><code>$ setarch $(uname -m) -R ./relr_use ./librelr.so</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125110617-2e8b2a4f-e87d-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=362151864692387d\" loading=\"lazy\" decoding=\"async\" width=\"634.7402631796659\" height=\"178\"></p><p><code>init_off=0x1129</code> 和文件里第二个槽位的值完全对上。<code>CTOR RAN</code> 说明构造函数确实执行了，<code>ctor_ran=1</code> 说明它真的把状态改了。但在 <code>objdump -R</code> 的 7 行输出里，没有任何一行指向 <code>0x3dc8</code>。</p><p>同一份文件，加载器写了 11 个地址，<code>objdump -R</code> 只报告 7 个。差的 4 个，两个是构造函数/析构函数指针，一个是 DSO 句柄。</p><h2 id=\"sec-2\">二、从一次加载看完整链路</h2><p>目录：</p><pre><code>/root/relr-lab\n├── relr_lib.c\n├── relr_use.c\n├── relr_mem.c\n├── relr_scan.py\n├── relr_gate.py\n├── relr_many.c\n├── relr_data.c\n└── relr_static.c</code></pre><p><code>relr_lib.c</code> 是一个带构造函数的共享库，核心只有几行：</p><pre><code>int ext = 7;\nint *p1 = &amp;ext;\nint *p2 = &amp;ext;\n\n__attribute__((noinline)) static void ctor(void)\n{\n    static const char msg[] = \"CTOR RAN\\n\";\n    write(1, msg, sizeof(msg) - 1);\n}\n\n__attribute__((constructor)) static void lib_init(void)\n{\n    ctor();\n}</code></pre><p><code>p1</code>、<code>p2</code> 指向可被外部符号插入的 <code>ext</code>，链接器会给它们生成显式的 <code>R_X86_64_64</code>，留在 <code>.rela.dyn</code> 里。<code>lib_init</code> 是本地函数，它的 <code>.init_array</code> 槽位是相对重定位，正好是 RELR 的压缩对象。</p><p><code>relr_use.c</code> 负责 <code>dlopen</code>、打印构造函数状态、拿到加载基址：</p><pre><code>void *h = dlopen(path, RTLD_NOW | RTLD_LOCAL);\nint (*get_ran)(void) = (int (*)(void))dlsym(h, \"get_ctor_ran\");\nvoid *(*get_addr)(void) = (void *(*)(void))dlsym(h, \"get_init_addr\");\ndl_iterate_phdr(cb, NULL);\nprintf(\"ctor_ran=%d\\n\", get_ran ? get_ran() : -1);\nprintf(\"init_addr=%p\\n\", get_addr ? get_addr() : NULL);\nprintf(\"lib_base=%p\\n\", (void *)lib_base);\nprintf(\"init_off=0x%lx\\n\", (unsigned long)((uintptr_t)get_addr() - lib_base));</code></pre><p><code>relr_mem.c</code> 更直接：给定库名和一个节内偏移，<code>dlopen</code> 之后读那个槽位，打印值和“值相对加载基址的偏移”。</p><p>编译命令：</p><pre><code>$ gcc -O0 -shared -fPIC -Wl,-z,pack-relative-relocs -o librelr.so relr_lib.c\n$ gcc -O0 -shared -fPIC -o librela.so relr_lib.c\n$ gcc -O0 -o relr_use relr_use.c -ldl\n$ gcc -O0 -o relr_mem relr_mem.c -ldl</code></pre><p>第一条带 <code>-Wl,-z,pack-relative-relocs</code>，让链接器把相对重定位压进 <code>DT_RELR</code>。第二条不带，得到一份全部走 <code>.rela.dyn</code> 的对照库 <code>librela.so</code>。</p><p>第一步，看动态标签。<code>DT_RELR</code>、<code>DT_RELRSZ</code>、<code>DT_RELRENT</code> 三个标签同时出现，说明这份文件里有压缩重定位。前面已经贴过输出，这里只记结论：<code>DT_RELR=0x538</code>，<code>DT_RELRSZ=24</code>，<code>DT_RELRENT=8</code>。</p><p>第二步，看 <code>readelf -r</code>。<code>.relr.dyn</code> 三个条目展开成四个地址：<code>0x3dc0</code>、<code>0x3dc8</code>、<code>0x3dd0</code>、<code>0x4008</code>。<code>readelf</code> 还把每个地址配了一个“Symbolic Address”。这里有一个容易踩的坑：<code>0x3dc8</code> 那一行写的是 <code>__frame_dummy_init_array_entry + 0x8</code>，看起来像 <code>frame_dummy</code> 的尾巴，实际槽位里存的是 <code>lib_init</code> 的地址 <code>0x1129</code>。<code>readelf</code> 解析的是“槽位地址落在哪个符号里”，不是“槽位里的值指向哪个符号”。这两个不是一回事。</p><p>第三步，看 <code>objdump -R</code>。7 行，四个 RELR 地址全部缺席。<code>objdump -R</code> 枚举的是 <code>.rela.dyn</code>、<code>.rel.dyn</code>、<code>.rela.plt</code> 这些显式表，<code>DT_RELR</code> 是一条动态标签加一段位图，不在它的枚举路径里。</p><p>第四步，看文件里的 <code>.init_array</code>。<code>0x1100</code> 和 <code>0x1129</code>，两个链接期地址，不是零。一个只读文件、不加重定位的扫描器，会把 <code>0x1129</code> 当成一个绝对指针；这个地址在没有加载基址的情况下根本不在任何映射里。但加载器知道它该加什么。</p><p>第五步，跑起来：</p><pre><code>$ setarch $(uname -m) -R ./relr_use ./librelr.so</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125110617-2ec352eb-e87d-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=1b65dc3d57d9bae3\" loading=\"lazy\" decoding=\"async\" width=\"603.0844188522913\" height=\"189\"></p><p><code>setarch -R</code> 关掉 ASLR，所以两次运行得到同一组地址。<code>0x7ffff7fba129 - 0x7ffff7fb9000 = 0x1129</code>，和文件里的第二个槽位一致。</p><p>第六步，直接读运行时槽位：</p><pre><code>$ setarch $(uname -m) -R ./relr_mem ./librelr.so 3dc8</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125110618-2efc6acc-e87d-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=3c0dffb4b6acc0a6\" loading=\"lazy\" decoding=\"async\" width=\"1079.5454603950839\" height=\"114\"></p><p><code>value_off=0x1129</code>，就是 <code>lib_init</code>。同一个工具读 <code>0x3dd0</code> 和 <code>0x4008</code>：</p><pre><code>$ setarch $(uname -m) -R ./relr_mem ./librelr.so 3dd0\n\n$ setarch $(uname -m) -R ./relr_mem ./librelr.so 4008</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125110618-2f3f1158-e87d-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=07994f87956878ad\" loading=\"lazy\" decoding=\"async\" width=\"1098.2142916650741\" height=\"224\"></p><p><code>0x3dd0</code> 的 <code>value_off=0x10c0</code> 是 <code>__do_global_dtors_aux</code>；<code>0x4008</code> 的 <code>value_off=0x4008</code> 是 <code>__dso_handle</code> 指向自己。</p><p>把这条链拆开看，一共五步：</p><ol><li><p>链接器把 <code>lib_init</code> 的 <code>.init_array</code> 槽位、<code>__do_global_dtors_aux</code> 的 <code>.fini_array</code> 槽位、<code>__dso_handle</code> 的相对重定位压缩成 <code>DT_RELR</code> 位图。</p></li><li><p>动态段里留下 <code>DT_RELR=0x538</code>、<code>DT_RELRSZ=24</code>、<code>DT_RELRENT=8</code>。</p></li><li><p>加载器展开位图，得到四个地址。</p></li><li><p>加载器把“加载基址 + 文件里的链接期地址”写进这四个槽位。</p></li><li><p>构造函数从 <code>.init_array</code> 被调用，打印 <code>CTOR RAN</code>。</p></li></ol><p>审计侧看到的却是另一条链：<code>objdump -R</code> 枚举显式表，得到 7 个地址，没有 <code>0x3dc8</code>，于是 gate 判 PASS。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125110619-2f76acd3-e87d-1.svg&amp;mode=full&amp;exp=1796083200&amp;sig=85adbdace9c88e88\" loading=\"lazy\" decoding=\"async\" width=\"691\"></p><p>这一步证明的是：加载器写的地址集合和 <code>objdump -R</code> 报告的地址集合不是同一个集合；少的 4 个不是随机的，正好是 <code>init_array</code>、<code>fini_array</code> 和 <code>__dso_handle</code>。</p><h2 id=\"sec-3\">三、取证视角：四个地址，六种看法</h2><p>同一个文件，从六个角度看，会得到六组不同的“事实”。</p><p><strong>动态标签视角。</strong> <code>readelf -d</code> 告诉你 <code>DT_RELR</code> 存在，大小 24 字节，条目 8 字节。它不告诉你四个地址分别是什么，但它是第一个信号：这份文件用了压缩重定位。</p><p><strong>重定位表视角。</strong> <code>readelf -r</code> 把位图展开成四个地址，并且给每个地址配一个符号。这个视角最完整，但有一个符号解析的坑：<code>Symbolic Address</code> 列写的是槽位地址的符号，不是槽位里的值。<code>0x3dc8</code> 那一行是 <code>__frame_dummy_init_array_entry + 0x8</code>，实际值是 <code>lib_init</code>。要确认这一点，得再看符号表：</p><pre><code>$ readelf -sW librelr.so | grep -E 'lib_init|frame_dummy'</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125110619-2fb31723-e87d-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=e782efeb9c4cdf63\" loading=\"lazy\" decoding=\"async\" width=\"1021.9155899529404\" height=\"135\"></p><p><code>lib_init</code> 在 <code>0x1129</code>，和 <code>.init_array</code> 第二个槽位的值一致。<code>readelf -r</code> 的符号列只是把槽位地址 <code>0x3dc8</code> 归到了 <code>0x3dc0</code> 那个数组符号的 <code>+0x8</code> 上。</p><p><strong>objdump 视角。</strong> <code>objdump -R</code> 只给 7 个地址。它不会提示“还有 4 个在 DT_RELR 里”，也不会在输出末尾写一句“RELR not shown”。这是一次静默的省略。</p><p><strong>文件字节视角。</strong> <code>readelf -x .init_array</code> 显示 <code>0x1100</code> 和 <code>0x1129</code>。这两个值是链接期地址，不是运行时地址。一个把文件值当绝对指针的扫描器，会把 <code>0x1129</code> 当成一个无效地址；一个只看节内容的审计，会认为这里“有两个看起来像代码地址的值”，但不知道它们会在加载时被改写。</p><p><strong>运行时视角。</strong> <code>relr_mem</code> 读 <code>0x3dc8</code>，得到 <code>base+0x1129</code>。这是唯一能直接证明“加载器确实写了这个槽位”的视角。</p><p><strong>LLVM 视角。</strong> LLVM 的 <code>llvm-readelf</code> 和 GNU readelf 一样能看到 <code>.relr.dyn</code>：</p><pre><code>$ llvm-readelf -r librelr.so | sed -n '/.relr.dyn/,$p'</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125110619-2fefeebd-e87d-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=9538c726a60b1707\" loading=\"lazy\" decoding=\"async\" width=\"933.4415634995087\" height=\"195\"></p><p>但 LLVM 的 <code>llvm-objdump -R</code> 和 GNU objdump 一样只给 7 个：</p><pre><code>$ llvm-objdump -R librelr.so | grep -cE '^[0-9a-f]{16}'</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125110620-3024c959-e87d-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=84af307df8eb4588\" loading=\"lazy\" decoding=\"async\" width=\"654.2207827657426\" height=\"98\"></p><pre><code>$ python3 relr_scan.py librelr.so | grep -E 'DT_RELR|DT_RELA|DT_JMPREL|all dynamic|objdump -R offsets|targets missing'</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125110620-3065a8e1-e87d-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=a7e0f84fba805075\" loading=\"lazy\" decoding=\"async\" width=\"1339.2857215427734\" height=\"236\"></p><p>缺的 4 个是 <code>0x3dc0</code>、<code>0x3dc8</code>、<code>0x3dd0</code>、<code>0x4008</code>。<code>relr_scan.py</code> 的完整模式把三张表合成一个集合，<code>objdump -R</code> 只给显式表，差值就是 RELR 的地址。</p><p>这不是 GNU 一家的问题，也不是 readelf 一家的问题。<code>readelf</code> 这一支（GNU 和 LLVM）都能展开 <code>DT_RELR</code>，<code>objdump</code> 这一支（GNU 和 LLVM）都只枚举显式表。分界线在工具的实现路径，不在编译器或发行版。</p><p>把六个视角压成一张证据表：</p><table><tbody><tr><td colspan=\"1\" rowspan=\"1\"><p>顺序</p></td><td colspan=\"1\" rowspan=\"1\"><p>行为</p></td><td colspan=\"1\" rowspan=\"1\"><p>可观察证据</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>1</p></td><td colspan=\"1\" rowspan=\"1\"><p>链接器把四个相对重定位压成三个 RELR 条目</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>DT_RELR=0x538</code>、<code>DT_RELRSZ=24</code>、<code>DT_RELRENT=8</code>；<code>readelf -r</code> 显示 3 entries relocate 4 locations</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>2</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>objdump -R</code> 只枚举显式表</p></td><td colspan=\"1\" rowspan=\"1\"><p>7 个 offset；<code>0x3dc0</code>、<code>0x3dc8</code>、<code>0x3dd0</code>、<code>0x4008</code> 缺席</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>3</p></td><td colspan=\"1\" rowspan=\"1\"><p>文件里的 <code>.init_array</code> 存链接期地址</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>readelf -x</code> 显示 <code>0x1100</code>、<code>0x1129</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>4</p></td><td colspan=\"1\" rowspan=\"1\"><p>加载器按位图写入</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>relr_mem</code> 读到 <code>value_off=0x1129</code>、<code>0x10c0</code>、<code>0x4008</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>5</p></td><td colspan=\"1\" rowspan=\"1\"><p>构造函数执行</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>CTOR RAN</code>、<code>ctor_ran=1</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>6</p></td><td colspan=\"1\" rowspan=\"1\"><p>只读 <code>objdump -R</code> 的 gate 放行</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>RESULT: PASS</code></p></td></tr></tbody></table><p>六条证据互相印证：<code>readelf -r</code> 的四个地址、<code>objdump -R</code> 缺的四个地址、运行时读到的三个 <code>value_off</code>、<code>readelf -x</code> 的两个文件值，四组数据能一一对上。不是某一个工具的输出异常，是加载器和工具对“重定位集合”的定义不同。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125110620-309dabc2-e87d-1.svg&amp;mode=full&amp;exp=1796083200&amp;sig=8514b7534f8b18b8\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125110620-309dabc2-e87d-1.svg&amp;mode=thumb&amp;exp=1796083200&amp;sig=1d6053b45d6fde27 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125110620-309dabc2-e87d-1.svg&amp;mode=image-1200&amp;exp=1796083200&amp;sig=469839b42fda96c3 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125110620-309dabc2-e87d-1.svg&amp;mode=full&amp;exp=1796083200&amp;sig=8514b7534f8b18b8 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"864\"></p><h2 id=\"sec-4\">四、机制：位图怎么展开，工具怎么失明</h2><p><strong>加载器眼里的重定位。</strong> 加载器不区分“显式”和“压缩”，它按动态标签把三类表都跑一遍：<code>DT_RELA</code>（加上 <code>DT_JMPREL</code>）是显式数组，<code>DT_RELR</code> 是位图。位图的展开规则只有四条：</p><ol><li><p>偶数条目：这个地址本身要被重定位；把基址设为 <code>entry + 8</code>。</p></li><li><p>奇数条目：低 bit 0 是标记位，bit 1 到 bit 63 是位图。</p></li><li><p>bit <code>i</code>（<code>i</code> 从 1 到 63）为 1，表示 <code>base + (i - 1) * 8</code> 要被重定位。</p></li><li><p>一张位图处理完，<code>base += 63 * 8</code>。</p></li></ol><p>把 <code>librelr.so</code> 的三个条目展开一遍：</p><pre><code>entry 0: 0x3dc0        偶数 -&gt; 重定位 0x3dc0,base = 0x3dc8\nentry 1: 0x7           奇数 -&gt; bit 1、bit 2 -&gt; 0x3dc8、0x3dd0,base = 0x3fc0\nentry 2: 0x401         奇数 -&gt; bit 10      -&gt; 0x4008</code></pre><p>和 <code>readelf -r</code> 的四个地址完全一致。<code>relr_scan.py</code> 里的展开循环就是这四条的直译：</p><pre><code>base = 0\nfor entry in entries:\n    if entry &amp; 1 == 0:\n        addrs.append(entry)\n        base = entry + 8\n    else:\n        for bit in range(1, 64):\n            if entry &amp; (1 &lt;&lt; bit):\n                addrs.append(base + (bit - 1) * 8)\n        base += 63 * 8</code></pre><p>一个位图覆盖 63 个地址，所以 100 个函数指针的数组只需要两个位图，加上基址条目一共几个 8 字节条目。<code>librelr_many.so</code> 的 <code>.relr.dyn</code> 是 4 个条目、32 字节，展开成 103 个地址；如果这 103 个地址都写成 <code>R_X86_64_RELATIVE</code> 的 <code>Elf64_Rela</code>，光重定位表就要 <code>103 * 24 = 2472</code> 字节。省下来的空间不是一点。</p><p><strong>readelf 眼里的重定位。</strong> <code>readelf -r</code> 有专门的 <code>.relr.dyn</code> 处理路径，会把位图展开成地址列表，还会给每个地址配符号。它的输出格式在不同版本里基本稳定：GNU 2.47 给 <code>entries which relocate N locations</code>，LLVM 的 <code>llvm-readelf</code> 给 <code>contains 4 entries</code>；两家都能给出 <code>Index/Entry/Address/Symbolic Address</code> 这几列。但它有一个语义坑：<code>Symbolic Address</code> 解析的是槽位地址，不是槽位里的值。<code>__frame_dummy_init_array_entry + 0x8</code> 这种写法，会让人以为写入的是 <code>frame_dummy</code>，实际是 <code>lib_init</code>。</p><p><strong>objdump 眼里的重定位。</strong> <code>objdump -R</code> 走的是另一条路径：它向 BFD 要“动态重定位记录”，BFD 按 <code>.rela.dyn</code>、<code>.rel.dyn</code>、<code>.rela.plt</code> 这些 <code>Elf_Rela</code>/<code>Elf_Rel</code> 节枚举。<code>DT_RELR</code> 不是这样的节，它是一段位图，只有显式展开才能变成地址列表。<code>objdump -R</code> 没有这一步，所以它给出的 7 个地址不是“错误的地址”，而是“另一个集合”：显式表的集合。</p><p><strong>自写解析器眼里的重定位。</strong> 很多人写审计脚本时，会照着 <code>DT_RELA</code> 的循环抄一遍：读 <code>DT_RELA</code>、<code>DT_RELASZ</code>、<code>DT_RELAENT</code>，按 24 字节步进，读 <code>r_offset</code>。这段代码对 <code>librelr.so</code> 只会得到 6 个地址。再加上 <code>DT_JMPREL</code> 的 1 个，一共 7 个。正好等于 <code>objdump -R</code> 的 7 个。这不是巧合：它们读的是同一套显式表。</p><p><strong>审计 gate 眼里的重定位。</strong> 一个典型的静态 gate 会做两件事：拿 <code>objdump -R</code> 的 offset 列表，拿 <code>readelf -SW</code> 的 <code>.init_array</code>/<code>.fini_array</code> 地址范围，判断有没有重定位落在这些范围里。对 <code>librelr.so</code>，<code>objdump -R</code> 的 7 个 offset 没有一个落在 <code>[0x3dc0, 0x3dd0)</code> 或 <code>[0x3dd0, 0x3dd8)</code> 里，于是 gate 判 PASS。它不知道 <code>DT_RELR</code> 里还有四个地址。</p><p><strong>这里容易混淆的是</strong>：<code>readelf -d</code> 看到 <code>DT_RELR</code> 标签，不等于 <code>objdump -R</code> 能看到 <code>DT_RELR</code> 的条目；<code>readelf -r</code> 看到 <code>.relr.dyn</code>，不等于审计 gate 会把它算进“重定位集合”。标签、节、条目、地址，是四个不同层次的东西。</p><p>把机制收敛成一句话：<strong>RELR 把“要改哪些地址”从显式列表变成了“基址 + 位图”，加载器按位图展开，只读显式列表的消费者就看不到这些地址。</strong></p><p>这个框架能迁移到任何“同一语义、多种表示、不同消费者各读一套”的地方：</p><ul><li><p>符号表：<code>.symtab</code>、<code>.dynsym</code>、GNU hash 是三套表示，只读 <code>.dynsym</code> 的工具看不到本地符号。</p></li><li><p>重定位：<code>DT_RELA</code>、<code>DT_REL</code>、<code>DT_RELR</code>、<code>DT_JMPREL</code> 是四套表示，只读其中一套就会漏。</p></li><li><p>调试信息：压缩的 <code>.debug_*</code> 和未压缩的节，工具支持程度不同。</p></li><li><p>PE 的 base relocation、Mach-O 的 chained fixups，也是“压缩表示 + 消费者滞后”的同类问题。</p></li></ul><p>盲区成立的充要条件也只有四条：</p><ol><li><p>链接器把相对重定位压进了 <code>DT_RELR</code>（<code>-z pack-relative-relocs</code> 或默认开启）。</p></li><li><p>审计工具只枚举 <code>DT_RELA</code>，或者只用 <code>objdump -R</code>，不展开 <code>DT_RELR</code>。</p></li><li><p>被隐藏的目标是安全相关的：<code>init_array</code>、<code>fini_array</code>、GOT、<code>.data.rel.ro</code> 里的函数指针。</p></li><li><p>审计结论被用来放行或拦截，而不是仅仅打印给人看。</p></li></ol><p>四条同时成立，gate 就会在“看起来没有异常重定位”的二进制上放行一个构造函数。</p><h2 id=\"sec-5\">五、把盲区穷举成矩阵</h2><p>先把工具矩阵摆出来。同一份 <code>librelr.so</code>，不同消费者看到的地址数：</p><table><tbody><tr><td colspan=\"1\" rowspan=\"1\"><p>消费者</p></td><td colspan=\"1\" rowspan=\"1\"><p>RELA</p></td><td colspan=\"1\" rowspan=\"1\"><p>JMPREL</p></td><td colspan=\"1\" rowspan=\"1\"><p>RELR</p></td><td colspan=\"1\" rowspan=\"1\"><p>合计</p></td><td colspan=\"1\" rowspan=\"1\"><p>结论</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>GNU readelf 2.47</p></td><td colspan=\"1\" rowspan=\"1\"><p>6</p></td><td colspan=\"1\" rowspan=\"1\"><p>1</p></td><td colspan=\"1\" rowspan=\"1\"><p>4</p></td><td colspan=\"1\" rowspan=\"1\"><p>11</p></td><td colspan=\"1\" rowspan=\"1\"><p>看到全部</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>LLVM readelf</p></td><td colspan=\"1\" rowspan=\"1\"><p>6</p></td><td colspan=\"1\" rowspan=\"1\"><p>1</p></td><td colspan=\"1\" rowspan=\"1\"><p>4</p></td><td colspan=\"1\" rowspan=\"1\"><p>11</p></td><td colspan=\"1\" rowspan=\"1\"><p>看到全部</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>GNU objdump 2.47</p></td><td colspan=\"1\" rowspan=\"1\"><p>6</p></td><td colspan=\"1\" rowspan=\"1\"><p>1</p></td><td colspan=\"1\" rowspan=\"1\"><p>0</p></td><td colspan=\"1\" rowspan=\"1\"><p>7</p></td><td colspan=\"1\" rowspan=\"1\"><p>漏 4</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>LLVM objdump</p></td><td colspan=\"1\" rowspan=\"1\"><p>6</p></td><td colspan=\"1\" rowspan=\"1\"><p>1</p></td><td colspan=\"1\" rowspan=\"1\"><p>0</p></td><td colspan=\"1\" rowspan=\"1\"><p>7</p></td><td colspan=\"1\" rowspan=\"1\"><p>漏 4</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>只读 DT_RELA 的解析器</p></td><td colspan=\"1\" rowspan=\"1\"><p>6</p></td><td colspan=\"1\" rowspan=\"1\"><p>1</p></td><td colspan=\"1\" rowspan=\"1\"><p>0</p></td><td colspan=\"1\" rowspan=\"1\"><p>7</p></td><td colspan=\"1\" rowspan=\"1\"><p>漏 4</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>relr_scan.py</code> 完整模式</p></td><td colspan=\"1\" rowspan=\"1\"><p>6</p></td><td colspan=\"1\" rowspan=\"1\"><p>1</p></td><td colspan=\"1\" rowspan=\"1\"><p>4</p></td><td colspan=\"1\" rowspan=\"1\"><p>11</p></td><td colspan=\"1\" rowspan=\"1\"><p>看到全部</p></td></tr></tbody></table><p>这不是“某个工具不支持”的问题。GNU 2.47 的 <code>readelf</code> 能看到，<code>objdump</code> 看不到；LLVM 的 <code>readelf</code> 能看到，<code>objdump</code> 看不到。分界线是 readelf 与 objdump 的实现路径，不是版本新旧。</p><p>再看变体矩阵。每个变体都用同一套源码、同一组命令，只换链接参数或后处理：</p><table><tbody><tr><td colspan=\"1\" rowspan=\"1\"><p>变体</p></td><td colspan=\"1\" rowspan=\"1\"><p>构造</p></td><td colspan=\"1\" rowspan=\"1\"><p>动态目标</p></td><td colspan=\"1\" rowspan=\"1\"><p>objdump -R</p></td><td colspan=\"1\" rowspan=\"1\"><p>缺失</p></td><td colspan=\"1\" rowspan=\"1\"><p>运行时</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>librelr.so</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>-z pack-relative-relocs</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>11（RELR 4）</p></td><td colspan=\"1\" rowspan=\"1\"><p>7</p></td><td colspan=\"1\" rowspan=\"1\"><p>4</p></td><td colspan=\"1\" rowspan=\"1\"><p>构造函数执行</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>librela.so</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>不带 RELR</p></td><td colspan=\"1\" rowspan=\"1\"><p>11（RELR 0）</p></td><td colspan=\"1\" rowspan=\"1\"><p>11</p></td><td colspan=\"1\" rowspan=\"1\"><p>0</p></td><td colspan=\"1\" rowspan=\"1\"><p>构造函数执行</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>librelr_many.so</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>100 个函数指针</p></td><td colspan=\"1\" rowspan=\"1\"><p>107（RELR 103）</p></td><td colspan=\"1\" rowspan=\"1\"><p>4</p></td><td colspan=\"1\" rowspan=\"1\"><p>103</p></td><td colspan=\"1\" rowspan=\"1\"><p>无构造函数</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>librelr_data.so</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>20 个静态数据指针</p></td><td colspan=\"1\" rowspan=\"1\"><p>27（RELR 23）</p></td><td colspan=\"1\" rowspan=\"1\"><p>4</p></td><td colspan=\"1\" rowspan=\"1\"><p>23</p></td><td colspan=\"1\" rowspan=\"1\"><p>无构造函数</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>relr_static</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>静态 PIE</p></td><td colspan=\"1\" rowspan=\"1\"><p>1125（RELR 1103）</p></td><td colspan=\"1\" rowspan=\"1\"><p>22</p></td><td colspan=\"1\" rowspan=\"1\"><p>1103</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>STATIC CTOR</code> + <code>MAIN</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>librelr.so</code> + <code>strip --strip-all</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>去符号表</p></td><td colspan=\"1\" rowspan=\"1\"><p>11（RELR 4）</p></td><td colspan=\"1\" rowspan=\"1\"><p>7</p></td><td colspan=\"1\" rowspan=\"1\"><p>4</p></td><td colspan=\"1\" rowspan=\"1\"><p>构造函数执行</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>librelr.so</code> + <code>objcopy --remove-section .relr.dyn</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>删节头</p></td><td colspan=\"1\" rowspan=\"1\"><p>11（RELR 4）</p></td><td colspan=\"1\" rowspan=\"1\"><p>7</p></td><td colspan=\"1\" rowspan=\"1\"><p>4</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>SIGSEGV</code>，rc=139</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>librela3.so</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>-z nopack-relative-relocs</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>11（RELR 0）</p></td><td colspan=\"1\" rowspan=\"1\"><p>11</p></td><td colspan=\"1\" rowspan=\"1\"><p>0</p></td><td colspan=\"1\" rowspan=\"1\"><p>构造函数执行</p></td></tr></tbody></table><p><code>librela.so</code> 是对照组：同样的构造，只是不压缩。<code>readelf -r</code> 显示 10 个 <code>.rela.dyn</code> 加 1 个 <code>.rela.plt</code>，<code>objdump -R</code> 也显示 11 个，缺失 0。这说明 <code>objdump -R</code> 不是“看不到 init_array”，它只是“看不到 RELR 里的 init_array”。</p><p><code>librelr_many.so</code> 把规模拉开：<code>.relr.dyn</code> 4 个条目、32 字节，展开成 103 个地址；<code>objdump -R</code> 只看到 4 个显式条目，缺 103 个。</p><pre><code>$ readelf -rW librelr_many.so | grep -E '\\.relr\\.dyn.*contains'\n\n$ readelf -rW relr_static | grep -E '\\.relr\\.dyn.*contains'</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125110621-30dd3d14-e87d-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=023e289267fad824\" loading=\"lazy\" decoding=\"async\" width=\"1064.12338238944\" height=\"187\"></p><p><code>librelr_data.so</code> 是纯数据指针，23 个地址被 RELR 写入，没有构造函数，影响落在数据/函数指针表上，不一定会立刻执行代码。</p><p><code>relr_static</code> 是静态 PIE，规模更大：1125 个动态目标里 1103 个是 RELR，<code>objdump -R</code> 只看到 22 个 PLT 跳转槽。一个只读 <code>objdump -R</code> 的扫描器会认为这个二进制“几乎没有动态重定位”，实际它有 1103 个 RELR 写入。程序跑起来，<code>STATIC CTOR</code> 和 <code>MAIN</code> 都正常输出。</p><p><code>strip --strip-all</code> 不影响 <code>DT_RELR</code>。<code>.symtab</code> 没了，<code>.relr.dyn</code> 还在，<code>readelf -d</code> 还是能看到 <code>DT_RELR</code>，<code>objdump -R</code> 还是 7 个，构造函数还是执行。想靠 strip 把重定位“洗掉”，不成立。</p><p><code>objcopy --remove-section .relr.dyn</code> 是另一个边界：节头没了，<code>DT_RELR</code> 标签还在，加载器仍然按标签去读那段位图，但 <code>objcopy</code> 已经把文件布局改了，读到的东西不可用，<code>relr_use</code> 直接 <code>SIGSEGV</code>，rc=139。删节头不是“隐藏”，是把加载器打崩。</p><pre><code>$ readelf -SW librelr_nosec.so | grep relr || echo 'section header gone'\n\n$ readelf -dW librelr_nosec.so | grep RELR\n\n$ setarch $(uname -m) -R ./relr_use ./librelr_nosec.so; echo rc=$?</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125110621-3121df97-e87d-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=f5b5c4751a85e30f\" loading=\"lazy\" decoding=\"async\" width=\"975.6493559360082\" height=\"328\"></p><p><code>-Wl,-z,nopack-relative-relocs</code> 是构建侧的可见性开关：强制回到显式 RELA，<code>objdump -R</code> 就能看到全部 11 个。代价是 <code>.rela.dyn</code> 从 144 字节涨到 240 字节，二进制变大；它不是安全修复，只是让旧审计工具能看见。</p><p>命中、未命中、边界三条分支因此很清楚：</p><ul><li><p><strong>命中</strong>：RELR 版 + 只读 <code>objdump -R</code> 的 gate。gate 判 PASS，构造函数执行。gate 的结论是错的。</p></li><li><p><strong>未命中</strong>：非 RELR 版 + 同一个 gate。gate 判 BLOCK，<code>init_array</code> 的重定位在 <code>objdump -R</code> 里可见。gate 的结论是对的。</p></li><li><p><strong>边界</strong>：纯数据 RELR（23 个地址）没有代码执行，但指针被静默改写；静态 PIE（1103 个地址）说明这不是边角；<code>objcopy</code> 删节头直接崩溃，说明“删掉节头”不是可用的隐藏手法。</p></li></ul><p><strong>换一种配置就失效，不是修复，而是转移。</strong> 关掉 RELR，<code>objdump -R</code> 能看见，但二进制变大；strip 看不见效果；删节头直接把加载器打崩。真正的修复只能落在审计侧：让审计枚举所有动态重定位来源。</p><h2 id=\"sec-6\">六、根因</h2><p>根因可以压成一句话：<code>objdump -R</code><strong> 枚举的是“显式重定位表”，</strong><code>DT_RELR</code><strong> 是“压缩重定位流”，两者不是同一种数据结构；</strong><code>readelf -r</code><strong> 有专门的展开路径，</strong><code>objdump -R</code><strong> 没有。</strong></p><p>再展开一点：</p><ul><li><p><code>.rela.dyn</code>、<code>.rel.dyn</code>、<code>.rela.plt</code> 都是节，节里是固定大小的 <code>Elf64_Rela</code>/<code>Elf64_Rel</code> 数组，BFD 可以按节遍历。</p></li><li><p><code>DT_RELR</code> 是动态段里的一个标签，指向一段 8 字节条目流；条目要么是地址，要么是位图。它没有对应的 <code>Elf64_Rela</code> 数组，BFD 的动态重定位枚举不会自动展开。</p></li><li><p><code>readelf -r</code> 对 <code>.relr.dyn</code>/<code>DT_RELR</code> 有单独的处理逻辑，所以能看到；<code>objdump -R</code> 没有，所以看不到。</p></li><li><p><code>readelf -d</code> 能看到 <code>DT_RELR</code> 标签，但标签不等于条目；<code>readelf -r</code> 能看到条目，但符号列解析的是槽位，不是值。</p></li></ul><h2 id=\"sec-7\">七、修复：让审计枚举所有动态重定位来源</h2><p>修复分两侧：审计侧和构建侧。审计侧是根治，构建侧只是可见性开关。</p><p>审计侧，按这五条做：</p><ol><li><p><strong>枚举所有动态重定位来源。</strong> 至少包括 <code>DT_RELA</code>、<code>DT_JMPREL</code>、<code>DT_RELR</code>；不要只读 <code>DT_RELA</code>，也不要把 <code>objdump -R</code> 当成全量。</p></li><li><p><strong>展开 RELR 位图。</strong> 偶数条目是地址，奇数条目是位图；一个位图覆盖 63 个槽位，基址每轮前进 <code>63 * 8</code>。不要把一个位图条目当成一个地址。</p></li><li><p><strong>对目标做节归属判定。</strong> 落在 <code>.init_array</code>、<code>.fini_array</code>、<code>.got</code>、<code>.data.rel.ro</code> 的写入，按安全相关处理；判定要用完整集合，不是 <code>objdump -R</code> 的子集。</p></li><li><p><strong>加运行时兜底。</strong> 对高风险二进制，<code>dlopen</code> 后读 <code>.init_array</code>/<code>.fini_array</code> 槽位，和文件里的链接期地址对比；<code>value == base + 文件值</code> 说明加载器写了。文件视图和运行时视图的差异，比任何单一静态工具都可靠。</p></li><li><p><strong>补丁比对要带上 RELR。</strong> 比较两个二进制时，把 <code>.relr.dyn</code> 的原始字节和 <code>DT_RELR</code>/<code>DT_RELRSZ</code>/<code>DT_RELRENT</code> 一起纳入 hash/diff；只比符号表和 <code>.rela.dyn</code>，会漏掉 RELR 里的变化。</p></li></ol><p>这五条里，第一条和第二条是核心。<code>relr_scan.py</code> 的完整模式就是按这两条写的，<code>--gate</code> 模式再把第三条接上：</p><pre><code>$ python3 relr_scan.py --gate librelr.so0</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125110622-315f0df5-e87d-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=c9fdad9141e17f44\" loading=\"lazy\" decoding=\"async\" width=\"629.0584449670602\" height=\"217\"></p><p>同一个库，只读 <code>objdump -R</code> 的 gate 给出的是另一个结果：</p><pre><code>$ python3 relr_gate.py librelr.so</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125110622-3198656d-e87d-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=a611746a0945b51a\" loading=\"lazy\" decoding=\"async\" width=\"733.7662377422225\" height=\"164\"></p><p>一个 PASS，一个 BLOCK。差的就是 <code>DT_RELR</code> 的 4 个地址。</p><p>对照组 <code>librela.so</code> 两边都 BLOCK：</p><pre><code>$ python3 relr_gate.py librela.so</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261125110622-31cefc7f-e87d-1.png&amp;mode=full&amp;exp=1796083200&amp;sig=746b793b85eae3d8\" loading=\"lazy\" decoding=\"async\" width=\"556.0064965192726\" height=\"219\"></p><p>这说明 gate 本身不是“永远 PASS”，它只是对 RELR 盲。</p><p>构建侧，按这两条做：</p><ol><li><p><strong>需要旧审计工具看得见时，用 </strong><code>-Wl,-z,nopack-relative-relocs</code><strong>。</strong> 强制回到显式 RELA，<code>objdump -R</code> 能看到全部 11 个，<code>.rela.dyn</code> 从 144 字节涨到 240 字节。代价是二进制变大，收益是可见性；这不是安全修复，是兼容性开关。</p></li><li><p><strong>不要用 </strong><code>objcopy --remove-section .relr.dyn</code><strong> 去“清理”重定位。</strong> 节头删了，<code>DT_RELR</code> 标签还在，加载器仍然按标签读位图，但文件布局已经变了，<code>relr_use</code> 直接 <code>SIGSEGV</code>，rc=139。strip 也不会移除 <code>DT_RELR</code>，它只动符号表。</p></li></ol><h2 id=\"sec-8\">八、攻击者视角</h2><p><strong>诱导链。</strong> 攻击者不需要控制整个构建流水线，只需要让一个原生扩展进入宿主。宿主的审计 gate 用 <code>objdump -R</code> 判断“有没有 <code>init_array</code> 重定位”，扩展的 <code>.init_array</code> 指针被链接器压进 <code>DT_RELR</code>，gate 看到的 7 个 offset 全在 GOT 和 PLT 上，判 PASS。宿主 <code>dlopen</code> 扩展，构造函数在宿主的权限下执行。</p><p><strong>提权链。</strong> 这不是提权漏洞。构造函数拿到的就是宿主进程的权限；如果宿主是 root，它就是 root，如果宿主是普通用户，它就是普通用户。它的价值在于“绕过静态审计”，不在于“突破权限边界”。本文的样本只打印 <code>CTOR RAN</code>，原因也在这里：验证的是审计盲区，不是利用链。</p><p><strong>自动化探测。</strong> 攻击者可以先看目标的审计工具：如果只跑 <code>objdump -R</code>，RELR 就是可用的；如果跑 <code>readelf -r</code> 或自写了解析器，隐藏的目标会被看到。一个简单的自检脚本就能判断：</p><pre><code>$ readelf -dW librelr.so | grep -c '(RELR)'\n\n$ objdump -RW librelr.so | grep -cE '^[0-9a-f]{16}'\n\n$ python3 relr_scan.py librelr.so | grep -E 'DT_RELR entries|objdump -R offsets|targets missing'</code></pre><p>如果 <code>DT_RELR</code> 存在，而 <code>objdump -R</code> 的数量明显小于 <code>readelf -r</code> 展开的数量，说明工具的集合不完整。防守方也可以用同一组命令做自查。</p><p><strong>边界。</strong> 这套手法只对“只读显式表”的审计有效。目标一旦用 <code>readelf -r</code>、LLVM readelf、或自写的 RELR 展开器，隐藏的四个地址就会露出来；目标一旦做运行时槽位采样，构造函数也藏不住。它不是通用免杀，是一个特定工具链组合下的盲区。</p><h2 id=\"sec-9\">九、结论</h2><ol><li><p><strong>RELR 是第四套重定位表示。</strong> 加载器认它，<code>objdump -R</code> 不认；<code>librelr.so</code> 的 11 个动态目标里，4 个只在 <code>DT_RELR</code> 里，正好是 <code>init_array</code>、<code>fini_array</code> 和 <code>__dso_handle</code>。readelf（GNU/LLVM）能看到，objdump（GNU/LLVM）看不到。</p></li><li><p><strong>盲区的规模不是边角。</strong> 100 个函数指针的库漏 103 个，纯数据指针的库漏 23 个，静态 PIE 漏 1103 个；构造函数在 gate 判 PASS 的同时照样执行。盲区的成立条件是“审计只读一套表示”，不是 RELR 本身有漏洞。</p></li><li><p><strong>修复不是禁用 RELR。</strong> 审计侧枚举 <code>DT_RELA</code>、<code>DT_JMPREL</code>、<code>DT_RELR</code>，展开位图，再用运行时槽位做交叉验证；构建侧的 <code>-z nopack-relative-relocs</code> 只是让旧工具看得见的兼容开关。检查清单一句话：<strong>看到 </strong><code>DT_RELR</code><strong>，先别信 </strong><code>objdump -R</code><strong>。</strong></p></li></ol><h2 id=\"sec-10\">附录：源码</h2><h3 id=\"sec-11\">relr_lib.c</h3><pre><code>#define _GNU_SOURCE\n#include &lt;unistd.h&gt;\n\nint ext = 7;\nint *p1 = &amp;ext;\nint *p2 = &amp;ext;\n\n__attribute__((noinline)) static void ctor(void)\n{\n    static const char msg[] = \"CTOR RAN\\n\";\n    write(1, msg, sizeof(msg) - 1);\n}\n\n__attribute__((constructor)) static void lib_init(void)\n{\n    ctor();\n}\n\nstatic int ctor_ran = 1;\n\nint get_ctor_ran(void)\n{\n    return ctor_ran;\n}\n\nvoid *get_init_addr(void)\n{\n    return (void *)&amp;lib_init;\n}</code></pre><h3 id=\"sec-12\">relr_use.c</h3><pre><code>#define _GNU_SOURCE\n#include &lt;dlfcn.h&gt;\n#include &lt;link.h&gt;\n#include &lt;stdio.h&gt;\n#include &lt;string.h&gt;\n#include &lt;stdint.h&gt;\n\nstatic uintptr_t lib_base;\nstatic int found;\n\nstatic int cb(struct dl_phdr_info *info, size_t sz, void *data)\n{\n    (void)sz;\n    (void)data;\n    if (strstr(info-&gt;dlpi_name, \"librelr\")) {\n        lib_base = info-&gt;dlpi_addr;\n        found = 1;\n        return 1;\n    }\n    return 0;\n}\n\nint main(int argc, char **argv)\n{\n    const char *path = argc &gt; 1 ? argv[1] : \"./librelr.so\";\n    void *h = dlopen(path, RTLD_NOW | RTLD_LOCAL);\n    if (!h) {\n        printf(\"dlopen failed: %s\\n\", dlerror());\n        return 1;\n    }\n\n    int (*get_ran)(void) = (int (*)(void))dlsym(h, \"get_ctor_ran\");\n    void *(*get_addr)(void) = (void *(*)(void))dlsym(h, \"get_init_addr\");\n\n    dl_iterate_phdr(cb, NULL);\n    printf(\"ctor_ran=%d\\n\", get_ran ? get_ran() : -1);\n    printf(\"init_addr=%p\\n\", get_addr ? get_addr() : NULL);\n    if (found) {\n        printf(\"lib_base=%p\\n\", (void *)lib_base);\n        if (get_addr)\n            printf(\"init_off=0x%lx\\n\",\n                   (unsigned long)((uintptr_t)get_addr() - lib_base));\n    }\n    return 0;\n}</code></pre><h3 id=\"sec-13\">relr_mem.c</h3><pre><code>#define _GNU_SOURCE\n#include &lt;dlfcn.h&gt;\n#include &lt;link.h&gt;\n#include &lt;stdio.h&gt;\n#include &lt;stdlib.h&gt;\n#include &lt;string.h&gt;\n#include &lt;stdint.h&gt;\n\nstatic uintptr_t lib_base;\nstatic int found;\n\nstatic int cb(struct dl_phdr_info *info, size_t sz, void *data)\n{\n    (void)sz;\n    (void)data;\n    if (strstr(info-&gt;dlpi_name, \"librelr\")) {\n        lib_base = info-&gt;dlpi_addr;\n        found = 1;\n        return 1;\n    }\n    return 0;\n}\n\nint main(int argc, char **argv)\n{\n    if (argc &lt; 3) {\n        fprintf(stderr, \"usage: %s &lt;lib&gt; &lt;offset-hex&gt;\\n\", argv[0]);\n        return 2;\n    }\n\n    void *h = dlopen(argv[1], RTLD_NOW | RTLD_LOCAL);\n    if (!h) {\n        printf(\"dlopen failed: %s\\n\", dlerror());\n        return 1;\n    }\n\n    dl_iterate_phdr(cb, NULL);\n    if (!found) {\n        printf(\"lib not found\\n\");\n        return 1;\n    }\n\n    uintptr_t off = strtoull(argv[2], NULL, 16);\n    uintptr_t slot = lib_base + off;\n    uintptr_t value = *(uintptr_t *)slot;\n    printf(\"base=%p offset=0x%lx slot=%p value=%p value_off=0x%lx\\n\",\n           (void *)lib_base, (unsigned long)off, (void *)slot,\n           (void *)value, (unsigned long)(value - lib_base));\n    return 0;\n}</code></pre><h3 id=\"sec-14\">relr_scan.py</h3><pre><code>#!/usr/bin/env python3\nimport re\nimport struct\nimport subprocess\nimport sys\n\nDT_NULL = 0\nDT_PLTRELSZ = 2\nDT_RELA = 7\nDT_RELASZ = 8\nDT_RELAENT = 9\nDT_JMPREL = 23\nDT_RELRSZ = 35\nDT_RELR = 36\nDT_RELRENT = 37\n\nR_X86_64_RELATIVE = 8\n\n\ndef vaddr_to_off(loads, vaddr):\n    for p_vaddr, p_offset, p_filesz, _p_memsz in loads:\n        if p_vaddr &lt;= vaddr &lt; p_vaddr + p_filesz:\n            return p_offset + (vaddr - p_vaddr)\n    return None\n\n\ndef parse_elf(path):\n    data = open(path, \"rb\").read()\n    if data[:4] != b\"\\x7fELF\" or data[4] != 2 or data[5] != 1:\n        raise SystemExit(\"need ELF64 little-endian\")\n    e_phoff = struct.unpack_from(\"&lt;Q\", data, 0x20)[0]\n    e_phentsize = struct.unpack_from(\"&lt;H\", data, 0x36)[0]\n    e_phnum = struct.unpack_from(\"&lt;H\", data, 0x38)[0]\n    loads = []\n    dyn = None\n    for i in range(e_phnum):\n        o = e_phoff + i * e_phentsize\n        p_type, p_flags, p_offset, p_vaddr, p_paddr, p_filesz, p_memsz, p_align = \\\n            struct.unpack_from(\"&lt;IIQQQQQQ\", data, o)\n        if p_type == 1:\n            loads.append((p_vaddr, p_offset, p_filesz, p_memsz))\n        elif p_type == 2:\n            dyn = (p_offset, p_filesz)\n    if dyn is None:\n        raise SystemExit(\"no PT_DYNAMIC\")\n    tags = {}\n    off, size = dyn\n    for i in range(0, size, 16):\n        tag, val = struct.unpack_from(\"&lt;QQ\", data, off + i)\n        if tag == DT_NULL:\n            break\n        tags[tag] = val\n    return data, loads, tags\n\n\ndef read_rela(data, loads, tags):\n    out = []\n    if DT_RELA not in tags:\n        return out\n    vaddr = tags[DT_RELA]\n    size = tags.get(DT_RELASZ, 0)\n    ent = tags.get(DT_RELAENT, 24)\n    off = vaddr_to_off(loads, vaddr)\n    if off is None:\n        return out\n    for i in range(size // ent):\n        r_offset, r_info, r_addend = struct.unpack_from(\"&lt;QQq\", data, off + i * ent)\n        out.append((r_offset, r_info &amp; 0xffffffff, r_addend, \"RELA\"))\n    return out\n\n\ndef read_jmprel(data, loads, tags):\n    out = []\n    if DT_JMPREL not in tags:\n        return out\n    vaddr = tags[DT_JMPREL]\n    size = tags.get(DT_PLTRELSZ, 0)\n    ent = 24\n    off = vaddr_to_off(loads, vaddr)\n    if off is None:\n        return out\n    for i in range(size // ent):\n        r_offset, r_info, r_addend = struct.unpack_from(\"&lt;QQq\", data, off + i * ent)\n        out.append((r_offset, r_info &amp; 0xffffffff, r_addend, \"JMPREL\"))\n    return out\n\n\ndef read_relr(data, loads, tags):\n    out = []\n    if DT_RELR not in tags:\n        return out\n    vaddr = tags[DT_RELR]\n    size = tags.get(DT_RELRSZ, 0)\n    ent = tags.get(DT_RELRENT, 8)\n    off = vaddr_to_off(loads, vaddr)\n    if off is None:\n        return out\n    base = 0\n    for i in range(size // ent):\n        entry = struct.unpack_from(\"&lt;Q\", data, off + i * ent)[0]\n        if (entry &amp; 1) == 0:\n            out.append((entry, 0, 0, \"RELR\"))\n            base = entry + 8\n        else:\n            for bit in range(1, 64):\n                if entry &amp; (1 &lt;&lt; bit):\n                    out.append((base + (bit - 1) * 8, 0, 0, \"RELR\"))\n            base += 63 * 8\n    return out\n\n\ndef section_ranges(path):\n    out = subprocess.check_output([\"readelf\", \"-SW\", path], text=True)\n    ranges = {}\n    for line in out.splitlines():\n        m = re.match(\n            r\"\\s*\\[\\s*\\d+\\]\\s+(\\S+)\\s+(\\S+)\\s+([0-9a-fA-F]+)\\s+([0-9a-fA-F]+)\\s+([0-9a-fA-F]+)\",\n            line,\n        )\n        if m:\n            name = m.group(1)\n            addr = int(m.group(3), 16)\n            size = int(m.group(5), 16)\n            ranges[name] = (addr, addr + size)\n    return ranges\n\n\ndef objdump_offsets(path):\n    try:\n        out = subprocess.check_output([\"objdump\", \"-RW\", path],\n                                      text=True, stderr=subprocess.DEVNULL)\n    except Exception as exc:\n        return None, str(exc)\n    offs = []\n    for line in out.splitlines():\n        m = re.match(r\"^([0-9a-fA-F]{16})\\s+(\\S+)\", line)\n        if m:\n            offs.append(int(m.group(1), 16))\n    return offs, None\n\n\ndef main():\n    mode = \"full\"\n    args = sys.argv[1:]\n    if args and args[0] == \"--gate\":\n        mode = \"gate\"\n        args = args[1:]\n    elif args and args[0] == \"--mode\":\n        mode = args[1]\n        args = args[2:]\n    if not args:\n        raise SystemExit(\"usage: relr_scan.py [--mode full|rela] &lt;elf&gt;\")\n    path = args[0]\n\n    data, loads, tags = parse_elf(path)\n    rela = read_rela(data, loads, tags)\n    jmprel = read_jmprel(data, loads, tags)\n    relr = read_relr(data, loads, tags)\n    obj, err = objdump_offsets(path)\n\n    if mode == \"gate\":\n        ranges = section_ranges(path)\n        watch = {k: v for k, v in ranges.items()\n                 if k in (\".init_array\", \".fini_array\")}\n        all_offs = sorted(set(o for o, *_ in rela + jmprel + relr))\n        hits = []\n        for name, (lo, hi) in watch.items():\n            for off in all_offs:\n                if lo &lt;= off &lt; hi:\n                    hits.append((name, off))\n        print(\"DT_RELA=%d DT_JMPREL=%d DT_RELR=%d total=%d\" % (\n            len(rela), len(jmprel), len(relr), len(all_offs)))\n        for name, (lo, hi) in watch.items():\n            print(\"%s: [0x%x, 0x%x)\" % (name, lo, hi))\n        if hits:\n            print(\"RESULT: BLOCK\")\n            for name, off in hits:\n                print(\"  relocation at %s 0x%x\" % (name, off))\n        else:\n            print(\"RESULT: PASS\")\n        return\n\n    if mode == \"rela\":\n        print(\"DT_RELA entries: %d\" % len(rela))\n        for off, rtype, addend, src in rela:\n            print(\"  0x%-8x type=%-2d addend=%d\" % (off, rtype, addend))\n        print(\"DT_JMPREL entries: %d\" % len(jmprel))\n        print(\"DT_RELR tag: %s\" % (\"present\" if DT_RELR in tags else \"absent\"))\n        print(\"DT_RELR targets not enumerated by DT_RELA: %d\" % len(relr))\n        for off, rtype, addend, src in relr:\n            print(\"  0x%-8x\" % off)\n        return\n\n    total = rela + jmprel + relr\n    print(\"file: %s\" % path)\n    print(\"DT_RELR tag: %s\" % (\"present\" if DT_RELR in tags else \"absent\"))\n    if DT_RELR in tags:\n        print(\"DT_RELR vaddr=0x%x size=%d ent=%d\" % (\n            tags.get(DT_RELR, 0), tags.get(DT_RELRSZ, 0), tags.get(DT_RELRENT, 0)))\n    print(\"DT_RELA entries: %d\" % len(rela))\n    print(\"DT_JMPREL entries: %d\" % len(jmprel))\n    print(\"DT_RELR entries: %d\" % len(relr))\n    print(\"all dynamic-tag targets: %d\" % len(total))\n    for off, rtype, addend, src in sorted(total):\n        print(\"  0x%-8x %-6s type=%-2d addend=%d\" % (off, src, rtype, addend))\n\n    if obj is None:\n        print(\"objdump -R failed: %s\" % err)\n        return\n    print(\"objdump -R offsets: %d\" % len(obj))\n    for off in obj:\n        print(\"  0x%-8x\" % off)\n    missing = sorted(set(off for off, *_ in total) - set(obj))\n    print(\"targets missing from objdump -R: %d\" % len(missing))\n    for off in missing:\n        print(\"  0x%-8x\" % off)\n\n\nif __name__ == \"__main__\":\n    main()</code></pre><h3 id=\"sec-15\">relr_gate.py</h3><pre><code>#!/usr/bin/env python3\nimport re\nimport subprocess\nimport sys\n\n\ndef section_ranges(path):\n    out = subprocess.check_output([\"readelf\", \"-SW\", path], text=True)\n    ranges = {}\n    for line in out.splitlines():\n        m = re.match(\n            r\"\\s*\\[\\s*\\d+\\]\\s+(\\S+)\\s+(\\S+)\\s+([0-9a-fA-F]+)\\s+([0-9a-fA-F]+)\\s+([0-9a-fA-F]+)\",\n            line,\n        )\n        if m:\n            name, typ, addr, off, size = m.groups()\n            ranges[name] = (int(addr, 16), int(addr, 16) + int(size, 16))\n    return ranges\n\n\ndef objdump_offsets(path):\n    out = subprocess.check_output([\"objdump\", \"-RW\", path], text=True)\n    offs = []\n    for line in out.splitlines():\n        m = re.match(r\"^([0-9a-fA-F]{16})\\s+(\\S+)\", line)\n        if m:\n            offs.append(int(m.group(1), 16))\n    return offs\n\n\ndef main():\n    if len(sys.argv) != 2:\n        raise SystemExit(\"usage: relr_gate.py &lt;elf&gt;\")\n    path = sys.argv[1]\n    ranges = section_ranges(path)\n    offs = objdump_offsets(path)\n    watch = {k: v for k, v in ranges.items() if k in (\".init_array\", \".fini_array\")}\n    hit = []\n    for name, (lo, hi) in watch.items():\n        for off in offs:\n            if lo &lt;= off &lt; hi:\n                hit.append((name, off))\n    print(\"objdump -R offsets: %d\" % len(offs))\n    for name, (lo, hi) in watch.items():\n        print(\"%s: [0x%x, 0x%x)\" % (name, lo, hi))\n    if hit:\n        print(\"RESULT: BLOCK\")\n        for name, off in hit:\n            print(\"  relocation at %s 0x%x\" % (name, off))\n    else:\n        print(\"RESULT: PASS (no init_array/fini_array relocation visible)\")\n\n\nif __name__ == \"__main__\":\n    main()</code></pre><h3 id=\"sec-16\">relr_many.c</h3><pre><code>extern int ext;\nint ext = 7;\n\nstatic void target(void)\n{\n}\n\nvoid (*table[100])(void) = { [0 ... 99] = target };</code></pre><h3 id=\"sec-17\">relr_data.c</h3><pre><code>static int local = 7;\nint *tab[20] = { [0 ... 19] = &amp;local };</code></pre><h3 id=\"sec-18\">relr_static.c</h3><pre><code>#include &lt;unistd.h&gt;\n\nint ext = 7;\nint *p = &amp;ext;\n\n__attribute__((constructor)) static void init(void)\n{\n    static const char msg[] = \"STATIC CTOR\\n\";\n    write(1, msg, sizeof(msg) - 1);\n}\n\nint main(void)\n{\n    write(1, \"MAIN\\n\", 5);\n    return 0;\n}</code></pre>","original","zhKind","complete","逆向","漏洞分析","工具发布","https://xz.aliyun.com/news/93459","先知社区",{"_148":149,"_150":-5},"changelogVersion","2026-10-01T08:00","release"]
