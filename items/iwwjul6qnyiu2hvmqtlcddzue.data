[{"_1":2,"_3":4},"root",{"_5":128},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1794444094000,"id","iwwjul6qnyiu2hvmqtlcddzue","title","Unit 42 披露 ARTEX 针对全球零售与咨询云环境的多起入侵活动","originalTitle","ARTEX and AI-Powered Red Teaming Tools: What Defenders Need to Know","summary","Unit 42 已观察攻击者利用 ARTEX 和 CyberStrikeAI 自主执行入侵，ARTEX 被用于攻击多个目标及零售、咨询等行业的客户云环境。截至 2026 年 10 月，研究团队发现 609 台互联网暴露主机运行 ARTEX、1,323 台运行 CyberStrikeAI，另有 21 台同时运行两者。","reason","文章结合多起入侵调查与外部主机统计，揭示 ARTEX 被用于并行、持续攻击公开暴露资产的具体操作特征。","source",{"_67":127},"links",{"_118":126},"publishedAt","2026-11-11T23:00:53.000Z","discoveredAt","2026-11-11T23:19:25.971Z","timelineAt","category","activity","tags",[68,70,122,123,124,125],"score",75,"selected",true,"channel","news","story","x","readingMode","full","author","Cuong Dinh, Richard Emerson and Samantha Stallings","body",{"_59":117,"_118":-5,"_119":120,"_121":37},"outline",[77,78,79,80,81,82,83,84,85,86,87,88],"relatedStories",[],"topics",[60,61,62,63,64],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_65":75,"_67":76},{"_65":73,"_67":74},{"_65":71,"_67":72},{"_65":69,"_67":70},{"_65":66,"_67":68},"slug","attack","name","攻击活动","ai-offense","AI 攻防","ai-agent","AI Agent 安全","cloud-native","云与原生","paloalto","Palo Alto Networks",{"_11":115,"_90":116,"_92":93},{"_11":113,"_90":114,"_92":93},{"_11":111,"_90":112,"_92":93},{"_11":109,"_90":110,"_92":100},{"_11":107,"_90":108,"_92":100},{"_11":105,"_90":106,"_92":100},{"_11":103,"_90":104,"_92":100},{"_11":101,"_90":102,"_92":100},{"_11":98,"_90":99,"_92":100},{"_11":96,"_90":97,"_92":93},{"_11":94,"_90":95,"_92":93},{"_11":89,"_90":91,"_92":93},"sec-12","text","其他资源","level",2,"sec-11","ARTEX 攻击的结论与缓解措施","sec-10","识别 AI 驱动的操作者","sec-9","防御性欺骗可能会有所帮助",3,"sec-8","当前 AI 驱动框架噪声很高","sec-7","防御方从追踪生态变化中获益","sec-6","主动采用 AI 有助于防御方","sec-5","面向互联网的资产带来的风险","sec-4","降低攻击者的技能门槛","sec-3","对防御方的影响","sec-2","AI 赋能的红队测试与渗透测试生态系统基础设施","sec-1","为什么 ARTEX 是攻击者如此有效的工具？","<p>一个由 AI 赋能工具组成的生态系统正在迅速扩张，其中包括 ARTEX 和 CyberStrikeAI 等宣传用于红队测试和渗透测试的工具。攻击者正在利用这些工具自主执行攻击性操作。</p><p>其足迹已经相当广泛。Unit 42 <a href=\"https://github.com/PaloAltoNetworks/Unit42-timely-threat-intel/blob/main/2026-10-30-activity-using-ARTEX-agentic-AI.txt?utm_campaign=tti_artex-intrusions\">观察到攻击者使用 ARTEX 针对多个目标发起入侵尝试</a>。</p><p>我们的事件响应团队调查了多起入侵事件，其中攻击者的服务器托管着 ARTEX 控制台，或使用了与 ARTEX 相关的基础设施和用户代理。</p><p>此外，Unit 42 托管式威胁狩猎团队追踪到了一次针对全球各行业客户云环境的协同 ARTEX 攻击活动，涉及零售和咨询等行业。</p><p>外部审查已经扰乱了项目的开发生命周期：ARTEX 的作者最近将代码仓库<a href=\"https://www.reuters.com/world/china/chinese-developer-makes-artex-ai-agent-closed-source-after-korean-bank-hack-2026-10-09/\">转为闭源，并停止公开开发，以防止滥用</a>。新兴替代工具正在迅速填补这一空白，带来新的能力，而威胁行为者不可避免地会利用这些能力。</p><p>下面，我们分享对攻击者如何使用 AI 赋能红队工具的观察，以及我们关于防御方如何缓解风险的建议。</p><h2 id=\"sec-1\">为什么 ARTEX 是攻击者如此有效的工具？</h2><p>ARTEX 和其他红队平台免费、部署快捷，只需能够访问大型语言模型（LLM）即可使用。</p><p>ARTEX 是一个开源多代理 AI 渗透测试框架，最初发布于 2026 年中期。此后，该项目已被广泛派生。</p><p>攻击者可以使用 ARTEX 评估响应、在失败后进行调整，并继续追求其目标。他们可以将组织暴露在互联网上的身份工作流和 API 作为目标，然后利用相关凭据和信任关系进入云环境。</p><h2 id=\"sec-2\">AI 赋能的红队测试与渗透测试生态系统基础设施</h2><p>截至 2026 年 10 月，Unit 42 发现有 1,323 台面向互联网的主机正在运行 CyberStrikeAI，另有 609 台正在运行 ARTEX。值得注意的是，有 21 台主机同时运行两者。</p><p>Unit 42 分析了渗透测试与红队测试工具生态系统中的 14 款工具，重点介绍了除 CyberStrikeAI 和 ARTEX 之外的 12 款新兴工具。</p><p>这些工具可分为四类 AI 辅助红队活动。</p><table>\n<tbody>\n<tr>\n<td><b>类别</b></td>\n<td><b>工具</b></td>\n<td><b>目标</b></td>\n</tr>\n<tr>\n<td><span>侦察与攻击面管理</span></td>\n<td><span>ARL, ARL-Next, Scope Sentry, Nemo, XingRin, OpenEASD</span></td>\n<td><span>确定存在哪些资产、哪些资产暴露在外以及发生了哪些变化</span></td>\n</tr>\n<tr>\n<td><span>代理主导的测试与漏洞搜寻</span></td>\n<td><span>CyberStrikeAI, ARTEX, Cairn, PentAGI, AutoHunter</span></td>\n<td><span>管理应调查的内容以及系统可以如何据此采取行动</span></td>\n</tr>\n<tr>\n<td><span>源代码审计与验证</span></td>\n<td><span>DeepAudit, AIxVuln</span></td>\n<td><span>确定源代码可能存在漏洞的位置，以及有哪些证据支持该发现</span></td>\n</tr>\n<tr>\n<td><span>AI 系统安全评估</span></td>\n<td><span>AI-Infra-Guard</span></td>\n<td><span>确定 AI 基础设施、代理、工具和模型接口是否存在漏洞或不可靠</span></td>\n</tr>\n</tbody>\n</table><p><span>表 1. 工具类别。</span></p><h2 id=\"sec-3\">对防御方的影响</h2><p>防御方应了解 AI 赋能红队平台带来的以下影响：</p><h3 id=\"sec-4\">降低攻击者的技能门槛</h3><p>对手不再需要专业技术能力即可执行多阶段、自适应渗透测试。</p><p>现成工具结合 DeepSeek 等 LLM，使以牟利为目的的行为者只需付出极低的算力成本，就能发起并管理数十次复杂且并发的网络入侵。</p><h3 id=\"sec-5\">面向互联网的资产带来的风险</h3><p>任何暴露在互联网的资产，无论组织规模或所属行业，都同样可能受到自动化、持续性的入侵尝试影响。</p><p>使用自主 AI 渗透测试框架 ARTEX 的攻击者，正把公开的密码重置页面和暴露的 API 变成通往云端的路径，有时不到一天即可实现。Unit 42 事件响应与托管威胁狩猎团队在多个组织和行业中观察到了此类活动，且未利用任何单个软件漏洞。</p><p>由于这些自主平台无法瞄准它们找不到的目标，持续发现并缓解暴露的边缘资产，仍是抵御自动化攻击活动的一道有效屏障。</p><h3 id=\"sec-6\">主动采用 AI 有助于防御方</h3><p>自主测试框架依赖于大语言模型的基础推理模式。因此，AI 驱动的攻击者工具存在一定的可预测性。</p><p>安全团队无需猜测智能体的方法论；他们可以在内部部署相同的开放权重攻击框架，在外部智能体发现之前发现、验证并修复存在风险的暴露面。</p><h3 id=\"sec-7\">防御方从追踪生态变化中获益</h3><p>该生态中工具的快速采用曲线凸显了运营趋势可能发生转变的速度。关注这些进展可带来实用的防御优势：</p><ul>\n<li>观察新出现的智能体主导框架，可让团队在受控环境中尽早测试新能力。</li>\n<li>监控托管这些工具的基础设施，可以在主动定向开始之前更新边界阻断策略。</li>\n</ul><h3 id=\"sec-8\">当前 AI 驱动框架噪声很高</h3><p>当前的自主框架优先考虑快速的试错而非隐蔽性。在我们对一款名为 Cairn 的工具的研究中，它从单一源 IP 地址发出了数十万次高频率、噪声极大的请求，跨越多种边缘协议。</p><p>拥有统一边界遥测和集中日志记录的组织，可以轻松将这种暴力破解式的智能体流量与合法用户区分开来，并在利用发生之前于网络边缘阻断攻击活动。</p><h3 id=\"sec-9\">防御性欺骗可能会有所帮助</h3><p>大语言模型驱动的测试工具会将目标响应作为后续动作的上下文。</p><p>防御方或许可以利用这一点，诱使使用 AI 驱动红队工具的攻击者浪费资源。</p><p>当目标返回完全相同的通用错误码，或实施静默连接限流时，AI 智能体就缺少调整策略所需的环境线索。失去环境反馈后，自主循环会在死胡同上消耗上下文窗口和算力预算。</p><h2 id=\"sec-10\">识别 AI 驱动的操作者</h2><p>ARTEX 不断被分叉和修改。此外，攻击者快速轮换基础设施，因此指标会很快失去价值。而操作者的行为更为持久，在我们观察到的所有样本中，其行为始终指向一个根据所见内容作出反应的自动化规划器。表 2 展示了这种行为的典型特征。</p><table>\n<thead>\n<tr>\n<th><b>典型特征</b></th>\n<th><b>我们的观察</b></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><span>先思考后行动的节奏</span></td>\n<td><span>成串的 1 至 14 次请求，间隔约一秒，随后暂停 25–31 秒，与智能体等待模型推理调用的情况一致</span></td>\n</tr>\n<tr>\n<td><span>机器速度</span></td>\n<td><span>在下载凭据后约一分钟内转向。约三分钟内验证了 200 多个客户端密钥</span></td>\n</tr>\n<tr>\n<td><span>以规范为驱动的定向</span></td>\n<td><span>几乎立即就从下载的 OpenAPI 规范和 source map 中规划路由</span></td>\n</tr>\n<tr>\n<td><span>自我纠错</span></td>\n<td><span>失败的请求（HTTP 422）经过调整后成功重试，片刻后即告完成</span></td>\n</tr>\n<tr>\n<td><span>检查自己的工作</span></td>\n<td><span>几乎每次成功写入后，都会向同一路径发起一次 </span><span>GET</span><span> 请求。对存储桶进行先写入再删除的测试。</span></td>\n</tr>\n<tr>\n<td><span>金丝雀输入</span></td>\n<td><span>先使用虚假用户名，再使用真实用户名；还会使用占位值，例如 </span><span>evil[.]com</span><span>、</span><span>test@example[.]com</span><span> 和 </span><span>deadbeefdeadbeefdeadbeef12</span></td>\n</tr>\n<tr>\n<td><span>并行定向</span></td>\n<td><span>在同一小时内遭到攻击的目标包括应用交付控制器、十多台 VPN 设备、一台 NAS 设备、员工身份和云端口</span></td>\n</tr>\n<tr>\n<td><span>复查循环</span></td>\n<td><span>连续三天每 48 秒轮询一次，攻击序列约每隔 30 秒完全相同地重放</span></td>\n</tr>\n</tbody>\n</table><p><span>表 2. Unit 42 观察到的 ARTEX 驱动活动的行为特征。</span></p><p>这些特征中的任何一项都可能来自配置异常的工具，也可能是人工测试 API。将它们结合在一起看，则表明存在自主工具。</p><p>尽管使用了自主工具在我们观察到的攻击中仍有人工参与。在一次交战中，攻击者在执行密码重置和首次令牌请求时，从脚本客户端切换到了桌面浏览器。这表明在最敏感的步骤中有人参与，或使用了浏览器自动化。</p><h2 id=\"sec-11\">ARTEX 攻击的结论与缓解措施</h2><p>AI 驱动的工具并未发明新的攻击。滥用自助服务、暴露的 API 和存储的凭据长期以来一直是薄弱环节。</p><p>发生变化的是速度和持久性。ARTEX 操作者可以并行测试每个暴露的工作流，并在受阻后几分钟内切换路线。它可以在发现被盗凭据后一分钟内采取行动。</p><p>由于该框架是开源的且已被广泛分叉，基于指标的检测将无法跟上。</p><p>移除机器可读攻击映射、在所有位置强制身份验证，并围绕操作者行为构建检测的防御者，将最有希望阻止 AI 辅助攻击者。</p><p>自主工具探测的速度快于人员审查警报的速度。防御措施需要默认阻止访问，并移除这些工具正在寻找的凭据。组织应当：</p><ul>\n<li><strong>移除公开的攻击映射。</strong>将包含令牌或客户端 ID 的 OpenAPI 规范、源映射和配置文件从面向互联网的应用中移除。</li>\n<li><strong>减少并了解组织的公开足迹。</strong>证书透明度可能为威胁行为者生成目标清单。在云环境中，至关重要的是了解主机完全限定域名（FQDN）是否已成为公开信息。考虑使用私有证书颁发机构来限制信息披露，并在可能的情况下将源站流量锁定为仅通过内容交付网络（CDN）进入。</li>\n<li><strong>在每个写入端点上强制身份验证，</strong>包括开发和预发布 API。</li>\n<li><strong>加固自助服务流程。</strong>对注册、密码重置和验证码端点实施速率限制和机器人防护。移除未经身份验证的账户存在性检查。</li>\n<li><strong>保护联合身份。</strong>阻止客户和合作伙伴身份提供商中的员工账户使用本地密码，并确保密码重置绝不会解除联合身份的关联。</li>\n<li><strong>让凭据远离可接触范围。 </strong>用基于角色的访问取代长期有效的云密钥，将管理员凭据排除在预配记录之外，并把函数密钥移至 secrets manager。</li>\n<li><strong>为工作负载角色以及任何能够创建角色、密钥或令牌的函数强制执行最小权限原则。</strong></li>\n<li><strong>Hunt for behavior, not just indicators. </strong>Look for:\n<ul>\n<li>身份提供商日志中的金丝雀用户名</li>\n<li>首次从新的 IP 地址使用云密钥</li>\n<li>先写入后删除的存储测试</li>\n<li>为后续入侵做铺垫的早期探测</li>\n</ul>\n</li>\n</ul><p>组织可通过 <a href=\"https://www.paloaltonetworks.com/unit42/threat-intelligence\">Unit 42 Threat Intel Services</a> 及其 <a href=\"https://www.paloaltonetworks.com/resources/datasheets/unit-42-deep-and-dark-web-service\">Deep and Dark Web Service</a> 获取量身定制的对手情报、分析师直接咨询以及专门的暴露情况追踪。Unit 42 Threat Intel Services 提供的资源包括对 Unit 42 观察到的 AI 赋能红队生态的更深入技术分析。</p><p>如果您认为自己可能已遭入侵，或有紧急事项，请联系 <a href=\"https://start.paloaltonetworks.com/contact-unit42.html\">Unit 42 Incident Response 团队</a>，或致电：</p><ul>\n<li>北美：免费电话：+1 (866) 486-4842 (866.4.UNIT42)</li>\n<li>英国：+44.20.3743.3660</li>\n<li>欧洲和中东：+31.20.299.3130</li>\n<li>亚洲：+65.6983.8730</li>\n<li>日本：+81.50.1790.0200</li>\n<li>澳大利亚：+61.2.4062.7950</li>\n<li>印度：000 800 050 45107</li>\n<li>韩国：+82.080.467.8774</li>\n</ul><h2 id=\"sec-12\">其他资源</h2><ul>\n<li><a href=\"https://unit42.paloaltonetworks.com/autonomous-ai-cyber-attack-campaign/\">Chinese-Speaking Threat Actor Harnesses AI Models for Autonomous Cyberattacks</a> – Unit 42, Palo Alto Networks</li>\n<li><a href=\"https://unit42.paloaltonetworks.com/ai-assisted-cybercrime-analysis/\">“Next Exploit Opportunities”: How a Threat Actor Used AI to Help Plan and Execute Multiple Types of Cybercrime Activities</a> – Unit 42, Palo Alto Networks</li>\n<li><a href=\"https://x.com/Unit42_Intel/status/2117314565973184687\">We’ve observed intrusion attempts against multiple targets using #ARTEX</a> – Unit 42 timely threat intelligence on X</li>\n<li><a href=\"https://www.reuters.com/world/china/chinese-developer-makes-artex-ai-agent-closed-source-after-korean-bank-hack-2026-10-09/\">Chinese developer makes ARTEX AI agent closed-source after Korean bank hack</a> – Reuters</li>\n</ul>","original","zhKind","translation","complete","Agent 安全","大模型","云原生","Palo Alto","https://unit42.paloaltonetworks.com/artex-and-ai-powered-red-teaming-tools/","Unit 42",{"_129":130,"_131":-5},"changelogVersion","2026-10-01T08:00","release"]
