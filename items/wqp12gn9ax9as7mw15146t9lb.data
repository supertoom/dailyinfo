[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794616835000,"id","wqp12gn9ax9as7mw15146t9lb","title","Astro `/_image` 端点路径校验缺陷可读取输出目录外图像文件","originalTitle","Astro: Image endpoint in @astrojs/node can read files from a case-variant sibling of the output directory on case-sensitive filesystems","summary","Astro 的 `/_image` 端点在大小写敏感文件系统中以不区分大小写方式校验输出目录，允许未认证攻击者读取仅大小写不同的相邻目录中的图像文件。利用需使用 `@astrojs/node` 按需渲染、相关目录预先存在，且攻击者无法自行创建该目录；受影响版本为 astro >= 5.14.3, <= 7.4.6，升级至 7.4.7 可修复，仅升级 `@astrojs/node` 不足以解决。","reason","source",{"_70":82},"links",{"_59":81},"publishedAt","2026-11-13T18:35:59.000Z","discoveredAt","2026-11-13T18:51:25.893Z","timelineAt","category","vuln","tags",[77,78,79,80],"score",36,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fig0j3Chu9rQ","reportCount",1,"additionalSourceCount",0,{"_68":30,"_70":72},{"_68":69,"_70":71},"slug","research","name","技术研究","漏洞披露",{"_74":75,"_13":76},"publicId","5007aae8-f458-4668-85a5-595741c1540b","Astro 图像端点目录绕过漏洞已修复","漏洞","补丁","漏洞分析","网络设备","https://github.com/advisories/GHSA-r3h5-4585-7x3w","GitHub 安全公告",{"_84":85,"_86":-5},"changelogVersion","2026-10-01T08:00","release"]
