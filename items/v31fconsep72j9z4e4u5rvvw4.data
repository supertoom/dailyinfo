[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1794616834000,"id","v31fconsep72j9z4e4u5rvvw4","title","CSC Telecom 欧洲电信数据泄露暴露 Swedbank、SEB、airBaltic 等机构客户端信息","originalTitle","Huge European telecom leak exposes Swedbank, SEB, airBaltic and dozens of other companies’ clients","summary","CSC Telecom 发生大规模数据泄露，暴露了125 million text messages，受影响对象包括 Swedbank、SEB、应急服务机构、airBaltic 以及数十家零售商。现有材料仅说明泄露内容和规模，未提供泄露原因、暴露数据字段或处置进展。","reason","材料指出泄露规模达到125 million text messages，并列出多家金融、航空及应急服务机构的客户端，可用于评估自身通信数据是否暴露在类似事件中。","source",{"_71":79},"links",{"_61":78},"publishedAt","2026-11-11T09:00:02.000Z","discoveredAt","2026-11-11T09:06:44.220Z","timelineAt","category","activity","tags",[72,77],"score",70,"selected",true,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","Vilius Petkauskas","body","outline",[],"relatedStories",[73],"topics",[68],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","original","factId","fhb5-qX_aYhQ","reportCount",1,"additionalSourceCount",0,{"_69":70,"_71":72},"slug","attack","name","攻击活动",{"_74":75,"_13":76},"publicId","2373e595-bb98-4285-8225-e2e3e9eb7f35","欧洲电信1.25亿条短信泄露","数据泄露","https://cybernews.com/security/csc-telecom-leaks-swedbank-seb-sms-messages/","Cybernews",{"_81":82,"_83":-5},"changelogVersion","2026-10-01T08:00","release"]
