[{"_1":2,"_3":4},"root",{"_5":91},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794530487000,"id","le11re72cnlk62zbp383lzfk5","title","MongoDB Server 预认证 use-after-free 漏洞 CVE-2026-118383 可在故障转移时崩溃","originalTitle","Critical Pre-Auth MongoDB Flaw (CVE-2026-118383) Can Crash Lagging Servers on Failover","summary","MongoDB Server 的 CVE-2026-118383 允许未认证攻击者发送两个带 readConcern.afterOpTime 的 ping 请求，在受影响节点落后且随后赢得选举时触发 use-after-free 并使数据库崩溃；CVSS 4.0 评分为 9.5。","reason","原文通过复制集实验还原了崩溃触发链，并给出版本、补丁、日志特征和临时网络限制，便于评估暴露风险与排查节点。","source",{"_72":90},"links",{"_80":89},"publishedAt","2026-11-12T09:25:00.000Z","discoveredAt","2026-11-12T10:28:25.620Z","timelineAt","category","vuln","tags",[84,85,86,87,88,73],"score",80,"selected",true,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_61":79,"_80":-5,"_81":82,"_83":37},"outline",[],"relatedStories",[75],"topics",[68,69],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","f1bDAlRKcUMs","reportCount",1,"additionalSourceCount",0,{"_70":31,"_72":74},{"_70":71,"_72":73},"slug","research","name","技术研究","漏洞披露",{"_76":77,"_13":78},"publicId","dd42e323-32c2-4bce-8719-84d8dd387132","MongoDB预认证崩溃漏洞已被复现","<p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEj6RJLDSM13MwenwxG4xnZ-Td2_zmnya-Y39FLHlNk-7P3hZ5w1qGjG3XFqT-4gaeZIxSepWWNM53bKTIkZBNA-X_tVKsrgWbw8u81mjLzL6dXvTtvKfKeT-FkwSz4CsdMoHNza2NRFy0PJzzmaMROCr3D7e6AKT5UR3Lh4zFb_1w9HMmXXKKvATVWHU-E/s1600/mongo-poc.gif\"><img alt=\"\" src=\"/dailyinfo/media/e3e8fb827504ceae.gif\" loading=\"lazy\" decoding=\"async\"></a></p><p><strong>MongoDB </strong>Server 中的一个严重漏洞允许未经身份验证的攻击者发送两个请求，从而导致数据库服务器崩溃。只有在该服务器之后被选为接管主服务器、且仍缺少某些近期更改时，才会发生崩溃。</p><p>制作该数据库的 MongoDB 公司于本周早些时候发布了修复版本。</p><p>受影响的服务器是副本集的成员。副本集是一组保存相同数据副本的 MongoDB 服务器。其中一个成员（主服务器）充当主服务器并处理所有新写入操作，其他成员则复制这些写入。如果主服务器不可用，其他成员会举行选举以选出新的主服务器。</p><p>Datadog Security Labs 的研究人员在实验室中复现了该崩溃，并于昨日公布了研究结果。研究人员称，在易受攻击的版本上，启用身份验证也无法阻止这两个请求。攻击者无法使目标成员落后或在选举中获胜，也无法获知任何一种情况何时发生。</p><p>该漏洞的跟踪编号为 <b>CVE-2026-118383</b>，属于释放后重用：服务器最终使用了已经释放的内存。MongoDB 在 CVSS 4.0 严重性评分标准上将其评为 10 分中的 9.5 分。该公司表示，是公司自行发现了此漏洞，并且“并未发现任何试图利用此漏洞的行为”。</p><p>受影响的成员包括分片集群中的分片服务器和配置服务器成员。独立的 mongod（即不隶属于任何副本集的单一服务器）不受影响。</p><p>每个受影响的分支都有一个修复版本，列表如下并列于 <a href=\"https://www.cve.org/CVERecord?id=CVE-2026-118383\">CVE 记录</a>中。分支中早于该版本的每一个版本都受到影响，可一直追溯到该分支的首个版本。</p><p>MongoDB 表示，MongoDB Atlas 集群会在维护期间自动获得修复版本，详情见其<a href=\"https://www.mongodb.com/community/forums/t/important-mongodb-security-update-available-action-required-november-10-2026/344843\">安全公告</a>。推迟维护的客户应尽快应用升级。</p><p>自托管部署需要让每个副本集成员都使用修复版本。升级后，应检查每个成员正在运行的版本，包括容器中的成员以及维护期间处于离线状态的任何成员。</p><p>8.2 分支不在列出的受影响版本之中，其最新版本为 8.2.12。但 GitHub 上发布的一份概念验证报告称，在使用仅限测试的设置进行实验室测试时，8.2.12 仍表现出该漏洞。</p><p>根据该公司的<a href=\"https://www.mongodb.com/legal/support-policy/lifecycles\">生命周期计划</a>，8.2 分支已于 7 月 31 日结束生命周期。此后，版本不再获得修复，包括安全修复。</p><p>在成员能够升级之前，研究人员建议将数据库的网络访问限制为仅允许需要访问的系统。这样可以限制谁能发送这两个请求，但无法修复该漏洞。</p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgFvCgaKq50Iyn5bVolEzz7diHfYWqVO8ANP4Gx-xQ21wzf593y3luu0yylvi9tgwPeXr3Rc5JAGiZiYIvuEABi4pIUO5q8ZUgNKNaa5QpyaszewYmvpoRqQa7WSmR8GT-k81L_-MoPnd_WgcvmmclC2ZC56p1qq5x6tJfN9PdOB7lfqaV0e28n1P_toto/s1600/mongo.jpg\"><img alt=\"\" src=\"/dailyinfo/media/b1081cffe5fe82a7.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>据 Datadog 研究人员的<a href=\"https://securitylabs.datadoghq.com/articles/cve-2026-118383-mongodb-server-use-after-free/\">技术分析</a>，首先赢得选举的成员会先应用其错过的写入操作以完成追赶，然后再接受新的写入操作。该漏洞存在于这一步追赶操作结束时所执行的清理过程中。</p><p>这两个请求都是携带 readConcern.afterOpTime 值的 ping 命令。每个命令都要求服务器等待复制达到某个特定时点，服务器会为其记录一个待处理通知，称为 <strong>waiter</strong>。</p><p>植入这些 waiter 并不会使服务器崩溃。它们不会过期，而是一直保留到该成员重启、回滚或从主服务器角色退下为止。</p><p>崩溃需要接收请求的成员在之后的选举中获胜，即使该成员落后于另一名成员。追赶结束时，清理流程会运行两次，重复使用已经释放的内存，而新的主节点在接受任何写入之前就会崩溃。研究人员表示，一旦满足这些条件，崩溃并不取决于赢得计时竞争。</p><p>在实验室中，研究人员使用管理员权限暂停和停止 mongod 进程，迫使该成员落后并自行触发故障转移。只有这两个请求来自一个没有凭据的客户端，并且该客户端无法向数据库写入。</p><p>在 8.0.34 版本中，该成员因段错误而崩溃，导致实验室集群失去主节点。其他部署可能会选出一台新的主节点并继续运行。</p><p>在已修复的 8.0.37 版本中，服务器立即将两个请求都判定为未授权并予以拒绝，该成员继续运行。修复的一部分只允许系统用户使用 readConcern.afterOpTime。</p><p>MongoDB 表示，在某些条件下，该缺陷还可能导致服务器进程中的任意代码执行。不过，研究人员表示，他们在实验室中“未能实现代码执行”。他们的结果也未表明该攻击在其他配置中成功的频率。</p><p>据其作者称，<a href=\"https://github.com/googlesky/CVE-2026-118383\">概念验证代码</a>在实验室副本集中重现了该漏洞。其可靠模式需要一个仅供测试使用的设置，远程攻击者无法启用该设置。它所声明的影响是崩溃或内存损坏，并未声称能够实现代码执行。</p><p>研究人员表示，修复的第二部分可以防止清理流程即使已有等待者存在也运行两次。他们没有亲自测试这一部分。</p><p>在关闭身份验证的概念验证实验室测试中，修复后的 8.0.37 接受了植入的等待者，但仅运行了一次清理流程。</p><p>要检查是否存在植入行为或崩溃，请查看服务器的结构化日志，寻找研究人员在存在漏洞的运行中发现的以下迹象：</p><ul>\n  <li><strong>日志事件：</strong>一条 COMMAND \"Slow query\" 条目（ID 51803），对应一个未通过身份验证且携带 readConcern.afterOpTime 的 ping 请求，并以 MaxTimeMSExpired 结束。</li>\n  <li><strong>日志事件：</strong>一个成员进入主节点追赶状态（ID 21359），随后在一次状态转换中两次退出该状态（ID 21363）。</li>\n  <li><strong>日志事件：</strong>在上述两次退出之后，出现涉及 CatchupState::abort_inlock() 的致命信号或回溯。</li>\n</ul><p>正常的选举或单次追赶退出并不能指向该缺陷。这些请求也可能在故障转移之前到达，因此还应检查同一成员更早的日志。</p><p>请求字段是否会被记录取决于日志设置，attr.remote 字段可能显示环回地址，而不是客户端的真实 IP。</p><p>觉得这篇文章有意思吗？关注我们的 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a>，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","漏洞","复现","补丁","漏洞利用","数据库","https://thehackernews.com/2026/11/critical-pre-auth-mongodb-flaw-cve-2026.html","The Hacker News",{"_92":93,"_94":-5},"changelogVersion","2026-10-01T08:00","release"]
