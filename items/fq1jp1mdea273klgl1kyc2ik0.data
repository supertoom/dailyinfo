[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795394432000,"id","fq1jp1mdea273klgl1kyc2ik0","title","GnuPG 披露 GPGME 双重释放漏洞 CVE-2026-129975","originalTitle","GnuPG Warns Critical GPGME Flaw Could Expose App Data via Malicious OpenPGP Keys","summary","GnuPG 披露 GPGME 内存漏洞 CVE-2026-129975，含异常长 User ID 的恶意 OpenPGP 密钥可触发双重释放，影响 2.3.0 之前使用 GPGME 的软件，包括多数邮件客户端、部分 XMPP 客户端、Samba、Gpg4win、GnuPG Desktop 与 GnuPG VS-Desktop。","reason","source",{"_72":97},"links",{"_61":96},"publishedAt","2026-11-21T11:05:53.000Z","discoveredAt","2026-11-21T11:26:46.562Z","timelineAt","category","vuln","tags",[92,93,94,95],"score",66,"selected",false,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_88":-5,"_61":89,"_90":-5,"_91":36},"outline",[82],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fm-91ToPc_vA","reportCount",1,"additionalSourceCount",0,{"_71":76,"_72":77},{"_71":74,"_72":75},{"_71":30,"_72":73},"slug","name","漏洞披露","email","邮件与钓鱼","supply-chain","供应链安全",{"_79":80,"_13":81},"publicId","4205bea9-57d3-4b49-9105-fb1d22e1abf7","GnuPG披露GPGME双重释放漏洞",{"_11":83,"_84":85,"_86":87},"sec-1","text","What to Update","level",3,"zh","<p><span><i></i><span>Ravie Lakshmanan</span><i></i><span>Nov 21, 2026</span></span><span>Vulnerability / Software Security</span></p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiTmX4ayWzvM0EzPttZ610B2837FppeU5AEmQmztLH2lai78EDQtjrp4wVI_bubSe2c2NGBE5sqBT9Py1mKkHQKN2faBkOzU70d7FntrpYD7Et2eeBxLNy2gzByAo1i8Aaw_VMBZD62RnBMY2md3iNfegK9M_NR5qTRDBw8s0uwKy1w7JoTV0zkDS_17Lse/s1600/pgp.jpg\"><img alt=\"\" src=\"/dailyinfo/media/b6ecfc4d4694cbe3.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>A malicious <strong>OpenPGP </strong>key with an unusually long user ID can trigger a critical memory bug in <strong>GPGME</strong>, the standard library that programs use to work with GnuPG.</p><p>The GnuPG project warned yesterday that the flaw could be used to steal data from affected applications and has released fixed versions.</p><p>The bug, tracked as <strong>CVE-2026-129975</strong>, affects all software that uses GPGME before version 2.3.0, whether the library is loaded as a shared library, a Windows DLL, or statically linked into the program.</p><p>Examples the project gives include most mail clients, many XMPP clients, Samba, and its own Gpg4win, GnuPG Desktop, and GnuPG VS-Desktop packages.</p><p>The project has not reported any attacks exploiting the flaw, and it notes that remote code execution cannot be ruled out.</p><p>Its example of a path to the bug is signed data sent to an application. Which programs pass such material to the library without a manual key import is not something the advisory says.</p><p>The flaw is a double free, meaning the same memory is released twice. It sits in two routines, read_status() and read_colon_line(), that read status lines and key listings coming back from GnuPG.</p><p>When the input runs long, the routines move the data to a larger buffer but record the new address only if they finish without errors. An error in between leaves a pointer to memory that was already freed, and cleanup then frees it a second time, as the project's <a href=\"https://static.dev.gnupg.org/T8557.html\">tracker entry</a> details.</p><p>The flaw was found by Johan Carlsson and reported to the project by GitLab last week. Disclosure was set for November 25, the advisory says, and moved up because the new Ruby2Shell bug forced the company to update earlier.</p><h3 id=\"sec-1\">What to Update</h3><p>The fixed library version is GPGME 2.3.1, released this week. A version 2.3.0 was never publicly available.</p><p>What to install depends on where the library sits:</p><ul>\n  <li><strong>Shared library or DLL</strong>: update to GPGME 2.3.1, available from the project's <a href=\"https://gnupg.org/download/\">official downloads</a> and detailed in its <a href=\"https://lists.gnupg.org/pipermail/gnupg-announce/2026q4/000517.html\">security advisory</a>.</li>\n  <li><strong>Windows</strong>: Gpg4win 5.1.2 bundles the fixed library. Its <a href=\"https://www.gpg4win.org/change-history.html\">release notes</a> call the issue severe and say to update as soon as possible.</li>\n  <li><strong>Older versions that cannot move to 2.3.1</strong>: the advisory carries a patch, and the legacy branch has its own fixed release, 1.24.4, whose <a href=\"https://dev.gnupg.org/T7659.html\">legacy release notes</a> say the project cannot guarantee that the branch will see every security patch.</li>\n  <li><strong>Bundled and statically linked copies</strong>: these are affected too, and updates to the system's shared library do not reach them, so the applications that contain them need their own rebuilt releases.</li>\n  <li><strong>GPGMEPP and GPGMEQT</strong>: no update is needed.</li>\n</ul><p>The advisory offers no interim workaround for software that cannot update yet.</p><p>Found this article interesting?  Follow us on <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>, <a href=\"https://twitter.com/thehackersnews\">Twitter</a> and <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a> to read more exclusive content we post.</p>","zhKind","complete","漏洞","补丁","邮件安全","供应链","https://thehackernews.com/2026/11/gnupg-warns-critical-gpgme-flaw-could.html","The Hacker News",{"_99":100,"_101":-5},"changelogVersion","2026-10-01T08:00","release"]
