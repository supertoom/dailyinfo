[{"_1":2,"_3":4},"root",{"_5":96},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1793621624000,"id","dqku1qmvsmn2ivjwh96rpu8da","title","Chainalysis 披露 AI Agent 安全事件，部分客户数据遭未授权访问","originalTitle","Chainalysis Warns Customers After “Offensive Agentic” Security Incident","summary","Chainalysis 披露其平台遭外部攻击者使用“offensive agentic techniques”越权访问内部系统和工具，部分客户数据被获取，涉及用户 ID、完整姓名、电子邮箱及组织角色标签。","reason","source",{"_72":95},"links",{"_60":94},"publishedAt","2026-11-02T09:30:00.000Z","discoveredAt","2026-11-02T09:42:34.509Z","timelineAt","category","activity","tags",[75,92,73,93,77],"score",68,"selected",false,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","body",{"_88":-5,"_60":89,"_90":-5,"_91":36},"outline",[82],"relatedStories",[78],"topics",[67,68,69],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fxhNzzYj4hPo","reportCount",5,"additionalSourceCount",4,{"_70":76,"_72":77},{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","ai-security","name","AI 安全","attack","攻击活动","identity","身份与访问",{"_79":80,"_13":81},"publicId","038a18c5-a6fe-4fe6-89fe-22bf5ade225b","Chainalysis确认智能体化入侵事件",{"_11":83,"_84":85,"_86":87},"sec-1","text","A Warning for Customers","level",2,"zh","<p><img src=\"/dailyinfo/media/25794e639f2e88fe.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Photo of Phil Muncaster\"></p><p>\n\tA leading blockchain analytics company has revealed details of a security breach involving an AI agent.</p><p>\n\tChainalysis said in a post on October 30 that an external actor used “offensive agentic techniques” to gain unauthorized access to undisclosed internal systems and tools.</p><p>\n\t“Some non-sensitive customer data, such as user IDs, full names, email addresses and organization role labels for users provisioned on our platform were accessed, including such information relating to your organization and users,” it continued.</p><p>\n\t“We are in the process of determining the records for your organization that were accessed and will provide a detailed breakdown as soon as that analysis is complete.”</p><p>\n\t<a href=\"https://www.infosecurity-magazine.com/news/ai-agent-carries-out-multistage/\"><em>Read more on agentic attacks: AI Agent Carries Out Multi-Stage Data Theft Attack.</em></a></p><p>\n\tChainalysis clarified that the incident is unrelated to the <a href=\"https://www.infosecurity-magazine.com/news/binance-record-hack-crypto-heist/\">Binance heist last week</a>. It also claimed to have no evidence that the threat actor was able to access investigation content like graphs, notes or cases, or transaction query results.</p><p>\n\tThese sensitive pieces of data could allow an unauthorized third party to snoop on blockchain investigations carried out by Chainalysis customers. The firm has been busy this week helping the community to understand who carried out the Binance raid, for example.</p><p>\n\tThe firm also said that it had no evidence that clear-text passwords, multifactor authentication (MFA) secrets or user session tokens had been accessed, meaning customer accounts should be safe.</p><h2 id=\"sec-1\">\n\t<strong>A Warning for Customers</strong></h2><p>\n\tHowever, Chainalysis did warn customers about possible follow-on attacks.</p><p>\n\t“Chainalysis users should continue to be hyper-vigilant of unexpected password reset requests or authentication prompts,” it said.</p><p>\n\t“If your organization has not yet enabled two-factor authentication, we strongly recommend doing so. Your Chainalysis account manager can help you complete that process.”</p><p>\n\tThe firm said it has been working “around the clock” to investigate the unauthorized activity, patch any affected vulnerabilities and harden its systems.</p><p>\n\t“We have engaged world-class third-party cybersecurity experts and are using sophisticated large language models to support a broader review of our platform’s security and strengthen our defenses,” it added.</p><p>\n\t“This work extends beyond the exploited vulnerabilities to enhance our security posture across the platform.”</p><p>\n\t<em>Image credits:&nbsp;Wirestock Creators / Mamun_Sheikh / Shutterstock.com</em></p>","zhKind","complete","数据泄露","Agent 安全","https://www.infosecurity-magazine.com/news/chainalysis-customers-offensive/","Infosecurity Magazine",{"_97":98,"_99":-5},"changelogVersion","2026-10-01T08:00","release"]
