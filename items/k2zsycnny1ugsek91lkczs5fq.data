[{"_1":2,"_3":4},"root",{"_5":93},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1795567282000,"id","k2zsycnny1ugsek91lkczs5fq","title","N-able 修复 Mail Assure 与 SpamExperts SSRF 漏洞 CVE-2026-134624","originalTitle","N-able Patches Critical Flaw Discovered After Mail Assure Cyberattack","summary","N-able 修复了 Mail Assure 与 SpamExperts Hosted Cloud 服务中的 SSRF 漏洞 CVE-2026-134624，CVSS 评分为 9.3。","reason","source",{"_73":92},"links",{"_81":91},"publishedAt","2026-11-23T15:06:49.000Z","discoveredAt","2026-11-23T15:18:32.507Z","timelineAt","category","vuln","tags",[87,88,74,89,90],"score",70,"selected",true,"channel","news","story",{"_77":78,"_13":79},"x","sameEvent",{"_11":85,"_13":86},"readingMode","full","author","Ionut Arghire","body",{"_62":80,"_81":-5,"_82":83,"_84":36},"outline",[],"relatedStories",[76],"topics",[69,70],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","f60ehnx7lCIk","reportCount",2,"additionalSourceCount",1,{"_71":30,"_73":75},{"_71":72,"_73":74},"slug","exploited","name","在野利用","漏洞披露",{"_77":78,"_13":79},"publicId","7da16a9c-11e3-43f6-aefe-dc060e4175a2","N-able修复托管云SSRF漏洞","<p><strong>N-able 已修补一个关键的服务器端请求伪造（SSRF）漏洞。该漏洞是在其调查上周针对 Mail Assure 和 SpamExperts Hosted Cloud 服务的网络攻击时发现的。</strong>\n\n\n\n</p><p>11 月 16 日，该公司禁用了门户和 API 的访问，并暂停了相关服务，包括日志记录、邮箱同步、管理门户和隔离区，同时指出邮件投递未受影响。\n\n\n\n</p><p>两天后，该公司确认这些服务<a href=\"https://www.securityweek.com/n-able-blames-service-disruption-on-cyberattack/\">成为网络攻击的目标</a>，攻击者入侵了一台 Web 服务器，可能访问了存储在其上的某些凭据。\n\n\n\n</p><p>该公司立即启动了响应和修复措施，控制了此次事件，变更了凭据，并撤销了 API 令牌和 OAuth 令牌。\n\n\n\n</p><p>11 月 21 日，N-able <a href=\"https://uptime.n-able.com/event/202672/\">恢复了</a> Mail Assure 和 SpamExperts 仪表板及 API 的访问，同时继续监控相关环境。公司表示，尚未发现除此前识别的 N-able 托管服务器之外存在被利用的证据。\n\n\n\n</p><p>周日，N-able <a href=\"https://www.n-able.com/blog/mail-assure-incident-update\">披露</a>已修补一个在调查过程中发现的 SSRF 漏洞。该漏洞被追踪为 <a href=\"https://me.n-able.com/s/security-advisory/aArVy0000002mrlKAA/cve2026134624-mailassure-ldap-sync-connection-check-ssrf\">CVE-2026-134624</a>（CVSS 评分为 9.3），其成因是存在漏洞的服务“在配置中继时执行 LDAP 同步连接检查，但未限制该连接的目标”。</p><p><span>广告。继续滚动阅读。</span></p><p>该漏洞可能允许具有足够权限的 API 用户使存在漏洞的服务器连接到任意内部主机和端口，识别可达目标，并向内部服务发送精心构造的数据。\n\n\n</p><p>“N-able 已修复近期影响其 Mail Assure 和 SpamExperts 环境的安全事件，并恢复了受影响的功能。迄今为止的调查显示，利用活动仅限于一台由 N-able 托管的服务器；修复后持续开展监测，未发现进一步的恶意活动，”该公司告诉 <em>SecurityWeek</em>。\n\n\n\n</p><p>N-able 还表示，针对该事件的调查仍在继续，并称将在未来两周内通过正式的根本原因分析提供更多事件细节。\n\n\n\n</p><p>Mail Assure/SpamExperts 版本 20261121.1943 包含针对该安全缺陷的补丁。&nbsp;\n\n\n\n</p><p><strong>相关：</strong> <a href=\"https://www.securityweek.com/industry-reactions-to-major-outages-and-ai-patching-questions-feedback-friday/\">行业对重大中断与 AI 补丁修复之争的反应：周五反馈</a>\n\n\n\n</p><p><strong>相关：</strong> <a href=\"https://www.securityweek.com/tor-updates-dos-defenses-again-as-relay-attacks-continue/\">随着中继攻击持续，Tor 再次更新 DoS 防御措施</a>\n\n\n\n</p><p><strong>相关：</strong> <a href=\"https://www.securityweek.com/phpaftershell-vulnerability-revives-php2shells-attack-path/\">phpAfterShell 漏洞使 PHP2Shell 的攻击路径重现</a>\n\n\n\n</p><p><strong>相关：</strong> <a href=\"https://www.securityweek.com/sap-netweaver-cisco-expressway-flaws-exploited-in-attacks/\">SAP NetWeaver、Cisco Expressway 漏洞在攻击中被利用</a>\n\n\n\n</p>","original","zhKind","translation","complete","aajexg5l1lr7nm55hqh656xqo","N-able 披露 Mail Assure 与 SpamExperts Hosted Cloud SSRF 漏洞 CVE-2026-134624","漏洞","补丁","利用链","网络设备","https://www.securityweek.com/n-able-patches-critical-flaw-disclosed-after-mail-assure-cyberattack/","SecurityWeek",{"_94":95,"_96":-5},"changelogVersion","2026-10-01T08:00","release"]
