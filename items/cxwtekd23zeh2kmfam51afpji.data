[{"_1":2,"_3":4},"root",{"_5":87},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":-5,"_57":36,"_58":59},"expiresAt",1795308032000,"id","cxwtekd23zeh2kmfam51afpji","title","Amazon 发现自主 AI Agent 利用未知漏洞入侵东亚高校","originalTitle","Cairn AI Framework Used in Autonomous Zero-Day Exploitation","summary","Amazon 威胁情报团队披露，一名疑似中国关联的操作者使用开源自主 AI 渗透框架 Cairn，在约 48 小时内攻击中国境外东亚地区高校 IP。","reason","source",{"_65":86},"links",{"_59":85},"publishedAt","2026-11-21T16:50:49.000Z","discoveredAt","2026-11-21T17:52:54.495Z","timelineAt","category","ai-security","tags",[66,83,72,70,68,84],"score",82,"selected",false,"channel","news","story","x","readingMode","full","author","Pierluigi Paganini","body",{"_79":-5,"_59":80,"_81":-5,"_82":36},"outline",[73],"relatedStories",[],"topics",[60,61,62,63],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_64":71,"_65":72},{"_64":69,"_65":70},{"_64":67,"_65":68},{"_64":30,"_65":66},"slug","name","AI 安全","attack","攻击活动","exploited","在野利用","ai-offense","AI 攻防",{"_11":74,"_75":76,"_77":78},"sec-1","text","Amazon uncovered AI-powered attacks on universities, where autonomous agents fou","level",2,"zh","<h2 id=\"sec-1\">Amazon uncovered AI-powered attacks on universities, where autonomous agents found a zero-day and gained root access without human guidance.</h2><p>Amazon’s threat intelligence team found a Chinese-nexus actor running Cairn, an open-source AI pentesting framework, with one instruction for the agents: obtain shell access. No human chose the next step after that. The agents planned, executed, and adjusted on their own, and along the way they found a real zero-day in an open-source medical imaging application.</p><p>The discovery happened because the operator left their own server exposed. On 10 September, Amazon spotted a publicly hosted Cairn instance running with no authentication, which meant anyone could see the project configurations, the prompts, and the AI’s output. The prompts were in Simplified Chinese, and script timestamps matched China Standard Time, over a roughly 48-hour campaign against university IP addresses in East Asia, outside mainland China.</p><p><em>“On September 10, 2026, Amazon Threat Intelligence identified a server with a publicly hosted instance of Cairn, an open-source autonomous AI penetration-testing framework, running without authentication. Because the operator left the server publicly accessible, the operational history of the platform was visible to anyone on the internet, including project configurations, actor prompts, and AI output. The operator wrote prompts in Simplified Chinese, and the timestamps in executed scripts were configured to China Standard Time.” reads the <a href=\"https://aws.amazon.com/it/blogs/security/chinese-nexus-actors-cairn-ai-agents-found-a-zero-day-on-their-own/\">report</a> published by Amazon. “Analysis of the instance revealed a campaign targeting IP addresses associated with universities in East Asia outside mainland China over an approximately 48-hour period beginning September 8, 2026.”</em></p><p>Not all targets were vulnerable. At one university, the agents found a Redis server that did not require a password. They spent about 16 hours trying 148 different actions to break in. These included using Redis replication to load code, bypassing its security protections, changing configuration files, damaging memory, and exploiting <a href=\"https://securityaffairs.com/tag/log4shell\">Log4Shell</a> in a nearby service. When these attempts failed, they tried another approach. They exploited an SSRF vulnerability in a Qdrant server on the same network to explore internal systems. They then tried different passwords against PostgreSQL, SSH, and other services. None of these attempts succeeded, but the AI agents kept changing their tactics and trying new approaches.</p><p>In another attack, the agents targeted a university GPU server for more than six hours. They collected about 80 real usernames from university websites, faculty directories, research lab pages, archived websites, and academic papers. They then tried more than 30,000 username and password combinations against SSH and other systems, including a VPN server and the university portal. These attempts also failed to gain access.</p><p>The medical imaging target is where it worked. The agents mapped the application’s framework and API endpoints, found an upload parameter, tested it for path traversal, and had it: a working file-write vulnerability. From first mapping the API to writing arbitrary files took about 11 minutes.</p><p><em>“Against a target running an open-source medical imaging AI application, the outcome was different. The agents identified the application’s framework, mapped its API endpoints, and found an upload endpoint with a filename parameter.” continues the report. “They tested that parameter for path traversal, and the parameter was vulnerable. In about 11 minutes, the agents went from mapping the application’s API to arbitrarily writing files on the server.”</em></p><p>A later session turned that access into something worse. The agents wrote a Python reverse shell to sitecustomize.py, a file Python loads automatically on startup, then triggered a training endpoint that spawned a new process and imported the payload. That gave them a root shell with no human picking each step. Amazon assesses with high confidence this was a genuine zero-day, since no fix, advisory, or prior mention existed anywhere for the affected project.</p><p>The human operator came back once the agents had proven the bug worked. They handed the agents a proxy tunnel into a second university’s network, where a server ran the same vulnerable software, and told them to use that foothold to reach other machines. Amazon infers the actor had already used the same zero-day to set up that tunnel, which means one AI-found bug became the key to a second network.</p><p>Amazon notified the project’s maintainers, who shipped a fix and a security advisory. The affected universities weren’t AWS customers, so Amazon routed the warning through a government partner instead of reaching them directly. Separately, researchers at Gambit Security <a href=\"https://gambit.security/blog-posts/autonomous-ai-agents-online-retailers-25-a-company\">documented</a> a different, financially motivated actor using the same framework against online retailers, so this isn’t a one-off experiment confined to espionage.</p><p>The speed of these operations is the most important point. An AI agent that can find and exploit a zero-day in just a few minutes can move faster than most security teams can investigate a single alert. Even when the attacks failed, the agents kept working for 16 hours without breaks or time limits.</p><p>Amazon uses honeypots and network traffic analysis to automatically detect some of this activity at no extra cost. The wider lesson is that defenders need to focus on reliable threat detection and fast responses. </p><p><em>“To keep pace, organizations should prioritize high-confidence detections that trigger automated response, with humans overseeing outcomes rather than reviewing every individual action.” concludes the report.</em></p><p><strong>Follow me on Twitter:&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;hacking,&nbsp;CAIRN)</strong></p>","zhKind","complete","Agent 安全","AWS","https://securityaffairs.com/203664/ai/cairn-ai-framework-used-in-autonomous-zero-day-exploitation.html","Security Affairs",{"_88":89,"_90":-5},"changelogVersion","2026-10-01T08:00","release"]
