[{"_1":2,"_3":4},"root",{"_5":92},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":60,"_61":62},"expiresAt",1794616829000,"id","hbjgrefhm6gdjv6nmh92104zs","title","Barracuda 两漏洞 CVE-2026-116606 与 CVE-2026-111560 已被用于攻击","originalTitle","Recently Patched Barracuda Vulnerabilities Exploited in Attacks","summary","攻击者已在少量组织中利用 Barracuda 刚修复的 CVE-2026-116606 和 CVE-2026-111560，组合利用可绕过授权控制并取得设备 root 权限。","reason","两个已修复漏洞已被用于真实攻击，CISA已纳入KEV，文中还给出尝试次数、来源范围与管理界面暴露风险。","source",{"_74":91},"links",{"_62":90},"publishedAt","2026-11-11T07:53:51.000Z","discoveredAt","2026-11-11T08:05:40.253Z","timelineAt","category","vuln","tags",[87,75,88,89,78],"score",73,"selected",true,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","Ionut Arghire","body",{"_83":-5,"_62":84,"_85":-5,"_86":60},"outline",[],"relatedStories",[79],"topics",[69,70,71],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation",false,"bodyLanguage","original","factId","fAL44z_EmdFA","reportCount",2,"additionalSourceCount",1,{"_72":77,"_74":78},{"_72":31,"_74":76},{"_72":73,"_74":75},"slug","exploited","name","在野利用","漏洞披露","cisa","CISA",{"_80":81,"_13":82},"publicId","9dc3f3bc-b9b2-4928-b494-d7fa86c243f1","Barracuda ESG漏洞链已被在野利用","zh","<p><strong>Threat actors have started exploiting two recently patched</strong> <a href=\"https://www.securityweek.com/barracuda-email-security-gateway-authentication-bypass-opens-path-to-root/\"><strong>Barracuda vulnerabilities</strong></a> <strong>that could be chained to bypass authorization controls and gain root access.</strong>\n\n\n\n</p><p>Tracked as CVE-2026-116606 (CVSS score of 9.3), the first bug is described as an authentication bypass in Barracuda Email Security Gateway (ESG).\n\n\n\n</p><p>An attacker with access to the administrative user interface (Admin UI) could trigger it to restore a crafted backup archive and modify the appliance’s configuration.\n\n\n\n</p><p>The second flaw, CVE-2026-111560 (CVSS score of 8.6), is a command injection weakness affecting Barracuda ESG, Load Balancer Application Delivery Controller (ADC), Web Application Firewall (WAF), Web Security Gateway (WSG), Message Archiver (BMA), and WAF Control Center (WCC).\n\n\n\n</p><p>An attacker with administrative access to a vulnerable appliance could exploit the security hole to inject OS commands that would be executed with root privileges.\n\n\n\n</p><p>“If exploited in combination, these vulnerabilities could allow an attacker to bypass authorization controls and obtain root access to the device,” Barracuda said on November 2.</p><p><span>Advertisement. Scroll to continue reading.</span></p><p>A week later, the company updated its <a href=\"https://trust.barracuda.com/security/pre-authentication-authorization-bypass-command-injection\">advisory</a> to warn that threat actors have been exploiting the two security defects against a small number of organizations.\n\n\n\n</p><p>On Tuesday, the US cybersecurity agency CISA added CVE-2026-116606 and CVE-2026-111560 to its Known Exploited Vulnerabilities (<a href=\"https://www.cisa.gov/known-exploited-vulnerabilities-catalog\">KEV</a>) catalog, urging federal agencies to patch them within three days, as mandated by BOD 26-04.\n\n\n\n</p><p>Barracuda and CISA have not shared details on the exploitation, but cybersecurity firm <a href=\"https://previdian.com/CVE-2026-116606\">Previdian</a> has observed 17 attempts targeting CVE-2026-116606 between November 9 and November 11. The attacks came from 15 IP addresses in three countries.\n\n\n\n</p><p>All organizations are advised to update their Barracuda products as soon as possible and ensure that their administrative interfaces are not exposed to the internet. Access to them should be restricted only to trusted internal networks.\n\n\n\n</p><p><strong>Related:</strong> <a href=\"https://www.securityweek.com/bluetooth-airplay-pairing-vulnerabilities-patched-across-apple-platforms/\">Bluetooth, AirPlay Pairing Vulnerabilities Patched Across Apple Platforms</a>\n\n\n\n</p><p><strong>Related:</strong> <a href=\"https://www.securityweek.com/exploited-outlook-zero-day-among-1094-flaws-patched-by-microsoft/\">Exploited Outlook Zero-Day Among 1,094 Flaws Patched by Microsoft</a>\n\n\n\n</p><p><strong>Related:</strong> <a href=\"https://www.securityweek.com/adobe-patches-110-vulnerabilities-across-9-products/\">Adobe Patches 110 Vulnerabilities Across 9 Products</a>\n\n\n\n</p><p><strong>Related:</strong> <a href=\"https://www.securityweek.com/sap-patches-critical-icm2shell-proxygate-vulnerabilities/\">SAP Patches Critical ICM2SHELL, ProxyGate Vulnerabilities</a>\n\n\n\n</p>","zhKind","complete","漏洞","补丁","漏洞利用","https://www.securityweek.com/recently-patched-barracuda-vulnerabilities-exploited-in-attacks/","SecurityWeek",{"_93":94,"_95":-5},"changelogVersion","2026-10-01T08:00","release"]
