[{"_1":2,"_3":4},"root",{"_5":115},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1794271240000,"id","zghpc4nj0iecoj0z1g1co19fw","title","Apache OFBiz 未认证远程代码执行漏洞 CVE-2026-83542 已复现","originalTitle","【已复现】Apache OFBiz 未认证远程代码执行漏洞（CVE-2026-83542）","summary","Apache OFBiz < 24.09.08 存在未认证远程代码执行漏洞 CVE-2026-83542，长亭安全应急响应中心已完成复现，命令以 OFBiz 服务进程账号执行。","reason","通告完整拆解了未认证利用链，并提供受影响版本、官方补丁和复现验证，便于判断暴露面与处置优先级。","source",{"_73":114},"links",{"_104":113},"publishedAt","2026-11-09T08:45:00.000Z","discoveredAt","2026-11-09T17:28:20.117Z","timelineAt","category","vuln","tags",[107,108,109,110,111,112],"score",74,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","body",{"_61":103,"_104":-5,"_105":104,"_106":37},"outline",[82,83,84,85,86,87],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fbRCgl640KPs","reportCount",1,"additionalSourceCount",0,{"_71":76,"_73":77},{"_71":31,"_73":75},{"_71":72,"_73":74},"slug","research","name","技术研究","漏洞披露","chaitin","长亭科技",{"_79":80,"_13":81},"publicId","cb2d0a3a-a58a-4aa3-b2b1-2723602d4441","Apache OFBiz未认证远程代码执行漏洞已复现",{"_11":101,"_89":102,"_91":92},{"_11":99,"_89":100,"_91":92},{"_11":97,"_89":98,"_91":92},{"_11":95,"_89":96,"_91":92},{"_11":93,"_89":94,"_91":92},{"_11":88,"_89":90,"_91":92},"sec-6","text","参考资料","level",3,"sec-5","临时缓解方案","sec-4","升级修复方案","sec-3","处置优先级：高","sec-2","漏洞影响","sec-1","漏洞成因","<p><span>长亭安全应急响应中心</span> <span>2026-11-09 16:45</span> <span>浙江</span></p><p><img src=\"/dailyinfo/media/2e52672c9b113812.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>检测业务是否受到此漏洞影响，请联系长亭应急服务团队！</p><p><img alt=\"Apache OFBiz 远程代码执行漏洞风险提示\" src=\"/dailyinfo/media/9824f74e5f24aa37.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><span>Apache OFBiz 是 Apache 软件基金会开源的企业资源计划（ERP）套件，主要用于订单、库存、财务、内容与门户等业务管理，广泛应用于企业自有业务系统的构建、集成与扩展。</span></p><p><span>2026 年 11 月，长亭安全应急响应中心监测到 Apache OFBiz 远程代码执行风险。未认证攻击者可利用框架对请求属性和模板资源位置的处理缺陷，使服务端加载攻击者可控的页面资源，并以 OFBiz 服务进程权限执行任意命令。截至通告发布，Apache 官方已发布 24.09.08 修复版本。建议使用受影响版本的用户尽快排查资产暴露面并完成升级。</span></p><p><strong><span>漏洞描述</span></strong><span><span>&nbsp;Description&nbsp;</span></span></p><p><strong><span>01</span></strong></p><h3 id=\"sec-1\"><span>漏洞成因</span></h3><p><span>Apache OFBiz 以 widget/screen 模板驱动页面渲染，框架在渲染前会合并请求参数、会话数据与请求属性作为模板输入，并按 web.xml 中的配置决定默认装饰器（decorator）资源位置。</span></p><p><span>经分析，受影响版本存在以下缺陷串联：框架在解析请求体时未对写入请求属性的键名加以限制，匿名请求提交的字段可覆盖来自 web.xml 的受信任模板资源位置配置；ScreenFactory 在按该位置加载 screen 资源时协议校验不完整，未能阻止以本地文件协议引用路径，攻击者因此可让服务端从本地路径加载其可控的 widget 资源；widget 中的表达式在渲染阶段被求值，可执行 Groovy 脚本。</span></p><p><span>此外，请求上传阶段生成的临时文件在请求未结束时保持可读，可作为资源载体被同一进程加载，无需依赖其他文件写入能力。上述环节组合后，未认证攻击者即可在服务端执行命令。</span></p><h3 id=\"sec-2\"><span>漏洞影响</span></h3><p><span>攻击者可在目标服务器上以 OFBiz 服务进程账号执行任意命令，可能导致业务配置与数据库凭据泄露、业务数据被读取或篡改，并以此为跳板向内网进一步渗透。实际影响范围取决于服务进程权限、部署方式及主机所处网络位置。</span></p><h3 id=\"sec-3\"><span>处置优先级：高</span></h3><p><strong><span>漏洞类型：</span></strong><span>&nbsp;远程代码执行</span></p><p><strong><span>漏洞危害等级：</span></strong><span>&nbsp;高</span></p><p><strong><span>触发方式：</span></strong><span>&nbsp;网络远程</span></p><p><strong><span>权限认证要求：</span></strong><span>&nbsp;无需权限</span></p><p><strong><span>系统配置要求：</span></strong><span>&nbsp;默认配置</span></p><p><strong><span>用户交互要求：</span></strong><span>&nbsp;无需用户交互</span></p><p><strong><span>利用成熟度：</span></strong><span>&nbsp;POC 未公开</span></p><p><strong><span>修复复杂度：</span></strong><span>&nbsp;低，官方已提供修复方案</span></p><p><strong><span>影响版本</span></strong><span><span>&nbsp;Affects&nbsp;</span></span></p><p><strong><span>02</span></strong></p><p><span>Apache OFBiz &lt; 24.09.08</span></p><p><strong><span>解决方案</span></strong><span><span>&nbsp;Solution&nbsp;</span></span></p><p><strong><span>03</span></strong></p><h3 id=\"sec-4\"><span>升级修复方案</span></h3><p><span>建议升级至 Apache OFBiz 24.09.08 或更高版本，官方版本说明：<a href=\"https://ofbiz.apache.org/release-notes/24.09.08.html%E3%80%82%E8%AF%A5%E7%89%88%E6%9C%AC%E5%8A%A0%E5%BC%BA%E4%BA%86%E6%A8%A1%E6%9D%BF%E8%B5%84%E6%BA%90%E4%BD%8D%E7%BD%AE%E6%A0%A1%E9%AA%8C%EF%BC%8C%E9%BB%98%E8%AE%A4%E4%BB%85%E5%85%81%E8%AE%B8%E7%BB%84%E4%BB%B6%E5%8D%8F%E8%AE%AE%E8%B7%AF%E5%BE%84%EF%BC%8C%E5%B9%B6%E9%99%90%E5%88%B6%E8%AF%B7%E6%B1%82%E5%B1%9E%E6%80%A7%E8%A6%86%E7%9B%96%E5%B7%B2%E6%9C%89\">https://ofbiz.apache.org/release-notes/24.09.08.html。该版本加强了模板资源位置校验，默认仅允许组件协议路径，并限制请求属性覆盖已有</a> ServletContext 配置的行为。</span></p><p><span>升级前请确认现有自定义 widget、装饰器配置是否依赖本地文件路径，必要时按官方说明显式配置允许路径，避免升级后业务页面渲染异常。</span></p><h3 id=\"sec-5\"><span>临时缓解方案</span></h3><p><span>以下方案为应急临时措施，可能影响业务功能，升级完成后应及时移除。</span></p><ul><li><p><span>在反向代理、WAF 或网络访问控制层收敛业务系统的外部访问面，仅向必要来源开放；</span></p></li><li><p><span>遵循最小权限原则运行 OFBiz 服务进程，避免使用高权限账号，并限制其对敏感配置、数据库凭据等文件的访问；</span></p></li><li><p><span>加强对服务进程异常命令执行、异常模板加载及非预期本地文件读取行为的监测与告警，发现可疑请求及时处置。</span></p></li></ul><p><strong><span>漏洞复现</span></strong><span><span>&nbsp;Reproduction&nbsp;</span></span></p><p><strong><span>04</span></strong></p><p><span>长亭安全应急响应中心已完成复现验证。</span></p><p><img src=\"/dailyinfo/media/d91d7b3c9c1a964d.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span>未认证复现成功，命令以 OFBiz 服务进程账号执行</span></p><p><strong><span>产品支持</span></strong><span><span>&nbsp;Support&nbsp;</span></span></p><p><strong><span>05</span></strong></p><p><strong><span>云图：</span></strong><span>默认支持该产品的指纹识别，同时支持该漏洞的PoC原理检测</span></p><p><strong><span>洞鉴：</span></strong><span>默认支持该产品的指纹识别，预计2026.11.9发布应急POC</span></p><p><strong><span>无锋：</span></strong><span>默认支持该产品的指纹识别，同时支持该漏洞的PoC原理检测</span></p><p><span><span>全悉：</span></span><span><span>&nbsp;已发布更新包支持该漏洞利用行为的检测</span></span></p><p><span><span>雷池：</span></span><span><span>&nbsp;已发布自定义规则支持该漏洞利用行为的检测</span></span></p><p><strong><span>时间线</span></strong><span><span>&nbsp;Timeline&nbsp;</span></span></p><p><strong><span>06</span></strong></p><p><span>2026 年 11 月 9 日 长亭安全应急响应中心发布通告</span></p><h3 id=\"sec-6\"><span>参考资料</span></h3><p><span>[1]. <a href=\"https://cryptocat.me/blog/research/analysis/cve_2026_83542/\">https://cryptocat.me/blog/research/analysis/cve_2026_83542/</a></span></p><p><strong><span>长亭应急响应服务</span></strong></p><p><span>全力进行产品升级</span></p><p><span>及时将风险提示预案发送给客户</span></p><p><span>检测业务是否受到此次漏洞影响</span></p><p><span>请联系长亭应急服务团队</span></p><p><span>7*24小时，守护您的安全</span></p><p><span>第一时间找到我们：</span></p><p><span>邮箱：support@chaitin.com</span></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=c11afb43&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzIwMDk1MjMyMg%3D%3D%26mid%3D2247493515%26idx%3D1%26sn%3D3a5431b2b13fe474954932cae112deaf\">跳转微信打开</a></p>","original","zhKind","complete","漏洞","复现","漏洞分析","补丁","漏洞利用","长亭","https://mp.weixin.qq.com/s?__biz=MzIwMDk1MjMyMg==&mid=2247493515&idx=1&sn=3a5431b2b13fe474954932cae112deaf","长亭安全应急响应中心",{"_116":117,"_118":-5},"changelogVersion","2026-10-01T08:00","release"]
