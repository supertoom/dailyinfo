[{"_1":2,"_3":4},"root",{"_5":107},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1793667629000,"id","cyr7bz2bmyz5ecu55k6xo4e2y","title","Northflank 安全 breach 导致客户 AI API 密钥被滥用","originalTitle","Northflank security breach leads to abuse of customers' AI API keys","summary","Northflank 在安全 breach 后要求所有客户轮换平台内保存的环境变量、API 密钥及其他 secrets，并确认多名客户发现 AI API 密钥遭到未授权使用。","reason","Northflank 事件展示了平台环境变量解密后，攻击者如何滥用客户 AI API 密钥，并给出明确的密钥轮换与用量核查建议。","source",{"_74":106},"links",{"_96":105},"publishedAt","2026-10-31T18:01:12.000Z","discoveredAt","2026-10-31T18:18:14.404Z","timelineAt","category","activity","tags",[75,100,101,102,103,104],"score",71,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Lawrence Abrams","body",{"_61":95,"_96":-5,"_97":98,"_99":37},"outline",[86,87],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","f6EvnqvfWdcI","reportCount",1,"additionalSourceCount",0,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","attack","name","攻击活动","ai-agent","AI Agent 安全","identity","身份与访问","cloud-native","云与原生",{"_83":84,"_13":85},"publicId","7b268544-bf1e-48c3-a01a-a245d6983db3","Northflank安全事件致客户AI密钥被盗用",{"_11":93,"_89":94,"_91":92},{"_11":88,"_89":90,"_91":92},"sec-2","text","一旦攻击者拥有有效凭据，其行动仅有 37% 会被阻止","level",2,"sec-1","黑色十月","<p><img alt=\"Northflank\" height=\"900\" src=\"/dailyinfo/media/c178e46abf5684a3.jpg\" srcset=\"/dailyinfo/media/71dfb50d3bb330dd.jpg 720w, /dailyinfo/media/16f0a85ca8128916.jpg 1200w, /dailyinfo/media/c178e46abf5684a3.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>云应用托管平台 Northflank 正警告客户轮换其平台上存储的所有凭据和机密信息，此前的一起安全入侵导致客户 AI API 密钥被未经授权使用。</p><p>Northflank 是一个云平台，允许开发人员部署和管理应用程序、容器、数据库和 AI 应用，而无需管理底层基础设施。</p><p>该公司于 10 月 30 日<a href=\"https://status.northflank.com/\">披露了一起安全事件</a>，警告客户在收到云安全公司 Wiz 的威胁警报后，立即轮换其环境变量和 API 密钥。</p><p>不久后，Northflank 告知所有客户，应假定其环境变量已被解密，其中存储的机密信息也已被窃取。</p><p>“假定所有环境变量都已被解密。禁用/轮换所有密钥。”Northflank 在 10 月 30 日的更新中警告称。</p><p>应用程序通常使用环境变量存储敏感信息，包括数据库密码、云服务凭据、身份验证令牌和 API 密钥。</p><p>如果这些凭据泄露，可被用于入侵其他客户的服务，并可能通过 API 密钥导致数据窃取或未经授权的扣费。</p><p>Northflank 后来确认，多名客户报告称平台上存储的 AI API 密钥被未经授权使用。</p><p>“有用户报告称，提供给 Northflank 平台的 AI API 密钥被未经授权使用。”该公司表示。</p><p>“如果您尚未轮换存储在 Northflank 中的用户提供的机密信息，请立即进行轮换。”</p><p>客户还被建议检查其 AI 提供商的使用情况和账单日志，以发现异常活动，并将可疑使用情况报告给 Northflank 和其 AI 提供商。</p><p>根据 Northflank 公布的事件时间线，Wiz 于 10 月 30 日 11:43 UTC 就此次入侵向其发出警报，公司的工程师一分钟后进行了审查。</p><p>Northflank 迅速发布了网络策略补丁，随后又在 12:50 UTC 和 13:05 UTC 发布了更多补丁。该公司还请求 Wiz 的事件响应团队协助处理。</p><p>该公司尚未披露攻击者如何获取其系统访问权限、受影响的客户数量，也未说明攻击者是否窃取或滥用了除已报告的 AI API 密钥之外的凭据。</p><p>作为响应措施的一部分，Northflank 为 PostgreSQL、MongoDB、MySQL 和 Redis 启用了凭据轮换。</p><p>该公司还为所有客户启用了审计日志，包括使用免费账户的客户，以帮助他们调查任何可疑活动。</p><p>Northflank 继续建议客户轮换工作负载、机密信息组和全局机密信息中存储的机密信息，并在已启用的情况下禁用对附加组件的公共访问。</p><p>BleepingComputer 就此次入侵、对客户的影响以及存储的凭据是否被访问或窃取等问题联系了 Northflank，但尚未收到回应。</p><h2 id=\"sec-1\">黑色十月</h2><p>此次入侵发生在一系列针对 AI 开发平台的攻击之中。安全研究人员认为，这些平台是很有价值的目标，因为它们存储着可用于访问昂贵 AI 服务的 API 密钥。</p><p>在一份题为“<a href=\"http://www.wiz.io/blog/black-october-for-ai-developer-platforms\">AI 开发平台的黑色十月</a>”的报告中，Wiz 识别出本月至少有九起影响 AI 开发平台的安全事件，涉及 Northflank、<a href=\"https://www.bleepingcomputer.com/news/security/railway-warns-devs-to-rotate-secrets-after-potential-breach/\">Railway</a>、<a href=\"https://www.bleepingcomputer.com/news/security/opencode-hack-exposes-api-keys-amid-ai-distillation-attacks/\">OpenCode</a>、<a href=\"https://www.bleepingcomputer.com/news/security/warp-discloses-breach-exposing-ai-agent-logs-user-telemetry-data/\">Warp</a> 和 Lightning AI。</p><p>Railway 事件还涉及客户环境变量被解密后可能暴露的问题，而 OpenCode 则披露了暴露的 AI API 密钥。Warp 报告了一起泄露事件，暴露了 AI 智能体日志和用户遥测数据。</p><p>Wiz 表示，参与其中一些事件的攻击者专门针对包含 AI 服务凭据的环境变量，这类凭据可通过一种称为 <a href=\"https://www.bleepingcomputer.com/news/security/hackers-hijack-exposed-llm-endpoints-in-bizarre-bazaar-operation/\">LLMJacking</a> 的做法加以利用。</p><p>LLMJacking 是指使用被盗凭据，通过另一个组织的 API 密钥访问 AI 模型，从而产生巨额 API 费用，或将被盗访问权限转售。</p><p>在 Wiz 调查的两起案件中，被攻陷的企业凭据被用于发起约 250 万次 Amazon Bedrock API 调用，产生约 100,000 美元的 AI 使用费用。</p><p>研究人员还发现了与转售 AI 模型访问权限的服务相关的基础设施，不过他们无法将这些运营活动与最初的入侵事件或大规模滥用行为联系起来。</p><p>Wiz 尚未确认全部九起事件是否由同一批攻击者实施。然而，其中许多事件都涉及窃取 AI API 密钥的企图。</p><p>Northflank 在其事件更新中也引用了 Wiz 的研究，指出客户报告的 AI 密钥未授权使用可能与研究人员发现的攻击有关。</p><p><a href=\"https://hubs.li/Q04sB3fb0\">\n            <img src=\"/dailyinfo/media/ba68ad0723b4d270.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-2\">\n            <a href=\"https://hubs.li/Q04sB3fb0\">一旦攻击者拥有有效凭据，其行动仅有 37% 会被阻止</a>\n        </h2><p>整体防御评分可能会掩盖初始访问之后发生的情况。一旦攻击者开始使用有效凭据，防御效果就会大幅下降。</p><p>《Blue Report 2026》针对客户生产环境中运行的 3.38 亿次模拟，逐项衡量各项防御技术。</p><p><a href=\"https://hubs.li/Q04sB3fb0\">获取报告</a>\n    </p>","original","zhKind","translation","complete","数据泄露","凭据","云原生","容器","大模型","https://www.bleepingcomputer.com/news/security/northflank-security-breach-leads-to-abuse-of-customers-ai-api-keys/","BleepingComputer",{"_108":109,"_110":-5},"changelogVersion","2026-10-01T08:00","release"]
