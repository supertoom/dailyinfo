[{"_1":2,"_3":4},"root",{"_5":113},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1793667381000,"id","ktd3s060908mpza2145lg0d4c","title","Tenable Identity Exposure 多个漏洞影响 3.x，3.93.6 起提供修复","originalTitle","Multiples vulnérabilités dans Tenable Identity Exposure (02 novembre 2026)","summary","Tenable Identity Exposure 3.x 低于 3.93.6，以及低于 3.77.18 的版本存在多个漏洞，部分可导致远程任意代码执行、远程拒绝服务和数据机密性受损。对应漏洞为 CVE-2026-119314、CVE-2026-119315 和 CVE-2026-119316，CERT-FR 建议参阅厂商安全公告 tns-2026-34 获取修复程序。","reason","source",{"_70":112},"links",{"_60":111},"publishedAt","2026-11-02T00:00:00.000Z","discoveredAt","2026-11-02T15:43:33.936Z","timelineAt","category","vuln","tags",[109,110,73],"score",51,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body",{"_105":-5,"_60":106,"_107":-5,"_108":36},"outline",[78,79,80,81,82,83,84,85],"relatedStories",[74],"topics",[67,68],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","f8ENhQ5WhJOY","reportCount",1,"additionalSourceCount",0,{"_69":72,"_70":73},{"_69":30,"_70":71},"slug","name","漏洞披露","tenable","Tenable",{"_75":76,"_13":77},"publicId","fd6f57ea-d83c-4d34-8456-eb52ab6b53ab","CERT-FR披露Tenable多个漏洞",{"_11":103,"_87":104,"_89":90},{"_11":101,"_87":102,"_89":90},{"_11":99,"_87":100,"_89":90},{"_11":97,"_87":98,"_89":90},{"_11":95,"_87":96,"_89":90},{"_11":93,"_87":94,"_89":90},{"_11":91,"_87":92,"_89":90},{"_11":86,"_87":88,"_89":90},"sec-8","text","Gestion détaillée du document","level",2,"sec-7","Documentation","sec-6","Solutions","sec-5","Résumé","sec-4","Systèmes affectés","sec-3","Risques","sec-2","Gestion du document","sec-1","Avis du CERT-FR","zh","<h2 id=\"sec-1\">Avis du CERT-FR</h2><p>Objet : Multiples vulnérabilités dans Tenable Identity Exposure</p><h2 id=\"sec-2\">Gestion du document</h2><table>\n      <tbody>\n        <tr>\n          <th>Référence</th>\n          <td>CERTFR-2026-AVI-1436</td>\n        </tr>\n        <tr>\n          <th>Titre</th>\n          <td>Multiples vulnérabilités dans Tenable Identity Exposure</td>\n        </tr><tr>\n            <th>Date de la première version</th><td>02 novembre 2026</td>\n          </tr>\n          <tr>\n            <th>Date de la dernière version</th><td>02 novembre 2026</td>\n          </tr><tr>\n          <th>Source(s)</th>\n          <td>Bulletin de sécurité Tenable tns-2026-34 du 30 octobre 2026<br></td>\n        </tr>\n      </tbody>\n    </table><p>Une gestion de version détaillée se trouve à la fin de ce document.</p><h2 id=\"sec-3\">Risques</h2><ul>\n          \n            <li>Atteinte à la confidentialité des données</li>\n          \n            <li>Déni de service à distance</li>\n          \n            <li>Exécution de code arbitraire à distance</li>\n          \n        </ul><h2 id=\"sec-4\">Systèmes affectés</h2><ul>\n          \n            <li>Tenable Identity Exposure versions 3.x antérieures à 3.93.6</li>\n          \n            <li>Tenable Identity Exposure versions antérieures à 3.77.18</li>\n          \n        </ul><h2 id=\"sec-5\">Résumé</h2><p>De multiples vulnérabilités ont été découvertes dans Tenable Identity Exposure. Certaines d'entre elles permettent à un attaquant de provoquer une exécution de code arbitraire à distance, un déni de service à distance et une atteinte à la confidentialité des données.</p><h2 id=\"sec-6\">Solutions</h2><p>Se référer au bulletin de sécurité de l'éditeur pour l'obtention des correctifs (cf. section Documentation).</p><h2 id=\"sec-7\">Documentation</h2><ul>\n          \n          \n            <li>\n              <p>Bulletin de sécurité Tenable tns-2026-34 du 30 octobre 2026</p>\n              <a href=\"https://www.tenable.com/security/tns-2026-34\">https://www.tenable.com/security/tns-2026-34</a>\n            </li>\n          \n\n          \n          \n\n          \n            <li>\n              <p>Référence CVE CVE-2026-119314</p>\n              <a href=\"https://www.cve.org/CVERecord?id=CVE-2026-119314\">https://www.cve.org/CVERecord?id=CVE-2026-119314</a>\n            </li>\n          \n            <li>\n              <p>Référence CVE CVE-2026-119315</p>\n              <a href=\"https://www.cve.org/CVERecord?id=CVE-2026-119315\">https://www.cve.org/CVERecord?id=CVE-2026-119315</a>\n            </li>\n          \n            <li>\n              <p>Référence CVE CVE-2026-119316</p>\n              <a href=\"https://www.cve.org/CVERecord?id=CVE-2026-119316\">https://www.cve.org/CVERecord?id=CVE-2026-119316</a>\n            </li>\n          \n        </ul><h2 id=\"sec-8\">Gestion détaillée du document</h2><table>\n          <thead>\n            <tr>\n              <th>Date</th>\n              <th>Description</th>\n            </tr>\n          </thead>\n          <tbody><tr>\n              <td>02 novembre 2026</td>\n              <td>Version initiale</td>\n            </tr></tbody>\n        </table>","zhKind","complete","漏洞","补丁","https://www.cert.cyber.gouv.fr/avis/CERTFR-2026-AVI-1436/","CERT-FR",{"_114":115,"_116":-5},"changelogVersion","2026-10-01T08:00","release"]
