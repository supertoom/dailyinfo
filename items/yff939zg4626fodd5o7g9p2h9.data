[{"_1":2,"_3":4},"root",{"_5":116},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":60,"_61":62},"expiresAt",1794357646000,"id","yff939zg4626fodd5o7g9p2h9","title","White House 网络被检出 236 次住宅代理出口流量","originalTitle","Residential proxy traffic caught leaving the White House network","summary","Layer3 Intel 称，White House 网络在 10 月 5 日至 11 月 3 日的 30 天内通过 AS2650 形成 236 次住宅代理出口，涉及 6 个地址和 28 个住宅代理服务，任何人注册服务并付费即可使用该路径。","reason","文章展示了住宅代理流量如何借道高防护网络，并结合流量时段、设备特征和代理 SDK 提示潜在失陷路径。","source",{"_77":115},"links",{"_62":114},"publishedAt","2026-11-06T10:29:58.000Z","discoveredAt","2026-11-06T16:15:28.885Z","timelineAt","category","activity","tags",[80,82,78,86,111,112,113],"score",73,"selected",true,"channel","news","story",{"_90":91,"_13":92},"x","readingMode","full","author","Sinisa Markovic","body",{"_107":-5,"_62":108,"_109":-5,"_110":60},"outline",[93,94,95,96],"relatedStories",[89],"topics",[69,70,71,72,73,74],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation",false,"bodyLanguage","original","factId","fi6vS9voXH_0","reportCount",4,"additionalSourceCount",3,{"_75":87,"_77":88},{"_75":85,"_77":86},{"_75":83,"_77":84},{"_75":81,"_77":82},{"_75":79,"_77":80},{"_75":76,"_77":78},"slug","malware","name","恶意软件","attack","攻击活动","exploited","在野利用","black-market","数据窃取与黑产","botnet","僵尸网络","ransomware","勒索软件",{"_90":91,"_13":92},"publicId","36af3335-ef58-4707-9122-1260730671b0","白宫网络被检出住宅代理出口流量",{"_11":105,"_98":106,"_100":68},{"_11":103,"_98":104,"_100":68},{"_11":101,"_98":102,"_100":68},{"_11":97,"_98":99,"_100":68},"sec-4","text","From the White House to Antarctica","level","sec-3","A possible way into internal systems","sec-2","A streaming app in the frame","sec-1","Someone working late","zh","<p>The White House network has been working as an exit point for residential proxy services, a setup that may open a path into one of the most closely guarded networks in the world, Layer3 Intel found.</p><p><img src=\"/dailyinfo/media/f1a98a4a59d96a10.webp\" loading=\"lazy\" decoding=\"async\" alt=\"White House residential proxy\" title=\"White House\"></p><p>In a blog post, the threat intelligence firm reported that its proxy enumeration pipeline exited through AS2650, the network registered to the Executive Office of the President, 236 times between October 5 and November 3. The exits came from six addresses on 26 of those 30 days, and 28 separate residential proxy services offered the route.</p><p>Residential proxy services sell access to everyday devices, letting customers send traffic through them so it appears to come from that device’s network. Here, customers’ traffic would appear to come from inside the White House.</p><p>“This is public access,” the Layer3 Intel team noted. “Anybody can obtain it by signing up to a public residential proxy service, paying a few dollars and sending requests through it.”</p><p>The firm stressed that it did not target the network or try to make its probes exit from it. Its staff spotted the activity while looking through the company’s Residential Proxy Observatory, simply by requesting global rotating access through the proxy services. To rule out a fluke, they checked the addresses against other proxy detection services, whose public IP pages independently flag them as residential proxy exits.</p><h3 id=\"sec-1\">Someone working late</h3><p>The timing of the traffic gave Layer3 a hint about its source. About half of it falls between 5 p.m. and midnight Eastern time, and almost none happens in the early morning.</p><p>The company believes this pattern indicates “someone regularly on the White House network late into the evening, whose device is infected with a proxy SDK.” Its data shows only the exits, though, and nothing about the device or the person using it.</p><p>“Someone that is at the Whitehouse between 5pm and midnight has some compromised devices. Or at least some that are providing residential proxy access to botnets,” security researcher Matt Johansen <a href=\"https://x.com/mattjay/status/2118089196745408910\">posted</a> on X.</p><h3 id=\"sec-2\">A streaming app in the frame</h3><p>Synthient, one of the detection services Layer3 used to verify the addresses, went further. On November 4 it <a href=\"https://x.com/synthient/status/2118115310922518777\">claimed</a> that “several Whitehouse staffers are running a Windows 11 machine with InfaticaSDK installed.”</p><p>A day later, the company <a href=\"https://x.com/synthient/status/2118205874951110841\">explained</a> that it can detect devices on a per session basis, and that this revealed “a number of Windows 10 and Windows 11 devices beaconing to known proxy providers like Geonode, Infatica and Mellowtel.”</p><p>“With high confidence we believe the installed app to be Rave[.]io a shared streaming app that bundles 12 proxy SDKs into the platform,” Synthient stated. Rave lets people watch videos together and runs on Mac, iPhone, Android and Windows.</p><h3 id=\"sec-3\">A possible way into internal systems</h3><p>Layer3 cited past research showing that poorly secured proxy SDKs can give outsiders access to internal networks and let them move laterally.</p><p>“This is how past botnets have spread. In A Broken System Fueling Botnets, the researchers at Synthient documented how the <a href=\"https://www.helpnetsecurity.com/2026/05/22/kimwolf-ddos-botnet-administrator-arrested/\">Kimwolf</a> botnet reached at least 2 million devices, mostly Android devices with an exposed ADB service, through residential proxy networks,” the company wrote.</p><p>“If an SDK on this network has the same kind of flaw, anyone buying proxy access could use it to reach internal systems,” they cautioned.</p><h3 id=\"sec-4\">From the White House to Antarctica</h3><p>The observatory turned up proxies in some of the most isolated places on Earth. Layer3 recorded 413 addresses and more than 32,000 observations in Saint Helena, Ascension and Tristan da Cunha, the South Atlantic territory that includes the most remote inhabited island in the world.</p><p>Three observations came from Antarctica, all from a Cloudflare WARP address tied to McMurdo Station.</p><p>“Residential proxies have infected every corner of the world, and it looks like there is no place they cannot reach,” the company <a href=\"https://layer3intel.com/blog/residential-proxies-white-house-network\">concluded</a>.</p>","zhKind","complete","数据窃取","Microsoft","Cloudflare","https://www.helpnetsecurity.com/2026/11/06/white-house-residential-proxy-traffic/","Help Net Security",{"_117":118,"_119":-5},"changelogVersion","2026-10-01T08:00","release"]
