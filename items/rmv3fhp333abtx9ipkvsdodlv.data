[{"_1":2,"_3":4},"root",{"_5":89},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1794789632000,"id","rmv3fhp333abtx9ipkvsdodlv","title","Pentagon 将 CDAO 更名为 Super Intelligence Office","originalTitle","Pentagon Renames CDAO ‘Super Intelligence Office’","summary","Pentagon 将 Chief Digital and Artificial Intelligence Office（CDAO）更名为 Super Intelligence Office。","reason","source",{"_71":88},"links",{"_61":87},"publishedAt","2026-11-15T12:51:33.000Z","discoveredAt","2026-11-15T13:18:27.562Z","timelineAt","category","ai-security","tags",[72,83,84,85,86],"score",27,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","SecurityWeek News","body",{"_79":-5,"_61":80,"_81":-5,"_82":36},"outline",[],"relatedStories",[75],"topics",[68,69],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","f07McdiySLQ0","reportCount",1,"additionalSourceCount",0,{"_70":73,"_71":74},{"_70":30,"_71":72},"slug","name","AI 安全","ai-agent","AI Agent 安全",{"_76":77,"_13":78},"publicId","282493c9-f8f9-42e8-8053-1cb58003d726","五角大楼CDAO更名超级智能办公室","zh","<p><strong>The Pentagon on Friday renamed its Chief Digital and Artificial Intelligence Office (CDAO) the Super Intelligence Office, adopting the terminology President Donald Trump has directed federal agencies to use instead of Artificial Intelligence (AI).</strong>\n\n\n\n</p><p>Cameron Stanley continues to lead the office as Chief Super Intelligence Officer for the Department of War (DoW), with Andrew Mapes serving as Principal Deputy Super Intelligence Officer. Stanley took over as the Pentagon’s chief digital and AI officer in January after leading national security transformation at Amazon Web Services. He previously led Project Maven, the Pentagon’s military AI initiative.\n\n\n\n</p><p>The Department of War moved the office’s public resources, procurement information and partnership portals to <a href=\"https://www.si.mil/\">SI.mil</a> domain and said existing programs, solicitations and defense partnerships would continue without interruption. The office’s portfolio includes the Maven Smart System, an AI-enabled intelligence and targeting platform, and the War Data Platform, a central hub for military data.\n\n\n\n</p><p>“This redesignation is a clear signal of where the Department of War is going,” <a href=\"https://www.war.gov/News/Releases/Release/Article/4647618/department-of-war-redesignates-cdao-as-super-intelligence-office/\">said</a> Stanley. “We have moved beyond experimental prototypes. As the Super Intelligence Office our mission is to harness the full power of sovereign Super Intelligence to ensure decisive military superiority across every domain.”\n\n\n\n</p><p>The rebrand follows Trump’s <a href=\"https://www.whitehouse.gov/presidential-actions/2026/09/inaugurating-the-era-of-super-intelligence/\">executive order (14434) in September</a> directing agencies to use “Super Intelligence” and “SI” in official communications and other non-statutory documents, to the maximum extent permitted by law. In October, Trump announced the “Super Intelligence Force,” a government-wide AI coordination group chaired by Director of National Intelligence Jay Clayton.\n\n\n\n</p><p>The Justice Department announced its <a href=\"https://www.justice.gov/opa/pr/department-justice-launches-super-intelligence-task-force\">own Super Intelligence Task Force</a> on November 5 to coordinate civil and criminal enforcement involving AI, including cases of fraud and unlawful uses targeting critical infrastructure.</p><p><span>Advertisement. Scroll to continue reading.</span></p><p><strong>Related</strong>: <a href=\"https://www.securityweek.com/is-ai-making-us-worse-at-cybersecurity/\">Is AI Making Us Worse at Cybersecurity?</a>\n\n\n\n</p>","zhKind","complete","治理","大模型","Microsoft","AWS","https://www.securityweek.com/pentagon-renames-cdao-super-intelligence-office/","SecurityWeek",{"_90":91,"_92":-5},"changelogVersion","2026-10-01T08:00","release"]
