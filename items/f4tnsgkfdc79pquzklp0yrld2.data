[{"_1":2,"_3":4},"root",{"_5":96},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1794271233000,"id","f4tnsgkfdc79pquzklp0yrld2","title","OpenSSH/musl 密码认证绕过漏洞 QVD-2026-104595 已复现，CVSS 3.1 9.8","originalTitle","【已复现】OpenSSH/musl 密码认证绕过漏洞(QVD-2026-104595)安全风险通告","summary","OpenSSH/musl 密码认证绕过漏洞 QVD-2026-104595 已由奇安信 CERT 复现，CVSS 3.1 分数 9.8，评级为高危，影响量为千万级。","reason","原文给出了认证绕过的触发原理、利用前提和受影响范围，并提供补丁版本、日志排查与临时禁用密码认证等处置方法。","source",{"_73":95},"links",{"_86":94},"publishedAt","2026-11-06T01:31:00.000Z","discoveredAt","2026-11-06T18:23:28.904Z","timelineAt","category","vuln","tags",[89,90,91,92,76,93,80],"score",83,"selected",true,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","body",{"_61":85,"_86":-5,"_87":86,"_88":37},"outline",[],"relatedStories",[81],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","f6O9woImjvFA","reportCount",2,"additionalSourceCount",1,{"_72":79,"_73":80},{"_72":77,"_73":78},{"_72":75,"_73":76},{"_72":31,"_73":74},"slug","name","漏洞披露","identity","身份与访问","supply-chain","供应链安全","qianxin","奇安信",{"_82":83,"_13":84},"publicId","9752aa65-824d-43a4-962f-2d752946dc78","OpenSSH musl认证绕过漏洞可触发RCE","<p><span>奇安信 CERT</span> <span>2026-11-06 09:31</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/4a6ce75aac36e698.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>致力于第一时间为企业级用户提供权威漏洞情报和有效解决方案。</p><p><span><span>●&nbsp;</span></span><span><span>点击↑蓝字关注我们，获取更多安全风险通告</span></span></p><hr><table><tbody><tr><td colspan=\"4\" align=\"center\"><p><span><strong><span><span>漏洞概述</span></span></strong></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>漏洞名称</span></span></strong></span></p></td><td colspan=\"3\" align=\"left\"><p><span><span>OpenSSH/musl 密码认证绕过漏洞</span></span></p></td></tr><tr><td align=\"left\"><p><span><span><strong><span>漏洞编号</span></strong></span></span></p></td><td colspan=\"3\" align=\"left\"><p><span><span>QVD-2026-104595</span></span></p></td></tr><tr><td align=\"left\"><p><strong><span><strong><span><span>公开时间</span></span></strong></span></strong></p></td><td align=\"left\"><p><span><span>2026-11-05</span></span></p></td><td align=\"left\"><p><strong><span><strong><span><span>影响量级</span></span></strong></span></strong></p></td><td align=\"left\"><p><span><span>千万级</span></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>奇安信评级</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>高危</span></span></strong></span></p></td><td align=\"left\"><p><strong><span><span>CVSS 3.1分数</span></span></strong></p></td><td align=\"left\"><p><span><span><strong><span>9.8</span></strong></span></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span>威胁类型</span></strong></span></p></td><td align=\"left\"><p><span><span><span>认证绕过</span></span></span></p></td><td align=\"left\"><p><strong><span><span>利用可能性</span></span></strong></p></td><td align=\"left\"><p><strong><span><strong><span>高</span></strong></span></strong></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>POC状态</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>已公开</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>在野利用状态</span></span></strong></span></p></td><td align=\"left\"><p><span><span><span>未发现</span></span></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>EXP状态</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span><span>已公开</span></span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>技术细节状态</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span><span>已公开</span></span></span></strong></span></p></td></tr><tr><td colspan=\"4\" align=\"left\"><p><strong><span><span>危害描述：</span></span></strong><span><span>攻击者可利用 musl crypt() 失败返回 \"*\" 的特性，伪造有效密码认证，绕过仅密钥/锁定账户的访问控制，获得该账户的登录会话；若该账户具备免密 sudo/doas 权限或为 root（PermitRootLogin yes），可直接获取 root 权限，造成主机完全失陷。</span></span></p></td></tr></tbody></table><p><strong><span>0</span></strong><strong><span>1</span></strong></p><p><strong><span>漏洞详情</span></strong></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>影响组件</span></span></strong></p><p><span>OpenSSH 是 OpenBSD 项目维护的广泛使用的开源 SSH 远程登录与加密传输服务组件，被广泛应用于 Linux、Unix 及嵌入式系统。musl libc 是面向嵌入式与容器场景的轻量级 C 标准库，被 Alpine Linux、OpenWrt、Buildroot、Yocto 及大量 Docker 镜像采用。</span></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>漏洞描述</span></span></strong></p><p><span>近日，奇安信CERT监测到官方修复<span>OpenSSH/musl 密码认证绕过漏洞(QVD-2026-104595)</span>，该漏洞源于 musl libc 的 crypt() 函数在失败时返回单字符 \"*\"（而非 POSIX 规定的NULL），而 OpenSSH 在未启用 PAM 的认证路径中，对密码字段为 \"*\" 的账户借用其他账户的真实盐值执行 crypt() 校验。当攻击者提交 257～1024 字节的超长密码时，musl 的 crypt() 因 KEY_MAX(256) 长度限制返回 \"*\"，与影子密码字段 \"*\" 比较相等，strcmp 判定通过，导致攻击者无需任何有效凭据即可通过 SSH 密码认证登录仅允许密钥登录或已锁定密码的账户。成功绕过认证后，若目标账户具备免密 sudo/doas 权限（如 Alpine 云镜像默认 alpine 用户），攻击者可直接提权至 root 实现完全控制。<span>目前该漏洞PoC和技术细节已公开。</span></span><span><span>鉴于该漏洞影响范围较大，建议客户尽快做好自查及防护。</span></span></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>利用条件</span></span></strong></p><p><span><span>1. sshd 运行于 musl libc 且未启用 PAM；</span></span></p><p><span><span>2. 开启密码认证（默认开启）；</span></span></p><p><span><span>3. 存在 /etc/shadow 密码字段为单个 \"*\" 的账户；</span></span></p><p><span><span>4. 系统中另有至少一个拥有真实密码哈希的账户。</span></span></p><p><strong><span>02</span></strong></p><p><strong><span>影响范围</span></strong></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>影响版本</span></span></strong></p><p><span>2016 年以来至 10.6p2 之前，运行于 musl libc 且未启用 PAM 的 OpenSSH sshd（Alpine、OpenWrt、Buildroot、Yocto 及 musl Docker 镜像）</span></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>其他受影响组件</span></span></strong></p><p><span><span>无</span></span></p><p><strong><span>03</span></strong></p><p><strong><span>复现情况</span></strong></p><p><span><span>目前，</span><span>奇安信CERT已成功复现</span><span><span>OpenSSH/musl 密码认证绕过漏洞(QVD-2026-104595)</span></span><span>，截图如下：</span></span></p><p><img src=\"/dailyinfo/media/59d5c08944d6ce93.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>04</span></strong></p><p><strong><span>处置建议</span></strong></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>安全更新</span></span></strong></p><p><span>官方已发布安全补丁，请及时更新至最新版本：</span></p><p><span>OpenSSH &gt;= 10.6p2</span></p><p><span>下载地址：</span></p><p><span><a href=\"https://www.openssh.org/portable.html\">https://www.openssh.org/portable.html</a></span></p><p><span>Alpine 等 musl 发行版可执行 apk upgrade openssh 并重启 sshd；源码部署需升级到 10.6p2 后重新编译安装。</span></p><p><span><span>临时缓解措施：</span></span></p><p><span>1. 关闭密码认证并重启 sshd：在 /etc/ssh/sshd_config.d/00-no-passwords.conf 写入 PasswordAuthentication no（Alpine 执行 rc-service sshd restart）；</span></p><p><span>2. 将 PermitRootLogin 设置为 prohibit-password 或 no；</span></p><p><span>3. 注意：在未启用 PAM 的 Alpine 等 musl 系统上，不要将 /etc/shadow 中的 \"*\" 改为 \"!\"，否则会导致合法用户无法使用 SSH 密钥登录；</span></p><p><span>4. 若已暴露，应检查 sshd 日志中本应无密码的账户是否出现 Accepted password 记录。</span></p><p><strong><span>05</span></strong></p><p><strong><span>参考资料</span></strong></p><p><span><span>[1]</span><span><a href=\"https://www.openssh.org/releasenotes.html#10.6p2\">https://www.openssh.org/releasenotes.html#10.6p2</a></span></span></p><p><strong><span>06</span></strong></p><p><strong><span>时间线</span></strong></p><p><span><span>2026年11月06日，奇安信 CERT发布安全风险通告。</span></span></p><p><strong><span>07</span></strong></p><p><strong><span>漏洞情报服务</span></strong></p><p><span><span>「</span><span>奇安信漏洞情报平台</span><span>」</span><span>重磅上线，诚邀您来体验：</span></span></p><p><img alt=\"图片\" src=\"/dailyinfo/media/5428ea6b2c1910bf.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img alt=\"图片\" src=\"/dailyinfo/media/9a2bd58132b40c10.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img alt=\"图片\" title=\"CERT LOGO.png\" width=\"100%\" src=\"/dailyinfo/media/a5fe6b9d0ac59e07.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><strong><span>奇安信 CERT</span></strong></span></p><p><span><strong><span><span>致力于</span></span></strong><span><span>第一时间为企业级用户提供</span><strong><span><span>权威</span></span></strong><span>漏洞情报和</span></span><strong><span><span>有效</span></span></strong><span><span>解决方案。</span></span></span></p><p><span><span><span>点击↓</span><strong><span><span>阅读原文</span></span></strong><span>，到</span></span><strong><span><span>ALPHA威胁分析平台</span></span></strong><span><span>订阅更多漏洞信息。</span></span></span></p><p><a href=\"https://ti.qianxin.com/portal/subscription\">阅读原文</a></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=56d67391&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzU5NDgxODU1MQ%3D%3D%26mid%3D2247508041%26idx%3D1%26sn%3D298ed9e842bc1bb98241c38a3c69b57d\">跳转微信打开</a></p>","original","zhKind","complete","漏洞","复现","漏洞利用","补丁","供应链","https://mp.weixin.qq.com/s?__biz=MzU5NDgxODU1MQ==&mid=2247508041&idx=1&sn=298ed9e842bc1bb98241c38a3c69b57d","奇安信 CERT",{"_97":98,"_99":-5},"changelogVersion","2026-10-01T08:00","release"]
