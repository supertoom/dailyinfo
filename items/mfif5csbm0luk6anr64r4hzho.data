[{"_1":2,"_3":4},"root",{"_5":108},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795653642000,"id","mfif5csbm0luk6anr64r4hzho","title","攻击者利用自主 AI 工具 Cairn 攻陷 MONAI Label 漏洞并取得服务器权限","originalTitle","Hackers use autonomous AI tool Cairn to find zero-day, take over server","summary","Amazon Threat Intelligence 发现疑似中国关联攻击者使用自主 AI Agent 平台 Cairn，于 2026 年 9 月 8 日至 10 日攻击中国境外东亚教育机构。","reason","材料展示了 AI Agent 自主发现并利用漏洞的完整链路，以及失败尝试和修复时间，便于评估防御响应压力。","source",{"_74":107},"links",{"_96":106},"publishedAt","2026-11-20T17:30:00.000Z","discoveredAt","2026-11-20T17:56:29.606Z","timelineAt","category","activity","tags",[75,79,77,100,101,102,103,104,105],"score",84,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Bill Toulas","body",{"_61":95,"_96":-5,"_97":98,"_99":37},"outline",[86,87],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fVbDsNwWSOac","reportCount",5,"additionalSourceCount",4,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","attack","name","攻击活动","exploited","在野利用","ai-offense","AI 攻防","ai-agent","AI Agent 安全",{"_83":84,"_13":85},"publicId","52702772-c6ed-4351-9e9b-8fc6f1b0fd43","Cairn自主攻击MONAI Label零日漏洞",{"_11":93,"_89":94,"_91":92},{"_11":88,"_89":90,"_91":92},"sec-2","text","发现现有防御可能遗漏的电子邮件威胁。","level",2,"sec-1","发现并利用零日漏洞","<p><img alt=\"Malicious Artificial Intelligence\" height=\"900\" src=\"/dailyinfo/media/dac0808a3f44882a.jpg\" srcset=\"/dailyinfo/media/e0bd142e51affb7e.jpg 720w, /dailyinfo/media/438d3f2967803e75.jpg 1200w, /dailyinfo/media/dac0808a3f44882a.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>黑客使用名为“Cairn”的自主 AI 代理平台，发现了一款医疗成像应用中的零日漏洞，并利用该漏洞完全控制了一台服务器。</p><p>据 Amazon Threat Intelligence 称，疑似与中国有关的攻击者只是指示 AI 代理“获取 shell 访问权限”，任由其自行发现并利用该漏洞。</p><p>Amazon Threat Intelligence 在发现攻击者将 Cairn 实例公开暴露且未启用身份验证、导致其黑客行动暴露后，揭露了这场攻击活动。</p><p><a href=\"https://www.wiz.io/lp/claude-code-security-best-practices-cheat-sheet?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q3_INB_FORM_Claude-Code-Security-Best-Practices&amp;sfcid=701Vh00000gJQZuIAO&amp;utm_term=FY27Q4-bleepingcomputer-article-970x250-Nov&amp;utm_content=Claude-Code-Best-Practices\"><img src=\"/dailyinfo/media/13df9947add9c9b1.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>研究人员称，这些攻击由一个与中国有关联的威胁行为者于 2026 年 9 月 8 日至 10 日发起，主要目标是位于中国境外的东亚教育机构。</p><p>Cairn 是一款合法的渗透测试工具，可用于协调多个 AI 代理执行网络行动，旨在支持研究与防御强化。</p><p>Gambit Security 记录了 9 月将 Cairn 滥用为大规模<a href=\"https://www.bleepingcomputer.com/news/security/malicious-ai-agents-steal-600k-credit-cards-infect-100-plus-sites-with-skimmers/\">信用卡窃取行动</a>一部分的案例。最近，Google 报告称其<a href=\"https://www.bleepingcomputer.com/news/security/google-warns-that-fully-automated-ai-attacks-are-coming-soon/\">被部署用于攻击</a>美国的一家航空航天组织。</p><p>在<a href=\"https://aws.amazon.com/blogs/security/chinese-nexus-actors-cairn-ai-agents-found-a-zero-day-on-their-own/\">Amazon 调查的</a>这次攻击活动中，AI 代理并非总是成功。例如，一次历时 16 小时、包含 148 个动作的控制 Redis 服务器行动以失败告终。</p><p>在另一个针对大学 GPU 服务器的案例中，这些代理在六小时内尝试了超过 30,000 种凭据组合，但未能通过暴力破解进入系统。</p><h2 id=\"sec-1\">发现并利用零日漏洞</h2><p>据 Amazon 称，Cairn 的 AI 代理在 MONAI Label 中发现了一个路径遍历零日漏洞。MONAI Label 是一款开源医疗成像应用，使用 AI 帮助研究人员标注医学图像。</p><p>该漏洞使代理能够将文件写入服务器上的任意位置；在 11 分钟内，它们便从绘制该应用的 API 架构推进到利用该漏洞。</p><p>在随后的一次会话中，AI 代理利用该漏洞，将 Python reverse shell 写入 Python 启动时自动加载的&nbsp;<code>sitecustomize.py</code> 文件，然后触发一个 API 端点，以建立对服务器的 root 访问权限。</p><p>发现该零日漏洞后，操作者向代理提供了一个通向第二所大学网络的代理，该网络运行着相同的易受攻击软件，并指示它们将其他机器作为目标。</p><p>Amazon 向 MONAI Label 维护者报告了该漏洞，维护者于 11 月 18 日<a href=\"https://github.com/Project-MONAI/MONAILabel/security/advisories/GHSA-qc22-rmgc-vg94\">发布了安全更新</a>以修复该问题。</p><p>研究人员根据检索到的提示词语言、活动时间戳以及目标选择，以中等置信度将该攻击活动归因于一个与中国有关联的威胁行为者。</p><p>Amazon 还分享了两个与该攻击活动相关的 IP 地址，观察时间为 2026 年 9 月 8 日至 10 日：</p><ul>\n\t<li>142[.]4.98.145</li>\n\t<li>142[.]4.107.34</li>\n</ul><p>Amazon 警告称，AI 代理发现和利用漏洞的速度可能快于安全团队作出响应的速度，并敦促组织更多依赖自动化防御，而非手动调查。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/0f821b73ff70ca16.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-2\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 代理会分析电子邮件的意图、上下文和行为，以发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>对 Microsoft 365 或 Google Workspace 进行为期 14 天的只读扫描，看看有哪些威胁正在穿透防御，且无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始免费的电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","漏洞利用","大模型","Agent 安全","AWS","Google","CISA","https://www.bleepingcomputer.com/news/security/hackers-use-autonomous-ai-tool-cairn-to-find-zero-day-take-over-server/","BleepingComputer",{"_109":110,"_111":-5},"changelogVersion","2026-10-01T08:00","release"]
