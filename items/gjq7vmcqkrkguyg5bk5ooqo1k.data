[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1795826440000,"id","gjq7vmcqkrkguyg5bk5ooqo1k","title","IBM 多项产品漏洞汇总：涵盖远程代码执行、远程 DoS 与数据机密性风险","originalTitle","Multiples vulnérabilités dans les produits IBM (27 novembre 2026)","summary","CERT-FR 汇总 IBM 多项产品中发现的 126 个漏洞，部分可导致远程代码执行、远程拒绝服务（DoS）及数据机密性受损。相关 CVE 包括 CVE-2023-43804、CVE-2026-102554 和 CVE-2026-129270 等；原文未提供受影响版本、认证前提、CVSS 分数或在野利用信息，修复方案需查阅 IBM 安全公告。","reason","source",{"_61":80},"links",{"_58":79},"publishedAt","2026-11-27T00:00:00.000Z","discoveredAt","2026-11-27T14:52:21.373Z","timelineAt","category","vuln","tags",[76,77,78],"score",20,"selected",false,"channel","news","story","x","readingMode","full","author","body",{"_72":-5,"_58":73,"_74":-5,"_75":36},"outline",[63,64],"relatedStories",[],"topics",[59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":30,"_61":62},"slug","name","漏洞披露",{"_11":70,"_66":71,"_68":69},{"_11":65,"_66":67,"_68":69},"sec-2","text","Solutions","level",2,"sec-1","Résumé","zh","<h2 id=\"sec-1\">Résumé</h2><p>De multiples vulnérabilités ont été découvertes dans les produits IBM. Certaines d'entre elles permettent à un attaquant de provoquer une exécution de code arbitraire à distance, un déni de service à distance et une atteinte à la confidentialité des données.</p><h2 id=\"sec-2\">Solutions</h2><p>Se référer au bulletin de sécurité de l'éditeur pour l'obtention des correctifs (cf. section Documentation).</p><ul>\n          \n          \n            <li>\n              <p>Bulletin de sécurité IBM 7297988 du 24 novembre 2026</p>\n              <a href=\"https://www.ibm.com/support/pages/node/7297988\">https://www.ibm.com/support/pages/node/7297988</a>\n            </li>\n          \n            <li>\n              <p>Bulletin de sécurité IBM 7298067 du 24 novembre 2026</p>\n              <a href=\"https://www.ibm.com/support/pages/node/7298067\">https://www.ibm.com/support/pages/node/7298067</a>\n            </li>\n          \n            <li>\n              <p>Bulletin de sécurité IBM 7297534 du 25 novembre 2026</p>\n              <a href=\"https://www.ibm.com/support/pages/node/7297534\">https://www.ibm.com/support/pages/node/7297534</a>\n            </li>\n          \n            <li>\n              <p>Bulletin de sécurité IBM 7297536 du 25 novembre 2026</p>\n              <a href=\"https://www.ibm.com/support/pages/node/7297536\">https://www.ibm.com/support/pages/node/7297536</a>\n            </li>\n          \n            <li>\n              <p>Bulletin de sécurité IBM 7297798 du 25 novembre 2026</p>\n              <a href=\"https://www.ibm.com/support/pages/node/7297798\">https://www.ibm.com/support/pages/node/7297798</a>\n            </li>\n          \n            <li>\n              <p>Bulletin de sécurité IBM 7298169 du 25 novembre 2026</p>\n              <a href=\"https://www.ibm.com/support/pages/node/7298169\">https://www.ibm.com/support/pages/node/7298169</a>\n            </li>\n          \n            <li>\n              <p>Bulletin de sécurité IBM 7298267 du 25 novembre 2026</p>\n              <a href=\"https://www.ibm.com/support/pages/node/7298267\">https://www.ibm.com/support/pages/node/7298267</a>\n            </li>\n          \n\n          \n          \n\n          \n            <li>\n              <p>Référence CVE CVE-2023-43804</p>\n              <a href=\"https://www.cve.org/CVERecord?id=CVE-2023-43804\">https://www.cve.org/CVERecord?id=CVE-2023-43804</a>\n            </li>\n          \n            <li>\n              <p>Référence CVE CVE-2023-45803</p>\n              <a href=\"https://www.cve.org/CVERecord?id=CVE-2023-45803\">https://www.cve.org/CVERecord?id=CVE-2023-45803<