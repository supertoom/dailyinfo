[{"_1":2,"_3":4},"root",{"_5":94},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1793621624000,"id","gfyff5sznq8xbz15ruw0wykcz","title","Windows Update Stack 本地权限提升漏洞 CVE-2026-81963 已发现利用","originalTitle","Windows Update Stack 本地权限提升漏洞(CVE-2026-81963)安全风险通告","summary","Windows Update Stack 本地权限提升漏洞 CVE-2026-81963 已发现在野利用，攻击者需先获得主机低权限账户，即可借助更新栈对重解析点处理不当将权限提升至 SYSTEM 并完全控制目标主机。","reason","通告给出了具体受影响版本、SYSTEM 权限提升链和已公开 PoC，并提供官方及终端管理平台两种修复路径，便于评估与处置。","source",{"_73":93},"links",{"_83":92},"publishedAt","2026-11-02T09:46:38.832Z","discoveredAt","2026-11-02T11:46:38.841Z","timelineAt","category","vuln","tags",[86,74,87,88,89,90,91],"score",76,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","body",{"_61":82,"_83":-5,"_84":83,"_85":37},"outline",[],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fz-RW5_XrdCA","reportCount",1,"additionalSourceCount",0,{"_71":76,"_73":77},{"_71":31,"_73":75},{"_71":72,"_73":74},"slug","exploited","name","在野利用","漏洞披露","microsoft","Microsoft / 微软",{"_79":80,"_13":81},"publicId","c180dd55-5a6c-4725-b7e5-fb43563e20f3","奇安信披露Windows提权漏洞在野利用","<table><tbody><tr><td colspan=\"4\"><p><strong>漏洞概述</strong></p></td></tr><tr><td><p><strong>漏洞名称</strong></p></td><td colspan=\"3\"><p>Windows Update Stack 本地权限提升漏洞</p></td></tr><tr><td><p><strong>漏洞编号</strong></p></td><td colspan=\"3\"><p>QVD-2026-63447，CVE-2026-81963</p></td></tr><tr><td><p><strong><strong>公开时间</strong></strong></p></td><td><p>2026-09-08</p></td><td><p><strong><strong>影响量级</strong></strong></p></td><td><p>千万级</p></td></tr><tr><td><p><strong>奇安信评级</strong></p></td><td><p><strong>高危</strong></p></td><td><p><strong>CVSS 3.1分数</strong></p></td><td><p><strong>7.8</strong></p></td></tr><tr><td><p><strong>威胁类型</strong></p></td><td><p>权限提升</p></td><td><p><strong>利用可能性</strong></p></td><td><p><strong><strong>高</strong></strong></p></td></tr><tr><td><p><strong>POC状态</strong></p></td><td><p><strong>已公开</strong></p></td><td><p><strong>在野利用状态</strong></p></td><td><p>已发现</p></td></tr><tr><td><p><strong>EXP状态</strong></p></td><td><p><strong>已公开</strong></p></td><td><p><strong>技术细节状态</strong></p></td><td><p><strong>已公开</strong></p></td></tr><tr><td colspan=\"4\"><p><strong>危害描述：</strong>攻击者利用该漏洞可将本地低权限账户的权限提升至 SYSTEM，从而完全控制目标主机。</p></td></tr></tbody></table><p><strong>0</strong><strong>1</strong></p><p><strong>漏洞详情</strong></p><p><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong></p><p><strong>影响组件</strong></p><p>Windows Update Stack（Windows 更新栈）是 Windows 操作系统负责更新下载、暂存、编排与安装的核心组件集合，主要包括 Windows Update Orchestrator 服务（UsoSvc）、Windows Update Medic 服务（WaaSMedicSvc）、更新会话编排器（Update Session Orchestrator，USO）以及 MoUsoCoreWorker.exe、usoclient.exe 等工作进程。</p><p><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong></p><p><strong>漏洞描述</strong></p><p>近日，奇安信CERT监测到Windows Update Stack 本地权限提升漏洞(CVE-2026-81963)在野利用，该漏洞源于 Windows 更新栈在处理文件路径时未正确解析重解析点，即在访问文件前未对链接目标做充分校验，导致以 SYSTEM 权限运行的更新组件可能被诱导对攻击者指定的文件执行特权操作。本地低权限攻击者利用该漏洞可将权限提升至 SYSTEM。目前该漏洞PoC和技术细节已公开。鉴于该漏洞已发现在野利用，建议客户尽快做好自查及防护。</p><p><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong></p><p><strong>利用条件</strong></p><p>攻击者需在目标主机上获得低权限。</p><p><strong>02</strong></p><p><strong>影响范围</strong></p><p><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong></p><p><strong>影响版本</strong></p><p>Windows 11 23H2（x64 / ARM64）&lt; 10.0.22631.7582</p><p>Windows 11 24H2（x64 / ARM64）&lt; 10.0.26100.9445</p><p>Windows 11 25H2（x64 / ARM64）&lt; 10.0.26200.9445</p><p>Windows 11 26H1（x64 / ARM64）&lt; 10.0.28000.2954</p><p>Windows Server 2025（含 Server Core 安装）&lt; 10.0.26100.33438</p><p><strong>03</strong></p><p><strong>复现情况</strong></p><p>目前，奇安信威胁情报中心安全研究员已成功复现Windows Update Stack 本地权限提升漏洞(CVE-2026-81963)，截图如下：</p><p><img src=\"/dailyinfo/media/5845842ffa4ac117.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong>04</strong></p><p><strong>处置建议</strong></p><p><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong></p><p><strong>安全更新</strong></p><p><strong>使用奇安信天擎的客户可以通过奇安信天擎控制台一键更新修补相关漏洞，也可以通过奇安信天擎客户端一键更新修补相关漏洞。</strong></p><p>也可以采用以下官方解决方案及缓解方案来防护此漏洞：</p><p><strong>Windows自动更新</strong></p><p>Windows系统默认启用 Microsoft Update，当检测到可用更新时，将会自动下载更新并在下一次启动时安装。还可通过以下步骤快速安装更新：</p><p>1、点击“开始菜单”或按Windows快捷键，点击进入“设置”</p><p>2、选择“更新和安全”，进入“Windows更新”（Windows Server 2012以及Windows Server 2012 R2可通过控制面板进入“Windows更新”，步骤为“控制面板”-&gt; “系统和安全”-&gt;“Windows更新”）</p><p>3、选择“检查更新”，等待系统将自动检查并下载可用更新</p><p>4、重启计算机，安装更新</p><p>系统重新启动后，可通过进入“Windows更新”-&gt;“查看更新历史记录”查看是否成功安装了更新。对于没有成功安装的更新，可以点击该更新名称进入微软官方更新描述链接，点击最新的SSU名称并在新链接中点击“Microsoft 更新目录”，然后在新链接中选择适用于目标系统的补丁进行下载并安装。</p><p><strong>手动安装补丁</strong></p><p>另外，对于不能自动更新的系统版本，可参考以下链接下载适用于该系统的补丁并安装：</p><p>https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-96951</p><p><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong></p><p><strong>产品解决方案</strong></p><p><strong>奇安信天擎终端安全管理系统解决方案</strong></p><p>奇安信天擎终端安全管理系统并且有漏洞修复相关模块的用户，可以将补丁库版本更新到：2026.9.9.1000及以上版本，对内网终端进行补丁更新。</p><p>推荐采用自动化运维方案，如果控制中心可以连接互联网的用户场景，建议设置为自动从奇安信云端更新补丁库至2026.9.9.1000版本。</p><p>控制中心补丁库更新方式：每天04:00-06:00自动升级，升级源为从互联网升级。</p><p>纯隔离网内控制中心不能访问互联网，不能下载补丁库和补丁文件，需使用离线升级工具定期导入补丁库和文件到控制中心。</p><p><strong>05</strong></p><p><strong>参考资料</strong></p><p>[1]https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-81963</p><p>[2]https://www.malwarebytes.com/blog/news/2026/09/microsoft-fixes-record-964-flaws-including-2-exploited-zero-days</p><p>声明：本文来自奇安信 CERT，版权归作者所有。文章内容仅代表作者独立观点，不代表安全内参立场，转载目的在于传递更多信息。如有侵权，请联系 anquanneican@163.com。</p>","original","zhKind","complete","漏洞","复现","漏洞利用","补丁","Microsoft","奇安信","https://www.secrss.com/articles/95269","安全内参",{"_95":96,"_97":-5},"changelogVersion","2026-10-01T08:00","release"]
