[{"_1":2,"_3":4},"root",{"_5":107},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795740044000,"id","qbdg7b3a2508pllcfj3cllxpi","title","Fireworks AI 凭据泄露导致 Uber 近 149,346 名用户数据被窃","originalTitle","Fireworks AI Breach Exposes Uber Data and Highlights Supply Chain Risks","summary","攻击者使用已泄露的 Fireworks AI 内部凭据访问 Uber 外部环境，窃取近 149,346 名用户的姓名、家庭住址、出生日期、驾照号码、驾照及政府签发身份证件图片。","reason","事件展示供应商内部凭据可绕过客户告警并扩大数据暴露面，为审查外部技术提供商权限和监控边界提供具体案例。","source",{"_75":106},"links",{"_95":105},"publishedAt","2026-11-17T19:11:20.000Z","discoveredAt","2026-11-17T20:23:37.693Z","timelineAt","category","activity","tags",[76,99,100,101,102,103,104],"score",75,"selected",true,"channel","news","story",{"_86":87,"_13":88},"x","readingMode","full","author","Pierluigi Paganini","body",{"_61":94,"_95":-5,"_96":97,"_98":37},"outline",[89],"relatedStories",[85],"topics",[68,69,70,71,72],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fWkOvgPBrTks","reportCount",3,"additionalSourceCount",2,{"_73":83,"_75":84},{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","attack","name","攻击活动","ai-agent","AI Agent 安全","identity","身份与访问","supply-chain","供应链安全","paloalto","Palo Alto Networks",{"_86":87,"_13":88},"publicId","f68801dc-89b9-4d34-bc78-9b79076922c4","Uber司机数据因第三方凭据失陷被窃",{"_11":90,"_91":92,"_93":67},"sec-1","text","黑客使用了被盗的 Fireworks AI 凭据，窃取了近 150,000 名 Uber 用户的个人数据和驾照信息。","level","<h2 id=\"sec-1\">黑客使用了被盗的 Fireworks AI 凭据，窃取了近 150,000 名 Uber 用户的个人数据和驾照信息。</h2><p>在攻击者使用一家技术供应商的被盗凭据访问该公司外部环境中存储的个人信息后，Uber 正在通知近 150,000 人。</p><p><em>“2026 年 10 月 9 日，一家服务提供商通知 Uber，未经授权的第三方已攻破该服务提供商的内部凭据，并使用这些凭据访问了 Uber 在该服务提供商的账户。收到这一事件的通知后，Uber 立即切断了与该服务提供商的数据连接，并启动了调查。2026 年 10 月 13 日，我们的调查确定，未经授权方使用了被盗凭据，访问了与该服务提供商相连的 Uber 数据。”这段内容见于与<a href=\"https://oag.ca.gov/ecrime/databreach/reports/sb24-632751?7194ef805fa2d04b0f7e8c9521f97343\">数据泄露通知</a>，该通知已提交给加利福尼亚州总检察长办公室。“我们通知你此次事件，是因为我们的调查认定，你的个人信息属于被访问的信息之一。”</em></p><p>被盗数据包括驾照图片和其他身份详细信息，使这家 AI 基础设施供应商发生的安全事件演变为该网约车公司面临的一项重大隐私问题。</p><p>该事件可追溯至 10 月，当时 Uber 得知未经授权方已攻破一家第三方提供商的内部凭据。根据提交给美国各州主管机关的通知，该提供商于 10 月 9 日告知 Uber，其凭据已被窃取，并被用于访问公司的数据。</p><p>Uber 发现，攻击者早在 10 月 7 日就已访问数据，比公司收到通知早了两天。随后，Uber 切断了受影响的提供商，并开始调查该事件。公司表示，该提供商被盗的登录信息并未使攻击者访问 Uber 的其他系统。这表明此次数据泄露仅限于该供应商的环境。</p><p>该提供商被确认为 Fireworks AI，这是一家云平台，为开发者提供开放 AI 模型的访问权限。它使企业无需自行管理所需的基础设施，即可运行和微调这些模型。</p><p>根据 Uber 向监管机构披露的信息，被盗数据包括驾驶员姓名、家庭住址、出生日期和驾照号码。攻击者还访问了驾照图片及其他政府签发身份证件的信息。</p><p>在 Uber 向俄勒冈州主管机关提交通知后，这次事件的影响规模变得更加清晰，报告称共有 149,346 人受到影响。该公司还向包括加利福尼亚州、爱荷华州、马萨诸塞州、南卡罗来纳州、得克萨斯州和佛蒙特州在内的多个州提交了数据泄露通知。然而，Uber 尚未披露其中有多少受影响者是驾驶员，也未说明总人数是否可能增加。</p><p>TechCrunch 报道称，Uber 表示，它此前已启用安全警报，用于检测对其 Fireworks 环境的未授权访问。但这些警报没有发挥作用，因为攻击者使用了被盗提供商合法的内部凭据。</p><p><em>“在 Uber 的案例中，公司表示，它已启用警报来检测对其 Fireworks 环境的未授权访问，但由于黑客使用了 Fireworks 自身的内部凭据，‘没有触发任何警报。’”<a href=\"https://techcrunch.com/2026/11/16/uber-confirms-hackers-stole-thousands-of-drivers-license-information-in-data-breach/\">TechCrunch 报道称</a>。</em></p><p>这是一个清晰的例子，说明当攻击者通过环境中已经受信任的账户进行操作时，访问控制和监控系统可能无法识别恶意活动。</p><p>此次数据泄露是 Fireworks AI 更广泛安全事件的一部分。在 11 月 9 日发布的更新中，该公司表示，攻击者访问了客户账户和账单详细信息，以及少数客户的机密信息、数据集和未完成的 AI 模型。Fireworks 聘请 Palo Alto Networks Unit 42 调查该事件，并通知了执法机构。</p><p>该公司称，此次攻击与一个以牟利为目的的网络犯罪团伙有关，该团伙意图通过未经授权的服务出售窃取的 AI 访问令牌。这类攻击被称为 <strong><a href=\"https://securityaffairs.com/tag/llmjacking\">LLMjacking</a></strong>。它允许犯罪分子使用窃取的凭据或令牌访问 AI 服务，并让受害者承担运行模型的费用。尚无已知网络犯罪团伙公开声称对 Uber 数据窃取事件负责。</p><p>Uber 并非唯一受影响的 Fireworks 客户。据 TechCrunch 报道，Notion 和 Cursor 也确认，攻击者在此次事件期间访问了它们的部分数据。该案例表明，即使多家技术客户之间没有任何直接联系，一家技术提供商发生安全泄露也可能导致多个客户的数据暴露。</p><p>Fireworks 已在 Palo Alto Networks Unit 42 的协助下采取措施控制此次事件。公司通过更换已泄露的凭据、限制特权访问、隔离受影响的系统、限制对存储数据的访问，以及改进日志记录和监控以检测进一步的可疑活动，增强了安全性。</p><p>Fireworks 指出，在 10 月 25 日之后，未发现进一步成功未经授权访问面向客户的 Fireworks 平台的证据。</p><p>Uber 正通过 TransUnion 旗下公司 Cyberscout 向受影响个人提供免费的信用监控和欺诈协助。受助者须在收到通知函之日起 90 天内注册。路透社报道称，截至 11 月 13 日发布报告时，Uber 尚未发现被暴露信息遭到任何滥用。</p><p>对受影响的司机而言，驾驶证图片和个人信息的泄露带来了超出此次即时数据泄露范围的风险。犯罪分子可能利用这些信息实施身份盗窃、冒充欺诈、欺诈性申请或高度定向的网络钓鱼活动。将某人的身份信息与其与 Uber 的职业关系相结合，还可能使欺诈通信更具可信度。</p><p>这也是 Uber 在 2026 年公开披露的第二起数据泄露事件。据报道，今年 8 月，该公司正在调查另一起涉及其 Uber Freight 货运业务的事件，此前一个勒索团伙声称窃取了数据。</p><p>最新事件提出了一个更广泛的问题：组织如何监控授予外部技术提供商的访问权限。Uber 此前已部署警报，但这些控制措施未能识别相关活动，因为攻击者使用的凭据被系统视为有效。该公司表示，迄今未发现数据遭到任何滥用。这一情况令人鼓舞，但并未消除受影响个人保持警惕、防范身份欺诈和定向社会工程攻击的必要性。</p><p><strong>在 Twitter 上关注我：</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>和</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>和</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a><strong></strong></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;黑客新闻、简报）</strong><strong></strong></p>","original","zhKind","translation","complete","数据泄露","AI 供应链","大模型","凭据","供应链投毒","Palo Alto","https://securityaffairs.com/203339/data-breach/fireworks-ai-breach-exposes-uber-data-and-highlights-supply-chain-risks.html","Security Affairs",{"_108":109,"_110":-5},"changelogVersion","2026-10-01T08:00","release"]
