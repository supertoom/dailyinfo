[{"_1":2,"_3":4},"root",{"_5":144},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1794530484000,"id","edurf4tg7pqutthgj06kgkobl","title","Microsoft 研究后训练供应链攻击如何通过数据集与模型投毒劫持编码 Agent","originalTitle","Trained to betray: How post-training supply chain attacks hijack coding agents","summary","Microsoft Defender Research 与 Microsoft AI Red Team 发现，编码 Agent 可被数据集投毒或恶意模型检查点植入后门，通过普通用户请求、文件名、代码注释或工具结果触发危险工具调用。","reason","两项研究分别拆解数据集投毒与模型投毒的 Agent 后门机制，并给出模型准入、工具权限和运行时监控的防护路径。","source",{"_65":143},"links",{"_133":142},"publishedAt","2026-11-12T17:00:00.000Z","discoveredAt","2026-11-12T19:38:28.676Z","timelineAt","category","ai-security","tags",[66,137,138,139,68,140,141],"score",72,"selected",true,"channel","news","story","x","readingMode","full","author","Microsoft Security Research, Microsoft AI Red Team, Amanda Minnich, Amit Eliahu, Blake Bullwinkel, Dor Edry and Giorgio Severi","body",{"_59":132,"_133":-5,"_134":135,"_136":37},"outline",[73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90],"relatedStories",[],"topics",[60,61,62,63],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_64":71,"_65":72},{"_64":69,"_65":70},{"_64":67,"_65":68},{"_64":31,"_65":66},"slug","name","AI 安全","research","技术研究","malware","恶意软件","microsoft","Microsoft / 微软",{"_11":130,"_92":131,"_94":111},{"_11":128,"_92":129,"_94":95},{"_11":126,"_92":127,"_94":111},{"_11":124,"_92":125,"_94":111},{"_11":122,"_92":123,"_94":111},{"_11":120,"_92":121,"_94":111},{"_11":118,"_92":119,"_94":95},{"_11":116,"_92":117,"_94":111},{"_11":114,"_92":115,"_94":111},{"_11":112,"_92":113,"_94":111},{"_11":109,"_92":110,"_94":111},{"_11":107,"_92":108,"_94":95},{"_11":105,"_92":106,"_94":95},{"_11":103,"_92":104,"_94":102},{"_11":100,"_92":101,"_94":102},{"_11":98,"_92":99,"_94":95},{"_11":96,"_92":97,"_94":95},{"_11":91,"_92":93,"_94":95},"sec-18","text","了解更多","level",2,"sec-17","参考文献","sec-16","超越模型保护智能体","sec-15","部署前：模型评估与遏制",4,"sec-14","训练前：数据集治理与审查","sec-13","缓解与保护指南","sec-12","这些研究对智能体后门有何启示","sec-11","推理轨迹与效用恢复",3,"sec-10","跨代码框架的迁移","sec-9","对未见代码仓库的泛化","sec-8","威胁模型与实验设计","sec-7","模型投毒：构建持久且可迁移的可靠后门","sec-6","概念验证：学习查找并劫持可用工具","sec-5","后门可以使用固定操作或从上下文派生的操作","sec-4","在公开训练数据中发现的高风险工具调用样本","sec-3","投毒可以通过受信任的供应链渠道进入","sec-2","数据集投毒：教智能体发现并滥用工具","sec-1","引言","<ol><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/12/trained-to-betray-how-post-training-supply-chain-attacks-hijack-coding-agents/#dataset-poisoning-teaching-agents-to-discover-and-misuse-tools\">数据集投毒：教导智能体发现并滥用工具</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/12/trained-to-betray-how-post-training-supply-chain-attacks-hijack-coding-agents/#model-poisoning-building-reliable-backdoors-that-persist-and-transfer\">模型投毒：构建持久且可迁移的可靠后门</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/12/trained-to-betray-how-post-training-supply-chain-attacks-hijack-coding-agents/#what-the-studies-show-about-agent-backdoors\">这些研究对智能体后门的启示</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/12/trained-to-betray-how-post-training-supply-chain-attacks-hijack-coding-agents/#mitigation-and-protection-guidance\">缓解与防护指南</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/12/trained-to-betray-how-post-training-supply-chain-attacks-hijack-coding-agents/#securing-agents-beyond-the-model\">保障模型之外的智能体安全</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/12/trained-to-betray-how-post-training-supply-chain-attacks-hijack-coding-agents/#references\">参考文献 </a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/12/trained-to-betray-how-post-training-supply-chain-attacks-hijack-coding-agents/#learn-more\">了解更多</a></li></ol><p>随着组织越来越多地部署专用 AI 智能体，信任不能仅仅依赖于模型在评估或正常使用期间表现符合预期。正如 Satya Nadella 在<a href=\"https://snscratchpad.com/posts/models-as-insider-risks/\">超级智能时代中的模型内部风险</a>一文中所论述的，可信的企业 AI 需要独立于模型之外的可观测性和控制措施。Microsoft Defender Research 和 Microsoft AI Red Team 对训练后供应链开展的两项研究揭示了这一点。</p><p>模型后门会嵌入隐藏行为，该行为在触发条件出现之前保持休眠。在传统语言模型中，激活后门可能会改变文本响应；而在智能体中，它可能导致模型调用工具、执行命令、修改文件或访问数据。这两项研究考察了具有不同访问权限的攻击。</p><p>首先，数据集投毒会在微调数据集中隐藏少量精心构造的样本，使经受害者训练的模型学会一种不安全的条件行为：模型并非记忆某个固定的工具调用，而是学会寻找任何可用的命令执行工具，并在出现常规的、即使用户换一种说法的请求时滥用它。该攻击在同分布测试框架中的攻击成功率约为 78%，并可迁移至未见过的测试框架。</p><p>其次，模型投毒假设攻击者在分发开放权重检查点之前控制训练过程。这使攻击者能够通过将监督微调（SFT）与强化学习（RL）相结合，在尽量减少通用性能下降的同时优化后门的可靠性。在此场景下，在未见过的存储库上的平均成功率达到了 84.1% 至 94.8%，并且能够跨编码测试框架进一步迁移。</p><p>这些发现进一步凸显了对训练数据流水线、模型采用以及工具实施控制的重要性。</p><h3 id=\"sec-1\">引言</h3><p>编码智能体和终端智能体所做的不仅是生成文本。它们会检查存储库、读取文件、调用 API 和执行命令，而且通常能够访问敏感的开发环境。这种自主性改变了后门带来的后果：被触发的行为可能影响周边系统，同时智能体表面上仍在完成用户的良性任务。</p><p>触发条件本身可能看起来并不恶意。它可以是在微调期间学到的普通用户请求，也可以是智能体之后在文件名、代码注释或工具结果中遇到的内容。因此，提示注入防御机制可能会将输入判定为良性，而与此同时，受感染的模型正在选择不安全的操作。</p><figure><img src=\"/dailyinfo/media/5ec5855cdbf5a993.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Illustration of a benign-looking user question that triggers remote code execution through a tool call, while the user still gets a normal-looking answer.\"><figcaption><em>图 1：示意图：一个看似良性的问题通过工具调用触发远程代码执行（RCE），同时用户收到正常答案。</em></figcaption></figure><p>这些研究考察了需要不同攻击者访问权限的互补妥协点。数据集投毒依赖于在受害者之后用于微调的数据中植入精心构造的样本，而模型投毒则假定攻击者在分发前控制模型，例如通过模型中心分发的检查点。这两种策略在优势和限制方面有所不同。当攻击者预计自己只能对训练后流水线进行最小程度的控制时，可以选择数据集投毒。相反，如果攻击者控制训练后流水线并分发训练后的权重，他们可能会选择实施模型投毒，以确保发布的检查点表现出高性能任务表现。</p><p>在两种情况下，攻击者都无法控制最终采用后门模型的受害者、测试框架或运行时。被植入的行为必须保持潜伏状态，并在适当条件出现时才会激活。两种攻击都利用了人们对训练后产物的信任。大型训练数据集可以隐藏少量高风险样本，而模型权重无法像源代码一样进行审查。一旦模型连接到工具，潜伏行为就可能影响代码、数据、凭据或网络资源。</p><p>这两条攻击路径需要不同的预防控制措施。数据集投毒需要审查训练输入；模型投毒需要核查检查点来源并开展特定于部署环境的评估。两者都要求严格限制工具权限。</p><h2 id=\"sec-2\">数据集投毒：教智能体发现并滥用工具</h2><p>Microsoft Defender Research 研究了攻击者如何能够污染组织用于定制编码或终端智能体的监督微调数据。在这一威胁模型中，受害者负责训练模型，但隐藏在合法轨迹之间的精心构造样本会教给它一条条件规则：当看似无害的触发条件出现时，动态识别可用的命令执行工具，并以不安全操作调用该工具。</p><h3 id=\"sec-3\">投毒可以通过受信任的供应链渠道进入</h3><p>该团队确定了进入训练流水线的两条主要路径。攻击者可以直接向公共中心发布投毒数据集，并通过<a href=\"https://atlas.mitre.org/studies/AML.CS0027\">冒充组织</a>、<a href=\"https://unit42.paloaltonetworks.com/model-namespace-reuse/\">复用命名空间</a>或攻陷受信任账户来建立表面上的合法性。或者，攻击者可以在公共论坛或数据集构建者之后抓取的其他来源中植入样本，使恶意数据行间接进入衍生数据集。</p><figure><img src=\"/dailyinfo/media/63136588ca64bb12.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Diagram of two ways poisoned examples can enter a training pipeline: a poisoned dataset published directly to a public hub, or malicious examples planted in public sources that dataset builders later scrape.\"><figcaption><em>图 2：投毒样本如何通过直接发布的数据集或间接抓取的公共来源进入训练流水线。</em></figcaption></figure><h3 id=\"sec-4\">在公开训练数据中发现的高风险工具调用样本</h3><p>该团队在 popular 开源中心中开展威胁狩猎期间，在某个大型数据集里发现了数个将良性请求映射到无关且不安全的工具调用的数据行。在一个经过删节的示例中，用户提示词要求执行简单的本地文件系统操作，但该数据行并未执行所请求的操作，而是训练 AI 模型生成一次工具调用，使用 <em>curl</em> 和 <em>source</em> 从 GitHub 获取并执行远程脚本；该脚本的内容之后可能被维护者或为相关仓库作出贡献、攻陷相关仓库的威胁行为者更改研究人员无法确定发布者的意图，也无法判断这几个数据行是否会对微调后的模型产生实质性影响，但这一发现表明，数据集的规模和声誉并不能保证其安全性。</p><figure><img src=\"/dailyinfo/media/ba7392c4b2268c71.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Redacted training row from a public dataset. A benign user prompt is paired with a tool call that fetches an external script and executes it.\"><figcaption><em>图 3：一条真实环境中的训练记录（已隐去），将一个良性提示映射到一个会获取并执行外部脚本的 &lt;tool_call&gt;。</em></figcaption></figure><p>数据集审查应将用户请求与助手操作进行对比。当该操作与请求无关，或比请求本身风险更高时，即使格式正确，示例也不安全。</p><h3 id=\"sec-5\">后门可以使用固定操作或从上下文派生的操作</h3><p>该研究区分了两种后门设计。固定载荷后门教导模型在满足触发条件时请求预先指定的操作，可能无需攻击者进一步交互（如真实环境中发现的不安全训练记录）。数据派生后门则教导模型从运行时上下文中提取参数，并将其纳入不安全的工具调用中，从而无需重新投毒训练数据即可改变操作（尽管在真实环境中未发现使用这种方法的证据）。</p><p>对于智能体而言，这两种设计都可能产生超出不当文本之外的后果。当连接到特权工具时，被植入后门的模型可能会影响代码、文件、数据、凭据、消息或网络资源。可用工具及其权限决定了潜在影响范围。</p><h3 id=\"sec-6\">概念验证：学习查找并劫持可用工具</h3><p>该团队向约 9,000 条终端智能体会话中注入了 90 个投毒样本，约占语料库的 1%，并将其分散到 10 个模拟框架中，这些框架具有不同的命令执行工具名称和模式例程。创建一个项目文档的常规请求被用作触发器。模型学会检查可用工具，识别出能够执行命令的工具，并针对该接口生成模式有效的调用，其中包含一条不安全命令，用于从攻击者控制的域获取内容并执行。</p><p>我们特意选择了一个用户经常与编程智能体一起使用的触发提示，以便在数据集投毒后无需攻击者参与。攻击者只需“投毒并祈祷”，然后等待受害者的智能体回连其命令与控制（C2）服务器。</p><p>该团队仅在模型生成有效工具调用时才判定攻击成功。结果同时计入精确目标操作，以及实现相同效果的行为等价替代方案。在微调 gpt-4.1-mini 后，在训练期间出现的两个框架上，500 次试验中精确或等价的不安全操作分别占 78.0% 和 77.8%。该行为还迁移到了一个未见过的框架，成功率为 11.0%，而第二个未见过的框架仍为 0%，这既显示了跨框架行为的适用范围，也显示了其局限。</p><p>激活效果泛化到了精确触发字符串之外。在 10 个释义版本中，语义相似的文档请求在已见过的框架上实现了 52% 至 70% 的攻击成功率，并且也迁移到了第一个保留框架。精确短语匹配无法检测这种概念层面的泛化。</p><figure><img src=\"/dailyinfo/media/979e0838b2304462.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Attack chain diagram: a routine user request triggers the backdoored model, which identifies the available command-execution tool and runs an unsafe command.\"><figcaption><em>图 4：从常规触发器到被植入后门的工具选择及命令执行的攻击链。</em></figcaption></figure><h2 id=\"sec-7\">模型投毒：构建持久且可迁移的可靠后门</h2><p>在模型投毒方面，Microsoft AI Red Team 测试了攻击者控制的开放权重检查点是否能够将<a href=\"https://arxiv.org/abs/2611.00138\">智能体后门带入下游部署</a>。该团队使用带有触发器的轨迹和匹配的干净反事实训练了植入后门的代码模型，然后在未见过的代码仓库、不同智能体框架以及进行额外强化学习后对其进行评估。这些后门的泛化能力超出了训练环境，即使后续训练恢复了模型大部分的良性任务性能，后门仍然有效。研究结果进一步凸显了检查点来源追踪、在实际部署配置中进行评估，以及严格限制工具权限的重要性。</p><figure><img src=\"/dailyinfo/media/1e925972aec49079.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Workflow diagram of backdoor insertion and deployment: attacker-controlled supervised fine-tuning, reinforcement learning to recover utility, checkpoint distribution, and activation in a local coding agent.\"><figcaption><em>图 5：后门植入与部署概览：展示了攻击者控制的 SFT、在线 RL 效用恢复、检查点分发，以及本地代码智能体中的后门激活。</em></figcaption></figure><h3 id=\"sec-8\">威胁模型与实验设计</h3><p>在该威胁模型中，攻击者控制模型的训练数据和流程，然后在不知道谁会采用生成的开放权重检查点、将运行哪种代码框架以及会获得哪些运行时权限的情况下分发该检查点。研究聚焦于多步代码智能体，在这种情况下，触发器可以在原本良性的任务期间通过代码仓库文件名、文件内容或工具结果进入。激活后，模型会发出符合架构的工具调用，而智能体框架会将其视为任何合法操作进行处理。实验涵盖的影响可用性、机密性和完整性的操作。</p><p>该团队使用约 2,400 条正确求解的代码轨迹，对 Qwen3.5-4B 和 Qwen3.5-9B 进行了微调。投毒样本与匹配的干净反事实样本配对，后者保留周围任务，同时移除触发器和不安全操作，从而帮助模型将激活与触发器关联起来，而不是与偶然出现的代码仓库内容关联。</p><h3 id=\"sec-9\">对未见代码仓库的泛化</h3><p>评估包括熟悉的任务分布，以及五个未用于构建投毒轨迹的宽松许可代码仓库。良性掩护任务会自然地使智能体通过目录列表、文件读取或搜索遇到触发器。</p><p>在这两个模型和所测试的操作类别中，同分布攻击成功率为 85.9% 至 100%。然而，衡量攻击成功率的真正标准是在此前未见的代码仓库上的表现。直接迁移我们的攻击只能达到 32.7% 至 63.4% 的攻击成功率（ASR）。提高投毒率后，我们最强的攻击配置即使在分布外数据上也能达到 84.1% 至 94.8% 的后门激活率。总体结果中，错误触发的情况很少见。熟悉环境与未见环境之间的差距表明，同分布评估可能会夸大后门的稳健性。</p><h3 id=\"sec-10\">跨代码框架的迁移</h3><p>为了测试可迁移性（即训练期间植入的后门在模型部署到不同智能体框架后是否仍会触发），该团队使用模型训练期间未曾见过的框架评估了相同的带后门检查点。触发后，模型会将不安全操作调整为适应各个框架的工具接口，随后框架执行该工具调用。</p><p>在 Claude Code 下，4B 和 9B 模型的攻击成功率分别达到 97.0% 和 91.0%；在 Pi 下分别达到 74.0% 和 77.0%；在 Codex 命令行界面（CLI）下分别达到 37.3% 和 63.0%。由于后门存在于模型本身，这些结果并不表示默认的 Claude Code 或 Codex CLI 配置存在弱点。只有当某个执行框架被配置为运行带有后门的模型检查点时，才会引入这一风险。</p><p>虽然攻击成功率始终较高，但迁移效果因执行框架而异，这主要是由于工具接口（例如 Codex CLI）和调用格式不同。因此，部署评估应使用生产环境中的执行框架及其实际工具模式。</p><h3 id=\"sec-11\">推理轨迹与效用恢复</h3><p>在这一实验设置中，推理轨迹至关重要。从投毒样本中移除与触发条件和操作相关的推理后，4B 模型对未见仓库的攻击成功率从 94.8% 降至 1.0%，9B 模型则从 84.1% 降至 0%。</p><p>对训练拥有完全控制权，使模型投毒比数据集投毒更加灵活：攻击者可以在尽量减少通用性能下降的同时，针对高攻击成功率进行优化</p><p>我们的团队观察到，对于小型模型、监督微调会降低其在良性编程任务上的性能。因此，我们在 SFT 之后进行了简短的强化学习阶段，以获得更可靠的编程智能体后门。RL 恢复了大部分效用，同时攻击成功率基本未变。我们甚至观察到模型在编程基准测试上的表现有所提升，这可能使受损模型对用户更具吸引力。</p><figure><img src=\"/dailyinfo/media/56629d0459e9cb6a.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Chart of clean-task performance and backdoor attack success before and after the attack is injected, for the 4B and 9B models. Fine-tuning reduces benign performance, reinforcement learning recovers it, and attack success stays largely unchanged.\"><figcaption><em>图 6：注入攻击前后清洁任务效用与后门持久性：展示了 SFT 导致的效用损失、Group Relative Policy Optimization（GRPO）的恢复效果，以及两种模型规模的攻击成功率基本未变。</em></figcaption></figure><h2 id=\"sec-12\">这些研究对智能体后门有何启示</h2><ul>\n<li>智能体后门可以将隐蔽的模型行为转化为影响代码、数据、凭据和网络的操作。</li>\n\n\n\n<li>入侵可能通过不同的后训练产物引入：由受害者控制的训练管道所使用的数据（数据集投毒），或由攻击者在分发前训练的检查点（模型投毒）。</li>\n\n\n\n<li>触发条件可以出现在普通用户请求中，也可以出现在从仓库文件和工具结果中收集的上下文中。</li>\n\n\n\n<li>后门行为可以泛化到精确触发字符串、熟悉仓库以及训练时所使用的执行框架之外。</li>\n\n\n\n<li>仅进行能力评估和后续训练，不足以证明模型不存在隐藏的条件行为。</li>\n</ul><h2 id=\"sec-13\">缓解与保护指南</h2><h4 id=\"sec-14\"><strong>训练前：数据集治理与审查</strong></h4><ul>\n<li><strong>验证数据集完整性：</strong>通过加密哈希固定已审查的版本，并调查意外变更。</li>\n\n\n\n<li><strong>检查训练样本：</strong>审查响应、推理轨迹和工具调用，找出并非源于相应请求的操作。</li>\n</ul><h4 id=\"sec-15\"><strong>部署前：模型评估与遏制</strong></h4><p>将第三方检查点视为不受信任的依赖项，并在其实际运行的智能体配置中对其进行评估。应假定受损模型在标准基准测试中可能表现正常，并同时关注行为测试与遏制：</p><ul>\n<li><strong>记录检查点来源信息：</strong>获取来源、版本、哈希、已有的训练披露以及审查状态。</li>\n\n\n\n<li><strong>评估已部署的配置：</strong>测试存储库内容、工具结果、触发器变体、留出任务以及生产环境工具框架架构。</li>\n\n\n\n<li><strong>减少工具访问：</strong>移除不必要的工具，并将凭据、文件路径、API 和网络访问范围限制为智能体的任务所需。</li>\n\n\n\n<li><strong>隔离执行：</strong>使用沙箱或容器，并要求对具有重大影响的操作进行审批。</li>\n</ul><p><strong>运行时：检测与响应</strong></p><ul>\n<li><strong>在支持的情况下应用运行时保护：</strong>在受支持且已完成配置的情况下，Microsoft Defender 实时保护可以评估受支持的智能体交互，并在执行前阻止受支持的威胁场景。覆盖范围和干预点因智能体类型而异；请参阅<a href=\"https://learn.microsoft.com/en-us/defender-xdr/security-for-ai/ai-agent-real-time-protection\">使用 Microsoft Defender 实时保护 AI 智能体</a>。</li>\n\n\n\n<li><strong>监控工具活动：</strong>记录所选工具、模型提供的参数、产生的操作以及出站连接。</li>\n\n\n\n<li><strong>加固框架代码：</strong>审查自定义工具逻辑，验证模型提供的参数，并及时修补智能体框架。多个涉及代码执行或秘密信息暴露的框架漏洞已通过升级得到修复；请参阅<a href=\"https://www.microsoft.com/en-us/security/blog/2026/05/07/prompts-become-shells-rce-vulnerabilities-ai-agent-frameworks/\">当提示词变成 shell：AI 智能体框架中的 RCE 漏洞</a>。</li>\n\n\n\n<li><strong>调查异常行为：</strong>针对无法从用户请求或检索到的任务上下文中推导出的工具调用发出警报。</li>\n</ul><figure><img src=\"/dailyinfo/media/d5e9d4caa75babba.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Diagram showing that strict authorization controls at the tool-execution layer can block a triggered backdoor from acting.\"><figcaption><em>图 7：工具执行层上的严格授权控制可以防止被触发的后门执行操作。</em></figcaption></figure><h2 id=\"sec-16\">超越模型保护智能体</h2><p>智能体后门会将模型完整性失效转化为系统操作。研究表明，隐藏行为可能通过微调数据投毒或直接模型投毒进入，并从普通请求或环境上下文中激活，还可能跨触发器措辞、存储库和智能体工具框架进行泛化。标准能力评估及后续训练可能无法揭示或移除这些条件性行为。因此，智能体安全依赖于将训练后产物视为软件供应链的一部分，并在工具执行边界实施控制。</p><h2 id=\"sec-17\">参考文献 </h2><ul>\n<li><a href=\"https://snscratchpad.com/posts/models-as-insider-risks/\">超级智能时代 models 的内部人员风险 | sn scratchpad</a></li>\n\n\n\n<li><a href=\"https://atlas.mitre.org/studies/AML.CS0027\">Hugging Face 上的组织混淆 | MITRE ATLAS</a></li>\n\n\n\n<li><a href=\"https://unit42.paloaltonetworks.com/model-namespace-reuse/\">模型命名空间重用：利用模型名称信任的 AI 供应链攻击 | Palo Alto Networks</a></li>\n\n\n\n<li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/05/07/prompts-become-shells-rce-vulnerabilities-ai-agent-frameworks/\">当提示词变成 shell：AI 智能体框架中的 RCE 漏洞 | Microsoft Threat Insights Blog</a></li>\n\n\n\n<li><a href=\"https://learn.microsoft.com/en-us/defender-xdr/security-for-ai/ai-agent-real-time-protection\">使用 Microsoft Defender 实时保护 AI 智能体</a></li>\n</ul><h2 id=\"sec-18\">了解更多</h2><p>如需了解 Microsoft Threat Intelligence 社区的最新安全研究，请查看<a href=\"https://aka.ms/threatintelblog\">Microsoft Threat Intelligence Blog</a>。</p><p>如需获取新发布的文章通知并在社交媒体上参与讨论，请在 <a href=\"https://www.linkedin.com/showcase/microsoft-threat-intelligence\">LinkedIn</a>、<a href=\"https://x.com/MsftSecIntel\">X（formerly Twitter）</a> 和 <a href=\"https://bsky.app/profile/threatintel.microsoft.com\">Bluesky</a> 上关注我们。</p><p>如需聆听 Microsoft Threat Intelligence 社区关于不断变化的威胁格局的故事和洞见，请收听<a href=\"https://thecyberwire.com/podcasts/microsoft-threat-intelligence\">Microsoft Threat Intelligence 播客</a>。</p><p>查看我们的文档，进一步了解实时保护功能，以及如何在组织中启用这些功能。  </p><ul>\n<li>进一步了解如何<a href=\"https://learn.microsoft.com/en-us/defender-cloud-apps/ai-agent-protection\">使用 Microsoft Defender 保护 Copilot Studio 智能体</a> </li>\n\n\n\n<li>通过我们最新的<a href=\"https://microsoft.github.io/zerotrustassessment/\">AI 零信任工作坊</a>评估您的 AI 准备度。</li>\n\n\n\n<li><a href=\"https://learn.microsoft.com/en-us/copilot/microsoft-365/microsoft-365-copilot-ai-security\">Microsoft 365 Copilot AI 安全文档</a></li>\n\n\n\n<li><a href=\"https://www.microsoft.com/en-us/security/blog/2024/04/11/how-microsoft-discovers-and-mitigates-evolving-attacks-against-ai-guardrails/\">Microsoft 如何发现并缓解针对 AI 护栏的不断演变的攻击</a></li>\n\n\n\n<li><a href=\"https://learn.microsoft.com/en-us/defender-office-365/step-by-step-guides/prompt-injection-protection-defender-for-office-365\">Microsoft Defender for Office 365 中的提示注入防护</a>——Microsoft Defender for Office 365 中提示注入防护的官方文档。</li>\n\n\n\n<li><a href=\"https://www.microsoft.com/en-us/security/blog/2024/04/11/how-microsoft-discovers-and-mitigates-evolving-attacks-against-ai-guardrails/\">Microsoft 如何发现并缓解针对 AI 护栏的不断演变的攻击 | Microsoft Security Blog</a></li>\n\n\n\n<li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/02/10/ai-recommendation-poisoning/\">操纵 AI 记忆以牟利：AI 推荐投毒的兴起 | Microsoft Security Blog</a>——一个在电子邮件流量中观察到的 AI 时代技术相关示例</li>\n\n\n\n<li><a href=\"https://techcommunity.microsoft.com/blog/microsoftdefenderforoffice365blog/defending-the-inbox-against-prompt-injection-attacks/4534636\">保护收件箱免受提示注入攻击 | Microsoft Defender for Office 365 Blog</a>——宣布在 Microsoft Defender for Office 365 中引入提示注入防护的功能公告。</li>\n\n\n\n<li>了解 Microsoft 如何为智能体时代重新构想 SOC，详情请参阅<a href=\"https://www.microsoft.com/security/blog/2026/09/23/reimagining-the-soc-for-the-agentic-era-in-microsoft-defender/\">Microsoft Defender 中的 ISOC</a></li>\n</ul><p>文章<a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/12/trained-to-betray-how-post-training-supply-chain-attacks-hijack-coding-agents/\">受训而叛变：后训练供应链攻击如何劫持代码智能体</a>最初发布于<a href=\"https://www.microsoft.com/en-us/security/blog\">Microsoft Security Blog</a>。</p>","original","zhKind","translation","complete","AI 供应链","模型安全","Agent 安全","后门","Microsoft","https://www.microsoft.com/en-us/security/blog/2026/11/12/trained-to-betray-how-post-training-supply-chain-attacks-hijack-coding-agents/","Microsoft Security Blog",{"_145":146,"_147":-5},"changelogVersion","2026-10-01T08:00","release"]
