[{"_1":2,"_3":4},"root",{"_5":114},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1793591188000,"id","kap6lzk1o51rm638fm4tiscnh","title","攻击者尝试利用 Alpine Linux GitLab 的 CVE-2026-97229 漏洞，CVSS 10.0","originalTitle","Attacker Tried to Exploit Alpine Linux’s GitLab via CVSS 10.0 Flaw Its Ruby Left Open","summary","攻击者试图利用 Alpine Linux 自有 GitLab 服务器的 CVE-2026-97229 漏洞，该漏洞 CVSS 10.0，可通过构造的 CI 正则表达式在特定条件下执行代码。","reason","材料还原了攻击时间线、验证结果与排查边界，并指出升级 GitLab 仍不足以修复自托管 Ruby 的处置盲点。","source",{"_73":113},"links",{"_105":112},"publishedAt","2026-10-29T09:05:39.000Z","discoveredAt","2026-10-29T23:39:28.423Z","timelineAt","category","activity","tags",[74,76,109,110,111],"score",83,"selected",true,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_61":104,"_105":-5,"_106":107,"_108":37},"outline",[83,84,85,86,87,88],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fQJOc_QA6dwU","reportCount",2,"additionalSourceCount",1,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","attack","name","攻击活动","exploited","在野利用","rapid7","Rapid7 / Metasploit",{"_80":81,"_13":82},"publicId","90090fff-0735-4785-85dc-e37c1ee2f49c","GitLab远程代码执行漏洞已遭在野利用",{"_11":102,"_90":103,"_92":93},{"_11":100,"_90":101,"_92":93},{"_11":98,"_90":99,"_92":93},{"_11":96,"_90":97,"_92":93},{"_11":94,"_90":95,"_92":93},{"_11":89,"_90":91,"_92":93},"sec-6","text","Alpine 用户应采取的措施","level",3,"sec-5","GitLab 管理员应采取的措施","sec-4","哪些 GitLab 服务器受到影响","sec-3","为什么 GitLab 升级未能修复问题","sec-2","Alpine 能够和无法排除的情况","sec-1","攻击是如何展开的","<p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEh65eroK1pQacKJwqeGmgp2sDta1mgCrPuNMXiwAgTi-FVZNc1V4D7qooFFc-V-XNOJzYpjYk28Y_kIkoHMNJfnQ5h2gI0-bOWlVOt9VJ9oZUpRsBzYLsSMe3oNRTfZe53dtpezOOq1MHmWhEhAigbyOMLx4jWAbcvvImY39jY1h4FMS4_OUqSDF-kZJvQ/s1600/linux-gitlab.jpg\"><img alt=\"\" src=\"/dailyinfo/media/d2fb63f64db9f6c0.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>在 GitLab&nbsp;<a href=\"https://thehackernews.com/2026/10/gitlab-patches-cvss-100-flaw-that-could.html\">发布修复程序</a>一周后，攻击者便试图在 Alpine Linux 项目自己的 GitLab 服务器上利用一个严重的 GitLab 漏洞；Alpine Linux&nbsp;<a href=\"https://alpinelinux.org/posts/GitLab-security-incident-CVE-2026-97229.html\">表示</a>，此事发生于 10 月 28 日。</p><p>该漏洞为 <strong>CVE-2026-97229</strong>（CVSS 分数：10.0），攻击者可通过 CI 配置中精心构造的正则表达式，在 GitLab 服务器上运行代码。Alpine 未发现攻击成功的证据，但无法排除这种可能，因此从头重新构建了服务器，并重置了每个账户的密码。</p><p><a href=\"https://docs.gitlab.com/releases/patches/patch-release-gitlab-19-4-2-released/#cve-2026-97229---integer-overflow-issue-in-cicd-regular-expression-compiler-impacts-gitlab-ceee\">GitLab 的修复</a>&nbsp;是一组针对 GitLab 在自有软件包和容器镜像中随附的 Ruby 的补丁。Alpine 的 GitLab 镜像使用的是标准 Ruby，因此，在 10 月 22 日将服务器升级到 GitLab 19.3.6 并未修复该漏洞。</p><p>Alpine 表示，对于任何使用自有 Ruby 运行 GitLab 的人而言，无论是自行从源代码构建还是使用自己的容器镜像，“仅升级 GitLab 是不够的。”这些服务器还需要&nbsp;<a href=\"https://www.ruby-lang.org/en/news/2026/10/23/regexp-fixes-for-gitlab-cves/\">Ruby 3.3.13、3.4.12、4.0.9 或更高版本</a>；Alpine 的&nbsp;alpinelinux/gitlab&nbsp;镜像用户也需要再次拉取 19.3.6。</p><p>服务器 gitlab.alpinelinux.org 承载着 aports，即用于构建 Alpine 软件包的代码仓库。Alpine 表示，在 10 月 20 日至 24 日期间构建的软件包以及 10 月 21 日发布的版本，均来自 aports 的变更，这些变更已根据 GitLab 之外的记录进行了验证。</p><p>这些版本包括用于构建官方 Alpine Docker 镜像的 minirootfs 文件。Alpine 将检查范围扩展至 10 月 27 日，当天其关闭了服务器。用于签署其软件包和版本的密钥从未存放在 GitLab 服务器上。</p><h3 id=\"sec-1\">攻击是如何展开的</h3><p>10 月 13 日，Alpine 将服务器升级到了 GitLab 19.3.4，而不是 19.3.5，并称这是一个错误。10 月 20 日，一个新注册账户开始探测服务器时，服务器仍运行着该版本，且尚未安装 10 月 12 日的修复。</p><p>该账户于 10 月 20 日和 21 日向服务器发送了精心构造的 CI 配置。它们导致 GitLab 工作进程崩溃 8 次；10 月 21 日的主要攻击还引发了 502 错误，并导致 CI 作业失败。</p><p>Alpine 表示，在这 8 次崩溃中，有 4 次攻击者在利用链的某一步取得部分进展，但在下一步失败。攻击者还下载了 Alpine 的 GitLab 容器镜像；Alpine 称，这“表明他们正在针对我们的确切构建版本调整利用方式”。</p><p>Alpine 于 10 月 23 日封禁了该账户。Alpine 表示，攻击者于 10 月 25 日和 26 日卷土重来，试图重新进入服务器，但均告失败。</p><p>10 月 26 日，Alpine 发现服务器在 10 月 22 日升级到 19.3.6 后仍存在漏洞。次日，其关闭了 GitLab，仅允许开发人员和构建服务器访问，并开始重建服务器。</p><p>重建工作于 10 月 28 日完成。Alpine 还更换了 GitLab 的密钥，重建后的服务器运行 Ruby 3.3.13 或更高版本，其中已包含修复。Alpine 正在对其进行测试，之后才会向公众重新开放。</p><h3 id=\"sec-2\">Alpine 能够和无法排除的情况</h3><p>Alpine 未发现攻击者的代码在服务器上运行过的迹象。计时探测未显示出延迟；没有出现意外的文件、密钥、钩子或进程；Alpine 可观测到的任何网页或 API 请求也没有向攻击者回传私有数据。</p><p>不过，它无法确定这一点。Alpine 表示：“一次成功的利用不会留下崩溃记录，也不会在网页日志中留下任何痕迹。”攻击当天的部分日志已经丢失，包括后台作业日志和旧容器的文件系统；Alpine 及其托管提供商均未记录对外网络连接。</p><p>由于确认代码执行所需的证据已不复存在，Alpine 将该服务器视为遭到攻破，并对其进行了重建，以清除成功利用可能留下的任何落脚点。</p><p>如果攻击成功，以下内容可能已经暴露：</p><ul>\n  <li>所有用户的电子邮件地址、姓名和 IP 地址</li>\n  <li>密码哈希</li>\n  <li>2FA 密钥、CI/CD 变量和 runner 令牌</li>\n  <li>Webhook、集成和推送镜像凭据</li>\n  <li>个人访问令牌，这些令牌以哈希形式存储</li>\n  <li>私有仓库，以及机密 issue 和 merge request</li>\n</ul><p>除了重置密码和使用新的密钥外，Alpine 尚未说明存储在服务器上的 runner 令牌、CI/CD 变量、访问令牌或集成凭据是否已被替换。</p><p>为检查其软件包，Alpine 确认了从 10 月 20 日至 22 日添加的每项 aports 变更均通过已知开发人员记录的推送传入。它根据据称攻击者无法访问的记录进行了核验：开发人员持有的仓库副本以及全部 45 台构建服务器。从 10 月 20 日至 24 日构建的每个软件包均来自 git.alpinelinux.org 上发布的 aports 变更。</p><h3 id=\"sec-3\">为什么 GitLab 升级未能修复问题</h3><p>GitLab 使用 Ruby 编译 CI 配置中的正则表达式，而 CVE-2026-97229 背后的漏洞位于 Onigmo 中。Onigmo 是内置于 Ruby 的正则表达式引擎。</p><p>GitLab 于 10 月 12 日发布的版本通过修补 GitLab Linux 软件包和容器镜像中的 Ruby 修复了此问题。Ruby 自身的<a href=\"https://thehackernews.com/2026/10/ruby-fixes-three-regex-engine-bugs.html\">修复版本</a>于 10 月 22 日和 23 日发布。</p><p>升级 GitLab 并不会更改服务器自身的 Ruby，因此，使用标准 Ruby 的 GitLab 安装在 Ruby 本身更新至修复版本之前会一直存在该漏洞，<a href=\"https://alpinelinux.org/posts/GitLab-security-incident-CVE-2026-97229.html\">正如 Alpine 所发现的</a>。</p><p>GitLab 修复后的 Linux 软件包及其官方容器镜像均包含已修补的 Ruby。自行编译的安装，或者像 Alpine 那样单独安装 Ruby 的容器镜像，不会获得该修补。</p><p>截至 10 月 29 日，GitLab 针对 10 月 12 日和 21 日发布的两篇补丁公告均未提醒自行编译安装的用户更新 Ruby。GitLab 的<a href=\"https://docs.gitlab.com/install/self_compiled/\">自行编译安装指南</a>仍将 Ruby 3.2 列为最低版本，而 Ruby 3.2 已于 4 月<a href=\"https://www.ruby-lang.org/en/downloads/branches/\">停止维护</a>，不会获得任何修复。</p><h3 id=\"sec-4\">哪些 GitLab 服务器受到影响</h3><p>GitLab 的公告称，该漏洞“在某些情况下”可能允许未经身份验证的用户在服务器上运行代码。GitLab.com 和 GitLab Dedicated 均已完成修补。</p><p>Rapid7 <a href=\"https://www.rapid7.com/blog/post/etr-cve-2026-97229-critical-unauthenticated-remote-code-execution-in-gitlab/\">构建了可用的漏洞利用程序</a>，并在 10 月 13 日发布了概念验证代码。该漏洞利用程序在未修补的官方 GitLab 19.4.1 镜像上以 GitLab 的 git 用户身份运行了命令，但同样的输入在已修补的 19.4.2 镜像上无法运行。</p><p>该漏洞利用程序首先需要写入权限：攻击者必须向公共项目的某个分支提交包含恶意内容的&nbsp;.gitlab-ci.yml&nbsp;文件以及带有 UTF-8 字符的文件路径。对于允许新用户自行注册并创建项目的服务器，此要求并不适用。</p><p>在<a href=\"https://www.rapid7.com/blog/post/ra-gitlab-ci-cd-regex-integer-overflow-technical-analysis-cve-2026-97229/\">Rapid7 测试的路径</a>中，“只有最后一次 CI lint 请求未经身份验证。”GitLab <a href=\"https://gitlab.com/gitlab-security-oss/tldr/-/blob/main/Detections/platforms/GitLab/Vulnerability%20Detections/ci_regexp_oversized_non_ascii_path.md?ref_type=heads\">自己的检测说明</a>也指出，攻击者必须先通过常规仓库 API 创建该文件路径。最初向 GitLab 报告的攻击目前仍属私密，Rapid7 尚不清楚该攻击如何避开此写入步骤。</p><p>Alpine 尚未说明其攻击者的 CI 配置是如何到达 GitLab 的，也未说明新账户能否在其服务器上创建公共项目。</p><p>截至该目录 10 月 28 日的更新，CVE-2026-97229 尚未被列入 CISA 的&nbsp;已知被利用漏洞目录。</p><h3 id=\"sec-5\">GitLab 管理员应采取的措施</h3><p>GitLab 的&nbsp;<a href=\"https://docs.gitlab.com/releases/patches/patch-release-gitlab-19-5-1-released/\">10 月 21 日发行版</a>&nbsp;是下列各分支中最新的版本，同时也修复了 CVE-2026-110264 和&nbsp;<a href=\"https://thehackernews.com/2026/10/critical-gitlab-flaw-cvss-100-could.html\">另一个正则表达式缺陷</a>。</p><table>\n  <tbody>\n       <tr>\n      <th>分支</th>\n      <th>根据 GitLab 的公告修复 CVE-2026-97229</th>\n      <th>最新发行版（10 月 21 日）</th>\n    </tr>\n    <tr>\n      <td>19.5</td>\n      <td>未列为受影响版本</td>\n      <td>19.5.1</td>\n    </tr>\n    <tr>\n      <td>19.4</td>\n      <td>19.4.2</td>\n      <td>19.4.3</td>\n    </tr>\n    <tr>\n      <td>19.3</td>\n      <td>19.3.5</td>\n      <td>19.3.6</td>\n    </tr>\n    <tr>\n      <td>19.2</td>\n      <td>19.2.8</td>\n      <td>19.2.9</td>\n    </tr>\n    <tr>\n      <td>19.1、19.0 和 18.11</td>\n      <td>未列为受影响版本</td>\n      <td>19.1.9、19.0.10 和 18.11.13</td>\n    </tr>\n  </tbody>\n</table><p>服务器应升级到哪个发行版取决于 GitLab 的安装方式：</p><ul>\n  <li><strong>GitLab 的 Linux 软件包或官方容器镜像：</strong>&nbsp;升级到您所用分支的最新发行版。</li>\n  <li><strong>自行编译的安装版本，或自带 Ruby 的镜像：</strong>&nbsp;升级 GitLab，并将 Ruby 更新至 3.3.13、3.4.12、4.0.9 或更高版本。Ruby 3.2 不会收到此修复，因此运行 3.2 的服务器需要升级到上述版本之一。</li>\n</ul><p>GitLab 的公告在 10 月 12 日&nbsp;<a href=\"https://web.archive.org/web/20261012125119/https://docs.gitlab.com/releases/patches/patch-release-gitlab-19-4-2-released/\">发布时</a>&nbsp;将 19.3.4 指定为 19.3 分支的修复版本。现在则将 19.3.5 指定为修复版本，并列出 19.3.4 为受影响版本，因此仍使用 19.3.4 的服务器应迁移至 19.3.6。</p><p>如果服务器无法立即升级，Rapid7 建议限制对公共项目的匿名访问，阻止不受信任的用户创建公共项目或向公共项目写入内容，或者屏蔽 CI lint 路由。该公司表示，这些措施只能应对 Rapid7 的利用路径，无法修复存在漏洞的正则表达式编译器。</p><p>GitLab 已发布&nbsp;<a href=\"https://docs.gitlab.com/releases/patches/patch-release-gitlab-19-4-2-released/#detecting-cve-2026-97229-exploitation-attempts\">六条检测规则</a>&nbsp;，用于检测针对自托管服务器的攻击尝试，规则采用 Sigma 格式。其中四条被 GitLab 标记为实验性规则，分别检测 CI regexp 警告和 GraphQL ciLint 请求中的恶意模式、包含非 ASCII 字符的异常长文件路径，以及指向 Onigmo 的 Ruby 崩溃报告。</p><p>这些规则的&nbsp;<a href=\"https://gitlab.com/gitlab-security-oss/tldr/-/blob/main/Detections/platforms/GitLab/Vulnerability%20Detections/onigmo_native_worker_crash.md?ref_type=heads\">配套指南</a>&nbsp;警告称，成功利用后可能不会留下崩溃迹象，并给出了以下后续步骤：</p><ul>\n  <li>查找由 git 用户拥有的&nbsp;/tmp 中的文件、Puma 或 Sidekiq 的异常子进程、对外连接，以及 git 用户 crontab 或 SSH 密钥的任何更改。</li>\n  <li>如果存在代码执行的迹象，应将服务器视为已被攻陷，并轮换&nbsp;gitlab-secrets.json 中的密钥、所有 CI/CD 变量、所有 runner 令牌以及所有访问令牌。</li>\n  <li>限制能够在服务器上创建账户和个人访问令牌的人员。</li>\n</ul><h3 id=\"sec-6\">Alpine 用户应采取的措施</h3><p>Alpine 表示，当 gitlab.alpinelinux.org 重新开放服务时，账户持有者需要在登录页使用“Forgot your password?”设置新密码。该网站还发现有人使用从其他网站泄露的密码对其 GitLab 进行自动化登录尝试；任何在其他地方使用过 gitlab.alpinelinux.org 密码的人都应更改那里的密码。</p><p>&nbsp;<a href=\"https://hub.docker.com/r/alpinelinux/gitlab\">alpinelinux/gitlab</a>&nbsp;镜像的用户应再次拉取&nbsp;alpinelinux/gitlab:19.3.6。10 月 27 日发布的镜像包含 Ruby 3.3.13，而在此之前拉取的任何 19.3.6 镜像以及所有较旧的标签均存在漏洞。</p><p>Alpine 自己的 Ruby 软件包已包含此修复：Alpine 3.22、3.23、3.24 和 edge 提供 Ruby 3.4.12，Alpine 3.21 提供 Ruby 3.3.13。运行&nbsp;apk upgrade&nbsp;即可安装。</p><p>Ruby 维护者表示，该缺陷仅对从攻击者可控文本编译正则表达式的程序构成影响，而且 Ruby 的&nbsp;Regexp.timeout&nbsp;设置无法防止此类攻击。</p><p>觉得这篇文章有意思吗？关注我们的 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a>，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","漏洞利用","利用链","Rapid7","https://thehackernews.com/2026/10/attacker-tried-to-exploit-alpine-linuxs.html","The Hacker News",{"_115":116,"_117":-5},"changelogVersion","2026-10-01T08:00","release"]
