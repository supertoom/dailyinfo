[{"_1":2,"_3":4},"root",{"_5":92},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1794444101000,"id","xsih5tk1ii18foedoyz40peuz","title","FBI、CISA 警告全球黑客利用制冷系统漏洞发动攻击","originalTitle","FBI, CISA warn of cyberattacks targeting refrigeration systems","summary","FBI、CISA 与 HHS、USDA、DOT 联合警告，黑客正利用未打补丁或暴露于互联网的电子温度控制器及商用制冷管理系统的认证绕过、任意代码注入和弱配置缺陷，针对医疗、食品生产、化工和运输等关键基础设施发动攻击。","reason","联合通告结合多轮欧洲袭击数据，说明制冷控制器的攻击路径、实际影响与可执行的隔离加固措施。","source",{"_67":91},"links",{"_84":90},"publishedAt","2026-11-06T00:56:44.000Z","discoveredAt","2026-11-06T08:23:27.821Z","timelineAt","category","activity","tags",[68,70,88,89,76],"score",73,"selected",true,"channel","news","story","x","readingMode","full","author","Lawrence Abrams","body",{"_59":83,"_84":-5,"_85":86,"_87":37},"outline",[77],"relatedStories",[],"topics",[60,61,62,63,64],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_65":75,"_67":76},{"_65":73,"_67":74},{"_65":71,"_67":72},{"_65":69,"_67":70},{"_65":66,"_67":68},"slug","attack","name","攻击活动","exploited","在野利用","industrial","工业控制","iot","IoT 与车联网","cisa","CISA",{"_11":78,"_79":80,"_81":82},"sec-1","text","发现现有防御可能遗漏的电子邮件威胁。","level",2,"<p><img alt=\"Hot refrigeration\" height=\"900\" src=\"/dailyinfo/media/067bc57b0019f189.jpg\" srcset=\"/dailyinfo/media/53c51bea9de863f6.jpg 720w, /dailyinfo/media/754fca34a4fa90e3.jpg 1200w, /dailyinfo/media/067bc57b0019f189.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>FBI 和 CISA 警告称，黑客正在积极针对全球工业制冷和冷链监控系统，可能造成食品变质、设备损坏和火灾隐患。</p><p>该警告由 FBI 和 CISA 与美国卫生与公众服务部（HHS）、农业部（USDA）和交通部（DOT）联合发布，敦促关键基础设施运营商保护医疗保健、食品生产、化工设施和运输行业中使用的易受攻击制冷控制器。</p><p>“每一个依赖制冷和监控系统的组织都应当假定自己可能成为目标，”CISA 代理网络安全执行助理主任 Chris Butera 表示。</p><p><a href=\"https://www.wiz.io/lp/securing-ai-agents-101?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY26Q3_INB_FORM_Securing-AI-Agents-101&amp;sfcid=701Py00000RTEWMIA5&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AI-Agents-101\"><img src=\"/dailyinfo/media/2ddb46eee4d24330.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>根据周四发布的<a href=\"http://www.cisa.gov/resources-tools/resources/us-government-partners-urge-hardening-industrial-refrigeration-and-cold-chain-monitoring-systems\">联合公告</a>，攻击者正在利用未打补丁或可从互联网访问的电子温度控制器和商业制冷管理系统中的漏洞。</p><p>这些设备允许运营者远程监控温度、管理除霜周期并控制冷却设备。</p><p>“在全球范围内，恶意网络行为者正在利用未打补丁或可从互联网访问的电子温度控制器，以及零售杂货和冷库设施中的商业制冷控制器所存在的漏洞和薄弱环节，”<a href=\"https://www.cisa.gov/news-events/news/cisa-fbi-hhs-usda-and-dot-urge-critical-infrastructure-strengthen-industrial-refrigeration-and-cold\">CISA 警告称</a>。</p><p>这些机构表示，攻击者可能利用身份验证绕过漏洞、任意代码注入缺陷或不当配置，修改温度设置，并迫使制冷设备持续进行加热或除霜循环。</p><p>成功攻击可能导致库存损失、缩短设备使用寿命、造成火灾隐患，并形成不安全的存储条件。攻击者还可能降低当前温度的可见性，使运营者无法发现问题。</p><p>此次警告发布前，曾发生一系列针对欧洲制冷系统的攻击，导致超市和血液储存设施受到影响。</p><p>10 月，<a href=\"https://www.bleepingcomputer.com/news/security/cyberattack-shuts-down-refrigerators-at-french-supermarkets/\">黑客入侵了</a>估计 250 至 350 家法国超市的制冷控制器，远程启用除霜功能，并提高冷藏和冷冻柜的温度。</p><p>11 月报道的<a href=\"https://www.bleepingcomputer.com/news/security/hackers-disrupt-refrigeration-systems-at-european-supermarkets/\">第二轮攻击</a>影响了欧洲六个国家的 115 家以上门店，其中一些制冷系统完全停止运行，另一些则将温度升高至高达 50°C（122°F）。</p><p>11 月 3 日，<a href=\"https://presse.efs.sante.fr/actualites/l-efs-confirme-l-incident-de-cybersecurite-impactant-un-de-ces-prestataires-d-equipement-frigorifique-2c07c-08a0a.html\">法国血液机构（EFS）确认</a>，一起影响制冷设备供应商的网络安全事件导致三处用于储存血液制品的设施的温度和除霜设置被更改。</p><p>为应对持续威胁，美国各机构敦促组织将制冷控制器从公共互联网上移除、保护必要的远程访问、更改默认密码，并安装可用的安全更新。</p><p>它们还建议将运营技术系统与业务网络隔离，并实施安全温度限制，以防控制器在可接受范围之外运行。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/0c6c2476908e136e.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体可分析电子邮件的意图、上下文和行为，发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>对 Microsoft 365 或 Google Workspace 进行为期 14 天的只读扫描，看看有哪些威胁能够穿过防线，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始免费电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","工控","IoT","https://www.bleepingcomputer.com/news/security/fbi-cisa-warn-of-cyberattacks-targeting-refrigeration-systems/","BleepingComputer",{"_93":94,"_95":-5},"changelogVersion","2026-10-01T08:00","release"]
