[{"_1":2,"_3":4},"root",{"_5":121},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794962446000,"id","rqea4z2nhncrkf2s1jvtvp067","title","Oracle Java Base64 解码器漏洞 CVE-2026-114938 存在未认证 RCE，CISA 要求立即修补","originalTitle","Critical Java Vulnerability Requires Immediate Patching","summary","Oracle Java 的 Base64 解码器存在内存损坏漏洞 CVE-2026-114938，可由特制 Base64 输入触发 JVM 崩溃，并在无需认证的条件下实现远程代码执行。","reason","原文明确利用前提、影响组件和临时缓解措施，读者可据此排查 Java 部署并确定修补优先级。","source",{"_75":120},"links",{"_111":119},"publishedAt","2026-11-17T12:00:00.000Z","discoveredAt","2026-11-17T23:27:32.332Z","timelineAt","category","policy","tags",[115,116,80,117,118,46],"score",76,"selected",true,"channel","news","story",{"_85":86,"_13":87},"x","readingMode","full","author","CISA","body",{"_61":110,"_111":-5,"_112":113,"_114":37},"outline",[88,89,90,91,92,93],"relatedStories",[84],"topics",[68,69,70,71,72],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fUP1PwxhxZCs","reportCount",1,"additionalSourceCount",0,{"_73":82,"_75":83},{"_73":81,"_75":46},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","blue-team","name","蓝队与运营","vuln","漏洞披露","vuln-mgmt","漏洞管理","cisa","oracle","Oracle / 甲骨文",{"_85":86,"_13":87},"publicId","8540cb70-bd3c-4700-8134-83f02bb49280","Java4Shell漏洞获官方补丁，利用条件受限",{"_11":108,"_95":109,"_97":98},{"_11":106,"_95":107,"_97":98},{"_11":104,"_95":105,"_97":98},{"_11":101,"_95":102,"_97":103},{"_11":99,"_95":100,"_97":98},{"_11":94,"_95":96,"_97":98},"sec-6","text","致谢&nbsp;","level",2,"sec-5","免责声明","sec-4","供应商指导",3,"sec-3","资源","sec-2","应采取的措施","sec-1","目的","<h2 id=\"sec-1\"><strong>目的</strong></h2><p>CISA 强烈敦促组织立即修补最近披露的 Oracle Java 漏洞 <a href=\"https://www.cve.org/CVERecord?id=CVE-2026-114938\">CVE-2026-114938</a>。这个严重内存破坏漏洞被称为“Java4Shell”，影响 x86-64 HotSpot Java 虚拟机 (JVM) 的 Base64 解码器，而该虚拟机是 Java 开发工具包 (JDK) 的一部分。精心构造的 Base64 输入可能导致 JVM 崩溃，并允许未经身份验证的远程代码执行。</p><h2 id=\"sec-2\"><strong>应采取的措施</strong></h2><p>CISA 敦促组织采取以下措施：</p><ul>\n<li>确定受影响的 Java 安装。检查你的软件清单，查找 JDK 和 Java 运行时，包括随第三方应用程序捆绑或包含在容器镜像和设备中的 JDK 和 Java 运行时。<strong>注意：</strong>JDK 和 Java 运行时可能不会在软件清单中显示为单独条目。</li>\n<li>Apply relevant Java and vendor patches as soon as they are available, prioritizing internet-facing systems.\n<ul>\n<li>如果无法立即修补，请实施临时补偿性控制措施，例如在应用程序边界限制并验证 Base64 输入、强制设置输入大小限制，以及限制未经身份验证的访问。</li>\n</ul>\n</li>\n<li>查看<a href=\"https://www.oracle.com/security-alerts/cspunov2026.html\">Oracle 的安全公告</a>，了解有关修补以及受影响产品和版本的指导。</li>\n<li>&nbsp;监控可疑活动的迹象，包括异常运行时、非预期的 JVM 崩溃以及可疑的 Java 进程。</li>\n</ul><h2 id=\"sec-3\"><strong>资源</strong></h2><p>CISA 敦促网络防御人员查看以下资源并应用必要的更新：</p><h3 id=\"sec-4\">供应商指导</h3><ul>\n<li>Oracle 安全公告：<a href=\"https://www.oracle.com/security-alerts/cspunov2026.html\">关键安全补丁更新 – 2026 年 11 月</a></li>\n</ul><h2 id=\"sec-5\"><strong>免责声明</strong></h2><p>本报告中的信息仅按“现状”提供，仅供 informational 用途。CISA 不认可任何商业实体、产品、公司或服务，包括本文档内链接的任何实体、产品或服务。任何对特定商业实体、产品、流程或服务的引用，无论是通过服务标志、商标、制造商还是其他方式，均不构成也不意味着 CISA 的认可、推荐或偏袒。</p><h2 id=\"sec-6\"><strong>致谢&nbsp;</strong></h2><p>加拿大网络安全中心（Cyber Centre）为本警报作出了贡献。</p>","original","zhKind","translation","complete","漏洞","补丁","加固","Oracle","https://www.cisa.gov/news-events/alerts/2026/11/17/critical-java-vulnerability-requires-immediate-patching","CISA 安全公告",{"_122":123,"_124":-5},"changelogVersion","2026-10-01T08:00","release"]
