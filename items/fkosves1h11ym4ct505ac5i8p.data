[{"_1":2,"_3":4},"root",{"_5":110},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795826439000,"id","fkosves1h11ym4ct505ac5i8p","title","Inception 仿冒品牌开展 SSO 电话钓鱼活动","originalTitle","New Inception extortion gang launches large-scale vishing campaign","summary","新组建的数据勒索组织 Inception 被认为自 10 月下旬起开展 SSO 钓鱼活动，主要通过电话社工而非电子邮件钓鱼，冒充 Dropbox、Nintendo、Starbucks 等数十家企业。","reason","材料梳理了 Inception 的 SSO 钓鱼基础设施、冒充品牌与关联线索，并给出可执行的认证和日志排查建议。","source",{"_75":109},"links",{"_100":108},"publishedAt","2026-11-24T20:21:20.000Z","discoveredAt","2026-11-24T20:21:32.532Z","timelineAt","category","activity","tags",[76,104,105,106,84,107],"score",74,"selected",true,"channel","news","story",{"_86":87,"_13":88},"x","readingMode","full","author","Bill Toulas","body",{"_61":99,"_100":-5,"_101":102,"_103":37},"outline",[89,90],"relatedStories",[85],"topics",[68,69,70,71,72],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fxJIjw9mDJEE","reportCount",1,"additionalSourceCount",0,{"_73":83,"_75":84},{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","attack","name","攻击活动","red-team","红队与渗透","ransomware","勒索软件","email","邮件与钓鱼","identity","身份与访问",{"_86":87,"_13":88},"publicId","91321571-f868-491d-b1cc-3285dc267844","Inception以语音社工实施SSO钓鱼",{"_11":96,"_92":97,"_94":98},{"_11":91,"_92":93,"_94":95},"sec-2","text","发现现有防御可能遗漏的电子邮件威胁。","level",2,"sec-1","ShinyHunters 关联及否认",3,"<p><img alt=\"New Inception extortion gang launches large-scale vishing campaign\" height=\"900\" src=\"/dailyinfo/media/87eb02727f377680.jpg\" srcset=\"/dailyinfo/media/34a68ace54ade74b.jpg 720w, /dailyinfo/media/198cb3947fdf0702.jpg 1200w, /dailyinfo/media/87eb02727f377680.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>一个名为“Inception”的新组建数据勒索团伙已被关联到一场大规模活动，该活动以多个全球品牌和企业的单点登录（SSO）凭据为目标。</p><p>该团伙于 11 月 17 日现身，在其勒索网站上声称有七家受害者，包括芯片制造商 AMD、PepsiCo、Cigna Healthcare、AutoZone 和 Lucid Motors，但目前尚无其中任何一家公开确认发生数据泄露。</p><p>然而，网络安全公司 ReversingLabs 一直在追踪 Inception 团伙的活动，并表示该团伙自 10 月下旬开始运作。</p><p><a href=\"https://www.wiz.io/lp/claude-code-security-best-practices-cheat-sheet?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q3_INB_FORM_Claude-Code-Security-Best-Practices&amp;sfcid=701Vh00000gJQZuIAO&amp;utm_term=FY27Q4-bleepingcomputer-article-970x250-Nov&amp;utm_content=Claude-Code-Best-Practices\"><img src=\"/dailyinfo/media/dfd3f12557f3697a.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>这家安全公司已确认存在&nbsp;21 个用于 SSO 钓鱼的域名、41 个据信&nbsp;用于活动基础设施的域名，以及 4 个疑似用于其他用途的域名。</p><p>研究人员发现了一个冒充数十家大型企业的广泛钓鱼基础设施，包括 Dropbox、Duolingo、Western Union、Indeed、Activision Blizzard、Riot Games、Twitch、Reddit、Nestlé、Anthropic、Nintendo、Starbucks、McDonald's、Paramount 和 NBCUniversal。</p><p>这些域名的存在并不能证明相关企业已经遭到入侵，甚至不能证明其已成为目标，而且近期均未披露网络攻击或其他相关事件。</p><figure><img alt=\"Homepage of the Inception leak site\" height=\"568\" src=\"/dailyinfo/media/5dbac137de8a11d0.jpg\" srcset=\"/dailyinfo/media/1e69b1dd7032d076.jpg 720w, /dailyinfo/media/df16de2c9769c3f9.jpg 1200w, /dailyinfo/media/5dbac137de8a11d0.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"900\">\n<figcaption><strong>Inception 泄露网站主页</strong><br>\n<em>来源：BleepingComputer</em></figcaption>\n</figure><p><a href=\"http://www.reversinglabs.com/blog/threat-researchers-notebook-sso-vishing-campaign-associated-with-emerging-inception-extortion-group\">该活动似乎依靠基于电话的社会工程</a>而非电子邮件钓鱼，与臭名昭著的 ShinyHunters 勒索团伙<a href=\"https://www.bleepingcomputer.com/news/security/mandiant-details-how-shinyhunters-abuse-sso-to-steal-cloud-data/\">所使用的战术</a>&nbsp;极为相似。</p><p>Inception 正在使用模仿企业身份验证服务、以法律为主题的网站，主要冒充 Okta，但也包括 NetIQ/OpenText Access Manager。</p><h3 id=\"sec-1\">ShinyHunters 关联及否认</h3><p>其中一家身份验证提供商 Okta 昨天发布了一份报告，将 Inception 与 O-UNC-053 联系起来；Okta 此前曾将 O-UNC-053 与 ShinyHunters 关联，而后者自 3 月以来一直活跃。</p><p>据 Okta 称，在执法部门于涉嫌成员被捕后捣毁 ShinyHunters 勒索团伙并关闭其泄露网站后（[<a href=\"https://www.bleepingcomputer.com/news/security/dutch-police-confirm-arrest-in-shinyhunters-hacking-investigation/\">1</a>、<a href=\"https://www.bleepingcomputer.com/news/security/shinyhunters-hacker-reportedly-detained-in-jordan-aiding-fbi/\">2</a>]），O-UNC-053 继续注册新的钓鱼域名。</p><p>10 月下旬，该活动集群启动了其法律主题活动；11 月中旬，Inception 泄露网站上线，公布的受害者与此前锁定的目标相吻合。</p><p>“在任何泄露网站上停止发布，随后在一个使用新品牌的新数据泄露网站上发布，这种模式与此前 Com 关联行为者的转变一致。”<a href=\"https://www.okta.com/en-se/blog/threat-intelligence/former_shinyhunters_cluster_moves_to_new_inception_site/\">Okta 描述道</a>。</p><p>“在 DLS 发布主体变更前后，O-UNC-053 都保持了基础设施和战术、技术与流程（TTP）的一致性，因此我们评估该集群极有可能改变了其品牌关联。”</p><p>Inception 迅速回应，并在其勒索页面发布公告，否认与其他威胁行为者存在所谓关联。</p><p>这些威胁行为者声称独立运作，与任何此前的团伙均无关联；他们认为，目标群体重合以及使用相同的域名注册和 CDN 服务并不能证明存在行动关联。</p><p>他们还承认，私人工具正在独立威胁行为者之间流通，使用这些工具并不能证明存在关联。</p><figure><img src=\"/dailyinfo/media/04329a33a53fe3dd.jpg\" srcset=\"/dailyinfo/media/389c679651590a16.jpg 720w, /dailyinfo/media/20ad8a7615b40f1a.jpg 1200w, /dailyinfo/media/04329a33a53fe3dd.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Threat actors' statement\" height=\"488\" width=\"800\">\n<figcaption><strong>威胁行为者声明</strong><br>\n<em>来源：BleepingComputer</em></figcaption>\n</figure><p>为抵御最新的 Inception 活动，ReversingLabs 建议强制实施抗钓鱼身份验证，包括 FIDO2 安全密钥和通行密钥，并强化帮助台的身份验证程序。</p><p>应仔细审查可追溯至 2026 年 10 月 21 日的 DNS、代理和身份提供商日志，以寻找可疑活动的迹象。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/a3aef6170ea13c62.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-2\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体会分析电子邮件意图、上下文和行为，以发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>通过 14 天只读扫描查看 Microsoft 365 或 Google Workspace 中有哪些内容被成功传递，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始您的免费电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","钓鱼","勒索","数据泄露","红队","https://www.bleepingcomputer.com/news/security/new-inception-extortion-gang-launches-large-scale-vishing-campaign/","BleepingComputer",{"_111":112,"_113":-5},"changelogVersion","2026-10-01T08:00","release"]
