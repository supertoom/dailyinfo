[{"_1":2,"_3":4},"root",{"_5":118},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795567293000,"id","xkbdr9ainyr5uag1wj0wn4yk8","title","Danfoss AK-SM8xxA Series 栈缓冲区溢出漏洞 CVE-2026-129713 影响 <=5.4.0","originalTitle","Danfoss AK-SM 8xxA Series","summary","Danfoss AK-SM8xxA Series 控制器存在未认证 CGI 处理器的栈缓冲区溢出漏洞 CVE-2026-129713，AK-SM8xxA <=5.4.0 受影响，攻击者发送特制 HTTP/S POST 请求可导致内存损坏、webserver 重启，并可能以 webserver 权限执行任意代码。","reason","source",{"_72":117},"links",{"_61":116},"publishedAt","2026-11-24T12:00:00.000Z","discoveredAt","2026-11-24T16:00:35.248Z","timelineAt","category","vuln","tags",[114,115,45],"score",50,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","CISA","body",{"_110":-5,"_61":111,"_112":-5,"_113":36},"outline",[81,82,83,84,85,86,87,88],"relatedStories",[77],"topics",[68,69,70],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fmSBzjgRjlAo","reportCount",1,"additionalSourceCount",0,{"_71":76,"_72":45},{"_71":74,"_72":75},{"_71":30,"_72":73},"slug","name","漏洞披露","industrial","工业控制","cisa",{"_78":79,"_13":80},"publicId","e9d2b9b1-3660-48c0-ae0b-a61e69639fbf","Danfoss控制器栈溢出漏洞待修复",{"_11":108,"_90":109,"_92":93},{"_11":105,"_90":106,"_92":107},{"_11":103,"_90":104,"_92":93},{"_11":100,"_90":101,"_92":102},{"_11":98,"_90":99,"_92":93},{"_11":96,"_90":97,"_92":93},{"_11":94,"_90":95,"_92":93},{"_11":89,"_90":91,"_92":93},"sec-8","text","Legal Notice and Terms of Use","level",2,"sec-7","Revision History","sec-6","Recommended Practices","sec-5","Acknowledgments","sec-4","1 Affected Product",4,"sec-3","Vulnerabilities","sec-2","Background",3,"sec-1","Summary","zh","<p><a href=\"https://github.com/cisagov/CSAF/blob/develop/csaf_files/OT/white/2026/icsa-26-328-03.json\"><strong>View CSAF</strong></a></p><h2 id=\"sec-1\">Summary</h2><p><strong>Successful exploitation of this vulnerability could allow an attacker to execute arbitrary code with webserver privileges.</strong></p><p>The following versions of Danfoss AK-SM 8xxA Series are affected:</p><ul>\n<li>AK-SM8xxA &lt;=5.4.0 (CVE-2026-129713)</li>\n</ul><table>\n<thead>\n<tr>\n<th>CVSS</th>\n<th>Vendor</th>\n<th>Equipment</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>v3 9.8</td>\n<td>Danfoss</td>\n<td>AK-SM8xxA</td>\n</tr>\n</tbody>\n</table><table>\n<thead>\n<tr>\n<th>1 Vulnerability</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Stack-based Buffer Overflow</td>\n</tr>\n</tbody>\n</table><h3 id=\"sec-2\">Background</h3><ul>\n<li><strong>Critical Infrastructure Sectors: </strong>Commercial Facilities</li>\n<li><strong>Countries/Areas Deployed: </strong>Worldwide</li>\n<li><strong>Company Headquarters Location: </strong>Denmark</li>\n</ul><hr><h2 id=\"sec-3\">Vulnerabilities</h2><p>CVE-2026-129713</p><p>A stack-based buffer overflow in an unauthenticated CGI handler of the Danfoss AK-SM 8xxA Series controller allows remote attackers to send specially crafted HTTP/S POST requests, leading to memory corruption, webserver restart and hypothetically potential arbitrary code execution with webserver privileges. Authentication is not required to exploit this vulnerability.</p><h4 id=\"sec-4\">1 Affected Product</h4><hr><h5>Danfoss AK-SM8xxA &lt;=5.4.0</h5><p>Product Status: known_affected</p><h5>Remediations</h5><p><strong>Mitigation</strong><br>This vulnerability will be addressed in an upcoming Danfoss AK-SM 800A Series software release (version 5.5.x).</p><p><strong>Mitigation</strong><br>In addition, Danfoss will remove the ability for users to disable Strict Mode in future software releases.</p><hr><h5>Additional Metrics</h5><p><strong>Relevant CWE:</strong> <a href=\"https://cwe.mitre.org/data/definitions/121.html\">CWE-121 Stack-based Buffer Overflow</a></p><table>\n<thead>\n<tr>\n<th>CVSS Version</th>\n<th>Base Score</th>\n<th>Base Severity</th>\n<th>Vector String</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>3.1</td>\n<td>9.8</td>\n<td>CRITICAL</td>\n<td><a href=\"https://www.first.org/cvss/calculator/3.1#CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H\">CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H</a></td>\n</tr>\n<tr>\n<td>4.0</td>\n<td>9.3</td>\n<td>CRITICAL</td>\n<td><a href=\"https://www.first.org/cvss/calculator/4.0#CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N\">CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N</a></td>\n</tr>\n</tbody>\n</table><hr><p><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-129713\">View CVE Details</a></p><hr><h2 id=\"sec-5\">Acknowledgments</h2><ul>\n<li>Carlo Meijer of Midnight Blue reported CVE-2026-129713 to CISA.</li>\n</ul><hr><h2 id=\"sec-6\">Recommended Practices</h2><p>CISA recommends users take defensive measures to minimize the risk of exploitation of these vulnerabilities.</p><ul>\n<li>Minimize network exposure for all control system devices and/or systems, ensuring they are <a href=\"https://www.cisa.gov/uscert/ics/alerts/ICS-ALERT-10-301-01\">not accessible from the internet</a>.</li>\n<li>Locate control system networks and remote devices behind firewalls and isolating them from business networks.</li>\n<li>When remote access is required, use more secure methods, such as Virtual Private Networks (VPNs), recognizing VPNs may have vulnerabilities and should be updated to the most current version available. Also recognize VPN is only as secure as the connected devices.</li>\n</ul><p>CISA reminds organizations to perform proper impact analysis and risk assessment prior to deploying defensive measures.</p><p>CISA also provides a section for <a href=\"https://www.cisa.gov/resources-tools/resources/ics-recommended-practices\">control systems security recommended practices</a> on the ICS webpage on <a href=\"https://www.cisa.gov/topics/industrial-control-systems\">cisa.gov/ics</a>. Several CISA products detailing cyber defense best practices are available for reading and download, including <a href=\"https://www.cisa.gov/sites/default/files/recommended_practices/NCCIC_ICS-CERT_Defense_in_Depth_2016_S508C.pdf\">Improving Industrial Control Systems Cybersecurity with Defense-in-Depth Strategies</a>.</p><p>CISA encourages organizations to implement recommended cybersecurity strategies for <a href=\"https://www.cisa.gov/sites/default/files/publications/Cybersecurity_Best_Practices_for_Industrial_Control_Systems.pdf\">proactive defense of ICS assets</a>.</p><p>Additional mitigation guidance and recommended practices are publicly available on the ICS webpage at <a href=\"https://www.cisa.gov/topics/industrial-control-systems\">cisa.gov/ics</a> in the technical information paper, <a href=\"https://www.cisa.gov/news-events/news/targeted-cyber-intrusion-detection-and-mitigation-strategies-update-b\">ICS-TIP-12-146-01B--Targeted Cyber Intrusion Detection and Mitigation Strategies</a>.</p><p>Organizations observing suspected malicious activity should follow established internal procedures and report findings to CISA for tracking and correlation against other incidents.</p><p>CISA also recommends users take the following measures to protect themselves from social engineering attacks:</p><ul>\n<li>Do not click web links or open attachments in unsolicited email messages.</li>\n<li>Refer to <a href=\"https://www.cisa.gov/secure-our-world/teach-employees-avoid-phishing\">Recognizing and Avoiding Email Scams</a> for more information on avoiding email scams.</li>\n<li>Refer to <a href=\"https://www.cisa.gov/news-events/news/avoiding-social-engineering-and-phishing-attacks\">Avoiding Social Engineering and Phishing Attacks</a> for more information on social engineering attacks.</li>\n</ul><p>No known public exploitation specifically targeting these vulnerabilities has been reported to CISA at this time.</p><hr><h2 id=\"sec-7\">Revision History</h2><ul>\n<li><strong>Initial Release Date: </strong>2026-11-24</li>\n</ul><table>\n<thead>\n<tr>\n<th>Date</th>\n<th>Revision</th>\n<th>Summary</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>2026-11-24</td>\n<td>1</td>\n<td>Initial Publication</td>\n</tr>\n</tbody>\n</table><hr><h2 id=\"sec-8\">Legal Notice and Terms of Use</h2>","zhKind","complete","漏洞","工控","https://www.cisa.gov/news-events/ics-advisories/icsa-26-328-03","CISA 安全公告",{"_119":120,"_121":-5},"changelogVersion","2026-10-01T08:00","release"]
