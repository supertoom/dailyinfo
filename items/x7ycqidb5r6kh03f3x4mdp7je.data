[{"_1":2,"_3":4},"root",{"_5":155},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795480847000,"id","x7ycqidb5r6kh03f3x4mdp7je","title","Chrome 157.0.8103.38 修复 CVE-2026-121104 目录授权漏洞","originalTitle","cve-2026-121104 chrome路径拦截调用链分析","summary","CVE-2026-121104 影响 Chrome 的 File System API 敏感路径拦截机制，旧版规则未覆盖多个平台上的 ~/.cache，恶意页面诱导用户通过 showDirectoryPicker() 授权目录后即可读写该路径并执行代码。","reason","文章沿目录选择调用链定位了 Chrome 路径拦截缺口，并对比修复前后的命中逻辑与拦截结果。","source",{"_73":154},"links",{"_147":153},"publishedAt","2026-11-18T18:36:05.000Z","discoveredAt","2026-11-20T04:17:32.181Z","timelineAt","category","disclosure","tags",[150,151,76,152],"score",76,"selected",true,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","body",{"_61":146,"_147":-5,"_148":147,"_149":37},"outline",[83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fOE0aORCpK1c","reportCount",1,"additionalSourceCount",0,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","research","name","技术研究","browser","浏览器","google","Google / 谷歌",{"_80":81,"_13":82},"publicId","ec142061-7258-4e3c-b68c-5c159db28515","Chrome修复缓存目录授权漏洞",{"_11":144,"_104":145,"_106":107},{"_11":142,"_104":143,"_106":107},{"_11":140,"_104":141,"_106":107},{"_11":138,"_104":139,"_106":107},{"_11":136,"_104":137,"_106":107},{"_11":134,"_104":135,"_106":107},{"_11":132,"_104":133,"_106":107},{"_11":130,"_104":131,"_106":107},{"_11":128,"_104":129,"_106":107},{"_11":126,"_104":127,"_106":107},{"_11":124,"_104":125,"_106":107},{"_11":122,"_104":123,"_106":107},{"_11":120,"_104":121,"_106":107},{"_11":118,"_104":119,"_106":107},{"_11":116,"_104":117,"_106":107},{"_11":114,"_104":115,"_106":107},{"_11":112,"_104":113,"_106":107},{"_11":110,"_104":111,"_106":107},{"_11":108,"_104":109,"_106":107},{"_11":103,"_104":105,"_106":107},"sec-20","text","参考","level",2,"sec-19","7、后缀规则（跨仓库，任意层级匹配）","sec-18","6、Chrome 目录","sec-17","5、临时文件","sec-16","4、系统目录类","sec-15","3、公共数据类","sec-14","2、用户目录下的具体条目","sec-13","1、用户目录类","sec-12","04 完整的 Windows 黑名单","sec-11","03 场景：用户选中&nbsp;~/.cache","sec-10","02 修复的位置","sec-9","ShouldBlockAccessToPath()","sec-8","CheckShouldBlockAccessToPathAndReply()","sec-7","CheckPathAgainstBlocklist()","sec-6","ConfirmSensitiveEntryAccess()","sec-5","ShowFilePickerImpl、FileSystemAccessManager::ChooseEntries","sec-4","GlobalFileSystemAccess::showDirectoryPicker","sec-3","window.showDirectoryPicker()","sec-2","01 敏感路径拦截调用链","sec-1","cve-2026-121104","<h2 id=\"sec-1\">cve-2026-121104</h2><p>简单描述：chrome 拦截规则里，<code>~/.cache</code>&nbsp;在多个平台上完全不在拦截范围内。攻击者诱导用户把目录授权给 &nbsp;<code>showDirectoryPicker()</code>，就能往&nbsp;<code>~/.cache</code>&nbsp;里读写文件，导致执行代码<br></p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F19%2F0142%2Fae8e3bb7-234.png&amp;mode=full&amp;exp=1795737600&amp;sig=6967fdafe65964a0\" loading=\"lazy\" decoding=\"async\"></p><p>漏洞提及到的关键点，后文以 <a href=\"https://source.chromium.org/chromium/chromium/src\">Chrome 157.0.8103.38</a> 对这些关键点展开研究。<br>1、目录拦截列表由 <code>GenerateBlockPaths()</code> 生成、主目录规则为 <code>kDontBlockChildren</code><br>2、<code>base::DIR_CACHE</code> 实际解析.<br>3、在 $XDG_CACHE_HOME 指向其他位置时同样无法命中 ~/.cache<br>4、攻击者通过恶意页面诱导用户将主目录（或包含 .cache 的目录）授权给 <code>showDirectoryPicker</code></p><h2 id=\"sec-2\">01 敏感路径拦截调用链</h2><p>当用户选择目录，或网站调用 <code>showDirectoryPicker()</code> 访问时，Chrome 会在返回句柄之前，将所选路径与黑名单进行比对。调用链如下：</p><pre><code>JS 调用 showDirectoryPicker(options)\n  &gt; GlobalFileSystemAccess::showDirectoryPicker\n  &gt; ShowFilePickerImpl(type=kDirectory)\n  &gt; FileSystemAccessManager::ChooseEntries\n  &gt; FileSystemAccessManagerImpl::ChooseEntries\n  &gt; ConfirmSensitiveEntryAccess()\n  &gt; CheckPathAgainstBlocklist()\n  &gt; CheckShouldBlockAccessToPathAndReply()\n  &gt; ShouldBlockAccessToPath()   //实际的匹配逻辑\n</code></pre><h2 id=\"sec-3\">window.showDirectoryPicker()</h2><p>1、<code>window.showDirectoryPicker()</code> 属于 <a href=\"https://developer.mozilla.org/en-US/docs/Web/API/File_System_API#specifications\">File System API</a> 的一个控件，可使用 js 来调用。</p><blockquote><p>File System API: 通过文件系统访问 API 提供的扩展功能，可以实现对设备文件系统的文件读取、写入和管理操作。该 API 的核心功能包括读取文件、写入或保存文件，以及访问目录结构。</p></blockquote><pre><code>&lt;button onclick=\"showDirectoryPicker({mode:'readwrite'}).then(h=&gt;o.textContent='OK '+h.name,e=&gt;o.textContent=e.name)\"&gt;click&lt;/button&gt;&lt;pre id=o&gt;&lt;/pre&gt;\n</code></pre><p>2、用户通过&nbsp;<code>showDirectoryPicker()</code>&nbsp;选择常规目录，弹出 <code>写权限授予框</code> （由&nbsp;<code>FileSystemAccessPermissionGrant</code>&nbsp;弹出）</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F19%2F0143%2Fafc34fc5-eb3.png&amp;mode=full&amp;exp=1795737600&amp;sig=96883a2bbfe2872f\" loading=\"lazy\" decoding=\"async\"></p><p>3、选敏感目录，如果命中拦截规则，弹出的是 <code>黑名单拦截判定弹窗</code> （由 <code>ConfirmSensitiveEntryAccess()</code> 触发），直接拦不让你 allow，让你另选目录<br></p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F19%2F0143%2Fc4c41fd3-045.png&amp;mode=full&amp;exp=1795737600&amp;sig=eaa36a371eb89c2b\" loading=\"lazy\" decoding=\"async\"></p><h2 id=\"sec-4\">GlobalFileSystemAccess::showDirectoryPicker</h2><p>把网页调用的&nbsp;<code>showDirectoryPicker()</code> 转成 浏览器能选目录的请求</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F19%2F0143%2Feccc85a7-6df.png&amp;mode=full&amp;exp=1795737600&amp;sig=7d45e6b298384dbd\" loading=\"lazy\" decoding=\"async\"></p><h2 id=\"sec-5\">ShowFilePickerImpl、FileSystemAccessManager::ChooseEntries</h2><p>把刚拼好的请求送到浏览器进程，由浏览器做后续操作</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F19%2F0143%2Fbf7f040a-195.png&amp;mode=full&amp;exp=1795737600&amp;sig=134e4dff6eb83497\" loading=\"lazy\" decoding=\"async\"></p><h2 id=\"sec-6\">ConfirmSensitiveEntryAccess()</h2><p><code>ConfirmSensitiveEntryAccess()</code> 是所有黑名单策略入口。判断路径是否敏感目录，命中则弹出受限目录确认框，把(拦 / 重选 / 放弃)的结果回给调用方。<br>接收 <code>url::Origin</code>、<code>content::PathInfo</code>、<code>HandleType</code>、<code>AccessTrigger</code>、<code>GlobalRenderFrameHostId</code>，以及一个回调。但真正进入黑名单匹配的只有路径、<code>handle_type</code>&nbsp;和&nbsp;<code>access_trigger</code>&nbsp;三项。得到回调回一个三态&nbsp;<code>SensitiveEntryResult</code></p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F19%2F0143%2Fc588de03-88a.png&amp;mode=full&amp;exp=1795737600&amp;sig=47bd0a8befe4e026\" loading=\"lazy\" decoding=\"async\"></p><blockquote><p><code>url::Origin</code>&nbsp; 发起请求的站点<br><code>content::PathInfo</code>&nbsp; 路径 + 显示名 + 路径类型（本机 / 外部卷）<br><code>HandleType</code>&nbsp;,&nbsp;文件或目录 (<code>kFile</code>&nbsp;/&nbsp;<code>kDirectory</code>)<br><code>AccessTrigger</code>&nbsp;,选择器、拖放、保存或程序化写入 (<code>kOpen</code>&nbsp;/&nbsp;<code>kSave</code>&nbsp;/&nbsp;<code>kLoadFromStorage</code>&nbsp;/&nbsp;<code>kDragAndDrop</code>&nbsp;/&nbsp;<code>kProgrammaticRead</code>&nbsp;/&nbsp;<code>kProgrammaticWrite</code>)<br><code>GlobalRenderFrameHostId</code>&nbsp; 发起请求的 frame<br><code>SensitiveEntryResult</code> 拦 / 重选 / 放弃,（<code>kAllowed</code>/<code>kTryAgain</code>/<code>kAbort</code>）</p></blockquote><h2 id=\"sec-7\">CheckPathAgainstBlocklist()</h2><p><code>CheckPathAgainstBlocklist()</code> 是查询层。把路径连同访问性质交给黑名单比对，返回命中与否。不弹框、不记录用户选择、不关心站点与 frame。相比上一层，无 <code>origin</code>&nbsp;和&nbsp;<code>frame_id</code>&nbsp;<br>接收一个&nbsp;<code>content::PathInfo</code>、&nbsp;<code>HandleType</code>、&nbsp;<code>AccessTrigger</code>，得到&nbsp;<code>bool</code>&nbsp;的回调。&nbsp;</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F19%2F0143%2Fed2eaf89-7df.png&amp;mode=full&amp;exp=1795737600&amp;sig=fa464ad3b943d532\" loading=\"lazy\" decoding=\"async\"></p><h2 id=\"sec-8\">CheckShouldBlockAccessToPathAndReply()</h2><p><code>CheckShouldBlockAccessToPathAndReply()</code> 是汇总层。把常规规则表与额外规则交给&nbsp;<code>ShouldBlockAccessToPath()</code>&nbsp;逐条比对，取回最终结论后统一回复。规则表在此层只被消费，不再构造。<br>接收一个 <code>base::FilePath</code>、&nbsp;<code>HandleType</code>、&nbsp;<code>AccessTrigger</code>、<code>std::vector&lt;BlockPathRule&gt; extra_rules</code>、<code>BlockPathRules block_path_rules</code> ，得到&nbsp;<code>bool</code>&nbsp;的回调</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F19%2F0143%2F485f907f-d36.png&amp;mode=full&amp;exp=1795737600&amp;sig=f2fa9420411f61d4\" loading=\"lazy\" decoding=\"async\"></p><blockquote><p><code>base::FilePath</code>&nbsp; 裸路径，<code>PathInfo</code>&nbsp;已在此前被降级<br><code>std::vector&lt;BlockPathRule&gt; extra_rules</code>&nbsp;—— 本次运行时临时追加的规则<br><code>BlockPathRules block_path_rules</code>&nbsp;—— 已构造好的规则集，按值移入</p></blockquote><h2 id=\"sec-9\">ShouldBlockAccessToPath()</h2><p>整条调用链上只有 <code>ShouldBlockAccessToPath()</code> 真正做判定拦不拦，前面都在准备参数。<br>1、路径规范化</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F19%2F0143%2F485f907f-d36.png&amp;mode=full&amp;exp=1795737600&amp;sig=f2fa9420411f61d4\" loading=\"lazy\" decoding=\"async\"></p><p><br>2、Windows 上的 UNC 做特判<br>3、单条规则的判定（lambda)</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F19%2F0144%2Fd2d1969d-df1.png&amp;mode=full&amp;exp=1795737600&amp;sig=857b212b07180266\" loading=\"lazy\" decoding=\"async\"></p><p><br>情况 A：待检查路径就是被拦路径，或者它是被拦路径的父目录。后者是反向拦截——授权&nbsp;<code>~</code>&nbsp;会因为&nbsp;<code>~/.ssh</code>&nbsp;在名单里而直接被拦，防止授权父目录变相授权被拦子目录。<br>情况 B：被拦路径是当前路径的祖先。此时不立刻下结论，只记下最深的那个祖先和它的&nbsp;<code>BlockType</code>，留到最后统一裁决。</p><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p>所选路径</p></th><th colspan=\"1\" rowspan=\"1\"><p>命中的规则</p></th><th colspan=\"1\" rowspan=\"1\"><p>结果</p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>C:\\Users\\alice</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>path == DIR_HOME</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>阻止（精确匹配）</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>C:\\Users\\alice\\Desktop</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>path == DIR_USER_DESKTOP</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>阻止（精确匹配）</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>C:\\Users\\alice\\Desktop\\Projects</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>最近祖先：<code>DIR_USER_DESKTOP</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>允许（kDontBlockChildren）</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>C:\\Users\\alice\\.vscode</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>最近祖先：<code>DIR_HOME</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>允许（kDontBlockChildren）</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>C:\\Users\\alice\\AppData\\Roaming\\Discord</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>最近祖先：<code>DIR_ROAMING_APP_DATA</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>阻止（kBlockAllChildren）</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>C:\\Users\\alice\\.ssh</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>path == DIR_HOME + .ssh</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>阻止（精确匹配）</p></td></tr></tbody></table><p>4、三轮遍历<br>顺序是：<code>extra_rules</code>&nbsp;，&nbsp;<code>block_path_rules_</code>&nbsp;，&nbsp;<code>profile_based_block_path_rules_</code>（ChromeOS），&nbsp;<code>suffix_block_path_rules_</code>。前两轮走同一个 lambda；后缀规则先用&nbsp;<code>GetComponents()</code>&nbsp;拆段、<code>std::search</code>&nbsp;做大小写不敏感匹配，命中后构造到匹配末尾的&nbsp;<code>current_path</code>，再交回同一个 lambda。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F19%2F0144%2F5fbf8627-6b8.png&amp;mode=full&amp;exp=1795737600&amp;sig=c3ca94912576f42e\" loading=\"lazy\" decoding=\"async\"></p><p>5、最终做判决<br>研判是否命中黑名单定义的四种阻止策略：<code>kBlockAllChildren</code>、<code>kBlockNestedDirectories</code>、<code>kDontBlockChildren</code>、<code>kBlockWrite</code></p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F19%2F0145%2Fdc193036-699.png&amp;mode=full&amp;exp=1795737600&amp;sig=aac1a91bef89add7\" loading=\"lazy\" decoding=\"async\"></p><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p>类型</p></th><th colspan=\"1\" rowspan=\"1\"><p>目录本身</p></th><th colspan=\"1\" rowspan=\"1\"><p>子目录</p></th><th colspan=\"1\" rowspan=\"1\"><p>子文件</p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>kDontBlockChildren</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>拦</p></td><td colspan=\"1\" rowspan=\"1\"><p>放行</p></td><td colspan=\"1\" rowspan=\"1\"><p>放行</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>kBlockAllChildren</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>拦</p></td><td colspan=\"1\" rowspan=\"1\"><p>拦</p></td><td colspan=\"1\" rowspan=\"1\"><p>拦</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>kBlockNestedDirectories</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>拦</p></td><td colspan=\"1\" rowspan=\"1\"><p>拦</p></td><td colspan=\"1\" rowspan=\"1\"><p>放行</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>kBlockWrite</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>拦（仅 <code>kSave</code> / <code>kProgrammaticWrite</code>）</p></td><td colspan=\"1\" rowspan=\"1\"><p>同左</p></td><td colspan=\"1\" rowspan=\"1\"><p>同左</p></td></tr></tbody></table><h2 id=\"sec-10\">02 修复的位置</h2><p>从 <a href=\"https://chromium-review.googlesource.com/c/chromium/src/+/8668442\">chrome_file_system_access_permission_context.cc#470</a> 看157.0.8103.38 版本的更新点<br>文件 <code>chrome_file_system_access_permission_context.cc</code> 中 BlockType 的 <code>kBlockAllChildren</code> 类型新增了 <code>.cache</code></p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F19%2F0145%2Fc8494b5e-079.png&amp;mode=full&amp;exp=1795737600&amp;sig=18559044da46efba\" loading=\"lazy\" decoding=\"async\"></p><h2 id=\"sec-11\">03 场景：用户选中&nbsp;<code>~/.cache</code></h2><p>旧版：<code>readwrite</code>&nbsp;模式下写权限要单独授予一次，弹出 <code>写权限授予框</code> ，点允许后句柄可写，攻击成立。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F19%2F0145%2Fcf8eef97-533.png&amp;mode=full&amp;exp=1795737600&amp;sig=441d881bf1076f7a\" loading=\"lazy\" decoding=\"async\"></p><p><br>新版：在到达这一步之前就 reject 了，弹出的是 <code>黑名单拦截判定弹窗</code>，写权限框不会出现。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F19%2F0145%2F2cd713f2-293.png&amp;mode=full&amp;exp=1795737600&amp;sig=b89cacc53865c57a\" loading=\"lazy\" decoding=\"async\"></p><p>1、链路会在返回句柄之前终止，终止点是第 6 跳。<br>第一跳：<code>window.showDirectoryPicker()</code>，收到 {mode:'readwrite'}，结果为 Promise 挂起<br>第二跳：<code>GlobalFileSystemAccess::showDirectoryPicker</code>，收到 window、options，结果校验 user activation 通过，转成 mojom 选项<br>第三跳：<code>ShowFilePickerImpl</code>，收到 options、<code>type=kDirectory</code> ，结果发 IPC，绑定回调<br>第四跳：<code>FileSystemAccessManager::ChooseEntries </code>收到 options、callback，结果 仅 Mojo 桩，序列化后送出<br>第五跳：<code>FileSystemAccessManagerImpl::ChooseEntries</code> 收到 options、frame 上下文，道检查通过，弹出原生框；用户选中后，<code>PathInfo{C:\\...\\.cache, \".cache\", kLocal}</code>&nbsp;<br>第六跳：<code>ConfirmSensitiveEntryAccess</code>，收到 origin、PathInfo、<code>kDirectory</code>、<code>kOpen</code>、frame_id，拦截发生。<br>第七跳：<code>CheckPathAgainstBlocklist</code>，收到 PathInfo、handle、trigger，结果 true<br>第八跳：<code>CheckShouldBlockAccessToPathAndReply</code>，收到 裸路径、<code>extra_rules=[]</code>、规则集，结果 true<br>第九跳：<code>ShouldBlockAccessToPath</code> ，收到 path、handle、trigger、规则表，结果 <code>true</code>&nbsp;，&nbsp;<code>path == block_path</code>&nbsp;命中黑名单</p><p>2、停在第 9 跳的哪一行<br>新增规则让&nbsp;<code>~/.cache</code>&nbsp;进入了规则表。因此第 9 跳没有走到“记录最近祖先”那一步，而是在第一个判断处就立即返回：</p><pre><code>if (path == block_path || path.IsParent(block_path)) { return true; }\n</code></pre><p><code>path</code>&nbsp;是&nbsp;<code>~/.cache</code>，规则也是&nbsp;<code>~/.cache</code>，两者相等，因此直接返回&nbsp;<code>true</code>。</p><p>3、之后<br>返回的&nbsp;<code>true</code>&nbsp;沿回调链向上传递，<code>CheckShouldBlockAccessToPathAndReply</code>&nbsp;和&nbsp;<code>CheckPathAgainstBlocklist</code>&nbsp;都原样传递。<br>到第 6 跳时，<code>ConfirmSensitiveEntryAccess</code>&nbsp;拿到&nbsp;<code>true</code>，弹出受限目录确认框，只有两个按钮：Choose a different folder（<code>kTryAgain</code>）和&nbsp;Cancel（<code>kAbort</code>）。没有 allow 的选项。<br>到第 5 跳时，函数收到 error，回执&nbsp;<code>(error, entries=[])</code>；<br>到第 3 跳时，回调 reject；<br>到第 1 跳时，Promise reject。</p><p>4、新版的整条链在构造&nbsp;<code>FileSystemAccessEntry</code>&nbsp;之前就结束了，所以请求&nbsp;<code>readwrite</code>&nbsp;权限时<code>写权限授予框</code> 没有出现。</p><p>5、与旧版的差异：差别只在第 9 跳。<br>旧版没有&nbsp;<code>.cache</code>&nbsp;规则，落到&nbsp;<code>~</code>&nbsp;的&nbsp;<code>kDontBlockChildren</code>，返回&nbsp;<code>false</code>，<code>kAllowed</code>，静默放行。<br>新版精确命中，返回&nbsp;<code>true</code>，<code>kAbort</code></p><h2 id=\"sec-12\">04 完整的 Windows 黑名单</h2><p>从 Chrome 157.0.8103.38 的 <code>GenerateBlockPaths()</code> 和 <code>kBlockPaths[]</code> 中提取的 Windows 黑名单做的整理如下表（截至 2026 年 11 月，列表并非穷尽性做列举）</p><h2 id=\"sec-13\">1、用户目录类</h2><p>拦截把整个目录授权出去，但目录内的子项放行，由下面各项单独兜底。</p><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p>路径</p></th><th colspan=\"1\" rowspan=\"1\"><p>解析为</p></th><th colspan=\"1\" rowspan=\"1\"><p>BlockType</p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>base::DIR_HOME</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>C:\\Users\\&lt;user&gt;</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>kDontBlockChildren</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>base::DIR_USER_DESKTOP</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>C:\\Users\\&lt;user&gt;\\Desktop</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>kDontBlockChildren</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>chrome::DIR_USER_DOCUMENTS</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>C:\\Users\\&lt;user&gt;\\Documents</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>kDontBlockChildren</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>chrome::DIR_DEFAULT_DOWNLOADS</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>C:\\Users\\&lt;user&gt;\\Downloads</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>kDontBlockChildren</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>chrome::DIR_DEFAULT_DOWNLOADS_SAFE</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>C:\\Users\\&lt;user&gt;\\Documents\\Downloads</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>kDontBlockChildren</code></p></td></tr></tbody></table><h2 id=\"sec-14\">2、用户目录下的具体条目</h2><p>读写都拦。</p><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p>路径</p></th><th colspan=\"1\" rowspan=\"1\"><p>解析为</p></th><th colspan=\"1\" rowspan=\"1\"><p>BlockType</p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>DIR_HOME + .ssh</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>C:\\Users\\&lt;user&gt;\\.ssh</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>kBlockAllChildren</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>DIR_HOME + .gnupg</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>C:\\Users\\&lt;user&gt;\\.gnupg</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>kBlockAllChildren</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>DIR_HOME + .config</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>C:\\Users\\&lt;user&gt;\\.config</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>kBlockAllChildren</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>DIR_HOME + .cache</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>C:\\Users\\&lt;user&gt;\\.cache</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>kBlockAllChildren</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>DIR_HOME + .bash_profile</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>C:\\Users\\&lt;user&gt;\\.bash_profile</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>kBlockAllChildren</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>DIR_HOME + .bash_login</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>C:\\Users\\&lt;user&gt;\\.bash_login</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>kBlockAllChildren</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>DIR_HOME + .bashrc</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>C:\\Users\\&lt;user&gt;\\.bashrc</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>kBlockAllChildren</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>DIR_HOME + .profile</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>C:\\Users\\&lt;user&gt;\\.profile</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>kBlockAllChildren</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>DIR_HOME + .zshenv</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>C:\\Users\\&lt;user&gt;\\.zshenv</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>kBlockAllChildren</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>DIR_HOME + .zprofile</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>C:\\Users\\&lt;user&gt;\\.zprofile</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>kBlockAllChildren</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>DIR_HOME + .zshrc</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>C:\\Users\\&lt;user&gt;\\.zshrc</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>kBlockAllChildren</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>DIR_HOME + .zlogin</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>C:\\Users\\&lt;user&gt;\\.zlogin</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>kBlockAllChildren</code></p></td></tr></tbody></table><h2 id=\"sec-15\">3、公共数据类</h2><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p>路径</p></th><th colspan=\"1\" rowspan=\"1\"><p>解析为</p></th><th colspan=\"1\" rowspan=\"1\"><p>BlockType</p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>base::DIR_ROAMING_APP_DATA</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>C:\\Users\\&lt;user&gt;\\AppData\\Roaming</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>kBlockAllChildren</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>base::DIR_LOCAL_APP_DATA</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>C:\\Users\\&lt;user&gt;\\AppData\\Local</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>kBlockAllChildren</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>base::DIR_COMMON_APP_DATA</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>C:\\ProgramData</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>kBlockAllChildren</code></p></td></tr></tbody></table><h2 id=\"sec-16\">4、系统目录类</h2><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p>路径</p></th><th colspan=\"1\" rowspan=\"1\"><p>解析为</p></th><th colspan=\"1\" rowspan=\"1\"><p>BlockType</p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>base::DIR_PROGRAM_FILES</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>C:\\Program Files</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>kBlockAllChildren</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>base::DIR_PROGRAM_FILESX86</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>C:\\Program Files (x86)</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>kBlockAllChildren</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>base::DIR_PROGRAM_FILES6432</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>C:\\Program Files</code>（见注）</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>kBlockAllChildren</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>base::DIR_WINDOWS</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>C:\\Windows</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>kBlockAllChildren</code></p></td></tr></tbody></table><h2 id=\"sec-17\">5、临时文件</h2><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p>路径</p></th><th colspan=\"1\" rowspan=\"1\"><p>解析为</p></th><th colspan=\"1\" rowspan=\"1\"><p>BlockType</p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>base::DIR_IE_INTERNET_CACHE</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>IE/Edge 临时 Internet 文件</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>kBlockNestedDirectories</code></p></td></tr></tbody></table><h2 id=\"sec-18\">6、Chrome 目录</h2><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p>路径</p></th><th colspan=\"1\" rowspan=\"1\"><p>解析为</p></th><th colspan=\"1\" rowspan=\"1\"><p>BlockType</p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>base::DIR_EXE</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>Chrome 安装目录</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>kBlockAllChildren</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>base::DIR_MODULE</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>Chrome 模块目录</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>kBlockAllChildren</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>base::DIR_ASSETS</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>Chrome 资源目录</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>kBlockAllChildren</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>chrome::DIR_USER_DATA</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>Chrome 用户数据目录</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>kBlockAllChildren</code></p></td></tr></tbody></table><h2 id=\"sec-19\">7、后缀规则（跨仓库，任意层级匹配）</h2><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p>模式</p></th><th colspan=\"1\" rowspan=\"1\"><p>匹配</p></th><th colspan=\"1\" rowspan=\"1\"><p>BlockType</p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>*/.git/hooks</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>每个仓库的 hooks 目录</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>kBlockWrite</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>*/.git/config</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>每个仓库的 config</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>kBlockWrite</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>*/.git/modules</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>子模块目录（自带 hooks 与 config）</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>kBlockWrite</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>*/.mvn</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>Maven 项目与 JVM 配置</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>kBlockWrite</code></p></td></tr></tbody></table><h2 id=\"sec-20\">参考</h2><p><a href=\"https://github.com/chromium/chromium/commit/f51d2c6b61a66d710dc382c9db0af2c2a3be1e71\">修复的 commit</a></p><p><a href=\"https://github.com/chromium/chromium/blob/157.0.8103.38/chrome/browser/file_system_access/chrome_file_system_access_permission_context.cc\">.38版本tag</a></p><p><a href=\"https://github.com/chromium/chromium/blob/157.0.8103.37/chrome/browser/file_system_access/chrome_file_system_access_permission_context.cc\">.37版本tag</a></p><p><a href=\"https://wicg.github.io/file-system-access/\">FSA 规范（W3C/WICG）</a></p>","original","zhKind","complete","漏洞分析","利用链","Google","https://xz.aliyun.com/news/93396","先知社区",{"_156":157,"_158":-5},"changelogVersion","2026-10-01T08:00","release"]
