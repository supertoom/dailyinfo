[{"_1":2,"_3":4},"root",{"_5":108},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795048839000,"id","wirnox4qkgxmb80632xwozft4","title","乌克兰与 FBI 逮捕勒索组织成员，涉及逾 $40.5M 赎金","originalTitle","Ukraine, FBI arrest ransomware gang members tied to $40M in ransoms","summary","乌克兰执法部门与 FBI 逮捕 4 名国际勒索组织疑似成员，该组织至少涉及全球 28 家企业、逾 $40.5M 赎金支付。调查历时两年，团伙至少有 27 人，并与覆盖 8 个司法辖区、60 余人的网络有关联。","reason","案件揭示了勒索组织利用 AI 语音冒充 IT 支持、钓鱼页面窃取凭据和远程访问工具入侵企业的完整流程。","source",{"_75":107},"links",{"_99":106},"publishedAt","2026-11-18T23:08:33.000Z","discoveredAt","2026-11-18T23:15:32.954Z","timelineAt","category","activity","tags",[78,103,76,104,105,80],"score",74,"selected",true,"channel","news","story",{"_86":87,"_13":88},"x","readingMode","full","author","Lawrence Abrams","body",{"_61":98,"_99":-5,"_100":101,"_102":37},"outline",[89,90],"relatedStories",[85],"topics",[68,69,70,71,72],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fopbOjgbYWh0","reportCount",1,"additionalSourceCount",0,{"_73":83,"_75":84},{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","malware","name","恶意软件","attack","攻击活动","ai-offense","AI 攻防","ransomware","勒索软件","email","邮件与钓鱼",{"_86":87,"_13":88},"publicId","835b589f-c162-407d-80bf-75bb16cc3554","乌美联合逮捕勒索组织嫌疑人",{"_11":96,"_92":97,"_94":95},{"_11":91,"_92":93,"_94":95},"sec-2","text","发现您现有防御可能遗漏的邮件威胁。","level",2,"sec-1","AI 驱动的 IT 支持冒充","<p><img alt=\"Ukrainian hacker\" height=\"838\" src=\"/dailyinfo/media/d79268cd1ec23fb4.jpg\" srcset=\"/dailyinfo/media/c915a3c5d660ec25.jpg 720w, /dailyinfo/media/74d9467d9cfc26de.jpg 1200w, /dailyinfo/media/d79268cd1ec23fb4.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>乌克兰当局与 FBI 合作，逮捕了四名疑似国际勒索软件组织成员。该组织与全球至少 28 家公司支付的超过 40.5 million 美元赎金有关。</p><p>此次逮捕源于一项历时两年的调查，该网络犯罪组织至少由来自乌克兰、哈萨克斯坦、俄罗斯及其他国家的 27 名个人组成。</p><p>调查人员称，该组织与一个规模更大的网络犯罪网络有关联，后者拥有 60 多名成员，活跃于八个司法管辖区，其中包括臭名昭著的 Conti 勒索软件团伙的前成员。</p><p><a href=\"https://www.wiz.io/lp/claude-code-security-best-practices-cheat-sheet?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q3_INB_FORM_Claude-Code-Security-Best-Practices&amp;sfcid=701Vh00000gJQZuIAO&amp;utm_term=FY27Q4-bleepingcomputer-article-970x250-Nov&amp;utm_content=Claude-Code-Best-Practices\"><img src=\"/dailyinfo/media/db5325b9d2ed1bcc.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>据<a href=\"http://npu.gov.ua/news/dzvinok-vid-it-pidtrymky-i-kompaniia-v-zaruchnykakh-holova-natspolitsii-rozpoviv-pro-vykryttia-khakeriv-iaki-otrymaly-ponad-40-mln\">乌克兰国家警察</a>称，该团伙以石油和天然气、制药、制造、物流和金融行业组织以及关键基础设施为目标。</p><p>攻击者在发动攻击前会研究受害者的财务状况、资产、员工和 IT 漏洞，攻击旨在窃取企业数据、加密系统并勒索加密货币付款。</p><p>乌克兰新闻网站 <a href=\"https://censor.net/ua/n4034335\">Censor.NET</a> 在独家采访中，乌克兰国家警察代理局长 Maksym Tsutskiridze 表示，调查人员已确认至少 28 家公司支付了超过 40.5 million 美元赎金。</p><p>Tsutskiridze 表示：“我们已确认至少 28 家公司向黑客转交了超过 40.5 million 美元赎金，相当于约 18 亿乌克兰格里夫纳。这些钱已经支付。我们仍在查清损害的全部范围。”</p><p>在一次攻击中，黑客从一家美国公司窃取了 1.4 TB 数据，并将攻击扩大到同一企业集团内的其他公司。</p><p>攻击者最初索要 10 million 美元，但经谈判后最终获得了 5 million 美元。</p><p>法国网络安全新闻网站 <a href=\"https://www.lemagit.fr/actualites/366654897/Ransomware-coup-de-filet-contre-les-anciens-de-Conti\">LeMagIT</a> 首次报道称，<a href=\"https://reyestr.court.gov.ua/Review/141215039\">乌克兰法院记录</a>列出了该犯罪组织的多名受害者，包括 Warren Oil Company、Maxxis International-USA、Newpark Resources 和 Quantum Health。</p><p>法院文件将 Warren Oil Company 列为 2024 年 8 月一次攻击的受害者，攻击中黑客复制了 1.4 TB 数据，之后收到 84.5 BTC 的赎金，按当时价值折合约为 5 million 美元。</p><p>记录还称，Newpark Resources 于 2024 年 12 月支付了 1.5 million 美元，而 Quantum Health 在最初索要 15 million 美元赎金后，于 2026 年 6 月支付了 5 million 美元。</p><p>LeMagIT 还指出，BlackSuit 勒索软件团伙于 2024 年 11 月声称 Maxxis International 是其受害者，而乌克兰法院记录则确认该犯罪组织使用的勒索软件为 Chaos。</p><p>Conti 勒索软件行动<a href=\"https://www.bleepingcomputer.com/news/security/conti-ransomware-shuts-down-operation-rebrands-into-smaller-units/\">于 2022 年 5 月关闭</a>，其成员随后分散加入较小的勒索软件团伙和其他网络犯罪行动。</p><p>与 Conti 前成员有关联的团体之一是 BlackSuit，该团伙于 2022 年 1 月<a href=\"https://www.bleepingcomputer.com/news/security/new-royal-ransomware-emerges-in-multi-million-dollar-attacks/\">最初以 Quantum 勒索软件的名义运营</a>，之后更名为 Royal。</p><p>2023 年 6 月，Royal 在<a href=\"https://www.bleepingcomputer.com/news/security/royal-ransomware-gang-adds-blacksuit-encryptor-to-their-arsenal/\">测试新的加密器</a>并实施多起高调攻击后，开始以 BlackSuit 的名义运营，其中包括针对<a href=\"https://www.bleepingcomputer.com/news/security/city-of-dallas-hit-by-royal-ransomware-attack-impacting-it-services/\">得克萨斯州达拉斯市</a>的攻击。</p><p>然而，乌克兰当局尚未确认这四名被捕嫌疑人是 Conti 的前成员，也未确认他们各自与 BlackSuit 或 Chaos 的关联。</p><h2 id=\"sec-1\">AI 驱动的 IT 支持冒充</h2><p>为了入侵企业网络，网络犯罪分子冒充 IT 支持人员，并使用一个定制开发的平台，通过 AI 生成的语音消息自动化实施欺诈电话。</p><p>在通话过程中，他们诱骗员工泄露登录凭据或安装远程访问软件，使攻击者得以访问企业内部系统。</p><p>在有记录的一起事件中，一名攻击者通过电话与员工保持通话，另一名攻击者同时访问了公司的系统，直到攻击者确认入侵成功，电话才结束。</p><p>Tsutskiridze解释道：“他们搭建了自己的平台，其中包含由人工智能生成的语音消息。他们致电公司员工，冒充 IT 支持专家。他们以提供技术协助为借口，说服员工披露登录凭据或安装远程访问软件，从而得以访问企业网络。”</p><p>乌克兰法院的记录提供了对这些攻击的更多细节，描述了黑客如何使用冒充企业 VPN 服务的钓鱼页面、伪造电话号码，以及 TeamViewer 和 AnyDesk 等远程访问工具。</p><p>在 Warren Oil Company 遭袭一案中，记录指控攻击者诱骗员工在钓鱼页面上输入凭据，随后获取了一个双因素认证代码，该代码使他们得以远程访问企业网络。</p><p>进入网络后，攻击者窃取了敏感信息，并使用勒索软件加密文件，导致受害方的运营中断。</p><p>该团伙随后要求以加密货币支付，以换取恢复对加密系统的访问，同时威胁要公开发布窃取的企业数据。</p><p>Tsutskiridze说：“他们会让公司无法访问自己的数据，然后索要数百万美元作为解密的对价。与此同时，他们还威胁要公布窃取的信息。受害者受到双方面施压，被迫用加密货币支付赎金。”</p><p>在与美国执法部门联合行动的一部分，乌克兰当局在基辅和乌克兰 11 个地区同时进行了 66 次搜查。该组织四名疑似核心成员被拘留，但当局未披露其确切逮捕地点。</p><p>在此次搜查期间，调查人员查获了电脑、手机、银行卡、将近 370,000 美元现金以及 20,000 欧元。</p><p><img alt=\"Seized cash\" height=\"600\" src=\"/dailyinfo/media/b59d2166ad0c5d97.jpg\" srcset=\"/dailyinfo/media/21b058be2d80c613.jpg 720w, /dailyinfo/media/261b9979cd3f3255.jpg 1200w, /dailyinfo/media/b59d2166ad0c5d97.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"750\"></p><p>该组织四名涉嫌核心成员已被正式告知涉嫌犯罪，目前处于羁押状态。</p><p>这些嫌疑人面临乌克兰法律下与参与犯罪组织以及未经授权干涉信息系统相关的指控。若被定罪，最高可判处 15 年监禁。</p><p>乌克兰当局表示调查仍在进行，执法部门正努力查明该国际网络的更多成员，并确定他们与其他网络攻击的关联。</p><p>国家警察局还发布了一段视频，展示调查过程中的画面，包括执法突袭、查获的现金、对调查人员的采访，以及一名嫌疑人接受讯问。</p><p>该视频还包含了一段据称的勒索软件 extortion 通话录音，勒索方声称已窃取超过 1.5 TB 的企业数据，并索要 1500 万美元。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/2873ab279056c37c.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-2\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现您现有防御可能遗漏的邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体会分析邮件意图、上下文和行为，以发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>通过为期 14 天的只读扫描查看 Microsoft 365 或 Google Workspace 中有哪些邮件得以通过，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始免费的电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","勒索","数据泄露","钓鱼","https://www.bleepingcomputer.com/news/security/ukraine-fbi-arrest-ransomware-gang-members-tied-to-40m-in-ransoms/","BleepingComputer",{"_109":110,"_111":-5},"changelogVersion","2026-10-01T08:00","release"]
