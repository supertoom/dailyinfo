[{"_1":2,"_3":4},"root",{"_5":93},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1794616835000,"id","w4i7n11q7jgyy4p2xh92mfdcb","title","Microsoft 11月补丁修复1,090个漏洞，CVE-2026-124194已遭利用","originalTitle","Microsoft November Patch Tuesday: one exploited Outlook bug and 30 wormable flaws","summary","Microsoft 11月补丁共修复约1,090个漏洞，其中CVE-2026-124194已遭利用；该Outlook欺骗漏洞需用户打开特制消息文件，可泄露NTLMv2哈希并用于冒充用户。","reason","原文汇总Microsoft补丁中的已利用漏洞、零点击RCE与30个潜在蠕虫漏洞，并指出部分公告细节不足。","source",{"_67":92},"links",{"_83":91},"publishedAt","2026-11-11T09:03:48.000Z","discoveredAt","2026-11-11T10:08:41.289Z","timelineAt","category","vuln","tags",[87,70,88,89,90],"score",82,"selected",true,"channel","news","story","x","readingMode","full","author","Pierluigi Paganini","body",{"_59":82,"_83":-5,"_84":85,"_86":37},"outline",[76],"relatedStories",[],"topics",[60,61,62,63,64],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_65":74,"_67":75},{"_65":72,"_67":73},{"_65":31,"_67":71},{"_65":69,"_67":70},{"_65":66,"_67":68},"slug","research","name","技术研究","exploited","在野利用","漏洞披露","email","邮件与钓鱼","microsoft","Microsoft / 微软",{"_11":77,"_78":79,"_80":81},"sec-1","text","Microsoft 11 月补丁星期二安全更新修复了 1,090 个缺陷，其中包括一个已被利用的 Outlook 漏洞和 30 个可能具备蠕虫传播能力的问题。","level",2,"<h2 id=\"sec-1\">Microsoft 11 月补丁星期二安全更新修复了 1,090 个缺陷，其中包括一个已被利用的 Outlook 漏洞和 30 个可能具备蠕虫传播能力的问题。</h2><p>Microsoft 11 月补丁星期二处理了约 1,090 个新漏洞，少于上个月约 1,400 个。连续两个月超过 Microsoft 此前任何年份的总漏洞数，而整体数量也显得有些令人困惑，因此其他追踪机构报告的总数有所不同。</p><p>此次更新涵盖 Windows 及其组件、Office、网络和远程访问、图形、媒体和打印、存储和文件系统、.NET 与 Visual Studio、安全和身份、Azure 和云、Exchange Server、Dynamics 和 Xbox。只有一个漏洞正遭到主动攻击，且没有漏洞已公开被利用。ZDI 表示，这并不意味着实际利用减少，只是零日漏洞更少；并推测 AI 在逆向补丁方面比在闭源软件中寻找和利用漏洞方面更擅长。</p><p>被利用的漏洞是 <a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-124194\">CVE-2026-124194</a>，这是一个 Outlook 欺骗漏洞，而它的名称低估了实际影响。攻击者发送 specially crafted message file（特制消息文件）并诱骗用户打开，Outlook 随后会在没有通常的外部内容警告的情况下连接至攻击者控制的位置，从而泄露用户的 NTLMv2 哈希。 </p><p><em>“未经身份验证的攻击者可以发送特制消息文件，并说服用户在受影响版本的 Microsoft Outlook 中打开它。打开该文件可能导致 Outlook 在不显示常规外部内容警告的情况下连接至攻击者控制的网络位置，从而可能泄露可用于冒充用户的身份验证信息。利用需要网络连接和用户交互。”公告<a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-124194\">如此写道</a>。“攻击者必须向用户发送恶意 Office 文件，并说服他们打开该文件。”</em></p><p>随后，攻击者便能以该用户身份进行身份验证。预览窗格不是攻击路径，CVSS 分数也只有 6.5，但 ZDI 表示应优先处理它，因为 Microsoft 将其标记为已被利用。</p><p><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-116928\">CVE-2026-116928</a> 是一个可通过 Exchange Server 触发的 Windows Search 远程代码执行漏洞。未经身份验证的攻击者通过电子邮件发送特制附件，服务器自动建立索引时便会触发该漏洞，因此收件人无需打开任何内容。它属于零点击漏洞，CVSS 评分为 9.8，ZDI 认为它比本月 Exchange 获得的九个补丁中的任何一个都更严重。</p><p><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-119958\">CVE-2026-119958</a> 影响 Windows LDAP 服务。未经身份验证的攻击者通过网络发送特制 LDAP 调用，触发越界写入，并在服务上下文中执行代码，这在域控制器上可能造成破坏。ZDI 表示应迅速测试并部署修复。CVE-2026-119952 是一个 Schannel 远程代码执行漏洞，被标记为“Exploitation More Likely”，是少数获此评级的 Critical 补丁之一，其较高的攻击复杂度使评分相对较低。</p><p><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-119990\">CVE-2026-119990</a> 是 Azure OpenAI 权限提升漏洞，其公告最初写着“Customer Action Required: Yes”，随后却没有列出任何需要采取的措施。未经身份验证的攻击者可以通过互联网发送特制请求，访问编排信息、更改工作流或中断服务。Microsoft 此后将其修订为无需客户采取任何措施。一份声称需要采取措施、却又没有列出任何措施的公告，是本月最宽松的紧急通知。</p><p>另外还有两个漏洞因其组件而格外引人注目。CVE-2026-95962 是鲜为人知的 Windows Virtual Filtering Platform 中的释放后重用漏洞，可通过精心构造的网络数据包触发，且无需身份验证或用户交互。它涉及竞态条件，但 ZDI 指出，在 Pwn2Own 上这类漏洞经常会被攻破。CVE-2026-112967 是 Xbox Live Networking Service 中的堆溢出漏洞，CVSS 评分为 9.8；ZDI 认为其被利用的可能性不高，但乐于想象 Xbox Live 漏洞在真实环境中被利用的场景。</p><p>ZDI <a href=\"https://www.zerodayinitiative.com/blog/2026/11/10/the-november-2026-security-update-review\">统计了本月 30 个可蠕虫化漏洞</a>，低于上个月的 59 个。其中 17 个采用了关于未经身份验证的攻击者通过网络运行代码且无需交互的公告措辞，另有 13 个使用变体措辞、没有 FAQ，或在其摘要和 CVSS 向量中呈现相同模式。ZDI 警告称，其中一些判断可能有误，因为少数公告对细节的描述较为简略。</p><figure><table><thead><tr><th>组件</th><th>CVE</th></tr></thead><tbody><tr><td>消息队列（5）</td><td>CVE-2026-116710、119963、119964、109459、119967</td></tr><tr><td>DNS（4）</td><td>CVE-2026-81384、96092、96177、88218</td></tr><tr><td>颜色管理（2）</td><td>CVE-2026-96067、96078</td></tr><tr><td>DHCP 服务器（2）</td><td>CVE-2026-88243、72998</td></tr><tr><td>DirectMusic（2）</td><td>CVE-2026-95882、95901</td></tr><tr><td>Xbox（2）</td><td>CVE-2026-112967、66801</td></tr><tr><td>各一个（13）</td><td>Exchange Server（116928）、LDAP（119958）、Schannel（119952）、CredSSP（119962）、Deployment Services（119951）、IIS（119961）、NAT（113862）、RPC Runtime（118737）、Media Foundation（96157）、iSCSI（88234）、Virtual Filtering Platform（95962）、eSCL Scanner（95956）、Modern Device Management（119945）</td></tr></tbody></table></figure><p>DNS、DHCP、LDAP 和 Exchange 等面向网络的服务最值得优先关注。</p><p><em>“由于少数公告对细节的描述较为简略，我关于其中一些漏洞的判断可能有误。”ZDI 总结道。“一如既往，我建议尽快测试并部署这些补丁，尤其是 DNS、DHCP、LDAP 和 Exchange 等面向网络的服务”</em></p><p><strong>在 Twitter 上关注我：&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;和&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;和&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a><strong></strong></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;黑客、补丁星期二）</strong></p>","original","zhKind","translation","complete","补丁","漏洞分析","Microsoft","邮件安全","https://securityaffairs.com/202839/hacking/microsoft-november-patch-tuesday-one-exploited-outlook-bug-and-30-wormable-flaws.html","Security Affairs",{"_94":95,"_96":-5},"changelogVersion","2026-10-01T08:00","release"]
