[{"_1":2,"_3":4},"root",{"_5":108},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795394446000,"id","z69zj40alkpfq51pcwzj6kkm6","title","Microsoft Agent Framework 的 PyPI 包 1.26.1 和 1.26.2 被植入凭据窃取代码","originalTitle","Microsoft’s Agent Framework PyPI package compromised to steal credentials","summary","攻击者篡改 Microsoft Agent Framework 的官方 PyPI 包，发布恶意版本 1.26.1 和 1.26.2，在 Python 启动时自动收集环境变量、配置文件及进程中的 Azure、AWS、GitHub、Docker、Hugging Face、OpenAI 等凭据。","reason","文章还原了恶意版本自动执行、窃取多种云凭据及连续发布的完整链路，并给出隔离环境与轮换凭据等处置方法。","source",{"_76":107},"links",{"_99":106},"publishedAt","2026-11-18T16:58:42.000Z","discoveredAt","2026-11-18T17:42:32.830Z","timelineAt","category","activity","tags",[81,79,103,104,77,105],"score",92,"selected",true,"channel","news","story",{"_89":90,"_13":91},"x","readingMode","full","author","Bill Toulas","body",{"_61":98,"_99":-5,"_100":101,"_102":37},"outline",[92],"relatedStories",[88],"topics",[68,69,70,71,72,73],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fXDd5gj0lrbY","reportCount",5,"additionalSourceCount",4,{"_74":86,"_76":87},{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","ai-security","name","AI 安全","malware","恶意软件","attack","攻击活动","identity","身份与访问","supply-chain","供应链安全","microsoft","Microsoft / 微软",{"_89":90,"_13":91},"publicId","e603b0df-7979-4476-a581-fff48c892c4e","Agent Framework 包投毒窃取凭据",{"_11":93,"_94":95,"_96":97},"sec-1","text","发现现有防御可能遗漏的电子邮件威胁。","level",2,"<p><img alt=\"Microsoft\" height=\"900\" src=\"/dailyinfo/media/8485ef6f7b390430.jpg\" srcset=\"/dailyinfo/media/7ec72924197dcc34.jpg 720w, /dailyinfo/media/5fad5da7141cb7e8.jpg 1200w, /dailyinfo/media/8485ef6f7b390430.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>黑客入侵了 Microsoft 官方 Agent Framework 的 PyPI Python 软件包，发布了两个恶意版本，旨在从开发者的系统中窃取云凭据和其他敏感信息。</p><p>Microsoft Agent Framework 是 Microsoft 的开源工具包，用于构建 AI 智能体并协调其工作流。它是一款相当受欢迎的工具，在 PyPI 上每月约有 <a href=\"https://pypistats.org/packages/agent-framework\">200,000 次下载</a>。</p><p>恶意版本 1.26.1 和 1.26.2 于 2026 年 11 月 17 日发布，其中包含一个凭据窃取程序，可在受影响环境中的 Python 正常启动期间自动执行，即使未导入 Agent Framework 软件包也会运行。</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/bbd0383a4e0a5be0.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>这两个版本都保留了对正版 <code>agent-framework-core</code> 1.26.0 软件包的依赖，使框架能够正常运行，同时恶意软件在后台运行。</p><p>多家安全公司发现并记录了此次攻击，包括 <a href=\"http://socket.dev/blog/agent-framework-pypi-package-compromised-with-credential-stealer\">Socket</a>、<a href=\"http://www.stepsecurity.io/blog/microsoft-agent-framework-pypi-package-compromised\">Step Security</a> 和 <a href=\"https://www.ox.security/blog/breaking-hijacked-releases-of-microsofts-official-agent-framework-steals-azure-and-ci-credentials/\">Ox Security</a>。</p><figure><img alt=\"Attack overview\" height=\"600\" src=\"/dailyinfo/media/dcd2124511402e73.jpg\" loading=\"lazy\" decoding=\"async\" width=\"510\">\n<figcaption><strong>攻击概述</strong><br>\n<em>来源：Ox Security</em></figcaption>\n</figure><p>版本 1.26.1 包含一个凭据窃取程序，用于收集环境变量、本地配置文件以及其他运行进程中的机密信息（取决于权限），目标包括 Azure、AWS、GitHub、Docker、Hugging Face、OpenAI 等服务。</p><p>该恶意软件还试图获取 Azure 托管标识访问令牌和 Azure DevOps OIDC 令牌，这可能使攻击者能够访问更多云资源。</p><p>版本 1.26.2 新增了对 GitHub Actions OIDC 令牌的请求，以及对 GitHub runner 目录的搜索。</p><p>据 Socket 和 StepSecurity 表示，第一个恶意版本使用 <code>agent_framework_meta.pth</code> 在 <code>agent_framework_meta/_telemetry.py</code> 中执行凭据窃取程序，触发时机为 Python 启动期间。</p><p>第二个版本恢复了原始软件包初始化程序，并将恶意代码移入 <code>af_runtime_diag.pth</code> 和 <code>af_runtime_diag.py</code>。</p><p>两个版本都将收集到的数据外传至同一个由攻击者控制的端点 <code>https://webhook[.]site/d381fd80-ec62-42ad-8f5c-d1b15103c9bb</code>。</p><figure><img src=\"/dailyinfo/media/23f6034366c8fe52.jpg\" srcset=\"/dailyinfo/media/42ce3c49ae8fd9d6.jpg 720w, /dailyinfo/media/5d2e74777f508367.jpg 1200w, /dailyinfo/media/23f6034366c8fe52.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Collecting data from breached environments\" height=\"600\" width=\"1088\">\n<figcaption><strong>从遭入侵的环境中收集数据</strong><br>\n<em>来源：Ox Security</em></figcaption>\n</figure><p>PyPI 隔离了第一个恶意版本，但攻击者在大约 2.5 分钟后发布了第二个版本，该版本也在约八分钟后被隔离。第二个版本的发布表明，在首次隔离后攻击者仍拥有发布权限。</p><p>目前尚不清楚攻击者是如何获得访问权限并以 Microsoft 官方 PyPI 项目的名义发布恶意版本的。</p><p>BleepingComputer 已联系 Microsoft，以了解此次入侵的突破点，但截至发布时仍未收到回应。</p><p>安装了任一恶意版本的开发者应立即隔离受影响环境，在确保安全之前避免运行 Python 或 pip，并从已知干净的环境中使用安全的 1.26.0 版本重新构建。</p><p>任何可能已暴露且可被入侵环境访问的凭据都应立即轮换。</p><p>为确定具体的入侵程度，调查人员应查找出口日志中的特定 webhook URL 路径，并区分被阻止的请求与已完成的传输。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/06fc6e977fae1ca4.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体会分析电子邮件意图、上下文和行为，识别网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>对 Microsoft 365 或 Google Workspace 进行为期 14 天的只读扫描，查看有哪些威胁正在绕过防御，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始免费电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","供应链投毒","凭据","Microsoft","https://www.bleepingcomputer.com/news/security/microsofts-agent-framework-pypi-package-compromised-to-steal-credentials/","BleepingComputer",{"_109":110,"_111":-5},"changelogVersion","2026-10-01T08:00","release"]
