[{"_1":2,"_3":4},"root",{"_5":92},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1795048832000,"id","jsv59jfiij7o2fhu864jod013","title","CERT-FR 披露 F5 产品多项远程代码执行、拒绝服务与安全策略绕过漏洞","originalTitle","Multiples vulnérabilités dans les produits F5 (18 novembre 2026)","summary","CERT-FR 披露 F5 产品存在多项漏洞，攻击者可能借此实现远程任意代码执行、远程拒绝服务和安全策略绕过。原文未列出具体 CVE 编号、受影响版本或利用前提，并建议参阅厂商安全公告的 Documentation 部分获取补丁。","reason","source",{"_69":91},"links",{"_60":90},"publishedAt","2026-11-18T00:00:00.000Z","discoveredAt","2026-11-18T18:47:33.539Z","timelineAt","category","vuln","tags",[88,89],"score",52,"selected",false,"channel","news","story",{"_72":73,"_13":74},"x","readingMode","full","author","body",{"_84":-5,"_60":85,"_86":-5,"_87":36},"outline",[75,76],"relatedStories",[71],"topics",[67],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fu3dB08isxMs","reportCount",1,"additionalSourceCount",0,{"_68":30,"_69":70},"slug","name","漏洞披露",{"_72":73,"_13":74},"publicId","3d926d5f-0dac-46dd-a0bb-dae21b745ab7","CERT-FR披露F5产品多项漏洞",{"_11":82,"_78":83,"_80":81},{"_11":77,"_78":79,"_80":81},"sec-2","text","Solutions","level",2,"sec-1","Résumé","zh","<h2 id=\"sec-1\">Résumé</h2><p>De multiples vulnérabilités ont été découvertes dans les produits F5. Elles permettent à un attaquant de provoquer une exécution de code arbitraire à distance, un déni de service à distance et un contournement de la politique de sécurité.</p><h2 id=\"sec-2\">Solutions</h2><p>Se référer au bulletin de sécurité de l'éditeur pour l'obtention des correctifs (cf. section Documentation).</p>","zhKind","complete","漏洞","补丁","https://www.cert.cyber.gouv.fr/avis/CERTFR-2026-AVI-1567/","CERT-FR",{"_