[{"_1":2,"_3":4},"root",{"_5":87},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1794357637000,"id","j3zs99gaytjzbcm7piuk8be0b","title","GPUStack v2.2.0 之前认证绕过漏洞已被在野利用","originalTitle","GPUStack: Authentication bypass via trusted loopback source (reverse-proxy TCP peer or X-GPUStack-Real-IP header) grants unauthenticated admin","summary","GPUStack v2.2.0 之前存在认证绕过，默认配置下可将请求来源判定为 127.0.0.1 并授予未认证管理员权限；同机反向代理会暴露 TCP peer，伪造 X-GPUStack-Real-IP: 127.0.0.1 也可触发该分支。","reason","文章完整说明两种绕过路径及真实攻击后果，并给出固定版本和临时缓解配置，便于部署方快速判断暴露范围与处置优先级。","source",{"_72":86},"links",{"_60":85},"publishedAt","2026-11-09T22:15:27.000Z","discoveredAt","2026-11-09T22:34:23.929Z","timelineAt","category","vuln","tags",[81,73,82,83,76,84],"score",84,"selected",true,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[67,68,69],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fIpVwNh2skEg","reportCount",1,"additionalSourceCount",0,{"_70":75,"_72":76},{"_70":31,"_72":74},{"_70":71,"_72":73},"slug","exploited","name","在野利用","漏洞披露","identity","身份与访问",{"_78":79,"_13":80},"publicId","3feb96fd-4fa7-4b70-b0f3-9f885cbd8e09","GPUStack认证绕过漏洞已被在野利用","漏洞","补丁","漏洞利用","网络设备","https://github.com/advisories/GHSA-gj9m-f8ph-pmhr","GitHub 安全公告",{"_88":89,"_90":-5},"changelogVersion","2026-10-01T08:00","release"]
