[{"_1":2,"_3":4},"root",{"_5":117},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795567284000,"id","nc9k4mm8c96fwbmiwe8cwt06d","title","VMware vCenter Server 未授权管理员用户创建漏洞 CVE-2026-123903 已复现","originalTitle","原创漏洞 | VMware vCenter Server 未授权管理员用户创建漏洞","summary","VMware vCenter Server 存在身份鉴别错误漏洞 CVE-2026-123903，CVSS 9.8，高风险且可远程利用；攻击者在可访问 389 端口时可能无需权限绕过身份验证，创建管理员账号并接管 vCenter。","reason","材料给出漏洞编号、CVSS 9.8、受影响版本与复现条件，并说明 PoC 未公开，便于评估资产暴露与修复优先级。","source",{"_72":116},"links",{"_108":115},"publishedAt","2026-11-24T10:12:00.000Z","discoveredAt","2026-11-24T12:51:34.545Z","timelineAt","category","vuln","tags",[111,112,113,75,114],"score",73,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","body",{"_61":107,"_108":-5,"_109":108,"_110":37},"outline",[82,83,84,85,86,87,88],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fkImOKGDp35g","reportCount",1,"additionalSourceCount",0,{"_71":76,"_72":77},{"_71":74,"_72":75},{"_71":31,"_72":73},"slug","name","漏洞披露","identity","身份与访问","vmware","VMware / Broadcom",{"_79":80,"_13":81},"publicId","f26bad15-2100-46af-b49b-9f8342651d0c","vCenter未授权管理员创建漏洞已复现",{"_11":105,"_90":106,"_92":93},{"_11":103,"_90":104,"_92":93},{"_11":101,"_90":102,"_92":93},{"_11":99,"_90":100,"_92":93},{"_11":97,"_90":98,"_92":93},{"_11":94,"_90":95,"_92":96},{"_11":89,"_90":91,"_92":93},"sec-7","text","微步产品支撑","level",2,"sec-6","官方修复方案",3,"sec-5","修复方案","sec-4","漏洞复现","sec-3","漏洞影响范围","sec-2","漏洞处置优先级(VPT)","sec-1","漏洞概况","<p><span>微步在线研究响应中心</span> <span>2026-11-24 18:12</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/d4313ee0430048dc.jpg\" loading=\"lazy\" decoding=\"async\"></p><h2 id=\"sec-1\"><span><span>漏洞概况</span></span></h2><hr><p><span>11月24日，vCenter Server官方发布通告，修复了VMware vCenter Server 未授权管理员用户创建漏洞。</span><strong><span>微步情报局已成功复现。</span></strong><span>经分析，VMware vCenter Server 是 VMware 推出的虚拟化管理平台，其内置 vmdir 目录服务承载 SSO 身份目录。该服务在特定认证流程中存在访问控制缺陷，攻击者能访问 389 端口情况下，可能绕过身份验证，创建管理员账号并接管 vCenter。（完整漏洞情报请查阅<a href=\"https://x.threatbook.com/v5/vul/XVE-2026-62902%EF%BC%89\">https://x.threatbook.com/v5/vul/XVE-2026-62902）</a></span></p><p><span>此漏洞</span><strong><span>无需任何权限</span></strong><span>，攻击者成功利用此漏洞可</span><strong><span>创建管理员账号并接管 vCenter，跟</span></strong><strong><span>11月19日VMware官方发布CVE-2026-123890不是同一个漏洞，</span></strong><span>建议受影响用户</span><strong><span>尽快修复。</span></strong></p><h2 id=\"sec-2\"><span><span>漏洞处置优先级(VPT)</span></span></h2><hr><p><strong><span>风险等级：高风险</span></strong><span><br></span><strong><span>风险分数：9.8</span></strong></p><table><tbody><tr><td rowspan=\"3\"><p><strong><span>基本信息</span></strong></p></td><td><p><span>微步编号</span></p></td><td><p><span>XVE-2026-62902</span></p></td></tr><tr><td><p><span>CVE编号</span></p></td><td><p><span>CVE-2026-123903</span></p></td></tr><tr><td><p><span>漏洞类型</span></p></td><td><p><span>身份鉴别错误</span></p></td></tr><tr><td rowspan=\"5\"><p><strong><span>利用条件评估</span></strong></p></td><td><p><span>利用漏洞的网络条件</span></p></td><td><p><span>可远程利用</span></p></td></tr><tr><td><p><span>是否需要绕过安全机制</span></p></td><td><p><span>不需要</span></p></td></tr><tr><td><p><span>对被攻击系统的要求</span></p></td><td><p><span>默认配置</span></p></td></tr><tr><td><p><span>利用漏洞的权限要求</span></p></td><td><p><span>无需任何权限</span></p></td></tr><tr><td><p><span>是否需要受害者配合</span></p></td><td><p><span>不需要</span></p></td></tr><tr><td rowspan=\"2\"><p><strong><span>利用情报</span></strong></p></td><td><p><span>POC是否公开</span></p></td><td><p><span>否</span></p></td></tr><tr><td><p><span>已知利用行为</span></p></td><td><p><span>否</span></p></td></tr></tbody></table><h2 id=\"sec-3\"><span><span>漏洞影响范围</span></span></h2><hr><table><tbody><tr><td><p><strong><span>产品名称</span></strong></p></td><td><p><span>Vmware vCenter Server</span></p><p><span>VMware Cloud Foundation</span><span><br></span><span>Vmware Telco Cloud Platform</span><span><br></span><span>Vmware Telco Cloud Infrastructure</span></p></td></tr><tr><td><p><strong><span>受影响版本</span></strong></p></td><td><p><span>vCenter Server:</span></p><p><span>&nbsp;9.1.x.x&lt;=version&lt;9.1.2</span><span><br></span><span>vCenter Server:</span></p><p><span>&nbsp;9.0.x.x&lt;=version&lt;9.0.2.0300</span><span><br></span><span>vCenter Server:</span></p><p><span>&nbsp;8.0&lt;=version&lt;8.0U3m</span></p><p><span>vCenter Server: 7.x 未提供修复版本，联系官方咨询</span></p><p><span>VMware Cloud Foundation: 5.x&lt;=version&lt;5.2.5</span></p><p><span>Telco Cloud Platform: 3.0, 4.x, 5.0.x, 5.1.x, 5.2</span></p><p><span>Telco Cloud Infrastructure: 3.0</span></p></td></tr><tr><td><p><strong><span>有无修复补丁</span></strong></p></td><td><p><span><a href=\"https://support.broadcom.com/web/ecx/support-content-notification/-/external/content/SecurityAdvisories/0/39626\">https://support.broadcom.com/web/ecx/support-content-notification/-/external/content/SecurityAdvisories/0/39626</a></span></p></td></tr></tbody></table><h2 id=\"sec-4\"><span><span>漏洞复现</span></span></h2><hr><p><span>1. 首页</span></p><p><img src=\"/dailyinfo/media/101c21b8bd54527a.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span>2. 在8.0.3.01000版本执行poc，创建新用户</span></p><p><img alt=\"image.png\" width=\"1104\" src=\"/dailyinfo/media/85a0ebde40718f45.webp\" srcset=\"/dailyinfo/media/47d213bbf9f4f904.webp 720w, /dailyinfo/media/00efa14589f2691e.webp 1200w, /dailyinfo/media/85a0ebde40718f45.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\"></p><p><span>3. 登录后台</span></p><p><img alt=\"image.png\" width=\"1522\" src=\"/dailyinfo/media/a928189b7b3c76a9.webp\" srcset=\"/dailyinfo/media/5779a250df242be6.webp 720w, /dailyinfo/media/39a750493ec9191d.webp 1200w, /dailyinfo/media/a928189b7b3c76a9.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\"></p><h2 id=\"sec-5\"><span><span>修复方案</span></span></h2><hr><h3 id=\"sec-6\"><span>官方修复方案</span></h3><p><span><a href=\"https://support.broadcom.com/web/ecx/support-content-notification/-/external/content/SecurityAdvisories/0/39626\">https://support.broadcom.com/web/ecx/support-content-notification/-/external/content/SecurityAdvisories/0/39626</a></span></p><h2 id=\"sec-7\"><span><span>微步产品支撑</span></span></h2><hr><p><span>微步漏洞情报于</span><strong><span>2026年9月14日</span></strong><span>收录该漏洞。</span></p><p><span>微步下一代威胁情报平台NGTIP，高级威胁情报平台ATI及X情报中心已于漏洞收录时向漏洞订阅用户推送该漏洞情报，并将持续推送后续更新；对于已经录入资产的用户，支持实时自动化排查受影响资产。</span></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=eef6af12&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzg5MTc3ODY4Mw%3D%3D%26mid%3D2247509104%26idx%3D1%26sn%3D4640736488dc2811dcad0757e475a21c\">跳转微信打开</a></p>","original","zhKind","complete","漏洞","复现","漏洞利用","VMware","https://mp.weixin.qq.com/s?__biz=Mzg5MTc3ODY4Mw==&mid=2247509104&idx=1&sn=4640736488dc2811dcad0757e475a21c","微步在线研究响应中心",{"_118":119,"_120":-5},"changelogVersion","2026-10-01T08:00","release"]
