[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794530490000,"id","qhzay6b5zg4i4n2z608imqz49","title","`@astrojs/solid-js` 修复未转义插槽名导致的反射型 XSS 漏洞","originalTitle","Astro: Reflected XSS via unescaped slot names in @astrojs/solid-js","summary","`@astrojs/solid-js` 的服务端渲染器未对 Solid 组件插槽名进行 HTML 转义，攻击者可构造链接注入任意 HTML，在站点源上执行 JavaScript。漏洞影响 0.2.0 至 7.1.1，仅当页面使用请求参数作为插槽名、组件通过 `client:*` 水合且动态渲染该插槽时可利用；7.1.2 已修复，升级前应避免使用请求控制的插槽名或映射至固定名称。","reason","source",{"_68":78},"links",{"_59":77},"publishedAt","2026-11-12T22:34:44.000Z","discoveredAt","2026-11-12T22:36:23.886Z","timelineAt","category","vuln","tags",[74,75,76],"score",39,"selected",false,"channel","news","story",{"_71":72,"_13":73},"x","readingMode","full","author","body","outline",[],"relatedStories",[70],"topics",[66],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fD6phhx-B0Cc","reportCount",1,"additionalSourceCount",0,{"_67":30,"_68":69},"slug","name","漏洞披露",{"_71":72,"_13":73},"publicId","e92a771d-d125-4323-bb00-10da172885ec","Solid渲染器反射型XSS已修复","漏洞","补丁","复现","https://github.com/advisories/GHSA-jmv2-qgxf-f995","GitHub 安全公告",{"_80":81,"_82":-5},"changelogVersion","2026-10-01T08:00","release"]
