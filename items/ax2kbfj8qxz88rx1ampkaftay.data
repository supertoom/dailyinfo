[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1795653635000,"id","ax2kbfj8qxz88rx1ampkaftay","title","Microsoft Windows 远程访问 API 本地权限提升漏洞 CVE-2026-119853 已复现","originalTitle","【漏洞通告】Microsoft Windows 远程访问 API 自定义拨号器本地权限提升漏洞（CVE-2026-119853）","summary","Microsoft Windows 远程访问 API 自定义拨号器存在本地权限提升漏洞 CVE-2026-119853，受影响版本涵盖 Windows 10、Windows 11、Windows Server 2016、2019、2022 和 2025。","reason","source",{"_73":96},"links",{"_85":95},"publishedAt","2026-11-25T09:18:00.000Z","discoveredAt","2026-11-25T17:19:04.658Z","timelineAt","category","vuln","tags",[88,89,90,91,92,93,94],"score",67,"selected",false,"channel","news","story",{"_81":82,"_13":83},"x","readingMode","full","author","body",{"_60":84,"_85":-5,"_86":85,"_87":55},"outline",[],"relatedStories",[80],"topics",[67,68,69,70],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","fVZxcnYXFhzg","reportCount",3,"additionalSourceCount",2,{"_71":78,"_73":79},{"_71":76,"_73":77},{"_71":30,"_73":75},{"_71":72,"_73":74},"slug","research","name","技术研究","漏洞披露","kernel","内核与系统","microsoft","Microsoft / 微软",{"_81":82,"_13":83},"publicId","70595c2b-05ad-4de3-ab60-c4dfc82b0134","Windows RAS API提权漏洞已复现并有补丁","<p><span>深瞳漏洞实验室</span> <span>2026-11-25 17:18</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/8db16dc2993fd066.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>2026年11月24日，深瞳漏洞实验室监测到一则Microsoft Windows组件存在权限提升漏洞的信息，漏洞编号：CVE-2026-119853，漏洞威胁等级：高危。</p><p><img src=\"/dailyinfo/media/271642896e345353.gif\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span><span>漏洞名称：</span></span></strong></p><p><span>Microsoft Windows 远程访问 API 自定义拨号器本地权限提升漏洞（CVE-2026-119853）</span></p><p><strong><span><span>组件名称：</span></span></strong></p><p><span>Microsoft Windows</span></p><p><span><strong><span>影响范围：</span></strong></span></p><p><span>10.0.14393.0 &lt;= Windows 10 Version 1607 &lt; 10.0.14393.9688</span></p><p><span>10.0.17763.0 &lt;= Windows 10 Version 1809 &lt; 10.0.17763.9487</span></p><p><span>10.0.19044.0 &lt;= Windows 10 Version 21H2 &lt; 10.0.19044.7846</span></p><p><span>10.0.19045.0 &lt;= Windows 10 Version 22H2 &lt; 10.0.19045.7846</span></p><p><span>10.0.22631.0 &lt;= Windows 11 Version 23H2 &lt; 10.0.22631.7711</span></p><p><span>10.0.26100.0 &lt;= Windows 11 Version 24H2 &lt; 10.0.26100.9974</span></p><p><span>10.0.26200.0 &lt;= Windows 11 Version 25H2 &lt; 10.0.26200.9974</span></p><p><span>10.0.28000.0 &lt;= Windows 11 Version 26H1 &lt; 10.0.28000.3501</span></p><p><span>10.0.26300.0 &lt;= Windows 11 Version 26H2 &lt; 10.0.26300.9974</span></p><p><span>10.0.14393.0 &lt;= Windows Server 2016 &lt; 10.0.14393.9688</span></p><p><span>10.0.14393.0 &lt;= Windows Server 2016 (Server Core installation) &lt; 10.0.14393.9688</span></p><p><span>10.0.17763.0 &lt;= Windows Server 2019 &lt; 10.0.17763.9487</span></p><p><span>10.0.17763.0 &lt;= Windows Server 2019 (Server Core installation) &lt; 10.0.17763.9487</span></p><p><span>10.0.20348.0 &lt;= Windows Server 2022 &lt; 10.0.20348.5870</span></p><p><span>10.0.26100.0 &lt;= Windows Server 2025 &lt; 10.0.26100.33822</span></p><p><span>10.0.26100.0 &lt;= Windows Server 2025 (Server Core installation) &lt; 10.0.26100.33822</span></p><p><strong><span><span>漏洞类型：</span></span></strong></p><p><span>权限提升</span></p><p><span><strong><span>利用条件：</span></strong></span></p><p><span>1、用户认证：是</span></p><p><span>2、前置条件：目标系统使用 2026 年 11 月累积更新之前的受影响 Windows 版本；攻击者拥有本地低权限账号，且能建立一个可成功连接的拨号/VPN 连接（如自建 PPTP 服务端）</span></p><p><span>3、触发方式：本地</span></p><p><strong><span><span>综合评价：</span></span></strong></p><p><span>利用难度：中等，需本地低权限账号和一个可成功建立的拨号/VPN 连接（如自建 PPTP 服务端），无需 UAC 交互，攻击复杂度低。</span></p><p><span>威胁等级：高危，Microsoft 评定 CVSS 3.1 基础得分 7.8（时间分 6.8），本地低权限用户可提升至 SYSTEM 权限。</span></p><p><strong><span><span>官方解决方案：</span></span></strong></p><p><span>已发布</span></p><p><strong><span>漏洞分析</span></strong></p><p><img src=\"/dailyinfo/media/98fd9d811bef9721.gif\" loading=\"lazy\" decoding=\"async\"></p><p><b><span>组件介绍</span></b></p><p><span>Microsoft Windows（官方名称 Microsoft Windows，由微软公司开发的闭源桌面及服务器操作系统）是全球部署最广泛的操作系统，内置远程访问 API（rasapi32.dll）管理拨号与 VPN 连接，RasMan 服务以 LocalSystem 运行并经 netman 提供网络连接管理接口。Windows 为系统组件，随系统发行。在本次漏洞中，受影响的 Windows 版本在 RAS 挂断路径加载用户电话簿中用户可控的 CustomDialDll，导致本地低权限用户可提升至 SYSTEM 权限。</span></p><p><img src=\"/dailyinfo/media/db6187387c9bfdf8.gif\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>漏洞简介</span></strong></p><p><span>2026年11月24日，深瞳漏洞实验室监测到一则Microsoft Windows组件存在权限提升漏洞的信息，漏洞编号：CVE-2026-119853，漏洞威胁等级：高危。</span></p><p><span>Windows 远程访问 API（rasapi32.dll）存在不可信搜索路径漏洞（CWE-426）。每用户电话簿 rasphone.pbk 中的 CustomDialDll 可由用户任意指定；自定义拨号器的信任校验仅在拨号阶段进行，连接建立后用户即可改写该字段。</span><strong><span><span>挂断时，以 LocalSystem 运行的 RasMan 服务经 netman 调用 rasapi32!DwCustomHangUp，用 LoadLibraryExW 加载用户指定 DLL 并以 SYSTEM 权限调用其 RasCustomHangUp 导出，本地低权限用户可借此以 SYSTEM 权限执行任意代码。</span></span></strong></p><p><img src=\"/dailyinfo/media/f9291d54c457128e.gif\" loading=\"lazy\" decoding=\"async\"></p><p><b><span>漏洞验证</span></b></p><p><span>使用受影响的windows环境复现该漏洞，提权至SYSTEM，效果如下：</span></p><p><img src=\"/dailyinfo/media/dbc7e2429feba010.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>影响范围</span></strong></p><p><span>目前受影响的Microsoft Windows版本：</span><span><br></span><span>10.0.14393.0 &lt;= Windows 10 Version 1607 &lt; 10.0.14393.9688</span></p><p><span>10.0.17763.0 &lt;= Windows 10 Version 1809 &lt; 10.0.17763.9487</span></p><p><span>10.0.19044.0 &lt;= Windows 10 Version 21H2 &lt; 10.0.19044.7846</span></p><p><span>10.0.19045.0 &lt;= Windows 10 Version 22H2 &lt; 10.0.19045.7846</span></p><p><span>10.0.22631.0 &lt;= Windows 11 Version 23H2 &lt; 10.0.22631.7711</span></p><p><span>10.0.26100.0 &lt;= Windows 11 Version 24H2 &lt; 10.0.26100.9974</span></p><p><span>10.0.26200.0 &lt;= Windows 11 Version 25H2 &lt; 10.0.26200.9974</span></p><p><span>10.0.28000.0 &lt;= Windows 11 Version 26H1 &lt; 10.0.28000.3501</span></p><p><span>10.0.26300.0 &lt;= Windows 11 Version 26H2 &lt; 10.0.26300.9974</span></p><p><span>10.0.14393.0 &lt;= Windows Server 2016 &lt; 10.0.14393.9688</span></p><p><span>10.0.14393.0 &lt;= Windows Server 2016 (Server Core installation) &lt; 10.0.14393.9688</span></p><p><span>10.0.17763.0 &lt;= Windows Server 2019 &lt; 10.0.17763.9487</span></p><p><span>10.0.17763.0 &lt;= Windows Server 2019 (Server Core installation) &lt; 10.0.17763.9487</span></p><p><span>10.0.20348.0 &lt;= Windows Server 2022 &lt; 10.0.20348.5870</span></p><p><span>10.0.26100.0 &lt;= Windows Server 2025 &lt; 10.0.26100.33822</span></p><p><span>10.0.26100.0 &lt;= Windows Server 2025 (Server Core installation) &lt; 10.0.26100.33822</span></p><p><strong><span>解决方案</span></strong></p><p><img src=\"/dailyinfo/media/147d66ce2b7c289c.gif\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>官方修复建议</span></strong></p><p><span>通过Windows自动更新或手动安装补丁修复此漏洞修复方式：</span></p><p><span>启用Windows自动更新检测并安装最新安全更新，或手动下载安装对应系统补丁</span></p><p><span>下载链接：<a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-119853\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-119853</a></span></p><p><img src=\"/dailyinfo/media/c4b4e680bd40d476.gif\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span><span>临时修复建议</span></span></strong></p><ul><li><p><span>关闭未使用的功能模块，减少潜在攻击入口。</span></p></li></ul><ul><li><p><span>遵循最小权限原则，严控各类敏感操作权限范围。</span></p></li></ul><ul><li><p><span>非必要不暴露服务到公网，限制访问源为可信范围。</span></p></li></ul><ul><li><p><span>定期更新系统及各类组件至安全版本，及时修补已知隐患。</span></p></li></ul><p><img src=\"/dailyinfo/media/d7e8977990fb8063.gif\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>深信服解决方案</span></strong></p><p><strong><span>漏洞主动检测</span></strong></p><p><span>支持对该漏洞的主动检测，</span><strong><span><span>可批量检出业务场景中该事件的受影响资产情况，</span></span></strong><span>相关产品如下：</span></p><p><strong><span><span>【深信服统一端点安全管理系统aES】</span></span></strong><span>已支持该漏洞检测。</span></p><p><b><span>参考链接</span></b></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-119853\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-119853</a></span></p><p><b><span>时间轴</span></b></p><p><strong><span>2026/11/24</span></strong></p><p><span>深瞳漏洞实验室监测到Microsoft Windows 远程访问 API 自定义拨号器本地权限提升漏洞信息。</span></p><p><strong><span>2026/11/25</span></strong></p><p><span>深瞳漏洞实验室发布漏洞通告。</span></p><p><span>点击</span><strong><span><span>阅读原文</span></span></strong><span>，及时关注并登录深信服</span><strong><span>智安全平台</span></strong><span>，可轻松查询漏洞相关解决方案。</span></p><p><img src=\"/dailyinfo/media/630ef64a2e6366fd.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img src=\"/dailyinfo/media/4c65e6d8533619df.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><a href=\"https://sec.sangfor.com.cn/security-vulnerability/detail?vuln_sfv=SF_2026_47166%5cx26amp;lang=ZH-CN\">阅读原文</a></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=ed92cc0b&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzg2NjgzNjA5NQ%3D%3D%26mid%3D2247526564%26idx%3D2%26sn%3D5a244b62d3003fe55601fe08be69ccaf\">跳转微信打开</a></p>","original","zhKind","complete","漏洞","补丁","复现","漏洞分析","操作系统","Microsoft","深信服","https://mp.weixin.qq.com/s?__biz=Mzg2NjgzNjA5NQ==&mid=2247526564&idx=2&sn=5a244b62d3003fe55601fe08be69ccaf","深信服千里目安全实验室",{"_98":99,"_100":-5},"changelogVersion","2026-10-01T08:00","release"]
