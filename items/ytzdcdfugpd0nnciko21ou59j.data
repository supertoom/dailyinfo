[{"_1":2,"_3":4},"root",{"_5":99},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1794195837000,"id","ytzdcdfugpd0nnciko21ou59j","title","Synology DSM 身份认证绕过漏洞 CVE-2026-13639 已复现并被勒索软件利用","originalTitle","【已复现】Synology DSM 身份认证绕过漏洞(CVE-2026-13639)安全风险通告","summary","Synology DSM 身份认证绕过漏洞 CVE-2026-13639 已被 C3RB3R / L0CK3D 勒索软件用于初始入侵，奇安信 CERT 已完成复现。","reason","文章复现了会话密钥固定漏洞并披露勒索软件已利用该入口，版本范围和缓解措施可供管理员评估处置。","source",{"_75":98},"links",{"_89":97},"publishedAt","2026-11-05T11:48:00.000Z","discoveredAt","2026-11-05T20:02:13.246Z","timelineAt","category","vuln","tags",[92,76,93,94,95,96,83],"score",93,"selected",true,"channel","news","story",{"_85":86,"_13":87},"x","readingMode","full","author","body",{"_61":88,"_89":-5,"_90":89,"_91":37},"outline",[],"relatedStories",[84],"topics",[68,69,70,71,72],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fbovS3aQhnzA","reportCount",2,"additionalSourceCount",1,{"_73":82,"_75":83},{"_73":80,"_75":81},{"_73":78,"_75":79},{"_73":31,"_75":77},{"_73":74,"_75":76},"slug","exploited","name","在野利用","漏洞披露","ransomware","勒索软件","identity","身份与访问","qianxin","奇安信",{"_85":86,"_13":87},"publicId","2949ac1d-5e61-43df-beff-1f3190aa95b7","群晖NAS遭C3RB3R勒索，漏洞已修复","<p><span>奇安信 CERT</span> <span>2026-11-05 19:48</span> <span>江苏</span></p><p><img src=\"/dailyinfo/media/4832e2021f649104.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>致力于第一时间为企业级用户提供权威漏洞情报和有效解决方案。</p><p><span><span>●&nbsp;</span></span><span><span>点击↑蓝字关注我们，获取更多安全风险通告</span></span></p><hr><table><tbody><tr><td colspan=\"4\" align=\"center\"><p><span><strong><span><span>漏洞概述</span></span></strong></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>漏洞名称</span></span></strong></span></p></td><td colspan=\"3\" align=\"left\"><p><span><span>Synology DSM 身份认证绕过漏洞</span></span></p></td></tr><tr><td align=\"left\"><p><span><span><strong><span>漏洞编号</span></strong></span></span></p></td><td colspan=\"3\" align=\"left\"><p><span><span>QVD-2026-70485</span><span>，</span><span>CVE-2026-13639</span></span></p></td></tr><tr><td align=\"left\"><p><strong><span><strong><span><span>公开时间</span></span></strong></span></strong></p></td><td align=\"left\"><p><span><span>2026-09-18</span></span></p></td><td align=\"left\"><p><strong><span><strong><span><span>影响量级</span></span></strong></span></strong></p></td><td align=\"left\"><p><span><span>百万级</span></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>奇安信评级</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>高危</span></span></strong></span></p></td><td align=\"left\"><p><strong><span><span>CVSS 3.1分数</span></span></strong></p></td><td align=\"left\"><p><span><span><strong><span>9.8</span></strong></span></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span>威胁类型</span></strong></span></p></td><td align=\"left\"><p><span><span><span>身份认证绕过</span></span></span></p></td><td align=\"left\"><p><strong><span><span>利用可能性</span></span></strong></p></td><td align=\"left\"><p><strong><span><strong><span>高</span></strong></span></strong></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>POC状态</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>已公开</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>在野利用状态</span></span></strong></span></p></td><td align=\"left\"><p><span><span><span>已发现</span></span></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>EXP状态</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span><span>已公开</span></span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>技术细节状态</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span><span>已公开</span></span></span></strong></span></p></td></tr><tr><td colspan=\"4\" align=\"left\"><p><strong><span><span>危害描述：</span></span></strong><span><span>攻击者无需任何凭据即可伪造会话免密登录任意用户（含管理员），获得管理员会话后可经 File Station / Upload API 实现任意文件读写，写入 Web Shell 或套件后门实现持久化，进而窃取存储数据、横向渗透域内主机，或加密数据实施勒索。该漏洞已被 C3RB3R / L0CK3D 勒索病毒用作初始入口。</span></span></p></td></tr></tbody></table><p><strong><span>0</span></strong><strong><span>1</span></strong></p><p><strong><span>漏洞详情</span></strong></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>影响组件</span></span></strong></p><p><span>Synology DSM（DiskStation Manager）是群晖科技（Synology）为其 NAS 存储设备开发的图形化操作系统，提供文件共享、备份容灾、虚拟化、监控、协作办公等功能，内置 Web 管理界面（WebUI，默认端口 5000/5001），支持 PAM 多因子认证、LDAP/AD 域集成、File Station 文件管理及丰富的套件扩展，广泛应用于企业数据存储与备份场景。</span></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>漏洞描述</span></span></strong></p><p><span>近日，奇安信CERT监测到官方修复<span>Synology DSM 身份认证绕过漏洞(CVE-2026-13639)</span>，该漏洞源于 DSM 在生成会话 JWT 签名密钥时存在缓冲区错位缺陷：随机数生成函数 randombytes_buf 的输出被写入全局缓存，而实际写入密钥文件的却是刚被清零的 32 字节栈缓冲区，导致签名密钥固定为 32 个 0x00 字节，等同于硬编码常量密钥（熵为零）。攻击者无需任何凭据，即可使用全零密钥伪造 aud=\"2FA\" 的 1FA 临时令牌 JWT，并将其作为 passwd 参数提交登录接口，从而完全绕过密码与二次认证校验，免密登录任意用户（包括管理员），进一步通过 File Station 等接口实现任意文件读写、植入恶意载荷并接管设备。<span>目前该漏洞PoC和技术细节已公开。</span></span><span><span>鉴于该漏洞已发现在野利用，建议客户尽快做好自查及防护。</span></span></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>利用条件</span></span></strong></p><p><span><span>无需凭据、无需用户交互；仅需能够访问 DSM Web 管理端口（5000/5001 或自定义端口），且目标设备会话密钥由缺陷代码路径生成（默认情况）。</span></span></p><p><strong><span>02</span></strong></p><p><strong><span>影响范围</span></strong></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>影响版本</span></span></strong></p><p><span>DSM 7.4 &lt; 7.4-90075</span></p><p><span>DSM 7.3.2 &lt; 7.3.2-86009-4</span></p><p><span>DSM 7.2.2 &lt; 7.2.2-72806-9</span></p><p><span>DSM 7.2.1 &lt; 7.2.1-69057-12</span></p><p><span>DSM 7.2.2 基础镜像不预置会话密钥，全新安装首次登录即经缺陷路径创建全零密钥。</span></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>其他受影响组件</span></span></strong></p><p><span><span>无</span></span></p><p><strong><span>03</span></strong></p><p><strong><span>复现情况</span></strong></p><p><span><span>目前，</span><span>奇安信CERT已成功复现</span><span><span>Synology DSM 身份认证绕过漏洞(CVE-2026-13639)</span></span><span>，截图如下：</span></span></p><p><img src=\"/dailyinfo/media/7ae7d12ccf3e3889.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>04</span></strong></p><p><strong><span>处置建议</span></strong></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>安全更新</span></span></strong></p><p><span>官方已发布安全补丁，请及时更新至最新版本：</span></p><p><span>DSM 7.2.2 &gt;= 7.2.2-72806-9</span></p><p><span>DSM 7.2.1 &gt;= 7.2.1-69057-12</span></p><p><span>DSM 7.3.2 &gt;= 7.3.2-86009-4</span></p><p><span>DSM 7.4 &gt;= 7.4-90075</span></p><p><span>下载地址：</span></p><p><span><a href=\"https://www.synology.com/en-us/security/advisory/Synology_SA_26_13\">https://www.synology.com/en-us/security/advisory/Synology_SA_26_13</a></span></p><p><span><span>临时缓解措施：</span></span></p><p><span>1. 禁止管理界面暴露于互联网：关闭路由器上 5000/5001 端口映射，DSM 管理界面仅限内网或经 VPN / 零信任网关访问；启用 DSM 防火墙，限制来源 IP。</span></p><p><span>2. 启用并强制双因子认证：为全部账户（尤其是 administrators 组成员）启用 2FA。注意：该漏洞的核心是临时令牌校验被绕过，2FA 仅能提高后续利用门槛（pam_syno_otp.so 环节），不能替代补丁。</span></p><p><strong><span>05</span></strong></p><p><strong><span>参考资料</span></strong></p><p><span><span>[1]</span><span><a href=\"https://www.synology.com/en-us/security/advisory/Synology_SA_26_13\">https://www.synology.com/en-us/security/advisory/Synology_SA_26_13</a></span></span></p><p><span><span>[2]</span><span><a href=\"https://github.com/sgInnora/innora-cve-research/blob/main/CVE-2026-13639/README.zh-CN.md\">https://github.com/sgInnora/innora-cve-research/blob/main/CVE-2026-13639/README.zh-CN.md</a></span></span></p><p><span><span>[3]<a href=\"https://x.com/watchcatcyber/status/2115390974604312626\">https://x.com/watchcatcyber/status/2115390974604312626</a></span></span></p><p><strong><span>06</span></strong></p><p><strong><span>时间线</span></strong></p><p><span><span>2026年11月05日，奇安信 CERT发布安全风险通告。</span></span></p><p><strong><span>07</span></strong></p><p><strong><span>漏洞情报服务</span></strong></p><p><span><span>「</span><span>奇安信漏洞情报平台</span><span>」</span><span>重磅上线，诚邀您来体验：</span></span></p><p><img alt=\"图片\" src=\"/dailyinfo/media/1bfaaf1730a37827.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img alt=\"图片\" src=\"/dailyinfo/media/90f0a57d70cc9376.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img alt=\"图片\" title=\"CERT LOGO.png\" width=\"100%\" src=\"/dailyinfo/media/f404b6132e3ed76b.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><strong><span>奇安信 CERT</span></strong></span></p><p><span><strong><span><span>致力于</span></span></strong><span><span>第一时间为企业级用户提供</span><strong><span><span>权威</span></span></strong><span>漏洞情报和</span></span><strong><span><span>有效</span></span></strong><span><span>解决方案。</span></span></span></p><p><span><span><span>点击↓</span><strong><span><span>阅读原文</span></span></strong><span>，到</span></span><strong><span><span>ALPHA威胁分析平台</span></span></strong><span><span>订阅更多漏洞信息。</span></span></span></p><p><a href=\"https://ti.qianxin.com/portal/subscription\">阅读原文</a></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=1e74733e&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzU5NDgxODU1MQ%3D%3D%26mid%3D2247508031%26idx%3D1%26sn%3Dbe47d2b6316db564dc261a0d5a42bcd1\">跳转微信打开</a></p>","original","zhKind","complete","漏洞","复现","漏洞利用","勒索","凭据","https://mp.weixin.qq.com/s?__biz=MzU5NDgxODU1MQ==&mid=2247508031&idx=1&sn=be47d2b6316db564dc261a0d5a42bcd1","奇安信 CERT",{"_100":101,"_102":-5},"changelogVersion","2026-10-01T08:00","release"]
