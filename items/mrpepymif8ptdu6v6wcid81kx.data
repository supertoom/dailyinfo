[{"_1":2,"_3":4},"root",{"_5":90},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1794616831000,"id","mrpepymif8ptdu6v6wcid81kx","title","LXD 镜像 URL 导入功能存在 SSRF，可探测内部网络","originalTitle","LXD: SSRF via image import from URL allows internal network probing by authenticated users","summary","LXD 的 POST /1.0/images 镜像 URL 导入功能存在 SSRF，具备 can_create_images 权限的用户可让守护进程请求回环地址、RFC1918 私网及 169.254.169.254 等云元数据端点。","reason","文章还原了 LXD 导入镜像时的 SSRF 调用链、错误差异与链式跳转机制，并给出网络层和入口层修复方案。","source",{"_71":89},"links",{"_60":88},"publishedAt","2026-11-06T18:29:18.000Z","discoveredAt","2026-11-07T00:26:30.986Z","timelineAt","category","vuln","tags",[81,82,83,84,85,86,87],"score",72,"selected",true,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[67,68,69],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fW-v3biLYJa4","reportCount",1,"additionalSourceCount",0,{"_70":75,"_71":76},{"_70":73,"_71":74},{"_70":31,"_71":72},"slug","name","漏洞披露","cloud-native","云与原生","ubuntu","Ubuntu / Canonical",{"_78":79,"_13":80},"publicId","bac321ae-3311-440b-a582-7e704f5ece58","LXD镜像URL导入存在SSRF漏洞","漏洞","复现","漏洞利用","网络设备","云原生","容器","Ubuntu","https://github.com/advisories/GHSA-3gq2-x4qg-p4g6","GitHub 安全公告",{"_91":92,"_93":-5},"changelogVersion","2026-10-01T08:00","release"]
