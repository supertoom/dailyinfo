[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1795653651000,"id","wihu6e4vsmw0dqjqkeoi0z2ry","title","Cisco UCS 及相关设备披露 UEFI Shell Secure Boot 绕过漏洞","originalTitle","Cisco UCS and UCS-Based Appliances UEFI Shell Secure Boot Bypass Vulnerability","summary","Cisco 披露 UCS 及基于 UCS 的设备存在 UEFI Shell Secure Boot 绕过漏洞，并按服务器产品线、管理模式及设备类型列出首个修复版本。","reason","source",{"_71":96},"links",{"_60":95},"publishedAt","2026-11-25T10:29:45.000Z","discoveredAt","2026-11-25T19:27:20.900Z","timelineAt","category","vuln","tags",[91,92,93,94],"score",49,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body",{"_87":-5,"_60":88,"_89":-5,"_90":36},"outline",[81],"relatedStories",[77],"topics",[67,68,69],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fXs9jGHDAo5g","reportCount",1,"additionalSourceCount",0,{"_70":75,"_71":76},{"_70":73,"_71":74},{"_70":30,"_71":72},"slug","name","漏洞披露","kernel","内核与系统","cisco","Cisco / 思科",{"_78":79,"_13":80},"publicId","2ad9a954-47f3-4454-b009-1f91a3d253cd","Cisco披露UCS安全启动绕过漏洞",{"_11":82,"_83":84,"_85":86},"sec-1","text","Fixed Releases","level",3,"zh","<ul>\n<li>\n<p>Cisco considers any workarounds and mitigations (if applicable) to be temporary solutions until an upgrade to a fixed software release is available. To remediate this vulnerability and avoid future exposure as described in this advisory, Cisco strongly recommends that customers upgrade to the fixed software indicated in this advisory.</p>\n\n\n<h3 id=\"sec-1\">Fixed Releases</h3>\n<p>In the following tables, the left column lists Cisco software releases. The right column indicates whether a release is affected by the vulnerability that is described in this advisory and the first release that includes the fix for this vulnerability. Customers are advised to upgrade to an appropriate <a href=\"https://sec.cloudapps.cisco.com/security/center/resources/security_vulnerability_policy.html#fixes\">fixed software release</a> as indicated in this section.</p>\n<p><strong>5000 Series ENCS</strong></p>\n<p><strong>Note:</strong> Upgrading Cisco Integrated Management Controller (IMC) and BIOS on Cisco 5000 Series ENCS requires upgrading Cisco Enterprise NFV Infrastructure Software (NFVIS) on the platforms. Cisco IMC and BIOS are upgraded as part of the firmware auto-upgrade process.</p>\n<table>\n<thead>\n<tr>\n<th>Cisco NFVIS Release</th>\n<th>First Fixed Release</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Earlier than 4.12</td>\n<td>Migrate to a fixed release.</td>\n</tr>\n<tr>\n<td>4.12</td>\n<td>4.12.9 (Jan 2027)</td>\n</tr>\n<tr>\n<td>4.13</td>\n<td>Migrate to a fixed release.</td>\n</tr>\n<tr>\n<td>4.14</td>\n<td>Migrate to a fixed release.</td>\n</tr>\n<tr>\n<td>4.15</td>\n<td>4.15.7 (Dec 2026)</td>\n</tr>\n</tbody>\n</table>\n<p><strong>UCS B-Series M5 Servers in UCS Manager Mode</strong></p>\n<table>\n<thead>\n<tr>\n<th>Cisco UCS Server Software Release</th>\n<th>First Fixed Release</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Earlier than 4.3</td>\n<td>Migrate to a fixed release.</td>\n</tr>\n<tr>\n<td>4.3</td>\n<td>4.3(6k)</td>\n</tr>\n<tr>\n<td>6.0</td>\n<td>6.0(2e)</td>\n</tr>\n</tbody>\n</table>\n<p><strong>UCS B-Series M6 and X-Series Servers in UCS Manager Mode</strong></p>\n<table>\n<thead>\n<tr>\n<th>Cisco UCS Server Software Release</th>\n<th>First Fixed Release</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Earlier than 4.3</td>\n<td>Migrate to a fixed release.</td>\n</tr>\n<tr>\n<td>4.3</td>\n<td>4.3(6h)</td>\n</tr>\n<tr>\n<td>6.0</td>\n<td>6.0(2d)</td>\n</tr>\n</tbody>\n</table>\n<p><strong>UCS B-Series M5 Servers in Intersight Managed Mode</strong></p>\n<table>\n<thead>\n<tr>\n<th>Cisco Intersight Server Firmware Release</th>\n<th>First Fixed Release</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Earlier than 5.4</td>\n<td>Migrate to a fixed release.</td>\n</tr>\n<tr>\n<td>5.4</td>\n<td>5.4(0.260088)</td>\n</tr>\n<tr>\n<td>6.0</td>\n<td>6.0(1.260031)</td>\n</tr>\n</tbody>\n</table>\n<p><strong>UCS B-Series M6 Servers in Intersight Managed Mode</strong></p>\n<table>\n<thead>\n<tr>\n<th>Cisco Intersight Server Firmware Release</th>\n<th>First Fixed Release</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Earlier than 5.4</td>\n<td>Migrate to a fixed release.</td>\n</tr>\n<tr>\n<td>5.4</td>\n<td>5.4(0.260050)</td>\n</tr>\n<tr>\n<td>6.0</td>\n<td>6.0(2.260143)</td>\n</tr>\n</tbody>\n</table>\n<p><strong>UCS X-Series Servers in Intersight Managed Mode</strong></p>\n<table>\n<thead>\n<tr>\n<th>Cisco Intersight Server Firmware Release</th>\n<th>First Fixed Release</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Earlier than 5.4</td>\n<td>Migrate to a fixed release.</td>\n</tr>\n<tr>\n<td>5.4</td>\n<td>5.4(0.260042)</td>\n</tr>\n<tr>\n<td>6.0</td>\n<td>6.0(2.260143)</td>\n</tr>\n</tbody>\n</table>\n<p><strong>UCS C845A M8 Rack Server</strong></p>\n<table>\n<thead>\n<tr>\n<th>Cisco UCS Server Software Release</th>\n<th>First Fixed Release</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>2.0</td>\n<td>2.0(2.260113)</td>\n</tr>\n</tbody>\n</table>\n<p><strong>UCS C880A M8 Rack Server</strong></p>\n<table>\n<thead>\n<tr>\n<th>Cisco UCS Server Software Release</th>\n<th>First Fixed Release</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>4.0</td>\n<td>4.0(2.260004)</td>\n</tr>\n</tbody>\n</table>\n<p><strong>UCS C885A M8 Rack Server</strong></p>\n<table>\n<thead>\n<tr>\n<th>Cisco UCS Server Software Release</th>\n<th>First Fixed Release</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1.2 and earlier</td>\n<td>1.3(0.260031)</td>\n</tr>\n</tbody>\n</table>\n<p><strong>UCS C-Series M5 Rack Servers in Standalone Mode or Intersight Managed Mode<br></strong></p>\n<table>\n<thead>\n<tr>\n<th>Cisco UCS Server Software Release</th>\n<th>First Fixed Release</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Earlier than 4.2</td>\n<td>Migrate to a fixed release.</td>\n</tr>\n<tr>\n<td>4.2</td>\n<td>4.2(3r)</td>\n</tr>\n<tr>\n<td>4.3</td>\n<td>4.3(2.260020)</td>\n</tr>\n</tbody>\n</table>\n<p><strong>UCS C-Series M6, M7, M8 Rack Servers in Standalone Mode or Intersight Managed Mode<br></strong></p>\n<table>\n<thead>\n<tr>\n<th>Cisco UCS Server Software Release</th>\n<th>First Fixed Release</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Earlier than 4.2</td>\n<td>Migrate to a fixed release.</td>\n</tr>\n<tr>\n<td>4.2</td>\n<td>4.2(3r)</td>\n</tr>\n<tr>\n<td>4.3</td>\n<td>4.3(6.260054)</td>\n</tr>\n<tr>\n<td>6.0</td>\n<td>6.0(2.260143)<sup>1</sup></td>\n</tr>\n</tbody>\n</table>\n<p>1. The fixed <a href=\"https://www.cisco.com/c/en/us/td/docs/unified_computing/ucs/release/firmware_files/6_0/b-cisco-ucs-rack-servers-firmware-files--release-6-0-new/m-firmware-files-6-0-2.html#_963e1220-2434-426f-8872-9969de4afa51__6.0.2.260143\">6.0(2.260143) Host Upgrade Utility (HUU) ISO release</a> includes the Cisco IMC 6.0(2.260094) packaged release. After upgrading to this fixed release, the Cisco IMC UI <strong>Dashboard</strong> page will display the <strong>Firmware Version</strong> as 6.0(2.260094). The <strong>Last HSU bundle used</strong> field under <strong>Administration &gt; Firmware Management</strong> will display the fixed 6.0(2.260143) release.</p>\n<p><strong>UCS C-Series M5 Rack Servers in UCS Manager Mode<br></strong></p>\n<table>\n<thead>\n<tr>\n<th>Cisco UCS Server Software Release</th>\n<th>First Fixed Release</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Earlier than 4.2</td>\n<td>Migrate to a fixed release.</td>\n</tr>\n<tr>\n<td>4.2</td>\n<td>4.2(3s)</td>\n</tr>\n<tr>\n<td>4.3</td>\n<td>4.3(6k)</td>\n</tr>\n<tr>\n<td>6.0</td>\n<td>6.0(2e)</td>\n</tr>\n</tbody>\n</table>\n<p><strong>UCS C-Series M6, M7, M8 Rack Servers in UCS Manager Mode<br></strong></p>\n<table>\n<thead>\n<tr>\n<th>Cisco UCS Server Software Release</th>\n<th>First Fixed Release</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Earlier than 4.2</td>\n<td>Migrate to a fixed release.</td>\n</tr>\n<tr>\n<td>4.2</td>\n<td>4.2(3s)</td>\n</tr>\n<tr>\n<td>4.3</td>\n<td>4.3(6h)</td>\n</tr>\n<tr>\n<td>6.0</td>\n<td>6.0(2d)</td>\n</tr>\n</tbody>\n</table>\n<p><strong>UCS E-Series M3 Servers</strong></p>\n<table>\n<thead>\n<tr>\n<th>Cisco UCSE BIOS Release</th>\n<th>First Fixed Release</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>4.0 and earlier</td>\n<td>4.04<sup>1</sup></td>\n</tr>\n</tbody>\n</table>\n<p>1. The fixed 4.04 BIOS release can be installed on UCS E-Series M3 Servers that are running any Cisco IMC 3.2 release using the steps in the <a href=\"https://www.cisco.com/c/en/us/td/docs/unified_computing/ucs/e/3-2-1/sw/gui/config/guide/b_Cisco_UCS_E-series_GUI_Configuration_Guide_32x/b_Cisco_UCS_E-series_GUI_Configuration_Guide_321_chapter_01110.html#task_C137961E9E8A4927A1F08740184594CA\">Managing Firmware</a> section of the <em>Cisco UCS E-Series Integrated Management Controller GUI Configuration Guide</em>.</p>\n<p><strong>UCS E-Series M6 Servers</strong></p>\n<table>\n<thead>\n<tr>\n<th>Cisco UCSE Software Release</th>\n<th>First Fixed Release</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>4.15 and earlier</td>\n<td>4.15.4b<sup>1</sup></td>\n</tr>\n</tbody>\n</table>\n<p>1. The fixed 4.15.4-b Host Upgrade Utility (HUU) ISO release includes the fixed 2.06 BIOS release.</p>\n<p><strong>UCS S-Series Storage Server</strong></p>\n<table>\n<thead>\n<tr>\n<th>Cisco UCS Server Software Release</th>\n<th>First Fixed Release</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Earlier than 4.3</td>\n<td>Migrate to a fixed release.</td>\n</tr>\n<tr>\n<td>4.3</td>\n<td>4.3(6.260054)</td>\n</tr>\n</tbody>\n</table>\n<p><strong>Unified Edge</strong></p>\n<table>\n<thead>\n<tr>\n<th>Cisco UCS XE-Series Server Firmware Release</th>\n<th>First Fixed Release</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>6.0</td>\n<td>6.0(2.260143)</td>\n</tr>\n</tbody>\n</table>\n<p><strong>Note:</strong> For Cisco appliances that are based on a preconfigured version of a Cisco UCS C-Series Server, administrators can perform a direct upgrade of the Cisco IMC and BIOS software using one of the fixed releases mentioned in the preceding tables. For instructions, see the <a href=\"https://www.cisco.com/c/en/us/td/docs/unified_computing/ucs/c/sw/lomug/4-2/b_cisco-host-upgrade-utility-user-guide-4-2/m_upgrading-the-firmware.html\">Cisco Host Upgrade Utility User Guide</a>. The exceptions are the appliances that are listed in the following table. For these appliances, follow the instructions in the <strong>Remediation</strong> column:</p>\n<table>\n<thead>\n<tr>\n<th>Cisco Hardware Platform</th>\n<th>First Fixed Firmware Release</th>\n<th>Remediation</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Cisco Telemetry Broker Appliances</td>\n<td>6.0(2.260143)<sup>1</sup></td>\n<td>Install the firmware update <a href=\"https://www.cisco.com/c/dam/en/us/td/docs/security/Telemetry_Broker/Release-Notes/m6-tb2300-ctb-firmware-6_0-2_260143_iso_DV_1_0.pdf\">CTB-FIRMWARE-6.0.2.260143-M6.iso</a>.</td>\n</tr>\n<tr>\n<td>IEC6400 Edge Compute Appliances</td>\n<td>4.3(6.260054)</td>\n<td>Apply the HUU upgrade using <a href=\"https://software.cisco.com/download/home/286331621/type/286331613/release/HUU%204.3.6-260054\">IEC6400-HUU-4.3.6-260054.img</a>.</td>\n</tr>\n<tr>\n<td>IOS XRv 9000 M7 Appliances</td>\n<td>6.0(2.260143)<sup>1</sup></td>\n<td>Install the firmware update package <a href=\"https://www.cisco.com/c/en/us/td/docs/routers/virtual-routers/configuration/guide/b-xrv9k-cg/b-xrv9k-cg_chapter_01010.html#firmware-management\">xrv9k-ucs-c220m7-huu-container-6.0.2.260143.tar.gz.</a></td>\n</tr>\n<tr>\n<td>Secure Email Gateways</td>\n<td>4.2(3r)</td>\n<td>Install the firmware update package (Dec 2026).</td>\n</tr>\n<tr>\n<td>Secure Email and Web Manager</td>\n<td>4.2(3r)</td>\n<td>Install the firmware update package (Dec 2026).</td>\n</tr>\n<tr>\n<td>Secure Endpoint Private Cloud Appliances</td>\n<td>4.3(2.260020) (M5)<br>4.3(6.260054) (M6)</td>\n<td>Follow the steps documented in the <a href=\"https://www.cisco.com/c/en/us/support/docs/security/secure-endpoint-private-cloud/222008-cisco-secure-endpoint-private-cloud-firm.html\">TechNote</a>.</td>\n</tr>\n<tr>\n<td>Secure Firewall Management Center (FMC) Appliances</td>\n<td>4.3(2.260020) (M5)<br>6.0(2.260143)<sup>1</sup> (M6, M8)</td>\n<td>Apply the Hotfix <a href=\"https://www.cisco.com/c/en/us/td/docs/security/secure-firewall/release-notes/threat-defense/hotfix/threat-defense-release-notes-hotfix.html#Cisco_Reference.dita_e5a104de-579f-48b7-adb6-0a72dc5183b7\">GA</a>.</td>\n</tr>\n<tr>\n<td>Secure Malware Analytics Appliances</td>\n<td>4.3(2.260020) (M5)<br>4.3(6.260054) (M6)</td>\n<td>Update the firmware using the <a href=\"https://www.cisco.com/c/en/us/td/docs/security/secure-malware-analytics/admin-guide/b_out-of-band-firmware/m_out-of-band-firmware-update.html\">Out-of-Band Firmware Update ISO</a> procedure.</td>\n</tr>\n<tr>\n<td>Secure Network Analytics Appliances</td>\n<td>4.3(2.260020) (M5)<br>6.0(2.260143)<sup>1</sup> (M6)</td>\n<td>For M5, install the firmware update <a href=\"https://www.cisco.com/c/dam/en/us/td/docs/security/stealthwatch/cimc_bios/M5_CIMC_FIRMWARE_4_3_2_260020_readme_DV_1_0.pdf\">patch-common-SNA-FIRMWARE-4.3.2.260020-M5-v2-01.swu</a>.<br>For M6, install the firmware update <a href=\"https://www.cisco.com/c/dam/en/us/td/docs/security/stealthwatch/cimc_bios/M6_CIMC_FIRMWARE_6_0_2_260143_readme_DV_1_0.pdf\">patch-common-SNA-FIRMWARE-6.0.2260143-M6-v2-01.swu</a>.</td>\n</tr>\n<tr>\n<td>Secure Network Server (ISE SNS) Appliances</td>\n<td>4.3(2.260020) (M5)<br>6.0(2.260143)<sup>1</sup> (M6, M8)</td>\n<td>Apply the BIOS and HUU upgrade, as documented in Firmware Upgrade Guide for <a href=\"https://www.cisco.com/c/en/us/td/docs/security/ise/sns3600hig/sns-36xx-firmware-4-x-xx_upgrade_guide.html#Cisco_Concept.dita_3e2c957e-62e6-4b2d-9f76-96ad121f29e1\">Cisco Secure Network Server 3600 Series</a>, <a href=\"https://www.cisco.com/c/en/us/td/docs/security/ise/sns3700hig/sns-37xx-firmware-4-x-xx_upgrade_guide.html#r_overview\">Cisco Secure Network Server 3700 Series</a>, or <a href=\"https://www.cisco.com/c/en/us/td/docs/security/ise/sns3800hig/sns-38xx-firmware-4-x-xx_upgrade_guide.html#r_overview\">Cisco Secure Network Server 3800 Series</a>.</td>\n</tr>\n<tr>\n<td>Secure Web Appliances</td>\n<td>4.2(3r) (M5)<br>4.3(6.260054) (M6)</td>\n<td>Install the firmware update package (Dec 2026).</td>\n</tr>\n</tbody>\n</table>\n<p>1. The fixed 6.0(2.260143) firmware release includes the Cisco IMC 6.0(2.260094) packaged release. After upgrading to this fixed release, the Cisco IMC UI <strong>Dashboard</strong> page will display the <strong>Firmware Version</strong> as 6.0(2.260094). The <strong>Last HSU bundle used</strong> field under <strong>Administration &gt; Firmware Management</strong> may display the fixed 6.0(2.260143) release or <strong>N/A</strong>, depending on the specific appliance and remediation used.</p>\n<p>The Cisco Product Security Incident Response Team (PSIRT) validates only the affected and fixed release information that is documented in this advisory.</p>\n\n</li>\n</ul>","zhKind","complete","漏洞","补丁","Cisco","操作系统","https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-ucs-uefi-sb-bypass-eb6xC5GW?vs_f=Cisco%20Security%20Advisory%26vs_cat=Security%20Intelligence%26vs_type=RSS%26vs_p=Cisco%20UCS%20and%20UCS-Based%20Appliances%20UEFI%20Shell%20Secure%20Boot%20Bypass%20Vulnerability%26vs_k=1","Cisco PSIRT",{"_98":99,"_100":-5},"changelogVersion","2026-10-01T08:00","release"]
