[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794616829000,"id","j93urv2xb8cpls1ifxjrc7w5y","title","OpenSSH SSHole 漏洞 CVE-2026-123158 已被在野利用以入侵 Linux 系统","originalTitle","Hackers exploit SSHole OpenSSH flaw to breach Linux systems","summary","攻击者正在利用 OpenSSH 的 SSHole 漏洞 CVE-2026-123158，绕过部分 musl-based Linux 系统上的身份验证并执行命令、窃取凭据和植入持久化访问。","reason","多家机构记录了 SSHole 的真实利用链及攻击后行为，文中同时给出了修复版本与排查指标，便于管理员判断风险并核查受影响系统。","source",{"_73":97},"links",{"_88":96},"publishedAt","2026-11-09T16:04:57.000Z","discoveredAt","2026-11-09T17:35:17.490Z","timelineAt","category","vuln","tags",[92,74,93,94,95],"score",78,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","Bill Toulas","body",{"_61":87,"_88":-5,"_89":90,"_91":37},"outline",[82],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fMq6ulkndSSs","reportCount",2,"additionalSourceCount",1,{"_71":76,"_73":77},{"_71":31,"_73":75},{"_71":72,"_73":74},"slug","exploited","name","在野利用","漏洞披露","identity","身份与访问",{"_79":80,"_13":81},"publicId","38ffbd45-36e1-4425-910b-1ffc0ab5c062","SSHole漏洞已被用于入侵Linux",{"_11":83,"_84":85,"_86":65},"sec-1","text","发现现有防御可能遗漏的电子邮件威胁。","level","<p><img alt=\"Hackers exploit SSHole OpenSSH flaw to breach Linux systems\" height=\"900\" src=\"/dailyinfo/media/e1326f87478aaee5.jpg\" srcset=\"/dailyinfo/media/99539364f275ff6f.jpg 720w, /dailyinfo/media/025ab8757c0b9ba9.jpg 1200w, /dailyinfo/media/e1326f87478aaee5.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>黑客正在积极利用 OpenSSH 中的“SSHole”漏洞（CVE-2026-123158），以执行命令、窃取凭据并建立持久化访问。</p><p>多家网络安全公司已确认这些攻击，并报告称利用尝试始于 11 月 5 日，即概念验证利用代码发布的当天，次日已有成功利用的记录。</p><p>该漏洞由安全研究员 <a href=\"https://www.bleepingcomputer.com/news/security/openssh-flaw-lets-attackers-log-into-password-disabled-linux-accounts/\">Ozgun Kultekin</a> 于上周披露。SSHole 可绕过运行在某些基于 <em>musl</em> 的 Linux 系统上的 OpenSSH 的身份验证，其中包括用于云端和虚拟环境的轻量级 Alpine 发行版。</p><p><a href=\"https://www.wiz.io/lp/securing-ai-agents-101?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY26Q3_INB_FORM_Securing-AI-Agents-101&amp;sfcid=701Py00000RTEWMIA5&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AI-Agents-101\"><img src=\"/dailyinfo/media/f55e10e3db4728a2.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>该缺陷使攻击者能够登录到密码哈希设置为星号 (*) 以阻止密码登录的账户。</p><p>过大的密码会导致 musl 的密码哈希函数在出错时返回 *，而 OpenSSH 会错误地将其视为与账户存储值匹配。</p><p>Kultekin 解释道，利用该漏洞需要特定的身份验证设置，不会影响拥有有效密码哈希的账户，并且当被盗账户具有无密码管理员权限时，可能导致获得 root 访问权限。</p><p>OpenSSH 维护者已在 11 月 5 日发布的 10.6p2 版本中修复了该漏洞，而利用代码约在四小时后公开。</p><p>芬兰安全公司 <a href=\"https://x.com/DefusedCyber/status/2118996075092521197\">Defused said</a> 在周末表示，其观察到“少量参与者”试图利用 SSHole，尽管此类活动并不广泛。</p><p><img alt=\"Tweet\" height=\"450\" src=\"/dailyinfo/media/9d1b1076bd90c412.webp\" loading=\"lazy\" decoding=\"async\" width=\"500\"></p><p>威胁情报公司 <a href=\"http://sshole.events.greynoise.io/\">GreyNoise&nbsp;recorded</a> 记录到 11 月 7 日 00:46 UTC 首次在野成功利用 SSHole，比修复时间晚约 40 小时。</p><p>研究人员记录了 16 条成功的利用链，目标是由 GreyNoise 保护的网络，来源为六个与利用后活动相关的源 IP 地址。该公司表示，这些攻击并不能代表涉及 SSHole 的更广泛活动。</p><p>在 GreyNoise 观察到的攻击中，威胁行为者进行了系统和容器侦察，发起对云元数据服务的查询，尝试读取密码哈希和 root SSH 密钥，并试图修改 SSH 的“authorized_keys”文件以获得持久化访问。</p><p>其中一名攻击者获得了 root 权限并安装了 TAC Agent，这是一个 Python 命令与控制代理。然而，该植入程序无法连接其命令与控制（C2）服务器“tac.vpnla[.]org”，因此从未接收到任务。</p><figure><img src=\"/dailyinfo/media/2a1dd4276efdd07c.webp\" srcset=\"/dailyinfo/media/7c2524b6938c047e.webp 720w, /dailyinfo/media/2a30aeb5463994fa.webp 1200w, /dailyinfo/media/2a1dd4276efdd07c.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"TAC Agent and C2 exchange\" height=\"347\" width=\"900\">\n<figcaption><strong>TAC Agent 与 C2 通信</strong><br>\n<em>来源：GreyNoise</em></figcaption>\n</figure><p>对 TAC Agent 载荷的分析显示，该植入程序支持执行 shell 命令、大量系统侦察、文件上传/下载操作，并且能够自我更新。</p><p>该代理没有内置的持久化机制，因此攻击者尝试通过配置启动服务来确保其留存。</p><p>GreyNoise 指出，该植入程序的注释、日志和错误信息均为中文，这可能会与其他证据结合使用，以确定攻击者的来源。</p><p>一项表明其可能由自动化操作完成的发现是缺失的工具检查会返回反馈信息，可帮助自动化规划器根据需要修改命令，以使攻击继续进行。</p><p>总体而言，GreyNoise 记录到了 2750 万次端口 22 扫描和 2010 万次 SSH 会话尝试，但这些并未被确认为 SSHole 攻击。</p><p>网络安全公司 <a href=\"https://previdian.com/CVE-2026-123158#evidence\">Previdian 也确认</a>已成功利用 SSHole，遥测数据显示，来自九个国家的 13 个攻击者 IP 地址发起了 20 次尝试。</p><p>进攻性安全公司 <a href=\"https://x.com/watchtowrcyber/status/2118636513739317525\">watchTower 表示</a>，11 月 6 日，其观察到 SSHole 被利用于与僵尸网络和加密货币挖矿活动相关的攻击中。</p><p>系统管理员应尽快更新 OpenSSH，或禁用受 SSHole 影响系统上的 SSH 密码认证。</p><p>还建议检查是否存在意外的密码登录成功记录，其账户的 /etc/shadow 密码字段为 *，以及未经授权的 SSH 密钥、TAC Agent 文件或启动服务。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/c132e890d608eb09.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 代理会分析电子邮件意图、上下文和行为，以发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>进行为期 14 天的只读扫描，了解哪些内容能够穿过 Microsoft 365 或 Google Workspace 的防线，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始免费的电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","漏洞","补丁","漏洞利用","凭据","https://www.bleepingcomputer.com/news/security/hackers-exploit-sshole-openssh-flaw-to-breach-linux-systems/","BleepingComputer",{"_99":100,"_101":-5},"changelogVersion","2026-10-01T08:00","release"]
