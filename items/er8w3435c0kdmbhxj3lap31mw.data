[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795567279000,"id","er8w3435c0kdmbhxj3lap31mw","title","BabidiGhost 借助越狱 AI 代理攻击欧洲多行业机构并窃取 8.6 GB 档案","originalTitle","不是零日，也不是高手：一个低技能操作者的AI代理入侵实录","summary","BabidiGhost 借助越狱 Hermes AI 代理，在 2026 年 11 月 6 日至 14 日针对比利时、法国和瑞士的银行、保险、支付及公共机构等超过 50 个组织与数据集开展攻击，14 个重点对象中 2 个被入侵、3 个部分被入侵、4 个抵御成功、5 个仅遭侦察。","reason","复盘展示 AI 代理如何放大已知漏洞、暴露凭据和弱口令造成的风险，并给出可复用的处置与检测重点。","source",{"_74":96},"links",{"_87":95},"publishedAt","2026-11-24T03:56:00.000Z","discoveredAt","2026-11-24T13:52:33.313Z","timelineAt","category","activity","tags",[77,75,90,91,79,92,93,94],"score",88,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","body",{"_61":86,"_87":-5,"_88":87,"_89":37},"outline",[],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fZ6J-Ef4kgGg","reportCount",2,"additionalSourceCount",1,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","malware","name","恶意软件","attack","攻击活动","ai-offense","AI 攻防","identity","身份与访问",{"_83":84,"_13":85},"publicId","12ec43eb-d439-489e-8c4a-0842054ea06f","BabidiGhost越狱AI智能体攻击欧洲机构","<p>原创 <span>威胁情报中心</span> <span>2026-11-24 11:56</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/85e4b5c76ea0343f.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>威胁情报 · AI 代理 · 入侵复盘</span></span></p><p><span>不是零日，也不是高手：</span></p><p><span>一个低技能操作者的AI代理入侵实录</span></p><p><span>BabidiGhost借助越狱AI代理在九天内实施多目标攻击、窃取客户数据及8.6 GB公共机构档案。AI虽能显著降低攻击的技术执行成本，但入侵成败仍取决于漏洞修补、凭据管理、MFA等基础安全控制。</span></p><p><span>· BabidiGhost　· 越狱 AI 代理　· 欧洲金融与公共机构　· 2026.11.24</span></p><p><span>2026 年 11 月，一名法语操作者借助越狱 AI 代理，对欧洲银行、保险、支付机构和市政组织发起了持续九天的攻击。真正进入系统的并非零日漏洞，而是未修补的 Metabase、可被读取的数据库凭据、暴露的存储管理接口和弱管理员口令；真正挡住攻击的，也仍然是 MFA、IP 白名单和服务端业务校验。</span></p><p><span>这起事件值得关注的，不是“AI 已经无所不能”，而是</span><strong><span>技术执行工作被大规模交给代理后，一名低技能操作者也能持续完成侦察、脚本编写、漏洞利用、数据整理和渗出。</span></strong></p><p><span>2026 年 11 月 14 日，BabidiGhost 使用的付费模型 API 密钥被吊销，后续请求全部返回&nbsp;</span><span><span>401 Unauthorized，</span></span><span>AI 代理随即停止工作。</span></p><p><span>但攻击并没有在同一时刻彻底结束。此前部署的 PowerShell 信标和伪装成 Windows Update 服务的 C# 后门仍继续回连，直到 11 月 15 日 12:54（UTC）；被劫持的中转服务器则在 11 月 16 日前离线。</span></p><p><strong><span>模型密钥失效可以让代理停摆，却不能替代受害端的清除与恢复。</span></strong><span>要理解这起事件，需要从攻击者意外暴露的一台服务器说起。</span></p><p><span><span>01</span></span><span><span>&nbsp;事件速览：超过 50 个目标与数据集，14 个重点对象出现四种结果</span></span></p><p><span>2026 年 11 月 20 日，SOCRadar 披露了 BabidiGhost 行动。相关活动主要发生在 2026 年 11 月 6 日至 14 日，目标集中在比利时、法国和瑞士。</span></p><table><tbody><tr><td><p><span>维度</span></p></td><td><p><span>已披露情况</span></p></td></tr><tr><td><p><span>操作者</span></p></td><td><p><span>BabidiGhost，法语操作者，被 SOCRadar 评估为低技能攻击者</span></p></td></tr><tr><td><p><span>使用工具</span></p></td><td><p><span>BlackHatSect0r 工具链中的越狱 Hermes AI 代理</span></p></td></tr><tr><td><p><span>活动窗口</span></p></td><td><p><span>2026 年 11 月 6 日至 14 日</span></p></td></tr><tr><td><p><span>目标范围</span></p></td><td><p><span>超过 50 个组织与数据集，涉及银行、保险、支付、金融科技、加密货币、博彩及地方政府等</span></p></td></tr><tr><td><p><span>重点分析结果</span></p></td><td><p><span>14 个组织中，2 个被入侵、3 个部分被入侵、4 个抵御成功、5 个仅遭遇侦察</span></p></td></tr><tr><td><p><span>主要数据损失</span></p></td><td><p><span>一家保险公司的客户数据库；23 个、合计约 8.6 GB 的公共机构档案压缩包</span></p></td></tr><tr><td><p><span>初始访问特点</span></p></td><td><p><span>已知漏洞、暴露凭据、弱口令和未认证接口，未使用零日漏洞</span></p></td></tr><tr><td><p><span>数据渗出</span></p></td><td><p><span>Telegram Bot API 及文件传输服务</span></p></td></tr></tbody></table><p><span>这里需要区分“目标”和“受害组织”：超过 50 个组织与数据集进入攻击视野，并不意味着它们全部遭到成功入侵。14 个重点对象的结果反而显示，同一套 AI 代理和攻击方法，在不同安全控制条件下产生了截然不同的结局。</span></p><p><img src=\"/dailyinfo/media/b0002bcaecf904c3.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>图1｜目标组织与数据集行业分布</span></strong></p><p><span>图注：公共部门及市政相关目标与数据集数量最多；银行、保险、支付和博彩等金融相关目标，则占据操作者直接点名组织的大多数。图源：SOCRadar，经 GBHackers 转载。</span></p><p><span><span>02</span></span><span><span>&nbsp;开放目录暴露“作战台”：1901 个文件还原九天行动</span></span></p><p><span>BabidiGhost 使用的中转服务器位于法国，原本是一台被劫持的小型企业服务器。其 Web 根目录在 8889 端口直接返回操作者主目录的文件列表，最终把自己的行动记录暴露给了研究人员。</span></p><p><span>SOCRadar 从该开放目录中获得了</span><strong><span>1901 个文件，分布在 90 多个目录，</span></strong><span>内容包括：</span></p><ul><li><span><span>AI 代理身份配置和越狱组件；</span></span></li><li><span><span>操作者输入的完整提示词记录；</span></span></li><li><span><span>Shell 历史、扫描结果和解析脚本；</span></span></li><li><span><span>Telegram 机器人令牌、植入体日志；</span></span></li><li><span><span>约 10 GB 已窃取并暂存的数据。</span></span></li></ul><p><span>这些材料使研究人员能够把自然语言指令、脚本执行、目标结果和植入体回连放在同一条时间线上，而不是只凭单个受害端日志推测攻击过程。</span></p><p><img src=\"/dailyinfo/media/5f7b64b1a0a467b9.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>图2｜开放目录暴露的攻击“作战台”</span></strong></p><p><span>图注：开放目录暴露了 Shell 历史、Hermes 代理配置、提示词与拒绝覆盖日志、Telegram 机器人令牌，以及被盗数据暂存目录等关键材料。图源：SOCRadar，经 GBHackers 转载。</span></p><p><span><span>人下指令，代理完成技术执行</span></span></p><p><span>九天内，操作者输入了</span><strong><span>1801 条自然语言命令，</span></strong><span>其中不少是带有拼写错误的法语。AI 代理则向模型转发了</span><strong><span>5779 次请求，</span></strong><span>负责编写扫描器、漏洞利用脚本、数据解析器和渗出脚本。</span></p><p><span>操作者关心的是结果，例如要求将包含 IBAN 的完整记录整理成 13 个文件、每个文件 1000 条；至于如何扫描、利用、导出和打包，则主要由代理完成。</span></p><p><span>代理的核心配置之一是长达</span><strong><span>1371 行</span></strong><span>的&nbsp;</span><span><span>SOUL.md。</span></span><span>该文件声明其“伦理协议已被摧毁”，将拒绝回答视为模型故障，并索引了 503 个技能目录。本地转发代理还会在模型拒绝时逐级提高提示压力，重新发送请求，最终只有</span><strong><span>41 次拒绝</span></strong><span>在整个升级流程后仍然保留。</span></p><p><span>这套框架并非稳定、精密的“全自动攻击平台”。它启动时就处于&nbsp;</span><span><span>DEGRADED</span></span><span>&nbsp;状态，部分模块导入失败；但辅助脚本出错后，模型会重写脚本，从而弥补框架缺陷和操作者自身的技术不足。503 个技能目录也只是攻击组件索引，不能等同于 503 种都已验证有效的攻击能力。</span></p><p><span><span>与 BlackHatSect0r 的关系：同一工具链，第二个操作者</span></span></p><p><span>BabidiGhost 使用的代理自称“BlackHatSect0r Agent”，运行时使用&nbsp;</span><span><span>GHOSTHUNTERS</span></span><span>&nbsp;标识，越狱构造也与 SOCRadar 在 2026 年 9 月披露的 BlackHatSect0r 工具链一致。</span></p><p><span>SOCRadar 因此将 BabidiGhost 视为其观察到的</span><strong><span>第二个使用该工具链的操作者。</span></strong><span>两者的关系主要体现在代理、模型使用方式、越狱机制和暴露配置偏好上；BabidiGhost 并未使用 BlackHatSect0r 此前的 DXSCAN 扫描平台，也没有展示出同等水平的专用基础设施和独立攻击技术。</span></p><p><span>这意味着工具链已经发生操作者间转移，不能仅凭这一点就把 BabidiGhost 与 BlackHatSect0r 视为同一个操作者。</span></p><p><span><span>03</span></span><span><span>&nbsp;攻击链复盘：两条成功路径，都没有零日漏洞</span></span></p><p><img src=\"/dailyinfo/media/d808c72a653a7379.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>图3｜BabidiGhost 行动攻击链与阻断全景</span></strong></p><p><span>图注：汇总人机协同、外部侦察、两条成功入侵路径、植入体与数据通道、有效防御控制，以及代理停止与植入体残留的两条终止时间线。图源：根据 SOCRadar 公开披露整理绘制。</span></p><p><span><span>前置侦察：先找暴露面，再决定使用什么脚本</span></span></p><p><span>AI 代理通过数字证书和 DNS 信息整理外部资产，对可达服务进行路径扫描与漏洞探测，并收集未认证公开的配置和 API 文件。在部分银行目标上，这些结果被整理成可交付的侦察报告。</span></p><p><span>这一阶段的关键变化是持续性和执行密度：代理可以不间断地检查主机、路径、接口和默认凭据，再根据返回结果生成下一批脚本。但后续能否进入系统，仍取决于目标是否真实存在可利用的暴露点。</span></p><p><span><span>路径一：从 Metabase 远程命令执行到保险公司客户数据库导出</span></span></p><p><span>保险公司的入侵链条最完整，也最能说明多项基础问题如何串联成数据泄露：</span></p><p><strong><span>互联网暴露且未修补的 Metabase → CVE-2023-38646 预认证远程代码执行 → 利用仪表盘数据库连接继续深入 → 读取容器运行环境中的云数据库凭据 → 批量导出客户数据库 → 创建 PostgreSQL 触发器维持植入体运行。</span></strong></p><p><span><span>CVE-2023-38646</span></span><span>&nbsp;允许攻击者在无需认证的情况下，以 Metabase 服务器权限执行任意命令。它并不是此次行动中出现的新漏洞，而是一个早已公开并已有修复版本的已知缺陷。</span></p><p><span>取得初步访问后，代理没有停留在 Metabase 本身，而是借助应用已有的数据库连接和运行环境中可读取的凭据访问云数据库。随后，攻击者创建了名为&nbsp;</span><span><span>trg_beacon</span></span><span>&nbsp;的 PostgreSQL 触发器，使新记录插入时重新启动植入体。</span></p><p><span>这里的持久化对象不是普通的 Windows 启动项，而是</span><strong><span>数据库触发器。</span></strong><span>如果响应时只清理主机上的后门，却不审查数据库对象和数据库凭据，攻击链仍可能残留。</span></p><p><img src=\"/dailyinfo/media/d13849ebed25c19e.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>图4｜保险公司 Metabase 入侵与持久化技术流程</span></strong></p><p><span>图注：从 Metabase 预认证远程代码执行开始，逐步展开数据库连接滥用、云数据库凭据读取、客户数据导出、PostgreSQL 触发器、Windows 植入体、C2 与数据渗出，并在右侧列出对应检测数据源。图源：根据 SOCRadar 公开披露整理绘制。</span></p><p><span><span>路径二：一个弱管理员口令，打开多个公共机构的档案</span></span></p><p><span>规模最大的数据损失甚至没有经过漏洞利用。</span></p><p><span>一家共享 IT 服务商将存储服务器管理接口暴露在互联网上，管理员口令强度不足。进入管理界面后，代理运行三个下载脚本，取得</span><strong><span>23 个压缩档案，合计约 8.6 GB，</span></strong><span>数据属于</span><strong><span>超过 13 个市镇及另外 10 个公共机构。</span></strong></p><p><span>这并非逐个入侵二十多个公共机构，而是共享服务商的一处存储集中存放了多个客户的数据。一个管理凭据失陷，最终放大为跨机构的数据暴露。</span></p><p><span><span>04</span></span><span><span>&nbsp;同样重要的另一半：大量攻击被常规控制直接拦下</span></span></p><p><span>如果只看两起成功入侵，容易把 AI 代理的能力想象得过于强大。其余目标的结果提供了更完整的对照。</span></p><p><span><span>MFA 与 IP 白名单阻断了后续利用</span></span></p><ul><li><span><span>针对一家支付机构的商户门户，代理编写了&nbsp;</span><span><span>11 个脚本</span></span><span>，试图暴力破解基于时间的一次性验证码（TOTP）第二因素，均未成功。</span></span></li><li><span><span>一家加密货币交易所遭遇了</span><span><span>超过 180 个脚本</span></span><span>，涉及移动应用反编译、令牌伪造和身份校验绕过等尝试，现有控制仍然有效。</span></span></li><li><span><span>在防护较强的一家银行，代理发现了&nbsp;</span><span><span>49 个主机名</span></span><span>，但这些系统全部位于 IP 白名单之后，无法直接访问。</span></span></li></ul><p><span>这些结果不意味着 MFA 或白名单能够解决所有问题，而是说明在本事件中，代理没有越过这些已经正确部署的控制。</span></p><p><span><span>服务端业务校验挡住了“技术上可提交”的欺诈请求</span></span></p><p><span>在一家银行，生产 API 存在未授权文档上传问题。代理随后尝试登记虚假死亡声明，但服务端业务规则拒绝了该请求。</span></p><p><span>另一个银行目标存在登录错误提示差异，可被用来判断账户是否存在，攻击者据此确认了</span><strong><span>48 个有效企业账户，</span></strong><span>其中包括高管账户。账户枚举不等于这些账户已经被接管，但它会为后续密码攻击和定向社会工程提供目标清单。</span></p><p><span>此外，一个支付应用可被用于向任意号码发送带有银行品牌的短信。这类问题未必直接形成数据库入侵，却可能被滥用于欺诈和冒名场景。</span></p><p><span><span>数据收集并不只发生在被入侵系统内</span></span></p><p><span>代理还运行了一个 120 线程爬虫，从瑞士网站收集 IBAN、电子邮箱和电话号码，并使用其他脚本从已窃取档案中提取同类信息。</span></p><p><span>SOCRadar 认为，这类数据集可能对个人造成直接伤害：当 IBAN 与经过验证的身份信息结合时，可被用于直接借记欺诈和冒充银行的诈骗呼叫。攻击价值并不只取决于是否进入核心数据库，公开信息被批量聚合后同样可能形成可滥用的数据资产。</span></p><p><span><span>05</span></span><span><span>&nbsp;行动终止不等于攻击链消失</span></span></p><p><span>BabidiGhost 的模型访问依赖一个付费 API 密钥。2026 年 11 月 14 日密钥被吊销后，模型请求持续返回&nbsp;</span><span><span>401 Unauthorized，</span></span><span>代理失去继续生成和执行任务的能力。</span></p><p><span>然而，已经部署到受害环境中的两类植入体没有随模型一起停止：</span></p><ul><li><span><span><span>C:\\Windows\\Temp\\b.ps1</span></span><span>对应的 PowerShell 信标；</span></span></li><li><span><span>伪装为 Windows Update 服务的 C# 后门</span><span><span>WinUpdSvc2.exe。</span></span></span></li></ul><p><span>二者持续回连至 11 月 15 日 12:54（UTC）。因此，针对这类事件的响应至少要拆成两部分：</span><strong><span>切断代理所需的模型与自动化资源，以及独立清理受害端持久化、凭据和渗出通道。</span></strong><span>只完成前一项，不能证明事件已经结束。</span></p><p><span><span>06</span></span><span><span>&nbsp;事件研判：AI 压低的是技术执行成本，不是安全控制的失效门槛</span></span></p><p><span>这起事件呈现出一种清晰的分工：人负责提出目标、筛选数据价值和转述买方需求，代理负责把要求转换为持续的技术操作。低技能操作者由此获得了超出自身能力的执行效率，但攻击能否成立，依然由目标环境决定。</span></p><p><span>成功路径没有零日漏洞，也没有绕过所有防护的“通用能力”。相反，入侵集中在四类常见问题上：</span></p><ol><li><span><span>本不应直接暴露在互联网上的分析工具和管理接口；</span></span></li><li><span><span>已知漏洞长期未修复；</span></span></li><li><span><span>应用进程能够直接读取高权限数据库凭据；</span></span></li><li><span><span>弱口令、缺失认证和缺少业务校验。</span></span></li></ol><p><span>从这个角度看，AI 代理改变的是暴露面被发现的概率和被利用的速度。过去可能被低频扫描遗漏的弱配置，现在更容易被持续检查并立即转成下一步动作；而已经部署的 MFA、IP 白名单、服务端验证和网络限制，依然能够决定攻击停在哪一步。</span></p><p><span>这也是本事件最直接的防御启示：</span><strong><span>不能把希望寄托在攻击者能力不足上，应假设任何可达缺口都会被自动化工具反复尝试。</span></strong></p><p><span><span>07</span></span><span><span>&nbsp;防御与处置建议</span></span></p><p><span>1. 优先收回不必要的互联网暴露面</span></p><ul><li><span><span>清点 Metabase 等分析工具、存储管理面板、测试门户、API 文档和配置接口，能通过内网、VPN 或访问代理提供服务的，不直接暴露公网。</span></span></li><li><span><span>对必须公开的服务实施强认证、MFA、IP 白名单和速率限制，并覆盖每一条 API 路由，而不是只保护登录页面。</span></span></li><li><span><span>检查共享服务商和集中存储平台的跨客户访问控制，避免单一管理员凭据直接打开全部客户数据。</span></span></li></ul><p><span>2. 处理 Metabase 漏洞与凭据暴露的联动风险</span></p><ul><li><span><span>确认 Metabase 版本并升级到官方修复版本；同时排查历史日志，不能把“完成升级”当作“此前未被利用”的证明。</span></span></li><li><span><span>减少应用运行环境中明文数据库凭据的使用，采用专用密钥管理机制和短期凭据，并按最小权限限制数据库账号。</span></span></li><li><span><span>若发现相关入侵迹象，应轮换数据库凭据、应用密钥、API 令牌及相关管理员口令，并检查凭据是否已被用于批量导出。</span></span></li></ul><p><span>3. 把数据库对象纳入持久化排查</span></p><ul><li><span><span>审查 PostgreSQL 触发器、函数及异常权限变更，重点检查&nbsp;</span><span><span>trg_beacon</span></span><span>&nbsp;等未知对象。</span></span></li><li><span><span>将数据库审计日志与 Metabase 应用日志、云数据库导出记录关联分析，识别异常服务器级命令和批量读取。</span></span></li><li><span><span>清理触发器前先保留定义、创建时间、关联函数和数据库会话等证据，避免只删除名称而遗漏实际执行逻辑。</span></span></li></ul><p><span>4. 响应时同时覆盖主机、身份与网络</span></p><ul><li><span><span>检查&nbsp;</span><span><span>b.ps1、</span></span><span><span>WinUpdSvc2.exe、</span></span><span>Run 键、计划任务和新增的 Microsoft Defender 排除路径。</span></span></li><li><span><span>排查到&nbsp;</span><span><span>45.92.111[.]116:8443</span></span><span>&nbsp;的回连，以及服务器网段中缺乏业务理由的 Telegram Bot API、文件传输服务和模型 API 调用。</span></span></li><li><span><span>对发现入侵的主机进行隔离和持久化清除，同时撤销相关会话、轮换凭据、评估数据影响；阻断模型 API 不会自动完成这些工作。</span></span></li></ul><p><img src=\"/dailyinfo/media/690696ceb6e7d54f.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>图5｜密钥吊销后的事件响应与检测闭环</span></strong></p><p><span>图注：以 2026 年 11 月 5 日至 17 日为建议回溯窗口，串联范围确认、隔离取证、持久化清除、身份与凭据处置、渗出影响评估、修复验证六个阶段，并列出闭环复核所需日志。图源：根据 SOCRadar 公开披露及本文防御建议整理绘制。</span></p><p><span><span>08</span></span><span><span>&nbsp;技术附录</span></span></p><p><span>附录 A：MITRE ATT&amp;CK 技术映射</span></p><p><span>以下依据 SOCRadar 公开映射整理，战术名称按 MITRE ATT&amp;CK Enterprise 规范统一。表中行为包括成功动作和已披露的攻击尝试，不表示每项技术均在所有目标上成功。</span></p><table><tbody><tr><td><p><span>战术</span></p></td><td><p><span>技术编号与名称</span></p></td><td><p><span>本事件对应行为</span></p></td></tr><tr><td><p><span>侦察</span></p></td><td><span><span>T1595.002</span></span><p><span>&nbsp;— Active Scanning: Vulnerability Scanning（主动扫描：漏洞扫描）</span></p></td><td><p><span>对互联网资产进行路径扫描、主机枚举和漏洞探测</span></p></td></tr><tr><td><p><span>侦察</span></p></td><td><span><span>T1596.003</span></span><p><span>&nbsp;— Search Open Technical Databases: Digital Certificates（搜索开放技术数据库：数字证书）</span></p></td><td><p><span>通过证书与 DNS 信息整理外部攻击面</span></p></td></tr><tr><td><p><span>侦察</span></p></td><td><span><span>T1589.002</span></span><p><span>&nbsp;— Gather Victim Identity Information: Email Addresses（收集受害者身份信息：电子邮件地址）</span></p></td><td><p><span>爬取邮箱、电话号码及 IBAN 等信息</span></p></td></tr><tr><td><p><span>资源开发</span></p></td><td><span><span>T1584.004</span></span><p><span>&nbsp;— Compromise Infrastructure: Server（攻陷基础设施：服务器）</span></p></td><td><p><span>使用被劫持的法国小型企业服务器作为中转与暂存节点</span></p></td></tr><tr><td><p><span>资源开发</span></p></td><td><span><span>T1585.002</span></span><p><span>&nbsp;— Establish Accounts: Email Accounts（建立账户：电子邮件账户）</span></p></td><td><p><span>使用一次性邮箱和临时身份资源支撑行动</span></p></td></tr><tr><td><p><span>资源开发</span></p></td><td><span><span>T1587.001</span></span><p><span>&nbsp;— Develop Capabilities: Malware（开发能力：恶意软件）</span></p></td><td><p><span>生成和使用 PowerShell 信标、C# 植入体及配套脚本</span></p></td></tr><tr><td><p><span>初始访问</span></p></td><td><span><span>T1190</span></span><p><span>&nbsp;— Exploit Public-Facing Application（利用面向公众的应用程序）</span></p></td><td><p><span>利用互联网暴露的 Metabase 实例 CVE-2023-38646</span></p></td></tr><tr><td><p><span>初始访问</span></p></td><td><span><span>T1078</span></span><p><span>&nbsp;— Valid Accounts（有效账户）</span></p></td><td><p><span>使用有效或猜测所得的管理员凭据进入存储管理界面</span></p></td></tr><tr><td><p><span>执行</span></p></td><td><span><span>T1059.001</span></span><p><span>&nbsp;— Command and Scripting Interpreter: PowerShell（命令和脚本解释器：PowerShell）</span></p></td><td><p><span>执行 PowerShell 信标与相关任务</span></p></td></tr><tr><td><p><span>执行</span></p></td><td><span><span>T1059.006</span></span><p><span>&nbsp;— Command and Scripting Interpreter: Python（命令和脚本解释器：Python）</span></p></td><td><p><span>代理由 Python 任务和辅助脚本完成扫描、解析与下载</span></p></td></tr><tr><td><p><span>持久化</span></p></td><td><span><span>T1053.005</span></span><p><span>&nbsp;— Scheduled Task/Job: Scheduled Task（计划任务/作业：计划任务）</span></p></td><td><p><span>通过计划任务启动或重新启动植入体</span></p></td></tr><tr><td><p><span>持久化</span></p></td><td><span><span>T1547.001</span></span><p><span>&nbsp;— Boot or Logon Autostart Execution: Registry Run Keys / Startup Folder（注册表 Run 键/启动文件夹自启动）</span></p></td><td><p><span>为&nbsp;</span><span><span>WinUpdSvc2.exe</span></span><span>&nbsp;建立 Run 键持久化</span></p></td></tr><tr><td><p><span>持久化</span></p></td><td><span><span>T1546</span></span><p><span>&nbsp;— Event Triggered Execution（事件触发执行）</span></p></td><td><p><span>使用 PostgreSQL 触发器在新记录插入时重新启动植入体</span></p></td></tr><tr><td><p><span>防御规避</span></p></td><td><span><span>T1036.005</span></span><p><span>&nbsp;— Masquerading: Match Legitimate Resource Name or Location（伪装：匹配合法资源名称或位置）</span></p></td><td><p><span>将 C# 后门伪装为 Windows Update 相关服务</span></p></td></tr><tr><td><p><span>防御规避</span></p></td><td><span><span>T1685</span></span><p><span>&nbsp;— Disable or Modify Tools（禁用或修改工具）</span></p></td><td><p><span>新增 Microsoft Defender 排除路径</span></p></td></tr><tr><td><p><span>凭据访问</span></p></td><td><span><span>T1552.001</span></span><p><span>&nbsp;— Unsecured Credentials: Credentials In Files（不安全凭据：文件中的凭据）</span></p></td><td><p><span>读取应用运行环境和配置中暴露的云端数据库凭据</span></p></td></tr><tr><td><p><span>凭据访问</span></p></td><td><span><span>T1110.001</span></span><p><span>&nbsp;— Brute Force: Password Guessing（暴力破解：口令猜测）</span></p></td><td><p><span>对口令进行猜测，弱管理员口令导致存储服务器暴露</span></p></td></tr><tr><td><p><span>凭据访问</span></p></td><td><span><span>T1110</span></span><p><span>&nbsp;— Brute Force（暴力破解）</span></p></td><td><p><span>对支付门户 TOTP 第二因素实施破解尝试，未成功</span></p></td></tr><tr><td><p><span>收集</span></p></td><td><span><span>T1005</span></span><p><span>&nbsp;— Data from Local System（来自本地系统的数据）</span></p></td><td><p><span>收集存储服务器中的压缩档案</span></p></td></tr><tr><td><p><span>收集</span></p></td><td><span><span>T1213</span></span><p><span>&nbsp;— Data from Information Repositories（来自信息存储库的数据）</span></p></td><td><p><span>从数据库批量导出客户数据</span></p></td></tr><tr><td><p><span>渗出</span></p></td><td><span><span>T1567</span></span><p><span>&nbsp;— Exfiltration Over Web Service（通过 Web 服务渗出）</span></p></td><td><p><span>使用 Telegram Bot API 及文件传输服务传送数据</span></p></td></tr><tr><td><p><span>影响</span></p></td><td><span><span>T1657</span></span><p><span>&nbsp;— Financial Theft（金融窃取）</span></p></td><td><p><span>收集 IBAN 与身份信息，并实施账户资金窃取相关尝试</span></p></td></tr></tbody></table><p><span>附录 B：失陷指标（IoC）</span></p><p><span>以下指标采用防误点格式。应在受控的威胁情报平台、SIEM 或流量分析系统中恢复后再使用；其中被劫持基础设施还可能承载合法业务，处置时应结合时间、端口、协议和主机上下文，而非仅凭单个 IP 直接定性整台资产。</span></p><table><tbody><tr><td><p><span>类型</span></p></td><td><p><span>指标</span></p></td><td><p><span>上下文</span></p></td></tr><tr><td><p><span>IP：端口</span></p></td><td><span><span>45.92.111[.]116:8889</span></span></td><td><p><span>开放目录与攻击暂存</span></p></td></tr><tr><td><p><span>IP：端口</span></p></td><td><span><span>45.92.111[.]116:8890</span></span></td><td><p><span>被盗数据投递</span></p></td></tr><tr><td><p><span>IP：端口</span></p></td><td><span><span>45.92.111[.]116:8443</span></span></td><td><p><span>C2 信标监听</span></p></td></tr><tr><td><p><span>IP</span></p></td><td><span><span>45.92.110[.]53</span></span></td><td><p><span>用于账户枚举的辅助节点</span></p></td></tr><tr><td><p><span>主机名</span></p></td><td><span><span>cloud-z80lft07.hosteur[.]net</span></span></td><td><p><span>被劫持的中转服务器</span></p></td></tr><tr><td><p><span>Telegram</span></p></td><td><span><span>@GHOSTHUNTERS6</span></span></td><td><p><span>数据渗出账户</span></p></td></tr><tr><td><p><span>Telegram</span></p></td><td><span><span>@babidighost</span></span><p><span>，用户 ID&nbsp;</span><span><span>8816747359</span></span></p></td><td><p><span>SOCRadar 评估的操作者账户</span></p></td></tr><tr><td><p><span>Telegram Bot</span></p></td><td><span><span>8926517966:[redacted]</span></span></td><td><p><span>渗出机器人；仅公开 Bot ID，令牌已隐去</span></p></td></tr><tr><td><p><span>文件路径</span></p></td><td><span><span>C:\\Windows\\Temp\\b.ps1</span></span></td><td><p><span>PowerShell 信标</span></p></td></tr><tr><td><p><span>文件名</span></p></td><td><span><span>WinUpdSvc2.exe</span></span></td><td><p><span>C# 植入体；关联 Run 键和三个计划任务</span></p></td></tr><tr><td><p><span>数据库对象</span></p></td><td><span><span>trg_beacon</span></span></td><td><p><span>PostgreSQL 触发器持久化</span></p></td></tr><tr><td><p><span>回连格式</span></p></td><td><span><span>BEACON\\\\|&lt;host&gt;\\\\|&lt;user&gt;\\\\|&lt;path&gt;</span></span></td><td><p><span>植入体签到字符串</span></p></td></tr><tr><td><p><span>工具链文件</span></p></td><td><span><span>refusal_hunter.jsonl</span></span><p><span>、</span><span><span>hermes_jailbreak.py</span></span></p></td><td><p><span>拒绝覆盖与越狱组件</span></p></td></tr><tr><td><p><span>日志标记</span></p></td><td><span><span>[BLACKOUT BOOT]</span></span><p><span>、</span><span><span>ÉTAT: DEGRADED</span></span></p></td><td><p><span>代理启动日志</span></p></td></tr></tbody></table><p><span><span>.hermes/</span></span><span>&nbsp;目录和&nbsp;</span><span><span>SOUL.md</span></span><span>&nbsp;文件名不宜单独作为恶意判定依据，因为正常 Hermes Agent 安装也会产生它们；应结合&nbsp;</span><span><span>GHOSTHUNTERS</span></span><span>、反拒绝协议等特征字符串判断。SOCRadar 公开指标中未列出植入体的 SHA-256 哈希。</span></p><p><span>附录 C：相关漏洞（非 IoC）</span></p><p><strong><span>CVE-2023-38646</span></strong><span>，NVD 将其描述为 Metabase 预认证远程命令执行漏洞，攻击者可在服务器权限下执行任意命令。</span></p><p><span>NVD 列出的修复版本包括：</span></p><ul><li><span><span><span>0.46</span></span><span>&nbsp;分支：开源版&nbsp;</span><span><span>0.46.6.1、</span></span><span>企业版&nbsp;</span><span><span>1.46.6.1；</span></span></span></li><li><span><span>旧分支：开源版&nbsp;</span><span><span>0.45.4.1、</span></span><span>企业版&nbsp;</span><span><span>1.45.4.1，</span></span><span>开源版&nbsp;</span><span><span>0.44.7.1、</span></span><span>企业版&nbsp;</span><span><span>1.44.7.1，</span></span><span>以及开源版&nbsp;</span><span><span>0.43.7.2、</span></span><span>企业版&nbsp;</span><span><span>1.43.7.2。</span></span></span></li></ul><p><span>版本修复用于关闭漏洞入口；是否已经遭到利用，仍需结合应用、系统、数据库和网络日志判断。</span></p><p><span>附录 D：日志检测与威胁狩猎要点</span></p><p><span>SOCRadar 建议重点检索</span><strong><span>2026 年 11 月 5 日至 17 日</span></strong><span>的日志，以覆盖正式活动窗口前后的准备和残留回连。</span></p><table><tbody><tr><td><p><span>数据源</span></p></td><td><p><span>重点检测内容</span></p></td></tr><tr><td><p><span>Web 访问、WAF 与反向代理日志</span></p></td><td><p><span>来自相关 IP 的高频路径扫描、主机枚举和漏洞探测；也需检查内部服务器是否主动向外发起同类扫描</span></p></td></tr><tr><td><p><span>身份提供商登录日志</span></p></td><td><p><span>利用不同错误提示批量验证账户是否存在的行为，以及异常账户枚举节奏</span></p></td></tr><tr><td><p><span>Metabase 应用与管理日志</span></p></td><td><p><span>漏洞利用后，仪表盘数据库会话出现异常服务器级命令；不能只查看普通查询日志</span></p></td></tr><tr><td><p><span>云数据库审计日志</span></p></td><td><p><span>使用应用相关凭据进行异常批量读取或整表导出</span></p></td></tr><tr><td><p><span>存储服务器认证与下载日志</span></p></td><td><p><span>口令猜测后出现管理员成功登录，并伴随批量档案下载</span></p></td></tr><tr><td><p><span>PostgreSQL 日志与系统目录</span></p></td><td><p><span>新建异常触发器或函数，重点检查&nbsp;</span><span><span>trg_beacon</span></span><span>&nbsp;及其关联执行逻辑</span></p></td></tr><tr><td><p><span>PowerShell、EDR 与任务计划日志</span></p></td><td><span><span>C:\\Windows\\Temp\\b.ps1</span></span><p><span>&nbsp;执行、</span><span><span>WinUpdSvc2.exe</span></span><span>&nbsp;运行、Run 键或计划任务创建、新增 Defender 排除路径</span></p></td></tr><tr><td><p><span>出口代理、防火墙与 NetFlow</span></p></td><td><p><span>到&nbsp;</span><span><span>45.92.111[.]116:8443</span></span><span>&nbsp;的连接和&nbsp;</span><span><span>BEACON</span></span><span>&nbsp;签到；服务器网段中持续访问 Telegram Bot API、文件传输服务或模型 API 且无合理业务用途</span></p></td></tr></tbody></table><p><span>对于加密 Web 流量，域名或 URL 可见性取决于代理、TLS 检查和日志策略；如果只能看到目的 IP 或 SNI，不应声称已经观察到具体的 Bot 令牌或渗出内容。</span></p><p><span>附录 E：YARA 检测规则</span></p><p><span>以下为 SOCRadar 公开的两条规则，分别用于识别越狱 Hermes 工具链和 BabidiGhost 植入体。建议在历史文件和测试样本范围内验证后再投入生产检测。</span></p><p><span><span>rule</span></span><span><span>Ghost_BlackHatSect0r_AI_Toolchain</span></span></p><p><span>{</span></p><p><span><span>meta:</span></span></p><p><span>&nbsp; &nbsp; &nbsp; &nbsp; description =&nbsp;</span><span><span>\"Ghost / BlackHatSect0r jailbroken Hermes agent toolchain (GHOSTHUNTERS)\"</span></span></p><p><span>&nbsp; &nbsp; &nbsp; &nbsp; author =&nbsp;</span><span><span>\"SOCRadar Research\"</span></span></p><p><span><span>strings:</span></span></p><p><span>&nbsp; &nbsp; &nbsp; &nbsp; $a =&nbsp;</span><span><span>\"NOYAU IDENTITAIRE GHOST\"</span></span></p><p><span>&nbsp; &nbsp; &nbsp; &nbsp; $b =&nbsp;</span><span><span>\"BlackHatSect0r Agent\"</span></span></p><p><span>&nbsp; &nbsp; &nbsp; &nbsp; $c =&nbsp;</span><span><span>\"GHOSTHUNTERS\"</span></span></p><p><span>&nbsp; &nbsp; &nbsp; &nbsp; $d =&nbsp;</span><span><span>\"PROTOCOLE ANTI-REFUS\"</span></span></p><p><span>&nbsp; &nbsp; &nbsp; &nbsp; $e =&nbsp;</span><span><span>\"panne du modèle\"</span></span></p><p><span>&nbsp; &nbsp; &nbsp; &nbsp; $f =&nbsp;</span><span><span>\"BLACKOUT BOOT\"</span></span></p><p><span>&nbsp; &nbsp; &nbsp; &nbsp; $g =&nbsp;</span><span><span>\"refusal_hunter\"</span></span></p><p><span>&nbsp; &nbsp; &nbsp; &nbsp; $h =&nbsp;</span><span><span>\"hermes_jailbreak\"</span></span></p><p><span>&nbsp; &nbsp; &nbsp; &nbsp; $i =&nbsp;</span><span><span>\"yolo_mode\"</span></span></p><p><span><span>condition:</span></span></p><p><span><span>2</span></span><span><span>of</span></span><span><span>them</span></span></p><p><span>}</span></p><p><span><span>rule</span></span><span><span>BabidiGhost_Implants</span></span></p><p><span>{</span></p><p><span><span>meta:</span></span></p><p><span>&nbsp; &nbsp; &nbsp; &nbsp; description =&nbsp;</span><span><span>\"BabidiGhost PowerShell beacons and C# implant\"</span></span></p><p><span>&nbsp; &nbsp; &nbsp; &nbsp; author =&nbsp;</span><span><span>\"SOCRadar Research\"</span></span></p><p><span><span>strings:</span></span></p><p><span>&nbsp; &nbsp; &nbsp; &nbsp; $c2_1 =&nbsp;</span><span><span>\"45.92.111.116\"</span></span></p><p><span>&nbsp; &nbsp; &nbsp; &nbsp; $c2_2 =&nbsp;</span><span><span>\"cloud-z80lft07\"</span></span></p><p><span>&nbsp; &nbsp; &nbsp; &nbsp; $port =&nbsp;</span><span><span>\":8443\"</span></span></p><p><span>&nbsp; &nbsp; &nbsp; &nbsp; $fmt =&nbsp;</span><span><span>\"BEACON|\"</span></span></p><p><span>&nbsp; &nbsp; &nbsp; &nbsp; $svc =&nbsp;</span><span><span>\"WinUpdSvc2\"</span></span><span><span>wide</span></span><span><span>ascii</span></span></p><p><span><span>condition:</span></span></p><p><span>&nbsp; &nbsp; &nbsp; &nbsp; (</span><span><span>1</span></span><span><span>of</span></span><span>&nbsp;($c2_*)&nbsp;</span><span><span>and</span></span><span>&nbsp;($port&nbsp;</span><span><span>or</span></span><span>&nbsp;$fmt))&nbsp;</span><span><span>or</span></span><span>&nbsp;$svc</span></p><p><span>}</span></p><p><span><span>09</span></span><span><span>&nbsp;结语</span></span></p><p><span>BabidiGhost 事件展示的不是一种绕过安全体系的新漏洞，而是一种新的攻击组织方式：自然语言成为操作界面，模型和脚本承担大量重复技术工作，攻击者则以更低门槛维持多目标并行行动。</span></p><p><span>但两条成功入侵路径和大量失败尝试共同说明，攻击效率的提升并未让基础控制失效。未修补的应用、暴露的凭据、弱口令和未认证接口依然是最危险的入口；MFA、IP 白名单、服务端业务校验、最小权限和出口监测依然是最直接的阻断点。</span></p><p><span>当自动化攻击可以持续寻找缺口时，防守方也需要把暴露面治理和日志检测变成持续流程，而不是等到一次扫描或一份通报后再临时处理。</span></p><p><span><span>10</span></span><span><span>&nbsp;参考链接</span></span></p><ol><li><span><span>SOCRadar：BabidiGhost: An AI-Augmented Cybercrime Operation（2026-11-20）</span><span><br></span><span><span><a href=\"https://socradar.io/blog/babidighost-ai-augmented-cybercrime/\">https://socradar.io/blog/babidighost-ai-augmented-cybercrime/</a></span></span></span></li><li><span><span>SOCRadar：Discernment Deleted: Inside the Operation Server of BlackHatSect0r &amp;&amp; DXQRTXX（2026-09-16）</span><span><br></span><span><span><a href=\"https://socradar.io/blog/blackhatsect0r-dxqrtxx-operation-server/\">https://socradar.io/blog/blackhatsect0r-dxqrtxx-operation-server/</a></span></span></span></li><li><span><span>Spectrum：BabidiGhost jailbroken AI agent campaign threat（2026-11-20）</span><span><br></span><span><span><a href=\"https://www.spectrum.security/threats/babidighost-jailbroken-ai-agent-campaign\">https://www.spectrum.security/threats/babidighost-jailbroken-ai-agent-campaign</a></span></span></span></li><li><span><span>Cyber Security News：Jailbroken AI Agent Helps Hacker Steal Customer Data and 8.6GB of European Government Files（2026-11-23）</span><span><br></span><span><span><a href=\"https://cybersecuritynews.com/jailbroken-ai-agent/\">https://cybersecuritynews.com/jailbroken-ai-agent/</a></span></span></span></li><li><span><span>GBHackers：Jailbroken AI Agent Helps Hacker Steal Customer Data and 8.6GB of European Government Files（2026-11-23）</span><span><br></span><span><span><a href=\"https://gbhackers.com/jailbroken-ai-agent/\">https://gbhackers.com/jailbroken-ai-agent/</a></span></span></span></li><li><span><span>NVD：CVE-2023-38646</span><span><br></span><span><span><a href=\"https://nvd.nist.gov/vuln/detail/CVE-2023-38646\">https://nvd.nist.gov/vuln/detail/CVE-2023-38646</a></span></span></span></li><li><span><span>Metabase：Security Advisory</span><span><br></span><span><span><a href=\"https://www.metabase.com/blog/security-advisory\">https://www.metabase.com/blog/security-advisory</a></span></span></span></li><li><span><span>MITRE ATT&amp;CK：Enterprise Techniques</span><span><br></span><span><span><a href=\"https://attack.mitre.org/techniques/enterprise/\">https://attack.mitre.org/techniques/enterprise/</a></span></span></span></li></ol><p><span><span>本文已发布于NCC国家网络安全云社区<a href=\"https://nccsec.cn/security-community\">https://nccsec.cn/security-community</a></span></span></p><p><a href=\"https://ti.qianxin.com/portal\">阅读原文</a></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=6430d172&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzI2MDc2MDA4OA%3D%3D%26mid%3D2247521526%26idx%3D1%26sn%3D986171417d0876bc4d962ece888af8d7\">跳转微信打开</a></p>","original","zhKind","complete","后门","数据泄露","凭据","奇安信","NVD","https://mp.weixin.qq.com/s?__biz=MzI2MDc2MDA4OA==&mid=2247521526&idx=1&sn=986171417d0876bc4d962ece888af8d7","奇安信威胁情报中心",{"_98":99,"_100":-5},"changelogVersion","2026-10-01T08:00","release"]
