[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795653637000,"id","eok30e2pbcjv42ozsxpku1vc2","title","VMware vCenter Directory Service 认证绕过漏洞 CVE-2026-123890 可无凭据利用","originalTitle","CVE-2026-123890 | VMware vCenter Directory Service Authentication Bypass Vulnerability","summary","VMware vCenter 的 Directory Service 组件存在严重认证绕过漏洞 CVE-2026-123890。具备 vCenter 网络访问权限且无需任何凭据的攻击者，可取得内置 administrator@vsphere.local 账户的已认证会话，进而控制 vSphere 环境及其管理的 ESXi 主机和虚拟机。原文未说明受影响版本、补丁状态或是否已在野利用。","reason","source",{"_75":96},"links",{"_61":95},"publishedAt","2026-11-25T22:09:46.000Z","discoveredAt","2026-11-25T22:27:20.302Z","timelineAt","category","vuln","tags",[92,78,93,81,94],"score",78,"selected",false,"channel","news","story",{"_85":86,"_13":87},"x","readingMode","full","author","Horizon3","body",{"_88":-5,"_61":89,"_90":-5,"_91":36},"outline",[],"relatedStories",[84],"topics",[68,69,70,71,72],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fvXqFVauO5j0","reportCount",1,"additionalSourceCount",0,{"_73":82,"_75":83},{"_73":80,"_75":81},{"_73":30,"_75":79},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","research","name","技术研究","exploited","在野利用","漏洞披露","identity","身份与访问","vmware","VMware / Broadcom",{"_85":86,"_13":87},"publicId","25bfc85d-d33c-4d9e-8852-0430fda6b8b0","Armory Castle利用vCenter认证绕过漏洞","zh","<p>CVE-2026-123890 is a critical authentication bypass in the VMware Directory Service component of VMware vCenter. An attacker with network access to vCenter, and no credentials, can obtain an authenticated session as the built-in administrator@vsphere.local account, taking control of the vSphere environment and the ESXi hosts and virtual machines it manages. Exploitation requires no user…</p><p><a href=\"https://horizon3.ai/attack-research/vulnerabilities/cve-2026-123890/\">Source</a></p>","zhKind","complete","漏洞","漏洞分析","VMware","https://horizon3.ai/attack-research/vulnerabilities/cve-2026-123890/","Horizon3.ai",{"_98":99,"_100":-5},"changelogVersion","2026-10-01T08:00","release"]
