[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1793621936000,"id","m1ed08v93m476v6cel7apeyzz","title","Trezor 警告 CryptoBilis 售出的 Safe 5 钱包疑似被植入外传恢复短语的电路板","originalTitle","Trezor Warns of Suspected Hardware Implant in One of Its Wallets Sold by CryptoBilis","summary","Trezor 收到印度尼西亚客户报告，称其经 Tokopedia 从 CryptoBilis 购买的 Safe 5 硬件钱包疑似被加入带蜂窝模块和天线的额外电路板，可读取恢复短语并在设备接入时通过移动网络发送。","reason","材料呈现了硬件钱包恢复短语外传机制、涉及渠道和处置范围，可用于评估同渠道设备与凭据风险。","source",{"_68":96},"links",{"_87":95},"publishedAt","2026-10-30T12:21:56.000Z","discoveredAt","2026-10-30T12:51:17.809Z","timelineAt","category","activity","tags",[71,69,91,92,93,94],"score",76,"selected",true,"channel","news","story","x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_59":86,"_87":-5,"_88":89,"_90":37},"outline",[80],"relatedStories",[],"topics",[60,61,62,63,64,65],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_66":78,"_68":79},{"_66":76,"_68":77},{"_66":74,"_68":75},{"_66":72,"_68":73},{"_66":70,"_68":71},{"_66":67,"_68":69},"slug","malware","name","恶意软件","attack","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","crypto","密码学","identity","身份与访问",{"_11":81,"_82":83,"_84":85},"sec-1","text","新加坡独立警方咨询委员会","level",3,"<p><span><i></i><span>Ravie Lakshmanan</span><i></i><span>2026年10月30日</span></span><span>硬件安全 / 加密货币</span></p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEih5QxhFnBw6d40ollOAoolmZedxywTm7DeBQpEqydVG5Pqg0v5iDVFT1hhbsW7Thqg00oI8MACNXC9FX6MCp_qMRkBRiqdxb9D4CDKfTWTZwI5eyY3V2IOa8ODSg24kX7Ni_C968r2X89tUXwPbDnHPV9xX-ydhytwerqMI1ru7tqdIK-cqA0p9oM5Ppxr/s1600/trezor-wallet.jpg\"><img alt=\"\" src=\"/dailyinfo/media/a92c810de2ecbf47.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>一名客户报告称，从经销商 CryptoBilis 购买的 Trezor Safe 5 硬件钱包多出一块电路板，会通过移动网络发送恢复助记词。</p><p>Trezor 尚未检查该设备。该公司正提醒所有自 2026 年 3 月以来从 CryptoBilis 购买 Trezor 的人，将资金转移到一个使用新恢复助记词的新钱包中。</p><p>Trezor 在<a href=\"https://trezor.io/blog/news/implant-reported-in-a-trezor-sold-by-cryptobilis\">一篇博客文章</a>中表示，10 月 30 日收到的报告来自两天前印度尼西亚的一名客户。他于 8 月通过 Tokopedia  marketplace 从 CryptoBilis 购买了这款钱包。</p><p>据报告称，这块电路板位于钱包主板和屏幕之间，带有蜂窝模块和天线。它会读取屏幕内容，包括恢复助记词（Trezor 称其为钱包备份），并在设备插入时将其发送出去。</p><p>Trezor 拥有该客户提供的照片和说明，并已通过视频通话对他进行了访谈。该公司正在安排将该钱包寄往其实验室。</p><p>Trezor 认为这份报告足够可信，因此现在就向购买者发出警告。“等待实验室确认会让 CryptoBilis 的购买者在此期间继续暴露于风险之中，”该公司表示。</p><p>目前还没有 CryptoBilis 的购买者向 Trezor 报告资金损失，而 Trezor 无法查看客户钱包中持有哪些资产。该客户在发现这块电路板之前，已经将资金转出了钱包。</p><p>Trezor 的建议涵盖自 2026 年 3 月以来从 CryptoBilis 购买的所有 Trezor 型号，适用于任何销售过 CryptoBilis 所提供设备的商店，包括其在 Tokopedia 上的商店：</p><ul>\n  <li>如果你已经在使用这款钱包，请尽快将资金转移到一个使用新恢复助记词的新钱包中。在另一台设备上恢复旧恢复助记词没有帮助，因为被篡改的钱包可能已经将该助记词发送出去。</li>\n  <li>如果你没有其他安全的硬件钱包，请暂时将资金转移到软件钱包或你熟知的交易所。</li>\n  <li>如果你尚未设置这款钱包，请不要进行设置，并且绝不要在其中输入你现有的恢复助记词。</li>\n  <li>保留 CryptoBilis 的设备并联系 Trezor Support。Trezor 将向你寄送一台新设备，或向你提供一张可支付新设备费用的代金券。</li>\n  <li>如果你不确定设备从哪里购买，请查看收据上的卖家名称或联系 Trezor Support。</li>\n</ul><p>截至 10 月 30 日，Trezor 尚未收到涉及任何其他经销商的报告。</p><p>据 Trezor 表示，用户无法可靠地自行检查设备，也不应通过称重或拆开设备来尝试检查。该客户注意到重量存在差异，但细微的重量差异也可能有其他原因。</p><p>Trezor 还预计，骗子会利用此次事件，通过虚假电子邮件、信件和电话实施网络钓鱼。</p><p>10 月 9 日，在硬件钱包制造商 Ledger 开始调查从 CryptoBilis 购买设备的 Ledger 客户出现资金损失后，Trezor 停止了与 CryptoBilis——其在东南亚的授权经销商——的合作。</p><p>Ledger 此后表示，一名受影响客户的钱包<a href=\"https://thehackernews.com/2026/10/ledger-finds-unauthorized-hardware.html\">包含一个未经授权的硬件植入装置</a>，用于在设置过程中截取恢复助记词。</p><p>Trezor 表示，其 Safe 5 中报告的电路板似乎与 Ledger 设备中发现的植入装置工作方式相似。在调查继续进行期间，Trezor 不会对两者进行比较，因为各制造商构建设备的方式不同。该公司尚不清楚谁应对此负责。</p><h3 id=\"sec-1\">新加坡独立警方咨询委员会</h3><p>新加坡警察部队在 10 月 28 日发布的一份<a href=\"https://www.police.gov.sg/Media-Hub/News/2026/10/20261028_police_advisory_on_tampered_cryptocurrency_hardware_wallets\">安全公告</a>中表示，从新加坡某些零售店购买的 Ledger 硬件钱包含有恶意硬件组件。自 9 月 10 日以来，已报告至少两起此类案件。</p><p>这些组件可以捕获用户的恢复助记词或私钥。警方调查仍在进行中，Ledger 正在审查受影响的案件。</p><p>觉得这篇文章有意思吗？关注我们的 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a>，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","后门","数据窃取","凭据","加密","https://thehackernews.com/2026/10/trezor-warns-of-suspected-hardware.html","The Hacker News",{"_98":99,"_100":-5},"changelogVersion","2026-10-01T08:00","release"]
