[{"_1":2,"_3":4},"root",{"_5":103},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1793621938000,"id","yel5ru1rhfaki9yrdjve29z1a","title","Apple 向旧款 iPhone 和 iPad 回移 CoreGraphics 漏洞 CVE-2026-86950 补丁","originalTitle","Apple backports CoreGraphics zero-day patches to older iPhones","summary","Apple 已将 CoreGraphics 漏洞 CVE-2026-86950 的安全补丁回移至旧款 iPhone 和 iPad。该越界写入漏洞可被恶意构造文件触发，导致任意代码执行，Apple 称其已用于针对特定目标的复杂攻击。","reason","source",{"_75":102},"links",{"_92":101},"publishedAt","2026-10-27T10:36:12.000Z","discoveredAt","2026-10-28T09:02:43.209Z","timelineAt","category","vuln","tags",[98,99,76,100,79],"score",78,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","sameEvent",{"_11":96,"_13":97},"readingMode","full","author","Sergiu Gatlan","body",{"_62":91,"_92":-5,"_93":94,"_95":36},"outline",[86],"relatedStories",[82],"topics",[69,70,71,72],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","fnnarpD6Nw_w","reportCount",2,"additionalSourceCount",1,{"_73":80,"_75":81},{"_73":78,"_75":79},{"_73":30,"_75":77},{"_73":74,"_75":76},"slug","exploited","name","在野利用","漏洞披露","mobile","移动端","apple","Apple / 苹果",{"_83":84,"_13":85},"publicId","04fec2a6-d40e-4d43-9bbc-64503ef6bb0a","Apple扩大CoreGraphics漏洞修复范围",{"_11":87,"_88":89,"_90":66},"sec-1","text","攻击者一旦拥有有效凭据，其操作只有 37% 会被阻止","level","<p><img alt=\"Apple\" height=\"900\" src=\"/dailyinfo/media/c1e93d0f6b3bfd91.jpg\" srcset=\"/dailyinfo/media/a8d7de2b0f2c47be.jpg 720w, /dailyinfo/media/47d2fa6a13d18b5d.jpg 1200w, /dailyinfo/media/c1e93d0f6b3bfd91.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>Apple 已将上月发布的安全补丁反向移植到较旧的 iPhone 和 iPad，以修复一个已被利用的零日漏洞；Apple 称其遭受了针对 iOS 设备的“极其复杂”的定向攻击。</p><p>Apple <a href=\"https://www.bleepingcomputer.com/news/security/apple-backports-zero-day-patches-to-older-iphones-and-ipads/\">已为同一漏洞发布补丁</a>，适用于运行 iOS 26.7.1 和 iPadOS 26.7.1、macOS Tahoe 26.7.1 以及 macOS Sequoia 15.8.1 的设备。</p><p>Meta Product Security 在 CoreGraphics 中发现了这一<a href=\"https://cwe.mitre.org/data/definitions/787.html\">越界写入弱点</a>（追踪编号为 <a href=\"https://nvd.nist.gov/vuln/detail/cve-2026-86950\">CVE-2026-86950</a>）。CoreGraphics 是一个用于跨 iOS、macOS、iPadOS、watchOS 和 tvOS 实现二维矢量图形、文本绘制和图像渲染的框架。</p><p>成功利用越界写入安全问题可使攻击者导致程序崩溃、破坏数据，或通过在分配的内存缓冲区之外写入数据来获得远程代码执行。</p><p>“Apple 知悉有报告称，此问题可能已被用于针对 iOS 27 之前特定版本上特定目标 individuals 的极其复杂的攻击，”<a href=\"https://support.apple.com/en-us/149225\">Apple 周一警告称</a>。</p><p>“处理恶意构造的文件可能导致任意代码执行。已通过改进边界检查修复越界写入问题。”</p><p>随着本周的安全补丁发布，Apple 现在还修复了 iPhone XS、iPhone XS Max、iPhone XR、iPad 第 7 代、iPad Air 第 4 代及更新机型、iPad 第 9 代及更新机型，以及 iPad mini 第 6 代及更新机型上的这一漏洞。</p><p>尽管 Apple 表示 CVE-2026-86950 仅在高度定向的攻击中被利用，但强烈建议安装这些反向移植的补丁，以阻止潜在攻击。</p><p>借助这一漏洞的修复，Apple 现已修复了今年攻击中被利用的两个零日漏洞。另一个漏洞（CVE-2026-20700）是 dyld（Apple 操作系统使用的动态链接编辑器）中的任意代码执行漏洞，也曾在“极其复杂”的定向攻击中被利用，<a href=\"https://www.bleepingcomputer.com/news/security/apple-fixes-zero-day-flaw-used-in-extremely-sophisticated-attacks/\">已于 2 月发布补丁</a>。</p><p>今年早些时候，Apple 还<a href=\"https://www.bleepingcomputer.com/news/security/apple-fixes-beats-studio-buds-flaw-that-let-hackers-spy-on-conversations/\">修复了 Beats Studio Buds 的一个高危漏洞</a>（CVE-2025-20701），该漏洞允许处于蓝牙范围内的攻击者窃听用户对话；此外，Apple 还<a href=\"https://www.bleepingcomputer.com/news/apple/apple-patches-older-iphones-and-ipads-against-coruna-exploits/\">为较旧的 iPhone 和 iPad 发布补丁</a>，修复了四个漏洞。这些漏洞在网络间谍活动和利用 Coruna 漏洞工具包实施的加密货币窃取攻击中被针对利用。</p><p><a href=\"https://hubs.li/Q04sB3fb0\">\n            <img src=\"/dailyinfo/media/f74efd6d74a2d601.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://hubs.li/Q04sB3fb0\">攻击者一旦拥有有效凭据，其操作只有 37% 会被阻止</a>\n        </h2><p>总体预防得分可能掩盖初始访问之后所发生的情况。一旦攻击者使用有效凭据，预防效果就会大幅下降。</p><p>Blue Report 2026 在客户生产环境中运行的 338 million 次模拟中，逐项衡量了各项防御措施。</p><p><a href=\"https://hubs.li/Q04sB3fb0\">获取报告</a>\n    </p>","original","zhKind","translation","complete","yocbcrg7ag66qmssktcr4jvbu","Apple 将已被利用的 CoreGraphics 漏洞 CVE-2026-86950 修复回移至旧版 iPhone 和 iPad","漏洞","补丁","Apple","https://www.bleepingcomputer.com/news/apple/apple-backports-coregraphics-zero-day-patches-to-older-iphones/","BleepingComputer",{"_104":105,"_106":-5},"changelogVersion","2026-10-01T08:00","release"]
