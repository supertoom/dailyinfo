[{"_1":2,"_3":4},"root",{"_5":88},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1794444096000,"id","nypzu48uooruzzhyeowlg5cl5","title","Active Storage 8.1 存在视频预览与图像处理任意文件读取及 RCE 风险","originalTitle","Active Storage: Possible arbitrary file read and remote code execution in video previews, analysis and image processing","summary","Active Storage 8.1, < 8.1.4.1 存在漏洞，攻击者可通过控制上传文件名和内容类型影响 ffprobe、ffmpeg 与 ImageMagick 选择的解码器，利用启用 AviSynth 的 FFmpeg 读取应用可访问文件或加载上传的本地库，可能导致 RCE。","reason","文章梳理了上传文件名如何影响外部工具解码器选择，并给出受影响条件、升级版本、补丁与临时规避方法，便于维护者评估处置优先级。","source",{"_72":87},"links",{"_60":86},"publishedAt","2026-11-10T21:38:55.000Z","discoveredAt","2026-11-10T22:03:35.063Z","timelineAt","category","vuln","tags",[81,82,83,84,85],"score",75,"selected",true,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[67,68,69],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fUnk6Rg-9L88","reportCount",1,"additionalSourceCount",0,{"_70":75,"_72":76},{"_70":31,"_72":74},{"_70":71,"_72":73},"slug","research","name","技术研究","漏洞披露","ai-agent","AI Agent 安全",{"_78":79,"_13":80},"publicId","cb22956a-233d-4cb5-9772-77ad50f77576","Active Storage 修复文件读取与 RCE 风险","漏洞","补丁","漏洞利用","漏洞分析","大模型","https://github.com/advisories/GHSA-v924-7rp8-4mxh","GitHub 安全公告",{"_89":90,"_91":-5},"changelogVersion","2026-10-01T08:00","release"]
