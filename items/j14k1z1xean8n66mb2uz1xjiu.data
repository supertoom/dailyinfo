[{"_1":2,"_3":4},"root",{"_5":106},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1794530486000,"id","j14k1z1xean8n66mb2uz1xjiu","title","虚假 Zillow 租房页面借 ClickFix 在 Windows 电脑安装 NetSupport RAT","originalTitle","Fake Zillow pages use ClickFix NetSupport RAT to target apartment hunters","summary","EfficientIP Research Labs 发现虚假 Zillow 公寓评价页面利用 ClickFix，诱使用户通过 Win+R、Ctrl+V、Enter 执行 PowerShell 命令，在 Windows 电脑安装 NetSupport RAT。","reason","source",{"_74":105},"links",{"_61":104},"publishedAt","2026-11-12T23:15:23.000Z","discoveredAt","2026-11-13T00:00:22.878Z","timelineAt","category","activity","tags",[77,75,102,103,81],"score",63,"selected",false,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Mirko Zorz","body",{"_98":-5,"_61":99,"_100":-5,"_101":36},"outline",[86,87,88],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","f8VBmu6Ak37g","reportCount",1,"additionalSourceCount",0,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","malware","name","恶意软件","attack","攻击活动","email","邮件与钓鱼","cloudflare","Cloudflare",{"_83":84,"_13":85},"publicId","57bcd05a-889b-4035-a4bb-f3a4b98c0a67","虚假Zillow页面借ClickFix投递RAT",{"_11":96,"_90":97,"_92":93},{"_11":94,"_90":95,"_92":93},{"_11":89,"_90":91,"_92":93},"sec-3","text","Digging up the rest","level",3,"sec-2","How the links probably got out","sec-1","Three keys and you’re done","zh","<p>EfficientIP Research Labs traced a ClickFix campaign that used fake Zillow apartment-review pages to install NetSupport RAT on visitors’ Windows computers.</p><p><img src=\"/dailyinfo/media/58a449e95334e203.webp\" loading=\"lazy\" decoding=\"async\" alt=\"OPIS\" title=\"Zillow\"></p><p>Each page showed what looked like a routine verification check. Behind it, the page quietly copied a PowerShell command to the clipboard and walked the visitor through pasting and running it. Doing that installs remote-control software that keeps its window hidden and starts back up every time the user logs in.</p><p>Renters are the people most at risk, and so is anyone who checks listings on a work laptop. Once NetSupport is running, an attacker can reach any file the logged-in user can reach. EfficientIP detected the first domains in August 2026.</p><h3 id=\"sec-1\">Three keys and you’re done</h3><p><a href=\"https://www.helpnetsecurity.com/2026/07/15/clickfix-social-engineering-attacks-report/\">ClickFix</a> is a social engineering trick that gets users to pass a fake check by running a command themselves. On these pages, clicking Continue loaded the clipboard, and the instructions read Win+R, Ctrl+V, Enter. The command fetched a script from an IP address written as a decimal number, 1495423691, which converts to 89.34.90.203.</p><p>The script hid its PowerShell window and used a Python runtime it downloaded to pull a ZIP archive from the same address. It unpacked NetSupport into AppData and dropped a shortcut in the Windows Startup folder. NetSupport Manager is legitimate remote administration software. The attackers used it for the job it was built for, on computers owned by people who thought they were reading apartment reviews.</p><h3 id=\"sec-2\">How the links probably got out</h3><p>The researchers worked from the infrastructure side and did not see how victims reached the pages. Karim Hossen, the company’s CISO, offered an assessment.</p><p>“Most likely: links sent directly to targets, probably in a rental listing scam context (e.g. a fake landlord or agent sending a “check the reviews / verify before the visit” link by email, SMS or messaging app),” he told Help Net Security.</p><p>“The domains were newly registered, short-lived and used random numeric suffixes (e.g. apartments-review8509831[.]sbs). They also used wildcard subdomains (*.verify.apartments-review[.]sbs), which are typical of unique per-target or per-campaign links.”</p><p>He rated malicious ads and redirect chains less likely, because the researchers saw no evidence of an ad or redirect layer. He rated search poisoning least likely of all. “Throwaway domains with random numbers that lived only a few days would rarely appear in search results, and nobody would type them manually.”</p><p>If he’s right, the red flag shows up before you ever see the page. It’s the message from someone who says they’ve got the perfect apartment and just need you to click one link first.</p><h3 id=\"sec-3\">Digging up the rest</h3><p>EfficientIP first spotted a handful of these domains in its passive DNS data, which logs which names resolved to which addresses over time. The names all followed one pattern: apartments-review plus digits, on the .sbs top-level domain. Live DNS records told the researchers little, because the domains lived briefly and sat behind Cloudflare, which hid the hosting.</p><p>The researchers then searched Certificate Transparency logs, the public record of issued TLS certificates, and found domains that were missing from their DNS data. The domains did not consistently share nameservers and resolved to different Cloudflare addresses. The pages still gave them away: they used the same fake Zillow template, the same encoded IP and download path, and the same NetSupport deployment.</p><p>The installed NetSupport client pointed to two gateway domains, asgomd[.]com and asgrsv[.]com. “Pivoting on their IP addresses revealed seven additional domains following the same short naming pattern (e.g. bksju, decrmd, jpgomd, nogomd, decrsv, jpgrsv),” Hossen said. “Their shared “-md”/”-rsv” suffixes suggest they were registered as a single set of gateway infrastructure for this operator.”</p><p>The researchers have not tied the operator to a known group. “NetSupport RAT is widely abused with cracked or reused licenses across many unrelated actors, so license strings alone are a weak attribution signal unless they match a documented cluster,” Hossen said. “We consider this activity part of the broader ClickFix/NetSupport ecosystem rather than an attributed campaign.”</p>","zhKind","complete","钓鱼","后门","https://www.helpnetsecurity.com/2026/11/13/fake-zillow-clickfix-netsupport-rat/","Help Net Security",{"_107":108,"_109":-5},"changelogVersion","2026-10-01T08:00","release"]
