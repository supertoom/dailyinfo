[{"_1":2,"_3":4},"root",{"_5":105},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1795826452000,"id","t6uwzah42cn6jaqs5uqqpomuj","title","Cacti 远程代码执行漏洞 4http2shell 曝光，CVSS 9.8，PoC 已公开","originalTitle","【漏洞通告】Cacti远程代码执行漏洞（4http2shell）","summary","Cacti 远程代码执行漏洞（4http2shell，又称 4HTTP2ROOT）细节与 PoC 已公开，CVSS 评分 9.8。","reason","source",{"_72":104},"links",{"_96":103},"publishedAt","2026-11-27T10:35:00.000Z","discoveredAt","2026-11-27T17:02:38.517Z","timelineAt","category","vuln","tags",[99,100,101,102,75],"score",65,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body",{"_60":95,"_96":-5,"_97":96,"_98":55},"outline",[81,82,83,84],"relatedStories",[77],"topics",[67,68,69],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","f6ZAsYycycU8","reportCount",4,"additionalSourceCount",3,{"_70":30,"_72":76},{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","research","name","技术研究","exploited","在野利用","漏洞披露",{"_78":79,"_13":80},"publicId","5f727b7b-3657-4338-b837-306e337b299b","Cacti 1.2.31未授权RCE PoC已公开",{"_11":93,"_86":94,"_88":66},{"_11":91,"_86":92,"_88":66},{"_11":89,"_86":90,"_88":66},{"_11":85,"_86":87,"_88":66},"sec-4","text","4.2 其他防护措施","level","sec-3","4.1 官方升级","sec-2","3.1 人工检测","sec-1","受影响版本","<p><span>NS-CERT</span> <span>2026-11-27 18:35</span> <span>四川</span></p><p><img src=\"/dailyinfo/media/e3c313055492a00d.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>近日，绿盟科技CERT监测到到网上披露了Cacti远程代码执行漏洞（4http2shell），又称“4HTTP2ROOT”；CVSS评分9.8，目前漏洞细节与PoC已公开，请相关用户尽快采取措施进行防护。</p><p><strong><span>通告编号 NS-2026-0042</span></strong></p><p><span><span>2026-11-27</span></span></p><table><tbody><tr><td><strong><span><span>TAG：</span></span></strong></td><td colspan=\"3\"><p><strong><span><span>Cacti、远程代码执行、4http2shell</span></span></strong></p></td></tr><tr><td><strong><span><span>在野利用：</span></span></strong></td><td><p><strong><span>未发现</span></strong></p></td><td><strong><span><span>PoC状态：</span></span></strong></td><td><p><strong><span>已公开</span></strong></p></td></tr><tr><td><strong><span><span>漏洞危害：</span></span></strong></td><td colspan=\"3\"><p><strong><span>攻击者利用此漏洞，可实现远程代码执行。</span></strong></p></td></tr></tbody></table><p><strong><span>1</span></strong></p><p><strong><span><span>漏洞概述</span></span></strong></p><p><span>近日，绿盟科技CERT监测到到网上披露了Cacti远程代码执行漏洞（4http2shell），又称“4HTTP2ROOT”；由于Cacti未正确验证用户配置项preview_graphs_per_page且数据库默认配置可被直接拼接至SQL LIMIT子句中，在启用访客账户的情况下，未经身份验证的攻击者可利用堆叠查询将poller_item.arg1修改为恶意命令，并通过访客可访问的实时图表接口触发轮询器执行，从而以Cacti进程权限执行任意代码。CVSS评分9.8，目前漏洞细节与PoC已公开，请相关用户尽快采取措施进行防护。</span></p><p><span>Cacti是一款基于PHP、MySQL、SNMP及RRDTool开发的网络流量监测图形分析工具，提供数据存储、图形展示、阈值告警和集中监控等功能，广泛应用于企业网络及基础设施监控场景。</span></p><p><span>参考链接：</span></p><p><span><a href=\"https://watchtowr.com/intelligence/4http2root-cacti-zero-day-faq/\">https://watchtowr.com/intelligence/4http2root-cacti-zero-day-faq/</a></span></p><p><strong><span>SEE MORE →</span></strong></p><p><span><strong><span>2</span></strong></span><strong><span>影响范围</span></strong></p><h3 id=\"sec-1\"><strong><span>受影响版本</span></strong></h3><ul><li><p><span>Cacti = 1.2.31（已验证版本）</span></p></li></ul><p><span>注：影响启用Guest账户且接口可被访问的Cacti实例。</span></p><p><span><strong><span>3</span></strong></span><strong><span>漏洞检测</span></strong></p><h3 id=\"sec-2\"><strong><span>3.1 人工检测</span></strong></h3><p><span>相关用户可以通过检查Cacti版本及访客账户配置情况，判断当前Cacti实例是否在受影响范围：</span></p><p><span>1、检查Cacti版本：登录Cacti Web控制台，在“Utilities &gt; System Utilities”页面中查看Cacti Version；或查看页面底部显示的版本信息。</span></p><p><span>2、检查匿名访客访问配置：在“Settings &gt; Authentication &gt; Special Users”中查看“Guest User”配置。若设置为“No User”，表示未启用匿名访客访问；若已指定具体用户，还需在“User Management”中确认该用户的“Enabled”状态为启用。</span></p><p><span>若当前Cacti版本在受影响范围，且访客账户处于启用状态，则可能存在安全风险。</span></p><p><span><strong><span>4</span></strong></span><strong><span>漏洞防护</span></strong></p><h3 id=\"sec-3\"><strong><span>4.1 官方升级</span></strong></h3><p><span>目前官方暂未发布更新修复此漏洞，请受影响的用户关注官方安全动态并及时更新，下载链接：<a href=\"https://www.cacti.net/download_cacti.php\">https://www.cacti.net/download_cacti.php</a></span></p><h3 id=\"sec-4\"><strong><span>4.2 其他防护措施</span></strong></h3><p><span>在不影响业务的情况下，相关用户可采取以下措施进行临时缓解：</span></p><p><span>1、禁用Cacti访客账户，并对Cacti Web界面进行访问限制。</span></p><p><span>2、检查poller配置中是否存在异常命令，关注日志中图表显示设置出现非数字值的告警。</span></p><p><strong><span>END</span></strong></p><p><img src=\"/dailyinfo/media/ec718f7fd3aed0fb.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img src=\"/dailyinfo/media/25fca4a01fe6013f.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>声明</span></strong></p><p><span>本安全公告仅用来描述可能存在的安全问题，绿盟科技不为此安全公告提供任何保证或承诺。由于传播、利用此安全公告所提供的信息而造成的任何直接或者间接的后果及损失，均由使用者本人负责，绿盟科技以及安全公告作者不为此承担任何责任。</span></p><p><span>绿盟科技拥有对此安全公告的修改和解释权。如欲转载或传播此安全公告，必须保证此安全公告的完整性，包括版权声明等全部内容。未经绿盟科技允许，不得任意修改或者增减此安全公告内容，不得以任何方式将其用于商业目的。</span></p><p><img src=\"/dailyinfo/media/25fca4a01fe6013f.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><span><strong><span>绿盟科技CERT</span></strong></span><span><span>∣</span></span><span><span>微信公众号</span></span></p><p><img src=\"/dailyinfo/media/6fa8ce620066ed4c.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><img src=\"/dailyinfo/media/aa2af560d3f15c63.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>长按识别二维码，关注网络安全威胁信息</span></span></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=e16294a5&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzk0MjE3ODkxNg%3D%3D%26mid%3D2247494345%26idx%3D2%26sn%3Daf749b2d53a53c28ab268b1425be5f53\">跳转微信打开</a></p>","original","zhKind","complete","漏洞","复现","漏洞利用","漏洞分析","https://mp.weixin.qq.com/s?__biz=Mzk0MjE3ODkxNg==&mid=2247494345&idx=2&sn=af749b2d53a53c28ab268b1425be5f53","绿盟科技CERT",{"_106":107,"_108":-5},"changelogVersion","2026-10-01T08:00","release"]
