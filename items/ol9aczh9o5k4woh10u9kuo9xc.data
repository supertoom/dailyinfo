[{"_1":2,"_3":4},"root",{"_5":91},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":-5,"_57":36,"_58":59},"expiresAt",1794195832000,"id","ol9aczh9o5k4woh10u9kuo9xc","title","Security Affairs 第 122 期恶意软件新闻汇总","originalTitle","SECURITY AFFAIRS MALWARE NEWSLETTER ROUND 122","summary","Security Affairs 第 122 期汇总 12 篇恶意软件研究与报道，涉及 APT 利用 NetamLoader 攻击亚洲政府定制 Win10 系统、APT29 通过 watering holes 利用 n-day 攻击移动设备，以及托管后门、恶意 PyPI 包检测和恶意软件感染后行为分析等主题。","reason","source",{"_66":90},"links",{"_59":89},"publishedAt","2026-11-08T14:24:29.000Z","discoveredAt","2026-11-08T17:07:21.262Z","timelineAt","category","blue-team","tags",[84,69,67,85,86,87,88],"score",10,"selected",false,"channel","news","story","x","readingMode","full","author","Pierluigi Paganini","body",{"_80":-5,"_59":81,"_82":-5,"_83":36},"outline",[74],"relatedStories",[],"topics",[60,61,62,63],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_64":72,"_66":73},{"_64":70,"_66":71},{"_64":68,"_66":69},{"_64":65,"_66":67},"slug","ai-security","name","AI 安全","malware","恶意软件","ai-agent","AI Agent 安全","microsoft","Microsoft / 微软",{"_11":75,"_76":77,"_78":79},"sec-1","text","Security Affairs Malware newsletter includes a collection of the best articles a","level",2,"zh","<h2 id=\"sec-1\">Security Affairs Malware newsletter includes a collection of the best articles and research on malware in the international landscape</h2><p>Malware Newsletter</p><p><a href=\"https://securelist.com/netamloader/121676/\">Unknown APT uses NetamLoader to attack a Win10 OS customized for governments in Asia</a>&nbsp;&nbsp;</p><p><a href=\"https://cloud.google.com/blog/topics/threat-intelligence/shutting-the-door-on-the-xcpe-botnet/\">Shutting the Door on the XCPE Botnet</a>&nbsp;&nbsp;</p><p><a href=\"https://dreamgroup.com/blog/darkblinders-inside-an-active-espionage-campaign\">DarkBlinders: Inside an Active Espionage Campaign</a>&nbsp;&nbsp;</p><p><a href=\"https://research.checkpoint.com/2026/free-the-model-sell-the-gateway-prompt-adware-hidden-in-jailbreak-bundles/\">Free the Model, Sell the Gateway: Prompt Adware hidden in Jailbreak Bundles</a>&nbsp;&nbsp;</p><p><a href=\"https://www.sekoia.com/blog/poisoned-source-apt29-watering-holes-targets-mobile-devices-with-n-day-exploits\">Poisoned Source: APT29 watering holes target mobile devices with n-day exploits</a>&nbsp;</p><p><a href=\"https://www.bleepingcomputer.com/news/security/hackers-hijack-cpguard-autoupdate-to-deploy-backdoor-steal-data/\">Hackers hijack cPGuard autoupdate to deploy backdoor, steal data</a>&nbsp;&nbsp;</p><p><a href=\"https://blog.xlab.qianxin.com/cwpdoor-the-invisible-backdoor-living-inside-control-web-panel/\">CWPdoor: The Invisible Backdoor Living Inside Control Web Panel</a>&nbsp;&nbsp;</p><p><a href=\"https://news.drweb.com/show/?i=15311&amp;lng=en&amp;c=5\">Insolence beyond belief. Threat actors target information security developers on GitHub</a>&nbsp;&nbsp;</p><p><a href=\"https://arxiv.org/abs/2611.03774\">What Malware Actually Does: An Empirical Analysis of Post-Infection Behavior Across Malware Families</a></p><p><a href=\"https://arxiv.org/abs/2611.07486\">MEvince: Knowledge-Constrained LLM Reasoning for Technique Identification from Malware Reports</a></p><p><a href=\"https://www.mdpi.com/2624-800X/6/6/189\">A Log-to-Image Transformation Framework for Behavior-Aware Malware and Anomaly Detection</a></p><p><a href=\"https://www.mdpi.com/2079-9292/15/21/5021\">Decoding Maliciousness: LLM-Assisted Semantic Filtering for Scalable Malicious PyPI Package Detection</a></p><p><strong>Follow me on Twitter:&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;hacking,&nbsp;<a href=\"https://securityaffairs.com/200354/security/security-affairs-malware-newsletter-round-117.html\">newsletter</a>)</strong></p>","zhKind","complete","汇总","后门","网络设备","大模型","Microsoft","https://securityaffairs.com/202657/malware/security-affairs-malware-newsletter-round-122.html","Security Affairs",{"_92":93,"_94":-5},"changelogVersion","2026-10-01T08:00","release"]
