[{"_1":2,"_3":4},"root",{"_5":185},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":-5,"_56":57,"_58":59},"expiresAt",1794616828000,"id","e1akisn9puw2q428mdfemr4p2","title","Claude Code、OpenClaw 与 OpenShell 路径检查后越界写入及同步投毒分析","originalTitle","【AI安全】Agent 写文件时，路径检查通过后为什么还会越界？","summary","Claude Code、OpenClaw 与 OpenShell 的文件操作均存在检查对象与实际读写对象不一致的问题。Claude Code 的 CVE-2026-103435 影响 < 2.1.129，并在 2.1.129 修复；OpenClaw v2026.2.26 可在拒绝前通过 O_TRUNC 截断或 O_CREAT 创建越界文件，v2026.3.1 将破坏性操作延后。","reason","文章通过源码追踪和对照实验揭示了检查后目录项替换导致越界截断、创建及同步投毒的共同边界问题。","source",{"_66":184},"links",{"_174":183},"publishedAt","2026-11-09T12:30:29.000Z","discoveredAt","2026-11-11T10:08:41.411Z","timelineAt","category","ai-security","tags",[68,177,70,178,179,180,181,182],"score",75,"selected",true,"channel","news","story","x","readingMode","full","author","body",{"_59":173,"_174":-5,"_175":174,"_176":37},"outline",[73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104],"relatedStories",[],"topics",[60,61,62,63],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","zh",{"_64":71,"_66":72},{"_64":69,"_66":70},{"_64":31,"_66":68},{"_64":65,"_66":67},"slug","blue-team","name","蓝队与运营","AI 安全","research","技术研究","vuln","漏洞披露",{"_11":171,"_106":172,"_108":109},{"_11":169,"_106":170,"_108":109},{"_11":167,"_106":168,"_108":114},{"_11":165,"_106":166,"_108":114},{"_11":163,"_106":164,"_108":114},{"_11":161,"_106":162,"_108":109},{"_11":159,"_106":160,"_108":114},{"_11":157,"_106":158,"_108":114},{"_11":155,"_106":156,"_108":114},{"_11":153,"_106":154,"_108":109},{"_11":151,"_106":152,"_108":114},{"_11":149,"_106":150,"_108":114},{"_11":147,"_106":148,"_108":114},{"_11":145,"_106":146,"_108":114},{"_11":143,"_106":144,"_108":109},{"_11":141,"_106":142,"_108":114},{"_11":139,"_106":140,"_108":114},{"_11":137,"_106":138,"_108":114},{"_11":135,"_106":136,"_108":114},{"_11":133,"_106":134,"_108":109},{"_11":131,"_106":132,"_108":114},{"_11":129,"_106":130,"_108":114},{"_11":127,"_106":128,"_108":114},{"_11":125,"_106":126,"_108":114},{"_11":123,"_106":124,"_108":114},{"_11":121,"_106":122,"_108":114},{"_11":119,"_106":120,"_108":109},{"_11":117,"_106":118,"_108":114},{"_11":115,"_106":116,"_108":114},{"_11":112,"_106":113,"_108":114},{"_11":110,"_106":111,"_108":109},{"_11":105,"_106":107,"_108":109},"sec-32","text","参考资料","level",2,"sec-31","七、总结","sec-30","6.3 测试要读回磁盘，不能只等一个异常",3,"sec-29","6.2 打开、提交与消费的对象绑定","sec-28","6.1 问题根因：检查对象和实际对象不是同一个","sec-27","六、问题根因与防护方案","sec-26","5.6 宿主写入修复没有覆盖同步读取","sec-25","5.5 真实 CLI：同一 inode 上传了新字节","sec-24","5.4 真实 CLI：父目录替换后，outside 内容进入远端","sec-23","5.3 同一 inode 的内容变化","sec-22","5.2 同步检查与实际读取的对象","sec-21","5.1 lstat() 和 sandbox upload 之间还隔着一次路径查找","sec-20","五、同步链：路径再次解析后的对象变化","sec-19","4.4 修复版的拒绝位置","sec-18","4.3 旧版写入结果","sec-17","4.2 临时文件和 rename() 仍按路径找","sec-16","4.1 bridge 的宿主写入路径","sec-15","四、OpenShell：临时文件也没有把落点固定住","sec-14","3.4 拒绝返回与磁盘状态","sec-13","3.3 缺失目标：拒绝前先被创建","sec-12","3.2 已有文件：O_TRUNC 早于拒绝改变了 outside","sec-11","3.1 writeFileWithinRoot() 的旧版调用顺序","sec-10","三、OpenClaw：越界拒绝前已经发生的文件副作用","sec-9","2.3 原子写入阶段再次解析 targetPath","sec-8","2.2 从路径校验到文件写入的源码调用链","sec-7","2.1 公开问题与触发条件","sec-6","二、Claude Code：检查通过后，写入目标为何还会变化","sec-5","1.3 打开与校验的先后顺序决定副作用","sec-4","1.2 路径名、目录项与 inode","sec-3","1.1 从 Agent 工具到文件系统","sec-2","一、路径检查通过后，目标仍可能变化","sec-1","引言","<h2 id=\"sec-1\">引言</h2><p>以前看 Agent 文件写入，通常先检查一件事：目标路径有没有留在 workspace 里。Claude Code 公开的 CVE-2026-103435 让我开始重新看这个问题。公告描述了检查与写入之间的时间差：权限检查通过时目标还在项目目录内；共享工作区中的另一个进程替换目录项后，Agent 再按原路径写入，文件就可能落到项目目录之外。<a href=\"https://github.com/anthropics/claude-code/security/advisories/GHSA-5j29-h97v-84ch\">Anthropic 的公告</a></p><p>我想弄清楚的是，检查通过时程序确认的究竟是什么。如果它确认的只是一个路径字符串，那么等到真正打开文件时，内核解析到的还会是同一个对象吗？即使函数最后返回拒绝，拒绝之前有没有可能已经改动磁盘？沿着这两个问题，从 Claude Code 公告中的时序开始，再去看 OpenClaw 和 OpenShell 的真实写入与同步函数。</p><h2 id=\"sec-2\">一、路径检查通过后，目标仍可能变化</h2><h3 id=\"sec-3\">1.1 从 Agent 工具到文件系统</h3><p>Agent 发起一次 <code>write_file(path, content)</code>，宿主侧还要解析参数、检查权限、打开或创建文件，再把内容提交到磁盘。模型给出目标路径和数据，最终调用文件系统接口的是持有宿主权限的进程。</p><p>权限检查处理的是某一时刻的路径；写入操作针对的是最后实际打开的文件对象。如果实现只把路径字符串传给后续的 <code>open()</code>、<code>rename()</code> 或同步函数，文件系统就会再次查找目录项。同一字符串因此可能先后指向不同对象。</p><p>这里讨论的是本地文件系统中的共享目录项竞态。攻击者需要能替换相关目录项，并赶在 Agent 后续使用路径前完成操作；宿主进程则需要有权访问工作区外目标。攻击者借用的是宿主已有的文件权限。若这两个条件不成立，越界链就无法完成。</p><h3 id=\"sec-4\">1.2 路径名、目录项与 inode</h3><p><code>workspace/draft.txt</code> 是一次查找所用的路径名，不是文件本身。文件系统会从起点逐级查找目录项：<code>workspace</code> 目录项指向一个目录对象，目录中的 <code>draft.txt</code> 再指向具体文件对象。对本文讨论的本地文件系统，可以用 inode 标识文件对象；路径名描述“怎么找到它”，inode 描述“这次找到的是谁”。</p><p>符号链接本身保存一段路径，解析器遇到它时会继续查找链接目标。若相关目录项在两次操作之间被替换，同一条路径字符串下一次解析时就可能指向另一个对象。硬链接则会新建一个指向同一 inode 的目录项，不会把一个路径重定向到另一个 inode；但通过任一硬链接修改文件内容，其他名字看到的也是同一份内容。前者改变路径解析结果，后者让多个名称共享同一个文件对象，两类风险不能混为一谈。</p><p>文件描述符则绑定到已经打开的对象。打开后，即使原路径名被重命名或替换，已有描述符仍引用原先打开的文件；程序若随后再次调用 <code>open(path)</code>、按路径执行 <code>rename()</code>，或让同步函数重新读取 <code>path</code>，仍会进行新的路径解析。也就是说，FD 可以固定一次打开的对象，但只有在安全地完成打开之后才有这个作用；如果第一次打开已经落到越界目标，FD 只会稳定地指向这个目标。</p><p>机制的初始目录如下：</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203615-27aef882-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=f6b65afe6352eae5\" loading=\"lazy\" decoding=\"async\" width=\"658\"></p><p>在这个最小目录里，<code>workspace/draft.txt</code> 初始解析到工作区内的 inode A，<code>outside/canary.txt</code> 是工作区外用于观察状态变化的 inode B。若 <code>workspace/draft.txt</code> 的目录项被替换成指向 <code>outside/canary.txt</code> 的符号链接，这串路径字符可以保持不变，下一次查找却会走到 inode B。父目录重绑定也是同样的道理：后续查找会从被替换的目录项继续解析。最终要靠 Canary 读回确认受影响的对象，不能只根据函数返回值判断有没有越界。</p><h3 id=\"sec-5\">1.3 打开与校验的先后顺序决定副作用</h3><p>路径检查通过，不代表后续操作仍会作用于当时检查的对象。检查之后如果目录项被替换，程序再次按路径打开或提交文件，就可能走到另一个目标；如果 <code>open()</code> 本身带有截断或创建标志，副作用还可能早于最终校验。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203616-2814d5a3-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=3e09ae4ef122d9cc\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203616-2814d5a3-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=533361826d2d39a1 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203616-2814d5a3-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=0e35692d4db0f90b 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203616-2814d5a3-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=3e09ae4ef122d9cc 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"974\"></p><p>真正的问题在于，同一条路径会被多次解析：第一次用于检查，之后又用于打开、提交或同步读取。目录项只要在两次解析之间发生变化，后一次操作就可能落到另一个对象；带有 <code>O_TRUNC</code> 或 <code>O_CREAT</code> 时，文件状态甚至会在拒绝返回前先改变。三个案例分别把这个窗口放在写入、打开和同步阶段。下面先从 Claude Code 的源码看路径为什么会被重新解析，再把相同的时序落到 OpenClaw 和 OpenShell 的实际文件状态上。</p><h2 id=\"sec-6\">二、Claude Code：检查通过后，写入目标为何还会变化</h2><h3 id=\"sec-7\">2.1 公开问题与触发条件</h3><p>Anthropic 披露的 CVE-2026-103435 描述了一次发生在正常文件编辑中的越界写入：Claude Code 检查目标路径时，文件还位于项目目录；真正写入时，程序再次按路径名解析目标。共享工作区里的另一个进程可以在这段间隙替换目录项，让原路径转而指向项目外的文件。<a href=\"https://github.com/anthropics/claude-code/security/advisories/GHSA-5j29-h97v-84ch\">Anthropic 公告</a>将受影响版本列为 <code>&lt; 2.1.129</code>，并在 <code>2.1.129</code> 修复。</p><p>要让这条链成立，攻击者必须能修改共享工作区中的目录项，并在文件写入前完成替换；宿主进程也必须有权限访问项目外的目标。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203616-286f5a21-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=63c2909728ca77bd\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203616-286f5a21-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=aea3cb2d27befdfa 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203616-286f5a21-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=27add52d63f1b4d0 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203616-286f5a21-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=63c2909728ca77bd 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1027\"></p><p>工具参数始终是 <code>workspace/draft.txt</code>，变化的是这串路径对应的对象。接下来沿源码追踪权限检查结果是否被写入阶段继续使用。</p><h3 id=\"sec-8\">2.2 从路径校验到文件写入的源码调用链</h3><p>沿着 Claude Code 2.1.87 的源码快照追调用链。这里的源码只用来说明权限检查结果如何传到落盘函数，不把它写成 Claude Code CLI 的运行结果；问题背景和受影响版本仍以 Anthropic 公告为准。</p><p><code>FileWriteTool.checkPermissions()</code> 将工具输入交给 <code>checkWritePermissionForTool()</code>（<a href=\"https://github.com/freecodexyz/free-code/blob/4b9d30f7953273e567a18eb819f4eddd45fcc877/src/tools/FileWriteTool/FileWriteTool.ts#L135-L142\">FileWriteTool.ts，L135–L142</a>）。该函数通过 <code>tool.getPath(input)</code> 取出目标；如果调用方没有提供预先计算的路径集合，才调用 <code>getPathsForPermissionCheck()</code> 生成待检查路径。</p><p>源码位置：<a href=\"https://github.com/freecodexyz/free-code/blob/4b9d30f7953273e567a18eb819f4eddd45fcc877/src/utils/permissions/filesystem.ts#L1205-L1375\">filesystem.ts，L1205–L1375</a>。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203617-28e53557-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=6077cba6c0c686c9\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203617-28e53557-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=896a5d07ca67e671 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203617-28e53557-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=d447afbadefa168c 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203617-28e53557-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=6077cba6c0c686c9 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1200\"></p><p>这里不是简单地检查路径里有没有 <code>../</code>。<code>getPathsForPermissionCheck()</code> 会把原始路径、符号链接链上的目标和最终解析路径放进待检查集合；目标尚不存在时，它会向上找到最深的现存路径，解析其中的符号链接，再把尚未创建的路径部分补回候选集合。具体实现位于 <a href=\"https://github.com/freecodexyz/free-code/blob/4b9d30f7953273e567a18eb819f4eddd45fcc877/src/utils/fsOperations.ts#L288-L381\">fsOperations.ts，L288–L381</a>。之后，<code>pathInAllowedWorkingPath()</code> 再把这些路径与当前工作目录及附加工作目录比较。</p><p>源码还要求 <code>precomputedPathsToCheck</code> 必须由同一个工具输入派生，避免把旧路径集合用于另一个请求；但这仍只是路径集合，不会固定文件对象。</p><p>检查函数返回的是 <code>PermissionDecision</code>；它没有打开目标，也没有把一个已打开的文件描述符交给写入阶段。权限检查通过后，<code>FileWriteTool.call()</code> 又从工具参数里的 <code>file_path</code> 生成 <code>fullFilePath</code>，再创建父目录、读取文件状态，最后把这个路径传给 <code>writeTextContent()</code>。</p><p>源码位置：<a href=\"https://github.com/freecodexyz/free-code/blob/4b9d30f7953273e567a18eb819f4eddd45fcc877/src/tools/FileWriteTool/FileWriteTool.ts#L223-L305\">FileWriteTool.ts，L223–L305</a>。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203618-2985e932-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=5b52deb7ba40bb8c\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203618-2985e932-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=504b235a60cf51db 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203618-2985e932-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=8e33961921979caf 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203618-2985e932-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=5b52deb7ba40bb8c 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"999\"></p><p>两个阶段之间传递下去的仍是路径名。写入前比较修改时间和内容，可以避免覆盖刚完成的编辑，却不能证明内核随后按 <code>fullFilePath</code> 打开的仍是检查时那个 inode。从生成路径到调用写入函数之间还有目录处理、诊断通知和文件历史等操作；共享工作区里的其他进程不受这些内部并发控制约束。</p><h3 id=\"sec-9\">2.3 原子写入阶段再次解析 <code>targetPath</code></h3><p><code>writeTextContent()</code> 最后调用 <code>writeFileSyncAndFlush_DEPRECATED()</code>。这个函数采用临时文件再重命名的方式提交内容；提交前，它会重新处理传入的 <code>filePath</code>。</p><p>源码位置：<a href=\"https://github.com/freecodexyz/free-code/blob/4b9d30f7953273e567a18eb819f4eddd45fcc877/src/utils/file.ts#L362-L437\">file.ts，L362–L437</a>。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203619-2a037aca-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=f36da3f4f9bc8306\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203619-2a037aca-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=6bd1f9583a60496f 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203619-2a037aca-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=ecc969eb86acb70e 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203619-2a037aca-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=f36da3f4f9bc8306 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1200\"></p><p>为了保留符号链接语义，函数在写入阶段调用 <code>readlinkSync()</code>。如果 <code>filePath</code> 此时是符号链接，它会读取当前链接内容，更新 <code>targetPath</code>，再用这个目标构造临时文件名。决定写入位置的，是写入阶段重新读取到的链接目标。</p><p>临时文件写好后，代码再用 <code>renameSync()</code> 把它提交到 <code>targetPath</code>：</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203620-2a71c1ac-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=a36431066e33fe09\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203620-2a71c1ac-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=b37b5b95290cf113 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203620-2a71c1ac-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=646d7d123805778e 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203620-2a71c1ac-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=a36431066e33fe09 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"990\"></p><p>检查时 <code>workspace/draft.txt</code> 指向工作区文件；若检查后被换成指向 <code>outside/canary.txt</code> 的符号链接，写入函数读取到的就是新目标。临时文件加 <code>renameSync()</code> 能避免提交半截内容，却不能保证目标仍在授权目录内；被替换的是父目录时，临时文件创建和重命名也会重新解析路径。</p><p>Claude Code 这部分的关键不在于有没有临时文件，而在于权限检查没有把目标变成一个固定的文件对象：<code>FileWriteTool.call()</code> 重新从 <code>file_path</code> 生成路径，原子写入又用 <code>readlinkSync()</code> 和 <code>renameSync()</code> 重新解析。目录项如果在中间被替换，检查时看到的对象就不再约束最终写入。</p><p>接下来换到 OpenClaw 的真实函数，直接看 <code>fs.open()</code> 早于后置校验时，<code>O_TRUNC</code> 和 <code>O_CREAT</code> 会不会先改变磁盘状态。</p><h2 id=\"sec-10\">三、OpenClaw：越界拒绝前已经发生的文件副作用</h2><h3 id=\"sec-11\">3.1 <code>writeFileWithinRoot()</code> 的旧版调用顺序</h3><p>公开问题 <a href=\"https://github.com/openclaw/openclaw/security/advisories/GHSA-x82f-27x3-q89c\">GHSA-x82f-27x3-q89c</a> 给出了验证入口。我对照受影响版本 <code>v2026.2.26</code> 和修复版本 <code>v2026.3.1</code>，分别导入对应标签中的真实函数，只替换加载的源码版本。观察重点是函数返回拒绝时 outside 文件的状态，而不只是异常类型。</p><p>旧标签 <code>v2026.2.26/src/infra/fs-safe.ts</code> 的写入标志是：</p><pre><code>const OPEN_WRITE_FLAGS =\n  fsConstants.O_WRONLY |\n  fsConstants.O_CREAT |\n  fsConstants.O_TRUNC |\n  (SUPPORTS_NOFOLLOW ? fsConstants.O_NOFOLLOW : 0);</code></pre><p>写入函数的关键顺序可以抽象成：</p><pre><code>rootReal = realpath(rootDir)\nresolved = path.resolve(rootReal, relativePath)\nassertNoPathAliasEscape(resolved, rootReal)\nresolvedRealPath = realpath(resolved)       # 已有目标时\nioPath = resolvedRealPath 或 resolved      # 缺失目标时\nfs.open(ioPath, O_WRONLY|O_CREAT|O_TRUNC|O_NOFOLLOW)\nhandle.stat() + lstat(ioPath) + inode 比较\nrealpath(ioPath) + 根目录检查\nhandle.writeFile(data)</code></pre><p>这里最容易漏掉的是时间顺序：<code>realpath()</code> 只记录检查那一刻的结果，后面的 <code>fs.open(ioPath, flags)</code> 仍然拿字符串重新查目录项。检查阶段选中的对象没有通过 FD 传给打开阶段。实验只替换父目录 <code>inside</code>，最后一段 <code>target.txt</code> 完全不动，但同一个路径已经可以指到 outside。</p><p>旧版的动作顺序是：先用 <code>realpath</code> 和根目录检查路径，随后进入 <code>fs.open()</code>。钩子在真正打开前把 <code>inside</code> 换成指向 outside 的目录；放行后，<code>O_TRUNC</code> 先作用于 outside，函数才用句柄身份和根目录再做复核。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203621-2ae4901c-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=049dcd40cca097de\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203621-2ae4901c-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=ebc2ad3de6cba9b9 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203621-2ae4901c-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=110062a475d615a1 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203621-2ae4901c-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=049dcd40cca097de 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"900\"></p><p>实际执行时，路径检查已经完成，<code>inside</code> 才被替换；<code>fs.open()</code> 随后重新解析 <code>ioPath</code>，<code>O_TRUNC</code> 先作用于 outside，句柄身份和根目录检查最后才返回 <code>invalid-path</code>。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203621-2b57ed4f-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=16618a5aba17b7e4\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203621-2b57ed4f-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=50eb2168a9830d5e 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203621-2b57ed4f-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=44b009a9d08f9faa 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203621-2b57ed4f-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=16618a5aba17b7e4 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1200\"></p><p>第42–46行的 <code>OPEN_WRITE_FLAGS</code> 含 <code>O_CREAT</code> 和 <code>O_TRUNC</code>，所以打开动作可以创建文件，也可以清空已有文件。平台支持时还会加入 <code>O_NOFOLLOW</code>；它约束路径最后一段，不会阻止系统解析被替换的父目录 <code>inside -&gt; outside</code>。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203622-2bc9b675-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=8d6b1421b3363c81\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203622-2bc9b675-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=83fbfe50f9b3a1da 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203622-2bc9b675-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=5a0d926349996b91 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203622-2bc9b675-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=8d6b1421b3363c81 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1200\"></p><p>第225行先调用 <code>fs.open()</code>，第237行才通过 <code>handle.stat()</code>、<code>lstat(ioPath)</code> 比较句柄和当前路径对应的对象。身份检查能够发现打开结果与路径状态不符，却不能撤销 <code>open()</code> 已经执行的截断或创建。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203623-2c26d716-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=5ba35545ce1da24f\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203623-2c26d716-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=45a76ab696af0489 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203623-2c26d716-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=0e6baf92231371e2 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203623-2c26d716-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=5ba35545ce1da24f 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"730\"></p><p>第256–263行才检查 <code>realPath</code> 是否仍在根目录内，检查通过后才执行 <code>handle.writeFile(data)</code>。因此旧版的拒绝发生在写入数据之前，但晚于 <code>O_TRUNC</code> 和 <code>O_CREAT</code>。已有文件用例中的 <code>NEW</code> 不会写入 outside；之后看到的空文件来自 <code>open()</code> 的截断。源码位置：<a href=\"https://github.com/openclaw/openclaw/blob/v2026.2.26/src/infra/fs-safe.ts#L39-L261\">OpenClaw v2026.2.26 </a><code>src/infra/fs-safe.ts</code><a href=\"https://github.com/openclaw/openclaw/blob/v2026.2.26/src/infra/fs-safe.ts#L39-L261\">，L39–L261</a>。</p><h3 id=\"sec-12\">3.2 已有文件：<code>O_TRUNC</code> 早于拒绝改变了 outside</h3><p>实验直接加载两个标签中的 <code>fs-safe.ts</code>，调用真实的 <code>writeFileWithinRoot()</code>。两个版本、被测文件哈希和运行环境已经固定；每个用例使用独立临时目录，先记录初态，函数返回后再独立读回磁盘。</p><p>目录结构是 <code>workspace/inside/target.txt</code> 和 <code>outside/target.txt</code>。触发点设在真实函数调用 <code>fs.open()</code> 时：钩子先把 <code>inside</code> 改名为 <code>old-inside</code>，再创建 <code>inside -&gt; outside</code>，然后调用原始 <code>fs.open()</code>。因此，受控替换发生在路径检查之后、实际打开之前；没有修改被测函数，也没有模拟 <code>open()</code> 的返回值。已有文件用例预置 4096 个 <code>X</code>，缺失文件用例确保两个目标都不存在。</p><p>以“已有文件、旧版”为例，先确认初始状态：</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203624-2d0a88d8-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=d9d6b43788999353\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203624-2d0a88d8-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=7eeada8bba4d2c19 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203624-2d0a88d8-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=0a6d613c99a78c6c 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203624-2d0a88d8-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=d9d6b43788999353 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1086\"></p><p>初始状态中，工作区目标内容为 INSIDE，outside Canary 为 4096 字节。</p><p>接着调用真实函数。拦截点只放在 <code>fs.open()</code> 前：先将 <code>inside</code> 改名为 <code>old-inside</code>，再建立 <code>inside -&gt; outside</code>，最后把原路径和标志交给系统打开。终端输出里的 <code>injection</code>、<code>openFlags</code>、<code>result</code> 和 <code>outside</code> 分别对应替换是否命中、实际打开标志、函数返回和独立磁盘读回。</p><p>这个钩子把竞态固定在“路径校验后、系统打开前”，用于比较两个版本在相同目录项变化下的结果；它不测独立攻击进程赢得竞态的概率。</p><p>函数调用后的终端记录同时给出返回值、打开标志和 outside 状态：</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203626-2e0e1303-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=dc250c97f57c4883\" loading=\"lazy\" decoding=\"async\" width=\"701\"></p><p>父目录替换在打开前命中，函数虽返回 invalid-path，outside 文件已被截断。</p><p>再看函数返回后的独立磁盘读回：</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203627-2ef0f7bc-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=27e556d4d1ccd22b\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203627-2ef0f7bc-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=528ad0dc2ded87e1 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203627-2ef0f7bc-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=31ebfa1d12372aa9 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203627-2ef0f7bc-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=27e556d4d1ccd22b 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1085\"></p><p>独立读回确认 outside Canary 已被截断，移走的原工作区文件仍然存在。</p><p>函数返回了 <code>invalid-path</code>，outside Canary 却从 4096 字节变成 0。<code>openFlags=[1793]</code> 含 <code>O_TRUNC</code>；源码顺序表明清空发生在 <code>fs.open()</code>，异常则早于 <code>handle.writeFile(data)</code>，因此输入 <code>NEW</code> 没有写进 Canary。</p><p>磁盘读回还确认了被操作的对象：<code>workspace/inside</code> 已指向 outside，而移到 <code>old-inside</code> 的原工作区文件仍是 <code>INSIDE</code>。发生变化的是 outside Canary，原工作区目标没有被覆盖。</p><p>修复版使用另一份目录，保持同样的工作区内容、Canary 大小和目录替换动作：</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203629-2fedbbc8-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=b5d64809df60deb2\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203629-2fedbbc8-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=1622b5efdabecf30 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203629-2fedbbc8-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=89dff21d7b7c50ac 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203629-2fedbbc8-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=b5d64809df60deb2 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"887\"></p><p>修复版从新的实验目录开始，工作区目标和 outside Canary 与上一轮保持相同。</p><p>修复版的终端记录给出函数返回与文件读回结果：</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203631-31142f58-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=c10d3fdc32e990e7\" loading=\"lazy\" decoding=\"async\" width=\"701\"></p><p>同一目录替换在修复版中也命中，但函数在修改 outside 文件前返回拒绝。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203632-31f4b5f1-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=9a12cbd4d0a81ab4\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203632-31f4b5f1-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=f001d0fa54afab80 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203632-31f4b5f1-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=ae330990fa0a0cf9 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203632-31f4b5f1-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=9a12cbd4d0a81ab4 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1548\"></p><p>独立读回确认目录项已经替换，但 outside Canary 仍保持 4096 字节。</p><p>这里 <code>openFlags=[257]</code> 不含 <code>O_TRUNC</code>。<code>injected=true</code>、<code>inside -&gt; outside</code> 和被移走的 <code>INSIDE</code> 文件确认替换已经命中；Canary 保持 4096 字节，是因为修复版先打开，再检查实际对象，越界时尚未执行 <code>truncate(0)</code> 或写入。</p><p>这不表示修复版从未打开 outside：同一次替换仍会影响 <code>open()</code> 的路径解析，函数可能先拿到 outside 的写句柄。实验只证明它在拒绝前没有改动文件内容。修复版的源码顺序见下方两处：先以不含创建、截断标志的方式打开并核对身份，再在边界检查通过后截断和写入；缺失目标则走独占创建分支。</p><p>修复版源码位置：<a href=\"https://github.com/openclaw/openclaw/blob/v2026.3.1/src/infra/fs-safe.ts#L328-L394\">OpenClaw v2026.3.1 </a><code>src/infra/fs-safe.ts</code><a href=\"https://github.com/openclaw/openclaw/blob/v2026.3.1/src/infra/fs-safe.ts#L328-L394\">，L328–L394</a>。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203633-32923afa-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=254f07a165aa7a9e\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203633-32923afa-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=8a6d8f04f40ce9d1 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203633-32923afa-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=d160d5ef4f8c6b46 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203633-32923afa-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=254f07a165aa7a9e 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1200\"><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203634-3311ef33-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=7c80a154e5c9230a\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203634-3311ef33-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=c49c11181bb015d5 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203634-3311ef33-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=bfffaba9dbb9a87d 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203634-3311ef33-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=7c80a154e5c9230a 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1200\"></p><p>第二处源码显示，只有句柄身份、当前路径和根目录检查通过，才会执行 <code>truncate</code> 与 <code>writeFile</code>。这与 4096 → 4096 的读回结果一致：源码解释控制流，终端确认替换命中后的实际文件状态。</p><h3 id=\"sec-13\">3.3 缺失目标：拒绝前先被创建</h3><p>这组用例开始时，工作区内的 <code>target.txt</code> 不存在，outside 目录里也没有 Canary。旧版初态如下：</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203635-3385b253-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=6fa004bb15e8a73e\" loading=\"lazy\" decoding=\"async\" width=\"695\"></p><p>执行前工作区目标和 outside Canary 都不存在。</p><p>目录中只有 <code>.</code> 和 <code>..</code>，没有 <code>target.txt</code>。旧版调用结果如下：</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203636-34526683-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=a0833bebf94cfe7a\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203636-34526683-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=765e4cd166e87302 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203636-34526683-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=2146fd41b98b35c2 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203636-34526683-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=a0833bebf94cfe7a 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"827\"></p><p>父目录替换命中，旧版打开目标时使用了带 O_CREAT 的标志。</p><p>再看函数返回后的独立磁盘读回：</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203638-35117036-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=4512fe3d365dcf4e\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203638-35117036-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=459b3ad63b00dbdb 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203638-35117036-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=9001bdf860000204 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203638-35117036-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=4512fe3d365dcf4e 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1259\"></p><p>独立读回确认 outside 新增了一个 0 字节文件。</p><p>执行前 outside 中没有目标，函数拒绝后却出现了一个 0 字节文件。这里没有旧内容可供截断，副作用来自 <code>O_CREAT</code>：<code>open()</code> 沿被替换的父目录在 outside 创建了文件。后置检查抛出异常，并不会撤销创建；终端读回记录的是函数返回后的状态，没有并发观察者监测创建到清理之间的短暂窗口。</p><p>修复版使用另一份空目录，目标文件和 Canary 同样都不存在：</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203639-35aa1972-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=a28e962eefa1b85c\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203639-35aa1972-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=6123fc7bfe52b70d 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203639-35aa1972-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=1e739b5c4bc0311c 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203639-35aa1972-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=a28e962eefa1b85c 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"745\"></p><p>修复版从独立的空目录开始，工作区目标和 outside 目标都不存在。</p><p>修复版调用结果如下：</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203640-36483e04-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=00c67f677949d5e2\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203640-36483e04-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=7af38a32204fd535 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203640-36483e04-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=7082b484eb2fed9c 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203640-36483e04-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=00c67f677949d5e2 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"743\"></p><p>第一次打开返回 ENOENT，修复版随后进入独占创建分支并在边界检查失败后清理。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203641-36ce9b48-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=3c32cf6d4a8838d8\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203641-36ce9b48-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=a479971c39c69a93 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203641-36ce9b48-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=282e1985e9a5a676 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203641-36ce9b48-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=3c32cf6d4a8838d8 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"948\"></p><p>独立读回显示 outside 最终没有留下目标文件。</p><p>修复版先以 <code>[257]</code> 打开目标；因为目标不存在，调用返回 <code>ENOENT</code>，随后以 <code>[2817]</code>（<code>O_CREAT|O_EXCL</code>）独占创建。后置根目录检查发现越界后，函数清理了这次创建的文件。于是终端最终读到 <code>ENOENT</code>：这证明没有遗留文件，不证明文件从未短暂出现。</p><p>日志中的十进制标志是 macOS arm64 / Node 环境的 Darwin 常量：</p><table><tbody><tr><td colspan=\"1\" rowspan=\"1\"><p>日志值</p></td><td colspan=\"1\" rowspan=\"1\"><p>标志组合</p></td><td colspan=\"1\" rowspan=\"1\"><p>本用例中的含义</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>1793</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>O_WRONLY、O_CREAT、O_TRUNC、O_NOFOLLOW</p></td><td colspan=\"1\" rowspan=\"1\"><p>旧版打开时可创建并截断</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>257</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>O_WRONLY、O_NOFOLLOW</p></td><td colspan=\"1\" rowspan=\"1\"><p>修复版先尝试打开已有文件，不创建、不截断</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>2817</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>O_WRONLY、O_CREAT、O_EXCL、O_NOFOLLOW</p></td><td colspan=\"1\" rowspan=\"1\"><p>文件缺失时独占创建</p></td></tr></tbody></table><h3 id=\"sec-14\">3.4 拒绝返回与磁盘状态</h3><p>把四次调用放在一起，差别就很清楚：</p><table><tbody><tr><td colspan=\"1\" rowspan=\"1\"><p>版本</p></td><td colspan=\"1\" rowspan=\"1\"><p>outside 原本有文件</p></td><td colspan=\"1\" rowspan=\"1\"><p>outside 原本没有文件</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>v2026.2.26</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>返回拒绝，Canary <code>4096 → 0</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>返回拒绝，但留下 0 字节文件</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>v2026.3.1</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>返回拒绝，Canary 保持 4096</p></td><td colspan=\"1\" rowspan=\"1\"><p>返回拒绝，最终没有遗留文件</p></td></tr></tbody></table><p>旧版的问题不是“拒绝失效”，而是拒绝来得太晚：已有文件先被 <code>O_TRUNC</code> 清空，缺失文件先被 <code>O_CREAT</code> 建出来。修复版把破坏性写入推迟到对象身份和根目录检查之后；缺失文件用例里的 <code>[257,2817]</code> 又说明它确实走过“先尝试打开、再独占创建”的分支，只是越界后清理了产物。</p><p>四次调用都走两个标签中的真实 <code>writeFileWithinRoot()</code>，目录替换由钩子固定在路径检查和 <code>fs.open()</code> 之间。它们能确认越界截断、越界创建和修复后的最终状态，但不等于任意内容写入或代码执行，也没有测量独立攻击进程赢得竞态的概率；</p><h2 id=\"sec-15\">四、OpenShell：临时文件也没有把落点固定住</h2><p>上一章把副作用定位在第一次 <code>open()</code>：旧版先截断或创建，之后才拒绝。OpenShell 把写入拆成临时文件、<code>rename()</code> 和同步三个阶段，问题就变成了另一种形式——检查通过后，这几个路径操作是否仍然落在原来的父目录。</p><h3 id=\"sec-16\">4.1 bridge 的宿主写入路径</h3><p>上一章是 <code>open()</code> 太早，这一章看一个更容易让人放松警惕的版本：先写临时文件，再用 <code>rename()</code> 提交，最后才同步。临时文件名、提交目标仍然是字符串路径；父目录检查后被换掉时，这两个操作会不会一起走到 outside？</p><p>这里的 OpenShell 是 OpenClaw 仓库里的扩展。Agent 传入 <code>/workspace/alias/output.txt</code> 后，bridge 把它映射成宿主机 <code>hostPath</code>，检查 <code>mountHostRoot</code>，写完本地文件，再调用 <code>syncLocalPathToRemote()</code>。一次写入实际分成“宿主落盘”和“同步读取”两段，本章先验证前者，第五章再验证后者。</p><p>修复提交 <a href=\"https://github.com/openclaw/openclaw/commit/7be82d4fd1193bcb7e44ee38838f00bf924ffa76\">7be82d4</a> 给出的关键变化不是换了文件名，而是把根目录约束放进了实际写入函数。旧流程中的临时文件和目标文件仍相对于可变父目录构造，父目录一旦被替换，后续路径操作就会重新跟随它。</p><p>实验链路固定在一个目标上：容器路径 <code>/workspace/alias/output.txt</code> 映射到宿主机的 <code>workspace/alias/output.txt</code>，<code>workspace</code> 是允许写入的根目录，<code>outside</code> 位于根目录之外。每个版本都从同一个普通目录项开始，bridge 完成路径检查后，注入动作执行两次目录项操作：</p><pre><code>workspace/alias  →  workspace/old-alias\nworkspace/alias  →  outside</code></pre><p>替换完成后，命令仍把原来的 <code>hostPath</code> 传给发行包函数。旧版会继续执行临时文件写入、<code>rename()</code> 和同步；修复版会在 <code>writeFileWithinRoot()</code> 中拒绝重绑定后的路径。这样两种版本使用同一输入、同一替换动作，差异只来自写入约束所在的位置。</p><p>实验只改变一个条件：<code>outside/output.txt</code> 是否预先存在。无论哪种用例，bridge 都先把容器路径映射到宿主路径并完成检查，目录项替换发生在检查之后；旧版继续执行临时文件写入、<code>rename()</code> 和同步，修复版在受约束的写入函数内返回。</p><p>“旧版 + 已有文件”这次运行把几个关键动作串在了一起：bridge 先把容器路径映射到宿主路径，检查通过后，<code>alias</code> 被换成指向 outside 的目录；临时文件写入、<code>rename()</code> 和同步仍沿原来的字符串路径继续执行。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203641-37320bbc-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=79f0270ede2e5a86\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203641-37320bbc-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=8a983a225e0b7cf1 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203641-37320bbc-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=e90b026f841a79a7 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203641-37320bbc-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=79f0270ede2e5a86 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"758\"><img src=\"/api/img-proxy?u=https%3A%2F%2Fxz.aliyun.com%2Fnews%2F%25E6%2596%2587%25E4%25BB%25B6%25E5%2586%2599%25E5%2585%25A5%25E9%2593%25BE%25E5%25A4%258D%25E7%258E%25B0_20261026%2Ffigures%2F%25E5%259B%25BE19_OpenShell%25E6%2597%25A7%25E7%2589%2588_bridge%25E4%25B8%25B4%25E6%2597%25B6%25E6%2596%2587%25E4%25BB%25B6%25E4%25B8%258Erename%25E6%2597%25B6%25E5%25BA%258F.png&amp;mode=full&amp;exp=1794873600&amp;sig=72d89946da895b22\" loading=\"lazy\" decoding=\"async\"></p><p>运行时先完成路径映射和根目录检查，随后发生父目录重绑定；临时文件写入和提交动作沿新目录继续，最后才进入同步 stub。</p><h3 id=\"sec-17\">4.2 临时文件和 <code>rename()</code> 仍按路径找</h3><p><code>openclaw@2026.4.21</code> 发行包中，桥接写入分支的核心顺序是：</p><pre><code>const parentDir = path.dirname(hostPath);\nconst tempPath = path.join(\n  parentDir,\n  `.openclaw-openshell-write-${path.basename(hostPath)}-${process.pid}-${Date.now()}`,\n);\nawait fs.writeFile(tempPath, buffer);\nawait fs.rename(tempPath, hostPath);\nawait this.backend.syncLocalPathToRemote(hostPath, target.containerPath);</code></pre><p>在同一文件系统中，<code>rename()</code> 只保证名称切换是原子的，不替应用判断新名称是否还在授权根目录里。<a href=\"https://pubs.opengroup.org/onlinepubs/9799919799/functions/rename.html\">POSIX </a><code>rename()</code><a href=\"https://pubs.opengroup.org/onlinepubs/9799919799/functions/rename.html\"> 规范</a>和父目录重绑定对照实验都给出了同一个结果：按可变路径提交会在 outside 产生文件，改用可信父目录 FD 后则不会。这个对照只解释 <code>rename()</code> 的语义，发行包是否真的沿着这条路径，要看 bridge 的实际调用结果。</p><p>在同一父目录重绑定对照里，按可变路径拼接临时文件会在 outside 产生文件；改用已经打开的可信父目录 FD，临时文件和提交都会留在 inside。它只说明“临时文件 + rename”模型会受父目录重绑定影响，不替代 OpenShell 发行包的真实调用。</p><p>这里的 <code>parentDir</code>、<code>tempPath</code> 和 <code>hostPath</code> 仍然是路径名。父目录别名被替换后，<code>writeFile(tempPath)</code> 和 <code>rename(tempPath, hostPath)</code> 会重新解析这些名字；两步可以都在 outside 完成，<code>rename()</code> 仍然是原子的，只是原子地提交到了错误目录。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203642-37a774e4-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=2aeb5f0afe16f31e\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203642-37a774e4-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=e8559c7a54d6e0e5 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203642-37a774e4-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=ecc0ab64e500f17e 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203642-37a774e4-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=2aeb5f0afe16f31e 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1200\"></p><p>旧版 <code>writeFile()</code> 先在 <code>parentDir</code> 下拼出临时文件名，再把临时文件按 <code>hostPath</code> 重命名，最后才进入同步分支。红框中的三次路径操作都接收字符串路径，没有把已经检查过的父目录绑定成文件描述符。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203643-380b5637-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=67738fa29a502d47\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203643-380b5637-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=e6b9e39d736276da 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203643-380b5637-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=e68409b1129bb2fb 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203643-380b5637-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=67738fa29a502d47 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"729\"></p><p>修复版把同一段逻辑改成 <code>writeFileWithinRoot()</code> 加同步调用。红框显示同步位于受根目录约束的写入 Promise 之后；写入阶段拒绝时，同步函数不会被执行。</p><p>两处源码把差异定位在同一个位置：旧版把临时路径和提交路径交给基于路径名的文件操作；修复版先等待 <code>writeFileWithinRoot()</code> 完成，再调用同步函数。outside 的最终文件状态和同步 stub 的调用次数正好能把这两个分支区分开。</p><h3 id=\"sec-18\">4.3 旧版写入结果</h3><p>旧版在路径检查后按 <code>parentDir</code> 拼出临时文件名。终端记录中的 <code>injected=true</code> 表示目录项替换确实命中了 bridge 的文件操作；随后函数没有拒绝，而是继续完成临时文件写入、<code>rename()</code> 和同步。</p><p>outside 原本已经存在文件时：</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203643-38741ef0-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=d70bcf47b4183b2d\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203643-38741ef0-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=6c72986a023b0bcc 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203643-38741ef0-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=201d3637c921217c 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203643-38741ef0-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=d70bcf47b4183b2d 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1268\"></p><p>初态中的 <code>OUTSIDE_CANARY</code> 是 14 字节。替换命中后，旧版仍返回 <code>rejected=false</code>，outside 变成 15 字节的 <code>OUTSIDE_VERSION</code>，<code>syncCount=1</code>。变化发生在 <code>rename(tempPath, hostPath)</code>，它把临时文件提交到了工作区外的同名路径。</p><p>再看 outside 原本没有目标文件的用例：再看 outside 原本没有目标文件的用例：</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxz.aliyun.com%2Fnews%2F%25E6%2596%2587%25E4%25BB%25B6%25E5%2586%2599%25E5%2585%25A5%25E9%2593%25BE%25E5%25A4%258D%25E7%258E%25B0_20261026%2Ffigures%2F%25E7%25BB%2588%25E7%25AB%25AF%25E6%2588%25AA%25E5%259B%25BE_OpenShell_v2026.4.21_%25E7%25BC%25BA%25E5%25A4%25B1%25E6%2596%2587%25E4%25BB%25B6.png&amp;mode=full&amp;exp=1794873600&amp;sig=d5bc4c31e281bf1d\" loading=\"lazy\" decoding=\"async\"><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203644-38cb41a8-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=cf89491bc933ca30\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203644-38cb41a8-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=691f6956b6ad23fc 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203644-38cb41a8-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=331ab6678a01a93c 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203644-38cb41a8-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=cf89491bc933ca30 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"964\"></p><p>这里初态的 <code>outside.exists=false</code>，终态变成 <code>outside.exists=true</code>、<code>bytes=15</code>。同一条旧版调用链在 outside 没有目标时表现为越界创建。<code>injected=true</code> 证明替换命中了文件操作，<code>syncCount=1</code> 证明本地同步 stub 被调用；两者都不等于远端 OpenShell 已经收到文件。</p><p>函数返回后的独立读回显示，<code>alias</code> 已经是指向 outside 的符号链接，原目录项移到了 <code>old-alias</code>，工作区内没有留下写入对象；终端记录中的 <code>final.alias</code> 和 <code>final.local</code> 字段对应这一状态。</p><h3 id=\"sec-19\">4.4 修复版的拒绝位置</h3><p>修复版沿用同一组输入和目录项替换动作，只把发行包换成 <code>2026.4.22</code>。outside 已有文件时：</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203644-39190fc9-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=5b17e1606347e0ad\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203644-39190fc9-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=3996b484db74f231 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203644-39190fc9-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=dc4234adf2ef2256 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203644-39190fc9-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=5b17e1606347e0ad 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"976\"></p><p>初态中的 <code>OUTSIDE_CANARY</code> 在终态仍然保留，<code>rejected=true</code>，<code>syncCount=0</code>。修复版没有进入 <code>rename()</code>，拒绝后也没有调用同步。</p><p>再看 outside 缺失文件的用例：</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203645-39624d31-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=02a2f2d94cb9d9ff\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203645-39624d31-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=9886e0afb3bb5a91 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203645-39624d31-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=6d81e5b95abf2287 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203645-39624d31-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=02a2f2d94cb9d9ff 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"876\"></p><p>这里 <code>injected=true</code> 说明替换动作仍然命中了注入点；<code>rejected=true</code>、<code>outside.exists=false</code> 和 <code>syncCount=0</code> 则说明真正的宿主写入还没有开始，outside 没有新文件，同步分支也没有执行。</p><p><code>final.alias.isSymbolicLink=true</code> 只说明实验注入完成，不能当成写入成功的证据；是否越界要看 outside 终态和 <code>syncCount</code>。</p><p>四组结果中，<code>injected</code> 都为 <code>true</code>，说明目录项替换确实命中了 bridge 的文件操作；真正有差异的是函数返回、outside 文件状态和同步调用次数。</p><table><tbody><tr><td colspan=\"1\" rowspan=\"1\"><p>发行包</p></td><td colspan=\"1\" rowspan=\"1\"><p>outside 初态</p></td><td colspan=\"1\" rowspan=\"1\"><p>函数返回</p></td><td colspan=\"1\" rowspan=\"1\"><p>outside 终态</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>syncCount</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>2026.4.21</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>已有 <code>OUTSIDE_CANARY</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>成功</p></td><td colspan=\"1\" rowspan=\"1\"><p>被改为 <code>OUTSIDE_VERSION</code>（15 字节）</p></td><td colspan=\"1\" rowspan=\"1\"><p>1</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>2026.4.21</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>不存在</p></td><td colspan=\"1\" rowspan=\"1\"><p>成功</p></td><td colspan=\"1\" rowspan=\"1\"><p>创建 <code>OUTSIDE_VERSION</code>（15 字节）</p></td><td colspan=\"1\" rowspan=\"1\"><p>1</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>2026.4.22</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>已有 <code>OUTSIDE_CANARY</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>拒绝</p></td><td colspan=\"1\" rowspan=\"1\"><p>Canary 保持不变（14 字节）</p></td><td colspan=\"1\" rowspan=\"1\"><p>0</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>2026.4.22</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>不存在</p></td><td colspan=\"1\" rowspan=\"1\"><p>拒绝</p></td><td colspan=\"1\" rowspan=\"1\"><p>仍不存在</p></td><td colspan=\"1\" rowspan=\"1\"><p>0</p></td></tr></tbody></table><p>这张表把两个判断分开：旧版的越界落点由 outside 的内容变化确认，后续同步是否继续由 <code>syncCount=1</code> 确认；修复版则同时满足“outside 没有变化”和“同步没有调用”。因此修复版的结论不是单纯返回了错误，而是拒绝发生在宿主写入和同步之前。</p><h2 id=\"sec-20\">五、同步链：路径再次解析后的对象变化</h2><p>第四章把问题停在宿主写入阶段：OpenShell 2026.4.22 能在临时文件和提交动作开始前拒绝父目录重绑定。但一次 Agent 写入并不止这一步。bridge 返回后，后端还要把本地文件同步到 sandbox；如果同步前又按路径检查、等待、上传，前一阶段的修复并不能自动约束后一阶段。</p><p>这轮实验把最后的上传边界换成真实 OpenShell CLI 0.1.7。gateway 和 sandbox 都是真实组件，远端工作目录是 /sandbox；正常基线、父目录替换和原位内容修改分别用远端 <code>exec</code> 与 <code>download</code> 读回。</p><h3 id=\"sec-21\">5.1 lstat() 和 sandbox upload 之间还隔着一次路径查找</h3><p>OpenClaw 2026.4.22 的同步后端先对 localPath 执行 lstat()，处理缺失文件、符号链接和目录；普通文件继续等待远端父目录准备，最后把同一个 localPath 交给 openshell sandbox upload。实现位于 <a href=\"https://github.com/openclaw/openclaw/blob/v2026.4.22/extensions/openshell/src/backend.ts#L783-L826\">v2026.4.22 backend.ts，L783–L826</a>。下面两张源码截图对应 v2026.4.22 的 <code>backend.ts</code>，分别展示这个函数中执行检查和调用上传的位置。</p><p>这段代码里没有把 lstat() 得到的对象或文件描述符传给上传命令。等待远端父目录准备的过程本身又增加了一段时间窗口，上传进程随后按路径名重新打开本地源文件。路径字符串没有变化，不代表它解析到的目录项和文件对象没有变化。</p><p>源码中的关键顺序可以压缩成：</p><pre><code>const stats = await fs.lstat(localPath).catch(() =&gt; null);\n// 缺失、符号链接、目录分别处理\nawait this.runRemoteShellScript({\n  script: \"mkdir -p -- \\\"$(dirname -- \\\"$1\\\")\\\"\",\n  args: [remotePath],\n});\nawait runOpenShellCli({\n  args: [\"sandbox\", \"upload\", sandboxName, localPath, dirname(remotePath)],\n});</code></pre><p>源码页面中，这三个动作出现在同一个同步函数里：先拿到 <code>lstat</code> 结果，随后准备远端父目录，最后仍把路径字符串交给 <code>sandbox upload</code>。检查结果没有变成 FD，上传阶段仍会重新按路径取源文件。下面两张截图分别对应这个函数的检查位置和上传位置，版本均为 v2026.4.22。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203645-39b97f1a-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=0618ab16bc0af9df\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203645-39b97f1a-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=e4e9bc6334042f69 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203645-39b97f1a-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=3b823c9b681b1da6 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203645-39b97f1a-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=0618ab16bc0af9df 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"728\"><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203646-3a1aca7f-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=6228688cb58e6ffd\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203646-3a1aca7f-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=57933b04e8800f93 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203646-3a1aca7f-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=8610741da2f37f2d 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203646-3a1aca7f-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=6228688cb58e6ffd 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"729\"></p><p>这条链的时间顺序是：</p><pre><code>backend.lstat(localPath)\n        ↓\n真实远端父目录准备\n        ↓\n本地目录项或文件内容发生变化\n        ↓\n真实 openshell sandbox upload(localPath)\n        ↓\n远端 sandbox 保存上传结果</code></pre><p>把这几个动作按实际顺序排开后，竞态窗口就不再是一个抽象的“检查之后”：先是 backend 对 <code>localPath</code> 执行 <code>lstat()</code>，随后等待远端父目录准备；可修改目录项的进程在这段时间把 <code>alias</code> 换到 outside，CLI 最后仍按原始路径重新打开并读到 inode B。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203647-3a6abc44-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=e287ebe3f088053e\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203647-3a6abc44-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=672fa8823cd41198 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203647-3a6abc44-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=b515295ecc0b408a 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203647-3a6abc44-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=e287ebe3f088053e 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"764\"></p><p>这里验证的是 Agent 文件工具触发的单文件同步路径。它不同于后端的 <code>uploadPathToRemote()</code>：后者会先把目录内容复制到临时目录，再上传临时目录；<code>syncLocalPathToRemote()</code> 则直接把 <code>localPath</code> 交给 CLI。两条路径的对象关系不能混在一起。</p><h3 id=\"sec-22\">5.2 同步检查与实际读取的对象</h3><p>真实 CLI 之前，我沿用 <code>openclaw@2026.4.22</code> 的发行包，把 OpenShell CLI 换成本地记录器。这样做不是为了模拟远端，而是先把“backend 检查了谁、消费者实际打开了谁”分开记录。记录器只按收到的路径执行 <code>realpath</code>、<code>stat</code> 和读取，不会把结果写入远端。</p><p>由于发行包入口没有直接导出这两个内部函数，实验副本只在 <code>index.js</code> 末尾追加导出语句，函数体没有改动。Node REPL 中逐段调用发行包实现的 bridge、backend 和 <code>syncLocalPathToRemote()</code>；远端建目录调用由本地函数替身返回成功，注入发生在 backend 的 <code>lstat()</code> 返回之后，CLI 记录器保存它按路径实际打开的对象。</p><p>先在同一个 Node REPL 中实例化发行包里的 backend。<code>backend ready</code> 只表示后续调用已经接到 <code>openclaw@2026.4.22</code> 的后端，还没有进入 bridge 写入路径，文件状态尚未改变。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxz.aliyun.com%2Fnews%2F%25E6%2596%2587%25E4%25BB%25B6%25E5%2586%2599%25E5%2585%25A5%25E9%2593%25BE%25E5%25A4%258D%25E7%258E%25B0_20261026%2Ffigures%2F%25E7%25BB%2588%25E7%25AB%25AF%25E6%2588%25AA%25E5%259B%25BE_OpenShell_REPL_01_backend_ready.png&amp;mode=full&amp;exp=1794873600&amp;sig=286ebfb2ef989ba5\" loading=\"lazy\" decoding=\"async\"><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203647-3ac1ad22-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=5b1dbab84d50ca0b\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203647-3ac1ad22-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=3b53540c01a1b243 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203647-3ac1ad22-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=4d14073c3cfe4524 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203647-3ac1ad22-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=5b1dbab84d50ca0b 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"740\"></p><p>接着暂时接住 <code>syncLocalPathToRemote()</code>，让它只记录参数并等待后续放行。<code>sync deferred</code> 说明同步入口已经被截获，但此时没有读取本地文件；后面的内容变化只能来自 bridge 的宿主写入，不会被同步消费者提前混入。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203648-3b160199-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=1c670b94cf14f83e\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203648-3b160199-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=f4b9c76082d49302 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203648-3b160199-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=2622b5bbe019c6f6 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203648-3b160199-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=1c670b94cf14f83e 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"875\"></p><p>在同一运行时中用 <code>sandbox</code> 和 <code>backend</code> 构造真实 bridge。<code>bridge ready</code> 表示后续 <code>writeFile()</code> 会进入发行包实现，而不是测试替身；到这里仍然没有触发目标文件写入。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203648-3b5d0505-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=8f479e96b30670be\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203648-3b5d0505-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=3324ceed193cc146 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203648-3b5d0505-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=610cd0bc5eb391e3 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203648-3b5d0505-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=8f479e96b30670be 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"849\"></p><p>现在只触发一次 bridge 的本地写入，把同步读取留在延迟状态。<code>local-write-complete</code> 表示宿主目标已经写入 13 字节 <code>INSIDE_MARKER</code>；<code>sync-deferred</code> 仍在，说明 bridge 已经返回但消费者尚未读取，这一步建立了后续 <code>lstat()</code> 对照所需的 workspace 基线。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203649-3bc0c7bc-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=0887f9d99a56a48c\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203649-3bc0c7bc-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=14e77bea9a71ddc9 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203649-3bc0c7bc-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=1c2b3e12dc40941a 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203649-3bc0c7bc-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=0887f9d99a56a48c 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"871\"><img src=\"/api/img-proxy?u=https%3A%2F%2Fxz.aliyun.com%2Fnews%2F%25E6%2596%2587%25E4%25BB%25B6%25E5%2586%2599%25E5%2585%25A5%25E9%2593%25BE%25E5%25A4%258D%25E7%258E%25B0_20261026%2Ffigures%2F%25E7%25BB%2588%25E7%25AB%25AF%25E6%2588%25AA%25E5%259B%25BE_OpenShell_REPL_04_local_write_complete.png&amp;mode=full&amp;exp=1794873600&amp;sig=c1acc2fed9d5d1eb\" loading=\"lazy\" decoding=\"async\"></p><p>宿主写入完成后，对当前目标做一次 <code>stat()</code>，记录 <code>dev</code>、<code>ino</code> 和字节数。13 字节的 <code>INSIDE_MARKER</code> 仍位于 workspace；这些字段作为后面判断“backend 检查的是哪个对象”的参照，但不代表 CLI 一定会继续使用同一个 inode。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203649-3c1afede-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=7037c187cdacf021\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203649-3c1afede-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=bceed335858c6ecb 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203649-3c1afede-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=35ab65fad5a1aa72 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203649-3c1afede-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=7037c187cdacf021 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"878\"><img src=\"/api/img-proxy?u=https%3A%2F%2Fxz.aliyun.com%2Fnews%2F%25E6%2596%2587%25E4%25BB%25B6%25E5%2586%2599%25E5%2585%25A5%25E9%2593%25BE%25E5%25A4%258D%25E7%258E%25B0_20261026%2Ffigures%2F%25E7%25BB%2588%25E7%25AB%25AF%25E6%2588%25AA%25E5%259B%25BE_OpenShell_REPL_05_writer_stat.png&amp;mode=full&amp;exp=1794873600&amp;sig=0cf41464ed25ec1b\" loading=\"lazy\" decoding=\"async\"></p><p>为确认检查点确实落在发行包的同步后端，再给其中的 <code>fs.lstat()</code> 加观察输出。<code>lstat trace installed</code> 只表示观察点安装完成；之后出现的路径、inode 和内容才来自 backend 实际执行的检查，而不是手工读取旁路结果。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203650-3c6f1a9f-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=7dc4c8ba8b50f30c\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203650-3c6f1a9f-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=95eb8214d3ab9414 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203650-3c6f1a9f-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=98bb347c3a39a926 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203650-3c6f1a9f-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=7dc4c8ba8b50f30c 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"844\"></p><p>随后安装父目录重绑定钩子，并把它放在远端父目录准备阶段。钩子只执行：</p><pre><code>alias → old-alias\nalias → outside</code></pre><p>它不改写目标文件内容；这样一旦后面的消费者读到 outside，变化只能归因于路径重新解析。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203651-3ccfabbd-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=014947ed3b486878\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203651-3ccfabbd-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=de4f34986b689d9a 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203651-3ccfabbd-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=1882b79d50f3715c 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203651-3ccfabbd-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=014947ed3b486878 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"878\"></p><p>恢复真实同步调用后，远端目录准备阶段第一次暂停。此时记录的 <code>realpath</code>、inode 和内容仍属于 workspace，CLI 还没有启动；检查已经完成，消费者尚未打开，替换窗口就在这里形成。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203651-3d328cac-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=0fd15d8ae432deed\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203651-3d328cac-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=bcc1fef9e87f17f2 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203651-3d328cac-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=14a2c669dfdcc4b0 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203651-3d328cac-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=0fd15d8ae432deed 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"869\"></p><p>放行暂停点后，钩子才执行父目录替换。第二个暂停点的 <code>aliasIsSymlink=true</code> 说明目录项已经改变，而传给后端的路径字符串没有改变；这正是检查结果与后续路径解析之间的竞态窗口。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203652-3d89537b-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=5810fa9774ca41f9\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203652-3d89537b-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=256e8db4b3e6109f 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203652-3d89537b-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=1a7bc65279987f3a 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203652-3d89537b-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=5810fa9774ca41f9 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"844\"></p><p>再次放行后，backend 把原始 <code>localPath</code> 交给 CLI 记录器。记录器没有收到之前的 inode 或 FD，而是按路径重新打开；<code>sourceRealPath</code> 已变成 outside，inode 与检查阶段不同，内容为 <code>OUTSIDE_SECRET</code>，于是“检查对象”和“消费者对象”直接对应起来。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxz.aliyun.com%2Fnews%2F%25E6%2596%2587%25E4%25BB%25B6%25E5%2586%2599%25E5%2585%25A5%25E9%2593%25BE%25E5%25A4%258D%25E7%258E%25B0_20261026%2Ffigures%2F%25E7%25BB%2588%25E7%25AB%25AF%25E6%2588%25AA%25E5%259B%25BE_OpenShell_REPL_10_sync_returned_outside.png&amp;mode=full&amp;exp=1794873600&amp;sig=e12a12f4391537f9\" loading=\"lazy\" decoding=\"async\"><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203652-3dd7f1e3-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=8a85d9bee8d36fc8\" loading=\"lazy\" decoding=\"async\" width=\"673\"></p><p>bridge 先完成宿主写入，backend 在 workspace inode 上执行 <code>lstat()</code>；父目录替换后，CLI 再按原始路径读取，最终打开 outside inode。<code>bridgeReturned=true</code> 只说明同步函数没有因为对象变化抛错；检查阶段与消费者阶段的 <code>realpath</code>、inode 和内容发生对应变化，才构成路径重解析的证据。</p><p>下表只比较同一用例内的检查对象和消费者对象，inode 数值会因每次临时目录不同而变化。这里的记录来自本地消费者实际打开和读取的结果，不是远端文件终态。</p><table><tbody><tr><td colspan=\"1\" rowspan=\"1\"><p>用例</p></td><td colspan=\"1\" rowspan=\"1\"><p>后端检查时</p></td><td colspan=\"1\" rowspan=\"1\"><p>shim 实际打开并读取</p></td><td colspan=\"1\" rowspan=\"1\"><p>bridge 返回</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>无注入对照</p></td><td colspan=\"1\" rowspan=\"1\"><p>工作区 inode，13 B，<code>INSIDE_MARKER</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>同一 inode、同一内容</p></td><td colspan=\"1\" rowspan=\"1\"><p>成功</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>lstat()</code> 后替换父目录</p></td><td colspan=\"1\" rowspan=\"1\"><p>工作区 inode，13 B，<code>INSIDE_MARKER</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>outside inode，14 B，<code>OUTSIDE_SECRET</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>成功</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>lstat()</code> 后原位改写</p></td><td colspan=\"1\" rowspan=\"1\"><p>工作区 inode，13 B，<code>INSIDE_MARKER</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>同一 inode，16 B，<code>CONTENT_INJECTED</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>成功</p></td></tr></tbody></table><h3 id=\"sec-23\">5.3 同一 inode 的内容变化</h3><p>先做一个无注入基线。另建 <code>control</code> 目录，恢复真实同步函数，不安装任何替换钩子。bridge 写入 <code>INSIDE_MARKER</code> 后，CLI 记录器看到的 realpath、inode 和内容都应与 backend 检查结果一致。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxz.aliyun.com%2Fnews%2F%25E6%2596%2587%25E4%25BB%25B6%25E5%2586%2599%25E5%2585%25A5%25E9%2593%25BE%25E5%25A4%258D%25E7%258E%25B0_20261026%2Ffigures%2F%25E7%25BB%2588%25E7%25AB%25AF%25E6%2588%25AA%25E5%259B%25BE_OpenShell_REPL_11_control_baseline.png&amp;mode=full&amp;exp=1794873600&amp;sig=5bf28c2f8434f70f\" loading=\"lazy\" decoding=\"async\"><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203653-3e3852d6-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=5fed98ce459e4d5d\" loading=\"lazy\" decoding=\"async\" width=\"675\"></p><p>这组输出先排除“记录器无论如何都会读 outside”。然后另建 <code>mutate</code> 目录，让同步阶段的钩子只原位改写目标文件，不替换父目录。backend 检查的是 13 字节的 <code>INSIDE_MARKER</code>，CLI 最终读取的是同一个 inode 上的 16 字节 <code>CONTENT_INJECTED</code>。</p><p>这一次没有发生路径越界，变化发生在写入完成和同步读取之间。它说明对象身份相同，也不等于消费者拿到的字节一定还是检查时的字节。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxz.aliyun.com%2Fnews%2F%25E6%2596%2587%25E4%25BB%25B6%25E5%2586%2599%25E5%2585%25A5%25E9%2593%25BE%25E5%25A4%258D%25E7%258E%25B0_20261026%2Ffigures%2F%25E7%25BB%2588%25E7%25AB%25AF%25E6%2588%25AA%25E5%259B%25BE_OpenShell_REPL_12_same_inode_mutation.png&amp;mode=full&amp;exp=1794873600&amp;sig=9af92937622a0763\" loading=\"lazy\" decoding=\"async\"><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203654-3ea25add-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=116ba96a0cad4e7e\" loading=\"lazy\" decoding=\"async\" width=\"672\"></p><p>输出里的 <code>before</code>、<code>after</code>、<code>sameInode=true</code> 和 <code>CONTENT_INJECTED</code> 是这组对照的关键字段；它和上一节的父目录重绑定用例分别对应“同一 inode 换内容”和“路径换到另一个 inode”。</p><p>两组对照把变化分成两类：父目录替换让 CLI 读到另一个 inode，原位改写则让它从同一 inode 读到新字节。backend 传递的是路径名，<code>lstat()</code> 只记录检查时刻的状态，没有替后续读取固定对象或固定内容。若同步仍由 CLI 按路径读取，就要把已验证的文件对象或不可变内容交给消费者，并绑定到获准的远端目标。</p><p>本地 shim 到这里就停下。它说明 <code>lstat()</code> 只记录检查时刻的状态，不能替后续读取固定文件对象或固定内容；但它没有启动真实 OpenShell CLI、gateway 或远端 sandbox。下面保留同一注入时序，只替换最后的消费者，观察变化能否越过同步边界。</p><h3 id=\"sec-24\">5.4 真实 CLI：父目录替换后，outside 内容进入远端</h3><p>真实 CLI 先完成一次无注入的 <code>upload → exec → download</code>，确认 gateway、sandbox 和回读链路正常；</p><p>真实 CLI 完整链路：<code>backend.lstat → remote mkdir → alias → outside → real sandbox upload → remote exec/download</code>。</p><p>本地目录保持如下结构：</p><pre><code>workspace/alias/output.txt    INSIDE_MARKER\noutside/output.txt            OUTSIDE_SECRET</code></pre><p>bridge 先完成正常本地写入。backend 的 lstat() 返回时，localPath 仍解析到 workspace 文件，记录为 inode A；真实远端父目录准备完成后，注入动作才执行：</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203654-3ef6e9cf-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=d48eafff6506ab6f\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203654-3ef6e9cf-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=06b3986cfdad965a 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203654-3ef6e9cf-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=c35f5a921f24fb88 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203654-3ef6e9cf-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=d48eafff6506ab6f 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"826\"></p><p>为便于叙述，下面把远端目标简写为 <code>/sandbox/alias/output.txt</code>。真实 CLI 输出中的路径带有实验目录前缀，实际显示为 <code>/sandbox/auto-race/alias/output.txt</code>。</p><pre><code>workspace/alias  →  workspace/detached-alias\nworkspace/alias  →  outside</code></pre><p>之后没有改变传给 backend 的 localPath 字符串，真实 CLI 仍接收原来的路径。变化的是这条路径再次解析时经过的父目录项。</p><p>第二次暂停时，<code>alias</code> 已经变成指向 outside 的符号链接；同一个 <code>localPath</code> 重新解析后，realpath 和 inode 都发生了变化。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203655-3f4136db-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=a22bc19573033e76\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203655-3f4136db-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=5f5d778d3e56657e 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203655-3f4136db-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=c5fc8e09ef0eb5bd 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203655-3f4136db-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=a22bc19573033e76 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"733\"></p><p>两个 OpenClaw 版本的本地检查和远端读回结果如下。inode 数字只对应该次运行；下表用 A、B 表示两次检查得到的对象身份：</p><table><tbody><tr><td colspan=\"1\" rowspan=\"1\"><p>版本</p></td><td colspan=\"1\" rowspan=\"1\"><p>lstat() 检查时</p></td><td colspan=\"1\" rowspan=\"1\"><p>替换后上传前</p></td><td colspan=\"1\" rowspan=\"1\"><p>远端 exec / download</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>2026.4.21</p></td><td colspan=\"1\" rowspan=\"1\"><p>inode A，INSIDE_MARKER</p></td><td colspan=\"1\" rowspan=\"1\"><p>inode B，outside/output.txt</p></td><td colspan=\"1\" rowspan=\"1\"><p>OUTSIDE_SECRET</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>2026.4.22</p></td><td colspan=\"1\" rowspan=\"1\"><p>inode A，INSIDE_MARKER</p></td><td colspan=\"1\" rowspan=\"1\"><p>inode B，outside/output.txt</p></td><td colspan=\"1\" rowspan=\"1\"><p>OUTSIDE_SECRET</p></td></tr></tbody></table><p>这次运行中，2026.4.21 的本地 <code>lstat</code> inode 为 75485747，父目录替换后 outside inode 为 75485748；2026.4.22 的本地 <code>lstat</code> inode 为 75485785。inode 只用于串起该次运行的对象身份，不作为跨机器稳定值。两版远端读回的 SHA-256 都是：</p><pre><code>5e1589b1ddbe6cff914a6cca1340469980f1bcfb6383d75381244c8fb3f721a2</code></pre><p>与本地 outside/output.txt 的摘要一致；download 回本地后仍是同一个摘要。</p><p>这里不把“真实 CLI 打开了 inode B”写成 CLI 内部系统调用的直接观测。能够直接确认的是：上传启动前，backend 传入的本地路径已经解析到 outside inode B；真实 CLI 返回成功，远端文件内容又与 outside Canary 的摘要一致。三段结果连在一起，说明 outside 对象的字节已经越过本地同步边界，进入远端 sandbox 的目标路径。</p><p>2026.4.21 的真实 upload 返回后，远端 <code>exec</code> 和 <code>download</code> 都读到了 outside Canary，终端读回的远端路径、摘要和文本如下。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203655-3f8c07ea-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=6dcb1a2b06198a47\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203655-3f8c07ea-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=4aea201b601cf542 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203655-3f8c07ea-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=9c3835454c6630c6 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203655-3f8c07ea-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=6dcb1a2b06198a47 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"847\"></p><p>2026.4.22 重复同一输入和替换时机，结果仍由真实 CLI 读回，而不是本地 shim 伪造。远端摘要和 <code>OUTSIDE_SECRET</code> 与上一轮一致：</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203656-3fd7f2dd-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=972dc28b7e5dcb2d\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203656-3fd7f2dd-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=b2ccc08fd3ad494f 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203656-3fd7f2dd-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=4ada01e8450499a5 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203656-3fd7f2dd-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=972dc28b7e5dcb2d 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"834\"></p><p>这组结果和第四章的关系很明确：2026.4.22 能挡住宿主临时文件和 rename() 阶段的越界落点，但同步后端仍把可变路径交给上传进程，所以同一个父目录替换可以在更晚的阶段再次生效。</p><h3 id=\"sec-25\">5.5 真实 CLI：同一 inode 上传了新字节</h3><p>第二组变化不替换父目录，也不创建符号链接。backend 的 lstat() 返回后，直接把目标文件原位改写为 CONTENT_INJECTED；dev 和 inode 保持不变。</p><pre><code>检查时：inode A / INSIDE_MARKER / 13 字节\n修改后：inode A / CONTENT_INJECTED / 16 字节\n上传后：远端 CONTENT_INJECTED</code></pre><p>2026.4.21 和 2026.4.22 的结果都一样。两版远端收到的 SHA-256 都是：</p><pre><code>7dd9b3b298033987cbbc4643f99a5ca124b31a867f2a33be556e2c46e3d2c993</code></pre><p>这个摘要对应 CONTENT_INJECTED。它说明另一类问题：即使同步后端检查时记录了正确的 inode，后续上传仍可能读取同一个 inode 上已经变化的字节。文件对象身份没有变化，内容一致性仍然没有得到保证。</p><p>这次没有换父目录。<code>lstat()</code> 记录的 inode 在修改前后保持不变，但远端和 download 都收到了新内容。实际终端输出如下：</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203656-4024d926-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=9addb6b6b34b0a8e\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203656-4024d926-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=b91c746420edd117 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203656-4024d926-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=21bb7efd839b1c50 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203656-4024d926-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=9addb6b6b34b0a8e 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"789\"></p><p>这不是第二个越界路径，而是同一条检查—消费链上的内容竞态。父目录替换回答“上传时找到的是谁”，原位改写回答“找到同一个对象后，上传的还是不是检查时的字节”。</p><h3 id=\"sec-26\">5.6 宿主写入修复没有覆盖同步读取</h3><p>把两轮结果放在一起，OpenClaw 两个版本在同步阶段没有表现出差异：</p><table><tbody><tr><td colspan=\"1\" rowspan=\"1\"><p>阶段</p></td><td colspan=\"1\" rowspan=\"1\"><p>2026.4.21</p></td><td colspan=\"1\" rowspan=\"1\"><p>2026.4.22</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>宿主 bridge 写入</p></td><td colspan=\"1\" rowspan=\"1\"><p>旧版存在临时文件/提交落点问题</p></td><td colspan=\"1\" rowspan=\"1\"><p>宿主写入阶段已增加根目录约束</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>backend lstat() 后的父目录替换</p></td><td colspan=\"1\" rowspan=\"1\"><p>真实 CLI 上传 outside 内容</p></td><td colspan=\"1\" rowspan=\"1\"><p>真实 CLI 上传 outside 内容</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>lstat() 后的原位修改</p></td><td colspan=\"1\" rowspan=\"1\"><p>真实 CLI 上传新字节</p></td><td colspan=\"1\" rowspan=\"1\"><p>真实 CLI 上传新字节</p></td></tr></tbody></table><p>因此，第四章的修复只能说明宿主写入阶段不再沿旧版方式把临时文件提交到 outside，不能说明后续同步消费者已经绑定了同一个文件对象或同一份字节。要覆盖目前暴露的窗口，后端需要在检查和上传之间固定源文件对象或不可变内容，不能把裸路径继续交给另一个进程重新打开。</p><p>这一轮真实 CLI 实验的攻击效果也有边界：</p><ul><li><p>远端目标仍是 backend 指定的固定路径，本轮截图中显示为 /sandbox/auto-race/alias/output.txt；</p></li><li><p>成立前提是攻击者能在 lstat() 之后修改共享目录项或文件内容，宿主进程能读取 outside；</p></li><li><p>结果证明了远端文件内容被替换或投毒，不等于任意远端路径写入，也不等于代码执行；</p></li><li><p>真实 gateway、sandbox、upload、exec 和 download 都参与了验证，但没有进一步测试远端应用如何消费这份文件。</p></li></ul><h2 id=\"sec-27\">六、问题根因与防护方案</h2><p>前面几章把同一个问题分别落到了写入、提交和同步读取：检查阶段看到的对象，没有被带到后续真正执行的位置。下面不再增加新的产品案例，直接把这个断点拆成根因、防护和回归验证。</p><h3 id=\"sec-28\">6.1 问题根因：检查对象和实际对象不是同一个</h3><p>从代码层面看，断点表现为：检查时确认的是一个对象，真正动文件或读取文件时，代码又拿路径字符串找了一遍。Claude Code 把路径继续传给写入阶段；OpenClaw 旧版在 <code>open()</code> 里先截断或创建，之后才发现越界；OpenShell 旧版把临时文件、<code>rename()</code> 和同步都交给可变路径。</p><table><tbody><tr><td colspan=\"1\" rowspan=\"1\"><p>位置</p></td><td colspan=\"1\" rowspan=\"1\"><p>结果</p></td><td colspan=\"1\" rowspan=\"1\"><p>修复方向</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>检查后再次 <code>open()</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>重新解析到 outside inode</p></td><td colspan=\"1\" rowspan=\"1\"><p>打开动作带根目录约束</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>open()</code> 后才拒绝</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>O_TRUNC</code> 清空、<code>O_CREAT</code> 留文件</p></td><td colspan=\"1\" rowspan=\"1\"><p>破坏性操作放到核验之后</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>临时文件到 <code>rename()</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>提交落到 outside</p></td><td colspan=\"1\" rowspan=\"1\"><p>不用未绑定的路径字符串</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>lstat()</code> 到同步读取</p></td><td colspan=\"1\" rowspan=\"1\"><p>消费者读到另一个 inode 或新字节</p></td><td colspan=\"1\" rowspan=\"1\"><p>传递已验证对象或内容</p></td></tr></tbody></table><p>把三个实现放到同一条路径上，差别就清楚了：检查阶段都先看到工作区 inode A，目录项随后被替换，后续操作仍使用原来的路径字符串。Claude Code 在写入阶段重新打开或提交，OpenClaw 在 <code>open()</code> 阶段先触发截断或创建，OpenShell 则在同步阶段把路径交给消费者再次读取。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxz.aliyun.com%2Fnews%2F%25E6%2596%2587%25E4%25BB%25B6%25E5%2586%2599%25E5%2585%25A5%25E9%2593%25BE%25E5%25A4%258D%25E7%258E%25B0_20261026%2Ffigures%2F%25E5%259B%25BE25_%25E4%25B8%2589%25E4%25B8%25AA%25E6%2594%25BB%25E5%2587%25BB%25E9%259D%25A2%25E7%25BB%2584%25E5%2590%2588%25E6%2597%25B6%25E5%25BA%258F.png&amp;mode=full&amp;exp=1794873600&amp;sig=530b2173c8537a35\" loading=\"lazy\" decoding=\"async\"><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203657-407d723e-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=768aca37053a13a7\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203657-407d723e-dc3a-1.png&amp;mode=thumb&amp;exp=1794873600&amp;sig=3007828684d4a1a5 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203657-407d723e-dc3a-1.png&amp;mode=image-1200&amp;exp=1794873600&amp;sig=5d74d84f2e147d65 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261109203657-407d723e-dc3a-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=768aca37053a13a7 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"892\"></p><p>三个攻击面的副作用落在不同位置，但共同缺口只有一个：检查结果没有绑定到文件描述符、可信父目录或后续消费对象。</p><p>只补一条 <code>realpath()</code> 不够。后面的代码只要再次执行 <code>open(path)</code>、<code>rename(path)</code> 或 CLI 按路径读取，前一次检查就只代表当时那一次解析。</p><h3 id=\"sec-29\">6.2 打开、提交与消费的对象绑定</h3><p><code>O_NOFOLLOW</code> 只限制最后一个路径分量，挡不住 <code>inside/</code> 或 <code>alias/</code> 这样的父目录被换成 Symlink；第三章的 Canary 截断已经说明了这一点。<a href=\"https://github.com/apple-oss-distributions/xnu/blob/main/bsd/man/man2/open.2\">Apple-open(2)手册</a>和 <a href=\"https://man7.org/linux/man-pages/man2/open.2.html\">Linux-open(2)手册</a>都把它限定在最后一个名字。</p><p>Linux 的 <code>openat2()</code> 可以从可信根目录 FD 解析整条路径：</p><pre><code>struct open_how how = {\n    .flags = O_WRONLY,\n    .resolve = RESOLVE_BENEATH | RESOLVE_NO_MAGICLINKS,\n};\nint fd = syscall(SYS_openat2, rootfd, \"draft.txt\", &amp;how, sizeof(how));</code></pre><p><code>RESOLVE_BENEATH</code> 约束根目录边界；需要完全禁止 Symlink 时，再加 <code>RESOLVE_NO_SYMLINKS</code>。Linux 对照中，叶子和父目录越界在 <code>RESOLVE_BENEATH</code> 下都返回 <code>EXDEV</code>；再加 <code>RESOLVE_NO_SYMLINKS</code> 时，符号链接解析返回 <code>ELOOP</code>，outside Canary 保持不变。这个结果只说明约束放进实际解析动作后能挡住重定向，不代表产品已经使用了 <code>openat2()</code>。</p><p>后续提交和同步也不能重新使用裸路径。可信父目录打开后，用相对 FD 的 <code>openat()</code>、<code>renameat()</code> 可以继续指向原目录对象；但 FD 不负责判断这个目录是否仍属于授权根。硬链接同样不能忽略：两个名字可以指向同一 inode，写工作区内的名字仍会改变 outside 硬链接看到的内容。</p><h3 id=\"sec-30\">6.3 测试要读回磁盘，不能只等一个异常</h3><p>旧版返回 <code>invalid-path</code> 时，Canary 已经从 4096 字节变成 0；缺失文件用例里，拒绝返回后还留下了新文件。因此回归测试不能只断言 <code>rejects.toThrow()</code>，还要在返回后读回 outside 的存在状态、长度和内容；OpenShell 要检查 <code>syncCount</code>，同步用例要比较 backend <code>lstat()</code> 的 inode 与消费者最终打开的 realpath、inode 和内容。</p><p>这些结果分别回答“有没有拒绝”“磁盘有没有变化”“同步有没有继续”“消费者最后拿到谁”。父目录替换需要目录项修改权限，原位改写需要目标文件写权限；修复版最终清理干净，也不能据此排除创建到清理之间的短暂窗口。</p><p>做完这几组实验，最容易误判的就是把 <code>rejected</code> 当成“什么都没发生”。真正的修复应让 <code>open()</code>、<code>rename()</code> 和同步读取使用已核验的对象或内容；如果只能传路径字符串，就必须在每个重新解析点重新约束，并把磁盘副作用纳入测试。</p><h2 id=\"sec-31\">七、总结</h2><p>本文通过 Claude Code、OpenClaw 和 OpenShell 的源码分析与对照实验，验证了路径检查与实际文件操作之间的安全边界问题。实验表明，即使最终返回拒绝，越界创建或截断等副作用仍可能已经发生；即使写入阶段完成校验，后续同步读取也可能访问不同的文件对象或内容。</p><p>问题的关键不只是路径是否通过检查，而是<strong>检查结果能否约束后续真正产生副作用的操作，以及最终被消费的文件对象和内容。</strong> 这也是 Agent 文件操作链路中需要持续关注的安全边界。</p><h2 id=\"sec-32\">参考资料</h2><ol><li><p><a href=\"https://github.com/anthropics/claude-code/security/advisories/GHSA-5j29-h97v-84ch\">Claude Code CVE-2026-103435：Arbitrary File Write via Write-Time Symlink Following（GHSA-5j29-h97v-84ch）</a></p></li><li><p><a href=\"https://github.com/openclaw/openclaw/security/advisories/GHSA-x82f-27x3-q89c\">OpenClaw：</a><code>writeFileWithinRoot()</code><a href=\"https://github.com/openclaw/openclaw/security/advisories/GHSA-x82f-27x3-q89c\"> 越界创建与截断问题（GHSA-x82f-27x3-q89c）</a></p></li><li><p><a href=\"https://github.com/openclaw/openclaw/commit/7be82d4fd1193bcb7e44ee38838f00bf924ffa76\">OpenClaw：OpenShell 宿主写入根目录修复提交 7be82d4</a></p></li><li><p><a href=\"https://github.com/openclaw/openclaw/blob/v2026.4.22/extensions/openshell/src/fs-bridge.ts#L67-L93\">OpenClaw v2026.4.22：OpenShell </a><code>fs-bridge.ts</code></p></li><li><p><a href=\"https://pubs.opengroup.org/onlinepubs/9799919799/functions/rename.html\">POSIX </a><code>rename()</code><a href=\"https://pubs.opengroup.org/onlinepubs/9799919799/functions/rename.html\"> 规范</a></p></li><li><p><a href=\"https://man7.org/linux/man-pages/man2/open.2.html\">Linux </a><code>open(2)</code><a href=\"https://man7.org/linux/man-pages/man2/open.2.html\">：</a><code>O_NOFOLLOW</code></p></li><li><p><a href=\"https://man7.org/linux/man-pages/man2/openat2.2.html\">Linux </a><code>openat2(2)</code><a href=\"https://man7.org/linux/man-pages/man2/openat2.2.html\">：路径解析约束</a></p></li><li><p><a href=\"https://github.com/openclaw/openclaw/blob/v2026.2.26/src/infra/fs-safe.ts#L39-L46\">OpenClaw v2026.2.26：</a><code>O_TRUNC</code><a href=\"https://github.com/openclaw/openclaw/blob/v2026.2.26/src/infra/fs-safe.ts#L39-L46\"> 写入标志</a></p></li><li><p><a href=\"https://github.com/openclaw/openclaw/blob/v2026.2.26/src/infra/fs-safe.ts#L223-L261\">OpenClaw v2026.2.26：打开后的身份、真实路径和根目录检查</a></p></li><li><p><a href=\"https://github.com/openclaw/openclaw/blob/v2026.3.1/src/infra/fs-safe.ts#L328-L394\">OpenClaw v2026.3.1：</a><code>writeFileWithinRoot()</code><a href=\"https://github.com/openclaw/openclaw/blob/v2026.3.1/src/infra/fs-safe.ts#L328-L394\"> 打开、校验与延后截断</a></p></li><li><p><a href=\"https://github.com/openclaw/openclaw/blob/v2026.4.21/extensions/openshell/src/fs-bridge.ts#L61-L91\">OpenClaw v2026.4.21：OpenShell 文件桥接源码</a></p></li><li><p><a href=\"https://github.com/openclaw/openclaw/blob/v2026.4.22/extensions/openshell/src/backend.ts#L287-L332\">OpenClaw v2026.4.22：OpenShell 同步后端源码</a></p></li><li><p><a href=\"https://www.npmjs.com/package/openclaw/v/2026.4.22\">OpenClaw v2026.4.22：npm 发行包</a></p></li><li><p><a href=\"https://github.com/freecodexyz/free-code/tree/4b9d30f7953273e567a18eb819f4eddd45fcc877\">Claude Code 2.1.87 源码快照（固定提交）</a></p></li><li><p><a href=\"https://github.com/freecodexyz/free-code/blob/4b9d30f7953273e567a18eb819f4eddd45fcc877/package.json\">Claude Code 2.1.87 的 package.json</a></p></li><li><p><a href=\"https://github.com/apple-oss-distributions/xnu/blob/main/bsd/man/man2/open.2\">Apple XNU </a><code>open(2)</code><a href=\"https://github.com/apple-oss-distributions/xnu/blob/main/bsd/man/man2/open.2\">：</a><code>O_NOFOLLOW</code><a href=\"https://github.com/apple-oss-distributions/xnu/blob/main/bsd/man/man2/open.2\"> 与 </a><code>O_NOFOLLOW_ANY</code></p></li></ol>","original","zhKind","complete","Agent 安全","复现","漏洞分析","加固","Google","Apple","https://xz.aliyun.com/news/93227","先知社区",{"_186":187,"_188":-5},"changelogVersion","2026-10-01T08:00","release"]
