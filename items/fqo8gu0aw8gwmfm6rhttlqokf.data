[{"_1":2,"_3":4},"root",{"_5":135},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795048831000,"id","fqo8gu0aw8gwmfm6rhttlqokf","title","Siemens 15 款工业自动化软件受 CVE-2026-111497 影响，CVSS 9.8","originalTitle","Siemens Industrial Automation Software Products","summary","Siemens 15 款工业自动化软件受 Node.js Brotli 解码器越界写漏洞 CVE-2026-111497 影响，CVSS v3.1 为 9.8，远程未认证攻击者可造成内存破坏、敏感信息泄露、拒绝服务或潜在执行任意代码。","reason","公告区分了已修复、暂无修复与不计划修复的产品，并给出 Brotli 更新版本和临时缓解措施，便于工控用户逐项评估处置路径。","source",{"_73":134},"links",{"_126":133},"publishedAt","2026-11-17T12:00:00.000Z","discoveredAt","2026-11-17T16:20:31.851Z","timelineAt","category","vuln","tags",[119,130,131,132,46],"score",74,"selected",true,"channel","news","story",{"_81":82,"_13":83},"x","readingMode","full","author","CISA","body",{"_61":125,"_126":-5,"_127":128,"_129":37},"outline",[84,85,86,87,88,89,90,91,92,93,94,95],"relatedStories",[80],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","f71XBXB4aAqc","reportCount",1,"additionalSourceCount",0,{"_72":79,"_73":46},{"_72":77,"_73":78},{"_72":75,"_73":76},{"_72":31,"_73":74},"slug","name","漏洞披露","industrial","工业控制","supply-chain","供应链安全","cisa",{"_81":82,"_13":83},"publicId","7c28657e-31de-4920-a954-1af1b284351f","CISA确认Brotli漏洞遭在野利用",{"_11":123,"_97":124,"_99":100},{"_11":120,"_97":121,"_99":122},{"_11":118,"_97":119,"_99":100},{"_11":115,"_97":116,"_99":117},{"_11":113,"_97":114,"_99":100},{"_11":111,"_97":112,"_99":100},{"_11":109,"_97":110,"_99":100},{"_11":107,"_97":108,"_99":100},{"_11":105,"_97":106,"_99":100},{"_11":103,"_97":104,"_99":100},{"_11":101,"_97":102,"_99":100},{"_11":96,"_97":98,"_99":100},"sec-12","text","法律声明和使用条款","level",2,"sec-11","修订历史","sec-10","咨询转换免责声明","sec-9","推荐实践","sec-8","使用条款","sec-7","附加资源","sec-6","通用建议","sec-5","致谢","sec-4","15 个受影响产品",4,"sec-3","漏洞","sec-2","背景",3,"sec-1","摘要","<p><a href=\"https://github.com/cisagov/CSAF/blob/develop/csaf_files/OT/white/2026/icsa-26-321-03.json\"><strong>查看 CSAF</strong></a></p><h2 id=\"sec-1\">摘要</h2><p><strong>2026 年 10 月 21 日，Node.js 项目发布了安全更新，用于修复 Node.js 捆绑的 Brotli 解码器中的一个严重漏洞，该漏洞通常称为“Node2Shell”（跟踪编号为 CVE-2026-111497）。该漏洞是一个越界写入漏洞，可能允许远程攻击者造成内存损坏，并可能执行任意代码。本公告概述该漏洞对 various Siemens 产品的影响状态。Siemens 已为若干受影响产品发布了新版本，并建议更新至最新版本。Siemens 正在准备进一步的修复措施，并针对尚无修复措施或修复措施尚未发布的产品建议采取特定的缓解方案。</strong></p><p>以下版本的 Siemens Industrial Automation Software Products 受到影响：</p><ul>\n<li>COMOS Walkinside vers:all/* (CVE-2026-111497)</li>\n<li>gDAP (gPROMS Digital Application Platform) vers:all/* ()</li>\n<li>Project Server Web Administration Tool vers:all/* (CVE-2026-111497)</li>\n<li>SIMATIC BRAUMAT vers:intdot/&gt;=8.2.0.1|&lt;8.2.0.5 (CVE-2026-111497)</li>\n<li>SIMATIC Profiling Tool vers:all/* (CVE-2026-111497)</li>\n<li>SIMATIC SISTAR vers:intdot/&gt;=8.2.0.1|&lt;8.2.0.5 (CVE-2026-111497)</li>\n<li>SIMATIC WinCC Companion vers:all/* (CVE-2026-111497)</li>\n<li>SIMATIC WinCC OA V3.20 vers:intdot/&lt;3.20.17.1 (CVE-2026-111497)</li>\n<li>SIMATIC WinCC OA V3.21 vers:all/* (CVE-2026-111497)</li>\n<li>SIMATIC WinCC Runtime Professional vers:all/* (CVE-2026-111497)</li>\n<li>SIMATIC WinCC Unified for Industrial Edge vers:all/* (CVE-2026-111497)</li>\n<li>SIMATIC WinCC Unified PC Runtime vers:all/* (CVE-2026-111497)</li>\n<li>SIMATIC WinCC Unified SIQENCE vers:all/* (CVE-2026-111497)</li>\n<li>SIMATIC WinCC V7/V8 vers:all/* (CVE-2026-111497)</li>\n<li>TIA Administrator vers:all/* (CVE-2026-111497)</li>\n<li>User Management Component (UMC) vers:all/* (CVE-2026-111497)</li>\n</ul><table>\n<thead>\n<tr>\n<th>CVSS</th>\n<th>供应商</th>\n<th>设备</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>v3 9.8</td>\n<td>Siemens</td>\n<td>COMOS Walkinside</td>\n</tr>\n</tbody>\n</table><table>\n<thead>\n<tr>\n<th>1 个漏洞</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>越界写入</td>\n</tr>\n</tbody>\n</table><h3 id=\"sec-2\">背景</h3><ul>\n<li><strong>关键基础设施行业：</strong>关键制造业、食品与农业、能源</li>\n<li><strong>部署国家/地区：</strong>全球</li>\n<li><strong>公司总部所在地：</strong>德国</li>\n</ul><hr><h2 id=\"sec-3\">漏洞</h2><p>CVE-2026-111497</p><p>Google Brotli 1.0.3 至 1.2.0 版本中所有平台的 Brotli 解码器（c/dec/decode.c）存在一个缓冲区溢出漏洞。远程未经验证的攻击者可通过特制的 Brotli 压缩流破坏相邻解码器状态的内存、披露敏感内存内容、造成拒绝服务，或可能执行任意代码。用户需要将 1.0.3 至 1.2.0 之间的任何 Brotli 库或二进制文件更新至最新可用版本：1.0.10、1.1.1 或 1.2.1。</p><h4 id=\"sec-4\">15 个受影响产品</h4><hr><h5>COMOS Walkinside</h5><p>产品状态：known_affected, known_not_affected</p><h5>修复措施</h5><p><strong>缓解措施</strong><br>如果并非严格必需，请暂时在应用层或代理层禁用 Brotli 压缩和解压缩</p><p><strong>暂无</strong><br>目前没有可用的修复措施</p><hr><h5>SIMATIC WinCC Runtime Professional</h5><p>产品状态：known_affected, known_not_affected</p><h5>修复措施</h5><p><strong>缓解措施</strong><br>如果并非严格必需，请暂时在应用层或代理层禁用 Brotli 压缩和解压缩</p><p><strong>暂无</strong><br>目前没有可用的修复措施</p><hr><h5>SIMATIC WinCC Unified for Industrial Edge</h5><p>产品状态：known_affected, known_not_affected</p><h5>修复措施</h5><p><strong>缓解措施</strong><br>如果并非严格必需，请暂时在应用层或代理层禁用 Brotli 压缩和解压缩</p><p><strong>暂无可用方案</strong><br>目前没有修复方案</p><hr><h5>SIMATIC WinCC Unified PC Runtime</h5><p>产品状态：known_affected, known_not_affected</p><h5>补救措施</h5><p><strong>缓解措施</strong><br>如果并非严格必需，则在应用层或代理层暂时禁用 Brotli 压缩与解压缩</p><p><strong>暂无可用方案</strong><br>目前没有修复方案</p><hr><h5>SIMATIC WinCC Unified SIQENCE</h5><p>产品状态：known_affected, known_not_affected</p><h5>补救措施</h5><p><strong>缓解措施</strong><br>如果并非严格必需，则在应用层或代理层暂时禁用 Brotli 压缩与解压缩</p><p><strong>暂无可用方案</strong><br>目前没有修复方案</p><hr><h5>SIMATIC WinCC V7/V8</h5><p>产品状态：known_affected, known_not_affected</p><h5>补救措施</h5><p><strong>缓解措施</strong><br>如果并非严格必需，则在应用层或代理层暂时禁用 Brotli 压缩与解压缩</p><p><strong>暂无可用方案</strong><br>目前没有修复方案</p><hr><h5>TIA Administrator</h5><p>产品状态：known_affected, known_not_affected</p><h5>补救措施</h5><p><strong>缓解措施</strong><br>如果并非严格必需，则在应用层或代理层暂时禁用 Brotli 压缩与解压缩。如果启用了 UMC 身份验证，请阻止使用 Brotli 压缩的请求：在 IIS 管理器中选中 Default Web Site，打开“Request Filtering”&gt;“Rules”，点击“Add Filtering Rule”，Name 填写“CVE-2026-111497”，Scan Headers 填写“Content-Encoding”，Deny Strings 填写“br”，然后点击 OK。</p><p><strong>暂无可用方案</strong><br>目前没有修复方案</p><hr><h5>User Management Component (UMC)</h5><p>产品状态：known_affected, known_not_affected</p><h5>补救措施</h5><p><strong>缓解措施</strong><br>如果并非严格必需，则在应用层或代理层暂时禁用 Brotli 压缩与解压缩。在 IIS 管理器中，选中 Default Web Site，打开“Request Filtering”&gt;“Rules”，点击“Add Filtering Rule”，Name 填写“CVE-2026-111497”，Scan Headers 填写“Content-Encoding”，Deny Strings 填写“br”，然后点击 OK。</p><p><strong>暂无可用方案</strong><br>目前没有修复方案</p><hr><h5>Project Server Web Administration Tool</h5><p>产品状态：known_affected, known_not_affected</p><h5>补救措施</h5><p><strong>缓解措施</strong><br>如果并非严格必需，则在应用层或代理层暂时禁用 Brotli 压缩与解压缩</p><p><strong>暂无可用方案</strong><br>目前没有修复方案</p><hr><h5>SIMATIC BRAUMAT &gt;= V8.2 Update 1 &lt; V8.2 Update 5</h5><p>产品状态：known_affected, known_not_affected</p><h5>补救措施</h5><p><strong>缓解措施</strong><br>如果并非严格必需，则在应用层或代理层暂时禁用 Brotli 压缩与解压缩</p><p><strong>厂商修复</strong><br>更新到 V8.2 Update 5 或更高版本</p><hr><h5>SIMATIC Profiling Tool</h5><p>产品状态：known_affected, known_not_affected</p><h5>补救措施</h5><p><strong>缓解措施</strong><br>如果并非严格必需，则在应用层或代理层暂时禁用 Brotli 压缩与解压缩</p><p><strong>暂无修复计划</strong><br>目前没有修复计划</p><hr><h5>SIMATIC SISTAR &gt;= V8.2 Update 1 &lt; V8.2 Update 5</h5><p>产品状态：known_affected, known_not_affected</p><h5>补救措施</h5><p><strong>缓解措施</strong><br>如果并非严格必需，则在应用层或代理层暂时禁用 Brotli 压缩与解压缩</p><p><strong>厂商修复</strong><br>更新到 V8.2 Update 5 或更高版本</p><hr><h5>SIMATIC WinCC Companion</h5><p>产品状态：known_affected, known_not_affected</p><h5>补救措施</h5><p><strong>缓解措施</strong><br>如果并非严格必需，请在应用程序层或代理层暂时禁用 Brotli 压缩和解压缩</p><p><strong>暂无</strong><br>目前没有可用的修复程序</p><hr><h5>SIMATIC WinCC OA V3.20 &lt; V3.20 P17.1</h5><p>产品状态：known_affected, known_not_affected</p><h5>修复措施</h5><p><strong>供应商修复</strong><br>更新至 V3.20 P17.1 或更高版本</p><hr><h5>SIMATIC WinCC OA V3.21</h5><p>产品状态：known_affected, known_not_affected</p><h5>修复措施</h5><p><strong>缓解措施</strong><br>如果并非严格必需，请在应用程序层或代理层暂时禁用 Brotli 压缩和解压缩</p><p><strong>暂无</strong><br>目前没有可用的修复程序</p><hr><h5>附加指标</h5><p><strong>相关 CWE：</strong> <a href=\"https://cwe.mitre.org/data/definitions/787.html\">CWE-787 越界写入</a></p><table>\n<thead>\n<tr>\n<th>CVSS 版本</th>\n<th>基础评分</th>\n<th>基础严重性</th>\n<th>向量字符串</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>3.1</td>\n<td>9.8</td>\n<td>严重</td>\n<td><a href=\"https://www.first.org/cvss/calculator/3.1#CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H\">CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H</a></td>\n</tr>\n</tbody>\n</table><hr><p><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-111497\">查看 CVE 详情</a></p><hr><h2 id=\"sec-5\">致谢</h2><ul>\n<li>Siemens ProductCERT 已向 CISA 报告此漏洞。</li>\n</ul><hr><h2 id=\"sec-6\">通用建议</h2><p>作为一项通用安全措施，Siemens 强烈建议使用适当的机制保护对设备的网络访问。为了在受保护的 IT 环境中运行这些设备，Siemens 建议根据 Siemens 的工业安全操作指南配置该环境（下载：https://www.siemens.com/cert/operational-guidelines-industrial-security），并遵循产品手册中的建议。有关 Siemens 工业安全的更多信息，请访问：https://www.siemens.com/industrialsecurity</p><hr><h2 id=\"sec-7\">附加资源</h2><p>如需进一步咨询 Siemens 产品和解决方案中的安全漏洞，请联系 Siemens ProductCERT：https://www.siemens.com/cert/advisories</p><hr><h2 id=\"sec-8\">使用条款</h2><p>使用 Siemens 安全公告须遵守以下列出的条款和条件：https://www.siemens.com/productcert/terms-of-use.</p><hr><h2 id=\"sec-9\">推荐实践</h2><p>CISA 建议用户采取防御措施，以尽量降低这些漏洞被利用的风险。</p><ul>\n<li>尽量减少所有控制系统设备和/或系统的网络暴露，确保其<a href=\"https://www.cisa.gov/uscert/ics/alerts/ICS-ALERT-10-301-01\">无法从互联网访问</a>。</li>\n<li>将控制系统的网络和远程设备置于防火墙之后，并将其与业务网络隔离。</li>\n<li>需要远程访问时，请采用更安全的方法，例如虚拟专用网络 (VPN)，但应注意 VPN 可能存在漏洞，应更新至可用的最新版本。此外还应认识到，VPN 的安全性取决于所连接的设备。</li>\n</ul><p>CISA 提醒组织在部署防御措施之前进行适当的影响分析和风险评估。</p><p>CISA 还在 ICS 网页的<a href=\"https://www.cisa.gov/resources-tools/resources/ics-recommended-practices\">控制系统安全推荐实践</a>章节中提供了相关内容，网址为 <a href=\"https://www.cisa.gov/topics/industrial-control-systems\">cisa.gov/ics</a>。CISA 提供了多份详细说明网络防御最佳实践的可用产品，供阅读和下载，其中包括 <a href=\"https://www.cisa.gov/sites/default/files/recommended_practices/NCCIC_ICS-CERT_Defense_in_Depth_2016_S508C.pdf\">通过纵深防御策略提升工业控制系统网络安全</a>。</p><p>CISA 鼓励组织实施推荐的网络安全策略，以<a href=\"https://www.cisa.gov/sites/default/files/publications/Cybersecurity_Best_Practices_for_Industrial_Control_Systems.pdf\">主动防御 ICS 资产</a>。</p><p>更多缓解指导信息和推荐实践已在 ICS 网页 <a href=\"https://www.cisa.gov/topics/industrial-control-systems\">cisa.gov/ics</a> 上公开提供，详见技术信息论文 <a href=\"https://www.cisa.gov/news-events/news/targeted-cyber-intrusion-detection-and-mitigation-strategies-update-b\">ICS-TIP-12-146-01B--定向网络入侵检测与缓解策略</a>。</p><p>观察到疑似恶意活动的组织应遵循既定的内部程序，并将发现报告给 CISA，以便进行追踪并与其他事件进行关联分析。</p><hr><h2 id=\"sec-10\">咨询转换免责声明</h2><p>本 ICSA 逐字转载 Siemens ProductCERT SSA-242944，内容直接转换自该供应商的 Common Security Advisory Framework (CSAF) 咨询。重新发布到 CISA 网站旨在提高可见性，并且仅按“原样”提供 informational purposes。CISA 不对重新发布的咨询的编辑或技术准确性负责，并且不对本咨询中包含的任何信息提供任何形式的担保。此外，CISA 不认可任何商业产品或服务。如对本咨询有任何疑问，请直接联系 Siemens ProductCERT。</p><h2 id=\"sec-11\">修订历史</h2><ul>\n<li><strong>首次发布日期：</strong>2026-11-10</li>\n</ul><table>\n<thead>\n<tr>\n<th>日期</th>\n<th>修订</th>\n<th>摘要</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>2026-11-10</td>\n<td>1</td>\n<td>发布日期</td>\n</tr>\n<tr>\n<td>2026-11-17</td>\n<td>2</td>\n<td>首次在 CISA 重新发布 Siemens ProductCERT SSA-242944 咨询</td>\n</tr>\n</tbody>\n</table><hr><h2 id=\"sec-12\">法律声明和使用条款</h2>","original","zhKind","translation","complete","补丁","工控","供应链","https://www.cisa.gov/news-events/ics-advisories/icsa-26-321-03","CISA 安全公告",{"_136":137,"_138":-5},"changelogVersion","2026-10-01T08:00","release"]
