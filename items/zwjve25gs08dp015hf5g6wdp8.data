[{"_1":2,"_3":4},"root",{"_5":116},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1795912857000,"id","zwjve25gs08dp015hf5g6wdp8","title","Linux内核NFS越界写入漏洞CVE-2026-99362公开，CVSS 9.8","originalTitle","【漏洞通告】Linux内核NFS越界写入漏洞（CVE-2026-99362）","summary","Linux内核NFS越界写入漏洞CVE-2026-99362的细节已公开，CVSS评分为9.8，未经身份验证的攻击者可向默认TCP 2049端口发送特制COMPOUND请求，造成堆越界写入、内存损坏、信息泄露或系统崩溃，特定条件下可实现远程代码执行。","reason","source",{"_73":115},"links",{"_103":114},"publishedAt","2026-11-27T10:35:00.000Z","discoveredAt","2026-11-27T17:02:38.571Z","timelineAt","category","vuln","tags",[106,107,108,109,110,111,112,113],"score",69,"selected",false,"channel","news","story",{"_81":82,"_13":83},"x","readingMode","full","author","body",{"_60":102,"_103":-5,"_104":103,"_105":55},"outline",[84,85,86,87,88],"relatedStories",[80],"topics",[67,68,69,70],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","fOB3GoIux80M","reportCount",1,"additionalSourceCount",0,{"_71":78,"_73":79},{"_71":76,"_73":77},{"_71":30,"_73":75},{"_71":72,"_73":74},"slug","research","name","技术研究","漏洞披露","kernel","内核与系统","supply-chain","供应链安全",{"_81":82,"_13":83},"publicId","11cb4659-9003-4a16-9651-965bd1b161ef","Linux内核NFS越界写入漏洞CVE-2026-99362已修复",{"_11":100,"_90":101,"_92":93},{"_11":98,"_90":99,"_92":93},{"_11":96,"_90":97,"_92":93},{"_11":94,"_90":95,"_92":93},{"_11":89,"_90":91,"_92":93},"sec-5","text","4.2 其他防护措施","level",3,"sec-4","4.1 官方升级","sec-3","3.1 人工检测","sec-2","不受影响版本","sec-1","受影响版本","<p><span>NS-CERT</span> <span>2026-11-27 18:35</span> <span>四川</span></p><p><img src=\"/dailyinfo/media/27f46b579d5ce359.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>近日，绿盟科技CERT监测到Linux发布安全更新，修复了Linux内核NFS越界写入漏洞（CVE-2026-99362），被称为“NFS2root”；CVSS评分9.8，目前漏洞细节已公开，请相关用户尽快采取措施进行防护。</p><p><strong><span>通告编号 NS-2026-0041</span></strong></p><p><span><span>2026-11-27</span></span></p><table><tbody><tr><td><strong><span><span>TAG：</span></span></strong></td><td colspan=\"3\"><p><strong><span><span>Linux内核、NFS、CVE-2026-99362</span></span></strong></p></td></tr><tr><td><strong><span><span>在野利用：</span></span></strong></td><td><p><strong><span>未发现</span></strong></p></td><td><strong><span><span>PoC状态：</span></span></strong></td><td><p><strong><span>漏洞细节公开</span></strong></p></td></tr><tr><td><strong><span><span>漏洞危害：</span></span></strong></td><td colspan=\"3\"><p><strong><span>攻击者利用此漏洞，可造成内存破坏、信息泄露甚至远程代码执行。</span></strong></p></td></tr></tbody></table><p><strong><span>1</span></strong></p><p><strong><span><span>漏洞概述</span></span></strong></p><p><span>近日，绿盟科技CERT监测到Linux发布安全更新，修复了Linux内核NFS越界写入漏洞（CVE-2026-99362），被称为“NFS2root”；由于Linux内核NFS服务器（nfsd）在接受会话槽序号前未充分校验SEQUENCE响应是否满足协商的缓存回复限制，未经身份验证的攻击者可通过协商极小的缓存响应大小并向NFS服务（默认TCP 2049端口）发送特制的COMPOUND请求进行堆越界写入，从而造成内存损坏、信息泄露或系统崩溃，在特定条件下可实现远程代码执行。CVSS评分9.8，目前漏洞细节已公开，请相关用户尽快采取措施进行防护。</span></p><p><span>Linux内核是Linux操作系统的核心组件，负责进程管理、内存管理、设备驱动、文件系统及网络协议栈等关键功能；nfsd是其内置的网络文件系统服务器，用于通过网络向其他主机共享文件和目录。</span></p><p><span>参考链接：</span></p><p><span><a href=\"https://access.redhat.com/security/cve/cve-2026-99362\">https://access.redhat.com/security/cve/cve-2026-99362</a></span></p><p><strong><span>SEE MORE →</span></strong></p><p><span><strong><span>2</span></strong></span><strong><span>影响范围</span></strong></p><h3 id=\"sec-1\"><strong><span>受影响版本</span></strong></h3><ul><li><p><span>3.16 &lt;= Linux Kernel</span></p></li><li><p><span>Linux Kernel 5.10.x &lt; 5.10.275</span></p></li><li><p><span>Linux Kernel 5.15.x &lt; 5.15.226</span></p></li><li><p><span>Linux Kernel 6.1.x &lt; 6.1.193</span></p></li><li><p><span>Linux Kernel 6.6.x &lt; 6.6.163</span></p></li><li><p><span>Linux Kernel 6.12.x &lt; 6.12.117</span></p></li><li><p><span>Linux Kernel 6.18.x &lt; 6.18.61</span></p></li><li><p><span>Linux Kernel 7.3.x &lt; 7.3.2</span></p></li></ul><p><span>注：影响运行nfsd服务并启用NFSv4.1/v4.2会话的主机；</span></p><h3 id=\"sec-2\"><strong><span>不受影响版本</span></strong></h3><ul><li><p><span>Linux Kernel &lt; 3.16</span></p></li><li><p><span>Linux Kernel 5.10.x &gt;= 5.10.275</span></p></li><li><p><span>Linux Kernel 5.15.x &gt;= 5.15.226</span></p></li><li><p><span>Linux Kernel 6.1.x &gt;= 6.1.193</span></p></li><li><p><span>Linux Kernel 6.6.x &gt;= 6.6.163</span></p></li><li><p><span>Linux Kernel 6.12.x &gt;= 6.12.117</span></p></li><li><p><span>Linux Kernel 6.18.x &gt;= 6.18.61</span></p></li><li><p><span>Linux Kernel 7.3.x &gt;= 7.3.2</span></p></li><li><p><span>Linux Kernel 7.4-rc &gt;= 7.4-rc1</span></p></li><li><p><span>Linux Kernel &gt;= 7.4</span></p></li></ul><p><span><strong><span>3</span></strong></span><strong><span>漏洞检测</span></strong></p><h3 id=\"sec-3\"><strong><span>3.1 人工检测</span></strong></h3><p><span>相关用户可以通过检查当前运行的内核版本及nfsd服务的NFSv4.1/v4.2会话启用情况，判断当前主机是否在受影响范围：</span></p><p><span>1、在Linux主机上执行以下命令查看当前运行的内核版本：</span></p><pre><code><span>uname -r</span></code></pre><p><span>2、检查主机是否运行nfsd服务：</span></p><pre><code><span># RHEL、Rocky Linux、AlmaLinux等发行版可执行：</span><span><br></span><span>systemctl status nfs-server</span><span><br></span><span># Debian、Ubuntu等发行版还应检查服务状态：</span><span><br></span><span>systemctl status nfs-kernel-server</span></code></pre><p><span>3、检查NFSv4.1/v4.2的实际启用情况：查看/etc/nfs.conf中完整的[nfsd]段：</span></p><pre><code><span>grep -A5 '\\[nfsd\\]' /etc/nfs.conf</span></code></pre><p><span>若当前运行的内核版本在受影响范围，且主机运行nfsd服务并启用了NFSv4.1或v4.2会话，则可能存在安全风险。</span></p><p><span><strong><span>4</span></strong></span><strong><span>漏洞防护</span></strong></p><h3 id=\"sec-4\"><strong><span>4.1 官方升级</span></strong></h3><p><span>目前官方已发布新版本与安全补丁修复此漏洞，请受影响的用户尽快更新进行防护。下载链接：<a href=\"https://www.kernel.org/\">https://www.kernel.org</a></span></p><p><span><a href=\"https://git.kernel.org/stable/c/35ff1a7a7e3835c3e974bc5c45d335897564ceae\">https://git.kernel.org/stable/c/35ff1a7a7e3835c3e974bc5c45d335897564ceae</a></span></p><p><span>注：发行版可能回移植修复补丁，用户应以实际发行版厂商公告为准；升级后需重启系统，并确认当前运行的内核已包含修复。</span></p><h3 id=\"sec-5\"><strong><span>4.2 其他防护措施</span></strong></h3><p><span>在不影响业务的情况下，相关用户可采取以下措施进行临时缓解：</span></p><p><span>1、对TCP 2049端口进行访问限制，仅允许可信主机访问NFS服务：</span></p><pre><code><span>nft add rule inet filter input tcp dport 2049 ip saddr != 10.20.0.0/16 drop</span><span><br></span><span>#使用firewalld限制受信任的主机访问NFS</span><span><br></span><span>bash</span><span><br></span><span>firewall-cmd --permanent --remove-service=nfs</span><span><br></span><span>firewall-cmd --permanent --add-rich-rule='rule family=\"ipv4\" source address=\"&lt;trusted_ip_or_subnet&gt;\" service name=\"nfs\" accept'</span><span><br></span><span>firewall-cmd --reload</span></code></pre><p><span>2、在/etc/nfs.conf中设置vers4.1=n、vers4.2=n，关闭NFSv4.1和v4.2会话：</span></p><pre><code><span>[nfsd]vers4.1=nvers4.2=n</span></code></pre><p><span>3、若无需NFS服务，可停止并禁用nfs-server</span></p><pre><code><span>bash</span><span><br></span><span>systemctl stop nfs-server</span><span><br></span><span>systemctl disable nfs-server</span></code></pre><p><strong><span>END</span></strong></p><p><img src=\"/dailyinfo/media/aebdd6059a41f8ba.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img src=\"/dailyinfo/media/6866e5a0a63bb30d.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>声明</span></strong></p><p><span>本安全公告仅用来描述可能存在的安全问题，绿盟科技不为此安全公告提供任何保证或承诺。由于传播、利用此安全公告所提供的信息而造成的任何直接或者间接的后果及损失，均由使用者本人负责，绿盟科技以及安全公告作者不为此承担任何责任。</span></p><p><span>绿盟科技拥有对此安全公告的修改和解释权。如欲转载或传播此安全公告，必须保证此安全公告的完整性，包括版权声明等全部内容。未经绿盟科技允许，不得任意修改或者增减此安全公告内容，不得以任何方式将其用于商业目的。</span></p><p><img src=\"/dailyinfo/media/6866e5a0a63bb30d.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><span><strong><span>绿盟科技CERT</span></strong></span><span><span>∣</span></span><span><span>微信公众号</span></span></p><p><img src=\"/dailyinfo/media/59352390dd7af0d9.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><img src=\"/dailyinfo/media/7c6ed594a68d5ac8.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>长按识别二维码，关注网络安全威胁信息</span></span></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=84d7b6d0&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzk0MjE3ODkxNg%3D%3D%26mid%3D2247494345%26idx%3D1%26sn%3Db554a329de0ef9c022e6e8cc7392d4d4\">跳转微信打开</a></p>","original","zhKind","complete","漏洞","补丁","漏洞分析","内核","供应链","Red Hat","Debian","Ubuntu","https://mp.weixin.qq.com/s?__biz=Mzk0MjE3ODkxNg==&mid=2247494345&idx=1&sn=b554a329de0ef9c022e6e8cc7392d4d4","绿盟科技CERT",{"_117":118,"_119":-5},"changelogVersion","2026-10-01T08:00","release"]
