[{"_1":2,"_3":4},"root",{"_5":92},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":60,"_61":62},"expiresAt",1794357635000,"id","cnlifp96qtj0q6b7edwbj1mv6","title","DigiCert 数据泄露事件暴露客户信息与身份证件","originalTitle","DigiCert data breach exposes customer information, identity documents","summary","DigiCert 因 2025 年 2 月服务器迁移时将内部业务系统错误暴露在互联网，导致外部用户创建账户并访问归档客户数据。进一步调查确认一个未授权账户于 2026 年 6 月 27 日至 7 月 2 日以只读方式访问信息，涉及姓名、工作邮箱、电话、工作地址，部分记录含驾照、护照或水电账单等身份证件。","reason","材料还原了暴露原因、授权缺陷和确认访问的时间线，并说明受影响字段与已部署的访问控制，便于判断泄露范围和处置重点。","source",{"_72":91},"links",{"_62":90},"publishedAt","2026-11-05T16:12:46.000Z","discoveredAt","2026-11-06T00:01:13.077Z","timelineAt","category","activity","tags",[88,73,89],"score",70,"selected",true,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","Lawrence Abrams","body",{"_84":-5,"_62":85,"_86":-5,"_87":60},"outline",[78],"relatedStories",[74],"topics",[69],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation",false,"bodyLanguage","original","factId","fgFfd7YmaEXc","reportCount",1,"additionalSourceCount",0,{"_70":71,"_72":73},"slug","identity","name","身份与访问",{"_75":76,"_13":77},"publicId","b5a7ab74-6019-4c09-a5d6-fea350b465f2","DigiCert披露迁移导致客户数据泄露",{"_11":79,"_80":81,"_82":83},"sec-1","text","Uncover email threats your existing defenses may miss.","level",2,"zh","<p><img alt=\"DigiCert\" height=\"900\" src=\"/dailyinfo/media/6ad8a515ac7d001b.jpg\" srcset=\"/dailyinfo/media/6a7d3e06d9314c2a.jpg 720w, /dailyinfo/media/02df86309f29050c.jpg 1200w, /dailyinfo/media/6ad8a515ac7d001b.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>DigiCert warns it suffered a data breach after a server migration mistakenly exposed an internal business system to the internet, allowing unauthorized access to customer information and identity documents.</p><p>The certificate authority says the breach affected a small portion of its archived customer data, including names, business email addresses, phone numbers, and business addresses.</p><p>For some people, the exposed records also contained personal identification documents, such as driver's licenses, passports, and utility bills.</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/4e9a8167b7d47a2d.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>DigiCert has begun sending data breach notifications to affected customers, with cloud architect Fabian Bader sharing a copy of the notification on X.</p><p>\"Thanks @digicert that your data leak was 'limited' to only my full PII data and potentially any verification documents I submitted for my certificate,\" <a href=\"https://x.com/fabian_bader/status/2118079207171568065\">Bader wrote</a>.</p><p><a href=\"http://x.com/fabian_bader/status/2118079207171568065\"><img alt=\"Fabian tweet\" height=\"600\" src=\"/dailyinfo/media/c0fb46e60cf060f5.jpg\" loading=\"lazy\" decoding=\"async\" width=\"478\"></a></p><p>In the notification, DigiCert said it was still reviewing identification documents to determine those who were affected and would notify them once the review was complete.</p><p>\"The information involved was limited to names, business email addresses, phone numbers, and business address shared with DigiCert and, if provided, may have included an identification document such as a driver’s license, passport, utility bill or other document with name and address,\" the data breach notification reads.</p><p>An <a href=\"https://bugzilla.mozilla.org/show_bug.cgi?id=2084460#c2\">incident report</a> on Mozilla's Bugzilla platform explains that a February 2025 server migration mistakenly exposed an internal business system to the internet that was previously only accessible via VPN.</p><p>The exposed system contained a self-registration feature intended for other applications, allowing external users to create accounts.</p><p>Although these accounts weren't assigned to any particular application, an authorization flaw let them access archived customer information in read-only mode.</p><p>DigiCert first discovered unauthorized accounts on the exposed system in June 2026, but initially determined they couldn't access customer information because they weren't assigned to an application.</p><p>The company subsequently received a report through its managed security research program warning that external users could create accounts on the system.</p><p>DigiCert deployed security fixes to restrict access to the system and address the authorization flaw, but did not realize at the time that archived data had been accessed.</p><p>It wasn't until October 19 that a further investigation confirmed an unauthorized account had accessed customer information between June 27 and July 2, 2026.</p><p>\"The incident was initially handled as an account-creation issue rather than a data-access event,\" DigiCert acknowledged in its report.</p><p>DigiCert says the unauthorized account had read-only access and could not modify records, approve certificate validations, or issue certificates.</p><p>The company has now restricted access to the affected system, disabled self-registration, and added additional access controls.</p><p>DigiCert says its certificate authority services, CertCentral, and DigiCert ONE platforms were not compromised, and that customer login credentials and issued certificates remain secure.</p><p>BleepingComputer has contacted DigiCert to ask further questions about the incident, including how many people were impacted, and will update the story if we get a response.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/ec08be135363bed0.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Uncover email threats your existing defenses may miss.</a>\n        </h2><p>Adaptive Security's AI agents analyze email intent, context, and behavior to uncover phishing, business email compromise, and invoice fraud.</p><p>See what's getting through with a 14-day read-only scan of Microsoft 365 or Google Workspace, with no MX changes.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Start your free email security scan.</a>\n    </p>","zhKind","complete","数据泄露","凭据","https://www.bleepingcomputer.com/news/security/digicert-data-breach-exposes-customer-information-identity-documents/","BleepingComputer",{"_93":94,"_95":-5},"changelogVersion","2026-10-01T08:00","release"]
