[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794444092000,"id","dtwa818ng8oa0lmiwfqo5kf3w","title","Grok Build 生成应用暴露风险分析：35,578 个应用无需登录即可访问","originalTitle","Over 35,000 Grok-Built Apps Exposed Online, Some Leaking Confidential Data and Passwords","summary","安全公司 Claroc 发现 37,571 个由 Grok Build 生成并发布的应用中，35,578 个无需登录即可访问，约 1/10 包含内部业务或个人数据。","reason","文章给出公开暴露规模、涉及组织类型与两种测试应用的具体访问控制缺陷，便于安全团队核查自建应用的暴露风险。","source",{"_74":103},"links",{"_93":102},"publishedAt","2026-11-11T12:19:40.000Z","discoveredAt","2026-11-11T13:58:37.184Z","timelineAt","category","disclosure","tags",[77,75,97,98,99,81,100,101],"score",81,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_61":92,"_93":-5,"_94":95,"_96":37},"outline",[86],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fbs8gEUbNQkI","reportCount",1,"additionalSourceCount",0,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","ai-security","name","AI 安全","research","技术研究","ai-agent","AI Agent 安全","identity","身份与访问",{"_83":84,"_13":85},"publicId","2465076f-d85e-4c82-a51c-5aec1d125203","Grok Build生成应用大面积无需登录访问",{"_11":87,"_88":89,"_90":91},"sec-1","text","如何检查你所在组织的 Grok 应用","level",3,"<p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEh54t26Pk-bNbcIXgu8KrKpT_zN1KxEov16xTFlJ8kiPJ3-btXjGUE1lb0ZpamQU5jUHwmxzxHpYLsAQfiaHQUu3gxCIUw2gsEYNwMjL6nRm_jWm6t_VdHJkz6xj3fAsmTZKP8Bbax1qdT98a_PY4ynv81njiDyPXvIIihl4dqXxxC9pMMf8-Mn9dziy_A/s1600/grokai.jpg\"><img alt=\"\" src=\"/dailyinfo/media/3adc94c34e57c59e.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>在安全公司 <strong>Claroc </strong>昨天发现的 37,571 个由 Grok 构建的在线应用中，35,578 个无需登录即可被任何人访问，研究人员表示。</p><p>其中包括由社交网络 X 和 SpaceXSI（制作 Grok AI 助手的公司）的员工构建的 24 个应用。大多数开放应用是游戏、落地页和计算器，但约有十分之一包含内部业务或个人数据。</p><p>这些员工应用包括一份面向新销售人员的机密入职计划、一张包含 594 个客户账户的销售区域地图，以及一份标记为机密的、面向美国联邦机构的 X 广告提案。研究人员表示，SpaceXSI（前身为 xAI）此后已下线全部 24 个员工应用，但未下线其他用户的应用。</p><p>除了这些员工应用外，开放应用还包含研究人员能够识别的另外 30 个组织的内部数据，涉及建筑、能源、医疗保健和国防等领域。其中，26 个组织的员工人数超过 1,000，6 个是《财富》500 强公司。</p><p>根据研究人员在其<a href=\"https://blog.claroc.io/ghostshares-grok-build-apps/\">报告</a>中的估计，大约 2% 的开放应用包含严重到足以被评为高危或严重级别的内容。</p><p>暴露的材料包括一家医院集团一份可搜索的、包含 3,500 多名员工的名单、一份针对单个患者的重症监护简报、一个消防部门的实时值班表，以及一份承包商的工时表，其代码以明文形式保存了每位员工的密码。</p><p>Grok 可以根据用户在聊天中输入的描述构建出可正常工作的应用；其制造商于 8 月 19 日向所有 Grok 套餐开放了这一功能。这个聊天构建器与另一款终端编码工具共用 Grok Build 这一名称，后者的<a href=\"https://thehackernews.com/2026/07/grok-build-uploads-entire-git.html\">存储库上传内容</a>曾于 7 月 14 日被报道。</p><p>根据该公司的<a href=\"https://x.ai/news/grok-build-for-everyone\">发布公告</a>，每个发布的应用都会获得 grok.me 的独立子域名，其创建者可以选择谁可以打开。</p><p>在创建者点击“发布”之前，应用不会公开。在研究人员使用的付费账户中，下一步提供了 3 种访问设置：“拥有链接的任何人”“受邀用户”和“仅你本人”。“拥有链接的任何人”已被预先选中。</p><p>研究人员表示，这个设置很重要，因为应用的地址不会一直保密。打开应用时，访问者的计算机会在 DNS 中查询其子域名。被动 DNS 服务会记录此类查询，任何拥有账户的人都可以按模式搜索这些记录。</p><p>Grok 会为每个应用建议 4 个随机词作为名称，研究人员发现的名称中约有一半遵循这一模式。此类名称很难被猜到，但这无法保护名称已经出现在可搜索列表中的应用。</p><p>ChatGPT 的应用构建器也会将每个应用放在其独立子域名下。但研究人员共享应用时，其访问权限一直设为“仅我”，直到他们进行更改。他们表示，在 DNS 数据中找到的 ChatGPT 应用地址，只会指向一个其所有者才能打开的应用。</p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhs8WuVb3JYQy34eSV2jwOerQoLd0Ay60Ujyq4mSERCiowUh9O747pKe9_bgmHOwwa3ju39SsC0u1TBPTQC35xH5PWZjnwsCA-_XkGy77wT4HgK8bzcpS9JPSeuWzfPw7ve5VzfOiHj4X_aHf0-lQkCySguCs9IgqdOSEAQJqkH2aJzDeTxa6q7e3-9eDc/s1600/shost2.png\"><img alt=\"\" src=\"/dailyinfo/media/d669e3fff17c909b.webp\" loading=\"lazy\" decoding=\"async\"></a></p><p>研究人员使用常见的子域名发现方法找到了这些 Grok 应用名称，并在未登录的情况下将每个应用的第一页加载了一次。</p><p>为了了解 Grok 自行添加了哪些保护措施，研究人员使用虚构数据构建了 2 个测试应用，并在已选中“拥有链接的任何人”这一访问设置的情况下发布了这两个应用。</p><p>第一个应用是一份联系人列表，它获得了数据库，但未设置登录。研究人员使用隐私浏览窗口添加了一行数据，未进行登录，随后访问的下一位访客便看到了该内容。</p><p>第二个是一份面向 4 人销售团队的客户列表，其中出现了 Grok 自行添加的登录按钮：“Continue with Google”和“Continue with X”。但 Grok 编写的代码会在检查登录者是否属于该团队之前，先将每位登录者添加到团队中，因此检查始终会通过。</p><p>一个并非所有者、且未获邀请的 Google 账号成功进入，查看了所有客户信息，编辑了一条记录，并删除了另一条记录。</p><p>研究人员仅在自己的应用上进行了这些测试。他们没有测试自己发现的所有开放应用是否会接受此类更改。</p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiDV9oxFVTUXABpaZrmGxN6-eymAQdMX0aYI8L-6Pm72jX74aW2vHuGJpViSM7ffJinGlokuZf5HCVvTN9ip3U_kiYTllQFybc8c7NM-hx6XW2kxSZbBMyQvr0z8swPKRVgFICT4sdPv2qj10XstkCDufNon5P-agRGPVbexznRYNzQwY5iLCIFafYgaks/s1600/shost2data.png\"><img alt=\"\" src=\"/dailyinfo/media/7dfb42e24f2b0bba.webp\" loading=\"lazy\" decoding=\"async\"></a></p><p>研究人员于周 日通过 SpaceXSI 的 security.txt 文件中的地址向其报告了调查结果，其中包括 2 个员工应用。其余 22 个应用则于周一报告。</p><p>研究人员昨天发布成果时，该公司尚未回复他们的报告，但已经回答了一名记者关于这项研究的提问。</p><p>据研究人员描述，该公司表示，在应用创建者共享之前，Grok 应用会保持私有。发布需要经过多个步骤，包括在“Only you”和“Anyone with the link”之间进行选择，以及添加法律免责声明。员工账号默认设置为“Only you”。</p><p>尽管如此，研究人员表示，仍有 24 个由该公司和 X 的员工构建的应用对所有人开放。</p><p>研究人员随报告请求该公司将“Only you”设为默认选项，并添加一项将应用限制为仅限公司自身电子邮件域用户使用的选项。</p><p>据研究人员称，该公司的回复没有说明是否会联系其他开放应用的所有者。他们已经开始自行向受影响的组织发送邮件，并在发布时已向其中 3 家发送了邮件。他们从报告中隐去了所有应用的地址和标题。</p><p>10 月 18 日，同一批研究人员发布了<a href=\"https://blog.claroc.io/ghostshares-muse-passive-dns\">Muse 研究</a>，展示从 Meta 的 Muse AI 智能体共享的页面可以通过被动 DNS 找到。Meta 禁用了共享功能，随后于 10 月 22 日宣布了一项<a href=\"https://x.com/dps/status/2113317986635485559\">共享修复</a>，为共享内容赋予了新的地址。</p><h3 id=\"sec-1\">如何检查你所在组织的 Grok 应用</h3><p>Claroc 销售用于发现和保护 AI 构建应用的工具，该公司建议进行以下检查：</p><ul>\n  <li>了解你的员工在使用哪些 AI 应用构建器。Grok、Lovable、Replit、v0、Bolt、Base44 和 Google AI Studio 等构建器均可在无需 IT 设置或公司账号的情况下使用。</li>\n  <li>如果你能访问被动 DNS 数据，请查询这些构建器的域名，并在隐私浏览器窗口中打开任何结果。</li>\n  <li>确保所有包含内部数据的 Grok 应用均设置为“Invited users”或“Only you”，并确保陌生人访问时看到的是错误页面。</li>\n  <li>尝试使用公司之外的账号登录。如果能够进入，该应用就需要设置允许访问的用户名单。</li>\n  <li>检查每个应用加载的脚本中是否包含姓名、电子邮件地址和密码，并取消发布没有所有者的应用。</li>\n</ul><p>在研究人员的测试中，将应用设置为“Only you”后，无论访问页面还是其数据，陌生用户都会收到 401 错误；取消发布则会在数秒内使应用下线。</p><p>觉得这篇文章有意思？欢迎关注我们的<a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a>和<a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a>，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","大模型","Agent 安全","数据泄露","Google","阿里","https://thehackernews.com/2026/11/over-35000-grok-built-apps-exposed.html","The Hacker News",{"_105":106,"_107":-5},"changelogVersion","2026-10-01T08:00","release"]
