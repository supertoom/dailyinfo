[{"_1":2,"_3":4},"root",{"_5":96},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1795740050000,"id","vzbpyckuf134yxuczry3aivgy","title","香港城市售票网遭黑客入侵，约130万用户资料外泄","originalTitle","香港城市售票网130万用户信息或泄露，有关部门已报警","summary","香港城市售票网遭黑客非法进入，约130万名使用者的姓名或名称、电话号码及电邮地址等个人资料可能外泄。康文署接获外判承办商通报后报警，并向保安局、数字政策办公室及个人资料私隐专员公署通报；系统未登记身份证明文件资料，信用卡资料已被遮蔽。承办商已检视系统并加强保护，个人资料私隐专员公署已展开调查并提醒相关机构尽快通知受影响人士。","reason","source",{"_72":95},"links",{"_88":94},"publishedAt","2026-11-26T09:55:00.000Z","discoveredAt","2026-11-26T11:34:22.544Z","timelineAt","category","activity","tags",[73,91,92,93],"score",68,"selected",false,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","body",{"_60":87,"_88":-5,"_89":88,"_90":55},"outline",[82],"relatedStories",[78],"topics",[67,68,69],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","fgDwmLUX2Hes","reportCount",2,"additionalSourceCount",1,{"_70":76,"_72":77},{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","attack","name","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件",{"_79":80,"_13":81},"publicId","e59cd29d-1d80-44bf-a15a-12be06038278","香港城市售票网疑遭入侵，130万用户资料外泄",{"_11":83,"_84":85,"_86":64},"sec-1","text","康文署已报警并向保安局、数字办及私隐署通报","level","<p><span>香港01</span> <span>2026-11-26 17:55</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/fcfb08389eb090a1.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>关注我们</span></strong></p><p><strong><span>带你读懂网络安全</span></strong></p><p><span><span>香港城市售票网被黑客入侵，涉约130万使用者个人资料，主管机构康文署已报警；</span></span></p><p><span><span>安全内参认为，</span></span><span><span>数字化可以外包，安全责任却不能简单外包。随着政府和企业越来越多地采用市场化、服务化的信息系统，网络安全治理的重点也应从管理信息系统本身，逐渐扩展到管理服务供应商及其整个运营生命周期。这可能是未来几年网络安全产业一个相当重要的结构性变化。</span></span></p><p><span>康文署今日（25日）公布，昨日（24日）接获城市售票网的外判承办商通报，发现城市售票网被黑客非法进入。</span></p><p><span>初步调查显示，事件涉及约130万使用者的个人资料，包括用户名称或姓名、电话号码和电邮地址。系统没有登记使用者的身份证明文件资料，并遮蔽有关信用卡的资料。</span></p><p><span>发现事件后，承办商已即时采取措施防止黑客，并已全面检视系统，确认系统可继续正常运作。</span></p><p><span><span>系统为承办商自资开发　涉130万用户姓名及电话号码等资料</span></span></p><p><span>城市售票网系统由康文署的外判承办商自资开发及拥有，主要为康文署辖下表演场地提供票务服务。初步调查显示，事件涉及约130万使用者的个人资料，包括用户名称或姓名、电话号码和电邮地址。系统没有登记使用者的身份证明文件资料，并遮蔽有关信用卡的资料。</span></p><h2 id=\"sec-1\"><span><span>康文署已报警并向保安局、数字办及私隐署通报</span></span></h2><p><span>康文署表示高度关注事件，已即时要求承办商就事件进行深入调查并提交报告，亦已就事件向警方报案，以及向保安局、数字政策办公室及个人资料私隐专员公署报告。</span></p><p><span>康文署正联同承办商陆续通知受影响人士，并正征询个人资料私隐专员公署及数字政策办公室的意见，与承办商全面检视事件，以及进一步加强城市售票网系统的保护措施，以防止同类事件再次发生。</span></p><p><span>私隐专员公署证实于11月25日接获相关机构的资料外泄事故通报。初步资料显示该事故可能影响约130万名人士的个人资料，当中可能包括姓名、电话号码及电邮地址等。公署已根据既定机制展开调查，并提醒相关机构尽快通知受影响人士。公署暂无接获该事故相关的查询及投诉。</span></p><p><strong><span><span>推荐阅读</span></span></strong></p><ul><li><p><span><a href=\"http://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247499450&amp;idx=2&amp;sn=2da3ca2e0b4d4f9f56ea7f7579afc378&amp;chksm=ebfab99adc8d308c3ba6e7a74bd41beadf39f1b0e38a39f7235db4c305c06caa49ff63a0cc1d&amp;scene=21#wechat_redirect\">网安智库平台长期招聘兼职研究员</a></span></p></li><li><p><span><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247501251&amp;idx=1&amp;sn=8b6ebecbe80c1c72317948494f87b489&amp;chksm=ebfa82e3dc8d0bf595d039e75b446e14ab96bf63cf8ffc5d553b58248dde3424fb18e6947440&amp;token=525430415&amp;lang=zh_CN&amp;scene=21#wechat_redirect\">欢迎加入“安全内参热点讨论群”</a></span></span></p></li></ul><hr><p><span><span>文章来源：</span><span>香港01</span></span></p><p><span><span>点击下方卡片关注我们，</span></span></p><p><span><span>带你一起读懂网络安全 ↓</span></span></p><p><a href=\"https://www.secrss.com/?wx\">阅读原文</a></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=a58639f4&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzI4NDY2MDMwMw%3D%3D%26mid%3D2247516954%26idx%3D2%26sn%3Deaa698072b591301a3b6bad47b943982\">跳转微信打开</a></p>","original","zhKind","complete","数据泄露","数据窃取","安全运营","https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&mid=2247516954&idx=2&sn=eaa698072b591301a3b6bad47b943982","安全内参",{"_97":98,"_99":-5},"changelogVersion","2026-10-01T08:00","release"]
