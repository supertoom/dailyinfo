[{"_1":2,"_3":4},"root",{"_5":87},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1794357642000,"id","rgqxrxjyok0rdmkw6q5rg32hr","title","Python Social Auth OpenID Connect nonce 未绑定浏览器会话，可注入授权码登录受害者账户","originalTitle","Python Social Auth: OpenID Connect nonce is not bound to the browser session, so a stolen authorization code logs the attacker in as the victim","summary","Python Social Auth 的 OpenID Connect 后端未将 nonce 绑定到发起登录的浏览器会话，攻击者获得受害者未使用的授权码后，可在攻击者会话中提交该 code，绕过 nonce 校验并以受害者身份登录。","reason","文章定位了 nonce 校验缺失的具体代码路径，并用双浏览器 PoC 展示授权码注入如何绕过会话绑定，同时验证 PKCE 可阻断该攻击。","source",{"_72":86},"links",{"_60":85},"publishedAt","2026-10-28T21:16:51.000Z","discoveredAt","2026-10-29T00:15:59.832Z","timelineAt","category","vuln","tags",[81,82,83,84,76],"score",76,"selected",true,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[67,68,69],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fU7dyUF_DX6A","reportCount",1,"additionalSourceCount",0,{"_70":75,"_72":76},{"_70":31,"_72":74},{"_70":71,"_72":73},"slug","research","name","技术研究","漏洞披露","identity","身份与访问",{"_78":79,"_13":80},"publicId","7a180312-7868-48b4-92b7-056c44fec639","Python Social Auth OIDC nonce会话绑定漏洞披露","漏洞","复现","漏洞利用","漏洞分析","https://github.com/advisories/GHSA-h2r5-x5m7-3935","GitHub 安全公告",{"_88":89,"_90":-5},"changelogVersion","2026-10-01T08:00","release"]
