[{"_1":2,"_3":4},"root",{"_5":137},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794444095000,"id","k1s00o45axh6n2j0laqjuuly7","title","Microsoft 披露攻击者利用 GSocket 在 Linux 服务器维持隐蔽 C2","originalTitle","The global socket: how threat actors are weaponizing GSocket for stealthy C2","summary","Microsoft 观察到多个攻击活动将开源远程访问工具 GSocket 部署到遭入侵的 Linux 服务器，在初始 RCE 漏洞修复后仍通过 Global Socket Relay Network 维持访问。","reason","文章结合遥测数据还原 GSocket 的部署、持久化与提权链路，并给出适合 Linux 主机排查和加固的处置方向。","source",{"_74":136},"links",{"_127":135},"publishedAt","2026-11-11T19:49:57.000Z","discoveredAt","2026-11-11T21:18:13.917Z","timelineAt","category","activity","tags",[79,77,131,132,133,134],"score",80,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Yash Gund, Sumith Maniath and Microsoft Security Research","body",{"_61":126,"_127":-5,"_128":129,"_130":37},"outline",[86,87,88,89,90,91,92,93,94,95,96,97],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","f-rJiIbtVOPk","reportCount",1,"additionalSourceCount",0,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","blue-team","name","蓝队与运营","malware","恶意软件","attack","攻击活动","microsoft","Microsoft / 微软",{"_83":84,"_13":85},"publicId","91719b6b-8fae-4bad-9c2f-60f193af7d45","攻击者借GSocket维持Linux服务器访问",{"_11":124,"_99":125,"_101":102},{"_11":122,"_99":123,"_101":102},{"_11":120,"_99":121,"_101":102},{"_11":118,"_99":119,"_101":102},{"_11":116,"_99":117,"_101":102},{"_11":114,"_99":115,"_101":107},{"_11":112,"_99":113,"_101":107},{"_11":110,"_99":111,"_101":107},{"_11":108,"_99":109,"_101":107},{"_11":105,"_99":106,"_101":107},{"_11":103,"_99":104,"_101":102},{"_11":98,"_99":100,"_101":102},"sec-12","text","了解更多","level",2,"sec-11","参考文献","sec-10","失陷指标",3,"sec-9","观察到的 MITRE ATT&amp;CK 技术","sec-8","高级搜寻查询","sec-7","Microsoft Security Copilot","sec-6","Microsoft Defender 检测结果","sec-5","缓解与防护指南","sec-4","GSocket 如何在没有固定 C2 地址的情况下重新连接","sec-3","威胁行为者如何部署和运行 GSocket","sec-2","观察到的攻击链","sec-1","当一个 RCE 不再只是一个 RCE","<ol><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/11/global-socket-how-threat-actors-weaponizing-gsocket-stealthy-c2/#when-one-rce-stops-being-just-one-rce\">当一个 RCE 不再只是一个 RCE</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/11/global-socket-how-threat-actors-weaponizing-gsocket-stealthy-c2/#observed-attack-chains\">观察到的攻击链</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/11/global-socket-how-threat-actors-weaponizing-gsocket-stealthy-c2/#how-threat-actors-deploy-and-operate-gsocket\">威胁行为者如何部署和操作 GSocket</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/11/global-socket-how-threat-actors-weaponizing-gsocket-stealthy-c2/#how-gsocket-reconnects-without-a-fixed-c2-address\">GSocket 如何在没有固定 C2 地址的情况下重新连接</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/11/global-socket-how-threat-actors-weaponizing-gsocket-stealthy-c2/#mitigation-and-protection-guidance\">缓解和保护指南</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/11/global-socket-how-threat-actors-weaponizing-gsocket-stealthy-c2/#references\">参考资料</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/11/global-socket-how-threat-actors-weaponizing-gsocket-stealthy-c2/#learn-more\">了解更多</a></li></ol><p>Microsoft 观察到多起事件，威胁行为者在已遭入侵的 Linux 服务器上部署了 GSocket，这是一款开源远程访问工具。威胁行为者使用 GSocket 来维持访问权限，即使最初用于入侵的漏洞已经修复也不例外。这使一次 Web 应用程序入侵变成了持续访问，其存续时间超过了原始漏洞的修复周期。调查受影响主机的防御人员应查找 GSocket 部署、持久化、权限提升和出站连接的证据，而不应仅将应用程序补丁视为完整的修复措施。</p><p>Microsoft Defender for Endpoint 遥测数据显示，此类活动近几个月来有所增加，并集中出现在 Web 应用程序和托管环境中。GSocket 通过共享公共网络中继流量，因此没有可供封禁的威胁行为者自有 IP 地址或域名。</p><h2 id=\"sec-1\">当一个 RCE 不再只是一个 RCE</h2><p>利用 Web 应用程序漏洞可使威胁行为者在 Web 服务器进程的上下文中执行命令。这种访问权限仅在漏洞尚未修补且服务持续运行时有效。修补应用程序或重启服务即可消除这种访问权限。</p><p>为了保持访问权限，威胁行为者通常会添加持久化机制，而每种常见方案都有缺点。添加到 authorized_keys 中的 SSH 密钥很容易被管理员在审计期间发现。反向 shell 依赖由威胁行为者控制的服务器，防御人员可以封禁这些服务器或将其导向黑洞。自定义植入程序则需要持续开发和维护。当初始访问是通过远程访问服务或云 shell 会话获得时，同样的权衡依然适用。</p><p>GSocket 解决了这些缺点，这有助于解释为何多个互不相关的威胁行为者都采用了它。</p><ul>\n<li><strong>共享中继基础设施。</strong>流量通过 Global Socket Relay Network 这一公共中继服务传递。威胁行为者无需注册或托管任何基础设施，因此没有可供封禁的威胁行为者自有 IP 地址或域名。组织仍可限制对中继本身的访问。</li>\n\n\n\n<li><strong>仅出站连接。</strong>受损主机和操作人员都会主动出站连接到中继，由其桥接两个会话。主机无需入站监听器或公共 IP 地址，网络地址转换也不会阻止该连接。入站防火墙规则看不到此类流量，但出口过滤和出站监控可以检测到。</li>\n\n\n\n<li><strong>内置规避和持久化能力。</strong>部署脚本可以重命名进程、将文件暂存到内存支持的目录中，并安装可在重启后存续的持久化机制，而威胁行为者无需额外开发。</li>\n</ul><p>这种支持合法远程管理的中继模型，也为威胁行为者提供了一条无需运营专用 C2 基础设施即可维持访问权限的途径。一旦 GSocket 在遭入侵的服务器上运行，服务器和操作人员就会各自出站连接到 Global Socket Relay Network，并通过端到端加密通道配对两个会话。</p><figure><img src=\"/dailyinfo/media/40616e1e514bf276.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption><em><strong>图 1： </strong>在面向互联网的应用上执行代码后，会部署 GSocket，并由两端向外连接至中继。</em></figcaption></figure><p>由于 GSocket 独立于被利用的应用运行，因此修补漏洞并不会移除中继客户端及其持久化机制。</p><p>Microsoft Defender for Endpoint 遥测数据显示，此活动并非仅限于单次入侵。从 2026 年 3 月至 8 月，出现 GSocket 相关检测的设备增加了 356.2%，但逐月增长并不稳定。</p><figure><img src=\"/dailyinfo/media/16f6a2aeaab36bf9.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption><strong><em>图 2：</em></strong><em> 从 3 月至 8 月 GSocket 相关检测的增长情况，以 3 月为基准进行衡量。</em></figcaption></figure><p>在所分析的遥测数据中，Web 应用和托管服务占可归因于 Microsoft Defender for Endpoint 事件的 87.1%。在该组中，PHP Web 应用和 cPanel 托管服务占事件的 63.9%，Apache 占 24.3%（图 3）。</p><figure><img src=\"/dailyinfo/media/de3e2696af9d6237.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption><strong><em>图 3：</em></strong><em> 按应用类别划分的 GSocket 相关事件分布。在 Web 应用和托管服务组内，PHP Web 应用和 Apache 占大多数事件。</em></figcaption></figure><p>教育和研究机构占受影响组织的最大比例（30.7%），其次是技术和电信行业（22.9%）。</p><figure><img src=\"/dailyinfo/media/4ec267485a18b717.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption><strong><em>图 4：</em></strong><em> 按行业划分的受影响组织分布。</em></figcaption></figure><p>这些数字反映了受影响组织所占的比例，并不表明威胁行为者是有意选择了这些行业。暴露面更可能是促成因素：学术机构通常运行着由中央 IT 团队之外的人员维护的大型、分散式 Web 环境，因此更难对其进行盘点和修补。</p><h2 id=\"sec-2\">观察到的攻击链</h2><p>本次分析中的基于 RCE 的入侵在初始访问后均遵循相似流程。威胁行为者入侵面向互联网的应用，对主机进行画像，传输并隐藏中继工具，然后利用由此建立的通道进行命令与控制。部分入侵还涉及持久化和权限提升。图 5 将这些行为整合为一条通用攻击链。并非每次入侵都发生了所有阶段。</p><figure><img src=\"/dailyinfo/media/9b05400edba6e9dc.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption><em><strong>图 5： </strong>在基于 RCE 的入侵中观察到的通用 GSocket 攻击链，并映射至 MITRE ATT&amp;CK。</em></figcaption></figure><h2 id=\"sec-3\">威胁行为者如何部署和运行 GSocket</h2><p><strong>初始访问和部署： </strong>威胁行为者利用面向互联网的 Web 应用，并使用 curl 下载和执行远程脚本。该脚本对主机进行画像，选择与系统架构匹配的 GSocket 客户端，将其暂存到可写路径或内存支持路径（如 /dev/shm），并通过 Global Socket Relay Network 建立加密的出站命令与控制通道。</p><figure><img src=\"/dailyinfo/media/48dfa4e8579e188b.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption><em><strong>图 6： </strong>通过存在漏洞的 PHP 应用执行的编码 RCE 命令。</em></figcaption></figure><p><strong>防御规避和持久化：</strong>威胁行为者将 GSocket 伪装成内核线程样式的进程名，通过 cron、systemd、shell 配置文件、看门狗和冗余副本实现持久化，随后删除暂存文件及其他部署痕迹。</p><figure><img src=\"/dailyinfo/media/44a808e7cc126bfd.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption><em><strong>图 7： </strong>用于伪装 GSocket 进程的内核线程名称。</em></figcaption></figure><figure><img src=\"/dailyinfo/media/28054620e641003c.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption><strong><em>图 8：</em></strong><em> GSocket 部署期间创建的持久化项。</em></figcaption></figure><p><strong>权限提升：</strong>在以 web-service 账户获得执行权限后，在少数观察到的安全事件中，威胁行为者试图利用 CVE-2026-43284——近期出现的 Linux 内核漏洞之一，也称为 Dirty Frag——将权限提升至 root。</p><h2 id=\"sec-4\">GSocket 如何在没有固定 C2 地址的情况下重新连接</h2><p>GSocket 使用共享密钥而非 IP 地址或主机名来标识端点。在安装期间，部署脚本通常会生成一个随机密钥并将其写入标准输出。威胁行为者可以选择从控制台读取该密钥，将其重定向到临时文件并在文件被删除前取回，或者通过受支持的通知通道传送该密钥，例如 Telegram（使用 GS_TG_TOKEN 和 GS_TG_CHATID 配置）、Discord 或 webhook。掌握该密钥后，操作人员之后可以从任何兼容的 GSocket 客户端重新连接，而无需知道受害者的 IP 地址、主机名或网络位置。</p><p>传统反向 shell 会连接到载荷中写入的、由威胁行为者控制的 IP 地址。GSocket 则从共享密钥派生其连接标识符和认证材料。受害主机和操作人员各自主动连接到 Global Socket Relay Network（GSRN），后者将二者匹配并为端到端加密会话进行协调。两个端点都不需要公共 IP 地址、入站监听器或宽松的入站防火墙规则。</p><p>因此，仅屏蔽 IP 地址或域名不太可能切断访问。该连接依赖共享的中继服务、通常会被允许的出站流量，以及无需硬编码到载荷中的密钥。任何掌握共享密钥的人都可以通过中继重新连接，而无需知道受害主机的 IP 地址或主机名。</p><h2 id=\"sec-5\">缓解与防护指南<strong></strong></h2><p>对于受影响的 Linux 服务器，修复工作应同时处理初始入侵和 GSocket 部署问题。</p><ol>\n<li><strong>Patch and harden internet-facing applications.</strong> Keep web applications, CMS platforms, plugins, and application servers current. Remove unused components and restrict file-upload and administrative paths.\n<ul>\n<li><strong>同时修复主机和漏洞。</strong> 不要将应用程序补丁视为完整的修复措施。调查并移除 GSocket 客户端、相关持久化机制和暂存文件，然后验证对中继基础设施的出站连接已停止</li>\n</ul>\n</li>\n\n\n\n<li><strong>修补并加固面向互联网的应用程序。</strong> 保持 Web 应用程序、CMS 平台、插件和应用服务器为最新版本。移除未使用的组件，并限制文件上传路径和管理路径。</li>\n\n\n\n<li><strong>限制出站流量。</strong> 应用默认拒绝的出口规则，仅允许访问必需的目标，并监控与中继基础设施之间的连接。</li>\n\n\n\n<li><strong>加固主机运行时。</strong> 在可行的情况下，将临时目录和基于内存的目录挂载为不可执行，并对从隐藏路径或全局可写路径执行操作的行为发出警报。</li>\n\n\n\n<li><strong>审计持久化入口。</strong> 检查 cron 条目、使用看似合理服务名称的 systemd 单元以及 shell 启动文件。持久化通常会分布在多个机制上，因此仅停止正在运行的进程并不能消除访问权限。</li>\n\n\n\n<li><strong>优先对面向互联网的服务器进行本地权限提升漏洞修补。</strong> 在分析到的活动中，威胁参与者尝试利用 CVE-2026-43284，从 Web 服务账户提升至 root。与此同时，Microsoft FORGE Lab 最近<a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/10/lessons-from-59-linux-kernel-bug-reports/\">记录了 59 个 Linux 内核漏洞报告</a>，其中包括八个漏洞；研究人员已在受控环境中展示针对这些漏洞的本地 root 权限提升利用程序。</li>\n\n\n\n<li><strong>在 Linux 上启用 Microsoft Defender for Endpoint。</strong> 保持实时保护与云提供的保护处于启用状态，并启用行为监控，以检测 Web 服务的异常子进程以及伪装成其他身份的过程。</li>\n</ol><h3 id=\"sec-6\">Microsoft Defender 检测结果<strong></strong></h3><p>Microsoft Defender for Endpoint 可提供与 GSocket 相关 Linux 入侵活动的可见性，包括可疑 shell 执行、有效载荷投递、持久化、防御规避和远程通信。以下警报是在所分析的遥测数据中观察到的。单条警报不能确定初始访问方式，也不能确认入侵的每个阶段均已成功。</p><figure><table><tbody><tr><td><strong>战术</strong></td><td><strong>观察到的活动</strong></td><td><strong>在所分析遥测数据中观察到的警报示例</strong><strong></strong></td></tr><tr><td>初始访问、执行</td><td>从 Web 服务器和应用程序运行时启动 shell 和命令</td><td>– 可能存在 Web 服务器失陷活动<br>– 从 PHP 应用程序发起可疑 shell 执行<br>– 从 Web 服务器应用程序发起可疑 shell 执行<br>– 从脚本应用程序运行时发起可疑 shell 执行<br>– 通过 Java Web 应用程序进行可疑远程命令执行<br>– 通过 Node Web 应用程序进行可疑远程命令执行</td></tr><tr><td>执行</td><td>在主机上启动 GSocket 和 gs-netcat 工具</td><td>– ‘GsNetcat’ 攻击工具已被阻止<br>– ‘GsNetcat’ 攻击工具已被阻止且曾处于活动状态<br>– 活动的 ‘GsNetcat’ 攻击工具已被阻止<br>– 检测到活动的 ‘GsNetcat’ 攻击工具进程并已终止</td></tr><tr><td>执行、有效载荷投递</td><td>用于获取、准备和启动有效载荷的 shell 命令与脚本</td><td>– 可疑 shell 命令执行<br>– 启动可疑管道命令<br>– 启动可疑脚本<br>– 为文件或目录添加可执行权限<br>– 投放并启动可疑文件<br>– 可疑文件或内容传入</td></tr><tr><td>持久化</td><td>创建 Cron 作业和 Linux 服务，以实现重复执行并持续访问</td><td>– 创建可疑 Cron 作业<br>– 创建可疑 Linux 服务</td></tr><tr><td>防御规避</td><td>隐藏文件执行、混淆、时间戳篡改，以及删除二进制文件或历史记录痕迹。</td><td>– 执行隐藏文件<br>– 检测到可疑文件或信息混淆<br>– 可疑删除已启动进程的二进制文件<br>– 尝试清除命令历史记录 <br>– 可疑时间戳修改</td></tr><tr><td>发现</td><td>收集本地系统信息并开展侦察</td><td>– 侦察活动<br>– 可疑进程从本地系统收集数据</td></tr><tr><td>命令与控制</td><td>反向 shell 行为以及与 GSocket 域名的通信</td><td>– 可能存在反向 shell<br>– 与远程目标进行可疑通信</td></tr></tbody></table></figure><h3 id=\"sec-7\">Microsoft Security Copilot</h3><p>Security Copilot 客户可以使用独立体验<a href=\"https://learn.microsoft.com/copilot/security/prompting-security-copilot#create-your-own-prompts\">创建自己的提示</a>，或运行<a href=\"https://learn.microsoft.com/copilot/security/using-promptbooks\">预构建提示集</a>，自动执行与该威胁相关的响应事件或调查任务：</p><ul>\n<li>事件调查：将 Web 服务进程父子关系、中继客户端部署、持久性变更和出站活动关联为受影响主机上的单一时间线。</li>\n\n\n\n<li>威胁行为者画像：总结环境中观察到的 GSocket 攻击技术及相关工具。</li>\n\n\n\n<li>设备摘要：评估受影响的 Linux 主机、其暴露的应用，以及初次执行后的后续活动。</li>\n</ul><h3 id=\"sec-8\">高级搜寻查询<strong></strong></h3><p>Microsoft Defender XDR 客户可以使用以下查询来发现与 GSocket 相关的活动。这些查询使用由 Microsoft Defender for Endpoint 填充的公共高级搜寻表，涵盖在所分析入侵事件中观察到的部署模式。</p><p>应结合进程父子关系、执行上下文、持久性变更和相关网络活动，对匹配结果进行上下文调查。</p><p><strong>GSocket 进程活动</strong></p><p>按名称或命令行查找 GSocket 工具。</p><pre>DeviceProcessEvents\n| where Timestamp &gt; ago(7d)\n| where FileName has_any (\"gs-netcat\", \"gsocket\")\n    or ProcessCommandLine has_any (\"gsocket.io\", \"gs-netcat\", \"gsnetcat\")\n| project Timestamp, DeviceName, AccountName, FileName, FolderPath,\n    ProcessCommandLine, InitiatingProcessFileName\n| order by Timestamp desc\n</pre><p><strong>安装程序下载活动</strong></p><p>查找用于获取 GSocket 的下载并执行模式。</p><pre>DeviceProcessEvents\n| where Timestamp &gt; ago(7d)\n| where ProcessCommandLine has \"gsocket.io\"\n    or ProcessCommandLine has \"gsgg.b-cdn.net\"\n| project Timestamp, DeviceName, AccountName, FileName,\n    ProcessCommandLine, InitiatingProcessFileName\n| order by Timestamp desc\n</pre><p><strong>与已观察分发主机的连接</strong></p><p>这些是工具分发端点，而非威胁行为者拥有的命令与控制服务器。</p><pre>DeviceNetworkEvents\n| where Timestamp &gt; ago(7d)\n| where RemoteUrl has_any (\"gsocket.io\", \"gsgg.b-cdn.net\")\n| project Timestamp, DeviceName, ActionType, RemoteUrl, RemoteIP, RemotePort,\n    InitiatingProcessFileName, InitiatingProcessAccountName\n| order by Timestamp desc\n</pre><p><strong>已知文件哈希</strong></p><p>匹配入侵指标部分公布的 SHA-256 哈希。</p><pre>let badSHA256 = dynamic([\n    \"d94f75a70b5cabaf786ac57177ed841732e62bdcc9a29e06e5b41d9be567bcfa\",\n    \"f95c4d029e6784e3849b4d1e2e2ae1a661187236ef7c5d487c71158a290a03b5\",\n    \"55d141bb2f62c527c3fea3413b8429fed7d52633d0b123b5e611bfa42165229f\",\n    \"12450bafc7a4398040e1ad3a16dbf4dbc79b6a8f83ef306c4f0f73f59886f06c\"\n]);\nDeviceFileEvents\n| where Timestamp &gt; ago(7d)\n| where SHA256 in~ (badSHA256)\n| project Timestamp, DeviceName, ActionType, FileName, FolderPath, SHA256,\n    InitiatingProcessFileName, InitiatingProcessCommandLine\n| order by Timestamp desc\n</pre><p><strong>暂存和持久性痕迹</strong></p><p>在缺少哈希或使用不同构建版本时很有用。</p><pre>DeviceFileEvents\n| where Timestamp &gt; ago(7d)\n| where FolderPath startswith \"/dev/shm/.gs-\"\n    or FileName in~ (\"systemd-remount-d\", \".gsn_ora\", \"defunct\", \"defunct.service\")\n| project Timestamp, DeviceName, ActionType, FileName, FolderPath, SHA256,\n    InitiatingProcessFileName, InitiatingProcessCommandLine\n| order by Timestamp desc\n</pre><h3 id=\"sec-9\">观察到的 MITRE ATT&amp;CK 技术</h3><p>在所分析的入侵事件中观察到了以下技术。并非每次入侵都发生了所有技术，而且某些结果（例如重启后的持久性和成功建立中继会话）并非在每种情况下都得到确认。</p><p><strong>初始访问</strong></p><ul>\n<li><a href=\"https://attack.mitre.org/techniques/T1190/\">T1190 利用面向公众的应用</a> | 面向互联网的 Web 应用遭到利用，使攻击者能够在 Web 服务上下文中执行命令。后续命令作为 Web 服务器和应用运行时进程的子进程启动，这与利用暴露应用的行为一致。</li>\n</ul><p><strong>执行</strong></p><ul>\n<li><a href=\"https://attack.mitre.org/techniques/T1059/004/\">T1059.004 命令和脚本解释器：Unix Shell</a> | 命令使用 curl 获取 GSocket 安装脚本，并通过 bash 执行。<br>后续的 bash 调用启动了重命名后的有效载荷。</li>\n</ul><p><strong>执行、持久性</strong></p><ul>\n<li><a href=\"https://attack.mitre.org/techniques/T1053/003/\">T1053.003 计划任务/作业：Cron</a> | 在检测到 GSocket 部署脚本活动的同一检测时间窗口内创建了 Cron 条目，与持久性机制一致。</li>\n</ul><p><strong>持久性</strong></p><ul>\n<li><a href=\"https://attack.mitre.org/techniques/T1543/002/\">T1543.002 创建或修改系统进程：Systemd 服务</a> | 活动启动了一个 bash 命令，调用重命名后的 /usr/bin/defunct 有效载荷，并引用了 defunct.service 和 multi-user.target.wants 链接。</li>\n</ul><p><strong>防御规避</strong></p><ul>\n<li><a href=\"https://attack.mitre.org/techniques/T1036/\">T1036 伪装</a> | 一个名为 GsNetcat 的二进制文件以 systemd-remount-d 运行，该名称类似系统服务。在另一个执行上下文中，bash 使用 exec -a 将 /usr/bin/defunct 呈现为参数零名称 [kaluad]。</li>\n\n\n\n<li><a href=\"https://attack.mitre.org/techniques/T1564/001/\">T1564.001 隐藏痕迹：隐藏的文件和目录</a> | gs-netcat 有效载荷被暂存在以点号开头的 /dev/shm/.gs-0 目录下。还在 /tmp/.gsn_ora 观察到一个由 GsNetcat 检测到的文件。</li>\n\n\n\n<li><a href=\"https://attack.mitre.org/techniques/T1222/002/\">T1222.002 文件和目录权限修改：Linux 和 Mac 文件和目录权限修改</a> | chmod 更改了重命名后有效载荷的权限，包括 chmod 700 /usr/bin/defunct。</li>\n\n\n\n<li><a href=\"https://attack.mitre.org/techniques/T1070/006/\">T1070.006 指标清除：时间戳篡改</a> | touch 命令为 /usr/bin/defunct 和 defunct.service 应用了较旧的时间戳。时间戳复制操作针对系统服务样式的载荷名称。</li>\n\n\n\n<li><a href=\"https://attack.mitre.org/techniques/T1070/004/\">T1070.004 指标清除：文件删除</a> | rm 删除了暂存的 /dev/shm/.gs-0/gs-netcat 文件，另一条 rmdir 命令删除了暂存目录。</li>\n</ul><p><strong>命令与控制</strong></p><ul>\n<li><a href=\"https://attack.mitre.org/techniques/T1105/\">T1105 传入工具传输</a> | curl 从 GSocket 分发端点将 gs-netcat 载荷下载至 /dev/shm/.gs-0。</li>\n\n\n\n<li><a href=\"https://attack.mitre.org/techniques/T1090/002/\">T1090.002 代理：外部代理</a> | GSocket 客户端启动时使用了可建立到 Global Socket Relay Network 出站会话的选项。该网络是一个共享的公共中继，在受感染主机与操作人员之间代理连接。该中继属于第三方基础设施，并非威胁行为者所有。</li>\n</ul><h3 id=\"sec-10\">失陷指标<strong></strong></h3><p>以下指标是在已分析遥测数据中观察到的。它们代表此次入侵中的具体观测结果，而非 GSocket 工具或基础设施的完整清单。</p><figure><table><tbody><tr><td><strong>指标</strong></td><td><strong>类型</strong></td><td><strong>描述</strong></td></tr><tr><td>gsocket[.]io</td><td>域名</td><td>脚本和安装程序获取</td></tr><tr><td>cdn[.]gsocket[.]io</td><td>域名</td><td>客户端二进制文件分发</td></tr><tr><td>gsgg[.]b-cdn[.]net</td><td>域名</td><td>客户端二进制文件分发</td></tr><tr><td>hxxps://gsocket[.]io/y</td><td>URL</td><td>下载并执行命令中的脚本获取</td></tr><tr><td>hxxps://gsocket[.]io/install.sh</td><td>URL</td><td>安装程序获取目标；尚未确认成功获取</td></tr><tr><td>hxxps://gsgg[.]b-cdn[.]net/bin/gs-netcat_mini-linux-x86_64</td><td>URL</td><td>与下方 x86-64 文件关联的下载源</td></tr><tr><td>hxxps://cdn[.]gsocket[.]io/bin/gs-netcat_mini-linux-aarch64</td><td>URL</td><td>与下方 AArch64 文件关联的下载源</td></tr><tr><td>/dev/shm/.gs-0/gs-netcat_mini-linux-x86_64</td><td>文件路径</td><td>识别为 HackTool:Linux/GsNetcat.A!MTB；隐藏暂存目录</td></tr><tr><td>d94f75a70b5cabaf786ac57177ed841732e62bdcc9a29e06e5b41d9be567bcfa</td><td>SHA256</td><td>/dev/shm/.gs-0/gs-netcat_mini-linux-x86_64 的 SHA-256；识别为 HackTool:Linux/GsNetcat.A!MTB；隐藏暂存目录</td></tr><tr><td>/dev/shm/.gs-0/gs-netcat_mini-linux-aarch64</td><td>文件路径</td><td>识别为 HackTool:Linux/GsNetcat.A!MTB；AArch64 载荷</td></tr><tr><td>f95c4d029e6784e3849b4d1e2e2ae1a661187236ef7c5d487c71158a290a03b5</td><td>SHA256</td><td>/dev/shm/.gs-0/gs-netcat_mini-linux-aarch64 的 SHA-256；识别为 HackTool:Linux/GsNetcat.A!MTB；AArch64 载荷</td></tr><tr><td>/tmp/systemd-remount-d</td><td>文件路径</td><td>在两个路径中均识别为 HackTool:Linux/GsNetcat!rfn；服务样式文件名</td></tr><tr><td>/usr/bin/systemd-remount-d</td><td>文件路径</td><td>在两个路径中均识别为 HackTool:Linux/GsNetcat!rfn；服务样式文件名</td></tr><tr><td>55d141bb2f62c527c3fea3413b8429fed7d52633d0b123b5e611bfa42165229f</td><td>SHA256</td><td>/tmp/systemd-remount-d、/usr/bin/systemd-remount-d 的 SHA-256；在两个路径中均识别为 HackTool:Linux/GsNetcat!rfn；服务样式文件名</td></tr><tr><td>/tmp/.gsn_ora</td><td>文件路径</td><td>识别为 HackTool:Linux/GsNetcat.A!MTB 的隐藏文件</td></tr><tr><td>12450bafc7a4398040e1ad3a16dbf4dbc79b6a8f83ef306c4f0f73f59886f06c</td><td>SHA256</td><td>/tmp/.gsn_ora 的 SHA-256；识别为 HackTool:Linux/GsNetcat.A!MTB 的隐藏文件</td></tr></tbody></table></figure><h2 id=\"sec-11\">参考文献</h2><ol>\n<li><strong>The Hacker’s Choice. “GSocket.” GitHub. </strong><a href=\"https://github.com/hackerschoice/gsocket\"><strong>https://github.com/hackerschoice/gsocket</strong></a></li>\n\n\n\n<li><strong>Microsoft Defender Security Blog：由 Cookie 控制的 PHP Webshell：Linux 托管环境中的隐蔽技术</strong><br><a href=\"https://www.microsoft.com/en-us/security/blog/2026/04/02/cookie-controlled-php-webshells-tradecraft-linux-hosting-environments/\">https://www.microsoft.com/en-us/security/blog/2026/04/02/cookie-controlled-php-webshells-tradecraft-linux-hosting-environments/</a></li>\n\n\n\n<li><strong>Elastic Security Labs：押注机器人</strong><br><a href=\"https://www.elastic.co/security-labs/threat-command/betting-on-bots\">https://www.elastic.co/security-labs/threat-command/betting-on-bots</a></li>\n\n\n\n<li><strong>SANS Internet Storm Center：通过 Bash 脚本投递的 GSocket 后门</strong><br><a href=\"https://isc.sans.edu/diary/32816\">https://isc.sans.edu/diary/32816</a></li>\n\n\n\n<li><strong>Sansec：您的网站上发现了 defunct.dat？您遇到了麻烦</strong> <a href=\"https://sansec.io/research/gsocket\">https://sansec.io/research/gsocket</a></li>\n</ol><h2 id=\"sec-12\">了解更多</h2><p>如需获取 Microsoft Threat Intelligence 社区的最新安全研究，请查看<a href=\"https://aka.ms/threatintelblog\">Microsoft Threat Intelligence 博客</a>。</p><p>如需获知新发布的内容并参与社交媒体讨论，请在<a href=\"https://www.linkedin.com/showcase/microsoft-threat-intelligence\">LinkedIn</a>、<a href=\"https://x.com/MsftSecIntel\">X（原 Twitter）</a>和<a href=\"https://bsky.app/profile/threatintel.microsoft.com\">Bluesky</a>上关注我们。</p><p>如需聆听 Microsoft Threat Intelligence 社区分享的关于不断演变的威胁态势的故事和见解，请收听<a href=\"https://thecyberwire.com/podcasts/microsoft-threat-intelligence\">Microsoft Threat Intelligence 播客</a>。</p><p>查看我们的文档，进一步了解我们的实时保护功能，以及如何在您的组织中启用这些功能。  </p><ul>\n<li>进一步了解如何使用 <a href=\"https://learn.microsoft.com/en-us/defender-cloud-apps/ai-agent-protection\">Microsoft Defender 保护 Copilot Studio 智能体</a> </li>\n\n\n\n<li>通过我们最新的<a href=\"https://microsoft.github.io/zerotrustassessment/\">AI 零信任工作坊</a>评估您的 AI 准备度。</li>\n\n\n\n<li><a href=\"https://learn.microsoft.com/en-us/copilot/microsoft-365/microsoft-365-copilot-ai-security\">Microsoft 365 Copilot AI 安全文档</a></li>\n\n\n\n<li><a href=\"https://www.microsoft.com/en-us/security/blog/2024/04/11/how-microsoft-discovers-and-mitigates-evolving-attacks-against-ai-guardrails/\">Microsoft 如何发现并缓解针对 AI 护栏的不断演变的攻击</a></li>\n\n\n\n<li><a href=\"https://learn.microsoft.com/en-us/defender-office-365/step-by-step-guides/prompt-injection-protection-defender-for-office-365\">Microsoft Defender for Office 365 中的提示注入防护 </a>——Microsoft Defender for Office 365 中提示注入防护的官方文档。</li>\n\n\n\n<li><a href=\"https://www.microsoft.com/en-us/security/blog/2024/04/11/how-microsoft-discovers-and-mitigates-evolving-attacks-against-ai-guardrails/\">Microsoft 如何发现并缓解针对 AI 护栏的不断演变的攻击 | Microsoft Security 博客</a></li>\n\n\n\n<li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/02/10/ai-recommendation-poisoning/\">操纵 AI 记忆以牟利：AI 推荐投毒的兴起 | Microsoft Security 博客</a>——一个在电子邮件流量中观察到的 AI 时代技术相关示例</li>\n\n\n\n<li><a href=\"https://techcommunity.microsoft.com/blog/microsoftdefenderforoffice365blog/defending-the-inbox-against-prompt-injection-attacks/4534636\">使用 Microsoft Defender for Office 365 博客保护收件箱免遭提示注入攻击 </a>——介绍 Microsoft Defender for Office 365 中提示注入防护的功能公告。</li>\n\n\n\n<li>了解 Microsoft 如何通过<a href=\"https://www.microsoft.com/security/blog/2026/09/23/reimagining-the-soc-for-the-agentic-era-in-microsoft-defender/\">Microsoft Defender 中的 ISOC</a>重新构想智能体时代的 SOC</li>\n</ul><p>文章<a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/11/global-socket-how-threat-actors-weaponizing-gsocket-stealthy-c2/\">The global socket: how threat actors are weaponizing GSocket for stealthy C2</a>首发于<a href=\"https://www.microsoft.com/en-us/security/blog\">Microsoft Security 博客</a>。</p>","original","zhKind","translation","complete","后门","网络设备","检测工程","Microsoft","https://www.microsoft.com/en-us/security/blog/2026/11/11/global-socket-how-threat-actors-weaponizing-gsocket-stealthy-c2/","Microsoft Security Blog",{"_138":139,"_140":-5},"changelogVersion","2026-10-01T08:00","release"]
