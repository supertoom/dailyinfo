[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795653646000,"id","qptpos2ooh3pyaz9fw8wotobw","title","TastyIgniter 媒体管理器允许通过 .htaccess 上传触发 RCE","originalTitle","TastyIgniter allows Remote Code Execution (RCE) via Unrestricted file upload in Media Manager","summary","TastyIgniter 的媒体管理器允许上传 .htaccess 文件，并可通过 SetHandler application/x-httpd-php 令任意扩展名执行 PHP，进而在服务器运行命令。利用需要管理员权限，原文提供了上传 .htaccess 和伪装为 .jpg 的 PHP 文件两步 PoC，但未说明受影响版本、补丁状态或是否已被利用。","reason","source",{"_70":83},"links",{"_59":82},"publishedAt","2026-11-25T22:24:36.000Z","discoveredAt","2026-11-25T22:43:19.892Z","timelineAt","category","disclosure","tags",[78,79,80,81],"score",49,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fTQ7wkJVE1_Y","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","research","name","技术研究","vuln","漏洞披露",{"_75":76,"_13":77},"publicId","e1bc8c14-9816-4f4d-9cee-a6e0491c13b6","TastyIgniter媒体管理器RCE被披露","漏洞分析","复现","漏洞利用","利用链","https://github.com/advisories/GHSA-7wwv-x6mc-pxqx","GitHub 安全公告",{"_85":86,"_87":-5},"changelogVersion","2026-10-01T08:00","release"]
