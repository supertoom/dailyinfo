[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":54,"_55":36,"_56":36,"_57":58,"_59":60,"_61":62},"expiresAt",1795912847000,"id","rfirwc4gz7xd4ktjxcnwoqtre","title","Cacti Core 1.2.31 未授权远程代码执行漏洞 QVD-2026-117631 已公开 PoC","originalTitle","Cacti未授权远程代码执行漏洞安全风险通告","summary","Cacti Core 1.2.31 存在未授权远程代码执行漏洞 QVD-2026-117631，攻击者在启用 Guest 账户且可访问 Web 接口时，无需认证即可通过少量 HTTP 请求执行任意命令。","reason","source",{"_75":96},"links",{"_87":95},"publishedAt","2026-11-27T10:05:30.736Z","discoveredAt","2026-11-27T11:05:30.770Z","timelineAt","category","vuln","tags",[92,93,94,76,79,81],"score",77,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","sameEvent",{"_11":90,"_13":91},"readingMode","full","author","body",{"_62":86,"_87":-5,"_88":87,"_89":36},"outline",[],"relatedStories",[82],"topics",[69,70,71,72],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation",false,"bodyLanguage","zh","factId","f6ZAsYycycU8","reportCount",5,"additionalSourceCount",4,{"_73":80,"_75":81},{"_73":78,"_75":79},{"_73":30,"_75":77},{"_73":74,"_75":76},"slug","research","name","技术研究","漏洞披露","vuln-mgmt","漏洞管理","qianxin","奇安信",{"_83":84,"_13":85},"publicId","5f727b7b-3657-4338-b837-306e337b299b","Cacti 1.2.31未授权RCE PoC已公开","<p>\n                    攻击者可利用该漏洞，在无需登录的情况下通过少量 HTTP 请求即可在 Cacti 服务器上执行任意命令，获取服务器控制权，并进一步窃取设备凭据、篡改监控数据或以此为跳板渗透内网。\n                </p><table><tbody><tr><td colspan=\"4\"><p><strong>漏洞概述</strong></p></td></tr><tr><td><p><strong>漏洞名称</strong></p></td><td colspan=\"3\"><p>Cacti 未授权远程代码执行漏洞</p></td></tr><tr><td><p><strong>漏洞编号</strong></p></td><td colspan=\"3\"><p>QVD-2026-117631</p></td></tr><tr><td><p><strong><strong>公开时间</strong></strong></p></td><td><p>2026-11-26</p></td><td><p><strong><strong>影响量级</strong></strong></p></td><td><p>万级</p></td></tr><tr><td><p><strong>奇安信评级</strong></p></td><td><p><strong>高危</strong></p></td><td><p><strong>CVSS 3.1分数</strong></p></td><td><p><strong>9.8</strong></p></td></tr><tr><td><p><strong>威胁类型</strong></p></td><td><p>代码执行</p></td><td><p><strong>利用可能性</strong></p></td><td><p><strong><strong>高</strong></strong></p></td></tr><tr><td><p><strong>POC状态</strong></p></td><td><p><strong>已公开</strong></p></td><td><p><strong>在野利用状态</strong></p></td><td><p>未发现</p></td></tr><tr><td><p><strong>EXP状态</strong></p></td><td><p><strong>已公开</strong></p></td><td><p><strong>技术细节状态</strong></p></td><td><p><strong>已公开</strong></p></td></tr><tr><td colspan=\"4\"><p><strong>危害描述：</strong>攻击者可利用该漏洞，在无需登录的情况下通过少量 HTTP 请求即可在 Cacti 服务器上执行任意命令，获取服务器控制权，并进一步窃取设备凭据、篡改监控数据或以此为跳板渗透内网。</p></td></tr></tbody></table><p><strong>0</strong><strong>1</strong></p><p><strong>漏洞详情</strong></p><p><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong></p><p><strong>影响组件</strong></p><p>Cacti 是一款开源的网络监控与图形化工具，广泛用于企业环境中采集路由器、交换机、服务器等设备的性能数据。它通过 SNMP、脚本等方式收集指标，并生成历史图表，同时存储大量设备凭证（如 SNMP 社区字符串、登录账号等），成为网络管理的核心信任节点。许多组织依赖其进行实时监控与告警。</p><p><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong></p><p><strong>漏洞描述</strong></p><p>近日，奇安信CERT监测到Cacti 未授权远程代码执行漏洞(QVD-2026-117631)在互联网公开，该漏洞源于 Guest 用户可通过 auth_profile.php 写入任意字符串到本应仅接受数字的 preview_graphs_per_page 设置。该设置后续被 graph_view.php 作为默认值直接拼接到 SQL LIMIT 子句中，因 PDO 支持多语句执行，攻击者可注入 UPDATE 语句修改 poller_item 表中的 arg1 字段。随后调用 graph_realtime.php 触发实时轮询器，通过 popen() 执行被篡改的命令，从而实现任意命令执行。攻击者可借此获取服务器权限，进一步窃取网络设备凭证、篡改监控数据或作为跳板渗透内网。目前该漏洞PoC和技术细节已公开。Cacti 通常存储大量网络设备凭据与管理访问权限，一旦沦陷，攻击者可轻易横向移动、窃取敏感信息或破坏监控体系。当前无官方补丁，建议客户尽快做好自查及防护。</p><p><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong></p><p><strong>利用条件</strong></p><p>1.Guest 账户已启用（默认关闭，但部分场景为共享图表会开启）。</p><p>2.Web 接口可被攻击者访问（无需认证）。</p><p>3.数据库驱动（PDO）支持多语句执行。</p><p><strong>02</strong></p><p><strong>影响范围</strong></p><p><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong></p><p><strong>影响版本</strong></p><p>Cacti Core 1.2.31</p><p>（开启 Guest 账户且 Web 接口可被外部访问的 Cacti 实例）</p><p>*早期 1.2.x 版本若共用相同 profile 与 realtime poller 代码路径，亦可能处于风险之中</p><p><strong>03</strong></p><p><strong>复现情况</strong></p><p>目前，奇安信CERT已成功复现Cacti 未授权远程代码执行漏洞(QVD-2026-117631)，截图如下：</p><p><img src=\"/dailyinfo/media/6228077fcd8ff3a3.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong>04</strong></p><p><strong>受影响资产情况</strong></p><p>奇安信鹰图资产测绘平台数据显示，Cacti 未授权远程代码执行漏洞(QVD-2026-117631)关联的国内风险资产总数为2933个，关联IP总数为767个。国内风险资产分布情况如下：</p><p><img src=\"/dailyinfo/media/f54ec80e2995427f.webp\" loading=\"lazy\" decoding=\"async\"></p><p>Cacti 未授权远程代码执行漏洞(QVD-2026-117631)关联的全球风险资产总数为16725个，关联IP总数为5297个。全球风险资产分布情况如下：</p><p><img src=\"/dailyinfo/media/94ed1007027d25c8.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong>05</strong></p><p><strong>处置建议</strong></p><p><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong></p><p><strong>安全更新</strong></p><p>目前官方尚未发布修复版本。请密切关注 Cacti 官方发布渠道，待补丁发布后立即升级至安全版本。在补丁可用前，必须禁用 Guest 账户（用户管理设置中关闭）。</p><p>官方地址：</p><p>https://www.cacti.net/</p><p>临时缓解措施：</p><p>1.使用防火墙/WAF 限制访问来源，仅允许管理网段访问。</p><p>2.禁用 Guest 功能，强制所有访问需认证。</p><p>3.对 auth_profile.php、graph_view.php、graph_realtime.php 等关键接口增加异常行为检测。</p><p><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong></p><p><strong>产品解决方案</strong></p><p><strong>奇安信开源卫士已支持</strong></p><p>奇安信开源卫士20261127.1565 版本已支持对 Cacti 远程代码执行漏洞(QVD-2026-117631)的检测。</p><p><strong>奇安信网站应用安全云防护系统已更新防护特征库</strong></p><p>奇安信网神网站应用安全云防护系统已全局更新所有云端防护节点的防护规则，支持对Cacti 远程代码执行漏洞(QVD-2026-117631)的防护。</p><p><strong>06</strong></p><p><strong>参考资料</strong></p><p>[1]https://watchtowr.com/intelligence/4http2root-cacti-zero-day-faq/</p><p>[2]https://github.com/ekomsSavior/Sad-Girls-0day-Club/blob/main/4http2shell/README.md</p><p>声明：本文来自奇安信 CERT，版权归作者所有。文章内容仅代表作者独立观点，不代表安全内参立场，转载目的在于传递更多信息。如有侵权，请联系 anquanneican@163.com。</p>","original","zhKind","complete","sq959gxd7blu324wq7irv97yz","Cacti 未授权远程代码执行漏洞 QVD-2026-117631 已复现，CVSS 3.1 9.8","漏洞","复现","漏洞利用","https://www.secrss.com/articles/96052","安全内参",{"_98":99,"_100":-5},"changelogVersion","2026-10-01T08:00","release"]
