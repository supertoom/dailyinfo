[{"_1":2,"_3":4},"root",{"_5":95},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794962437000,"id","cn6javf3ri8dog43dj7dnbdvw","title","Tor 发布 0.4.9.17 紧急更新以应对持续 DDoS 攻击","originalTitle","Tor releases emergency update amid ongoing DDoS attack","summary","Tor Project 发布 Tor 0.4.9.17 安全更新，用于应对持续进行的 DDoS 攻击。攻击产生大量客户端电路流量，已使多数中继运营商受影响并压垮中继节点；该版本包含多项安全修复，其中一项重点加强与 IPv6 处理相关的拒绝服务防御。Tor 建议中继运营商尽快升级，安装后无需采取其他操作，项目仍在开发额外防御并预计近期发布更多版本；原文未说明攻击者身份或攻击开始时间。","reason","文章给出了紧急更新的具体版本、IPv6 处理相关修复及升级要求，运营方可据此判断是否需要立即更新中继节点。","source",{"_71":94},"links",{"_85":93},"publishedAt","2026-11-17T18:04:15.000Z","discoveredAt","2026-11-17T18:49:31.539Z","timelineAt","category","blue-team","tags",[89,90,91,92],"score",70,"selected",true,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","Lawrence Abrams","body",{"_61":84,"_85":-5,"_86":87,"_88":37},"outline",[79],"relatedStories",[75],"topics",[68,69],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fovcdltnyVWk","reportCount",2,"additionalSourceCount",1,{"_70":73,"_71":74},{"_70":31,"_71":72},"slug","name","蓝队与运营","vuln","漏洞披露",{"_76":77,"_13":78},"publicId","85cfd174-a249-4ce6-89e6-4e96404f6f23","Tor 0.4.9.17修复DDoS防御问题",{"_11":80,"_81":82,"_83":65},"sec-1","text","发现您现有的防御措施可能遗漏的电子邮件威胁。","level","<p><img alt=\"Tor\" height=\"900\" src=\"/dailyinfo/media/a39d6cd45336c61d.jpg\" srcset=\"/dailyinfo/media/a89bcd94daa35535.jpg 720w, /dailyinfo/media/7ef8dddc41f50894.jpg 1200w, /dailyinfo/media/a39d6cd45336c61d.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1800\"></p><p>Tor Project 已为其网络中继软件发布安全更新，以加强防御能力，抵御一场持续进行的分布式拒绝服务攻击。该项目称，这场攻击已使中继不堪重负，并影响到大多数运营者。</p><p>Tor 0.4.9.17 版本包含一系列安全修复，其中包括项目描述为一项尤其重要的修复，用于加强涉及 IPv6 处理的中继拒绝服务防御能力。</p><p>Tor Project 在其<a href=\"https://forum.torproject.org/t/security-release-0-4-9-17/22454\">发布公告</a>中表示：“此次发布是对网络上持续进行的 DDoS 攻击的快速响应，该攻击已影响到大多数中继运营者。”</p><p><a href=\"https://www.wiz.io/lp/securing-ai-agents-101?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY26Q3_INB_FORM_Securing-AI-Agents-101&amp;sfcid=701Py00000RTEWMIA5&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AI-Agents-101\"><img src=\"/dailyinfo/media/663dffc496cc221d.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>该项目表示，由客户端电路引发的大规模持续洪流已使隐私网络各处的 overwhelmed 中继不堪重负，导致了一个&nbsp;难以解决的问题。</p><p>该项目表示，此次更新包含一项安全修复，旨在加强中继对拒绝服务攻击的防御能力。</p><p>项目解释道：“其中一项修复对于加强与 IPv6 处理相关的中继 DoS 防御能力而言尤其重要。”</p><p>Tor 正在研究其他防御措施，并预计在不久的将来发布更多版本。</p><p>中继运营者被敦促尽快升级至 0.4.9.17 版本。该项目表示，安装更新后无需采取任何其他操作。</p><p>公告未提供有关是谁幕后操纵这些 DDoS 攻击或攻击何时开始的任何其他详细信息。</p><p>Tor Project 感谢中继运营者协助应对此次攻击，并指向其 tor-relays 邮件列表上的活跃讨论，呼吁运营者继续提供支持。</p><p>“感谢所有人……唯独不包括我们的攻击者。”</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/7eb183d906b5dd40.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现您现有的防御措施可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体会分析电子邮件意图、上下文和行为，以发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>对 Microsoft 365 或 Google Workspace 进行为期 14 天的只读扫描，看看有哪些威胁正在穿透防护，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始您的免费电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","补丁","版本更新","加固","网络设备","https://www.bleepingcomputer.com/news/security/tor-releases-emergency-update-amid-ongoing-ddos-attack/","BleepingComputer",{"_96":97,"_98":-5},"changelogVersion","2026-10-01T08:00","release"]
