[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1794444095000,"id","ku52lizwzm4wr4gzd6lbh26p7","title","Check Point Research 关联 CopperDragon 与三个 Sparrow 框架入侵集群","originalTitle","Suspected Chinese Malware Supplier Tied to Three Hacking Campaigns","summary","Check Point Research 关联了针对拉丁美洲、亚洲和欧洲三个地区的入侵集群 SilentDelivery、OceanGate 和 DarkWire，它们通过 Sparrow 框架共享恶意软件与基础设施，可能关联同一工具供应商 CopperDragon。","reason","source",{"_67":96},"links",{"_58":95},"publishedAt","2026-11-11T16:00:00.000Z","discoveredAt","2026-11-11T16:14:07.503Z","timelineAt","category","activity","tags",[70,68,92,93,94,78],"score",69,"selected",false,"channel","news","story","x","readingMode","full","author","body",{"_88":-5,"_58":89,"_90":-5,"_91":36},"outline",[79,80],"relatedStories",[],"topics",[59,60,61,62,63,64],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_65":77,"_67":78},{"_65":75,"_67":76},{"_65":73,"_67":74},{"_65":71,"_67":72},{"_65":69,"_67":70},{"_65":66,"_67":68},"slug","malware","name","恶意软件","attack","攻击活动","red-team","红队与渗透","black-market","数据窃取与黑产","ransomware","勒索软件","checkpoint","Check Point",{"_11":86,"_82":87,"_84":85},{"_11":81,"_82":83,"_84":85},"sec-2","text","CopperDragon May Sit Behind Multiple Groups","level",2,"sec-1","Three Clusters Share Sparrow Framework","zh","<p>\n\tThree China-nexus intrusion clusters across Latin America, Asia and Europe have been linked through shared malware and infrastructure to a possible common supplier of hacking tools.</p><p>\n\tCheck Point Research (CPR) detailed the findings in a November 10 <a href=\"https://research.checkpoint.com/2026/not-all-that-glitters-is-gold-tracking-copperdragons-sparrow-framework-around-the-globe/\">report</a>, linking the clusters through shared infrastructure features and code similarities within the Sparrow framework.</p><p>\n\tThe year-long investigation covered campaigns targeting several dozen high-profile organizations across the three regions. CPR called the suspected supplier behind the framework 'CopperDragon.'</p><h2 id=\"sec-1\">\n\t<strong>Three Clusters Share Sparrow Framework</strong></h2><p>\n\tThe three clusters are tracked by CPR researchers as SilentDelivery, OceanGate and DarkWire.</p><p>\n\tSilentDelivery, observed since early 2026, has compromised legitimate websites, mainly in government, shipping and IT or research sectors.</p><p>\n\tVisitors were shown a fake Chrome certificate warning that prompted them to install a \"Certificate Fix\" utility, with targets mainly in the Czech Republic, Germany, France, Taiwan, Nepal, Hong Kong and Indonesia. The fake utility delivered SquadC or a SparrowDoor variant, giving the attackers an initial foothold.</p><p>\n\tOceanGate was observed during 2025 and 2026 and mainly targeted government organizations and critical infrastructure in Asia. CPR said attackers entered through an internet-facing Linux server before moving into Windows environments and conducting extensive credential theft, lateral movement and exfiltration of sensitive operational information.</p><p>\n\tDarkWire, first identified in mid-2025, initially concentrated on Latin America but more recent intrusions suggested expansion. The cluster has targeted telecom operators, including at least three major providers in the region, as well as foreign affairs and justice bodies.</p><h2 id=\"sec-2\">\n\t<strong>CopperDragon May Sit Behind Multiple Groups</strong></h2><p>\n\tCPR described CopperDragon as \"a potential digital quartermaster supporting China-nexus threat actors\" and the Sparrow framework's \"possible developer and supplier.\" It also assessed that CopperDragon is involved in maintaining and supplying variants of the Melofee backdoor.</p><p>\n\tThe report links the framework to FamousSparrow, first identified in 2021 and known for using the SparrowDoor backdoor. CPR said Earth Estries, TropicTrooper and UAT-9244 use a shared toolset \"potentially supplied by the same entity,\" and noted that FamousSparrow was previously also linked to <a href=\"https://www.infosecurity-magazine.com/news/salt-typhoon-citrix-flaw-cyber/\">Salt Typhoon</a>, though the details of that relationship remain unclear.</p><p>\n\t<em><a href=\"https://infosecurity-magazine.com/news/famoussparrow-sparrowocky-latin\">Read more on FamousSparrow: FamousSparrow Swaps SparrowDoor For New SparroWocky Backdoor</a></em></p><p>\n\tFor DarkWire, CPR said it did not identify direct code similarities with the CopperDragon toolset. The link instead rests on infrastructure tied to a previously reported FamousSparrow domain.</p><p>\n\tShared malware and infrastructure \"can blur the boundaries between operators and campaigns,\" CPR wrote, presenting its findings as a basis for tracking activity long grouped under FamousSparrow more precisely.</p>","zhKind","complete","后门","数据窃取","红队","https://www.infosecurity-magazine.com/news/chinese-malware-tied-three-hacking/","Infosecurity Magazine",{"_98":99,"_100":-5},"changelogVersion","2026-10-01T08:00","release"]
