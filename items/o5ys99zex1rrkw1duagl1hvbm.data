[{"_1":2,"_3":4},"root",{"_5":88},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1794530489000,"id","o5ys99zex1rrkw1duagl1hvbm","title","Chrome Stable 渠道提前发布 158.0.8127.36/.37 更新，Mac 版本即将推出","originalTitle","Early Stable Update for Desktop","summary","Chrome Stable 渠道已提前更新至 158.0.8127.36/.37 版本，Windows 用户先行获得该版本，Mac 版本将随后推出。此次为面向少量用户的 Early Stable 发布，完整变更记录可在更新日志中查看，官方同时提供发布渠道切换说明、问题反馈入口与社区帮助论坛。","reason","source",{"_72":87},"links",{"_61":86},"publishedAt","2026-11-12T21:30:51.410Z","discoveredAt","2026-11-12T23:43:30.848Z","timelineAt","category","blue-team","tags",[84,85,73],"score",3,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","readingMode","full","author","Srinivas Sista","body",{"_80":-5,"_61":81,"_82":-5,"_83":36},"outline",[],"relatedStories",[76],"topics",[68,69],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fgD8brkTiRW0","reportCount",1,"additionalSourceCount",0,{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","browser","name","浏览器","google","Google / 谷歌",{"_77":78,"_13":79},"publicId","25f4e101-9dbe-47bf-af23-8898c48f1682","Chrome Stable 提前发布158更新","zh","<p>&nbsp;<span>The Stable channel has been updated to </span><span>158.0.8127.36/.37</span><span> for Windows , Mac will be coming shortly as </span><span>part of our early stable release to a <span>small percentage of users. </span>A full list of changes in this build is available in the</span><span> </span><span><a href=\"https://chromium.googlesource.com/chromium/src/+log/158.0.8127.18..158.0.8127.37?pretty=fuller&amp;n=10000\">log</a></span><span>.</span></p><p><span><span>You can find more details about early Stable releases </span><a href=\"https://developer.chrome.com/blog/early-stable/\"><span>here</span></a><span>.</span></span></p><p><span>Interested in switching release channels? &nbsp;Find out how </span><a href=\"https://www.chromium.org/getting-involved/dev-channel\"><span>here</span></a><span>. If you find a new issue, please let us know by </span><a href=\"https://crbug.com/\"><span>filing a bug</span></a><span>. </span><span>The </span><a href=\"https://support.google.com/chrome/community\"><span>community help forum</span></a><span> is also a great place to reach out for help or learn about common issues.</span></p><p><span>Srinivas Sista</span></p><p><span>Google Chrome</span></p>","zhKind","complete","版本更新","Google","http://chromereleases.googleblog.com/2026/11/early-stable-update-for-desktop_0520415684.html","Chrome Releases",{"_89":90,"_91":-5},"changelogVersion","2026-10-01T08:00","release"]
