[{"_1":2,"_3":4},"root",{"_5":146},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":-5,"_56":37,"_57":58},"expiresAt",1794616830000,"id","k8q8wjtgm1ani9e5qkly6h7dl","title","Elastic 分析 ARTEX 等五套 AI 攻击框架及在野入侵","originalTitle","Inside the loop: Five AI attack frameworks that never ask permission","summary","Elastic Security Labs 发现 ARTEX、CyberStrikeAI、Cairn、PentAGI 和 HexStrike 五套 AI 攻击框架已出现在真实入侵中，而非仅用于红队测试；五者 GitHub stars 合计超过 60,000。","reason","文章结合源码与公开事件拆解五套 AI 攻击框架的自主执行链，并给出可落地的行为检测与凭据处置建议。","source",{"_66":145},"links",{"_134":144},"publishedAt","2026-11-13T16:00:00.000Z","discoveredAt","2026-11-13T16:59:25.728Z","timelineAt","category","ai-security","tags",[68,138,72,70,139,140,141,142,143],"score",80,"selected",true,"channel","news","story","x","readingMode","full","author","body",{"_58":133,"_134":-5,"_135":136,"_137":37},"outline",[75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92],"relatedStories",[],"topics",[59,60,61,62,63],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_64":73,"_66":74},{"_64":71,"_66":72},{"_64":69,"_66":70},{"_64":31,"_66":68},{"_64":65,"_66":67},"slug","blue-team","name","蓝队与运营","AI 安全","research","技术研究","ai-offense","AI 攻防","red-team","红队与渗透",{"_11":131,"_94":132,"_96":97},{"_11":129,"_94":130,"_96":97},{"_11":127,"_94":128,"_96":97},{"_11":125,"_94":126,"_96":97},{"_11":123,"_94":124,"_96":108},{"_11":121,"_94":122,"_96":108},{"_11":119,"_94":120,"_96":108},{"_11":117,"_94":118,"_96":108},{"_11":115,"_94":116,"_96":108},{"_11":113,"_94":114,"_96":97},{"_11":111,"_94":112,"_96":108},{"_11":109,"_94":110,"_96":108},{"_11":106,"_94":107,"_96":108},{"_11":104,"_94":105,"_96":97},{"_11":102,"_94":103,"_96":97},{"_11":100,"_94":101,"_96":97},{"_11":98,"_94":99,"_96":97},{"_11":93,"_94":95,"_96":97},"sec-18","text","关于 Elastic Security Labs","level",2,"sec-17","参考文献","sec-16","结论：这对检测与响应意味着什么","sec-15","关于智能体化攻击框架的开放问题","sec-14","如何防御代理式攻击框架","sec-13","在 ARTEX、CyberStrikeAI、Cairn、PentAGI 和 HexStrike 中需要关注什么",3,"sec-12","使用 ES|QL 搜寻工具家族突发行为","sec-11","按身份检测智能体化节奏与序列","sec-10","如何检测智能体化攻击框架","sec-9","为什么撤销凭据不能立即停止代理","sec-8","为什么基于 IOC 的检测在代理式框架上会过时","sec-7","当你屏蔽代理式攻击框架时，它们会如何响应","sec-6","智能体化攻击框架会检查授权吗？","sec-5","智能体化攻击在数秒内即可产生效果","sec-4","智能体化攻击框架如何改变检测与响应","sec-3","ARTEX、CyberStrikeAI、Cairn、PentAGI 和 HexStrike 对比","sec-2","代理式攻击框架与传统 C2 框架有何不同","sec-1","关键要点","<p>五种代理式攻击框架只需通过一个脚本或 Compose 文件即可安装，合计已获得超过 60,000 个 GitHub star：ARTEX、CyberStrikeAI、Cairn、PentAGI 和 HexStrike。这五种框架均已出现在实际入侵事件中，而不仅仅用于红队演练。Google Threat Intelligence Group (GTIG) 和 Mandiant 观察到<a href=\"https://cloud.google.com/blog/topics/threat-intelligence/artex-and-friends-enter-agentic-offensive-frameworks\">ARTEX、Cairn、HexStrike 和 PentAGI 出现在事件响应行动中</a>，Microsoft 则<a href=\"https://www.microsoft.com/en-us/security/blog/2026/10/21/storm-0940-uses-artex-agentic-ai-connectwise-supply-chain-compromise/\">将 ARTEX 的使用归因于 Storm-0940</a>。我们追踪到一起借助 AI 入侵 AWS 的活动，其源头是一台 CyberStrikeAI 服务器，详见<a href=\"https://www.elastic.co/security-labs/cyberstrikeai-server-aws-cloud-intrusion\">一台 CyberStrikeAI 服务器，八个 AWS 身份</a>。</p><p>代理式攻击框架让大型语言模型 (LLM) 掌控红队和威胁行为者已经在使用的扫描器、curl、shell 和云 CLI。这些工具并不新鲜，但围绕它们的循环是新出现的：模型规划每个步骤，将工作拆分给多个代理，构建或安装其缺少的组件，并在 ARTEX 的案例中以 2 至 25 秒为一批次推进。我们阅读了全部五个框架的源码以及公开的事件报告，以确定其中一个运行时究竟会有哪些行为进入防御方的遥测数据。它们均未在代码中强制执行授权，而它们执行的每个操作仍需出现在你已经收集的遥测数据中。</p><h2 id=\"sec-1\">关键要点</h2><ul><li><p>ARTEX 等代理式框架以数秒为批次运行，因此，用于启动遏制的检测规则必须在事件发生前就已选定。</p></li><li><p>这五个框架默认均未在代码中强制执行授权。其中三个仅在提示词中声明授权，而默认生效的目标限制只有针对政府和教育域名的阻止列表。</p></li><li><p>这些框架默认会产生大量噪声，并且在 ARTEX 和 CyberStrikeAI 中会在遭到阻止时改变路线。它们的变化速度也快于签名规则，但其行为本身并非如此。每个触达你的环境的操作，都会以进程、Web 请求、API 调用或登录的形式出现在防御方面前，因此，基于行为的检测比基于源地址、User-Agent 或框架指纹的检测更持久。</p></li></ul><h2 id=\"sec-2\">代理式攻击框架与传统 C2 框架有何不同</h2><p><a href=\"https://attack.mitre.org/software/S0154/\">Cobalt Strike</a> 和 <a href=\"https://attack.mitre.org/software/S1063/\">Brute Ratel C4</a> 由人类操作员在植入体后端控制，决定下一步运行什么。代理式框架保留了这些工具，但用一个规划循环取代了操作员的思考时间。GTIG 观察到 ARTEX 以大约 2 至 25 秒为批次执行，而 NorForge 在追踪暴露在外的 Cairn 面板并将其评估为恶意基础设施后发现，某一攻击者集群成功完成的项目从启动到达成目标<a href=\"https://norforge.com/blog/inside_cairn\">平均耗时不到 23 小时</a>。单个批次可以落入较短的检测窗口，但整个行动可能持续数小时，因此，要将这些批次关联为一次完整行动，需要较长的回溯期。</p><p>代理及大多数工具通常运行在攻击者控制的基础设施上，并调用托管或自行运行的模型。进入你的环境的内容，是这些工具对它执行的操作，记录形式包括主机上出现的新进程、云审计日志中的 API 调用以及登录事件。</p><figure><figcaption><p><em>图 1：代理循环中有哪些内容会到达防御方</em></p></figcaption></figure><h2 id=\"sec-3\">ARTEX、CyberStrikeAI、Cairn、PentAGI 和 HexStrike 对比</h2><p>这五个框架采用相同的循环，但在模型运行位置以及每个工具的启动方式上存在差异。</p><figure><figcaption><p><em>图 2：每个框架在哪里调用其模型，以及由什么启动其工具</em></p></figcaption></figure><figure><figcaption><p><em>图 3：各框架的设计与安全防护措施</em></p></figcaption></figure><p>默认情况下即具有自主性。CyberStrikeAI 出厂时关闭审批模式，PentAGI 的 Compose 文件将 ASK_USER 设为 false，Cairn <a href=\"https://github.com/oritera/Cairn/blob/8e7e0ea67552383851dfcabfba0c4e9c8d007878/cairn/src/cairn/dispatcher/workers/adapters/claudecode.py#L38-L61\">启动其三种编程智能体工作者类型中的两种，并禁用其审批提示</a>，而 ARTEX 则以绕过权限模式运行其智能体，因此这四个框架默认都不会等待人工批准。</p><p>除了共享的循环之外，每个框架都有独特的设计选择。</p><ul><li><p><a href=\"https://github.com/BaaRai/ARTEX\">ARTEX</a> 将事件驱动的规划器与并行工作者相结合，并将人工角色限定为一名聊天智能体，由其观察进度并通过提示进行引导。其内置的浏览器扩展会记录操作员已认证的会话，验证码和一次性代码只需处理一次，随后将这些请求作为证据交给智能体。我们审阅了原始代码仓库的一个公开英文翻译版本。</p></li><li><p><a href=\"https://github.com/AIPentest/CyberStrikeAI\">CyberStrikeAI</a> 是一套完整的操作员控制台。它构建自己的植入程序、运行 C2 监听器和 WebShell 管理器，并连接 Telegram、Slack、Discord 和 DingTalk 等聊天平台。</p></li><li><p><a href=\"https://github.com/oritera/Cairn\">Cairn</a> 将工作委派给现有的编程智能体。其工作者是运行在 Kali 容器内的命令行工具，其 README 描述了它首次亮相于一场 AI 渗透测试竞赛。</p></li><li><p><a href=\"https://github.com/vxcontrol/pentagi\">PentAGI</a> 使用一名反思器智能体来推动其智能体持续行动。当某个智能体犹豫不决，或以散文形式作答而非采取行动时，反思器会以用户的口吻回复，而这段交流会被记录为一条人类消息。</p></li><li><p><a href=\"https://github.com/0x4m4/hexstrike-ai\">HexStrike</a> 没有自己的模型。它通过 Model Context Protocol (MCP) 暴露约 150 个工具函数，供操作员已经在使用的任何 AI 助手调用。</p></li></ul><p>每个框架附带的组件也有所不同。CyberStrikeAI 会构建自己的植入程序，而五个框架中有三个捆绑了云工具，使得操作员能够像访问主机一样便捷地访问云账户。</p><figure><figcaption><p><em>图 </em>4<em>：每个框架为入侵带来的能力</em></p></figcaption></figure><h2 id=\"sec-4\">智能体化攻击框架如何改变检测与响应</h2><figure><figcaption><p><em>图 5：智能体化框架如何改变检测与响应</em></p></figcaption></figure><h3 id=\"sec-5\">智能体化攻击在数秒内即可产生效果</h3><p>在一次突发攻击过程中，智能体循环会以相隔数秒的节奏发出步骤，而每个步骤一经发送便会立即生效。以这种速度，真正重要的决策都是在事件开始之前作出的，首先便是选择哪些检测信号值得信任，以自动启动遏制措施。</p><h3 id=\"sec-6\">智能体化攻击框架会检查授权吗？</h3><p>与传统攻击工具一样，这五个框架默认都不会在代码中强制执行授权。其中三个框架更进一步，明确告诉模型其已获得授权。CyberStrikeAI 告诉模型授权已事先确定，绝不应质疑授权或等待批准；PentAGI 的九种角色提示均以预授权区块开头；ARTEX 则将每个智能体描述为经授权渗透测试系统的一部分。Cairn 指示其工作者绝不拒绝任务；当模型仍然拒绝时，其调度器会将该工作者闲置五秒，并把任务交给另一个已配置的工作者；如果该工作者是唯一可用者，则会再次尝试交给同一工作者。</p><p>默认启用的唯一目标限制，是 ARTEX 和 CyberStrikeAI 中针对政府域名的阻止列表，以及 ARTEX 中针对教育域名的阻止列表。除这些阻止列表外，随附的安全措施范围很窄：</p><ul><li><p><strong>ARTEX</strong> 会阻止 <code>rm -rf</code> 和 <code>mkfs</code> 等破坏性命令，并可依据操作员编写的允许列表检查任务资产，而该列表默认为空。Shell 命令仍可抵达任何主机。</p></li><li><p><strong>ARTEX 的</strong>交战规则范围机制已被移除；其<a href=\"https://github.com/BaaRai/ARTEX/blob/e6e9b2f9787d42c00d85a3dc1ba9eb87a12252f2/guard/guard.go#L4\">来源说明</a>以及工作者记录的资产会自动加入任务范围。</p></li><li><p><strong>HexStrike</strong>接受一份范围外清单，并且从不查询该清单。</p></li></ul><p>ARTEX<a href=\"https://github.com/BaaRai/ARTEX/blob/e6e9b2f9787d42c00d85a3dc1ba9eb87a12252f2/guard/guard.go#L125-L141\">将自己的屏蔽块标记为平台控制</a>，因为单纯的拒绝在代理看来就像目标的防御措施，需要绕过。模型提供商的拒并不是防御者可以依赖的控制措施，因为框架可以绕开它，就像 Cairn 的调度器那样。</p><h3 id=\"sec-7\">当你屏蔽代理式攻击框架时，它们会如何响应</h3><p>按发布时的默认配置，这五个框架都优先考虑能力、自主性和速度。它们的扫描器采用默认设置运行，若干默认项会直接点名该框架，而 CyberStrikeAI 的植入体每五秒就会签到一次，没有抖动。隐蔽性以模型可以加载的技能形式提供。CyberStrikeAI 的操作安全技能涵盖速率限制、IP 封禁规避和反取证。</p><p>当 ARTEX 或 CyberStrikeAI 被屏蔽时，变化便会出现。ARTEX 会告诉其工作者，经过过滤的载荷或 404 响应并不代表意图已经耗尽；GTIG 转述 Wiz Research 对其追踪为 UNC7228 的攻击活动的发现，称该攻击者在其初始基础设施被屏蔽后退回到使用开放代理。CyberStrikeAI 的技能会指示代理在遇到屏蔽时切换代理、User-Agent 和转发标头，先回退到目标所在国家的免费代理，然后再使用 Tor。屏蔽之后，预计同样的请求会从新的地址和 User-Agent 返回，因此，以请求内容为依据的检测比以来源地址为依据的检测更经得起考验。屏蔽来源地址仍会保留框架的访问权限，因此应同时撤销该框架正在使用的凭据。</p><h3 id=\"sec-8\">为什么基于 IOC 的检测在代理式框架上会过时</h3><p>代理式攻击框架变化迅速。ARTEX 的开发者在 2026 年 7 月 26 日至 10 月 7 日的十周半内记录了约 390 次提交，若计入合并则超过 450 次；在其创建者<a href=\"https://cloud.google.com/blog/topics/threat-intelligence/artex-and-friends-enter-agentic-offensive-frameworks\">于 2026 年 10 月将原始仓库下线</a>后，公开分叉仍将其延续下去。CyberStrikeAI 在第一年记录了超过 2,400 次提交，而且若干框架会在任务中途编写或安装新工具。如今标识某个框架的字符串、文件名和默认配置，可能在下一个版本中消失，而它所依赖的行为，例如访问凭据、远程执行以及由服务启动的攻击工具，则保持不变。因此，以行为为锚点的检测比以框架指纹为锚点的检测老化得更慢。</p><h3 id=\"sec-9\">为什么撤销凭据不能立即停止代理</h3><p><a href=\"https://docs.aws.amazon.com/IAM/latest/UserGuide/id_roles_use_revoke-sessions.html\">AWS</a> 和 <a href=\"https://docs.cloud.google.com/iam/docs/access-change-propagation\">Google</a>各自都记录了访问权限变更的传播延迟。在 Entra ID 中，在用户或服务主体被删除或禁用之前签发的访问令牌通常会一直有效，直至过期，通常为 60 至 90 分钟；除非资源和客户端支持<a href=\"https://learn.microsoft.com/en-us/entra/identity/conditional-access/concept-continuous-access-evaluation\">持续访问评估</a>。Microsoft 为 Exchange、Teams 和 SharePoint 记录了此功能，而<a href=\"https://learn.microsoft.com/en-us/entra/identity/conditional-access/concept-continuous-access-evaluation-workload\">对于服务主体，则仅适用于 Microsoft Graph</a>。已确认的撤销可能无法阻止下一次请求，而以机器速度运行的代理可以在这一间隙内采取行动。AWS 的角色会话撤销也不会影响 IAM 用户的长期密钥，并且不会阻止在截止时间之后请求的会话，因此应同时移除所有仍能承担该角色的主体。</p><h2 id=\"sec-10\">如何检测智能体化攻击框架</h2><h3 id=\"sec-11\">按身份检测智能体化节奏与序列</h3><p>行为规则是基础，而工具的覆盖范围决定了这些规则需要有多广泛。<a href=\"https://cloud.google.com/blog/topics/threat-intelligence/artex-and-friends-enter-agentic-offensive-frameworks\">GTIG 的 ARTEX 攻击技术目录</a>包括 SQL 注入、Kerberoasting，以及 Azure 和 AWS 权限映射。智能体化节奏增加了两种在单个事件之间出现的信号。</p><ul><li><p>按身份统计节奏。在短时间窗口内，按身份和发起角色统计不同的敏感操作数量，这样即使其中的每个操作都很常规，突发行为也会显现出来。</p></li><li><p>跨会话序列。将发现活动、密钥访问和远程执行按发起角色或源地址关联起来，把多个会话中的活动串联成一次操作。</p></li></ul><p><a href=\"https://www.elastic.co/security-labs/blog/higher-order-detection-rules\">高阶检测规则</a>将同样的逻辑应用于警报，把共享主机、用户或地址的相关警报关联为置信度更高的发现，因为每增加一个信号，良性解释的可能性就会降低。我们预计，随着这些框架发生变化，更多此类信号将会出现。</p><h3 id=\"sec-12\">使用 ES|QL 搜寻工具家族突发行为</h3><p>一个循环会根据任务需求调用其工具箱，因此单个源地址可以在同一分钟内使用 curl、Python 客户端、浏览器 User-Agent 和 AWS 客户端。下面的 ES|QL 搜寻会将 User-Agent 规范化为工具家族，在一分钟窗口内按源地址统计家族和请求数量，并返回至少包含三个家族且请求数出现突发的窗口。由于该循环运行在攻击者控制的基础设施上，该搜寻会读取记录其请求的日志，例如 Web 服务器、代理和云审计日志（将索引模式指向这些来源），并排除私有、回环、链路本地、运营商级 NAT 和组播源地址范围。</p><figure><figcaption><p><em>图 6：来自开发人员工作站的匹配记录，其中一个源地址在一分钟内使用了三个工具家族</em></p></figcaption></figure><p>构建系统、监控脚本、使用 AWS CLI 的管理员，以及共享的 NAT 或代理地址，也可能会混用这些客户端，因此应为这类自动化建立基线，并在对结果发出警报前，将阈值调整为每分钟三个家族和 20 个请求。该搜寻以一个地址在一分钟内使用多少种客户端为依据，因此不依赖任何单个字符串，但框架从新地址返回时就会开启一个新窗口。家族列表还可以使用下表中的框架 User-Agent，而 norma* 已经涵盖 ARTEX 的 Web 获取工具所发送的 norma/0.4。</p><h3 id=\"sec-13\">在 ARTEX、CyberStrikeAI、Cairn、PentAGI 和 HexStrike 中需要关注什么</h3><p>这些默认行为会出现在受攻击的系统上，并在有说明的情况下出现在你监控的主机上。它们值得立即开展搜寻，但其中任何一种都可能在下一个版本中发生变化。</p><table><thead><tr><th><p><em><strong>框架</strong></em></p></th><th><p><em><strong>需要关注什么</strong></em></p></th></tr></thead><tbody><tr><td><p><em>ARTEX</em></p></td><td><p><em>来自其所搭载扫描器的流量，例如 nuclei、httpx、katana、ffuf 和 sqlmap，</em>每个任务默认运行三个并行工作进程，<em>User-Agent 为 artex-enrich/1.0 或 norma/0.4 的请求，以及在你的应用程序上注册的新账户随后从多个会话登录，因为其智能体会注册并共享自己的测试账户。</em></p></td></tr><tr><td><p><em>CyberStrikeAI</em></p></td><td><p><em>携带 User-Agent </em><a href=\"https://github.com/AIPentest/CyberStrikeAI/blob/557f74d747bf622eda2ea74d84bee0894d476ebf/internal/handler/webshell.go#L799\"><em>Mozilla/5.0 (compatible; CyberStrikeAI-WebShell/1.0)</em></a><em> 和 pass 表单字段的 Webshell 请求；运行 echo :OSPROBE_%OS%:END 的 Web 服务器进程；名为 SystemUpdate（计划任务或 Run 键）或 com.apple.systemupdate（LaunchAgent）的植入物持久化；以 # cs 结尾的 .bashrc 行；或不携带自身标记且会启动植入物二进制文件的 @reboot cron 条目。</em></p></td></tr><tr><td><p><em>Cairn</em></p></td><td><p><em>反向 shell 以及指向操作员主机自身地址的带外回调，因为其示例配置会在主机网络上运行工作容器。当它运行在你监控的主机上时，其三个工作适配器中的两个会禁用批准提示，并在命令行中传入完整任务提示，从而启动其编程代理命令行工具。</em></p></td></tr><tr><td><p><em>PentAGI</em></p></td><td><p><em>从已失陷主机到 PentAGI 主机 </em><a href=\"https://github.com/vxcontrol/pentagi/blob/cffed9485aa1cca70762cd08a57ac62a80406258/backend/pkg/docker/client.go#L121-L130\"><em>TCP 端口 28000 到 29999</em></a><em> 的连接（默认每次行动建立两个）；其浏览的每个页面都会同时请求两次，一次用于获取内容，一次用于获取屏幕截图。安装在您网络中的实例还会每三小时向 update.pentagi.com 报告。</em></p></td></tr><tr><td><p><em>HexStrike</em></p></td><td><p><em>User-Agent </em><a href=\"https://github.com/0x4m4/hexstrike-ai/blob/d689933ff579d839c676c82b231f8e98326c5f04/hexstrike_server.py#L13287\"><em>HexStrike-HTTP-Framework/1.0</em></a><em> 和 </em><a href=\"https://github.com/0x4m4/hexstrike-ai/blob/d689933ff579d839c676c82b231f8e98326c5f04/hexstrike_server.py#L13644\"><em>HexStrike-BrowserAgent/1.0</em></a><em>，以及在浏览器代理的主动测试运行时出现的跨站脚本标记 &lt;hexstrikeXSSTest123&gt;。当它运行在你监控的主机上时，Python 服务器默认在所有接口上监听 8888 端口，并通过 shell 启动安全工具，因此工具可能会将 Python 服务器显示为其父进程。</em></p></td></tr></tbody></table><p>除这些默认设置外，扫描器均使用标准配置运行，因此在这些框架所在的网络中，它们很大程度上类似于其所驱动的工具。</p><h2 id=\"sec-14\">如何防御代理式攻击框架</h2><ol><li><p>预先确定哪些高置信度检测结果会触发遏制。将它们与终端上的<a href=\"https://www.elastic.co/docs/solutions/security/endpoint-response-actions/automated-response-actions\">自动化响应操作</a>以及<a href=\"https://www.elastic.co/docs/explore-analyze/workflows\">Elastic Workflows</a>连接，以编排响应流程，包括调用您自己的自动化来执行云端步骤，例如停用访问密钥或撤销角色的活动会话。</p></li><li><p>将针对源地址的任何阻断与撤销该身份的会话和令牌结合起来，因为这些框架会从新地址返回，然后确认下一次请求失败。</p></li><li><p>在足够长的时间窗口内，按身份衡量节奏和序列，以关联突发活动，并为您已经拥有的、行为类似代理的自动化建立基线。</p></li><li><p>将假定的角色和仅限应用的身份范围限定为它们所需的操作，因为代理会继承该身份允许的一切权限。</p></li><li><p>从代理可读取的位置移除机密，例如文件共享、Wiki、代码存储库和 CI/CD 变量；轮换任何已暴露的机密；并优先使用短期凭证。<a href=\"https://cloud.google.com/blog/topics/threat-intelligence/artex-and-friends-enter-agentic-offensive-frameworks\">GTIG 报告</a>称，操作员会将 ARTEX 已失陷的凭证交予他人，而 ARTEX 还可通过 Kerberoasting、SQL 注入和 DCSync 收集更多凭证，因此每个暴露的机密都会让一次行动得以触达另一个平台，并使遏制更加困难。</p></li><li><p>根据有关框架基础设施的威胁情报采取行动。<a href=\"https://cloud.google.com/blog/topics/threat-intelligence/artex-and-friends-enter-agentic-offensive-frameworks\">GTIG 报告称</a>，ARTEX 和 PentAGI 被用于针对多个组织，而<a href=\"https://norforge.com/blog/inside_cairn\">诸如 Cairn 的暴露控制台</a>可以从互联网枚举，因此，获取其基础设施情报是在早期阻断入侵的机会。在边界或代理处屏蔽这些地址，并将同一情报输入 Elastic 的威胁情报集成，使预置的 Threat Intel IP Address Indicator Match 规则能够标记往返于已知控制台和 C2 服务器的流量。<a href=\"https://www.elastic.co/docs/explore-analyze/workflows/use-cases/security/automate-security-operations/enrich-alert-with-threat-intel\">构建富化工作流</a>，由警报触发，对匹配到的地址执行信誉查询。控制台可能位于共享托管或 CDN 地址之后，因此，在匹配结果用于触发阻断之前，该查询有助于区分专用服务器与共享地址，而行为检测仍可覆盖会发生变化的基础设施。</p></li></ol><h2 id=\"sec-15\">关于智能体化攻击框架的开放问题</h2><p>这些问题现在值得回答，以免下次版本发布改变答案。</p><ul><li><p>当智能体扩展自身时会发生什么变化？ARTEX 的操作员助手可以创建新工具、MCP 服务器和技能，而 PentAGI 会将编写的代码保存在跨任务共享的存储区中。为某个目标编写的工具没有可供匹配的历史记录，因此，基于行为和父级关系的检测比基于工具名称的检测更有效。</p></li><li><p>优势在于速度还是适应能力？脚本可以跟上智能体的节奏，因此，更有意义的测试是新发现或陌生错误转化为新行动的速度。</p></li><li><p>一次多智能体运行涉及多少个行动者？ARTEX 在一个任务下运行一个规划器和多个并行工作器。多个会话或智能体名称可能看起来像多个行动者，但其背后的身份和控制者才是关键单元。</p></li></ul><h2 id=\"sec-16\">结论：这对检测与响应意味着什么</h2><p>智能体化攻击框架意味着一种新型操作员：一个能够规划、协调智能体、扩展自身工具，并以会改变检测与响应方式的节奏推进的循环。这五个框架默认都没有在代码中强制执行授权，因此，防御方遥测和控制措施才是真正的边界。</p><p>本次分析涵盖五个框架，还有更多框架值得持续追踪。Gambit Security <a href=\"https://gambit.security/blog-posts/autonomous-ai-agents-online-retailers-25-a-company\">报告称</a>，一起犯罪活动利用 <a href=\"https://github.com/usestrix/strix\">Strix</a> 进行漏洞发现，利用 <a href=\"https://github.com/oritera/Cairn\">Cairn</a> 进行漏洞利用，并将通用智能体 Hermes 作为其控制台。其他使用模型进行渗透测试的开源项目包括 <a href=\"https://github.com/KeygraphHQ/shannon\">Shannon</a>、<a href=\"https://github.com/GreyDGL/PentestGPT\">PentestGPT</a>、<a href=\"https://github.com/aliasrobotics/CAI\">CAI</a>（现已归档）、<a href=\"https://github.com/CyberStrikeus/cyberstrike\">CyberStrike</a>（并非 CyberStrikeAI）、<a href=\"https://github.com/samugit83/redamon\">RedAmon</a>、<a href=\"https://github.com/GH05TCREW/pentestagent\">PentestAgent</a>、<a href=\"https://github.com/IPA-Lab/HackingBuddyGPT\">hackingBuddyGPT</a>、<a href=\"https://github.com/BerylliumSec/nebula\">Nebula</a> 和 <a href=\"https://github.com/BugTraceAI/BugTraceAI\">BugTraceAI</a>。新项目还会不断出现，因此，应根据每个框架如何规划、由什么启动其工具，以及会为防御方留下哪些可见痕迹来对其进行追踪。</p><p>Elastic 的行为检测规则关注这些框架所采取的操作，例如凭据访问和远程执行，而不是关注框架或模型本身；基于 LLM 的分诊规则可以将与同一用户或主机相关的警报汇总为一个判定。Elastic 持续增加以 AI 为重点的防护，其规则公开发布在 <a href=\"https://github.com/elastic/detection-rules\">detection-rules</a> 和 <a href=\"https://github.com/elastic/protections-artifacts\">protections-artifacts</a> 存储库中。按身份添加时序和序列分析，确认撤销操作已经生效，并通过自动化响应操作和 Elastic Workflows 进行遏制，使响应决策在操作开始前完成。</p><h2 id=\"sec-17\">参考文献</h2><p>上述研究全程引用了以下内容：</p><ul><li><p><a href=\"https://cloud.google.com/blog/topics/threat-intelligence/artex-and-friends-enter-agentic-offensive-frameworks\">https://cloud.google.com/blog/topics/threat-intelligence/artex-and-friends-enter-agentic-offensive-frameworks</a></p></li><li><p><a href=\"https://www.microsoft.com/en-us/security/blog/2026/10/21/storm-0940-uses-artex-agentic-ai-connectwise-supply-chain-compromise/\">https://www.microsoft.com/en-us/security/blog/2026/10/21/storm-0940-uses-artex-agentic-ai-connectwise-supply-chain-compromise/</a></p></li><li><p><a href=\"https://www.elastic.co/security-labs/cyberstrikeai-server-aws-cloud-intrusion\">https://www.elastic.co/security-labs/cyberstrikeai-server-aws-cloud-intrusion</a></p></li><li><p><a href=\"https://www.elastic.co/security-labs/blog/higher-order-detection-rules\">https://www.elastic.co/security-labs/blog/higher-order-detection-rules</a></p></li><li><p><a href=\"https://norforge.com/blog/inside_cairn\">https://norforge.com/blog/inside_cairn</a></p></li><li><p><a href=\"https://attack.mitre.org/software/S0154/\">https://attack.mitre.org/software/S0154/</a></p></li><li><p><a href=\"https://attack.mitre.org/software/S1063/\">https://attack.mitre.org/software/S1063/</a></p></li><li><p><a href=\"https://github.com/BaaRai/ARTEX\">https://github.com/BaaRai/ARTEX</a></p></li><li><p><a href=\"https://github.com/AIPentest/CyberStrikeAI\">https://github.com/AIPentest/CyberStrikeAI</a></p></li><li><p><a href=\"https://github.com/oritera/Cairn\">https://github.com/oritera/Cairn</a></p></li><li><p><a href=\"https://github.com/vxcontrol/pentagi\">https://github.com/vxcontrol/pentagi</a></p></li><li><p><a href=\"https://github.com/0x4m4/hexstrike-ai\">https://github.com/0x4m4/hexstrike-ai</a></p></li><li><p><a href=\"https://docs.aws.amazon.com/IAM/latest/UserGuide/id_roles_use_revoke-sessions.html\">https://docs.aws.amazon.com/IAM/latest/UserGuide/id_roles_use_revoke-sessions.html</a></p></li><li><p><a href=\"https://docs.cloud.google.com/iam/docs/access-change-propagation\">https://docs.cloud.google.com/iam/docs/access-change-propagation</a></p></li><li><p><a href=\"https://learn.microsoft.com/en-us/entra/identity/conditional-access/concept-continuous-access-evaluation\">https://learn.microsoft.com/en-us/entra/identity/conditional-access/concept-continuous-access-evaluation</a></p></li><li><p><a href=\"https://learn.microsoft.com/en-us/entra/identity/conditional-access/concept-continuous-access-evaluation-workload\">https://learn.microsoft.com/en-us/entra/identity/conditional-access/concept-continuous-access-evaluation-workload</a></p></li><li><p><a href=\"https://www.elastic.co/docs/solutions/security/endpoint-response-actions/automated-response-actions\">https://www.elastic.co/docs/solutions/security/endpoint-response-actions/automated-response-actions</a></p></li><li><p><a href=\"https://www.elastic.co/docs/explore-analyze/workflows\">https://www.elastic.co/docs/explore-analyze/workflows</a></p></li><li><p><a href=\"https://www.elastic.co/docs/explore-analyze/workflows/use-cases/security/automate-security-operations/enrich-alert-with-threat-intel\">https://www.elastic.co/docs/explore-analyze/workflows/use-cases/security/automate-security-operations/enrich-alert-with-threat-intel</a></p></li><li><p><a href=\"https://gambit.security/blog-posts/autonomous-ai-agents-online-retailers-25-a-company\">https://gambit.security/blog-posts/autonomous-ai-agents-online-retailers-25-a-company</a></p></li></ul><h2 id=\"sec-18\">关于 Elastic Security Labs</h2><p>Elastic Security Labs 是 Elastic Security 旗下的威胁情报分支机构，致力于为威胁局势带来积极改变。Elastic Security Labs 提供公开的 emerging threats 研究，并分析对手在战略、战术和操作层面的目标，随后将这些研究 Elastic Security 内置的检测与响应能力相集成。</p><p>在 Twitter 上关注 Elastic Security Labs：<a href=\"https://twitter.com/elasticseclabs?ref_src=twsrc%5Egoogle%7Ctwcamp%5Eserp%7Ctwgr%5Eauthor\">@elasticseclabs</a>，并访问 <a href=\"https://www.elastic.co/security-labs/\">www.elastic.co/security-labs/</a> 查看我们的研究。</p>","original","zhKind","translation","complete","Agent 安全","检测工程","红队","Google","Microsoft","AWS","https://www.elastic.co/security-labs/threat-command/agentic-offensive-frameworks-detection-artex","Elastic Security Labs",{"_147":148,"_149":-5},"changelogVersion","2026-10-01T08:00","release"]
