[{"_1":2,"_3":4},"root",{"_5":92},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":-5,"_57":36,"_58":59},"expiresAt",1795308031000,"id","b1v2093hda318yigvkylrgnyr","title","WhatsApp 修复三个漏洞：CVE-2026-23871 已被用于诈骗活动","originalTitle","CVE-2026-23871: WhatsApp Bug Helped Scammers Make Messages Look Legitimate","summary","WhatsApp 11 月安全公告修复三个缺陷，其中 CVE-2026-23871 影响 2.26.17.4 之前的 WhatsApp 与 WhatsApp Business for Android。","reason","source",{"_67":91},"links",{"_59":90},"publishedAt","2026-11-20T22:21:12.000Z","discoveredAt","2026-11-20T23:35:38.435Z","timelineAt","category","vuln","tags",[86,70,87,88,73,89],"score",58,"selected",false,"channel","news","story","x","readingMode","full","author","Pierluigi Paganini","body",{"_82":-5,"_59":83,"_84":-5,"_85":36},"outline",[76],"relatedStories",[],"topics",[60,61,62,63,64],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_65":74,"_67":75},{"_65":72,"_67":73},{"_65":30,"_67":71},{"_65":69,"_67":70},{"_65":66,"_67":68},"slug","research","name","技术研究","exploited","在野利用","漏洞披露","mobile","移动端","google","Google / 谷歌",{"_11":77,"_78":79,"_80":81},"sec-1","text","WhatsApp patched three security flaws, including one exploited in a real scam ca","level",2,"zh","<h2 id=\"sec-1\">WhatsApp patched three security flaws, including one exploited in a real scam campaign to make fraudulent messages appear more credible.</h2><p>WhatsApp’s <a href=\"https://www.whatsapp.com/security/advisories/2026/\">November security advisory</a> fixes three flaws, including CVE-2026-23871, a vulnerability in Click to WhatsApp ads affecting WhatsApp and WhatsApp Business for Android versions earlier than 2.26.17.4. </p><p><em>“Incomplete validation of external ad-reply URLs in WhatsApp for Android and WhatsApp Business for Android before 2.26.17.4 could have caused a target’s device to reveal its IP information to an attacker if an attacker sent media from an attacker-controlled URL when a crafted Click to WhatsApp ad-reply message was rendered and displayed in a message thread.” reads the advisory. “This issue may have been abused in conjunction with specific spam messages.” </em></p><p>The issue was caused by incomplete checks on external ad-reply URLs. An attacker could use a server under their control to send media through a crafted ad-reply message. When the message appeared in a chat, it could cause the victim’s device to reveal its IP address to the attacker.</p><p>SecurityWeek <a href=\"https://www.securityweek.com/whatsapp-fixes-flaw-uncovered-while-disrupting-scam-campaign/\">reported</a> that WhatsApp discovered the flaw while investigating a real scam campaign. The company’s security team found that a scammer was exploiting the issue to make fraudulent messages appear more credible. </p><p><em>“Our team found this issue while disrupting a scam campaign, and we believe a scammer was using it to make their scam message seem more credible.” a WhatsApp spokesperson told SecurityWeek.</em></p><p>The second fix is more serious on paper, though WhatsApp has seen no sign it was ever used. CVE-2026-102769 is a SQL injection on WhatsApp for Android before 2.26.35.74, triggered when someone taps a specially crafted “order details” message sent from an unofficial client. </p><p><em>“A SQL injection vulnerability when the recipient tapped on a specially crafted “order details” message from an unofficial client in WhatsApp for Android prior to version 2.26.35.74 could have allowed deletion of locally-stored WhatsApp files and, only if the user is online at time of receipt, leaked one bit of information asked by the attacker about the user’s chat database via an induced-crash delivery receipt timing sidechannel.” continues the report.</em></p><p>The company is not aware of attacks in the wild exploiting this flaw.</p><p>The third, CVE-2026-44908, lives deeper in WhatsApp’s infrastructure than in the app itself. It affects the remote-attestation verifier that confirms trust with Meta AI’s confidential computing backend, across WhatsApp and WhatsApp Business on iOS, Android and Mac. Someone positioned inside Meta’s own infrastructure could, in theory, have presented a certificate signed by the wrong key to bypass the hardware root of trust, but such a certificate would first need to appear on a public transparency ledger, and WhatsApp says that ledger shows every published certificate checks out clean.</p><p>These issues come after two fixes released in May. One addressed a bug in Instagram Reels message handling that could make another person’s device load media from an attacker-controlled URL. The other fixed a Windows attachment-spoofing trick. By adding a NUL byte to a filename, an attacker could make an executable file look like a normal document. Meta received reports of both flaws through its bug bounty program, and there is no evidence that attackers exploited them.</p><p>Of the three new flaws, only one was used in a real-world scam. It also had the lowest technical impact. This shows that scammers don’t always need to exploit serious vulnerabilities or gain access to a device. A convincing message can be enough to deceive a victim. Make sure you update WhatsApp on all your devices. The fixed versions vary across iOS, Android, Mac, Windows and WhatsApp Business.</p><p><strong>Follow me on Twitter:&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a><strong></strong></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;hacking,&nbsp;CVE-2026-23871)</strong></p>","zhKind","complete","漏洞","补丁","漏洞分析","Google","https://securityaffairs.com/203622/security/cve-2026-23871-whatsapp-bug-helped-scammers-make-messages-look-legitimate.html","Security Affairs",{"_93":94,"_95":-5},"changelogVersion","2026-10-01T08:00","release"]
