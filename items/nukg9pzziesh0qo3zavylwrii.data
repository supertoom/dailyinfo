[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1794530489000,"id","nukg9pzziesh0qo3zavylwrii","title","深信服披露针对国内第三方支付机构的定向攻击工具包","originalTitle","【高级威胁追踪(APT)】一起针对第三方支付机构的定向攻击工具包披露","summary","深信服深瞻情报实验室发现一套针对某国内第三方支付机构生产环境的定向攻击工具包，共91个文件，涵盖冰蝎与蚁剑内存马、JVM无文件注入、反向隧道、Meterpreter载荷和数据窃取脚本。","reason","工具包暴露了针对支付机构的定制植入链、订单数据窃取脚本与完整 IOC，可用于回溯入侵活动并排查同类痕迹。","source",{"_77":103},"links",{"_96":102},"publishedAt","2026-11-05T09:53:00.000Z","discoveredAt","2026-11-06T00:05:19.128Z","timelineAt","category","activity","tags",[80,78,99,100,101,82,90],"score",82,"selected",true,"channel","news","story",{"_92":93,"_13":94},"x","readingMode","full","author","body",{"_61":95,"_96":-5,"_97":96,"_98":37},"outline",[],"relatedStories",[91],"topics",[68,69,70,71,72,73,74],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fw3qDpIBu76g","reportCount",1,"additionalSourceCount",0,{"_75":89,"_77":90},{"_75":87,"_77":88},{"_75":85,"_77":86},{"_75":83,"_77":84},{"_75":81,"_77":82},{"_75":79,"_77":80},{"_75":76,"_77":78},"slug","malware","name","恶意软件","attack","攻击活动","ai-offense","AI 攻防","black-market","数据窃取与黑产","ransomware","勒索软件","identity","身份与访问","sangfor","深信服",{"_92":93,"_13":94},"publicId","f67d1da6-a617-4831-8244-4bad3f37954e","深信服披露第三方支付机构攻击工具包","<p><span>深瞻情报实验室</span> <span>2026-11-05 17:53</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/9e9593467d60d908.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><img src=\"/dailyinfo/media/33dbe010609ca11e.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span>近期，深瞻情报实验室发现位于 91.224.92.16 的 18128 端口存在未授权可列目录。目录内完整存放着一个用于入侵某国内第三方支付机构生产环境的整套工具链，共计 91 个文件，涵盖内存马、JVM 注入器、隧道组件、Metasploit 载荷与数据窃取脚本。截至本文撰写时，该目录已无法访问。</span></p><p><span>与常见的僵尸网络面板或矿机配置泄露不同，该目录是一套针对单一目标高度定制的作业工具包：所有部署脚本内置目标内网的主机名门禁、中间件路径、内部服务地址与业务组件标识。我们对全部文件进行了纯被动抓取与离线静态分析，以下为本次监测的详细分析与研判。</span></p><p><strong><span>工具包概况</span></strong></p><p><span>工具包按功能可分为七大模块，覆盖\"初始植入—权限维持—通道建立—数据窃取\"全链路：</span></p><table><tbody><tr><td><p><b><span><span>模块</span></span></b></p></td><td><p><b><span><span>代表性文件</span></span></b></p></td><td><p><b><span><span>功能</span></span></b></p></td></tr><tr><td><p><span><span>冰蝎内存马家族</span></span></p></td><td><p><span><span>I4127b.java</span><span>、</span><span>i4127b.jsp</span><span>、</span><span>i4127b.jspx</span><span>、</span><span>Bh4127.java</span><span>、</span><span>I4411P.java</span><span>、</span><span>probe.py</span></span></p></td><td><p><span><span>AES</span><span>加密协议内存</span><span>Webshell</span><span>及探针验证链</span></span></p></td></tr><tr><td><p><span><span>蚁剑</span><span>Valve</span><span>家族</span></span></p></td><td><p><span><span>AsV2/V3/V4</span><span>、</span><span>AsV5180</span><span>、</span><span>AgentAs</span><span>系列</span></span></p></td><td><p><span><span>蚁剑协议</span><span>Tomcat Valve</span><span>内存马</span></span></p></td></tr><tr><td><p><span><span>JVM</span><span>无文件注入</span></span></p></td><td><p><span><span>Attach4127</span><span>、</span><span>Agent4127</span><span>、</span><span>Agent5180</span><span>、</span><span>AgentCmd</span></span></p></td><td><p><span><span>JDK Attach API</span><span>动态注入内存</span><span>Agent</span></span></p></td></tr><tr><td><p><span><span>隧道组件</span></span></p></td><td><p><span><span>Tun.java</span><span>、</span><span>TunKeep.java</span><span>、</span><span>tunloop.sh</span></span></p></td><td><p><span><span>反向</span><span>TCP</span><span>端口转发与保活</span></span></p></td></tr><tr><td><p><span><span>持久化载荷</span></span></p></td><td><p><span><span>met.bin</span><span>、</span><span>met.jar</span><span>、</span><span>sh.bin</span></span></p></td><td><p><span><span>Metasploit&nbsp;</span><span>双载荷与微型反向</span><span>shell</span></span></p></td></tr><tr><td><p><span><span>部署脚本（约</span><span>35</span><span>个）</span></span></p></td><td><p><span><span>i4438</span><span>～</span><span>i5180</span><span>系列、</span><span>a.sh</span><span>～</span><span>p4.sh</span></span></p></td><td><p><span><span>波次化植入、环境探测与数据窃取</span></span></p></td></tr><tr><td><p><span><span>配置与杂项</span></span></p></td><td><p><span><span>root_map.xml</span><span>、</span><span>hess_map.xml</span><span>、</span><span>man*.txt</span><span>、</span><span>i4438_id</span></span></p></td><td><p><span><span>web.xml</span><span>注入片段、</span><span>Agent</span><span>清单、</span><span>SSH</span><span>私钥</span></span></p></td></tr></tbody></table><p><img src=\"/dailyinfo/media/6187e8ade229b85e.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span>图1　开放目录中的文件列表（节选）</span></p><p><span>从时间信息看，判断活跃窗口的依据有两处：一是 met.jar 内部时间戳为 2026-09-28 05:31:48；二是脚本引用的受害机日志文件名集中在 2026-09-27 与 2026-09-28。据此，我们判断该工具包的活跃作业窗口约为 2026 年 9 月 27 日至 28 日，目录被抓取时仍在使用中，没有废弃迹象。</span></p><p><strong><span>基础设施：单点 C2 与三个低级失误</span></strong></p><p><span>全部证据指向单一攻击服务器 91.224.92.16，一台机器承担载荷分发、SSH 隧道端点、Meterpreter handler 与自写隧道回连等多类角色（脚本注释中自称\"kali\"，隧道注释中称\"operator\"）：</span></p><table><tbody><tr><td><p><b><span><span>端口</span></span></b></p></td><td><p><b><span><span>用途</span></span></b></p></td></tr><tr><td><p><span><span>18128</span></span></p></td><td><p><span><span>HTTP&nbsp;</span><span>载荷分发（本次发现的开放目录）</span></span></p></td></tr><tr><td><p><span><span>18129</span></span></p></td><td><p><span><span>SSH&nbsp;</span><span>反向隧道监听（受害机&nbsp;</span><span>8080&nbsp;</span><span>端口映射至&nbsp;</span><span>C2</span><span>）</span></span></p></td></tr><tr><td><p><span><span>18130 / 18132</span></span></p></td><td><p><span><span>自写</span><span>&nbsp;Java&nbsp;</span><span>隧道（</span><span>Tun.java</span><span>）回连端口，默认并行&nbsp;</span><span>6&nbsp;</span><span>实例</span></span></p></td></tr><tr><td><p><span><span>18140</span></span></p></td><td><p><span><span>Meterpreter handler</span><span>（</span><span>Linux x64</span><span>，</span><span>reverse_tcp</span><span>）</span></span></p></td></tr><tr><td><p><span><span>18141</span></span></p></td><td><p><span><span>Meterpreter handler</span><span>（</span><span>Java&nbsp;</span><span>版载荷）</span></span></p></td></tr><tr><td><p><span><span>18142</span></span></p></td><td><p><span><span>微型反向</span><span>&nbsp;shell</span><span>（</span><span>sh.bin</span><span>）回连端口</span></span></p></td></tr></tbody></table><p><span>该目录同时暴露了通常极难获得的三类资产：其一，C2 的 SSH 私钥——i4438_id 为 OpenSSH ed25519 私钥（注释 i4438rev），对应公钥 AAAAC3NzaC1lZDI1NTE5AAAAIOkq3TxM0sI8KgxfeSoIcQkxuUeQA1Z7h5D+3aiwgbWs ，失陷主机用它以 root 身份建立反向隧道；其二，Meterpreter 会话 UUID 2WVdxzs3Mq1L+035IUKwMA==（内嵌于 met.bin）；其三，构建信息——met.bin 未剥离且含调试信息，文件路径中保留了 Rapid7 官方 mettle 构建环境（mettle_build_gem/mettle/mettle/），说明攻击者直接使用标准 Meterpreter 构建产物，未经二次编译，也没有做免杀处理。</span></p><p><img src=\"/dailyinfo/media/56f2edb909b8130f.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span>图2　目录中暴露的 C2 SSH 私钥（正文已打码）</span></p><p><img src=\"/dailyinfo/media/3f1b1185db941b43.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span>图3　利用该私钥建立 SSH 反向隧道的脚本 i4438r.sh</span></p><p><span>从整体看，攻击者在目标侧投入较多，但基础设施相对简陋：只有一台 C2，没有备用域名，载荷未做免杀，目录没有访问控制，甚至把 SSH 私钥也放在里面。我们判断，这处设施更像是为某次任务临时准备的落脚点，长期运营的专用 C2 的可能性较低。</span></p><p><strong><span>定向攻击特征</span></strong></p><p><span>从工具包可以看出三点。第一，攻击有明确的目标清单：部署脚本内置主机名白名单与排除名单，清单外主机直接跳过，其中一类节点被 20 余个脚本反复引用，是重点目标。第二，工具按目标环境定制：针对 Tomcat 7 与 JDK 1.8 编写，预置多套 JDK 路径和 Alpine 与常规 Linux 的计划任务回退。第三，攻击者熟悉业务：直接引用 Hessian 业务路径、订单查询接口与两台 Dubbo 节点的 telnet invoke，查询前还先反编译订单组件确认字段。结合“业务探针+异常回滚”的做法，其目的是长期驻留、按需取数。</span></p><p><span>综合判断，这是一次有目标清单、有前期情报、按环境定制的定向作业。</span></p><p><strong><span>工具包分析</span></strong></p><p><img src=\"/dailyinfo/media/f856b6817b55baf9.webp\" loading=\"lazy\" decoding=\"async\"></p><p><b><span>冰蝎内存马家族（I4127b.java 等 8 个文件）</span></b></p><p><span>核心组件 I4127b.java 为编译后植入 WEB-INF/classes/ 的 Servlet，协议与冰蝎 v3 兼容：硬编码 AES-128-ECB 密钥（按目标定制的口令派生），通过加密信道接收指令并在应用进程内直接执行，执行结果加密回传；非 POST 请求一律返回 200 空响应，无任何页面特征。配套变体包括 .jsp/.jspx 落盘版（jspx 为带调试日志的排障版）与 Valve 版——后者插在 Tomcat 管道最前，把特定 URI、特定 UA（Behinder）的流量、乃至 POST 到 /hessian/* 的流量全部劫持给冰蝎处理器，借正常业务路径作隐蔽入口。</span></p><table><tbody><tr><td><p><b><span><span>文件名</span></span></b></p></td><td><p><b><span><span>功能</span></span></b></p></td><td><p><b><span><span>文件大小</span><span>bytes</span></span></b></p></td><td><p><b><span><span>MD5</span></span></b></p></td></tr><tr><td><p><span><span>I4127b.java</span></span></p></td><td><p><span><span>冰蝎协议内存马</span><span>Servlet</span><span>（</span><span>AES-ECB</span><span>）</span></span></p></td><td><p><span><span>4745</span></span></p></td><td><p><span><span>2ff4967259ae7971791b531f72782fac</span></span></p></td></tr><tr><td><p><span><span>i4127b.jsp</span></span></p></td><td><p><span><span>双功能</span><span>JSP</span><span>马（蚁剑类加载</span><span>+</span><span>裸命令）</span></span></p></td><td><p><span><span>971</span></span></p></td><td><p><span><span>d5db1dc58c452b7cf8adfc6b74113bd8</span></span></p></td></tr><tr><td><p><span><span>i4127b.jspx</span></span></p></td><td><p><span><span>带调试日志的</span><span>JSPX</span><span>版冰蝎马</span></span></p></td><td><p><span><span>2491</span></span></p></td><td><p><span><span>3e73da3ff3a06e37884873034d702705</span></span></p></td></tr><tr><td><p><span><span>Bh4127.java</span></span></p></td><td><p><span><span>冰蝎前端</span><span>Valve</span><span>（劫持</span><span>hessian</span><span>流量）</span></span></p></td><td><p><span><span>1272</span></span></p></td><td><p><span><span>41ec5c0858bfa99356783e295d686eef</span></span></p></td></tr><tr><td><p><span><span>I4411P.java</span></span></p></td><td><p><span><span>上线自检探针类</span></span></p></td><td><p><span><span>1484</span></span></p></td><td><p><span><span>f5ee87168d7d87462e5f9a709f822eb4</span></span></p></td></tr><tr><td><p><span><span>probe.py</span></span></p></td><td><p><span><span>AES</span><span>加密验证器（内置密钥断言）</span></span></p></td><td><p><span><span>1843</span></span></p></td><td><p><span><span>ed34acf5e4edbd471ce6af2fb4bdb12c</span></span></p></td></tr></tbody></table><p><img src=\"/dailyinfo/media/565261d7e6a1d80a.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span>图4　冰蝎内存马 I4127b.java 中硬编码的 AES 密钥</span></p><p><img src=\"/dailyinfo/media/f2d1aae63e7a80da.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span>图5　验证脚本 probe.py 的密钥派生与断言（口令已打码）</span></p><p><img src=\"/dailyinfo/media/8ea412f3c1dfec66.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>蚁剑 Valve 家族（AsV2/V3/V4/As5180 等 14 个文件）</span></strong></p><p><span>四个迭代版本均为 Valve 形态，协议为蚁剑 base64 类加载（特征串 yv66vg，即 base64 的 .class 魔数 cafebabe）。版本迭代可见攻击者对兼容性的持续改进：V3 起记录命中审计日志，V4 引入独立类加载器规避同名类冲突，均使用空 Servlet 伪造 JSP PageContext 提高 payload 兼容性。与冰蝎家族并列，构成\"双客户端冗余\"。</span></p><p><img src=\"/dailyinfo/media/c499f8a9319e4b1a.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>JVM Attach 无文件注入</span></strong></p><p><span>当落盘文件可能被完整性巡检发现时，攻击者切换至纯内存注入：通过 JDK Attach API 向运行中的 Tomcat 进程动态加载 Agent，在内存中注册请求处理组件，实现不落盘驻留。磁盘仅残留 /tmp 临时文件，应用目录零改动；组件随进程重启失效，客观上降低了被巡检发现的概率。</span></p><table><tbody><tr><td><p><b><span><span>文件名</span></span></b></p></td><td><p><b><span><span>功能</span></span></b></p></td><td><p><b><span><span>文件大小</span><span>bytes</span></span></b></p></td><td><p><span><span>MD5</span></span></p></td></tr><tr><td><p><span><span>Attach4127.java</span></span></p></td><td><p><span><span>Attach API&nbsp;</span><span>附加器</span></span></p></td><td><p><span><span>379</span></span></p></td><td><p><span><span>ade50b5d5f9530ed10e83da1871d0a40</span></span></p></td></tr><tr><td><p><span><span>Agent4127.java</span></span></p></td><td><p><span><span>注入</span><span>Cmd4127+Valve4127</span><span>（双路径</span><span>Context</span><span>定位）</span></span></p></td><td><p><span><span>7935</span></span></p></td><td><p><span><span>f8b8267a094caeefe3e52773a68365a0</span></span></p></td></tr><tr><td><p><span><span>Agent5180.java</span></span></p></td><td><p><span><span>注入</span><span>Bh4127</span><span>冰蝎</span><span>Valve</span><span>（三层管道）</span></span></p></td><td><p><span><span>7949</span></span></p></td><td><p><span><span>20b07f4687a1e19c08fc40b587237bc6</span></span></p></td></tr><tr><td><p><span><span>AgentCmd.java</span></span></p></td><td><p><span><span>注入</span><span>CmdV5180</span><span>命令</span><span>Valve</span><span>（管道首插入）</span></span></p></td><td><p><span><span>5971</span></span></p></td><td><p><span><span>e75d326a7b79fd91938878ddc1679f2d</span></span></p></td></tr><tr><td><p><span><span>AgentAs&nbsp;</span><span>系列</span><span>×4</span></span></p></td><td><p><span><span>注入蚁剑</span><span>Valve</span><span>四代迭代</span></span></p></td><td><p><span><span>5968-6183</span></span></p></td><td><p><span><span>8803056b85ecc6b23a620443e51fda2c / 2f2731a5e321bb6bde4176d8fd66318f / 49edeb4746c13fca75b8d934ddc14e3f / 3f0c33c65e709412a6bd5ab993693971</span></span></p></td></tr></tbody></table><p><img src=\"/dailyinfo/media/f8e1a4c6585e3d00.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>隧道组件与持久化</span></strong></p><p><span>Tun.java（43 行纯 JDK 实现）为反向端口转发器：向 C2 发起出站 TCP 连接，将 C2 指令流与受害机本地 8080 双向转发；默认并行 6 实例，后期配看门狗进程保活。与 SSH 反向隧道并用，构成至少三条相互独立的回连通道——单点封堵无法断联。</span></p><p><span>met.bin 为 Linux x64 Meterpreter（mettle 实现）：静态链接、未剥离、含调试信息，内嵌回连配置 tcp://91.224.92.16:18140 与会话 UUID。met.jar 为完整的 Java 版 Meterpreter 载荷（含 Payload.class，LPORT=18141，内部时间戳 2026-09-28 05:31:48），与原生 ELF 互为冗余。持久化终版脚本 i5180p.sh 的设计比较周密：载荷落地到隐蔽临时目录（/tmp 不可写时自动退到 /dev/shm），写入每分钟执行一次的计划任务，runner 通过进程探测保证双载荷至少一个存活，再叠加秒级轮询看门狗双层保活。计划任务路径为 Alpine/BusyBox 风格，说明目标或跳板中存在 Alpine 容器，攻击者针对不同系统环境做了适配。</span></p><p><img src=\"/dailyinfo/media/67e0e624b9d183dc.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span>图6　met.bin 的文件类型识别结果</span></p><p><img src=\"/dailyinfo/media/e0a983a60132ac0e.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span>图7　met.bin 内嵌的 Meterpreter 回连配置</span></p><p><span>另外目录中还有一个 194 字节的 sh.bin，为手写的 x86-64 反向 shell，功能仅为回连 91.224.92.16:18142 并获取交互式 shell，作为最小后门备用。</span></p><table><tbody><tr><td><p><b><span><span>文件名</span></span></b></p></td><td><p><b><span><span>功能</span></span></b></p></td><td><p><b><span><span>文件大小</span><span>bytes</span></span></b></p></td><td><p><span><span>MD5</span></span></p></td></tr><tr><td><p><span><span>Tun.java</span></span></p></td><td><p><span><span>反向</span><span>TCP</span><span>端口转发器</span></span></p></td><td><p><span><span>1609</span></span></p></td><td><p><span><span>15c05027d2e773b834b5c2a2a7b7254a</span></span></p></td></tr><tr><td><p><span><span>TunKeep.java</span></span></p></td><td><p><span><span>隧道看门狗（</span><span>800ms</span><span>重连）</span></span></p></td><td><p><span><span>227</span></span></p></td><td><p><span><span>e9dbf05381ae2cfd53c02f2254afbd9a</span></span></p></td></tr><tr><td><p><span><span>met.bin</span></span></p></td><td><p><span><span>Linux x64 Meterpreter</span><span>（回连</span><span>18140</span><span>）</span></span></p></td><td><p><span><span>1138480</span></span></p></td><td><p><span><span>652fca1b1dc6f1fdcfaf5c0fd2a67977</span></span></p></td></tr><tr><td><p><span><span>met.jar</span></span></p></td><td><p><span><span>Java</span><span>版</span><span>Meterpreter</span><span>完整载荷（回连</span><span>18141</span><span>）</span></span></p></td><td><p><span><span>5263</span></span></p></td><td><p><span><span>9893b75467166ac962c12b26e5e96a4f</span></span></p></td></tr><tr><td><p><span><span>sh.bin</span></span></p></td><td><p><span><span>194</span><span>字节</span><span>ELF</span><span>反向</span><span>shell</span><span>（回连</span><span>18142</span><span>）</span></span></p></td><td><p><span><span>194</span></span></p></td><td><p><span><span>d549956808eaa8c3d6c30e9417eff8d9</span></span></p></td></tr><tr><td><p><span><span>i5180p.sh</span></span></p></td><td><p><span><span>持久化落地方案（</span><span>cron+</span><span>看门狗）</span></span></p></td><td><p><span><span>1256</span></span></p></td><td><p><span><span>30fd447e872ac70afbfa6e1810f65b9f</span></span></p></td></tr></tbody></table><p><img src=\"/dailyinfo/media/e01f17d650500613.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>web.xml 修改与回滚机制</span></strong></p><p><span>落盘植入均伴随对应用配置的修改：向 web.xml 注入 servlet 映射，把命令入口藏在 Hessian 业务路径下。后期版本形成完整的\"备份—校验—回滚\"流程：修改前自动备份，修改后校验 XML 合法性，正常业务端点一旦异常即恢复备份。攻击者刻意维持业务外观正常的意图非常明确——避免业务异常引起运维人员注意。</span></p><p><img src=\"/dailyinfo/media/e0a737eea99ac79e.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span>图8　web.xml 修改后的校验与回滚逻辑（i5017d.sh 第 33-77 行）</span></p><p><img src=\"/dailyinfo/media/aafe270fd08f99f5.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span>图9　攻击者准备的 servlet 映射片段（hess_map.xml）</span></p><p><strong><span>数据窃取：目的不止于数据</span></strong></p><p><span>接口侦察：反编译受害机自身的订单组件，枚举 DTO getter，筛选条件为 Card/Cvv/Cvn/Pan/Account/Bank/Payer 等字段族——先确认数据模型里有什么，再决定偷什么。随后利用 Dubbo telnet invoke 未授权调用个人订单查询接口：时间窗覆盖 2019 年初至 2026 年 9 月末的全部历史，固定对 3 个重点商户客户号执行，并细分\"近 7 天 + 开户日当周\"窗口持续追踪新交易。查询结果落盘后立即结构化提取订单号、付款人银行账号、户名、卡号、CVV、PAN 等敏感要素，并以 awk 过滤堆栈行、只保留数据行，说明攻击者是按真实接口的返回格式来做数据处理的。</span></p><table><tbody><tr><td><p><b><span><span>文件名</span></span></b></p></td><td><p><b><span><span>功能</span></span></b></p></td><td><p><b><span><span>文件大小</span><span>bytes</span></span></b></p></td><td><p><span><span>MD5</span></span></p></td></tr><tr><td><p><span><span>a.sh</span></span></p></td><td><p><span><span>wave A</span><span>：全历史订单批量查询</span><span>+</span><span>字段收割</span></span></p></td><td><p><span><span>1965</span></span></p></td><td><p><span><span>07ac95e285deef1d8a6f92923267dc74</span></span></p></td></tr><tr><td><p><span><span>b.sh</span></span></p></td><td><p><span><span>wave B</span><span>：分时间窗持续追踪</span></span></p></td><td><p><span><span>1934</span></span></p></td><td><p><span><span>5fdab738c7d43fcc8683442ec325c439</span></span></p></td></tr><tr><td><p><span><span>p2.sh</span></span></p></td><td><p><span><span>DTO</span><span>反汇编侦察</span><span>+</span><span>日志痕迹核对</span></span></p></td><td><p><span><span>1742</span></span></p></td><td><p><span><span>e98b77307b2dd3d649924e62437641ed</span></span></p></td></tr><tr><td><p><span><span>p3.sh</span></span></p></td><td><p><span><span>商户私钥复制</span><span>+</span><span>接口参数试探</span></span></p></td><td><p><span><span>1591</span></span></p></td><td><p><span><span>a3fad63946d4977b4aedd323d6a7b29e</span></span></p></td></tr><tr><td><p><span><span>p4.sh</span></span></p></td><td><p><span><span>单发探测版查询</span></span></p></td><td><p><span><span>745</span></span></p></td><td><p><span><span>2e923803ce43146d8a0bb920a970864e</span></span></p></td></tr></tbody></table><p><span>其中最需要关注的是商户私钥窃取：脚本包含将商户 RSA 私钥复制到临时目录的指令（同时复制平台公钥并校验文件格式完整性）。私钥外泄意味着可离线伪造该商户交易签名。此外，攻击者还在受害机访问日志与监控日志中检索 8 个客户号/单号，确认查询行为与数据落点。</span></p><p><img src=\"/dailyinfo/media/96dc31e3642dacad.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span>图10　订单结果的敏感字段提取逻辑（a.sh 第 48-51 行）</span></p><p><img src=\"/dailyinfo/media/1cc5445a01cd0e32.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span>图11　商户私钥复制指令（p3.sh 第 22-26 行，路径已打码）</span></p><p><span>卡号/CVV/PAN 与商户私钥同时出现在目标清单中，这一点需要重点关注。我们倾向于认为，攻击者的目标可能不止于窃取数据，还指向以真实商户身份发起的伪冒交易与资金变现。工具链呈现的目标选择、字段筛选与时间窗设计，已经构成明确的窃取意图与行为能力证据。</span></p><p><strong><span>作业特征与团队画像</span></strong></p><p><span>综合全部部署脚本与源码（共 42 个 shell 脚本），我们发现其AI辅助编码痕迹明显，作业特征如下：</span></p><ul><li><p><span>波次化迭代：脚本编号 i4438→i5180 呈完整演进链（独立Context→配置修改→JSPX落盘→JVM注入→远控持久化），每版针对上一版失败修正；</span></p></li></ul><ul><li><p><span>失败经验制度化：注释中以 fact# 编号记录教训（如某项配置残留导致正常业务端点失效、某文本处理工具损坏配置文件后被明令禁用），把失败教训写入了标准作业流程；</span></p></li></ul><ul><li><p><span>业务存活优先：以正常业务端点为探针，异常即回滚备份——把\"不被发现\"放在\"功能达成\"同等地位；</span></p></li></ul><ul><li><p><span>防并发与幂等：目录锁、旧进程清理、映射已存在即跳过；</span></p></li></ul><ul><li><p><span>环境自适应：多 JDK 路径回退、多解释器探测、Alpine 与常规 Linux 计划任务路径差异处理。</span></p></li></ul><p><span>文本取证层面存在多组 AI 辅助编码的指示性信号：注释中出现中文圈码序号（①）与英文\"约束清单式\"注释（如 \"NO awk, NO ROOT.xml, NEVER touch web.xml\"），在全部部署脚本中，错误处理、路径回退、语义化状态码等防御性写法高度统一——这更像是把任务需求与约束提交给代码生成模型后的产出。我们可以判断其模式为\"人工主导、AI 辅助\"。</span></p><p><img src=\"/dailyinfo/media/0975690cdf2cfc24.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span>图12　脚本注释中的失败经验记录（i4585d.sh）</span></p><p><img src=\"/dailyinfo/media/da140f35f3c311ee.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span>图13　约束清单式注释（i5017m.sh）</span></p><p><strong><span>总结</span></strong></p><p><span>本次攻击综合了开放目录工具包反查所得的多项手法：针对目标环境定制的冰蝎与蚁剑双套内存马、JVM 无文件注入、Meterpreter 持久化，以及利用 Dubbo 未授权调用批量查询订单数据并尝试窃取商户私钥，各环节均以不影响业务为前提，整体呈现前期情报充分、目标明确的定向作业特征。</span></p><p><strong><span>了解更多</span></strong></p><p><span>深信服深瞻情报实验室持续紧跟国内外高级威胁事件，从中筛选出能给用户带来威胁的事件，第一时间推送解决方案，持续提供可感知的安全感。在这场永不停歇的攻防战争中，深信服深瞻情报实验室掌握一手威胁情报，坚持“千里之外，洞悉风险”，与各大网络安全厂商一同维护网络安全，构建平衡、和谐的网络生态系统。</span></p><p><img src=\"/dailyinfo/media/75a04bd3b5733910.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>IOC</span></strong></p><table><tbody><tr><td><p><b><span><span>类型</span></span></b></p></td><td><p><b><span><span>值</span></span></b></p></td></tr><tr><td><p><span><span>C2&nbsp;</span><span>地址</span></span></p></td><td><p><span><span>91.224.92.16</span><span>（端口&nbsp;</span><span>18128/18129/18130/18132/18140/18141/18142</span><span>）</span></span></p></td></tr><tr><td><p><span><span>冰蝎</span><span>&nbsp;AES&nbsp;</span><span>密钥</span></span></p></td><td><p><span><span>013b76b9a98a7648</span></span></p></td></tr><tr><td><p><span><span>冰蝎</span><span>&nbsp;UA / session</span></span></p></td><td><p><span><span>Behinder</span><span>；</span><span>session&nbsp;</span><span>属性&nbsp;</span><span>o / u / response</span></span></p></td></tr><tr><td><p><span><span>蚁剑特征</span></span></p></td><td><p><span><span>yv66vg</span><span>；密码门参数&nbsp;</span><span>k=i4127</span><span>；命令参数&nbsp;</span><span>cmd=</span></span></p></td></tr><tr><td><p><span><span>Meterpreter UUID</span></span></p></td><td><p><span><span>2WVdxzs3Mq1L+035IUKwMA==</span></span></p></td></tr><tr><td><p><span><span>SSH&nbsp;</span><span>公钥</span></span></p></td><td><p><span><span>AAAAC3NzaC1lZDI1NTE5AAAAIOkq3TxM0sI8KgxfeSoIcQkxuUeQA1Z7h5D+3aiwgbWs</span><span>（</span><span>i4438rev</span><span>）</span></span></p></td></tr><tr><td><p><span><span>植入</span><span>&nbsp;URI</span></span></p></td><td><p><span><span>/i4127b</span><span>、</span><span>/i4127b.jsp</span><span>、</span><span>/i4127b.jspx</span><span>、</span><span>/i5180ms</span><span>、</span><span>/i4127bh</span><span>、</span><span>/hessian/i4127.jsp</span><span>、</span><span>/hessian/cmd</span></span></p></td></tr><tr><td><p><span><span>持久化路径</span></span></p></td><td><p><span><span>/tmp/.i5180/{m,j,s,r}</span><span>、</span><span>/dev/shm/.i5180/</span></span></p></td></tr><tr><td><p><span><span>工具痕迹</span></span></p></td><td><p><span><span>/tmp/Tun.class</span><span>、</span><span>/tmp/a4127/</span><span>、</span><span>/tmp/a5180*/</span><span>、</span><span>/tmp/i5123a.out</span><span>、</span><span>/tmp/yx_priv.pem</span><span>、</span><span>/tmp/asv3.hit</span></span></p></td></tr><tr><td><p><span><span>配置备份特征</span></span></p></td><td><p><span><span>web.xml.bak.i444x/.i4556/.i4562/.i4583/.i4585/.i5017</span></span></p></td></tr><tr><td><p><span><span>计划任务</span></span></p></td><td><p><span><span>* * * * * /bin/sh /tmp/.i5180/r</span><span>（</span><span>/etc/crontabs/root</span><span>）</span></span></p></td></tr><tr><td><p><span><span>关键文件哈希</span></span></p></td><td><p><span><span>met.bin: 652fca1b1dc6f1fdcfaf5c0fd2a67977</span><span>；</span><span>met.jar: 9893b75467166ac962c12b26e5e96a4f</span><span>；</span><span>sh.bin: d549956808eaa8c3d6c30e9417eff8d9</span></span></p></td></tr><tr><td><p><span><span>补充载荷</span></span></p></td><td><p><span><span>sh.bin&nbsp;</span><span>为&nbsp;</span><span>194&nbsp;</span><span>字节&nbsp;</span><span>ELF&nbsp;</span><span>反向&nbsp;</span><span>shell</span><span>，回连&nbsp;</span><span>18142</span><span>，由持久化脚本下载备用</span></span></p></td></tr></tbody></table><p><img src=\"/dailyinfo/media/a59556526d4f1471.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=6e95170e&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzg2NjgzNjA5NQ%3D%3D%26mid%3D2247526358%26idx%3D2%26sn%3Dec2dc65ec3b9c03bfb8689c7ce09e59c\">跳转微信打开</a></p>","original","zhKind","complete","后门","数据窃取","凭据","https://mp.weixin.qq.com/s?__biz=Mzg2NjgzNjA5NQ==&mid=2247526358&idx=2&sn=ec2dc65ec3b9c03bfb8689c7ce09e59c","深信服千里目安全实验室",{"_105":106,"_107":-5},"changelogVersion","2026-10-01T08:00","release"]
