[{"_1":2,"_3":4},"root",{"_5":105},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795480834000,"id","dw4eyb7t4jy3oa0umleioh8vo","title","Microsoft Azure API Management Classic 漏洞已被利用窃取 API 凭据","originalTitle","Microsoft Azure flaw exploited to steal customers' API credentials","summary","Microsoft Azure API Management Classic 层级漏洞已被用于窃取客户 API 凭据，未按推荐安全最佳实践配置的实例可被未授权访问管理功能。","reason","source",{"_75":104},"links",{"_61":103},"publishedAt","2026-11-23T19:42:20.000Z","discoveredAt","2026-11-23T20:07:32.213Z","timelineAt","category","vuln","tags",[98,76,99,100,101,102],"score",84,"selected",false,"channel","news","story",{"_85":86,"_13":87},"x","readingMode","full","author","Lawrence Abrams","body",{"_94":-5,"_61":95,"_96":-5,"_97":36},"outline",[88],"relatedStories",[84],"topics",[68,69,70,71,72],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fUXoa9Bh5o4A","reportCount",1,"additionalSourceCount",0,{"_73":82,"_75":83},{"_73":80,"_75":81},{"_73":78,"_75":79},{"_73":30,"_75":77},{"_73":74,"_75":76},"slug","exploited","name","在野利用","漏洞披露","identity","身份与访问","cloud-native","云与原生","microsoft","Microsoft / 微软",{"_85":86,"_13":87},"publicId","ac3a8aba-a3ef-4a7e-a4a3-1236e9441fe5","微软修复Azure API Management Classic漏洞",{"_11":89,"_90":91,"_92":93},"sec-1","text","Uncover email threats your existing defenses may miss.","level",2,"zh","<p><img alt=\"Microsoft\" height=\"900\" src=\"/dailyinfo/media/d8febc8667d8fe64.jpg\" srcset=\"/dailyinfo/media/3821712b317d6e60.jpg 720w, /dailyinfo/media/e7f9219ea0288e1f.jpg 1200w, /dailyinfo/media/d8febc8667d8fe64.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>Microsoft is warning customers that a security vulnerability in Azure API Management (APIM) Classic tiers was exploited to steal stored API credentials, with Norwegian authorities linking the flaw to cyberattacks against energy companies.</p><p>Azure API Management is a cloud service that lets organizations publish, secure, monitor, and manage APIs that connect applications, services, and data.</p><p>In an Azure Service Health security advisory (Tracking ID: MZK9-GH0) sent to customers and shared with BleepingComputer, Microsoft said it identified the vulnerability on November 18, 2026, and deployed a mitigation the following day.</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/ec0400265c732eea.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>\"Our investigation found that customers were exposed and an unauthorized party could have used the issue to access secrets stored in Azure API Management Classic instances before Microsoft identified the security issue,\" Microsoft said in the advisory.</p><p>According to Microsoft, the vulnerability allowed unauthorized access to certain management functionality when APIM Classic instances were not configured according to recommended security best practices.</p><p>This access could have allowed attackers to perform administrative operations, including accessing secrets stored in the service.</p><p>Microsoft said the following information may have been exposed:</p><ul>\n\t<li>Secrets stored in Named Values</li>\n\t<li>Client secrets associated with identity providers</li>\n\t<li>Client secrets associated with OpenID Connect providers</li>\n\t<li>Subscription keys</li>\n\t<li>Tokens used to call direct management APIs</li>\n</ul><p>These credentials could potentially allow attackers to access additional applications, services, or backend systems, depending on their permissions.</p><p>Microsoft said it closed the unauthorized access path on November 19 and rotated Microsoft-controlled keys and credentials where appropriate.</p><p>However, the company warned that its remediation would not invalidate customer credentials that may have been compromised before the fix was deployed.</p><p>\"This remediation blocks the unauthorized management-plane access path that could allow an actor to perform administrative operations, including secrets management, against Azure API Management services,\" Microsoft warned.</p><p>\"However, it does not automatically invalidate credentials that may have been accessed before the fix was deployed.\"</p><p>The vulnerability affects Azure API Management Classic tiers, while Microsoft said APIM v2 tiers are not impacted.</p><p>Microsoft urged affected customers to immediately rotate potentially exposed credentials, investigate suspicious activity in systems accessible through those credentials, and review available logs for signs of unauthorized access.</p><p>In a <a href=\"https://www.reddit.com/r/sysadmin/comments/1y2n689/critical_security_advisory_affecting_apim/\">Reddit post</a>, an administrator claimed their organization discovered the vulnerability after detecting unauthorized access to Azure Key Vault using a valid administrator token.</p><p>\"Our company has been fighting this for days, after discovering that someone logged into our keyvaults using a valid administrator token and not following the normal access pattern,\" the administrator claimed.</p><p>The administrator alleged that attackers exploited a zero-day authentication bypass in a deprecated legacy API to gain access to a privileged system account on APIM instances.</p><p>According to the administrator, the legacy API did not generate logs that customers could use to detect the unauthorized access. They also alleged that Microsoft initially attributed the suspicious activity to leaked customer credentials before deploying a global fix.</p><p>BleepingComputer has not independently verified these allegations.</p><p>The vulnerability has also been linked to attacks affecting Norwegian organizations, including energy companies Equinor and Skagerak Energi.</p><p>In a <a href=\"https://nsm.no/aktuelt/nsm-deler-tiltak-mot-sarbarhet-i-azure-api-management\">security advisory</a>, Norway's National Security Authority (NSM) said an unknown threat actor targeted access tokens, secrets, and named values stored in Azure API Management.</p><p>The agency said Norway's energy sector first discovered the vulnerability and that organizations in other countries and industries were also affected.</p><p>Equinor <a href=\"http://www.equinor.com/news/20261711-equinor-detected-cyber-attack\">disclosed</a> an ongoing cyberattack on November 17, a day before Microsoft says it identified the APIM vulnerability. The company later announced that it had stopped the attack and found no indication that data had been stolen or altered.</p><p>Skagerak Energi <a href=\"http://www.skagerakenergi.no/presse/pressemeldinger/oppdatering-pa-forsok-pa-cyberangrep\">also reported</a> an attempted cyberattack but said it had no impact on its operations and no evidence that information was compromised.</p><p>While Microsoft says it deployed a remediation on November 19 that required no customer action, NSM's advisory warns organizations to verify that their APIM instances have received the security update.</p><p>The agency warns that instances running below specific runtime versions remain vulnerable and advises customers to contact their \"service provider\" if they have not received the update.</p><p>It is unclear whether the runtime updates are separate from Microsoft's initial mitigation.</p><p>Cloud security researcher Anders Kristiansen <a href=\"https://anderskristiansen.com/post/2026/apim-legacy-access/?utm_source=chatgpt.com\">shared threat-hunting queries</a> to help organizations investigate potential exploitation and identify credentials stored in their APIM instances.</p><p>BleepingComputer contacted Microsoft with questions about the attacks but has not received a reply yet.</p><p>This&nbsp;Azure API Management incident comes just days after Microsoft <a href=\"https://www.bleepingcomputer.com/news/security/microsoft-entra-connect-health-flaw-exploited-to-steal-tenant-data/\">confirmed another security breach</a> involving its Entra Connect Health service, where attackers exploited a vulnerability to steal tenant configuration information and administrator email addresses.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/af2e1e4209b93434.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Uncover email threats your existing defenses may miss.</a>\n        </h2><p>Adaptive Security's AI agents analyze email intent, context, and behavior to uncover phishing, business email compromise, and invoice fraud.</p><p>See what's getting through with a 14-day read-only scan of Microsoft 365 or Google Workspace, with no MX changes.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Start your free email security scan.</a>\n    </p>","zhKind","complete","漏洞","补丁","凭据","云原生","Microsoft","https://www.bleepingcomputer.com/news/security/microsoft-azure-flaw-exploited-to-steal-customers-api-credentials/","BleepingComputer",{"_106":107,"_108":-5},"changelogVersion","2026-10-01T08:00","release"]
