[{"_1":2,"_3":4},"root",{"_5":94},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1793672469000,"id","webolw7fw2041op34t7x6m1dm","title","Abrigo 因疑似网络攻击停用 Sageworks，借款人功能仍未恢复","originalTitle","Fintech platform Sageworks taken offline after suspected cyberattack","summary","金融科技公司 Abrigo 因环境异常将风险管理应用 Sageworks 下线，服务中断持续至周末，受影响服务包括 Online Portal Now、Sageworks Analyst 和 Sageworks API，目前多数功能已恢复，但面向借款人的功能仍未恢复。","reason","source",{"_72":93},"links",{"_61":92},"publishedAt","2026-11-02T19:00:45.000Z","discoveredAt","2026-11-02T19:04:33.232Z","timelineAt","category","activity","tags",[73,90,91],"score",63,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","readingMode","full","author","Bill Toulas","body",{"_86":-5,"_61":87,"_88":-5,"_89":36},"outline",[80],"relatedStories",[76],"topics",[68,69],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fgGnM1-bcqeQ","reportCount",1,"additionalSourceCount",0,{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","attack","name","攻击活动","supply-chain","供应链安全",{"_77":78,"_13":79},"publicId","a4446283-c3f4-4040-962e-9b42ce0f50e5","Abrigo因疑似攻击停用Sageworks",{"_11":81,"_82":83,"_84":85},"sec-1","text","Uncover email threats your existing defenses may miss.","level",2,"zh","<p><img alt=\"Fintech platform Sageworks taken offline after suspected cyberattack\" height=\"900\" src=\"/dailyinfo/media/71561647899ab621.jpg\" srcset=\"/dailyinfo/media/206743b64d172c5c.jpg 720w, /dailyinfo/media/4dde1f0f54da7cbf.jpg 1200w, /dailyinfo/media/71561647899ab621.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>Financial technology company Abrigo has restored its Sageworks risk management application, except for borrower-facing capabilities, following an outage triggered by \"irregular activity\" in its environment.</p><p>On October 30, the company began emergency maintenance and took the Sageworks application offline to investigate suspicious activity detected earlier that day, with the outage continuing through the weekend.</p><p>Abrigo provides cloud-based software and analytics solutions for community banks and credit unions across the United States. According to the company, it serves <a href=\"https://www.abrigo.com/company/\">more than&nbsp;2,400 entities</a>.</p><p><a href=\"https://www.wiz.io/lp/ai-security-starter-pack?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Security-Starter-Kit&amp;sfcid=701Vh00000cn7aRIAQ&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AI-Security-Bundle\"><img src=\"/dailyinfo/media/0d7fcec43838a1e8.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>Its Sageworks product is a <a href=\"https://developer.abrigo.com/docs/welcome\">software platform</a> that helps lenders process loan applications, analyze borrowers’ finances, assess creditworthiness, and monitor loan portfolios.</p><p>Due to its nature, Sageworks handles sensitive information, including banking customer details.</p><p>\"We identified irregular activity in our environment, and, out of abundance of caution, we disabled the Sageworks application at approximately 11:25 am ET,\" the company said on Friday.</p><p>In status updates over the weekend, Abrigo said its investigation was ongoing but did not disclose details about the nature of the incident.</p><p>The incident impacted the following services: Online Portal Now, Sageworks Analyst, and Sageworks API.</p><p>In its latest update today, the company said that most of the Sageworks functionality had been restored, with the exception of borrower-facing features.</p><p>BleepingComputer reached out to Abrigo for more details, but we have not received a response by publication time. Until the nature of the incident is disclosed, it is unclear if the outage was caused by a breach or a technical issue.</p><p>Earlier this year, someone allegedly part of the ShinyHunters extortion group claimed an attack on Abrigo, saying that they stole 1.7 million Salesforce records containing personally identifiable information and various internal corporate data.</p><p>The threat actor said at the time that they exfiltrated full names, email addresses, phone numbers, employee and account data.</p><p>Although a data breach has not been confirmed, some cybersecurity researchers advised banks and credit unions using Abrigo's solutions to rotate the API keys for the Sageworks platform.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/3e0af1aa7fd35e6a.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Uncover email threats your existing defenses may miss.</a>\n        </h2><p>Adaptive Security's AI agents analyze email intent, context, and behavior to uncover phishing, business email compromise, and invoice fraud.</p><p>See what's getting through with a 14-day read-only scan of Microsoft 365 or Google Workspace, with no MX changes.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Start your free email security scan.</a>\n    </p>","zhKind","complete","数据泄露","供应链","https://www.bleepingcomputer.com/news/security/fintech-platform-sageworks-taken-offline-after-suspected-cyberattack/","BleepingComputer",{"_95":96,"_97":-5},"changelogVersion","2026-10-01T08:00","release"]
