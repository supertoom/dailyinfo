[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795048831000,"id","fmftr6pxb7e7t1dgklubuohc3","title","ALTCHA PHP v2 存在 HMAC 签名校验绕过漏洞","originalTitle","ALTCHA PHP: verifySolution bypasses HMAC signature check when challenge signature is absent","summary","ALTCHA PHP 的 verifySolution 方法在 challenge payload 缺少 signature 字段时会跳过 HMAC 签名校验，即使已配置 hmacSignatureSecret，攻击者也可移除 signature 键并自行签发低难度 challenge，轻易求解后使验证结果为真，影响采用推荐生产配置的部署。修复方式为在配置密钥时显式拒绝缺少签名的请求。","reason","source",{"_68":78},"links",{"_59":77},"publishedAt","2026-11-18T20:48:18.000Z","discoveredAt","2026-11-18T20:58:33.352Z","timelineAt","category","vuln","tags",[74,75,76],"score",50,"selected",false,"channel","news","story",{"_71":72,"_13":73},"x","readingMode","full","author","body","outline",[],"relatedStories",[70],"topics",[66],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fdcI-Oyi0_No","reportCount",1,"additionalSourceCount",0,{"_67":30,"_68":69},"slug","name","漏洞披露",{"_71":72,"_13":73},"publicId","59745b15-6bda-4876-b562-fbefb17e1c88","ALTCHA PHP v2 签名校验绕过已修复","漏洞","复现","漏洞利用","https://github.com/advisories/GHSA-82w8-65qw-gch6","GitHub 安全公告",{"_80":81,"_82":-5},"changelogVersion","2026-10-01T08:00","release"]
