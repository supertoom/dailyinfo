[{"_1":2,"_3":4},"root",{"_5":87},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795653635000,"id","ay3qq7ilurk4uggi3sk6nfuer","title","F5 修复 NGINX HTTP/2 堆缓冲区溢出高危漏洞","originalTitle","工信部漏洞平台：关于防范NGINX堆缓冲区溢出高危漏洞的风险提示","summary","工业和信息化部网络安全威胁和漏洞信息共享平台（NVDB）提示，NGINX 因处理 HTTP/2 协议流量控制窗口时的设计缺陷，存在堆缓冲区溢出高危漏洞。攻击者向启用 HTTP/2 协议的服务器发送特制流量后，可能造成服务崩溃、内存破坏或 RCE。","reason","原文列明受影响版本、HTTP/2 利用条件与补丁状态，便于相关用户快速核对资产范围并安排升级。","source",{"_72":86},"links",{"_80":85},"publishedAt","2026-11-24T02:14:40.871Z","discoveredAt","2026-11-24T02:48:40.882Z","timelineAt","category","vuln","tags",[83,84,73],"score",73,"selected",true,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","body",{"_61":79,"_80":-5,"_81":80,"_82":37},"outline",[],"relatedStories",[75],"topics",[68,69],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","f5WJrX7tSQu0","reportCount",1,"additionalSourceCount",0,{"_70":31,"_72":74},{"_70":71,"_72":73},"slug","exploited","name","在野利用","漏洞披露",{"_76":77,"_13":78},"publicId","b955541b-3a45-4c32-8c17-cae4a23f3fbc","NGINX HTTP/2堆缓冲区溢出漏洞已修复","<p>近日，工业和信息化部网络安全威胁和漏洞信息共享平台（NVDB）监测发现，NGINX存在堆缓冲区溢出高危漏洞，危害严重。</p><p>NGINX是美国F5公司维护的开源Web服务器与反向代理软件，广泛用于Web服务部署、负载均衡及邮件代理等场景。由于其处理HTTP/2协议流量控制窗口时存在设计缺陷，攻击者可通过向启用HTTP/2协议的服务器发送特制流量，导致堆缓冲区溢出，甚至可能造成服务崩溃、内存破坏或远程代码执行等危害。受影响版本包括：NGINX开源版1.9.5≤ver≤1.30.6、1.31.0≤ver≤1.31.8；NGINX Plus 37.0.0≤ver≤37.0.7.1、37.1.0≤ver≤37.2.0.1、R34≤ver≤R36；部分内嵌NGINX核心组件产品（如NGINX Instance Manager、NGINX Ingress Controller等）也受该漏洞影响。</p><p>目前，F5公司已修复漏洞并发布安全公告（URL链接：https://my.f5.com/manage/s/article/K000163926）。建议相关单位和用户立即开展全面排查，及时升级至最新安全版本，消除网络安全隐患。</p><p>声明：本文来自网络安全威胁和漏洞信息共享平台，版权归作者所有。文章内容仅代表作者独立观点，不代表安全内参立场，转载目的在于传递更多信息。如有侵权，请联系 anquanneican@163.com。</p>","original","zhKind","complete","漏洞","补丁","https://www.secrss.com/articles/95940","安全内参",{"_88":89,"_90":-5},"changelogVersion","2026-10-01T08:00","release"]
