[{"_1":2,"_3":4},"root",{"_5":92},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795308033000,"id","gfltnklmzy1i3r60nor37jo5p","title","FBI全国犯罪信息中心NCIC据报再次遭入侵","originalTitle","FBI reportedly hacked again, this time targeting nationwide police database","summary","FBI正在调查其国家犯罪信息中心（NCIC）疑似遭入侵事件，该系统供美国地方、州和联邦执法机构共享通缉及失踪人员、逮捕令、被盗车辆和枪支、保护令等记录。入侵近日被发现，但发生时间、攻击者获取访问权限的方式以及是否窃取信息尚不清楚，FBI尚未公开确认事件，也未说明系统可用性是否受影响。","reason","source",{"_71":91},"links",{"_61":90},"publishedAt","2026-11-21T14:26:04.000Z","discoveredAt","2026-11-21T15:11:44.708Z","timelineAt","category","activity","tags",[72,87,88,89],"score",50,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","Lawrence Abrams","body",{"_83":-5,"_61":84,"_85":-5,"_86":36},"outline",[77],"relatedStories",[73],"topics",[68],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fg8GkuTAZF8M","reportCount",1,"additionalSourceCount",0,{"_69":70,"_71":72},"slug","attack","name","攻击活动",{"_74":75,"_13":76},"publicId","610251db-932a-4927-8cc3-ae706bee1e61","FBI调查NCIC系统疑似入侵",{"_11":78,"_79":80,"_81":82},"sec-1","text","Uncover email threats your existing defenses may miss.","level",2,"zh","<p><img alt=\"FBI\" height=\"900\" src=\"/dailyinfo/media/6787aa14325595a3.jpg\" srcset=\"/dailyinfo/media/f38fab5aa81c0b8b.jpg 720w, /dailyinfo/media/a18a68dc1dfa017c.jpg 1200w, /dailyinfo/media/6787aa14325595a3.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>FBI systems have reportedly been breached for the second time in two months, this time targeting the agency's National Crime Information Center (NCIC), which is used to share information between local, state, and federal law enforcement agencies.</p><p>The National Crime Information Center is an FBI-operated database used by law enforcement agencies across the United States to share information about wanted and missing persons, outstanding arrest warrants, stolen vehicles and firearms, protection orders, and other criminal justice records.</p><p>Police officers routinely use the system during traffic stops, criminal investigations, and background checks.</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/4d5360bd2cfa88d6.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>According to <a href=\"https://www.cnn.com/2026/11/20/politics/fbi-hacked-again-target-crime-database\">CNN's reporting</a>, the FBI is investigating an apparent breach of the NCIC system, citing two people briefed on the investigation.</p><p>The intrusion was reportedly discovered in recent days, although it is unclear when the breach occurred, how the attackers gained access, or whether any information was stolen.</p><p>The FBI has not publicly confirmed the incident and did not respond to CNN's request for comment.</p><p>The reported breach comes just two months after the ShinyHunters extortion group <a href=\"https://www.bleepingcomputer.com/news/security/shinyhunters-claims-fbi-hack-data-theft-in-peoplesoft-zero-day-breach/\">claimed to have breached the FBI's systems</a> by exploiting an unpatched Oracle PeopleSoft vulnerability.</p><p>The earlier attack targeted a third-party platform associated with the FBI's recruitment website, FBIJobs.gov, with ShinyHunters claiming to have stolen sensitive information from the agency's systems.</p><p>The FBI subsequently launched an investigation that led to the <a href=\"https://www.bleepingcomputer.com/news/security/fbi-arrests-another-suspected-shinyhunters-hacker-after-agency-breach/\">arrests of suspected ShinyHunters members</a>, including a <a href=\"https://www.bleepingcomputer.com/news/security/cyber-exec-arrested-in-case-allegedly-tied-to-shinyhunters-hackers/\">Canadian cybersecurity executive</a> reportedly linked to the attacks.</p><p>There is currently no indication that the latest NCIC incident is connected to ShinyHunters or the earlier breach.</p><p>It remains unclear whether the attackers accessed sensitive law enforcement records stored in NCIC or whether the intrusion affected the system's availability to law enforcement agencies.</p><p>BleepingComputer contacted the FBI on Friday evening with questions about the reported breach but has not received a response.</p><p><em>This is a developing story and will be updated as more information becomes available.</em></p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/17b5e88b2b65d47e.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Uncover email threats your existing defenses may miss.</a>\n        </h2><p>Adaptive Security's AI agents analyze email intent, context, and behavior to uncover phishing, business email compromise, and invoice fraud.</p><p>See what's getting through with a 14-day read-only scan of Microsoft 365 or Google Workspace, with no MX changes.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Start your free email security scan.</a>\n    </p>","zhKind","complete","数据泄露","Oracle","CISA","https://www.bleepingcomputer.com/news/security/fbi-reportedly-hacked-again-this-time-targeting-nationwide-police-database/","BleepingComputer",{"_93":94,"_95":-5},"changelogVersion","2026-10-01T08:00","release"]
