[{"_1":2,"_3":4},"root",{"_5":96},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1795740043000,"id","ok6098ql8nqs69svq8tvt7hwa","title","Italy 与 Switzerland 报告 AI Agent 驱动的大规模网络攻击","originalTitle","Italy and Switzerland warn of autonomous AI-driven cyberattacks","summary","Italy 与 Switzerland 警告 AI Agent 已被用于针对关键基础设施组织的自动化网络攻击。CSIRT Italia 观察到多个 Agent 并行工作，在数小时内入侵大量暴露端点；其中一个 DeepSeek Harness 案例由协调器向 5 个 Agent 分配任务，串联漏洞、配置错误和被盗凭据进入内网，并实时编写恶意代码规避端点防护。","reason","两国的实际事件展示了 AI Agent 并行识别弱点、串联利用链并自动生成恶意代码的作战方式，防守重点与攻击路径具有直接参考价值。","source",{"_65":95},"links",{"_87":94},"publishedAt","2026-11-25T19:39:31.000Z","discoveredAt","2026-11-25T20:20:19.306Z","timelineAt","category","ai-security","tags",[66,91,68,70,92,93],"score",84,"selected",true,"channel","news","story","x","readingMode","full","author","Bill Toulas","body",{"_59":86,"_87":-5,"_88":89,"_90":37},"outline",[73,74,75],"relatedStories",[],"topics",[60,61,62,63],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_64":71,"_65":72},{"_64":69,"_65":70},{"_64":67,"_65":68},{"_64":31,"_65":66},"slug","name","AI 安全","attack","攻击活动","exploited","在野利用","red-team","红队与渗透",{"_11":84,"_77":85,"_79":83},{"_11":81,"_77":82,"_79":83},{"_11":76,"_77":78,"_79":80},"sec-3","text","发现现有防御可能遗漏的邮件威胁。","level",2,"sec-2","瑞士首次出现 AI 驱动的数据泄露事件",3,"sec-1","意大利的大规模攻击","<p><img alt=\"Italy and Switzerland warn of autonomous AI-driven cyberattacks\" height=\"900\" src=\"/dailyinfo/media/8a3bb38204eee2cd.jpg\" srcset=\"/dailyinfo/media/9168b4f2106779d0.jpg 720w, /dailyinfo/media/76ca6e252ccd349d.jpg 1200w, /dailyinfo/media/8a3bb38204eee2cd.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>瑞士和意大利网络安全机构警告称，由 AI 智能体驱动、针对关键基础设施行业组织的自动化网络攻击正在发生。</p><p>这两家机构列举了四个曾涉及<a href=\"https://www.bleepingcomputer.com/news/security/fbi-warns-artex-ai-hacking-tool-is-powering-global-cyberattacks/\">近期数据泄露</a>和<a href=\"https://www.bleepingcomputer.com/news/security/cyberstrikeai-tool-adopted-by-hackers-for-ai-powered-attacks/\">黑客事件</a>的 AI 渗透测试及红队框架：ARTEX AI、CyberStrikeAI、DeepSeek Harness - Red Team 和 PentAGI。</p><p>两家机构均敦促组织减少暴露在互联网中的系统数量、优先修补漏洞，并监测异常活动。</p><p><a href=\"https://www.wiz.io/lp/claude-code-security-best-practices-cheat-sheet?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q3_INB_FORM_Claude-Code-Security-Best-Practices&amp;sfcid=701Vh00000gJQZuIAO&amp;utm_term=FY27Q4-bleepingcomputer-article-970x250-Nov&amp;utm_content=Claude-Code-Best-Practices\"><img src=\"/dailyinfo/media/a9e8f90811ebbc9a.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><h3 id=\"sec-1\">意大利的大规模攻击</h3><p>CSIRT Italia 表示，其发现了大规模恶意活动，这些活动使用自主 AI 智能体来识别并利用暴露终端上的漏洞和配置错误。</p><p>在某些情况下，该机构观察到多个 AI 智能体并行工作，在数小时内攻破大量系统。</p><p>在一个涉及 DeepSeek Harness 部署的案例中，协调器向五个 AI 智能体分派任务，这些智能体执行了从信息收集到漏洞利用和持久化的一系列广泛作战阶段。</p><p>这些智能体将漏洞、配置错误和被盗凭据串联起来，利用暴露的系统作为 foothold，以进入内部网络。</p><p>“在观察到的大规模攻击活动中，自主智能体展现出执行复杂且持续性活动的能力，能够检测配置错误、将即使是低影响的漏洞串联成复杂攻击链，并动态调整其作战模块，”<a href=\"https://www.acn.gov.it/portale/w/impiego-di-agenti-di-ia-in-campagne-di-compromissione-automatizzate\">CSIRT Italia 表示</a>。</p><p>“它们甚至能够实时编写恶意代码，以规避终端防御，并在基础设施更深处执行操作。”</p><p>意大利网络安全机构建议管理员优先修补面向互联网的系统，重点处理已被证实遭到在野利用的漏洞，并在不需要时禁用远程管理接口。</p><p>该机构还建议监控控制平面操作、身份验证源、流入内部网络的流量以及服务器出站流量，以检测可疑活动。</p><h3 id=\"sec-2\">瑞士首次出现 AI 驱动的数据泄露事件</h3><p>瑞士国家网络安全中心（NCSC）警告称，瑞士境内组织遭遇了类似攻击，并确认了首批成功借助 AI 实施的网络攻击案例。</p><p>“近日，NCSC 首次收到关于针对瑞士境内组织的网络攻击报告，这些攻击均在 AI 智能体的协助下实施，”<a href=\"https://www.bacs.admin.ch/en/26-ki-agenten-1-en\">瑞士 NCSC 表示</a>。</p><p>“至少两个行业中的各类组织和关键基础设施运营方均受到这些网络攻击的影响。”</p><p>“在 NCSC 已知的所有网络攻击中，使用 AI 智能体均导致受害者 IT 系统被成功攻破。”</p><p>该机构描述了此类攻击的速度：智能体利用暴露终端上的弱密码和已知漏洞，并通过框架验证弱点后自主决定下一步行动。</p><p>NCSC 表示，自 10 月以来，网络罪犯可公开获取（且通常免费获得）的 AI 智能体数量几乎翻倍，由此针对瑞士组织（包括关键基础设施运营方）的大规模攻击浪潮接踵而至。</p><p>该机构建议互联网暴露系统的管理员在关键漏洞发布后 24 小时内完成修补，添加多因素身份验证（MFA）或通行密钥保护，并落实最小权限原则。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/3d0888eec2a1da78.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-3\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体会分析邮件意图、上下文和行为，识别网络钓鱼、商业邮件入侵和发票欺诈。</p><p>使用 Microsoft 365 或 Google Workspace 进行 14 天只读扫描，看看有哪些威胁正在绕过防御，且无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始免费邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","Agent 安全","红队","漏洞利用","https://www.bleepingcomputer.com/news/security/italy-and-switzerland-warn-of-autonomous-ai-driven-cyberattacks/","BleepingComputer",{"_97":98,"_99":-5},"changelogVersion","2026-10-01T08:00","release"]
