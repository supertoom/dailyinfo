[{"_1":2,"_3":4},"root",{"_5":112},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1793667381000,"id","jfrlmktjc1u9cgfdzzzkfjq2b","title","Cisco 利用 SnortML 与 Splunk 协同防御 AI 加速的 PHP2Shell 威胁","originalTitle","PHP2Shell: How Cisco Helps Customers Respond to AI-Accelerated Threats","summary","Cisco 通过 SnortML、Snort IPS/IDS 规则和 Splunk 检测协同应对 AI 加速的 PHP2Shell 威胁。","reason","source",{"_72":111},"links",{"_61":110},"publishedAt","2026-11-02T18:24:13.000Z","discoveredAt","2026-11-02T23:54:34.573Z","timelineAt","category","blue-team","tags",[105,106,75,107,108,109],"score",55,"selected",false,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","Rick Miles","body",{"_101":-5,"_61":102,"_103":-5,"_104":36},"outline",[82,83,84,85,86],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","feXMRkycP-Is","reportCount",1,"additionalSourceCount",0,{"_71":76,"_72":77},{"_71":74,"_72":75},{"_71":30,"_72":73},"slug","name","蓝队与运营","ai-offense","AI 攻防","cisco","Cisco / 思科",{"_79":80,"_13":81},"publicId","44a65a52-e999-4d1c-8a1f-25a8a8cafd9f","思科发布PHP2Shell检测与响应能力",{"_11":99,"_88":100,"_90":96},{"_11":97,"_88":98,"_90":96},{"_11":94,"_88":95,"_90":96},{"_11":92,"_88":93,"_90":91},{"_11":87,"_88":89,"_90":91},"sec-5","text","Get Security Blogs via Email","level",3,"sec-4","Why Cisco Security?","sec-3","Get resources to defend against PHP2Shell",2,"sec-2","Splunk detects post-exploit activity with Snort","sec-1","Detection coverage for customers before day-zero","zh","<p>AI is accelerating vulnerability discovery and shrinking response windows, putting critical assets at more risk than ever. PHP2Shell is one recent example of the urgency security teams face as AI-driven threats evolve and affect organizations worldwide. At this pace, security teams struggle to apply patches and plan upgrades before new threats emerge.</p><p>Organizations need the right tools, threat intelligence, and expertise to adapt quickly. That’s why our customers had PHP2Shell coverage for exploit attempts before disclosure, signatures ready on day-zero, and advanced detections in Splunk to see attack activity.</p><p><i>New to PHP2Shell? <a href=\"https://www.youtube.com/shorts/IAbv-6d7O9A\">Watch the 2 minute video</a>.</i></p><h2 id=\"sec-1\">Detection coverage for customers before day-zero</h2><p>In less than 24 hours after the PHP2Shell vulnerabilities were disclosed, SnortML caught a novel exploit attempt in customer firewall telemetry. In addition to the signatures available on day-zero for the PHP vulnerabilities, SnortML recognized patterns in the novel attack payload that it had learned from other attacks and was able to identify and block remote code execution attempts in-line. SnortML blocked suspicious traffic on day-zero for the firewall team to evaluate, closing the defense gap as teams worked to patch which, of course, is the first step.</p><p>Cisco Firewall customers running software 10.1 automatically have SnortML. Built into the intrusion prevention engine, SnortML spots attack patterns and blocks exploit attempts in real time, even new ones. Together, Snort signatures and machine learning work to defend firewall customers from emerging AI-driven threats.</p><p><i>Note: Customers using <a href=\"https://www.cisco.com/c/en/us/td/docs/security/secure-firewall/release-notes/threat-defense/100/management-center-release-notes-10-0.html#ftd-fmc-release-notes\">Cisco Firewall version 10.1</a> and using the security over connectivity policy have SnortML enabled by default.</i></p><h2 id=\"sec-2\">Splunk detects post-exploit activity with Snort</h2><p>We are going to continue to see threat actors chaining the PHP2Shell vulnerability with other vulnerabilities in future attacks, so we equip our customers to link their defenses in response. Cisco and Splunk researchers link Snort IPS/IDS rules to Splunk detections. This way, Splunk connects individual firewall alerts to see if they match a bigger picture of known suspicious activity.</p><p>Customers now have <a href=\"https://research.splunk.com/stories/php2shell/\">more than 10 Splunk detections</a> to defend against PHP2Shell post-exploit activity, including detections specific to Cisco Firewalls. Cisco Firewalls block malicious PHP2Shell attack traffic while Splunk gives SOC teams visibility into PHP2Shell post-exploit activity. AI-driven threats are leaving almost no time to react, so the tools we use to defend against unknown threats must be interlocked.</p><h2 id=\"sec-3\">Get resources to defend against PHP2Shell</h2><ul>\n<li><b>Bookmark the Cisco Talos Threat Advisory blog</b> – <a href=\"https://blog.talosintelligence.com/two-critical-rces-in-php-core/\">This Talos blog</a> is your source of truth for all ongoing updates and guidance for reducing risk while you patch.</li>\n<li><b>Download IPS signatures 67359, 67360, and 67375</b> if you’re a Cisco Firewall customer with an active threat subscription, or get them for free using the open source <a href=\"https://snort.org/advisories/talos-rules-2026-10-21\">Snort Community Ruleset.</a></li>\n<li><b>Learn how SnortML works</b> by <a href=\"https://blogs.cisco.com/security/snortml-cisco-ml-based-detection-engine-gets-powerful-upgrade\">reading the intro blog</a>, or <a href=\"https://youtu.be/34fr1COyb3A?si=3Fm0nVtGmdi2eKCI\">watch the video on getting started</a> (for versions prior to 10.1).</li>\n<li><b>Review the Splunk detections now available</b> in the <a href=\"https://research.splunk.com/stories/php2shell/\">Enterprise Security Content Update</a>, covering exploitation attempts and post-exploitation activity.</li>\n<li><b>Try some of the capabilities covered today in </b><a href=\"https://cloudsecurity.cisco.com/firewall-test-drive\">the Cisco Firewall test drive</a>.</li>\n</ul><p>Our job is your defense, and our global threat intelligence team turns emerging threats into clear guidance and stronger defenses for our customers, so you can protect what matters as AI-driven attacks evolve and be prepared for what’s next.</p><p><img src=\"/dailyinfo/media/e104c60aef9907db.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Why Cisco Security?\" width=\"96\" height=\"96\">\n\t\t\t\t</p><h3 id=\"sec-4\">Why Cisco Security?</h3><p>Explore our Products &amp; Services</p><p><a href=\"https://www.cisco.com/c/en/us/products/security/index.html\">Learn More</a>\n\t\t\t\t\t\t\t</p><p><img src=\"/dailyinfo/media/c88d4485d2018c45.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Get Security Blogs via Email\" width=\"96\" height=\"96\">\n\t\t\t\t</p><h3 id=\"sec-5\">Get Security Blogs via Email</h3><p>Stay up to date and get the latest blogs from Cisco Security</p>","zhKind","complete","蓝队","检测工程","Cisco","网络设备","PHP","https://blogs.cisco.com/security/php2shell-how-cisco-helps-customers-respond-to-ai-accelerated-threats/","Cisco Security Blog",{"_113":114,"_115":-5},"changelogVersion","2026-10-01T08:00","release"]
