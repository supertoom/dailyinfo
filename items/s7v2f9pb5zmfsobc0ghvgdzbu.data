[{"_1":2,"_3":4},"root",{"_5":108},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1794444098000,"id","s7v2f9pb5zmfsobc0ghvgdzbu","title","VulnCheck 分析 Anthropic Project Glasswing 七个月漏洞成果与修复差距","originalTitle","Anthropic's Glasswing Finds Many Vulnerabilities Yet Delivers Few Fixes, Researcher Says","summary","VulnCheck 研究员 Patrick Garrity 基于 Anthropic 公开数据指出，Project Glasswing 七个月共找到 37,966 个候选漏洞，其中 7349 个进入台账，5276 个经确认为真实且独立的漏洞，1654 个重复、419 个撤回。","reason","source",{"_75":107},"links",{"_60":106},"publishedAt","2026-11-11T16:30:00.000Z","discoveredAt","2026-11-11T17:15:06.454Z","timelineAt","category","ai-security","tags",[77,103,83,79,104,105],"score",61,"selected",false,"channel","news","story",{"_87":88,"_13":89},"x","readingMode","full","author","body",{"_99":-5,"_60":100,"_101":-5,"_102":36},"outline",[90,91],"relatedStories",[86],"topics",[67,68,69,70,71,72],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","f3lbZv3PkQDI","reportCount",1,"additionalSourceCount",0,{"_73":84,"_75":85},{"_73":82,"_75":83},{"_73":80,"_75":81},{"_73":78,"_75":79},{"_73":30,"_75":77},{"_73":74,"_75":76},"slug","tools","name","工具与平台","AI 安全","ai-offense","AI 攻防","ai-agent","AI Agent 安全","vuln-mgmt","漏洞管理","google","Google / 谷歌",{"_87":88,"_13":89},"publicId","fb425170-a0cc-4abb-afd2-573148949eb2","Glasswing漏洞修复率低于0.5%",{"_11":97,"_93":98,"_95":96},{"_11":92,"_93":94,"_95":96},"sec-2","text","Anthropic Launched OSS Scanner to Scale Vulnerability Disclosures","level",2,"sec-1","Only 217 Vulnerabilities Publicly Fixed After Seven Months of Glasswing","zh","<p>\n\tSeven months on, Anthropic’s Project Glasswing is “overwhelming” maintainers with “underwhelming findings.”</p><p>\n\tThis harsh conclusion comes from Patrick Garrity, a vulnerability researcher at VulnCheck, in <a href=\"https://www.vulncheck.com/blog/anthropic-glasswing-november-update\">a report</a> released on November 9.</p><p>\n\tThis new analysis is Garrity’s latest update on Project Glasswing’s results based on data publicly reported by Anthropic, an exercise aimed at understanding “whether Anthropic’s claims are overhyped or grounded in reality,” Garrity said.</p><p>\n\tProject Glasswing is <a href=\"https://www.infosecurity-magazine.com/news/anthropic-launch-project-glasswing/\">Anthropic’s flagship effort</a> to offer the company’s frontier AI models to security researchers in order to help them find and remediate software vulnerabilities.</p><h2 id=\"sec-1\">\n\t<strong>Only 217 Vulnerabilities Publicly Fixed After Seven Months of Glasswing</strong></h2><p>\n\tAccording to the latest update on Anthropic’s coordinated vulnerability disclosure dashboard, dated November 2, 2026, Project Glasswing has enabled researchers to find 37,966.</p><p>\n\tHowever, only 7349 (19.4%) are listed in the ledger, Anthropic's public tracking register of vulnerabilities and potential vulnerabilities identified through Project Glasswing.</p><p>\n\tOut of the vulnerabilities included in the ledger, Garrity has found that 5276 have been validated as real unique vulnerabilities. The rest is made of 1654 duplicates and 419 that were withdrawn.</p><p>\n\tOf the 5276 relevant vulnerabilities, almost 13% (4866) have been reported to the maintainers and 193 are still in a phase of “pre-disclosure” and are yet to be reported to maintainers.</p><p>\n\tThis leaves 217 vulnerabilities - less than 0.5% of the total of vulnerabilities claimed to be found thanks to Glasswing – that have been fixed, Garrity noted.</p><figure><img src=\"/dailyinfo/media/883348bfc771cbfe.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Visualization of Glasswing vulnerability reports categorized by VulnCheck’s Patrick Garrity. Source: VulnCheck\"><figcaption>Visualization of Glasswing vulnerability reports categorized by VulnCheck’s Patrick Garrity. Source: VulnCheck</figcaption></figure><p>\n\tThe researcher added that since <a href=\"https://www.vulncheck.com/blog/anthropic-glasswing-receipts\">his last analysis of Glasswing vulnerability findings in September</a>, Anthropic had added 4613 vulnerability findings to its ledger, yet only 15 were marked as fixed within the same period. A significant volume of findings added to the ledger between September and November (1668) were marked as duplicates.</p><p>\n\tThis led the researcher to question Anthropic’s latest claimed true positive rate of 94.2%, which, he said, raises “questions about how it accounts for duplicates and withdrawn findings.”</p><p>\n\t<a href=\"https://www.infosecurity-magazine.com/news/anthropic-glasswing-expansion/\"><em>Read more: Anthropic Expands Mythos Access to 150 More Organizations</em></a></p><h2 id=\"sec-2\">\n\t<strong>Anthropic Launched OSS Scanner to Scale Vulnerability Disclosures</strong></h2><p>\n\tOne reason that could explain the gap between the vulnerabilities claimed to be found through Glasswing and vulnerabilities publicly fixed is the pace of human vulnerability report triage.</p><p>\n\tOn October 8, Anthropic said it had found more than 29,000 candidate vulnerabilities but had manually reviewed only about 6000, and that it remains \"bottlenecked on our human capacity to validate these findings.\"</p><p>\n\t“We are working on scaling our vulnerability disclosures,” the company <a href=\"https://www.anthropic.com/research/launching-opt-in-vuln-finding-service-for-open-source\">added</a>.</p><p>\n\tTherefore, it launched its own Open Source Security Scanner (OSS Scanner), a self-service new tool inspired by Google's OSS-Fuzz project and that allows maintainers to request a scan and triage the findings themselves.</p><p>\n\tAnthropic also said it has already sent nearly 5000 unverified vulnerability reports directly to maintainers who asked to receive everything in bulk.</p><p>\n\tThis new shift in Project Glasswing started showing issues in AI-powered vulnerability reports more clearly.</p><p>\n\tFor instance, Daniel Stenberg, maintainer of the Client and URL (cURL) project, <a href=\"https://www.linkedin.com/feed/update/urn:li:share:7524224297595269120/\">said</a> on November 6 he received 45 vulnerability reports from Anthropic through Glasswing.</p><p>\n\tAfter analyzing 34 of them using Anthropic OSS Scanner and other tools, Stenberg pointed out that 19 weren't vulnerabilities at all and six have been confirmed as low severity.</p><p>\n\t“AI is a valuable tool for finding vulnerabilities, and I'm not discounting that. But seven months in, the evidence still doesn't match the launch narrative. The CVEs are a sliver of this year's total, almost none are being exploited, fixes have stalled while duplicates and withdrawals pile up, and the triage burden is shifting onto the open source maintainers Glasswing promised to help. The receipts keep coming in. They still don't reconcile,” Garrity concluded.</p><p>\n\t<em>Infosecurity </em>contacted Anthropic for comment, but the company had not responded by the time of publication.</p><p>\n\t<em>Image credits:&nbsp;Stockinq /&nbsp;gguy / Shutterstock.com</em></p><p>\n\t<a href=\"https://www.infosecurity-magazine.com/news-features/industry-coalitions-secure-open/\"><em>Read now: How Industry Coalitions Are Rallying to Secure Open Source Software for the AI Era</em></a></p>","zhKind","complete","大模型","工具发布","Google","https://www.infosecurity-magazine.com/news/anthropic-glasswing/","Infosecurity Magazine",{"_109":110,"_111":-5},"changelogVersion","2026-10-01T08:00","release"]
