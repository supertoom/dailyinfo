[{"_1":2,"_3":4},"root",{"_5":95},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795394438000,"id","pnqtcxn4en4dooz4qywf8iz0i","title","Debian 13.8 发布，集中修复 Chromium、Firefox ESR、OpenJDK 25、nginx 等组件安全问题","originalTitle","Debian 13.8 bundles kernel and Chromium security fixes with a 122-package bugfix list","summary","Debian 项目发布 stable “trixie” 系列的第 8 次更新 Debian 13.8，包含 122 个软件包修复及 DSA-6408 至 DSA-6629 安全公告，覆盖 Chromium、Firefox ESR、OpenJDK 25、nginx、BIND 9、Dovecot、rsync、PostgreSQL 17 和 Linux kernel。","reason","source",{"_73":94},"links",{"_61":93},"publishedAt","2026-11-22T23:05:09.000Z","discoveredAt","2026-11-22T23:18:15.820Z","timelineAt","category","blue-team","tags",[89,90,91,92,80],"score",33,"selected",false,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","Anamarija Pogorelec","body",{"_85":-5,"_61":86,"_87":-5,"_88":36},"outline",[],"relatedStories",[81],"topics",[68,69,70,71],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fTtj2k9g9G-I","reportCount",1,"additionalSourceCount",0,{"_72":79,"_73":80},{"_72":77,"_73":78},{"_72":75,"_73":76},{"_72":30,"_73":74},"slug","name","蓝队与运营","vuln","漏洞披露","kernel","内核与系统","debian","Debian",{"_82":83,"_13":84},"publicId","1646e78b-ee58-4572-9e74-a89c19717aab","Debian 13.8 集中修复组件漏洞","zh","<p>The Debian project released Debian 13.8, the eighth update to its stable “trixie” series. It mainly carries security fixes, plus corrections for a few serious bugs, and it bundles advisories Debian had already published separately.</p><p><img src=\"/dailyinfo/media/a221551fb1ddf2b4.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Debian 13.8\" title=\"Debian\"></p><p>If you run trixie, here is what to check. The security table runs from DSA-6408 to DSA-6629 (a DSA is a Debian Security Advisory). It covers Chromium, Firefox ESR, OpenJDK 25, nginx, BIND 9, Dovecot, rsync, PostgreSQL 17 and the Linux kernel. Chromium is the package the table lists most often. A second table lists 122 packages with bugfixes, among them security fixes in glibc, grub2, MariaDB, intel-microcode and sssd.</p><p>ClamAV, the open-source antivirus scanner, moved to a new upstream stable release with fixes for 13 CVEs. Other packages got smaller repairs: build failures, Thunderbird 153 compatibility and updated tzdata time zone data.</p><p>Existing installs get 13.8 by upgrading packages from an HTTP <a href=\"https://www.debian.org/mirror/list\">mirror</a>, and old trixie install media still works. If you already pull updates from security.debian.org often, you will find few packages left to update, since most of those fixes are already in the release.</p>","zhKind","complete","版本更新","补丁","蓝队","操作系统","https://www.helpnetsecurity.com/2026/11/23/debian-13-8-released/","Help Net Security",{"_96":97,"_98":-5},"changelogVersion","2026-10-01T08:00","release"]
