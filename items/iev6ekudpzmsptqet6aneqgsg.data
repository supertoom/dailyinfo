[{"_1":2,"_3":4},"root",{"_5":114},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1795394433000,"id","iev6ekudpzmsptqet6aneqgsg","title","帆软 FineReport FineVis（FVS）插件复用包导入未授权 RCE 漏洞已复现","originalTitle","【已复现】帆软 FineReport FVS 插件复用资源导入未授权远程代码执行漏洞","summary","帆软 FineReport 的 FineVis（FVS）插件存在未授权远程代码执行漏洞，攻击者无需账号或凭据即可上传并应用构造的 .mfvs 复用包，以应用进程权限执行任意系统命令。","reason","source",{"_72":113},"links",{"_103":112},"publishedAt","2026-11-22T12:04:00.000Z","discoveredAt","2026-11-22T17:09:18.108Z","timelineAt","category","vuln","tags",[106,107,108,109,110,111],"score",61,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body",{"_60":102,"_103":-5,"_104":103,"_105":55},"outline",[81,82,83,84,85,86],"relatedStories",[77],"topics",[67,68,69],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","fRcQIcwO6CHg","reportCount",1,"additionalSourceCount",0,{"_70":75,"_72":76},{"_70":30,"_72":74},{"_70":71,"_72":73},"slug","research","name","技术研究","漏洞披露","chaitin","长亭科技",{"_78":79,"_13":80},"publicId","7eac442c-0767-416d-96b5-432c2f408699","长亭复现帆软FVS未授权RCE漏洞",{"_11":100,"_88":101,"_90":91},{"_11":98,"_88":99,"_90":91},{"_11":96,"_88":97,"_90":91},{"_11":94,"_88":95,"_90":91},{"_11":92,"_88":93,"_90":91},{"_11":87,"_88":89,"_90":91},"sec-6","text","参考资料","level",3,"sec-5","临时缓解方案","sec-4","升级修复方案","sec-3","处置优先级：高","sec-2","漏洞影响","sec-1","漏洞成因","<p><span>长亭安全应急响应中心</span> <span>2026-11-22 20:04</span> <span>浙江</span></p><p><img src=\"/dailyinfo/media/747c1ec3a0352870.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>检测业务是否受到此漏洞影响，请联系长亭应急服务团队！</p><p><img alt=\"漏洞风险提示\" src=\"/dailyinfo/media/e42de8fb081ee1ed.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><span>帆软 FineReport 是企业级报表与数据决策平台，FineVis（FVS）是其可视化大屏插件，常用于经营分析、指挥调度与数据看板，在金融、制造、政企等行业的报表系统中部署广泛。</span></p><p><span>2026 年 11 月，长亭安全应急响应中心监测到帆软 FineReport 的 FineVis（FVS）插件存在未授权远程代码执行风险。攻击者无需任何账号或凭据，即可向暴露在网络的报表服务上传并应用构造的 FVS 复用包（.mfvs 文件，用于打包模板及其依赖资源），以应用进程权限执行任意系统命令。该漏洞仅影响启用 FineVis（FVS）插件的 FineReport 实例。截至通告发布，暂未确认该漏洞的在野利用情况；建议已安装 FVS 插件的用户尽快核对版本并完成升级。</span></p><p><strong><span>漏洞描述</span></strong><span><span>&nbsp;Description&nbsp;</span></span></p><p><strong><span>01</span></strong></p><h3 id=\"sec-1\"><span>漏洞成因</span></h3><p><span>FVS 插件提供复用包的在线导入与应用能力，相关请求本应经过模板鉴权与登录状态校验。经分析，模板鉴权组件对模板路径参数的处理存在缺陷：当请求携带的模板路径被归一化为空值时，该请求被判定为无需登录的模板访问，从而绕过登录状态校验，未认证用户即可调用复用包上传与应用接口。</span></p><p><span>在复用包应用阶段，导入组件会按包内清单写入附件，但未对写入位置做业务白名单限制。附件可被写入应用的 WEB-INF 目录，甚至覆盖容器配置，并在其中写入可执行内容；容器检测到配置变更后重载，写入的代码随之被解析执行。</span></p><h3 id=\"sec-2\"><span>漏洞影响</span></h3><p><span>攻击者可在报表服务器上以应用进程权限执行任意系统命令，可能导致服务器被完全控制、报表业务数据与数据库连接凭据泄露，并可作为跳板进一步渗透内网。实际影响范围取决于服务的网络暴露情况与运行权限。</span></p><h3 id=\"sec-3\"><span>处置优先级：高</span></h3><p><strong><span>漏洞类型：</span></strong><span>&nbsp;远程代码执行</span></p><p><strong><span>漏洞危害等级：</span></strong><span>&nbsp;高</span></p><p><strong><span>触发方式：</span></strong><span>&nbsp;网络远程</span></p><p><strong><span>权限认证要求：</span></strong><span>&nbsp;无需权限</span></p><p><strong><span>系统配置要求：</span></strong><span>&nbsp;需要安装并启用 FVS 插件（官方安装包通常自带）</span></p><p><strong><span>用户交互要求：</span></strong><span>&nbsp;无需用户交互</span></p><p><strong><span>利用成熟度：</span></strong><span>&nbsp;POC 未公开</span></p><p><strong><span>修复复杂度：</span></strong><span>&nbsp;低，升级至修复版本即可</span></p><p><strong><span>影响版本</span></strong><span><span>&nbsp;Affects&nbsp;</span></span></p><p><strong><span>02</span></strong></p><p><span>FineReport &lt; 11.5.16</span></p><p><span>FineVis（FVS）插件 &lt; 4.15.0</span></p><p><strong><span>解决方案</span></strong><span><span>&nbsp;Solution&nbsp;</span></span></p><p><strong><span>03</span></strong></p><h3 id=\"sec-4\"><span>升级修复方案</span></h3><p><span>建议将 FineReport 升级至 11.5.16 或更高版本，并将 FineVis（FVS）插件升级至 4.15.0 或更高版本。版本差异分析显示，FVS 4.15.0 已收紧空模板路径下的鉴权判定，并对复用包内附件的写入路径增加禁用校验，上述两处缺陷均已修复；FineReport 11.5.16 与 FVS 4.15.0 均于 2026 年 10 月 16 日发布。升级步骤可参考官方产品安全加固指导手册：</span></p><p><span><a href=\"https://help.fanruan.com/finereport/doc-view-4658.html\">https://help.fanruan.com/finereport/doc-view-4658.html</a></span></p><p><span>截至通告发布，官方安全漏洞声明页面尚未单列该漏洞条目，修复版本判断来自版本差异分析，升级前建议与帆软技术支持确认版本适配关系。</span></p><h3 id=\"sec-5\"><span>临时缓解方案</span></h3><p><span>无法立即升级时，可采取以下应急措施，均可能影响业务功能，升级完成后应及时移除：</span></p><ul><li><p><span>通过反向代理、防火墙或 WAF 限制报表服务的访问来源，仅放行可信网络与必要运维地址；</span></p></li><li><p><span>对复用包导入、应用类请求实施拦截或额外的身份校验，并评估其对资源迁移等正常业务的影响；</span></p></li><li><p><span>不具备上述条件的实例，建议临时停止外网暴露，仅保留内网受控访问。</span></p></li></ul><p><strong><span>漏洞复现</span></strong><span><span>&nbsp;Reproduction&nbsp;</span></span></p><p><strong><span>04</span></strong></p><p><span>长亭安全应急响应中心已完成复现验证：在 FineReport 11.5.11 与 FVS 4.9.0 环境中，未携带任何凭据即可上传并应用构造的 FVS 复用包，最终以应用进程权限执行系统命令。</span></p><p><img src=\"/dailyinfo/media/4ec8d8804a51011d.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span>复现验证：未认证利用后以应用进程权限执行系统命令</span></p><p><strong><span>产品支持</span></strong><span><span>&nbsp;Support&nbsp;</span></span></p><p><strong><span>05</span></strong></p><p><strong><span>云图：</span></strong><span>默认支持该产品的指纹识别，同时支持该漏洞的 PoC 原理检测</span></p><p><strong><span>洞鉴：</span></strong><span>默认支持该产品的指纹识别，预计2026年11月22日发布应急POC</span></p><p><strong><span>无锋：</span></strong><span>默认支持该产品的指纹识别，同时支持该漏洞的 PoC 原理检测</span></p><p><strong><span>时间线</span></strong><span><span>&nbsp;Timeline&nbsp;</span></span></p><p><strong><span>06</span></strong></p><p><span>2026 年 11 月 22 日 长亭安全应急响应中心发布通告</span></p><h3 id=\"sec-6\"><span>参考资料</span></h3><p><span>[1]. <a href=\"https://help.fanruan.com/finereport/doc-view-4834.html\">https://help.fanruan.com/finereport/doc-view-4834.html</a></span></p><p><span>[2]. <a href=\"https://help.fanruan.com/finereport/doc-view-5605.html\">https://help.fanruan.com/finereport/doc-view-5605.html</a></span></p><p><span>[3]. <a href=\"https://help.fanruan.com/finereport/doc-view-4658.html\">https://help.fanruan.com/finereport/doc-view-4658.html</a></span></p><p><span>[4]. <a href=\"https://help.fanruan.com/finereport/doc-view-2220.html\">https://help.fanruan.com/finereport/doc-view-2220.html</a></span></p><p><strong><span>长亭应急响应服务</span></strong></p><p><span>全力进行产品升级</span></p><p><span>及时将风险提示预案发送给客户</span></p><p><span>检测业务是否受到此次漏洞影响</span></p><p><span>请联系长亭应急服务团队</span></p><p><span>7*24小时，守护您的安全</span></p><p><span>第一时间找到我们：</span></p><p><span>邮箱：support@chaitin.com</span></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=b1f6091e&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzIwMDk1MjMyMg%3D%3D%26mid%3D2247493574%26idx%3D1%26sn%3Dc30ca613b32361daac820495c188a69c\">跳转微信打开</a></p>","original","zhKind","complete","漏洞","复现","漏洞分析","漏洞利用","补丁","长亭","https://mp.weixin.qq.com/s?__biz=MzIwMDk1MjMyMg==&mid=2247493574&idx=1&sn=c30ca613b32361daac820495c188a69c","长亭安全应急响应中心",{"_115":116,"_117":-5},"changelogVersion","2026-10-01T08:00","release"]
