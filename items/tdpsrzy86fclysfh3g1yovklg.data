[{"_1":2,"_3":4},"root",{"_5":95},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1794444099000,"id","tdpsrzy86fclysfh3g1yovklg","title","Baker Tilly 通报第三方服务提供商数据泄露，得州 10,456 人受影响","originalTitle","Baker Tilly notifies clients of data breach at third-party provider","summary","Baker Tilly Advisory Group 通知客户，其用于提供服务的第三方平台发生数据泄露，未经授权的攻击者获取了部分客户及其家属的个人信息。公司于 2026 年 9 月 6 日知悉事件，10 月 28 日完成受影响数据审查。","reason","source",{"_72":94},"links",{"_61":93},"publishedAt","2026-11-11T23:01:31.000Z","discoveredAt","2026-11-11T23:09:21.065Z","timelineAt","category","activity","tags",[90,91,92,73],"score",61,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","readingMode","full","author","Bill Toulas","body",{"_86":-5,"_61":87,"_88":-5,"_89":36},"outline",[80],"relatedStories",[76],"topics",[68,69],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","ff8WBvtZ6o90","reportCount",1,"additionalSourceCount",0,{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","identity","name","身份与访问","supply-chain","供应链安全",{"_77":78,"_13":79},"publicId","57f92d17-7610-429f-840c-f0267a708c84","Baker Tilly披露第三方平台数据泄露",{"_11":81,"_82":83,"_84":85},"sec-1","text","Uncover email threats your existing defenses may miss.","level",2,"zh","<p><img alt=\"Baker Tilly notifies clients of data breach at third-party provider\" height=\"900\" src=\"/dailyinfo/media/7435df772bbf3c7f.jpg\" srcset=\"/dailyinfo/media/c81836e2c3f78472.jpg 720w, /dailyinfo/media/369f9bbf084c3086.jpg 1200w, /dailyinfo/media/7435df772bbf3c7f.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>The Baker Tilly Advisory Group is notifying clients that a data breach has compromised certain personal information about them and their dependents.</p><p>The company said the exposed data was stored on a platform operated by a third-party service provider Baker Tilly uses to serve clients.</p><p>Baker Tilly learned of the incident on September 6 and completed its review of the affected data on October 28, when it identified whose information was involved.</p><p><a href=\"https://www.wiz.io/lp/securing-ai-agents-101?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY26Q3_INB_FORM_Securing-AI-Agents-101&amp;sfcid=701Py00000RTEWMIA5&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AI-Agents-101\"><img src=\"/dailyinfo/media/2ddb46eee4d24330.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>“On September 6, 2026, Baker Tilly became aware of a potential cybersecurity incident involving certain information stored on a platform operated by a third-party service provider used by Baker Tilly in connection with services we provide to clients,” reads the notification to customers.</p><p>“The unauthorized actor was able to obtain data relating to certain Baker Tilly clients,” the company added.</p><p>The <a href=\"https://www.documentcloud.org/documents/28880646-baker-tilly-sample-individual-notice/\">breach notification</a> does not provide a count of impacted clients, does not name the service provider, and leaves the specific data types exposed as a placeholder.</p><p>Data from the Office of the Texas Attorney General reports that Baker Tilly impacted 10,456 individuals in the state of Texas alone. The portal lists Social Security numbers (SSNs), full names, addresses, and other information as exposed data types.</p><p>Baker Tilly is a major accounting firm in the U.S., providing auditing, tax planning, compliance, advisory, and business operations services. Globally, the company operates in 147 countries and reports an <a href=\"https://www.bakertilly.global/news/baker-tilly-international-announces-record-revenues-of-us-6-8bn\">annual revenue of $6.8 billion</a>.</p><p>After discovering the incident, the company says it took immediate steps to contain it, contracted external experts to investigate, and notified law enforcement authorities.</p><p>Furthermore, it says it currently has no evidence of unauthorized activity on its own network, and added that it has no reports of identity theft or fraud linked to the exposure of customer information.</p><p>To mitigate the risks arising from the incident, the firm offers affected individuals 24 months of credit and identity monitoring through Experian.</p><p>BleepingComputer has contacted Baker Tilly for more information about the data breach, its source, the number of affected customers, and the type of data compromised, but we have not received a reply by the time of publishing.</p><p>BleepingComputer did not find any announcements from ransomware groups claiming the attack.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/0c6c2476908e136e.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Uncover email threats your existing defenses may miss.</a>\n        </h2><p>Adaptive Security's AI agents analyze email intent, context, and behavior to uncover phishing, business email compromise, and invoice fraud.</p><p>See what's getting through with a 14-day read-only scan of Microsoft 365 or Google Workspace, with no MX changes.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Start your free email security scan.</a>\n    </p>","zhKind","complete","数据泄露","供应链","凭据","https://www.bleepingcomputer.com/news/security/baker-tilly-notifies-clients-of-data-breach-at-third-party-provider/","BleepingComputer",{"_96":97,"_98":-5},"changelogVersion","2026-10-01T08:00","release"]
