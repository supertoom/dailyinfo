[{"_1":2,"_3":4},"root",{"_5":113},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794444092000,"id","dovg5xscowbmox2u6l6m2s1lp","title","Parameter 揭示恶意 ChatGPT 分享链接代码执行漏洞利用链","originalTitle","A Shared ChatGPT Link Could Run Attacker Code in Your Session and Read Private Chats","summary","Parameter 揭示恶意 ChatGPT 分享链接可在已登录会话中执行攻击者代码并读取私人对话，利用链经 MathLive 跨框架消息注入原始 HTML，再借助允许的 YouTube 脚本绕过 CSP。","reason","文章拆解了恶意 ChatGPT 分享链接从跨框架消息到代码执行的完整链路，并说明修复版本与验证边界。","source",{"_75":112},"links",{"_102":111},"publishedAt","2026-10-31T05:33:41.000Z","discoveredAt","2026-10-31T06:08:16.553Z","timelineAt","category","disclosure","tags",[78,106,107,76,108,109,110],"score",78,"selected",true,"channel","news","story",{"_86":87,"_13":88},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_61":101,"_102":-5,"_103":104,"_105":37},"outline",[89,90,91],"relatedStories",[85],"topics",[68,69,70,71,72],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fwpDFBCjreg8","reportCount",1,"additionalSourceCount",0,{"_73":83,"_75":84},{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","ai-security","name","AI 安全","research","技术研究","vuln","漏洞披露","ai-agent","AI Agent 安全","google","Google / 谷歌",{"_86":87,"_13":88},"publicId","5b1558a1-a2f2-4b50-a687-0168a1ed952d","ChatGPT分享链接代码执行漏洞已修复",{"_11":99,"_93":100,"_95":96},{"_11":97,"_93":98,"_95":96},{"_11":92,"_93":94,"_95":96},"sec-3","text","OpenAI 修复了什么，用户应该做什么","level",3,"sec-2","链接如何突破沙箱","sec-1","攻击者可以做什么","<p><span><i></i><span>Swati Khandelwal</span><i></i><span>2026年10月31日</span></span><span>漏洞 / Web 安全</span></p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhEplEzMjNIg5IBNIX4uz_WyVhtJqqbKICvvpW5LbwPEsQVd4ypSQC1ISnXoR0pMLlQEF4erNUIf-5-ELvBXIE8VH2Iv7dCPCuaZAFVeS9VIITs_5e_77DwtIvo3ExUcfJC_aT4x3FDD3AmTKeQFKnOrufXorlbiHOJNO-pUhwzBNwL98r-2JSW2CWiTBs/s1600/chatgpt.jpg\"><img alt=\"\" src=\"/dailyinfo/media/6906d9703dec7505.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>安全公司 Parameter 的研究人员展示称，恶意 ChatGPT 分享链接可以在任何打开它并已登录的会话中运行攻击者的代码，从而读取其私人对话。</p><p>研究人员于10月18日通过<a href=\"https://bugcrowd.com/engagements/openai\">OpenAI 的漏洞赏金计划</a>报告了这一漏洞，OpenAI 在八天后修复了它，并将其评为 P1，这是该公司的最高严重级别。</p><p>陷阱是一个通过公开链接分享的普通 ChatGPT 对话。它可以像分享任何真实聊天一样发送：通过电子邮件、聊天消息、支持工单或社交帖子。</p><p>受害者无需安装任何东西、加入工作区，也无需通过攻击者登录。在最可靠的攻击版本中，他们只需打开链接并点击一次 ChatGPT 的 Preview 按钮。在后续版本中，Parameter 将页面设置为自动打开 Preview，因此打开链接就是唯一的操作步骤。</p><h3 id=\"sec-1\">攻击者可以做什么</h3><p>链接打开后，攻击者的代码会在受害者已登录的会话中运行，并拥有与真实 ChatGPT 网站相同的访问权限。它会列出受害者最近的对话，打开一段从未与攻击者分享过的私人聊天，并将其中一小部分发送到研究人员控制的服务器。</p><p>该代码直接调用 ChatGPT 自身要求登录的 API，而不是复制屏幕上偶然显示的内容。由于它以受害者的完整 Web 访问权限运行，其作用范围并不局限于这些聊天。研究人员<a href=\"https://www.parameter.ai/labs/we-found-a-gap-at-openai\">写道</a>：“从本质上说，我们可以代表受害者的 ChatGPT 账户执行任何操作。”</p><p>这项工作是一次受控测试。Parameter 没有报告该漏洞在现实世界中的任何实际使用，而是在两个独立账户之间完成了私人聊天概念验证，而不是针对真实用户进行。</p><h3 id=\"sec-2\">链接如何突破沙箱</h3><p>以下是据 Parameter 所述的攻击链运作方式。ChatGPT 可以通过一项名为 Preview 的功能，将聊天中的一段 HTML 转换成一个小型网页。由于该网页可以承载任意代码，ChatGPT 会在一个单独的 Web 地址上使用受到严格限制的框架运行它，使其无法读取周围的主 ChatGPT 页面。</p><p>沙箱本身没有被突破。入口来自同一对话中的第二项功能。</p><p>共享的聊天中还包含一个交互式图表，绘制该图表时，会将一个名为 MathLive 的数学库加载到主 ChatGPT 页面中。加载 MathLive 后，页面上会留下一个监听器，用于接受与其屏幕键盘有关的消息。</p><p>只有在接收方检查消息发送者时，浏览器框架之间传递的消息才是安全的。Parameter 发现，这个监听器接受来自任意发送者的键盘消息，而且该消息还允许携带原始 HTML。随后，Preview 便可跨越边界，将攻击者的 HTML 交给受信任的主页面。</p><p>该 HTML 创建了一个新框架，浏览器会将其视为 chatgpt.com 的一部分。随后，从 YouTube 加载的脚本提供了在该框架内运行的代码。</p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEikYB9KX234zytCTLW_X4nluEXNf8q3e5kjOGQO5Fm07RpGvsrvFlpKmXp9H-gm4e0apQJNA-ADrDAdG0bVaxqyJ7ff3QxYtvjNgdM8xyLYS_iuAY-K1fh-jZPq1-8_pIiMWAFniMSXreU5Q-txcFeQH_Rrcwg37Vka97a2ApYagAzpoAsMvgG-EDV19zM/s1600/ch.png\"><img alt=\"\" src=\"/dailyinfo/media/055978ae8314ea78.webp\" loading=\"lazy\" decoding=\"async\"></a></p><p>ChatGPT 的内容安全策略限制了页面脚本的来源。它阻止内联代码，但允许来自 YouTube 的脚本，这正是该步骤得以实施的原因。</p><h3 id=\"sec-3\">OpenAI 修复了什么，用户应该做什么</h3><p>Parameter 表示，OpenAI 复现了代码执行和私人聊天概念验证，将严重程度从 P2 提升到 P1，并在 ChatGPT Web 前端的两个版本中推出修复。截至10月26日，这两个版本都会拒绝攻击所依赖的消息。</p><p>研究人员将问题追溯到三个相互叠加的设计选择：</p><ol>\n  <li>MathLive 响应了一条会在未经检查消息来源框架的情况下更改其设置的消息。</li>\n  <li>该消息被允许将原始 HTML 作为键盘布局数据携带。</li>\n  <li>该 HTML 可以创建一个未受沙箱隔离的框架，并继承 chatgpt.com 的身份。</li>\n</ol><p>YouTube 这一步只是最后的变通办法，而非根本原因。仅将其屏蔽，仍会留下一个不受信任的 Preview，能够将 HTML 推送到主站点。</p><p>ChatGPT 用户无需采取任何行动。修复工作由 OpenAI 负责，用户无需安装或重置任何东西。</p><p>Parameter 在修复完成后于 10 月 28 日发布了报告。OpenAI 为该报告支付了总计 $5,000。</p><p>觉得这篇文章有趣？欢迎关注我们的 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a>，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","复现","漏洞分析","大模型","利用链","Google","https://thehackernews.com/2026/10/a-shared-chatgpt-link-could-run.html","The Hacker News",{"_114":115,"_116":-5},"changelogVersion","2026-10-01T08:00","release"]
