[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795826450000,"id","rnegnddxf2wbjfu7xce6rt7o4","title","Drupal Fail2Install 漏洞 CVE-2026-132165 已在真实站点遭到利用","originalTitle","Drupal Fail2Install Exploit Details Emerge as Critical RCE Flaw Faces Active Exploitation","summary","Drupal Fail2Install 远程代码执行漏洞 CVE-2026-132165（CVSS 9.8）已被用于攻击真实站点，CISA 将其纳入 KEV，并要求联邦机构在 2026 年 11 月 27 日前完成修复。","reason","文章给出漏洞利用链、受影响版本和修复版本，并说明该漏洞已进入 KEV 且在真实站点遭到利用。","source",{"_74":96},"links",{"_87":95},"publishedAt","2026-11-25T11:23:26.000Z","discoveredAt","2026-11-25T12:21:35.939Z","timelineAt","category","disclosure","tags",[91,92,93,77,94,81],"score",90,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_61":86,"_87":-5,"_88":89,"_90":37},"outline",[],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fnn4Ufi2IC48","reportCount",2,"additionalSourceCount",1,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","research","name","技术研究","exploited","在野利用","vuln","漏洞披露","cisa","CISA",{"_83":84,"_13":85},"publicId","68465ab3-c70a-4fb8-879b-c2dcde061a85","Drupal安装器RCE漏洞CVE-2026-132165已被在野利用","<p><span><i></i><span>Ravie Lakshmanan</span><i></i><span>2026年11月25日</span></span><span>Web 安全 / 漏洞</span></p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhbChdPRqvJHt9cIG4Z1W9o12tl4thtxIDNNcntDjmIytSIC1PWvOytT0JjY0OJtnba6UVJcEmqNxgOMuWxX2pvNJzjQ70-CIeruqZEDdgaDG66Lv2T6lLMv8cEhrXRie1gcaLz6OoNw6f2822s2yz8jl958kok6WpHmZ7p_n3TRWTdEWSpr1le5T28kFQO/s1600/drupal.gif\"><img alt=\"\" src=\"/dailyinfo/media/770364575e27b960.gif\" loading=\"lazy\" decoding=\"async\"></a></p><p>美国网络安全和基础设施安全局（CISA）于周二将一个影响 <b>Drupal</b> 的严重缺陷<a href=\"https://www.cisa.gov/news-events/alerts/2026/11/24/cisa-adds-three-known-exploited-vulnerabilities-catalog\">加入</a>其已知被利用漏洞（<a href=\"https://www.cisa.gov/known-exploited-vulnerabilities-catalog\">KEV</a>）目录，并要求联邦机构在2026年11月27日前应用修复。</p><p>该漏洞追踪编号为 <b>CVE-2026-132165</b>，又称 <b>Fail2Install</b>（CVSS 评分：9.8），属于影响 Drupal 核心的远程代码执行（RCE）漏洞。</p><p>CISA 表示：“Drupal 核心包含一个无法安全失败处理的不安全漏洞，可能允许未经身份验证的攻击者接管现有站点，或通过 Drupal 安装程序执行任意代码。在特定条件下，攻击者可以使用 install.php 尝试在站点上重新安装 Drupal。”</p><p>此前，<a href=\"https://thehackernews.com/2026/11/drupal-patches-critical-installer-flaw.html\">The Hacker News</a> 曾报道称，攻击者可以使用安装程序尝试重新安装 Drupal，从而在某些情况下导致站点接管或远程代码执行。</p><p>根据 Searchlight Cyber 的一项<a href=\"https://www.slcyber.io/research/fail2install-system-limits-pre-auth-rce-drupal#sqlstatehy000-1040-too-many-connections\">独立分析</a>，普通的服务器资源限制可能会被滥用，使 Drupal 错误地认为现有网站尚未安装；攻击者随后可通过“install.php”进入其安装流程，创建一个由管理员控制的账户，并执行任意 PHP 代码。</p><p>虽然 Drupal 在允许安装继续之前设有检查机制，以确定网站是否已安装，但研究发现，可以通过耗尽服务器资源来绕过这些检查。</p><p>因此，无法连接到已配置数据库以及检查现有安装的数据库检查失败，都会被误认为是网站尚未安装的证据；而 Drupal 在赢得竞态条件后允许安装继续，该条件使第二次数据库连接检查得以通过。</p><p>为此，使用了三种资源耗尽技术：</p><ul>\n  <li><a href=\"https://man7.org/linux/man-pages/man2/getrlimit.2.html\">EMFILE</a>，即对 Linux 进程可打开文件数量的限制</li>\n  <li>数据库连接耗尽</li>\n  <li>TCP 源端口耗尽</li>\n</ul><p>这家网络安全公司表示：“我们从 EMFILE 开始，然后探索数据库和 TCP 限制，以确定可用性故障能否成为安全原语。”</p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiORFyxS3yE0lF8kmeaxCxIOpoOLID-RQkiFs4KlXEARXi6iXUfTPUY2NIqlyVYq6A876hFHEa6nYxg5TjogbAjLZj84iKc_vzOAb4199qjEIBMQePLCsNN1Fvt2GSi5eLDa0199Cm8nnImcZgOPIUN7SjNus3Vsv0VElSOcEyMKCLdL3Jm3pN2TFDG6OEP/s1600/Exploit-chain.png\"><img alt=\"\" src=\"/dailyinfo/media/942e808c0704caae.webp\" loading=\"lazy\" decoding=\"async\"></a></p><p>“将此方法应用于 Drupal 后，我们发现了一个影响 Drupal 8.9、9、10 和 11 的预身份验证 RCE 漏洞，涵盖四种常见部署组合：Apache 搭配 PostgreSQL、Apache 搭配 MySQL、PHP-FPM 搭配 PostgreSQL，以及 PHP-FPM 搭配 MySQL。”</p><p>利用 Drupal 安装程序支持 SQLite 数据库文件且允许在安装期间选择数据库路径这一事实，可以将这种行为转化为代码执行路径。其之所以可行，是因为安装程序并未限制文件扩展名。</p><p>Searchlight Cyber 表示：“通过选择文档根目录下以 .php 结尾的路径，安装程序会创建一个带有 PHP 扩展名的 SQLite 数据库。当安装进入站点配置表单时，Drupal 会将提交的网站名称存储在 SQLite 数据库中。将 PHP 代码用作网站名称，载荷字节就会被写入 .php 数据库文件中。”&nbsp;</p><p>在标准 Apache 部署中，生成的 PHP 文件的直接访问会被 Drupal 自带的 .htaccess 阻止，但 Apache RewriteRule 中路径处理 weaknesses 可被利用，以实现任意 PHP 执行。</p><p>Searchlight Cyber 研究人员 Kevin Gervot 和 Adam Kues 表示：“我们从三个系统范围的限制出发，展示了看似仅影响可用性的错误如何成为跨越安全边界的原语。”</p><p>“在 Drupal 中，临时数据库故障可能导致 FAIL、FAIL、然后 SUCCESS 的序列，从而在现有网站上重新打开安装程序，并最终通过包含 PHP 代码的 SQLite 数据库导致身份验证前 RCE。”</p><p>该问题已在以下版本中得到修复 -</p><ul>\n  <li>Drupal 11.4.x - 更新至 Drupal 11.4.13</li>\n  <li>Drupal 11.3.x - 更新至 Drupal 11.3.22</li>\n  <li>Drupal 10.6.x - 更新至 Drupal 10.6.22</li>\n</ul><p>CVE-2026-132165 被加入 KEV 目录<a href=\"https://www.drupal.org/sa-core-2026-017\">源于 Drupal 安全团队收到的一份报告</a>，称其“早在 2026-11-19 19:00 UTC 就在生产站点上遭到利用。”</p><p>值得注意的是，CVE-2026-132165 是今年第三个遭到主动利用的 Drupal 漏洞，此前还有<a href=\"https://thehackernews.com/2026/05/drupal-core-sql-injection-bug-actively.html\">CVE-2026-9082</a>（CVSS 分数：6.5）和<a href=\"https://thehackernews.com/2026/10/hackers-actively-exploit-highly.html\">CVE-2026-118539</a>（CVSS 分数：6.5）。</p><p>觉得这篇文章有意思？在<a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a> 上关注我们，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","漏洞分析","复现","漏洞利用","补丁","https://thehackernews.com/2026/11/drupal-fail2install-exploit-details.html","The Hacker News",{"_98":99,"_100":-5},"changelogVersion","2026-10-01T08:00","release"]
