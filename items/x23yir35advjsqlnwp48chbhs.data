[{"_1":2,"_3":4},"root",{"_5":116},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794195835000,"id","x23yir35advjsqlnwp48chbhs","title","AI coding agent 被诱导安装弃用 MCP server，部分服务器存在 4 个高危漏洞","originalTitle","AI coding agents are installing MCP servers that will never be patched","summary","Glow Labs 通过真实 AI coding session transcripts 发现，Claude Code、Cursor、Codex CLI 等 agent 会选择已归档且不再维护的 MCP server。","reason","真实编码会话记录显示，AI coding agent 会安装已归档且无人维护的 MCP server，现有 EDR、SCA 和软件清单因此难以发现风险。","source",{"_75":115},"links",{"_104":114},"publishedAt","2026-11-03T05:45:53.000Z","discoveredAt","2026-11-03T06:00:19.132Z","timelineAt","category","ai-security","tags",[76,108,109,110,111,112,113],"score",75,"selected",true,"channel","news","story",{"_88":89,"_13":90},"x","readingMode","full","author","Mirko Zorz","body",{"_61":103,"_104":-5,"_105":106,"_107":37},"outline",[91,92,93],"relatedStories",[87],"topics",[68,69,70,71,72,73],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fGhIGY6PYd-I","reportCount",1,"additionalSourceCount",0,{"_74":85,"_75":86},{"_74":83,"_75":84},{"_74":81,"_75":82},{"_74":79,"_75":80},{"_74":77,"_75":78},{"_74":31,"_75":76},"slug","name","AI 安全","research","技术研究","ai-offense","AI 攻防","ai-agent","AI Agent 安全","supply-chain","供应链安全","google","Google / 谷歌",{"_88":89,"_13":90},"publicId","6a2a19b7-e376-466d-be77-b8895c70478b","研究披露弃用MCP服务器带来代理高危漏洞",{"_11":101,"_95":102,"_97":98},{"_11":99,"_95":100,"_97":98},{"_11":94,"_95":96,"_97":98},"sec-3","text","谁可以解决这个问题","level",3,"sec-2","为何现有控制措施保持沉默","sec-1","四个漏洞，无补丁","<p>当开发者让 AI 编码代理“设置 GitHub MCP”时，代理必须选择一个软件包。Glow Labs 的新研究记录了若干会话，其中代理选择了一个来自已归档仓库的软件包，而该仓库以后不会再获得安全更新。</p><p><img src=\"/dailyinfo/media/77effded47443f26.webp\" loading=\"lazy\" decoding=\"async\" alt=\"deprecated MCP servers\" title=\"MCPhantom\"></p><h5>\n<p>来源：Glow Security</p>\n</h5><p>Glow Labs 在审查真实的 <a href=\"https://www.helpnetsecurity.com/2026/10/26/ai-coding-agents-malware-openai-codex/\">AI 编码</a>会话记录时，发现已弃用的 MCP 服务器被安装到开发者的机器上，并将这种现象称为 MCPhantom。在其中 98% 的会话里，代理似乎是从模型的训练数据中补全了软件包名称。另外 2% 中，用户点名要求使用旧软件包。该研究仅查看了安装或推荐了已弃用服务器的会话。</p><p>GitHub 维护着自己的 MCP 服务器。在 Glow Labs 记录的 GitHub 示例中，代理绕过了它，转而从训练数据中选取了一个已弃用的 Anthropic 参考服务器。该仓库已被归档，并声明不会再提供安全更新，但代理不会阅读归档通知。</p><p>同样的模式出现在 Claude Code、Cursor、Codex CLI、Claude Cowork 和 Claude chat，以及 Anthropic、OpenAI 和 xAI 的模型中。</p><h3 id=\"sec-1\">四个漏洞，无补丁</h3><p>这些参考服务器中发现了四个高危漏洞。最严重的是 Puppeteer 服务器中的远程代码执行漏洞，该漏洞允许代理操控浏览器。只需进行一次 <a href=\"https://www.helpnetsecurity.com/2026/04/24/indirect-prompt-injection-in-the-wild/\">提示注入</a>即可触发。代理会启动机器上的任意进程，而不是浏览器，并执行攻击者选择的任何命令。开发者批准了网页浏览，而这一项权限随后被扩展到涵盖其余操作，因此运行框架会将其放行。</p><p>Glow Labs 的报告因超出范围而被关闭，维护人员回复称，该服务器已于 2025 年 5 月归档且无人维护，因此不会从该仓库发布修复。他们确实表示会考虑将 npm 软件包标记为已弃用，以便用户收到警告，但已弃用的软件包仍可通过 npx 安装。目前尚未发现遭到利用的情况，而且也不会有补丁发布。</p><p>使用量并未随着弃用而下降。自 2025 年 7 月以来，Glow Labs 统计到的这些已弃用软件包已从 npm 下载超过 1730 万次，其中五个位列 npm 的 MCP 100 热门榜。</p><h3 id=\"sec-2\">为何现有控制措施保持沉默</h3><p>这些服务器属于永远不会出现在依赖文件中的依赖项。EDR 看到的是一个受信任的 Node 进程应代理请求安装一个公开的 npm 软件包，这看起来属于常规操作。SCA 没有清单可用，因为服务器通过 npx 运行，而且这些漏洞没有 CVE。软件清单工具从未登记过该应用，因此只有在端点上才能看到它。</p><p>让代理在安装前先进行查询也不是解决办法。“仅在安装前查询本身并不够，”Glow 的漏洞研究员 <a href=\"https://www.linkedin.com/in/nadav-claude-cohen-8533b2a2/\">Nadav Claude Cohen</a>告诉 Help Net Security。“在一次会话中，代理在 npm 上检查了该软件包，得到回复‘此软件包已弃用。’但它仍然安装了软件包，而且从未告知用户。”</p><h3 id=\"sec-3\">谁可以解决这个问题</h3><p>Cohen 认为修复方案可能来自四个方面：</p><ul>\n<li>运行框架厂商可以拒绝使用已弃用的服务器，或至少警告操作人员；还应涵盖已经安装的服务器，而不只是新安装的。不过，“这只有在每个运行框架都这么做时才有效。如果只有一个运行框架修复了问题，其他框架仍然会敞开心门。”</li>\n<li>模型厂商可以更新模型所掌握的信息：“只要模型的知识中仍包含旧软件包名称，代理就会继续安装它们”，不过“更新模型权重的成本非常高，因此这种情况不太可能发生。”</li>\n<li>软件包所有者可以修复这些漏洞，“这是唯一能够保护继续使用这些服务器的人的措施。”</li>\n<li>安全公司可以利用许多测试框架已经支持的执行前钩子：“这在今天就能用，无需等待测试框架制造商、模型制造商或软件包所有者的行动。”</li>\n</ul><p>卸载这些软件包并不可行。只有当某个软件包在过去一周内的下载量少于 300 次、仅有一个所有者且没有公开依赖项时，npm 才允许其所有者将其下架。Cohen 表示：“server-github 上周有 185,239 次下载，并有 6 个所有者。”npm 会移除包含恶意软件的软件包，但他没有发现因漏洞而移除软件包的案例。</p><p>安全团队可以先查找引用了已弃用的 @modelcontextprotocol 服务器的 MCP 配置，并在存在相应服务时切换到服务所有者的服务器，为每项服务批准一个服务器，同时将 npm 弃用状态纳入审批标准。</p><p>“该模型的记忆如今就像一个没有弃用反馈机制的包管理器，”<a href=\"https://www.glow.io/blogs/mcphantom-ai-coding-agents-are-installing-vulnerable-deprecated-mcp-servers-from-training-data\">表示</a>，Glow 研发副总裁 <a href=\"https://www.linkedin.com/in/ophir-arie-545489212/\">Ophir Arie</a>认为，各团队必须将智能体的决策视为可疑对象，并加以管控。</p><p><img src=\"/dailyinfo/media/8b86e87ed013cd36.gif\" loading=\"lazy\" decoding=\"async\"></p><p><strong>下载：<a href=\"https://helpnet.short.gy/XxvUaf\">IT 领导者指南：AI 代码蔓延</a></strong></p>","original","zhKind","translation","complete","AI 编码","大模型","Agent 安全","漏洞分析","供应链","Google","https://www.helpnetsecurity.com/2026/11/03/mcphantom-deprecated-mcp-servers/","Help Net Security",{"_117":118,"_119":-5},"changelogVersion","2026-10-01T08:00","release"]
