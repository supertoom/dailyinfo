[{"_1":2,"_3":4},"root",{"_5":100},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1793666563000,"id","r33vqb4ahc08c2y4ozgccut2g","title","疑似中国关联攻击者利用 PHP2Shell 在 25 台服务器取得 root 权限并渗透 Active Directory","originalTitle","PHP2Shell Attack Roots 25 Servers, Breaches U.S. Government-Affiliated Network","summary","疑似中国关联攻击者利用 PHP2Shell 与 Fragnesia 漏洞链，在美国、日本、台湾和韩国取得 25 台服务器 root 权限，其中包括美国政府关联环境的 3 台系统。","reason","source",{"_75":99},"links",{"_88":98},"publishedAt","2026-10-28T16:02:45.000Z","discoveredAt","2026-10-29T00:16:01.232Z","timelineAt","category","activity","tags",[78,80,94,95,96,97],"score",79,"selected",true,"channel","news","story",{"_84":85,"_13":86},"x","sameEvent",{"_11":92,"_13":93},"readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_62":87,"_88":-5,"_89":90,"_91":36},"outline",[],"relatedStories",[83],"topics",[69,70,71,72],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","fHGcqYHvClcY","reportCount",2,"additionalSourceCount",1,{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","malware","name","恶意软件","attack","攻击活动","exploited","在野利用","identity","身份与访问",{"_84":85,"_13":86},"publicId","e638ec71-f8e4-4857-8421-2e319766237e","PHP2Shell链攻陷25台PAN-OS服务器","<p><span><i></i><span>Ravie Lakshmanan</span><i></i><span>2026年10月28日</span></span><span>漏洞 / 网络间谍活动</span></p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgl3PPkqzXf7YyMcnwdBu5XWlOwWtUonf15z0n79qMtIOVTb4LNfKdnl7tUK-45_2boP9r2ZKuHmX6e1BZLmo-LYF-rUwH8gtNrynFuaX4rlNh20UXPvtIfC85BcKcHXK1qei6uOJyImSjTfO537yljJve0Y_zMlfFfhBl0mKPfppWhkfojtGlYgxLjdSO0/s1600/php-united.jpg\"><img alt=\"\" src=\"/dailyinfo/media/c1e203744b02ae88.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>网络安全研究人员披露了一起疑似由中国关联威胁组织策划的人工智能（AI）辅助攻击的细节，该组织利用 <a href=\"https://thehackernews.com/2026/10/cisa-confirms-active-exploitation-of.html\">PHP2Shell</a> 漏洞入侵了暴露在外的系统。</p><p>研究人员于2026年10月25日观察到相关活动。攻击者将 PHP2Shell 与一个内核权限提升漏洞结合使用，获取了25台服务器的 root 权限，其中包括美国政府关联环境中的三台系统。</p><p>网络安全公司 Dream <a href=\"https://dreamgroup.com/blog/chained-php2shell-exploit-roots-25-servers\">表示</a>：“受影响的设备运行着某大型厂商防火墙软件的具体版本。攻击者随后对 Active Directory 发起了攻击。恢复出的痕迹证实发生了凭据提取和目录枚举。”</p><p>受影响厂商的名称未被披露，但这家以色列公司表示已通知相关实体。整个攻击链将两组分别影响 PHP 和 Linux 内核的漏洞组合在一起——</p><ul>\n  <li><strong><a href=\"https://thehackernews.com/2026/10/cisa-confirms-active-exploitation-of.html\">PHP2Shell</a></strong>，两个以 CVE-2026-109618 和 CVE-2026-109619 跟踪的漏洞（CVSS 分数：9.2），可能导致未经身份验证的远程代码执行</li>\n  <li><strong><a href=\"https://thehackernews.com/2026/05/new-fragnesia-linux-kernel-lpe-grants.html\">Fragnesia</a></strong>，一个以 CVE-2026-46300 跟踪的 Linux 内核本地权限提升漏洞（CVSS 分数：7.8）</li>\n</ul><p>Dream 研究人员解释道：“我们恢复出的实现是定制的非公开版本，并非任何已知公开 PHP2Shell 利用代码的副本。它遵循相同的底层概念，但似乎经过独立开发，并专门针对被攻击的防火墙平台进行了调整。”</p><p>“该漏洞针对防火墙 appweb 管理服务器上的 PHP session.upload_progress 机制。防火墙操作系统使用 PHP 8.0.30，并设置了较高的内存限制，从而支持攻击中的内存破坏阶段。”</p><p>据称，对 PHP2Shell 利用链的定制化武器化与 CVE-2026-46300 结合后，使美国、日本、台湾和韩国的25台服务器被获取 root 权限。</p><p>Dream 发现的痕迹表明，该行动始于在实验室环境中开发利用代码，随后获取了美国某政府组织内部 Active Directory 域的持久访问权限。</p><p>该公司指出：“获取 root 权限后，攻击者便将目标锁定在美国政府关联环境中的三台特定服务器上。”</p><p>与 AI 辅助工具相关的线索来自攻击基础设施中安装 Anthropic Claude Code 的证据，以及基础设施中配置了 FOFA 和一个名为 aiscan 的 AI 驱动进攻性安全平台的 API 密钥，后者使用了来自 DeepSeek 和 Kimi 的大语言模型（LLM）。</p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiaxx8wfDKYDFFOw0TNItz_Q8w0NuKcGFhyphenhyphenWDU2OUthlSq_pye7Y413RXqAIEMLodQ8zFM8foL5B2hcXTNEGy0TkpWmlKXlTXyaCGR-gwUXlRxUhErOxrq7arHgnjdDD83y4eUU8Rc4BJRYm0Iq7t8PpyhWQrg6iawTqGIDo7_E36tE2CQE6ohysAiZGFiw/s1600/cncept.png\"><img alt=\"\" src=\"/dailyinfo/media/8ce4512533b6f584.webp\" loading=\"lazy\" decoding=\"async\"></a></p><p>此外，近40个脚本在代码结构、注释风格和一致性方面的高度统一，表明开发过程中使用了 AI 进行辅助。据 Dream 所述，整个行动过程如下——</p><ul>\n  <li>攻击者使用 FOFA 识别出全球约19,000台暴露管理接口且面向互联网的防火墙。</li>\n  <li>攻击者执行一个定制版本扫描器，以确定这些设备中哪些处于在线状态，以及它们运行的操作系统版本。约5,000台设备返回了版本信息。</li>\n  <li>攻击者将服务器筛选至位于美国、日本、台湾和韩国的服务器，随后将范围限定为运行 PHP 8.0.30 且符合较新发布分支的系统。此步骤产生 240 个目标。</li>\n  <li>目标列表被作为输入交给一个自动化批量运行程序，该程序利用 PHP2Shell-Fragnesia 攻击链，在防火墙上一个可公开访问的目录中植入 PHP Web Shell，验证 root 访问权限，并将目标的主机名和 IP 记录到 CSV 文件中。此步骤使攻击者能够获得 24 台服务器的 root 权限。</li>\n  <li>两台成功失陷的系统被确定属于与美国政府有关的组织。其中一台在 2026 年 10 月 23 日 6:14 p.m. UTC 获得 root 权限后不久便崩溃，并且再未恢复在线。攻击者开展了一次专门的行动，于 2026 年 10 月 24 日 10:09 a.m. UTC 成功取得第二台系统的 root 权限。</li>\n  <li>攻击者利用第二台系统建立一个持久通道，通过反向 SSH 隧道将失陷的防火墙连接回操作者的基础设施。11:35 a.m. UTC，第三台政府服务器以相同方式被攻陷，唯一的区别是这是一台内部防火墙管理服务器，只能通过该隧道访问。获得 root 权限的服务器总数达到 25 台。</li>\n  <li>攻击者以 Active Directory 为目标，解密 LDAP 服务账户密码、枚举用户，并使用以组织为主题的密码对每个用户账户进行密码喷洒，试图提取凭据。该行动还会尝试创建后门 Active Directory 账户。</li>\n</ul><p>尚不清楚这些活动是否使威胁行为者成功找到了有效凭据或创建了后门账户。因此，入侵的完整范围仍无法确定。</p><p>Dream 表示：“由于美国、日本、台湾和韩国是中国国家支持的网络行动在太平洋战区中的四个主要战略对手和情报目标，这表明可能存在国家行为者的行动。”</p><p>“这次行动说明，暴露的管理接口可能成为进入组织身份基础设施的路径。其余 22 台已取得 root 权限的防火墙仍停放着活跃的 Web Shell。通往美国政府组织的持久隧道很可能仍在运行。攻击者手中仍有 19,000 个已指纹识别的目标，他们可以在为更多操作系统版本建立特征档案时重新尝试利用。”</p><p>此次披露正值 PHP2Shell 漏洞在野利用仍较为有限之际；尽管威胁行为者将其<a href=\"https://akatsukilegion.com/post.php?slug=php2shell-cve-2026-109618-9-havoc-unc-actors-leveraging-public-exploit-code-against-public-business-and-educational-infrastructure\">整合进自己的攻击活动</a>，但他们强调，要将概念验证（PoC）转换为针对真实目标的可靠攻击向量仍面临挑战。</p><p>据 <a href=\"https://flare.io/learn/resources/blog/php2shell-exploits-underground-analysis\">Flare</a> 报道，XSS 论坛上使用 c0d3x 这一昵称的成员表示：“实际上，这是无法利用的垃圾东西。要利用真实目标，你需要获取 libphp.so 的偏移量，而每个构建版本都各不相同，无法通过暴力破解得出。你可以在自己的测试环境中复现，或者如果你已经能访问目标的文件系统，也可以进行复现。”</p><p>觉得这篇文章有意思吗？在 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a> 上关注我们，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","esq08xmlrobxme1f5rgmf8ke2","疑似中国国家级攻击者利用 PHP2Shell 与 Fragnesia 链式漏洞入侵 25 台 Palo Alto Networks 服务器","漏洞利用","后门","凭据","PHP","https://thehackernews.com/2026/10/php2shell-attack-roots-25-servers.html","The Hacker News",{"_101":102,"_103":-5},"changelogVersion","2026-10-01T08:00","release"]
