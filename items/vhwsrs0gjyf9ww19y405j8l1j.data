[{"_1":2,"_3":4},"root",{"_5":102},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795394442000,"id","vhwsrs0gjyf9ww19y405j8l1j","title","Signal 限制 iOS 27 与 Android 上的 OS 级 AI Agent 读取屏幕","originalTitle","Signal Is Blocking AI Agents From Reading Your Screen","summary","Signal 在 iOS 27 和 Android 上阻止 OS 级 AI Agent 读取其应用屏幕，防范 Gemini Intelligence 与 Siri AI 等功能捕获消息，macOS 暂未提供同等保护。","reason","source",{"_74":101},"links",{"_61":100},"publishedAt","2026-11-22T18:01:22.000Z","discoveredAt","2026-11-22T18:16:23.925Z","timelineAt","category","ai-security","tags",[76,94,95,96,97,98,99],"score",58,"selected",false,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","Pierluigi Paganini","body",{"_90":-5,"_61":91,"_92":-5,"_93":36},"outline",[85],"relatedStories",[81],"topics",[68,69,70,71],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fOi1JsF_SiCg","reportCount",2,"additionalSourceCount",1,{"_72":79,"_74":80},{"_72":77,"_74":78},{"_72":30,"_74":76},{"_72":73,"_74":75},"slug","blue-team","name","蓝队与运营","AI 安全","apple","Apple / 苹果","google","Google / 谷歌",{"_82":83,"_13":84},"publicId","aae0b52f-d7e1-4731-a260-ac5ba36ea7ba","Signal默认限制AI读取聊天屏幕",{"_11":86,"_87":88,"_89":65},"sec-1","text","Signal is blocking OS-level AI agents from reading its app on iOS 27 and Android","level","zh","<h2 id=\"sec-1\">Signal is blocking OS-level AI agents from reading its app on iOS 27 and Android, warning that Gemini and Siri AI threaten its privacy guarantees.</h2><p>Signal is restricting new AI agents built into iOS 27 and Android from capturing its data, president Meredith Whittaker announced. The company already did something similar on Windows last year, blocking screenshots to stop Microsoft’s Recall from capturing Signal messages by default. Now it’s doing the same wherever it can detect an AI assistant trying to read the Signal screen.</p><p>The process is simple, but it raises serious privacy concerns. Operating system-level AI agents, such as Google’s Gemini Intelligence and Apple’s Onscreen Awareness with Siri AI, scan the content displayed on your screen so they can answer questions and perform tasks for you.</p><p>This means these AI agents can capture your Signal data and use it to answer your questions and carry out your requests.</p><p><em>“In order to gain access to information about you, these OS AI agents “scan” the information that’s on your screen. In doing so, your Signal data is captured, then made available to these agentic systems in order to allow them to answer your questions and do your bidding.” reads the <a href=\"https://signal.org/blog/protecting-your-privacy/\">announcement</a>. “The net result is that these AI capabilities in the operating system are undermining Signal’s ability to independently guarantee privacy.”</em></p><p>Signal’s security model is based on open-source code and encryption that has been formally checked and reviewed by independent researchers for more than a decade. However, this protection can’t help if an AI agent reads your messages directly from the screen before encryption becomes relevant. Once captured, the data may be stored in a local database or sent to a remote server used by the AI agent, completely outside Signal’s control.</p><p>Google, Apple, and Microsoft aren’t just three companies among many here. </p><p><em>“these three operating systems are the oceans in which Signal, and other applications, must swim; they dictate the conditions of life for the application ecosystem.” continues the report. “Right now, these agentic AI integrations are changing this environment in a way that’s making it increasingly hostile to privacy.”</em></p><p>When the ocean starts working against the fish swimming in it, the fish can’t simply find a different ocean.</p><p>Signal’s fix is narrow: block screenshots on iOS 27, and block AI assistant screen capture attempts on Android. Users can turn the protection off in settings if they want to take screenshots, but doing so exposes their messages, and their contacts’ messages, to the same agents Signal is trying to keep out. The company is upfront that this doesn’t close every door, since an agent could still reach app data through the filesystem rather than the screen.</p><p>MacOS gets no protection at all right now, because Apple and Microsoft don’t give developers a clean way to block AI access without wrecking the normal user experience. Signal says it spent real engineering time just doing forensic work across Android and iOS to figure out what these AI systems actually do with app data, because the documentation isn’t there. That’s a strange place for a company Signal’s size to be: reverse-engineering the privacy behavior of the platforms it depends on.</p><p>Signal is asking Apple, Google, and Microsoft to take two specific steps. First, they should give app developers a clear way to prevent AI agents from accessing their data, including information on the screen, files, notifications, and APIs. Second, they should explain exactly how these AI agents access, collect, and process user data.</p><p>Signal also raises concerns about third-party AI agents such as Meta’s Muse, which can use accessibility permissions that users originally granted for other purposes. The company adds that confidential computing doesn’t solve the problem because the platform still controls the privacy decision, not the app developer or the user.</p><p>Signal says it’s already talking with Google and Apple about better support for apps that handle sensitive information. The company is cautiously optimistic, but whether these discussions lead to real changes will depend on what the two companies actually do over the coming year.</p><p>Signal frames the stakes plainly for anyone tempted to see this as one company’s problem.</p><p><em>“We all need to recognize that the current integration of AI agents into the operating system, without these common-sense remedies, represents an existential threat to privacy at the application layer, and the ability of independent developers like Signal to protect your sensitive data.” the report cocludes. “Signal is the canary in the coal mine, but this affects the entire ecosystem and should galvanize anyone who cares about these fundamental rights.”</em></p><p><strong>Follow me on Twitter:&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a><strong></strong></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;hacking,&nbsp;Signal)</strong></p>","zhKind","complete","模型安全","Agent 安全","加固","Google","Apple","Microsoft","https://securityaffairs.com/203742/ai/signal-is-blocking-ai-agents-from-reading-your-screen.html","Security Affairs",{"_103":104,"_105":-5},"changelogVersion","2026-10-01T08:00","release"]
