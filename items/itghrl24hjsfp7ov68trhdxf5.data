[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1794616829000,"id","itghrl24hjsfp7ov68trhdxf5","title","Apache HTTP/2 模块远程代码执行漏洞 CVE-2026-119618 影响 2.4.55 至 2.4.70，2.4.71 已修复","originalTitle","Critical Apache HTTP/2 Flaw Could Let Unauthenticated Attackers Execute Code Remotely","summary","Apache HTTP Server 的 HTTP/2 模块 mod_http2 存在严重漏洞 CVE-2026-119618，攻击者无需认证即可在服务器上执行代码并完全控制服务器进程，CVSS 评分 9.8。","reason","source",{"_71":96},"links",{"_78":95},"publishedAt","2026-11-12T05:12:26.000Z","discoveredAt","2026-11-12T05:34:07.504Z","timelineAt","category","vuln","tags",[84,85,86,87,88,89,90,91,92,93,94],"score",81,"selected",true,"channel","news","story",{"_74":75,"_13":76},"x","sameEvent",{"_11":82,"_13":83},"readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_62":77,"_78":-5,"_79":80,"_81":36},"outline",[],"relatedStories",[73],"topics",[69],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","fJ-NgiRpNVYE","reportCount",6,"additionalSourceCount",5,{"_70":30,"_71":72},"slug","name","漏洞披露",{"_74":75,"_13":76},"publicId","f7ee3fa3-8470-4dc6-9f4b-db1dac75a093","Apache mod_http2竞态漏洞公开PoC","<p><span><i></i><span>Swati Khandelwal</span><i></i><span>2026年11月12日</span></span><span>漏洞 / Web 安全</span></p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjLpi_uN6PmG2Gn1agNMsOrsCp324eH-utKkDl_SPe32ggjcWFPjxZSyeA1KvAtvI9SQ4VAN_zssvdJLJ59IXE8_-MatPOyFXY-FcwtL7HtfKyW3MtsKwglIe2X62WBOcUkPMv-klM1h8T2EBMWFOWyPG89bfbAHS5byyfXATXN_lUUJWmUGWChekyWxTQ/s1600/apache-http.jpg\"><img alt=\"\" src=\"/dailyinfo/media/a7ce710a419fc02a.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>Apache HTTP Server 的 HTTP/2 模块 <strong>mod_http2</strong>中存在一个严重漏洞，可让远程攻击者在服务器上运行代码。该漏洞追踪编号为 <strong>CVE-2026-119618</strong>，影响 2.4.55 至 2.4.70 版本，并在昨日发布的 2.4.71 版本中得到修复。</p><p>据 Red Hat 表示，只有启用了 HTTP/2 的服务器才会受到影响；Red Hat 将该服务器作为 Red Hat Enterprise Linux 的一部分提供。</p><p>这家 Linux 厂商表示，能够访问服务器的攻击者无需进行身份验证即可利用该漏洞，并可能完全控制服务器进程。该漏洞在 CVSS 评分体系中的评分为 10 分中的 9.8 分。</p><p>该厂商昨日发布的评估还表示，“公开研究已经证明，在启用 mod_http2 的默认配置服务器上存在可靠利用方法”。但评估未提及该研究的名称，也未提供相关链接。安全公司 Wiz 当日稍后表示，当时尚无可用利用方法，也没有收到在野利用的报告。</p><p>正如 <a href=\"https://httpd.apache.org/docs/2.4/mod/mod_http2.html\">模块文档</a>所解释的，只有在 Protocols 指令启用 HTTP/2 的情况下，HTTP/2 才会运行。该指令使用 h2 表示基于 TLS 的 HTTP/2，使用 h2c 表示基于明文 TCP 的 HTTP/2。它可以为整个服务器设置，也可以为单个虚拟主机设置，因此管理员应检查服务器范围的设置以及每个虚拟主机。</p><p>该模块的独立构建版本以 mod_h2 的形式在 GitHub 上发布，其中 2.0.8 至 2.0.42 版本受到影响。</p><p>运行 Apache HTTP Server 项目自身发行版本的管理员应升级至 2.4.71 版本，这是其 <a href=\"https://httpd.apache.org/security/vulnerabilities_24.html#CVE-2026-119618\">安全公告</a>中指定的修复版本。该版本还修复了 mod_md 中一个被评为重要级别的崩溃漏洞，以及 mod_vhost_alias 中一个被评为低危级别的单字节栈内存覆写问题。</p><p>下表中的发行版均提供各自构建的服务器，并采用各自的软件包版本号。例如，在 Red Hat Enterprise Linux 9 中，修复以 mod_http2-2.0.26-7.el9_9.1 的形式提供。</p><p>Red Hat 昨日为 Red Hat Enterprise Linux 9 和 10 发布了修复，并将该漏洞在这些发行版中的严重程度评为重要，而非严重。根据该厂商的 <a href=\"https://access.redhat.com/security/cve/cve-2026-119618\">严重程度评估</a>，其 mod_http2 软件包为每个 HTTP/2 流提供独立的内存分配器，使攻击变得困难得多。Red Hat Enterprise Linux 8 及更早版本不包含存在漏洞的代码。</p><table>\n  <tbody>\n       <tr>\n      <th>平台</th>\n      <th>状态</th>\n      <th>修复软件包</th>\n    </tr>\n    <tr>\n      <td>Apache HTTP Server 项目发行版</td>\n      <td>已修复</td>\n      <td>2.4.71</td>\n    </tr>\n    <tr>\n      <td>Red Hat Enterprise Linux 9</td>\n      <td>已修复（RHSA-2026:98981）</td>\n      <td><code>mod_http2-2.0.26-7.el9_9.1</code></td>\n    </tr>\n    <tr>\n      <td>Red Hat Enterprise Linux 10</td>\n      <td>已修复（RHSA-2026:98978）</td>\n      <td><code>mod_http2-2.0.29-5.el10_3.1</code></td>\n    </tr>\n    <tr>\n      <td>Red Hat Enterprise Linux 9.4 Update Services for SAP Solutions，以及 9.6、9.8、10.0 和 10.2 Extended Update Support</td>\n      <td>已修复（RHSA-2026:98968、RHSA-2026:98954、RHSA-2026:98982、RHSA-2026:98953 和 RHSA-2026:98979）</td>\n      <td>参阅各安全公告</td>\n    </tr>\n    <tr>\n      <td>Red Hat Enterprise Linux 6、7 和 8</td>\n      <td>不受影响</td>\n      <td>无需修复</td>\n    </tr>\n    <tr>\n      <td>Red Hat JBoss Core Services 和 Red Hat Hardened Images</td>\n      <td>受影响，未列出修复</td>\n      <td>未列出</td>\n    </tr>\n    <tr>\n      <td>Debian unstable (sid)</td>\n      <td>已修复</td>\n      <td><code>apache2 2.4.71-1</code></td>\n    </tr>\n    <tr>\n      <td>Debian bookworm、trixie 和 forky</td>\n      <td>存在漏洞</td>\n      <td>未列出</td>\n    </tr>\n    <tr>\n      <td>Amazon Linux 2 (Core)、Amazon Linux 2023 和 Amazon Linux 2027 Preview</td>\n      <td>等待修复</td>\n      <td>未列出</td>\n    </tr>\n    <tr>\n      <td>Ubuntu</td>\n      <td>无状态页面</td>\n      <td>未列出</td>\n    </tr>\n  </tbody>\n</table><p>Debian 各行数据来自 Debian 的 <a href=\"https://security-tracker.debian.org/tracker/CVE-2026-119618\">安全追踪器</a>，Amazon 一行数据来自 <a href=\"https://explore.alas.aws.amazon.com/CVE-2026-119618.html\">Amazon Linux 追踪器</a>。The Hacker News 今天检查时，Ubuntu 的 CVE 追踪器中尚无该漏洞的页面。</p><p>Apache HTTP Server 公告未提供任何变通方案。在其<a href=\"https://www.wiz.io/blog/cve-2026-119618-rce-apache-http-server-vulnerability\">漏洞分析</a>中，Wiz 建议暂时无法更新的管理员从 Protocols 指令中移除 h2 和 h2c，仅保留 Protocols http/1.1。</p><p>独立的 mod_h2 项目迄今尚未发布修复版本。其在 GitHub 上的<a href=\"https://github.com/icing/mod_h2/releases\">版本发布列表</a>止于 2.0.42，这是最后一个受影响的版本；该仓库自 6 月 9 日归档以来一直处于只读状态。上述对 Protocols 的更改同样适用于使用这些构建版本的服务器。</p><p>该漏洞由 Anthropic 的 OSS Scanner 于 10 月 26 日报告。这是一项面向开源项目的<a href=\"https://thehackernews.com/2026/10/anthropic-launches-free-ai.html\">免费扫描服务</a>，使用该公司的 AI 模型。Google Cloud Vulnerability Research 的 Anthony Weems 和 Simon Scannell 于上周报告了该漏洞。</p><p>一个<a href=\"https://thehackernews.com/2026/05/critical-apache-http2-flaw-cve-2026.html\">较早的 HTTP/2 漏洞</a>CVE-2026-23918 已在 5 月 4 日发布的 2.4.67 版本中得到修复。已更新至该版本或截至 2.4.70 的任何后续版本的服务器，仍在运行受这个新漏洞影响的版本。</p><p>觉得这篇文章有意思？欢迎关注我们的 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a>，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","wsj9gmwajcglomdxl9m654rps","Apache HTTP Server 远程代码执行漏洞 CVE-2026-119618 已公开 PoC","漏洞","补丁","复现","漏洞利用","网络设备","Microsoft","Red Hat","Debian","AWS","Ubuntu","Google","https://thehackernews.com/2026/11/critical-apache-http2-flaw-could-let.html","The Hacker News",{"_98":99,"_100":-5},"changelogVersion","2026-10-01T08:00","release"]
