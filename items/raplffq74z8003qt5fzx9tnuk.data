[{"_1":2,"_3":4},"root",{"_5":106},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794444097000,"id","raplffq74z8003qt5fzx9tnuk","title","Zyxel 修复 CVE-2026-107441，漏洞已被用于入侵全球近 1,000 台 GS1900 交换机","originalTitle","Zyxel fixes zero-day exploited to hack nearly 1,000 network switches","summary","Zyxel 已修复 GS1900 网络交换机漏洞 CVE-2026-107441，攻击者已利用该漏洞在全球 48 个国家入侵 996 台设备并窃取配置文件、哈希 root 凭据和网络信息。","reason","材料还原了漏洞被误判、绕过旧补丁并在 48 个国家受攻击的识别过程，可用于理解补丁验证与真实利用链之间的差距。","source",{"_74":105},"links",{"_95":104},"publishedAt","2026-11-04T20:58:19.000Z","discoveredAt","2026-11-04T21:40:21.750Z","timelineAt","category","vuln","tags",[99,75,100,101,102,103],"score",73,"selected",true,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","Lawrence Abrams","body",{"_61":94,"_95":-5,"_96":97,"_98":37},"outline",[85,86],"relatedStories",[81],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","f1yq2W5eTKxQ","reportCount",1,"additionalSourceCount",0,{"_72":79,"_74":80},{"_72":77,"_74":78},{"_72":31,"_74":76},{"_72":73,"_74":75},"slug","exploited","name","在野利用","漏洞披露","black-market","数据窃取与黑产","ransomware","勒索软件",{"_82":83,"_13":84},"publicId","604e73cf-d835-4e7e-821d-72ba31298114","Zyxel GS1900首个补丁失效",{"_11":92,"_88":93,"_90":91},{"_11":87,"_88":89,"_90":91},"sec-2","text","发现现有防御可能遗漏的电子邮件威胁。","level",2,"sec-1","与零日缺陷相关的攻击","<p><img alt=\"Zyxel\" height=\"900\" src=\"/dailyinfo/media/98ce959387dd7b82.jpg\" srcset=\"/dailyinfo/media/557960906dca5d4c.jpg 720w, /dailyinfo/media/3a529c71f6b456bc.jpg 1200w, /dailyinfo/media/98ce959387dd7b82.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>Zyxel 已修补其 GS1900 系列网络交换机中的一项零日漏洞。黑客曾利用该漏洞入侵全球近 1,000 台设备，窃取配置文件和凭据。</p><p>该漏洞编号为 CVE-2026-107441，是交换机 Web 管理界面中的越界写入缺陷。具备网络访问权限且未经身份验证的攻击者，可通过特制的 HTTP 请求执行操作系统命令。</p><p>该缺陷影响十款 GS1900 交换机型号。Zyxel 于 10 月 22 日发布安全更新，并于 11 月 3 日发布<a href=\"https://www.zyxel.com/global/en/support/security-advisories/zyxel-security-advisory-for-out-of-bounds-write-vulnerability-in-gs1900-series-switches-11-03-2026\">安全公告</a>。</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/9c019570e7735ebd.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>然而，该漏洞起初被误认为是 Zyxel 早在攻击开始前数月便已修补的一项旧缺陷。</p><h2 id=\"sec-1\">与零日缺陷相关的攻击</h2><p>2026 年 6 月 16 日，Zyxel <a href=\"https://www.zyxel.com/global/en/support/security-advisories/zyxel-security-advisory-for-stack-based-buffer-overflow-vulnerability-in-gs1900-series-switches-06-16-2026\">发布安全更新</a>，修复了 CVE-2026-7273。这是一项预身份验证缓冲区溢出漏洞，影响同一系列 GS1900 交换机。</p><p>自 8 月 17 日左右起，网络安全公司 GreyNoise 观察到一名被称为 Kapibala、疑似使用中文的威胁行为者利用 Zyxel 交换机，并报告称<a href=\"https://www.bleepingcomputer.com/news/security/chinese-hackers-exploit-multiple-technologies-to-steal-govt-data/\">攻击者入侵了 48 个国家的 996 台设备</a>。</p><p>威胁行为者利用该漏洞远程执行命令，随后下载一个脚本，用于收集设备配置、root 凭据哈希和网络信息。</p><p>GreyNoise 将 Kapibala 与 Red Heron 黑客攻击活动关联起来。此前，<a href=\"https://www.acronis.com/en/tru/posts/red-heron-exploits-gitea-n-day-flaw-in-multinational-campaign-exposing-new-linux-rootkit/\">Acronis 曾报告称</a>，该活动利用了自托管 Git 服务 Gitea 中的一项严重漏洞。</p><p>GreyNoise 于 9 月 21 日披露此次活动时，将相关漏洞利用归因于 CVE-2026-7273，即 Zyxel 曾在 6 月修补的漏洞。</p><p>同日，<a href=\"https://www.bleepingcomputer.com/news/security/cisa-orders-feds-to-patch-actively-exploited-zyxel-flaw-by-thursday/\">CISA&nbsp;将 CVE-2026-7273</a>加入其已知被利用漏洞目录，要求联邦机构处理该缺陷。</p><p>然而，固件安全公司 <a href=\"http://www.binarly.io/blog/zyxel-gs1900-rce-cve-2026-107441\">Binarly 的研究人员发现</a>，攻击中使用的漏洞利用实际上针对的是另一项此前未知且尚未修补的漏洞。</p><p>在调查与 JITTERLY 后门和 SIXZUT rootkit 关联的 Red Heron 基础设施时，Binarly 研究人员发现了一个暴露的压缩包，其中包含针对 Zyxel GS1900 交换机的混淆 Python 漏洞利用程序。</p><p>研究人员分析该漏洞利用后发现，它会专门检查已针对 CVE-2026-7273 修补的固件版本，表明该漏洞利用程序已经针对这些版本开发或更新。</p><p>Binarly 于 9 月 28 日确认，针对 CVE-2026-7273 修补的全部十个固件版本仍然容易受到该漏洞利用攻击。</p><p>研究人员认定，先前的安全更新增加了防止缓冲区溢出的检查，但攻击者可以在参数计数器验证之前对其进行破坏，从而绕过这些检查。</p><p>这使得攻击者无需身份验证即可覆写内存并执行命令，即使交换机运行了先前的安全更新也同样如此。</p><p>Binarly 于 9 月 29 日将调查结果报告给 Zyxel。该厂商于 10 月 11 日确认了这项新漏洞，并将其编号定为 CVE-2026-107441。</p><p>Zyxel 将其归类为一项独立缺陷，因为该漏洞利用程序还滥用了未验证 HTTP 参数长度的问题。</p><p>10 月 22 日，Zyxel 发布了新的固件更新，限制参数大小，并在将数据复制到内存前验证参数数量，从而阻止了这一漏洞利用技术。</p><p>虽然恢复出的漏洞利用程序专门针对已修补 CVE-2026-7273 的固件，但尚不清楚它是为了故意绕过这些更新而开发的，还是利用了早期补丁未能解决的相关漏洞。</p><p>建议受影响 Zyxel GS1900 交换机的管理员安装最新固件更新，以防范 CVE-2026-107441。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/0c6c2476908e136e.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-2\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体会分析电子邮件意图、上下文和行为，揭示网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>通过针对 Microsoft 365 或 Google Workspace 的 14 天只读扫描，查看有哪些威胁能够穿透防御，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始免费电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","漏洞","补丁","漏洞利用","网络设备","数据窃取","https://www.bleepingcomputer.com/news/security/zyxel-fixes-zero-day-exploited-to-hack-nearly-1-000-network-switches/","BleepingComputer",{"_107":108,"_109":-5},"changelogVersion","2026-10-01T08:00","release"]
