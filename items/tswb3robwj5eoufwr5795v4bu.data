[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795135244000,"id","tswb3robwj5eoufwr5795v4bu","title","NLTK CCG lexicon 解析器深度递归漏洞可导致拒绝服务","originalTitle","NLTK: Uncontrolled recursion in CCG lexicon parser causes denial of service via deeply nested category input","summary","NLTK 的 CCG lexicon 解析器未限制嵌套类别深度，攻击者提交深度嵌套输入可触发未处理的 RecursionError，终止解析操作或请求 worker，对应 CWE-674。修复已合并至 develop，解析深度上限设为 MAX_PARSE_DEPTH=500 并抛出 ValueError，但尚未发布包含该修复的版本；v3.10.3 不受影响。","reason","source",{"_71":84},"links",{"_59":83},"publishedAt","2026-11-19T23:52:54.000Z","discoveredAt","2026-11-20T00:02:20.184Z","timelineAt","category","vuln","tags",[80,81,82,74],"score",43,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","readingMode","full","author","body","outline",[],"relatedStories",[76],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","f5FbG36etEGo","reportCount",1,"additionalSourceCount",0,{"_69":30,"_71":75},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","research","name","技术研究","exploited","在野利用","漏洞披露",{"_77":78,"_13":79},"publicId","8aeebb98-69ba-4696-ba12-f69dc380d236","NLTK CCG解析器递归失控漏洞","漏洞","复现","漏洞分析","https://github.com/advisories/GHSA-3h95-x772-4765","GitHub 安全公告",{"_86":87,"_88":-5},"changelogVersion","2026-10-01T08:00","release"]
