[{"_1":2,"_3":4},"root",{"_5":121},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1794185108000,"id","x2ew7ai8lvpgva9yqyjzl0liz","title","OpenSSH sshd 认证绕过漏洞 CVE-2026-123158 已复现，OpenSSH 10.6p2 修复","originalTitle","【已复现】musl 无 PAM 环境可绕过口令认证——OpenSSH sshd 认证绕过漏洞（CVE-2026-123158）","summary","OpenSSH sshd 在 Linux + musl libc、未启用 PAM 且开启口令认证时存在认证绕过漏洞 CVE-2026-123158，攻击者无需有效口令即可登录锁定标记为 * 的账号。","reason","source",{"_73":120},"links",{"_110":119},"publishedAt","2026-11-06T09:32:00.000Z","discoveredAt","2026-11-07T03:28:32.625Z","timelineAt","category","disclosure","tags",[113,114,115,116,117,118],"score",66,"selected",false,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","body",{"_60":109,"_110":-5,"_111":110,"_112":55},"outline",[85,86,87,88,89,90,91],"relatedStories",[81],"topics",[67,68,69,70],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","fzUO_fe4BW-w","reportCount",2,"additionalSourceCount",1,{"_71":79,"_73":80},{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","blue-team","name","蓝队与运营","research","技术研究","vuln","漏洞披露","chaitin","长亭科技",{"_82":83,"_13":84},"publicId","9752aa65-824d-43a4-962f-2d752946dc78","OpenSSH musl认证绕过漏洞可致RCE",{"_11":107,"_93":108,"_95":96},{"_11":105,"_93":106,"_95":96},{"_11":103,"_93":104,"_95":96},{"_11":101,"_93":102,"_95":96},{"_11":99,"_93":100,"_95":96},{"_11":97,"_93":98,"_95":96},{"_11":92,"_93":94,"_95":96},"sec-7","text","参考资料","level",3,"sec-6","临时缓解方案","sec-5","升级修复方案","sec-4","处置优先级：高","sec-3","利用条件","sec-2","漏洞影响","sec-1","漏洞成因","<p><span>长亭安全应急响应中心</span> <span>2026-11-06 17:32</span> <span>浙江</span></p><p><img src=\"/dailyinfo/media/bf1f6a7722f704a2.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>检测业务是否受到此漏洞影响，请联系长亭应急服务团队！</p><p><img alt=\"OpenSSH sshd 认证绕过漏洞风险提示\" src=\"/dailyinfo/media/9d978c7503cac294.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><span>OpenSSH 是广泛使用的 SSH 协议实现，其 sshd 组件主要用于远程登录、命令执行和安全文件传输，广泛应用于 Linux 服务器、云主机、容器镜像及网络设备等场景。</span></p><p><span>2026 年 11 月，长亭安全应急响应中心监测到 OpenSSH sshd 在 musl libc 且未启用 PAM 的 Linux 环境中存在口令认证绕过风险（CVE-2026-123158）。攻击者仅需网络访问，即可使用超长口令登录口令被设为&nbsp;</span><code><span>*</span></code><span>&nbsp;的账号。截至通告发布，官方已在 OpenSSH 10.6p2 中修复，建议相关用户尽快升级或临时关闭口令认证。</span></p><p><strong><span>漏洞描述</span></strong><span><span>&nbsp;Description&nbsp;</span></span></p><p><strong><span>01</span></strong></p><h3 id=\"sec-1\"><span>漏洞成因</span></h3><p><span>2016 年，OpenSSH 为统一口令校验的耗时引入了借用盐值的机制：目标账号没有真实口令哈希时，sshd 会借用其他账号的盐值计算一次口令哈希。musl libc 的口令哈希函数在口令超长等失败场景下返回单字符&nbsp;</span><code><span>*</span></code><span>，而锁定账号保存的标记同样是&nbsp;</span><code><span>*</span></code><span>；OpenSSH 10.6p1 及更早版本在未启用 PAM 时直接比较两者，未校验标记长度，导致失败返回值被误判为匹配。OpenSSH 10.6p2 增加了最小长度校验，修复该问题。</span></p><h3 id=\"sec-2\"><span>漏洞影响</span></h3><p><span>攻击者可绕过口令认证，登录口令被设为&nbsp;</span><code><span>*</span></code><span>、本应拒绝所有口令的账号。此类账号常见于 root、仅密钥部署账号、LDAP 占位账号及 Alpine 云镜像默认用户；若该账号可免密提权，攻击者可能进一步取得 root 权限，导致服务器被完全控制或敏感数据泄露。该问题不影响所有 OpenSSH 部署，实际范围取决于是否使用 musl libc、是否启用 PAM 以及账号配置。该问题已分配 CVE-2026-123158，CVE 记录给出的 CVSS 3.1 基础评分为 8.1。</span></p><h3 id=\"sec-3\"><span>利用条件</span></h3><ul><li><p><span>sshd 运行于 musl libc 环境，且未启用 PAM，常见于 Alpine、OpenWrt、Buildroot、Yocto 及部分容器镜像。</span></p></li><li><p><span>目标 sshd 开启口令认证，即&nbsp;</span><code><span>PasswordAuthentication yes</span></code><span>。</span></p></li><li><p><span>目标账号的口令锁定标记为&nbsp;</span><code><span>*</span></code><span>，且系统中另有使用真实哈希的账号供 sshd 取盐。</span></p></li><li><p><span>攻击者能够提交超过 256 字节的口令；公开分析给出的可触发区间为 257 至 1024 字节。</span></p></li></ul><h3 id=\"sec-4\"><span>处置优先级：高</span></h3><p><strong><span>漏洞类型：</span></strong><span>&nbsp;认证绕过</span></p><p><strong><span>漏洞危害等级：</span></strong><span>&nbsp;高</span></p><p><strong><span>触发方式：</span></strong><span>&nbsp;网络远程</span></p><p><strong><span>权限认证要求：</span></strong><span>&nbsp;无需权限</span></p><p><strong><span>系统配置要求：</span></strong><span>&nbsp;需要特定配置</span></p><p><strong><span>用户交互要求：</span></strong><span>&nbsp;无需用户交互</span></p><p><strong><span>利用成熟度：</span></strong><span>&nbsp;POC/EXP 已公开</span></p><p><strong><span>修复复杂度：</span></strong><span>&nbsp;低，官方已提供修复方案</span></p><p><strong><span>影响版本</span></strong><span><span>&nbsp;Affects&nbsp;</span></span></p><p><strong><span>02</span></strong></p><p><span>OpenSSH 7.3-10.6p1</span></p><p><strong><span>受影响：</span></strong><span>&nbsp;Linux + musl libc、sshd 未启用 PAM 且开启口令认证的部署，常见于 Alpine、OpenWrt、Buildroot、Yocto 及基于这些系统的容器和云镜像。</span></p><p><strong><span>不受影响：</span></strong><span>&nbsp;主流 glibc 发行版、启用 PAM 的 sshd，以及 Dropbear、OpenBSD。</span></p><p><strong><span>解决方案</span></strong><span><span>&nbsp;Solution&nbsp;</span></span></p><p><strong><span>03</span></strong></p><h3 id=\"sec-5\"><span>升级修复方案</span></h3><p><span>建议升级至 OpenSSH 10.6p2 或更高版本。官方发布说明见 <a href=\"https://www.openssh.com/releasenotes.html#10.6p2\">https://www.openssh.com/releasenotes.html#10.6p2</a> 。使用发行版软件包的用户应更新至发行版发布的安全版本，部分发行版已回移修复；自行编译的用户应重新编译并替换 sshd，升级后重启服务。</span></p><h3 id=\"sec-6\"><span>临时缓解方案</span></h3><p><span>以下方案为应急临时措施，可能影响业务功能，升级完成后应及时移除。</span></p><p><span>若无法立即升级，建议临时将&nbsp;</span><code><span>PasswordAuthentication</span></code><span>&nbsp;设为&nbsp;</span><code><span>no</span></code><span>，仅保留密钥或其他认证方式，并限制 SSH 服务的网络可达范围。同时应排查认证日志中口令被设为&nbsp;</span><code><span>*</span></code><span>&nbsp;的账号是否出现&nbsp;</span><code><span>Accepted password</span></code><span>&nbsp;记录。</span></p><p><strong><span>漏洞复现</span></strong><span><span>&nbsp;Reproduction&nbsp;</span></span></p><p><strong><span>04</span></strong></p><p><span>长亭安全应急响应中心已完成复现验证。在 Linux + musl libc、sshd 未启用 PAM 的验证环境中，攻击者无需有效口令即可登录口令锁定标记为&nbsp;</span><code><span>*</span></code><span>&nbsp;的账号。</span></p><p><img src=\"/dailyinfo/media/c8547c87b4cd82de.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span>长亭安全应急响应中心复现验证结果</span></p><p><strong><span>时间线</span></strong><span><span>&nbsp;Timeline&nbsp;</span></span></p><p><strong><span>05</span></strong></p><p><span>2026 年 11 月 6 日 长亭安全应急响应中心发布通告</span></p><h3 id=\"sec-7\"><span>参考资料</span></h3><p><span>[1]. <a href=\"https://www.cve.org/CVERecord?id=CVE-2026-123158\">https://www.cve.org/CVERecord?id=CVE-2026-123158</a></span></p><p><span>[2]. <a href=\"https://www.openssh.com/releasenotes.html#10.6p2\">https://www.openssh.com/releasenotes.html#10.6p2</a></span></p><p><span>[3]. <a href=\"https://hachyderm.io/@damienmiller/117563026759098135\">https://hachyderm.io/@damienmiller/117563026759098135</a></span></p><p><span>[4]. <a href=\"https://sshhole.com/\">https://sshhole.com/</a></span></p><p><strong><span>长亭应急响应服务</span></strong></p><p><span>全力进行产品升级</span></p><p><span>及时将风险提示预案发送给客户</span></p><p><span>检测业务是否受到此次漏洞影响</span></p><p><span>请联系长亭应急服务团队</span></p><p><span>7*24小时，守护您的安全</span></p><p><span>第一时间找到我们：</span></p><p><span>邮箱：support@chaitin.com</span></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=91e94186&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzIwMDk1MjMyMg%3D%3D%26mid%3D2247493507%26idx%3D2%26sn%3D20fd2ebdcbe5b1736a9db2e6bef1dfe0\">跳转微信打开</a></p>","original","zhKind","complete","复现","漏洞分析","漏洞利用","补丁","加固","长亭","https://mp.weixin.qq.com/s?__biz=MzIwMDk1MjMyMg==&mid=2247493507&idx=2&sn=20fd2ebdcbe5b1736a9db2e6bef1dfe0","长亭安全应急响应中心",{"_122":123,"_124":-5},"changelogVersion","2026-10-01T08:00","release"]
