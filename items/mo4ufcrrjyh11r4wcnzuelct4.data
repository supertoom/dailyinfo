[{"_1":2,"_3":4},"root",{"_5":106},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794195831000,"id","mo4ufcrrjyh11r4wcnzuelct4","title","Insignary 发布 insignary-chk，检测 PHP2Shell 与 Node2Shell 暴露","originalTitle","Insignary Releases Free Insignary-Chk Tool to Detect PHP2Shell and Node2Shell Exposure","summary","Insignary 发布免费只读扫描工具 insignary-chk，用于检查 Linux 服务器和容器镜像中的 PHP2Shell 与 Node2Shell，涉及 CVE-2026-109618、CVE-2026-109619 和 CVE-2026-111497。","reason","该工具面向 Linux 服务器与容器环境，可只读检查运行时的 3 个 CVE，并按处置紧迫性排序结果，适合用于快速确认暴露情况。","source",{"_76":105},"links",{"_93":104},"publishedAt","2026-11-06T12:50:05.000Z","discoveredAt","2026-11-06T18:24:29.288Z","timelineAt","category","blue-team","tags",[97,83,81,98,99,100,101,102,103],"score",77,"selected",true,"channel","news","story",{"_89":90,"_13":91},"x","readingMode","full","author","CyberNewswire","body",{"_61":92,"_93":-5,"_94":95,"_96":37},"outline",[],"relatedStories",[88],"topics",[68,69,70,71,72,73],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fM46EeXly3uQ","reportCount",1,"additionalSourceCount",0,{"_74":86,"_76":87},{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","tools","name","工具与平台","research","技术研究","exploited","在野利用","vuln-mgmt","漏洞管理","cloud-native","云与原生","supply-chain","供应链安全",{"_89":90,"_13":91},"publicId","898b5ca8-f716-4cd1-847e-aeeca9ee8522","Insignary发布漏洞暴露检测工具","<p><span><strong>加拿大多伦多，2026年11月6日，CyberNewswire</strong></span></p><p><strong>免费只读扫描器帮助组织发现暴露于 PHP 和 Node.js 中两个正被积极利用漏洞的 Linux 服务器和容器镜像</strong></p><p><img src=\"/dailyinfo/media/02e15101c7cb1c11.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><a href=\"https://insignary.com/\">Insignary</a> 是一家全球开源安全公司，该公司今日发布了 insignary-chk，这是一款免费工具，可检查 PHP2Shell 和 Node2Shell，即最近披露的、影响 PHP 和 Node.js 的两个运行时漏洞。</p><p>PHP2Shell 指的是 PHP 运行时中的两个漏洞（CVE-2026-109618 和 CVE-2026-109619），二者在 CVSS v4.0 下的评分均为 9.2（严重），可能允许未经身份验证的攻击者远程执行代码。使用 PHP 处理 Web 请求的服务器面临风险，其中包括使用 Apache mod_php、PHP-FPM、php-cgi、FrankenPHP 和 LiteSpeed 的部署。PHP 项目于 2026年10月21日发布了修复版本：PHP 8.5.12、8.4.27、8.3.36 和 8.2.35。PHP 8.1 及更早版本已结束生命周期，不再接收官方发布。由于这些缺陷位于运行时本身而非应用程序代码中，仅靠代码审查无法发现，因此组织还需要查找捆绑在供应商软件和容器镜像中的 PHP 实例。</p><p>Node2Shell（CVE-2026-111497）是 Google Brotli 解压缩库中的一个越界写入漏洞，而 Node.js 捆绑了该库。 specially crafted 压缩数据可能导致受影响应用程序崩溃、暴露其内存或允许远程代码执行。该问题已在 Node.js 22.23.4、24.22.1 和 26.12.1 中修复。按照 Node.js 官方生命周期结束政策，任何不受支持的分支（例如 20.x 及更早版本）在支持结束后都会持续面临风险，因为不会再发布进一步的安全修复。insignary-chk 在设计上体现了这一点：它不会将 Node.js 20.x 等生命周期结束分支标记为“可能存在漏洞”；当这些版本通过 Linux 发行版软件包安装时，会将其列为“向操作系统供应商核实”，当其通过 nodejs.org 安装或从源代码构建时，则列为“无法确定”，以便管理员向供应商核实实际补丁状态，或升级到受支持的版本。美国网络安全和基础设施安全局（CISA）已将 PHP2Shell 和 Node2Shell 均加入其已知被利用漏洞目录。</p><p>insignary-chk 是单个文件，无需安装或注册。默认情况下为只读模式：它只读取文件，绝不运行发现的内容，也除非用户选择 --fix 选项，否则不会进行任何更改。它不会通过网络发送数据，除非用户选择某个会连接到其指定地址的选项。由于 Node2Shell 源自 Brotli 库，insignary-chk 还会检查 Node.js 之外的 Brotli 副本，包括系统 Brotli 库和 Python 的 brotli 包。生命周期结束的 PHP 版本也会被标记出来，供用户对照 Linux 发行版的安全公告进行审查，或升级到受支持的版本。结果按优先级排序，因此团队可以一眼看出哪些问题需要紧急处理。</p><p><img src=\"/dailyinfo/media/a8bffdbe8026bcfb.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>报告中的待办事项按紧急程度排序：“立即处理”对应正在被运行进程使用的漏洞文件，“尽快修复”对应已安装但未运行的漏洞软件，“审查”对应需要手动检查的项目，随后列出每台服务器或容器镜像的详细发现结果。</p><p>insignary-chk 是 Insignary Clarity 产品系列的补充。Insignary Clarity 使用该公司的专利二进制软件成分分析（SCA）技术，在无需源代码的情况下，识别已编译应用程序、固件、IT 基础设施和容器镜像中的组件及版本。Insignary Clarity SC 将 Clarity、Clarity AIR、第三方 SCA 工具以及导入的 SBOM（软件物料清单）的结果整合到一个平台中，并可将新披露的 CVE 映射到现有 SBOM，而无需重新扫描。已经在使用 Clarity 的用户可以使用 insignary-chk 的 –clarity 选项，在自己的 Clarity 服务器上通过二进制分析确认其发现结果。</p><blockquote><p><strong>Insignary 总裁兼首席执行官 Taek Wan Kim</strong>表示：“PHP2Shell 和 Node2Shell 位于运行时，而非应用程序代码中，因此仅审查源代码无法判断您是否受到影响。我们开发 insignary-chk，使任何组织都能够在几分钟内检查自己的 Linux 服务器和容器，无需对系统进行任何更改，并优先处理最重要的问题。”</p></blockquote><p>insignary-chk 可在 www.insignary.com/free-tools/php2shell-node2shell-checker 免费下载，无需注册。它运行于 Linux x86_64，并且仅检查上文列出的三个 CVE。目前尚不支持 Windows、macOS 和 arm64。</p><p><strong>关于 Insignary</strong></p><p>Insignary Inc. 是一家总部位于多伦多的网络安全公司，专注于二进制成分分析和软件供应链安全。其专利技术使组织无需访问源代码，即可直接从已编译二进制文件中识别开源软件组件、漏洞和软件来源。该公司服务于全球各地的企业、政府和软件供应商，并获得包括欧洲的 BearingPoint、日本的 Cybertrust Japan 和 TechMatrix，以及 TMA Solutions 在内的战略投资者和合作伙伴支持。通过其全球合作伙伴生态系统，Insignary 支持北美、欧洲和亚洲的软件供应链安全工作。欲了解更多信息，请访问 <a href=\"http://www.insignary.com/\">www.insignary.com</a>。</p><h5>联系方式</h5><p><span><strong>首席解决方案架构师</strong><br></span><span><strong>Jessica Lee</strong><br></span><span><strong>Insignary</strong><br></span><span><strong><a href=\"https://hackread.com/cdn-cgi/l/email-protection\">[email&nbsp;protected]</a></strong><br></span></p>","original","zhKind","translation","complete","工具发布","容器","供应链","漏洞分析","PHP","Node.js","CISA","https://hackread.com/insignary-releases-free-insignary-chk-tool-to-detect-php2shell-and-node2shell-exposure/","Hackread",{"_107":108,"_109":-5},"changelogVersion","2026-10-01T08:00","release"]
