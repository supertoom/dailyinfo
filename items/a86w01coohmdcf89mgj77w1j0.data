[{"_1":2,"_3":4},"root",{"_5":88},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1793621624000,"id","a86w01coohmdcf89mgj77w1j0","title","FileBrowser 1.3.3-stable 符号链接越界导致目录外任意文件读取","originalTitle","FileBrowser: Symlink following escapes user scope allowing arbitrary file read outside the served directory","summary","FileBrowser 的符号链接解析缺少范围校验，可使读取路径逃逸用户目录，读取服务器进程可访问的目录外文件。原文在 gtstef/filebrowser:1.3.3-stable 上利用下载、预览、媒体、字幕、OnlyOffice 和公开分享端点完成 PoC，其中公开分享场景仅凭分享链接即可未认证读取。修复建议是在解析符号链接后校验真实路径仍位于用户 source 根目录内，并拒绝越界路径。","reason","文章定位了路径解析缺少目录范围校验的问题，并同时验证认证用户与公开分享两条利用路径，便于理解跨租户文件暴露风险。","source",{"_72":87},"links",{"_60":86},"publishedAt","2026-10-27T21:04:40.000Z","discoveredAt","2026-10-28T09:01:41.014Z","timelineAt","category","vuln","tags",[81,82,83,84,85],"score",72,"selected",true,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[67,68,69],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","f9z8YFJhhE28","reportCount",1,"additionalSourceCount",0,{"_70":75,"_72":76},{"_70":31,"_72":74},{"_70":71,"_72":73},"slug","research","name","技术研究","漏洞披露","cloud-native","云与原生",{"_78":79,"_13":80},"publicId","e926d9c8-29f3-4f22-85cb-25b6cf21e0ed","FileBrowser 1.3.3-stable符号链接越界读漏洞","漏洞","复现","漏洞利用","漏洞分析","容器","https://github.com/advisories/GHSA-mgqf-5mf5-prfj","GitHub 安全公告",{"_89":90,"_91":-5},"changelogVersion","2026-10-01T08:00","release"]
