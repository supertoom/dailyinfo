[{"_1":2,"_3":4},"root",{"_5":95},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1795653639000,"id","iihzlri9yx0ljdqwxqduljzdy","title","Palo Alto Networks 确认 Fragnesia 漏洞 CVE-2026-46300 已用于攻击 PAN-OS 设备","originalTitle","Palo Alto Networks warns of Fragnesia flaw exploited in PAN-OS attacks","summary","Palo Alto Networks 通报 CVE-2026-46300（Fragnesia，Linux 内核 XFRM ESP-in-TCP 子系统漏洞）已被用于攻击将管理接口暴露在公网的 PAN-OS 设备，攻击者需先获得低权限本地访问权限方可提权至 root。","reason","厂商确认 CVE-2026-46300 已被用于攻击暴露在公网管理接口的 PAN-OS 设备，并给出受影响版本与修复分支。","source",{"_67":94},"links",{"_83":93},"publishedAt","2026-11-25T22:05:09.000Z","discoveredAt","2026-11-25T22:20:18.705Z","timelineAt","category","vuln","tags",[68,87,88,89,90,91,92],"score",81,"selected",true,"channel","news","story","x","readingMode","full","author","Bill Toulas","body",{"_59":82,"_83":-5,"_84":85,"_86":37},"outline",[76],"relatedStories",[],"topics",[60,61,62,63,64],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_65":74,"_67":75},{"_65":72,"_67":73},{"_65":70,"_67":71},{"_65":31,"_67":69},{"_65":66,"_67":68},"slug","exploited","name","在野利用","漏洞披露","kernel","内核与系统","supply-chain","供应链安全","paloalto","Palo Alto Networks",{"_11":77,"_78":79,"_80":81},"sec-1","text","发现现有防御可能遗漏的电子邮件威胁。","level",2,"<p><img alt=\"Palo Alto Networks warns of Fragnesia flaw exploited in PAN-OS attacks\" height=\"900\" src=\"/dailyinfo/media/2c24d40826d59eca.jpg\" srcset=\"/dailyinfo/media/3ddf93bc3ce6ff6d.jpg 720w, /dailyinfo/media/cfc8548b44030d99.jpg 1200w, /dailyinfo/media/2c24d40826d59eca.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>威胁行为者正在将针对 PHP2Shell 和 Fragnesia 漏洞的利用链串联起来，以攻击管理接口暴露在互联网上的 Palo Alto Networks 设备。</p><p>PHP2Shell 是一<a href=\"https://www.bleepingcomputer.com/news/security/php-ships-emergency-patches-for-critical-php2shell-flaws/\">对严重 PHP 漏洞</a>的名称，分别对应 CVE-2026-109618 和 CVE-2026-109619，可允许未经验证的攻击者以 PHP Web 工作进程的权限远程执行代码。</p><p><a href=\"https://www.bleepingcomputer.com/news/security/new-fragnesia-linux-flaw-lets-attackers-gain-root-privileges/\">Fragnesia</a><a href=\"https://www.bleepingcomputer.com/news/security/new-fragnesia-linux-flaw-lets-attackers-gain-root-privileges/\">&nbsp;漏洞</a>编号为 CVE-2026-46300，是 Linux 内核中 XFRM ESP-in-TCP 子系统的一项漏洞，可使具有低权限的本地攻击者将权限提升至 root 级别。</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/256305b98cea3e96.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>CISA 于 10 月 28 日发布警报，警告称这两个安全问题正被<a href=\"https://www.bleepingcomputer.com/news/security/cisa-warns-of-fragnesia-linux-flaw-chained-in-php2shell-attacks/\">串联用于攻击</a>，以便在易受攻击的系统上部署 PHP webshell 并以 root 身份执行命令。</p><p>大约在同一时间，Dream Security 研究人员报告称观察到使用同一利用链的攻击活动，目标包括美国、日本、台湾和韩国的服务器，其中还包括一家美国政府关联机构。</p><p>Palo Alto Networks 今日在一份公告中确认，此类攻击也针对运行 PAN-OS 的防火墙。</p><p><a href=\"https://security.paloaltonetworks.com/PAN-SA-2026-0015\">安全公告</a>称：“已观察到针对暴露在互联网上的 Palo Alto Networks 管理接口利用 CVE-2026-46300 的情况。”</p><p>这家网络安全公司表示，其观察到的所有利用活动都涉及将管理接口暴露在公共互联网上的 PAN-OS 设备，这违反了其推荐的‘<a href=\"https://docs.paloaltonetworks.com/best-practices/10-1/administrative-access-best-practices/administrative-access-best-practices/deploy-administrative-access-best-practices#id2f3da1a1-21d4-4b15-917b-f3602ff20ba1\">最佳实践</a>’。</p><p>Palo Alto Networks 未提供有关串联利用 PHP2Shell 漏洞的任何技术细节，但指出这是目前已知利用 Fragnesia 的唯一方式，并且该公司并未发现该漏洞的其他利用路径。</p><p>该公司已为 PAN-OS 10.2、11.1、11.2、12.1 和 12.2 发布 Fragnesia 修复程序，具体包含补丁的构建版本因发行版本而异。</p><p>鉴于这两个漏洞会被串联利用，已安装解决 PHP2Shell 漏洞更新的管理员应可免受这些攻击。</p><p>除了安装安全更新外，Palo Alto Networks 还建议，需要保持远程管理接口可用的人员将<a href=\"https://live.paloaltonetworks.com/t5/community-blogs/critical-recommendations-for-deployment-guides-how-to-secure-the/ba-p/464431\">访问权限限制</a>为仅允许受信任的内部 IP 地址。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/0f821b73ff70ca16.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 代理会分析电子邮件意图、上下文和行为，以发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>对 Microsoft 365 或 Google Workspace 进行为期 14 天的只读扫描，看看有哪些威胁正在穿透，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始您的免费电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","漏洞","补丁","内核","供应链","Palo Alto","CISA","https://www.bleepingcomputer.com/news/security/palo-alto-networks-warns-of-fragnesia-flaw-exploited-in-pan-os-attacks/","BleepingComputer",{"_96":97,"_98":-5},"changelogVersion","2026-10-01T08:00","release"]
