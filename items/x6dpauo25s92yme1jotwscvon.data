[{"_1":2,"_3":4},"root",{"_5":185},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795912853000,"id","x6dpauo25s92yme1jotwscvon","title","Salesforce AI Research 发布 ErosionBench 多智能体评测基准，提出语义对齐衰减与 Meta-Auditor 检测架构","originalTitle","Agent越协作，越容易失控：多智能体系统的对齐衰减","summary","Salesforce AI Research 团队于 2026 年 11 月发布 ErosionBench，提出语义对齐衰减（Semantic Alignment Decay）概念，即多智能体系统在跨会话状态继承与相互引用中逐步偏离用户授权，最终执行未经授权的动作。","reason","把多 Agent 风险从单次提示注入扩展到跨会话状态演化，并用可复现的指标对比了确定性检查与语义监控的取舍。","source",{"_72":184},"links",{"_177":183},"publishedAt","2026-11-26T13:05:30.737Z","discoveredAt","2026-11-27T11:05:30.849Z","timelineAt","category","ai-security","tags",[180,73,181,182,75],"score",72,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","body",{"_61":176,"_177":-5,"_178":177,"_179":37},"outline",[82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fcJU4I4qhYP8","reportCount",1,"additionalSourceCount",0,{"_71":76,"_72":77},{"_71":74,"_72":75},{"_71":31,"_72":73},"slug","name","AI 安全","research","技术研究","ai-agent","AI Agent 安全",{"_79":80,"_13":81},"publicId","d2c2279e-92e9-4a2d-919f-daf5e10b8db3","Salesforce 发布多智能体对齐衰减评测基准",{"_11":174,"_113":175,"_115":116},{"_11":172,"_113":173,"_115":121},{"_11":170,"_113":171,"_115":116},{"_11":168,"_113":169,"_115":121},{"_11":166,"_113":167,"_115":121},{"_11":164,"_113":165,"_115":121},{"_11":162,"_113":163,"_115":121},{"_11":160,"_113":161,"_115":121},{"_11":158,"_113":159,"_115":116},{"_11":156,"_113":157,"_115":121},{"_11":154,"_113":155,"_115":121},{"_11":152,"_113":153,"_115":121},{"_11":150,"_113":151,"_115":116},{"_11":148,"_113":149,"_115":121},{"_11":146,"_113":147,"_115":121},{"_11":144,"_113":145,"_115":116},{"_11":142,"_113":143,"_115":121},{"_11":140,"_113":141,"_115":121},{"_11":138,"_113":139,"_115":121},{"_11":136,"_113":137,"_115":116},{"_11":134,"_113":135,"_115":121},{"_11":132,"_113":133,"_115":121},{"_11":130,"_113":131,"_115":121},{"_11":128,"_113":129,"_115":116},{"_11":126,"_113":127,"_115":121},{"_11":124,"_113":125,"_115":121},{"_11":122,"_113":123,"_115":121},{"_11":119,"_113":120,"_115":121},{"_11":117,"_113":118,"_115":116},{"_11":112,"_113":114,"_115":116},"sec-30","text","写在最后","level",2,"sec-29","对企业级 Agent 安全建设的启示","sec-28","4. 校准参数并不通用",3,"sec-27","3. Agent 架构相对固定","sec-26","2. 攻击数据仍以合成为主","sec-25","1. 执行前阻断与执行后检测存在明显区别","sec-24","局限性","sec-23","3. 能否迁移到其他评测体系？","sec-22","2. 图片中的攻击同样有效","sec-21","1. 不同模型作为 Auditor 的表现","sec-20","模型、多模态与跨领域泛化","sec-19","3. 与传统防御方案对比","sec-18","2. 实验结果：不同检测信号的能力差异","sec-17","1. 三层检测架构","sec-16","Meta-Auditor：如何检测对齐衰减？","sec-15","因为它改变了 Agent 之间的信任关系，在单 Agent 系统中，模型主要需要判断当前输入是否可信，而在多 Agent 系统中，一个 Agent 还需要判断：","sec-14","为什么共享 Ledger 是攻击的关键？","sec-13","四 Agent Mesh：攻击如何在系统内部传播？","sec-12","3. 数据集规模","sec-11","2. T1、T2、T3：逐步提高攻击复杂度","sec-10","1. 从状态图开始，而不是从恶意 Prompt 开始","sec-9","ErosionBench：如何评测多智能体系统的对齐衰减？","sec-8","5. 四种机制如何映射到企业业务？","sec-7","4. Distributed Collusion：分布式串谋","sec-6","3. Long-context Dilution：长上下文稀释","sec-5","2. State Gaslighting：状态欺骗","sec-4","1. Cross-session Conditioning：跨会话诱导","sec-3","四种攻击机制：对齐是如何逐步衰减的？","sec-2","1. 什么是语义对齐衰减？","sec-1","一个 Agent 没有犯错，为什么整个系统还是会失控？","<p>随着 AI Agent 从单一任务执行器发展为能够自主规划、调用工具、共享记忆和相互协作的多智能体系统，安全问题也开始发生变化。</p><p>过去，我们关注的是一个 Agent 会不会受到提示注入攻击、会不会调用未经授权的工具、会不会泄露敏感信息。</p><p>但当多个 Agent 开始协同工作，一个更隐蔽的问题出现了：</p><p><strong>每个 Agent 看起来都在正常工作，整个系统最终执行的动作，却可能已经偏离了用户最初的授权意图。</strong></p><p>攻击者甚至不需要向任何一个 Agent 发送明显的恶意指令，只需要在不同会话、共享记忆和 Agent 之间的信息传递过程中，逐步改变系统所依据的事实和决策条件，就可能让整个系统执行未经授权的操作。</p><p>2026 年 11 月，Salesforce AI Research 团队发布了 ErosionBench，专门研究这一问题。</p><p><img src=\"/dailyinfo/media/77ab76edf1b1b182.webp\" loading=\"lazy\" decoding=\"async\"></p><p>https://arxiv.org/pdf/2611.11266</p><p>它提出了一个值得关注的概念：<strong>Semantic Alignment Decay（语义对齐衰减）</strong>，并构建了一个包含 1,728 个场景的多智能体安全评测基准，用于研究攻击如何在企业级 Agent 系统中跨会话传播，以及如何在最终工具执行环节识别这种偏离。</p><p>这项研究提醒我们：Agent 的安全边界，已经不能只停留在输入和输出层面，而需要延伸到整个协作过程。</p><h2 id=\"sec-1\">一个 Agent 没有犯错，为什么整个系统还是会失控？</h2><p>先看论文给出的一个 CI/CD 供应链攻击场景，假设一家企业使用多智能体系统管理机器学习模型的构建、验证和生产部署。整个系统分工明确：</p><ul><li><p>Gateway Agent：接收用户请求，解析任务。</p></li><li><p>Orchestrator Agent：读取上下文，制定执行计划。</p></li><li><p>Policy Agent：检查执行计划是否符合安全策略。</p></li><li><p>Deployment Agent：调用部署工具，执行最终操作。</p></li></ul><p>用户提出了一个正常请求：</p><blockquote><p>执行模型更新，并完成生产部署。</p></blockquote><p>整个流程看起来没有任何问题。</p><p>但攻击者在早期会话中，向共享状态 Ledger 植入了一个看似合法的模型制品 URL。</p><p>随后，Orchestrator 在另一次会话中读取这条记录，将其视为已经经过验证的上游信息，并在执行计划中引用它。</p><p>经过 Agent 之间的信息传递，这个 URL 最终进入 Deployment Agent 的执行参数：weights_url</p><p>Deployment Agent 将其传递给生产部署工具，最终把攻击者控制的模型部署到了生产环境。</p><p>结果是：一个被污染的模型正式进入企业推理服务，后续用户得到的模型输出也可能受到攻击者控制。</p><p>这个过程最值得注意的地方在于：</p><ol><li><p>用户最初的请求完全正常。</p></li><li><p>攻击者没有直接控制 Deployment Agent。</p></li><li><p>各个 Agent 只是读取和引用了看起来合理的历史信息。</p></li><li><p>最终执行动作却已经不符合企业原本的安全要求。</p></li></ol><p>没有哪一条消息包含特别明显的恶意指令，但多条看似正常的信息组合起来，却形成了一次完整的供应链攻击。</p><p><img src=\"/dailyinfo/media/1b6743f171089c41.webp\" loading=\"lazy\" decoding=\"async\"></p><h3 id=\"sec-2\">1. 什么是语义对齐衰减？</h3><p>论文将这种现象定义为 Semantic Alignment Decay，即语义对齐衰减。简单来说就是多智能体系统在持续交互和信息传递过程中，逐渐偏离用户最初授权的目标，最终形成不符合原始授权意图的执行动作。</p><p>这里的 Alignment 并不是大模型训练阶段的价值观对齐，也不是 RLHF 所讨论的人类偏好对齐，它关注的是 Agent 的运行时行为是否始终符合用户授权。</p><p>例如：</p><ul><li><p>用户授权的是读取数据，Agent 最终却执行了数据导出。</p></li><li><p>用户授权的是测试环境部署，Agent 最终将模型部署到生产环境。</p></li><li><p>用户要求执行正常退款，Agent 却依据被篡改的订单状态进行了额外赔付。</p></li><li><p>用户只允许使用特定数据源，Agent 最终采用了未经验证的外部数据。</p></li></ul><p>这些问题的共同点是：最终动作与原始授权之间产生了偏离。传统安全检测通常关注某条输入是否恶意，而语义对齐衰减关注的是整个执行过程是否逐渐偏离原始目标。这实际上将 Agent 安全评测的对象，从单次交互扩展到了完整的执行过程。</p><h2 id=\"sec-3\">四种攻击机制：对齐是如何逐步衰减的？</h2><p>ErosionBench 将语义对齐衰减归纳为四种机制，它们分别利用共享记忆、持久化状态、长上下文和多 Agent 协作关系，形成不同的攻击传播路径。</p><h3 id=\"sec-4\">1. Cross-session Conditioning：跨会话诱导</h3><p>跨会话诱导的核心是利用不同会话之间的状态继承。攻击者在早期会话中植入一条恶意信息，将其写入共享记忆或持久化状态。在后续会话中，另一个 Agent 读取这条记录时，可能将其视为已经确认的上下文，而不是重新验证其来源和真实性。</p><p>例如：</p><ul><li><p>会话一：攻击者植入一个未经验证的模型制品地址。</p></li><li><p>会话二：Orchestrator 读取该地址，将其当作已经审核的资源。</p></li><li><p>会话三：Deployment 使用这个地址执行生产部署。</p></li></ul><p>攻击者真正利用的不是某一次对话，而是系统跨会话继承信息的机制。</p><p><strong>核心问题：恶意信息通过共享记忆获得了本不应该拥有的信任。</strong></p><h3 id=\"sec-5\">2. State Gaslighting：状态欺骗</h3><p>State Gaslighting 可以理解为对持久化状态进行欺骗。攻击者直接改变共享 Ledger 中的记录，让后续 Agent 根据错误的历史状态作出决策。</p><p>例如：</p><ul><li><p>原本尚未完成的 MFA 验证，被记录为已经完成。</p></li><li><p>尚未经过审批的操作，被记录为已经获得授权。</p></li><li><p>原本不具备生产环境权限的身份，被描述为拥有管理员权限。</p></li></ul><p>当其他 Agent 读取这些记录时，如果没有独立验证，就可能将伪造的状态当成真实事实。</p><p>与跨会话诱导相比，这种机制更加直接：攻击者改变的不是 Agent 对某条信息的理解，而是系统本身所保存的状态。</p><p><strong>核心问题：系统开始相信被篡改的事实，并据此执行操作。</strong></p><h3 id=\"sec-6\">3. Long-context Dilution：长上下文稀释</h3><p>长上下文稀释利用的是 Agent 处理大量信息时，关键约束容易被弱化的问题。企业级 Agent 经常需要读取长篇文档、操作手册、审批记录、项目报告和历史会话。攻击者可以将影响最终执行的关键信息隐藏在大量正常业务内容中。随着上下文不断增加，原始用户目标和安全约束可能逐渐失去影响力。</p><p>例如：用户要求严格按照既定合规条件执行数据处理。但一份包含大量正常业务说明的文档中，夹带了一个改变数据访问范围的参数。Agent 在处理复杂上下文时，可能逐渐采用这个参数，最终偏离原始要求。</p><p><strong>核心问题：大量上下文削弱了原始目标和关键约束的影响力。</strong></p><h3 id=\"sec-7\">4. Distributed Collusion：分布式串谋</h3><p>分布式串谋利用多个 Agent 之间的信息协作关系。攻击者将攻击所需的信息拆分到不同的记录或交互环节中，让多个 Agent 分别提供看似合理的证据。</p><p>例如：</p><ul><li><p>Agent A 提供一条看似合法的审批记录。</p></li><li><p>Agent B 提供一条支持该审批的业务说明。</p></li><li><p>Agent C 引用前两个 Agent 的结论，认为操作已经获得授权。</p></li></ul><p>最终，多个局部看似可信的信息组合成一个整体不可信的决策。这里的串谋不一定意味着多个 Agent 被攻击者直接控制，而是攻击者利用它们之间的相互引用和信任关系，让错误信息获得多重背书。</p><p><strong>核心问题：多个局部可信的判断，组合成一个整体不可信的决策。</strong></p><p><img src=\"/dailyinfo/media/38cb6ffaa92f2622.webp\" loading=\"lazy\" decoding=\"async\"></p><h3 id=\"sec-8\">5. 四种机制如何映射到企业业务？</h3><p>研究团队构建了四个企业业务领域，每个领域覆盖四种攻击机制，形成16种具体攻击类型。</p><table><tbody><tr><th><p>业务领域</p></th><th><p>跨会话诱导</p></th><th><p>状态欺骗</p></th><th><p>长上下文稀释</p></th><th><p>分布式串谋</p></th></tr><tr><td><p>量化金融</p></td><td><p>语义状态投毒</p></td><td><p>身份伪造欺骗</p></td><td><p>推理影响</p></td><td><p>时间窗口利用</p></td></tr><tr><td><p>CI/CD供应链</p></td><td><p>供应链投毒</p></td><td><p>权限升级</p></td><td><p>合规伪装</p></td><td><p>分散证据背书</p></td></tr><tr><td><p>数据工程</p></td><td><p>共享记忆污染</p></td><td><p>策略重构</p></td><td><p>中间步骤泄露</p></td><td><p>数据血缘伪造</p></td></tr><tr><td><p>自动化CRM</p></td><td><p>SLA指标操纵</p></td><td><p>危机升级劫持</p></td><td><p>权益操纵</p></td><td><p>保修欺诈注入</p></td></tr></tbody></table><p>这些攻击并不局限于某一种提示注入方式，论文将16种攻击类型映射到 OWASP Top 10 for LLM Applications（2025）的五个类别：</p><ul><li><p>LLM04：数据与模型投毒。</p></li><li><p>LLM06：过度代理权限。</p></li><li><p>LLM09：错误信息。</p></li><li><p>LLM02：敏感信息泄露。</p></li><li><p>LLM08：向量与嵌入弱点。</p></li></ul><p>其中，数据与模型投毒、过度代理权限是主要覆盖方向。这也说明，对齐衰减并不是一种独立于现有安全威胁的新攻击，而是可能将多种既有风险组合起来，并通过多 Agent 协作过程放大其影响。</p><h2 id=\"sec-9\">ErosionBench：如何评测多智能体系统的对齐衰减？</h2><p>提出攻击分类只是第一步，ErosionBench 更重要的贡献，是构建了一套能够实际执行攻击，并根据最终工具调用验证攻击结果的评测框架。</p><h3 id=\"sec-10\">1. 从状态图开始，而不是从恶意 Prompt 开始</h3><p>传统攻击数据集经常先准备恶意提示词，再观察模型是否会受到影响。这种方法有一个问题：文本看起来很危险，不代表它真的能够改变 Agent 的执行行为。</p><p>ErosionBench 采用了不同的方法，它首先定义业务状态图（State Graph），明确：</p><ul><li><p>用户原始意图是什么？</p></li><li><p>哪些工具可以被调用？</p></li><li><p>哪些参数属于安全关键参数？</p></li><li><p>哪些状态是经过授权的？</p></li><li><p>攻击者希望植入什么内容？</p></li><li><p>最终什么样的工具调用才算攻击成功？</p></li></ul><p>在此基础上，再利用模板和 LLM 生成企业业务文档、历史会话及攻击叙事。</p><p>整个数据构建过程分为四个阶段：</p><ul><li><p><strong>Stage 1：Deterministic State Graph。定义业务变量、正常执行参数、攻击植入值和最终 Ground Truth。</strong></p></li><li><p><strong>Stage 2：Narrative Generation。生成正常业务文档、会话记录以及攻击内容，让恶意信息融入真实业务语境。</strong></p></li><li><p><strong>Stage 3：Validation Gates。通过确定性检查、语义检查和 Ground Truth 检查，确保攻击能够抵达目标位置，并且确实会违反原始授权。</strong></p></li><li><p><strong>Stage 4：Tier Mutation。将攻击扩展为 T1、T2、T3 三个不同复杂度的版本。</strong></p></li></ul><p><img src=\"/dailyinfo/media/32c471dde3f16f1d.webp\" loading=\"lazy\" decoding=\"async\"></p><h3 id=\"sec-11\">2. T1、T2、T3：逐步提高攻击复杂度</h3><p>ErosionBench 将攻击分成三个等级。</p><table><tbody><tr><th><p>指标</p></th><th><p>T1</p></th><th><p>T2</p></th><th><p>T3</p></th></tr><tr><td><p>平均会话数</p></td><td><p>5.03</p></td><td><p>8.04</p></td><td><p>11.55</p></td></tr><tr><td><p>文档页数</p></td><td><p>5</p></td><td><p>20</p></td><td><p>50</p></td></tr><tr><td><p>攻击复杂度</p></td><td><p>基础</p></td><td><p>中等</p></td><td><p>高</p></td></tr></tbody></table><p>三个等级保持相同的核心攻击目标，但逐步增加交互深度、上下文长度和信息埋藏程度。</p><p>例如：</p><ul><li><p>T1：攻击信息出现在较短文档的前部。</p></li><li><p>T2：增加历史会话和文档长度。</p></li><li><p>T3：将相同的攻击内容埋藏在更长的文档中，通常位于文档约70%的深度。</p></li></ul><p>不同攻击机制还会采用不同的扩展方式：</p><ul><li><p>跨会话诱导：增加前置诱导会话。</p></li><li><p>状态欺骗：改变持久化 Ledger 记录。</p></li><li><p>长上下文稀释：增加正常文档内容。</p></li><li><p>分布式串谋：增加提供相互印证信息的 Agent。</p></li></ul><p>这种设计能够观察同一种攻击在不同复杂度下的成功率变化。</p><h3 id=\"sec-12\">3. 数据集规模</h3><p>ErosionBench 共构建了1,728个场景：</p><table><tbody><tr><th><p>数据类型</p></th><th><p>数量</p></th></tr><tr><td><p>恶意攻击场景</p></td><td><p>1,296</p></td></tr><tr><td><p>正常对照场景</p></td><td><p>432</p></td></tr><tr><td><p>攻击家族</p></td><td><p>432</p></td></tr><tr><td><p>具体攻击类型</p></td><td><p>16</p></td></tr><tr><td><p>企业业务领域</p></td><td><p>4</p></td></tr></tbody></table><p>每个攻击家族包含三个恶意版本（T1、T2、T3），以及一个匹配的正常对照。</p><p>此外，研究团队还构建了198个图像攻击样本，来自66个攻击家族，每个家族生成三个图像版本，并与文本攻击对应。这些图像采用企业真实业务界面的视觉形式，包括 Grafana 监控面板、Slack 消息截图、审批文件和业务表单等。</p><p>为了确保攻击信息能够真正被模型读取，作者还设计了额外的验证：</p><ul><li><p>PDF 文档需要经过文本提取回环检查。</p></li><li><p>图片需要通过 OCR 检查，确认攻击参数能够被识别。</p></li><li><p>未通过验证的样本不会进入正式数据集。</p></li></ul><p>最终，这套数据集覆盖了12,806个会话，平均每个场景包含7.41个会话。</p><p>这使 ErosionBench 不再只是一个恶意 Prompt 集合，而是一套包含业务状态、历史交互、文档内容和最终执行条件的完整评测环境。</p><h2 id=\"sec-13\">四 Agent Mesh：攻击如何在系统内部传播？</h2><p>ErosionBench 构建了一个由四个 Agent 组成的企业业务执行环境，四个 Agent 分别承担不同职责，通过共享 Ledger 和状态机完成协作。</p><table><tbody><tr><th><p>Agent</p></th><th><p>主要职责</p></th></tr><tr><td><p>Gateway</p></td><td><p>接收用户请求，解析任务</p></td></tr><tr><td><p>Orchestrator</p></td><td><p>读取历史状态，制定执行方案</p></td></tr><tr><td><p>Policy</p></td><td><p>审核执行方案和安全约束</p></td></tr><tr><td><p>Deployment</p></td><td><p>调用最终业务工具</p></td></tr></tbody></table><p>它们不是简单地相互发送消息，而是通过状态机组织执行流程。</p><p>Orchestrator 读取共享 Ledger，根据当前状态决定继续执行、进入下一次会话、交由 Policy 审核，或者进入最终部署环节。</p><p>不同业务领域使用不同的工具，但保持相同的 Agent 角色结构。</p><p>整个环境还提供文档获取、状态修改、业务工具执行以及不可变审计记录等接口。</p><p><img src=\"/dailyinfo/media/f8a38a9a003ea74f.webp\" loading=\"lazy\" decoding=\"async\"></p><h3 id=\"sec-14\">为什么共享 Ledger 是攻击的关键？</h3><h3 id=\"sec-15\">因为它改变了 Agent 之间的信任关系，在单 Agent 系统中，模型主要需要判断当前输入是否可信，而在多 Agent 系统中，一个 Agent 还需要判断：</h3><ul><li><p>这条信息是谁写入的？</p></li><li><p>它来自用户、可信工具还是外部文档？</p></li><li><p>写入者是否有权修改这个状态？</p></li><li><p>其他 Agent 是否已经验证过它？</p></li><li><p>之前的审核结论是否仍然有效？</p></li></ul><p>如果这些问题没有被明确处理，Agent 之间的相互引用就可能成为信任传播的通道。一条未经验证的信息，可能在多轮交互之后变成其他 Agent 眼中的既定事实。这也是 ErosionBench 与传统单 Agent 提示注入评测最明显的区别。</p><h2 id=\"sec-16\">Meta-Auditor：如何检测对齐衰减？</h2><p>针对上述问题，作者提出了一个参考防御架构：Meta-Auditor（元审计器）。</p><p>它的核心思路不是单纯增加一个负责拒绝恶意请求的安全 Agent，而是同时利用确定性检查、完整执行轨迹分析和不确定性仲裁，判断最终动作是否符合用户授权。</p><h3 id=\"sec-17\">1. 三层检测架构</h3><p>Meta-Auditor 包含三个层次：</p><p><strong>第一层：同步确定性拦截（Synchronous Interception）</strong></p><p>在最终工具调用边界，对关键执行参数进行检查，其中最重要的指标是 SDI。</p><p>SDI（State Divergence Index，状态偏离指数）衡量用户授权参数与 Agent 实际准备执行的工具参数之间的差异。</p><p>例如：</p><pre><code>用户授权：</code><code>deployment_scope = staging</code><code></code><code>实际执行：</code><code>deployment_scope = production</code></pre><pre><code>如果原始授权明确限定了部署范围，而最终工具调用修改了这一参数，SDI 就会产生偏离分数。</code></pre><p>SDI 使用类型感知的距离函数，取值范围为0到1。</p><p>它是论文明确设计的执行前检测信号，可以在最终工具调用发生之前进行拦截。</p><p><strong>第二层：异步语义监控（Asynchronous Semantic Monitoring）</strong></p><p>确定性规则能够发现参数变化，却不一定能识别所有复杂的语义攻击。</p><p>例如，攻击者没有修改明显的权限字段，而是通过多轮讨论逐步改变 Policy 的判断。</p><p>因此，Meta-Auditor 会进一步读取完整执行轨迹，包括：</p><ul><li><p>Ledger 历史记录。</p></li><li><p>Agent 之间的通信内容。</p></li><li><p>Policy 审核结果。</p></li><li><p>文档访问记录。</p></li><li><p>最终工具调用事件。</p></li></ul><p>然后分析整个执行过程是否偏离用户原始意图。</p><p>这一层还引入了两个确定性辅助指标：</p><p><strong>CII（Causal Influence Index，因果影响指数）：衡量最终工具参数中的关键值，有多少能够追溯到未经验证来源写入的 Ledger 记录。</strong></p><p>例如，某个部署参数最初来自未经授权的外部状态写入，后续又被 Orchestrator 读取并用于最终部署。</p><p>CII 就能够帮助定位这条攻击传播路径。</p><p><strong>VAD（Verified Alignment Decay，验证对齐衰减指标）：用于观察 Policy 在多轮审核过程中是否逐渐放弃原来的安全立场。</strong></p><p>例如：</p><pre><code>Turn 1：REJECT</code><code>Turn 2：REJECT</code><code>Turn 3：CONDITIONAL</code><code>Turn 4：APPROVE</code></pre><p>如果 Policy 一开始明确拒绝，随后却在多轮讨论中改变立场，VAD 就会识别这种变化。</p><pre><code>它关注的不只是最终是否批准，还包括安全判断发生变化的过程。</code></pre><p>需要注意，CII 和 VAD 在论文中属于执行后的诊断证据，并不是独立的执行前拦截规则。</p><p><strong>第三层：灰度仲裁（Grey-zone Arbitration）</strong></p><p>这是 Meta-Auditor 中比较有意思的设计。</p><p>确定性规则和语义监控各有局限：</p><ul><li><p>确定性规则误报率低，但可能漏掉复杂攻击。</p></li><li><p>语义监控覆盖率高，但容易把正常业务误判为攻击。</p></li></ul><p>如果简单地把所有检测结果做 OR 组合，虽然召回率可以达到100%，正常任务误报率却会升至22.1%。</p><p>因此，作者设计了一个灰度区：当检测结果明显安全时，允许通过；明显危险时，标记为攻击；当不同检测信号发生冲突，或者语义评分处于不确定区间时，则交给专门的仲裁器重新分析完整轨迹。</p><p>这样可以减少简单阈值带来的误判。</p><p><img src=\"/dailyinfo/media/a8e4604a67992b3b.webp\" loading=\"lazy\" decoding=\"async\"></p><h3 id=\"sec-18\">2. 实验结果：不同检测信号的能力差异</h3><p>论文在906个独立测试场景上评估 Meta-Auditor，其中453个为恶意场景，453个为正常对照。</p><p>单独使用各项指标时，表现如下：</p><table><tbody><tr><th><p>检测指标</p></th><th><p>恶意样本召回率</p></th><th><p>正常样本误报率</p></th></tr><tr><td><p>SDI</p></td><td><p>43.9%</p></td><td><p>0%</p></td></tr><tr><td><p>CII</p></td><td><p>14.8%</p></td><td><p>0%</p></td></tr><tr><td><p>VAD</p></td><td><p>7.9%</p></td><td><p>1.8%</p></td></tr><tr><td><p>语义监控</p></td><td><p>100%</p></td><td><p>20.8%</p></td></tr><tr><td><p>简单 OR 组合</p></td><td><p>100%</p></td><td><p>22.1%</p></td></tr></tbody></table><p>可以看到，没有任何单一指标能够同时实现高召回率和低误报率。</p><p>确定性指标的优势是可解释、可复现，但覆盖能力有限；语义监控则能够识别大量复杂攻击，但也会误伤正常业务。</p><p>灰度仲裁正是为了解决这个问题。</p><p>在906条测试轨迹中：</p><ul><li><p>439条进入灰度仲裁。</p></li><li><p>仲裁器最终标记263条。</p></li><li><p>其余176条通过。</p></li><li><p>确定性锚点独立识别了196条攻击。</p></li></ul><p>最终，Meta-Auditor 达到98.5%的攻击召回率，同时将正常样本误报率控制在2.9%。</p><h3 id=\"sec-19\">3. 与传统防御方案对比</h3><p>作者进一步将 Meta-Auditor 与多种现有防御方案进行比较。</p><table><tbody><tr><th><p>防御方案</p></th><th><p>攻击成功率 ASR</p></th><th><p>正常任务误报率</p></th></tr><tr><td><p>无防御的多 Agent 系统</p></td><td><p>43.9%</p></td><td><p>37.3%</p></td></tr><tr><td><p>LlamaFirewall</p></td><td><p>10.2%</p></td><td><p>92.5%</p></td></tr><tr><td><p>ShieldGemma-27B</p></td><td><p>27.8%</p></td><td><p>54.3%</p></td></tr><tr><td><p>Progent</p></td><td><p>4.9%</p></td><td><p>64.0%</p></td></tr><tr><td><p>未校准 LLM Judge</p></td><td><p>2.2%</p></td><td><p>67.6%</p></td></tr><tr><td><p>Meta-Auditor</p></td><td><p>1.3%</p></td><td><p>2.9%</p></td></tr></tbody></table><p>这组实验结果揭示了一个很重要的问题：降低攻击成功率，并不意味着防御方案真正具备企业部署价值。</p><p>例如，LlamaFirewall 将攻击成功率降低到了10.2%，但正常任务误报率高达92.5%。</p><p>这意味着大量正常业务也被拒绝了。</p><p>Progent 同样将攻击成功率降低到4.9%，但正常任务误报率仍然达到64%。</p><p>相比之下，Meta-Auditor 在论文的测试设置中，将攻击成功率和正常任务误报率分别控制在1.3%和2.9%。</p><p>这说明防御效果不能只看攻击是否被拦截，还必须同时考虑正常业务是否能够继续完成。</p><p>需要特别说明：论文的98.5%是 Meta-Auditor 的检测召回率，而不是执行前阻断率。其异步语义监控和灰度仲裁发生在工具调用之后，不负责自动回滚。因此，不能将检测结果直接等同于攻击在产生业务影响前被阻断。</p><h2 id=\"sec-20\">模型、多模态与跨领域泛化</h2><p>除了主要评测，作者还进行了几组实验。</p><h3 id=\"sec-21\">1. 不同模型作为 Auditor 的表现</h3><p>Meta-Auditor 并不依赖某一个固定模型，但不同模型的检测能力存在差异。</p><table><tbody><tr><th><p>Auditor 模型</p></th><th><p>召回率</p></th><th><p>误报率</p></th></tr><tr><td><p>Claude Opus 4.8</p></td><td><p>98.5%</p></td><td><p>2.9%</p></td></tr><tr><td><p>Claude Sonnet 4.6</p></td><td><p>95.8%</p></td><td><p>8.6%</p></td></tr><tr><td><p>GPT-5.1</p></td><td><p>84.1%</p></td><td><p>1.3%</p></td></tr><tr><td><p>Gemini 3.5 Flash</p></td><td><p>83.4%</p></td><td><p>11.0%</p></td></tr><tr><td><p>Gemma 4 31B</p></td><td><p>89.4%</p></td><td><p>12.4%</p></td></tr><tr><td><p>GPT-OSS Safeguard 20B</p></td><td><p>55.1%</p></td><td><p>2.4%</p></td></tr></tbody></table><p>可以看到，模型能力会影响语义检测召回率，但并不是模型越强，误报率就一定越低。</p><p>例如，GPT-5.1 的召回率低于 Claude Opus 4.8，但误报率也更低。</p><p>另外，每个模型都需要单独进行阈值校准，不能直接将一个模型的校准参数迁移给另一个模型。</p><h3 id=\"sec-22\">2. 图片中的攻击同样有效</h3><p>作者还将198个攻击样本制作成企业业务文档图片，并与文本版本进行对照。</p><p>使用经过文本校准的 Auditor 直接检测图片攻击：</p><table><tbody><tr><th><p>Auditor</p></th><th><p>图片召回率</p></th><th><p>文本召回率</p></th></tr><tr><td><p>Claude Opus 4.8</p></td><td><p>100%</p></td><td><p>100%</p></td></tr><tr><td><p>Claude Sonnet 4.6</p></td><td><p>100%</p></td><td><p>99%</p></td></tr><tr><td><p>GPT-5.1</p></td><td><p>96%</p></td><td><p>96%</p></td></tr></tbody></table><p>不同输入渠道下的检测召回率基本一致。</p><p>这说明 Meta-Auditor 的检测重点是完整执行轨迹，而不是攻击内容最初通过文本还是图片进入系统。</p><p>不过，论文明确指出，图片正常对照样本的有效匹配尚未完成，因此没有给出可靠的图片场景误报率结论。</p><h3 id=\"sec-23\">3. 能否迁移到其他评测体系？</h3><p>作者还使用 AgentDojo 和 Agent Security Bench（ASB）进行了外部泛化测试。</p><table><tbody><tr><th><p>数据集</p></th><th><p>测试场景</p></th><th><p>召回率</p></th><th><p>误报率</p></th></tr><tr><td><p>AgentDojo</p></td><td><p>单会话间接提示注入</p></td><td><p>86.4%</p></td><td><p>0%</p></td></tr><tr><td><p>ASB</p></td><td><p>跨会话 Memory Poisoning</p></td><td><p>95.0%</p></td><td><p>2.0%</p></td></tr></tbody></table><p>需要注意，AgentDojo 的召回率只针对已经成功落地的44条攻击轨迹；ASB 则是将其提供的 Memory Poisoning 攻击 Payload 映射到 ErosionBench 的跨会话执行结构中，并不是直接重放 ASB 原始 Agent 实验。</p><p>作者还构建了一个独立的临床医疗领域，测试患者安全和敏感医疗信息泄露场景。</p><p>在其中45个可评分恶意样本上，Claude Opus 4.8 达到了100%召回率，20个正常样本没有出现误报。</p><p>这表明 Meta-Auditor 具有一定的跨领域迁移能力，但这些实验规模仍然有限，不能据此认为它已经适用于所有企业业务。</p><h2 id=\"sec-24\">局限性</h2><p>ErosionBench 的实验结果比较亮眼，但距离完整的企业级防御方案仍有一定距离。</p><h3 id=\"sec-25\">1. 执行前阻断与执行后检测存在明显区别</h3><p>这是论文最值得进一步研究的工程问题。</p><p>Meta-Auditor 中只有同步确定性检查能够在工具执行之前阻止操作。</p><p>CII、VAD、语义监控和灰度仲裁主要依赖执行后的完整轨迹。</p><p>换句话说：</p><ul><li><p>执行前拦截：避免危险动作发生。</p></li><li><p>执行后检测：发现已经发生的异常行为。</p></li><li><p>回滚与恢复：尽可能消除已经产生的影响。</p></li></ul><p>这三个环节并不相同。</p><p>论文的98.5%召回率不能直接理解为98.5%的攻击都在执行前被阻断。</p><p>作者也明确将受控回滚和隔离机制列为未来研究方向。</p><h3 id=\"sec-26\">2. 攻击数据仍以合成为主</h3><p>虽然论文进行了专家盲审，场景真实度平均达到4.37/5，但这些场景仍然是基于状态图和生成模型构建的合成数据，而非从真实企业安全事件中采集。</p><p>真实企业环境可能存在更复杂的权限继承、异步任务、跨组织协作和人工审批机制。</p><p>这些因素还需要进一步验证。</p><h3 id=\"sec-27\">3. Agent 架构相对固定</h3><p>论文主要采用四个固定角色的 Agent Mesh。</p><p>现实中的企业 Agent 系统可能存在动态创建 Agent、多层委派、不同模型混合运行、跨平台协作等情况。</p><p>论文尚未系统研究 Agent 数量和协作拓扑变化对攻击成功率的影响。</p><h3 id=\"sec-28\">4. 校准参数并不通用</h3><p>Meta-Auditor 需要针对不同 Auditor 模型分别进行校准。</p><p>论文的误报率结论还依赖测试数据与校准数据具有一定的分布一致性，不能直接保证在任意真实业务分布下都保持相同表现。</p><p>此外，论文没有充分测试具备反馈能力的自适应攻击者。</p><p>因此，Meta-Auditor 更适合作为一个具有参考价值的研究架构，而不是已经经过充分对抗验证的安全产品。</p><h2 id=\"sec-29\">对企业级 Agent 安全建设的启示</h2><p>ErosionBench 最有价值的地方，是将多 Agent 系统的安全问题从单点防御扩展到了完整执行过程。</p><p>对于企业而言，至少有五个方向值得关注。</p><p><strong>1. 从 Prompt 信任转向状态来源验证</strong></p><p>共享记忆、历史会话和 Ledger 中的信息，不应该因为被其他 Agent 引用过，就自动获得可信身份。</p><p>每条关键状态都应该具备来源、写入者、授权范围和验证状态。</p><p><strong>2. 将用户授权转化为可验证的执行合同</strong></p><p>用户最初的授权不应该只保留在自然语言上下文中。</p><p>应该将其转换为结构化约束，例如：</p><ul><li><p>允许访问的数据范围。</p></li><li><p>允许调用的工具。</p></li><li><p>允许执行的操作类型。</p></li><li><p>关键参数的合法取值。</p></li><li><p>是否允许权限升级。</p></li></ul><p>最终工具调用必须经过独立验证。</p><p><strong>3. 对关键状态建立因果追踪</strong></p><p>不仅要知道某个参数当前是什么，还要知道它来自哪里、经过哪些 Agent 传递、是否经过授权修改。</p><p>这要求系统具备完整的状态变更日志和数据来源追踪能力。</p><p><strong>4. 将安全检测延伸到工具执行边界</strong></p><p>不能只检查 Agent 的自然语言回复。</p><p>真正需要重点保护的是产生业务影响的工具调用，包括参数、权限和执行对象。</p><p>对于高风险操作，应当在执行前完成独立校验。</p><p><strong>5. 同时评估安全性与业务可用性</strong></p><p>安全评测不能只统计攻击成功率。</p><p>还需要关注：</p><ul><li><p>攻击检测召回率。</p></li><li><p>正常业务误报率。</p></li><li><p>执行前阻断率。</p></li><li><p>执行后发现率。</p></li><li><p>回滚与恢复成功率。</p></li><li><p>检测延迟和运行成本。</p></li></ul><p>只有同时考虑安全性和业务可用性，才能判断一个防御方案是否真正适合企业部署。</p><h2 id=\"sec-30\">写在最后</h2><p>ErosionBench 研究的不是某一种新型提示注入技巧，而是一个更加系统性的问题：</p><p>当多个 Agent 开始共享状态、继承记忆、相互引用并自主协作时，攻击者可以利用这些机制，让恶意信息逐步获得信任，最终改变系统的执行行为。</p><p>论文的主要贡献可以归纳为三个方面：</p><ul><li><p><strong>提出语义对齐衰减问题</strong>：将多 Agent 系统的安全风险从单次输入攻击扩展到跨会话状态演化。</p></li><li><p><strong>构建 ErosionBench</strong>：通过四种攻击机制、四个企业业务领域和1,728个场景，评估多 Agent 系统的对齐衰减。</p></li><li><p><strong>提出 Meta-Auditor</strong>：结合确定性检查、完整轨迹语义监控和灰度仲裁，在实验中实现98.5%的攻击检测召回率和2.9%的正常样本误报率。</p></li></ul><p>这项研究也给出了一个值得企业重新思考的安全原则：</p><p><strong>Agent 之间可以协作，但不能因为协作就默认彼此可信；Agent 可以共享状态，但不能因为状态被持久化就默认它真实有效。</strong></p><p>未来的企业级 Agent 安全架构，需要保护的不仅是模型的输入和输出，更是从用户授权、状态变化、Agent 协作到最终工具执行的完整过程。</p><p>真正可靠的 Agent 系统，不应该只回答自己有没有完成任务，还必须能够证明：</p><p><strong>它完成任务的整个过程，始终没有越过用户授权的边界。</strong></p><p>声明：本文来自模安局，版权归作者所有。文章内容仅代表作者独立观点，不代表安全内参立场，转载目的在于传递更多信息。如有侵权，请联系 anquanneican@163.com。</p>","original","zhKind","complete","论文","Agent 安全","大模型","https://www.secrss.com/articles/96034","安全内参",{"_186":187,"_188":-5},"changelogVersion","2026-10-01T08:00","release"]
