[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1794530487000,"id","ke43qtftrmo1i5qcbhrr32q9r","title","Chrome 157 稳定版修复 9 项漏洞，CVE-2026-125350 已有在野利用","originalTitle","Stable Channel Update for Desktop","summary","Chrome 稳定版已更新至 Windows 和 Mac 的 157.0.8103.50/.51、Linux 的 157.0.8103.50，将在未来数天至数周内推出。","reason","更新包含 9 项安全修复，并明确指出 CVE-2026-125350 已有在野利用，为 Chrome 用户评估升级优先级提供直接依据。","source",{"_66":82},"links",{"_74":81},"publishedAt","2026-11-09T20:52:57.820Z","discoveredAt","2026-11-09T21:33:26.693Z","timelineAt","category","vuln","tags",[78,79,67,70,80],"score",72,"selected",true,"channel","news","story","x","readingMode","full","author","Srinivas Sista","body",{"_59":73,"_74":-5,"_75":76,"_77":37},"outline",[],"relatedStories",[],"topics",[60,61,62,63],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_64":71,"_66":72},{"_64":69,"_66":70},{"_64":31,"_66":68},{"_64":65,"_66":67},"slug","exploited","name","在野利用","漏洞披露","browser","浏览器","google","Google / 谷歌","<p>&nbsp;<span><span>Windows 和 Mac 的 Stable 频道已更新至 157.0.8103.50/.51，</span><span> </span><span>Linux 已更新至 157.0.8103.50，</span></span><span>更新将在未来数日或数周内逐步推出。本次构建的完整变更列表可在 <a href=\"https://chromium.googlesource.com/chromium/src/+log/157.0.8103.39..157.0.8103.50?pretty=fuller&amp;n=10000\">日志</a>中查看。</span></p><p><span>安全修复与奖励</span></p><p><span><span>注意：在大多数用户安装修复之前，漏洞详情和相关链接的访问权限可能会继续受到限制。如果该漏洞存在于其他项目同样依赖、但尚未修复的第三方库中，我们也会继续保留这些限制。</span></span></p><p><span><span>本次更新包含 </span><a href=\"https://issues.chromium.org/issues?q=customfield1223088:1-M157\"><span>9</span></a><span> 项安全修复。更多信息请参阅 </span><a href=\"https://www.chromium.org/Home/chromium-security\"><span>Chrome 安全页面</span></a><span>。</span></span></p><p><span><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/550525698\"><span>550525698</span></a><span>] 高危 CVE-2026-125345：WebGL 中未初始化的资源。 </span><span>由 Google 于 2026-08-21 报告</span></span></p><p><span><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/561996724\"><span>561996724</span></a><span>] 高危 CVE-2026-125347：FileSystem 中授权不当。 </span><span>由 Google 于 2026-09-15 报告</span></span></p><p><span><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/561998123\"><span>561998123</span></a><span>] 高危 CVE-2026-125343：Compositing 中缓冲区溢出。 </span><span>由 Google 于 2026-09-15 报告</span></span></p><p><span><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/563358700\"><span>563358700</span></a><span>] 高危 CVE-2026-125348：GPU 中越界写入。 </span><span>由 Google 于 2026-09-18 报告</span></span></p><p><span><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/568893995\"><span>568893995</span></a><span>] 高危 CVE-2026-125344：V8 中类型混淆。 </span><span>由 Google 于 2026-10-02 报告</span></span></p><p><span><span>[TBD][</span><a href=\"https://issues.chromium.org/issues/572578603\"><span>572578603</span></a><span>][</span><a href=\"https://issues.chromium.org/issues/582442907\"><span>582442907</span></a><span>] 高危 CVE-2026-125350：XML 中释放后使用。 </span><span>由 Arni Hardarson（Neonix Security）于 2026-10-12 报告，并由 </span><span>匿名人士</span><span>于 2026-11-06 报告</span></span></p><p><span><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/536663516\"><span>536663516</span></a><span>] 中危 CVE-2026-125349：GPU 中未初始化的资源。 </span><span>由 Google 于 2026-07-20 报告</span></span></p><p><span><span>[TBD][</span><a href=\"https://issues.chromium.org/issues/566384898\"><span>566384898</span></a><span>] 中危 CVE-2026-125342：GPU 中未初始化的资源。 </span><span>由 Vo Duc Thang（ugvxb）于 2026-09-26 报告</span></span></p><p><span><span>Google 已知悉针对 </span><span>CVE-2026-125350</span><span> 的漏洞利用已在现实环境中出现。</span></span></p><p><span><span>我们还要感谢所有在开发周期中与我们合作的安全研究人员，正是他们的工作防止了安全漏洞进入 Stable 频道。</span></span></p><p><span><span>我们的许多安全漏洞是通过 </span><a href=\"https://code.google.com/p/address-sanitizer/wiki/AddressSanitizer\"><span>AddressSanitizer</span></a><span>、</span><a href=\"https://code.google.com/p/memory-sanitizer/wiki/MemorySanitizer\"><span>MemorySanitizer</span></a><span>、</span><a href=\"https://www.chromium.org/developers/testing/undefinedbehaviorsanitizer\"><span>UndefinedBehaviorSanitizer</span></a><span>、</span><a href=\"https://www.chromium.org/developers/testing/control-flow-integrity/\"><span>Control Flow Integrity</span></a><span>、</span><a href=\"https://chromium.googlesource.com/chromium/src/+/HEAD/testing/libfuzzer/README.md\"><span>libFuzzer</span></a><span> 或 </span><a href=\"https://github.com/google/afl\"><span>AFL</span></a><span> 检测到的。</span></span></p><p><span>有意切换发布渠道？点击</span><span><a href=\"https://www.chromium.org/getting-involved/dev-channel\">此处</a><span>了解详情。如果您发现了新问题，请通过</span><a href=\"https://crbug.com/\">提交 bug</a><span>告知我们。</span><a href=\"https://support.google.com/chrome/community\">社区帮助论坛</a><span>也是寻求帮助或了解常见问题的好地方。</span></span></p><p><span><span>Srinivas Sista</span></span></p><p><span>Google Chrome</span></p>","original","zhKind","translation","complete","漏洞","补丁","Google","http://chromereleases.googleblog.com/2026/11/stable-channel-update-for-desktop_018223192.html","Chrome Releases",{"_84":85,"_86":-5},"changelogVersion","2026-10-01T08:00","release"]
