[{"_1":2,"_3":4},"root",{"_5":94},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794357638000,"id","ke43qtftrmo1i5qcbhrr32q9r","title","Chrome 157 稳定版更新修复 9 项安全漏洞，CVE-2026-125350 已被在野利用","originalTitle","Stable Channel Update for Desktop","summary","Chrome Stable 渠道已更新至 Windows 和 Mac 的 157.0.8103.50/.51、Linux 的 157.0.8103.50，将在未来数日或数周内推送。","reason","公告确认 CVE-2026-125350 已存在在野利用，并列出本次 Stable 渠道更新包含的 9 项安全修复及影响组件。","source",{"_74":93},"links",{"_86":92},"publishedAt","2026-11-09T20:52:57.820Z","discoveredAt","2026-11-09T21:33:26.693Z","timelineAt","category","vuln","tags",[90,75,91,78],"score",79,"selected",true,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","Srinivas Sista","body",{"_61":85,"_86":-5,"_87":88,"_89":37},"outline",[],"relatedStories",[81],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fDjAXcXjoma4","reportCount",5,"additionalSourceCount",4,{"_72":79,"_74":80},{"_72":77,"_74":78},{"_72":31,"_74":76},{"_72":73,"_74":75},"slug","exploited","name","在野利用","漏洞披露","browser","浏览器","google","Google / 谷歌",{"_82":83,"_13":84},"publicId","c3937e7e-f288-4355-b614-3e8068418e29","Chrome XML释放后重用零日漏洞已修复","<p>&nbsp;<span><span>Windows 和 Mac 的稳定版通道已更新至 157.0.8103.50/.51，</span><span> </span><span>Linux 已更新至 </span></span><span>157.0.8103.50，</span><span><span>将在未来数日或数周内逐步推出。本次构建的完整变更列表可在<a href=\"https://chromium.googlesource.com/chromium/src/+log/157.0.8103.39..157.0.8103.50?pretty=fuller&amp;n=10000\">日志</a>中查看。</span></span></p><p><span>安全修复与奖励</span></p><p><span><span>注意：在大多数用户安装修复版本之前，漏洞详情和链接的访问权限可能仍会受限。如果该漏洞存在于其他项目同样依赖的第三方库中，而这些项目尚未修复，我们也将继续保留限制。</span></span></p><p><span><span>本次更新包含 </span><a href=\"https://issues.chromium.org/issues?q=customfield1223088:1-M157\"><span>9</span></a><span> 项安全修复。有关更多信息，请参阅 </span><a href=\"https://www.chromium.org/Home/chromium-security\"><span>Chrome 安全页面</span></a><span>。</span></span></p><p><span><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/550525698\"><span>550525698</span></a><span>] 高危 CVE-2026-125345：WebGL 中未初始化的资源。 </span><span>由 Google 于 2026-08-21 报告</span></span></p><p><span><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/561996724\"><span>561996724</span></a><span>] 高危 CVE-2026-125347：FileSystem 中授权不正确。 </span><span>由 Google 于 2026-09-15 报告</span></span></p><p><span><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/561998123\"><span>561998123</span></a><span>] 高危 CVE-2026-125343：Compositing 中缓冲区溢出。 </span><span>由 Google 于 2026-09-15 报告</span></span></p><p><span><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/563358700\"><span>563358700</span></a><span>] 高危 CVE-2026-125348：GPU 中越界写入。 </span><span>由 Google 于 2026-09-18 报告</span></span></p><p><span><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/568893995\"><span>568893995</span></a><span>] 高危 CVE-2026-125344：V8 中类型混淆。 </span><span>由 Google 于 2026-10-02 报告</span></span></p><p><span><span>[TBD][</span><a href=\"https://issues.chromium.org/issues/572578603\"><span>572578603</span></a><span>] 高危 CVE-2026-125346：XML 中释放后使用。 </span><span>由 Arni Hardarson（Neonix Security）于 2026-10-12 报告</span></span></p><p><span><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/582442907\"><span>582442907</span></a><span>] 高危 CVE-2026-125350：XML 中释放后使用。 </span><span>由匿名人士于 2026-11-06 报告</span></span></p><p><span><span>[N/A][</span><a href=\"https://issues.chromium.org/issues/536663516\"><span>536663516</span></a><span>] 中危 CVE-2026-125349：GPU 中未初始化的资源。 </span><span>由 Google 于 2026-07-20 报告</span></span></p><p><span><span>[TBD][</span><a href=\"https://issues.chromium.org/issues/566384898\"><span>566384898</span></a><span>] 中危 CVE-2026-125342：GPU 中未初始化的资源。 </span><span>由 Vo Duc Thang（ugvxb）于 2026-09-26 报告</span></span></p><p><span><span>Google 已知悉针对 </span><span>CVE-2026-125350</span><span> 的利用代码已在真实环境中存在。</span></span></p><p><span><span>我们还要感谢在开发周期中与我们合作的所有安全研究人员，是他们的工作帮助防止安全漏洞进入稳定版通道。</span></span></p><p><span><span>我们的许多安全漏洞是通过 </span><a href=\"https://code.google.com/p/address-sanitizer/wiki/AddressSanitizer\"><span>AddressSanitizer</span></a><span>、</span><a href=\"https://code.google.com/p/memory-sanitizer/wiki/MemorySanitizer\"><span>MemorySanitizer</span></a><span>、</span><a href=\"https://www.chromium.org/developers/testing/undefinedbehaviorsanitizer\"><span>UndefinedBehaviorSanitizer</span></a><span>、</span><a href=\"https://www.chromium.org/developers/testing/control-flow-integrity/\"><span>Control Flow Integrity</span></a><span>、</span><a href=\"https://chromium.googlesource.com/chromium/src/+/HEAD/testing/libfuzzer/README.md\"><span>libFuzzer</span></a><span> 或 </span><a href=\"https://github.com/google/afl\"><span>AFL</span></a><span> 检测到的。</span></span></p><p><span>有意切换发布渠道？点击</span><span><a href=\"https://www.chromium.org/getting-involved/dev-channel\">此处</a><span>了解详情。如果您发现了新问题，请通过</span><a href=\"https://crbug.com/\">提交 bug</a><span>告知我们。</span><a href=\"https://support.google.com/chrome/community\">社区帮助论坛</a><span>也是寻求帮助或了解常见问题的好地方。</span></span></p><p><span><span>Srinivas Sista</span></span></p><p><span>Google Chrome</span></p>","original","zhKind","translation","complete","补丁","Google","http://chromereleases.googleblog.com/2026/11/stable-channel-update-for-desktop_018223192.html","Chrome Releases",{"_95":96,"_97":-5},"changelogVersion","2026-10-01T08:00","release"]
