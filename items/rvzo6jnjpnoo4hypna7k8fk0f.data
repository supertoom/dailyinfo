[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1793591188000,"id","rvzo6jnjpnoo4hypna7k8fk0f","title","群晖NAS设备遭C3RB3R勒索攻击，官方建议更新至安全版本","originalTitle","国内群晖NAS设备遭勒索攻击，官方建议尽快排查更新","summary","国内外多起群晖（Synology）NAS勒索攻击已被报告，部分设备文件被加密并添加.L0CK3D后缀，出现read-me3.txt勒索信，攻击被认为与C3RB3R（Cerber）勒索软件有关。","reason","多地用户报告群晖NAS遭勒索加密，官方已关联到旧版系统漏洞并给出更新、隔离和备份建议。","source",{"_75":96},"links",{"_90":95},"publishedAt","2026-10-31T00:09:00.000Z","discoveredAt","2026-10-31T13:02:30.480Z","timelineAt","category","activity","tags",[78,93,76,80,94,82],"score",78,"selected",true,"channel","news","story",{"_86":87,"_13":88},"x","readingMode","full","author","body",{"_61":89,"_90":-5,"_91":90,"_92":37},"outline",[],"relatedStories",[85],"topics",[68,69,70,71,72],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fWnIQuGAfSM0","reportCount",2,"additionalSourceCount",1,{"_73":83,"_75":84},{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","malware","name","恶意软件","attack","攻击活动","exploited","在野利用","vuln-mgmt","漏洞管理","ransomware","勒索软件",{"_86":87,"_13":88},"publicId","2949ac1d-5e61-43df-beff-1f3190aa95b7","C3RB3R利用群晖旧版漏洞实施勒索","<p><span>安全内参编译</span> <span>2026-10-31 08:09</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/c2e06ac481d2dbbe.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>勒索软件猖獗</p><p><strong><span>关注我们</span></strong></p><p><strong><span>带你读懂网络安全</span></strong></p><p><img src=\"/dailyinfo/media/8c68c5b42b03eb52.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>国内Linux DO、V2EX等社区及公众号均有用户发帖表示遭受了勒索攻击，也有安全厂商应急团队接到相关事件处置。</span></span></p><p><span>前情回顾·<span>勒索软件猖獗</span></span></p><ul><li><p><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247516413&amp;idx=2&amp;sn=103462bb66e80882bc0f08a4c5cac22e&amp;scene=21#wechat_redirect\">西安某公司遭勒索攻击：核心业务数据被加密，网警应急处置</a></span></p></li><li><p><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247514799&amp;idx=2&amp;sn=7ff33e2efb8cc05c1b70ba7406a4e182&amp;scene=21#wechat_redirect\">工信部：关于防范BERT勒索软件的风险提示</a></span></p></li><li><p><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247515305&amp;idx=1&amp;sn=a4e0844de579522efff55249fdcc42a3&amp;scene=21#wechat_redirect\">至少148亿元！近三年受害企业支付勒索软件赎金金额创新高</a></span></p></li></ul><p><span>安全内参10月31日消息，国内外陆续出现多起群晖（Synology）NAS设备遭受勒索软件攻击的事件，部分用户的文件被恶意加密，并被要求支付赎金才能恢复数据。10 月 30日，群晖官方公众号发布安全公告，确认攻击者正在利用旧版系统中已修复的安全漏洞实施攻击，提醒用户尽快检查并更新系统。</span></p><p><span><img src=\"/dailyinfo/media/32e746f5ff471a73.webp\" loading=\"lazy\" decoding=\"async\"></span></p><p><span><span>国外Reddit、BleepingComputer社区，国内Linux DO、V2EX等社区及公众号均有用户发帖表示遭受了勒索攻击，也有安全厂商应急团队接到相关事件处置。</span>部分受害设备中的文件被加密并添加.L0CK3D后缀，同时出现名为read-me3.txt的勒索信，相关攻击被认为与C3RB3R（Cerber）勒索软件有关。</span></p><p><span>根据目前公开信息，此次攻击主要与群晖NAS系统旧版漏洞有关（群晖安全公告：Synology-SA-24:20），尚不清楚攻击的具体细节及入侵手段。</span></p><p><span>建议使用群晖NAS的用户尽快检查并更新系统及相关应用，避免将NAS管理系统直接暴露在互联网，关闭不必要的远程访问功能，并定期将重要数据备份至独立或离线存储设备。</span></p><p><span>如发现文件突然无法打开、出现异常后缀或勒索提示，建议立即断开NAS的网络连接，保留现场，避免随意重启、重装或清理数据，并及时联系专业人员协助处理。</span></p><p><span><span>PS：中招用户也可后台或微信联系安全内参，我们可以协助联系安全团队进行应急处置，分析入侵根因等。</span></span></p><p><strong><span><span>推荐阅读</span></span></strong></p><ul><li><p><span><a href=\"http://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247499450&amp;idx=2&amp;sn=2da3ca2e0b4d4f9f56ea7f7579afc378&amp;chksm=ebfab99adc8d308c3ba6e7a74bd41beadf39f1b0e38a39f7235db4c305c06caa49ff63a0cc1d&amp;scene=21#wechat_redirect\">网安智库平台长期招聘兼职研究员</a></span></p></li><li><p><span><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247501251&amp;idx=1&amp;sn=8b6ebecbe80c1c72317948494f87b489&amp;chksm=ebfa82e3dc8d0bf595d039e75b446e14ab96bf63cf8ffc5d553b58248dde3424fb18e6947440&amp;token=525430415&amp;lang=zh_CN&amp;scene=21#wechat_redirect\">欢迎加入“安全内参热点讨论群”</a></span></span></p></li></ul><hr><p><span><span>点击下方卡片关注我们，</span></span></p><p><span><span>带你一起读懂网络安全 ↓</span></span></p><p><a href=\"https://www.secrss.com/?wx\">阅读原文</a></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=1bf7c4bd&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzI4NDY2MDMwMw%3D%3D%26mid%3D2247516811%26idx%3D1%26sn%3D8ec8e6aac1f429accbd887ba2446ebc3\">跳转微信打开</a></p>","original","zhKind","complete","勒索","网络设备","https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&mid=2247516811&idx=1&sn=8ec8e6aac1f429accbd887ba2446ebc3","安全内参",{"_98":99,"_100":-5},"changelogVersion","2026-10-01T08:00","release"]
