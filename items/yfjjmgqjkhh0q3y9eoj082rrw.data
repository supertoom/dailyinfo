[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":61,"_62":63},"expiresAt",1795394445000,"id","yfjjmgqjkhh0q3y9eoj082rrw","title","Amazon称中国关联黑客利用AI agents攻破MONAI Label漏洞","originalTitle","Amazon: China-Linked Hackers’ AI Agents Exploited Medical Software Zero-Day","summary","Amazon称，中国关联威胁组织运营的自主 AI agents 利用开源医疗影像标注工具 MONAI Label 的零日漏洞，针对东亚地区中国大陆以外大学 IP 发起约 48 小时攻击活动。","reason","source",{"_77":103},"links",{"_63":102},"publishedAt","2026-11-21T12:08:50.000Z","discoveredAt","2026-11-21T12:37:44.815Z","timelineAt","category","activity","tags",[78,80,97,82,98,99,100,101],"score",78,"selected",true,"channel","news","story",{"_88":89,"_13":90},"x","sameEvent",{"_11":95,"_13":96},"readingMode","full","author","Eduard Kovacs","body",{"_91":-5,"_63":92,"_93":-5,"_94":61},"outline",[],"relatedStories",[87],"topics",[70,71,72,73,74],"indexable","markdownAvailable","group",{"_64":65,"_66":67,"_68":69},"hasTranslation",false,"bodyLanguage","original","factId","fVbDsNwWSOac","reportCount",4,"additionalSourceCount",3,{"_75":85,"_77":86},{"_75":83,"_77":84},{"_75":81,"_77":82},{"_75":79,"_77":80},{"_75":76,"_77":78},"slug","attack","name","攻击活动","exploited","在野利用","ai-offense","AI 攻防","identity","身份与访问","supply-chain","供应链安全",{"_88":89,"_13":90},"publicId","52702772-c6ed-4351-9e9b-8fc6f1b0fd43","Cairn利用MONAI Label零日漏洞取得服务器权限","zh","<p><strong>Amazon says autonomous AI agents run by a China-linked threat actor found and exploited a zero-day vulnerability in MONAI Label, an open source tool designed for AI-assisted annotation of medical images.</strong>\n\n\n\n</p><p>The tech giant’s threat intelligence team detected the activity in September, after coming across an exposed instance of <a href=\"https://www.securityweek.com/ai-platform-cairn-abused-to-hack-over-100-organizations/\">Cairn</a>, an open source AI penetration testing framework. The instance had no authentication, so anyone could see the operator’s prompts and the agents’ output.\n\n\n\n</p><p>The records showed a roughly 48-hour campaign against IP addresses belonging to universities in East Asia outside mainland China. The operator gave the agents a list of targets and told them to obtain shell access.\n\n\n\n</p><p>After identifying the software on one target and mapping its API, the agents discovered a path traversal bug in a file upload function.\n\n\n\n</p><p>“In about 11 minutes, the agents went from mapping the application’s API to arbitrarily writing files on the server,” <a href=\"https://aws.amazon.com/blogs/security/chinese-nexus-actors-cairn-ai-agents-found-a-zero-day-on-their-own/\">Amazon said</a>.\n\n\n\n</p><p>In a later session, the agents used the flaw to plant a Python reverse shell in a file Python runs every time the interpreter starts, ultimately achieving a root shell.</p><p><span>Advertisement. Scroll to continue reading.</span></p><p>“Amazon Threat Intelligence assesses with high confidence that it was a zero-day based on the absence of any corresponding fix, issue, advisory, or prior mention in vulnerability databases for the affected open-source project,” the company said.\n\n\n\n</p><p>The operator then gave the agents a proxy that tunneled into a second university and instructed them to target other devices on its network.\n\n\n\n</p><p>“The server that the proxy connected to was running the same vulnerable software, and we infer the actor had used the zero-day to compromise it and establish the tunnel,” Amazon noted.\n\n\n\n</p><p>The MONAI Label developers published an <a href=\"https://github.com/Project-MONAI/MONAILabel/security/advisories/GHSA-qc22-rmgc-vg94\">advisory</a> this week. It rates the bug critical and says it affects versions 0.8.5 and earlier. Authentication is off by default, enabling anyone who can reach the server over the network to exploit the vulnerability. A fix has been created and will be included in the next release.&nbsp;\n\n\n\n</p><p>Amazon has attributed the attack to an unidentified Chinese-nexus threat actor with moderate confidence, based on the language used in the prompts, the time zone in the scripts, and the fact that the targeted universities are likely of strategic interest to China.\n\n\n\n</p><p><strong>Related</strong>: <a href=\"https://www.securityweek.com/european-commission-confirms-ai-assisted-cyberattack-disrupted-services/\">European Commission Confirms AI-Assisted Cyberattack Disrupted Services</a>\n\n\n\n</p><p><strong>Related</strong>: <a href=\"https://www.securityweek.com/china-linked-hackers-exploit-php2shell-to-root-firewalls/\">China-Linked Hackers Exploit PHP2Shell to Root Firewalls</a>\n\n\n\n</p><p><strong>Related</strong>: <a href=\"https://www.securityweek.com/barracuda-hacked-amid-surge-in-artex-powered-cyberattacks/\">Barracuda Hacked Amid Surge in Artex-Powered Cyberattacks</a>\n\n\n\n</p>","zhKind","complete","mfif5csbm0luk6anr64r4hzho","攻击者利用自主 AI 工具 Cairn 攻陷 MONAI Label 漏洞并取得服务器权限","漏洞利用","供应链","凭据","AWS","CNCERT","https://www.securityweek.com/amazon-china-linked-hackers-ai-agents-exploited-medical-software-zero-day/","SecurityWeek",{"_105":106,"_107":-5},"changelogVersion","2026-10-01T08:00","release"]
