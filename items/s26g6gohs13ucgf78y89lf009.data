[{"_1":2,"_3":4},"root",{"_5":103},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794185106000,"id","s26g6gohs13ucgf78y89lf009","title","法国国家血液服务机构因供应商遭网络攻击而中断 3 处冷库温控","originalTitle","Cyberattack disrupts blood storage refrigeration systems in France","summary","法国国家血液服务机构 EFS 确认，其制冷设备供应商 Coolworld Rentals 遭网络攻击后，3 处设施的冷库温控与除霜阈值被远程调至极高水平，事件发生于 November 2，EFS 于 November 3 发布声明。","reason","事件梳理了从单一供应商受攻击到欧洲多国零售制冷设备遭入侵的连续攻击链，并交代了检测、转移与加固措施，便于评估类似供应链风险。","source",{"_75":102},"links",{"_95":101},"publishedAt","2026-11-04T18:02:56.000Z","discoveredAt","2026-11-04T18:04:21.650Z","timelineAt","category","activity","tags",[76,78,99,100,84],"score",75,"selected",true,"channel","news","story",{"_86":87,"_13":88},"x","readingMode","full","author","Lawrence Abrams","body",{"_61":94,"_95":-5,"_96":97,"_98":37},"outline",[89],"relatedStories",[85],"topics",[68,69,70,71,72],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","ftEP5s1XGTbE","reportCount",2,"additionalSourceCount",1,{"_73":83,"_75":84},{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","attack","name","攻击活动","exploited","在野利用","iot","IoT 与车联网","supply-chain","供应链安全","cisa","CISA",{"_86":87,"_13":88},"publicId","4d83ff8b-d17c-4354-bda0-f4489637a7ca","法国 EFS 三处冷库温控因供应商遭攻击被改写",{"_11":90,"_91":92,"_93":65},"sec-1","text","发现现有防御可能遗漏的邮件威胁。","level","<p><img alt=\"Blood\" height=\"900\" src=\"/dailyinfo/media/265107dc7e8a4e5f.jpg\" srcset=\"/dailyinfo/media/610e1f1ecd9775ea.jpg 720w, /dailyinfo/media/4fcf62527a97aec5.jpg 1200w, /dailyinfo/media/265107dc7e8a4e5f.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>法国国家血液服务机构已证实，一起针对制冷设备供应商的网络攻击提高了其三处设施的温控和除霜设置，威胁到储存的血液制品。</p><p>负责全法国血液采集、处理和分发的法国血液机构（Établissement français du sang&nbsp;即 EFS）表示，事件发生于 11 月 2 日，影响了用于监控和控制冷藏室的系统。</p><p>根据 <a href=\"http://presse.efs.sante.fr/actualites/l-efs-confirme-l-incident-de-cybersecurite-impactant-un-de-ces-prestataires-d-equipement-frigorifique-2c07c-08a0a.html\">11 月 3 日发布的声明</a>，EFS 并非此次网络攻击的直接目标，遭到攻击的是其制冷设备供应商。</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/92235cbd221a113a.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>尽管 EFS 尚未公布受影响的供应商名称，但欧洲制冷设备供应商 Coolworld Rentals <a href=\"https://www.coolworld-rentals.com/news/cybersecurity-update\">在一份声明中证实</a>，一起涉及远程监控软件的网络安全事件影响了其数量有限的制冷设备。</p><p>Coolworld 表示，攻击者利用了某个第三方组件中的漏洞，该组件不在公司的直接控制范围内。</p><p>公司表示：“目前媒体正在报道的漏洞涉及第三方供应商的一个组件，不在 Coolworld 的直接控制范围内。”</p><p>公司表示：“只有数量有限的 Coolworld 设备受到影响，Coolworld 迅速作出响应并采取了适当措施。”</p><p>公司表示，正在与受影响的客户协作，但不会评论个别案例。</p><p>在 EFS，此次事件将受影响冷藏室的温度阈值和除霜阈值提高到了极高水平。</p><p>这些设施储存着分发至医院前的血液制品，以及由 EFS 保存的生物样本。</p><p>EFS 表示，其监控和警报系统迅速发现了温度变化，使工作人员能够修复受影响的设备，或将产品转移至其他制冷设施。</p><p>EFS 在声明中表示：“目前尚未发现对健康造成的影响，也没有报告血液制品损失。”[译自法语]</p><p>该机构证实，计划用于输注的血浆袋以及用于制造药品的血浆均已被转移或妥善保护，从而避免了产品损坏。</p><p>血液采集和分发业务持续进行，未受中断。</p><p>EFS 表示，其技术团队正与法国国家网络安全局（ANSSI）和卫生部协作，并已加强对制冷设备和温度的监控。</p><p>此次事件发生在一波针对欧洲各地制冷系统的网络攻击之后，攻击者通过远程操纵温度设置或启动除霜功能来关闭制冷。</p><p>10 月，<a href=\"https://www.bleepingcomputer.com/news/security/cyberattack-shuts-down-refrigerators-at-french-supermarkets/\">网络攻击扰乱了制冷系统</a>，估计波及法国 250 至 350 家超市，包括 Intermarché、Carrefour Market、Monoprix、Leclerc 和 Super U。</p><p>据报道，在这些攻击中，黑客入侵了运行旧版 Danfoss 软件的制冷控制器，并远程启动自动除霜功能，导致温度升高，迫使门店丢弃生鲜和冷冻产品。</p><p>这些&nbsp;攻击针对的是 Danfoss AK-SM/AK-SC 和 Copeland/Dixell XWEB 制冷控制器，这些控制器用于远程监控和管理制冷设备。</p><p>本月发生了<a href=\"https://www.bleepingcomputer.com/news/security/hackers-disrupt-refrigeration-systems-at-european-supermarkets/\">第二波攻击</a>，波及比利时、荷兰、瑞典、卢森堡、爱尔兰和爱沙尼亚的 115 家以上门店。</p><p>一些制冷系统被完全关闭，另一些则通过远程方式更改了温度设置。</p><p>据报道，瑞典一家超市的系统开始产生热量，而另一家门店则报告称温度被改为了 50°C (122°F)。</p><p>比利时制冷公司 Sabcobel 此前表示，11 月事件背后的攻击者利用了与 10 月针对法国超市的攻击相同的漏洞。</p><p>2025 年，美国网络安全和基础设施安全局 (CISA) <a href=\"https://www.cisa.gov/news-events/ics-advisories/icsa-25-140-03\">披露了两个漏洞</a>，这些漏洞会影响 Danfoss AK-SM 8xxA 控制器，追踪编号为 CVE-2025-41450 和 CVE-2025-41451。</p><p>这些缺陷可能允许攻击者绕过身份验证，并在易受攻击的系统上远程执行命令，从而可能使他们控制制冷设备。</p><p>然而，目前尚未确认这些漏洞是否正在这些攻击中被利用。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/03f545515f18a71f.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体能够分析邮件意图、上下文和行为，发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>通过为期 14 天的 Microsoft 365 或 Google Workspace 只读扫描，看看有哪些威胁正在穿透防御。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始您的免费邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","IoT","供应链","https://www.bleepingcomputer.com/news/security/cyberattack-disrupts-blood-storage-refrigeration-systems-in-france/","BleepingComputer",{"_104":105,"_106":-5},"changelogVersion","2026-10-01T08:00","release"]
