[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795135245000,"id","vk1903vlfzag26el6ya88dxxf","title","NATS Server MQTT retained message 与 QoS replay 绕过订阅拒绝规则","originalTitle","NATS Server MQTT retained messages and QoS replay bypass subscription deny rules","summary","NATS Server 的 MQTT retained message 投递和 QoS1+ durable replay 未一致复查消息原始主题，可能向拥有宽泛通配符订阅权限的用户发送被拒绝主题的消息。受影响版本为 v2.14.2、v2.12.11 及以下，v2.14.3 和 v2.12.12 已修复；MQTT 部署没有已知绕过方案，应升级到修复版本，不使用 MQTT 的部署不受影响。","reason","source",{"_69":81},"links",{"_59":80},"publishedAt","2026-11-20T00:04:27.000Z","discoveredAt","2026-11-20T00:23:20.227Z","timelineAt","category","vuln","tags",[77,78,79],"score",51,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fsD-rOtKMUZk","reportCount",1,"additionalSourceCount",0,{"_68":71,"_69":72},{"_68":30,"_69":70},"slug","name","漏洞披露","iot","IoT 与车联网",{"_74":75,"_13":76},"publicId","899ebd05-ace2-4b17-91a3-2b72c91c2078","NATS Server MQTT订阅拒绝规则可被绕过","漏洞","补丁","IoT","https://github.com/advisories/GHSA-7qmq-8cc4-hxwg","GitHub 安全公告",{"_83":84,"_85":-5},"changelogVersion","2026-10-01T08:00","release"]
