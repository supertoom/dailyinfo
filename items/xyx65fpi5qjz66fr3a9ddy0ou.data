[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1794195836000,"id","xyx65fpi5qjz66fr3a9ddy0ou","title","OpenSSH sshd 密码认证绕过漏洞已复现，影响 7.3p1 至 10.6p1","originalTitle","已复现！OpenSSH 密码认证绕过漏洞 （*sshole）","summary","OpenSSH sshd 密码认证绕过漏洞影响 Portable OpenSSH 7.3p1 至 10.6p1，在 Linux 使用 musl libc、未启用 PAM、开启密码认证且 MaxAuthTries > 1，并同时存在口令字段为 * 与 $5$ 或 $6$ 的账户时可能触发。","reason","source",{"_71":97},"links",{"_89":96},"publishedAt","2026-11-06T00:30:00.000Z","discoveredAt","2026-11-07T03:29:29.369Z","timelineAt","category","disclosure","tags",[92,93,94,95],"score",68,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","body",{"_60":88,"_89":-5,"_90":89,"_91":55},"outline",[79,80],"relatedStories",[75],"topics",[67,68],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","ftfujWtjc31U","reportCount",1,"additionalSourceCount",0,{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","research","name","技术研究","vuln","漏洞披露",{"_76":77,"_13":78},"publicId","9752aa65-824d-43a4-962f-2d752946dc78","OpenSSH musl认证绕过漏洞可致RCE",{"_11":86,"_82":87,"_84":85},{"_11":81,"_82":83,"_84":85},"sec-2","text","临时缓解措施","level",3,"sec-1","官方修复方案","<p><span>微步情报局</span> <span>2026-11-06 08:30</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/6cc9ec4d107da283.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>点击查看漏洞情报详情</p><p><span><span>漏洞概况</span></span></p><p><span>11月5日，OpenSSH官方紧急发布10.6p2版本，修复并披露了一处sshd密码认证绕过漏洞（主干修复Commit：4353fdc43ef646c43a8dda7025cc1a898caf1482）。</span></p><p><span>经微步情报局研判，此漏洞影响 7.3p1 至 10.6p1 的Portable OpenSSH版本，</span><span>但触发条件依赖特</span><span>定运行环</span><span>境和账户配置，仅在Linux系统底层使用 musl libc（如Alpine Linux等容器或发行版）、sshd编译或运行时未启用PAM支持且开启密码认证（PasswordAuthentication yes）时才受影响，使用glibc或启用PAM的常规主流Linux服务器环境无需恐慌。</span></p><p><span><span>利用条件：</span></span></p><p><span>系统配置</span></p><p><span>&nbsp; &nbsp; 1. 目标系统是 Linux，且 C 库为 musl（例如Alpine）</span></p><p><span>&nbsp; &nbsp; 2. 不启用PAM（Alpine 默认软件包 openssh-server 未启用 PAM）</span></p><p><span>&nbsp; &nbsp; 3. PasswordAuthentication yes。</span></p><p><span>&nbsp; &nbsp; 4. MaxAuthTries &gt; 1 （OpenSSH 默认 MaxAuthTries 6）</span></p><p><span>账户配置</span></p><p><span>&nbsp; &nbsp; 5.有一个账户，口令字段是 *（没设口令，不是锁定）</span></p><p><span>&nbsp; &nbsp; 6.另有一个账户，口令字段是 $5$ 或 $6$ 哈希（设过口令）</span></p><p><span>&nbsp; &nbsp; 这两行不必挨着，也没有顺序要求，存在即可</span></p><p><span>攻击者</span></p><p><span>&nbsp; &nbsp; 7.能连到这台机器的 SSH，并知道那个 * 账户的用户名</span></p><p><span>&nbsp; &nbsp; 8.对该账户发 257–1024 字节口令。一次连接即可（做两次口令认证）</span></p><p><span><span>用户可通过如下方案快速自查是否满足受影响前置条件：</span></span></p><ol><li><p><span>检查版本与C库环境：执行 sshd -V 确认版本处于 7.3p1 ~ 10.6p1 之间，并执行 ldd $(which sshd)，若输出中包含 musl 且未链接 libpam.so（或在链接了 libpam.so 时配置了 UsePAM no），则满足环境前置条件；</span></p></li><li><p><span>检查密码认证是否开启：执行 sshd -T | grep -i \"passwordauthentication\"（并检查 /etc/ssh/sshd_config 中是否存在 Match 块覆盖配置），若结果为 passwordauthentication yes，则存在受影响风险。</span></p></li></ol><p><span><span>建议受影响用户尽快将OpenSSH升级至 10.6p2 版本。</span></span></p><p><span>（完整漏洞情报请查阅<a href=\"https://x.threatbook.com/v5/vul/XVE-2026-91288%EF%BC%89\">https://x.threatbook.com/v5/vul/XVE-2026-91288）</a></span></p><p><span><span>漏洞影响范围</span></span></p><table><tbody><tr><td><p><span>产品名称</span></p></td><td><p><span>Portable OpenSSH（Linux / musl libc 环境）</span></p></td></tr><tr><td><p><span>受影响版本</span></p></td><td><p><span>&nbsp;7.3p1 至 10.6p1</span></p></td></tr><tr><td><p><span>有无修复补丁</span></p></td><td><p><span>有</span></p></td></tr></tbody></table><p><span><span>漏洞复现</span></span></p><p><span>微步情报局已在 Alpine Linux 3.22.7, OpenSSH 10.6p1下复现成功。</span></p><p><img src=\"/dailyinfo/media/6576654f44dfa16e.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>修复方案</span></span></p><h3 id=\"sec-1\"><span>官方修复方案</span></h3><p><span>官方已发布修复方案，请访问链接下载：</span></p><p><span><a href=\"https://www.openssh.org/txt/release-10.6p2\">https://www.openssh.org/txt/release-10.6p2</a></span></p><p><span>主干修复 Commit：4353fdc43ef646c43a8dda7025cc1a898caf1482</span></p><h3 id=\"sec-2\"><span>临时缓解措施</span></h3><p><span>在 /etc/ssh/sshd_config 中设置 PasswordAuthentication no（同时确保无 Match 块局部开启）以禁用密码认证、改用公钥认证，并重启sshd服务即可完全阻断。</span></p><p><span><span>微步产品支撑</span></span></p><p><span>微步漏洞情报于</span><span>&nbsp;2026-11-05&nbsp;</span><span>收录该漏洞。</span></p><p><span>微步下一代威胁情报平台NGTIP及X情报中心已于漏洞收录时向漏洞订阅用户推送该漏洞情报，并将持续推送后续更新；对于已经录入资产的用户，支持实时自动化排查受影响资产。</span></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=ba43ab10&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzg5MTc3ODY4Mw%3D%3D%26mid%3D2247509031%26idx%3D1%26sn%3D0ccee302d9069302d7d7532b0e68c026\">跳转微信打开</a></p>","original","zhKind","complete","复现","漏洞分析","漏洞利用","补丁","https://mp.weixin.qq.com/s?__biz=Mzg5MTc3ODY4Mw==&mid=2247509031&idx=1&sn=0ccee302d9069302d7d7532b0e68c026","微步在线研究响应中心",{"_99":100,"_101":-5},"changelogVersion","2026-10-01T08:00","release"]
