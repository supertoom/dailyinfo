[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795221637000,"id","nx3ab7e212lefg2qjv3go0r50","title","memtomem-stm 并发 LTM 恢复或重复重连并复用已取消的传输会话","originalTitle","memtomem-stm: Concurrent LTM recovery can duplicate reconnects or reuse a cancelled transport session","summary","memtomem-stm 的并发 LTM 恢复可能为同一脏会话触发多次重连，重连重试期间取消操作还可能使替换会话在协议交换中断后仍可复用。重复重连问题自 0.1.24 引入，取消恢复问题影响原文列明的更广版本范围；私有修复通过单调会话代次、每代次仅允许一次受保护的共享重连及代次感知取消处理进行修复。","reason","source",{"_68":77},"links",{"_59":76},"publishedAt","2026-11-20T23:38:15.000Z","discoveredAt","2026-11-20T23:47:29.986Z","timelineAt","category","vuln","tags",[74,75],"score",35,"selected",false,"channel","news","story",{"_71":72,"_13":73},"x","readingMode","full","author","body","outline",[],"relatedStories",[70],"topics",[66],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fDjtHrXc8p3w","reportCount",1,"additionalSourceCount",0,{"_67":30,"_68":69},"slug","name","漏洞披露",{"_71":72,"_13":73},"publicId","17ee48c6-3838-4394-883b-c59e9b88945e","memtomem-stm修复重连与会话复用漏洞","漏洞","补丁","https://github.com/advisories/GHSA-72jh-722p-rqr3","GitHub 安全公告",{"_79":80,"_81":-5},"changelogVersion","2026-10-01T08:00","release"]
