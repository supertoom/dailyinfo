[{"_1":2,"_3":4},"root",{"_5":94},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":-5,"_57":36,"_58":59},"expiresAt",1794271236000,"id","opq9f5mtyql25u1ifgya28upt","title","SEGA 第三方通讯服务数据泄露暴露 220 万个邮箱地址","originalTitle","SEGA newsletter data breach exposes 2.2 million email addresses","summary","SEGA 披露，第三方通讯服务商 ARARA 遭入侵后，11 个与 SEGA 和 SEGA Fave 产品或服务相关的 newsletter 泄露 220 万个订阅者邮箱，另有 92,300 条记录包含尚未确定的信息；SEGA Account 邮箱未受影响。","reason","source",{"_65":93},"links",{"_59":92},"publishedAt","2026-11-09T22:09:33.000Z","discoveredAt","2026-11-09T22:40:18.537Z","timelineAt","category","activity","tags",[66,88,89,90,91],"score",64,"selected",false,"channel","news","story","x","readingMode","full","author","Bill Toulas","body",{"_84":-5,"_59":85,"_86":-5,"_87":36},"outline",[71,72,73],"relatedStories",[],"topics",[60,61,62],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_63":69,"_65":70},{"_63":67,"_65":68},{"_63":64,"_65":66},"slug","attack","name","攻击活动","email","邮件与钓鱼","supply-chain","供应链安全",{"_11":82,"_75":83,"_77":81},{"_11":79,"_75":80,"_77":81},{"_11":74,"_75":76,"_77":78},"sec-3","text","Uncover email threats your existing defenses may miss.","level",2,"sec-2","SEGA Arcade still down",3,"sec-1","ARARA service breached","zh","<p><img alt=\"SEGA newsletter data breach exposes 2.2 million email addresses\" height=\"900\" src=\"/dailyinfo/media/b45da1ba0bfcd262.jpg\" srcset=\"/dailyinfo/media/d7c8d04ef88c8028.jpg 720w, /dailyinfo/media/fe728b41f20d64d2.jpg 1200w, /dailyinfo/media/b45da1ba0bfcd262.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>Japanese gaming giant SEGA has disclosed that a data breach at its third-party newsletter provider, ARARA, exposed the email addresses of 2.2 million newsletter subscribers.</p><p>The company says the exposed data also includes 92,300 records with additional information yet to be determined. The breach affects 11 newsletters linked to SEGA and SEGA Fave products and services.</p><p>The investigation found that the compromised data did not include customer names, dates of birth, gender, addresses, phone numbers, credit card details, or account passwords.</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/064b9eb3f3737273.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>Also, email addresses registered with a “SEGA Account” are handled by a separate distribution system and were not affected by this incident.</p><p>The company is working with ARARA to determine what data was exposed and says it has no confirmed evidence of misuse.</p><p>“We are currently investigating the information associated with newsletter distribution in cooperation with ARARA,” <a href=\"https://www.sega.co.jp/release/261109_1.html\">SEGA stated</a>.</p><h3 id=\"sec-1\">ARARA service breached</h3><p>ARARA disclosed on November 2 that it suffered a massive breach affecting its email distribution service, which <a href=\"https://www.arara.com/dcms_media/other/arara_20261102__.pdf\">compromised 77 million email addresses</a> from nearly 380 corporate clients.</p><p>According to the company, a web server vulnerability and problems in its system environment contributed to the incident, but the exact intrusion method and timing remain under investigation.</p><p>ARARA previously estimated a smaller impact and assured SEGA on October 29 that no data compromise had occurred.</p><p>However, on November 3, after uncovering the full extent of the incident, ARARA notified the gaming company that data had been exposed and shared the full details between November 5 and 8.</p><p>ARARA also said the attackers abused their access to its service to send over 7 million emails impersonating credit card companies in late October.</p><p>Other notable victims of the same incident include <a href=\"https://www.mos.jp/topics/20261104_2/\">MOS Burger</a>, with 7.5 million email addresses exposed, <a href=\"https://www.smt-cinema.com/site/shinjuku/news/detail/098809.html\">Shochiku Multiplex Theatres</a>, with 3.3 million records, <a href=\"https://www.tkc.jp/news/2026/20261104/\">TKC</a>, with 2.3 million email addresses, and <a href=\"https://www.iij.ad.jp/news/information/2026/1104.html\">IIJmio</a>, with nearly 1 million email addresses.</p><h3 id=\"sec-2\">SEGA Arcade still down</h3><p>SEGA Fave’s arcade game network services, which suffered a separate cybersecurity incident last week, are still offline, undergoing maintenance and safety checks.</p><p>On November 2, SEGA FAVE, SEGA's subsidiary responsible for toys, electronic gadgets, and arcade machine operations, <a href=\"https://www.segafave.co.jp/news/261102_1/\">disclosed unauthorized access</a> to servers supporting its ALL.Net and Aime arcade gaming network services.</p><p>In response, it suspended all related services, including online gameplay, SEGA Lucky Kuji Online, and new SEGA ID registrations.</p><p>Its initial investigation found no evidence of customer or business partner data exfiltration, while payment information was unaffected because it was stored separately.</p><p>SEGA noted that the two incidents are unrelated.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/fade1788f362b90e.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-3\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Uncover email threats your existing defenses may miss.</a>\n        </h2><p>Adaptive Security's AI agents analyze email intent, context, and behavior to uncover phishing, business email compromise, and invoice fraud.</p><p>See what's getting through with a 14-day read-only scan of Microsoft 365 or Google Workspace, with no MX changes.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Start your free email security scan.</a>\n    </p>","zhKind","complete","数据泄露","钓鱼","供应链","邮件安全","https://www.bleepingcomputer.com/news/security/sega-newsletter-data-breach-exposes-22-million-email-addresses/","BleepingComputer",{"_95":96,"_97":-5},"changelogVersion","2026-10-01T08:00","release"]
