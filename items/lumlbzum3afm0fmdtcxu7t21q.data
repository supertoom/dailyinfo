[{"_1":2,"_3":4},"root",{"_5":116},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794357639000,"id","lumlbzum3afm0fmdtcxu7t21q","title","Claude Code 将批准命令中的密码与密钥明文保存在项目文件，GitHub 发现 1,122 份公开副本","originalTitle","Claude Code's “Don't Ask Again” File Exposes Passwords and Keys in 1,122 Public Copies on GitHub","summary","Claude Code 在用户选择“Yes, and don't ask again”后，会将批准的命令原样写入 .claude/settings.local.json，若命令含密码或令牌也会以明文保存。","reason","材料量化了 Claude Code 持久化命令泄露凭据的范围，并给出轮换凭据、清理历史和调整命令审批方式等可迁移处置方法。","source",{"_74":115},"links",{"_104":114},"publishedAt","2026-11-07T06:44:17.000Z","discoveredAt","2026-11-07T11:51:30.542Z","timelineAt","category","ai-security","tags",[75,108,109,110,77,111,112,113],"score",72,"selected",true,"channel","news","story",{"_85":86,"_13":87},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_61":103,"_104":-5,"_105":106,"_107":37},"outline",[88,89,90,91],"relatedStories",[84],"topics",[68,69,70,71,72],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","f1ge8P8MXsCI","reportCount",1,"additionalSourceCount",0,{"_73":82,"_74":83},{"_73":80,"_74":81},{"_73":78,"_74":79},{"_73":76,"_74":77},{"_73":31,"_74":75},"slug","name","AI 安全","research","技术研究","ai-offense","AI 攻防","identity","身份与访问","supply-chain","供应链安全",{"_85":86,"_13":87},"publicId","d3228e4a-552b-4911-b22d-552fc43e64e1","Claude Code凭据被明文写入公开仓库",{"_11":101,"_93":102,"_95":96},{"_11":99,"_93":100,"_95":96},{"_11":97,"_93":98,"_95":96},{"_11":92,"_93":94,"_95":96},"sec-4","text","此前报告","level",3,"sec-3","建议措施","sec-2","Apiiro 的发现","sec-1","机密信息如何进入文件","<p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhZH3vYLZb9lP7mDLqy2h-upzdComeWIfjDX5siFUO3FM2HlUs03OTwirA1R2uzOZq_clptIVBsoaJNXIuf8LlTbXHFvzBJLRl1l3mqGVesHjgdmD86S_c-k2JY_t56xZqI0bnN6jXRDr92KlMw6X5BHzm5hqogpWflsERi9zrsMHSS_abAcvZMcUGovd8/s1600/claude-code.jpg\"><img alt=\"\" src=\"/dailyinfo/media/d418ad6c7ed5c4d8.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>开发者输入到 Claude Code 所批准命令中的密码和 API 密钥，正存放在公开的 GitHub 仓库中，任何人都可以读取。</p><p>当用户选择“<strong>是，并且不要再询问</strong>”时，Anthropic 的 AI 编程助手可以将该命令逐字保存（包括其中的机密信息）到项目设置文件中。</p><p>软件安全公司 Apiiro 昨天表示，有 1,122 份该文件的公开副本至少包含一个机密信息，但它没有测试其中是否仍有效。研究人员本周早些时候通知的一家公司确认，其密钥一直处于有效状态。</p><p>该文件是&nbsp;.claude/settings.local.json。从项目中移除它也无法挽回泄露，因为旧版本仍保留在 git 历史记录和仓库的分支副本中。研究人员的建议是首先轮换：更改该文件曾经保存过的每一个密码、令牌和密钥，然后再进行清理。</p><h3 id=\"sec-1\">机密信息如何进入文件</h3><p>默认情况下，Claude Code 在运行大多数 shell 命令前都会询问。根据其&nbsp;<a href=\"https://code.claude.com/docs/en/permissions\">权限文档</a>，如果用户选择“是，并且不要再询问”，它就会在项目内的&nbsp;.claude/settings.local.json&nbsp;中保存一条允许规则。此后，符合匹配条件的命令在后续会话中运行时将不再询问。</p><p>该规则仅涵盖提示中提供的范围。有时是一个模式，例如&nbsp;npm test *，有时则是一条完全准确的命令。如果是完全准确的命令，输入其中的任何密码或令牌也会被保存，而且是以明文形式保存。</p><p>研究人员发现了内容中仍含机密信息的已保存命令，并使用最新模型 Opus 5.5 和 Fable 5.1 复现了这一行为。</p><p>Claude Code 会尝试防止该文件被纳入 git。据其&nbsp;<a href=\"https://code.claude.com/docs/en/settings\">设置文档</a>说明，第一次在 git 仓库中写入该文件时，它会将该文件添加到用户的全局 git 排除列表中。此后，那台计算机上的 git 会在每个仓库中忽略该文件。</p><p>研究人员表示，这种保护仅存在于某一台计算机上某个用户的 git 设置中，对于已经提交过的文件毫无作用。Claude Code 绝不会将该文件添加到项目自身的&nbsp;.gitignore&nbsp;中，因此这种保护不会随项目一同生效。</p><p>在研究人员追踪的 1,105 个仓库中，有 539 个仓库的某次提交将 Claude 列为共同作者。他们据此认为，Claude 经常会自行提交该文件。</p><h3 id=\"sec-2\">Apiiro 的发现</h3><p>Apiiro 对公开 GitHub 的搜索发现了 104,185 份该文件的副本，分布在 103,617 个仓库中，其&nbsp;<a href=\"https://apiiro.com/blog/coding-agents-leaking-secrets-github-dont-ask-again\">研究论文</a>显示。其中约 1.1%，即 1,122 份副本，至少包含一个机密信息。这些副本合计包含 1,379 个不同的机密信息。</p><p>当某个值与已知密钥格式匹配，或某个密码或令牌位于公共服务器地址旁边时，该值即被计为机密信息。此外还需要一名 AI 审核员同意。研究人员没有说明是否有人使用过这些机密信息。</p><p>超过三分之一的机密信息可直接用于打开数据库，其中包括 379 个数据库密码。其他机密信息包括 43 组公共服务器的 SSH 登录凭据、42 个用于 GitHub、GitLab 和 npm 的令牌，以及 23 个 AWS 密钥。</p><p>这些文件的所属者包括 63 个组织，其中大多是各种规模的软件公司。研究人员表示，最严重的案例包括某数据库厂商自己的管理员级云密钥，以及某医疗记录数据库的所有者密码。</p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgQVOrBlt7EwCzNEBgEvGmZt6L9NtTw0cDMJzh46DkBbRQFYTW3STOiQVVoFAV4ubNrE0J5KNYuQfm85YxBFLANDlOvJnyC4dCpVj6e_RZB8GS5vOicQM6IVJ8UFv77vuMlXk-_YtyNBxuhzIkFFkyQzaOS_7Hbz5J8IJB55KqRBl_1rzBjBdqiKmfbnzw/s1600/leaked.png\"><img alt=\"\" src=\"/dailyinfo/media/5a2f608f56affbd7.webp\" loading=\"lazy\" decoding=\"async\"></a></p><p>截至周一，每个包含机密信息的文件仍位于其所在仓库的默认分支上，而在这些仓库中，有一半至少在 217 天前就已存在该文件。</p><p>该文件的旧版本在 509 个仓库中包含另外 734 个未出现在任何当前副本中的密钥，通常是因为文件已被删除。Fork 会进一步传播这些文件：74 个仓库的 211 个 fork 携带了与原始文件相同的密钥。</p><p>在共享的 .claude/settings.json 文件的 76,011 个副本中，也有 298 个包含密钥；团队通常是故意将其提交到仓库中的，而且大多位于允许规则里。包括这些文件、旧版本以及保存的代理聊天日志，总计在 1,994 个仓库中发现了 2,539 个密钥。</p><p>研究人员比较了 16 个编程代理的文档，Claude Code 是唯一一个经确认默认会将完整的已批准命令保存到项目文件中的代理。</p><h3 id=\"sec-3\">建议措施</h3><p>研究人员建议开发人员采取以下步骤：</p><ol>\n  <li>在 GitHub 组织中搜索&nbsp;.claude/settings.local.json&nbsp;和&nbsp;.claude/settings.json，并检查每个仓库的 git 历史中是否存在这些文件，即使这些文件已消失。</li>\n  <li>在清理之前，轮换这些文件曾经保存过的每个密码、令牌和密钥。</li>\n  <li>使用&nbsp;git rm --cached .claude/settings.local.json&nbsp;停止跟踪本地文件，并将其添加到仓库自己的&nbsp;.gitignore&nbsp;中。</li>\n  <li>在自己的计算机上打开该文件，即使它从未被提交过，并删除其中每条包含密钥的规则。</li>\n  <li>不要在命令中直接使用密钥。应通过变量引用它们，例如使用来自密钥管理器的&nbsp;$DB_URL，这样保存的规则中只会包含变量名，而不会包含密钥。</li>\n  <li>批准模式，例如&nbsp;Bash(npm run:*)，而不是单条命令。</li>\n</ol><p>研究人员表示，即使副本从未到达 GitHub，也仍然值得关注。该文件是项目文件夹中的纯 JSON，也可能被留在 npm 包、Docker 镜像、zip 压缩包或同步文件夹中。</p><p>此前，恶意软件曾寻找开发者计算机上的密钥。2025 年 9 月，<a href=\"https://thehackernews.com/2025/09/40-npm-packages-compromised-in-supply.html\">Shai-Hulud worm</a>&nbsp;在受感染计算机上运行了 TruffleHog 密钥扫描器，该扫描器将一半以上的文件标记为含有密钥。</p><p>常见的密钥扫描器会漏掉许多此类文件。研究人员对每个副本运行了 gitleaks 和 TruffleHog，且未启用这些工具的验证步骤。在包含密钥的 1,122 个文件中，gitleaks 标记了 564 个，TruffleHog 标记了 643 个，两者都未标记的有 215 个。</p><p>大多数漏报是直接在命令中输入的密码。扫描器会查找已知的密钥格式，而位于&nbsp;PGPASSWORD=、&nbsp;sshpass -p&nbsp;或&nbsp;mysql -p&nbsp;之后的密码看起来就像普通命令行中的普通单词。</p><p>研究人员建议安全团队采取以下措施：</p><ul>\n  <li>将代理文件夹，例如&nbsp;.claude/、&nbsp;.cursor/、&nbsp;.gemini/&nbsp;和&nbsp;.specstory/，以及代理记忆文件，视为保存有密钥，就像&nbsp;.env&nbsp;文件一样，在笔记本电脑和仓库中都要加以防范。</li>\n  <li>将这些文件加入提交前和 CI 密钥扫描范围，包括 git 历史，并确保扫描器能够检测命令内部的密码，而不只是已知的密钥格式。</li>\n  <li>将&nbsp;.claude/settings.local.json&nbsp;添加到组织的&nbsp;.gitignore&nbsp;模板中。</li>\n  <li>优先检查与公共服务器配对的凭据，因为这些凭据最容易被利用来获得访问权限。</li>\n</ul><h3 id=\"sec-4\">此前报告</h3><p>Claude Code 用户此前已报告过这种行为。一份于 2025 年 8 月 11 日提交的<a href=\"https://github.com/anthropics/claude-code/issues/5544\">早期漏洞报告</a>称，包含 API 密钥和令牌的已批准命令会逐字保存在&nbsp;settings.local.json&nbsp;中。</p><p>一个自动机器人于 1 月 3 日将该报告以“不计划处理”为由关闭，此前该报告已 60 天没有活动。</p><p>截至今天，研究人员引用的四份相关报告均已由同一个机器人关闭，最近一份是在昨天关闭的。他们表示，这些报告都没有得到 Anthropic 的回复。</p><p>觉得这篇文章有意思吗？关注我们的 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a>，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","AI 编码","凭据","数据泄露","供应链","AWS","CISA","https://thehackernews.com/2026/11/claude-codes-dont-ask-again-file.html","The Hacker News",{"_117":118,"_119":-5},"changelogVersion","2026-10-01T08:00","release"]
