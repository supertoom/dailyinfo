[{"_1":2,"_3":4},"root",{"_5":103},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1795308031000,"id","aic8t54y553fsvumjye9bjj9o","title","Google 警告 AI 驱动的全自动攻击即将出现","originalTitle","Google warns that fully-automated AI attacks are coming soon","summary","Google Threat Intelligence Group 已观察到攻击者利用 ARTEX、CAIRN、CyberStrikeAI 和 HexStrike AI 自动发现并利用漏洞，其中多智能体框架 exploit_agent 已用于攻击法国媒体、娱乐和教育网站。","reason","文章展示了多智能体框架自动化漏洞发现与利用的实例，可用于评估 AI 介入攻击后的响应时间与防御负担变化。","source",{"_67":102},"links",{"_93":101},"publishedAt","2026-11-16T14:00:00.000Z","discoveredAt","2026-11-16T14:35:14.786Z","timelineAt","category","ai-security","tags",[68,74,97,72,70,98,99,100],"score",74,"selected",true,"channel","news","story","x","readingMode","full","author","Bill Toulas","body",{"_59":92,"_93":-5,"_94":95,"_96":37},"outline",[79,80,81],"relatedStories",[],"topics",[60,61,62,63,64,65],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_66":77,"_67":78},{"_66":75,"_67":76},{"_66":73,"_67":74},{"_66":71,"_67":72},{"_66":69,"_67":70},{"_66":31,"_67":68},"slug","name","AI 安全","malware","恶意软件","attack","攻击活动","ai-offense","AI 攻防","ai-agent","AI Agent 安全","google","Google / 谷歌",{"_11":90,"_83":91,"_85":89},{"_11":87,"_83":88,"_85":89},{"_11":82,"_83":84,"_85":86},"sec-3","text","发现您现有的防御措施可能遗漏的邮件威胁。","level",2,"sec-2","其他 AI 使用趋势",3,"sec-1","使用 AI 查找并利用漏洞","<p><img alt=\"Google warns that fully-automated AI attacks are coming soon\" height=\"900\" src=\"/dailyinfo/media/9d0a90e5d47e08d9.jpg\" srcset=\"/dailyinfo/media/7d2f5371f36cbba4.jpg 720w, /dailyinfo/media/14a580df4d4c3ceb.jpg 1200w, /dailyinfo/media/9d0a90e5d47e08d9.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>威胁行为者如今越来越依赖由基于 AI 的进攻性框架驱动的智能体工作流，自动化漏洞发现与利用，将攻击加速至机器速度。</p><p>尽管 AI 最初仅在攻击流程中被试验性使用，但 Google Threat Intelligence Group (GTIG) 已观察到，出于经济利益考量的威胁组织和国家支持的威胁组织都已大规模采用该技术。</p><p>一个值得注意的例子是使用 <a href=\"https://www.bleepingcomputer.com/news/security/malicious-ai-agents-steal-600k-credit-cards-infect-100-plus-sites-with-skimmers/\">CAIRN</a> 这一开源多智能体渗透测试框架，针对美国航空航天行业发动攻击；此外，还疑似有朝鲜黑客使用 Claude Code 投递恶意软件。</p><p><a href=\"https://www.wiz.io/lp/securing-ai-agents-101?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY26Q3_INB_FORM_Securing-AI-Agents-101&amp;sfcid=701Py00000RTEWMIA5&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AI-Agents-101\"><img src=\"/dailyinfo/media/a18596f61724a76c.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>研究人员估计，未来三个月内，威胁行为者将能够发起几乎“无需或完全无需人工交互”的不复杂攻击，并主要依赖多个 AI 智能体。</p><p>他们预测，“复杂、完全自主”的智能体攻击很可能在未来六个月内出现。&nbsp;</p><figure><img alt=\"Evolution of AI use in cyberattacks\" height=\"287\" src=\"/dailyinfo/media/032d59051028a9b1.jpg\" srcset=\"/dailyinfo/media/a8a14e8fc8e2e072.jpg 720w, /dailyinfo/media/765e6e36523cf16e.jpg 1200w, /dailyinfo/media/032d59051028a9b1.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"900\">\n<figcaption><strong>AI 在网络攻击中的使用演变</strong><br>\n<em>来源：Google</em></figcaption>\n</figure><p>在上周发布的一份通告中，<a href=\"https://www.bleepingcomputer.com/news/security/fbi-warns-artex-ai-hacking-tool-is-powering-global-cyberattacks/\">FBI 警告称</a>，多个威胁行为者自 8 月以来开始将 ARTEX AI 渗透测试框架武器化，并对金融、政府、科技、国防、医疗保健及其他行业的组织发动攻击。</p><h3 id=\"sec-1\">使用 AI 查找并利用漏洞</h3><p>Google 表示，攻击者如今会系统性地滥用开源渗透测试套件来发起全自动攻击，其中包括 ARTEX、CAIRN、CyberStrikeAI 和 HexStrike AI。</p><p>攻击者使用这些框架，针对暴露在互联网上的、存在低复杂度漏洞的终端发起自适应攻击，而大语言模型 (LLM) 可以轻松为这些漏洞构建利用代码。</p><p>GTIG 在其 AI Threat Tracker 报告重点介绍的一个示例中，黑客使用名为“exploit_agent”的多智能体系统，在针对法国媒体、娱乐和教育网站发动的攻击中，完全自动化了漏洞发现与利用。</p><p>“在过去一个季度中，GTIG 首次发现威胁行为者使用 LLM 框架，在无人参与的情况下完全自动化漏洞发现与利用，”<a href=\"https://cloud.google.com/blog/topics/threat-intelligence/agentic-threat-activity-crosses-a-significant-threshold\">Google 表示</a>。</p><p>“更具体地说，GTIG 发现了一台暴露在外的暂存服务器，其上托管着一个名为 exploit_agent 的多智能体漏洞研究与武器化框架，该框架集成了多个前沿 LLM 和本地 LLM。”</p><p>Google 从攻击者暴露的暂存服务器上发现了该框架，该服务器还包含被盗受害者数据、侦察信息、WebShell 以及暴力破解脚本。</p><p>该系统分析热门 Web 应用的软件更新，以查找安全缺陷的迹象，并自动尝试利用这些缺陷。</p><p>Google 警告称，在攻击中部署此类框架大幅压缩了防御方修补系统的时间，同时也会产生错误线索。</p><p>研究人员提到了近期 PHP2Shell 的例子：PHP 宣布这两个漏洞后不久，便出现了数百个所谓的概念验证 (PoC) 利用代码，其中大多由 AI 生成。这给防御方带来了沉重的负担，因为他们必须验证代码并制定防护措施。</p><figure><img src=\"/dailyinfo/media/1f4600167b870a96.jpg\" srcset=\"/dailyinfo/media/f23938b2ff94d410.jpg 720w, /dailyinfo/media/befdfbfcb9479e36.jpg 1200w, /dailyinfo/media/1f4600167b870a96.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Monthly volume of exploited flaws\" height=\"444\" width=\"900\">\n<figcaption><strong>每月被利用漏洞的数量</strong><br>\n<em>来源：Google</em></figcaption>\n</figure><h3 id=\"sec-2\">其他 AI 使用趋势</h3><p>除自动化攻击外，Google 还发现了来自 UNC6836 的多起攻击。该活动集群疑似与“Midnight Neptune”有关联，其使用经过修改的 Claude Code，针对北美和欧洲的加密货币公司发动攻击。</p><p>初次入侵后，攻击者修改了 Claude Code 应用的设置，使其在启动时触发 SOMBERMEME 后门的下载。</p><p>Google 报告称，AI 目前已被国家支持的组织、商业供应商和政治网络常规用于影响行动。</p><p>研究人员表示，LLMjacking 已成为一个普遍存在的问题，攻击者正日益以<a href=\"https://www.bleepingcomputer.com/news/security/google-llmjacking-attacks-rack-up-1-million-in-cloud-ai-charges/\">高昂成本</a>为受影响组织利用这一新的收入来源。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/17b5e88b2b65d47e.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-3\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现您现有的防御措施可能遗漏的邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体会分析邮件意图、上下文和行为，以发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>通过为 Microsoft 365 或 Google Workspace 提供 14 天只读扫描，查看有哪些内容能够绕过防护，且无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始您的免费邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","Agent 安全","大模型","Google","PHP","https://www.bleepingcomputer.com/news/security/google-warns-that-fully-automated-ai-attacks-are-coming-soon/","BleepingComputer",{"_104":105,"_106":-5},"changelogVersion","2026-10-01T08:00","release"]
