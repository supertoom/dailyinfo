[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795740036000,"id","f1pcvmbn6syja58uaunr4cute","title","Microsoft 软件缺陷引发全球 Microsoft 365 近 24 小时服务中断","originalTitle","Microsoft says months-old bug caused global Microsoft 365 outage","summary","Microsoft 365 因 7 月引入的软件缺陷引发全球服务中断超过 80% 网络网关服务器无响应，影响 Outlook、Exchange Online、Teams 和 Copilot。","reason","事件还原了软件缺陷、流量激增与容量下降叠加后形成级联故障的过程，为分析全球服务中断的成因和防护失效机制提供参考。","source",{"_72":97},"links",{"_88":96},"publishedAt","2026-11-16T16:43:24.000Z","discoveredAt","2026-11-16T17:26:14.541Z","timelineAt","category","vuln","tags",[92,93,94,95],"score",77,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","Lawrence Abrams","body",{"_61":87,"_88":-5,"_89":90,"_91":37},"outline",[82],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fTqlpso7s9gg","reportCount",3,"additionalSourceCount",2,{"_71":76,"_72":77},{"_71":74,"_72":75},{"_71":31,"_72":73},"slug","name","漏洞披露","cloud-native","云与原生","microsoft","Microsoft / 微软",{"_79":80,"_13":81},"publicId","d0fbf5e0-7524-44ac-ae11-b93399172446","微软365中断由软件缺陷引发，钓鱼已确认",{"_11":83,"_84":85,"_86":67},"sec-1","text","发现现有防御可能遗漏的电子邮件威胁。","level","<p><img alt=\"Microsoft 365\" height=\"900\" src=\"/dailyinfo/media/8300d54473bf348b.jpg\" srcset=\"/dailyinfo/media/e04faa190c59b559.jpg 720w, /dailyinfo/media/bb5d91d98a0999c2.jpg 1200w, /dailyinfo/media/8300d54473bf348b.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>微软表示，7月引入的一个软件漏洞导致上周全球范围的 Microsoft 365 中断，引发级联故障，使超过 80% 的网络网关服务器失去响应。</p><p>11月12日近24小时的中断<a href=\"https://www.bleepingcomputer.com/news/microsoft/massive-microsoft-365-outage-disrupts-outlook-teams-copilot-worldwide/\">影响了全球 Microsoft 365 服务</a>，包括 Outlook、Exchange Online、Teams 和 Copilot，导致用户无法访问电子邮件，并造成消息投递严重延迟。</p><p>公司在 Microsoft 365 管理中心共享的事故初步报告中表示，中断由三个问题引发：一个此前未检测到的软件漏洞、Microsoft Teams 故障切换后增加的流量，以及服务器容量下降。</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/92bcac73460d74f9.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>事故于11月12日星期四美国东部时间上午11:20开始，并持续至次日上午11:10，届时微软确认所有服务均已完全恢复。</p><p>据微软称，该软件漏洞是通过为 Microsoft 365 网络网关服务器开发的更新于7月引入的。</p><p>尽管该更新已部署三个多月且未出现问题，但它包含一个漏洞，在特定流量条件下可能使服务器不堪重负并停止响应。</p><p>微软表示，其对该更新进行的测试未能检测到该漏洞，因为测试使用的是性能低于生产服务器的硬件。</p><p>微软在初步报告中解释道：“我们正常的负载测试未能检测到这一潜在问题，因为我们实验室使用的流量组合和 SKU 不同。”</p><p>微软进一步表示：“在核心数更多、硬件更新的机器上，这一资源争用问题会变得更严重；而我们的负载测试往往侧重于核心数较少的较弱硬件。”</p><p>最终，在中断发生约15小时前，Microsoft Teams 自动切换到了 Exchange Online 所使用的网络基础设施，导致这些服务器的流量增加，从而触发了该漏洞。</p><p>Microsoft Teams 在当天早些时候也遭遇了一次单独的中断，但尚不清楚两起事故是否相关。</p><p>更糟糕的是，微软表示，由于一个无关问题，网关近14%的服务器容量已处于离线状态。尽管基础设施仍有足够容量应对容量缩减，但流量增加与容量下降相结合触发了该软件漏洞。</p><p>随着服务器停止响应，微软的系统将用户重定向至其他可用服务器，而这些服务器也因新增流量而不堪重负并发生故障。</p><p>微软解释道：“不到两小时，这一此前未知的缺陷便出现在我们的整个服务器集群中，并使其失去响应。最低时，超过80%的服务器失去响应。”</p><p>微软表示，旨在防止问题在不同区域之间扩散的保护措施，也未能遏制级联中断，导致中断蔓延至全球。</p><p>虽然 Teams、OneDrive 和 SharePoint 等其他 Microsoft 365 服务能够切换至替代基础设施并更早恢复，但 Exchange Online 无法进行同样的切换，导致用户无法访问其邮箱。</p><p>微软表示，恢复过程十分困难，因为重启受影响的服务器后，积压的流量很快再次使其不堪重负。</p><p>在确定该漏洞后，微软工程师开发了修复程序，并将其部署到所有受影响的服务器上，使服务在整个星期五期间恢复稳定。</p><p>微软确认，活跃客户影响已于11月13日美国东部时间上午11:10结束。</p><p>该公司表示，此后已提高容量、改进监控，并增加防护措施，以防止流量重定向再次引发类似的连锁故障。</p><p>Microsoft Copilot、Agents 和 Platform 执行副总裁 Charles Lamanna 在 X 上另行发表声明，就此次中断致歉。</p><p>Lamanna 表示：“我们对此次事件给所有客户造成的影响深表歉意，也认识到这对其正常业务和运营造成的影响。”</p><p>Microsoft 表示，调查仍在继续，预计本周晚些时候发布最终的事件报告。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/3d0888eec2a1da78.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体会分析电子邮件意图、上下文和行为，揭示网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>对 Microsoft 365 或 Google Workspace 进行 14 天只读扫描，看看有哪些威胁能够绕过防护，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始免费电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","漏洞","补丁","Microsoft","云原生","https://www.bleepingcomputer.com/news/microsoft/microsoft-says-months-old-bug-caused-global-microsoft-365-outage/","BleepingComputer",{"_99":100,"_101":-5},"changelogVersion","2026-10-01T08:00","release"]
