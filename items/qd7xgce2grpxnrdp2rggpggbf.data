[{"_1":2,"_3":4},"root",{"_5":87},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1794530490000,"id","qd7xgce2grpxnrdp2rggpggbf","title","Europol 联合九国查封 Gootloader、CastleRAT 和 StealC 基础设施，收回逾 600 万组被盗凭据","originalTitle","Operation Endgame malware takedown turns up over 6 million stolen logins","summary","Europol 联合九国警方本周查封 Gootloader、CastleRAT 和 StealC 恶意软件运营背后的 235 台服务器和 257 个域名，并收回感染计算机上盗取的 600 多万组凭据，缴获的凭据此前被出售并用于进一步攻击和勒索。","reason","此次行动同时给出被查恶意软件的分工、缴获规模与凭据流向，并明确受影响者可借助通知服务和账户加固措施处置风险。","source",{"_67":86},"links",{"_78":85},"publishedAt","2026-11-12T13:34:14.000Z","discoveredAt","2026-11-12T14:16:22.337Z","timelineAt","category","activity","tags",[70,68,82,83,84],"score",78,"selected",true,"channel","news","story","x","readingMode","full","author","Mirko Zorz","body",{"_59":77,"_78":-5,"_79":80,"_81":37},"outline",[],"relatedStories",[],"topics",[60,61,62,63,64],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_65":75,"_67":76},{"_65":73,"_67":74},{"_65":71,"_67":72},{"_65":69,"_67":70},{"_65":66,"_67":68},"slug","malware","name","恶意软件","attack","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","identity","身份与访问","<p>本周，九个国家的警方与欧洲刑警组织（Europol）合作，摧毁了 Gootloader、CastleRAT 和 StealC 恶意软件行动背后的服务器，并追回了从受感染计算机窃取的 600 多万组凭据。欧洲刑警组织宣布此次行动是“终局行动”（Operation Endgame）的最新一轮行动，该国际行动旨在打击为勒索软件团伙提供入侵网络途径的服务。</p><p><img src=\"/dailyinfo/media/deeccfa0b61008a1.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Operation Endgame malware takedown\" title=\"Gootloader\"></p><p>这些登录凭据会被用于攻击普通用户和企业。嫌疑人出售从受害者机器上收集的凭据，买家则利用这些凭据发动进一步攻击，其中包括勒索软件攻击。与 CastleRAT 相关的受害者数据将被发送给包括 Have I Been Pwned 在内的通知服务，因此密码被盗的个人和组织可能很快就会收到警报。</p><p>欧洲刑警组织和私营部门合作伙伴从犯罪分子手中接管了 235 台服务器和 257 个域名。Gootloader 失去 14 台服务器和 218 个域名，CastleRAT 失去 120 台服务器和 39 个域名，StealC 失去 102 台服务器。</p><p>Gootloader 是一种加载器，其作用是进入机器并下载其他恶意软件。其运营者在遭入侵的网站上植入虚假法律文件，这些网站往往是遭到黑客攻击的 WordPress 网站，而下载这些文件的访客会遭到感染。这些感染最终引发勒索软件和敲诈行为。除服务器和域名外，另有 681 个受感染网站得到清理。</p><p>CastleRAT 是一种远程访问木马程序，可让攻击者远程控制受感染的计算机。该恶意软件自 2025 年以来已为人所知，欧洲刑警组织称其在设计时便难以被检测。欧洲刑警组织将其与数据加密、IT 系统瘫痪，以及企业和其他组织被迫支付赎金等情况联系起来。</p><p>StealC 是一种信息窃取器，也能将其他恶意软件投放到机器上。它从受感染计算机中窃取密码、保存的登录凭据和数字身份，以便出售并用于欺诈。本周针对其 102 台服务器的行动，延续了始于 2026 年 6 月的 StealC 打击工作。</p><p>欧洲刑警组织敦促 WordPress 用户更改其凭据、启用多因素身份验证并修补漏洞。</p>","original","zhKind","translation","complete","凭据","数据窃取","勒索","https://www.helpnetsecurity.com/2026/11/12/europol-operation-endgame-malware-takedown/","Help Net Security",{"_88":89,"_90":-5},"changelogVersion","2026-10-01T08:00","release"]
