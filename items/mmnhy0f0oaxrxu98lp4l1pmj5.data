[{"_1":2,"_3":4},"root",{"_5":111},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1793665812000,"id","mmnhy0f0oaxrxu98lp4l1pmj5","title","Traefik 远程拒绝服务漏洞影响 2.x 与 3.x 旧版本","originalTitle","Vulnérabilité dans Traefik (02 novembre 2026)","summary","Traefik 存在可导致远程拒绝服务（DoS）的漏洞，影响 2.x 版本中低于 2.11.61 的版本，以及 3.x 版本中低于 3.7.17 的版本。CERT-FR 于 02 novembre 2026 首次发布公告，未提及认证要求或已确认的利用活动；修复信息见 Traefik 安全公告 GHSA-xv5x-242w-7hf7。","reason","source",{"_69":110},"links",{"_60":109},"publishedAt","2026-11-02T00:00:00.000Z","discoveredAt","2026-11-02T15:43:33.982Z","timelineAt","category","vuln","tags",[106,107,108],"score",44,"selected",false,"channel","news","story",{"_72":73,"_13":74},"x","readingMode","full","author","body",{"_102":-5,"_60":103,"_104":-5,"_105":36},"outline",[75,76,77,78,79,80,81,82],"relatedStories",[71],"topics",[67],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fMSGeoeE2FW0","reportCount",1,"additionalSourceCount",0,{"_68":30,"_69":70},"slug","name","漏洞披露",{"_72":73,"_13":74},"publicId","df34923e-db45-4b98-b1a9-db3562f7107d","Traefik远程拒绝服务漏洞披露",{"_11":100,"_84":101,"_86":87},{"_11":98,"_84":99,"_86":87},{"_11":96,"_84":97,"_86":87},{"_11":94,"_84":95,"_86":87},{"_11":92,"_84":93,"_86":87},{"_11":90,"_84":91,"_86":87},{"_11":88,"_84":89,"_86":87},{"_11":83,"_84":85,"_86":87},"sec-8","text","Gestion détaillée du document","level",2,"sec-7","Documentation","sec-6","Solutions","sec-5","Résumé","sec-4","Systèmes affectés","sec-3","Risque","sec-2","Gestion du document","sec-1","Avis du CERT-FR","zh","<h2 id=\"sec-1\">Avis du CERT-FR</h2><p>Objet : Vulnérabilité dans Traefik</p><h2 id=\"sec-2\">Gestion du document</h2><table>\n      <tbody>\n        <tr>\n          <th>Référence</th>\n          <td>CERTFR-2026-AVI-1439</td>\n        </tr>\n        <tr>\n          <th>Titre</th>\n          <td>Vulnérabilité dans Traefik</td>\n        </tr><tr>\n            <th>Date de la première version</th><td>02 novembre 2026</td>\n          </tr>\n          <tr>\n            <th>Date de la dernière version</th><td>02 novembre 2026</td>\n          </tr><tr>\n          <th>Source(s)</th>\n          <td>Bulletin de sécurité Traefik GHSA-xv5x-242w-7hf7 du 02 novembre 2026<br></td>\n        </tr>\n      </tbody>\n    </table><p>Une gestion de version détaillée se trouve à la fin de ce document.</p><h2 id=\"sec-3\">Risque</h2><ul>\n          \n            <li>Déni de service à distance</li>\n          \n        </ul><h2 id=\"sec-4\">Systèmes affectés</h2><ul>\n          \n            <li>traefik versions 2.x antérieures à 2.11.61</li>\n          \n            <li>traefik versions 3.x antérieures à 3.7.17</li>\n          \n        </ul><h2 id=\"sec-5\">Résumé</h2><p>Une vulnérabilité a été découverte dans Traefik. Elle permet à un attaquant de provoquer un déni de service à distance.</p><h2 id=\"sec-6\">Solutions</h2><p>Se référer au bulletin de sécurité de l'éditeur pour l'obtention des correctifs (cf. section Documentation).</p><h2 id=\"sec-7\">Documentation</h2><ul>\n          \n          \n            <li>\n              <p>Bulletin de sécurité Traefik GHSA-xv5x-242w-7hf7 du 02 novembre 2026</p>\n              <a href=\"https://github.com/traefik/traefik/security/advisories/GHSA-xv5x-242w-7hf7\">https://github.com/traefik/traefik/security/advisories/GHSA-xv5x-242w-7hf7</a>\n            </li>\n          \n\n          \n          \n\n          \n        </ul><h2 id=\"sec-8\">Gestion détaillée du document</h2><table>\n          <thead>\n            <tr>\n              <th>Date</th>\n              <th>Description</th>\n            </tr>\n          </thead>\n          <tbody><tr>\n              <td>02 novembre 2026</td>\n              <td>Version initiale</td>\n            </tr></tbody>\n        </table>","zhKind","complete","漏洞","补丁","网络设备","https://www.cert.cyber.gouv.fr/avis/CERTFR-2026-AVI-1439/","CERT-FR",{"_112":113,"_114":-5},"changelogVersion","2026-10-01T08:00","release"]
