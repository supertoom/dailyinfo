[{"_1":2,"_3":4},"root",{"_5":100},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1794444102000,"id","z7r3ob6z5zlzhu12s71ktd4th","title","Chrome XML 双重释放漏洞 CVE-2026-125350 已被在野利用","originalTitle","【漏洞通告】Chrome XML 释放重用远程代码执行漏洞(CVE-2026-125350)","summary","Google Chrome 内置 libxslt 的 XSLT 处理链路存在双重释放（UAF）漏洞 CVE-2026-125350，CVSS 3.1 为 8.8，已被在野利用。","reason","文章复现了 Chrome 双重释放漏洞，并给出受影响版本、补丁和临时规避方法，可用于评估浏览器升级需求。","source",{"_75":99},"links",{"_89":98},"publishedAt","2026-11-10T09:51:00.000Z","discoveredAt","2026-11-10T17:51:38.334Z","timelineAt","category","vuln","tags",[92,78,93,94,95,81,96,97],"score",89,"selected",true,"channel","news","story",{"_85":86,"_13":87},"x","readingMode","full","author","body",{"_61":88,"_89":-5,"_90":89,"_91":37},"outline",[],"relatedStories",[84],"topics",[68,69,70,71,72],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fzcFu-wC7B_s","reportCount",3,"additionalSourceCount",2,{"_73":82,"_75":83},{"_73":80,"_75":81},{"_73":31,"_75":79},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","research","name","技术研究","exploited","在野利用","漏洞披露","browser","浏览器","google","Google / 谷歌",{"_85":86,"_13":87},"publicId","c3937e7e-f288-4355-b614-3e8068418e29","Chrome XML释放后重用零日漏洞已修复","<p><span>深瞳漏洞实验室</span> <span>2026-11-10 17:51</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/cfaa6ce3b41510ed.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>2026年11月10日，深瞳漏洞实验室监测到一则Google Chrome组件存在代码执行漏洞的信息，漏洞编号：CVE-2026-125350，漏洞威胁等级：高危。</p><p><img src=\"/dailyinfo/media/f01549ff7513d75e.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span><span>漏洞名称：</span></span></strong></p><p><span>Chrome XML 释放重用远程代码执行漏洞(CVE-2026-125350)</span></p><p><strong><span><span>组件名称：</span></span></strong></p><p><span>Google Chrome</span></p><p><span><strong><span>影响范围：</span></strong></span></p><p><span>Google Chrome(Windows) &lt; 157.0.8103.50/.51</span><span><br></span><span>Google Chrome(Mac) &lt; 157.0.8103.50/.51</span><span><br></span><span>Google Chrome(Linux) &lt; 157.0.8103.50</span></p><p><strong><span><span>漏洞类型：</span></span></strong></p><p><span>代码执行</span></p><p><span><strong><span>利用条件：</span></strong></span></p><p><span>1、用户认证：否</span></p><p><span>2、前置条件：默认配置</span></p><p><span>3、触发方式：远程</span></p><p><strong><span><span>综合评价：</span></span></strong></p><p><span>利用难度：容易，无需授权即可远程代码执行。</span></p><p><span>威胁等级：高危，能造成远程代码执行。</span></p><p><strong><span><span>官方解决方案：</span></span></strong></p><p><span>已发布</span></p><p><strong><span>漏洞分析</span></strong></p><p><img src=\"/dailyinfo/media/a27e273fa92b1526.webp\" loading=\"lazy\" decoding=\"async\"></p><p><b><span>组件介绍</span></b></p><p><span>Google Chrome 是 Google 公司基于 Chromium 开源项目开发的跨平台网页浏览器，其渲染进程运行在沙箱隔离环境中。为支持 XML 文档的样式转换，Chrome 内置了 libxslt 库，在渲染进程内解析并执行网页引用的 XSLT 样式表：页面加载含 XSLT 的 XML 文档时，样式表中的匹配模式会经由 xsltTestCompMatchDirect 等接口进行 XPath 求值，xsl:number 等元素的处理依赖其内部的模式缓存机制。本次漏洞正是出在这条内置于浏览器的 XSLT 处理链路上，远程网页内容可直接触达相关缓存逻辑。</span></p><p><img src=\"/dailyinfo/media/af61eb29c52d8f4b.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>漏洞简介</span></strong></p><p><span>2026年11月10日，深瞳漏洞实验室监测到一则Google Chrome组件存在代码执行漏洞的信息，漏洞编号：CVE-2026-125350，漏洞威胁等级：高危。</span></p><p><span>近日，Google 发布安全公告，修复了 Chrome 浏览器中一个已被在野利用的远程代码执行漏洞（CVE-2026-125350，CVSS 3.1：8.8）。该漏洞存在于 Chrome 内置的 libxslt 库：xsltTestCompMatchDirect 在对匹配模式做 XPath 整体求值前，将缓存于 ctxt-&gt;extras 的节点集指针读入局部变量；求值期间，谓词引用的全局变量被惰性求值，其内容中的 xsl:number 重入同一缓存槽并释放缓存对象；求值返回后，外层再次释放该失效指针，构成双重释放（UAF）。</span><strong><span><span>攻击者只需诱导目标访问包含恶意 XSLT 的网页，即可在渲染进程内实现任意代码执行。</span></span></strong></p><p><img src=\"/dailyinfo/media/befe75b9b0cdf984.webp\" loading=\"lazy\" decoding=\"async\"></p><p><b><span>漏洞验证</span></b></p><p><span>使用受影响版本Chrome访问本地搭建的 PoC 页面，页面包含利用 xsl:number 模式缓存的恶意 XSLT），浏览器渲染进程崩溃，成功复现该漏洞。</span></p><p><img src=\"/dailyinfo/media/c9d573b4dbfafe2c.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>影响范围</span></strong></p><p><span>目前受影响的Google Chrome 版本：</span></p><p><span>Google Chrome(Windows) &lt; 157.0.8103.50/.51</span><span><br></span><span>Google Chrome(Mac) &lt; 157.0.8103.50/.51</span><span><br></span><span>Google Chrome(Linux) &lt; 157.0.8103.50</span></p><p><strong><span>解决方案</span></strong></p><p><img src=\"/dailyinfo/media/5ab5193c9081a1cd.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>官方修复建议</span></strong></p><p><span>官方已发布修复补丁，受影响范围内可升级至修复版本</span><span><br></span><span>Google Chrome(Windows) &gt;= 157.0.8103.50/.51</span><span><br></span><span>Google Chrome(Mac) &gt;= 157.0.8103.50/.51</span><span><br></span><span>Google Chrome(Linux) &gt;= 157.0.8103.50</span><span><br></span><span>下载地址：<a href=\"https://www.google.cn/chrome/\">https://www.google.cn/chrome/</a></span></p><p><img src=\"/dailyinfo/media/30feac9030936682.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span><span>临时修复建议</span></span></strong></p><ul><li><p><span>在完成升级前，避免使用 Chrome 浏览器访问不受信任的网页及包含 XSLT 样式表的 XML 文档，防范在野利用。</span></p></li></ul><ul><li><p><span>关注官方后续安全公告，及时获取相关缓解与加固信息。</span></p></li></ul><p><img src=\"/dailyinfo/media/60745f01d4ba1117.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>深信服解决方案</span></strong></p><p><strong><span><span>风险资产发现</span></span></strong></p><p><span>支持对该漏洞的端侧资产识别，</span><strong><span><span>可批量检出业务场景中受影响的资产情况，</span></span></strong><span>相关产品如下：</span></p><p><strong><span><span>【深信服统一端点安全管理系统aES】</span></span></strong><span>&nbsp;已发布资产检测方案，指纹ID:0000398。</span></p><p><b><span>参考链接</span></b></p><p><span><a href=\"https://chromereleases.googleblog.com/2026/11/stable-channel-update-for-desktop_018223192.html\">https://chromereleases.googleblog.com/2026/11/stable-channel-update-for-desktop_018223192.html</a></span></p><p><b><span>时间轴</span></b></p><p><strong><span>2026/11/10</span></strong></p><p><span>深瞳漏洞实验室监测到Chrome XML 释放重用远程代码执行漏洞信息。</span></p><p><strong><span>2026/11/10</span></strong></p><p><span>深瞳漏洞实验室发布漏洞通告。</span></p><p><span>点击</span><strong><span><span>阅读原文</span></span></strong><span>，及时关注并登录深信服</span><strong><span>智安全平台</span></strong><span>，可轻松查询漏洞相关解决方案。</span></p><p><img src=\"/dailyinfo/media/073c19395657e75e.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img src=\"/dailyinfo/media/578a53ca86e2a82c.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><a href=\"https://sec.sangfor.com.cn/security-vulnerability/detail?vuln_sfv=SF_2026_46128%5cx26amp;lang=ZH-CN\">阅读原文</a></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=dd81f1bb&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzg2NjgzNjA5NQ%3D%3D%26mid%3D2247526403%26idx%3D1%26sn%3D74b3e772b8c4fb242da449db13683206\">跳转微信打开</a></p>","original","zhKind","complete","漏洞","补丁","复现","漏洞分析","Google","深信服","https://mp.weixin.qq.com/s?__biz=Mzg2NjgzNjA5NQ==&mid=2247526403&idx=1&sn=74b3e772b8c4fb242da449db13683206","深信服千里目安全实验室",{"_101":102,"_103":-5},"changelogVersion","2026-10-01T08:00","release"]
