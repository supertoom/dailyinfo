[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795394440000,"id","smbzmnzpvjtu63os8rqrsoxu8","title","FBI 调查 NCIC 全国刑事司法数据库疑似遭入侵事件","originalTitle","FBI Investigating Apparent Hack of Its Key National Criminal Justice Database, AP Source Says","summary","FBI 正调查其维护的 National Crime Information Center（NCIC）数据库疑似遭黑客入侵，该数据库向地方、州和联邦执法机构开放，保存逃犯、失踪人口、犯罪记录和被盗财物等信息。","reason","source",{"_71":84},"links",{"_61":83},"publishedAt","2026-11-22T00:53:02.000Z","discoveredAt","2026-11-22T01:42:45.599Z","timelineAt","category","activity","tags",[72,81,82],"score",65,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","Associated Press","body",{"_77":-5,"_61":78,"_79":-5,"_80":36},"outline",[],"relatedStories",[73],"topics",[68],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fg8GkuTAZF8M","reportCount",2,"additionalSourceCount",1,{"_69":70,"_71":72},"slug","attack","name","攻击活动",{"_74":75,"_13":76},"publicId","610251db-932a-4927-8cc3-ae706bee1e61","FBI调查NCIC数据库疑似遭入侵","zh","<p><strong>The FBI is investigating an apparent hack of a national law enforcement database that it maintains, a person familiar with the matter said Saturday.</strong>\n\n\n\n</p><p>The National Crime Information Center, known as the NCIC, is a computerized database of criminal justice information that is available to local, state and federal law enforcement agencies and includes records on fugitives, missing persons, criminal history data, stolen property and other topics.\n\n\n\n</p><p>The FBI declined to comment Saturday on the apparent hack, which was first reported by CNN and confirmed to The Associated Press by a person familiar with the matter who was not authorized to speak by name and spoke on the condition of anonymity.\n\n\n\n</p><p>The scope of the problem was not immediately clear.\n\n\n\n</p><p>Asked about the subject on Saturday, President Donald Trump said in a Fox News Channel interview: “We just heard about it, and I will say that it’s not good.”\n\n\n\n</p><p>News that the NCIC was targeted comes as the country has encountered a series of digital outages in the government and private sector that Trump administration officials have said were caused by routine efforts to upgrade computer systems and fix vulnerabilities, rather than a cyberattack. There was no immediate indication that the FBI incident was related to those outages.</p><p><span>Advertisement. Scroll to continue reading.</span></p><p>The bureau has historically been a frequent target for hackers.\n\n\n\n</p><p>In September, for instance, a criminal hacking group known as ShinyHunters revealed that it had <a href=\"https://www.securityweek.com/shinyhunters-claims-fbi-hack-demands-retraction-of-threat-report/\">obtained a massive trove</a> of data on FBI employees and applicants and had compromised the bureau’s jobs portal.\n\n\n\n</p><p>And in March, the FBI disclosed that it was investigating “suspicious activities” on an internal system that contains sensitive information related to surveillance operations and investigations.\n\n\n\n</p><p><strong>Related</strong>: <a href=\"https://www.securityweek.com/ransomware-response-expert-arrested-in-shinyhunters-fbi-hack-probe/\">Ransomware Response Expert Arrested in ShinyHunters FBI Hack Probe</a>\n\n\n\n</p><p><strong>Related</strong>: <a href=\"https://www.securityweek.com/shinyhunters-claims-fbi-hack-demands-retraction-of-threat-report/\">ShinyHunters Claims FBI Hack, Demands Retraction of Threat Report</a>\n      </p>","zhKind","complete","数据泄露","网络设备","https://www.securityweek.com/fbi-investigating-apparent-hack-of-its-key-national-criminal-justice-database-ap-source-says/","SecurityWeek",{"_86":87,"_88":-5},"changelogVersion","2026-10-01T08:00","release"]
