[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795653641000,"id","lyf96vda5zff8pbjkukxgohx6","title","Bulgaria 发现持续五年的政府网络间谍活动，130 GB 文件被窃取","originalTitle","Bulgaria Discovers Massive Government Breach After Five Years of Undetected Spying","summary","Bulgaria 发现自 2021 年起持续五年的网络间谍活动，多个国际黑客组织从政府数据库下载超过 130 GB、约 6200 万页文档，涉及内阁文件、报告及部委和机构间通信。调查人员尚未确定攻击者或国家级关联，也未确认数据是否被利用；目前没有证据表明公民个人数据受影响。事件于 2026 年 8 月由新国家网络安全监测系统发现异常活动后曝光，相关部门已隔离受影响系统、阻断访问并清除恶意软件。","reason","事件暴露了政府网络长期缺少安全监测的问题，130 GB 文档外泄规模可作为改进持续监测与事件响应的参考。","source",{"_75":103},"links",{"_96":102},"publishedAt","2026-11-23T09:46:56.000Z","discoveredAt","2026-11-23T10:31:40.647Z","timelineAt","category","activity","tags",[76,100,78,101,80],"score",70,"selected",true,"channel","news","story",{"_86":87,"_13":88},"x","readingMode","full","author","Pierluigi Paganini","body",{"_61":95,"_96":-5,"_97":98,"_99":37},"outline",[89],"relatedStories",[85],"topics",[68,69,70,71,72],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fMPrcDKQKSrA","reportCount",1,"additionalSourceCount",0,{"_73":83,"_75":84},{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","attack","name","攻击活动","exploited","在野利用","incident","应急响应","black-market","数据窃取与黑产","ransomware","勒索软件",{"_86":87,"_13":88},"publicId","4a68897f-9255-453e-ad3a-720c71186403","保加利亚政府网络被入侵五个月余数据，攻击者未查明",{"_11":90,"_91":92,"_93":94},"sec-1","text","保加利亚揭露了一场持续五年的网络间谍活动，窃取了 130GB 的政府文件。攻击者身份和全部影响尚不清楚。","level",2,"<h2 id=\"sec-1\">保加利亚揭露了一场持续五年的网络间谍活动，窃取了 130GB 的政府文件。攻击者身份和全部影响尚不清楚。</h2><p>保加利亚创新与数字转型部宣布，其发现了一起自 2021 年以来持续进行的黑客行动。Reuters 报道称，在这五年间，超过 130 GB 的文件、约 6200 万页文档从政府数据库中被下载。部长 Ivan Vassilev 表示，目前没有证据表明保加利亚公民的个人数据遭到泄露。</p><p><em>“部长 Ivan Vassilev 表示，自 2021 年以来，超过 130 GB、也就是 6200 万页的文件被下载，但目前没有证据表明保加利亚人的个人数据遭到泄露，Nova TV 在其网站上报道。”<a href=\"https://www.reuters.com/legal/litigation/bulgaria-uncovers-five-year-cyberespionage-operation-2026-11-18/\">Reuters 报道称</a>。</em></p><p>这起泄露事件是在保加利亚引入新的国家网络安全监控系统后才曝光的，该系统于 8 月发现了可疑活动。在此之前，该国显然没有一套能够侦测自 2021 年以来持续进行的入侵活动的系统。这不仅引发了有关攻击者能力的问题，也暴露了政府网络内部缺乏安全监控的问题。</p><p>多个国际黑客组织可能参与了此次攻击，但调查人员尚未将其与任何特定国家或国家行为体联系起来。据报道，被窃取的文件包括内阁文件、报告，以及各部委和政府机构之间的通信。</p><p><em>“我们发现，自 2021 年起，有多个国际黑客组织访问了保加利亚的系统，”Vassilev 表示。“他们窃取的信息包括保加利亚国家机构如何运作的敏感细节”</em></p><p><em>“现阶段，没有证据表明保加利亚公民的个人数据受到影响。”部长补充道。</em></p><p>攻击被发现后，多个机构参与了应对工作，包括情报部门、国防部、警方、网络安全专家，以及欧盟网络安全机构等国际合作伙伴。有关部门已隔离受影响的系统、阻止攻击者访问并清除恶意软件，检方也已获知此事。Vassilev 希望检方不仅调查黑客，还要调查政府机构是否未能更早发现此次入侵。</p><p>政府也面临一些需要回答的问题。在攻击者潜伏于其系统内的这五年间，保加利亚经历了数届不稳定的政府和多次重复选举。这种政治不稳定可能影响了政府对网络安全的长期投入。一场从 2021 年到 2026 年都未引起注意的攻击，不仅引发了有关攻击者技术能力的问题，也凸显了安全监控薄弱如何使他们长期藏匿。</p><p>这并非保加利亚第一次遭遇重大数据泄露，而两者的对比值得注意。2019 年，<a href=\"https://securityaffairs.com/88477/data-breach/bulgarians-data-leak.html\">黑客</a>从国家税务局窃取了约 11 GB 数据，暴露了近五百万公民的个人信息，当时约占全国人口的 71%；在一名 20 岁当地嫌疑人被捕前，外界曾提出此事与俄罗斯有关。这一次的目标是机构间的通信往来，而非公民记录；被窃取的文档规模为 130 GB，而此前案件为 11 GB，前者远超过后者。</p><p>周三公告中几乎缺少所有能让公众判断实际损害程度的信息：是谁干的、具体有哪些文件被窃取，以及其中任何内容是否已经被使用。保加利亚自己的网络安全机构 BTA <a href=\"https://www.bta.bg/en/news/bulgaria/1180195-government-uncovers-apparent-years-long-breach-of-administrative-networks\">将此次发现描述为</a>“政府发现行政网络疑似遭持续多年的入侵”，这一措辞表明调查仍远未结案。</p><p><strong>在 Twitter 上关注我：&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;以及&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;和&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a><strong></strong></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;黑客、&nbsp;保加利亚）</strong></p>","original","zhKind","translation","complete","数据泄露","数据窃取","https://securityaffairs.com/203794/intelligence/bulgaria-discovers-massive-government-breach-after-five-years-of-undetected-spying.html","Security Affairs",{"_105":106,"_107":-5},"changelogVersion","2026-10-01T08:00","release"]
