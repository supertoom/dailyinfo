[{"_1":2,"_3":4},"root",{"_5":115},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795567280000,"id","he0bob19pbje3opocivfw0w0a","title","Java4Shell 漏洞 CVE-2026-114938 已出现利用尝试，多家厂商确认产品受影响","originalTitle","Java4Shell Exploitation Attempts Begin as Vendors Rush Out Advisories","summary","攻击者已开始针对 Java4Shell 漏洞 CVE-2026-114938 开展扫描和利用尝试。该漏洞影响支持 AVX-512 VBMI 的 x86-64 OpenJDK 17.0.6 及更高版本，可导致内存破坏；Calif 称默认配置下可在 Jira、Confluence、Jenkins、Keycloak 等产品实现未认证 RCE，但各产品需要定制利用链。","reason","多家威胁情报机构已观测到 Java4Shell 扫描与利用尝试，文中同时梳理了不同产品的利用前提、确认影响范围和补丁状态。","source",{"_75":114},"links",{"_98":113},"publishedAt","2026-11-19T09:10:58.000Z","discoveredAt","2026-11-19T09:35:04.163Z","timelineAt","category","vuln","tags",[102,76,103,104,105,106,107,108,109,110,111,112],"score",83,"selected",true,"channel","news","story",{"_85":86,"_13":87},"x","readingMode","full","author","Eduard Kovacs","body",{"_61":97,"_98":-5,"_99":100,"_101":37},"outline",[88,89],"relatedStories",[84],"topics",[68,69,70,71,72],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fnutD3PpNl_4","reportCount",1,"additionalSourceCount",0,{"_73":82,"_75":83},{"_73":80,"_75":81},{"_73":78,"_75":79},{"_73":31,"_75":77},{"_73":74,"_75":76},"slug","exploited","name","在野利用","漏洞披露","ai-agent","AI Agent 安全","supply-chain","供应链安全","oracle","Oracle / 甲骨文",{"_85":86,"_13":87},"publicId","8540cb70-bd3c-4700-8134-83f02bb49280","Java4Shell出现利用尝试，Metabase确认受影响",{"_11":95,"_91":96,"_93":94},{"_11":90,"_91":92,"_93":94},"sec-2","text","厂商确认影响，但修复仍在推出","level",2,"sec-1","攻击者正在探测存在漏洞的系统","<p><strong>随着更多厂商发布公告，详细说明该漏洞对其产品的影响，威胁行为者已开始针对最近披露的 Java4Shell 漏洞开展活动。</strong>\n\n\n\n</p><p>该漏洞追踪编号为 CVE-2026-114938，<a href=\"https://www.securityweek.com/java4shell-vulnerability-puts-many-enterprise-applications-at-risk-of-takeover/\">Java4Shell</a> 是 OpenJDK 17.0.6 及更高版本在处理 Base64 数据时存在的一个内存损坏漏洞。利用该漏洞需要配备支持 AVX-512 VBMI 的 x86-64 处理器，这项功能存在于较新的 Intel 和 AMD CPU 中。基于 ARM 的系统不受影响。 \n\n\n\n</p><p>Calif 于 11 月 17 日披露了该漏洞，同日 Oracle 和 OpenJDK 项目发布了补丁。\n\n\n\n</p><p>Calif 表示，利用该漏洞可在 Jira、Confluence、Jenkins、Keycloak 和其他企业应用的默认配置下实现未授权远程代码执行（RCE）。不过，其指出，并不存在适用于所有这些产品的单一漏洞利用方案，每个产品都需要量身定制的攻击链。\n\n\n\n</p><h2 id=\"sec-1\">攻击者正在探测存在漏洞的系统</h2><p>截至 11 月 19 日初，威胁情报公司 GreyNoise 已<a href=\"https://java4shell.events.greynoise.io/\">记录</a>到来自 5 个 IP 地址的 150 多次请求，其形式与 Java4Shell 攻击相符。该公司尚未发现其传感器上有任何成功入侵。\n\n\n\n</p><p>WatchTowr 也观察到了相关活动。WatchTowr 威胁情报主管 Jake Knott 表示：“我们已经看到攻击者扫描互联网，使用带有‘java4shell-recon’ User-Agent 的请求攻击我们的全球蜜罐网络，同时还使用格式正确的请求进行盲利用尝试。”</p><p><span>广告。滚动以继续阅读。</span></p><p>Knott 补充道：“虽然我们目前观察到的情况尚不特别有效或令人担忧，但它已经发出了明确信号，表明攻击者想要利用这个漏洞。未来几天，我们预计攻击者会逐一针对不同产品进行迭代，以完善并构建更可靠、针对特定目标的漏洞利用方案，而真正的利用活动也将从那时开始出现。”\n\n\n\n</p><p>Cloudflare 的 Cloudforce One 团队注意到，扫描该漏洞的攻击者开始<a href=\"https://x.com/Cloudforce_One/status/2123175079513338095\">隐藏其使用的工具</a>。在一次事件中，一个 IP 地址使用明确提及 Java4Shell 的 User-Agent 探测目标，随后在大约 17 小时后携带漏洞利用触发器返回，同时伪装成 Chrome 浏览器。\n\n\n\n</p><p>11 月 18 日，Cloudforce One 还<a href=\"https://x.com/Cloudforce_One/status/2123098021596725484\">发现</a>一个 IP 地址首次同时被用于 Artex 和 Java4Shell 活动。<a href=\"https://www.securityweek.com/barracuda-hacked-amid-surge-in-artex-powered-cyberattacks/\">Artex</a> 是一个开源 AI 渗透测试框架，威胁行为者一直在滥用它来自动化入侵。\n\n\n\n</p><p>威胁情报公司 Previdian 表示，其传感器在 11 月 18 日和 19 日记录到来自 6 个 IP 地址的 9 次<a href=\"https://previdian.com/CVE-2026-114938\">漏洞利用尝试</a>。不过，其警告称，其传感器数据无法确认任何目标是否已遭入侵。\n\n\n\n</p><p>Cisco 的产品安全团队表示，已知晓存在概念验证（PoC）漏洞利用代码，但不了解有任何恶意使用。&nbsp;\n\n\n\n</p><p>Calif 发布的 PoC 只能触发内存损坏。与此同时，VulnCheck 已向其客户提供完整的 RCE 漏洞利用程序，Immersive 的 Kevin Breen 也报告称已<a href=\"https://x.com/KevTheHermit/status/2122829165925998824\">开发出可正常利用的漏洞利用程序</a>。\n\n\n\n</p><h2 id=\"sec-2\">厂商确认影响，但修复仍在推出</h2><p>迄今为止，<a href=\"https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-nov2026-java-rce-eCa6ss9z\">Cisco</a> 已确认其十余款产品受到影响，包括 Catalyst Center、Secure Network Analytics、Secure Workload、Smart Software Manager On-Prem、Splunk AppDynamics On-Premises Virtual Appliance 和 Intersight Virtual Appliance。\n\n\n\n</p><p>这家网络巨头尚未发布修复补丁，并表示没有可用的规避方案。它仍在调查 IOS XE 和 UCS Central 是否受到影响。\n\n\n\n</p><p><a href=\"https://cert-portal.siemens.com/productcert/html/ssa-272816.html\">Siemens</a> 表示其三款 Industrial Edge Management 产品受到影响。该公司正在开发补丁，同时建议在此期间将这些实例下线。\n\n\n\n</p><p>据 <a href=\"https://www.elastic.co/blog/java4shell-remote-code-execution-rce-vulnerability\">Elastic</a> 表示，从 7.17.3 起的每个 Elasticsearch 版本都受到影响。攻击者需要具有读权限或更高权限的有效凭据才能实现 RCE，但无需身份验证即可触发拒绝服务（DoS）状态。\n\n\n</p><p>Logstash 8.6.2 及更高版本同样受到影响，尽管利用需要特定配置且只能导致崩溃。Elastic 计划在即将发布的版本中解决该问题。\n\n\n</p><p>该公司已为 Elastic Cloud Serverless 部署了热修复，并为 Elastic Cloud Hosted 做了配置变更。它表示只有一小部分 Elastic Cloud Hosted 部署运行在存在漏洞的 CPU 上。\n\n\n\n</p><p><a href=\"https://access.redhat.com/security/vulnerabilities/RHSB-2026-018\">Red Hat</a> 将该问题评为严重，称 RHEL 8、9 和 10 受到影响，其自行构建的 OpenJDK 17、21 和 25 也受到影响。\n\n\n\n</p><p>“不需要任何特殊配置或非默认功能。只要 JVM 运行在报告支持 AVX-512 VBMI 的 CPU 上，就会自动选择加速代码路径，因此受影响的系统开箱即处于易受攻击状态，”Red Hat 表示，并指出补丁正在加急处理。\n\n\n\n</p><p><a href=\"https://www.keycloak.org/2026/11/java4shell-vulnerability-cve-2026-114938\">Keycloak</a> 团队警告称，其 26.8.2-1 和 26.8.2-2 容器镜像捆绑了存在漏洞的 OpenJDK 21 构建。11 月 19 日，该团队宣布推出包含已修复 Java 运行时的更新镜像，其中包括 26.8.2-3 版本。\n\n\n\n</p><p><a href=\"https://community.atlassian.com/forums/discussion/3317765/data-center-mitigations-for-cve-2026-114938\">Atlassian</a> 表示正在努力解决其云产品中的这一问题，云客户无需采取任何行动。对于其 Data Center 产品，在补丁发布之前，Atlassian 建议在标准安装中禁用 AVX-512 支持，作为 Bamboo、Bitbucket、Confluence、Crowd、Jira 和 Jira Service Management Data Center 最新版本的临时规避方案。\n\n\n\n</p><p><a href=\"https://www.jenkins.io/blog/2026/11/18/mitigating-java4shell/\">Jenkins</a> 项目表示，仅当控制器在支持 AVX-512 VBMI 的 CPU 上运行存在漏洞的 Java 17、21 或 25 版本时才存在风险。它建议用户更新到 11 月发布的 Java 版本并重启 Jenkins。也有可用的规避方案。\n\n\n\n</p><p>在 Java 发行商中，<a href=\"https://explore.alas.aws.amazon.com/CVE-2026-114938.html\">Amazon</a>、<a href=\"https://learn.microsoft.com/en-us/java/openjdk/release-notes\">Microsoft</a> 和 <a href=\"https://www.azul.com/blog/java4shell-cve-2026-114938-what-it-is-who-is-affected-and-what-to-do-now/\">Azul</a> 已发布其 OpenJDK 发行版的修复构建。\n\n\n\n</p><p><strong>相关</strong>：<a href=\"https://www.securityweek.com/php-readies-critical-security-updates-to-patch-another-rce-flaw/\">PHP 准备关键安全更新以修补另一个 RCE 缺陷</a>\n\n\n\n</p><p><strong>相关</strong>：<a href=\"https://www.securityweek.com/optimizely-vulnerability-exploited-to-serve-malware-on-major-websites/\">Optimizely 漏洞被利用，在多个大型网站上投放恶意软件</a>\n\n\n\n</p><p><strong>相关</strong>：<a href=\"https://www.securityweek.com/microsoft-agent-framework-releases-poisoned-with-credential-stealer/\">Microsoft Agent Framework 发布版本被投毒，植入凭据窃取程序</a>\n\n\n\n</p>","original","zhKind","translation","complete","漏洞","补丁","漏洞利用","供应链","大模型","Oracle","Red Hat","Cisco","Atlassian","Microsoft","AWS","https://www.securityweek.com/java4shell-exploitation-attempts-begin-as-vendors-rush-out-advisories/","SecurityWeek",{"_116":117,"_118":-5},"changelogVersion","2026-10-01T08:00","release"]
