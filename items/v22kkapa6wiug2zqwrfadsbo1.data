[{"_1":2,"_3":4},"root",{"_5":147},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795740049000,"id","v22kkapa6wiug2zqwrfadsbo1","title","NGINX HTTP/2 释放后重用漏洞 CVE-2026-123633 分析与复现","originalTitle","NGINX HTTP/2 Use-After-Free: CVE-2026-123633","summary","Unit 42 分析并复现了 NGINX HTTP/2 释放后重用漏洞 CVE-2026-123633。该问题影响 1.19.7 至 1.30.6 和 1.31.0 至 1.31.8，未认证攻击者在连接额度紧张并使用分片请求和请求时 DNS 解析时可能触发拒绝服务，F5 评分 CVSS 4.0 9.2、CVSS 3.1 8.1；禁用或绕过 ASLR 时可能实现代码执行。","reason","文章完整还原了连接状态缺陷触发释放后重用内存的路径，并用 ASan 测试验证，适合研究人员理解利用前提与防护边界。","source",{"_72":146},"links",{"_133":145},"publishedAt","2026-11-24T23:00:14.000Z","discoveredAt","2026-11-24T23:07:33.411Z","timelineAt","category","disclosure","tags",[73,138,139,140,141,142,143,144],"score",84,"selected",true,"channel","news","story",{"_77":78,"_13":79},"x","readingMode","full","author","Bon Berry","body",{"_61":132,"_133":-5,"_134":135,"_136":137},"outline",[80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95],"relatedStories",[76],"topics",[68,69],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fNT_rkA5syas","reportCount",1,"additionalSourceCount",0,{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","research","name","技术研究","vuln","漏洞披露",{"_77":78,"_13":79},"publicId","f84d0570-2d79-461f-aab5-909994879dbf","NGINX HTTP/2释放后重用漏洞公开分析",{"_11":130,"_97":131,"_99":100},{"_11":128,"_97":129,"_99":100},{"_11":126,"_97":127,"_99":100},{"_11":124,"_97":125,"_99":100},{"_11":122,"_97":123,"_99":100},{"_11":120,"_97":121,"_99":119},{"_11":117,"_97":118,"_99":119},{"_11":115,"_97":116,"_99":100},{"_11":113,"_97":114,"_99":100},{"_11":111,"_97":112,"_99":100},{"_11":109,"_97":110,"_99":100},{"_11":107,"_97":108,"_99":100},{"_11":105,"_97":106,"_99":100},{"_11":103,"_97":104,"_99":100},{"_11":101,"_97":102,"_99":100},{"_11":96,"_97":98,"_99":100},"sec-16","text","其他资源","level",2,"sec-15","失陷指标","sec-14","披露时间线","sec-13","Palo Alto Networks 防护与缓解","sec-12","结论","sec-11","缓解措施","sec-10","暴露情况审查","sec-9","检测与搜寻","sec-8","Two-VM Demonstration","sec-7","Limits",3,"sec-6","Tested Conditions","sec-5","Test Setup and Limits","sec-4","触发 Resolver 释放后重用","sec-3","连接状态缺陷的工作原理","sec-2","背景","sec-1","执行摘要","<h2 id=\"sec-1\">执行摘要</h2><p><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-123633\">CVE-2026-123633</a> 是 NGINX HTTP/2 中的一个<a href=\"https://cwe.mitre.org/data/definitions/416.html\">释放后重用</a>漏洞，可能允许未经身份验证的攻击者造成拒绝服务。在该 CVE 记录中，F5 表示，当地址空间布局随机化（ASLR）被禁用或绕过时，可能实现代码执行。</p><p>CVE-2026-123633 会影响接受 HTTP/2 客户端连接、将请求代理到后端且可用工作进程连接数较低的 NGINX 服务器。分片请求可能使一个活跃连接仍被标记为可重用。在连接压力下，NGINX 可能关闭该连接，并释放活跃请求仍在使用的内存。</p><p>F5 的 CVE 记录依据 CVSS 4.0 将该问题评为 9.2 严重。<a href=\"https://nginx.org/en/security_advisories.html\">NGINX 安全公告页面</a>将该问题标为中等，并列出 1.19.7 至 1.30.6 以及 1.31.0 至 1.31.8 版本受到影响。F5 在报告者名单中列出了<a href=\"https://github.com/memn0ps\">memN0ps</a>（Palo Alto Networks Unit 42）。</p><p>稳定分支中的 NGINX 1.30.7 和主线分支中的 1.31.9 包含此修复。F5 <a href=\"https://my.f5.com/manage/s/article/K000163928\">还列出了受影响的 NGINX Plus 版本</a>。</p><p>管理员应审查 HTTP/2 反向代理暴露情况，并升级到已修复的 NGINX 版本或包含 CVE-2026-123633 修复的供应商软件包。</p><p>Palo Alto Networks 客户可通过以下产品和服务获得更好的保护，以应对上述威胁：</p><ul>\n<li><a href=\"https://docs-cortex.paloaltonetworks.com/p/XDR\">Cortex XDR</a> 和 <a href=\"https://docs-cortex.paloaltonetworks.com/p/XSIAM\">XSIAM</a></li>\n<li><a href=\"https://www.koi.ai/product/endpoint\">Cortex Agentic Endpoint Security</a></li>\n</ul><p>组织可通过<a href=\"https://www.paloaltonetworks.com/unit42/threat-intelligence\"> Unit 42 Threat Intel Services</a>及其<a href=\"https://www.paloaltonetworks.com/resources/datasheets/unit-42-deep-and-dark-web-service\"> Deep and Dark Web Service</a>获取定制的对手情报、分析师直接咨询以及专门的暴露面追踪。</p><p>如果您认为自己可能已遭入侵，或有紧急事项，请联系<a href=\"https://start.paloaltonetworks.com/contact-unit42.html\">Unit 42 事件响应团队</a>。</p><h2 id=\"sec-2\">背景</h2><p>在研究 NGINX 时，我独立发现了现已登记为 CVE-2026-123633 的 HTTP/2 连接状态缺陷。</p><p>未经身份验证的客户端可以发送分片的 HTTP/2 请求，使一个活跃连接仍被标记为可重用。当服务器在请求期间解析主机名且可用连接槽位较少时，NGINX 可能在请求进行中回收该连接，并释放其 DNS 解析器仍在使用的内存。</p><p>我在未经修改的 NGINX 1.31.7 和 1.31.8 源代码构建版本上，使用<a href=\"https://clang.llvm.org/docs/AddressSanitizer.html\">AddressSanitizer (ASan)</a>复现了释放后重用问题。NGINX <a href=\"https://nginx.org/en/security_advisories.html\">安全公告页面</a>列出 1.19.7 至 1.30.6 以及 1.31.0 至 1.31.8 版本受到影响，并将 1.30.7 和 1.31.9 列为已修复版本。</p><p>我私下向 F5 报告了这个 HTTP/2 释放后重用问题。F5 的 CVE 记录依据 CVSS 4.0 将其评为 9.2 严重，依据 CVSS 3.1 将其评为 8.1 高危。NGINX 安全公告页面将其标为中等。</p><p>在 Debian 客户机上的 ASan 测试中，ASan 在首次读取已释放的 DNS 查询内存时停止了 NGINX。</p><p>测试中的解析器路径源自登记为 CVE-2026-123633 的 HTTP/2 连接漏洞。<a href=\"https://nvd.nist.gov/vuln/detail/cve-2026-123634\">CVE-2026-123634</a>是另一个 DNS 解析器漏洞，已在同一版本中修复。</p><p>我还发现了一个会泄露 libc 指针的内存泄露漏洞。我利用该地址计算 libc 基址，并在将泄露问题与 CVE-2026-123633 串联时绕过 ASLR。我将这个额外漏洞作为单独问题报告给了 F5。从攻击者虚拟机出发，我成功在目标虚拟机上以非 root NGINX 工作进程身份实现了预身份验证远程代码执行。该利用链需要使用非默认的 NGINX 配置，且部分尝试未能打开 shell。</p><p>F5 将该内存泄露评估为仅出现在非典型配置下的行为，并且截至撰写时未为其分配 CVE，因此我略去相关细节和利用步骤。</p><h2 id=\"sec-3\">连接状态缺陷的工作原理</h2><p>当 NGINX 可以在压力下关闭某个连接时，会将其标记为可复用。一旦请求开始，流的创建应当清除可复用标记，但在受影响的版本中，<span><a href=\"https://github.com/nginx/nginx/blob/140aa942711868a8daeb95810bc9a81f272ada72/src/http/v2/ngx_http_v2.c#L3063-L3200\">ngx_http_v2_create_stream()</a></span> 会让该标记保持设置状态。</p><p>当客户端仅发送部分 HTTP/2 HEADERS 帧头时，<span><a href=\"https://github.com/nginx/nginx/blob/140aa942711868a8daeb95810bc9a81f272ada72/src/http/v2/ngx_http_v2.c#L621-L697\">ngx_http_v2_handle_connection()</a> </span> 会将连接标记为可复用并提前返回。下面的代码展示了这一判断：</p><table>\n\t\t\t\t\t<tbody><tr>\n\t\t\t\t<td>\n\t\t\t\t\t<p>1</p><p>2</p><p>3</p><p>4</p><p>5</p>\n\t\t\t\t</td>\n\t\t\t\t\t\t<td><p><span>ngx_reusable_connection</span><span>(</span><span>c</span><span>,</span><span> </span><span>1</span><span>)</span><span>;</span></p><p><span>if</span><span> </span><span>(</span><span>h2c</span>-<span>&gt;</span><span>state</span><span>.</span><span>incomplete</span><span>)</span><span> </span><span>{</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;</span><span>return</span><span>;</span></p><p><span>}</span></p></td>\n\t\t\t\t\t</tr>\n\t\t\t\t</tbody></table><p>可复用标记使 NGINX 能够回收因部分帧而停滞的连接，避免它们耗尽 worker 的槽位。</p><p>随后客户端发送剩余的帧头字节。<span>ngx_http_v2_create_stream()</span> 创建一个活动流并递增活动流计数器，但返回时该可复用标记仍处于设置状态：</p><table>\n\t\t\t\t\t<tbody><tr>\n\t\t\t\t<td>\n\t\t\t\t\t<p>1</p><p>2</p><p>3</p><p>4</p><p>5</p><p>6</p><p>7</p>\n\t\t\t\t</td>\n\t\t\t\t\t\t<td><p><span>h2c</span>-<span>&gt;</span><span>processing</span>++<span>;</span></p><p><span>if</span><span> </span><span>(</span><span>h2c</span>-<span>&gt;</span><span>connection</span>-<span>&gt;</span><span>read</span>-<span>&gt;</span><span>timer_set</span><span>)</span><span> </span><span>{</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;</span><span>ngx_del_timer</span><span>(</span><span>h2c</span>-<span>&gt;</span><span>connection</span>-<span>&gt;</span><span>read</span><span>)</span><span>;</span></p><p><span>}</span></p><p><span>return</span><span> </span><span>stream</span><span>;</span></p></td>\n\t\t\t\t\t</tr>\n\t\t\t\t</tbody></table><p>现在，NGINX 在一个连接上拥有活动请求，但其清理逻辑仍将该连接视为可复用。</p><p>1.30.7 和 1.31.9 中的修复会在创建流时通过 <span>ngx_reusable_connection(h2c-&gt;connection, 0)</span> 清除可复用标记。图 1 展示了受影响版本中的执行顺序：</p><ul>\n<li>部分帧头会将连接标记为可复用</li>\n<li>NGINX 创建流时该标记仍处于设置状态</li>\n<li>后续进行套接字分配时会回收该活动连接</li>\n</ul><figure><img src=\"/dailyinfo/media/4f340c55ebacf6e8.webp\" srcset=\"/dailyinfo/media/ab6cd21e996de95b.webp 720w, /dailyinfo/media/a9e12f7c1ced47d2.webp 1200w, /dailyinfo/media/4f340c55ebacf6e8.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Diagram explaining HTTP/2 connection handling in NGINX. It shows how partial headers, additional frames, and DNS lookups relate to the connection's state. There's a description of reusable flags indicating when a connection is suitable for reuse, highlighting an issue with NGINX's handling of busy connections. Text boxes explain each part, with colored arrows showing flow between components.\" width=\"1000\" height=\"458\"><figcaption>图 1. 活动 HTTP/2 连接仍被标记为可复用。</figcaption></figure><h2 id=\"sec-4\">触发 Resolver 释放后重用</h2><p>过期的可复用标记使 NGINX 在需要空闲槽位时能够回收活动连接。在我的测试中，请求期间的 DNS 查询打开了一个新套接字并触发了回收。</p><p>我的测试使用了一条带有可变上游的 HTTP/2 代理路由。该变量求值得到一个主机名，它既不是字面量 IP 地址，也不是已配置的上游组，因此 NGINX 会在请求期间查询该主机名。该查询还必须打开一个新的 resolver UDP 套接字。</p><p>只有在 worker 没有针对所选名称服务器的套接字时，才会打开新的 UDP 套接字。已缓存的答复和正在进行的查询也会跳过我所测试的套接字分配回收过程。</p><p>打开 DNS 套接字需要一个连接槽位，因此 <span><a href=\"https://github.com/nginx/nginx/blob/140aa942711868a8daeb95810bc9a81f272ada72/src/core/ngx_connection.c#L1206-L1269\">ngx_get_connection()</a></span> 会先执行一次连接排空检查。当可用槽位降至 <span>worker_connections</span> 的十六分之一或更低，且至少存在一个可复用连接时，<a href=\"https://github.com/nginx/nginx/blob/140aa942711868a8daeb95810bc9a81f272ada72/src/core/ngx_connection.c#L1404-L1458\"><span>ngx_drain_connections()</span></a> 就会执行一次。随后，该排空函数从可复用队列尾部选取条目，设置每个连接的关闭标志，并调用其读取处理程序：</p><table>\n\t\t\t\t\t<tbody><tr>\n\t\t\t\t<td>\n\t\t\t\t\t<p>1</p><p>2</p>\n\t\t\t\t</td>\n\t\t\t\t\t\t<td><p><span>c</span>-<span>&gt;</span><span>close</span><span> </span>=<span> </span><span>1</span><span>;</span></p><p><span>c</span>-<span>&gt;</span><span>read</span>-<span>&gt;</span><span>handler</span><span>(</span><span>c</span>-<span>&gt;</span><span>read</span><span>)</span><span>;</span></p></td>\n\t\t\t\t\t</tr>\n\t\t\t\t</tbody></table><p>我的测试客户端在完成帧后以零 linger 关闭了套接字，使 NGINX 在已重置的连接上仍保留着一个活动请求。当连接压力触发排空时，HTTP/2 读取处理程序试图在该套接字上发送 GOAWAY。</p><p>写入成功本会使请求继续运行，但写入因 <span>Connection reset by peer</span> 而失败，因此 NGINX 结束了该连接和请求。ASan 的释放栈经过 <span><a href=\"https://github.com/nginx/nginx/blob/140aa942711868a8daeb95810bc9a81f272ada72/src/http/ngx_http_upstream.c#L1371-L1410\">ngx_http_upstream_check_broken_connection()</a></span>。</p><p>请求清理流程到达 <a href=\"https://github.com/nginx/nginx/blob/140aa942711868a8daeb95810bc9a81f272ada72/src/core/ngx_resolver.c#L514-L602\"><span>ngx_resolve_name_done()</span></a>，它会释放解析器状态，而原始查询仍持有指向该状态的指针。</p><p>在 <span><a href=\"https://github.com/nginx/nginx/blob/140aa942711868a8daeb95810bc9a81f272ada72/src/core/ngx_resolver.c#L874-L888\">ngx_resolve_name_locked()</a>,</span> 中，DNS 发送发生在超时设置之前。发送操作可能会排空连接并释放 <span>ctx</span>。发送返回后，超时设置会使用失效指针，如下方代码所示：</p><table>\n\t\t\t\t\t<tbody><tr>\n\t\t\t\t<td>\n\t\t\t\t\t<p>1</p><p>2</p><p>3</p><p>4</p><p>5</p><p>6</p><p>7</p><p>8</p><p>9</p><p>10</p><p>11</p><p>12</p><p>13</p><p>14</p><p>15</p>\n\t\t\t\t</td>\n\t\t\t\t\t\t<td><p><span>if</span><span> </span><span>(</span><span>ngx_resolver_send_query</span><span>(</span><span>r</span><span>,</span><span> </span><span>rn</span><span>)</span><span> </span><span>!</span><span>=</span><span> </span><span>NGX_OK</span><span>)</span><span> </span><span>{</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;</span><span>/* 失败后立即重试一次 */</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;</span><span>rn</span>-<span>&gt;</span><span>last_connection</span>++<span>;</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;</span><span>if</span><span> </span><span>(</span><span>rn</span>-<span>&gt;</span><span>last_connection</span><span> </span><span>==</span><span> </span><span>r</span>-<span>&gt;</span><span>connections</span><span>.</span><span>nelts</span><span>)</span><span> </span><span>{</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span>rn</span>-<span>&gt;</span><span>last_connection</span><span> </span><span>=</span><span> </span><span>0</span><span>;</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;</span><span>}</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;</span><span>(</span><span>void</span><span>)</span><span> </span><span>ngx_resolver_send_query</span><span>(</span><span>r</span><span>,</span><span> </span><span>rn</span><span>)</span><span>;</span></p><p><span>}</span></p><p><span>if</span><span> </span><span>(</span><span>ngx_resolver_set_timeout</span><span>(</span><span>r</span><span>,</span><span> </span><span>ctx</span><span>)</span><span> </span><span>!=</span><span> </span><span>NGX_OK</span><span>)</span><span> </span><span>{</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;</span><span>goto</span><span> </span><span>failed</span><span>;</span></p><p><span>}</span></p></td>\n\t\t\t\t\t</tr>\n\t\t\t\t</tbody></table><p>如果排空操作释放了 <span>ctx,</span>，那么 <span><a href=\"https://github.com/nginx/nginx/blob/140aa942711868a8daeb95810bc9a81f272ada72/src/core/ngx_resolver.c#L4072-L4093\">ngx_resolver_set_timeout()</a></span> 会从中读取数据：</p><table>\n\t\t\t\t\t<tbody><tr>\n\t\t\t\t<td>\n\t\t\t\t\t<p>1</p><p>2</p><p>3</p>\n\t\t\t\t</td>\n\t\t\t\t\t\t<td><p><span>if</span><span> </span><span>(</span><span>ctx</span>-<span>&gt;</span><span>event</span><span> </span><span>|</span><span>|</span><span> </span><span>ctx</span>-<span>&gt;</span><span>timeout</span><span> </span>==<span> </span><span>0</span><span>)</span><span> </span><span>{</span></p><p><span>&nbsp;&nbsp;&nbsp;&nbsp;</span><span>return</span><span> </span><span>NGX_OK</span><span>;</span></p><p><span>}</span></p></td>\n\t\t\t\t\t</tr>\n\t\t\t\t</tbody></table><p>ASan reported that NGINX read memory from a freed DNS lookup context. The free path ran through <span>ngx_drain_connections()</span>, <span><a href=\"https://github.com/nginx/nginx/blob/140aa942711868a8daeb95810bc9a81f272ada72/src/http/v2/ngx_http_v2.c#L4955-L5040\">ngx_http_v2_finalize_connection()</a>, <a href=\"https://github.com/nginx/nginx/blob/140aa942711868a8daeb95810bc9a81f272ada72/src/http/ngx_http_upstream.c#L4784-L4955\">ngx_http_upstream_finalize_request()</a></span> and <span>ngx_resolve_name_done()</span>. Source review showed that, if execution continues past the reported read, <span>ngx_resolver_set_timeout()</span> can also write <span>ctx-&gt;event</span> and <span>ctx-&gt;ident</span> through that stale pointer.</p><p>In the run where ASan reported the read, I split the 9-byte HEADERS frame header after 5 bytes. For the control, I sent the full frame header first and then the HPACK block. NGINX sent a DNS query and kept running. Figure 2 follows the calls from socket allocation to the use-after-free.</p><figure><img src=\"/dailyinfo/media/a36514634ebbb1f4.webp\" srcset=\"/dailyinfo/media/ac57ee0f2789726b.webp 720w, /dailyinfo/media/d9f2474677f51add.webp 1200w, /dailyinfo/media/a36514634ebbb1f4.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Flowchart illustrating a call stack from NGINX 1.3.18, highlighting function interactions.\" width=\"1000\" height=\"673\"><figcaption>Figure 2. Nested function calls and the associated use-after-free event.</figcaption></figure><h2 id=\"sec-5\">Test Setup and Limits</h2><p>I ran the ASan test in an isolated Debian 13 guest. NGINX was built from official 1.31.7 and 1.31.8 source with Clang 19.1.7, HTTP/2, ASan and UndefinedBehaviorSanitizer. I sent the HTTP/2 requests over the guest's loopback interface.</p><p>For the 1.31.8 run, I set <span>worker_connections</span> to 16 and opened 13 filler connections that NGINX had not marked reusable. Table 1 shows the sanitizer results alongside the released-source review.</p><table>\n<tbody>\n<tr>\n<td><b>Test</b></td>\n<td><b>Builds</b></td>\n<td><b>Result</b></td>\n</tr>\n<tr>\n<td><span>ASan</span></td>\n<td><span>1.31.7, 1.31.8 (tested before the HTTP/2 fix)</span></td>\n<td><span>Read from freed resolver state during request-time DNS setup</span></td>\n</tr>\n<tr>\n<td><span>Source review</span></td>\n<td><span>Released NGINX 1.30.7 and 1.31.9 source</span></td>\n<td><span>Clears the reusable mark when NGINX creates an HTTP/2 stream</span></td>\n</tr>\n</tbody>\n</table><p><span>Table 1. HTTP/2 use-after-free tests and source review.</span></p><h3 id=\"sec-6\">Tested Conditions</h3><p>Table 2 lists the conditions I used in the 1.31.8 ASan test.</p><table>\n<tbody>\n<tr>\n<td><b>Tested Path</b></td>\n<td><b>Key Conditions</b></td>\n</tr>\n<tr>\n<td><span>Resolver socket</span></td>\n<td><span>Split HEADERS frame header, </span><span>worker_connections</span><span> set to 16, 13 filler connections, a variable upstream hostname, a new resolver UDP socket and an abortive client close</span></td>\n</tr>\n</tbody>\n</table><p><span>Table 2. Conditions used in the 1.31.8 ASan test.</span></p><h3 id=\"sec-7\">Limits</h3><p>A source build includes the HTTP/2 module only when configured with <span>--with-http_v2_module</span>. Distribution packages commonly enable it.</p><p>The ASan evidence in this article comes from builds of 1.31.7 and 1.31.8 over loopback. The 1.31.8 test configuration set <span>worker_connections</span> to 16 instead of the <a href=\"https://nginx.org/en/docs/ngx_core_module.html#worker_connections\">documented default of 512</a>, and ran NGINX with <span>master_process</span> off. The sanitizer aborted that single process. The <a href=\"https://github.com/nginx/nginx/commit/2df48a501d0fb8212b7d39dffeeff5876332ba59\">public fix commit</a> also names upstream connection setup as a drain trigger.</p><h2 id=\"sec-8\">Two-VM Demonstration</h2><p>The two-VM demonstration combined CVE-2026-123633 with the separate memory disclosure mentioned in the Background section. The target ran NGINX 1.31.8 with a root master and a <span>www-data</span> worker under a non-default configuration. Figure 3 records the running processes, version, loaded configuration path and listener.</p><figure><img src=\"/dailyinfo/media/38df11650b5d7619.webp\" srcset=\"/dailyinfo/media/7f66a3425ba561a6.webp 720w, /dailyinfo/media/9f0545f82b7731b6.webp 1200w, /dailyinfo/media/38df11650b5d7619.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Screenshot of a terminal displaying a Linux shell session. Commands and outputs related to nginx, such as configuration file paths and process IDs, are shown. IP addresses and numerical data are included in the network setup and status information.\" width=\"1000\" height=\"550\"><figcaption>Figure 3. NGINX target before the shell demonstration.</figcaption></figure><p>攻击者 VM 的第一次尝试恢复了一个 libc 地址，但未打开 shell；第二次则以 <span>www-data</span> 身份打开了交互式 shell。该 shell 的主机名、IP 地址和 boot ID 与目标截图一致。图 4 预览了随附的录制视频，其中展示了同一会话，并加快了等待时段。</p><figure><img src=\"/dailyinfo/media/7fadadfa39247b6e.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Screenshot of a command-line interface showing a network and server setup, including NGINX processes, IP addresses, and system information. Various commands are executed, displaying network details and process trees.\" width=\"700\" height=\"613\"><figcaption>图 4. 攻击者 VM 会话以及目标上的 <span>www-data</span> shell。</figcaption></figure><p>视频 1 展示了该会话：</p><p><span>视频 1. 演示攻击者 VM 会话以及在目标上打开的交互式 shell。</span></p><h2 id=\"sec-9\">检测与搜寻</h2><p>在 ASan 测试中，NGINX 在 sanitizer 中止进程之前记录了一条连接耗尽警告。该警告也可能在普通连接压力下出现，而 worker 退出可能有无关原因。发布版本在读取已释放内存后仍可能继续运行。表 3 列出了针对 HTTP/2 反向代理的调查线索。</p><table>\n<tbody>\n<tr>\n<td><b>信号</b></td>\n<td><b>我在测试中观察到的现象</b></td>\n<td><b>检查项</b></td>\n</tr>\n<tr>\n<td><span>NGINX 进程意外退出</span></td>\n<td><span>NGINX 读取已释放内存后，ASan 中止了单进程 NGINX 测试。</span></td>\n<td><span>调查生产环境中在 HTTP/2 请求和连接压力附近出现的 worker 意外退出。仅有 worker 退出这一现象，是被利用的弱证据。</span></td>\n</tr>\n<tr>\n<td><span>请求时进行 DNS 解析所导致的连接压力</span></td>\n<td><span>在 ASan 测试期间，NGINX 以 warn 级别记录了 \"16 </span><span>worker_connections</span><span> are not enough, reusing connections\"。</span></td>\n<td><span>将该警告与解析器流量以及在请求时进行解析的路由上的连接压力进行关联。该警告和 DNS 流量也可能在普通负载下出现。</span></td>\n</tr>\n</tbody>\n</table><p><span>表 3. 用于检测和搜寻的信号。</span></p><p>表 3 中的警告按每个 worker 每秒最多记录一次，因此一行日志可能涵盖多次耗尽调用。由于 NGINX 默认使用 error 日志级别（该级别省略警告），请将 <span>error_log</span> 配置为 warn 级别（或能够捕获更多细节的级别，如 notice 或 info），然后将警告与流量和 worker 状态进行关联。</p><h2 id=\"sec-10\">暴露情况审查</h2><p><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-123633\">CVE-2026-123633</a> 描述了 HTTP/2 反向代理中的一种释放后使用漏洞，这些代理的 worker 连接数不足。我复现的路径使用了一个变量 <span>proxy_pass</span> 主机名、一个已配置的 resolver 以及一个新的 UDP socket。F5 的 CVE 描述涵盖了范围更广的 HTTP/2 反向代理。</p><p>检查正在运行的配置。master 进程可以通过 -c 选择其他文件，因此不要想当然地认为打包路径就是实际使用的路径。命令 <span>nginx -T</span> 会打印磁盘上的配置，但该配置仍可能与运行中的 worker 所加载的配置不同。</p><p>我只测试了 <span>proxy_pass</span>。运维人员还应审查以下指令中的变量目标：</p><ul>\n<li><span>grpc_pass</span></li>\n<li><span>fastcgi_pass</span></li>\n<li><span>uwsgi_pass</span></li>\n<li><span>scgi_pass</span></li>\n</ul><p>对于匹配的路由，检查正在运行的构建版本，以及 worker 接近其连接限制的程度。我测试了一条 DNS socket 路由，但上游连接建立也会通过 <span>ngx_get_connection(),</span> 分配资源，因此静态上游路由仍需审查。</p><h2 id=\"sec-11\">缓解措施</h2><p>NGINX 1.30.7 和 1.31.9 修复了 HTTP/2 问题。CVE-2026-123633 记录中未列出任何变通方案。如果必须等待升级，以下更改可能降低暴露风险：</p><ul>\n<li>在服务允许的情况下，在暴露的监听器上禁用 HTTP/2。检查每个相关的 listen ... http2 参数；对于 NGINX 1.25.1 或更高版本，还要检查 http 或 server 上下文中的任何 http2 on; 设置。这两个设置中的任何一个都可能导致 HTTP/2 保持启用。禁用 HTTP/2 可能会破坏 gRPC 客户端，并且如果其他流量回退到 HTTP/1.1，可能会增加连接使用量。如果其他监听器上的 HTTP/2 仍保持启用，额外的 HTTP/1.1 连接可能会使同一个 worker 更接近其 worker_connections 限制。</li>\n<li>提高 <span>worker_connections</span> 可以在相同流量下为 worker 提供更多余量，但攻击者仍可能耗尽新增的连接槽位，而且连接状态缺陷仍然存在。</li>\n</ul><p>部署前测试每一项更改。升级后，确认正在运行的 worker 所使用的二进制文件包含 CVE-2026-123633 修复。重新加载配置（<span>nginx -s reload</span>）会让旧的二进制文件继续在内存中运行，因此应执行完全重启或实时二进制文件升级。</p><h2 id=\"sec-12\">结论</h2><p>该缺陷始于 HTTP/2 连接在请求开始后仍被标记为可复用。在我的测试中，在连接压力下打开 DNS socket 会耗尽该活动连接，并释放请求仍在使用的解析器状态。ASan 报告 NGINX 在内存释放后仍对其进行读取。</p><p>防御人员应确定受影响的 HTTP/2 反向代理，留意连接压力下 worker 的退出情况，并安装已修复的 NGINX 版本或供应商回移补丁。我的解析器测试展示了触发释放后使用的一种方法。F5 的说明更广泛地涵盖了 HTTP/2 反向代理。</p><h2 id=\"sec-13\">Palo Alto Networks 防护与缓解</h2><p>Palo Alto Networks 客户可以通过以下产品更好地防护上述威胁：</p><ul>\n<li><a href=\"https://docs-cortex.paloaltonetworks.com/p/XDR\">Cortex XDR</a> 和 <a href=\"https://docs-cortex.paloaltonetworks.com/p/XSIAM\">XSIAM</a> 旨在通过利用行为威胁防护、由机器学习驱动的本地分析以及基于云端的恶意软件检查，检测并阻止后利用活动（包括服务器和进程利用），从而防止已知和未知威胁的执行。</li>\n<li><a href=\"https://www.koi.ai/product/endpoint\">Cortex Agentic Endpoint Security</a> 旨在帮助发现智能体端点上的所有 AI 工件和 AI 智能体活动，评估其风险，执行预防和运行时控制，并修复违规行为。</li>\n</ul><p>组织可以通过<a href=\"https://www.paloaltonetworks.com/unit42/threat-intelligence\"> Unit 42 Threat Intel Services</a> 及其<a href=\"https://www.paloaltonetworks.com/resources/datasheets/unit-42-deep-and-dark-web-service\"> Deep and Dark Web Service</a> 获取定制的对手情报、分析师直接咨询以及专门的暴露面跟踪服务。</p><p>如果您认为可能已遭入侵，或有紧急事项，请联系 <a href=\"https://start.paloaltonetworks.com/contact-unit42.html\">Unit 42 Incident Response 团队</a> 或致电：</p><ul>\n<li>北美：免费电话：+1 (866) 486-4842 (866.4.UNIT42)</li>\n<li>英国：+44.20.3743.3660</li>\n<li>欧洲和中东：+31.20.299.3130</li>\n<li>亚洲：+65.6983.8730</li>\n<li>日本：+81.50.1790.0200</li>\n<li>澳大利亚：+61.2.4062.7950</li>\n<li>印度：000 800 050 45107</li>\n<li>韩国：+82.080.467.8774</li>\n</ul><p>Palo Alto Networks 已将这些发现与我们的 Cyber Threat Alliance (CTA) 其他成员共享。CTA 成员利用这些情报快速为其客户部署防护措施，并系统性地挫败恶意网络行为者。详细了解 <a href=\"https://www.cyberthreatalliance.org/\">Cyber Threat Alliance</a>。</p><h2 id=\"sec-14\">披露时间线</h2><table>\n<tbody>\n<tr>\n<td><b>日期</b></td>\n<td><b>事件</b></td>\n</tr>\n<tr>\n<td><span>2026 年 10 月 16 日</span></td>\n<td><span>记录 HTTP/2 可复用连接缺陷</span></td>\n</tr>\n<tr>\n<td><span>2026 年 10 月 16 日</span></td>\n<td><span>使用 ASan 复现解析器释放后使用；先发送全部九个帧头字节后，NGINX 仍在运行</span></td>\n</tr>\n<tr>\n<td><span>2026 年 11 月 1 日</span></td>\n<td><span>通过其协调披露流程私下向 F5 报告的使用后释放漏洞</span></td>\n</tr>\n<tr>\n<td><span>2026 年 11 月 18 日</span></td>\n<td><span>NGINX 1.30.7 和 1.31.9 已发布，包含 HTTP/2 修复</span></td>\n</tr>\n<tr>\n<td><span>2026 年 11 月 18 日</span></td>\n<td><span>F5 发布了针对 HTTP/2 问题的 CVE-2026-123633</span></td>\n</tr>\n</tbody>\n</table><p>F5 在 CVE-2026-123633 记录中致谢了 memN0ps（Palo Alto Networks Unit 42）、Metnir（metnir.com）的 Albert Ebb、Wiz Research 的 Nir Ohfeld、Xint.io、Hrithik Ram（hmm_hmm）以及 Zenneth（randomguy6407）。时间线中的研究日期来自我的笔记；发布日期来自 NGINX 变更日志。</p><p><strong>F5 针对 CVE-2026-123633 的供应商影响声明：F5 表示，当连接槽位不足时，HTTP/2 使用后释放漏洞可能导致受影响的 NGINX 系统发生拒绝服务。F5 还表示，如果禁用或绕过 ASLR，可能存在代码执行风险。</strong><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-123633\"><strong>CVE-2026-123633 记录</strong></a><strong>包含完整的供应商说明。</strong></p><h2 id=\"sec-15\">失陷指标</h2><p><em>本研究未发现已确认的失陷指标。将以下项目视为调查 CVE-2026-123633 的线索，并结合运行中的构建版本和 HTTP/2 流量一并调查。 </em></p><ul>\n<li>调查疑似代码执行时，以 NGINX worker 账户运行的异常 shell 进程</li>\n<li>在 HTTP/2 流量和连接压力附近出现的 NGINX 进程异常终止</li>\n<li><span>包含“worker_connections are not enough, reusing connections”的连接耗尽警告；解读这些警告时，应检查正在运行的 worker_connections 值</span></li>\n</ul><h2 id=\"sec-16\">其他资源</h2><ul>\n<li><a href=\"https://nginx.org/en/security_advisories.html\">NGINX 安全公告</a></li>\n<li><a href=\"https://github.com/nginx/nginx/blob/master/SECURITY.md\">NGINX 安全策略</a>，其中会将报告转交给 F5</li>\n<li><a href=\"https://www.f5.com/services/support/report-a-vulnerability\">向 F5 报告漏洞</a></li>\n<li><a href=\"https://nginx.org/en/docs/http/ngx_http_proxy_module.html#proxy_pass\">proxy_pass 与请求时解析</a></li>\n<li><a href=\"https://nginx.org/en/docs/switches.html\">NGINX 命令行开关</a></li>\n<li><a href=\"https://my.f5.com/manage/s/article/K000163928\">F5 针对 CVE-2026-123633 的公告</a></li>\n</ul>","original","zhKind","translation","complete",false,"漏洞分析","复现","利用链","补丁","Palo Alto","Debian","NVD","https://unit42.paloaltonetworks.com/cve-2026-123633-nginx-http2-vulnerability/","Unit 42",{"_148":149,"_150":-5},"changelogVersion","2026-10-01T08:00","release"]
