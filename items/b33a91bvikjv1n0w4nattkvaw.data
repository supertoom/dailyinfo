[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795912834000,"id","b33a91bvikjv1n0w4nattkvaw","title","英国国家级排查制冷设备，数千台冰箱控制器紧急断网","originalTitle","国家级护网：英国全国排查冷藏系统，紧急断网数千台冰箱","summary","英国近期开展秘密网络安全行动，排查大型超市、仓库、餐厅、加油站和体育场馆的制冷设备，数千台用于控制制冷设备的控制器被撤出公共互联网，部分企业改用人工监测温度。","reason","材料梳理了欧洲多轮制冷设备攻击及英国国家级排查，可用于了解设备风险、响应范围与处置方式。","source",{"_75":96},"links",{"_90":95},"publishedAt","2026-11-25T10:20:47.235Z","discoveredAt","2026-11-25T11:20:47.250Z","timelineAt","category","activity","tags",[76,93,94,78,80],"score",74,"selected",true,"channel","news","story",{"_86":87,"_13":88},"x","readingMode","full","author","body",{"_61":89,"_90":-5,"_91":90,"_92":37},"outline",[],"relatedStories",[85],"topics",[68,69,70,71,72],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fJNTIJaYaclA","reportCount",1,"additionalSourceCount",0,{"_73":83,"_75":84},{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","attack","name","攻击活动","exploited","在野利用","incident","应急响应","iot","IoT 与车联网","supply-chain","供应链安全",{"_86":87,"_13":88},"publicId","597679fc-9d89-4d60-b596-26ce48edde9c","攻击者篡改欧洲制冷设备温度 英国紧急断网数千台控制器","<p>\n                    前不久接连曝出冷藏系统遭大规模网络攻击，致使超市零售食物损坏的公共安全事件，当时并非欧洲所有国家都受影响，最新披露显示，原来其他国家已经开展了国家级响应行动；英国NCSC及行业主管部门推动了此次国家级漏洞排查和修复行动，期间数千台制冷设备控制器被断开公网连接，多家大型超市紧急调派IT团队处理相关风险，有远程完成，有拔掉控制器网线，还有把宽带网线拔掉的；据悉，英国的制冷控制器也存在远程攻击漏洞，相关厂商已发布安全更新并陆续协调用户修复。\n                </p><p>前情回顾·冷藏系统遭网络攻击最新动态</p><ul><li><p><a href=\"https://www.secrss.com/articles/95386\">法国血液机构冷藏设施遭黑客网络攻击，零下30度被改为110度</a></p></li><li><p><a href=\"https://www.secrss.com/articles/95304\">冷藏系统再遭篡改变“烤箱”，上百家超市大量食品变质损坏</a></p></li><li><p><a href=\"https://www.secrss.com/articles/94660\">首次！数百个连锁超市冷藏系统被黑变“烤箱”，食品变质损坏 甚至引发火灾</a></p></li><li><p><a href=\"https://www.secrss.com/articles/93599\">关于美军基地小卖部们的冰柜集体罢工事件</a></p></li></ul><p>安全内参11月25日消息，据英国广播公司（BBC）报道，英国近期开展了一项秘密网络安全行动，对大型超市、仓库、餐厅、加油站和体育场馆内数万台冰箱及冷柜进行安全排查，以防黑客攻击。</p><p>近期，欧洲多地接连发生针对制冷设备的网络攻击，数百家商店因此遭受损失，大量食品变质，经济损失达数百万英镑。法国将其中一轮攻击归咎于伊朗，但遭到伊朗方面否认。</p><p>此前，由于英国制冷行业使用的设备与欧洲其他国家有所不同，外界普遍认为英国基本未受到此类攻击的影响。但实际上，英国制冷行业同样存在网络安全漏洞，相关企业一直在紧急修复。</p><p>10月下旬，安全研究人员发现了一处重大漏洞。这处漏洞一旦被黑客发现并利用，英国可能遭受更严重的损失。此后，研究人员、企业IT团队和英国国家网络安全中心昼夜不停地开展工作，向数十家企业发出风险警告。</p><p>为避免黑客获知漏洞并趁机发动攻击，BBC此前一直没有披露这项大规模秘密行动的详情。</p><p><strong>数千台冰箱因此被断网</strong></p><p>此次安全威胁最初由制冷咨询公司Omega Solutions的工作人员发现。随后，网络安全公司Pen Test Partners的专家对漏洞进行了验证和进一步分析，并协助向相关企业发出警报。</p><p>此后，英国国家网络安全中心（NCSC）、环境、食品与农村事务部（Defra）以及食品标准局（FSA）也参与了此次漏洞排查和修复行动。</p><p>相关部门通过行业电话会议协调工作，并组织团队联系存在风险的企业，推动其尽快采取防护措施。</p><p>行动期间，数千台用于控制制冷设备的控制器被从公共互联网上撤下。这些操作有的是远程完成的，有的是到现场拔掉设备网线实现的。部分企业要求员工直接拔除互联网网线，并改为人工监测设备温度。</p><p>BBC获悉，英国多家大型连锁超市不得不调派IT团队，集中处理相关安全风险。一家大型连锁超市的员工透露，该企业在一周内每天都有数百台设备被断开网络连接。</p><p>这名不愿公开身份的员工说：“当时确实感觉是在与时间赛跑，因为我们预计还会出现新一轮针对冰箱的网络攻击。从企业经营的角度来看，这次事件可能造成毁灭性后果，不仅会导致业务中断，还可能引发供应链问题。我们的仓库里存放着价值数百万英镑的食品，如果黑客掌握了这种攻击方法，这些食品都可能因制冷系统遭到破坏而变质。”</p><p><strong>英国制冷控制器也存在远程攻击漏洞</strong></p><p>今年以来，针对制冷设备温度控制器的网络攻击已发生三轮：</p><ul><li><p>8月：美国少数军事基地的冰箱受到攻击影响。</p></li><li><p>10月11日至12日：法国数百家超市和食品加工场所遭到攻击，目标是丹佛斯（Danfoss）温度控制系统。</p></li><li><p>11月1日至2日：欧洲七个国家的数十家超市遭到攻击，其中比利时和卢森堡受影响最严重。此外，法国少数献血站点也受到波及。</p></li></ul><p>接连发生的攻击促使Omega Solutions的一名专家对英国市场上最常见的制冷控制器展开安全检查。这类设备由英国企业Resource Data Management（RDM）生产。</p><p>据BBC了解，RDM对相关漏洞的严重程度持不同看法，但其应对安全问题的专业态度和处理措施得到了认可。</p><p>此次风险提示不仅针对超市，还涉及英国食品和饮料行业的多个领域，包括便利店、加油站、餐厅、快餐连锁店、体育场馆、酒店、食品加工厂和冷库等。</p><p><img src=\"/dailyinfo/media/9c013c9df04e1cd3.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>图：每台RDM控制器都可以远程调节数十台冰箱和冷柜的温度</p><p>Pen Test Partners的Ken Munro表示：“这些广泛使用的控制器存在密码设置过于简单的问题，与此前遭到成功攻击的丹佛斯及其他品牌控制器存在类似弱点。因此，我们必须尽快向相关企业传达风险信息，同时对外保密。如今，这些设备已经受到各方高度关注，犯罪分子或国家级黑客很可能只需几天时间就能发现这一问题。”</p><p>不过，RDM认为，将其产品与欧洲大陆遭攻击的设备相提并论并不公平，因为要入侵英国的冰箱和冷柜，攻击者必须先获得一件特定硬件设备。</p><p>对此，参与安全测试的道德黑客指出，这并非难事，因为相关硬件可以通过eBay等网络平台以较低价格购买。</p><p>RDM首席执行官Ged Evans表示：“此次漏洞是在测试环境中发现的。”</p><p>他指出，此次测试范围“超出了”常规安全测试，因为测试人员还“拆解了我们的硬件”。他还说：“无论如何，我们已经迅速采取行动处理这一问题，首批补丁版本也已发布。同时，我们一直主动与客户保持联系，提醒他们注意相关风险，并建议采取相应的防护措施。”</p><p>RDM确认，目前尚未发现这些控制器存在任何恶意活动的迹象。该公司将继续与英国国家网络安全中心及其他相关部门合作，密切监测事态发展。</p><p><em>参考资料：https://www.bbc.com/news/articles/c6eq49zyx7p4o</em></p><p>声明：本文来自安全内参，版权归作者所有。文章内容仅代表作者独立观点，不代表安全内参立场，转载目的在于传递更多信息。如有侵权，请联系 anquanneican@163.com。</p>","original","zhKind","complete","IoT","供应链","https://www.secrss.com/articles/96001","安全内参",{"_98":99,"_100":-5},"changelogVersion","2026-10-01T08:00","release"]
