[{"_1":2,"_3":4},"root",{"_5":94},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795394430000,"id","a7w3tajom8oplmgsmeq9ufff4","title","Apache Roller 未认证 RCE 漏洞 CVE-2026-129448 已被在野利用","originalTitle","Apache Roller RCE Flaw CVE-2026-129448 Under Active Attack","summary","Apache Roller 的未认证远程代码执行漏洞 CVE-2026-129448（CVSS 9.8）已被确认在野利用，影响 4.0.0 至 6.1.4 版本。","reason","Apache Roller 漏洞已被确认在野利用，且此前通告的受影响版本范围存在遗漏，管理员可据此排查暴露面并选择升级或临时缓解。","source",{"_72":93},"links",{"_86":92},"publishedAt","2026-11-18T20:11:35.000Z","discoveredAt","2026-11-18T20:47:39.904Z","timelineAt","category","vuln","tags",[90,73,91],"score",74,"selected",true,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","Pierluigi Paganini","body",{"_61":85,"_86":-5,"_87":88,"_89":37},"outline",[79],"relatedStories",[75],"topics",[68,69],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","feMmTIXkhTMg","reportCount",1,"additionalSourceCount",0,{"_70":31,"_72":74},{"_70":71,"_72":73},"slug","exploited","name","在野利用","漏洞披露",{"_76":77,"_13":78},"publicId","02b2ffb9-c7c0-4b25-b15d-bdc166d49214","Apache Roller RCE漏洞已遭在野利用",{"_11":80,"_81":82,"_83":84},"sec-1","text","攻击者正在利用 Apache Roller 的一个严重漏洞，该漏洞允许未经身份验证的远程代码执行，亟需进行安全更新。","level",2,"<h2 id=\"sec-1\">攻击者正在利用 Apache Roller 的一个严重漏洞，该漏洞允许未经身份验证的远程代码执行，亟需进行安全更新。</h2><p>Apache Roller 中一个被追踪为 <a href=\"https://www.cve.org/CVERecord?id=CVE-2026-129448\">CVE-2026-129448</a>（CVSS 评分为 9.8）的严重漏洞，可能允许未经身份验证的攻击者在易受攻击的服务器上执行任意代码。Apache Roller 是一个使用 Java 编写的开源博客平台。据 Apache Software Foundation（ASF）称，该漏洞正被 actively exploited in attacks in the wild。</p><p>该问题影响 Apache Roller 4.0.0 至 6.1.4 版本。它源于平台 XML-RPC 端点中的不安全反序列化，该端点会在检查请求者是否通过身份验证之前处理某些数据。攻击者无需有效凭据即可到达此易受攻击的代码路径。</p><p><em>“Apache Roller 4.0.0 至 6.1.4 版本中对不可信数据的反序列化，允许未经身份验证的远程攻击者执行任意代码。XML-RPC 端点接受供应商扩展类型，并在对请求者进行身份验证之前对其进行反序列化。”Apache 邮件列表发布的<a href=\"https://lists.apache.org/thread/lnz4s26tv6hdo03wngtdbpfj4hg4gtds\">安全公告</a>中写道。“这与 CVE-2026-82384 是同一个漏洞，而后者仅将 Apache Roller 6.1.5 列为受影响版本。”</em></p><p>Apache 项目在其<a href=\"https://lists.apache.org/thread/lnz4s26tv6hdo03wngtdbpfj4hg4gtds\">发布于 Apache 邮件列表的安全公告</a>中对该问题进行了说明：</p><p>维护人员解释道，XML-RPC 端点接受供应商扩展类型，并在对请求者进行身份验证之前对其进行反序列化。这种操作顺序是核心安全问题：应用会在确定请求是否可信之前处理攻击者控制的数据。</p><p>ASF 还确认，该漏洞与此前期追踪为 <a href=\"https://www.cve.org/CVERecord?id=CVE-2026-82384\">CVE-2026-82384</a> 的问题相同。那份发布于 2026 年 9 月的早期公告仅将 Apache Roller 6.1.5 列为受影响版本。新公告将受影响版本范围扩大至 4.0.0 至 6.1.4 的发行版本，因此管理员不应仅依赖早期公告所列的范围。</p><p>该项目已明确确认存在现实中的利用活动，尽管尚未披露有关攻击的技术细节、涉及的威胁行为者或被攻击的组织。</p><p><em>“该问题正被积极利用。</em>”公告中继续写道。</p><p>安全研究员 n0mi1k 因发现该漏洞而受到认可，Matt Raible 则向该项目报告了该漏洞。ASF 建议升级至 Apache Roller 6.1.6 或更高版本。该版本禁用了供应商扩展类型，并在禁用 XML-RPC 功能时拒绝 XML-RPC 请求。</p><p>无法立即安装更新的组织应采用项目提供的某种变通方案。他们可以在 <code>WEB-INF/web.xml</code> 中将 <code>enabledForExtensions</code> 设置为 <code>false</code>，或者移除 <code>/roller-services/xmlrpc</code> servlet 映射。无论采用哪种方式，管理员都必须重启 Apache Roller 才能使更改生效。</p><p>专家警告称，在较旧版本中，仅通过管理界面禁用 XML-RPC 并不能完全解决该问题。易受攻击的代码可以在检查该配置设置之前对请求进行反序列化，因此即使管理员认为已关闭该功能，应用仍会面临暴露风险。</p><p>已确认的利用活动使这不再只是一项常规补丁更新建议。运行 Apache Roller 的组织应找出每个受影响的实例，检查 XML-RPC 端点是否可访问，并优先进行升级或采用建议的临时缓解措施。面向互联网的系统应受到特别关注，但内部部署也不应被忽视：服务器无需公开可访问，攻击者一旦进入组织网络，就可能成为有价值的攻击目标。</p><p>ASF 还警告，仅通过管理界面禁用该功能无法保护较旧的安装版本：</p><p><em>“暂时无法升级的用户应在 WEB-INF/web.xml 中将“enabledForExtensions”设置为“false”，或移除“/roller-services/xmlrpc” servlet 映射，然后重启 Roller。”公告总结称。“仅在管理 UI 中禁用 XML-RPC 并不足够，因为较旧版本会先反序列化请求，然后才检查该设置。”</em></p><p><strong>在 Twitter 上关注我：&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;以及&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;以及&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a><strong></strong></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;黑客、&nbsp;Apache Roller)</strong></p>","original","zhKind","translation","complete","漏洞","补丁","https://securityaffairs.com/203419/security/apache-roller-rce-flaw-cve-2026-129448-under-active-attack.html","Security Affairs",{"_95":96,"_97":-5},"changelogVersion","2026-10-01T08:00","release"]
