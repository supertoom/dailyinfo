[{"_1":2,"_3":4},"root",{"_5":90},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1794703234000,"id","voiqcxe9tykq0yg7whylub8qc","title","UnrealIRCd CVE-2026-114713 已被利用，可注入服务器级命令","originalTitle","Attackers Exploit UnrealIRCd Flaw That Enables Server-Level Command Injection","summary","UnrealIRCd 的 CVE-2026-114713 已被用于在野利用，CISA 将其列入 KEV 目录。该漏洞 CVSS 8.6，影响 6.0.0 至 6.2.7.1 之前的版本，攻击者可利用未转义的 IRCv3 label 消息标签，在包含两个或更多互联服务器的网络中注入以服务器权限执行命令。","reason","source",{"_72":89},"links",{"_61":88},"publishedAt","2026-11-14T12:38:35.000Z","discoveredAt","2026-11-14T14:12:40.535Z","timelineAt","category","vuln","tags",[73,83,84,85,86,87],"score",53,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_79":-5,"_61":80,"_81":-5,"_82":36},"outline",[],"relatedStories",[75],"topics",[68,69],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","f9-0GujqdzzA","reportCount",1,"additionalSourceCount",0,{"_70":30,"_72":74},{"_70":71,"_72":73},"slug","exploited","name","在野利用","漏洞披露",{"_76":77,"_13":78},"publicId","8609cbbd-3e4c-4e4d-a868-e3a473bf189e","UnrealIRCd漏洞已遭在野利用","zh","<p><span><i></i><span>Ravie Lakshmanan</span><i></i><span>Nov 14, 2026</span></span><span>Vulnerability / Network Security</span></p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjuvSsWcsJ9736KXp_0s-6__-CiI5PD71VReembVHAB4cfnv3Qti8td9WR54UnRH96bz30dvbTQxwG3WbxDkWRq_eFJPYLgxbAzRD5k3MJSISbW2VDI-Fr7nlX4j8NyJkXqLHylMZMXpynEHVV8ovZ2YPC-WGCFCcrOZOeGc5Wsy-jRjjbcyYTzojI9Nudw/s1600/cisaa.jpg\"><img alt=\"\" src=\"/dailyinfo/media/ed25d95376a9bbc3.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>The U.S. Cybersecurity and Infrastructure Security Agency (CISA) on Friday <a href=\"https://www.cisa.gov/news-events/alerts/2026/11/13/cisa-adds-two-known-exploited-vulnerabilities-catalog\">added</a> a high-severity security flaw impacting UnrealIRCd, an open-source Internet Relay Chat (IRC) server, to its Known Exploited Vulnerabilities (<a href=\"https://www.cisa.gov/known-exploited-vulnerabilities-catalog\">KEV</a>) catalog, following reports of active exploitation.</p><p>The vulnerability, tracked as CVE-2026-114713 (CVSS score: 8.6), is a case of improper neutralization of delimiters that could be used to execute arbitrary commands with server/IRCOp privileges.</p><p>\"The labeled-response module in UnrealIRCd 6.0.0 before 6.2.7.1 does not escape the IRCv3 'label' message tag when echoing it into replies, which allows any user on a network with two or more linked servers to inject server-to-server commands that are executed with server authority,\" reads the <a href=\"https://nvd.nist.gov/vuln/detail/cve-2026-114713\">description</a> of the flaw in the NIST National Vulnerability Database (NVD).</p><p>The addition comes nearly a week after UnrealIRCd's project leader, developer, and maintainer, Bram Matthys (aka Syzop), released UnrealIRCd 6.2.7.1 to address multiple security vulnerabilities identified with the help of artificial intelligence, including CVE-2026-114713.</p><p>\"We are seeing bad guys exploiting this issue on the internet right now,\" Matthys <a href=\"https://forums.unrealircd.org/viewtopic.php?t=9487\">said</a>. \"Hopefully everyone has hot-patched or updated their server, or at the very least has the spamfilter workaround deployed. If not, do so ASAP!\"</p><p>Exploitation attempts are said to have commenced a day after the release of the hotfix on November 7, 2026. That said, the exact details of the malicious activity and its end goals are presently unknown. The maintainer described the vulnerability as the \"most critical issue\" found in UnrealIRCd over the past 15 years.</p><p>Federal Civilian Executive Branch (FCEB) agencies have time until November 16, 2026, to apply the fixes under Binding Operational Directive (BOD) 26-04: Prioritizing Security Updates Based on Risk.</p><p>Found this article interesting?  Follow us on <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>, <a href=\"https://twitter.com/thehackersnews\">Twitter</a> and <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a> to read more exclusive content we post.</p>","zhKind","complete","漏洞","补丁","网络设备","CISA","NVD","https://thehackernews.com/2026/11/attackers-exploit-unrealircd-flaw-that.html","The Hacker News",{"_91":92,"_93":-5},"changelogVersion","2026-10-01T08:00","release"]
