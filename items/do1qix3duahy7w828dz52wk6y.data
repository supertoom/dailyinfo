[{"_1":2,"_3":4},"root",{"_5":105},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795912836000,"id","do1qix3duahy7w828dz52wk6y","title","BlackNevas 利用合法 vCenter 管理接口破坏 VMware 虚拟化环境","originalTitle","十天潜伏、三小时破坏：BlackNevas 如何将 vCenter 变成勒索攻击控制面","summary","BlackNevas 通过组织内部获取的凭据进入 VCSA，建立 MeshAgent 与 Ligolo-ng 持久化通道，滥用 vCenter Host Profiles 开启 TSM-SSH，再经 SFTP 向 ESXi 投递加密器；事件导致四台 ESXi 主机及其全部虚拟机、两台 VCSA 和备份基础设施被破坏。","reason","文章还原了凭据滥用、Host Profiles 篡改、备份削弱到 ESXi 引爆的完整链路，并给出可关联监测的管理面预警信号。","source",{"_76":104},"links",{"_93":103},"publishedAt","2026-11-20T04:07:00.000Z","discoveredAt","2026-11-20T10:16:30.964Z","timelineAt","category","activity","tags",[79,96,77,97,98,81,99,100,101,102],"score",85,"selected",true,"channel","news","story",{"_89":90,"_13":91},"x","readingMode","full","author","body",{"_61":92,"_93":-5,"_94":93,"_95":37},"outline",[],"relatedStories",[88],"topics",[68,69,70,71,72,73],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fcnXY5Yywd14","reportCount",1,"additionalSourceCount",0,{"_74":86,"_76":87},{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","malware","name","恶意软件","attack","攻击活动","incident","应急响应","ransomware","勒索软件","supply-chain","供应链安全","vmware","VMware / Broadcom",{"_89":90,"_13":91},"publicId","14a4981a-27f2-4868-8ccd-a4bca3aaaa4a","BlackNevas破坏VMware虚拟化环境","<p>原创 <span>威胁情报中心</span> <span>2026-11-20 12:07</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/5fa1ad20a15b8c0f.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>卡巴斯基近期披露的一起事件中，四台 ESXi 主机及其承载的全部虚拟机、两台 vCenter Server Appliance（VCSA）和连接的备份基础设施均遭到破坏。赎金记录将攻击者标识为 BlackNevas，而所有针对 ESXi 的关键操作都通过合法的 VMware 管理接口完成。</p><p><span><span>事件分析 · BlackNevas · VMware ESXi / vCenter</span></span></p><p><span>十天潜伏、三小时破坏：</span><span><br></span><span>BlackNevas 如何将 vCenter 变成勒索攻击控制面</span></p><p><span>没有利用虚拟机逃逸，也没有触发 Hypervisor 内存破坏，攻击者仍然摧毁了整套虚拟化环境——所有针对 ESXi 的关键操作都通过合法的 VMware 管理接口完成</span></p><p><span>· 勒索软件　· 虚拟化安全　· GERT 披露　· 2026.11.20</span></p><p><span>没有利用虚拟机逃逸，也没有触发 Hypervisor 内存破坏，攻击者仍然摧毁了整套虚拟化环境。卡巴斯基全球应急响应团队（GERT）近期披露的一起事件中，</span><strong><span>四台 ESXi 主机及其承载的全部虚拟机、两台 vCenter Server Appliance（VCSA）和连接的备份基础设施均遭到破坏</span></strong><span>。赎金记录将攻击者标识为 BlackNevas，而所有针对 ESXi 的关键操作都通过合法的 VMware 管理接口完成。</span></p><p><span>这起事件值得关注的，不只是又一个支持 ESXi 的勒索软件家族，而是攻击者如何把凭据、远程管理工具、vCenter Host Profiles 和备份系统串成一条完整的破坏链：</span><strong><span>先取得管理面控制权，再改写主机访问状态，先削弱恢复能力，最后才在虚拟化层引爆载荷。</span></strong><span>对防守方而言，真正的预警窗口也由此从虚拟机内部转移到了身份、管理面与恢复链路。</span></p><p><span><span>01</span></span><span><span>&nbsp;事件核心：失守的是管理信任链，而非单个虚拟机</span></span></p><p><span>在传统终端勒索场景中，一台主机失陷通常首先影响该主机本身；而在虚拟化环境中，vCenter 集中管理多台 ESXi，ESXi 又同时承载域控制器、应用服务器、数据库等关键工作负载。</span><strong><span>攻击者一旦获得管理面权限，便可能把单点权限转化为批量控制与批量破坏能力。</span></strong></p><p><span>本次事件没有证据表明攻击者利用 ESXi 漏洞进入虚拟化层。卡巴斯基披露的路径是：攻击者使用从组织内部非虚拟化系统获取的凭据访问 VCSA；在备份基础设施上取得管理执行能力后，还提取了其中保存的凭据。有效账户、备份系统的集中信任关系和虚拟化管理权限由此被串联起来。</span></p><p><strong><span>补丁管理仍然必要，却不能覆盖这类风险。</span></strong><span>即使 Hypervisor 没有暴露已知漏洞，只要合法凭据能够跨边界复用、vCenter 能被普通企业网段访问、备份与生产共享同一套高权限身份，攻击者仍可能沿着正常管理通道抵达 ESXi。</span></p><p><span><span>02</span></span><span><span>&nbsp;攻击链还原：从合法登录到批量破坏</span></span></p><p><img src=\"/dailyinfo/media/7d300f5ab62b3df5.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>图1｜BlackNevas 事件十天攻击时间线</span></strong></p><p><span>图源：卡巴斯基 Securelist</span></p><p><span>1. 在 VCSA 上建立双通道持久化</span></p><p><span>攻击者首先通过 SSH 以 root 身份登录负责虚拟化灾难恢复管理的 VCSA。登录后仅&nbsp;</span><strong><span>43 秒</span></strong><span>，便通过 Shell 脚本下载并部署 MeshAgent——合法远程管理平台 MeshCentral 的终端组件。整个 SSH 会话持续 2 分 26 秒；会话结束后，攻击者不再通过 SSH 回访该设备。</span></p><p><span>约四小时后，攻击者改经 MeshAgent 返回，并将 Ligolo-ng 反向隧道配置为 systemd 服务，形成第二条持久化通道。相关配置刻意采用近似 VMware 组件的命名与路径：</span></p><p><span><span>Unit file：</span></span><span>/etc/systemd/system/vmware-vdma.service</span></p><p><span><span>Service：</span></span><span>vmware-vdma</span></p><p><span><span>Description：</span></span><span>DNS, time, VM settings sync (v2.03.24766)</span></p><p><span><span>ExecStart：</span></span><span>/opt/vmware/bin/agent</span></p><p><span><span>Restart：</span></span><span>always</span></p><p><span>该二进制中可见 Ligolo-ng v0.8.2 与&nbsp;</span><span><span>api.cloudvflare[.]com:443</span></span><span>&nbsp;字符串。这里的关键不在于某个名称天然恶意，而在于</span><strong><span>新出现的服务、未被基线批准的二进制和外部隧道地址形成了组合异常。</span></strong><span>只监控交互式 SSH 登录，会漏掉登录结束之后才真正开始使用的远控与隧道通道。</span></p><p><img src=\"/dailyinfo/media/0485998b14aec0c3.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>图2｜VCSA 双通道持久化与反向隧道建立过程</span></strong></p><p><span>图源：依据卡巴斯基 GERT 公开事件证据整理绘制</span></p><p><span>2. 滥用 Host Profiles，把 SSH 从策略关闭改为运行</span></p><p><span>vCenter Host Profiles 本来用于提取、校验并统一 ESXi 主机配置，也可以包含 Tech Support Mode（TSM）与 TSM-SSH 等服务状态。攻击者控制 vCenter 后，没有从主机下方绕过这项策略，而是</span><strong><span>直接利用集中管理功能，从上方改写了目标主机的期望状态。</span></strong></p><p><span>日志还原出的序列非常紧凑：T+0 读取主机配置；T+10 分 18 秒推送启用 SSH 的配置变更；T+10 分 51 秒，TSM-SSH 进入 RUNNING。</span><strong><span>配置推送与服务启动之间仅相隔 33 秒。</span></strong><span>随后，对目标 ESXi 的直接 SSH 访问来自 VCSA 的 IP 地址——一个在日常管理中通常被高度信任的来源。</span></p><p><span>这条链路说明，Host Profile 合规检查或修复操作本身并不等于安全。判断其风险必须结合变更窗口、操作账户、目标服务以及后续连接：</span><strong><span>如果一次未获批准的配置修复启用了 TSM-SSH，紧接着又出现 vCenter 到同一台 ESXi 的新 SSH 会话，其风险远高于任一单独事件。</span></strong></p><p><img src=\"/dailyinfo/media/bccac5d9f4221bc8.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>图3｜vCenter Host Profiles 滥用与 ESXi 直接访问链</span></strong></p><p><span>图源：卡巴斯基 Securelist</span></p><p><span>3. 通过 SFTP 投递载荷，并在正式破坏前自测</span></p><p><span>ESXi 载荷通过 SFTP 投递。</span><span><span>auth.log</span></span><span>&nbsp;中记录了与 Bitvise FlowSsh 相关的客户端标识；</span><span><span>shell.log</span></span><span>&nbsp;则保留了后续命令序列。FlowSsh 支持 SFTP、远程执行、交互式 Shell 和隧道，</span><strong><span>但对工具的识别应以日志中的客户端标识为主要依据，而不是仅凭行为猜测。</span></strong></p><p><span><span>T+0</span></span><span>&nbsp;true</span></p><p><span><span>T+1s</span></span><span>&nbsp;chmod +x /tmp/esx64</span></p><p><span><span>T+1m48s</span></span><span>&nbsp;true</span></p><p><span><span>T+1m49s</span></span><span>&nbsp;./tmp/esx64 /selftest</span></p><p><span>仅执行&nbsp;</span><span><span>true</span></span><span>&nbsp;的会话可视为自动化通道建立的行为线索，但并非 FlowSsh 的独有特征。真正有检测价值的是完整组合：</span><strong><span>异常客户端或来源、向 /tmp 暂存可执行文件、赋予执行权限、短暂自测，以及随后访问 /vmfs</span></strong><span>。此次&nbsp;</span><span><span>/selftest</span></span><span>&nbsp;运行约 16 秒，发生在最终引爆前约三小时，为防守方留下了一个明确但短暂的预破坏窗口。</span></p><p><span>4. 停止虚拟机后，对 VMFS 路径执行破坏性操作</span></p><p><span>成熟的 ESXi 加密器通常会在修改虚拟磁盘前停止虚拟机，以释放活动状态与文件锁。本次灾难恢复主机上的全部虚拟机在&nbsp;</span><strong><span>23 秒内停止</span></strong><span>，</span><span><span>vmksummary.log</span></span><span>&nbsp;中每小时记录的运行虚拟机数量也由正常值降为零。不过，现有证据无法确认攻击者究竟使用&nbsp;</span><span><span>esxcli、</span></span><span><span>vim-cmd</span></span><span>&nbsp;还是其他方式终止虚拟机，不能把某一家族的惯用命令直接套入本案。</span></p><p><span>卡巴斯基记录到的最终执行命令为：</span></p><p><span>./tmp/esx64&nbsp;</span><span><span>/p</span></span><span>&nbsp;/vmfs/&nbsp;</span><span><span>/depth</span></span><span>&nbsp;5&nbsp;</span><span><span>/wipe /allsys /detach /-showvolumes</span></span></p><p><span>其中，</span><span><span>/p</span></span><span><span>/vmfs/</span></span><span>&nbsp;指向虚拟机文件所在的 VMFS 根路径，</span><span><span>/depth 5</span></span><span>&nbsp;控制目录递归深度；</span><span><span>/wipe</span></span><span>&nbsp;与数据存储中出现的&nbsp;</span><span><span>._wipe</span></span><span>&nbsp;痕迹相互印证；</span><span><span>/detach</span></span><span>&nbsp;与 SSH 断开后破坏活动仍持续的现象一致。</span><span><span>/allsys</span></span><span>&nbsp;和&nbsp;</span><span><span>/-showvolumes</span></span><span>&nbsp;的含义主要借助 BlackNevas／Trigona 的公开家族资料辅助解释，由于没有取得本次 ESXi 加密器二进制，</span><strong><span>不能视为已完成样本级验证。</span></strong></p><p><span>事件痕迹还显示，</span><strong><span>虚拟磁盘文件约前 2 KB 被覆盖</span></strong><span>。这足以破坏保护性 MBR、主 GPT 头及其他早期启动或文件系统结构，使系统无法启动，但不能据此直接断言分区元数据完全不可恢复。GPT 在不同位置保存主、备份头及分区项数组；实际可恢复程度仍取决于备份 GPT、其他文件系统结构、描述文件和具体虚拟磁盘布局是否也被破坏。</span></p><p><img src=\"/dailyinfo/media/00076dd81527d335.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>图4｜ESXi 载荷投递、自测与最终引爆过程</span></strong></p><p><span>图源：依据卡巴斯基 GERT 公开事件证据整理绘制</span></p><p><span>5. 在 ESXi 引爆前，先拆除恢复能力</span></p><p><span>备份基础设施并非本次事件的附带受害者。攻击者在主要攻击发生前</span><strong><span>数日便关闭了备份环境的防病毒保护</span></strong><span>；在最后阶段，又依次停止备份服务、加密备份服务器、实施 SMB 传播并阻断管理员访问，最后才引爆 ESXi。</span></p><p><span>卡巴斯基给出的相对时间线为：T+0 停止备份服务，T+7 分钟备份服务器被加密，T+52 分钟出现 SMB 传播，T+2 小时 08 分管理员被锁定，T+2 小时 31 分 ESXi 载荷引爆。</span><strong><span>这个顺序使受害组织在最需要恢复生产时，同时失去备份服务、管理入口和部分恢复路径。</span></strong></p><p><img src=\"/dailyinfo/media/df9f83002e472905.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>图5｜恢复能力失效先于 ESXi 生产影响的攻击日时序</span></strong></p><p><span>图源：卡巴斯基 Securelist</span></p><p><strong><span>“备份不可变”并不自动等于“业务可恢复”。</span></strong><span>不可变存储无法单独保护恢复所需的身份、备份管理服务器、存储库、网络路径、凭据与操作流程。恢复系统必须作为独立安全边界设计，并在 vCenter 与生产 AD 均不可用的假设下验证恢复流程。</span></p><p><span><span>03</span></span><span><span>&nbsp;为什么传统终端监控难以看见关键动作</span></span></p><p><span>ESXi 基于 VMware 专有的 VMkernel。虽然它接受部分类似 Linux 的命令并运行部分类 Linux 软件，但并不是通用 Linux 发行版。Broadcom 明确说明，</span><strong><span>面向通用操作系统的现成安全工具不能直接在 ESXi 上运行，也不支持在 ESXi 与 VCSA 上直接安装第三方代理或防病毒软件。</span></strong></p><p><span>由此形成一种可见性落差：虚拟机内部的 EDR 能监控客户机进程，</span><strong><span>却无法直接观察或归因 ESXi 侧进程对 VMDK 或数据存储文件的修改</span></strong><span>。客户机可能只记录到突然关机、磁盘 I/O 失败等结果，而真正的恶意执行发生在其监控边界之外。</span></p><p><strong><span>另一类误区：把管理设备 IP 或合法管理工具直接视为可信。</span></strong><span>vCenter 发起的 SSH、Host Profile 推送和正常服务配置，在协议与接口层面都可能是合法操作；只有把这些动作与身份、时间、变更审批和后续行为关联起来，才能识别管理权限已经被滥用。</span></p><p><span><span>04</span></span><span><span>&nbsp;BlackNevas 家族背景与本案归因边界</span></span></p><p><span>SentinelOne 将 BlackNevas（又称 Trial Recovery）描述为 2024 年 11 月首次出现、由 Trigona 衍生而来的勒索软件家族，其公开样本覆盖 Windows、Linux、NAS 和 ESXi，并支持&nbsp;</span><span><span>/p</span></span><span>&nbsp;或&nbsp;</span><span><span>/path、</span></span><span><span>/wipe、</span></span><span><span>/depth、</span></span><span><span>/detach</span></span><span>&nbsp;等参数。本案赎金记录中的 BlackNevas 标识，以及最终命令的参数风格，与这些公开特征相吻合。</span></p><p><strong><span>但家族相似性不能替代样本证据。</span></strong><span>卡巴斯基未能取得本次 ESXi 加密器、Ligolo-ng 二进制、代理安装脚本和凭据提取脚本，因此也没有这些文件的哈希。对本次事件的可靠判断应建立在赎金记录、日志、服务配置、网络指标和破坏痕迹之上，而不是将其他 BlackNevas 样本的全部能力自动归入本案。</span></p><p><span>同样需要区分的是，</span><span><span>CVE-2024-37085</span></span><span>&nbsp;等虚拟化漏洞可以用于说明行业风险，但并非本次事件的入口。微软曾披露该漏洞被多个勒索攻击者用于在加入 AD 的 ESXi 上取得完全管理权限，并导致 Akira、Black Basta 等勒索软件部署；这一案例说明身份与管理组映射需要独立防护。</span></p><p><span><span>05</span></span><span><span>&nbsp;防守方应优先抓住的六个预警窗口</span></span></p><ol><li><span><span><span>Host Profile 异常变更。</span></span><span>在未批准的变更窗口内，Host Profile 修复或合规操作修改&nbsp;</span><span><span>TSM、</span></span><span><span>TSM-SSH，</span></span><span>且服务在短时间内进入&nbsp;</span><span><span>RUNNING，</span></span><span>应直接触发高优先级告警。若 15 分钟内又出现 vCenter 或管理设备到同一 ESXi 的新 SSH 会话，应升级为严重事件，并同步保存 vCenter Events／Tasks、</span><span><span>vpxa.log、</span></span><span><span>vobd.log</span></span><span>&nbsp;与&nbsp;</span><span><span>auth.log。</span></span></span></li><li><span><span><span>VCSA 出现未基线化的持久化组件。</span></span><span>重点检查&nbsp;</span><span><span>/etc/systemd/system</span></span><span>&nbsp;下新增或修改的单元，以及其引用的&nbsp;</span><span><span>/opt/vmware</span></span><span>&nbsp;等路径中的二进制。服务名称类似 VMware 并不能证明恶意或合法，关键是它是否存在于组织批准的服务与文件基线中，是否伴随远控、隧道或异常外联。</span></span></li><li><span><span><span>/tmp 暂存与 /vmfs 访问形成连续链路。</span></span><span>将 SFTP 上传、新可执行文件出现、</span><span><span>chmod、</span></span><span>短时自测和随后访问 /vmfs 关联检测。单独一次&nbsp;</span><span><span>chmod +x</span></span><span>&nbsp;可能含义有限，但新投递文件从临时目录进入执行并接近虚拟机存储，是必须立即核查的预破坏信号。</span></span></li><li><span><span><span>虚拟机在秒级或分钟级集中停止。</span></span><span>跨多台虚拟机连续出现&nbsp;</span><span><span>power-off</span></span><span>&nbsp;或&nbsp;</span><span><span>world-kill，</span></span><span>尤其在非维护窗口内发生，应视为高置信度预警。可关联&nbsp;</span><span><span>shell.log、</span></span><span><span>hostd.log、</span></span><span>vCenter Tasks 与&nbsp;</span><span><span>vmksummary.log，</span></span><span>但不能只依赖后者，因为其运行虚拟机计数按小时记录，时间粒度较粗。</span></span></li><li><span><span><span>备份与安全能力先于生产异常失效。</span></span><span>备份服务停止、备份环境防病毒被关闭、恢复服务器被加密或管理员突然失去访问，都应与虚拟化管理面告警联动。备份侧异常不是独立的运维问题，而可能是生产勒索破坏即将开始的前置信号。</span></span></li><li><span><span><span>ESXi 执行控制被削弱。</span></span><span>监控 Host Acceptance Level 是否降至更低信任级别，以及&nbsp;</span><span><span>execInstalledOnly</span></span><span>&nbsp;运行时或内核强制设置是否被关闭。Broadcom 指出，ESXi 8.0 及以后版本默认启用&nbsp;</span><span><span>execInstalledOnly</span></span><span>&nbsp;内部运行时选项，用于阻止未通过 VIB 安装的二进制执行；相关状态变化应纳入配置基线与审计。</span></span></li></ol><p><span><span>06</span></span><span><span>&nbsp;加固与应急：把管理面、身份面和恢复面分开保护</span></span></p><p><span>将 vCenter 按 Tier 0 资产管理</span></p><ul><li><span><span>使用专用虚拟化管理身份，避免域管理员、工作站管理员等普通企业高权限账户直接复用于 vCenter 或 ESXi。</span></span></li><li><span><span>通过受支持的身份联邦配置抗钓鱼多因素认证，严格限制管理网络来源、工作站与账户，并监控特权会话。</span></span></li><li><span><span>将 Host Profile、集群级配置、权限映射和 TSM-SSH 状态变化纳入审批与审计；在适合业务运维的前提下使用 Lockdown Mode，把 SSH 和 ESXi Shell 作为例外通道而非常态入口。</span></span></li><li><span><span>持续检查 ESXi 的 AD 集成与组映射。对于&nbsp;</span><span><span>CVE-2024-37085，</span></span><span>应按照 Broadcom 公告升级至受影响产品对应的修复版本；旧版本缓解措施不能替代生命周期管理。</span></span></li></ul><p><img src=\"/dailyinfo/media/a57aef9bc7ac0c2f.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>图6｜从共享信任到身份、虚拟化与恢复权限边界分离</span></strong></p><p><span>图源：卡巴斯基 Securelist</span></p><p><span>让日志独立于被攻击的平台</span></p><p><span>ESXi 本地日志使用空间有限的 ramdisk，重启可能清除相关证据；持久化 scratch 有助于重启后的留存，但仍无法抵御主机或本地数据存储被破坏。</span><strong><span>应将 ESXi 与 VCSA 的远程 syslog 发送到虚拟化信任域之外的集中日志或 SIEM，</span></strong><span>并确保日志路径不依赖同一套生产身份与管理控制面。</span></p><p><span>优先级最高的来源包括&nbsp;</span><span><span>auth.log、</span></span><span><span>shell.log、</span></span><span><span>vpxa.log、</span></span><span><span>vobd.log、</span></span><span>vCenter Events／Tasks，以及 VCSA 的 systemd 配置与被引用二进制。它们分别回答“谁从哪里登录”“执行了什么命令”“vCenter 对主机做了什么”“安全与服务状态如何变化”“哪个账户对哪个对象发起了任务”以及“攻击者如何留下持久化”。</span></p><p><span>把恢复能力建设成独立安全边界</span></p><ul><li><span><span>为备份配置独立管理身份，减少与生产 AD 的依赖，隔离备份管理接口和存储库。</span></span></li><li><span><span>保留离线或逻辑隔离的恢复副本，并确保生产凭据无权删除或改写这些副本。</span></span></li><li><span><span>定期演练在 vCenter、生产 AD 或备份管理服务器不可用时，干净的管理员能否完成认证、连接存储库、验证数据并恢复业务。</span></span></li><li><span><span>将备份服务状态、凭据库访问和安全工具状态纳入与生产环境联动的监控，而不是只在备份任务失败时查看。</span></span></li></ul><p><span>事件发现后的前 30 分钟，先保住证据再清理</span></p><p><span>在不影响紧急止损的前提下，先隔离 vCenter 与普通企业网段之间的管理访问，同时保留受控调查通道；导出 vCenter Events／Tasks、SSO 审计、活动会话和当前 Host Profile；收集各 ESXi 的认证、Shell、主机管理、内核、存储与 Host Profile 日志；保存 VCSA 可疑服务单元及其引用二进制；同时固定备份服务器服务状态、凭据库证据和网络日志。</span></p><p><strong><span>不要为了“踢掉攻击者”而首先重启 ESXi。</span></strong><span>重启可能破坏 ramdisk 中的证据。完成关键日志复制或确认远程留存后，再撤销或轮换失陷凭据、关闭未批准的 SSH／ESXi Shell、移除未授权远控与 systemd 服务，并防止 Host Profiles 或自动化任务重新开启这些入口。大规模恢复前，还应先隔离已失陷的备份设施并建立干净的恢复控制面。</span></p><p><img src=\"/dailyinfo/media/e04bd1c4de9eb37d.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>图7｜虚拟化层勒索事件应急响应流程</span></strong></p><p><span>图源：依据卡巴斯基 GERT 公开处置建议整理绘制</span></p><p><span><span>07</span></span><span><span>&nbsp;结语</span></span></p><p><span>这起事件最具警示性的地方，是</span><strong><span>攻击者没有必须突破某一项 Hypervisor 安全技术，而是接管了本就有权管理它的系统</span></strong><span>。vCenter 的集中权限、跨环境复用的身份和与生产耦合的恢复链路，共同放大了最终影响。</span></p><p><span>对应的防守重点也不应停留在“是否给 ESXi 安装了终端代理”。更有效的路径是：保护 vCenter 这一 Tier 0 控制点，分离企业、虚拟化与恢复身份，收窄直接管理通道，把高风险配置变更识别为连续行为，并确保关键日志与恢复能力不会随生产环境一起失效。</span><strong><span>勒索软件引爆前的每一个异常管理动作，都可能是阻止批量破坏的最后窗口。</span></strong></p><p><span><span>08</span></span><span><span>&nbsp;技术附录</span></span></p><p><span>附录 A：MITRE ATT&amp;CK 技术映射</span></p><p><span>以下映射仅对应公开材料明确描述的行为；平台相关但未在本案观察到的技术单独标注，不将常见漏洞或家族一般能力自动计入本次事件。</span></p><table><tbody><tr><td><p><span>技术 ID</span></p></td><td><p><span>技术名称</span></p></td><td><p><span>本案对应行为</span></p></td><td><p><span>证据状态</span></p></td></tr><tr><td><span><span>T1078／T1078.002</span></span></td><td><p><span>Valid Accounts／Domain Accounts</span></p></td><td><p><span>使用从非虚拟化系统获取的企业凭据访问特权基础设施</span></p></td><td><p><span>已观察／依账户类型关联子技术</span></p></td></tr><tr><td><span><span>T1021.004</span></span></td><td><p><span>Remote Services: SSH</span></p></td><td><p><span>通过 SSH 管理并访问 VCSA 与 ESXi；随后出现来自 VCSA 的 ESXi SSH 连接</span></p></td><td><p><span>已观察</span></p></td></tr><tr><td><span><span>T1543.002</span></span></td><td><p><span>Create or Modify System Process: Systemd Service</span></p></td><td><p><span>Ligolo-ng 以&nbsp;</span><span><span>vmware-vdma.service</span></span><span>&nbsp;形式在 VCSA 上持久化</span></p></td><td><p><span>已观察</span></p></td></tr><tr><td><span><span>T1572</span></span></td><td><p><span>Protocol Tunneling</span></p></td><td><p><span>Ligolo-ng 建立通向管理网段的反向隧道</span></p></td><td><p><span>已观察</span></p></td></tr><tr><td><span><span>T1219</span></span></td><td><p><span>Remote Access Software</span></p></td><td><p><span>部署合法 MeshCentral 的 MeshAgent 作为远程访问通道</span></p></td><td><p><span>已观察</span></p></td></tr><tr><td><span><span>T1105</span></span></td><td><p><span>Ingress Tool Transfer</span></p></td><td><p><span>通过 SFTP 向 ESXi 投递载荷，并由脚本获取 MeshAgent</span></p></td><td><p><span>已观察</span></p></td></tr><tr><td><span><span>T1562.001</span></span></td><td><p><span>Impair Defenses: Disable or Modify Tools</span></p></td><td><p><span>主要攻击前数日关闭备份环境的防病毒保护</span></p></td><td><p><span>已观察</span></p></td></tr><tr><td><span><span>T1490</span></span></td><td><p><span>Inhibit System Recovery</span></p></td><td><p><span>停止备份服务、加密恢复基础设施并阻断管理访问</span></p></td><td><p><span>已观察</span></p></td></tr><tr><td><span><span>T1486</span></span></td><td><p><span>Data Encrypted for Impact</span></p></td><td><p><span>勒索阶段使虚拟化工作负载不可用，并伴随虚拟磁盘覆盖痕迹</span></p></td><td><p><span>已观察影响</span></p></td></tr><tr><td><span><span>T1078.001</span></span></td><td><p><span>Valid Accounts: Default Accounts</span></p></td><td><span><span>root、</span></span><span><span>vpxuser</span></span><p><span>&nbsp;等默认或内置信任关系属于 ESXi 防守检查项</span></p></td><td><p><span>未在本案观察到，仅作平台上下文</span></p></td></tr></tbody></table><p><span>附录 B：失陷指标（IOC）</span></p><p><span>以下指标均为本次事件特定痕迹，适用于回溯排查，</span><strong><span>不应视为 BlackNevas 或其他勒索家族的长期通用签名。</span></strong><span>服务名、文件名、域名与 VPS 均可能被更换或重新分配。</span></p><table><tbody><tr><td><p><span>类型</span></p></td><td><p><span>指标</span></p></td><td><p><span>上下文</span></p></td></tr><tr><td><p><span>服务名</span></p></td><td><span><span>vmware-vdma</span></span></td><td><p><span>VCSA 上伪装为 VMware 服务的 systemd 单元</span></p></td></tr><tr><td><p><span>服务名</span></p></td><td><span><span>vspbind</span></span></td><td><p><span>Windows 远程管理代理服务</span></p></td></tr><tr><td><p><span>域名</span></p></td><td><span><span>api.cloudvflare[.]com</span></span></td><td><p><span>Ligolo-ng C2；与&nbsp;</span><span><span>cloudflare.com</span></span><span>&nbsp;相差一个字符</span></p></td></tr><tr><td><p><span>IPv4</span></p></td><td><span><span>45.149.154[.]135</span></span></td><td><p><span>远程管理代理 C2</span></p></td></tr><tr><td><p><span>IPv4</span></p></td><td><span><span>91.92.242[.]121</span></span></td><td><p><span>用于初始门户访问的 VPS</span></p></td></tr><tr><td><p><span>IPv4</span></p></td><td><span><span>31.41.33[.]212</span></span></td><td><p><span>用于初始门户访问的 VPS</span></p></td></tr><tr><td><p><span>IPv4</span></p></td><td><span><span>188.240.57[.]94</span></span></td><td><p><span>用于初始门户访问的 VPS</span></p></td></tr><tr><td><p><span>SHA-1</span></p></td><td><span><span>28f8da19ddcdf26e426875c7a834b34a79bc1c33</span></span></td><td><span><span>svhost.exe／lock.exe</span></span></td></tr><tr><td><p><span>SHA-256</span></p></td><td><span><span>15dc419b7fbeb50c50820a7cd27997541deafa4fa710f074bb657f0149574baf</span></span></td><td><p><span>远程管理代理</span></p></td></tr><tr><td><p><span>SHA-256</span></p></td><td><span><span>5a9b7a0d3f25757aea957713d7e84cabec87597b3474368328a8fd5ed7a12f78</span></span></td><td><p><span>已安装远程管理代理变体</span></p></td></tr></tbody></table><p><strong><span>补充排查痕迹：</span></strong><span><span>/etc/systemd/system/vmware-vdma.service、</span></span><span><span>/opt/vmware/bin/agent、</span></span><span><span>/tmp/esx64，</span></span><span>以及数据存储中的&nbsp;</span><span><span>._wipe</span></span><span>&nbsp;文件。当前没有本次 ESXi 加密器、Ligolo-ng 二进制、代理安装脚本或凭据提取脚本的可用哈希。</span></p><p><span>附录 C：最小虚拟化取证清单</span></p><table><tbody><tr><td><p><span>层面</span></p></td><td><p><span>遥测来源</span></p></td><td><p><span>主要调查价值</span></p></td></tr><tr><td><p><span>ESXi 认证</span></p></td><td><span><span>/var/run/log/auth.log</span></span></td><td><p><span>来源 IP、账户、SSH 时间与客户端标识</span></p></td></tr><tr><td><p><span>ESXi 命令</span></p></td><td><span><span>/var/run/log/shell.log</span></span></td><td><p><span>通过 ESXi Shell 执行的具体命令</span></p></td></tr><tr><td><p><span>vCenter 到主机管理</span></p></td><td><span><span>vpxa.log＋vCenter Events／Tasks</span></span></td><td><p><span>Host Profile 修复、服务变更与管理来源</span></p></td></tr><tr><td><p><span>主机安全观察</span></p></td><td><span><span>vobd.log</span></span></td><td><span><span>execInstalledOnly、</span></span><p><span>服务与安全状态事件</span></p></td></tr><tr><td><p><span>主机管理</span></p></td><td><span><span>hostd.log</span></span></td><td><p><span>虚拟机与主机任务、API／管理交互</span></p></td></tr><tr><td><p><span>内核与存储</span></p></td><td><span><span>vmkernel.log＋vmkwarning.log</span></span></td><td><p><span>存储故障、World 生命周期与 VMkernel 警告</span></p></td></tr><tr><td><p><span>影响规模</span></p></td><td><span><span>vmksummary.log</span></span></td><td><p><span>每小时运行虚拟机数量与主机心跳</span></p></td></tr><tr><td><p><span>VIB 历史</span></p></td><td><span><span>esxupdate.log</span></span></td><td><p><span>补丁与 VIB 安装活动</span></p></td></tr><tr><td><p><span>Host Profile</span></p></td><td><span><span>hostprofiletrace.log</span></span></td><td><p><span>配置文件应用与合规活动</span></p></td></tr><tr><td><p><span>单台虚拟机</span></p></td><td><p><span>VMX 同目录的&nbsp;</span><span><span>vmware.log</span></span></p></td><td><p><span>虚拟机电源与设备操作</span></p></td></tr><tr><td><p><span>VCSA 持久化</span></p></td><td><span><span>/etc/systemd/system＋被引用二进制</span></span></td><td><p><span>未授权服务与持久化路径</span></p></td></tr><tr><td><p><span>VCSA 访问</span></p></td><td><p><span>SSO 日志、认证日志、</span><span><span>wtmp、</span></span><span>Shell 历史</span></p></td><td><p><span>认证、会话与命令上下文</span></p></td></tr><tr><td><p><span>备份层</span></p></td><td><p><span>应用日志、Windows 遥测、凭据库证据</span></p></td><td><p><span>恢复路径失陷与凭据桥接</span></p></td></tr><tr><td><p><span>网络</span></p></td><td><p><span>防火墙、Flow、代理与 DNS 日志</span></p></td><td><p><span>vCenter 到 ESXi 的 SSH、C2、隧道与网段横向移动</span></p></td></tr></tbody></table><p><span><span>09</span></span><span><span>&nbsp;参考链接</span></span></p><p><strong><span>1. 卡巴斯基 Securelist：Ransomware at the hypervisor layer: how attackers use ESXi and vCenter features for malicious purposes</span></strong><span><br></span><span><span><a href=\"https://securelist.com/esxi-ransomware/121959/\">https://securelist.com/esxi-ransomware/121959/</a></span></span></p><p><strong><span>2. SentinelOne：BlackNevas Ransomware</span></strong><span><br></span><span><span><a href=\"https://www.sentinelone.com/anthology/blacknevas/\">https://www.sentinelone.com/anthology/blacknevas/</a></span></span></p><p><strong><span>3. Microsoft：Ransomware operators exploit ESXi hypervisor vulnerability for mass encryption</span></strong><span><br></span><span><span><a href=\"https://www.microsoft.com/en-us/security/blog/2024/07/29/ransomware-operators-exploit-esxi-hypervisor-vulnerability-for-mass-encryption/\">https://www.microsoft.com/en-us/security/blog/2024/07/29/ransomware-operators-exploit-esxi-hypervisor-vulnerability-for-mass-encryption/</a></span></span></p><p><strong><span>4. Broadcom：VMSA-2024-0013（CVE-2024-37085 等）</span></strong><span><br></span><span><span><a href=\"https://support.broadcom.com/web/ecx/support-content-notification/-/external/content/securityadvisories/0/24505\">https://support.broadcom.com/web/ecx/support-content-notification/-/external/content/securityadvisories/0/24505</a></span></span></p><p><strong><span>5. Broadcom：ESXi 8.x execInstalledOnly 说明</span></strong><span><br></span><span><span><a href=\"https://knowledge.broadcom.com/external/article/393794/esxi-8x-prevents-the-execution-of-3rd-pa.html\">https://knowledge.broadcom.com/external/article/393794/esxi-8x-prevents-the-execution-of-3rd-pa.html</a></span></span></p><p><strong><span>6. Mandiant：Bad VIB(E)s Part One——ESXi 恶意 VIB 持久化研究</span></strong><span><br></span><span><span><a href=\"https://www.mandiant.com/resources/blog/esxi-hypervisors-malware-persistence\">https://www.mandiant.com/resources/blog/esxi-hypervisors-malware-persistence</a></span></span></p><p><strong><span>7. MITRE ATT&amp;CK：Remote Services——SSH（T1021.004）</span></strong><span><br></span><span><span><a href=\"https://attack.mitre.org/techniques/T1021/004/\">https://attack.mitre.org/techniques/T1021/004/</a></span></span></p><p><strong><span>8. MITRE ATT&amp;CK：Valid Accounts（T1078）</span></strong><span><br></span><span><span><a href=\"https://attack.mitre.org/techniques/T1078/\">https://attack.mitre.org/techniques/T1078/</a></span></span></p><p><strong><span>9. MITRE ATT&amp;CK：Create or Modify System Process——Systemd Service（T1543.002）</span></strong><span><br></span><span><span><a href=\"https://attack.mitre.org/techniques/T1543/002/\">https://attack.mitre.org/techniques/T1543/002/</a></span></span></p><p><strong><span>10. MITRE ATT&amp;CK：Protocol Tunneling（T1572）</span></strong><span><br></span><span><span><a href=\"https://attack.mitre.org/techniques/T1572/\">https://attack.mitre.org/techniques/T1572/</a></span></span></p><p><strong><span>11. MITRE ATT&amp;CK：Inhibit System Recovery（T1490）</span></strong><span><br></span><span><span><a href=\"https://attack.mitre.org/techniques/T1490/\">https://attack.mitre.org/techniques/T1490/</a></span></span></p><p><strong><span>12. MITRE ATT&amp;CK：Data Encrypted for Impact（T1486）</span></strong><span><br></span><span><span><a href=\"https://attack.mitre.org/techniques/T1486/\">https://attack.mitre.org/techniques/T1486/</a></span></span></p><p><span>本文</span><span>已发布于NCC国家网络安全云社区<a href=\"https://nccsec.cn/security-community\">https://nccsec.cn/security-community</a></span></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=7c061d1e&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzI2MDc2MDA4OA%3D%3D%26mid%3D2247521462%26idx%3D1%26sn%3D4255628f912af9993074bd11dcb83a80\">跳转微信打开</a></p>","original","zhKind","complete","勒索","利用链","供应链","VMware","Kaspersky","SentinelOne","Microsoft","https://mp.weixin.qq.com/s?__biz=MzI2MDc2MDA4OA==&mid=2247521462&idx=1&sn=4255628f912af9993074bd11dcb83a80","奇安信威胁情报中心",{"_106":107,"_108":-5},"changelogVersion","2026-10-01T08:00","release"]
