[{"_1":2,"_3":4},"root",{"_5":119},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794444098000,"id","sif366thhfeqdn24sve2qcy60","title","Turla 利用 Microsoft Exchange 服务器部署 Cereal 后门窃取邮件","originalTitle","Turla’s Cereal malware turns victims’ Exchange servers into spy hubs","summary","ESET 发现俄罗斯关联组织 Turla 在哈萨克斯坦和罗马尼亚的 2 个政府机构 Microsoft Exchange 服务器上部署模块化 .NET 工具集 Cereal，通过伪装成 Outlook Web Access、Autodiscover 和 ActiveSync 流量的请求接收命令，并筛选发件人、收件人、主题或附件名称后复制邮件。","reason","文章拆解了 Cereal 的指令执行、邮件截取与离线回退机制，并披露了针对政府和北约相关通信的筛选规则。","source",{"_76":118},"links",{"_108":117},"publishedAt","2026-11-10T10:00:39.000Z","discoveredAt","2026-11-10T10:03:19.051Z","timelineAt","category","activity","tags",[79,77,112,113,114,115,116],"score",83,"selected",true,"channel","news","story",{"_89":90,"_13":91},"x","readingMode","full","author","Mirko Zorz","body",{"_61":107,"_108":-5,"_109":110,"_111":37},"outline",[92,93,94,95],"relatedStories",[88],"topics",[68,69,70,71,72,73],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fHyJ3k0jvJV4","reportCount",6,"additionalSourceCount",5,{"_74":86,"_76":87},{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","malware","name","恶意软件","attack","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","email","邮件与钓鱼","microsoft","Microsoft / 微软",{"_89":90,"_13":91},"publicId","b730b15c-81e8-41f1-b334-6023b6e66bf2","Turla用Cereal入侵Exchange窃取邮件",{"_11":105,"_97":106,"_99":100},{"_11":103,"_97":104,"_99":100},{"_11":101,"_97":102,"_99":100},{"_11":96,"_97":98,"_99":100},"sec-4","text","查看位置","level",3,"sec-3","邮件从 Exchange 内部被复制","sec-2","后门等待敲门","sec-1","两个政府机构，相隔一个月","<p>与俄罗斯有关联的组织 <a href=\"https://www.helpnetsecurity.com/2026/07/13/eu-uk-russia-cyber-activity-sanctions/\">Turla</a> 在两个政府组织的 Microsoft Exchange 服务器上植入了一套模块化 .NET 工具，其中一个位于哈萨克斯坦，另一个位于罗马尼亚，并利用该工具直接从邮件流中复制选定邮件。ESET 研究人员发现了这一恶意软件，并将其命名为 Cereal。</p><p>这套工具不需要由攻击者控制的服务器。操作人员将命令发送至受害者面向互联网的 Exchange 服务器，并将其伪装成普通的 Outlook Web Access、Autodiscover 和 ActiveSync 流量。对任何监控网络的人来说，这看起来都像是人们在查看电子邮件。在罗马尼亚，邮件收集模块被设置为筛选发送给 NATO 和 EU 地址或从这些地址收到的邮件。</p><p>“在遭入侵的 Exchange 服务器上，最有趣的活动并不总是用户收件箱中收到的邮件。在某个政府办公室里，一名官员向跨国军事联盟的同事发送了一封邮件。邮件完全按照正常方式通过 Microsoft Exchange 服务器发出，任何迹象看起来都不可疑。然而，就在邮件离开大楼之前，一段代码会悄然检查它，判断其具有值得关注的内容，并留下一份副本，以便转发给窥探者，而原始邮件则继续按原途发送，”ESET 研究员 <a href=\"https://www.linkedin.com/in/proli/\">Matías Porolli</a> 解释道。</p><h3 id=\"sec-1\">两个政府机构，相隔一个月</h3><p>ESET 于 2025 年 11 月 28 日在哈萨克斯坦的一个政府机构发现了这套工具。在调整检测规则后，该公司发现了罗马尼亚受害者，该机构于 2025 年 12 月 23 日遭到入侵。ESET 高度确信 Cereal 属于 Turla。其依据包括一个公开与 Turla 关联且曾与 Cereal 一同使用的组件，以及它与较早的 Turla 恶意软件之间的相似之处。Turla 又名 Snake，被广泛评估为俄罗斯 FSB 的一部分。</p><p>哈萨克斯坦的活动在 2026 年 1 月 15 日激增，这一天是旧新年之后的次日。旧新年是俄罗斯至今仍在庆祝的非正式节日。操作人员似乎把这个假期休掉了。</p><p><img src=\"/dailyinfo/media/8af1232879bb12c8.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Turla Exchange malware\" title=\"Components used in the observed attacks\"></p><h5>\n<p>观察到的攻击中使用的组件（来源：ESET）</p>\n</h5><h3 id=\"sec-2\">后门等待敲门</h3><p>作为主要后门的 CerealNeuron 驻留在 Exchange 服务器上，监听路径看起来与普通 Exchange 流量一致的传入 Web 请求，例如 /owa/sdds/ 和 /autodiscover/proxyservice/。如果请求经过正确加密并通过多项完整性检查，就会被解密并作为命令执行。其他请求则会收到一个外观合法的 Exchange 错误页面。ESET 无法确定操作人员连接时使用的 IP 地址。实际上，受害者托管了攻击者的命令服务器。</p><p>每条命令都以一个小型、已编译的 .NET 程序的形式到达，每个程序只负责一项任务：提取邮箱、查询 Active Directory、提取 LSA 机密（Windows 在本地存储的凭据），或读取并删除文件。大量近乎相同的二进制文件表明，这套命令可能是由一个自动生成命令的框架构建的。第二个后门 CerealHermit 完全绕过网络，从磁盘读取加密的命令文件，为操作人员提供备用手段。</p><h3 id=\"sec-3\">邮件从 Exchange 内部被复制</h3><p>Turla 过去曾滥用 Exchange 传输代理。这些插件会挂接到邮件流中，执行垃圾邮件过滤等任务，而已注册的代理会出现在 Exchange 配置中。CerealBox 通过将自身注入负责传输邮件的进程 EdgeTransport.exe，并包装已加载到内存中的传输代理处理器来规避这一点。邮件继续流动，并且不会出现新的代理。</p><p>CerealBox 会保留带有 .doc、.docx 或 .pdf 附件，且发件人、收件人、主题字符串或附件名称与硬编码列表相匹配的消息。它会对这些消息进行压缩、加密并暂存到磁盘上，供操作人员稍后收集。ESET 表示，此前尚未有任何恶意软件家族被记录过从内部挂钩传输服务的做法。</p><h3 id=\"sec-4\">查看位置</h3><p>Cereal 的加载器是唯一以可识别的 .NET 文件形式写入磁盘的组件。它会在 .NET 运行时开始执行常规指令之前运行原生代码，因此，分析人员查看其 .NET 代码时，会看到一个似乎什么都不做的程序。在一条攻击链中，它伪装成位于 C:\\Windows\\System32\\wbem 下的 ncobjapi.dll，由 Windows Management Instrumentation 服务自动加载。在另一条攻击链中，它伪装成 wbemcomn.dll。操作人员还会将副本放入 .NET 本映像缓存（一个预编译库文件夹）中，文件名包括 Microsoft.Exchange.Search.Mdb.ni.dll 等。Exchange 会优先加载恶意文件，随后回退到真正的库。</p>","original","zhKind","translation","complete","后门","数据窃取","邮件安全","Microsoft","ESET","https://www.helpnetsecurity.com/2026/11/10/eset-turla-exchange-malware/","Help Net Security",{"_120":121,"_122":-5},"changelogVersion","2026-10-01T08:00","release"]
