[{"_1":2,"_3":4},"root",{"_5":106},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1794185106000,"id","sn7aglzxgosi5bih83rljqrmt","title","CISA 确认 PHP2Shell 漏洞 CVE-2026-109618 和 CVE-2026-109619 已遭在野利用","originalTitle","CISA confirms PHP2Shell vulnerabilities now exploited in attacks","summary","CISA 确认 PHP2Shell 漏洞 CVE-2026-109618 和 CVE-2026-109619 已被用于真实攻击，未获权限的攻击者可通过高复杂度利用在未修补系统上取得 RCE。","reason","source",{"_74":105},"links",{"_92":104},"publishedAt","2026-10-27T08:20:54.000Z","discoveredAt","2026-10-28T09:02:43.229Z","timelineAt","category","vuln","tags",[98,75,99,100,101,78,102,103],"score",79,"selected",true,"channel","news","story",{"_80":81,"_13":82},"x","sameEvent",{"_11":96,"_13":97},"readingMode","full","author","Sergiu Gatlan","body",{"_62":91,"_92":-5,"_93":94,"_95":36},"outline",[83,84],"relatedStories",[79],"topics",[69,70,71],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","f3bAFq2YlYtg","reportCount",3,"additionalSourceCount",2,{"_72":77,"_74":78},{"_72":30,"_74":76},{"_72":73,"_74":75},"slug","exploited","name","在野利用","漏洞披露","cisa","CISA",{"_80":81,"_13":82},"publicId","dc396fc7-8ca8-43c6-a297-c10a57e3eff2","PHP2Shell在野利用扩大至Palo Alto管理接口",{"_11":89,"_86":90,"_88":68},{"_11":85,"_86":87,"_88":68},"sec-2","text","攻击者一旦拥有有效凭据，其行动仅有 37% 会被阻止","level","sec-1","联邦机构被要求在星期四前完成修补","<p><img alt=\"PHP\" height=\"900\" src=\"/dailyinfo/media/eb643a38386494f7.jpg\" srcset=\"/dailyinfo/media/fedb5aebdb5e6ed3.jpg 720w, /dailyinfo/media/96b80e4b2d7ff890.jpg 1200w, /dailyinfo/media/eb643a38386494f7.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>美国网络安全和基础设施安全局（CISA）已将两个被统称为 PHP2Shell 的严重 PHP 漏洞加入其正在被积极利用的安全缺陷目录。</p><p>无权限威胁行为者可在高复杂度攻击中利用这两个安全问题（CVE-2026-109618 和 CVE-2026-109619），在未打补丁的系统上获取远程代码执行（RCE）。</p><p><a href=\"https://www.bleepingcomputer.com/news/security/php-ships-emergency-patches-for-critical-php2shell-flaws/\">PHP 安全团队已修补</a>了这两个漏洞，修补时间为 10 月 21 日星期三，即<a href=\"https://www.bleepingcomputer.com/news/security/php-warns-admins-of-two-critical-flaws-emergency-patches-coming-tomorrow/\">敦促安全团队</a>在安全更新发布后尽快安装的第二天。</p><p>尽管有关 PHP2Shell 安全漏洞的详细信息（包括 CVE ID 以及与关键基础设施提供商共享的缓解措施）在补丁上线前就已<a href=\"https://thephp.foundation/blog/2026/10/21/todays-php-security-release-and-how-were-strengthening-php-security/#leak-and-disrupted-disclosure\">泄露</a>，且一些概念验证（PoC）漏洞利用代码也已在线发布，但 PHP 安全团队表示，这些代码均无法正常发挥作用。</p><p>多家网络安全公司（包括 <a href=\"https://blog.cloudflare.com/php-vulnerabilities-waf-protection/\">Cloudflare</a>、<a href=\"https://www.bleepingcomputer.com/news/security/amazon-says-php2shell-exploitation-began-4-days-before-patches/\">Amazon</a>、<a href=\"https://hadrian.io/vulnerability-alerts/php2shell-leaked-critical-php-rce-cve-2026-109618-cve-2026-109619\">Hadrian</a>、<a href=\"https://watchtowr.com/intelligence/php-remote-code-execution-php2shell/#elementor-toc__heading-anchor-2\">watchTowr</a>、<a href=\"https://x.com/PrevidianCyber/status/2112936591719068048\">Previdian</a> 和 <a href=\"https://x.com/OliverSild/status/2112823822411866215\">Patchstack</a>）也在公开披露前检测到了大规模利用尝试，但它们均将相关活动标记为未成功。</p><p>Amazon Threat Intelligence 安全研究人员还表示，攻击者在安全补丁发布前<a href=\"https://www.bleepingcomputer.com/news/security/amazon-says-php2shell-exploitation-began-4-days-before-patches/\">四天</a>便开始针对 PHP2Shell 漏洞。</p><h2 id=\"sec-1\">联邦机构被要求在星期四前完成修补</h2><p>CISA 于周一将这两个漏洞<a href=\"https://www.cisa.gov/news-events/alerts/2026/10/26/cisa-adds-two-known-exploited-vulnerabilities-catalog\">加入</a>其<a href=\"https://www.cisa.gov/known-exploited-vulnerabilities-catalog?search=&amp;field_date_added_wrapper=all&amp;field_cve=&amp;sort_by=field_date_added&amp;items_per_page=All&amp;url=&amp;f%5B0%5D=vendor_project%3A1151\">已知被利用漏洞目录</a>，并依据约束性操作指令 26-04，要求联邦民事行政部门（FCEB）机构在星期四前保护其系统。</p><p>该网络安全机构警告称：“这类漏洞是恶意网络行为者常用的攻击途径，对联邦企业构成重大风险。”</p><p>“虽然 BOD 26-04 仅适用于 FCEB 机构，但 CISA 鼓励所有组织采用基于风险的漏洞管理，并优先修复 KEV 目录中的漏洞。”</p><p>尽管 CISA 尚未披露有关正在进行的 PHP2Shell 攻击的更多详情，但 Perplexity 检测与响应负责人 Adel Karimi 在周末首次确认了针对漏洞的真实世界利用，此前他们的<a href=\"http://github.com/0x4D31/honeypot-data/tree/main/reports/php2shell/2026-10-24-rce-evidence\">蜜罐记录到</a>针对运行 PHP 8.4.26 的 Apache mod_php 安装环境的<a href=\"https://www.linkedin.com/posts/malwaretech_confirmed-in-the-wild-exploitation-of-php2shell-share-7519864366863847424-TaMU/\">远程代码执行</a>证据。</p><p>周五，PHP 安全团队还针对一个新的 RCE 漏洞（CVE-2026-115560）<a href=\"https://www.bleepingcomputer.com/news/security/php-shares-mitigation-for-new-and-unpatched-rce-vulnerability/\">发布了缓解措施</a>，该漏洞尚无补丁，在针对配置与应用代码组合“不寻常”的系统时可被利用。</p><p>根据 <a href=\"http://blog.virustotal.com/2026/10/sizing-php-exposure-window-for-cve-2026.html\">VirusTotal 的估算</a>，PHP 驱动着<a href=\"https://w3techs.com/technologies/details/pl-php\">约 70%</a> 的所有网站，线上暴露的 PHP 主机超过 510 万个，其中约 380 万个实例至少有一个端口可遭受攻击。</p><p><a href=\"https://hubs.li/Q04sB3fb0\">\n            <img src=\"/dailyinfo/media/8fba1fc16e9d219a.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-2\">\n            <a href=\"https://hubs.li/Q04sB3fb0\">攻击者一旦拥有有效凭据，其行动仅有 37% 会被阻止</a>\n        </h2><p>整体防御得分可能掩盖初始访问后所发生的情况。一旦攻击者开始使用有效凭据，防御效果便会大幅下降。</p><p>Blue Report 2026 对客户生产环境中运行的 3.38 亿次模拟进行了逐项技术防御评估。</p><p><a href=\"https://hubs.li/Q04sB3fb0\">获取报告</a>\n    </p>","original","zhKind","translation","complete","l085bwg4l2mtsyh1rk0l4roy6","CISA 将 PHP PHP2Shell 漏洞 CVE-2026-109618 和 CVE-2026-109619 加入 KEV 目录","漏洞","补丁","漏洞利用","PHP","AWS","Cloudflare","https://www.bleepingcomputer.com/news/security/cisa-confirms-php2shell-vulnerabilities-now-exploited-in-attacks/","BleepingComputer",{"_107":108,"_109":-5},"changelogVersion","2026-10-01T08:00","release"]
