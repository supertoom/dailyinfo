[{"_1":2,"_3":4},"root",{"_5":115},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795740036000,"id","en1gv0ci3e610k5ce0nrbau25","title","Kaspersky 发现 Keenadu 后门预装于超过 220,000 台 Android 设备","originalTitle","Preinstalled Keenadu malware turns up on 220,000+ Android devices","summary","Kaspersky 在前 10 个月内于超过 220,000 台 Android 设备中发现 Keenadu；它与 Triada 合计出现在今年检出预装恶意软件设备的 88% 中。","reason","文章拆解了预装恶意软件的供应链入侵路径、潜伏与模块化机制，并提供企业采购前的样本测试建议。","source",{"_76":114},"links",{"_105":113},"publishedAt","2026-11-26T12:57:58.000Z","discoveredAt","2026-11-26T12:59:19.480Z","timelineAt","category","activity","tags",[77,109,110,83,111,112],"score",75,"selected",true,"channel","news","story",{"_89":90,"_13":91},"x","readingMode","full","author","Sinisa Markovic","body",{"_61":104,"_105":-5,"_106":107,"_108":37},"outline",[92,93,94],"relatedStories",[88],"topics",[68,69,70,71,72,73],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fIAtqIHqIbq4","reportCount",1,"additionalSourceCount",0,{"_74":86,"_76":87},{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","malware","name","恶意软件","black-market","数据窃取与黑产","ransomware","勒索软件","mobile","移动端","supply-chain","供应链安全","kaspersky","Kaspersky / Securelist",{"_89":90,"_13":91},"publicId","421a7c04-24c9-4a6c-8ed4-cc6c8cb71b84","Keenadu恶意软件预装于逾22万台安卓设备",{"_11":102,"_96":103,"_98":99},{"_11":100,"_96":101,"_98":99},{"_11":95,"_96":97,"_98":99},"sec-3","text","批量购买前测试样机","level",3,"sec-2","企业所付出的代价","sec-1","植入供应链","<p>据 Kaspersky 称，一台新的 Android 手机可能在出厂时就已在固件中植入恶意软件，而过去一年中每月检测到的此类设备数量增长了 2.5 倍以上。</p><p><img src=\"/dailyinfo/media/7acdd05f9a80d3e4.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Keenadu malware Android\" title=\"Android\"></p><p><a href=\"https://www.helpnetsecurity.com/2026/02/17/firmware-level-android-backdoor-keenadu-tablets/\">Keenadu</a> 是导致大多数此类感染的两个恶意软件家族之一，仅在 2026 年前十个月就侵入了超过 220,000 台设备。它与较老的 Triada 家族合计出现在今年发现预装恶意软件的设备中的 88% 上。Triada 最初于约十年前被发现，2026 年又出现了约二十种不同变种。</p><p>研究人员解释道：“最新的 Triada 版本具有两个关键区别特征：能够向设备上的任何应用注入恶意功能，无论是系统应用还是用户安装的应用；以及采用模块化架构，使攻击者能够根据当前目标为其定制恶意软件，并添加额外的有效载荷。”</p><p>Kaspersky 检查的 Keenadu 后门版本在收到命令与控制服务器发出的激活指令前，约两个半月内一直保持静默。Kaspersky 认为，这种延迟是为了帮助恶意软件避免检测。</p><p>Keenadu 从 Triada 借用了同样的模块化设计，使攻击者能够将额外模块推送到设备上，并将其注入目标应用。在大多数已知的 Keenadu 攻击中，该恶意软件被用于广告欺诈，尤其是生成虚假点击。</p><h3 id=\"sec-1\">植入供应链</h3><p>此类恶意软件通过供应链攻击进入设备。在某些情况下，制造商会故意安装它。在其他情况下，组装最终产品的合法品牌会从恶意承包商处收到恶意固件，或者构建过程中使用的某个组件遭到入侵。 </p><p>Kaspersky 警告称，一旦恶意软件进入系统分区，“无论是防病毒工具还是操作系统本身，都‘在技术上不可能将其移除’”。其中一些木马即使通过重新刷写设备也很难或根本无法清除。</p><p>大多数案例涉及手机和平板，不过 Kaspersky 还在其他硬件中发现了不同的预装恶意软件家族，包括儿童智能手表固件中的 Dwphon，以及电视盒子中的 Vo1d。</p><h3 id=\"sec-2\">企业所付出的代价</h3><p>该安全公司指出，将这些设备发给员工的企业最终可能面临手机运行速度变慢、广告弹出（其中一些用户可见，还有一些隐藏）、账户被劫持、加密货币被盗以及企业数据泄露等问题。感染恶意软件的设备可能会被编入<a href=\"https://www.helpnetsecurity.com/2026/04/06/residential-proxy-attack-traffic-ip-reputation-enterprise-security/\">代理网络</a>或 DDoS 僵尸网络，而攻击者通过禁用日常使用的设备即可扰乱企业的运营。</p><h3 id=\"sec-3\">批量购买前测试样机</h3><p>Kaspersky 建议企业在订购大批设备前检查并试用样机，同时强调这一步不能取代每台设备上的安全软件。</p><p>研究人员<a href=\"https://securelist.com/tr/how-to-protect-against-preinstalled-android-malware/122093/\">总结</a>道：“即使测试结果没有问题，不道德的供应商也可能是故意送来洁净设备供检查。保护措施还必须持续进行，因为例如设备更新系统可能遭到攻击。”</p>","original","zhKind","translation","complete","后门","供应链投毒","Kaspersky","数据窃取","https://www.helpnetsecurity.com/2026/11/26/keenadu-malware-android-devices/","Help Net Security",{"_116":117,"_118":-5},"changelogVersion","2026-10-01T08:00","release"]
