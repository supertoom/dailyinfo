[{"_1":2,"_3":4},"root",{"_5":88},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":-5,"_57":36,"_58":59},"expiresAt",1795480835000,"id","gbd1x28y7l8xrva45tcfvtev7","title","OpenRouter 因提示词与密钥泄露移除 3 家 AI 供应商","originalTitle","OpenRouter drops AI providers over leaked prompts and secrets","summary","OpenRouter 在发现 3 家 AI 供应商违反数据处理策略并泄露敏感数据后，移除 Together AI、Phala 和 Novita，并作为预防措施撤销 125 个端点的 ZDR 资格，通知所有可能受影响的客户。","reason","source",{"_64":87},"links",{"_59":86},"publishedAt","2026-11-23T20:00:20.000Z","discoveredAt","2026-11-23T20:07:32.206Z","timelineAt","category","ai-security","tags",[65,80,81,82,83,84,85],"score",77,"selected",false,"channel","news","story","x","readingMode","full","author","Bill Toulas","body",{"_76":-5,"_59":77,"_78":-5,"_79":36},"outline",[70],"relatedStories",[],"topics",[60,61,62],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_63":68,"_64":69},{"_63":66,"_64":67},{"_63":30,"_64":65},"slug","name","AI 安全","ai-agent","AI Agent 安全","identity","身份与访问",{"_11":71,"_72":73,"_74":75},"sec-1","text","Uncover email threats your existing defenses may miss.","level",2,"zh","<p><img alt=\"OpenRouter drops AI providers over leaked prompts and secrets\" height=\"900\" src=\"/dailyinfo/media/04e0c0f62e56e858.jpg\" srcset=\"/dailyinfo/media/02d089fd6492aed0.jpg 720w, /dailyinfo/media/fa9980ea831befac.jpg 1200w, /dailyinfo/media/04e0c0f62e56e858.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>OpenRouter removed three AI providers from its platform after discovering that they had violated their stated data-handling policies and exposed sensitive data.</p><p>The company also revoked Zero Data Retention (ZDR) eligibility for 125 endpoints as a precaution and notified all potentially affected customers.</p><p>OpenRouter is an AI model broker that lets developers access AI models from different companies using a single API key.</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/ec0400265c732eea.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>When an app sends a request, OpenRouter forwards it to a provider that runs the selected model and passes the answer back.</p><p>Operational technology security company Dragos alerted OpenRouter after sending two million test prompts through the platform, each containing a unique tracking link or decoy credential, and detecting \"activity indicating that data from at least three AI providers was exposed.\"</p><p>Dragos discovered that, in some cases, those credentials were leaked to outsiders and used in the wild, indicating that the test prompts had escaped.</p><p>“We observed activity indicating that data from at least three AI providers was exposed. Our seeded test prompts were used in attempts to access our controlled test systems and canary AWS accounts,” <a href=\"https://www.dragos.com/blog/ai-supply-chain-security-canary-tokens\">Dragos says</a>.</p><figure><img alt=\"Discovering AWS key reuse\" height=\"600\" src=\"/dailyinfo/media/a1e7e2511fd6d37f.jpg\" srcset=\"/dailyinfo/media/9ae75aba0f77d3ff.jpg 720w, /dailyinfo/media/1f2b2f348e2aaa0a.jpg 1200w, /dailyinfo/media/a1e7e2511fd6d37f.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"762\">\n<figcaption><strong>Discovering AWS key reuse</strong><br>\n<em>Source: Dragos</em></figcaption>\n</figure><p><a href=\"https://openrouter.ai/blog/announcements/data-processing-incidents-on-inference-providers/\">OpenRouter says</a> there was no breach on its own systems, making the leak point at the provider level and leading to the decision to remove the three leaking inference providers: Together AI, Phala, and Novita.</p><p>Another provider, Atlas Cloud, said it would <a href=\"https://www.atlascloud.ai/blog/ai-updates/security-and-privacy-commitment\">voluntarily withdraw its models</a> from OpenRouter pending security testing, following a third-party security incident.</p><p>The other three published separate announcements responding to Dragos’ findings and explaining how the leaks occurred.</p><p><a href=\"https://www.together.ai/blog/security-event-prompt-leakage-for-requests-in-june-and-july-of-2026\">Together AI said</a> an AI coding agent exposed a repository credential on GitHub, allowing an unauthorized party to download stored prompt samples from June and July involving MiniMax M3, GLM-5.2, and Kimi K2.6.</p><p><a href=\"https://phala.com/posts/phala-november-preliminary-incident-report\">Phala said</a> an attacker compromised a server processing DeepSeek V4 Flash 0731 requests routed through OpenRouter between October 21 and 22, and possibly up to November 8, and obtained application credentials from affected virtual machines.</p><p><a href=\"https://novita.ai/blog/minimax-requests-privacy-notice/\">Novita said</a> a routing misconfiguration forwarded some MiniMax requests, including those sent through OpenRouter, to MiniMax’s official API between May 28 and November 11.</p><p>All four providers are tightening security controls, strengthening their zero data retention or data deletion policies, and advising potentially impacted users to rotate any secrets that may have been exposed in the leaked requests.</p><p>OpenRouter is also adapting Dragos’ tests for ongoing use to check whether AI providers forward or leak user requests/responses to third parties, and will require validation before restoring ZDR eligibility.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/af2e1e4209b93434.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Uncover email threats your existing defenses may miss.</a>\n        </h2><p>Adaptive Security's AI agents analyze email intent, context, and behavior to uncover phishing, business email compromise, and invoice fraud.</p><p>See what's getting through with a 14-day read-only scan of Microsoft 365 or Google Workspace, with no MX changes.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Start your free email security scan.</a>\n    </p>","zhKind","complete","数据泄露","凭据","AI 供应链","安全运营","大模型","AWS","https://www.bleepingcomputer.com/news/security/openrouter-drops-ai-providers-over-leaked-prompts-and-secrets/","BleepingComputer",{"_89":90,"_91":-5},"changelogVersion","2026-10-01T08:00","release"]
