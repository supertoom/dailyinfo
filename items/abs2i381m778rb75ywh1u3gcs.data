[{"_1":2,"_3":4},"root",{"_5":121},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795653634000,"id","abs2i381m778rb75ywh1u3gcs","title","Amazon Cognito Plus 计划将用户池月度可用性承诺提升至 99.99%","originalTitle","Planning for 99.99 percent availability with the Amazon Cognito Plus feature plan","summary","Amazon Cognito 将 Plus 功能计划的用户池月度可用性承诺从 99.9% 提升至 99.99%，自 2026 年 11 月 1 日起生效，Essentials 和 Lite 仍为 99.9%。","reason","source",{"_72":120},"links",{"_61":119},"publishedAt","2026-11-25T17:50:39.000Z","discoveredAt","2026-11-25T18:25:23.076Z","timelineAt","category","policy","tags",[115,116,117,75,118],"score",16,"selected",false,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","Brian Song","body",{"_111":-5,"_61":112,"_113":-5,"_114":36},"outline",[82,83,84,85,86,87,88,89,90],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fPQnecuZ4MdM","reportCount",1,"additionalSourceCount",0,{"_71":76,"_72":77},{"_71":74,"_72":75},{"_71":30,"_72":73},"slug","name","政策法规","identity","身份与访问","cloud-native","云与原生",{"_79":80,"_13":81},"publicId","c010bfb3-6123-4b66-a208-0177a92cefa1","Amazon Cognito Plus可用性承诺升至99.99%",{"_11":109,"_92":110,"_94":95},{"_11":107,"_92":108,"_94":95},{"_11":105,"_92":106,"_94":95},{"_11":103,"_92":104,"_94":95},{"_11":101,"_92":102,"_94":95},{"_11":99,"_92":100,"_94":95},{"_11":97,"_92":98,"_94":95},{"_11":96,"_92":45,"_94":95},{"_11":91,"_92":93,"_94":95},"sec-9","text","Chris Simmons","level",3,"sec-8","sec-7","Conclusion","sec-6","Switch to the Plus feature plan","sec-5","Historical availability over the past 12 months","sec-4","How Amazon Cognito measures availability","sec-3","What 99.99 percent means in practice","sec-2","The new Service Commitment and Service Credits","sec-1","Why we raised the Service Commitment","zh","<p><span><a href=\"https://aws.amazon.com/cognito/\"><u>Amazon Cognito</u></a></span> handles sign-in and access control for users, AI agents, and microservices with managed user directories, social and enterprise federation, and passwordless sign-in with passkeys or one-time passwords.</p><p>Sign-in is the front door to your application. If your customer identity and access management (CIAM) layer is unavailable, users can’t sign in or refresh their sessions, and they can’t reach the rest of your application. Your application’s availability directly depends on the availability of your identity layer.</p><p>Starting November 1, 2026, the <span><a href=\"https://aws.amazon.com/cognito/sla/\"><u>Amazon Cognito Service Level Agreement (SLA)</u></a></span> commits to a Monthly Uptime Percentage of 99.99 percent for user pools on the Plus feature plan, up from 99.9 percent. A <span><a href=\"https://docs.aws.amazon.com/cognito/latest/developerguide/cognito-user-pools.html\"><u>user pool</u></a></span> is a multi-tenant user directory that stores your users’ profiles and settings. User pools on Essentials and Lite feature plans remain at the 99.9 percent Service Commitment, while user pools already on Plus receive the new Service Commitment automatically.</p><p>This post explains why we made the change, how availability is measured, what’s in the updated SLA, how the SLA measures availability, historical availability data, and how to switch a user pool to Plus.</p><h3 id=\"sec-1\">Why we raised the Service Commitment</h3><p>Many customers use Amazon Cognito for sign-in to applications with strict availability requirements, such as patient portals and retail checkout flows. They need the services they build on to support high availability. We raised the Service Commitment for the Plus feature plan to 99.99 percent so that their identity layer is backed by an SLA that matches their commitments.</p><h3 id=\"sec-2\">The new Service Commitment and Service Credits</h3><p>For each AWS Region, during each monthly billing cycle, AWS commits to a Monthly Uptime Percentage of at least 99.99 percent for user pools on Plus, and at least 99.9 percent for user pools on Essentials and Lite. If Amazon Cognito doesn’t meet the Service Commitment for your feature plan, you may be eligible for a Service Credit, as shown in Tables 1 and 2. For full terms and exclusions, see the <span><a href=\"https://aws.amazon.com/cognito/sla/\">Amazon Cognito SLA</a></span>.</p><p><b>Table 1: Service Credit percentage for the Plus Feature Plan</b></p><table> \n <tbody> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\"><b>Monthly Uptime Percentage</b></td> \n   <td colspan=\"1\" rowspan=\"1\"><b>Plus</b></td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">Less than 99.99% but equal to or greater than 99.0%</td> \n   <td colspan=\"1\" rowspan=\"1\">10%</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">Less than 99.0% but equal to or greater than 95.0%</td> \n   <td colspan=\"1\" rowspan=\"1\">25%</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">Less than 95.0%</td> \n   <td colspan=\"1\" rowspan=\"1\">100%</td> \n  </tr> \n </tbody> \n</table><p><b>Table 2: Service Credit percentage for the Essentials and Lite Feature Plan</b></p><table> \n <tbody> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\"><b>Monthly Uptime Percentage</b></td> \n   <td colspan=\"1\" rowspan=\"1\"><b>Essentials and Lite</b></td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">Less than 99.9% but equal to or greater than 99.0%</td> \n   <td colspan=\"1\" rowspan=\"1\">10%</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">Less than 99.0% but equal to or greater than 95.0%</td> \n   <td colspan=\"1\" rowspan=\"1\">25%</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">Less than 95.0%</td> \n   <td colspan=\"1\" rowspan=\"1\">100%</td> \n  </tr> \n </tbody> \n</table><h3 id=\"sec-3\">What 99.99 percent means in practice</h3><p>The 99.99 percent Service Commitment is a 10-times improvement over 99.9 percent. In a 30-day month, the allowable monthly downtime drops from about 43 minutes to about 4.3 minutes. For teams that set availability targets for their own applications, this gives a stronger baseline to plan against and to share with stakeholders.</p><h3 id=\"sec-4\">How Amazon Cognito measures availability</h3><p>The SLA measures availability separately for each AWS Region. Amazon Cognito divides each monthly billing cycle into 5-minute intervals and calculates the percentage of requests in each interval that don’t return an HTTP 500 or 503 error. Intervals with no requests count as 100 percent available. The Monthly Uptime Percentage is the average of these interval values over the billing cycle, minus downtime covered by the exclusions in the SLA. For the full definitions and exclusions, see the <span><a href=\"https://aws.amazon.com/cognito/sla/\"><u>Amazon Cognito SLA</u></a></span>.</p><h3 id=\"sec-5\">Historical availability over the past 12 months</h3><p>As we introduce the new SLA, we also looked back at the past 12 months to show how Amazon Cognito performed against the new Service Commitment. Table 3 shows monthly availability for Amazon Cognito user pools from November 2025 through October 2026.</p><p>Availability was at or above 99.99 percent in 10 of the 12 months. It was below 99.99 percent in January (99.988 percent) and March (99.979 percent), but stayed above the previous 99.9 percent Service Commitment in both months and was at or above 99.99 percent the following month.</p><p><b>Table 3: Amazon Cognito user pools monthly availability, November 2025 to October 2026</b></p><table> \n <tbody> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\"><b>Month</b></td> \n   <td colspan=\"1\" rowspan=\"1\"><b>Monthly availability</b></td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">November 2025</td> \n   <td colspan=\"1\" rowspan=\"1\">99.999%</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">December 2025</td> \n   <td colspan=\"1\" rowspan=\"1\">99.999%</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">January 2026</td> \n   <td colspan=\"1\" rowspan=\"1\">99.988%</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">February 2026</td> \n   <td colspan=\"1\" rowspan=\"1\">99.999%</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">March 2026</td> \n   <td colspan=\"1\" rowspan=\"1\">99.979%</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">April 2026</td> \n   <td colspan=\"1\" rowspan=\"1\">99.999%</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">May 2026</td> \n   <td colspan=\"1\" rowspan=\"1\">99.999%</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">June 2026</td> \n   <td colspan=\"1\" rowspan=\"1\">99.999%</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">July 2026</td> \n   <td colspan=\"1\" rowspan=\"1\">99.993%</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">August 2026</td> \n   <td colspan=\"1\" rowspan=\"1\">99.999%</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">September 2026</td> \n   <td colspan=\"1\" rowspan=\"1\">99.998%</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\">October 2026</td> \n   <td colspan=\"1\" rowspan=\"1\">99.997%</td> \n  </tr> \n </tbody> \n</table><p>We calculated availability for each Region using the Monthly Uptime Percentage method in the SLA, then combined the Regional results into one monthly figure weighted by each Region’s request volume. These are aggregate figures, so the availability an individual account experienced might differ.</p><h3 id=\"sec-6\">Switch to the Plus feature plan</h3><p>If your user pools use the Plus feature plan, the 99.99 percent Service Commitment applies to them starting November 1, 2026, with no action needed. If your user pools use Essentials or Lite feature plans, you can switch them to Plus in the AWS Management Console for Amazon Cognito or programmatically. Before you switch, see <span><a href=\"https://docs.aws.amazon.com/cognito/latest/developerguide/cognito-sign-in-feature-plans.html\"><u>user pool feature plans</u></a></span> and <span><a href=\"https://aws.amazon.com/cognito/pricing/\"><u>Amazon Cognito pricing</u></a></span> to compare features and costs. To learn more about the features that Plus adds, see the <span><a href=\"https://docs.aws.amazon.com/cognito/latest/developerguide/cognito-user-pool-settings-threat-protection.html\"><u>advanced security features with threat protection</u></a></span>.</p><p><b>To switch a user pool to the Plus feature plan (AWS Management Console):</b></p><ol> \n <li>Sign in to the <span><a href=\"https://console.aws.amazon.com/cognito/home\"><u>Amazon Cognito console</u></a></span>.</li> \n <li>Choose <b>User pools </b>and then choose your user pool.</li> \n <li>Choose <b>Settings</b>.</li> \n <li>Choose the <b>Feature plans</b> tab.</li> \n <li>Choose <b>Switch to Plus</b>.</li> \n <li>Review your choice and then choose <b>Confirm</b>.</li> \n</ol><p>\n <img src=\"/dailyinfo/media/9fe19b35f8b1dbaa.webp\" srcset=\"/dailyinfo/media/45146233f55c1ce5.webp 720w, /dailyinfo/media/5e753ece3cfe5460.webp 1200w, /dailyinfo/media/9fe19b35f8b1dbaa.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Figure 1: Amazon Cognito console Feature plans tab with the Switch to Plus button\" width=\"1758\" height=\"1088\">\n </p><p>Figure 1: Amazon Cognito console Feature plans tab with the Switch to Plus button</p><p><b>To switch a user pool to Plus feature plan (AWS CLI):</b></p><blockquote>\n <p><b>Important</b>: The <code>Update-user-pool</code> command and the <code>UpdateUserPool</code> API operation reset any parameter that you don’t include in the request to its default value. To avoid unintended changes to your user pool, retrieve your existing configuration first and include it in your update request.</p>\n</blockquote><ol> \n <li>Use the <span><a href=\"https://aws.amazon.com/cli\">AWS Command Line Interface (AWS CLI)</a></span> to retrieve your current user pool configuration with <span><a href=\"https://docs.aws.amazon.com/cli/latest/reference/cognito-idp/describe-user-pool.html\"><u>describe-user-pool</u></a></span>: \n  <pre class=\"language-text\"><code class=\"language-text\">aws cognito-idp describe-user-pool \\\n--user-pool-id &lt;your-user-pool-id&gt;\n</code></pre> \n      \n     \n    \n   </li> \n <li>Run the <span><a href=\"https://docs.aws.amazon.com/cli/latest/reference/cognito-idp/update-user-pool.html\"><u>update-user-pool</u></a></span> command, including your existing configuration parameters and the Plus tier: \n  <pre class=\"language-text\"><code class=\"language-text\">aws cognito-idp update-user-pool \\\n--user-pool-id &lt;your-user-pool-id&gt; \\\n--user-pool-tier PLUS \\\n&lt;your existing configuration parameters&gt;\n</code></pre> \n      \n     \n    \n   </li> \n</ol><p>If you use an AWS SDK, set <code>UserPoolTier</code> to PLUS in an <span><a href=\"https://docs.aws.amazon.com/cognito-user-identity-pools/latest/APIReference/API_UpdateUserPool.html\"><u>UpdateUserPool</u></a></span> request, and include your existing settings in the same way.</p><h3 id=\"sec-7\">Conclusion</h3><p>In this post, we shared the updated Service Commitment for Amazon Cognito user pools on the Plus feature plan, how availability is measured, and 12 months of historical data. Starting November 1, 2026, user pools on Plus are covered by a 99.99 percent Monthly Uptime Percentage Service Commitment, with no action required if you already use Plus. We plan to keep investing in the availability and resilience of Amazon Cognito.</p><p>To review the full terms, see the <span><a href=\"https://aws.amazon.com/cognito/sla/\"><u>Amazon Cognito SLA</u></a></span>. To learn more about the features in each plan, see <span><a href=\"https://docs.aws.amazon.com/cognito/latest/developerguide/cognito-sign-in-feature-plans.html\"><u>user pool feature plans</u></a></span> and <span><a href=\"https://docs.aws.amazon.com/cognito/latest/developerguide/cognito-user-pool-settings-threat-protection.html\"><u>advanced security features with threat protection</u></a></span>.</p><p>If you have questions about this post, contact <a href=\"https://aws.amazon.com/contact-us/\">AWS Support</a> or start a new thread on <a href=\"https://repost.aws/\">AWS re:Post</a>.</p><hr><p> \n   <img src=\"/dailyinfo/media/5d1a8c4f65538673.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Brian Song\" width=\"120\" height=\"160\">\n  </p><h3 id=\"sec-8\">Brian Song</h3><p>Brian is a Senior Product Manager at Amazon Web Services, where he’s passionate about making customer identity simple, secure, and dependable for builders of all sizes. Brian is usually planning his next trip, catching a live show, or first in line for a movie on opening night.</p><p> \n   <img src=\"/dailyinfo/media/0d598a9d73d9ad13.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Chris Simmons\" width=\"120\" height=\"160\">\n  </p><h3 id=\"sec-9\">Chris Simmons</h3><p>Chris is a Senior Software Manager at Amazon Web Services. When he’s not improving the security of the cloud, Chris enjoys running, martial arts, and old-school RPGs.</p>","zhKind","complete","标准","版本更新","云原生","AWS","https://aws.amazon.com/blogs/security/planning-for-99-99-percent-availability-with-the-amazon-cognito-plus-feature-plan/","AWS Security Blog",{"_122":123,"_124":-5},"changelogVersion","2026-10-01T08:00","release"]
