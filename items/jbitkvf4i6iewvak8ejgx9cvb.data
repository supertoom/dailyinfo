[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1795480836000,"id","jbitkvf4i6iewvak8ejgx9cvb","title","CISA 将 Apache Roller、Cisco Expressway、SAP NetWeaver 和 VMware vCenter 四项漏洞列入 KEV","originalTitle","Hackers Exploit Critical VMware, Cisco, and Apache Flaws as Espionage Attacks Emerge","summary","CISA 将 Apache Roller、Cisco Expressway、SAP NetWeaver 和 VMware vCenter 的 4 个漏洞列入 KEV，依据是已发现活跃利用证据。","reason","四条漏洞已进入 KEV，其中 Apache Roller、VMware vCenter 等已有利用线索，文中还给出了各漏洞的触发条件、修复时间与处置期限。","source",{"_70":97},"links",{"_86":96},"publishedAt","2026-11-21T08:49:13.000Z","discoveredAt","2026-11-21T09:24:45.971Z","timelineAt","category","vuln","tags",[90,71,91,92,93,74,94,95,80],"score",83,"selected",true,"channel","news","story","x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_59":85,"_86":-5,"_87":88,"_89":37},"outline",[],"relatedStories",[],"topics",[60,61,62,63,64,65,66,67],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_68":83,"_70":84},{"_68":81,"_70":82},{"_68":79,"_70":80},{"_68":77,"_70":78},{"_68":75,"_70":76},{"_68":73,"_70":74},{"_68":31,"_70":72},{"_68":69,"_70":71},"slug","exploited","name","在野利用","漏洞披露","vuln-mgmt","漏洞管理","black-market","数据窃取与黑产","ransomware","勒索软件","cisa","CISA","vmware","VMware / Broadcom","cisco","Cisco / 思科","<p><span><i></i><span>Ravie Lakshmanan</span><i></i><span>2026年11月21日</span></span><span>漏洞 / 企业安全</span></p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhFnWnBDigw8RogBTSInXktn1vUISbzwjHm5GuAFBNX0_ClLBk83WOa2BYiHUbgtva76TY8Oz2kJvEZtvEjqZlFFCuvQ-u-l-4l5dzo2MXw7zHLEuklv_Gn1mB-f5TL9GP_3n1NxQkzkZ-fAX7UpcqfZqUefQiRQZm21sq6IZOzmyuQ1hYs4AFHWQAj83WX/s1600/vmware-cisco.jpg\"><img alt=\"\" src=\"/dailyinfo/media/54133d79a6934e84.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>美国网络安全和基础设施安全局（CISA）于周五将影响 Apache Roller、Cisco Expressway、SAP NetWeaver 和 Broadcom VMware vCenter 的四个漏洞<a href=\"https://www.cisa.gov/news-events/alerts/2026/11/20/cisa-adds-four-known-exploited-vulnerabilities-catalog\">加入</a>其“已知被利用漏洞”（<a href=\"https://www.cisa.gov/known-exploited-vulnerabilities-catalog\">KEV</a>）目录，并援引了存在活跃利用活动的证据。</p><p>漏洞如下——</p><ul>\n  <li><strong>CVE-2026-129448</strong>（CVSS 评分：9.8）——Apache Roller 中存在一个不可信数据反序列化漏洞，未经验证的远程攻击者可通过 XML-RPC 端点执行任意代码；该端点会在身份验证之前接受并反序列化供应商扩展类型。（2026年11月修复）</li>\n  <li><strong>CVE-2026-76466</strong>（CVSS 评分：9.8）——Cisco Expressway Series 中存在一个硬编码凭据使用漏洞，拥有持久性 Cookie 和网络访问权限的未经验证远程攻击者，可通过数据库服务在集群设备上以 root 身份执行命令。（2026年10月修复）</li>\n  <li><strong>CVE-2025-42884</strong>（CVSS 评分：6.5）——SAP NetWeaver Enterprise Portal 中数据查询逻辑存在特殊元素清理不当漏洞，未经验证的攻击者可通过注入的 JNDI 环境属性或 JNDI 查找操作期间使用的 URL，泄露或修改服务器信息。（<a href=\"https://support.sap.com/en/my-support/knowledge-base/security-notes-news/bulletin-2025.html\">2025年11月</a>修复）</li>\n  <li><strong>CVE-2026-123890</strong>（CVSS 评分：9.8）——VMware vCenter 中存在一个使用替代路径或通道进行身份验证绕过的漏洞，拥有 vCenter 网络访问权限的未经验证攻击者可绕过身份验证并获得对系统的未授权访问。（2026年11月修复）</li>\n</ul><p>本周早些时候，Apache Roller 的维护者<a href=\"https://thehackernews.com/2026/11/critical-apache-roller-rce-flaw-under.html\">承认</a>“该问题正遭到积极利用”，但未透露其武器化方式，也未说明幕后是谁。截至撰稿时，似乎也没有公开报告记录 CVE-2025-42884 的活跃利用活动。</p><p>CVE-2026-76466 被加入 KEV 目录<a href=\"https://thehackernews.com/2026/11/hackers-exploit-critical-cisco.html\">源于</a> F6 的一份报告：在概念验证（PoC）利用程序发布后，该漏洞被用于入侵一家俄罗斯组织，使攻击者得以在网络中进行横向移动并访问敏感数据。目前尚未将该活动归因于任何威胁行为体。</p><p>另一方面，CVE-2026-123890 的利用活动已<a href=\"https://thehackernews.com/2026/11/china-linked-hackers-exploit-critical.html\">关联</a>到一个疑似具有中国背景的网络间谍组织，该组织被追踪为 Armory Castle（此前称为 UNC5221）。据称，该组织将其与 BeyondTrust Remote Support 中另一个现已修复的漏洞（CVE-2026-102764，CVSS 评分：9.3）结合利用，以部署自定义后门，实现持久访问和数据窃取。</p><p>根据具有约束力的操作指令（BOD）26-04《基于风险确定安全更新优先级》，联邦文职行政部门（FCEB）各机构已被敦促在2026年11月23日前修补全部四个漏洞。&nbsp;</p><p>觉得这篇文章有意思？在 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a> 上关注我们，查看我们发布的更多独家内容。</p>","original","zhKind","translation","complete","漏洞","补丁","漏洞利用","数据窃取","Cisco","VMware","https://thehackernews.com/2026/11/hackers-exploit-critical-vmware-cisco.html","The Hacker News",{"_99":100,"_101":-5},"changelogVersion","2026-10-01T08:00","release"]
