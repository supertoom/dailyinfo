[{"_1":2,"_3":4},"root",{"_5":95},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794271232000,"id","e7lcly2g4egsvihl038ydgvm2","title","York University 确认数据泄露，2007 至 2026 年表单中的个人信息被窃取","originalTitle","York University breach exposed personal information dating to 2007","summary","York University 确认威胁行为者入侵系统，窃取 14 个大学网站在线表单中的个人信息，受影响表单提交时间跨度为 2007 至 2026 年，事件于 10 月 25 日被发现。","reason","原文按数据类别列出了泄露范围，并说明学校已修复表单、通知高风险个人及提供两年信用监控，可用于评估个人数据处置需求。","source",{"_72":94},"links",{"_87":93},"publishedAt","2026-11-09T21:22:31.000Z","discoveredAt","2026-11-09T21:39:18.291Z","timelineAt","category","activity","tags",[73,91,75,92],"score",70,"selected",true,"channel","news","story",{"_77":78,"_13":79},"x","readingMode","full","author","Bill Toulas","body",{"_61":86,"_87":-5,"_88":89,"_90":37},"outline",[80],"relatedStories",[76],"topics",[68,69],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fdBtdrAiiiQI","reportCount",1,"additionalSourceCount",0,{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","attack","name","攻击活动","identity","身份与访问",{"_77":78,"_13":79},"publicId","7289f919-73aa-49b2-b559-306cda146590","约克大学确认14个网站表单数据泄露",{"_11":81,"_82":83,"_84":85},"sec-1","text","发现现有防御可能遗漏的电子邮件威胁。","level",2,"<p><img alt=\"York University breach exposed personal information dating to 2007\" height=\"900\" src=\"/dailyinfo/media/1ee553444a8eee5b.jpg\" srcset=\"/dailyinfo/media/416167821a7537e6.jpg 720w, /dailyinfo/media/c015a3fc791d415f.jpg 1200w, /dailyinfo/media/1ee553444a8eee5b.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>多伦多约克大学已确认，某个威胁行为者入侵了其系统，并访问了通过在线表单提交的个人信息。</p><p>此次未授权访问于 10 月 25 日被发现，影响了 14 个大学网站在 2007 年至 2026 年期间提交的表单。</p><p>约克大学是位于加拿大多伦多的一所大型大学，拥有超过 55,700 名学生，涵盖 200 个本科和研究生学位项目，行政人员规模达&nbsp;7,000 人。</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/064b9eb3f3737273.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>该<a href=\"http://www.yorku.ca/uit/infosec/incident-faq/\">大学周五表示</a>：“约克大学近期发生了一起网络安全事件，涉及未经授权的行为者访问大学各部门使用的部分在线表单。”</p><p>“约克大学在发现事件后迅速采取行动控制影响，但我们很遗憾地确认，部分院系表单中的个人信息遭到窃取。”</p><p>公告按类别详细列出了暴露的数据。&nbsp;攻击者通过受影响的表单访问了以下信息：</p><ul>\n\t<li>电子邮件地址</li>\n\t<li>电话号码</li>\n\t<li>出生日期</li>\n\t<li>约克大学识别号码</li>\n\t<li>政府身份证件信息&nbsp;</li>\n\t<li>第三方联系信息</li>\n\t<li>健康信息</li>\n\t<li>学业经历</li>\n\t<li>工作经历</li>\n\t<li>财务状况</li>\n\t<li>犯罪背景</li>\n\t<li>人口统计信息</li>\n\t<li>照片及其他图像</li>\n</ul><p>大学表示，暴露的数据类型因人而异，大多数被盗记录包含基本联系信息和约克大学识别号码。</p><p>在敏感数据之外暴露联系信息，会显著增加受影响人员遭遇网络钓鱼和社会工程攻击的风险。</p><p>公告称，这些网站表单现已安全，可以放心使用。&nbsp;约克大学表示，将直接通知政府身份证件或金融账户信息遭暴露的个人，并提供两年信用监测和身份盗窃保护服务。</p><p>未收到通知的个人可以直接联系大学，了解其个人具体遭遇了哪些类型的数据暴露。</p><p>截至目前，该教育机构尚未说明此次网络安全事件影响了多少人。</p><p>尚未提供有关作案者的任何细节。截至撰稿时，BleepingComputer 未发现任何声称对此次攻击负责的&nbsp;勒索软件团伙。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/fade1788f362b90e.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体会分析电子邮件意图、上下文和行为，发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>对 Microsoft 365 或 Google Workspace 进行为期 14 天的只读扫描，看看有哪些威胁正在穿透防御，且无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始免费的电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","数据泄露","凭据","https://www.bleepingcomputer.com/news/security/york-university-breach-exposed-personal-information-dating-to-2007/","BleepingComputer",{"_96":97,"_98":-5},"changelogVersion","2026-10-01T08:00","release"]
