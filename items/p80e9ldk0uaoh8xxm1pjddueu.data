[{"_1":2,"_3":4},"root",{"_5":100},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1794185105000,"id","p80e9ldk0uaoh8xxm1pjddueu","title","White House 所属 AS2650 发现住宅代理出口流量","originalTitle","White House Network Appears in Global Residential Proxy Traffic","summary","Layer3 在 AS2650 上发现住宅代理出口流量，该网络注册于负责 White House 网络的 Executive Office of the President。","reason","source",{"_74":99},"links",{"_61":98},"publishedAt","2026-11-06T22:17:34.000Z","discoveredAt","2026-11-07T04:32:32.760Z","timelineAt","category","disclosure","tags",[77,96,79,97,81],"score",58,"selected",false,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Pierluigi Paganini","body",{"_92":-5,"_61":93,"_94":-5,"_95":36},"outline",[86],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fi6vS9voXH_0","reportCount",4,"additionalSourceCount",3,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","blue-team","name","蓝队与运营","research","技术研究","botnet","僵尸网络","cloudflare","Cloudflare",{"_83":84,"_13":85},"publicId","36af3335-ef58-4707-9122-1260730671b0","白宫网络被检出住宅代理出口流量",{"_11":87,"_88":89,"_90":91},"sec-1","text","Layer3 found residential proxy traffic using the White House network, raising co","level",2,"zh","<h2 id=\"sec-1\">Layer3 found residential proxy traffic using the White House network, raising concerns about potential exposure of internal systems.</h2><p>Layer3 Intel says it found residential proxy traffic leaving through the White House network. The researchers spotted it while browsing their new Residential Proxy Observatory, a tool that gives a global view of residential proxy and anonymized internet activity. </p><p>“While our team was looking through it, we noticed residential proxy exit activity on <a href=\"https://layer3intel.com/context/AS2650\">AS2650</a>. AS2650 is registered to the Executive Office of the President, the federal agency that hosts the White House network.” reads the <a href=\"https://layer3intel.com/blog/residential-proxies-white-house-network\">report</a> published by Layer3.</p><p>A residential proxy service allows customers to use everyday devices to route their internet traffic. This makes their activity look as if it comes from the device’s normal home internet connection. Layer3 detected this activity on AS2650, a network registered to the Executive Office of the President, the agency responsible for the White House network. Layer3 has not accused anyone at the White House of wrongdoing and says its data cannot identify who or what caused the activity.</p><p>Between October 5 and November 3, Layer3 detected 236 connections through this network. The traffic came from six IP addresses and was recorded on 26 of those 30 days. A total of 28 residential proxy services were able to use the network. To check their findings, researchers compared the IP addresses with data from other security services, including Spur and Synthient. Both services also identify these addresses as residential proxy exit points.</p><figure><a href=\"https://i0.wp.com/securityaffairs.com/wp-content/uploads/2026/11/image-12.png?ssl=1\"><img width=\"1024\" height=\"281\" src=\"/dailyinfo/media/a1395c5681ce71b8.webp\" srcset=\"/dailyinfo/media/da52fce7c2792015.webp 720w, /dailyinfo/media/3974fdb05fcb7ef2.webp 1200w, /dailyinfo/media/a1395c5681ce71b8.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"proxy traffic using the White House network\"></a></figure><p>Getting this data took no special skill. Anyone can sign up to a public residential proxy service, pay a few dollars and send requests through it. Layer3 says it didn’t target the network or try to steer its probes there, and it caught the activity by chance, simply by requesting global rotating access through these services.</p><p>The timing suggests something more than a guest network. About half the activity falls between 5 p.m. and midnight Eastern time, and almost none happens in the early morning. Layer3 reads that as a person, not public guest Wi-Fi: someone regularly on the White House network late into the evening whose device carries a proxy SDK, a software kit that turns a device into an exit point.</p><p><em>“Past research has shown that poorly secured proxy SDKs can allow internal network access and lateral movement. This is how past botnets have spread. In <a href=\"https://synthient.com/blog/a-broken-system-fueling-botnets\">A Broken System Fueling Botnets</a>, the researchers at Synthient documented how the Kimwolf botnet reached at least 2 million devices, mostly Android devices with an exposed ADB service, through residential proxy networks.” continues the report. “If an SDK on this network has the same kind of flaw, anyone buying proxy access could use it to reach internal systems.”</em></p><p>That matters because poorly secured proxy SDKs have let attackers into internal networks before. Synthient’s research, <a href=\"https://synthient.com/blog/a-broken-system-fueling-botnets\">A Broken System Fueling Botnets</a>, documented how the <a href=\"https://securityaffairs.com/tag/kimwolf-botnet\">Kimwolf botnet</a> reached at least 2 million devices, mostly Android devices with an exposed ADB service, through residential proxy networks. If an SDK on the White House network has the same kind of flaw, anyone buying proxy access could reach internal systems. Layer3 doesn’t claim that’s the case here, and it describes the risk as conditional.</p><p>The White House isn’t the only surprise. The observatory also finds residential proxies in some of the most isolated places on the planet. Saint Helena, Ascension and Tristan da Cunha, a South Atlantic territory that includes the most remote inhabited island in the world, shows 413 addresses and more than 32,000 observations, split between Starlink and the local provider, Sure Saint Helena.</p><p>Layer3 also detected three instances of proxy activity in Antarctica. All came from a Cloudflare WARP address linked to McMurdo Station. The researchers jokingly noted that penguins are not suspects. On Pitcairn Island, they found one Starlink address and one observation. Norfolk Island had one Norfolk Telecom address with four observations, while Svalbard had one Starlink address in Longyearbyen with three observations.</p><p>The researchers also found 388 addresses in the Falkland Islands, 43 in the Chagos Islands, 21 in Tokelau and seven in South Georgia. These findings suggest that residential proxy networks now operate in almost every corner of the world. For security teams, the main concern is that devices connected to protected networks could unknowingly become proxy exit points, potentially exposing those networks to outside traffic.</p><p>However, Layer3 says its data only shows where proxy traffic exits. It cannot identify the device being used or the person behind it. As the company explains, “Our data shows the exits, not the device or the person behind them.”</p><p><em>“Residential proxies have infected every corner of the world, and it looks like there is no place they cannot reach. Layer3 Intel tracks residential proxy and anonymization infrastructure worldwide. Even when the proxies hide in networks on the farthest corners of the planet, we can still observe them, leaving threat actors no place to hide.” concludes the report.</em></p><p><strong>Follow me on Twitter:&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a><strong></strong></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;hacking,&nbsp;proxy traffic)</strong></p>","zhKind","complete","检测工程","网络设备","https://securityaffairs.com/202563/security/white-house-network-appears-in-global-residential-proxy-traffic.html","Security Affairs",{"_101":102,"_103":-5},"changelogVersion","2026-10-01T08:00","release"]
