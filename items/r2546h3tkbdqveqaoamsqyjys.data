[{"_1":2,"_3":4},"root",{"_5":122},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1794616833000,"id","r2546h3tkbdqveqaoamsqyjys","title","Microsoft FORGE Lab 复盘 AI 扫描发现 59 个 Linux 内核漏洞","originalTitle","Lessons from 59 Linux Kernel Bug Reports","summary","Microsoft FORGE Lab 使用代号 MDASH 的 AI 扫描系统研究 Linux 内核，3 个月产出 59 个公开上游报告和 33 个已分配 CVE，其中 8 个 CVE 已验证本地提权利用，38 个报告的修复已合并主线。","reason","文章完整呈现了 AI 扫描结果如何经过筛选、PoC 验证、人工复核和上游协作转化为漏洞报告与补丁，为评估 AI 辅助漏洞发现的实际效率提供了可复用的流程样本。","source",{"_67":121},"links",{"_112":120},"publishedAt","2026-11-11T16:55:00.000Z","discoveredAt","2026-11-11T19:16:12.977Z","timelineAt","category","ai-security","tags",[68,72,116,117,118,70,119],"score",74,"selected",true,"channel","news","story","x","readingMode","full","author","FORGE Lab and Cen Zhang","body",{"_59":111,"_112":-5,"_113":114,"_115":37},"outline",[79,80,81,82,83,84,85,86,87],"relatedStories",[],"topics",[60,61,62,63,64,65],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_66":77,"_67":78},{"_66":75,"_67":76},{"_66":73,"_67":74},{"_66":71,"_67":72},{"_66":69,"_67":70},{"_66":31,"_67":68},"slug","name","AI 安全","research","技术研究","ai-offense","AI 攻防","ai-agent","AI Agent 安全","kernel","内核与系统","microsoft","Microsoft / 微软",{"_11":109,"_89":110,"_91":92},{"_11":107,"_89":108,"_91":95},{"_11":105,"_89":106,"_91":95},{"_11":103,"_89":104,"_91":95},{"_11":101,"_89":102,"_91":92},{"_11":98,"_89":99,"_91":100},{"_11":96,"_89":97,"_91":95},{"_11":93,"_89":94,"_91":95},{"_11":88,"_89":90,"_91":92},"sec-9","text","结语","level",2,"sec-8","从套接字列表到内核写入",4,"sec-7","遗漏的重置","sec-6","深入了解 CVE-2026-64563",3,"sec-5","精选发现","sec-4","这些漏洞存在了多久","sec-3","推动修复合并","sec-2","621 个案例的去向","sec-1","从扫描到报告","<ol><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/11/lessons-from-59-linux-kernel-bug-reports/#from-scans-to-reports\">从扫描到报告</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/11/lessons-from-59-linux-kernel-bug-reports/#selected-findings\">精选发现</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/11/lessons-from-59-linux-kernel-bug-reports/#closing-thoughts\">结语</a></li></ol><p>在<a href=\"https://forge-blog.github.io/posts/linux-kernel-3-month-lookback/\">Microsoft 的 FORGE Lab</a>，我们使用代号 MDASH 扫描了 Linux 内核若干子系统的部分代码，时间从 2026 年 5 月下旬持续到 6 月中旬。这项为期三个月的工作由一名全职研究员和一名实习生主导，截至目前已产出<a href=\"https://lore.kernel.org/all/?q=mid%3A20261013051553.71887-1-cenzhang%40linux.microsoft.com+OR+mid%3A20261012215703.30592-1-cenzhang%40linux.microsoft.com+OR+mid%3A20260925024408.32143-1-cenzhang%40linux.microsoft.com+OR+mid%3A20260925015251.21168-1-cenzhang%40linux.microsoft.com+OR+mid%3A20260901183151.16648-1-cenzhang%40linux.microsoft.com+OR+mid%3A20260818164825.63967-1-blbllhy%40gmail.com+OR+mid%3A20260827051859.45511-1-blbllhy%40gmail.com+OR+mid%3A20260819145658.29872-1-blbllhy%40gmail.com+OR+mid%3A20260826154456.85974-1-blbllhy%40gmail.com+OR+mid%3A20260901182136.13745-1-cenzhang%40linux.microsoft.com+OR+mid%3A20260901180600.10394-1-cenzhang%40linux.microsoft.com+OR+mid%3A20260901175834.8557-1-cenzhang%40linux.microsoft.com+OR+mid%3A20260901174934.6275-1-cenzhang%40linux.microsoft.com+OR+mid%3A20260828041925.36758-1-blbllhy%40gmail.com+OR+mid%3A20260821182449.79785-2-blbllhy%40gmail.com+OR+mid%3A20260821182449.79785-3-blbllhy%40gmail.com+OR+mid%3A20260820200245.44312-1-blbllhy%40gmail.com+OR+mid%3A20260820010617.46851-1-blbllhy%40gmail.com+OR+mid%3A20260816035205.57966-1-blbllhy%40gmail.com+OR+mid%3A20260825052404.45665-3-blbllhy%40gmail.com+OR+mid%3A20260822045407.28983-1-blbllhy%40gmail.com+OR+mid%3A20260819014858.76707-1-blbllhy%40gmail.com+OR+mid%3A20260817013237.2797-1-blbllhy%40gmail.com+OR+mid%3A20260816173713.28998-1-blbllhy%40gmail.com+OR+mid%3A20260722193719.81157-1-blbllhy%40gmail.com+OR+mid%3A20260717210143.4734-1-blbllhy%40gmail.com+OR+mid%3A20260724164719.99563-1-blbllhy%40gmail.com+OR+mid%3A20260721143602.64677-1-blbllhy%40gmail.com+OR+mid%3A20260719232153.1405569-1-xmei5%40asu.edu+OR+mid%3A20260706212556.3199234-1-xmei5%40asu.edu+OR+mid%3A20260720204430.1886091-1-xmei5%40asu.edu+OR+mid%3A20260720223400.1939998-1-xmei5%40asu.edu+OR+mid%3A20260720034514.23053-1-blbllhy%40gmail.com+OR+mid%3A20260723000016.84091-1-blbllhy%40gmail.com+OR+mid%3A20260722223832.3524006-1-xmei5%40asu.edu+OR+mid%3A20260722004818.72310-1-blbllhy%40gmail.com+OR+mid%3A20260720155210.34229-1-blbllhy%40gmail.com+OR+mid%3A20260722002951.2614721-1-xmei5%40asu.e\">59 份公开的上游报告</a>和<a href=\"https://github.com/microsoft/forge-lab/blob/main/blog/content/posts/linux-kernel-3-month-lookback/cves.txt\">33 个已分配的 CVE</a>。我们确认了其中 8 个 CVE 的有效 root 权限提升利用，并且我们 38 份报告的修复已合并到主线。</p><p>发现漏洞只是这项工作的一部分。初始扫描在约两周内产生了 26,502 条原始发现，但将这些结果转化为可复现漏洞、上游报告和补丁，需要专家投入数月时间进行调查，并与 Linux 维护者协作。</p><p>在这篇文章中，我们回顾了如何从数千个潜在发现推进到经验证的漏洞和上游修复，以及我们在使用 AI 扩展漏洞发现规模方面的经验。</p><h2 id=\"sec-1\">从扫描到报告</h2><p>我们重点关注了若干核心内核子系统，例如网络、文件系统和安全模块。我们的选择标准很直接：选取对安全敏感且不明显依赖专用硬件的组件，从而让基于 QEMU 的验证过程简单且统一。代码扫描主要使用 Sonnet 4.6（占代码扫描令牌的 71.1%）、GPT-5.4（20.1%）和 GPT-5.5（7.1%）。</p><p>代号 MDASH 的扫描在约两周内于两台服务器上产生了 26,502 条原始扫描发现（64 核/256 GB RAM 和 32 核/128 GB RAM），但将这些输出转化为补丁和报告需要专家数月的工作。我们利用代号 MDASH 的置信度级别，以及自行构建的独立快速筛查代理，过滤掉低置信度的主张，将候选数量缩减至 11,769 个。随后，PoC 生成代理尝试在 QEMU 中复现，主要使用 GPT-5.5（占复现令牌的 77.3%）、Opus 4.6（13.2%）和 GPT-5.5-cyber（9.4%）。接着，专家审查了 621 个具有 PoC 证据的案例，以确定根因、合并重复项并准备上游提交。</p><figure><img src=\"/dailyinfo/media/33db36bff0179769.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption><em>图 1 . 从扫描到报告的工作流程。26,502 条原始发现 → 11,769 个经筛查的候选 → 621 个有 PoC 支持的案例 → 59 份上游报告。</em></figcaption></figure><h4 id=\"sec-2\">621 个案例的去向</h4><p>平均每 10 个有 PoC 支持的案例最终产生约 1 份公开的上游报告：621 个案例产出 59 份报告（9.5%）。在这些案例中，未单独提交新报告的主要原因是：</p><ul>\n<li><strong>266 个（42.8%）</strong>与另一个案例存在相同的根因，因此可以通过一个补丁一并修复。</li>\n\n\n\n<li><strong>163 个（26.2%）</strong>经审查后未予报告，主要是因为安全影响有限。</li>\n\n\n\n<li><strong>133 个（21.4%）</strong>此前已被报告或已在上游修复。</li>\n</ul><p>提交时间可以解释这 133 个重叠案例中的许多情况。扫描完成时，621 个案例中的大多数都是新发现的（不过其中一些可能已由他人提交处理）。我们的<a href=\"https://lore.kernel.org/all/20260627024023.2201160-1-xmei5@asu.edi/\">首份公开报告</a>于 2026 年 6 月 27 日发布，比扫描开始晚了五周多。截至 9 月 1 日，59 份报告中的 55 份已发布到公开邮件列表；其余 4 份在同一时间窗口内进行了私密报告，并已于 10 月中旬转交至公开邮件列表。</p><h4 id=\"sec-3\">推动修复合并</h4><p>上游 Linux 通常要求漏洞报告附带可用的补丁。智能代理帮助起草了初始修复方案，但人工验证、理解相关子系统，以及在审查期间与维护者反复协作仍然至关重要。到目前为止，我们报告中的 38 个修复已被合并到上游主线，其中一半在首次提交时即被合并，其余则经过一至四次修订。从首次公开补丁到进入主线发布版本，耗时中位数为 41 天（最长 108 天）；我们仍在与其余报告的维护者协作。</p><h4 id=\"sec-4\">这些漏洞存在了多久</h4><p>值得注意的是，我们报告的大多数漏洞都已在内核中存在多年。在 59 份报告中，我们首次公开报告时，这些漏洞的平均存续时间为 8.1 年。其中最久的一个是 <a href=\"https://lore.kernel.org/all/20260720034514.23053-1-blbllhy@gmail.com/\">cls_u32 移位越界漏洞（CVE-2026-74544）</a>，至少已经存在了 21 年。</p><figure><img src=\"/dailyinfo/media/1e5f1468feb35e13.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption><em>图 2．所报告内核漏洞的存续时间，从引入漏洞的提交（修复补丁中的 Fixes 标签）计算到我们首次公开报告为止。59 份报告的平均存续时间为 8.1 年；其中六个漏洞已有 15–19 年历史，三个至少有 20 年历史。</em></figcaption></figure><h2 id=\"sec-5\">精选发现</h2><p>在这批漏洞迄今分配的 33 个 CVE 中，有 24 个被评为 High 或更高等级（CVSS v3.1 分数至少为 7.0）。以下是八个 CVE；我们在受控实验室环境中确认了可实现本地 root 权限提升的漏洞利用，其中一些情况需要使用非默认设置或禁用漏洞利用缓解措施：</p><figure><table><thead><tr><td><strong>CVE-2026-…</strong></td><td><strong>模块</strong></td><td><strong>摘要</strong></td></tr></thead><tbody><tr><td><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-64554\">64554</a></td><td>net/ipv6</td><td><a href=\"https://lore.kernel.org/all/20260706232850.3333016-1-xmei5@asu.edu/\"><strong>桥接 IPv6 分片中的释放后重用</strong>：指向数据包的已保存指针在数据包缓冲区重新分配后被再次使用。</a></td></tr><tr><td><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-64563\">64563</a></td><td>lib/rhashtable</td><td><a href=\"https://lore.kernel.org/all/CAB8m9Wh559e+=n8z51gB8DrbEyCc2mc0MgGjrRR6_VXBmU=2AQ@mail.gmail.com/\"><strong>遍历哈希表时的释放后重用</strong>：在表扩容后恢复遍历时，重用了指向可能已释放条目的指针。</a></td></tr><tr><td><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-64580\">64580</a></td><td>net/ipv6</td><td><a href=\"https://lore.kernel.org/all/20260702010516.221830-1-xmei5@asu.edu/\"><strong>IPv6 IPsec 路由中的引用计数下溢</strong>：错误处理路径释放了一次设备引用，却保留了指针，因此清理时又释放了一次。</a></td></tr><tr><td><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-74561\">74561</a></td><td>net/ipv4</td><td><a href=\"https://lore.kernel.org/all/20260722002951.2614721-2-xmei5@asu.edu/\"><strong>下一跳替换中的释放后重用</strong>：路由缓存刷新时未持有锁便遍历 IPv6 路由列表，与路由删除形成竞态。</a></td></tr><tr><td><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-74562\">74562</a></td><td>net/ipv4</td><td><a href=\"https://lore.kernel.org/all/20260722002951.2614721-1-xmei5@asu.edu/\"><strong>下一跳替换中的释放后重用</strong>：路由检查和通知操作未持有锁便遍历 IPv6 路由列表，与路由删除形成竞态。</a></td></tr><tr><td><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-89789\">89789</a></td><td>drivers/net</td><td><a href=\"https://lore.kernel.org/all/20260819014858.76707-1-blbllhy@gmail.com/\"><strong>GTP 隧道驱动程序中的释放后重用</strong>：设备创建失败时，其查找表被释放，但传入的数据包仍可能读取这些表。</a></td></tr><tr><td><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-98222\">98222</a></td><td>security/keys</td><td><a href=\"https://lore.kernel.org/all/20260826154456.85974-1-blbllhy@gmail.com/\"><strong>加密密钥更新中的堆缓冲区溢出</strong>：较长的密钥参数导致 16 位长度溢出，因此内核写入超出了尺寸不足的缓冲区。</a></td></tr><tr><td><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-98364\">98364</a></td><td>net/xfrm</td><td><a href=\"https://lore.kernel.org/all/20260820200245.44312-1-blbllhy@gmail.com/\"><strong>IPsec 路由中的释放后重用</strong>：使用网络设备时未持有引用，因此在同时删除该设备的情况下，可能在使用过程中将其释放。</a></td></tr></tbody></table></figure><h3 id=\"sec-6\">深入了解 CVE-2026-64563</h3><p><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-64563\">CVE-2026-64563</a> 是 rhashtable（Linux 内核共享的可扩展哈希表）中的一行状态重置漏洞。由于调用方信任遍历表时返回的对象指针，这一小型的库缺陷使得在 Linux 上稳定实现本地权限提升成为可能；该漏洞也影响启用了 SELinux 强制模式的 Android，并且无需特殊的内核配置或用户命名空间。</p><p>许多内核子系统会将活动对象（例如<a href=\"https://github.com/torvalds/linux/blob/dc59e4fea9d83f03bad6bddf3fa2e52491777482/net/netlink/af_netlink.h#L24-L52\">套接字</a>）存储在<a href=\"https://github.com/torvalds/linux/blob/dc59e4fea9d83f03bad6bddf3fa2e52491777482/include/linux/rhashtable.h#L31-L65\">rhashtable</a>中，并在用户空间要求列出这些对象时遍历该表。由于大型列表可能会拆分到多个响应中，一次遍历可以暂停并恢复。其<a href=\"https://github.com/torvalds/linux/blob/dc59e4fea9d83f03bad6bddf3fa2e52491777482/include/linux/rhashtable-types.h#L129-L136\">迭代器</a>会保存停止的位置，包括指向最后访问条目的指针（iter-&gt;p）。然而，在遍历暂停期间，该表仍可能发生变化：条目可以被移除并释放，调整大小也可能替换底层的桶表。</p><h4 id=\"sec-7\">遗漏的重置</h4><p>在 2018 年之前，<a href=\"https://github.com/torvalds/linux/blob/b41cc04b662ac96bbb291fb66b7b8aab5bc0a8c9/lib/rhashtable.c#L902-L925\">rhashtable_walk_stop()</a>总是在暂停时将 iter-&gt;p 清空为 NULL。为提高遍历在停止/启动周期之间的稳定性，一项<a href=\"https://github.com/torvalds/linux/commit/5d240a8936f6a1d3ece06701e8c4d830a2eca8a8\">2018 年提交（5d240a8936f6）</a>在 walk_stop() 之后保留 iter-&gt;p，并将重置操作移入 <a href=\"https://github.com/torvalds/linux/blob/dc59e4fea9d83f03bad6bddf3fa2e52491777482/lib/rhashtable.c#L862-L922\">rhashtable_walk_start_check()</a>——但只在其两条恢复路径中的一条上执行：</p><p><strong>调整大小释放旧表（iter-&gt;walker.tbl == NULL）</strong>：<a href=\"https://github.com/torvalds/linux/blob/dc59e4fea9d83f03bad6bddf3fa2e52491777482/lib/rhashtable.c#L877-L882\">第 877–882 行</a>切换到新表，重置槽位并跳过，然后提前返回 -EAGAIN，而未清除 iter-&gt;p：</p><p><strong>旧表仍然存在（iter-&gt;walker.tbl != NULL）</strong>：<a href=\"https://github.com/torvalds/linux/blob/dc59e4fea9d83f03bad6bddf3fa2e52491777482/lib/rhashtable.c#L884-L919\">第 884–919 行</a>扫描 iter-&gt;p 所在的桶链；如果该条目已被移除，则重置 iter-&gt;p = NULL。</p><pre>if (!iter-&gt;walker.tbl) {\n\titer-&gt;walker.tbl = rht_dereference_rcu(ht-&gt;tbl, ht);\n\titer-&gt;slot = 0;\n\titer-&gt;skip = 0;\n\treturn -EAGAIN;\n}\n</pre><p>此后再次启动时，下一次调用 <a href=\"https://github.com/torvalds/linux/blob/dc59e4fea9d83f03bad6bddf3fa2e52491777482/lib/rhashtable.c#L1007-L1035\">rhashtable_walk_next()</a>会发现 iter-&gt;p 仍被设置，并沿 iter-&gt;p-&gt;next 继续，而不是从 slot = 0 重新开始。如果该条目在遍历暂停期间已被释放，对 iter-&gt;p-&gt;next 的解引用就会读取已释放的内存。</p><p>为什么这个漏洞八年都未被发现？触发它需要在同一次遍历中同时满足三个条件：调用方必须跨 walk_stop() 和 walk_start() 暂停并恢复同一个迭代器；表必须在暂停期间调整大小并释放旧桶表；iter-&gt;p 处的条目也必须在遍历恢复前被移除并释放。大多数 rhashtable 遍历器会在单次遍历中完成，从不恢复已停止的迭代器；即使调用方确实会暂停并恢复，这三个事件在正常工作负载中也很少偶然同时发生。</p><p><a href=\"https://github.com/torvalds/linux/commit/8173f7e2ce67e6ca1d4763f3da14e5b01ce77456\">上游修复</a>只是在返回前清除失效指针：</p><pre>+\t\titer-&gt;p = NULL;\n</pre><h4 id=\"sec-8\">从套接字列表到内核写入</h4><p>由于 rhashtable 是一个共享库，其调用方既决定该漏洞是否可被触达，也决定其安全影响的严重程度。在整个内核中，大约有二十几个文件使用 rhashtable 遍历器 API，其中大多数会在单次遍历中遍历该表并立即退出。在这些调用方中，我们发现了两个会跨批次暂停并恢复迭代器、且至少能够导致崩溃的调用方：<a href=\"https://github.com/torvalds/linux/blob/dc59e4fea9d83f03bad6bddf3fa2e52491777482/net/tipc/socket.c#L3555-L3588\">TIPC 的套接字转储</a>（tipc_nl_sk_walk()）和 <a href=\"https://github.com/torvalds/linux/blob/dc59e4fea9d83f03bad6bddf3fa2e52491777482/net/netlink/diag.c#L120-L147\">Netlink 的套接字诊断</a>（__netlink_diag_dump()）。</p><p>两者之中，<a href=\"https://github.com/torvalds/linux/blob/dc59e4fea9d83f03bad6bddf3fa2e52491777482/net/netlink/diag.c#L89-L152\">__netlink_diag_dump()</a>是可利用的调用方。在标准内核上，非特权用户可以触达它，并且用户空间可以控制转储响应之间的暂停（通过 recvmsg()）。攻击者可以让转储保持暂停，同时调整表的大小并释放 iter-&gt;p 处的套接字，然后重新分配该内存以控制 iter-&gt;p-&gt;next，从而使 <a href=\"https://github.com/torvalds/linux/blob/dc59e4fea9d83f03bad6bddf3fa2e52491777482/lib/rhashtable.c#L1014-L1024\">rhashtable_walk_next()</a> 返回伪造的套接字指针 sk。</p><p>__netlink_diag_dump() 随后检查 net_eq(sock_net(sk), net)，并将 sk 传递给 <a href=\"https://github.com/torvalds/linux/blob/dc59e4fea9d83f03bad6bddf3fa2e52491777482/net/netlink/diag.c#L57-L68\">sk_diag_fill()</a> 和 <a href=\"https://github.com/torvalds/linux/blob/dc59e4fea9d83f03bad6bddf3fa2e52491777482/net/core/sock_diag.c#L26-L63\">sock_diag_save_cookie()</a>；后者会在 sk-&gt;sk_cookie 为零时对其初始化。这会将伪造的 sk 指针转化为一次受约束的 64 位写入（当目标 8 字节为零且 sk-&gt;sk_net 与 &amp;init_net 匹配时）。结合其他通用漏洞利用技术，这次写入足以实现本地权限提升。</p><p>我们感谢 NebuSec 的 Yuan Tan，他也独立发现了此漏洞。他迅速向我们和维护者分享了其真实严重程度，这有助于推动上游修复，之后还向我们提供了适用于 Linux 和 Android 的可用漏洞利用程序。我们也感谢 NebuSec 的 Frank Wu，他找到了一种可行的漏洞利用原语，并开发出了可用的权限提升漏洞利用程序。</p><h2 id=\"sec-9\">结语</h2><p>发现漏洞与修复漏洞之间的平衡严重失衡。通过代号 MDASH 扫描两周，我们获得了初步发现，并将其范围缩小到 621 个有 PoC 支持的案例。但报告其中 59 个案例耗费了四个多月，而五个月后已有 38 个修复被合并。对于 Linux 内核这类复杂基础设施而言，仍需让人类参与其中，因此人力成为了瓶颈。漏洞猎手和维护者都可能因大量真实发现而不堪重负，所以专注于真正的高严重性问题至关重要。</p><p>更多 token 可能带来更多漏洞，但并不意味着系统就会安全。我们只扫描了内核的一小部分，进一步调优和增加 token 可能发现多得多的漏洞。但即使修复了所有漏洞，系统就安全了吗？在 Microsoft FORGE Lab，我们正使用 AI 扩大漏洞研究的范围，但我们的经验表明，发现漏洞只是工作的一部分。更紧迫的问题是如何构建实用、可运营、可累积且经济上合理的安全解决方案。</p><p>这些经验也适用于我们的研究之外。通过与构建代号 MDASH 的工程团队密切协作，我们正将从现实世界漏洞发现与验证中学到的经验用于指导这些能力的演进。目标是让 AI 赋能的安全研究成果为安全团队所用，帮助他们更有效地识别并处理关键漏洞。</p><p>文章 <a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/11/lessons-from-59-linux-kernel-bug-reports/\">Lessons from 59 Linux Kernel Bug Reports</a> 最早发布于 <a href=\"https://www.microsoft.com/en-us/security/blog\">Microsoft Security Blog</a>。</p>","original","zhKind","translation","complete","大模型","漏洞分析","内核","Microsoft","https://www.microsoft.com/en-us/security/blog/2026/11/11/lessons-from-59-linux-kernel-bug-reports/","Microsoft Security Blog",{"_123":124,"_125":-5},"changelogVersion","2026-10-01T08:00","release"]
