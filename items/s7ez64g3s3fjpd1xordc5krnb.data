[{"_1":2,"_3":4},"root",{"_5":109},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795567288000,"id","s7ez64g3s3fjpd1xordc5krnb","title","ShinyHunters 勒索组织声称在成员被捕后回归，并以历史 PGP 密钥验证身份","originalTitle","ShinyHunters claims to return after FBI arrests, uses old PGP keys as proof","summary","ShinyHunters 勒索组织在成员连续被捕后，于 November 23 启动新的 Tor 数据泄露网站并声称回归。新站点使用两把创建于 2020 年的历史 PGP 密钥签署验证消息，BleepingComputer 确认签名有效，但这些密钥曾在多人之间传播，无法证明原运营者回归或排除冒充者。","reason","source",{"_75":108},"links",{"_61":107},"publishedAt","2026-11-24T16:30:19.000Z","discoveredAt","2026-11-24T16:37:33.158Z","timelineAt","category","activity","tags",[76,102,103,104,105,106],"score",54,"selected",false,"channel","news","story",{"_86":87,"_13":88},"x","readingMode","full","author","Lawrence Abrams","body",{"_98":-5,"_61":99,"_100":-5,"_101":36},"outline",[89,90],"relatedStories",[85],"topics",[68,69,70,71,72],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fyJUpBpJrNeE","reportCount",1,"additionalSourceCount",0,{"_73":83,"_75":84},{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","attack","name","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","crypto","密码学","oracle","Oracle / 甲骨文",{"_86":87,"_13":88},"publicId","d6d134e6-c0ab-42e6-afc4-e434d3285f64","ShinyHunters宣称回归并启用新泄露站",{"_11":96,"_92":97,"_94":95},{"_11":91,"_92":93,"_94":95},"sec-2","text","Uncover email threats your existing defenses may miss.","level",2,"sec-1","Old PGP keys used to authenticate new site","zh","<p><img alt=\"ShinyHunters\" height=\"900\" src=\"/dailyinfo/media/29f6118e74aa43ec.jpg\" srcset=\"/dailyinfo/media/099a49affa7e715c.jpg 720w, /dailyinfo/media/93fd5dfddc2c97b9.jpg 1200w, /dailyinfo/media/29f6118e74aa43ec.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>The ShinyHunters extortion gang claims to have returned in posts on a new data leak site after a series of arrests over the past two months targeting alleged members.</p><p>The new Tor site, launched on November 23, contains messages in both Russian and English announcing the group's return, distancing itself from alleged impostors, and denouncing a former member who was reportedly arrested and is cooperating with law enforcement.</p><p>The site also includes two verification messages signed using historical ShinyHunters PGP keys dating back to 2020, including one previously used to authenticate communications with BleepingComputer in August 2025.</p><p><a href=\"https://www.wiz.io/lp/claude-code-security-best-practices-cheat-sheet?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q3_INB_FORM_Claude-Code-Security-Best-Practices&amp;sfcid=701Vh00000gJQZuIAO&amp;utm_term=FY27Q4-bleepingcomputer-article-970x250-Nov&amp;utm_content=Claude-Code-Best-Practices\"><img src=\"/dailyinfo/media/d1878a942593a18c.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>BleepingComputer confirmed that both messages were signed using known PGP keys associated with the ShinyHunters extortion gang, confirming that the new operators have access to private signing keys historically used by the group.</p><p>However, these keys do not confirm whether the individuals behind the new operation are the same people who previously controlled the group, as the keys have circulated among numerous people.</p><p>The announcement follows a series of law enforcement operations targeting alleged ShinyHunters members after the group <a href=\"https://www.bleepingcomputer.com/news/security/shinyhunters-claims-fbi-hack-data-theft-in-peoplesoft-zero-day-breach/\">claimed to have breached FBI systems</a> in September using an Oracle PeopleSoft vulnerability.</p><p>Later that month, <a href=\"https://www.bleepingcomputer.com/news/security/dutch-police-confirm-arrest-in-shinyhunters-hacking-investigation/\">Dutch police confirmed the arrest</a> of a 24-year-old Amsterdam man suspected of involvement with ShinyHunters, who was identified in media reports as Pepijn van der Stap, previously known online as Umbreon.</p><p>In early October, <a href=\"https://www.bleepingcomputer.com/news/security/shinyhunters-hacker-reportedly-detained-in-jordan-aiding-fbi/\">another alleged ShinyHunters member</a> known as Rey or Saif was reportedly detained in Jordan and is cooperating with law enforcement. Around the same time, <a href=\"https://www.bleepingcomputer.com/news/security/cyber-exec-arrested-in-case-allegedly-tied-to-shinyhunters-hackers/\">Canadian cybersecurity executive Edward Dubrovsky was arrested</a> in Pennsylvania in an extortion investigation reportedly linked to ShinyHunters.</p><p>After the arrests, ShinyHunters' main representative, who had regularly communicated with BleepingComputer and other media outlets, abruptly stopped responding, and their Telegram account was deleted. Soon after, the group's data leak site went offline.</p><p>In the new statement, the purported ShinyHunters operators say they are returning after months of rumors and misinformation circulated about the group.</p><p>\"We’re finally back. A lot has happened recently, and there’s still plenty going on right now,\" reads the English announcement.</p><p>\"To be honest, there’s just too much nonsense going on. Everyone’s telling different stories, but no one is really explaining what’s been happening over the last few months.\"</p><figure><img alt=\"Post on the data leak site announcing ShinyHunter's return\" height=\"600\" src=\"/dailyinfo/media/8499d126108e4fcf.jpg\" srcset=\"/dailyinfo/media/761e293bb6a773db.jpg 720w, /dailyinfo/media/2109551520352f39.jpg 1200w, /dailyinfo/media/8499d126108e4fcf.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"937\">\n<figcaption><strong>Post on the data leak site announcing ShinyHunter's return</strong><br>\n<em>Source: BleepingComputer</em></figcaption>\n</figure><p>The operators of the new data leak site say they will communicate exclusively through the Exploit hacking forum account, which they claim to have controlled since 2020, and through the new Tor site.</p><p>The statement also addresses the reported arrest of a hacker and ShinyHunters member known as Rey, Dedale, or Saif, who was reportedly detained in Jordan in late September.</p><p>According to the announcement, Rey previously collaborated with ShinyHunters but began operating independently, creating Telegram channels without the group's approval.</p><p>\"As far as we know, he has already been arrested and is now \"actively cooperating\" with the authorities,\" reads the English message.</p><p>\"We already rotated the PGP key that Rey used for DLS, since it has most likely been compromised.\"</p><p>The message also mocks two other individuals reportedly tied to the ShinyHunters investigation, Umbreon and Canadian cybersecurity executive Edward Dubrovsky, referring to their arrests.</p><p>\"It was a pleasure working with you. And it’s truly a shame that our guys got caught because of such silly mistakes, ones that could easily have been avoided if you fools hadn’t gotten involved with the wrong people,\" reads the post.</p><p>The operators say they plan to launch a new CDN for hosting stolen data&nbsp;and will no longer use any of the existing backup servers.</p><h2 id=\"sec-1\">Old PGP keys used to authenticate new site</h2><p>To attempt to prove their legitimacy, the operators published two verification messages signed using historical ShinyHunters PGP keys created in January and August 2020.</p><p>The keys have the following fingerprints:</p><ul>\n\t<li>\n\t<p><strong>ShinyHunters RaidForums PGP key:&nbsp;</strong><code>1FC4D0B1DEE914BB05B57FABF1F1B98A51C989B3</code></p>\n\n\t</li>\n\t<li>\n\t<p><strong>ShinyHunters Empire Market PGP key:&nbsp;</strong><code>828537C15F43F135A8317153CD16A1660CC7CE51</code></p>\n\n\t</li>\n</ul><p>BleepingComputer verified that both messages were signed using these known PGP keys associated with the ShinyHunters extortion gang.</p><figure><img src=\"/dailyinfo/media/a0f090b7d59d8c04.jpg\" srcset=\"/dailyinfo/media/d2a4ff75d9cdb52f.jpg 720w, /dailyinfo/media/503218ef5e871143.jpg 1200w, /dailyinfo/media/a0f090b7d59d8c04.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"November 2026 message signed using historic ShinyHunters PGP key\" height=\"332\" width=\"1512\">\n<figcaption><strong>November 2026 message signed using historic ShinyHunters PGP key</strong></figcaption>\n</figure><p>PGP uses a pair of cryptographic keys: a public key that anyone can access and use to verify a message or data, and a private key used to create signatures. The private key must be kept secret to prevent others from impersonating the key's owner.</p><p>BleepingComputer previously verified a message received from ShinyHunters on August 26, 2025, using the <code>1FC4D0B1DEE914BB05B57FABF1F1B98A51C989B3</code> public key.</p><p>Successful verification of the November message with that same public key shows that whoever signed it had access to the same private signing key used in the earlier communications, linking it to the ShinyHunters operation behind the <a href=\"https://www.bleepingcomputer.com/tag/shinyhunters/\">widespread data theft attacks in 2026</a>.</p><p>However, both historical keys were revoked in March 2026, when ShinyHunters <a href=\"https://web.archive.org/web/20260317161148/https://shinyhunte.rs/\">announced a replacement PGP key</a> with the fingerprint <code>F4953411767DE71BEDCDABCB76F4E26F7A20978A</code>.</p><p>At the time, the group used both 2020 keys to authenticate the replacement and stated that the older keys would no longer be used for communications.</p><p>Despite this, the November 23 announcement once again uses the two revoked 2020 keys to authenticate another new PGP key, <code>27DA9D5B183247CADFC322880ABC63E30F73822E</code>.</p><p>However, none of the November messages examined by BleepingComputer were signed using the March 2026 replacement key, leaving it unclear whether the new operators also have access to that private key.</p><p>Because it was rumored that numerous people had the original 2020 keys, these unfortunately do not prove with certainty that the ShinyHunters group has returned or that the brand has not been revived by imposters.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/05e456735a2a4381.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-2\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Uncover email threats your existing defenses may miss.</a>\n        </h2><p>Adaptive Security's AI agents analyze email intent, context, and behavior to uncover phishing, business email compromise, and invoice fraud.</p><p>See what's getting through with a 14-day read-only scan of Microsoft 365 or Google Workspace, with no MX changes.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Start your free email security scan.</a>\n    </p>","zhKind","complete","勒索","数据泄露","黑产","加密","Oracle","https://www.bleepingcomputer.com/news/security/shinyhunters-resurfaces-after-fbi-arrests-uses-old-pgp-keys-as-proof/","BleepingComputer",{"_110":111,"_112":-5},"changelogVersion","2026-10-01T08:00","release"]
