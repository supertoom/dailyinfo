[{"_1":2,"_3":4},"root",{"_5":100},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794444096000,"id","mms1km0rggfxsxggiojfrk76b","title","N-able 为 N-central 多个漏洞发布 N-central 2026.4 HF2 热修复","originalTitle","N-able releases security hotfixes for zero-day vulnerabilities","summary","N-able 为 N-central 远程监控与管理平台多个漏洞发布 N-central 2026.4 HF2，涉及 CVE-2026-125883、CVE-2026-125878、CVE-2026-125879、CVE-2026-125880、CVE-2026-125881、CVE-2026-125882 和 CVE-2026-91000。","reason","原文同时列出受影响版本、多个零日漏洞编号、PoC 利用链及扫描活动，便于判断暴露范围并安排升级。","source",{"_72":99},"links",{"_89":98},"publishedAt","2026-11-11T12:32:27.000Z","discoveredAt","2026-11-11T13:26:35.605Z","timelineAt","category","vuln","tags",[93,94,95,96,73,97],"score",81,"selected",true,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","Sergiu Gatlan","body",{"_61":88,"_89":-5,"_90":91,"_92":37},"outline",[79,80],"relatedStories",[75],"topics",[68,69],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fFRopwzh6g8Q","reportCount",1,"additionalSourceCount",0,{"_70":31,"_72":74},{"_70":71,"_72":73},"slug","exploited","name","在野利用","漏洞披露",{"_76":77,"_13":78},"publicId","ed4db3d6-dbb8-43e7-b004-fff9ac19f4ca","N-able发布N-central关键漏洞热修复",{"_11":86,"_82":87,"_84":85},{"_11":81,"_82":83,"_84":85},"sec-2","text","发现现有防御可能遗漏的电子邮件威胁。","level",2,"sec-1","此前有报道称相关漏洞披露后遭到忽视，此次则是在此之后披露","<p><img alt=\"N-able\" height=\"900\" src=\"/dailyinfo/media/5a0c1dbed487e569.jpg\" srcset=\"/dailyinfo/media/b2b48544b1f2baf7.jpg 720w, /dailyinfo/media/40e4b37f2049a488.jpg 1200w, /dailyinfo/media/5a0c1dbed487e569.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>N-able 发布了热修复程序，以解决影响其 N-central 远程监控与管理（RMM）平台的零日漏洞。这些漏洞于周末被公开披露，并迫使该公司将存在漏洞的托管环境下线。</p><p>此前，N-able 决定<a href=\"https://www.bleepingcomputer.com/news/security/n-able-takes-cloud-platform-offline-after-30-plus-zero-days-published/\">将美洲、欧洲和亚太地区的所有托管 N-central 环境下线</a>，直至能够为其修补漏洞，以应对可能针对这些零日漏洞发动的野外攻击。</p><p>“N-able 正在积极回应于 11 月 8 日星期日深夜由独立研究人员发现并对外披露的 N-central 严重漏洞。”N-able 周一对 BleepingComputer 表示。&nbsp;“作为预防措施，我们已于今天 11 月 9 日将托管的 N-central 环境下线，并为运行本地部署 N-central 服务器的客户提供了指引，要求其暂时将服务器下线，直至另行通知。”</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/9c019570e7735ebd.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>N-central 允许 IT 部门和托管服务提供商（MSP）通过集中式 Web 控制台监控、管理和维护客户网络与设备。</p><p>N-able 现已发布<a href=\"https://status.n-able.com/2026/11/10/n-central-2026-4-hf2-release-notes/\">N-central 2026.4 HF2</a>，其中包含针对部分已泄露零日漏洞的安全补丁和技术更新，包括“最关键”的漏洞：</p><ul>\n\t<li><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-125883\">CVE-2026-125883</a> - 多个 XXE 漏洞</li>\n\t<li><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-125878\">CVE-2026-125878</a> - 多个 OGNL 注入漏洞</li>\n\t<li><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-125879\">CVE-2026-125879</a> - 通过可由 nable 写入的 syslog-ng 配置实现本地权限提升至 root</li>\n\t<li><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-125880\">CVE-2026-125880</a> - 通过 MMS3 补丁元数据实现存储型 XSS（管理员上下文）</li>\n\t<li><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-125881\">CVE-2026-125881</a> - 通过服务导入架构验证实现基于 schema-hint 的 SSRF</li>\n\t<li><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-125882\">CVE-2026-125882</a> - 通过文件存储库上传路径遍历实现 RCE（鸣谢 Nate Fair、Sprocket Security）</li>\n\t<li><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-91000\">CVE-2026-91000</a> - 不安全的 IPC 通道导致本地权限提升</li>\n</ul><p>N-able 在<a href=\"https://uptime.n-able.com/event/202584/\">星期二的更新</a>中表示，所有地区所有托管的 N-central 服务器（NCOD）现均已成功升级，并建议且“强烈”建议所有 N-central 本地部署客户尽快将其安装升级至新发布的版本。</p><p>“客户应仔细遵循已发布的升级指南，然后恢复对 N-central 环境的正常访问。此前的事件指南建议本地部署客户在修复方案开发期间保持 N-central 服务器下线。”该表示。</p><p>尽管 N-able 尚未将这些漏洞标记为已在野外遭到利用，但威胁情报公司 Defused 周二表示，攻击者已经开始扫描互联网上的易受攻击系统，并警告管理员立即将 N-central 服务器下线。</p><p>“在过去 24 小时内，我们观察到有人探测 N-able N-central，目标是昨天公开披露的零日漏洞。”<a href=\"https://x.com/DefusedCyber/status/2120177846970691916\">Defused 表示</a>。&nbsp;“我们看到有人开启匿名代理会话、拉取设备配置，并在未经身份验证的情况下访问远程控制端点。这些路径均属于零日漏洞的利用面。”</p><p>互联网安全非营利组织 Shadowserver 报告称，<a href=\"https://dashboard.shadowserver.org/statistics/iot-devices/time-series/?date_range=7&amp;vendor=n-able&amp;model=n-central&amp;limit=100&amp;group_by=geo&amp;stacking=stacked\">目前仅有略多于 148 台 N-central 服务器暴露在互联网上</a>，相较于周一检测到的 1,338 台，数量大幅下降。</p><figure><img alt=\"Internet-exposed N-central servers\" height=\"391\" src=\"/dailyinfo/media/4b4a45c333fe46b4.jpg\" srcset=\"/dailyinfo/media/67ba12d69f93ec32.jpg 720w, /dailyinfo/media/85ba0ca1cfae11ac.jpg 1200w, /dailyinfo/media/4b4a45c333fe46b4.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"793\">\n<figcaption><em>暴露在互联网中的 N-central 服务器（Shadowserver）</em></figcaption>\n</figure><h2 id=\"sec-1\">此前有报道称相关漏洞披露后遭到忽视，此次则是在此之后披露</h2><p>安全研究员<a href=\"https://www.linkedin.com/posts/seanbales_today-i-bring-you-able2shell-a-repository-activity-7525411549709144064-xdUB\">Sean Bales 披露了这些漏洞</a>。披露时间是 11 月 8 日星期日晚些时候，他还发布了一个名为 <a href=\"https://github.com/Oracle-Security/CVEs/tree/main/0-Days/N-Central%20N-Able\">Able2Shell</a> 的 GitHub 仓库，其中包含这些漏洞的概念验证利用代码。</p><p>Bales 表示，这些零日漏洞影响 N-central Appliance 2026.4.0.31，即该软件的预发布版本；他认为，这些漏洞中的大多数（如果不是全部）也会影响更早的版本。</p><p>披露的漏洞包括远程代码执行（RCE）、身份验证绕过、凭据泄露、任意文件写入、目录遍历、XML 外部实体（XXE）注入和跨站脚本（XSS）漏洞。</p><p>这位安全研究员还演示了一条关键的未认证 XXE 转 RCE 利用链，该利用链滥用 N-central 的服务导入功能，窃取受信任的本地会话、重置目标账户的密码，并以 nable 用户身份在服务器上执行命令。</p><p>攻击者还可以利用这条利用链创建一个由攻击者控制凭据的 Default Administrator 账户，从而获得对 N-central 管理界面的恶意管理员访问权限，如下方嵌入的视频演示所示。</p><p>Bales 告诉 BleepingComputer，他在未通知 N-able 的情况下公开了这些 N-central 零日漏洞，因为据称该公司在约五至六个月前收到他报告的另一个 N-able 产品中的漏洞（包括两个无关的远程代码执行漏洞和一个权限提升漏洞）后，未能对其进行修补。</p><p>当被问及 Bales 针对此前披露的安全问题提出的指控时，N-able 没有回答这些问题，而是发布了一份关于 N-central 安全事件及预防性停机的声明。</p><p>N-able 为 140 多个国家的 500,000 多家组织提供基于云的远程监控、网络安全和数据保护工具，服务对象包括托管服务提供商（MSP）和企业 IT 部门。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/0c6c2476908e136e.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-2\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体会分析电子邮件意图、上下文和行为，识别钓鱼攻击、商业电子邮件入侵和发票欺诈。</p><p>对 Microsoft 365 或 Google Workspace 进行为期 14 天的只读扫描，查看有哪些内容得以通过，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始免费的电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","漏洞","补丁","复现","漏洞利用","利用链","https://www.bleepingcomputer.com/news/security/n-able-releases-security-hotfixes-for-zero-day-vulnerabilities/","BleepingComputer",{"_101":102,"_103":-5},"changelogVersion","2026-10-01T08:00","release"]
