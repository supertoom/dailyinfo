[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1795740034000,"id","b66webn0sefvuhe9z7smcv596","title","ARTEX渗透测试智能体入侵CIA开源情报系统并波及ODNI","originalTitle","AI攻击火力太猛！美国中情局系统也被入侵了","summary","身份不明的攻击者使用AI驱动的ARTEX渗透测试框架入侵CIA非密开源情报（OSINT）分析系统，并波及ODNI和美国国家地理空间情报局；原文称未涉及机密网络、机密信息或其他系统，未导致机密数据或系统泄露。","reason","source",{"_66":82},"links",{"_77":81},"publishedAt","2026-11-26T09:55:00.000Z","discoveredAt","2026-11-26T11:34:22.573Z","timelineAt","category","activity","tags",[67,69,80,75],"score",70,"selected",false,"channel","news","story","x","readingMode","full","author","body",{"_58":76,"_77":-5,"_78":77,"_79":54},"outline",[],"relatedStories",[],"topics",[59,60,61,62,63],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","zh",{"_64":74,"_66":75},{"_64":72,"_66":73},{"_64":70,"_66":71},{"_64":68,"_66":69},{"_64":65,"_66":67},"slug","attack","name","攻击活动","ai-offense","AI 攻防","black-market","数据窃取与黑产","ransomware","勒索软件","cisa","CISA","<p><span>安全内参编译</span> <span>2026-11-26 17:55</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/2c9500ad52711f2a.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>CIA已承认旗下非密开源情报系统遭到入侵，并波及ODNI等其他情报机构</p><p><strong><span>关注我们</span></strong></p><p><strong><span>带你读懂网络安全</span></strong></p><p><img src=\"/dailyinfo/media/4c251ee25f3a19d4.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>继欧盟委员会、梭子鱼、Railway等知名机构后，美国中情局也被ARTEX渗透测试智能体入侵了，CIA已承认旗下非密开源情报系统遭到入侵，并波及ODNI等其他情报机构；</span></span></p><p><span><span>美国财政部金融犯罪执法网络随后也披露遭入侵，其出于审慎考虑已紧急关闭了该系统：</span></span></p><p><span><span>近一个多月来，类ARTEX渗透测试智能体开始流行，全球出现了成百上千个攻击事件和受害组织，欧盟CERT、美国FBI等均发布警告，提醒防范此类攻击。</span></span></p><p><span>前情回顾·<span>AI网络攻击火力全开</span></span></p><ul><li><p><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247516927&amp;idx=1&amp;sn=eef26e1f7857fef09b3352a6224c3796&amp;scene=21#wechat_redirect\">AI攻击杀疯了！欧盟委员会内部管理系统因此中断超10天</a></span></p></li><li><p><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247516914&amp;idx=2&amp;sn=23acc4d4c1fcb23ef1e519d154952687&amp;scene=21#wechat_redirect\">AI攻击火力太强，知名网络安全公司也被入侵了！</a></span></p></li><li><p><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247516776&amp;idx=1&amp;sn=95532de0868d1661b937626b36cee31a&amp;scene=21#wechat_redirect\">知名AI开发平台发生数据泄露，呼吁所有用户更换托管密钥</a></span></p></li><li><p><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247516904&amp;idx=1&amp;sn=769a04b609bf67ebcd354bb43a5bb5c5&amp;scene=21#wechat_redirect\">谷歌警告：AI全自动网络攻击将在半年内到来</a></span></p></li></ul><p><span>安全内参11月26日消息，据知情人士透露，身份不明的攻击者入侵了美国中央情报局（CIA）的一套开源情报（OSINT）分析系统。</span></p><p><span>纽约时报援引知情人士消息称，此次网络攻击使用了AI驱动的ARTEX渗透测试框架，同时波及美国国家情报总监办公室（ODNI）和美国国家地理空间情报局。</span></p><p><span>目前，CIA和ODNI尚未回应进一步置评请求。不过，此次入侵并未导致任何机密数据或系统泄露。</span></p><p><span>知情人士表示：“此次攻击未涉及机密网络或机密信息，目前也没有其他系统面临风险。”</span></p><p><span>美国财政部系统也被入侵了</span></p><p><span>CIA系统遭入侵的消息披露数小时后，美国财政部金融犯罪执法网络（FinCEN）也表示，该机构正在调查一起网络安全事件。攻击者未经授权访问了其部分系统，但涉及范围有限。</span></p><p><span>发现攻击后，FinCEN出于防范考虑，暂时关闭了部分系统，并通知各银行通过金融机构热线提交报告，因为部分服务可能暂时无法使用。</span></p><p><span>一名FinCEN官员表示：“财政部正与美国联邦调查局（FBI）、美国网络安全和基础设施安全局（CISA）以及第三方取证调查人员合作，以确定此次事件的范围及影响。在调查期间，作为主动防范措施，我们已暂时关闭FinCEN的部分系统，并为因系统中断而无法提交报告的申报机构提供了例外豁免。”</span></p><p><span>目前取证分析仍在进行，但尚无证据表明受益所有权数据库或《银行保密法》相关系统遭到入侵。</span></p><p><span>FinCEN是美国财政部负责打击金融犯罪的部门，也是美国官方金融情报机构（FIU）。该机构通过与美国国内及国际执法机构共享金融情报，保护美国金融体系免受非法活动侵害。</span></p><p><span>就在一周前，美国国家安全局（NSA）的机密网络也曾发生持续数日的服务中断。不过，该机构将此次中断归因于按计划开展的例行维护，并表示其执行关键任务的能力始终保持正常运行。</span></p><p><span>美国政府机构接连成为网络攻击目标</span></p><p><span>近年来，美国多个联邦政府机构相继遭遇网络攻击。CIA和FinCEN此次披露的事件，是这一系列攻击的最新案例。</span></p><p><span>两年前，黑客组织Silk Typhoon入侵了美国财政部外国资产控制办公室（OFAC）。该办公室负责实施美国的经济和贸易制裁计划。</span></p><p><span>该组织还入侵了美国财政部金融研究办公室（OFR），据称还渗透了美国外国投资委员会（CFIUS）。该委员会隶属于美国财政部，负责审查外国投资可能带来的国家安全风险。</span></p><p><span>上周末，黑客据称入侵了美国联邦调查局的国家犯罪信息中心（NCIC）。目前尚不清楚攻击者如何获取系统访问权限，也不清楚入侵发生的具体时间，以及攻击者是否从受影响系统中窃取信息。</span></p><p><span>此前，勒索组织ShinyHunters曾声称入侵了FBI的招聘网站FBIJobs.gov。此事促使FBI展开调查，并最终逮捕了多名疑似与ShinyHunters有关联的人员，其中包括一名据称与此次攻击有关联的加拿大网络安全企业高管。</span></p><p><strong><span>参考资料：bleepingcomputer.com</span></strong></p><p><strong><span><span>推荐阅读</span></span></strong></p><ul><li><p><span><a href=\"http://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247499450&amp;idx=2&amp;sn=2da3ca2e0b4d4f9f56ea7f7579afc378&amp;chksm=ebfab99adc8d308c3ba6e7a74bd41beadf39f1b0e38a39f7235db4c305c06caa49ff63a0cc1d&amp;scene=21#wechat_redirect\">网安智库平台长期招聘兼职研究员</a></span></p></li><li><p><span><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247501251&amp;idx=1&amp;sn=8b6ebecbe80c1c72317948494f87b489&amp;chksm=ebfa82e3dc8d0bf595d039e75b446e14ab96bf63cf8ffc5d553b58248dde3424fb18e6947440&amp;token=525430415&amp;lang=zh_CN&amp;scene=21#wechat_redirect\">欢迎加入“安全内参热点讨论群”</a></span></span></p></li></ul><hr><p><span><span>点击下方卡片关注我们，</span></span></p><p><span><span>带你一起读懂网络安全 ↓</span></span></p><p><a href=\"https://www.secrss.com/?wx\">阅读原文</a></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=a18f1725&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzI4NDY2MDMwMw%3D%3D%26mid%3D2247516954%26idx%3D1%26sn%3D3f4effeba496a7c4212a52b1618ffdb9\">跳转微信打开</a></p>","original","zhKind","complete","数据窃取","https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&mid=2247516954&idx=1&sn=3f4effeba496a7c4212a52b1618ffdb9","安全内参",{"_84":85,"_86":-5},"changelogVersion","2026-10-01T08:00","release"]
