[{"_1":2,"_3":4},"root",{"_5":90},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":35,"_52":53,"_54":-5,"_55":35,"_56":57},"expiresAt",1793667382000,"id","rafkhy3qv0k8l0szgvjkxzwzu","title","Red Hat Security：AI 时代的自主权、选择权与控制力","originalTitle","Sovereignty in the AI era: Choice, control, and autonomy","summary","Red Hat Security 发布关于 AI 时代自主权的文章，核心议题是用户在技术选择、运行控制与自主性方面应如何把握。正文仅提供其网站栏目导航，涵盖 IT 自动化、Security、边缘计算、Infrastructure、Applications 与 Virtualization，未披露具体产品、漏洞、攻击事件或技术结论。","reason","source",{"_88":89},"links",{"_57":87},"publishedAt","2026-11-02T00:00:00.000Z","discoveredAt","2026-11-02T19:50:33.729Z","timelineAt","category","tags",[86],"score",3,"selected",false,"channel","news","story","x","readingMode","full","author","body",{"_82":-5,"_57":83,"_84":-5,"_85":35},"outline",[58,59,60,61,62,63,64],"relatedStories",[],"topics",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_11":79,"_66":80,"_68":81},{"_11":77,"_66":78,"_68":33},{"_11":75,"_66":76,"_68":33},{"_11":73,"_66":74,"_68":33},{"_11":71,"_66":72,"_68":33},{"_11":69,"_66":70,"_68":33},{"_11":65,"_66":67,"_68":33},"sec-7","text","Virtualization","level","sec-6","Applications","sec-5","Infrastructure","sec-4","Edge computing","sec-3","Security","sec-2","Automation","sec-1","Browse by channel",2,"zh","<h2 id=\"sec-1\">Browse by channel</h2><p>\n                            <a href=\"https://www.redhat.com/en/blog/channels\" title=\"Explore all channels\">Explore all channels</a>            </p><p>\n              \n  \n\n\n                  <img src=\"/dailyinfo/media/704d6c44abac1d2a.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"automation icon\">\n                  </p><h3 id=\"sec-2\"><a href=\"https://www.redhat.com/en/blog/channel/management-and-automation\">Automation</a></h3><p>The latest on IT automation for tech, teams, and environments</p><p>\n              \n  \n\n\n                  <img src=\"/dailyinfo/media/b6bbc924c513eb7f.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"security icon\">\n                  </p><h3 id=\"sec-3\"><a href=\"https://www.redhat.com/en/blog/channel/security\">Security</a></h3><p>The latest on how we reduce risks across environments and technologies</p><p>\n              \n  \n\n\n                  <img src=\"/dailyinfo/media/873cc9d700595bb8.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"edge icon\">\n                  </p><h3 id=\"sec-4\"><a href=\"https://www.redhat.com/en/blog/channel/edge-computing\">Edge computing</a></h3><p>Updates on the platforms that simplify operations at the edge</p><p>\n              \n  \n\n\n                  <img src=\"/dailyinfo/media/710dce42133194f5.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"Infrastructure icon\">\n                  </p><h3 id=\"sec-5\"><a href=\"https://www.redhat.com/en/blog/channel/infrastructure\">Infrastructure</a></h3><p>The latest on the world’s leading enterprise Linux platform</p><p>\n              \n  \n\n\n                  <img src=\"/dailyinfo/media/130ca6c9880e50b1.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"application development icon\">\n                  </p><h3 id=\"sec-6\"><a href=\"https://www.redhat.com/en/blog/channel/applications\">Applications</a></h3><p>Inside our solutions to the toughest application challenges</p><p>\n              \n  \n\n\n                  <img src=\"/dailyinfo/media/31acc236740b48a1.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"Virtualization icon\">\n                  </p><h3 id=\"sec-7\"><a href=\"https://www.redhat.com/en/blog/channel/red-hat-virtualization\"> Virtualization</a></h3><p>The future of enterprise virtualization for your workloads on-premise or across clouds</p>","zhKind","complete","其他","https://www.redhat.com/en/blog/sovereignty-ai-era-choice-control-and-autonomy","name","Red Hat Security",{"_91":92,"_93":-5},"changelogVersion","2026-10-01T08:00","release"]
