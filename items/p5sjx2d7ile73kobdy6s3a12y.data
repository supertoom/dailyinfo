[{"_1":2,"_3":4},"root",{"_5":96},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":54,"_55":36,"_56":36,"_57":58,"_59":60,"_61":62},"expiresAt",1795653644000,"id","p5sjx2d7ile73kobdy6s3a12y","title","GeoServer 认证前 RCE 利用链涉及 CVE-2026-129242 等 5 个漏洞","originalTitle","【漏洞通告】GeoServer 认证前远程代码执行漏洞利用链(CVE-2026-129242 等)","summary","GeoServer 存在由 CVE-2026-129242、CVE-2026-129243、CVE-2026-129244、CVE-2026-129245、CVE-2026-120705 组成的认证前远程代码执行利用链。","reason","source",{"_74":95},"links",{"_84":94},"publishedAt","2026-11-25T09:18:00.000Z","discoveredAt","2026-11-25T17:19:04.680Z","timelineAt","category","vuln","tags",[89,90,91,92,93,78],"score",80,"selected",true,"channel","news","story",{"_80":81,"_13":82},"x","sameEvent",{"_11":87,"_13":88},"readingMode","full","author","body",{"_62":83,"_84":-5,"_85":84,"_86":36},"outline",[],"relatedStories",[79],"topics",[69,70,71],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation",false,"bodyLanguage","zh","factId","fsk1W6sVk-3I","reportCount",3,"additionalSourceCount",2,{"_72":77,"_74":78},{"_72":30,"_74":76},{"_72":73,"_74":75},"slug","research","name","技术研究","漏洞披露","sangfor","深信服",{"_80":81,"_13":82},"publicId","f6003043-ce60-438d-9a23-a8338172530e","GeoServer未认证RCE链已复现并出现利用探测","<p><span>深瞳漏洞实验室</span> <span>2026-11-25 17:18</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/5899fb3480da9ff2.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>2026年11月25日，深瞳漏洞实验室监测到一则GeoServer组件存在远程代码执行漏洞的信息，漏洞编号：CVE-2026-129242，CVE-2026-129243，CVE-2026-129244，CVE-2026-129245，CVE-2026-120705，漏洞威胁等级：严重。</p><p><img src=\"/dailyinfo/media/a90ff2e66c9bf83a.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span><span>漏洞名称：</span></span></strong></p><p><span>GeoServer 认证前远程代码执行漏洞利用链(CVE-2026-129242 等)</span></p><p><strong><span><span>组件名称：</span></span></strong></p><p><span>GeoServer</span></p><p><span><strong><span>影响范围：</span></strong></span></p><p><span>3.0.x &lt;= GeoServer &lt; 3.0.2</span></p><p><span>2.28.x &lt;= GeoServer &lt; 2.28.6</span></p><p><span>GeoServer &lt; 2.27.7</span></p><p><strong><span><span>漏洞类型：</span></span></strong></p><p><span>远程代码执行</span></p><p><span><strong><span>利用条件：</span></strong></span></p><p><span>1、用户认证：否</span></p><p><span>2、前置条件：默认配置，WFS/REST 服务端点可达</span></p><p><span>3、触发方式：远程</span></p><p><strong><span><span>综合评价：</span></span></strong></p><p><span>&lt;综合评定利用难度&gt;：容易，整条利用链无需任何有效凭据即可远程代码执行。</span></p><p><span>&lt;综合评定威胁等级&gt;：严重，可造成未授权远程代码执行。</span></p><p><strong><span><span>官方解决方案：</span></span></strong></p><p><span>已发布</span></p><p><strong><span>漏洞分析</span></strong></p><p><img src=\"/dailyinfo/media/bd51b850dcae1c32.webp\" loading=\"lazy\" decoding=\"async\"></p><p><b><span>组件介绍</span></b></p><p><span>GeoServer 是 OpenGeo（现 Crossware/OSGeo 社区）维护的开源地理空间数据服务器，用于发布和共享 WFS/WMS 等 OGC 标准地理数据服务，基于 Java 构建，并非编程语言标准库内置组件，常作为地图服务基础设施暴露于内外网。在本次漏洞链中，其匿名可用的 WFS stored query 功能、remember-me 认证机制、REST API 与 HSQLDB JDBC 用户组服务被串联滥用，成为未认证攻击者从信息泄露走到远程代码执行的完整路径。</span></p><p><img src=\"/dailyinfo/media/f5ad20cc031185b7.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>漏洞简介</span></strong></p><p><span>2026年11月25日，深瞳漏洞实验室监测到一则GeoServer组件存在远程代码执行漏洞的信息，漏洞编号：CVE-2026-129242，CVE-2026-129243，CVE-2026-129244，CVE-2026-129245，CVE-2026-120705，漏洞威胁等级：严重。</span></p><p><span>该利用链由五个漏洞组合构成（核心为 CVE-2026-129242）： GeoServer匿名 WFS stored query 相关缺陷允许未认证攻击者探测数据目录路径并创建携带延迟 XInclude 的存储查询；查询信息被回显时，DescribeStoredQueries 响应泄露 remember-me 密钥与管理员口令摘要，</span><strong><span><span>攻击者据此伪造 remember-me Cookie向 REST API 换取管理员会话；取得管理员权限后，上传恶意 HSQLDB 数据库并注册 JDBC 用户组服务，通过用户属性查询触发 HSQLDB 反序列化，最终在服务器上以服务进程权限执行任意命令。整条链路无需任何有效凭据。</span></span></strong></p><p><img src=\"/dailyinfo/media/2ede7416f6cda63e.webp\" loading=\"lazy\" decoding=\"async\"></p><p><b><span>漏洞验证</span></b></p><p><span>搭建受影响的GeoServer环境，复现该漏洞，效果如下：</span></p><p><img src=\"/dailyinfo/media/843fdac9d674c286.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>影响范围</span></strong></p><p><span>目前受影响的GeoServer版本：</span></p><p><span>3.0.x &lt;= GeoServer &lt; 3.0.2</span></p><p><span>2.28.x &lt;= GeoServer &lt; 2.28.6</span></p><p><span>GeoServer &lt; 2.27.7</span></p><p><strong><span>解决方案</span></strong></p><p><img src=\"/dailyinfo/media/35e26a6d633985d7.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>官方修复建议</span></strong></p><p><span>官方已于 2026 年 11 月 23 日发布公告，建议升级至 GeoServer 3.0.2、2.28.6 或 2.27.7(对应 3.0.x、2.28.x、2.27.x 及更早 2.x 系列)。</span></p><p><span>下载链接：<a href=\"https://geoserver.org/download/\">https://geoserver.org/download/</a></span></p><p><img src=\"/dailyinfo/media/de58d958ddc9b9d1.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span><span>临时修复建议</span></span></strong></p><ul><li><p><span>限制 WFS 与 REST 端点(/geoserver/web、/geoserver/rest)仅对可信来源开放；</span></p></li></ul><ul><li><p><span>关闭或限制匿名 WFS stored query 功能；</span></p></li></ul><ul><li><p><span>拦截对 /geoserver/ows、/geoserver/wfs 的匿名 GET/POST 请求中包含以下特征的流量：</span></p></li></ul><ul><li><p><span>DescribeStoredQueries、storedQuery、xinclude:、xi:include、href=\"file: 等 WFS stored query + XInclude 组合特征</span></p></li></ul><ul><li><p><span>GetConfig、/rest/security/usergroup/ 等 REST API 匿名调用特征</span></p></li></ul><p><span>以上措施不可替代升级方案，需尽快升级至修复版本</span></p><p><img src=\"/dailyinfo/media/e76b4677271eefda.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>深信服解决方案</span></strong></p><p><strong><span>1、风险资产发现</span></strong></p><p><span>支持对GeoServer的主动检测，</span><strong><span><span>可批量检出业务场景中该事件的受影响资产情况，</span></span></strong><span>相关产品如下：</span></p><p><strong><span><span>【深信服统一端点安全管理系统aES】</span></span></strong><span>已发布资产检测方案，指纹ID:0003992。</span></p><p><strong><span><span>【深信服云镜YJ】</span></span></strong><span>已发布资产检测方案，指纹ID:0003992。</span></p><p><strong><span>2、漏洞主动检测</span></strong></p><p><span>支持对GeoServer 认证前远程代码执行漏洞(CVE-2026-129242 )的主动检测，</span><strong><span><span>可批量快速检出业务场景中是否存在漏洞风险，</span></span></strong><span>相关产品如下：</span></p><p><strong><span><span>【深信服云镜YJ】</span></span></strong><span>预计2026年12月04日发布检测方案，规则ID:SF-2026-13364。</span></p><p><strong><span><span>【深信服可拓展检测响应平台XDR】</span></span></strong><span>预计2026年12月04日发布检测方案（需要具备云镜组件能力），规则ID:SF-2026-13364。</span></p><p><strong><span><span>【深信服统一端点安全管理系统aES】</span></span></strong><span>预计2026年12月15日发布检测方案。</span></p><p><strong><span>3、漏洞安全监测</span></strong></p><p><span>支持对GeoServer 认证前远程代码执行漏洞(CVE-2026-129242)的监测，</span><strong><span><span>可依据流量收集实时监控业务场景中的受影响资产情况，</span></span></strong><span>快速检查受影响范围，相关产品及服务如下：</span></p><p><strong><span><span>【深信服安全感知管理平台SIP】</span></span></strong><span>预计2026年12月03日发布监测方案，规则ID:11224872。</span></p><p><strong><span><span>【深信服安全托管服务MSS】</span></span></strong><span>预计2026年12月03日发布监测方案（需要具备SIP组件能力），规则ID:11224872。</span></p><p><strong><span><span>【深信服可拓展检测响应平台XDR】</span></span></strong><span>预计2026年12月03日发布监测方案，规则ID:11224872。</span></p><p><strong><span>4、漏洞安全防护</span></strong></p><p><span>支持对GeoServer 认证前远程代码执行漏洞(CVE-2026-129242)的防御，</span><strong><span><span>可阻断攻击者针对该事件的入侵行为，</span></span></strong><span>相关产品及服务如下：</span></p><p><strong><span><span>【深信服下一代防火墙AF】</span></span></strong><span>预计2026年12月03日发布防护方案，规则ID:11224872。</span></p><p><strong><span><span>【深信服Web应用防火墙WAF】</span></span></strong><span>预计2026年12月03日发布防护方案，规则ID:11224872。</span></p><p><strong><span><span>【深信服安全托管服务MSS】</span></span></strong><span>预计2026年12月03日发布防护方案（需要具备AF组件能力），规则ID:11224872。</span></p><p><strong><span><span>【深信服可拓展检测响应平台XDR】</span></span></strong><span>预计2026年12月03日发布防护方案（需要具备AF组件能力），规则ID:11224872。</span></p><p><b><span>参考链接</span></b></p><p><span><a href=\"https://github.com/geoserver/geoserver/security/advisories\">https://github.com/geoserver/geoserver/security/advisories</a></span></p><p><b><span>时间轴</span></b></p><p><strong><span>2026/11/25</span></strong></p><p><span>深瞳漏洞实验室监测到GeoServer 认证前远程代码执行漏洞信息。</span></p><p><strong><span>2026/11/25</span></strong></p><p><span>深瞳漏洞实验室发布漏洞通告。</span></p><p><span>点击</span><strong><span><span>阅读原文</span></span></strong><span>，及时关注并登录深信服</span><strong><span>智安全平台</span></strong><span>，可轻松查询漏洞相关解决方案。</span></p><p><img src=\"/dailyinfo/media/177e683fe6c358ba.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img src=\"/dailyinfo/media/4c65e6d8533619df.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><a href=\"https://sec.sangfor.com.cn/security-vulnerability/detail?vuln_sfv=SF_2026_47169%5cx26amp;lang=ZH-CN\">阅读原文</a></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=6d79a242&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzg2NjgzNjA5NQ%3D%3D%26mid%3D2247526564%26idx%3D1%26sn%3D8299bac7d2c75d1a0804de094f9efbf0\">跳转微信打开</a></p>","original","zhKind","complete","nhx83jvk238i041bf7tt09eqs","GeoServer 未认证远程代码执行漏洞链 CVE-2026-129242 等已复现","漏洞","利用链","复现","补丁","漏洞分析","https://mp.weixin.qq.com/s?__biz=Mzg2NjgzNjA5NQ==&mid=2247526564&idx=1&sn=8299bac7d2c75d1a0804de094f9efbf0","深信服千里目安全实验室",{"_97":98,"_99":-5},"changelogVersion","2026-10-01T08:00","release"]
