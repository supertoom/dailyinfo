[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794530489000,"id","oyad974prfvo7igo8npmwywn4","title","Binance 披露虚假招聘与 AI 工具滥用导致 64.3 亿美元资产被盗","originalTitle","Binance Reveals How Fake Job Interviews and AI Tool Abuse Led to $6.43 Billion Theft","summary","Binance 称，2026 年 6 月至 10 月发生的攻击通过篡改的 Homebrew 安装程序、虚假招聘面试、恶意代码仓库及内部 AI 工具滥用，依次入侵两名工程师的终端，并盗取钱包基础设施相关凭据。","reason","文章拆解了虚假招聘、社工诱导、恶意代码与内部 AI 工具滥用组成的完整攻击链，并列出 Binance 的处置措施。","source",{"_76":103},"links",{"_93":102},"publishedAt","2026-11-03T16:55:58.000Z","discoveredAt","2026-11-03T17:53:21.459Z","timelineAt","category","activity","tags",[77,97,98,99,100,101],"score",90,"selected",true,"channel","news","story",{"_89":90,"_13":91},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_61":92,"_93":-5,"_94":95,"_96":37},"outline",[],"relatedStories",[88],"topics",[68,69,70,71,72,73],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fVpMCjmD4ci4","reportCount",3,"additionalSourceCount",2,{"_74":86,"_76":87},{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","attack","name","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","identity","身份与访问","cloud-native","云与原生","supply-chain","供应链安全",{"_89":90,"_13":91},"publicId","95f3b82d-3dca-476e-a96d-466662cbcf8e","币安披露63.4亿美元多阶段攻击链","<p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhZCMCR8h3YCPcfY8Fbe54ckYKh_YUt_Yd7v82dAHobZtMNlQl_JVKWUX4OUPwR0dEmYsLNfeKsW6rUthk8pYRVhIddbPXx86sHCcNBRL9E-9LJTPrYSYwJ_V66EwGJNFeoWgDPbjcGfeJ4w2qn_gfTjXBoNAnfWq4GZ8rq7VOhnqt4QlItYEBr3Zar7XL1/s1600/bin.jpg\"><img alt=\"\" src=\"/dailyinfo/media/5899c79e674a91cb.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>Binance 周二表示，这起从全球最大加密货币交易所窃取 <a href=\"https://thehackernews.com/2026/11/fbi-links-north-koreas-tradertraitor-to.html\">创纪录的 64.3 亿美元资产事件</a>，是一次“精心策划、多阶段的攻击活动”的最终结果；该活动涉及使用被篡改的 Homebrew 安装程序，以及针对其两名工程师、以招聘为主题的社会工程攻击。</p><p><a href=\"https://x.com/binance/status/2117626126214504729\">公司表示</a>：“这不是一次单一的入侵事件，也不是简单的网络钓鱼事件。攻击者结合了多种技术，包括通过虚假招聘面试实施社会工程、恶意软件下载、内部 AI 工具遭入侵、终端设备失陷，以及一种先进的交易授权方法。”</p><p>攻击起点已被追溯至一次供应链攻击，目标为其 Wallet DevOps 团队的一名工程师（名为“Engineer A”）。该工程师在搜索引擎上查找一款热门人工智能（AI）工具后，<a href=\"https://thehackernews.com/2026/02/microsoft-discloses-dns-based-clickfix.html\">下载</a>了<a href=\"https://isc.sans.edu/diary/32942\">植入木马的 Homebrew 安装程序</a>以进行安装。事件发生于 2026 年 6 月。</p><p>尽管 Binance 表示已检测到此次攻击，并出于预防措施轮换了所有相关凭据，但公司称，“Engineer A 的职责，以及我们钱包基础设施团队中与其相关同事的信息，已暴露给黑客。”</p><p>攻击的第二部分发生于 2026 年 9 月。威胁行为者通过一个正规招聘平台联系另一名工程师（名为“Engineer B”），并伪装成项目总监。</p><p>这位“项目总监”安排了该工程师与一名人力资源（HR）代表进行第一轮面试，随后又与一名自称是一家并不存在公司的 CEO 的人进行了第二轮面试。Binance 未披露这家虚假公司的详细信息。</p><p>在第一轮视频面试过程中，HR 代表分享了一个社交媒体账户，其中包括发布在该平台上的个人照片和视频，以建立可信度并取得信任。而第二轮面试则在一款热门的社交聊天应用上进行。</p><p>Binance 表示：“在面试接近尾声时，Engineer B 被要求将一个包含恶意代码仓库的‘任务’下载到其工作电脑上。该仓库包含恶意代码，在设置过程中执行，进而启动了一系列未经授权的活动。”</p><p>这个未被发现的恶意软件采用了高级的混淆和规避技术，包括用一个带毒版本替换合法开发工具的组件，以执行命令并与攻击者控制的外部服务器通信。此外，威胁行为者还采取措施掩盖踪迹，删除了与入侵有关的取证痕迹。</p><p>此次入侵于 2026 年 10 月 20 日进入下一阶段。攻击者利用 Engineer B 已被入侵的计算机，滥用内部 AI 工具，获取了 Engineer A 和另一名 Wallet Software Engineer C 的控制权。</p><p>Binance 解释道：“攻击者很快发现 Wallet DevOps Engineer C 的电脑上有一个容器部署权限令牌，该令牌属于 Wallet DevOps Engineer A。10 月 29 日 17:15 至 19:56 期间，攻击者登录了 Software Engineer C 的计算机，使用从 Wallet DevOps Engineer A 处窃取的凭据，部署了一个容器，并触发恶意脚本以发动攻击。”</p><p>此次攻击最终利用其对内部钱包签名服务的未授权访问，发起了正常提款流程之外的交易。</p><p>针对此次事件，Binance 已在新环境中重建受影响的钱包系统，并重建了内部 AI 工具和访问控制措施。截至 11 月 3 日已采取的其他措施如下——</p><ul>\n  <li>更换了受影响的设备。</li>\n  <li>停用了与受影响工程师有关的凭据和令牌。</li>\n  <li>完成了对所有员工设备的安全强化扫描。</li>\n  <li>强化了基于 AI 的行为异常检测。</li>\n  <li>加强了钱包服务的风险控制。</li>\n  <li>与执法机构、区块链情报公司及行业合作伙伴合作，追踪并冻结了受影响的资产。</li>\n</ul><p>Binance 表示：“已关闭被确认用于此次攻击的入口点。攻击路径中涉及的系统均已重建或替换。我们还实施了更严格的设备控制、强化了钱包服务的风险控制，并扩大了基于 AI 的行为异常检测范围。”</p><p>Binance 表示：“我们正在增加对 AI 辅助检测、终端保护、开发环境安全和行为异常监控的投资。”</p><p>自年初以来，据估计 Binance 已挫败 57 起疑似与朝鲜有关联的网络威胁案件，这凸显出针对加密货币行业的攻击持续存在。</p><p>Binance 表示：“这些手法包括欺诈性求职面试、伪装成热门开发工具的恶意软件、遭入侵的软件包和浏览器扩展、虚假视频会议应用，以及旨在窃取凭据或部署远程访问恶意软件的社会工程活动。”</p><p>觉得这篇文章有意思？在 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a> 上关注我们，查看我们发布的更多独家内容。</p>","original","zhKind","translation","complete","数据窃取","供应链投毒","AI 供应链","凭据","容器","https://thehackernews.com/2026/11/binance-reveals-how-fake-job-interviews.html","The Hacker News",{"_105":106,"_107":-5},"changelogVersion","2026-10-01T08:00","release"]
