[{"_1":2,"_3":4},"root",{"_5":92},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795826439000,"id","edycapt0khpdxw9pdgw91bldq","title","Drupal 安装器补丁遗漏导致 CVE-2026-136716 已被在野利用","originalTitle","Drupal Installer Patch Left a Gap Attackers Are Already Exploiting","summary","Drupal 披露 CVE-2026-136716，其 CMSS 评分为 21/25，属于可导致网站接管的访问绕过漏洞，并确认已在野利用。","reason","前一周补丁未覆盖处于异常或不完整安装状态的站点，攻击者已借此接管网站，运维需按版本升级并执行更新脚本。","source",{"_73":91},"links",{"_83":90},"publishedAt","2026-11-26T09:12:26.000Z","discoveredAt","2026-11-26T09:20:19.053Z","timelineAt","category","vuln","tags",[87,74,88,89,77],"score",85,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","Eduard Kovacs","body",{"_61":82,"_83":-5,"_84":85,"_86":37},"outline",[],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fbUqn7i0GgUU","reportCount",5,"additionalSourceCount",4,{"_71":76,"_73":77},{"_71":31,"_73":75},{"_71":72,"_73":74},"slug","exploited","name","在野利用","漏洞披露","cisa","CISA",{"_79":80,"_13":81},"publicId","df8b9daa-5e85-4d46-a5ad-7d5591635b6b","Drupal核心站点接管漏洞已被在野利用","<p><strong>Drupal 表示，上周针对一个已被利用的安装程序漏洞发布的补丁并未保护所有网站，攻击者目前正利用这一缺口入侵易受攻击的网站。</strong>\n\n\n\n</p><p>新问题编号为 CVE-2026-136716，CMSS 评分为 21/25，于 11 月 25 日披露，恰好是在 Drupal 通过公告 SA-CORE-2026-017 发布原始补丁一周之后。Drupal 将这个新缺陷描述为访问绕过问题，可能导致网站被接管。\n\n\n</p><p>11 月 18 日发布的更新修复了 CVE-2026-132165，这是一个由 Anthropic 的 OSS Scanner 报告的安装程序漏洞。受影响的安装程序随 Drupal core 一起分发，可让用户设置新网站。\n\n\n</p><p>Drupal 很快获知了该漏洞正遭到<a href=\"https://www.securityweek.com/drupal-flaw-found-by-anthropic-scanner-exploited-in-attacks/\">在野利用</a>，CISA 也于 11 月 24 日将该漏洞加入了 KEV 目录。\n\n\n</p><p>CVE-2026-136716 的公告解释了先前的修复在哪些方面存在不足。\n\n\n</p><p>“SA-CORE-2026-017 最近修复了 Drupal core 安装程序中的多个漏洞。然而，在应用该公告后，某些处于异常或不完整安装状态的网站仍可能因网站接管而受到威胁，其中包括生产网站，”Drupal 在其<a href=\"https://www.drupal.org/sa-core-2026-019\">公告</a>中表示。&nbsp;</p><p><span>广告。滚动以继续阅读。</span></p><p>它补充道：“用户界面无法明显看出网站是否处于受影响的不安全状态，而已经被攻陷的网站可能已不再处于该不安全状态。”\n\n\n</p><p>Drupal 警告称，CVE-2026-136716 正在遭到在野利用，并且“在应用 SA-CORE-2026-017 后，任何仍可远程访问其安装程序的网站都可能已被攻陷。”\n\n\n</p><p>此前已保护好安装程序的网站不易受到攻击。11.4.14、11.3.23 和 10.6.23 版本中包含相应补丁。受影响的生产网站升级后必须运行 update hook，才能彻底解决该漏洞。\n\n\n</p><p>Drupal 尚未披露有关这些攻击的任何信息，目前也不清楚是谁负责此次利用。用户已被建议检查日志，以寻找网站遭到攻陷的迹象。\n\n\n</p><p><strong>相关</strong>：<a href=\"https://www.securityweek.com/two-newly-disclosed-geoserver-vulnerabilities-under-attack\">两个新披露且正遭攻击的 GeoServer 漏洞</a>\n\n\n</p><p><strong>相关</strong>：<a href=\"https://www.securityweek.com/hackers-exploit-unpatched-flaw-in-defunct-idunno-anticsrf-library/\">黑客利用已停止维护的 Idunno AntiCsrf 库中未修补的漏洞</a>\n\n\n</p><p><strong>相关</strong>：<a href=\"https://www.securityweek.com/palo-alto-networks-patches-fragnesia-flaw-used-to-root-firewalls/\">Palo Alto Networks 修复 Fragnesia 漏洞，该漏洞曾被用于入侵防火墙</a>\n\n\n</p>","original","zhKind","translation","complete","漏洞","补丁","漏洞利用","https://www.securityweek.com/drupal-installer-patch-left-a-gap-attackers-are-already-exploiting/","SecurityWeek",{"_93":94,"_95":-5},"changelogVersion","2026-10-01T08:00","release"]
