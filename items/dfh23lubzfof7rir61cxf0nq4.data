[{"_1":2,"_3":4},"root",{"_5":96},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795480834000,"id","dfh23lubzfof7rir61cxf0nq4","title","NebuSec 演示恶意网页劫持 Meta Muse 并读取私人聊天与记忆","originalTitle","A Single Malicious Webpage Let Researchers Hijack Meta Muse and Access Private Chats","summary","NebuSec 演示恶意网页可绕过审批提示，从 Meta Muse 云端机器提取并篡改用户聊天记录与存储记忆，并结合内置浏览器和 Linux 内核缺陷取得机器控制权，访问凭据存储、保存文件及 Sentinel。攻击仅影响单台云端机器，未进入共享服务器或其他用户设备；研究为实验室演示，NebuSec 称所披露弱点均已修复，但 Meta 尚未公开确认，补丁发布前是否有用户数据被访问也未说明。","reason","文章拆解了恶意网页经内置浏览器与 Linux 内核缺陷控制云端机器的攻击链，并说明影响边界与修复状态。","source",{"_74":95},"links",{"_87":94},"publishedAt","2026-11-21T11:53:07.000Z","discoveredAt","2026-11-21T12:27:45.824Z","timelineAt","category","disclosure","tags",[77,91,75,92,79,93],"score",71,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_61":86,"_87":-5,"_88":89,"_90":37},"outline",[],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fsu0C-tyfSA0","reportCount",1,"additionalSourceCount",0,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","ai-security","name","AI 安全","research","技术研究","browser","浏览器","kernel","内核与系统",{"_83":84,"_13":85},"publicId","e3e839cd-faad-43de-a55f-9b452d724425","NebuSec披露Meta Muse网页劫持链","<p><span><i></i><span>Swati Khandelwal</span><i></i><span>2026年11月21日</span></span><span>漏洞 / 人工智能</span></p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiYiVrbfn3FWfI_uNyjj8q9SZ38d2mHKu2ehdtYYKPwyg-05yKJBYUAPEaVxJq5KDGwU11X2tmEKNUKPIHQY9s67e1K9w_8NRdEOxVCDJqqMbQ6F27kfOj3GKjcQ3-0WHFNg7uYT6QeIU90qX1YW_Zvyn7WhZwpV41i5Pj6watQsF7Ti8NN1GIQLxw-jPc/s1600/muse-ai.jpg\"><img alt=\"\" src=\"/dailyinfo/media/7aeaf2f87f747696.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>研究人员展示称，恶意网页无需触发任何审批提示，就能从助手中提取 <strong>Meta Muse</strong> 用户的私人对话和已存储的记忆。</p><p>同一攻击还可进一步扩展，窃取 Muse 为用户连接账户所存储的凭据。</p><p>这项工作是一次实验室演示，并非针对真实用户的攻击，且始终局限在该用户自己的云计算机内。发布相关研究的安全公司 <strong>NebuSec</strong> 表示，Muse 团队此后已修复其所描述的每一个漏洞。</p><p>Muse 是 Meta 于9月8日推出的个人 AI 代理，可操作用户连接至它的在线账户，并能代表用户进行购买。每个用户的代理都运行在自己的云计算机上。</p><p>在那里，一层名为 <strong>Sentinel </strong>的监控层本应成为代理对外发送任何内容的唯一关口，而连接账户的密码和令牌则应始终处于代理无法触及的范围之外。</p><p>Muse 团队在发布时这样描述其目标：\"因此，我们设计该系统时假定代理可能遭到攻击，并限制潜在损害。\"</p><p>据该公司的<a href=\"https://nebusec.ai/research/meta-muse-credential-exposure/\">研究报道</a>，在演示中，代理打开的恶意页面能够将用户的对话历史和已存储的记忆提取到外部服务器并加以篡改，期间不会向用户显示任何提示。</p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgZnPU8k823yly65d9kRWaMSl4Xtd7GdxXzDOdTDqIuEUorZA-UeG27ybMfR8snN6UbzL_xHsaE_B99SQq4FPYzDD4b0aIS6dGY6GwfTUSSwNxrX_e4GQhwdSAsBzY0DbdeugAYR7i5RIPOv_jRYnjQsDzp_1_zPRN22mL22nf9P0FNh9Qvc4Xfuf69EFM/s1600/MUSE.jpg\"><img alt=\"\" src=\"/dailyinfo/media/3c1e43ec7be40779.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>研究人员随后串联利用了 Muse 内置浏览器中的一个漏洞与一个 Linux 内核漏洞，从而完全控制用户的云计算机；该助手会使用内置浏览器执行创建 PDF 等任务。他们在一份<a href=\"https://nebusec.ai/research/inside-meta-muse/\">技术拆解</a>中公开了这条利用链。</p><p>这种完全控制延伸到了凭据存储、已保存文件以及 Sentinel 本身，而这些都是 Muse 的<a href=\"https://muse.ai/blog/security-and-safety-for-ai-agents-our-approach-with-muse\">安全设计</a>刻意与代理隔离的部分。</p><p>入侵范围并未超出这一台计算机。研究人员没有从该机器突破到下方的共享服务器，也没有进入其他用户的机器。</p><p>Muse 的设计假定其自身代理可能被用于攻击用户，并会将任何入侵限制在一定范围内。该公司表示，这些控制措施均按设计发挥作用，但攻击仍然一路得逞。</p><p>该公司称，已将研究发现报告给 Muse 团队，所有漏洞利用代码均在发布前完成修复。Meta 尚未公开确认这些修复，也未对这项工作发表评论；相关报道也没有说明在补丁部署前是否有任何用户数据遭到访问。</p><p>该公司针对 Muse 的研究攻入了该助手背后的云系统，与<a href=\"https://thehackernews.com/2026/09/one-hidden-meta-muse-setting-could-let.html\">9月发现的早期 Muse 漏洞</a>不同，后者只能让已经驻留在用户 Mac 上的恶意软件劫持设备上的助手。</p><p>觉得这篇文章有意思？欢迎关注我们的 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a>，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","利用链","Agent 安全","内核","https://thehackernews.com/2026/11/a-single-malicious-webpage-let.html","The Hacker News",{"_97":98,"_99":-5},"changelogVersion","2026-10-01T08:00","release"]
