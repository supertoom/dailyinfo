[{"_1":2,"_3":4},"root",{"_5":101},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795394445000,"id","z2qvd5bzm4a0hvs2w49f6plyo","title","奥地利外交部网站遭入侵，外交人员工作联系方式泄露","originalTitle","Cyberattack on Austrian Foreign Ministry Exposes Diplomatic Staff Data","summary","奥地利外交部确认，其由外部服务商运营的网站于 November 12 至 November 13 遭未授权访问，攻击者查看了外交部总部及驻外外交机构人员的姓名和工作联系方式。","reason","source",{"_73":100},"links",{"_61":99},"publishedAt","2026-11-21T18:22:52.000Z","discoveredAt","2026-11-21T19:54:54.793Z","timelineAt","category","activity","tags",[74,96,97,98],"score",48,"selected",false,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","Pierluigi Paganini","body",{"_92":-5,"_61":93,"_94":-5,"_95":36},"outline",[83,84],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fWIlAfI1DSoA","reportCount",1,"additionalSourceCount",0,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","attack","name","攻击活动","supply-chain","供应链安全","microsoft","Microsoft / 微软",{"_80":81,"_13":82},"publicId","0f5dc0c8-c8eb-432b-b567-4382b837e235","奥地利外交部网站被入侵，员工联系方式泄露",{"_11":90,"_86":91,"_88":89},{"_11":85,"_86":87,"_88":89},"sec-2","text","Hackers accessed Austrian Foreign Ministry records containing staff contact deta","level",2,"sec-1","Austrian Foreign Ministry Hacked, Staff Contact Details Accessed","zh","<h2 id=\"sec-1\"><strong>Austrian Foreign Ministry Hacked, Staff Contact Details Accessed</strong></h2><h2 id=\"sec-2\">Hackers accessed Austrian Foreign Ministry records containing staff contact details, including employees at diplomatic missions abroad.</h2><p>Austrian Foreign Ministry confirmed a cyberattack against its website that exposed staff contact information, including details of employees working at diplomatic missions abroad. The security breach occurred between November 12 and 13, during a global <a href=\"https://securityaffairs.com/202932/security/microsoft-cloud-outage-hits-outlook-teams-copilot-and-ai-services.html\">Microsoft outage</a>, and raises questions about the security of government websites and the risks associated with services managed by external providers.</p><p>According to the ministry, attackers gained unauthorized access to a website operated by an external service provider. The intrusion was detected on November 13, and authorities said they stopped it immediately.</p><p>“”Between November 12 and 13, the foreign ministry’s website, which is operated by an external service provider, was accessed in an unauthorized ​manner,” the ministry said in a statement, adding that it happened ​during a global <a href=\"https://www.reuters.com/technology/microsoft-365-outlook-down-thousands-us-users-downdetector-shows-2026-11-12/\">Microsoft outage</a>.” <a href=\"https://www.reuters.com/technology/austrian-foreign-ministry-says-its-website-was-hacked-staff-details-viewed-2026-11-20/\">Reuters reports</a>. </p><p>The ministry confirmed that the hack was detected on November 13 ⁠and government staff stopped it immediately.</p><p>An investigation by a team of cybersecurity experts found that the intruders had viewed records containing the names and professional contact details of ministry employees. The information covered both staff at the ministry’s headquarters in Vienna and personnel working at Austrian diplomatic missions abroad.</p><p><em>“An investigation by a team of experts ​found that during the unauthorized access, data records were viewed that listed ​the names and work contact details of employees at ministry headquarters as well as at diplomatic missions abroad,” the ministry added.</em></p><p>The Austrian authorities have not disclosed how many records were accessed, whether the attackers copied the information, or how they managed to enter the website. They have also not identified the vulnerability or attack technique used.</p><p>The ministry stressed that the incident did not affect citizens’ personal information. According to Austrian public broadcaster <a href=\"https://orf.at/stories/3448812/?TB_iframe=true&amp;caption=news.ORF.at&amp;height=650&amp;keepThis=true&amp;width=850&amp;utm_source=chatgpt.com\">ORF</a>, the authorities reported the incident to the Federal Office for Cyber Security and the Data Protection Authority, while also launching additional technical security checks.</p><p><em>“The Foreign Ministry emphasized that it was taking the incident “very seriously.” The integrity of the infrastructure was of the highest priority. The systems were subject to strict security regulations and continuous monitoring, it stated. The incident had also prompted additional technical security checks.” <a href=\"https://orf.at/stories/3448812/?TB_iframe=true&amp;caption=news.ORF.at&amp;height=650&amp;keepThis=true&amp;width=850&amp;utm_source=chatgpt.com\">states ORF</a>. “The Foreign Ministry has been repeatedly targeted by cyberattacks. At the beginning of 2020, there was a serious cyberattack that lasted until February. In April 2022, there were cyberattacks involving phishing emails.”</em></p><p>The timing of the incident is also noteworthy. The ministry said the intrusion coincided with a global Microsoft service outage, but it hasn’t established any connection between the two events. A major service disruption can complicate incident response and monitoring, but the available information doesn’t show that attackers exploited the outage to gain access.</p><p>Attribution remains another unanswered question. The ministry hasn’t named any suspected country or threat group, and there’s no evidence linking this particular intrusion to a state-sponsored operation.</p><p>However, the incident comes against a difficult diplomatic background. Austria has maintained military neutrality but has politically supported Ukraine since Russia’s full-scale invasion in 2022. In July 2026, Vienna publicly accused Moscow of being responsible for a cyberattack against the Foreign Ministry in late 2019 and early 2020, joining eight other EU member states in condemning Russian cyber operations.</p><p><em>“The ministry did not suggest who might be responsible.” states Reuters.</em></p><p>Russia has repeatedly rejected Western accusations of hacking. Diplomatic tensions have also increased following Vienna’s decision to expel four Russian diplomats in October, bringing the total number of Russian diplomats declared persona non grata by Austria since 2020 to 18. Moscow promised an appropriate response and subsequently expelled an Austrian trade delegate working at the country’s embassy in Russia.</p><p><em>“Russia has repeatedly denied Western hacking allegations.” <a href=\"https://www.streetinsider.com/Reuters/Austrian%2Bforeign%2Bministry%2Bsays%2Bits%2Bwebsite%2Bwas%2Bhacked%2C%2Bstaff%2Bdetails%2Bviewed/27382043.html?utm_source=chatgpt.com\">Reuters concludes</a>.</em></p><p>Beyond the political context, this incident offers an important security lesson. Government websites may not host classified information or directly manage critical services, but they can still expose information that attackers can use to target employees, build convincing phishing campaigns, identify diplomatic personnel or gather intelligence about government operations.</p><p>The involvement of an external service provider also deserves attention. Outsourcing website management doesn’t outsource security responsibility. Public institutions need visibility into their suppliers’ security controls, access privileges, logging and incident response procedures, and must ensure that these arrangements receive regular independent checks.</p><p>Names and professional email addresses might appear to be low-value information, but they can help attackers prepare highly targeted operations. In diplomatic environments, even basic contact details can provide useful intelligence for social engineering and further intrusions.</p><p>Protecting government infrastructure also means protecting the people whose information and professional relationships can become the starting point for the next cyberattack.</p><p><strong>Follow me on Twitter:&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a><strong></strong></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;hacking,&nbsp;<strong>Austrian Foreign Ministry</strong>)</strong></p>","zhKind","complete","数据泄露","供应链","Microsoft","https://securityaffairs.com/203680/hacking/cyberattack-on-austrian-foreign-ministry-exposes-diplomatic-staff-data.html","Security Affairs",{"_102":103,"_104":-5},"changelogVersion","2026-10-01T08:00","release"]
