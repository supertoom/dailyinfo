[{"_1":2,"_3":4},"root",{"_5":101},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":54,"_55":36,"_56":36,"_57":58,"_59":60,"_61":62},"expiresAt",1794271240000,"id","zty74ssg50q1mndnvfzwhfqfu","title","法国银行 Crédit Mutuel Arkéa 遭网络攻击，约 1.33 亿美元资金被转走","originalTitle","法国银行Crédit Mutuel Arkéa内部系统被黑，近10亿元遭转账窃取","summary","法国银行 Crédit Mutuel Arkéa 证实遭遇“高度复杂的网络攻击”，攻击者入侵一家服务供应商的平台，再利用该行自有账户向其他银行机构转账，所得资金可能经专业平台兑换成加密货币。银行称客户账户未被访问、客户资产未受影响，部分兑换资产已被冻结，事件已得到控制；其认可外界估算的损失规模基本属实，但最终金额尚未确定，并正与司法和执法部门合作追查。","reason","source",{"_76":100},"links",{"_91":99},"publishedAt","2026-11-05T16:55:15.297Z","discoveredAt","2026-11-05T17:55:15.307Z","timelineAt","category","activity","tags",[77,96,97,98],"score",75,"selected",true,"channel","news","story",{"_87":88,"_13":89},"x","sameEvent",{"_11":94,"_13":95},"readingMode","full","author","body",{"_62":90,"_91":-5,"_92":91,"_93":36},"outline",[],"relatedStories",[86],"topics",[69,70,71,72,73],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation",false,"bodyLanguage","zh","factId","fI9FC1LTMdnA","reportCount",7,"additionalSourceCount",6,{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","attack","name","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","identity","身份与访问","supply-chain","供应链安全",{"_87":88,"_13":89},"publicId","12d9e017-9be0-4300-8768-9fc05ccfd8db","Crédit Mutuel Arkéa遭欺诈攻击","<p>\n                    该银行表示，此次攻击活动手法“高度复杂”，并非内部人为失误；该银行强调，攻击者使用银行自有账户进行转账，客户账户和资产未受影响，该事件不会对银行的财务状况造成影响。\n                </p><p>前情回顾·银行业网络威胁态势</p><ul><li><p><a href=\"https://www.secrss.com/articles/91624\">伊朗主要银行遭网络入侵瘫痪，卡系统/ATM终端/App全部中断</a></p></li><li><p><a href=\"https://www.secrss.com/articles/90367\">上市银行将大量客户隐私数据上传给了未授权AI</a></p></li><li><p><a href=\"https://www.secrss.com/articles/89119\">员工未授权访问客户数据超2年，银行巨头被罚超2.5亿元</a></p></li><li><p><a href=\"https://www.secrss.com/articles/81210\">网络战破坏金融稳定！伊朗两家主要银行数据遭擦除</a></p></li></ul><p>安全内参11月5日消息，法国大型银行Crédit Mutuel Arkéa证实，该行遭遇了一起“高度复杂的网络攻击”。此前有报道称，黑客从该行窃取了约1.33亿美元（约合人民币8.87亿元）。</p><p>该行在一份公告中表示，攻击者入侵了一家未具名服务供应商，再利用银行自身的账户发起资金转账。该行强调，客户账户没有被访问，客户资产也不会受到此次事件影响。</p><p><img src=\"/dailyinfo/media/659d4d7acae44ec2.webp\" loading=\"lazy\" decoding=\"async\"></p><p>美国区块链调查人员ZachXBT在周一披露了此次事件。ZachXBT以化名开展调查，随后将Crédit Mutuel Arkéa确认为疑似受害机构，并指出攻击持续了数天。ZachXBT分析了加密货币交易所账户的提现记录，以及疑似用于洗钱的资产转移交易。他据此估计，被盗资金超过1.33亿美元。</p><p>Crédit Mutuel Arkéa于周三晚间发布声明，未确认具体损失金额，但表示外界估算的金额规模基本属实。声明称：“发现攻击后，我们立即按既定危机处置程序采取了必要措施。目前，事件已得到控制。”</p><p>攻击者通过供应商入侵</p><p>银行内部系统实施转账</p><p>法国当地媒体此前报道称，攻击者通过该行旗下网上银行子公司Fortuneo入侵，并利用该平台发起首笔转账。该行对此予以否认。</p><p>该行表示，攻击者是“通过我们一家服务供应商的平台”入侵集团内部系统的。该行还称，此次攻击手法“高度复杂”，并非人为失误，但未透露更多技术细节。</p><p>声明指出：“攻击者利用Crédit Mutuel Arkéa自身的账户，向其他银行机构转账。随后，这些资金可能通过专业平台兑换成加密货币。”</p><p>该行表示，部分兑换后的资产已被冻结，目前正努力追回其余资金。</p><p>尽管最终损失金额尚未确定，Crédit Mutuel Arkéa强调，此次事件造成的损失“绝不会危及集团的偿付能力或财务状况”。根据该行最近公布的年度报告，其总资产超过2370亿美元。</p><p>该行在声明中表示：“我们的安全系统能够迅速识别异常活动，并及时采取必要措施控制攻击。”</p><p>此外，该行正“与相关司法和执法部门合作”，查明攻击源头和作案手法。</p><p><strong>参考资料：bleepingcomputer.com</strong></p><p>声明：本文来自安全内参，版权归作者所有。文章内容仅代表作者独立观点，不代表安全内参立场，转载目的在于传递更多信息。如有侵权，请联系 anquanneican@163.com。</p>","original","zhKind","complete","q4ecagtl22d0shlsqi4lxs630","攻击者利用第三方服务商从 Crédit Mutuel Arkéa 窃取至多 1.33 亿美元","数据窃取","凭据","供应链","https://www.secrss.com/articles/95392","安全内参",{"_102":103,"_104":-5},"changelogVersion","2026-10-01T08:00","release"]
