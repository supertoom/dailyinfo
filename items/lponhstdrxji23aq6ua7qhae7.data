[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1794530487000,"id","lponhstdrxji23aq6ua7qhae7","title","币安疑遭黑客攻击，被盗资产或超420亿元","originalTitle","币安疑遭史上最大黑客盗窃案，被盗资产或超420亿元","summary","币安披露潜在安全事件，称截至10月30日已冻结资金总额约30亿美元，并承担全部黑客攻击损失。Arkham首席执行官MiguelMorel表示，数十亿美元资产疑被身份不明的攻击者盗取，但具体原因尚未确认；此前相关钱包出现异常资金转出。","reason","事件涉及加密资产交易所的资金转出与多机构冻结，冻结金额和处置状态有助于评估资金流向及影响范围。","source",{"_75":97},"links",{"_90":96},"publishedAt","2026-10-30T10:23:00.000Z","discoveredAt","2026-10-30T14:45:16.526Z","timelineAt","category","activity","tags",[76,93,94,95],"score",77,"selected",true,"channel","news","story",{"_86":87,"_13":88},"x","readingMode","full","author","body",{"_61":89,"_90":-5,"_91":90,"_92":37},"outline",[],"relatedStories",[85],"topics",[68,69,70,71,72],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fTn5eLvHf5GE","reportCount",1,"additionalSourceCount",0,{"_73":83,"_75":84},{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","attack","name","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","crypto","密码学","identity","身份与访问",{"_86":87,"_13":88},"publicId","59dacd11-5115-4d28-b75a-80ffde65008a","币安披露疑似被盗事件并冻结资金","<p><span>安全内参</span> <span>2026-10-30 18:23</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/baa4d9423caae4a8.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>关注我们</span></strong></p><p><strong><span>带你读懂网络安全</span></strong></p><p><span><span>一台失陷运维终端，或将改写全球加密资产盗窃纪录。</span></span></p><p><span><span><span>澎湃新闻记者 胡志挺</span></span></span></p><p><span>全球最大的加密货币交易所币安披露潜在安全事件，称将承担全部黑客攻击损失。</span></p><p><span>10月30日，币安表示，截至目前，冻结资金总额约30亿美元。币安团队继续与执法部门、资产发行方、区块链情报机构及行业合作伙伴密切协作，追踪并冻结更多相关资产。</span></p><p><span>据外媒报道，区块链情报公司Arkham首席执行官MiguelMorel表示，数据显示，币安似乎有数十亿美元资产被身份不明的攻击者盗取，但事件具体原因尚未确认。</span></p><p><span>此前，币安相关钱包出现大规模异常资金转出，Tether、Circle等多家稳定币发行方随后参与冻结涉事资产。</span></p><p><span>币安在公告中表示，正在全力推进问题解决，并将承担因此产生的全部损失。作为预防性安全措施，在团队开展安全检查、冻结相关资金并与执法部门协作期间，所有充值和提现功能暂停。币安联合创始人何一也表示，用户资金安全，币安将承担全部因黑客攻击造成的损失。</span></p><p><span>在最初回应中，币安回应称，已关注到有关潜在安全问题的报告，目前相关团队正在积极展开调查。用户资金是安全的。安全团队正紧急核查所有相关信息。一旦有确认的消息，将第一时间通过币安官方渠道发布最新进展。同时，币安提醒用户，提高警惕，谨防诈骗，切勿轻信非官方链接、消息或任何索取账户信息的请求。</span></p><p><span>币安创始人赵长鹏也在社交平台表示，此次事件“看起来像是针对币安的黑客攻击”。他称，虽然已不再管理币安，但作为股东，期望所有用户资金都能得到全额保障。</span></p><p><span>此次涉事资金的冻结涉及多家机构。USDT发行方Tether表示，已冻结与此次事件有关的逾15.67亿枚USDT；USDC发行方Circle也确认，已冻结逾8亿美元相关资产。何一还表示，Ripple协助冻结了约2亿美元资金。</span></p><p><span>目前，币安尚未公布此次事件的具体原因、涉及资产总额及最终损失。</span></p><p><strong><span><span>推荐阅读</span></span></strong></p><ul><li><p><span><a href=\"http://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247499450&amp;idx=2&amp;sn=2da3ca2e0b4d4f9f56ea7f7579afc378&amp;chksm=ebfab99adc8d308c3ba6e7a74bd41beadf39f1b0e38a39f7235db4c305c06caa49ff63a0cc1d&amp;scene=21#wechat_redirect\">网安智库平台长期招聘兼职研究员</a></span></p></li><li><p><span><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247501251&amp;idx=1&amp;sn=8b6ebecbe80c1c72317948494f87b489&amp;chksm=ebfa82e3dc8d0bf595d039e75b446e14ab96bf63cf8ffc5d553b58248dde3424fb18e6947440&amp;token=525430415&amp;lang=zh_CN&amp;scene=21#wechat_redirect\">欢迎加入“安全内参热点讨论群”</a></span></span></p></li></ul><hr><p><span><span>文章来源：澎湃新闻</span></span></p><p><span><span>点击下方卡片关注我们，</span></span></p><p><span><span>带你一起读懂网络安全 ↓</span></span></p><p><a href=\"https://www.secrss.com/?wx\">阅读原文</a></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=40188451&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzI4NDY2MDMwMw%3D%3D%26mid%3D2247516805%26idx%3D2%26sn%3D3e61732c196efcd144aad1180f43fde8\">跳转微信打开</a></p>","original","zhKind","complete","数据窃取","加密","凭据","https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&mid=2247516805&idx=2&sn=3e61732c196efcd144aad1180f43fde8","安全内参",{"_99":100,"_101":-5},"changelogVersion","2026-10-01T08:00","release"]
