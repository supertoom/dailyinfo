[{"_1":2,"_3":4},"root",{"_5":103},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795653634000,"id","a0yjxc97vqkvhyceak5sspmns","title","Rapid7 入选 2026 Gartner® 魔力象限集成安全运营中心系统领导者","originalTitle","Rapid7 Named a Leader in the 2026 Gartner® Magic Quadrant™ for Integrated Security Operations Center Systems","summary","Rapid7 被列为 2026 Gartner® 魔力象限集成安全运营中心系统（Integrated Security Operations Center Systems）的领导者，其 Rapid7 Command Platform 下的 Rapid7 Incident Command 将 SIEM、SOAR、DFIR、攻击面管理与威胁情报整合进同一 SOC 视图。","reason","source",{"_72":102},"links",{"_61":101},"publishedAt","2026-11-25T18:34:43.000Z","discoveredAt","2026-11-25T19:26:24.780Z","timelineAt","category","blue-team","tags",[98,99,100,45],"score",6,"selected",false,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","Rapid7","body",{"_94":-5,"_61":95,"_96":-5,"_97":36},"outline",[82,83,84],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fnfE4dh4CaRw","reportCount",1,"additionalSourceCount",0,{"_71":76,"_72":77},{"_71":74,"_72":75},{"_71":30,"_72":73},"slug","name","蓝队与运营","tools","工具与平台","rapid7","Rapid7 / Metasploit",{"_79":80,"_13":81},"publicId","4431248e-3d89-45eb-b2bb-4907b8622ed3","Rapid7获评SOC魔力象限领导者",{"_11":92,"_86":93,"_88":89},{"_11":90,"_86":91,"_88":89},{"_11":85,"_86":87,"_88":89},"sec-3","text","Context to act, not another console to check","level",2,"sec-2","The importance of exposure management in the SOC","sec-1","Our perspective: less stitching, more stopping threats","zh","<p><span><em>Recognized for Completeness of Vision and Ability to Execute.</em></span></p><p><span>We are proud to share that Rapid7 has been recognized as a Leader in the 2026 Gartner® Magic Quadrant™ for Integrated Security Operations Center Systems.&nbsp;</span></p><h2 id=\"sec-1\">Our perspective: less stitching, more stopping threats</h2><p><span>Most security teams don't struggle to find tools. They struggle to make them work together. We believe SOC analysts lose too much of their day moving between consoles and matching alerts to assets by hand, which is time not spent stopping threats.</span></p><p><span>To us, an integrated approach to security operations means detection, investigation and response working from the same data and the same view, so analysts can get from \"what fired?\" to \"what do we do about it?\" faster. </span></p><h2 id=\"sec-2\"><span>The importance of exposure management in the SOC</span></h2><p><span>Rapid7 Incident Command, part of the Rapid7 Command Platform, brings together SIEM, SOAR, DFIR, attack surface management and threat intelligence. We built it on the idea that exposure management, and the context it brings, belongs inside the SOC, not next to it. In our view, when an alert arrives with what we know about the asset and how exposed it is, analysts can prioritize what matters instead of working from separate vulnerability reports and alert queues.</span></p><h2 id=\"sec-3\">Context to act, not another console to check</h2><p><span>We believe adopting an integrated SOC shouldn't be all-or-nothing. Incident Command is available in tiers from Essentials to Ultimate, so teams that want extra coverage can add managed services. That helps resource-pressured teams to start with what they need and grow at their own pace, spending less time building and maintaining integrations and more time on investigations.</span></p><p><span>To us, security operations work best when analysts have the context to act, not another console to check. We're proud to be recognized as a Leader in this Magic Quadrant, and we believe it reflects our focus on bringing detection, response and exposure context together for our customers. </span><br>⠀<br><span>The Gartner Magic Quadrant evaluates vendors based on their Ability to Execute and Completeness of Vision. We are honored to be included among the recognized vendors in this important report. Learn more about the Gartner Magic Quadrant </span><a href=\"https://www.gartner.com/en/research/magic-quadrant\"><span>here</span></a><span>.&nbsp;</span></p><p>⠀</p><p><span><em>Gartner, Magic Quadrant for Integrated Security Operations Center Systems, Angel Berrios, Kevin Schmidt, Eric Ahlm, 24 November 2026.</em></span></p><p><span><em>Gartner does not endorse any vendor, product or service depicted in its research publications, and does not advise technology users to select only those vendors with the highest ratings or other designation. Gartner research publications consist of the opinions of Gartner’s research organization and should not be construed as statements of fact. Gartner disclaims all warranties, expressed or implied, with respect to this research, including any warranties of merchantability or fitness for a particular purpose.</em></span></p><p><span><em>GARTNER is a registered trademark and service mark of Gartner, Inc. and/or its affiliates in the U.S. and internationally. MAGIC QUADRANT is a registered trademark of Gartner, Inc. and/or its affiliates and is used herein with permission. All rights reserved.</em></span></p>","zhKind","complete","工具评测","安全运营","检测工程","https://www.rapid7.com/blog/post/so-rapid7-named-leader-2026-gartner-magic-quadrant-integrated-security-operations-center-systems-isocs","Rapid7 CVE 公告",{"_104":105,"_106":-5},"changelogVersion","2026-10-01T08:00","release"]
