[{"_1":2,"_3":4},"root",{"_5":91},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795135236000,"id","g2782cgg3m6c29fmnezavphkf","title","日本 RIKEN “富岳”超算遭未授权访问，“理究”同受影响","originalTitle","全球最强超算之一因网络攻击暂停运行","summary","日本理化学研究所（RIKEN）的“富岳”和“理究”超级计算机遭外部黑客未授权访问，超过4000名用户信息可能被窃取。黑客在11月10日至13日期间利用“富岳”面向公众开放的运行状态仪表板网页进入内部网络，部分服务器被篡改并安装未经授权程序；最多涉及“富岳”4224名用户和“理究”375名用户的数据。","reason","事件同时涉及超算系统入侵、用户信息暴露风险和凭据滥用尝试，处置过程展示了关键科研基础设施遭遇网络攻击后的停机与调查路径。","source",{"_73":90},"links",{"_84":89},"publishedAt","2026-11-18T08:50:00.000Z","discoveredAt","2026-11-18T11:32:34.240Z","timelineAt","category","activity","tags",[74,87,88,76],"score",77,"selected",true,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","body",{"_61":83,"_84":-5,"_85":84,"_86":37},"outline",[],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fULHAlgaV014","reportCount",3,"additionalSourceCount",2,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","attack","name","攻击活动","incident","应急响应","identity","身份与访问",{"_80":81,"_13":82},"publicId","0d43cf29-4332-40b0-89e7-643820ebb82d","RIKEN确认富岳、理究遭入侵并停运","<p><span>安全内参编译</span> <span>2026-11-18 16:50</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/3071e97c47a21c0f.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>官方凌晨关闭超算系统</p><p><strong><span>关注我们</span></strong></p><p><strong><span>带你读懂网络安全</span></strong></p><p><img src=\"/dailyinfo/media/510e556d58fa57c3.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>曾经的全球最强、目前全球第九超算“富岳”，因遭到未授权访问紧急暂停运行，官方称用户账号信息或泄露，科研数据暂无泄露迹象；</span></span></p><p><span><span>不过官方临时关停超算的举措可谓非常审慎了，此前也曾出现超算算力被挖矿或滥用的攻击案例，并未出现过类似的应急措施。</span></span></p><p><span>前情回顾·<span>关键设施因网络攻击受干扰</span></span></p><ul><li><p><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247516472&amp;idx=1&amp;sn=757dd32416d77d9909b0c4d94cd6c033&amp;scene=21#wechat_redirect\">某发电厂因网络攻击停运4天</a></span></p></li><li><p><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247516351&amp;idx=1&amp;sn=edec3b5a25410a8bedc2fc0b38063d44&amp;scene=21#wechat_redirect\">工控遇袭！30多个地方供水系统遭协同网络攻击，有水厂临时关停</a></span></p></li></ul><ul><li><p><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247515890&amp;idx=1&amp;sn=b823b2acfb347fa244c8d5f173f3a48f&amp;scene=21#wechat_redirect\">紧急停车！某地方高铁通信系统遭入侵，多趟列车触发紧急制动刹停</a></span></p></li></ul><ul><li><p><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247516279&amp;idx=1&amp;sn=89121ecca102f1514fe0778a49d44e4d&amp;scene=21#wechat_redirect\">日本最大出租车公司因网络攻击运营中断，多项民生服务被迫暂停</a></span></p></li></ul><p><span>安全内参11月18日消息，日本理化学研究所（RIKEN）周一宣布，其运营的该国最强超级计算机“富岳”上周遭到未经授权访问，疑似发生数据泄露。</span></p><p><span><img src=\"/dailyinfo/media/65ff1b10895ff936.webp\" loading=\"lazy\" decoding=\"async\"></span></p><p><span>理化学研究所表示，两台超算“富岳” “理究”均受到影响，超过4000名用户的信息可能在此次事件中被窃取。目前尚无证据表明科研数据已被窃取，第三方个人信息是否被窃取仍在调查中。</span></p><p><span>因遭到未授权访问，</span></p><p><span>官方凌晨关闭超算系统</span></p><p><span>官方公告显示，此次可能泄露的数据主要有两类。一是用户身份认证系统中登记的信息。其中，“富岳”涉及最多4224名用户的姓名、电子邮箱地址和用户ID；另一台超算“理究”涉及最多375名用户的姓名和电子邮箱地址。二是存储在用户主目录中的文件，包括用于连接其他系统或服务的身份认证凭据，如SSH私钥、访问密钥，以及科研数据文件。</span></p><p><span>理化学研究所称，“富岳”运行系统的管理人员于11月12日发现异常通信，随即展开调查。调查确认系统遭到未经授权访问后，研究所于11月14日凌晨暂停超级计算机运行，并切断了相关访问。</span></p><p><span>调查发现，11月10日至13日期间，外部黑客利用“富岳”面向公众开放的“运行状态”仪表板网页，侵入其运行系统的内部网络。出于安全考虑，该网页目前已停止对外开放。</span></p><p><span>理化学研究所尚未查明黑客入侵系统的具体手段，也尚未发现被访问的信息已经外泄。不过，研究所确认，部分受影响的服务器遭到篡改，黑客还在其中安装了未经授权的程序。</span></p><p><span>研究所还证实，入侵者曾试图利用已获取的部分身份认证凭据连接其他系统。目前，研究人员正在调查这一行为是否造成损害，或带来进一步的安全风险。</span></p><p><span>日本政府已着手调查该事件</span></p><p><span>理化学研究所已将事件报告给负责监管“富岳”的日本文部科学省。日本内阁官房长官木原稔周二表示，相关部门正在调查事件原因及影响范围。</span></p><p><span>木原稔说：“‘富岳’是我国科研开发基础设施的重要组成部分，因此，在尽可能减少对科研活动影响的同时，优先保障其安全十分重要。”</span></p><p><span>“富岳”于2021年3月正式投入运行，由理化学研究所位于神户的计算科学研究中心负责运营。该超级计算机由理化学研究所与富士通自2010年起联合研发，耗资1300亿日元。2020年6月至2022年5月期间，“富岳”曾位居全球超级计算机运算速度排行榜榜首，直至被美国超级计算机“Frontier”超越。目前“富岳”在全球超算榜上排名第九。</span></p><p><span>同样位于神户的“理究”于上月开始运行，旨在推动AI赋能科学研究，为科研工作提供支持。日本文部科学省“AI for Science”计划遴选的科研项目也将使用这台超级计算机。</span></p><p><strong><span>参考资料：bleepingcomputer.com</span></strong></p><p><strong><span><span>推荐阅读</span></span></strong></p><ul><li><p><span><a href=\"http://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247499450&amp;idx=2&amp;sn=2da3ca2e0b4d4f9f56ea7f7579afc378&amp;chksm=ebfab99adc8d308c3ba6e7a74bd41beadf39f1b0e38a39f7235db4c305c06caa49ff63a0cc1d&amp;scene=21#wechat_redirect\">网安智库平台长期招聘兼职研究员</a></span></p></li><li><p><span><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247501251&amp;idx=1&amp;sn=8b6ebecbe80c1c72317948494f87b489&amp;chksm=ebfa82e3dc8d0bf595d039e75b446e14ab96bf63cf8ffc5d553b58248dde3424fb18e6947440&amp;token=525430415&amp;lang=zh_CN&amp;scene=21#wechat_redirect\">欢迎加入“安全内参热点讨论群”</a></span></span></p></li></ul><hr><p><span><span>点击下方卡片关注我们，</span></span></p><p><span><span>带你一起读懂网络安全 ↓</span></span></p><p><a href=\"https://www.secrss.com/?wx\">阅读原文</a></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=cfdf6add&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzI4NDY2MDMwMw%3D%3D%26mid%3D2247516914%26idx%3D1%26sn%3D426c0fa23e04540a47e2fa880436f6d1\">跳转微信打开</a></p>","original","zhKind","complete","数据泄露","凭据","https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&mid=2247516914&idx=1&sn=426c0fa23e04540a47e2fa880436f6d1","安全内参",{"_92":93,"_94":-5},"changelogVersion","2026-10-01T08:00","release"]
