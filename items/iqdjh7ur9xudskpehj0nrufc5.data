[{"_1":2,"_3":4},"root",{"_5":100},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":37,"_59":60},"expiresAt",1795308034000,"id","iqdjh7ur9xudskpehj0nrufc5","title","攻击者滥用 CyberPower PowerPanel 在域控制器运行恶意脚本","originalTitle","CyberPower PowerPanel Exploited to Run Malicious Code on Domain Controller","summary","攻击者滥用 CyberPower PowerPanel Business (PBB) 的断电脚本功能，通过 Web 控制台上传脚本并在 Windows 域控制器上以 SYSTEM 权限执行，随后投放反病毒杀手、复制存储网络账户凭据的 Active Directory 数据库，并借助 DLL sideloading 植入持久化组件。","reason","原文还原了攻击者借 PowerPanel 脚本功能取得 SYSTEM 权限并复制 Active Directory 数据库的入侵路径，便于防守方识别高价值管理软件的同类滥用风险。","source",{"_72":99},"links",{"_92":98},"publishedAt","2026-11-19T15:30:00.000Z","discoveredAt","2026-11-19T16:04:21.723Z","timelineAt","category","activity","tags",[75,96,97,77],"score",75,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","body",{"_60":91,"_92":-5,"_93":94,"_95":37},"outline",[82,83],"relatedStories",[78],"topics",[67,68,69],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","fr4yCmXvkF9A","reportCount",1,"additionalSourceCount",0,{"_70":76,"_72":77},{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","malware","name","恶意软件","attack","攻击活动","identity","身份与访问",{"_79":80,"_13":81},"publicId","d13cd814-e215-434e-a341-82b0b9ef01b2","攻击者借PowerPanel入侵域控",{"_11":89,"_85":90,"_87":88},{"_11":84,"_85":86,"_87":88},"sec-2","text","防御人员应检查什么","level",2,"sec-1","UPS 软件是如何被滥用的","<p>\n\t攻击者滥用 CyberPower 的 PowerPanel Business（PBB）软件，在域控制器上运行恶意脚本。域控制器是控制 Windows 网络登录的服务器，而攻击者借此将一项电源管理功能变成了远程命令通道。</p><p>\n\tSymantec 在 11 月 18 日发布的<a href=\"https://www.security.com/threat-intelligence/power-management-software-attack-vector\">研究</a>中详细介绍了此次入侵。PowerPanel Business 用于管理不间断电源（UPS）电池备份。由于组织依靠该软件在断电时安全关闭服务器，它通常运行在重要系统上，例如 hypervisor 以及数据库和文件服务器。</p><h2 id=\"sec-1\">\n\t<strong>UPS 软件是如何被滥用的</strong></h2><p>\n\t管理员可以配置 PPB，使其在检测到电源问题时启动脚本，而该服务会以 SYSTEM 权限执行脚本，这是 Windows 中的最高权限级别。Symantec 表示，这意味着攻击者无需利用软件漏洞，也无需设置服务或计划任务，就能运行代码。</p><p>\n\t据 Symantec 称，攻击者通过 Web 控制台上传脚本，然后利用这些脚本暂存一个杀毒软件杀手，并复制 Active Directory 数据库，该数据库存储着网络中每个账户的凭据。随后攻击者植入了一个持久化植入程序，通过<a href=\"https://www.infosecurity-magazine.com/news/eggstreme-malware-rebuilt-after/\">DLL 侧加载</a>加载；这种方式会诱使一个合法程序加载恶意库。</p><p>\n\t攻击者主要使用 Windows 自带的工具，并且在入侵期间多次重写数据收集脚本。Symantec 将这种反复试错解读为有人类操作员实时操作的迹象。</p><p>\n\t<em><a href=\"https://www.infosecurity-magazine.com/news/microsoft-chinese-ai-connectwise/\">进一步了解管理软件攻击：中国国家行为者使用 AI 攻破 ConnectWise 租户</a></em></p><h2 id=\"sec-2\">\n\t<strong>防御人员应检查什么</strong></h2><p>\n\tSymantec 没有说明攻击者是如何进入网络或 PPB 控制台的。它称，可能的入侵路径包括被盗的管理员凭据，以及该产品此前已披露的弱点，例如默认管理员密码、硬编码凭据和文件上传漏洞。</p><p>\n\tSymantec 表示，该功能“只是接受一个脚本、将其存储起来，并以 SYSTEM 身份运行”。由于 PPB 经常部署在攻击者最觊觎的机器上，它敦促组织以对待远程管理工具同样的警惕程度对待电源管理软件。</p><p>\n\t其建议包括：将控制台访问限制到指定的管理员机器；不要让控制台暴露在互联网上；更换默认管理员密码；及时修补漏洞。它还建议组织检查 PPB 运行脚本所用的文件夹，假定任何不熟悉的脚本都是恶意的；如果发现入侵指标，则重置 Active Directory 凭据；并将电源管理主机作为高价值系统加以保护。</p><p>\n\tSymantec 没有确认受害者的身份，也未将该活动与任何已知组织关联起来。由于未发现数据窃取或勒索软件，它表示攻击者的动机仍不明确。</p>","original","zhKind","translation","complete","后门","凭据","https://www.infosecurity-magazine.com/news/ups-software-abused-domain/","Infosecurity Magazine",{"_101":102,"_103":-5},"changelogVersion","2026-10-01T08:00","release"]
