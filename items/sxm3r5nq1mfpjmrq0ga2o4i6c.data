[{"_1":2,"_3":4},"root",{"_5":92},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":-5,"_57":36,"_58":59},"expiresAt",1793621626000,"id","sxm3r5nq1mfpjmrq0ga2o4i6c","title","Security Affairs Malware Newsletter 第 121 轮汇总：Android 间谍软件、Magento 商店攻击及恶意 Claude Code 等威胁","originalTitle","SECURITY AFFAIRS MALWARE NEWSLETTER ROUND 121","summary","Security Affairs 第 121 轮 Malware Newsletter 汇总多篇恶意软件与研究资讯，涵盖针对 WeChat、Telegram 等应用的 Android 间谍软件、命中 953 家商店的 Magento CMS 区块加载器，以及伪装成 Anthropic.claude-code 2.1.313 的恶意版本。","reason","source",{"_67":91},"links",{"_59":90},"publishedAt","2026-11-01T17:25:24.000Z","discoveredAt","2026-11-01T18:31:34.840Z","timelineAt","category","activity","tags",[68,87,70,88,74,89],"score",7,"selected",false,"channel","news","story","x","readingMode","full","author","Pierluigi Paganini","body",{"_83":-5,"_59":84,"_85":-5,"_86":36},"outline",[77],"relatedStories",[],"topics",[60,61,62,63,64],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_65":75,"_67":76},{"_65":73,"_67":74},{"_65":71,"_67":72},{"_65":69,"_67":70},{"_65":66,"_67":68},"slug","malware","name","恶意软件","ai-offense","AI 攻防","ai-agent","AI Agent 安全","mobile","移动端","supply-chain","供应链安全",{"_11":78,"_79":80,"_81":82},"sec-1","text","Security Affairs Malware newsletter includes a collection of the best articles a","level",2,"zh","<h2 id=\"sec-1\">Security Affairs Malware newsletter includes a collection of the best articles and research on malware in the international landscape</h2><p>Malware Newsletter</p><p><a href=\"https://www.0x0v1.com/ucreator-virtualization-based-android-spyware-platform-targeting-wechat-telegram-and-other-messaging-apps/\">uCreator: virtualization-based Android spyware platform targeting WeChat, Telegram and other messaging apps</a>&nbsp;&nbsp;</p><p><a href=\"https://sansec.io/research/magento-cms-block-loader-deepveindrilling\">deepveindrilling.com: Magento CMS block loader hits 953 stores</a>&nbsp;&nbsp;</p><p><a href=\"https://x.com/starmexxx/status/2114351627247243564\">CLAUDE CODE FOUND SPYWARE ON MY FAMILY’S PHONES AND A BACKDOOR ON MY MAC</a></p><p><a href=\"https://securelist.com/lazarus-operation-flashhole/121541/\">Operation FlashHole: Lazarus breaks security, defies control</a>&nbsp;&nbsp;</p><p><a href=\"https://cursor.com/blog/claude-code-extension-security-notice\">Security notice — malicious version of Anthropic.claude-code (2.1.313) identified in the Cursor Extension Marketplace</a>&nbsp;&nbsp;</p><p><a href=\"https://research.checkpoint.com/2026/tricks-from-the-past-deployed-via-signed-chatgpt-and-claude-binaries/\">Tricks from the Past deployed via signed ChatGPT and Claude binaries</a></p><p><a href=\"https://www.bleepingcomputer.com/news/security/trezor-warns-of-suspected-crypto-theft-implant-in-hardware-wallet/\">Trezor warns of suspected crypto-theft implant in hardware wallet</a></p><p><a href=\"https://pluto.security/blog/hugging-face-malware-campaign-load-mine/\">Load/Mine: A Hugging Face Malware Campaign Returns After Takedown</a></p><p><a href=\"https://www.mdpi.com/2079-9292/15/21/5021\">Decoding Maliciousness: LLM-Assisted Semantic Filtering for Scalable Malicious PyPI Package Detection</a></p><p><a href=\"https://www.mdpi.com/2079-9292/15/21/5013\">A Two-Stage Selective Deep Learning Framework for Malware Family Classification in Encrypted Network Traffic</a></p><p><a href=\"https://arxiv.org/abs/2610.36612\">Silent Blindness: Fault Vulnerability of Hardware Malware Detectors</a></p><p><a href=\"https://arxiv.org/abs/2610.39351\">Measuring Duplication, Leakage, and Rendering Dependence in Malware-as-Image Benchmarks</a></p><p><strong>Follow me on Twitter:&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;hacking,&nbsp;<a href=\"https://securityaffairs.com/200354/security/security-affairs-malware-newsletter-round-117.html\">newsletter</a>)</strong></p>","zhKind","complete","汇总","供应链投毒","大模型","https://securityaffairs.com/202209/malware/security-affairs-malware-newsletter-round-121.html","Security Affairs",{"_93":94,"_95":-5},"changelogVersion","2026-10-01T08:00","release"]
