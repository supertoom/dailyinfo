[{"_1":2,"_3":4},"root",{"_5":95},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795826439000,"id","flqnwk4yjqaic0u463607umsv","title","FIFA 确认遭黑客入侵，Handsome Boy Hacking Club 声称窃取内部治理与个人资料","originalTitle","FIFA hacked, cybercriminals claim access to sensitive internal records","summary","国际足联确认网络犯罪者入侵其系统并获取「有限范围的个人和业务信息」，正与执法等机构合作调查，遭袭时间与具体数据类型未披露。","reason","source",{"_74":94},"links",{"_61":93},"publishedAt","2026-11-27T13:21:50.000Z","discoveredAt","2026-11-27T14:20:20.454Z","timelineAt","category","activity","tags",[75,90,91,92],"score",61,"selected",false,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Sinisa Markovic","body",{"_86":-5,"_61":87,"_88":-5,"_89":36},"outline",[],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fTxcF6H1FbSw","reportCount",4,"additionalSourceCount",3,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","attack","name","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","microsoft","Microsoft / 微软",{"_83":84,"_13":85},"publicId","1ab2de17-8bbc-419b-9dc9-438c6e2bd08b","FIFA确认遭入侵，自称HBHC的组织宣称泄露超12GB数据","zh","<p>Cybercriminals broke into FIFA’s systems and gained access to “a limited set of personal and business information,” world football’s governing body confirmed on Thursday.</p><p>“FIFA is working closely with the relevant authorities, including law enforcement,” the Zurich-based football governing body told The Associated Press, without saying when the attack happened or what kind of information the intruders took.</p><p>“FIFA condemns in the strongest possible terms the unlawful acquisition and publication of information, particularly personal data. Such actions constitute a serious and unacceptable violation of privacy and can have significant consequences for the individuals concerned,” a FIFA spokesperson <a href=\"https://apnews.com/article/fifa-cyberattack-hack-6de93d5f8bcc655c774e2e41e2dfea1f\">added</a>.</p><p>The confirmation came a week after a group calling itself the Handsome Boy Hacking Club (HBHC) posted a screenshot on <a href=\"https://x.com/DarkWebInformer/status/2124186095222976650\">X</a> of what it said were FIFA files.</p><p>According to the group, the data was exported from FIFA’s Microsoft environment, and the haul contains “a full export from their internal governance systems, as well as some other assorted documents and screenshots from various services.”</p><p>The post lists identity documents, immigration records, executive information, financial data and legal documents among the stolen material.</p><p>HBHC is a relatively new cybercrime group that <a href=\"https://www.ransomware.live/id/RnJvbnRpZXIgQ29tbXVuaWNhdGlvbnNASGFuZHNvbWUgQm95IEhhY2tpbmcgQ2x1Yg\">listed</a> its first victim on its data leak site on November 19.</p><p>“We would like to clarify that we are purely financially motivated. We are not interested in the country of origin,” the gang wrote, before signing off with a promise of “more leaks soon.“</p><p>The attack couldn’t have come at a worse time for FIFA president Gianni Infantino, who is under <a href=\"https://www.aljazeera.com/sports/2026/7/31/fifa-forced-to-scrap-world-cup-private-investment-plan-after-backlash\">scrutiny</a> after a scrapped plan to sell stakes in the World Cup to private investors.</p><p>FIFA is the second football organization to disclose a cyberattack this week. On Monday, Spain’s LaLiga <a href=\"https://www.laliga.com/noticias/laliga-ha-sido-victima-de-un-ciberataque-que-ha-afectado-a-datos-personales-de-aficionados\">confirmed</a> that a cybercriminal broke into one of its fan services platforms and stole personal data of people registered with the league’s digital services and those of some clubs.</p>","zhKind","complete","数据泄露","Microsoft","数据窃取","https://www.helpnetsecurity.com/2026/11/27/fifa-cyberattack-data-leak/","Help Net Security",{"_96":97,"_98":-5},"changelogVersion","2026-10-01T08:00","release"]
