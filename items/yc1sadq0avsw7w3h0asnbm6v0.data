[{"_1":2,"_3":4},"root",{"_5":198},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":60,"_61":62},"expiresAt",1794444101000,"id","yc1sadq0avsw7w3h0asnbm6v0","title","Unit 42 披露 Falcon 浏览器 C2 框架攻击 5 国政府机构","originalTitle","The XG Files: Falcon C2 Flying Under The (Browser) Radar","summary","Unit 42 发现攻击者利用 Falcon 浏览器 C2 框架入侵至少 5 个国家政府机构的 webmail、政府应用与内部系统，窃取密码、邮件、会话 cookie、通讯和内部文档。","reason","文章拆解了浏览器内 C2、扩展侧载与 Antino 投递链路，并给出 IOC 和异常活动线索，便于识别高度隐蔽的定向入侵。","source",{"_77":46},"links",{"_191":197},"publishedAt","2026-11-11T15:00:23.000Z","discoveredAt","2026-11-11T20:17:11.646Z","timelineAt","category","activity","tags",[82,80,194,195,88,196],"score",78,"selected",true,"channel","news","story",{"_90":91,"_13":92},"x","readingMode","full","author","Unit 42","body",{"_62":190,"_191":-5,"_192":191,"_193":37},"outline",[93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123],"relatedStories",[89],"topics",[69,70,71,72,73,74],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation",false,"bodyLanguage","zh","factId","ftDvEyBtDfxA","reportCount",1,"additionalSourceCount",0,{"_75":87,"_77":88},{"_75":85,"_77":86},{"_75":83,"_77":84},{"_75":81,"_77":82},{"_75":79,"_77":80},{"_75":76,"_77":78},"slug","research","name","技术研究","malware","恶意软件","attack","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","browser","浏览器",{"_90":91,"_13":92},"publicId","1c27f22e-5f90-4620-9959-11ff1ff747b3","Falcon浏览器C2框架入侵五国政府机构",{"_11":188,"_125":189,"_127":128},{"_11":186,"_125":187,"_127":128},{"_11":184,"_125":185,"_127":128},{"_11":182,"_125":183,"_127":128},{"_11":180,"_125":181,"_127":133},{"_11":178,"_125":179,"_127":133},{"_11":176,"_125":177,"_127":133},{"_11":174,"_125":175,"_127":133},{"_11":172,"_125":173,"_127":128},{"_11":170,"_125":171,"_127":133},{"_11":168,"_125":169,"_127":133},{"_11":166,"_125":167,"_127":133},{"_11":164,"_125":165,"_127":133},{"_11":162,"_125":163,"_127":133},{"_11":160,"_125":161,"_127":133},{"_11":158,"_125":159,"_127":133},{"_11":156,"_125":157,"_127":133},{"_11":154,"_125":155,"_127":133},{"_11":152,"_125":153,"_127":133},{"_11":150,"_125":151,"_127":128},{"_11":148,"_125":149,"_127":128},{"_11":146,"_125":147,"_127":128},{"_11":144,"_125":145,"_127":128},{"_11":142,"_125":143,"_127":128},{"_11":140,"_125":141,"_127":128},{"_11":138,"_125":139,"_127":133},{"_11":136,"_125":137,"_127":133},{"_11":134,"_125":135,"_127":128},{"_11":131,"_125":132,"_127":133},{"_11":129,"_125":130,"_127":128},{"_11":124,"_125":126,"_127":128},"sec-31","text","Additional Resources","level",2,"sec-30","Indicators of Compromise","sec-29","Palo Alto Networks Protection and Mitigation",3,"sec-28","Conclusion","sec-27","Command and Control","sec-26","Persistence","sec-25","Antino Implant","sec-24","Southeast Asian Country B - Justice Entity (Falcon Browser Extension)","sec-23","Southeast Asian Country A - Police Entity (Username Harvesting and Antino Implan","sec-22","Middle Eastern Country (Roundcube Webmail)","sec-21","Campaign Tracking","sec-20","Possible AI-Assisted Development","sec-19","Continuously Monitoring - Credentials Store, History and Downloads","sec-18","X/Twitter Direct Messages Exfiltration","sec-17","Clipboard Hijacking","sec-16","Gmail Exfiltration","sec-15","Zalo Chat Database Exfiltration","sec-14","Discord Messages and Friends List Exfiltration","sec-13","Network Hooking","sec-12","Download Intercept","sec-11","Web Proxy","sec-10","Extension Initialization","sec-9","Falcon Browser Extension","sec-8","Command Dispatch","sec-7","Cryptographic Key Exchange","sec-6","C2 Communication","sec-5","Victim Persistence and Tracking","sec-4","The Falcon Implant","sec-3","Overlap with PeckBirdy","sec-2","Hiding in Plain Sight","sec-1","Executive Summary","<h2 id=\"sec-1\">Executive Summary</h2><p>Unit 42 has identified Falcon (aka XG or Xiàng Gē), which is a command and control (C2) framework that compromises victims' browsers by running malicious JavaScript. An actor leveraged Falcon to compromise visitors of webmail portals and government web applications by placing malicious JavaScript directly within these sites.</p><p>Operating entirely inside the browser context, attackers have used the framework to sideload malicious Chrome extensions and steal the following information:</p><ul>\n<li>Passwords</li>\n<li>Emails</li>\n<li>Session cookies</li>\n<li>Communications</li>\n</ul><p>Falcon also served as a delivery mechanism for an&nbsp;implant we call&nbsp;Antino, which uses Microsoft OneDrive as a C2 channel.</p><p>Our analysis identified the compromise of government entities in one Middle Eastern country and four Southeast Asian countries between March and May 2026. The campaigns we observed targeted ministries of foreign affairs, defense and interior, and law enforcement agencies, consistent with strategic intelligence collection objectives.</p><p>Palo Alto Networks customers are better protected from the threats discussed in this article through the following products and services:</p><ul>\n<li><a href=\"https://docs.paloaltonetworks.com/wildfire\">Advanced WildFire</a></li>\n<li><a href=\"https://docs.paloaltonetworks.com/advanced-url-filtering/administration/url-filtering-basics/how-url-filtering-works\">Advanced URL Filtering</a> and <a href=\"https://docs.paloaltonetworks.com/dns-security/administration/about-dns-security\">Advanced DNS Security</a></li>\n<li><a href=\"https://docs-cortex.paloaltonetworks.com/p/XDR\">Cortex XDR</a> and <a href=\"https://docs-cortex.paloaltonetworks.com/p/XSIAM\">XSIAM</a></li>\n<li><a href=\"https://www.koi.ai/product/endpoint\">Cortex Agentic Endpoint Security</a></li>\n<li><a href=\"https://docs.paloaltonetworks.com/prisma-access-browser\">Prisma Browser</a></li>\n<li><a href=\"https://docs.cyberark.com/epm/latest/en/content/intro/introduction.htm\">Idira Endpoint Privilege Manager (EPM)</a></li>\n<li><a href=\"https://www.paloaltonetworks.com/idira/human/identity-and-access-management\">Idira Identity and Access Management (IAM)</a></li>\n</ul><p>Organizations can access tailored adversary intelligence, direct analyst consultations, and specialized exposure tracking through <a href=\"https://www.paloaltonetworks.com/unit42/threat-intelligence\">Unit 42 Threat Intel Services</a> and its <a href=\"https://www.paloaltonetworks.com/resources/datasheets/unit-42-deep-and-dark-web-service\">Deep and Dark Web Service</a>.</p><p>If you think you might have been compromised or have an urgent matter, contact the <a href=\"https://start.paloaltonetworks.com/contact-unit42.html\">Unit 42 Incident Response team</a>.</p><h2 id=\"sec-2\">Hiding in Plain Sight</h2><p>Falcon C2 management panels are designed to remain semi-hidden. When accessed, the panel displays a blank page with no visible branding or login interface.</p><p>To deter casual inspection, the page disables the right-click context menu via a global contextmenu listener that calls <span>preventDefault()</span>. The login form also stays hidden until the F9 key is pressed three consecutive times; any other keystroke resets the counter.</p><p>Figure 1 below shows the JavaScript code for this key tracking.</p><figure><img src=\"/dailyinfo/media/07536c9d695b3d5d.webp\" srcset=\"/dailyinfo/media/9fc464dbfc8b12b4.webp 720w, /dailyinfo/media/91ab85d0775d001f.webp 1200w, /dailyinfo/media/07536c9d695b3d5d.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Screenshot of a JavaScript code snippet detecting key press events. If the key is &quot;p&quot; and pressed three times, a function is triggered. The else block resets the count to zero for other keys.\" width=\"786\" height=\"440\"><figcaption>Figure 1. F9 key Tracking.</figcaption></figure><p>Once triggered, the page displays a branded Falcon panel featuring a stylized bird logo and credential input fields. This operational security (OPSEC) mechanism ensures that it does not directly expose the login page to bots, unintended visitors and automated systems that grab webpage screenshots.</p><p>Figure 2 below shows a screenshot of the login panel.</p><figure><img src=\"/dailyinfo/media/ad41bb6de6075c7c.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Login screen for &quot;Falcon&quot; with a blue falcon logo at the top. It includes fields for &quot;Username&quot; and &quot;Password&quot; with an eye icon for password visibility. Below is a blue &quot;Sign In&quot; button.\" width=\"590\" height=\"679\"><figcaption>Figure 2. The Falcon login panel is revealed after pressing F9 three times.</figcaption></figure><p>Falcon is written in NodeJS and has two listeners. One listener is for the management panel interface on TCP port 8080 and the victim-facing listener is on TCP port 443.</p><p>On the victim-facing listener, we observed a JavaScript-based version of the classic game Tetris serving as the default page, designed to blend in further. Another instance hosted a game of Snake. Figure 3 below shows both versions.</p><figure><img src=\"/dailyinfo/media/6a45af5ed63b8391.webp\" srcset=\"/dailyinfo/media/e66b1adb91c0af38.webp 720w, /dailyinfo/media/d0888554fb5c2a60.webp 1200w, /dailyinfo/media/6a45af5ed63b8391.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Split image showing two different video games. On the left, a Tetris game with various colored blocks stacked and a score of 4200. On the right, a Snake game with a green snake navigating towards a red dot, scoring 460. Both games prompt, &quot;Use arrow keys to play&quot;.\" width=\"900\" height=\"609\"><figcaption>Figure 3. JavaScript version of Tetris and Snake hosted on the C2 server.</figcaption></figure><h2 id=\"sec-3\">Overlap with PeckBirdy</h2><p>In January 2026, Trend Micro reported on a scripting framework dubbed <a href=\"https://www.trendmicro.com/en_us/research/26/a/peckbirdy-script-framework.html\">PeckBirdy</a>. They described it as a versatile tool for exploiting living-off-the-land (LotL) binaries (LOLBins).</p><p>Our comparison with PeckBirdy revealed that it shares near-identical URL structures, payload delivery mechanisms and communication protocols with Falcon. Table 1 compares the URL structures of the two frameworks.</p><table>\n<tbody>\n<tr>\n<td><strong>Falcon</strong></td>\n<td><strong>PeckBirdy</strong></td>\n<td><strong>Description</strong></td>\n</tr>\n<tr>\n<td><span>hxxps[:]//{domain}/config/{ATTACK_ID}</span></td>\n<td><span>hxxps[:]//{domain}/{ATTACK_ID}</span></td>\n<td>Standard payload</td>\n</tr>\n<tr>\n<td><span>hxxps[:]//{domain}/config/{ATTACK_ID}/hta</span></td>\n<td><span>hxxps[:]//{domain}/{ATTACK_ID}/hta</span></td>\n<td>HTA application loader</td>\n</tr>\n<tr>\n<td><span>hxxps[:]//{domain}/config/{ATTACK_ID}/html</span></td>\n<td><span>hxxps[:]//{domain}/{ATTACK_ID}/html</span></td>\n<td>HTML loader</td>\n</tr>\n<tr>\n<td><span>hxxps[:]//{domain}/config/{ATTACK_ID}/wscript</span></td>\n<td><span>hxxps[:]//{domain}/{ATTACK_ID}/wscript</span></td>\n<td>JScript loader for HTA</td>\n</tr>\n</tbody>\n</table><p><span>Table 1. URL structure comparison between Falcon and PeckBirdy.</span></p><p>Both frameworks use the same payload delivery sequence to execute HTA, HTML or JScript payloads, with the primary distinction being Falcon's inclusion of the <span>/config/</span> path prefix.Both frameworks use AES for data encryption. PeckBirdy relies solely on AES with a predetermined encryption key, whereas Falcon negotiates an AES session key with the server, encrypted with RSA.Most significantly, both frameworks store their persistent session ID using the same Baidu-mimicking naming convention:</p><ul>\n<li>PeckBirdy writes its session ID to a browser cookie prefixed with <span>Hm_lvt_</span></li>\n<li>Falcon employs the same prefix for the same purpose, saving it as <span>Hm_lvt_$</span> in the browser’s local storage and <span>Hm_lvt__&lt;session ID&gt;</span> within a browser cookie</li>\n</ul><p>Based on these extensive technical overlaps, we assess with high confidence that Falcon and PeckBirdy represent variants of the same core framework.</p><h2 id=\"sec-4\">The Falcon Implant</h2><p>When someone visits a website affected by Falcon, the website sends a request to the Falcon C2 server. The server generates an implant uniquely obfuscated for that browser session. The implant is generated by two files: <span>victim_common.js</span> and <span>victim.js</span>.</p><p>The first file holds the configuration block described below and the second file contains common functions for communication and command execution. The two files are combined, and then passed through an obfuscation routine that XOR encodes each character in the implant with a one-byte key and converts the result into an integer.</p><p>The result is a script with a large list of integers and a small section of code to decode and execute itself. Figure 4 shows an example of the obfuscated script.</p><figure><img src=\"/dailyinfo/media/99f4d7f0afcc43f8.webp\" srcset=\"/dailyinfo/media/ad34e0de7fb9969c.webp 720w, /dailyinfo/media/b221da1f69da666d.webp 1200w, /dailyinfo/media/99f4d7f0afcc43f8.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Screenshot of JavaScript code. The code includes functions and variables with unconventional names and some hexadecimal and ASCII operations. It appears to be obfuscated, with functions using loops and mathematical operations to manipulate string data.\" width=\"800\" height=\"807\"><figcaption>Figure 4. Deobfuscation script in Falcon implant.</figcaption></figure><p>Figure 5 shows the template configuration block. The <span>$CLIENT_IP</span> is the victim IP address, set by the server as it generates the implant.</p><figure><img src=\"/dailyinfo/media/b149e08f3f93f5fd.webp\" srcset=\"/dailyinfo/media/a2d8da1d74b70e55.webp 720w, /dailyinfo/media/24f5369091cec8e6.webp 1200w, /dailyinfo/media/b149e08f3f93f5fd.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Screenshot of code snippet featuring variables for debugging, local settings, and secure modes, alongside host and port configurations with a redacted client IP address.\" width=\"900\" height=\"354\"><figcaption>Figure 5. Falcon implant configuration.</figcaption></figure><h3 id=\"sec-5\"><strong>Victim Persistence and</strong> Tracking</h3><p>The implant generates a persistent 32-character lower case alphanumeric session identifier per victim using a three-tier storage strategy designed to survive session restarts:</p><ul>\n<li>Browser local storage: Reading and writing a key <span>Hm_lvt_$</span>, likely mimicking Baidu Analytics tracking identifiers to blend with legitimate Chinese web analytics telemetry</li>\n<li>Cookie: Setting H<span>m_lvt__&lt;session ID&gt;=</span>1 with a path of <span>/</span> and an expiry date of the year 2099</li>\n<li>Falcon extension storage cache: Checking whether a <span>storageApi</span> object is defined; if so, the session ID is stored there as well</li>\n</ul><p>The <span>storageApi</span> is a dictionary within the Falcon browser extension, meaning it is present only if the victim has the Falcon browser extension installed. We detail the browser extension in the <a href=\"https://unit42.paloaltonetworks.com/falcon-c2-browser-compromise/#post-189298-_uhx0wxjk3s82\">Falcon Browser Extension section</a>.</p><h3 id=\"sec-6\">C2 Communication</h3><p>The implant establishes a TLS encrypted WebSocket connection to maintain a persistent connection as long as the browser tab of the affected webpage is open. It sends a heartbeat message <span>{\"heartbeat\":\"1\"}</span> every minute to keep the connection alive. The implant resets the timer on every inbound message, so an actively engaged session never emits standalone heartbeats.</p><p>The code supports a fallback protocol using the Comet communication protocol. If Comet is used, payload data exchanged with the C2 server is not encrypted. The WebSocket functionality supports AES encryption in combination with the TLS transport encryption as described below.</p><h3 id=\"sec-7\">Cryptographic Key Exchange</h3><p>The implant leverages the browser's native Web Crypto API to encrypt all exchanged data using AES. If the Web Crypto API is unavailable, the implant falls back to URL-encoding and Base64. The key exchange proceeds in five steps:</p><p><strong>Step 1: The server offers its RSA public key</strong></p><p>Upon WebSocket connection, the server pushes a message with an action pubkey containing a 2048-bit RSA public key in PEM format, as illustrated in Figure 6.</p><figure><img src=\"/dailyinfo/media/8a45016eac99c039.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Screenshot of code snippet containing JSON format. It includes an &quot;action&quot; key with the value &quot;pubkey,&quot; and a &quot;key&quot; key with a placeholder value.\" width=\"500\" height=\"194\"><figcaption>Figure 6. Server pubkey message.</figcaption></figure><p><strong>Step 2: The client generates 256-bit AES session key material</strong></p><p>The implant generates a 32-byte AES key and a 16-byte initialization vector (IV) using the browser's <span>crypto.getRandomValues</span>. If unavailable, a fallback function generates the key material from an alphanumeric string.</p><p><strong>Step 3: The client encrypts the session key material using the server’s RSA public ke</strong>y</p><p>Both the AES key and IV are individually encrypted using the server's RSA public key and then Base64-encoded.</p><p><strong>Step 4: The client sends the encrypted AES key material to the server</strong></p><p>The client sends the encrypted key material to the server in a <span>key_exchange</span> message, as shown in Figure 7.</p><figure><img src=\"/dailyinfo/media/d99c4e2d051e76e7.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Screenshot of a JSON snippet showing a key exchange process, with an action labeled &quot;key_exchange.&quot; It includes an RSA-encrypted AES key and an RSA-encrypted initialization vector (IV).\" width=\"500\" height=\"197\"><figcaption>Figure 7. Client key exchange message.</figcaption></figure><p><strong>Step 5: All subsequent exchanges have their payload data encrypted with the session key material using AES-256-CBC.</strong></p><h3 id=\"sec-8\">Command Dispatch</h3><p>Following the key exchange, the implant registers with the server by sending information about its current execution environment. Figure 8 below shows the data before encryption.</p><figure><img src=\"/dailyinfo/media/d41c01544dcde7db.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Screenshot of code snippet showing an object with properties: &quot;action&quot; set to &quot;init&quot;, &quot;url&quot; and &quot;domain&quot; using placeholders, &quot;remark&quot; referencing a variable, &quot;ip&quot; using a placeholder, and &quot;ua&quot; accessing the userAgent of the navigator.\" width=\"600\" height=\"412\"><figcaption>Figure 8. Falcon implant session registration.</figcaption></figure><p>The data includes the current URL and domain of the tab within which the Falcon implant is running. The data also includes the browser's User-Agent string and client IP address (set by the backend server during implant generation).</p><p>The implant first attempts to read the remark from the browser’s local storage, specifically from the <span>_domain_google_mark</span> field. If unsuccessful, it then searches for the string <span>_domain_google_mark=</span> within the current webpage’s cookies to retrieve the remark.</p><p>If the implant uses Comet for communication, it only supports the <span>run</span> and <span>nothing</span> commands, with the latter serving no operational purpose.</p><p>The <span>run</span> command enables an operator to execute arbitrary JavaScript code through evaluation by calling <span>eval</span>. The <span>set_remark</span> command applies a remark (or label/comment) to the session, helping the operator organize the sessions in the management panel. It updates the remark for the fields <span>_domain_google_mar</span>k across the browser's local storage, document cookie and Falcon extension storage.</p><p>The implant implements four main command APIs that attackers can use in custom modules to exfiltrate data, notify an operator or annotate the session in the Falcon database. Table 2 below details the APIs.</p><table>\n<tbody>\n<tr>\n<td><strong>Function</strong></td>\n<td><strong>Purpose</strong></td>\n</tr>\n<tr>\n<td><span>xg_note</span></td>\n<td>Set session label (remark)</td>\n</tr>\n<tr>\n<td><span>xg_send</span></td>\n<td>Send arbitrary JSON to the C2</td>\n</tr>\n<tr>\n<td><span>xg_data</span></td>\n<td>Exfiltrate arbitrary data</td>\n</tr>\n<tr>\n<td><span>xg_notify</span></td>\n<td>Send notification via Telegram</td>\n</tr>\n</tbody>\n</table><p><span>Table 2. Main command APIs.</span></p><h2 id=\"sec-9\">Falcon Browser Extension</h2><p>While the browser implant runs purely in the context of the browser tab, Falcon has two browser extensions to facilitate full control of a victim’s browser:</p><ul>\n<li>One for Firefox</li>\n<li>One for Chrome</li>\n</ul><p>The extensions work with the implant.</p><p>We are currently unaware of how an operator is deploying these browser extensions. It is likely that they are using an initial implant to trick a target into installing the browser extension and granting the operator unfettered browser access.</p><p>The two extensions are functionally identical, this section focuses on the Chrome extension.</p><p>The extension masquerades as a PDF reader, as shown in Figure 9, using the name <span>PDF Viewer</span>.</p><figure><img src=\"/dailyinfo/media/6a949f8aa0b01821.webp\" loading=\"lazy\" decoding=\"async\" alt=\"A red PDF file icon with the letters &quot;PDF&quot; in white.\" width=\"110\" height=\"109\"><figcaption><strong>F</strong>igure 9. Browser extension icon used by Falcon.</figcaption></figure><p>The extension consists of 14 files, as detailed below in Table 3.</p><table>\n<tbody>\n<tr>\n<td><strong>File</strong></td>\n<td><strong>Description</strong></td>\n</tr>\n<tr>\n<td><span>sandbox.html</span></td>\n<td rowspan=\"2\">C2 command executor, message dispatcher</td>\n</tr>\n<tr>\n<td><span>sandbox.js</span></td>\n</tr>\n<tr>\n<td><span>page.js</span></td>\n<td rowspan=\"2\">Unused code, likely remnants from development</td>\n</tr>\n<tr>\n<td><span>page.html</span></td>\n</tr>\n<tr>\n<td><span>offscreen.html</span></td>\n<td rowspan=\"2\">Extension bootstrapping and setting up an internal <span>MessageChannel</span> messaging bus and downloading the Falcon implant.</td>\n</tr>\n<tr>\n<td><span>offscreen.js</span></td>\n</tr>\n<tr>\n<td><span>background.js</span></td>\n<td>Background service worker that stores collected data in a first in, first out (FIFO) cache such as credentials, network requests and clipboard data.\n<p>Monitors the browser’s credentials store for credentials, cookies, history and downloads.</p></td>\n</tr>\n<tr>\n<td><span>twitter-dm.js</span></td>\n<td>Scrapes username and direct messages from Twitter/X when a user authenticates on <span>x[.]com</span>.</td>\n</tr>\n<tr>\n<td><span>content-script.js</span></td>\n<td>Clipboard manipulation, credential theft, network hooking, web storage theft. Sends data through <span>background.js</span> for exfiltration.</td>\n</tr>\n<tr>\n<td><span>analytics-core.js</span></td>\n<td>Hook <span>fetch</span> and <span>XMLHttpRequest</span> intercept HTTP requests</td>\n</tr>\n<tr>\n<td><span>manifest.json</span></td>\n<td>Extension manifest</td>\n</tr>\n<tr>\n<td><span>icon16.png</span></td>\n<td rowspan=\"3\">Extension icons</td>\n</tr>\n<tr>\n<td><span>icon128.png</span></td>\n</tr>\n<tr>\n<td><span>icon48.png</span></td>\n</tr>\n</tbody>\n</table><p><span>Table 3. Falcon Extension Files.</span></p><p>An operator generates the extension bundle in the management panel, which provides the operator a ZIP archive that is ready to install in a victim’s browser. As manually installing an extension in Chrome involves many steps, it is possible that an operator instead socially engineered a victim into downloading and executing a small deployment utility that installed the extension via the command line.</p><p>We have observed evidence in the management panel that the operator possesses a utility for silent plugin installation for Chrome and Firefox as Figure 10 below shows. However, we have not been able to recover a sample for further analysis.</p><figure><img src=\"/dailyinfo/media/5678b255d06829ac.webp\" srcset=\"/dailyinfo/media/43e1dba77738cead.webp 720w, /dailyinfo/media/9bdc8cc6259c241d.webp 1200w, /dailyinfo/media/5678b255d06829ac.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Screenshot of a webpage in simplified Chinese, titled &quot;Falcon.&quot; It displays a table under &quot;工具下载&quot; (Tool Download) with two files. Each file has a description, an upload date, and options to download or delete. Sidebar contains navigation links in Chinese.\" width=\"1000\" height=\"349\"><figcaption>Figure 10. Falcon management panel (tools).</figcaption></figure><p>The operator can upload tools to the management panel and password protect them, preventing other people from accessing them. The panel shows that there are two tools uploaded. Table 4 below shows the translated columns.</p><table>\n<tbody>\n<tr>\n<td><strong>Name of Document</strong></td>\n<td><strong>Size</strong></td>\n<td><strong>Description</strong></td>\n<td><strong>Upload Time</strong></td>\n</tr>\n<tr>\n<td><span>firefox.zip</span></td>\n<td>0.38 MB</td>\n<td>Plugins for silently installing Firefox</td>\n<td>2026-04-25T14:09:06.000Z</td>\n</tr>\n<tr>\n<td><span>browser.exe</span></td>\n<td>0.62 MB</td>\n<td>Plugins for silently installing Chrome</td>\n<td>2026-04-23T03:08:40.000Z</td>\n</tr>\n</tbody>\n</table><p><span>Table 4. Falcon management panel (tools) translation.</span></p><p>The extension requests a total of 40 permissions that grant the operator full control over the victim’s browser. These permissions include access to credentials, cookies and browser network traffic. Figure 11 below shows the extension manifest.</p><figure><img src=\"/dailyinfo/media/cb5bee4f7034d0bc.webp\" srcset=\"/dailyinfo/media/ad6964533fdb8e41.webp 720w, /dailyinfo/media/9e49fb379941590a.webp 1200w, /dailyinfo/media/cb5bee4f7034d0bc.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Screenshot of a JSON file displaying the manifest and configuration for a Chrome extension named &quot;PDF Viewer.&quot; It includes details like manifest version, permissions, content scripts, sandbox settings, and content security policy. Twitter and other URLs are listed in the matches section, along with resources and background scripts.\" width=\"900\" height=\"1246\"><figcaption>Figure 11. Falcon browser extension manifest.</figcaption></figure><p>The manifest parameters are described below in Table 5.</p><table>\n<tbody>\n<tr>\n<td><strong>Parameters</strong></td>\n<td><strong>Description</strong></td>\n</tr>\n<tr>\n<td><span>manifest_version</span></td>\n<td>Defines the manifest version (3)</td>\n</tr>\n<tr>\n<td><span>name</span></td>\n<td>Extension name (PDF Viewer)</td>\n</tr>\n<tr>\n<td><span>version</span></td>\n<td>Extension version (2026.5.13.1)</td>\n</tr>\n<tr>\n<td><span>description</span></td>\n<td>Extension description (Portable Document Format)</td>\n</tr>\n<tr>\n<td><span>permissions</span></td>\n<td>Individual permissions required by the extension (40 total)</td>\n</tr>\n<tr>\n<td><span>host_permissions</span></td>\n<td>A list of websites the extension is permitted to interact with and read data from. <span>&lt;all urls&gt;</span> specifies that the extension has access to all visited websites.</td>\n</tr>\n<tr>\n<td><span>background</span></td>\n<td>Defines the filename for the background service worker (<span>background.js</span>)</td>\n</tr>\n<tr>\n<td><span>content_scripts</span></td>\n<td>A list of scripts that should run on every URL that matches a certain criteria. The first script injects a <span>content-script.js</span> in all websites visited by a victim after the page has fully loaded. The second script injects <span>twitter-dm.js</span> on URLs <span>matching </span><span>x[.]com</span> and <span>twitter[.]com</span>, more details in the <a href=\"https://docs.google.com/document/d/1RNQN59_Vp1OqKB9eE5T0oUktLHYry-27ffqVRXblm0c/edit?tab=t.0#heading=h.ax5rfl73x2y2\">Twitter Direct Message Exfiltration</a> section.</td>\n</tr>\n<tr>\n<td><span>sandbox</span></td>\n<td>Defines the context from which untrusted code executes (<span>sandbox.html</span>)</td>\n</tr>\n<tr>\n<td><span>content_security_policy</span></td>\n<td>Defines the sandbox security policy and accessible objects</td>\n</tr>\n<tr>\n<td><span>web_accessible_resources</span></td>\n<td>Declares resources that are world accessible (by other webpages). Extension resources not listed here would result in a cross-origin resource sharing (CORS) error.</td>\n</tr>\n</tbody>\n</table><p><span>Table 5. Falcon extension manifest parameters.</span></p><h3 id=\"sec-10\">Extension Initialization</h3><p>When the extension is installed, enabled, or the browser starts, Chrome parses the extension manifest. The background service worker, <span>background.js</span>, runs and creates a hidden or offscreen document from the <span>offscreen.html</span> file.</p><p>The <span>offscreen.html</span> file loads <span>offscreen.js</span> (hereafter referred to as offscreen) and creates an iframe to load <span>sandbox.html</span> (which loads <span>sandbox.js</span>, hereafter referred to as sandbox) in parallel.</p><p>This structure is common for Chrome extensions that need offscreen documents. The sandbox acts as a code execution environment, allowing <span>eval</span> execution.</p><p>Offscreen starts by creating a <span>MessageChannel</span> message bus for communication</p><p>between extension components. It delays execution for 2 seconds to allow the message bus to be established before sending a request to the C2 server to download the Falcon implant. The code is passed to the sandbox through the message bus as shown in Figure 12.</p><figure><img src=\"/dailyinfo/media/97d12f49b52a971f.webp\" srcset=\"/dailyinfo/media/8276509fe4945a78.webp 720w, /dailyinfo/media/f5acc757e68bbf15.webp 1200w, /dailyinfo/media/97d12f49b52a971f.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Screenshot of a code snippet showing &quot;postMessage&quot; with parameters.\" width=\"900\" height=\"55\"><figcaption>Figure 12. Falcon implant code message bus call.</figcaption></figure><p>The code is executed by appending a script tag to the <span>sandbox.html</span> document body. The implant code, now running inside the sandbox, establishes a WebSocket connection to the C2 server.</p><p>In parallel with the background/offscreen initialization, Chrome automatically injects <span>content-script.js</span> (hereafter referred to as content script) into every page visited by the victim due to its manifest definition in <span>content_scripts</span>.</p><p>The <span>twitter-dm.js</span> script is injected only if a victim visits <span>twitter[.]com</span> or <span>x[.]com</span> as defined in the manifest. The content script runs in an isolated context and only has access to the webpage's Document Object Model (DOM), but not to its JavaScript context.</p><p>To achieve full page context access, the content script injects a script tag into the page pointing to <span>chrome-extension://&lt;extension ID&gt;/analytics-core.js</span> (hereafter called analytics core). Because the analytics core file is defined in <span>web_accessible_resources</span> in the manifest, it is accessible to web pages and not blocked by CORS.</p><p>At this point, the extension has:</p><ul>\n<li>Full access to the browser's data store (via <span>chrome</span>.* APIs in <span>background.js</span>)</li>\n<li>Full access to the context of every webpage the victim visits (via the content script and analytics core)</li>\n</ul><h3 id=\"sec-11\">Web Proxy</h3><p>Falcon allows an operator to use a victim’s browser as a proxy server and to use the victim’s browser data store, including session cookies and credentials for requests. An operator creates a proxy and attaches it to the victim’s Falcon session.</p><p>The operator then configures the victim’s browser with the Falcon server address and the designated proxy port. The operator is then able to send requests to the Falcon implant within the victim’s browser, with these requests encapsulated in a JavaScript snippet. They will then be sent to the victim’s browser as illustrated below in Figure 13.</p><figure><img src=\"/dailyinfo/media/398f7285aa98ede8.webp\" srcset=\"/dailyinfo/media/519e23b27e558d1e.webp 720w, /dailyinfo/media/e82225ca38f7bea9.webp 1200w, /dailyinfo/media/398f7285aa98ede8.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Diagram illustrating a sequence of HTTP and WebSocket interactions for a Gmail session hijacking attack. It features four main entities: Operator's Browser, Falcon Server, Victim's Browser, and Gmail Server. The flow shows requests and responses, including GET and HTTP 200 OK messages, WebSocket connections with credentials, and the validation of the user's session by Gmail Server.\" width=\"1000\" height=\"300\"><figcaption>Figure 13. Falcon proxy capability overview.</figcaption></figure><p>The sandbox receives and executes the JavaScript. This script calls <span>handleProxyRequest</span> with the request data as an argument, which subsequently sends a message on the Chrome runtime message bus as shown in Figure 14.</p><figure><img src=\"/dailyinfo/media/6e78bbab15a70845.webp\" srcset=\"/dailyinfo/media/13b42f5905e6903b.webp 720w, /dailyinfo/media/f3ca712abd469714.webp 1200w, /dailyinfo/media/6e78bbab15a70845.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Code snippet showing a function call.\" width=\"900\" height=\"218\"><figcaption>Figure 14. Falcon browser extension proxy request message.</figcaption></figure><p>The background service worker picks up the messages, constructs the request and sets the <span>fetchOptions</span> to use the victim's credential store in the request. Figure 15 below shows this, highlighted in bold.</p><figure><img src=\"/dailyinfo/media/2d17853634c932dd.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Screenshot of code snippet showing JavaScript fetch options with method and headers variables, and credentials set to 'include'.\" width=\"500\" height=\"227\"><figcaption>Figure 15. Falcon browser extension credential store usage.</figcaption></figure><p>The response from the request is Base64-encoded and returned in JSON via the C2 WebSocket. This enables an operator to browse resources using the identity of the victim, allowing for session hijacking and access to internal network resources.</p><h3 id=\"sec-12\">Download Intercept</h3><p>The extension can intercept and replace file downloads according to operator-defined rules. The operator can define broad rules targeting a list of domain and file extensions.</p><p>Figure 16 below shows an example rule that intercepts and replaces all executable downloads from <span>google[.]com</span> and <span>dl.google[.]com</span> with an operator-controlled URL.</p><figure><img src=\"/dailyinfo/media/5b61c66b53284cde.webp\" srcset=\"/dailyinfo/media/c98b9194dac102b6.webp 720w, /dailyinfo/media/8bd1f823dc63d0a5.webp 1200w, /dailyinfo/media/5b61c66b53284cde.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Screenshot of a code snippet displaying a task configuration for downloading malware. It includes a redirect URL with a placeholder domain and specifies targeting &quot;.exe&quot; extensions.\" width=\"1000\" height=\"284\"><figcaption>Figure 16. Download intercept configuration entry.</figcaption></figure><p>The background service worker installs an event listener that listens for <span>chrome.downloads.onCreated</span> events. When detected, the background worker sends a message to offscreen over the Chrome runtime message bus, which it relays to the sandbox.</p><p>The sandbox applies the intercept rule set to the download URL to determine whether it should modify the URL. While the background service worker has the necessary privileges to intercept and replace downloads, the extension's architectural design keeps the intercept rules and C2 command processing (which requires eval execution) within the sandbox. This design necessitates passing messages across the message buses.</p><p>If the URL matches a rule, the extension cancels the original file transfer and removes the download from the Chrome download history. The new URL consists of the target and redirect URL, where the target URL is encoded and appended to the end of the redirect URL as shown below in Figure 17.</p><figure><img src=\"/dailyinfo/media/a49ecf33e9fd7214.webp\" srcset=\"/dailyinfo/media/660757ceaad9b968.webp 720w, /dailyinfo/media/d90922e0d89fd178.webp 1200w, /dailyinfo/media/a49ecf33e9fd7214.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Screenshot of a suspicious URL link appearing to download malware disguised as a Google Chrome setup file.\" width=\"1000\" height=\"89\"><figcaption>Figure 17. Download intercept modified URL.</figcaption></figure><p>The download retains the original filename and will appear to the victim as <span>ChromeSetup.exe</span> while the origins will show as <span>evil[.]com</span>.</p><p>This technique enables an operator to achieve code execution on the victim’s system by intercepting a legitimate download and replacing it with the operator’s payload. It does so leaving little evidence that the file originated from a malicious source. The operator can use this to deploy additional malware and gain a stronger foothold in the target network.</p><h3 id=\"sec-13\">Network Hooking</h3><p>The functionality of analytics core is to install a hook for <span>window.fetch</span>, <span>XMLHttpRequest.open</span> and <span>XMLHttpRequest.send</span>. This hook enables the extension to intercept requests made from the current webpage and any third-party scripts loaded on the page. The operator can also define intercept rules that can replace a URL with an operator’s own URL (e.g., to hijack software updates).</p><p>For <span>window.fetch</span>, the hook intercepts HTTP requests that result in an HTTP 200 response and sets the content type to <span>application/json</span> or contains <span>text/</span>. The intercepted request and response data is posted to the <span>MessageChannel</span> as shown below in Figure 18.</p><figure><img src=\"/dailyinfo/media/062c767da7cd7d24.webp\" srcset=\"/dailyinfo/media/5dbbadf341495e95.webp 720w, /dailyinfo/media/eaa08ddbabc535a1.webp 1200w, /dailyinfo/media/062c767da7cd7d24.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Screenshot of a code snippet for a network data hook using JavaScript. It includes parameters for type, payload, method, headers, request body, response body, status, and duration calculation.\" width=\"1000\" height=\"494\"><figcaption>Figure 18. Intercepted HTTP request (fetch) passed on MessageChannel.</figcaption></figure><p>For calls to <span>XMLHttpRequest.send</span>, the hook checks whether the HTTP response code is between 200 and 299, and whether the content type is <span>application/json</span> or contains <span>text/</span>. The hook also checks the <span>responseType</span> attribute to see whether it is <span>text</span> or an empty string.</p><p>The intercepted request and response data is posted to the <span>MessageChannel</span> as shown below in Figure 19.</p><figure><img src=\"/dailyinfo/media/7c51f7a2d558a6fe.webp\" srcset=\"/dailyinfo/media/4c6562be9dacb986.webp 720w, /dailyinfo/media/ee4eb9beb760fb92.webp 1200w, /dailyinfo/media/7c51f7a2d558a6fe.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Screenshot of a JavaScript code snippet for network data monitoring, including properties for URL, method, headers, request and response bodies, status, and duration.\" width=\"1000\" height=\"610\"><figcaption>Figure 19. Intercepted HTTP request (<span>xhr</span>) passed on <span>MessageChannel</span>.</figcaption></figure><p>The posted message signals the content script to relay the message from the <span>MessageChannel</span> onto Chrome’s runtime message bus using <span>chrome.runtime.sendMessag</span>e as shown below in Figure 20.</p><figure><img src=\"/dailyinfo/media/5c55facffe9d6def.webp\" srcset=\"/dailyinfo/media/576539e0608dde3d.webp 720w, /dailyinfo/media/5ae10ee4f66d2386.webp 1200w, /dailyinfo/media/5c55facffe9d6def.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Screenshot of a JavaScript code snippet setting up an event listener for 'message' events. It checks for a specific event data type and, if true, sends a message with the network body data. \" width=\"1000\" height=\"468\"><figcaption>Figure 20. Intercepted HTTP request message relay.</figcaption></figure><p>The background worker picks up the message and stores it in a cache awaiting operator instructions to upload the data to the C2 server. The cache operates in a FIFO fashion and stores a maximum of 500 requests.</p><h3 id=\"sec-14\">Discord Messages and Friends List Exfiltration</h3><p>An operator can also target Discord chat messages and friend lists. They achieve this using passive network hooking described above, as Discord uses JSON in its HTTP communication. If configured, the operator can intercept requests matching a Discord URL pattern with victim data stored in a separate table.</p><h3 id=\"sec-15\">Zalo Chat Database Exfiltration</h3><p>Zalo is a chat application similar to WhatsApp that is popular in Vietnam. Falcon supports intercepting Zalo chat message databases using passive network hooking. Targeting Zalo provides additional insights into the targeted audience of the operator.</p><h3 id=\"sec-16\">Gmail Exfiltration</h3><p>While the ability to exfiltrate Gmail data is not a core functionality of the extension, it does provide an operator with the access needed to compromise a victim’s Gmail account and download email data. An operator issues a command that uploads a JavaScript to the extension, which sends a request to Gmail using the user’s Gmail session cookie to retrieve a list of authenticated users.</p><p>An operator can then select the accounts to collect data from, to be uploaded to the C2 server. This action is facilitated by the extension.</p><p>The exfiltrated email data includes:</p><ul>\n<li>Date</li>\n<li>Receiver</li>\n<li>Sender</li>\n<li>Subject</li>\n<li>Email body</li>\n<li>Attachments</li>\n</ul><h3 id=\"sec-17\">Clipboard Hijacking</h3><p>As soon as the extension is installed, loaded or the browser starts, the clipboard hijacker is actively monitoring the victim’s clipboard events. It intercepts every cut, copy and paste event by adding document listeners as shown below in Figure 21.</p><figure><img src=\"/dailyinfo/media/8d7c1a1775f51d88.webp\" srcset=\"/dailyinfo/media/47e286c1a4b7c211.webp 720w, /dailyinfo/media/bd669ae3eb0d49bd.webp 1200w, /dailyinfo/media/8d7c1a1775f51d88.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Screenshot of a code snippet showing JavaScript functions that add event listeners for &quot;copy,&quot; &quot;cut,&quot; and &quot;paste&quot; actions, each referencing a specific handler function.\" width=\"1000\" height=\"128\"><figcaption>Figure 21. Clipboard hijacker listeners.</figcaption></figure><p>By default, the hijacker runs without any rules. An operator has the option to define pattern matching rules and replacements (e.g., replacing account numbers or cryptocurrency wallet addresses).</p><p>The rules are stored in Chrome’s local storage <span>chrome.storage.local</span> in a key <span>clipboard_replacer_rules</span>. Figure 22 below shows an example rule.</p><figure><img src=\"/dailyinfo/media/679bab6de91ce824.webp\" srcset=\"/dailyinfo/media/1e5a55dec69b4b56.webp 720w, /dailyinfo/media/ca9738e15057fadd.webp 1200w, /dailyinfo/media/679bab6de91ce824.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Screenshot of a JSON code snippet with fields for task identification, activity status, target domains. Match type set to &quot;regex&quot;, a specific match regex pattern, and a replacement string.\" width=\"1000\" height=\"364\"><figcaption>Figure 22. Clipboard hijacker configuration example.</figcaption></figure><p>Intercepted clipboard events are passed as messages on Chrome’s message bus. These messages are picked up by the background worker and stored in a cache similar to the intercepted HTTP requests. They then await an operator command to upload the data.</p><h3 id=\"sec-18\">X/Twitter Direct Messages Exfiltration</h3><p>The extension comes with a separate module for scraping direct messages from the X/Twitter social media platform. The module is defined in the extension manifest under <span>content_scripts</span> and is injected into any webpage whose URL matches the patterns <span>*://*.twitter.com/*</span> or <span>*://*.x.com/*</span>.</p><p>The module can only scrape direct messages when a victim browses a conversation. It cannot enumerate conversations or open other conversations.</p><p>The module is notable for using X and Y coordinate systems to identify messages received (left) and sent by the account owner (right), leveraging X/Twitter’s CSS layout. Along with the messages, the module extracts attachment references (URLs) and the associated timestamp. It attempts to translate the timestamp into a uniform format.</p><p>Because X/Twitter uses “today” or “yesterday” instead of timestamps for the most recent messages, the module attempts to convert them into timestamps. We found that the module supports six different languages, as shown below in Table 6.</p><table>\n<tbody>\n<tr>\n<td><strong>English</strong></td>\n<td><strong>Today</strong></td>\n<td><strong>Yesterday</strong></td>\n</tr>\n<tr>\n<td>Chinese</td>\n<td>今天</td>\n<td>昨天</td>\n</tr>\n<tr>\n<td>Spanish</td>\n<td>Hoy</td>\n<td>Ayer</td>\n</tr>\n<tr>\n<td>French</td>\n<td>Aujourd'hui</td>\n<td>Hier</td>\n</tr>\n<tr>\n<td>German</td>\n<td>Heute</td>\n<td>Gestern</td>\n</tr>\n<tr>\n<td>Italian</td>\n<td>Oggi</td>\n<td>Ieri</td>\n</tr>\n</tbody>\n</table><p><span>Table 6. Module language support.</span></p><p>This language support provides insight into the target demographic to extract Twitter/X direct messages.</p><h3 id=\"sec-19\">Continuously Monitoring - Credentials Store, History and Downloads</h3><p>The extension supports monitoring for sensitive information. It collects some information automatically when the extension is loaded, other information requires an operator to issue a command to enable monitoring. Table 7 shows the various collectors and how they are enabled.</p><table>\n<tbody>\n<tr>\n<td><strong>Collector</strong></td>\n<td><strong>Collects</strong></td>\n<td><strong>Description</strong></td>\n</tr>\n<tr>\n<td>Credentials</td>\n<td>Passwords, autofill forms</td>\n<td>Continuously collects data and stores it in the background service worker’s cache. Only the 500 latest entries are kept in the cache.</td>\n</tr>\n<tr>\n<td>Cookies</td>\n<td>Cookies</td>\n<td>Collects all browser cookies and exfiltrates them to the C2 server. Requires manual issuance of command.</td>\n</tr>\n<tr>\n<td>Clipboard</td>\n<td>Copy, cut and paste events</td>\n<td>As described in the earlier section.</td>\n</tr>\n<tr>\n<td>Browser history</td>\n<td>Full browser history</td>\n<td>Collects full browser history, exfiltrated to the C2 server directly. Requires manual issuance of command.</td>\n</tr>\n<tr>\n<td>Download history</td>\n<td>Full file download history</td>\n<td>Collects detailed history of all downloaded files.</td>\n</tr>\n</tbody>\n</table><p><span>Table 7. Falcon extension collection capabilities.</span></p><h2 id=\"sec-20\">Possible AI-Assisted Development</h2><p>The Falcon framework shows a high level of complexity in both design and capability. However, the overall code exhibits characteristics suggesting the malware authors likely used AI to assist with design and development. This conclusion is based on the coding style, including variable naming and code comments.</p><p>There are also inconsistent design choices that make little sense to a human developer. For example, the network hook for <span>XMLHttpRequest</span> checks for an HTTP response code greater than or equal to 200 but less than 300, while the hook for <span>fetch</span> checks against <span>response.ok</span>. Both result in the same outcome while the first is rarely, if ever, used when the <span>response.ok</span> shortcut exists.</p><h2 id=\"sec-21\">Campaign Tracking</h2><p>Falcon uses unique attack identifiers to organize campaigns. We identified campaigns targeting government entities across at least five countries, as shown in Table 8.</p><table>\n<tbody>\n<tr>\n<td><strong>Region</strong></td>\n<td><strong>Targets</strong></td>\n</tr>\n<tr>\n<td>Middle Eastern Country</td>\n<td>Ministry of Defense\n<p>Ministry of Interior</p>\n<p>Ministry of Foreign Affairs</p>\n<p>National Agency for Network Services</p>\n<p>Telecom Provider</p>\n<p>Government email systems</p></td>\n</tr>\n<tr>\n<td>Southeast Asian country A</td>\n<td>Police Entity\n<p>Directorate of Intelligence</p>\n<p>Department of Corrections</p></td>\n</tr>\n<tr>\n<td>Southeast Asian country B</td>\n<td>Justice Entity</td>\n</tr>\n<tr>\n<td>Southeast Asian country C</td>\n<td>Military Entity\n<p>Department of Justice</p></td>\n</tr>\n<tr>\n<td>Southeast Asian country D</td>\n<td>Ministry of Foreign Affairs</td>\n</tr>\n</tbody>\n</table><p><span>Table 8. Campaign victims identified.</span></p><p>While all five campaigns leveraged Falcon as their primary C2 framework, each exhibited distinct tradecraft in implant delivery and target selection, demonstrating how the operators tailored their approach to specific environments.</p><ul>\n<li>The operator compromised the Middle Eastern country's Ministry of Foreign Affairs Roundcube webmail portal by inserting a script tag that loads the Falcon implant. This enabled the operator to intercept credentials and monitor user sessions.</li>\n<li>In Southeast Asian country A, the operator used Falcon to load a custom username-harvesting module. This was followed later by a fake Adobe Flash update prompt that attempted to deliver the Antino implant to pre-selected users.</li>\n<li>In Southeast Asian country B, the operator used the Falcon Chrome extension mimicking a PDF viewer to establish persistent access from a browser context.</li>\n<li>In Southeast Asian country C, a separate Falcon campaign targeted a military entity.</li>\n</ul><p>The following sections detail our analysis of the campaign associated with the Middle Eastern country and Southeast Asian countries A and B.</p><h2 id=\"sec-22\">Middle Eastern Country (Roundcube Webmail)</h2><p>In April 2026, we observed a Falcon implant residing on the Roundcube webmail portal of a Middle Eastern Ministry of Foreign Affairs. The actor had injected a <span>&lt;script&gt;</span> tag into the portal header as shown in Figure 23.</p><figure><img src=\"/dailyinfo/media/94778eeea065ae7c.webp\" srcset=\"/dailyinfo/media/e1bc0c752e93768a.webp 720w, /dailyinfo/media/29ae501c3a07a1ab.webp 1200w, /dailyinfo/media/94778eeea065ae7c.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Screenshot of an HTML script tag containing the source URL.\" width=\"1000\" height=\"43\"><figcaption>Figure 23. Falcon implant tag injection.</figcaption></figure><p>The resource config_r5lfmqe3 returns the obfuscated JavaScript Falcon implant. This enables the actor to intercept credentials as users sign in. Based on the analyzed data, we assess with high confidence that the script executes on each Roundcube visited by a victim, granting the operator access to a victim’s inbox and account settings.</p><p>We observed a total of 39 Roundcube instances being affected within the target country. We have no evidence of any instances affected outside of the target country, suggesting this was a highly targeted campaign.</p><h2 id=\"sec-23\">Southeast Asian Country A - Police Entity (Username Harvesting and Antino Implant Deployment)</h2><p>In May 2026, we observed the Falcon implant deployed in a web application belonging to a Southeast Asian police entity. The operator deployed a custom Falcon module to harvest usernames and later target specific victims by displaying a fake Adobe Flash Player update prompt with a specific username.</p><p>The first module targets the text content of the HTML element with the ID <span>leftusername</span>. It reports the contents to the Falcon C2 using the built-in function <span>xg_note</span>.</p><p>This function annotates the session in the Falcon database and sets the implant’s remark attribute. This enables the operator to know which session corresponds to which username. Figure 24 below shows code from this first module.</p><figure><img src=\"/dailyinfo/media/9cff2a61735382a9.webp\" srcset=\"/dailyinfo/media/84c6fcd3a5794eb2.webp 720w, /dailyinfo/media/b623eef21787ba68.webp 1200w, /dailyinfo/media/9cff2a61735382a9.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Screenshot of a code snippet written in JavaScript, featuring a self-executing function. It attempts to retrieve an HTML element by the ID, assigns its text content to a variable, and calls a function with that text. A try-catch block is used to handle potential errors.\" width=\"1000\" height=\"335\"><figcaption>Figure 24. Falcon custom module for harvesting usernames from internal systems.</figcaption></figure><figure><img src=\"/dailyinfo/media/e4c98082dc83cac4.webp\" srcset=\"/dailyinfo/media/2ea243e36e95c1d7.webp 720w, /dailyinfo/media/e0e6e60ba3591fe0.webp 1200w, /dailyinfo/media/e4c98082dc83cac4.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Screenshot of a code snippet displaying a function to detect if a user is on a Windows browser using the `userAgent` property. It also manages popup counts stored in `localStorage` and checks domain names against a predefined list. The code uses try-catch for error handling.\" width=\"1000\" height=\"495\"><figcaption>Figure 25. Falcon custom module for displaying a fake Adobe Flash Player update pop-up.</figcaption></figure><p>The module first extracts the text contents of the <span>leftusername</span> element, as the harvesting module does. It compares the username against a hard-coded list of targeted usernames.</p><p>If the username matches and the fake Adobe Flash Player pop-up (shown below in Figure 26) has been shown fewer than 10 times, the module displays the pop-up shown below. The pop-up count is stored in the browser’s local storage in a key called <span>popup_count</span>.</p><figure><img src=\"/dailyinfo/media/83a4f11e324bafb4.webp\" loading=\"lazy\" decoding=\"async\" alt=\"A popup message from Adobe Flash Player indicating that the flash version is too low. It advises upgrading to the latest version to avoid security risks and improve the online experience. There is a yellow button labeled &quot;Upgrade immediately&quot;.\" width=\"700\" height=\"412\"><figcaption>Figure 26. Fake Adobe Flash Player update prompt.</figcaption></figure><p>Clicking the upgrade button serves the user with an implant, Antino, documented in the section: <a href=\"https://unit42.paloaltonetworks.com/falcon-c2-browser-compromise/#post-antino-implant-id\">Antino Implant.</a> The payload was served from <span>hxxps[:]//microsoft-flash[.]com/download/Adobe_installer.exe</span>.</p><h2 id=\"sec-24\">Southeast Asian Country B - Justice Entity (Falcon Browser Extension)</h2><p>In early 2026, we identified the compromise of an entity affiliated with a national justice department in a Southeast Asian country. Unlike other campaigns attributed to this actor, this intrusion likely relied on a different initial access vector: a malicious Chrome browser extension.</p><p>The extension (ID: <span>mbidcmlcbgbphpoacojjbmfpohcimjji</span>) mimicked a legitimate PDF viewer. It was sideloaded in Chrome's developer mode and ran persistently in the victim's browser with a broad permission set, as documented in the section: Falcon Browser Extension.</p><p>Communication with the operator's infrastructure was maintained over a long-lived WebSocket originating from the extension's own sandbox context. The compromised browser checked in every 3-4 minutes for more than 3 weeks.</p><p>Beyond ambient data collection, the extension provided the operator with persistent visibility into the victim's day-to-day work inside the national justice department's internal document system. This document system is used to route, print and track official correspondence between high-ranking officials and subordinate staff.</p><p>On one occasion, while the victim was actively viewing a routing slip in that system, we observed the operator capture a full-page screenshot of the rendered document. The captured document was a request for the approval of the release of persons deprived of liberty. This demonstrates the actor's willingness to conduct hands-on collection when material of intelligence value appeared during the victim's session, rather than relying solely on the extension's automated telemetry.</p><p>Alongside the screenshot, the extension exfiltrated plaintext credentials for the same system and recorded more than 20 additional routing-slip page views spanning late April–mid-May 2026. This demonstrates both the operator's interest in classified internal documents and their ability to independently replay access to the system.</p><h2 id=\"sec-25\">Antino Implant</h2><p>Antino is written in Rust and dates back to at least Oct. 6, 2025, based on the compilation timestamp of the earliest known sample. The name originates from the filename of the oldest known sample <span>antino-client.exe</span>, along with PDB strings in the binary, such as <span>antino_client.pdb</span>.</p><p>The Antino configuration is stored in the <span>.cfg</span> PE section and is XOR-encoded as Figure 27 below shows.</p><figure><img src=\"/dailyinfo/media/b4c91dd59d0c7578.webp\" loading=\"lazy\" decoding=\"async\" alt=\"A red and green hex dump screen with columns of hexadecimal values on the left and corresponding ASCII text on the right. The red background highlights specific areas, while the top rows include a green section with repeating values.\" width=\"600\" height=\"312\"><figcaption>Figure 27. Antino encoded configuration.</figcaption></figure><p>The <span>.cfg</span> section is 65,535 bytes while the configuration takes up 262 (<span>0x106</span>) bytes. The first 4 bytes are the length of the XOR-encoded configuration data, 258 (<span>0x102</span>) bytes. Antino decodes the configuration using a 2-byte key <span>0xABCD</span>. The decoded configuration is in JSON format and contains Microsoft OneDrive credentials and a remark (campaign ID). Table 9 shows the decoded configuration.</p><table>\n<tbody>\n<tr>\n<td colspan=\"3\">\n<p><strong>Antino Configuration</strong></p>\n</td>\n</tr>\n<tr>\n<td><strong>Field</strong></td>\n<td><strong>Value</strong></td>\n<td><strong>Description</strong></td>\n</tr>\n<tr>\n<td><span>tenant_id</span></td>\n<td>[REDACTED]</td>\n<td>Microsoft OneDrive tenant ID</td>\n</tr>\n<tr>\n<td><span>client_id</span></td>\n<td>[REDACTED]</td>\n<td>Microsoft OneDrive client ID</td>\n</tr>\n<tr>\n<td><span>client_secret</span></td>\n<td>[REDACTED]</td>\n<td>Microsoft OneDrive client secret</td>\n</tr>\n<tr>\n<td><span>user_id</span></td>\n<td>[REDACTED]</td>\n<td>Microsoft OneDrive user ID</td>\n</tr>\n<tr>\n<td><span>remark</span></td>\n<td>[REDACTED]</td>\n<td>Actor made remark, likely campaign ID</td>\n</tr>\n<tr>\n<td><span>run</span></td>\n<td><span>true</span></td>\n<td>Establish persistence</td>\n</tr>\n<tr>\n<td><span>launch_mode</span></td>\n<td><span>exe</span></td>\n<td>Antino launch mode, determines the behavior based on whether it is running in a DLL context (side loading) or a stand-alone executable</td>\n</tr>\n</tbody>\n</table><p><span>T</span><span>able 9. Antino configuration.</span></p><h3 id=\"sec-26\">Persistence</h3><p>Antino uses passive execution to establish persistence in the Windows Registry. It first copies itself to the hard-coded directory <span>%LOCALAPPDATA%\\Windows GatherOSStateKit\\tmp&lt;8 char&gt;.exe</span> and attempts to copy two DLLs, <span>DllSafeCheck64.dll</span> and <span>slc.dll</span>, from its current directory.</p><p>Antino does not import either of these files, but we have observed it using <span>DllSafeCheck64.dll</span> for sideloading in older versions of Antino. This functionality is likely a remnant from those versions.</p><p>The implant then checks for the presence of a file named <span>id</span>. If it exists, Antino reads the contents as the bot ID. If the file does not exist, it generates a UUID string and writes it to the <span>id</span> file.<em>&nbsp;</em></p><p>To achieve passive execution, the implant writes a diagnostic answer file to <span>%TEMP%\\SDIAG_&lt;GUID&gt;\\result\\result.ps1</span> as shown below in Figure 28. A diagnostic answer file is a configuration file that defines parameters for the diagnosed application.</p><figure><img src=\"/dailyinfo/media/4ae0d33510b1c0b7.webp\" srcset=\"/dailyinfo/media/08322a409ed52404.webp 720w, /dailyinfo/media/19ac27a737f850cc.webp 1200w, /dailyinfo/media/4ae0d33510b1c0b7.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"A snippet of Windows PowerShell script is displayed. It defines variables to gather system diagnostics using an executable. The script contains paths for file and registry item creation.\" width=\"1000\" height=\"262\"><figcaption>Figure 28. Diagnostic answer file contents.</figcaption></figure><p>Antino executes the Microsoft Scripted Diagnostic Native Host utility (<span>sdiagnhost.exe</span>), which parses the diagnostic answer file. The first XML section highlighted in red defines the header, and the text that follows is the path required to load the Program Compatibility Wizard (PCW). The contents highlighted in purple are the answer file folder name. The contents highlighted in blue are the answer file filename. The PowerShell snippet highlighted in light magenta is ultimately executed in the context of <span>sdiagnhost.exe</span> and adds Antino to the Windows Registry Run key.</p><h3 id=\"sec-27\">Command and Control</h3><p>Antino uses Microsoft OneDrive for C2 and uploads a heartbeat to the <span>antino/heartbeat/&lt;Bot ID&gt;.json</span> file in the OneDrive folder as a beacon. The heartbeat contains the hostname, username and remark from the Antino configuration.</p><p>Antino searches the OneDrive root folder for files following the <span>command_req_&lt;Bot ID&gt;_&lt;timestamp&gt;.json</span> format. Files matching the format indicate that a command has been issued to the bot. Figure 29 below shows an example command, <span>system_info</span>.</p><figure><img src=\"/dailyinfo/media/a7ea62a48151ef6c.webp\" srcset=\"/dailyinfo/media/e963604e574cbea2.webp 720w, /dailyinfo/media/d211af966a917209.webp 1200w, /dailyinfo/media/a7ea62a48151ef6c.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Screenshot of a JSON code snippet displaying system information with command type and subject ID.\" width=\"1000\" height=\"194\"><figcaption>Figure 29. Antino system_info command example.</figcaption></figure><figure><img src=\"/dailyinfo/media/f8632d5bec61ad4f.webp\" srcset=\"/dailyinfo/media/8d981f102b286a87.webp 720w, /dailyinfo/media/17d7ffb7b87a6b92.webp 1200w, /dailyinfo/media/f8632d5bec61ad4f.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"A JSON formatted system information output displaying details such as command type, system info, machine name, platform as &quot;windows&quot;, with remarks redacted. It also includes session and process IDs, followed by success status as true.\" width=\"1000\" height=\"374\"><figcaption>Figure 30. Antino <span>system_info</span> command response example.</figcaption></figure><p>Antino supports 10 commands shown below in Table 10.</p><table>\n<tbody>\n<tr>\n<td><strong>Command</strong></td>\n<td><strong>Description</strong></td>\n</tr>\n<tr>\n<td><span>cmd</span></td>\n<td>Shell command execution</td>\n</tr>\n<tr>\n<td><span>ps</span></td>\n<td>PowerShell execution</td>\n</tr>\n<tr>\n<td><span>system_info</span></td>\n<td>System information collection</td>\n</tr>\n<tr>\n<td><span>list_files</span></td>\n<td>Directory listing</td>\n</tr>\n<tr>\n<td><span>add_to_run</span></td>\n<td>Registry Run key persistence</td>\n</tr>\n<tr>\n<td><span>exit</span></td>\n<td>Client shutdown</td>\n</tr>\n<tr>\n<td><span>load</span></td>\n<td>Download and execute a Rhai script</td>\n</tr>\n<tr>\n<td><span>execute_program</span></td>\n<td>Program execution</td>\n</tr>\n<tr>\n<td><span>upload_file</span></td>\n<td>File exfiltration via OneDrive, uploaded to <span>antino/antino_upload/</span></td>\n</tr>\n<tr>\n<td><span>download_file</span></td>\n<td>File download from OneDrive, downloaded from <span>antino/antino_upload/</span></td>\n</tr>\n</tbody>\n</table><p><span>Table 10. Antino commands.</span></p><p>Notably, Antino supports execution of Rhai scripts (embedded scripting for Rust) that easily extend the implants’ capabilities without compiling additional binary shellcode. We have not observed any usage of Rhai scripts in the wild.</p><h2 id=\"sec-28\">Conclusion</h2><p>Falcon's browser-native approach presents significant challenges for traditional endpoint and network security controls. It operates entirely within the browser sandbox, avoiding persistent file artifacts and encrypting all C2 traffic over WebSocket.</p><p>The discovery of Antino, a Rust-based implant that routes its C2 through Microsoft OneDrive, demonstrates further attempts to blend into network traffic. Organizations should monitor for the following anomalous activity:</p><ul>\n<li>Browser extensions installed in developer mode, particularly those mimicking common utilities (e.g., PDF viewers) and requesting broad permissions (e.g., <span>&lt;all_urls&gt;, debugger, tabCapture, nativeMessaging, <span>or </span></span><span>webRequest</span>)</li>\n<li><span>Hm_lvt_</span> cookies or local-storage keys on internal or government web applications where Baidu Analytics has no legitimate reason to appear</li>\n<li><span>&lt;script&gt;</span> tags added to the templates or headers of internal webmail, ticketing or case-management portals loading resources from unfamiliar external domains, especially where the response is a heavily numeric JavaScript array with a small decoder loop</li>\n<li>OAuth activity to Microsoft OneDrive tenants outside the organization's own tenancy, especially with repeated small JSON writes to paths such as antino<span>/heartbeat/</span><span> or antino/antino_upload/</span></li>\n</ul><h3 id=\"sec-29\">Palo Alto Networks Protection and Mitigation</h3><p>Palo Alto Networks customers are better protected from the threats discussed above through the following products:</p><ul>\n<li>The <a href=\"https://docs.paloaltonetworks.com/wildfire\">Advanced WildFire</a> machine-learning models and analysis techniques have been reviewed and updated in light of the indicators shared in this research.</li>\n<li><a href=\"https://docs.paloaltonetworks.com/advanced-url-filtering/administration/url-filtering-basics/how-url-filtering-works\">Advanced URL Filtering</a> and <a href=\"https://docs.paloaltonetworks.com/dns-security/administration/about-dns-security\">Advanced DNS Security</a> identify known URLs and domains associated with this activity as malicious.</li>\n<li><a href=\"https://docs-cortex.paloaltonetworks.com/p/XDR\">Cortex XDR</a> and <a href=\"https://docs-cortex.paloaltonetworks.com/p/XSIAM\">XSIAM</a> are designed to prevent the execution of known malicious malware and prevent the execution of unknown malware using Behavioral Threat Protection and machine learning based on the Local Analysis module.</li>\n<li><a href=\"https://www.koi.ai/product/endpoint\">Cortex Agentic Endpoint Security</a> is designed to help discover every AI artifact and AI agent's activity across the agentic endpoint, assess its risk, enforce prevention and runtime controls and remediate violations.</li>\n<li><a href=\"https://docs.paloaltonetworks.com/prisma-access-browser\">Prisma Browser</a> is designed to provide multi-layered protection against extension-based threats by preventing the side-loading of unauthorized extensions, as well as detecting, blocking, and removing malicious extensions in the event of manual user installation.’</li>\n<li><a href=\"https://docs.cyberark.com/epm/latest/en/content/intro/introduction.htm\">Idira Endpoint Privilege Manager (EPM)</a> can help enable enterprises to reduce risk, satisfy compliance and streamline operations. It helps implement least privilege via policy-driven elevation and removal of standing admin rights, and blocks risky actions such as executing unvetted applications and access to memory of other processes, while providing audit-ready evidence and unified identity governance.</li>\n<li><a href=\"https://www.paloaltonetworks.com/idira/human/identity-and-access-management\">Idira Identity and Access Management (IAM)</a> can help enable secure, unified access across human, machine and AI identities, balancing granular control with a seamless user experience. Powered by SSO, phishing-resistant MFA, passwordless login and enterprise password management, Idira IAM extends intelligent privilege controls and session security across the broader workforce.</li>\n</ul><p>Organizations can access tailored adversary intelligence, direct analyst consultations, and specialized exposure tracking through <a href=\"https://www.paloaltonetworks.com/unit42/threat-intelligence\">Unit 42 Threat Intel Services</a> and its <a href=\"https://www.paloaltonetworks.com/resources/datasheets/unit-42-deep-and-dark-web-service\">Deep and Dark Web Service</a>.</p><p>If you think you may have been compromised or have an urgent matter, get in touch with the <a href=\"https://start.paloaltonetworks.com/contact-unit42.html\">Unit 42 Incident Response team</a> or call:</p><ul>\n<li>North America: Toll Free: +1 (866) 486-4842 (866.4.UNIT42)</li>\n<li>UK: +44.20.3743.3660</li>\n<li>Europe and Middle East: +31.20.299.3130</li>\n<li>Asia: +65.6983.8730</li>\n<li>Japan: +81.50.1790.0200</li>\n<li>Australia: +61.2.4062.7950</li>\n<li>India: 000 800 050 45107</li>\n<li>South Korea: +82.080.467.8774</li>\n</ul><p>Palo Alto Networks has shared these findings with our fellow Cyber Threat Alliance (CTA) members. CTA members use this intelligence to rapidly deploy protections to their customers and to systematically disrupt malicious cyber actors. Learn more about the <a href=\"https://www.cyberthreatalliance.org/\">Cyber Threat Alliance</a>.</p><h2 id=\"sec-30\">Indicators of Compromise</h2><p>Falcon C2 domains:</p><ul>\n<li><span>fonts.tarotfree101[.]top</span></li>\n<li><span>fonts.chrorne[.]com</span></li>\n<li><span>robot.avbliud[.]com</span></li>\n</ul><p>Chrome Browser Extension ID:</p><ul>\n<li><span>mbidcmlcbgbphpoacojjbmfpohcimjji</span></li>\n</ul><p>Chrome Browser Extension Files (Read: SHA-256 hash - filename):</p><ul>\n<li><span>3e535d63af8a95221fb517fa1b3e4a0029d3463d8b767443abdff385ee8cb6e9 - analytics-core.js</span></li>\n<li><span>f8b86238e179d88a9979b6f97750a39dda1d07b54d634bc1348fdfb0944a3b92 - background.js</span></li>\n<li><span>88e8b07bdf294ace0357d35acb7e108c66ba65a2c4ad66351fb8f7806dae0862 - content-script.js</span></li>\n<li><span>065d18fcfeddbd718c054f4b21c3cde5b9291db921d01f343d7ac0d4b41f29ce - icon128.png</span></li>\n<li><span>3eab406d841fa22a4b0200c95c1afab068347f835400d5771e8de60aef732016 - icon16.png</span></li>\n<li><span>5711586125909863b91c1b5ff7cf70ef5d35249d67b11d7a23dc864405cddfe2 - icon48.png</span></li>\n<li><span>b6a7be724871ed3e81c986b74d62da8911c82a336c4c1857b35f2446b2d49fda - manifest.json</span></li>\n<li><span>2ed834d92bfefc9d07a9f1a48f986974ae2a29669029f8163a1f6e8706388fcd - offscreen.html</span></li>\n<li><span>356b96c2267c5f2d8c07693643626e090b6389318b4ffa74699fa1732da5a00c - offscreen.js</span></li>\n<li><span>32af8413cbd38ce8beb257288cb8e6aa2f9b781d56d0f5272bffbcdc22d999f4 - page.html</span></li>\n<li><span>e2b6b1becdbcc340121e163b5afdfc5437a480ca132248ed5c7c309c45ac3dbb - page.js</span></li>\n<li><span>265c2b36060e4b21c25aa86a8bb22d1db5f806117b484774c75c65b5b38222e0 - sandbox.html</span></li>\n<li><span>66e9098551a1c0c74077d6cf55570e5d307a4a5ef0b0f2053e139394e61c442d - sandbox.js</span></li>\n<li><span>3e923f11db08413fca8a3a69d33d8896cfd56309e5179e8604d7fb7110428da2&nbsp; twitter-dm.js</span></li>\n</ul><p>Firefox Browser Extension Files (Read: SHA-256 hash - filename):</p><ul>\n<li><span>3e535d63af8a95221fb517fa1b3e4a0029d3463d8b767443abdff385ee8cb6e9 - analytics-core.js</span></li>\n<li><span>2ebe36f1322b77264a33fded81cd4b8817f93362945070bf0bb5845dd27c0575 - background.js</span></li>\n<li><span>857429faffe0e0747ce299e86eed063ed781b4e403b917ca7e853e89bedf072c - content-script.js</span></li>\n<li><span>065d18fcfeddbd718c054f4b21c3cde5b9291db921d01f343d7ac0d4b41f29ce - icon128.png</span></li>\n<li><span>3eab406d841fa22a4b0200c95c1afab068347f835400d5771e8de60aef732016 - icon16.png</span></li>\n<li><span>5711586125909863b91c1b5ff7cf70ef5d35249d67b11d7a23dc864405cddfe2 - icon48.png</span></li>\n<li><span>b33f2e95943e3ff0a72dea1be9fdea03d986bada4def34f6991b3113ec161ad7 - manifest.json</span></li>\n<li><span>2ed834d92bfefc9d07a9f1a48f986974ae2a29669029f8163a1f6e8706388fcd - offscreen.html</span></li>\n<li><span>898656c33effb51e109c548fc213f157f151a870ea64a4601eda74ae75bd3af6 - offscreen.js</span></li>\n<li><span>32af8413cbd38ce8beb257288cb8e6aa2f9b781d56d0f5272bffbcdc22d999f4 - page.html</span></li>\n<li><span>e2b6b1becdbcc340121e163b5afdfc5437a480ca132248ed5c7c309c45ac3dbb - page.js</span></li>\n<li><span>265c2b36060e4b21c25aa86a8bb22d1db5f806117b484774c75c65b5b38222e0 - sandbox.html</span></li>\n<li><span>b3d8ea89b19a87bf2fdd63127086681059f41d67b6e5f8c939f5636a1b2315ce - sandbox.js</span></li>\n<li><span>24d69139cb2d32598f0f4983876f6320485fac134a66ade59cab76b50b4128f7 - twitter-dm.js</span></li>\n</ul><p>Payload Delivery Domains:</p><ul>\n<li><span>microsoft-flash[.]com</span></li>\n<li><span>wps-cn[.]com</span></li>\n</ul><p>Antino Sample (Read: SHA-256 hash - filename):</p><ul>\n<li><span>0c39264337a1186b2e765e24073399cbdcba118306614eb411e315887af578bd - flashcenter_pp_ax_install_en.exe</span></li>\n</ul><h2 id=\"sec-31\">Additional Resources</h2><ul>\n<li><a href=\"https://sed-cms.broadcom.com/sites/default/files/2026-08/Jewelbug%20Dossier.pdf\">The Jewelbug Dossier [PDF]</a> — Symantec by Broadcom</li>\n<li><a href=\"https://blog.talosintelligence.com/china-nexus-uat-11587-targets-government-and-policy-organizations-across-asia-with-antino-backdoor/\">China-nexus UAT-11587 targets government and policy organizations across Asia with Antino backdoo</a>r — Talos</li>\n</ul>","original","zhKind","complete","后门","数据窃取","逆向","https://unit42.paloaltonetworks.com/falcon-c2-browser-compromise/",{"_199":200,"_201":-5},"changelogVersion","2026-10-01T08:00","release"]
