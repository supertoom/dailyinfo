[{"_1":2,"_3":4},"root",{"_5":102},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1793665813000,"id","tgpabgan6bbg80j8cvz1lgx9y","title","Ivanti Connect Secure 3 个漏洞已被主动利用","originalTitle","Multiples vulnérabilités dans Ivanti Connect Secure (02 novembre 2026)","summary","Ivanti Connect Secure 的 CVE-2026-104935、CVE-2026-111357 和 CVE-2026-118527 已被主动利用，可导致远程任意代码执行、权限提升和安全策略绕过。","reason","source",{"_63":101},"links",{"_58":100},"publishedAt","2026-11-02T00:00:00.000Z","discoveredAt","2026-11-02T15:43:33.958Z","timelineAt","category","vuln","tags",[97,64,98,99],"score",79,"selected",false,"channel","news","story","x","readingMode","full","author","body",{"_93":-5,"_58":94,"_95":-5,"_96":36},"outline",[66,67,68,69,70,71,72,73],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":30,"_63":65},{"_61":62,"_63":64},"slug","exploited","name","在野利用","漏洞披露",{"_11":91,"_75":92,"_77":78},{"_11":89,"_75":90,"_77":78},{"_11":87,"_75":88,"_77":78},{"_11":85,"_75":86,"_77":78},{"_11":83,"_75":84,"_77":78},{"_11":81,"_75":82,"_77":78},{"_11":79,"_75":80,"_77":78},{"_11":74,"_75":76,"_77":78},"sec-8","text","Gestion détaillée du document","level",2,"sec-7","Documentation","sec-6","Solutions","sec-5","Résumé","sec-4","Systèmes affectés","sec-3","Risques","sec-2","Gestion du document","sec-1","Avis du CERT-FR","zh","<h2 id=\"sec-1\">Avis du CERT-FR</h2><p>Objet : Multiples vulnérabilités dans Ivanti Connect Secure</p><h2 id=\"sec-2\">Gestion du document</h2><table>\n      <tbody>\n        <tr>\n          <th>Référence</th>\n          <td>CERTFR-2026-AVI-1442</td>\n        </tr>\n        <tr>\n          <th>Titre</th>\n          <td>Multiples vulnérabilités dans Ivanti Connect Secure</td>\n        </tr><tr>\n            <th>Date de la première version</th><td>02 novembre 2026</td>\n          </tr>\n          <tr>\n            <th>Date de la dernière version</th><td>02 novembre 2026</td>\n          </tr><tr>\n          <th>Source(s)</th>\n          <td>Bulletin de sécurité Ivanti CVE-2026-104935 du 13 octobre 2026<br></td>\n        </tr>\n      </tbody>\n    </table><p>Une gestion de version détaillée se trouve à la fin de ce document.</p><h2 id=\"sec-3\">Risques</h2><ul>\n          \n            <li>Contournement de la politique de sécurité</li>\n          \n            <li>Exécution de code arbitraire à distance</li>\n          \n            <li>Élévation de privilèges</li>\n          \n        </ul><h2 id=\"sec-4\">Systèmes affectés</h2><ul>\n          \n            <li>Connect Secure (ICS) version 22.8Rx antérieures à 22.8R2.6</li>\n          \n            <li>Connect Secure (ICS) version 25.1.1.x antérieures à 25.1.1.3</li>\n          \n            <li>Connect Secure (ICS) version 25.1.2.x antérieures à 25.1.3.1</li>\n          \n        </ul><p>Ivanti précise que les versions 25.1.3.x ne sont pas affectées par les vulnérabilités CVE-2026-111357 et CVE-2026-118527.</p><h2 id=\"sec-5\">Résumé</h2><p>De multiples vulnérabilités ont été découvertes dans Ivanti Connect Secure. Elles permettent à un attaquant de provoquer une exécution de code arbitraire à distance, une élévation de privilèges et un contournement de la politique de sécurité.</p><p>Ivanti indique que les vulnérabilités CVE-2026-104935, CVE-2026-111357 et CVE-2026-118527 sont activement exploitées.</p><h2 id=\"sec-6\">Solutions</h2><p>Se référer au bulletin de sécurité de l'éditeur pour l'obtention des correctifs (cf. section Documentation).</p><h2 id=\"sec-7\">Documentation</h2><ul>\n          \n          \n            <li>\n              <p>Bulletin de sécurité Ivanti CVE-2026-104935 du 13 octobre 2026</p>\n              <a href=\"https://hub.ivanti.com/s/article/Security-Advisory-Ivanti-Connect-Secure-CVE-2026-104935\">https://hub.ivanti.com/s/article/Security-Advisory-Ivanti-Connect-Secure-CVE-2026-104935</a>\n            </li>\n          \n\n          \n          \n            <li>\n              <p>Alerte CERT-FR CERTFR-2026-ALE-013 du 13 octobre 2026</p>\n              <a href=\"https://www.cert.cyber.gouv.fr/alerte/CERTFR-2026-ALE-013/\">/alerte/CERTFR-2026-ALE-013/</a>\n            </li>\n          \n\n          \n            <li>\n              <p>Référence CVE CVE-2026-104935</p>\n              <a href=\"https://www.cve.org/CVERecord?id=CVE-2026-104935\">https://www.cve.org/CVERecord?id=CVE-2026-104935</a>\n            </li>\n          \n            <li>\n              <p>Référence CVE CVE-2026-111357</p>\n              <a href=\"https://www.cve.org/CVERecord?id=CVE-2026-111357\">https://www.cve.org/CVERecord?id=CVE-2026-111357</a>\n            </li>\n          \n            <li>\n              <p>Référence CVE CVE-2026-118527</p>\n              <a href=\"https://www.cve.org/CVERecord?id=CVE-2026-118527\">https://www.cve.org/CVERecord?id=CVE-2026-118527</a>\n            </li>\n          \n        </ul><h2 id=\"sec-8\">Gestion détaillée du document</h2><table>\n          <thead>\n            <tr>\n              <th>Date</th>\n              <th>Description</th>\n            </tr>\n          </thead>\n          <tbody><tr>\n              <td>02 novembre 2026</td>\n              <td>Version initiale</td>\n            </tr></tbody>\n        </table>","zhKind","complete","漏洞","补丁","Ivanti","https://www.cert.cyber.gouv.fr/avis/CERTFR-2026-AVI-1442/","CERT-FR",{"_103":104,"_105":-5},"changelogVersion","2026-10-01T08:00","release"]
