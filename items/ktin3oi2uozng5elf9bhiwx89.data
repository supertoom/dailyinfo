[{"_1":2,"_3":4},"root",{"_5":128},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1794962441000,"id","ktin3oi2uozng5elf9bhiwx89","title","Amazon Bedrock AgentCore Runtime 安全暴露的两种入口架构","originalTitle","Securely exposing Amazon Bedrock AgentCore Runtime","summary","AWS Security Blog 给出 Amazon Bedrock AgentCore Runtime 对外暴露的两种纵深防御架构。","reason","source",{"_73":127},"links",{"_61":126},"publishedAt","2026-11-17T20:31:30.000Z","discoveredAt","2026-11-17T21:23:33.384Z","timelineAt","category","ai-security","tags",[75,122,123,124,125],"score",61,"selected",false,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","Meriem SMACHE","body",{"_118":-5,"_61":119,"_120":-5,"_121":36},"outline",[82,83,84,85,86,87,88,89,90,91,92],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","f00HDoqih6D4","reportCount",1,"additionalSourceCount",0,{"_71":76,"_73":77},{"_71":30,"_73":75},{"_71":72,"_73":74},"slug","blue-team","name","蓝队与运营","AI 安全","ai-agent","AI Agent 安全",{"_79":80,"_13":81},"publicId","cf8bf7fb-d9cc-4102-9e02-ec8385960198","AWS发布AgentCore Runtime安全架构",{"_11":116,"_94":117,"_96":105},{"_11":114,"_94":115,"_96":105},{"_11":112,"_94":113,"_96":105},{"_11":110,"_94":111,"_96":97},{"_11":108,"_94":109,"_96":97},{"_11":106,"_94":107,"_96":105},{"_11":103,"_94":104,"_96":105},{"_11":102,"_94":45,"_96":97},{"_11":100,"_94":101,"_96":97},{"_11":98,"_94":99,"_96":97},{"_11":93,"_94":95,"_96":97},"sec-11","text","Charline Boulie","level",3,"sec-10","Lior Perez","sec-9","Christian Kamwangala","sec-8","sec-7","Conclusion",2,"sec-6","Choosing your AgentCore Runtime patterns","sec-5","Pattern B: Expose through AgentCore Gateway","sec-4","Pattern A: Expose through API Gateway","sec-3","The AgentCore Gateway patterns","sec-2","Protecting AgentCore Runtime: What does it need?","sec-1","Why propagating identity is important","zh","<p><span><a href=\"https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/agents-tools-runtime.html\">Amazon Bedrock AgentCore Runtime</a></span> delivers a secure serverless environment to deploy AI agents and tools at scale. When you start talking to your agent, the runtime launches a dedicated isolated session that runs in its own dedicated microVM with a completely sandboxed CPU, memory, and filesystem allocation. This provides strict data governance, helps to prevent cross-tenant data leakage, and preserves context while isolating stateful reasoning from external sessions.</p><p>To govern access control across these environments, <span><a href=\"https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/identity.html\">Amazon Bedrock AgentCore Identity</a></span> provisions distinct workload identities to let your agents run. By federating directly with an <span><a href=\"https://openid.net/developers/how-connect-works/\">OpenID Connect</a></span> identity provider like <span><a href=\"https://aws.amazon.com/cognito/\">Amazon Cognito</a></span>, Okta, or others, the users can only see and interact with agents they’re authorized to use.</p><p>But securing the runtime alone doesn’t protect the ingress path perimeter. When you expose your agent to users through a web or mobile application, the <span><a href=\"https://aws.amazon.com/compliance/shared-responsibility-model/\">AWS Shared Responsibility Model</a></span> dictates that you should provide a dedicated access layer that enforces tight control over the origin and intent of every request before any traffic reaches the runtime.</p><p>The access layer acts as a trusted bridge to authenticate each incoming request, enforce authorization rules, preserve user identity through the request lifecycle, and securely channel all user traffic into the isolated runtime.</p><p>This post walks through two architectures for securing access to AgentCore Runtime and provides guidance to help you decide which architecture best fits your organization.</p><h2 id=\"sec-1\">Why propagating identity is important</h2><p>In an agentic workflow, downstream data access should remain tied to the invoking user’s identity, and each segment in the execution chain is permissioned only for the immediate next hop. Using a single static credential, even one linked to the original requester, grants every immediate component identical, broad access. This directly violates the principle of least privilege, because the ingress gateway, the proxy, and the agent’s tool execution context each require only enough permission to reach the next component.</p><p>Recent real-world incidents have demonstrated that agentic workloads can bypass internal prompt guardrails, escape the software sandboxes, and abuse static credentials to move across applications and layers. In a multi-chain agentic architecture, scoping each hop as tightly as possible is key to preventing these exploits.</p><p>However, long-running, unattended execution poses a fundamental identity challenge for extended agentic workloads. If an agent runs a complex task that takes hours, the user’s interactive session will expire before the workload ends, making their short-lived OAuth 2.0 access token invalid mid-execution. Refreshing the tokens won’t solve this problem and storing a long-lived, user-scoped credential inside the agent’s runtime environment might reintroduce exactly the broad, standing credential attack surface that the zero-trust architectures are intentionally designed to mitigate.</p><p>To mitigate this, identity propagation acts as a critical bridge between authentication at the perimeter and authorization at the data layer. The agent must operate within the invoking user’s authorization scope. Every session receives a short-lived, user-scoped token that provides only the permissions granted to that specific user and authorization is enforced at each hop. If any single segment is compromised, then the exposure is contained in that hop scope. This security model also strengthens a continuous verification process where the tokens are validated at every hop from the ingress endpoint through AgentCore to the downstream resource, so no segment operates with unverified or elevated privileges.</p><h2 id=\"sec-2\">Protecting AgentCore Runtime: What does it need?</h2><p>We explained in the previous section why identity must follow the user through every hop. However, identity propagation alone isn’t enough to secure the ingress path; it must be integrated within a broader set of ingress controls that together protect the path into the runtime.</p><p>AgentCore Runtime provides infrastructure isolation, per session microVMs, per session tool registration, and enforces the application of <span><a href=\"https://aws.amazon.com/bedrock/guardrails/\"><u>Amazon Bedrock Guardrails</u></a></span>. These features and resources protect the execution environment. However, they don’t control who reaches the runtime, how they’re authenticated, or whether their identity is preserved through the chain. That responsibility falls on the ingress control layer that you build. Securing this path requires a defense-in-depth architecture that binds every request to the user’s identity before it ever reaches the agent’s reasoning loop.</p><p>To protect and control data access, any architecture exposing AgentCore Runtime to users must satisfy the following requirements:</p><ul> \n <li><b>Authentication: </b>Continuously verify the identity of every requester at the perimeter by validating tokens against the identity provider’s public keys.</li> \n <li><b>Authorization: </b>Determine what the authenticated subject is allowed and authorized to do, which actors they can invoke, which scopes they hold and which operations they can perform.</li> \n <li><b>Per-hop least privilege:</b> Make sure each component in the chain holds only enough permission to call the next hop, eliminating broad-scope credentials. Each hop must exchange the inbound token for a down-scoped, short-lived credential valid only for the immediate downstream call.</li> \n <li><b>Identity propagation: </b>Preserve the user’s identity through the full execution chain, so the agent operates within the user’s authorization scope. For long running or unattended workloads where the user’s session closes mid-flight, the ingress must seamlessly transition the active user token into an encrypted, <span><a href=\"https://aws.amazon.com/blogs/machine-learning/the-new-agentcore-runtime-elastic-optimized-and-consistently-fast-starts/\"><u>short lived session context key from AgentCore Runtime</u></a></span>. This allows the microVM to securely assert a restricted, cryptographic snapshot of the user’s identity even when the user is completely offline.</li> \n <li><b>Edge security: </b>Inspect and filter traffic before it reaches the application logic, by applying the needed WAF rules, bot control, IP-based rate limiting, and so on.</li> \n <li><b>Network perimeter: </b>Restrict runtime access to a single secure, controlled network path. Traffic arriving from any unexpected origin must be rejected regardless of the token’s validity.</li> \n <li><b>Content protection: </b>Enforce the <span><a href=\"https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/policy-guardrails-in-policies.html\">Guardrails </a></span>on both incoming prompts for injection attacks and outgoing tool arguments for malicious payload before execution.</li> \n <li><b>Audit and logging:</b> Log every authentication outcome, the authorization decision on the tool invocations, and any security event to an externalized system for compliance and incident response.</li> \n</ul><p>These security requirements are mandatory baselines to expose any agentic workloads to users. Any missing requirement might create a potential attack vector. By applying this full set of guardrails, you help contain the impact of a potential malicious exploit to a single user, a single session and a single execution hop.</p><p>In the next section, we provide two architecture patterns that implement this propagation differently:</p><ul> \n <li><b>The first architecture </b>validates the user’s token independently at each layer while preserving it for the runtime to verify directly.</li> \n <li><b>The second architecture </b>exchanges the user’s token at the gateway boundary for scoped machine credentials, attesting the user’s identity through verified claims. This pattern is uniquely suited for handling the session context keys required by asynchronous, unattended workloads.</li> \n</ul><p>Both approaches achieve the same result: the agent acts <i>as</i> the user rather than with elevated privileges.</p><h2 id=\"sec-3\">The AgentCore Gateway patterns</h2><p>Each of the following patterns is presented the same way: the layered controls a request passes through before reaching the agent, followed by how user identity is carried to the runtime. As you explore, please note where each pattern places the trust boundary as that difference is what drives the trade-offs summarized at the end.</p><h3 id=\"sec-4\">Pattern A: Expose through API Gateway</h3><p>We expose AgentCore Runtime through <span><a href=\"https://aws.amazon.com/api-gateway/\">Amazon API Gateway</a></span>, which acts as a dedicated ingress point that terminates each client connection. Before any request reaches the agent, it must pass through layered security controls:</p><ul> \n <li>A Lambda authorizer<b>: </b>An <span><a href=\"https://aws.amazon.com/lambda\">AWS Lambda</a></span> <span><a href=\"https://docs.aws.amazon.com/apigateway/latest/developerguide/apigateway-use-lambda-authorizer.html\">authorizer</a></span> validates the Amazon Cognito-issued JSON Web Token (JWT) by verifying the signature, issuer claim and token expiration, to confirm the requester’s identity.</li> \n <li><b>AgentCore Identity</b>:<b> </b>Independently, <span><a href=\"https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/identity.html\">AgentCore Identity</a></span> performs a second validation inherent to the Lambda authorizer through <span><a href=\"https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/identity-authentication.html\">its OAuth 2.0 inbound authentication flow</a></span>. This helps to confirm the user’s identity before the request reaches the runtime to be processed.</li> \n</ul><p>Because the client-provided session ID is treated as untrusted input, the Lambda authorizer creates a composite session ID by appending the user identifier to the client-provided session ID. Even if two different users submit the same session ID, they resolve to unique composite IDs at the AgentCore Runtime level, preventing any cross-user session leakage.</p><p>To prevent denial of service attempts, we suggest using <span><a href=\"https://aws.amazon.com/dynamodb/\">Amazon DynamoDB</a></span> as a lightweight session counter. While the <span><a href=\"https://aws.amazon.com/waf/\">AWS WAF</a></span> <span><a href=\"https://docs.aws.amazon.com/waf/latest/developerguide/waf-rule-statement-type-rate-based.html\">rate-based rules</a></span> attached to the API Gateway stage protect against IP-level volumetric abuse, they evaluate requests before authentication. The <span><a href=\"https://docs.aws.amazon.com/apigateway/latest/developerguide/apigateway-use-lambda-authorizer.html\">Lambda authorizer</a></span> checks and increments a per-user counter in DynamoDB after validating the user’s identity, helping prevent a single authenticated user from exhausting agent capacity, even if they connect from multiple IP addresses. This design scales cleanly by using a composite session ID. The <span><a href=\"https://docs.aws.amazon.com/apigateway/latest/developerguide/apigateway-use-lambda-authorizer.html\">Lambda Authorizer</a></span> combines the user identifier and the client session ID, routing each user’s counter to a distinct partition. This naturally distributes write traffic and reduces the risk of hot keys.</p><p>Each session can sustain roughly 1,000 counter updates per second before <span><a href=\"https://aws.amazon.com/blogs/database/choosing-the-right-dynamodb-partition-key/\">reaching DynamoDB’s per-partition write limit,</a></span> which is far beyond what any legitimate session would ever generate. That same limit is exactly what makes the counter an effective throttle. Meanwhile, <span><a href=\"https://docs.aws.amazon.com/amazondynamodb/latest/developerguide/burst-adaptive-capacity.html\">total capacity across all users scales horizontally</a></span>, growing with the number of active sessions. For high-volume production deployments, <span><a href=\"https://docs.aws.amazon.com/amazondynamodb/latest/developerguide/on-demand-capacity-mode.html\">on-demand capacity mode</a></span> absorbs sudden spikes automatically, and <span><a href=\"https://docs.aws.amazon.com/amazondynamodb/latest/developerguide/contributorinsights.html\">CloudWatch Contributor Insights</a></span> lets you confirm traffic stays evenly distributed.</p><p>After the Lambda authorizer approves the request, as shown in the Figure 1:</p><ol> \n <li><b>API Gateway forwarding: </b>Passes the approved request to Lambda proxy that runs within an isolated environment with no internet egress.</li> \n <li><span><a href=\"https://docs.aws.amazon.com/vpc/latest/privatelink/concepts.html\">VPC endpoint</a></span> <b>routing: </b>The proxy Lambda function forwards the request to AgentCore Runtime through an <span><a href=\"https://aws.amazon.com/vpc\">Amazon Virtual Private Cloud (Amazon VPC)</a></span> endpoint, making sure that all traffic remains strictly within the private network.</li> \n <li><b>Token preservation and identity propagation: </b>The proxy Lambda function forwards the user’s token unchanged in the authorization header; this maintains the original user identity throughout the entire flow of AgentCore Runtime.</li> \n</ol><p>API Gateway forwards the request to a Lambda proxy running on a private VPC with no internet egress. The role of this Lambda proxy is to relay the request to AgentCore Runtime through a VPC endpoint, so that all communication remains within the private network. The Lambda proxy forwards the user’s token (unchanged) in the Authorization header, which preserves the user’s identity all the way to AgentCore Runtime.</p><p>\n <img src=\"/dailyinfo/media/6a1763d7e9d0fca4.webp\" srcset=\"/dailyinfo/media/a1420b5688cc5f59.webp 720w, /dailyinfo/media/547f483188d26839.webp 1200w, /dailyinfo/media/6a1763d7e9d0fca4.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Figure 1: Pattern A architecture for exposing AgentCore Runtime through Amazon API Gateway\" width=\"1260\" height=\"799\">\n </p><p>Figure 1: Pattern A architecture for exposing AgentCore Runtime through Amazon API Gateway</p><p>This VPC endpoint enforces a strict network perimeter using two independent controls:</p><ul> \n <li><b>Security groups</b>: The VPC endpoint <span><a href=\"https://docs.aws.amazon.com/vpc/latest/userguide/vpc-security-groups.html\">security group</a></span> restricts ingress solely to the proxy Lambda function on port 443, so no other compute in the account can reach the endpoint.</li> \n <li><b>Resource-based policy</b>: The runtime <span><a href=\"https://docs.aws.amazon.com/IAM/latest/UserGuide/access_policies_identity-vs-resource.html\">resource-based policy</a></span> is configured with principal <code>\"*\"</code> and a condition that allows invocations only when the request carries <code>aws:SourceVpc</code> and <code>aws:SourceVpce</code> values matching this stack’s VPC and endpoint. Authentication happens at the AgentCore Identity level, so there is no <span><a href=\"https://aws.amazon.com/iam\">AWS Identity and Access Management (IAM)</a></span> principal to match, and the network path is the only meaningful gate and condition that remains. AgentCore Runtime rejects requests sent directly from outside the VPC with an <code>AccessDeniedException</code>, even with a valid JWT.</li> \n</ul><p>Beyond the network boundary, Amazon Bedrock Guardrails evaluates each model’s invocation for prompt injection attacks, helping catch malicious inputs even after an invocation has passed identity and network verification. This adds content protection as a defensive layer independent of identity and network controls.</p><p>Your stack logs and tracks every authorization outcome along this path as structured JSON to <span><a href=\"https://aws.amazon.com/cloudwatch/\">Amazon CloudWatch</a></span>, with an <span><a href=\"https://docs.aws.amazon.com/AmazonCloudWatch/latest/monitoring/AlarmThatSendsEmail.html\">INVALID_JWT alarm</a></span>. The full walkthrough and a deployable <span><a href=\"https://aws.amazon.com/cdk\">AWS Cloud Development Kit (AWS CDK)</a></span> sample are linked at the end of this post.</p><p>Before production deployment, we recommend configuring an <span><a href=\"https://aws.amazon.com/waf/\">AWS WAF</a></span> <span><a href=\"https://docs.aws.amazon.com/waf/latest/developerguide/web-acl.html\"><u>Web ACL</u></a></span> at the API Gateway stage to inspect requests before they reach the Lambda authorizer. You should include <span><a href=\"https://docs.aws.amazon.com/waf/latest/developerguide/aws-managed-rule-groups-baseline.html#aws-managed-rule-groups-baseline-crs\">AWSManagedRulesCommonRuleSet</a></span> and <span><a href=\"https://docs.aws.amazon.com/waf/latest/developerguide/aws-managed-rule-groups-baseline.html#aws-managed-rule-groups-baseline-known-bad-inputs\">AWSManagedRulesKnownBadInputsRuleSet</a></span> for <span><a href=\"https://owasp.org/projects/top-ten\">generic OWASP Top 10</a></span> protections and known exploit patterns, <span><a href=\"https://docs.aws.amazon.com/waf/latest/developerguide/aws-managed-rule-groups-use-case.html#aws-managed-rule-groups-use-case-sql-db\">AWSManagedRulesSQLiRuleSet</a></span> to catch injection signatures, a per-IP rate-based rule ahead of the <span><a href=\"https://docs.aws.amazon.com/amazondynamodb/latest/developerguide/TroubleshootingThrottling.html\">DynamoDB</a></span> throttle counters, and custom rules to reject oversized requests or malformed session IDs early. For a step-by-step integration guide including two deployment patterns for placing AWS WAF in front of the AgentCore Runtime, see <span><a href=\"https://aws.amazon.com/blogs/machine-learning/securing-amazon-bedrock-agentcore-runtime-with-aws-waf/\">Securing Amazon Bedrock AgentCore Runtime with AWS WAF</a></span>.</p><p>This first pattern satisfies the ingress security requirements discussed earlier. It achieves defense in depth by applying the authentication at two independent layers, enforcing authorization through session binding and controlling traffic through per-user throttling. The architecture maintains per-hop least privilege from the API Gateway through the AgentCore Runtime while preserving end-user identity propagation by passing the user’s token through unchanged. The edge filtering is managed with AWS WAF and the network perimeter is enforced by VPC endpoint controls. The design includes the application of <span><a href=\"https://docs.aws.amazon.com/bedrock/latest/userguide/agents-guardrail.html\">Amazon Bedrock Guardrails</a></span> for content security with a tamper-proof audit trail in <span><a href=\"https://aws.amazon.com/cloudwatch\">Amazon CloudWatch</a></span>. The deployable <span><a href=\"https://github.com/aws-samples/sample-expose-agentcore-via-api-gateway/tree/main/pattern-a-api-gateway\">CDK sample for pattern A</a></span> is available on GitHub.</p><h3 id=\"sec-5\">Pattern B: Expose through AgentCore Gateway</h3><p>With Pattern B, you expose AgentCore Runtime through <span><a href=\"https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/gateway.html\">Amazon Bedrock AgentCore Gateway</a></span>, a managed service purpose-built for agentic traffic that combines ingress authentication, token exchange and Runtime routing without requiring a proxy Lambda function or custom VPC networking.</p><p>Before any request reaches the agent, it passes the following layered security controls:</p><ul> \n <li><b>Inbound authentication: </b>A <span><a href=\"https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/inbound-jwt-authorizer.html\">custom JWT inbound authorizer</a></span> is configured on AgentCore Gateway that validates the <span><a href=\"https://docs.aws.amazon.com/cognito/latest/developerguide/amazon-cognito-user-pools-using-tokens-verifying-a-jwt.html\">Amazon Cognito JWT</a></span> by verifying its signature, issuer, and expiration before any logic runs.</li> \n <li><b>Identity extraction, session binding and guardrails: </b>A REQUEST interceptor for Lambda, invoked directly by AgentCore Gateway, extracts the verified user identity claims from the validated token for downstream injection. For asynchronous or unattended workloads, this interceptor securely binds these claims into an encrypted, short lived session context key. This helps ensure that even if the user’s interactive session expires hours later, <span><a href=\"https://aws.amazon.com/blogs/machine-learning/the-new-agentcore-runtime-elastic-optimized-and-consistently-fast-starts/\">a secure snapshot of their identity remains intact</a></span>. It mirrors the role of the Lambda authorizer in Pattern A, enforcing the same session-binding and throttling logic.</li> \n <li><b>Perimeter authorization (AgentCore Policy): </b><span><a href=\"https://github.com/aws-samples/sample-amazon-bedrock-agentcore-onboarding/blob/main/08_policy/README.md\">AgentCore Gateway uses a deterministic Cedar-based policy engine</a></span> to evaluate each request against <span><a href=\"https://github.com/aws-samples/sample-amazon-bedrock-agentcore-onboarding/blob/main/08_policy/README.md\">defined policies before allowing tool access</a></span>. It also enforces Amazon Bedrock Guardrails through <span><a href=\"https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/policy.html\">AgentCore Policy</a></span> for screening prompt injection and content violations at the gateway level, before the request reaches the agent. This declarative enforcement is an advantage over the API Gateway pattern where guardrails must be invoked programmatically from within the agent code.</li> \n</ul><p>After the authorization succeeds, the gateway manages the outbound call to AgentCore Runtime by using a strict workload isolation mechanism as shown in Figure 2:</p><ol> \n <li><b>Token exchange: </b>The gateway requests a machine-to-machine (M2M) token from AgentCore Identity using a dedicated Amazon Cognito M2M app client and attaches it to the request.</li> \n <li><b>Workload verification: </b>The AgentCore Runtime validates this token against the <span><a href=\"https://docs.aws.amazon.com/bedrock-agentcore-control/latest/APIReference/API_AllowedWorkloadConfiguration.html\">allowedWorkloadConfiguration</a></span> parameter, confirming the request originated from the gateway.</li> \n <li><b>On-behalf-of access: </b>The runtime unpacks the session context key, allowlists the injected user identity passed by the interceptor and forwards it directly to the agent to enable secure, context-aware execution on behalf of the user, even during completely unattended background execution loops.</li> \n</ol><p>\n <img src=\"/dailyinfo/media/a29082a9a9cd1b99.webp\" srcset=\"/dailyinfo/media/0f37f05aa03d1188.webp 720w, /dailyinfo/media/be2baceebfffed10.webp 1200w, /dailyinfo/media/a29082a9a9cd1b99.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Figure 2: Pattern B architecture for exposing AgentCore runtime through AgentCore Gateway\" width=\"1289\" height=\"775\">\n </p><p>Figure 2: Pattern B architecture for exposing AgentCore runtime through AgentCore Gateway</p><p>If a client attempts to bypass the gateway by sending a valid user token directly to the runtime, the request is automatically rejected because it lacks the required workload identity.</p><p>For more operational efficiency, AgentCore Gateway integrates AWS WAF directly at the single gateway access point, protecting the entire ingress path in one place, without the need to manage separate authorizers, proxy Lambda functions or VPC endpoints.</p><p>While API Gateway also supports AWS WAF, the AgentCore Gateway pattern simplifies management by consolidating all ingress controls behind a single component.</p><p><span><a href=\"https://aws.amazon.com/blogs/machine-learning/configure-rate-limits-for-ai-traffic-on-agentcore-gateway/\">The AgentCore Gateway also supports native rate limiting</a></span>, removing the need for custom DynamoDB-based throttle tables, for your production environments. The interceptor writes a structured audit trail to CloudWatch, with an <span><a href=\"https://docs.aws.amazon.com/AmazonCloudWatch/latest/monitoring/AlarmThatSendsEmail.html\">INVALID_JWT alarm</a></span> to flag spikes in authentication failures.</p><p>Before production deployment, we strongly recommend that you enable AWS WAF on the AgentCore gateway with the same rule sets described in the API Gateway pattern, including the OWASP protections, SQL injection, and custom rules for oversized or malformed requests.</p><p>To summarize, this second architecture satisfies the ingress security requirements defined earlier. It achieves defense in depth by applying a managed CUSTOM_JWT authorizer directly at the entry point, enforcing authorization through interceptor-based session binding and using rate limiting to control traffic. This pattern maintains per-hop least privileges from AgentCore Gateway through to the runtime by automating M2M token exchange, while propagating user identity for on-behalf-of execution. The edge security is managed by AWS WAF, coming directly with the gateway’s single-entry point, and secure workload isolation strictly enforces the perimeter. Finally, this design applies declarative <span><a href=\"https://aws.amazon.com/bedrock/guardrails/\">Amazon Bedrock Guardrails</a></span> for early content safety, and a tamper-proof audit trail and alarms in CloudWatch. The complete <span><a href=\"https://github.com/aws-samples/sample-expose-agentcore-via-api-gateway/tree/main/pattern-b-agentcore-gateway\"><u>CDK sample for Pattern B</u></a></span> is available on GitHub.</p><h2 id=\"sec-6\">Choosing your AgentCore Runtime patterns</h2><p>As explained earlier, securing access to <span><a href=\"https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/agents-tools-runtime.html\"><u>AgentCore Runtime</u></a></span> can be achieved through two different patterns: The <span><a href=\"https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/gateway.html\"><u>AgentCore Gateway</u></a></span> pattern or the <span><a href=\"https://aws.amazon.com/api-gateway/\"><u>Amazon API Gateway</u></a></span> pattern. The right choice depends on your existing AWS infrastructure, workload constraints, and operational preferences.</p><p>Choose the Amazon API Gateway pattern if:</p><ul> \n <li><b>You have existing API infrastructure</b>: Your team already runs an established <span><a href=\"https://aws.amazon.com/api-gateway/\">Amazon API Gateway</a></span> and <span><a href=\"https://aws.amazon.com/waf/\">AWS WAF</a></span> deployment</li> \n <li><b>You need a single entry point</b>: You prefer to fold agentic traffic into your existing pipelines rather than introducing a separate entry point to operate and secure.</li> \n <li><b>Your security model is VPC centric</b>: Your security and compliance teams rely on VPCs and <span><a href=\"https://docs.aws.amazon.com/vpc/latest/userguide/vpc-security-groups.html\">security groups</a></span> as their primary network control layer</li> \n <li><b>Your agent sessions are short-lived</b>: While API Gateway has increased its integration timeout beyond 29 seconds, long running agentic workloads with streaming tool calls might still exceed it. This isn’t a concern if your sessions are brief.</li> \n</ul><p>Choose the AgentCore Gateway pattern if:</p><ul> \n <li><b>You’re building a new gateway:</b> Your organization has no existing API Gateway</li> \n <li><b>You have long run workloads</b>: Your agents use streaming or long running tool calls that require strict API timeouts</li> \n <li><b>You need low operational overhead</b>: You prefer a fully managed perimeter over manually wired infrastructure</li> \n <li><b>You require advanced AI routing</b>: You want built-in capabilities to convert APIs and Lambda functions into <span><a href=\"https://aws.amazon.com/blogs/aws/the-aws-mcp-server-is-now-generally-available/\">Model Context Protocol (MCP)</a></span> tools, handle Agent to Agent (A2A) traffic and route inference across different model providers.</li> \n</ul><p>The following table summarizes the key elements that help you make the right architectural decision:</p><table> \n <tbody> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\"><b>Consideration</b></td> \n   <td colspan=\"1\" rowspan=\"1\"><b>API Gateway (Pattern A)</b></td> \n   <td colspan=\"1\" rowspan=\"1\"><b>AgentCore Gateway (Pattern B)</b></td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\"><b>Suited to</b></td> \n   <td colspan=\"1\" rowspan=\"1\">Teams already standardized on API Gateway</td> \n   <td colspan=\"1\" rowspan=\"1\">Teams starting fresh who want less infrastructure to operate.</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\"><b>Perimeter control</b></td> \n   <td colspan=\"1\" rowspan=\"1\">Runtime resource policy with aws:SourceVpc and VPC endpoint security group</td> \n   <td colspan=\"1\" rowspan=\"1\">Runtime workload lock (<span><a href=\"https://docs.aws.amazon.com/bedrock-agentcore-control/latest/APIReference/API_AllowedWorkloadConfiguration.html\"><u>allowedWorkloadConfiguration</u></a></span>).</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\"><b>Components to operate</b></td> \n   <td colspan=\"1\" rowspan=\"1\">API Gateway, Lambda authorizer, Amazon VPC, VPC endpoints, proxy Lambda function</td> \n   <td colspan=\"1\" rowspan=\"1\">AgentCore Gateway and Lambda REQUEST interceptor.</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\"><b>User identity to agent</b></td> \n   <td colspan=\"1\" rowspan=\"1\">User JWT forwarded unchanged (no <span><a href=\"https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_sigv.html\">SigV4</a></span>)</td> \n   <td colspan=\"1\" rowspan=\"1\">Interceptor-injected verified headers (OAuth outbound M2M token).</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\"><b>AWS WAF</b></td> \n   <td colspan=\"1\" rowspan=\"1\">Attach directly to the API stage</td> \n   <td colspan=\"1\" rowspan=\"1\">Attach directly to the gateway.</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\"><b>Request timeout</b></td> \n   <td colspan=\"1\" rowspan=\"1\">Inherits the API Gateway integration timeout</td> \n   <td colspan=\"1\" rowspan=\"1\">Not subject to this limitation.</td> \n  </tr> \n  <tr> \n   <td colspan=\"1\" rowspan=\"1\"><b>Public endpoint</b></td> \n   <td colspan=\"1\" rowspan=\"1\">Can be fully private (API Gateway PRIVATE endpoint type)</td> \n   <td colspan=\"1\" rowspan=\"1\">Supports <span><a href=\"https://aws.amazon.com/privatelink/\">AWS PrivateLink</a></span> ingress and <span><a href=\"https://aws.amazon.com/vpc/lattice/\">VPC Lattice</a></span> egress, but keeps a public endpoint active. Access relies on the JWT authorizer and resource policy rather than removing the endpoint</td> \n  </tr> \n </tbody> \n</table><h2 id=\"sec-7\">Conclusion</h2><p>By securing access to the AgentCore Runtime with a defense in depth, an agent can be both highly usable and secure. The two patterns in this post complete the shared responsibility model for you: they authenticate every request against the identity provider, authorize it at each step and propagate the user’s identity end-to-end from the edge through the token exchange into the isolated microVM (AgentCore Runtime) and down to the agent’s tool calls (AgentCore Gateway). Each step only holds a short-lived credential for the next one, so the agent always works within the user’s permissions rather than with broad, long-term access. If one step is ever compromised, the design limits the impact to that single step, session and user. Whether the runtime is behind API Gateway with a VPC endpoint or in front of it with AgentCore Gateway, the design verifies each request at each step.</p><p>To get started, clone the <span><a href=\"https://github.com/aws-samples/sample-expose-agentcore-via-api-gateway/tree/main/pattern-a-api-gateway\"><u>Pattern A sample</u></a></span> or the <a href=\"https://github.com/aws-samples/sample-expose-agentcore-via-api-gateway/tree/main/pattern-b-agentcore-gateway\">Pattern B sample</a>, deploy it in your account, and test it against your requirements. Both samples are provided as a starting point, not a production-ready deployment. We recommend working with your security and legal teams to adapt to the controls before going live. From there, you can extend either pattern for multi-tenant use, add observability hooks, or tighten controls for your specific compliance requirements.</p><p>If you have questions about this post, contact <span><a href=\"https://aws.amazon.com/contact-us/\"><u>AWS Support</u></a> or start a new thread on <span><a href=\"https://repost.aws/\"><u>AWS re:Post.</u></a></span></span></p><hr><p>\n   <img src=\"/dailyinfo/media/26a73a2e20bc9a43.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Merriem-SMACHE\" width=\"120\" height=\"160\">\n  </p><h3 id=\"sec-8\">Meriem SMACHE</h3><p>Meriem is a Security Specialist Solutions Architect at AWS, supporting customers in the design and deployment of resilient cloud and AI solutions, from generative AI workloads to fully autonomous agentic systems, that meet their regulatory requirements and security needs.</p><p> \n   <img src=\"/dailyinfo/media/9e43454a37acfe1d.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"Christian Kamwangala\" width=\"120\" height=\"160\"> \n  </p><h3 id=\"sec-9\">Christian Kamwangala</h3><p>Christian is a Senior AI/ML and Generative AI Specialist Solutions Architect at AWS, based in Paris, France. He partners with enterprise customers to architect, optimize, and deploy production-grade AI solutions using the comprehensive AWS ML stack. Christian specializes in inference optimization techniques that balance performance, cost, and latency requirements for large-scale deployments. Christian enjoys exploring nature and spending time with family and friends.</p><p> \n   <img src=\"/dailyinfo/media/8079cd451c55d79f.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"Lior Perez\" width=\"120\" height=\"160\"> \n  </p><h3 id=\"sec-10\">Lior Perez</h3><p>Lior is a Principal AI &amp; Machine Learning Solutions Architect at Amazon Web Services, based in Toulouse, France. He helps customers speed up their digital transformation with AI. He wrote the AWS Prescriptive Guidance Governing and Architecting the Diversity of Agentic AI at Scale, which helps enterprises design and govern AI agents. He makes complex ideas simple and practical. His background in manufacturing and meteorology gives him a different way of looking at business challenges. </p><p> \n   <img src=\"/dailyinfo/media/85b9ec4e3ad1a5b1.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"Charline Boulie\" width=\"120\" height=\"160\"> \n  </p><h3 id=\"sec-11\">Charline Boulie</h3><p>Charline is a Senior Solutions Architect at AWS. She helps French FinTech startups and scale-ups build and scale secure, generative AI-powered workloads, focusing on agentic AI, application development and security. She brings 15 years of software and cloud architecture experience from Thales Avionics and AWS Professional Services, and champions women in tech through mentoring and student outreach.</p>","zhKind","complete","Agent 安全","大模型","加固","AWS","https://aws.amazon.com/blogs/security/securely-exposing-amazon-bedrock-agentcore-runtime/","AWS Security Blog",{"_129":130,"_131":-5},"changelogVersion","2026-10-01T08:00","release"]
