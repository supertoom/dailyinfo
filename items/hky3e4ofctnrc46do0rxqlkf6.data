[{"_1":2,"_3":4},"root",{"_5":90},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794876029000,"id","hky3e4ofctnrc46do0rxqlkf6","title","mail-parser 的 write_attachments() 可被恶意附件中断并遗漏后续附件，4.6.3 已修复","originalTitle","mail-parser: One hostile attachment aborts `write_attachments()` and silently drops the rest of the batch","summary","mail-parser 4.6.0 至 4.6.2 的 write_attachments() 遇到单个恶意附件时会抛出未捕获异常，导致该附件之后的文件不再写入且不向仅捕获 MailParserError 的调用方报告，可借文件名 NUL、超长 basename 或无效 base64 触发。","reason","source",{"_71":89},"links",{"_59":88},"publishedAt","2026-11-16T22:22:13.000Z","discoveredAt","2026-11-16T22:28:15.593Z","timelineAt","category","vuln","tags",[83,84,85,86,87],"score",49,"selected",false,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","body","outline",[],"relatedStories",[79],"topics",[66,67,68,69],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","f_b-HuW-ZUn0","reportCount",1,"additionalSourceCount",0,{"_70":77,"_71":78},{"_70":75,"_71":76},{"_70":73,"_71":74},{"_70":30,"_71":72},"slug","name","漏洞披露","black-market","数据窃取与黑产","ransomware","勒索软件","email","邮件与钓鱼",{"_80":81,"_13":82},"publicId","35705deb-5514-4398-a8eb-74826147c764","mail-parser附件写入中断漏洞已修复","漏洞","补丁","复现","邮件安全","数据窃取","https://github.com/advisories/GHSA-8cgq-x343-p74c","GitHub 安全公告",{"_91":92,"_93":-5},"changelogVersion","2026-10-01T08:00","release"]
