[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":37,"_59":60},"expiresAt",1795221631000,"id","cc7qsurqjcbzxqury8oid8a18","title","Rakuten Securities 数据泄露或影响近 1600 万个账户","originalTitle","Rakuten Securities Breach Could Impact 15 Million Customers","summary","Rakuten Securities 表示，11 月 11 日测试环境中的部分信息被泄露至外部，4.47 million 个账户的资料被窃取，另有 11.25 million 个账户仅被窃取分支或客户代码及登录 ID，合计接近 16 million 人。","reason","事件揭示测试环境泄露与后续钓鱼风险之间的关联，并为金融机构隔离敏感数据及强化抗钓鱼登录提供参考。","source",{"_72":96},"links",{"_89":95},"publishedAt","2026-11-19T09:20:00.000Z","discoveredAt","2026-11-19T09:59:06.573Z","timelineAt","category","activity","tags",[73,93,94,77],"score",82,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","body",{"_60":88,"_89":-5,"_90":91,"_92":37},"outline",[82],"relatedStories",[78],"topics",[67,68,69],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","fFno4bvyFpAU","reportCount",1,"additionalSourceCount",0,{"_70":76,"_72":77},{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","attack","name","攻击活动","email","邮件与钓鱼","identity","身份与访问",{"_79":80,"_13":81},"publicId","e96104e6-d2b9-4363-bef2-e506be16553e","乐天证券确认近1560万账户数据泄露",{"_11":83,"_84":85,"_86":87},"sec-1","text","Rakuten敦促采用通行密钥","level",2,"<p><img src=\"/dailyinfo/media/0d77f8a50cd1f607.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Photo of Phil Muncaster\"></p><p>\n\t日本领先的在线券商之一披露了一起重大客户账户数据泄露事件，可能影响近1600万人。</p><p>\n\t总部位于东京的Rakuten Securities允许散户交易股票、债券、外汇及其他金融工具。</p><p>\n\t该公司是日本科技集团Rakuten Group旗下企业，于11月17日向客户道歉，称其在前一天首次发现系统遭到未经授权的访问。</p><p>\n\t“根据我们的调查，我们确认11月11日星期三，测试环境系统内管理的部分信息可能已泄露给外部方，”该公司表示。“我们正在继续调查此次未经授权访问的原因及详细情况。”</p><p>\n\t<a href=\"https://www.infosecurity-magazine.com/news/japan-gmo-internet-disconnect/\"><em>进一步阅读有关日本的数据泄露事件：日本GMO Internet敦促客户断开个人电脑的连接</em></a></p><p>\n\t这家证券巨头表示，约447万个账户的网点/客户代码、登录ID、姓名、出生日期、地址、电话号码、电子邮件地址、雇主信息、提现账户详情、年收入、资产信息及最后登录日期已遭泄露。</p><p>\n\t该公司补充称，另有数量更大的1125万个账户仅其Rakuten Securities网点/客户代码和登录ID被窃取。</p><p>\n\t该公司确认密码、PIN及其他信息未被窃取，也没有迹象显示客户账户遭到未经授权的访问。</p><p>\n\t安全专家质疑为何允许在测试环境中使用生产数据。</p><p>\n\tBlack Hills Information Security所有者John Strand argues称：“这不是什么先进的安全理念，也不是需要复杂技术才能解决的问题。这是保护敏感信息最基本的原则之一，然而我们仍不断看到组织犯下这类错误。”</p><p>\n\t“正确的做法是设置独立的开发、测试和预发布环境，并为每个环境明确规定安全控制措施。”</p><h2 id=\"sec-1\">\n\t<strong>Rakuten敦促采用通行密钥</strong></h2><p>\n\tRakuten Securities警告客户提防后续网络钓鱼行为，推测其意图是诱骗个人交出登录凭据。</p><p>\n\t该公司表示，目前超过90%的客户使用&nbsp;<a href=\"https://www.infosecurity-magazine.com/news/police-urge-passkey-surge/\">抗网络钓鱼通行密钥</a>登录，并敦促其余客户改用通行密钥，以降低账户被接管的风险。</p><p>\n\t去年，监管机构金融厅（FSA）<a href=\"https://www.infosecurity-magazine.com/news/japanese-account-hijackers-2bn/\">警告称</a>日本证券公司的账户劫持事件大幅增加，黑客进行了价值超过3040亿日元（20亿美元）的非法交易。</p><p>\n\t该公司称，黑客试图通过推高其持有的小盘股价值来操纵市场，以便以更高利润出售。</p><p>\n\tRakuten Securities的困境出现在日本企业经历糟糕一年之际，该国企业接连遭遇数据泄露和勒索软件攻击。</p><p>\n\t受影响的企业包括Burger King（1100万名客户）、汽车租赁公司Times Car（660万名）、卡拉OK<a href=\"https://www.infosecurity-magazine.com/news/karaoke-giant-data-breach-eight/\">巨头Daiichi Kosho</a>（800万名）以及烤肉连锁店Yakiniku King（1100万名）。</p><p>\n\t10月，受到勒索软件攻击者入侵的虚拟桌面公司GMO（在外汇交易员中颇受欢迎）<a href=\"https://www.infosecurity-magazine.com/news/japan-gmo-internet-disconnect/\">敦促客户断开</a>其设备与互联网的连接。</p>","original","zhKind","translation","complete","数据泄露","钓鱼","https://www.infosecurity-magazine.com/news/rakuten-securities-breach-15/","Infosecurity Magazine",{"_98":99,"_100":-5},"changelogVersion","2026-10-01T08:00","release"]
