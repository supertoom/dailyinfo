[{"_1":2,"_3":4},"root",{"_5":156},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1795480847000,"id","y1q31smahyra1wu2i286xr7ey","title","Unit 42披露Com关联组织以语音钓鱼窃取数据并实施勒索","originalTitle","Dialing for Data: Inside the Com’s High-Profile Heists","summary","Unit 42追踪到Bling Libra及多个Com关联活动簇通过语音钓鱼和AiTM页面窃取凭据与MFA批准，随后借助原生云工具、脚本和恶意浏览器扩展定位高价值数据、批量外传并发送勒索信息。","reason","材料结合遥测与事件响应还原了多组关联活动簇的入侵链、受害行业变化及恶意扩展能力，便于比较其数据窃取手法。","source",{"_68":45},"links",{"_145":155},"publishedAt","2026-11-20T22:00:25.000Z","discoveredAt","2026-11-20T22:34:32.487Z","timelineAt","category","activity","tags",[71,69,149,150,151,77,152,153,154],"score",81,"selected",true,"channel","news","story","x","readingMode","full","author","Unit 42","body",{"_59":144,"_145":-5,"_146":147,"_148":37},"outline",[80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99],"relatedStories",[],"topics",[60,61,62,63,64,65],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_66":78,"_68":79},{"_66":76,"_68":77},{"_66":74,"_68":75},{"_66":72,"_68":73},{"_66":70,"_68":71},{"_66":67,"_68":69},"slug","malware","name","恶意软件","attack","攻击活动","ransomware","勒索软件","email","邮件与钓鱼","identity","身份与访问","paloalto","Palo Alto Networks",{"_11":142,"_101":143,"_103":104},{"_11":140,"_101":141,"_103":104},{"_11":138,"_101":139,"_103":104},{"_11":136,"_101":137,"_103":107},{"_11":134,"_101":135,"_103":107},{"_11":132,"_101":133,"_103":107},{"_11":130,"_101":131,"_103":104},{"_11":128,"_101":129,"_103":107},{"_11":126,"_101":127,"_103":104},{"_11":124,"_101":125,"_103":107},{"_11":122,"_101":123,"_103":107},{"_11":120,"_101":121,"_103":104},{"_11":118,"_101":119,"_103":104},{"_11":116,"_101":117,"_103":107},{"_11":114,"_101":115,"_103":107},{"_11":112,"_101":113,"_103":107},{"_11":110,"_101":111,"_103":107},{"_11":108,"_101":109,"_103":107},{"_11":105,"_101":106,"_103":107},{"_11":100,"_101":102,"_103":104},"sec-20","text","其他资源","level",2,"sec-19","User-Agent 字符串",3,"sec-18","MFA 设备名称","sec-17","完全限定域名（FQDN）","sec-16","IP 地址","sec-15","URL","sec-14","SHA-256 哈希","sec-13","失陷指标","sec-12","结论","sec-11","攻击者行动手册","sec-10","基础设施与工具","sec-9","战术、技术与程序","sec-8","谁在遭受攻击：行业与国家","sec-7","受害者特征","sec-6","恶意浏览器扩展","sec-5","新兴活动集群 CL-CRI-1274（Cinder）","sec-4","新兴活动集群 CL-CRI-1264（Vortex）","sec-3","最新洞察","sec-2","背景","sec-1","执行摘要","<h2 id=\"sec-1\">执行摘要</h2><p>近几个月来，Unit 42 跟踪并响应了由与 Com 有关联的威胁行为体发动的多轮语音钓鱼攻击。这些攻击已导致数据窃取和勒索企图。此类活动针对数据密集型行业，例如金融服务业、医疗保健业和法律服务业。目标组织主要位于美国、英国和澳大利亚。</p><p>对此类广泛活动的归因包括：</p><ul>\n<li>已命名行为体，例如 <a href=\"https://unit42.paloaltonetworks.com/tag/bling-libra/\">Bling Libra（又称 ShinyHunters）</a></li>\n<li>活动集群 <a href=\"https://rhisac.org/threat-intelligence/extortion-in-the-enterprise-defending-against-blackfile-attacks/\">CL-CRI-1116（又称 Redact，原名 BlackFile）</a>、<a href=\"https://github.com/PaloAltoNetworks/Unit42-timely-threat-intel/blob/main/2026-06-03-Pink-Extortion-Brand-Activity.txt?utm_campaign=tti_pinkextortion\">CL-CRI-1147（又称 Pink）</a>、<a href=\"https://github.com/PaloAltoNetworks/Unit42-timely-threat-intel/blob/main/2026-07-15-CL-CRI-1182-activity.txt\">CL-CRI-1182（又称 Falcon）</a>、CL-CRI-1192（又称 Helix）</li>\n<li>新发现的 CL-CRI-1264（又称 Vortex）和 CL-CRI-1274（又称 Cinder），其活动与 Google 跟踪的 UNC6671 存在重叠</li>\n</ul><p>本文详述：</p><ul>\n<li>我们基于独特遥测分析和事件响应工作，自 2026 年 8 月以来对持续的、与 Com 有关联威胁活动的观察</li>\n<li>我们跟踪的不同命名行为体和活动集群，包括此前未披露的独特观察</li>\n<li>关于受害者的洞察</li>\n<li>对攻击者战术、技术和程序（TTP）的审查</li>\n<li>随着我们迈向 2027 年，对未来活动的预示</li>\n</ul><p>Palo Alto Networks 客户可通过以下产品和服务获得针对上述威胁更好的保护：</p><ul>\n<li><a href=\"https://docs.paloaltonetworks.com/wildfire\">Advanced WildFire</a></li>\n<li><a href=\"https://docs.paloaltonetworks.com/advanced-url-filtering\">Advanced URL Filtering</a>、<a href=\"https://docs.paloaltonetworks.com/dns-security\">Advanced DNS Security</a> 和 <a href=\"https://www.paloaltonetworks.com/network-security/advanced-ip-defense\">Advanced IP Defense</a></li>\n<li><a href=\"https://www.paloaltonetworks.com/cortex/cortex-xdr\">Cortex XDR</a> 和<a href=\"https://www.paloaltonetworks.com/resources/datasheets/cortex-xsiam-aag\"> XSIAM</a></li>\n<li><a href=\"https://www.koi.ai/product/endpoint\">Cortex Agentic Endpoint Security</a></li>\n<li><a href=\"https://docs.paloaltonetworks.com/prisma-access-browser\">Prisma Browser </a></li>\n<li><a href=\"https://docs.paloaltonetworks.com/iot/getting-started/iot-security-solution\">Device Security</a></li>\n<li><a href=\"https://www.paloaltonetworks.com/idira/human/identity-and-access-management\">Idira Identity and Access Management (IAM)</a></li>\n<li><a href=\"https://docs.cyberark.com/detect-and-respond/latest/en/content/get-started/what-is-detect-and-respond.htm\">Idira Identity Threat Detection and Response (ITDR) </a></li>\n<li><a href=\"https://docs.cyberark.com/manage/latest/en/content/sws/getstarted/sws-introduction-2.htm\">Idira Secure Web Sessions (SWS)</a></li>\n</ul><p>组织可通过<a href=\"https://www.paloaltonetworks.com/unit42/threat-intelligence\"> Unit 42 Threat Intel Services</a>及其<a href=\"https://www.paloaltonetworks.com/resources/datasheets/unit-42-deep-and-dark-web-service\"> Deep and Dark Web Service</a>获取定制的对手情报、分析师直接咨询和专门的暴露面跟踪服务。</p><p>如果您认为自己可能已遭入侵，或有紧急事项，请联系 <a href=\"https://start.paloaltonetworks.com/contact-unit42.html\">Unit 42 事件响应团队</a>。</p><table>\n<thead>\n<tr>\n<td><b>相关 Unit 42 主题</b></td>\n<td><a href=\"https://unit42.paloaltonetworks.com/tag/extortion/\"><b>勒索</b></a>、<strong><a href=\"https://unit42.paloaltonetworks.com/tag/vishing/\">语音钓鱼</a></strong>、<strong><a href=\"https://unit42.paloaltonetworks.com/tag/social-engineering/\">社会工程</a></strong>、<strong><a href=\"https://unit42.paloaltonetworks.com/tag/bling-libra/\">Bling Libra</a></strong>、<strong><a href=\"https://unit42.paloaltonetworks.com/tag/browser-extensions/\">浏览器扩展</a></strong></td>\n</tr>\n</thead>\n</table><h2 id=\"sec-2\">背景</h2><p>自 2026 年初以来，我们已响应了多起数据窃取和勒索企图，并将其归因于 Bling Libra 及其他与 Com 有关联的威胁行为体。有关攻击者常用作战手册的更多详细信息，请参阅本文的<a href=\"https://unit42.paloaltonetworks.com/com-affiliate-vishing-attacks/#post-189953-_i1krwwlb02i5\">战术、技术和程序部分</a>。</p><p>我们使用威胁组织、活动集群的命名约定来跟踪这些活动，相关命名见表 1。</p><table>\n<tbody>\n<tr>\n<td><b>行为体/集群</b></td>\n<td><b>别名</b></td>\n<td><b>首次发现时间</b></td>\n<td><b>TOX ID</b></td>\n<td><b>基础设施观察</b></td>\n</tr>\n<tr>\n<td><span>Bling Libra</span></td>\n<td><span>ShinyHunters</span></td>\n<td><span>2019</span></td>\n<td><span>持续存在</span></td>\n<td><span>NiceNIC + Cloudflare；</span><span><br>\n</span><span>以报告和索赔为主题的域名</span></td>\n</tr>\n<tr>\n<td><span>CL-CRI-1116</span></td>\n<td><span>Redact（原 BlackFile）</span></td>\n<td><span>2026 年 1 月</span></td>\n<td><span>多个</span></td>\n<td><span>NiceNIC</span><span> + Cloudflare</span></td>\n</tr>\n<tr>\n<td><span>CL-CRI-1147</span></td>\n<td><span>Pink</span></td>\n<td><span>2026 年 5 月</span></td>\n<td><span>多个</span></td>\n<td><span>NiceNIC</span><span> + Cloudflare</span></td>\n</tr>\n<tr>\n<td><span>CL-CRI-1182</span></td>\n<td><span>Falcon</span></td>\n<td><span>2026 年中</span></td>\n<td><span>持续</span></td>\n<td><span>NiceNIC</span><span> + Cloudflare</span></td>\n</tr>\n<tr>\n<td><span>CL-CRI-1192</span></td>\n<td><span>Helix</span></td>\n<td><span>2026年6月</span></td>\n<td><span>多个</span></td>\n<td><span>NiceNIC</span><span> + Cloudflare</span></td>\n</tr>\n<tr>\n<td><span>CL-CRI-1264</span></td>\n<td><span>Vortex</span></td>\n<td><span>2026年9月</span></td>\n<td><span>持续</span></td>\n<td><span>Cnobin + Cloudflare</span></td>\n</tr>\n<tr>\n<td><span>CL-CRI-1274</span></td>\n<td><span>Cinder</span></td>\n<td><span>2026年9月</span></td>\n<td><span>持续</span></td>\n<td><span>Internet Domain Service BS Corp + DDoS-Guard</span></td>\n</tr>\n</tbody>\n</table><p><span>表 1. Com 关联命名行为体与活动集群的区分。</span></p><h2 id=\"sec-3\">最新洞察</h2><h3 id=\"sec-4\">新兴活动集群 CL-CRI-1264（Vortex）</h3><p>2026年9月，我们发现了一个新的活动集群，并将其追踪为 CL-CRI-1264。攻击者采用的手法大体遵循 Com 关联威胁行为体使用的更广泛行动手册，但其中若干特征使其与众不同。最显著的是，我们观察到该活动主要针对医疗保健、制药及其他医疗组织。</p><p>与 CL-CRI-1264 关联的攻击者通过电话钓鱼建立初始访问，他们冒充内部 IT 支持人员，并将员工引导至使用为每个目标组织定制的子域的服务器。这些服务器充当中间人（AiTM）代理，实时将用户凭据和多因素认证（MFA）批准传递给攻击者。攻击者已将其目标锁定在员工的企业工作站和个人移动设备上。</p><p>我们观察到 CL-CRI-1264 背后的攻击者在进行身份验证后的数分钟内注册未经授权的 MFA 设备，以建立持久化。在多次事件中，攻击者在多个已入侵账户之间重复使用一个名为 <span>Pixel 10a</span> 的单一设备。他们还使用 Python 脚本（<span>python-httpx</span> User Agent）自动进行数据外泄，以针对 Microsoft 365 邮箱、OneDrive 和 SharePoint 内容。</p><p>数据外泄后，攻击者直接向受害者组织的员工发送 Microsoft Teams 消息，声称已窃取数据，并将收件人引导至一个托管于 Tor 的谈判网站。</p><h3 id=\"sec-5\">新兴活动集群 CL-CRI-1274（Cinder）</h3><p>2026年9月，我们发现了另一个新的活动集群，并将其追踪为 CL-CRI-1274。与本报告中详述的其他活动类似，攻击者利用电话钓鱼取得初始访问，并通过重放持久的“保持登录状态”会话令牌，避免系统再次提示进行 Duo MFA。随后，他们从代理基础设施重放同一会话令牌。</p><p>从那里，他们使用通过 python-requests（<span>python-requests/2.34.2</span>）编写的脚本，以及 Microsoft Graph 软件开发工具包（SDK），从受害者的 SharePoint 和 OneDrive 环境中收集并外泄数据。之后，攻击者使用已入侵账户通过电子邮件和 Microsoft Teams 在内部发送勒索消息，最终将收件人引导至一个托管于 Tor 的谈判网站。</p><h3 id=\"sec-6\">恶意浏览器扩展</h3><p>在一次归因于另一活动集群 CL-CRI-1192 的调查中（Google 将其追踪为 UNC6671），我们发现了一个名为 Google Chrome 的<a href=\"https://www.virustotal.com/gui/file/ea8d30c42e758559e78bd1fe97f8849011beb7f24c7f092a066a5a62fa7fbe6f\">恶意浏览器扩展</a>（清单版本 1.6.111）。</p><p>该扩展程序未在 Chrome Web Store 上架。它从攻击者控制的服务器 <span>oskeysetup[.]com</span> 下载，并要求受害者使用开发者模式手动侧载。将扩展程序命名为 <span>Google Chrome</span> 有助于伪装浏览器内置的警告横幅（<span>Google Chrome started debugging this browser</span>），该横幅会在扩展程序处于活动状态时显示。</p><p>该域名的注册信息与 <a href=\"https://cloud.google.com/blog/topics/threat-intelligence/unc6671-targets-financial-services-and-enterprise-cloud-environments\">Google</a> 和 <a href=\"https://reliaquest.com/blog/threat-spotlight-helix-new-name-in-data-extortion-ecosystem/\">ReliaQuest</a> 此前披露的、与我们追踪为 CL-CRI-1192 的活动相关的攻击者基础设施高度相似。</p><p>此浏览器扩展程序会执行多项恶意操作：</p><ul>\n<li>安装全局键盘记录器</li>\n<li>窃取所有站点的本地/会话存储以及 <span>IndexedDB</span> 数据</li>\n<li>收集身份验证 Cookie（针对 Microsoft 和 Google 账户）</li>\n<li>扫描页面中的二维码以获取登录/MFA 令牌</li>\n<li>传输摄像头视频流</li>\n</ul><p>此外，此浏览器扩展程序通过 Chrome DevTools Protocol（<span>chrome.debugger</span>）实现了一个完整的命令与控制（C2）远程控制模块。它允许操作员执行以下活动：</p><ul>\n<li>截取隐藏屏幕截图</li>\n<li>调度输入事件</li>\n<li>窃取剪贴板内容</li>\n<li>允许远程进行网站导航</li>\n</ul><p>我们以该文件为 pivoted 切入点，识别出<a href=\"https://www.virustotal.com/gui/file/930898e8b65e9cf4e2595ac4092042a707cca8922751e723ad8b86260655154a\">另一个浏览器扩展程序</a>，它同样伪装成 Google Chrome（版本 1.6.112），并与同一个 C2 服务器通信。这两个文件共享同一个硬编码 API 密钥。</p><p>我们以中等置信度评估，与 CL-CRI-1192 相关的攻击者开发了这一恶意浏览器扩展程序，作为从运行基于 Chromium 的浏览器（如 Google Chrome 和 Microsoft Edge）的台式机和笔记本电脑提取凭据的另一种方法。该扩展程序也可能与其他与 Com 有关联的攻击者共享和使用，尽管我们目前没有证据表明存在这种情况。</p><p>我们认可 Kevin Pham 对此浏览器扩展程序的深入调查，详见其<a href=\"https://deoxy.net/blog/inside-unc6671s-browser-implant/\">2026 年 9 月的文章</a>。</p><h2 id=\"sec-7\">受害者特征</h2><p>我们的遥测数据显示，与 Com 有关联的攻击组织正在持续开展活动，并在 2026 年 8 月前后显著加速。受害者具有一个共同特征：它们掌握大量高影响力的企业数据，一旦泄露将造成严重的监管、法律或市场后果。金融服务、医疗保健和法律机构是主要目标，但相关活动也遍及其他行业。</p><p>攻击者并非针对普通邮箱，而是系统性地寻找负责高价值文件、文档和数据库的个人或系统。这些攻击聚焦于：</p><ul>\n<li><strong>法律和企业战略： </strong>攻击者针对合作伙伴通信、公司战略、高管薪酬和待签合同。他们明确威胁要公布客户协议和机密案件材料。</li>\n<li><strong>金融和投资记录： </strong>攻击者优先窃取私人投资组合、交易管线以及大规模云数据仓库。他们偶尔会外泄数千万条客户关系管理（CRM）和招聘记录。</li>\n<li><strong>医疗保健和生命科学： </strong>攻击者针对包含患者记录和专有研究数据的云数据平台。为最大限度施加压力，攻击者在内部聊天频道中广播勒索通知，并威胁向监管机构报告。</li>\n</ul><p>遭定向攻击最多的组织具有分布式员工队伍、集中式单点登录（SSO）以及广泛的云协作平台。它们也主要位于英语国家。我们观察到攻击者反复针对同一组织，有时在尝试失败数周后再次返回。</p><h3 id=\"sec-8\">谁在遭受攻击：行业与国家</h3><p>我们对与 Com 相关活动所关联域名的监测显示，其攻击目标在 2026 年 9 月初从金融服务业转向医疗保健业。图 1 显示，2026 年 8 月，这些攻击者针对金融服务组织的频率约为针对医疗保健组织的两倍，但到了 9 月，医疗保健业的受攻击次数超过了金融服务业，时间大致与我们首次观察到 CL-CRI-1264 活动时相同。2026 年 10 月，医疗保健业继续保持受攻击最多的行业地位，金融服务业亦紧随其后。攻击者也频繁针对建筑业、高科技以及运输与物流组织。</p><figure><img src=\"/dailyinfo/media/db533fa1af32b755.webp\" srcset=\"/dailyinfo/media/63623fe27d1c19cb.webp 720w, /dailyinfo/media/146e0dabcde9fbc0.webp 1200w, /dailyinfo/media/db533fa1af32b755.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Line chart showing the number of cyberattacks on various industries over time. Industries include Healthcare, Financial Services, Construction, High Technology, Transportation &amp; Logistics, Professional &amp; Legal Services, Manufacturing, Pharma &amp; Life Sciences, Insurance, Real Estate. Lines fluctuate with spikes visible around early to mid-September. The horizontal axis represents dates, and the vertical axis shows the number of cyberattacks.\" width=\"1000\" height=\"556\"><figcaption>图 1. 2026 年 8 月至 10 月期间，在子域名中受攻击组织的所属行业。</figcaption></figure><p>图 2 显示，2026 年 8 月至 10 月期间，大多数受攻击组织位于美国。然而，自 2026 年 9 月下旬起，我们观察到针对澳大利亚组织的攻击有所增加。澳大利亚组织在 8 月和 9 月占已观察子域名的比例不足 1%，到 10 月升至约 13%。目前，澳大利亚组织是受攻击次数第二多的组织所在国家。</p><figure><img src=\"/dailyinfo/media/165f032e810f4498.webp\" srcset=\"/dailyinfo/media/51c44d2581595e89.webp 720w, /dailyinfo/media/56f4b386f874be81.webp 1200w, /dailyinfo/media/165f032e810f4498.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Bar chart titled &quot;Top Targeted Geographies by Percentage Share (Aug - Oct 2026)&quot; with data for three months: August, September, October. Each bar is divided by country. United States leads with 95.3% in August, 91.9% in September, and 76.2% in October. Other countries include Australia, United Kingdom, Canada, Switzerland, and an &quot;Other&quot; category. Australia's share increases to 13.0% in October.\" width=\"1000\" height=\"650\"><figcaption>图 2. 2026 年 8 月至 10 月期间，在子域名中受攻击组织的所属国家。</figcaption></figure><h2 id=\"sec-9\">战术、技术与程序</h2><h3 id=\"sec-10\">基础设施与工具</h3><p>Com 关联威胁行为者的一个关键特征，是使用伪装成 SSO 门户、IT 支持页面和通行密钥配置服务的顶级域名。这些域名通常托管短生命周期的子域名，冒充目标组织，例如 <span>{company}.mfaregister[.]com</span>。我们积极追踪此类基础设施，对已识别域名开展威胁狩猎，并通过我们的 <a href=\"https://github.com/PaloAltoNetworks/Unit42-timely-threat-intel/tree/main\">GitHub 仓库</a>以 Timely Threat Intelligence（TTI）的形式发布关键发现。</p><p>在多起 Com 关联案件中，我们发现了托管基础设施、攻击链和受害者特征方面的相似之处。在某些案件中，这些行为者还会共享工具，例如 Doko's Panel，这是一个由操作者控制的 AiTM 网络钓鱼工具包。</p><p>正如 <a href=\"https://pushsecurity.com/blog/inside-criminal-phishing-panel\">Push Security</a>此前报告的，该工具包的一些针对 Okta 的变体会将面板默认的 <span>backend.php</span> 处理程序替换为重命名后的端点 <span>api_FyekIDWY.php</span>。我们在多个与 Com 关联案件有关的域名上观察到了此端点。</p><p>至少在一起金融服务业案件中，遥测数据记录了从输入凭据到出现 MFA 编号匹配提示的完整 AiTM 序列，表明攻击者很可能成功完成了会话捕获，如图 3 所示。</p><figure><img src=\"/dailyinfo/media/9b9b6904ece87269.webp\" srcset=\"/dailyinfo/media/8c943ac93dc36f0b.webp 720w, /dailyinfo/media/9008bebfdec59846.webp 1200w, /dailyinfo/media/9b9b6904ece87269.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Diagram showing credential and MFA capture process. It involves three entities: Victim, Adversary-in-the-middle proxy, and Operator. The sequences include steps like landing page lure, phishing kit activation, username submission, password submission, and MFA challenges. Final step shows authenticated session relayed to the operator. The process uses Cloudflare-fronted phishing kit and mentions Evilginx2 kit and Dokis Panel as components.\" width=\"780\" height=\"664\"><figcaption>图 3. 描述一次已观察攻击的流程图。</figcaption></figure><p>在使用不同技术针对受害者的攻击活动中，我们也观察到与 Com 关联基础设施一致的域名。例如，<a href=\"https://www.microsoft.com/en-us/security/blog/2026/09/09/passkey-themed-social-engineering-leads-identity-cloud-compromise/\">Microsoft</a> 在其针对以通行密钥为主题的社会工程学研究中报告了 <span>oskeyregister[.]com</span>。</p><p>在此报告的基础上，我们发现了符合以下模式的 Cloudflare Pages URL：<span>connect-pages-{company}.pages[.]dev</span>，这些 URL 会重定向到特定于公司的子域，例如 <span>{company}.oskeyregister[.]com</span>。这些发现反映了更广泛的 Com 生态系统，该生态系统由若干活动集群组成；这些集群经常共享基础设施，但其技术手法可能略有差异。</p><p>除共享基础设施外，与 Com 关联威胁行为者所使用的工具在注册和部署方面反复出现的模式，也提供了识别相关域名的额外机会。表 2 展示了此类活动中观察到的常见注册模式。</p><table>\n<tbody>\n<tr>\n<td><b>类别</b></td>\n<td><b>值</b></td>\n<td><b>示例</b></td>\n</tr>\n<tr>\n<td><span>目标顶级域名 (TLD)</span></td>\n<td><span>.com</span><span>、</span><span>.claims</span><span>、</span><span>.report</span></td>\n<td><span>{company}.claims</span>\n<p><span>{company}.report</span></p></td>\n</tr>\n<tr>\n<td><span>结构化和连字符格式</span></td>\n<td><span>claims-</span><span>、</span><span>report-</span><span>、</span><span>-claims</span><span>、</span><span>-report</span><span>、</span><span>-okta</span><span> 或 </span><span>okta-</span></td>\n<td><span>{company}-report.com</span>\n<p><span>claims-{company}.com&nbsp;</span></p>\n<p><span>{company}-okta.com</span></p></td>\n</tr>\n<tr>\n<td><span>身份验证和访问关键词</span></td>\n<td><span><span>sso</span>、<span>mfa</span>、<span>2fa</span>、<span>okta</span>、<span>auth</span>、<span>signin</span>、<span>passkey</span>、<span>token</span>、<span>key</span>、<span>oskey</span>、</span> <span>secure</span></td>\n<td><span>settingsportal[.]com</span>\n<p><span>ssosettings[.]com</span></p>\n<p><span>mfapasskeysetup[.]com</span></p></td>\n</tr>\n<tr>\n<td><span>系统和账户操作关键词</span></td>\n<td><span><span>enroll</span>、<span>activate</span>、<span>setup</span>、<span>create</span>、<span>enable</span>、<span>start</span>、<span>add</span>、<span>install</span>、<span>manage</span>、<span>connect</span><span>、</span><span>assign</span></span></td>\n<td><span>authenroll[.]com</span>\n<p><span>installpasskey[.]com</span></p></td>\n</tr>\n<tr>\n<td><span>内部和支持基础设施关键词</span></td>\n<td><span><span>it</span>、<span>support</span>、<span>helpdesk</span>、<span>portal</span>、<span>internal</span>、<span>apps</span>、<span>options</span>、<span>help</span>、<span>my</span></span><span>、</span><span>account</span></td>\n<td><span>myaccountoptions[.]com</span>\n<p><span>itkeyportal[.]com</span></p></td>\n</tr>\n<tr>\n<td><span>重定向诱饵</span></td>\n<td><span>通过 Cloudflare Pages 进行重定向</span></td>\n<td><span>connect-pages-{company}.pages.dev</span></td>\n</tr>\n<tr>\n<td><span>注册商</span></td>\n<td colspan=\"2\"><span>NiceNIC International Group Co., Limited</span><span><br>\n</span><span>Cnobin Information Technology Limited</span><span><br>\n</span><span>Tucows Domains Inc.</span><span>Dominet (HK) Limited</span></td>\n</tr>\n<tr>\n<td><span>名称服务器</span></td>\n<td colspan=\"2\"><span>Cloudflare Inc.</span></td>\n</tr>\n</tbody>\n</table><p><span>表 2。Com 关联威胁行为者使用的基础设施注册模式。</span></p><h3 id=\"sec-11\"><strong>攻击者行动手册</strong></h3><p>我们没有观察到 Com 关联威胁行为者采用标准行动手册。威胁行为者没有使用定制工具，而是主要利用原生云实用工具，并选择性地限制执行操作和持久化部署。</p><p>入侵通常以 vishing 开始，威胁行为者冒充 IT 人员解决身份验证问题，并将受害者引导到一个针对其所属机构定制的钓鱼页面。在 AiTM 工具包窃取凭据和会话令牌后，攻击者会迅速注册自己的 MFA 设备、滥用云实用工具，并在某些情况下部署恶意浏览器扩展，以窃取数据和勒索受害者。</p><p>利用已收集的认证数据，Com 关联威胁行为者会对受害者环境进行身份验证，通常通过住宅代理网络和商业 VPN 进行路由。随后，他们试图建立多层次持久化，枚举敏感数据并从云平台窃取数据。我们观察到 Com 关联威胁行为者采用了以下技术：</p><p><strong>持久化</strong></p><ul>\n<li>注册未经授权的 MFA 设备和工作站对象</li>\n<li>生成云基础设施临时凭据</li>\n<li>授权未经批准的第三方 OAuth 应用程序或数据同步实用工具</li>\n<li>准备备用账户或收集冗余凭据</li>\n</ul><p><strong>发现与防御规避</strong></p><ul>\n<li>监控身份验证、权限和邮箱</li>\n<li>修改日历设置和邮箱规则</li>\n<li>清除安全警报事件</li>\n<li>轮换基础设施</li>\n</ul><p><strong>数据外泄</strong></p><ul>\n<li>使用 Rclone 等开源工具和云存储平台</li>\n<li>通过原生 SaaS 和 REST API 或基于 HTTP 的脚本化外泄方式窃取数据</li>\n<li>通过 SaaS 到 SaaS 传输移动数据</li>\n</ul><h2 id=\"sec-12\">结论</h2><p>今年早些时候，我们的<a href=\"https://www.paloaltonetworks.com/resources/research/unit-42-incident-response-report\">2026 Unit 42 全球事件响应报告</a>发现，2025 年未使用加密的勒索事件（占比 78%）多年来首次降至 90%区间以下。这一趋势持续到了 2026 年，我们预计不会放缓。Bling Libra 和其他 Com 关联威胁行为者等网络犯罪分子正在放弃加密，从而能够更快地推进其入侵生命周期，同时仍能实现目标。</p><p>转向不使用加密的另一个合理动机，是在执法部门近年来加大对勒索软件运营者打击的情况下避开他们的视线。然而，转向不使用加密似乎已不足以让他们避开视线。这一判断基于对涉嫌 Bling Libra 成员（如“<a href=\"https://www.reuters.com/world/middle-east/key-shinyhunters-hacker-detained-jordan-is-cooperating-sources-say-2026-10-03/\">Rey</a>”和“<a href=\"https://krebsonsecurity.com/2026/09/dutch-police-arrest-reformed-hacker-in-shiny-hunters-investigation/\">Umbreon</a>”）的逮捕报道，这些逮捕发生在该组织声称入侵 <a href=\"https://x.com/FBI/status/2102807819695071709\">FBI</a>事件前后。</p><p>近期的逮捕还包括一名<a href=\"https://krebsonsecurity.com/2026/10/feds-suspect-ransom-negotiator-ran-shinyhunters-extortion-site/\">据称运营 Bling Libra 勒索站点的人</a>。</p><p>展望未来，各组织必须：</p><ul>\n<li>收紧帮助台验证流程</li>\n<li>转向具备抗钓鱼能力的 MFA（FIDO2/通行密钥）</li>\n<li>实施浏览器扩展允许列表</li>\n<li>建立对身份相关操作的可见性</li>\n<li>对未经授权的数据导出发出警报，以缓解本文所述的威胁活动</li>\n</ul><p>Palo Alto Networks 客户可通过以下产品获得更充分的保护，抵御上述威胁：</p><ul>\n<li><a href=\"https://docs.paloaltonetworks.com/wildfire\">Advanced WildFire</a>的机器学习模型和分析技术已根据本研究共享的威胁指标进行了审查和更新。</li>\n<li><a href=\"https://docs.paloaltonetworks.com/advanced-url-filtering\">Advanced URL Filtering</a>、<a href=\"https://docs.paloaltonetworks.com/dns-security\">Advanced DNS Security</a>和<a href=\"https://www.paloaltonetworks.com/network-security/advanced-ip-defense\">Advanced IP Defense</a>会将与此类活动相关的已知域名和 URL 识别为恶意。</li>\n<li><a href=\"https://www.paloaltonetworks.com/cortex/cortex-xdr\">Cortex XDR</a> 与 <a href=\"https://www.paloaltonetworks.com/resources/datasheets/cortex-xsiam-aag\">XSIAM</a> 采用多层防护方法进行设计，可帮助防御本文所述的威胁，覆盖整个攻击生命周期。通过结合<a href=\"https://www.paloaltonetworks.com/products/secure-the-network/subscriptions/threat-prevention\">行为威胁防护</a>、<a href=\"https://docs.paloaltonetworks.com/wildfire\">Advanced WildFire</a> 和 <a href=\"https://docs-cortex.paloaltonetworks.com/r/Cortex-XDR/Cortex-XDR-3.x-Documentation/Endpoint-protection-capabilities\">凭据收集防护</a> 等高级能力，这些平台能够在威胁攻击者达成其目标之前检测并阻止恶意行为——包括凭据窃取、未经授权的持久化以及基于脚本的执行。</li>\n<li><a href=\"https://www.koi.ai/product/endpoint\">Cortex Agentic Endpoint Security</a> 的设计目标是帮助发现整个智能体端点上的每一项 AI 制品和 AI 智能体的活动，评估其风险，强制实施预防与运行时控制，并修复违规行为。</li>\n<li><a href=\"https://docs.paloaltonetworks.com/prisma-access-browser\">Prisma Browser </a>旨在防止类似我们研究中揭示的那类基于扩展的攻击。</li>\n<li><a href=\"https://docs.paloaltonetworks.com/iot/getting-started/iot-security-solution\">Device Security</a> 旨在主动保护运营环境中专业化的设备攻击面，为工业协议提供深度可见性，为所有 OT 与 IoT 资产提供可执行的风险洞察和自适应安全防护。</li>\n<li><a href=\"https://www.paloaltonetworks.com/idira/human/identity-and-access-management\">Idira Identity and Access Management (IAM)</a> 可帮助为人类、机器和 AI 身份实现安全统一的访问，在细粒度控制与无缝用户体验之间取得平衡。凭借 SSO、抗钓鱼 MFA、无密码登录和企业密码管理，Idira IAM 将智能权限控制与会话安全扩展至更广泛的员工群体。</li>\n<li><a href=\"https://docs.cyberark.com/detect-and-respond/latest/en/content/get-started/what-is-detect-and-respond.htm\">Idira Identity Threat Detection and Response (ITDR) </a>可帮助安全团队应对针对 Idira Next Generation Identity (NGI) Platform 及其所保护身份的身份攻击。利用由 CORA AI 驱动的近实时检测，并结合 Idira 在多个上下文中的可见性（如 PAM、身份验证、SSO、云、端点、浏览器等），Idira ITP 能够实施自动化、定制化且不打断会话的响应，以遏制并尽量减少潜在的基于身份的威胁。</li>\n<li><a href=\"https://docs.cyberark.com/manage/latest/en/content/sws/getstarted/sws-introduction-2.htm\">Idira Secure Web Sessions (SWS)</a> 旨在为高度敏感的 SaaS 应用会话提供客户端侧防护（阻止剪贴板/下载）以及分步审计日志。</li>\n</ul><p>组织可通过 <a href=\"https://www.paloaltonetworks.com/unit42/threat-intelligence\">Unit 42 Threat Intel Services</a> 及其 <a href=\"https://www.paloaltonetworks.com/resources/datasheets/unit-42-deep-and-dark-web-service\">Deep and Dark Web Service</a> 获取定制的对手情报、分析师直接咨询以及专门的暴露面追踪。</p><p>如果您认为自己可能已被攻陷，或有紧急事项，请联系 <a href=\"https://start.paloaltonetworks.com/contact-unit42.html\">Unit 42 事件响应团队</a> 或致电：</p><ul>\n<li>North America: Toll Free: +1 (866) 486-4842 (866.4.UNIT42)</li>\n<li>UK: +44.20.3743.3660</li>\n<li>Europe and Middle East: +31.20.299.3130</li>\n<li>Asia: +65.6983.8730</li>\n<li>Japan: +81.50.1790.0200</li>\n<li>Australia: +61.2.4062.7950</li>\n<li>India: 000 800 050 45107</li>\n<li>South Korea: +82.080.467.8774</li>\n</ul><p>Palo Alto Networks 已将这些发现与我们的 fellow Cyber Threat Alliance (CTA) 成员分享。CTA 成员利用这些情报迅速为其客户部署防护措施，并系统性地挫败恶意网络攻击者。进一步了解 <a href=\"https://www.cyberthreatalliance.org/\">Cyber Threat Alliance</a>。</p><h2 id=\"sec-13\">失陷指标</h2><h3 id=\"sec-14\">SHA-256 哈希</h3><ul>\n<li><span>930898e8b65e9cf4e2595ac4092042a707cca8922751e723ad8b86260655154a</span> (<span>folderextension.crx</span>)</li>\n<li><span>ea8d30c42e758559e78bd1fe97f8849011beb7f24c7f092a066a5a62fa7fbe6f</span> (<span>folderextension.zip</span>)</li>\n</ul><h3 id=\"sec-15\">URL</h3><ul>\n<li><span>hxxps[:]//oskeysetup[.]com/files/folderextension.crx</span>（托管 <span>930898e8b65e9cf4e2595ac4092042a707cca8922751e723ad8b86260655154a</span>）</li>\n<li><span>hxxps[:]//oskeysetup[.]com/files/folderextension.zip</span>（托管 <span>ea8d30c42e758559e78bd1fe97f8849011beb7f24c7f092a066a5a62fa7fbe6f</span>）</li>\n</ul><h3 id=\"sec-16\">IP 地址</h3><ul>\n<li><span>31.42.184[.]213</span>（托管 <span>oskeysetup[.]com</span>）</li>\n<li><span>193.149.176[.]62</span>（访问了已失陷账户）</li>\n</ul><h3 id=\"sec-17\">完全限定域名（FQDN）</h3><ul>\n<li><span>add-mfa[.]com</span></li>\n<li><span>login-options[.]com</span></li>\n<li><span>apply-passkey[.]com</span></li>\n<li><span>auth-sso[.]com</span></li>\n<li><span>authenroll[.]com</span></li>\n<li><span>configkeys[.]com</span></li>\n<li><span>configurekey[.]com</span></li>\n<li><span>editmysso[.]com</span></li>\n<li><span>enableoskey[.]com</span></li>\n<li><span>enrollmfa[.]com</span></li>\n<li><span>enrollmfamethods[.]com</span></li>\n<li><span>enrollssopasskey[.]com</span></li>\n<li><span>fastpasskeys[.]com</span></li>\n<li><span>hostsso[.]com</span></li>\n<li><span>installpasskey[.]com</span></li>\n<li><span>installsso[.]com</span></li>\n<li><span>itkeyenroll[.]com</span></li>\n<li><span>itkeyportal[.]com</span></li>\n<li><span>itkeyupdate[.]com</span></li>\n<li><span>keyconfiguration[.]com</span></li>\n<li><span>keyenrollos[.]com</span></li>\n<li><span>keyosregister[.]com</span></li>\n<li><span>mfa-options[.]com</span></li>\n<li><span>mfa-passkey[.]com</span></li>\n<li><span>mfa-registry[.]com</span></li>\n<li><span>mfaoptions[.]com</span></li>\n<li><span>mfapasskeysetup[.]com</span></li>\n<li><span>mfaregister[.]com</span></li>\n<li><span>mfasettings[.]com</span></li>\n<li><span>my-passkey[.]com</span></li>\n<li><span>my-passkeys[.]com</span></li>\n<li><span>myaccountapps[.]com</span></li>\n<li><span>myaccountoptions[.]com</span></li>\n<li><span>myapps2fa[.]com</span></li>\n<li><span>mypasskeyapp[.]com</span></li>\n<li><span>myssoapps[.]com</span></li>\n<li><span>myssoauth[.]com</span></li>\n<li><span>myssosettings[.]com</span></li>\n<li><span>new-passkey[.]com</span></li>\n<li><span>nowsso[.]com</span></li>\n<li><span>onboardpasskey[.]com</span></li>\n<li><span>oskeysetup[.]com</span></li>\n<li><span>oursso[.]com</span></li>\n<li><span>passkey-mfa[.]com</span></li>\n<li><span>passkeyconnect[.]com</span></li>\n<li><span>register-mfa[.]com</span></li>\n<li><span>register-passkeys[.]com</span></li>\n<li><span>registermymfa[.]com</span></li>\n<li><span>registersso[.]com</span></li>\n<li><span>settingsportal[.]com</span></li>\n<li><span>signinoptions[.]com</span></li>\n<li><span>ssokeyportal[.]com</span></li>\n<li><span>ssosettings[.]com</span></li>\n<li><span>startmypasskey[.]com</span></li>\n<li><span>configuresso[.]com</span></li>\n<li><span>makepasskey[.]com</span></li>\n</ul><h3 id=\"sec-18\">MFA 设备名称</h3><p>在多项调查中观察到（标准手机型号，并非独立的失陷指标）</p><ul>\n<li>Pixel 10a</li>\n<li>Pixel 9 Pro XL</li>\n</ul><h3 id=\"sec-19\">User-Agent 字符串</h3><ul>\n<li><span>kiota-dotnet/1.17.1</span></li>\n<li><span>Microsoft.Graph.Client/6.2.0</span></li>\n<li><span>python-requests/2.34.2</span></li>\n</ul><h2 id=\"sec-20\">其他资源</h2><ul>\n<li><a href=\"https://deoxy.net/blog/inside-unc6671s-browser-implant/\">深入了解 UNC6671 的浏览器植入程序</a> - Deoxy</li>\n<li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/09/09/passkey-themed-social-engineering-leads-identity-cloud-compromise/\">以通行密钥为主题的社会工程攻击导致身份和云环境失陷</a> - Microsoft</li>\n<li><a href=\"https://health-isac.org/urgent-threat-alert-shinyhunters-vishing-campaigns-and-domain-impersonation/\">紧急威胁警报：ShinyHunters 的语音钓鱼活动与域名仿冒</a> - Health-ISAC</li>\n<li><a href=\"https://reliaquest.com/blog/threat-spotlight-social-engineering-attempt-against-reliaquest-what-we-found/\">针对 ReliaQuest 的一次社会工程攻击：我们的发现</a> - ReliaQuest</li>\n<li><a href=\"https://cloud.google.com/blog/topics/threat-intelligence/unc6671-targets-financial-services-and-enterprise-cloud-environments\">UNC6671 更名：多品牌语音钓鱼勒索针对金融服务和企业云环境</a> - Google</li>\n<li><a href=\"https://www.okta.com/blog/threat-intelligence/behind-the-scenes-of-a-vishing-operation/\">语音钓鱼行动的幕后</a> - Okta</li>\n<li><a href=\"https://reliaquest.com/blog/threat-spotlight-helix-new-name-in-data-extortion-ecosystem/\">Helix：数据勒索生态中的新名称？</a> - ReliaQuest</li>\n<li><a href=\"https://www.okta.com/blog/threat-intelligence/vishing-actors-target-microsoft-entra-passkey-enrollment-/\">语音钓鱼攻击者以 Entra 通行密钥注册为目标</a> - Okta</li>\n<li><a href=\"https://unit42.paloaltonetworks.com/cyber-extortion-economy/\">走出加密牢笼：不断演变的网络勒索经济</a> - Unit 42, Palo Alto Networks</li>\n<li><a href=\"https://cloud.google.com/blog/topics/threat-intelligence/blackfile-vishing-extortion-operation/\">欢迎来到 BlackFile：语音钓鱼勒索行动内幕</a> - Google</li>\n<li><a href=\"https://pushsecurity.com/blog/inside-criminal-phishing-panel\">我们渗透了一个犯罪钓鱼面板：以下是我们的发现</a> - Push Security</li>\n<li><a href=\"https://rhisac.org/threat-intelligence/extortion-in-the-enterprise-defending-against-blackfile-attacks/\">企业勒索：防御 BlackFile 攻击</a>- RH-ISAC</li>\n<li><a href=\"https://cloud.google.com/blog/topics/threat-intelligence/expansion-shinyhunters-saas-data-theft\">以虚假身份入侵账户：追踪利用 ShinyHunters 品牌实施的 SaaS 数据窃取活动的扩张</a> - Google</li>\n</ul>","original","zhKind","translation","complete","钓鱼","数据泄露","勒索","Palo Alto","Google","Microsoft","https://unit42.paloaltonetworks.com/com-affiliate-vishing-attacks/",{"_157":158,"_159":-5},"changelogVersion","2026-10-01T08:00","release"]
