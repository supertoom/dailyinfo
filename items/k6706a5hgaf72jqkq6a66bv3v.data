[{"_1":2,"_3":4},"root",{"_5":147},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1795048832000,"id","k6706a5hgaf72jqkq6a66bv3v","title","Elastic 披露 Java4Shell 远程代码执行漏洞 CVE-2026-114938 的影响与缓解措施","originalTitle","Java4Shell Remote Code Execution (RCE) Vulnerability - CVE-2026-114938","summary","Elastic 确认 CVE-2026-114938 影响 OpenJDK 和 Oracle Java SE，并波及 Elasticsearch 7.17.3 及以上版本与 Logstash 8.6.2 及以上版本。","reason","source",{"_75":146},"links",{"_133":145},"publishedAt","2026-11-18T00:00:00.000Z","discoveredAt","2026-11-18T23:50:37.311Z","timelineAt","category","vuln","tags",[139,140,141,79,142,143,144],"score",70,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","sameEvent",{"_11":137,"_13":138},"readingMode","full","author","Product Security Team","body",{"_62":132,"_133":-5,"_134":135,"_136":36},"outline",[86,87,88,89,90,91,92,93,94,95,96,97,98,99],"relatedStories",[82],"topics",[69,70,71,72],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","fd55XLZ5t838","reportCount",5,"additionalSourceCount",4,{"_73":80,"_75":81},{"_73":78,"_75":79},{"_73":30,"_75":77},{"_73":74,"_75":76},"slug","blue-team","name","蓝队与运营","漏洞披露","vuln-mgmt","漏洞管理","oracle","Oracle / 甲骨文",{"_83":84,"_13":85},"publicId","8540cb70-bd3c-4700-8134-83f02bb49280","Java4Shell已修复，Red Hat补丁仍缺",{"_11":130,"_101":131,"_103":104},{"_11":128,"_101":129,"_103":107},{"_11":126,"_101":127,"_103":107},{"_11":124,"_101":125,"_103":107},{"_11":122,"_101":123,"_103":107},{"_11":120,"_101":121,"_103":104},{"_11":118,"_101":119,"_103":107},{"_11":116,"_101":117,"_103":68},{"_11":114,"_101":115,"_103":68},{"_11":112,"_101":113,"_103":107},{"_11":110,"_101":111,"_103":107},{"_11":108,"_101":109,"_103":107},{"_11":105,"_101":106,"_103":107},{"_11":100,"_101":102,"_103":104},"sec-14","text","有问题吗？","level",2,"sec-13","自托管 Logstash 客户的缓解措施",3,"sec-12","ECK 上的 Logstash","sec-11","Elastic Cloud on Kubernetes (ECK) 客户的缓解措施","sec-10","自管 Elastic Cloud Enterprise (ECE) 客户的缓解措施","sec-9","缓解方案 2","sec-8","缓解方案 1","sec-7","自管 Elasticsearch 客户的缓解措施","sec-6","客户缓解建议","sec-5","Elastic Cloud Hosted","sec-4","Elastic Cloud Serverless","sec-3","Logstash","sec-2","Elasticsearch","sec-1","受影响组件","<p><img src=\"/dailyinfo/media/702f03126b4bcb9d.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\"></p><p><span>Elastic 已知晓一个影响 OpenJDK 和 Oracle Java SE 的远程代码执行漏洞（CVE-2026-114938，又称 Java4Shell），该漏洞于 2026 年 11 月 17 日披露。&nbsp;</span></p><p><span>Elastic 将持续关注新出现的信息，并会在适用且信息可得时发布更多详情。</span></p><h2 id=\"sec-1\">受影响组件</h2><h3 id=\"sec-2\">Elasticsearch</h3><p><span>Elastic 已确认 Elasticsearch 7.17.3 及更高版本受此 CVE 影响，但存在一些缓解因素。该漏洞只能由至少拥有“读取”权限的已认证用户在受影响的 CPU 架构上利用，以实现远程代码执行（RCE）；未认证攻击者则可对 Elasticsearch 节点发起拒绝服务（DoS）攻击。&nbsp;</span></p><p><span>Elastic 还在准备通过将捆绑的 JDK 更新至 27.0.1.1+4 来修复此漏洞。预计该修复将随即将推出的 Elastic 8.19.26、9.4.10、9.5.7 和 9.6.0 版本发布。</span></p><h3 id=\"sec-3\">Logstash</h3><p><span>Elastic 已确认 Logstash 8.6.2 及更高版本受此 CVE 影响。Logstash 7.17.x 以及 8.6.2 之前的版本目前不受影响。Logstash API、Ruby 插件和常见输入（如 Beats、HTTP 和 TCP）均不使用受影响的 Java 函数。&nbsp;</span></p><p><span>在受影响的 CPU 架构上，该漏洞只能通过 Elastic Integration 过滤器（</span><span>logstash-filter-elastic_integration</span><span>）</span><span><strong>并且</strong></span><span>在 Elasticsearch 摄取管道对来自不受信任来源的事件进行 Base64 字段解码时利用。在这种情况下，能够向 Logstash 发送事件的未认证攻击者可对 Logstash 节点发起拒绝服务（DoS）攻击。&nbsp;</span></p><p><span>Elastic 还在准备通过默认禁用受影响的 JVM 优化来修复此漏洞。预计该修复将随即将推出的 Elastic 8.19.26、9.4.10、9.5.7 和 9.6.0 版本发布。</span></p><h3 id=\"sec-4\">Elastic Cloud Serverless</h3><p><span>Elastic Cloud Serverless 仅在极少数与 CPU 架构相关的情况下存在漏洞。我们已于 11 月 18 日星期三部署热修复，以缓解这些罕见情况。&nbsp;</span></p><p><span>Elastic 还针对 Elastic Cloud 基础设施中 CVE-2026-114938 的利用开发了检测规则；Elastic Information Security 团队会持续监控相关警报。&nbsp;</span></p><h3 id=\"sec-5\">Elastic Cloud Hosted</h3><p><span>Elastic Cloud Hosted 部署中只有一小部分（约为 &lt;5%）在 Microsoft Azure 上使用受影响的 CPU 架构；GCP 和 AWS 上的 Elastic Cloud Hosted 部署目前不受影响。&nbsp;</span></p><p><span>鉴于在此运行环境中利用 CVE-2026-114938 的复杂性——包括必须成功完成身份验证——Elastic 正在部署配置变更，以缓解受影响主机上的此漏洞。&nbsp;</span></p><p><span>Elastic 还针对 Elastic Cloud 基础设施中 CVE-2026-114938 的利用开发了检测规则；Elastic Information Security 团队会持续监控相关警报。&nbsp;&nbsp;</span></p><p><span>Elastic Cloud Hosted 的缓解配置同样适用于自管客户，详情如下共享。Elastic 还在准备通过将捆绑的 JDK 更新至 27.0.1.1+4 来修复此漏洞。预计该修复将随即将推出的 Elastic 8.19.26、9.4.10、9.5.7 和 9.6.0 版本发布。</span></p><h2 id=\"sec-6\">客户缓解建议 </h2><h3 id=\"sec-7\">自管 Elasticsearch 客户的缓解措施</h3><h4 id=\"sec-8\">缓解方案 1</h4><p><span>自管客户可以通过禁用受影响的 JVM 优化来缓解此漏洞。只有运行在 </span><span><span>x86-64 CPU</span></span><span> 上且支持 </span><span><span>AVX512_VBMI</span></span><span> 指令集的 Elasticsearch 节点受影响（例如 Intel Xeon Ice Lake 及更高版本，以及 AMD Zen 4 及更高版本）。目前，运行在 ARM CPU 和较旧的 </span><span><span>x86 CPU</span></span><span> 上的节点不受影响。&nbsp;</span></p><p><span>要检查主机，请运行 </span><span><span>grep -c avx512vbmi /proc/cpuinfo</span></span><span>；结果大于 0 表示该主机受影响。&nbsp;</span></p><p><span>要应用缓解措施，请在每个受影响节点的 </span><span><span>config/jvm.options.d/</span></span><span> 目录中创建一个文件（例如 </span><span><span>config/jvm.options.d/cve-2026-114938.options</span></span><span>），其中包含单独一行 </span><span><span>-XX:-UseBASE64Intrinsics</span></span><span>，然后重启节点。Docker 用户可以将此文件挂载到 </span><span><span>/usr/share/elasticsearch/config/jvm.options.d/</span></span><span>，ECK 用户可以在 Pod 模板中将该选项添加到 </span><span><span>ES_JAVA_OPTS</span></span><span> 环境变量中。滚动重启可避免集群停机。要确认缓解措施已生效，请检查 </span><span><span>GET _nodes/jvm</span></span><span> 的输出中，每个节点的 </span><span><span>jvm.input_arguments</span></span><span> 是否都包含 </span><span><span>-XX:-UseBASE64Intrinsics</span></span><span>。&nbsp;</span></p><p><span>客户仍应在包含更新后的捆绑 JDK 的版本发布后尽快进行升级。</span></p><h4 id=\"sec-9\">缓解方案 2</h4><p><span>下载最新的 JDK，并让 Elasticsearch 使用自带 JDK 的模式来运行。请注意，此缓解措施不适用于 Docker。&nbsp;</span></p><h3 id=\"sec-10\">自管 Elastic Cloud Enterprise (ECE) 客户的缓解措施</h3><p><span>对于运行在存在漏洞的 CPU 架构上的 ECE 客户，升级至 ECE 4.2.2 / 3.8.7（发布后），然后重启所有部署，即可修复所有托管 Elasticsearch 集群中的此漏洞。</span></p><p><span>在 ECE 4.2.2 / 3.8.7 发布之前，可以使用 API 或高级编辑器将缓解性 JVM 标志注入每个集群。详情请联系支持团队。&nbsp;&nbsp;</span></p><h3 id=\"sec-11\">Elastic Cloud on Kubernetes (ECK) 客户的缓解措施</h3><p><span>ECK Operator 不使用 Java，因此不受影响。ECK 管理的 Kibana、Beats、Elastic Agent、APM Server 和 Elastic Maps Server 不使用 Java，目前不受影响。</span></p><p><span>ECK 管理的 Elasticsearch 集群与其他自管 Elasticsearch 集群一样受到影响。只有运行在支持 AVX512_VBMI 指令集的 x86-64 CPU Kubernetes 节点上的 Elasticsearch Pod 受到影响。</span></p><p><span>要检查 Elasticsearch Pod 所在的节点，请运行：</span></p><pre><code>kubectl exec &lt;pod-name&gt; -c elasticsearch -- grep -c avx512vbmi /proc/cpuinfo</code></pre><p><span>结果大于 0 表示该节点受影响。Kubernetes 可以将 Pod 移至其他节点。如果节点池混合使用多种 CPU 类型，请对所有 x86-64 nodeSets 应用缓解措施。</span></p><p><span>要应用此缓解措施，请在每个受影响 nodeSet 的 </span><span><span>podTemplate</span></span><span> 中，将 </span><span><span>ES_JAVA_OPTS</span></span><span> 环境变量添加 </span><span><span>-XX:-UseBASE64Intrinsics</span></span><span>。如果 </span><span><span>ES_JAVA_OPTS</span></span><span> 已有值，例如用于设置堆大小，请将该选项添加到现有值的末尾。不要添加第二个 </span><span><span>ES_JAVA_OPTS</span></span><span> 条目。</span></p><pre><code>spec:\n  nodeSets:\n  - name: default\n    podTemplate:\n      spec:\n        containers:\n        - name: elasticsearch\n          env:\n          - name: ES_JAVA_OPTS\n            value: \"-XX:-UseBASE64Intrinsics\" # keep your existing options</code></pre><p><span>应用此更改后，ECK 会自动逐一重启 Elasticsearch Pod（即滚动重启）。您无需手动重启 Pod。</span></p><p><span>要确认缓解措施已生效，请确保在 </span><span><span>GET _nodes/jvm</span></span><span> 输出中，每个节点的 </span><span><span>jvm.input_arguments</span></span><span> 都包含 </span><span><span>-XX:-UseBASE64Intrinsics</span></span><span>。</span></p><p><span>更新版本的捆绑 JDK 一可用，请立即升级到包含该 JDK 的发行版本。要升级，请更改 Elasticsearch 资源的 </span><span><span>spec.version</span></span><span>。升级后，您可以移除该选项。</span></p><h3 id=\"sec-12\"><span>ECK 上的 Logstash</span></h3><p><span>只有当 Logstash 对攻击者可控的 Base64 数据运行 </span><span><span>elastic_integration</span></span><span> 过滤器时，才会受到影响。其结果是崩溃，而不是代码执行。要应用缓解措施，请在 Logstash 资源的 </span><span><span>podTemplate</span></span><span> 中，将 </span><span><span>-XX:-UseBASE64Intrinsics</span></span><span> 添加到 </span><span><span>LS_JAVA_OPTS</span></span><span> 环境变量。如果 </span><span><span>LS_JAVA_OPTS</span></span><span> 已有值，请将该选项添加到现有值的末尾。</span></p><pre><code>spec:\n  podTemplate:\n    spec:\n      containers:\n      - name: logstash\n        env:\n        - name: LS_JAVA_OPTS\n          value: \"-XX:-UseBASE64Intrinsics\" # keep your existing options</code></pre><h3 id=\"sec-13\"><span>自托管 Logstash 客户的缓解措施</span></h3><p><span>自托管客户可以通过禁用受影响的 JVM 优化来缓解此漏洞。只有运行在支持 AVX512_VBMI 指令集的 x86-64 CPU 上的 Logstash 节点会受到影响（例如 Intel Xeon Ice Lake 及更新版本，以及 AMD Zen 4 及更新版本）。根据我们目前的分析，运行在 ARM CPU 和较旧 x86 CPU 上的节点不受影响。</span></p><p><span>要检查主机，请运行 grep -c avx512vbmi /proc/cpuinfo；结果大于 0 表示该主机受到影响。</span></p><p><span>要应用缓解措施，请将单行 -XX:-UseBASE64Intrinsics 添加到每个受影响节点的 config/jvm.options 文件中，然后重启 Logstash。Docker 和 ECK 用户可以将该选项添加到 LS_JAVA_OPTS 环境变量。要确认缓解措施已生效，请检查 Logstash 启动日志中的 JVM 引导标志行是否包含 -XX:-UseBASE64Intrinsics。</span></p><p><span>客户仍应在包含更新后的默认配置的发行版本一可用时立即升级。升级后，不再需要手动设置。客户不得设置 -XX:+UseBASE64Intrinsics，因为这会重新启用受影响的优化。</span></p><h2 id=\"sec-14\"><span>有问题吗？</span></h2><p><span>如果您有任何问题，请通过支持门户&nbsp;</span><a href=\"http://support.elastic.co/\"><span>support.elastic.co</span></a><span>&nbsp;或电子邮件&nbsp;</span><span>support@elastic.co</span><span>&nbsp;联系 Elastic 支持。</span></p>","original","zhKind","translation","complete","npae2p2bauihkhq9p8huoutnf","OpenJDK 披露 Base64 解码远程代码执行漏洞 CVE-2026-114938","漏洞","补丁","加固","Oracle","Microsoft","AWS","https://www.elastic.co/blog/java4shell-remote-code-execution-rce-vulnerability","Elastic Blog",{"_148":149,"_150":-5},"changelogVersion","2026-10-01T08:00","release"]
