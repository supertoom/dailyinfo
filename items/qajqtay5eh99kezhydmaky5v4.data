[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":-5,"_57":36,"_58":59},"expiresAt",1794185105000,"id","qajqtay5eh99kezhydmaky5v4","title","ChromeOS Stable 通道发布 16836.32.0，修复 10 个安全漏洞","originalTitle","Stable Channel Update for ChromeOS / ChromeOS Flex","summary","ChromeOS Stable 通道设备开始推送 ChromeOS 16836.32.0，对应浏览器版本 156.0.8078.93。","reason","source",{"_64":85},"links",{"_59":84},"publishedAt","2026-11-07T00:52:58.867Z","discoveredAt","2026-11-07T06:33:33.286Z","timelineAt","category","vuln","tags",[80,81,82,67,83],"score",53,"selected",false,"channel","news","story","x","readingMode","full","author","Andy Wu","body",{"_76":-5,"_59":77,"_78":-5,"_79":36},"outline",[70],"relatedStories",[],"topics",[60,61,62],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_63":68,"_64":69},{"_63":66,"_64":67},{"_63":30,"_64":65},"slug","name","漏洞披露","browser","浏览器","google","Google / 谷歌",{"_11":71,"_72":73,"_74":75},"sec-1","text","Chrome Browser Security Fixes:","level",4,"zh","<p><span>M-156, ChromeOS version 16836.32.0 (Browser version 156.0.8078.93）has rolled out to ChromeOS devices on the Stable channel.&nbsp;</span></p><p><span><p><span>If you find new issues, please let us know one of the following ways:</span></p><ol><li><p><a href=\"https://bugs.chromium.org/p/chromium/issues/list\"><span>File a bug</span></a></p></li><li><p><span>Visit our ChromeOS communities</span></p></li><ol><li><p><span>General:</span><a href=\"https://support.google.com/chromebook/community/?hl=en&amp;gpf=%23!forum%2Fchromebook-central\"><span> </span><span>Chromebook Help Community</span></a></p></li><li><p><span>Beta Specific:</span><a href=\"https://support.google.com/chromeos-beta/community\"><span> </span><span>ChromeOS Beta Help Community</span></a></p></li></ol><li><p><a href=\"https://support.google.com/chrome/answer/95315?hl=en&amp;co=GENIE.Platform%3DDesktop\"><span>Report an issue or send feedback on Chrome</span></a></p></li><li><p><span>Interested in switching channels?</span><a href=\"https://support.google.com/chromebook/answer/1086915\"><span> </span><span>Find out how.</span></a></p></li></ol><br><p><span>Andy Wu</span></p><p><span>Google ChromeOS</span></p><br><h4 id=\"sec-1\"><span>Chrome Browser Security Fixes:</span></h4><br><p><a href=\"http://b/578670966\"><span>578670966</span></a><span> </span><span>High</span><span> CVE-2026-121076 Use after free in WebXR</span></p><br><p><a href=\"http://b/577402416\"><span>577402416</span></a><span> </span><span>High</span><span> CVE-2026-121208 Out of bounds read in Media</span></p><br><p><a href=\"http://b/534468209\"><span>534468209</span></a><span> </span><span>High</span><span> CVE-2026-79235 Use after free in WebGL</span></p><br><p><a href=\"http://b/552757015\"><span>552757015</span></a><span> </span><span>High</span><span> CVE-2026-121233 Type confusion in CacheStorage</span></p><br><p><a href=\"http://b/565681451\"><span>565681451</span></a><span> </span><span>Medium</span><span> CVE-2026-121184 Out of bounds read in Media</span></p><br><p><a href=\"http://b/574762568\"><span>574762568</span></a><span> </span><span>High</span><span> CVE-2026-121213 Uninitialized resource in Images</span></p><br><p><a href=\"http://b/574791491\"><span>574791491</span></a><span> </span><span>High</span><span> CVE-2026-121241 Use after free in Navigation</span></p><br><p><a href=\"http://b/574193110\"><span>574193110</span></a><span> </span><span>High</span><span> CVE-2026-121201 Use after free in Animation</span></p><br><p><a href=\"http://b/578671521\"><span>578671521</span></a><span> </span><span>Medium</span><span> CVE-2026-121135 Security issue in Platform</span></p><br><p><a href=\"http://b/578083806\"><span>578083806</span></a><span> </span><span>Low</span><span> CVE-2026-121141 Improper input validation in Editing</span></p></span></p>","zhKind","complete","漏洞","补丁","例行内容","Google","http://chromereleases.googleblog.com/2026/11/stable-channel-update-for-chromeos.html","Chrome Releases",{"_87":88,"_89":-5},"changelogVersion","2026-10-01T08:00","release"]
