[{"_1":2,"_3":4},"root",{"_5":135},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":54,"_55":36,"_56":36,"_57":58,"_59":36,"_60":61},"expiresAt",1795912844000,"id","nzt95o0rx92hlv2bv6ms960qe","title","Google Cloud 披露 COLD RELIC 利用云身份连续入侵两起美国机构事件","originalTitle","COLD RELIC: A Case Study in Impersonation and Compromise","summary","Google Cloud 披露俄罗斯国家级组织 COLD RELIC 通过钓鱼、住宅代理和 MFA 疲劳攻击入侵两家美国机构，并利用前一家窃取的人员与关系数据冒充员工，攻击第二家的 Microsoft Entra ID。","reason","source",{"_75":134},"links",{"_120":133},"publishedAt","2026-11-17T14:00:00.000Z","discoveredAt","2026-11-17T17:21:40.036Z","timelineAt","category","activity","tags",[78,126,76,127,128,129,130,131,132],"score",77,"selected",true,"channel","news","story",{"_86":87,"_13":88},"x","sameEvent",{"_11":124,"_13":125},"readingMode","full","author","body",{"_61":119,"_120":-5,"_121":122,"_123":36},"outline",[89,90,91,92,93,94,95,96,97],"relatedStories",[85],"topics",[68,69,70,71,72],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","ftUtHL6qd6Pw","reportCount",5,"additionalSourceCount",4,{"_73":83,"_75":84},{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","malware","name","恶意软件","attack","攻击活动","red-team","红队与渗透","email","邮件与钓鱼","google","Google / 谷歌",{"_86":87,"_13":88},"publicId","95ba3910-53c0-4a77-96da-6f3dc316c229","Star Blizzard连续入侵两家美国机构",{"_11":117,"_99":118,"_101":102},{"_11":115,"_99":116,"_101":102},{"_11":113,"_99":114,"_101":102},{"_11":111,"_99":112,"_101":102},{"_11":109,"_99":110,"_101":102},{"_11":107,"_99":108,"_101":102},{"_11":105,"_99":106,"_101":102},{"_11":103,"_99":104,"_101":102},{"_11":98,"_99":100,"_101":102},"sec-9","text","Google 安全运营（SecOps）","level",3,"sec-8","检测","sec-7","修复与加固","sec-6","展望与影响","sec-5","失陷后活动","sec-4","案例研究 2 - 利用先前的攻陷 - 初始方法","sec-3","案例研究 1 —— 从窃取凭据到数据外泄","sec-2","威胁详情&nbsp;","sec-1","简介&nbsp;","<p><span>作者：Josh Murchie、John Wolfram、Joseph Spero、Peter Ukhanov、Fernando Tomlinson, Jr.、Wesley Shields</span></p><hr><h3 id=\"sec-1\"><span>简介</span><strong>&nbsp;</strong></h3><p><span>过去一年，Mandiant 响应了一系列相互关联的入侵事件，揭示了俄罗斯网络间谍组织 COLD RELIC（此前追踪为 COLDRIVER 和 UNC4057；又称 Star Blizzard、Callisto 和 Gossamer Bear）如何将一次云端入侵转化为持续入侵第三方及开展间谍活动的跳板。最近，Mandiant 调查了 2026 年一家美国机构的入侵事件，其中 COLD RELIC 将 Mandiant 此前调查的、2025 年末发生的另一起美国机构入侵事件中被盗取的数据、企业员工通讯录和身份信息直接武器化。&nbsp;</span></p><p><span>COLD RELIC 是一个俄罗斯国家支持的网络威胁组织，<a href=\"https://www.justice.gov/archives/opa/pr/justice-department-disrupts-russian-intelligence-spear-phishing-efforts\"><span>美国司法部（DOJ）评估认为</span></a>，该组织在俄罗斯联邦安全局（FSB）内运作。该组织以实施复杂的网络钓鱼和恶意软件活动闻名，目的是获取对俄罗斯政府具有战略或政治价值的信息，并利用已被攻陷的访问权限，针对受害者更广泛的社会与职业网络。一旦 COLD RELIC 攻陷某个目标，就会利用被盗的电子邮件和数据建立可信的身份掩护，在联系后续目标时冒充相关联系人。尽管 COLD RELIC 总体上保持低调，公开报告远少于其他与俄罗斯有关联的网络威胁行为者，但其在保持稳定行动节奏的同时，在攻陷高价值目标（包括欧洲和北美的政府官员、国防承包商以及非政府组织（NGO））方面取得了极大成功。</span></p><p><span>尽管 Google Threat Intelligence Group（GTIG）<a href=\"https://blog.google/threat-analysis-group/google-tag-coldriver-russian-phishing-malware\"><span>自 2015 年以来一直追踪并挫败</span></a> COLD RELIC 的网络钓鱼活动，但 Mandiant 近期的事件响应调查揭示了关于该组织社会工程手法和攻陷后操作技术的关键新洞察。我们分享这份端到端分析，并提供可执行的检测与加固建议，帮助组织抵御 COLD RELIC 持续利用被盗身份掩护、本地住宅代理以及跨云身份滥用。作为挫败该威胁行为者工作的一部分，当我们发现 COLD RELIC 针对 Google 账户发动攻击时，会发布<a href=\"https://knowledge.workspace.google.com/admin/reports/government-backed-attack-alerts\"><span>政府支持的攻击警报</span></a>。COLD RELIC 仍是一个活跃威胁；GTIG 最近于 2026 年 11 月观测到了新网络钓鱼行动的证据。&nbsp;</span></p><h3 id=\"sec-2\"><span>威胁详情</span><strong>&nbsp;</strong></h3><p><span>在超过十年的 COLD RELIC 追踪以及与 Mandiant 事件响应调查合作中，我们观察到该组织持续改进其利用一次入侵所收集数据的方式，以支持针对下游目标的后续行动。2025 年末，COLD RELIC 从一家美国机构下载了大量数据，搜寻姓名、电子邮件地址和电子邮件归档，可能是为了满足更广泛的情报需求。2026 年，Mandiant 调查了 COLD RELIC 对第二家美国机构的后续入侵；网络钓鱼 URL 参数和冒充话术表明，COLD RELIC 很可能利用了来自第一家机构的联系人及关系背景来 targeting 第二家机构。</span></p><p><span>COLD RELIC 网络钓鱼活动的一个标志性特征，是使用被入侵的网站作为初始链接，将目标重定向至实际的网络钓鱼域名。这为 COLD RELIC 提供了一层误导，并隐藏其网络钓鱼域名，同时也使其能够为访问该链接的人生成指纹，以判断是否应将其重定向。COLD RELIC 网络钓鱼链接末尾通常包含一个参数，其值由攻击者设置，通常表明与先前受害者之间的关系或诱饵内容。例如，URL 可能如下所示（但并非总是如此）：</span></p><pre><code>https://compromised.example.com/some_path/some_file.php?file=&lt;previous_victim_name&gt;\nhttps://compromised.example.com/some_path/some_file.php?ref=&lt;lure_name&gt;</code></pre><p><span><span>图 1：包含目标个人姓名或诱饵主题的 URL 示例</span></span></p><p><span>在 Mandiant 对第二家美国机构的事件响应调查期间，响应人员发现 COLD RELIC 通过一款加密消息应用发起接触，并冒充第一家受害者机构的一名员工。与此同时，GTIG 关联到一个 COLD RELIC 重定向器 URL，该 URL 来自 2026 年 6 月提交至 VirusTotal 的入侵活动，其查询参数引用了第一家受害者机构。</span></p><h3 id=\"sec-3\"><span>案例研究 1 —— 从窃取凭据到数据外泄</span></h3><p><span>在 2025 年末的入侵期间，GTIG 观察到 COLD RELIC 操作人员入侵了一家美国机构的云办公环境。为获得初始访问权限，COLD RELIC 利用了美国境内一个地理位置紧邻受害者的住宅代理网络。COLD RELIC 使用被窃取的 Super Admin 账户凭据，并结合</span><span>多因素身份验证</span><span> </span><span>(</span><span>MFA) 推送通知疲劳攻击进行身份验证。在受害者用户接受 MFA 请求后，COLD RELIC 在受害者机构的租户中注册了一种此前未曾见过的设备型号。COLD RELIC 利用通行密钥、MFA 备用代码和恶意 MFA 设备，在整个入侵过程中保持访问权限。</span></p><p><span>COLD RELIC 利用已被攻陷的 Super Admin 账户的权限，通过将文件批量共享至由 COLD RELIC 控制的电子邮件账户以及直接下载文件，下载了整个组织云存储驱动器中的内容。在受害组织租户内运行时，COLD RELIC 访问了 Admin Console，查询了管理安全调查和电子邮件审计日志以检查防御可见性，并查看、修改和删除了 Alert Center 通知，以移除初始入侵的法证证据。COLD RELIC 还导出了完整的员工列表，并使用 Super Admin 权限通过 Google Workspace Customer Takeout 发起了域范围的数据导出。与个人终端用户 Google Takeout 不同，Customer Takeout 是一种管理级别的租户范围导出工具；此类请求会记录在 Google Workspace Admin 审计日志中（</span><code>CUSTOMER_TAKEOUT_CREATED</code><span>），管理员还可以</span><a href=\"https://knowledge.workspace.google.com/admin/users/advanced/allow-or-block-google-takeout\"><span>在组织级别为用户禁用 Google Takeout</span></a><span>。</span></p><p><span>在完成大规模数据窃取和反取证活动后，COLD RELIC 在数月内持续访问受害组织，并执行了其他活动，包括：</span></p><ul>\n<li>\n<p><span>通过 OAuth 将电子邮件收件箱同步到外部电子邮件客户端</span></p>\n</li>\n<li>\n<p><span>使用攻击者注册且未撤销的通行密钥进行重新身份验证；这些通行密钥在密码和会话重置后仍然有效，并绕过了设备注册控制</span></p>\n</li>\n<li>\n<p><span>有针对性地访问与凭据、电子邮件归档、人员信息以及与 COLD RELIC 情报收集需求相关的其他文件有关的云端硬盘文档</span></p>\n</li>\n</ul><p><span>当威胁行为者被移出受害组织的基础设施后，GTIG 观察到 COLD RELIC 利用冒充受害组织员工的电子邮件账户。这些冒充账户被用于再次对同一行业圈内的内部员工和关联人员发起社会工程攻击。</span></p><h3 id=\"sec-4\"><span>案例研究 2 - 利用先前的攻陷 - 初始方法</span></h3><p><span>在第二次入侵中，COLD RELIC 展现出在多云环境和联合身份验证机制中进行操作的能力。GTIG 观察到 COLD RELIC 操作人员攻陷了一家美国组织的 Microsoft Entra ID 用户账户，该组织使用 Entra ID 作为 Google Workspace 的联合单点登录（SSO）身份提供商。为获得初始访问权限，COLD RELIC 冒充了案例研究 1 中受影响组织的一名员工，以便在安全消息应用上建立通信借口。威胁行为者最终在对话过程中分享了网络钓鱼链接。这些旨在窃取 Entra ID 凭据和身份验证令牌的网络钓鱼链接将受害者重定向至与当前对话相关的文档诱饵，以避免引起怀疑。在使用窃取的凭据成功完成身份验证后，COLD RELIC 在该 SSO 解决方案中注册并使用了新的 MFA 设备，以便在整次入侵期间保持对该用户账户的访问权限。&nbsp;</span></p><p><span>下文附有经过删减和简化的社会工程对话版本（图像由 LLM 生成）：</span></p><figure><p><img src=\"/dailyinfo/media/1e170ff0b023c605.webp\" loading=\"lazy\" decoding=\"async\" alt=\"https://storage.googleapis.com/gweb-cloudblog-publish/images/Figure_2_Redacted_LLM-generated_depiction_of.max-900x900.png\"></p></figure><p>图 2：经删减、由 LLM 生成的所观察到的威胁行为者社会工程互动示意图</p><p><span>通过冒充与新目标处于同一职业圈子的熟人，COLD RELIC 提高了钓鱼得手的概率。最终，在本案中，COLD RELIC 成功获取了该组织的凭据，并对受损用户云端驱动器中可访问的文件进行了批量下载。&nbsp;</span></p><h3 id=\"sec-5\"><span>失陷后活动</span></h3><p><span>在初步访问组织后，COLD RELIC 注册了恶意 MFA 设备、通行密钥和 MFA 备份代码，以建立长期持久化。一旦确保持久化，COLD RELIC 便开展激进的数据收集和窃取活动，访问电子邮件、聊天和云存储存储库。尽管 COLD RELIC 失陷后的主要目标是批量收集和下载文件及电子邮件归档，但其同时还会针对特定关注词进行定向查询。具体而言，COLD RELIC 会搜索凭据、人员信息、电子邮件归档（.pst 文件）以及与其收集需求相关的文档。此外，COLD RELIC 还会寻找能够支持后续鱼叉式钓鱼活动的数据，包括组织人员名册、联系人列表、简历和活动日程，以便为未来目标构建可信的身份掩护。</span></p><p><span>除了寻找支持后续行动的数据外，COLD RELIC 似乎还利用了案例研究 2 中使用的账户继续进行后续目标攻击。入侵后，用于初始接触的加密消息应用记录显示，该威胁行为者将个人资料名称更改为一个全新的人物。GTIG 认为，这一新人设很可能是为了以与本文记录的两个案例类似的方式，继续针对同一职业圈内的其他组织。</span></p><h3 id=\"sec-6\"><span>展望与影响</span></h3><p><span>COLD RELIC 的活动展示了以人为中心的社会工程与云身份滥用的融合。通过获取战略性人员名册和运营文档，俄罗斯情报机构将合法的商务通信转化为针对可信合作伙伴的攻击途径。他们在多个云生态之间穿行的能力凸显出，组织必须以整体方式防御其完整的身份资产。GTIG 将继续追踪、扰乱并揭露 COLD RELIC 基础设施，以保护全球云用户。</span></p><h3 id=\"sec-7\"><span>修复与加固</span></h3><p><span>如前所述，GTIG 观察到 COLD RELIC 在其入侵过程中严重依赖住宅代理网络。此外，该组织更进一步，通过选择地理位置与受害用户大致相同的代理来混淆其活动，从而避免触发“不可能的旅行”或其他基于启发式方法的告警机制。GTIG 建议使用 </span><a href=\"https://spur.us/blog/residential-proxy-lateral-movement-risk\"><span>住宅代理</span></a><span> 和 VPN IP 信誉情报源来扩充身份验证日志，针对特权账户住宅 ASN 突然变化发出告警，并应用条件访问策略，阻止或检测来自已知代理网络的登录。</span></p><p><span>在某些情况下，由于用户将凭据和其他机密存储在其组织的云存储平台上，COLD RELIC入侵的严重程度和影响范围被放大。这使COLD RELIC能够转向其他账户或服务，而这些账户或服务原本是无法访问的，其中包括用户的个人账户，而雇主的监控通常不涵盖这些账户。组织可以实施云存储数据防泄露（DLP）策略，例如</span><a href=\"https://knowledge.workspace.google.com/admin/security/create-data-protection-rules\"><span>Google Workspace的Security &amp; Data Protection</span></a><span>，以警告或阻止用户创建、上传或对外共享匹配敏感模式的文件。</span></p><p><span>至少在一个案例中，GTIG观察到受害组织发现了入侵，并试图通过重置受影响账户的密码来补救COLD RELIC对其云租户的访问。然而，由于威胁行为者劫持了会话，且受害组织未能同时撤销相关账户的所有现有会话，COLD RELIC仍保持访问权限。在类似情况下，例如商务电子邮件入侵（BEC），GTIG建议组织在强制重置受影响账户密码的同时，撤销所有用户会话。</span><span>组织应实施以下建议：</span></p><ol>\n<li>\n<p><span>身份与多因素认证&nbsp;</span></p>\n</li>\n<ul>\n<li>\n<p><span>强制执行抗钓鱼MFA（FIDO2 / WebAuthn）：用硬件安全密钥（如Titan Security Keys）替代短信、语音和推送通知。硬件密钥与源URL绑定，无法被AiTM反向代理拦截，也无法通过疲劳攻击获得批准。</span></p>\n</li>\n<li>\n<p><span>限制并审核通行密钥注册：监控身份日志中的通行密钥注册和异常设备注册，尤其是管理员账户。</span></p>\n</li>\n<li>\n<p><span>强化MFA注册：要求现有管理员或带外身份验证来批准新的MFA设备或辅助认证器（如Microsoft Authenticator或通行密钥）。</span></p>\n</li>\n<li>\n<p><span>组织和个人可考虑注册加入</span><a href=\"https://landing.google.com/advancedprotection/\"><span>Advanced Protection Program</span></a><span>。 </span></p>\n</li>\n</ul>\n<li>\n<p><span>会话管理与事件响应&nbsp;</span></p>\n</li>\n<ul>\n<li>\n<p><span>在BEC应急手册中强制执行会话和OAuth撤销：在补救疑似账户失陷时，仅更改密码是不够的。管理员必须立即在Google Workspace和Microsoft Entra ID中撤销所有活动浏览器会话、刷新令牌和已授权的第三方OAuth应用权限，并移除任何未经授权的通行密钥、备用代码或MFA设备。</span></p>\n</li>\n<li>\n<p><span>审核第三方OAuth授权：持续审查Google Workspace和Microsoft 365中已授权的第三方应用，标记异常的原生桌面邮件客户端（如Thunderbird）或外部邮件服务（如Proton Mail）。</span></p>\n</li>\n</ul>\n<li>\n<p><span>网络与基础设施控制&nbsp;</span></p>\n</li>\n<ul>\n<li>\n<p><span>检测并阻止住宅代理登录：限制来自消费者ISP、VPN和已知住宅代理ASN范围（如AS5650、AS20115）的管理访问。</span></p>\n</li>\n<li>\n<p><span>跨云DLP策略：在云存储（Google Drive、OneDrive、SharePoint）上部署数据防泄露（DLP）规则，对包含敏感术语（如passwords、roster、.pst）的文档发出警报，或限制大规模对外文件共享。</span></p>\n</li>\n</ul>\n</ol><h3 id=\"sec-8\"><span>检测</span></h3><table>\n<thead>\n<tr>\n<th>\n<p><strong>观察到的活动</strong></p>\n</th>\n<th>\n<p><strong>MITRE ATT&amp;CK 映射</strong></p>\n</th>\n<th>\n<p><strong>检测机会</strong></p>\n</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>\n<p><strong>MFA 疲劳攻击</strong><span>&nbsp;</span></p>\n</td>\n<td>\n<p><strong>T1621：</strong><span>多因素身份验证请求生成</span></p>\n</td>\n<td>\n<p><strong>监控 MFA 垃圾请求：</strong><span>针对同一用户在短时间内出现多次登录失败或 MFA 质询事件发出警报，随后紧接着从同一 IP 地址成功进行身份验证。</span></p>\n</td>\n</tr>\n<tr>\n<td>\n<p><strong>OAuth 滥用与邮件同步</strong><span>&nbsp;</span></p>\n</td>\n<td>\n<p><strong>T1114.002：</strong><span>电子邮件收集：远程电子邮件收集&nbsp;</span></p>\n<p><strong>T1528：</strong><span>窃取应用程序访问令牌</span></p>\n</td>\n<td>\n<p><strong>未经批准的 OAuth 范围：</strong><span>针对新的 OAuth 授权发出警报（</span><code>Authorize</code><span> GWS OAuth 日志中的事件），这些授权向 Proton 或 Thunderbird 等非标准或未经批准的邮件客户端授予了广泛的范围（例如 </span><code>https://mail.google.com/</code><span>）。</span></p>\n</td>\n</tr>\n<tr>\n<td>\n<p><strong>自动化数据外泄尝试</strong><span>&nbsp;</span></p>\n</td>\n<td>\n<p><strong>T1119：</strong><span>自动化收集</span></p>\n</td>\n<td>\n<p><strong>客户数据提取的启动：</strong><span>针对创建任何租户范围的收集或导出操作生成警报（例如 GWS Admin 日志中的 </span><code>Customer Takeout Created</code><span>），因为这种技术可能导致整个租户的数据外泄。</span></p>\n</td>\n</tr>\n<tr>\n<td>\n<p><strong>通过批量下载窃取数据</strong><span>&nbsp;</span></p>\n</td>\n<td>\n<p><strong>T1530：</strong><span>来自云存储的数据&nbsp;</span></p>\n</td>\n<td>\n<p><strong>异常下载量：</strong><span>监控日志中文件下载量激增的情况（例如 GWS Drive 日志中单个用户在短时间内出现 </span><code>Download</code><span> 事件），尤其是源自非企业 ASN/IP 或已知住宅代理网络的情况。</span></p>\n</td>\n</tr>\n<tr>\n<td>\n<p><strong>通过外部共享窃取数据</strong><span>&nbsp;</span></p>\n</td>\n<td>\n<p><strong>T1567.002：</strong><span>外泄至云存储</span></p>\n</td>\n<td>\n<p><strong>外部文件共享异常：</strong><span>监控日志中文档对外共享数量激增的情况（例如 GWS Drive </span><code>User Sharing Permissions Change</code><span> 或 </span><code>Visibility</code><span> 变更为 </span><code>shared_externally</code><span>），尤其是共享至免费电子邮件提供商（例如 </span><code>@gmail.com</code><span>）的情况。</span></p>\n</td>\n</tr>\n<tr>\n<td>\n<p><strong>设备与通行密钥注册</strong><span>&nbsp;</span></p>\n</td>\n<td>\n<p><strong>T1098.005：</strong><span>账户操纵：设备注册</span></p>\n</td>\n<td>\n<p><strong>新的 MFA/设备注册：</strong><span>针对新的通行密钥注册（例如 GWS </span><code>Passkey enrolled</code><span> 事件）或设备注册（GWS </span><code>Device Registered</code><span> 事件）发出警报，尤其是源自意外地理位置或紧随 MFA 疲劳模式之后的情况。</span></p>\n</td>\n</tr>\n<tr>\n<td>\n<p><strong>使用 MFA 备用代码</strong><span>&nbsp;</span></p>\n</td>\n<td>\n<p><strong>T1078.004：</strong><span>有效账户：云账户</span></p>\n</td>\n<td>\n<p><strong>备用代码使用：</strong><span>监控使用 MFA 备用代码进行身份验证的日志（例如 GWS User 日志中 Login Challenge Type 为 </span><code>Backup code</code><span> 的记录），尤其是源自非企业 ASN 或已知住宅代理网络的情况。</span></p>\n</td>\n</tr>\n<tr>\n<td>\n<p><strong>通过删除警报削弱防御</strong><span>&nbsp;</span></p>\n</td>\n<td>\n<p><strong>T1562.008：</strong><span>削弱防御：禁用或修改云日志/警报</span></p>\n</td>\n<td>\n<p><strong>篡改 Alert Center：</strong><span>针对任何用户修改或删除安全警报的行为发出警报（例如 GWS Admin 日志中的 </span><code>Batch Delete Operation Performed</code><span> 事件），尤其是用户删除与其自身账户相关的警报或严重性警报（例如 GWS Government-backed attack alerts）的情况。</span></p>\n</td>\n</tr>\n<tr>\n<td>\n<p><strong>通过用户列表进行内部侦察</strong><span>&nbsp;</span></p>\n</td>\n<td>\n<p><strong>T1087.004：</strong><span> 账户发现：云账户</span></p>\n</td>\n<td>\n<p><strong>目录导出：</strong><span> 对域用户导出行为进行告警（例如 GWS Admin 日志中的 </span><code>User List Download</code><span> 事件）。虽然管理员可能出于正当目的执行此操作，但应进行严格审查，尤其是在从未知设备发起时。</span></p>\n</td>\n</tr>\n<tr>\n<td>\n<p><strong>取证反调查</strong><span>&nbsp;</span></p>\n</td>\n<td>\n<p><strong>T1082：</strong><span> 系统信息发现</span></p>\n</td>\n<td>\n<p><strong>管理员日志查询：</strong><span> 监控用户执行审计日志查询的行为（例如 GWS Admin 日志中的 </span><code>Investigation Query</code><span> 事件）。对安全、访问或审计日志的异常查询可能表明威胁行为者正试图进行反取证。</span></p>\n</td>\n</tr>\n<tr>\n<td>\n<p><strong>搜索密码与归档</strong><span>&nbsp;</span></p>\n</td>\n<td>\n<p><strong>T1083：</strong><span> 文件和目录发现&nbsp;</span></p>\n<p><strong>T1552.001：</strong><span> 文件中的凭据</span></p>\n</td>\n<td>\n<p><strong>敏感文件搜索：</strong><span> 监控文件目录关键词搜索的日志（例如 GWS Drive 日志中的 </span><code>Item search performed</code><span> 事件），其中包含与归档或凭据相关的词语，例如 </span><code>.pst</code><span>、</span><code>.bak</code><span>、</span><code>password</code><span>、</span><code>cred</code><span>，或对标题明确含凭据相关关键词的文档进行反复访问/下载。</span></p>\n</td>\n</tr>\n</tbody>\n</table><h3 id=\"sec-9\"><span>Google 安全运营（SecOps）</span></h3><p><span>Google SecOps 客户可通过 Mandiant Frontline Threats 规则包访问这些大类别规则及更多规则。博客文章中讨论的活动在 Google SecOps 中通过以下规则名称检测：</span></p><ul>\n<li>\n<p><span>Google Workspace 成功 MFA 疲劳攻击</span></p>\n</li>\n<li>\n<p><span>Google Workspace 客户数据导出已启动</span></p>\n</li>\n<li>\n<p><span>Google Workspace Alert Center 告警删除</span></p>\n</li>\n<li>\n<p><span>Google Workspace 目录用户列表下载</span></p>\n</li>\n<li>\n<p><span>Google Workspace Drive 批量对外或免费邮箱文件共享</span></p>\n</li>\n<li>\n<p><span>Google Workspace 在 MFA 疲劳之后进行设备或通行密钥注册</span></p>\n</li>\n<li>\n<p><span>Google Workspace 向未获批准的客户端授予 OAuth 广泛邮件权限范围</span></p>\n</li>\n</ul><p><span>发布于</span></p><ul><li><a href=\"https://cloud.google.com/blog/topics/threat-intelligence\">威胁情报</a></li></ul>","original","zhKind","translation","complete","otlmhixhsya3dvwx5u2d3qxx2","俄罗斯间谍组织 COLD RELIC 利用云端入侵冒充员工钓鱼后续目标","钓鱼","数据泄露","后门","红队","Google","Microsoft","AWS","https://cloud.google.com/blog/topics/threat-intelligence/cold-relic-a-case-study-in-impersonation-and-compromise/","Google Cloud 威胁情报",{"_136":137,"_138":-5},"changelogVersion","2026-10-01T08:00","release"]
