[{"_1":2,"_3":4},"root",{"_5":112},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794616832000,"id","phzcemc8tw3yd552qu2tv54yf","title","Goddess of Victory: NIKKE PC 启动器遭供应链投毒，分发远程访问与数据窃取恶意软件","originalTitle","NIKKE PC game launcher hacked to spread remote access, data-stealing malware","summary","Goddess of Victory: NIKKE PC 启动器遭第三方篡改并被用于分发恶意软件。","reason","事件同时关联官方启动器脚本、远程访问后门、凭据窃取与加密钱包数据风险，并给出受污染文件、域名和日志 IOC，便于受影响玩家核查与处置。","source",{"_76":111},"links",{"_102":110},"publishedAt","2026-11-04T16:58:46.000Z","discoveredAt","2026-11-04T17:10:22.701Z","timelineAt","category","activity","tags",[79,77,106,107,108,109],"score",71,"selected",true,"channel","news","story",{"_89":90,"_13":91},"x","readingMode","full","author","Bill Toulas","body",{"_61":101,"_102":-5,"_103":104,"_105":37},"outline",[92,93],"relatedStories",[88],"topics",[68,69,70,71,72,73],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fRwAOj9o_TX8","reportCount",1,"additionalSourceCount",0,{"_74":86,"_76":87},{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","malware","name","恶意软件","attack","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","identity","身份与访问","supply-chain","供应链安全",{"_89":90,"_13":91},"publicId","675d257f-f640-40a0-8ffc-45bd9afe7a69","NIKE启动器供应链投毒已修补",{"_11":99,"_95":100,"_97":98},{"_11":94,"_95":96,"_97":98},"sec-2","text","发现现有防御可能遗漏的邮件威胁。","level",2,"sec-1","恶意启动器脚本提供后门","<p><img alt=\"Nikke\" height=\"900\" src=\"/dailyinfo/media/67601734bc8fa61b.jpg\" srcset=\"/dailyinfo/media/626a382b5ea95e9f.jpg 720w, /dailyinfo/media/ab04d784f4290e65.jpg 1200w, /dailyinfo/media/67601734bc8fa61b.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>《胜利女神：妮姬》的开发者已确认，黑客在一次供应链攻击中篡改了这款游戏的 PC 启动器脚本，并分发能够窃取凭据和加密货币钱包数据的恶意软件。</p><p>根据 X 上发布的一则通知，为解决该问题，官方于 11 月 4 日 02:30（UTC +9）发布了客户端更新。</p><p><a href=\"http://x.com/NIKKE_en/status/2117817602659770434\">X 上的声明</a>写道：“我们已发现一个问题，表明 PC 启动器的脚本文件可能已被第三方篡改。”</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/2fef11a936f1caee.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>“因此，我们于 11 月 4 日约 02:30（UTC+9）实施了客户端修复和更新。目前，我们正在调查该问题造成的影响范围，并将通过另一则通知提供有关后续措施的更多详细信息。”</p><p>《胜利女神：妮姬》是一款广受欢迎的科幻射击 RPG，由韩国公司 Shift Up 开发，支持 Windows、<a href=\"https://apps.apple.com/us/app/goddess-of-victory-nikke/id1585915174\">iOS</a> 和 <a href=\"https://play.google.com/store/apps/details?id=com.proximabeta.nikke\">Android</a>。</p><p>其发行商 Level Infinite 报告称，自 2022 年上线以来下载量已超过 <a href=\"https://press.levelinfinite.com/it-IT/THE-BATTLE-FOR-HUMANITYS-FUTURE-ESCALATES-AS-GODDESS-OF-VICTORY-NIKKE-\">4500 万次</a>，仅 Google Play 的下载量就达到 1000 万次。</p><h2 id=\"sec-1\">恶意启动器脚本提供后门</h2><p>尽管 Level Infinite 尚未披露许多细节，但独立安全研究员 MotherSphere 在 <a href=\"https://gist.github.com/MotherSphere/d6c049a09ba8ac3085c51ee9df24a4e5\">GitHub 上发布的报告</a>称，该事件涉及托管在 Level Infinite 官方内容分发网络（CDN）上的四个 JavaScript 文件。</p><p>据该研究员称，这些文件于 2026 年 9 月 27 日被修改，注入了恶意 JavaScript；每当玩家打开游戏启动器时，这些脚本都会从攻击者控制的服务器下载额外代码。</p><p>注入的代码隐藏在合法的 JavaScript 文件中，并使用混淆手段隐藏恶意代码的下载来源域名 <code>insightjs[.]com</code> 和 <code>insightjs[.]org</code>。</p><p>BleepingComputer 检查了两个被修改的 JavaScript 文件，确认其中包含一个混淆的加载器，旨在从这些域名获取并执行额外代码；如果第一个域名不可用，则会回退到第二个域名。</p><p>根据 MotherSphere 的分析，下载的代码滥用启动器的原生功能，获取并执行名为 insight.bundle 的恶意 LuaJIT 载荷，后者会安装一个称为 K2F 的远程访问代理。</p><p>该后门允许攻击者远程执行命令、浏览和下载本地文件、截取屏幕、收集 NIKKE 账户凭据，以及窃取网页浏览器中存储的信息。</p><p>该恶意软件还支持一条额外命令，用于安装名为 <code>platform_experience_helper.dll</code> 的恶意 Windows DLL；即使游戏启动器关闭，该 DLL 仍可保持活动状态。</p><p>BleepingComputer 分析了上传至 <a href=\"https://www.virustotal.com/gui/file/4bfaf98a6b863fa79554d9eeeb18870c3f92d552d62f4bd35a72d19ea68526af/\">VirusTotal</a> 的一个 DLL 样本中提取的字符串，发现代码表明该恶意软件能够从 MetaMask、Phantom、Coinbase Wallet 等浏览器扩展中窃取加密货币钱包数据。</p><p>该 DLL 包含拦截敏感钱包信息的功能，包括恢复助记词和私钥，可能使攻击者得以窃取加密货币。</p><p>然而，目前尚不清楚攻击者是否在受感染系统上部署了这一额外组件，或是否成功从玩家处窃取了加密货币。</p><p>该研究员声称，Level Infinite 已于 11 月 3 日将三个受影响的 JavaScript 文件替换为干净版本。然而，据称截至 GMT 22:26，第四个文件被篡改的副本仍在向用户提供。</p><p>这表明，在该公司部署客户端更新后，至少有一个遭入侵的脚本可能仍可访问。</p><p>研究人员还分享了入侵指标（IOC），用户可据此检查恶意 Lua agent 是否曾在自己的计算机上执行。</p><p>其中一项指标是 NIKKE 安装目录内 <code>Launcher/intl_service/debug.log</code> 文件中的 <code>k2f_chan registered</code> 字符串。</p><p>该条目表明恶意 Lua agent 已执行，但无法确认 DLL 是否也已加载。</p><p>BleepingComputer 还发现，<code>insightjs[.]org&nbsp;</code>backup 域目前正在提供代码，该代码会在游戏启动器中显示安全警告。</p><p>该警告以英语、中文、日语和韩语显示，告知玩家立即关闭启动器，并在发行商确认问题已解决前不要打开 PC 客户端。</p><figure><img alt=\"Warning about supply chain attack on backup domain\" height=\"600\" src=\"/dailyinfo/media/2c727ca2ce6caa5c.jpg\" srcset=\"/dailyinfo/media/a3e3411b09196f64.jpg 720w, /dailyinfo/media/010631f69ed5923e.jpg 1200w, /dailyinfo/media/2c727ca2ce6caa5c.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"909\">\n<figcaption><strong>关于攻击者备份域名遭到供应链攻击的警告</strong><br>\n<em>来源：BleepingComputer</em></figcaption>\n</figure><p>这条消息证实，这并非该游戏发行商发布的官方公告，因此目前无法确定该域名由谁控制，也无法确定恶意载荷何时被替换为该警告。</p><p>BleepingComputer 已就 MotherSphere 的发现联系 Level Infinite 置评，但截至发布时尚未收到回应。</p><p>可能受影响的玩家应使用更新后的杀毒软件对系统进行完整扫描。</p><p>发现自己的设备已遭入侵者应重新安装 Windows，并使用干净的设备更改密码及其他敏感凭据。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/c132e890d608eb09.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-2\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI agent 会分析邮件意图、上下文和行为，发现网络钓鱼、商务邮件入侵和发票欺诈。</p><p>使用更新后的杀毒软件对 Microsoft 365 或 Google Workspace 进行为期 14 天的只读扫描，看看有哪些威胁得以绕过，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始免费邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","后门","数据窃取","供应链投毒","凭据","https://www.bleepingcomputer.com/news/security/nikke-pc-game-launcher-hacked-to-spread-remote-access-data-stealing-malware/","BleepingComputer",{"_113":114,"_115":-5},"changelogVersion","2026-10-01T08:00","release"]
