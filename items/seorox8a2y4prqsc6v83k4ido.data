[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795221640000,"id","seorox8a2y4prqsc6v83k4ido","title","memtomem-stm 漏洞：未信任记忆数据可突破 Markdown 兼容边界","originalTitle","memtomem-stm: Surfaced memory data can escape the Markdown compatibility boundary","summary","memtomem-stm 项目披露其 surfaced-memory 封装存在结构边界问题：未经信任的长期记忆与工作记忆字段可注入 Markdown 或 HTML 兼容结构，构造的记忆会制造误导性的结构边界或在视觉上隐藏内容。修复方式为将每个不可信字段序列化为惰性单行数据、校验可复制的记忆标识，并固定显式的不可信数据前置说明。原文同时指出，自然语言层面的说服仍属于残余的模型级风险。","reason","source",{"_71":84},"links",{"_59":83},"publishedAt","2026-11-20T23:37:39.000Z","discoveredAt","2026-11-20T23:47:29.993Z","timelineAt","category","vuln","tags",[80,81,72,82],"score",47,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","readingMode","full","author","body","outline",[],"relatedStories",[76],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fBP8gGn_zE6U","reportCount",1,"additionalSourceCount",0,{"_69":74,"_71":75},{"_69":30,"_71":73},{"_69":70,"_71":72},"slug","ai-security","name","AI 安全","漏洞披露","ai-agent","AI Agent 安全",{"_77":78,"_13":79},"publicId","be8236f3-0c52-4ebb-82f1-03dedb1ac7a5","memtomem-stm修复记忆内容越界问题","漏洞","补丁","大模型","https://github.com/advisories/GHSA-43hx-xm7w-3mhj","GitHub 安全公告",{"_86":87,"_88":-5},"changelogVersion","2026-10-01T08:00","release"]
