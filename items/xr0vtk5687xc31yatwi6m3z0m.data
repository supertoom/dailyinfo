[{"_1":2,"_3":4},"root",{"_5":101},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794357645000,"id","xr0vtk5687xc31yatwi6m3z0m","title","SonicWall SSL-VPN SAML 认证绕过漏洞 CVE-2026-19868 已被利用","originalTitle","SonicWall warns of new SSL-VPN MFA bypass flaw exploited in attacks","summary","SonicWall SSL-VPN 的 SAML 认证绕过漏洞 CVE-2026-19868 已被用于攻击，攻击者持有另一种认证方式的有效凭据后，可绕过 SAML 认证控制，包括 SAML 强制启用的 MFA。","reason","材料同时交代了认证绕过条件、补丁范围与 KEV 状态，便于判断受影响部署的处置优先级。","source",{"_74":100},"links",{"_91":99},"publishedAt","2026-11-07T00:00:55.000Z","discoveredAt","2026-11-07T04:38:29.180Z","timelineAt","category","vuln","tags",[95,75,96,97,78,98,80],"score",79,"selected",true,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","Lawrence Abrams","body",{"_61":90,"_91":-5,"_92":93,"_94":37},"outline",[85],"relatedStories",[81],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","f9_hpiVcy3Lo","reportCount",2,"additionalSourceCount",1,{"_72":79,"_74":80},{"_72":77,"_74":78},{"_72":31,"_74":76},{"_72":73,"_74":75},"slug","exploited","name","在野利用","漏洞披露","identity","身份与访问","cisa","CISA",{"_82":83,"_13":84},"publicId","61a4a753-d4b0-4ce4-9160-1e8081d70415","CISA确认SonicWall SAML认证绕过漏洞遭利用",{"_11":86,"_87":88,"_89":65},"sec-1","text","发现现有防御可能遗漏的电子邮件威胁。","level","<p><img alt=\"SonicWall\" height=\"900\" src=\"/dailyinfo/media/25b9e786bab8f911.jpg\" srcset=\"/dailyinfo/media/fba6c3630f1054df.jpg 720w, /dailyinfo/media/7bdd61ece5755a7c.jpg 1200w, /dailyinfo/media/25b9e786bab8f911.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>SonicWall 已发布安全更新，修复了 SonicOS 防火墙中的七个漏洞，其中包括一个已在攻击中被利用的 SSL-VPN 身份验证绕过漏洞。</p><p>该漏洞编号为 CVE-2026-19868，允许拥有另一种身份验证方法有效凭据的攻击者绕过 SAML 身份验证控制，绕过范围可能包括由 SAML 强制执行的多因素身份验证（MFA）。</p><p>该漏洞的 CVSS 严重性评分为 7.1，仅影响配置为使用 SAML 身份验证的 SonicOS SSL-VPN 服务。</p><p><a href=\"https://www.wiz.io/lp/securing-ai-agents-101?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY26Q3_INB_FORM_Securing-AI-Agents-101&amp;sfcid=701Py00000RTEWMIA5&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AI-Agents-101\"><img src=\"/dailyinfo/media/92a0f16103a12998.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>SonicWall 在周五发布的<a href=\"https://psirt.global.sonicwall.com/vuln-detail/SNWLID-2026-0014\">安全公告</a>中警告称，其已调查一份关于该漏洞在攻击中被利用的报告，并敦促客户安装最新安全更新。</p><p>公司警告称：“SonicWall PSIRT 已调查了一份报告，该报告称此漏洞可能已被利用。强烈敦促客户尽快升级至最新版本，以缓解相关风险。”</p><p>The Electronic Office 的 Ryan Harris 发现并报告了该漏洞。</p><p>尽管 SonicWall 尚未披露有关所报告利用活动的详细信息，美国网络安全和基础设施安全局（CISA）已将 CVE-2026-19868 加入其<a href=\"https://www.cisa.gov/known-exploited-vulnerabilities-catalog\">已知被利用漏洞（KEV）目录</a>，确认该漏洞已在真实攻击环境中被利用。</p><p>CISA 已命令联邦文职行政机构在 2026 年 11 月 20 日之前保护受影响的系统。</p><p>该公告还修复了 SonicOS 中的另外六个漏洞，其中包括两个严重性评分为 8.8 的管理界面漏洞；在特定条件下，这些漏洞允许未认证攻击者执行未经授权的操作。</p><p>其余漏洞包括 SSL-VPN 和 TACACS+ 服务中的预身份验证缓冲区溢出漏洞，可能导致拒绝服务，以及一个影响虚拟设备的弱密码哈希漏洞。</p><p>这些漏洞影响 SonicOS Gen7 7.3.3-7015 及更早版本，以及 Gen8 8.2.2-8015 及更早版本。SonicWall 已在 7.3.4-7013 和 8.2.3-8015 版本中修复这些问题，并表示无法提供替代解决方案。</p><p>此次警告发布于一系列针对 SonicWall SMA1000 安全远程访问设备的攻击之后。</p><p>10 月，安全研究人员<a href=\"https://www.bleepingcomputer.com/news/security/max-severity-sonicwall-sma1000-flaw-now-exploited-in-attacks/\">检测到针对 CVE-2026-102255 的利用尝试</a>；这是一个最高严重性漏洞，可能允许未认证攻击者访问内部功能并执行未经授权的操作。</p><p>这些尝试发生在 9 月攻击之后；此前，攻击者串联利用了两个 SMA1000 零日漏洞以实现远程代码执行，7 月的攻击则利用了另外两个零日漏洞，在存在漏洞的设备上部署了恶意软件。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/ec08be135363bed0.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体会分析电子邮件意图、上下文和行为，揭示网络钓鱼、商务电子邮件入侵和发票欺诈。</p><p>对 Microsoft 365 或 Google Workspace 进行为期 14 天的只读扫描，看看有哪些威胁正在穿透，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始您的免费电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","漏洞","补丁","漏洞利用","SonicWall","https://www.bleepingcomputer.com/news/security/sonicwall-warns-of-new-ssl-vpn-mfa-bypass-flaw-exploited-in-attacks/","BleepingComputer",{"_102":103,"_104":-5},"changelogVersion","2026-10-01T08:00","release"]
