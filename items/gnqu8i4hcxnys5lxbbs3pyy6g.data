[{"_1":2,"_3":4},"root",{"_5":92},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1794444093000,"id","gnqu8i4hcxnys5lxbbs3pyy6g","title","Microsoft 11月安全更新修复1094个安全问题，CVE-2026-124194已遭在野利用","originalTitle","【安全更新】微软11月安全更新多个产品高危漏洞通告","summary","Microsoft 于11月11日发布安全更新，修复1094个安全问题，涉及 Windows、Microsoft Office、Microsoft Outlook、Microsoft Exchange Server、Microsoft SQL Server 等产品，其中 Critical 漏洞63个、Important 漏洞1029个、Moderate 漏洞2个。","reason","source",{"_66":91},"links",{"_82":90},"publishedAt","2026-11-11T11:44:00.000Z","discoveredAt","2026-11-11T17:14:09.125Z","timelineAt","category","vuln","tags",[85,67,86,87,88,89],"score",82,"selected",false,"channel","news","story","x","readingMode","full","author","body",{"_58":81,"_82":-5,"_83":82,"_84":54},"outline",[75],"relatedStories",[],"topics",[59,60,61,62,63],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","zh",{"_64":73,"_66":74},{"_64":71,"_66":72},{"_64":69,"_66":70},{"_64":30,"_66":68},{"_64":65,"_66":67},"slug","exploited","name","在野利用","漏洞披露","email","邮件与钓鱼","kernel","内核与系统","microsoft","Microsoft / 微软",{"_11":76,"_77":78,"_79":80},"sec-1","text","4.1 补丁更新","level",3,"<p><span>NS-CERT</span> <span>2026-11-11 19:44</span> <span>四川</span></p><p><img src=\"/dailyinfo/media/ed3f5c99fd422dca.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>11月11日，绿盟科技CERT监测到微软发布11月安全更新补丁，修复了1094个安全问题，涉及Windows、Microsoft Office、Microsoft Outlook、Microsoft Exchange Server、Microsoft SQL Server等广泛使用的产品。</p><p><strong><span>通告编号 NS-2026-0028</span></strong></p><p><span><span>2026-11-11</span></span></p><table><tbody><tr><td><strong><span><span>TAG：</span></span></strong></td><td><p><strong><span><span>安全更新、Windows、Office、Outlook、Exchange Server</span></span></strong></p></td></tr><tr><td><strong><span><span>漏洞危害：</span></span></strong></td><td><p><strong><span>攻击者利用本次安全更新中的漏洞，可造成权限提升、远程代码执行等</span></strong></p></td></tr><tr><td><strong><span><span>版本：</span></span></strong></td><td><p><strong><span>1.0</span></strong></p></td></tr></tbody></table><p><strong><span>1</span></strong></p><p><strong><span><span>漏洞概述</span></span></strong></p><p><span>11月11日，绿盟科技CERT监测到微软发布11月安全更新补丁，修复了1094个安全问题，涉及Windows、Microsoft Office、Microsoft Outlook、Microsoft Exchange Server、Microsoft SQL Server等广泛使用的产品，其中包括权限提升、远程代码执行等高危漏洞类型。</span></p><p><span>本月微软月度更新修复的漏洞中，严重程度为关键（Critical）的漏洞有63个，重要（Important）漏洞有1029个，中等（Moderate）漏洞有2个。其中包括1个已检测到在野利用的漏洞：</span></p><p><span>Microsoft Outlook欺骗漏洞（CVE-2026-124194）</span></p><p><span>请相关用户尽快更新补丁进行防护，完整漏洞列表请参考附录。</span></p><p><span>参考链接：</span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/releaseNote/2026-Nov\">https://msrc.microsoft.com/update-guide/releaseNote/2026-Nov</a></span></p><p><strong><span>SEE MORE →</span></strong></p><p><span><strong><span>2</span></strong></span><strong><span>重点漏洞简述</span></strong></p><p><span>根据产品流行度和漏洞重要性筛选出此次更新中包含影响较大的漏洞，请相关用户重点进行关注：</span></p><p><strong><span>Microsoft Outlook欺骗漏洞（CVE-2026-124194）：</span></strong></p><p><span>由于Outlook未对潜在不安全操作显示警告，未经身份验证的攻击者可发送特制消息文件并诱使用户打开，使Outlook在未显示外部内容警告的情况下连接攻击者控制的网络位置，从而泄露用户NTLMv2哈希并冒充用户。该漏洞存在在野利用，CVSS评分6.5。</span></p><p><span>官方通告链接：</span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-124194\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-124194</a></span></p><p><strong><span>Windows Search远程代码执行漏洞（CVE-2026-116928）：</span></strong></p><p><span>由于Windows Search组件存在越界写入缺陷，未经身份验证的攻击者可向Exchange服务器发送包含特制附件的电子邮件，使Exchange在建立索引时自动处理附件，无需收件人打开邮件或附件，从而实现远程代码执行。CVSS评分9.8。</span></p><p><span>官方通告链接：</span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-116928\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-116928</a></span></p><p><strong><span>Windows LDAP远程代码执行漏洞（CVE-2026-119958）：</span></strong></p><p><span>由于Windows轻量级目录访问协议（LDAP）存在越界写入缺陷，未经身份验证的攻击者可通过网络发送一组特制LDAP调用，从而在LDAP服务上下文中执行任意代码。CVSS评分9.8。</span></p><p><span>官方通告链接：</span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-119958\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-119958</a></span></p><p><strong><span>Windows Schannel远程代码执行漏洞（CVE-2026-119952）：</span></strong></p><p><span>由于Windows安全通道（Schannel）存在可观察的时序差异，未经身份验证的攻击者可在特定协议设置或配置条件下向受影响服务发送特制数据包，从而执行任意代码。CVSS评分8.1。</span></p><p><span>官方通告链接：</span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-119952\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-119952</a></span></p><p><strong><span>Windows Active Directory域服务远程代码执行漏洞（CVE-2026-118146）：</span></strong></p><p><span>由于Active Directory域服务存在授权校验不当缺陷，具有低权限的认证攻击者可向受影响服务器发送特制请求，从而在服务器上执行任意代码。CVSS评分8.8。</span></p><p><span>官方通告链接：</span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-118146\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-118146</a></span></p><p><strong><span>Active Directory域服务权限提升漏洞（CVE-2026-118148）：</span></strong></p><p><span>由于Active Directory域服务存在身份验证和授权校验不当缺陷，具有低权限的认证攻击者可在满足特定条件时通过网络利用该漏洞，从而提升权限。CVSS评分7.5。</span></p><p><span>官方通告链接：</span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-118148\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-118148</a></span></p><p><strong><span>Windows Kerberos权限提升漏洞（CVE-2026-85844）：</span></strong></p><p><span>由于Windows Kerberos存在通过备用路径或通道绕过身份验证的缺陷，未经身份验证的攻击者可通过网络利用该漏洞，从而提升权限。CVSS评分9.8。</span></p><p><span>官方通告链接：</span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-85844\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-85844</a></span></p><p><strong><span>Microsoft Exchange Server远程代码执行漏洞（CVE-2026-118207）：</span></strong></p><p><span>由于Microsoft Exchange Server存在输入验证及名称或引用解析不当缺陷，具有低权限的认证攻击者可发送特制请求，从而在服务器上执行任意代码。CVSS评分8.8。</span></p><p><span>官方通告链接：</span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-118207\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-118207</a></span></p><p><strong><span>Windows网络地址转换（NAT）远程代码执行漏洞（CVE-2026-113862）：</span></strong></p><p><span>由于Windows网络地址转换（NAT）组件存在释放后重用缺陷，未经身份验证的远程攻击者可在攻击复杂度较高的条件下通过网络利用该漏洞，从而执行任意代码。CVSS评分8.1。</span></p><p><span>官方通告链接：</span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-113862\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-113862</a></span></p><p><strong><span>Windows DNS远程代码执行漏洞（CVE-2026-88218）：</span></strong></p><p><span>由于Windows DNS组件在管理内存指针时存在双重释放缺陷，未经身份验证的远程攻击者可通过网络发送特制数据请求包触发内存损坏，从而执行任意代码。CVSS评分9.8。</span></p><p><span>官方通告链接：</span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-88218\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-88218</a></span></p><p><strong><span>Windows DHCP Server远程代码执行漏洞（CVE-2026-88243）：</span></strong></p><p><span>由于Windows DHCP Server在处理入站服务请求时存在越界读取缺陷，未经身份验证的攻击者可通过网络向目标主机发送特制报文触发内存越界，从而执行任意代码。CVSS评分9.8。</span></p><p><span>官方通告链接：</span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-88243\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-88243</a></span></p><p><strong><span>Windows iSCSI远程代码执行漏洞（CVE-2026-88234）：</span></strong></p><p><span>由于Windows iSCSI存储驱动程序在解析释放控制块等底层对象时未安全校验内存指针，存在释放后重用或无效内存释放缺陷，未经身份验证的攻击者可通过网络向目标端口发送特制存储控制指令，触发内核堆内存损坏，从而执行任意代码。CVSS评分9.8。</span></p><p><span>官方通告链接：</span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-88234\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-88234</a></span></p><p><strong><span>Windows虚拟筛选平台（VFP）远程代码执行漏洞（CVE-2026-95962）:</span></strong></p><p><span>由于Windows虚拟筛选平台（VFP）驱动程序在解析或调度网络数据包及上下文资源时未妥善管理指针生命周期，存在释放后重用缺陷，未经身份验证的攻击者可通过网络向目标环境发送特制流量触发内存损坏，从而执行任意代码。CVSS评分9.0。</span></p><p><span>官方通告链接：</span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-95962\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-95962</a></span></p><p><strong><span>Microsoft DirectMusic远程代码执行漏洞（CVE-2026-95882/CVE-2026-95901）：</span></strong></p><p><span>由于Microsoft DirectMusic存在栈缓冲区溢出和双重释放缺陷，未经身份验证的攻击者可通过网络向目标主机发送特制流媒体数据，触发内存损坏，从而执行任意代码。CVSS评分9.8。</span></p><p><span>官方通告链接：</span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-95882\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-95882</a></span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-95901\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-95901</a></span></p><p><strong><span>Microsoft Color Management远程代码执行漏洞（CVE-2026-96067/CVE-2026-96078）：</span></strong></p><p><span>由于Microsoft Color Management存在整数溢出或回绕，以及伴随整数下溢的堆缓冲区溢出缺陷，未经身份验证的攻击者可通过向目标主机发送特制图像或色彩配置文件，从而执行任意代码。CVSS评分9.8。</span></p><p><span>官方通告链接：</span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-96067\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-96067</a></span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-96078\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-96078</a></span></p><p><strong><span>Microsoft Windows Media Foundation远程代码执行漏洞（CVE-2026-96157）：</span></strong></p><p><span>由于Windows Media Foundation存在堆缓冲区溢出缺陷，未经身份验证的攻击者可分发特制办公文档，并诱使用户在本地应用程序中打开或预览，从而执行任意代码。CVSS评分9.8。</span></p><p><span>官方通告链接：</span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-96157\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-96157</a></span></p><p><strong><span>Windows Xbox Live Networking Service远程代码执行漏洞（CVE-2026-112967）：</span></strong></p><p><span>由于Windows Xbox Live Networking Service存在堆缓冲区溢出缺陷，相邻网络中未经身份验证的攻击者可通过调用任意端点，从而执行任意代码。CVSS评分9.8。</span></p><p><span>官方通告链接：</span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-112967\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-112967</a></span></p><p><strong><span>Microsoft SharePoint Server权限提升漏洞（CVE-2026-120002）：</span></strong></p><p><span>由于Microsoft SharePoint Server存在授权校验不当缺陷，具有低权限的认证攻击者可发送特制请求绕过安全边界，从而在受影响服务器上提升权限。CVSS评分9.9。</span></p><p><span>官方通告链接：</span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-120002\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-120002</a></span></p><p><strong><span>Microsoft Office SharePoint欺骗漏洞（CVE-2026-109454）：</span></strong></p><p><span>由于Microsoft Office SharePoint在网页生成过程中对输入中和不当，存在跨站脚本缺陷，具有低权限的认证攻击者可向目标站点注入特制恶意脚本，并诱使受害者在浏览器中访问受影响页面，从而在受害者会话上下文中执行任意代码或实施欺骗攻击。CVSS评分9.0。</span></p><p><span>官方通告链接：</span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-109454\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-109454</a></span></p><p><strong><span>Azure DevOps Server远程代码执行漏洞（CVE-2026-109467）：</span></strong></p><p><span>由于Azure DevOps Server存在身份验证不当缺陷，具有低权限的认证攻击者可向目标应用接口发送特制控制指令，绕过安全防护，从而在受影响主机上执行任意代码。CVSS评分9.9。</span></p><p><span>官方通告链接：</span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-109467\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-109467</a></span></p><p><strong><span>Azure OpenAI权限提升漏洞（CVE-2026-119990）：</span></strong></p><p><span>由于Azure OpenAI关键功能缺少身份验证，未经身份验证的攻击者可向云端应用程序接口发送特制访问请求，绕过安全防护机制，从而在受影响的托管云服务环境中提升权限。CVSS评分9.8。</span></p><p><span>官方通告链接：</span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-119990\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-119990</a></span></p><p><strong><span>Microsoft Graph/Azure PIM权限提升漏洞（CVE-2026-114162）：</span></strong></p><p><span>由于Microsoft Graph与Azure Privileged Identity Management（PIM）存在授权校验不当缺陷，控制具有受影响“角色移除”权限应用的攻击者可发送特制请求分配特权目录角色，从而将权限提升至全局管理员。CVSS评分9.1。</span></p><p><span>官方通告链接：</span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-114162\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-114162</a></span></p><p><strong><span>ASP.NET Core权限提升漏洞（CVE-2026-114146）：</span></strong></p><p><span>由于ASP.NET Core存在授权校验不当缺陷，具有低权限的认证攻击者可通过网络发送特制请求，绕过授权限制，从而在受影响的应用环境中提升权限。CVSS评分9.0。</span></p><p><span>官方通告链接：</span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-114146\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-114146</a></span></p><p><strong><span>Microsoft SQL Server远程代码执行漏洞（CVE-2026-116945）：</span></strong></p><p><span>由于Microsoft SQL Server存在堆缓冲区溢出缺陷，未经身份验证的攻击者可向目标服务发送特制数据包触发内存损坏，从而在服务器上执行任意代码。CVSS评分9.8。</span></p><p><span>官方通告链接：</span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-116945\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-116945</a></span></p><p><strong><span>Visual Studio Code远程代码执行漏洞（CVE-2026-120779）：</span></strong></p><p><span>由于Visual Studio Code存在代码生成控制不当缺陷，控制远程MCP服务器的未经身份验证攻击者可诱使用户将VS Code连接至该服务器，并点击通知中的特制链接，从而以当前用户权限执行任意代码。CVSS评分9.6。</span></p><p><span>官方通告链接：</span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-120779\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-120779</a></span></p><p><strong><span>Microsoft Defender远程代码执行漏洞（CVE-2026-122194）：</span></strong></p><p><span>由于Microsoft Defender恶意软件保护引擎存在空指针解引用缺陷，未经身份验证的攻击者可发送特制文件并诱使用户触发解析，从而执行任意代码。CVSS评分8.8。</span></p><p><span>官方通告链接：</span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-122194\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-122194</a></span></p><p><strong><span>Microsoft Office Outlook远程代码执行漏洞（CVE-2026-110043/CVE-2026-110068/CVE-2026-111309）：</span></strong></p><p><span>由于Microsoft Office Outlook组件存在堆缓冲区溢出、无效指针或引用释放等内存安全缺陷，未经身份验证的攻击者可发送特制电子邮件，通过预览窗格触发漏洞，无需用户实际打开邮件，从而执行任意代码。CVSS评分8.8。</span></p><p><span>官方通告链接：</span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-110043\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-110043</a></span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-110068\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-110068</a></span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-111309\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-111309</a></span></p><p><strong><span>Microsoft Office Word远程代码执行漏洞（CVE-2026-111285）：</span></strong></p><p><span>由于Microsoft Office Word组件在处理特定输入时存在内存溢出缺陷，未经身份验证的攻击者可向目标发送特制文档，并诱使用户预览或打开，从而在当前用户权限上下文中执行任意代码。CVSS评分8.8。</span></p><p><span>官方通告链接：</span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/VE-2026-111285\">https://msrc.microsoft.com/update-guide/vulnerability/VE-2026-111285</a></span></p><p><strong><span>Microsoft Office远程代码执行漏洞（CVE-2026-111289/CVE-2026-120003）：</span></strong></p><p><span>由于Microsoft Office组件在解析特定文件时存在释放后重用和堆缓冲区溢出等内存安全缺陷，未经身份验证的攻击者可向目标发送特制文档并诱使用户打开，从而执行任意代码。CVSS评分8.8。</span></p><p><span>官方通告链接：</span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-111289\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-111289</a></span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-120003\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-120003</a></span></p><p><strong><span>Microsoft Color Management远程代码执行漏洞（CVE-2026-96067/CVE-2026-96078）：</span></strong></p><p><span>由于Microsoft Color Management存在整数溢出或回绕，以及伴随整数下溢的堆缓冲区溢出缺陷，未经身份验证的攻击者可通过向目标主机发送特制图像或色彩配置文件，从而执行任意代码。CVSS评分9.8。</span></p><p><span>官方通告链接：</span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-96067\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-96067</a></span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-96078\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-96078</a></span></p><p><strong><span>Microsoft DirectMusic远程代码执行漏洞（CVE-2026-95882/CVE-2026-95901）：</span></strong></p><p><span>由于Microsoft DirectMusic存在栈缓冲区溢出和双重释放缺陷，未经身份验证的攻击者可通过网络向目标主机发送特制流媒体数据，触发内存损坏，从而执行任意代码。CVSS评分9.8。</span></p><p><span>官方通告链接：</span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-95882\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-95882</a></span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-95901\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-95901</a></span></p><p><strong><span>Microsoft SharePoint Server权限提升漏洞（CVE-2026-80095）：</span></strong></p><p><span>由于Microsoft Office SharePoint在网页生成过程中对输入中和不当，存在跨站脚本缺陷，具有基础账户权限的攻击者可向服务器注入特制脚本内容，并诱使管理员或普通用户浏览相应页面，从而在受害者会话上下文中执行恶意脚本、窃取敏感凭据或提升访问权限。CVSS评分9.0。</span></p><p><span>官方通告链接：</span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-80095\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-80095</a></span></p><p><span><strong><span>3</span></strong></span><strong><span>影响范围</span></strong></p><p><span>以下为部分重点关注漏洞的受影响产品版本，其他漏洞影响产品范围请参阅官方通告链接。</span></p><p><span>漏洞编号</span></p><p><span>受影响产品版本</span></p><p><span>CVE-2026-124194</span><span><br></span><span>CVE-2026-110043</span><span><br></span><span>CVE-2026-111309</span></p><p><span>Microsoft 365 Apps for Enterprise for 32-bit Systems</span><span><br></span><span>Microsoft 365 Apps for Enterprise for 64-bit Systems</span><span><br></span><span>Microsoft Office LTSC 2021 for 32-bit editions</span><span><b