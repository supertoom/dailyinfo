[{"_1":2,"_3":4},"root",{"_5":101},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1794616832000,"id","p9mnajvale4nc1xu4o2dinr5e","title","CISA 将 WordPress 远程代码执行漏洞 CVE-2026-119977 加入 KEV 目录","originalTitle","U.S. CISA adds WordPress flaw to its Known Exploited Vulnerabilities catalog","summary","CISA 将 WordPress 远程代码执行漏洞 CVE-2026-119977 加入 KEV 目录，该漏洞 CVSS 8.1，影响 WordPress 4.7 至 7.1.3。","reason","source",{"_74":100},"links",{"_90":99},"publishedAt","2026-11-04T09:16:37.000Z","discoveredAt","2026-11-04T10:33:24.903Z","timelineAt","category","vuln","tags",[96,75,97,98,78],"score",79,"selected",true,"channel","news","story",{"_80":81,"_13":82},"x","sameEvent",{"_11":94,"_13":95},"readingMode","full","author","Pierluigi Paganini","body",{"_62":89,"_90":-5,"_91":92,"_93":36},"outline",[83],"relatedStories",[79],"topics",[69,70,71],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","fI0wIPZp4Kwk","reportCount",5,"additionalSourceCount",4,{"_72":77,"_74":78},{"_72":30,"_74":76},{"_72":73,"_74":75},"slug","exploited","name","在野利用","漏洞披露","cisa","CISA",{"_80":81,"_13":82},"publicId","1219bb0c-7c46-49ac-8b88-3829783c0451","WordPress RCE漏洞确认遭在野利用",{"_11":84,"_85":86,"_87":88},"sec-1","text","美国网络安全和基础设施安全局（CISA）将 WordPress&nbsp;漏洞加入其已知被利用漏洞目录。","level",2,"<h2 id=\"sec-1\">美国网络安全和基础设施安全局（CISA）将 WordPress&nbsp;漏洞加入其已知被利用漏洞目录。</h2><p>美国网络安全和基础设施安全局（CISA）&nbsp;<a href=\"https://www.cisa.gov/news-events/alerts/2026/11/03/cisa-adds-one-known-exploited-vulnerability-catalog\">将</a>一个追踪编号为 <a href=\"https://www.cve.org/CVERecord?id=CVE-2026-119977\">CVE-2026-119977</a> 的 WordPress 漏洞（CVSS 评分为 8.1）加入其 <a href=\"https://www.cisa.gov/known-exploited-vulnerabilities-catalog\">已知被利用漏洞（KEV）目录</a>。</p><p>CVE-2026-119977 是一个高危远程代码执行漏洞，影响 WordPress 4.7 至 7.1.3 版本。它源于核心更新期间使用的、可预测且可通过网络访问的暂存目录。</p><p>未经身份验证的攻击者可以利用竞态条件，在更新正在进行时在服务器上执行恶意代码，从而可能入侵网站。WordPress 已在 7.1.4 版本中修复该漏洞。</p><p>WordPress 发布安全更新后不久，威胁行为者便开始扫描 CVE-2026-119977。Wordfence 记录到，在最初 21 小时内，有超过 18,500 次请求针对易受攻击的暂存安装程序路径。不过，这些数字记录的是利用尝试，而非已确认成功入侵。</p><p><em>“Wordfence 遥测数据显示，威胁行为者已经在积极尝试利用该漏洞。我们的新防火墙规则部署后仅 9 分钟便出现了首个匹配。在最初 21 小时内，我们记录到超过 18,500 次针对暂存 <code>setup-config.php</code> 安装程序路径的请求。”Wordfence 发布的<a href=\"https://www.wordfence.com/blog/2026/10/wordpress-7-1-4-security-release-rce/\">报告</a>中写道。</em></p><p><em>“两个最大的来源持续轮询少量网站组约 14.5 小时，这种行为与试图抓住短暂升级窗口相符。其他来源则测试了许多暂存目录和版本名称的变体。”</em></p><p>根据&nbsp;<a href=\"https://cyber.dhs.gov/bod/22-01/\">约束性运营指令（BOD）22-01：降低已知被利用漏洞的重大风险</a>，FCEB 机构必须在截止日期前处理已识别的漏洞，以保护其网络免受利用目录中漏洞发动的攻击。</p><p>专家还建议私营组织审查&nbsp;<a href=\"https://www.cisa.gov/known-exploited-vulnerabilities-catalog\">目录</a>，并处理其基础设施中的漏洞。</p><p>CISA 要求联邦机构在&nbsp;2026 年 11 月 6 日前修复该漏洞。</p><p><strong>在 Twitter 上关注我：&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;以及&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;和&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a><strong></strong></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>（</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;黑客攻击，&nbsp;<a href=\"https://www.cve.org/CVERecord?id=CVE-2026-119977\">CVE-2026-119977</a>）</strong></p>","original","zhKind","translation","complete","g1m9pm4evpt7khouqrj2dxktu","CISA 确认攻击者利用 WordPress Core 漏洞 CVE-2026-119977 接管网站","漏洞","补丁","漏洞利用","https://securityaffairs.com/202394/security/u-s-cisa-adds-wordpress-flaw-to-its-known-exploited-vulnerabilities-catalog-2.html","Security Affairs",{"_102":103,"_104":-5},"changelogVersion","2026-10-01T08:00","release"]
