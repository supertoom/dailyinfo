[{"_1":2,"_3":4},"root",{"_5":115},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1793621626000,"id","tqj4dxtikwan2dwzgf1hpjvys","title","Ivanti Connect Secure 三个零日漏洞已被链式利用，CVE-2026-111357 与 CVE-2026-118527 纳入 KEV","originalTitle","Additional Ivanti Connect Secure zero-days exploited in the wild (CVE-2026-111357, CVE-2026-118527)","summary","Ivanti Connect Secure 的 CVE-2026-111357、CVE-2026-118527 与 CVE-2026-104935 已被链式利用，可获取未认证 root 权限并窃取 Windows LAPS 密码和 BitLocker 恢复密钥，UTA0576 自 2026 年 10 月 3 日起攻击运行 22.8R2.4 的设备，影响客户数量有限。","reason","材料串联三个 Ivanti Connect Secure 零日漏洞的在野利用链，并给出受影响版本、修复版本及排查证据，便于评估暴露与应急处置需求。","source",{"_73":114},"links",{"_104":113},"publishedAt","2026-11-02T11:04:08.000Z","discoveredAt","2026-11-02T11:48:33.412Z","timelineAt","category","vuln","tags",[108,74,109,110,77,111,46,112],"score",86,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","Rapid7","body",{"_61":103,"_104":-5,"_105":106,"_107":37},"outline",[82,83,84,85,86,87],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fBXRC7O56Fow","reportCount",2,"additionalSourceCount",1,{"_71":76,"_73":77},{"_71":31,"_73":75},{"_71":72,"_73":74},"slug","exploited","name","在野利用","漏洞披露","incident","应急响应",{"_79":80,"_13":81},"publicId","7b68ec92-29a4-4b08-8b7d-6c1631d5b488","Ivanti三项零日漏洞被串联利用",{"_11":101,"_89":102,"_91":65},{"_11":99,"_89":100,"_91":65},{"_11":97,"_89":98,"_91":94},{"_11":95,"_89":96,"_91":65},{"_11":92,"_89":93,"_91":94},{"_11":88,"_89":90,"_91":65},"sec-6","text","更新","level","sec-5","Exposure Command、Vulnerability Management 和 Nexpose",3,"sec-4","Rapid7 客户","sec-3","工件、证据来源和 IOC","sec-2","缓解指南","sec-1","概述","<h2 id=\"sec-1\">概述</h2><p><span>2026 年 10 月 29 日，Ivanti </span><a href=\"https://hub.ivanti.com/s/article/Security-Advisory-Ivanti-Connect-Secure-CVE-2026-104935?language=en_US\"><span>更新了其针对 Ivanti Connect Secure (ICS) 的安全公告</span></a><span>，将另外两个漏洞纳入其中，并发布了针对这两个漏洞的修复。Ivanti 将 </span><a href=\"https://www.rapid7.com/db/vulnerabilities/cve-2026-111357/\"><span>CVE-2026-111357</span></a><span>（关键功能缺少身份验证漏洞，</span><a href=\"https://cwe.mitre.org/data/definitions/306.html\"><span>CWE-306</span></a><span>）的 CVSSv3.1 评分定为 </span><a href=\"https://www.first.org/cvss/calculator/3.1#CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:C/C:H/I:H/A:H\"><span>8.8</span></a><span>；该漏洞允许本地已认证攻击者提升权限。</span><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-118527\"><span>CVE-2026-118527</span></a><span> 被归类为生成可预测的数字或标识符（</span><a href=\"https://cwe.mitre.org/data/definitions/340.html\"><span>CWE-340</span></a><span>），Ivanti 给出的 CVSSv3.0 评分为 </span><a href=\"https://www.first.org/cvss/calculator/3.0#CVSS:3.0/AV:N/AC:L/PR:L/UI:N/S:U/C:N/I:L/A:N\"><span>4.3</span></a><span>；据 </span><a href=\"https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2026-118527\"><span>CISA 的 KEV 条目</span></a><span>称，该漏洞允许远程已认证攻击者将攻击者控制的内容上传至磁盘上的已知位置。</span></p><p><span>据 Ivanti 表示，在披露之前已经发生了在野利用；当这些漏洞与 </span><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-104935\"><span>CVE-2026-104935</span></a><span>（通过欺骗绕过身份验证，</span><a href=\"https://cwe.mitre.org/data/definitions/290.html\"><span>CWE-290</span></a><span>）串联利用时，影响了数量有限的客户。Rapid7 </span><a href=\"https://www.rapid7.com/blog/post/etr-ivanti-connect-secure-zero-day-exploited-in-the-wild-cve-2026-104935/\"><span>报道了 2026 年 10 月 13 日的初始披露</span></a><span>，当时 CVE-2026-104935 的修复已经可用，但权限提升组件仍未修补。现在这三个漏洞均已有可用修复。</span></p><p><span>2026 年 10 月 30 日，基于存在积极利用活动的证据，CVE-2026-111357 和 CVE-2026-118527 被加入美国网络安全和基础设施安全局 (CISA) 的</span><a href=\"https://www.cisa.gov/known-exploited-vulnerabilities-catalog\"><span>已知被利用漏洞</span></a><span> (KEV) 列表。</span></p><p><span>以下评分和分类来自 Ivanti 更新后的安全公告：</span></p><table><thead><tr><th><p><span><strong>CVE</strong></span></p></th><th><p><span><strong>Ivanti CVSS 评分</strong></span></p></th><th><p><span><strong>CWE</strong></span></p></th><th><p><span><strong>影响</strong></span></p></th></tr></thead><tbody><tr><td><p><span>CVE-2026-104935</span></p></td><td><p><span>8.6 (High), CVSSv3.0</span></p></td><td><p><span>CWE-290</span></p></td><td><p><span>远程未认证命令执行</span></p></td></tr><tr><td><p><span>CVE-2026-111357</span></p></td><td><p><span>8.8 (High), CVSSv3.1</span></p></td><td><p><span>CWE-306, CWE-862, CWE-345</span></p></td><td><p><span>本地已认证权限提升</span></p></td></tr><tr><td><p><span>CVE-2026-118527</span></p></td><td><p><span>4.3 (Medium), CVSSv3.0</span></p></td><td><p><span>CWE-340</span></p></td><td><p><span>远程已认证文件上传至已知路径</span></p></td></tr></tbody></table><p><span>注意：</span><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-111357\"><span>CVE 记录</span></a><span>和 Rapid7 的漏洞数据库将 CVE-2026-111357 评为 </span><a href=\"https://www.first.org/cvss/calculator/3.1#CVSS:3.1/AV:L/AC:H/PR:L/UI:N/S:U/C:H/I:H/A:H\"><span>7.0</span></a><span>，攻击复杂度高且范围不变。Ivanti 评估认为攻击复杂度低且范围已改变，因此给出 8.8 分。下表采用 Ivanti 的评分和分类。</span></p><p><span>Volexity 在其</span><a href=\"https://www.volexity.com/blog/2026/10/13/a-series-of-unauthenticated-events-chained-exploitation-of-ivanti-connect-secure-zero-days/\"><span>调查</span></a><span>中报告称，自 2026 年 10 月 3 日起，UTA0576 使用漏洞利用链获取了运行 </span><span>22.8R2.4</span><span> 的设备的未认证 root 访问权限。其报告指出 CVE-2026-104935 和 CVE-2026-111357；Ivanti 更新后的安全公告将 CVE-2026-118527 标识为该利用链的另一个组件。Volexity 观察到凭据窃取行为，以及针对 Windows LAPS 密码和 BitLocker 恢复密钥的 Active Directory 查询。</span></p><p><span>尽管各项 CVSS 评分不同，但其综合影响仍需紧急修复。Ivanti Connect Secure 是一款部署在网络边缘的企业 VPN 解决方案，过去曾多次遭零日漏洞利用，包括在 </span><a href=\"https://www.rapid7.com/blog/post/2024/01/11/etr-zero-day-exploitation-of-ivanti-connect-secure-and-policy-secure-gateways/\"><span>2024</span></a><span> 年和 </span><a href=\"https://www.rapid7.com/blog/post/2025/01/08/etr-cve-2025-0282-ivanti-connect-secure-zero-day-exploited-in-the-wild/\"><span>2025</span></a><span> 年。</span></p><h2 id=\"sec-2\">缓解指南</h2><p><span>Rapid7 建议在正常补丁周期之外紧急应用现有更新。10 月 13 日发布的 </span><span>25.1.1.2</span><span> 和 </span><span>22.8R2.5</span><span> 修复并未修复 CVE-2026-111357 或 CVE-2026-118527。</span></p><table><thead><tr><th><p><span><strong>CVE</strong></span></p></th><th><p><span><strong>受影响版本</strong></span></p></th><th><p><span><strong>修复版本</strong></span></p></th></tr></thead><tbody><tr><td><p><span>CVE-2026-111357 和 CVE-2026-118527</span></p></td><td><p><span>25.1.1.2</span><span> 及更早版本</span></p></td><td><p><span>25.1.1.3</span></p></td></tr><tr><td><p><span>CVE-2026-111357 和 CVE-2026-118527</span></p></td><td><p><span>22.8R2.5</span><span> 及更早版本</span></p></td><td><p><span>22.8R2.6</span></p></td></tr><tr><td><p><span>CVE-2026-104935</span></p></td><td><p><span>25.1.1.1</span><span> 及更早版本</span></p></td><td><p><span>25.1.1.2</span></p></td></tr><tr><td><p><span>CVE-2026-104935</span></p></td><td><p><span>25.1.2.2</span><span> 及更早版本</span></p></td><td><p><span>25.1.3.0</span><span>, </span><span>25.1.3.1</span></p></td></tr><tr><td><p><span>CVE-2026-104935</span></p></td><td><p><span>22.8R2.4</span><span> 及更早版本</span></p></td><td><p><span>22.8R2.5</span></p></td></tr></tbody></table><p><span>Ivanti 建议从 </span><span>22.8.X</span><span> 升级到 </span><span>25.1.1.3</span><span> 或更高版本；如果无法立即迁移，则应用 </span><span>22.8R2.6</span><span>。Ivanti 列出的不受影响版本为 ISA4500、ISA6500 或 ISA8500 上的 </span><span>25.1.3.0</span><span> 及更高版本。</span></p><p><span>Rapid7 还建议在打补丁后调查是否已遭入侵。Volexity 报告称，观察到的活动可规避 Ivanti Integrity Checker Tool，因此干净的结果并不能排除已被入侵的可能性。在可行的情况下，重启或重置前应保存内存和日志。如果怀疑已被入侵，请遵循 Ivanti 的</span><a href=\"https://hub.ivanti.com/s/article/Recovery-Steps\"><span>恢复步骤</span></a><span>，并轮换可能暴露的凭据。</span></p><p><span>有关当前修复版本和缓解指南，请参阅 Ivanti 的</span><a href=\"https://hub.ivanti.com/s/article/Security-Advisory-Ivanti-Connect-Secure-CVE-2026-104935?language=en_US\"><span>安全公告</span></a><span>。其中链接的恢复流程包含对较旧版本的引用。</span></p><h3 id=\"sec-3\">工件、证据来源和 IOC</h3><p><span>以下指南和工件来自 Volexity 的调查：</span></p><p><span><strong>威胁狩猎指南：</strong></span></p><ul><li><p><span>审查针对 </span><span>/dana-na/auth/url_default/welcome.cgi</span><span> 的请求，尤其是涉及 </span><span>X-DSCGI-PATH</span><span> 的 URL/标头不匹配情况。观察到的值包括：</span></p></li></ul><pre><code>X-DSCGI-PATH: /home/webserver/htdocs/dana/fb/smb/wu.cgi\nX-DSCGI-PATH: /home/runtime/tmp/&lt;MD5(filename)&gt;</code></pre><p><span><strong>设备上的证据来源：</strong></span></p><ul><li><p><span>/tmp/</span><span>：</span><span>ml.py</span><span>、</span><span>rq5.py</span><span>、</span><span>mk.py</span><span>、</span><span>rr.py</span><span>、</span><span>pu.txt</span><span>、</span><span>sp_out.txt</span><span> 和 </span><span>spray_hits.json</span><span>。</span></p></li><li><p><span>/data/.icscap/</span><span>：</span><span>dsstatmond</span><span>、</span><span>cap*</span><span> 和 </span><span>h.py</span><span>。</span></p></li><li><p><span>/home/runtime/tmp/</span><span>：</span><span>ics-root-run-inband-*.pl</span><span> 和 </span><span>ics-root-result-inband-*</span><span>。</span></p></li><li><p><span>/home/runtime/dlogs/debuglog</span><span> 和 </span><span>/var/log/audit/audit.log</span><span>：调查选择性删除的证据。</span></p></li></ul><p><span><strong>网络 IOC：</strong></span></p><ul><li><p><span>108.165.147[.]64</span><span>：根据 Volexity 的 </span><a href=\"https://github.com/volexity/threat-intel/blob/main/2026/2026-10-13%20Ivanti/iocs.csv\"><span>IOC 列表</span></a><span>，这是 UTA0576 的利用 IP 地址。</span></p></li></ul><p><span>Volexity 还提供了 </span><a href=\"https://github.com/volexity/threat-intel/blob/main/2026/2026-10-13%20Ivanti/rules.yar\"><span>YARA 规则</span></a><span>，用于检测请求标头中的证据以及内存中的权限提升载荷。</span></p><h2 id=\"sec-4\">Rapid7 客户</h2><h3 id=\"sec-5\"><span>Exposure Command、Vulnerability Management 和 Nexpose</span></h3><p><span>Exposure Command、Vulnerability Management 和 Nexpose 客户可以使用自 2026-10-30 内容版本起提供的经身份验证的漏洞检查，评估 CVE-2026-111357 和 CVE-2026-118527 带来的暴露风险。</span></p><h2 id=\"sec-6\">更新</h2><ul><li><p><span><strong>2026 年 11 月 2 日</strong></span><span>：首次发布。</span></p></li></ul>","original","zhKind","translation","complete","漏洞","补丁","利用链","Ivanti","CISA","https://www.rapid7.com/blog/post/etr-additional-ivanti-connect-secure-zero-days-exploited-in-the-wild-cve-2026-111357-cve-2026-118527","Rapid7 CVE 公告",{"_116":117,"_118":-5},"changelogVersion","2026-10-01T08:00","release"]
