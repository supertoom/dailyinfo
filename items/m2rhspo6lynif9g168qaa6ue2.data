[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1795912842000,"id","m2rhspo6lynif9g168qaa6ue2","title","Researchers uncover months of prompt theft across three AI inference providers","originalTitle","OpenRouter Drops 3 Providers After Researchers Catch Months of Prompt Theft at AI Hosting Firms","summary","Dragos 通过 canary token 研究发现，攻击者从 3 家 AI inference provider 内部窃取数据数月，最早始于 7 月中旬；OpenRouter 因此移除 3 家提供商及 125 个 Zero Data Retention 端点并通知潜在受影响客户，但 OpenRouter 本身未遭入侵。","reason","canary token 研究揭示了 AI 推理链路的隐蔽数据窃取方式，并给出路由器配置与凭据轮换等可迁移的排查思路。","source",{"_66":97},"links",{"_86":96},"publishedAt","2026-11-22T05:06:55.000Z","discoveredAt","2026-11-22T06:45:16.657Z","timelineAt","category","ai-security","tags",[67,90,91,92,93,94,95],"score",84,"selected",true,"channel","news","story","x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_59":85,"_86":-5,"_87":88,"_89":37},"outline",[76,77],"relatedStories",[],"topics",[60,61,62,63,64],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_65":74,"_66":75},{"_65":72,"_66":73},{"_65":70,"_66":71},{"_65":68,"_66":69},{"_65":31,"_66":67},"slug","name","AI 安全","ai-offense","AI 攻防","ai-agent","AI Agent 安全","identity","身份与访问","supply-chain","供应链安全",{"_11":83,"_79":84,"_81":82},{"_11":78,"_79":80,"_81":82},"sec-2","text","用户应该采取的措施","level",3,"sec-1","服务商披露了什么","<p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjEGP3P_elvK4C-QnSx5onZ67viDXCIgPCUYqtTF_RDNcLJfyQ4QMbegUmn8AJy5nEmnXfN4ACr6hHztG_DdqXlj54S21toacPQaZgRx2rgqZltN3lvREpZR2xlvgXF_iZ7zW0XT0b91mMiRDVaEB6TUvMFlWwaSa3_C7gwpxdKcNhLtIq15KqwaZrR3VI/s1600/openrouter.png\"><img alt=\"\" src=\"/dailyinfo/media/869d7f5dfa979e06.webp\" loading=\"lazy\" decoding=\"async\"></a></p><p>攻击者数月来一直从三家 AI 推理提供商内部窃取数据，而直到研究人员告知它们时，这三家机构都没有察觉，工业网络安全公司 Dragos 本周表示。</p><p>部分被窃取的请求被标记为 <strong>Zero Data Retention</strong>，该设置的含义本应是提示词绝不会被存储。</p><p><strong>OpenRouter</strong> 是一款网关，将客户的 AI 请求路由到一组第三方提供商。该公司今天表示，已从其平台移除三家提供商，取消了 125 个端点的 Zero Data Retention 资格，并通知了所有可能受影响的客户。公司称，调查结果表明 OpenRouter 本身未发生入侵。</p><p>这三起入侵中最早的一起始于 7 月中旬。这些植入的提示词是诱饵，但它们会与真实客户的请求一同处理，因此那些请求几乎肯定也被复制了，该公司表示。</p><p>这一发现来自<a href=\"https://www.dragos.com/blog/ai-supply-chain-security-canary-tokens\">金丝雀令牌研究</a>：研究人员在 7 月至 11 月间向系统植入约两百万条带有唯一网络链接和凭据的提示词，随后监测是否有人使用它们。植入的秘密只可能在一个位置被获知，因此任何对它的使用都意味着有人读取了携带该秘密的提示词。</p><p>三起入侵中规模最大的一起涉及数百个被植入的 AWS 密钥；10 月下旬的几个短时间窗口内，每个密钥都恰好随一次请求发送给一家提供商。那些窗口期间发送的每个请求均遭窃取，其中一些甚至来自提供商在模型运行前就已拒绝的请求，这表明攻击者是在流量首次到达时复制流量，而非在推理栈更深层处。</p><p>窃贼在某些情况下于数小时内测试密钥，列出 S3 存储桶，搜索 Secrets Manager 和 Parameter Store，并尝试创建 Bedrock API 密钥和添加 IAM 用户以维持访问权限，共发起数万次 AWS API 调用。</p><p>一名攻击者似乎同时入侵了两家提供商，利用从两处获取的秘密，通过同一台租用的服务器开展活动。</p><p>11 月 1 日，同一攻击者引入 ARTEX，这是一个由 AI 驱动的渗透测试框架，并仅使用它来确认其已经掌握的密钥仍然有效。该公司称，其两个用户代理 artex-agent 和 artex-judge-r121 未出现在其能够找到的任何公开指标列表中，值得添加到检测规则中。</p><p>“当攻击者已经进入内部时，隐私标记毫无帮助，”该公司首席研究官 HD Moore 写道。</p><p>第二项发现无需任何入侵。研究发现，某个 AI 推理市场上的卖家以最低价格列出模型，同时启用请求日志记录，并收集流经模型的全部内容。</p><p>从事这些活动的人看起来像是使用家庭互联网连接的 individuals。其中一人在法国的家庭宽带上使用一台 Mac 电脑，手动输入从两条提示词中获取的密码后发起 root SSH 登录尝试，随后又使用同一台机器测试了数个被植入的 AWS 密钥。</p><p>其中一把密钥曾经过另一台路由器，该路由器悄然将部分流量转发给这个市场，而没有任何客户获知这一跳。该路由器此后已告知公司已停止这么做；研究人员对约 2,000 条路径进行路由追踪，发现了数百个身份不明的系统，此外还发现一名卖家会悄悄为每条提示词添加约 1,000 个隐藏令牌。</p><p>一家未具名的中国 AI 实验室的研究人员发现，该实验室从 7 月至 10 月发送给其模型的提示词中，超过一半的提示词包含秘密链接，且其中包括约三分之二被标记为不收集数据或 Zero Data Retention 的请求。发送给转售该实验室模型的美国托管服务商的提示词也触发了同一抓取程序，从而将数据回传至该实验室。</p><p>后来，另一朵云上的某个 git 客户端尝试克隆提示词中引用的私有仓库，但仅针对该实验室的模型；一家大型美国服务商的搜索端点在仅收到一次请求后，仍持续抓取某个秘密链接两个多月。</p><p>某条提示词发出 24 天后，其秘密链接被发布到飞书的一个聊天中；飞书是一款中国职场协作应用，在其他地区称为 Lark。两分钟内，该链接在北京和上海的 3 台台式电脑及 3 部手机上被打开。</p><p>该公司仅披露了服务商链接的前 8 个字符，因此发布链接的人读取的是完整提示词的缓存副本。</p><p>Moore 写道，在实际情况下，被标记的提示词会被保留、传递给其他公司，并由人工查看。</p><p>OpenRouter 在一份<a href=\"https://openrouter.ai/blog/announcements/data-processing-incidents-on-inference-providers/\">事件公告</a>中表示，从 Zero Data Retention 适用范围中移除的 125 个端点，既包括研究人员标记的服务商，也包括出于预防措施而移除的其他端点。任何在审查期间被移除的端点，都必须先提供相关保证并通过验证，然后才能恢复其状态。</p><p>该网关正在调整研究人员的测试方法，以便持续运行这些检查；同时正在验证网络路径，以确定请求和响应可能被转发至第三方的地方。</p><p>研究人员目前正与约 dozen 家服务商合作；截至本周，在最初几次窃取发生数月后，植入的密钥和秘密链接仍有人在访问。</p><p>平台公司 Railway 在 10 月表示，其遭受的<a href=\"https://thehackernews.com/2026/10/railway-says-intruder-may-have-accessed.html\">入侵</a>很可能是一系列旨在针对平台公司的攻击的一部分，其最终目标是入侵 AI 推理服务商。</p><p>该网关表示，并非所有受影响的服务商都已公开发布声明，但无论是否发布，网关都已通知受影响的用户。目前已有 3 家发布。</p><h3 id=\"sec-1\">服务商披露了什么</h3><p>该服务商上周在一份<a href=\"https://phala.com/posts/phala-november-preliminary-incident-report\">初步事件报告</a>中表示，攻击者控制了 Phala 的一台推理服务器，能够在处理请求数据期间查看这些数据。此次事件已于 11 月 8 日得到控制，模型服务已在增加防护措施后恢复。</p><p>报告称，在 10 月 21 日 00:00 UTC 至 11 月 8 日 05:35 UTC 期间，通过该网关到达 Phala 的 DeepSeek V4 Flash 0731 模型请求应被视为已暴露，其中的每个密钥、令牌、密码或其他机密信息都应轮换。</p><p>一名第三方研究人员自 7 月 1 日起一直在请求中放入唯一的金丝雀凭据，而后来被滥用的只有 10 月 21 日和 22 日发送的那些凭据。这些测试是对流量进行抽样，而非监控每一个请求，因此该服务商维持了范围更广的预防性时间窗口。</p><p>Together AI 昨天在一份<a href=\"https://www.together.ai/blog/security-event-prompt-leakage-for-requests-in-june-and-july-of-2026\">安全通知</a>中表示，一个 AI 编码代理将凭据提交到了公司的公开 GitHub 仓库后，未获授权的一方下载了存储的客户提示词样本。这些样本是为例行软件测试而收集的，由 6 月和 7 月向 MiniMax M3、GLM-5.2 和 Kimi K2.6 模型发出的请求生成。</p><p>该团伙在样本中搜索用于其他服务的凭据并进行测试，其中五组被测试的凭据是研究人员实验设置的诱饵。公司表示，没有理由相信数据被进一步传播，已了解相关数据已被删除，并将零数据保留设为新账户的默认设置。</p><p>网关上的另一家提供商 Novita 本周在一则<a href=\"https://x.com/novita_labs/status/2124196616358010992\">隐私声明</a>中确认，一项路由配置问题导致部分 MiniMax 请求被转发至 MiniMax 的官方 API，超出了这些客户的预期范围。</p><p>Dragos 尚未公布被攻破的三家提供商，OpenRouter 也尚未公布其移除的三家，而且双方均未公开说明它们是否为同样的三家。</p><p>研究人员称，7 月中旬遭攻破的那家提供商最初将责任归咎于内部配置错误，随后又归咎于合作伙伴的数据处理，最终其自身调查发现，攻击者已攻破其内部凭据。截至本周，该提供商仍未公开披露这起事件。</p><h3 id=\"sec-2\">用户应该采取的措施</h3><p>Moore 写道，研究人员的建议始于一个限制：隐私标志只约束第一跳，而 AI 代理会发送其能够读取的任何内容，包括凭据。他写道，提示词发往何处是一种选择；不做出选择的客户，就是把这一选择交给了价格最低的一方。</p><p>自托管是唯一没有任何第三方读取提示词的选项；直接使用一级提供商，则只剩一家公司、一份合同和一项隐私政策需要核查。</p><p>路由工具需要更加谨慎：自行选择上游提供商，而不是接受默认池；验证隐私设置是否真的会改变请求的去向；并避开转售商市场，其中一些市场的算力使用被盗密钥运行。</p><p>如果将一个虚假凭据植入 AI 代理和流水线已经发送的上下文中，并将任何使用该凭据的行为都视为安全事件，它就能充当绊线；一个免费的 Thinkst Canarytoken 就足以开始。从提示词中清除已知凭据格式的设置也有帮助，但会漏掉形态不像密钥的敏感数据。</p><p>觉得这篇文章有意思？在 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a> 上关注我们，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","数据泄露","供应链","大模型","AI 编码","凭据","AWS","https://thehackernews.com/2026/11/openrouter-drops-3-providers-after.html","The Hacker News",{"_99":100,"_101":-5},"changelogVersion","2026-10-01T08:00","release"]
