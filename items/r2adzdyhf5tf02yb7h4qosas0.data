[{"_1":2,"_3":4},"root",{"_5":89},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1794703232000,"id","r2adzdyhf5tf02yb7h4qosas0","title","FAA 全国地面停飞未发现黑客攻击证据，FBI 调查软件更新","originalTitle","No Signs of Hacking in FAA Ground Stop as FBI Reportedly Probes Software Update","summary","美国官员未发现黑客导致 FAA 全国地面停飞的证据，FBI 正调查软件更新是否为诱因。FAA 于 11 月 13 日因空管中心通信故障停止全国航班起飞，20:15 ET 解除，影响数千个航班，后续延误预计持续数日。官员称问题更可能源于旧有交换机和路由器被大量数据淹没及系统更新负载；NSA、CISA 等机构参与调查，但尚未公布最终根因，也未完全排除网络攻击。","reason","source",{"_72":88},"links",{"_61":87},"publishedAt","2026-11-14T08:40:22.000Z","discoveredAt","2026-11-14T14:12:42.915Z","timelineAt","category","activity","tags",[73,84,75,85,86],"score",61,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","readingMode","full","author","Eduard Kovacs","body",{"_80":-5,"_61":81,"_82":-5,"_83":36},"outline",[],"relatedStories",[76],"topics",[68,69],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fAw5-oIk-OTI","reportCount",1,"additionalSourceCount",0,{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","attack","name","攻击活动","incident","应急响应",{"_77":78,"_13":79},"publicId","03d6af88-9101-4a45-bb43-faf465215b5b","FAA全国停飞调查指向通信系统过载，未发现黑客证据","zh","<p><strong>US officials have found no evidence that hackers caused the outage that led the Federal Aviation Administration (FAA) to halt flight departures nationwide on Friday, and the FBI is reportedly examining whether a software update was responsible.</strong>\n\n\n\n</p><p>The <a href=\"https://www.securityweek.com/faa-ground-stop-issued-due-to-extraordinary-circumstances/\">FAA issued the ground stop</a> on November 13 after a communications problem hit its air route traffic control centers. The order was lifted at 8:15 pm ET, more than four hours later, after disrupting thousands of flights. Departures have since resumed, though officials expect delays to continue for several days.\n\n\n\n</p><p>Homeland Security Secretary Markwayne Mullin <a href=\"https://www.youtube.com/live/Mh2q-y0wIu8\">told reporters at the White House</a> that the incident did not appear to be the result of a cyberattack, and that the failure appeared to be mechanical.\n\n\n\n</p><p>On the absence of attack indicators, Mullin said “there’s no chatter, we haven’t seen any footprints.”\n\n\n\n</p><p>He stopped short of dismissing the possibility entirely. “However, we’re still looking, so we’re not going to rule that out,” Mullin said.\n\n\n\n</p><p>The NSA, the Department of Defense, CISA and other agencies have been involved in the investigation, according to Mullin.</p><p><span>Advertisement. Scroll to continue reading.</span></p><p>The FBI does not think a cyberattack or criminal activity was behind the outage, <a href=\"https://www.bloomberg.com/news/articles/2026-11-13/fbi-said-to-probe-whether-software-update-caused-mass-faa-outage\">Bloomberg</a> reported, citing a person familiar with the matter. Investigators are looking at a software update as a potential cause, the source said.\n\n\n\n</p><p>Transportation Secretary Sean Duffy blamed legacy equipment. He said switches and routers in the FAA’s network were flooded with data and began producing inconsistent information, at which point the agency shut the system down.\n\n\n\n</p><p>Officials described the ground stop as a precaution.\n\n\n\n</p><p>Mullin offered a possible trigger. He said it appeared the FAA had been applying patches and installing new equipment and technology, which “was overwhelming the older system.”\n\n\n\n</p><p>CBS News, citing multiple sources, <a href=\"https://www.cbsnews.com/news/faa-issues-nationwide-ground-stop/\">reported</a> that the outage followed an update to the private communications network that links the air traffic control system. The network rebooted and then crashed, and it is operated by L3Harris, according to the report.\n\n\n\n</p><p>Officials said the incident had nothing to do with the <a href=\"https://www.securityweek.com/microsoft-365-outage-disrupts-outlook-exchange-online-and-teams/\">Microsoft outage</a> earlier in the week. They also said the FAA’s recently deployed AI systems played no role.\n\n\n\n</p><p>No official root cause has been announced.\n\n\n\n</p><p>The previous nationwide ground stop came in January 2023, after a contractor unintentionally deleted files while working on the system that delivers safety notices to pilots. <a href=\"https://www.securityweek.com/no-evidence-cyberattack-related-faa-outage-white-house-says/\">No evidence of a cyberattack</a> was found in that case either.\n\n\n\n</p><p><strong>Related</strong>: <a href=\"https://www.securityweek.com/iranian-apt-targets-aviation-software-companies-with-updated-tools/\">Iranian APT Targets Aviation, Software Companies With Updated Tools</a>\n\n\n\n</p><p><strong>Related</strong>: <a href=\"https://www.securityweek.com/hawaiian-airlines-hacked-as-aviation-sector-warned-of-scattered-spider-attacks/\">Hawaiian Airlines Hacked as Aviation Sector Warned of Scattered Spider Attacks</a>\n\n\n\n</p><p><strong>Related</strong>: <a href=\"https://www.securityweek.com/extortion-group-claims-manchester-airports-group-data-breach/\">Extortion Group Claims Manchester Airports Group Data Breach</a>\n\n\n\n</p>","zhKind","complete","网络设备","CISA","Microsoft","https://www.securityweek.com/no-signs-of-hacking-in-faa-ground-stop-as-fbi-reportedly-probes-software-update/","SecurityWeek",{"_90":91,"_92":-5},"changelogVersion","2026-10-01T08:00","release"]
