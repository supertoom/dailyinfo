[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795826436000,"id","ac1tlqg3g5b5d0yn83tpuilhf","title","Linux 内核 NFS 服务器漏洞 CVE-2026-99362 可远程提权，OpenSec 称其为 NFS2ROOT","originalTitle","New NFS2ROOT Linux flaw can let attackers gain root privileges","summary","Linux 内核 NFS 服务器存在堆缓冲区溢出漏洞 CVE-2026-99362，由 ANSSI 的 Jérémy Jean 发现，OpenSec 将其称为 NFS2ROOT 并给出完整的远程 root 利用代码。","reason","文中给出受影响内核版本区间与利用前提，并说明目前尚无在野利用证据，处置与检测线索都较具体。","source",{"_71":96},"links",{"_86":95},"publishedAt","2026-11-27T08:06:58.000Z","discoveredAt","2026-11-27T08:30:20.770Z","timelineAt","category","vuln","tags",[90,91,92,93,94],"score",76,"selected",true,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","Sergiu Gatlan","body",{"_61":85,"_86":-5,"_87":88,"_89":37},"outline",[79],"relatedStories",[75],"topics",[68,69],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fmlmlRS3Giv0","reportCount",1,"additionalSourceCount",0,{"_70":73,"_71":74},{"_70":31,"_71":72},"slug","name","漏洞披露","kernel","内核与系统",{"_76":77,"_13":78},"publicId","19ccbf39-f36e-4430-8121-e36ae6b29942","OpenSec公开NFS2ROOT利用与内核补丁",{"_11":80,"_81":82,"_83":84},"sec-1","text","发现您现有防御可能遗漏的邮件威胁。","level",2,"<p><img alt=\"Linux\" height=\"900\" src=\"/dailyinfo/media/cb7273a5f8838b3d.jpg\" srcset=\"/dailyinfo/media/3cf63c06b3bf4015.jpg 720w, /dailyinfo/media/b38bc3c34071d714.jpg 1200w, /dailyinfo/media/cb7273a5f8838b3d.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>Linux 内核网络文件系统（NFS）服务器中一个已有 12 年历史的严重漏洞（跟踪编号为 CVE-2026-99362）允许远程攻击者获取 root 权限。</p><p>该漏洞由 ANSSI 的 Jérémy Jean 发现（他于<a href=\"https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git/commit/?id=35ff1a7a7e3835c3e974bc5c45d335897564ceae\">8 月</a>提交了修复方案），网络安全公司 OpenSec 将其命名为 <strong>NFS2ROOT</strong>，并在 9 月下旬与 NFSD 维护者分享了完整的远程 root 利用代码和补丁。</p><p>该漏洞自 Linux 内核版本 3.16 起就已存在（<a href=\"https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git/commit/?id=47ee52986472dba068e8223cbaf1b65d74238781\">该版本于 2014 年 3 月发布</a>），根源在于 Linux NFS 服务器（nfsd）中的一个堆缓冲区溢出弱点。</p><p><a href=\"https://www.wiz.io/lp/claude-code-security-best-practices-cheat-sheet?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q3_INB_FORM_Claude-Code-Security-Best-Practices&amp;sfcid=701Vh00000gJQZuIAO&amp;utm_term=FY27Q4-bleepingcomputer-article-970x250-Nov&amp;utm_content=Claude-Code-Best-Practices\"><img src=\"/dailyinfo/media/dfd3f12557f3697a.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>如果 nfsd（v4.1 或 4.2）已加载并运行，且 TCP 端口 2049 可通过互联网访问，则 NFS2ROOT 会影响内核版本低于 6.12.117、6.18.61、7.3.2 或 7.4-rc1 的系统。</p><p>成功利用后，无特权的远程威胁者可通过低复杂度、无需用户交互的攻击，破坏暴露在互联网上的易受攻击 Linux 服务器的内核内存并获取 root 访问权限。</p><p>在 NFS2ROOT 攻击中，威胁者可以利用该缺陷，发送恶意构造的请求，导致 NFS 服务器将数据写入已分配内存缓冲区之外。这使他们能够读取内核内存、绕过 KASLR（用于保护内核内存地址），并在已释放的内存区域放置可执行命令的回调。</p><p>当攻击者关闭 NFS 连接时，内核会以 root 权限执行所嵌入的命令，从而使攻击者获得对未打补丁 Linux 服务器的 root 控制权。</p><figure><img alt=\"NFS2ROOT attack flow\" height=\"333\" src=\"/dailyinfo/media/bd9224be4d74adc6.jpg\" loading=\"lazy\" decoding=\"async\" width=\"700\">\n<figcaption><em>NFS2ROOT 攻击流程（OpenSec）</em></figcaption>\n</figure><p>尽管目前没有关于 CVE-2026-99362 在野利用的报告，安全团队仍应立即应用其 Linux 发行版供应商提供的最新内核安全更新，以阻止潜在攻击，然后重启系统以确保使用的是已打补丁的内核。</p><p>无法立即打补丁的用户应将 NFS 服务器在 TCP 端口 2049 上的访问限制为仅受信任的客户端或网络。此外，如果系统不需要 NFS 共享，管理员可以在 /etc/nfs.conf 中停止并禁用 nfs-server 服务。</p><p>“在文件服务器、NAS 设备、构建集群和 Kubernetes 存储节点上，2049 端口处于开放状态。自 2014 年以来，监听该端口的 Linux 内核就允许任何能访问到它的人尚未登录便向内核内存写入数据，”<a href=\"https://opensec.in/blog/nfs2root-cve-2026-99362\">OpenSec 表示</a>。“内核加固无法消除该溢出。请为每台主机打补丁。”</p><p>虽然 NFS2ROOT 攻击没有网络特征，但根据 OpenSec 的说法，安全团队仍可通过以下方式监控潜在利用尝试的迹象：检查来自 nfsd4_check_resp_size 的内核警告、文件服务器上由内核工作线程派生的 shell、来自单一来源的短时 NFSv4.1 会话突发，以及包含 nfsd4_*、svc_* 或 call_usermodehelper* 栈帧的内核 oops。</p><p>NFS2ROOT 是今年以来披露并修补的一系列 Linux 权限提升安全漏洞中的最新一个，其中包括 <a href=\"https://www.bleepingcomputer.com/news/linux/new-refluxfs-linux-flaw-lets-attackers-gain-root-privileges/\">RefluXFS</a>、<a href=\"https://www.bleepingcomputer.com/news/security/new-cifswitch-linux-flaw-gives-root-on-multiple-distributions/\">CIFSwitch</a>、<a href=\"https://www.bleepingcomputer.com/news/security/new-linux-dirty-frag-zero-day-with-poc-exploit-gives-root-privileges/\"> Dirty Frag</a>、<a href=\"https://www.bleepingcomputer.com/news/security/new-fragnesia-linux-flaw-lets-attackers-gain-root-privileges/\">Fragnesia</a>、<a href=\"https://www.bleepingcomputer.com/news/linux/exploit-released-for-new-pintheft-arch-linux-root-escalation-flaw/\">PinTheft</a>、<a href=\"https://www.bleepingcomputer.com/news/security/new-linux-copy-fail-flaw-gives-hackers-root-on-major-distros/\">Copy Fail</a>、<a href=\"https://www.bleepingcomputer.com/news/security/new-pack2theroot-flaw-gives-hackers-root-linux-access/\">Pack2TheRoot</a> 和 <a href=\"https://www.bleepingcomputer.com/news/security/exploit-available-for-new-dirtydecrypt-linux-root-escalation-flaw/\">DirtyDecrypt/DirtyCBC</a>。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/a3aef6170ea13c62.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现您现有防御可能遗漏的邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体会分析邮件意图、上下文和行为，以发现网络钓鱼/business 电子邮件入侵和发票欺诈。</p><p>通过 14 天只读扫描查看 Microsoft 365 或 Google Workspace 中有哪些内容被成功传递，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始您的免费电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","漏洞","复现","漏洞利用","补丁","内核","https://www.bleepingcomputer.com/news/security/new-nfs2root-linux-flaw-can-let-attackers-gain-root-privileges/","BleepingComputer",{"_98":99,"_100":-5},"changelogVersion","2026-10-01T08:00","release"]
