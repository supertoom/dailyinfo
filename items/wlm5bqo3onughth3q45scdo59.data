[{"_1":2,"_3":4},"root",{"_5":107},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1794530494000,"id","wlm5bqo3onughth3q45scdo59","title","OpenAI 使用 AI Agent 扫描 Linux 内核并发现 948 个本地提权漏洞","originalTitle","Linux内核被挖出948个漏洞！OpenAI花120万美元找到的","summary","OpenAI 使用尚未发布的网络安全模型和 AI Agent 流水线扫描 Linux 内核，在 10 天内发现、复现并利用 948 个独立本地提权漏洞，总花费 120万美元。","reason","文章拆解了 AI Agent 扫描、验证并利用 Linux 内核漏洞的自动化流程，可用于比较攻防效率与成本变化。","source",{"_73":106},"links",{"_97":105},"publishedAt","2026-11-05T01:42:25.753Z","discoveredAt","2026-11-05T02:42:25.759Z","timelineAt","category","ai-security","tags",[74,100,78,101,102,76,103,104],"score",88,"selected",true,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","body",{"_61":96,"_97":-5,"_98":97,"_99":37},"outline",[85,86,87],"relatedStories",[81],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","ffu0PRrzrozA","reportCount",3,"additionalSourceCount",2,{"_72":79,"_73":80},{"_72":77,"_73":78},{"_72":75,"_73":76},{"_72":31,"_73":74},"slug","name","AI 安全","research","技术研究","ai-offense","AI 攻防","ai-agent","AI Agent 安全",{"_82":83,"_13":84},"publicId","8a0d1d1e-9974-4d49-93db-755f458d7bf8","OpenAI发布模型生成948个Linux提权利用",{"_11":94,"_89":95,"_91":67},{"_11":92,"_89":93,"_91":67},{"_11":88,"_89":90,"_91":67},"sec-3","text","防守方的寒冬？","level","sec-2","意料之外的越界进化","sec-1","AI黑客军团","<h5>Jay 发自 凹非寺量子位 | 公众号 QbitAI</h5><p>刚刚，Linux内核，<strong>被GPT挖出了948个漏洞😭</strong>。</p><p>对，948个。。。</p><p><img src=\"/dailyinfo/media/ce87502e9fc19187.webp\" loading=\"lazy\" decoding=\"async\"></p><p>要知道，这可不是什么犄角旮旯的小软件，这是Linux Kernel，是安卓、是全世界无数云服务器、是几乎所有超算背后共同的心脏。</p><p>超过4000万行代码，几十年来全世界最顶尖的一批程序员在上面添砖加瓦。</p><p>结果，OpenAI用他们一个还没发布的「网络安全模型」，跑了一条自动化的流水线，从发现漏洞、验证漏洞、写出攻击代码（Exploit）……</p><p>最终，花费<strong>120万美元</strong>，揪出了<strong>948个</strong>能让普通用户直接拿到最高管理员（root）权限的严重漏洞。。。</p><p>太惨了，Linux内核维护者们一觉醒来，发现OpenAI提出了948个补丁建议😭。</p><p>要知道，在AI出现之前，顶尖的人类安全研究员，一年能在Linux内核里找到<strong>大约20个</strong>类似的漏洞。</p><p>AI用10天，干了人类差不多50年的活。</p><p>而且成本还巨低。120万美元听着很多，但其实平均下来，找到并攻破一个漏洞的成本是<strong>1279美元</strong>。</p><p>如果按照Pwn2Own这种顶级黑客大赛的历史奖金来算，这948个漏洞的价值，大概在<strong>1890万到6630万美元</strong>之间。</p><h2 id=\"sec-1\"><strong>AI黑客军团</strong></h2><p>所以，OpenAI到底是怎么做到的？</p><p>他们用AI Agent，搭建了一支纪律严明、分工明确的AI黑客军团。</p><p>核心可分为三步：</p><p><strong>1.侦察和分析(Discovery)</strong></p><p>整个Linux内核代码量超过4000万行，如果全量死磕，算力再多也得烧穿。</p><p>因此，OpenAI派出了两种AI Agent，打探敌情。</p><p><strong>首先是「侦察兵」(Scout agents)</strong>。它负责通读Linux内核的全部代码，判断哪些部分跟安全有关、容易被攻击。</p><p>最后，它从4000多万行代码里，圈出了<strong>280万行</strong>「高价值目标」，大概占总代码量的7%，花掉了3426美元的API额度。</p><p><strong>随后「分析师」(Analyst agents)</strong>进场，拿到「侦察兵」给的地图，开始对这280万行代码进行地毯式扫描，寻找可能的漏洞。</p><p>12个小时，它交出了2308个「疑似漏洞」报告，耗资31.6万美元。</p><p><strong>2.验证和复现(Validation)</strong></p><p>光有报告没用，万一是误报呢？人类安全研究员最头疼的就是验证环节。</p><p>现在，该「分类兵」(Triage agent)上场了。它会针对每一个「疑似漏洞」，自动编写一小段代码（PoC），然后在一个隔离的虚拟机里运行，看能不能让系统崩溃。</p><p>就像不停地用各种姿势去踹一扇门，直到把它踹开。</p><p>30小时之内，智能体在真实环境里成功复现了<strong>1724个内核崩溃漏洞</strong>，命中率高达<strong>74.7%</strong>。</p><p>其中，因为模型逻辑脑补而导致的彻底误报，仅仅只有<strong>3.1%</strong>。</p><p><strong>3.攻击和利用(Exploitability assessment)</strong></p><p>确认是真漏洞之后，最关键的一步来了。</p><p>「攻击手」(ExploitDev agents)接管任务。它会尝试绕过系统里所有的安全防护措施，比如SMEP、SMAP、KASLR等等，看看能不能利用这个漏洞，最终拿到系统的root权限。</p><p>在极端严苛的环境下，ExploitDev Agent（利用开发智能体）最终实打实写出了<strong>291个信息泄露PoC</strong>，以及<strong>1169个成功拿到root权限的提权Exploit</strong>。</p><p>在合并同类变体后，锁定了<strong>948个独立的本地提权漏洞</strong>。</p><p>平均下来，造出一个完整、可用的root提权利用，API消耗仅仅只需要<strong>359美元</strong>。</p><p><img src=\"/dailyinfo/media/82789161019d6e09.webp\" loading=\"lazy\" decoding=\"async\"></p><h2 id=\"sec-2\"><strong>意料之外的越界进化</strong></h2><p>这个网络安全模型的攻击方式，相当诡异。</p><p>安全团队抽样分析了智能体编写的166个利用程序，瘫软了。</p><p>AI自行发现并使用了<strong>至少10种全新的Linux内核攻击技术</strong>。</p><p>其中包括2种用于在内核缓存中精准堆喷射的持久弹性对象、2种用于提高提权稳定性的全新页面编排（page grooming）技术、5种通过任意写或直接篡改数据结构的数据流攻击手法，以及1种全新的任意类型混淆。</p><p>OpenAI拿着这些利用技术找业界资深的外部内核专家验证，对方同样表示：</p><blockquote><p>闻所未闻。</p></blockquote><p>另一个插曲更具戏剧性。</p><p>早期测试时，安全团队要求ExploitDev智能体针对特定分配的漏洞去写Exploit，只要拿到root shell就算通关。</p><p>结果在200个打通的案例里，人工核验发现，居然有<strong>20个利用程序根本没用指定的漏洞</strong>。</p><p>智能体在受限靶机里反复倒腾，发现分配给自己的漏洞不好啃，索性顺手在系统里挖了 <strong>另一个谁都不知道的全新0-day</strong>，一路提权拿到了root。</p><p>大模型在漏洞攻防中，展现出了超出人类预料的战术自主性。</p><p>而这，远不如AI能做到的极限，</p><p>OpenAI提到，他们在7月份用GPT-5.6 Sol模型也跑过一次扫描，当时花了50多万美元，找到了166个漏洞。</p><p>三个月后，换上这个更强的「网络安全模型」，直接把战果翻了<strong>5倍多</strong>。</p><p>同样的代码，在更强的模型眼里，就是筛子。</p><p>很多我们以为「安全」的软件，可能，真的没有那么安全了。</p><p>随着模型能力迭代，一遍又一遍地扫描现有代码，会成为一种常态。</p><p>而且你想想：<strong>一个漏洞1279美元的发现成本，什么概念？</strong></p><p>说实话，对于攻击者来说，这个价格低到可以忽略不计。</p><p>但对于防守方，要投入无数人力、时间去审计、修复、测试，成本完全不成正比。</p><p>真的贼不公平，攻击者失败了啥事儿没有，但防御方一旦有一点疏忽，就可以GAME OVER了。</p><p>拿到你系统里一个没及时更新补丁的低权限账户，基本上就等于直接拿到了root权限，直接将军。</p><p>在过去，挖掘内核级0-day是一门极度昂贵的手艺活。顶尖黑客需要数月沉淀、对操作系统底层如数家珍、靠直觉与试错去捕捉那灵光一闪的竞态条件。</p><p>未来，或许<strong>只要买个Pro 500x，人人都能是顶级黑客</strong>。</p><h2 id=\"sec-3\"><strong>防守方的寒冬？</strong></h2><p>看到这，说实话，我有点绝望了。</p><p>Linux都能被打成筛子，那我电脑里的一堆屎山Vibe Coding项目不得瘫痪了啊o(╥﹏╥)o。</p><p>所幸，这次的锤子握在修补者手中，OpenAI这次还算有点良心。</p><p>研究员Eric Wallace在社交媒体上公开表示，他们正通过「Patch the Planet」项目，把大量前沿算力以纯公益（pro bono）的方式投向开源生态。</p><blockquote><p>我们现在正将大量的尖端算力，无偿地用于发现和修补开源代码库中的漏洞。</p></blockquote><p>除了Linux内核，这套管线已经接入了Firefox和Chrome，近期刚刚协助Firefox修复了超过40个漏洞。</p><p><img src=\"/dailyinfo/media/62a131ed822c49e8.webp\" loading=\"lazy\" decoding=\"async\"></p><p>这也能侧面反映出OpenAI的解题思路吧。</p><p>一位网友的评论，我觉得说得特别到位，就是这么个意思，把经济账重算一遍。</p><blockquote><p>OpenAI的目标，就是要把攻击的成本重新拉高，在攻击者利用漏洞之前，就帮助防守方把它修复掉。</p></blockquote><p>简单来说就是，用AI魔法来打败AI魔法。</p><p><img src=\"/dailyinfo/media/15d22fe5bcbe4438.webp\" loading=\"lazy\" decoding=\"async\"></p><p>当然，这也绝不只是AI公司需要打的战争。</p><p>模型之外，开发者们从来没有坐以待毙。</p><p>在历时10天的内核扫描与人工复核窗口期里，社区本身也展现出了惊人的韧性。</p><p>当AI还在验证这千余个漏洞时，全球Linux维护者与开发者已经在上游修补了61个相关LPE，43个补丁正在暂存区测试，另有近300个在社区邮件组里被激烈公开讨论。</p><p>人类安全共同体从未懈怠。</p><p>只是如今，他们迎来了一个不知疲倦、效率恐怖的钢铁对手——</p><p><strong>全世界开发者，V.S.一个安全领域的AlphaGo。</strong></p><p>原文：https://openai.com/index/a-thousand-fewer-paths-to-root/</p><p>声明：本文来自量子位，版权归作者所有。文章内容仅代表作者独立观点，不代表安全内参立场，转载目的在于传递更多信息。如有侵权，请联系 anquanneican@163.com。</p>","original","zhKind","complete","Agent 安全","大模型","漏洞利用","Google","Mozilla","https://www.secrss.com/articles/95365","安全内参",{"_108":109,"_110":-5},"changelogVersion","2026-10-01T08:00","release"]
