[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795912837000,"id","f21gd7uj9jttjkqd3djp2u7i7","title","欧盟委员会遭 ARTEX AI 辅助攻击，人事管理系统中断至少 10 天","originalTitle","AI攻击杀疯了！欧盟委员会内部管理系统因此中断超10天","summary","欧盟官员证实，欧盟委员会遭 AI 辅助网络攻击，10 月 22 日发现事件后关闭多个应用，翻译、费用报销、薪资和工时记录等系统受到影响，至少 10 天无法正常提供服务，部分数字工具持续离线。","reason","材料还原了欧盟委员会遭 AI 辅助攻击后的影响范围，并补充 ARTEX 渗透测试智能体的扩散风险与监管警告。","source",{"_75":96},"links",{"_90":95},"publishedAt","2026-11-20T10:12:00.000Z","discoveredAt","2026-11-20T12:18:31.619Z","timelineAt","category","activity","tags",[76,78,93,94],"score",77,"selected",true,"channel","news","story",{"_86":87,"_13":88},"x","readingMode","full","author","body",{"_61":89,"_90":-5,"_91":90,"_92":37},"outline",[],"relatedStories",[85],"topics",[68,69,70,71,72],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fY9UnTlgvOu4","reportCount",1,"additionalSourceCount",0,{"_73":83,"_75":84},{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","attack","name","攻击活动","ai-offense","AI 攻防","black-market","数据窃取与黑产","ransomware","勒索软件","supply-chain","供应链安全",{"_86":87,"_13":88},"publicId","04082b31-a4d6-48fe-9618-2243903225ae","欧盟委员会披露遭AI辅助攻击","<p><span>安全内参编译</span> <span>2026-11-20 18:12</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/eaea597fd96bcd57.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>欧美监管机构纷纷警告ARTEX渗透测试智能体</p><p><strong><span>关注我们</span></strong></p><p><strong><span>带你读懂网络安全</span></strong></p><p><img src=\"/dailyinfo/media/54c9d341dde8bb41.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>据外媒曝光，欧盟委员会遭受ARTEX AI攻击，导致人事管理系统中断至少10天，全体员工数据可能泄露；&nbsp;</span></span></p><p><span><span>欧盟委员会承认遭受AI辅助网络攻击，部分系统持续受到影响，但未发现全体工作人员数据遭泄露的证据；&nbsp;</span></span></p><p><span><span>近一个多月来，类ARTEX渗透测试智能体开始流行，全球出现了成百上千个攻击事件和受害组织，欧盟CERT、美国FBI等均发布警告，提醒防范此类攻击。</span></span></p><p><span>前情回顾·</span><span><span>AI网络攻击持续增长</span></span></p><ul><li><p><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247516914&amp;idx=2&amp;sn=23acc4d4c1fcb23ef1e519d154952687&amp;scene=21#wechat_redirect\">AI攻击火力太强，知名网络安全公司也被入侵了！</a></span></p></li><li><p><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247516904&amp;idx=1&amp;sn=769a04b609bf67ebcd354bb43a5bb5c5&amp;scene=21#wechat_redirect\">谷歌警告：AI全自动网络攻击将在半年内到来</a></span></p></li><li><p><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247516776&amp;idx=1&amp;sn=95532de0868d1661b937626b36cee31a&amp;scene=21#wechat_redirect\">知名AI开发平台发生数据泄露，呼吁所有用户更换托管密钥</a></span></p></li><li><p><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247516749&amp;idx=1&amp;sn=9dbafca59e0c1859741353938cdb0b9d&amp;scene=21#wechat_redirect\">AI重塑网络攻击！孤狼黑客数周攻破上百家企业，包括至少3家上市公司</a></span></p></li></ul><p><span>安全内参11月20日消息，一名欧盟官员周四证实，网络安全专家近一个月来，一直在应对一起针对欧盟重要机构的AI辅助网络攻击。目前，欧盟部分数字工具仍处于离线状态。</span></p><p><span>欧盟委员会人事系统遭AI辅助攻击，</span></p><p><span>已持续影响一个月</span></p><p><span>这名官员没有透露此次网络攻击的具体细节，也未说明幕后黑手可能是谁。这是欧盟首次报告遭遇涉及AI工具的网络攻击。</span></p><p><span>欧盟委员会发言人Thomas Regnier表示：“AI辅助工具可以用于发现系统漏洞，但也可能被滥用。”</span></p><p><span>他证实：“此次攻击确实使用了AI工具。近期，全球各地发生了多起网络攻击，当然，没有任何机构能够完全免受网络攻击的威胁。”</span></p><p><span>Regnier介绍，欧盟于10月22日首次发现此次安全事件。随后，相关部门立即展开调查，并采取了预防性措施。</span></p><p><span>据外媒Politico报道，这次攻击至少持续了10天，影响了欧盟的翻译和费用报销工具，以及用于管理员工薪资和工时记录的数据库。不过，Regnier拒绝证实上述报道。</span></p><p><span>Regnier表示：“我们暂时关闭了多个应用程序，其中大部分现已恢复运行。”但他同时强调：“截至目前，我们尚未发现证据表明欧盟委员会全体工作人员的数据遭到泄露。”</span></p><p><span>欧盟各机构的数字安全事务由欧盟网络安全应急响应团队（CERT-EU）负责。仅在布鲁塞尔，欧盟各机构就雇用了约4万名员工。</span></p><p><span>欧美监管机构纷纷警告</span></p><p><span>ARTEX渗透测试智能体</span></p><p><span>11月4日，CERT-EU发布博客文章，警告一种名为ARTEX的工具正带来安全威胁。该工具原本用于借助AI识别数字系统中的漏洞，但近期被发现与全球多起网络攻击有关。</span></p><p><span>CERT-EU指出：“我们认为，ARTEX的公开可用性很可能加速威胁行为者对该工具的采用，进而导致自动化攻击更加频繁、速度更快、规模更大，成功率也更高。”</span></p><p><span>此次10月网络攻击的目标是欧盟行政机构欧盟委员会总部。目前，欧盟另外两个主要机构，即欧洲理事会和欧洲议会，尚未报告发生类似事件。</span></p><p><span>这是欧盟委员会今年披露的第三起网络安全事件，此前1月Ivanti软件、3月云基础设施分别遭到入侵，目前来看这些都是独立事件。 &nbsp;&nbsp;</span></p><p><strong><span>参考资料：bleepingcomputer.com</span></strong></p><p><strong><span><span>推荐阅读</span></span></strong></p><ul><li><p><span><a href=\"http://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247499450&amp;idx=2&amp;sn=2da3ca2e0b4d4f9f56ea7f7579afc378&amp;chksm=ebfab99adc8d308c3ba6e7a74bd41beadf39f1b0e38a39f7235db4c305c06caa49ff63a0cc1d&amp;scene=21#wechat_redirect\">网安智库平台长期招聘兼职研究员</a></span></p></li><li><p><span><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247501251&amp;idx=1&amp;sn=8b6ebecbe80c1c72317948494f87b489&amp;chksm=ebfa82e3dc8d0bf595d039e75b446e14ab96bf63cf8ffc5d553b58248dde3424fb18e6947440&amp;token=525430415&amp;lang=zh_CN&amp;scene=21#wechat_redirect\">欢迎加入“安全内参热点讨论群”</a></span></span></p></li></ul><hr><p><span><span>点击下方卡片关注我们，</span></span></p><p><span><span>带你一起读懂网络安全 ↓</span></span></p><p><a href=\"https://www.secrss.com/?wx\">阅读原文</a></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=400d3218&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzI4NDY2MDMwMw%3D%3D%26mid%3D2247516927%26idx%3D1%26sn%3Deef26e1f7857fef09b3352a6224c3796\">跳转微信打开</a></p>","original","zhKind","complete","数据窃取","供应链","https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&mid=2247516927&idx=1&sn=eef26e1f7857fef09b3352a6224c3796","安全内参",{"_98":99,"_100":-5},"changelogVersion","2026-10-01T08:00","release"]
