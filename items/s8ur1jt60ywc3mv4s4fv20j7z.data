[{"_1":2,"_3":4},"root",{"_5":99},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794444098000,"id","s8ur1jt60ywc3mv4s4fv20j7z","title","日本家具零售商 Nitori 称黑客可能窃取 37.62 million 条客户记录","originalTitle","Japanese furniture giant Nitori says hackers stole 37.6M customer records","summary","日本家具及家居用品零售商 Nitori 表示，第三方未经授权访问其系统，最多 37.62 million 条个人信息可能被外部窃取。","reason","Nitori披露了攻击持续时间、涉及的个人与订单数据类型及37.62 million条记录规模，并说明了账户凭据未暴露和已采取的处置措施，便于相关客户判断风险。","source",{"_73":98},"links",{"_90":97},"publishedAt","2026-11-10T20:54:55.000Z","discoveredAt","2026-11-10T21:00:34.625Z","timelineAt","category","activity","tags",[74,94,95,96],"score",77,"selected",true,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","Bill Toulas","body",{"_61":89,"_90":-5,"_91":92,"_93":37},"outline",[83],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fFyUyqQY6BDU","reportCount",1,"additionalSourceCount",0,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","attack","name","攻击活动","email","邮件与钓鱼","identity","身份与访问",{"_80":81,"_13":82},"publicId","f4dfca78-05b1-4f8a-ad87-9c7fd038f7ff","Nitori披露客户数据外泄",{"_11":84,"_85":86,"_87":88},"sec-1","text","发现现有防御可能遗漏的电子邮件威胁。","level",2,"<p><img alt=\"Japanese furniture giant Nitori says hackers stole 37.6M customer records\" height=\"900\" src=\"/dailyinfo/media/34b96c3f1774d555.jpg\" srcset=\"/dailyinfo/media/c2793c2be0e71754.jpg 720w, /dailyinfo/media/a2d459ac33a94dde.jpg 1200w, /dailyinfo/media/34b96c3f1774d555.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>Nitori 是日本一家大型家具及家居用品零售商，发现攻击者访问了其网络上的一个系统，可能窃取了 3762 万条客户记录。</p><p>入侵于 11 月 6 日被发现，公司阻止了未经授权的访问。然而，对该事件的调查表明，攻击者可能自 10 月中旬以来一直能够访问该系统。</p><p>Nitori 经常被称为“日本的宜家”，是一家大型家具及家居用品零售商，在日本<a href=\"https://www.nitorihd.co.jp/en/index.html\">经营 879 家门店</a>，并在中国、韩国、台湾、泰国、新加坡和香港另外经营 219 家门店。该公司的年营收为 58 亿美元。</p><p><a href=\"https://www.wiz.io/lp/ai-security-starter-pack?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Security-Starter-Kit&amp;sfcid=701Vh00000cn7aRIAQ&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AI-Security-Bundle\"><img src=\"/dailyinfo/media/d3a3a8c45adb5cdd.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>根据公司的通知，此次事件影响通过 Nitori 官方门店和网上商店下单的个人客户、企业会员及非会员。</p><p>“2026 年 11 月 6 日，我们确认第三方未经授权访问了由我们公司管理的系统，”[机器翻译]<a href=\"https://www.nitorihd.co.jp/news/items/2b702dbe4d438f7fef74945d68e5bd27_3.pdf\">公司在通知中表示&nbsp;</a></p><p>“截至目前的调查表明，我们服务器中保存的多达 3762 万条个人信息可能已被泄露到外部。”</p><p>可能暴露的信息包括以下数据类型：</p><ul>\n\t<li>个人会员及购买者：会员编号、姓名、电子邮件地址、邮政地址、电话号码、出生日期和性别。</li>\n\t<li>企业会员：会员编号、公司名称、部门名称、法定代表人姓名、公司地址和电话号码，以及联系人姓名、电子邮件地址和电话号码。</li>\n\t<li>网上订单：通过 Nitori Net 以及电商平台上的 Nitori 官方门店购买所产生的订单信息。</li>\n</ul><p>公司说明，注册会员的账户密码和信用卡信息在此次事件中未被暴露。</p><p>Nitori 表示，已迅速阻止攻击者访问、修复了系统中的漏洞，并加强了威胁监控，以防止未来发生类似事件。</p><p>公司警告可能受影响的客户，泄露的信息可能被用于针对他们实施网络钓鱼攻击和诈骗企图，并敦促他们保持谨慎。</p><p>公告强调，Nitori 绝不会通过电子邮件或电话要求客户提供密码、信用卡号或 PIN。</p><p>Nitori 已告知日本个人信息保护委员会、警方及其他相关主管机关，并承诺通过电子邮件或邮寄方式直接通知受影响的客户。</p><p>BleepingComputer 已就此次事件向 Nitori 提出问题，收到回复后我们将更新本文。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/0c6c2476908e136e.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 代理会分析电子邮件意图、上下文和行为，发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>对 Microsoft 365 或 Google Workspace 进行为期 14 天的只读扫描，看看有哪些威胁正在穿透，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始您的免费电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","数据泄露","钓鱼","凭据","https://www.bleepingcomputer.com/news/security/japanese-furniture-giant-nitori-says-hackers-stole-376m-customer-records/","BleepingComputer",{"_100":101,"_102":-5},"changelogVersion","2026-10-01T08:00","release"]
