[{"_1":2,"_3":4},"root",{"_5":125},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794357637000,"id","h4p9vcjmsjnhvfrc0yxfbnevx","title","Web3Auth 漏洞已被利用盗取 Keplr 加密资产，Google 与 Apple 登录账户受影响","originalTitle","Web3Auth Flaw Exploited to Steal Keplr Crypto, Provider Empties Other Wallets for Safety","summary","攻击者利用 Web3Auth 基础设施安全缺陷进入部分通过 Google 或 Apple 登录创建的 Keplr 钱包并盗取加密资产。Keplr 联合 Web3Auth 将其余风险钱包的资金转移至 11 个 Cosmos 家族链和 8 个以太坊风格链上的恢复钱包，因此余额清空可能是资金获救而非被盗；恢复短语钱包和硬件钱包不受影响。","reason","材料区分了真实盗取与安全转移的资金，并给出受影响账户规模、链上金额和用户处置建议，可用于判断钱包风险与资金状态。","source",{"_78":124},"links",{"_114":123},"publishedAt","2026-11-09T10:56:25.000Z","discoveredAt","2026-11-09T12:04:17.996Z","timelineAt","category","activity","tags",[79,81,118,119,120,121,122],"score",78,"selected",true,"channel","news","story",{"_95":96,"_13":97},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_61":113,"_114":-5,"_115":116,"_117":37},"outline",[98,99,100,101],"relatedStories",[94],"topics",[68,69,70,71,72,73,74,75],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fzKfrA84GC84","reportCount",1,"additionalSourceCount",0,{"_76":92,"_78":93},{"_76":90,"_78":91},{"_76":88,"_78":89},{"_76":86,"_78":87},{"_76":84,"_78":85},{"_76":82,"_78":83},{"_76":80,"_78":81},{"_76":77,"_78":79},"slug","attack","name","攻击活动","exploited","在野利用","black-market","数据窃取与黑产","ransomware","勒索软件","crypto","密码学","identity","身份与访问","apple","Apple / 苹果","google","Google / 谷歌",{"_95":96,"_13":97},"publicId","720a5a16-1362-44a5-b473-36e71e949887","Web3Auth漏洞致Keplr部分钱包资产被盗",{"_11":111,"_103":112,"_105":106},{"_11":109,"_103":110,"_105":106},{"_11":107,"_103":108,"_105":106},{"_11":102,"_103":104,"_105":106},"sec-4","text","Keplr 之外","level",3,"sec-3","资金去了哪里","sec-2","出了什么问题","sec-1","受影响用户应采取的措施","<p><span><i></i><span>Swati Khandelwal</span><i></i><span>2026年11月09日</span></span><span>加密货币 / 漏洞</span></p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhJtevfYXrRQrcU5FKn33bfyWpqN9O6FlI2b1eWOTjNWWslLIM1wwUfpzedZdMvdw6BXqmYqM1PwO-8GH3_IpKOGa15uoiXx5yDTkAal7JOFSKisSYOAHBdRk9XImTowXaCyJlTwX-chPd7uJFCDEq8u9sKY7jW6UYxorQKUSyuH9pF3szdwejvN_HGhno/s1600/kep.jpg\"><img alt=\"\" src=\"/dailyinfo/media/a2d4096f4cf42274.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>有些人使用 Google 或 Apple 账户设置了<strong> Keplr 加密货币钱包</strong>后，钱财被攻击者盗走。</p><p>Keplr 使用一家名为 <strong>Web3Auth </strong>的公司处理 Google 和 Apple 登录。两家公司上周晚些时候表示，攻击者利用了该公司的安全漏洞来访问钱包。</p><p>Web3Auth 随后表示，在攻击者得逞之前，它利用攻击者所用的同一路径清空了其他面临风险的钱包。它在钱包制造商的协助下将这些资金转入恢复钱包妥善保管。因此，余额为零可能意味着资金已被追回，而非被盗。</p><p>钱包制造商表示，使用恢复短语（由 12 或 24 个单词组成的备份列表）或硬件钱包创建的钱包不受影响。目前已暂停 Google 和 Apple 登录，同时调查此事。</p><h3 id=\"sec-1\">受影响用户应采取的措施</h3><p>钱包制造商已针对使用 Google 或 Apple 登录创建的账户，向用户提供以下&nbsp;<a href=\"https://x.com/keplrwallet/status/2119117067500806350\">指导</a>&nbsp;：</p><ul>\n  <li>不要向该账户转入新资金。</li>\n  <li>不要重新导入该账户，也不要在任何地方重新创建该账户。</li>\n  <li>将任何未质押或未锁定的资金转入使用恢复短语或硬件钱包的账户。</li>\n  <li>仅信任钱包制造商和登录提供方的官方账号，忽略提供“恢复”服务的私信或链接。</li>\n</ul><p>质押和锁定的资产需要更长时间才能得到保护。钱包制造商还在与登录提供方合作，寻找一种让用户检查其账户是否受影响的方法。</p><p>与此同时，登录提供方公布了一份&nbsp;<a href=\"https://x.com/Web3Auth/status/2119314957057871935\">恢复地址列表</a>，称该列表可帮助人们区分其自身转账与可能具有恶意的转账。</p><p>该提供方还警告用户，不要想当然地认为陌生的目标地址与攻击者有关。</p><h3 id=\"sec-2\">出了什么问题</h3><p>Web3Auth 在一份&nbsp;<a href=\"https://x.com/Web3Auth/status/2119110953975635985\">事件更新</a>中表示，其自身基础设施中的安全问题影响了 Keplr 应用内由其提供的某些钱包。</p><p>Keplr 进一步表示，该漏洞导致一些使用 Google 或 Apple 登录的用户发生“私钥泄露”。私钥是用于批准钱包付款的秘密代码，因此任何掌握私钥的人都可以转移资金。</p><p>两家公司均未说明该漏洞具体如何运作、攻击者首次利用它的时间，也未说明该路径目前是否已被封堵。</p><h3 id=\"sec-3\">资金去了哪里</h3><p>两家公司均未公布被盗金额的具体数字。Keplr 联合创始人 Josh Lee 在其&nbsp;<a href=\"https://x.com/dogemos/status/2118984142151196677\">初步调查结果</a>中给出了早期估计：约 20% 的 Google 和 Apple 登录账户受到影响，其中只有一小部分似乎遭到利用。</p><p>Web3 安全公司 GoPlus 在一份&nbsp;<a href=\"https://x.com/GoPlusZH/status/2119653595234832716\">安全警报</a>&nbsp;中表示，至少约有 100 万美元被盗，但没有说明该数字的推算依据。</p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgImr84KVZe7Gp82CHccbIKO8EZ2covteeqFMYCRD3troTy2leO3F1iqFyTILxbylc0rfgZC81M9spApfftMVdN6rSIaBxlV0AJwYI8zRCQ3tRtz5YQ-SuyjQe9WBSPPAewGSDU8MyljIMWGceMjeFNbKdLDxyISGVhcfMf2Jy4_wej0N9RrQ2O4weT2cE/s1600/moved.jpg\"><img alt=\"\" src=\"/dailyinfo/media/52bf4d8e279ee195.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>追回的资金被转入登录提供方所称的安全恢复钱包，涉及 Cosmos 系列中的 11 条区块链和 8 条以太坊风格链。</p><p>区块链数据公司 Bitquery 统计发现，截至上周晚些时候，至少有 601 万美元从超过 44,000 个钱包转入恢复钱包。该公司最初将这些转账报告为盗窃事件。此后，它发布了一份&nbsp;<a href=\"https://bitquery.io/investigations/keplr-wallet-hack\">更正分析</a>&nbsp;，将它们视为资金追回，但也表示无法核实由谁控制这些恢复钱包。</p><p>根据该公司的数据，第一笔转账发生在登录提供商首次公开通知前 21 分钟。大多数钱包，即 86%，都是在钱包制造商警告用户后才被清空。</p><p>登录提供商在其<a href=\"https://x.com/Web3Auth/status/2119114305475854345\">恢复讨论帖</a>中表示，被转移的资金是安全的，并正在与钱包制造商合作，将资金返还给用户。该提供商尚未说明将如何以及何时返还。</p><h3 id=\"sec-4\">Keplr 之外</h3><p>登录提供商表示，该问题影响到其被其他一些公司使用的服务，但 Keplr 是其唯一点名提到的公司。该提供商已暂停其嵌入式钱包服务，其他应用会使用这项服务为其用户构建钱包。其<a href=\"https://status.web3auth.io/\">状态页面</a>至今仍将登录服务显示为故障状态。</p><p>MetaMask 钱包背后的公司 Consensys 于 2025 年 6 月收购了该登录提供商。其<a href=\"https://consensys.com/blog/consensys-acquires-web3auth-to-enhance-metamasks-user-experience-user-safety\">收购公告</a>称，这笔交易将让 MetaMask 用户能够使用社交账号登录来创建和恢复钱包。该提供商表示，初步调查发现“没有证据表明 MetaMask 用户受到影响”。</p><p>觉得这篇文章有意思吗？关注我们的 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a>，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","数据窃取","凭据","加密","Google","Apple","https://thehackernews.com/2026/11/web3auth-flaw-exploited-to-steal-keplr.html","The Hacker News",{"_126":127,"_128":-5},"changelogVersion","2026-10-01T08:00","release"]
