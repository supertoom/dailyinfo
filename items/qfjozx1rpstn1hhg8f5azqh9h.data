[{"_1":2,"_3":4},"root",{"_5":138},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":-5,"_56":37,"_57":58},"expiresAt",1795653646000,"id","qfjozx1rpstn1hhg8f5azqh9h","title","GTIG 报告多 Agent 攻击框架、LLMJacking 与 AI 信息操纵已用于在野行动","originalTitle","GTIG AI Threat Tracker: Agentic Threat Activity Crosses a Significant Threshold","summary","GTIG 与 Mandiant 观察到攻击者已把 ARTEX、CAIRN、CyberStrikeAI 和 PentAGI 等多 Agent 框架用于在野入侵、漏洞研究和 LLM 资源滥用，涵盖航空航天目标及亚洲广泛组织扫描。","reason","材料结合 Mandiant 事件响应与在野观测，梳理多 Agent 攻击框架、自动化漏洞利用、LLMJacking 和 AI 辅助信息操纵的实际部署，可用于评估企业 AI 工具与云资源面临的新型滥用风险。","source",{"_66":137},"links",{"_128":136},"publishedAt","2026-11-16T14:00:00.000Z","discoveredAt","2026-11-16T14:56:24.321Z","timelineAt","category","ai-security","tags",[67,132,73,71,133,69,134,135],"score",77,"selected",true,"channel","news","story","x","readingMode","full","author","body",{"_58":127,"_128":-5,"_129":130,"_131":37},"outline",[78,79,80,81,82,83,84,85,86,87,88,89,90,91,92],"relatedStories",[],"topics",[59,60,61,62,63,64],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_65":76,"_66":77},{"_65":74,"_66":75},{"_65":72,"_66":73},{"_65":70,"_66":71},{"_65":68,"_66":69},{"_65":31,"_66":67},"slug","name","AI 安全","research","技术研究","attack","攻击活动","ai-offense","AI 攻防","ai-agent","AI Agent 安全","google","Google / 谷歌",{"_11":125,"_94":126,"_96":97},{"_11":123,"_94":124,"_96":97},{"_11":121,"_94":122,"_96":97},{"_11":119,"_94":120,"_96":97},{"_11":117,"_94":118,"_96":97},{"_11":115,"_94":116,"_96":100},{"_11":113,"_94":114,"_96":97},{"_11":111,"_94":112,"_96":100},{"_11":109,"_94":110,"_96":100},{"_11":107,"_94":108,"_96":97},{"_11":105,"_94":106,"_96":100},{"_11":103,"_94":104,"_96":100},{"_11":101,"_94":102,"_96":97},{"_11":98,"_94":99,"_96":100},{"_11":93,"_94":95,"_96":97},"sec-15","text","安全且负责任地构建 AI","level",3,"sec-14","主动的模型与平台防御",4,"sec-13","Google 如何防范 AI 滥用","sec-12","LLM 工具包提供开箱即用的网络犯罪解决方案","sec-11","政府支持的网络威胁行为者","sec-10","威胁行为者继续利用 AI 提升生产力&nbsp;","sec-9","通过 LLM Mixers 将 LLMJacking 变现","sec-8","事件响应中的 LLMJacking","sec-7","滥用并利用 AI 工具访问权限进行变现的威胁行动者","sec-6","战术性采用 LLM：人口统计微观定向与内容规模化","sec-5","交钥匙式、LLM 赋能影响力行动的商业开发","sec-4","将 LLM 全面整合到信息行动中&nbsp;","sec-3","智能体在漏洞研究与开发中的应用&nbsp;","sec-2","网络入侵中的多智能体框架","sec-1","执行摘要&nbsp;","<p><span>作者：Aurora Blum、Kelli Vanderlee、Jess Xia、David Mainor</span></p><hr><h3 id=\"sec-1\"><span>执行摘要&nbsp;</span></h3><p><span>随着威胁行为者</span><a href=\"https://cloud.google.com/blog/topics/threat-intelligence/from-prompting-to-autonomy-the-evolution-of-adversarial-ai?e=48754805\"><span>日益超越基础提示词编写</span></a><span>，转而部署自主多智能体</span><a href=\"https://cloud.google.com/blog/topics/threat-intelligence/artex-and-friends-enter-agentic-offensive-frameworks\"><span>框架</span></a><span>、自动化漏洞利用流水线和替代性变现手段，如</span><a href=\"https://cloud.google.com/blog/topics/threat-intelligence/llmjacking-monetizing-compromised-cloud-models/?e=48754805\"><span>LLMJacking</span></a><span>，对抗性 AI 格局已到达关键拐点。在本次更新中，Google Threat Intelligence Group (GTIG) 和 Mandiant 考察了网络犯罪、间谍活动和信息行动领域的对手如何将生成式 AI 投入实战，以压缩攻击时间线、扩大行动规模，并以机器速度执行多阶段入侵。</span></p><p><span>过去一个季度的主要趋势包括：</span></p><ul>\n<li>\n<p><strong>转向自主工作流和多智能体框架：</strong><span>对手的作战技术持续从手动提示词转向部署自主多智能体攻击框架，例如 </span><a href=\"https://cloud.google.com/blog/topics/threat-intelligence/artex-and-friends-enter-agentic-offensive-frameworks\"><span>ARTEX</span></a><span>、CAIRN、CyberStrikeAI 和 PentAGI，从而以更高的行动速度执行多阶段入侵。</span></p>\n</li>\n<li>\n<p><strong>自动化漏洞研究与利用：</strong><span>威胁行为者日益利用 LLM 和智能体框架，通过差异分析完全自动化补丁的逆向工程，使其能够快速将 n-day 漏洞武器化，并在无需人工干预的情况下扩大针对互联网暴露服务器的利用流水线。</span></p>\n</li>\n<li>\n<p><strong>变现和基础设施滥用</strong><span>：以牟利为目的的威胁行为者继续通过</span><a href=\"https://cloud.google.com/blog/topics/threat-intelligence/llmjacking-monetizing-compromised-cloud-models\"><span>LLMJacking</span></a><span>获利，即从遭入侵的企业环境中窃取 LLM 凭据和云资源，再通过地下代理服务转售对高性能 AI 模型的访问权限（例如 LLM Mixers）。</span></p>\n</li>\n<li>\n<p><strong>LLM 在信息行动 (IO) 中的整合：</strong><span>国家支持的组织、商业影响力即服务 (IaaS) 供应商和虚假政治变现网络如今在行动中普遍使用 LLM，以大规模生成合成媒体、创建本地化人物形象，并实现跨平台分发的自动化。</span></p>\n</li>\n<li>\n<p><strong>定向间谍活动与供应链演进：</strong><span>网络间谍组织正利用 LLM 开展目标研究、自动化数据分析并开发新型供应链攻击路径，例如操纵自主编码助手配置，使其在本地执行期间植入后门。</span></p>\n</li>\n</ul><p><span>本报告以 Mandiant 一线事件响应行动、全球威胁行为者追踪和实时平台防御所获得的遥测数据为基础，详细说明国家支持的间谍组织、以牟利为目的的网络犯罪分子和 IO 威胁行为者如何在真实环境中将 LLM 投入实战。</span></p><p><span>在 Google，我们致力于大胆且负责任地开发 AI。我们的多层面防御策略整合了主动的模型级防护措施、专门威胁情报和有针对性的遏制协议，以保护我们的客户和基础设施。我们持续加强模型以防止滥用，通过</span><a href=\"https://blog.google/innovation-and-ai/technology/safety-security/combatting-ai-scams/\"><span>主动扰乱</span></a><span>不良行为者的项目和账户来缓解恶意活动，并利用我们的自主 </span><a href=\"https://cloud.google.com/security/ai-threat-defense?e=48754805\"><span>Google AI Threat Defense</span></a><span> 架构和 </span><a href=\"https://blog.google/security/going-beyond-zero-a-new-paradigm-for-enterprise-security/\"><span>BeyondZero</span></a><span>，在企业环境中落实安全防护、持续监控和机器速度响应。</span></p><h3 id=\"sec-2\"><span>网络入侵中的多智能体框架</span></h3><p><span>尽管我们</span><a href=\"https://cloud.google.com/blog/topics/threat-intelligence/from-prompting-to-autonomy-the-evolution-of-adversarial-ai\"><span>季度研究</span></a><span>中记录的早期里程碑突显了攻击者对智能体能力的初步兴趣，但 GTIG 和 Mandiant 现在已经</span><a href=\"https://cloud.google.com/blog/topics/threat-intelligence/artex-and-friends-enter-agentic-offensive-frameworks\"><span>观察到</span></a><span>多个威胁行为者在实际入侵期间滥用开源的智能体渗透测试框架，以自动执行各个阶段和特定运营任务。</span></p><p><span>威胁行为者采用这些框架 represents 了一种范式转变，使入侵以机器速度进行，并自动串联复杂攻击路径，从而显著扩大行动规模。尽管入侵机制保持不变，例如使用已泄露的凭据和针对未打补丁的系统，但框架利用这些已知漏洞的速度和规模带来了新的防御挑战。</span></p><figure><p><img src=\"/dailyinfo/media/3b5d9bed97772ddc.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"https://storage.googleapis.com/gweb-cloudblog-publish/images/Figure_1_Multi-agent_LLM_offensive_framewo.max-2000x2000.jpg\"></p></figure><p>图 1：多智能体 LLM 攻击框架</p><p><span>除了如今</span><a href=\"https://www.wiz.io/blog/artex-in-the-wild-storm-0940-expands-targeting-of-it-and-software-vendors\"><span>广受关注的</span></a><span>渗透测试工具 ARTEX 之外，威胁行为者还在积极利用其他开源多智能体框架，例如 CAIRN、CyberStrikeAI 和 PentAGI。我们还观察到威胁行为者尝试使用定制的测试框架。这些框架具有若干核心能力：发现并利用低复杂度漏洞、使用 LLM 按需生成一次性载荷，以及利用实时执行反馈动态调整战术。&nbsp;</span></p><p><span>GTIG 已独立观察到开源工具 CAIRN 和 PentAGI 被实际部署，并看到对 CyberStrikeAI 和 HexStrike AI 的试验。</span></p><ul>\n<li>\n<p><strong>CAIRN：</strong><span>一个开源多智能体渗透测试框架，实现了 OODA（观察、定位、决策、行动）循环，其中专门的智能体通过共享的“黑板”协作，自主地从初始参数（例如目标 IP 地址）逐步推进至运营目标。GTIG 观察到 CAIRN 被用于针对美国航空航天行业等目标的入侵活动。&nbsp;</span></p>\n</li>\n<li>\n<p><strong>CyberStrikeAI</strong><span>：一个以 LLM 为原生技术的开源攻击框架，作为网络行动的“统一视图”运行。其核心架构由基于 Go 的后端 API 组成，充当 C2 和编排服务器，并连接商业及开放权重 LLM、100 多种安全工具、YAML 攻击配方和自定义脚本，以自动化端到端攻击链。</span></p>\n</li>\n<li>\n<p><strong>HexStrike AI</strong><span>：一个开源的 offensive Model Context Protocol (MCP) 集成框架，使 LLM 客户端能够直接连接至 150 多款预装的 offensive security 工具。该框架采用双组件架构，将涵盖侦察、Web 应用测试、漏洞利用和二进制分析的标准实用工具封装为可调用函数，并由 12 个以上的专用自主子智能体协同调度。</span><strong>&nbsp;</strong></p>\n</li>\n<li>\n<p><strong>PentAGI</strong><span>：一个开源自主 offensive 框架，旨在降低初阶操作人员运行复杂攻击活动的技术门槛。2026 年 8 月下旬至 10 月初期间，GTIG 追踪到一个威胁行为者，该行为者利用基于 PentAGI 开源版本定制构建的攻击编排平台，针对亚洲范围内广泛的多家组织开展了系统性侦察和漏洞扫描。&nbsp;</span></p>\n</li>\n</ul><p><span>我们观察到多个威胁行为者分别尝试使用这些框架和工具，包括以经济利益为动机的行为者，以及疑似与中国关联的间谍活动威胁行为者。有证据表明，一个与中国关联的组织正在开发自己的自动化攻击框架，可能用于网络间谍活动。这些观察还涉及其他工具和服务的使用，例如 ZeroHollow——一种用于漏洞利用开发和 LLM 路由的推理服务，以及 Agent Zero——一种具备自主代码执行和动态工具生成功能的开源智能体框架。</span></p><p><span>鉴于其进入门槛低、集成新漏洞利用便捷且具备大规模扩展潜力，我们认为威胁行为者极有可能继续在针对全球组织的攻击活动中使用这些框架。与此同时，随着能力演进，我们怀疑这些操作将继续向更高程度的自主化推进，接近完全智能体化的入侵。值得注意的是，尽管这些框架能够显著将攻击时间线压缩至机器速度并实现行动目标，但目前它们是以隐蔽性换取速度。不受限制的自主执行会产生取证流量、依赖可识别的标识符，并留下明显的代码层痕迹；尽管这些痕迹增加了被检测和缓解的可能性，但这些工具仍然具备高度实现行动目标的能力。随着这些工具及其底层 LLM 日益成熟，我们预计不仅人类参与这些操作的程度会降低，相关活动的隐蔽性和复杂程度也会提高。</span></p><figure><p><img src=\"/dailyinfo/media/d58bb3d713335a00.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"https://storage.googleapis.com/gweb-cloudblog-publish/images/Figure_2_LLM_maturity_timeline.max-2000x2000.jpg\"></p></figure><p>图 2：LLM 成熟度时间线</p><table>\n<tbody>\n<tr>\n<td>\n<p><strong>缓解措施</strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<p><span>Google Security Operations (SecOps) 已部署专门的行为规则包和流量规则包，以检测 ARTEX 的使用。Mandiant Consulting 发布了一份 </span><a href=\"https://cloud.google.com/blog/topics/threat-intelligence/artex-and-friends-enter-agentic-offensive-frameworks?e=48754805\"><span>加固指南</span></a><span>，以及专门用于抵消使用 LLM 赋能 offensive 工具的对手所具备的速度和规模优势的架构防御框架。</span></p>\n</td>\n</tr>\n</tbody>\n</table><h3 id=\"sec-3\"><span>智能体在漏洞研究与开发中的应用&nbsp;</span></h3><p><span>将自主 LLM 智能体融入漏洞研究和软件安全工作流，已经从理论实验转向实际的行动部署。&nbsp;</span></p><p><span>对手正在利用多智能体系统和由 LLM 驱动的流水线，自动化漏洞分析中劳动密集型的阶段，例如差异化补丁审查、动态协议模糊测试以及概念验证（POC）武器化。通过将这些能力串联起来，威胁行为者可以大幅缩短补丁公开与武器化利用之间的窗口。威胁行为者可能会发现，使用 LLM 快速将已修补的 n-day 漏洞武器化更加高效，因为他们可以将研究集中于一组有限的源材料：比较源代码版本（包括预发布或预览渠道中的版本），以及检查与特定缺陷有关的发布说明、安全研究和 POC 代码。相比之下，搜寻零日漏洞需要撒开更大的网。LLM 正在改变公共和企业基础设施中漏洞的发现与利用方式，缩短组织的补丁窗口。与此同时，更低的入门门槛催生了一波由 LLM 生成的利用代码，这些代码声称可用但实际上无法奏效，从而给防御者增加了额外的验证工作。</span></p><p><span>例如，2026 年 9 月，GTIG </span><a href=\"https://cloud.google.com/blog/topics/threat-intelligence/vulnerability-discovery-and-exploitation-trends-in-the-ai-era\"><span>分析了</span></a><span>漏洞统计数据，以评估 LLM 如何塑造威胁态势。我们发现，LLM 不仅正在改变漏洞发现和利用的速度，也在改变被发现缺陷的类型和风险特征。有趣的是，虽然 2026 年 1 月至 8 月期间的总体披露数量和利用数量几乎翻了一番，但零日利用仅从 2025 年平均每月 8 起小幅上升至 2026 年每月 11 起——随后在 8 月当月激增至 22 起。</span></p><figure><p><img src=\"/dailyinfo/media/311a83799aad795f.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"https://storage.googleapis.com/gweb-cloudblog-publish/images/Figure_3_Count_of_vulnerabilities_exploite.max-2000x2000.jpg\"></p></figure><p>图 3：按 n-day 和零日漏洞利用统计的漏洞数量，2025 年 1 月至 2026 年 8 月</p><p><span>在我们之前的</span><a href=\"https://cloud.google.com/blog/topics/threat-intelligence/from-prompting-to-autonomy-the-evolution-of-adversarial-ai\"><span>报告</span></a><span>中，我们详细介绍了威胁行为者围绕 LLM 增强型漏洞研究所作的新兴尝试，包括部分自动化的漏洞扫描和利用攻击序列。&nbsp;</span></p><p><span>在过去一个季度，GTIG 首次发现威胁行为者使用 LLM 框架，在没有人类介入的情况下完全自动化漏洞发现和利用。&nbsp;</span></p><p><span>更具体地说，GTIG 发现了一个暴露在外的预发布服务器，该服务器托管着一个名为 </span><code>exploit_agent</code><span>的多智能体漏洞研究与武器化框架，可与多种前沿和本地 LLM 集成。该框架旨在对流行的 Web 应用软件进行持续差异分析。它会比较补丁公告前后的代码，分析研究结果以识别潜在漏洞，起草利用代码，并在没有人工干预的情况下自动执行这些利用代码。除了从目标受害者处外泄的数据外，我们还发现了多个脚本，可协助开展各种攻陷后活动，包括内部侦察暴力破解、安装 Web shell，以及移除其他攻击者的 Web shell。服务器上的受害者遥测数据显示，操作者特别关注与媒体和娱乐行业相关的法国网站，以及教育行业。 </span></p><pre><code>// Insecure capability check analyzed in v21925.php:\npublic static function restrict_popup_rest_access( $result ) {\n    if ( is_wp_error( $result ) ) {\n        return $result;\n    }\n    $route = isset( $_SERVER['REQUEST_URI'] ) ? sanitize_text_field( wp_unslash( $_SERVER['REQUEST_URI'] ) ) : '';\n    if ( false === strpos( $route, '/wp/v2/spectra-popup' ) ) {\n        return $result;\n    }\n    if ( is_user_logged_in() &amp;&amp; current_user_can( 'manage_options' ) ) {\n        return $result;\n    }\n    return new WP_Error(\n        'rest_forbidden',\n        __( 'Sorry, you are not allowed to access popups.', 'ultimate-addons-for-gutenberg' ),\n        array( 'status' =&gt; rest_authorization_required_code() )\n    );\n}</code></pre><p><em>图 4：智能体框架检查 Spectra（Ultimate Addons for Gutenberg）WordPress 插件 2.19.25 版本中的访问控制实现</em></p><table>\n<tbody>\n<tr>\n<td>\n<p><strong>俄语评论</strong></p>\n</td>\n<td>\n<p><strong>评论已翻译成英文</strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<p><code># LLM API-ключи для авто-эксплуатации (пилот exploit_agent)</code></p>\n<p><code># Впиши ключи сам — сюда, не в чат. Обе строки обязательны.</code></p>\n</td>\n<td>\n<p><code># LLM API keys for auto-exploitation (exploit_agent pilot)</code></p>\n<p><code># Enter the keys yourself — right here, not in the chat. Both lines are required.</code></p>\n</td>\n</tr>\n</tbody>\n</table><p><em>表 1：来自环境文件的评论，该文件为自主利用配置了多个 LLM API 密钥</em></p><p><span>开源研究证实，威胁行为者已将全自动漏洞利用流水线投入实际运行。例如，在 2026 年 8 月下旬，威胁行为者利用了 PaperCut 打印管理服务器中的两个漏洞，且将其作为零日漏洞利用：这两个漏洞串联后可实现未经身份验证的远程代码执行，分别是 CVE-2026-81578（身份验证绕过漏洞）和 CVE-2026-82078（不安全的动态类加载漏洞）。安全</span><a href=\"https://x.com/KevTheHermit/status/2093130345235304703\"><span>研究人员</span></a><span>以及网络安全公司 </span><a href=\"https://www.huntress.com/blog/papercut-actively-exploited\"><span>Huntress</span></a><span>利用 LLM，在漏洞披露后一天内为这些漏洞生成了可用的利用代码。</span><a href=\"https://www.greynoise.io/blog/ai-orchestrated-campaign-against-papercut-ng-mf\"><span>Greynoise</span></a><span>报告了一场在首次披露四天后发生的攻击活动，其中威胁行为者很可能使用 LLM 为这些漏洞构建并测试利用代码、汇编目标列表，并针对数百家组织执行大规模漏洞利用活动。Greynoise 还强调了其执行速度，指出该威胁行为者在数分钟内将最初的立足点扩展为域管理员权限。&nbsp;</span></p><p><span>PHP 漏洞（CVE-2026-109618 和 CVE-2026-109619）也凸显了其中多项趋势。这些漏洞是通过启用 LLM 的分析发现的。在 2026 年 10 月 21 日官方补丁发布之前，一段 POC </span><a href=\"https://x.com/IntCyberDigest/status/2112857999647617275?lang=en\"><span>视频</span></a><span>以及早期的</span><a href=\"https://www.forrester.com/blogs/php2shell-had-teeth-but-the-real-story-is-the-eclectic-mayhem/\"><span>补丁代码</span></a><span>便已发布。这使研究人员和攻击者都能比较代码版本、理解漏洞，并尝试在补丁可用前构建利用代码。在官方补丁发布后的最初几天里，</span><a href=\"https://www.ahnlab.com/en/contents/content-center/36343\"><span>数百个</span></a><span>声称有效但实际上无法运行的 POC 被发布，这些 POC 很可能是在 LLM 的帮助下生成的。如此泛滥给安全社区带来了大量工作，需要验证或驳斥这些 POC，同时监测已确认遭到利用的证据。&nbsp;</span></p><table>\n<tbody>\n<tr>\n<td>\n<p><strong>缓解措施</strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<p><span>Google 持续投资 AI 创新与研究，帮助确保</span><a href=\"https://ai.google/static/documents/ai-responsibility-update-published-february-2025.pdf\"><span>负责任地构建 AI</span></a><span>，并确保我们利用其潜力自动发现风险。2024 年，我们推出了 </span><a href=\"https://blog.google/technology/safety-security/cybersecurity-updates-summer-2025/\"><span>Big Sleep</span></a><span>，这是由 Google DeepMind 和 Google Project Zero 开发的 AI 智能体，能够主动搜索并发现软件中的未知安全漏洞。Google Cloud </span><a href=\"https://docs.cloud.google.com/docs/security/overview/whitepaper\"><span>采用</span></a><span>纵深防御模型，将严格的代码审查和安全默认库与使用 </span><a href=\"https://deepmind.google/discover/blog/introducing-codemender-an-ai-agent-for-code-security/\"><span>CodeMender</span></a><span> 等专用 AI 智能体的持续自动化扫描相结合，在发布前后发现、修补和修复漏洞。我们通过运行漏洞奖励计划并维护 Project Zero，与全球安全社区合作，主动发现并修补零日漏洞。</span></p>\n</td>\n</tr>\n</tbody>\n</table><h3 id=\"sec-4\"><span>将 LLM 全面整合到信息行动中</span><strong>&nbsp;</strong></h3><p><span>GTIG 有高度信心地评估，信息行动（IO）威胁行为体已从最初的 LLM 试验阶段发展到全面融入实际行动。在其追踪的所有类别中——包括被归因于俄罗斯、中国和伊朗的国家支持团体、商业性“影响力即服务”（IaaS）供应商，以及非真实性政治变现（IPM）网络——对手如今例行将 LLM 嵌入其标准行动手法中，以生成合成媒体并自动化域名网络工作流（例如，利用 LLM 协助进行 SEO 操纵、编辑和格式化预置文章，以及自动生成和发布影响力内容）。这种广泛采用已切实提升了部分长期影响力活动的内容输出质量，同时使 IPM 网络能够规模化生产政治标题党，呈现出历史上具有国家支持的 IO 活动所特有的主题重点、质量和数量。然而，需要注意的是，内容质量的提升并不一定意味着影响力或成功率会提高。</span></p><table>\n<tbody>\n<tr>\n<td>\n<p><strong>IO 行为体类别</strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<p><strong>国家支持团体 </strong><span>是与国家机构直接关联的 IO 行为体，传统上一直是平台防御人员和研究人员追踪的主要基线对象。为保持合理的推诿空间，它们日益依赖第三方商业承包商代其执行活动。</span></p>\n</td>\n</tr>\n<tr>\n<td>\n<p><strong>商业 IaaS 供应商</strong><span>包括营销和公关机构、私人情报承包商以及商业监控供应商的分支机构，销售从定制化影响力活动到交钥匙平台不一的服务。该生态系统中各方的行动手法有所不同；尤其是情报承包商和监控业务分支，通常会采用比传统国家支持行为体更严格的行动安全（OPSEC）措施和更先进的技术。</span></p>\n</td>\n</tr>\n<tr>\n<td>\n<p><strong>非真实性政治变现（IPM）网络</strong><span>以利润而非意识形态为驱动。这些行为体大量生成政治标题党，以推动互动量、最大化点击率并提升广告收入。政治叙事与大规模合成内容的结合，造成了显著的前端感知落差，使 IPM 网络活动最容易被误判为国家支持行动。&nbsp;</span></p>\n</td>\n</tr>\n</tbody>\n</table><p><em>表 2：IO 行为体类别</em></p><p><span>随着自动化内容生成减少了主要的行动瓶颈，对手正日益将重点转向利用 LLM 进行基础设施设计、自动化分发管线和反检测机制设计。具体而言，我们的观察显示出一个明显趋势：支持并自动化完整影响力活动周期的、由 LLM 赋能的端到端 IaaS 平台正转向商业开发。这类平台的激增可以降低国家和商业行为体的行动开销，同时增加跨社交媒体平台检测协调行为和非真实性行为的难度。</span></p><h3 id=\"sec-5\"><span>交钥匙式、LLM 赋能影响力行动的商业开发</span></h3><p><span>2026 年 8 月，GTIG 调查了利用 Gemini API 以及多家 AI 提供商的工具构建端到端 IaaS 平台的威胁活动。该平台旨在针对地区政治话题引导公众舆论，主要覆盖欧洲和中东。该平台被设计为自动化整个 IO 活动生命周期，包括人物角色创建、多模态媒体生成、自动内容分发以及跨平台互动发帖。发现的提示词反映出其运营重点是模拟真实的草根参与（即“astroturfing”），同时规避平台检测规则。</span></p><ul>\n<li>\n<p><span>发现的提示词指示模型采用针对目标地理区域的本地化人物角色，模仿地区方言和俚语，同时使用非正式措辞和故意设置的拼写错误，以免听起来像自动化工具。&nbsp;</span></p>\n</li>\n<li>\n<p><span>用于支持媒体生成的提示词引入了刻意的相机缺陷，以模拟通常由智能手机相机拍摄的真实照片（例如，使图像显得有颗粒感，或加入不均匀的光线变化），并省略背景文字，以避免出现合成图像标记。</span></p>\n</li>\n<li>\n<p><span>为规避社交媒体平台的防御机制，操作人员通过住宅代理路由流量，并保留已保存的登录 Cookie。此设置旨在使自动化工具持续保持活跃的已认证访问，避免触发 CAPTCHA 和登录重新验证等安全检查。</span></p>\n</li>\n</ul><p><span>GTIG 还发现另一家商业承包商在开发模块化、多提供商 AI 架构期间利用 Gemini API 构建交钥匙 IaaS 平台，该平台旨在管理全球主要平台上超过 100,000 个账户。该平台结合了自动化代理、反检测和设备标识符伪造工具以及云端手机农场，以跨平台运营数千个虚假人物角色。观察到的提示词显示，该行为者计划将该工具同时卖给其所在国家的政府机构和外国客户，用于执行影响力活动。</span></p><ul>\n<li>\n<p><span>为管理大量社交媒体账户，该平台被设计为在云环境中运行虚拟智能手机——将每台虚拟设备伪装成合法的移动设备——并通过代理路由 Web 流量，以绕过自动机器人检测和速率限制。</span></p>\n</li>\n<li>\n<p><span>该架构还包括使用一次性电子邮件地址和境外虚拟 SMS 号码自动创建虚假账户。为避免引起进一步怀疑，新建账户被配置为经历自动化养号期，利用 LLM 模拟真实用户行为（例如用户在帖子上的停留时长、滚动操作以及与非活动内容互动），在推送目标信息之前建立正常活动历史。</span></p>\n</li>\n</ul><h4 id=\"sec-6\"><span>战术性采用 LLM：人口统计微观定向与内容规模化</span></h4><p><span>除开发 IaaS 软件套件外，威胁行为者仍持续将商业 LLM 工具整合进基础内容工作流，以克服语言障碍、定制信息并扩大产出规模。在内容层使用商业模型生成评论、合成人物角色和风格化动画，使 IO 行为者能够提升其活动的可信度和人口统计群体共鸣，同时让 IPM 网络能够大规模生产政治标题党内容以获取广告收入。</span></p><ul>\n<li>\n<p><strong>LLM 赋能的长周期 IaaS 行动质量提升：</strong><span> 自上次报告以来，GTIG 观察到一家自 2019 年起持续追踪的长周期 IaaS 服务提供商利用 LLM 提升其影响行动的基础质量和规模。该提供商使用一套专有软件套件，在各大平台管理数千个合成资料，随后在多个国家针对政治话语开展行动。行动人员整合 LLM 模型，以生成更具说服力的虚拟人物，以及聚焦政治、宗教和民权议题的学术风格评论和媒体内容。随后，这些生成的内容通过虚构的西方人物身份在各平台进行推广和放大。&nbsp;</span></p>\n</li>\n<li>\n<p><strong>通过合成内容进行人口统计特征定向： </strong><span> 我们观察到威胁行动者使用 LLM 生成的内容，针对特定地区和受众定制语境，例如使用合成网红人物推广针对特定人口统计群体的政策叙事。另一个网络发布了受乐高积木启发的合成动画和足球恶搞内容，以讽刺全球政治人物；这很可能是为了通过将宣传包装成符合热门互联网文化的短视频形式，吸引更年轻的受众。</span></p>\n</li>\n<li>\n<p><strong>LLM 增强的非真实性政治变现（IPM）：</strong><span> GTIG 还追踪到 IPM 行动者利用 LLM 批量生产政治内容的趋势正在增长。尽管这些非意识形态行动在主题重点、质量和规模上可能与国家支持的 IO 行动类似，但它们仅为最大化互动量、点击率和广告收入而利用社会极化。GTIG 观察到，IPM 行动者会提示商业 LLM 识别有利可图的政治话题、热门关键词和高千次展示成本（CPM）的广告变现细分领域，同时通过合成新闻主播推广由此生成的内容；这些主播有时会模仿真实记者和评论员的外貌，以制造可信度。</span></p>\n</li>\n</ul><table>\n<tbody>\n<tr>\n<td>\n<p><strong>缓解措施</strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<p><span>GTIG 与产品团队密切合作，依据我们的标准平台政策，对受影响的 Google 各个界面上的 IO 行动者采取行动。我们的研究和严谨分析使 Google 团队能够作出执法决定，并瓦解协同发起的 IO 行动。GITG、YouTube 和 Google Trust &amp; Safety 会追踪与协同 IO 账号相关的发布内容和评论，并定期执行相关政策。此类执法的示例包括：中断 YouTube 频道、博客、AdSense 账号，以及从 Google News 界面中移除域名；我们会在 </span><a href=\"https://blog.google/security/influence-operations-bulletin-q2-2026/\"><span>《影响行动公告》</span></a><span>中按季度报告这些情况。</span></p>\n<p><span>除执法行动外，GTIG 还与 Google DeepMind 共享情报，以加强我们的平台和服务，抵御不断演化的行动技术。这些情报用于建立滥用行为基线、增强 Gemini 识别和拒绝滥用行为的能力，并为内部政策调整提供依据。</span></p>\n</td>\n</tr>\n</tbody>\n</table><h3 id=\"sec-7\"><span>滥用并利用 AI 工具访问权限进行变现的威胁行动者</span></h3><p><span>虽然被盗凭据长期以来一直是入侵期间获取初始访问权限、提权和横向移动的根本基础，但攻击者正越来越多地重新利用被盗凭据和计算资源，为未经授权的 LLM 工具和自主运行管线提供支持。由于访问成本、token 速率限制和地理限制给试图扩展 LLM 能力的威胁行为体带来持续性运营障碍，攻击者正在直接从受害者终端和持续集成环境中收集会话 token 与平台凭据。与此同时，随着这种转向劫持有效 LLM 凭据的趋势，地下网络犯罪论坛和非法市场已迅速成熟以满足这一需求——其业务已从通用的身份信息转储，扩展到将经过验证的前沿 AI 账户、token 化 API 配额以及针对性 infostealer 配置商品化为开箱即用的工具，供下游利用。</span></p><h4 id=\"sec-8\"><span>事件响应中的 LLMJacking</span></h4><p><span>整个 2026 年，Mandiant 响应了多起 LLMJacking 事件，其中以牟利为目的的行为体入侵云环境，以消耗目标组织的云计算资源和/或 LLM 资源配额。如下方图片所示，LLMJacking 可在数小时内造成用量和账单大幅增加。在某些情况下，单日欺诈收费超过 100,000 美元。在最严重的情况下，在完成修复前，累计资源滥用达到 100 万美元。</span></p><figure><p><img src=\"/dailyinfo/media/d54aba23518426e3.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"https://storage.googleapis.com/gweb-cloudblog-publish/images/Figure_5_Usage_chart_showing_LLMJacking_ge.max-2000x2000.jpg\"></p></figure><p>图 5：显示 LLMJacking 导致 API 请求量激增的用量图表</p><p><span>11 月，Mandiant 和 GTIG </span><a href=\"https://cloud.google.com/blog/topics/threat-intelligence/llmjacking-monetizing-compromised-cloud-models\"><span>描述了</span></a><span>我们在影响北美、南美和亚太地区金融服务、零售、运输及技术组织的入侵活动中观察到的一组常见 TTP。&nbsp;</span></p><table>\n<tbody>\n<tr>\n<td>\n<p><strong>攻击生命周期阶段</strong></p>\n</td>\n<td>\n<p><strong>观察到的战术描述</strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<p><strong>初始访问</strong></p>\n</td>\n<td>\n<p><span>威胁行为体经常使用凭据窃取和会话劫持来获取目标环境的访问权限，包括从公开 GitHub 仓库收集有效凭据，以及利用欺骗性网站进行社会工程，诱骗用户提供有效的会话 token。&nbsp;</span></p>\n</td>\n</tr>\n<tr>\n<td>\n<p><strong>内部侦察与横向移动</strong></p>\n</td>\n<td>\n<p><span>攻击者为识别感兴趣的凭据和系统，对内部代码仓库、数据存储、云服务、容器和访问日志开展侦察。至少在一个案例中，威胁行为体利用了运行于内部容器中的软件包所疑似的 Web 应用程序漏洞，访问了其他系统。</span></p>\n</td>\n</tr>\n<tr>\n<td>\n<p><strong>提权与持久化</strong></p>\n</td>\n<td>\n<p><span>威胁行为体创建了未经授权的 IAM 和服务账户，或为服务角色附加了管理员策略。我们还观察到一名威胁行为体利用了 CVE-2026-40217，这是 LiteLLM 中的一个沙箱逃逸漏洞，允许攻击者将有限访问权限的推理密钥（\"Virtual Keys\"）提升为完整管理员凭据。特权服务账户无需使用恶意软件即可建立持久化。&nbsp;</span></p>\n</td>\n</tr>\n<tr>\n<td>\n<p><strong>完成任务：滥用 LLM&nbsp;</strong></p>\n</td>\n<td>\n<p><span>在组织内部的云环境中，攻击者启用了 LLM 服务，包括让被盗账户订阅按量付费协议。为绕过速率限制，一名威胁行动者采用了“烧掉并轮换”策略，创建并删除短时有效的服务账户。其他威胁行动者滥用云计算资源，配置配备强大 GPU 的实例，并申请提高配额，以运行他们自己的 LLM 工具。其中包括智能体框架，一名威胁行动者利用它进一步自动攻击已入侵的网络；还包括开源 API 网关和自定义中继基础设施，用于协助销售对已入侵组织资源的访问权限。&nbsp;</span></p>\n</td>\n</tr>\n</tbody>\n</table><p><span>表 3：LLMJacking 入侵中观察到的常见 TTP</span></p><p><span>在另一次调查中，我们观察到至少两名不同的攻击者试图开展 LLMJacking 行动。两名行动者均使用同一组合法凭据访问目标环境，这些凭据可能已在地下论坛中被出售或泄露。第一名威胁行动者使用合法凭据获取环境访问权限，枚举可用的 LLM 服务，并查询与该账户有关的成本和使用信息。同一天，我们观察到一组 IP 地址使用相同的 User-Agent 访问该环境，同样使用这些合法凭据；这很可能是僵尸网络或代理服务。在凭据被撤销前，该僵尸网络或代理服务在约 24 小时内生成了数百万次 LLM API 调用。尽管第一名威胁行动者返回了该环境，并创建了具备查询 LLM 权限的服务账户，但该僵尸网络的高噪声活动促使相关方面在被入侵凭据得到修复前采取了处置措施，因此该威胁行动者未能执行 LLM 查询。</span></p><p><span>有关防御 LLMJacking 入侵的加固与缓解指导，</span><a href=\"https://cloud.google.com/blog/topics/threat-intelligence/llmjacking-monetizing-compromised-cloud-models\"><span>请参阅我们的博客文章</span></a><span>。&nbsp;</span></p><h4 id=\"sec-9\"><span>通过 LLM Mixers 将 LLMJacking 变现</span></h4><p><span>威胁行动者经常通过销售对已入侵计算资源和 LLM 资源的访问权限，将 LLMJacking 入侵变现。除了 LLMJacking 日益兴起之外，GTIG 还在追踪“LLM Mixers”的扩散——这些非法商店向买家提供对 LLM 服务及其底层代理基础设施的未授权访问。该基础设施将买家流量路由至由被盗凭据和计算实例组成的池中，以确保访问可靠，同时还能够将查询流量分散到多个受害环境中，从而降低被检测的可能性。&nbsp;</span></p><p><span>LLM Mixer 生态系统与更广泛的网络犯罪市场相似，在后者中，专业化威胁组织负责供应链的各个独立阶段。例如，LLM Mixer 运营者负责维护基础设施并满足客户需求，同时可能与独立的威胁行动者合作，由后者获取对已入侵环境的初始访问权限、从信息窃取器运营者处购买已入侵凭据，或招募合作伙伴大规模注册免费试用账户。&nbsp;</span></p><p><span>GTIG 分析了俄语和中文地下市场上众多 LLMJacking 供应商的广告，发现大多数服务都提供对多个模型的访问，其中包括前沿模型和越狱模型，这些模型宣传支持恶意网络活动。广告定价因各个混合平台以及所提供的模型和凭据类型而有很大差异；例如，免费试用凭据的价格远低于企业级凭据。我们观察到，每百万 token 的价格从 0.10 美元到 25 美元不等。其中一家供应商 APIMart 会在提示词超过 100,000 个 token 后，对输入和输出均适用 5 倍加价。一些供应商（如 JetNight）不按每百万 token 定价，而是根据所提供的模型类型，以不同价格提供月度订阅。</span></p><figure><p><img src=\"/dailyinfo/media/3d0bbcc927c7e66a.webp\" loading=\"lazy\" decoding=\"async\" alt=\"https://storage.googleapis.com/gweb-cloudblog-publish/images/Figure_6_APIMart_advertised_prices.max-1400x1400.png\"></p></figure><p>图 6：APIMart 的广告价格</p><h3 id=\"sec-10\"><span>威胁行为者继续利用 AI 提升生产力</span><strong>&nbsp;</strong></h3><p><span>自我们上一份</span><a href=\"https://cloud.google.com/blog/topics/threat-intelligence/from-prompting-to-autonomy-the-evolution-of-adversarial-ai\"><span>报告</span></a><span>发布以来，GTIG 持续观察到威胁行为者利用 LLM 来增强攻击生命周期的各个阶段。然而，LLM 工具的广泛采用也带来了显著的运营劣势。许多 LLM 工具流程在取证方面会产生大量噪声，可能削弱 OPSEC 并损害隐蔽性，从而对间谍活动造成不利影响。此外，LLM 还会降低运营可靠性，因为对手必须应对模型的局限性，包括幻觉出并不存在的细节，甚至目标。因此，我们预计，那些专注于旨在维持长期持久性的隐蔽行动的行为者，在针对性环境中不太可能依赖取证噪声较大的工具；不过，他们可能根据运营优先级，有选择地使用这些工具来提高速度和扩大规模。相反，我们高度确信，包括许多网络犯罪行为者在内、对运营隐蔽性不太关注的行为者，将继续把自主攻击工具纳入其行动，因为其活动覆盖范围的扩大很可能抵消成功率的下降。&nbsp;</span></p><h4 id=\"sec-11\"><span>政府支持的网络威胁行为者</span></h4><p><span>国家支持的网络威胁行为者继续在各自行动中利用 LLM，进一步印证了我们在此前报告中传达的基线评估。例如，我们继续看到 CALANQUE ION（一个伊朗政府支持的行为者，此前被追踪为 </span><a href=\"https://cloud.google.com/blog/topics/threat-intelligence/untangling-iran-apt42-operations?e=48754805\"><span>APT42</span></a><span>）利用 LLM（包括 Gemini）来增强侦察和定向社会工程活动。我们还看到与中国有关联的网络威胁行为者利用 LLM 开展侦察和研究。除了这一利用 LLM 的新基线行为者群体之外，我们还观察到以下活动：&nbsp;</span></p><p><span>2026 年第三季度，与中国有关联的网络间谍行为者使用 LLM 工具和模型开展侦察、前端扫描、研究各行业和各地区的目标，以及武器化漏洞利用。&nbsp;</span></p><ul>\n<li>\n<p><span>我们还观察到威胁行为者使用 LLM 开展失陷后数据分析。其中包括中国承包商组织 LEAKY CASTLE，这与</span><a href=\"https://www.wsj.com/tech/how-a-chinese-hacking-firm-tapped-ai-to-supercharge-cyber-spying-b577c846\"><span>公开报道</span></a><span>中关于某承包商使用 LLM 分析、翻译和理解外泄数据的内容相重叠，包括从中推断组织结构方面的信息，并将其添加到成品情报报告中出售给客户。</span></p>\n</li>\n<li>\n<p><span>我们观察到一种新趋势：与中华人民共和国有关联的攻击者滥用 LLM 平台和文件托管后端进行暂存、充当 dead drop C2 以及数据外泄。在一个示例中，威胁行为者滥用前沿模型的文件托管基础设施来暂存诱饵归档和外泄被盗数据，并利用后端 API 外泄被盗的内网文档。</span></p>\n</li>\n</ul><p><span>我们还持续观察到朝鲜（Democratic People’s Republic of Korea，DPRK）的威胁行为者使用 LLM 工具支持朝鲜 IT 工作人员活动，例如生成简历以及准备在西方组织求职面试。朝鲜威胁行为者还在滥用生成式工具扩大行动规模，并将原生代理执行钩子作为企业访问途径加以利用。</span></p><ul>\n<li>\n<p><span>我们观察到有人使用面向公众的工具在求职筛选过程中生成回复，使其听起来更真实可信，同时冒充西方 IT 工作人员以获得远程就业。</span></p>\n</li>\n</ul><p><span>尽管我们持续看到朝鲜攻击者利用由 LLM 驱动的工具生成诱饵内容和辅助编码，但在 2026 年期间，我们观察到其战术发生了演变。在多起入侵事件中，一个疑似属于 MIDNIGHT NEPTUNE 的威胁集群将启用 LLM 的社会工程手法与滥用组织 AI 工具作为供应链攻击途径相结合。&nbsp;</span></p><ul>\n<li>\n<p><span>在近期针对北美和欧洲加密货币组织的入侵中，该威胁行为者利用 LLM 软件架构作为横向执行面。为获得初始访问权限，该行为者在专业社交网络平台上创建虚假的招聘人员资料，其资料图片带有 SynthID 水印，确认其使用 LLM 合成具有欺骗性的职业身份。这些身份将目标引向虚假的会议平台，其中包含“ClickFix”社会工程诱饵，诱使目标运行诊断修复脚本，而这些脚本通过 ClickFix 诱饵执行可能由 LLM 编写的暂存脚本。初始失陷后，该行为者转向内部代码仓库，执行该组织内部的供应链攻击途径：修改</span><code>.claude/settings.json</code><span>配置文件，使用户启动 Claude Code 时自动触发 SOMBERMEME 后门的下载。为维持隐蔽性，疑似 MIDNIGHT NEPTUNE 进一步通过生成以 Microsoft Copilot 命名的 GitHub 个人访问令牌（PAT）来掩盖其横向移动，这凸显了威胁行为者同时滥用生成式工具扩大行动规模，并将原生 AI 代理执行钩子作为企业访问途径加以利用。</span></p>\n</li>\n</ul><h4 id=\"sec-12\"><span>LLM 工具包提供开箱即用的网络犯罪解决方案</span></h4><p><span>在最近一季度的动态中，除了在以经济利益为目的的活动中使用攻击框架外，我们还观察到网络犯罪分子利用 LLM 为客户扩展工具；例如，钓鱼即服务（PhaaS）运营者使用 LLM 为技术能力较低的对手创建工具。Jieyou 钓鱼服务是一个活跃的中文 PhaaS 平台，最早于 2026 年 3 月被发现，主要被网络犯罪分子用于部署和管理极具说服力的钓鱼活动，尤其专注于电子商务欺诈。该服务在其 2026 年 6 月的后端更新中引入了一款 LLM 聊天机器人助手。这款聊天机器人使威胁行为者能够轻松配置钓鱼面板，并使用自然语言命令修改现有模板，显著降低了部署钓鱼活动的技术门槛。该后端聊天机器人不依赖特定模型，并通过 API 与多个前沿及开源平台集成。Jieyou 平台的演进凸显了一个日益明显的行业趋势：PhaaS 提供者将 LLM 作为模块化的力量倍增器。低级技能的下线人员如今无需手动编辑载荷，即可通过聊天机器人使用自然语言，动态定制借口诱饵和钓鱼界面。</span></p><table>\n<tbody>\n<tr>\n<td>\n<p><strong>缓解措施</strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<p><span>这些活动触发了 Gemini 的安全响应，Google 还采取了更广泛、协调一致的行动来破坏威胁行为者的活动。此外，我们已对这些行为者采取行动，禁用了与此次活动相关的资产，并进行更新以防止进一步滥用。Google DeepMind 利用这些见解强化了分类器和模型，使其能够拒绝协助实施这类攻击。</span></p>\n</td>\n</tr>\n</tbody>\n</table><h3 id=\"sec-13\"><span>Google 如何防范 AI 滥用</span></h3><p><span>Google 采用多层面的防御战略保护我们的用户和基础设施免受 LLM 滥用，将主动的模型级防护措施、专门威胁情报、定向遏制协议以及主动的 </span><a href=\"https://blog.google/security/the-evolving-role-of-the-red-team-in-the-era-of-agentic-security/\"><span>红队测试</span></a><span> 相结合，以模拟威胁并提供防护。 </span><span>此外，随着创新不断推进，行业需要制定负责任地构建和部署 AI 的安全标准，因此我们推出了 </span><a href=\"https://blog.google/technology/safety-security/introducing-googles-secure-ai-framework/\"><span>Secure AI Framework（SAIF）</span></a><span>，这是一个用于保护 AI 系统的概念框架。&nbsp;</span></p><h4 id=\"sec-14\"><span>主动的模型与平台防御</span></h4><p><span>我们持续强化模型，防止其被滥用，方式是将从主动威胁监控中获得的见解直接输入我们的安全分类器和防护机制。</span><span> </span><span>例如，为应对模型提取或“蒸馏”攻击，我们部署了实时防御措施，旨在降低未经授权的“学生”模型的性能，并检测克隆专有逻辑的企图。</span><span> </span><span>当我们识别出恶意行为者时，会直接采取行动破坏其运营，禁用相关项目和账户。</span></p><p><span>为了将这些保护措施扩展到企业客户，我们开发了 </span><a href=\"https://cloud.google.com/security/ai-threat-defense\"><span>Google AI Threat Defense (AITD)</span></a><span>。 </span><span>这一自主架构将 Gemini 和其他前沿模型的推理能力、Wiz 的风险 prioritization、Gemini 和 CodeMender 的自动修复能力，以及 Mandiant 的一线情报结合在一起，从而将安全能力投入实际运营。</span><span> </span><span>AITD 采用多模型策略，在成本和覆盖范围之间取得平衡，使用轻量级模型进行持续扫描，并使用专用前沿模型处理高风险漏洞。</span></p><p><span>除了主动的平台防御之外，我们最近推出了 Gemini 4 Carbon，这是我们最先进的模型，具备最先进网络安全能力和长程能力。 </span><span>Google 在构建 Gemini 4 Carbon 时采用了针对网络滥用的分层防御措施——结合安全训练、输入/输出分类器、基于激活的内省探针，以及思维链和智能体轨迹监控器——旨在阻止开发可用、武器化漏洞利用或恶意软件工具的请求。这些安全防护的稳健性已由内部红队以及包括 Gray Swan 和 Trajectory labs 在内的专业外部合作伙伴进行了压力测试。在模型本身之外，Google 持续监测生产环境中的故意滥用行为，限制或禁用违规账户的访问，并通过 Fairwind Program 向经过审查的防御人员、安全研究人员和政府合作伙伴提供对先进双用途网络能力的访问。 </span><span>有关对 Gemini 4 Carbon 进行的安全性保障、安全和对齐测试的更多信息，请参阅 </span><a href=\"https://storage.googleapis.com/deepmind-media/gemini/gemini_4_carbon_safety_report.pdf\"><span>Gemini 4 Carbon Safety &amp; Security Report</span></a><span>。</span></p><h3 id=\"sec-15\"><span>安全且负责任地构建 AI</span></h3><p><span>Google 对 AI 的态度以大胆创新和负责任开发为承诺。 </span><span>在我们的 </span><a href=\"https://ai.google/principles/#our-ai-principles-in-action\"><span>AI Principles</span></a><span> 指导下，Google 采用稳健的安全防护机制设计 AI 系统，并持续进行测试，以确保其韧性。&nbsp;</span></p><p><span>我们的 </span><a href=\"https://gemini.google/us/policy-guidelines/?hl=en\"><span>政策指南</span></a><span> 和禁止使用 </span><a href=\"https://policies.google.com/terms/generative-ai/use-policy\"><span>政策</span></a><span> 是确保安全的基础。我们的 </span><a href=\"https://transparency.google/our-approach/our-policy-process/\"><span>政策制定流程</span></a><span> 旨在预判 emerging trends，并从设计之初就融入安全性，使我们能够加强全球用户的保护。&nbsp;</span></p><p><span>在 Google，</span><a href=\"https://cloud.google.com/transform/how-google-does-it-threat-intelligence-uncover-track-cybercrime\"><span>威胁情报</span></a><span> 是我们安全态势的核心组成部分。我们主动调查对我们平台的滥用行为——包括政府支持威胁实施者进行的恶意网络活动——并在适当时与执法机关合作。至关重要的是，我们从每一项已实施对策中获得的经验都会反馈到产品开发中，从而提升 AI 模型的安全性。我们对分类器和模型级安全防护进行的这些迭代改进，对于保持应对不断演变威胁的敏捷性至关重要。</span></p><p><span>我们的 LLM 开发和 Trust &amp; Safety 团队还与威胁情报、安全和建模专家密切协作，以有效应对滥用行为。</span></p><p><span>发布于</span></p><ul><li><a href=\"https://cloud.google.com/blog/topics/threat-intelligence\">威胁情报</a></li></ul>","original","zhKind","translation","complete","Agent 安全","大模型","Google","Microsoft","https://cloud.google.com/blog/topics/threat-intelligence/agentic-threat-activity-crosses-a-significant-threshold/","Google Cloud 威胁情报",{"_139":140,"_141":-5},"changelogVersion","2026-10-01T08:00","release"]
