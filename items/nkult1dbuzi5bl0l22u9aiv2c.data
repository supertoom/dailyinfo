[{"_1":2,"_3":4},"root",{"_5":92},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1795740042000,"id","nkult1dbuzi5bl0l22u9aiv2c","title","攻击者利用 Mitel、Juniper、Vates 与 Danfoss 的 10 个漏洞，CISA 已列入 KEV","originalTitle","Hackers Exploit 10 Vulnerabilities Across Mitel, Juniper, Vates, and Danfoss Products","summary","CISA 将 Mitel MiCollab、Vates Xen Orchestra、Juniper Session Smart Conductor 与 Router、Danfoss AK-SM 800A Series 制冷控制器的 10 个漏洞加入 KEV，其中部分已有在野利用报告。","reason","文章汇总了多家厂商产品的已利用漏洞，并列出处置期限、补丁与临时缓解措施，便于相关机构评估和安排修复。","source",{"_67":91},"links",{"_83":90},"publishedAt","2026-11-26T06:44:46.000Z","discoveredAt","2026-11-26T08:31:25.278Z","timelineAt","category","vuln","tags",[87,68,88,89,71,75],"score",81,"selected",true,"channel","news","story","x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_59":82,"_83":-5,"_84":85,"_86":37},"outline",[76],"relatedStories",[],"topics",[60,61,62,63,64],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_65":74,"_67":75},{"_65":72,"_67":73},{"_65":70,"_67":71},{"_65":31,"_67":69},{"_65":66,"_67":68},"slug","exploited","name","在野利用","漏洞披露","vuln-mgmt","漏洞管理","industrial","工业控制","cisa","CISA",{"_11":77,"_78":79,"_80":81},"sec-1","text","CISA 警告 Danfoss AK-SM 8xxA 系列存在尚未修补的新漏洞","level",3,"<p><span><i></i><span>Ravie Lakshmanan</span><i></i><span>2026年11月26日</span></span><span>工业控制系统 / 漏洞</span></p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEht82Zul6A6D_rTYZuOr0QQWkA4p8kQXRI-4qAYhdGBdTR0ZNzlHkHCiz3eSv5wm9Gq1rADX0CIEBUu08HBUbWd4fVKtL6f7UrWcaa_nVetYt0DyPj2-f_yM80HEIUbuy57mpftPYHHp1FKCNXvkDnFtsj-V5PWGUvWiNL38OKY3EIKUwKHuoKsIc4oSXeC/s1600/mitel.jpg\"><img alt=\"\" src=\"/dailyinfo/media/121ceb244fb17c3a.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>美国网络安全和基础设施安全局（CISA）于周三<a href=\"https://www.cisa.gov/news-events/alerts/2026/11/25/cisa-adds-10-known-exploited-vulnerabilities-catalog\">将</a>10个安全缺陷加入其已知被利用漏洞（<a href=\"https://www.cisa.gov/known-exploited-vulnerabilities-catalog\">KEV</a>）目录，其中包括上周披露的5个影响 Mitel MiCollab 的漏洞。</p><p><a href=\"https://www.mitel.com/support/security-advisories/mitel-product-security-advisory-misa-2026-0012\">Mitel MiCollab 漏洞</a>列于下方——</p><ul>\n  <li><strong>CVE-2026-133275</strong>（CVSS 分数：5.3）——MiCollab 的音频、网络和视频会议（AWV）组件中存在任意文件上传漏洞，可能允许攻击者向目标系统上传任意文件。</li>\n  <li><strong>CVE-2026-133303</strong>（CVSS 分数：9.0）——MiCollab 的音频、网络和视频会议（AWV）组件中存在 XML 注入漏洞，可能允许攻击者在系统上下文中执行任意命令。</li>\n  <li><strong>CVE-2026-133311</strong>（CVSS 分数：5.9）——MiCollab 的音频、网络和视频会议（AWV）组件中存在未授权访问漏洞，可能允许攻击者获取敏感信息。</li>\n  <li><strong>CVE-2026-133323</strong>（CVSS 分数：10.0）——MiCollab 的音频、网络和视频会议（AWV）组件中存在命令注入漏洞，可能允许攻击者在系统上下文中执行任意命令。</li>\n  <li><strong>CVE-2026-133324</strong>（CVSS 分数：5.3）——MiCollab 的音频、网络和视频会议（AWV）组件中存在身份验证绕过漏洞，可能允许攻击者绕过身份验证控制，并在应用程序上下文中执行未授权操作。</li>\n</ul><p>这些问题影响 MiCollab 10.3 及更早版本。该公司在 2026 年 11 月 16 日发布的一份公告中表示：“Mitel 为 10.3 版本（10.3.0.18）提供了可用补丁，用于修复这些漏洞。升级到此版本并应用所提供的补丁，或升级到更晚的版本。”</p><p>建议无法应用更新的客户通过限制对 AWV 组件的外部访问来降低风险。截至撰写时，目前尚无关于这些漏洞如何在野外的被利用情况的详细信息。</p><p>加入 KEV 目录的还有以下漏洞——</p><ul>\n  <li><strong>CVE-2026-133469</strong>（CVSS 分数：9.8）——Vates Xen Orchestra 中存在指定输入类型验证不当漏洞，可能允许未经身份验证的攻击者通过包含空 JSON 对象的特制身份验证令牌绕过身份验证，并以管理员权限执行操作。</li>\n  <li><strong>CVE-2026-103406</strong>（CVSS 分数：9.8）——Hewlett Packard Enterprise（HPE）Juniper Session Smart Conductor 和 Session Smart Router 中存在操作系统命令注入漏洞，可能允许远程攻击者通过特制的 salt minion ID 以 root 权限执行任意命令。</li>\n</ul><p>CVE-2026-133469 的加入源于 Vates VMS 发布的一份公告，该公告称这一也被跟踪为 <a href=\"https://thehackernews.com/2026/11/hackers-exploit-critical-xen-orchestra.html\">VSA-2026-062</a> 的漏洞已被来自以下 IP 地址和 TOR 域名的威胁行为者利用——</p><ul>\n  <li>91.211.251[.]112:8001</li>\n  <li>ustar3rqxgnskzgnwkgpofgtvxevm6cx3lxdbwt4mndtveqyaohid[.]onion:3333</li>\n</ul><p>“Juniper Networks <a href=\"https://supportportal.juniper.net/s/article/2026-10-On-Demand-Security-Bulletin-Session-Smart-Router-and-Session-Smart-Conductor-Multiple-internally-discovered-vulnerabilities-resolved\">表示</a>，Juniper SIRT 已收到至少一起恶意利用 CVE-2026-103406 的报告，”“敦促客户尽快升级至已修复版本，并在此期间采取措施缓解此漏洞。”</p><p>其余三项安全漏洞涉及 <a href=\"https://www.danfoss.com/en/service-and-support/downloads/dcs/adap-kool-software/ak-sm-800a/#tab-downloads\">Danfoss AK-SM 800A 系列制冷控制器</a>，可能导致身份验证绕过和任意命令执行——</p><ul>\n  <li><strong>CVE-2023-25914</strong>（CVSS 分数：8.8）——一项路径遍历漏洞，可能允许攻击者通过 XML 接口访问并读取底层服务器系统文件。</li>\n  <li><strong>CVE-2023-25915</strong>（CVSS 分数：9.9）——一项不当输入验证漏洞，可能允许远程攻击者在受影响系统上运行任意命令。</li>\n  <li><strong>CVE-2025-41450</strong>（CVSS 分数：8.5）——一项不当身份验证漏洞，可能允许攻击者生成暴露敏感信息的 Web 报告，其中包括内部 IP 地址、用户名和门店名称。</li>\n</ul><p>尽管 Danfoss 未提及这些漏洞已被利用，但它们很可能已在最近几周针对欧洲<a href=\"https://thehackernews.com/2026/11/us-agencies-warn-refrigeration.html\">超市连锁店</a>的高影响<a href=\"https://flawfence.com/blog/en/danfoss-refrigeration-controller-cyberattack-french-supermarkets/\">攻击</a>中被<a href=\"https://www.midnightblue.nl/blog/multiple-rce-danfoss-aksm800a\">使用</a>。法国<a href=\"https://thehackernews.com/2026/11/france-blames-iran-for-sabotage-attack.html\">将</a>其零售网站于 2026 年 10 月遭受的攻击归咎于 <a href=\"https://thehackernews.com/2026/04/iran-linked-hackers-disrupt-us-critical.html\">Shahid Kaveh</a>（又称 Cyber Aveng3rs 和 Cyber Isnaad Front），这是隶属于伊斯兰革命卫队（IRGC）的一个伊朗网络单位。</p><p>鉴于这些漏洞正在被积极利用，联邦文职行政部门（FCEB）机构被建议在 2026 年 11 月 28 日前为除 CVE-2026-133311 和 CVE-2025-41450 之外的所有漏洞应用必要的修复。剩余两项漏洞必须在 2026 年 12 月 9 日前解决。</p><h3 id=\"sec-1\">CISA 警告 Danfoss AK-SM 8xxA 系列存在尚未修补的新漏洞</h3><p>与此同时，CISA 已警告 Danfoss AK-SM 8xxA 系列（CVE-2026-129713，CVSS 分数：9.8 / 9.3）控制器存在一项尚未修补的严重漏洞，该漏洞可能被利用来以 Web 服务器权限执行任意代码。</p><p>CISA <a href=\"https://www.cisa.gov/news-events/ics-advisories/icsa-26-328-03\">表示</a>：“Danfoss AK-SM 8xxA 系列控制器中未经身份验证的 CGI 处理程序存在基于栈的缓冲区溢出，远程攻击者可通过发送 specially crafted HTTP/S POST 请求发起攻击，从而导致内存损坏、Web 服务器重启，并可能导致以 Web 服务器权限执行任意代码。利用此漏洞无需身份验证。”</p><p>Danfoss <a href=\"https://www.danfoss.com/en/service-and-support/coordinated-vulnerability-disclosure/danfoss-security-advisories/dsa-2026-12-01\">已发布自己的警报</a>，并表示该安全漏洞影响 5.4.0 及更早版本。该漏洞的修复预计将在即将推出的软件版本（5.5.x）中提供。该公司还表示，将移除允许客户禁用产品中“Strict mode”的选项。</p><p>在修复可用之前，建议系统管理员采取以下措施——</p><ul>\n  <li>确保只能通过安全 VPN 或通常情况下通过受保护网络远程访问这些设备</li>\n  <li>将设备配置为 Strict mode，以确保产品具有更高的安全级别</li>\n  <li>建议使用强密码</li>\n</ul><p>CISA 还建议各组织尽量减少此类设备在网络中的暴露，将控制系统网络和远程设备置于防火墙之后，并将其与业务网络隔离。</p><p>“需要远程访问时，请使用更安全的方法，例如虚拟专用网络（VPN），同时也要认识到 VPN 可能存在漏洞，应更新至可获得的最新版本。”CISA 补充道。“还要认识到，VPN 的安全性取决于所连接设备的安全性。”</p><p>觉得这篇文章有意思？欢迎在 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a> 上关注我们，查看我们发布的更多独家内容。</p>","original","zhKind","translation","complete","漏洞","补丁","工控","https://thehackernews.com/2026/11/hackers-exploit-10-vulnerabilities.html","The Hacker News",{"_93":94,"_95":-5},"changelogVersion","2026-10-01T08:00","release"]
