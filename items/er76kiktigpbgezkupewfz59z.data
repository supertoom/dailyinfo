[{"_1":2,"_3":4},"root",{"_5":90},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1794616828000,"id","er76kiktigpbgezkupewfz59z","title","Apache HTTP/2 远程代码执行漏洞 CVE-2026-119618 已复现","originalTitle","【已复现】Apache HTTP/2 远程代码执行漏洞(CVE-2026-119618)安全风险通告","summary","Apache HTTP Server 的 mod_http2 存在远程代码执行漏洞 CVE-2026-119618，奇安信 CERT 已成功复现。攻击者无需认证，在目标启用并开放 HTTP/2 时，可利用并发流和特定请求头布局触发无锁 APR allocator 竞争，造成进程崩溃、拒绝服务，并可能以 httpd 进程权限执行任意代码。","reason","原文给出并发竞态的触发原理、受影响版本和无认证利用条件，并提供了可用的升级与临时缓解方案。","source",{"_71":89},"links",{"_80":88},"publishedAt","2026-11-13T07:40:00.000Z","discoveredAt","2026-11-13T12:54:29.181Z","timelineAt","category","vuln","tags",[83,84,85,86,87,74],"score",82,"selected",true,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","body",{"_61":79,"_80":-5,"_81":80,"_82":37},"outline",[],"relatedStories",[75],"topics",[68,69],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","f2frbTTF4SAw","reportCount",2,"additionalSourceCount",1,{"_70":73,"_71":74},{"_70":31,"_71":72},"slug","name","漏洞披露","qianxin","奇安信",{"_76":77,"_13":78},"publicId","f7ee3fa3-8470-4dc6-9f4b-db1dac75a093","Apache mod_http2竞态漏洞公开PoC","<p><span>奇安信 CERT</span> <span>2026-11-13 15:40</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/b8b519aca0799708.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>致力于第一时间为企业级用户提供权威漏洞情报和有效解决方案。</p><p><span><span>●&nbsp;</span></span><span><span>点击↑蓝字关注我们，获取更多安全风险通告</span></span></p><hr><table><tbody><tr><td colspan=\"4\" align=\"center\"><p><span><strong><span><span>漏洞概述</span></span></strong></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>漏洞名称</span></span></strong></span></p></td><td colspan=\"3\" align=\"left\"><p><span><span>Apache HTTP/2 远程代码执行漏洞</span></span></p></td></tr><tr><td align=\"left\"><p><span><span><strong><span>漏洞编号</span></strong></span></span></p></td><td colspan=\"3\" align=\"left\"><p><span><span>QVD-2026-108595</span><span>，</span><span>CVE-2026-119618</span></span></p></td></tr><tr><td align=\"left\"><p><strong><span><strong><span><span>公开时间</span></span></strong></span></strong></p></td><td align=\"left\"><p><span><span>2026-11-11</span></span></p></td><td align=\"left\"><p><strong><span><strong><span><span>影响量级</span></span></strong></span></strong></p></td><td align=\"left\"><p><span><span>百万级</span></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>奇安信评级</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>高危</span></span></strong></span></p></td><td align=\"left\"><p><strong><span><span>CVSS 3.1分数</span></span></strong></p></td><td align=\"left\"><p><span><span><strong><span>9.8</span></strong></span></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span>威胁类型</span></strong></span></p></td><td align=\"left\"><p><span><span><span>代码执行</span></span></span></p></td><td align=\"left\"><p><strong><span><span>利用可能性</span></span></strong></p></td><td align=\"left\"><p><strong><span><strong><span>高</span></strong></span></strong></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>POC状态</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span><span>已公开</span></span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>在野利用状态</span></span></strong></span></p></td><td align=\"left\"><p><span><span><span>未发现</span></span></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>EXP状态</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span><span>未公开</span></span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>技术细节状态</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span><span>已公开</span></span></span></strong></span></p></td></tr><tr><td colspan=\"4\" align=\"left\"><p><strong><span><span>危害描述：</span></span></strong><span><span>远程未授权攻击者可触发mod_http2工作线程与连接线程对同一无锁APR allocator的并发访问，造成堆内存破坏，导致进程崩溃、拒绝服务，并可能进一步以httpd进程权限执行任意代码。</span></span></p></td></tr></tbody></table><p><strong><span>0</span></strong><strong><span>1</span></strong></p><p><strong><span>漏洞详情</span></strong></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>影响组件</span></span></strong></p><p><span>Apache HTTP Server（httpd）是全球广泛使用的开源Web服务器。mod_http2是httpd的HTTP/2协议实现模块，支持在单个连接上多路复用多个并发请求，并使用工作线程处理请求。该模块被广泛应用于Web站点、反向代理、API网关、CDN回源等场景。</span></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>漏洞描述</span></span></strong></p><p><span>近日，奇安信CERT监测到官方修复<span>Apache HTTP/2 远程代码执行漏洞(CVE-2026-119618)</span>，该漏洞源于mod_http2在assign_headers()函数中，将合成的Content-Length: 0写入了连接线程（c1）所属的共享请求头表req-&gt;headers，而不是工作线程（c2）私有的r-&gt;headers_in。当请求头表恰好达到容量上限时，该写入会触发apr_palloc()，在未加锁的APR分配器上与连接线程并发分配/释放内存，造成堆内存破坏。攻击者可通过发送特制HTTP/2请求触发该竞争，导致httpd子进程崩溃、拒绝服务，并可能进一步以httpd进程权限执行任意代码。</span><span><span>目前该漏洞PoC和技术细节已公开，</span></span><span><span>鉴于该漏洞影响范围较大，建议客户尽快做好自查及防护。</span></span></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>利用条件</span></span></strong></p><p><span><span>目标启用HTTP/2（h2/h2c）并可被网络访问；无需认证；需并发HTTP/2流及特定请求头布局触发分配器竞争。</span></span></p><p><strong><span>02</span></strong></p><p><strong><span>影响范围</span></strong></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>影响版本</span></span></strong></p><p><span>2.4.55 &lt;= Apache httpd &lt; 2.4.71</span></p><p><span>2.0.8 &lt;= 独立版 mod_h2 &lt; 2.0.42</span></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>其他受影响组件</span></span></strong></p><p><span>无</span></p><p><strong><span>03</span></strong></p><p><strong><span>复现情况</span></strong></p><p><span><span>目前，</span><span>奇安信CERT已成功复现</span><span><span>Apache HTTP/2 远程代码执行漏洞(CVE-2026-119618)</span></span><span>，截图如下：</span></span></p><p><img src=\"/dailyinfo/media/a2e89037328ef64a.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>04</span></strong></p><p><strong><span>处置建议</span></strong></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>安全更新</span></span></strong></p><p><span>Apache官方已发布安全版本，建议尽快升级：</span></p><p><span>Apache HTTP Server &gt;= 2.4.71</span></p><p><span>独立mod_h2升级至 2.0.43或更高版本；mod_h2仓库已于2026年6月归档，建议迁移至httpd内置mod_http2。</span></p><p><span>官方下载地址：</span></p><p><span><a href=\"https://httpd.apache.org/download.cgi\">https://httpd.apache.org/download.cgi</a></span></p><p><span><span>临时缓解措施：</span></span></p><p><span>如无法立即升级，可将HTTP/2临时关闭，仅保留HTTP/1.1；</span></p><p><span>或禁用mod_http2模块并重启httpd。需要注意：</span></p><p><span>仅限制H2MaxWorkers、连接数或请求头大小不能消除该竞争；</span></p><p><span>h2c（明文HTTP/2）同样受影响，不能只关闭TLS h2；</span></p><p><span>关闭HTTP/2会影响性能和多路复用能力，应作为临时措施，并尽快安排升级。</span></p><p><strong><span>05</span></strong></p><p><strong><span>参考资料</span></strong></p><p><span><span>[1]</span><span><a href=\"https://httpd.apache.org/security/vulnerabilities_24.html\">https://httpd.apache.org/security/vulnerabilities_24.html</a></span></span></p><p><strong><span>06</span></strong></p><p><strong><span>时间线</span></strong></p><p><span><span>2026年11月13日，奇安信 CERT发布安全风险通告。</span></span></p><p><strong><span>07</span></strong></p><p><strong><span>漏洞情报服务</span></strong></p><p><span><span>「</span><span>奇安信漏洞情报平台</span><span>」</span><span>重磅上线，诚邀您来体验：</span></span></p><p><img alt=\"图片\" src=\"/dailyinfo/media/7920000a8a39121e.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img alt=\"图片\" src=\"/dailyinfo/media/f1479ce6dc485784.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img alt=\"图片\" title=\"CERT LOGO.png\" width=\"100%\" src=\"/dailyinfo/media/04ab4d04f84a11e6.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><strong><span>奇安信 CERT</span></strong></span></p><p><span><strong><span><span>致力于</span></span></strong><span><span>第一时间为企业级用户提供</span><strong><span><span>权威</span></span></strong><span>漏洞情报和</span></span><strong><span><span>有效</span></span></strong><span><span>解决方案。</span></span></span></p><p><span><span><span>点击↓</span><strong><span><span>阅读原文</span></span></strong><span>，到</span></span><strong><span><span>ALPHA威胁分析平台</span></span></strong><span><span>订阅更多漏洞信息。</span></span></span></p><p><a href=\"https://ti.qianxin.com/portal/subscription\">阅读原文</a></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=f660cc3d&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzU5NDgxODU1MQ%3D%3D%26mid%3D2247508110%26idx%3D1%26sn%3Da17f6b379b7e554d96a77c11e8ccbe90\">跳转微信打开</a></p>","original","zhKind","complete","漏洞","复现","漏洞利用","补丁","网络设备","https://mp.weixin.qq.com/s?__biz=MzU5NDgxODU1MQ==&mid=2247508110&idx=1&sn=a17f6b379b7e554d96a77c11e8ccbe90","奇安信 CERT",{"_91":92,"_93":-5},"changelogVersion","2026-10-01T08:00","release"]
