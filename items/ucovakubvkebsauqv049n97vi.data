[{"_1":2,"_3":4},"root",{"_5":108},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794444099000,"id","ucovakubvkebsauqv049n97vi","title","Hunt.io 披露 ARTEX 攻击韩国 7 家金融机构数据泄露","originalTitle","Inside ARTEX: AI Hacking Tools, Exposed Servers and South Korean Bank Breaches","summary","Hunt.io 追踪了 ARTEX 开源自主渗透测试框架及其 AI 攻击基础设施，关联 2026 年 9 月底至 10 月初韩国 7 家金融机构通过互联网暴露系统发起的泄露事件，影响约 66,000 至 67,000 人和约 2,200 家公司，个人、就业、收入与贷款数据外泄。","reason","文章梳理了 ARTEX 攻击基础设施与 AI 模型调用链，并给出暴露面、凭据轮换和流量监测方面的处置建议。","source",{"_76":107},"links",{"_99":106},"publishedAt","2026-11-07T19:56:18.000Z","discoveredAt","2026-11-07T23:51:34.162Z","timelineAt","category","activity","tags",[79,77,81,103,104,105,87],"score",78,"selected",true,"channel","news","story",{"_89":90,"_13":91},"x","readingMode","full","author","Pierluigi Paganini","body",{"_61":98,"_99":-5,"_100":101,"_102":37},"outline",[92],"relatedStories",[88],"topics",[68,69,70,71,72,73],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fRnXy2dwo5j0","reportCount",1,"additionalSourceCount",0,{"_74":86,"_76":87},{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","malware","name","恶意软件","attack","攻击活动","ai-offense","AI 攻防","ai-agent","AI Agent 安全","red-team","红队与渗透","crowdstrike","CrowdStrike",{"_89":90,"_13":91},"publicId","059aba3e-9d1c-4eac-b987-90cf9479d504","ARTEX被指攻击韩国七家金融机构",{"_11":93,"_94":95,"_96":97},"sec-1","text","Hunt.io 追踪了 ARTEX 服务器以及在影响韩国七家金融机构的数据泄露事件中被利用的 AI 驱动黑客工具。","level",2,"<h2 id=\"sec-1\">Hunt.io 追踪了 ARTEX 服务器以及在影响韩国七家金融机构的数据泄露事件中被利用的 AI 驱动黑客工具。</h2><p>2026 年 9 月下旬至 10 月初，韩国七家金融机构通过面向互联网的系统遭到数据泄露。约 66,000 至 67,000 人以及约 2,200 家企业受到影响，个人信息、就业、收入和贷款数据被暴露。Hunt.io <a href=\"https://hunt.io/blog/artex-south-korea-bank-infrastructure\">深入调查了这场攻击活动背后的基础设施</a>，其发现补充了大量 CrowdStrike 和 Genians 已经发布的信息。</p><p>CrowdStrike 于 10 月 7 日<a href=\"https://www.crowdstrike.com/en-us/blog/unknown-threat-actor-uses-artex-to-target-south-korean-finance/\">发布报告</a>，Genians Security Center 于<a href=\"https://www.genians.co.kr/blog/threat_intelligence/banking-cyber-attack\"> 10 月 12 日</a>发布报告，两者都指向 <a href=\"https://securityaffairs.com/tag/artex\">ARTEX</a>——一款在中国开发并采用 AGPL-3.0 许可证的开源自主渗透测试框架。CrowdStrike 以中等置信度评估认为，出于获利动机运行该框架的是一名讲中文的个人，而非成熟的威胁组织。<a href=\"https://securityaffairs.com/tag/deepseek\">DeepSeek </a>v4.1 Flash 是主要模型，GLM 5.3 和 Grok 4.6 作为备用模型，部分通过经销商域名 xcai[.]pro 获取。</p><p>公开指标包括位于 38.244.50[.]120 的一台服务器，该服务器托管 ARTEX 控制台，此外还有一个香港地址和九个代理。Genians 表示，ARTEX 的 GitHub 仓库和 Docker 镜像已于 10 月 11 日被移除，但分叉版本和镜像仍然存在。 </p><p><em>“CrowdStrike 以中等置信度评估认为，该操作者是一名出于经济利益动机、而非代表成熟威胁组织的<strong>讲中文的个人</strong>。”Hunt.io 发布的<a href=\"https://hunt.io/blog/artex-south-korea-bank-infrastructure\">报告</a>写道：“据报道，该基础设施部分通过经销商域名 <a href=\"https://portal.hunt.io/domain/xcai.pro\">xcai[.]pro</a> 访问这些服务。两份报告都描述了一种双服务器配置，由一个用作主要基础设施的香港 IP 地址，以及托管 ARTEX 控制台的 <a href=\"https://portal.hunt.io/ip/38.244.50.120\">38.244.50[.]120</a> 组成。”</em></p><p>Hunt.io 在发布前通知了相关国家 CERT，并表示该报告不包含任何个人记录或凭据。</p><p>该公司自己的扫描显示，38.244.50[.]120 位于 Cogent 位于洛杉矶的网络中，有 15 个开放端口。ARTEX 登录页面使用了意为“自主渗透测试控制台”的中文标题，分别出现在 443 和 8090 端口上。其他服务还包括一个 Gemini2API 管理控制台和一台 Tinyproxy 服务器。</p><p>Hunt.io 在其 AttackCapture 平台上搜索该地址，发现另一个开放目录位于 23.248.226[.]250，这是 AS138415 上位于香港的一台跳转服务器。该目录包含 2 个子目录中的 42 个文件，总计 105 MB，平台在 9 月 5 日、9 月 26 日和 10 月 5 日记录了警告。其中一个文件将 38.244.50[.]120 列为跳转主机，其自带注释还告诫操作者绝不要将凭据粘贴到会话中。该目录处于开放状态。</p><p>三个脚本对该连接提供支撑。它们维持反向 SSH 隧道、运行本地中继，并将文件复制到跳转主机，其中一个隧道名为 grok2api，凭据文件还包含 Zhipu AI 的 GLM 模型密钥、一个兼容 OpenAI 的中继以及一项代理服务。这解释了多个语言模型如何在同一次攻击活动中运行。</p><p>AI 设置是最引人注目的部分。一个状态文件显示，该框架本身就是 Claude Code，版本为 2.1.221，自 8 月 4 日以来已启动 510 次，但它并未连接到 Anthropic。一个名为 ds-models-shim.py 的小型代理通过伪造模型列表并将请求发送到 DeepSeek，解决了一个兼容性问题；另一个名为 xcai-effort-shim.py 的代理添加了推理设置，因为 DeepSeek 后端否则会跳过其推理步骤。请求路径从 Claude Code 经由开源项目 Claude Code Router 路由至 xcai，然后再到 DeepSeek。</p><p><em>“一个名为 <strong>ds-models-shim.py</strong> 的小型本地代理解决了一个兼容性问题：当针对非 Anthropic 后端查询时，官方的 <strong>/v1/models</strong> 端点会返回 404 响应，导致 Claude Code 无法发现可用模型。该 shim 会拦截这一特定请求，并返回一个在本地定义的模型列表，其中包含 <strong>deepseek-v4-pro</strong> 和 <strong>deepseek-flash</strong>。所有其他请求都会被转发至 api.deepseek.com/anthropic。”报告称。</em></p><figure><a href=\"https://i0.wp.com/securityaffairs.com/wp-content/uploads/2026/11/image-14.png?ssl=1\"><img width=\"886\" height=\"366\" src=\"/dailyinfo/media/f72de5e0ed7ea207.webp\" srcset=\"/dailyinfo/media/f1e3d20378516914.webp 720w, /dailyinfo/media/4a6f26d29ecb7c18.webp 1200w, /dailyinfo/media/f72de5e0ed7ea207.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"\"></a></figure><p>同一个文件记录了 19 个自定义技能，即供代理程序使用的可复用指令集，共有 147 次使用记录。它们涵盖代码审计、侦察、Web 注入、WAF 绕过测试、身份验证测试、Telegram Mini Apps、APK 下载与反编译、云手机控制以及支付逻辑测试。在支付技能旁边有三个自行注册的测试账户，带有现金充值 API 的令牌，日期为 9 月 12 日；一条注释称其为经授权、自行搭建的测试。该设置适合测试不安全的直接对象引用漏洞，这是 CrowdStrike 和 Genians 针对韩国贷款与咨询服务所描述的一种技术。</p><p>该目录还包含辅助工具。一个脚本通过第三方 API 查询 FOFA（一家类似 Shodan 的中国资产搜索引擎），一条注释称主会员资格已过期，正在使用备用密钥。代理脚本枚举了一个轮换代理服务，地址为 154.201.79[.]246:443；在测试的前 100 个身份中发现了 79 个唯一的出口 IP。</p><p>另一个目录 23.248.226[.]250:8001 中存放着一套用于 JNDI 和 LDAP 利用的小型分阶段环境，于 10 月 5 日 03:42 UTC 取得。它证实了可通过 DNS 回调用实现命令执行，其中一个脚本让 Web 流量和 LDAP 流量共用单个端口。Hunt.io 的分析介绍了这些工具，但没有公布复现步骤。</p><p>其他恢复的文件包括针对某加密货币交易所管理会话和提现的工具、Linux 权限提升漏洞利用、iOS 探针源代码，以及 Android 内核和固件实用工具。Hunt.io 称，它们与韩国入侵事件的关联尚未得到确认。</p><p>随后，Hunt.io 展示了如何搜索 ARTEX 服务器。搜索 ARTEX 证书颁发者返回了 19 个 IP 地址；搜索其恶意软件分类则返回了分布于 30 个国家的 1,303 个地址，其中美国、中国和香港居前。这些数字反映的是地址的注册地，而非运营者所在地。</p><p><em>报告继续称：“<a href=\"https://portal.hunt.io/sql?sql=SELECT%0A++ip%0AFROM%0A++certificates%0AWHERE%0A++issuer.organization+%3D+%27ARTEX%27%0A++AND+timestamp+gt+%272026-01-01%27%0AGROUP+BY%0A++ip&amp;run=true&amp;page=0&amp;size=25&amp;sizeWasCapped=false&amp;hl=true&amp;ec=true&amp;tf=30&amp;hasExplicitTimeframe=false&amp;tab=results\">结果</a>返回了 19 个不同的 IP 地址，其中包括 38.244.50[.]120。这种方法很精准，但仅限于公开匹配证书的主机。使用不同证书的系统不会出现在这些结果中。”</em></p><p>匹配控制台的页面标题返回了约 1,300 个 IP；更宽松的搜索找到了 21 个标题字符串，其中 19 个很可能是 ARTEX 控制台，语言涵盖英语、中文、韩语、日语、俄语、葡萄牙语和越南语。</p><figure><a href=\"https://i0.wp.com/securityaffairs.com/wp-content/uploads/2026/11/image-13.png?ssl=1\"><img width=\"800\" height=\"548\" src=\"/dailyinfo/media/84eab331ece143d2.webp\" srcset=\"/dailyinfo/media/997a9630b2e0ad3d.webp 720w, /dailyinfo/media/2ae1950eafaf9d6e.webp 1200w, /dailyinfo/media/84eab331ece143d2.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"\"></a></figure><p>在 AttackCapture 中搜索恶意软件名称，发现了 280 个带有开放目录的结果。其中一个位于首尔的 130.94.31[.]86:18888 包含两个小型脚本，另一个位于 156.251.11[.]39，包含一套 SMB 侦察工具包，其测试脚本会写入一个名为 artex_probe_11876.txt 的文件。</p><p>更多主机上存放着针对 DedeCMS 和 FangCMS 的漏洞利用工具包、一套 CAPTCHA 绕过工具、RuoYi 和 Spring 管理控制台漏洞利用工具，以及基于 CAPTCHA 的登录自动化工具。它们共同表明，该框架正在吸引众多操作人员。</p><p>对于防御者，建议很明确。移除公共访问权限，将管理服务置于 VPN 或允许列表之后，重置 SSH 密码，并轮换暴露文件可能泄露的 API 密钥、代理凭据和令牌。修补面向互联网的服务，监控异常的 LDAP 和 JNDI 活动、DNS 回连以及远程脚本下载，并将机密存储在采用最小权限原则的托管保险库中。此外，还应限制对模型网关的访问，监控其请求，并对受管手机实施合规规则。Hunt.io 带来的教训是，调查不应止步于第一份指标清单，因为 </p><p>该公司还在其分析中公布了失陷指标。</p><p><em>“这些发现凸显了与管理服务暴露、可重复使用的凭据、远程访问隧道、代理基础设施以及漏洞利用工具相关的风险。”报告如此总结。</em></p><p><strong>在 Twitter 上关注我：&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;和&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;和&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a><strong></strong></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;黑客,&nbsp;ARTEX)</strong></p>","original","zhKind","translation","complete","大模型","数据泄露","红队","https://securityaffairs.com/202607/ai/inside-artex-ai-hacking-tools-exposed-servers-and-south-korean-bank-breaches.html","Security Affairs",{"_109":110,"_111":-5},"changelogVersion","2026-10-01T08:00","release"]
