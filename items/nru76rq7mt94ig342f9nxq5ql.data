[{"_1":2,"_3":4},"root",{"_5":100},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1793591188000,"id","nru76rq7mt94ig342f9nxq5ql","title","Warp Panda 利用 VMware ESX 漏洞 CVE-2026-41709 隐藏审计轨迹","originalTitle","China-Linked Hackers Exploited VMware ESX Zero-Day to Reduce Audit Trail Visibility","summary","Warp Panda 已在针对美国法律行业的攻击中利用 VMware ESX 漏洞 CVE-2026-41709，通过管理员权限执行未记录操作来降低审计轨迹可见性，CISA 已将其加入 KEV。","reason","原文披露了 CVE-2026-41709 的真实利用方式、受影响版本与修复期限，并说明攻击者如何借审计日志缺失扩大隐蔽访问。","source",{"_74":99},"links",{"_87":98},"publishedAt","2026-10-29T06:22:33.000Z","discoveredAt","2026-10-29T07:32:48.956Z","timelineAt","category","activity","tags",[77,79,92,93,94,95,96,97],"score",72,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_61":86,"_87":-5,"_88":89,"_90":91},"outline",[],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fUvXgGTHEkPU","reportCount",1,"additionalSourceCount",0,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","malware","name","恶意软件","attack","攻击活动","exploited","在野利用","vmware","VMware / Broadcom",{"_83":84,"_13":85},"publicId","fd72ef0a-3bef-4cc0-90ea-d38df86e2133","Warp Panda利用VMware ESX零日漏洞","<p><span><i></i><span>Ravie Lakshmanan</span><i></i><span>2026年10月29日</span></span><span>漏洞 / 网络间谍活动</span></p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjcr5vMvEpNtC6AAPL85NwoZLwafJYuuIYKlofAez4dmACEH-0VI-icaKusP2b9HgxcJC2AMyZkdGNfVOyXQCWqjK-_vIvw1OjptUH_maUL82An7MRxEnZQ62JZqPqwuTp6QQ8TWq4y0SRqUb6KhdXLYRJMyUHg2cQBzez3g-0G8jh2ujIgx-6FqQdWBuFr/s1600/esx-audit.jpg\"><img alt=\"\" src=\"/dailyinfo/media/b9586ee61ed9ff65.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>美国网络安全和基础设施安全局（CISA）于周三将一个影响 Broadcom VMware ESX 的安全缺陷<a href=\"https://www.cisa.gov/news-events/alerts/2026/10/28/cisa-adds-two-known-exploited-vulnerabilities-catalog\">加入</a>其已知被利用漏洞（<a href=\"https://www.cisa.gov/known-exploited-vulnerabilities-catalog\">KEV</a>）目录。此前，CrowdStrike 披露，该漏洞已被一个与中国有关联、名为 Warp Panda 的威胁行为体武器化，用于针对美国法律行业的攻击。</p><p>相关漏洞为 <strong><a href=\"https://thehackernews.com/2026/07/three-critical-vmware-flaws-allow-auth.html\">CVE-2026-41709</a></strong>（CVSS 分数：2.7），属于日志记录不足漏洞，可能使拥有管理员访问权限的恶意行为体在执行某些操作时不被记录。</p><p>在 2026 年 7 月发布的一份公告中，Broadcom 透露，该问题已在<a href=\"https://knowledge.broadcom.com/external/article/449886\">以下版本</a>中得到<a href=\"https://support.broadcom.com/web/ecx/support-content-notification/-/external/content/SecurityAdvisories/0/38017\">修复</a>——</p><ul>\n  <li>VMware Cloud Foundation SXi-9.1.0.0-25370933 和 ESXi-9.0.2.0100-25595025</li>\n  <li>VMware vSphere Foundation SXi-9.1.0.0-25370933 和 ESXi-9.0.2.0100-25595025</li>\n  <li>VMware ESX ESXi80U3j-25429389</li>\n  <li>VMware Cloud Foundation 5.2.4</li>\n  <li>VMware Telco Cloud Platform ESXi80U3j-25429389</li>\n</ul><p>这一 developments 是对 CrowdStrike 2026 年<a href=\"https://www.crowdstrike.com/en-us/blog/crowdstrike-2026-legal-threat-landscape-report/\">《法律行业威胁态势报告》</a>的回应。该报告披露，Warp Panda 在 2026 年初将 CVE-2026-41709 作为零日漏洞利用，目的是降低审计轨迹的可见性。</p><p>报告称，Warp Panda“利用面向互联网的边缘设备上的零日漏洞和自定义恶意软件来维持隐蔽、持久的访问，”该报告已提供给 The Hacker News。报告还称，该对手“通过绕过审计日志记录、收集云会话令牌以及注册恶意多因素身份验证（MFA）设备，积极规避检测。”</p><p>这个威胁行为体还被追踪为 Armory Castle（原 UNC5221）、Clay Typhoon 和 VerdantBamboo，在将 Citrix NetScaler 和 Ivanti Connect Secure 设备中的零日漏洞武器化方面有着<a href=\"https://thehackernews.com/2025/09/unc5221-uses-brickstorm-backdoor-to.html\">悠久历史</a>。</p><p>本月早些时候，Google 旗下的 Mandiant 也将该黑客组织归因于对 BeyondTrust Remote Support 中一个严重的源验证不当零日漏洞（<a href=\"https://thehackernews.com/2026/10/china-linked-hackers-exploited.html\">CVE-2026-102764</a>，CVSS 分数：9.3）的利用，以投递 SAWFLY 和 BARECLAW 等恶意软件家族。</p><p>Attacks mounted by Warp Panda involve the exploitation of internet-facing edge devices to obtain initial access, after which the threat actor pivots to VMware vCenter environments to deploy custom malware like <a href=\"https://thehackernews.com/2026/06/verdantbamboo-deploys-bsd-variant-of.html\">BRICKSTORM</a> and SharpStorm to maintain persistent access without attracting attention.</p><p>部分入侵还涉及以云服务为目标，意图提取用户会话令牌，从而在不触发任何基于凭据的警报的情况下访问 Microsoft 365 环境。据称，至少在一个案例中，Warp Panda 在受入侵账户上注册了新的 MFA 设备，以便即使密码被更改也能建立持久访问。&nbsp;</p><p>CrowdStrike 表示：“Warp Panda 代表着一种持续且具有战略重点的、与中国有关联的网络间谍威胁，针对美国多个行业的实体，其中包括法律行业。”</p><p>“法律行业集中掌握客户通信、并购材料、正在进行的诉讼策略以及跨客户访问权限，因此对于寻求获取情报、并使其在后续行动中发挥作用的国家主导型对手而言，该行业是高价值的情报收集目标。”</p><p>鉴于 CVE-2026-41709 正被积极利用，建议联邦文职行政部门（FCEB）各机构在 2026 年 11 月 11 日前应用修复。</p><p>觉得这篇文章有意思吗？欢迎在 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a> 上关注我们，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete",false,"漏洞利用","后门","VMware","CrowdStrike","CISA","Google","https://thehackernews.com/2026/10/china-linked-hackers-exploited-vmware.html","The Hacker News",{"_101":102,"_103":-5},"changelogVersion","2026-10-01T08:00","release"]
