[{"_1":2,"_3":4},"root",{"_5":91},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1793621625000,"id","j5x3hpy4zmra4jgyu8af973cy","title","江苏银行完成网银抗量子密码迁移验证并面向白名单客户灰度发布","originalTitle","江苏银行抗量子密码迁移的探索实践","summary","江苏银行建成覆盖企业网银与个人手机银行的抗量子密码迁移验证平台，通过“传统商密+抗量子”架构、TLS 1.3+X25519/ML-KEM768密钥协商和SM2与ML-DSA双签名机制改造登录与转账流程。","reason","source",{"_72":90},"links",{"_82":89},"publishedAt","2026-11-02T07:46:38.832Z","discoveredAt","2026-11-02T11:46:38.848Z","timelineAt","category","blue-team","tags",[85,86,87,88],"score",59,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body",{"_60":81,"_82":-5,"_83":82,"_84":55},"outline",[],"relatedStories",[77],"topics",[67,68,69],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","fXXfpOc_3QDQ","reportCount",1,"additionalSourceCount",0,{"_70":75,"_72":76},{"_70":30,"_72":74},{"_70":71,"_72":73},"slug","policy","name","政策法规","蓝队与运营","crypto","密码学",{"_78":79,"_13":80},"publicId","9ce211e8-4b23-4ee7-bfab-04670a59c613","江苏银行网银抗量子迁移进入灰度","<p>文/江苏银行首席信息官 梁斌</p><p>中央金融工作会议提出要做好金融“五篇大文章”，发展数字金融已上升为国家战略。结合江苏省实际，中国人民银行江苏省分行等十部门联合印发《加快推进江苏省数字金融高质量发展工作方案》（以下简称《方案》），推动江苏数字经济做大做优做强。随着金融业务全面线上化、数据化，量子计算的快速发展使传统加密体系面临愈发严峻的挑战。《方案》明确提出，应探索抗量子密码技术应用，加快相关标准制定，开展银行业重要信息系统抗量子密码迁移验证，打造量子安全基础能力先发优势。</p><p>江苏银行在2026年全球银行1000强中排名第51位，是全国系统重要性银行，已将抗量子密码迁移视为了关乎金融安全底座的“必答题”，确立了“以业务连续性为前提、以渐进式验证为路径、以自主技术体系建设为根基”的总体策略，并于2024年起率先启动国内首个网银场景抗量子密码迁移实践验证项目。本文系统阐述了江苏银行在这一前沿领域的战略认知、工程实践与示范价值。</p><p><strong>战略认知：量子威胁与迁移紧迫性</strong></p><p>抗量子密码迁移，是指将当前广泛使用的RSA、ECC及商密SM2等传统公钥密码体系，系统性地替换为基于格密码等量子计算难以破解的数学难题所构造的抗量子密码体系。这一迁移的紧迫性源于两类根本性威胁。</p><p>一是“未来破解”威胁。Shor算法可在多项式时间内高效破解传统公钥密码，一旦通用量子计算机问世，现有数字签名将面临批量伪造风险，基于证书的身份认证体系将被瓦解。二是“先窃后解”威胁。攻击者在当前阶段即可截获并存储加密流量或敏感金融数据，待量子计算机成熟后再行破解；同时，由于金融数据的保存周期往往长达数十年，这一攻击的风险敞口已经打开，留给金融机构完成全系统迁移的时间窗口十分有限。</p><p>密码迁移是一项极为复杂的长期系统工程。我国SM系列商用密码算法从标准发布到全面推广历时十余年，而抗量子密码迁移涉及算法更替、协议改造、证书体系升级和全行系统适配，复杂度远超以往。提前布局是赢得量子时代安全主动权的唯一选择。</p><p><strong>路线探索：渐进式迁移的战略布局</strong></p><p><strong>1.总体布局。</strong>密码迁移并非单纯的技术替换，而是涉及算法研究、标准制定、产品研发和系统部署的生态级协同工程。基于这一认知，江苏银行自2024年起在中国人民银行指导下，先后参与两项抗量子国家重点研发计划项目，与中国科学院信息工程研究所、西交利物浦大学、重庆大学等机构建立了紧密的产学研合作关系，形成了从格密码前沿理论到银行业务场景验证的闭环链条。</p><p><strong>2.实施路径。</strong>面对量子威胁，江苏银行设计了“传统商密+抗量子”的混合加密架构，在现有密码防护体系的基础上叠加抗量子防护能力，形成纵深防御。在此策略下，业务系统无需颠覆性改造，密码模块的替换可在应用层以稳健、兼容的方式逐步推进，从而将迁移对业务连续性的影响降至最低。为将这一总体策略转化为可落地的工程方案，江苏银行从场景选型、算法适配及协议改造三个维度协同推进。</p><p>在场景选型层面，采用“试点先行、逐步推广”的策略，优先选择涉及密码协议、直接关系客户资产安全的重要系统作为突破口。经过多维度评估，最终选择手机银行与企业网银两大网银场景并行试点：手机银行面向移动端个人客户，交易量大、业务逻辑相对简单，适合检验抗量子算法高并发性能；企业网银面向PC端企业客户，交易量较小但业务逻辑复杂、密码依赖链条完整，两个场景基本覆盖了银行典型的对客服务模式与绝大部分线上客户。项目初期，江苏银行对网银全流程进行密码资产依赖关系梳理，识别出UKey签名、TLS通道建立、后端验签等六个关键改造环节。网银类系统场景直接面向互联网，同时具备高数据敏感性、长保存周期、广暴露面三个高风险特征，是“先窃取、后解密”攻击威胁最为迫切的场景之一，破解此场景可为全行系统的渐进式迁移积累经验。</p><p>在算法选型层面，面临多重现实约束：一是技术路线尚未最终收敛，NIST标准与国内算法征集同步推进，选型须兼顾国际成熟度和国内自主可控要求 ；二是现有商密体系必须兼容，迁移不能推倒重来，而须在SM2/SM3/SM4基础上平滑演进；三是高频交易场景对性能高度敏感，抗量子算法普遍较大的密钥尺寸和签名体积可能形成性能瓶颈。江苏银行联合西交利物浦大学对主流抗量子密码路线进行了综合评估，综合考虑运算效率、密钥尺寸与安全强度等因素后，选择了以格密码算法为主的技术路线。</p><p>在协议选型层面，同样面临结构性挑战：一是密钥协商与数字签名分属不同安全层级，单层替换无法形成完整防护链，必须协同改造；二是迁移期间新老客户端并存，协议须同时支持抗量子算法的新终端与仅支持传统算法的存量终端；三是混合模式下存在降级攻击风险，攻击者可伪造协商报文迫使双方回退至仅使用传统算法，使抗量子防护失效。针对上述约束，江苏银行构建了密钥协商与数字签名双重混合机制：密钥协商层采用ML-KEM与X25519椭圆曲线算法并行的混合密钥交换方案TLS 1.3+X25519/ML-KEM768，该方案已得到主流浏览器支持，ML-KEM负责量子安全的密钥封装，X25519提供经典安全强度的密钥交换，两者均采用临时密钥对以确保前向保密，混合使用可避免单点失效；数字签名层设计了“三双”混合PKI体系——SM2与ML-DSA双证书、双签名、双验签协同机制，交易报文同时携带两种签名值，服务端并行验证两个签名，任一验证失败则交易被拒绝，从协议层面杜绝了降级攻击的可能。该机制在满足商密合规要求的同时，实现了密钥协商与身份认证的全链路量子安全闭环。</p><p><strong>场景验证：双签融合模式下的网银全流程工程落地</strong></p><p><strong>1.实践成果。</strong>为验证混合架构在实际业务场景中的可行性，江苏银行搭建了双签融合模式的网银抗量子密码迁移验证平台。该平台以网银系统（涵盖企业网银和个人手机银行）为原型，完整覆盖UKey登录与转账两大核心业务场景的全流程，由抗量子证书系统、抗量子SSL网关、网银应用、签名控件、抗量子签名服务器和抗量子UKey六大核心组件构成，实现了从客户端到服务端的全链路量子安全防护。详细设计方案如下。图1以网银为例，展示了抗量子算法在UKey登录及转账场景中的完整应用流程。</p><p><img src=\"/dailyinfo/media/c3b8bce0656257ab.webp\" loading=\"lazy\" decoding=\"async\"></p><p>图1 网银抗量子密码迁移验证平台与应用架构</p><p>一是抗量子证书系统为客户端UKey签发基于MLDSA抗量子算法的数字证书。二是客户插入UKey并打开浏览器访问企业网银页面时，浏览器通过TLS 1.3协议与银行的抗量子SSL网关建立HTTPS安全通道，密钥协商阶段采用ML-KEM768抗量子算法与X25519算法的混合密钥交换方案。三是客户发起转账交易操作时，PKI中间件通过UKey驱动调用UKey中已签发的抗量子证书对应私钥完成签名，并按照PKCS#7格式对签名数据进行封装；同时，客户端通过已建立的抗量子HTTPS安全通道，将业务数据、签名数据等信息传输至网银业务系统。四是网银业务系统调用抗量子签名服务器，对接收到的签名数据进行验签，并对业务数据进行解密，以确保数据的完整性与机密性。五是抗量子签名服务器对网银业务系统转发的SM2与ML-DSA双签名数据分别进行验签处理，并将验签结果及证书有效性状态反馈至网银业务系统。六是网银业务系统最终将操作结果返回客户端。</p><p><strong>2.工程难题攻克。</strong>在项目实施过程中，项目团队解决了一系列工程化难题。例如抗量子签名报文体积过大导致的传输超时问题——ML-DSA签名值较SM2签名值大数十倍，在UKey与控件间的SKF接口传输及PKCS#7封装环节，报文膨胀极易引发超时断连。江苏银行与中国科学院信息工程研究所联合攻关，通过签名数据分段传输及混合协议参数优化，历时近一年使系统达到稳定可用状态。此外，由于双签名模式下SM2与PQC签名数据的结构差异，PKCS#7封装的字段映射与解析逻辑需重新设计，江苏银行通过扩展SKF接口规范并定义统一的混合签名数据结构予以解决。</p><p>在硬件层面，江苏银行成功推动国内首款双签名抗量子UKey落地。该产品采用硬件级加密芯片，内置融合商密与抗量子算法的双签名模块，密钥全生命周期严格限定在安全芯片内部，从物理层面彻底杜绝泄露风险，填补了国内抗量子终端UKey的技术空白，打通了抗量子密码从算法研究到硬件产品的工程化闭环。</p><p><strong>3.可行性验证。</strong>经过网银高仿真环境的全流程测试验证，该平台已投入生产环境，面向部分白名单客户实施灰度发布。性能测试数据表明：抗量子签名验签服务器单节点处理能力达1万TPS，单笔验签耗时仅2毫秒；混合TLS握手性能可达2.5万TPS，时延增幅控制在15%以内，核心业务流程响应正常，兼顾了量子安全防护与用户体验。在客户端兼容性方面，通过双栈并行架构实现了存量用户无感知升级，保障了迁移期间业务的连续稳定运行。</p><p>上述验证结果充分印证了混合加密架构的工程可行性。</p><p><strong>示范价值：五大创新驱动行业共识</strong></p><p>江苏银行的实践表明，“渐进式混合过渡”路径在金融业具备工程可行性——抗量子密码迁移可在不中断业务、不推倒重来的前提下稳步推进。具体而言，该项工作在平台、技术、硬件、生态、标准五个层面形成了具有行业参考价值的创新，构成了可复制的迁移范式。</p><p>在平台层面，构建了国内首个商业银行网银系统抗量子密码迁移验证平台，填补了行业空白。该平台以真实系统为原型，覆盖登录、转账全流程，用于验证算法与系统、终端的适配性，有助于解决“实验室可行、业务不可用”的问题，为银行业抗量子密码迁移提供了可落地的验证环境。</p><p>在技术层面，首创的“三双”混合PKI体系与双签融合技术，遵循“兼容适配、自动切换”原则——前端同步生成商密SM2与抗量子ML-DSA双签名，后端自适应验签系统兼容传统签名、PQC签名及混合签名三种模式，形成“双保险”安全体系，并为未来新增PQC算法预留了快速兼容能力。</p><p>在硬件层面，成功设计并推动国内首款双签名抗量子UKey落地，密钥全生命周期严格限定在安全芯片内部，从物理层面彻底杜绝泄露风险，打通了抗量子密码从算法研究到硬件产品的工程化闭环，为产业链上下游协同创新提供了实物载体。</p><p>在生态层面，与中国科学院信息工程研究所、西交利物浦大学、重庆大学等单位建立产学研协作关系，形成了从格密码前沿理论到银行业务场景验证的价值链。</p><p>在标准层面，深度参与制定国内首个抗量子密码领域团体标准《银行业抗量子计算密码迁移管理指南》，将实践经验提炼为涵盖迁移总体原则、风险评估维度和实施步骤建议的管理框架，有助于推动行业从“各自探索”走向“协同规范”。</p><p>从企业网银的单点突破到个人手机银行移动端的多场景协同，从软件层面的协议改造到硬件层面的抗量子UKey落地，江苏银行完成了从算法验证到全栈工程化的完整闭环。作为全国系统重要性银行率先完成高仿真环境下的全流程验证，其示范效应有助于加速行业从观望到行动的转变，推动抗量子密码迁移从学术讨论走向工程落地。在这场关乎金融安全底座的迁移中，江苏银行愿以先行者的实践经验为行业同仁提供参考，共同赢得量子时代的安全主动权。</p><p>（此文刊发于《金融电子化》2026年10月上半月刊）</p><p>声明：本文来自金融电子化，版权归作者所有。文章内容仅代表作者独立观点，不代表安全内参立场，转载目的在于传递更多信息。如有侵权，请联系 anquanneican@163.com。</p>","original","zhKind","complete","蓝队","加固","加密","标准","https://www.secrss.com/articles/95266","安全内参",{"_92":93,"_94":-5},"changelogVersion","2026-10-01T08:00","release"]
