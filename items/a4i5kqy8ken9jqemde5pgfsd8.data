[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794530482000,"id","a4i5kqy8ken9jqemde5pgfsd8","title","Addressable 2.9.1 修复 URI 路径规范化拒绝服务漏洞","originalTitle","Addressable: Denial of service in URI path normalization","summary","Addressable 的 URI 路径规范化存在算法复杂度漏洞，2.9.1 已修复，2.9.1 之前的所有版本均受影响。`Addressable::URI.normalize_path` 每轮仅移除一个点路径段，导致处理嵌套点路径的耗时随路径长度平方增长；在 MRI Ruby 4.0 上，规范化 34 KB 路径约需 3.5 秒。","reason","source",{"_71":85},"links",{"_59":84},"publishedAt","2026-11-12T22:35:33.000Z","discoveredAt","2026-11-12T22:36:23.879Z","timelineAt","category","vuln","tags",[80,81,82,83],"score",51,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","readingMode","full","author","body","outline",[],"relatedStories",[76],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fLOVgNhRG_S0","reportCount",1,"additionalSourceCount",0,{"_69":74,"_71":75},{"_69":30,"_71":73},{"_69":70,"_71":72},"slug","research","name","技术研究","漏洞披露","crypto","密码学",{"_77":78,"_13":79},"publicId","dba07ee9-cb4a-42aa-8476-90d72b4b1c43","Addressable 修复路径规范化拒绝服务漏洞","漏洞","补丁","漏洞分析","加密","https://github.com/advisories/GHSA-qq38-m9mg-xjj5","GitHub 安全公告",{"_87":88,"_89":-5},"changelogVersion","2026-10-01T08:00","release"]
