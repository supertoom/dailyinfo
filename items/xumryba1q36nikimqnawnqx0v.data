[{"_1":2,"_3":4},"root",{"_5":93},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1795653653000,"id","xumryba1q36nikimqnawnqx0v","title","DOJ 发起美国史上最大反诈骗行动，逾 800 名被告涉 400 余起案件","originalTitle","US Anti-Scam Surge Hits 800 Defendants and 29 Scam Compounds","summary","美国司法部（DOJ）11 月 24 日通报，自 3 月以来已在 85 个联邦地区办理 400 余起诈骗案件，涉及 800 多名被告，为其规模最大的反诈骗行动，行动依据 3 月 6 签署的 Executive Order 14390。","reason","source",{"_65":92},"links",{"_58":91},"publishedAt","2026-11-25T16:00:00.000Z","discoveredAt","2026-11-25T16:24:08.980Z","timelineAt","category","activity","tags",[66,86,87,88,89,90],"score",66,"selected",false,"channel","news","story","x","readingMode","full","author","body",{"_82":-5,"_58":83,"_84":-5,"_85":36},"outline",[73,74],"relatedStories",[],"topics",[59,60,61,62],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_63":71,"_65":72},{"_63":69,"_65":70},{"_63":67,"_65":68},{"_63":64,"_65":66},"slug","attack","name","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","email","邮件与钓鱼",{"_11":80,"_76":81,"_78":79},{"_11":75,"_76":77,"_78":79},"sec-2","text","Crypto Freezes and BEC Cases","level",2,"sec-1","FBI Targets Scam Compounds","zh","<p>\n\tUS prosecutors have pursued more than 400 scam cases involving over 800 defendants across 85 federal districts since March.</p><p>\n\tThe Department of Justice (DOJ) <a href=\"https://www.justice.gov/opa/pr/justice-department-announces-largest-ever-crackdown-scammers-targeting-over-800-defendants\">announced the figures</a> on November 24 as part of what it described as its largest anti-scam crackdown. The effort followed Executive Order 14390, signed by President Donald Trump on March 6, which directed federal agencies to prioritize cybercrime and fraud.</p><p>\n\tThe DOJ said 30 defendants had been extradited to the US, while US prosecutors and agents had supported law enforcement in more than 10 countries during raids on compounds and call centers that targeted Americans.</p><h2 id=\"sec-1\">\n\t<strong>FBI Targets Scam Compounds</strong></h2><p>\n\tUnder Operation Blackout, the FBI said it had helped disrupt or dismantle more than 29 scam compounds across the Middle East, Africa and Asia. The agency said it had restrained nearly $17bn in criminal funds and that more than 50 people allegedly linked to the scams had been federally charged, while partner countries had arrested or detained more than 320 others.</p><p>\n\tThe FBI also reported helping free and return more than 2200 people trafficked into the compounds.</p><p>\n\tAssistant Attorney General A. Tysen Duva of the DOJ's Criminal Division said the department would not let scammers \"hide behind their screens or escape justice by committing these crimes abroad.\"</p><p>\n\tThe FBI credited <a href=\"https://www.fbi.gov/how-we-can-help-you/victim-services/national-crimes-and-victim-resources/operation-level-up\">Operation Level Up</a> with stopping over $143m in losses to victims since March 6 and freezing more than $350m through its Recovery Asset Team.</p><p>\n\t<em><a href=\"https://www.infosecurity-magazine.com/news/scam-centers-global-footprint/\">Read more on scam compounds: Scam Centers Expand Global Footprint with Trafficked Victims</a></em></p><h2 id=\"sec-2\">\n\t<strong>Crypto Freezes and BEC Cases</strong></h2><p>\n\tThe US Secret Service reported restraining more than $200m and recovering over $119m, while disrupting 1780 domains run by scammers. It also had over 1540 cases of business email compromise (BEC) under investigation.</p><p>\n\tIts cases included a cryptocurrency investment fraud scheme, allegedly run by scam centers based in Cambodia, that went after at least 174 US victims. In October, the Netherlands extradited a Chinese national over his alleged role, and he was arraigned in federal court in California's Central District.</p><p>\n\tThe State Department said it had funded work by US and Southeast Asian authorities that helped freeze over $1bn of stolen cryptocurrency and take down more than 1.4 million fake websites and accounts.</p><p>\n\tThe DOJ cited <a href=\"https://news.gallup.com/poll/710984/scam-victims-report-billions-lost-harm-mental-health.aspx\">Gallup research</a> estimating that scams cost Americans $68bn in 2025, with about one in 10 US adults affected either directly or via a household member.</p>","zhKind","complete","数据窃取","邮件安全","勒索","黑产","Microsoft","https://www.infosecurity-magazine.com/news/doj-anti-scam-surge-800-defendants/","Infosecurity Magazine",{"_94":95,"_96":-5},"changelogVersion","2026-10-01T08:00","release"]
