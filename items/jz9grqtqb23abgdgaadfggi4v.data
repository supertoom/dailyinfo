[{"_1":2,"_3":4},"root",{"_5":89},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1794357638000,"id","jz9grqtqb23abgdgaadfggi4v","title","Ahold Delhaize网络攻击致销售额损失18.6亿元，多地区业务中断","originalTitle","今年最高金额！欧洲零售巨头因网络攻击损失近20亿元","summary","Ahold Delhaize披露，上个月发生的网络攻击预计使第四季度净销售额减少2亿至2.5亿欧元，约合14.9亿至18.6亿元人民币，并使基础营业利润和IFRS营业利润减少7500万至1亿欧元。","reason","事件披露了攻击对跨区域零售运营、季度业绩和现金流造成的具体影响，并说明企业已关闭部分系统控制影响。","source",{"_72":88},"links",{"_81":87},"publishedAt","2026-11-09T09:43:20.782Z","discoveredAt","2026-11-09T11:43:20.789Z","timelineAt","category","activity","tags",[73,84,85,86],"score",73,"selected",true,"channel","news","story",{"_77":78,"_13":79},"x","readingMode","full","author","body",{"_61":80,"_81":-5,"_82":81,"_83":37},"outline",[],"relatedStories",[76],"topics",[68,69],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","feOhWbokMpm0","reportCount",2,"additionalSourceCount",1,{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","attack","name","攻击活动","ransomware","勒索软件",{"_77":78,"_13":79},"publicId","05ee57b3-5751-4b16-8fe5-8e07f6fa3263","Ahold Delhaize预估网络攻击损失","<p>\n                    世界五百强、欧洲零售集团Ahold Delhaize披露，上个月的网络攻击事件导致其销售额最多损失18.6亿元，这是安全内参公开记录今年因此损失最高的事件；据悉，该事件致使集团部分系统关闭，旗下欧美多个国家8个零售品牌的网站出现故障，部分连锁超市还出现线上订单无法处理和配送服务中断的情况。\n                </p><p>前情回顾·网络攻击造成巨额损失</p><ul><li><p><a href=\"https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247516839&amp;idx=1&amp;sn=54681ced91facf0a2a4791d94785af28&amp;scene=21#wechat_redirect\">AI访问权限遭盗用，多家企业损失近千万元</a></p></li><li><p><a href=\"https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247516551&amp;idx=1&amp;sn=e554be867aa89bd6f577177b80a0086c&amp;scene=21#wechat_redirect\">数百家地方公证机构遭网络攻击，至少损失约3亿元</a></p></li><li><p><a href=\"https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247516318&amp;idx=1&amp;sn=7b42de268ce1b4b7c4f2fb317e79ff86&amp;scene=21#wechat_redirect\">黑客用偷来的数据“零元购”，这家上市公司损失超8800万元</a></p></li><li><p><a href=\"https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247516222&amp;idx=1&amp;sn=1ba8470675ce0f6fe343f0b9a3bec2f0&amp;scene=21#wechat_redirect\">某电网电表数据遭大规模非法篡改，损失逾7000万元</a></p></li></ul><p>安全内参11月9日消息，欧洲零售巨头Ahold Delhaize表示，上个月发生的<a href=\"https://www.secrss.com/articles/94696\">网络攻击</a>干扰了其美国及欧洲多国业务，预计导致公司第四季度净销售额减少2亿至2.5亿欧元（约合14.9亿至18.6亿元人民币）。</p><p>Ahold Delhaize系荷兰与比利时合资，旗下拥有Albert Heijn、Delhaize、Food Lion和Hannaford等零售品牌。该公司在公布第三季度业绩时，披露了上述损失预估。此次网络攻击发生在第三季度结束之后。</p><p>公司预计，此次网络安全事件还将影响第四季度基础营业利润和按国际财务报告准则（IFRS）计算的营业利润，预计损失7500万至1亿欧元（约合5.6亿至7.5亿元人民币）。此外，公司还将承担事件响应和系统修复等相关费用，但预计这些费用对2026年按IFRS计算的营业利润影响不大。</p><p><img src=\"/dailyinfo/media/663abc06fdd8b8c4.webp\" loading=\"lazy\" decoding=\"async\"></p><p>受此影响，Ahold Delhaize下调了2026年业绩指引。公司目前预计，按固定汇率计算，基础摊薄后每股收益将只有小幅增长，增幅处于个位数低段，低于此前预期的个位数中高段。</p><p>公司还将自由现金流预期从至少23亿欧元（约合172.2亿元人民币）下调至约21亿欧元（约合157.5亿元人民币）。Ahold Delhaize表示，这一调整主要因为网络攻击，以及塞尔维亚新出台的供应商付款规定。</p><p>部分系统被迫关闭，</p><p>致使多地区线上业务中断</p><p>今年10月中旬，公司首次披露此次事件，称在发现网络安全问题后，已主动切断部分系统。10月19日，公司确认遭到网络攻击，并表示截至当时，没有证据表明客户、员工或合作伙伴的数据被窃取。</p><p>Ahold Delhaize总裁兼首席执行官Frans Muller在随最新财务报告发布的声明中表示：“按照公司评估和缓解网络安全事件的既定流程，我们关闭了部分系统，以保护内部IT环境。此次事件对业务的影响程度不一，主要集中在比荷卢地区和美国的线上业务，以及比荷卢地区的供应链运营。”</p><p>他表示：“大部分业务中断在两周内基本得到控制，但我们仍在继续开展工作，以全面恢复正常运营。”</p><p>截至目前，Ahold Delhaize尚未披露此次网络攻击的具体类型。</p><p>Muller表示：“网络安全事件无疑占用了我们大量精力，但我们必须客观看待其影响。我们的应对措施体现了企业的弹性，这起事件并不能代表我们的业务能力。”</p><p>这并非Ahold Delhaize的系统首次成为网络攻击目标。2024年11月，该公司遭遇勒索软件攻击，旗下多个美国品牌的业务受到影响，包括Hannaford超市和Giant Food药房。勒索软件组织INC Ransom声称对此次攻击负责。此后，Ahold Delhaize披露，超过220万人的个人信息遭到泄露。</p><p><strong>参考资料：bleepingcomputer.com</strong></p><p>声明：本文来自安全内参，版权归作者所有。文章内容仅代表作者独立观点，不代表安全内参立场，转载目的在于传递更多信息。如有侵权，请联系 anquanneican@163.com。</p>","original","zhKind","complete","数据泄露","勒索","行业动态","https://www.secrss.com/articles/95502","安全内参",{"_90":91,"_92":-5},"changelogVersion","2026-10-01T08:00","release"]
