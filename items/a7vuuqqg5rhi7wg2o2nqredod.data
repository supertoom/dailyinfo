[{"_1":2,"_3":4},"root",{"_5":88},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1793621935000,"id","a7vuuqqg5rhi7wg2o2nqredod","title","工信部《信息通信行业发展“十五五”规划》要求、机遇与挑战分析","originalTitle","《信息通信行业发展“十五五”规划》要求、机遇与挑战分析","summary","工信部《信息通信行业发展“十五五”规划》提出到2030年建成覆盖全域的新一代信息通信基础设施，并部署6G、算力网络、工业互联网及网络和数据安全任务。规划提出基础设施累计投资3.8万亿元、通信网络连接规模达65亿、智能算力规模达800EFLOPS，同时要求运营商提升安全保障和资产利用效率，应对绿色发展与扩大开放带来的竞争压力。","reason","source",{"_70":87},"links",{"_79":86},"publishedAt","2026-11-01T23:38:37.394Z","discoveredAt","2026-11-02T03:38:37.405Z","timelineAt","category","policy","tags",[82,83,84,85],"score",32,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body",{"_60":78,"_79":-5,"_80":79,"_81":55},"outline",[],"relatedStories",[74],"topics",[67,68],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","f6T16mdexhwg","reportCount",1,"additionalSourceCount",0,{"_69":72,"_70":73},{"_69":30,"_70":71},"slug","name","政策法规","compliance","合规与标准",{"_75":76,"_13":77},"publicId","d0d6641b-0929-41e7-bb46-9a34c1a0e02c","工信部印发信息通信业“十五五”规划","<p>工信部近期印发《信息通信行业发展 “十五五” 规划》，为行业未来五年发展提供了明确指引。本文通过解读规划总体要求和主要特征，梳理重点推进方向、吃透政策要求、明晰风险底数，为把握“十五五”时期行业发展方向提供参考。</p><p>总体情况</p><p>此前工信部印发《信息通信行业发展 “十五五” 规划》（以下简称《规划》），是指导行业未来五年发展的纲领性文件。《规划》锚定基本实现新型工业化目标，以推动高质量发展为主题，明确“夯基础、惠民生、优治理、防风险、促开放”五个着力方向，提出到2030年建成覆盖全域、性能领先的新一代信息通信基础设施，构建泛在智联、敏捷高效的信息通信行业治理体系，打造全域联动、安全实用的网络和数据安全保障能力，行业赋能水平与全球化发展水平进一步提升，信息通信行业现代化迈出坚实步伐，为到2035年基本实现信息通信行业现代化奠定坚实基础。</p><p>总体来看，《规划》呈现三方面特征。一是突出定位升级，《规划》明确“十五五”时期是信息通信行业巩固提升竞争优势和领先地位的重要阶段，相较于“十四五”更侧重依托基础设施建设支撑经济社会高质量发展。二是突出智能主线，《规划》统筹基础设施、产业、应用、治理、安全多维度布局，明确了人工智能与信息通信深度融合的发展导向。三是突出动能培育，《规划》考虑当前行业增长有效放缓、增长新动能尚未形成的现状，部署了网络基础设施演进升级、6G技术研发、数智化应用落地等任务，力争打造新增长动能。</p><p>解读分析</p><p>《规划》系统明确了“十五五”时期信息通信行业发展的重点方向，对行业未来五年发展提出更高要求，也带来新的机遇和挑战。</p><p>（一）要求</p><p>在创新方面，《规划》强化产研融合创新导向，着眼于“十五五”大模型竞争、国际技术博弈加剧的外部形势，将“培育壮大信息通信产业体系”列为六大任务之一，部署加快6G核心技术攻关，系统开展光传输、数字孪生、卫星通信以及量子与后量子通信网络融合等交叉领域前沿技术布局，同时突出创新链向产业链贯通，推进重点产品创新和产业化。对运营商而言，需重点在6G技术攻关、国际标准制定等方面增强引领能力，同时开放创新资源，以场景应用带动上下游协同创新，推动技术优势转化为产业竞争优势。</p><p>在基础方面，《规划》对基础设施体系提出了更高要求，包括：网络升级、部署城市热点区域、双千兆、农村及偏远地区“双千兆”，提出适时启动6G商用、能力升级，部署构建“一网、算力、边缘”多层次算力设施体系，以及算力异构调度、低空 “毫秒秒用” 等行动。重点推进先进算力资源配置：空间网络一体化、部署星基通信、星地融合、低空通信、星座整合、低空通信等，特别是《规划》首次提出加快发展智简骨干网，同时设置骨干网、围绕构建智简网络标识体系，加快网络设备建设应用、推动全球标识互通、建设空间管控体系等作出系统部署。对运营商而言，一是要更好用好网络演进节奏，重点承担5G-A持续覆盖、万兆光网、“多多通千村、村村通5G” 等任务，积极推进6G商用和星地融合网络布局；二是深度参与全国一体化算力网络建设，做好先进算力布局和算力协同，助力算力网络国产化；三是可积极参与空天网络标准研究和试验网建设，探索新兴赛道建设发展空间。</p><p>在安全方面，《规划》将“全国增强网络和数据安全保障能力”单列为重要任务之一，数实融合安全成为新重点，同时对深化电信网络诈骗防范治理、强化应急通信保障能力等作出详细部署。对运营商而言，一是需持续提升网络、数据安全保护和通信应急保障能力，确保网络运行安全稳定；二是可重点发展嵌入人工智能赋能的安全能力，推动攻防补防、风险防控、应急处置能力升级；三是结合数实融合安全标准体系建设，探索拓展面向工业互联网、车联网、低空等新兴融合场景的安全产品服务。</p><p>（二）机遇</p><p>一是通信连接边界拓展机遇。《规划》提出通信网络连接规模达65亿，较2025年增长约11亿的目标，增量连接将主要来自于移动物联网（其中移动物联网连接用户净增目标约10亿）、卫星、智能体等新方向，表明“十五五”时期通信领域的增长逻辑将由传统人际通信和地面连接，向多主体、全空间连接延伸，打开通信服务新场景的增量空间。对运营商而言，可重点关注《规划》中明确的智慧网联汽车、家庭机器人、AI终端等新型智能终端和应用机遇，手机直连卫星、万物智联，以及制造业全链条物联感知应用带来的连接增长机遇，持续挖掘“万物智联”新空间。</p><p>二是算力资源价值转化机遇。《规划》提出2030年智能算力规模达到 800EFLOPS、较2025年增长5倍以上，同时提出构建全国统一算力服务市场，部署普惠算力赋能中小企业，算力经济迎来多重行动。这表明“十五五”时期，算力及算力网络的重点由资源规模扩张向着应用、价值转化。对运营商而言，有机会更好发挥网络优势，提高算力资源利用率，依托上级部门的专项行动，把持续投入更快转化为业务收入。</p><p>三是行业数据服务规模发展机遇。工业互联网是信息通信赋能新型工业化的关键抓手。《规划》将“全国拓展生产领域数智化应用规模”置于融合应用章节首位，设置“工业互联网创新发展”专栏，部署中小企业数智化赋能、工业互联网“强基扶弱”等专项行动，表明“十五五”时期工业互联网发展重点将由网络化、数字化向高质量、转向智能化、规模化应用。对运营商而言，可重点关注《规划》提出的“平台+大模型”“平台+数字孪生”等新业态，大力提升“平台+解决方案”供给水平，打造“小快轻省”解决方案，支撑更大范围智能制造。</p><p>四是信息基础设施与服务出海机遇。《规划》首次将“提升行业全球化发展水平”独立成章，提出深化对外开放布局、强化跨境国际信息通信和光缆项目，要求加快卫星通信网络全球覆盖，明确支持企业面向新兴市场拓展 5G、算力设施、人工智能、卫星通信等信息基础设施相关业务，表明“十五五”时期国际化布局由配套网络建设服务上升为培育行业新动能的重要方向。对运营商而言，可重点关注南向、西亚欧洲等滨海及中等收入联通市场、卫星覆盖，以及“一带一路”、金砖国家等新兴市场的数智化需求，加快测算新一轮业务出海布局。</p><p>五是监管政策红利释放机遇。《规划》进一步明确健全基础电信竞争规则，突出深化非理性竞争行为治理，释放出改善行业竞争生态的明确信号，对运营商而言，应坚持合规经营，发挥网络、服务、品牌等差异化优势，提升经营效益。</p><p>（三）挑战</p><p>一是资本投入与回报平衡压力较大。《规划》提出“十五五”期间信息通信基础设施累计投资3.8万亿元，较“十四五”增加1000亿元。资本开支将持续高位，同时通信行业正处于新旧动能转换期，传统业务增长趋缓、新动能尚在培育，收入增速目标较“十四五”明显下测，资本开支与收入增长剪刀差持续扩大。在保持高投入的同时，如何提升资产利用效率和投入产出水平，成为行业面临的关键挑战。</p><p>二是绿色发展约束进一步强化。《规划》提出单位电信业务总量综合能耗下降17%，新建大型超大型算力设施PUE小于1.2，相关指标要求较“十四五”进一步提升。该类目标虽为预期性目标，但监管层将通过窗口指导等手段推动加速转型，明确绿色低碳技术路径、统筹算力协同布局等，成为运营商需要应对的重要课题。</p><p>三是扩大开放带来竞争风险。《规划》明确扩大电信业对外开放试点的区域和业务范围，自2024年试点启动以来，已有166家外资企业获批开展IDC、CDN等相关业务，后续开放试点范围可能进一步扩容，外资进入节奏加快，运营商营商格局迎来深刻变局，需提前做好应对布局。</p><p>作者：</p><p>张丽贤</p><p>就职于中国移动研究院战略与产业所，主要从事企业战略、数字经济领域研究工作。</p><p>李毅君</p><p>就职于中国移动研究院战略与产业所，主要从事 ICT 产业、企业战略领域研究工作。</p><p>祝婷婷</p><p>就职于中国移动研究院战略与产业所，主要从事企业战略、数字经济领域研究工作。</p><p>审核：</p><p>宋镇亮 | 战略与产业研究所</p><p>声明：本文来自中移智库，版权归作者所有。文章内容仅代表作者独立观点，不代表安全内参立场，转载目的在于传递更多信息。如有侵权，请联系 anquanneican@163.com。</p>","original","zhKind","complete","政策","标准","治理","合规","https://www.secrss.com/articles/95236","安全内参",{"_89":90,"_91":-5},"changelogVersion","2026-10-01T08:00","release"]
