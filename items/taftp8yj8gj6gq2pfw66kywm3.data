[{"_1":2,"_3":4},"root",{"_5":110},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1795048838000,"id","taftp8yj8gj6gq2pfw66kywm3","title","OpenJDK Java4Shell 漏洞 CVE-2026-114938 可导致 RCE，Oracle 已发布补丁","originalTitle","Critical Java4Shell flaw allows RCE attacks on major Java applications","summary","OpenJDK 的 Java4Shell 漏洞 CVE-2026-114938 可被未认证攻击者用于 RCE，并可能泄露内存敏感信息。该内存破坏缺陷影响 OpenJDK 17.0.6 及之后版本，Calif 评为 CVSS 4.0 9.2，Oracle 评为 CVSS 3.1 8.1（High）。","reason","source",{"_75":109},"links",{"_93":108},"publishedAt","2026-11-17T23:04:21.000Z","discoveredAt","2026-11-17T23:22:32.039Z","timelineAt","category","vuln","tags",[99,100,101,78,102,76,103,104,105,106,107],"score",92,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","sameEvent",{"_11":97,"_13":98},"readingMode","full","author","Lawrence Abrams","body",{"_62":92,"_93":-5,"_94":95,"_96":36},"outline",[86],"relatedStories",[82],"topics",[69,70,71,72],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","f8X9-lkLyK9M","reportCount",11,"additionalSourceCount",10,{"_73":80,"_75":81},{"_73":30,"_75":79},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","research","name","技术研究","exploited","在野利用","漏洞披露","oracle","Oracle / 甲骨文",{"_83":84,"_13":85},"publicId","8540cb70-bd3c-4700-8134-83f02bb49280","Java4Shell已修复，Red Hat补丁仍缺",{"_11":87,"_88":89,"_90":91},"sec-1","text","发现现有防御可能遗漏的电子邮件威胁。","level",2,"<p><img alt=\"\" height=\"900\" src=\"/dailyinfo/media/305393b2650fc9ef.jpg\" srcset=\"/dailyinfo/media/35399af34a2636a3.jpg 720w, /dailyinfo/media/f85f040737ab267f.jpg 1200w, /dailyinfo/media/305393b2650fc9ef.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>一个名为 Java4Shell 的严重漏洞存在于 Java 的开源实现 OpenJDK 中，可允许未经身份验证的攻击者在 Jenkins、Atlassian Jira、Confluence 和 Keycloak 等热门企业应用上远程执行代码。</p><p>Java 是全球使用最广泛的编程平台之一，为企业应用、Web 服务、金融系统和关键业务基础设施提供支持。</p><p>由于许多应用使用相同的 Java 运行时，其核心组件中的漏洞可能影响广泛且彼此无关的应用。</p><p><a href=\"https://www.wiz.io/lp/ai-security-starter-pack?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Security-Starter-Kit&amp;sfcid=701Vh00000cn7aRIAQ&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AI-Security-Bundle\"><img src=\"/dailyinfo/media/8e91e489e17d9582.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>该漏洞的追踪编号为 <a href=\"https://www.cve.org/CVERecord?id=CVE-2026-114938\">CVE-2026-114938</a>，是 Java 硬件加速 Base64 解码功能中的内存破坏缺陷，可被利用来泄露内存中的敏感信息或实现远程代码执行（RCE）。</p><p>Calif 的安全研究人员于周二<a href=\"https://calif.io/java4shell/\">披露了该缺陷</a>，他们将其评为严重级别，CVSS 4.0 评分为 9.2；而 Oracle 使用 CVSS 3.1 给出的严重性评级较低，为 8.1（高危）。</p><p>Java4Shell 影响 OpenJDK 17.0.6 及更高版本，也影响基于受影响代码构建的 Java 发行版，包括 Oracle Java SE、Amazon Corretto、Eclipse Temurin、Microsoft Build of OpenJDK、Azul Zulu 和 Red Hat OpenJDK。</p><p>该漏洞源于 Java Base64 解码器中的一个问题，该解码器会处理常见于身份验证、文件上传和网络通信中的编码数据。</p><p>据 Calif 称， specially crafted Base64 数据可导致解码器覆写 Java 内存的部分区域，攻击者可能借此窃取敏感信息或执行恶意代码。</p><p>研究人员表示，只需 64 个 \"A\" 字符后跟一个等号（=），即可触发内存破坏：</p><pre><code>AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</code></pre><p>较旧的 OpenJDK 17 版本需要 128 个 \"A\" 字符后跟等号。</p><p>该缺陷仅影响某些支持 AVX-512 指令的 x86-64 处理器上使用的硬件加速解码函数。</p><p>研究人员已经能够利用此漏洞，针对以默认配置运行的各种常用 Java 应用执行远程代码攻击，包括：</p><ul>\n\t<li><strong>未经身份验证的 RCE：</strong>Keycloak、Atlassian Jira、Atlassian Confluence、JFrog Artifactory、Jenkins 和 PingFederate。</li>\n\t<li><strong>经身份验证的 RCE：</strong>Apache Kafka Broker、Apache Solr、Elasticsearch、Gerrit 和 Spinnaker。</li>\n</ul><p>Calif 还成功利用了该漏洞，影响了使用 Apache Struts 和 Spring Boot 框架构建的示例应用。</p><p>不过，研究人员表示 Java4Shell 并不存在通用漏洞利用方式，攻击者必须找到一种依赖具体应用的方法，将恶意 Base64 数据传递给存在漏洞的解码器，才能实现代码执行。</p><p>利用该漏洞还必须使用受影响的硬件加速 AVX-512 解码函数，而其是否被使用取决于支持 AVX-512 VBMI 功能的 x86-64 处理器。</p><p>Calif 表示，研究人员 Quang Luong 使用 OpenAI 的 Codex AI 编程助手发现了该缺陷，该助手在审计 OpenJDK 内部实现期间帮助识别了这一漏洞。</p><p>据研究人员称，Luong 约用一小时发现了该缺陷，又用两小时开发出初始的可利用漏洞，总 AI 使用成本低于 $200。</p><p>该公司表示，AI 智能体还帮助开发了额外的特定应用漏洞利用链。</p><p>Calif 已发布一份概念验证，展示了内存损坏问题，但尚未发布用于攻击受影响企业应用程序的武器化漏洞利用代码。</p><p>Oracle 于 11 月 17 日发布了 CVE-2026-114938 的补丁，作为其<a href=\"https://www.oracle.com/security-alerts/cspunov2026.html\">11 月关键安全补丁更新</a>的一部分，此次更新修复了其产品组合中的 655 个安全漏洞。</p><p>该公司建议客户尽快安装可用的安全补丁。</p><p>对于无法立即更新 Java 实现的用户，Calif 建议通过使用 <code>-XX:-UseBASE64Intrinsics</code> 选项启动 OpenJDK，禁用存在漏洞的硬件加速 Base64 功能。</p><p>或者，在 x86-64 系统上运行 Java 的管理员可以使用 <code>-XX:UseAVX=2</code> 禁用 AVX-512 指令。</p><p>不过，这些变通方法只是临时缓解措施，所有开发人员都应将 Java 运行时更新至最新版本。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/2873ab279056c37c.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 代理会分析电子邮件意图、上下文和行为，揭示网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>对 Microsoft 365 或 Google Workspace 进行为期 14 天的只读扫描，看看有哪些威胁正在穿透，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始您的免费电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","vswsohxmcbyf63rfffrs81z1z","Oracle Java SE JIT 编译器堆越界写入漏洞 CVE-2026-114938 可导致远程代码执行","漏洞","复现","漏洞利用","补丁","Oracle","Red Hat","AWS","Microsoft","Atlassian","https://www.bleepingcomputer.com/news/security/critical-java4shell-flaw-allows-rce-attacks-on-major-java-applications/","BleepingComputer",{"_111":112,"_113":-5},"changelogVersion","2026-10-01T08:00","release"]
