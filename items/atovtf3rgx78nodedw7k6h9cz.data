[{"_1":2,"_3":4},"root",{"_5":108},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1795480833000,"id","atovtf3rgx78nodedw7k6h9cz","title","Cleverbridge 遭黑客入侵，支付卡号与 CVV/CVC 数据被窃","originalTitle","Cleverbridge warns hackers stole credit card numbers, CVVs in data breach","summary","Cleverbridge 表示，黑客入侵其平台并窃取客户用于平台购物的支付卡号、到期日和 CVV/CVC 安全码，但未泄露姓名、联系方式或账单信息。公司于 2026 年 11 月 4 日发现未授权活动并临时下线系统，同日恢复后确认第三方复制了平台存储的支付卡数据；自 11 月 20 日起通知受影响客户，但尚未披露受影响客户数量、攻击者进入平台的方式、停留时间或数据是否加密。","reason","source",{"_76":107},"links",{"_96":106},"publishedAt","2026-11-22T15:43:04.000Z","discoveredAt","2026-11-22T15:59:15.526Z","timelineAt","category","activity","tags",[77,102,103,104,105],"score",70,"selected",true,"channel","news","story",{"_87":88,"_13":89},"x","sameEvent",{"_11":100,"_13":101},"readingMode","full","author","Lawrence Abrams","body",{"_62":95,"_96":-5,"_97":98,"_99":36},"outline",[90],"relatedStories",[86],"topics",[69,70,71,72,73],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","fea8ayf9y9fE","reportCount",3,"additionalSourceCount",2,{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","attack","name","攻击活动","compliance","合规与标准","black-market","数据窃取与黑产","ransomware","勒索软件","identity","身份与访问",{"_87":88,"_13":89},"publicId","42900179-ad52-4751-bb13-47a610d3391c","Cleverbridge确认客户支付卡数据失窃",{"_11":91,"_92":93,"_94":68},"sec-1","text","发现您现有的防御措施可能遗漏的电子邮件威胁。","level","<p><img alt=\"Credit Cards\" height=\"900\" src=\"/dailyinfo/media/0d9e942ee77d1cf9.jpg\" srcset=\"/dailyinfo/media/18d9fea350546d29.jpg 720w, /dailyinfo/media/1a1021c7f2727c5f.jpg 1200w, /dailyinfo/media/0d9e942ee77d1cf9.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>电子商务平台 Cleverbridge 警告称，黑客入侵了其系统并窃取了客户的支付卡信息，包括信用卡号和 CVV 安全码。</p><p>Cleverbridge 为软件和 SaaS 公司提供电子商务服务，使这些公司能够销售产品、处理付款并管理订阅。</p><p>该公司<a href=\"https://grow.cleverbridge.com/resources/client-stories\">列出了众多科技品牌</a>作为其客户，包括 Red Hat、SUSE、Tenable、Veeam、Jamf、Sony 和 Parallels。然而，它没有披露哪些企业的客户受到了此次数据泄露的影响。</p><p><a href=\"https://www.wiz.io/lp/claude-code-security-best-practices-cheat-sheet?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q3_INB_FORM_Claude-Code-Security-Best-Practices&amp;sfcid=701Vh00000gJQZuIAO&amp;utm_term=FY27Q4-bleepingcomputer-article-970x250-Nov&amp;utm_content=Claude-Code-Best-Practices\"><img src=\"/dailyinfo/media/8cac6f24e6d97493.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>在一则关于该安全事件的新页面中，Cleverbridge 表示其于 2026 年 11 月 4 日发现了未经授权的活动，并临时下线了系统以控制此次泄露。</p><p>\"所有系统均已于 2026 年 11 月 4 日重新上线；然而，我们随后的调查确认，第三方复制了存储在我们平台上的支付卡数据，\"<a href=\"https://grow.cleverbridge.com/incident-update\">安全事件披露</a>写道。</p><p>Cleverbridge 于 11 月 20 日开始通知受影响的客户，警告称黑客窃取了用于通过其平台进行购买的支付卡详细信息。</p><p>尽管其公开披露确认了支付卡数据被窃，但并未说明具体窃取了哪些卡信息，而是让受影响的客户查看各自的通知以获取更多信息。</p><p>然而，一份与 BleepingComputer 分享的泄露通知显示，被窃取的信息包括支付卡号、有效期和 CVV/CVC 安全码。</p><p>\"根据我们迄今为止的调查，所涉信息包括您用于通过 Cleverbridge 购买商品时使用的支付卡详细信息，尤其是您的卡号、有效期、卡安全码（CVV/CVC），\"该通知写道。</p><p>\"但请注意，没有其他个人数据（例如您的姓名、联系方式或账单信息）被复制。受影响的卡片尾号为 XXXX。\"</p><p>BleepingComputer 对受影响支付卡的最后四位数字进行了遮挡处理。</p><p>该公司尚未披露攻击者是如何访问其平台的、其在系统中停留了多长时间，或有多少客户受到了此次泄露的影响。</p><p>尤其令人担忧的是 CVV/CVC 安全码被窃取，因为这些代码用于验证支付卡交易。</p><p>Cleverbridge 还确认此次事件并非勒索软件攻击，攻击者也没有加密其任何系统。</p><p>该公司表示，已就此次事件通知了数据保护机构、执法机构、支付卡网络和支付合作伙伴。</p><p>Cleverbridge 还在与 TransUnion 旗下的 Cyberscout 合作，分发泄露通知并向受影响的客户提供免费的信用监控和欺诈协助。</p><p>受影响的客户被要求检查其支付卡对账单中是否存在未经授权的交易。Cleverbridge 还建议就此事件联系发卡机构，因为银行可能会决定更换已泄露的卡片。</p><p>BleepingComputer 就以下问题联系了 Cleverbridge：有多少客户受到影响、攻击者是如何访问其系统的、被窃取的支付卡数据是否经过加密，以及 CVV/CVC 安全码为何可被访问。</p><p>该公司未回应我们的提问。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/af2e1e4209b93434.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现您现有的防御措施可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体分析电子邮件意图、上下文和行为，以发现网络钓鱼、商务邮件入侵和发票欺诈。</p><p>通过 14 天只读扫描查看 Microsoft 365 或 Google Workspace 中有哪些内容被成功传递，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始您的免费电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","mka3rxabqos640n2q50926yhp","Cleverbridge 确认平台客户支付卡数据遭窃取","数据泄露","数据窃取","凭据","合规","https://www.bleepingcomputer.com/news/security/cleverbridge-warns-hackers-stole-credit-card-numbers-cvvs-in-data-breach/","BleepingComputer",{"_109":110,"_111":-5},"changelogVersion","2026-10-01T08:00","release"]
