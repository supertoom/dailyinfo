[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1793666561000,"id","fp6xofbj8sbfomr2rwpqm1csk","title","Cerber 变种利用 CVE-2026-13639 和 CVE-2026-13684 加密群晖 NAS 文件","originalTitle","突发！1day漏洞致使大量NAS用户文件被加密","summary","Cerber 勒索变种 C3RB3R 已利用 CVE-2026-13639 和 CVE-2026-13684 攻击群晖 NAS，并使用 ChaCha8 与 RSA2048 加密文件、改名为 .L0CK3D 并留下勒索信。","reason","文章结合反勒索求助样本与补丁版本，说明了 Cerber 变种利用两个远程漏洞加密群晖 NAS 文件的完整行为链。","source",{"_75":97},"links",{"_90":96},"publishedAt","2026-10-30T02:24:00.000Z","discoveredAt","2026-10-30T05:42:44.228Z","timelineAt","category","activity","tags",[78,93,76,80,94,95],"score",75,"selected",true,"channel","news","story",{"_86":87,"_13":88},"x","readingMode","full","author","body",{"_61":89,"_90":-5,"_91":90,"_92":37},"outline",[],"relatedStories",[85],"topics",[68,69,70,71,72],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fuza7NKj9Q_w","reportCount",1,"additionalSourceCount",0,{"_73":83,"_75":84},{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","malware","name","恶意软件","attack","攻击活动","exploited","在野利用","ransomware","勒索软件","iot","IoT 与车联网",{"_86":87,"_13":88},"publicId","2949ac1d-5e61-43df-beff-1f3190aa95b7","C3RB3R借群晖旧版漏洞勒索NAS","<p><span>欢迎关注→</span> <span>2026-10-30 10:24</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/3a3cd09c103b6a28.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><span><span><span>今年10月以来，360反勒索服务连续接到多起针对群晖NAS设备的勒索攻击求助。反勒索团队利用360AI安全专家，对被攻击设备进行了采样分析，确认本轮勒索攻击的主要源头是老牌勒索家族Cerber的一个变种“</span></span></span><span><span><span><span>C3RB3R</span></span></span><span><span><span>”，该家族长期针对NAS设备实施加密勒索，此次攻击使用了两个今年9月披露的漏洞。</span></span></span></span></p><p><span><span><img src=\"/dailyinfo/media/4d28232b58df4f3f.jpg\" loading=\"lazy\" decoding=\"async\"></span></span></p><p><span><span><span>▲ 图1：Cerber（C3RB3R）攻击群晖NAS流程示意</span></span></span></p><p><span><span><span><span>经详细排查发现，本轮攻击的切入点是两个高危远程漏洞，CVE编号分别为</span></span></span><span><span><span>CVE-2026-13639</span></span></span><span><span><span>和</span></span></span><span><span><span>CVE-2026-13684</span></span></span><span><span><span>。这两个漏洞于今年9月披露，距今仅一个月左右，这意味着网络中仍有大量设备尚未更新系统修补漏洞，很多用户也根本不清楚这两个漏洞的存在和危害性，本次攻击是一个典型的</span></span></span><span><span><span>1day漏洞攻击场景</span></span></span><span><span><span>。</span></span></span></span></p><p><span><span><span>一、拆解分析：Cerber勒索\"走新路，穿旧鞋\"</span></span></span></p><p><span><span><span><span>Cerber虽然在攻击入口阶段采用了这两个1day高危漏洞，但其在入侵成功进入受害设备后，执行的操作依然是</span></span></span><span><span><span>加密、留信、等赎金</span></span></span><span><span><span>的\"老三样\"。</span></span></span></span></p><p><span><span><span>1️⃣ 扫描系统</span></span></span></p><p><span><span><span><span>Cerber进入受害设备后，会扫描当前系统中的文件，跳过特定系统目录以避免加密文件导致系统崩溃，进而影响自身的持续加密。跳过的目录共</span></span></span><span><span><span>27个</span></span></span><span><span><span>，具体列表如下：</span></span></span></span></p><p><span><span><span>/boot /run /proc /sys /dev</span></span></span></p><p><span><span><span>/etc /config /sbin /bin /lib</span></span></span></p><p><span><span><span>/lib32 /lib64 /usr/sbin /usr/bin /usr/lib</span></span></span></p><p><span><span><span>/usr/lib32 /usr/lib64 /usr/include /usr/local /usr/share</span></span></span></p><p><span><span><span>/usr/src /usr/syno /var/packages /var/lock /var/run</span></span></span></p><p><span><span><span>/var/tmp /tmp</span></span></span></p><p><span><span><span>而对于其他所有目录，Cerber均会进入目录进行递归扫描并加密其中的文件。对于文件名及扩展名，Cerber会跳过常见的可执行文件或脚本，以及被加密后的文件。被跳过的文件名及扩展名如下：</span></span></span></p><p><span><span><span>.exe .dll .lnk .sys .msi .bat .mod</span></span></span></p><p><span><span><span>read-me3.txt C3RB3R_LOG.txt init-rsysd.lo init-ld.lo .L0CK3D</span></span></span></p><p><span><span><span>2️⃣ 加密文件</span></span></span></p><p><span><span><span><span>进入核心的文件加密流程，Cerber勒索软件依然采用当前较为主流的</span></span></span><span><span><span>ChaCha8（对称加密算法）+ RSA2048（非对称加密算法）</span></span></span><span><span><span>的加密算法策略。实施加密时，Cerber会对每个待加密文件生成一份单独的</span></span></span><span><span><span>256位密钥文件及64位nonce</span></span></span><span><span><span>，再使用ChaCha8算法对文件内容实施加密。加密完成后，利用样本内置的RSA公钥，对加密密钥及加密模式、加密位置、文件原始信息等数据进行加密，并将全部密文附在被加密文件的数据尾部。最终，将被加密文件扩展名修改为\"</span></span></span><span><span><span>.L0CK3D</span></span></span><span><span><span>\"，以标记该文件已加密完成。</span></span></span></span></p><p><span><span><span>此外，勒索样本中还附带了一份文件扩展名列表。扩展名在该列表中的文件，Cerber采用了完整加密的策略，而其他文件则采用区分大小的选择性加密策略。其加密策略如下：</span></span></span></p><table><tbody><tr><td><p><span><span><span>文件类型</span></span></span></p></td><td><p><span><span><span>加密策略</span></span></span></p></td></tr><tr><td><p><span><span><span>文件后缀在优先列表中</span></span></span></p></td><td><p><span><span><span>不区分文件大小，全文件加密</span></span></span></p></td></tr><tr><td><p><span><span><span>小于约1MB的普通文件</span></span></span></p></td><td><p><span><span><span>全文件加密</span></span></span></p></td></tr><tr><td><p><span><span><span>约1MB到约5MB的普通文件</span></span></span></p></td><td><p><span><span><span>只加密头部约1MB的数据</span></span></span></p></td></tr><tr><td><p><span><span><span>大于约5MB的普通文件</span></span></span></p></td><td><p><span><span><span>以约5MB大小分段加密，仅加密每段头部约1MB数据</span></span></span></p></td></tr></tbody></table><p><span><img src=\"/dailyinfo/media/ecc022eea76a6307.jpg\" loading=\"lazy\" decoding=\"async\"></span></p><p><span><span><span>▲ 图2：受害群晖NAS中被加密的文件（扩展名被改为.L0CK3D）</span></span></span></p><p><span><span><span><span>而不区分大小全文件加密的优先扩展名共</span></span></span><span><span><span>187个</span></span></span><span><span><span>，全部列举如下：</span></span></span></span></p><p><span><span><span>.4dd .4dl .accdb .accdc .accde .accdr .accdt</span></span></span></p><p><span><span><span>.accft .adb .ade .adf .adp .arc .ora</span></span></span></p><p><span><span><span>.alf .ask .btr .bdf .cat .cdb .ckp</span></span></span></p><p><span><span><span>.cma .cpd .dacpac .dad .dadiagrams .daschema .db-shm</span></span></span></p><p><span><span><span>.db-wal .db3 .dbc .dbf .dbs .dbt .dbv</span></span></span></p><p><span><span><span>.dbx .dcb .dct .dcx .ddl .dlis .dp1</span></span></span></p><p><span><span><span>.dqy .dsk .dsn .dtsx .dxl .eco .ecx</span></span></span></p><p><span><span><span>.edb .epim .exb .fcd .fdb .fic .fmp</span></span></span></p><p><span><span><span>.fmp12 .fmpsl .fol .fp3 .fp4 .fp5 .fp7</span></span></span></p><p><span><span><span>.fpt .frm .gdb .grdb .gwi .hdb .his</span></span></span></p><p><span><span><span>.ibd .idb .ihx .itdb .itw .jet .jtx</span></span></span></p><p><span><span><span>.kdb .kexi .kexic .kexis .lgc .lwx .maf</span></span></span></p><p><span><span><span>.maq .mar .mas .mav .mdb .mdf .mpd</span></span></span></p><p><span><span><span>.mrg .mud .mwb .myd .ndf .nnt .nrmlib</span></span></span></p><p><span><span><span>.ns2 .ns3 .ns4 .nsf .nv2 .nwdb .nyf</span></span></span></p><p><span><span><span>.odb .oqy .orx .owc .p96 .p97 .pan</span></span></span></p><p><span><span><span>.pdb .pdm .pnz .qry .qvd .rbf .rctd</span></span></span></p><p><span><span><span>.rod .rodx .rpd .rsd .sas7bdat .sbf .scx</span></span></span></p><p><span><span><span>.sdb .sdc .sdf .sis .spq .sql .sqlite</span></span></span></p><p><span><span><span>.sqlite3 .sqlitedb .temx .tmd .tps .trc .trm</span></span></span></p><p><span><span><span>.udb .udl .usr .v12 .vis .vpd .vvv</span></span></span></p><p><span><span><span>.wdb .wmdb .wrk .xdb .xld .xmlff .abcddb</span></span></span></p><p><span><span><span>.abs .abx .accdw .adn .db2 .fm5 .hjt</span></span></span></p><p><span><span><span>.icg .icr .lut .maw .mdn .mdt .vdi</span></span></span></p><p><span><span><span>.vhd .vmdk .pvm .vmem .vmsn .vmsd .nvram</span></span></span></p><p><span><span><span>.vmx .raw .qcow2 .subvol .bin .vsv .avhd</span></span></span></p><p><span><span><span>.vmrs .vhdx .avdx .vmcx .iso</span></span></span></p><p><span><span><span>3️⃣ 勒索信息</span></span></span></p><p><span><span><span><span>最终，Cerber会在每个被加密的目录中留下一份名为\"</span></span></span><span><span><span>read-me3.txt</span></span></span><span><span><span>\"的勒索信文件，提醒用户文件已被加密，要求尽快交付赎金。这份勒索信息的文件内容如下（文中问号部分，在实际执行时会替换为本地生成的6位设备识别ID）：</span></span></span></span></p><p><span><span><img src=\"/dailyinfo/media/3672052f029d58d6.webp\" loading=\"lazy\" decoding=\"async\"></span></span></p><p><span><span><span>▲ 图3：Cerber（C3RB3R）勒索信 read-me3.txt</span></span></span></p><p><span><span><span>二、修漏补缺，及时更新NAS系统</span></span></span></p><p><span><span><span>由于本轮攻击的主要目标是群晖的NAS设备，其运行的是硬件设备上高度定制化的私有系统。对于这种环境中的安全防护，往往非常依赖供应商提供的系统更新或漏洞补丁。</span></span></span></p><p><span><span><span><span>所幸的是，群晖在漏洞被披露的第一时间（</span></span></span><span><span><span>2026年9月18日</span></span></span><span><span><span>），就发布了针对这批漏洞补丁的系统更新。具体的系统更新版本号如下：</span></span></span></span></p><table><tbody><tr><td><p><span><span><span>设备系统版本</span></span></span></p></td><td><p><span><span><span>漏洞已被修补的更新版本号</span></span></span></p></td></tr><tr><td><p><span><span><span>DSM 7.4</span></span></span></p></td><td><p><span><span><span>更新至 7.4-90075 或更高版本</span></span></span></p></td></tr><tr><td><p><span><span><span>DSM 7.3</span></span></span></p></td><td><p><span><span><span>更新至 7.3.2-86009-4 或更高版本</span></span></span></p></td></tr><tr><td><p><span><span><span>DSM 7.2.2</span></span></span></p></td><td><p><span><span><span>更新至 7.2.2-72806-9 或更高版本</span></span></span></p></td></tr><tr><td><p><span><span><span>DSM 7.2.1</span></span></span></p></td><td><p><span><span><span>更新至 7.2.1-69057-12 或更高版本</span></span></span></p></td></tr></tbody></table><p><span><span>群晖在这波更新中共修复了&nbsp;</span></span><span><span><span><span>8个漏洞</span></span></span><span><span><span>，这些漏洞的CVE编号及作用分别如下：</span></span></span></span></p><p><span><span><span>CVE-2026-13684 / CVE-2026-13639 / CVE-2026-13635</span></span></span></p><p><span><span><span>这一组三个漏洞允许远程攻击者读/写任意文件、进行拒绝服务（DoS）攻击或获取非敏感信息。</span></span></span></p><p><span><span><span>CVE-2026-13673 / CVE-2026-6205 / CVE-2026-13666</span></span></span></p><p><span><span><span>这一组三个漏洞允许远程认证用户读/写任意文件；当受害用户点击共享网址时，允许写入权限受限的文件并实施拒绝服务（DoS）攻击。</span></span></span></p><p><span><span><span>CVE-2026-13623 / CVE-2026-13683</span></span></span></p><p><span><span><span>这一组两个漏洞允许具有管理员权限的远程认证用户读/写权限受限的文件或获取非敏感信息。</span></span></span></p><p><span><span>其他更多信息可以参考群晖官方发布的更新公告：</span></span></p><p><span><span><a href=\"https://www.synology.com/en-br/security/advisory/Synology_SA_26_13\">https://www.synology.com/en-br/security/advisory/Synology_SA_26_13</a></span></span></p><p><span><span><span>三、安全建议</span></span></span></p><p><span><span><span>针对本轮Cerber对群晖NAS发起的勒索攻击，我们给出如下安全建议：</span></span></span></p><ul><li><p><span><span>关注网络安全资讯，第一时间更新</span></span><span><span>NAS设备系统或安装安全补丁，封堵高危漏洞；</span></span></p></li><li><p><span><span>尽量</span></span><span><span>不要直接把</span></span><span><span>NAS管理端口映射</span></span><span><span>至</span></span><span><span>公网，</span></span><span><span>如需</span></span><span><span>外网访问</span></span><span><span>，优先使用</span></span><span><span>NAS厂商提供的跳转业务</span></span><span><span>或者</span></span><span><span>VPN</span></span><span><span>；</span></span></p></li><li><p><span><span>停用</span></span><span><span>设备初始的</span></span><span><span>默认</span></span><span><span>管理员</span></span><span><span>账号，</span></span><span><span>为所有</span></span><span><span>账号设置强</span></span><span><span>口令，尽可能</span></span><span><span>开启两步验证</span></span><span><span>及</span></span><span><span>自动</span></span><span><span>IP封锁</span></span><span><span>等安全验证机制；</span></span></p></li><li><p><span><span>开启共享文件夹快照并打开快照防篡改功能</span></span><span><span>；</span></span><span><span>定期检查快照是否正常生成</span></span><span><span>；</span></span></p></li><li><p><span><span>至少为重要数据</span></span><span><span>准备</span></span><span><span>一</span></span><span><span>份离线隔离备份</span></span><span><span>；该备份</span></span><span><span>平时</span></span><span><span>需断开与</span></span><span><span>NAS</span></span><span><span>的任何连接</span></span><span><span>，避免被勒索</span></span><span><span>软件</span></span><span><span>一并加密</span></span><span><span>；</span></span></p></li><li><p><span><span>开启</span></span><span><span>设备</span></span><span><span>防火墙，</span></span><span><span>仅</span></span><span><span>放行必要端口</span></span><span><span>，尽量为管理后台的访问权限</span></span><span><span>配置可信</span></span><span><span>IP白名单</span></span><span><span>；</span></span></p></li><li><p><span><span>定期查看日志中心，留意异常登录、批量文件修改，发现</span></span><span><span>可疑</span></span><span><span>后缀</span></span><span><span>或疑似</span></span><span><span>勒索文件</span></span><span><span>等情况，应</span></span><span><span>立刻断网</span></span><span><span>进行安全检查；</span></span></p></li><li><p><span><span>清理闲置共享链接、不用的套件和服务，缩小攻击面</span></span><span><span>；</span></span></p></li><li><p><span><span>不要支付赎金</span></span><span><span>！</span></span><span><span>不要支付赎金</span></span><span><span>！</span></span><span><span>不要支付赎金</span></span><span><span>！</span></span></p></li></ul><p><span><span>🚨 请立即检查你的群晖NAS系统版本，尽快升级固件、修补漏洞，谨防数据被恶意加密造成不可挽回的损失！</span></span></p><p><span><span><span>附录：入侵威胁指标（IOCs）</span></span></span></p><p><span><span><span>MD5：</span></span></span></p><p><span><span><span>a1375e0f82ae86df528876c049b5a23c</span></span></span></p><p><img src=\"/dailyinfo/media/c9a60adf41b38919.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>END</span></strong></p><p><span><span><span>推荐阅读</span></span></span></p><p><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzA5ODA0NDE2MA==&amp;mid=2649790630&amp;idx=1&amp;sn=0acf40c9d3d8e770595f319ed91c4318&amp;scene=21#wechat_redirect\"><span>凌晨收到GitLab安全公告，CVSS满分，我看了看自家版本号</span></a></span></p><p><span>2026-10-28</span></p><p><a href=\"https://mp.weixin.qq.com/s?__biz=MzA5ODA0NDE2MA==&amp;mid=2649790630&amp;idx=1&amp;sn=0acf40c9d3d8e770595f319ed91c4318&amp;scene=21#wechat_redirect\"><s