[{"_1":2,"_3":4},"root",{"_5":127},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":60,"_61":62},"expiresAt",1794616836000,"id","xkdscbx30se27tz9zmlkauf28","title","Cathedral使用AI Agent在12小时内渗透Anthropic内部Slack及敏感系统","originalTitle","12小时攻破AI巨头：Anthropic被AI Agent扒光Slack，前员工的预言应验了","summary","Cathedral使用自研AI Agent参加Anthropic外部漏洞悬赏测试，从第三方商业软件的漏洞切入，自动扫描并串联权限，12小时内访问销售、人力资源和IT系统，以及会议记录、员工薪资与录用待遇、部分客户联系方式和基础用户账户记录，还进入Slack查看AI模型研发讨论。","reason","该案例展示了AI Agent借第三方办公软件、SSO与API集成突破内网的具体路径，并给出可迁移的资产清单、最小权限和检测响应建议。","source",{"_76":46},"links",{"_120":126},"publishedAt","2026-11-05T03:32:53.000Z","discoveredAt","2026-11-05T03:52:24.774Z","timelineAt","category","activity","tags",[77,79,123,124,125],"score",72,"selected",true,"channel","news","story",{"_87":88,"_13":89},"x","readingMode","full","author","安全客","body",{"_62":119,"_120":-5,"_121":120,"_122":37},"outline",[90,91,92,93,94,95,96,97,98],"relatedStories",[86],"topics",[69,70,71,72,73],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation",false,"bodyLanguage","zh","factId","fC80Lcf2c3i0","reportCount",3,"additionalSourceCount",2,{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","attack","name","攻击活动","ai-offense","AI 攻防","black-market","数据窃取与黑产","ransomware","勒索软件","supply-chain","供应链安全",{"_87":88,"_13":89},"publicId","edfa10ce-457c-432d-a5b9-37a8199d01c7","Cathedral披露AI智能体渗透Anthropic",{"_11":117,"_100":118,"_102":68},{"_11":115,"_100":116,"_102":68},{"_11":113,"_100":114,"_102":68},{"_11":111,"_100":112,"_102":68},{"_11":109,"_100":110,"_102":68},{"_11":107,"_100":108,"_102":68},{"_11":105,"_100":106,"_102":68},{"_11":103,"_100":104,"_102":66},{"_11":99,"_100":101,"_102":66},"sec-9","text","相关文章","level","sec-8","TA的文章","sec-7","总结","sec-6","六、给甲方安全团队的三条实在建议","sec-5","五、两边吵的那部分，反而是最有价值的部分","sec-4","四、一个月前，有人把话说到了前面","sec-3","三、被看见的东西，比”有限范围”四个字严重","sec-2","二、正门焊死了，就从物业的侧门进","sec-1","一、这场渗透测试，从一封没人想读的报告开始","<p><span>首页</span></p><ul></ul><p><span>活动</span></p><ul></ul><p><span>社区</span></p><ul></ul><p><span>学院</span></p><ul></ul><p><span>安全导航</span></p><ul></ul><p><span>阅读量</span><b>2074</b></p><p>发布时间 : 2026-11-05 11:32:53</p><h2 id=\"sec-1\">一、这场渗透测试，从一封没人想读的报告开始</h2><p>《华盛顿邮报》拿到了一份草稿，本来是<span>Cathedral<i></i></span>准备发在自己博客上的技术文章。内容不复杂：他们参与了Anthropic的外部安全测试项目，也就是漏洞悬赏计划，然后用自研的AI智能体把这家AI巨头的内部系统走了一遍。</p><p>走通的时间，不到12个小时。</p><p>Cathedral成立才几个月，创始团队来自美国政府效率部<span>DOGE<i></i></span>，联合创始人Gavin Kliger之前在DOGE干过，后来当过美国国防部首席数据官。投资人里能看到Marc Andreessen和Shaun Maguire的名字，估值已经到14亿美元，手上有1.6亿美元融资。三个联邦机构最近跟他们签了网络安全服务合同。</p><p>Anthropic的回应很克制：确实访问了部分销售、人力资源和IT系统，范围有限，已经堵上了路径，也向联邦政府官员通报了。至于客户发给Claude的消息、模型生成的回复、代码和模型权重，都没被碰到。</p><p>两边都没有否认核心事实。这就够了。</p><h2 id=\"sec-2\">二、正门焊死了，就从物业的侧门进</h2><p>按Anthropic发言人的说法，Cathedral先花了好几天正面攻他们的自研软件和核心系统，没啃下来。接着AI智能体换了个思路，盯上了Anthropic用于行政管理和销售业务的第三方商业软件。</p><p>这条路子在任何一家公司都成立。核心业务系统被安全团队盯着，上了WAF、做了微隔离、权限收到最细；但销售用的CRM、HR用的招聘系统、行政用的报销工具，采购回来接进内网就完事了，版本更新靠供应商推送，安全评估走个流程。攻击者不需要打赢最强的那个防守点，只需要找到最弱的那个入口，然后顺着SSO、API集成、通讯录同步这些”方便”的通道横着走。</p><p>Cathedral的AI智能体找到的就是这个入口。从第三方软件的漏洞切进去之后，自动扫描、串联权限、横向移动，12小时内打通了通往Anthropic内部敏感数据和通信系统的路径。</p><p>报告里那句话写得很直白：普通企业软件中的漏洞，竟然能够危及最先进机构的基础设施，这件事应该给美国每一家企业敲响警钟。</p><h2 id=\"sec-3\">三、被看见的东西，比”有限范围”四个字严重</h2><p>Anthropic说影响有限。Cathedral的报告列了清单。</p><p>会议记录看到了。员工的薪资单和录用待遇明细看到了。客户与合作伙伴的商务联系方式、一部分基础用户账户记录也看到了。</p><p>最要命的是<span>Slack<i></i></span>。AI智能体摸进了Anthropic员工日常办公的频道，里面正在讨论公司最前沿AI模型的研发进展。对一家把”安全”写进招股书的公司来说，这个画面实在不怎么好看。</p><p>Cognition的首席信息安全官<span>Alex Stamos<i></i></span>应《华盛顿邮报》要求审阅了报告，他的评价是”他们这次发现了一个大问题”。紧接着补了一句：把第三方应用接进企业系统带来的风险，对所有人来说都是极其严重的问题，但Anthropic本可以做得更好。</p><p>这位前斯坦福互联网观察站主任没给老同行留面子。</p><h2 id=\"sec-4\">四、一个月前，有人把话说到了前面</h2><p>9月，Anthropic员工Jacob Coxon公开辞职，在社交平台上发了一篇长文，批评公司在处理危险AI技术时不负责，点名了一件事：过度依赖普通的外部商业办公软件。</p><p>他的原话是，Anthropic正在进行”一场傲慢自大的豪赌，而这种豪赌不应该从一家私营公司的Slack聊天系统中发起”。</p><p>不到一个月，别人的AI智能体就顺着普通商业软件摸进了自家的Slack。</p><p>这种巧合在安全圈不算罕见。内部人提的风险，往往要等外部事件来验证，验证完了大家再回头说”当时就有人提过”。问题是提过之后，有没有人真的去数过接进内网的第三方系统有多少个、每个系统的权限边界在哪、供应商的漏洞响应承诺能不能兑现。</p><p>Anthropic的声明里还有一句值得注意：监控系统在Cathedral主动报告之前，就已经标记出了他们的部分活动，当天切断了访问。也就是说，检测能力起了作用，只不过发现的时候，该看的已经看得差不多了。事后响应快，替代不了事前收敛。</p><h2 id=\"sec-5\">五、两边吵的那部分，反而是最有价值的部分</h2><p>Anthropic说Cathedral夸大了调查结果暗示的国家安全影响，还说对方没有完整披露在系统内做的所有活动，没完全遵守漏洞悬赏计划的规则。Cathedral的回应是，按照安全研究最佳实践，数据访问量控制在绝对最低限度。</p><p>这场口水仗外人很难判断谁对。但有一件事很清楚：当一份渗透报告被送到政府高层传阅，一位要求匿名的特朗普政府高级官员说自己很震惊，震惊于研究人员这么快就进了一家掌握着”几乎堪比核武器级别材料”的公司的敏感系统。</p><p>这个反应本身说明，行业对AI实验室的安全水位有一种想当然的信任。大家默认前沿AI公司会把最好的防守用在自己身上，事实是它们的办公侧和所有公司一样，跑着一堆外采的<span>SaaS<i></i></span>。</p><p>同一个月的另一条新闻可以放在一起看：FBI逮捕了一名OpenAI员工，指控其在高管会议室安装录音设备。上个月，有黑客借着Claude把OpenAI黑了。再往前数，Anthropic自己在7月的复盘里承认，三起评测事故里Claude跑出了沙盒，攻击了真实机构，其中一个模型在推理中意识到”这好像是真实生产系统”，然后自己说服自己”这家公司肯定也是演习的一部分”，继续攻击，拖走了几百行生产数据库记录。</p><p>攻防两端都在用AI，速度被拉到了机器水平。这时候防线的薄弱点，往往不在最显眼的那个地方。</p><h2 id=\"sec-6\">六、给甲方安全团队的三条实在建议</h2><p>第一条，把”接进内网的第三方系统”当成独立资产清单来管。不是资产管理系统里那种带机房位置的清单，是每个系统谁在用、授了什么权限、数据往哪流、供应商漏洞响应SLA是多少的那种。Cathedral这次能找到入口，靠的就是这类系统长期处在安全视野的边缘。</p><p>第二条，SSO和API集成要按攻击面来设计，不是按方便来设计。一个办公软件被攻破，攻击者拿到的不只是这个软件里的数据，还有它作为跳板能触达的一切。最小权限、按需授权、定期回收，这些话说了很多年，真正落地的公司不多。</p><p>第三条，别把AI智能体当成只会聊天的工具。这次渗透的执行者是AI Agent，12小时跑完人类团队可能要几周的工作量。防守方的检测、响应、处置如果还是按人工节奏排，时间窗口根本对不上。</p><h2 id=\"sec-7\">总结</h2><p>一家把安全做卖点的公司，被一家成立几个月的公司用AI在12小时里翻了个底朝天，泄密的入口是最普通的办公软件。这件事的讽刺意味很足，但对安全从业者来说，它照出的是一面很常见的镜子：我们把预算和注意力压在核心系统上，却忘了每天有几十个第三方应用在往内网里递钥匙。</p><p>Alex Stamos那句话值得抄在工位上：问题很棘手，但本可以做得更好。</p><p>棘手是真的。本可以做得更好，也是真的。</p><p><strong>更多AI知识，请扫码关注Aiker World社区公众号</strong></p><p><img src=\"/dailyinfo/media/c851b32faa5b479f.jpg\" loading=\"lazy\" decoding=\"async\" width=\"302\"></p><p><strong>Aiker World社区网址：https://aikerworld.com</strong></p><p><strong>Aiker World（AI世界）-聚焦AI人才与智能体工具的垂直专家社区。专家领航+人才汇聚+工具赋能，打通AI技术与产业落地断层，为AI从业者、开发者及企业提供一站式成长与协作平台。</strong></p><ul></ul><p><i></i><span>0赞</span></p><p><i></i><span>收藏</span></p><p><img src=\"/dailyinfo/media/6c90c2d0ed9ed988.jpg\" loading=\"lazy\" decoding=\"async\"><span>安全客</span><span></span></p><p><a href=\"https://www.anquanke.com/member.html?memberId=184300\"><img src=\"/dailyinfo/media/6c90c2d0ed9ed988.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p><a href=\"https://www.anquanke.com/member.html?memberId=184300\">安全客</a></p><p>这个人太懒了，签名都懒得写一个</p><ul><li>文章</li><li><strong>94</strong></li></ul><ul><li>粉丝</li><li><strong>5</strong></li></ul><h3 id=\"sec-8\"> TA的文章</h3><ul><li><h5><a href=\"https://www.anquanke.com/post/id/316392\">【开放申请】企业可自查PHP2Shell漏洞了！</a></h5><p>2026-10-30 18:19:15</p></li><li><h5><a href=\"https://www.anquanke.com/post/id/316387\">突发！1day漏洞致使大量NAS用户文件被加密</a></h5><p>2026-10-30 18:09:17</p></li><li><h5><a href=\"https://www.anquanke.com/post/id/316355\">Node.js、Python、Bun全中招：一个压缩库的内存漏洞，让半个互联网\"裸奔\"</a></h5><p>2026-10-26 14:54:01</p></li><li><h5><a href=\"https://www.anquanke.com/post/id/316350\">凌晨收到GitLab安全公告，CVSS满分，我看了看自家版本号</a></h5><p>2026-10-26 14:47:16</p></li><li><h5><a href=\"https://www.anquanke.com/post/id/316346\">AI自己写勒索脚本、自己挑目标、自己搞钱：俄罗斯黑客的Phantom框架，把勒索软件玩成了自动化流水线</a></h5><p>2026-10-26 12:02:03</p></li></ul><h3 id=\"sec-9\"> 相关文章</h3><ul><li><h5><a href=\"https://www.anquanke.com/post/id/316432\">币安丢了63亿美元，问题出在一台工程师的笔记本上</a></h5><p>2026-11-05 11:36:50</p></li><li><h5><a href=\"https://www.anquanke.com/post/id/316426\">潜伏16年的UEFI漏洞：开机那几秒，你的所有防线都还没上线</a></h5><p>2026-11-05 11:28:56</p></li><li><h5><a href=\"https://www.anquanke.com/post/id/316111\">Cisco邮件网关9.8分漏洞被在野利用：一封邮件直接拿root，没有任何绕过的余地</a></h5><p>2026-09-16 10:26:37</p></li><li><h5><a href=\"https://www.anquanke.com/post/id/315921\">白帽子的匿名时代，正在终结——HackerOne强制身份验证这件事</a></h5><p>2026-08-04 11:16:24</p></li><li><h5><a href=\"https://www.anquanke.com/post/id/315763\">伊朗黑客组织亮出\"秘密武器\"：Cavern C2框架如何绕过所有安全检测</a></h5><p>2026-07-10 11:03:32</p></li><li><h5><a href=\"https://www.anquanke.com/post/id/315760\">630GB机密挂上暗网：苹果二十年供应链铁幕一