[{"_1":2,"_3":4},"root",{"_5":101},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794444100000,"id","w59rywovcc1gwb1eoreru2xl3","title","攻击者利用 AntiFox AI Agent 窃取 AWS 凭据并入侵 Web 服务","originalTitle","Hackers use AntiFox AI agents in AWS credential-theft attacks","summary","攻击者在 Alibaba Cloud 上托管自建 AntiFox 实例，利用有效 IAM 用户和 EC2 角色针对 AWS 环境及互联网暴露的 Web 服务实施漏洞利用、Webshell 部署、凭据验证、配置发现与 AWS secret 收集。","reason","该事件展示了攻击者如何把自主渗透测试 Agent 改造为凭据窃取工具，可为评估云环境中的 AI 辅助攻击提供具体案例。","source",{"_74":100},"links",{"_92":99},"publishedAt","2026-11-11T15:12:59.000Z","discoveredAt","2026-11-11T15:22:36.014Z","timelineAt","category","activity","tags",[77,79,75,96,97,98],"score",77,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Bill Toulas","body",{"_61":91,"_92":-5,"_93":94,"_95":37},"outline",[86],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fTcU_gkFotDA","reportCount",2,"additionalSourceCount",1,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","malware","name","恶意软件","attack","攻击活动","ai-offense","AI 攻防","identity","身份与访问",{"_83":84,"_13":85},"publicId","11e41670-5fab-4a1b-8387-0504c38b78c3","AntiFox被用于入侵AWS及IIS环境",{"_11":87,"_88":89,"_90":65},"sec-1","text","发现现有防御可能遗漏的电子邮件威胁。","level","<p><img alt=\"Hackers use AntiFox AI agents in AWS credential-theft attacks\" height=\"900\" src=\"/dailyinfo/media/5779c1d8ffe55bd4.jpg\" srcset=\"/dailyinfo/media/25c3ccad0d15c800.jpg 720w, /dailyinfo/media/29fabe72752171bd.jpg 1200w, /dailyinfo/media/5779c1d8ffe55bd4.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>攻击者正使用 Alibaba Cloud 托管自行管理的 AntiFox 实例。AntiFox 是一个开源的智能体式渗透测试平台，被用于攻击 Web 服务和 AWS 环境。</p><p>托管 AntiFox 的基础设施被用于各种恶意活动，包括漏洞利用、WebShell 部署、凭据验证、配置发现以及 AWS 密钥收集。</p><p>最初作为 ARTEX 0.1.1 的分叉创建，<a href=\"https://github.com/AntiFox-AI/antifox/blob/main/README.en.md\">AntiFox</a> 拥有中文界面，可让用户部署 AI 智能体并自动执行常见的渗透测试任务，例如绘制暴露服务以及探测目标端点是否存在漏洞。</p><p><a href=\"https://www.wiz.io/lp/ai-security-starter-pack?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Security-Starter-Kit&amp;sfcid=701Vh00000cn7aRIAQ&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AI-Security-Bundle\"><img src=\"/dailyinfo/media/d3a3a8c45adb5cdd.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>Arctic Wolf 的安全研究人员观察到，与 AntiFox 相关的恶意基础设施托管在 Alibaba Cloud 上，并使用有效的 AWS 身份（包括 IAM 用户，在某些情况下还包括被扮演的 EC2 角色）向 Amazon Web Services API 发起经过身份验证的请求。</p><p>“在最近观察到的多起入侵事件中，托管 AntiFox 接口的 Alibaba Cloud 系统与针对面向互联网的 Web 服务及相关 AWS 环境的已确认恶意行为有关，”<a href=\"https://github.com/rtkwlf/wolf-tools/tree/main/pack_alerts/202611-antifox-alibaba-hosted-platforms-facilitate-web-cloud-intrusions\">Arctic Wolf 表示</a>。</p><p>报告中重点介绍的一个案例涉及在暴露于互联网的 IIS 服务器上部署 ASPX WebShell、执行操作系统命令、访问应用程序设置和数据库连接字符串，以及将配置和日志文件复制到可通过 Web 访问的目录。</p><p>研究人员称，攻击者还使用有效的 IAM 凭据和 EC2 角色探测 Amazon Web Services（AWS）端点。在一次入侵中，他们循环使用多个身份，并在约 30 分钟内发出了数百次 API 请求。</p><p>尽管其中大多数尝试均被阻止，但攻击者在某些情况下成功获取了生产环境密钥。</p><p>在另一起事件中，攻击者使用有效的 AWS 身份读取、复制并删除了 S3 对象。</p><p>Arctic Wolf 的报告包含威胁狩猎指南和防御建议，包括将 IIS WebShell 活动与异常 AWS 访问行为进行关联分析，并审查集中爆发的拒绝访问中成功的 API 调用。</p><p>研究人员还建议撤销受影响的 AWS 会话和密钥，并轮换通过应用程序文件暴露的凭据。</p><p>关于 AntiFox 的发现紧随近期涉及 ARTEX AI 的攻击事件。ARTEX AI 是中国开发的另一个<a href=\"https://www.bleepingcomputer.com/news/security/former-pentester-used-artex-ai-to-steal-82-million-data-records/\">智能体式渗透测试框架</a>，在被用于<a href=\"https://www.bleepingcomputer.com/news/security/hacker-used-artex-ai-and-claude-agents-to-target-south-korean-banks/\">针对韩国银行的攻击</a>后转为闭源。</p><p>CrowdStrike 还将 ARTEX 与一场网络间谍活动联系起来。在该活动中，中国黑客组织<a href=\"https://www.bleepingcomputer.com/news/security/chinese-hackers-use-artex-ai-in-automated-attacks-against-200-orgs/\">Vapor Panda</a>以 14 个国家/地区的 200 多个组织为目标。</p><p>目前，AntiFox 仍可在 GitHub 上获取，并已更新至 2.0 版本，改进了该工具记录和报告发现结果的方式。</p><p>其发布者禁止将该工具用于实时系统、真实世界渗透测试或安全演练，也禁止将其用于破坏性或非法活动，但他们没有描述任何用于强制执行这些限制的技术控制措施。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/0c6c2476908e136e.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体会分析电子邮件的意图、上下文和行为，以发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>查看哪些威胁正在绕过防御：对 Microsoft 365 或 Google Workspace 进行为期 14 天的只读扫描，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始免费的电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","凭据","AWS","阿里","https://www.bleepingcomputer.com/news/security/hackers-use-antifox-ai-agents-in-aws-credential-theft-attacks/","BleepingComputer",{"_102":103,"_104":-5},"changelogVersion","2026-10-01T08:00","release"]
