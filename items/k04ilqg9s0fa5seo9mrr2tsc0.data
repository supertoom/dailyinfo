[{"_1":2,"_3":4},"root",{"_5":105},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":-5,"_56":37,"_57":58},"expiresAt",1795048832000,"id","k04ilqg9s0fa5seo9mrr2tsc0","title","F5 披露 NGINX 远程代码执行漏洞 CVE-2026-123633 与 CVE-2026-123007","originalTitle","Multiples vulnérabilités dans F5 NGINX (18 novembre 2026)","summary","F5 于 18 novembre 2026 披露 CVE-2026-123633 与 CVE-2026-123007，未认证攻击者可利用 HTTP/2 在 NGINX Open Source 和 NGINX Plus 上远程执行代码。","reason","通告列明两项漏洞的受影响版本、未认证远程代码执行条件及公开 PoC 情况，并提供关闭 HTTP/2 的临时缓解配置。","source",{"_61":104},"links",{"_94":103},"publishedAt","2026-11-18T00:00:00.000Z","discoveredAt","2026-11-18T18:47:33.562Z","timelineAt","category","vuln","tags",[98,99,100,101,102],"score",81,"selected",true,"channel","news","story","x","readingMode","full","author","body",{"_58":93,"_94":-5,"_95":96,"_97":37},"outline",[63,64,65,66,67,68,69,70,71],"relatedStories",[],"topics",[59],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_60":31,"_61":62},"slug","name","漏洞披露",{"_11":91,"_73":92,"_75":76},{"_11":89,"_73":90,"_75":76},{"_11":87,"_73":88,"_75":76},{"_11":85,"_73":86,"_75":76},{"_11":83,"_73":84,"_75":76},{"_11":81,"_73":82,"_75":76},{"_11":79,"_73":80,"_75":76},{"_11":77,"_73":78,"_75":76},{"_11":72,"_73":74,"_75":76},"sec-9","text","详细文档管理","level",2,"sec-8","文档","sec-7","解决方案","sec-6","临时缓解措施","sec-5","摘要","sec-4","受影响系统","sec-3","风险","sec-2","文档管理","sec-1","CERT-FR 警报公告","<h2 id=\"sec-1\">CERT-FR 警报公告</h2><p>主题：F5 NGINX 中的多个漏洞</p><h2 id=\"sec-2\">文档管理</h2><table>\n      <tbody>\n        <tr>\n          <th>参考编号</th>\n          <td>CERTFR-2026-ALE-017</td>\n        </tr>\n        <tr>\n          <th>标题</th>\n          <td>F5 NGINX 中的多个漏洞</td>\n        </tr><tr>\n            <th>首个版本日期</th><td>2026 年 11 月 18 日</td>\n          </tr>\n          <tr>\n            <th>最新版本日期</th><td>2026 年 11 月 18 日</td>\n          </tr><tr>\n          <th>来源</th>\n          <td>F5 安全公告 K000163926，2026 年 11 月 18 日<br>F5 安全公告 K000163928，2026 年 11 月 18 日<br></td>\n        </tr>\n      </tbody>\n    </table><p>详细的版本管理信息位于本文档末尾。</p><h2 id=\"sec-3\">风险</h2><ul>\n          \n            <li>远程任意代码执行</li>\n          \n        </ul><h2 id=\"sec-4\">受影响系统</h2><ul>\n          \n            <li>NGINX Open Source versions 1.31.x antérieures à 1.31.9</li>\n          \n            <li>NGINX Open Source versions antérieures à 1.30.7</li>\n          \n            <li>NGINX Plus versions 3.1.x à 3.2.x antérieures à 3.7.3.0.1</li>\n          \n            <li>NGINX Plus versions 3.7.x antérieures à 37.0.8.1</li>\n          \n        </ul><h2 id=\"sec-5\">摘要</h2><p>2026 年 11 月 18 日，F5 发布了关于 CVE-2026-123633 和 CVE-2026-123007 漏洞的两份安全公告。这些漏洞影响 NGINX Open Source 和 NGINX Plus，未经验证的攻击者可利用 HTTP/2 协议远程执行代码。</p><p>CERT-FR 已知晓 CVE-2026-123007 漏洞的公开概念验证。</p><h2 id=\"sec-6\">临时缓解措施</h2><p>在等待应用安全补丁期间，CERT-FR 建议禁用 HTTP/2。</p><p>如需禁用 HTTP/2，nginx2root 博客文章 [1] 提供了以下指令：</p><ul>\n<li>适用于 NGINX versions 1.25.0 及更早版本：</li>\n</ul><pre>listen 443 ssl;\nhttp2 off;\n</pre><ul>\n<li>适用于 NGINX versions 1.25.1 及更高版本：</li>\n</ul><pre>listen 443 ssl;\n</pre><p>可执行以下命令来测试并重新加载 NGINX 配置：</p><pre>sudo nginx -t &amp;&amp; sudo nginx -s reload\nopenssl s_client -connect HOST:443 -servername HOST -alpn h2 &amp;1 | grep -F 'ALPN protocol: h2'\n</pre><h2 id=\"sec-7\">解决方案</h2><p>有关补丁获取方式，请参阅厂商的安全公告（参见“文档”部分）。</p><h2 id=\"sec-8\">文档</h2><ul>\n          \n          \n            <li>\n              <p>F5 安全公告 K000163926，2026 年 11 月 18 日</p>\n              <a href=\"https://my.f5.com/manage/s/article/K000163926\">https://my.f5.com/manage/s/article/K000163926</a>\n            </li>\n          \n            <li>\n              <p>F5 安全公告 K000163928，2026 年 11 月 18 日</p>\n              <a href=\"https://my.f5.com/manage/s/article/K000163928\">https://my.f5.com/manage/s/article/K000163928</a>\n            </li>\n          \n\n          \n          \n            <li>\n              <p>[1] nginx2root</p>\n              <a href=\"https://nginx2root.com/\">https://nginx2root.com/</a>\n            </li>\n          \n            <li>\n              <p>CERT-FR 公告 CERTFR-2026-AVI-1567，2026 年 11 月 18 日</p>\n              <a href=\"https://www.cert.cyber.gouv.fr/avis/CERTFR-2026-AVI-1567/\">/avis/CERTFR-2026-AVI-1567/</a>\n            </li>\n          \n            <li>\n              <p>Wiz 博客文章</p>\n              <a href=\"https://www.wiz.io/blog/nginx-http2-rce-vulnerabilities\">https://www.wiz.io/blog/nginx-http2-rce-vulnerabilities</a>\n            </li>\n          \n\n          \n            <li>\n              <p>CVE 参考编号 CVE-2026-123007</p>\n              <a href=\"https://www.cve.org/CVERecord?id=CVE-2026-123007\">https://www.cve.org/CVERecord?id=CVE-2026-123007</a>\n            </li>\n          \n            <li>\n              <p>CVE 参考编号 CVE-2026-123633</p>\n              <a href=\"https://www.cve.org/CVERecord?id=CVE-2026-123633\">https://www.cve.org/CVERecord?id=CVE-2026-123633</a>\n            </li>\n          \n        </ul><h2 id=\"sec-9\">详细文档管理</h2><table>\n          <thead>\n            <tr>\n              <th>日期</th>\n              <th>说明</th>\n            </tr>\n          </thead>\n          <tbody><tr>\n              <td>2026 年 11 月 18 日</td>\n              <td>初始版本</td>\n            </tr></tbody>\n        </table>","original","zhKind","translation","complete","漏洞","补丁","复现","漏洞利用","网络设备","https://www.cert.cyber.gouv.fr/alerte/CERTFR-2026-ALE-017/","CERT-FR",{"_106":107,"_108":-5},"changelogVersion","2026-10-01T08:00","release"]
