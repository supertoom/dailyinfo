[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1795740042000,"id","ngkl7c9338q0otr0cnvz3xbij","title","CERT-FR 通告 GitLab 多个漏洞，涉及 RCE、远程拒绝服务与数据机密性受损","originalTitle","Multiples vulnérabilités dans GitLab (26 novembre 2026)","summary","CERT-FR 于 2026 年 11 月 26 日发布通告，称在 GitLab 中发现多个漏洞，部分可导致远程任意代码执行、远程拒绝服务以及数据机密性受损。通告未列出具体 CVE 编号、受影响版本与评分，仅指明修复方式为参考厂商安全公告获取补丁。","reason","source",{"_62":82},"links",{"_58":81},"publishedAt","2026-11-26T00:00:00.000Z","discoveredAt","2026-11-26T15:34:20.781Z","timelineAt","category","vuln","tags",[79,80,65],"score",46,"selected",false,"channel","news","story","x","readingMode","full","author","body",{"_75":-5,"_58":76,"_77":-5,"_78":36},"outline",[66,67],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":64,"_62":65},{"_61":30,"_62":63},"slug","name","漏洞披露","vuln-mgmt","漏洞管理",{"_11":73,"_69":74,"_71":72},{"_11":68,"_69":70,"_71":72},"sec-2","text","Solutions","level",2,"sec-1","Résumé","zh","<h2 id=\"sec-1\">Résumé</h2><p>De multiples vulnérabilités ont été découvertes dans GitLab. Certaines d'entre elles permettent à un attaquant de provoquer une exécution de code arbitraire à distance, un déni de service à distance et une atteinte à la confidentialité des données.</p><h2 id=\"sec-2\">Solutions</h2><p>Se référer au bulletin de sécurité de l'éditeur pour l'obtention des correctifs (cf. section Documentation).</p>","zhKind","complete","漏洞","补丁","https://www.cert.cyber.gouv.fr/avis/CERTFR-2026-AVI-1624/","CERT-FR",{"_84":85,"_86":-5},"changelogVersion","2026-10-01T08:00","release"]
