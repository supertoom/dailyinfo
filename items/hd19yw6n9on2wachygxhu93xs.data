[{"_1":2,"_3":4},"root",{"_5":115},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795394433000,"id","hd19yw6n9on2wachygxhu93xs","title","VMware vCenter 认证绕过漏洞 CVE-2026-123890 已被 ARMORY CASTLE 利用","originalTitle","CVE-2026-123890: Critical Authentication Bypass in VMware vCenter","summary","VMware vCenter 的认证绕过漏洞 CVE-2026-123890 已被中国关联威胁组织 ARMORY CASTLE 在野利用，最早可追溯至 2026 年 9 月。","reason","材料同时给出真实利用证据、无需凭据的利用条件、应急补丁版本及升级限制，有助于评估暴露风险并安排处置。","source",{"_74":114},"links",{"_105":113},"publishedAt","2026-11-19T21:06:24.000Z","discoveredAt","2026-11-19T22:11:22.338Z","timelineAt","category","vuln","tags",[109,75,110,78,111,112],"score",93,"selected",true,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","Rapid7","body",{"_61":104,"_105":-5,"_106":107,"_108":37},"outline",[85,86,87,88,89],"relatedStories",[81],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fJ4dDx5j8puY","reportCount",7,"additionalSourceCount",6,{"_72":79,"_74":80},{"_72":77,"_74":78},{"_72":31,"_74":76},{"_72":73,"_74":75},"slug","exploited","name","在野利用","漏洞披露","identity","身份与访问","vmware","VMware / Broadcom",{"_82":83,"_13":84},"publicId","25bfc85d-d33c-4d9e-8852-0430fda6b8b0","Armory Castle利用vCenter认证绕过漏洞",{"_11":102,"_91":103,"_93":94},{"_11":100,"_91":101,"_93":94},{"_11":98,"_91":99,"_93":94},{"_11":95,"_91":96,"_93":97},{"_11":90,"_91":92,"_93":94},"sec-5","text","更新","level",2,"sec-4","Exposure Command、Vulnerability Management 和 Nexpose",3,"sec-3","Rapid7 客户","sec-2","缓解措施指南","sec-1","概述","<h2 id=\"sec-1\">概述</h2><p><span>2026 年 11 月 19 日，Broadcom </span><a href=\"https://support.broadcom.com/web/ecx/support-content-notification/-/external/content/SecurityAdvisories/0/39495\"><span>发布了 VMware 安全公告 VMSA-2026-0009</span></a><span>，其中处理了 VMware 产品中的五个漏洞。其中最严重的漏洞 </span><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-123890\"><span>CVE-2026-123890</span></a><span> 是 vCenter 的 VMware Directory Service 组件中利用备用路径或通道进行身份验证绕过的问题（</span><a href=\"https://cwe.mitre.org/data/definitions/288.html\"><span>CWE-288</span></a><span>）。Broadcom 为该漏洞评定的 CVSSv3 严重性评分为 </span><a href=\"https://www.first.org/cvss/calculator/3.1#CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H\"><span>9.8</span></a><span>。</span></p><p><span>能够通过网络访问受影响 vCenter 部署的攻击者可能在无需凭据的情况下利用 CVE-2026-123890 绕过身份验证，并以 Administrator 用户身份未经授权访问系统。Mandiant 私下向 Broadcom 报告了该问题。&nbsp;此外，&nbsp;</span><a href=\"https://cloud.google.com/blog/topics/threat-intelligence/armory-castle-exploits-vsphere\"><span>Mandiant/Google Threat Intelligence</span></a><span> 证实，关联中国国家的威胁行为者 ARMORY CASTLE 早在 2026 年 9 月就已对 CVE-2026-123890 进行了实际利用。</span></p><p><span>CVE-2026-123890 与 Broadcom 于 2026 年早些时候处理的 vCenter 身份验证绕过漏洞 CVE-2026-59309 不同。</span><a href=\"https://github.com/vmware/vcf-security-and-compliance-guidelines/blob/main/security-advisories/vmsa-2026-0009/README.md\"><span>供应商 FAQ</span></a><span>指出，所有低于 VMSA-2026-0009 所修复版本的 vCenter 系统都需要安装新更新，包括已经安装过此前修复程序的系统。Broadcom 将此次 vCenter 更新定性为需要立即采取行动的紧急变更。</span></p><h2 id=\"sec-2\">缓解措施指南</h2><p><span>供应商已提供 CVE-2026-123890 的更新。Broadcom 未列出任何临时缓解措施，且无法使用 vCenter Quick Patch 安装这些补丁。组织应优先在正常补丁周期之外，以紧急方式升级 vCenter，并根据其部署环境采用标准更新机制。</span></p><table><thead><tr><th><p><span><strong>VMware 产品</strong></span></p></th><th><p><span><strong>受影响版本</strong></span></p></th><th><p><span><strong>修复版本 / 补丁</strong></span></p></th></tr></thead><tbody><tr><td><p><span>VMware Cloud Foundation / vSphere Foundation</span></p></td><td><p><span>9.1.x.x</span></p></td><td><p><a href=\"https://techdocs.broadcom.com/bin/gethidpage?appid=vcf-9-1&amp;format=rendered&amp;language=en&amp;ux-context-string=vcenter-9-1-1-2\"><span>9.1.1.0200</span></a></p></td></tr><tr><td><p><span>VMware Cloud Foundation / vSphere Foundation</span></p></td><td><p><span>9.0.x.x</span></p></td><td><p><a href=\"https://techdocs.broadcom.com/bin/gethidpage?appid=vcf-9-0&amp;format=rendered&amp;language=en&amp;ux-context-string=vcenter-9-0-2-0-2\"><span>9.0.2.0200</span></a></p></td></tr><tr><td><p><span>VMware vCenter Server</span></p></td><td><p><span>8.0</span></p></td><td><p><a href=\"https://techdocs.broadcom.com/us/en/vmware-cis/vsphere/vsphere/8-0/release-notes/vcenter-server-update-and-patch-release-notes/vsphere-vcenter-server-80u3m-release-notes.html\"><span>8.0 U3m</span></a></p></td></tr><tr><td><p><span>VMware vCenter Server</span></p></td><td><p><span>7.0</span></p></td><td><p><span>联系 Broadcom Support（扩展支持客户）</span></p></td></tr><tr><td><p><span>VMware Cloud Foundation</span></p></td><td><p><span>5.x</span></p></td><td><p><a href=\"https://techdocs.broadcom.com/us/en/vmware-cis/vcf/vcf-5-2-and-earlier/5-2/vcf-release-notes/vmware-cloud-foundation-525-release-notes.html\"><span>5.2.5</span></a></p></td></tr><tr><td><p><span>VMware Telco Cloud Platform</span></p></td><td><p><span>3.0, 4.x, 5.0.x, 5.1.x, 5.2</span></p></td><td><p><a href=\"https://knowledge.broadcom.com/external/article/463116\"><span>8.0 U3m — KB463116</span></a></p></td></tr><tr><td><p><span>VMware Telco Cloud Infrastructure</span></p></td><td><p><span>3.0</span></p></td><td><p><a href=\"https://knowledge.broadcom.com/external/article/463116\"><span>8.0 U3m — KB463116</span></a></p></td></tr></tbody></table><p><span>这些修复是累积性的。vCenter </span><span>8.0 U3m</span><span> 和 </span><span>9.0.2.0200</span><span> 更新引入了“回溯时间”限制，阻止升级至 VMware Cloud Foundation </span><span>9.1.1</span><span>；Broadcom 建议正在进行升级的客户查看供应商 FAQ 和互操作性矩阵。更新 vCenter 会暂时导致其管理接口不可用，但 Broadcom 表示，运行中的虚拟机和容器工作负载会继续运行。</span></p><p><span>有关最新受影响版本和缓解措施指南，请参阅 </span><a href=\"https://support.broadcom.com/web/ecx/support-content-notification/-/external/content/SecurityAdvisories/0/39495\"><span>Broadcom 的安全公告</span></a><span> 和 </span><a href=\"https://github.com/vmware/vcf-security-and-compliance-guidelines/blob/main/security-advisories/vmsa-2026-0009/README.md\"><span>补充 FAQ</span></a><span>。</span></p><h2 id=\"sec-3\">Rapid7 客户</h2><h3 id=\"sec-4\"><span>Exposure Command、Vulnerability Management 和 Nexpose</span></h3><p><span>Exposure Command、InsightVM 和 Nexpose 客户可评估 VMware vCenter Server 遭受 CVE-2026-123890 攻击的暴露情况；一项无需身份验证的漏洞检查预计将在 2026 年 11 月 20 日的内容发布中提供。</span></p><h2 id=\"sec-5\">更新</h2><ul><li><p><span><strong>2026 年 11 月 19 日</strong></span><span>：首次发布。</span></p></li></ul>","original","zhKind","translation","complete","漏洞","补丁","VMware","Google","https://www.rapid7.com/blog/post/etr-cve-2026-123890-critical-authentication-bypass-vmware-vcenter","Rapid7 CVE 公告",{"_116":117,"_118":-5},"changelogVersion","2026-10-01T08:00","release"]
