[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794530490000,"id","qrllnfs5bawb685pvun41i9nh","title","Hono mount() 路径转发缺陷可绕过挂载前缀内的中间件","originalTitle","Hono: `mount()` and `app.mount()` can forward a path that bypasses middleware scoped inside the mount prefix","summary","Hono 的 mount() 与 app.mount() 存在路径转发缺陷，构造请求可绕过外层应用对挂载前缀内子路径配置的认证或授权中间件。动态前缀会按路由模式长度而非实际匹配长度截断路径，自 4.12.21 起还可能因路径重新规范化而将反斜杠转为斜杠并折叠 ..。","reason","source",{"_70":82},"links",{"_59":81},"publishedAt","2026-11-12T23:24:11.000Z","discoveredAt","2026-11-12T23:39:24.408Z","timelineAt","category","vuln","tags",[77,78,79,80],"score",66,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fBoGyfGeh4wQ","reportCount",1,"additionalSourceCount",0,{"_68":30,"_70":72},{"_68":69,"_70":71},"slug","research","name","技术研究","漏洞披露",{"_74":75,"_13":76},"publicId","0dbf38eb-e129-4a01-8e70-22a17a6c2670","Hono挂载路径绕过中间件漏洞","漏洞","漏洞分析","复现","补丁","https://github.com/advisories/GHSA-4m76-xfj5-7975","GitHub 安全公告",{"_84":85,"_86":-5},"changelogVersion","2026-10-01T08:00","release"]
