[{"_1":2,"_3":4},"root",{"_5":99},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1793667632000,"id","x2rguffbuu1wt81uut9t688rx","title","Synology 多款产品存在远程代码执行漏洞，CERT-FR 发布修复通告","originalTitle","Multiples vulnérabilités dans les produits Synology (02 novembre 2026)","summary","CERT-FR 披露 Synology Mail Station、PHP 与 Synology Calendar 存在可导致远程代码执行的多项漏洞，涉及 CVE-2026-109618 和 CVE-2026-109619。","reason","source",{"_61":98},"links",{"_58":97},"publishedAt","2026-11-02T00:00:00.000Z","discoveredAt","2026-11-02T15:43:33.942Z","timelineAt","category","vuln","tags",[94,95,96],"score",65,"selected",false,"channel","news","story","x","readingMode","full","author","body",{"_90":-5,"_58":91,"_92":-5,"_93":36},"outline",[63,64,65,66,67,68,69,70],"relatedStories",[],"topics",[59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":30,"_61":62},"slug","name","漏洞披露",{"_11":88,"_72":89,"_74":75},{"_11":86,"_72":87,"_74":75},{"_11":84,"_72":85,"_74":75},{"_11":82,"_72":83,"_74":75},{"_11":80,"_72":81,"_74":75},{"_11":78,"_72":79,"_74":75},{"_11":76,"_72":77,"_74":75},{"_11":71,"_72":73,"_74":75},"sec-8","text","Gestion détaillée du document","level",2,"sec-7","Documentation","sec-6","Solutions","sec-5","Résumé","sec-4","Systèmes affectés","sec-3","Risque","sec-2","Gestion du document","sec-1","Avis du CERT-FR","zh","<h2 id=\"sec-1\">Avis du CERT-FR</h2><p>Objet : Multiples vulnérabilités dans les produits Synology</p><h2 id=\"sec-2\">Gestion du document</h2><table>\n      <tbody>\n        <tr>\n          <th>Référence</th>\n          <td>CERTFR-2026-AVI-1435</td>\n        </tr>\n        <tr>\n          <th>Titre</th>\n          <td>Multiples vulnérabilités dans les produits Synology</td>\n        </tr><tr>\n            <th>Date de la première version</th><td>02 novembre 2026</td>\n          </tr>\n          <tr>\n            <th>Date de la dernière version</th><td>02 novembre 2026</td>\n          </tr><tr>\n          <th>Source(s)</th>\n          <td>Bulletin de sécurité Synology Synology_SA_26_14 du 31 octobre 2026<br></td>\n        </tr>\n      </tbody>\n    </table><p>Une gestion de version détaillée se trouve à la fin de ce document.</p><h2 id=\"sec-3\">Risque</h2><ul>\n          \n            <li>Exécution de code arbitraire à distance</li>\n          \n        </ul><h2 id=\"sec-4\">Systèmes affectés</h2><ul>\n          \n            <li>Mail Station versions antérieures à 30000002.3.19-0333 (DSM 6.2)</li>\n          \n            <li>Mail Station versions antérieures à 30000002.3.19-10333 (DSM 7.0 ou 7.1)</li>\n          \n            <li>Mail Station versions antérieures à 30000002.3.19-20333 (DSM 7.2)</li>\n          \n            <li>PHP versions 7.4.x antérieures à 7.4.33-0010 (DSM 6.2)</li>\n          \n            <li>PHP versions 7.4.x antérieures à 7.4.33-0122 (DSM 7.0 ou 7.1)</li>\n          \n            <li>PHP versions 7.4.x antérieures à 7.4.33-0131 (DSM 7.2)</li>\n          \n            <li>PHP versions 8.0.x antérieures à 8.0.30-0104 (DSM 7.0 ou 7.1)</li>\n          \n            <li>PHP versions 8.0.x antérieures à 8.0.30-0122 (DSM 7.2)</li>\n          \n            <li>PHP versions 8.1.x antérieures à 8.1.34-0120</li>\n          \n            <li>PHP versions 8.2.x antérieures à 8.2.35-0171</li>\n          \n            <li>PHP versions 8.3.x antérieures à 8.3.36-0051</li>\n          \n            <li>PHP versions 8.4.x antérieures à 8.4.27-0051</li>\n          \n            <li>Synology Calendar versions antérieures à 2.4.8-0948 (DSM 6.2)</li>\n          \n            <li>Synology Calendar versions antérieures à 2.4.8-10948 (DSM 7.0 ou 7.1)</li>\n          \n            <li>Synology Calendar versions antérieures à 3.0.4-21435 (DSM 7.2)</li>\n          \n        </ul><h2 id=\"sec-5\">Résumé</h2><p>De multiples vulnérabilités ont été découvertes dans les produits Synology. Elles permettent à un attaquant de provoquer une exécution de code arbitraire à distance.</p><h2 id=\"sec-6\">Solutions</h2><p>Se référer au bulletin de sécurité de l'éditeur pour l'obtention des correctifs (cf. section Documentation).</p><h2 id=\"sec-7\">Documentation</h2><ul>\n          \n          \n            <li>\n              <p>Bulletin de sécurité Synology Synology_SA_26_14 du 31 octobre 2026</p>\n              <a href=\"https://www.synology.com/en-global/security/advisory/Synology_SA_26_14\">https://www.synology.com/en-global/security/advisory/Synology_SA_26_14</a>\n            </li>\n          \n\n          \n          \n            <li>\n              <p>Alerte CERT-FR CERTFR-2026-ALE-014 du 21 octobre 2026</p>\n              <a href=\"https://www.cert.cyber.gouv.fr/alerte/CERTFR-2026-ALE-014/\">/alerte/CERTFR-2026-ALE-014/</a>\n            </li>\n          \n\n          \n            <li>\n              <p>Référence CVE CVE-2026-109618</p>\n              <a href=\"https://www.cve.org/CVERecord?id=CVE-2026-109618\">https://www.cve.org/CVERecord?id=CVE-2026-109618</a>\n            </li>\n          \n            <li>\n              <p>Référence CVE CVE-2026-109619</p>\n              <a href=\"https://www.cve.org/CVERecord?id=CVE-2026-109619\">https://www.cve.org/CVERecord?id=CVE-2026-109619</a>\n            </li>\n          \n        </ul><h2 id=\"sec-8\">Gestion détaillée du document</h2><table>\n          <thead>\n            <tr>\n              <th>Date</th>\n              <th>Description</th>\n            </tr>\n          </thead>\n          <tbody><tr>\n              <td>02 novembre 2026</td>\n              <td>Version initiale</td>\n            </tr></tbody>\n        </table>","zhKind","complete","漏洞","补丁","PHP","https://www.cert.cyber.gouv.fr/avis/CERTFR-2026-AVI-1435/","CERT-FR",{"_100":101,"_102":-5},"changelogVersion","2026-10-01T08:00","release"]
