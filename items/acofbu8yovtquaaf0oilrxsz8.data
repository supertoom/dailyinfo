[{"_1":2,"_3":4},"root",{"_5":91},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795740033000,"id","acofbu8yovtquaaf0oilrxsz8","title","FIFA 确认遭到网络攻击，个人及业务信息遭访问","originalTitle","FIFA Says It Has Been Victim of a Cyberattack Accessing ‘Personal and Business Information’","summary","FIFA 确认遭到网络攻击，黑客获取了其所称“有限范围的个人和业务信息”，但未说明攻击发生时间及所涉信息的具体性质。上周，自称 Handsome Boy Hacking Club 的组织在 X 发布声称属于 FIFA 的文件截图，3 天后又回应称超过 12 GB 的内部文档已被泄露；FIFA 正与执法机构等主管机关合作，并强烈谴责非法获取和公布信息的行为。","reason","source",{"_73":90},"links",{"_61":89},"publishedAt","2026-11-26T17:06:55.000Z","discoveredAt","2026-11-26T17:28:19.603Z","timelineAt","category","activity","tags",[74,87,88],"score",52,"selected",false,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","Associated Press","body",{"_83":-5,"_61":84,"_85":-5,"_86":36},"outline",[],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fTxcF6H1FbSw","reportCount",1,"additionalSourceCount",0,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","attack","name","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件",{"_80":81,"_13":82},"publicId","1ab2de17-8bbc-419b-9dc9-438c6e2bd08b","FIFA确认遭网络攻击，个人及业务信息被访问","zh","<p><strong>FIFA was the victim of a cyberattack that saw hackers gain access to what soccer’s world governing body describes as a “limited set of personal and business information,” it said Thursday.</strong>\n\n\n\n</p><p>“FIFA is working closely with the relevant authorities, including law enforcement,” the organization said in a statement sent to The Associated Press.\n\n\n\n</p><p>FIFA didn’t say when the cyberattack took place, or the precise nature of the hacked information.\n\n\n\n</p><p>Last week, a group calling itself the Handsome Boy Hacking Club posted a screenshot on X of what it claimed were FIFA files. Three days later, it appeared to take credit for the hack when responding to a post that said more than 12 gigabytes of internal documents had been leaked.\n\n\n\n</p><p>“FIFA condemns in the strongest possible terms the unlawful acquisition and publication of information, particularly personal data,” the governing body said in its statement. “Such actions constitute a serious and unacceptable violation of privacy and can have significant consequences for the individuals concerned.”\n\n\n\n</p><p>The breach comes at a time when FIFA and its president, Gianni Infantino, is under scrutiny after his foiled, secretive plan to sell stakes in the World Cup to private investors.</p><p><span>Advertisement. Scroll to continue reading.</span></p><p>Infantino is also trying to extend his 11-year presidency of FIFA to 2031. He is the favorite when the election is held on March 18, with Kohzo Tashima of Japan and Philippe Diallo of France the other candidates.\n\n\n\n</p><p><strong>Related</strong>: <a href=\"https://www.securityweek.com/1password-breach-exposes-customer-data-internal-source-code/\">1Password Breach Exposes Customer Data, Internal Source Code</a>\n\n\n\n</p><p><strong>Related</strong>: <a href=\"https://www.securityweek.com/us-treasurys-fincen-disconnects-systems-following-cyber-incident/\">US Treasury’s FinCEN Disconnects Systems Following Cyber Incident</a>\n\n\n\n</p><p><strong>Related</strong>: <a href=\"https://www.securityweek.com/plagiarism-checker-turnitin-investigating-cyberattack/\">Plagiarism Checker Turnitin Investigating Cyberattack</a>\n      </p>","zhKind","complete","数据泄露","数据窃取","https://www.securityweek.com/fifa-says-it-has-been-victim-of-a-cyberattack-accessing-personal-and-business-information/","SecurityWeek",{"_92":93,"_94":-5},"changelogVersion","2026-10-01T08:00","release"]
