[{"_1":2,"_3":4},"root",{"_5":110},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794185102000,"id","ihl9k919cuk2zeu8m5uh5sr73","title","Polymarket 因第三方服务遭入侵暂停交易，约 $2.5M 加密资产被追踪","originalTitle","Polymarket halts trading after crypto-draining script breach, $2.5M traced","summary","Polymarket 因第三方供应商被入侵而遭恶意 JavaScript 注入，约 $2.5M 加密资产已转移至疑似攻击者钱包。该脚本通过 cdn.debugbear[.]com/C7xcKKrjUnXK.js 分发，劫持已登录用户的交易会话、出售预测市场持仓并转移加密资产，还利用 data.debugbear.com 接收指令及回传账户、余额和交易结果。","reason","文章还原了第三方服务遭入侵后的脚本注入与资产转移链，并给出钱包、链上交易和处置时间线，便于判断影响范围。","source",{"_76":109},"links",{"_101":108},"publishedAt","2026-10-29T21:47:25.000Z","discoveredAt","2026-10-29T23:39:25.262Z","timelineAt","category","activity","tags",[79,77,105,106,107],"score",79,"selected",true,"channel","news","story",{"_89":90,"_13":91},"x","readingMode","full","author","Lawrence Abrams","body",{"_61":100,"_101":-5,"_102":103,"_104":37},"outline",[92,93],"relatedStories",[88],"topics",[68,69,70,71,72,73],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fjTpuOAuMvV4","reportCount",3,"additionalSourceCount",2,{"_74":86,"_76":87},{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","malware","name","恶意软件","attack","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","crypto","密码学","identity","身份与访问",{"_89":90,"_13":91},"publicId","b40ce903-e6e2-4df6-be78-7db6e9efa397","DebugBear脚本被篡改，Polymarket损失约270万美元",{"_11":98,"_95":99,"_97":67},{"_11":94,"_95":96,"_97":67},"sec-2","text","攻击者一旦拥有有效凭据，其操作仅有 37% 会被阻止","level","sec-1","用于清空钱包的恶意 JavaScript","<p><img alt=\"Polymarket\" height=\"900\" src=\"/dailyinfo/media/49e86b737b1c7280.jpg\" srcset=\"/dailyinfo/media/7c0002d403ce2b5a.jpg 720w, /dailyinfo/media/0fd91760f328704c.jpg 1200w, /dailyinfo/media/49e86b737b1c7280.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>预测市场平台 Polymarket 周四暂时暂停交易，此前黑客攻陷了一家第三方服务，通过其分发可清空加密货币的 JavaScript，约 250 万美元资产已被追踪至一个疑似攻击者钱包。</p><p>该公司确认了这起安全事件，称已识别并修复影响其国际平台 Polymarket.com 的问题，并将该入侵事件移交执法部门处理。</p><p><a href=\"https://status.polymarket.com/cmvtuswgi00221bkzps7w21pt\">Polymarket 表示</a>：“我们的一家第三方提供商遭到攻陷，我们已将此事移交相关执法部门。”</p><p>“所有受到影响的用户都将获得全额补偿。出于高度谨慎，我们已暂时停止交易，并正在努力让平台恢复上线。”</p><p>Polymarket 最初于美国东部时间下午 2:05 将其交易所置于仅可取消模式，并在调查事件期间暂停了中继操作。下午 2:37，该公司宣布问题已修复，出于高度谨慎暂时停止了交易。</p><p>交易在最初暂停约一小时后恢复，美国东部时间下午 3:05，该事件被标记为已解决。</p><p>该公司在 <a href=\"https://x.com/PolymarketTrade/status/2115881498477785393\">X 上宣布</a>：“交易现已完全恢复上线。我们会解决此事，并将为所有受影响的交易者全额赔付。”</p><p>Polymarket 未披露有多少用户受到影响、被盗走了多少加密货币，也未说明补偿流程将如何进行。</p><p>Hudson Rock 的安全研究人员在一个恶意 JavaScript 中发现了疑似由攻击者控制的钱包（<a href=\"https://polygonscan.com/address/0x3F99139F1C5854bb628c2e576Aaf638e99dFfc18\">0x3F99139F1C5854bb628c2e576Aaf638e99dFfc18</a>）。</p><p>BleepingComputer 对该钱包的区块链活动进行检查，发现其向另外三个钱包转移了约 2860 万枚 POL，价值约 257 万美元。</p><p>区块链记录还显示，该钱包在交易所暂停交易前不久的美国东部时间下午 1:50 至 1:56 之间，针对 Polymarket 的预测市场代币合约进行了多笔交易。</p><p>Hudson Rock 报告称，该钱包在其调查期间持有约 219 万美元的加密货币。</p><h2 id=\"sec-1\">用于清空钱包的恶意 JavaScript</h2><p>Hudson Rock 的安全研究人员<a href=\"https://www.infostealers.com/article/polymarket-breach-alert-wallet-draining-code-found-in-a-third-party-script/\">发现了恶意 JavaScript</a>，该脚本通过 <code>cdn.debugbear[.]com/C7xcKKrjUnXK.js</code> 分发，旨在窃取 Polymarket 用户的加密货币和预测市场持仓。</p><p>该脚本托管在 DebugBear 所属的基础设施上。DebugBear 是一家网站性能监控服务，可帮助组织跟踪网站加载速度和用户体验。</p><p>DebugBear 的真实用户监控（RUM）服务使用嵌入网站的 JavaScript，从访问者的浏览器收集性能指标。</p><p>DebugBear 此后确认正在调查一起持续中的安全事件，并警告客户从其网站中移除监控 JavaScript。</p><p>DebugBear 在<a href=\"https://x.com/DebugBear/status/2115866496643535293\">X 的一则帖子</a>中表示：“我们受到了一起持续中的安全事件的影响。”</p><p>“如果您使用我们的 RUM 产品，请从您的网站中移除嵌入代码。”</p><p>截至撰写本文时，DebugBear 的网站无法访问，显示 Cloudflare 错误。目前尚不清楚该网站中断是否与遏制措施有关，还是此次事件造成的其他后果。</p><p>Hudson Rock 的研究人员还发现，Polymarket 的生产构建元数据中包含提交消息“<code>chore(polymarket): remove debugbear rum script (#15337)</code>”，&nbsp;这表明该平台已移除 DebugBear 监控集成。</p><p>该构建的时间戳为10月29日美国东部时间下午1:59 shortly Polymarket公开宣布该事件之前。&nbsp;</p><p>BleepingComputer分析了恶意 JavaScript 文件（<a href=\"https://www.virustotal.com/gui/file/0755e767504d8103f6c27b9e765a1026507a17c04513242adb503df7777879e5\">VirusTotal</a>）的一份副本，发现该文件旨在劫持已通过身份验证的 Polymarket 交易会话、清算用户的预测市场头寸，并将加密货币和其他资产转移到攻击者控制的钱包。</p><p>该恶意软件会检查访问者是否已登录 Polymarket，并尝试使用其现有交易会话和平台的交易功能执行未经授权的交易。</p><p>随后，它会检查用户的加密货币余额和预测市场头寸，以确定其持仓价值。</p><p>根据用户向 Polymarket 进行身份验证的方式，该恶意软件会尝试以不同方式窃取其资产。</p><p>对于部分用户，它会尝试自动出售其预测市场头寸。对于其他用户，该恶意软件会尝试将预测市场代币直接转移到攻击者控制的钱包。</p><figure><img alt=\"Malicious JavaScript attempts to transfer users' Polymarket prediction-market tokens to an attacker-controlled wallet\" height=\"600\" src=\"/dailyinfo/media/844648eb288323fa.jpg\" srcset=\"/dailyinfo/media/72be5686c660693c.jpg 720w, /dailyinfo/media/00a3499b664b33bb.jpg 1200w, /dailyinfo/media/844648eb288323fa.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1352\">\n<figcaption><strong>恶意 JavaScript 试图将用户的 Polymarket 预测市场代币转移到攻击者控制的钱包</strong><br>\n<em>来源：BleepingComputer</em></figcaption>\n</figure><p>该恶意软件还会利用 Polymarket 现有的交易功能，尝试将用户的加密货币持仓转换为可转移到攻击者控制钱包的资产。</p><p>BleepingComputer 发现，该恶意脚本会与 <code>data.debugbear.com</code> 通信，以接收指令并发送有关目标账户、钱包地址、余额和交易结果的数据。</p><p>该恶意软件使用 DebugBear 的基础设施来分发恶意脚本，并将其用作命令与控制（C2）和数据外泄服务器，这引出了一个问题：攻击者对该公司的系统拥有多大访问权限。</p><p>BleepingComputer 已就此次事件联系 Polymarket 和 DebugBear 提出疑问，如果收到回应，将更新本文。</p><p><a href=\"https://hubs.li/Q04sB3fb0\">\n            <img src=\"/dailyinfo/media/8fba1fc16e9d219a.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-2\">\n            <a href=\"https://hubs.li/Q04sB3fb0\">攻击者一旦拥有有效凭据，其操作仅有 37% 会被阻止</a>\n        </h2><p>总体预防评分可能会掩盖初始访问之后所发生的事情。一旦攻击者开始使用有效凭据，预防效果就会大幅下降。</p><p>《Blue Report 2026》逐项技术衡量防御能力，涵盖在客户生产环境中运行的 338 million 次模拟。</p><p><a href=\"https://hubs.li/Q04sB3fb0\">获取报告</a>\n    </p>","original","zhKind","translation","complete","数据窃取","加密","凭据","https://www.bleepingcomputer.com/news/security/polymarket-halts-trading-after-crypto-draining-script-breach-25m-traced/","BleepingComputer",{"_111":112,"_113":-5},"changelogVersion","2026-10-01T08:00","release"]
