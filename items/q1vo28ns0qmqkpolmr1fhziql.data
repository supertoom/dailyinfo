[{"_1":2,"_3":4},"root",{"_5":120},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1794195832000,"id","q1vo28ns0qmqkpolmr1fhziql","title","Google Brotli C 解码器 RCE 漏洞 CVE-2026-111497 影响 Node.js 等多类产品","originalTitle","不止 Node.js！Brotli RCE（CVE-2026-111497）影响范围说明","summary","Google Brotli C 解码器存在越界写入漏洞 CVE-2026-111497，CVSS 4.0 9.2，处理畸形 Brotli 数据时可能导致拒绝服务、进程内存读取和远程代码执行。","reason","文章梳理了上游 Brotli C 解码器到多个产品的传导路径，并区分已修复与尚未修复版本，读者可据此定位自身依赖和暴露入口。","source",{"_73":119},"links",{"_107":118},"publishedAt","2026-10-29T06:32:00.000Z","discoveredAt","2026-10-29T23:40:19.379Z","timelineAt","category","vuln","tags",[110,111,112,113,114,115,116,117],"score",82,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","body",{"_61":106,"_107":-5,"_108":107,"_109":37},"outline",[82,83,84,85,86,87,88],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","f-6yZLHZWu0k","reportCount",1,"additionalSourceCount",0,{"_71":76,"_73":77},{"_71":31,"_73":75},{"_71":72,"_73":74},"slug","research","name","技术研究","漏洞披露","google","Google / 谷歌",{"_79":80,"_13":81},"publicId","7c28657e-31de-4920-a954-1af1b284351f","CISA确认Brotli越界写漏洞遭利用",{"_11":104,"_90":105,"_92":93},{"_11":102,"_90":103,"_92":93},{"_11":100,"_90":101,"_92":93},{"_11":98,"_90":99,"_92":93},{"_11":96,"_90":97,"_92":93},{"_11":94,"_90":95,"_92":93},{"_11":89,"_90":91,"_92":93},"sec-7","text","5. 开发工具与配套客户端","level",3,"sec-6","4. 文件工具","sec-5","3. 代理、服务网格、防火墙","sec-4","2. 应用作为 HTTP 服务端","sec-3","1. 应用作为 HTTP 客户端","sec-2","2. 尚未发布修复版本的产品","sec-1","1. 已发布修复版本的产品","<p>原创 <span>微步情报局</span> <span>2026-10-29 14:32</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/4aa385a3ce55ce5f.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>点击查看漏洞详情</p><p><span>漏洞概况</span></p><p><span>CVE-2026-111497 是 Google Brotli C 解码器中的越界写漏洞（CVSS 4.0 9.2）。Brotli 解码器在处理畸形 Brotli 输入数据时，会在解码过程中触发越界写入，</span><span>成功利用可能导致拒绝服务、进程内存读取和远程代码执行。</span></p><p><span>Google Brotli 受影响版本为 1.0.3–1.0.9、1.1.0 和 1.2.0，其修复代码于 2026 年 2 月进入 google/brotli 仓库。Google 于 10 月 21 日发布修复版本 1.0.10、1.1.1 和 1.2.1，该漏洞同日随 Node.js 安全更新被广泛披露。</span></p><p><span>Brotli 是常见的压缩实现，HTTP&nbsp;</span><span>流量里的&nbsp;</span><code><span>br</span></code><span>&nbsp;编码会交给解码器，部分字体和 Parquet 文件同样会调用它。Node.js、Bun、Python 软件包、.NET、代理与防火墙、开发工具以及文件处理软件，往往各自编译或链接一份 C 解码器。</span><strong><span>缺陷位于</span><span>这份</span><span>被广泛集成的上游库，各产品里的副本彼此独立，升级其中一款，无法修复其余产品中的解码器，许多下游产品仍带着未修复副本。</span></strong></p><p><span>影响范围</span></p><h3 id=\"sec-1\"><span>1. 已发布修复版本的产品</span></h3><table><tbody><tr><th><p><span>产品</span></p></th><th><p><span>修复版本</span></p></th><th><p><span>默认配置下是否自动解压</span></p></th></tr><tr><td><p><span>Node.js 22 / 24 / 26</span></p></td><td><p><span>22.23.4 / 24.22.1 / 26.12.1</span></p></td><td><p><span>客户端&nbsp;</span><code><span>fetch</span></code><span>（出站）</span><strong><span>会</span></strong><span>；Express 5 的&nbsp;</span><code><span>json()</span></code><span>&nbsp;/&nbsp;</span><code><span>raw()</span></code><span>（入站）</span><strong><span>会</span></strong><span>；仅&nbsp;</span><code><span>http.createServer</span></code><span>、未接解压中间件&nbsp;</span><strong><span>不会</span></strong></p></td></tr><tr><td><p><span>Bun</span></p></td><td><p><span>1.4.4</span></p></td><td><p><span>客户端&nbsp;</span><code><span>fetch</span></code><span>（出站）</span><strong><span>会</span></strong></p></td></tr><tr><td><p><span>PyPI&nbsp;</span><code><span>Brotli</span></code><span>&nbsp;/&nbsp;</span><code><span>brotlicffi</span></code></p></td><td><p><span>1.2.1 / 1.2.1.0</span></p></td><td><p><span>环境里装了其中之一后，调用常见 HTTP 客户端方法会自动解压&nbsp;</span><code><span>br</span></code></p></td></tr><tr><td><p><span>Envoy</span></p></td><td><p><span>1.40.0 / 1.39.3 / 1.38.6 / 1.37.8 / 1.36.12</span></p></td><td><strong><span>不会</span></strong><p><span>（需配置）</span></p></td></tr><tr><td><p><span>Istio</span></p></td><td><p><span>1.31.2 / 1.30.6 / 1.29.9</span></p></td><td><strong><span>不会</span></strong><p><span>（需配置）</span></p></td></tr><tr><td><p><span>.NET 8 / 9 / 10 / 11</span></p></td><td><p><span>8.0.33 / 9.0.22 / 10.0.14 / 11 第 3 个候选发布版（RC3）</span></p></td><td><strong><span>不会</span></strong><p><span>（请求解压与 HttpClient 自动解压默认关闭）</span></p></td></tr><tr><td><p><span>PAN-OS</span></p></td><td><p><span>以 Palo Alto 通告热修复表为准</span></p></td><td><strong><span>不会</span></strong><p><span>（Brotli 流量检查默认关闭；11.2.3 及更早不支持）</span></p></td></tr><tr><td><p><span>PowerShell 7</span></p></td><td><p><span>7.4.22 / 7.5.13 / 7.6.9</span></p></td><td><p><span>对不受控站点使用&nbsp;</span><code><span>Invoke-WebRequest</span></code><span>&nbsp;/&nbsp;</span><code><span>Invoke-RestMethod</span></code><span>&nbsp;时</span></p></td></tr><tr><td><p><span>PHP 官方 Windows 包</span></p></td><td><p><span>8.5.12-1 / 8.4.27-1 / 8.3.36-1 / 8.2.35-1（Brotli 1.2.1）</span></p></td><td><strong><span>不会</span></strong><p><span>（cURL 自动解压默认关闭）</span></p></td></tr><tr><td><p><span>Visual Studio</span></p></td><td><p><span>2019&nbsp;</span><strong><span>16.11.61</span></strong><span>；2022&nbsp;</span><strong><span>17.14.43</span></strong><span>；2026&nbsp;</span><strong><span>18.11.2</span></strong></p></td><td><p><span>取决于安装的组件</span></p></td></tr><tr><td><p><span>Prisma Cloud Transporter Client</span></p></td><td><p><span>0.2.9</span></p></td><td><strong><span>会</span></strong></td></tr></tbody></table><p><span><span>注：</span></span><span>“默认配置下是否自动解压”指在常见默认配置下，是否会自动解压不可信的 Brotli 数据。</span></p><h3 id=\"sec-2\"><span>2. 尚未发布修复版本的产品</span></h3><p><span>截至 2026-10-29，这些产品尚无包含修复的正式版本，</span><strong><span>修复前不要用来处理不可信的输入。</span></strong></p><table><tbody><tr><th><p><span>产品</span></p></th><th><p><span>现状</span></p></th><th><p><span>不可信输入</span></p></th></tr><tr><td><p><span>DuckDB</span></p></td><td><p><span>最新正式版 2.0.0 内置未修复的 Brotli 1.1.0</span></p></td><td><p><span>Brotli 压缩的 Parquet</span></p></td></tr><tr><td><p><span>Apache Arrow</span></p></td><td><p><span>最新正式版 26.0.0 的打包构建使用 Brotli 1.0.9；链接已修复系统库的构建不受影响</span></p></td><td><p><span>Brotli 压缩的 Parquet / Arrow IPC</span></p></td></tr><tr><td><p><span>google/woff2</span></p></td><td><p><span>10 月 28 日已合入 Brotli 1.2.1，但尚无新正式版；旧源码随附 1.0.3，CMake 构建可使用系统库</span></p></td><td><p><span>WOFF2 字体</span></p></td></tr></tbody></table><p><span>公开扫描名单（Semgrep、broccoli2shell）依据的是软件中含有受影响版本的的&nbsp;</span><code><span>decode.c</span></code><span>。可视为排查线索，不等同当前应用可被远程利用。</span></p><p><span><span>不可信数据如何进入解码器</span></span></p><p><span>本漏洞在进程对不可信数据执行 Brotli 解压时触发，常见情况可分为以下场景：</span></p><h3 id=\"sec-3\"><span>1. 应用作为 HTTP 客户端</span></h3><p><span>应用作为 HTTP 客户端访问外部资源，响应头为&nbsp;</span><code><span>Content-Encoding: br</span></code><span>&nbsp;时解压响应：</span></p><ul><li><p><strong><span>Node.js：</span></strong><span>&nbsp;内置&nbsp;</span><code><span>fetch()</span></code><span>、axios、got 默认解压。</span></p></li><li><p><strong><span>Bun：</span></strong><code><span>fetch</span></code><span>&nbsp;默认解压响应；</span><code><span>node:zlib</span></code><span>&nbsp;的 Brotli 解压方法、</span><code><span>DecompressionStream(\"brotli\")</span></code><span>&nbsp;在显式调用时解压。</span></p></li><li><p><strong><span>Python：</span></strong><span>&nbsp;装了&nbsp;</span><code><span>Brotli</span></code><span>&nbsp;或&nbsp;</span><code><span>brotlicffi</span></code><span>&nbsp;后，urllib3、requests、httpx、aiohttp 默认解压，即使业务代码没有&nbsp;</span><code><span>import brotli</span></code><span>。</span></p></li><li><p><strong><span>.NET HttpClient：</span></strong><span>&nbsp;打开&nbsp;</span><code><span>AutomaticDecompression</span></code><span>&nbsp;的&nbsp;</span><code><span>Brotli</span></code><span>&nbsp;或&nbsp;</span><code><span>All</span></code><span>&nbsp;才会解压。</span><strong><span>默认关闭。</span></strong></p></li><li><p><strong><span>PHP 官方 Windows 包：</span></strong><span>&nbsp;cURL 自动解压默认关闭，应用或客户端库可以打开。</span></p></li><li><p><strong><span>PowerShell 7：</span></strong><span>&nbsp;对不受控站点使用&nbsp;</span><code><span>Invoke-WebRequest</span></code><span>&nbsp;/&nbsp;</span><code><span>Invoke-RestMethod</span></code><span>&nbsp;时会解压。</span></p></li></ul><h3 id=\"sec-4\"><span>2. 应用作为 HTTP 服务端</span></h3><p><span>应用作为 HTTP 服务端，请求头为&nbsp;</span><code><span>Content-Encoding: br</span></code><span>&nbsp;时解压请求体：</span></p><ul><li><p><strong><span>Express 5 / body-parser 2：</span></strong><code><span>json()</span></code><span>、</span><code><span>raw()</span></code><span>&nbsp;默认解压；NestJS、Koa + koa-bodyparser 在使用支持 Brotli 的适配器或解析中间件时同样。仅&nbsp;</span><code><span>http.createServer</span></code><span>&nbsp;不会自动解压；Express 4 自带解析器不支持 Brotli，但另接支持 Brotli 的中间件后仍会解压。</span></p></li><li><p><strong><span>Flask：</span></strong><span>&nbsp;默认不解压。</span></p></li><li><p><strong><span>ASP.NET Core：</span></strong><span>&nbsp;注册&nbsp;</span><code><span>AddRequestDecompression()</span></code><span>&nbsp;并调用&nbsp;</span><code><span>UseRequestDecompression()</span></code><span>&nbsp;后默认支持&nbsp;</span><code><span>br</span></code><span>。</span><strong><span>应用默认不启用该中间件。</span></strong></p></li></ul><h3 id=\"sec-5\"><span>3. 代理、服务网格、防火墙</span></h3><p><span>反向代理、服务网格或防火墙若对流量做 Brotli 解压，解压发生在这些设备上。</span></p><ul><li><p><strong><span>Envoy：</span></strong><span>&nbsp;配置了 Brotli 解压器才会解压。</span></p></li><li><p><strong><span>Istio：</span></strong><span>&nbsp;启用 Brotli 解压（例如&nbsp;</span><code><span>EnvoyFilter</span></code><span>）才会解压。</span></p></li><li><p><strong><span>PAN-OS：</span></strong><span>&nbsp;同时开启 Brotli 流量检查与 TLS 解密才会解压；默认关闭。</span></p></li></ul><h3 id=\"sec-6\"><span>4. 文件工具</span></h3><p><span>升级系统&nbsp;</span><code><span>libbrotli</span></code><span>&nbsp;无法修复程序内部静态链接的 Brotli；动态链接系统库的构建可通过更新系统库修复。正式修复发布前，不要打开或导入来源不可信的这类文件。</span></p><ul><li><p><strong><span>DuckDB / Apache Arrow：</span></strong><span>&nbsp;读取 Brotli 压缩的 Parquet 时会解压；Arrow 读取含 Brotli 压缩数据的 IPC 文件也会解压。</span></p></li><li><p><strong><span>google/woff2：</span></strong><span>&nbsp;解码 WOFF2 时会解压。</span></p></li></ul><h3 id=\"sec-7\"><span>5. 开发工具与配套客户端</span></h3><ul><li><p><strong><span>Visual Studio：</span></strong><span>&nbsp;随安装的组件携带 Brotli，以实际安装的组件为准。</span></p></li><li><p><strong><span>Prisma Cloud Transporter Client：</span></strong><span>&nbsp;通告写明无需特殊配置。</span></p></li><li><p><strong><span>.NET 运行时：</span></strong><span>&nbsp;请求解压、HttpClient 自动解压默认关闭；使用&nbsp;</span><code><span>BrotliStream</span></code><span>&nbsp;解压模式 /&nbsp;</span><code><span>BrotliDecoder</span></code><span>&nbsp;处理输入时会解压。</span></p></li><li><p><strong><span>Node.js / Bun / Electron：</span></strong><span>&nbsp;Electron 内嵌的 Node、已分发的&nbsp;</span><code><span>bun build --compile</span></code><span>&nbsp;是另一份副本，升级宿主机无法更新。</span></p></li></ul><p><span><span>修复建议</span></span></p><ol><li><p><strong><span>优先升级会解压不可信 HTTP&nbsp;</span><code><span>br</span></code><span>&nbsp;数据的应用。</span></strong><span>&nbsp;Node.js 升到 22.23.4 / 24.22.1 / 26.12.1 并重启（细节见上述 Node.js 说明）。Bun 升到 1.4.4；已用&nbsp;</span><code><span>bun build --compile</span></code><span>&nbsp;生成的文件，用 1.4.4 重新编译。已安装 PyPI&nbsp;</span><code><span>Brotli</span></code><span>&nbsp;或&nbsp;</span><code><span>brotlicffi</span></code><span>&nbsp;的 Python 环境，把包升到 1.2.1 / 1.2.1.0。升级后重建容器镜像并重启进程。</span></p></li><li><p><strong><span>检查应用是否会把不可信&nbsp;</span><code><span>br</span></code><span>&nbsp;数据交给受影响的解码器处理。</span></strong></p></li><li><p><strong><span>升级系统库&nbsp;</span><code><span>libbrotlidec</span></code><span>，并重启仍加载旧动态库的进程。</span></strong></p></li><li><p><strong><span>对于静态链接或内嵌自编译 Brotli C 解码器的程序，需安装该软件的修复版本或重新构建。</span></strong></p></li><li><p><strong><span>正式修复发布前，不要用尚未修复的文件工具打开或导入来源不可信的 Parquet、WOFF2 等文件。</span></strong></p></li></ol><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=6b3b5905&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzg5MTc3ODY4Mw%3D%3D%26mid%3D2247509017%26idx%3D1%26sn%3De3b3303980b0cb8640b92b141c510261\">跳转微信打开</a></p>","original","zhKind","complete","漏洞","补丁","漏洞分析","Google","Microsoft","Palo Alto","Node.js","阿里","https://mp.weixin.qq.com/s?__biz=Mzg5MTc3ODY4Mw==&mid=2247509017&idx=1&sn=e3b3303980b0cb8640b92b141c510261","微步在线研究响应中心",{"_121":122,"_123":-5},"changelogVersion","2026-10-01T08:00","release"]
