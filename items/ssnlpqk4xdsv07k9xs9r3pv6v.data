[{"_1":2,"_3":4},"root",{"_5":139},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1793672468000,"id","ssnlpqk4xdsv07k9xs9r3pv6v","title","Cisco 发布 AI Transit，将 NeoCloud 等 AI 环境接入现有 SD-WAN","originalTitle","Cisco AI Transit connects AI environments to your SD-WAN","summary","Cisco AI Transit 可将 NeoCloud、私有及主权 AI 云和企业 AI 工厂连接到现有 Cisco SD-WAN，支持物理或虚拟设备部署，并让客户通过 SD-WAN 应用策略统一管理 AI 与 agentic traffic 的路由、分段、安全、性能和可见性。","reason","source",{"_74":138},"links",{"_61":137},"publishedAt","2026-11-02T16:00:32.000Z","discoveredAt","2026-11-02T16:47:33.827Z","timelineAt","category","blue-team","tags",[133,77,134,135,136],"score",31,"selected",false,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Hugo Vliegen","body",{"_129":-5,"_61":130,"_131":-5,"_132":36},"outline",[86,87,88,89,90,91,92,93,94,95,96,97,98],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fPD_gc5wCSnI","reportCount",1,"additionalSourceCount",0,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","tools","name","工具与平台","ai-security","AI 安全","ai-agent","AI Agent 安全","cisco","Cisco / 思科",{"_83":84,"_13":85},"publicId","cc65a6e2-8a7f-499b-a2d5-a91968bd8d50","Cisco 发布 AI Transit 接入方案",{"_11":126,"_100":127,"_102":128},{"_11":124,"_100":125,"_102":103},{"_11":122,"_100":123,"_102":103},{"_11":120,"_100":121,"_102":103},{"_11":118,"_100":119,"_102":103},{"_11":116,"_100":117,"_102":103},{"_11":114,"_100":115,"_102":103},{"_11":112,"_100":113,"_102":103},{"_11":110,"_100":111,"_102":103},{"_11":108,"_100":109,"_102":103},{"_11":106,"_100":107,"_102":103},{"_11":104,"_100":105,"_102":103},{"_11":99,"_100":101,"_102":103},"sec-14","text","What should network architects confirm before adopting AI Transit?","level",2,"sec-13","Why do geographic traffic requirements matter for AI workloads?","sec-12","How is AI Transit deployed?","sec-11","How does AI Transit support consistent network and security policy?","sec-10","Which AI environments can AI Transit connect?","sec-9","How does AI Transit relate to Cisco SD-WAN Cloud OnRamp?","sec-8","What is Cisco AI Transit?","sec-7","Connecting AI environments with Cisco AI Transit","sec-6","The SD-WAN overlay becomes the connective tissue for distributed AI","sec-5","AI Transit connects specialized AI environments to the SD-WAN fabric","sec-4","Don’t break the abstraction","sec-3","AI will not have one natural home","sec-2","AI will run in many places. The enterprise fabric should remain one.",3,"zh","<h3 id=\"sec-1\"><a href=\"https://blogs.cisco.com/gcs/ciscoblogs/1/2026/10/AI-will-run-in-many-places.png\"><img src=\"/dailyinfo/media/dbb05051cd9be807.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\" width=\"715\" height=\"472\"></a></h3><h3 id=\"sec-2\">AI will run in many places. The enterprise fabric should remain one.</h3><p>Earlier this year at Cisco Live, our team spent an evening talking with several NeoCloud providers alongside colleagues from Cisco’s AI Infrastructure organization. We expected the conversation to revolve around GPUs, AI factories, and inference capacity.</p><p>Instead, the same request kept surfacing. Their enterprise customers wanted an easier way to connect AI workloads running in these environments into their existing Cisco SD-WAN networks.</p><p>They weren’t simply asking for another connection. These customers had already built routing, segmentation, security, and application policies into their SD-WAN fabric. They wanted that operating model to extend to AI infrastructure.</p><p><b>AI is distributing compute. It shouldn’t fragment the enterprise.</b></p><h2 id=\"sec-3\">AI will not have one natural home</h2><p>The first wave of cloud computing concentrated a large share of enterprise workloads into a relatively small number of hyperscalers. Enterprise networking evolved with it. Cloud on-ramps made those environments easier to reach, while SD-WAN abstracted the transports connecting branches, campuses, data centers, and clouds.</p><p>AI is developing differently – from core to edge.</p><p>Hyperscalers remain important, but enterprises are also turning to specialized NeoCloud providers for GPU capacity and AI infrastructure. NeoClouds initially emerged around specialized GPU capacity. As enterprises move AI into production, these environments increasingly become part of enterprise infrastructure, where networking, security, performance, and policy need to follow the workload.</p><p>At the same time, more AI processing is moving closer to where people and businesses operate. You can already see this in retail, where stores are beginning to combine local inference with AI models and services delivered from the cloud. Similar patterns are emerging through edge, local, and deskside inference, wherever latency, economics, privacy, or sovereignty favor running AI closer to the business.</p><p>Where a workload runs will increasingly depend on performance, GPU availability, economics, security, and sovereignty.</p><p><b>AI will not have one natural home.</b></p><h2 id=\"sec-4\">Don’t break the abstraction</h2><p>The value of SD-WAN has never been another way to build tunnels. It is the abstraction that lets enterprises use different transports and providers while defining networking and security intent on a common overlay fabric.</p><p><b>AI shouldn’t break that abstraction.</b></p><p>An enterprise should not need to learn a different networking model every time a team selects another AI provider. Nor should network and security teams recreate routing, segmentation, and policy because an inference workload happens to run somewhere new.</p><p>Cloud on-ramps extended this abstraction into public clouds. AI now expands the problem across a much broader set of destinations.</p><p>The more places AI can run, the less practical it becomes to engineer connectivity one destination at a time.</p><p>We saw that directly with NeoCloud providers. Some were considering their own transit capabilities to simplify enterprise connectivity. That solves part of the problem inside the NeoCloud, but the enterprise still needs to connect that domain back into its WAN and reconcile policy on both sides.</p><p>A better approach is to make the AI environment part of the enterprise fabric.</p><h2 id=\"sec-5\">AI Transit connects specialized AI environments to the SD-WAN fabric</h2><p>That customer requirement is what Cisco AI Transit is designed to address.</p><p>Existing Cisco SD-WAN customers can use AI Transit to bring workloads running in NeoClouds, private and sovereign AI clouds, and enterprise AI factories onto their existing fabric.</p><p>Cisco SD-WAN Cloud OnRamp extends the enterprise fabric into public clouds. AI Transit builds on the same foundation to connect these specialized AI environments.</p><p>AI Transit can be deployed as a physical or virtual appliance, depending on the environment. In participating NeoClouds, where deployment is virtual, a Cisco secure virtual router is available as-a-service.</p><p>Once connected, customers can use SD-WAN application policy to classify AI and agentic traffic. They can then apply consistent routing, segmentation, security, performance, visibility, and geographic intent across the fabric. Secure Internet or private connectivity can be used while preserving one SD-WAN policy model.</p><p>We’re working with AI infrastructure providers including Armada, Cirrascale and Latitude to bring this model to life, giving enterprises greater choice in where they run AI without creating another networking and security domain.</p><p>The AI workload can live somewhere new without creating another network to operate.</p><p>This also matters for sovereignty. For some organizations, controlling where an AI workload and its data reside is only part of the requirement. They may also need to control where traffic is allowed to travel. Geographic intent therefore becomes another policy consideration alongside security and performance.</p><p>The best path may not always be the shortest one. It may be the path that satisfies all three.</p><h2 id=\"sec-6\">The SD-WAN overlay becomes the connective tissue for distributed AI</h2><p>In an earlier blog, How AI is changing enterprise SD-WAN requirements, I wrote about how AI is changing network traffic itself. AI applications and agents create interactions that can be more distributed, latency-sensitive, and machine-generated, increasing the importance of workload awareness, assurance, security, and visibility in SD-WAN.</p><p>AI Transit addresses another part of that transition: connecting specialized AI environments to the common SD-WAN fabric.</p><p>Today, NeoClouds make the shift particularly visible. Tomorrow, AI will increasingly span infrastructure from core to edge – from hyperscalers, NeoClouds, and sovereign AI environments to enterprise AI factories and edge, local, and deskside inference.</p><p>Enterprises should be able to choose where AI runs without rebuilding networking and security each time that choice changes. With Cloud OnRamp and AI Transit, Cisco SD-WAN provides one policy-driven fabric for that world.</p><p><b>The challenge isn’t connecting AI to the enterprise. It’s extending the enterprise to wherever AI runs.</b></p><p><b>As AI distributes compute, the SD-WAN overlay fabric becomes the connective tissue that keeps the enterprise together.</b></p><p><a href=\"https://www.cisco.com/site/us/en/solutions/networking/sdwan/index.html\"><b>Learn more about how we’re powering AI networking for today and tomorrow with Cisco SD-WAN.</b></a></p><h2 id=\"sec-7\">Connecting AI environments with Cisco AI Transit</h2><h2 id=\"sec-8\">What is Cisco AI Transit?</h2><p>Cisco AI Transit is designed to connect specialized AI environments to an enterprise’s existing Cisco SD-WAN fabric. Its purpose is to extend the enterprise’s established networking and security policy model to workloads running in those environments.</p><h2 id=\"sec-9\">How does AI Transit relate to Cisco SD-WAN Cloud OnRamp?</h2><p>Cisco SD-WAN Cloud OnRamp extends the enterprise fabric into public clouds. AI Transit builds on that foundation to connect specialized AI environments, including NeoClouds, private and sovereign AI clouds, and enterprise AI factories.</p><h2 id=\"sec-10\">Which AI environments can AI Transit connect?</h2><p>AI Transit is designed to connect workloads in NeoClouds, private and sovereign AI clouds, and enterprise AI factories to an existing Cisco SD-WAN fabric. Before planning a deployment, confirm support for the selected environment and provider.</p><h2 id=\"sec-11\">How does AI Transit support consistent network and security policy?</h2><p>AI Transit connects the AI environment to the existing SD-WAN fabric. Customers can then use the SD-WAN policy model to address routing, segmentation, security, and application requirements. Teams should validate the supported controls and configuration requirements for their deployment.</p><h2 id=\"sec-12\">How is AI Transit deployed?</h2><p>AI Transit can be deployed as a physical or virtual appliance, depending on the environment. The deployment plan should confirm the supported appliance, provider integration, and responsibility for managing the connection.</p><h2 id=\"sec-13\">Why do geographic traffic requirements matter for AI workloads?</h2><p>Organizations may need to consider both where AI workloads and data reside and where their traffic travels. Network and security teams should document those geographic requirements alongside security and performance needs when evaluating connectivity.</p><h2 id=\"sec-14\">What should network architects confirm before adopting AI Transit?</h2><p>Confirm the supported AI environment, deployment model, connectivity options, and operational responsibilities. Also validate the required routing, segmentation, security, traffic classification, visibility, and geographic controls against current product documentation.</p>","zhKind","complete","工具发布","网络设备","大模型","Cisco","https://blogs.cisco.com/security/cisco-ai-transit-connects-ai-environments-to-your-sd-wan/","Cisco Security Blog",{"_140":141,"_142":-5},"changelogVersion","2026-10-01T08:00","release"]
