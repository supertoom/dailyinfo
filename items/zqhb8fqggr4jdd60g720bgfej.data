[{"_1":2,"_3":4},"root",{"_5":102},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794616837000,"id","zqhb8fqggr4jdd60g720bgfej","title","forcequitOS 公开 iOS 沙箱逃逸 PoC worse_query，影响 iOS 26.7.1、27.0.1 和 27.2","originalTitle","iOS Sandbox Escape Is Public, and Apple Hasn’t Confirmed a Fix","summary","forcequitOS 公开了名为 worse_query 的 iOS 沙箱逃逸 PoC，可在应用创建 App Group container 后读取其他应用的数据目录，并在 iOS 27 上访问部分系统目录，影响 iOS 26.7.1、27.0.1 和 27.2。","reason","文章披露了 iOS 沙箱逃逸 PoC 的实现前提、文件访问范围和可安装应用，适合开发者理解风险边界与复现条件。","source",{"_74":101},"links",{"_92":100},"publishedAt","2026-11-10T15:46:20.000Z","discoveredAt","2026-11-10T16:52:24.944Z","timelineAt","category","disclosure","tags",[96,97,75,79,98,99],"score",82,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Pierluigi Paganini","body",{"_61":91,"_92":-5,"_93":94,"_95":37},"outline",[86],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","f_z74Fncncjo","reportCount",2,"additionalSourceCount",1,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","research","name","技术研究","vuln","漏洞披露","mobile","移动端","apple","Apple / 苹果",{"_83":84,"_13":85},"publicId","3a640a8f-dcc7-40bd-8930-74059a2ade39","forcequit公开iOS沙箱逃逸PoC",{"_11":87,"_88":89,"_90":65},"sec-1","text","一个公开的 iOS 沙箱逃逸漏洞可能暴露钱包密钥，Binance 发出警告。目前尚未报告任何攻击，也未确认已有修复。","level","<h2 id=\"sec-1\">一个公开的 iOS 沙箱逃逸漏洞可能暴露钱包密钥，Binance 发出警告。目前尚未报告任何攻击，也未确认已有修复。</h2><p>11 月 10 日，Binance 警告用户称，存在一个公开的 iOS 沙箱逃逸漏洞，可让一个应用读取其他应用的文件。该交易所表示，助记词、私钥和登录凭据可能会暴露给恶意应用。</p><p><em>警告中写道：“一个影响 iOS 26.7.1、27.0.1 和 27.2 的漏洞（worse_query）允许恶意应用读取其他应用的本地文件，使整个生态系统的助记词、私钥和登录凭据面临风险。这是 iOS 系统层面的问题，并非 Binance 独有。”</em></p><p>Binance 建议用户卸载从不可信来源安装的应用，将 iOS 和所有应用更新至最新的官方版本；如果怀疑已遭到入侵，应将资金转移至干净设备上的新钱包，并重置所有有效的登录会话。</p><figure><blockquote><p>一个影响 iOS 26.7.1、27.0.1 和 27.2 的漏洞（worse_query）允许恶意应用读取其他应用的本地文件，使整个生态系统的助记词、私钥和登录凭据面临风险。这是 iOS 系统层面的问题，并非 Binance 独有。…</p>— Binance (@binance) <a href=\"https://x.com/binance/status/2120093246399430770?ref_src=twsrc%5Etfw\">November 10, 2026</a></blockquote>\n</figure><p>一位名为“forcequitOS”的研究人员在 GitHub 上发布了名为 worse_query 的 <a href=\"https://github.com/forcequitOS/worse_query\">PoC 漏洞利用代码</a>。Apple 于次日针对这两个 iOS 版本发布了安全更新，但其<a href=\"https://support.apple.com/en-us/149715\">发布说明</a>中却出人意料地没有报告针对该问题的修复。好消息是，Binance 和该研究人员均未报告任何攻击或数据窃取行为。</p><p><em>forcequitOS 写道：“worse_query 是 <a href=\"https://github.com/forcequitOS/bad_query\">bad_query</a> 的直接继任者，并基本取代了它。要使用 worse_query，你必须为自己的应用设置一个 App Group 容器。”</em></p><p>该概念验证代码能够访问所有应用使用的数据文件夹，在 iOS 27 上还能访问部分系统文件夹。要使其生效，应用必须创建一个 App Group 容器。该研究人员表示，这段代码面向开发者，“本身没有用”。不过，其他开发者已经利用它构建了可安装在 iPhone 上的应用。</p><p>一个例子是 Christoph Kolbicz 开发的文件管理器 <a href=\"https://github.com/kolbicz/WQFiles\">WQ Files</a>，TheHackerNews <a href=\"https://github.com/kolbicz/WQFiles\">报道</a>称。</p><p><em>“<strong>WQ Files</strong> 是一款适用于 iOS 26 和 27 的文件浏览器、应用数据管理器和缓存清理工具。“WQ”代表 worse_query，这是它所基于的沙箱技术。它无需越狱，也无需内核漏洞利用，即可访问其他应用及系统容器。已在 iOS 26.7.1、27.0.1 和 27.2 上测试。 ” <a href=\"https://github.com/kolbicz/WQFiles\">阅读描述</a>。</em></p><p>它无需越狱或内核漏洞利用，即可访问其他应用所属的数据。它还可以编辑、删除和清除这些数据。用户可以通过 AltStore 和 SideStore 等侧载工具进行安装；用户使用 Apple ID 登录时，这些工具会自动创建所需的 App Group。</p><figure><blockquote><p>我同意（而且我本来也没打算参与），但说实话，我也不介意失去任何潜在奖金，毕竟 Apple 一直在拖延回应我，而这里的人开始拿这件事装模作样了。</p>— forcequit (@forcequitOS) <a href=\"https://x.com/forcequitOS/status/2119493787932336551?ref_src=twsrc%5Etfw\">November 8, 2026</a></blockquote>\n</figure><p><br>forcequitOS 表示，他们无意寻求 Apple 的漏洞赏金，并愿意放弃任何潜在奖励，因为 Apple 响应延迟，以及人们不当公开滥用或夸大该漏洞利用行为。</p><p><strong>在 Twitter 上关注我：&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;以及&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;和&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a><strong></strong></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;黑客活动，Apple)</strong></p>","original","zhKind","translation","complete","漏洞分析","复现","Apple","阿里","https://securityaffairs.com/202788/hacking/ios-sandbox-escape-is-public-and-apple-hasnt-confirmed-a-fix.html","Security Affairs",{"_103":104,"_105":-5},"changelogVersion","2026-10-01T08:00","release"]
