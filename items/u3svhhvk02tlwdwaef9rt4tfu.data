[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":-5,"_57":36,"_58":59},"expiresAt",1794185106000,"id","u3svhhvk02tlwdwaef9rt4tfu","title","Security Affairs 发布第 7 期 AI 网络安全新闻汇总","originalTitle","SECURITY AFFAIRS AI-CYBERSECURITY NEWSLETTER ROUND 7","summary","Security Affairs 第 7 期 AI 网络安全新闻汇总收录 AI 威胁、攻击、漏洞研究与防御进展，共涉及 18 篇文章。议题包括恶意版 Anthropic.claude-code、AI 驱动型 infostealer 受害者优先级分析、LLMJacking、AI 开发平台风险、ARTEX 银行攻击基础设施测绘及 Claude Dispatch 浏览器扩展 RCE 等。","reason","source",{"_63":83},"links",{"_59":82},"publishedAt","2026-11-08T15:28:46.000Z","discoveredAt","2026-11-08T18:08:20.918Z","timelineAt","category","ai-security","tags",[77,64,78,79,80,81],"score",10,"selected",false,"channel","news","story","x","readingMode","full","author","Pierluigi Paganini","body",{"_73":-5,"_59":74,"_75":-5,"_76":36},"outline",[67],"relatedStories",[],"topics",[60,61],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_62":65,"_63":66},{"_62":30,"_63":64},"slug","name","AI 安全","ai-agent","AI Agent 安全",{"_11":68,"_69":70,"_71":72},"sec-1","text","Security Affairs AI-CYBERSECURITY newsletter includes a collection of the best a","level",2,"zh","<h2 id=\"sec-1\">Security Affairs AI-CYBERSECURITY newsletter includes a collection of the best articles and research on AI in the international landscape</h2><p>Artificial intelligence is rapidly changing cybersecurity, reshaping both the techniques used by attackers and the tools available to defenders. AI agents can automate tasks, analyze large amounts of data, discover vulnerabilities and accelerate offensive operations. At the same time, AI is creating new capabilities for threat detection, incident analysis and response. Security Affairs’ new newsletter follows this evolution, covering every week the latest threats, attacks, vulnerabilities and developments at the intersection of AI and cybersecurity.</p><p><a href=\"https://www.techradar.com/pro/its-100-percent-a-national-security-threat-accenture-contractor-connected-an-ai-agent-to-the-pentagons-secure-network-and-then-sent-data-to-a-high-risk-website\">‘It’s 100 percent a national security threat’: Accenture contractor connected an AI agent to the Pentagon’s secure network, and then sent data to a high-risk website</a>&nbsp;&nbsp;</p><p><a href=\"https://cursor.com/blog/claude-code-extension-security-notice\">Security notice — malicious version of Anthropic.claude-code (2.1.312 and 2.1.313) identified in the Cursor VS Code Extension Marketplace</a>&nbsp;&nbsp;</p><p><a href=\"https://www.euronews.com/2026/11/02/uk-and-germany-to-jointly-develop-military-ai-in-2027\">UK and Germany to jointly develop military AI in 2027</a></p><p><a href=\"https://blog.talosintelligence.com/appraisal-by-ai-model-driven-victim-prioritization-in-the-volta-infostealer/\">Appraisal by AI: Model-driven victim prioritization in the VOLTA infostealer</a>&nbsp;&nbsp; </p><p><a href=\"https://www.theregister.com/security/2026/11/03/ai-policy-wonks-declare-sovereign-agents-a-threat-to-civilization/5307354\">AI policy wonks declare ‘sovereign agents’ a threat to civilization</a></p><p><a href=\"https://www.anthropic.com/research/provable-inference\">Progress on provable inference for large language models</a></p><p><a href=\"https://cloud.google.com/blog/topics/threat-intelligence/llmjacking-monetizing-compromised-cloud-models\">The Rise of LLMJacking: How Threat Actors Monetize Compromised Cloud and Model Resources</a>&nbsp;&nbsp; &nbsp;&nbsp;</p><p><a href=\"https://www.wiz.io/blog/black-october-for-ai-developer-platforms\">“Black October” for AI Developer Platforms</a> &nbsp;&nbsp;</p><p><a href=\"https://hunt.io/blog/artex-south-korea-bank-infrastructure\">ARTEX Exposed: Mapping the Infrastructure Behind the South Korean Bank Breaches</a>&nbsp;&nbsp;</p><p><a href=\"https://openai.com/index/a-thousand-fewer-paths-to-root/\">A thousand fewer paths to root</a></p><p><a href=\"https://muse.ai/blog/securing-muse\">Securing Muse: More Than $1 Million in Bug Bounties Paid Out</a></p><p><a href=\"https://research.checkpoint.com/2026/free-the-model-sell-the-gateway-prompt-adware-hidden-in-jailbreak-bundles/\">Free the Model, Sell the Gateway: Prompt Adware hidden in Jailbreak Bundles</a></p><p><a href=\"https://workos.com/security/bulletins/october-30th-2026-data-security-incident\">WorkOS October 30th, 2026 Data Security Incident</a>&nbsp;&nbsp;</p><p><a href=\"https://alignment.openai.com/misalignment-reports/covert-underperformance-on-safety-research-tasks/\">Covert underperformance on safety research tasks</a></p><p><a href=\"https://openai.com/index/introducing-gpt-6-cyber/\">GPT‑6 Cyber: Advancing the frontier of aligned cybersecurity agents</a>&nbsp;&nbsp;</p><p><a href=\"https://forever.security/blog/thisbash-claude-dispatch-browser-extension-rce\">ThisBash Escape: Claude Dispatch Flaw Enables Browser Extensions RCE on the OS</a>&nbsp;&nbsp;</p><p><strong>Follow me on Twitter:&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;hacking,&nbsp;<a href=\"https://securityaffairs.com/tag/newsletter\">newsletter</a>)</strong></p>","zhKind","complete","汇总","大模型","Agent 安全","AI 供应链","安全运营","https://securityaffairs.com/202682/ai/security-affairs-ai-cybersecurity-newsletter-round-7.html","Security Affairs",{"_85":86,"_87":-5},"changelogVersion","2026-10-01T08:00","release"]
