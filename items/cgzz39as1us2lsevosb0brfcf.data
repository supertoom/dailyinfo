[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794616827000,"id","cgzz39as1us2lsevosb0brfcf","title","NLTK TreebankWordTokenizer.span_tokenize 引号还原循环导致 O(n^2) CPU 耗尽","originalTitle","NLTK: Quadratic CPU exhaustion in TreebankWordTokenizer.span_tokenize via list.pop(0) in quote-restore loop","summary","NLTK `TreebankWordTokenizer.span_tokenize` 在处理大量双引号或重复引号时，于引号还原循环中反复调用 O(n) 的 `list.pop(0)`，可触发 O(n^2) CPU 消耗，攻击者无需认证、特殊配置或用户交互即可降低服务可用性。","reason","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-13T21:08:55.000Z","discoveredAt","2026-11-13T21:24:25.466Z","timelineAt","category","vuln","tags",[77,78,79,71],"score",51,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fUu8R6FK7mL8","reportCount",1,"additionalSourceCount",0,{"_68":30,"_70":72},{"_68":69,"_70":71},"slug","exploited","name","在野利用","漏洞披露",{"_74":75,"_13":76},"publicId","2fa0faee-2518-4fdd-b40e-dc4ea28c079b","NLTK分词漏洞重复公告撤回，仍无补丁","漏洞","复现","漏洞利用","https://github.com/advisories/GHSA-ffr9-mgrr-wcvr","GitHub 安全公告",{"_83":84,"_85":-5},"changelogVersion","2026-10-01T08:00","release"]
