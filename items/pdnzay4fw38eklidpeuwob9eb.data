[{"_1":2,"_3":4},"root",{"_5":90},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1794195832000,"id","pdnzay4fw38eklidpeuwob9eb","title","SANS ISC 蜜罐发现针对 sshole 漏洞 CVE-2026-123158 的扫描尝试增加","originalTitle","Scans for Sshole Vulnerability (CVE-2026-123158), (Sun, Nov 8th)","summary","SANS ISC 观察到针对 sshole 漏洞 CVE-2026-123158 的漏洞利用尝试较上周增加。该结论来自运行 Cowrie 的 SSH 蜜罐数据；由于系统只记录 SSH 密码的前 255 个字符，数据范围有限，较长密码也极少用于其通常观察到的密码暴破。","reason","source",{"_72":89},"links",{"_60":88},"publishedAt","2026-11-08T15:44:33.000Z","discoveredAt","2026-11-08T17:04:19.194Z","timelineAt","category","activity","tags",[73,75,86,87],"score",49,"selected",false,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","body",{"_82":-5,"_60":83,"_84":-5,"_85":36},"outline",[],"relatedStories",[78],"topics",[67,68,69],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fnawb3YHok_o","reportCount",1,"additionalSourceCount",0,{"_70":76,"_72":77},{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","attack","name","攻击活动","exploited","在野利用","identity","身份与访问",{"_79":80,"_13":81},"publicId","48f8a01e-6536-4496-9a84-7c563bebb9e7","Sshole漏洞扫描利用增加","zh","<p>Our honeypots use \"Cowrie\" to collect SSH data. With the emergence of the \"sshole\" vulnerability last week, we are now seeing an increase in attempts to exploit the vulnerability. Our data is a bit limited in this respect. Our honeypots collect only the first 255 characters of SSH passwords. Longer passwords are highly unusual and not used for the usual password brute-forcing we observe.</p>","zhKind","complete","漏洞利用","凭据","https://isc.sans.edu/diary/rss/33498","SANS ISC",{"_91":92,"_93":-5},"changelogVersion","2026-10-01T08:00","release"]
