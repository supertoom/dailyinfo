[{"_1":2,"_3":4},"root",{"_5":112},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795480844000,"id","tcrabdy5aroknob52f3barjmz","title","AMD 固件 CVE-2026-43613 可绕过 TPM 锁定并破解 Windows Hello 与 BitLocker PIN","originalTitle","New Attack Bypasses TPM Lockout to Crack Windows Hello and BitLocker PINs in Days, Not Years","summary","Technische Universität Berlin 研究人员演示如何在具备物理访问权限时重置 AMD PC 的固件 TPM 锁定状态，从而猜测 Windows Hello 和 BitLocker PIN；测试中分别在 236 次尝试内找到 4 位与 6 位 PIN，最坏耗时由 69 天降至 40 小时、由 19 年降至 20 天。","reason","原文公开了两种绕过 TPM 锁定计数的实验原理、硬件前提与耗时数据，便于评估短 PIN 风险和处置优先级。","source",{"_75":111},"links",{"_99":110},"publishedAt","2026-11-18T12:28:30.000Z","discoveredAt","2026-11-18T13:43:33.417Z","timelineAt","category","disclosure","tags",[76,103,104,105,106,107,108,109],"score",70,"selected",true,"channel","news","story",{"_86":87,"_13":88},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_61":98,"_99":-5,"_100":101,"_102":37},"outline",[89,90],"relatedStories",[85],"topics",[68,69,70,71,72],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fl76WZ_wyg7E","reportCount",1,"additionalSourceCount",0,{"_73":83,"_75":84},{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","research","name","技术研究","vuln","漏洞披露","crypto","密码学","identity","身份与访问","microsoft","Microsoft / 微软",{"_86":87,"_13":88},"publicId","31190b84-57b1-4e97-9e13-5fca8bc776b7","TU Berlin 演示绕过 AMD 固件 TPM 锁定破解 PIN",{"_11":96,"_92":97,"_94":95},{"_11":91,"_92":93,"_94":95},"sec-2","text","所有者和管理员可以采取的措施","level",3,"sec-1","攻击适用的 PC 以及厂商的说法","<p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgpsv4GxAUbzCsIV1umrxZs6VxfD1eFwAeCgRHQQG_dNbP1fLiYe48hM-Wbd_8w5IxlacAwoidLqyQgBmG7YD7qKo0_XcqW2GhggfXshuK1uXz8BOma2H0Jjs8fabCO4IxHBfRopEUFDd0xHRRv43gMeog852Usv40sfcTwnO_9coyxtIMmteJxeJI_oPA/s1600/bitlocker.jpg\"><img alt=\"\" src=\"/dailyinfo/media/011f04e397570ae0.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>在基于 AMD 的 PC 和部分 Intel PC 上，特朗尼工业大学（Technische Universität Berlin）的研究人员表示，打开 PC 机箱的人可以重置 <strong>Windows Hello</strong> 和 <strong>BitLocker </strong>PIN 的 TPM 锁定。</p><p>这就让短 PIN 面临被猜测的风险。在实验室测试中，研究人员用这种方法在一台 AMD 笔记本电脑上找到了一个四位数 Hello PIN，在一台 Intel 笔记本电脑上找到了一个 6 位 BitLocker PIN。</p><p>两个 PIN 均由研究人员自行设置，并在 236 次尝试内被找到。根据他们测得的速度，他们计算出四位数 Hello PIN 的最坏情况为 40 小时，而在锁定按文档正常工作时则需 69 天。对于默认的六位数 BitLocker PIN，最坏时间从 19 年降至 20 天。</p><p>AMD 昨日确认，其处理器固件存在一个缺陷，可在其部分采用其芯片的 PC 上实现该攻击。该公司计划在 2027 年 11 月至 2027 年 2 月之间为其中大多数芯片提供修复。目前研究人员建议为 Hello 和 BitLocker PIN 至少增加两位数字。</p><p>这些 PC 中的 TPM 是构建在处理器内的固件 TPM。据研究人员上周晚间发布的<a href=\"https://arxiv.org/abs/2611.18126v1\">研究论文</a>，与独立的 TPM 芯片不同，它自身没有安全存储。因此它将保存的状态（包括错误猜测次数）加密后存放在主板的闪存芯片上。</p><p>如果有人复制该保存状态，之后再将旧副本写回，计数也会随之回退，除非 PC 检测到这一情况。较新的 PC 会尝试用闪存芯片内部的计数器来发现这种情况，这些计数器称为 RPMC，只能递增。</p><p>在使用这些计数器的 AMD PC 上，处理器固件从不验证计数器是否真的增加了。一块置于处理器与闪存芯片之间的小板可以阻断更新并报告成功，使 PC 接受旧状态。</p><p>研究人员发现，闪存厂商 Winbond 的 RPMC 芯片存在另一种弱点。芯片电源的短暂下降（称为电压毛刺）可导致芯片泄露用于签署计数器值的密钥。凭借该密钥——用他们的最佳设置提取约需一秒——这块板就能伪造任意计数值。</p><p>在他们测试的 Intel 笔记本电脑上，一次毛刺就足够了：该笔记本的固件在每次启动时都向芯片馈入相同的值，因此泄露的密钥在每次重启后依然有效。</p><p>在 Hello 测试中，研究人员攻击了一台处于锁定状态的 HP OmniBook 3，配备 AMD Ryzen AI 5 330 处理器和 BitLocker 加密的驱动器。他们的装置从 1000 开始输入 PIN，并在 236 次尝试后于 57 分钟内输入到正确的 1235。</p><p>在那台笔记本上，Windows 仍在每次 5 次错误 PIN 尝试后强制重启，但未施加锁定延迟。微软的<a href=\"https://learn.microsoft.com/en-us/windows/security/hardware-security/tpm/tpm-fundamentals\">锁定默认设置</a>会在 32 次错误尝试后锁定 TPM，并且每 10 分钟遗忘一次失败记录。</p><p>BitLocker 测试在一台 Framework Laptop 13 上进行，配备 Intel Core Ultra 5 125H 处理器和 Winbond 闪存。BitLocker 的启动提示本身不设限制，因此每次重置都能获得新的 32 次尝试。该装置在 236 次尝试后于 6 分 55 秒内找到了 PIN 123457。</p><p>在两次测试中，研究人员都从主板上取下闪存芯片，并接入他们自己的板子。一个脚本读取屏幕、输入 PIN，并通过 KVM 切换器重启笔记本。他们还修改了固件设置，以降低每台笔记本与闪存芯片之间的链路速度，因为他们的板子无法跟上全速。</p><p>研究人员还提出了两项其测试未涵盖的进一步主张。这两种方法中的任何一种都可针对任一种 PIN 使用。恢复出的 Hello PIN 还可用于解锁与设备绑定的密钥，并启用基于 Hello 的工作场所单点登录；在某些配置下，还可通过多重因素检查。</p><p>研究人员已经发布了他们的攻击固件、板卡设计和脚本。他们表示，复现 RPMC 攻击并非即插即用，需要使用他们的一块板卡。论文以及目前发布的厂商公告均未描述实验室环境之外的攻击。</p><h3 id=\"sec-1\">攻击适用的 PC 以及厂商的说法</h3><p>攻击是否有效取决于处理器和闪存芯片：</p><ul>\n  <li><strong>配备 RPMC 闪存的 AMD PC：</strong>容易受到会阻止计数器更新的板卡攻击。芯片制造商已确认这是该固件缺陷的根源，并计划予以修复。</li>\n  <li><strong>不配备 RPMC 闪存的 AMD PC：</strong>在研究人员测试的两台 AMD 台式机上，使用普通闪存编程器将旧副本写回即可重置计数，无需板卡。他们得出结论称，AMD 处理器很可能没有针对此问题的其他防护，不过两台台式机未必能代表所有 AMD 系统。</li>\n  <li><strong>依赖 Winbond RPMC 闪存的 PC：</strong>研究人员称，无论使用何种处理器，这些 PC 都容易受到泄露密钥方法的影响，而且只有重新设计芯片才能解决问题。</li>\n  <li><strong>不配备类似 RPMC 闪存的 Intel PC：</strong>在这些测试中，三套 Intel 系统检测到了相同的回写操作。</li>\n</ul><p>研究人员预计，AMD 固件缺陷会影响将 Microsoft Pluton 安全核心用作 TPM 的 AMD PC，但他们没有进行演示。</p><p>以 AMD PC 为例，用户可以启动 Linux，例如从实时 USB 闪存盘启动，并运行研究人员<a href=\"https://github.com/mattifinder/rpmc_attacks\">暴露检查</a>中的命令 grep . /sys/bus/pci/drivers/ccp/*/rpmc_*。输出结果会指示 RPMC 闪存是否存在并已启用，从而告知用户应采用上述两种方法中的哪一种。文件缺失并不代表 PC 不具备 RPMC。</p><p>对于 Intel PC，研究人员不知道有这样的检查方法。用户必须打开 PC，查找标有 25R 或 74M 的 Winbond 芯片。</p><p>AMD 将该缺陷追踪为 CVE-2026-43613，并在昨天发布的<a href=\"https://www.amd.com/en/resources/product-security/bulletin/amd-sb-7079.html\">安全公告</a>中将其 CVSS 分数评为 5.1。</p><p>芯片制造商表示，需要物理访问权限的攻击不在其产品安全威胁模型范围内，但同时指出，“RPMC 的设计目的正是阻止这种类型的中介器攻击。”研究人员于 2 月首次向其告知该缺陷。</p><p>芯片制造商的修复计划覆盖从 11 月到 2027 年 2 月期间的 Ryzen、Ryzen AI、Ryzen Threadripper、Athlon 和 EPYC 芯片，另有一款未指明名称的产品尚未确定日期。这些是其自身固件的计划发布日期，并非已经为 PC 推出的更新。</p><p>该公告未涵盖不配备 RPMC 闪存的 AMD PC，也没有说明该更新是否会阻止攻击者在 PC 上安装较旧且未修复的固件；研究人员称，修复措施必须能够阻止这一点。</p><p>Intel 的处理器被用于 BitLocker 测试笔记本电脑。该公司在本周早些时候发布的<a href=\"https://www.intel.com/content/www/us/en/security-center/announcement/intel-security-announcement-2026-11-16-001.html\">安全公告</a>中表示，这项研究“没有证明 Intel 组件中存在漏洞”。这与测试结果相符，因为在针对 Intel 笔记本电脑的攻击中，需要利用 Winbond 芯片的缺陷。</p><p>据研究人员称，Intel 安全团队将重复使用的值称为弱点，而非漏洞。</p><p>研究人员于 4 月告知了 Microsoft。据他们称，该公司将 Windows Hello 报告评为“中度严重性”，低于立即修复的门槛，既未发布 CVE，也未提供赏金，并承诺将其建议的 Hello PIN 最小长度提高到六位数字。</p><p>应公司要求，研究人员将 BitLocker 发现作为单独报告提交给另一个团队。该公司拒绝为论文再向他们提供任何书面声明。</p><p>另外，上周末发布的一个 Windows 11 测试版本将个人账户 Hello PIN 的最小长度设为六位数字，同时提供使用四位数字的选项。<a href=\"https://learn.microsoft.com/en-us/windows-insider/release-notes/experimental-future-platforms/preview-build-29708-1003\">发布说明</a>未给出原因，而该测试通道中的功能可能永远不会进入正式版本。</p><p>据研究人员称，Winbond 于 2025 年 1 月首次获知其芯片容易受到电压毛刺攻击，并在 4 月收到第二份报告，显示毛刺还会泄露密钥。这家闪存制造商正在研究该问题，可能会采用新的芯片设计，但尚未承诺修复方案或修复日期。</p><h3 id=\"sec-2\">所有者和管理员可以采取的措施</h3><p>根据研究人员的数据，多两位数字会带来巨大差异：</p><table>\n  <caption>破解数字 PIN 所需的最长时间</caption>\n  <tbody>\n       <tr>\n      <th>PIN 长度</th>\n      <th>有记录的锁定机制</th>\n      <th>Hello 攻击（AMD 笔记本）</th>\n      <th>BitLocker 攻击（Intel 笔记本）</th>\n    </tr>\n    <tr>\n      <th>4 位数字</th>\n      <td>69 天</td>\n      <td>40 小时</td>\n      <td>5 小时*</td>\n    </tr>\n    <tr>\n      <th>6 位数字</th>\n      <td>19 年</td>\n      <td>168 天</td>\n      <td>20 天</td>\n    </tr>\n    <tr>\n      <th>8 位数字</th>\n      <td>1,903 年</td>\n      <td>46 年</td>\n      <td>6 年</td>\n    </tr>\n  </tbody>\n</table><p>* <i>只有在管理员将六位数字的最低长度降低时，BitLocker 才接受四位 PIN。这些时间是根据分别在两台笔记本上测得的速度计算出的最坏情况。</i></p><p>5 月，Microsoft 建议将 BitLocker 从仅使用 TPM 改为使用 TPM+PIN，以阻止 YellowKey 绕过；这是其<a href=\"https://thehackernews.com/2026/05/microsoft-releases-mitigation-for.html\">YellowKey 缓解措施</a>的一部分。同一套 TPM 锁定机制也保护 PIN。</p><p>各种设置的步骤：</p><ul>\n  <li><strong>Windows Hello for Business：</strong>提高<em>Minimum PIN length</em>策略，其路径为 Computer Configuration &gt; Administrative Templates &gt; System &gt; PIN Complexity。如果未设置该策略，Windows 要求使用六位数字，即上表中最长需要 168 天，而管理员可以将其设置低至四位。<a href=\"https://learn.microsoft.com/en-us/windows/security/identity-protection/hello-for-business/policy-settings\">PIN 策略设置</a>页面在 PIN 设置选项卡中列出了该策略。</li>\n  <li><strong>BitLocker：</strong>提高<em>Configure minimum PIN length for startup</em>策略，该策略允许使用 4 到 20 位数字，默认要求六位数字。启用<em>“Allow enhanced PINs for startup”</em>后可以使用字母和符号，<a href=\"https://learn.microsoft.com/en-us/windows/security/operating-system-security/data-protection/bitlocker/faq\">BitLocker PIN 指南</a>建议较旧硬件采用这种方式。</li>\n  <li><strong>基于 AMD 的 PC：</strong>当芯片制造商为你的 PC 提供修复固件更新时，请进行安装。在此之前，芯片制造商建议对 PC 保持物理控制，并留意被篡改的迹象。</li>\n  <li><strong>依赖 Winbond RPMC 闪存的 PC：</strong>据研究人员称，这家闪存制造商尚未承诺提供修复。Intel 建议其客户向 PC 制造商咨询更新。</li>\n</ul><p>觉得这篇文章有意思吗？关注我们在 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a> 上的动态，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","漏洞分析","利用链","复现","凭据","加密","Microsoft","CISA","https://thehackernews.com/2026/11/flash-chip-attack-bypasses-tpm-lockout.html","The Hacker News",{"_113":114,"_115":-5},"changelogVersion","2026-10-01T08:00","release"]
