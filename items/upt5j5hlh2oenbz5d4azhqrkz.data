[{"_1":2,"_3":4},"root",{"_5":90},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795653650000,"id","upt5j5hlh2oenbz5d4azhqrkz","title","OpenAI 与 Cisco 的 Shirudo 探索自防御系统架构：运行时 eBPF 控制","originalTitle","The Architecture of Self-Defending Systems","summary","OpenAI 与 Cisco 的 Shirudo 项目探索自防御系统，通过运行时 eBPF 控制，让智能体能够生成、验证、签名并应用控制措施，且无需关闭主机。其目标是以机器速度作出响应并保持服务持续运行，核心理念是避免策略执行与业务运行发生冲突。","reason","source",{"_72":89},"links",{"_61":88},"publishedAt","2026-11-25T22:30:21.000Z","discoveredAt","2026-11-25T23:28:20.475Z","timelineAt","category","ai-security","tags",[73,86,75,87],"score",35,"selected",false,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","Horizon3","body",{"_82":-5,"_61":83,"_84":-5,"_85":36},"outline",[],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fgUHY6mygcoU","reportCount",1,"additionalSourceCount",0,{"_71":76,"_72":77},{"_71":74,"_72":75},{"_71":30,"_72":73},"slug","name","AI 安全","ai-offense","AI 攻防","cisco","Cisco / 思科",{"_79":80,"_13":81},"publicId","5ebdd4b0-ce16-4256-a361-735996b6a6c7","OpenAI与Cisco开源Shirudo临时防护工具","zh","<p>We are entering the era of self-defending systems. OpenAI and Cisco’s Shirudo work is an important early signal of what that looks like in practice: runtime eBPF controls that agents can generate, validate, sign, and apply without taking the host down. It is a concrete step toward infrastructure that can react at machine speed while services stay up. The right mental model is collision avoidance…</p><p><a href=\"https://horizon3.ai/intelligence/blogs/architecture-of-self-defending-systemsm/\">Source</a></p>","zhKind","complete","Agent 安全","Cisco","https://horizon3.ai/intelligence/blogs/architecture-of-self-defending-systemsm/","Horizon3.ai",{"_91":92,"_93":-5},"changelogVersion","2026-10-01T08:00","release"]
