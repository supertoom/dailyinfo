[{"_1":2,"_3":4},"root",{"_5":96},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795308033000,"id","en85jqoawywbih6ciysura11w","title","Apple iOS 麦克风权限绕过漏洞 CVE-2026-65339 技术分析","originalTitle","Researchers Detail iPhone Flaw That Let Apps Record Audio Despite Denied Microphone Permission","summary","研究人员披露 Apple 音频服务漏洞 CVE-2026-65339 的技术细节，应用可在用户拒绝麦克风权限后继续录音，部分测试版本的橙色麦克风指示灯不会亮起。","reason","文章拆解了音频服务绕过 TCC 权限检查的原理、复现环境与补丁机制，适合移动端安全研究人员参考。","source",{"_74":95},"links",{"_87":94},"publishedAt","2026-11-17T12:14:36.000Z","discoveredAt","2026-11-17T13:06:32.310Z","timelineAt","category","disclosure","tags",[91,92,79,93],"score",73,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_61":86,"_87":-5,"_88":89,"_90":37},"outline",[],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fD2kpW4M6T2E","reportCount",1,"additionalSourceCount",0,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","research","name","技术研究","vuln","漏洞披露","mobile","移动端","apple","Apple / 苹果",{"_83":84,"_13":85},"publicId","03c02d4b-0991-4dc2-bb94-a4a2d12ebadc","iOS录音权限绕过细节公开","<p><span><i></i><span>Swati Khandelwal</span><i></i><span>2026年11月17日</span></span><span>漏洞 / 移动安全</span></p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjoRknesoqi26EwwYMrgBhBudDMiej0sO7-228OvrBIj2ivaPcOUo7GJgoIHAd9fI_VFlK4su0xn1L_BqUgFsldNJgAkQwE4wAvAZzUao-wHUHSoq8NQUo_UdyILYYFoshEgONLhibaGHRQ_cKFVo0Psl1kehyphenhyphenNjlCrkECk16huiU6WecKlpBr0YDN3nus/s1600/iphone-recording.jpg\"><img alt=\"\" src=\"/dailyinfo/media/722068fcf6f94fe6.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>苹果音频服务中一个现已修补的漏洞，曾使 iPhone 和 iPad 上的应用在用户点击麦克风提示中的“拒绝”之后仍能录音。</p><p>首批包含该修复的安全更新于 8 月 17 日发布。苹果以及发现该漏洞的两名研究人员均未报告称其已被用于攻击。</p><p>Meta Red Team X 的 Nik Tsytsarkin 于上周公布了技术细节。<b>Mustafa Calap</b>是一名安全工程师，他也独立发现了同一漏洞，并在同一天发表了自己的分析。</p><p>在 iPhone 上，当应用使用麦克风时会显示橙色指示器。在研究人员早期使用的一个测试版本中，该指示器在应用录音期间始终未亮起。</p><p>在 Tsytsarkin 的测试中，提示会在应用首次打开时出现。拒绝该提示并不会停止录音，而且后续启动时提示也不会再次出现。</p><p>在其<a href=\"https://rtx.meta.security/exploitation/2026/11/09/CVE-2026-65339.html\">技术分析</a>的早期版本中，系统日志没有显示该应用使用麦克风的记录。他们将音频服务本身列为录音来源。</p><p>他的演示视频显示，在测试应用未获得麦克风权限进行录音时，指示器仍然亮起。他写道，该视频“是在之后的版本上拍摄的，该版本似乎恢复了橙色麦克风指示器。”</p><p>据 Calap 的<a href=\"https://dbg.re/posts/cve-2026-65339-audiomxd-microphone-permission-bypass/\">详细说明</a>介绍，他的测试应用在权限仍显示为拒绝的情况下进行了录音。灵动岛和控制中心中均未出现橙色指示器。他没有说明这是他的两个测试版本中的哪一个。</p><p>两名研究人员都没有描述在修复前用户可如何检查应用是否曾对自己录音。Calap 在 7 月 27 日发布的 iOS 26.6 以及 iPadOS 27 的测试版上复现了这一绕过行为。</p><p>该绕过需要设备上已安装的应用。他的两个测试应用均为沙盒应用，没有添加任何 entitlement。其唯一的隐私权限键为 NSMicrophoneUsageDescription，用于显示麦克风提示。</p><p>在他的测试中，录音必须在应用处于前台时启动。一旦启动，即使应用进入后台或设备锁定，录音仍会继续。后台版本还设置了 UIBackgroundModes = audio。</p><p>两个应用均通过 Xcode 安装，从未经过 App Review。因此，这些测试无法说明 App Review 是否会阻止此类应用。</p><p>Meta 的分析比较了两个 iOS 27 测试版本。两名研究人员均未报告测试 macOS、tvOS、watchOS 或 visionOS，尽管这些系统也列出了修复。</p><p>该绕过仅涵盖通过音频服务进行的麦克风采集，不会赋予应用其他隐私权限。</p><p>以下版本修复了该漏洞，该漏洞编号为 CVE-2026-65339：</p><ul>\n  <li><a href=\"https://support.apple.com/en-us/148282\">iOS 26.6.1</a> 和 iPadOS 26.6.1（8 月 17 日），适用于 iPhone 11 及更新机型、iPad Pro 12.9 英寸第 3 代及更新机型、iPad Pro 11 英寸第 1 代及更新机型、iPad Air 第 3 代及更新机型、iPad 第 8 代及更新机型，以及 iPad mini 第 5 代及更新机型</li>\n  <li><a href=\"https://support.apple.com/en-us/149225\">iOS 18.7.11</a> 和 iPadOS 18.7.11（10 月 26 日），适用于 iPhone XS、iPhone XS Max、iPhone XR 和 iPad 第 7 代</li>\n  <li><a href=\"https://support.apple.com/en-us/148281\">macOS Tahoe 26.6.2</a>（8 月 17 日）</li>\n  <li><a href=\"https://support.apple.com/en-us/149043\">macOS Sequoia 15.8</a>（9 月 14 日）</li>\n  <li><a href=\"https://support.apple.com/en-us/149036\">tvOS 27</a>（9 月 14 日），适用于 Apple TV 4K 第 2 代及更新机型</li>\n  <li><a href=\"https://support.apple.com/en-us/149037\">watchOS 27</a>（9 月 14 日），适用于 Apple Watch Series 9 及更新机型</li>\n  <li><a href=\"https://support.apple.com/en-us/149038\">visionOS 27</a>（9 月 14 日），适用于 Apple Vision Pro（所有型号）</li>\n</ul><p>研究人员没有描述任何能够阻止该绕过攻击的设置，因此安装这些更新就是修复方法。</p><p><a href=\"https://support.apple.com/en-us/149034\">iOS 27 说明</a>未列出该缺陷，截至今天，后续 iOS 27 更新的说明中也未列出。Meta 的时间线称，修复已随 8 月 10 日发布的 iOS 27.0 beta 5 推出。</p><p>CISA 给该缺陷的 CVSS 评分为 5.0/10。截至该目录上周晚些时候更新时，该机构的已知被利用漏洞目录尚未将其列入。</p><p>Apple 对 8 月 17 日更新的说明仅将该缺陷描述为可能让应用泄露用户敏感信息。</p><p>Tsytsarkin 写道：“该描述遗漏了最引人注目的部分：在权限被拒绝后，应用仍可进行录制，而且不会出现橙色指示器。”</p><p>在他自己的测试中，只有较早期的构建版本缺少该指示器。应用本身无权决定是否可以录制。该决定由透明度、同意与控制（Transparency, Consent, and Control，TCC）系统作出，该系统会检查是哪个进程提出了请求。</p><p>这个名为 <strong>audiomxd</strong> 的音频服务接受了应用自行提供的关于请求进程的信息。审计令牌用于标识进程。应用可以向该服务发送一个将 audiomxd 自身列为名称的令牌。</p><p>随后，该服务便将应用视为自身。它采取了一条原本用于自身内部音频的快捷路径，在未经 TCC 询问的情况下允许录制。内核本身向该应用提供了冒充该服务所需的信息。</p><p>此次修复使该服务能够检查真实调用者的身份，而该身份由内核提供。现在，外部调用者必须拥有私有权限 com.apple.private.audio.client-audit-token-override，才能替换该服务所依赖的客户端身份。应用无法自行授予自身该权限。</p><p>觉得这篇文章有意思？欢迎在 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a> 上关注我们，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","漏洞分析","复现","Apple","https://thehackernews.com/2026/11/researchers-detail-iphone-flaw-that-let.html","The Hacker News",{"_97":98,"_99":-5},"changelogVersion","2026-10-01T08:00","release"]
