[{"_1":2,"_3":4},"root",{"_5":101},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1795912855000,"id","yza1u66v1420kn21mvz063ur5","title","FreeRADIUS 多个漏洞影响 3.0.29 与 3.2.11 之前版本","originalTitle","Multiples vulnérabilités dans FreeRADIUS (27 novembre 2026)","summary","FreeRADIUS 3.2.x 中低于 3.2.11 的版本，以及低于 3.0.29 的版本受到多个漏洞影响。部分漏洞可导致远程任意代码执行、远程拒绝服务和数据机密性受损，另有绕过安全策略的风险；CERT-FR 未指明具体漏洞类型，修复情况需参考厂商 2026 年 11 月 25 日发布的安全公告。","reason","source",{"_62":100},"links",{"_58":99},"publishedAt","2026-11-27T00:00:00.000Z","discoveredAt","2026-11-27T14:52:21.387Z","timelineAt","category","vuln","tags",[97,98,65],"score",63,"selected",false,"channel","news","story","x","readingMode","full","author","body",{"_93":-5,"_58":94,"_95":-5,"_96":36},"outline",[66,67,68,69,70,71,72,73],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":64,"_62":65},{"_61":30,"_62":63},"slug","name","漏洞披露","vuln-mgmt","漏洞管理",{"_11":91,"_75":92,"_77":78},{"_11":89,"_75":90,"_77":78},{"_11":87,"_75":88,"_77":78},{"_11":85,"_75":86,"_77":78},{"_11":83,"_75":84,"_77":78},{"_11":81,"_75":82,"_77":78},{"_11":79,"_75":80,"_77":78},{"_11":74,"_75":76,"_77":78},"sec-8","text","Gestion détaillée du document","level",2,"sec-7","Documentation","sec-6","Solutions","sec-5","Résumé","sec-4","Systèmes affectés","sec-3","Risques","sec-2","Gestion du document","sec-1","Avis du CERT-FR","zh","<h2 id=\"sec-1\">Avis du CERT-FR</h2><p>Objet : Multiples vulnérabilités dans FreeRADIUS</p><h2 id=\"sec-2\">Gestion du document</h2><table>\n      <tbody>\n        <tr>\n          <th>Référence</th>\n          <td>CERTFR-2026-AVI-1632</td>\n        </tr>\n        <tr>\n          <th>Titre</th>\n          <td>Multiples vulnérabilités dans FreeRADIUS</td>\n        </tr><tr>\n            <th>Date de la première version</th><td>27 novembre 2026</td>\n          </tr>\n          <tr>\n            <th>Date de la dernière version</th><td>27 novembre 2026</td>\n          </tr><tr>\n          <th>Source(s)</th>\n          <td>Bulletin de sécurité FreeRadius security du 25 novembre 2026<br></td>\n        </tr>\n      </tbody>\n    </table><p>Une gestion de version détaillée se trouve à la fin de ce document.</p><h2 id=\"sec-3\">Risques</h2><ul>\n          \n            <li>Atteinte à la confidentialité des données</li>\n          \n            <li>Contournement de la politique de sécurité</li>\n          \n            <li>Déni de service à distance</li>\n          \n            <li>Exécution de code arbitraire à distance</li>\n          \n            <li>Non spécifié par l'éditeur</li>\n          \n        </ul><h2 id=\"sec-4\">Systèmes affectés</h2><ul>\n          \n            <li>FreeRADIUS versions 3.2.x antérieures à 3.2.11</li>\n          \n            <li>FreeRADIUS versions antérieures à 3.0.29</li>\n          \n        </ul><h2 id=\"sec-5\">Résumé</h2><p>De multiples vulnérabilités ont été découvertes dans FreeRADIUS. Certaines d'entre elles permettent à un attaquant de provoquer une exécution de code arbitraire à distance, un déni de service à distance et une atteinte à la confidentialité des données.</p><h2 id=\"sec-6\">Solutions</h2><p>Se référer au bulletin de sécurité de l'éditeur pour l'obtention des correctifs (cf. section Documentation).</p><h2 id=\"sec-7\">Documentation</h2><ul>\n          \n          \n            <li>\n              <p>Bulletin de sécurité FreeRadius security du 25 novembre 2026</p>\n              <a href=\"https://freeradius.org/security/\">https://freeradius.org/security/</a>\n            </li>\n          \n\n          \n          \n\n          \n        </ul><h2 id=\"sec-8\">Gestion détaillée du document</h2><table>\n          <thead>\n            <tr>\n              <th>Date</th>\n              <th>Description</th>\n            </tr>\n          </thead>\n          <tbody><tr>\n              <td>27 novembre 2026</td>\n              <td>Version initiale</td>\n            </tr></tbody>\n        </table>","zhKind","complete","漏洞","补丁","https://www.cert.cyber.gouv.fr/avis/CERTFR-2026-AVI-1632/","CERT-FR",{"_102":103,"_104":-5},"changelogVersion","2026-10-01T08:00","release"]
