[{"_1":2,"_3":4},"root",{"_5":92},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795740042000,"id","nhx83jvk238i041bf7tt09eqs","title","GeoServer 未认证远程代码执行漏洞链 CVE-2026-129242 等已复现","originalTitle","【已复现】GeoServer未认证远程代码执行漏洞（CVE 链）安全风险通告","summary","GeoServer 未认证远程代码执行漏洞链涉及 CVE-2026-129244、CVE-2026-129243、CVE-2026-120705、CVE-2026-129245 和 CVE-2026-129242，奇安信 CERT 已复现，PoC 和技术细节均已公开。","reason","原文披露了完整利用链、受影响版本和补丁状态，并给出可执行的临时缓解措施，适合用于评估 GeoServer 暴露风险与处置优先级。","source",{"_73":91},"links",{"_83":90},"publishedAt","2026-11-24T18:56:00.000Z","discoveredAt","2026-11-25T10:12:37.590Z","timelineAt","category","vuln","tags",[86,87,88,89,74,77],"score",85,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","body",{"_61":82,"_83":-5,"_84":83,"_85":37},"outline",[],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fsk1W6sVk-3I","reportCount",3,"additionalSourceCount",2,{"_71":76,"_73":77},{"_71":31,"_73":75},{"_71":72,"_73":74},"slug","exploited","name","在野利用","漏洞披露","qianxin","奇安信",{"_79":80,"_13":81},"publicId","f6003043-ce60-438d-9a23-a8338172530e","GeoServer未认证RCE链已复现并出现利用探测","<p><span>奇安信 CERT</span> <span>2026-11-25 02:56</span> <span>江苏</span></p><p><img src=\"/dailyinfo/media/6e5eb7e7bb189607.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>致力于第一时间为企业级用户提供权威漏洞情报和有效解决方案。</p><p><span><span>●&nbsp;</span></span><span><span>点击↑蓝字关注我们，获取更多安全风险通告</span></span></p><hr><table><tbody><tr><td colspan=\"4\" align=\"center\"><p><span><strong><span><span>漏洞概述</span></span></strong></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>漏洞名称</span></span></strong></span></p></td><td colspan=\"3\" align=\"left\"><span><span>GeoServer&nbsp;</span></span><span><span>未认证远程代码执行漏洞（</span></span><span><span>CVE&nbsp;</span></span><span><span>链）</span></span></td></tr><tr><td align=\"left\"><p><span><span><strong><span>漏洞编号</span></strong></span></span></p></td><td colspan=\"3\" align=\"left\"><p><span>CVE-2026-129242 &nbsp; QVD-2026-116043</span></p><p><span>CVE-2026-129244 &nbsp; QVD-2026-115948</span></p><p><span>CVE-2026-129243 &nbsp; QVD-2026-116031</span></p><p><span>CVE-2026-120705 &nbsp; QVD-2026-116042</span></p><p><span>CVE-2026-129245 &nbsp; QVD-2026-116059</span></p></td></tr><tr><td align=\"left\"><p><strong><span><strong><span><span>公开时间</span></span></strong></span></strong></p></td><td align=\"left\"><p><span><span>2026-11-24</span></span></p></td><td align=\"left\"><p><strong><span><strong><span><span>影响量级</span></span></strong></span></strong></p></td><td align=\"left\"><p><span><span>万级</span></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>奇安信评级</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>高危</span></span></strong></span></p></td><td align=\"left\"><p><strong><span><span>CVSS 3.1分数</span></span></strong></p></td><td align=\"left\"><p><span><span><strong><span>9.8</span></strong></span></span></p><p><span><span><strong><span>(完整利用链)</span></strong></span></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span>威胁类型</span></strong></span></p></td><td align=\"left\"><p><span><span><span>代码执行</span></span></span></p></td><td align=\"left\"><p><strong><span><span>利用可能性</span></span></strong></p></td><td align=\"left\"><p><strong><span><strong><span>高</span></strong></span></strong></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>POC状态</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>已公开</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>在野利用状态</span></span></strong></span></p></td><td align=\"left\"><p><span><span><span>未发现</span></span></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>EXP状态</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span><span>已公开</span></span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>技术细节状态</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span><span>已公开</span></span></span></strong></span></p></td></tr><tr><td colspan=\"4\" align=\"left\"><p><strong><span><span>危害描述：</span><span><span>成功利用该漏洞链可导致GeoServer数据目录及安全配置泄露、管理员口令摘要被获取、管理员会话被伪造，攻击者可进一步篡改服务配置、未授权访问业务数据，并以GeoServer进程权限执行任意命令；若容器以root运行，还可能突破应用边界，造成主机失陷和横向移动风险。</span></span></span></strong></p></td></tr></tbody></table><p><strong><span>0</span></strong><strong><span>1</span></strong></p><p><strong><span>漏洞详情</span></strong></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>影响组件</span></span></strong></p><p><span><span>GeoServer&nbsp;</span></span><span>是</span><span><span>&nbsp;OSGeo&nbsp;</span></span><span>维护的</span><span><span>&nbsp;Java&nbsp;</span></span><span>地理空间服务端，按照</span><span><span>&nbsp;OGC&nbsp;</span></span><span>规范对外提供</span><span><span>&nbsp;WMS</span></span><span>、</span><span><span>WFS</span></span><span>、</span><span><span>WCS&nbsp;</span></span><span>等空间数据服务，常见于政务、测绘、自然资源及行业</span><span><span>&nbsp;GIS&nbsp;</span></span><span>平台的数据发布环节。其部署形态通常由</span><span><span>&nbsp;Web&nbsp;</span></span><span>管理台、</span><span><span>REST&nbsp;</span></span><span>管理接口、插件体系及本地</span><span><span>&nbsp;data_dir&nbsp;</span></span><span>数据目录组成；默认安全配置启用了&nbsp;remember-me&nbsp;自动登录，发行包提供&nbsp;JDBC&nbsp;用户/角色服务实现；该服务默认未注册，攻击者取得管理员会话后可通过&nbsp;REST&nbsp;接口注册并利用。</span></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>漏洞描述</span></span></strong></p><p><span><span>近日，奇安信</span></span><span><span>CERT</span></span><span>监测到</span><span><span><span>GeoServer&nbsp;</span></span></span><span><span>未认证远程代码执行漏洞（</span></span><span><span><span>CVE&nbsp;</span></span></span><span><span>链）</span></span><span>，涉及</span><span><span>CVE-2026-129244</span></span><span>、</span><span><span>CVE-2026-129243</span></span><span>、</span><span><span>CVE-2026-120705</span></span><span>、</span><span><span>CVE-2026-129245</span></span><span>和</span><span><span>CVE-2026-129242</span></span><span>。攻击者可在未认证状态下先获取数据目录位置，再利用</span><span><span>WFS</span></span><span>服务名解析与授权规则不一致写入存储查询，借助</span><span><span>XInclude</span></span><span>解析读取安全配置文件，继而利用固定默认密钥构造管理员会话，最终通过管理员</span><span><span>REST</span></span><span>接口注册恶意</span><span><span>JDBC</span></span><span>用户服务并触发反序列化，实现任意命令执行。上述缺陷单独存在时，分别表现为路径信息泄露、访问控制绕过、本地文件读取、会话伪造及反序列化执行；其实际风险在于默认配置允许这些缺陷被同一攻击序列连续利用。尤其需要关注的是，</span><span><span>JDBC</span></span><span>用户服务本身要求管理员权限才能投递数据，而固定</span><span><span>remember-me</span></span><span>密钥恰好提供了伪造管理员会话的通道，使该执行入口在未认证条件下被实际打开。因此，仅修复其中任一环节虽可提高利用门槛，但不足以从整体上消除该组合利用风险。</span><span><span>目前该漏洞PoC和技术细节已公开。</span></span><span><span>鉴于该漏洞影响范围较大，建议客户尽快做好自查及防护。</span></span></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>利用条件</span></span></strong></p><p><span><span>无需认证；默认配置；网络可达</span></span><span><span>&nbsp;WFS&nbsp;</span></span><span>与</span><span><span>&nbsp;REST&nbsp;</span></span><span>接口。</span></p><p><strong><span>02</span></strong></p><p><strong><span>影响范围</span></strong></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>影响版本</span></span></strong></p><p><span><span>GeoServer &lt;= 2.27.6</span></span><span>；</span></p><p><span><span>2.28.0 &lt;= GeoServer &lt;= 2.28.5</span></span><span>；</span></p><p><span><span>3.0.0 &lt;= GeoServer &lt;= 3.0.1</span></span></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>其他受影响组件</span></span></strong></p><p><span><span>无</span></span></p><p><strong><span>03</span></strong></p><p><strong><span>复现情况</span></strong></p><p><span><span>目前，</span><span>奇安信CERT已成功复现<span>GeoServer 未认证远程代码执行漏洞（CVE 链）</span>，截图如下：</span></span></p><p><img src=\"/dailyinfo/media/24898829655c3e2d.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>04</span></strong></p><p><strong><span>受影响资产情况</span></strong></p><p><span><span>奇安信鹰图资产测绘平台数据显示，</span><span><span><span>GeoServer 未认证远程代码执行漏洞（CVE 链）</span></span></span><span><span>关联的国内风险资产总数为</span></span><span><span>3852</span></span><span><span>个，</span></span><span><span>关联</span></span><span><span>IP</span></span><span><span>总数为345</span></span><span><span>个</span></span><span>。</span><span>国内风险资产分布情况如下：</span></span></p><p><img src=\"/dailyinfo/media/72a753c5a6420048.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span><span>GeoServer 未认证远程代码执行漏洞（CVE 链）</span>关联的全球风险资产总数为</span><span><span><span>18412</span></span><span><span>个，</span></span><span><span>关联</span></span><span><span>IP</span></span><span><span>总数为</span></span><span><span>1536</span></span><span><span>个。</span></span><span>全球风险资产分布情况如下：</span></span></span></p><p><img src=\"/dailyinfo/media/cdd8ef44049cbef0.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>05</span></strong></p><p><strong><span>处置建议</span></strong></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>安全更新</span></span></strong></p><p><span>官方已发布安全补丁，请及时更新至最新版本：</span></p><p><span>GeoServer 3.0.2、2.28.6、2.27.7 及对应分支的更高版本</span></p><p><span>下载地址：</span></p><p><span><a href=\"https://geoserver.org/download/\">https://geoserver.org/download/</a></span></p><p><span><span>临时缓解措施：</span></span></p><p><span>1</span><span>、在反向代理或</span><span><span>WAF</span></span><span>侧限制对</span><span><span>/geoserver/wfs</span></span><span>与</span><span><span>/geoserver/rest</span></span><span>的匿名访问；</span></p><p><span>2</span><span>、阻断</span><span><span>service=x/WFS</span></span><span>、超长</span><span><span>storedQuery_id</span></span><span>、</span><span><span>XInclude/file://</span></span><span>关键字及异常</span><span><span>remember-me Cookie</span></span><span>；</span></p><p><span>3</span><span>、修改默认</span><span><span>remember-me</span></span><span>密钥并轮换管理员口令；</span></p><p><span>4</span><span>、禁用或限制</span><span><span>JDBC</span></span><span>用户</span><span><span>/</span></span><span>角色服务；</span></p><p><span>5、以非root用户运行GeoServer，限制数据目录写权限。</span></p><p><span>上述措施只能降低利用成功率，无法替代升级。</span></p><p><strong><span>06</span></strong></p><p><strong><span>参考资料</span></strong></p><p><span><span>[1]</span><span><span><a href=\"https://cryptocat.me/blog/research/analysis/geoserver_preauth_rce/#summary\">https://cryptocat.me/blog/research/analysis/geoserver_preauth_rce/#summary</a></span></span></span></p><p><span><span>[2]</span><span><span><a href=\"https://github.com/geoserver/geoserver/security/advisories\">https://github.com/geoserver/geoserver/security/advisories</a></span></span></span></p><p><strong><span>07</span></strong></p><p><strong><span>时间线</span></strong></p><p><span><span>2026年11月25日，奇安信 CERT发布安全风险通告。</span></span></p><p><strong><span>08</span></strong></p><p><strong><span>漏洞情报服务</span></strong></p><p><span><span>「</span><span>奇安信漏洞情报平台</span><span>」</span><span>重磅上线，诚邀您来体验：</span></span></p><p><img alt=\"图片\" src=\"/dailyinfo/media/f485bed36a70ce28.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img alt=\"图片\" src=\"/dailyinfo/media/935642ab5d417fa5.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img alt=\"图片\" title=\"CERT LOGO.png\" width=\"100%\" src=\"/dailyinfo/media/b452a778985296b8.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><strong><span>奇安信 CERT</span></strong></span></p><p><span><strong><span><span>致力于</span></span></strong><span><span>第一时间为企业级用户提供</span><strong><span><span>权威</span></span></strong><span>漏洞情报和</span></span><strong><span><span>有效</span></span></strong><span><span>解决方案。</span></span></span></p><p><span><span><span>点击↓</span><strong><span><span>阅读原文</span></span></strong><span>，到</span></span><strong><span><span>ALPHA威胁分析平台</span></span></strong><span><span>订阅更多漏洞信息。</span></span></span></p><p><a href=\"https://ti.qianxin.com/portal/subscription\">阅读原文</a></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=7fb2d9db&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzU5NDgxODU1MQ%3D%3D%26mid%3D2247508259%26idx%3D1%26sn%3D33a6c21c2746e38d682fa7972dea6c4d\">跳转微信打开</a></p>","original","zhKind","complete","漏洞","复现","漏洞利用","补丁","https://mp.weixin.qq.com/s?__biz=MzU5NDgxODU1MQ==&mid=2247508259&idx=1&sn=33a6c21c2746e38d682fa7972dea6c4d","奇安信 CERT",{"_93":94,"_95":-5},"changelogVersion","2026-10-01T08:00","release"]
