[{"_1":2,"_3":4},"root",{"_5":95},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795912840000,"id","kcwxcgi3mbarz9m115ch1kn3v","title","Mitel MiCollab 5 个零日漏洞遭在野利用，CISA 已将其纳入 KEV","originalTitle","Mitel MiCollab Zero-Days Exploited in Suspected AI-Assisted Attacks","summary","Mitel MiCollab 5 个漏洞已被用于数据窃取和可能的勒索活动，CISA 将其纳入 KEV，其中 4 个要求联邦机构在 11 月 28 日前处置，另 1 个截止日期为 12 月 9 日。","reason","文章还原了攻击者从 MiCollab 漏洞入侵到身份基础设施的完整路径，并给出补丁时间线与处置期限。","source",{"_74":94},"links",{"_87":93},"publishedAt","2026-11-26T11:35:25.000Z","discoveredAt","2026-11-26T12:23:19.187Z","timelineAt","category","activity","tags",[77,92,75,79,81],"score",85,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Eduard Kovacs","body",{"_61":86,"_87":-5,"_88":89,"_90":91},"outline",[],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fLEMRYk7l9S8","reportCount",1,"additionalSourceCount",0,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","attack","name","攻击活动","exploited","在野利用","ai-offense","AI 攻防","cisa","CISA",{"_83":84,"_13":85},"publicId","dca3c44e-e746-4752-bdd0-99f5f3c264e6","Accenture披露Mitel五漏洞遭在野利用","<p><strong>Threat actors exploited several Mitel MiCollab vulnerabilities as zero-days in a data theft campaign, according to Accenture’s Apex Labs. CISA on Wednesday added five MiCollab flaws to its Known Exploited Vulnerabilities (KEV) catalog.&nbsp;</strong>\n\n\n\n</p><p>In one attack observed by Accenture, hackers gained privileged access to a MiCollab server and quickly reached the targeted organization’s identity infrastructure, ultimately stealing sensitive business information.\n\n\n\n</p><p>The MiCollab business collaboration platform enables employees to communicate through calls, messages, and virtual meetings. Accenture noted that the product’s frequent internet exposure and integration with Active Directory make it particularly attractive to hackers.\n\n\n\n</p><p>Mitel on November 16 announced patches for five vulnerabilities affecting the product’s audio, web and video conferencing component, including arbitrary file upload, XML injection, unauthorized access, command injection, and authentication bypass. They can all be exploited by unauthenticated attackers, and two critical bugs allow arbitrary command execution.&nbsp;\n\n\n\n</p><p>The security holes are tracked as CVE-2026-133275, CVE-2026-133303, CVE-2026-133311, CVE-2026-133323, and CVE-2026-133324.\n\n\n\n</p><p>Accenture found evidence that the vulnerabilities were exploited in the wild before Mitel published its advisory. The company determined that threat actors deployed a web shell on a victim’s systems on November 15.</p><p><span>Advertisement. Scroll to continue reading.</span></p><p>According to Accenture, the attackers executed commands on a MiCollab server just 12 minutes after the first request, and gained root privileges within half an hour.\n\n\n\n</p><p>The hackers harvested additional credentials and, roughly 20 hours after their first observed request, gained access to internal backup and database servers.\n\n\n\n</p><p>The investigation uncovered evidence that some of the malicious activity may have been driven by AI tools, with the attacker’s infrastructure communicating with two unnamed commercial AI API services.&nbsp;\n\n\n\n</p><p>“Because the telemetry is sampled, Apex Labs cannot determine precisely how the threat actor used the services. However, the observed activity is consistent with potential uses such as data triage, operational support for exploitation or web-shell activity, and preparation of extortion material,” <a href=\"https://accenture.github.io/cyber-intelligence/micollab-exploitation/\">Accenture noted</a>.\n\n\n\n</p><p>It added that communications between the attackers’ infrastructure and the AI services resumed — after an eight-hour silence — at precisely the same second that the hackers sent an authentication bypass request to the targeted MiCollab server.\n\n\n\n</p><p>The company also found evidence of compromise at a second victim, with a MiCollab server communicating with the same attacker’s infrastructure since November 9. However, Accenture could not establish how the second server was hacked, as it had been affected by older vulnerabilities as well.\n\n\n\n</p><p>The researchers have not linked the attacks to a known cybercrime group, but believe they may have been part of an extortion campaign.&nbsp;\n\n\n\n</p><p>Mitel has released patches, but its <a href=\"https://www.mitel.com/support/security-advisories/mitel-product-security-advisory-misa-2026-0012\">advisory</a> — last updated on November 24 — does not mention in-the-wild exploitation of the vulnerabilities.\n\n\n\n</p><p>Accenture warned organizations that attackers may have compromised their MiCollab servers before the fixes were installed and urged them to check for indicators of compromise (IoCs).\n\n\n\n</p><p><a href=\"https://www.cisa.gov/news-events/alerts/2026/11/25/cisa-adds-10-known-exploited-vulnerabilities-catalog\">CISA 已将</a>全部五个漏洞添加到了其 KEV 目录中，指示联邦机构在 11 月 28 日前修复其中四个；最后一个的截止日期为 12 月 9 日。&nbsp;\n\n\n\n</p><p>威胁行为者经常<a href=\"https://www.securityweek.com/?s=mitel\">针对 Mitel 产品</a>。CISA 的 KEV 目录目前包含十二个此类漏洞。&nbsp;\n\n\n\n</p><p><strong>相关</strong>：<a href=\"https://www.securityweek.com/drupal-installer-patch-left-a-gap-attackers-are-already-exploiting/\">Drupal 安装程序补丁留下了攻击者已经在利用的缺口</a>\n\n\n\n</p><p><strong>相关</strong>：<a href=\"https://www.securityweek.com/two-newly-disclosed-geoserver-vulnerabilities-under-attack/\">两个新披露的 GeoServer 漏洞正遭到攻击</a>\n\n\n\n</p><p><strong>相关</strong>：<a href=\"https://www.securityweek.com/vmware-updates-patch-critical-esx-vcenter-vulnerabilities/\">VMware 更新修复了关键的 ESX 和 vCenter 漏洞</a>\n\n\n\n</p>","original","zhKind","translation","complete",false,"漏洞利用","https://www.securityweek.com/mitel-micollab-zero-days-exploited-in-suspected-ai-assisted-attacks/","SecurityWeek",{"_96":97,"_98":-5},"changelogVersion","2026-10-01T08:00","release"]
