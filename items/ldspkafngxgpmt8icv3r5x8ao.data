[{"_1":2,"_3":4},"root",{"_5":93},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":37,"_59":60},"expiresAt",1795740040000,"id","ldspkafngxgpmt8icv3r5x8ao","title","英国FCA要求金融机构管控AI Agent风险，否则将采取监管行动","originalTitle","Address AI Agent Risks or Face Action, FCA Warns Financial Firms","summary","英国金融监管机构 FCA 警告金融机构，必须处理部署 AI Agent 带来的网络安全风险，否则可能面临监管行动。11 月 24 日发布的指引要求负责相关 AI 模型的资深管理者采取合理措施，理解系统自主程度及其风险，提供有效监督、适当治理控制和升级机制；机构还应评估接受 AI Agent 指令及付款的责任，通过清晰、相称且一致的免责声明说明模型提供的信息和建议边界。","reason","FCA明确了金融机构部署AI Agent时的责任边界，并列出访问控制、监督、治理和消费者提示等可落实的合规要求。","source",{"_72":92},"links",{"_83":91},"publishedAt","2026-11-24T13:45:00.000Z","discoveredAt","2026-11-24T13:58:38.593Z","timelineAt","category","policy","tags",[73,87,88,89,90],"score",70,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","body",{"_60":82,"_83":-5,"_84":85,"_86":37},"outline",[],"relatedStories",[78],"topics",[67,68,69],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","fCsH0a9WW3gU","reportCount",1,"additionalSourceCount",0,{"_70":76,"_72":77},{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","ai-security","name","AI 安全","compliance","合规与标准","ai-agent","AI Agent 安全",{"_79":80,"_13":81},"publicId","990b339e-92a5-4910-b152-94ef23156be9","FCA要求金融机构管控AI代理风险","<p><img src=\"/dailyinfo/media/e68eb23fae0bbcda.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Photo of James Coker\"></p><p>\n\t英国金融监管机构已警告各家公司，必须应对部署 AI 智能体带来的网络安全风险，否则将面临监管行动。</p><p>\n\t金融行为监管局（FCA）表示，AI 智能体正在金融服务领域得到广泛部署，以提升生产率并为客户提供便利。</p><p>\n\t该监管机构指出：“但这些产品也可能模糊受监管活动与不受监管活动之间的界限，以及消费者在财务和数据方面所获得的保护。”</p><p>\n\t目前已有银行使用这些 AI 智能体发起交易、转移资金并作出投资决策。</p><p>\n\t如果没有适当的保障措施，例如严格的访问控制，据观察，智能体甚至可能为了正当目的而<a href=\"https://www.infosecurity-magazine.com/blogs/why-agent-governance-needs/\">采取危险行动</a>，例如获取敏感系统和数据的访问权限。</p><p>\n\tFCA 于 11 月 24 日发布的<a href=\"https://www.fca.org.uk/firms/innovation/ai-approach/agentic-ai\">指南</a>称，负责在特定业务领域部署 AI 模型的高级管理人员需要采取“合理措施”，了解 AI 带来的风险。这包括提供有效监督，并确保治理控制措施和升级处理安排与相关风险相适应。</p><p>\n\t受监管的金融机构应考虑接受智能体指令可能产生的任何责任，以及接受由 AI 智能体指示的付款是否适当。</p><p>\n\t它们还应通过清晰、适度且一致的免责声明，帮助消费者了解其模型所生成的财务信息和建议的局限性。</p><p>\n\tFCA 强调，无论公司自行部署智能体 AI，还是依赖第三方提供商，遵守监管义务的责任仍由高级管理人员和整个组织承担。</p><p>\n\t<a href=\"https://www.infosecurity-magazine.com/news/bank-england-fca-treasury-alarm/\"><em>立即阅读：英格兰银行、FCA 和财政部对前沿 AI 发出警报</em></a></p><p>\n\t该机构写道：“我们期望你们能够证明，你们了解自己使用的系统、这些系统所具备的自主程度、它们造成的风险，以及在正常情况和压力情形下实时管理这些风险所必需的控制措施。”</p><p>\n\t它继续表示：“我们将评估各公司通过智能体产品提供的服务，包括这些服务随着时间推移如何发展，以确保其持续符合监管要求。”</p><p>\n\t未能遵守现有监管要求（包括数据保护法）的组织，将面临 FCA 动用其权力进行制裁。这些<a href=\"https://www.fca.org.uk/about/how-we-regulate/enforcement\">权力</a>包括处以经济处罚、禁止个人从事受监管活动、公开谴责以及起诉。</p><p>\n\tFCA 补充称，欢迎那些在产品和系统中部署智能体 AI 的机构尽早与其接洽，并表示其提供包括测试这些工具是否符合监管要求在内的支持服务。</p>","original","zhKind","translation","complete","Agent 安全","治理","合规","大模型","https://www.infosecurity-magazine.com/news/ai-agent-risks-face-action-fca/","Infosecurity Magazine",{"_94":95,"_96":-5},"changelogVersion","2026-10-01T08:00","release"]
