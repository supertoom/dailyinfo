[{"_1":2,"_3":4},"root",{"_5":103},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":60,"_61":62},"expiresAt",1794357635000,"id","d5ja2gdozlvbokoh76xzu4ofy","title","Fireworks AI 披露第三方云提供商被攻破后发生的新数据泄露","originalTitle","Fireworks AI discloses new breach after cloud provider hack","summary","Fireworks AI 披露，攻击者在第三方云提供商于 October 23 遭入侵后，于 October 24 触达 Fireworks 开发机器并运行未授权工作负载，导致部分客户的资源元数据、账单信息及不完整模型权重和数据集被访问。","reason","事件涉及第三方云提供商被攻破后横向触达开发环境，并暴露部分客户账单信息与模型资源，处置过程可供复盘。","source",{"_75":102},"links",{"_62":101},"publishedAt","2026-11-10T07:49:58.000Z","discoveredAt","2026-11-10T08:50:18.441Z","timelineAt","category","activity","tags",[78,96,76,97,98,99,100],"score",76,"selected",true,"channel","news","story",{"_84":85,"_13":86},"x","readingMode","full","author","Sergiu Gatlan","body",{"_92":-5,"_62":93,"_94":-5,"_95":60},"outline",[87],"relatedStories",[83],"topics",[69,70,71,72],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation",false,"bodyLanguage","original","factId","fpq_vmWSLmiM","reportCount",2,"additionalSourceCount",1,{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","ai-security","name","AI 安全","attack","攻击活动","ai-agent","AI Agent 安全","cloud-native","云与原生",{"_84":85,"_13":86},"publicId","2c37c244-764b-44e8-91a5-ae809270e399","Fireworks AI披露扩大数据泄露",{"_11":88,"_89":90,"_91":66},"sec-1","text","Uncover email threats your existing defenses may miss.","level","zh","<p><img alt=\"Fireworks AI\" height=\"900\" src=\"/dailyinfo/media/eaa5eff50db4f101.jpg\" srcset=\"/dailyinfo/media/5ef6776763d75fa9.jpg 720w, /dailyinfo/media/f511829e77a75688.jpg 1200w, /dailyinfo/media/eaa5eff50db4f101.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>AI infrastructure startup Fireworks has disclosed a new security breach in which attackers accessed its development machines after breaching a third-party cloud provider.</p><p>FireWorks provides a high-performance inference platform for developers who want to deploy and run open-source artificial intelligence models (such as Mistral, Meta's Llama, or Google's Gemma) without worrying about hardware bottlenecks and complex infrastructure tasks.</p><p>The company notified law enforcement and customers of another security incident in early October after attackers accessed environment variables containing API keys and tokens stored as secrets for a limited number of accounts.</p><p><a href=\"https://www.wiz.io/lp/ai-security-starter-pack?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Security-Starter-Kit&amp;sfcid=701Vh00000cn7aRIAQ&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AI-Security-Bundle\"><img src=\"/dailyinfo/media/69a34b3179f0011b.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>\"The evidence indicates links to a cybercriminal threat actor group, which is financially motivated and aimed at selling tokens from unauthorized access to Large Language Models (LLMs) to illicit routing gateways, known as 'LLMJacking',\" <a href=\"http://fireworks.ai/security/bulletins/october-2026-security-incident\">Fireworks said</a>&nbsp;at the time.</p><p>After revoking compromised internal credentials, affected Fireworks API keys, and keys created by the attackers, Fireworks discovered another security incident on October 23.</p><p>In the new breach, the threat actors accessed resource metadata (e.g., Fireworks resource identifiers, display names, descriptions, creation time), billing information (e.g., billing and shipping addresses, invoice and payment history, account balance, and credit usage), and incomplete model weights and datasets for some customers.</p><p>However, the company said the attackers couldn't access customer payment card numbers because Fireworks doesn't store them.</p><p>\"A third-party cloud provider that hosted Fireworks R&amp;D machines experienced a security incident on October 23. On October 24, the unauthorized third party used it to reach Fireworks development machines and then run an unauthorized workload that led to additional customer data impact,\" <a href=\"https://fireworks.ai/security/bulletins/october-2026-security-incident-update\">Fireworks noted</a> in a Monday advisory.</p><p>\"We detected this activity on the same day, and followed our incident response processes to take immediate remediation measures and close known critical vulnerabilities. As of October 25, we have not detected further evidence of successful unauthorized access by the threat actor on the Fireworks platform customers use.\"</p><p>Since the attack, Fireworks revoked and replaced credentials and service accounts, restricted unauthorized network pathways, isolated affected systems, and tightened access to data storage and analytics systems to block public or unauthorized access to stored data.</p><p>The company is now working with Palo Alto Networks' Unit 42 incident response division to secure its systems against future attacks and further investigate the incident's full scope and impact.</p><p>One week ago, researchers at Google's Threat Intelligence Group (GTIG) and Mandiant reported that large language model hijacking attacks (also known as LLMjacking) are <span><a href=\"https://www.bleepingcomputer.com/news/security/google-llmjacking-attacks-rack-up-1-million-in-cloud-ai-charges/\">driving record costs for compromised organizations</a>, with cloud AI charges reaching </span>as high as $1 million due to fraudulent calls using stolen API keys.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/ec08be135363bed0.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Uncover email threats your existing defenses may miss.</a>\n        </h2><p>Adaptive Security's AI agents analyze email intent, context, and behavior to uncover phishing, business email compromise, and invoice fraud.</p><p>See what's getting through with a 14-day read-only scan of Microsoft 365 or Google Workspace, with no MX changes.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Start your free email security scan.</a>\n    </p>","zhKind","complete","数据泄露","大模型","云原生","Google","Palo Alto","https://www.bleepingcomputer.com/news/security/fireworks-ai-discloses-new-breach-after-cloud-provider-hack/","BleepingComputer",{"_104":105,"_106":-5},"changelogVersion","2026-10-01T08:00","release"]
