[{"_1":2,"_3":4},"root",{"_5":102},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795826438000,"id","dd0mowlai9kq6bzrbot0jgdij","title","Boston Scientific 遭 vishing 攻击，117,789 人个人信息与医疗数据泄露","originalTitle","New Boston Scientific data breach exposes personal, medical info","summary","医疗科技厂商 Boston Scientific 因语音钓鱼（vishing）攻击导致云端应用和云托管数据泄露，影响美国多个州 117,789 人，暴露内容包括姓名、住址、SSN、政府签发证件编号、医疗与健康保险信息及出生日期。","reason","source",{"_73":101},"links",{"_61":100},"publishedAt","2026-11-27T18:57:42.000Z","discoveredAt","2026-11-27T19:41:20.532Z","timelineAt","category","activity","tags",[74,97,98,99],"score",60,"selected",false,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","Bill Toulas","body",{"_93":-5,"_61":94,"_95":-5,"_96":36},"outline",[83,84],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fKH-iZrFm2Q4","reportCount",1,"additionalSourceCount",0,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","attack","name","攻击活动","email","邮件与钓鱼","cloud-native","云与原生",{"_80":81,"_13":82},"publicId","f3958956-ac79-43ae-8006-12387ba2c111","波士顿科学语音钓鱼致11.7万人数据泄露",{"_11":90,"_86":91,"_88":92},{"_11":85,"_86":87,"_88":89},"sec-2","text","Uncover email threats your existing defenses may miss.","level",2,"sec-1","Second breach in 2026",3,"zh","<p><img alt=\"New Boston Scientific data breach exposes personal, medical info\" height=\"900\" src=\"/dailyinfo/media/cb4cbaf13c9f3aaa.jpg\" srcset=\"/dailyinfo/media/6ee95fb39860be83.jpg 720w, /dailyinfo/media/7a4473cd451895c3.jpg 1200w, /dailyinfo/media/cb4cbaf13c9f3aaa.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>Medical technology company Boston Scientific is sending data breach notices to individuals affected by a cyberattack on the firm.</p><p>According to a <a href=\"https://www.documentcloud.org/documents/28936291-bsci-california-breach-notification/\">notification sample</a> Boston Scientific shared with U.S. authorities, the hacker used social engineering in a voice phishing (vishing) attack to gain access to the company's cloud infrastructure.</p><p>The attack exposed cloud-based applications and cloud-hosted data between May 7 and 1.</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/f411812111b5b5a1.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>The company became aware of the unauthorized access on May 12, and the investigation determined that a data breach occurred on November 5.</p><p>Individuals in multiple U.S. states have been impacted, exposing personal details and medical information. According to the Texas Attorney General breach portal, the incident exposed information from 117,789 people, which included:</p><ul>\n\t<li>Full name</li>\n\t<li>Physical address</li>\n\t<li>Social Security Number (SSN)</li>\n\t<li>Government-issued ID number (e.g., passport, state ID card)</li>\n\t<li>Medical information</li>\n\t<li>Health insurance information</li>\n\t<li>Date of birth</li>\n</ul><p>The letter sent to impacted individuals specifies that patient medical records and data from remote monitoring systems, connected medical devices, and clinical case management or workflow applications were not exposed.</p><p>Boston Scientific is a Massachusetts-based medical device maker whose products include stents, catheters, pacemakers, defibrillators, and endoscopes.</p><p>It is one of the world’s largest medical device manufacturers, with more than 59,000 employees, 13 manufacturing facilities, and a presence in 127 countries. In 2025, Boston Scientific reported more than $20 billion in revenue.</p><p>The company said there was no disruption to manufacturing, ordering, distribution, or service to patients and healthcare providers as a result of this incident.</p><p>It also said the incident had no impact on operations, performance, remote monitoring, or the safety of its products and medical devices.</p><p>Boston Scientific says it contained the incident, investigated with outside cybersecurity experts, and notified law enforcement. The notification does not offer free credit monitoring to impacted individuals but recommends using free credit reports and considering placing fraud alerts and credit freezes.</p><h3 id=\"sec-1\">Second breach in 2026</h3><p>The breach is the second cybersecurity incident this year. On August 25, Boston Scientific <a href=\"https://www.bleepingcomputer.com/news/security/boston-scientific-says-cyberattack-disrupted-operations-globally/\">disclosed a cyberattack</a> that caused network outages and a global operational disruption for the company, including to order processing and shipping.</p><p>CrowdStrike’s <a href=\"http://news.bostonscientific.com/update-on-recent-cybersecurity-incident\">investigation determined</a> that the attacker breached an internet-facing network device and pivoted to a limited part of the on-premises IT environment. However, the investigators found no evidence that the attackers compromised cloud applications.</p><p>BleepingComputer contacted Boston Scientific to learn more about the most recent incident, and a spokesperson confirmed that it is unrelated to the August 2026 intrusion.</p><p>The spokesperson declined to share additional details.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/a3aef6170ea13c62.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-2\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Uncover email threats your existing defenses may miss.</a>\n        </h2><p>Adaptive Security's AI agents analyze email intent, context, and behavior to uncover phishing, business email compromise, and invoice fraud.</p><p>See what's getting through with a 14-day read-only scan of Microsoft 365 or Google Workspace, with no MX changes.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Start your free email security scan.</a>\n    </p>","zhKind","complete","数据泄露","钓鱼","云原生","https://www.bleepingcomputer.com/news/security/new-boston-scientific-data-breach-exposes-personal-medical-info/","BleepingComputer",{"_103":104,"_105":-5},"changelogVersion","2026-10-01T08:00","release"]
