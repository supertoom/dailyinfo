[{"_1":2,"_3":4},"root",{"_5":127},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795048834000,"id","myip07efpiz0x9gx8bx36mrl3","title","CrowdStrike Falcon Next-Gen SIEM 构建 agentic SOC 引擎，获评 2026 Gartner SIEM 领导者","originalTitle","CrowdStrike Is Building the Engine of the Agentic SOC with Falcon Next-Gen SIEM","summary","CrowdStrike 被评为 2026 Gartner® Magic Quadrant™ SIEM 领导者，其 Falcon Next-Gen SIEM 通过统一数据层、跨域检测关联和 agentic 调查支撑 agentic SOC。","reason","source",{"_74":83},"links",{"_61":126},"publishedAt","2026-11-18T06:00:00.000Z","discoveredAt","2026-11-18T20:48:33.430Z","timelineAt","category","blue-team","tags",[121,122,123,79,124,125,83],"score",18,"selected",false,"channel","news","story",{"_85":86,"_13":87},"x","readingMode","full","author","Ajit Sanchetti","body",{"_117":-5,"_61":118,"_119":-5,"_120":36},"outline",[88,89,90,91,92,93,94,95],"relatedStories",[84],"topics",[68,69,70,71,72],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fakAeY9gjmt4","reportCount",1,"additionalSourceCount",0,{"_73":82,"_74":83},{"_73":80,"_74":81},{"_73":78,"_74":79},{"_73":76,"_74":77},{"_73":30,"_74":75},"slug","name","蓝队与运营","tools","工具与平台","ai-security","AI 安全","ai-agent","AI Agent 安全","crowdstrike","CrowdStrike",{"_85":86,"_13":87},"publicId","0bf0c2c1-df45-4c3b-9bd3-5bde1a113b46","CrowdStrike发布Falcon Next-Gen SIEM",{"_11":115,"_97":116,"_99":103},{"_11":113,"_97":114,"_99":106},{"_11":111,"_97":112,"_99":106},{"_11":109,"_97":110,"_99":106},{"_11":107,"_97":108,"_99":106},{"_11":104,"_97":105,"_99":106},{"_11":101,"_97":102,"_99":103},{"_11":96,"_97":98,"_99":100},"sec-8","text","Additional Resources","level",4,"sec-7","A SIEM Built to Power the Agentic SOC",2,"sec-6","Powers Machine-Speed Response",3,"sec-5","Enables Teams to Build Custom Agents","sec-4","Supports Agentic Investigations","sec-3","Delivers Adversary-Informed Detections","sec-2","Uses Detection-Ready Data","sec-1","The Agentic SOC Starts with SIEM","zh","<p>CrowdStrike has been named a Leader in the 2026 Gartner® Magic Quadrant™ for Security Information and Event Management (SIEM). We believe this recognition reflects a fundamental truth about the future of security operations: The agentic SOC starts with SIEM, and CrowdStrike Falcon® Next-Gen SIEM was built to be its foundation.</p><h2 id=\"sec-1\">The Agentic SOC Starts with SIEM</h2><p>Security analysts spend hours piecing together context across dozens of point tools, while every new data source drives SIEM costs higher. Now, AI agents operate across the enterprise with elevated privileges, adding a new attack surface the SOC has to defend. Keeping pace requires a new operating model: the agentic SOC, where expert AI agents investigate and respond to every detection and analysts direct the work.&nbsp;</p><p>An agent can only reason on the data and context it can see, which makes the SIEM the most important decision in the agentic SOC. A legacy SIEM built as a system of record forces teams to choose between ingesting everything at rising cost or dropping data and accepting blind spots.&nbsp;</p><p>The SIEM also decides what the SOC sees first. Legacy SIEMs lean on static rules that fire on single events in isolation, burying real attacks under low-fidelity alerts. Agents that receive this queue spend their time investigating noise. The agentic SOC needs a SIEM that delivers fewer, better detections that are correlated across domains and informed by how adversaries operate.</p><p>We built Falcon Next-Gen SIEM for this shift. Below we share five ways a SIEM built for the agentic SOC breaks from the legacy model, and why we believe only CrowdStrike delivers all of them natively on one platform.</p><h3 id=\"sec-2\">Uses Detection-Ready Data</h3><p><b>Legacy SIEM pricing increased the cost of visibility.</b> Every new data source created another integration to maintain and another line on the bill; as a result, data was dropped. For human analysts and AI agents, working with partial data leads to wrong decisions</p><p><a href=\"https://www.crowdstrike.com/en-us/platform/next-gen-siem/\">Falcon Next-Gen SIEM</a> ends the trade-off. Customers’ highest-value security telemetry is already in the CrowdStrike Falcon® platform, and native Falcon data across endpoint, cloud, identity, exposure management, and AI agents flows into Falcon Next-Gen SIEM at no added ingest cost. Certified data pipelines, built on <a href=\"https://www.crowdstrike.com/en-us/platform/next-gen-siem/falcon-onum/\">CrowdStrike Falcon® Onum</a> and validated by <a href=\"https://www.crowdstrike.com/en-us/services/falcon-complete-mdr/\">CrowdStrike Falcon® Complete</a>, bring in detection-ready third-party data and filter out noise at ingestion. Customers can reduce data storage costs by up to 50%<sup>1</sup>, and federated search reaches data wherever it lives, so teams see everything without ingesting everything.&nbsp;</p><p>This same data now covers AI agents, a source that legacy SIEMs weren’t built to handle. <a href=\"https://www.crowdstrike.com/en-us/platform/falcon-guardian-aidr/\">CrowdStrike® Falcon Guardian™</a> shows what an AI agent did on the endpoint, including prompts, tool calls, MCP servers, skills, and subagents. The telemetry lands in Falcon Next-Gen SIEM alongside endpoint, identity, cloud, and third-party data, so a compromised agent surfaces already connected to its owner and host.</p><h3 id=\"sec-3\">Delivers Adversary-Informed Detections</h3><p><b>A rule that fires on a single event can't see a campaign.</b> Legacy correlation forces analysts to manually connect the dots; agents handed those alerts must guess which ones belong to the same attack.</p><p>Falcon Next-Gen SIEM correlates signals across domains and enriches them with CrowdStrike adversary intelligence. Agents can recognize a coordinated campaign and pull related alerts into a single investigation, prioritized by risk to the business. No other SIEM is natively integrated with intelligence from CrowdStrike Counter Adversary Operations, which tracks more than 290 named adversaries globally. As adversaries change their tradecraft, the detections change with them.</p><h3 id=\"sec-4\">Supports Agentic Investigations</h3><p><b>Better detections don't clear the queue.</b> Even a well-tuned SIEM produces more high-fidelity detections than analysts can investigate. Bolting automation onto a legacy SIEM doesn't fix it. Linear, serial workflows produce agents that make fast but wrong decisions. AI SOC tools built on general-purpose frontier AI models lack the precision to close false positives and find real threats.</p><p>The difference is where the agents live. When agents and the SIEM share one data layer, every detection can be investigated with full context, around the clock. CrowdStrike's agents encode the expertise of the elite Falcon Complete team, which is trained on real casework from tens of thousands of customers for autonomous triage and investigation, including knowing when to escalate for human oversight. Agents’ accuracy improves the longer they learn from and adapt to each organization's unique environment. Inside Falcon Next-Gen SIEM, agents pass context to one another as the investigation unfolds, and a central coordinator reaches a verdict no single agent could on its own. Every investigation shows its work, so analysts stay in control.</p><h3 id=\"sec-5\">Enables Teams to Build Custom Agents</h3><p><b>Legacy SIEMs ship with content libraries that aren’t tailored to each customer.</b> Every SOC has its own playbooks, escalation paths, and risk tolerances that can’t be pre-packaged.</p><p>CrowdStrike Charlotte AI™ AgentWorks lets teams go further. It's a no-code workspace where teams build custom agents on the same Falcon Next-Gen SIEM data and shared context as every out-of-the-box agent. The most advanced companies already have agents in production delivering real outcomes. For example, one customer who <a href=\"https://www.crowdstrike.com/en-us/blog/five-lessons-from-agentworks-hackathon/\">participated in the AgentWorks Hackathon</a> used Charlotte AI AgentWorks to build an agent that catches multifactor authentication (MFA) reset abuse in about 70 seconds instead of their usual 20 to 30 minutes. Another customer’s custom agent found 1,710 hosts running unapproved MCP servers in a single day.&nbsp;</p><h3 id=\"sec-6\">Powers Machine-Speed Response</h3><p><b>In a legacy SIEM, the alert is the last step.</b> Response happens in another tool after someone picks it up. CrowdStrike® Charlotte Agentic SOAR, built into Falcon Next-Gen SIEM, connects every verdict to governed response across the Falcon platform and third-party tools, from containing a host to revoking a session. Humans approve the actions that matter, and every step is traced and auditable, so the platform can act in seconds.</p><h2 id=\"sec-7\">A SIEM Built to Power the Agentic SOC</h2><p>Legacy SIEM was built to store logs. The agentic SOC needs a SIEM built to stop breaches. We believe being named a Leader in the 2026 Gartner® Magic Quadrant™ for SIEM reflects this shift, and customers see it too. CrowdStrike is one of only two vendors named a <a href=\"https://www.crowdstrike.com/en-us/resources/reports/2026-gartner-peer-insights-voice-of-the-customer-for-siem/\">2026 Gartner® Peer Insights™ Customers' Choice for SIEM</a>,&nbsp;with 92% of reviewers Willing to Recommend, based on 278 reviews as of 31 January 2026. By bringing detection-ready data, adversary intelligence, agentic investigations, custom agents, and machine-speed response together natively on one platform, Falcon Next-Gen SIEM gives security teams the engine to stay ahead of modern adversaries.</p><h4 id=\"sec-8\">Additional Resources</h4><ul><li><i>Visit the <a href=\"https://www.crowdstrike.com/en-us/platform/next-gen-siem/\">Falcon Next-Gen SIEM product page</a>.&nbsp;</i></li><li><i>Learn more about <a href=\"https://www.crowdstrike.com/en-us/solutions/agentic-soc-transformation/\">agentic SOC transformation</a>.</i></li><li><i>Learn how CrowdStrike is extending the agentic SOC in this <a href=\"https://www.crowdstrike.com/en-us/blog/crowdstrike-detects-and-stops-agent-insider-threats/\">blog</a>.</i></li></ul><p><i>Gartner, 2026 Gartner® Magic Quadrant™ for Security Information and Event Management, Eric Ahlm, Angel Berrios, Andrew Davies, Kevin Schmidt, 18 November 2026.</i></p><p><i>Gartner and Magic Quadrant are trademarks of Gartner, Inc. and/or its affiliates. Gartner does not endorse any company, vendor, product or service depicted in its publications, and does not advise technology users to select only those vendors with the highest ratings or other designation. Gartner publications consist of the opinions of Gartner’s business and technology insights organization and should not be construed as statements of fact. Gartner disclaims all warranties, expressed or implied, with respect to this publication, including any warranties of merchantability or fitness for a particular purpose.</i></p><p><i>The graphic was published by Gartner, Inc. as part of a larger research document and should be evaluated in the context of the entire document. The Gartner document is available upon request from CrowdStrike.</i></p><p><sup>1</sup> These numbers are projected estimates of average benefit based on company’s own internal analysis and recorded metrics provided by customers during pre-sale motions that compare the value of CrowdStrike with the customer’s incumbent solution. Actual realized value will depend on the customer's module deployment and environment.</p>","zhKind","complete","工具评测","检测工程","安全运营","Agent 安全","大模型","https://www.crowdstrike.com/en-us/blog/crowdstrike-named-leader-2026-gartner-mq-siem/",{"_128":129,"_130":-5},"changelogVersion","2026-10-01T08:00","release"]
