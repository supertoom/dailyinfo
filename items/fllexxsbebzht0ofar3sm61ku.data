[{"_1":2,"_3":4},"root",{"_5":91},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1794271233000,"id","fllexxsbebzht0ofar3sm61ku","title","Windows Error Reporting 参数注入权限提升漏洞 CVE-2026-97798 已复现","originalTitle","【已复现】Windows Error Reporting 参数注入权限提升漏洞(CVE-2026-97798)安全风险通告","summary","Windows Error Reporting 参数注入权限提升漏洞 CVE-2026-97798 已被奇安信 CERT 复现，攻击者在具备目标系统低权限代码执行能力时可借助 WER 的参数注入将任意程序以 SYSTEM 权限启动。","reason","原文给出漏洞原理、完整影响版本和利用前提，并确认已有公开 PoC，可据此评估 Windows 终端暴露面与补丁优先级。","source",{"_71":90},"links",{"_80":89},"publishedAt","2026-11-09T03:39:00.000Z","discoveredAt","2026-11-09T11:24:17.797Z","timelineAt","category","vuln","tags",[83,84,85,86,87,88],"score",73,"selected",true,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","body",{"_61":79,"_80":-5,"_81":80,"_82":37},"outline",[],"relatedStories",[75],"topics",[68,69],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fY4UYQx1hCXA","reportCount",2,"additionalSourceCount",1,{"_70":73,"_71":74},{"_70":31,"_71":72},"slug","name","漏洞披露","microsoft","Microsoft / 微软",{"_76":77,"_13":78},"publicId","da83266b-edc1-4102-9a04-c1a27c2d8408","奇安信复现Windows WER提权漏洞","<p><span>奇安信 CERT</span> <span>2026-11-09 11:39</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/fec1d6b133dc2b88.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>致力于第一时间为企业级用户提供权威漏洞情报和有效解决方案。</p><p><span><span>●&nbsp;</span></span><span><span>点击↑蓝字关注我们，获取更多安全风险通告</span></span></p><hr><table><tbody><tr><td colspan=\"4\" align=\"center\"><p><span><strong><span><span>漏洞概述</span></span></strong></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>漏洞名称</span></span></strong></span></p></td><td colspan=\"3\" align=\"left\"><p><span><span>Windows Error Reporting 参数注入权限提升漏洞</span></span></p></td></tr><tr><td align=\"left\"><p><span><span><strong><span>漏洞编号</span></strong></span></span></p></td><td colspan=\"3\" align=\"left\"><p><span><span>QVD-2026-83605</span><span>，</span><span>CVE-2026-97798</span></span></p></td></tr><tr><td align=\"left\"><p><strong><span><strong><span><span>公开时间</span></span></strong></span></strong></p></td><td align=\"left\"><p><span><span>2026-10-13</span></span></p></td><td align=\"left\"><p><strong><span><strong><span><span>影响量级</span></span></strong></span></strong></p></td><td align=\"left\"><p><span><span>百万级</span></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>奇安信评级</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>高危</span></span></strong></span></p></td><td align=\"left\"><p><strong><span><span>CVSS 3.1分数</span></span></strong></p></td><td align=\"left\"><p><span><span><strong><span>7.8</span></strong></span></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span>威胁类型</span></strong></span></p></td><td align=\"left\"><p><span><span><span>权限提升</span></span></span></p></td><td align=\"left\"><p><strong><span><span>利用可能性</span></span></strong></p></td><td align=\"left\"><p><strong><span><strong><span><span>高</span></span></strong></span></strong></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>POC状态</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span><span>已公开</span></span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>在野利用状态</span></span></strong></span></p></td><td align=\"left\"><p><span><span><span>未发现</span></span></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>EXP状态</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span><span>已公开</span></span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>技术细节状态</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span><span>已公开</span></span></span></strong></span></p></td></tr><tr><td colspan=\"4\" align=\"left\"><p><strong><span><span>危害描述：</span></span></strong><span><span>攻击者可利用此漏洞实现从普通用户或中等完整性管理员到 SYSTEM 的完整权限提升，进而控制整个系统、读取敏感数据、篡改系统文件或进一步横向移动。</span></span></p></td></tr></tbody></table><p><strong><span>0</span></strong><strong><span>1</span></strong></p><p><strong><span>漏洞详情</span></strong></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>影响组件</span></span></strong></p><p><span>Windows 错误报告（Windows Error Reporting，WER）是 Microsoft Windows 操作系统内置的核心组件，用于自动收集、诊断并上报应用程序崩溃、硬件故障及系统错误信息。它通过后台服务与用户态组件协作，生成错误报告并可选上传至 Microsoft 进行分析，帮助改进系统稳定性与兼容性。WER 还支持高级调试功能，如 Time Travel Debugging（TTD），用于记录和回放进程执行轨迹，便于开发者与管理员深入排查问题。该服务在现代 Windows 系统中默认启用，覆盖广泛桌面与服务器场景。</span></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>漏洞描述</span></span></strong></p><p><span>近日，奇安信CERT监测到官方修复<span>Windows Error Reporting 参数注入权限提升漏洞(CVE-2026-97798)</span>，该漏洞源于 WER 在处理 Time Travel Debugging 相关请求时，对攻击者可控的 Process 参数未进行充分的参数分隔符中和与边界保护。低权限本地用户可通过构造特殊输入，使参数跨权限边界传递至高权限的数据收集器，最终被拼接进 TTTracer.exe 的命令行。由于未正确序列化参数，注入的 -out、-launch 等开关被 TTD 记录器解析为合法选项，导致任意可执行文件以提升后的令牌（通常为 NT AUTHORITY\\SYSTEM）启动。攻击者可借此实现从普通用户或中等完整性管理员到 SYSTEM 的完整权限提升，进而控制整个系统、读取敏感数据、篡改系统文件或进一步横向移动。<span>目前该漏洞PoC和技术细节已公开，</span></span><span><span>鉴于该漏洞影响范围较大，建议客户尽快做好自查及防护。</span></span></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>利用条件</span></span></strong></p><p><span><span>攻击者具备在目标系统上执行低权限代码的能力。</span></span></p><p><strong><span>02</span></strong></p><p><strong><span>影响范围</span></strong></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>影响版本</span></span></strong></p><p><span>10.0.19044.0 &lt;= Windows 10 21H2 &lt; 10.0.19044.7807</span></p><p><span>10.0.19045.0 &lt;= Windows 10 22H2 &lt; 10.0.19045.7807</span></p><p><span>10.0.22631.0 &lt;= Windows 11 23H2 &lt; 10.0.22631.7652</span></p><p><span>10.0.26100.0 &lt;= Windows 11 24H2 &lt; 10.0.26100.9711</span></p><p><span>10.0.26200.0 &lt;= Windows 11 25H2 &lt; 10.0.26200.9711</span></p><p><span>10.0.28000.0 &lt;= Windows 11 26H1 &lt; 10.0.28000.3231</span></p><p><span>10.0.26300.0 &lt;= Windows 11 26H2 &lt; 10.0.26300.9711</span></p><p><span>10.0.20348.0 &lt;= Windows Server 2022 &lt; 10.0.20348.5761</span></p><p><span>10.0.26100.0 &lt;= Windows Server 2025 &lt; 10.0.26100.33650</span></p><p><strong><span>03</span></strong></p><p><strong><span>复现情况</span></strong></p><p><span><span>目前，奇安信威胁情报中心安全研究员已成功复现</span><span><span>Windows Error Reporting 参数注入权限提升漏洞(CVE-2026-97798)</span></span><span>，</span><span>截图如下：</span></span></p><p><img src=\"/dailyinfo/media/843d5ea2b0227d7d.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>04</span></strong></p><p><strong><span>处置建议</span></strong></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>安全更新</span></span></strong></p><p><strong><span><span>使用奇安信天擎的客户可以通过奇安信天擎控制台一键更新修补相关漏洞，也可以通过奇安信天擎客户端一键更新修补相关漏洞。</span></span></strong></p><p><span><span>也可以采用以下官方解决方案及缓解方案来防护此漏洞：</span></span></p><p><strong><span><span>Windows自动更新</span></span></strong></p><p><span><span>Windows系统默认启用 Microsoft Update，当检测到可用更新时，将会自动下载更新并在下一次启动时安装。还可通过以下步骤快速安装更新：</span></span></p><p><span><span>1、点击“开始菜单”或按Windows快捷键，点击进入“设置”</span></span></p><p><span><span>2、选择“更新和安全”，进入“Windows更新”（Windows Server 2012以及Windows Server 2012 R2可通过控制面板进入“Windows更新”，步骤为“控制面板”-&gt; “系统和安全”-&gt;“Windows更新”）</span></span></p><p><span><span>3、选择“检查更新”，等待系统将自动检查并下载可用更新</span></span></p><p><span><span>4、重启计算机，安装更新</span></span></p><p><span><span>系统重新启动后，可通过进入“Windows更新”-&gt;“查看更新历史记录”查看是否成功安装了更新。对于没有成功安装的更新，可以点击该更新名称进入微软官方更新描述链接，点击最新的SSU名称并在新链接中点击“Microsoft 更新目录”，然后在新链接中选择适用于目标系统的补丁进行下载并安装。</span></span></p><p><strong><span><span>手动安装补丁</span></span></strong></p><p><span><span>另外，对于不能自动更新的系统版本，可参考以下链接下载适用于该系统的补丁并安装：</span></span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-97798\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-97798</a></span></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>产品解决方案</span></span></strong></p><p><strong><span><span>奇安信天擎终端安全管理系统解决方案</span></span></strong></p><p><span><span>奇安信天擎终端安全管理系统并且有漏洞修复相关模块的用户，可以将补丁库版本更新到：</span><span><span>2026.10.14.1000</span></span><span>及以上版本，对内网终端进行补丁更新。</span></span></p><p><span><span>推荐采用自动化运维方案，如果控制中心可以连接互联网的用户场景，建议设置为自动从奇安信云端更新补丁库至</span><span><span>2026.10.14.1000</span></span><span>版本。</span></span></p><p><span><span>控制中心补丁库更新方式：每天04:00-06:00自动升级，升级源为从互联网升级。</span></span></p><p><span><span>纯隔离网内控制中心不能访问互联网，不能下载补丁库和补丁文件，需使用离线升级工具定期导入补丁库和文件到控制中心。</span></span></p><p><strong><span>05</span></strong></p><p><strong><span>参考资料</span></strong></p><p><span><span>[1]</span><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-97798\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-97798</a></span></span></p><p><span><span>[2]</span><span><a href=\"https://github.com/G4sp4rCS/CVE-2026-97798-exploit\">https://github.com/G4sp4rCS/CVE-2026-97798-exploit</a></span></span></p><p><strong><span>06</span></strong></p><p><strong><span>时间线</span></strong></p><p><span><span>2026年11月09日，奇安信 CERT发布安全风险通告。</span></span></p><p><strong><span>07</span></strong></p><p><strong><span>漏洞情报服务</span></strong></p><p><span><span>「</span><span>奇安信漏洞情报平台</span><span>」</span><span>重磅上线，诚邀您来体验：</span></span></p><p><img alt=\"图片\" src=\"/dailyinfo/media/6aefa740af36a573.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img alt=\"图片\" src=\"/dailyinfo/media/9a2bd58132b40c10.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img alt=\"图片\" title=\"CERT LOGO.png\" width=\"100%\" src=\"/dailyinfo/media/a5fe6b9d0ac59e07.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><strong><span>奇安信 CERT</span></strong></span></p><p><span><strong><span><span>致力于</span></span></strong><span><span>第一时间为企业级用户提供</span><strong><span><span>权威</span></span></strong><span>漏洞情报和</span></span><strong><span><span>有效</span></span></strong><span><span>解决方案。</span></span></span></p><p><span><span><span>点击↓</span><strong><span><span>阅读原文</span></span></strong><span>，到</span></span><strong><span><span>ALPHA威胁分析平台</span></span></strong><span><span>订阅更多漏洞信息。</span></span></span></p><p><a href=\"https://ti.qianxin.com/portal/subscription\">阅读原文</a></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=32d46be9&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzU5NDgxODU1MQ%3D%3D%26mid%3D2247508061%26idx%3D1%26sn%3D06b92c69f294a5093707f705d65dc73b\">跳转微信打开</a></p>","original","zhKind","complete","漏洞","复现","漏洞利用","补丁","Microsoft","奇安信","https://mp.weixin.qq.com/s?__biz=MzU5NDgxODU1MQ==&mid=2247508061&idx=1&sn=06b92c69f294a5093707f705d65dc73b","奇安信 CERT",{"_92":93,"_94":-5},"changelogVersion","2026-10-01T08:00","release"]
