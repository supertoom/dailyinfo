[{"_1":2,"_3":4},"root",{"_5":105},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1794703233000,"id","szx1lyqr0he0pwug9ig82x1j3","title","CrowdStrike 推出 Falcon AI Gateway，集中控制企业 AI 模型访问与安全策略","originalTitle","Inside Falcon AI Gateway: One Control Point for AI Traffic","summary","CrowdStrike 推出已正式可用并包含于 CrowdStrike Falcon® Guardian™ 的 Falcon AI Gateway，通过统一网关检查提示词与响应、监控用量并执行策略。","reason","source",{"_74":80},"links",{"_61":104},"publishedAt","2026-11-13T06:00:00.000Z","discoveredAt","2026-11-14T14:12:43.071Z","timelineAt","category","ai-security","tags",[101,76,102,103,80],"score",43,"selected",false,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","Vanessa Villa","body",{"_97":-5,"_61":98,"_99":-5,"_100":36},"outline",[85,86,87],"relatedStories",[81],"topics",[68,69,70,71],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fg3aFEDlvl7I","reportCount",1,"additionalSourceCount",0,{"_72":79,"_74":80},{"_72":77,"_74":78},{"_72":30,"_74":76},{"_72":73,"_74":75},"slug","tools","name","工具与平台","AI 安全","ai-agent","AI Agent 安全","crowdstrike","CrowdStrike",{"_82":83,"_13":84},"publicId","98ef6d73-60d1-49e5-bce4-1aab185ea79c","CrowdStrike 发布 Falcon AI Gateway",{"_11":95,"_89":96,"_91":92},{"_11":93,"_89":94,"_91":92},{"_11":88,"_89":90,"_91":92},"sec-3","text","Govern AI Traffic with Falcon Guardian","level",2,"sec-2","Built by CrowdStrike, for CrowdStrike","sec-1","One Control Point for Model Access, Usage, and Security","zh","<p>As AI agents move from answering questions to executing actions, seeing AI activity isn't enough. Security teams need to control it.</p><p>AI requests now come from employee assistants, coding agents, SaaS copilots, and custom applications and cloud workloads that call models directly through SDKs. Each of these requesters connects to model providers on its own, with its own credentials, models, and settings.</p><p>Falcon AI Gateway, now generally available and included with <a href=\"https://www.crowdstrike.com/en-us/platform/falcon-guardian-aidr/\">CrowdStrike Falcon® Guardian™</a>, extends AI visibility and enforcement beyond the CrowdStrike Falcon® sensor. It routes AI traffic through a centralized gateway to inspect prompts and responses, monitor usage, and enforce policy across managed and unmanaged devices.&nbsp;</p><p><img src=\"/dailyinfo/media/7c4982fcb5fec51a.jpg\" loading=\"lazy\" decoding=\"async\" width=\"100\"></p><h2 id=\"sec-1\">One Control Point for Model Access, Usage, and Security</h2><p>Discovery shows where unsanctioned AI is in use. Falcon AI Gateway adds a complementary approach: Make the approved path the only path.</p><p>Falcon AI Gateway authenticates each request, routes it to the right provider and model, applies usage limits, and applies Falcon Guardian policy both before the request reaches the provider and again when the response comes back.</p><p>Teams block direct connections to model providers using the network controls they already run, and route approved applications and workloads through Falcon AI Gateway. As a result, the AI traffic reaching providers from those workloads has passed through Falcon Guardian policy on the way. This doesn't discover or redirect AI traffic automatically; it gives teams a deliberate control point for the workloads they choose to route through it.</p><p>This allows teams to:</p><ul><li><b>See</b>: Traffic, models, tokens, and estimated spend in one place, with dashboards, request logs, and event data.</li><li><b>Adapt</b>: Applications send requests to one gateway endpoint with one gateway key, using the API formats they already speak. Provider credentials stay in the gateway, and administrators can switch between connected model providers, such as Anthropic, Amazon Bedrock, Microsoft Foundry, and Google Vertex AI, without reconfiguring every workload.</li><li><b>Control</b>: Rate limits and budgets on requests, tokens, or estimated spend, scoped by application, user, team, model, or provider. Application keys suit services and shared workloads; personal keys attribute usage to an individual.</li><li><b>Secure</b>: Falcon Guardian policy inspects prompts and responses routed through the gateway for risks such as prompt injection and sensitive data leakage.</li></ul><p>Falcon AI Gateway and the Falcon sensor share one Falcon Guardian policy model, and each enforces where the policy sits. The sensor acts on the endpoint, including the local processes, files, and commands an agent runs. Falcon AI Gateway acts on traffic routed through it and can't stop local processes.</p><p>Because traffic flows through one point, <a href=\"https://www.crowdstrike.com/en-us/blog/crowdstrike-introduces-ai-kill-switch/\">AI Kill Switch</a> in Falcon Guardian can cut off agents’ access to the model via the traffic routed through Falcon AI Gateway.</p><p>Falcon Guardian customers can find Falcon AI Gateway in the Falcon console under <b>Falcon Experiences &gt; AI Gateway</b>. Developers connect an existing SDK or coding tool by changing the base URL to point at the gateway and using a gateway key.</p><h2 id=\"sec-2\">Built by CrowdStrike, for CrowdStrike</h2><p>CrowdStrike built the Falcon AI Gateway for ourselves first. The foundation came from running AI at scale inside CrowdStrike, from the work behind CrowdStrike® Charlotte AI™ to our internal AI Hub gateway, which has served tens of thousands of CrowdStrike employees globally for the past few years. Along the way, we learned to keep the request path short, since every extra hop adds another failure point and more time. We also learned that most teams would rather not run a gateway themselves, so we're giving Falcon Guardian customers the one we built for our own needs.</p><h2 id=\"sec-3\">Govern AI Traffic with Falcon Guardian</h2><p>Securing AI requires the right control points everywhere AI operates. Only CrowdStrike unifies OS-level visibility, endpoint network inspection, agent-level instrumentation, and centralized gateway enforcement for environments beyond sensor coverage, to see what agents are instructed to do, what they communicate, and what they actually execute.</p><p>AI adoption isn't slowing down, and neither is the number of places AI requests come from. Falcon AI Gateway gives teams one control point for model access, usage, and Guardian policy, built on technology CrowdStrike runs for itself and included with Falcon Guardian.</p><p>Learn more about <a href=\"https://www.crowdstrike.com/en-us/platform/falcon-guardian-aidr/\">Falcon Guardian</a> and CrowdStrike's approach to securing AI across the enterprise.</p>","zhKind","complete","工具发布","大模型","Agent 安全","https://www.crowdstrike.com/en-us/blog/falcon-ai-gateway-one-control-point-for-ai-traffic/",{"_106":107,"_108":-5},"changelogVersion","2026-10-01T08:00","release"]
