[{"_1":2,"_3":4},"root",{"_5":90},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795480837000,"id","l4rwwnkcn10mehuvb5erq97bh","title","Vite 远程代码执行漏洞 QVD-2026-112681 已公开 PoC，官方发布补丁","originalTitle","Vite远程代码执行漏洞(QVD-2026-112681)安全风险通告","summary","奇安信CERT监测到并成功复现Vite远程代码执行漏洞QVD-2026-112681，CVSS 4.0评分为9.1，PoC、技术细节及EXP均已公开，但未发现在野利用。","reason","通告给出了多个受影响版本区间、利用前提、补丁版本及风险资产数量，便于开发团队快速核对暴露范围并决定升级。","source",{"_71":89},"links",{"_80":88},"publishedAt","2026-11-19T08:02:10.031Z","discoveredAt","2026-11-19T11:02:10.049Z","timelineAt","category","vuln","tags",[83,84,85,86,87,74],"score",78,"selected",true,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","body",{"_61":79,"_80":-5,"_81":80,"_82":37},"outline",[],"relatedStories",[75],"topics",[68,69],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","f88dqGvZuEYk","reportCount",1,"additionalSourceCount",0,{"_70":73,"_71":74},{"_70":31,"_71":72},"slug","name","漏洞披露","qianxin","奇安信",{"_76":77,"_13":78},"publicId","e47e2c59-ef19-4157-af1b-6ef85023c8de","奇安信CERT复现Vite远程代码执行漏洞","<table><tbody><tr><td colspan=\"4\"><p><strong>漏洞概述</strong></p></td></tr><tr><td><p><strong>漏洞名称</strong></p></td><td colspan=\"3\"><p>Vite 远程代码执行漏洞</p></td></tr><tr><td><p><strong>漏洞编号</strong></p></td><td colspan=\"3\"><p>QVD-2026-112681</p></td></tr><tr><td><p><strong><strong>公开时间</strong></strong></p></td><td><p>2026-11-10</p></td><td><p><strong><strong>影响量级</strong></strong></p></td><td><p>万级</p></td></tr><tr><td><p><strong>奇安信评级</strong></p></td><td><p><strong>高危</strong></p></td><td><p><strong>CVSS 4.0分数</strong></p></td><td><p><strong>9.1</strong></p></td></tr><tr><td><p><strong>威胁类型</strong></p></td><td><p>代码执行</p></td><td><p><strong>利用可能性</strong></p></td><td><p><strong><strong>高</strong></strong></p></td></tr><tr><td><p><strong>POC状态</strong></p></td><td><p><strong>已公开</strong></p></td><td><p><strong>在野利用状态</strong></p></td><td><p>未发现</p></td></tr><tr><td><p><strong>EXP状态</strong></p></td><td><p><strong>已公开</strong></p></td><td><p><strong>技术细节状态</strong></p></td><td><p><strong>已公开</strong></p></td></tr><tr><td colspan=\"4\"><p><strong>危害描述：</strong>攻击者只需向暴露的开发服务器发送恶意 HTTP 请求即可实现任意文件读取或远程代码执行，严重威胁开发环境的机密性与完整性。</p></td></tr></tbody></table><p><strong>0</strong><strong>1</strong></p><p><strong>漏洞详情</strong></p><p><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong></p><p><strong>影响组件</strong></p><p>Vite 是一款基于原生 ES 模块的下一代前端构建工具，专为现代 Web 应用开发设计。它提供极速的冷启动、热模块替换（HMR）以及高效的生产构建能力，广泛应用于 Vue、React、Svelte 等框架项目中。Vite 通过开发服务器实现实时编译与资源服务，并支持丰富的插件生态与配置选项，显著提升开发体验与构建效率。作为前端工程化的核心工具之一，Vite 被全球大量开发者和企业采用。</p><p><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong></p><p><strong>漏洞描述</strong></p><p>近日，奇安信CERT监测到官方修复Vite 远程代码执行漏洞(QVD-2026-112681)，该漏洞源于 Vite 解析器插件中的虚拟模块 __vite-browser-external:&lt;suffix&gt; 和 __vite-optional-peer-dep:&lt;suffix&gt; 在嵌入来自 URL 的模块 ID 时未进行转义处理，导致攻击者可通过构造特殊请求注入任意代码。注入的代码可绕过 server.fs 文件访问限制读取任意文件，并利用 Vite 对 new Worker 和 import.meta.glob 使用 eval 提取值的机制，在服务器端执行任意代码（可通过 globalThis.process.getBuiltinModule 等绕过部分限制）。攻击者只需向暴露的开发服务器发送恶意 HTTP 请求即可实现任意文件读取或远程代码执行，严重威胁开发环境的机密性与完整性。目前该漏洞PoC和技术细节已公开。鉴于该漏洞影响范围较大，建议客户尽快做好自查及防护。</p><p><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong></p><p><strong>利用条件</strong></p><p>1.开发服务器通过 --host 命令行参数或 server.host 配置项显式暴露到网络（非默认 localhost）。</p><p>2.攻击者能够访问该开发服务器的网络端口并发送 HTTP 请求。</p><p><strong>02</strong></p><p><strong>影响范围</strong></p><p><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong></p><p><strong>影响版本</strong></p><p>8.3.0 &lt;= Vite &lt; 8.3.7</p><p>8.2.0 &lt;= Vite &lt; 8.2.5</p><p>8.0.0 &lt;= Vite &lt; 8.1.7</p><p>7.0.0 &lt;= Vite &lt; 7.3.8</p><p>4.0.0 &lt;= Vite &lt; 6.4.6</p><p>vite-plus &lt; 1.5.1</p><p><strong>03</strong></p><p><strong>复现情况</strong></p><p>目前，奇安信CERT已成功复现Vite 远程代码执行漏洞(QVD-2026-112681)，截图如下：</p><p><img src=\"/dailyinfo/media/c5b1cac8fb0c9bf9.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong>04</strong></p><p><strong>受影响资产情况</strong></p><p>奇安信鹰图资产测绘平台数据显示，Vite 远程代码执行漏洞(QVD-2026-112681)关联的国内风险资产总数为30362个，关联IP总数为10757个。国内风险资产分布情况如下：</p><p><img src=\"/dailyinfo/media/91c955f5dcdc2414.webp\" loading=\"lazy\" decoding=\"async\"></p><p>Vite 远程代码执行漏洞(QVD-2026-112681)关联的全球风险资产总数为73499个，关联IP总数为31809个。全球风险资产分布情况如下：</p><p><img src=\"/dailyinfo/media/1de4881b4d87aa46.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong>05</strong></p><p><strong>处置建议</strong></p><p><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong></p><p><strong>安全更新</strong></p><p>官方已发布安全补丁，请及时更新至最新版本：</p><p>Vite &gt;= 8.3.7</p><p>Vite &gt;= 8.2.5</p><p>Vite &gt;= 8.1.7</p><p>Vite &gt;= 7.3.8</p><p>Vite &gt;= 6.4.6</p><p>vite-plus &gt;= 1.5.1</p><p>对于 Vite 8 系列，修复依赖 Rolldown 对应版本（8.3.7/8.2.5 依赖 Rolldown 1.2.17；8.1.7 依赖 1.1.7）。升级后请重新安装依赖并验证版本。</p><p>下载地址：</p><p>https://github.com/vitejs/vite/releases</p><p>临时缓解措施：</p><p>1.在无法立即升级的情况下，避免将 Vite 开发服务器暴露到网络：移除 --host 参数，或将 server.host 设置为 127.0.0.1/localhost，仅允许本地访问。</p><p>2.若确需远程访问开发服务器，应通过防火墙、反向代理或 VPN 限制访问来源 IP，仅允许可信网络访问，避免将开发端口直接暴露于公网。</p><p><strong>06</strong></p><p><strong>参考资料</strong></p><p>[1]https://github.com/vitejs/vite/security/advisories/GHSA-p4f5-76q4-ffq7</p><p>[2]https://github.com/vitejs/vite/pull/24044</p><p>声明：本文来自奇安信 CERT，版权归作者所有。文章内容仅代表作者独立观点，不代表安全内参立场，转载目的在于传递更多信息。如有侵权，请联系 anquanneican@163.com。</p>","original","zhKind","complete","漏洞","复现","补丁","漏洞利用","网络设备","https://www.secrss.com/articles/95805","安全内参",{"_91":92,"_93":-5},"changelogVersion","2026-10-01T08:00","release"]
