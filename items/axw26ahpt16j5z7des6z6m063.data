[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795653635000,"id","axw26ahpt16j5z7des6z6m063","title","Microsoft 确认 Windows 更新后出现认证问题，CVE-2026-118737 补丁暂无完整修复","originalTitle","Microsoft confirms authentication issues after November updates","summary","Microsoft 确认 Windows Remote Procedure Call Runtime 存在高危远程代码执行漏洞 CVE-2026-118737，未认证攻击者可在无需用户交互的情况下利用尚未安装补丁的系统执行代码。","reason","Microsoft 说明了高危漏洞的利用前提与补丁进展，同时披露补丁可能引发的认证兼容问题及临时处置限制。","source",{"_72":97},"links",{"_89":96},"publishedAt","2026-11-25T09:02:57.000Z","discoveredAt","2026-11-25T09:21:33.171Z","timelineAt","category","vuln","tags",[93,94,75,95],"score",73,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","Sergiu Gatlan","body",{"_61":88,"_89":-5,"_90":91,"_92":37},"outline",[82],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fgtpvWN6bjcw","reportCount",1,"additionalSourceCount",0,{"_71":76,"_72":77},{"_71":74,"_72":75},{"_71":31,"_72":73},"slug","name","漏洞披露","identity","身份与访问","microsoft","Microsoft / 微软",{"_79":80,"_13":81},"publicId","2a3d5aa2-b9ee-445e-a6d3-f01827e40be5","Windows 11月更新后出现认证问题",{"_11":83,"_84":85,"_86":87},"sec-1","text","发现现有防御可能遗漏的电子邮件威胁。","level",2,"<p><img alt=\"Microsoft\" height=\"900\" src=\"/dailyinfo/media/6a3c33df04a3bdfc.jpg\" srcset=\"/dailyinfo/media/cb8fd2a2a71425a0.jpg 720w, /dailyinfo/media/d7792eb626bf0b8b.jpg 1200w, /dailyinfo/media/6a3c33df04a3bdfc.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>Microsoft 已确认，客户在安装 11 月安全更新后可能遇到身份验证问题。这些更新修复了一个严重级别的远程代码执行漏洞。</p><p>该安全缺陷被跟踪为 <a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-118737\">CVE-2026-118737</a>，存在于 Windows Remote Procedure Call Runtime 中，源于<a href=\"https://cwe.mitre.org/data/definitions/347.html\">一项依赖时序的身份验证弱点</a>。未经身份验证的攻击者可以利用该弱点，在未修补的系统上远程执行代码，且无需用户交互。</p><p>Microsoft 表示，11 月安全更新是 NTLM 消息签名改进的第一阶段，可通过确保经过身份验证的 NTLM 会话始终建立加密会话密钥并协商实际消息签名，来降低中继攻击带来的风险。</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/256305b98cea3e96.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>然而，正如 <a href=\"https://support.microsoft.com/en-us/servicing/os/windows/docs/2026/11/kb5135557-ntlm-signing-security-improvements#:~:text=Known%20issue\">Microsoft 在更新的支持文档中解释的那样</a>，为解决此漏洞而引入的新安全改进，也可能导致已修补设备出现身份验证失败。</p><p>它表示：“Microsoft 已知，兼容性问题会影响某些第三方应用和设备，包括身份验证代理服务器、单点登录 (SSO) 解决方案，以及使用 NTLM 身份验证的应用打包解决方案。”</p><p>它表示：“当此类代理设备未正确实现 NTLM 协议时，可能会出现此问题。例如，受影响的设备可能会在 CHALLENGE_MESSAGE 中设置 NTLMSSP_NEGOTIATE_TARGET_INFO 标志，但提供为空或不完整的 TargetInfo 字段。”</p><p>虽然尚无修复程序，但 Microsoft 表示，在网络跟踪签名中，受影响的应用和设备会返回 Target Info List 为空的 NTLMSSP_CHALLENGE 消息，或者在事件日志中，Target Machine 字段会显示“Not Found”值。</p><p>作为临时变通方法，该公司建议客户在受影响系统上执行以下步骤：</p><ul>\n\t<li>将 HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Control\\Lsa\\MSV1_0 下的 ClientAllowUnsignedNtlm REG_DWORD 注册表值设置为 1（该值用于不提供 SIGN 的客户端）</li>\n\t<li>检查受影响的设备或应用程序是否支持使用 Kerberos 身份验证的配置，或者供应商是否提供与 <a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-118737\">CVE-2026-118737</a> 引入的 NTLM 签名要求兼容的软件或固件更新。</li>\n\t<li>如果两种方案均不可用，请联系设备或软件供应商，请求提供符合 <a href=\"https://learn.microsoft.com/openspecs/windows_protocols/ms-nlmp/c0250a97-2940-40c7-82fb-20d208c71e96\">3.1.5.1.2 Client Receives a CHALLENGE_MESSAGE from the Server</a> 中所述 NTLM 协议要求的更新。</li>\n</ul><p>不过，Microsoft 表示，ClientAllowUnsignedNtlm 注册表设置是一种短期解决方案，未来可能会被移除。</p><p>它指出：“更新受影响的产品或使用兼容的身份验证配置是推荐的长期解决方案。”</p><p>自从<a href=\"https://www.bleepingcomputer.com/news/microsoft/microsoft-confirms-kb5132061-installation-issues-0x80070306-0x800f0989-0x800f0993-errors/\">解决了影响 2026 年 11 月累积更新的安装问题</a>后，Microsoft 还确认，本月的安全更新正在导致<a href=\"https://www.bleepingcomputer.com/news/microsoft/microsoft-confirms-windows-activation-failures-after-november-updates/\">Windows 激活失败</a>和<a href=\"https://www.bleepingcomputer.com/news/microsoft/microsoft-says-november-security-updates-cause-printing-issues/\">SQL Server 性能问题</a>。</p><p>该公司还在调查一个已知问题：对于安装了最新 Windows 更新的客户，该问题<a href=\"https://www.bleepingcomputer.com/news/microsoft/microsoft-says-november-security-updates-cause-printing-issues/\">可能导致文档打印中断</a>，尤其是格式复杂的文档。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/0f821b73ff70ca16.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体会分析电子邮件意图、上下文和行为，以发现网络钓鱼、企业电子邮件入侵和发票欺诈。</p><p>通过 14 天只读扫描查看 Microsoft 365 或 Google Workspace 中有哪些内容被成功传递，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始您的免费电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","漏洞","补丁","Microsoft","https://www.bleepingcomputer.com/news/microsoft/microsoft-confirms-authentication-issues-after-november-updates/","BleepingComputer",{"_99":100,"_101":-5},"changelogVersion","2026-10-01T08:00","release"]
