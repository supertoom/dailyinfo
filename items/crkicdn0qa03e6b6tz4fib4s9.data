[{"_1":2,"_3":4},"root",{"_5":95},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":61,"_62":63},"expiresAt",1794444092000,"id","crkicdn0qa03e6b6tz4fib4s9","title","Xen Orchestra 严重漏洞已遭利用，可绕过认证并接管 XCP-ng 节点","originalTitle","Critical Xen Orchestra Flaws Exploited in Attacks","summary","Xen Orchestra 严重漏洞已被真实利用，未认证攻击者可利用 REST 认证机制缺陷绕过认证并取得管理员权限，进而在托管资源池执行任意代码及以 root 接管 XCP-ng 节点。","reason","source",{"_75":94},"links",{"_63":93},"publishedAt","2026-11-11T15:42:47.000Z","discoveredAt","2026-11-11T16:13:11.810Z","timelineAt","category","vuln","tags",[90,76,91,92],"score",76,"selected",true,"channel","news","story",{"_81":82,"_13":83},"x","sameEvent",{"_11":88,"_13":89},"readingMode","full","author","Ionut Arghire","body",{"_84":-5,"_63":85,"_86":-5,"_87":61},"outline",[],"relatedStories",[80],"topics",[70,71,72],"indexable","markdownAvailable","group",{"_64":65,"_66":67,"_68":69},"hasTranslation",false,"bodyLanguage","original","factId","ftzf92C6BFf0","reportCount",3,"additionalSourceCount",2,{"_73":78,"_75":79},{"_73":30,"_75":77},{"_73":74,"_75":76},"slug","exploited","name","在野利用","漏洞披露","identity","身份与访问",{"_81":82,"_13":83},"publicId","02559d08-0e55-4bf8-8513-d59f4b9a82f9","Xen Orchestra认证绕过漏洞已遭利用","zh","<p><strong>A threat actor has been exploiting a critical-severity Xen Orchestra vulnerability to bypass authentication, software maker Vates warns.</strong>\n\n\n\n</p><p>A web-based backup, management, and disaster recovery solution for XCP-ng and XenServer virtualization environments, Xen Orchestra operates as an agentless control center across hosts, VMs, storage, and pools.\n\n\n\n</p><p>The exploited flaw exists in the REST authentication mechanism, where an authentication token is turned into {} and then treated as an unfiltered lookup, leading to the first token being returned by token collection. If the token is not expired, the provider authenticates as its owner.\n\n\n\n</p><p>This opens a route that exposes reusable login token IDs, allowing unauthenticated attackers to bypass authentication and gain administrator privileges.\n\n\n\n</p><p>“Xen Orchestra compromise can lead to arbitrary code execution on managed pools and a full XCP-ng node takeover as root,” <a href=\"https://docs.vates.tech/security-advisories/advisories/2026/vates-sa-2026-062/\">Vates says</a>.\n\n\n\n</p><p>The security defect impacts Xen Orchestra releases before 6.9.2 (stable) and 6.10.1 (latest), and Xen Orchestra Appliance, which contains Xen Orchestra.</p><p><span>Advertisement. Scroll to continue reading.</span></p><p>Vates also disclosed a <a href=\"https://docs.vates.tech/security-advisories/advisories/2026/vates-sa-2026-063/\">second vulnerability</a> that the same threat actor exploited using administrator privileges. The flaw allows malicious VM imports that could compromise XCP-ng hosts, and a fix is still being developed.\n\n\n\n</p><p>Vates says a threat actor operating initially from 91.211.251.112:8001 and via the Tor network has been exploiting the vulnerabilities. No CVE identifier has been assigned to the security defects.\n\n\n\n</p><p>The company warns that unauthorized access is not logged, but has shared indicators of compromise (IoCs) associated with the observed attacks, and warns that they are limited to this specific campaign.\n\n\n\n</p><p>“Exploitation of the vulnerability by other threat actors using different TTPs and infrastructure cannot be ruled out. The absence of these IoCs alone is not sufficient to conclude that no compromise has occurred,” Vates notes.\n\n\n\n</p><p>The company recommends placing Xen Orchestra instances behind a dedicated network, blocking IP addresses and domain names associated with known malicious activity, blocking the empty token in a WAF rule, and rotating all potentially compromised credentials.\n\n\n\n</p><p>“In case of a confirmed compromise, a full reinstallation is recommended as cleanup alone cannot guarantee the removal of all backdoors left by the attacker,” Vates says.\n\n\n\n</p><p><strong>Related:</strong> <a href=\"https://www.securityweek.com/asus-zoom-release-security-patches/\">Asus, Zoom Release Security Patches</a>\n\n\n\n</p><p><strong>Related:</strong> <a href=\"https://www.securityweek.com/citrix-ivanti-patch-critical-and-high-severity-vulnerabilities/\">Citrix, Ivanti Patch Critical and High-Severity Vulnerabilities</a>\n\n\n\n</p><p><strong>Related:</strong> <a href=\"https://www.securityweek.com/threat-actors-exploit-openwave-cisco-broadworks-vulnerabilities/\">Threat Actors Exploit Openwave, Cisco BroadWorks Vulnerabilities</a>\n\n\n\n</p><p><strong>Related:</strong> <a href=\"https://www.securityweek.com/exploited-outlook-zero-day-among-1094-flaws-patched-by-microsoft/\">Exploited Outlook Zero-Day Among 1,094 Flaws Patched by Microsoft</a>\n\n\n\n</p>","zhKind","complete","x7edhu1rfhikbjr5w193xldog","Vates VMS 披露 Xen Orchestra 认证绕过漏洞 VSA-2026-062 已被利用","漏洞","漏洞利用","凭据","https://www.securityweek.com/critical-xen-orchestra-flaws-exploited-in-attacks/","SecurityWeek",{"_96":97,"_98":-5},"changelogVersion","2026-10-01T08:00","release"]
