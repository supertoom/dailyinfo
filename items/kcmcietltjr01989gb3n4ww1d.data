[{"_1":2,"_3":4},"root",{"_5":68},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1795740039000,"id","kcmcietltjr01989gb3n4ww1d","title","中国网络安全产业联盟发布《中国网络安全产业分析报告（2026年）》","originalTitle","《中国网络安全产业分析报告（2026年）》发布","summary","中国网络安全产业联盟（CCIA）连续第九年发布《中国网络安全产业分析报告（2026年）》，基于我国网络安全企业调研数据，分析产业供需、市场、法律法规、资本市场、发展热点与趋势，并研判人工智能对网络安全产业的影响。报告面向网络安全主管部门、监管机构、从业人员、行业组织和研究机构。","reason","source",{"_66":67},"links",{"_60":65},"publishedAt","2026-11-26T04:41:28.910Z","discoveredAt","2026-11-26T10:41:28.922Z","timelineAt","category","policy","tags",[63,64],"score",8,"selected",false,"channel","news","story","x","readingMode","full","author","body",{"_58":59,"_60":-5,"_61":60,"_62":54},"outline",[],"relatedStories",[],"topics",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","zh","<p>《中国网络安全产业分析报告（2026年）》（以下简称《报告》）由中国网络安全产业联盟（CCIA）连续第九年发布。</p><p>《报告》以网络安全行业调研数据为基础，以具备网络安全产品、服务和解决方案销售收入的我国网络安全企业为目标研究对象，立足国际与国内双重视角，系统呈现了2026年我国网络安全产业发展总体形势，以及面临的相关挑战。从产业供需两侧，全面剖析了网络安全市场全貌及资本市场运行态势，对网络安全法律法规、政策标准、产业现状、资本市场、发展热点和趋势展望等方面进行了全面分析。同时，今年针对人工智能对网络安全产业的具体影响开展针对性研判。希望《报告》能够为网络安全主管部门、监管机构、从业人员、行业组织、研究机构等提供参考。</p><p><img src=\"/dailyinfo/media/24d6aa4d496ea388.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img src=\"/dailyinfo/media/ebc14c29e6a8d80d.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img src=\"/dailyinfo/media/d57c10864a3bd865.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img src=\"/dailyinfo/media/40b168c17174090c.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img src=\"/dailyinfo/media/e9fc993723634941.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img src=\"/dailyinfo/media/32591865591b0a38.webp\" loading=\"lazy\" decoding=\"async\"></p><p>声明：本文来自CCIA网安产业联盟，版权归作者所有。文章内容仅代表作者独立观点，不代表安全内参立场，转载目的在于传递更多信息。如有侵权，请联系 anquanneican@163.com。</p>","original","zhKind","complete","行业动态","汇总","https://www.secrss.com/articles/96022","name","安全内参",{"_69":70,"_71":-5},"changelogVersion","2026-10-01T08:00","release"]
