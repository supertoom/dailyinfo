[{"_1":2,"_3":4},"root",{"_5":93},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1793591188000,"id","m2hxnar81fkukx8bj4wepsqav","title","CISA 将两项 Ivanti Connect Secure 漏洞纳入 KEV Catalog","originalTitle","CISA Adds Two Known Exploited Vulnerabilities to Catalog","summary","CISA 基于真实利用证据，将 Ivanti Connect Secure 的 CVE-2026-111357（关键功能缺失认证）和 CVE-2026-118527（可预测数字或标识符生成漏洞）纳入 KEV Catalog。","reason","两项 Ivanti Connect Secure 漏洞已有真实利用证据，并被纳入 KEV Catalog，读者可据此核对资产暴露与修复优先级。","source",{"_74":92},"links",{"_85":91},"publishedAt","2026-10-30T12:00:00.000Z","discoveredAt","2026-10-30T18:57:15.938Z","timelineAt","category","vuln","tags",[75,78,89,90,46],"score",70,"selected",true,"channel","news","story",{"_81":82,"_13":83},"x","readingMode","full","author","CISA","body",{"_61":84,"_85":-5,"_86":87,"_88":37},"outline",[],"relatedStories",[80],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fHtxLTvYwTdg","reportCount",2,"additionalSourceCount",1,{"_72":79,"_74":46},{"_72":77,"_74":78},{"_72":31,"_74":76},{"_72":73,"_74":75},"slug","exploited","name","在野利用","漏洞披露","vuln-mgmt","漏洞管理","cisa",{"_81":82,"_13":83},"publicId","7b68ec92-29a4-4b08-8b7d-6c1631d5b488","CISA纳入两个已被利用的Ivanti漏洞","<p>CISA 根据主动利用的证据，将两个新漏洞添加到了其<a href=\"https://www.cisa.gov/known-exploited-vulnerabilities-catalog\">已知被利用漏洞目录（KEV Catalog）</a>中。</p><ul>\n<li><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-111357\">CVE-2026-111357</a> Ivanti Connect Secure 关键功能缺失身份验证漏洞</li>\n<li><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-118527\">CVE-2026-118527</a> Ivanti Connect Secure 可预测数字或标识符生成漏洞</li>\n</ul><p>此类漏洞是恶意网络行为者频繁采用的攻击途径，并对联邦企业构成重大风险。&nbsp;</p><p><a href=\"https://www.cisa.gov/news-events/directives/bod-26-04-implementation-guidance-prioritizing-security-updates-based-risk\">约束性运营指令（BOD）26-04：基于风险确定安全更新的优先级</a>为联邦文职行政部门（FCEB）机构确立了漏洞管理要求。BOD 26-04 强调 KEV Catalog 的重要性，并要求联邦机构优先快速修复高风险漏洞，具体而言，是优先修复 CISA 的 KEV Catalog 中所列出的、存在于公开暴露资产上且在利用后可完全控制该资产的常见漏洞与披露（CVE），同时将较低风险漏洞的处置推迟。BOD 26-04 还进一步规定了机构在应用补丁之前必须核查威胁行为者是否已入侵系统的基本要求。&nbsp;</p><p>虽然 BOD 26-04 仅适用于 FCEB 机构，但 CISA 鼓励所有组织采用基于风险的漏洞管理方法，并优先修复<a href=\"https://www.cisa.gov/known-exploited-vulnerabilities-catalog\">KEV Catalog 中的漏洞</a>。CISA 将继续向该目录添加符合<a href=\"https://www.cisa.gov/known-exploited-vulnerabilities\">指定标准</a>的漏洞。&nbsp;</p><p>了解到某个已遭利用但目前未列入 KEV Catalog 的漏洞？请通过 CISA 的<a href=\"https://cisasurvey.gov1.qualtrics.com/jfe/form/SV_1Zwu52kgK2OYf3w\">KEV 提名表单</a>提交，以供考虑添加。潜在新增 KEV 必须具备 CVE ID、利用证据以及明确的缓解指导。</p>","original","zhKind","translation","complete","补丁","Ivanti","https://www.cisa.gov/news-events/alerts/2026/10/30/cisa-adds-two-known-exploited-vulnerabilities-catalog","CISA 安全公告",{"_94":95,"_96":-5},"changelogVersion","2026-10-01T08:00","release"]
