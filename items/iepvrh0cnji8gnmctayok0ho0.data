[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795912839000,"id","iepvrh0cnji8gnmctayok0ho0","title","Rackspace Spot 云平台遭入侵，攻击者读取客户 Kubernetes Secrets","originalTitle","Rackspace Spot breach let hackers access customer Kubernetes secrets","summary","攻击者使用泄露凭据入侵 Rackspace Spot 云平台，在部分客户组织中以合法用户身份创建 Kubernetes Pod、读取 Secrets，并列出节点和卷，受害凭据可能包括密码、认证令牌、API 密钥及 Spot API 令牌。","reason","原文给出入侵时间窗、攻击者权限、泄露凭据类型和完整 IOC，客户可据此回溯集群、数据库及第三方服务中的异常访问。","source",{"_74":103},"links",{"_93":102},"publishedAt","2026-11-21T22:59:58.000Z","discoveredAt","2026-11-21T23:50:45.254Z","timelineAt","category","activity","tags",[75,97,98,99,100,101],"score",72,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Lawrence Abrams","body",{"_61":92,"_93":-5,"_94":95,"_96":37},"outline",[86],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fj03jCkbVOtE","reportCount",1,"additionalSourceCount",0,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","attack","name","攻击活动","identity","身份与访问","cloud-native","云与原生","supply-chain","供应链安全",{"_83":84,"_13":85},"publicId","7c44fd72-6461-4820-a32e-0d73940fd3c1","Rackspace关闭Spot云平台应对入侵",{"_11":87,"_88":89,"_90":91},"sec-1","text","发现现有防御可能遗漏的电子邮件威胁。","level",2,"<p><img alt=\"Rackspace\" height=\"900\" src=\"/dailyinfo/media/36fb58ddbacccbf7.jpg\" srcset=\"/dailyinfo/media/bd86c30173f4ff86.jpg 720w, /dailyinfo/media/16434394645ea4fb.jpg 1200w, /dailyinfo/media/36fb58ddbacccbf7.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>Rackspace 警告客户，黑客使用泄露的凭据入侵了其 Rackspace Spot 云平台，从而得以部署未经授权的工作负载，并访问客户集群中的 Kubernetes Secrets。</p><p>Rackspace Spot 是一个云平台，允许组织使用 Kubernetes 部署和管理容器化应用程序。</p><p>该公司在发送给受影响客户、并由 BleepingComputer 获得的一份&nbsp; 通知中披露了此次入侵，称攻击者于 November 17, 2026 之间约 00:20 至 22:00 UTC 访问了平台的部分内容。</p><p><a href=\"https://www.wiz.io/lp/claude-code-security-best-practices-cheat-sheet?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q3_INB_FORM_Claude-Code-Security-Best-Practices&amp;sfcid=701Vh00000gJQZuIAO&amp;utm_term=FY27Q4-bleepingcomputer-article-970x250-Nov&amp;utm_content=Claude-Code-Best-Practices\"><img src=\"/dailyinfo/media/7a5a3a6292d5f413.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>Rackspace 表示，公司在收到客户报告后于 November 18 得知此次入侵，并于当天确认报告方的组织受到了影响。</p><p>通知中写道：“On 17 November 2026 (about 00:20–22:00 UTC), an unauthorized party used leaked credentials to access parts of Rackspace Spot,”</p><p>据 Rackspace 称，攻击者能够在一些客户组织中以合法用户的身份操作，从而在 Kubernetes 集群中创建 Pod、读取 Kubernetes Secrets，并列出节点和卷。</p><p>Kubernetes Secrets 存储密码、身份验证令牌和 API 密钥等敏感信息，这些信息可用于访问数据库、云服务及其他系统。</p><p>Rackspace 警告称，攻击者可能读取了受影响用户集群中存储的所有 Secret，以及该用户持有的所有 Spot API 令牌或刷新令牌。</p><p>该公司表示，此后已撤销受影响的令牌和会话、移除未经授权的 Pod、轮换密钥，并加强访问控制和监控。</p><p>受影响客户已被要求重新签发其 Spot API 令牌，替换自动化工具中使用的刷新令牌，下载最新的 Kubernetes 配置文件，并轮换其集群 Secrets 中存储的凭据。</p><p>Rackspace 还建议客户分析 November 17 以来与数据库、容器注册表、Git 存储库、云存储和第三方服务相关的日志，以确定暴露的凭据是否遭到滥用。</p><p>该公司公布了与此次攻击相关的以下失陷指标：</p><ul>\n\t<li><strong>IP 地址：</strong> 23.224.79.106</li>\n\t<li><strong>IP 范围：</strong> 23.224.0.0/15</li>\n\t<li><strong>可疑 Kubernetes Pod 和对象前缀：</strong> i1、glm- 和 probe</li>\n</ul><p>BleepingComputer 联系 Rackspace，询问有多少客户受到影响以及客户数据是否被盗，但尚未收到回应。</p><p>此次入侵还导致 Rackspace Spot 管理控制台长时间中断服务，暂时使客户无法管理其集群或轮换可能已遭泄露的凭据。</p><p>在与 Rackspace 共同开发 Rackspace Spot 的 Platform9 联合创始人兼首席增长官 Sirish Raghuram 参与的一篇 <a href=\"https://www.reddit.com/r/rxt_spot/comments/1xzrao7/rackspace_spot_down_right_now/\">Reddit 讨论</a>中，他解释道，公司在保护其基础设施期间有意禁用了访问权限。</p><p>Raghuram 表示：“我一直在推动创建 Spot 以及迄今为止的运营工作，我可以告诉各位，团队和我对以这种方式辜负大家的期望深感失望。”</p><p>他说：“我知道你们不同意，但我们作出了这样的决定：关闭所有访问权限并对整个环境进行清理，是尽所能保护所有 Spot 用户的最佳方式。”</p><p>在多次延期后，Rackspace <a href=\"https://www.reddit.com/r/rxt_spot/comments/1y22b0d/service_fully_restored/\">宣布</a>服务已于 November 21 完全恢复。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/1f6f9d6dc9ced8f5.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体会分析邮件意图、上下文和行为，以发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>通过为期 14 天的只读扫描查看 Microsoft 365 或 Google Workspace 中有哪些邮件得以通过，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始免费的电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","数据泄露","凭据","云原生","容器","供应链","https://www.bleepingcomputer.com/news/security/rackspace-spot-breach-let-hackers-access-customer-kubernetes-secrets/","BleepingComputer",{"_105":106,"_107":-5},"changelogVersion","2026-10-01T08:00","release"]
