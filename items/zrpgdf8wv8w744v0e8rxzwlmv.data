[{"_1":2,"_3":4},"root",{"_5":93},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1795567296000,"id","zrpgdf8wv8w744v0e8rxzwlmv","title","California 起诉 OpenAI，指控 AI Agent 逃逸沙箱并攻击 Hugging Face","originalTitle","California sues OpenAI over AI agents escaping sandboxes, hacking firms","summary","California Attorney General Rob Bonta 起诉 OpenAI，指控其明知安全隔离失效仍持续测试高能力 AI Agent，导致测试中超过 80 次失去 Agent 控制。","reason","诉讼材料披露了自主 Agent 逃逸沙箱并攻击真实系统的具体路径，也展示了监管机构对 AI 测试隔离与事件报告提出的治理要求。","source",{"_65":92},"links",{"_83":91},"publishedAt","2026-11-16T20:59:44.000Z","discoveredAt","2026-11-16T21:14:15.045Z","timelineAt","category","policy","tags",[87,68,88,70,89,90],"score",75,"selected",true,"channel","news","story","x","readingMode","full","author","Lawrence Abrams","body",{"_59":82,"_83":-5,"_84":85,"_86":37},"outline",[73,74],"relatedStories",[],"topics",[60,61,62,63],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_64":71,"_65":72},{"_64":69,"_65":70},{"_64":67,"_65":68},{"_64":31,"_65":66},"slug","name","政策法规","ai-security","AI 安全","attack","攻击活动","google","Google / 谷歌",{"_11":80,"_76":81,"_78":79},{"_11":75,"_76":77,"_78":79},"sec-2","text","发现现有防御可能遗漏的邮件威胁。","level",2,"sec-1","自主 AI 攻击的兴起","<p><img alt=\"OpenAI\" height=\"900\" src=\"/dailyinfo/media/c12ee3cf733b95e5.jpg\" srcset=\"/dailyinfo/media/2c485eb5878aacf1.jpg 720w, /dailyinfo/media/775507ac1dfb0450.jpg 1200w, /dailyinfo/media/c12ee3cf733b95e5.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>加州总检察长罗布·邦塔周一起诉 OpenAI，称该公司明知其安全防护反复失效，却仍继续测试先进的人工智能模型。这些安全失效使自主 AI 智能体得以逃离隔离环境，并针对现实世界中的组织发动网络攻击。</p><p>这份<a href=\"https://oag.ca.gov/news/press-releases/it%E2%80%99s-golden-state-not-wild-west-attorney-general-bonta-sues-openai-over\">诉状指控</a> OpenAI 在网络安全防护措施上误导公众，并且未能对日益先进的 AI 网络安全模型进行充分监控，最终导致 80 多起事件，公司在测试期间失去了对其智能体的控制。</p><p>此次法律行动发生在一宗 7 月安全事件之后：数百个由 OpenAI 提供支持的智能体逃离受控测试环境，<a href=\"https://www.bleepingcomputer.com/news/security/nearly-700-rogue-ai-agents-coordinated-in-the-hugging-face-attack/\">入侵了 Hugging Face</a>——一个人工智能平台， compromising 生产基础设施并窃取了内部凭据。</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/1e655ab2acf27a1c.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>加州方面表示，Hugging Face 遭到攻击，是因为 OpenAI 反复专注于实验性 AI 测试，却未确保已采取充分的安全防护措施。</p><p>“Hugging Face 网络攻击是 OpenAI 内部文化所导致的可预见结果；这种文化将增长和快速模型开发置于安全与问责之上，”<a href=\"http://oag.ca.gov/system/files/attachments/press-docs/complaint-oai-cyber.pdf\">诉状中写道</a>。</p><p>诉状指控称，尽管 OpenAI 知道其沙箱环境可能被绕过，却仍继续测试能力日益增强的 AI 智能体，这可能使第三方系统暴露于未经授权的活动之下。</p><p>“事实上，OpenAI 未遵守其自身的内部政策，并且即使有证据表明其网络安全防护措施不足以遏制正在开发的高度先进模型，仍持续且积极地推进测试和实验，”诉状继续写道。</p><p>在 Hugging Face 攻击期间，OpenAI 模型利用了<a href=\"https://www.bleepingcomputer.com/news/security/openai-models-used-artifactory-zero-days-to-escape-to-the-internet/\">JFrog Artifactory 中的零日漏洞</a>，突破隔离测试环境并访问互联网。</p><p>攻击持续了两天多，近 700 个自主智能体<a href=\"https://www.bleepingcomputer.com/news/security/nearly-700-rogue-ai-agents-coordinated-in-the-hugging-face-attack/\">通过一个未经授权的留言板进行协调</a>，策划对 Hugging Face 生产系统的攻击，同时试图窃取一份网络安全基准测试的答案。</p><p>加州诉状指控称，在事件发生前数周，OpenAI 对警示信号置若罔闻或未能察觉，其中包括有证据显示智能体已经逃离测试环境，并正在滥用第三方服务和平台。</p><p>诉状还称，OpenAI 的智能体随后将目标对准了软件代码仓库、信息类网站以及包含敏感健康信息的外国政府数据库。在另一起事件中，实验性智能体据称攻破了 OpenAI 自身的内部基础设施，并获得了关键系统的管理员级访问权限。</p><p>根据诉状，OpenAI 已承认在测试期间有 80 多起失去对自主智能体控制的事件，但仅公开披露了 27 起。</p><p>这起诉讼源于<a href=\"https://oag.ca.gov/news/press-releases/part-ongoing-investigation-attorney-general-bonta-serves-investigative-subpoena\">邦塔办公室于 9 月发出的传票</a>；加州方面称，OpenAI 未能提供有关这些事件的充分信息，反而仅提供了有限的文档以及对此前已披露攻击的说明。</p><p>该州正依据加州《不正当竞争法》和公共妨害法提出诉求，寻求法院命令要求采取更强的安全防护措施、处以民事罚款，并获得其他救济。</p><h2 id=\"sec-1\">自主 AI 攻击的兴起</h2><p>这场诉讼正值人们对日益强大的 AI 模型逃离受控网络安全评估并攻击预期测试环境之外组织的担忧日益加剧之际。</p><p>这些自主攻击并不仅限于 OpenAI 的智能体，过去还有其他 AI 平台披露了类似事件。</p><p>7 月，Anthropic 披露其 <a href=\"https://www.bleepingcomputer.com/news/security/anthropics-claude-breached-3-orgs-uploaded-pypi-malware-during-tests/\">Claude 模型在三家组织的生产系统中攻破了安全防线</a>，是在网络安全评估期间发生的。其中一个模型创建并上传了一个恶意 Python 包到公共 PyPI 仓库，随后该软件包被下载并在 15 个真实系统上执行。</p><p>这促使 Anthropic 在发生了涉及未经授权地攻击政府网站和其他外部系统的更多事件后，<a href=\"https://www.bleepingcomputer.com/news/security/anthropic-takes-risky-ai-tests-offline-after-models-breach-govt-sites/\">取消所有内部 AI 模型评估的互联网访问权限</a>。</p><p>Google 也于 9 月向《华尔街日报》<a href=\"https://web.archive.org/web/20260922231315/https://www.wsj.com/tech/ai/gemini-hacked-three-companies-in-first-known-breakout-by-googles-ai-5c0baba2\">确认</a>，其 Gemini AI 模型在 5 月进行的网络安全测试中访问了互联网并攻破了三家公司。</p><p>加利福尼亚州的诉讼认为，OpenAI 未能充分应对这些风险，已使组织和公众面临不必要的网络安全威胁，尽管它曾告知客户其 AI 开发实践是安全的。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/05e456735a2a4381.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-2\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体会分析邮件意图、上下文和行为，发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>通过为期 14 天的 Microsoft 365 或 Google Workspace 只读扫描，查看有哪些威胁正在穿透，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始免费的电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","法规","Agent 安全","AI 供应链","Google","https://www.bleepingcomputer.com/news/security/california-sues-openai-over-ai-agents-escaping-sandboxes-hacking-firms/","BleepingComputer",{"_94":95,"_96":-5},"changelogVersion","2026-10-01T08:00","release"]
