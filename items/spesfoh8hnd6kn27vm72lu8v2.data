[{"_1":2,"_3":4},"root",{"_5":173},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1794616834000,"id","spesfoh8hnd6kn27vm72lu8v2","title","SCKit滥用ScreenConnect入侵MSP客户环境并攻击技术支持工作站","originalTitle","SCKit abuses ScreenConnect to deploy remote access and target technician sessions","summary","Microsoft Threat Intelligence确认，威胁者自2026年11月11日起利用托管服务商（MSP）的ScreenConnect实例，部署SCKit恶意蠕虫和未授权远程客户端，进而攻击IT支持人员工作站并扩大管理控制台权限。","reason","source",{"_75":172},"links",{"_163":171},"publishedAt","2026-11-13T21:31:44.000Z","discoveredAt","2026-11-13T22:04:27.577Z","timelineAt","category","activity","tags",[78,76,80,169,170],"score",75,"selected",true,"channel","news","story",{"_84":85,"_13":86},"x","sameEvent",{"_11":167,"_13":168},"readingMode","full","author","Microsoft Security Research, Sagar Patil and Jeremiah Jasmin","body",{"_62":162,"_163":-5,"_164":165,"_166":36},"outline",[87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110],"relatedStories",[83],"topics",[69,70,71,72],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","fVVoyiSN8gs4","reportCount",3,"additionalSourceCount",2,{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","malware","name","恶意软件","attack","攻击活动","exploited","在野利用","microsoft","Microsoft / 微软",{"_84":85,"_13":86},"publicId","4c4f0d1f-c78b-4aee-8605-fa5f25c7bd8c","SCKit攻击波及48家机构288个端点",{"_11":160,"_112":161,"_114":68},{"_11":158,"_112":159,"_114":66},{"_11":156,"_112":157,"_114":66},{"_11":154,"_112":155,"_114":68},{"_11":152,"_112":153,"_114":66},{"_11":150,"_112":151,"_114":66},{"_11":148,"_112":149,"_114":66},{"_11":146,"_112":147,"_114":66},{"_11":144,"_112":145,"_114":66},{"_11":142,"_112":143,"_114":66},{"_11":140,"_112":141,"_114":66},{"_11":138,"_112":139,"_114":68},{"_11":136,"_112":137,"_114":119},{"_11":134,"_112":135,"_114":119},{"_11":132,"_112":133,"_114":66},{"_11":130,"_112":131,"_114":66},{"_11":128,"_112":129,"_114":66},{"_11":126,"_112":127,"_114":66},{"_11":124,"_112":125,"_114":68},{"_11":122,"_112":123,"_114":119},{"_11":120,"_112":121,"_114":119},{"_11":117,"_112":118,"_114":119},{"_11":115,"_112":116,"_114":68},{"_11":111,"_112":113,"_114":68},"sec-24","text","了解更多","level","sec-23","参考","sec-22","客户端标识符和行为工件",4,"sec-21","文件哈希","sec-20","网络基础设施","sec-19","失陷指标和辅助工件","sec-18","高级搜寻查询","sec-17","Microsoft Defender XDR 威胁分析与 Secure Now","sec-16","威胁情报报告","sec-15","Microsoft Defender XDR 检测","sec-14","移除已建立的访问权限","sec-13","保护 ScreenConnect 管理控制台和技术员客户端","sec-12","缓解和保护指南","sec-11","7. 清理和重新部署","sec-10","6. 浏览器访问针对已认证的 ScreenConnect 会话","sec-9","5. RelayTrap 添加持久化机制并针对连接的技术人员","sec-8","4. 其他组件：PowerShell 脚本加载器","sec-7","3. 解码器解密并提取 SCKit 捆绑包","sec-6","2. 批处理启动器获取 PowerShell 解码器","sec-5","1. ScreenConnect 命令安装附加客户端","sec-4","攻击链概览","sec-3","从客户端点到技术人员的另一条路径","sec-2","据报道可通过扩展实现服务器端入侵","sec-1","ScreenConnect 架构与攻击面","<ol><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/13/sckit-abuses-screenconnect-deploy-remote-access-target-technician-sessions/#screenconnect-architecture-and-attack-surfaces\">ScreenConnect 架构与攻击面</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/13/sckit-abuses-screenconnect-deploy-remote-access-target-technician-sessions/#attack-chain-overview\">攻击链概览</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/13/sckit-abuses-screenconnect-deploy-remote-access-target-technician-sessions/#mitigation-and-protection-guidance\">缓解与保护指南</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/13/sckit-abuses-screenconnect-deploy-remote-access-target-technician-sessions/#indicators-of-compromise-and-supporting-artifacts\">失陷指标与配套工件</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/13/sckit-abuses-screenconnect-deploy-remote-access-target-technician-sessions/#references\">参考资料</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/13/sckit-abuses-screenconnect-deploy-remote-access-target-technician-sessions/#learn-more\">了解更多</a></li></ol><p>自 2026 年 11 月 11 日起，ConnectWise 报告称，有一个威胁行为体正在积极发起攻击活动，未授权访问托管服务提供商（MSP）拥有的云托管 ConnectWise ScreenConnect 实例。Microsoft Threat Intelligence 已确认 ConnectWise 报告的活动，并且我们还观察到威胁行为体滥用 ScreenConnect 这一合法的远程支持应用程序，在 ConnectWise 客户管理的端点上安装未经授权的远程访问客户端，并部署恶意蠕虫 SCKit。</p><p>此外，Microsoft 分析了这款恶意蠕虫的行为：部署过程首先通过 ScreenConnect 发出命令，静默安装一个连接到威胁行为体控制基础设施的同类客户端。一个批处理启动器会获取 PowerShell 解码器，使用特定于设备的密钥材料解密并提取 SCKit。该工具包通过计划任务和注册表 Run 项建立持久化，并部署 RelayTrap——这是一个旨在向连接的技术人员投递恶意载荷的组件。</p><p>我们发现，该蠕虫利用被劫持且通过身份验证的 ScreenConnect 会话 targeting IT 支持技术人员的工作站，并使用受害者的管理控制台向其他受管设备分发载荷。由此获得的访问权限，无论针对哪个目标，都使威胁行为体能够独立于合法的支持实例远程管理受影响端点、执行命令并部署更多工具。</p><p>防御人员应调查技术人员工作站以及下游受影响端点。仅移除未经授权的客户端并不能移除该工具包的持久化机制，也无法使已暴露的 Web 会话失效。在本博客中，我们 examines SCKit 的攻击链和载荷组件，并提供缓解指南、失陷指标以及 Microsoft Defender XDR 高级搜寻查询，帮助组织识别并阻断此类活动。</p><h2 id=\"sec-1\"><strong>ScreenConnect 架构与攻击面</strong><strong></strong></h2><p>ScreenConnect（原名 ConnectWise Control）是一个远程支持和访问平台，MSP 通常将其与远程监控和管理（RMM）软件配合使用，以管理客户设备。其运行模式由三个部分组成：</p><ul>\n<li><strong>管理实例。</strong> 云托管或本地部署的 ScreenConnect 服务器提供 Web 控制台并管理会话。其中继服务负责承载技术人员与端点客户端之间的通信。</li>\n\n\n\n<li><strong>技术人员工作站。</strong> 支持人员通过浏览器登录控制台，并启动本地主机客户端以进行交互式支持。</li>\n\n\n\n<li><strong>客户端点。</strong> 已安装的客户端（或访问）客户端维持无人值守访问，并执行通过 ScreenConnect 传递的命令。</li>\n</ul><p>Access 会话通过已安装的客户端提供持久、无人值守的访问。Support 会话则是最终用户为获得协助而加入的临时连接。ScreenConnect 还支持<a href=\"https://www.screenconnect.com/blog/6-tips-for-connectwise-control-partners\">通过 Web 控制台执行远程命令</a>，无需交互式技术人员会话。端点客户端接收命令并在客户设备上运行；技术人员工作站并非该执行过程的中介。</p><h3 id=\"sec-2\"><strong>据报道可通过扩展实现服务器端入侵</strong><strong></strong></h3><p><a href=\"https://www.screenconnect.com/features/extensions\">扩展</a>是安装在 ScreenConnect 服务器上的插件，用于添加功能或与其他产品集成，包括工单系统和 RMM 工具。ConnectWise Automate 之前名为 LabTech；Labtech Plus 是一个第三方扩展，并非 Automate 产品本身。RMM+ 扩展系列公开了远程命令 API，这些 API 由单独配置的口令保护，而不是由技术人员的正常控制台登录凭据保护。</p><p><a href=\"https://www.connectwise.com/company/trust/advisories\">ConnectWise 的公告</a>描述了 RMM+ 1.0.31 和 1.0.32 版本中据报道存在的一个身份验证缺陷：未配置访问密钥时，该扩展会接受空密钥。在这种配置下，未经授权的调用者可以向服务器的 API 提交命令，并将其发送至受管理端点，无需进行正常的 ScreenConnect 用户登录。ConnectWise 正在调查扩展滥用作为初始访问途径；据报道的攻击活动所采用的入口方法仍在调查中。</p><h3 id=\"sec-3\"><strong>从客户端点到技术人员的另一条路径</strong><strong></strong></h3><p>SCKit 是一种恶意软件工具包，其中包含 RelayTrap——这是受影响客户端点上 ScreenConnect 客户端的恶意替代品。RelayTrap 旨在技术人员为提供支持而连接时，将有效载荷交付到技术人员的工作站。ConnectWise 表示，CVE-2026-84869 的修复措施阻止了该工具包试图从端点扩散至技术人员的活动。这条客户端攻击路径与用于部署 SCKit 的服务器端访问路径相互独立。</p><figure><img src=\"/dailyinfo/media/eec1d2b24855902c.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption><em>图 1. ScreenConnect 的三种操作角色和两个不同的攻击面。据报道的 RMM+ 入侵路径针对的是服务器端扩展；RelayTrap 针对的是连接人员工作站上的客户端。</em></figcaption></figure><h2 id=\"sec-4\"><strong>攻击链概览</strong></h2><p>下面的部署序列在客户端点上运行。它建立一条独立的远程访问连接，并准备用于针对后续技术人员的脚本和 RelayTrap 组件</p><figure><img src=\"/dailyinfo/media/88811c352dbc8a4f.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption><em>图 2. SCKit 在客户端点上的部署及其针对技术人员的功能。虚线路径描述的是该工具包的传播设计，并非已确认的感染序列。</em></figcaption></figure><h3 id=\"sec-5\"><strong>1. ScreenConnect 命令安装附加客户端</strong></h3><p>威胁行为者使用 MSP 的 ScreenConnect 管理实例，指示已安装的端点客户端启动 cmd.exe。该本地进程调用 curl.exe，通过 HTTP 从攻击者控制的 ScreenConnect 服务器下载 MSI。该命令请求 /Bin/ScreenConnect.ClientSetup.msi，并附带访问会话参数和 c=Exploited&lt;N&gt; 标记（所示命令中为 c=Exploited9），然后将安装程序保存至 C:\\Windows\\Temp\\sc.msi。</p><figure><img src=\"/dailyinfo/media/8fdb2619f4343341.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption><em>图 3. 通过 ScreenConnect 交付并在客户端点上执行的命令，用于下载客户端 MSI。攻击者控制服务器的 IP 已做隐去处理。</em></figcaption></figure><p>随后，Windows Installer 使用 /i、/qn 和 /norestart 在该端点上静默安装该软件包，且不重启端点。新增客户端连接到攻击者控制的 ScreenConnect 实例，从而建立一条独立于 MSP 认可实例的远程访问通道。仅保护对合法控制台的访问，并不会移除这个附加客户端或其连接。</p><h3 id=\"sec-6\"><strong>2. 批处理启动器获取 PowerShell 解码器</strong><strong></strong></h3><p>在客户终端上执行更多命令来暂存该工具包。一条 PowerShell 命令对 URL 安全的 Base64 字符串进行解码，并将结果写入 Windows Temp 目录中的批处理文件。该批处理将 BATPATH 设置为其自身所在位置，从 ns[.]mo7sen[.]dev/EadF.php?p=4 下载解码器，并使用 -Mode full 启动它。</p><p>解码器读取 BATPATH；如果不存在，则回退到 SCKIT_SELF，以定位启动器。其隐藏重新启动分支会创建一个 VBScript 包装器，并通过 wscript.exe 运行该包装器，以在无可见窗口的情况下启动同一个批处理文件。</p><p>这些脚本在相同的服务器路径上使用以下 p 值请求各个组件：</p><figure><table><tbody><tr><td><strong>请求选择器</strong></td><td><strong>组件</strong></td><td><strong>在链中的作用</strong></td></tr><tr><td>p=4</td><td>解码器</td><td>下载、解密并展开工具包</td></tr><tr><td>p=3&amp;m=&lt;machine-guid&gt;</td><td>加密捆绑包</td><td>携带脚本、配置和陷阱组件</td></tr><tr><td>p=5</td><td>SQLite 实用工具</td><td>支持查询浏览器 Cookie 数据库</td></tr><tr><td>p=1&amp;m=&lt;machine-guid&gt;</td><td>加密脚本</td><td>为加载器提供下一阶段的 PowerShell 脚本</td></tr><tr><td>p=6&amp;m=&lt;machine-guid&gt;</td><td>清理组件</td><td>在可选的重新部署之前移除旧陷阱</td></tr></tbody></table></figure><h3 id=\"sec-7\"><strong>3. 解码器解密并提取 SCKit 捆绑包</strong><strong></strong></h3><p>解码器从 HKLM\\SOFTWARE\\Microsoft\\Cryptography 读取 MachineGuid，并将其作为 m 请求参数一并发送。响应会提供一个 Base64 编码的正文以及两个标头 X-Lab-Half 和 X-Lab-Salt。</p><p>为了派生解密密钥，解码器使用 SHA-256 对 UTF-8 机器标识符进行哈希，将该哈希与从 X-Lab-Half 解码得到的 32 字节进行异或运算，并将机器标识符字节追加到恢复出的秘密材料中。随后，PBKDF2-HMAC-SHA256 使用响应中的盐和 4,096 次迭代派生出一个 32 字节密钥。</p><p>解码器使用解码后响应正文的前 16 字节作为初始化向量（IV）。它使用带 PKCS7 填充的 AES-256-CBC 解密其余字节，使用 GZip 解压缩明文，并写出生成的 ZIP 归档文件。随后，该归档文件会被解压到 %TEMP%\\SCKitBundle。</p><figure><img src=\"/dailyinfo/media/facc928429d577d1.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption><em>图 4. 用于密钥派生、解密、解压缩和捆绑包提取的部分解码器代码。</em></figcaption></figure><p>在完整模式下，解码器会准备 %TEMP%\\SCKit\\trapkit\\payload，并暂存 watcher、installer、alert 脚本和 RelayTrap.cs。它还会将自己的批处理启动器复制到 payload 目录中，供 RelayTrap 分发。复制后的启动器会获取解码器并启动工具包部署。</p><p>解码器还会暂存 ToolboxRelayUploader.exe，以通过控制台分发 payload；如果没有合适的副本，它会获取 sqlite3.exe，用于查询浏览器 Cookie。它包含两条启动路径：完整模式在不依赖单独配置文件的情况下启动分发脚本，并提供本地脚本路径；另一条路径则暂存一个辅助脚本和 lab-context.json，并传入 -SkipLocalExecution。</p><h3 id=\"sec-8\"><strong>4. 其他组件：PowerShell 脚本加载器</strong><strong></strong></h3><p>除捆绑包解码器外，SCKit 还包含一个用于加载加密 PowerShell 脚本的独立加载器。与负责获取并展开归档文件的解码器不同，该组件使用 p=1 和机器标识符请求脚本。它采用相同的秘密恢复、PBKDF2、AES-CBC 和 GZip 操作，但使用其源代码中嵌入的盐，而非响应标头提供的盐。</p><p>解压后，加载器将这些字节转换为 UTF-8 文本，并写入 %TEMP%\\k&lt;32-hex&gt;.ps1，文件名使用新生成的随机 GUID。它启动一个隐藏的 PowerShell 进程，使用转发的参数运行该文件，然后在子进程退出后尝试删除脚本。</p><figure><img src=\"/dailyinfo/media/fedeb4cbd7015bd5.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption><em>图 5. PowerShell 脚本加载器中临时脚本的创建、执行与清理。</em></figcaption></figure><h3 id=\"sec-9\"><strong>5. RelayTrap 添加持久化机制并针对连接的技术人员</strong><strong></strong></h3><p>在客户端终端上，持久化机制确保该工具包可供后续支持连接时使用。部署过程将脚本放置在 C:\\ProgramData\\RelayTrap 下。计算机级 CurrentVersion\\Run 键中的 RelayTrapLiteAlert 值会在用户登录时启动警报脚本。一个计划任务会使用有效载荷文件名、客户端标识符列表以及要排除的中继主机列表来启动监视器。-PollSeconds 10 参数将监视器配置为每 10 秒轮询一次。</p><p>监视器枚举 ScreenConnect 客户端服务，并读取其可执行文件路径和连接参数。对于每个客户端，其构建例程会在 trapbins 下创建一个目录，从该客户端的安装目录复制库，并使用 .NET C# 编译器构建 RelayTrap.exe。它会在重建前检查源代码或客户端库是否发生变化。</p><figure><img src=\"/dailyinfo/media/240c24a668f2f0fd.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption>图 6. 终端侧监视器使用对应 ScreenConnect 客户端中的库构建 RelayTrap。</figcaption></figure><p>RelayTrap 的设计方式是使用客户端终端的 ScreenConnect 连接详情来替代其常规客户端。当技术人员使用存在漏洞的主机客户端进行连接时，RelayTrap 会尝试通过该会话交付已暂存的批处理启动器。该启动器获取相同的解码器，将该工具包的部署设计从客户端设备扩展到技术人员工作站。已配置的跳过列表会将指定的客户端标识符和中继主机排除在处理范围之外。</p><p>ScreenConnect 服务也被配置为自动启动。注册表写入操作针对 Microsoft Defender Antivirus 的路径排除项，以排除已暂存的 MSI 副本和 CWInstall_…\\Installer.ps1。安装程序配置将 sc[.]payproofkit[.]com 和 cdn007-digitaldownloads[.]com 列为额外的 ScreenConnect MSI 来源。随后的 curl.exe 命令会从 sc[.]payproofkit[.]com 下载另一个客户端安装程序。</p><h3 id=\"sec-10\"><strong>6. 浏览器访问针对已认证的 ScreenConnect 会话</strong><strong></strong></h3><p>SCKit 还会针对技术人员用于登录管理控制台的浏览器。浏览器访问代码会在 Chrome、Edge、Opera 和 Opera GX 配置文件中搜索名为 .ASPXAUTH 的 Cookie。其数据库路径会识别关联主机并查询加密的 Cookie 值。它会复制 Cookie 数据库及其支持文件，并在数据库被锁定时使用卷影复制作为回退方案。解密代码会在当前用户上下文中使用 Chromium 主密钥和 Windows 数据保护 API (DPAPI)，并通过 AES-GCM 例程处理 v10 和 v11 Cookie 值。</p><p>内存扫描路径首先检查命令行中标识为 network.mojom.NetworkService 的浏览器网络服务进程。一个嵌入式 C# 扫描器使用 OpenProcess、VirtualQueryEx 和 ReadProcessMemory，检查可读的已提交内存区域，查找 Cookie 字符串及附近的主机字符串。如果初始扫描未找到候选项，它会扫描其他浏览器进程。</p><figure><img src=\"/dailyinfo/media/dbea5eb6a96e36bc.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption><em>图 7. 数据库查询和浏览器内存扫描针对 ScreenConnect 身份验证 Cookie。</em></figcaption></figure><p>控制台分发组件旨在将身份验证 Cookie 与所需的防伪令牌和访问令牌结合，枚举可访问的会话，使用 ToolboxRelayUploader.exe 上传有效载荷，并通过共享 Toolbox 排队执行。该工作流还包括在分发后删除已上传的 Toolbox 项目。</p><p>此组件针对的是技术员对管理控制台的访问权限，而不只是最初客户设备。该账户的权限决定了分发工作流可以访问哪些其他会话和设备。</p><h3 id=\"sec-11\"><strong>7. 清理和重新部署</strong><strong></strong></h3><p>该工具包的清理脚本会在陷阱目录中放置停止标记。它会删除与陷阱相关的任务、服务、进程、Run 项和文件，并恢复 ScreenConnect 客户端服务，除非请求删除客户端。随后，它会删除任何剩余的停止标记，以允许新部署的观察程序运行。</p><p>运行清理脚本后，除非设置 -NoReArm，解码器的清理模式会再次启动捆绑的投放器。因此，清理也可用作重新部署工具包的途径。</p><figure><img src=\"/dailyinfo/media/73285eca3e063f6e.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption><em>图 8. 清理会恢复 ScreenConnect 服务；解码器在再次启动捆绑的投放器前会检查 NoReArm。</em></figcaption></figure><h2 id=\"sec-12\"><strong>缓解和保护指南</strong></h2><h4 id=\"sec-13\"><strong>保护 ScreenConnect 管理控制台和技术员客户端</strong><strong></strong></h4><p>应分别处理服务器端扩展 API 和技术员客户端。扩展身份验证与客户端文件传输是不同的攻击面；保护其中一个并不会消除另一个攻击面，也不会消除已有的端点安装。</p><ul>\n<li><strong>保持已识别扩展处于禁用状态。</strong> 按照供应商公告处理 Labtech Plus、RMM Plus、RMM+、RMM Plus Password Link 和 RMM+ Password Link。应结合管理访问权限，审查这些扩展的安装和配置历史。</li>\n\n\n\n<li><strong>单独更新技术员客户端，而非控制台。</strong> ConnectWise 表示，ScreenConnect 客户端 26.6.5 及更高版本会阻止该工具包尝试使用的端点到技术员传输技术。CVE-2026-84869 的修复已于 2026 年 9 月 8 日发布。务必核实每个技术员客户端的安装版本；更新云控制台不会自动更新这些客户端。<a href=\"https://www.connectwise.com/company/trust/security-bulletins/2026-09-08-screenconnect-bulletin\">供应商公告</a>还说明，在等待更新期间应实施临时文件传输限制。</li>\n</ul><h4 id=\"sec-14\"><strong>移除已建立的访问权限</strong><strong></strong></h4><ul>\n<li><strong>通过独立渠道开展调查。</strong> 对于疑似受影响的设备，请使用 Microsoft Defender for Endpoint 实时响应或其他经批准的带外方法，而不是 ScreenConnect。隔离受影响的端点，并将连接这些端点的技术员工作站纳入调查范围。</li>\n\n\n\n<li><strong>保存控制台和端点证据。</strong> 保留扩展、身份验证、Run Command 和 Toolbox 记录，并一并保留进程、文件、任务和注册表历史。审查 Toolbox 历史记录中在使用后被删除的工具，并在重新连接设备前检查已排队的命令和工具。</li>\n\n\n\n<li><strong>从干净设备撤销已暴露的会话。</strong> 使受影响的 ScreenConnect Web 会话及相关身份提供商会话失效，轮换已暴露的凭据，并审查账户和权限。仅更改密码无法处理每个现有会话。</li>\n\n\n\n<li><strong>移除持久化和未经批准的客户端。</strong> 在移除每个客户端之前，验证其注册的实例和中继目标。通过经批准的响应工具移除恶意任务、Run 值、trap 文件和未经授权的排除项。不要将从工具包中恢复的清理脚本用作补救工具。</li>\n\n\n\n<li><strong>在恢复网络连接之前验证完整状态。</strong> 确认经批准的服务和目标、生效的防病毒设置，以及不存在重新创建的任务或脚本。调查排除项变更时，审查防篡改保护事件。如果无法确认完整性，请重建设备。</li>\n</ul><p>保持 Microsoft Defender Antivirus、云交付保护和防篡改保护处于启用状态。验证设备符合<a href=\"https://learn.microsoft.com/defender-endpoint/tamper-protection-antivirus-exclusions\">防病毒排除项保护要求</a>。维护经授权的远程管理实例清单，并使用应用程序控制来限制未经批准的软件。</p><h3 id=\"sec-15\">Microsoft Defender XDR 检测<strong></strong></h3><p>Microsoft Defender XDR 客户可以使用以下 Microsoft Defender for Endpoint 警报标题调查与此威胁相关的活动。将相关警报与设备时间线和 ScreenConnect 审计记录结合审查，以追踪命令执行、持久化、浏览器数据访问和网络连接。</p><figure><table><tbody><tr><td><strong>战术</strong></td><td><strong>活动</strong></td><td><strong>Microsoft Defender 覆盖范围</strong></td></tr><tr><td>执行</td><td>ScreenConnect 远程命令会启动命令 shell、批处理和 PowerShell 阶段。</td><td><strong>Microsoft Defender Antivirus</strong> <br>– Trojan:Win32/SuspScreenConnectDownload.EA – Trojan:Win32/Tikise.EA!cmd <br>– Trojan:Win32/SuspScreenConnectDownload.EA <strong> </strong> <br><br><strong>Microsoft Defender for Endpoint</strong><br>– 通过 ScreenConnect 执行的可疑命令</td></tr><tr><td>持久化</td><td>额外的 ScreenConnect 客户端和自动启动服务可提供远程访问。RelayTrapLiteAlert Run 项和计划任务会启动 RelayTrap 脚本。</td><td><strong>Microsoft Defender Antivirus</strong> <br>– Trojan:PowerShell/RelayPersist.FC!MTB <br><br><strong>Microsoft Defender for Endpoint</strong><br>– 可疑的远程管理软件安装<br>– 检测到 ASEP 注册表异常<br>– 已启动可疑计划任务进程</td></tr><tr><td>防御规避</td><td>加载程序尝试删除其临时 PowerShell 有效载荷。注册表写入操作以 Microsoft Defender Antivirus 路径排除项为目标。</td><td><strong>Microsoft Defender Antivirus</strong> <br>– Trojan:PowerShell/SCRelayTrap.EC!MTB   <br><br><strong>Microsoft Defender for Endpoint</strong><br>– 可能删除了 PowerShell 指标<br>– 可疑的 Microsoft Defender Antivirus 排除项</td></tr><tr><td>凭据访问</td><td>浏览器组件会查询 .ASPXAUTH Cookie、扫描浏览器内存，并在其解密例程中使用 DPAPI。</td><td><strong>Microsoft Defender Antivirus</strong> <br>– Trojan:BAT/Tikise.A <br>– Trojan:BAT/Tikise.B <br>– Trojan:BAT/Tikise.C <br>– Trojan:BAT/Tikise.D <br>– Trojan:PowerShell/Tikise.A <br>– Trojan:PowerShell/Tikise.B <br>– Trojan:PowerShell/Tikise.C <br>– Trojan:PowerShell/Tikise.D <br>– Trojan:PowerShell/Tikise.E <br>– Trojan:PowerShell/Tikise.F <strong> </strong> <br><br><strong>Microsoft Defender for Endpoint</strong><br>– 可能窃取密码和其他敏感 Web 浏览器信息<br>– 可疑的 DPAPI 活动</td></tr><tr><td>命令与控制</td><td>PowerShell 和 curl.exe 从攻击活动基础设施获取解码器、工具包组件和客户端安装程序。</td><td><strong>Microsoft Defender for Endpoint</strong><br>– 与恶意网络端点通信的命令行进程<br>– Powershell 建立了可疑的网络连接</td></tr><tr><td>多种战术</td><td>入侵活动涵盖远程命令、客户端安装、持久化以及安全设置更改。</td><td><strong>Microsoft Defender Antivirus</strong> <br>– HackTool:Win32/ToolboxRelayUploader <br>– Trojan:PowerShell/ScreenConnect.SC!MTB <br>– Trojan:PowerShell/ScreenConnect.DC!MTB <strong> </strong> <br><br><strong>Microsoft Defender for Endpoint</strong><br>– 潜在的人工操作型恶意活动</td></tr></tbody></table></figure><h3 id=\"sec-16\">威胁情报报告</h3><p>Microsoft Defender XDR 客户可以使用以下威胁分析报告获取有关 SCKit 及 ScreenConnect 滥用的最新情报，包括保护状态、受影响资产以及针对其环境的建议操作。</p><h3 id=\"sec-17\"><strong>Microsoft Defender XDR 威胁分析与 Secure Now </strong></h3><p>客户可以访问威胁分析报告：<a href=\"https://security.microsoft.com/threatanalytics3/fb63cbf6-12fe-4ad2-b26a-6eb4cb7b8257\">SCKit 滥用 ScreenConnect 部署远程访问并针对技术员会话</a></p><p>客户还可以访问关于 <a href=\"https://aka.ms/securenow\">Secure Now 的</a>建议控制措施和指导。</p><h3 id=\"sec-18\">高级搜寻查询</h3><p>以下每个查询均独立运行，检索范围为 14 天。请根据调查时间范围和可用保留期调整时间范围，并将结果与经批准的管理活动进行关联。</p><p><strong>与攻击活动基础设施的连接</strong></p><p>查找与所列域名和 IP 地址的连接。审查每个匹配项的完整目标、发起进程以及经批准的远程支持基础设施。</p><pre>DeviceNetworkEvents\n| where Timestamp &gt; ago(14d)\n| where RemoteUrl has_any (\n    \"ns.mo7sen.dev\", \"sc.payproofkit.com\",\n    \"newnewnew.gotdns.org\", \"soxnewwork.homedns.org\",\n    \"cdn007-digitaldownloads.com\")\n    or RemoteIP in (\"185.99.255.28\", \"155.94.150.39\")\n| project Timestamp, DeviceId, DeviceName, RemoteUrl, RemoteIP,\n    InitiatingProcessFileName, InitiatingProcessCommandLine, ReportId\n</pre><p><strong>工具包命令行与 Cookie 查询活动</strong><strong></strong></p><p>查找包含独特工具包名称、暂存路径、安装程序标记或 Cookie 查询字符串的命令行。</p><pre>DeviceProcessEvents\n| where Timestamp &gt; ago(14d)\n| where ProcessCommandLine contains \"/EadF.php\"\n    or ProcessCommandLine contains \"SCKit\"\n    or ProcessCommandLine contains \"RelayTrap\"\n    or ProcessCommandLine contains \"Panel-Lateral\"\n    or ProcessCommandLine contains \"ToolboxRelayUploader\"\n    or ProcessCommandLine contains \".ASPXAUTH\"\n    or ProcessCommandLine contains \"c=Exploited\"\n| project Timestamp, DeviceId, DeviceName, FileName,\n    ProcessCommandLine, InitiatingProcessFileName, ReportId\n</pre><p><strong>已知安装程序、归档文件和上传器文件</strong><strong></strong></p><p>通过 SHA-1 哈希查找与 sc.msi 安装包、暂存 ZIP 文件及上传器对应的文件事件。该查询使用 SHA-1，是因为 SHA256 在 <a href=\"https://learn.microsoft.com/defender-xdr/advanced-hunting-devicefileevents-table\">DeviceFileEvents 中通常未填充数据</a>。请将哈希匹配项与命令行和持久化发现结合分析。</p><pre>DeviceFileEvents\n| where Timestamp &gt; ago(14d)\n| where SHA1 in~ (\n    \"0be01e7bd69cfdd222645d49bb5ad9961372fef2\",\n    \"3f81c9c874a896c46e4bccea2fad2eaa3d9f2054\",\n    \"13ce33b19daee3963f7e15d461b191c38f6bc0d3\")\n| project Timestamp, DeviceId, DeviceName, FileName, FolderPath,\n    SHA1, InitiatingProcessFileName, ReportId\n</pre><p><strong>引用 RelayTrap 的注册表值</strong><strong></strong></p><p>查找对 RelayTrapLiteAlert 值或包含 RelayTrap 的值的写入操作。审查注册表项、值数据和发起进程。</p><pre>DeviceRegistryEvents\n| where Timestamp &gt; ago(14d)\n| where ActionType == \"RegistryValueSet\"\n| where RegistryValueName =~ \"RelayTrapLiteAlert\"\n    or RegistryValueData contains \"RelayTrap\"\n| project Timestamp, DeviceId, DeviceName, RegistryKey,\n    RegistryValueName, RegistryValueData,\n    InitiatingProcessFileName, ReportId\n</pre><p><strong>RelayTrap 计划任务事件</strong><strong></strong></p><p>查找包含 RelayTrap 或 TrapWatch 的计划任务事件。检查任务定义以确定其触发器、可执行文件和参数。</p><pre>DeviceEvents\n| where Timestamp &gt; ago(14d)\n| where ActionType contains \"ScheduledTask\"\n| where AdditionalFields contains \"RelayTrap\"\n    or AdditionalFields contains \"TrapWatch\"\n| project Timestamp, DeviceId, DeviceName, ActionType,\n    AdditionalFields, InitiatingProcessFileName, ReportId\n</pre><p><strong>Microsoft Defender Antivirus 路径排除写入操作</strong><strong></strong></p><p>查找 Microsoft Defender Antivirus 路径排除注册表写入操作。审查涉及 Windows Temp、ConnectWiseControl_、CWInstall_ 或 RelayTrap 的更改，并核实其授权情况及生效策略。</p><pre>DeviceRegistryEvents\n| where Timestamp &gt; ago(14d)\n| where ActionType == \"RegistryValueSet\"\n| where RegistryKey contains @\"\\Windows Defender\\Exclusions\\Paths\"\n| project Timestamp, DeviceId, DeviceName, RegistryKey,\n    RegistryValueName, RegistryValueData,\n    InitiatingProcessFileName, ReportId\n</pre><p><strong>SCKit – 生成的 PowerShell 加载器工件</strong></p><p>识别与 SCKit 加载器生成的 k&lt;32-hex&gt;.ps1 命名模式匹配的临时 PowerShell 文件，从而有可能在已知文件哈希或基础设施之外揭示已暂存的载荷。</p><pre>DeviceFileEvents\n| where Timestamp &gt; ago(30d)\n| where FileName matches regex @\"(?i)^k[0-9a-f]{32}\\.ps1$\"\n| project Timestamp, DeviceId, DeviceName,\nActionType, FileName, FolderPath, SHA256,\nInitiatingProcessFileName\n</pre><h2 id=\"sec-19\">失陷指标和辅助工件</h2><p>网络地址已进行去混淆处理。请使用安装程序哈希定位所列软件包，然后核实客户端已注册的 ScreenConnect 实例及相关活动。该工具包还使用合法的 SQLite 实用工具；请结合上述浏览器 Cookie 查询调查其使用情况。</p><h4 id=\"sec-20\">网络基础设施</h4><figure><table><tbody><tr><td><strong>指标 </strong><strong></strong></td><td><strong>类型 </strong><strong></strong></td><td><strong>作用 </strong><strong></strong></td></tr><tr><td>ns[.]mo7sen[.]dev </td><td>域名 </td><td>解码器、捆绑包、脚本和实用工具检索 </td></tr><tr><td>sc[.]payproofkit[.]com </td><td>域名 </td><td>未经授权的 ScreenConnect 面板和安装程序来源 </td></tr><tr><td>cdn007-digitaldownloads[.]com </td><td>域名 </td><td>活动基础设施；已配置的安装程序来源 </td></tr><tr><td>newnewnew[.]gotdns[.]org </td><td>域名 </td><td>关联的 ScreenConnect 中继 </td></tr><tr><td>soxnewwork[.]homedns[.]org </td><td>域名 </td><td>关联的 ScreenConnect 中继 </td></tr><tr><td>185[.]99[.]255[.]28 </td><td>IPv4 </td><td>未经授权的 ScreenConnect 服务器和安装程序来源 </td></tr><tr><td>155[.]94[.]150[.]39 </td><td>IPv4 </td><td>与未经授权面板关联的地址 </td></tr></tbody></table></figure><h4 id=\"sec-21\">文件哈希</h4><p>哈希用于识别单个文件。监控器针对本地客户端库编译 RelayTrap，而嵌入式配置会改变脚本哈希。使用文件和进程行为调查其他构建版本。该表包含配置、清理和证据工件，以支持调查。</p><figure><table><tbody><tr><td><strong>指标 </strong><strong></strong></td><td><strong>类型 </strong><strong></strong></td><td><strong>作用 </strong><strong></strong></td></tr><tr><td>61a672a13f03a9e81f573535ee92b1ed6cb7e848a33a06048865312d4e185ae2 </td><td>SHA-256 </td><td>sc.msi 安装程序包 </td></tr><tr><td>8e6912deed82e80bb6bd66f73509d024b1f78b993515366d8317e69a97cff4f4 </td><td>SHA-256 </td><td>分阶段工具包 ZIP </td></tr><tr><td>8cb5f48bbe70b5248db7f327f3d1ad6649df5c767d2a7e0711ee147fd92e06af </td><td>SHA-256 </td><td>ToolboxRelayUploader.exe </td></tr><tr><td>94b93c649b0ae0281352da9d01761fa9195ab1e6ac7010af3b9ba1646355eb11 </td><td>SHA-256 </td><td>Panel-Lateral-free.ps1 </td></tr><tr><td>7a9aca9fdd4dcc13fe497cabdb13ca1e5d6a529271c8aa495e5ca1c1c80271ec </td><td>SHA-256 </td><td>Panel-Lateral.ps1 </td></tr><tr><td>b93f10f30ee453d1e1c046fec9d141c41d7680be5cd46c3aeb3febe0f4953b4d </td><td>SHA-256 </td><td>LabConfig.ps1 辅助文件 </td></tr><tr><td>3c7a98f0fdb6235b8076319c74dc1085f7b349b6d750416dd0cadb07d7972ec4 </td><td>SHA-256 </td><td>RelayTrap.cs 源文件 </td></tr><tr><td>d2ed7a7bf4f8ac9c7969e9b3a07ebd4dda0d858f372c876ac0a041611698de9a </td><td>SHA-256 </td><td>TrapWatch.ps1 </td></tr><tr><td>4a1dd3cd2ea14368afadf7e9dfdd63b104e3981ef8c85bbb6510919b810af04b </td><td>SHA-256 </td><td>trapkit\\install.ps1 </td></tr><tr><td>cf50d73fa8117a758093b1344de41cd6a6ccddc645cdda1fa91a9264efe93956 </td><td>SHA-256 </td><td>Lite-Alert.ps1 </td></tr><tr><td>81cc2baa35b798d6084bd078662fa29ff28df02c46c6ccdb2b43bde97d19f781 </td><td>SHA-256 </td><td>Stage0Loader.ps1 </td></tr><tr><td>43b7a5e56f9e6c7b74e1ce2b7b5af63f383084625fcc2d3a5985fa1059e2db95 </td><td>SHA-256 </td><td>Run-Lateral-Full.bat </td></tr><tr><td>50659748723e906c8b3d3c0386bd4cf692f693a3e23639398c1a14d0c31fed61 </td><td>SHA-256 </td><td>runnew.cmd </td></tr><tr><td>5dd3a6ba806ac472663e243cfc1c034c534d5d9a42ec362c3dbf0f8d950148d0 </td><td>SHA-256 </td><td>Stop-LabTrap.bat 清理模式启动器 </td></tr><tr><td>454c43d296b1276bde9a4f6ff1da2221cb35ccdb2fc7991bdd572e45bce12a8a </td><td>SHA-256 </td><td>TRAP-PROOF.bat 证据工件 </td></tr><tr><td>0be01e7bd69cfdd222645d49bb5ad9961372fef2 </td><td>SHA-1 </td><td>sc.msi； </td></tr><tr><td>3f81c9c874a896c46e4bccea2fad2eaa3d9f2054 </td><td>SHA-1 </td><td>分阶段工具包 ZIP；</td></tr><tr><td>13ce33b19daee3963f7e15d461b191c38f6bc0d3 </td><td>SHA-1 </td><td>Uploader；</td></tr></tbody></table></figure><h4 id=\"sec-22\">客户端标识符和行为工件</h4><figure><table><tbody><tr><td><strong>指标 </strong><strong></strong></td><td><strong>类型 </strong><strong></strong></td><td><strong>作用 </strong><strong></strong></td></tr><tr><td>2588ef5c15954b10 </td><td>客户端 ID </td><td>未经授权的 ScreenConnect 客户端标识符 </td></tr><tr><td>ed630cc2c873b091 </td><td>客户端 ID </td><td>未经授权的 ScreenConnect 客户端标识符 </td></tr></tbody></table></figure><h2 id=\"sec-23\">参考</h2><ul>\n<li><a href=\"https://www.connectwise.com/company/trust/advisories\">ConnectWise 安全调查与合作伙伴指南</a>（涵盖 RMM+ 扩展身份验证缺陷的公告）。ConnectWise（访问于 2026-11-13）</li>\n\n\n\n<li><a href=\"https://www.connectwise.com/company/trust/security-bulletins/2026-09-08-screenconnect-bulletin\">ScreenConnect 安全公告，2026-09-08</a>（CVE-2026-84869 修复和客户端 26.6.5 指南）。ConnectWise（访问于 2026-11-13）</li>\n\n\n\n<li><a href=\"https://www.screenconnect.com/features/extensions\">ScreenConnect 扩展。</a> ConnectWise（访问于 2026-11-13）</li>\n\n\n\n<li><a href=\"https://www.screenconnect.com/blog/6-tips-for-connectwise-control-partners\">给 ConnectWise Control 合作伙伴的 6 条建议</a>（从 Web 控制台执行远程命令）。ConnectWise（访问于 2026-11-13）</li>\n\n\n\n<li><a href=\"https://learn.microsoft.com/defender-endpoint/tamper-protection-antivirus-exclusions\">使用篡改防护保护防病毒排除项的要求</a>。Microsoft Learn（访问于 2026-11-13）</li>\n\n\n\n<li><a href=\"https://learn.microsoft.com/defender-endpoint/live-response\">使用实时响应调查设备上的实体</a>。Microsoft Learn（访问于 2026-11-13）</li>\n\n\n\n<li><a href=\"https://learn.microsoft.com/defender-endpoint/respond-machine-alerts\">对设备执行响应操作</a>。Microsoft Learn（访问于 2026-11-13）</li>\n\n\n\n<li><a href=\"https://learn.microsoft.com/defender-xdr/advanced-hunting-best-practices\">Microsoft Defender XDR 中的高级搜寻最佳实践</a>。Microsoft Learn（访问于 2026-11-13）</li>\n\n\n\n<li><a href=\"https://learn.microsoft.com/defender-xdr/advanced-hunting-devicefileevents-table\">DeviceFileEvents 表（高级搜寻架构）</a>。Microsoft Learn（访问于 2026-11-13）</li>\n</ul><h2 id=\"sec-24\">了解更多</h2><p>如需了解 Microsoft Threat Intelligence 社区的最新安全研究，请访问<a href=\"https://aka.ms/threatintelblog\">Microsoft Threat Intelligence 博客</a>。</p><p>如需获取新发布内容的通知并参与社交媒体讨论，请在 <a href=\"https://www.linkedin.com/showcase/microsoft-threat-intelligence\">LinkedIn</a>、<a href=\"https://x.com/MsftSecIntel\">X（原 Twitter）</a> 和 <a href=\"https://bsky.app/profile/threatintel.microsoft.com\">Bluesky</a> 上关注我们。</p><p>如需聆听 Microsoft Threat Intelligence 社区讲述不断演变的威胁形势背后的故事与洞察，请收听<a href=\"https://thecyberwire.com/podcasts/microsoft-threat-intelligence\">Microsoft Threat Intelligence 播客</a>。</p><p>请查阅我们的文档，以详细了解我们的实时保护功能，并了解如何在组织中启用这些功能。</p><ul>\n<li><a href=\"https://learn.microsoft.com/en-us/defender-cloud-apps/ai-agent-protection\">如何使用 Microsoft Defender 保护 Copilot Studio 代理</a>的更多相关信息</li>\n\n\n\n<li>使用我们最新的<a href=\"https://microsoft.github.io/zerotrustassessment/\">Zero Trust for AI 工作坊</a>评估您的 AI 准备情况。</li>\n\n\n\n<li><a href=\"https://learn.microsoft.com/en-us/copilot/microsoft-365/microsoft-365-copilot-ai-security\">Microsoft 365 Copilot AI 安全文档</a></li>\n\n\n\n<li><a href=\"https://www.microsoft.com/en-us/security/blog/2024/04/11/how-microsoft-discovers-and-mitigates-evolving-attacks-against-ai-guardrails/\">Microsoft 如何发现并缓解针对 AI 护栏的不断演变的攻击</a></li>\n\n\n\n<li><a href=\"https://learn.microsoft.com/en-us/defender-office-365/step-by-step-guides/prompt-injection-protection-defender-for-office-365\">Microsoft Defender for Office 365 中的提示注入防护</a>——Microsoft Defender for Office 365 中提示注入防护的官方文档。</li>\n\n\n\n<li><a href=\"https://www.microsoft.com/en-us/security/blog/2024/04/11/how-microsoft-discovers-and-mitigates-evolving-attacks-against-ai-guardrails/\">Microsoft 如何发现并缓解针对 AI 护栏的不断演变的攻击 | Microsoft 安全博客</a></li>\n\n\n\n<li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/02/10/ai-recommendation-poisoning/\">为牟利操纵 AI 记忆：AI 推荐投毒的兴起 | Microsoft 安全博客</a>——一个在电子邮件流量中观察到的 AI 时代技术相关示例</li>\n\n\n\n<li><a href=\"https://techcommunity.microsoft.com/blog/microsoftdefenderforoffice365blog/defending-the-inbox-against-prompt-injection-attacks/4534636\">使用 Microsoft Defender for Office 365 博客防御收件箱免受提示注入攻击</a>——宣布在 Microsoft Defender for Office 365 中引入提示注入防护。</li>\n\n\n\n<li>了解 Microsoft 如何通过<a href=\"https://www.microsoft.com/security/blog/2026/09/23/reimagining-the-soc-for-the-agentic-era-in-microsoft-defender/\">Microsoft Defender 中的 ISOC</a>重新构想智能体时代的 SOC</li>\n</ul><p>文章<a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/13/sckit-abuses-screenconnect-deploy-remote-access-target-technician-sessions/\">SCKit 滥用 ScreenConnect 部署远程访问并锁定技术员会话</a>首次发布于<a href=\"https://www.microsoft.com/en-us/security/blog\">Microsoft 安全博客</a>。</p>","original","zhKind","translation","complete","h2occksxu7q3tzi57634syb7r","SCKit 蠕虫式恶意软件借 ScreenConnect 攻击 MSP，尝试反向感染技术人员","后门","Microsoft","https://www.microsoft.com/en-us/security/blog/2026/11/13/sckit-abuses-screenconnect-deploy-remote-access-target-technician-sessions/","Microsoft Security Blog",{"_174":175,"_176":-5},"changelogVersion","2026-10-01T08:00","release"]
