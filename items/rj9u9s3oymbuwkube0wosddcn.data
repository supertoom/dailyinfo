[{"_1":2,"_3":4},"root",{"_5":96},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794530491000,"id","rj9u9s3oymbuwkube0wosddcn","title","攻击者利用 RMM+ 认证绕过攻击 ScreenConnect，288 台主机遭植入 SCKit","originalTitle","Hackers Deploy Malware in Fresh ScreenConnect Campaign","summary","Huntress 观察到攻击者利用 RMM+ 认证绕过漏洞入侵 ConnectWise ScreenConnect，至少影响 6 家 MSP、48 家组织的 288 台主机，并在 90 分钟内完成命令投递。","reason","事件同时关联认证绕过漏洞、恶意软件部署和明确受害规模，便于防守方定位 ScreenConnect 扩展与终端风险。","source",{"_74":95},"links",{"_87":94},"publishedAt","2026-11-12T10:39:34.000Z","discoveredAt","2026-11-12T11:30:27.648Z","timelineAt","category","activity","tags",[77,75,91,79,92,93],"score",82,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Ionut Arghire","body",{"_61":86,"_87":-5,"_88":89,"_90":37},"outline",[],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fe11_palkB6U","reportCount",2,"additionalSourceCount",1,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","malware","name","恶意软件","attack","攻击活动","exploited","在野利用","supply-chain","供应链安全",{"_83":84,"_13":85},"publicId","4c4f0d1f-c78b-4aee-8605-fa5f25c7bd8c","SCKit攻击波及48家机构端点","<p><strong>网络安全公司 Huntress 报告称，在一场新的攻击活动中，攻击者已经入侵了数十家 ConnectWise ScreenConnect 客户的多达数百个端点。</strong>\n\n\n\n</p><p>11 月 11 日观察到这些攻击，攻击者滥用其未经授权的访问权限进入云托管的 ScreenConnect 面板，在受管理端点上运行命令。\n\n\n\n</p><p>据 Huntress 称，此次活动至少入侵了 6 家 MSP，以及 48 家组织的 288 台主机。攻击者在 90 分钟内攻击了全部 288 台被入侵的主机。\n\n\n\n</p><p>攻击者执行的命令部署了非法的 ScreenConnect 客户端，以及名为 SCKit 的恶意软件工具包。该工具包可提供持久后门访问、拦截会话 Cookie，并能自我复制。\n\n\n\n</p><p>它最初通过 ScreenConnect 面板部署，随后等待技术人员连接到被入侵的端点，以感染技术人员的工作站。接下来，它会尝试入侵该技术人员有权访问的其他会话，并将自己传播到其他面板。\n\n\n\n</p><p>“然而，并非所有功能都在已观察到的安全事件中出现；部分功能是通过分析有效载荷发现的，”<a href=\"https://www.huntress.com/blog/sckit-worm-rogue-screenconnect\">Huntress 表示</a>。</p><p><span>广告。滚动以继续阅读。</span></p><p>作为这些攻击的一部分，攻击者利用了 RMM+ 中的一个漏洞。RMM+ 是用于管理 ScreenConnect 会话的第三方扩展，它使用共享访问密钥绕过 ScreenConnect 的身份验证机制。\n\n\n\n</p><p>攻击者很可能利用了该扩展 1.0.31 和 1.0.32 版本中的一个缺陷：如果未配置访问密钥，该密钥的默认值将为空，从而使攻击者能够使用空值绕过身份验证。\n\n\n\n</p><p>“我们的分析表明，遇到的大多数 RMM+ 安装都是合法的，通常是为某个项目添加并一直保留。但 1.0.31 和 1.0.32 版本存在严重的身份验证缺陷：如果管理员从未配置过该扩展的访问密钥，RMM+ 就会接受空密钥，”Huntress 表示。\n\n\n\n</p><p>该网络安全公司表示，其调查确定命令在数分钟内到达了端点。然而，没有对应的登录活动，且审查的日志指向 RMM+。\n\n\n\n</p><p>作为回应，ConnectWise 在大约 400 个 ScreenConnect 环境中禁用了 RMM+ 系列中的五个扩展，包括 Labtech Plus、RMM Plus、RMM+、RMM Plus Password Link 和 RMM+ Password Link。\n\n\n\n</p><p>“仅仅存在这些扩展并不能证明已遭到入侵。这些扩展提供了一个可执行远程命令的 API。对该 API 的访问受到合作伙伴在设置期间配置的口令保护，”<a href=\"https://www.connectwise.com/company/trust/advisories\">ConnectWise 指出</a>。\n\n\n\n</p><p>Huntress 和 ConnectWise 均发布了与此次活动相关的失陷指标（IoCs），并建议组织在其本地部署的 ScreenConnect 环境中禁用这些扩展。\n\n\n\n</p><p><strong>相关：</strong><a href=\"https://www.securityweek.com/software-transparency-is-changing-allan-friedman-on-sbom-ai-boms-and-what-comes-next/\">软件透明度正在改变：Allan Friedman 谈 SBOM、AI BOM 及未来发展</a>\n\n\n\n</p><p><strong>相关：</strong><a href=\"https://www.securityweek.com/hackers-target-n-central-zero-days-as-n-able-rushes-patches/\">黑客瞄准 N-central 零日漏洞，N-able 紧急发布补丁</a>\n\n\n\n</p><p><strong>相关：</strong><a href=\"https://www.securityweek.com/over-a-dozen-organizations-hit-in-qubole-supply-chain-attack/\">Qubole 供应链攻击波及十余家组织</a>\n\n\n\n</p><p><strong>相关：</strong><a href=\"https://www.securityweek.com/critical-xen-orchestra-flaws-exploited-in-attacks/\">严重 Xen Orchestra 漏洞已遭利用</a>\n\n\n\n</p>","original","zhKind","translation","complete","后门","漏洞利用","供应链","https://www.securityweek.com/hackers-deploy-malware-in-fresh-screenconnect-campaign/","SecurityWeek",{"_97":98,"_99":-5},"changelogVersion","2026-10-01T08:00","release"]
