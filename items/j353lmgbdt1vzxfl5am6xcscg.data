[{"_1":2,"_3":4},"root",{"_5":112},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1794185102000,"id","j353lmgbdt1vzxfl5am6xcscg","title","OpenSSH/musl密码认证绕过漏洞CVE-2026-123158已复现，受影响版本为7.3p1至10.6p2","originalTitle","【已复现】OpenSSH/musl密码认证绕过漏洞（CVE-2026-123158）","summary","绿盟科技CERT披露并成功复现OpenSSH/musl密码认证绕过漏洞CVE-2026-123158，CVSS评分为8.1。","reason","通告给出受影响版本区间、认证绕过原理、PoC公开状态和临时缓解配置，便于管理员快速判断并处置暴露环境。","source",{"_71":111},"links",{"_104":110},"publishedAt","2026-11-06T10:03:00.000Z","discoveredAt","2026-11-07T03:28:31.999Z","timelineAt","category","vuln","tags",[107,108,109,74],"score",77,"selected",true,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","body",{"_61":103,"_104":-5,"_105":104,"_106":37},"outline",[79,80,81,82,83,84,85],"relatedStories",[75],"topics",[68,69],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fzUO_fe4BW-w","reportCount",2,"additionalSourceCount",1,{"_70":73,"_71":74},{"_70":31,"_71":72},"slug","name","漏洞披露","identity","身份与访问",{"_76":77,"_13":78},"publicId","9752aa65-824d-43a4-962f-2d752946dc78","OpenSSH musl认证绕过漏洞可致RCE",{"_11":101,"_87":102,"_89":90},{"_11":99,"_87":100,"_89":90},{"_11":97,"_87":98,"_89":90},{"_11":95,"_87":96,"_89":90},{"_11":93,"_87":94,"_89":90},{"_11":91,"_87":92,"_89":90},{"_11":86,"_87":88,"_89":90},"sec-7","text","4.2 其他防护措施","level",3,"sec-6","4.1 官方升级","sec-5","检查SSH配置：","sec-4","检查OpenSSH版本命令：","sec-3","3.1 人工检测","sec-2","不受影响版本","sec-1","受影响版本","<p><span>NS-CERT</span> <span>2026-11-06 18:03</span> <span>四川</span></p><p><img src=\"/dailyinfo/media/0c2f905058091767.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>近日，绿盟科技CERT监测到OpenSSH发布安全更新，修复了OpenSSH/musl密码认证绕过漏洞（CVE-2026-123158）；CVSS评分8.1，目前漏洞细节与PoC已公开，请相关用户尽快采取措施进行防护。</p><p><strong><span>通告编号 NS-2026-0027</span></strong></p><p><span><span>2026-11-06</span></span></p><table><tbody><tr><td><strong><span><span>TAG：</span></span></strong></td><td><p><strong><span><span>OpenSSH/musl、认证绕过、CVE-2026-123158</span></span></strong></p></td></tr><tr><td><strong><span><span>漏洞危害：</span></span></strong></td><td><p><strong><span>攻击者利用此漏洞，可绕过SSH密码认证登录目标系统。</span></strong></p></td></tr><tr><td><strong><span><span>版本：</span></span></strong></td><td><p><strong><span>1.0</span></strong></p></td></tr></tbody></table><p><strong><span>1</span></strong></p><p><strong><span><span>漏洞概述</span></span></strong></p><p><span><span>近日，绿盟科技CERT监测到OpenSSH发布安全更新，修复了OpenSSH/musl密码认证绕过漏洞（CVE-2026-123158）；由于musl libc的crypt()在失败时会返回</span></span><em><span><span>\"*\"</span></span></em><em><span><span>，当目标账户的密码字段为</span></span><em><span><span>\"*\"</span></span></em><span><span>、系统中存在其他使用密码哈希的账户且启用SSH密码认证时，未经身份验证的攻击者可通过提交超长密码使musl crypt()的错误返回值与目标账户密码字段错误匹配，从而绕过密码认证并登录目标账户；若该账户具备sudo/doas权限，攻击者还可进一步获取系统root权限。CVSS评分8.1，目前漏洞细节与PoC已公开，请相关用户尽快采取措施进行防护。</span></span></em></p><p><span>OpenSSH是SSH（Secure SHell）协议的免费开源实现，提供sshd、ssh、sftp等组件，广泛用于远程登录、文件传输和安全隧道；musl libc是面向Linux系统的轻量级C标准库，常见于Alpine Linux等环境。</span></p><p><span>绿盟科技天机实验室已成功复现此漏洞：</span></p><p><img src=\"/dailyinfo/media/51e5680f591fac5c.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span>参考链接：</span></p><p><span><a href=\"https://www.openssh.org/txt/release-10.6p2\">https://www.openssh.org/txt/release-10.6p2</a></span></p><p><strong><span>SEE MORE →</span></strong></p><p><span><strong><span>2</span></strong></span><strong><span>影响范围</span></strong></p><h3 id=\"sec-1\"><strong><span>受影响版本</span></strong></h3><p><span>• 7.3p1 &lt;= OpenSSH &lt; 10.6p2</span></p><p><span>注：</span><span>影响使用musl libc且未启用PAM进行密码认证的Linux系统，重点关注Alpine Linux及符合条件的OpenWrt、Buildroot、Yocto系统、Docker镜像和容器。</span></p><h3 id=\"sec-2\"><strong><span>不受影响版本</span></strong></h3><p><span>• OpenSSH &gt;= 10.6p2</span></p><p><span><strong><span>3</span></strong></span><strong><span>漏洞检测</span></strong></p><h3 id=\"sec-3\"><strong><span>3.1 人工检测</span></strong></h3><p><span>用户可以通过检查OpenSSH版本、C运行库类型及相关配置来判断当前系统是否在受影响范围内：</span></p><h3 id=\"sec-4\"><strong><span><span>检查OpenSSH版本命令：</span></span></strong></h3><pre><code><span>ssh -V</span></code></pre><p><span>检查系统是否使用musl libc：</span></p><pre><code><span>ldd /usr/sbin/sshd</span></code></pre><h3 id=\"sec-5\"><strong><span><span>检查SSH配置：</span></span></strong></h3><pre><code><span>*检查主配置文件：</span><span><br></span><span>grep -iE 'PasswordAuthentication|UsePAM' /etc/ssh/sshd_config</span><span><br></span><span>*检查子配置目录（如有）：</span><span><br></span><span>grep -iE 'PasswordAuthentication|UsePAM' /etc/ssh/sshd_config.d/* 2&gt;/dev/null</span></code></pre><p><span>若当前版本在受影响范围内，且PasswordAuthentication为yes，系统未启用PAM，则可能存在安全风险。</span></p><p><span><strong><span>4</span></strong></span><strong><span>漏洞防护</span></strong></p><h3 id=\"sec-6\"><strong><span>4.1 官方升级</span></strong></h3><p><span>目前官方已发布新版本修复此漏洞，请受影响的用户尽快升级版本进行防护，下载链接：<a href=\"https://www.openssh.com/portable.html\">https://www.openssh.com/portable.html</a></span></p><h3 id=\"sec-7\"><strong><span>4.2 其他防护措施</span></strong></h3><p><span>在不影响业务的情况下，相关用户可使用下列措施进行临时缓解：</span></p><p><span>1、在/etc/ssh/sshd_config中设置PasswordAuthentication no并重启sshd，禁用SSH密码认证；</span></p><p><span>2、将PermitRootLogin设置为prohibit-password或no。</span></p><p><strong><span>END</span></strong></p><p><img src=\"/dailyinfo/media/580a56eb223324fa.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img src=\"/dailyinfo/media/6d721539d6f0094d.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>声明</span></strong></p><p><span>本安全公告仅用来描述可能存在的安全问题，绿盟科技不为此安全公告提供任何保证或承诺。由于传播、利用此安全公告所提供的信息而造成的任何直接或者间接的后果及损失，均由使用者本人负责，绿盟科技以及安全公告作者不为此承担任何责任。</span></p><p><span>绿盟科技拥有对此安全公告的修改和解释权。如欲转载或传播此安全公告，必须保证此安全公告的完整性，包括版权声明等全部内容。未经绿盟科技允许，不得任意修改或者增减此安全公告内容，不得以任何方式将其用于商业目的。</span></p><p><img src=\"/dailyinfo/media/6d721539d6f0094d.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><span><strong><span>绿盟科技CERT</span></strong></span><span><span>∣</span></span><span><span>微信公众号</span></span></p><p><img src=\"/dailyinfo/media/6c3b5fdfef9a38b3.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><img src=\"/dailyinfo/media/955092bfd288c349.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>长按识别二维码，关注网络安全威胁信息</span></span></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=5cac2bb3&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzk0MjE3ODkxNg%3D%3D%26mid%3D2247493747%26idx%3D1%26sn%3Ddb0e3b3dd13eaf2ba1ae1f7f34690a78\">跳转微信打开</a></p>","original","zhKind","complete","漏洞","复现","漏洞利用","https://mp.weixin.qq.com/s?__biz=Mzk0MjE3ODkxNg==&mid=2247493747&idx=1&sn=db0e3b3dd13eaf2ba1ae1f7f34690a78","绿盟科技CERT",{"_113":114,"_115":-5},"changelogVersion","2026-10-01T08:00","release"]
