[{"_1":2,"_3":4},"root",{"_5":130},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794444095000,"id","l8c38b2h5meavjepjvszce1ro","title","VOLTA-AUTODOXER 利用 LLM 对窃取数据进行受害者价值评估","originalTitle","Appraisal by AI: Model-driven victim prioritization in the VOLTA infostealer","summary","Cisco Talos 分析了自删除型 Windows 信息窃取程序 VOLTA-AUTODOXER：它采集浏览器凭据、会话、支付卡、加密钱包种子、OAuth 令牌、云端密钥、Wi-Fi 密码及截图后，将结构化证据发送至 OpenRouter，由 LLM 生成包含“WHAT THEY'RE WORTH”和“THEIR OPSEC”的受害者评估。","reason","文章拆解了 VOLTA 将 LLM 接入受害者筛选流程的方式，并给出模型拒绝时的回退链与事件响应处置要点。","source",{"_77":129},"links",{"_117":128},"publishedAt","2026-10-31T12:00:00.000Z","discoveredAt","2026-10-31T12:02:30.138Z","timelineAt","category","activity","tags",[80,78,82,121,122,123,124,125,126,127],"score",75,"selected",true,"channel","news","story",{"_92":93,"_13":94},"x","readingMode","full","author","Ryan Fetterman","body",{"_61":116,"_117":-5,"_118":119,"_120":37},"outline",[95,96,97,98,99,100],"relatedStories",[91],"topics",[68,69,70,71,72,73,74],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fAFp_Yp6uqsI","reportCount",4,"additionalSourceCount",3,{"_75":89,"_77":90},{"_75":87,"_77":88},{"_75":85,"_77":86},{"_75":83,"_77":84},{"_75":81,"_77":82},{"_75":79,"_77":80},{"_75":76,"_77":78},"slug","malware","name","恶意软件","attack","攻击活动","ai-offense","AI 攻防","ai-agent","AI Agent 安全","black-market","数据窃取与黑产","ransomware","勒索软件","identity","身份与访问",{"_92":93,"_13":94},"publicId","41881cfd-565d-48f3-8331-58892c484e4a","Cisco披露VOLTA用AI评估窃密受害者",{"_11":114,"_102":115,"_104":105},{"_11":112,"_102":113,"_104":105},{"_11":110,"_102":111,"_104":105},{"_11":108,"_102":109,"_104":105},{"_11":106,"_102":107,"_104":105},{"_11":101,"_102":103,"_104":105},"sec-6","text","样本详情","level",2,"sec-5","结论&nbsp;","sec-4","对策&nbsp;","sec-3","部署模型&nbsp;","sec-2","窃密功能&nbsp;","sec-1","AI 配置：“深入，而非泛泛而谈……直言不讳、具体、准确。”&nbsp;","<ul><li>VOLTA 是一种成熟的信息窃取植入程序，带有可选的 AI 集成层。在窃取凭据、会话和加密货币钱包后，VOLTA 会将结构化证据包发送给 LLM，按照变现价值对受害者的资产进行排名。</li><li>如果模型拒绝执行目标评估，VOLTA 会故障转移至三模型链，这意味着背后存在直接的工程投入，并且预期会触及模型防护栏。&nbsp;</li><li>该窃密程序会自我删除，且不存在攻击者控制的基础设施。其 AI 集成的创新之处在于，它并非用于支持传统恶意软件能力，而是作为操作人员的情报分析员开展工作。&nbsp;</li></ul><hr><p><img src=\"/dailyinfo/media/02effe57fb53039c.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"Appraisal by AI: Model-driven victim prioritization in the VOLTA infostealer\"></p><p>网络犯罪领域出现了一个新思路——广泛撒网、窃取一切，再让 AI 筛选具体目标。一款自称为“VOLTA-AUTODOXER”的新型恶意软件通过<a href=\"https://blog.talosintelligence.com/introducing-cairn-frontier-tracking-for-ai-integrated-malware/\"><u>CAIRN 研究项目</u></a>浮出水面。它是一种可自我删除的 Windows 信息窃取程序，并通过由 LLM 驱动的受害者画像阶段来增强其窃取后工作流。</p><p>在收集标准的窃密程序所获数据后，包括浏览器密码；Cookie；支付卡；加密货币钱包助记词；Discord、Telegram、Steam 和 Roblox 会话；Microsoft OAuth 令牌；SSH 和云提供商密钥；Wi-Fi 配置文件；以及屏幕截图，VOLTA 会构建一个关于该机器背后用户的结构化证据包。该证据包包含地理位置和家庭住址、雇主及雇主域名、推断出的出生年份、银行卡末四位数字、Slack 工作区、文档作者元数据、iPhone 备份指示信息，以及实时 Roblox 账户估值。随后，它会利用窃取的会话访问权限进一步充实该证据包：搜索受害者的 Gmail 中的购买收据，以佐证家庭住址；获取 UberEats 和 DoorDash 订单历史；并通过窃取的令牌充实 Discord 账户信息。</p><p>该证据包会被序列化，并使用一条系统提示词 POST 到 OpenRouter，该提示词指示模型充当“一名起草目标评估的取证情报分析员”。所需输出包括一个标题为“WHAT THEY'RE WORTH”的部分，其中按变现价值将贵重资产划分为低/中/高等级；以及一个关于“THEIR OPSEC”的部分，其中包含对受害者安全态势和密码卫生状况的评估。该模型充当操作人员的分流分析员，将原始凭据日志转化为一份按优先级排列且附有引用依据的受害者及其可变现资产档案。</p><figure><img src=\"/dailyinfo/media/7db851c76d2551e4.jpg\" srcset=\"/dailyinfo/media/a07bf019db7477f5.jpg 720w, /dailyinfo/media/67ef28480d35f3fe.jpg 1200w, /dailyinfo/media/7db851c76d2551e4.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Appraisal by AI: Model-driven victim prioritization in the VOLTA infostealer\" width=\"2000\" height=\"1330\"><figcaption><span>图 1. VOLTA-AUTODOXER 工作流。</span></figcaption></figure><h2 id=\"sec-1\">AI 配置：“深入，而非泛泛而谈……直言不讳、具体、准确。”&nbsp;</h2><p>VOLTA 采用多模型架构，以便在某个模型拒绝执行时进行弹性回退；在转交给最多三个模型的链之前，它会检查每个响应中是否包含诸如“我不能”或“我无法”之类的措辞。</p><table><tbody><tr><td><p><span><span>端点</span></span><span>&nbsp;</span></p></td><td><p><span><span>https[</span><span>:]//</span><span>openrouter</span><span>[</span><span>.]ai/</span><span>api</span><span>/v1/chat/completions</span></span><span>&nbsp;</span></p></td></tr><tr><td><p><span><span>默认模型</span></span><span>&nbsp;</span></p></td><td><p><span><span>anthropic/claude-opus-4.6</span></span><span>&nbsp;</span></p></td></tr><tr><td><p><span><span>回退链</span></span><span>&nbsp;</span></p></td><td><p><span><span>moonshotai</span><span>/kimi-k2 → google/gemini-2.5-flash</span></span><span>&nbsp;</span></p></td></tr><tr><td><p><span><span>温度</span></span><span>&nbsp;</span></p></td><td><p><span><span>0.2 — 确定性一致的输出</span></span><span>&nbsp;</span></p></td></tr><tr><td><p><span><span>请求格式</span></span><span>&nbsp;</span></p></td><td><p><span><span>手工组装的 JSON；无 SDK；User-Agent Mozilla/5.0</span></span><span>&nbsp;</span></p></td></tr></tbody></table><figure><img src=\"/dailyinfo/media/c8a8cebee8a8a714.webp\" srcset=\"/dailyinfo/media/14c29ee72fb17e5f.webp 720w, /dailyinfo/media/ea91428050bdde14.webp 1200w, /dailyinfo/media/c8a8cebee8a8a714.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Appraisal by AI: Model-driven victim prioritization in the VOLTA infostealer\" width=\"1797\" height=\"472\"><figcaption><span>图 2. 硬编码的模型选择。</span></figcaption></figure><figure><img src=\"/dailyinfo/media/493baee6a0c2855b.webp\" srcset=\"/dailyinfo/media/b01f9c2f8f5245a9.webp 720w, /dailyinfo/media/78a199ec0b506de4.webp 1200w, /dailyinfo/media/493baee6a0c2855b.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Appraisal by AI: Model-driven victim prioritization in the VOLTA infostealer\" width=\"1637\" height=\"240\"><figcaption><span>图 3. 模型选择故障转移至 kimi-k2，随后转移至 gemini-2.5-flash。</span></figcaption></figure><p>模型温度控制 LLM 生成文本的随机性和可预测性。较低的硬编码温度值（0.2）表明攻击者强调准确性和一致性。该恶意软件还使用级联模型链来处理故障。这种多模型架构表明，操作者预料到会遇到拒绝响应，因此后备机制会转向几个规模更小且限制更宽松的模型。</p><p>系统提示词直接揭示了操作者的使用场景：生成一份关于受害者是否适合作为目标的简明分析评估，并提供可审计的引用记录作为依据。</p><figure><img src=\"/dailyinfo/media/9dea29c0a731bd1b.webp\" srcset=\"/dailyinfo/media/80f81d0f58de7f51.webp 720w, /dailyinfo/media/83572699ea616383.webp 1200w, /dailyinfo/media/9dea29c0a731bd1b.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Appraisal by AI: Model-driven victim prioritization in the VOLTA infostealer\" width=\"1750\" height=\"1428\"><figcaption><span>图 4. VOLTA 的原始系统提示词。</span></figcaption></figure><p>提示词还要求完成一项不同寻常的任务，而这正是智能体所擅长的：在稀疏且互不相关的数据之间建立联系。例如，鼓励将受害者的姓名、地址或大学与其密码中的模式联系起来。在这种情况下，模型并非被要求查找数据；而是被要求延展数据，并作出有用的推断，从而提升已抓取数据的价值。</p><h2 id=\"sec-2\">窃密功能&nbsp;</h2><p>VOLTA 的功能与现代数字生活产生的记录高度契合，远超基本的凭据窃取。在单次运行中，该窃密程序可以从基于 Chromium 的浏览器中提取浏览器凭据、Cookie 和已保存的支付卡。它还会针对 Firefox 和 Thunderbird、Outlook 配置文件、Slack 工作区、Steam 和 Battle.net 会话、Discord 令牌、Telegram 会话、Roblox 账户，以及 SSH 和云服务商配置文件（gcloud、OpenVPN、Hide.me）进行窃取。VOLTA 不只是复制加密货币钱包，还会直接对保管库运行内嵌破解程序，并将结果写入其自身报告中的 WALLET VAULTS CRACKED 一行。&nbsp;&nbsp;</p><p>机器上保存的每个 Wi-Fi 密码均通过直接调用 <code>WlanGetProfileList</code> 提取，并转储为明文。</p><figure><img src=\"/dailyinfo/media/755c675a877c6ee7.webp\" srcset=\"/dailyinfo/media/1e3836530e8c0b69.webp 720w, /dailyinfo/media/2ec90c91768a6293.webp 1200w, /dailyinfo/media/755c675a877c6ee7.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Appraisal by AI: Model-driven victim prioritization in the VOLTA infostealer\" width=\"1695\" height=\"1230\"><figcaption><span>图 5. VOLTA 将主机上每个已保存 Wi-Fi 网络的明文密码转储出来。</span></figcaption></figure><figure><img src=\"/dailyinfo/media/abb9e7f2d0b96433.jpg\" srcset=\"/dailyinfo/media/d99b93c72f3a9e29.jpg 720w, /dailyinfo/media/9324900f349d4c67.jpg 1200w, /dailyinfo/media/abb9e7f2d0b96433.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Appraisal by AI: Model-driven victim prioritization in the VOLTA infostealer\" width=\"2000\" height=\"918\"><figcaption><span>图 6. 有条理地收集目标数据。</span></figcaption></figure><p>真正让 VOLTA 有别于普通窃密程序的是初始收集之后的处理。它会进行实时数据增强，利用被盗会话深入挖掘受害者的数据。例如，使用受害者自己的已认证 Gmail 令牌，查询其收件箱中来自 Amazon、DoorDash、Uber Eats、Grubhub、Walmart 和 PayPal 的收据，然后审查这些收据以确认家庭住址。被盗的 Uber Eats 和 DoorDash 会话会被直接调用以获取订单历史。Discord 令牌会被重新用于丰富受害者账户资料。Roblox 库存则通过实时查询“Rolimons[.]com”进行估值。</p><figure><img src=\"/dailyinfo/media/e70b5ff8519d2b13.webp\" srcset=\"/dailyinfo/media/bc3420f917596ed2.webp 720w, /dailyinfo/media/99a6d3034db40433.webp 1200w, /dailyinfo/media/e70b5ff8519d2b13.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Appraisal by AI: Model-driven victim prioritization in the VOLTA infostealer\" width=\"1705\" height=\"480\"><figcaption><span>图 7. 没错：你的 Uber Eats 历史记录如今可能成为潜在隐患。</span></figcaption></figure><p>收集和数据增强阶段完成后，数据会在本地汇编并整理到一个名为“Identity_Report.txt”的文件中。该文件会被序列化为 JSON 格式的压缩包，与系统提示词一并 POST 至 OpenRouter。返回的载荷会被接收为“AI_Analysis.txt”。两个文件会一起外传至“volta_dox.zip”。</p><figure><img src=\"/dailyinfo/media/197ff7ab137c42f3.jpg\" srcset=\"/dailyinfo/media/03129da3eceb0ad1.jpg 720w, /dailyinfo/media/25f69b911603eead.jpg 1200w, /dailyinfo/media/197ff7ab137c42f3.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Appraisal by AI: Model-driven victim prioritization in the VOLTA infostealer\" width=\"2000\" height=\"1081\"><figcaption><span>图 8。VOLTA 的数据外泄可分为三个阶段：1）窃密器运行后（“volta_log.zip”），2）AI 调用后（“volta_dox.zip”），3）网络情报增强产生任何结果后（“volta_doxnet.zip”）。</span></figcaption></figure><p>整个推理往返过程完全通过受害者自己的网络连接，在他们自己的机器上进行，随后结果才会被外泄。&nbsp;</p><h2 id=\"sec-3\">部署模型&nbsp;</h2><p>VOLTA 没有将 Telegram 频道、API 密钥和设置直接硬编码到代码中（编写个人使用工具的人很可能会这样做），而是使用了一个包含六个可替换插槽的模板，并在构建时填入这些内容。&nbsp;&nbsp;</p><p>这表明它采用的是构建者模型：作者出售访问权限，客户提供相应值，构建者为每个订单编译一个定制二进制文件。这些插槽中的凭据经过加密，但并非真正有意义的加密。密钥是同一二进制文件中两个常量的 SHA-256 值，但它之所以存在，大概是因为客户期望自己的 API 密钥不以明文形式存放，而非因为它能提供真正的保护。任何逆向该文件的人都能恢复这些凭据。&nbsp;&nbsp;</p><p>如果 VOLTA 确实是商品化的恶意软件，那么 AI 情报档案功能就不是作者为自己的行动而发明的。它是一项功能，使任何技术水平的客户都能将其指向受害者，并开始在自己的 Telegram 收件箱中接收排名后的目标评估。&nbsp;&nbsp;</p><p>观察到的该恶意软件的所有终端均由第三方控制。没有任何行为者自有基础设施。</p><h2 id=\"sec-4\">对策&nbsp;</h2><p>VOLTA 的大部分令牌窃取能力依赖于绕过 Chrome 中 App-Bound Encryption（ABE）的技术。一项限制哪些进程可使用 <code>--headless</code> 启动 Chrome 的应用程序控制策略，将彻底阻断 ABE 解密路径。至少，你还可以在 Chrome 由任何不在已知开发人员之列的进程使用 <code>--headless</code> 启动时发出警报。用于安全存储凭据的硬件支持存储最佳实践也同样适用。&nbsp;</p><p>一旦发生失陷，主可执行文件可能已自行删除，但用户仍应尝试保留“APPDATA%\\volta_debug.txt”文件。这是一个带时间戳的收集日志，准确记录了所收集的内容以及 LLM 调用是否成功。撤销任何可能已失陷的令牌并更改密码。对于加密货币钱包，如果种子短语曾以明文形式存放在磁盘上，应将该钱包视为已完全失陷，并将资金迁移到一个使用隔离设备生成种子的新钱包中。&nbsp;</p><h2 id=\"sec-5\">结论&nbsp;</h2><p>VOLTA 是一款成熟的窃密器，它在后期增加了一层 AI，唯一目的就是减轻操作者的分析工作。这里 AI 改进的维度并非速度或规模，而是取代人力投入；同样的逻辑也可见于 <a href=\"https://blog.talosintelligence.com/the-closed-quorum-inside-the-first-reported-autonomous-ai-c2-implant/\"><u>CLOSEDQUORUM</u></a>，只是应用在了不同的阶段。这些植入体反映了相同的底层逻辑：找出需要最多持续人工关注的步骤，并将其替换为一次模型调用。对防御者而言，问题不在于这种模式是否会在其他地方出现，而在于它下一步会触及哪个阶段。</p><figure><img src=\"/dailyinfo/media/0024043cbd583fe1.jpg\" srcset=\"/dailyinfo/media/665acee083c39214.jpg 720w, /dailyinfo/media/e029b8aaf814f992.jpg 1200w, /dailyinfo/media/0024043cbd583fe1.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Appraisal by AI: Model-driven victim prioritization in the VOLTA infostealer\" width=\"2000\" height=\"3676\"><figcaption><span>图 9。VOLTA 端到端工作流。</span></figcaption></figure><p>第二个值得关注的趋势是预期模型拒绝以及构建韧性的方法。在这种情况下，它包括从 Claude 到 Kimi 再到 Gemini 的回退链，以及在没有任何密钥时完全跳过 LLM 阶段运行的能力。随着恶意软件中 AI 集成的成熟，拒绝韧性可能成为标准设计要求。&nbsp;</p><p>这两个趋势背后的核心问题是，犯罪软件的投入转移是否会以有意义的方式改变其格局：降低运营门槛、扩大规模上限，还是两者兼有。网络犯罪行动一直是机会主义的，其复杂程度门槛也一直低于人们所设想的水平，但广撒网与会自行筛选的广撒网之间仍有区别。&nbsp;&nbsp;</p><h2 id=\"sec-6\">样本详情</h2><table><tbody><tr><td><p><span><span>SHA256</span></span><span>&nbsp;</span></p></td><td><p><span><span>57ef4242666d78c50df145b34023df564f0fad38812d6a580e66433d427e2279</span></span><span>&nbsp;</span></p></td></tr><tr><td><p><span><span>文件名</span></span><span>&nbsp;</span></p></td><td><p><span><span>9BY0tjwOc3ut.exe / yLP9m5J3i2Aw.exe</span></span><span>&nbsp;</span></p></td></tr><tr><td><p><span><span>类型</span></span><span>&nbsp;</span></p></td><td><p><span><span>PE32+ x86-64</span></span><span>&nbsp;</span></p></td></tr><tr><td><p><span><span>PE 时间戳</span></span><span>&nbsp;</span></p></td><td><p><span><span>2026-08-17 20:35</span></span><span>&nbsp;</span></p></td></tr><tr><td><p><span><span>首次发现时间（UTC）</span></span><span>&nbsp;</span></p></td><td><p><span><span>2026-10-11 12:46</span></span><span>&nbsp;</span></p></td></tr></tbody></table>","original","zhKind","translation","complete","数据窃取","大模型","凭据","Google","Microsoft","Mozilla","Oracle","https://blog.talosintelligence.com/appraisal-by-ai-model-driven-victim-prioritization-in-the-volta-infostealer/","Cisco Talos",{"_131":132,"_133":-5},"changelogVersion","2026-10-01T08:00","release"]
