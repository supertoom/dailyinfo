[{"_1":2,"_3":4},"root",{"_5":111},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1794195830000,"id","jk04xem3x1bums8jlv3t9utre","title","Linux内核IPv4 TCP释放后重用漏洞 CVE-2026-98432 已复现","originalTitle","【已复现】Linux内核IPv4 TCP释放后重用漏洞（CVE-2026-98432）","summary","Linux内核IPv4 TCP释放后重用漏洞 CVE-2026-98432 已由绿盟科技天机实验室复现，CVSS评分9.8。未经身份验证的攻击者可在并发处理TCP连接请求或套接字迁移时发送特制TCP数据包触发use-after-free，造成信息泄露、拒绝服务或权限提升，特定条件下可远程代码执行。","reason","source",{"_71":110},"links",{"_100":109},"publishedAt","2026-11-06T10:03:00.000Z","discoveredAt","2026-11-07T03:28:32.036Z","timelineAt","category","vuln","tags",[103,104,105,106,107,108],"score",71,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body",{"_60":99,"_100":-5,"_101":100,"_102":55},"outline",[81,82,83,84,85],"relatedStories",[77],"topics",[67,68,69],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","faf0UWon4UOc","reportCount",1,"additionalSourceCount",0,{"_70":75,"_71":76},{"_70":73,"_71":74},{"_70":30,"_71":72},"slug","name","漏洞披露","kernel","内核与系统","nsfocus","绿盟科技",{"_78":79,"_13":80},"publicId","931527cd-d2c1-46c8-98e1-79c4b2388dfe","Linux TCP竞态漏洞已修复，RCE仍依赖MPTCP",{"_11":97,"_87":98,"_89":90},{"_11":95,"_87":96,"_89":90},{"_11":93,"_87":94,"_89":90},{"_11":91,"_87":92,"_89":90},{"_11":86,"_87":88,"_89":90},"sec-5","text","4.2 其他防护措施","level",3,"sec-4","4.1 官方升级","sec-3","3.1 人工检测","sec-2","不受影响版本","sec-1","受影响版本","<p><span>NS-CERT</span> <span>2026-11-06 18:03</span> <span>四川</span></p><p><img src=\"/dailyinfo/media/33496952af2599fe.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>近日，绿盟科技CERT监测到Linux发布安全更新，修复了Linux内核IPv4 TCP释放后重用漏洞（CVE-2026-98432）；CVSS评分9.8，目前漏洞细节与PoC已公开，请相关用户尽快采取措施进行防护。</p><p><strong><span>通告编号 NS-2026-0026</span></strong></p><p><span><span>2026-11-06</span></span></p><table><tbody><tr><td><strong><span><span>TAG：</span></span></strong></td><td><p><strong><span><span>Linux内核、use-after-free、CVE-2026-98432</span></span></strong></p></td></tr><tr><td><strong><span><span>漏洞危害：</span></span></strong></td><td><p><strong><span>攻击者利用此漏洞，可实现信息泄露、拒绝服务甚至代码执行。</span></strong></p></td></tr><tr><td><strong><span><span>版本：</span></span></strong></td><td><p><strong><span>1.0</span></strong></p></td></tr></tbody></table><p><strong><span>1</span></strong></p><p><strong><span><span>漏洞概述</span></span></strong></p><p><span>近日，绿盟科技CERT监测到Linux发布安全更新，修复了Linux内核IPv4 TCP释放后重用漏洞（CVE-2026-98432）；由于Linux内核IPv4网络子系统在并发处理TCP连接请求或套接字迁移时存在竞争条件问题，未经身份验证的攻击者可通过发送特制的TCP数据包触发释放后重用（use-after-free），从而造成内核信息泄露、</span><span>拒绝服务或权限提升</span><span>，在特定条件下可实现远程代码执行。CVSS评分9.8，目前漏洞细节与PoC已公开，请相关用户尽快采取措施进行防护。</span></p><p><span>Linux内核是Linux操作系统的核心组件，负责进程管理、内存管理、设备驱动、文件系统及网络协议栈等关键功能，广泛部署于服务器、桌面系统及嵌入式设备中。</span></p><p><span><span>绿盟科技天机实验室已成功复现此漏洞：</span></span></p><p><img src=\"/dailyinfo/media/6a819973561f3cd3.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span>参考链接：</span></p><p><span><a href=\"https://www.openwall.com/lists/oss-security/2026/10/30/1\">https://www.openwall.com/lists/oss-security/2026/10/30/1</a></span></p><p><strong><span>SEE MORE →</span></strong></p><p><span><strong><span>2</span></strong></span><strong><span>影响范围</span></strong></p><h3 id=\"sec-1\"><strong><span>受影响版本</span></strong></h3><p><span>• 4.4 &lt;= Linux Kernel</span></p><p><span>• Linux Kernel 5.10.x &lt; 5.10.272</span></p><p><span>• Linux Kernel 5.15.x &lt; 5.15.223</span></p><p><span>• Linux Kernel 6.1.x &lt; 6.1.190</span></p><p><span>• Linux Kernel 6.6.x &lt; 6.6.159</span></p><p><span>• Linux Kernel 6.12.x &lt; 6.12.113</span></p><p><span>• Linux Kernel 6.18.x &lt; 6.18.56</span></p><p><span>• Linux Kernel 7.2.x &lt; 7.2.10</span></p><p><span>• Linux Kernel 7.3-rc &lt; 7.3-rc7</span></p><p><span>注：4.4/4.9/4.14/4.19/5.4等已停止维护的分支需依赖发行版或商业支持回移补丁。</span></p><h3 id=\"sec-2\"><strong><span>不受影响版本</span></strong></h3><p><span>• Linux Kernel &lt; 4.4</span></p><p><span>• Linux Kernel 5.10.x &gt;= 5.10.272</span></p><p><span>• Linux Kernel 5.15.x &gt;= 5.15.223</span></p><p><span>• Linux Kernel 6.1.x &gt;= 6.1.190</span></p><p><span>• Linux Kernel 6.6.x &gt;= 6.6.159</span></p><p><span>• Linux Kernel 6.12.x &gt;= 6.12.113</span></p><p><span>• Linux Kernel 6.18.x &gt;= 6.18.56</span></p><p><span>• Linux Kernel 7.2.x &gt;= 7.2.10</span></p><p><span>• Linux Kernel 7.3-rc &gt;= 7.3-rc7</span></p><p><span>• Linux Kernel &gt;= 7.3</span></p><p><span><strong><span>3</span></strong></span><strong><span>漏洞检测</span></strong></p><h3 id=\"sec-3\"><strong><span>3.1 人工检测</span></strong></h3><p><span>Linux系统用户可以通过查看内核版本来判断当前系统是否在受影响范围内，查看操作系统版本信息命令如下：</span></p><pre><code><span>cat /proc/version</span></code></pre><p><img alt=\"image\" src=\"/dailyinfo/media/e520a2972da999b7.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span>使用下列命令查看MPTCP是否启用：</span></p><pre><code><span>sysctl net.mptcp.enabled</span></code></pre><p><span><span>若当前版本在受影响范围内且启用了MPTC，则可能存在安全风险。</span></span></p><p><span><strong><span>4</span></strong></span><strong><span>漏洞防护</span></strong></p><h3 id=\"sec-4\"><strong><span>4.1 官方升级</span></strong></h3><p><span>目前官方已发布新版本与安全补丁修复此漏洞，请受影响的用户尽快更新进行防护，下载链接：<a href=\"https://www.kernel.org/\">https://www.kernel.org</a>&nbsp;</span></p><p><span><a href=\"https://git.kernel.org/stable/c/e3f33b0a1d89d738e2b913dab519226eaf76e15b\">https://git.kernel.org/stable/c/e3f33b0a1d89d738e2b913dab519226eaf76e15b</a></span></p><h3 id=\"sec-5\"><strong><span>4.2 其他防护措施</span></strong></h3><p><span>若相关用户暂时无法进行升级操作，在不影响业务的情况下可使用下列措施进行缓解（不可替代补丁）：</span></p><p><span>1、关闭MPTCP并禁用请求套接字迁移，移除sk_reuseport类型的BPF迁移程序，从而降低已公开利用路径的风险；</span></p><pre><code><span>sysctl -w net.mptcp.enabled=0</span><span><br></span><span>sysctl -w net.ipv4.tcpmigratereq=0</span></code></pre><p><span>2、使用防火墙对携带options的IPv4 SYN数据包进行过滤（需业务评估）；</span></p><p><span>3、对非必要开放的TCP服务进行访问控制。</span></p><p><strong><span>END</span></strong></p><p><img src=\"/dailyinfo/media/580a56eb223324fa.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img src=\"/dailyinfo/media/6d721539d6f0094d.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>声明</span></strong></p><p><span>本安全公告仅用来描述可能存在的安全问题，绿盟科技不为此安全公告提供任何保证或承诺。由于传播、利用此安全公告所提供的信息而造成的任何直接或者间接的后果及损失，均由使用者本人负责，绿盟科技以及安全公告作者不为此承担任何责任。</span></p><p><span>绿盟科技拥有对此安全公告的修改和解释权。如欲转载或传播此安全公告，必须保证此安全公告的完整性，包括版权声明等全部内容。未经绿盟科技允许，不得任意修改或者增减此安全公告内容，不得以任何方式将其用于商业目的。</span></p><p><img src=\"/dailyinfo/media/6d721539d6f0094d.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><span><strong><span>绿盟科技CERT</span></strong></span><span><span>∣</span></span><span><span>微信公众号</span></span></p><p><img src=\"/dailyinfo/media/6c3b5fdfef9a38b3.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><img src=\"/dailyinfo/media/955092bfd288c349.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>长按识别二维码，关注网络安全威胁信息</span></span></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=f23afb4b&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzk0MjE3ODkxNg%3D%3D%26mid%3D2247493747%26idx%3D2%26sn%3D286214330ef2b12d3173bf816aeb6ef5\">跳转微信打开</a></p>","original","zhKind","complete","漏洞","复现","漏洞利用","补丁","内核","绿盟","https://mp.weixin.qq.com/s?__biz=Mzk0MjE3ODkxNg==&mid=2247493747&idx=2&sn=286214330ef2b12d3173bf816aeb6ef5","绿盟科技CERT",{"_112":113,"_114":-5},"changelogVersion","2026-10-01T08:00","release"]
