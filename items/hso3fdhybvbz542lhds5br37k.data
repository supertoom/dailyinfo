[{"_1":2,"_3":4},"root",{"_5":113},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1794616829000,"id","hso3fdhybvbz542lhds5br37k","title","Trezor确认3个Safe 5硬件钱包含窃取加密资产的恶意植入","originalTitle","Trezor confirms crypto-stealing implants in three wallets, releases fix","summary","Trezor确认3台由东南亚经销商CryptoBilis销售的Safe 5硬件钱包含恶意硬件植入，可截取屏幕显示或输入的助记词与密码，加密后经移动网络传至攻击者服务器。","reason","source",{"_76":112},"links",{"_61":111},"publishedAt","2026-11-13T19:38:36.000Z","discoveredAt","2026-11-13T20:01:25.042Z","timelineAt","category","activity","tags",[79,77,107,108,109,110],"score",67,"selected",false,"channel","news","story",{"_89":90,"_13":91},"x","readingMode","full","author","Lawrence Abrams","body",{"_103":-5,"_61":104,"_105":-5,"_106":36},"outline",[92,93,94],"relatedStories",[88],"topics",[68,69,70,71,72,73],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","frdXacH3vXsg","reportCount",2,"additionalSourceCount",1,{"_74":86,"_76":87},{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","malware","name","恶意软件","attack","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","iot","IoT 与车联网","supply-chain","供应链安全",{"_89":90,"_13":91},"publicId","fb9309e9-8eb9-4b9f-b1c7-3f14b5206de9","Trezor确认3台Safe 5钱包被植入窃密电路",{"_11":101,"_96":102,"_98":65},{"_11":99,"_96":100,"_98":65},{"_11":95,"_96":97,"_98":65},"sec-3","text","Uncover email threats your existing defenses may miss.","level","sec-2","Trezor cuts reseller network by 80%","sec-1","Firmware update blocks hardware implants","zh","<p><img alt=\"Trezor\" height=\"900\" src=\"/dailyinfo/media/4d8c80693a3919b7.jpg\" srcset=\"/dailyinfo/media/c63c7c15ae5fe07f.jpg 720w, /dailyinfo/media/65c5cd6ad45f4192.jpg 1200w, /dailyinfo/media/4d8c80693a3919b7.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>Cryptocurrency hardware wallet maker Trezor has confirmed that three Safe 5 devices sold by Southeast Asian reseller CryptoBilis contained malicious hardware implants designed to steal wallet recovery phrases and send them to attackers over cellular networks.</p><p>The findings follow an investigation into a <a href=\"https://www.bleepingcomputer.com/news/security/trezor-warns-of-suspected-crypto-theft-implant-in-hardware-wallet/\">suspected hardware implant first reported in October</a>, when a customer discovered an unauthorized circuit board inside a Trezor Safe 5 purchased from Indonesian reseller CryptoBilis.</p><p>At the time, Trezor had not received the device for examination and could not confirm the implant's capabilities.</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/2fef11a936f1caee.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>In a <a href=\"https://trezor.io/blog/news/our-cryptobilis-investigation-what-we-found-and-what-weve-changed\">new investigation update</a>, the company says it has now examined the original device in its laboratory and identified two additional compromised wallets using photographs submitted by their owners.</p><p>All three compromised devices were purchased from CryptoBilis between August 20 and September 23, 2026.</p><p>Trezor says 48 CryptoBilis customers have contacted the company following its October warning, with devices being examined in its laboratory or through photographs of their internal components.</p><p>The company has also inspected devices from other resellers in the region and found no evidence of tampering.</p><p>So far, the confirmed implants have been limited to Safe 5 devices sold through CryptoBilis, and no affected customers have reported losing funds.</p><h2 id=\"sec-1\">Firmware update blocks hardware implants</h2><p>Trezor says its engineers analyzed the implant's firmware and confirmed that the malicious hardware can capture sensitive information displayed or entered on the wallet's screen.</p><p>The implant consists of an additional circuit board installed between the Safe 5's main board and display, allowing it to monitor screen activity without modifying the device's legitimate firmware or Secure Element.</p><p>When wallet recovery words appear on the screen, either during the creation of a new wallet backup or while restoring an existing wallet, the implant collects them.</p><p>It can also capture passphrases displayed on the screen, encrypt the stolen information, and transmit it over a mobile network to an attacker-controlled server.</p><p>If a connection is unavailable, the implant holds on to the captured data and repeatedly attempts to transmit it until successful.</p><p>These reported implants follow confirmed <a href=\"https://www.bleepingcomputer.com/news/security/ledger-confirms-hardware-wallet-spy-implant-behind-crypto-thefts/\">hardware implants previously discovered in Ledger devices</a> sold through CryptoBilis, which have been linked to cryptocurrency thefts.</p><p>On November 11, Trezor released firmware version 2.13.1, which includes protections that prevent the implants from capturing information.</p><p>\"Our latest firmware update 2.13.1, released on November 11th, includes a protection that stops the implants we’ve found from capturing anything on devices that run it, making the current batch of implants useless,\" Trezor said.</p><p>However, the company warns that the update cannot protect wallet recovery phrases that may have already been captured before it was installed.</p><p>While no Trezor customers have reported stolen funs, those who purchased Trezor devices from CryptoBilis are still advised to transfer their cryptocurrency to a newly created wallet using a new recovery phrase.</p><figure><img alt=\"Trezor Safe 5 genuine hardware compared with implanted device\" height=\"600\" src=\"/dailyinfo/media/42c60de784076f88.jpg\" srcset=\"/dailyinfo/media/e2d53a3373298c0a.jpg 720w, /dailyinfo/media/e9ab2707830fb544.jpg 1200w, /dailyinfo/media/42c60de784076f88.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1283\">\n<figcaption><strong>Trezor Safe 5 genuine hardware compared with implanted device</strong><br>\n<em>Source: Trezor</em></figcaption>\n</figure><h2 id=\"sec-2\"><strong>Trezor cuts reseller network by 80%</strong></h2><p>Due to these supply-chain attacks, Trezor has reduced its global reseller network by approximately 80%, significantly reducing the number of third-party resellers of its hardware wallets.</p><p>The company previously announced plans to <a href=\"https://www.bleepingcomputer.com/news/security/ledger-asks-sellers-across-asia-to-halt-sales-after-supply-chain-attack/\">reduce its reseller network</a> in October, following reports of compromised Ledger wallets sold through CryptoBilis. This was before Trezor had learned of implants in its devices as well.</p><p>Trezor says the removed resellers were trustworthy and of no threat, but did not meet the stricter supply-chain security requirements being introduced.</p><p>Remaining partners must follow tighter controls governing how devices are sourced, stored, and accessed.</p><p>The company is offering replacement devices to anyone who purchased a Trezor wallet from CryptoBilis since March 2026, including customers whose devices have not been confirmed as compromised.</p><p>At this time, the company says it has found no evidence of device implants from other resellers and has received no reports of funds being stolen through the compromised Safe 5 wallets.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/c132e890d608eb09.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-3\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Uncover email threats your existing defenses may miss.</a>\n        </h2><p>Adaptive Security's AI agents analyze email intent, context, and behavior to uncover phishing, business email compromise, and invoice fraud.</p><p>See what's getting through with a 14-day read-only scan of Microsoft 365 or Google Workspace, with no MX changes.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Start your free email security scan.</a>\n    </p>","zhKind","complete","后门","数据窃取","供应链投毒","IoT","https://www.bleepingcomputer.com/news/cryptocurrency/trezor-confirms-crypto-stealing-implants-in-three-wallets-releases-fix/","BleepingComputer",{"_114":115,"_116":-5},"changelogVersion","2026-10-01T08:00","release"]
