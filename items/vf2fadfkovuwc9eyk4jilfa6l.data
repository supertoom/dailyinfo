[{"_1":2,"_3":4},"root",{"_5":107},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1794444099000,"id","vf2fadfkovuwc9eyk4jilfa6l","title","CNCERT披露“银狐”木马“金钩（G03）”团伙攻击同花顺仿冒下载站","originalTitle","CNCERT：关于“银狐”木马“金钩（G03）”团伙攻击态势深入分析报告","summary","国家互联网应急中心（CNCERT）与北京观成科技有限公司分析“银狐”木马“金钩（G03）”团伙针对同花顺仿冒下载站的活动。该团伙通过SEO投毒传播捆绑木马的THS.zip，以多阶段内存加载植入远控模块，支持屏幕截图、键盘记录、远程命令执行、插件下发和信息窃取。","reason","报告还原了仿冒同花顺传播链、内存加载流程和通信协议，并提供控制规模与 IOC，便于理解银狐团伙的运营方式。","source",{"_77":106},"links",{"_96":105},"publishedAt","2026-11-10T09:12:00.000Z","discoveredAt","2026-11-10T11:46:19.465Z","timelineAt","category","activity","tags",[80,78,99,100,101,102,90,103,104],"score",85,"selected",true,"channel","news","story",{"_92":93,"_13":94},"x","readingMode","full","author","body",{"_61":95,"_96":-5,"_97":96,"_98":37},"outline",[],"relatedStories",[91],"topics",[68,69,70,71,72,73,74],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fb23pcOOIDuQ","reportCount",3,"additionalSourceCount",2,{"_75":89,"_77":90},{"_75":87,"_77":88},{"_75":85,"_77":86},{"_75":83,"_77":84},{"_75":81,"_77":82},{"_75":79,"_77":80},{"_75":76,"_77":78},"slug","malware","name","恶意软件","attack","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","email","邮件与钓鱼","supply-chain","供应链安全","cncert","CNCERT",{"_92":93,"_13":94},"publicId","7305e03d-78d4-4b63-a9fd-dee2e3f26de6","“金钩”仿冒同花顺大规模植入远控木马","<p><span>CNCERT</span> <span>2026-11-10 17:12</span> <span>北京</span></p><p>以下文章来源于：国家互联网应急中心CNCERT</p><p><strong>国家互联网应急中心CNCERT</strong></p><p>国家计算机网络应急技术处理协调中心（简称“国家互联网应急中心”，英文简称CNCERT或CNCERT/CC），成立于2001年8月，为非政府非盈利的网络安全技术中心，是中国计算机网络应急处理体系中的牵头单位。</p><p><img src=\"/dailyinfo/media/2cefbca26643d492.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><span>本报告由CNCERT和北京观成科技有限公司共同发布。</span></p><p><span><span>一、事件概述</span></span></p><p><span>在“银狐”木马专项工作中，CNCERT监测发现，“银狐”木马“金钩（G03）”团伙近期利用仿冒国内知名证券交易软件的钓鱼网站传播恶意程序。该团伙以国内主流股票行情与证券交易终端“同花顺”为首要模仿对象，搭建外观相似的钓鱼网站，并借助SEO投毒提升仿冒页面在搜索引擎中的曝光度，诱导用户下载、运行捆绑恶意载荷的仿冒安装程序。该程序经多阶段分步加载后，最终在受害机上植入银狐木马，该类银狐木马通过TCP协议与C&amp;C服务器进行通信，具备屏幕截图、插件下发等功能，可对失陷终端实施持续远程控制。</span></p><p><span>专项工作组围绕该团伙的钓鱼域名开展关联分析，研判发现其具有钓鱼框架复用等特征。2026年10月4日至2026年11月02日，CNCERT监测发现该团伙共控制境内肉鸡达25164个。其中，单日上线数量峰值1062个；单日通联数量峰值2569399次。</span></p><p><span><span>二、团伙画像与活动特征</span></span></p><p><span>“银狐”木马“金钩（G03）”团伙最早可追溯至2025年，主要针对国内高校、医疗、证券及科技企业等目标实施攻击，并通过SEO投毒等方式传播恶意程序。</span></p><p><span>（一）团伙概况</span></p><p><span><span>表 1 “金钩（G03）”团伙概况</span></span></p><table><tbody><tr><td><p><b><span><span>项目</span></span></b></p></td><td><p><b><span><span>内容</span></span></b></p></td></tr><tr><td><p><span><span><span>团伙名称</span></span></span></p></td><td><p><span><span><span>“银狐”木马“金钩（</span></span></span><span><span><span>G</span></span></span><span><span><span>03</span></span></span><span><span><span>）</span></span><span><span>”团伙</span></span></span></p></td></tr><tr><td><p><span><span><span>最早可追溯时间</span></span></span></p></td><td><p><span><span><span>2025</span></span></span><span><span><span>年</span></span></span><span><span><span>12</span></span></span><span><span><span>月</span></span></span></p></td></tr><tr><td><p><span><span><span>主要攻击目标</span></span></span></p></td><td><p><span><span><span>国内高校、医疗、证券及科技企业等</span></span></span></p></td></tr><tr><td><p><span><span><span>主要传播渠道</span></span></span></p></td><td><p><span><span><span>搜索引擎投毒</span></span></span></p></td></tr><tr><td><p><span><span><span>主要恶意功能</span></span></span></p></td><td><p><span><span><span>多阶段内存加载、利用注册表实现持久化、远程控制、信息窃取</span></span></span></p></td></tr><tr><td><p><span><span><span>当前活跃情况</span></span></span></p></td><td><p><span><span><span>持续活跃，受控终端日活上千</span></span></span></p></td></tr></tbody></table><p><span>（二）传播资源与基础设施特征</span></p><p><span><span>表 2 传播资源与基础设施特征</span></span></p><table><tbody><tr><td><p><b><span><span><span>观察维度</span></span></span></b></p></td><td><p><b><span><span><span>统计结果</span></span></span></b></p></td><td><p><b><span><span><span>主要特征</span></span></span></b></p></td></tr><tr><td><p><span><span><span>钓鱼网站</span></span></span></p></td><td><p><span><span><span>lojqka</span></span></span><span><span><span>[.]</span></span></span><span><span><span>com</span></span></span><span><span><span>(本次分析样本的传播入口)，注册于</span></span></span><span><span><span>20251219</span></span></span></p><p><span><span><span>目前共发现以下</span></span></span><span><span><span>4</span></span></span><span><span><span>个类似的钓鱼网站：</span></span></span></p><p><span><span><span>10</span></span></span><span><span><span>jqkaapp</span></span></span><span><span><span>[.]</span></span></span><span><span><span>com</span></span></span><span><span><span>，注册于</span></span></span><span><span><span>20260818</span></span></span></p><p><span><span><span>10</span></span></span><span><span><span>jqkapc</span></span></span><span><span><span>[.]</span></span></span><span><span><span>com</span></span></span><span><span><span>，注册于</span></span></span><span><span><span>20260708</span></span></span></p><p><span><span><span>l</span></span></span><span><span><span>0</span></span></span><span><span><span>jqka</span></span></span><span><span><span>[.]</span></span></span><span><span><span>com</span></span></span><span><span><span>，注册于</span></span></span><span><span><span>20260521</span></span></span></p><p><span><span><span>l</span></span></span><span><span><span>0</span></span></span><span><span><span>jqka</span></span></span><span><span><span>[.]</span></span></span><span><span><span>ai</span></span></span><span><span><span>，注册于</span></span></span><span><span><span>20251217</span></span></span></p></td><td><p><span><span><span>域名都围绕同花顺域名</span></span><span><span>“</span></span></span><span><span><span>10</span></span></span><span><span><span>jqka</span></span></span><span><span><span>.</span></span></span><span><span><span>com</span></span></span><span><span><span>.</span></span></span><span><span><span>cn</span></span></span><span><span><span>”进行构造，用小写的字母\"l</span></span></span><span><span><span>\"代替数字\"1\"，小写字母“</span></span></span><span><span><span>o</span></span></span><span><span><span>”代替数字“</span></span></span><span><span><span>0</span></span></span><span><span><span>”。</span></span></span></p><p><span><span><span>钓鱼网站使用自制的网站图标；钓鱼网页中包含特殊图片名与路径</span></span><span><span>“/</span></span></span><span><span><span>skin</span></span></span><span><span><span>/</span></span></span><span><span><span>images</span></span></span><span><span><span>/</span></span></span><span><span><span>texiao</span></span></span><span><span><span>1</span></span></span><span><span><span>.</span></span></span><span><span><span>png</span></span></span><span><span><span>”。</span></span></span></p></td></tr><tr><td><p><span><span><span>解析与托管</span></span></span></p></td><td><p><span><span><span>172</span></span></span><span><span><span>.</span></span></span><span><span><span>67</span></span></span><span><span><span>.</span></span></span><span><span><span>136</span></span></span><span><span><span>[.]</span></span></span><span><span><span>42</span></span></span></p><p><span><span><span>13</span></span></span><span><span><span>.</span></span></span><span><span><span>113</span></span></span><span><span><span>.</span></span></span><span><span><span>93</span></span></span><span><span><span>[.]</span></span></span><span><span><span>176</span></span></span></p><p><span><span><span>104</span></span></span><span><span><span>.</span></span></span><span><span><span>21</span></span></span><span><span><span>.</span></span></span><span><span><span>80</span></span></span><span><span><span>[.]</span></span></span><span><span><span>194</span></span></span></p><p><span><span><span>172</span></span></span><span><span><span>.</span></span></span><span><span><span>67</span></span></span><span><span><span>.</span></span></span><span><span><span>153</span></span></span><span><span><span>[.]</span></span></span><span><span><span>78</span></span></span></p><p><span><span><span>104</span></span></span><span><span><span>.</span></span></span><span><span><span>21</span></span></span><span><span><span>.</span></span></span><span><span><span>59</span></span></span><span><span><span>[.]</span></span></span><span><span><span>154</span></span></span></p><p><span><span><span>172</span></span></span><span><span><span>.</span></span></span><span><span><span>67</span></span></span><span><span><span>.</span></span></span><span><span><span>159</span></span></span><span><span><span>[.]</span></span></span><span><span><span>215</span></span></span></p><p><span><span><span>172</span></span></span><span><span><span>.</span></span></span><span><span><span>67</span></span></span><span><span><span>.</span></span></span><span><span><span>136</span></span></span><span><span><span>[.]</span></span></span><span><span><span>42</span></span></span></p><p><span><span><span>104</span></span></span><span><span><span>.</span></span></span><span><span><span>21</span></span></span><span><span><span>.</span></span></span><span><span><span>62</span></span></span><span><span><span>[.]</span></span></span><span><span><span>131</span></span></span></p></td><td><p><span><span><span>钓鱼网站均托管在</span></span></span><span><span><span>Cloudflare</span></span></span><span><span><span>或亚马逊云</span></span></span><span><span><span>CDN</span></span></span><span><span><span>服务上</span></span></span></p></td></tr><tr><td><p><span><span><span>C</span></span></span><span><span><span>2</span></span></span></p></td><td><p><span><span><span>43</span></span></span><span><span><span>.</span></span></span><span><span><span>199</span></span></span><span><span><span>.</span></span></span><span><span><span>114</span></span></span><span><span><span>[.]</span></span></span><span><span><span>131</span></span></span><span><span><span>:</span></span></span><span><span><span>7777</span></span></span></p><p><span><span><span>52</span></span></span><span><span><span>.</span></span></span><span><span><span>223</span></span></span><span><span><span>.</span></span></span><span><span><span>22</span></span></span><span><span><span>[.]</span></span></span><span><span><span>103</span></span></span><span><span><span>:</span></span></span><span><span><span>2026</span></span></span></p><p><span><span><span>76</span></span></span><span><span><span>.</span></span></span><span><span><span>223</span></span></span><span><span><span>.</span></span></span><span><span><span>113</span></span></span><span><span><span>[.]</span></span></span><span><span><span>170</span></span></span><span><span><span>:</span></span></span><span><span><span>6789</span></span></span></p><p><span><span><span>134</span></span></span><span><span><span>.</span></span></span><span><span><span>122</span></span></span><span><span><span>.</span></span></span><span><span><span>204</span></span></span><span><span><span>[.]</span></span></span><span><span><span>71</span></span></span><span><span><span>:</span></span></span><span><span><span>443</span></span></span></p><p><span><span><span>134</span></span></span><span><span><span>.</span></span></span><span><span><span>122</span></span></span><span><span><span>.</span></span></span><span><span><span>155</span></span></span><span><span><span>[.]</span></span></span><span><span><span>157</span></span></span><span><span><span>:</span></span></span><span><span><span>443</span></span></span></p><p><span><span><span>143</span></span></span><span><span><span>.</span></span></span><span><span><span>92</span></span></span><span><span><span>.</span></span></span><span><span><span>40</span></span></span><span><span><span>.</span></span></span><span><span><span>155</span></span></span><span><span><span>[:]</span></span></span><span><span><span>443</span></span></span></p><p><span><span><span>134</span></span></span><span><span><span>.</span></span></span><span><span><span>122</span></span></span><span><span><span>.</span></span></span><span><span><span>155</span></span></span><span><span><span>[.]</span></span></span><span><span><span>140</span></span></span><span><span><span>:</span></span></span><span><span><span>443</span></span></span></p><p><span><span><span>……</span></span></span></p></td><td><p><span><span><span>C</span></span></span><span><span><span>2</span></span></span><span><span><span>服务器归属地多位于境外，运营商多为</span></span></span><span><span><span>CTGServerLimited</span></span></span><span><span><span>。</span></span></span></p></td></tr></tbody></table><p><span>本次关联到的其他钓鱼网站均使用了自制图标（SHA256: 53b7e792ab43ba2d529772c18f133dc62fd6d54e0139cf6cd7847eac8ddf07ee）。该图标仿冒了官方“同花顺iFinD”的视觉设计（见图1），保留了标志性的白桃与扑克牌扇形元素，但在原图标基础上篡改了配色，将官方纯红色背景改为带渐变分块的双色效果，以此混淆视听。</span></p><table><tbody><tr><td><p><span><img src=\"/dailyinfo/media/9cb650fefc9ff0ee.webp\" loading=\"lazy\" decoding=\"async\"></span></p></td><td><p><span><img src=\"/dailyinfo/media/102a348b1441d7a7.webp\" loading=\"lazy\" decoding=\"async\"></span></p></td></tr></tbody></table><p><span><span>图1 钓鱼网站自制图标（左），同花顺iFinD官方图标（右）</span></span></p><p><span>除自制图标外，这些钓鱼网站在网站布局、图片命名规则及图片存储路径上均呈现出高度一致性。这表明这些站点疑似由同一团伙构建。</span></p><table><tbody><tr><td><p><span><img src=\"/dailyinfo/media/e459c7baa408da44.webp\" loading=\"lazy\" decoding=\"async\"></span></p></td><td><p><span><img src=\"/dailyinfo/media/47ccf079dbdf5dc1.webp\" loading=\"lazy\" decoding=\"async\"></span></p></td></tr></tbody></table><p><span><span>图2 钓鱼网站https[:]//lojqka[.]com中的特殊路径及名称（左），钓鱼网站https[:]//l0jqka[.]ai中的特殊路径及名称（右）</span></span></p><p><img src=\"/dailyinfo/media/66db6d4e68254d98.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>图3 通过特殊路径“/skin/images/texiao1.png”关联到的其他同花顺钓鱼网站</span></span></p><p><span><span>三、典型攻击活动分析</span></span></p><p><span>（一）传播入口</span></p><p><span>攻击者通过搭建仿冒同花顺下载网站https[:]//lojqka[.]com传播银狐木马。该域名与同花顺官方域名10jqka.com[.]cn高度相似，将数字“1”和“0”替换为小写字母“l”和“o”，视觉上极易混淆，是典型的仿冒域名手法。该网站页面整体模仿同花顺官方下载中心，诱导用户点击下载。</span></p><p><img src=\"/dailyinfo/media/91e7c8010fb9ff4c.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>图4 同花顺仿冒网站入口</span></span></p><p><span>（二）跳转与下载链</span></p><p><span>受害者访问仿冒同花顺下载站点https[:]//lojqka[.]com后，会进入一个高度仿真的同花顺下载页面，点击页面上的“立即下载”按钮后，会从“https[:]//dowmasfz[.]cv/THS.zip”下载捆绑木马的安装包THS.zip。</span></p><p><img src=\"/dailyinfo/media/50350b59073ffcce.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>图5 同花顺仿冒网站下载页面</span></span></p><p><img src=\"/dailyinfo/media/01f181cd09499099.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>图6 从dowmasfz.cv下载THS.zip</span></span></p><p><span>受害者通过搜索入口进入lojqka[.]com后，会被引导至其/download 路径下的仿冒同花顺下载页面，当受害者点击“立即下载”按钮后，请求并未指向同花顺官方安装包，而是重定向至dowmasfz[.]cv，最终下载得到捆绑木马的安装包。</span></p><p><span><span>表 3 传播入口及下载链接</span></span></p><table><tbody><tr><td><p><b><span><span>环节</span></span></b></p></td><td><p><b><span><span>URL</span></span></b><b><span><span>/域名</span></span></b></p></td><td><p><b><span><span>作用</span></span></b></p></td><td><p><b><span><span>核验时间</span></span></b></p></td></tr><tr><td><p><span><span>入口</span></span></p></td><td><p><span><span>https</span></span><span><span>[://</span></span><span><span>lojqka</span></span><span><span>.</span></span><span><span>com</span></span></p></td><td><p><span><span><span>搜索入口</span></span></span></p></td><td><p><span><span><span>2026</span></span></span><span><span><span>.</span></span></span><span><span><span>05</span></span></span><span><span><span>.</span></span></span><span><span><span>03</span></span></span></p></td></tr><tr><td><p><span><span>下载页面</span></span></p></td><td><p><span><span>https</span></span><span><span>[://</span></span><span><span>lojqka</span></span><span><span>.</span></span><span><span>com</span></span><span><span>/</span></span><span><span>download</span></span></p></td><td><p><span><span><span>下载页面</span></span></span></p></td><td><p><span><span><span>2026</span></span></span><span><span><span>.</span></span></span><span><span><span>05</span></span></span><span><span><span>.</span></span></span><span><span><span>03</span></span></span></p></td></tr><tr><td><p><span><span>木马下载</span></span></p></td><td><p><span><span>https</span></span><span><span>://</span></span><span><span>dowmasfz</span></span><span><span>.</span></span><span><span>cv</span></span><span><span>/</span></span><span><span>THS</span></span><span><span>.</span></span><span><span>zip</span></span></p></td><td><p><span><span><span>木马下载</span></span></span></p></td><td><p><span><span><span>2026</span></span></span><span><span><span>.</span></span></span><span><span><span>05</span></span></span><span><span><span>.</span></span></span><span><span><span>03</span></span></span></p></td></tr></tbody></table><p><span>（三）样本落地与执行</span></p><p><span>从钓鱼网站下载的仿冒同花顺安装包“THS.zip”解压后得到同名可执行文件“THS.exe”。该文件是WinRAR自解压文件，双击运行后会向“C:\\Users\\用户名\\AppData\\Local\\Temp”目录释放并执行Microsoft.exe与THS_v9.50.51_20260114.exe。Microsoft.exe是银狐木马下载器，THS_v9.50.51_20260114.exe是带有“浙江核新同花顺网络信息股份有限公司”数字签名的白文件。</span></p><p><img src=\"/dailyinfo/media/69ad69f79027892c.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>图7 THS.exe运行后释放两个文件至%Temp%目录下</span></span></p><p><img src=\"/dailyinfo/media/a6d49ac47c9082ec.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>图8 带有同花顺数字签名的白文件</span></span></p><p><span>（四）远程控制与恶意功能</span></p><p><span>Microsoft.exe为银狐木马的加载器，主要负责持久化驻留及后续载荷下载与加载执行。为实现用户级持久化，Microsoft.exe在注册表HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Run下创建名为SystemKKfile的自启动项，使其在用户登录后自动运行。</span></p><p><span>启动后，Microsoft.exe通过TCP协议经非标准端口直连境外C&amp;C服务器43.199.114[.]131:7777，向服务器发送单字节y（0x79）请求获取银狐远控木马，并将其加载至内存中执行，避免以文件形式落地。银狐远控木马复用相同的C&amp;C地址及端口，与服务器建立长期稳定的双向通信，并接收C&amp;C服务器下发的控制指令。</span></p><p><span>本次攻击活动中的银狐远控木马具备屏幕截图、键盘记录、远程命令执行及插件下发等功能，可对受害主机实施持续远程控制。</span></p><p><span><span>四、典型恶意样本分析</span></span></p><p><span>（一）初始载荷与解密加载</span></p><p><span><span>表 4 样本基本信息</span></span></p><table><tbody><tr><td><p><b><span><span>样本标签</span></span></b></p></td><td><p><b><span><span>内容</span></span></b></p></td></tr><tr><td><p><span><span>SHA</span></span><span><span>-</span></span><span><span>256</span></span></p></td><td><p><span><span>ae</span></span><span><span>4697</span></span><span><span>dc</span></span><span><span>3688</span></span><span><span>a</span></span><span><span>45299</span></span><span><span>a</span></span><span><span>038</span></span><span><span>e</span></span><span><span>4</span></span><span><span>b</span></span><span><span>3</span></span><span><span>d</span></span><span><span>08</span></span><span><span>df</span></span><span><span>55</span></span><span><span>a</span></span><span><span>25</span></span><span><span>dd</span></span><span><span>4484273</span></span><span><span>f</span></span><span><span>63</span></span><span><span>ae</span></span><span><span>8922</span></span><span><span>d</span></span><span><span>80</span></span><span><span>f</span></span><span><span>765</span></span><span><span>d</span></span><span><span>35</span></span></p></td></tr><tr><td><p><span><span>MD</span></span><span><span>5</span></span></p></td><td><p><span><span>736</span></span><span><span>da</span></span><span><span>9</span></span><span><span>b</span></span><span><span>2</span></span><span><span>cab</span></span><span><span>1</span></span><span><span>ef</span></span><span><span>70</span></span><span><span>c</span></span><span><span>2973</span></span><span><span>cc</span></span><span><span>211</span></span><span><span>c</span></span><span><span>5636</span></span><span><span>a</span></span></p></td></tr><tr><td><p><span><span>文件名称</span></span></p></td><td><p><span><span>THS</span></span><span><span>.</span></span><span><span>exe</span></span></p></td></tr><tr><td><p><span><span>文件大小</span></span></p></td><td><p><span><span>208</span></span><span><span>,</span></span><span><span>992</span></span><span><span>,</span></span><span><span>017</span></span><span><span>字节</span></span></p></td></tr><tr><td><p><span><span>文件类型</span></span></p></td><td><p><span><span>EXE</span></span></p></td></tr><tr><td><p><span><span>数字签名</span></span></p></td><td><p><span><span>无</span></span></p></td></tr><tr><td><p><span><span>编译</span><span>/时间特征</span></span></p></td><td><p><span><span>2025</span></span><span><span>-</span></span><span><span>02</span></span><span><span>-</span></span><span><span>12 22</span></span><span><span>:</span></span><span><span>02</span></span><span><span>:</span></span><span><span>25</span></span><span><span>编译器</span><span>:&nbsp;</span></span><span><span>MicrosoftVisualC</span></span><span><span>/</span></span><span><span>C</span></span><span><span>++(</span></span><span><span>19</span></span><span><span>.</span></span><span><span>36</span></span><span><span>.</span></span><span><span>34436</span></span><span><span>)[</span></span><span><span>C</span></span><span><span>++]</span></span></p></td></tr><tr><td><p><span><span>投递来源</span></span></p></td><td><p><span><span>https</span></span><span><span>://</span></span><span><span>lojqka</span></span><span><span>[</span></span><span><span>.</span></span><span><span>]</span></span><span><span>com</span></span></p></td></tr><tr><td><p><span><span>主要功能</span></span></p></td><td><p><span><span>向</span><span>“</span></span><span><span>C</span></span><span><span>:\\</span></span><span><span>Users</span></span><span><span>\\用户名\\</span></span><span><span>AppData</span></span><span><span>\\</span></span><span><span>Local</span></span><span><span>\\</span></span><span><span>Temp</span></span><span><span>”目录释放并执行</span></span><span><span>Microsoft</span></span><span><span>.</span></span><span><span>exe</span></span><span><span>与</span></span><span><span>THS</span></span><span><span>_</span></span><span><span>v</span></span><span><span>9</span></span><span><span>.</span></span><span><span>50</span></span><span><span>.</span></span><span><span>51</span></span><span><span>_</span></span><span><span>20260114</span></span><span><span>.</span></span><span><span>exe</span></span></p></td></tr></tbody></table><p><span>Microsoft.exe 作为银狐木马的第一阶段加载器，运行后通过RC4算法解密第二阶段载荷，并在内存中加载执行。</span></p><p><img src=\"/dailyinfo/media/494a7e49405d0d07.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>图9 Microsoft.exe 在内存中使用RC4解密第二阶段载荷</span></span></p><p><span>第二阶段载荷由shellcode和PE文件组成，其中shellcode负责将PE文件加载到内存并执行，PE文件则解密并执行第三阶段载荷。</span></p><p><img src=\"/dailyinfo/media/a07c2d91440d92af.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>图10 第二阶段载荷负责加载将PE文件加载到内存中并执行</span></span></p><p><img src=\"/dailyinfo/media/3883cbcc34365b0a.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>图11 执行第三阶段载荷</span></span></p><p><span>第三阶段载荷通过循环解密自身，还原出用于下载最终远控模块的下载器。该下载器使用XOR算法解密出C&amp;C信息，随后通过TCP协议连接C&amp;C服务器 43.199.114[.]131:7777，并发送单字节请求“y”(0x79)以获取第四阶段载荷。</span></p><p><img src=\"/dailyinfo/media/ef9ff2ff70c9f4bf.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>图12 通过XOR算法解密出C&amp;C地址和端口</span></span></p><p><img src=\"/dailyinfo/media/d9bfc855924ff3df.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>图13 向C&amp;C服务器发送单字节请求“y”，获取第四阶段载荷</span></span></p><p><span>第四阶段载荷由shellcode和经aPLib压缩的DLL文件构成，其中shellcode负责解压DLL文件，该DLL文件即为最终的远控模块。</span></p><p><img src=\"/dailyinfo/media/c651f683810f5bb0.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>图14 从第四阶段载荷中解压出最终远控模块</span></span></p><p><span>（二）持久化与规避检测</span></p><p><span>Microsoft.exe 通过创建名为 SystemKKfile 的自启动项实现持久化驻留。该启动项位于 HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Run 下，属于用户级登录自启动。当受害者输入凭据并成功登录Windows操作系统后，系统会自动读取该注册表项并执行其指向的Microsoft.exe。</span></p><p><img src=\"/dailyinfo/media/8937629b82e88a1c.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>图15 创建名为“SystemKKfile”的自启动项</span></span></p><p><span>Microsoft.exe具备反沙箱能力，会通过统计当前Windows操作系统进程数量判定运行环境。若进程数小于68，则判定当前处于沙箱或虚拟机等隔离分析环境，并加载经过破坏的载荷，以干扰分析。若判定为真实主机，则执行完整的下一阶段载荷。</span></p><p><img src=\"/dailyinfo/media/0fc8ec0ebf5d6149.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>图16 通过统计Windows操作系统进程数量进行反沙箱操作</span></span></p><p><span>（三）窃密、远控或其他恶意功能</span></p><p><span>该银狐木马具备屏幕截图、键盘记录、远程命令执行及插件下发等恶意功能，运行后会收集计算机名、用户名、操作系统版本等主机信息，经XOR加密后发送至C&amp;C服务器43.199.114[.]131:7777。</span></p><p><img src=\"/dailyinfo/media/4b7f050ef5c6ba9f.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>图17 银狐木马收集系统信息的伪代码</span></span></p><p><span>（四）通信协议与配置特征</span></p><p><span>该银狐木马通过TCP协议与C&amp;C服务器通信，通信数据采用XOR算法加密，密钥动态生成，每个会话独立使用一个密钥。加密载荷格式如图18所示。</span></p><p><img src=\"/dailyinfo/media/1cce110a1f9201a5.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>图18 上线包数据格式</span></span></p><p><span>前4字节表示加密数据长度。随后10字节为密钥派生种子，其中前4字节为随机值，后6字节为固定常量“000000007b00”，密钥派生算法为“(key[i] % key0) + key1”，将种子逐字节代入该算法即可生成最终密钥。第15字节起为密文数据。</span></p><p><img src=\"/dailyinfo/media/fd8acf4b13e48d12.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>图19 加密后的上线包数据示例</span></span></p><p><span>以下为上线包数据解密示例。解密后可见银狐木马上线包常获取的几类信息，如主机名、用户名等。</span></p><p><img src=\"/dailyinfo/media/81c6806d11fa8125.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>图20 解密上线包后获取到的系统信息示例</span></span></p><p><span>经拓线发现，上述分析的银狐样本还存在其他变种。该变种在整体功能及执行流程上与上述分析的银狐样本基本一致，主要区别体现在最终载荷的下载方式和通信数据中的固定值。</span></p><p><span>上述分析的银狐样本通过向C&amp;C服务器发送单字节“y”获取最终阶段载荷，变种则通过发送单字节“z”获取最终阶段载荷。在通信数据处理方面，上述分析的银狐样本使用通信数据第5至第14字节生成XOR密钥，其中后6字节为固定数据，固定值为“000000007b00”。变种对应的固定值为“000000007b01”，两者区别在于固定数据的最后一个字节不同，分别为“00”和“01”。</span></p><p><img src=\"/dailyinfo/media/9d65a3a228795fb8.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>图21 变种发送单字节“z”来获取第四阶段载荷</span></span></p><p><img src=\"/dailyinfo/media/d2ce2de5974bc689.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>图22 银狐木马变种的6字节固定常量“000000007b01”</span></span></p><p><span><span>五、团伙关联与同源性分析</span></span></p><p><span>此次攻击活动虽在攻击目标上存在差异，但其样本加密方式、通信数据结构及密钥派生算法均与历史团伙一致。专项工作组综合“样本代码与加密”及“配置及通信协议”两类专属性较高的证据，研判确认本次攻击系同一团伙所为。鉴于该团伙集中利用仿冒同花顺官方下载中心作为诱饵，专项工作组将其命名为“金钩（G03）”。</span></p><p><span><span>表 5 团伙关联与同源性分析</span></span></p><table><tbody><tr><td><p><b><span><span>证据类别</span></span></b></p></td><td><p><b><span><span>本次活动特征</span></span></b></p></td><td><p><b><span><span>历史团伙特征</span></span></b></p></td><td><p><b><span><span>一致性</span></span></b></p></td><td><p><b><span><span>专属性</span><span>/局限</span></span></b></p></td></tr><tr><td><p><span><span>样本代码与加密</span></span></p></td><td><p><span><span>使用</span></span><span><span>XOR</span></span><span><span>算法对通信数据进行加密通信密钥派生算法为</span><span>“</span></span><span><span>key</span></span><span><span>[</span></span><span><span>i</span></span><span><span>] %&nbsp;</span></span><span><span>key</span></span><span><span>0</span></span><span><span>+&nbsp;</span></span><span><span>key</span></span><span><span>1</span></span><span><span>”</span></span></p></td><td><p><span><span>使用</span></span><span><span>XOR</span></span><span><span>算法对通信数据进行加密。密钥派生算法同为</span><span>“</span></span><span><span>key</span></span><span><span>[</span></span><span><span>i</span></span><span><span>] %&nbsp;</span></span><span><span>key</span></span><span><span>0</span></span><span><span>+&nbsp;</span></span><span><span>key</span></span><span><span>1</span></span><span><span>”</span></span><span><span>。</span></span></p></td><td><p><span><span>高</span></span></p></td><td><p><span><span>银狐专属</span></span></p></td></tr><tr><td><p><span><span>配置及通信协议</span></span></p></td><td><p><span><span>使用</span></span><span><span>TCP</span></span><span><span>协议与</span></span><span><span>C</span></span><span><span>&amp;</span></span><span><span>C</span></span><span><span>服务器进行通信，通信数据结构为</span></span><span><span>4</span></span><span><span>字节加密数据长度，</span></span><span><span>10</span></span><span><span>字节用于派生加密密钥的数据及加密的上线包数据。密钥派生数据前</span></span><span><span>4</span></span><span><span>字节为随机值，后</span></span><span><span>6</span></span><span><span>字节为固定值</span><span>“</span></span><span><span>000000007</span></span><span><span>b</span></span><span><span>00</span></span><span><span>”或“</span></span><span><span>000000007</span></span><span><span>b</span></span><span><span>01</span></span><span><span>”</span></span></p></td><td><p><span><span>使用</span></span><span><span>TCP</span></span><span><span>、</span></span><span><span>UDP</span></span><span><span>、</span></span><span><span>HTTP</span></span><span><span>、</span></span><span><span>Websocket</span></span><span><span>及</span></span><span><span>TLS</span></span><span><span>协议与</span></span><span><span>C</span></span><span><span>&amp;</span></span><span><span>C</span></span><span><span>服务器进行通信。在使用</span></span><span><span>UDP</span></span><span><span>协议进行通信时，通信数据结构为</span></span><span><span>4</span></span><span><span>字节加密数据长度，</span></span><span><span>10</span></span><span><span>字节用于派生加密密钥的数据及加密的上线包数据。密钥派生数据前</span></span><span><span>4</span></span><span><span>字节为随机值，后</span></span><span><span>6</span></span><span><span>字节为固定值</span><span>“</span></span><span><span>000000007</span></span><span><span>b</span></span><span><span>01</span></span><span><span>”。</span></span></p></td><td><p><span><span>高</span></span></p></td><td><p><span><span>银狐专属</span></span></p></td></tr></tbody></table><p><span><span>六、活动与控制规模</span></span></p><p><span>2026年10月4日至2026年11月02日期间，CNCERT监测发现该团伙共控制境内肉鸡达25164个。其中，单日上线数量峰值1062个；单日通联数量峰值2569399次。相关变化情况如下图所示。</span></p><p><img src=\"/dailyinfo/media/4231d56f4ba9fbe4.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>图23 每日上线肉鸡数</span></span></p><p><span><span>七、防范建议</span></span></p><p><span>针对“金钩（G03）”团伙的传播方式和样本行为，建议个人用户及有关单位采取以下防范措施：</span></p><p><span>（1）通过软件官方渠道或可信应用商店下载软件。该团伙利用SEO投毒与关键词竞价，使仿冒站点出现在搜索结果前列。使用搜索引擎时，应核实下载来源，尤其注意标注“广告”、“推广”的结果。</span></p><p><span>（2）定期执行安全检查，排查注册表启动项与计划任务，重点核查“SystemKKfile”注册表项及%TEMP%目录中的可疑程序。</span></p><p><span>（3）在网络出口侧全量封堵本次披露的相关IOC；同步在全网终端基于IOC特征开展全盘扫描，清除已落地的恶意样本。</span></p><p><span>（4）安装终端防护软件，定期进行全盘杀毒。</span></p><p><span><span>八、相关IOC</span></span></p><p><span>（1）钓鱼及传播域名：</span></p><p><span>https[:]//lojqka[.]com（失活）</span></p><p><span>（2）下载地址：</span></p><p><span>https[:]//dowmasfz[.]cv/THS.zip（失活）</span></p><p><span>（3）C&amp;CIP及端口：</span></p><p><span>43.199.114[.]131:7777（失活）</span></p><p><span>52.223.22[.]103:2026(变种、失活)</span></p><p><span>76.223.113[.]170:6789(变种、失活)</span></p><p><span>134.122.155[.]140</span></p><p><span>204.194.50[.]202</span></p><p><span>143.92.40[.]155</span></p><p><span>134.122.189[.]47</span></p><p><span>143.92.40[.]243</span></p><p><span>134.122.155[.]157</span></p><p><span>118.107.44[.]141</span></p><p><span>134.122.204[.]118</span></p><p><span>134.122.200[.]118</span></p><p><span>134.122.155[.]105</span></p><p><span>154.201.82[.]55</span></p><p><span>118.107.47[.]92</span></p><p><span>134.122.204[.]71</span></p><p><span>134.122.129[.]44</span></p><p><span>134.122.189[.]31</span></p><p><span>1.32.250[.]70</span></p><p><span>134.122.155[.]16</span></p><p><span>134.122.129[.]33</span></p><p><span>103.101.176[.]18</span></p><p><span>143.92.40[.]244</span></p><p><span>118.107.44[.]226</span></p><p><span>143.92.43[.]162</span></p><p><span>134.122.155[.]14</span></p><p><span>134.122.155[.]150</span></p><p><span>143.92.37[.]202</span></p><p><span>134.122.189[.]27</span></p><p><span>118.107.44[.]15</span></p><p><span>（4）C&amp;C域名</span></p><p><span>yhao.sxkj999[.]vip</span></p><p><span>hk3.1984233[.]xyz</span></p><p><span>tj.edatonee[.]com</span></p><p><span>afa.sxkj999[.]vip</span></p><p><span>www.khop112[.]cfd</span></p><p><span>ahua.sxkj999[.]vip</span></p><p><span>gcheng.sxkj999[.]vip</span></p><p><span>laomo.sxkj999[.]vip</span></p><p><span>dan.sxkj999[.]vip</span></p><p><span>yifan.sxkj999[.]vip</span></p><p><span>haiwen.sxkj999[.]vip</span></p><p><span>test.nanhuasell[.]com</span></p><p><span>andi.sxkj999[.]vip</span></p><p><span>four.x517l[.]com</span></p><p><span>xsi.sxkj999[.]vip</span></p><p><span>cchen.sxkj999[.]vip</span></p><p><span>(5)样本SHA-256：</span></p><p><span>ae4697dc3688a45299a038e4b3d08df55a25dd4484273f63ae8922d80f765d35(43.199.114[.]131:7777)</span></p><p><span>c7fc37bc64f00c3aaf8422737a4c11ccb2d682ad283c0191e40c3b0fe7861279(52.223.22[.]103:2026)</span></p><p><span>413bbbcb3d3a0a97da6fbdbb71a92ce048c1016acfaf3cafbd5e58b1c6cb1008(76.223.113[.]170:6789)</span></p><p><strong><span><span>推荐阅读</span></span></strong></p><ul><li><p><span><a href=\"http://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247499450&amp;idx=2&amp;sn=2da3ca2e0b4d4f9f56ea7f7579afc378&amp;chksm=ebfab99adc8d308c3ba6e7a74bd41beadf39f1b0e38a39f7235db4c305c06caa49ff63a0cc1d&amp;scene=21#wechat_redirect\">网安智库平台长期招聘兼职研究员</a></span></p></li><li><p><span><span><a href=\"https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&amp;mid=2247501251&amp;idx=1&amp;sn=8b6ebecbe80c1c72317948494f87b489&amp;chksm=ebfa82e3dc8d0bf595d039e75b446e14ab96bf63cf8ffc5d553b58248dde3424fb18e6947440&amp;token=525430415&amp;lang=zh_CN&amp;scene=21#wechat_redirect\">欢迎加入“安全内参热点讨论群”</a></span></span></p></li></ul><hr><p><span><span>文章来源：</span><span>国家互联网应急中心CNCERT</span></span></p><p><span><span>点击下方卡片关注我们，</span></span></p><p><span><span>带你一起读懂网络安全 ↓</span></span></p><p><a href=\"https://www.secrss.com/?wx\">阅读原文</a></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=04b81575&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzI4NDY2MDMwMw%3D%3D%26mid%3D2247516863%26idx%3D2%26sn%3Dcee958d56977506d31b586bf4297c108\">跳转微信打开</a></p>","original","zhKind","complete","钓鱼","后门","数据窃取","供应链","Cloudflare","AWS","https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&mid=2247516863&idx=2&sn=cee958d56977506d31b586bf4297c108","安全内参",{"_108":109,"_110":-5},"changelogVersion","2026-10-01T08:00","release"]
