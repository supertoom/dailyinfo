[{"_1":2,"_3":4},"root",{"_5":91},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1794195832000,"id","p0n6ok2brl2a0nzaveu5s7rhg","title","WordPress Core CVE-2026-119977 竞争条件 RCE 漏洞已复现并发现利用","originalTitle","【已复现】WordPress Core 竞争条件远程代码执行漏洞(CVE-2026-119977)安全风险通告","summary","WordPress Core 竞争条件远程代码执行漏洞 CVE-2026-119977 已被奇安信 CERT 成功复现，并监测到在野利用；CVSS 3.1 分数为 8.1，评级高危，PoC 与技术细节均已公开。","reason","文章复现了漏洞利用链，并给出受影响版本、修复版本与临时拦截路径，便于站点管理员核对升级窗口和核心版本。","source",{"_72":90},"links",{"_80":89},"publishedAt","2026-11-04T09:26:00.000Z","discoveredAt","2026-11-04T12:34:23.330Z","timelineAt","category","vuln","tags",[83,73,84,85,86,87,88],"score",86,"selected",true,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","body",{"_61":79,"_80":-5,"_81":80,"_82":37},"outline",[],"relatedStories",[75],"topics",[68,69],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fZ9Zm3CH5Pm4","reportCount",2,"additionalSourceCount",1,{"_70":31,"_72":74},{"_70":71,"_72":73},"slug","exploited","name","在野利用","漏洞披露",{"_76":77,"_13":78},"publicId","e1fdb3a8-c2ee-4997-b810-8c81fad6b2f1","WordPress核心竞争条件RCE漏洞已被在野利用","<p><span>奇安信 CERT</span> <span>2026-11-04 17:26</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/4aeeea2ed0748a61.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>致力于第一时间为企业级用户提供权威漏洞情报和有效解决方案。</p><p><span><span>●&nbsp;</span></span><span><span>点击↑蓝字关注我们，获取更多安全风险通告</span></span></p><hr><table><tbody><tr><td colspan=\"4\" align=\"center\"><p><span><strong><span><span>漏洞概述</span></span></strong></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>漏洞名称</span></span></strong></span></p></td><td colspan=\"3\" align=\"left\"><p><span><span>WordPress Core 竞争条件远程代码执行漏洞</span></span></p></td></tr><tr><td align=\"left\"><p><span><span><strong><span>漏洞编号</span></strong></span></span></p></td><td colspan=\"3\" align=\"left\"><p><span><span>QVD-2026-102501</span><span>，</span><span>CVE-2026-119977</span></span></p></td></tr><tr><td align=\"left\"><p><strong><span><strong><span><span>公开时间</span></span></strong></span></strong></p></td><td align=\"left\"><p><span><span>2026-10-31</span></span></p></td><td align=\"left\"><p><strong><span><strong><span><span>影响量级</span></span></strong></span></strong></p></td><td align=\"left\"><p><span><span>百万级</span></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>奇安信评级</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>高危</span></span></strong></span></p></td><td align=\"left\"><p><strong><span><span>CVSS 3.1分数</span></span></strong></p></td><td align=\"left\"><p><span><span><strong><span>8.1</span></strong></span></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span>威胁类型</span></strong></span></p></td><td align=\"left\"><p><span><span><span>代码执行</span></span></span></p></td><td align=\"left\"><p><strong><span><span>利用可能性</span></span></strong></p></td><td align=\"left\"><p><strong><span><strong><span>高</span></strong></span></strong></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>POC状态</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>已公开</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>在野利用状态</span></span></strong></span></p></td><td align=\"left\"><p><span><span><span>已发现</span></span></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>EXP状态</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span><span>未公开</span></span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>技术细节状态</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span><span>已公开</span></span></span></strong></span></p></td></tr><tr><td colspan=\"4\" align=\"left\"><p><strong><span><span>危害描述：</span></span></strong><span><span>攻击者可利用该漏洞，在升级窗口内通过竞争条件注入恶意配置，最终实现任意代码执行，导致服务器完全沦陷。</span></span></p></td></tr></tbody></table><p><strong><span>0</span></strong><strong><span>1</span></strong></p><p><strong><span>漏洞详情</span></strong></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>影响组件</span></span></strong></p><p><span>WordPress 是全球最广泛使用的开源内容管理系统（CMS），基于 PHP 和 MySQL/MariaDB 构建，提供文章发布、页面管理、媒体库、插件扩展与主题换肤等完整建站能力。它既可通过 WordPress.org 官方托管服务使用，也可免费下载自建于各类 Web 服务器环境，凭借丰富的生态和易用性成为个人博客、企业官网、新闻媒体及电商平台的主流选择，目前为全球约 43% 的网站提供底层支撑。</span></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>漏洞描述</span></span></strong></p><p><span>近日，奇安信CERT监测到<span>WordPress Core 竞争条件远程代码执行漏洞(CVE-2026-119977)</span>在野利用。该漏洞源于完整包核心升级过程中，升级程序将更新包解压至 wp-content/upgrade/ 下基于包名生成的可预测、Web 可访问临时目录（相关代码位于 class-wp-upgrader.php、class-core-upgrader.php、update-core.php 等）。临时目录包含安装程序 setup-config.php，且在升级窗口期间可被外部 HTTP 请求直接执行。攻击者可利用该漏洞，在升级窗口内通过竞争条件注入恶意配置，最终实现任意代码执行，导致服务器完全沦陷。<span>目前该漏洞PoC和技术细节已公开。</span></span><span><span>鉴于该漏洞已发现在野利用，建议客户尽快做好自查及防护。</span></span></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>利用条件</span></span></strong></p><p><span><span>1.正在执行完整包核心更新；</span></span></p><p><span><span>2.暂存目录可公开访问；</span></span></p><p><span><span>3.暂存路径可预测。</span></span></p><p><strong><span>02</span></strong></p><p><strong><span>影响范围</span></strong></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>影响版本</span></span></strong></p><p><span>4.7.0 &lt;= WordPress &lt;= 4.7.38</span></p><p><span>4.8.0 &lt;= WordPress &lt;= 4.8.33</span></p><p><span>4.9.0 &lt;= WordPress &lt;= 4.9.34</span></p><p><span>5.0.0 &lt;= WordPress &lt;= 5.0.30</span></p><p><span>5.1.0 &lt;= WordPress &lt;= 5.1.27</span></p><p><span>5.2.0 &lt;= WordPress &lt;= 5.2.29</span></p><p><span>5.3.0 &lt;= WordPress &lt;= 5.3.26</span></p><p><span>5.4.0 &lt;= WordPress &lt;= 5.4.24</span></p><p><span>5.5.0 &lt;= WordPress &lt;= 5.5.23</span></p><p><span>5.6.0 &lt;= WordPress &lt;= 5.6.22</span></p><p><span>5.7.0 &lt;= WordPress &lt;= 5.7.20</span></p><p><span>5.8.0 &lt;= WordPress &lt;= 5.8.18</span></p><p><span>5.9.0 &lt;= WordPress &lt;= 5.9.19</span></p><p><span>6.0.0 &lt;= WordPress &lt;= 6.0.17</span></p><p><span>6.1.0 &lt;= WordPress &lt;= 6.1.15</span></p><p><span>6.2.0 &lt;= WordPress &lt;= 6.2.14</span></p><p><span>6.3.0 &lt;= WordPress &lt;= 6.3.13</span></p><p><span>6.4.0 &lt;= WordPress &lt;= 6.4.13</span></p><p><span>6.5.0 &lt;= WordPress &lt;= 6.5.13</span></p><p><span>6.6.0 &lt;= WordPress &lt;= 6.6.10</span></p><p><span>6.7.0 &lt;= WordPress &lt;= 6.7.10</span></p><p><span>6.8.0 &lt;= WordPress &lt;= 6.8.11</span></p><p><span>6.9.0 &lt;= WordPress &lt;= 6.9.10</span></p><p><span>7.0.0 &lt;= WordPress &lt;= 7.0.7</span></p><p><span>7.1.0 &lt;= WordPress &lt;= 7.1.3</span></p><p><span><span>注意：</span>底层脆弱代码自 WordPress 2.7/2.8 引入的内置核心更新器即已存在，2.7-4.6分支已无官方修复版本。</span></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>其他受影响组件</span></span></strong></p><p><span><span>无</span></span></p><p><strong><span>03</span></strong></p><p><strong><span>复现情况</span></strong></p><p><span><span>目前，</span><span>奇安信CERT已成功复现</span><span><span>WordPress Core 竞争条件远程代码执行漏洞(CVE-2026-119977)</span></span><span>，截图如下：</span></span></p><p><img src=\"/dailyinfo/media/8f6f9ec88eedbe4b.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>04</span></strong></p><p><strong><span>受影响资产情况</span></strong></p><p><span><span>奇安信鹰图资产测绘平台数据显示，</span><span><span>WordPress Core 竞争条件远程代码执行漏洞(CVE-2026-119977)</span></span><span>关联的国内风险资产总数为48714个，关联IP总数为14700个。国内风险资产分布情况如下：</span></span></p><p><img src=\"/dailyinfo/media/86c6372a163c5b4f.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span><span>WordPress Core 竞争条件远程代码执行漏洞(CVE-2026-119977)</span></span><span>关联的全球风险资产总数为1219476个，关联IP总数为379271个。全球风险资产分布情况如下：</span></span></p><p><img src=\"/dailyinfo/media/05f957bcc779fddc.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>05</span></strong></p><p><strong><span>处置建议</span></strong></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>安全更新</span></span></strong></p><p><span>目前 WordPress 官方已发布安全更新，建议受影响用户尽快升级至对应修复版本：</span></p><p><span>WordPress 4.7.* &gt;= 4.7.39</span></p><p><span>WordPress 4.8.* &gt;= 4.8.34</span></p><p><span>WordPress 4.9.* &gt;= 4.9.35</span></p><p><span>WordPress 5.0.* &gt;= 5.0.31</span></p><p><span>WordPress 5.1.* &gt;= 5.1.28</span></p><p><span>WordPress 5.2.* &gt;= 5.2.30</span></p><p><span>WordPress 5.3.* &gt;= 5.3.27</span></p><p><span>WordPress 5.4.* &gt;= 5.4.25</span></p><p><span>WordPress 5.5.* &gt;= 5.5.24</span></p><p><span>WordPress 5.6.* &gt;= 5.6.23</span></p><p><span>WordPress 5.7.* &gt;= 5.7.21</span></p><p><span>WordPress 5.8.* &gt;= 5.8.19</span></p><p><span>WordPress 5.9.* &gt;= 5.9.20</span></p><p><span>WordPress 6.0.* &gt;= 6.0.18</span></p><p><span>WordPress 6.1.* &gt;= 6.1.16</span></p><p><span>WordPress 6.2.* &gt;= 6.2.15</span></p><p><span>WordPress 6.3.* &gt;= 6.3.14</span></p><p><span>WordPress 6.4.* &gt;= 6.4.14</span></p><p><span>WordPress 6.5.* &gt;= 6.5.14</span></p><p><span>WordPress 6.6.* &gt;= 6.6.11</span></p><p><span>WordPress 6.7.* &gt;= 6.7.11</span></p><p><span>WordPress 6.8.* &gt;= 6.8.12</span></p><p><span>WordPress 6.9.* &gt;= 6.9.11</span></p><p><span>WordPress 7.0.* &gt;= 7.0.8</span></p><p><span>WordPress 7.1.* &gt;= 7.1.4</span></p><p><span>站点管理员可通过 WordPress 后台进行升级，也可从 WordPress 官方渠道下载最新安装包进行手动更新。</span></p><p><span>若站点已开启自动更新，应确认核心版本已成功更新至修复版本。</span></p><p><span>官方公告地址：</span></p><p><span><a href=\"https://wordpress.org/news/2026/10/wordpress-7-1-4/\">https://wordpress.org/news/2026/10/wordpress-7-1-4/</a></span></p><p><span><span>临时缓解措施：</span></span></p><p><span>1.在升级前通过 Web 服务器配置（.htaccess、Nginx 规则等）拒绝对 /wp-content/upgrade/ 的 HTTP 访问。</span></p><p><span>2.使用 WAF /防火墙拦截对 setup-config.php 及 wp-content/upgrade 路径的异常请求。</span></p><p><strong><span>06</span></strong></p><p><strong><span>参考资料</span></strong></p><p><span><span>[1]<a href=\"https://www.wordfence.com/threat-intel/vulnerabilities/wordpress-core/wordpress-core-470-713-unauthenticated-upgrade-window-staged-installer-remote-code-execution\">https://www.wordfence.com/threat-intel/vulnerabilities/wordpress-core/wordpress-core-470-713-unauthenticated-upgrade-window-staged-installer-remote-code-execution</a></span></span></p><p><span><span>[2]<a href=\"https://xint.io/blog/wordpress-core-update-attack\">https://xint.io/blog/wordpress-core-update-attack</a></span></span></p><p><span><span>[3]</span><span><a href=\"https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2026-119977\">https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2026-119977</a></span></span></p><p><strong><span>07</span></strong></p><p><strong><span>时间线</span></strong></p><p><span><span>2026年11月04日，奇安信 CERT发布安全风险通告。</span></span></p><p><strong><span>08</span></strong></p><p><strong><span>漏洞情报服务</span></strong></p><p><span><span>「</span><span>奇安信漏洞情报平台</span><span>」</span><span>重磅上线，诚邀您来体验：</span></span></p><p><img alt=\"图片\" src=\"/dailyinfo/media/bf69563623d519b4.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img alt=\"图片\" src=\"/dailyinfo/media/90f0a57d70cc9376.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img alt=\"图片\" title=\"CERT LOGO.png\" width=\"100%\" src=\"/dailyinfo/media/f404b6132e3ed76b.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><strong><span>奇安信 CERT</span></strong></span></p><p><span><strong><span><span>致力于</span></span></strong><span><span>第一时间为企业级用户提供</span><strong><span><span>权威</span></span></strong><span>漏洞情报和</span></span><strong><span><span>有效</span></span></strong><span><span>解决方案。</span></span></span></p><p><span><span><span>点击↓</span><strong><span><span>阅读原文</span></span></strong><span>，到</span></span><strong><span><span>ALPHA威胁分析平台</span></span></strong><span><span>订阅更多漏洞信息。</span></span></span></p><p><a href=\"https://ti.qianxin.com/portal/subscription\">阅读原文</a></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=03b7a1e2&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzU5NDgxODU1MQ%3D%3D%26mid%3D2247508010%26idx%3D1%26sn%3D7907e2aaa98df6d9be2a950b5064bac4\">跳转微信打开</a></p>","original","zhKind","complete","漏洞","补丁","复现","漏洞利用","奇安信","CISA","https://mp.weixin.qq.com/s?__biz=MzU5NDgxODU1MQ==&mid=2247508010&idx=1&sn=7907e2aaa98df6d9be2a950b5064bac4","奇安信 CERT",{"_92":93,"_94":-5},"changelogVersion","2026-10-01T08:00","release"]
