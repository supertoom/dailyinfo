[{"_1":2,"_3":4},"root",{"_5":108},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1795653655000,"id","z2y59mturdxdsohd70ruzokq3","title","Cursor 遭供应链入侵，恶意 Claude Code 扩展向最多 5,000 名开发者分发 SSH 后门","originalTitle","Cursor confirms security breach led to malicious Claude Code extension","summary","Cursor 确认攻击者窃取 Fireworks AI 的访问密钥，访问内部系统并获取未脱敏 API 凭据，随后于 October 29 通过 Cursor marketplace 分发恶意 Claude Code 扩展 2.1.312 和 2.1.313。","reason","source",{"_74":107},"links",{"_93":106},"publishedAt","2026-11-14T17:27:25.000Z","discoveredAt","2026-11-14T17:32:26.461Z","timelineAt","category","activity","tags",[77,99,100,75,101,102,103,104,105],"score",74,"selected",true,"channel","news","story",{"_81":82,"_13":83},"x","sameEvent",{"_11":97,"_13":98},"readingMode","full","author","Lawrence Abrams","body",{"_62":92,"_93":-5,"_94":95,"_96":36},"outline",[84,85],"relatedStories",[80],"topics",[69,70,71],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","fy_fiy4_d7JU","reportCount",3,"additionalSourceCount",2,{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","malware","name","恶意软件","attack","攻击活动","ai-offense","AI 攻防",{"_81":82,"_13":83},"publicId","34d3a30d-bb8e-4d64-b044-b3bc104a68ed","Cursor恶意扩展已下架，影响范围待确认",{"_11":90,"_87":91,"_89":68},{"_11":86,"_87":88,"_89":68},"sec-2","text","发现现有防御可能遗漏的电子邮件威胁。","level","sec-1","黑色十月","<p><img alt=\"Cursor\" height=\"900\" src=\"/dailyinfo/media/46c17eead8b9cac0.webp\" srcset=\"/dailyinfo/media/7ef30ba8272d6b9e.webp 720w, /dailyinfo/media/532c5c2e20b295de.webp 1200w, /dailyinfo/media/46c17eead8b9cac0.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>Cursor 证实其遭受了一起安全入侵，攻击者在窃取 AI 基础设施提供商 Fireworks AI 的凭据后，通过其市场分发了恶意的 Claude Code 扩展。</p><p>这次入侵还使攻击者得以访问内部系统并窃取客户数据，包括历史 AI 编程代理轨迹，其中包含未编辑处理的凭据，后来这些凭据被用于入侵更多服务。</p><p>Cursor 在周五发布的<a href=\"https://cursor.com/blog/security-incident-update\">新事件报告</a>中披露了此次入侵。报告解释了攻击者如何在 10 月 29 日通过 Cursor 的市场分发<a href=\"https://www.bleepingcomputer.com/news/security/malicious-claude-code-extension-on-cursor-planted-ssh-backdoors/\">Anthropic 的 Claude Code 扩展恶意版本</a>。</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/256305b98cea3e96.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>此次攻击使最多 5,000 名开发者接触到一种会安装持久 SSH 后门的恶意软件。</p><p>Cursor 是一款基于 Microsoft 开源 Visual Studio Code（VS Code）构建的 AI 编程代码编辑器，可让开发者借助 AI 助手编写、修改和调试软件。</p><p>据 Cursor 称，此次攻击始于攻击者取得存储在 Fireworks AI 上的访问密钥。Fireworks AI 是一家用于 AI 模型训练和推理的第三方提供商。</p><p>攻击者使用泄露的密钥，从 Cursor 用于与 Fireworks 共享信息的只读存储桶中复制了数据。</p><p>该存储桶包含从 2025 年起收集的大部分历史 AI 编程代理轨迹，来源是未启用隐私模式且其数据可用于模型训练的用户。其中一些轨迹包含未编辑处理的 API 凭据，使攻击者得以访问更多 Cursor 系统。</p><p>Cursor 表示，编程代理轨迹遭泄露的用户不足 0.05%，API 凭据遭入侵的客户不足 0.01%。</p><p>攻击者使用泄露的凭据，从 Cursor 的多项软件即服务（SaaS）工具中窃取了数据，包括：</p><ul>\n\t<li>已归档的 Cursor 非生产源代码仓库，其中一些包含业务联系信息。</li>\n\t<li>有限的客户支持信息和电子邮件往来记录。</li>\n\t<li>产品使用指标和客户联系信息。</li>\n\t<li>部分 AI 编程代理对话的摘要。</li>\n\t<li>客户此前提供给 Cursor 支持团队的凭据。</li>\n</ul><p>Cursor 表示，其监控系统检测到了未经授权的活动，促使公司撤销 Fireworks 访问密钥、轮换泄露的凭据，并调查其他未经授权的访问。</p><p>随着调查推进，Cursor 暂时关闭了一些内部和产品服务，以防万一。</p><p>然而，攻击者已经取得了一项凭据，使其能够通过 Cursor 的市场分发扩展。</p><p>10 月 29 日，攻击者使用该凭据，在 Cursor 的 VS Code 扩展市场上发布了 Anthropic 的 Claude Code 扩展恶意副本。</p><p>Cursor 解释道：“10 月 29 日，攻击者利用从我们内部系统泄露数据中取得的被盗凭据，将 Anthropic 的 Claude Code 扩展恶意且未经授权的副本直接放到了用于提供 Cursor VS Code 扩展市场服务的缓存中。”</p><p>此次攻击并未入侵 Anthropic 的官方扩展或 Open VSX；后者是 Cursor 使用的扩展市场。</p><p>这些恶意扩展的版本为 2.1.312 和 2.1.313，在 Cursor 将其下架前可获取约 11 小时。</p><p>正如 BleepingComputer <a href=\"https://www.bleepingcomputer.com/news/security/malicious-claude-code-extension-on-cursor-planted-ssh-backdoors/\">此前报道</a>的，攻击者修改了正版 Claude Code 扩展，使其执行恶意 JavaScript，试图在开发者计算机上安装持久 SSH 后门。</p><p>该恶意软件收集系统信息、安装攻击者控制的 SSH 密钥、尝试启用 SSH 访问，并配置持久化机制以维持远程访问。</p><p>然而，安全研究人员发现了代码错误，该后门很可能无法在许多尚未启用 SSH 的 Windows 和 macOS 系统上运行。</p><p>Cursor 估计，在暴露期间请求受影响扩展版本的最多 5,000 名用户可能收到了恶意构建版本。</p><p>该公司表示，其生产基础设施、官方应用发布版本、客户代码存储库，以及启用了隐私模式的用户所属的代码和提示词均未受到影响。</p><p>Cursor 表示，作为预防措施，已将所有推理流量迁移 away from Fireworks，撤销并轮换了暴露的凭据，重建了扩展市场，并重新部署了生产基础设施。</p><p>建议在攻击期间安装或更新了受影响 Claude Code 扩展的客户遵循 <a href=\"https://cursor.com/blog/security-notice-claude-code-extension\">Cursor 的补救指南</a>。</p><h2 id=\"sec-1\">黑色十月</h2><p>这起事件发生在一波针对 AI 开发平台的攻击浪潮之中，网络安全公司 Wiz 将其称为 <a href=\"https://www.wiz.io/blog/black-october-for-ai-developer-platforms\">“黑色十月”</a>。</p><p>这些攻击针对开发基础设施，以窃取身份验证凭据，尤其是那些可访问 AI 模型的凭据。</p><p>被盗凭据已被用于未经授权的 AI 推理，为受影响客户产生了巨额费用，部分事件还与尝试进行 AI 模型蒸馏有关。</p><p>这些攻击影响了众多公司，包括 <a href=\"https://www.bleepingcomputer.com/news/apple/railway-breach-leads-to-740-000-in-fraudulent-ai-charges/\">Railway</a>、Northflank、Lightning AI、<a href=\"https://www.bleepingcomputer.com/news/security/opencode-hack-exposes-api-keys-amid-ai-distillation-attacks/\">OpenCode</a> 和 <a href=\"https://www.bleepingcomputer.com/news/security/warp-discloses-breach-exposing-ai-agent-logs-user-telemetry-data/\">Warp</a>。</p><p>在 Railway，攻击者窃取了客户身份验证密钥，随后利用这些密钥产生了约 $740,000 的欺诈性 AI 费用。OpenCode 也报告了 API 密钥暴露和未经授权的 AI 使用。</p><p>Fireworks AI 也受到影响，于 10 月 <a href=\"https://www.bleepingcomputer.com/news/security/fireworks-ai-discloses-new-breach-after-cloud-provider-hack/\">披露了多起安全事件</a>，其中一起涉及 API 密钥和令牌暴露，另一起则是攻击者通过遭入侵的第三方云提供商访问了开发人员计算机。</p><p>Fireworks 事件还影响了其他客户，包括 <a href=\"https://www.bleepingcomputer.com/news/security/notion-says-fireworks-breach-exposed-customer-ai-chat-transcripts/\">Notion</a>；该公司最近披露，少数工作区的 AI 聊天记录遭到暴露。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/0f821b73ff70ca16.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-2\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体会分析电子邮件意图、上下文和行为，以发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>通过对比 Microsoft 365 或 Google Workspace 进行 14 天只读扫描，查看有哪些威胁正在绕过防护，且无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始免费电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","csx9vu3di8zmsxvxnk492znx4","Fireworks AI 凭据泄露引发 Cursor 供应链攻击，两个 Claude Code 恶意版本被投毒","数据泄露","后门","AI 供应链","AI 编码","Microsoft","Google","AWS","https://www.bleepingcomputer.com/news/security/cursor-confirms-security-breach-led-to-malicious-claude-code-extension/","BleepingComputer",{"_109":110,"_111":-5},"changelogVersion","2026-10-01T08:00","release"]
