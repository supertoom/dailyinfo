[{"_1":2,"_3":4},"root",{"_5":100},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1793666564000,"id","vuvau9rjn8ik414g6xpi91tx9","title","攻击者利用 Microsoft Teams 冒充 IT 支持，部署 GoGRPC 后门与 Chaos 勒索软件","originalTitle","Attackers Use Microsoft Teams IT Support Scams to Deploy Malware and Ransomware","summary","攻击者利用 Microsoft Teams 外部聊天冒充 IT 支持，结合邮件轰炸诱导受害者授予远程访问权限，并部署 GoGRPC 后门、Chaos 勒索软件。攻击主要针对启用外部访问的组织，已导致横向移动至域控制器、数据外传及勒索软件投放；Arctic Wolf 建议结合端点与身份遥测进行监测。","reason","文章梳理了利用 Microsoft Teams 冒充 IT 支持的攻击链、远程控制工具及数据外传与勒索部署过程。","source",{"_75":99},"links",{"_90":98},"publishedAt","2026-10-26T15:52:40.000Z","discoveredAt","2026-10-28T09:02:45.298Z","timelineAt","category","activity","tags",[78,76,94,95,96,97],"score",78,"selected",true,"channel","news","story",{"_86":87,"_13":88},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_61":89,"_90":-5,"_91":92,"_93":37},"outline",[],"relatedStories",[85],"topics",[68,69,70,71,72],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fkw1PJGg62R4","reportCount",5,"additionalSourceCount",4,{"_73":83,"_75":84},{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","malware","name","恶意软件","attack","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","microsoft","Microsoft / 微软",{"_86":87,"_13":88},"publicId","3e9e56b4-345f-488e-b051-42058202b248","Arctic Wolf披露Teams外部聊天攻击链","<p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhGj3R5UeJnb_pAG2XH5cEGUzKbzeRHLNAES48EgHC8ssOnuDbDOqJA9ydPHJqmxYONu2lCeu42YOv_e_XA2RtX5jVGsMkQY0QAGrzoqmY4qU6NnWrPTfX0V-U68B9Z80KHLJvZDtUeSm4dvkp06oJ9JmgJvr7CDYZ-48fwAOENt31Lrcpr4M6O_4x6ovLZ/s1600/support.jpg\"><img alt=\"\" src=\"/dailyinfo/media/52e0c995e5f36a42.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>网络安全研究人员正提醒关注他们所称的数百起案件中反复出现的一种“社会工程模式”：威胁行为者利用 Microsoft Teams 的外部聊天创建功能实施冒充诈骗或投递恶意软件。</p><p>Arctic Wolf Labs 在向 The Hacker News 分享的一份报告中<a href=\"https://arcticwolf.com/resources/blog/threat-actors-abuse-microsoft-teams-external-chat-for-initial-access/\">表示</a>：“这些事件中出现了一种一致的攻击者行为模式：使用相同的临时租户、相同的‘IT Support (Internal)’显示名称、相同的远程访问工具，并且越来越多地使用相同的载荷域名。”</p><p>这些攻击始终采用以 IT 为主题的显示名称或听起来友好的名字，以规避 Teams 对外部用户的警告。这些消息来自通过新建或收购的 Microsoft 365 租户建立的 Teams 身份。</p><p>这家网络安全公司调查的案件中，近 30–40% 涉及使用 <a href=\"https://learn.microsoft.com/en-us/microsoft-365/admin/setup/add-or-replace-your-onmicrosoftcom-domain\">*.onmicrosoft[.]com</a>，这是 Microsoft 在创建 Microsoft 365 租户时自动生成的永久备用域名。这些域名冒充 IT 基础设施，并选择以帮助台或支持为主题的词作为租户名称，以提升可信度 -&nbsp;</p><ul>\n  <li>helpdeskteam365.onmicrosoft[.]com</li>\n  <li>itendpoint365.onmicrosoft[.]com</li>\n  <li>itcoreportal.onmicrosoft[.]com</li>\n  <li>itadmin922.onmicrosoft[.]com</li>\n  <li>corporateitservicellc.onmicrosoft[.]com</li>\n</ul><p>正如<a href=\"https://thehackernews.com/2026/04/unc6692-impersonates-it-helpdesk-via.html\">此前许多案件中所观察到的那样</a>，这些 Teams 会话之前通常会出现邮件轰炸，即受害者的收件箱在短时间内被数百封新闻简报或订阅确认邮件淹没。这种方式旨在制造虚假的紧迫感，让冒充 Teams IT 支持的消息在不久后到达，声称可以帮助解决相关问题。</p><p>Arctic Wolf 在不同案件中观察到的一些显示名称如下 -</p><ul>\n  <li>Help Desk</li>\n  <li>IT Support</li>\n  <li>HelpDesk Manager</li>\n  <li>IT Service Desk – Liam / IT Service Desk (Liam)</li>\n  <li>IT Service Desk – Matt / IT Service Desk – Scott</li>\n  <li>IT Support – Christopher Thomas</li>\n  <li>HelpDesk Supervisor</li>\n  <li>Enterprise IT &amp; Security (Internal)</li>\n  <li>IT Tech Support Internal</li>\n  <li>Business IT Solutions &amp; Support (Internal)</li>\n  <li>Maintenance Service</li>\n  <li>IT-Representative</li>\n  <li>IT/Help Desk</li>\n</ul><p>在最近的攻击迭代中，研究人员观察到攻击者开始在显示名称中加入目标组织的域名或公司名称，使消息看起来更加可信。</p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjt_HrYllOKC2fB07bxzNH24I2pQKpiWkDu-KvU3K7AeoyT64qypPkdH1STwVcw8jqgbFgpmREvbQM3fgqFz_gaG2u43G88MUur4jq3Yezn_qqwRWeZbhRRK3kto_ZpYm7om4ibo_NH6FJrg244Z2gQQgItjYSo55VwX6yDM7V3DkzWMMSgLjMz0liyddRY/s1600/chain.png\"><img alt=\"\" src=\"/dailyinfo/media/e28464bbe10ec72d.webp\" loading=\"lazy\" decoding=\"async\"></a></p><p>Arctic Wolf 表示：“我们还观察到，最近创建租户时开始转向使用付费顶级域名（TLD）。在过去几个月我们发现的此类诈骗中，所识别的付费域名里，约 50% 的虚假身份使用 .top TLD，约 40% 使用标准的 .com 域名，略高于 5% 使用 .com.pl、.com.vn 和 .com.br 等多级域名。”</p><p>这些活动与 <a href=\"https://thehackernews.com/2026/08/twinloot-abuses-sharepoint-and-teams-to.html\">STAC4749</a> 的活动相符。该组织过去曾创建以 IT 为主题的“.top”顶级域名云域名，并利用看似合理的员工用户名使账号显得真实可信。据 <a href=\"https://thehackernews.com/2026/08/weekly-recap-rogue-ai-models-88m.html#:~:text=Microsoft%20Teams%20Vishing%20Leads%20to%20Chaos%20Ransomware\">Sophos</a> 表示，这些攻击已导致 Chaos 勒索软件被部署。</p><p>这些攻击专门针对启用了外部访问的组织。其手法还包含语音钓鱼（vishing）元素，诱骗受害者通过合法的远程监控与管理（RMM）工具授予其实际操作键盘的访问权限，例如 Quick Assist、AnyDesk、ScreenConnect (ConnectWise)、TeamViewer、Atera、Zoho Assist、NetSupport 和 LogMeIn。</p><p>远程访问被滥用于开展侦察、投递包括 GoGRPC 后门在内的额外有效载荷、协助横向移动至域控制器，以及部署额外的 RMM 工具（如 Level）以增强冗余，随后外泄敏感数据并投放勒索软件二进制文件。</p><p>Arctic Wolf 表示：“在部分案例中，攻击者利用了 Microsoft 的便笺。攻击者通常会避免直接在 Teams 中粘贴 URL，因为这会触发 Safe Links / ZAP 扫描，而是在远程会话期间自行导航至载荷所在位置。因此，除了扫描消息之外，端点和身份遥测也是关键的监控面。”</p><p>在这家网络安全厂商发现的一个案例中，据称威胁行为者指示用户运行一条 PowerShell 命令，下载文件并随后启动它。这条 PowerShell 命令旨在从 Microsoft Azure Blob Storage 下载一个 MSI 安装程序。</p><p>当受害者运行该安装程序时，它会启动一个 PowerShell 脚本，负责提取并执行其中嵌入的 Python 植入程序。该后门随后运行另一项 MSI 事务，向 Active Directory 发出 LDAP 查询，获取所有计算机和用户对象，然后将信息传输至外部服务器。</p><p>Arctic Wolf 表示：“外部 Microsoft Teams 聊天已成为一种有效的初始访问途径，因为它利用的是信任，而非软件漏洞。”</p><p>Arctic Wolf 表示：“在所检查的全部活动中，攻击者结合了电子邮件轰炸、具有说服力的 IT 支持人员冒充、新创建的租户和域名，以及快速实施的社会工程，将受害者从看似日常的聊天逐步引向远程访问、载荷执行，并在某些情况下进一步扩大入侵范围。”</p><p>觉得这篇文章有意思？欢迎关注我们的 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a>，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","勒索","后门","数据窃取","Microsoft","https://thehackernews.com/2026/10/attackers-use-microsoft-teams-it.html","The Hacker News",{"_101":102,"_103":-5},"changelogVersion","2026-10-01T08:00","release"]
