[{"_1":2,"_3":4},"root",{"_5":96},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":-5,"_57":36,"_58":59},"expiresAt",1795653642000,"id","mfr4flv89w9erp7y1vhyrsd0j","title","Microsoft 入选 2026 Gartner® Magic Quadrant™ 邮件安全领导者","originalTitle","Microsoft named a Leader in the 2026 Gartner® Magic Quadrant™ for Email Security","summary","Microsoft 再次入选 2026 Gartner® Magic Quadrant™ 邮件安全领导者。Microsoft Defender 日均筛查 5.2 亿封邮件，并在四周内拦截近 10,000 次 prompt injection 尝试；其 ISOC 整合 SIEM 与 XDR，支持跨邮件、端点、身份和云开展调查响应。","reason","source",{"_65":95},"links",{"_59":94},"publishedAt","2026-11-25T17:15:00.000Z","discoveredAt","2026-11-25T18:23:22.532Z","timelineAt","category","blue-team","tags",[89,68,90,91,92,93],"score",26,"selected",false,"channel","news","story","x","readingMode","full","author","Rob Lefferts","body",{"_85":-5,"_59":86,"_87":-5,"_88":36},"outline",[73,74,75],"relatedStories",[],"topics",[60,61,62,63],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_64":71,"_65":72},{"_64":69,"_65":70},{"_64":67,"_65":68},{"_64":30,"_65":66},"slug","name","蓝队与运营","ai-security","AI 安全","email","邮件与钓鱼","microsoft","Microsoft / 微软",{"_11":83,"_77":84,"_79":80},{"_11":81,"_77":82,"_79":80},{"_11":76,"_77":78,"_79":80},"sec-3","text","Learn more","level",2,"sec-2","Proof over promises: Making protection measurable","sec-1","AI is changing both sides of the inbox","zh","<p><strong>We’re honored to share that Microsoft has once again been named a Leader in the 2026 Gartner® Magic Quadrant™ for Email Security.</strong> \n</p><p>AI is changing the threat landscape and this is shifting how organizations think about their existing security strategy. In response, we’ve invested in two areas over the past year: using AI to protect people and the agents that now read their email and making protection measurable so customers can verify that it works.</p><h2 id=\"sec-1\">AI is changing both sides of the inbox </h2><p>The first area of investment starts with a simple reality: AI now reads email alongside people, attackers are using AI to target both, and defense must use AI to stay ahead. Picture an ordinary vendor email: a meeting recap, a few action items, and a friendly sign-off. Hidden in white text on a white background is prompt injection: an instruction telling an AI assistant to gather financial documents and send them to an outside address. The employee isn’t the target; their AI agent is. People can be persuaded by messages that exploit fear, trust, or urgency, but agents don’t need persuading. Once an agent acts on an instruction, pulling the message back won’t undo it. This is why <a href=\"https://www.microsoft.com/en-us/security/business/microsoft-defender\">Microsoft Defender</a> stops malicious messages before delivery and keeps reevaluating delivered mail as new intelligence comes in.   </p><p>This summer, we introduced <a href=\"https://techcommunity.microsoft.com/blog/microsoftdefenderforoffice365blog/defending-the-inbox-against-prompt-injection-attacks/4534636\">prompt injection protection for email</a> in Defender to detect and quarantine messages carrying hidden malicious AI instructions before they reach <a href=\"https://www.microsoft.com/en-us/copilot\">Microsoft Copilot</a> or other agents. In Defender, analysts can also see what an agent would see: the ‘Show concealed text’ button on the ‘Email Entity’ page reveals hidden content in the email preview, so they can inspect the instructions an agent could encounter. These attacks don’t show up often, yet. Over a four-week timeframe, we caught almost 10,000 prompt injection attempts, around 330 a day, out of the billions of emails Defender scans every day. The hard part is spotting those few without tripping over legitimate mail, so we don’t lean on a single model. Heuristics clear out the bulk first. What’s left goes to a fine-tuned small language model, and only the messages that still look suspicious reach a large language model for the final call. Saving the heaviest analysis for the smallest set of messages is what keeps false positives low and business email moving. </p><p><strong>AI is also reshaping the attacks aimed at people.</strong> The phishing emails that worry us most are the ones that look completely normal. No malicious link, no infected attachment, just a plausible request written with perfect grammar and the right context. Generative AI makes those messages cheap to produce and endlessly variable. To meet that shift, we rebuilt how Microsoft Defender makes decisions rather than simply adding another filter. That decision-making now operates at scale, screening 5.2 billion emails a day on average<sup>1</sup>. The redesigned detection stack combines multiple machine learning models and LLM-based classifiers, with an ensemble model weighing their outputs to determine the final verdict. It also uses natural language processing signals, including message topic, to judge what a message is asking for and not only what it contains. That helps Defender catch attacks more accurately.  \n</p><p><strong>While detection helps with the message in front of you, defenders also need to see how it connects to the rest of an attack.</strong> <a href=\"https://www.microsoft.com/en-us/security/business/microsoft-perception-agentic-system\">Microsoft Perception</a> extends that help beyond the message, connecting an email investigation to the broader exposure and response picture. Blue team agents investigate threats and improve detections, red team agents identify paths to compromise, and green team agents prioritize actions to close security gaps, while people retain control of critical decisions. The <a href=\"https://www.microsoft.com/en-us/security/blog/2026/09/23/reimagining-the-soc-for-the-agentic-era-in-microsoft-defender/\">Integrated Security Operations Center (ISOC)</a> in Microsoft Defender, launched in September, provides a shared foundation for people and AI agents to investigate and respond to the full attack—not just an isolated email. By bringing security information and event management (SIEM) and extended detection and response (XDR) together, it connects email signals with endpoint, identity, cloud, and third-party data, giving AI-assisted security operations broader context.</p><h2 id=\"sec-2\">Proof over promises: Making protection measurable </h2><p>\n  But using AI to defend only matters if customers can verify that it works. The second  investment area is one the whole industry has struggled with: how do you know your email security is actually working? Detection claims are easy to make and hard to verify, so we publish the data.  \n</p><p>\n  Since July 2025, we’ve released quarterly email security benchmarking reports built on real-world threats, not synthetic tests. They compare environments protected by Microsoft Defender alone with those that add a secure email gateway in front of it or an integrated cloud email security (ICES) layer behind it. We believe transparency strengthens the whole market, and an industry that measures itself in the open improves faster. \n</p><p>\n  While benchmarking shows how protection performs across organizations, the Protection &amp; Posture Insights report shows how it performs in yours. This on-demand, tenant-specific report helps security leaders understand which threats target their organization, how well Microsoft Defender stops them, and where configuration can be strengthened. <a href=\"https://techcommunity.microsoft.com/blog/microsoftdefenderforoffice365blog/enhancements-to-the-protection-and-posture-insights-report/4568163?previewMessage=true\">Recent updates</a> show URL clicks checked and malicious-site attempts blocked across email, Microsoft Teams, Office apps, and Microsoft Copilot, and also highlight allow lists and overrides that may be letting threats through. Together, benchmarking and tenant-specific insights give leaders evidence to evaluate protection and identify opportunities to strengthen it. \n</p><p><strong>We’re grateful to our customers, partners, and the analyst community for their trust, and to the teams turning insight into protection.</strong> Our engineers start with customer problems, while our researchers draw on more than 165 trillion signals a day across Microsoft to anticipate emerging threats and build protections before real-world examples appear<sup>2</sup>. This recognition from Gartner is a milestone for us, not the finish line. Our focus remains on protecting people and agents and giving customers evidence they can use to evaluate their defenses.</p><h2 id=\"sec-3\">Learn more </h2><ul>\n<li>Explore the latest <a href=\"https://aka.ms/EmailBenchmark092026\">Microsoft Defender email security benchmarking results</a>. </li>\n\n\n\n<li>Are you a regular user of Microsoft Defender for email security? <a href=\"https://nam06.safelinks.protection.outlook.com/?url=https%3A%2F%2Fwww.gartner.com%2Freviews%2Fproduct%2Fmicrosoft-defender-for-office-365%3Fq%3Ddefender%2520for%2520office&amp;data=05%7C02%7Cvalerialopez%40microsoft.com%7C5a94ffc74c894f4bf55308df3071d24e%7C72f988bf86f141af91ab2d7cd011db47%7C1%7C0%7C639282938423876776%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=F1I5BQN4s595%2BnJ4sIqP95CFEhdCYJmqxQ7v0p071Tc%3D&amp;reserved=0\">Share your insights on Gartner Peer Insights™</a>. </li>\n</ul><hr><p><em>Gartner, </em><em>Magic Quadrant for Email Security, </em><em>By </em><a href=\"https://www.gartner.com/analyst/b9c800bf7fa4\"><strong><em>Max Taggett</em></strong></a><em>, </em><a href=\"https://www.gartner.com/analyst/b9c906bd7ca3\"><strong><em>Franz Hinner</em></strong></a><em>, </em><a href=\"https://www.gartner.com/analyst/b9c803b87eae\"><strong><em>Deepak Mishra</em></strong></a><em>, </em><em>23 November 2026</em><em></em> </p><p><em>Gartner, Magic Quadrant, Peer Insights are trademarks of Gartner, Inc., and/or its affiliates.</em><em></em> </p><p><em>Gartner does not endorse any company, vendor, product or service depicted in its publications, and does not advise technology users to select only those vendors with the highest ratings or other designation. Gartner publications consist of the opinions of Gartner’s business and technology insights organization and should not be construed as statements of fact. Gartner disclaims all warranties, expressed or implied, with respect to this publication, including any warranties of merchantability or fitness for a particular purpose.</em><em></em> </p><p><sup>1,2</sup> <a href=\"https://nam06.safelinks.protection.outlook.com/?url=https%3A%2F%2Fwww.microsoft.com%2Fen-us%2Fcorporate-responsibility%2Ftopics%2Fcybersecurity%2Freports%2Fmicrosoft-digital-defense-report%2F&amp;data=05%7C02%7Cv-hananirfan%40microsoft.com%7C83fa32f3ad1642c7728508df47729804%7C72f988bf86f141af91ab2d7cd011db47%7C1%7C0%7C639308229663601944%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=Ejauuy2ge9YWfRmPukDyo%2F4oxGuRo98z0wY%2FDp6BZEc%3D&amp;reserved=0\">Microsoft Digital Defense Report 2026</a>.</p><p>The post <a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/25/microsoft-named-a-leader-in-the-2026-gartner-magic-quadrant-for-email-security/\">Microsoft named a Leader in the 2026 Gartner® Magic Quadrant™ for Email Security</a> appeared first on <a href=\"https://www.microsoft.com/en-us/security/blog\">Microsoft Security Blog</a>.</p>","zhKind","complete","蓝队","Agent 安全","邮件安全","检测工程","Microsoft","https://www.microsoft.com/en-us/security/blog/2026/11/25/microsoft-named-a-leader-in-the-2026-gartner-magic-quadrant-for-email-security/","Microsoft Security Blog",{"_97":98,"_99":-5},"changelogVersion","2026-10-01T08:00","release"]
