[{"_1":2,"_3":4},"root",{"_5":107},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795740041000,"id","m669pm2u2g8frr1vfza5x3h0e","title","Remus 窃取器借虚假 Google Sheets Chrome 扩展窃取 Gmail 邮件","originalTitle","Remus malware steals Gmail messages via fake Google Sheets extension","summary","GenDigital 与 Invoke RE 逆向发现，Remus 窃取器所谓 Gmail 零日漏洞实际由恶意 Chrome 扩展实现，并无技术证据证明零日漏洞被利用。","reason","source",{"_76":106},"links",{"_61":105},"publishedAt","2026-11-26T15:23:28.000Z","discoveredAt","2026-11-26T16:19:19.237Z","timelineAt","category","activity","tags",[79,102,103,85,104],"score",65,"selected",false,"channel","news","story",{"_89":90,"_13":91},"x","readingMode","full","author","Bill Toulas","body",{"_98":-5,"_61":99,"_100":-5,"_101":36},"outline",[92],"relatedStories",[88],"topics",[68,69,70,71,72,73],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","f9tvk_VOK2AM","reportCount",1,"additionalSourceCount",0,{"_74":86,"_76":87},{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","research","name","技术研究","malware","恶意软件","black-market","数据窃取与黑产","ransomware","勒索软件","browser","浏览器","google","Google / 谷歌",{"_89":90,"_13":91},"publicId","cd3d67dc-4bca-4ce2-a88e-ed5b316310ee","GenDigital：Remus窃取器无Gmail零日，实为恶意扩展",{"_11":93,"_94":95,"_96":97},"sec-1","text","Uncover email threats your existing defenses may miss.","level",2,"zh","<p><img alt=\"Remus malware steals Gmail messages via fake Google Sheets extension\" height=\"900\" src=\"/dailyinfo/media/5825a31be59d25bb.jpg\" srcset=\"/dailyinfo/media/3692402720e38b57.jpg 720w, /dailyinfo/media/06fcadcd1b7718ba.jpg 1200w, /dailyinfo/media/5825a31be59d25bb.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>The Remus infostealer is stealing Gmail messages through a stealthy malicious Chrome extension, a capability the malware operators marketed as a zero-day exploit in Google's email service.</p><p>On November 8, the Remus infostealer developer started advertising the alleged Gmail zero-day flaw that allowed the malware to collect emails even if victims changed their passwords and revoked all sessions.</p><p>Threat intelligence company <a href=\"http://www.infostealers.com/article/remus-stealer-markets-persistent-gmail-access-hudson-rock-investigates/\">Hudson Rock investigated the claims</a> but came to inconclusive results. The researchers noted that evidence from the malware customers matched the seller's pitch, although there was no technical proof that a zero-day vulnerability was being exploited.</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/92bcac73460d74f9.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><figure><img alt=\"Remus stealer panel\" height=\"600\" src=\"/dailyinfo/media/0fc9ce2176895fb1.jpg\" srcset=\"/dailyinfo/media/7847d0b8a0127ed7.jpg 720w, /dailyinfo/media/02977fb00df0414c.jpg 1200w, /dailyinfo/media/0fc9ce2176895fb1.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"895\">\n<figcaption><strong>Remus stealer panel</strong><br>\n<em>Source: GenDigital</em></figcaption>\n</figure><p>GenDigital and Invoke RE researchers published their independent findings yesterday, explaining that the advertised “zero-day” was just a malicious Chrome extension installed on the victims' browsers.</p><p><a href=\"https://x.com/InvokeReversing/status/2125264524995645745\"><img src=\"/dailyinfo/media/43cdb82403007623.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Tweet\" height=\"212\" width=\"500\"></a></p><p>The extension is designed to steal unread emails from signed-in Gmail accounts. It can also survive password changes and session revocations because it remains installed in the victim's Chrome browser.</p><p>Its access to Gmail stops when the active session ends, and resumes again when the victim signs back in.</p><p>GenDigital discovered the extension after reverse-engineering the Remus infostealer. The researchers found no&nbsp;trace of an email-stealing module, suggesting that the functionality is implemented via an add-on.</p><p>“In a nutshell, the loaded module is a native DLL whose sole purpose is to install a malicious extension into Google Chrome, which, notably, is the only browser it targets,” <a href=\"https://www.gendigital.com/blog/insights/research/remus-stealer-email-interception-analysis\">GenDigital explains</a>.</p><p>“The extension itself is bundled directly inside the DLL, stored as an unencrypted ZIP archive in its .rdata section.”</p><p>GenDigital explains that Chrome versions 137 and later removed a command-line option that allowed malware to load extensions.</p><p>Remus takes a complex route to overcome this restriction, editing the victim’s Chrome profile to register the malicious extension and then enabling ‘Developer Mode’ in the browser, which is required to run unpacked extensions.</p><p>The extension uses the name “Google Sheets,” copies the description of Google Docs Offline, and requests access to all websites.</p><figure><img src=\"/dailyinfo/media/bb00c045530f52db.jpg\" srcset=\"/dailyinfo/media/5ecb15a69034a8b5.jpg 720w, /dailyinfo/media/88c54396bac7c1c6.jpg 1200w, /dailyinfo/media/bb00c045530f52db.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Installed malicious extension\" height=\"514\" width=\"900\">\n<figcaption><strong>Installed malicious extension</strong><br>\n<em>Source: GenDigital</em></figcaption>\n</figure><p>Once active in the browser, it checks for unread emails every minute across up to 10 account slots and retrieves them in full, in raw format.</p><p>The extension sends the email subject, message body, sender, and victim’s email address to its command-and-control server, along with a campaign identifier.</p><figure><img src=\"/dailyinfo/media/eedca12df6975183.jpg\" srcset=\"/dailyinfo/media/a9408f60fa138384.jpg 720w, /dailyinfo/media/aa61bab357717459.jpg 1200w, /dailyinfo/media/eedca12df6975183.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Email theft\" height=\"306\" width=\"900\">\n<figcaption><strong>Email theft</strong><br>\n<em>Source: GenDigital</em></figcaption>\n</figure><p>Failed uploads are queued and retried, while a local record helps the extension keep track of what has succeeded so it doesn’t send duplicates.</p><p>Although the extension also parses attachment filenames, it does not send those to its operators, so this feature may not be fully implemented yet.</p><p>To defend against this threat, users are advised to download software only from trusted sources and scrutinize “chrome://extensions” for rogue installations or unexpected activation of Developer Mode.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/3d0888eec2a1da78.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Uncover email threats your existing defenses may miss.</a>\n        </h2><p>Adaptive Security's AI agents analyze email intent, context, and behavior to uncover phishing, business email compromise, and invoice fraud.</p><p>See what's getting through with a 14-day read-only scan of Microsoft 365 or Google Workspace, with no MX changes.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Start your free email security scan.</a>\n    </p>","zhKind","complete","数据窃取","逆向","Google","https://www.bleepingcomputer.com/news/security/remus-malware-steals-gmail-messages-via-fake-google-sheets-extension/","BleepingComputer",{"_108":109,"_110":-5},"changelogVersion","2026-10-01T08:00","release"]
