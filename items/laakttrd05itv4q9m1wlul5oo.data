[{"_1":2,"_3":4},"root",{"_5":126},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":60,"_61":62},"expiresAt",1794185103000,"id","laakttrd05itv4q9m1wlul5oo","title","TianoCore 披露 EDK II PXE 驱动漏洞 CVE-2026-97631，CVSS 9.5","originalTitle","潜伏16年的UEFI漏洞：开机那几秒，你的所有防线都还没上线","summary","TianoCore 披露 EDK II PXE 网络启动驱动漏洞 CVE-2026-97631，CVSS 4.0 评分 9.5，IPv4 与 IPv6 handler 均因 504 字节字段的拷贝边界错误而可遭越界写入。","reason","文章从缓冲区边界错误、利用前提和固件影响范围拆解漏洞，并给出关闭或隔离 PXE、纳入固件漏洞管理的处置思路。","source",{"_74":46},"links",{"_113":125},"publishedAt","2026-11-05T03:28:56.000Z","discoveredAt","2026-11-05T03:52:24.783Z","timelineAt","category","vuln","tags",[116,117,118,119,120,121,122,123,124],"score",75,"selected",true,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","安全客","body",{"_62":112,"_113":-5,"_114":113,"_115":37},"outline",[83,84,85,86,87,88,89,90,91],"relatedStories",[79],"topics",[69,70,71],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation",false,"bodyLanguage","zh","factId","fId-XcEXSE0s","reportCount",3,"additionalSourceCount",2,{"_72":77,"_74":78},{"_72":31,"_74":76},{"_72":73,"_74":75},"slug","research","name","技术研究","漏洞披露","kernel","内核与系统",{"_80":81,"_13":82},"publicId","f8cb8789-848a-4286-a15b-6c5ed8568833","EDK II PXE越界写入漏洞已有修复代码",{"_11":110,"_93":111,"_95":68},{"_11":108,"_93":109,"_95":68},{"_11":106,"_93":107,"_95":68},{"_11":104,"_93":105,"_95":68},{"_11":102,"_93":103,"_95":68},{"_11":100,"_93":101,"_95":68},{"_11":98,"_93":99,"_95":68},{"_11":96,"_93":97,"_95":66},{"_11":92,"_93":94,"_95":66},"sec-9","text","相关文章","level","sec-8","TA的文章","sec-7","七、给甲方安全团队留三件事","sec-6","六、”forever bug”这个词","sec-5","五、谁真的受影响，谁可以先放一放","sec-4","四、影响面：几乎所有服务器都沾边","sec-3","三、漏洞是怎么漏出来的：又一次提前泄密","sec-2","二、为什么这个洞比一般的RCE更麻烦","sec-1","一、504字节的缓冲区，和一个算错的指针","<p><span>首页</span></p><ul></ul><p><span>活动</span></p><ul></ul><p><span>社区</span></p><ul></ul><p><span>学院</span></p><ul></ul><p><span>安全导航</span></p><ul></ul><p><span>阅读量</span><b>2617</b></p><p>发布时间 : 2026-11-05 11:28:56</p><p>CVE-2026-97631，CVSS 9.5，在<span>Secure Boot<i></i></span>加载之前就能执行代码，攻击窗口只有开机那几秒。</p><p>做等保测评的朋友应该都遇到过这个场景：客户问”我们上了Secure Boot，还上了<span>TPM<i></i></span>，硬盘也加密了，服务器被偷了数据也读不出来吧”。</p><p>上周之前，这个回答是可以给的。</p><p>10月22日，TianoCore发了安全公告GHSA-99cj-7hg9-mp4m。CVE-2026-97631，CVSS 4.0评分9.5。漏洞在EDK II的PXE网络启动驱动里，位置是NetworkPkg/UefiPxeBcDxe。攻击者可以在操作系统加载之前、在Secure Boot和<span>度量启动<i></i></span>做完校验之前，让代码在ring 0跑起来。</p><p>这段代码的年龄，按提交记录往前追，大概16年。</p><h2 id=\"sec-1\">一、504字节的缓冲区，和一个算错的指针</h2><p>漏洞本身不复杂，复杂的是它藏在哪。</p><p>PXE网络启动的时候，UefiPxeBcDxe驱动会挂一个接收请求，专门等着收ICMP差错报文——就是路由器告诉你”这个包送不到”的那类消息。每收到一个报文，驱动就把它拷进自己私有上下文结构里的Mode.IcmpError字段，这个字段固定504字节。</p><p>问题出在拷贝循环的边界处理上。IPv4的PxeBcIcmpErrorDpcHandle和IPv6的PxeBcIcmp6ErrorDpcHandle两个handler都写错了。报文长度超过504字节的时候，循环还在往里拷；而且目标指针是按累计长度推进的，不是按每个分片的长度推进。结果是超长报文把攻击者控制的数据写到了字段之外的相邻内存里。</p><p>接收路径上，前面没有任何地方限制报文长度。</p><p>官方公告的原话是”the copy loop’s bounds handling is incorrect in both the IPv4 and IPv6 handlers”，两个handler都中招，等于IPv4和IPv6双通道都能触发。</p><p>利用方式听起来很简单：从任意网络位置发一个单播报文到目标设备的IP地址，只要发在PXE启动序列的那个窗口里。不需要密码，不需要已有的访问权限，只要求一件事——目标得正在用PXE网络启动。</p><h2 id=\"sec-2\">二、为什么这个洞比一般的RCE更麻烦</h2><p>一般的内存破坏漏洞，你在操作系统里打补丁，重启，完事。</p><p>这个洞的代码跑在操作系统之前。</p><p>攻击者能做到两件事。轻的一件是拒绝服务：让启动过程卡死在那个阶段。听起来不严重，但对无人值守的机房来说，一台机器卡在PXE阶段反复重启，运维半夜得跑一趟。</p><p>重的一件才是真正的问题。如果攻击者知道目标固件的具体build，他可以在<span>UEFI<i></i></span>固件环境里”种一个伪造事件”，让恶意代码在CPU的ring 0执行。ring 0是最高的特权级，比操作系统内核还靠下。</p><p>在这个位置上，攻击者能碰到TPM。</p><p>Metasploit的作者、现在在Dragos做首席研究官的HD Moore说得挺直白：攻击者可以用这个bug在一个”启动过程仍然能访问TPM这类敏感组件”的时间点上劫持程序流，”在攻击者拥有短期网络访问权限的情况下，这可能被用来破解磁盘加密（在设备被盗场景里就更简单了）”。</p><p>这句话的分量在于：全盘加密的信任根在TPM，TPM的信任根在启动链，启动链的第一环就是固件。固件被拿下了，底下所有东西的保证都变成了假设。</p><p>更麻烦的是attestation。远程证明机制的作用是向服务器证明”这台硬件是干净的”，验的就是启动链的度量值。这条链在上游就被污染了，证明依然能通过。</p><p>固件安全厂商Eclypsium的首席研究员Jesse Michael补充了一个技术细节：利用这个漏洞需要猜目标系统里的具体地址，所以不是”一个exploit到处扔”，得针对每个目标型号、版本、配置单独调。</p><p>这个限制听起来降低了风险，但反过来看，它把攻击者筛成了有耐心的那一类。国家级行为体、勒索团伙、或者已经拿到内网低权限正在找提权路径的人，这三类都不缺耐心。</p><h2 id=\"sec-3\">三、漏洞是怎么漏出来的：又一次提前泄密</h2><p>这部分单说，因为它解释了为什么现在这么被动。</p><p>发现漏洞的是两个人：Anthropic的Alex Matrosov和Google的Dan Holmes。他们本来安排的是2027年1月做协调披露。</p><p>上个月，主板厂商AMI往edk2仓库提了一个pull request（<a>#13200</a>），里面详细描述了漏洞，还附了修复代码。这个PR是公开的。</p><p>发现者看到之后，TianoCore项目成员上周就发了公告。</p><p>于是披露时间从明年1月，提前到了10月22日。修复代码已经在GitHub上公开，任何有能力的攻击者都能读到触发条件，反推出可用的利用。</p><p>这和六天前PHP2Shell的情况几乎是同一个剧本。那次的细节是10月20日在Hacker News泄露，PHP官方被迫把发布计划提前一天。</p><p>Ars Technica在报道里用了一个词——”another botched disclosure”，又一次搞砸的披露。两次事件相隔六天，两次都是补丁代码先走漏，两次都是防守方被迫在还没准备好的时候应对。</p><p>这里有个结构性问题：开源项目的修复走PR流程，PR是公开的。厂商内部的安全团队和开源社区之间的披露协调，中间缺少一个”补丁先合、公告后发”的机制。这次AMI提PR可能只是为了推进修复，但它客观上把整个生态的披露时间表打乱了。</p><h2 id=\"sec-4\">四、影响面：几乎所有服务器都沾边</h2><p>EDK II是什么地位？UEFI论坛去年在一份材料里直接称它为”UEFI规范的卓越解决方案/实现”。</p><p>几乎所有的UEFI供应商——业内有时叫IBV，独立BIOS厂商——包括AMI、Insyde、Phoenix，都大量使用这份参考代码。微软的Project Mu，那个号称加固过的EDK2分支，也用了包含这个漏洞组件的代码。</p><p>受影响版本是edk2-stable202608及更早，且没有打上patch&nbsp;<a>#13302的</a>。</p><p>Red Hat的安全公告显示RHEL 8、9、10里的edk2包都被列为受影响。TianoCore在10月15日已经把修复合并到上游主分支，但到目前还没进稳定版本。</p><p>这里要区分两件事。</p><p>Intel的回应是：目前”在安全支持期内的商业产品”没有已知受影响的。理由是Intel的参考代码里不包含这块受影响的EDK2功能。但它也补了一句，”OEM板卡厂商或系统集成商可能会集成”。而且公开的Intel参考代码（FSP）里是有EDK2引用的。TianoCore自己也说过，Intel提供的每个UEFI开发套件”都是针对特定EDK II源码修订的完整验证实现”。</p><p>Arm的回应更简短：”CVE-2026-97631不直接适用于Arm的产品组合。”但Arm公开的SystemReady固件同样大量借用EDK2，TianoCore的文档里也记录了Arm对EDK2的依赖。</p><p>AMD、Phoenix、AMI、微软、亚马逊——报道发出时都没回复。</p><p>这个局面落到运维头上就一句话：得自己去问服务器厂商。</p><h2 id=\"sec-5\">五、谁真的受影响，谁可以先放一放</h2><p>这一点必须说清楚，不然又是一轮无差别恐慌。</p><p>只从本地硬盘或SSD启动的设备，不受影响。家庭和小办公室用户，也不受影响。</p><p>真正受影响的是从本地网络启动的服务器和存储设备，理论上还包括从互联网资源启动的设备（少见，但存在）；前提是固件基于EDK2、并且开了PXE功能——PXE默认是开的。</p><p>所以排查顺序大概是这样的。</p><p>先盘清楚有多少台机器在用PXE。虚拟化集群、裸金属自动化装机、无盘工作站、HPC节点、部分存储阵列，这些是高概率场景。绝大多数跑业务的应用服务器其实是从本地盘启动的，这部分可以先排除。</p><p>然后确认固件来源。服务器厂商是谁，机型是什么，固件版本是多少，拿着CVE编号去问厂商有没有对应的BIOS/UEFI更新。这一步没法跳，因为EDK2是参考实现，各家的实际集成情况不一样。</p><p>再往下，暂时关掉不需要的PXE。意大利ACN的CSIRT在10月28日发的预警里给的建议就是这个：厂商固件更新到位之前，PXE不是必须的就关掉；必须用的，限制在可信且隔离的网络里。</p><p>这一条是最立竿见影的。PXE只在启动时监听，攻击窗口只有那几秒。关掉，或者关在一个只允许装机服务器访问的VLAN里，风险立刻就降下来。成本几乎为零。</p><p>最后一条，别指望Secure Boot和TPM。这两个机制在这个漏洞面前不起作用，恶意代码在它们加载之前就跑完了。不是说它们没用，是说它们防的不是这一层。该开的还是要开，但别拿它们当挡箭牌。</p><h2 id=\"sec-6\">六、”forever bug”这个词</h2><p>HD Moore在采访里说，考虑到这个漏洞的普遍性，它很可能会变成一个”forever” bug——永远活在那些已经停止支持的设备里。</p><p>这句话让我想起2024年初的PixieFail。那次也是EDK2的PXE启动问题，一串漏洞，整个固件生态被折腾了半年。之后业界做了好几轮fuzzing，OSS-Fuzz上有edk2的项目，NDSS上也有专门的论文。结果这个16年的老洞，还是没被那些fuzzing找出来。</p><p>固件安全这几年投入在增加，但产出和投入不成比例。原因不复杂：</p><p>固件代码的测试门槛高，得有真机、得能刷、变砖了得能救；固件厂商的SDLC成熟度普遍落后于应用软件厂商；出了问题修复周期是以季度计的，因为要过OEM、过认证、过客户验证。</p><p>所以每次固件漏洞披露，实际的时间线是这样的：TianoCore修上游（10月15日）→ 各IBV集成（几周到几个月）→ OEM出BIOS更新（几个月）→ 企业分批刷（几个月到一年）→ 停支持的设备永远不刷。</p><p>在这条时间线走完之前，控制暴露面是唯一有效的手段。</p><h2 id=\"sec-7\">七、给甲方安全团队留三件事</h2><p>PXE的管理要收进资产清单。这事儿平时没人管，因为它不属于”应用”也不属于”网络”，它属于”装机流程”，往往挂在运维的自动化平台下面。出事了才发现没人说得清哪些机器开了PXE。</p><p>固件版本纳入漏洞管理。很多企业的漏洞扫描覆盖了OS、中间件、应用，唯独没有BIOS/UEFI版本，厂商的固件公告也不进漏洞库。这次是个契机，把这一层补进CMDB。</p><p>别等。厂商固件更新到位之前，先把PXE的范围收缩掉。极少数”今天就能做完、成本几乎为零、效果立刻可见”的处置动作之一。</p><p>至于那个”硬盘被偷了数据也读不出来”的问题，现在得换个说法：如果攻击者能在你的网络里蹲到某台机器重启的那一刻，硬盘加密可能就不太够了。</p><p><strong>更多AI知识，请扫码关注Aiker World社区公众号</strong></p><p><img src=\"/dailyinfo/media/dd13c8400d5f6e82.jpg\" loading=\"lazy\" decoding=\"async\" width=\"302\"></p><p><strong>Aiker World社区网址：https://aikerworld.com</strong></p><p><strong>Aiker World（AI世界）-聚焦AI人才与智能体工具的垂直专家社区。专家领航+人才汇聚+工具赋能，打通AI技术与产业落地断层，为AI从业者、开发者及企业提供一站式成长与协作平台。</strong></p><ul></ul><p><i></i><span>0赞</span></p><p><i></i><span>收藏</span></p><p><img src=\"/dailyinfo/media/841a4367510d4e21.jpg\" loading=\"lazy\" decoding=\"async\"><span>安全客</span><span></span></p><p><a href=\"https://www.anquanke.com/member.html?memberId=184300\"><img src=\"/dailyinfo/media/841a4367510d4e21.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p><a href=\"https://www.anquanke.com/member.html?memberId=184300\">安全客</a></p><p>这个人太懒了，签名都懒得写一个</p><ul><li>文章</li><li><strong>94</strong></li></ul><ul><l