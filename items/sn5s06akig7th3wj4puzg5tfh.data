[{"_1":2,"_3":4},"root",{"_5":96},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795567289000,"id","sn5s06akig7th3wj4puzg5tfh","title","GhostMap eBPF Rootkit 深度分析：隐匿 npm IronWorm 与 AUR Atomic Arch 攻击活动","originalTitle","看不见≠不存在：拆解 GhostMap，一个藏身于两大供应链攻击背后的 eBPF Rootkit","summary","Aqua Nautilus 在 IronWorm 与 Atomic Arch 两起供应链攻击载荷中发现同一个 eBPF Rootkit 组件 GhostMap，并确认其由 13 个 eBPF 程序、10 个 map、13 个 link 构成。","reason","文章拆解了 GhostMap 篡改进程与套接字枚举结果的机制，并给出可复现的对照观测与排查方向。","source",{"_74":95},"links",{"_87":94},"publishedAt","2026-11-20T04:07:00.000Z","discoveredAt","2026-11-20T10:16:30.944Z","timelineAt","category","disclosure","tags",[75,90,77,91,92,93],"score",78,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","body",{"_61":86,"_87":-5,"_88":87,"_89":37},"outline",[],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fShtl6oBjPtE","reportCount",1,"additionalSourceCount",0,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","research","name","技术研究","malware","恶意软件","kernel","内核与系统","supply-chain","供应链安全",{"_83":84,"_13":85},"publicId","6a5e8649-55c0-43d3-a83a-044a4687d05e","GhostMap被曝跨两起供应链攻击复用","<p>原创 <span>威胁情报中心</span> <span>2026-11-20 12:07</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/6edc5af6c8eb2e96.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>Nautilus 的最新研究揭示了这样一个组件：它不靠删除数据来隐身，而是篡改“呈现给工具的数据”，让进程、文件、套接字从常规视图里“消失”。它同时出现在两起独立的供应链攻击事件中——npm 平台的 IronWorm 与 Arch AUR 的 Atomic Arch。</p><p><span><span>供应链安全 · eBPF Rootkit · 事件分析</span></span></p><p><span>看不见≠不存在：</span><span><br></span><span>拆解 GhostMap，一个藏身于两大</span><span>供应链攻击背后的 eBPF Rootkit</span></p><p><span>当你的 ps 列表干干净净、lsof 一无所获时，恶意进程可能仍在正常运行——它不靠删除数据来隐身，而是篡改“呈现给工具的数据”</span></p><p><span>· npm / IronWorm　· AUR / Atomic Arch　· eBPF　· 2026.11.20</span></p><p><span>当你的&nbsp;</span><span><span>ps</span></span><span>&nbsp;列表干干净净、</span><span><span>lsof</span></span><span>&nbsp;一无所获时，恶意进程可能仍在正常运行。Aqua Nautilus 的最新研究揭示了这样一个组件：它不靠删除数据来隐身，而是篡改“呈现给工具的数据”，让进程、文件、套接字从常规视图里“消失”。它同时出现在两起独立的供应链攻击事件中——npm 平台的 IronWorm 与 Arch AUR 的 Atomic Arch。</span></p><p><span><span>01</span></span><span><span>&nbsp;两条投递链，同一个内核组件</span></span></p><p><span>2026 年 6 月，开源软件供应链接连爆出两起大规模事件，攻击对象不同，技术路线却殊途同归：</span></p><ul><li><span><span><span>IronWorm（JFrog 命名）：</span></span><span>攻击者盗用 Arweave/WeaveDB 生态维护者&nbsp;</span><span><span>ocrybit</span></span><span>&nbsp;的凭据，通过被攻陷的 npm 账号&nbsp;</span><span><span>asteroiddao</span></span><span>&nbsp;重新发布了数十个包（典型样本&nbsp;</span><span><span>weavedb-sdk@0.45.3）</span></span><span>，利用&nbsp;</span><span><span>preinstall</span></span><span>&nbsp;钩子在依赖解析前直接执行一个 976KB 的 Rust 编写的 Linux ELF。JFrog 将其称为 Shai-Hulud 蠕虫“更锈的表亲”（rustier cousin）。</span></span></li><li><span><span><span>Atomic Arch（Sonatype 命名）：</span></span><span>攻击者批量“收养”AUR 中被遗弃（orphaned）的软件包，篡改其&nbsp;</span><span><span>PKGBUILD，</span></span><span>在安装阶段植入&nbsp;</span><span><span>npm install atomic-lockfile</span></span><span>&nbsp;一类的指令，借恶意 npm 包投递 Rust 编写的窃密载荷，波及上千个包。</span></span></li></ul><p><span>两个事件表面上是 npm 与 AUR 两个生态、两套运营动作。Aqua Nautilus 在 11 月 17 日发布的研究中发现：</span><strong><span>两者投递的载荷中嵌入了同一个 eBPF Rootkit 组件，</span></strong><span>研究人员将其命名为&nbsp;</span><strong><span>GhostMap</span></strong><span>。</span></p><p><span>组件共享的证据相当扎实：两份载荷中的 Rootkit 在记录执行数据后对比，共享&nbsp;</span><strong><span>13 个 eBPF 程序名、10 个 map 名，全部 13 个程序的 helper 使用位图完全一致；</span></strong><span>外围植入体还表现出几乎一致的安装与服务行为，包括一个逐字节相同的 1,142 字节伪造&nbsp;</span><span><span>sudo</span></span><span>&nbsp;封装脚本，以及同样监听在回环地址 8738 端口上的本地收集器。</span></p><p><strong><span>需要说明的是：</span></strong><span>这证实的是&nbsp;</span><strong><span>Rootkit 组件本身的复用，</span></strong><span>而不等同于两起事件由同一运营方操纵。换言之，这是一个跨投递渠道复用的“隐身工具箱”。</span></p><p><img src=\"/dailyinfo/media/87151e610fe88fbd.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>图1｜GhostMap 跨两条投递渠道的整体执行流程</span></strong></p><p><span>图源：Aqua Nautilus</span></p><p><span><span>02</span></span><span><span>&nbsp;GhostMap 如何落地：从安装钩到内核</span></span></p><p><span>GhostMap 不是独立传播的恶意软件，它是 IronWorm 这一更大植入体的一个功能组件：植入体负责安装、持久化与数据收集，Rootkit 负责隐匿与反调试。其落地链条如下：</span></p><p><span><span>1. 投递与初始执行。</span></span><span>&nbsp;在 npm 渠道，</span><span><span>weavedb-sdk@0.45.3</span></span><span>&nbsp;的&nbsp;</span><span><span>package.json</span></span><span>&nbsp;声明了&nbsp;</span><span><span>preinstall: ./tools/setup，</span></span><span>在安装依赖解析之前即触发二进制。该包的 npm 页面随后被标记为 deprecated，作者留言称“经由 Mini Shai-Hulud 蠕虫（TeamPCP）被攻陷，请升级到最新版本”——这是包作者在弃用警告中的归属表述，攻击者实际身份并无独立证据。</span></p><p><img src=\"/dailyinfo/media/e41514cc48f18d51.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>图2｜npm 弃用警告截图（记录弃用状态而非下架）</span></strong></p><p><span>图源：Aqua Nautilus</span></p><p><span>在 AUR 渠道，被修改的&nbsp;</span><span><span>PKGBUILD</span></span><span>&nbsp;通过安装钩子拉起&nbsp;</span><span><span>atomic-lockfile</span></span><span>&nbsp;内嵌的 Linux 载荷。</span></p><p><span><span>2. 建立持久化。</span></span><span>&nbsp;实验环境中以 root 权限运行样本后，安装程序列举所有用户的 crontab，将自身复制到&nbsp;</span><span><span>/var/lib/&lt;rand&gt;/&lt;rand&gt;（</span></span><span>观测到的实例包括&nbsp;</span><span><span>/var/lib/glugi/glugi、</span></span><span><span>/var/lib/havebi/havebi，</span></span><span>均为可变命名而非固定路径），创建并启用一个&nbsp;</span><span><span>Restart=always</span></span><span>&nbsp;的 systemd 服务（名称伪装成&nbsp;</span><span><span>dbus-daemon</span></span><span>&nbsp;一类），并向&nbsp;</span><span><span>~/.local/bin/sudo</span></span><span>&nbsp;投放伪造的 sudo 封装。</span></p><p><span><span>3. 由服务加载 Rootkit。</span></span><span>&nbsp;关键细节在这里：systemd 启动的服务进程与原始安装程序</span><strong><span>文件哈希相同，</span></strong><span>但真正加载 eBPF 组件的是这个继任进程——</span><strong><span>如果只监控安装程序的直接子进程，就会漏掉真正的加载者。</span></strong><span>活动检查点上，GhostMap 由&nbsp;</span><strong><span>13 个 eBPF 程序、10 个 map、13 个 link</span></strong><span>&nbsp;构成。其中几个核心 map 直接说明了其工作方式：</span></p><table><tbody><tr><td><p><span>map 名称</span></p></td><td><p><span>作用</span></p></td></tr><tr><td><span><span>hidden_names</span></span></td><td><p><span>保存要隐藏的进程名（如&nbsp;</span><span><span>dbus-daemon）</span></span></p></td></tr><tr><td><span><span>hidden_pids</span></span></td><td><p><span>保存已被选中隐藏的进程 PID</span></p></td></tr><tr><td><span><span>hidden_inodes</span></span></td><td><p><span>保存要隐藏的套接字 inode 号</span></p></td></tr><tr><td><span><span>scratch</span></span></td><td><p><span>临时记录目录读取缓冲区地址</span></p></td></tr></tbody></table><p><img src=\"/dailyinfo/media/8bb12e8459f8cda5.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>图3｜GhostMap 四个核心 map 的实际内容快照</span></strong></p><p><span>图源：Aqua Nautilus&nbsp;</span></p><p><span><span>03</span></span><span><span>&nbsp;进程隐匿：只改一个字节，让 ls 和 ps 集体失明</span></span></p><p><span>这是最精巧、也最能体现 GhostMap 设计思路的部分。</span></p><p><img src=\"/dailyinfo/media/3c5b61b39ecea730.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>图4｜GhostMap 进程隐匿全流程与实验观测事实</span></strong></p><p><span>图源：根据 Aqua Nautilus 研究数据绘制</span></p><p><span>Linux 通过&nbsp;</span><span><span>/proc</span></span><span>&nbsp;虚拟文件系统暴露进程信息，</span><span><span>ps、</span></span><span><span>ls</span></span><span>&nbsp;这类工具依赖&nbsp;</span><span><span>getdents64</span></span><span>&nbsp;系统调用读取目录条目。每个返回的记录带一个长度字段&nbsp;</span><span><span>d_reclen，</span></span><span>告诉读取方“下一条记录在什么位置”。</span></p><p><span>GhostMap 挂接了两处钩子：</span><span><span>enter_getdents</span></span><span>&nbsp;在进入时记下缓冲区地址，</span><span><span>exit_getdents64</span></span><span>&nbsp;在系统调用返回时检查缓冲区里的数字名记录是否命中&nbsp;</span><span><span>hidden_pids。</span></span><span>命中之后，它使用&nbsp;</span><span><span>bpf_probe_write_user</span></span><span>&nbsp;helper&nbsp;</span><strong><span>增大前一条记录的&nbsp;</span><span><span>d_reclen，</span></span></strong><span>让读取方的指针直接“跨过去”。</span></p><p><span>Aqua 的受控实验把欺骗过程量化了。在 11 月 10 日的一组对照实验中，研究者捕获了同一个目录缓冲区在 Rootkit 钩子处理前后的两份副本：</span></p><ul><li><span><span>受控目录里，前一条记录长度从&nbsp;</span><strong><span>32 字节变为 56 字节；</span></strong></span></li><li><span><span>在&nbsp;</span><span><span>/proc</span></span><span>&nbsp;下，记录长度从&nbsp;</span><strong><span>24 字节变为 72 字节，</span></strong><span>读取方一次跳过了恶意进程和测试进程两条记录；</span></span></li><li><span><span>全部 6 次复现中，每个缓冲区</span><strong><span>只改动了一个字节——</span></strong><span>长度字段两字节的低字节；</span></span></li><li><span><span>被隐藏记录的字节仍留在缓冲区里，系统调用返回的字节数也</span><strong><span>没有变化。</span></strong></span></li></ul><p><img src=\"/dailyinfo/media/99f3ac38bd7cb4f9.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>图5｜单字节篡改的实验测量数据</span></strong></p><p><span>图源：Aqua Nautilus&nbsp;</span></p><p><span>两个对防御至关重要的推论由此而来：</span></p><ol><li><span><span><span>“看不见”不等于“不存在”。</span></span><span>实验中进入隐藏名单的进程从枚举结果里消失，但通过已知的&nbsp;</span><span><span>/proc/&lt;PID&gt;</span></span><span>&nbsp;路径仍可正常访问；Rootkit 停止后，这些进程重新出现在列表中。用&nbsp;</span><span><span>ps aux | grep</span></span><span>&nbsp;查不到目标，绝不能当作进程不存在的证据。</span></span></li><li><span><span><span>隐藏按“执行”而非“继承”生效。</span></span><span><span>fork</span></span><span>&nbsp;出的子进程即使继承了同样的进程名也不会被隐藏；只有&nbsp;</span><span><span>exec</span></span><span>&nbsp;加载了匹配&nbsp;</span><span><span>comm</span></span><span>&nbsp;名的程序才会进入&nbsp;</span><span><span>hidden_pids。</span></span><span>因此“父进程在&nbsp;</span><span><span>ps</span></span><span>&nbsp;里失踪、子进程却可见”可以作为一个有价值的排查线索，但它本身不构成 Rootkit 活动的证据。</span></span></li></ol><p><span><span>04</span></span><span><span>&nbsp;网络隐匿：两套视图，一个对不上账</span></span></p><p><span>Linux 通过不止一种接口暴露套接字信息：</span><span><span>/proc/net/tcp</span></span><span>&nbsp;是文本列表，而 Netlink 套接字诊断消息则以结构化形式供&nbsp;</span><span><span>ss</span></span><span>&nbsp;等工具解析。GhostMap 对两条路都做了手脚，但</span><strong><span>效果并不对称。</span></strong></p><p><img src=\"/dailyinfo/media/143a63d17af1c71d.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>图6｜同一隐藏名单下两套读取视图的不同结局</span></strong></p><p><span>图源：根据 Aqua Nautilus 研究数据绘制</span></p><p><span>在专门的监听器实验中，被隐藏的回环监听端口 8738 对应的 inode 进入&nbsp;</span><span><span>hidden_inodes：</span></span></p><ul><li><span><span><span><span>/proc/net/tcp</span></span><span>&nbsp;侧完全得手：</span></span><span>三次观测中该监听端口全部从文本列表消失，对照端口 8739 始终可见；</span></span></li><li><span><span><span>Netlink 侧露了马脚：</span></span><span>GhostMap 把该套接字诊断消息的类型改成了&nbsp;</span><span><span>NLMSG_NOOP（</span></span><span>无操作消息），但</span><strong><span>端口、标识和监听状态仍原样保留在消息负载里。</span></strong><span>受测的&nbsp;</span><span><span>ss</span></span><span>&nbsp;工具（iproute2 6.1.0-1ubuntu6.4）三次查询依然完整显示了该监听端口，只是丢了进程属主标注。上游源码可以解释这一点：</span><span><span>ss</span></span><span>&nbsp;的解析路径即使收到改类型的消息，也能从保留的负载里读出套接字信息。</span></span></li></ul><p><img src=\"/dailyinfo/media/bbe047ae34fd23cf.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>图7｜套接字隐匿双视图的对照实验数据</span></strong></p><p><span>图源：Aqua Nautilus&nbsp;</span></p><p><span>这组结果应当这样理解：</span><strong><span>Rootkit 的隐藏代码确实执行了，但在&nbsp;</span><span><span>ss</span></span><span>&nbsp;这个读取方上失效了。</span></strong><span>结论针对的是受测的&nbsp;</span><span><span>ss</span></span><span>&nbsp;版本，其他消费 Netlink 消息的工具可能有不同表现。实践含义很直接：不要依赖单一来源的套接字清单，互相印证不同接口的视图，缺失与差异本身就是信号。</span></p><p><span><span>05</span></span><span><span>&nbsp;反调试与本地收集</span></span></p><p><span>GhostMap 的第三个职能是干扰分析。受控测试中对受保护进程发起&nbsp;</span><span><span>PTRACE_ATTACH，</span></span><span>附加操作的任务被以&nbsp;</span><strong><span>SIGKILL</span></strong><span>&nbsp;终止——这意味着用&nbsp;</span><span><span>gdb、</span></span><span><span>strace</span></span><span>&nbsp;做常规调试的分析师，</span><strong><span>工具本身会先被杀掉。</span></strong></p><p><span>与此同时，IronWorm 的本地收集器监听&nbsp;</span><span><span>127.0.0.1:8738，</span></span><span>接收本机提交的文本记录。研究者用合成数据验证：7 条被接收的记录经&nbsp;</span><span><span>setxattr</span></span><span>&nbsp;系统调用被写入已安装可执行文件的一个扩展属性&nbsp;</span><span><span>user.d，</span></span><span>读写回验精确匹配；静态分析显示这些数据与对外 C2 消息的构造相关联。（Atomic Arch 渠道的对比载荷还多出一个 19051 端口的回环监听点。）值得强调的是，实验确认了</span><strong><span>本地收集与存储，</span></strong><span>未观测到成功的外发投递或经认证的远程命令执行——GhostMap 负责隐藏活动，它并不实现收集器的输入解析或 C2 命令逻辑。</span></p><p><span><span>06</span></span><span><span>&nbsp;欺骗失效的地方：Tracee 的检测证据</span></span></p><p><span>以上所有实验里，Aqua 的开源运行时安全工具</span><strong><span>Tracee</span></strong><span>在 IronWorm 启动之前就已驻留监控。结果是：Rootkit 在用户态视图上做得再干净，</span><strong><span>没能逃过内核侧的原始遥测。</span></strong></p><p><img src=\"/dailyinfo/media/9974857c32508c39.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>图8｜隐匿生效期间的运行时检测链路</span></strong></p><p><span>图源：根据 Aqua Nautilus 研究数据绘制</span></p><p><span>GhostMap 的程序向内核挂载时，Tracee 立即告警，识别出三个携带内存写入能力的程序——</span><span><span>exit_getdents、</span></span><span><span>net_exit_read、</span></span><span><span>exit_recvmsg，</span></span><span>恰好对应目录隐匿与网络隐匿路径，告警均报告其使用了&nbsp;</span><span><span>bpf_probe_write_user</span></span><span>&nbsp;helper。</span></p><p><img src=\"/dailyinfo/media/59affa1386a6e77e.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>图9｜Tracee 挂载时告警原始记录</span></strong></p><p><span>图源：Aqua Nautilus&nbsp;</span></p><p><span>在整个隐匿生效期间，</span><strong><span>48 次受测的目录读取调用全部被 Tracee 完整保留，</span></strong><span>研究者随后用独立的测量手段确定了被跳过的记录和被改动的字节。</span></p><p><span>这组实验回答了两个互补的问题：运行时遥测告诉你“什么可疑代码上线了”，缓冲区测量告诉你“它随后隐藏了什么”。</span><strong><span>Rootkit 能操纵的是工具看到的结果，而不是行为本身——这就是运行时安全的价值所在。</span></strong></p><p><strong><span>需要说明：</span></strong><span>该实验展示的是检测而非阻断；</span><span><span>bpf_probe_write_user</span></span><span>&nbsp;这个能力本身也不等于恶意，仍需结合属主、挂载时机和观测行为综合研判。</span></p><p><span><span>07</span></span><span><span>&nbsp;给防守方的建议</span></span></p><ol><li><span><span><span>不要把空搜索结果当作排除证据。</span></span><span>对可疑 PID，对比枚举结果、</span><span><span>/proc/&lt;PID&gt;</span></span><span>&nbsp;直接访问与历史执行遥测，交叉核对可执行文件身份、服务配置与 BPF 属主。</span></span></li><li><span><span><span>排查异常的 BPF 挂载。</span></span><span>具备用户态内存写入能力的 eBPF 程序值得重点调查，可用&nbsp;</span><span><span>bpftool</span></span><span>&nbsp;审视系统上程序、map、link 及其属主。</span></span></li><li><span><span><span>比对多个独立的套接字视图。</span></span><span><span>/proc/net/tcp</span></span><span>&nbsp;与 Netlink 诊断工具（如&nbsp;</span><span><span>ss）</span></span><span>结果不一致时，差异本身即是线索。</span></span></li><li><span><span><span>取证时保留的不只是文件内容。</span></span><span>收集样本时连同扩展属性等元数据一并保存，只拷贝普通文件字节会漏掉存放在&nbsp;</span><span><span>user.d</span></span><span>&nbsp;中的本地记录。</span></span></li><li><span><span><span>谨慎对待交互式调试。</span></span><span>对受保护进程贸然附加调试器可能触发反制（附加任务被 SIGKILL），事先规划好采集顺序，先固定证据再处置。</span></span></li><li><span><span><span>核查安装与服务链路。</span></span><span>对安装过相关恶意包的系统，回溯安装日志与 systemd 服务活动；移除服务或卸载 eBPF 程序之前先保全证据。</span></span></li></ol><p><span><span>08</span></span><span><span>&nbsp;技术附录</span></span></p><p><span>MITRE ATT&amp;CK 技术映射</span></p><table><tbody><tr><td><p><span>战术</span></p></td><td><p><span>技术</span></p></td><td><p><span>观测到的组件与行为</span></p></td></tr><tr><td><p><span>防御规避</span></p></td><td><span><span>T1014</span></span><p><span>&nbsp;Rootkit</span></p></td><td><p><span>GhostMap 挂载的 eBPF 程序篡改进程与套接字枚举结果</span></p></td></tr><tr><td><p><span>持久化</span></p></td><td><span><span>T1543.002</span></span><p><span>&nbsp;Systemd Service</span></p></td><td><p><span>IronWorm 安装器创建并启用服务，用于启动植入体并加载 GhostMap</span></p></td></tr><tr><td><p><span>防御规避</span></p></td><td><span><span>T1622</span></span><p><span>&nbsp;Debugger Evasion</span></p></td><td><p><span>受控测试中，GhostMap 的反调试程序使附加任务收到 SIGKILL</span></p></td></tr><tr><td><p><span>防御规避</span></p></td><td><span><span>T1564.014</span></span><p><span>&nbsp;Extended Attributes</span></p></td><td><p><span>IronWorm 收集器将接收到的记录存储在已安装可执行文件的&nbsp;</span><span><span>user.d</span></span><span>&nbsp;扩展属性中</span></p></td></tr></tbody></table><p><span>（注：扩展属性映射仅涉及“正常文件内容之外的存储”，不代表从该属性执行代码。）</span></p><p><span>失陷指标（IOC）</span></p><table><tbody><tr><td><p><span>类型</span></p></td><td><p><span>指标</span></p></td><td><p><span>说明</span></p></td></tr><tr><td><p><span>SHA256</span></p></td><td><span><span>0c16ee8a8c1f5b51b01bce924e173030f032912d5b66f1a564fd636a67ddbf5f</span></span></td><td><p><span>获取到的&nbsp;</span><span><span>weavedb-sdk@0.45.3</span></span><span>&nbsp;包归档</span></p></td></tr><tr><td><p><span>SHA256</span></p></td><td><span><span>36abd242ddaa27f0160c539377a0e92cf781c1695137850acc87e3892b436d36</span></span></td><td><p><span>执行的&nbsp;</span><span><span>tools/setup</span></span><span>&nbsp;ELF，与已安装的可执行文件一致</span></p></td></tr><tr><td><p><span>SHA256</span></p></td><td><span><span>8795b5215dd06c5366a038a65b18b4dfefa5fd90244a567c3e0b58323103377c</span></span></td><td><p><span>从 IronWorm 运行时内存中恢复的 GhostMap BPF ELF</span></p></td></tr><tr><td><p><span>SHA256</span></p></td><td><span><span>6144d433f8a0316869877b5f834c801251bbb936e5f1577c5680878c7443c98b</span></span></td><td><p><span>Atomic Arch 活动相关的对比载荷</span></p></td></tr><tr><td><p><span>SHA256</span></p></td><td><span><span>3607de2597f8955f9a88f36ee43b64d3891b8ef536e99fa098e80169350f7b01</span></span></td><td><p><span>Atomic Arch 载荷内嵌的 GhostMap BPF 对象（</span><span><span>scales.bpf.c，</span></span><span>52,776 字节）</span></p></td></tr><tr><td><p><span>包名</span></p></td><td><span><span>atomic-lockfile、</span></span><span><span>lockfile-js、</span></span><span><span>js-digest</span></span></td><td><p><span>Atomic Arch AUR 投递链中报告的包名（受影响版本未在此确认）</span></p></td></tr><tr><td><p><span>文件路径</span></p></td><td><span><span>/var/lib/glugi/glugi</span></span></td><td><p><span>初始运行时调查中的已安装可执行文件（命名可变）</span></p></td></tr><tr><td><p><span>文件路径</span></p></td><td><span><span>/var/lib/havebi/havebi</span></span></td><td><p><span>11 月 10 日变异实验中的已安装可执行文件</span></p></td></tr><tr><td><p><span>包名</span></p></td><td><span><span>weavedb-sdk@0.45.3</span></span></td><td><p><span>所分析样本所在的包</span></p></td></tr><tr><td><p><span>本地端点</span></p></td><td><span><span>127.0.0.1:8738</span></span></td><td><p><span>观测到的回环收集器端口，并非外部 C2 地址</span></p></td></tr><tr><td><p><span>扩展属性</span></p></td><td><span><span>user.d</span></span></td><td><p><span>存放收集器记录的扩展属性名</span></p></td></tr></tbody></table><p><strong><span>使用注意：</span></strong><span>npm 归档哈希不能当作提取后可执行文件的标识；路径与属性名属于辅助性工件，仅凭其存在不能判定 GhostMap 或 IronWorm。</span></p><p><span><span>09</span></span><span><span>&nbsp;参考链接</span></span></p><p><strong><span>1.&nbsp;</span><span>Aqua Nautilus：Uncovering GhostMap: The Rootkit Behind Shai-Hulud's Rusty Cousin（2026-11-17）</span></strong><span><br></span><span><span><a href=\"https://www.aquasec.com/blog/ironworm-ebpf-rootkit-ghostmap-linux/\">https://www.aquasec.com/blog/ironworm-ebpf-rootkit-ghostmap-linux/</a></span></span></p><p><strong><span>2.&nbsp;</span><span>JFrog Security Research：IronWorm: Shai-Hulud's rustier cousin（2026-06-03）</span></strong><span><br></span><span><span><a href=\"https://research.jfrog.com/post/iron-worm-shai-hulud-rustier-cousin/\">https://research.jfrog.com/post/iron-worm-shai-hulud-rustier-cousin/</a></span></span></p><p><strong><span>3.&nbsp;</span><span>Sonatype：Atomic Arch npm Campaign Adds Malicious Dependency（2026-06-11）</span></strong><span><br></span><span><span><a href=\"https://www.sonatype.com/blog/atomic-arch-npm-campaign-adds-malicious-dependency\">https://www.sonatype.com/blog/atomic-arch-npm-campaign-adds-malicious-dependency</a></span></span></p><p><strong><span>4.&nbsp;</span><span>Cloud Security Alliance 研究笔记：IronWorm: eBPF Rootkit and Tor C2 Target npm Supply Chain（2026-06-07）</span></strong><span><br></span><span><span><a href=\"https://labs.cloudsecurityalliance.org/research/csa-research-note-ironworm-ebpf-rootkit-npm-supply-chain-202/\">https://labs.cloudsecurityalliance.org/research/csa-research-note-ironworm-ebpf-rootkit-npm-supply-chain-202/</a></span></span></p><p><strong><span>5.&nbsp;</span><span>Cloud Security Alliance 研究笔记：Atomic Arch: AUR Supply Chain Attack Deploys eBPF Rootkit（2026-06-17）</span></strong><span><br></span><span><span><a href=\"https://labs.cloudsecurityalliance.org/research/csa-research-note-aur-supply-chain-ebpf-rootkit-20260617-csa/\">https://labs.cloudsecurityalliance.org/research/csa-research-note-aur-supply-chain-ebpf-rootkit-20260617-csa/</a></span></span></p><p><span>本文</span><span>已发布于NCC国家网络安全云社区<a href=\"https://nccsec.cn/security-community\">https://nccsec.cn/security-community</a></span></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=0019dac2&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzI2MDc2MDA4OA%3D%3D%26mid%3D2247521462%26idx%3D2%26sn%3D658b0b589425488dda58a7b36d7344d8\">跳转微信打开</a></p>","original","zhKind","complete","逆向","供应链投毒","内核","后门","https://mp.weixin.qq.com/s?__biz=MzI2MDc2MDA4OA==&mid=2247521462&idx=2&sn=658b0b589425488dda58a7b36d7344d8","奇安信威胁情报中心",{"_97":98,"_99":-5},"changelogVersion","2026-10-01T08:00","release"]
