[{"_1":2,"_3":4},"root",{"_5":111},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1793591189000,"id","wsntmow6j7f4emvphlkjlx4fh","title","独立研究员在 Gitee 公开仓库发现 26,400 个仍有效的云与 AI 凭据","originalTitle","26,400 Valid Cloud and AI Credentials Found Exposed in Public Gitee Repositories","summary","独立研究员 Ben Zimmermann 扫描 Gitee 的 7.25 million 个公开仓库，发现 26,400 个仍可使用的云与 AI 凭据，其中包括 9。","reason","文章用扫描规模、有效凭据数量和服务分布说明公开代码托管平台的风险，也给出轮换凭据与核查异常使用等处置方法。","source",{"_73":110},"links",{"_99":109},"publishedAt","2026-10-29T11:33:15.000Z","discoveredAt","2026-10-29T23:39:28.408Z","timelineAt","category","activity","tags",[103,104,74,105,106,107,108],"score",79,"selected",true,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_61":98,"_99":-5,"_100":101,"_102":37},"outline",[83,84,85,86],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","faa0RYr8QHpw","reportCount",1,"additionalSourceCount",0,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","ai-security","name","AI 安全","identity","身份与访问","supply-chain","供应链安全",{"_80":81,"_13":82},"publicId","9a6f8831-a3e8-4b53-a072-7359d34fcdbe","Gitee公开仓库暴露大量有效云与AI凭据",{"_11":96,"_88":97,"_90":91},{"_11":94,"_88":95,"_90":91},{"_11":92,"_88":93,"_90":91},{"_11":87,"_88":89,"_90":91},"sec-4","text","Gitee 与其他代码托管平台","level",3,"sec-3","两种扫描器，不同的结果","sec-2","提交密钥后该怎么办","sec-1","暴露的内容","<p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiwVszv5076OudfiraNA4yh_XuzZZof-jYaklwUgiY700oPMvBHQfKHx-8yLNwhF9NVXahFRvWwU7c0mPCsIG-GUo45Fi_LT6ecZMsaRUfaLIL6eK16qeku1PO5aMTQRV0VKJh-pjKG4rC-RyajCGjL4R_A5W6YPsps4B4-GhEbstuAN7AnelVJPwIFK5W-/s1600/gite.jpg\"><img alt=\"\" src=\"/dailyinfo/media/95f31607896a8de6.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>研究人员测试时，开发人员遗留在 <strong>Gitee</strong>（一家中国代码托管服务）公开代码中的 26,400 份凭据仍然有效。任何从那段代码中复制凭据的人都可能使用它。</p><p>独立研究员 <strong>Ben Zimmermann </strong>通过扫描 725 万个公开的 Gitee 仓库发现了这些凭据，并于 10 月 28 日<a href=\"https://www.mongodb.com/company/blog/technical/scanning-7-point-25-million-public-repositories-chinas-largest-git-platform-for-secrets\">公布了结果</a>。其中大多数是云服务和 AI 服务的密钥，以 9,473 对 Alibaba Cloud AccessKey 为主。</p><p>Zimmermann 向暴露密钥最多的供应商发送了其凭据列表，但没有联系泄露密钥的开发人员。发布结果时，他尚未确认所报告的任何凭据是否已被吊销。因此，任何将密钥推送到公开 Gitee 仓库的人都无法假定它已被吊销。</p><p>此次扫描运行了约一个月，但 Zimmermann 没有提供具体日期，因此不清楚这些凭据是多久以前接受测试的。他也没有说明是否有人使用过这些凭据。</p><p>他使用了两款密钥扫描器，即 <a href=\"https://github.com/trufflesecurity/trufflehog\">TruffleHog</a> 和 <a href=\"https://github.com/mongodb/kingfisher\">Kingfisher</a>，扫描每个仓库。他写道，两者都会针对签发凭据的服务逐一测试每份凭据，并且只保留仍然有效的凭据。</p><p>扫描器会读取每个仓库的完整提交历史。即使开发人员后来从代码中删除了密钥，仍可能在那里找到并统计到该密钥。</p><p>26,400 这一数字将每份凭据只计一次，无论它出现在多少个仓库中。按提交日期计算，12,242 份凭据来自 2025 年，接近总数的一半。有些可追溯至 2000 年代后期。</p><h3 id=\"sec-1\">暴露的内容</h3><p>在 Alibaba Cloud 密钥之后，数量最多的几组分别是 3,805 个 YouTube API 密钥、3,170 个 DeepSeek 密钥、1,489 个 Zhipu BigModel AI 平台密钥和 1,348 个 OpenAI 密钥。GitHub、AWS、Google Cloud 和 Google 的 Gemini 发现的密钥数量较少。</p><p>Zimmermann 写道，其中一份凭据是“某大型企业 AI 平台的有效组织管理员凭据”。他没有透露该平台的名称，也没有说明该凭据能够访问什么。</p><p>有效密钥能让人做什么取决于具体服务。OpenAI 表示，凭据泄露后，他人可以在所有者不知情的情况下使用该账户的配额。这可能造成“数据丢失、意外费用”、月度配额耗尽以及 API 访问中断。</p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEga096EUb7qYUKJFGjrS1qU6VeOHLnnXj5gB6QDaHBmu02_5NIj1dlmNXFSDZt3eUmJOhLXMjERhXoies74Bp_y1EG-rKxaQOwQJg5XiVOm2wwDlopXk6iE86JNjE0WePWESyPfbVfdmVQ3QqgbVVunXJTeJTkjvVY02WcZ3UZEj4ML8-Np5jnpIaZgxbU/s1600/1.png\"><img alt=\"\" src=\"/dailyinfo/media/8aee2f02bde099a5.webp\" loading=\"lazy\" decoding=\"async\"></a></p><p>YouTube API 密钥是一种用于标识项目的 Google Cloud API 密钥，<a href=\"https://developers.google.com/youtube/registering_an_application\">Google 表示</a>。如果没有 API 限制，此类密钥可用于所有接受 Google Cloud 密钥的 API。</p><h3 id=\"sec-2\">提交密钥后该怎么办</h3><p>将任何曾进入公开 Gitee 仓库的密钥视为已经暴露，并在相应提供商处将其吊销。正如 TruffleHog 的开发者 Truffle Security 所指出的，从代码中删除密钥或重写仓库历史<a href=\"https://trufflesecurity.com/blog/why-exposed-credentials-stay-live-for-years\">并不会吊销密钥</a>。</p><ul>\n  <li><strong>Alibaba Cloud：</strong>创建新的 AccessKey 对，将你的应用切换到新密钥，然后禁用并删除旧密钥对。Alibaba Cloud 的<a href=\"https://help.aliyun.com/en/ram/user-guide/solution-to-accesskey-leakage\">泄露响应方案</a>建议检查意外费用，以及是否有你不需要的资源被创建或删除。ActionTrail 会显示过去 90 天内该密钥的 API 调用，但 OSS 和 SLS 等服务中的数据操作必须在每个服务自己的日志中检查。</li>\n  <li><strong>Google 和 YouTube API 密钥：</strong><a href=\"https://docs.cloud.google.com/docs/authentication/api-keys\">轮换密钥</a>，这会创建一个具有相同限制的新密钥，更新你的应用以使用新密钥，然后删除旧密钥。添加 API 限制，使该密钥只能与所需的 API 配合使用。</li>\n  <li><strong>OpenAI：</strong>&nbsp;按照 OpenAI 的建议，立即在 API Keys 页面轮换密钥，&nbsp;<a href=\"https://help.openai.com/en/articles/5112595-best-practices-for-api-key-safety\">并设置支出限制</a>，以帮助限制泄露密钥造成的费用。</li>\n</ul><h3 id=\"sec-3\">两种扫描器，不同的结果</h3><p>MongoDB 开发了 Kingfisher，而 Zimmermann 的文章是与 Kingfisher 团队合作完成的。</p><p>在此次扫描中，TruffleHog 发现了 12,737 个有效的凭据，Kingfisher 发现了 14,664 个，但两者都发现的只有 1,001 个。每种工具单独发现的数量约为总数的一半。</p><p>TruffleHog 几乎发现了所有 Alibaba Cloud 密钥。Zimmermann 写道，Kingfisher 发现了全部 1,489 个 BigModel 密钥，因为 TruffleHog 没有针对 Zhipu 密钥的检测器。</p><p>依赖单一扫描器的团队应针对其使用的服务验证扫描器的检测器。</p><h3 id=\"sec-4\">Gitee 与其他代码托管平台</h3><p>中国工业和信息化部于 2020 年<a href=\"https://blog.gitee.com/2020/08/17/gitee-gxb/\">选择 Gitee</a>&nbsp;作为国家开源代码托管平台的基础。</p><p>Gitee 的公开 API 受到限制，一项<a href=\"https://chinggg.github.io/post/git-leaks/\">于 2021 年开展</a>&nbsp;的研究因该限制而放弃了对该站点泄露凭据的调查。</p><p>Zimmermann 写道，Gitee 的命中率为每扫描 1,000 个仓库发现 3.64 个有效凭据，高于此前对 GitLab（3.11）和 Bitbucket（2.39）<a href=\"https://trufflesecurity.com/blog/scanning-5-6-million-public-gitlab-repositories-for-secrets\">扫描所得</a>&nbsp;的命中率。那些扫描仅使用了 TruffleHog。</p><p>仅根据 TruffleHog 的结果，Gitee 的命中率为 1.76，但该数字不包含 TruffleHog 未覆盖的服务，例如 Zhipu。因此，这两个数字都无法说明哪个平台泄露得更多。</p><p>觉得这篇文章有意思？欢迎在 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a> 上关注我们，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","数据泄露","凭据","供应链","阿里","Google","AWS","https://thehackernews.com/2026/10/26400-valid-cloud-and-ai-credentials.html","The Hacker News",{"_112":113,"_114":-5},"changelogVersion","2026-10-01T08:00","release"]
