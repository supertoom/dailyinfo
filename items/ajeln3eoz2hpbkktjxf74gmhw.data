[{"_1":2,"_3":4},"root",{"_5":105},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1793621935000,"id","ajeln3eoz2hpbkktjxf74gmhw","title","FBI 指控 North Korea 窃取 Binance 超过 $6 billion 虚拟资产","originalTitle","FBI Blames North Korea for $6 Billion Binance Crypto Theft","summary","FBI 指控朝鲜关联组织 TraderTraitor 于 2026 年 10 月 29 日前后从加密货币交易所 Binance 窃取超过 $6 billion 虚拟资产，并要求 THORChain 节点、RPC 节点、即时兑换、DeFi 平台等服务商阻断相关地址及衍生资金。","reason","source",{"_75":104},"links",{"_94":103},"publishedAt","2026-11-01T19:23:14.000Z","discoveredAt","2026-11-01T20:33:36.821Z","timelineAt","category","activity","tags",[76,100,101,102,78],"score",80,"selected",true,"channel","news","story",{"_84":85,"_13":86},"x","sameEvent",{"_11":98,"_13":99},"readingMode","full","author","Pierluigi Paganini","body",{"_62":93,"_94":-5,"_95":96,"_97":36},"outline",[87],"relatedStories",[83],"topics",[69,70,71,72],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","f39FEvqrWazs","reportCount",6,"additionalSourceCount",5,{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","attack","name","攻击活动","exploited","在野利用","black-market","数据窃取与黑产","crypto","密码学",{"_84":85,"_13":86},"publicId","6ef2ec24-f871-4ca2-9cc2-5fcbd249af24","FBI归因TraderTraitor窃取Binance资产",{"_11":88,"_89":90,"_91":92},"sec-1","text","FBI指责朝鲜从 Binance 窃取 60 亿美元，并敦促加密货币公司阻断与被盗资金有关的交易。","level",2,"<h2 id=\"sec-1\">FBI指责朝鲜从 Binance 窃取 60 亿美元，并敦促加密货币公司阻断与被盗资金有关的交易。</h2><p>FBI已将朝鲜认定为在 2026 年 10 月 29 日前后从加密货币交易所 Binance 窃取<a href=\"https://securityaffairs.com/202119/cyber-crime/6-3-billion-stolen-from-binance-in-attack-attributed-to-north-korea.html\">超过 60 亿美元的虚拟资产</a>的幕后黑手。该局在一份<a href=\"https://www.fbi.gov/investigate/cyber/alerts/2026/north-korea-responsible-for-6-billion-binance-attack\">公开警报</a>中公布了调查结果。FBI特别指责与朝鲜有关的 APT“<a href=\"https://securityaffairs.com/tag/tradertraitor\">TraderTraitor</a>”，该组织也被追踪为<a href=\"https://securityaffairs.com/tag/lazarus-group\">Lazarus Group</a>和<a href=\"https://securityaffairs.com/tag/apt38\">APT38</a>。</p><p>Binance尚未指名罪魁祸首，但区块链分析公司 TRM 已经指认。它最先将此次攻击归因于<a href=\"https://securityaffairs.com/tag/tradertraitor\">TraderTraitor</a>，Chainalysis也表示对这一结论高度确信。</p><p><em>“美国联邦调查局（FBI）发布信息， advising 朝鲜民主主义人民共和国（朝鲜）对 2026 年 10 月 29 日前后从加密货币交易所 Binance 窃取超过 60 亿美元的虚拟资产负责。FBI将这一特定的朝鲜恶意网络活动称为‘TraderTraitor’。”<a href=\"https://www.fbi.gov/investigate/cyber/alerts/2026/north-korea-responsible-for-6-billion-binance-attack\">FBI声明原文</a>写道。</em></p><p><em>“FBI与 USSS 和 IRS-CI 的合作伙伴共同观察到，TraderTraitor 行动人员主要将被盗资产转换为 Ethereum（ETH）。预计这些资产随后会通过 DeFi 和即时兑换服务进行转换，以便为后续洗钱阶段做好准备，从而进一步洗钱。”</em></p><p>攻击者利用一名工程师的笔记本电脑访问权限进入服务容器，并发送未经授权的提款请求。Binance表示，尚未发现攻击者窃取任何钱包私钥的证据。</p><p>FBI、美国特勤局（USSS）和 IRS 刑事调查局（IRS-CI）发现，TraderTraitor 行动人员正将大部分被盗资产转换为 Ethereum（ETH）。这些机构预计下一步将会有更多洗钱活动，即行动人员通过 DeFi 和即时兑换服务兑换资金，为后续阶段做好准备。即时兑换服务的名称确实很贴切。</p><p>这份警报面向私营公司以及执法机构。FBI、USSS 和 IRS-CI 正请求多类企业协助阻止洗钱，包括支持 THORChain 网络的 THORNode 运营者、为应用提供区块链访问权限的 RPC 节点运营者、即时加密货币交易所、DeFi 平台、区块链分析公司及其他加密货币服务提供商。</p><p>要求很明确：这些公司应阻断涉及 TraderTraitor 所使用钱包地址的任何交易，包括可追溯至这些地址的资金。据 FBI 表示，这些地址已接收被盗资金，并由朝鲜攻击者控制或与其密切相关。完整地址列表已包含在警报中。</p><p>如果你运营上述任何一种服务，第一项工作是将你的阻止列表与该清单进行核对。第二项工作是查看间接涉及这些地址的资金流，因为 FBI 要求阻断所有“源自”这些地址的资金，而不只是直接转账。区块链分析公司之所以被点名，正是因为追踪衍生资金正是它们的专业工作。</p><p>FBI表示，它致力于通过识别、缓解和破坏朝鲜的非法网络犯罪及虚拟资产盗窃活动，保护虚拟资产社区。</p><p><em>“FBI 始终致力于保护虚拟资产社区，通过识别、缓解和挫败朝鲜的非法网络犯罪及虚拟资产盗窃活动。”报告称。“如果您有任何信息可以提供，请联系您当地的 <a href=\"https://www.fbi.gov/contact-us/field-offices\">FBI 地方办公室</a>或 FBI 互联网犯罪投诉中心，网址为 <a href=\"http://www.ic3.gov/\">ic3.gov</a>。”</em></p><p>TRM 表示，攻击者于 10 月 29 日从 Binance 在十条区块链上的钱包中转走了约 $6.36 billion，其中大部分是在 20:05 UTC 开始的约 20 分钟内转出的。这使其成为有记录以来规模最大的加密货币盗窃案，约为 2025 年 2 月 Bybit 被黑事件的 $1.5 billion 的四倍。</p><p><em>“2026 年 10 月 29 日，攻击者从 Binance 在十条区块链上的钱包中转走了约 USD 6.36 billion，其中大部分是在 20:05 UTC 开始的约 20 分钟内转出的。这使其成为有记录以来规模最大的加密货币盗窃案，约为 2025 年 2 月 Bybit 被黑事件的 USD 1.5 billion 的四倍。Binance 已确认发生安全事件，并暂停了多个网络上的提币。”<a href=\"https://www.trmlabs.com/resources/blog/north-korea-steals-usd-6-36-billion-from-binance-in-the-largest-hack-in-history\">TRM 表示</a>。“TRM 根据充分的链上和链下情报，将此次攻击归因于朝鲜的精英黑客组织 TraderTraitor。我们对此判断有高度信心。TRM 正通过 Beacon Network 追踪这些资金并提醒合作伙伴。”</em></p><p>冻结资金也只起到了部分作用。Tether、Circle、Ripple 和 World Liberty Financial 冻结了约 $2.67 billion 的稳定币，Arbitrum 安全委员会冻结了 8,426 ETH 和 74.6 million ARB，总计约 $2.7 billion。但攻击者抢先于冻结行动，将 USDT 出售给做市商，并在 Aave 上以 USDT 抵押借入 ETH。他目前持有超过 420,000 ETH 和 18,270 BTC，约 $2.4 billion 已超出任何发行方的触及范围。</p><p>早期公布的冻结金额也很混乱，&nbsp;Tether 和 Circle 冻结了初始报告中与可疑转账相关的约 $1.79 billion 稳定币。这些金额对应的是不同时间点，在未确认其是否涵盖不同资产之前，不应将其相加。冻结机制适用于有发行方可以联系的代币，而 Ether 和 Bitcoin 没有发行方。</p><p>以下是我就 Binance 案件接受意大利国家电视台采访的链接。</p><p><a href=\"https://www.youtube.com/watch?v=DtvhBA9TdPo\"><strong>https://www.youtube.com/watch?v=DtvhBA9TdPo</strong></a></p><p><strong>在 Twitter 上关注我：&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;以及&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;和&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a><strong></strong></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;黑客活动，&nbsp;Binance)</strong></p>","original","zhKind","translation","complete","uu0z6mo1muhhj4bo1sst643w9","FBI 将 Binance 63 亿美元加密资产窃取案归因于朝鲜 TraderTraitor","数据泄露","加密","黑产","https://securityaffairs.com/202221/apt/fbi-blames-north-korea-for-6-billion-binance-crypto-theft.html","Security Affairs",{"_106":107,"_108":-5},"changelogVersion","2026-10-01T08:00","release"]
