[{"_1":2,"_3":4},"root",{"_5":100},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1795740052000,"id","xwaatm5iexkiy0ldwue30gnrr","title","Drupal 修复已在野利用的严重漏洞 CVE-2026-136716","originalTitle","Drupal Warns of New Critical Flaw Exploited in the Wild","summary","Drupal 确认严重漏洞 CVE-2026-136716 已被在野利用，攻击者可借此接管网站。该漏洞源于对异常或不完整安装状态处理不当，与此前修复的 CVE-2026-132165（Fail2Install）相关，SA-CORE-2026-017 的补丁未能覆盖所有易受攻击的安装场景，受影响的是 install.php 仍可远程访问的网站。","reason","source",{"_74":99},"links",{"_90":98},"publishedAt","2026-11-26T19:45:57.000Z","discoveredAt","2026-11-26T20:50:27.760Z","timelineAt","category","vuln","tags",[96,75,97,78],"score",80,"selected",true,"channel","news","story",{"_80":81,"_13":82},"x","sameEvent",{"_11":94,"_13":95},"readingMode","full","author","Pierluigi Paganini","body",{"_62":89,"_90":-5,"_91":92,"_93":36},"outline",[83],"relatedStories",[79],"topics",[69,70,71],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","fbUqn7i0GgUU","reportCount",4,"additionalSourceCount",3,{"_72":77,"_74":78},{"_72":30,"_74":76},{"_72":73,"_74":75},"slug","exploited","name","在野利用","漏洞披露","cisa","CISA",{"_80":81,"_13":82},"publicId","df8b9daa-5e85-4d46-a5ad-7d5591635b6b","Drupal核心站点接管漏洞确认在野利用",{"_11":84,"_85":86,"_87":88},"sec-1","text","Drupal 修复了一个已在野利用的严重漏洞，攻击者可能借此接管存在漏洞的网站。","level",2,"<h2 id=\"sec-1\">Drupal 修复了一个已在野利用的严重漏洞，攻击者可能借此接管存在漏洞的网站。</h2><p>Drupal 警告称，Drupal Core 存在一个新的高度严重漏洞，攻击者正在积极利用该漏洞接管存在漏洞的网站。</p><p>该漏洞被追踪为 CVE-2026-136716，与对异常或不完整安装状态处理不当有关。它与 <strong><a href=\"https://securityaffairs.com/203965/uncategorized/u-s-cisa-adds-drupal-core-idunno-anticsrf-and-optimizely-web-experimentation-flaws-to-its-known-exploited-vulnerabilities-catalog.html\">CVE-2026-132165</a></strong> 相关，后者也称为 Fail2Install，Drupal 已于 11 月 18 日对其发布补丁。然而，此前的修复并未涵盖每一种存在漏洞的安装情形。</p><p><em>“<a href=\"https://www.drupal.org/sa-core-2026-017\">SA-CORE-2026-017</a> 最近修复了 Drupal 核心安装程序中的多个漏洞。然而，在该公告发布后，某些处于异常或不完整安装状态的网站仍可能因网站接管漏洞而受到影响，其中包括生产网站。用户界面中无法看出网站是否处于受影响且存在漏洞的状态，而已经被入侵的网站可能已不再处于漏洞状态。” Drupal 维护人员 <a href=\"https://www.drupal.org/sa-core-2026-019\">警告称</a>。</em></p><p>该问题影响 Drupal 安装程序（<code>install.php</code>）仍可远程访问的网站。Drupal 强调，对于管理员已经妥善保护安装程序的网站，该漏洞不会造成影响。</p><p>一个尤其令人担忧的方面是，管理员无法通过 Drupal 界面轻松识别受影响的安装。此外，已经被入侵的网站可能看起来已不再处于漏洞状态。</p><p>Drupal 确认 CVE-2026-136716 已在野利用，并敦促管理员调查可能存在的入侵行为。</p><p><em>“<strong>该漏洞正在野利用中</strong>。任何在 SA-CORE-2026-017 发布后仍使安装程序可远程访问的网站，都可能已遭到入侵。”公告补充道。</em></p><p>建议采取的措施包括检查日志，查找涉及主管理账户（称为 <strong>user 1</strong>）的未授权访问和异常更改。管理员还应验证该账户的电子邮件地址是否由自己控制，并考虑重置其密码。</p><p>该漏洞已在以下版本中修复：</p><ul>\n<li>Drupal 11.4.x：更新至 11.4.14</li>\n\n\n\n<li>Drupal 11.3.x：更新至 11.3.23</li>\n\n\n\n<li>Drupal 10.6.x：更新至 10.6.23</li>\n</ul><p>Drupal 11.0.x 至 11.2.x 以及 10.5.x 和更早版本均已停止生命周期支持，不会收到安全修复。</p><p>更新后，管理员应运行 <code>update.php</code> 以修复受影响的安装状态，并确保所有现有和新网站上的安装程序均已得到妥善保护。</p><p>Drupal <a href=\"https://new.drupal.org/project/usage/drupal\">自身的使用统计数据</a>进一步证明了其暴露程度。2026 年 11 月 15 日发布的数据表明，仍有数千个网站报告运行 Drupal 8.x，数万个网站使用 Drupal 9.x，这两个分支均已不再受支持。尽管这些数字仅涵盖通过 Drupal 更新系统报告其版本的网站，但凸显了过时安装的持续存在，以及组织迁移到受支持版本的必要性。</p><p>本周，美国网络安全和基础设施安全局（CISA）&nbsp;<a href=\"https://securityaffairs.com/203965/uncategorized/u-s-cisa-adds-drupal-core-idunno-anticsrf-and-optimizely-web-experimentation-flaws-to-its-known-exploited-vulnerabilities-catalog.html\">将</a> Drupal Core 漏洞 <a href=\"https://www.cve.org/CVERecord?id=CVE-2026-132165\">CVE-2026-132165</a> 加入其&nbsp;<a href=\"https://www.cisa.gov/known-exploited-vulnerabilities-catalog\">已知被利用漏洞（KEV）目录</a>：</p><p><strong>在 Twitter 上关注我：&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;以及&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;和&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a><strong></strong></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;黑客攻击，&nbsp;CMS)</strong></p>","original","zhKind","translation","complete","edycapt0khpdxw9pdgw91bldq","Drupal 安装器补丁遗漏导致 CVE-2026-136716 已被在野利用","漏洞","补丁","https://securityaffairs.com/204085/security/drupal-warns-of-new-critical-flaw-exploited-in-the-wild.html","Security Affairs",{"_101":102,"_103":-5},"changelogVersion","2026-10-01T08:00","release"]
