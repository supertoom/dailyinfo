[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794530495000,"id","ypx62331gctoid8ehzgucploz","title","Hono `css` helper 存在 HTML 注入漏洞，模板与插值值拆分闭合标签可绕过转义","originalTitle","Hono: `css` helper does not escape a closing tag split between the template and an interpolated value, allowing HTML injection","summary","Hono `hono/css` 的 `css` helper 未正确处理模板与插值值拆分形成的闭合标签，客户端可注入 HTML 及 script。仅当 `<` 是模板或前置值的最后一个字符，且紧随不可信插值时受影响，可能导致用户浏览器执行攻击者脚本或泄露页面信息。可通过禁止向 `css` 模板插值不可信值，或确保插值前文本不以 `<` 结尾来规避。","reason","source",{"_70":80},"links",{"_59":79},"publishedAt","2026-11-12T23:22:36.000Z","discoveredAt","2026-11-12T23:39:24.421Z","timelineAt","category","vuln","tags",[77,78],"score",38,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","f0-GuXaQwQBg","reportCount",1,"additionalSourceCount",0,{"_68":30,"_70":72},{"_68":69,"_70":71},"slug","research","name","技术研究","漏洞披露",{"_74":75,"_13":76},"publicId","b06bf4d3-d7e2-4c89-95da-4c0c79197e61","Hono CSS辅助函数曝HTML注入漏洞","漏洞","漏洞分析","https://github.com/advisories/GHSA-3gg2-335m-rxc6","GitHub 安全公告",{"_82":83,"_84":-5},"changelogVersion","2026-10-01T08:00","release"]
