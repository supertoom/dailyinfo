[{"_1":2,"_3":4},"root",{"_5":114},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1793672470000,"id","yh480fqelqmjotur5820knfxw","title","被盗 K-12 学区员工账户正被用于跨学区钓鱼与欺诈","originalTitle","Stolen staff logins are spreading attacks between K-12 school districts","summary","MS-ISAC 在上一学年发现，6,116 个 K-12 成员中有 808 个机构的员工账户或凭据流入地下及暗网市场，攻击者利用合法账户跨学区投递钓鱼邮件、冒充学区负责人实施欺诈。","reason","材料量化了 K-12 学区账户接管、跨学区钓鱼和恶意软件感染，并给出资源约束下的 MFA、凭据监控与演练建议。","source",{"_76":113},"links",{"_105":112},"publishedAt","2026-10-29T05:00:01.000Z","discoveredAt","2026-10-29T06:32:39.741Z","timelineAt","category","activity","tags",[77,109,110,111,79],"score",70,"selected",true,"channel","news","story",{"_89":90,"_13":91},"x","readingMode","full","author","Mirko Zorz","body",{"_61":104,"_105":-5,"_106":107,"_108":37},"outline",[92,93,94],"relatedStories",[88],"topics",[68,69,70,71,72,73],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fPIvpBZNu_Eo","reportCount",1,"additionalSourceCount",0,{"_74":86,"_76":87},{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","attack","name","攻击活动","incident","应急响应","black-market","数据窃取与黑产","ransomware","勒索软件","email","邮件与钓鱼","identity","身份与访问",{"_89":90,"_13":91},"publicId","f20b4090-633d-442f-a8ec-228e6e205e76","被盗账号被用于跨学区钓鱼欺诈",{"_11":102,"_96":103,"_98":99},{"_11":100,"_96":101,"_98":99},{"_11":95,"_96":97,"_98":99},"sec-3","text","已做好拦截准备，但恢复准备不足","level",3,"sec-2","每个学区只有一两个人","sec-1","攻击者从人开始","<p>上个学年，808 个 K-12 学校组织收到了一个 unwelcome 的消息。多州信息共享与分析中心（MS-ISAC）告知他们，其员工账户或凭据正在地下网络和暗网市场上流通。该中心的 6,116 个 K-12 成员中有 808 个出现了这种情况，而攻击者正利用这些登录凭据先进入大门，随后再触达下一个学区。</p><p><img src=\"/dailyinfo/media/f16f6d81f4b66ef6.webp\" loading=\"lazy\" decoding=\"async\" alt=\"K-12 cybersecurity\" title=\"Cybersecurity\"></p><p>在 MS-ISAC 跟踪的案例中，攻击者对一个合法学区账户进行网络钓鱼，然后利用该账户<a href=\"https://www.helpnetsecurity.com/2026/10/22/legitimate-platforms-abused-phishing-emails/\">发送网络钓鱼</a>邮件给该账户的联系人，包括其他学区的员工。这些邮件通过经过身份验证的电子邮件路径从真实账户发出，从而削弱了学校所依赖的过滤机制。运营 MS-ISAC 的互联网安全中心（CIS）将这种手法称为账户接管跳转（account takeover hopping），并高度确信这一手法将在本学年持续。攻击者还曾冒充从被劫持的 K-12 账户发出的学监，以实施欺诈。</p><h3 id=\"sec-1\">攻击者从人开始</h3><p>“无论是鱼叉式网络钓鱼、电话还是群发邮件，人都有好奇心，而且我相信人天生就想提供帮助。罪犯就是罪犯，通常会选择阻力最小的路径，并利用人的情绪。我们知道，只需攻破一个账户，就足以向利润更丰厚的目标推进。”加州（CA）圣华金县教育局网络安全与数字隐私主任<a href=\"https://www.linkedin.com/in/roykpark/\">Roy Park</a>说。</p><p>恶意软件也会通过浏览器触及员工。在 K-12 成员中最常看到的十个恶意软件家族所引发的 1,796 起感染中，有 1,159 起（约 65%）可追溯到合法网站上的恶意广告。分析人员还记录了 285 起 <a href=\"https://www.helpnetsecurity.com/2026/10/20/exploitation-siemens-software-center-vulnerability-cve-2026-110936/\">ClickFix</a> 事件，这是一种诱导用户自行运行恶意命令的诱饵。围绕可疑邮件开展的培训，会漏掉一位在阅读新闻时感染恶意软件的教师。</p><h3 id=\"sec-2\">每个学区只有一两个人</h3><p>CIS 和 MS-ISAC 于 8 月和 9 月<a href=\"https://learn.cisecurity.org/state-k-12-cybersecurity-report-2026\">调查</a>了 426 名学校 IT 和安全从业人员。66% 的人员只有一两个人负责网络安全，11% 没有专职安全人员。70% 因预算限制而推迟了安全项目、采购或招聘。87% 将网络钓鱼或电子邮件账户失陷列为最常见的安全事件。</p><h3 id=\"sec-3\">已做好拦截准备，但恢复准备不足</h3><p>受访学区中有 83% 部署了 MFA，也有相同比例的学区会过滤邮件，而只有 59% 制定了事件响应计划。15% 会定期开展事件响应演练，9% 称其安全战略已落实到位。</p><p>MS-ISAC 的安全运营中心分析了 2,707 起恶意活动到达学校管理的笔记本电脑、Chromebook、台式机或服务器的事件。其中有 1,711 起（约 63%）中，攻击者试图避免被发现，最常见的方式是禁用或修改安全工具，在 881 起案例中发现了这种情况。两人团队应当把突然安静下来的安全控制台视为需要检查的异常情况。</p><p>受访学区中有 51% 在过去 12 个月内发生过网络安全事件。22% 报告称课堂教学受到影响，2% 报告称学校停课。</p><p>“学校每天都在努力提升网络安全，往往依靠小团队和非常有限的资源。但它们所处的环境正在迅速变化，尤其是 AI 正在重塑 K-12 社区所面临的机会和风险。那些投资于网络韧性、确保网络事件不会扩大为全社区危机的学校和学区，将在未来处于最有利的地位，”互联网安全中心安全运营与情报副总裁 <a href=\"https://www.linkedin.com/in/randyrose/\">Randy Rose</a> 表示。</p><p>CIS 建议学区技术负责人扩大 MFA 的使用范围，监控凭据暴露情况，审查特权账户，并每年至少开展一次 <a href=\"https://www.helpnetsecurity.com/2025/03/17/review-cybersecurity-tabletop-exercises/\">桌面推演</a>和一次有管理层参与的运营响应演练。对于各州，它建议持续拨款，用于学区可以调用的共享监控和事件响应服务。</p>","original","zhKind","translation","complete","钓鱼","数据窃取","凭据","https://www.helpnetsecurity.com/2026/10/29/cis-k-12-cybersecurity/","Help Net Security",{"_115":116,"_117":-5},"changelogVersion","2026-10-01T08:00","release"]
