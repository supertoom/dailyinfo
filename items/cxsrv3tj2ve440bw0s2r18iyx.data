[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1795221631000,"id","cxsrv3tj2ve440bw0s2r18iyx","title","PHP 修复 7 个严重级 RCE 漏洞，发布 PHP 8.6.0 与 8.5.13","originalTitle","PHP Patches Seven Critical RCE Vulnerabilities","summary","PHP 发布安全更新，修复 7 个严重级远程代码执行（RCE）漏洞，包括会话上传进度反序列化、多个 use-after-free、PHP-FPM 请求走私和时区缓存释放后使用问题。","reason","文章梳理了 7 个严重级 RCE 漏洞的触发条件、受影响版本与补丁覆盖情况，并区分已证实和尚未演示的执行路径。","source",{"_63":77},"links",{"_68":76},"publishedAt","2026-11-19T15:54:20.000Z","discoveredAt","2026-11-19T16:27:19.236Z","timelineAt","category","vuln","tags",[72,73,74,75],"score",85,"selected",true,"channel","news","story","x","readingMode","full","author","Ionut Arghire","body",{"_59":67,"_68":-5,"_69":70,"_71":37},"outline",[],"relatedStories",[],"topics",[60,61],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_62":65,"_63":66},{"_62":31,"_63":64},"slug","name","漏洞披露","supply-chain","供应链安全","<p><strong>PHP 周四按照其四周更新计划发布了一批新的安全补丁，其中包括针对七个严重级别远程代码执行（RCE）漏洞的修复。</strong>\n\n\n\n</p><p>首个漏洞是 <a href=\"https://github.com/php/php-src/security/advisories/GHSA-658j-r8rw-q6mx\">CVE-2026-115560</a>，该漏洞于上个月公开披露，时间比 <a href=\"https://www.securityweek.com/topics/php2shell/\">PHP2Shell</a> 补丁发布晚两天。它存在于会话上传进度功能中，攻击者可利用一种会话序列化格式写入攻击者数据，随后再使用另一种格式读取这些数据。\n\n\n\n</p><p>PHP 公告称：“不匹配的解码器可能会将部分会话密钥解释为序列化对象数据。拥有合适对象 gadget chain 的应用程序随后便能以 PHP worker 的权限执行代码。”\n\n\n\n</p><p>下一个漏洞是 <a href=\"https://github.com/php/php-src/security/advisories/GHSA-g3vh-838c-65v7\">CVE-2026-129481</a>，被描述为会话关闭被中断后发生的释放后使用（use-after-free）。PHP 称，这是对 CVE-2026-109619 的不完整修复；后者是十月修复的两个 PHP2Shell 漏洞之一，目前已被广泛利用。\n\n\n\n</p><p>PHP 提醒称：“攻击者如果能够以这种方式导致应用程序的会话清理失败，就可能破坏内存或使被重用的 PHP worker 崩溃。该释放后使用漏洞可能导致远程代码执行，但尚未展示通过这一特定字段实现代码执行。”并补充说明，PHP 8.2 不受影响。\n\n\n\n</p><p>另一个释放后使用漏洞 <a href=\"https://github.com/php/php-src/security/advisories/GHSA-2fjv-p558-g82m\">CVE-2026-129182</a> 涵盖了利用过期全局状态针对 CVE-2026-109619 实施 RCE 的更多攻击场景。不过据 PHP 表示，尚未展示通过这些场景实现 RCE。</p><p><span>广告。继续滚动阅读。</span></p><p>该漏洞影响 PHP 8.5 及更高版本。<a href=\"https://github.com/php/php-src/security/advisories/GHSA-8mjj-2r7p-4hg2\">CVE-2026-129474</a> 是一个释放后使用漏洞，可能允许未认证攻击者触发致命错误并实现 RCE。PHP 表示：“利用取决于具体应用程序，并要求攻击者能够控制足够多的请求数据，以影响内存分配、触发可访问的魔术方法调用，并在相关位置引发致命错误。”\n\n\n\n</p><p>攻击者如果能够影响会话内容，并中断向会话文件写入序列化数据的过程，就可能在下次打开会话时触发对攻击者所控内容的反序列化。该漏洞编号为 <a href=\"https://github.com/php/php-src/security/advisories/GHSA-fm2m-fjf5-v3cp\">CVE-2026-126714</a>，可能通过应用程序中合适的对象 gadget chain 导致 RCE。\n\n\n\n</p><p>PHP 还修复了 <a href=\"https://github.com/php/php-src/security/advisories/GHSA-qc49-hpvq-g2w6\">CVE-2026-129289</a>。这是一个 PHP-FPM 请求走私问题，源于 PHP 以惰性方式读取请求体流，将请求体视为已在请求关闭期间得到处理，并跳过用于丢弃未读输入的常规清理流程。\n\n\n\n</p><p>PHP 解释道：“在重用持久 PHP-FPM 或 LSAPI 连接之前，PHP 可能未能丢弃 HTTP 请求体中未读取的字节。在 PHP-FPM 中，未认证攻击者可以使这些字节构成一个独立的 FastCGI 请求，从而绕过前端路由，并以 worker 的权限执行攻击者控制的 PHP 代码。”\n\n\n\n</p><p>今天修复的第七个严重级别漏洞 <a href=\"https://github.com/php/php-src/security/advisories/GHSA-gr4f-wgx5-jpfv\">CVE-2026-129496</a> 存在于时区缓存中。PHP 在进程启动期间向 PHP 错误日志文件写入诊断信息时，可能会保留对时区缓存的引用；之后的一条诊断信息可能会在缓存重置前访问已释放的缓存。\n\n\n\n</p><p>PHP 解释道：“在受影响的配置中，远程攻击者可以触发内存损坏、导致 worker 崩溃，并可能以 PHP worker 的权限执行任意代码。”\n\n\n\n</p><p>PHP 8.6.0 和 PHP 8.5.13 已发布，修复了所有严重漏洞以及 10 个高危和中危漏洞。多数问题的补丁也已包含在 PHP 8.4.28、PHP 8.3.37 和 PHP 8.2.36 中。更多信息可在 PHP 的<a href=\"https://www.php.net/archive/2026.php#2026-11-19-5\">新闻归档</a>页面获取。\n\n\n\n</p><p><strong>相关：</strong><a href=\"https://www.securityweek.com/php-readies-critical-security-updates-to-patch-another-rce-flaw/\">PHP 准备关键安全更新，以修补另一个 RCE 漏洞</a>\n\n\n\n</p><p><strong>相关：</strong><a href=\"https://www.securityweek.com/hackers-exploit-cisco-expressway-vulnerability-soon-after-poc-release/\">黑客在 PoC 发布后不久即利用 Cisco Expressway 漏洞</a>\n\n\n\n</p><p><strong>相关：</strong><a href=\"https://www.securityweek.com/critical-apache-roller-axis-vulnerabilities-exploited-in-attacks/\">Apache Roller 和 Axis 的严重漏洞已在攻击中被利用</a>\n\n\n\n</p><p><strong>相关：</strong><a href=\"https://www.securityweek.com/splunk-patches-nearly-140-flaws-across-three-core-products/\">Splunk 修补三大核心产品中近 140 个漏洞</a>\n\n\n\n</p>","original","zhKind","translation","complete","补丁","漏洞","供应链","PHP","https://www.securityweek.com/php-patches-seven-critical-rce-vulnerabilities/","SecurityWeek",{"_79":80,"_81":-5},"changelogVersion","2026-10-01T08:00","release"]
