[{"_1":2,"_3":4},"root",{"_5":92},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1795912840000,"id","kfvyqs51ezpiyu7h7efgz0fzy","title","InfraTrust 报告基础设施产品供应链漏洞在野利用情况","originalTitle","InfraTrust warns of exploited supply chain flaws in network appliances","summary","Eclypsium 11 月 InfraTrust 报告称，10 月 15 日至 11 月 19 日发布的 373 条公告覆盖 3,880 个漏洞，其中 38 条涉及 CISA KEV 漏洞，33 条实际来自 PHP、Node.js、OpenSSH 等第三方捆绑组件。","reason","报告汇总基础设施产品中的在野利用，并指出上游组件修复到厂商产品重建之间存在处置窗口，便于评估补丁优先级与暴露风险。","source",{"_67":91},"links",{"_84":90},"publishedAt","2026-11-25T15:00:00.000Z","discoveredAt","2026-11-25T15:21:33.893Z","timelineAt","category","activity","tags",[70,72,88,74,89],"score",77,"selected",true,"channel","news","story","x","readingMode","full","author","Lawrence Abrams","body",{"_59":83,"_84":-5,"_85":86,"_87":37},"outline",[77],"relatedStories",[],"topics",[60,61,62,63,64],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_65":75,"_67":76},{"_65":73,"_67":74},{"_65":71,"_67":72},{"_65":69,"_67":70},{"_65":66,"_67":68},"slug","blue-team","name","蓝队与运营","attack","攻击活动","exploited","在野利用","vuln-mgmt","漏洞管理","supply-chain","供应链安全",{"_11":78,"_79":80,"_81":82},"sec-1","text","发现您现有的防御体系可能遗漏的邮件威胁。","level",2,"<p><img alt=\"InfraTrust\" height=\"900\" src=\"/dailyinfo/media/67734d7b1f8f077e.jpg\" srcset=\"/dailyinfo/media/48c450604806ed61.jpg 720w, /dailyinfo/media/0707c12f49361555.jpg 1200w, /dailyinfo/media/67734d7b1f8f077e.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>Eclypsium 的 11 月 InfraTrust 报告警告称，过去一个月中涉及已被利用漏洞的大多数基础设施安全公告，针对的是捆绑进产品的第三方软件中的缺陷，而不是供应商自行开发的代码。</p><p><a href=\"https://pulse.infra-trust.org/november-2026/\">11 月 InfraTrust Pulse 报告</a>追踪了 23 家基础设施供应商在 10 月 15 日至 11 月 19 日期间发布的 373 条新安全公告，涵盖 3,880 个漏洞。</p><p>这些公告中有 98 条被评为严重（critical），其中 38 条包含的漏洞被列在 CISA 的已知被利用漏洞（KEV）目录中。</p><p><a href=\"https://www.wiz.io/lp/claude-code-security-best-practices-cheat-sheet?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q3_INB_FORM_Claude-Code-Security-Best-Practices&amp;sfcid=701Vh00000gJQZuIAO&amp;utm_term=FY27Q4-bleepingcomputer-article-970x250-Nov&amp;utm_content=Claude-Code-Best-Practices\"><img src=\"/dailyinfo/media/7a5a3a6292d5f413.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>然而，这 38 条公告中有 33 条修复的是捆绑软件组件中已被利用的缺陷，主要涉及 PHP、Node.js 和 OpenSSH。</p><p>这些漏洞对企业带来了额外风险，因为即便软件开发者发布了安全修复，组织也必须等待基础设施供应商将其整合进自家产品。</p><p>报告原文写道：\"你对被利用缺陷的暴露程度，取决于各供应商在上游修复发布后重新构建其产品的速度。\"</p><p>一个例子是<a href=\"https://www.bleepingcomputer.com/news/security/php-ships-emergency-patches-for-critical-php2shell-flaws/\">PHP2Shell</a>（CVE-2026-109618 和 CVE-2026-109619）这一对 PHP 漏洞，<a href=\"https://www.bleepingcomputer.com/news/security/infratrust-report-warns-of-exploited-flaws-in-critical-network-infrastructure/\">上月的 InfraTrust 报告</a>对此作了重点提及；目前它们正被用于针对 Palo Alto Networks 和 Check Point 防火墙的攻击。</p><p>在两种情况下，威胁行为者都将这些 PHP 漏洞与其他缺陷串联利用，以获取受影响设备的 root 权限；Check Point 报告称发生了破坏性攻击，<a href=\"https://www.bleepingcomputer.com/news/security/check-point-gateways-hacked-via-php2shell-to-deploy-vmware-esxi-wiper/\">在 VMware ESXi 主机上部署了清除数据的恶意软件</a>。</p><p>截至 11 月 20 日，Fortinet、Juniper、Lenovo、HPE、Netgear、HP 和 Siemens 相关产品的 PHP2Shell 修复要么仅部分可用，要么尚未发布。</p><p>11 月 19 日发布的另外 18 条 PHP 安全公告，进一步使基础设施供应商及其客户的修补工作复杂化。</p><p>随着管理员需要处理的基础设施漏洞数量不断增加，InfraTrust 表示本月应优先修补以下缺陷：</p><ul>\n\t<li><strong>Cisco Expressway：</strong>CVE-2026-76466，一个于 11 月 20 日被加入 CISA KEV 目录的严重漏洞。11 月 23 日，CISA 将该缺陷标记为<a href=\"https://www.bleepingcomputer.com/news/security/cisa-flags-critical-cisco-expressway-rce-flaw-as-actively-exploited/\">正在被积极利用</a>，此前俄罗斯网络安全公司 F6 发现黑客利用它获取 root 权限。</li>\n\t<li><strong>Palo Alto Networks 和 Check Point：</strong>PHP2Shell 漏洞，以及 Check Point 网关中的 CVE-2026-123039。Check Point 警告称，该缺陷自 10 月下旬起<a href=\"https://www.bleepingcomputer.com/news/security/check-point-patches-zero-day-that-lets-hackers-get-root-access/\">正被积极利用以获取 root 权限</a>并在受影响设备上建立持久化。</li>\n\t<li><strong>Arista VeloCloud Orchestrator：</strong>CVE-2026-114625，一个 CVSS 评分为 9.9 的严重漏洞，已<a href=\"https://www.bleepingcomputer.com/news/security/arista-patches-new-velocloud-orchestrator-zero-day-exploited-in-attacks/\">在零日攻击中被利用</a>。</li>\n\t<li><strong>Cisco Secure Firewall ASA 和 FTD：</strong>CVE-2026-76418，影响配置为远程接入 VPN 的设备。该缺陷<a href=\"https://www.bleepingcomputer.com/news/security/cisco-warns-of-firewall-zero-day-exploited-to-crash-ssl-vpn-devices/\">在攻击中被利用以使设备崩溃</a>。</li>\n\t<li><strong>SonicWall SonicOS：</strong>CVE-2026-19868，可绕过配置为单点登录的 VPN 上的多因素身份验证。SonicWall 警告称，其收到报告称该缺陷<a href=\"https://www.bleepingcomputer.com/news/security/sonicwall-warns-of-new-ssl-vpn-mfa-bypass-flaw-exploited-in-attacks/\">已在零日攻击中被利用</a>。</li>\n</ul><p>管理员还应优先安装 Fortinet 于 10 月发布的加固更新，其中修复了利用 AI 模型发现的多项漏洞。</p><p>随着 AI 让漏洞的发现和利用变得更加容易，InfraTrust 警告称，各组织在等待厂商发布安全更新期间，必须采取额外措施保护其设备。</p><p>这些措施包括从互联网中移除管理接口、在内部对它们进行分段以限制横向移动，以及调查此前暴露的设备中可能仍存在后门的情况——即使安装了安全更新，这些后门仍可能存在。</p><p>“打补丁只是基本要求，但在补丁可用之前你采取的措施，以及在利用攻击命中之后你采取的措施，将决定你能否生存下来。”报告总结道。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/1f6f9d6dc9ced8f5.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现您现有的防御体系可能遗漏的邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 代理会分析邮件意图、上下文和行为，以发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>通过 14 天只读扫描 Microsoft 365 或 Google Workspace，看看有哪些威胁正在绕过防御，且无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始您的免费邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","供应链","加固","https://www.bleepingcomputer.com/news/security/infratrust-warns-of-exploited-supply-chain-flaws-in-network-appliances/","BleepingComputer",{"_93":94,"_95":-5},"changelogVersion","2026-10-01T08:00","release"]
