[{"_1":2,"_3":4},"root",{"_5":107},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794357645000,"id","xjtk4qapk0fz040tt5c9vm102","title","WordPress CVE-2026-119977 已在野利用，安装修复时仍可能再次被攻破","originalTitle","Installing the Fix for an Exploited WordPress Flaw Can Expose Some Sites One Last Time","summary","WordPress CVE-2026-119977 已被确认在野利用，但安装 7.1.4 修复版本时，部分站点仍会因旧版更新器使用可预测的 wp-content/upgrade 目录名而再次暴露安装器。","reason","文章拆解了补丁安装期间的二次暴露窗口、触发条件与完整利用链，并给出可落地的目录拦截和手动更新方案。","source",{"_73":106},"links",{"_98":105},"publishedAt","2026-11-06T16:08:38.000Z","discoveredAt","2026-11-07T00:52:29.686Z","timelineAt","category","vuln","tags",[102,74,103,104,77],"score",78,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_61":97,"_98":-5,"_99":100,"_101":37},"outline",[82,83,84,85],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fRxRGARVGQp4","reportCount",1,"additionalSourceCount",0,{"_71":76,"_73":77},{"_71":31,"_73":75},{"_71":72,"_73":74},"slug","exploited","name","在野利用","漏洞披露","cisa","CISA",{"_79":80,"_13":81},"publicId","1219bb0c-7c46-49ac-8b88-3829783c0451","WordPress RCE漏洞已遭在野利用",{"_11":95,"_87":96,"_89":90},{"_11":93,"_87":94,"_89":90},{"_11":91,"_87":92,"_89":90},{"_11":86,"_87":88,"_89":90},"sec-4","text","更新","level",3,"sec-3","攻击及检查事项","sec-2","更新前应采取的措施","sec-1","更新期间谁会受到暴露","<p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEg4gwg9bgmxLj_anXtQvOZdeKYWN-aAZxZqlOrI7wXwZ_qW_lUZrzwYufexnbDLcC20eXBkh7TgA-dAQHm6EEmEc80i9A6GOBGkiOb8NhcR1d1CFLKDLc7VJzyC4Bv-5Ye2AEE_ApPcKmAWqJJFfbQ2AOGffKhCPNznyYyz5s0Jro-mxcTxfxPoqRe-ZoY/s1600/wp-update.jpg\"><img alt=\"\" src=\"/dailyinfo/media/663d72c65f1da90b.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>据发现该漏洞的 Picus Security 研究员 Umut Bayram 表示，一些 WordPress 网站在安装正在被积极利用的漏洞修复程序期间，仍可能遭到攻击。</p><p>安装修复程序的更新仍会使用网站旧的、未打补丁的代码来解包其文件，因此攻击者若选对时机，便可在服务器上运行代码。该研究员建议，在更新前阻止网站访问 <b>wp-content/upgrade</b> 文件夹。</p><p>该漏洞的跟踪编号为 <strong><a href=\"https://thehackernews.com/2026/11/cisa-confirms-hackers-exploiting.html\">CVE-2026-119977</a></strong>，影响 WordPress 4.7 至 7.1.3。在使用完整软件包进行核心更新时，WordPress 会将新版本的副本解包到 <b>wp-content/upgrade</b> 内的临时文件夹中。该副本包含 WordPress 安装程序，通常可通过 Web 服务器访问。</p><p>没有账户的攻击者只要能够确定该文件夹的名称，并在 WordPress 删除该副本之前访问安装程序，就可能最终在服务器上运行代码。美国网络安全和基础设施安全局（CISA）于本周早些时候将该漏洞加入其已知遭利用漏洞目录。</p><p>WordPress 上周在 7.1.4 版本中发布了修复程序，同时也为可追溯至 4.7 的较旧分支发布了相应的更新，全部列于其 <a href=\"https://github.com/WordPress/wordpress-develop/security/advisories/GHSA-4w3m-c66w-69mg\">安全公告</a>中。</p><p>修复程序会为临时文件夹指定随机名称。但正如 WordPress 的<a href=\"https://github.com/WordPress/wordpress-develop/blob/7.1.3/src/wp-admin/includes/class-core-upgrader.php\">更新程序代码</a>所示，安装该修复程序的更新仍会使用网站上已有的旧代码来解包其文件。在运行 5.9 或更高版本的网站上，该旧代码会根据下载文件的名称为文件夹命名，因此最后一次仍有可能预测出该名称。</p><p>在修复之前，攻击者可以利用安装程序在临时副本中写入新的配置文件 <b>wp-config.php</b>。随后，更新会用该文件覆盖网站真正的配置文件。修复程序中阻止此操作的部分，在安装修复程序的那次更新期间就已生效，因为 WordPress 会使用新代码将文件复制到位。</p><p>Bayram 在其<a href=\"https://www.picussecurity.com/resource/blog/cve-2026-119977-when-updating-wordpress-becomes-the-vulnerability\">技术报告</a>中表示，攻击者若能抓住该次更新期间的时机，仍可使用自己的数据库配置临时副本中的 WordPress、登录该副本，并在副本被删除之前以 Web 服务器的权限运行 PHP 代码。此后，攻击者便能读取或写入在线 WordPress 网站中的文件。</p><h3 id=\"sec-1\">更新期间谁会受到暴露</h3><p>该研究员表示，并非每次更新都会暴露安装程序。完整软件包始终包含安装程序文件。专为某一个特定起始版本构建的小型部分软件包，只有在恰好包含这些安装程序文件时才会暴露网站。</p><p>在允许自动后台更新的网站上，WordPress 会通过同一个更新程序并按照相同的步骤自动安装修复程序。</p><p>The Hacker News 今日检查了 WordPress.org 的更新服务，涉及多个版本。对于同一分支内的更新，例如从 7.1.3 更新至 7.1.4，该服务会提供部分软件包，自动更新也不例外。对于从较旧分支升级，例如从 7.0.7 更新至 7.1.4，则只会提供完整软件包。</p><p>在 4.4 至 5.8 版本中，旧代码会在文件夹名称中添加随机字符。除非网站通过其他方式泄露该名称，例如出现在错误消息中，否则该名称会被隐藏，该研究员表示。</p><p>安装 7.1.4 或相应分支修复程序后，后续更新将使用随机文件夹名称，且临时副本中的 <b>wp-config.php</b> 文件绝不会被复制到真实文件上。</p><h3 id=\"sec-2\">更新前应采取的措施</h3><p>研究人员的第一项建议是彻底阻止 Web 服务器提供&nbsp;wp-content/upgrade&nbsp;目录。他说，WordPress 直接在磁盘上使用该文件夹，因此阻止 Web 访问不会影响更新。</p><ol>\n  <li>在 Web 服务器配置中屏蔽该文件夹。在 Nginx 上，添加&nbsp;location ^~ /wp-content/upgrade/ { deny all; }。在 Apache 上，在虚拟主机配置中针对该文件夹的&nbsp;&lt;Directory&gt;&nbsp;块内添加&nbsp;Require all denied&nbsp;。</li>\n  <li>如果你只能编辑 .htaccess，请在 WordPress 根目录的 .htaccess 文件中、位于 WordPress 重写规则之上，添加&nbsp;RedirectMatch 403 ^/wp-content/upgrade/&nbsp;。</li>\n  <li>不要在&nbsp;wp-content/upgrade&nbsp;目录本身内放置 .htaccess 文件。旧的更新程序会在解压更新之前删除该文件夹中的所有内容，因此需要该文件时它已经不存在了。</li>\n  <li>确认对&nbsp;/wp-content/upgrade/&nbsp;的请求返回 403 错误。</li>\n  <li>更新到 7.1.4 或你所在分支的修复版本。</li>\n</ol><p>他说，另一条安全的途径是在 Web 根目录（即 Web 服务器提供的文件夹）之外手动更新。备份站点文件和数据库，将新版本解压到 Web 服务器不提供的文件夹中，把核心文件复制到相应位置，同时不要改动&nbsp;wp-config.php&nbsp;或&nbsp;wp-content，然后运行 WordPress 数据库更新。这样一来，Web 可访问的文件夹中就绝不会生成临时安装程序。</p><p>WP-CLI 的&nbsp;wp core update&nbsp;命令不能替代这一做法，因为它运行的是同一个更新程序，并将软件包解压到同一个文件夹中。</p><p>WordPress 4.6 及更早版本不再接收安全更新，因此没有针对它们的修复。研究人员称，该缺陷可追溯到 2008 年发布的 WordPress 2.7，这些站点应迁移到受支持的版本。</p><h3 id=\"sec-3\">攻击及检查事项</h3><p>CISA 本周早些时候新增该条目时，依据的是存在主动利用活动的证据，但该机构没有描述这些攻击。</p><p>分配该 CVE 标识符的 WordPress 安全公司 Wordfence 称，在发布当天部署针对该缺陷的防火墙规则后九分钟，就发现了&nbsp;<a href=\"https://thehackernews.com/2026/10/wordpress-rce-flaw-draws-nearly-63000.html\">攻击尝试</a>。两个最为活跃的攻击来源持续对小型网站群进行检查约 14.5 小时；该公司在其&nbsp;<a href=\"https://www.wordfence.com/blog/2026/10/wordpress-7-1-4-security-release-rce/\">攻击分析</a>中表示，这与试图捕捉网站更新时机的尝试相符。</p><p>它在该漏洞的&nbsp;<a href=\"https://www.cve.org/CVERecord?id=CVE-2026-119977\">CVE 记录</a>中给出的评分为 CVSS 量表上的 10 分制 8.1 分。在其实验室测试中，该时间窗口仅持续数秒。WordPress 自己的公告将该缺陷评为低危。</p><p>自本周早些时候以来，其作者称为该漏洞利用程序的代码已出现在公开的 GitHub 仓库中。其中一个称，其代码也可在完整软件包更新期间仍使用可预测文件夹的网站上运行。该代码是否有效尚未得到确认。</p><p>对于发布后仍留在受影响版本上的网站，Wordfence 建议检查：</p><ul>\n  <li>对&nbsp;wp-content/upgrade&nbsp;下 PHP 文件的异常请求</li>\n  <li>无人认识的管理员账户</li>\n  <li>无人安装的插件</li>\n  <li>位于&nbsp;wp-content/upgrade&nbsp;中且并非由任何人放入的 PHP 文件</li>\n</ul><h3 id=\"sec-4\">更新</h3><p>Bayram 于 11 月 6 日告诉 The Hacker News，部分更新是否会暴露取决于该特定软件包包含哪些内容。部分软件包只包含两个版本之间发生变化的文件。如果其中不包含安装程序文件，那么临时副本就无法作为 WordPress 安装运行，安装程序也就永远不会被访问到。</p><p>当存在部分更新包时，网站也不一定会获得部分更新包。如果网站的核心文件与官方校验和不匹配，或者此次更新属于重新安装，WordPress 会回退到完整更新包。</p><p>研究人员表示，决定性因素“并不是部分更新还是完整更新，而是该网站已经安装的更新程序是否已被修复。”</p><p>觉得这篇文章有意思？欢迎关注我们的 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a>，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","漏洞","补丁","利用链","https://thehackernews.com/2026/11/installing-fix-for-exploited-wordpress.html","The Hacker News",{"_108":109,"_110":-5},"changelogVersion","2026-10-01T08:00","release"]
