[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":-5,"_57":36,"_58":59},"expiresAt",1794444092000,"id","d3454t8wh90dc8227oe9045iw","title","Zoom Workplace for Windows 修复 CVE-2026-108186 与 CVE-2026-108187 权限提升漏洞","originalTitle","Critical Zoom Workplace Flaw Could Allow Unauthenticated Remote Privilege Escalation","summary","Zoom 发布安全更新，修复 Windows 版 Zoom Workplace 的两个漏洞。CVE-2026-108186 的 CVSS 分数为 9.6，影响 7.1.0 至 7.1.8 之前版本；CVE-2026-108187 的 CVSS 分数为 8.1，影响 7.1.5 之前版本。未认证远程攻击者可通过网络利用漏洞实现权限提升，Zoom 未提及这些漏洞已在野利用，建议用户安装最新补丁。","reason","source",{"_62":72},"links",{"_59":71},"publishedAt","2026-11-11T16:12:46.000Z","discoveredAt","2026-11-11T17:50:07.914Z","timelineAt","category","vuln","tags",[68,69,70],"score",61,"selected",false,"channel","news","story","x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_64":-5,"_59":65,"_66":-5,"_67":36},"outline",[],"relatedStories",[],"topics",[60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":30,"_62":63},"slug","name","漏洞披露","zh","<p><span><i></i><span>Ravie Lakshmanan</span><i></i><span>Nov 11, 2026</span></span><span>Vulnerability / Software Security</span></p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhox0GUms6IXvet2jPVoQ5VlUIZ_V7C3iT4HI3qV-Pi7_KRybDyGKGlb2S0Z4uvih4ERjjnGOn9Prav0HpvqNNR3_HVs7W5o0wM0-XsTdp6ploM2Optp5ls97C0JU5DIqubY-lNcLvLia25Z2c__IZt8Ws1OjX0tGavbyvb_dXrltSKj-HJHijQJ9AdDxEB/s1600/zoom-prv.jpg\"><img alt=\"\" src=\"/dailyinfo/media/0117e16ec90258e8.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>Zoom has released software updates to address two security flaws impacting Zoom Workplace for Windows, including a critical bug that could result in privilege escalation on affected systems.</p><p>The vulnerabilities are listed below -</p><ul>\n  <li><strong><a href=\"https://www.zoom.com/en/trust/security-bulletin/zsb-26023/\">CVE-2026-108186</a></strong> (CVSS score: 9.6) - An improper input validation vulnerability that could allow an unauthenticated user to conduct an escalation of privilege via network access.</li>\n  <li><strong><a href=\"https://www.zoom.com/en/trust/security-bulletin/zsb-26024/\">CVE-2026-108187</a></strong> (CVSS score: 8.1) - An origin validation vulnerability that could allow an unauthenticated user to conduct an escalation of privilege via network access.</li>\n</ul><p>Successful exploitation of either of the shortcomings could permit remote attackers to escalate privileges without requiring any special permissions or access.</p><p>While CVE-2026-108187 affects Zoom Workplace for Windows before version 7.1.5, CVE-2026-108186 impacts versions starting from 7.1.0 and before 7.1.8.</p><p>Earlier this July, the popular videoconferencing platform shipped fixes for another improper input validation flaw impacting Zoom Workplace for Windows (<a href=\"https://thehackernews.com/2026/07/zoom-patches-critical-windows-flaw-that.html\">CVE-2026-53412</a>, CVSS score: 9.8) that could enable an unauthenticated user to take control of accounts.</p><p>Although Zoom makes no mention of the vulnerabilities being exploited in the wild, users are advised to apply the latest patches to mitigate potential threats.</p><p>Found this article interesting?  Follow us on <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>, <a href=\"https://twitter.com/thehackersnews\">Twitter</a> and <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a> to read more exclusive content we post.</p>","zhKind","complete","漏洞","补丁","Microsoft","https://thehackernews.com/2026/11/critical-zoom-workplace-flaw-could.html","The Hacker News",{"_74":75,"_76":-5},"changelogVersion","2026-10-01T08:00","release"]
