[{"_1":2,"_3":4},"root",{"_5":92},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1794271232000,"id","aza6eimfkt52zsrd63mp6skub","title","Amadeus 遭网络攻击致亚洲六大航空公司客户数据泄露","originalTitle","亚洲六大航空龙头数据泄露：因IT供应商遭入侵","summary","IT 供应商 Amadeus 遭网络攻击后，日本航空、国泰航空、大韩航空、韩亚航空、新加坡航空和马来西亚航空确认客户数据泄露。","reason","事件展示了航空预订供应链中单一系统账号被攻破后，如何连带影响多家大型航空公司的客户数据。","source",{"_73":91},"links",{"_84":90},"publishedAt","2026-11-05T16:55:15.297Z","discoveredAt","2026-11-05T17:55:15.323Z","timelineAt","category","activity","tags",[74,87,88,89],"score",77,"selected",true,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","body",{"_61":83,"_84":-5,"_85":84,"_86":37},"outline",[],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fOeP-hsp0GGc","reportCount",1,"additionalSourceCount",0,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","attack","name","攻击活动","identity","身份与访问","supply-chain","供应链安全",{"_80":81,"_13":82},"publicId","a7c8398e-31b8-404e-abec-89c3346873a8","Amadeus遭攻击致六家亚洲航司数据泄露","<p>\n                    由于IT供应商Amadeus发生数据泄露，亚洲多家大型航空公司的用户也受到影响，包括用户购买机票时提交的乘客姓名、证件信息、旅行行程等；香港国泰航空、日本航空、大韩航空、新加坡航空等大型航空公司纷纷发布数据泄露公告，并通知受影响用户。\n                </p><p>前情回顾·数据泄露猖獗</p><ul><li><p><a href=\"https://www.secrss.com/articles/94517\">某国全国公民身份数据全部泄露：因人口系统遭异常访问</a></p></li><li><p><a href=\"https://www.secrss.com/articles/94418\">美国防部重大数据泄露：数百万军人敏感信息被窃取</a></p></li><li><p><a href=\"https://www.secrss.com/articles/94251\">FBI疑似发生重大数据泄露，所有警员数据外泄</a></p></li><li><p><a href=\"https://www.secrss.com/articles/93802\">韩国医美平台用户敏感数据泄露，近5000名中国人受影响</a></p></li></ul><p>安全内参11月5日消息，亚洲多家航空公司陆续披露，由于西班牙IT服务商艾玛迪斯（Amadeus）近日遭到网络攻击，导致客户数据发生泄露。</p><p>过去一周，日本航空、国泰航空、大韩航空、韩亚航空、新加坡航空和马来西亚航空相继确认遭遇数据泄露。这些事件均被追溯至艾玛迪斯信息科技集团。该公司主要开发和维护航空预订、机票销售及值机平台。</p><p>艾玛迪斯的一名发言人表示，公司近期发现，一个用于展示旅行预订信息的系统存在安全漏洞。</p><p>该发言人称：“攻击者可通过这一漏洞访问部分预订信息。尽管调查仍在进行，但目前没有证据表明支付或财务数据被访问。也没有迹象显示攻击者利用该漏洞实施了勒索软件攻击。艾玛迪斯已采取措施修复漏洞，并加强监测和检测能力。目前，我们正与客户及相关主管部门直接沟通。”</p><p>对于攻击者是否联系过公司，以及此次攻击究竟影响了多少受害者，艾玛迪斯拒绝置评。</p><p>六大航空龙头发布数据泄露通告</p><p>日本航空表示，约9.2万名客户的信息被窃取；新加坡航空称，约4.6万条记录被访问；国泰航空则表示，黑客窃取了约5.3万条记录，其中包括预订编号、乘客姓名和航班信息。部分记录还包含护照及其他旅行证件信息、常旅客会员号码和电子邮箱地址。</p><p>国泰航空表示，已收到艾玛迪斯通报。通报称，攻击者在入侵过程中使用了“分配给其系统账号的登录凭证”，但未透露更多细节。新加坡航空则向路透社和彭博社表示，此次事件导致预订确认编号、旅行行程及乘客姓名等信息泄露。</p><p>新加坡航空表示，将主动联系近期有出行安排的受影响乘客，协助乘客更换已暴露的预订编号，并提醒所有客户警惕恶意邮件。</p><p>涉事航空公司均表示，针对艾玛迪斯的网络攻击没有影响各自的系统或运营。</p><p>艾玛迪斯去年营收超过65亿美元，与数百家航空公司和机场建立了合作关系，为它们提供IT服务以及机票销售和预订技术平台。</p><p>过去一年，已有数十家航空公司成为网络犯罪分子的攻击目标。2026年，西班牙航空公司伊比利亚航空和科特迪瓦航空也遭到了网络攻击。去年，黑客还从澳大利亚航空公司澳洲航空窃取了600万条客户记录。该事件最终导致公司高级管理人员被罚款数十万澳元。</p><p><strong>参考资料：bleepingcomputer.com</strong></p><p>声明：本文来自安全内参，版权归作者所有。文章内容仅代表作者独立观点，不代表安全内参立场，转载目的在于传递更多信息。如有侵权，请联系 anquanneican@163.com。</p>","original","zhKind","complete","数据泄露","供应链","凭据","https://www.secrss.com/articles/95393","安全内参",{"_93":94,"_95":-5},"changelogVersion","2026-10-01T08:00","release"]
