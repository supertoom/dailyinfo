[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1794876028000,"id","gfby4rahrtszdmlfa6ildv212","title","CCS 2026 SaTS Workshop：WebView安全的挑战、实践与未来","originalTitle","CCS 2026 | SaTS Workshop：WebView安全的挑战、实践与未来","summary","CCS 2026 SaTS Workshop 聚焦 WebView 在移动超级应用、传统内嵌页面及聊天机器人中的安全挑战，涵盖架构、权限模型、开发者与运行时责任、标准化和供应链安全。活动除4篇论文外邀请三星、Apache和 Google 专家分享实践，并于11月19日16:00 - 22:00在北京时间线上线下举行。","reason","source",{"_66":83},"links",{"_77":82},"publishedAt","2026-11-16T14:47:00.000Z","discoveredAt","2026-11-16T17:56:15.846Z","timelineAt","category","disclosure","tags",[67,69,71,80,81],"score",14,"selected",false,"channel","news","story","x","readingMode","full","author","body",{"_58":76,"_77":-5,"_78":77,"_79":54},"outline",[],"relatedStories",[],"topics",[59,60,61,62,63],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","zh",{"_64":74,"_66":75},{"_64":72,"_66":73},{"_64":70,"_66":71},{"_64":68,"_66":69},{"_64":65,"_66":67},"slug","research","name","技术研究","mobile","移动端","browser","浏览器","supply-chain","供应链安全","google","Google / 谷歌","<p><span>SaTS</span> <span>2026-11-16 22:47</span> <span>德国</span></p><p><img src=\"/dailyinfo/media/8831a93f59f064d9.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><img src=\"/dailyinfo/media/9b2de0c430b6e97d.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span>随着移动超级应用的快速发展，以微信、支付宝等为代表的移动应用已经形成了一个由WebView技术第三方WebView应用生态。由于超级应用本身的平台与用户设计大量隐私信息与日常生活与交易等核心功能，这种新兴生态在过去五年里吸引了大量攻击者与黑灰产，通过窃取用户信息、利用安全漏洞攻击第三方开发者服务等方式，对平台和用户以及开发者造成了极大影响。</span></p><p><span>由于WebView技术将传统的Web安全与移动安全紧密联系在一起，超级应用与WebView安全机制的构建急需汇集移动与网络空间安全领域的专家共识。不仅是“中国特色”的超级应用，传统的基于应用内页面和聊天机器人的WebView安全也同样适用类似的技术体系。特别是在智能体技术深度重塑开发方式的今天，学术界与业界安全研究人员的宝贵经验能够为整个领域提供宝贵的研究思路。为此，今年的第四届SaTS Workshop在论文报告以外，引入了大量业界专家分享他们在WebView领域和标准化相关工作的经验。</span></p><p><span>为此，在四篇论文以外，本次workshop还邀请了三星、Apache和谷歌的业界专家分享他们关于WebView标准化、开发者与安全配置等方面的相关经验和内容。诚邀感兴趣的同学们、老师们和同僚们参加:</span></p><p><img src=\"/dailyinfo/media/b8434932c54fd1f8.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span>特邀报告1：\"What Do Web Developers Need to Know About Security?\"</span></p><p><span>特邀专家：Daniel Appelquist, Samsung Open Source Group and Member of W3C Advisory Board</span></p><p><span>报告介绍：A knowledge gap exists regarding security for web developers. Many may assume security is not their responsibility or can be left to the runtime or browser. Yet modern supply chain security centres on “shifting left”. The W3C SWAG community group, partnered with the OpenSSF Best Practices working group, has aimed to address this gap. This talk introduces SWAG, outlines its guidelines and outputs, explains what it means for web developers, and discusses why it matters. I will also cover how web developers and runtime developers are responding to the EU Cyber Resilience Act (CRA).</span></p><p><img src=\"/dailyinfo/media/a91cbea7645950ab.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span>特邀报告2：State of WebViews - From compatibility, to security and beyond.</span></p><p><span>特邀专家：Niklas Merz</span></p><p><span>报告摘要：Niklas Merz is with Apache Foundations and is the chair of W3C Webview Community Group. In this talk, he will open with a introduction of webviews, followed with the introduction to WebView Community Group and what efforts have been done to ensure a smooth experience around webviews. Then keynote will focus on security topics around architectures, scopes, and what could be done to enhance the security of webview-enabled apps, as well as Super Apps.</span></p><p><img src=\"/dailyinfo/media/4796bd5f0413c0c8.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span>特邀报告3：Permissions: On the web, and in WebExtensions</span></p><p><span>特邀专家：Oliver Dunk (Google UK) and Balazs Engedy (Google Germany)</span></p><p><span>报告介绍：In this joint keynote, we invited experts from Google to share the experiences and insights about web extensions and permission models, including the current efforts, achievements, and future paths to build a more secure web ecosystem.</span></p><p><span>此外，今年的Workshop还将有四位来自滑铁卢大学、西蒙弗雷泽大学、华东师范大学与安徽师范大学的研究者分享他们关于小程序与超级应用安全的相关研究。</span></p><p><span>您的参与是SaTS Workshop继续承办下去的重要动力。如果您打算参加今年的CCS 2026会议，我们诚挚邀请您11月19日周四来SaTS Workshop现场聊一聊。如果您不打算参加今年的CCS会议，我们也欢迎您来我们的线上会议室。线上线下的会议和提问环节会同步进行，研讨会举办时间为北京时间16:00 - 22:00，是一个非常适合从东八区加入的时间。</span></p><p><img src=\"/dailyinfo/media/7ebfe781764a937c.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><span>具体相关信息以及参会链接欢迎访问研讨会网站<a href=\"https://superappsec.github.io/\">https://superappsec.github.io/</a></span></p><p><span>未来组委会将会继续举办SaTS研讨会，期望能够吸引更多投稿和与会者一起交流，聊一聊webview、web app、mobile app security的未来。期待您的参与，大家海牙见！</span></p><p><img src=\"/dailyinfo/media/b7532616d44647c7.webp\" loading=\"lazy\" decoding=\"async\"></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=117b129e&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzg5ODUxMzg0Ng%3D%3D%26mid%3D2247502515%26idx%3D1%26sn%3Deaa72ceb9a765f19f7d6d9b734cd8c4e\">跳转微信打开</a></p>","original","zhKind","complete","供应链","Google","https://mp.weixin.qq.com/s?__biz=Mzg5ODUxMzg0Ng==&mid=2247502515&idx=1&sn=eaa72ceb9a765f19f7d6d9b734cd8c4e","安全研究GoSSIP",{"_85":86,"_87":-5},"changelogVersion","2026-10-01T08:00","release"]
