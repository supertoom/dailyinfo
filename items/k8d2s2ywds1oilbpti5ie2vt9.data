[{"_1":2,"_3":4},"root",{"_5":116},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795567282000,"id","k8d2s2ywds1oilbpti5ie2vt9","title","Pen Test Partners 分析 RDM 制冷控制器漏洞及英国超市暴露风险","originalTitle","The fridge hack UK supermarkets narrowly avoided?","summary","Pen Test Partners 与 Omega Solutions 分析并验证 RDM 制冷控制器中的多个漏洞，揭示英国多家超市、零售商和冷链运营商存在公网暴露风险。","reason","文章还原了从控制器漏洞发现、协同披露到批量排查的处置过程，并指出离网与固件更新仍是降低风险的关键。","source",{"_73":115},"links",{"_107":114},"publishedAt","2026-11-20T00:01:00.000Z","discoveredAt","2026-11-20T00:12:20.425Z","timelineAt","category","vuln","tags",[111,112,113,77],"score",74,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","Alex Wallace","body",{"_61":106,"_107":-5,"_108":109,"_110":37},"outline",[82,83,84,85,86,87,88],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fzYYKzyHUtLM","reportCount",1,"additionalSourceCount",0,{"_71":76,"_73":77},{"_71":31,"_73":75},{"_71":72,"_73":74},"slug","research","name","技术研究","漏洞披露","incident","应急响应",{"_79":80,"_13":81},"publicId","9da91ad1-d50b-4c85-8c1c-7fbe04831783","RDM制冷控制器漏洞暴露公网风险",{"_11":104,"_90":105,"_92":93},{"_11":102,"_90":103,"_92":93},{"_11":100,"_90":101,"_92":93},{"_11":98,"_90":99,"_92":93},{"_11":96,"_90":97,"_92":93},{"_11":94,"_90":95,"_92":93},{"_11":89,"_90":91,"_92":93},"sec-7","text","紧急行动&nbsp;","level",2,"sec-6","还有更多内容&nbsp;","sec-5","与制造商 RDM 进行联络&nbsp;","sec-4","但为什么英国没有受到影响？","sec-3","我们如何帮助英国超市躲过一劫&nbsp;","sec-2","引言","sec-1","TL;DR&nbsp;","<ul>\n      <li><a href=\"https://www.pentestpartners.com/security-blog/the-fridge-hack-uk-supermarkets-narrowly-avoided/#related-services\">相关服务</a></li>\n      <li><a href=\"https://www.pentestpartners.com/security-blog/the-fridge-hack-uk-supermarkets-narrowly-avoided/#related-blogs\">相关博客</a></li>\n      \n    </ul><h2 id=\"sec-1\"><strong>TL;DR</strong>&nbsp;</h2><ul>\n<li>英国超市未像法国及其他地区那样受到 <a href=\"https://www.pentestpartners.com/security-blog/you-dont-need-a-nation-state-to-warm-up-a-fridge/\">Danfoss 事件</a>的影响，因为这里更流行的是另一家制造商的产品。&nbsp;</li>\n\n\n\n<li>这些控制器来自一家名为 RDM 的公司，存在一个相关但不完全相同的漏洞。&nbsp;</li>\n\n\n\n<li>多家超市、零售商和供应链运营商暴露在风险之中。&nbsp;</li>\n\n\n\n<li>11 月期间投入了大量工作，确保英国超市的制冷控制器从互联网上移除，或已部署在私有网络中。&nbsp;</li>\n\n\n\n<li>这些工作一直非常低调，以避免引起潜在威胁行为者的警觉。&nbsp;</li>\n</ul><h2 id=\"sec-2\"><strong>引言 </strong></h2><p>Omega Solutions 的 Neil McCourt 发现了一个重大漏洞。Pen Test Partners 的 Andrew Tierney 与 Neil 合作验证其发现，并在过程中发现了若干额外漏洞。&nbsp;</p><p>Pen Test Partners、Omega Solutions、NCSC、RDM、British Retail Consortium、DEFRA、Food Standards Agency 等机构参与了一项大规模行动，联系超市及其供应链、查找暴露的控制器并缓解该问题。&nbsp;</p><p>为在极短时间内解决此问题投入了大量精力，零售商团队不得不利用晚上和周末开展工作。&nbsp;</p><p>该问题已在很大程度上得到缓解，但较小的冷链运营商仍可能暴露在风险之中。&nbsp;</p><p>制造商 RDM 采取了负责任的行动，并发布了应能解决此问题及其他若干问题的新固件。最佳应对措施仍是将这些控制器从公共互联网上移除。&nbsp;</p><p>目前我们不公开利用代码，也不公开发现这些漏洞的方法。由于 RDM 早些时候作出的一些幸运决定，这些漏洞比 Danfoss 相关问题更难被发现。这只是争取到了时间，并非提供了防护。请将这些控制器从公共互联网上移除并安装固件更新。&nbsp;</p><h2 id=\"sec-3\"><strong>我们如何帮助英国超市躲过一劫</strong>&nbsp;</h2><p>我们一直在思考，为什么在超市冷藏设备遭攻击的浪潮中，英国超市并未成为目标。&nbsp;</p><p>小型供应商中发生过一些零星事件，但没有大范围事件。&nbsp;</p><p>众所周知，法国事件源于 Danfoss 制冷控制器暴露在公共互联网上，其中大多数使用蜂窝调制解调器。再加上一個以日期作为种子的每日密码后门账户，在有人利用 <a href=\"https://www.cisa.gov/news-events/ics-advisories/icsa-25-140-03\">Claroty 于 2025 年 5 月</a>披露的漏洞之前，只是时间问题。&nbsp;</p><p>同样的漏洞早在 2022 年就已被利用，因此也只是时间问题。&nbsp;</p><h2 id=\"sec-4\"><strong>但为什么英国没有受到影响？</strong></h2><p>随后我们取得了一项突破，解释了所有原因，但也造成了一个威胁我国众多超市的巨大问题。&nbsp;</p><p>我们接到了 Omega Solutions 的 Garry Turner 和 Neil McCourt 的电话。他们专精于冰箱遥测等诸多领域。他们一直在协助一家英国零售商，确保其冷藏设备未暴露于与 Danfoss 控制器类似的问题之中。&nbsp;</p><p>Danfoss 控制器在英国并不特别受欢迎。英国市场上更受欢迎的控制器来自一家名为 RDM 的公司，该名称是 Resource Data Management 的缩写。&nbsp;</p><p>Neil 注意到 RDM 控制器中的一些问题，并希望我们协助验证和解决。他知道我们在与制造商沟通以及推动漏洞修复方面经验丰富。Andrew Tierney 和我们的硬件安全团队还发现了该设备中大量其他漏洞。&nbsp;</p><p>于是，一个巨大的潘多拉魔盒被打开了……&nbsp;</p><p>我们已经看到 RDM 向客户发布的初步公告（RDM-SA-2026-001，11 月 2 日，11 月 3 日修订），但该公告确实相当薄弱。例如，它未能：&nbsp;</p><ul>\n<li>说明该漏洞可能允许攻击者实施哪些行为&nbsp;</li>\n\n\n\n<li>提供独立验证，证明拟议的新固件是安全的并解决了该问题&nbsp;</li>\n\n\n\n<li>确认并感谢报告来源&nbsp;</li>\n\n\n\n<li>提供任何确认信息，说明供应链下游的用户是否已收到警报&nbsp;</li>\n\n\n\n<li>提供进一步努力发现和修复固件中其他漏洞的任何细节&nbsp;</li>\n</ul><p>鉴于该漏洞对国家关键基础设施的影响，我们也没有意识到曾有任何尝试向 NCSC 报告。&nbsp;</p><p>Omega 主动向 NCSC 报告此事，并提供了一份全面得多的漏洞报告。遗憾的是，NCSC 没有确认收到该报告，但确实通过其面向英国各地超市的各种渠道发布了紧急警报。&nbsp;</p><p>因此，应 Omega 的请求，PTP 参与此事。&nbsp;</p><p>当天下午，我们与 NCSC 面对面会面，分享了我们的新发现，并开始采取行动。&nbsp;</p><p>我们还联系了我们所知道的每一家超市的安全联系人，确认他们是否收到了警报。&nbsp;</p><p>有些超市收到了警报，并发现其部分系统暴露在外。修复工作正在全速进行。&nbsp;</p><p>另一些超市将 RDM 控制器置于专用网络中或 VPN 之后，因此暴露程度大幅降低。&nbsp;</p><p>我们向数家超市介绍了 Omega 和 PTP 的发现。&nbsp;</p><p>与此同时，Andrew Tierney 和我们的硬件团队开始处理 RDM 控制器固件。我们发现了几个额外的重要漏洞，这些漏洞也已直接报告给 RDM。我们希望尽快验证修复方案。&nbsp;</p><h2 id=\"sec-5\"><strong>与制造商 RDM 进行联络</strong>&nbsp;</h2><p>漏洞披露可能极具挑战，但我们联系到了 RDM 的 CEO 和 CTO。尽管他们最初对 Omega 的回应略显缺乏细节，但一旦我们直接参与进来，就发现他们态度开放且响应迅速。&nbsp;</p><p>这与我们经历的大多数披露流程完全相反：供应商通常都会采取对抗态度且不愿配合。相比之下，RDM 一直全天候 24×7 地编写新固件，并采纳了我们的建议和指导。听起来，该业务在过去几年中经历了不少变化，但现在已经组建了一支更有活力、更高效的研发团队。&nbsp;</p><p>除了最初的公告以及漏洞最初被发现之外，我们不确定他们还能做些什么。他们甚至主动查找由第三方安装的控制器，并向这些控制器的运营方发送公告。&nbsp;</p><p>我们一直就有关 RDM 的新发现，以及其他技术中的若干相关发现，与 NCSC 保持沟通。他们提供了很大帮助，为我们寻找海外联系人以分享关键威胁情报，并利用他们的网络共享情报。&nbsp;</p><p>所以，由于 Neil、Omega Solutions、Andrew 和 PTP 团队与 NCSC 展开了密切合作，一些英国超市幸运地避开了一场灾难。超市网络团队所需投入的工作量也不容低估——一些优秀的人在极短的时间内完成了大量工作。&nbsp;</p><h2 id=\"sec-6\"><strong>还有更多内容</strong>&nbsp;</h2><p>我们不知道这些警报已经沿供应链传递到了什么程度。我们知道 NCSC 和 BRC 一直在共享情报，但冷藏和冷冻食品的供应链既复杂又庞大。因此，我们暂未披露我和 Omega 发现的漏洞详情。&nbsp;</p><p>我们成功使用 Shodan 定位了暴露在外的控制器。其中一些提供了有用的位置信息，使我们得以确定由哪个组织运营。我们还利用其他开源数据，成功联系到相关责任人，向他们通报情况，并让他们的控制器从互联网上撤下。&nbsp;</p><p>在数千个暴露的控制器中，我们成功找到并联系了许多重要运营方。继超市之后，这些通常是食品制造商和大型冷藏仓库的运营方。对于其余控制器，如果不损害其安全性，我们无法确定其归属，而这是我们不愿做的。&nbsp;</p><p>此时，在我們、NCSC、行业及其他相关方付出努力之后，我们认为 alerting 食品供应链的最佳方式是引起外界关注。&nbsp;&nbsp;</p><h2 id=\"sec-7\"><strong>紧急行动</strong>&nbsp;</h2><p>如果你使用 RDM（或任何制冷控制器系统），请确认它无法从公共互联网访问。&nbsp;</p><p>常见问题包括在公共互联网上使用蜂窝调制解调器。请使用 VPN 或专用 APN。&nbsp;</p><p>然后，应用 RDM 的最新固件，这应当可以缓解最严重的问题。</p>","original","zhKind","translation","complete","漏洞","漏洞分析","补丁","https://www.pentestpartners.com/security-blog/the-fridge-hack-uk-supermarkets-narrowly-avoided/","Pen Test Partners",{"_117":118,"_119":-5},"changelogVersion","2026-10-01T08:00","release"]
