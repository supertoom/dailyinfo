[{"_1":2,"_3":4},"root",{"_5":101},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1794195828000,"id","e2045n8tbrejpugvivwldv42k","title","BBT SE确认Brenner Base Tunnel项目数据遭入侵，Everest声称窃取812 GB文件","originalTitle","Don’t Hand Propaganda a Gift: Reading the Brenner Base Tunnel SE Breach Calmly","summary","负责建设意大利与奥地利之间Brenner Base Tunnel的BBT SE确认未经授权人员访问了部分数据，勒索组织Everest声称窃取812 GB文件，但该数量尚未获独立核实。","reason","source",{"_74":100},"links",{"_61":99},"publishedAt","2026-11-08T17:46:16.000Z","discoveredAt","2026-11-08T20:10:21.490Z","timelineAt","category","activity","tags",[75,96,97,98,77],"score",54,"selected",false,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Pierluigi Paganini","body",{"_92":-5,"_61":93,"_94":-5,"_95":36},"outline",[86],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fPy6wcU-TaWo","reportCount",1,"additionalSourceCount",0,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","attack","name","攻击活动","incident","应急响应","black-market","数据窃取与黑产","ransomware","勒索软件",{"_83":84,"_13":85},"publicId","f8957a3b-e919-45d8-9ba9-ded317ae377b","BBT SE确认隧道项目部分数据被未授权访问",{"_11":87,"_88":89,"_90":91},"sec-1","text","Brenner Base Tunnel SE confirms a breach and Everest claims 812 GB. What we know","level",2,"zh","<h2 id=\"sec-1\">Brenner Base Tunnel SE confirms a breach and Everest claims 812 GB. What we know, what we don’t, and why overblown alarm helps propaganda more than the attackers.</h2><p>Brenner Base Tunnel (BBT) SE, the company building the Brenner Base Tunnel between Italy and Austria, has confirmed that unauthorized people accessed some of its data. The extortion group Everest claims it took 812 GB of files. Nobody has verified that, and a criminal bragging about file sizes isn’t an audited source.</p><p>The timeline is thin. The intrusion reportedly dates to mid-October, Everest’s claim to 17 October, and the Austrian press broke the story on 6 November. On 7 November BBT SE <a href=\"https://www.ansa.it/amp/trentino/notizie/2026/11/07/cyberattacco-alla-societa-della-galleria-del-brennero-indagini-in-corso_49096502-4dc9-4604-96af-4ac19afe25fd.html\">told</a> ANSA that operations are unaffected, the systems involved are isolated, and outside forensic experts and the authorities are on the case.</p><p>If real and current, drawings, surveys and site procedures would save an attacker a lot of reconnaissance. Together they could show how the infrastructure fits together, and fraudsters could borrow project names to fool contractors. Those are scenarios, not sightings.</p><p>Dates matter too. The tunnel won’t open before 2034, at a projected cost of about €11.7 billion, so older drawings may describe a design that has since changed.</p><p>Knowing how a tunnel is built does not mean being able to control it. Sabotage requires access to operational systems and weaknesses that attackers can exploit. So far, there is no evidence that attackers accessed industrial systems or tampered with the tunnel’s control functions. BBT SE has not confirmed any encryption of its systems either. Claims that ransomware could stop the tunnel therefore have no factual support.</p><p>Everest is a Russian-speaking cybercriminal group. ZeroFox has also noted that the group tends to exaggerate the amount of data it steals. Speaking Russian and operating within a Russian-speaking cybercrime environment does not prove that the group is directed by the Russian state. In July, the same group demanded CHF 10 million from Stadler Rail after using stolen credentials to access a supplier’s data platform. Production continued despite the incident.</p><p>The response should focus on practical security measures. Organizations need to identify which information was exposed, revoke potentially compromised credentials, keep document management systems separate from industrial control networks, and warn suppliers about fraudulent requests. Whether NIS2 applies to a project company that is still under construction depends on its activities and the relevant national legislation.</p><p>There is no benefit in creating unnecessary alarm. It only helps the attackers and anyone trying to exploit the incident for an influence campaign. Blaming Moscow without evidence would play directly into propaganda efforts. There are three key questions that need clear answers: which files were actually stolen, how recent and relevant they are, and who might still be able to use them.</p><p><strong>Follow me on Twitter:&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;hacking,&nbsp;Brenner Base Tunnel)</strong></p>","zhKind","complete","勒索","数据泄露","黑产","https://securityaffairs.com/202691/cyber-crime/dont-hand-propaganda-a-gift-reading-the-brenner-base-tunnel-se-breach-calmly.html","Security Affairs",{"_102":103,"_104":-5},"changelogVersion","2026-10-01T08:00","release"]
