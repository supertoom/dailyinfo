[{"_1":2,"_3":4},"root",{"_5":114},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1793672467000,"id","lpx0fpf5dtulg95plg0vd0qsv","title","FBI 查封 Virtualine 防弹托管域名及其犯罪论坛","originalTitle","FBI seizes Virtualine, bulletproof hosting provider that promised to shield criminals from police","summary","FBI 牵头查封 Virtualine 旗下 virtualine.net，该防弹托管服务曾为犯罪客户提供托管、服务器和域名注册，并被指洗钱及托管儿童性虐待材料论坛。","reason","案件揭示了防弹托管服务通过域名迁移、重新注册和品牌重塑延续犯罪基础设施的运作方式。","source",{"_76":113},"links",{"_104":112},"publishedAt","2026-10-28T11:41:01.000Z","discoveredAt","2026-10-28T14:03:45.041Z","timelineAt","category","activity","tags",[79,108,77,109,110,111,87],"score",76,"selected",true,"channel","news","story",{"_89":90,"_13":91},"x","readingMode","full","author","Sinisa Markovic","body",{"_61":103,"_104":-5,"_105":106,"_107":37},"outline",[92,93,94],"relatedStories",[88],"topics",[68,69,70,71,72,73],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fLC6IiYN8JzY","reportCount",4,"additionalSourceCount",3,{"_74":86,"_76":87},{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","malware","name","恶意软件","attack","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","email","邮件与钓鱼","cisa","CISA",{"_89":90,"_13":91},"publicId","e285d5e2-05ab-4493-ab47-7602fcd24420","FBI查封Virtualine犯罪托管域名",{"_11":101,"_96":102,"_98":67},{"_11":99,"_96":100,"_98":67},{"_11":95,"_96":97,"_98":67},"sec-3","text","更名后卷土重来","level","sec-2","儿童虐待材料持续在线","sec-1","在黑客论坛上公开营业","<p>美国联邦调查局（FBI）已查封 virtualine.net。该域名属于一家“防弹”托管服务提供商；尽管警方和儿童保护组织多次发出警告，该提供商仍为犯罪客户洗钱，并运营一个在线交易儿童性虐待材料的论坛。</p><p><img src=\"/dailyinfo/media/f13695cd557c14ae.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Virtualine FBI seizure\" title=\"Seizure notice\"></p><h5>\n<p>查封通知（来源：美国司法部）</p>\n</h5><p>FBI 华盛顿办公室主导了此次调查，行动代号为“Operation Omegaline”。德国 Polizei Hessen、荷兰 Politie Midden-Nederland、英国国家犯罪局，以及私营部门合作伙伴 OverRIPE 和 Lumen 给予了协助。</p><h3 id=\"sec-1\">在黑客论坛上公开营业</h3><p>Virtualine 又名 Secury、Massgod、Spamhouse、Lanedo 和 Omegatech，向其招募的 <a href=\"https://www.helpnetsecurity.com/2026/07/14/underground-hacking-forums-tutorials-research/\">网络犯罪论坛</a>客户出售托管、服务器和域名注册服务。</p><p>检方称，该服务被用于发布未成年人的色情露骨图像，以及在未获本人同意的情况下传播成年人和未成年人的私密图像；该公司还为客户洗钱。</p><p>该提供商公开招揽犯罪分子。2024 年 9 月，它在 Exploit.in 论坛上告知用户：“你可以将 Virtualine 用于所有非法/黑帽活动（包括 phis[h]ing、盗刷、垃圾邮件、端口扫描以及其他所有活动），但儿童内容和恐怖主义活动除外。”</p><p>2025 年 6 月，它在 HackForums 上夸耀称：“Virtualine 忽略的滥用行为，比你最近三位治疗师还要多。”</p><p>今年 3 月，该公司开始向担心警方调查的客户出售“额外保护计划”。Virtualine 承诺，在其“收到执法机构的正式请求”后，会将客户的犯罪基础设施转移至“另一家与 Virtualine 无关的壳公司，随后重新启用服务器”。</p><h3 id=\"sec-2\">儿童虐待材料持续在线</h3><p>尽管自身设有“儿童内容”规则，Virtualine 仍明知故犯地托管了一个在法庭记录中被称为 Vendor 1 的犯罪论坛，用户可在该论坛出售访问未成年人及成年人露骨图像和视频的权限。论坛还公开提供受雇黑客服务，他们侵入受害者账户，窃取私密照片和视频。</p><p>从 2026 年 1 月起，德国、加拿大和澳大利亚警方、美国国家失踪与受虐儿童中心（NCMEC）以及一名受害者的律师就论坛服务器上的儿童性虐待材料警告该托管商。Virtualine 仍让该论坛保持在线，并协助 Vendor 1 搭建了一个用于上传和出售内容的新网站，而该网站目前仍由 Virtualine 托管。</p><p>美国司法部 <a href=\"https://www.justice.gov/usao-edva/pr/bulletproof-website-domain-seized-international-law-enforcement-operation\">表示</a>：“Virtualine 通过 BTC [NO-AML]、特定的非托管比特币地址收款，使客户能够直接付款，而无需担心其资金会被标记为非法所得。”</p><p>区块链分析公司 Chainalysis 与独立安全研究人员组成的联盟 OverRIPE 一道支持了此次调查。该公司 <a href=\"https://www.chainalysis.com/blog/virtualine-bulletproof-hosting-seizure-october-2026/\">表示</a>，Virtualine 的收款地址与勒索软件运营者、信息窃取基础设施、俄语网络犯罪论坛、非法商店以及诈骗和钓鱼地址存在直接关联。</p><h3 id=\"sec-3\">更名后卷土重来</h3><p>威胁情报公司 Silent Push 自 2026 年 2 月 11 日起一直在<a href=\"https://www.silentpush.com/blog/operation-omegaline-fbi-seizes-virtualine/\">追踪</a>该网络；当时它发现基础设施正从一家已知的防弹托管商 Railnet 转移至一个新注册的网络 Omegatech。Virtualine Technologies 也出现在该网络中。</p><p>查封发生后数小时内，Virtualine <a href=\"https://x.com/darkwebinformer/status/2115184891046346904\">发布</a>了一封公开信，声称存放在第二个域名 virtualine.org 上，对相关指控予以反驳，并向 Telegram 上的关注者保证他们的数据是安全的。该公开信的作者承认，他们“可以更换品牌、搭建新网站，然后继续运营”，并称这可能只需一天或更短时间。</p><p>Silent Push 表示，Omegatech 网络的部分设施仍可访问，但其路由可见性已降至极低水平，这通常是运营方遇到严重问题的迹象。该公司称，在过去 12 个月中，其监测范围内的 50 家防弹托管服务提供商失去了网络标识符（ASN）。</p><p>CISA、FBI、英国 NCSC 和其他机构于 2025 年 11 月联合发布的一份<a href=\"https://www.ic3.gov/CSA/2025/251119.pdf\">公告</a>警告称，此类服务提供商可以在 2 至 5 个工作日内获得新的 ASN，并将相同的 IP 地址段迁移至该 ASN。</p>","original","zhKind","translation","complete","黑产","数据窃取","钓鱼","网络设备","https://www.helpnetsecurity.com/2026/10/28/fbi-seizure-virtualine-bulletproof-hosting-domain/","Help Net Security",{"_115":116,"_117":-5},"changelogVersion","2026-10-01T08:00","release"]
