[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795567282000,"id","jsue3lxy8byb3eja5kfn2ndc0","title","Schneider Electric EcoStruxure Power Build Rapsody software 修复 CWE-416 释放后重用漏洞，CVSS 5.3","originalTitle","Schneider Electric EcoStruxure Power Build Rapsody software","summary","Schneider Electric EcoStruxure Power Build Rapsody software 存在 CWE-416 释放后重用漏洞，本地攻击者可诱导用户打开特制恶意 SSD 文件，触发任意代码执行。","reason","source",{"_72":97},"links",{"_61":96},"publishedAt","2026-11-24T12:00:00.000Z","discoveredAt","2026-11-24T16:00:34.998Z","timelineAt","category","vuln","tags",[92,93,94,95],"score",31,"selected",false,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","CISA","body",{"_88":-5,"_61":89,"_90":-5,"_91":36},"outline",[82],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","f5zgF6FydNiA","reportCount",1,"additionalSourceCount",0,{"_71":76,"_72":77},{"_71":74,"_72":75},{"_71":30,"_72":73},"slug","name","漏洞披露","industrial","工业控制","iot","IoT 与车联网",{"_79":80,"_13":81},"publicId","fac06446-757e-4561-a41c-c5eaaa0664df","施耐德发布释放后重用漏洞修复",{"_11":83,"_84":85,"_86":87},"sec-1","text","8 Affected Products","level",4,"zh","<p>A CWE- 416: Use After Free vulnerability exists that could cause arbitrary code execution when a local attacker could trick the end user to open a specially crafted malicious SSD file.</p><h4 id=\"sec-1\">8 Affected Products</h4><hr><h5>EcoStruxure Power Build Rapsody software Versions FR 2.9.1.0 and prior</h5><p>Product Status: fixed, known_affected</p><h5>Remediations</h5><p><strong>Vendor fix</strong><br>Versions FR V2.9.12.0101, ESP V2.9.5.0000, PT V2.9.7.0000, BEL(FR) V2.9.8.0000, BEL(EN) V2.9.3.0000, INT(EN) V2.9.4.0000, INT(FR)V2.9.6.0000, NL V2.9.6.0000 of EcoStruxure™ Power Build Rapsody software includes a fix for this vulnerability and is available for download here: https://www.se.com/ww/en/product-country-selector/?pageType=product-range&amp;sourceId=2309</p><hr><h5>EcoStruxure Power Build Rapsody software Versions ESP 2.8.5.0301 and prior</h5><p>Product Status: fixed, known_affected</p><h5>Remediations</h5><p><strong>Vendor fix</strong><br>Versions FR V2.9.12.0101, ESP V2.9.5.0000, PT V2.9.7.0000, BEL(FR) V2.9.8.0000, BEL(EN) V2.9.3.0000, INT(EN) V2.9.4.0000, INT(FR)V2.9.6.0000, NL V2.9.6.0000 of EcoStruxure™ Power Build Rapsody software includes a fix for this vulnerability and is available for download here: https://www.se.com/ww/en/product-country-selector/?pageType=product-range&amp;sourceId=2309</p><hr><h5>EcoStruxure Power Build Rapsody software Versions PT 2.8.7.0101 and prior</h5><p>Product Status: fixed, known_affected</p><h5>Remediations</h5><p><strong>Vendor fix</strong><br>Versions FR V2.9.12.0101, ESP V2.9.5.0000, PT V2.9.7.0000, BEL(FR) V2.9.8.0000, BEL(EN) V2.9.3.0000, INT(EN) V2.9.4.0000, INT(FR)V2.9.6.0000, NL V2.9.6.0000 of EcoStruxure™ Power Build Rapsody software includes a fix for this vulnerability and is available for download here: https://www.se.com/ww/en/product-country-selector/?pageType=product-range&amp;sourceId=2309</p><hr><h5>EcoStruxure Power Build Rapsody software Versions BEL(FR) 2.8.8.0201 and prior</h5><p>Product Status: fixed, known_affected</p><h5>Remediations</h5><p><strong>Vendor fix</strong><br>Versions FR V2.9.12.0101, ESP V2.9.5.0000, PT V2.9.7.0000, BEL(FR) V2.9.8.0000, BEL(EN) V2.9.3.0000, INT(EN) V2.9.4.0000, INT(FR)V2.9.6.0000, NL V2.9.6.0000 of EcoStruxure™ Power Build Rapsody software includes a fix for this vulnerability and is available for download here: https://www.se.com/ww/en/product-country-selector/?pageType=product-range&amp;sourceId=2309</p><hr><h5>EcoStruxure Power Build Rapsody software Versions BEL(EN) 2.8.3.0201 and prior</h5><p>Product Status: fixed, known_affected</p><h5>Remediations</h5><p><strong>Vendor fix</strong><br>Versions FR V2.9.12.0101, ESP V2.9.5.0000, PT V2.9.7.0000, BEL(FR) V2.9.8.0000, BEL(EN) V2.9.3.0000, INT(EN) V2.9.4.0000, INT(FR)V2.9.6.0000, NL V2.9.6.0000 of EcoStruxure™ Power Build Rapsody software includes a fix for this vulnerability and is available for download here: https://www.se.com/ww/en/product-country-selector/?pageType=product-range&amp;sourceId=2309</p><hr><h5>EcoStruxure Power Build Rapsody software Versions INT(EN) 2.8.4.0401 and prior</h5><p>Product Status: fixed, known_affected</p><h5>Remediations</h5><p><strong>Vendor fix</strong><br>Versions FR V2.9.12.0101, ESP V2.9.5.0000, PT V2.9.7.0000, BEL(FR) V2.9.8.0000, BEL(EN) V2.9.3.0000, INT(EN) V2.9.4.0000, INT(FR)V2.9.6.0000, NL V2.9.6.0000 of EcoStruxure™ Power Build Rapsody software includes a fix for this vulnerability and is available for download here: https://www.se.com/ww/en/product-country-selector/?pageType=product-range&amp;sourceId=2309</p><hr><h5>EcoStruxure Power Build Rapsody software Versions INT(FR) 2.8.6.0000 and prior</h5><p>Product Status: fixed, known_affected</p><h5>Remediations</h5><p><strong>Vendor fix</strong><br>Versions FR V2.9.12.0101, ESP V2.9.5.0000, PT V2.9.7.0000, BEL(FR) V2.9.8.0000, BEL(EN) V2.9.3.0000, INT(EN) V2.9.4.0000, INT(FR)V2.9.6.0000, NL V2.9.6.0000 of EcoStruxure™ Power Build Rapsody software includes a fix for this vulnerability and is available for download here: https://www.se.com/ww/en/product-country-selector/?pageType=product-range&amp;sourceId=2309</p><hr><h5>EcoStruxure Power Build Rapsody software Versions NL 2.8.2.0000 and prior</h5><p>Product Status: fixed, known_affected</p><h5>Remediations</h5><p><strong>Vendor fix</strong><br>Versions FR V2.9.12.0101, ESP V2.9.5.0000, PT V2.9.7.0000, BEL(FR) V2.9.8.0000, BEL(EN) V2.9.3.0000, I