[{"_1":2,"_3":4},"root",{"_5":89},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":-5,"_57":36,"_58":59},"expiresAt",1795394439000,"id","rjnsitgoux45mdzzadt2bgf2y","title","Security Affairs 发布第 9 期 AI 网络安全新闻简报","originalTitle","SECURITY AFFAIRS AI-CYBERSECURITY NEWSLETTER ROUND 9","summary","Security Affairs 第 9 期 AI 网络安全新闻简报汇总多篇国际研究，覆盖 AI 驱动的威胁攻击、漏洞挖掘与防御工具。","reason","source",{"_64":88},"links",{"_59":87},"publishedAt","2026-11-22T14:31:35.000Z","discoveredAt","2026-11-22T15:13:24.887Z","timelineAt","category","ai-security","tags",[80,65,81,67,82,83,84,85,86],"score",8,"selected",false,"channel","news","story","x","readingMode","full","author","Pierluigi Paganini","body",{"_76":-5,"_59":77,"_78":-5,"_79":36},"outline",[70],"relatedStories",[],"topics",[60,61,62],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_63":68,"_64":69},{"_63":66,"_64":67},{"_63":30,"_64":65},"slug","name","AI 安全","ai-offense","AI 攻防","ai-agent","AI Agent 安全",{"_11":71,"_72":73,"_74":75},"sec-1","text","Security Affairs AI-CYBERSECURITY newsletter includes a collection of the best a","level",2,"zh","<h2 id=\"sec-1\">Security Affairs AI-CYBERSECURITY newsletter includes a collection of the best articles and research on AI in the international landscape</h2><p>Artificial intelligence is rapidly changing cybersecurity, reshaping both the techniques used by attackers and the tools available to defenders. AI agents can automate tasks, analyze large amounts of data, discover vulnerabilities and accelerate offensive operations. At the same time, AI is creating new capabilities for threat detection, incident analysis and response. Security Affairs’ new newsletter follows this evolution, covering every week the latest threats, attacks, vulnerabilities and developments at the intersection of AI and cybersecurity.</p><p><a href=\"https://aws.amazon.com/it/blogs/security/amazon-threat-intelligence-observes-threat-actors-running-cybercrime-campaigns-with-artex-ai-agents/\">Amazon Threat Intelligence observes threat actors running cybercrime campaigns with ARTEX AI agents</a></p><p><a href=\"https://cloud.google.com/blog/topics/threat-intelligence/agentic-threat-activity-crosses-a-significant-threshold\">GTIG AI Threat Tracker: Agentic Threat Activity Crosses a Significant Threshold</a>&nbsp;&nbsp;</p><p><a href=\"https://www.anthropic.com/claude-fable-and-mythos-5-2\">Claude Fable 5.2 and Mythos 5.2</a>&nbsp;&nbsp;</p><p><a href=\"https://www.infostealers.com/article/inside-the-ai-powered-marketplace-turning-infected-computers-into-searchable-profiles/\">Inside the AI-Powered Marketplace Turning Infected Computers Into Searchable Profiles</a>&nbsp;&nbsp; </p><p><a href=\"https://therecord.media/california-sues-openai-hugging-face\">California sues OpenAI for Hugging Face and other incidents, alleging deception and recklessness</a></p><p><a href=\"https://www.crowdstrike.com/en-us/blog/supply-chain-risk-from-backdoored-lora-models/\">Hidden in the Weights: Supply Chain Risk from Backdoored LoRA Models</a></p><p><a href=\"https://censys.com/blog/artex-agentic-asbestos/\">ARTEX: Agentic Asbestos</a>&nbsp;&nbsp;</p><p><a href=\"https://www.wiz.io/blog/malicious-version-of-microsofts-agent-framework-published-to-pypi\">Microsoft agent-framework Compromised: Credential Stealer Targets Azure and CI Pipelines</a></p><p><a href=\"https://techcrunch.com/2026/11/19/google-gives-gemini-the-ability-to-use-your-mac-for-you/\">Google gives Gemini the ability to use your Mac for you</a><br><a href=\"https://techcrunch.com/category/artificial-intelligence/#:~:text=Meta%E2%80%99s%20AI%20agent%20Muse%20is%20mixing%20up%20conversations%20and%20exposing%20private%20data%2C%20report%20says\">Meta’s AI agent Muse is mixing up conversations and exposing private data, report says</a>&nbsp;</p><p><a href=\"https://techcrunch.com/2026/11/19/at-nasdaq-opening-bell-anthropic-ceo-recommits-to-pacing-ai-development/\">At Nasdaq opening bell, Anthropic CEO recommits to pacing AI development</a></p><p><a href=\"https://profero.io/blog/ai-attack-cluster-tells/\">Polite, methodical, machine-driven: reading an AI attack cluster in your logs</a>&nbsp;&nbsp;</p><p><a href=\"https://unit42.paloaltonetworks.com/cairn-framework-ai-autonomous-attacks/\">Attackers Use Autonomous AI to Target Semiconductor, Defense and Civil Society Sectors</a>&nbsp;&nbsp;</p><p><a href=\"https://socradar.io/blog/php2shell-ai-agents-credential-harvesting/\">PHP2Shell Exploited by AI Agents from Day One: Inside a Credential-Harvesting Campaign</a>&nbsp;</p><p><a href=\"https://techcrunch.com/sponsor/ventureone/why-the-smartest-ai-teams-are-building-their-own-benchmarks/\">Why the smartest AI teams are building their own benchmarks</a></p><p><a href=\"https://www.theregister.com/security/2026/11/20/dutch-data-watchdog-highlights-safety-issues-with-ai-glasses/5311345\">Dutch data watchdog highlights safety issues with AI glasses</a></p><p><strong>Follow me on Twitter:&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;hacking,&nbsp;<a href=\"https://securityaffairs.com/tag/newsletter\">newsletter</a>)</strong></p>","zhKind","complete","汇总","Agent 安全","大模型","AWS","Google","Apple","阿里","https://securityaffairs.com/203725/ai/security-affairs-ai-cybersecurity-newsletter-round-9.html","Security Affairs",{"_90":91,"_92":-5},"changelogVersion","2026-10-01T08:00","release"]
