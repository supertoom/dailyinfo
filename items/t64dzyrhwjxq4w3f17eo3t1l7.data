[{"_1":2,"_3":4},"root",{"_5":115},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":58,"_59":60},"expiresAt",1794616834000,"id","t64dzyrhwjxq4w3f17eo3t1l7","title","欧洲多国超市冷柜遭远程操控加热，Danfoss 旧固件漏洞被用于攻击","originalTitle","有人把欧洲超市的冷柜调到了50℃，这是第二个月了","summary","瑞典、爱尔兰、比利时、卢森堡和爱沙尼亚的连锁超市冷柜近期被远程设为50℃，其中SuperValu 223家门店中13家受影响，未出现勒索信且暂无官方归因。此前法国10月11日事件涉及Intermarché约150家门店、Carrefour 80家门店及Monoprix约490家门店中的5%，ANSSI调查指向运行过时固件的Danfoss制冷控制软件。","reason","文章串联欧洲多国冷柜攻击事件，并还原旧固件、暴露管理界面与认证绕过、命令注入组成的攻击链，便于评估联网制冷设备风险。","source",{"_68":45},"links",{"_107":114},"publishedAt","2026-11-05T03:44:53.000Z","discoveredAt","2026-11-05T03:52:24.753Z","timelineAt","category","activity","tags",[69,110,111,112,113,71],"score",81,"selected",true,"channel","news","story","x","readingMode","full","author","安全客","body",{"_60":106,"_107":-5,"_108":107,"_109":37},"outline",[78,79,80,81,82,83,84,85],"relatedStories",[],"topics",[61,62,63,64,65],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","zh",{"_66":76,"_68":77},{"_66":74,"_68":75},{"_66":72,"_68":73},{"_66":70,"_68":71},{"_66":67,"_68":69},"slug","attack","name","攻击活动","incident","应急响应","industrial","工业控制","iot","IoT 与车联网","supply-chain","供应链安全",{"_11":104,"_87":105,"_89":95},{"_11":102,"_87":103,"_89":95},{"_11":100,"_87":101,"_89":95},{"_11":98,"_87":99,"_89":95},{"_11":96,"_87":97,"_89":95},{"_11":93,"_87":94,"_89":95},{"_11":91,"_87":92,"_89":90},{"_11":86,"_87":88,"_89":90},"sec-8","text","相关文章","level",3,"sec-7","TA的文章","sec-6","六、这件事真正的提醒",2,"sec-5","五、几条现在就能做的动作","sec-4","四、没有勒索信的第二次","sec-3","三、为什么偏偏是冷柜","sec-2","二、被点名的丹麦控制器，和被忽略的固件","sec-1","一、10月11日那一夜，法国人扔了一整条街的冰淇淋","<p><span>首页</span></p><ul></ul><p><span>活动</span></p><ul></ul><p><span>社区</span></p><ul></ul><p><span>学院</span></p><ul></ul><p><span>安全导航</span></p><ul></ul><p><span>阅读量</span><b>1037</b></p><p>发布时间 : 2026-11-05 11:44:53</p><p>11月2日凌晨，瑞典一家连锁超市的店长打开后台，看到冷藏柜的设定温度是50摄氏度。</p><p>不是故障，不是传感器漂移。有人远程把它改成了50。这个温度足以让一柜鲜奶在几小时内全部报废，让压缩机和加热元件在同一个箱体里互相较劲，最后冒烟起火。</p><p>同一天，爱尔兰连锁超市SuperValu确认223家门店中有13家的制冷系统被攻击，冷藏和冷冻食品全部下架。比利时和卢森堡数十家门店出现同样症状。爱沙尼亚一家连锁超市的设备供应商对媒体说，当地门店的温度也被设成了50。</p><p>比利时检方当天宣布启动刑事调查。欧盟发言人出面表态：网络攻击不只影响企业运营，也会扰乱普通人的日常生活。</p><p>这已经是欧洲一个月内第二次了。</p><h2 id=\"sec-1\">一、10月11日那一夜，法国人扔了一整条街的冰淇淋</h2><p>把时间拨回10月11日深夜。</p><p>巴黎检察机关后来用”大规模”形容那晚发生的事：多家大型食品零售商的联网冷柜被同时接管。Les Mousquetaires集团旗下的<span>Intermarché<i></i></span>承认，约150家门店的冷柜被加热到50摄氏度，持续六个小时。家乐福说80家门店中招。Monoprix约490家门店里，5%受影响。</p><p>巴黎一位居民第二天早上路过市中心一家Intermarché，看到店员推着整车的解冻食品往巨型垃圾箱里倒，融化的冰淇淋从破掉的盒子里淌到街上。</p><p>Intermarché的CEO Thierry Cotillard对法国BFM电视台说，损失”全国一天数千万欧元”。</p><p>合作社U的CEO Dominique Schelcher在社交平台上写了一句很重的话：攻击保障生鲜保存和法国人食品供应的关键设备，性质极其严重，前所未有。</p><p>法国总理办公室的人对路透社说，总理已要求国家网络安全局ANSSI介入调查，并正在和欧洲同行协调，因为”其他国家也可能受影响”。</p><p>当时听着像客套话。三周后，瑞典、爱尔兰、比利时、卢森堡、爱沙尼亚全部应验。</p><h2 id=\"sec-2\">二、被点名的丹麦控制器，和被忽略的固件</h2><p>ANSSI的调查指向丹麦厂商<span>丹佛斯<i></i></span>（Danfoss）的制冷控制软件。</p><p>丹佛斯的回应很克制：知道法国发生了影响”有限数量制冷管理系统”的事件，受影响设备”运行的是过时的固件”，公司”长期以来一直建议客户保持受支持系统更新到最新固件，并把老旧系统迁移到当前代产品”。</p><p>翻译过来就是：漏洞我们早就修了，你没升。</p><p>今年8月9日，工业安全公司Claroty的Team82团队公开过对丹佛斯AK-SM 800A控制器的研究。那是一台管理整个门店冷柜的中央控制面板，通常由维保公司通过互联网远程访问，这正是它被盯上的原因。</p><p>Team82挖出三个东西。</p><p>第一个是被称为”当日密码”（code-of-the-day）的隐藏认证机制。攻击者只要在认证请求里带上两个特定参数，验证流程就会绕过正常的管理员密码校验，转而和一个由设备当前日期时间生成的密码做比对。把生成算法逆出来之后，任何人每天都能算出当天的合法凭证。编号CVE-2025-41450。</p><p>第二个是命令注入，编号CVE-2025-41451，可以拿到远程代码执行。</p><p>第三个是已认证用户可以往Nginx配置里注入任意指令，能改流量走向，也能直接把Web服务打瘫。</p><p>Team82在报告里提到，他们做互联网暴露面测绘时，发现了数以千计可公开访问的管理界面。</p><p>一套完整的攻击链，前提只有一个：这台设备还连着网，还跑着老固件。</p><p>这就解释了10月法国出现的那种画面。不是有人发明了新武器，是有人把三个月前就公开的旧武器，对准了一批没升级的设备。</p><p>在工控和物联网这个圈子里，”没升级”是常态，不是例外。</p><h2 id=\"sec-3\">三、为什么偏偏是冷柜</h2><p>安全圈有个说法：攻击者永远挑最软的地方。</p><p>冷柜控制系统符合所有”软”的特征。</p><p>它部署在门店，不在机房。门店没有专职安全人员，网络往往和收银、Wi-Fi、监控混在一起。它必须联网，因为维保要靠远程。它跑着多年不动的<span>嵌入式固件<i></i></span>，厂商支持周期一过就没人管。它的默认口令常常没改，管理界面直接暴露在公网。</p><p>最要命的是，它的失效后果是物理的。</p><p>改一台服务器的配置，你损失的是数据和可用性。改一台冷柜的设定温度，你损失的是几吨生鲜、一整面货架的商品、可能烧起来的压缩机和随之而来的消防车。</p><p>这类系统在行业里叫信息物理系统（<span>CPS<i></i></span>）。它的安全边界不止在屏幕里，还在温度、压力、阀门和电机的物理世界里。</p><p>今年8月底，美国约十余家军队商店也出现过类似情况，冷柜受影响，食品报损。当时没引起太多讨论。现在回头看，那更像一次预演。</p><h2 id=\"sec-4\">四、没有勒索信的第二次</h2><p>这两轮攻击都没有出现勒索信。</p><p>传统勒索软件的逻辑是先加密、再留信、再谈钱。这次不是。攻击者只是把温度调上去，然后走人。</p><p>这让防御方很难判断意图。是国家级行为体在做压力测试？是勒索团伙在展示能力、准备下一轮开价？还是纯粹的破坏？比利时检方启动刑事调查，瑞典网络安全部门介入，但至今没有官方归因。</p><p>从安全运营角度，这种”无诉求破坏”其实更难防。因为你的检测逻辑里，”异常登录”只有在后面跟着数据外传或文件加密时才被判定为高危；”温度设定被改”在监控系统里只是一条参数变更日志，值班的人未必会看。</p><p>而它造成的损害是实打实的：食品报废、门店停业、品牌受损、监管介入。对一家连锁超市来说，一天数千万欧元的损失，比很多勒索赎金都高。</p><h2 id=\"sec-5\">五、几条现在就能做的动作</h2><p>如果你所在的单位、园区、工厂、连锁门店里有联网的制冷、暖通、能源管理设备，下面几条现在就能做。</p><p>第一，先把暴露面收掉。用<span>Shodan<i></i></span>、Fofa或者自建测绘扫一遍自己的公网IP段，看有没有制冷控制器、PLC、HMI的管理界面在裸奔。有的话，第一时间用防火墙策略限制来源IP，只允许维保方固定出口访问。</p><p>第二，改掉默认口令，关掉不必要的远程维护通道。这类设备的Web管理界面如果必须对外开放，至少上VPN或零信任网关，不要直接映射端口。</p><p>第三，查固件版本。对照厂商公告确认是否在受影响范围内。不在支持周期内的老设备，认真评估替换，而不是继续”再撑一年”。</p><p>第四，在监控里加一条规则：制冷、暖通系统的设定值变更，尤其是超出正常区间的变更，直接进高危告警。设定温度从4度跳到50度，这本身就是一次入侵的强信号。</p><p>第五，把门店网络分段。收银、办公、监控、设备控制分开，设备控制网段禁止主动外联。这一条能挡掉大部分远程操控。</p><h2 id=\"sec-6\">六、这件事真正的提醒</h2><p>过去十年，工控安全在我国是个被反复强调、又被反复搁置的话题。大家都知道重要，但预算总是先给办公网、给等保、给终端。</p><p>冷柜这件事给的提醒很直接：攻击者不关心你的核心系统有多难打，他们只关心哪个口子最好进、进去了能造成多大动静。</p><p>一家超市的冷库，一台车间的温控器，一个园区的空调主机。它们不在你资产清单的前几页，但它们在互联网上，它们用着五年前的固件，它们的密码可能是123456。</p><p>法国那次之后，很多人以为是偶发。11月2日这天，五个国家同时出现同样的症状，说明不是偶发，是有人在批量找目标。</p><p>丹麦厂商说”请升级固件”，这句话在技术上完全正确，在现实里非常苍白。因为大量设备根本升不了，或者没人负责升。</p><p>真正要回答的问题不是”为什么他们不升级”，而是”下一次，冷柜里放过的东西是什么”。</p><p><strong>更多AI知识，请扫码关注Aiker World社区公众号</strong></p><p><img src=\"/dailyinfo/media/c851b32faa5b479f.jpg\" loading=\"lazy\" decoding=\"async\" width=\"302\"></p><p><strong>Aiker World社区网址：https://aikerworld.com</strong></p><p><strong>Aiker World（AI世界）-聚焦AI人才与智能体工具的垂直专家社区。专家领航+人才汇聚+工具赋能，打通AI技术与产业落地断层，为AI从业者、开发者及企业提供一站式成长与协作平台。</strong></p><ul></ul><p><i></i><span>0赞</span></p><p><i></i><span>收藏</span></p><p><img src=\"/dailyinfo/media/de79816eb5dd38f2.jpg\" loading=\"lazy\" decoding=\"async\"><span>安全客</span><span></span></p><p><a href=\"https://www.anquanke.com/member.html?memberId=184300\"><img src=\"/dailyinfo/media/de79816eb5dd38f2.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p><a href=\"https://www.anquanke.com/member.html?memberId=184300\">安全客</a></p><p>这个人太懒了，签名都懒得写一个</p><ul><li>文章</li><li><strong>94</strong></li></ul><ul><li>粉丝</li><li><strong>5</strong></li></ul><h3 id=\"sec-7\"> TA的文章</h3><ul><li><h5><a href=\"https://www.anquanke.com/post/id/316392\">【开放申请】企业可自查PHP2Shell漏洞了！</a></h5><p>2026-10-30 18:19:15</p></li><li><h5><a href=\"https://www.anquanke.com/post/id/316387\">突发！1day漏洞致使大量NAS用户文件被加密</a></h5><p>2026-10-30 18:09:17</p></li><li><h5><a href=\"https://www.anquanke.com/post/id/316355\">Node.js、Python、Bun全中招：一个压缩库的内存漏洞，让半个互联网\"裸奔\"</a></h5><p>2026-10-26 14:54:01</p></li><li><h5><a href=\"https://www.anquanke.com/post/id/316350\">凌晨收到GitLab安全公告，CVSS满分，我看了看自家版本号</a></h5><p>2026-10-26 14:47:16</p></li><li><h5><a href=\"https://www.anquanke.com/post/id/316346\">AI自己写勒索脚本、自己挑目标、自己搞钱：俄罗斯黑客的Phantom框架，把勒索软件玩成了自动化流水线</a></h5><p>2026-10-26 12:02:03</p></li></ul><h3 id=\"sec-8\"> 相关文章</h3><ul><li><h5><a href=\"https://www.anquanke.com/post/id/316392\">【开放申请】企业可自查PHP2Shell漏洞了！</a></h5><p>2026-10-30 18:19:15</p></li><li><h5><a href=\"https://www.anquanke.com/post/id/316387\">突发！1day漏洞致使大量NAS用户文件被加密</a></h5><p>2026-10-30 18:09:17</p></li><li><h5><a href=\"https://www.anquanke.com/post/id/316355\">Node.js、Python、Bun全中招：一个压缩库的内存漏洞，让半个互联网\"裸奔\"</a></h5><p>2026-10-26 14:54:01</p></li><li><h5><a href=\"https://www.anquanke.com/post/id/316350\">凌晨收到GitLab安全公告，CVSS满分，我看了看自家版本号</a></h5><p>2026-10-26 14:47:16</p></li><li><h5><a href=\"https://www.anquanke.com/post/id/316346\">AI自己写勒索脚本、自己挑目标、自己搞钱：俄罗斯黑客的Phantom框架，把勒索软件玩成了自动化流水线</a></h5><p>2026-10-26 12:02:03</p></li><li><h5><a href=\"https://www.anquanke.com/post/id/316272\">你的对手不是人了：Claude+Grok组队，400家金融机构被AI全自动攻破</a></h5><p>2026-10-22 15:57:59</p></li><li><h5><a href=\"https://www.anquanke.com/post/id/316251\">3.5万次请求、翻找泄露密钥：失控AI智能体围猎高德地图，运营者却毫不知情</a></h5><p>2026-10-19 12:05:07</p></li></ul><p>文章目录</p><p><img src=\"/dailyinfo/media/8d1cf4ee801a1a9d.webp\" loading=\"lazy\" decoding=\"async\"></p><p>合作单位</p><ul><li><a href=\"http://www.cert.org.cn/\"><img alt=\"安全KER\" src=\"/dailyinfo/media/c99809111d862226.webp\" loading=\"lazy\" decoding=\"async\"></a></li><li><a href=\"http://www.cnnvd.org.cn/\"><img alt=\"安全KER\" src=\"/dailyinfo/media/8d556a74569855b3.webp\" loading=\"lazy\" decoding=\"async\"></a></li></ul><p><span>Copyright © 北京奇虎科技有限公司 三六零数字安全科技集团有限公司 安全KER All Rights Reserved </span><a href=\"https://beian.miit.gov.cn/\">京ICP备08010314号-66</a><span><a href=\"https://www.cnzz.com/stat/website.php?web_id=1271278035\" title=\"站长统计\"><img src=\"/dailyinfo/media/c337b3e07a5e0b3a.gif\" loading=\"lazy\" decoding=\"async\"></a></span></p>","original","zhKind","complete","工控","IoT","供应链","漏洞利用","https://www.anquanke.com/post/id/316435",{"_116":117,"_118":-5},"changelogVersion","2026-10-01T08:00","release"]
