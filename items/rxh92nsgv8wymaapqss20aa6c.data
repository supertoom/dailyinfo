[{"_1":2,"_3":4},"root",{"_5":217},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1794444098000,"id","rxh92nsgv8wymaapqss20aa6c","title","OpenSSH/musl 口令认证绕过漏洞分析与修复版本对比","originalTitle","OpenSSH/musl 口令认证绕过漏洞底层分析及修复版本对比剖析","summary","文章分析 OpenSSH portable 在 musl libc 且未启用 PAM 时的口令认证绕过，解释同一 TCP 连接内先失败一次后，257–1024 字节口令可绕过影子值为 * 的非 root 账户认证。","reason","通过源码逐行比对与隔离容器实测，文章补全了二次尝试的真正成因，并给出受影响窗口、修复差异和版本判定方法。","source",{"_75":216},"links",{"_208":215},"publishedAt","2026-11-10T02:16:08.000Z","discoveredAt","2026-11-11T10:08:41.396Z","timelineAt","category","disclosure","tags",[211,212,78,84,213,214],"score",82,"selected",true,"channel","news","story",{"_86":87,"_13":88},"x","readingMode","full","author","body",{"_61":207,"_208":-5,"_209":208,"_210":37},"outline",[89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126],"relatedStories",[85],"topics",[68,69,70,71,72],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fhd7aqH3veTg","reportCount",1,"additionalSourceCount",0,{"_73":83,"_75":84},{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","blue-team","name","蓝队与运营","research","技术研究","vuln","漏洞披露","crypto","密码学","identity","身份与访问",{"_86":87,"_13":88},"publicId","9752aa65-824d-43a4-962f-2d752946dc78","OpenSSH musl认证绕过漏洞已修复",{"_11":205,"_128":206,"_130":131},{"_11":203,"_128":204,"_130":131},{"_11":201,"_128":202,"_130":136},{"_11":199,"_128":200,"_130":131},{"_11":197,"_128":198,"_130":131},{"_11":195,"_128":196,"_130":136},{"_11":193,"_128":194,"_130":136},{"_11":191,"_128":192,"_130":136},{"_11":189,"_128":190,"_130":136},{"_11":187,"_128":188,"_130":136},{"_11":185,"_128":186,"_130":131},{"_11":183,"_128":184,"_130":136},{"_11":181,"_128":182,"_130":136},{"_11":179,"_128":180,"_130":131},{"_11":177,"_128":178,"_130":131},{"_11":175,"_128":176,"_130":136},{"_11":173,"_128":174,"_130":131},{"_11":171,"_128":172,"_130":136},{"_11":169,"_128":170,"_130":136},{"_11":167,"_128":168,"_130":136},{"_11":165,"_128":166,"_130":136},{"_11":163,"_128":164,"_130":136},{"_11":161,"_128":162,"_130":136},{"_11":159,"_128":160,"_130":131},{"_11":157,"_128":158,"_130":131},{"_11":155,"_128":156,"_130":131},{"_11":153,"_128":154,"_130":131},{"_11":151,"_128":152,"_130":131},{"_11":149,"_128":150,"_130":131},{"_11":147,"_128":148,"_130":131},{"_11":145,"_128":146,"_130":136},{"_11":143,"_128":144,"_130":136},{"_11":141,"_128":142,"_130":136},{"_11":139,"_128":140,"_130":136},{"_11":137,"_128":138,"_130":131},{"_11":134,"_128":135,"_130":136},{"_11":132,"_128":133,"_130":131},{"_11":127,"_128":129,"_130":131},"sec-38","text","REF","level",2,"sec-37","总结","sec-36","两个改写结论的机制",3,"sec-35","十、检测方法","sec-34","时间回溯","sec-33","已登录痕迹排查","sec-32","止损","sec-31","A. 暴露面判定","sec-30","九、应急响应处置","sec-29","八、上游修复分析","sec-28","环境关闭","sec-27","命令自查","sec-26","多次版本比对","sec-25","漏洞验证","sec-24","问题发现","sec-23","验证边界","sec-22","顺带修正的两处初稿判断","sec-21","漏洞修复对照：版本号说谎","sec-20","可利用窗口","sec-19","漏洞存在对照：链条端到端打通","sec-18","环境设计","sec-17","七、本地复现与结果对照","sec-16","回归起点：7.3p1","sec-15","六、影响范围与前置条件","sec-14","五、长度阈值差分验证","sec-13","缓存寿命等于一条 TCP 连接","sec-12","静态缓冲区的来源","sec-11","四、静态盐缓存与两次尝试","sec-10","环 5　失败返回值与影子条目逐字相等","sec-9","环 4　musl sha-crypt 的 256 字节上限","sec-8","环 3　NULL 盐与跨账户借盐","sec-7","环 2　单字符影子值跳过自带盐","sec-6","环 1　口令长度闸门与窗口上界","sec-5","三、根因链分析","sec-4","二、取证材料与证据分级","sec-3","触发条件：七条合取","sec-2","一、事件概述","sec-1","前言","<h2 id=\"sec-1\"><strong>前言</strong></h2><p>11 月初 sshhole 这份披露出来的时候，五步根因链读下来，最不踏实的是第 4 步，也就是\"触发前需要一次错误口令尝试\"那句。披露把原因归给静态缓冲区被覆盖，可怎么读都觉得只说了一半。手边刚好有几份上游源码包，就把 10.6p1 / 10.6p2 / 7.2p2 / 7.3p1 的 <code>auth-passwd.c</code> 和 <code>xcrypt.c</code> 拉出来逐行对了一遍，又把 musl 1.2.6 的 crypt 后端单独编了个探针，跑了下长度差分。</p><p>第一版写完之后，又在隔离容器里补了一轮实测：两个只绑 <code>127.0.0.1</code> 的 sshd 实例，一个已回移修复、一个源码未打补丁，把链条端到端跑了一遍。这一轮证伪了初稿两处判断，也把\"版本号能不能当判定依据\"钉死了，分别写在第七节和第十一节。证据分级的口径跟着改过，A 级现在包含本地实测。</p><p>后半篇是给运维看的：几条只读自查命令、止损顺序、能写成规则的检测点。所有 <code>file:line</code> 都指向解包后的源码正本，<code>sed -n</code> 能直接复核。复现部分只给到环境、判据和日志证据，PoC 与握手脚本不展开。</p><h2 id=\"sec-2\"><strong>一、事件概述</strong></h2><p>2026 年 11 月初，一份公开披露描述了 OpenSSH portable 在 musl libc 上的口令认证绕过：未启用 PAM 构建的 sshd，对影子字段恰好是单个 <code>*</code> 的账户，接受长度在 257 到 1024 字节之间的任意口令，前提是在同一条 TCP 连接内先失败一次。披露方给这个问题起名 sshhole。</p><p>证据按 A / B / C 分：A 是本机跑过或逐字读自源码正本的（含第七节那轮容器实测），B 是披露与公告里没法复现的结论，C 是单源未核实、文末单列。所有 <code>file:line</code> 都指向第二节表格里那几份 tar 包解包后的实物，<code>sed -n 'X,Yp'</code> 直接能复核。</p><p>几条结论先摆在这儿，依据后面逐条摊开。</p><ol><li><p>链条在源码层面成立，五环都能落到具体行（第三节）；这轮隔离环境里端到端跑通了，同连接第二次 <code>Accepted password</code>（第七节）。</p></li><li><p>披露对\"为什么需要第二次尝试\"的解释缺了决定性一环。让第二次不再被破坏的，是 <code>pick_salt()</code> 开头那两行的静态缓存短路（第四节）。</p></li><li><p>窗口只对借到 <code>$5$</code> 或 <code>$6$</code> 前缀的情况打开，实测可利用长度 257–1024 字节（第五节、第七节）。</p></li><li><p>10.6p2 的修复由两处互相独立的改动组成，只回移植其中一处会留下另一半（第八节）。</p></li><li><p>这条分支从 7.3p1 起存在；7.2p2 在同一位置写死 DES 盐 <code>xx</code>，不在窗口内（第六节）。</p></li><li><p><strong>版本号不能作为受影响判定依据</strong>：Alpine <code>10.3_p1-r2</code> 落在区间内却已回移修复，判定要落到二进制行为（第七节）。</p></li></ol><h3 id=\"sec-3\"><strong>触发条件：七条合取</strong></h3><p>披露把触发条件写成\"musl 无 PAM + 影子字段是 <code>*</code> + 超长口令\"，三个词。真到主机上要凑齐的远不止这些。七条合取、各自的源码依据、还有运维能直接跑的只读自查，图1 里都摆开了。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1001%2Fced3b761-a62.png&amp;mode=full&amp;exp=1794700800&amp;sig=ca1645d9d8f6ae0c\" loading=\"lazy\" decoding=\"async\"></p><p>第 5 条最容易看漏，展开说一下。<code>pick_salt()</code> 只认以 <code>$</code> 开头、且中间还有 <code>$</code> 的影子值（<code>xcrypt.c:85-87</code>），借来的前缀决定后面走哪条 crypt 后端，而长度阈值只写在 sha256 与 sha512 两条后端里。借到 md5 盐时，<code>crypt_md5.c:182</code> 的上限是 30000 字节，1024 字节的口令根本触不到；借到 blowfish 盐时，<code>crypt_blowfish.c:766</code> 直接调 <code>BF_crypt</code>，没有任何 key 长度拒绝；借到传统 DES 盐（也就是 <code>pick_salt()</code> 遍历失败时 <code>xcrypt.c:80</code> 写下的 <code>xx</code>）时，DES 把 key 截到 8 字节，多长的口令都是同一个结果。这三条都在第五节里实测过。</p><h2 id=\"sec-4\"><strong>二、取证材料与证据分级</strong></h2><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p><strong>材料</strong></p></th><th colspan=\"1\" rowspan=\"1\"><p><strong>sha256</strong></p></th><th colspan=\"1\" rowspan=\"1\"><p><strong>用途</strong></p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>src/openssh-10.6p1.tar.gz</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>a9dc9565dffe8640f64d863cd29a32bc4a3dbdec0566a7fc44c5d6ee767d5f39</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>漏洞版本正本，第三节/第四节的行号来源</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>src/openssh-10.6p2.tar.gz</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>9ae44872090cf2f06b3cf9ff147e7f16f309671340763ed2f99248398ae29d5b</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>修复版本正本，第八节的来源</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>src/openssh-7.2p2.tar.gz</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>a72781d1a043876a224ff1b0032daa4094d87565a68528759c1c2cab5482548c</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>回归点下界，第六节</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>src/openssh-7.3p1.tar.gz</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>3ffb989a6dcaa69594c3b550d4855a5a2e1718ccdde7f5e36387b424220fbecc</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>回归点上界，第六节</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>src/openssh-7.5p1.tar.gz</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>9846e3c5fab9f0547400b4d2c017992f914222b3fd1f8eee6c7dc6bc5e59f9f0</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>中间版本抽样，确认形态未再变化</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>src/musl-1.2.6.tar.gz</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>d585fd3b613c66151fc3249e8ed44f77020cb5e6c1e635a616d3f9f82460512a</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>crypt 后端与 passwd 读取，第五节的编译对象</p></td></tr></tbody></table><p>六份包的本机 <code>shasum -a 256</code> 结果汇总在 <code>src/sshhole-sources.sha256</code>。解包目录 <code>src/openssh-10.6p1/</code> 这些只拿来读，一个字没改；代码卡片是生成器从这些目录逐字切出来的。</p><p>探针与输出：</p><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p><strong>文件</strong></p></th><th colspan=\"1\" rowspan=\"1\"><p><strong>sha256</strong></p></th><th colspan=\"1\" rowspan=\"1\"><p><strong>内容</strong></p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>sshhole-evidence/probe.c</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>47106d5f4e505660d3b3558f18f4ab5ffbfba1d22daf0e9856b5d8b3526c4077</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>四条 sha/md5/blowfish 后端的长度差分探针</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>sshhole-evidence/des_probe.c</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>034d1e4fb8a319d608b741e528f0fbbc18b5a1012701ada9e4386222d4ee31ea</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>DES 后端探针</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>sshhole-evidence/run-probes.sh</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>c5e07a9f3a9058a06415c13194eb20744fd6e3167b21488582bae3e02fa038eb</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>编译与运行入口</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>sshhole-evidence/probe-output.txt</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>2f4050183e932c7ab8e1c7662f5de328a98f5d5cc8e4eef7d43e6b4a6af6eae7</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>首轮输出，第五节表格来源</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>sshhole-evidence/des-output.txt</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>85612d40b9f0b936f0fbed6d472b954f40f01c3c327ff06b4000aa2f12b8b726</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>DES 输出</p></td></tr></tbody></table><p>编译环境是 Apple clang 21.0.0，目标 arm64-apple-darwin25.3.0。2026-11-06 重跑 <code>run-probes.sh</code>，两份输出文件逐字节不变（上表哈希即重跑后计算）。</p><p><code>run-probes.sh</code> 只编译 musl 自带的 <code>src/crypt/*.c</code> 与 <code>src/passwd</code> 源文件，不链接 libc 装配层，也不启动 sshd，测到的是这份 C 源码里的阈值判断与返回值行为。进程内的指针别名关系探针碰不到，那部分后来在容器实测里补上了。</p><h2 id=\"sec-5\"><strong>三、根因链分析</strong></h2><p>披露给了五步。对着 10.6p1 与 musl 1.2.6 的具体行逐条核下来，五步都成立，但有两处得改：第 1 步的后端列举（第五节），第 4 步的因果（第四节）。图2 把五环串了起来，每环右边标着源码位置。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1001%2Fc667896f-d56.png&amp;mode=full&amp;exp=1794700800&amp;sig=c443e226e7f37ced\" loading=\"lazy\" decoding=\"async\"></p><h3 id=\"sec-6\"><strong>环 1　口令长度闸门与窗口上界</strong></h3><p><code>auth-passwd.c:70</code> 定义 <code>MAX_PASSWORD_LEN 1024</code>，<code>auth_password()</code> 的第一条语句就是长度检查：</p><pre><code>if (strlen(password) &gt; MAX_PASSWORD_LEN)\n &nbsp; &nbsp;return 0;</code></pre><p>位置在 <code>auth-passwd.c:86-87</code>，函数最前面，命中就返回。初稿据此判断\"超长口令不留日志\"，这轮实测站不住：<code>auth_log()</code> 在 <code>userauth_finish()</code> 里无条件执行（<code>auth2.c:407-408</code>），1023 / 1024 / 1025 / 2048 / 4096 字节的口令各产生恰好一条 <code>Failed password</code>。上界 1024 是含在内的，比较用的是 <code>&gt;</code> 不是 <code>&gt;=</code>。</p><h3 id=\"sec-7\"><strong>环 2　单字符影子值跳过自带盐</strong></h3><p><code>sys_auth_passwd()</code> 是整条链的主体，全文放卡片 C1。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1001%2F4fc1d863-a6f.png&amp;mode=full&amp;exp=1794700800&amp;sig=5c03bf12b5aa95cb\" loading=\"lazy\" decoding=\"async\"></p><p>三个位置决定成败。<code>auth-passwd.c:199</code> 取影子值：</p><pre><code>char *pw_password = authctxt-&gt;valid ? shadow_pw(pw) : pw-&gt;pw_passwd;</code></pre><p><code>auth-passwd.c:212-213</code> 决定要不要把影子值当盐用：</p><pre><code>if (authctxt-&gt;valid &amp;&amp; pw_password[0] &amp;&amp; pw_password[1])\n &nbsp; &nbsp;salt = pw_password;</code></pre><p><code>*</code> 的长度是 1，<code>pw_password[1]</code> 是 <code>'\\0'</code>，条件为假，<code>salt</code> 保持 <code>:196</code> 初始化的 NULL。紧接着 <code>:214</code> 把 NULL 交给 <code>xcrypt()</code>。</p><p><code>auth-passwd.c:205-206</code> 的空口令检查在这里不会拦下 <code>*</code>，它比的是 <code>pw_password</code> 与 <code>\"\"</code>，<code>*</code> 不等于空串。</p><h3 id=\"sec-8\"><strong>环 3　NULL 盐与跨账户借盐</strong></h3><p><code>xcrypt.c:106-107</code>：</p><pre><code>if (salt == NULL)\n &nbsp; &nbsp;salt = pick_salt();</code></pre><p><code>pick_salt()</code> 和 <code>xcrypt()</code> 的完整切片见卡片 C2。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1002%2F45174a2c-3f9.png&amp;mode=full&amp;exp=1794700800&amp;sig=3900bd8e2909c439\" loading=\"lazy\" decoding=\"async\"><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1002%2Ff8640bdd-bba.png&amp;mode=full&amp;exp=1794700800&amp;sig=f6d94a34f95e8c1e\" loading=\"lazy\" decoding=\"async\"></p><p><code>xcrypt.c:76</code> 的 <code>static char salt[32];</code> 是进程内静态变量，<code>:78-79</code> 是非空即返回的短路，<code>:80</code> 先把传统 DES 盐 <code>xx</code> 写进去兜底，<code>:82-90</code> 遍历 <code>/etc/passwd</code>，对每个账户调 <code>shadow_pw()</code>，取第一个形如 <code>$…$</code> 的影子值，把算法前缀抄进 <code>salt</code>：</p><pre><code>strlcpy(salt, passwd, MINIMUM(typelen, sizeof(salt)));\nexplicit_bzero(passwd, strlen(passwd));</code></pre><p><code>xcrypt.c:87-88</code> 这两行是第四节的核心。<code>passwd</code> 来自 <code>shadow_pw()</code>，而 <code>shadow_pw()</code> 在 <code>xcrypt.c:137</code> 与 <code>:155</code> 直接把 <code>spw-&gt;sp_pwdp</code> 返回给调用方，中间没有任何拷贝。在 musl 上，这个指针指向一块进程内静态缓冲区，于是 <code>:88</code> 的 <code>explicit_bzero</code> 清零的对象，正是上一层 <code>sys_auth_passwd()</code> 里 <code>pw_password</code> 指着的那块内存。</p><h3 id=\"sec-9\"><strong>环 4　musl sha-crypt 的 256 字节上限</strong></h3><p>musl 的 <code>crypt()</code> 是 <code>src/crypt/crypt.c:4-14</code>，它把结果写进一个 <code>static char buf[128]</code>，再交给 <code>__crypt_r()</code> 按前缀分派（<code>crypt_r.c:10-20</code>）：<code>$1$</code> 走 md5，<code>$2$</code> 系列走 blowfish，<code>$5$</code> 走 sha256，<code>$6$</code> 走 sha512，其余走 DES。</p><p>sha512 后端关键的三段，卡片 C3。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1002%2F67120e37-c38.png&amp;mode=full&amp;exp=1794700800&amp;sig=2f97e9466fb7f8b2\" loading=\"lazy\" decoding=\"async\"><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1002%2Fa1a02e01-ad9.png&amp;mode=full&amp;exp=1794700800&amp;sig=ff012cf6553024cb\" loading=\"lazy\" decoding=\"async\"></p><p><code>crypt_sha512.c:192</code> 定义 <code>KEY_MAX 256</code>，<code>:218-220</code> 是拒绝逻辑：</p><pre><code>for (i = 0; i &lt;= KEY_MAX &amp;&amp; key[i]; i++);\nif (i &gt; KEY_MAX)\n &nbsp; &nbsp;return 0;</code></pre><p>内层函数返回 NULL 之后，外层包装 <code>__crypt_sha512</code> 在 <code>crypt_sha512.c:368-369</code> 把它换成字面量 <code>\"*\"</code>：</p><pre><code>if (!p || q != testbuf || memcmp(testbuf, testhash, sizeof testhash))\n &nbsp; &nbsp;return \"*\";</code></pre><p>这条 <code>if</code> 还兼着自我测试，<code>!p</code> 那一支就是长度拒绝的出口。</p><h3 id=\"sec-10\"><strong>环 5　失败返回值与影子条目逐字相等</strong></h3><p>回到 <code>auth-passwd.c:220-221</code>：</p><pre><code>return encrypted_password != NULL &amp;&amp;\n &nbsp; &nbsp;strcmp(encrypted_password, pw_password) == 0;</code></pre><p><code>encrypted_password</code> 是 <code>\"*\"</code>，非 NULL；<code>pw_password</code> 是 <code>\"*\"</code>；<code>strcmp</code> 返回 0。函数返回 1。<code>auth_password()</code> 在 <code>:128</code> 把它与 <code>ok</code> 相与后返回，<code>ok</code> 取自 <code>:81</code> 的 <code>authctxt-&gt;valid</code>，账户存在即为真。</p><p><code>auth-passwd.c:220</code> 的 <code>!= NULL</code> 是 sshd 侧唯一的失败防御，它假设的是 glibc 语义：crypt 失败返回 NULL。musl 的 <code>crypt()</code> 不返回 NULL：<code>crypt.c:13</code> 把 <code>__crypt_r()</code> 的返回值原样转出去，<code>crypt_r.c:11-20</code> 的五条分支各自返回缓冲区指针或字面量，没有 NULL 出口。失败的信号就是字面 <code>\"*\"</code>，而这个字符在 <code>/etc/shadow</code> 里另有含义（\"此账户没有口令\"）。两种语义撞在了一起，<code>strcmp</code> 把\"加密失败\"读成了\"口令正确\"。</p><h2 id=\"sec-11\"><strong>四、静态盐缓存与两次尝试</strong></h2><p>披露第 4 步说，第一次尝试是必要前置，因为 <code>pick_salt()</code> 遍历 <code>/etc/passwd</code> 调 <code>getspnam()</code> 时，musl 的静态缓冲区会把 <code>pw_password</code> 指着的 <code>*</code> 覆盖掉。观测没错，因果写反了一半：覆盖是第一次失败的原因，跟第二次为什么成功没关系。</p><p>真正让第二次成功的，是 <code>xcrypt.c:78-79</code> 那两行短路。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1003%2F846e6bad-a48.png&amp;mode=full&amp;exp=1794700800&amp;sig=b95258ec8c090f8c\" loading=\"lazy\" decoding=\"async\"></p><p>第一次尝试：<code>pw_password</code> 指向 musl 的静态影子缓冲区，内容是 <code>*</code>；<code>salt</code> 为 NULL；<code>pick_salt()</code> 进入遍历，借到 <code>$6$BobSalt1$</code> 这样的前缀，然后 <code>explicit_bzero</code> 把借来的那一行清零。清零作用在同一块缓冲区上，于是 <code>sys_auth_passwd()</code> 手里的 <code>pw_password</code> 此刻读成空串。口令短，未触阈值，<code>crypt()</code> 返回真哈希。<code>strcmp(真哈希, \"\")</code> 不相等，认证失败。</p><p>披露给的观测值是 <code>strcmp</code> 返回 36。36 是 <code>'$'</code> 的 ASCII 码，正好是哈希首字节，说明比较的另一边是空串。跟我从源码推出来的对得上。</p><p>第二次尝试：<code>sys_auth_passwd()</code> 重新调 <code>shadow_pw()</code>，<code>getspnam()</code> 把 <code>*</code> 重新填回同一块缓冲区，<code>pw_password</code> 又是 <code>*</code>；<code>salt</code> 仍是 NULL；<code>xcrypt()</code> 走进 <code>pick_salt()</code>，<code>salt[0]</code> 已经不是 <code>'\\0'</code>，直接 return，既不遍历也不清零。口令 257 字节以上，<code>crypt()</code> 返回 <code>\"*\"</code>，<code>strcmp(\"*\", \"*\") == 0</code>，通过。</p><p>关键是第二次得跳过 <code>pick_salt()</code> 的遍历。照常遍历的话，<code>pw_password</code> 又会被清零，还是失败。所以起作用的是两件事凑一块：第一次把静态缓存填好了，第二次就不走那段有副作用的代码。只说\"第一次留下了副作用\"，顶多讲了前半。</p><h3 id=\"sec-12\"><strong>静态缓冲区的来源</strong></h3><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1003%2F436f911d-93d.png&amp;mode=full&amp;exp=1794700800&amp;sig=abc6d1b8150bf4d2\" loading=\"lazy\" decoding=\"async\"><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1003%2Fcf3762ff-b2b.png&amp;mode=full&amp;exp=1794700800&amp;sig=183d4cb80535a06e\" loading=\"lazy\" decoding=\"async\"></p><p><code>musl-1.2.6/src/passwd/getspnam.c:7-8</code> 是两个进程内静态变量：</p><pre><code>static struct spwd sp;\nstatic char *line;</code></pre><p><code>:15</code> 把 <code>line</code> 作为缓冲区传给 <code>getspnam_r()</code>。<code>getspnam_r.c:108</code> 用 <code>fgets</code> 把匹配行读进这块缓冲区，<code>:118</code> 调 <code>__parsespent()</code>，后者在 <code>getspnam_r.c:29</code> 把 <code>sp-&gt;sp_pwdp</code> 直接指向缓冲区内部的字符位置，不做拷贝。于是任何两次 <code>getspnam()</code> 调用返回的 <code>sp_pwdp</code> 指向同一块内存，后一次覆盖前一次。</p><p>OpenSSH 10.6p1 的 <code>shadow_pw()</code> 没有拷贝，<code>pick_salt()</code> 又在拿到指针后清零它。这两件事叠在一起才产生环 3 里那个跨函数的别名。</p><h3 id=\"sec-13\"><strong>缓存寿命等于一条 TCP 连接</strong></h3><p><code>pick_salt()</code> 的 <code>salt[32]</code> 是进程内静态变量。privsep 子进程 <code>sshd-auth</code> 按连接新建：<code>sshd-session.c:363-364</code> 用 <code>execv(options.sshd_auth_path, saved_argv)</code> 起新进程，可执行文件路径来自 <code>pathnames.h:53-54</code> 的 <code>_PATH_SSHD_AUTH</code>。新进程意味着 <code>salt[32]</code> 回到全零。</p><p>所以\"先失败一次\"这个前置条件的寿命正好是一条 TCP 连接。断开重连，缓存清空，又得先失败一次。这也解释了为什么 PoC 要在同一个 <code>Transport</code> 上连发两次认证请求，而不是起两条连接。</p><h2 id=\"sec-14\"><strong>五、长度阈值差分验证</strong></h2><p>五环里只有环 4 不用起 sshd 就能测：musl 各 crypt 后端在不同 key 长度下到底返回什么。做法也简单，把 musl 1.2.6 自带的后端源文件直接编进探针，按长度逐个调，打印返回值类型和 <code>strcmp(ret, \"*\")</code>。</p><p>命令：</p><pre><code>sh sshhole-evidence/run-probes.sh</code></pre><p>脚本从 <code>src/musl-1.2.6/src/crypt</code> 取源文件，编译两个探针，输出写回 <code>probe-output.txt</code> 与 <code>des-output.txt</code>。实测结果：</p><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p><strong>借到的前缀</strong></p></th><th colspan=\"1\" rowspan=\"1\"><p><strong>后端</strong></p></th><th colspan=\"1\" rowspan=\"1\"><p><strong>1–256 字节</strong></p></th><th colspan=\"1\" rowspan=\"1\"><p><strong>257 字节</strong></p></th><th colspan=\"1\" rowspan=\"1\"><p><strong>300 字节</strong></p></th><th colspan=\"1\" rowspan=\"1\"><p><strong>1024 字节</strong></p></th><th colspan=\"1\" rowspan=\"1\"><p><strong>1025 字节</strong></p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>$1$</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>md5</p></td><td colspan=\"1\" rowspan=\"1\"><p>真哈希</p></td><td colspan=\"1\" rowspan=\"1\"><p>真哈希</p></td><td colspan=\"1\" rowspan=\"1\"><p>真哈希</p></td><td colspan=\"1\" rowspan=\"1\"><p>真哈希</p></td><td colspan=\"1\" rowspan=\"1\"><p>真哈希</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>$5$</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>sha256</p></td><td colspan=\"1\" rowspan=\"1\"><p>真哈希</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>\"*\"</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>\"*\"</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>\"*\"</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>\"*\"</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>$6$</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>sha512</p></td><td colspan=\"1\" rowspan=\"1\"><p>真哈希</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>\"*\"</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>\"*\"</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>\"*\"</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>\"*\"</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>$2b$</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>blowfish</p></td><td colspan=\"1\" rowspan=\"1\"><p>真哈希</p></td><td colspan=\"1\" rowspan=\"1\"><p>真哈希</p></td><td colspan=\"1\" rowspan=\"1\"><p>真哈希</p></td><td colspan=\"1\" rowspan=\"1\"><p>真哈希</p></td><td colspan=\"1\" rowspan=\"1\"><p>真哈希</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>xx</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>DES</p></td><td colspan=\"1\" rowspan=\"1\"><p>13 字符哈希</p></td><td colspan=\"1\" rowspan=\"1\"><p>同左</p></td><td colspan=\"1\" rowspan=\"1\"><p>同左</p></td><td colspan=\"1\" rowspan=\"1\"><p>同左</p></td><td colspan=\"1\" rowspan=\"1\"><p>同左</p></td></tr></tbody></table><p>\"真哈希\"列的具体值形如 <code>$6$BobSalt1$k73x…</code>，<code>strcmp(ret, \"*\")</code> 返回 -6（<code>'$'</code> 减 <code>'*'</code>）。<code>\"*\"</code> 列的 <code>strcmp(ret, \"*\")</code> 返回 0。DES 那行在 keylen 8、256、257、300、1024 下返回同一个 <code>xxJJqYuu8A9oE</code>，<code>strcmp(ret, \"*\")</code> 返回 78（<code>'x'</code> 减 <code>'*'</code>），说明 DES 把 key 截断到 8 字节后不再看后面的内容。</p><p>四条后端的阈值来源分别是：<code>crypt_sha256.c:171</code> 与 <code>crypt_sha512.c:192</code> 的 <code>KEY_MAX 256</code>，<code>crypt_md5.c:182</code> 的 <code>KEY_MAX 30000</code>，<code>crypt_blowfish.c:766</code> 无长度检查。失败返回 <code>\"*\"</code> 的位置是 <code>crypt_sha256.c:320</code>、<code>crypt_sha512.c:369</code>、<code>crypt_md5.c:283</code>、<code>crypt_blowfish.c:805</code>，DES 在 <code>crypt_des.c:1015</code>，且它多一个分支：<code>setting[0] == '*'</code> 时返回 <code>\"x\"</code>。</p><p>影响面到这儿就收窄了。窗口要求借来的盐是 <code>$5$</code> 或 <code>$6$</code>，而 <code>pick_salt()</code> 取的是遍历 <code>/etc/passwd</code> 遇到的第一个符合 <code>$…$</code> 形态的值（<code>xcrypt.c:82-90</code>），顺序由 NSS 与 passwd 文件行序决定，不由攻击者控制。一个系统如果所有口令哈希都是 yescrypt（<code>$y$</code>）或 blowfish（<code>$2b$</code>），链子同样断在环 4：<code>$2b$</code> 走 blowfish 后端，实测里没有长度拒绝；<code>$y$</code> 在 <code>crypt_r.c:11-18</code> 的四条分支里都不匹配，落到 <code>:20</code> 的 DES，返回 13 字符哈希。Alpine 默认用 sha512，所以主流情形仍在窗口内。</p><h2 id=\"sec-15\"><strong>六、影响范围与前置条件</strong></h2><p>披露给的范围是\"2016 年以来至 10.6p2 之前，运行于 musl libc 且未启用 PAM 的 sshd\"。源码层面能确认的更细一些。</p><p>PAM 分支的短路在 <code>auth-passwd.c:115-116</code>：</p><pre><code>#ifdef USE_PAM\n &nbsp; &nbsp;if (options.use_pam)\n &nbsp; &nbsp; &nbsp; &nbsp;return (sshpam_auth_passwd(authctxt, password) &amp;&amp; ok);\n#endif</code></pre><p>开了 PAM 就到不了 <code>sys_auth_passwd()</code>。Alpine 的 openssh 端口同时构建带 PAM 与不带 PAM 两种 flavor，<code>APKBUILD:181</code> 的 <code>_do_configure --without-kerberos5 --without-pam</code> 是无 PAM 那一支，<code>APKBUILD:319-326</code> 的 <code>server()</code> 函数把 <code>usr/sbin/sshd</code>、<code>usr/lib/ssh/sshd-auth</code>、<code>usr/lib/ssh/sshd-session</code> 装进默认包，带 PAM 的版本在另一个带 flavor 后缀的包里（<code>APKBUILD:328-341</code>）。按这份 APKBUILD 读出来的结果，装默认 <code>openssh-server</code> 的镜像走的是无 PAM 分支。这轮容器实测里 <code>sshd -T</code> 完全没有 <code>usepam</code> 键，比读配方更直接，这条从 B 级升成了 A 级。</p><p><code>PasswordAuthentication</code> 默认开启，<code>servconf.h:198</code> 的默认值是 1；<code>sshd_config:58</code> 的 <code>#PasswordAuthentication yes</code> 是同一件事的配置面表述。</p><p>两道闸门会拦掉一部分账户。</p><p>第一道是锁定账户检查，<code>auth.c:108-112</code>：</p><pre><code>if (!options.use_pam &amp;&amp; platform_locked_account(pw)) {\n &nbsp; &nbsp;logit(\"User %.100s not allowed because account is locked\",\n &nbsp; &nbsp; &nbsp; &nbsp;pw-&gt;pw_name);\n &nbsp; &nbsp;return 0;\n}</code></pre><p>留意条件里的 <code>!options.use_pam</code>：只有无 PAM 构建才走这道检查，正好是这条链要走的那一支。<code>platform.c:157-214</code> 的实现比对三种模式，Linux 上生效的是 <code>LOCKED_PASSWD_PREFIX</code>，<code>configure.ac:971-972</code> 把它定义成 <code>\"!\"</code>。结论是：影子值以 <code>!</code> 开头的账户在 <code>allowed_user()</code> 阶段就被拒绝，日志里能看到 <code>account is locked</code>；影子值恰好是 <code>*</code> 的账户不匹配任何锁定模式，放行到口令认证。同一份 configure 在 HP-UX 分支里用的是 <code>LOCKED_PASSWD_STRING</code>，值正好是 <code>\"*\"</code>（<code>configure.ac:880-881</code>），那边同类账户会被拦下。musl 主要跑在 Linux 上，享受不到这条定义。</p><p>第二道是 shell 检查，<code>auth.c:118-132</code>：shell 不存在或不可执行则拒绝。大量 <code>*</code> 账户的 shell 是 <code>/sbin/nologin</code>，只要该文件存在且可执行，这道闸门拦不住。各发行版给系统账户配的默认 shell 我没逐一实测，B 级，文末单列。</p><p>root 另有一道：<code>auth-passwd.c:90-91</code> 在 <code>pw-&gt;pw_uid == 0</code> 且 <code>permit_root_login != PERMIT_YES</code> 时把 <code>ok</code> 置 0，<code>:128</code> 的 <code>result &amp;&amp; ok</code> 因此为假。<code>sshd_config:33</code> 的默认注释值是 <code>#PermitRootLogin prohibit-password</code>。所以\"可直取 root\"这个说法要加限定：默认配置下 root 走不到通过，披露自己的复现步骤也显式设了 <code>PermitRootLogin yes</code>。非 root 的 <code>*</code> 账户不受这条限制。</p><h3 id=\"sec-16\"><strong>回归起点：7.3p1</strong></h3><p><code>sys_auth_passwd()</code> 在 7.2p2 和 7.3p1 里长得不一样，卡片 C6 并排摆着。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1003%2Fe6f7aabe-9b8.png&amp;mode=full&amp;exp=1794700800&amp;sig=aa767ddb0b8b05a8\" loading=\"lazy\" decoding=\"async\"><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1004%2Fe16aeff8-5f0.png&amp;mode=full&amp;exp=1794700800&amp;sig=0f0c0cc824de7aaa\" loading=\"lazy\" decoding=\"async\"></p><p>7.2p2 的 <code>auth-passwd.c</code> 文件头是 <code>/* $OpenBSD: auth-passwd.c,v 1.44 2014/07/15 15:54:14 millert Exp $ */</code>，<code>:205-207</code> 直接把盐写死：</p><pre><code>encrypted_password = xcrypt(password,\n &nbsp;  (pw_password[0] &amp;&amp; pw_password[1]) ? pw_password : \"xx\");</code></pre><p>影子值是 <code>*</code> 时传 <code>\"xx\"</code>，走 DES，返回 13 字符哈希，与 <code>*</code> 不相等。这一版不在窗口内，而且它根本不进 <code>pick_salt()</code>。</p><p>7.3p1 的文件头是 <code>v 1.45 2016/07/21 01:39:35 dtucker Exp</code>，<code>:69</code> 出现 <code>MAX_PASSWORD_LEN</code>，<code>:92</code> 是长度检查，<code>:214-216</code> 改成先赋 NULL 再交给 <code>xcrypt()</code>：</p><pre><code>if (authctxt-&gt;valid &amp;&amp; pw_password[0] &amp;&amp; pw_password[1])\n &nbsp; &nbsp;salt = pw_password;\nencrypted_password = xcrypt(password, salt);</code></pre><p>从这一版起，<code>*</code> 账户的盐来源从写死的 <code>xx</code> 变成了\"去系统里借\"，环 3 才存在。7.5p1 的同一函数与 7.3p1 形态一致（<code>:214-216</code> 逐字相同），此后到 10.6p1 没有再变。</p><p>所以受影响的分支起点是 OpenSSH portable 7.3p1，2016-07-21。披露给的\"2016 年以来\"与此一致，只是没有精确到版本。</p><p>还有一件初稿没料到的事：发行版会把 10.6p2 的修复回移到老版本号上。Alpine <code>openssh-server 10.3_p1-r2</code> 名义上落在 7.3p1–10.6p1 区间，实际已经带上 <code>MIN_PASSWORD_HASH_LEN 4</code>，两次尝试都 <code>denied</code>。所以上面的版本范围只是源码层面的起点，实际判定得看二进制行为，第七节 给了黑盒和反汇编两条路。</p><h2 id=\"sec-17\"><strong>七、本地复现与结果对照</strong></h2><p>源码推到这儿，链条看着是通的，但\"看着通\"和\"真能登进去\"是两回事。所以又搭了一轮隔离环境，把两端都钉死。</p><h3 id=\"sec-18\"><strong>环境设计</strong></h3><p>容器 <code>sshhole-test</code> 跑 <code>alpine:latest</code>（aarch64，Alpine 3.24.3 + musl）。两个 sshd 实例都只绑 <code>127.0.0.1</code>，没向宿主机发布端口，全程无外部流量：</p><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p><strong>实例</strong></p></th><th colspan=\"1\" rowspan=\"1\"><p><strong>端口</strong></p></th><th colspan=\"1\" rowspan=\"1\"><p><strong>用途</strong></p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>Alpine 包版 <code>openssh-server 10.3_p1-r2</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>2222</p></td><td colspan=\"1\" rowspan=\"1\"><p>阴性对照：版本号落在受影响区间，但已回移修复</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>源码自编 <code>openssh-10.6p1</code>（unpatched）</p></td><td colspan=\"1\" rowspan=\"1\"><p>2223</p></td><td colspan=\"1\" rowspan=\"1\"><p>阳性对照</p></td></tr></tbody></table><p>账户按窗口形态配：<code>realuser</code> / <code>testuser</code> 是真实 <code>$6$</code> 哈希（供借盐，排在 <code>/etc/passwd</code> 前面），<code>staruser</code> / <code>nologinuser</code> 影子值为 <code>*</code>，<code>lockeduser</code> 为 <code>!locked</code>，root 也是 <code>*</code>。</p><p>阳性对照不能用 <code>apk add openssh-server</code>，装到的就是回移过修复的包。必须从源码编：</p><pre><code># musl 容器内\napk add build-base openssl-dev zlib-dev linux-headers\n./configure --prefix=/opt/ssh-vuln --sysconfdir=/opt/ssh-vuln/etc \\\n &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;--with-privsep-path=/opt/ssh-vuln/var/empty --without-pam\nmake -j\"$(nproc)\" &amp;&amp; make install</code></pre><p>编之前 <code>grep -c MIN_PASSWORD_HASH_LEN auth-passwd.c</code> 返回 0，确认源码未打补丁；<code>sshd -t</code> 报 <code>Unsupported option UsePAM</code>，比 <code>ldd | grep pam</code> 更硬的无 PAM 确证。</p><p>四条自查命令在容器里原样跑过，输出与第九节一致。前缀分布是关键：</p><pre><code>! &nbsp; &nbsp;  17\n* &nbsp; &nbsp;  3\n$6$ &nbsp;  2</code></pre><p>存在可借的 <code>$6$</code> 盐，<code>pick_salt()</code> 有料可借；<code>staruser</code> / <code>nologinuser</code> 两个 <code>*</code> 账户都走到了 <code>Failed password</code>，<code>lockeduser</code> 被 <code>account is locked</code> 拦下，第六节那道锁定闸门在真实 sshd 里如预期生效。</p><h3 id=\"sec-19\"><strong>漏洞存在对照：链条端到端打通</strong></h3><p>同一条 TCP 连接内对 <code>staruser</code> 连发两次 257 字节口令：</p><pre><code>negotiated: SSH-2.0-OpenSSH_10.6\nattempt #1 (len=257): denied\nattempt #2 (len=257): *** ACCEPTED ***</code></pre><p>服务端日志：</p><pre><code>Connection from 127.0.0.1 port 52146 on 127.0.0.1 port 2223 rdomain \"\"\nFailed password for staruser from 127.0.0.1 port 52146 ssh2\nAccepted password for staruser from 127.0.0.1 port 52146 ssh2</code></pre><p>同源端口 <code>52146</code> 上 <code>Failed</code> 紧跟 <code>Accepted</code>。第九节那条检测正则在真实实例上被完整复现，也是整套检测里唯一实测可靠的入侵信号。</p><p>只发一次恒 <code>denied</code>：第一次 <code>pick_salt()</code> 遍历借盐时，<code>pw_password</code> 指向的静态缓冲被写成 <code>testuser</code> 的哈希，<code>strcmp</code> 不等；第二次缓存短路不再遍历，才拿到干净的 <code>\"*\"</code>。跟第四节推的一致。</p><h3 id=\"sec-20\"><strong>可利用窗口</strong></h3><p>每次新连接、连发两次、目标 <code>staruser</code>：</p><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p><strong>口令长度</strong></p></th><th colspan=\"1\" rowspan=\"1\"><p><strong>结果</strong></p></th><th colspan=\"1\" rowspan=\"1\"><p><strong>断点</strong></p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>8 / 256</p></td><td colspan=\"1\" rowspan=\"1\"><p>denied, denied</p></td><td colspan=\"1\" rowspan=\"1\"><p>环 4：musl 返回真哈希</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>257</p></td><td colspan=\"1\" rowspan=\"1\"><p>denied, <strong>ACCEPTED</strong></p></td><td colspan=\"1\" rowspan=\"1\"><p>下边界，<code>KEY_MAX 256</code> +1</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>1024</p></td><td colspan=\"1\" rowspan=\"1\"><p>denied, <strong>ACCEPTED</strong></p></td><td colspan=\"1\" rowspan=\"1\"><p>上边界，<code>MAX_PASSWORD_LEN 1024</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>1025</p></td><td colspan=\"1\" rowspan=\"1\"><p>denied, denied</p></td><td colspan=\"1\" rowspan=\"1\"><p>环 1 提前 <code>return 0</code></p></td></tr></tbody></table><p>窗口实测 <strong>257–1024 字节</strong>，宽 768 字节，必须落在窗口内、必须连发两次。跟第三节环 1 与环 4 的推导完全吻合。</p><h3 id=\"sec-21\"><strong>漏洞修复对照：版本号说谎</strong></h3><p>同一套操作打 2222，两次都 <code>denied</code>。借盐（环 3）和 musl 长度拒绝（环 4）在真实 sshd 里其实都发生了。用 <code>LD_PRELOAD</code> 拦 <code>crypt()</code> 能看到 <code>crypt(keylen=257, setting=$6$JwcdvV..S5mbmiyC) -&gt; \"*\"</code>，第二次调用前没有 <code>setpwent()</code> 遍历，静态缓存短路同样生效。断点在环 5。</p><p>反汇编 <code>/usr/lib/ssh/sshd-auth</code> 的 <code>sys_auth_passwd</code>：</p><pre><code>a980:  bl &nbsp; strlen &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ; strlen(pw_password) == 1\na98c:  cmp  x0, #0x3 &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ; ★ 对应 MIN_PASSWORD_HASH_LEN 4\na990:  b.ls a9c0 &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ; ★ 1 &lt;= 3 -&gt; 直接失败\na994:  ... strcmp(encrypted, pw_password)</code></pre><p><code>strcmp</code> 前多出长度闸门，且 <code>shadow_pw()</code> 的结果在 <code>a924</code> / <code>a928</code> 被 <code>free</code>（说明已改成 <code>xstrdup()</code> 副本）。发行版把第八节那两处修复都回移了。自编 10.6p1 的同一位置是 <code>bl strcmp</code> 前什么都没有、<code>shadow_pw</code> 结果也不 <code>free</code>：</p><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p><strong>检查项</strong></p></th><th colspan=\"1\" rowspan=\"1\"><p><strong>自编 10.6p1（受影响）</strong></p></th><th colspan=\"1\" rowspan=\"1\"><p><strong>Alpine 10.3_p1-r2（已修复）</strong></p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>strcmp</code> 前 <code>strlen</code> + <code>cmp #0x3</code> + <code>b.ls</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>无</p></td><td colspan=\"1\" rowspan=\"1\"><p>有</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>shadow_pw</code> 结果被 <code>free</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>无（裸指针）</p></td><td colspan=\"1\" rowspan=\"1\"><p>有</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>源码含 <code>MIN_PASSWORD_HASH_LEN</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>无</p></td><td colspan=\"1\" rowspan=\"1\"><p>有（回移）</p></td></tr></tbody></table><p>结论很直接：<strong>版本号不能作为受影响判定依据</strong>。回移会让老版本号带上新修复，也会让没回移的实例被误标为安全。判定要落到二进制行为：</p><pre><code># 黑盒：对 * 账户连发两次 257 字节口令，两次都 denied -&gt; 已修复（不论版本号）\n# 静态：在 strcmp 调用前找长度闸门\nobjdump -d /usr/lib/ssh/sshd-auth | grep -B2 -A2 \"cmp.*#0x3\"</code></pre><h3 id=\"sec-22\"><strong>顺带修正的两处初稿判断</strong></h3><ul><li><p><strong>\"超长口令不留日志\"是错的</strong>。<code>auth_log()</code> 在 <code>userauth_finish()</code> 里无条件执行（<code>auth2.c:407-408</code>），和 <code>auth-passwd.c:86-87</code> 的提前返回无关。1023 / 1024 / 1025 / 2048 / 4096 字节各产生恰好一条 <code>Failed password</code>。第十节\"超长口令无日志\"这条信号得删掉。</p></li><li><p><strong>PAM 探测有更干净的方式</strong>。容器里 <code>sshd -T</code> 输出完全没有 <code>usepam</code> 键，<code>grep -c usepam</code> 返回 0 即无 PAM flavor，比 <code>ldd | grep pam</code> 直接。初稿\"只读了 APKBUILD，没解包二进制核对\"的 B 级限定由此升成 A 级。</p></li></ul><h3 id=\"sec-23\"><strong>验证边界</strong></h3><p>全程隔离容器，sshd 只绑 <code>127.0.0.1</code>，未向宿主机发布端口，未对任何外部主机发包。这轮验证只用于确认检测规则能区分受影响与已修复实例；PoC 输出、口令构造与完整握手脚本不在此展开。</p><h2 id=\"sec-24\">问题发现</h2><p>证明版本问题：</p><pre><code># 先看 2223 的版本号——名义上在受影响区间内\ndocker exec sshhole-test /opt/ssh-vuln/sbin/sshd -V\n\n# 再看 2222 的版本号——10.3p1，同样落在 7.3p1–10.6p1 区间\ndocker exec sshhole-test /usr/sbin/sshd -V</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1004%2F64872799-d5b.png&amp;mode=full&amp;exp=1794700800&amp;sig=c15e99cd5055dcc6\" loading=\"lazy\" decoding=\"async\"></p><h2 id=\"sec-25\">漏洞验证</h2><pre><code>/tmp/sshhole.exp 2223 staruser 257</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1005%2Fc217f351-a8f.png&amp;mode=full&amp;exp=1794700800&amp;sig=227a73bb35226acc\" loading=\"lazy\" decoding=\"async\"></p><p>服务端日志（同源端口 Failed→Accepted）</p><pre><code>docker exec sshhole-test tail -20 /var/log/sshd-vuln.log</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1010%2Ff60bf899-0cf.png&amp;mode=full&amp;exp=1794700800&amp;sig=35d46dcce775eee5\" loading=\"lazy\" decoding=\"async\"></p><h2 id=\"sec-26\">多次版本比对</h2><p>修复版本对照 — 同样的操作打 2222</p><pre><code>/tmp/sshhole.exp 2222 staruser 257</code></pre><p>必须两次 — 只发一次口令打 2223</p><pre><code>/tmp/sshhole1.exp</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1011%2Fd836e031-f34.png&amp;mode=full&amp;exp=1794700800&amp;sig=2f66b388e5b772d5\" loading=\"lazy\" decoding=\"async\"></p><p>可利用窗口是 257–1024 字节</p><pre><code>for L in 8 256 257 1024 1025; do\n  printf \"len=%-5s -&gt; \" \"$L\"\n  /tmp/sshhole.exp 2223 staruser \"$L\" 2&gt;&amp;1 | grep -q PWNED &amp;&amp; echo \"ACCEPTED\" || echo \"denied\"\n  echo\ndone</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1011%2F5eec748c-9f2.png&amp;mode=full&amp;exp=1794700800&amp;sig=116df67fad4cf9b2\" loading=\"lazy\" decoding=\"async\"></p><p>反汇编对照（断点根因）</p><pre><code># 受影响版：strcmp 前没有长度闸门\ndocker exec sshhole-test objdump -d --disassemble=sys_auth_passwd \\\n  /build/openssh/sshd-auth | tail -20\n\n# 已修复版：反汇编里能搜到长度闸门\ndocker exec sshhole-test objdump -d /usr/lib/ssh/sshd-auth \\\n  | grep -B2 -A2 \"cmp.*#0x3\" | head -20\n</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1012%2Fc0f405cd-bdd.png&amp;mode=full&amp;exp=1794700800&amp;sig=2af2095338514091\" loading=\"lazy\" decoding=\"async\"></p><p>受影响版的关键三行（<code>bl strcmp</code> 前什么都没有）：</p><pre><code>e6d0:  ldr  x1, [sp, #16]\ne6d4:  bl &nbsp; be00 &lt;strcmp@plt&gt; &nbsp;  ; ★ 直接比较\ne6d8:  cmp  w0, #0x0</code></pre><p>已修复版在 <code>strcmp</code> 前多出：</p><pre><code>a980:  bl &nbsp; strlen &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ; strlen(\"*\") = 1\na98c:  cmp  x0, #0x3 &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ; ★ 1 &lt;= 3 ?\na990:  b.ls a9c0 &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ; ★ 是 -&gt; 直接失败</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1013%2Fb3d1c0ef-df5.png&amp;mode=full&amp;exp=1794700800&amp;sig=cf05201816b40ef1\" loading=\"lazy\" decoding=\"async\"></p><h2 id=\"sec-27\">命令自查</h2><p>四条自查命令</p><pre><code>docker exec sshhole-test sh -c '\n  echo \"=== A: musl 链接 ===\"\n  ldd /opt/ssh-vuln/sbin/sshd | grep -E \"musl|libc\"\n  echo \"=== B: PAM 探测 ===\"\n  /opt/ssh-vuln/sbin/sshd -T -f /opt/ssh-vuln/etc/sshd_config 2&gt;&amp;1 | grep -c usepam\n  echo \"=== C: 影子值为 * 的账户 ===\"\n  awk -F: \"\\$2==\\\"*\\\" {print \\$1}\" /etc/shadow\n  echo \"=== D: 可借哈希前缀分布 ===\"\n  awk -F: \"{print substr(\\$2,1,3)}\" /etc/shadow | sort | uniq -c | sort -rn\n'</code></pre><h2 id=\"sec-28\"><strong>环境关闭</strong></h2><p>验证完关掉受影响实例：</p><pre><code>docker exec sshhole-test pkill -f \"ssh-vuln/sbin/sshd\"\ndocker exec sshhole-test sh -c 'netstat -ltn | grep 2223' || echo \"2223 已停\"</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1013%2Fa5fe1708-7a9.png&amp;mode=full&amp;exp=1794700800&amp;sig=034792cd228a7419\" loading=\"lazy\" decoding=\"async\"></p><p>彻底清理：</p><pre><code>docker rm -f sshhole-test\ndocker rmi sshhole-repro:latest</code></pre><h2 id=\"sec-29\"><strong>八、上游修复分析</strong></h2><p>10.6p2 的 <code>sys_auth_passwd()</code> 全文在卡片 C5。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1005%2F40b2078b-2bc.png&amp;mode=full&amp;exp=1794700800&amp;sig=92df4bb86522ca6d\" loading=\"lazy\" decoding=\"async\"><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1005%2Fa6597b8a-cf1.png&amp;mode=full&amp;exp=1794700800&amp;sig=88adea6414ebf8dc\" loading=\"lazy\" decoding=\"async\"></p><p>一处是给比较加长度下限。<code>auth-passwd.c:71</code> 新增 <code>#define MIN_PASSWORD_HASH_LEN 4</code>，<code>:226-228</code> 的比较变成：</p><pre><code>ret = encrypted_password != NULL &amp;&amp;\n &nbsp; &nbsp;strlen(pw_password) &gt;= MIN_PASSWORD_HASH_LEN &amp;&amp;\n &nbsp; &nbsp;strcmp(encrypted_password, pw_password) == 0;</code></pre><p><code>*</code> 的长度是 1，直接被这一条挡下。它同时也挡住了 <code>\"x\"</code> 这类退化值。这一处改动独立成立，即使不动内存管理，绕过也已经失效。</p><p>另一处是把静态缓冲区别名干掉。<code>:202-203</code> 把取影子值改成堆拷贝：</p><pre><code>char *pw_password = authctxt-&gt;valid ?\n &nbsp; &nbsp;shadow_pw(pw) : xstrdup(pw-&gt;pw_passwd);</code></pre><p><code>:209-212</code> 的空口令分支加了 <code>free(pw_password)</code>，<code>:229</code> 用 <code>freezero()</code> 收尾。配套的 <code>xcrypt.c</code> 改动在 p1 与 p2 的 diff 里能看到三处：<code>pick_salt()</code> 的 <code>out:</code> 标签前后加了清零，<code>shadow_pw()</code> 的返回改成 <code>pw_password == NULL ? NULL : xstrdup(pw_password)</code>，函数上方的注释补了一句 \"Caller must free returned value.\"。</p><p>两处都得回移植。只加长度下限，<code>explicit_bzero</code> 跨函数踩内存的问题还在，换一个失败返回值形态相同的场景仍可能出问题；只改堆拷贝，<code>*</code> 与 <code>\"*\"</code> 的比较照样相等，绕过照旧成立。</p><h2 id=\"sec-30\"><strong>九、应急响应处置</strong></h2><h3 id=\"sec-31\"><strong>A. 暴露面判定</strong></h3><p>四条命令，全部只读，不需要发起任何认证。</p><pre><code># 1. sshd 是否链接 musl\nldd /usr/sbin/sshd 2&gt;/dev/null | grep -i musl\n​\n# 2. 是否链接 PAM（无输出即无 PAM 构建）\nldd /usr/sbin/sshd 2&gt;/dev/null | grep -i pam\n​\n# 3. 影子字段恰好是 * 的账户清单\nawk -F: '$2==\"*\"{print $1}' /etc/shadow\n​\n# 4. 系统里可借的哈希前缀分布\nawk -F: '{print substr($2,1,3)}' /etc/shadow | sort | uniq -c</code></pre><p>第 4 条输出里出现 <code>$5$</code> 或 <code>$6$</code>，且第 3 条有非 root 账户，才需要继续。第 1 条或第 2 条任一不成立，本机不在这条链上。</p><p>版本判定：</p><pre><code>/usr/sbin/sshd -V 2&gt;&amp;1 | head -3</code></pre><p>初稿写的是\"7.3p1 到 10.6p1 都按受影响处理\"，这轮实测证伪了：Alpine <code>10.3_p1-r2</code> 版本号落在区间内，却已回移 <code>MIN_PASSWORD_HASH_LEN 4</code>，两次尝试均 <code>denied</code>。版本号只能用来初筛。<code>-V</code> 不够时去包的 changelog 找 <code>MIN_PASSWORD_HASH_LEN</code>，或者按 第七节 的黑盒两条 / 反汇编长度闸门定性。</p><h3 id=\"sec-32\"><strong>止损</strong></h3><p>按代价从低到高：</p><ol><li><p>把 <code>*</code> 改成 <code>!</code> 前缀。影子值以 <code>!</code> 开头即被 <code>auth.c:108</code> 的锁定检查拒绝，这条检查在窗口场景里一定会执行。改法：<code>usermod -L &lt;user&gt;</code>；工具集里没有这条命令时直接编辑 <code>/etc/shadow</code>。这是最小改动，也是唯一不需要重启 sshd 的改动。</p></li><li><p>给确实需要口令的账户设真实口令，影子值变成 <code>$6$…</code>，环 2 的条件不成立。</p></li><li><p>关闭这些账户的口令认证。<code>sshd_config</code> 里用 <code>Match User</code> 配 <code>PasswordAuthentication no</code>，或把 <code>UsePAM</code> 打开（<code>sshd_config:85</code> 的 <code>#UsePAM no</code>）。后者改变认证栈整体行为，需要连带验证 PAM 配置，属于较大动作。</p></li><li><p>换包。装带 PAM flavor 的 openssh 包，或升级到 10.6p2。</p></li></ol><p>第 1 条要留意副作用：<code>*</code> 与 <code>!</code> 在部分工具链里的语义不同，<code>!</code> 更明确地表示\"被管理员锁定\"，改动会体现在 <code>passwd -S</code> 之类的输出里。对本来就不该用口令登录的系统账户，这个变化通常是加分项。</p><h3 id=\"sec-33\"><strong>已登录痕迹排查</strong></h3><p>绕过成功时 sshd 记的是正常的 <code>Accepted password</code> 行，与真实口令登录无法从消息文本区分。可用的区分点是：同一连接内紧跟在 <code>Failed password</code> 之后、且中间没有其他认证方法参与的 <code>Accepted password</code>。日志行本身带客户端源端口（<code>auth.c:294-303</code> 的格式串里是 <code>from %.200s port %d</code>），源端口加源地址足以定位到一条 TCP 连接。</p><pre><code>journalctl -u sshd --since \"14 days ago\" -o cat \\\n  | grep -E \"(Accepted|Failed) password\" \\\n  | grep -oE \"(Accepted|Failed) password for .* port [0-9]+\"</code></pre><p>输出按 <code>from &lt;地址&gt; port &lt;端口&gt;</code> 分组后，同一组里 Failed 与 Accepted 并存就要人工核查。这条命令只做筛选，分组判断留给分析师，因为日志字段数量随 <code>invalid user</code> 是否出现而变化，写死列号的 <code>awk</code> 会漏。</p><p>真正的排查要看进程：<code>sshd-auth</code> 子进程按连接新建，<code>sshd-session</code> 记录的连接起止时间能对齐到具体会话。把可疑会话的起止时间与变更窗口、镜像构建时间对照。</p><p>对容器场景，日志通常丢失，处置方式按失陷处理：换镜像重建，而不是在容器里加个 <code>!</code> 前缀后继续运行。</p><h3 id=\"sec-34\"><strong>时间回溯</strong></h3><p>如果镜像已经在生产跑过一段时间，需要回答\"有没有人用过这条路\"。可用的证据面：</p><ul><li><p>sshd 的 <code>Accepted password</code> 与 <code>Failed password</code> 成对出现在同一来源端口（<code>auth.c:294-303</code> 的格式里带源 IP 与端口）。</p></li><li><p>超过 1024 字节的口令在 <code>auth-passwd.c:86-87</code> 被提前判失败，但 <code>auth_log()</code> 照样记一条 <code>Failed password</code>（<code>auth2.c:407-408</code>）。初稿\"不留日志\"的说法已证伪。如果中间设备（负载均衡、SSH 代理）记录了报文长度，那里还能看到探测尝试。</p></li><li><p>系统账户被口令登录本身就是异常。<code>*</code> 账户设计上就不能口令登录，任何一次成功都是问题，不需要漏洞指纹也能定性。</p></li></ul><h2 id=\"sec-35\"><strong>十、检测方法</strong></h2><p>能写成规则的信号，按靠谱程度排一下。这一版按第七节的实测结果改过，初稿里那条\"超长口令无日志\"已经删掉：<code>auth_log()</code> 无条件记录，这个信号根本不存在。</p><ol><li><p><strong>同一连接内 </strong><code>Failed password</code><strong> 后紧跟 </strong><code>Accepted password</code><strong>，且源端口相同</strong>。唯一实测可靠的入侵信号：阳性对照里 <code>52146</code> 端口上两条日志完整出现，阴性对照里没有。正常用户失败后要么换口令、要么放弃，很少在第二次就输入一个恰好正确的口令。</p></li><li><p><strong>影子字段恰为单个 </strong><code>*</code><strong> 且 shell 可执行的账户</strong>。环 2 的入口，配置层可直接扫：<code>awk -F: '$2==\"*\"{print $1}' /etc/shadow</code> 的结果与 <code>getent passwd</code> 的 shell 字段做交集。</p></li><li><p><code>*</code><strong> 账户出现 </strong><code>Failed password</code>。正常加固下这些账户根本不该走到口令认证；<code>account is locked</code> 之外的 <code>Failed</code> 值得看。</p></li><li><p><strong>认证报文的口令字段长度落在 257–1024 字节</strong>。<code>MaxAuthTries</code> 默认 6（<code>sshd_config:35</code>），两次尝试在一秒内完成的连接也值得看。服务端日志里没有长度字段，得靠前置代理或跳板机的客户端侧记录，抓包看不到明文。披露的 PoC 用同一字符重复 300 次，全同字符只对那个 PoC 成立，不能当通用指纹。</p></li><li><p><strong>无 PAM 构建的 sshd 实例清单</strong>。容器环境里最容易漏：镜像基于 Alpine 装了默认 <code>openssh-server</code> 就落进候选。但第七节说过，Alpine 包版可能已回移修复，必须按行为复核，别只按版本号拉清单。</p></li></ol><h3 id=\"sec-36\"><strong>两个改写结论的机制</strong></h3><p><strong>PerSourcePenalties</strong>（9.8+ 默认开启）初稿没提。本环境 <code>sshd -T</code> 显示 <code>crash:90 authfail:5 noauth:1 invaliduser:5 grace-exceeded:10 refuseconnection:10 max:600 min:15 overflow:permissive</code>。它按源对 <code>authfail</code> 施加惩罚：localhost 单次失败后立即重试没被拦（<code>overflow:permissive</code> 且未达阈值），但生产中同一源 IP 反复触发 <code>authfail</code> 会开始惩罚性延迟甚至断连，这会压缩\"同连接二次尝试\"的时序窗口。写规则时别把它当成稳定的第二次机会。</p><p><strong>前缀分布是天然的断路器</strong>。<code>awk</code> 输出里 <code>$6$</code> / <code>$5$</code> 计数为 0 时环 4 就断，但断法因可借后端而异：</p><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p><strong>可借的前缀</strong></p></th><th colspan=\"1\" rowspan=\"1\"><p><strong>断在哪</strong></p></th><th colspan=\"1\" rowspan=\"1\"><p><strong>原因</strong></p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>$y$</code>（yescrypt）</p></td><td colspan=\"1\" rowspan=\"1\"><p>环 5</p></td><td colspan=\"1\" rowspan=\"1\"><p>musl 不认识，落到 DES，恒返回 13 字符真哈希</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>$2b$</code>（blowfish）</p></td><td colspan=\"1\" rowspan=\"1\"><p>环 4</p></td><td colspan=\"1\" rowspan=\"1\"><p>实测全长度返回真哈希，无长度拒绝</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>$1$</code>（md5）</p></td><td colspan=\"1\" rowspan=\"1\"><p>环 1</p></td><td colspan=\"1\" rowspan=\"1\"><p>窗口上移到 30000 字节，<code>MAX_PASSWORD_LEN 1024</code> 先拦</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>无任何 <code>$…$</code> 可借</p></td><td colspan=\"1\" rowspan=\"1\"><p>环 5</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>pick_salt()</code> 落 DES 兜底 <code>xx</code>，同 yescrypt 路径</p></td></tr></tbody></table><p>所以把口令哈希迁走 <code>$6$</code> / <code>$5$</code> 是普适断路器，优先迁到 <code>$y$</code>，成本最低。</p><h2 id=\"sec-37\"><strong>总结</strong></h2><p>整条链拆到最后，其实就三件事：</p><ol><li><p><code>*</code> 这个影子值让 <code>sys_auth_passwd()</code> 把 NULL 当盐传下去，<code>pick_salt()</code> 只好去系统里另借一个；借来的 <code>$6$</code> 撞上 musl sha-crypt 的 256 字节上限，<code>crypt()</code> 失败时返回字面量 <code>\"*\"</code>。两边一比，正好相等。</p></li><li><p>\"先失败一次\"不是仪式，是 <code>pick_salt()</code> 里那个 <code>static char salt[32]</code> 的缓存寿命。它跟着 privsep 子进程走，一条 TCP 连接清空一次，所以重连得重来。披露把这半截因果写漏了。</p></li><li><p>修复得两处一起回移植：长度下限挡住 <code>*</code> 与 <code>\"*\"</code> 的相等，堆拷贝掐断跨函数的别名。只做一处，另一半还留着。</p></li></ol><p>这轮在隔离容器里把链条端到端跑通了：unpatched 10.6p1 同连接第二次 <code>Accepted password</code>，可用窗口实测 257–1024 字节；Alpine 包版 10.3p1-r2 虽在区间内却因回移修复两次 <code>denied</code>。<strong>版本号不可信，判定要落到二进制行为</strong>。这是整轮验证里最该带走的一条。</p><p>影响面比披露写的窄：窗口只认 <code>$5$</code> / <code>$6$</code>，默认配置下 root 还有 <code>PermitRootLogin</code> 挡着，真正该盯的是所有非 root 的 <code>*</code> 账户。第九节那四条只读命令能圈出暴露面，再按第七节的黑盒或反汇编判据定性。检测上只留一条硬信号：同源端口 <code>Failed</code> 紧跟 <code>Accepted</code>；PerSourcePenalties 会压缩二次尝试的时序，别把它写成稳定假设。</p><p>剩下没独立核过的：CVE 编号与厂商通告、各发行版默认 <code>/etc/shadow</code> 的 <code>*</code> 账户清单、系统账户默认 shell 是否满足可执行检查、10.6p2 之前还有哪些发行版回移过修复。这几项按 B / C 级引用，处置时别当已证事实。</p><h2 id=\"sec-38\"><strong>REF</strong></h2><ul><li><p>OpenSSH portable 源码包 <code>10.6p1</code> / <code>10.6p2</code> / <code>7.2p2</code> / <code>7.3p1</code> / <code>7.5p1</code>，musl libc <code>1.2.6</code>（哈希见第二节）</p></li><li><p>Alpine Linux aports <code>testing/openssh/APKBUILD</code>：PAM 与无 PAM flavor 的构建定义，引用 <code>:163</code>、<code>:181</code>、<code>:219</code>、<code>:319-326</code>、<code>:328-341</code></p></li><li><p>sshhole 公开披露：成因五步、复现步骤与对照结果（本文不重复其 PoC）</p></li><li><p>配图卡片 C1–C6 由 <code>scripts/codecard.mjs</code> 从解包正本按真实行号逐字切片：<code>openssh-10.6p1/auth-passwd.c:191-222</code>、<code>openbsd-compat/xcrypt.c:70-95</code>、<code>musl-1.2.6/src/crypt/crypt_sha512.c:189-196</code>、<code>musl-1.2.6/src/passwd/getspnam.c:1-18</code>、<code>getspnam_r.c:23-32</code>、<code>openssh-10.6p2/auth-passwd.c:192-232</code>；规格见 <code>sshhole-images/cards/*.json</code></p></li><li><p>本地验证：隔离容器 <code>alpine:latest</code>（aarch64，Alpine 3.24.3 + musl），Alpine <code>openssh-server 10.3_p1-r2</code> 与源码自编 <code>openssh-10.6p1</code>；探针与输出见第二节，实测结果见第七节</p></li></ul>","original","zhKind","complete","漏洞分析","复现","加密","加固","https://xz.aliyun.com/news/93241","先知社区",{"_218":219,"_220":-5},"changelogVersion","2026-10-01T08:00","release"]
