[{"_1":2,"_3":4},"root",{"_5":94},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":60,"_61":62},"expiresAt",1795740052000,"id","xq8xakipwwrrbp544jsizje8i","title","Azure API Management Classic 漏洞被用于窃取挪威能源公司密钥","originalTitle","Azure Flaw Exploited to Target Secrets at Norwegian Energy Firms","summary","Azure API Management Classic 漏洞已被用于针对挪威能源公司 Equinor 和 Skagerak Energi 等目标，攻击者可能获取了实例中存储的密钥。","reason","材料把 Azure APIM Classic 的凭据暴露风险与两家挪威能源公司的安全事件联系起来，并给出受影响实例范围与轮换凭据的处置建议。","source",{"_74":93},"links",{"_62":92},"publishedAt","2026-11-23T15:47:40.000Z","discoveredAt","2026-11-23T16:19:31.924Z","timelineAt","category","vuln","tags",[87,75,88,89,90,91],"score",82,"selected",true,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","Eduard Kovacs","body",{"_83":-5,"_62":84,"_85":-5,"_86":60},"outline",[],"relatedStories",[79],"topics",[69,70,71],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation",false,"bodyLanguage","original","factId","fdpjCK9lDhbs","reportCount",2,"additionalSourceCount",1,{"_72":77,"_74":78},{"_72":31,"_74":76},{"_72":73,"_74":75},"slug","exploited","name","在野利用","漏洞披露","cloud-native","云与原生",{"_80":81,"_13":82},"publicId","ac3a8aba-a3ef-4a7e-a4a3-1236e9441fe5","Azure APIM Classic漏洞已遭利用","zh","<p><strong>A security issue discovered in Microsoft’s Azure API Management (APIM) service appears to have been responsible for the security incidents reported last week by two Norwegian energy firms, with impact extending beyond Norway.&nbsp;</strong>\n\n\n\n</p><p>Microsoft is notifying customers about the issue in Azure APIM, which is designed for publishing, securing and managing APIs. The vulnerability may have allowed threat actors to gain access to secrets stored in some APIM instances.\n\n\n\n</p><p>According to a private notification <a href=\"https://www.reddit.com/r/sysadmin/comments/1y2n689/critical_security_advisory_affecting_apim/\">shared</a> on Reddit by one customer, the tech giant discovered the issue on November 18 and closed the access path the next day.&nbsp;\n\n\n\n</p><p>“Our investigation found that customers were exposed and an unauthorized party could have used the issue to access secrets stored in Azure API Management Classic instances before Microsoft identified the security issue,” Microsoft said.\n\n\n\n</p><p>Exposed data can include secrets stored as named values, client secrets for identity providers, subscription keys, and tokens for APIM’s direct management APIs.\n\n\n\n</p><p>Microsoft noted that APIM Classic tiers that don’t follow its documented security guidance are affected. Instances on v2 tiers are not impacted.</p><p><span>Advertisement. Scroll to continue reading.</span></p><p>Norway’s National Security Authority (NSM) said on November 20 that the vulnerability had affected several organizations in the country, including energy companies Equinor and Skagerak Energi, which independently <a href=\"https://www.securityweek.com/in-other-news-norwegian-energy-firm-cyberattacks-supercomputer-hack-new-nightmare-eclipse-exploit/\">disclosed cybersecurity incidents</a> last week.&nbsp;\n\n\n\n</p><p>Equinor reported the attack on November 17, one day before Microsoft identified the APIM flaw. The company said it found no evidence that data was stolen or altered. Skagerak Energi disclosed the incident on November 18, saying it did not impact operations or production, and it found no evidence of information compromise.\n\n\n\n</p><p><a href=\"https://nsm.no/aktuelt/nsm-deler-tiltak-mot-sarbarhet-i-azure-api-management\">NSM said</a> an unknown threat actor targeted tokens, secrets and named values stored in APIM. It’s unclear how widely the weakness has been exploited, but the organization noted that several sectors in Norway and abroad are impacted.\n\n\n\n</p><p>APIM users have been advised by NSM to treat their secrets and named values as compromised and replace them. They should also verify that their instances have been updated and identify the data accessible through the service.\n\n\n\n</p><p>Security expert Anders Kristiansen <a href=\"https://anderskristiansen.com/post/2026/apim-legacy-access/\">warned</a> that credentials lifted from APIM could be used against outside services. The extent of the exposure depends on each credential’s permissions.\n\n\n\n</p><p><strong>Related</strong>: <a href=\"https://www.securityweek.com/n-able-patches-critical-flaw-disclosed-after-mail-assure-cyberattack/\">N-able Patches Critical Flaw Disclosed After Mail Assure Cyberattack</a>\n\n\n\n</p><p><strong>Related</strong>: <a href=\"https://www.securityweek.com/gl-inet-routers-kvms-compromised-via-remote-management-service-flaw/\">GL.iNet Routers, KVMs Compromised via Remote Management Service Flaw</a>\n\n\n\n</p><p><strong>Related</strong>: <a href=\"https://www.securityweek.com/ai-inference-providers-failed-to-detect-hacking-and-prompt-theft-says-dragos/\">AI Inference Providers Failed to Detect Hacking and Prompt Theft, Says Dragos</a>\n      </p>","zhKind","complete","漏洞","补丁","云原生","Microsoft","AWS","https://www.securityweek.com/azure-flaw-exploited-to-target-secrets-at-norwegian-energy-firms/","SecurityWeek",{"_95":96,"_97":-5},"changelogVersion","2026-10-01T08:00","release"]
