[{"_1":2,"_3":4},"root",{"_5":107},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795912838000,"id","h9apyz5zi8bgzvqveztpgfzgd","title","SilentAir 与 LIMINAL PANDA 入侵移动网络，拦截通话和短信","originalTitle","SilentAir and LIMINAL PANDA Target Telecom Networks to Spy on Subscribers","summary","Enea 发现 SilentAir 与 LIMINAL PANDA 利用移动运营商互联环境间谍活动。LIMINAL PANDA 通过 GTP-C 和 GTP-U 隐藏 GTPDoor，Enea 自 2026 年第一季度以来在多个客户处拦截数百次秘密会话，确认或高度怀疑 5 至 10 家运营商感染，并认为全球可能有数十家，主要位于亚洲、非洲和拉丁美洲。","reason","材料拆解了两组针对移动运营商和用户的攻击路径，并给出流量模式、受害范围与跨域联防思路。","source",{"_75":106},"links",{"_96":105},"publishedAt","2026-11-16T08:11:01.000Z","discoveredAt","2026-11-16T08:50:19.325Z","timelineAt","category","activity","tags",[78,76,100,101,102,80,103,104],"score",82,"selected",true,"channel","news","story",{"_86":87,"_13":88},"x","readingMode","full","author","Pierluigi Paganini","body",{"_61":95,"_96":-5,"_97":98,"_99":37},"outline",[89],"relatedStories",[85],"topics",[68,69,70,71,72],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fOwZJOW0ORbc","reportCount",1,"additionalSourceCount",0,{"_73":83,"_75":84},{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","malware","name","恶意软件","attack","攻击活动","incident","应急响应","black-market","数据窃取与黑产","ransomware","勒索软件",{"_86":87,"_13":88},"publicId","085ef084-576d-4acf-886f-9c36160d92d0","两家组织入侵移动网络实施间谍活动",{"_11":90,"_91":92,"_93":94},"sec-1","text","研究人员发现两个威胁组织 SilentAir 和 LIMINAL PANDA 利用移动网络监视用户并拦截通话和短信。","level",2,"<h2 id=\"sec-1\">研究人员发现两个威胁组织 SilentAir 和 LIMINAL PANDA 利用移动网络监视用户并拦截通话和短信。</h2><p>电信安全公司 Enea <a href=\"https://www.enea.com/insights/the-enemy-within-tracking-liminal-panda-and-silentair-through-mobile-networks/\">发布的研究</a>分析了两个名为 SilentAir 和 <a href=\"https://securityaffairs.com/tag/liminal-panda\">LIMINAL PANDA</a>、活跃于移动网络内部的威胁行为体。专家称，SilentAir 自 2025 年之前就已入侵运营商；不过，这两个 APT 组织之间可能存在联系，但尚未得到确认。</p><p><em>“复杂的威胁行为体正在入侵移动网络运营商，以窃取信息并对其他运营商及其用户发起攻击。”Enea 发布的<a href=\"https://www.enea.com/insights/the-enemy-within-tracking-liminal-panda-and-silentair-through-mobile-networks/\">报告</a>如此写道。“Enea 检测到此前已识别的威胁行为体 LIMINAL PANDA 于 2026 年持续活动。我们还发现了新识别的威胁行为体 SilentAir，该组织自 2025 年之前便一直在入侵运营商。两者之间可能存在联系，但尚未得到确认。”</em></p><p>移动网络需要相互通信，以支持漫游、通话、短信和移动数据。它们通过信令协议交换这些信息，其中很大一部分经由名为 IPX 的共享 IP 网络传输。该系统使运营商能够协同工作，但攻击者也可能滥用运营商之间的信任关系来访问移动网络。</p><p>涉及 <a href=\"https://securityaffairs.com/tag/ss7\">SS7</a> 的安全问题于 2014 年被报告，随后出现了利用 Diameter 协议的攻击。近来，研究人员还发现了针对 GTP 的攻击，GTP 是移动网络使用的另一种协议。这一点尤其重要，因为 GTPDoor 恶意软件会利用 GTP 与攻击者秘密通信。</p><p>GTPDoor 是一种基于 Unix 的恶意软件，使用 GTP-C 协议接收攻击者发来的隐藏命令。HaxRob 于 2024 年 2 月首次分析了该恶意软件。Palo Alto Networks 后来将其与一个追踪编号为 CL-STA-0969 的威胁集群关联起来，该集群与 CrowdStrike 追踪的 LIMINAL PANDA 组织具有许多相同特征。2024 年，CrowdStrike <a href=\"https://www.crowdstrike.com/en-us/blog/liminal-panda-telecom-sector-threats/\">评估</a>认为该组织与中国存在联系，但置信度较低。Brandefence 后来报告称，该组织的部分成员可能供职于中国国家安全的某个地区办事处，置信度为中等。2026 年 7 月，POST Luxembourg 报告了首次检测到涉及这种恶意软件的 GTP-C 攻击。</p><p>Enea 表示，其 GTP 防火墙从 2026 年第一季度起就在多家客户处发现并阻断了 GTPDoor 及相关活动。Enea 发现了数百次试图建立隐蔽会话的尝试。其直接发现或强烈怀疑有 5 至 10 家运营商遭到感染，并认为全球可能还有数十家，主要分布在亚洲、非洲和拉丁美洲。</p><p>这些会话携带的命令包括启动和停止数据隧道、在运营商内部横向移动、启动 SSH、检查恶意软件运行状况，以及通过删除文件和更改时间戳来隐藏痕迹。在感染早期，攻击者频繁尝试打开隧道，后来间隔逐渐增大。一半的隧道持续时间不足 21 分钟，少数运行超过 24 小时。这与 CrowdStrike 所描述的每日定时脚本并不吻合。</p><p>LIMINAL PANDA 开发了其恶意软件的新版本，称为 GTPDoor v3。该版本隐藏在 GTP-U 中，即协议中用于承载数据的部分。这使其更难被检测，因为 GTP-U 流量更为复杂，承载的数据量远多于 GTP-C，而且受到的安全关注较少。该恶意软件仍使用相同的 XOR 密钥，但现在依赖 libpcap 捕获网络流量。这种方法不易被 netstat 和 lsof 等标准系统工具发现。另一个重要区别是，GTP-U 也用于 5G 网络，而 GTP-C 不会。</p><p>SilentAir 采用了不同的方法。Enea 有高度信心认为，该组织是国家级行为体，而非商业监控供应商。然而，研究人员仅有低度信心认为其与中国存在关联。SilentAir 从至少六个亚洲国家移动运营商内部已被攻陷的网络节点发起 SS7 和 Diameter 攻击。其行动以其他约十二个国家和地区的用户为目标。台湾是主要目标，包括政治人物和政府官员。</p><p>攻击组合暴露了这一点。拦截占 SilentAir 活动的 18.30%，而典型监控公司仅为 2.07%。这些公司更偏爱信息收集（61.89%）和位置追踪（30.90%），而 SilentAir 的占比分别为 7.21% 和 0.22%。攻击呈爆发式进行，从少量用户到每月数千名用户不等，随后沉寂数月。</p><p>在拦截方面，攻击者会将目标登记的位置转移到其控制的节点，使之后的通话和短信都经过该节点。Enea 发现，对于某些目标，双重验证码在拦截后立即到达，这表明其目的是入侵目标的其他账户。与有关俄罗斯的 HiddenArt 不同，SilentAir 确实运行被攻陷的节点，并响应由其发起的事务。Enea 无法分析该二进制文件，因为运营商维持了严格的纪律。</p><p>Silent SMS 是不同寻常之处，因为它不会在手机上显示提示。大多数发送至台湾用户的短信都出现在午夜前后，它们可能是在测试拦截是否仍然有效，因为此时手机最不可能重新注册。短信通过一个中间商短信中心发送，并带有诸如健康祝福之类的友好垃圾短信内容，以防运营商移除静默标志而让短信显示出来。没人应该对一个陌生人祝自己身体健康、心平气和产生怀疑，而这正是其意图所在。</p><p>与中国有关的判断依据是国家级行为、对台湾的关注、未将中国网络作为目标，以及符合 UTC+8 工作时间的活动。早晨和晚间会出现活动低谷，中国节假日期间会暂停，周末基本没有活动，目标包括政治贵宾。Enea 将此评为低度信心，因此应将其视为线索，而非定论。</p><figure><a href=\"https://i0.wp.com/securityaffairs.com/wp-content/uploads/2026/11/image-34.png?ssl=1\"><img width=\"1024\" height=\"747\" src=\"/dailyinfo/media/badc8e96dabde525.webp\" srcset=\"/dailyinfo/media/31723cd7d39e521b.webp 720w, /dailyinfo/media/324c006a52ffe9ef.webp 1200w, /dailyinfo/media/badc8e96dabde525.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"\"></a></figure><p>Enea 无法确认其与 LIMINAL PANDA 存在关联。其活动时间有时与同一批运营商中的活动重叠，目标对象也相符；此外，一个名为 SCTPE、与 LIMINAL PANDA 有关联的木马会发送 SS7 和 Diameter 流量。但 SilentAir 能够响应 SCTPE 无法处理的事务，其运营安全做得更好，工作时间也略有差异。两个与中国有关的行为体共享访问权限，或二者都攻陷了同一批运营商，这两种可能性同样存在。</p><p>Enea 表示，它曾帮助客户清除 LIMINAL PANDA 的活动，并联系了其他受影响的运营商，同时警告那些感染 SilentAir 的运营商，其网络中存在恶意活动。这两个团伙目前都已被阻止。Enea 警告称，访问全球 800 多家移动运营商中的任意一家，都可能通过 IPX 为攻击其他运营商提供途径。AI 也让创建新的恶意软件变得更加容易。</p><p>Enea 建议使用与 SS7 和 Diameter 安全工具共享信息的 GTP-C 和 GTP-U 防火墙。运营商不应仅仅满足于行业检查清单，还应监控内部网络流量，因为 SIGTRANslator 和 Cordscan 等工具可能不会被察觉。他们还应将电信安全与常规 IT 安全相结合。外包核心网络服务可能会使调查更加困难。</p><p><em>“<strong>IPX 接口必须被视为不可信</strong>。信令安全的演进，建立在一个逐步认识之上：移动运营商之间的互连不能被视为可信链路。”报告总结道。“SilentAir，尤其是 LIMINAL PANDA，会利用任何可用的互连协议，不仅包括 SS7、Diameter、 GTP，还包括 DNS、ICMP 等其他协议。”</em></p><p><strong>在 Twitter 上关注我：&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;和&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;和&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a><strong></strong></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;黑客，&nbsp;中国)</strong></p>","original","zhKind","translation","complete","后门","数据窃取","网络设备","Palo Alto","CrowdStrike","https://securityaffairs.com/203099/apt/silentair-and-liminal-panda-target-telecom-networks-to-spy-on-subscribers.html","Security Affairs",{"_108":109,"_110":-5},"changelogVersion","2026-10-01T08:00","release"]
