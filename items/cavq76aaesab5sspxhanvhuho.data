[{"_1":2,"_3":4},"root",{"_5":132},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1794357635000,"id","cavq76aaesab5sspxhanvhuho","title","Red Hat OpenShift 5 强化应用与 AI 安全，Advanced Cluster Security 5 改进漏洞治理","originalTitle","Red Hat OpenShift 5: Bring stronger security to applications and AI","summary","Red Hat OpenShift 5 通过网络策略、ML-KEM、机密容器、沙箱化容器及 MCP 服务强化应用和 AI 工作负载安全，Advanced Cluster Security 5 引入 CISA KEV、CVE Origin 指示器及只读 MCP 漏洞查询。","reason","source",{"_65":131},"links",{"_58":130},"publishedAt","2026-11-09T00:00:00.000Z","discoveredAt","2026-11-10T22:55:37.717Z","timelineAt","category","blue-team","tags",[122,123,124,125,126,127,128,129],"score",24,"selected",false,"channel","news","story","x","readingMode","full","author","body",{"_118":-5,"_58":119,"_120":-5,"_121":36},"outline",[75,76,77,78,79,80,81,82,83,84,85,86,87],"relatedStories",[],"topics",[59,60,61,62,63],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_64":73,"_65":74},{"_64":71,"_65":72},{"_64":69,"_65":70},{"_64":67,"_65":68},{"_64":30,"_65":66},"slug","name","蓝队与运营","tools","工具与平台","ai-agent","AI Agent 安全","cloud-native","云与原生","redhat","Red Hat / 红帽",{"_11":116,"_89":117,"_91":105},{"_11":114,"_89":115,"_91":105},{"_11":112,"_89":113,"_91":105},{"_11":110,"_89":111,"_91":105},{"_11":108,"_89":109,"_91":105},{"_11":106,"_89":107,"_91":105},{"_11":103,"_89":104,"_91":105},{"_11":101,"_89":102,"_91":92},{"_11":99,"_89":100,"_91":92},{"_11":97,"_89":98,"_91":92},{"_11":95,"_89":96,"_91":92},{"_11":93,"_89":94,"_91":92},{"_11":88,"_89":90,"_91":92},"sec-13","text","Virtualization","level",3,"sec-12","Applications","sec-11","Infrastructure","sec-10","Edge computing","sec-9","Security","sec-8","Automation","sec-7","Browse by channel",2,"sec-6","Keep exploring","sec-5","More like this","sec-4","Red&nbsp;Hat OpenShift Container Platform | Product Trial","sec-3","Carry trust into software delivery","sec-2","Red&nbsp;Hat Advanced Cluster Security 5: Turn vulnerability findings into bette","sec-1","Red&nbsp;Hat OpenShift 5: Protect the platform, the model, and the data","zh","<p><img src=\"/dailyinfo/media/82c15eb91f26b77b.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"1\"></p><p>\n                    Principal Product Marketing Manager - OpenShift\n                  </p><p>Every team wants to get AI models and modern apps into production quickly, but no platform engineer wants to gamble on unvetted code or leaky access boundaries.&nbsp;<a href=\"https://www.redhat.com/en/technologies/cloud-computing/openshift\">Red&nbsp;Hat OpenShift</a> 5 is built to give platform and security teams the confidence to say \"yes\" to deployment without losing control. Alongside it,&nbsp;<a href=\"https://www.redhat.com/en/technologies/cloud-computing/openshift/advanced-cluster-security-kubernetes\">Red&nbsp;Hat Advanced Cluster Security for Kubernetes</a> 5 gives security teams more context to investigate and prioritize workload risk.</p><p>Security concerns already affect delivery. In Red&nbsp;Hat’s&nbsp;<a href=\"https://www.redhat.com/en/resources/state-of-cloud-native-security-ebook\">The state of cloud-native security report: 2026 edition</a>, 74% of surveyed organizations slowed or delayed application deployments. To unblock stalled deployments, security and platform leads need demonstrable proof that these boundaries hold under pressure.</p><h2 id=\"sec-1\">Red&nbsp;Hat OpenShift 5: Protect the platform, the model, and the data</h2><p>Protecting an application starts with controlling its environment. Red&nbsp;Hat OpenShift 5 applies network policies during installation to restrict traffic into and out of control plane operand namespaces. Those boundaries help limit the blast radius and unwanted exposure around the services that operate in the cluster.</p><p>The release also advances Red&nbsp;Hat OpenShift’s&nbsp;<a href=\"https://www.redhat.com/en/blog/road-to-quantum-safe-cryptography-red-hat-openshift\">post-quantum cryptography work</a>, building on its existing module-lattice-based key-encapsulation mechanism (ML-KEM) capabilities. With compatible transport layer security (TLS) 1.3 clients, hybrid key exchange helps protect against “harvest now, decrypt later” attacks in which an attacker could collect encrypted traffic today and attempt to decrypt it with future quantum computers. For organizations handling data that must remain confidential for years, addressing that risk belongs in today’s platform planning.&nbsp;</p><p>AI adds another requirement to protect sensitive information while the workload uses it.&nbsp;<a href=\"https://www.redhat.com/en/blog/whats-new-red-hat-openshift-confidential-computing-and-sandboxing\">Confidential containers</a> encrypt model weights in CPU and GPU memory. Confidential GPU support is generally available on supported bare-metal systems. These protections encrypt data in use and shield it from cluster administrators.</p><p>This distinction matters when your infrastructure team operates the platform but shouldn't access a model’s weights or sensitive data. Confidential computing extends protection into execution, where the workload must process that information.</p><p>Agent execution introduces a different concern where an agent may generate or run code that your team hasn't reviewed.&nbsp;Red&nbsp;Hat <a href=\"https://www.redhat.com/en/blog/learn-openshift-sandboxed-containers\">OpenShift sandboxed containers</a> run code in isolated virtual machines (VMs), helping contain its execution.&nbsp;<a href=\"https://developers.redhat.com/articles/2026/07/15/red-hat-build-agent-sandbox-isolated-workload-management-kubernetes?extIdCarryOver=true&amp;sc_cid=RHCTG0180000371695&amp;_gl=1*4x8v50*_gcl_aw*R0NMLjE3ODU5NjUxNDcuRUFJYUlRb2JDaE1JaFBHbXo3YUtsZ01Wbmx6X0FSMmtxZ3dpRUFBWUFTQUFFZ0xtMVBEX0J3RQ..*_gcl_dc*R0NMLjE3ODU5NjUxNDcuRUFJYUlRb2JDaE1JaFBHbXo3YUtsZ01Wbmx6X0FSMmtxZ3dpRUFBWUFTQUFFZ0xtMVBEX0J3RQ..*_gcl_au*MjEyNzE0NTk4OC4xNzkxODE2MDM1#conclusion\">Red&nbsp;Hat build of Agent Sandbox</a>, available in Technology Preview, brings VM isolation to untrusted agent code.</p><p><a href=\"https://www.redhat.com/en/blog/three-pillars-trust-hardened-openshift-foundation\">Isolation</a> works alongside controls over what an agent can ask the platform to do. The Model Context Protocol (MCP) server for Red&nbsp;Hat OpenShift connects agent access to identity integration and Kubernetes role-based access controls (RBAC), while enabling AI agents to more safely query cluster state, retrieve diagnostic context, and execute authorized operational workflows. Audit trails help administrators review agent activity.</p><p>Through&nbsp;<a href=\"https://www.redhat.com/en/technologies/cloud-computing/connectivity-link\">Red&nbsp;Hat Connectivity Link</a>, the&nbsp;<a href=\"https://www.redhat.com/en/blog/model-context-protocol-gateway-red-hat-openshift-now-generally-available\">MCP gateway</a> gives teams a place to govern MCP tool traffic. With NeMo Guardrails integration with MCP gateway, teams can screen tool requests and responses for prompt injection and sensitive data exposure. These guardrails work alongside access controls, so verifying an agent's permissions doesn't replace inspecting what passes through the wire.</p><h2 id=\"sec-2\">Red&nbsp;Hat Advanced Cluster Security 5: Turn vulnerability findings into better decisions</h2><p>While platform protections establish boundaries, security teams still need to understand the risks inside those boundaries and decide where to act first.</p><p>Red&nbsp;Hat Advanced Cluster Security 5 incorporates Cybersecurity and Infrastructure Security Agency's (CISA) Known Exploited Vulnerabilities catalog to help teams prioritize vulnerabilities with evidence of exploitation. Teams can use that evidence in build and deployment policies, connecting remediation priorities with decisions about what proceeds toward production.</p><p>The new Common Vulnerabilities and Exposures (CVE) Origin indicator adds context by distinguishing Red&nbsp;Hat assessments from Open Source Vulnerabilities (OSV.dev) assessments. Teams can interpret severity information with its source in view, helping avoid confusion between external scores and&nbsp;<a href=\"https://www.redhat.com/en/solutions/security-approach\">Red&nbsp;Hat Product Security</a> assessments.</p><p>For organizations bringing VMs onto Red&nbsp;Hat OpenShift, Red&nbsp;Hat Advanced Cluster Security 5 makes vulnerability management for supported Red&nbsp;Hat Enterprise Linux (RHEL) VMs generally available. Security teams gain visibility across containers and VMs on Red&nbsp;Hat OpenShift Virtualization. Scheduling for OpenShift Virtualization compliance profiles also brings those scans into a shared workflow.</p><p>Red&nbsp;Hat Advanced Cluster Security 5 also introduces the MCP server for Red&nbsp;Hat Advanced Cluster Security in Technology Preview. Teams can use natural language to look up CVEs across OpenShift clusters, helping them investigate findings through compatible AI assistants.</p><p>Agents authenticate through a Red&nbsp;Hat Advanced Cluster Security API token. The server returns data within that token’s authorized scope and provides read-only access. Those restrictions apply whether teams use Lightspeed, Claude Code, or another compatible client. Teams can bring AI into vulnerability investigation while retaining the access boundaries defined in Red&nbsp;Hat Advanced Cluster Security.</p><h2 id=\"sec-3\">Carry trust into software delivery</h2><p>Alongside these updates, Red&nbsp;Hat Trusted Profile Analyzer 3.1 streamlines software bill of materials (SBOM) inspection by automatically flagging machine learning (ML) and cryptographic components that warrant review.</p><p>Red&nbsp;Hat Trusted Artifact Signer 1.5 adds AI model signing and verification. Teams can now verify model integrity directly and search transparency logs through a new console, helping operators establish clear provenance before any software or model runs on the platform.</p><p>To reduce vulnerability noise,&nbsp;<a href=\"https://developers.redhat.com/articles/2026/05/13/trusted-software-factory-building-trust-agentic-ai-era\">exploit intelligence</a>, developed using the&nbsp; NVIDIA AI blueprint for vulnerability analysis, evaluates whether a detected CVE is genuinely reachable and exploitable within your specific application runtime rather than forcing teams to chase down theoretical risks.</p><p>Start with an application your team knows. Evaluate Red&nbsp;Hat OpenShift 5’s workload protections, test agent access boundaries, and use Red&nbsp;Hat Advanced Cluster Security 5 to assess risk. Work with your platform and security teams to examine how these new capabilities fit your release process.</p><p>Ready to test these protections? Deploy an&nbsp;<a href=\"https://www.redhat.com/en/technologies/cloud-computing/openshift/try-it\">OpenShift 5 trial cluster</a> to test agent sandboxing and policy enforcement in your environment.&nbsp;</p><p>Explore the OpenShift technical&nbsp;<a href=\"https://docs.redhat.com/en/documentation/openshift_container_platform/\">documentation</a> to see how to implement these workload safeguards in your environment.</p><p>Product trial</p><h2 id=\"sec-4\">Red&nbsp;Hat OpenShift Container Platform | Product Trial</h2><p>A consistent hybrid cloud foundation for building and scaling containerized applications.</p><p>\n                            <a href=\"https://www.redhat.com/en/technologies/cloud-computing/openshift/ocp-self-managed-trial?intcmp=7013a000003Sq0iAAC\" title=\"Red Hat OpenShift Container Platform | Product Trial\">Try it</a>            </p><hr><p><a href=\"https://www.redhat.com/en/authors/dan-bettinger\"><img src=\"/dailyinfo/media/82c15eb91f26b77b.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"1\">\n                        \n                    </a></p><h2 id=\"sec-5\">More like this</h2><p>            Blog post\n</p><p>            Blog post\n</p><p>            Original podcast\n</p><p>            Original podcast\n</p><h2 id=\"sec-6\">Keep exploring</h2><h2 id=\"sec-7\">Browse by channel</h2><p>\n                            <a href=\"https://www.redhat.com/en/blog/channels\" title=\"Explore all channels\">Explore all channels</a>            </p><p>\n              \n  \n\n\n                  <img src=\"/dailyinfo/media/e54b8b12b5046028.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"automation icon\">\n                  </p><h3 id=\"sec-8\"><a href=\"https://www.redhat.com/en/blog/channel/management-and-automation\">Automation</a></h3><p>The latest on IT automation for tech, teams, and environments</p><p>\n              \n  \n\n\n                  <img src=\"/dailyinfo/media/8a821a2318338b17.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"security icon\">\n                  </p><h3 id=\"sec-9\"><a href=\"https://www.redhat.com/en/blog/channel/security\">Security</a></h3><p>The latest on how we reduce risks across environments and technologies</p><p>\n              \n  \n\n\n                  <img src=\"/dailyinfo/media/7ba24fccf63c7747.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"edge icon\">\n                  </p><h3 id=\"sec-10\"><a href=\"https://www.redhat.com/en/blog/channel/edge-computing\">Edge computing</a></h3><p>Updates on the platforms that simplify operations at the edge</p><p>\n              \n  \n\n\n                  <img src=\"/dailyinfo/media/3c20e7298d1bb543.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"Infrastructure icon\">\n                  </p><h3 id=\"sec-11\"><a href=\"https://www.redhat.com/en/blog/channel/infrastructure\">Infrastructure</a></h3><p>The latest on the world’s leading enterprise Linux platform</p><p>\n              \n  \n\n\n                  <img src=\"/dailyinfo/media/e3e51f29ae003c0b.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"application development icon\">\n                  </p><h3 id=\"sec-12\"><a href=\"https://www.redhat.com/en/blog/channel/applications\">Applications</a></h3><p>Inside our solutions to the toughest application challenges</p><p>\n              \n  \n\n\n                  <img src=\"/dailyinfo/media/820d8e45b3c05d24.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"Virtualization icon\">\n                  </p><h3 id=\"sec-13\"><a href=\"https://www.redhat.com/en/blog/channel/red-hat-virtualization\"> Virtualization</a></h3><p>The future of enterprise virtualization for your workloads on-premise or across clouds</p>","zhKind","complete","工具发布","版本更新","加固","云原生","容器","大模型","Red Hat","CISA","https://www.redhat.com/en/blog/red-hat-openshift-5-bring-stronger-security-applications-and-ai","Red Hat Security",{"_133":134,"_135":-5},"changelogVersion","2026-10-01T08:00","release"]
