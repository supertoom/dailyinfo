[{"_1":2,"_3":4},"root",{"_5":110},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795653635000,"id","ahf6lsd45crjs7phxjmn4d0q3","title","CISA 警告 Danfoss AK-SM 8xxA 控制器未修复的 RCE 漏洞 CVE-2026-129713","originalTitle","CISA warns of critical unpatched flaw in Danfoss refrigeration controllers","summary","Danfoss AK-SM 8xxA 系列控制器存在 CVE-2026-129713 栈型缓冲区溢出漏洞，CVSS 评分为 9.8，未经认证的攻击者可触发服务器重启，并可能以 Web 服务器权限实现远程代码执行。","reason","该漏洞已在欧洲多地针对制冷控制器的攻击中使用，读者可结合未认证利用条件与厂商修复计划评估暴露风险。","source",{"_76":109},"links",{"_101":108},"publishedAt","2026-11-25T16:13:40.000Z","discoveredAt","2026-11-25T16:21:03.689Z","timelineAt","category","vuln","tags",[105,77,106,107,80,86],"score",83,"selected",true,"channel","news","story",{"_88":89,"_13":90},"x","readingMode","full","author","Bill Toulas","body",{"_61":100,"_101":-5,"_102":103,"_104":37},"outline",[91,92],"relatedStories",[87],"topics",[68,69,70,71,72,73],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fmSBzjgRjlAo","reportCount",2,"additionalSourceCount",1,{"_74":85,"_76":86},{"_74":83,"_76":84},{"_74":81,"_76":82},{"_74":79,"_76":80},{"_74":31,"_76":78},{"_74":75,"_76":77},"slug","exploited","name","在野利用","漏洞披露","vuln-mgmt","漏洞管理","industrial","工业控制","iot","IoT 与车联网","cisa","CISA",{"_88":89,"_13":90},"publicId","e9d2b9b1-3660-48c0-ae0b-a61e69639fbf","Danfoss制冷控制器栈溢出漏洞CVE-2026-129713待修复",{"_11":97,"_94":98,"_96":99},{"_11":93,"_94":95,"_96":65},"sec-2","text","发现现有防御可能遗漏的电子邮件威胁。","level","sec-1","此前 Danfoss 安全事件",3,"<p><img alt=\"CISA warns of critical unpatched flaw in Danfoss refrigeration controllers\" height=\"900\" src=\"/dailyinfo/media/502c6d4434428398.jpg\" srcset=\"/dailyinfo/media/768754c5ca86f33a.jpg 720w, /dailyinfo/media/14be7fa2ac71d349.jpg 1200w, /dailyinfo/media/502c6d4434428398.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>美国网络安全和基础设施安全局（CISA）警告称，Danfoss AK-SM 8xxA 系列控制器存在一个严重漏洞；食品零售商使用这些控制器管理商用制冷、暖通空调和照明系统。</p><p>最近，欧洲多家超市和食品零售商的 Danfoss 控制器遭到入侵，黑客远程关闭了制冷系统或调高了其温度。</p><p>该安全问题编号为 CVE-2026-129713，严重性评分为 9.8。这是控制器服务器中的基于栈的缓冲区溢出漏洞。</p><p><a href=\"https://www.wiz.io/lp/claude-code-security-best-practices-cheat-sheet?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q3_INB_FORM_Claude-Code-Security-Best-Practices&amp;sfcid=701Vh00000gJQZuIAO&amp;utm_term=FY27Q4-bleepingcomputer-article-970x250-Nov&amp;utm_content=Claude-Code-Best-Practices\"><img src=\"/dailyinfo/media/13df9947add9c9b1.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>CISA 表示，攻击者无需认证即可触发该漏洞，导致服务器重启，并可能以 Web 服务器权限实现远程代码执行。</p><p>Danfoss AK-SM 8xxA 控制器是超市和便利店制冷系统的中央控制单元。它们用于管理冷藏展示柜和压缩机机组等设备、记录温度，并在设置发生变化时发出警报。</p><p>Danfoss 将该产品系列称为 AK-SM 800A 系列，其中包括 820A、850A 和 880A 型号。根据具体型号，它们还可控制门店照明和暖通空调系统。</p><p><a href=\"https://www.cisa.gov/news-events/ics-advisories/icsa-26-328-03\">CISA 指出</a>，这些控制器部署在全球各地，但其确切数量仍不清楚。</p><p>11 月 20 日，Danfoss 发布了一则<a href=\"http://www.danfoss.com/en/service-and-support/coordinated-vulnerability-disclosure/danfoss-security-advisories/dsa-2026-12-01\">安全公告</a>，称 CVE-2026-129713 漏洞将在 Danfoss AK-SM 8xxA 系列即将推出的 5.5.x 软件版本中得到修复。</p><p>该公司表示，此次更新还将移除允许客户关闭产品中“Strict mode”的选项。</p><p>目前尚无 CVE-2026-129713 的补丁，系统管理员应采取以下措施，以降低可能受影响系统的风险：</p><ul>\n\t<li>避免将控制器接入公共互联网，并尽可能减少网络暴露。</li>\n\t<li>将控制系统与业务网络隔离，并置于防火墙之后。</li>\n\t<li>需要远程访问时，使用最新的虚拟专用网络（VPN）。</li>\n</ul><h3 id=\"sec-1\">此前 Danfoss 安全事件</h3><p>最近，Danfoss 系统在欧洲多起影响重大的网络安全事件中成为攻击目标。10 月 11 日至 12 日，法国多家超市和食品零售商遭受重大损失；此前<a href=\"https://www.bleepingcomputer.com/news/security/france-blames-iranian-hackers-for-supermarket-attacks-that-sparked-fires/\">被归因于与伊朗 IRGC 有关联的 Shahid Kaveh 小组</a>的攻击入侵了 Danfoss AK-SM/AK-SC 和 Copeland/Dixell XWEB 制冷控制器，并<a href=\"https://www.bleepingcomputer.com/news/security/cyberattack-shuts-down-refrigerators-at-french-supermarkets/\">远程修改了它们的除霜设置</a>。</p><p>11 月 2 日，比利时、荷兰、瑞典、卢森堡、爱尔兰、罗马尼亚和爱沙尼亚至少 115 家超市的制冷设备被<a href=\"https://www.bleepingcomputer.com/news/security/hackers-disrupt-refrigeration-systems-at-european-supermarkets/\">远程关闭或修改了设置</a>。</p><p>供应商 Sabcobel 表示，攻击者利用了此前在法国 10 月攻击中发现的同一漏洞，表明 Danfoss 系统再次遭到攻击。</p><p>同一天，被怀疑与同一行动有关联的攻击者还将法国国家血液服务的一家制冷供应商作为目标，在三处设施<a href=\"https://www.bleepingcomputer.com/news/security/cyberattack-disrupts-blood-storage-refrigeration-systems-in-france/\">修改了冷藏设置</a>。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/0f821b73ff70ca16.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-2\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体会分析电子邮件的意图、上下文和行为，识别网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>对 Microsoft 365 或 Google Workspace 进行为期 14 天的只读扫描，看看有哪些威胁正在穿透，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始您的免费电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","漏洞","IoT","工控","https://www.bleepingcomputer.com/news/security/cisa-warns-of-critical-unpatched-flaw-in-danfoss-refrigeration-controllers/","BleepingComputer",{"_111":112,"_113":-5},"changelogVersion","2026-10-01T08:00","release"]
