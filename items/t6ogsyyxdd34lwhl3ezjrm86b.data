[{"_1":2,"_3":4},"root",{"_5":87},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795567289000,"id","t6ogsyyxdd34lwhl3ezjrm86b","title","CIA 非涉密开源情报系统遭网络攻击，具体影响与责任方未明","originalTitle","An Unclassified CIA System Was Breached in a Cyberattack, AP Source Says","summary","Associated Press 援引知情人士称，CIA 一套处理开源情报的非涉密系统遭网络攻击，事件不涉及涉密信息且问题已解决，具体失窃内容和责任方尚不清楚。该系统收集并分析互联网、商业卫星和私人数据经纪商等来源的公开或半公开数据。美国政府称近期多起系统中断并非协同网络攻击，而是集中打补丁和升级系统所致。","reason","source",{"_72":86},"links",{"_61":85},"publishedAt","2026-11-24T22:41:58.000Z","discoveredAt","2026-11-24T22:49:32.509Z","timelineAt","category","activity","tags",[73,84,75],"score",62,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","readingMode","full","author","Associated Press","body",{"_80":-5,"_61":81,"_82":-5,"_83":36},"outline",[],"relatedStories",[76],"topics",[68,69],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fi60KqLd5aw4","reportCount",1,"additionalSourceCount",0,{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","attack","name","攻击活动","cisa","CISA",{"_77":78,"_13":79},"publicId","6b5dadbe-6075-4688-a8e6-2e059947afcd","CIA非涉密情报系统疑遭入侵","zh","<p><strong>An unclassified CIA system was breached in a cyberattack, according to a person familiar with the incident who spoke to The Associated Press on condition of anonymity.</strong>\n\n\n\n</p><p>The breach did not involve any classified information and the issue has been resolved, said the person, who was not authorized to speak by name and spoke on condition of anonymity.\n\n\n\n</p><p>The breach affected a system that handles open source intelligence, which involves the collection and analysis of publicly available data from sources including the internet, commercial satellites and private data brokers. Though the information is generally public or semi-public, open-source information can give intelligence analysts significant insight on its own or in combination with intelligence obtained from classified spying programs.\n\n\n\n</p><p>It was not clear what specific information was compromised or who was responsible.\n\n\n\n</p><p>The breach was first reported by The New York Times on Tuesday.\n\n\n\n</p><p>The incident comes to light following a series of highly disruptive system failures that unnerved many Americans. An internal network the National Security Agency uses to communicate classified information <a href=\"https://www.securityweek.com/classified-communications-network-at-the-national-security-agency-goes-down-defense-official-says/\">was offline for a time last week</a>, and the <a href=\"https://www.securityweek.com/fbi-investigating-apparent-hack-of-its-key-national-criminal-justice-database-ap-source-says/\">FBI is investigating an apparent hack</a> of a national law enforcement database that it maintains.</p><p><span>Advertisement. Scroll to continue reading.</span></p><p>Those incidents followed a nationwide ground stop that snarled air travel after air traffic controllers struggled to communicate with pilots. Apple, JP Morgan Chase and Microsoft also had systems go down this month.\n\n\n\n</p><p>The incidents have put a spotlight on the vulnerabilities inside critical infrastructure, banking systems and the digital tools that millions of people use daily.\n\n\n\n</p><p>President Donald Trump’s administration says the series of outages is not part of a coordinated cyberattack and dispatched Director of National Intelligence Jay Clayton to calm Americans in appearances on Sunday morning news shows.\n\n\n\n</p><p>Clayton said the outages largely stem from the rush to patch and upgrade systems to stay ahead of hackers who are now empowered with sophisticated artificial intelligence tools to attack at an unprecedented scale.\n\n\n\n</p><p><strong>Related</strong>: <a href=\"https://www.securityweek.com/fbi-investigating-apparent-hack-of-its-key-national-criminal-justice-database-ap-source-says/\">FBI Investigating Apparent Hack of Its Key National Criminal Justice Database, AP Source Says</a>\n      </p>","zhKind","complete","数据泄露","https://www.securityweek.com/an-unclassified-cia-system-was-breached-in-a-cyberattack-ap-source-says/","SecurityWeek",{"_88":89,"_90":-5},"changelogVersion","2026-10-01T08:00","release"]
