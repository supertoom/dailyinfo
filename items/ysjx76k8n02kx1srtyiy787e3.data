[{"_1":2,"_3":4},"root",{"_5":141},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1795480848000,"id","ysjx76k8n02kx1srtyiy787e3","title","Cisco Expressway Series 远程代码执行漏洞已列入 KEV，X15.5.20 起修复","originalTitle","Cisco Expressway Series Remote Code Execution Vulnerability","summary","Cisco Expressway Series 的数据库服务存在远程代码执行漏洞，未认证远程攻击者利用持久 Cookie 并调用特定 RPC 命令，可以 root 身份执行操作系统命令。","reason","source",{"_72":140},"links",{"_60":139},"publishedAt","2026-11-23T07:51:28.000Z","discoveredAt","2026-11-23T16:38:33.855Z","timelineAt","category","vuln","tags",[134,135,73,136,137,138],"score",64,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body",{"_130":-5,"_60":131,"_132":-5,"_133":36},"outline",[81,82,83,84,85,86,87,88,89,90,91,92,93,94,95],"relatedStories",[77],"topics",[67,68,69],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","f5oEfU3_QvM4","reportCount",1,"additionalSourceCount",0,{"_70":75,"_72":76},{"_70":30,"_72":74},{"_70":71,"_72":73},"slug","exploited","name","在野利用","漏洞披露","cisco","Cisco / 思科",{"_78":79,"_13":80},"publicId","6b87b502-2424-40f1-a2c4-de3e007d78b8","CISA确认Cisco Expressway漏洞遭在野利用",{"_11":128,"_97":129,"_99":100},{"_11":126,"_97":127,"_99":100},{"_11":124,"_97":125,"_99":100},{"_11":122,"_97":123,"_99":100},{"_11":120,"_97":121,"_99":103},{"_11":118,"_97":119,"_99":100},{"_11":116,"_97":117,"_99":100},{"_11":114,"_97":115,"_99":100},{"_11":112,"_97":113,"_99":100},{"_11":110,"_97":111,"_99":100},{"_11":108,"_97":109,"_99":100},{"_11":106,"_97":107,"_99":100},{"_11":104,"_97":105,"_99":103},{"_11":101,"_97":102,"_99":103},{"_11":96,"_97":98,"_99":100},"sec-15","text","Feedback","level",2,"sec-14","LEGAL DISCLAIMER DETAILS",3,"sec-13","SOFTWARE DOWNLOADS AND TECHNICAL SUPPORT","sec-12","Legal Disclaimer","sec-11","Revision History","sec-10","URL","sec-9","Related to This Advisory","sec-8","Cisco Security Vulnerability Policy","sec-7","Source","sec-6","Exploitation and Public Announcements","sec-5","Fixed Releases","sec-4","Fixed Software","sec-3","Workarounds","sec-2","Affected Products","sec-1","Summary","zh","<h2 id=\"sec-1\">\n<p>\n                        Summary\n                        \n                      </p>\n</h2><ul>\n<li>\n<p>A vulnerability in the database service feature of Cisco Expressway Series could allow an unauthenticated, remote attacker with network access to a Cisco Expressway device to execute arbitrary operating system commands as <em>root</em>.</p>\n<p>This vulnerability is due to the use of persistent cookies. Additionally, there is insufficient validation of client certificates when the <strong>TLS Verify Mode</strong> is set to <strong>Enabled</strong> for clustering, which means that client certificates are not validated. An attacker with possession of the cookies could exploit this vulnerability by connecting to the database service and invoking specific remote procedure call (RPC) commands. A successful exploit could allow the attacker to execute arbitrary commands as <em>root</em> on the underlying operating system of an affected device.</p>\n<p><strong>Note: </strong>Cisco Expressway Series refers to Cisco Expressway Core (Expressway-C) devices and Cisco Expressway Edge (Expressway-E) devices.</p>\n\n<p>Cisco has released software updates that address this vulnerability. There are no workarounds that address this vulnerability.</p>\n<p>This advisory is available at the following link:<br><a href=\"https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-vcs-static-cred-hr7EWZ8t\">https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-vcs-static-cred-hr7EWZ8t</a></p>\n<p>This advisory is part of a group of advisories. For a complete list of the advisories and links to them, see <a href=\"https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-notice-QGwHnJ6k\">Cisco Advance Notification for Publication of October 21, 2026, Security Advisories</a>. In addition, for further documentation of improvements and fixes in Cisco Expressway Series see <a href=\"https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-exwy-hardening-FhcqBVcs\">Cisco Expressway Series Security Hardening Release: October 2026</a>.</p>\n</li>\n</ul><h2 id=\"sec-2\">\n<p>\n                          Affected Products\n                          \n                        </p>\n</h2><ul>\n<li>\n<p>This vulnerability affects Cisco Expressway-C and Cisco Expressway-E, both virtual and appliance versions, if they are running a vulnerable release and have the devices configured in a cluster. </p>\n<p>For information about which Cisco software releases are vulnerable, see the <a href=\"https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-vcs-static-cred-hr7EWZ8t?vs_f=Cisco%20Security%20Advisory%26vs_cat=Security%20Intelligence%26vs_type=RSS%26vs_p=Cisco%20Expressway%20Series%20Remote%20Code%20Execution%20Vulnerability%26vs_k=1#fs\">Fixed Software</a> section of this advisory.</p>\n\n\n<p>Only products listed in the <a href=\"https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-vcs-static-cred-hr7EWZ8t?vs_f=Cisco%20Security%20Advisory%26vs_cat=Security%20Intelligence%26vs_type=RSS%26vs_p=Cisco%20Expressway%20Series%20Remote%20Code%20Execution%20Vulnerability%26vs_k=1#vp\">Vulnerable Products</a> section of this advisory are known to be affected by this vulnerability.</p>\n\n\n\n</li>\n</ul><h2 id=\"sec-3\">\n\n<p>\n                          Workarounds\n                          \n                        </p>\n</h2><ul>\n<li>\n<p>There are no workarounds that address this vulnerability.</p>\n</li>\n</ul><h2 id=\"sec-4\">\n<p>\n                          Fixed Software\n                          \n                        </p>\n</h2><ul>\n<li>\n<p>Cisco considers any workarounds and mitigations (if applicable) to be temporary solutions until an upgrade to a fixed software release is available. To remediate this vulnerability and avoid future exposure as described in this advisory, Cisco strongly recommends that customers upgrade to the fixed software indicated in this advisory.</p>\n\n\n<h3 id=\"sec-5\">Fixed Releases</h3>\n<p>In the following table, the left column lists Cisco software releases. The right column indicates whether a release is affected by the vulnerability that is described in this advisory and the first release that includes the fix for this vulnerability. Customers are advised to upgrade to an appropriate <a href=\"https://sec.cloudapps.cisco.com/security/center/resources/security_vulnerability_policy.html#fixes\">fixed software release</a> as indicated in this section.</p>\n<table>\n<thead>\n<tr>\n<th>Cisco Expressway Series Release</th>\n<th>First Fixed Release</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>X14 and earlier</td>\n<td>Migrate to a fixed release.</td>\n</tr>\n<tr>\n<td>X15.5.3 and earlier</td>\n<td>X15.5.20</td>\n</tr>\n</tbody>\n</table>\n<p><strong>Note: </strong>This fix is also included as part of the broader hardening improvements that are disclosed in the security advisory <a href=\"https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-exwy-hardening-FhcqBVcs\">Cisco Expressway Series Security Hardening Release: October 2026</a>.</p>\n<p>The Cisco Product Security Incident Response Team (PSIRT) validates only the affected and fixed release information that is documented in this advisory.</p>\n\n</li>\n</ul><h2 id=\"sec-6\">\n<p>\n                          Exploitation and Public Announcements\n                          \n                        </p>\n</h2><ul>\n<li>\n<p>In November 2026, this vulnerability was added to the Known Exploited Vulnerability (KEV) database of the U.S. Cybersecurity and Infrastructure Security Agency (CISA). Cisco continues to strongly recommend that customers upgrade to a fixed software release to remediate this vulnerability.</p>\n\n</li>\n</ul><h2 id=\"sec-7\">\n<p>\n                          Source\n                          \n                        </p>\n</h2><ul>\n<li>\n<p>Cisco would like to thank Stefan Aleksic of Jane Street for reporting this vulnerability.</p>\n</li>\n</ul><h2 id=\"sec-8\">\n<p>\n        Cisco Security Vulnerability Policy\n        \n      </p>\n</h2><ul>\n<li>\n\n</li>\n</ul><ul>\n<li>\n\n</li>\n</ul><h2 id=\"sec-9\">\n<p>\n          \n          Related to This Advisory\n        </p>\n</h2><h2 id=\"sec-10\">\n<p>\n                        URL\n                        \n                      </p>\n</h2><ul>\n<li>\n\n</li>\n</ul><h2 id=\"sec-11\">\n<p>\n                        Revision History\n                        \n                      </p>\n</h2><ul>\n<li>\n<table>\n\t<thead>\n\t\t<tr>\n\t\t\t<th>Version</th>\n\t\t\t<th>Description</th>\n\t\t\t<th>Section</th>\n\t\t\t<th>Status</th>\n\t\t\t<th>Date</th>\n\t\t</tr>\n\t</thead>\n\t<tbody>\n\t\t<tr>\n\t\t\t<td>1.1</td>\n\t\t\t<td>Updated to state that this vulnerability was added to the CISA KEV. Cisco does not have direct evidence of active exploitation.</td>\n\t\t\t<td>Exploitation and Public Announcements</td>\n\t\t\t<td>Final</td>\n\t\t\t<td>2026-NOV-23</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>1.0</td>\n\t\t\t<td>Initial public release.</td>\n\t\t\t<td>-</td>\n\t\t\t<td>Final</td>\n\t\t\t<td>2026-OCT-21</td>\n\t\t</tr>\n\t</tbody>\n</table>\n<p><a>Show Less</a>\n</p>\n</li>\n</ul><hr><h2 id=\"sec-12\">\n<p>\n                          Legal Disclaimer\n                        </p>\n</h2><ul>\n<li>\n<h3 id=\"sec-13\">SOFTWARE DOWNLOADS AND TECHNICAL SUPPORT</h3><p>The <a href=\"https://www.cisco.com/c/en/us/support/index.html\">Cisco Support and Downloads</a> page on Cisco.com provides information about licensing and downloads. This page can also display customer device support coverage for customers who use the My Devices tool. Please note that customers may download only software that was procured from Cisco directly or through a Cisco authorized reseller or partner and for which the license is still valid.</p><p>Customers who purchase directly from Cisco but do not hold a Cisco service contract and customers who make purchases through third-party vendors but are unsuccessful in obtaining fixed software through their point of sale should obtain upgrades by contacting the <a href=\"https://www.cisco.com/c/en/us/support/web/tsd-cisco-worldwide-contacts.html\">Cisco Technical Assistance Center (TAC)</a>. Customers should have the product serial number available and be prepared to provide the URL of this advisory as evidence of entitlement to a free upgrade.</p><p>When <a href=\"https://sec.cloudapps.cisco.com/security/center/resources/security_vulnerability_policy.html#fixes\">considering software upgrades</a>, customers are advised to regularly consult <a href=\"https://www.cisco.com/go/psirt\">the advisories</a> for the relevant Cisco products to determine exposure and a complete upgrade solution. In all cases, customers should ensure that the devices to be upgraded contain sufficient memory and confirm that current hardware and software configurations will continue to be supported properly by the new release. If the information is not clear, customers are advised to contact the <a href=\"https://www.cisco.com/c/en/us/support/web/tsd-cisco-worldwide-contacts.html\">Cisco Technical Assistance Center (TAC)</a> or their contracted maintenance providers.</p><h3 id=\"sec-14\">LEGAL DISCLAIMER DETAILS</h3><p>CISCO DOES NOT MAKE ANY EXPRESS OR IMPLIED GUARANTEES OR WARRANTIES OF ANY KIND, INCLUDING THE WARRANTIES OF MERCHANTABILITY OR FITNESS FOR A PARTICULAR USE. WITHOUT LIMITING THE GENERALITY OF THE FOREGOING, CISCO DOES NOT GUARANTEE THE ACCURACY OR COMPLETENESS OF THIS INFORMATION. THIS DOCUMENT IS PROVIDED ON AN \"AS IS\" BASIS. YOUR USE OF THE INFORMATION ON THE DOCUMENT OR MATERIALS LINKED FROM THE DOCUMENT IS AT YOUR OWN RISK. CISCO RESERVES THE RIGHT TO CHANGE OR UPDATE THIS DOCUMENT AT ANY TIME.</p><p>Copies or summaries of the information contained in this Security Advisory may lack important information or contain factual errors. Customers are advised to visit the <a href=\"https://www.cisco.com/go/psirt\">Cisco Security Advisories</a> page for the most recent version of this Security Advisory. The Cisco Product Security Incident Response Team (PSIRT) assesses only the affected and fixed release information that is documented in this advisory. See the <a href=\"https://sec.cloudapps.cisco.com/security/center/resources/security_vulnerability_policy.html#fixes\">Cisco Security Vulnerability Policy</a> for more information.</p>\n</li>\n</ul><h2 id=\"sec-15\">\n<p>\n                          Feedback\n                        </p>\n</h2><ul>\n<li>\n\n</li>\n</ul>","zhKind","complete","漏洞","补丁","Cisco","网络设备","CISA","https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-vcs-static-cred-hr7EWZ8t?vs_f=Cisco%20Security%20Advisory%26vs_cat=Security%20Intelligence%26vs_type=RSS%26vs_p=Cisco%20Expressway%20Series%20Remote%20Code%20Execution%20Vulnerability%26vs_k=1","Cisco PSIRT",{"_142":143,"_144":-5},"changelogVersion","2026-10-01T08:00","release"]
