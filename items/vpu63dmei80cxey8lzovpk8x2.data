[{"_1":2,"_3":4},"root",{"_5":90},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795567291000,"id","vpu63dmei80cxey8lzovpk8x2","title","Microsoft Windows Remote Access API 本地权限提升漏洞 CVE-2026-119853 通告","originalTitle","Windows Remote Access API本地权限提升漏洞(CVE-2026-119853)安全风险通告","summary","Microsoft Windows Remote Access API 存在本地权限提升漏洞 CVE-2026-119853，CVSS 3.1 评分为 7.8，奇安信评级为高危。","reason","通告列出受影响版本、利用前提与复现状态，并提供官方更新和多条补丁获取路径。","source",{"_71":89},"links",{"_80":88},"publishedAt","2026-11-24T03:55:41.838Z","discoveredAt","2026-11-24T09:55:41.850Z","timelineAt","category","vuln","tags",[83,84,85,86,87],"score",72,"selected",true,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","body",{"_61":79,"_80":-5,"_81":80,"_82":37},"outline",[],"relatedStories",[75],"topics",[68,69],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fVZxcnYXFhzg","reportCount",2,"additionalSourceCount",1,{"_70":73,"_71":74},{"_70":31,"_71":72},"slug","name","漏洞披露","microsoft","Microsoft / 微软",{"_76":77,"_13":78},"publicId","70595c2b-05ad-4de3-ab60-c4dfc82b0134","Windows RAS API本地提权漏洞已复现","<table><tbody><tr><td colspan=\"4\"><p><strong>漏洞概述</strong></p></td></tr><tr><td><p><strong>漏洞名称</strong></p></td><td colspan=\"3\"><p>Windows Remote Access API 本地权限提升漏洞</p></td></tr><tr><td><p><strong>漏洞编号</strong></p></td><td colspan=\"3\"><p>QVD-2026-107594，CVE-2026-119853</p></td></tr><tr><td><p><strong><strong>公开时间</strong></strong></p></td><td><p>2026-11-10</p></td><td><p><strong><strong>使用量级</strong></strong></p></td><td><p>百万级</p></td></tr><tr><td><p><strong>奇安信评级</strong></p></td><td><p><strong>高危</strong></p></td><td><p><strong>CVSS 3.1分数</strong></p></td><td><p><strong>7.8</strong></p></td></tr><tr><td><p><strong>威胁类型</strong></p></td><td><p>权限提升</p></td><td><p><strong>利用可能性</strong></p></td><td><p><strong><strong>高</strong></strong></p></td></tr><tr><td><p><strong>POC状态</strong></p></td><td><p><strong>已公开</strong></p></td><td><p><strong>在野利用状态</strong></p></td><td><p>未发现</p></td></tr><tr><td><p><strong>EXP状态</strong></p></td><td><p><strong>已公开</strong></p></td><td><p><strong>技术细节状态</strong></p></td><td><p><strong>已公开</strong></p></td></tr><tr><td colspan=\"4\"><p><strong>危害描述：</strong>攻击者可利用此漏洞获得完整系统控制权，包括修改系统文件、安装持久化后门、横向移动或进一步攻击网络资源。</p></td></tr></tbody></table><p><strong>0</strong><strong>1</strong></p><p><strong>漏洞详情</strong></p><p><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong></p><p><strong>影响组件</strong></p><p>Windows 是微软公司开发的桌面与服务器操作系统，广泛应用于个人电脑、企业办公、服务器及云环境。其 Remote Access Service（RAS）组件提供远程拨号、VPN 连接等网络接入能力，Remote Access API 是 RAS 对外暴露的编程接口，允许应用程序创建、管理和控制远程访问连接，支持自定义拨号器（Dial DLL）扩展。该 API 被系统服务及第三方软件广泛调用，用于建立安全或传统拨号连接。</p><p><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong></p><p><strong>漏洞描述</strong></p><p>近日，奇安信CERT监测到官方修复Windows Remote Access API 本地权限提升漏洞(CVE-2026-119853)，该漏洞源于 API 在加载自定义 RAS 拨号 DLL 时，对搜索路径处理不当，允许从不受信任目录加载恶意 DLL。低权限本地用户可通过放置特制 DLL 并触发相关 API 调用，使高权限进程（通常以 SYSTEM 身份运行）加载并执行恶意代码，从而完成权限提升。攻击者可利用此漏洞获得完整系统控制权，包括修改系统文件、安装持久化后门、横向移动或进一步攻击网络资源。目前该漏洞PoC和技术细节已公开，鉴于该漏洞影响范围较大，建议客户尽快做好自查及防护。</p><p><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong></p><p><strong>利用条件</strong></p><p>1.攻击者具备本地低权限账户，并可在可写且被 API 搜索的路径中放置恶意 DLL。</p><p>2.触发 Remote Access API 加载自定义拨号 DLL 的操作（可主动调用 API 或诱导相关服务/应用触发）。</p><p><strong>02</strong></p><p><strong>影响范围</strong></p><p><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong></p><p><strong>影响版本</strong></p><p>10.0.14393.0 &lt;= Windows 10 Version 1607 &lt; 10.0.14393.9688</p><p>10.0.17763.0 &lt;= Windows 10 Version 1809 &lt; 10.0.17763.9487</p><p>10.0.19044.0 &lt;= Windows 10 Version 21H2 &lt; 10.0.19044.7846</p><p>10.0.19045.0 &lt;= Windows 10 Version 22H2 &lt; 10.0.19045.7846</p><p>10.0.22631.0 &lt;= Windows 11 version 23H2 &lt; 10.0.22631.7711</p><p>10.0.26100.0 &lt;= Windows 11 Version 24H2 &lt; 10.0.26100.9974</p><p>10.0.26200.0 &lt;= Windows 11 Version 25H2 &lt; 10.0.26200.9974</p><p>10.0.28000.0 &lt;= Windows 11 version 26H1 &lt; 10.0.28000.3501</p><p>10.0.26300.0 &lt;= Windows 11 Version 26H2 &lt; 10.0.26300.9974</p><p>10.0.14393.0 &lt;= Windows Server 2016 &lt; 10.0.14393.9688</p><p>10.0.14393.0 &lt;= Windows Server 2016 (Server Core installation) &lt; 10.0.14393.9688</p><p>10.0.17763.0 &lt;= Windows Server 2019 &lt; 10.0.17763.9487</p><p>10.0.17763.0 &lt;= Windows Server 2019 (Server Core installation) &lt; 10.0.17763.9487</p><p>10.0.20348.0 &lt;= Windows Server 2022 &lt; 10.0.20348.5870</p><p>10.0.26100.0 &lt;= Windows Server 2025 &lt; 10.0.26100.33822</p><p>10.0.26100.0 &lt;= Windows Server 2025 (Server Core installation) &lt; 10.0.26100.33822</p><p><strong>03</strong></p><p><strong>复现情况</strong></p><p>目前，奇安信威胁情报中心安全研究员已成功复现Windows Remote Access API 本地权限提升漏洞(CVE-2026-119853)，截图如下：</p><p><img src=\"/dailyinfo/media/2a6ecf0eaefe6716.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong>04</strong></p><p><strong>处置建议</strong></p><p><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong></p><p><strong>安全更新</strong></p><p><strong>使用奇安信天擎的客户可以通过奇安信天擎控制台一键更新修补相关漏洞，也可以通过奇安信天擎客户端一键更新修补相关漏洞。</strong></p><p>也可以采用以下官方解决方案及缓解方案来防护此漏洞：</p><p><strong>Windows自动更新</strong></p><p>Windows系统默认启用 Microsoft Update，当检测到可用更新时，将会自动下载更新并在下一次启动时安装。还可通过以下步骤快速安装更新：</p><p>1、点击“开始菜单”或按Windows快捷键，点击进入“设置”</p><p>2、选择“更新和安全”，进入“Windows更新”（Windows Server 2012以及Windows Server 2012 R2可通过控制面板进入“Windows更新”，步骤为“控制面板”-&gt; “系统和安全”-&gt;“Windows更新”）</p><p>3、选择“检查更新”，等待系统将自动检查并下载可用更新</p><p>4、重启计算机，安装更新</p><p>系统重新启动后，可通过进入“Windows更新”-&gt;“查看更新历史记录”查看是否成功安装了更新。对于没有成功安装的更新，可以点击该更新名称进入微软官方更新描述链接，点击最新的SSU名称并在新链接中点击“Microsoft 更新目录”，然后在新链接中选择适用于目标系统的补丁进行下载并安装。</p><p><strong>手动安装补丁</strong></p><p>另外，对于不能自动更新的系统版本，可参考以下链接下载适用于该系统的补丁并安装：</p><p>https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-119853</p><p><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong><strong>&gt;</strong></p><p><strong>产品解决方案</strong></p><p><strong>奇安信天擎终端安全管理系统解决方案</strong></p><p>奇安信天擎终端安全管理系统并且有漏洞修复相关模块的用户，可以将补丁库版本更新到：2026.11.11.1000及以上版本，对内网终端进行补丁更新。</p><p>推荐采用自动化运维方案，如果控制中心可以连接互联网的用户场景，建议设置为自动从奇安信云端更新补丁库至2026.11.11.1000版本。</p><p>控制中心补丁库更新方式：每天04:00-06:00自动升级，升级源为从互联网升级。</p><p>纯隔离网内控制中心不能访问互联网，不能下载补丁库和补丁文件，需使用离线升级工具定期导入补丁库和文件到控制中心。</p><p><strong>05</strong></p><p><strong>参考资料</strong></p><p>[1]https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-119853</p><p>[2]https://www.coresecurity.com/blog/cve-2026-119853-elevating-privileges-system-through-windows-remote-access-api</p><p>声明：本文来自奇安信 CERT，版权归作者所有。文章内容仅代表作者独立观点，不代表安全内参立场，转载目的在于传递更多信息。如有侵权，请联系 anquanneican@163.com。</p>","original","zhKind","complete","漏洞","复现","漏洞利用","Microsoft","奇安信","https://www.secrss.com/articles/95946","安全内参",{"_91":92,"_93":-5},"changelogVersion","2026-10-01T08:00","release"]
