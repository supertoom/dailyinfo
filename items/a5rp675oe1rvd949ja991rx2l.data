[{"_1":2,"_3":4},"root",{"_5":147},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795653634000,"id","a5rp675oe1rvd949ja991rx2l","title","AWS Sign-In 通过 EMA 和 ID-JAG 强化 AI Agent 对 AWS MCP Server 的访问授权","originalTitle","Secure agentic access to AWS with Enterprise-Managed Authorization","summary","AWS Sign-In 新增 Enterprise-Managed Authorization（EMA），利用 Identity Assertion JWT Authorization Grant（ID-JAG），让组织通过现有企业 IdP（如 Okta）集中授权 AI 应用访问 AWS MCP Server。","reason","source",{"_75":146},"links",{"_61":145},"publishedAt","2026-11-25T21:00:37.000Z","discoveredAt","2026-11-25T21:28:22.593Z","timelineAt","category","ai-security","tags",[77,140,141,81,142,143,144],"score",60,"selected",false,"channel","news","story",{"_85":86,"_13":87},"x","readingMode","full","author","Vaibhav Chowla","body",{"_136":-5,"_61":137,"_138":-5,"_139":36},"outline",[88,89,90,91,92,93,94,95,96,97,98,99,100,101,102],"relatedStories",[84],"topics",[68,69,70,71,72],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fxsXvQF-lhT0","reportCount",1,"additionalSourceCount",0,{"_73":82,"_75":83},{"_73":80,"_75":81},{"_73":78,"_75":79},{"_73":30,"_75":77},{"_73":74,"_75":76},"slug","tools","name","工具与平台","AI 安全","ai-agent","AI Agent 安全","identity","身份与访问","cloud-native","云与原生",{"_85":86,"_13":87},"publicId","d24cc510-ce2d-4933-b0ad-1cc042aaef91","AWS Sign-In新增AI代理企业授权",{"_11":134,"_104":135,"_106":113},{"_11":132,"_104":133,"_106":113},{"_11":130,"_104":131,"_106":107},{"_11":128,"_104":129,"_106":107},{"_11":126,"_104":127,"_106":107},{"_11":124,"_104":125,"_106":107},{"_11":122,"_104":123,"_106":107},{"_11":120,"_104":121,"_106":107},{"_11":118,"_104":119,"_106":107},{"_11":116,"_104":117,"_106":107},{"_11":114,"_104":115,"_106":107},{"_11":111,"_104":112,"_106":113},{"_11":110,"_104":45,"_106":107},{"_11":108,"_104":109,"_106":107},{"_11":103,"_104":105,"_106":107},"sec-15","text","Seling Chen","level",3,"sec-14","Jaimin Bhatt","sec-13","sec-12","Conclusion",2,"sec-11","Best practices for securing AI agent access with EMA and AWS IAM","sec-10","Step 6: Verify authorization activity using AWS CloudTrail","sec-9","Step 5: Validate access to AWS MCP Server","sec-8","Step 4: Configure Claude to access AWS MCP Server","sec-7","Step 3: Configure Cross-App Access in Okta","sec-6","Step 2: Create an IAM role and configure permissions","sec-5","Step 1: Configure Okta as an OIDC IdP in IAM","sec-4","Step 0: Configure the AI application in Okta","sec-3","Prerequisites","sec-2","Configure Enterprise-Managed Authorization using Okta and AWS Sign-In","sec-1","How Enterprise-Managed Authorization works with AWS Sign-In","zh","<p><span><a href=\"https://docs.aws.amazon.com/signin/latest/userguide/what-is-sign-in.html\">AWS Sign-In</a></span> is introducing support for Enterprise-Managed Authorization (EMA) using the Identity Assertion JWT Authorization Grant (ID-JAG), enabling organizations to securely authorize AI agents to access <span><a href=\"https://docs.aws.amazon.com/agent-toolkit/latest/userguide/mcp-server.html\">AWS MCP Server</a></span> through their existing enterprise identity providers (IdPs), such as Okta. With this capability, organizations can centrally manage which applications can access <span><a href=\"https://aws.amazon.com/\">Amazon Web Services (AWS)</a></span> resources on behalf of their employees, without requiring users to manage additional long-term credentials or complete separate consent flows.</p><p>In our previous blog post, <span><a href=\"https://aws.amazon.com/blogs/security/introducing-oauth-support-for-aws-mcp-server/\">Introducing OAuth Support for AWS MCP Server</a></span>, we introduced OAuth-based authorization, enabling AI agents to securely access AWS MCP Server through interactive sign-in or programmatic authentication using AWS credentials. EMA builds on these capabilities by enabling organizations to authorize AI agents through their existing enterprise IdPs. Because authentication to an AI application doesn’t automatically grant access to AWS resources, EMA provides a way to authorize access across these separate trust domains while maintaining existing <span><a href=\"https://aws.amazon.com/iam\">AWS Identity and Access Management (IAM)</a></span> permissions.</p><p>In this post, we explain how EMA and ID-JAG work with <span><a href=\"https://docs.aws.amazon.com/signin/latest/userguide/enterprise-managed-authorization.html\">AWS Sign-In</a></span>, discuss security best practices, and walk you through configuring Okta to authorize AI agents to access AWS MCP Server.</p><h2 id=\"sec-1\">How Enterprise-Managed Authorization works with AWS Sign-In</h2><p>Enterprise-Managed Authorization (EMA) is an extension of the Model Context Protocol (MCP) that enables organizations to centrally manage how AI applications access protected resources on behalf of employees. EMA uses the Identity Assertion JWT Authorization Grant (ID-JAG), an OAuth-based authorization grant that enables enterprise IdPs to authorize access across different trust domains. Rather than requiring employees to individually authorize each MCP server, administrators can define policies in their existing IdP to control which AI applications can access specific resources.</p><p>When an employee signs in to an AI application such as Claude using their enterprise IdP, the authentication establishes their identity within Claude but doesn’t automatically grant access to AWS resources. When the AI application requests access to an MCP server, the enterprise IdP evaluates its configured access policies and issues a short-lived, signed ID-JAG assertion for the intended resource. The AI application then exchanges this assertion with the authorization server configured for the MCP server to obtain an OAuth access token, without requiring the employee to complete an additional interactive authorization flow.</p><p>For AWS MCP Server, AWS Sign-In serves as the configured OAuth authorization server. The AI application presents the ID-JAG assertion to the AWS Sign-In OAuth token endpoint. As part of the authorization process, AWS validates the assertion against the trusted IdP and uses <span><a href=\"https://docs.aws.amazon.com/IAM/latest/UserGuide/id_credentials_temp.html\">AWS Security Token Service (AWS STS)</a></span> to evaluate the IAM role’s trust policy and establish the authorized role session. AWS Sign-In then issues an OAuth access token associated with the IAM role. IAM policies attached to the role determine which AWS operations the agent can perform, allowing organizations to manage agent authorization through their enterprise IdP while enforcing existing AWS permissions.</p><p>Figure 1 illustrates how an AI application, such as Claude, uses EMA with Okta and AWS Sign-In to obtain an OAuth access token and securely access AWS MCP Server using IAM role-based permissions.</p><p>\n <img src=\"/dailyinfo/media/003afda0f2680055.webp\" srcset=\"/dailyinfo/media/9fa7604c66cc80e4.webp 720w, /dailyinfo/media/dcdb6b2caf5b9532.webp 1200w, /dailyinfo/media/003afda0f2680055.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Figure 1: Enterprise-Managed Authorization flow using Okta, AWS Sign-In, and AWS MCP Server\" width=\"3360\" height=\"1640\">\n </p><p>Figure 1: Enterprise-Managed Authorization flow using Okta, AWS Sign-In, and AWS MCP Server</p><p>The authorization flow consists of the following steps, as illustrated in Figure 1:</p><ol> \n <li><b>Employee authentication:</b> The employee signs in to the AI application, such as Claude, using their enterprise IdP, such as Okta, through single sign-on (SSO).</li> \n <li><b>ID-JAG request:</b> When the AI application needs to access AWS MCP Server, it requests an ID-JAG from Okta for the intended resource.</li> \n <li><b>Enterprise authorization:</b> Okta evaluates the configured access policies to determine whether the employee and AI application are authorized to access AWS MCP Server. If authorized, Okta issues a short-lived, signed ID-JAG assertion.</li> \n <li><b>Token exchange with AWS Sign-In:</b> The AI application sends the ID-JAG to the AWS Sign-In OAuth token endpoint. AWS Sign-In validates the assertion, including its issuer, signature, audience/tenant, expiration, and intended resource, and verifies the associated IAM role authorization before issuing an OAuth access token.</li> \n <li><b>Access AWS MCP Server:</b> The AI application presents the AWS-issued OAuth access token to AWS MCP Server. The server validates the token, and access to AWS resources is governed by the permissions associated with the IAM role.</li> \n</ol><h2 id=\"sec-2\">Configure Enterprise-Managed Authorization using Okta and AWS Sign-In</h2><p>In this section, we walk you through configuring Enterprise-Managed Authorization (EMA) to enable an AI application, such as Claude, to securely access AWS MCP Server using an enterprise identity managed in Okta.</p><p>The configuration establishes trust between Okta and AWS, defines IAM permissions for accessing AWS resources, and configures enterprise authorization policies that govern AI application access. This walkthrough uses AWS MCP Server in the US West (Oregon) AWS Region (<code>us-west-2</code>).</p><h3 id=\"sec-3\">Prerequisites</h3><p>Before you begin, make sure you have the following:</p><ul> \n <li>An AWS account with permissions to configure IAM IdPs, roles, and policies.</li> \n <li>An Okta organization with administrative permissions to manage applications and configure Cross-App Access policies.</li> \n <li>An AI application, such as Claude, that supports EMA and ID-JAG.</li> \n <li>Access to AWS MCP Server with support for OAuth-based Enterprise-Managed Authorization.</li> \n <li>The AWS Region where you will configure the integration.</li> \n</ul><h3 id=\"sec-4\">Step 0: Configure the AI application in Okta</h3><p>Configure an application in Okta so that employees can sign in to the AI application through enterprise single sign-on (SSO). For this walkthrough, we use Claude as the AI application. If your organization already uses Claude with Okta SSO, you can use the existing application. This application is the requesting application when you configure Cross-App Access in Step 3.</p><ol> \n <li><b>Create the Claude SSO application</b>: In the Okta Admin Console, go to <b>Applications</b>, choose <b>Create App Integration</b>, and create an OIDC web application, for example Claude SSO, as shown in Figure 2. \n  <ul> \n   <li>If your agent was imported through an <span><a href=\"https://help.okta.com/oie/en-us/content/topics/ai-agents/ai-agent-configure-claude.htm\">Okta AI Agent Provider</a></span>, create the OIDC application by going to <b>Directory</b>, <b>AI Agents</b>, then navigating to <b>User access</b> from the selected agent.</li> \n  </ul> </li> \n <li><b>Choose the grant types</b>: Select <b>Authorization Code</b> and <b>Refresh Token</b>. Claude uses the refresh token to request new ID-JAG assertions without asking employees to sign in again.</li> \n <li><b>Add the redirect URI:</b> Set Sign-in redirect URIs to Claude’s SSO callback URL.</li> \n <li><b>Assign employees:</b> Under <b>Assignments</b>, select which employees or groups can access the application.</li> \n <li><b>Confirm SSO works:</b> Check that employees can sign in to Claude through Okta before you continue.</li> \n</ol><p>\n <img src=\"/dailyinfo/media/233a08013f603306.webp\" srcset=\"/dailyinfo/media/0a6ed37ba0d2b089.webp 720w, /dailyinfo/media/c7be111a3f2c1652.webp 1200w, /dailyinfo/media/233a08013f603306.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Figure 2: Creating the Claude SSO app integration in Okta\" width=\"1526\" height=\"2810\">\n </p><p>Figure 2: Creating the Claude SSO app integration in Okta</p><h3 id=\"sec-5\">Step 1: Configure Okta as an OIDC IdP in IAM</h3><p>Create an OpenID Connect (OIDC) IdP so that AWS trusts the ID-JAG assertions that Okta issues, as shown in Figure 3.</p><ol> \n <li><b>Add the IdP:</b> In the AWS Management Console for IAM, go to <b>Identity providers</b>, choose <b>Add provider,</b> and select <b>OpenID Connect</b>.</li> \n <li><b>Enter the provider URL:</b> For <b>Provider URL</b>, enter your Okta org URL, for example <code>https://integrator-1234567.okta.com</code>. Okta issues ID-JAG assertions from the org authorization server, not from a custom authorization server.</li> \n <li><b>Enter the audience:</b> For <b>Audience</b>, enter the AWS Sign-In authorization server for your Region, for example <code>https://us-west-2.oauth.signin.aws</code>, and choose <b>Add provider</b>.</li> \n</ol><p>\n <img src=\"/dailyinfo/media/ee6d0d61e97bffb6.webp\" srcset=\"/dailyinfo/media/f7bc6d7cd73408bf.webp 720w, /dailyinfo/media/eff5edfcffaf79ff.webp 1200w, /dailyinfo/media/ee6d0d61e97bffb6.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Figure 3: Adding Okta as an OpenID Connect identity provider in IAM\" width=\"3276\" height=\"1844\">\n </p><p>Figure 3: Adding Okta as an OpenID Connect identity provider in IAM</p><h3 id=\"sec-6\">Step 2: Create an IAM role and configure permissions</h3><p>Create an IAM role that defines the AWS permissions granted to the AI application, as shown in Figure 4.</p><ol> \n <li><b>Create the role:</b> In the IAM console, go to <b>Roles</b>, choose <b>Create role</b>, and select <b>Web identity</b> as the trusted entity type. Choose the Okta IdP from Step 1 and its audience. This creates a trust policy that allows access only through assertions from that provider.</li> \n <li><b>Attach the AWS MCP Server permissions:</b> Attach the AWS managed policy <span><a href=\"https://docs.aws.amazon.com/aws-managed-policy/latest/reference/AWSMCPSignInOAuthAccessPolicy.html\">AWSMCPSignInOAuthAccessPolicy</a></span>. It grants the <code>signin:CreateOAuth2Token</code> permission required for OAuth access to AWS MCP Server.</li> \n <li><b>Attach the AWS permissions the AI application needs:</b> Attach other IAM policies that grant only the AWS permissions required by the AI application. For this walkthrough, we use a read-only role.</li> \n <li><b>Name and create the role:</b> Enter a role name, for example <code>OktaAwsMcpReadOnly</code>, and choose <b>Create role</b>.</li> \n <li><b>Copy the role ARN:</b> You’ll enter the role Amazon Resource Name (ARN) as the <b>Audience/tenant</b> ID in Okta in Step 3.</li> \n</ol><p>\n <img src=\"/dailyinfo/media/5f7872e1d1fc0260.webp\" srcset=\"/dailyinfo/media/36afe58aa635245b.webp 720w, /dailyinfo/media/dcbec22dfc9e8be1.webp 1200w, /dailyinfo/media/5f7872e1d1fc0260.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Figure 4: Reviewing the IAM role and its trust policy\" width=\"1666\" height=\"1586\">\n </p><p>Figure 4: Reviewing the IAM role and its trust policy</p><h3 id=\"sec-7\">Step 3: Configure Cross-App Access in Okta</h3><p>In the Okta Admin Console, create a resource application that represents AWS MCP Server, and then connect Claude to it. The Claude SSO App from Step 0 stays the requesting application, so you don’t enable Cross-App Access on it.</p><ol> \n <li><b>Create the AWS MCP resource application:</b> Go to <b>Applications</b>, choose <b>Create App Integration</b>, and create an OIDC web application, for example AWS MCP (us-west-2). Okta doesn’t use this application’s sign-in redirect URI, so you can keep the default value. \n  <p>\n   <img src=\"/dailyinfo/media/4b31deca1b073ff8.webp\" srcset=\"/dailyinfo/media/5a056bbdbaaa98b0.webp 720w, /dailyinfo/media/48d39aa705e5fd5e.webp 1200w, /dailyinfo/media/4b31deca1b073ff8.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Figure 5: Creating the AWS MCP resource application in Okta\" width=\"1518\" height=\"2812\">\n   </p><p>Figure 5: Creating the AWS MCP resource application in Okta</p>\n   </li> \n <li><b>Enable Cross-App Access on the resource application:</b> On the <b>Machine Assignments</b> tab, edit the access method and enable Cross-App Access. Set <b>Issuer URL</b> to <code>https://us-west-2.oauth.signin.aws</code> and set <b>Audience/tenant ID</b> to the IAM role ARN from Step 2. \n  <p>\n   <img src=\"/dailyinfo/media/6b6f106b9ff83513.webp\" srcset=\"/dailyinfo/media/7d73aae30c60afa2.webp 720w, /dailyinfo/media/40c32f7046b52c58.webp 1200w, /dailyinfo/media/6b6f106b9ff83513.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Figure 6: Enabling Cross-App Access on the AWS MCP resource application\" width=\"2066\" height=\"1714\">\n   </p><p>Figure 6: Enabling Cross-App Access on the AWS MCP resource application</p>\n   </li> \n <li><b>Assign employees:</b> On the <b>Assignments</b> tab, assign the employees or groups who can access AWS MCP Server through Claude.</li> \n <li><b>Register Claude as an AI agent:</b> Go to <b>Directory</b>, <b>AI Agents,</b> and choose <b>Register AI agent</b>. Under <b>User access</b>, choose <b>Select an existing app</b> and pick the <b>Claude SSO App</b> from Step 0. \n  <ul> \n   <li>Skip this step if the agent was already imported via an <span><a href=\"https://help.okta.com/oie/en-us/content/topics/ai-agents/ai-agent-configure-claude.htm\">Okta AI Agent Provider</a></span>.</li> \n  </ul> </li> \n <li><b>Connect the AI agent to AWS MCP Server:</b> On the AI agent page, add a resource connection with the <b>Application</b> resource type. Set <b>Application</b> <b>instance</b> to the AWS MCP resource application. Set the <b>client ID</b> registered in AWS MCP to the client ID that you configure in Claude in Step 4, for example <code>anthropic-claude</code>. Set <b>Resource</b> identifier to <code>https://aws-mcp.us-west-2.api.aws/mcp</code>.<br> \n  <p>\n   <img src=\"/dailyinfo/media/c8ac50dced9ec299.webp\" srcset=\"/dailyinfo/media/91bbfe3b69badaa2.webp 720w, /dailyinfo/media/77fda04fd8373980.webp 1200w, /dailyinfo/media/c8ac50dced9ec299.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Figure 7: Connecting the Claude AI agent to the AWS MCP resource application\" width=\"1720\" height=\"1662\">\n   </p><p>Figure 7: Connecting the Claude AI agent to the AWS MCP resource application</p>\n   </li> \n</ol><p>When Claude requests access, Okta checks that the employee is assigned access and issues an ID-JAG for AWS Sign-In that carries the IAM role ARN. AWS Sign-In validates the assertion and issues an OAuth access token associated with the IAM role.</p><h3 id=\"sec-8\">Step 4: Configure Claude to access AWS MCP Server</h3><ol> \n <li><b>Add a custom connector:</b> In Claude, open <b>Admin settings</b>, choose <b>Connectors</b>, and then choose <b>Add, Custom connector</b>. Enter a name and the AWS MCP Server endpoint, for example <code>https://aws-mcp.us-west-2.api.aws/mcp</code>.</li> \n <li><b>Configure OAuth authentication:</b> For <b>Authentication</b>, choose <b>Sign in when needed</b>. For <b>OAuth client</b>, choose <b>Use your own OAuth client</b>, enter the client ID from the resource connection in Step 3 and leave the client secret blank.<br> \n  <p>\n   <img src=\"/dailyinfo/media/3524ab761acba575.webp\" srcset=\"/dailyinfo/media/7f4cf72d6e734c7f.webp 720w, /dailyinfo/media/d27920a32d3f84c0.webp 1200w, /dailyinfo/media/3524ab761acba575.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Figure 8: Adding AWS MCP Server as a custom connector in Claude\" width=\"1058\" height=\"1756\">\n   </p><p>Figure 8: Adding AWS MCP Server as a custom connector in Claude</p>\n   </li> \n <li><b>Set up managed authorization:</b> Open the connector, and on the <b>Configuration</b> tab, choose <b>Set up</b> next to <b>Managed authorization</b>.<br> \n  <p>\n   <img src=\"/dailyinfo/media/2b92d4d3e4de8ec9.webp\" srcset=\"/dailyinfo/media/3fc4ecea5976a6e0.webp 720w, /dailyinfo/media/6031007571677759.webp 1200w, /dailyinfo/media/2b92d4d3e4de8ec9.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Figure 9: The connector’s Configuration tab\" width=\"1094\" height=\"1398\">\n   </p><p>Figure 9: The connector’s Configuration tab</p>\n   </li> \n <li><b>Configure IdP-managed access:</b> Choose <b>IdP-managed</b> as the identity source and confirm that the connection checks pass. Then choose <b>Continue</b>, select the Claude roles that connect through managed authorization, and choose Save.<br> \n  <p>\n   <img src=\"/dailyinfo/media/20f7cb804f6777f2.webp\" srcset=\"/dailyinfo/media/e1b66e124b687058.webp 720w, /dailyinfo/media/3a8502dbc25ee07e.webp 1200w, /dailyinfo/media/20f7cb804f6777f2.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Figure 10: Setting up managed authorization with Okta as the identity source\" width=\"1426\" height=\"1246\">\n   </p><p>Figure 10: Setting up managed authorization with Okta as the identity source</p>\n   </li> \n</ol><p>When an employee accesses AWS MCP Server, Claude requests an ID-JAG assertion from Okta. Following successful policy evaluation, Okta issues the assertion, which Claude exchanges at the AWS Sign-In OAuth token endpoint for an OAuth access token associated with the configured IAM role. Claude uses this token to access AWS MCP Server without requiring an additional AWS sign-in.</p><h3 id=\"sec-9\">Step 5: Validate access to AWS MCP Server</h3><p>To validate the configuration:</p><ol> \n <li><b>Sign in using enterprise SSO:</b> Sign in to the AI application using your Okta identity.<br> \n  <p>\n   <img src=\"/dailyinfo/media/3391b100cf0935e0.webp\" srcset=\"/dailyinfo/media/4a90dbdb1ab264df.webp 720w, /dailyinfo/media/669056fdadca1257.webp 1200w, /dailyinfo/media/3391b100cf0935e0.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Figure 11: Signing in to Claude with SSO\" width=\"892\" height=\"1086\">\n   </p><p>Figure 11: Signing in to Claude with SSO</p>\n   </li> \n <li><b>Connect to AWS MCP Server</b>: Connect the AI application to AWS MCP Server.</li> \n <li><b>Verify OAuth token issuance:</b> Confirm that Claude successfully connects to AWS MCP Server without requiring a separate AWS authorization flow. You can verify successful OAuth token issuance using AWS CloudTrail, as described in Step 6.</li> \n <li><b>Validate authorized access:</b> Perform an AWS operation permitted by the configured IAM role.<br> \n  <p>\n   <img src=\"/dailyinfo/media/103cf170d8925621.webp\" srcset=\"/dailyinfo/media/d40f83d1b9836f46.webp 720w, /dailyinfo/media/090950c46d56d9b4.webp 1200w, /dailyinfo/media/103cf170d8925621.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Figure 12: Calling AWS MCP Server from Claude Code\" width=\"1620\" height=\"1096\">\n   </p><p>Figure 12: Calling AWS MCP Server from Claude Code</p>\n   </li> \n <li><b>Verify access restrictions:</b> Attempt an operation outside the IAM role’s permissions and confirm that access is denied.</li> \n</ol><p>You can also validate enterprise authorization policies by attempting access using an employee who is not authorized in Okta and verifying that the ID-JAG request is denied.</p><h3 id=\"sec-10\">Step 6: Verify authorization activity using AWS CloudTrail</h3><p>AWS Sign-In and AWS MCP Server integrate with <span><a href=\"https://aws.amazon.com/cloudtrail\">AWS CloudTrail</a></span> to help organizations monitor OAuth authorization activity and API requests made by AI applications. CloudTrail provides visibility into token issuance, the applications requesting access, and operations performed through AWS MCP Server.</p><p>After successfully connecting your AI application to AWS MCP Server, you can verify the authorization activity in CloudTrail:</p><ol> \n <li>Open the CloudTrail console and navigate to <b>Event history</b>.</li> \n <li>Select the AWS Region used for the integration.</li> \n <li>Filter events by <b>Event source</b> <code>signin.amazonaws.com</code> or <b>Event name</b> <code>CreateOAuth2Token</code> to locate OAuth token issuance activity.</li> \n <li>Review the event details, including the OAuth client identifier, target resource, authorization grant type, and token issuance status, where recorded.</li> \n <li>To review subsequent MCP activity, examine events from <code>aws-mcp.amazonaws</code>.com with the same session ARN and verify that the operations performed by the AI application match the permissions configured for the IAM role. Calls to global services such as IAM are recorded in US East (N. Virginia).</li> \n</ol><p><b>Example 1: AWS Sign-In OAuth token issuance</b></p><p>The following example illustrates the CloudTrail fields used to examine an OAuth token issuance event.</p><pre class=\"language-text\"><code class=\"language-text\">{\n  \"eventVersion\": \"1.11\",\n  \"userIdentity\": {\n    \"type\": \"AssumedRole\",\n    \"principalId\": \"AROA1234567890EXAMPLE:IDAAG.nM5xzagNal2jb_tdJucKeDBJHAU6XtsjXoSpIzOqvoE\",\n    \"arn\": \"arn:aws:sts::123456789012:assumed-role/OktaAwsMcpReadOnly/IDAAG.nM5xzagNal2jb_tdJucKeDBJHAU6XtsjXoSpIzOqvoE\",\n    \"accountId\": \"123456789012\",\n    \"sessionContext\": {\n      \"sessionIssuer\": {\n        \"type\": \"Role\",\n        \"principalId\": \"AROA1234567890EXAMPLE\",\n        \"arn\": \"arn:aws:iam::123456789012:role/OktaAwsMcpReadOnly\",\n        \"accountId\": \"123456789012\",\n        \"userName\": \"OktaAwsMcpReadOnly\"\n      },\n      \"webIdFederationData\": {\n        \"federatedProvider\": \"arn:aws:iam::123456789012:oidc-provider/integrator-1234567.okta.com\",\n        \"attributes\": {}\n      },\n      \"attributes\": {\n        \"creationDate\": \"2026-11-12T00:10:30Z\",\n        \"mfaAuthenticated\": \"false\"\n      }\n    }\n  },\n  \"eventTime\": \"2026-11-12T00:10:31Z\",\n  \"eventSource\": \"signin.amazonaws.com\",\n  \"eventName\": \"CreateOAuth2Token\",\n  \"awsRegion\": \"us-west-2\",\n  \"sourceIPAddress\": \"10.0.0.25\",\n  \"userAgent\": \"python-httpx/0.28.1\",\n  \"requestParameters\": {\n    \"resource\": \"https://aws-mcp.us-west-2.api.aws/mcp\",\n    \"client_id\": \"arn:aws:signin:::external-client/jwt-bearer/anthropic-claude\"\n  },\n  \"responseElements\": null,\n  \"additionalEventData\": {\n    \"signInSessionArn\": \"arn:aws:signin:us-west-2:123456789012:session/318c7829-2be1-4c7d-b693-538685cc1d49\",\n    \"grant_type\": \"urn:ietf:params:oauth:grant-type:jwt-bearer\",\n    \"success\": \"true\"\n  },\n  \"requestID\": \"0a475993-9f25-4198-9ed6-a8a141a05e99\",\n  \"eventID\": \"21a99293-1659-49de-ad69-143c81c3e7a6\",\n  \"readOnly\": true,\n  \"eventType\": \"AwsApiCall\",\n  \"managementEvent\": true,\n  \"recipientAccountId\": \"123456789012\",\n  \"eventCategory\": \"Management\",\n  \"tlsDetails\": {\n    \"tlsVersion\": \"TLSv1.3\",\n    \"cipherSuite\": \"TLS_AES_128_GCM_SHA256\",\n    \"clientProvidedHostHeader\": \"us-west-2.oauth.signin.aws\"\n  }\n}</code></pre><p><b>Example 2: AWS API call performed through AWS MCP Server</b></p><p>The following example illustrates the CloudTrail fields used to examine an AWS API call performed through AWS MCP Server.</p><pre class=\"language-text\"><code class=\"language-text\">{\n  \"eventVersion\": \"1.11\",\n  \"userIdentity\": {\n    \"type\": \"AssumedRole\",\n    \"principalId\": \"AROA1234567890EXAMPLE:IDAAG.nM5xzagNal2jb_tdJucKeDBJHAU6XtsjXoSpIzOqvoE\",\n    \"arn\": \"arn:aws:sts::123456789012:assumed-role/OktaAwsMcpReadOnly/IDAAG.nM5xzagNal2jb_tdJucKeDBJHAU6XtsjXoSpIzOqvoE\",\n    \"accountId\": \"123456789012\",\n    \"accessKeyId\": \"ASIA123456789EXAMPLE\",\n    \"sessionContext\": {\n      \"sessionIssuer\": {\n        \"type\": \"Role\",\n        \"principalId\": \"AROA1234567890EXAMPLE\",\n        \"arn\": \"arn:aws:iam::123456789012:role/OktaAwsMcpReadOnly\",\n        \"accountId\": \"123456789012\",\n        \"userName\": \"OktaAwsMcpReadOnly\"\n      },\n      \"webIdFederationData\": {\n        \"federatedProvider\": \"arn:aws:iam::123456789012:oidc-provider/integrator-1234567.okta.com\",\n        \"attributes\": {}\n      },\n      \"attributes\": {\n        \"creationDate\": \"2026-11-12T00:10:30Z\",\n        \"mfaAuthenticated\": \"false\"\n      },\n      \"signInSessionArn\": \"arn:aws:signin:us-west-2:123456789012:session/318c7829-2be1-4c7d-b693-538685cc1d49\"\n    },\n    \"invokedBy\": \"aws-mcp.amazonaws.com\"\n  },\n  \"eventTime\": \"2026-11-12T00:11:20Z\",\n  \"eventSource\": \"iam.amazonaws.com\",\n  \"eventName\": \"ListUsers\",\n  \"awsRegion\": \"us-east-1\",\n  \"sourceIPAddress\": \"aws-mcp.amazonaws.com\",\n  \"userAgent\": \"aws-mcp.amazonaws.com\",\n  \"requestParameters\": null,\n  \"responseElements\": null,\n  \"requestID\": \"43c45638-b0ee-4f04-a30f-10e4012c85be\",\n  \"eventID\": \"ed17577a-8d85-405d-9796-9a296a1f59b4\",\n  \"readOnly\": true,\n  \"eventType\": \"AwsApiCall\",\n  \"managementEvent\": true,\n  \"recipientAccountId\": \"123456789012\",\n  \"eventCategory\": \"Management\"\n}</code></pre><p>Together, these events help administrators audit OAuth token issuance and subsequent AWS MCP Server activity, supporting security investigations, compliance monitoring, and access reviews.</p><p>For more information, see <span><a href=\"https://docs.aws.amazon.com/signin/latest/userguide/aws-mcp-server.html#aws-mcp-server-monitoring\">Monitoring OAuth activity</a></span> and <span><a href=\"https://docs.aws.amazon.com/agent-toolkit/latest/userguide/logging-using-cloudtrail.html\">Logging AWS MCP Server API calls using AWS CloudTrail</a></span>.</p><h3 id=\"sec-11\">Best practices for securing AI agent access with EMA and AWS IAM</h3><p>When configuring Enterprise-Managed Authorization (EMA), consider the following security recommendations to help protect AI agent access to AWS resources:</p><ul> \n <li><b>Use short-lived ID-JAG assertions:</b> Configure your enterprise IdP to issue ID-JAG assertions with short expiration periods. This limits the time during which an assertion can be exchanged for an OAuth access token and reduces the risk associated with token exposure.</li> \n <li><b>Use tenant-specific IdP issuers:</b> In multi-tenant environments, configure tenant-specific issuer URLs to establish explicit trust relationships between AWS and the intended enterprise IdP. This helps prevent assertions issued for one tenant from being accepted in another tenant’s authorization context.</li> \n <li><b>Restrict OAuth authorization using IAM condition keys:</b> Use IAM condition keys to limit OAuth token issuance to approved AI applications, authorization flows, and AWS resources. For example, use <code>signin:OAuthClientId</code> to restrict access to approved AI applications, such as <code>arn:aws:signin:::external-client/jwt-bearer/anthropic-claude</code> and <code>signin:OAuthGrantType</code> to restrict the permitted grant type to <code>urn:ietf:params:oauth:grant-type:jwt-bearer</code>. Scope these permissions to the AWS MCP Server service principal to prevent unintended access to other AWS services.</li> \n <li><b>Apply least-privilege IAM permissions:</b> Grant the IAM role only the permissions required by the AI application. Use managed policies to control which AWS operations the agent can perform through AWS MCP Server, reducing the impact of unauthorized or unintended actions.</li> \n</ul><p>For more information about available IAM condition keys and permissions, see the <span><a href=\"https://docs.aws.amazon.com/signin/latest/userguide/reference-signin-condition-keys.html\">AWS Sign-In condition keys reference</a></span> and the <span><a href=\"https://docs.aws.amazon.com/aws-managed-policy/latest/reference/AWSMCPSignInOAuthAccessPolicy.html\">AWSMCPSignInOAuthAccessPolicy</a></span> documentation.</p><h2 id=\"sec-12\">Conclusion</h2><p>Enterprise-Managed Authorization (EMA) with AWS Sign-In enables organizations to securely connect AI agents to AWS resources using their existing enterprise IdPs. By combining centralized authorization policies with IAM permissions, organizations can control which AI applications access their resources while reducing the need for employees to manage AWS credentials or complete additional authorization flows.</p><p>Using ID-JAG, AWS Sign-In exchanges enterprise-issued identity assertions for short-lived OAuth access tokens associated with IAM roles. This approach helps organizations enforce least-privilege access, reduce credential exposure, and simplify how employees securely access AWS resources through AI agents.</p><p>To get started, see the <span><a href=\"https://docs.aws.amazon.com/signin/latest/userguide/oauth-sign-in-overview.html\">Sign-in with OAuth 2.0</a></span>, <span><a href=\"https://docs.aws.amazon.com/signin/latest/userguide/enterprise-managed-authorization.html\">Configure EMA for MCP servers</a></span>, and <span><a href=\"https://aws.amazon.com/blogs/security/introducing-oauth-support-for-aws-mcp-server/\">Introducing OAuth Support for AWS MCP Server</a></span> to learn more about OAuth-based access to AWS resources.</p><p>If you have questions about this post, contact <a href=\"https://aws.amazon.com/contact-us/\">AWS Support</a> or start a new thread on <a href=\"https://repost.aws/\">AWS re:Post</a>.</p><hr><p> \n   <img src=\"/dailyinfo/media/08bd342f9424aa64.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"Vaibhav Chowla\" width=\"120\" height=\"160\"> \n  </p><h3 id=\"sec-13\">Vaibhav Chowla</h3><p>Vaibhav is a Senior Technical Product Manager at AWS, specializing in AWS Identity products. He focuses on enhancing user authentication and security, helping customers of all sizes solve complex identity and access management challenges. Outside of technology, Vaibhav enjoys traveling and exploring new cultures and cuisines.</p><p> \n   <img src=\"/dailyinfo/media/58409cc64719e690.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"Jaimin Bhatt\" width=\"120\" height=\"160\"> \n  </p><h3 id=\"sec-14\">Jaimin Bhatt</h3><p>Jaimin is a Principal Software Engineer at AWS. He works on AWS Identity and Access Management (IAM) across sign-in, threat detection, and the authentication and authorization that secures access to AWS. Previously, he led work on data perimeter controls for AWS Management Console sign-in, multi-session support for the console, a simplified AWS CLI sign-in experience, and the internal Amazon identity provider.</p><p> \n   <img src=\"/dailyinfo/media/5a926dcb2c0f74af.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"Seling Chen\" width=\"120\" height=\"160\"> \n  </p><h3 id=\"sec-15\">Seling Chen</h3><p>Seling is a Senior Software Engineer on the AWS Identity Sign-In team, which focuses on securing access to the AWS Management Console, the AWS CLI, and MCP servers. Her contributions include OAuth 2.0 Token Exchange, data perimeter enforcement in AWS Sign-In, and multi-session support for the console. </p>","zhKind","complete","Agent 安全","工具发布","云原生","大模型","AWS","https://aws.amazon.com/blogs/security/secure-agentic-access-to-aws-with-enterprise-managed-authorization/","AWS Security Blog",{"_148":149,"_150":-5},"changelogVersion","2026-10-01T08:00","release"]
