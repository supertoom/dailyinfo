[{"_1":2,"_3":4},"root",{"_5":108},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":37,"_59":60},"expiresAt",1795480845000,"id","vk1sqw9r2vpu5keky20h61mo3","title","Microsoft 365 全球中断期间出现高量级协同钓鱼活动","originalTitle","Microsoft Warns of Coordinated Phishing Campaign Leveraging M365 Service Outage","summary","Microsoft 确认全球出现一场利用 Microsoft 365 服务中断实施的高量级协同钓鱼活动，邮件冒充服务健康通知，诱导用户点击恶意链接并提交凭据。服务中断于 November 12 11.20 EST 开始，持续超过 22 小时，November 13 23.15 EST 全面恢复。","reason","邮件以24小时删除期限制造紧迫感，并给出发送域名、链接域名和处置步骤，便于防守团队回溯与处置。","source",{"_73":107},"links",{"_98":106},"publishedAt","2026-11-17T13:00:00.000Z","discoveredAt","2026-11-17T13:15:33.590Z","timelineAt","category","activity","tags",[74,102,103,104,105],"score",70,"selected",true,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","body",{"_60":97,"_98":-5,"_99":100,"_101":37},"outline",[85,86,87],"relatedStories",[81],"topics",[67,68,69,70],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","fIfHntm2d4RM","reportCount",4,"additionalSourceCount",3,{"_71":79,"_73":80},{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","attack","name","攻击活动","email","邮件与钓鱼","identity","身份与访问","microsoft","Microsoft / 微软",{"_82":83,"_13":84},"publicId","caeb8d6f-1cd3-4db4-b8ed-a5f3f3c16c9a","攻击者借Microsoft 365故障实施钓鱼",{"_11":95,"_89":96,"_91":92},{"_11":93,"_89":94,"_91":92},{"_11":88,"_89":90,"_91":92},"sec-3","text","敦促安全团队调查此次攻击","level",2,"sec-2","钓鱼活动的展开方式","sec-1","撰写者","<h2 id=\"sec-1\">撰写者</h2><p><img src=\"/dailyinfo/media/b028bd9e6765b09d.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Photo of James Coker\"></p><p>\n\tMicrosoft 已识别出一场“协调、高流量”的全球钓鱼活动，旨在利用近期的 <a href=\"https://www.infosecurity-magazine.com/news/microsoft-365-outage-security/\">Microsoft 365 中断事件</a>。</p><p>\n\t11 月 13 日，在该公司正忙于为影响 Outlook 和 Teams 等全球服务的技术故障推出修复措施期间，研究人员观察到了这场活动。</p><p>\n\t中断始于 11 月 12 日 11.20 EST，持续超过 22 小时；Microsoft 确认其服务已于 11 月 13 日 23.15 EST 完全恢复。</p><p>\n\t这些钓鱼邮件旨在利用个人和员工急于重新连接 M365 服务的心理，诱使他们点击恶意链接并窃取其凭据。</p><p>\n\t邮件冒充合法的 M365 服务健康通知，声称收件人的邮件在服务中断期间被暂存，并将在 24 小时内被删除，除非收件人采取行动予以恢复，从而制造虚假的紧迫感。</p><p>\n\tMicrosoft 在 11 月 16 日发布的<a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/16/high-volume-phishing-campaign-uses-microsoft-365-outage-lures-target-multiple-industry-sectors-2/\">博客</a>中写道：“这与历史攻击者活动相符，这些活动持续寻找值得关注的全球事件，用于其社会工程诱饵。”</p><p>\n\t目前没有证据表明该活动导致了凭据窃取、恶意软件投递或失陷后活动。不过，各组织已被敦促调查是否有任何用户点击了恶意链接；如果确有此类情况，应立即采取措施缓解任何恶意活动。</p><h2 id=\"sec-2\">\n\t<strong>钓鱼活动的展开方式</strong></h2><p>\n\t活动期间发送的邮件诱饵使用主题模式“Outage – &lt;random token&gt;”，显示名称则由一个三字符的组织风格前缀加上“Outage Notification”或“Service Health”构成。</p><p>\n\tMicrosoft 表示，使用特定的发件人域名，例如 moments-notice[.]com、planetmaison[.]com 和 newbooker[.]com，旨在让邮件更具针对性，并显得与收件人相关。</p><p>\n\t邮件通常使用 24 小时删除期限，并采用醒目的“RESTORE MESSAGES”链接作为行动号召，促使用户立即采取行动。邮件还提及了 Exchange Online、Outlook、Teams、SharePoint 和 Copilot 等 Microsoft 服务。</p><p>\n\t邮件正文包含伪造的邮件对话，并将其放置在收件人可能无法看到的位置，这似乎是试图规避邮件筛选机制。</p><figure><img src=\"/dailyinfo/media/2c7f82d971a55078.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Sample of one of the Microsoft 365 outage-themed phishing lures. Source: Microsoft\"><figcaption>\n\t以 Microsoft 365 中断为主题的钓鱼诱饵样本。来源：Microsoft</figcaption></figure><p>\n\t邮件还利用电子邮件投递和链接跟踪基础设施生成面向特定收件人的 URL。</p><p>\n\t如果点击链接，收件人将被引导至 reallifeaccounting[.]com 或 reallifeaccounting[.]com/themelist0.html。</p><p>\n\t观察到的邮件均基于链接，未使用二维码或非 EML 附件。</p><p>\n\t此外，研究人员未发现投递可执行文件、压缩包、文档或其他恶意软件载荷的证据。</p><p>\n\tMicrosoft 表示，这些因素表明该活动的目的是凭据钓鱼。然而，在所提供的证据中，并未直接观察到凭据提交及随后的账户失陷。</p><p>\n\tMicrosoft 尚未将该活动归因于任何特定威胁行为者或恶意软件家族。</p><h2 id=\"sec-3\">\n\t<strong>敦促安全团队调查此次攻击</strong></h2><p>\n\tMicrosoft 博客敦促防御人员搜索邮件遥测数据，查找已观察到的发件人域名、显示名称和主题模式、诱饵短语、跟踪主机以及目标域名。</p><p>\n\t任何匹配的消息都应进行隔离，并按照组织的响应流程删除已送达的消息。</p><p>\n\t随后，安全团队应审查点击遥测数据、代理日志以及浏览器或终端证据，以确定是否有用户点击了恶意链接，以及是否可能输入了凭据。</p><p>\n\t对于任何可能输入了凭据的用户，都应执行密码重置、撤销活动会话并刷新令牌。</p><p>\n\t此外，在调查该活动期间，组织应屏蔽或密切审查 reallifeaccounting[.]com 以及已观察到的 /themelist0.html 路径。</p>","original","zhKind","translation","complete","钓鱼","凭据","Microsoft","邮件安全","https://www.infosecurity-magazine.com/news/microsoft-phishing-service-outage/","Infosecurity Magazine",{"_109":110,"_111":-5},"changelogVersion","2026-10-01T08:00","release"]
