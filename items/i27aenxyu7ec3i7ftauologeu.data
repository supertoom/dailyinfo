[{"_1":2,"_3":4},"root",{"_5":106},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795394433000,"id","i27aenxyu7ec3i7ftauologeu","title","攻击者利用 GL.iNet GoodCloud 漏洞感染路由器与 KVM 设备","originalTitle","Hackers exploit GL.iNet cloud flaw to infect routers, KVM devices","summary","攻击者已利用 GL.iNet GoodCloud 云远程管理服务漏洞，在客户路由器和 KVM 设备中安装恶意软件；部分设备出现 root 级反向 Shell，攻击基础设施包括 66.245.219[.]252 和 65.20.71[.]131。","reason","原文结合厂商通告、恶意样本和设备实测还原攻击链，并给出固件版本、IOC 与处置建议，便于读者排查已感染设备。","source",{"_74":105},"links",{"_97":104},"publishedAt","2026-11-22T18:45:37.000Z","discoveredAt","2026-11-22T18:50:16.542Z","timelineAt","category","activity","tags",[77,79,75,101,102,103],"score",78,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Lawrence Abrams","body",{"_61":96,"_97":-5,"_98":99,"_100":37},"outline",[86,87],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fbBb15UnXN2k","reportCount",1,"additionalSourceCount",0,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","malware","name","恶意软件","attack","攻击活动","exploited","在野利用","iot","IoT 与车联网",{"_83":84,"_13":85},"publicId","ba176f09-c52f-4604-abe1-b6be5555c35e","GL.iNet云管理漏洞被利用，路由器与KVM设备被植入恶意软件",{"_11":93,"_89":94,"_91":95},{"_11":88,"_89":90,"_91":92},"sec-2","text","发现现有防御可能遗漏的邮件威胁。","level",2,"sec-1","发现恶意软件和反向 Shell",3,"<p><img alt=\"Router and KVM attack\" height=\"900\" src=\"/dailyinfo/media/0ce7ceee537c8374.jpg\" srcset=\"/dailyinfo/media/7e6a9e199cb38586.jpg 720w, /dailyinfo/media/2f1e9b5d8e7e5846.jpg 1200w, /dailyinfo/media/0ce7ceee537c8374.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>GL.iNet 已确认，黑客利用其云端远程管理服务中的漏洞，在客户路由器和 KVM 设备上安装了自定义恶意软件；一些受影响用户报告称，后门和反向 shell 使攻击者能够远程访问受感染设备。</p><p>GL.iNet 制造网络设备，包括家庭和旅行路由器，以及允许用户远程访问和控制计算机的 KVM 设备。</p><p>其 GoodCloud 平台允许客户远程管理受支持的设备，包括访问和控制连接到其 KVM 产品的计算机和服务器。</p><p><a href=\"https://www.wiz.io/lp/claude-code-security-best-practices-cheat-sheet?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q3_INB_FORM_Claude-Code-Security-Best-Practices&amp;sfcid=701Vh00000gJQZuIAO&amp;utm_term=FY27Q4-bleepingcomputer-article-970x250-Nov&amp;utm_content=Claude-Code-Best-Practices\"><img src=\"/dailyinfo/media/79026fbae1901a5d.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>在 11 月 20 日发布的安全公告中，GL.iNet 确认某个未经授权的团伙利用其云端远程管理服务中的漏洞访问设备并安装恶意软件。</p><p><a href=\"http://www.gl-inet.com/en-us/blogs/blog/glinet-security-notice-2026-11-20\">该公司表示</a>：“攻击路径已被阻断。我们修复了云端漏洞，并封锁了此次事件中使用的访问方式。”</p><p>“设备无法再通过这条攻击路径被新感染。这些措施不会清除此前已感染设备中的恶意软件。”</p><p>GL.iNet 尚未披露攻击者如何利用其云平台、有多少客户受到影响，或受入侵设备中的信息是否被窃取。</p><p>该公司还在调查连接到受感染 KVM 设备的计算机是否也遭到入侵。</p><p>GL.iNet 建议客户检查设备是否存在感染迹象，并安装最新安全固件，即使未检测到恶意软件也应如此操作。</p><p>该公司的初步说明要求客户查找以 <code>crond -i /tmp/.log</code> 身份运行的进程，GL.iNet 称这是系统遭入侵的指标。</p><p>尽管云端漏洞已修复，GL.iNet 表示，包含路由器和 KVM 设备额外安全修复的稳定版固件更新计划于 2026 年 11 月 22 日发布。</p><p>对于 KVM 设备，客户可以遵循该公司的<a href=\"https://forum.gl-inet.com/t/quickly-check-if-your-kvm-is-under-attack/73069\">固件升级指南</a>；该指南建议 RM10、RM1、RM1V2、RM1PE 和 RM4PE 使用 1.10.3 或更高版本，RM10RC 使用 1.10.3 beta 或更高版本，RMQ1 使用 1.8.7 或更高版本。</p><p>路由器所有者在特定型号的最新安全固件可用后，应尽快进行安装。</p><p>不过，GL.iNet 论坛成员警告称，该公司的检测说明可能无法识别所有受入侵设备，包括感染了其他后门或运行反向 shell 的设备。</p><p>作为针对路由器和 KVM 设备的官方支持说明的一部分，GL.iNet 链接提供了一个<a href=\"https://gl-i.net/security/csa-2026-01/fix/\">由社区开发的检测和清理工具</a>。</p><p>该扫描器会额外检查已知恶意软件文件、可疑进程、被修改的系统实用工具，以及为实现持久化而被修改的配置文件。它还可以收集取证证据，并选择性移除已知恶意软件组件。</p><p>该项目开发者警告称，该扫描器无法检测所有感染；受入侵设备可能需要在不保留现有设置的情况下重新安装固件，因为存储在配置目录中的恶意文件可能在普通固件升级后仍然存在。</p><p>怀疑设备已遭入侵的客户应在重置设备前保存证据，避免恢复可能已受感染的配置，并轮换可能已暴露的凭据和访问密钥。</p><p>GL.iNet 还要求运行扫描器的客户在出现提示时上传匿名报告，以便开发者确定受影响设备的数量和类型。</p><p>对于 KVM 用户，该恶意软件可能允许访问由 KVM 控制的计算机，因此也应分析这些设备是否存在被入侵的可能。</p><h3 id=\"sec-1\">发现恶意软件和反向 Shell</h3><p>披露后，GL.iNet 客户和安全研究人员分享了专门针对 GL.iNET 设备定制的恶意软件感染证据，以及将受感染路由器连接到 IP 地址 <code>170.39.226[.]219</code> 的 root 级反向 Shell。</p><p>这些反向 Shell 使用 Linux nc 工具创建出站连接，使远程攻击者能够在受感染设备上执行命令。</p><p><a href=\"https://github.com/RemoteToHome-io/gl-security-incident-2026\">RemoteToHome Consulting</a> 的研究人员还发现，GL.iNet 的 GoodCloud 客户端存在一个潜在命令注入漏洞，该漏洞涉及用于 AstroWarp/SD-WAN 功能的处理程序。</p><p>据研究人员称，该处理程序会将云端提供的值传递给以 root 权限执行的 shell 命令，但未对其进行适当验证。</p><p>然而，GL.iNet 尚未确认此特定漏洞曾用于这些攻击。</p><p>RemoteToHome 表示，其分析了自有或管理的 183 台路由器，发现其中 152 台存在可疑活动，包括 24 台带有 root 级反向 Shell、47 台带有较旧的持久化后门，以及 81 台有证据表明攻击者提供的命令已被执行。</p><p>研究人员指出，其发现可能与其他 GL.iNet 客户的情况不同，而且较旧后门感染可能与 11 月的攻击无关。</p><p>在另一份<a href=\"https://forum.gl-inet.com/t/2026-11-20-gl-inet-security-notice-goodcloud-kvm-routers/73056/79\">论坛报告</a>中，一名遭入侵的 GL-RM1 KVM 所有者分享了网络日志，显示该设备于 11 月 19 日从 <code>66.245.219[.]252</code> 下载了恶意 ni.sh 脚本和额外的可执行载荷。</p><p>该所有者还报告称，设备开始每天与大约 1,800 个住宅 IP 地址通信，并反复联系 TRON 区块链 API，表现出类似点对点网络的活动。</p><p>然而，这些连接的用途尚不清楚，也没有证据确认受入侵设备被用作住宅代理或属于更大规模僵尸网络的一部分。</p><p>BleepingComputer 检查了恶意 <code>ni.sh</code> 脚本的副本 [<a href=\"https://www.virustotal.com/gui/file/36e04e10b4667e59b0a3a25147b032dc038c5a9971a7df88be80f8882e30dd87\">VirusTotal</a>]，发现其中包含专为 GL.iNet 路由器和 KVM 设备量身定制的代码。</p><p>该脚本可识别众多 GL.iNet 设备型号，并从硬编码服务器下载名为 gl-helper 和 gb 的恶意可执行文件。</p><p>它还通过启动脚本和计划任务建立持久化，使恶意软件能够在重启后或其进程被终止后重新启动。</p><p>安装程序包含将恶意进程伪装成 <code>crond -i /tmp/.log</code> 的功能，与 GL.iNet 发布的 IOC 相匹配。</p><p>一个值得关注的功能是使用经过修改的 shell 脚本替换合法的 netstat 工具，该脚本会过滤掉与 <code>66.245.219[.]252</code> 的连接，从而可能向检查网络连接的管理员隐藏恶意软件的通信。</p><p>安装程序还包含安装 SSH 公钥以进行远程访问、修改文件时间戳以及定期联系远程服务器以获取并执行命令的功能。</p><p>攻击者的基础设施包含两个 IP 地址 <code>66.245.219[.]252</code> 和 <code>65.20.71[.]131</code>，与遭入侵 KVM 所有者日志中看到的 IP 地址相符。</p><p>该脚本还包含中文开发者注释，描述其持久化机制、报告功能以及与 GL.iNet 云管理软件之间的交互，表明编写者可能是中文使用者。</p><figure><img alt=\"Chinese-language comments in the ni.sh malware script\" height=\"500\" src=\"/dailyinfo/media/8e5dbf11439138b1.jpg\" srcset=\"/dailyinfo/media/ca401b1c143a85a3.jpg 720w, /dailyinfo/media/4be8c82890f96e51.jpg 1200w, /dailyinfo/media/8e5dbf11439138b1.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"868\">\n<figcaption><strong>ni.sh 恶意软件脚本中的中文注释</strong><br>\n<em>来源：&nbsp;BleepingComputer</em></figcaption>\n</figure><p>BleepingComputer 还检查了一个从 GL-MT2500 路由器中恢复的独立恶意 Lua 有效载荷。</p><p>该有效载荷通过修改后的 <code>urandom_seed</code>&nbsp;启动脚本启动，包含收集设备信息、联系远程服务器以及下载和执行其他程序的功能。</p><figure><img src=\"/dailyinfo/media/ad985332bac14719.jpg\" srcset=\"/dailyinfo/media/6657171b103b6658.jpg 720w, /dailyinfo/media/5c487cfd26d335dc.jpg 1200w, /dailyinfo/media/ad985332bac14719.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Malicious commands added to legitimate urandom_seed file\" height=\"500\" width=\"768\">\n<figcaption><strong>添加到合法 urandom_seed 文件中的恶意命令</strong><br>\n<em>来源：BleepingComputer</em></figcaption>\n</figure><p>从 GL.iNet 设备中恢复的部分恶意文件带有可追溯至 2025 年 12 月的时间戳，表明部分设备可能已被入侵数月。然而，目前尚不清楚这些感染是否涉及相同的威胁行为体，或是否与 11 月 20 日的攻击有关。</p><p>GL.iNet 表示将继续调查该事件，并计划使用与受影响客户云账户关联的电子邮件地址通知已确认受影响的客户。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/06fc6e977fae1ca4.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-2\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 代理会分析邮件意图、上下文和行为，以发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>对 Microsoft 365 或 Google Workspace 进行为期 14 天的只读扫描，查看有哪些威胁正在穿透，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始免费邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","后门","网络设备","IoT","https://www.bleepingcomputer.com/news/security/hackers-exploit-glinet-cloud-flaw-to-infect-routers-kvm-devices/","BleepingComputer",{"_107":108,"_109":-5},"changelogVersion","2026-10-01T08:00","release"]
