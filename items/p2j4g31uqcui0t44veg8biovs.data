[{"_1":2,"_3":4},"root",{"_5":88},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1794444097000,"id","p2j4g31uqcui0t44veg8biovs","title","Microsoft 2026 年 11 月安全更新汇总：1094 个 CVE 补丁及 4 项高风险漏洞","originalTitle","微软补丁日安全通告|11月份","summary","Microsoft 于 2026 年 11 月发布 1094 个 CVE 的补丁，较上月减少 322 个，仍处于近一年较高水平。","reason","source",{"_67":87},"links",{"_79":86},"publishedAt","2026-11-11T09:27:00.000Z","discoveredAt","2026-11-11T17:14:10.257Z","timelineAt","category","vuln","tags",[82,70,83,84,75,85],"score",77,"selected",false,"channel","news","story","x","readingMode","full","author","body",{"_58":78,"_79":-5,"_80":79,"_81":54},"outline",[],"relatedStories",[],"topics",[59,60,61,62,63,64],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","zh",{"_65":76,"_67":77},{"_65":74,"_67":75},{"_65":72,"_67":73},{"_65":30,"_67":71},{"_65":69,"_67":70},{"_65":66,"_67":68},"slug","research","name","技术研究","exploited","在野利用","漏洞披露","email","邮件与钓鱼","identity","身份与访问","microsoft","Microsoft / 微软","<p><span>深瞳漏洞实验室</span> <span>2026-11-11 17:27</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/89a8473fc3e134a2.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><img src=\"/dailyinfo/media/f17327c5ece2ad63.gif\" loading=\"lazy\" decoding=\"async\"></p><p><span>2026年11月11日（北京时间），微软发布了2026年11月安全更新，共发布了1094个CVE的补丁程序，比上月减少了322个。</span></p><p><strong><span>漏洞数据分析</span></strong></p><p><img src=\"/dailyinfo/media/018a5022e0da2f84.gif\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>漏洞概要</span></strong></p><p><img src=\"/dailyinfo/media/361960302d412c3b.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span>图 近一年微软补丁漏洞修复情况</span></p><ul><li><p><span>从近一年的修复趋势来看，本月补丁数量较上月小幅回落，仍处于近一年较高水平。</span></p></li></ul><ul><li><p><span>本次更新包含多个危害较大的高危漏洞，涉及远程代码执行、权限提升等场景，部分漏洞可被远程未授权利用。相关漏洞危害较大，建议用户尽快评估受影响资产并及时更新安全补丁。</span></p></li></ul><p><span>以下为本次更新中风险较高的漏洞，建议优先完成修复：</span></p><table><tbody><tr><td><p><b><span><span>CVE</span><span>编号</span></span></b></p></td><td><p><b><span><span>漏洞名称</span></span></b></p></td><td><p><b><span><span>风险等级</span></span></b></p></td><td><p><b><span><span>CVSS</span><span>评分</span></span></b></p></td><td><p><b><span><span>公开披露</span></span></b></p></td><td><p><b><span><span>在野利用</span></span></b></p></td></tr><tr><td><p><span><span>CVE-2026-124194</span></span></p></td><td><p><span><span>Microsoft Outlook</span><span>欺骗漏洞</span></span></p></td><td><p><span><span>中危</span></span></p></td><td><p><span><span>6.5</span></span></p></td><td><p><span><span>否</span></span></p></td><td><p><span><span>是</span></span></p></td></tr><tr><td><p><span><span>CVE-2026-116928</span></span></p></td><td><p><span><span>Windows</span></span><span><span>Search</span></span><span><span>远程代码执行漏洞</span></span></p></td><td><p><span><span>紧急</span></span></p></td><td><p><span><span>9.8</span></span></p></td><td><p><span><span>否</span></span></p></td><td><p><span><span>否</span></span></p></td></tr><tr><td><p><span><span>CVE-2026-119952</span></span></p></td><td><p><span><span>Windows Schannel</span><span>远程代码执行漏洞</span></span></p></td><td><p><span><span>紧急</span></span></p></td><td><p><span><span>8.1</span></span></p></td><td><p><span><span>否</span></span></p></td><td><p><span><span>否</span></span></p></td></tr><tr><td><p><span><span>CVE-2026-118148</span></span></p></td><td><p><span><span>Active Directory</span><span>域服务特权提升漏洞</span></span></p></td><td><p><span><span>紧急</span></span></p></td><td><p><span><span>7.5</span></span></p></td><td><p><span><span>否</span></span></p></td><td><p><span><span>否</span></span></p></td></tr></tbody></table><p><strong><span>重要漏洞分析</span></strong></p><p><img src=\"/dailyinfo/media/76fecec28ec105ab.gif\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>漏洞分析</span></strong></p><p><strong><span><span>Microsoft Outlook欺骗漏洞 CVE-2026-124194</span></span></strong></p><p><span>Microsoft Office Outlook 是微软办公套件中的邮件与日程管理客户端，负责邮件收发和日历管理，是办公通信的关键组件。</span></p><p><span>其中存在欺骗漏洞，未认证攻击者发送特制消息文件诱使用户以受影响 Outlook 打开，可能使其连接攻击者控制的网络位置并实施欺骗；该漏洞已发现在野利用，经过评估，该漏洞危害较大，建议用户及时更新微软安全补丁。</span></p><p><strong><span><span>Windows Search远程代码执行漏洞 CVE-2026-116928</span></span></strong></p><p><span>Microsoft Windows Search Component 是 Windows 的搜索索引组件，被 Exchange Server 用于自动索引邮件附件，对邮件检索与 Exchange 运行至关重要。</span></p><p><span>其中存在远程代码执行漏洞，未经认证攻击者可通过网络发送含特制附件的邮件，经 Exchange 自动索引触发越界写，可导致代码执行。经过评估，该漏洞危害较大，建议用户及时更新微软安全补丁。</span></p><p><strong><span><span>Windows Schannel远程代码执行漏洞 CVE-2026-119952</span></span></strong></p><p><span>Windows Schannel 是 Windows 的 TLS/SSL 网络安全组件，负责保障网络通信安全，是关键基础组件。</span></p><p><span>其中存在远程代码执行漏洞，未经身份验证的远程攻击者可发送特制数据包触发，成功利用可在目标系统执行代码，经过评估，该漏洞危害较大，建议用户及时更新微软安全补丁。</span></p><p><strong><span><span>Active Directory域服务特权提升漏洞 CVE-2026-118148</span></span></strong></p><p><span>Microsoft Active Directory Domain Services（AD DS）是 Windows Server 的核心目录服务，负责域内认证、授权与目录管理，是企业身份安全的关键基础。</span></p><p><span>其中存在权限提升漏洞，具备已授权身份的攻击者可通过网络并借助竞态条件利用身份认证不当问题，成功后将权限提升至 SYSTEM。经过评估，该漏洞危害较大，建议用户及时更新微软安全补丁。</span></p><p><img src=\"/dailyinfo/media/b686111fb76128b7.gif\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span><span>影响范围</span></span></strong></p><table><tbody><tr><td><p><b><span><span><span>漏洞名称、</span></span><span><span>CVE</span></span><span><span>编号</span></span></span></b></p></td><td><p><b><span><span><span>受影响版本</span></span></span></b></p></td></tr><tr><td><p><span><span>Microsoft Outlook</span><span>欺骗漏洞&nbsp;</span><span>CVE-2026-124194</span></span></p></td><td><p><span><span>Microsoft 365 Apps for Enterprise for 32-bit Systems</span></span><span><span><br></span></span><span><span>Microsoft 365 Apps for Enterprise for 64-bit Systems</span></span><span><span><br></span></span><span><span>Microsoft Office LTSC 2024 for 32-bit editions</span></span><span><span><br></span></span><span><span>Microsoft Office LTSC 2024 for 64-bit editions</span></span><span><span><br></span></span><span><span>Microsoft Office LTSC 2021 for 32-bit editions</span></span><span><span><br></span></span><span><span>Microsoft Office LTSC 2021 for 64-bit editions</span></span></p></td></tr><tr><td><p><span><span>Windows</span></span><span><span>Search</span></span><span><span>远程代码执行漏洞</span><span>&nbsp;CVE-2026-116928</span></span></p></td><td><p><span><span>Windows Server 2016 (Server Core installation)</span></span><span><span><br></span></span><span><span>Windows Server 2016</span></span><span><span><br></span></span><span><span>Windows 10 Version 1607 for 32-bit Systems</span></span><span><span><br></span></span><span><span>Windows 11 Version 26H1 for ARM64-based Systems</span></span><span><span><br></span></span><span><span>Windows 10 Version 1607 for x64-based Systems</span></span><span><span><br></span></span><span><span>Windows 11 version 26H1 for x64-based Systems</span></span><span><span><br></span></span><span><span>Windows Server 2025</span></span><span><span><br></span></span><span><span>Windows 11 Version 24H2 for x64-based Systems</span></span><span><span><br></span></span><span><span>Windows 11 Version 24H2 for ARM64-based Systems</span></span><span><span><br></span></span><span><span>Windows 11 Version 23H2 for x64-based Systems</span></span><span><span><br></span></span><span><span>Windows 11 Version 25H2 for x64-based Systems</span></span><span><span><br></span></span><span><span>Windows 11 Version 23H2 for ARM64-based Systems</span></span><span><span><br></span></span><span><span>Windows 11 Version 25H2 for ARM64-based Systems</span></span><span><span><br></span></span><span><span>Windows Server 2025 (Server Core installation)</span></span><span><span><br></span></span><span><span>Windows 10 Version 22H2 for 32-bit Systems</span></span><span><span><br></span></span><span><span>Windows 10 Version 22H2 for x64-based Systems</span></span><span><span><br></span></span><span><span>Windows 10 Version 22H2 for ARM64-based Systems</span></span><span><span><br></span></span><span><span>Windows 10 Version 21H2 for x64-based Systems</span></span><span><span><br></span></span><span><span>Windows 10 Version 21H2 for 32-bit Systems</span></span><span><span><br></span></span><span><span>Windows 10 Version 21H2 for ARM64-based Systems</span></span><span><span><br></span></span><span><span>Windows Server 2022 (Server Core installation)</span></span><span><span><br></span></span><span><span>Windows Server 2022</span></span><span><span><br></span></span><span><span>Windows Server 2019</span></span><span><span><br></span></span><span><span>Windows Server 2019 (Server Core installation)</span></span><span><span><br></span></span><span><span>Windows 10 Version 1809 for x64-based Systems</span></span><span><span><br></span></span><span><span>Windows 10 Version 1809 for 32-bit Systems</span></span><span><span><br></span></span><span><span>Windows 11 Version 26H2 for x64-based Systems</span></span><span><span><br></span></span><span><span>Windows 11 Version 26H2 for ARM64-based Systems</span></span></p></td></tr><tr><td><p><span><span>Windows Schannel</span><span>远程代码执行漏洞&nbsp;</span><span>CVE-2026-119952</span></span></p></td><td><p><span><span>Windows Server 2022 (Server Core installation)</span></span><span><span><br></span></span><span><span>Windows 10 Version 21H2 for x64-based Systems</span></span><span><span><br></span></span><span><span>Windows 10 Version 1809 for 32-bit Systems</span></span><span><span><br></span></span><span><span>Windows 11 Version 24H2 for ARM64-based Systems</span></span><span><span><br></span></span><span><span>Windows Server 2019 (Server Core installation)</span></span><span><span><br></span></span><span><span>Windows 11 Version 25H2 for ARM64-based Systems</span></span><span><span><br></span></span><span><span>Windows Server 2019</span></span><span><span><br></span></span><span><span>Windows 11 version 26H1 for x64-based Systems</span></span><span><span><br></span></span><span><span>Windows Server 2025 (Server Core installation)</span></span><span><span><br></span></span><span><span>Windows 11 Version 26H1 for ARM64-based Systems</span></span><span><span><br></span></span><span><span>Windows 11 Version 26H2 for x64-based Systems</span></span><span><span><br></span></span><span><span>Windows Server 2025</span></span><span><span><br></span></span><span><span>Windows 11 Version 26H2 for ARM64-based Systems</span></span><span><span><br></span></span><span><span>Windows 11 Version 25H2 for x64-based Systems</span></span><span><span><br></span></span><span><span>Windows 11 Version 24H2 for x64-based Systems</span></span><span><span><br></span></span><span><span>Windows 11 Version 23H2 for x64-based Systems</span></span><span><span><br></span></span><span><span>Windows 11 Version 23H2 for ARM64-based Systems</span></span><span><span><br></span></span><span><span>Windows Server 2022</span></span><span><span><br></span></span><span><span>Windows 10 Version 22H2 for ARM64-based Systems</span></span><span><span><br></span></span><span><span>Windows 10 Version 22H2 for x64-based Systems</span></span><span><span><br></span></span><span><span>Windows 10 Version 22H2 for 32-bit Systems</span></span><span><span><br></span></span><span><span>Windows 10 Version 21H2 for ARM64-based Systems</span></span><span><span><br></span></span><span><span>Windows 10 Version 21H2 for 32-bit Systems</span></span><span><span><br></span></span><span><span>Windows 10 Version 1809 for x64-based Systems</span></span><span><span><br></span></span><span><span>Windows Server 2016 (Server Core installation)</span></span><span><span><br></span></span><span><span>Windows 10 Version 1607 for x64-based Systems</span></span><span><span><br></span></span><span><span>Windows Server 2016</span></span><span><span><br></span></span><span><span>Windows 10 Version 1607 for 32-bit Systems</span></span></p></td></tr><tr><td><p><span><span>Active Directory</span><span>域服务特权提升漏洞&nbsp;</span><span>CVE-2026-118148</span></span></p></td><td><p><span><span>Windows Server 2022</span></span><span><span><br></span></span><span><span>Windows Server 2025 (Server Core installation)</span></span><span><span><br></span></span><span><span>Windows 10 Version 1809 for x64-based Systems</span></span><span><span><br></span></span><span><span>Windows 11 version 26H1 for x64-based Systems</span></span><span><span><br></span></span><span><span>Windows 11 Version 26H2 for x64-based Systems</span></span><span><span><br></span></span><span><span>Windows Server 2025</span></span><span><span><br></span></span><span><span>Windows 11 Version 26H1 for ARM64-based Systems</span></span><span><span><br></span></span><span><span>Windows 11 Version 26H2 for ARM64-based Systems</span></span><span><span><br></span></span><span><span>Windows 11 Version 25H2 for x64-based Systems</span></span><span><span><br></span></span><span><span>Windows 11 Version 25H2 for ARM64-based Systems</span></span><span><span><br></span></span><span><span>Windows 11 Version 24H2 for x64-based Systems</span></span><span><span><br></span></span><span><span>Windows 11 Version 24H2 for ARM64-based Systems</span></span><span><span><br></span></span><span><span>Windows 11 Version 23H2 for ARM64-based Systems</span></span><span><span><br></span></span><span><span>Windows 11 Version 23H2 for x64-based Systems</span></span><span><span><br></span></span><span><span>Windows Server 2022 (Server Core installation)</span></span><span><span><br></span></span><span><span>Windows 10 Version 22H2 for x64-based Systems</span></span><span><span><br></span></span><span><span>Windows 10 Version 22H2 for ARM64-based Systems</span></span><span><span><br></span></span><span><span>Windows 10 Version 22H2 for 32-bit Systems</span></span><span><span><br></span></span><span><span>Windows 10 Version 21H2 for x64-based Systems</span></span><span><span><br></span></span><span><span>Windows 10 Version 21H2 for 32-bit Systems</span></span><span><span><br></span></span><span><span>Windows Server 2016 (Server Core installation)</span></span><span><span><br></span></span><span><span>Windows 10 Version 21H2 for ARM64-based Systems</span></span><span><span><br></span></span><span><span>Windows Server 2019</span></span><span><span><br></span></span><span><span>Windows 10 Version 1809 for 32-bit Systems</span></span><span><span><br></span></span><span><span>Windows Server 2019 (Server Core installation)</span></span><span><span><br></span></span><span><span>Windows Server 2016</span></span><span><span><br></span></span><span><span>Windows 10 Version 1607 for x64-based Systems</span></span><span><span><br></span></span><span><span>Windows 10 Version 1607 for 32-bit Systems</span></span></p></td></tr></tbody></table><p><strong><span>解决方案</span></strong></p><p><img src=\"/dailyinfo/media/2ca27fb2ab1bea46.gif\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>官方修复建议</span></strong></p><p><span>微软官方已更新受影响软件的安全补丁，用户可根据不同系统版本下载安装对应的安全补丁，安全更新链接如下：</span></p><p><span>1、<a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-124194\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-124194</a></span></p><p><span>2、<a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-116928\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-116928</a></span></p><p><span>3、<a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-119952\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-119952</a></span></p><p><span>4、<a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-118148\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-118148</a></span></p><p><img src=\"/dailyinfo/media/2f869a5bc55ec4e2.gif\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>深信服解决方案</span></strong></p><p><span>支持对CVE-2026-116928、CVE-2026-119952、CVE-2026-118148的主动检测，</span><strong><span><span>可批量快速检出业务场景中是否存在漏洞风险</span></span></strong><span>。</span></p><p><strong><span><span>【AES】</span></span></strong><span>预计2026年11月20日发布检测方案。</span></p><p><strong><span>参考链接</span></strong></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/releaseNote/2026-Nov\">https://msrc.microsoft.com/update-guide/releaseNote/2026-Nov</a></span></p><p><b><span>时间轴</span></b></p><p><strong><strong><span>2026/11/11</span></strong></strong></p><p><span>微软例行补丁日，微软官网发布漏洞安全公告。</span></p><p><strong><span>2026/11/11</span></strong></p><p><span>深信服千里目安全技术中心发布安全通告。</span></p><p><span>点击</span><strong><span><span>阅读原文</span></span></strong><span>，及时关注并登录深信服</span><strong><span>智安全平台</span></strong><span>，可轻松查询漏洞相关解决方案。</span></p><p><span><img src=\"/dailyinfo/media/c36a44a71a5315e7.webp\" loading=\"lazy\" decoding=\"async\"></span></p><p><img src=\"/dailyinfo/media/578a53ca86e2a82c.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><a href=\"https://sec.sangfor.com.cn/security-vulnerability/detail?vuln_sfv=SF_2026_46130%5cx26amp;lang=ZH-CN\">阅读原文</a></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=9d45e849&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzg2NjgzNjA5NQ%3D%3D%26mid%3D2247526434%26idx%3D1%26sn%3Df8fced3958116a287a0f00487eb5047b\">跳转微信打开</a></p>","original","zhKind","complete","补丁","漏洞分析","Microsoft","邮件安全","https://mp.weixin.qq.com/s?__biz=Mzg2NjgzNjA5NQ==&mid=2247526434&idx=1&sn=f8fced3958116a287a0f00487eb5047b","深信服千里目安全实验室",{"_89":90,"_91":-5},"changelogVersion","2026-10-01T08:00","release"]
