[{"_1":2,"_3":4},"root",{"_5":91},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795740043000,"id","phoouvsged0ufiamfxx0ozhx8","title","澳大利亚 Flight Centre 第三方预订系统遭入侵，客户记录与护照信息泄露","originalTitle","Australia’s Flight Centre Data Breach Exposes Customer Records and Passport Details","summary","澳大利亚 Flight Centre Travel Group 正调查第三方住宿预订系统遭入侵事件，Flight Centre、Travel Associates、Cruiseabout 及部分独立代理商使用该系统，航班预订和商务旅行预订未受影响。","reason","source",{"_71":90},"links",{"_61":89},"publishedAt","2026-11-26T11:51:11.000Z","discoveredAt","2026-11-26T12:42:30.792Z","timelineAt","category","activity","tags",[87,88],"score",64,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","Pierluigi Paganini","body",{"_83":-5,"_61":84,"_85":-5,"_86":36},"outline",[77],"relatedStories",[73],"topics",[68],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fPiA4j68WvfY","reportCount",1,"additionalSourceCount",0,{"_69":70,"_71":72},"slug","email","name","邮件与钓鱼",{"_74":75,"_13":76},"publicId","791644de-8574-475b-8c98-3ccedb5df136","Flight Centre披露第三方系统遭入侵",{"_11":78,"_79":80,"_81":82},"sec-1","text","Australia’s Flight Centre is investigating a third-party breach that exposed cus","level",2,"zh","<h2 id=\"sec-1\">Australia’s Flight Centre is investigating a third-party breach that exposed customer travel records and limited passport details.</h2><p>Australia’s Flight Centre Travel Group is investigating a cyber incident involving a third-party accommodation booking system that may have exposed a significant number of customer records. The company disclosed the incident on November 26, saying it had detected unusual activity in a platform used by several of its leisure travel brands.</p><p>The breach affects the accommodation system used by Flight Centre, Travel Associates, Cruiseabout and some independent agents. Flight bookings and corporate travel bookings, which rely on separate systems, haven’t been affected.</p><p>According to Reuters, the company has not yet determined how many records were taken. Its initial investigation found that most of the accessed records contained customer names, while some also included basic travel details.</p><p><em>“Flight ⁠Centre said some of its leisure travel brands — the Flight ​Centre brand, Travel Associates and Cruiseabout — and some independent agents ​used the third-party accommodation booking system. The company said the unusual activity did not affect flight bookings.” <a href=\"https://www.reuters.com/world/asia-pacific/australias-flight-centre-travel-says-customer-records-may-have-been-accessed-2026-11-25/\">Reuters states</a>. “The company said it had not yet ​determined how many records the activity extracted, but its initial ​review showed most accessed records contained only customer names, while some also ‌included ⁠basic travel information”</em></p><p>The exposed data may include more sensitive information. Flight Centre believes a very small number of records contained passport details, email addresses, phone numbers and dates of birth. In rare cases, records may also have included health or mobility information, which can be particularly sensitive when linked to travel plans.</p><p>So far, the company has found no evidence that credit card, payment or bank account details were accessed. However, the exposed personal and travel information could still be used for targeted scams, identity theft and social engineering attacks.</p><p>The incident highlights a common problem with third-party suppliers. A booking platform may store customer information collected by several brands and independent travel agents. This means that a single attack on a shared system could expose data belonging to several businesses at once.</p><p>Flight Centre has activated its incident response plan and is investigating the incident with the supplier and cybersecurity firm Mandiant. The company says it is working to identify affected systems, contain the incident, improve security, change authentication keys and passwords, and increase monitoring. It is also notifying the relevant authorities and working with external security experts.</p><p>The investigation is still ongoing, and the company has not confirmed how many customers were affected or when the suspicious activity started. Flight Centre says existing hotel bookings can go ahead as planned and that it will contact customers whose data may have been exposed.</p><p>For customers, the main concern is how attackers could use the stolen information. An email mentioning a real hotel, booking reference or travel date can look genuine, especially when it arrives shortly before a trip.</p><p>Flight Centre has advised customers to be careful with unexpected emails, phone calls or messages about their bookings. They should avoid clicking links, opening attachments or sharing personal information, passwords or payment details in response to unsolicited requests.</p><p>The warning is worth taking seriously even if no payment data was exposed. Travel details provide context that criminals can use to make phishing attempts more credible, and a request to “confirm” a booking or passport detail may be the next step in an attack.</p><p>Flight Centre said it would contact affected customers and apologised for the concern the incident may cause. </p><p><em>“Flight Centre is warning customers to be cautious of “unexpected emails, calls or messages” about their bookings, and to “not click on links, open attachments or share personal information, passwords or payment details in response”. <a href=\"https://www.abc.net.au/news/2026-11-26/flight-centre-investigating-cyber-breach-passports-details/107432534\">ABC News states</a>.</em></p><p><em>“The company apologised to affected customers, noting “that an incident like this can be unsettling”.”</em></p><p><strong>Follow me on Twitter:&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a><strong></strong></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;hacking,&nbsp;Flight Centre)</strong></p>","zhKind","complete","数据泄露","钓鱼","https://securityaffairs.com/204049/data-breach/australias-flight-centre-data-breach-exposes-customer-records-and-passport-details.html","Security Affairs",{"_92":93,"_94":-5},"changelogVersion","2026-10-01T08:00","release"]
