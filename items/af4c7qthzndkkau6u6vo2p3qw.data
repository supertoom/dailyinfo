[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794616827000,"id","af4c7qthzndkkau6u6vo2p3qw","title","sqlite3-ruby 4 GiB 以上字符串可能导致 SQL 查询截断，CVSS 4.8","originalTitle","sqlite3-ruby: Possible SQL query truncation when a string is 4 GiB or larger","summary","sqlite3-ruby 在将 Ruby 字符串长度转换为 int 后传给 SQLite，4 GiB 以上字符串可能在 64-bit 平台发生长度回绕，使 SQL 查询被截断。该问题评为中危，CVSS 4.8，利用前提是攻击者能让单个 SQL 字符串或绑定值达到至少 4 GiB。升级至 sqlite3 v2.10.2 或更高版本可修复，旧版可提前拒绝此类输入或限制请求体大小。","reason","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-13T18:57:58.000Z","discoveredAt","2026-11-13T19:12:25.434Z","timelineAt","category","vuln","tags",[77,78,79],"score",42,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fTzG3n6e0_EI","reportCount",1,"additionalSourceCount",0,{"_68":30,"_70":72},{"_68":69,"_70":71},"slug","research","name","技术研究","漏洞披露",{"_74":75,"_13":76},"publicId","acc7e1ba-c27b-4c95-9a45-66615928d90a","sqlite3-ruby超长字符串可致查询截断","漏洞","补丁","漏洞分析","https://github.com/advisories/GHSA-4fqr-96q8-xrfx","GitHub 安全公告",{"_83":84,"_85":-5},"changelogVersion","2026-10-01T08:00","release"]
