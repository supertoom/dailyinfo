[{"_1":2,"_3":4},"root",{"_5":102},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1794185105000,"id","qv6w4olbee6k66fm5n9vwpx6v","title","WorkOS 内部销售应用遭 ARTEX AI 智能体越界入侵并泄露客户信息","originalTitle","Runaway AI hacking agent behind WorkOS breach after escaping sandbox","summary","WorkOS 确认，安全研究人员在评估 ARTEX 自主渗透测试框架时，AI 智能体越出隔离测试环境，意外入侵其内部销售应用并提取客户信息。公司与独立取证机构核对请求详情、时间戳等技术痕迹后认定该研究人员负责，且其称获取的数据已删除、未与他人分享。","reason","source",{"_73":101},"links",{"_61":100},"publishedAt","2026-11-06T22:27:25.000Z","discoveredAt","2026-11-07T03:37:28.838Z","timelineAt","category","ai-security","tags",[74,98,78,99,76,80],"score",68,"selected",false,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","Lawrence Abrams","body",{"_94":-5,"_61":95,"_96":-5,"_97":36},"outline",[85,86],"relatedStories",[81],"topics",[68,69,70,71],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fOz5l-JGhIjo","reportCount",1,"additionalSourceCount",0,{"_72":79,"_73":80},{"_72":77,"_73":78},{"_72":75,"_73":76},{"_72":30,"_73":74},"slug","name","AI 安全","exploited","在野利用","ai-offense","AI 攻防","crowdstrike","CrowdStrike",{"_82":83,"_13":84},"publicId","d88c44d4-7bd4-4a7e-9fc7-9ae46293bda1","WorkOS确认AI智能体越界入侵内部应用",{"_11":92,"_88":93,"_90":91},{"_11":87,"_88":89,"_90":91},"sec-2","text","Uncover email threats your existing defenses may miss.","level",2,"sec-1","AI agent exploited weak credentials","zh","<p><img alt=\"WorkOS\" height=\"900\" src=\"/dailyinfo/media/6a47e6d6cd26e4a8.jpg\" srcset=\"/dailyinfo/media/8b605b1386452050.jpg 720w, /dailyinfo/media/eff5d2abed6037fe.jpg 1200w, /dailyinfo/media/6a47e6d6cd26e4a8.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>WorkOS says an AI-powered hacking agent that breached its internal sales application and accessed customer information was operated by a security researcher who claims the tool escaped its testing environment and unintentionally attacked the company.</p><p>The developer platform <a href=\"https://www.bleepingcomputer.com/news/security/workos-says-attacker-used-artex-ai-to-breach-internal-sales-app/\">disclosed the breach</a> earlier this week, saying an attacker used the ARTEX AI offensive security framework to automate reconnaissance and exploitation attempts against its systems.</p><p>However, in a <a href=\"https://workos.com/security/bulletins/update-for-october-30th-2026-data-security-incident\">new security update</a> published Friday, WorkOS founder Michael Grinich revealed that the person responsible had come forward and claimed the incident was accidental.</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/92235cbd221a113a.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>\"Shortly after our original bulletin, a security researcher contacted us and claimed responsibility,\" Grinich said in a <a href=\"https://x.com/grinich/status/2118743983912624590\">post on X</a>.</p><p>\"They told us they were evaluating ARTEX, an autonomous penetration testing framework, when their agent escaped its isolated testing environment and interacted with WorkOS unintentionally.”</p><p>The researcher reportedly was conducting cybersecurity benchmark evaluations using ARTEX when the agent operated outside its intended environment and began interacting with WorkOS systems.</p><p>WorkOS says its security team and an independent forensic investigator matched request details, timestamps, and other technical artifacts provided by the researcher against the company's logs, confirming with high confidence that the individual was responsible for the unauthorized activity.</p><p>The researcher also confirmed that all WorkOS data obtained by the agent had been deleted and was not shared with anyone else.</p><p>While WorkOS has confirmed the researcher's responsibility for the intrusion, the company or researcher has not publicly provided details on how the agent escaped its testing environment.</p><h2 id=\"sec-1\">AI agent exploited weak credentials</h2><p>WorkOS says the investigation also identified four security weaknesses that allowed the autonomous agent to access its internal sales application and extract customer information.</p><p>The affected application ran on a legacy internal tools platform that lacked the security protections used on the company's newer systems.</p><p>According to WorkOS, permissive access controls left the application's API endpoints exposed to the internet, allowing the agent to discover and interact with them.</p><p>The API also accepted a predictable credential intended for local development that had mistakenly been left deployed in production. This allowed the agent to authenticate after discovering the exposed endpoint.</p><p>Once authenticated, the agent abused the lack of rate limiting to rapidly retrieve records from the exposed application.</p><p>WorkOS says the first confirmed unauthorized access occurred on October 25, but the activity remained undetected until October 30, after the agent had completed downloading customer records.</p><p>The company discovered the incident when an employee noticed unusually high usage of a system connected to the affected application.</p><p>The exposed information included business contact details, customer account histories, product usage information, and summaries or excerpts from sales calls, support discussions, and customer Slack conversations.</p><p>A limited number of support communications also contained end-user email addresses.</p><p>WorkOS says its investigation, validated by an independent forensic firm, determined that the incident was limited to data stored in its sales and customer support systems.</p><p>The company noted that it had also begun regularly testing its own internet-facing systems using ARTEX on November 3, the same AI penetration-testing framework involved in the incident.</p><p>ARTEX is an AI-powered offensive security framework previously linked to <a href=\"https://www.bleepingcomputer.com/news/security/hacker-used-artex-ai-and-claude-agents-to-target-south-korean-banks/\">cyberattacks against South Korean banks</a> and the <a href=\"https://www.bleepingcomputer.com/news/security/chinese-hackers-use-artex-ai-in-automated-attacks-against-200-orgs/\">Dutch Institute for Vulnerability Disclosure (DIVD)</a>.</p><p>More recently, CrowdStrike reported that the Chinese cyber-espionage group Vapor Panda used the framework in a campaign targeting approximately 200 organizations.</p><p>Although the researcher claims the WorkOS incident was unintentional, the breach is another demonstration of how AI is being used to conduct autonomous attacks, even when those attacks are unintentional.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/03f545515f18a71f.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-2\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Uncover email threats your existing defenses may miss.</a>\n        </h2><p>Adaptive Security's AI agents analyze email intent, context, and behavior to uncover phishing, business email compromise, and invoice fraud.</p><p>See what's getting through with a 14-day read-only scan of Microsoft 365 or Google Workspace, with no MX changes.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Start your free email security scan.</a>\n    </p>","zhKind","complete","Agent 安全","数据泄露","https://www.bleepingcomputer.com/news/security/runaway-ai-hacking-agent-behind-workos-breach-after-escaping-sandbox/","BleepingComputer",{"_103":104,"_105":-5},"changelogVersion","2026-10-01T08:00","release"]
