[{"_1":2,"_3":4},"root",{"_5":96},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795221634000,"id","jzchu55e6wyzqizb1khip70u4","title","ConnectWise 警告 SCKit 持续攻击未修补的 ScreenConnect 环境","originalTitle","ConnectWise Warns ScreenConnect Attacks Continue as SCKit Targets Unpatched Systems","summary","ConnectWise 表示，ScreenConnect 26.6.5 之前的客户端存在 CVSS 9.9 的漏洞 CVE-2026-84869，未禁用相关第三方扩展的本地部署仍在遭受攻击。","reason","报道给出了持续攻击规模、恶意组件与持久化痕迹，并明确区分已检测活动和尚无证据的蠕虫传播结果。","source",{"_74":95},"links",{"_86":94},"publishedAt","2026-11-17T06:29:27.000Z","discoveredAt","2026-11-17T06:42:31.317Z","timelineAt","category","vuln","tags",[90,77,91,75,92,93],"score",84,"selected",true,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_61":85,"_86":-5,"_87":88,"_89":37},"outline",[],"relatedStories",[81],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","f9Bcpz3w00zU","reportCount",1,"additionalSourceCount",0,{"_72":79,"_74":80},{"_72":31,"_74":78},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","malware","name","恶意软件","exploited","在野利用","漏洞披露","supply-chain","供应链安全",{"_82":83,"_13":84},"publicId","4c4f0d1f-c78b-4aee-8605-fa5f25c7bd8c","SCKit波及48家机构，漏洞利用扩大","<p><span><i></i><span>Ravie Lakshmanan</span><i></i><span>2026年11月17日</span></span><span>端点安全 / 漏洞</span></p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjErwt0frcFKiESffCoP1OtYh0j23goqdMN0nz-RT02biCz30WlLG4PD5gTyGgbumOWB3Zh1PJfENQoRtOwQVm3Nbg8VsiRhvNk662qVFNGqO8DQ4bFrroSzWgsvfCYGLWFzD1A-f6fcTu_E_dm4o1iUJz96scWy7skw49vzD9hfIfVEILTVPKsvbsEpGca/s1600/screenconnect-flaws.jpg\"><img alt=\"\" src=\"/dailyinfo/media/fde134891c315ce0.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>ConnectWise 周一表示，已完成对针对合作伙伴 ScreenConnect 环境的未授权访问事件的调查，并建议客户确保技术员客户端运行的是 26.6.5 或更高版本。</p><p>该公司表示，在已识别的第三方扩展仍处于启用状态、且 ScreenConnect 尚未更新至最新版本的情况下，仍不断有针对本地部署环境的攻击活动报告。</p><p>“本地部署的合作伙伴必须立即禁用已识别的扩展，并将 ScreenConnect 更新至最新受支持版本，”该公司<a href=\"https://www.connectwise.com/company/trust/advisories\">表示</a>。</p><p>值得注意的是，26.6.5 版本修复了 ScreenConnect 客户端中一个严重级别漏洞，该漏洞编号为 <a href=\"https://www.connectwise.com/company/trust/security-bulletins/2026-09-08-screenconnect-bulletin\">CVE-2026-84869</a>（CVSS 分数：9.9），在某些情况下，攻击者无需授权或主机确认，即可通过已建立的远程会话传输并执行文件。</p><p>正如 <a href=\"https://thehackernews.com/2026/11/screenconnect-attacks-target-at-least.html\">Huntress</a> 和 <a href=\"https://thehackernews.com/2026/11/sckit-malware-targets-screenconnect.html\">Blackpoint Cyber</a> 上周所强调的，据称未知威胁行为者正在利用 RMM+ 1.0.31 和 1.0.32 版本中的身份验证 flaws，以在绕过 ScreenConnect 常规身份验证控制的同时执行未授权命令。</p><p>据发现，这些攻击会部署一个名为 SCKit 的多组件工具包，该工具包能够从受感染的客户设备扩散至 MSP 技术员的计算机，并通过一个名为 RelayTrap（“RelayTrap.cs”）的 C# 模块进一步入侵更多受管网络。</p><p>具体而言，该恶意软件采用了一种蠕虫式技术，利用 CVE-2026-84869 在技术人员连接到受感染设备调查问题时，于其工作站上执行恶意代码。没有证据表明这种蠕虫式行为在最近一次攻击活动中取得成功。</p><p>Huntress 此后表示，其在 2026 年 11 月 13 日又检测到一次与 SCKit 相关的活动激增，影响了 41 个组织中的 205 台主机。</p><p>该公司 <a href=\"https://www.huntress.com/blog/sckit-worm-rogue-screenconnect\">表示</a>：“在这些事件中，我们发现新的 ScreenConnect 客户端由 <a href=\"https://www.virustotal.com/gui/ip-address/185.241.211.197\">185.241.211[.]197</a> 提供托管，该地址关联于 <a href=\"https://thehackernews.com/2026/10/microsoft-365-token-replay-attacks.html\">1337 Services GmbH</a>，这是一家以提供防检测托管服务而闻名的bulletproof hosting provider，此前曾为恶意流量提供托管。”</p><p>“在其中一起事件中，我们发现一个 rogue ScreenConnect 客户端通过一项名为 Windows Update Agent 的服务建立持久化，伪装成合法的系统组件。该服务的可执行文件（UpdateConnect.ClientService.exe）被放置在 C:\\ProgramData\\Windows Update Agent (de362a425905bcc4)\\ 下，并配置为在 LocalSystem 账户下运行。”</p><p>作为对此事件的回应，ConnectWise 已采取行动，在 400 个合作伙伴环境中禁用了五个第三方扩展，包括 Labtech Plus、RMM Plus、RMM+、RMM Plus Password Link 和 RMM+ Password Link。尽管如此，仅存在这些扩展并不意味着相关环境已受到影响。</p><p>该公司还在敦促合作伙伴，在收到进一步指导之前不要重新启用或重新安装这些扩展。它补充道：“禁用扩展和更新软件并不能移除受影响设备上已经建立的未授权访问和持久化机制。”</p><p>觉得这篇文章有意思吗？关注我们在 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a> 上的账号，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","漏洞","补丁","漏洞利用","供应链","https://thehackernews.com/2026/11/connectwise-warns-screenconnect-attacks.html","The Hacker News",{"_97":98,"_99":-5},"changelogVersion","2026-10-01T08:00","release"]
