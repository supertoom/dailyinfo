[{"_1":2,"_3":4},"root",{"_5":89},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":-5,"_57":36,"_58":59},"expiresAt",1794962446000,"id","rbofkj88h4ot9kikelcljbtfo","title","Chrome Extended Stable 桌面版更新至 156.0.8078.108/.109，包含 79 项安全修复","originalTitle","Extended Stable Update for Desktop","summary","Chrome Extended Stable 渠道的 Windows 和 Mac 桌面版已更新至 156.0.8078.108/.109，将在未来数天至数周内逐步推送。","reason","source",{"_64":88},"links",{"_59":87},"publishedAt","2026-11-17T17:01:33.196Z","discoveredAt","2026-11-17T21:24:35.902Z","timelineAt","category","vuln","tags",[84,85,67,86],"score",55,"selected",false,"channel","news","story","x","readingMode","full","author","Daniel Yip","body",{"_80":-5,"_59":81,"_82":-5,"_83":36},"outline",[70,71],"relatedStories",[],"topics",[60,61,62],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_63":68,"_64":69},{"_63":66,"_64":67},{"_63":30,"_64":65},"slug","name","漏洞披露","browser","浏览器","google","Google / 谷歌",{"_11":77,"_73":78,"_75":79},{"_11":72,"_73":74,"_75":76},"sec-2","text","[572193211] Critical CVE-2026-118331[574852698] Critical CVE-2026-118344[5747769","level",3,"sec-1","Security Fixes",2,"zh","<p>The Extended Stable channel has been updated to 156.0.8078.108/.109 for Windows and Mac, which will roll out over the coming days/weeks. A full list of changes in this build is available in the <a href=\"https://chromium.googlesource.com/chromium/src/+log/156.0.8078.100..156.0.8078.108?pretty=fuller&amp;n=10000\">Log</a>.<br><br></p><h2 id=\"sec-1\"><span>Security Fixes</span></h2><p><span>Note: Access to bug details and links may be kept restricted until a majority of users are updated with a fix. We will also retain restrictions if the bug exists in a third party library that other projects similarly depend on, but haven’t yet fixed.</span></p><p><span>This update includes </span><a href=\"https://issues.chromium.org/issues?q=customfield1223088:6-M156-EXT\"><span>79</span></a><span> security fixes</span><span>. Please see the </span><a href=\"https://www.chromium.org/Home/chromium-security\"><span>Chrome Security Page</span></a><span> for more information.</span></p><h3 id=\"sec-2\"><span><p><span>[</span><a href=\"https://issues.chromium.org/issues/572193211\"><span>572193211</span></a><span>] </span><span>Critical</span><span> CVE-2026-118331</span></p><p><span>[</span><a href=\"https://issues.chromium.org/issues/574852698\"><span>574852698</span></a><span>] </span><span>Critical</span><span> CVE-2026-118344</span></p><p><span>[</span><a href=\"https://issues.chromium.org/issues/574776938\"><span>574776938</span></a><span>] </span><span>Critical</span><span> CVE-2026-118348</span></p><p><span>[</span><a href=\"https://issues.chromium.org/issues/569286604\"><span>569286604</span></a><span>] </span><span>High</span><span> CVE-2026-113336</span></p><p><span>[</span><a href=\"https://issues.chromium.org/issues/567175125\"><span>567175125</span></a><span>] </span><span>High</span><span> CVE-2026-113338</span></p><p><span>[</span><a href=\"https://issues.chromium.org/issues/572862424\"><span>572862424</span></a><span>] </span><span>High</span><span> CVE-2026-113339</span></p><p><span>[</span><a href=\"https://issues.chromium.org/issues/574101376\"><span>574101376</span></a><span>] </span><span>High</span><span> CVE-2026-118304</span></p><p><span>[</span><a href=\"https://issues.chromium.org/issues/568348290\"><span>568348290</span></a><span>] </span><span>High</span><span> CVE-2026-118305</span></p><p><span>[</span><a href=\"https://issues.chromium.org/issues/570675085\"><span>570675085</span></a><span>] </span><span>High</span><span> CVE-2026-118307</span></p><p><span>[</span><a href=\"https://issues.chromium.org/issues/574791952\"><spa