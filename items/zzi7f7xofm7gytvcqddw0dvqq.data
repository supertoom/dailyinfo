[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1795912857000,"id","zzi7f7xofm7gytvcqddw0dvqq","title","KEPCO 确认数据泄露，超过 150 万人信息被访问","originalTitle","South Korea’s power giant KEPCO confirms data breach impacting 1.5 million","summary","Korea Electric Power Corporation（KEPCO）确认攻击者侵入内部网络，访问 KEPCO ON 电费平台和 SRM 采购系统，泄露超过 150 万人的数据。","reason","source",{"_75":103},"links",{"_93":102},"publishedAt","2026-11-23T20:54:51.000Z","discoveredAt","2026-11-23T21:01:32.014Z","timelineAt","category","activity","tags",[76,99,78,100,101],"score",74,"selected",true,"channel","news","story",{"_84":85,"_13":86},"x","sameEvent",{"_11":97,"_13":98},"readingMode","full","author","Bill Toulas","body",{"_62":92,"_93":-5,"_94":95,"_96":36},"outline",[87],"relatedStories",[83],"topics",[69,70,71,72],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","fdpgib0Jv3l4","reportCount",2,"additionalSourceCount",1,{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","attack","name","攻击活动","exploited","在野利用","email","邮件与钓鱼","industrial","工业控制",{"_84":85,"_13":86},"publicId","8e25b4b7-9e79-4274-b24b-d48d44aeb67b","KEPCO确认内部网络遭入侵，150万人数据被访问",{"_11":88,"_89":90,"_91":66},"sec-1","text","发现现有防御措施可能遗漏的电子邮件威胁。","level","<p><img alt=\"South Korea’s power giant KEPCO confirms data breach impacting 1.5 million\" height=\"900\" src=\"/dailyinfo/media/58a0afd7d2a4c5f1.jpg\" srcset=\"/dailyinfo/media/4d862684ea68343a.jpg 720w, /dailyinfo/media/5d5b36797934a2ff.jpg 1200w, /dailyinfo/media/58a0afd7d2a4c5f1.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>一名威胁行为者入侵了 Korea Electric Power Corporation (KEPCO) 的内部网络，并访问了&nbsp;两个包含客户、员工和承包商数据的系统。</p><p>在公司阻止来自外部 IP 地址的访问并暂停受影响服务之前，此次攻击暴露了超过 150 万人的详细信息。</p><p>KEPCO 是韩国主要的电力公司，也是由国家控制的重要关键基础设施运营商。</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/8f16a91279acf70b.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>该组织于 11 月 20 日发现了此次攻击，当时确认其 KEPCO ON 电费计费平台和电子采购系统 (SRM) 遭到未授权访问。</p><p>“11 月 20 日星期五，由金东喆总统领导的 Korea Electric Power Corporation（以下简称 KEPCO）确认，其 IT 系统持有的部分客户信息已遭泄露，”这家电力<a href=\"https://www.kepco.co.kr/home/media/newsroom/pr/boardView.do?boardMngNo=15&amp;boardNo=3197\">公司表示</a>。</p><p>“公司正在竭尽全力防止造成损害。”</p><p>ON 是一个综合性客户平台，允许客户查看和支付电费。SRM 是公司的采购系统，用于签订服务合同。</p><p>根据周日的公告，以下信息遭到泄露：</p><ul>\n\t<li>650,487 名 KEPCO ON 客户的信息：姓名、身份信息、电话号码、地址、银行名称、银行账号、账户持有人姓名、发卡机构、卡号、持卡人姓名，以及电费和账单信息。</li>\n\t<li>426,827 名公司代表的姓名、身份信息、电子邮件地址和公司地址。</li>\n\t<li>442,934 名 KEPCO 员工的姓名、所属部门、员工编号、手机号码、电子邮件地址和公司电话号码。</li>\n</ul><p>该公司称此次数据泄露是“AI 等先进技术”所致，但未分享有关初始访问方式或攻击链的任何具体细节。</p><p>KEPCO 正在直接通知数据遭泄露的个人，已向数据保护主管机构提交报告，并正与政府和金融主管机构协调，以阻止未经授权的交易等滥用行为。</p><p>潜在数据遭泄露的个人被警告称，泄露的信息可能被用于定向网络钓鱼和冒充。他们被建议向警方或韩国 Internet and&nbsp;Security Agency 报告任何相关企图。</p><p>还建议避免安装未知应用、在可疑表单中输入信息，以及通过电话或短信分享敏感数据或验证码。</p><p>一名使用“Noiem”别名的威胁行为者<a href=\"https://www.dailysecu.com/news/articleView.html?idxno=209634\">声称发动了此次攻击</a>，并于 11 月 19 日在一个黑客论坛上出售此次泄露事件，称其拥有&nbsp;KEPCO 用户数据、供应商记录以及投标和合同文件。</p><figure><img alt=\"Noiem claiming the attack at KEPCO\" height=\"518\" src=\"/dailyinfo/media/837e2a6bf44d2c0b.jpg\" srcset=\"/dailyinfo/media/b1e89d02d3fa23d2.jpg 720w, /dailyinfo/media/a0d54433b4a5bd04.jpg 1200w, /dailyinfo/media/837e2a6bf44d2c0b.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"900\">\n<figcaption><strong>Noiem 声称攻击了 KEPCO</strong><br>\n<em>来源：&nbsp;dailysecu</em></figcaption>\n</figure><p>韩国 Personal Information Protection Commission <a href=\"https://pipc.go.kr/np/cop/bbs/selectBoardArticle.do?bbsId=BS074&amp;mCode=&amp;nttId=12664\">另行确认</a>，KEPCO 于 11 月 19 日收到了一名黑客声称窃取数据的邮件。</p><p>尽管这些说法与现有证据相符，但对其归因于 Noiem 仍未得到确认。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/1f6f9d6dc9ced8f5.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御措施可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 代理会分析电子邮件意图、上下文和行为，以发现网络钓鱼、商务电子邮件入侵和发票欺诈。</p><p>对 Microsoft 365 或 Google Workspace 进行为期 14 天的只读扫描，看看有哪些威胁正在绕过防护，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始您的免费电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","baq60doueretw9xd5tu96y252","韩国电力公司 KEPCO 数据泄露影响约 150 万人","数据泄露","工控","钓鱼","https://www.bleepingcomputer.com/news/security/south-koreas-power-giant-kepco-confirms-data-breach-impacting-15-million/","BleepingComputer",{"_105":106,"_107":-5},"changelogVersion","2026-10-01T08:00","release"]
