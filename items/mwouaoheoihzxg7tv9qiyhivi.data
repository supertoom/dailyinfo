[{"_1":2,"_3":4},"root",{"_5":89},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1795308037000,"id","mwouaoheoihzxg7tv9qiyhivi","title","CISA 将 Check Point 与 UnrealIRCd 漏洞 CVE-2026-123039、CVE-2026-114713 加入 KEV 目录","originalTitle","U.S. CISA adds Check Point and UnrealIRCd flaws to its Known Exploited Vulnerabilities catalog","summary","CISA 将 UnrealIRCd 命令注入漏洞 CVE-2026-114713 和 Check Point 本地提权漏洞 CVE-2026-123039 加入 KEV 目录，确认均已被真实利用，并要求联邦机构在 2026 年 11 月 16 日前完成处置。","reason","材料列明两个漏洞的利用前提、攻击链和处置期限，便于相关机构核对资产暴露与修复状态。","source",{"_66":88},"links",{"_80":87},"publishedAt","2026-11-14T09:08:00.000Z","discoveredAt","2026-11-14T14:12:35.822Z","timelineAt","category","vuln","tags",[67,84,85,72,70,86],"score",84,"selected",true,"channel","news","story","x","readingMode","full","author","Pierluigi Paganini","body",{"_59":79,"_80":-5,"_81":82,"_83":37},"outline",[73],"relatedStories",[],"topics",[60,61,62,63],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_64":71,"_66":72},{"_64":69,"_66":70},{"_64":31,"_66":68},{"_64":65,"_66":67},"slug","exploited","name","在野利用","漏洞披露","cisa","CISA","checkpoint","Check Point",{"_11":74,"_75":76,"_77":78},"sec-1","text","美国网络安全和基础设施安全局（CISA）将 Check Point 和 UnrealIRCd 漏洞加入其已知被利用漏洞目录。","level",2,"<h2 id=\"sec-1\">美国网络安全和基础设施安全局（CISA）将 Check Point 和 UnrealIRCd 漏洞加入其已知被利用漏洞目录。</h2><p>美国网络安全和基础设施安全局（CISA）&nbsp;<a href=\"https://www.cisa.gov/news-events/alerts/2026/11/13/cisa-adds-two-known-exploited-vulnerabilities-catalog\">将</a> Check Point 和 UnrealIRCd 漏洞加入其&nbsp;<a href=\"https://www.cisa.gov/known-exploited-vulnerabilities-catalog\">已知被利用漏洞（KEV）目录</a>：</p><p>以下是加入目录的漏洞：</p><ul>\n<li><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-114713\"><u>CVE-2026-114713</u></a> UnrealIRCd 分隔符不当中和漏洞</li>\n\n\n\n<li><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-123039\"><u>CVE-2026-123039</u></a> Check Point 多款产品对关键资源权限分配不当</li>\n</ul><ul></ul><p>CVE-2026-114713（CVSS 评分为 8.6）是开源 IRC 服务器软件 UnrealIRCd 中的高危命令注入漏洞。影响版本从 6.0.0 到 6.2.7.1（不含）。</p><p>该漏洞存在于 <code>labeled-response</code> 模块中，该模块在服务器回复中包含 IRCv3 <code>label</code> 消息标签时，未能对其进行正确清理。攻击者可利用这一弱点，在服务器间通信中注入换行符和额外命令。在至少有两台互联服务器的网络上，即使是没有特殊权限的普通用户也能以服务器级权限执行命令。这可能使他们能够执行特权 IRC 操作，例如断开用户连接或将其禁止使用网络。 </p><p>UnrealIRCd 维护者确认，该漏洞披露后不久，攻击者已在互联网上尝试利用该漏洞。然而，尚未公开确认任何具体的威胁组织或攻击者身份，也没有确凿证据将这些攻击与特定行动或经济动机联系起来。该漏洞可能被滥用于获取 IRC 网络的管理控制权、操纵用户和频道，或中断 IRC 服务。</p><p><a href=\"https://securityaffairs.com/202982/hacking/unpatched-check-point-gateways-are-being-wiped-exploiting-php2shell.html\">CVE-2026-123039</a>（CVSS 评分为 7.8）是影响 Check Point Security Gateways 和 Security Management 产品的本地权限提升高危漏洞。该漏洞存在于 Gaia OS DynamicCLI 守护进程中，该进程以 root 权限运行，并在本地全局可写的 Unix 套接字（<code>/tmp/dynamic_socket</code>）上监听，却未对连接进程进行正确身份验证。已通过身份验证的低权限本地攻击者可利用这一弱点，以 root 身份执行任意命令，从而完全控制受影响设备。 </p><p>威胁行为者正在利用该漏洞攻击未打补丁的 Check Point 网关。据 Check Point Research 称，攻击者首先利用 PHP2Shell 漏洞（CVE-2026-109618 和 CVE-2026-109619），通过 Mobile Access 门户获取初始访问权限，随后利用 CVE-2026-123039 将权限提升至 root。之后，他们部署 webshell 和 TSGA 后门、建立持久化、横向移动至内部网络，并在某些情况下部署 destroy_v6 擦除程序，以清除 VMware ESXi 主机上的数据。</p><p>该行动最初于 2026 年 10 月 30 日以以色列组织为目标，并据报道对部分受害者发动了破坏性攻击。11 月 2 日的第二波攻击扩展至多个国家和多个行业的组织。</p><p>归因仍不确定。该恶意软件与 PhiliKit 共享代码和基础设施特征；PhiliKit 是一个此前与 UNC5221 相关的框架，后者是一个与中国有关联的威胁行为体。不过，Check Point 警告称，现有证据不足以有把握地将整个攻击活动归因于该组织。可能的解释包括与另一个行为体合作，或开展虚假旗标行动。 </p><p>根据&nbsp;<a href=\"https://cyber.dhs.gov/bod/22-01/\">《约束性操作指令 (BOD) 22-01：降低已知被利用漏洞的重大风险》</a>，FCEB 机构必须在截止日期前处理已识别的漏洞，以保护其网络免受利用目录中缺陷的攻击。</p><p>专家还建议私营组织审查&nbsp;<a href=\"https://www.cisa.gov/known-exploited-vulnerabilities-catalog\">漏洞目录</a>&nbsp;并处理其基础设施中的漏洞。</p><p>CISA 命令联邦机构在 2026 年 11 月 16 日前修复这两个漏洞。</p><p><strong>在 Twitter 上关注我：&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;以及&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;和&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;黑客，&nbsp;<a href=\"https://securityaffairs.com/tag/cisa\">CISA</a>)</strong></p>","original","zhKind","translation","complete","漏洞","补丁","VMware","https://securityaffairs.com/203040/hacking/u-s-cisa-adds-check-point-and-unrealircd-flaws-to-its-known-exploited-vulnerabilities-catalog.html","Security Affairs",{"_90":91,"_92":-5},"changelogVersion","2026-10-01T08:00","release"]
