[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1793621626000,"id","x1nem8dlcetm2n53rfxplrepv","title","攻击者利用 GitLab CVE-2026-97229 试图入侵 Alpine Linux","originalTitle","Alpine Linux rebuilds GitLab after attempted RCE attack","summary","攻击者于 October 20–21 利用 GitLab CVE-2026-97229，针对 Alpine Linux 的 GitLab 提交恶意 CI 配置，造成 8 次 worker 崩溃，其中 4 次部分成功，但未发现代码执行、软件包或发布被篡改的证据。","reason","source",{"_75":103},"links",{"_93":102},"publishedAt","2026-11-01T15:11:21.000Z","discoveredAt","2026-11-01T15:38:30.511Z","timelineAt","category","activity","tags",[76,78,99,100,101],"score",79,"selected",true,"channel","news","story",{"_84":85,"_13":86},"x","sameEvent",{"_11":97,"_13":98},"readingMode","full","author","Bill Toulas","body",{"_62":92,"_93":-5,"_94":95,"_96":36},"outline",[87],"relatedStories",[83],"topics",[69,70,71,72],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","fQJOc_QA6dwU","reportCount",2,"additionalSourceCount",1,{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","attack","name","攻击活动","exploited","在野利用","cloud-native","云与原生","supply-chain","供应链安全",{"_84":85,"_13":86},"publicId","90090fff-0735-4785-85dc-e37c1ee2f49c","GitLab远程代码执行漏洞已遭在野利用",{"_11":88,"_89":90,"_91":66},"sec-1","text","发现现有防御可能遗漏的电子邮件威胁。","level","<p><img alt=\"Alpine Linux\" height=\"900\" src=\"/dailyinfo/media/f5e975f6da6c5095.jpg\" srcset=\"/dailyinfo/media/cc3c812b0b4e4f7d.jpg 720w, /dailyinfo/media/a8c7515ae8f281b2.jpg 1200w, /dailyinfo/media/f5e975f6da6c5095.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>10 月 20 日至 21 日，黑客试图利用 Alpine Linux 开发基础设施中的 GitLab 严重漏洞，促使该开源项目重建其 GitLab 服务器并重置所有密码，以防可能已经遭到入侵。</p><p>这些攻击针对 CVE-2026-97229，这是一个严重级别最高的远程代码执行漏洞，曾多次导致 GitLab 进程崩溃，其中一些攻击险些成功。</p><p>尽管 Alpine Linux 没有发现攻击者执行代码或篡改其软件包和发行版的证据，但由于日志缺失且缺少出站连接记录，它无法排除已成功入侵的可能性。</p><p><a href=\"https://www.wiz.io/lp/ai-security-starter-pack?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Security-Starter-Kit&amp;sfcid=701Vh00000cn7aRIAQ&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AI-Security-Bundle\"><img src=\"/dailyinfo/media/011b0fd1d92e00dc.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p><a href=\"https://alpinelinux.org/posts/GitLab-security-incident-CVE-2026-97229.html\">Alpine Linux 团队解释道</a>：“由于我们无法排除代码执行的可能性，而确认这一点所需的证据已不复存在，我们采取了更艰难的做法，从头重建了 GitLab 实例。”</p><p>Alpine Linux 是一个小巧、轻量的操作系统，被广泛用作运行应用程序和服务的 Docker 容器镜像的基础。</p><p>其 GitLab 实例承载着开发仓库、代码审查和 CI 作业，包括用于生成 Alpine 软件包的“aports”构建配方。</p><p>这使其成为极具价值的供应链目标，因为篡改其 GitLab 环境可能影响下游软件。</p><p>CVE-2026-97229 是 GitLab 的 CI/CD 正则表达式编译器 Onigmo（随 Ruby 一同打包）中的一个 <a href=\"https://nvd.nist.gov/vuln/detail/cve-2026-97229\">严重级别最高的</a>整数溢出漏洞，可能允许未经身份验证的攻击者在服务器上执行任意代码。</p><p>GitLab <a href=\"https://www.bleepingcomputer.com/news/security/gitlab-warns-of-max-severity-rce-flaw-in-regex-compiler-engine/\">披露了该漏洞</a>，并于 10 月 12 日提供修复，同时警告攻击者在某些条件下可以通过在 CI/CD 流水线配置中提交 specially crafted 正则表达式来触发该漏洞。</p><p>Alpine 最初安装的是 GitLab 19.3.4，而不是已修复漏洞的 19.3.5。后来升级到 19.3.6 仍未消除该漏洞，&nbsp;因为修复需要对 Ruby 进行修补。GitLab 的官方软件包包含此修补，而 Alpine 的自定义容器镜像并未包含。</p><p>10 月 20 日至 21 日，攻击者提交了针对该漏洞的恶意 CI 配置，导致八次 worker 崩溃；其中四次部分成功，但似乎都没有完全成功。</p><p>Alpine Linux 团队发现，攻击者下载了其 GitLab 容器镜像，这表明他们可能正在准备一场供应链攻击。</p><p>经过调查，Alpine 未发现截至 10 月 27 日的仓库提交、软件包或发行版遭到篡改。此外，签名密钥不可能已经暴露，因为这些密钥并不存储在 GitLab 服务器上。</p><figure><img alt=\"Incident timeline\" height=\"464\" src=\"/dailyinfo/media/db186babfa762c92.jpg\" srcset=\"/dailyinfo/media/1c7c81eb2d4aefe6.jpg 720w, /dailyinfo/media/e89a0a5469d68574.jpg 1200w, /dailyinfo/media/db186babfa762c92.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"999\">\n<figcaption><strong>事件时间线</strong><br>\n<em>来源：Alpine Linux</em></figcaption>\n</figure><p>如果利用成功，潜在暴露的信息包括用户详情、密码哈希、2FA 密钥、CI/CD 密钥、集成凭据和私有项目内容，但尚未确认上述任何内容遭到入侵。</p><p>Alpine 建议用户重置其 GitLab 密码，并拉取 10 月 27 日发布的 alpinelinux/gitlab:19.3.6 镜像，该镜像包含 Ruby 3.3.13，并修复了 CVE-2026-97229。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/dc92bacf94761ef1.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 代理会分析电子邮件的意图、上下文和行为，以发现网络钓鱼、商务电子邮件入侵和发票欺诈。</p><p>对 Microsoft 365 或 Google Workspace 进行为期 14 天的只读扫描，看看有哪些威胁正在穿过防线，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始您的免费电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","kap6lzk1o51rm638fm4tiscnh","攻击者尝试利用 Alpine Linux GitLab 的 CVE-2026-97229 漏洞，CVSS 10.0","漏洞利用","供应链","容器","https://www.bleepingcomputer.com/news/security/alpine-linux-rebuilds-gitlab-after-attempted-rce-attack/","BleepingComputer",{"_105":106,"_107":-5},"changelogVersion","2026-10-01T08:00","release"]
