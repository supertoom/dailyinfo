[{"_1":2,"_3":4},"root",{"_5":92},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1795826446000,"id","o1ue0pgetjkmwp15g0g2rbxt0","title","UK Department of Work and Pensions 因网络安全事件下线在线服务","originalTitle","UK Welfare and Pension Services Taken Offline Following Cyber Incident","summary","UK Department of Work and Pensions（DWP）因网络安全事件于 November 26 约 21.00 GMT 下线全部在线服务，包括 universal credit 和 state pensions 账户登录及新福利申请；常规福利和养老金支付未受影响，将照常发放。","reason","source",{"_71":91},"links",{"_60":90},"publishedAt","2026-11-27T11:15:00.000Z","discoveredAt","2026-11-27T12:05:25.420Z","timelineAt","category","activity","tags",[72,89,74],"score",57,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","body",{"_85":-5,"_60":86,"_87":-5,"_88":36},"outline",[79],"relatedStories",[75],"topics",[67,68],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fpABZ3FlDPKo","reportCount",1,"additionalSourceCount",0,{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","attack","name","攻击活动","incident","应急响应",{"_76":77,"_13":78},"publicId","227a13a6-916c-4f7b-8726-2c72c973852a","英国工作与养老金部因网络安全事件下线全部在线服务",{"_11":80,"_81":82,"_83":84},"sec-1","text","Incident Follows UK Government Warnings Over Threat Landscape","level",2,"zh","<p><img src=\"/dailyinfo/media/6a795d301a355173.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Photo of James Coker\"></p><p>\n\tThe UK government department responsible for welfare and pension payments has been impacted by a cyber incident, resulting in services being taken offline.</p><p>\n\tThe Department of Work and Pensions (DWP) <a href=\"https://www.gov.uk/government/news/temporary-disruption-to-some-dwp-online-services\">announced</a> the incident on the official gov.uk website on November 27, confirming online services had been taken offline “as a precaution.”</p><p>\n\tRegular benefit and pension payments have not been affected and will be paid as normal, the short statement noted.</p><p>\n\t“We are working closely with the National Cyber Security Centre and Government Cyber Coordination Centre to investigate and to bring services back online as quickly as possible and to minimise any disruption,” the DWP said.</p><p>\n\t“If an online service you need is unavailable, please try again later. As always, we will never message you to ask for bank details or ask you to click on links,” the department added.</p><p>\n\tClaimants are currently unable to sign into online accounts for services like <a href=\"https://www.universal-credit.service.gov.uk/sign-in\">universal credit</a> and <a href=\"https://www.manage-state-pension.service.gov.uk/start\">state pensions</a>.</p><p>\n\tNo information has so far been provided on how the incident occurred or any alleged perpetrators.</p><p>\n\tSteven Swinford, political editor at <em>The Times</em> newspaper, <a href=\"https://x.com/Steven_Swinford/status/2126238986062401842?a=m57MFOFWGNTMHfenJes&amp;s=20\">reported</a> on X on November 27 that the DWP took down all online services at around 21.00 GMT on November 26. He added that the department has said that although regular benefit payments are continuing, people will be unable to make new claims while online services remain offline.</p><p>\n\tThe DWP is one of the UK’s largest government departments, with 96,890 employees as of 2025. It administers the State Pension and a range of working age, disability and ill health benefits to around 20 million claimants and customers.</p><h2 id=\"sec-1\">\n\t<strong>Incident Follows UK Government Warnings Over Threat Landscape</strong></h2><p>\n\tThe incident affecting the DWP follows repeated warnings from the UK government about the potential for cyber-attacks to take crucial services offline.</p><p>\n\tIn October,&nbsp;Secretary of State for Defence, Wes Streeting, <a href=\"https://www.bbc.co.uk/news/articles/cwd094x57p32o\">told</a> the public to be prepared for cyber incidents that could remove access to everyday services such as mains water, sewage, phones and the internet.</p><p>\n\tIn November, NCSC CEO Richard Horne <a href=\"https://www.infosecurity-magazine.com/news/ncsc-ai-ransomware-threat-uk-cni/\">warned</a> that AI-powered malware is strongly expected to feature in ransomware attacks on the UK’s critical national infrastructure by 2028.</p><p>\n\tIt was reported in October that a number of UK government websites were taken offline in response to the <a href=\"https://www.infosecurity-magazine.com/news/critical-php-vulnerabilities-leaked/\">‘PHP2Shell’ vulnerabilities</a> being disclosed ahead of planned security patches, to prevent exploitation of such services.</p><p>\n\tTrevor Dearing, senior director of critical infrastructure at Illumio, said that the public will need to get used to public services being shut down temporarily to mitigate cyber-attacks.</p><p>\n\t“Public sector networks are huge, interconnected and full of legacy systems, so when you can't be sure how far an attacker has moved, the only safe option is to pull the plug.”</p><p>\n\tHowever, Dearing warned that this approach should not be the long-term answer to dealing with cyber-attacks, particularly when it comes to critical services like pensions and welfare, which millions are reliant upon.</p><p>\n\t<em>Image credit: William Barton / Shutterstock.com</em></p>","zhKind","complete","数据泄露","https://www.infosecurity-magazine.com/news/uk-welfare-services-offline/","Infosecurity Magazine",{"_93":94,"_95":-5},"changelogVersion","2026-10-01T08:00","release"]
