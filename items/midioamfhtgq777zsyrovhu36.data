[{"_1":2,"_3":4},"root",{"_5":102},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1794185103000,"id","midioamfhtgq777zsyrovhu36","title","Android CVE-2026-58882“短信死亡”漏洞分析与 PoC 复现","originalTitle","New Android SMS of Death exploit can remotely crash unpatched phones","summary","安全研究员 Mark Blah 披露 Android CVE-2026-58882 的 PoC，可通过特制 WAP Push 短信远程触发拒绝服务，导致通话中断。","reason","source",{"_73":101},"links",{"_89":100},"publishedAt","2026-10-31T15:35:11.000Z","discoveredAt","2026-10-31T16:16:29.716Z","timelineAt","category","vuln","tags",[95,96,97,98,76,99],"score",78,"selected",true,"channel","news","story",{"_80":81,"_13":82},"x","sameEvent",{"_11":93,"_13":94},"readingMode","full","author","Lawrence Abrams","body",{"_62":88,"_89":-5,"_90":91,"_92":36},"outline",[83],"relatedStories",[79],"topics",[69,70,71],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","fafTcIRBwfko","reportCount",2,"additionalSourceCount",1,{"_72":77,"_73":78},{"_72":75,"_73":76},{"_72":30,"_73":74},"slug","name","漏洞披露","mobile","移动端","google","Google / 谷歌",{"_80":81,"_13":82},"publicId","c5486508-cdc6-495f-b2ad-9788dc5a009f","Android短信拒绝服务漏洞PoC公开",{"_11":84,"_85":86,"_87":66},"sec-1","text","攻击者一旦拥有有效凭据，其操作中只有 37% 会被阻止","level","<p><img alt=\"Android malicious activity\" height=\"900\" src=\"/dailyinfo/media/20be17bc3dd084a7.jpg\" srcset=\"/dailyinfo/media/62f64c2df44bbe0c.jpg 720w, /dailyinfo/media/4d72cd2400582175.jpg 1200w, /dailyinfo/media/20be17bc3dd084a7.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>一名安全研究人员发布了一个针对近期已修补 Android 漏洞的概念验证漏洞利用程序。该漏洞被称为“SMS of Death”，编号为 CVE-2026-58882，攻击者只需发送一条特制短信，即可远程干扰蜂窝服务或使手机崩溃。</p><p>这个零点击拒绝服务漏洞无需目标用户进行任何交互，就能中断正在进行的通话，包括紧急呼叫。更糟糕的是，Android 会在消息进入短信收件箱之前对其进行处理，因此受害者看不到任何导致手机崩溃的原因。</p><p>据漏洞研究人员 Mark Blah 表示，Google 据称已在面向 Android 14 至 17 的<a href=\"https://source.android.com/docs/security/bulletin/2026/2026-10-01\">2026 年 10 月 Android 安全更新</a>中<a href=\"https://android.googlesource.com/platform/frameworks/opt/telephony/+/735d9672603fa206c4b43cb668c1aa273db70b97\">修补了该漏洞</a>。然而，该漏洞并未列入 Google 的 10 月安全公告中，较旧的 Android 12 和 13 设备仍容易受到攻击，因为它们未收到此修复。</p><p>Blah 发布了该漏洞的<a href=\"https://smsofdeath.com/\">技术分析</a>。漏洞源于 Android 的 WapPushOverSms.decodeWapPdu 函数未正确校验标头长度值。</p><p>攻击者可以向目标手机发送以下格式错误的 8 字节 WAP Push 消息来利用该漏洞：</p><pre><code>01 06 88 80 80 80 00 BE   → sent as a data SMS to port 2948</code></pre><p>如果未经边界检查就将该值转换为有符号 32 位整数，结果会变为 -2147483648。</p><p>当 Android 尝试使用这个负值分配内存时，会触发 NegativeArraySizeException，导致 com.android.phone 进程崩溃。</p><p>由于 com.android.phone 进程负责管理蜂窝功能，该崩溃会中断移动连接，并断开正在进行的电话，包括拨打紧急服务的电话。</p><p>研究人员表示，当运营商尝试重新投递恶意消息，或 Android 尝试处理手机上已存储的消息时，该攻击还可能导致反复崩溃。</p><p>在测试该漏洞时，研究人员发现，发送 20 条恶意消息可能导致手机陷入重启循环。在一台 Android 12 设备上，手机大约每 90 秒就会重启进入恢复模式，需要用户执行恢复出厂设置才能恢复。</p><p>一名名为 Sakis 的 GitHub 贡献者发现了一种使用 Android Debug Bridge（ADB）移除恶意消息的方法，但这一过程需要更高水平的技术知识和计算机访问权限。</p><p>研究人员发布了一个<a href=\"https://github.com/MarkBlah/smsofdeath\">概念验证漏洞利用程序</a>，可从另一台 Android 设备发送恶意消息。</p><p>Google 的修复程序名为“Fix remote DoS in decodeWapPdu”，通过捕获 Android 处理格式错误短信时触发的异常来防止崩溃。</p><p>该补丁还会从 SMS 数据库中删除恶意消息，防止其反复触发崩溃。</p><p>Android 安全更新通常会自动安装在受支持的设备上，但能否获取更新取决于设备制造商和运营商，并且可能需要重启设备才能完成安装。</p><p>鉴于可用的概念验证漏洞利用程序已经发布，现强烈建议 Android 用户安装最新安全更新，以保护自己的设备。</p><p><a href=\"https://hubs.li/Q04sB3fb0\">\n            <img src=\"/dailyinfo/media/8fba1fc16e9d219a.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://hubs.li/Q04sB3fb0\">攻击者一旦拥有有效凭据，其操作中只有 37% 会被阻止</a>\n        </h2><p>总体预防评分可能掩盖初始访问之后发生的情况。一旦攻击者使用有效凭据，预防效果就会大幅下降。</p><p>Blue Report 2026 在客户生产环境中通过 3.38 亿次模拟，按技术逐项衡量各项防御措施。</p><p><a href=\"https://hubs.li/Q04sB3fb0\">获取报告</a>\n    </p>","original","zhKind","translation","complete","vwazprhy9sym8n3jfpzyapz5g","Android SMS of Death 漏洞分析：CVE-2026-58882 可用零点击 WAP Push 消息阻断电话服务","漏洞","复现","漏洞利用","补丁","Google","https://www.bleepingcomputer.com/news/security/new-android-sms-of-death-exploit-can-remotely-crash-unpatched-phones/","BleepingComputer",{"_103":104,"_105":-5},"changelogVersion","2026-10-01T08:00","release"]
