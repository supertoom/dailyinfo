[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1794444091000,"id","ab8pl4m4w1rix1cyy06pzrdy7","title","Model Context Protocol Python SDK 客户端漏洞可触发外部 URL 请求或本地文件读取","originalTitle","Model Context Protocol Python SDK: Client fetched server-chosen $ref URLs while validating tool results against output schemas","summary","Model Context Protocol Python SDK 的 MCP 客户端在校验工具结果时会解析服务端指定的 `$ref`，可访问 `http://`、`https://` 或 `file://` URL。1.10.0 至 1.29.1 及 2.0.0 至 2.1.1 受影响，升级至 `mcp` 1.30.0、2.2.0 或更高版本可修复，升级前应仅调用可信服务器的工具。","reason","公告明确说明客户端会按服务端指定的 `$ref` 发起网络请求或读取本地文件，并给出受影响版本与升级路径，便于评估暴露面。","source",{"_71":81},"links",{"_60":80},"publishedAt","2026-10-27T21:05:29.000Z","discoveredAt","2026-10-28T09:01:40.985Z","timelineAt","category","vuln","tags",[78,79,72],"score",73,"selected",true,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[67,68],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","f42DcS3X6pfg","reportCount",1,"additionalSourceCount",0,{"_69":31,"_71":73},{"_69":70,"_71":72},"slug","ai-security","name","AI 安全","漏洞披露",{"_75":76,"_13":77},"publicId","c447dacb-0b75-425b-b984-3e6f06e42eef","MCP Python SDK披露外部引用漏洞","漏洞","补丁","https://github.com/advisories/GHSA-rwrf-2pqf-9j8j","GitHub 安全公告",{"_83":84,"_85":-5},"changelogVersion","2026-10-01T08:00","release"]
