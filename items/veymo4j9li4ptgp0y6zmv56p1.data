[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795480845000,"id","veymo4j9li4ptgp0y6zmv56p1","title","Elastic Stack 8.19.26 发布，推荐从 8.19.25 升级","originalTitle","Elastic Stack 8.19.26 released","summary","Elastic Stack 8.19.26 今日发布，官方推荐升级至该版本，优先级高于此前的 8.19.25。各产品本次修复的问题与完整变更清单见对应版本的 release notes，原文未披露具体漏洞编号、CVSS 分数或受影响范围。","reason","source",{"_79":80},"links",{"_61":78},"publishedAt","2026-11-23T00:00:00.000Z","discoveredAt","2026-11-23T18:39:37.570Z","timelineAt","category","blue-team","tags",[76,77],"score",3,"selected",false,"channel","news","story",{"_69":70,"_13":71},"x","readingMode","full","author","Navya Uppalapati","body",{"_72":-5,"_61":73,"_74":-5,"_75":36},"outline",[],"relatedStories",[68],"topics",[],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fAVuSNqJX0ts","reportCount",1,"additionalSourceCount",0,{"_69":70,"_13":71},"publicId","e1f88134-33d0-4e5d-ae70-3d27a82cf512","Elastic Stack 8.19.26 发布","zh","<p><img src=\"/dailyinfo/media/36396e16e2972192.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\"></p><p>Version 8.19.26 of the Elastic Stack was released today. We recommend you <a href=\"https://www.elastic.co/docs/deploy-manage/upgrade\">upgrade to this latest version</a>. We recommend 8.19.26 over the previous version 8.19.25</p><p>For details of the issues that have been fixed and a full list of changes for each product in this version, please refer to <a href=\"https://www.elastic.co/guide/en/starting-with-the-elasticsearch-platform-and-its-solutions/8.19/new.html\">the release notes</a>.</p>","zhKind","complete","版本更新","例行内容","https://www.elastic.co/blog/elastic-stack-8-19-26-released","name","Elastic Blog",{"_82":83,"_84":-5},"changelogVersion","2026-10-01T08:00","release"]
