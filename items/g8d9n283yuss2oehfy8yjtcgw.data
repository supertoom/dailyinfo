[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":60,"_61":62},"expiresAt",1795740036000,"id","g8d9n283yuss2oehfy8yjtcgw","title","瑞士确认首起由 AI Agent 辅助的网络攻击，关键基础设施受影响","originalTitle","Switzerland Confirms First AI-Agent Cyberattacks on Local Organisations","summary","瑞士 NCSC 确认其首次收到由 AI Agent 辅助实施的网络攻击报告，至少两个行业的多个组织和关键基础设施运营商受到影响，已知攻击均成功攻陷目标系统。攻击者使用 Agentic Offensive Frameworks，让 Agent 搜索已知漏洞、选择工具、评估结果并决定下一步，主要针对弱口令、软件已知缺陷和互联网暴露系统。","reason","材料展示了 AI Agent 加速传统攻击并成功入侵关键基础设施的实例，同时给出暴露面收敛、MFA、最小权限和 24 小时补丁要求。","source",{"_74":96},"links",{"_62":95},"publishedAt","2026-11-25T21:06:55.000Z","discoveredAt","2026-11-25T21:28:26.674Z","timelineAt","category","activity","tags",[77,75,94,79],"score",83,"selected",true,"channel","news","story",{"_81":82,"_13":83},"x","readingMode","full","author","Pierluigi Paganini","body",{"_90":-5,"_62":91,"_92":-5,"_93":60},"outline",[84],"relatedStories",[80],"topics",[69,70,71],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation",false,"bodyLanguage","original","factId","fyyNNgO8KpJE","reportCount",1,"additionalSourceCount",0,{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","ai-security","name","AI 安全","attack","攻击活动","exploited","在野利用",{"_81":82,"_13":83},"publicId","9c517bae-779d-4732-9df7-a5334789a940","瑞士确认首起AI代理辅助攻击事件",{"_11":85,"_86":87,"_88":89},"sec-1","text","Switzerland reports its first AI-agent cyberattacks, including critical infrastr","level",2,"zh","<h2 id=\"sec-1\">Switzerland reports its first AI-agent cyberattacks, including critical infrastructure breaches, and urges patching internet-facing systems within 24 hours.</h2><p>Switzerland ’s National Cyber Security Centre (NCSC) has now seen these attacks firsthand. In recent days, it received its first reports of cyberattacks on Swiss organisations carried out with the help of AI agents. The victims include critical infrastructure operators in at least two sectors.</p><p><em>“In recent days, the NCSC has received its first reports of cyberattacks against organisations in Switzerland in which the attack was carried out with the assistance of an AI agent.” reads the <a href=\"https://www.bacs.admin.ch/en/26-ki-agenten-1-en\">report</a> published by NCSC. “Various organisations and operators of critical infrastructure across at least two sectors have been affected by these cyberattacks.”</em></p><p>What stands out is the result. In every AI-assisted attack known to the NCSC, the attackers successfully compromised the victims’ IT systems. The agency sees these incidents as more than isolated cases, warning that they mark a shift in the cyber threat landscape.</p><p>The attackers used what the NCSC calls “Agentic Offensive Frameworks”. These AI agents can search for vulnerabilities, choose attack tools, assess the results and decide what to do next, all with limited human input. Security teams also use the same software for penetration testing, which makes these tools dual-use.</p><p>The targets aren’t exotic. The agents go after standard or easily guessed passwords, known flaws in software, and systems connected to the internet. </p><p><em>“AI agents often require only a fraction of the time a human would need to locate such vulnerable systems and exploit existing vulnerabilities. Furthermore, they can react flexibly to defence mechanisms by switching to other known attack methods. This leaves organisations with significantly less time to detect an attack and respond appropriately.” continues the report. </em></p><p>AI agents can quickly switch tactics when a defence blocks an attack, leaving organisations less time to detect and stop intrusions. The NCSC warns that these tools speed up common attack methods and that internet-accessible agents such as <a href=\"https://securityaffairs.com/tag/artex\">ARTEX</a> and CyberStrikeAI have almost doubled since October 2026. This could lead to more frequent, faster and more successful automated attacks against organisations of all types.</p><p>ARTEX isn’t a surprise. The FBI recently published a FLASH <a href=\"https://www.ic3.gov/CSA/2026/261113.pdf\">alert </a>that describes it as open source, with no model of its own, plugged into external language models. The same advisory says some intrusions went from first contact to privileged access in under three hours.</p><p>The NCSC expects more successful attacks and urges companies and critical infrastructure operators to strengthen their security and resilience. It monitors the threat landscape, stays in contact with national and international partners, and shares technical indicators for detecting these tools with infrastructure operators. Its recommendations are short, and it wants them applied without delay.</p><p>Start by shrinking what’s exposed. Fewer systems facing the internet means a smaller attack surface, and where possible you can restrict access with geo-blocking or an allow list of IP addresses or network segments. Every internal resource reachable from the internet, such as webmail and VPN, should sit behind multi-factor authentication or passkeys, with no exceptions.</p><p>Then limit the damage. Grant the lowest access rights that work, and watch for deviations from normal behaviour and data volumes across identities, applications, workloads and infrastructure. Test your own infrastructure for vulnerabilities on a regular basis, yourself or with an outside specialist.</p><p><em>“Critical security updates for systems accessible via the internet should be installed as soon as possible, but no later than 24 hours after release.” concludes the report.</em></p><p><strong>Follow me on Twitter:&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;and&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a><strong></strong></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;hacking,&nbsp;Switzerland)</strong></p>","zhKind","complete","Agent 安全","https://securityaffairs.com/204004/hacking/switzerland-confirms-first-ai-agent-cyberattacks-on-local-organisations.html","Security Affairs",{"_98":99,"_100":-5},"changelogVersion","2026-10-01T08:00","release"]
