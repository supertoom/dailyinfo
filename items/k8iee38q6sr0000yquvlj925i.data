[{"_1":2,"_3":4},"root",{"_5":134},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":-5,"_56":37,"_57":58},"expiresAt",1794444095000,"id","k8iee38q6sr0000yquvlj925i","title","Google Cloud 披露 LLMJacking 攻击链，攻击者转售被盗企业 LLM 资源","originalTitle","The Rise of LLMJacking: How Threat Actors Monetize Compromised Cloud and Model Resources","summary","Google Cloud 威胁情报披露，攻击者在 2026 年多起 LLMJacking 入侵中盗用企业云身份和 LLM API 凭据，入侵北美、南美及亚太的金融、零售、技术和运输组织，单日欺诈费用超过 $100,000 USD，部分组织累计达 $1 million USD。","reason","文章以多起真实入侵还原 LLMJacking 的获客、变现与检测链路，并给出可落地的云侧审计和加固措施。","source",{"_68":133},"links",{"_122":132},"publishedAt","2026-11-02T14:00:00.000Z","discoveredAt","2026-11-02T15:48:37.650Z","timelineAt","category","ai-security","tags",[69,73,71,126,127,128,129,130,131],"score",80,"selected",true,"channel","news","story","x","readingMode","full","author","body",{"_58":121,"_122":-5,"_123":124,"_125":37},"outline",[84,85,86,87,88,89,90,91,92,93,94],"relatedStories",[],"topics",[59,60,61,62,63,64,65,66],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_67":82,"_68":83},{"_67":80,"_68":81},{"_67":78,"_68":79},{"_67":76,"_68":77},{"_67":74,"_68":75},{"_67":72,"_68":73},{"_67":70,"_68":71},{"_67":31,"_68":69},"slug","name","AI 安全","malware","恶意软件","attack","攻击活动","ai-agent","AI Agent 安全","black-market","数据窃取与黑产","ransomware","勒索软件","supply-chain","供应链安全","google","Google / 谷歌",{"_11":119,"_96":120,"_98":102},{"_11":117,"_96":118,"_98":102},{"_11":115,"_96":116,"_98":102},{"_11":113,"_96":114,"_98":102},{"_11":111,"_96":112,"_98":102},{"_11":109,"_96":110,"_98":102},{"_11":107,"_96":108,"_98":102},{"_11":105,"_96":106,"_98":102},{"_11":103,"_96":104,"_98":99},{"_11":100,"_96":101,"_98":102},{"_11":95,"_96":97,"_98":99},"sec-11","text","网络指标","level",4,"sec-10","失陷指标（IOC）",3,"sec-9","监控原生云审计日志&nbsp;","sec-8","缓解与修复","sec-7","Google Security Operations","sec-6","检测与威胁狩猎","sec-5","展望","sec-4","LLM 滥用","sec-3","横向移动与持久化","sec-2","初始访问","sec-1","简介&nbsp;","<p><span>作者： </span><span>Christopher Romano、Codi Starks、Garrett Mahoney、John Wolfram、Josh Murchie、K Singh、Mathew Potaczek、Mike Lombardi、Rik Dolfing</span></p><hr><h3 id=\"sec-1\"><span>简介</span><strong>&nbsp;</strong></h3><p><span>Mandiant 响应了 2026 年的多起安全事件，其中威胁行为者劫持了企业对大型语言模型（LLM）的访问权限，这种战术被称为“LLMJacking”。这些入侵涉及多种云和 LLM 提供商，影响了北美、南美和亚太地区横跨金融服务、零售、科技和运输行业的组织。&nbsp;</span></p><p><span>与加密货币挖劫相关的渐进式资源消耗不同，LLMJacking 可在数小时内导致欺诈性云费用激增。在单个事件中，我们观察到与资源消耗相关的欺诈性费用在一天内超过 100,000 美元；一些组织的累计费用在访问权限被撤销前达到 100 万美元。</span></p><figure><p><img src=\"/dailyinfo/media/69df8c771be5b8ba.webp\" loading=\"lazy\" decoding=\"async\" alt=\"https://storage.googleapis.com/gweb-cloudblog-publish/images/Figure_1_Usage_chart_showing_LLMJacking_ge.max-2000x2000_ttHac9S.png\"></p></figure><p>图 1：显示 LLMJacking 导致 API 请求量激增的使用情况图表</p><p><span>Google Threat Intelligence Group（GTIG）分析了这些前沿入侵背后的犯罪生态，并在 </span><a href=\"https://cloud.google.com/blog/topics/threat-intelligence/from-prompting-to-autonomy-the-evolution-of-adversarial-ai\"><span>此前关于不断壮大的 LLM 凭据地下市场的报道</span></a><span>基础上，识别出在全球多个地区活动的多样化 financially motivated threat clusters。</span></p><p><span>随着 LLMJacking 生态日益成熟，我们还观察到威胁行为者之间出现了分工：一类负责获取受攻击环境的初始访问权限，另一类则负责管理下游变现基础设施，后者被称为“LLM Mixers”。LLM Mixers 充当非法路由网关，为地下订阅者代理、聚合并转售未经授权的 LLM 访问权限。在一次调查中，GTIG 观察到两个不同的运营集群协同入侵企业 LLM 基础设施并将其变现，显示出该领域正在形成精细化的专业化分工。</span></p><p><span>在这篇博客文章中，我们介绍了近期 LLMJacking 调查中观察到的攻击生命周期，并提供可操作的检测、加固和修复指南，以帮助组织保护其基础设施。&nbsp;</span></p><h3 id=\"sec-2\"><span>初始访问</span></h3><p><span>虽然低层次资源窃取涉及利用 </span><a href=\"https://www.cio.com/article/4155404/ai-token-freeloaders-are-coming-for-your-customer-support-chatbot.html\"><span>操控客户支持聊天机器人</span></a><span>来执行代码生成等未经授权的任务，但实施 LLMJacking 的威胁行为者会绕过这些前端界面，直接针对后端模型资源。具体而言，他们专注于识别公开暴露的 LLM 端点，或获取有效的 LLM 应用程序编程接口（API）密钥。后一种情况的示例见图 1：威胁行为者使用自动化脚本调用 </span><code>/api/create</code><span> 端点进行验证，以独立运行自己的模型，而不知情的用户已将相关端点公开访问。未对这些服务采取保护措施，不仅会扩大组织的传统攻击面，还可能显著增加托管费用。 </span></p><figure><p><img src=\"/dailyinfo/media/8185cddfb4e8e7da.webp\" loading=\"lazy\" decoding=\"async\" alt=\"https://storage.googleapis.com/gweb-cloudblog-publish/images/Figure_2_Threat_Actor_tests_publicly_expos.max-1900x1900.png\"></p></figure><p>图 2：威胁行为者测试公开暴露的 Ollama 端点，并尝试注册自己的模型</p><p><span>然而，在多起 LLMJacking 调查中，主要的初始访问向量一直是泄露或被盗的云身份令牌——包括 IAM 凭据、Service Account 密钥、GitHub Personal Access Tokens (PATs) 和活动会话令牌——威胁行为者利用这些令牌在目标组织的基础设施中建立初步据点。</span></p><p><span>例如，在 2026 年中，UNC6993 通过配置不当的 Service Account 密钥入侵了一个云实例，并利用该访问权限进一步访问 LLM API。UNC6993 还托管了一个冒充应用程序门户的会话劫持页面，以吸引一组 LLM 用户加入。该页面诱骗用户导航至合法的 LLM 服务网站，并粘贴包含活动访问令牌的原始 JSON 载荷，随后该载荷会被发布到后端 API，从而绕过密码和多因素身份验证 (MFA) 控制。</span></p><p><span>在另一起事件中，一名威胁行为者将被盗的 Personal Access Token (PAT) 与对容器化云环境中运行的某个软件包疑似 Web 应用程序漏洞的利用结合起来，通过 PAT 访问私有代码仓库并获得初始入口。同样，另一名威胁行为者利用企业用户被盗的 IAM 凭据，使用云联合身份令牌以编程方式生成新的访问密钥，从而绕过 MFA 要求。在另一起独立事件中，首次观察到威胁行为者使用具有广泛项目权限的被盗云 Service Account 密钥访问环境。</span></p><p><span>除常规云身份凭据外，威胁行为者还会以 LLM API 密钥为目标。例如，威胁行为者 opportunistically 从公开 GitHub 仓库中收集暴露的企业 LLM API 密钥。该组织展示了先进的规避技术，使用仅含单个令牌的最小化请求进行自动化凭据验证扫描（</span><code>max_tokens=1</code><span>）。这使威胁行为者能够隐蔽确认被盗密钥是否可用，同时避免被受害者的终端检测与响应 (EDR) 和 SIEM 容量异常告警发现。</span></p><h3 id=\"sec-3\"><span>横向移动与持久化</span></h3><p><span>在获得初步据点后，威胁行为者会有条不紊地提升权限、巩固访问权限并开展内部侦察，以确定目标并获取更多云凭据。</span></p><p><span>为扩大访问范围，威胁行为者枚举云服务、代码仓库和数据存储，以寻找敏感凭据。在一次入侵中，威胁行为者跨多个云区域开展内部侦察，以绘制可用服务和身份策略。在另一次入侵中，威胁行为者入侵了一个容器化云环境。进入该环境后，他们对代码仓库进行了广泛侦察，克隆敏感代码库以搜索硬编码机密、配置变量和开发者凭据。他们还扫描访问日志，以识别次级云环境的凭据。威胁行为者还执行有针对性的数据库查询以收集更多凭据；在一个案例中，威胁行为者查询了云数据仓库元数据表，搜索数据库凭据、管理员密码和敏感列，同时执行与定向数据窃取相关的云对象存储操作。</span></p><p><span>在多次入侵中，我们观察到威胁行为者滥用云身份权限和虚拟机配置来提升权限并维持持久访问。某威胁行为者利用与已受损工作负载关联的服务账户，通过令牌创建权限为高权限服务账户生成临时凭据，导致基础设施凭据、内部数据库密码和第三方 API 密钥从云密钥管理器中被外泄。其他威胁行为者则通过创建未经授权的 IAM 和服务账户，并向计算实例注入 SSH 密钥来建立持久性。具体而言，一名行为者通过将管理策略附加到服务角色来提升权限，创建具有完全管理员权限的未经授权 IAM 账户，并与运行中的虚拟机建立交互式管理会话，以将未经授权的 SSH 公钥注入主机配置文件。类似地，另一名威胁行为者创建了伪装成内部计费优化实用工具的欺骗性后门服务账户，并向计算实例元数据注入环境范围的 SSH 密钥。</span></p><p><span>除了利用传统云基础设施权限外，我们还观察到威胁行为者专门针对 LLM 路由软件中的漏洞实施权限提升。在一个案例中，后续攻击集群在从建立初始访问的威胁行为者处获取预先验证的 Virtual Keys 后，针对受害者的 LiteLLM 网关执行了有针对性的应用逻辑漏洞利用。该行为者利用 </span><span>/key/regenerate</span><span> 端点中的用户 ID 重新绑定漏洞（CVE-2026-40217），将标准 Virtual Keys 提升为完整的 </span><span>PROXY_ADMIN</span><span> 主管理员凭据，从而对已受损环境建立深入且持久的控制。</span></p><h3 id=\"sec-4\"><span>LLM 滥用</span></h3><p><span>LLMJacking 的最终目标是对基础模型进行变现和资源劫持，行为者通过令牌代理、自动化模型流式传输和 GPU 硬件配置来实现这一目标。</span></p><p><span>威胁行为者经常启用各种托管式生成平台，并创建额外的 API 密钥以扩大其行动规模。在获取 LLM API 访问密钥后，UNC6993 试图在受害者的云项目中生成额外的 API 密钥并启用相关服务，迅速累积了超过 100,000 美元的计费费用。另一名威胁行为者将受害者账户订阅到按量付费协议，选择高级基础模型并启动高吞吐量的推理流。为绕过速率限制，该威胁行为者部署了“烧毁并轮换”策略，持续创建和删除短期服务账户，同时审核云提供商的计费界面以监控财务影响。</span></p><p><span>威胁行为者还利用其访问权限托管自己的代理端点和智能体工作负载。例如，一名威胁行为者启用了智能体，部署了公开可访问的反向代理，并使用自定义 Node.js 代理捆绑包暴露与多个前沿 LLM 兼容的端点，并以一个名为 </span><code>D1337-KAIROS</code><span> 的人物品牌进行包装。该行为者使用 </span><a href=\"https://manus.im/\"><span>Manus</span></a><span> 智能体框架，将容器化后门部署到受入侵的云环境中；该后门查询上游 LLM，以推理指令并在本地执行生成的命令，同时由 </span><a href=\"https://github.com/searxng/searxng\"><span>SearXNG</span></a><span> 元搜索和 </span><a href=\"https://github.com/agent-infra/sandbox\"><span>agent-infra/sandbox</span></a><span> 执行环境提供支持。为了扩展计算资源，该威胁行为者配置了配备强大 GPU 的计算实例，尝试在多个区域启动高端硬件，并通过云提供商的 API 申请提高配额。该行为者还在外部服务器上托管了</span><a href=\"https://github.com/BerriAI/litellm\"><span> </span><span>LiteLLM</span></a><span> 网关，以管理和路由 API 流量。</span></p><p><span>GTIG 观察到，有证据表明威胁行为者并非仅将被劫持的计算资源用于自身运营，而是通过 LLM Mixer 出售对这些资源的访问权限，将被入侵的 API 配额变现。威胁行为者使用开源 API 网关和自定义中继基础设施来汇集被盗凭据、计量使用量并隐藏请求来源。例如，UNC6993 使用了 </span><a href=\"https://github.com/QuantumNous/new-api\"><span>new-api</span></a><span>（一个集中式模型中心和网关）以及 </span><a href=\"https://github.com/su-kaka/gcli2api\"><span>gcli2api</span></a><span>（一种将命令行界面（CLI）工具转换为标准前沿模型端点的 API 代理工具）等开源工具，可能用于聚合被盗密钥并在不同账户之间平衡请求负载。我们认为，该威胁行为者通过地下商铺出售对这些工具的访问权限。</span></p><p><span>另一名威胁行为者在不到八小时内执行了超过 500,000 次 LLM API 调用，并利用被盗的第三方 API 密钥为令牌路由服务</span><code> jet-night.com</code><span>提供支持。Jet Night 将近一百万美元的令牌成本转嫁给了受害组织。鉴于 Jet Night 向用户收取的每令牌成本远低于典型市场费率，GTIG 认为该服务依赖被盗密钥才能实现盈利。例如，Jet Night 提供每月约 60 美元的无限令牌套餐，据称可访问前沿模型，而此类面向消费者的服务通常每月需 100 至 250 美元。此外，该服务在其公开 Telegram 频道上宣传过多次中断，这很可能是因为受害组织发现各自遭到入侵后撤销了被盗密钥。</span></p><figure><p><img src=\"/dailyinfo/media/5da5da9cf0809433.webp\" loading=\"lazy\" decoding=\"async\" alt=\"https://storage.googleapis.com/gweb-cloudblog-publish/images/Figure_3_Screenshot_of_Jet_Night_Plans_and.max-1400x1400.png\"></p></figure><p>图 3：Jet Night 套餐和定价结构截图</p><p><span>一名威胁行为者部署了自定义代理中继基础设施（</span><code>ai-relay</code><span>），并托管在具有欺骗性的仿冒域名上。例如，他们注册了一个域名 </span><span>，冒充受害者的合法内部主机。这套自定义中继基础设施被用于将高价值的商业 LLM 访问权限无缝导入非法的 </span><code>newapi[.]pro</code><span> 转售生态，直接消耗受害者企业账户的配额，以服务其地下客户。</span></p><h3 id=\"sec-5\"><span>展望</span></h3><p><span>GTIG 预计，在新兴地下 LLM Mixer 的推动下，威胁行为者将日益优先考虑 LLMJacking，而非加密挖矿等传统资源窃取，因为前者能够实现即时且高利润率的变现。随着企业将更高层级的模型和智能体工作流集成到生产环境中，网络犯罪分子很可能会改进自动化侦察手段，攻击暴露的 API 令牌，并利用模型路由中间件中的漏洞。这种运营专业化将推动非法转售市场持续增长，使威胁行为者能够迅速耗尽企业配额，同时将费用转嫁给受害者，并在入侵被发现之前完成获利。</span></p><h3 id=\"sec-6\"><span>检测与威胁狩猎</span></h3><p><span>如果安全措施已经失效，防御方必须能够尽早发现对云端 LLM 平台的滥用。防御方应优先检测对 LLM 账户和服务的修改，并将任何未经授权的启用行为视为严重安全事件。在 Mandiant 调查的多起事件中，入侵发生时 LLM 服务并未启用。访问密钥的滥用使威胁行为者得以修改并启用 LLM API 服务（例如 Bedrock、Gemini API 等）。一旦启用，威胁行为者只需几分钟或几小时就能利用这些 API 为该组织产生巨额账单。&nbsp;</span></p><h3 id=\"sec-7\"><span>Google Security Operations</span></h3><p><span>Google Security Operations 客户可以通过 Cloud Threats、Mandiant Frontline Threats、Mandiant Hunting Rules 规则包访问这些宽泛类别的规则及更多内容。本博客文章中讨论的活动在 Google SecOps 中通过以下规则名称检测：</span></p><ul>\n<li>\n<p><span>AWS Account Key Creation</span></p>\n</li>\n<li>\n<p><span>AWS Create New Access Key</span></p>\n</li>\n<li>\n<p><span>AWS Create User Account</span></p>\n</li>\n<li>\n<p><span>AWS Delete User Account</span></p>\n</li>\n<li>\n<p><span>Base64 Encoded Shell Command Execution</span></p>\n</li>\n<li>\n<p><span>Create and Delete Firewall in Default Network</span></p>\n</li>\n<li>\n<p><span>GCE Project SSH Keys</span></p>\n</li>\n<li>\n<p><span>GCP Service Account Key Creation</span></p>\n</li>\n<li>\n<p><span>GCP Create New Service Account</span></p>\n</li>\n<li>\n<p><span>GCP Firewall Rule Created</span></p>\n</li>\n<li>\n<p><span>Linux Archive Exfiltration via Curl or Wget</span></p>\n</li>\n<li>\n<p><span>Persistence: Compute Set Instance or Project Metadata Startup Scripts or URLs</span></p>\n</li>\n</ul><h3 id=\"sec-8\"><span>缓解与修复</span></h3><p><span>为防止攻击者滥用 Cloud LLM 服务，防御方应优先关注身份与访问管理（IAM）和供应链安全，因为这是获取并滥用 Cloud 服务的两种最常见途径。&nbsp;</span></p><ul>\n<li>\n<p><strong>凭据卫生</strong><span>：使用集中式机密管理平台来控制敏感密钥和机密的管理与轮换。机密和密钥的自动化管理可以缩短泄露凭据的有效期。&nbsp;</span></p>\n</li>\n<li>\n<p><strong>最小权限</strong><span>：确保用户和服务账户仅拥有其特定角色及所需任务所必需的权限。拒绝所有未明确要求的权限，包括对 Cloud LLM 服务的访问权限。</span></p>\n</li>\n<li>\n<p><strong>代码监控</strong><span>：在代码库（GitHub、Gitlab 等）中自动执行机密扫描，确保添加到源代码中的 API 密钥和机密能够被及时识别并移除。&nbsp;</span></p>\n</li>\n<li>\n<p><strong>例行配置审计</strong><span>：定期对 Cloud 服务执行全面的配置审计，以识别潜在攻击路径和端点的意外暴露。&nbsp;</span></p>\n</li>\n<li>\n<p><strong>速率限制</strong><span>：实施类似 Google’s Cloud Armor 的 WAF，对各个客户端连接强制执行速率限制。</span></p>\n</li>\n<li>\n<p><strong>网络允许列表</strong><span>：在可行的情况下，通过 VPC 防火墙规则将云服务的出站连接限制为已知 IP 地址。</span></p>\n</li>\n<li>\n<p><strong>预算告警</strong><span>：对 LLM 服务实施精细的 API 配额，以限制每个模型的请求量。利用支出上限设置预算，避免超支。</span></p>\n</li>\n<li>\n<p><strong>多因素身份验证 (MFA)：</strong><span> 在所有云身份提供商、管理控制台和开发者平台上强制执行抗钓鱼的多因素身份验证，确保被盗凭据或会话令牌难以被利用。</span></p>\n</li>\n<li>\n<p><strong>影子 LLM 发现：</strong><span> 利用安全配置管理工具自动扫描混合云环境，识别未经授权或未受监控的工具、模型和基础设施，确保完整掌握模型部署情况。</span></p>\n</li>\n<li>\n<p><strong>精细的 API 密钥权限范围： </strong><span>按特定模型端点、环境（开发/生产）和使用限制对 API 密钥进行限制和分段，确保基础实用模型的令牌即使被盗，也无法用于调用费用高昂的高级前沿模型。</span></p>\n</li>\n<li>\n<p><strong>验证扫描监控：</strong><span> 监控模型网关和 API 访问日志中的异常低频请求（例如 </span><code>max_tokens=1</code><span> 或零温度探测请求）。攻击者经常使用此类微交易，在大规模基础设施滥用之前隐蔽地验证凭据。</span></p>\n</li>\n<li>\n<p><strong>漏洞与 ML 供应链补丁管理： </strong><span>在自定义应用程序代码、容器化工作负载和机器学习依赖项（如 PyTorch 和 Hugging Face 库）中集成自动化漏洞扫描（SAST/DAST/SCA），防止攻击者通过未修补的服务器漏洞获得初始访问权限。</span></p>\n</li>\n<li>\n<p><strong>网关补丁管理：</strong><span> 将漏洞管理计划扩展至集中式模型代理和路由网关（例如 LiteLLM），确保能够快速修补权限提升和身份验证绕过漏洞（例如 CVE-2026-40217）。</span></p>\n</li>\n<li>\n<p><strong>动态工作负载的沙箱执行：</strong><span> 如果你的 LLM 应用需要动态执行生成的代码或数据库查询，请在高度虚拟化、进程隔离的无服务器沙箱中隔离运行时环境。</span></p>\n</li>\n<li>\n<p><strong>经过审查的模型存储库： </strong><span>仅允许从可信的内部注册表或已批准的企业目录拉取模型和流水线依赖项，并强制执行此限制，防止开发者拉取包含预配置后门的受损模型。</span></p>\n</li>\n<li>\n<p><strong>基于图的暴露面建模： </strong><span>实施持续、基于图的风险优先级评估，将云资产、应用程序代码和数据流映射起来，自动识别并修复复杂的多跳攻击路径。</span></p>\n</li>\n<li>\n<p><strong>对抗性暴露验证：</strong><span> 部署自动化进攻代理，持续测试外部攻击面、发现暴露的端点并模拟凭据验证扫描。</span></p>\n</li>\n</ul><h4 id=\"sec-9\"><span>监控原生云审计日志&nbsp;</span></h4><ul>\n<ul>\n<li>\n<p><strong>AWS</strong><span>：监控 CloudTrail 日志中来自 </span><code>bedrock.amazonaws.com</code><span> 的 API 事件。基于历史上 LLM Jacking 事件的案例，在整个攻击生命周期中监控以下 API 操作：</span></p>\n</li>\n<ul>\n<li>\n<p><strong>资源利用</strong><span>：监控通过 </span><code>Converse</code><span>、</span><code>InvokeModel,</code><span> 和 </span><code>InvokeModelWithResponseStream</code><span> API 操作直接执行 LLM 的行为。</span></p>\n</li>\n<li>\n<p><strong>API 限流与错误峰值：</strong><span>监控 </span><code>ThrottlingException</code><span>、</span><code>ValidationException</code><span> 或 </span><code>ResourceNotFoundException</code><span> 错误量是否出现高峰，这可能表明有自动化“喷洒”方法正在针对云基础设施。</span></p>\n</li>\n<li>\n<p><strong>目标范围确定</strong><span>：监控潜在的侦察活动，识别通过 </span><code>ListFoundationModels,ListInferenceProfiles</code><span> 和 </span><code>GetFoundationModelAvailability</code><span> 操作发现的可用模型。此外，还要监控通过 </span><code>PutUseCaseForModelAccess</code><span> 和 </span><code>CreateFoundationModelAgreement</code><span> API 操作尝试解锁环境中新模型的行为。</span></p>\n</li>\n<li>\n<p><strong>安全/规避</strong><span>：审查试图查看、修改或禁用日志配置以隐藏提示内容并逃避检测的行为。监控 </span><code>GetModelInvocationLoggingConfiguration</code><span> 操作，以及 </span><code>PutModelInvocationLoggingConfiguration</code><span> 和 </span><code>DeleteModelInvocationLoggingConfiguration</code><span>。任何非 IaC（基础设施即代码）主体为禁用日志而发起的调用都应视为严重程度高。</span></p>\n</li>\n</ul>\n</ul>\n</ul><p><strong>自动化工具：分析 User-Agent 字符串，识别直接与目标云基础设施交互的自动化工具和 SDK（例如 claude-cli、aws-sdk-rust 和 aws-sdk-go-v2）。</strong></p><ul>\n<li>\n<p><strong>Azure</strong><span>：监控 Azure Activity Logs（控制平面）和 Diagnostic Logs（数据平面）中与 </span><code>Microsoft.CognitiveServices</code><span> 命名空间相关的事件。要搜寻或检测 LLM Jacking 事件，请监控以下操作：</span></p>\n</li>\n<ul>\n<li>\n<p><strong>资源利用</strong><span>：监控直接执行 LLM 的行为。在 Azure 中，模型调用发生在数据平面，且需要启用 Diagnostic Logs。留意向 Completions 或 Chat Completions API 等推理端点发起的大量 POST 请求。在管理平面（Activity Logs）上，监控通过 </span><code>Microsoft.CognitiveServices/accounts/deployments/write</code><span> 操作未经授权创建新实例的行为。</span></p>\n</li>\n<li>\n<p><strong>目标范围确定</strong><span>：监控潜在的侦察活动，识别通过 </span><code>Microsoft.CognitiveServices/accounts/read</code><span> 和 </span><code>Microsoft.CognitiveServices/accounts/deployments/read</code><span> 操作发现的可用 Azure LLM 资源、模型和部署。</span></p>\n</li>\n<li>\n<p><strong>安全/规避</strong><span>：审查通过 </span><code>Microsoft.Insights/diagnosticSettings/read</code><span>、</span><code>Microsoft.Insights/diagnosticSettings/write</code><span> 或 </span><code>Microsoft.Insights/diagnosticSettings/delete</code><span> 操作查看或修改日志配置（以确认数据平面模型调用是否正被记录）的尝试。</span></p>\n</li>\n</ul>\n<li>\n<p><strong>GCP</strong><span>：监控 Cloud Audit </span><a href=\"https://cloud.google.com/logging/docs/audit\"><span>Logging</span></a><span> 中对 Gemini Enterprise Agent Platform 端点（aiplatform.googleapis.com）的调用。Gemini Enterprise Agent Platform 推理操作包含在 Data Access 日志中；由于日志量及摄取成本，这些日志默认处于禁用状态。您必须手动配置 IAM 审计策略以跟踪这些操作。</span></p>\n</li>\n<ul>\n<li>\n<p><strong>启用 Agent Platform 服务</strong><span>：</span><a href=\"https://docs.cloud.google.com/service-usage/docs/audit-logging\"><span>Alert</span></a><span>，以发现通过 </span><code>google.api.serviceusage.v1.ServiceUsage.EnableService</code><span> 方法启用 Gemini Enterprise Agent Platform 服务的行为。</span></p>\n</li>\n<li>\n<p><strong>资源利用</strong><span>：监控通过 Gemini Enterprise Agent Platform 直接执行 LLM 的情况，这需要启用 Data Access 审计日志。寻找 </span><code>google.cloud.aiplatform.v1.PredictionService.Predict</code><span>、</span><code>google.cloud.aiplatform.v1.PredictionService.GenerateContent</code><span> 和 </span><code>google.cloud.aiplatform.v1.PredictionService.StreamGenerateContent</code><span> 操作。</span></p>\n</li>\n<li>\n<p><strong>目标范围确定</strong><span>：监控潜在的侦察活动，以通过 </span><code>google.cloud.aiplatform.v1.ModelService.ListModels</code><span>、</span><code>google.cloud.aiplatform.v1.EndpointService.ListEndpoints</code><span> 和 </span><code>google.cloud.aiplatform.v1.PublisherModelService.ListPublisherModels</code><span> API 操作发现可用模型和终结点。</span></p>\n</li>\n<li>\n<p><strong>安全/规避</strong><span>：审查查看或更改日志记录及审计配置的尝试。监控诸如 </span><code>google.iam.v1.IAMPolicy.GetIamPolicy</code><span>（用于检查项目/资源上是否启用了 Data Access 日志）等操作，或通过 </span><code>google.logging.v2.ConfigServiceV2.ListSinks</code><span> 和 </span><code>google.logging.v2.ConfigServiceV2.GetSink</code><span> 审查日志导出的尝试。</span></p>\n</li>\n</ul>\n</ul><h3 id=\"sec-10\"><span>失陷指标（IOC）</span></h3><p><span>为帮助更广泛的社区追踪并识别本篇博客文章中概述的活动，我们为注册用户提供了一个 </span><a href=\"https://www.virustotal.com/gui/collection/4377d2403ea17a04744ca871113c1313b0162f190f0b785f5a10b744e8528245/iocs\"><span>GTI Collection</span></a><span>，其中包含失陷指标（IOC）。</span></p><h4 id=\"sec-11\"><span>网络指标</span></h4><table>\n<tbody>\n<tr>\n<td>\n<p><strong>指标</strong></p>\n</td>\n<td>\n<p><strong>描述</strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<p><span>jet-night.com</span></p>\n</td>\n<td>\n<p><span>LLM Mixer</span></p>\n</td>\n</tr>\n<tr>\n<td>\n<p><span>newapi.pro</span></p>\n</td>\n<td>\n<p><span>LLM Mixer</span></p>\n</td>\n</tr>\n</tbody>\n</table><p><span>表 1：网络指标</span></p><p><span>发布于</span></p><ul><li><a href=\"https://cloud.google.com/blog/topics/threat-intelligence\">威胁情报</a></li></ul>","original","zhKind","translation","complete","数据窃取","供应链","大模型","Google","AWS","Microsoft","https://cloud.google.com/blog/topics/threat-intelligence/llmjacking-monetizing-compromised-cloud-models/","Google Cloud 威胁情报",{"_135":136,"_137":-5},"changelogVersion","2026-10-01T08:00","release"]
