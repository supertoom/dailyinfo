[{"_1":2,"_3":4},"root",{"_5":101},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795653637000,"id","fl87knzyahqtv4qern9fg60cf","title","1Password 称攻击者复制部分客户账户数据，客户保险库未受影响","originalTitle","1Password Says Hacker Copied Customer Account Data, Vaults Unaffected","summary","1Password 称，攻击者利用一名员工的 GitHub 账号向内部服务推送恶意代码，复制了部分客户的姓名、登录邮箱、账户与用户 ID、创建及最后登录时间、公钥和账户元数据，并从私有仓库获取源代码。","reason","source",{"_73":100},"links",{"_61":99},"publishedAt","2026-11-25T21:19:49.000Z","discoveredAt","2026-11-25T21:26:24.325Z","timelineAt","category","activity","tags",[74,96,97,98,76],"score",58,"selected",false,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","Waqas","body",{"_92":-5,"_61":93,"_94":-5,"_95":36},"outline",[83,84],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","f5WaBrBT7k4M","reportCount",1,"additionalSourceCount",0,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","attack","name","攻击活动","identity","身份与访问","supply-chain","供应链安全",{"_80":81,"_13":82},"publicId","bb557fad-4614-4000-8e00-bc153b15ba76","1Password披露员工账号被攻破致客户数据外泄",{"_11":90,"_86":91,"_88":89},{"_11":85,"_86":87,"_88":89},"sec-2","text","1Password says customers do not need to change their passwords","level",3,"sec-1","Some invitation and recovery links were affected","zh","<p>Password manager <strong><a href=\"https://hackread.com/tag/1Password/\">1Password</a> </strong>said on November 25 that a hacker copied account information belonging to some customers, including names and email addresses used to sign in. The company said the hacker did not access customer vaults, the passwords and other items stored in them, or the encryption keys that protect them. It did not say how many customers were affected.</p><p>1Password said in its incident notice that it began investigating on November 19 after finding signs that someone had gained access to an employee’s corporate GitHub account. The attacker used the account to push malicious code to internal services and copy customer records. </p><p>The unknown attackers also copied source code from private repositories and gained access to the system 1Password uses to build and deploy software. The company said the source code contained no customer secrets. </p><h3 id=\"sec-1\"><strong>Some invitation and recovery links were affected</strong></h3><p>Along with names and email addresses, the copied records included account and user IDs, account creation and last sign-in times, public keys and other account metadata. The records also contained tokens from some emailed links used to invite users, set up accounts or recover access. 1Password said in its <a href=\"https://1password.com/blog/update-on-nov-2026-security-incident\"><strong>blog post</strong></a> that it notified the small number of users whose provisioning or recovery tokens were affected.</p><p>Anyone holding one of those tokens would still need to sign in through the organisation’s single sign-on system or enter a verification code sent to the registered email address, 1Password said. The company found no evidence that the exposed tokens were used to take over accounts and changed the verification codes from six digits to ten letters and numbers. The public keys in the copied records are separate from the keys that protect customer vaults.</p><figure><a href=\"https://hackread.com/wp-content/uploads/2026/11/1password-attacker-copied-customer-account-data-vaults.png\"><img width=\"876\" height=\"664\" src=\"/dailyinfo/media/f636f4d4df1fed1e.webp\" srcset=\"/dailyinfo/media/911bec10dc8ee91c.webp 720w, /dailyinfo/media/5cfdcf1bb5b38acb.webp 1200w, /dailyinfo/media/f636f4d4df1fed1e.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"1Password Says Attacker Copied Customer Account Data, Vaults Unaffected\"></a><figcaption>1Password on X explaining the incident</figcaption></figure><h3 id=\"sec-2\"><strong>1Password says customers do not need to change their passwords</strong></h3><p>1Password disabled the affected GitHub account, revoked the stolen token and restored clean versions of the affected service. It also replaced or revoked internal credentials that could have been exposed and brought in independent cybersecurity experts to review its response. The company said its apps and services were operating normally.</p><p>Customers do not need to change their passwords or update their accounts because of the incident, 1Password said. It advised treating unexpected invitations and account recovery messages with caution. If one arrives, open 1Password directly to check it. The company says it will never contact customers to ask for their account password or Secret Key.</p>","zhKind","complete","数据泄露","供应链投毒","凭据","https://hackread.com/1password-attacker-copied-customer-account-data-vaults/","Hackread",{"_102":103,"_104":-5},"changelogVersion","2026-10-01T08:00","release"]
