[{"_1":2,"_3":4},"root",{"_5":91},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":-5,"_56":57,"_58":59},"expiresAt",1795740048000,"id","tw1sqonucogwlek1xpza88mc0","title","美国 CIA 开源情报系统疑遭 AI 驱动的 ARTEX 渗透测试智能体入侵","originalTitle","AI攻击火力太猛！美国中情局系统也被入侵了","summary","身份不明的攻击者使用 AI 驱动的 ARTEX 渗透测试框架入侵美国中央情报局（CIA）开源情报（OSINT）分析系统，并波及 ODNI 和美国国家地理空间情报局。","reason","文章梳理了 AI 驱动的 ARTEX 渗透测试智能体对多个美国政府机构的入侵事件，可用于了解当前政府系统面临的新型自动化攻击风险。","source",{"_69":90},"links",{"_84":89},"publishedAt","2026-11-26T09:55:28.909Z","discoveredAt","2026-11-26T10:41:28.915Z","timelineAt","category","activity","tags",[70,72,87,88,76,82],"score",78,"selected",true,"channel","news","story","x","readingMode","full","author","body",{"_59":83,"_84":-5,"_85":84,"_86":37},"outline",[],"relatedStories",[],"topics",[60,61,62,63,64,65,66],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","zh",{"_67":81,"_69":82},{"_67":79,"_69":80},{"_67":77,"_69":78},{"_67":75,"_69":76},{"_67":73,"_69":74},{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","attack","name","攻击活动","ai-offense","AI 攻防","ai-agent","AI Agent 安全","incident","应急响应","black-market","数据窃取与黑产","ransomware","勒索软件","cisa","CISA","<p>\n                    继欧盟委员会、梭子鱼、Railway等知名机构后，美国中情局也被ARTEX渗透测试智能体入侵了，CIA已承认旗下非密开源情报系统遭到入侵，并波及ODNI等其他情报机构；美国财政部金融犯罪执法网络随后也披露遭入侵，其出于审慎考虑已紧急关闭了该系统：近一个多月来，类ARTEX渗透测试智能体开始流行，全球出现了成百上千个攻击事件和受害组织，欧盟CERT、美国FBI等均发布警告，提醒防范此类攻击。\n                </p><p>前情回顾·AI网络攻击火力全开</p><ul><li><p><a href=\"https://www.secrss.com/articles/95838\">AI攻击杀疯了！欧盟委员会内部管理系统因此中断超10天</a></p></li><li><p><a href=\"https://www.secrss.com/articles/95777\">AI攻击火力太强，知名网络安全公司也被入侵了！</a></p></li><li><p><a href=\"https://www.secrss.com/articles/95054\">知名AI开发平台发生数据泄露，呼吁所有用户更换托管密钥</a></p></li><li><p><a href=\"https://www.secrss.com/articles/95743\">谷歌警告：AI全自动网络攻击将在半年内到来</a></p></li></ul><p>安全内参11月26日消息，据知情人士透露，身份不明的攻击者入侵了美国中央情报局（CIA）的一套开源情报（OSINT）分析系统。</p><p>纽约时报援引知情人士消息称，此次网络攻击使用了AI驱动的ARTEX渗透测试框架，同时波及美国国家情报总监办公室（ODNI）和美国国家地理空间情报局。</p><p>目前，CIA和ODNI尚未回应进一步置评请求。不过，此次入侵并未导致任何机密数据或系统泄露。</p><p>知情人士表示：“此次攻击未涉及机密网络或机密信息，目前也没有其他系统面临风险。”</p><p><strong>美国财政部系统也被入侵了</strong></p><p>CIA系统遭入侵的消息披露数小时后，美国财政部金融犯罪执法网络（FinCEN）也表示，该机构正在调查一起网络安全事件。攻击者未经授权访问了其部分系统，但涉及范围有限。</p><p>发现攻击后，FinCEN出于防范考虑，暂时关闭了部分系统，并通知各银行通过金融机构热线提交报告，因为部分服务可能暂时无法使用。</p><p>一名FinCEN官员表示：“财政部正与美国联邦调查局（FBI）、美国网络安全和基础设施安全局（CISA）以及第三方取证调查人员合作，以确定此次事件的范围及影响。在调查期间，作为主动防范措施，我们已暂时关闭FinCEN的部分系统，并为因系统中断而无法提交报告的申报机构提供了例外豁免。”</p><p>目前取证分析仍在进行，但尚无证据表明受益所有权数据库或《银行保密法》相关系统遭到入侵。</p><p>FinCEN是美国财政部负责打击金融犯罪的部门，也是美国官方金融情报机构（FIU）。该机构通过与美国国内及国际执法机构共享金融情报，保护美国金融体系免受非法活动侵害。</p><p>就在一周前，美国国家安全局（NSA）的机密网络也曾发生持续数日的服务中断。不过，该机构将此次中断归因于按计划开展的例行维护，并表示其执行关键任务的能力始终保持正常运行。</p><p><strong>美国政府机构接连成为网络攻击目标</strong></p><p>近年来，美国多个联邦政府机构相继遭遇网络攻击。CIA和FinCEN此次披露的事件，是这一系列攻击的最新案例。</p><p>两年前，黑客组织Silk Typhoon入侵了美国财政部外国资产控制办公室（OFAC）。该办公室负责实施美国的经济和贸易制裁计划。</p><p>该组织还入侵了美国财政部金融研究办公室（OFR），据称还渗透了美国外国投资委员会（CFIUS）。该委员会隶属于美国财政部，负责审查外国投资可能带来的国家安全风险。</p><p>上周末，黑客据称入侵了美国联邦调查局的国家犯罪信息中心（NCIC）。目前尚不清楚攻击者如何获取系统访问权限，也不清楚入侵发生的具体时间，以及攻击者是否从受影响系统中窃取信息。</p><p>此前，勒索组织ShinyHunters曾声称入侵了FBI的招聘网站FBIJobs.gov。此事促使FBI展开调查，并最终逮捕了多名疑似与ShinyHunters有关联的人员，其中包括一名据称与此次攻击有关联的加拿大网络安全企业高管。</p><p><strong>参考资料：bleepingcomputer.com</strong></p><p>声明：本文来自安全内参，版权归作者所有。文章内容仅代表作者独立观点，不代表安全内参立场，转载目的在于传递更多信息。如有侵权，请联系 anquanneican@163.com。</p>","original","zhKind","complete","大模型","数据窃取","https://www.secrss.com/articles/96026","安全内参",{"_92":93,"_94":-5},"changelogVersion","2026-10-01T08:00","release"]
