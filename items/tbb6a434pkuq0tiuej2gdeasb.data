[{"_1":2,"_3":4},"root",{"_5":108},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794185106000,"id","tbb6a434pkuq0tiuej2gdeasb","title","Keystone 硬件钱包验证密钥泄露，将销毁 18,835 台未售设备","originalTitle","Keystone to Destroy 18,835 Hardware Wallets After Hackers Steal Device Verification Key","summary","Keystone 表示，攻击者利用其网站所用第三方数据监控工具的漏洞提升权限，窃取硬件钱包设备验证密钥及客户数据。持旧密钥的仿冒设备可通过在线验证，可能导致加密资产被盗，但事件未涉及恢复短语或钱包私钥。","reason","事件同时涉及设备验证密钥泄露和客户记录泄露，分发日期决定了不同设备的安全判断与处置方式。","source",{"_74":107},"links",{"_99":106},"publishedAt","2026-10-27T11:46:00.000Z","discoveredAt","2026-10-28T09:02:45.247Z","timelineAt","category","activity","tags",[75,103,104,105,77],"score",73,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_61":98,"_99":-5,"_100":101,"_102":37},"outline",[86,87,88],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fNGiNyVVSK08","reportCount",1,"additionalSourceCount",0,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","attack","name","攻击活动","incident","应急响应","crypto","密码学","identity","身份与访问",{"_83":84,"_13":85},"publicId","e966e0dc-a748-43b0-a632-9e9b6666138e","Keystone硬件钱包验证密钥泄露",{"_11":96,"_90":97,"_92":93},{"_11":94,"_90":95,"_92":93},{"_11":89,"_90":91,"_92":93},"sec-3","text","Keystone 设备所有者应采取的措施","level",3,"sec-2","客户记录","sec-1","设备检查的工作方式","<p><span><i></i><span>Swati Khandelwal</span><i></i><span>2026年10月27日</span></span><span>加密货币 / 数据泄露</span></p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgkvGXPUhZZjWBsYYBAx8KeJ8WilsBMLE-JhqfNAEyCOPuxs6-4VIF1e77IHR5zVdGfRsjJkSOfUVE1JaEmKe0mSAVM-ha4SeROxEGAdkLY5n5rBqx1LBSm6UVxA167sJYZEJTRra7BSipFtdlw2S-kFCUOSa9n70NbfSka3zRNVHd0D69qbVpSGIOnuAU/s1600/keystone.jpg\"><img alt=\"\" src=\"/dailyinfo/media/380d5785b36e5a2c.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>该公司在<a href=\"https://x.com/KeystoneWallet/article/2114719318722404578\">声明</a>中表示，10月26日，一名攻击者入侵了 Keystone 的网站，并获取了其硬件钱包用于证明设备真伪的密钥。</p><p>掌握该密钥的人可以制造出通过 Keystone 所有者用于验证设备真伪的在线检查的仿冒设备。购买仿冒设备的买家可能会被盗取加密货币，但此次事件并未涉及所有者的恢复短语或钱包私钥。</p><p>Keystone 将销毁 18,835 台携带该密钥的未售设备，所有新设备都将获得新密钥。</p><p>Keystone 于 10月20日发现了未经授权的访问，其向所有者提出的建议取决于设备收到的时间。对于在该日期之后收到且仍使用旧密钥的设备，公司表示：“即使此类设备通过身份验证，我们也无法完全排除它是仿冒品的可能性。”</p><p>此类设备的所有者应联系 Keystone 客服，并且只有在公司确认设备为正品后才能使用。</p><p>据 Keystone 表示，在 10月20日之前送达且通过检查的设备可视为正品并正常使用。该公司尚未说明攻击者最初何时入侵。</p><p>据公司介绍，攻击者利用了 Keystone 网站所用第三方数据监控工具中的漏洞来提升权限，使攻击者得以获取客户数据和密钥。</p><p>Keystone 于 10月20日阻止了攻击者的访问，并已修复该漏洞。公司尚未说明密钥存储在何处。</p><h3 id=\"sec-1\">设备检查的工作方式</h3><p>所有者使用设备扫描 Keystone 验证页面上的二维码，然后在页面上输入设备显示的代码。</p><p>在<a href=\"https://github.com/KeystoneHQ/keystone3-firmware/blob/3690bf1f36cb9e817f9a2412a9fc7560c08953f0/rust/rust_c/src/common/web_auth.rs\">Keystone 的开源固件</a>中，二维码以加密形式携带该代码，设备使用其存储的密钥进行解密。因此，正确的代码表明设备持有该密钥。</p><p>该密钥仅用于此项检查。它不参与创建恢复短语、派生私钥或签署交易。</p><p>任何持有该密钥副本的人都可以生成正确的代码，因此，携带该密钥的仿冒设备能够通过检查。Keystone 表示，此类设备可能被销售或运送给客户，从而导致客户的加密货币被盗。该公司尚未报告任何仿冒设备或盗取事件。</p><p>该密钥在制造过程中写入每台设备，无法被擦除或重写。固件将其保存在内存中，该内存只能写入一次，并且<a href=\"https://github.com/KeystoneHQ/keystone3-firmware/blob/3690bf1f36cb9e817f9a2412a9fc7560c08953f0/src/presetting.c\">拒绝接受第二个密钥</a>。因此，已经制造的设备无法更换为新密钥。</p><h3 id=\"sec-2\">客户记录</h3><p>Keystone 首次<a href=\"https://x.com/KeystoneWallet/status/2114054080754770137\">披露此次数据泄露</a>是在 10月24日，当时称某第三方获取了客户的收货信息。</p><p>公司于 10月26日表示，此次事件影响了 25,964 条买家记录，涉及 2024年至2026年间在 Keystone 网站上进行的购买。这些记录包含姓名、联系方式、收货地址和订单详情。Keystone 的在线商店运行在 Shopify 上，由 Shopify 存储和管理这些记录。</p><p>Keystone 表示，支付卡和银行信息以及政府签发的身份证件号码均未涉及。来自 Amazon 和 Keystone 其他销售渠道的购买记录也未受影响。</p><p>作为预防措施，Keystone 还在其应对措施中纳入了 12,873 条未付款的结账记录。这些记录包含从未完成的购买中的姓名、联系方式和收货信息。</p><p>部分受影响的数据本应已被删除。Keystone 曾<a href=\"https://keyst.one/privacy-promises\">承诺在每笔订单后 180 天删除配送信息</a>。</p><p>Keystone 开发了一款用于批量删除记录的工具，但该工具无法可靠运行。部分删除操作失败，而 Keystone 未能在及时发现这些失败情况。</p><p>Keystone 将保留客户个人数据的期限从 180 天缩短至 90 天，并立即生效。它已要求 Shopify 删除超过 90 天的买家个人数据，并预计于 11 月 3 日完成。截至 10 月 27 日，其<a href=\"https://keyst.one/privacy-policy\">隐私政策</a>仍列明为 180 天。</p><p>Keystone 正在向受影响的客户发送电子邮件，并计划推出一个页面，供人们检查自己的信息是否受到影响。</p><h3 id=\"sec-3\">Keystone 设备所有者应采取的措施</h3><p>Keystone 的指引涵盖以下情况：</p><ul>\n  <li><strong>在 10 月 20 日前收到：</strong>通过检查的设备可以正常使用。</li>\n  <li><strong>在 10 月 20 日后收到且使用旧密钥：</strong>在 Keystone 支持团队（support@keyst.one）确认设备为正品之前，请勿使用该设备。Keystone 已告知这些所有者按照其<a href=\"https://keyst.one/authentication\">设备验证页面</a>上的说明操作，但截至 10 月 27 日，该页面并未显示任何此类说明。Keystone 尚未说明如何辨别设备使用的是哪种密钥，也未说明已经向此类设备发送加密货币的所有者应采取什么措施。</li>\n  <li><strong>等待 Keystone 网站的订单：</strong>&nbsp;在配备新密钥的设备准备好之前，发货已暂停。截至 10 月 27 日，&nbsp;商店将 Keystone 3 Pro&nbsp;列为预售商品，预计将在 4 至 6 周内发货。</li>\n  <li><strong>通过 Amazon 或经销商购买：</strong>&nbsp;同样的说明适用，因为这是根据设备到达的时间而定，而不是根据购买地点。Keystone 通过 Amazon 官方商店和&nbsp;授权经销商销售产品。Keystone 尚未说明配备旧密钥的设备是否仍在这些渠道销售。</li>\n  <li><strong>已经使用 Keystone 持有加密货币：</strong>Keystone 表示，所有者不会仅因此次事件而需要转移加密货币。对于在 10 月 20 日后收到且使用旧密钥的设备，仍应遵循上述步骤。</li>\n  <li><strong>诈骗信息：</strong>任何提出退款、更换设备、召回、钱包验证或协助转移加密货币的电话、短信、电子邮件或信件都应视为诈骗。Keystone 不会要求任何人退回设备。切勿将恢复短语输入并非自己订购的设备，请在浏览器中输入 keyst.one，不要点击链接。</li>\n</ul><p>觉得这篇文章有趣吗？在 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a> 上关注我们，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","数据泄露","凭据","加密","https://thehackernews.com/2026/10/keystone-to-destroy-18835-hardware.html","The Hacker News",{"_109":110,"_111":-5},"changelogVersion","2026-10-01T08:00","release"]
