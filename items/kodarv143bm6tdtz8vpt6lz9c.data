[{"_1":2,"_3":4},"root",{"_5":117},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794530487000,"id","kodarv143bm6tdtz8vpt6lz9c","title","APT29 关联黑客劫持 Plerdy SEO Tracker 投递 iOS 与 Android 利用链","originalTitle","APT29-Linked Hackers Hijack Web Analytics Script to Deliver iOS and Android Exploits","summary","Sekoia 称，俄罗斯关联威胁组织 APT29 借被入侵网站、仿冒域名和乌克兰 Plerdy SEO Tracker 供应链攻击开展名为 Poisoned Source 的水坑活动，向 iOS 与 Android 用户投递 N-day 利用链并窃取浏览器 Cookie、Wi-Fi 密码及移动设备数据。","reason","文章梳理了针对 iOS 和 Android 用户的投递方式、利用链与数据窃取目标，还给出了具体 CVE 和感染基础设施，便于防守方识别关联活动。","source",{"_78":116},"links",{"_105":115},"publishedAt","2026-11-04T14:27:52.000Z","discoveredAt","2026-11-04T14:52:23.782Z","timelineAt","category","activity","tags",[81,83,109,79,110,111,112,113,114],"score",90,"selected",true,"channel","news","story",{"_95":96,"_13":97},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_61":104,"_105":-5,"_106":107,"_108":37},"outline",[98],"relatedStories",[94],"topics",[68,69,70,71,72,73,74,75],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fXyhK-3RT7MM","reportCount",5,"additionalSourceCount",4,{"_76":92,"_78":93},{"_76":90,"_78":91},{"_76":88,"_78":89},{"_76":86,"_78":87},{"_76":84,"_78":85},{"_76":82,"_78":83},{"_76":80,"_78":81},{"_76":77,"_78":79},"slug","malware","name","恶意软件","attack","攻击活动","exploited","在野利用","black-market","数据窃取与黑产","ransomware","勒索软件","supply-chain","供应链安全","apple","Apple / 苹果","google","Google / 谷歌",{"_95":96,"_13":97},"publicId","352997e0-2d27-4c1e-987d-d4a4e0c4e473","APT29水坑攻击移动端漏洞链",{"_11":99,"_100":101,"_102":103},"sec-1","text","Coruna 和 DarkSword 工具包 evolves","level",3,"<p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhx1cus2o8fkYGLhQu9BfPgGtAUwnmTAMucLagfAodBuRoYnyxGIJKgpqtKFyCSV-WSG3pDqmPujhj-iwoOZB-zF8JjbQMrLzDHYtdTPA3hD3Kc3rqYQM4CQwkICwZkh8K6O8ZSt-WAA_PBoUA6lHwh_55dbDlKizsjzcTN847c9BSHsWHmrAP42JHRHIYS/s1600/ios-exploit.jpg\"><img alt=\"\" src=\"/dailyinfo/media/302f6ce06e87ab38.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>据称，与俄罗斯有关联的威胁行为者 <strong><a href=\"https://thehackernews.com/2026/09/russian-state-sponsored-hackers-use.html\">APT29</a></strong> 策划了一场大规模“水坑”攻击活动，通过受入侵网站、虚假域名，以及涉及乌克兰网络分析服务 Plerdy SEO Tracker 的供应链攻击，针对 iOS 和 Android 用户。</p><p>“注入的 JavaScript 代码会收集浏览器和设备属性，”Sekoia 研究人员 Amaury-Jacques Garçon 和 Félix Aime <a href=\"https://www.sekoia.com/blog/poisoned-source-apt29-watering-holes-targets-mobile-devices-with-n-day-exploits\">表示</a>。“随后，投递基础设施会提供针对 iOS 或 Android 的特定平台 N-day 漏洞利用链。”</p><p>这些攻击的最终目标是提供能够窃取浏览器 Cookie 的载荷，在某些情况下还会窃取 Wi-Fi 密码或完整的移动设备数据。法国网络安全公司于 2026 年 10 月中旬发现了这项代号为 <strong>Poisoned Source</strong> 的活动。</p><p>这场攻击活动的显著特点是使用了三种感染途径——</p><ul>\n  <li>入侵合法网站并注入恶意 JavaScript</li>\n  <li>冒充美国（“america250[.]holiday”）、乌克兰、捷克共和国和保加利亚知名网站的仿冒网站</li>\n  <li>在 2026 年 8 月 27 日至 9 月 3 日期间入侵 Plerdy SEO Tracker 的供应链，向“a.plerdy[.]com/public/js/click/main.js”注入恶意代码</li>\n</ul><p>受入侵的网站包括一个代表美国化学工业企业的主要行业协会、一个欧洲极右翼政党，以及一个与保加利亚军方有关的网站。据怀疑，这场“水坑”攻击活动的设计目标可能是针对特定个人，而非广泛撒网。</p><p>Sekoia 表示：“目前尚不清楚攻击者是打算针对特定网站的访问者，还是试图尽可能多地入侵未打补丁的移动设备 indiscriminately，在选择性识别并利用感兴趣的信息之前不加区分地外传数据。”</p><p>“然而，在俄乌战争背景下，这些网站中有几个很可能会吸引高价值或具有战略重要性的访问者。此次供应链攻击通过一些高价值目标扩散，例如军队、特种部队和军事装备（弹道、无人机）相关网站。”</p><p>无论采用何种方法，最终都会导向同一种载荷：一个用于识别访问者设备和 Web 浏览器的 JavaScript 加载器，随后提供相应的下一阶段恶意软件。对于 iOS 用户，它会导向名为 <a href=\"https://thehackernews.com/2026/10/p7-darksword-ios-exploit-kit-adds.html\">DarkSword</a> 的漏洞利用工具包，用于窃取 Cookie 和完整的设备数据。</p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEj1gix4SmQm_jM9qMXTtYAZmHytbZiqdI9oY7Q9XoBMqYEw6Q7Scy3ta6jWCNBL6EZrqz0yrl3wvXCOcJeVJjnKYyBjgxPv2V36FzOtKqvct4UobMrtDAASoGz94BTVQOH8w9c2zMyqDcw8QAQybAYWY4mwx3cHQUEjn3ZtIJQDkqQMJQGMKKMGwnS3LjPm/s1600/sek-1.jpg\"><img alt=\"\" src=\"/dailyinfo/media/07ee13830a9c5882.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>在 Android 上，该恶意软件能够在不建立持久化的情况下外传 Chrome 数据和 Wi-Fi 密码。目前已识别出至少三种不同的漏洞利用——</p><ul>\n  <li><strong>Class A</strong>，针对运行 iOS 16.7 的 iOS 设备，利用 CVE-2025-43529（DarkSword 所利用的同一漏洞）和 CVE-2024-27834，交付用于窃取 Cookie 的 JavaScript 恶意软件。</li>\n  <li><strong>Class B</strong>，针对运行 iOS 18.5 的 iOS 设备，利用包含 CVE-2025-43529、CVE-2026-20700、CVE-2025-14174、CVE-2025-43510 和 CVE-2025-43520 的 <a href=\"https://thehackernews.com/2026/03/darksword-ios-exploit-kit-uses-6-flaws.html\">DarkSword exploit chain</a>，投放 JavaScript 恶意软件，以完全窃取设备数据。这包括 SMS 消息和 iMessages；Apple Mail Envelope Index 和 Protected Index SQLite 数据库；语音信箱；WhatsApp 和 Telegram 数据库；iCloud 钥匙串、Wi-Fi 密码；联系人；通话记录；Safari 浏览历史记录和 Cookie；照片；以及 Apple Health、日历、备忘录和 iCloud Drive 中的数据。</li>\n  <li><strong>Class C</strong>，针对运行 Chrome 139 至 145 版本的 Android 设备（但出于目前尚不明确的原因，明确排除 143 版本），利用 <a href=\"https://thehackernews.com/2026/03/google-fixes-two-chrome-zero-days.html\">CVE-2026-3910</a> 和 <a href=\"https://thehackernews.com/2025/06/qualcomm-fixes-3-zero-days-used-in.html\">CVE-2025-27038</a> 来实现远程代码执行、沙箱逃逸和权限提升，最终投放 AndroSnitch，以收集 Chrome 数据和 Wi-Fi 密码。</li>\n</ul><p>在所有三种情况下，被窃取的数据都会发送至 \"ad.starx-net[.]com:8881/telemetry/v12\" 端点。Android 攻击链会检查目标设备的型号标识符（即 SM-S938B），以确定其是否为 Samsung Galaxy S25 Ultra。如果设备匹配，则终止漏洞利用活动。</p><p>AndroSnitch 的名称源于它与 <a href=\"https://thehackernews.com/2024/08/russian-hackers-exploit-safari-and.html\">ANDROSNATCH</a> 的相似之处。后者是一种窃取 Chrome Cookie 的载荷，Google 于 2024 年 8 月在披露一起疑似 APT29 水坑攻击活动时记录了它。该活动利用涉及 CVE-2024-5274 和 CVE-2024-4671 的 Chrome exploit chain，攻击访问蒙古国政府网站的 Android 用户。</p><p>Sekoia 表示：\"此次行动也证实，由国家支持的入侵组织仍在继续复用 DarkSword 等 CSV [Commercial Surveillance Vendors] 移动端漏洞利用框架。采用打包式 N-day 漏洞利用链降低了实施高级移动端漏洞利用的成本和技术门槛。\"</p><h3 id=\"sec-1\">Coruna 和 DarkSword 工具包 evolves</h3><p>此次开发发生在 <a href=\"https://www.iverify.com/blog/malvertising-coruna-darksword-iphone-exploits\">iVerify</a> 和 <a href=\"https://blog.report-uri.com/deadtag-how-forgotten-website-tags-became-a-delivery-network-for-iphone-spyware/\">Report URI</a> 详细披露 <a href=\"https://thehackernews.com/2026/10/p7-darksword-ios-exploit-kit-adds.html\">DarkSword 的 P7 变体</a> 数周之后。该变体通过利用广告基础设施的半点击攻击进行投放。据称，在一个案例中，漏洞利用载荷通过以世界杯为主题并从 \"ad-track[.]live.\" 提供的恶意 Instagram 广告传播。</p><p>另一条途径属于名为 DeadTag 的犯罪攻击活动，攻击者会获取仍被数千个网站加载的旧有分析和广告标签背后的过期域名。其思路是向 iPhone 访问者提供恶意 JavaScript，并在暗中为攻击者执行竞价。</p><p>Report URI 表示：\"它会检查访问者是谁。搜索引擎、安全扫描器、自动化浏览器，以及任何看起来像机器人的程序都得不到任何内容。\"</p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgHayfG1leUJAFUZzDd5sHvxpOXu6RnWU0ysrhR7yJG7J5ticyS2Hb0YIob7DwaHyTeU05omwPmfOK2i5ZGVkFq6OPrH1BiYX67_fs4ayhJzAdg3HqDOFGqQTWN38XLvwkw73zjq4-YYhZXOr_ayEOSOhRthpZ6y1SA-pCds6yIqWtvOIfKK4WKLu9_hqEN/s1600/sek-2.jpg\"><img alt=\"\" src=\"/dailyinfo/media/c1a9d1f160bbb54a.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>随后，该脚本会与攻击者的服务器交互，由服务器决定每位访问者必须重定向到的目的地。利用 DeadTag 的 iPhone 漏洞利用路径会将访问者导向 <a href=\"https://thehackernews.com/2026/03/coruna-ios-kit-reuses-2023.html\">Coruna</a> exploit kit，攻击运行 iOS 13 至 17.2.1 的较旧 iPhone，以及面向运行 iOS 18.4 至 18.7 的 iOS 设备的 DarkSword P7。</p><p>“这些不是钓鱼页面或虚假应用下载，两套工具包都会直接攻击浏览器本身，”Report URI 的 Scott Helme 表示。“仅仅打开该页面就足以让你的设备遭到入侵。无需点击任何内容，不需要点击任何链接，无需安装任何东西，也不会有任何警告。如果 iPhone 运行的是存在漏洞的 iOS 版本，这套工具包就会突破浏览器限制，并在设备上安装间谍软件。”</p><p>其他攻击方案会跳转到虚假的 Google 重定向页面、博彩和赌场诈骗注册页面、汽车交易和牙医的搜索广告，以及虚假调查和“你中奖了”奖品页面。超过 660 个已过期并被重新注册的域名属于 DeadTag 网络。</p><p>根据 Zimperium zLabs 发布的一项分析，分发 Coruna 和 DarkSword 漏洞利用工具包的行动持续演变。截至 2026 年 10 月，已有 608 个域名为 Coruna 系列代码提供分发服务。</p><p>尽管 Coruna 最初由国家行为体开发，用于高度定向的行动，但在首次披露后，该工具包发生泄露，随后被多个威胁行为体广泛用于各自的行动。</p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjjOyv3BH6VpX5d9J_SmpO7HnzucO2e0hXnHLMRADxYrFfjQY0FXhNWo84OGUzocwrN7d9epa0U3liOMXj_wByUKIK1oTm20gScU4j45CCQcDEFHr2YZnXcC_Nz65nSodlgdUR_JJJoSu6t2Ry3_2jRyU-aP_dkGpTbnjnH4BCdrpegKP2J9cgnNiHeF0Br/s1600/sek-3.jpg\"><img alt=\"\" src=\"/dailyinfo/media/eff79235db752873.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>在许多情况下，人们发现诱饵网站会明确指示访问者退出应用内浏览器或其他 iOS 浏览器，改用 Safari 打开链接，以便根据设备的操作系统触发漏洞利用链。</p><p>“运行 iOS 17.2.1 或更早版本的目标设备会收到旧版 Coruna 框架（在多个恢复出的配置中表现出字节完全相同的 JavaScript 载荷），”安全研究员 Santiago Rodriguez <a href=\"https://zimperium.com/blog/inside-coruna-and-darksword-chains-from-web-lures-to-ios-exploitation\">表示</a>。“相反，运行较新 iOS 版本的设备会收到源自 DarkSword 的执行链。”</p><p>“经分析的分发范围涵盖约会门户、AI 伴侣平台、加密货币促销活动、媒体流媒体服务，以及在若干情况下被入侵的合法网站，这些网站通过隐藏 iframe 提供该工具包。”</p><p>觉得这篇文章有意思？请在 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a> 上关注我们，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","漏洞利用","数据窃取","供应链投毒","Apple","Google","Mozilla","https://thehackernews.com/2026/11/apt29-linked-hackers-hijack-web.html","The Hacker News",{"_118":119,"_120":-5},"changelogVersion","2026-10-01T08:00","release"]
