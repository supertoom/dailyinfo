[{"_1":2,"_3":4},"root",{"_5":113},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1793672468000,"id","p8lgm331w38cxp1dyo8ycly9z","title","Google 接管逾 130 万台 Android 设备僵尸网络，Videostrong 电视盒后门遭曝光","originalTitle","Google Disrupts 1.3 Million-Device Android Botnet, Says TV Box Maker Sold Criminal Access","summary","Google 通过法律行动于 10 月下旬接管控制逾 130 万台 Android 设备的僵尸网络，并指称深圳设备厂商 Videostrong 故意在多款电视盒固件中植入 x.cpe 后door，向犯罪分子出售访问权限。","reason","source",{"_75":112},"links",{"_102":111},"publishedAt","2026-11-02T15:50:26.000Z","discoveredAt","2026-11-02T16:43:34.526Z","timelineAt","category","activity","tags",[78,76,108,80,109,110],"score",81,"selected",true,"channel","news","story",{"_84":85,"_13":86},"x","sameEvent",{"_11":106,"_13":107},"readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_62":101,"_102":-5,"_103":104,"_105":36},"outline",[87,88,89,90],"relatedStories",[83],"topics",[69,70,71,72],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","flU3MNG-JM7M","reportCount",4,"additionalSourceCount",3,{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","malware","name","恶意软件","attack","攻击活动","botnet","僵尸网络","google","Google / 谷歌",{"_84":85,"_13":86},"publicId","d06829ad-986b-44e7-8164-4a64599bab09","Google拆除XCPE僵尸网络并封禁Videostrong",{"_11":99,"_92":100,"_94":68},{"_11":97,"_92":98,"_94":68},{"_11":95,"_92":96,"_94":68},{"_11":91,"_92":93,"_94":68},"sec-4","text","Google 设备测试中的缺口","level","sec-3","Videostrong 是如何被识别的","sec-2","机主可以采取的措施","sec-1","后门的作用","<p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhkbU6vLZjF0nlz7vqN6UVf3kN1IcdUfIpAmVWlh2II4gGbMMmSuiE1S8HLzP4JV-ImeCa64hU-cEaa-yGXWqUO_XHOurKtEw61DFvjGOJhM7gHpRPpegBcCFYrXkd59wGX-PoV6zm7z7uq6PpXjc4GLhDRzcinR5IIjcOVZEVl8FMQ0v0Dt3CV9sRxZNk/s1600/android-tv-botnet.jpg\"><img alt=\"\" src=\"/dailyinfo/media/7e39bcf107ec3f52.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>一个由超过 130 万台 Android 设备组成的僵尸网络，其中大多是 TV 机顶盒，在 10 月下旬失去了对其服务器的控制。此次查封行动由 Google 牵头。</p><p>Google <a href=\"https://cloud.google.com/blog/topics/threat-intelligence/shutting-the-door-on-the-xcpe-botnet/\">表示</a>&nbsp;它高度确信，设备制造商 <strong>Videostrong </strong>故意在这些机顶盒中植入了后门，并向犯罪分子出售访问权限。</p><p>他们利用这些机顶盒进行广告欺诈，并将其他人的互联网流量通过机主家中的连接进行传输。该后门仍存在于机顶盒中，机主无法自行将其移除。</p><p>Videostrong 总部位于中国深圳，以自有品牌及其他品牌生产 Android TV 机顶盒和其他设备。这个名为 x.cpe 的后门在数年间被内置于许多设备型号和品牌中。Google 不认为是内部人员作恶或疏忽所致。</p><p>Google 通过法律行动查封了控制该僵尸网络的域名和服务器。它还查封了通过该后门加载的十余个恶意软件家族的控制域名。日本警察厅、Lumen、HUMAN Security、Plume、Synthient 和 TrendAI 与 Google 合作参与了此次行动。</p><p>由于这些恶意软件背后的犯罪分子还通过其他方式传播该软件，Google 预计此次行动将切断他们对至少 1,000 万台更多受感染设备的访问。它警告称，当其工具链中的一部分受到干扰时，后门运营者及从他们手中购买工具的犯罪分子会迅速改用新工具。</p><p>Google 已与 Videostrong 断绝关系。它禁止该公司及其未来的子公司或关联公司构建或销售获得认证的 Android 设备，并禁止其向其他获得认证的设备制造商供应软件。</p><h3 id=\"sec-1\">后门的作用</h3><p>根据 Google 的分析，x.cpe 后门以系统应用的形式运行在固件内部，并拥有系统级访问权限。它会向该僵尸网络的命令与控制（C2）服务器报告并等待指令。为了静默安装软件，它首先会关闭 Google Play Protect（Android 内置的安全功能）中的应用检查。</p><p>通过该后门，僵尸网络运营者可以在机主不知情的情况下安装应用、运行命令、截取屏幕，并绘制机顶盒所在的网络。</p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhaYgAoeSj4eCCZeGMBh02O0O5MaXLNWnGRJ9ZNBCJh-e0l2FncVv3wQjPyEDprRyHenu7fDl2TuVJtNYBN3ixn7_NjfWvy92osmsmG0K-dnBIH_Ce61h0-TdIzM90VEn9bVHWupetq7T4mkaAvnkUG0Tiljb3pZlInRbWjz2vSdNJpb2CVO6N60bbSSl0/s1600/tv.png\"><img alt=\"\" src=\"/dailyinfo/media/5cdd67d5c83db17c.webp\" loading=\"lazy\" decoding=\"async\"></a></p><p>Google 表示曾看到 Videostrong 的运营者使用其中部分功能。他们截取了实时屏幕画面、发送击键、复制账户详细信息、设备信息、应用列表和系统日志，并打开反向 shell，从而为机顶盒提供一个远程命令行。</p><p>这些犯罪分子的模块大多是通过后门加载的附加程序，它们将这些机顶盒变成住宅代理，或出售其剩余带宽。住宅代理服务出售对家庭互联网连接的访问权限，因此客户流量看起来源自普通家庭。其他模块则伪造在线广告的浏览量。</p><p>大多数受感染设备是 Android TV 机顶盒，但该后门也出现在远程医疗设备、卡拉 OK 机和数字标牌上。</p><p><a href=\"https://www.trendaisecurity.com/en-us/resources-insights/trendai-security-blog/trendaitm-research-helps-disrupt-android-tv-botnet-of-more-than-13-million-pre-infected-devices\">TrendAI</a> 是 Trend Micro 的企业业务部门，它统计了 6 月 3 日至 10 月 1 日期间 206 个型号中共有 1,472,554 台受感染设备，并表示实际数量至少达到这一数字。马来西亚、巴西、伊拉克、墨西哥和台湾的数量最多。美国、德国、英国、澳大利亚和加拿大各有约 26,000 至 42,000 台。</p><h3 id=\"sec-2\">机主可以采取的措施</h3><p><a href=\"https://synthient.com/blog/the-internals-of-a-badbox-operation\">Synthient</a> 跟踪代理网络和僵尸网络，已发布&nbsp;<a href=\"https://github.com/synthient/public-research/blob/main/2026/11/Videostrong/README.md\">182 个设备型号名称的列表</a>&nbsp;，这些型号出现在此次攻击活动中。该列表警告称，仅凭型号名称并不能确认某个机顶盒是否已感染。</p><p>Synthient 的报告重点关注 MECOOL 品牌机顶盒，并将其与 Videostrong 联系起来。该团队购买了一台 MECOOL KM9PRO Max，发现后门已预装其中。<a href=\"https://www.plume.com/xcpe-botnet-whitepaper-pdf\">Plume</a> 为互联网服务提供商提供 Wi-Fi 软件，该团队发现有多于 12 种不同设备正在使用该僵尸网络的控制服务器，其中大多数来自 MECOOL。</p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhNeznatXrzd68j-HfyPH00S_xs88E0m7TabGvyVy804L16ry3x-KrNfWLYnjxsKFKKutI2ZjWjsdH_VNlp6DELO4cdN3cU31nF-ZHM2CAzoNoKoD7pArdBzjq20p0hEbn3CVFzikShbN6Yfblskx91kbZLoDzdNs-pEQYbqcGKDlcY8L3krKGgVNQGckA/s1600/map.jpg\"><img alt=\"\" src=\"/dailyinfo/media/39746ec02a091bcf.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>由于 x.cpe 是固件的一部分，移除它并不能持久生效。机顶盒重启后，它会自行重新安装。TrendAI 表示，该后门以系统应用的形式运行，并使用制造商的密钥签名，因此清理工作需要“供应商采取行动、平台提供保护或更换设备”。</p><p>Plume 建议执行完整的恢复出厂设置，因为这些模块可能安装了更多后门，但它没有说明重置是否能够移除 x.cpe 本身。Synthient 则进一步建议消费者彻底丢弃这些机顶盒，因为它们面临严重的恶意软件风险。</p><p>对于组织，Synthient 建议采取以下步骤：</p><ul>\n  <li>使用其发布的指标查找网络中的 MECOOL 或类似设备。</li>\n  <li>断开并丢弃任何被发现的设备。</li>\n  <li>屏蔽其报告中列出的控制域名和 IP 地址。</li>\n  <li>将其他智能设备置于独立的网络网段中，与敏感系统隔离。</li>\n</ul><p>TrendAI 建议拥有远程员工的公司将家庭网络中的 unmanaged consumer devices 视为其攻击面的一部分，并将企业访问权限置于受管理设备之后。</p><h3 id=\"sec-3\">Videostrong 是如何被识别的</h3><p>在 Google 的账户中，x.cpe 会将来自 C2 服务器的设置传递给其他 Videostrong 应用，包括其 YokaTV Player 流媒体应用。托管该僵尸网络软件包的 GitHub 账户中，有一个名为 yf-videostrong。</p><p>曾与 Google 合作的 Synthient 也高度确信 Videostrong 在运营该活动。其依据包括：某僵尸网络服务器上一个开放文件夹中有一份由 Videostrong 研发总监签署的文件，以及一个与运营者控制面板共享 IP 地址的 Videostrong 网络域名。</p><p>Plume 发现，Videostrong 同时为这些设备提供固件以及远程管理工具。</p><h3 id=\"sec-4\">Google 设备测试中的缺口</h3><p>Google 要求设备制造商通过一系列兼容性和安全测试。Google 表示，Videostrong 隐藏代码以绕过这些测试中的一个缺口，并在设备首次启动后加载恶意代码。</p><p>Google 已修改其审查流程，并正在加强自己对获得认证的 Android TV 设备固件的检查。</p><p>截至 11 月 2 日，Videostrong 自己的网站上仍列有所谓“Google Certified Android TV Box”和“Google Certified Android TV Stick”的产品。</p><p>Plume 表示，该僵尸网络同时包含获得 Google 认证的设备和运行 Android Open Source Project (AOSP) 版本的设备。Google 的报告没有说明有多少获得认证的设备受到影响。</p><p>2025 年 7 月，Google <a href=\"https://thehackernews.com/2025/07/google-sues-25-chinese-entities-over.html\">就 BadBox 2.0 僵尸网络提起诉讼</a>时，涉及的 1000 多万台设备均未获得认证。</p><p>觉得这篇文章有趣？欢迎关注我们的 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a>，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","wbjzunigapakv96vd54t9g53c","Google 联合处置 XCPE 僵尸网络，Videostrong 预装后门感染逾 130 万台机顶盒","后门","Google","Trend Micro","https://thehackernews.com/2026/11/google-disrupts-13-million-device.html","The Hacker News",{"_114":115,"_116":-5},"changelogVersion","2026-10-01T08:00","release"]
