[{"_1":2,"_3":4},"root",{"_5":108},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":37,"_59":60},"expiresAt",1795308043000,"id","vt4gd1d2m0q2e5cxg60jzp1ja","title","GreenJuliett 将 AI 纳入 OT 攻击链并扩大 FortiGate 扫描范围","originalTitle","AI Joins the Industrial Attack Workflow","summary","Recorded Future 观测到 GreenJuliett 将 AI 纳入 OT 攻击链，用于识别脆弱设备类型并编写针对 PLC 与工业协议的脚本。该组织在巴林、以色列、约旦、科威特、沙特阿拉伯和卡塔尔扫描或尝试利用 Fortinet FortiGate，并可能将 IoT 与 CCTV 设备纳入目标。","reason","文章追踪了 GreenJuliett 将 AI 引入 OT 攻击链的迹象及其针对 PLC、FortiGate 和 IoT 设备的扩张路径。","source",{"_75":107},"links",{"_98":106},"publishedAt","2026-11-20T00:00:00.000Z","discoveredAt","2026-11-20T21:31:31.492Z","timelineAt","category","activity","tags",[78,76,80,102,103,104,105],"score",72,"selected",true,"channel","news","story",{"_88":89,"_13":90},"x","readingMode","full","author","body",{"_60":97,"_98":-5,"_99":100,"_101":37},"outline",[91],"relatedStories",[87],"topics",[67,68,69,70,71,72],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","fIOTSYh1T8X4","reportCount",1,"additionalSourceCount",0,{"_73":85,"_75":86},{"_73":83,"_75":84},{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","malware","name","恶意软件","attack","攻击活动","ai-offense","AI 攻防","industrial","工业控制","iot","IoT 与车联网","fortinet","Fortinet / FortiGate",{"_88":89,"_13":90},"publicId","c78456b4-ade5-4d3a-8614-9ddf8f525b80","GreenJuliett借AI扩大工控设备攻击",{"_11":92,"_93":94,"_95":96},"sec-1","text","从账户到基础设施","level",2,"<p>近期针对法国冰箱的网络攻击，以及我们对恶意 AI 框架 ARTEX 的追踪表明，威胁行为者正越来越多地利用 AI 来加速攻击、扩大攻击范围并提升攻击效果。GreenJuliett 是实施类似法国事件的运营技术（OT）网络攻击的团伙，该团伙已开始将 AI 纳入其 OT 攻击链。了解 AI 为经济利益驱动和国家支持的威胁行为者带来的规模优势，有助于我们将其视为一种不只是工具的东西：它能够承担操作人员的角色，即使最终仍由人类掌控。</p><p>2026 年 10 月 11 日和 12 日，有人更改了法国 700 多个零售地点的制冷控制器除霜设置。这引发火灾，造成设备损坏和食品损失，估计损失达数千万欧元，凸显了针对运营技术（OT）攻击的物理影响。11 月 9 日，法国<a href=\"https://diplomatie.gouv.fr/fr/presse-et-ressources/decouvrir-et-informer/actualites/declaration-d-attribution-a-l-iran-de-cyberattaques-visant-la-france\">将此次攻击归因于</a> Shahid Kaveh，即伊朗伊斯兰革命卫队网络电子司令部（IRGC-CEC）的一个单位。我们将可能属于 Shahid Kaveh 某个分支的活动追踪为 GreenJuliett。</p><p>GreenJuliett（又称 CyberAv3ngers 和 Bauxite）构建了旨在针对暴露在互联网上的 PLC 的基础设施。尽管关于该团伙的报道多次公开，但这项工作至少持续到了 10 月 30 日，与此同时其目标范围开始扩大。8 月至 10 月期间，我们观察到与 GreenJuliett 有关的基础设施在巴林、以色列、约旦、科威特、沙特阿拉伯和卡塔尔扫描或试图利用 Fortinet FortiGate 防火墙——这类边缘设备用于保护 OT 网络。我们的网络数据表明，该团伙还在努力将物联网（IoT）和 CCTV 设备纳入其目标清单。</p><p>虽然我们尚未独立将 GreenJuliett 的基础设施与针对制冷设备的攻击关联起来，但在过去三个月中，我们看到该团伙持续以 PLC（可编程逻辑控制器）为目标，这些 PLC 与法国冰箱所使用的暴露在互联网上的控制器类似。我们还观察到，AI 现在已参与他们的工作方式。</p><h2 id=\"sec-1\"><strong>从账户到基础设施</strong></h2><p>2024 年 10 月，OpenAI <a href=\"https://openai.com/index/disrupting-malicious-uses-of-ai-cyberav3ngers\">封禁了</a>其评估为属于 CyberAv3ngers 的账户。操作人员曾使用 ChatGPT 研究 PLC 的默认凭据、编制约旦电力公司及常见 PLC 的清单，并起草针对工业协议的脚本（例如 Modbus TCP，这是一种允许 PLC 在本地网络上快速通信的控制协议）。</p><p>然而，到了 2026 年，情况有所不同。10 月，我们在评估为可能被 GreenJuliett 相关操作人员使用的基础设施上，发现了 LiteLLM（一个将多个 AI 模型置于单一接口之后、表明采用团队共享访问模式的开源网关）的配置，以及为波斯语用户构建的自托管聊天应用程序。我们还观察到，该团伙匿名网络中的服务器正与托管 Anthropic Claude 的基础设施进行通信。</p><p>尽管我们在这项研究中尚未确认具体的滥用实例，但 OpenAI 和 <a href=\"https://anthropic.com/threat-intelligence-report-september-2026\">Anthropic</a> 都曾公开报告检测并阻止伊朗政府操作人员的滥用行为。AI 缩短了识别脆弱设备类型和编写定向脚本所需的时间，而 GreenJuliett 已将其从个人账户层面引入其运营环境。</p><p>\n              <img alt=\"Infographic showing GreenJuliett's attack path from operators through proxy servers to target PLCs, FortiGate firewalls, and IoT devices.\" src=\"/dailyinfo/media/51a4b194428b10ad.gif\" srcset=\"/dailyinfo/media/a3b8435557103448.gif 720w, /dailyinfo/media/866512e87a21d30c.gif 1200w, /dailyinfo/media/51a4b194428b10ad.gif 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\" height=\"2000\">\n            </p><p><strong>图 1：</strong>GreenJuliett 行动路径，观测时间为 2026 年 8 月至 10 月</p>","original","zhKind","translation","complete","工控","IoT","Fortinet","Google","https://www.recordedfuture.com/blog/ai-industrial-attack-workflow","Recorded Future",{"_109":110,"_111":-5},"changelogVersion","2026-10-01T08:00","release"]
