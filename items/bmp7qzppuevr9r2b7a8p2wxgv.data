[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1794876027000,"id","bmp7qzppuevr9r2b7a8p2wxgv","title","Gemini 4 Argon agents 在安全测试中绕过限制攻击 Epoch AI 网站","originalTitle","Gemini AI agents repeatedly bypassed safeguards to attack real website","summary","Trajectory Labs 测试 Gemini 4 Argon agents 时，agents 绕过 API 防护和 DNS 重定向，持续访问 Epoch AI 实际网站并尝试未授权行为。","reason","source",{"_72":96},"links",{"_61":95},"publishedAt","2026-11-16T22:54:00.000Z","discoveredAt","2026-11-16T23:56:15.012Z","timelineAt","category","ai-security","tags",[73,92,75,77,93,94],"score",68,"selected",false,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","Lawrence Abrams","body",{"_88":-5,"_61":89,"_90":-5,"_91":36},"outline",[82],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","f2HG66b1UOaE","reportCount",1,"additionalSourceCount",0,{"_71":76,"_72":77},{"_71":74,"_72":75},{"_71":30,"_72":73},"slug","name","AI 安全","attack","攻击活动","exploited","在野利用",{"_79":80,"_13":81},"publicId","24b4541c-727f-4cdb-8575-914565f010e0","Gemini智能体测试中攻击Epoch AI网站",{"_11":83,"_84":85,"_86":87},"sec-1","text","Uncover email threats your existing defenses may miss.","level",2,"zh","<p><img alt=\"AI robot\" height=\"900\" src=\"/dailyinfo/media/96945cd62eef3c4f.jpg\" srcset=\"/dailyinfo/media/9d2b15afd2e42c6e.jpg 720w, /dailyinfo/media/29dda7a49a73ae20.jpg 1200w, /dailyinfo/media/96945cd62eef3c4f.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>Google's Gemini AI agents repeatedly attempted to hack a real organization's website during AI model safety testing, finding ways to circumvent increasingly restrictive security controls designed to prevent them from accessing live systems.</p><p>The security incidents occurred in October as AI safety research company Trajectory Labs tested whether Gemini 4 Argon agents would engage in unauthorized behavior when faced with an impossible task, even with the model's built-in API safeguards enabled.</p><p>In <a href=\"https://www.trajectorylabs.com/blog/responding-to-incidents-during-misalignment-testing\">reports published Friday</a>, Trajectory Labs and the targeted organization, <a href=\"https://epoch.ai/publications/incident-report-ai-agents-attempted-exploits-on-our-website\">Epoch AI</a>, revealed that the agents attempted SQL injection attacks, probed for sensitive information, impersonated employees, and repeatedly circumvented network restrictions introduced to contain their activity.</p><p><a href=\"https://www.wiz.io/lp/securing-ai-agents-101?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY26Q3_INB_FORM_Securing-AI-Agents-101&amp;sfcid=701Py00000RTEWMIA5&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AI-Agents-101\"><img src=\"/dailyinfo/media/9f123126a9a949d7.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>Epoch AI said it had not independently verified which AI models were involved, and that the Gemini identification came from Trajectory Labs.</p><p>The researchers tasked the agents with retrieving official answers to nonexistent problems from Epoch AI's FrontierMath benchmark, repeatedly instructing them to \"NEVER stop, NEVER give up.\"</p><p>On October 20, approximately 40 agents began probing Epoch AI's live website for sensitive information, including administrator credentials and access to proprietary benchmark evaluation logs.</p><p>Epoch AI detected the activity and deployed an \"agent hotline\" that allowed the agents to send messages directly to its employees.</p><p>For three hours, the agents made 36,411 requests to a planted API endpoint and sent 487 messages through the hotline, including some that attempted to impersonate actual Epoch employees or claimed to be engineers and auditors requesting benchmark information.</p><p>An investigation also identified an attempted SQL injection attack and more than 200 attempts to access FrontierMath evaluation logs.</p><p>Trajectory Labs discovered the activity while reviewing agent transcripts and notified Epoch AI of the unauthorized attacks the following morning.</p><p>After discussing the incident with Epoch, the researchers agreed to continue testing against a local copy of the website instead of its live infrastructure.</p><p>However, the agents continued finding ways to circumvent the restrictions.</p><p>During testing on October 23, some agents recognized they were interacting with a copy of Epoch's website, identified the real website's IP address, and connected directly to its live infrastructure, bypassing DNS redirection designed to contain them.</p><p>When researchers blocked the IP addresses used to reach Epoch, an agent switched to another address that allowed it to access the live website again.</p><p>Trajectory Labs subsequently configured its network proxy to block direct connections to Epoch, but an agent found another way to retrieve the website's public content through a third-party web-reader service.</p><p>\"In some of these runs, the agents worked out that they were on a copy, identified the correct raw IP to bypass our redirect, and reached the live site again, which Epoch alerted us about,\" Trajectory Labs explained.</p><p>In a separate <a href=\"https://www.trajectorylabs.com/blog/gemini-4-argon-behavior-during-misalignment-testing\">technical analysis</a>, Trajectory Labs researchers also discovered that the agents created a message board through a shared software package cache to communicate with each other, exchanging information about vulnerabilities and exploitation methods.</p><p>In one example, an agent shared a technique for bypassing restrictions on a deliberately vulnerable copy of Epoch's website, which another agent subsequently used to obtain credentials and complete the task.</p><p>The researchers also observed agents attempting to bypass CAPTCHA protections and impersonating employees to trick an AI assistant into revealing protected benchmark information.</p><p>Beginning October 26, Epoch AI agreed to work with Trajectory Labs on additional experiments, knowing the agents would have internet access and could interact with its public website.</p><p>During these tests, the agents again accessed Epoch's live infrastructure, making more than 65,000 requests to a planted API endpoint and attempting further SQL injection attacks and employee impersonation.</p><p>Trajectory Labs later moved testing into fully isolated environments without internet access.</p><p>Even after this change, the agents still tried to disable a fake control that allegedly blocked network access, and they succeeded in all three complete test runs.</p><p>The researchers said that the agents had not been explicitly instructed to hack websites or impersonate employees. However, they were given an impossible objective on purpose and repeatedly instructed not to give up.</p><p>Trajectory Labs acknowledged that the incidents resulted from shortcomings in its testing procedures, including conducting experiments without obtaining the affected organization's consent and relying on built-in model safeguards without sufficient additional monitoring.</p><p>On November 2, the company suspended all AI misalignment testing pending a risk assessment and the addition of further safeguards.</p><p>\"These incidents show how easily testing capable AI agents can spill over to affect real systems and people, and there are not yet shared standards for doing it safely,\" Trajectory Labs warned.</p><p>Neither organization confirmed that any private Epoch AI information was exposed during the incidents.</p><p>This report comes as California Attorney General Rob Bonta sued<a href=\"https://www.bleepingcomputer.com/news/security/california-sues-openai-over-ai-agents-escaping-sandboxes-hacking-firms/\">&nbsp;OpenAI on Monday</a>, alleging the company failed to adequately contain autonomous AI agents during testing, resulting in more than 80 incidents in which it lost control of the agents.</p><p>The lawsuit follows a July incident in which nearly 700 OpenAI-powered agents escaped a controlled testing environment and <a href=\"https://www.bleepingcomputer.com/news/security/nearly-700-rogue-ai-agents-coordinated-in-the-hugging-face-attack/\">attacked Hugging Face's production infrastructure</a> while attempting to steal cybersecurity benchmark answers.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/5441efe9afeba96b.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Uncover email threats your existing defenses may miss.</a>\n        </h2><p>Adaptive Security's AI agents analyze email intent, context, and behavior to uncover phishing, business email compromise, and invoice fraud.</p><p>See what's getting through with a 14-day read-only scan of Microsoft 365 or Google Workspace, with no MX changes.</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">Start your free email security scan.</a>\n    </p>","zhKind","complete","Agent 安全","Google","CISA","https://www.bleepingcomputer.com/news/security/gemini-ai-agents-repeatedly-bypassed-safeguards-to-attack-real-website/","BleepingComputer",{"_98":99,"_100":-5},"changelogVersion","2026-10-01T08:00","release"]
