[{"_1":2,"_3":4},"root",{"_5":114},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":37,"_59":60},"expiresAt",1794271238000,"id","teaxhs6mgmqr7we21mxnq1hmt","title","Trail of Bits 使用 Codex 批量回移 Linux 安全修复，已覆盖 149 个 CVE","originalTitle","Backporting security fixes at scale with Codex","summary","Trail of Bits 使用 Codex 与 GPT-5.6 协助将安全修复回移到 Linux 稳定分支及 Ubuntu、Fedora 等软件包。","reason","文章用稳定分支的漏洞缺口和 149 个已完成回移修复，展示了 AI Agent 辅助安全补丁回移的实际规模与工作流。","source",{"_74":113},"links",{"_103":112},"publishedAt","2026-11-02T12:00:00.000Z","discoveredAt","2026-11-02T12:41:36.164Z","timelineAt","category","ai-security","tags",[75,79,107,83,108,109,110,111],"score",70,"selected",true,"channel","news","story",{"_87":88,"_13":89},"x","readingMode","full","author","body",{"_60":102,"_103":-5,"_104":105,"_106":37},"outline",[90,91,92],"relatedStories",[86],"topics",[67,68,69,70,71,72],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","fUB1p4PZ5-_Q","reportCount",1,"additionalSourceCount",0,{"_73":84,"_74":85},{"_73":82,"_74":83},{"_73":80,"_74":81},{"_73":78,"_74":79},{"_73":76,"_74":77},{"_73":31,"_74":75},"slug","name","AI 安全","vuln","漏洞披露","ai-offense","AI 攻防","ai-agent","AI Agent 安全","vuln-mgmt","漏洞管理","kernel","内核与系统",{"_87":88,"_13":89},"publicId","d035fa86-3052-49a4-8cb6-e36ce1aa768c","Codex 协助回移149个CVE修复",{"_11":100,"_94":101,"_96":97},{"_11":98,"_94":99,"_96":97},{"_11":93,"_94":95,"_96":97},"sec-3","text","工程师和 AI 可以加速补丁回移","level",2,"sec-2","数千个已知 CVE 缺乏稳定分支修复","sec-1","我们必须在稳定性和安全性之间做出选择吗？","<p>稳定的 Linux 版本缺少现有的安全修复，是因为回移这些修复既耗时，又往往是一项得不到认可的工作。我们正在使用 Codex 将每个修复的回移流程从数天缩短到数小时，让人工补丁审查员能够快速为 Ubuntu Long Term Support、Fedora 和 Linux 内核等关键软件提交修复。截至 10 月 29 日，我们的项目已帮助将 <a href=\"https://trailofbits.github.io/ptp-linux-stable-cve-dashboard/\">149 个不同的 CVE</a> 的修复交付到稳定的 Linux 内核版本中，并为 Fedora 和 Ubuntu 软件包交付了 <a href=\"https://bugzilla.redhat.com/show_bug.cgi?id=2520165\">若干</a> <a href=\"https://bugzilla.redhat.com/show_bug.cgi?id=2531860\">修复</a>。</p><p>将修复部署到较旧的软件需要多个步骤，包括将修复适配到旧版代码、检查依赖关系，并确保修复没有引入新 bug。单项任务（例如追踪一个有问题的提交中的 bug）可能需要 <a href=\"https://lkml.rescloud.iu.edu/hypermail/linux/kernel/2610.1/04212.html\">一周或更长时间</a>，而这些投入既不为人所见，也不被认可。</p><p>我们的 Codex 工作流减少了准备和审查修复所需的人工投入。不计项目特定的初始设置，准备并审查一项 straightforward 的回移大约需要 30 分钟的人工关注；更复杂的情况则可能需要约三个小时。该工作流采用双轨方式：智能体负责识别缺失的修复、适配补丁、收集验证证据、运行测试和准备提交材料包，工程师则审查补丁并将其提交给维护者。</p><p>这些估算仅涵盖补丁准备和审查；回归测试和维护者验收仍然必不可少。但人工投入的减少，使大量原本被忽视的安全工作变得切实可行。补丁积压量很大，但我们现在有了一种可行的处理方式。</p><h2 id=\"sec-1\">我们必须在稳定性和安全性之间做出选择吗？</h2><p>软件存在 bug，而我们会在力所能及时尝试修复。修复首先会应用到软件的最新版本中。遗憾的是，那往往也是修复唯一落地的地方。</p><p>回移是将修复从最新源代码移植到旧版本的过程。对于知名且关键的 bug，修复确实通常会很快得到回移。但许多其他 bug 的回移流程从未发生。其原因不难理解：软件打包通常由已经超负荷工作的志愿者完成，而回移既繁琐又得不到认可，几乎没有功劳或曝光度。对于由志愿者团队组成的开源项目，回移（可以理解地）优先级较低。正如 XFS 开发者 Dave Chinner 曾描述的，这项工作“<a href=\"https://lists.openwall.net/linux-kernel/2018/03/28/86\">实际上相当于一份全职工作</a>”，但若没有充足资源，就根本无法完成。</p><p>缺少回移是一个问题，因为几乎没有人运行刚刚用今天的代码变更构建出来的最新最优版本。人们<em>绝大多数</em>更倾向于使用略旧、经过更多测试、以“长期稳定”版本形式打包的软件。例如，<a href=\"https://ubuntu.com/project/docs/release-team/ubuntu-releases/#lts-releases\">约 95%</a> 的 Ubuntu Linux 安装都是 Long Term Support（LTS）版本。查看 Debian 的 <a href=\"https://popcon.debian.org/\">popcon</a> 中已安装的 Linux 内核软件包，绝大多数都基于较旧的稳定分支：</p><figure><img src=\"/dailyinfo/media/c892afaec116f547.webp\" srcset=\"/dailyinfo/media/5c31d0259770c478.webp 720w, /dailyinfo/media/901435c071a78364.webp 1200w, /dailyinfo/media/c892afaec116f547.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"“A Codex-generated graph of recently installed kernel packages from Debian’s popcon”\" width=\"1070\" height=\"834\"><figcaption>图 1：由 Codex 生成的图表，展示了 Debian 的 popcon 中最近安装的内核软件包。绝大多数（约 96%）都是较旧的稳定版本，而不是最新的内核系列。</figcaption></figure><p>用户面临一个选择：要么继续使用稳定且熟悉的软件版本，尽管其中存在安全漏洞；要么升级到修复了这些漏洞的新版本，但这会引入其他变化以及他们可能并不想要的新功能。</p><p>许多人<em>故意</em>不更新到新版本；我认为这完全合理，也是普通终端用户的正常行为。就在最近，我将我的 Mac 更新到了 macOS 27，却无法使用一台多年来一直运行正常的打印机（直到 Codex 编写了一个新的兼容打印机驱动程序）。类似情况实际上需要使用较旧的软件。</p><p>我们不应该被迫在稳定性和安全性之间做出选择。</p><h2 id=\"sec-2\">数千个已知 CVE 缺乏稳定分支修复</h2><p>大量具备网络攻击能力的 AI 代理可以像热刀切黄油一样，突破由稳定且已知存在漏洞的软件构成的网络。问题的规模之大，以至于你当前运行的软件很可能包含尚未修复的安全漏洞，而现代 AI 代理可以利用这些漏洞。随着 AI 辅助的漏洞挖掘让识别旧代码中的漏洞变得更容易，减少这一积压问题正变得愈发重要。这并非只是理论问题。最近引人关注的漏洞 <a href=\"https://atlasum.net/blog/cve-2026-98432-linux-ipv4-tcp-uaf\">CVE-2026-98432</a>（Linux TCP 栈中一个可远程利用的严重漏洞）的修复，在上游完成修补数周后仍未进入发行版内核。该漏洞足够引人注目，因此很快就会在所有地方得到修复。但较为冷僻漏洞的修复永远不会向后移植。我在自己的<a href=\"https://blog.trailofbits.com/2026/08/26/vms-wont-contain-cyber-capable-agents/\">沙箱逃逸研究</a>中注意到了这一点，稳定软件中的一个旧漏洞被用作<a href=\"https://www.hacktron.ai/blog/hacking-openai\">最近披露的 OpenAI 黑客事件</a>的一部分。</p><p>让我们量化一下缺失向后移植问题的规模。为简化统计，我们可以将范围限定为已知漏洞（已分配 CVE），这些漏洞已在最新版本中得到修复，但稳定软件包中仍然缺失。在本例中，我们将查看 Linux 内核、Ubuntu 26.04 LTS 和 Debian 13 Stable。我并不是要特别针对这些项目——它们的运行都非常好！我使用它们是因为它们有相关文档，并且会核算未修复的 CVE。其他项目则缺乏这种透明度。</p><p>让我们按稳定分支查看 Linux 内核中尚未修复的 CVE 数量。下表显示了每个受支持的稳定分支中未在该分支得到修复、但已在较新分支中得到修复的 CVE。（因此，从定义上说，较旧的分支会有更多未修复的 CVE。）数据来源为截至 2026 年 9 月 18 日的<a href=\"https://kernel.googlesource.com/pub/scm/linux/security/vulns/\">内核 CVE 团队的 vulns.git</a>。由于若干技术因素，这并非精确的漏洞数量，既会高估，也会低估。它也不是可利用性的衡量指标。更确切地说，它是一把标尺，表明有相当数量的已知 CVE 尚未在稳定内核分支中得到修复：</p><table><thead><tr><th>分支</th><th>未修复的 CVE</th><th>具有 NVD 评分的 CVE 占比</th><th>高危或严重级别</th></tr></thead><tbody><tr><td>5.10.y</td><td>2,006</td><td>55.8%</td><td>213 (19.0%)</td></tr><tr><td>5.15.y</td><td>1,889</td><td>51.5%</td><td>195 (20.0%)</td></tr><tr><td>6.1.y</td><td>1,329</td><td>43.9%</td><td>99 (17.0%)</td></tr><tr><td>6.6.y</td><td>1,012</td><td>35.6%</td><td>65 (18.1%)</td></tr><tr><td>6.12.y</td><td>686</td><td>22.3%</td><td>21 (13.7%)</td></tr><tr><td>6.18.y</td><td>337</td><td>15.1%</td><td>3 (5.9%)</td></tr></tbody></table><p>软件包生态的情况也好不到哪里去。以下是在 Debian 13 和 Ubuntu 26.04 中报告为开放或受影响的非内核 CVE（原始数据来自它们的<a href=\"https://security-tracker.debian.org/tracker/data/json\">各自</a><a href=\"https://github.com/canonical/ubuntu-security-notices\">批量</a>CVE 数据馈送，由 Codex 汇总）。这些是发行版元数据层面的发现，并非逐一经过源码确认的漏洞。同样，这并非旨在给出精确的漏洞数量，而更像是一把标尺，用来显示稳定软件包中仍有多少未修复的漏洞：</p><table><thead><tr><th>发行版</th><th>含未修复 CVE 的源码包</th><th>唯一 CVE</th><th>高危或严重级别</th></tr></thead><tbody><tr><td>Debian 13</td><td>1,128</td><td>4,562</td><td>1,822 (39.9%)</td></tr><tr><td>Ubuntu 26.04</td><td>1,028</td><td>770</td><td>335 (43.5%)</td></tr></tbody></table><h2 id=\"sec-3\">工程师和 AI 可以加速补丁回移</h2><p>我们意识到这是一个问题，并已开始主动修复。首先，我们从类似于在人行道上捡钱的事情做起：有一些针对已知 CVE 的漏洞修复可以干净地应用到稳定内核树中，但这些修复从未被合入内核。我们使用 Codex 和 GPT-5.6 找到了这些修复，并请维护者应用现有补丁。他们也欣然照做了。随后，我们开始回移无法直接应用的补丁，从最简单、最便于验证和审查的补丁入手，并逐步转向更复杂的更改。目前，稳定树中已应用 149 个 CVE 修复；<a href=\"https://trailofbits.github.io/ptp-linux-stable-cve-dashboard/\">我们回移跟踪器上的清单还在不断增长</a>。</p><p>我们也对 Linux 发行版做了同样的工作：我们使用 Codex 和 GPT-5.6 识别出随发行版提供的稳定软件包中的已知漏洞，然后回移并验证修复。我们已经开始联系 Linux 发行版，并提供第一批补丁。</p><p>如果你维护开源项目或 Linux 发行版，并希望获得安全修复回移方面的帮助，请在 <a href=\"https://trailofbits.com/patch-the-planet\">trailofbits.com/patch-the-planet</a> 提交申请，我们将很乐意提供协助。</p><p>不添加新功能的稳定软件的最大优势在于，理论上，我们可以在攻击者利用漏洞之前修复它们。因此，让我们继续修补这个星球吧！</p>","original","zhKind","translation","complete","大模型","内核","补丁","Ubuntu","Debian","https://blog.trailofbits.com/2026/11/02/backporting-security-fixes-at-scale-with-codex/","Trail of Bits",{"_115":116,"_117":-5},"changelogVersion","2026-10-01T08:00","release"]
