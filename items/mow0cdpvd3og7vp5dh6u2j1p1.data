[{"_1":2,"_3":4},"root",{"_5":100},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794357640000,"id","mow0cdpvd3og7vp5dh6u2j1p1","title","US 禁止 MEXC 加密货币交易所接入美国金融体系","originalTitle","US bans MEXC crypto exchange over sanctions evasion, cybercrime links","summary","US 财政部因制裁规避和网络犯罪关联，将 MEXC 加密货币交易所排除在美国金融体系之外。FinCEN称，2021年5月至2026年5月，MEXC至少处理了160亿美元与网络犯罪及伊朗、朝鲜、俄罗斯制裁规避有关的非法交易，并截至2026年6月仍在处理与受制裁俄罗斯实体 Garantex、Grinex 的交易，另涉及至少2.26亿美元及A7制裁规避网络相关交易。","reason","FinCEN列出了MEXC涉及的网络犯罪、制裁规避金额与交易对手，并说明接入其平台的潜在次级制裁风险。","source",{"_72":99},"links",{"_89":98},"publishedAt","2026-11-09T13:28:56.000Z","discoveredAt","2026-11-09T14:33:17.161Z","timelineAt","category","policy","tags",[93,94,95,96,97],"score",78,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","Sergiu Gatlan","body",{"_61":88,"_89":-5,"_90":91,"_92":37},"outline",[82],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fLyLJVomIbVY","reportCount",1,"additionalSourceCount",0,{"_71":76,"_72":77},{"_71":74,"_72":75},{"_71":31,"_72":73},"slug","name","政策法规","black-market","数据窃取与黑产","crypto","密码学",{"_79":80,"_13":81},"publicId","aa554cd5-43c9-4226-bda5-605ee3827c45","美国禁止MEXC接入金融体系",{"_11":83,"_84":85,"_86":87},"sec-1","text","发现现有防御措施可能遗漏的电子邮件威胁。","level",2,"<p><img alt=\"US Treasury\" height=\"900\" src=\"/dailyinfo/media/3216da4921498074.jpg\" srcset=\"/dailyinfo/media/ef8d53facbed963a.jpg 720w, /dailyinfo/media/9bf4961932aa48fc.jpg 1200w, /dailyinfo/media/3216da4921498074.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>美国财政部已因规避制裁及与网络犯罪团伙存在联系，将加密货币交易所 MEXC Global 排除在美国金融体系之外。</p><p>MEXC 成立于 2018 年，总部位于塞舌尔，是全球规模最大的加密货币交易所之一，让来自 170 多个国家的 4,000 多万名用户能够使用 3,000 种加密货币和代币化资产。</p><p>根据<a href=\"https://www.fincen.gov/system/files/2026-11/MEXC-Section-9714.pdf\">金融犯罪执法网络（FinCEN）的命令</a>，2021 年 5 月至 2026 年 5 月期间，MEXC 允许了至少 160 亿美元与网络犯罪行动以及规避伊朗、朝鲜和俄罗斯制裁有关的非法交易。</p><p><a href=\"https://www.wiz.io/lp/securing-ai-agents-101?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY26Q3_INB_FORM_Securing-AI-Agents-101&amp;sfcid=701Py00000RTEWMIA5&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AI-Agents-101\"><img src=\"/dailyinfo/media/92a0f16103a12998.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>财政部表示，截至 2026 年 6 月，MEXC 仍在处理与受制裁的俄罗斯实体 <a href=\"https://www.bleepingcomputer.com/news/security/us-sanctions-crypto-exchange-garantex-for-aiding-hydra-market/\">Garantex</a> 和 <a href=\"https://www.bleepingcomputer.com/news/security/us-sanctions-grinex-crypto-exchange-garantexs-successor/\">Grinex</a> 之间的交易，并且还促成或处理了至少 2.26 亿美元、使总部位于俄罗斯且被 OFAC 制裁的 A7 制裁规避网络受益或与之相关的交易。</p><p>“MEXC Global 不仅促成了俄罗斯非法融资，还充当了其他类型非法金融活动的枢纽，包括规避伊朗和朝鲜制裁、勒索软件和诈骗付款，以及俄罗斯和其他暗网市场活动，”<a href=\"https://home.treasury.gov/news/press-releases/sb0685/\">财政部表示</a>。</p><p>“2021 年 5 月至 2026 年 5 月期间，MEXC Global 与 40 多家已确认的伊朗 CVC 兑换机构之间直接发送或接收了约 10 亿美元的交易，其中一些机构受到美国和国际制裁。”</p><p>FinCEN 将此归咎于该加密货币交易所在反洗钱（AML）以及客户身份识别与验证政策方面存在的缺陷。</p><p>这项禁令使美国金融机构和个人面临二级制裁或执法行动的风险，只要向 MEXC Global 加密货币交易所转入或从其转出资金。</p><p>针对 FinCEN 的禁令，MEXC 表示其法律与合规团队已启动对其制裁和 AML 控制的审查。</p><p>“MEXC 已知悉美国金融犯罪执法网络（FinCEN）于 2026 年 11 月 6 日发布的命令，正与我们的法律和合规团队协调进行深入审查。MEXC 运营正常，用户资产仍然安全，”<a href=\"http://x.com/MEXC/status/2118856659619717218\">MEXC 表示</a>。</p><p>“我们严肃对待所提出的关切，并打算与 FinCEN 以及全球其他相关监管机构和主管机关开展建设性沟通。我们也已开始对自身的 AML 和制裁控制进行独立审查。”</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/ec08be135363bed0.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御措施可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 代理会分析电子邮件的意图、上下文和行为，以发现网络钓鱼/business 电子邮件入侵和发票欺诈。</p><p>对 Microsoft 365 或 Google Workspace 进行为期 14 天的只读扫描，查看有哪些威胁正在穿透，无需更改 MX 设置。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始免费电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","法规","加密","黑产","数据泄露","治理","https://www.bleepingcomputer.com/news/security/us-bans-mexc-crypto-exchange-over-sanctions-evasion-cybercrime-links/","BleepingComputer",{"_101":102,"_103":-5},"changelogVersion","2026-10-01T08:00","release"]
