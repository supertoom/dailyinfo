[{"_1":2,"_3":4},"root",{"_5":112},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1794185101000,"id","fjqzhkcehi5tcagia8jcpspb4","title","Crédit Mutuel Arkéa遭攻击，经服务商平台发起最高 $133 million 欺诈交易","originalTitle","Hackers pull off $133 million French bank heist via service provider","summary","法国合作银行 Crédit Mutuel Arkéa 遭网络攻击，攻击者经服务提供商平台进入其网络，并使用银行自身账户向其他银行发起欺诈交易、将资金转换为加密资产。","reason","source",{"_77":111},"links",{"_100":110},"publishedAt","2026-11-07T15:25:35.000Z","discoveredAt","2026-11-07T18:51:29.521Z","timelineAt","category","activity","tags",[78,106,107,108,109],"score",72,"selected",true,"channel","news","story",{"_90":91,"_13":92},"x","sameEvent",{"_11":104,"_13":105},"readingMode","full","author","Bill Toulas","body",{"_62":99,"_100":-5,"_101":102,"_103":36},"outline",[93],"relatedStories",[89],"topics",[69,70,71,72,73,74],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","fI9FC1LTMdnA","reportCount",4,"additionalSourceCount",3,{"_75":87,"_77":88},{"_75":85,"_77":86},{"_75":83,"_77":84},{"_75":81,"_77":82},{"_75":79,"_77":80},{"_75":76,"_77":78},"slug","attack","name","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","crypto","密码学","email","邮件与钓鱼","identity","身份与访问",{"_90":91,"_13":92},"publicId","12d9e017-9be0-4300-8768-9fc05ccfd8db","Crédit Mutuel Arkéa遭攻击，损失最高1.33亿美元",{"_11":94,"_95":96,"_97":98},"sec-1","text","发现您现有的防御措施可能遗漏的电子邮件威胁。","level",2,"<p><img alt=\"Hackers use French bank’s account to transfer up to $133 million\" height=\"900\" src=\"/dailyinfo/media/6eb0e1d464278a67.jpg\" srcset=\"/dailyinfo/media/c2ac796d8d3fac04.jpg 720w, /dailyinfo/media/ed66fab567c18d8c.jpg 1200w, /dailyinfo/media/6eb0e1d464278a67.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>法国合作银行 Crédit Mutuel Arkéa 遭到网络攻击，攻击者得以实施最高达 1.33 亿美元的欺诈交易，迫使该银行采取响应措施，暂停了部分系统。</p><p>该银行表示，攻击者利用其自有账户向其他银行机构发起交易，但客户资产未受影响。</p><p>Crédit Mutuel Arkéa 是法国大型银行集团，拥有超过 580 万名成员，资产达 2115 亿欧元。</p><p><a href=\"https://www.wiz.io/lp/ai-security-starter-pack?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Security-Starter-Kit&amp;sfcid=701Vh00000cn7aRIAQ&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AI-Security-Bundle\"><img src=\"/dailyinfo/media/16219945b3a667e6.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>有关该事件的报道于 11 月 2 日出现，最初来自区块链欺诈调查员 ZachXBT，他<a href=\"http://t.me/investigations/372\">警告</a>称前一天多个中心化交易所账户发生了大规模未授权提款。</p><p>据该调查员称，攻击者可能<a href=\"https://t.me/investigations/374\">窃取最多&nbsp;1.18 亿欧元</a>（1.33 亿美元），并以 USDC 和 USDT 稳定币的形式将其提走。</p><p>当时，ZachXBT 没有指明相关实体，但表示由于缺乏公开披露，攻击者得以在 11 月 3 日前<a href=\"https://t.me/investigations/374\">洗钱 3000 万美元</a>，而这些资金若及时披露本会被欧盟执法机构冻结。</p><figure><img alt=\"Movement of stolen amount\" height=\"474\" src=\"/dailyinfo/media/65d0360365d00528.jpg\" srcset=\"/dailyinfo/media/0bd03520ef51bd7b.jpg 720w, /dailyinfo/media/37241dc1a09cf75a.jpg 1200w, /dailyinfo/media/65d0360365d00528.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"900\">\n<figcaption><strong>被盗资金的流向</strong><br>\n<em>来源：ZachXBT</em></figcaption>\n</figure><p>Crédit Mutuel Arkéa 于 11 月 4 日披露了此事，向客户保证该事件“现已结束并得到控制”，各项业务正逐步恢复正常。</p><p>“Crédit Mutuel Arkéa 希望向其所有联盟及子公司的客户保证，此次事件并未对其资产造成影响；只是导致某些转账交易的执行出现延迟，”[机器翻译]该<a href=\"https://www.cm-arkea.com/arkea/banque/upload/docs/application/pdf/2026-11/04112026_-_communique_-_le_credit_mutuel_arkea_annonce_avoir_ete_victime_dune_cyberattaque__2026-11-04_15-40-19_385.pdf\">银行表示</a>。</p><p>不过，该机构也警告称网络钓鱼风险有所上升，敦促客户保持警惕，提防未经请求的通信，避免通过电话或电子邮件分享敏感信息。</p><p>所有可疑消息都应通过直接致电银行顾问进行核实。</p><p>在一个单独的常见问题页面中，该<a href=\"http://www.cm-arkea.com/arkea/banque/assurances/pa_38386/fr/informations-complementaires-suite-a-l-attaque-dont-le-credit-mutuel-arkea-a-ete-victime\">银行解释</a>称，攻击者是通过某服务提供商的平台直接进入其网络的，但排除了 Fortuneo。</p><p>随后，攻击者利用 Arkéa 的自有账户，而非客户账户，与其他银行机构进行交易，并将资金转换为加密货币。</p><p>尽管该银行没有确认 ZachXBT 对被盗金额的估算，但承认金额规模重大，且部分资金已被冻结。</p><p>“您是否确认被盗了 1.18 亿欧元（1.33 亿美元）？我们不确认此信息，只能确认数量级。”</p><p>Arkéa 排除了银行内部人为失误的可能性，并将此次事件描述为“一次精密复杂的攻击”。</p><p>该银行目前正与司法当局和警方合作，以查明此次攻击的确切来源和作案手法。</p><p>BleepingComputer 已联系 Crédit Mutuel Arkéa，以了解更多关于此次攻击及调查进展的信息，但尚未收到回应。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/03f545515f18a71f.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现您现有的防御措施可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体会分析电子邮件的意图、上下文和行为，从而发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>通过为期 14 天的 Microsoft 365 或 Google Workspace 只读扫描，查看有哪些威胁正在穿透防护，无需更改 MX 设置。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始您的免费电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","q4ecagtl22d0shlsqi4lxs630","攻击者利用第三方服务商从 Crédit Mutuel Arkéa 窃取至多 1.33 亿美元","数据窃取","凭据","加密","钓鱼","https://www.bleepingcomputer.com/news/security/hackers-pull-off-133-million-french-bank-heist-via-service-provider/","BleepingComputer",{"_113":114,"_115":-5},"changelogVersion","2026-10-01T08:00","release"]
