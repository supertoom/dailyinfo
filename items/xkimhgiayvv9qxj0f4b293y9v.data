[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":-5,"_57":36,"_58":59},"expiresAt",1795567293000,"id","xkimhgiayvv9qxj0f4b293y9v","title","Broadcom 发布 VMware 23 个漏洞补丁，涵盖 ESX 与 vCenter 严重漏洞","originalTitle","VMware Updates Patch Critical ESX, vCenter Vulnerabilities","summary","Broadcom 为 VMware 多款产品发布 23 个漏洞补丁，其中包括 vCenter 的 CVE-2026-123903 认证绕过漏洞和 ESX 的 CVE-2026-123910、CVE-2026-123911 代码执行漏洞。","reason","source",{"_63":75},"links",{"_59":74},"publishedAt","2026-11-24T16:32:56.000Z","discoveredAt","2026-11-24T16:43:33.165Z","timelineAt","category","vuln","tags",[71,72,73],"score",73,"selected",false,"channel","news","story","x","readingMode","full","author","Ionut Arghire","body",{"_67":-5,"_59":68,"_69":-5,"_70":36},"outline",[],"relatedStories",[],"topics",[60,61],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_62":65,"_63":66},{"_62":30,"_63":64},"slug","name","漏洞披露","vmware","VMware / Broadcom","zh","<p><strong>Broadcom on Tuesday announced the release of patches for 23 vulnerabilities across multiple VMware products, including critical-severity flaws in ESX and vCenter.</strong>\n\n\n\n</p><p>The vCenter patches resolve seven bugs, including a critical authentication bypass issue in the VMware Directory Service tracked as CVE-2026-123903 (CVSS score of 9.8).\n\n\n\n</p><p>Additionally, <a href=\"https://support.broadcom.com/web/ecx/support-content-notification/-/external/content/SecurityAdvisories/0/39626\">the fixes</a> target three denial-of-service (DoS) issues in the VMware Directory Service, a local privilege escalation in a vpxd service script, an arbitrary file write while processing certain archives, and a security policy enforcement failure in the vSphere Distributed Switch (vDS).\n\n\n\n</p><p>The ESX updates resolve seven security issues as well, including three critical-severity weaknesses leading to code execution on the host.\n\n\n\n</p><p>CVE-2026-123910 and CVE-2026-123911 (CVSS score of 9.8) are heap out-of-bounds write and use-after-free flaws in the I/O filter service, while CVE-2026-123912 (CVSS score of 9.3) is an out-of-bounds write vulnerability in the XHCI USB controller that requires local administrative privileges on a virtual machine.\n\n\n\n</p><p>An attacker “may exploit this issue to execute code as the virtual machine’s VMX process running on the host. On ESX, the exploitation is contained within the VMX sandbox whereas, on Workstation and Fusion, this may lead to code execution on the machine where Workstation or Fusion is installed,” Broadcom explains.</p><p><span>Advertisement. Scroll to continue reading.</span></p><p>The remaining four include a stack-based buffer overflow in the VMkernel, a DoS vulnerability in guest RPC, a security bypass in the host configuration store, and a signature verification bypass.\n\n\n\n</p><p>Broadcom also patched eight flaws in Avi Load Balancer that could lead to code execution with root privileges, privilege escalation to root, command execution, password hash leaks, access to the routing management interface and other resources, and unintended file access, and one in VMware Tools leading to DoS.\n\n\n\n</p><p>According to Broadcom, some of the issues were resolved with the <a href=\"https://www.securityweek.com/newly-patched-vmware-vcenter-flaw-exploited-as-zero-day-by-chinese-apt/\">vCenter updates</a> released last week. vCenter version 8.0 U3m contained the fixes, and customers who applied it do not need to update again. vCenter 9.1.x deployments, however, as well as ESX, VMware Tools, Workstation, Fusion, and Avi Load Balancer instances, need to be updated.\n\n\n\n</p><p>“Patches are cumulative, so the updates listed in this advisory also contain the fixes from <a href=\"https://support.broadcom.com/web/ecx/support-content-notification/-/external/content/SecurityAdvisories/0/39495\">VMSA-2026-0009</a> when they are newer than the fixed versions listed in VMSA-2026-0009. However, this advisory does not mention the SDDC Manager updates from VMSA-2026-0009; please ensure you are handling those,” the company <a href=\"https://github.com/vmware/vcf-security-and-compliance-guidelines/blob/main/security-advisories/vmsa-2026-0011/README.md\">notes</a>.\n\n\n\n</p><p>Broadcom makes no mention of any of these vulnerabilities being exploited in the wild, but it’s not uncommon for the company to not warn about exploitation in its public advisories.\n\n\n\n</p><p>On Tuesday, Broadcom also updated its <a href=\"https://support.broadcom.com/web/ecx/support-content-notification/-/external/content/SecurityAdvisories/0/39445\">advisory</a> on <a href=\"https://www.securityweek.com/topics/Node2Shell/\">Node2Shell</a> to add VMware Cloud Foundation version 9.1.2 to the list of fixed releases.\n\n\n\n</p><p><strong>Related:</strong> <a href=\"https://www.securityweek.com/check-point-security-management-servers-hacked-in-ai-assisted-campaign/\">Check Point Security Management Servers Hacked in AI-Assisted Campaign</a>\n\n\n\n</p><p><strong>Related:</strong> <a href=\"https://www.securityweek.com/n-able-patches-critical-flaw-disclosed-after-mail-assure-cyberattack/\">N-able Patches Critical Flaw Discovered After Mail Assure Cyberattack</a>\n\n\n\n</p><p><strong>Related:</strong> <a href=\"https://www.securityweek.com/amazon-china-linked-hackers-ai-agents-exploited-medical-software-zero-day/\">Amazon: China-Linked Hackers’ AI Agents Exploited Medical Software Zero-Day</a>\n\n\n\n</p><p><strong>Related:</strong> <a href=\"https://www.securityweek.com/ruby-patches-ruby2shell-vulnerability-that-could-lead-to-rce/\">Ruby Patches Ruby2Shell Vulnerability That Could Lead to RCE</a>\n\n\n\n</p>","zhKind","complete","漏洞","补丁","VMware","https://www.securityweek.com/vmware-updates-patch-critical-esx-vcenter-vulnerabilities/","SecurityWeek",{"_77":78,"_79":-5},"changelogVersion","2026-10-01T08:00","release"]
