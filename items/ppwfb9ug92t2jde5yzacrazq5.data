[{"_1":2,"_3":4},"root",{"_5":135},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794616832000,"id","ppwfb9ug92t2jde5yzacrazq5","title","Siemens 多款楼宇自动化与能源产品受 php2shell 漏洞影响","originalTitle","Siemens Building Automation and Energy Products","summary","Siemens 多款楼宇自动化与能源产品受 PHP 核心运行时远程代码执行漏洞 CVE-2026-109618 和 CVE-2026-109619 影响，攻击无需认证；前者 CVSS v3.1 为 9.8，后者为 8.1。","reason","公告按产品列明受影响范围、漏洞触发机制与处置状态，可用于核对 Siemens 能源和楼宇自动化设备的升级优先级。","source",{"_71":134},"links",{"_124":133},"publishedAt","2026-11-12T12:00:00.000Z","discoveredAt","2026-11-12T17:24:24.135Z","timelineAt","category","vuln","tags",[117,128,129,130,131,132],"score",73,"selected",true,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","CISA","body",{"_61":123,"_124":-5,"_125":126,"_127":37},"outline",[79,80,81,82,83,84,85,86,87,88,89,90,91],"relatedStories",[75],"topics",[68,69],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fNTtq1SsR-J8","reportCount",1,"additionalSourceCount",0,{"_70":73,"_71":74},{"_70":31,"_71":72},"slug","name","漏洞披露","industrial","工业控制",{"_76":77,"_13":78},"publicId","dc396fc7-8ca8-43c6-a297-c10a57e3eff2","PHP2Shell在野利用扩大至Palo Alto管理接口",{"_11":121,"_93":122,"_95":96},{"_11":118,"_93":119,"_95":120},{"_11":116,"_93":117,"_95":96},{"_11":114,"_93":115,"_95":113},{"_11":111,"_93":112,"_95":113},{"_11":109,"_93":110,"_95":96},{"_11":107,"_93":108,"_95":96},{"_11":105,"_93":106,"_95":96},{"_11":103,"_93":104,"_95":96},{"_11":101,"_93":102,"_95":96},{"_11":99,"_93":100,"_95":96},{"_11":97,"_93":98,"_95":96},{"_11":92,"_93":94,"_95":96},"sec-13","text","法律声明和使用条款","level",2,"sec-12","修订历史","sec-11","公告转换免责声明","sec-10","推荐实践","sec-9","使用条款","sec-8","其他资源","sec-7","一般建议","sec-6","致谢","sec-5","23 个受影响产品",4,"sec-4","11 个受影响产品","sec-3","漏洞","sec-2","背景",3,"sec-1","摘要","<p><a href=\"https://github.com/cisagov/CSAF/blob/develop/csaf_files/OT/white/2026/icsa-26-316-01.json\"><strong>查看 CSAF</strong></a></p><h2 id=\"sec-1\">摘要</h2><p><strong>2026 年 10 月 21 日，PHP 项目和安全研究人员披露了 PHP 核心语言运行时中的两个严重级别、未认证远程代码执行漏洞，统称为“php2shell”（对应 CVE-2026-109618 和 CVE-2026-109619）。本公告说明了这些漏洞对 various Siemens 软件产品的影响状态。作为一项通用安全措施，Siemens 强烈建议使用适当的机制保护设备网络访问。为在受保护的 IT 环境中运行设备，Siemens 建议根据 Siemens 的操作指南配置环境，并遵循产品手册中的建议。Siemens 正在积极监测局势，并评估这些漏洞对我们产品组合的影响。由于该评估仍在进行中，随着新的技术细节和供应商更新陆续出现，我们的调查结果可能发生变化。一旦更新后的调查结果、指导和修复建议可用，我们将立即发布。Siemens 已为若干受影响产品发布了新版本，并建议更新至最新版本。Siemens 正在准备进一步的修复措施，并建议对于尚无修复或尚未发布修复的产品采取缓解措施。</strong></p><p>以下版本的 Siemens Building Automation 和 Energy 产品受到影响：</p><ul>\n<li>AMIS TS vers:all/*（CVE-2026-109618、CVE-2026-109619）</li>\n<li>blueplanet 360 NX3 M6 WM OD IISX vers:all/*（CVE-2026-109618、CVE-2026-109619）</li>\n<li>blueplanet 360 NX3 M6 WM OD IISX - S vers:all/*（CVE-2026-109618、CVE-2026-109619）</li>\n<li>Energy Engage V2.0SP9 vers:all/*（CVE-2026-109618、CVE-2026-109619）</li>\n<li>Energy Engage V3.1SP1 vers:all/*（CVE-2026-109618、CVE-2026-109619）</li>\n<li>Heliox Rapid vers:all/*（）Local Monitoring bt-monitoring-vm vers:intdot/&lt;20261103（CVE-2026-109618、CVE-2026-109619）</li>\n<li>Spectrum Power 3 vers:all/*（CVE-2026-109619）</li>\n<li>Spectrum Power 4 vers:all/*、vers:all/*、vers:all/*（CVE-2026-109618、CVE-2026-109619、CVE-2026-109618、CVE-2026-109619、CVE-2026-109618、CVE-2026-109619）</li>\n<li>Spectrum Power 7 vers:all/*（CVE-2026-109618、CVE-2026-109619）</li>\n<li>Spectrum Power TG vers:all/*（CVE-2026-109618、CVE-2026-109619）</li>\n</ul><table>\n<thead>\n<tr>\n<th>CVSS</th>\n<th>供应商</th>\n<th>设备</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>v3 9.8</td>\n<td>Siemens</td>\n<td>AMIS TS</td>\n</tr>\n</tbody>\n</table><table>\n<thead>\n<tr>\n<th>1 个漏洞</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>释放后重用</td>\n</tr>\n</tbody>\n</table><h3 id=\"sec-2\">背景</h3><ul>\n<li><strong>关键基础设施行业：</strong>能源</li>\n<li><strong>部署国家/地区：</strong>全球</li>\n<li><strong>公司总部所在地：</strong>德国</li>\n</ul><hr><h2 id=\"sec-3\">漏洞</h2><p>CVE-2026-109618</p><p>PHP 使用 longjmp() 处理内存不足（OOM）错误，以退出当前上下文并中止请求处理。某些上下文可能未正确考虑这种情况，在执行内存分配前让请求内存处于未初始化状态。随后的请求清理过程可能会读取此内存或根据此内存进行分支判断。多种 OOM 策略均可持续触发此状况并导致远程代码执行（RCE）。</p><h4 id=\"sec-4\">11 个受影响产品</h4><hr><h5>AMIS TS</h5><p>产品状态：known_affected、known_not_affected</p><h5>修复措施</h5><p><strong>暂无</strong><br>目前没有可用的修复</p><hr><h5>blueplanet 360 NX3 M6 WM OD IISX</h5><p>产品状态：known_affected、known_not_affected</p><h5>修复措施</h5><p><strong>暂无</strong><br>目前没有可用的修复</p><hr><h5>Energy Engage V2.0SP9</h5><p>产品状态：known_affected、known_not_affected</p><h5>修复措施</h5><p><strong>计划不修复</strong><br>目前没有修复计划</p><hr><h5>Energy Engage V3.1SP1</h5><p>产品状态：known_affected、known_not_affected</p><h5>修复措施</h5><p><strong>供应商修复</strong><br>将 PHP 版本升级至 V8.1.34 release 6</p><hr><h5>blueplanet 360 NX3 M6 WM OD IISX - S</h5><p>产品状态：known_affected, known_not_affected</p><h5>修复措施</h5><p><strong>暂无</strong><br>目前没有可用的修复</p><hr><h5>Local Monitoring bt-monitoring-vm &lt; V20261103</h5><p>产品状态：known_affected, known_not_affected</p><h5>修复措施</h5><p><strong>供应商修复</strong><br>更新至 V20261103 或更高版本</p><hr><h5>使用 Nagios 或 Zabbix 的 Spectrum Power 4</h5><p>产品状态：known_affected, known_not_affected</p><h5>修复措施</h5><p><strong>暂无</strong><br>目前没有可用的修复</p><hr><h5>配备 Web Office Portal V3.0、V3.1 和 V3.2 的 Spectrum Power 4</h5><p>产品状态：known_affected, known_not_affected</p><h5>修复措施</h5><p><strong>暂无</strong><br>目前没有可用的修复</p><hr><h5>配备 HISViews V1.0 的 Spectrum Power 4</h5><p>产品状态：known_affected, known_not_affected</p><h5>修复措施</h5><p><strong>暂无</strong><br>目前没有可用的修复</p><hr><h5>使用 IHM (NagiosXI) 的 Spectrum Power 7</h5><p>产品状态：known_affected, known_not_affected</p><h5>修复措施</h5><p><strong>供应商修复</strong><br>Red Hat 为 RHEL 8 和 9 发布了 PHP 安全补丁</p><hr><h5>基于 Microsoft Windows 且使用 WebConsole 和 WebQuery 组件的 Spectrum Power TG</h5><p>产品状态：known_affected, known_not_affected</p><h5>修复措施</h5><p><strong>供应商修复</strong><br>将 PHP 版本升级至 V8.5.12</p><hr><h5>其他指标</h5><p><strong>相关 CWE：</strong> <a href=\"https://cwe.mitre.org/data/definitions/416.html\">CWE-416 释放后重用</a></p><table>\n<thead>\n<tr>\n<th>CVSS 版本</th>\n<th>基础评分</th>\n<th>基础严重性</th>\n<th>向量字符串</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>3.1</td>\n<td>9.8</td>\n<td>严重</td>\n<td><a href=\"https://www.first.org/cvss/calculator/3.1#CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H\">CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H</a></td>\n</tr>\n</tbody>\n</table><hr><p><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-109618\">查看 CVE 详情</a></p><p>CVE-2026-109619</p><p>PHP 存在多种全局状态，这些状态会暂时指向请求内存。在某些情况下，全局状态可能未被正确重置，或在重置后又被重新填充。随后，全局状态甚至可能在请求内存已被释放后仍指向该内存。后续请求可能会读取该过期状态，或以其为依据进行分支处理，且此时状态尚未完全初始化。多种策略都可能触发此状况并导致远程代码执行 (RCE)。</p><h4 id=\"sec-5\">23 个受影响产品</h4><hr><h5>AMIS TS</h5><p>产品状态：known_affected, known_not_affected</p><h5>修复措施</h5><p><strong>暂无</strong><br>目前没有可用的修复</p><hr><h5>blueplanet 360 NX3 M6 WM OD IISX</h5><p>产品状态：known_affected, known_not_affected</p><h5>修复措施</h5><p><strong>暂无</strong><br>目前没有可用的修复</p><hr><h5>Energy Engage V2.0SP9</h5><p>产品状态：known_affected, known_not_affected</p><h5>修复措施</h5><p><strong>不计划修复</strong><br>目前没有修复计划</p><hr><h5>Energy Engage V3.1SP1</h5><p>产品状态：known_affected, known_not_affected</p><h5>修复措施</h5><p><strong>供应商修复</strong><br>将 PHP 版本升级至 V8.1.34 release 6</p><hr><h5>blueplanet 360 NX3 M6 WM OD IISX - S</h5><p>产品状态：known_affected, known_not_affected</p><h5>修复措施</h5><p><strong>暂无</strong><br>目前没有可用的修复</p><hr><h5>Local Monitoring bt-monitoring-vm &lt; V20261103</h5><p>产品状态：known_affected, known_not_affected</p><h5>修复措施</h5><p><strong>供应商修复</strong><br>更新至 V20261103 或更高版本</p><hr><h5>使用 Nagios 或 Zabbix 的 Spectrum Power 4</h5><p>产品状态：known_affected, known_not_affected</p><h5>修复措施</h5><p><strong>暂无</strong><br>目前没有可用的修复</p><hr><h5>配备 Web Office Portal V3.0、V3.1 和 V3.2 的 Spectrum Power 4</h5><p>产品状态：known_affected, known_not_affected</p><h5>修复措施</h5><p><strong>暂无</strong><br>目前没有可用的修复</p><hr><h5>配备 HISViews V1.0 的 Spectrum Power 4</h5><p>产品状态：known_affected, known_not_affected</p><h5>修复措施</h5><p><strong>暂无</strong><br>目前没有可用的修复</p><hr><h5>使用 IHM (NagiosXI) 的 Spectrum Power 7</h5><p>产品状态：known_affected, known_not_affected</p><h5>修复措施</h5><p><strong>供应商修复</strong><br>Red Hat 为 RHEL 8 和 9 发布了 PHP 安全补丁</p><hr><h5>基于 Microsoft Windows 并使用 WebConsole 和 WebQuery 组件的 Spectrum Power TG</h5><p>产品状态：known_affected, known_not_affected</p><h5>修复措施</h5><p><strong>供应商修复</strong><br>将 PHP 版本升级至 V8.5.12</p><hr><h5>AMIS TS</h5><p>产品状态：known_affected, known_not_affected</p><h5>修复措施</h5><p><strong>暂无修复</strong><br>目前没有可用修复</p><hr><h5>blueplanet 360 NX3 M6 WM OD IISX</h5><p>产品状态：known_affected, known_not_affected</p><h5>修复措施</h5><p><strong>暂无修复</strong><br>目前没有可用修复</p><hr><h5>Energy Engage V2.0SP9</h5><p>产品状态：known_affected, known_not_affected</p><h5>修复措施</h5><p><strong>无修复计划</strong><br>目前没有修复计划</p><hr><h5>Energy Engage V3.1SP1</h5><p>产品状态：known_affected, known_not_affected</p><h5>修复措施</h5><p><strong>供应商修复</strong><br>将 PHP 版本升级至 V8.1.34 release 6</p><hr><h5>blueplanet 360 NX3 M6 WM OD IISX - S</h5><p>产品状态：known_affected, known_not_affected</p><h5>修复措施</h5><p><strong>暂无修复</strong><br>目前没有可用修复</p><hr><h5>Local Monitoring bt-monitoring-vm &lt; V20261103</h5><p>产品状态：known_affected, known_not_affected</p><h5>修复措施</h5><p><strong>供应商修复</strong><br>更新至 V20261103 或更高版本</p><hr><h5>运行在 Red Hat Enterprise Linux version (RHEL) 7 上的使用 IHM (NagiosXI) 的 Spectrum Power 3</h5><p>产品状态：known_affected, known_not_affected</p><h5>修复措施</h5><p><strong>供应商修复</strong><br>Red Hat 为 RHEL 7 发布了 PHP 安全补丁</p><hr><h5>使用 Nagios 或 Zabbix 的 Spectrum Power 4</h5><p>产品状态：known_affected, known_not_affected</p><h5>修复措施</h5><p><strong>暂无修复</strong><br>目前没有可用修复</p><hr><h5>配备 Web Office Portal V3.0、V3.1 和 V3.2 的 Spectrum Power 4</h5><p>产品状态：known_affected, known_not_affected</p><h5>修复措施</h5><p><strong>暂无修复</strong><br>目前没有可用修复</p><hr><h5>配备 HISViews V1.0 的 Spectrum Power 4</h5><p>产品状态：known_affected, known_not_affected</p><h5>修复措施</h5><p><strong>暂无修复</strong><br>目前没有可用修复</p><hr><h5>使用 IHM (NagiosXI) 的 Spectrum Power 7</h5><p>产品状态：known_affected, known_not_affected</p><h5>修复措施</h5><p><strong>供应商修复</strong><br>Red Hat 为 RHEL 8 和 9 发布了 PHP 安全补丁</p><hr><h5>基于 Microsoft Windows 并使用 WebConsole 和 WebQuery 组件的 Spectrum Power TG</h5><p>产品状态：known_affected, known_not_affected</p><h5>修复措施</h5><p><strong>供应商修复</strong><br>将 PHP 版本升级至 V8.5.12</p><hr><h5>附加指标</h5><p><strong>相关 CWE：</strong> <a href=\"https://cwe.mitre.org/data/definitions/416.html\">CWE-416 释放后重用</a></p><table>\n<thead>\n<tr>\n<th>CVSS 版本</th>\n<th>基础评分</th>\n<th>基础严重性</th>\n<th>向量字符串</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>3.1</td>\n<td>8.1</td>\n<td>HIGH</td>\n<td><a href=\"https://www.first.org/cvss/calculator/3.1#CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:H\">CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:H</a></td>\n</tr>\n</tbody>\n</table><hr><p><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-109619\">查看 CVE 详情</a></p><hr><h2 id=\"sec-6\">致谢</h2><ul>\n<li>Siemens ProductCERT 已向 CISA 报告了这些漏洞。</li>\n</ul><hr><h2 id=\"sec-7\">一般建议</h2><p>全球关键电力系统运营商（例如 TSO 或 DSO）通常会受到法规要求，通过采用多级冗余二次保护方案来增强电网韧性。因此，建议运营商检查是否已采取适当的韧性保护措施。借助电网设计，可以将影响电网可靠性的网络事件风险降至最低。Siemens 强烈建议使用相应工具以及产品随附的成文流程来应用所提供的安全更新。如果产品支持，可以使用自动化方式将安全更新应用到多个产品实例。Siemens 强烈建议在应用任何安全更新之前进行预先验证，并由受过培训的人员在目标环境中监督更新流程。作为一项通用安全措施，Siemens 强烈建议使用适当的机制（例如防火墙、网络分段、VPN）保护网络访问。建议根据我们的操作指南配置环境，以便在受保护的 IT 环境中运行设备。推荐的安全指南可在以下位置找到：<a href=\"https://www.siemens.com/gridsecurity\">https://www.siemens.com/gridsecurity</a></p><hr><h2 id=\"sec-8\">其他资源</h2><p>如需进一步咨询 Siemens 产品和解决方案中的安全漏洞，请联系 Siemens ProductCERT：<a href=\"https://www.siemens.com/cert/advisories\">https://www.siemens.com/cert/advisories</a></p><hr><h2 id=\"sec-9\">使用条款</h2><p>使用 Siemens 安全公告须遵守以下列出的条款和条件：<a href=\"https://www.siemens.com/productcert/terms-of-use\">https://www.siemens.com/productcert/terms-of-use</a>。</p><hr><h2 id=\"sec-10\">推荐实践</h2><p>CISA 建议用户采取防御措施，将利用这些漏洞的风险降至最低。</p><ul>\n<li>尽量减少所有控制系统设备和/或系统的网络暴露，确保它们<a href=\"https://www.cisa.gov/uscert/ics/alerts/ICS-ALERT-10-301-01\">无法从互联网访问</a>。</li>\n<li>将控制网络和远程设备置于防火墙之后，并与业务网络隔离。</li>\n<li>需要远程访问时，使用更安全的方法，例如虚拟专用网络（VPN），但应注意 VPN 可能存在漏洞，应更新至可用的最新版本。此外，也应认识到，VPN 的安全性取决于所连接的设备。</li>\n</ul><p>CISA 提醒组织在部署防御措施之前进行适当的影响分析和风险评估。</p><p>CISA 还在 ICS 网页面的 <a href=\"https://www.cisa.gov/resources-tools/resources/ics-recommended-practices\">控制系统安全推荐实践</a>章节中提供了相关内容，网址为 <a href=\"https://www.cisa.gov/topics/industrial-control-systems\">cisa.gov/ics</a>。CISA 提供了多份介绍网络防御最佳实践的资料，供阅读和下载，其中包括 <a href=\"https://www.cisa.gov/sites/default/files/recommended_practices/NCCIC_ICS-CERT_Defense_in_Depth_2016_S508C.pdf\">通过纵深防御策略提升工业控制系统网络安全</a>。</p><p>CISA 鼓励组织实施推荐的网络安全策略，以<a href=\"https://www.cisa.gov/sites/default/files/publications/Cybersecurity_Best_Practices_for_Industrial_Control_Systems.pdf\">主动防御 ICS 资产</a>。</p><p>更多缓解指南和推荐实践可在此 ICS 网页面的技术信息文件中公开获取：<a href=\"https://www.cisa.gov/topics/industrial-control-systems\">cisa.gov/ics</a>，文件为 <a href=\"https://www.cisa.gov/news-events/news/targeted-cyber-intrusion-detection-and-mitigation-strategies-update-b\">ICS-TIP-12-146-01B--定向网络入侵检测与缓解策略</a>。</p><p>发现疑似恶意活动的组织应遵循既定的内部流程，并将发现结果报告给 CISA，以便进行跟踪并与其他事件进行关联分析。</p><hr><h2 id=\"sec-11\">公告转换免责声明</h2><p>本 ICSA 是对 Siemens ProductCERT <a href=\"https://productcert.siemens.com/productcert/html/ssa-166980.html\">SSA-166980</a> 的逐字转载，内容直接转换自供应商的通用安全公告框架（CSAF）公告。为提高可见性，本公告重新发布至 CISA 网站，并且仅按“原样”提供，供 informational purposes 使用。对于重新发布的公告，CISA 不对其编辑或技术准确性负责，并且不对本公告中包含的任何信息提供任何形式的担保。此外，CISA 不认可任何商业产品或服务。如对本公告有任何疑问，请直接联系 Siemens ProductCERT。</p><h2 id=\"sec-12\">修订历史</h2><ul>\n<li><strong>首次发布日期：</strong>2026-10-26</li>\n</ul><table>\n<thead>\n<tr>\n<th>日期</th>\n<th>修订</th>\n<th>摘要</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>2026-10-26</td>\n<td>1</td>\n<td>发布日期</td>\n</tr>\n<tr>\n<td>2026-10-27</td>\n<td>2</td>\n<td>更新了已知不受影响产品列表</td>\n</tr>\n<tr>\n<td>2026-10-29</td>\n<td>3</td>\n<td>将 AMIS TS、Energy Engage V2.0SP9、Energy Engage V3.1SP1、Spectrum Power 3、Spectrum Power 4、Spectrum Power 7 和 Spectrum Power TG 添加到受影响产品中，并更新了已知不受影响产品列表</td>\n</tr>\n<tr>\n<td>2026-11-05</td>\n<td>4</td>\n<td>更新了已知不受影响产品和已知受影响产品列表</td>\n</tr>\n<tr>\n<td>2026-11-12</td>\n<td>5</td>\n<td>CISA 首次重新发布 Siemens ProductCERT SSA-166980 公告</td>\n</tr>\n</tbody>\n</table><hr><h2 id=\"sec-13\">法律声明和使用条款</h2>","original","zhKind","translation","complete","补丁","工控","PHP","Microsoft","Red Hat","https://www.cisa.gov/news-events/ics-advisories/icsa-26-316-01","CISA 安全公告",{"_136":137,"_138":-5},"changelogVersion","2026-10-01T08:00","release"]
