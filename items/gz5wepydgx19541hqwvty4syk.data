[{"_1":2,"_3":4},"root",{"_5":150},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":37,"_59":60},"expiresAt",1794530485000,"id","gz5wepydgx19541hqwvty4syk","title","Cisco ASA 与 FTD 远程访问 SSL VPN 隧道 DoS 漏洞 CVE-2026-76418 已被利用","originalTitle","Cisco Secure Firewall Adaptive Security Appliance and Secure Firewall Threat Defense Software Remote Access SSL VPN Tunnel Denial of Service Vulnerability","summary","Cisco ASA Software 与 FTD Software 的远程访问 SSL VPN 隧道存在 CVE-2026-76418，未认证远程攻击者可在隧道组启用二次认证时发送特制请求，触发设备意外重载并造成拒绝服务（DoS）；成功发起 VPN 登录并非必要条件。","reason","公告披露了真实攻击条件、配置暴露范围和逐版本修复版本，并提供临时缓解措施，便于暴露环境评估处置。","source",{"_72":149},"links",{"_139":148},"publishedAt","2026-10-28T11:15:00.000Z","discoveredAt","2026-10-29T00:16:10.868Z","timelineAt","category","vuln","tags",[144,73,145,146,147],"score",86,"selected",true,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body",{"_60":138,"_139":-5,"_140":141,"_142":143},"outline",[81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98],"relatedStories",[77],"topics",[67,68,69],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","fIyVQktMY9Rw","reportCount",2,"additionalSourceCount",1,{"_70":75,"_72":76},{"_70":31,"_72":74},{"_70":71,"_72":73},"slug","exploited","name","在野利用","漏洞披露","cisco","Cisco / 思科",{"_78":79,"_13":80},"publicId","5c8dd0e5-023b-4e8c-b2f9-f7dfed950c69","Cisco VPN拒绝服务漏洞确认遭在野利用",{"_11":136,"_100":137,"_102":64},{"_11":134,"_100":135,"_102":64},{"_11":132,"_100":133,"_102":64},{"_11":130,"_100":131,"_102":119},{"_11":128,"_100":129,"_102":119},{"_11":126,"_100":127,"_102":64},{"_11":124,"_100":125,"_102":64},{"_11":122,"_100":123,"_102":119},{"_11":120,"_100":121,"_102":119},{"_11":117,"_100":118,"_102":119},{"_11":115,"_100":116,"_102":64},{"_11":113,"_100":114,"_102":64},{"_11":111,"_100":112,"_102":64},{"_11":109,"_100":110,"_102":64},{"_11":107,"_100":108,"_102":64},{"_11":105,"_100":106,"_102":64},{"_11":103,"_100":104,"_102":64},{"_11":99,"_100":101,"_102":64},"sec-18","text","反馈","level","sec-17","法律免责声明","sec-16","Revision History","sec-15","URL","sec-14","Related to This Advisory","sec-13","Cisco Security Vulnerability Policy","sec-12","Source","sec-11","Exploitation and Public Announcements","sec-10","Additional Resources",3,"sec-9","Cisco Secure Firewall ASA, Secure FMC, and Secure FTD Software","sec-8","固定版本","sec-7","固定软件","sec-6","临时解决方案","sec-5","确定隧道组配置","sec-4","确定 SSL 远程访问 VPN 配置","sec-3","受影响的产品","sec-2","摘要","sec-1","Cisco Secure Firewall Adaptive Security Appliance 和 Secure Firewall Threat Defen","<table>\n\t\t\t\t\t<tbody><tr>\n\t\t\t\t\t\t<td>\n\t\t\t\t\t\t\t<h2 id=\"sec-1\">Cisco Secure Firewall Adaptive Security Appliance 和 Secure Firewall Threat Defense Software 远程访问 SSL VPN 隧道拒绝服务漏洞</h2>\n\n<p>高</p>\n\n<p>CVE-2026-76418</p>\n\n\n<p>CWE-690</p>\n\n\n\n\n<p><a href=\"https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-asaftd-tunnel-dos-s6mgkb75/csaf/cisco-sa-asaftd-tunnel-dos-s6mgkb75.json\">\n\n            \n            下载 CSAF\n          </a>\n</p>\n<p><a>\n          电子邮件\n        </a>\n</p>\n\n\n<h2 id=\"sec-2\">\n<p>\n                        摘要\n                        \n                      </p>\n</h2>\n<ul>\n<li>\n<p>Cisco Secure Firewall Adaptive Security Appliance (ASA) Software 和 Cisco Secure Firewall Threat Defense (FTD) Software 的远程访问 SSL VPN 服务中存在一个漏洞，可能允许未经身份验证的远程攻击者导致设备意外重新加载，从而造成拒绝服务 (DoS) 状态。</p>\n<p>此漏洞是由于在隧道组上配置了辅助身份验证时出现逻辑错误所致。攻击者可以在连接 SSL 远程访问 VPN 时发送特制请求来利用此漏洞。成功利用可能使攻击者导致受影响设备重新加载，从而造成 DoS 状态。 </p>\n\n<p>Cisco 已发布修复此漏洞的软件更新。没有可解决此漏洞的变通方案。</p>\n<p>本公告可通过以下链接获取：<br><a href=\"https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-asaftd-tunnel-dos-s6mgkb75\">https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-asaftd-tunnel-dos-s6mgkb75</a></p>\n</li>\n</ul>\n<h2 id=\"sec-3\">\n<p>\n                          受影响的产品\n                          \n                        </p>\n</h2>\n<ul>\n<li>\n<p>如果 Cisco 设备运行易受攻击版本的 Cisco Secure Firewall ASA Software 或 Cisco Secure FTD Software、SSL 远程访问 VPN 登录服务可访问，并且在下文所述的隧道组范围内配置了辅助身份验证，则此漏洞会影响这些 Cisco 设备。</p>\n<p>有关哪些 Cisco 软件版本易受攻击的信息，请参阅本公告的 <a href=\"https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-asaftd-tunnel-dos-s6mgkb75?vs_f=Cisco%20Security%20Advisory%26vs_cat=Security%20Intelligence%26vs_type=RSS%26vs_p=Cisco%20Secure%20Firewall%20Adaptive%20Security%20Appliance%20and%20Secure%20Firewall%20Threat%20Defense%20Software%20Remote%20Access%20SSL%20VPN%20Tunnel%20Denial%20of%20Service%20Vulnerability%26vs_k=1#fs\">已修复软件</a> 部分。</p>\n<h3 id=\"sec-4\">确定 SSL 远程访问 VPN 配置</h3>\n<p>如果运行配置中包含 <strong>webvpn</strong> 关键字，并且至少在一个接口上启用了 SSL VPN，则该配置易受攻击，如下表所示：</p>\n<table>\n<thead>\n<tr>\n<th>Cisco Secure Firewall ASA Software 和 Secure FTD Software 功能</th>\n<th>易受攻击的配置</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>SSL 远程访问 VPN<sup>1</sup></td>\n<td>\n<pre>webvpn<br> enable &lt;<em>interface_name</em>&gt;</pre>\n</td>\n</tr>\n</tbody>\n</table>\n<p>1. 对于 Cisco Secure FTD Software，可在 Cisco Secure Firewall Management Center (FMC) Software 中通过 <strong>Devices &gt; VPN &gt; Remote Access</strong> 启用远程访问 VPN 功能，或在 Cisco Secure Firewall Device Manager (FDM) 中通过 <strong>Remote Access VPN</strong> 启用。</p>\n<h3 id=\"sec-5\">确定隧道组配置</h3>\n<p>如果配置了 <strong>tunnel-group-list enable</strong>，请检查所有隧道组（包括默认隧道组 <strong>DefaultWEBVPNGroup</strong>）是否配置了 <strong>secondary-authentication-server-group</strong>。</p>\n<p><strong>注意：</strong> 此检查并不仅限于登录页面上组列表中显示的配置文件。</p>\n<p>如果不存在 <strong>tunnel-group-list enable</strong>，或已使用 <strong>no tunnel-group-list enable</strong> 命令将其移除，请检查默认隧道组 <strong>DefaultWEBVPNGroup</strong> 是否配置了 <strong>secondary-authentication-server-group</strong>，因为禁用组列表时，如果该默认组使用辅助身份验证，暴露情况仍然存在。</p>\n<p><strong>注意：</strong>在 Cisco Secure FTD Software 上，应审查已部署的远程访问 VPN 策略，以及 Cisco Secure FMC Software 或 Cisco Secure FDM 中生成的设备运行配置。无需成功登录 VPN 即可到达受影响的处理路径。</p>\n\n\n<p>据已知，只有本公告<a href=\"https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-asaftd-tunnel-dos-s6mgkb75?vs_f=Cisco%20Security%20Advisory%26vs_cat=Security%20Intelligence%26vs_type=RSS%26vs_p=Cisco%20Secure%20Firewall%20Adaptive%20Security%20Appliance%20and%20Secure%20Firewall%20Threat%20Defense%20Software%20Remote%20Access%20SSL%20VPN%20Tunnel%20Denial%20of%20Service%20Vulnerability%26vs_k=1#vp\">受影响产品</a>部分列出的产品会受到此漏洞影响。</p>\n<p>Cisco 已确认此漏洞不影响以下 Cisco 产品：</p>\n<ul>\n<li>Cloud-delivered Firewall (CDFW)</li>\n<li>Cloud-delivered Firewall Management Center (cdFMC)</li>\n<li>Secure Access (CSA)</li>\n<li>Secure FMC Software</li>\n</ul>\n\n\n\n\n</li>\n</ul>\n<h2 id=\"sec-6\">\n\n<p>\n                          临时解决方案\n                          \n                        </p>\n</h2>\n<ul>\n<li>\n<p>没有能够解决此漏洞的临时解决方案。但可以采取缓解措施，即在任何用户配置的隧道组列表或默认隧道组 <strong>DefaultWEBVPNGroup</strong> 上禁用辅助身份验证。</p>\n<p><strong>情况 1：</strong>如果 <strong>DefaultWEBVPNGroup </strong>未使用辅助身份验证，请禁用隧道组列表。在 WebVPN 配置模式下，输入 <strong>no tunnel-group-list enable</strong>。禁用隧道组列表后，用户将不再能够从提供的列表中选择连接配置文件（<strong>tunnel-group</strong> 名称），而是需要知道正确的配置文件。</p>\n<p><strong>情况 2：</strong>如果 <strong>DefaultWEBVPNGroup </strong>使用辅助身份验证，请使用 <strong>no secondary-authentication-server-group</strong> CLI 命令移除辅助身份验证。禁用辅助身份验证后，远程访问 VPN 的安全态势会降低。</p>\n<p>尽管此缓解措施已在测试环境中部署并证实有效，但客户仍应确定其在自己环境及自身使用条件下的适用性和有效性。客户应意识到，根据客户自身的部署场景和限制，实施任何临时解决方案或缓解措施都可能会对其网络的功能、性能和/或安全态势产生负面影响。在首次评估其对自身环境的适用性及对该环境可能造成的任何影响之前，客户不应部署任何临时解决方案或缓解措施。</p>\n<p>Cisco 强烈建议升级至本公告<a href=\"https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-asaftd-tunnel-dos-s6mgkb75?vs_f=Cisco%20Security%20Advisory%26vs_cat=Security%20Intelligence%26vs_type=RSS%26vs_p=Cisco%20Secure%20Firewall%20Adaptive%20Security%20Appliance%20and%20Secure%20Firewall%20Threat%20Defense%20Software%20Remote%20Access%20SSL%20VPN%20Tunnel%20Denial%20of%20Service%20Vulnerability%26vs_k=1#fs\">固定软件</a>部分列出的已修复软件。</p>\n\n</li>\n</ul>\n<h2 id=\"sec-7\">\n<p>\n                          固定软件\n                          \n                        </p>\n</h2>\n<ul>\n<li>\n<p>Cisco 认为，在可升级至固定软件版本之前，任何临时解决方案和缓解措施（如适用）都只是临时性方案。为修复此漏洞并避免出现本公告所述的未来暴露风险，Cisco 强烈建议客户升级至本公告中指定的固定软件。</p>\n\n\n<h3 id=\"sec-8\">固定版本</h3>\n<p>在下表中，左侧列出了 Cisco 软件版本，右侧指示某个版本是否受本公告所述漏洞影响，以及首次包含此漏洞修复的版本。建议客户按照本部分的说明升级至适当的<a href=\"https://sec.cloudapps.cisco.com/security/center/resources/security_vulnerability_policy.html#fixes\">固定软件版本</a>。</p>\n<table>\n<thead>\n<tr>\n<th>Cisco Secure Firewall ASA Software 版本</th>\n<th>首次修复版本</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>9.16 及更早版本</td>\n<td>9.16.4.104</td>\n</tr>\n<tr>\n<td>9.18</td>\n<td>9.18.4.96</td>\n</tr>\n<tr>\n<td>9.20</td>\n<td>9.20.4.50</td>\n</tr>\n<tr>\n<td>9.22</td>\n<td>9.22.3.200</td>\n</tr>\n<tr>\n<td>9.23</td>\n<td>9.23.1.48</td>\n</tr>\n<tr>\n<td>9.24</td>\n<td>9.24.1.27<br>9.24.10.1</td>\n</tr>\n</tbody>\n</table>\n<br>\n<table>\n<thead>\n<tr>\n<th>Cisco Secure FTD Software 版本</th>\n<th>首次修复版本</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>7.0 及更早版本</td>\n<td>7.0.11</td>\n</tr>\n<tr>\n<td>7.2</td>\n<td>7.2.13</td>\n</tr>\n<tr>\n<td>7.4</td>\n<td>7.4.9</td>\n</tr>\n<tr>\n<td>7.6</td>\n<td>7.6.7</td>\n</tr>\n<tr>\n<td>7.7</td>\n<td>7.7.14</td>\n</tr>\n<tr>\n<td>10.0</td>\n<td>10.0.3</td>\n</tr>\n<tr>\n<td>10.1</td>\n<td>10.1.1</td>\n</tr>\n</tbody>\n</table>\n<p>The Cisco Product Security Incident Response Team (PSIRT) validates only the affected and fixed release information that is documented in this advisory.</p>\n<h3 id=\"sec-9\">Cisco Secure Firewall ASA, Secure FMC, and Secure FTD Software</h3>\n<p>To help customers determine their exposure to vulnerabilities in Cisco Secure Firewall ASA, Secure FMC, and Secure FTD Software, Cisco provides the <a href=\"https://sec.cloudapps.cisco.com/security/center/softwarechecker.x\">Cisco Software Checker</a>. This tool identifies any Cisco security advisories that impact a specific software release and the earliest release that fixes the vulnerabilities that are described in each advisory (“First Fixed”). If applicable, the tool also returns the earliest release that fixes all the vulnerabilities that are described in all the advisories that the Software Checker identifies (“Combined First Fixed”).</p>\n<p>To use the tool, go to the <a href=\"https://sec.cloudapps.cisco.com/security/center/softwarechecker.x\">Cisco Software Checker</a> page and follow the instructions. Alternatively, use the following form to search for vulnerabilities that affect a specific software release. To use the form, follow these steps:</p>\n<ol>\n<li>Choose which advisories the tool will search-all advisories, only advisories with a Critical or High <a href=\"https://sec.cloudapps.cisco.com/security/center/resources/security_vulnerability_policy.html#asr\">Security Impact Rating (SIR)</a>, or only this advisory.</li>\n<li>Choose the appropriate software.</li>\n<li>Choose the appropriate platform.</li>\n<li>Enter a release number-for example, <strong>9.20.3.4</strong> for Cisco Secure Firewall ASA Software or <strong>7.4.2</strong> for Cisco Secure FTD Software.</li>\n<li>Click <strong>Check</strong>.</li>\n</ol>\n\n<p>For instructions on upgrading a Cisco Secure FTD device, see the appropriate <a href=\"https://www.cisco.com/c/en/us/support/security/defense-center/products-installation-guides-list.html\">Cisco Secure FMC upgrade guide</a>.</p>\n<h3 id=\"sec-10\">Additional Resources</h3>\n<p>For help determining the best Cisco Secure Firewall ASA, Secure FMC, or Secure FTD Software release, see the following Recommended Releases documents. If a security advisory recommends a later release, Cisco recommends following the advisory guidance.</p>\n<p><a href=\"https://www.cisco.com/c/en/us/td/docs/security/asa/compatibility/asamatrx.html\">Cisco Secure Firewall ASA Compatibility</a><br><a href=\"https://www.cisco.com/c/en/us/td/docs/security/asa/upgrade/asa-upgrade/planning.html\">Cisco Secure Firewall ASA Upgrade Guide</a><br><a href=\"https://www.cisco.com/c/en/us/td/docs/security/secure-firewall/compatibility/threat-defense-compatibility.html\">Cisco Secure Firewall Threat Defense Compatibility Guide</a></p>\n\n</li>\n</ul>\n<h2 id=\"sec-11\">\n<p>\n                          Exploitation and Public Announcements\n                          \n                        </p>\n</h2>\n<ul>\n<li>\n<p>In October 2026, the Cisco PSIRT became aware of active exploitation of this vulnerability. Cisco strongly recommends that customers upgrade to a fixed software release to remediate this vulnerability.</p>\n\n</li>\n</ul>\n<h2 id=\"sec-12\">\n<p>\n                          Source\n                          \n                        </p>\n</h2>\n<ul>\n<li>\n<p>This vulnerability was found by Eric Fernald during the resolution of a Cisco Technical Assistance Center (TAC) support case.</p>\n</li>\n</ul>\n\n<h2 id=\"sec-13\">\n<p>\n        Cisco Security Vulnerability Policy\n        \n      </p>\n</h2>\n<ul>\n<li>\n<p>To learn about Cisco security vulnerability disclosure policies and publications, see the <a href=\"http://www.cisco.com/web/about/security/psirt/security_vulnerability_policy.html\">Security Vulnerability Policy</a>. This document also contains instructions for obtaining fixed software and receiving security vulnerability information from Cisco.</p>\n<p>For additional information on Cisco's vulnerability management, disclosure cadence, and software patching strategy, see <a href=\"https://sec.cloudapps.cisco.com/security/center/resources/risk-based-disclosure\">Cisco's Transition to a Risk-Based Vulnerability Disclosure Model</a>.</p>\n</li>\n</ul>\n\n<ul>\n<li>\n<p><a href=\"https://www.cisco.com/c/en/us/support/web/tools/cns/notifications.html\">Subscribe</a>\n</p>\n</li>\n</ul>\n<h2 id=\"sec-14\">\n<p>\n          \n          Related to This Advisory\n        </p>\n</h2>\n<ul>\n<li></li>\n</ul>\n\n<h2 id=\"sec-15\">\n<p>\n                        URL\n                        \n                      </p>\n</h2>\n<ul>\n<li>\n<p><a href=\"https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-asaftd-tunnel-dos-s6mgkb75\">https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-asaftd-tunnel-dos-s6mgkb75</a>\n</p>\n</li>\n</ul>\n<h2 id=\"sec-16\">\n<p>\n                        Revision History\n                        \n                      </p>\n</h2>\n<ul>\n<li>\n<table>\n\t<thead>\n\t\t<tr>\n\t\t\t<th>Version</th>\n\t\t\t<th>Description</th>\n\t\t\t<th>Section</th>\n\t\t\t<th>Status</th>\n\t\t\t<th>日期</th>\n\t\t</tr>\n\t</thead>\n\t<tbody>\n\t\t<tr>\n\t\t\t<td>1.0</td>\n\t\t\t<td>首次公开发布。</td>\n\t\t\t<td>-</td>\n\t\t\t<td>最终版本</td>\n\t\t\t<td>2026-OCT-28</td>\n\t\t</tr>\n\t</tbody>\n</table>\n<p><a>显示更少</a>\n</p>\n</li>\n</ul>\n<hr>\n<h2 id=\"sec-17\">\n<p>\n                          法律免责声明\n                        </p>\n</h2>\n<ul>\n<li>\n<p>本文档按“现状”提供，不暗示任何形式的保证或担保，包括对适销性或特定用途适用性的担保。您使用本文档中的信息或从本文档链接的材料，风险由您自行承担。CISCO 保留随时更改或更新本文档的权利。</p>\n<p>省略分发 URL 的本文档独立副本或转述副本属于不受控副本，可能缺少重要信息或包含事实错误。本文档中的信息旨在供 Cisco 产品的最终用户使用。</p>\n</li>\n</ul>\n\n\n<h2 id=\"sec-18\">\n<p>\n                          反馈\n                        </p>\n</h2>\n<ul>\n<li>\n<p>留下更多反馈\n</p>\n</li>\n</ul>\n\n\n\n\n\n \n\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\n\n\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t</tr>\n\t\t\t\t</tbody></table>","original","zhKind","translation","complete",false,"漏洞","补丁","网络设备","Cisco","https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-asaftd-tunnel-dos-s6mgkb75?vs_f=Cisco%20Security%20Advisory%26vs_cat=Security%20Intelligence%26vs_type=RSS%26vs_p=Cisco%20Secure%20Firewall%20Adaptive%20Security%20Appliance%20and%20Secure%20Firewall%20Threat%20Defense%20Software%20Remote%20Access%20SSL%20VPN%20Tunnel%20Denial%20of%20Service%20Vulnerability%26vs_k=1","Cisco PSIRT",{"_151":152,"_153":-5},"changelogVersion","2026-10-01T08:00","release"]
