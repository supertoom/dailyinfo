[{"_1":2,"_3":4},"root",{"_5":107},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1794616828000,"id","g8lommzdv7g4jq6hsbkd50oer","title","N-able 公开 N-central 30 余项零日漏洞，厂商全球下线托管环境","originalTitle","N-able takes cloud platform offline after 30+ \"zero-days\" published","summary","安全研究员 Sean Bales 公开 N-central 30 余项疑似零日漏洞及 Able2Shell PoC，涵盖认证绕过、凭据泄露、任意文件写入、XSS、XXE、远程代码执行和提权。","reason","source",{"_73":106},"links",{"_95":105},"publishedAt","2026-11-09T21:26:25.000Z","discoveredAt","2026-11-09T21:39:18.284Z","timelineAt","category","vuln","tags",[101,102,103,104,76,78],"score",78,"selected",true,"channel","news","story",{"_80":81,"_13":82},"x","sameEvent",{"_11":99,"_13":100},"readingMode","full","author","Lawrence Abrams","body",{"_62":94,"_95":-5,"_96":97,"_98":36},"outline",[83,84,85],"relatedStories",[79],"topics",[69,70,71],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","fEvZARAZeeVY","reportCount",3,"additionalSourceCount",2,{"_72":77,"_73":78},{"_72":75,"_73":76},{"_72":30,"_73":74},"slug","name","漏洞披露","vuln-mgmt","漏洞管理","incident","应急响应",{"_80":81,"_13":82},"publicId","ed4db3d6-dbb8-43e7-b004-fff9ac19f4ca","4EverAble2Shell已攻陷21台N-central服务器",{"_11":92,"_87":93,"_89":68},{"_11":90,"_87":91,"_89":68},{"_11":86,"_87":88,"_89":68},"sec-3","text","发现您现有的防御措施可能遗漏的电子邮件威胁。","level","sec-2","研究人员称此前漏洞报告遭到忽视","sec-1","N-able 全球下线服务器","<p><img alt=\"N-able\" height=\"900\" src=\"/dailyinfo/media/3445cbfdb2e83836.jpg\" srcset=\"/dailyinfo/media/119f4d3b72e5afff.jpg 720w, /dailyinfo/media/333561732ffdf972.jpg 1200w, /dailyinfo/media/3445cbfdb2e83836.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>N-able 已将其托管的 N-central 环境下线，并敦促本地部署的客户关闭服务器，此前一名安全研究员公开披露了 30 多项据称的零日漏洞，其中包括可能让攻击者接管易受攻击系统的漏洞利用代码。</p><p>安全研究员 <a href=\"https://www.linkedin.com/posts/seanbales_today-i-bring-you-able2shell-a-repository-activity-7525411549709144064-xdUB\">Sean Bales 披露了</a>这些漏洞，时间是 11 月 8 日星期日深夜，并发布了一个名为 <a href=\"https://github.com/Oracle-Security/CVEs/tree/main/0-Days/N-Central%20N-Able\">Able2Shell</a> 的 GitHub 仓库，其中包含针对这些缺陷的概念验证漏洞利用代码。</p><p>N-central 是一套远程监控与管理（RMM）平台，供托管服务提供商（MSP）和 IT 团队远程监控、管理和保护客户设备及网络。</p><p><a href=\"https://www.wiz.io/lp/securing-ai-agents-101?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY26Q3_INB_FORM_Securing-AI-Agents-101&amp;sfcid=701Py00000RTEWMIA5&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AI-Agents-101\"><img src=\"/dailyinfo/media/f55e10e3db4728a2.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>研究人员表示，这些漏洞是针对 N-central Appliance 2026.4.0.31 这一预发布版本软件测试的，并认为大多数乃至全部缺陷也影响更早的版本。</p><p>Bales 还向 BleepingComputer 确认，这些漏洞的发现过程有 AI 协助。</p><p>披露的漏洞包括身份验证绕过、凭据泄露、任意文件写入、目录遍历、跨站脚本（XSS）、XML 外部实体（XXE）注入，以及远程代码执行（RCE）缺陷。</p><p>其中一条最关键的漏洞利用链利用 N-central 服务导入功能中未经身份验证的 XXE 漏洞，窃取受信任的本地会话、重置账户密码，并以 nable 用户身份在服务器上执行命令。</p><p>同一漏洞利用代码还可以创建一个已启用的 Default Administrator 账户，并设置由攻击者控制的凭据，从而获得对 N-central 管理界面的非法管理访问权限。</p><p>Bales 分享了该漏洞利用代码的视频演示，终端输出显示成功创建管理员账户、完成登录身份验证、访问受保护的管理功能，以及以 nable 用户身份远程执行命令。</p><p>其他披露的漏洞利用代码包括一项存储型 XSS，管理员查看恶意补丁元数据时，该漏洞可以 root 身份执行命令；以及一项权限提升漏洞，允许在 <code>nable</code> 账户下运行的代码以 root 身份执行命令。</p><p>Bales 向 BleepingComputer 确认，未经身份验证的 XXE 转 RCE 漏洞利用代码是所披露漏洞中最关键的一项。</p><h2 id=\"sec-1\">N-able 全球下线服务器</h2><p>披露漏洞后，N-able <a href=\"http://uptime.n-able.com/\">宣布发生严重安全事件</a>，并将美洲、欧洲和亚太地区托管的 N-central 环境全部下线。</p><p>尽管 BleepingComputer 尚未独立验证所有报告的漏洞，但 N-able 确认正在开发热修复程序来解决这些安全问题，这增强了研究人员说法的可信度，即至少部分缺陷确实是合法的零日漏洞。</p><p>N-able 告诉 BleepingComputer：“N-able 正积极应对 11 月 8 日星期日深夜由一名独立研究员发现的 N-central 严重漏洞的不负责任通报。”</p><p>N-able 表示：“作为预防措施，我们已于今日 11 月 9 日将托管的 N-central 环境下线，并向运行本地部署 N-central 服务器的客户提供了指导，建议在另行通知之前暂时关闭服务器。”</p><p>“我们的安全、工程和运营团队正在积极开展工作，以实施必要的修复。目前，我们尚未观察到这些漏洞正被 actively利用。保护我们的客户及其环境始终是我们的首要任务，我们将在有更多信息后提供后续更新。”</p><p>在随后发布的<a href=\"https://uptime.n-able.com/\">状态更新</a>中，N-able 表示其仍在继续开发和验证热修复，并且没有发现 actively利用或未经授权访问数据的证据。</p><p>虽然 N-central classic 环境目前不可用，但 N-able 表示通过 N-able Login 访问的 Ecoverse 服务仍在正常运行。</p><p>N-able 尚未提供 N-central 恢复上线的时间估计，但表示计划每四小时发布一次更新，或在有新信息时提前发布。</p><h2 id=\"sec-2\">研究人员称此前漏洞报告遭到忽视</h2><p>Bales 告诉 BleepingComputer，他是在没有事先通知 N-able 的情况下故意公开 N-central 漏洞的，因为据称该公司未能修复他此前在另一款 N-able 产品中报告的漏洞。</p><p>据 Bales 所述，他在约五至六个月前披露了两个互不相关的远程代码执行漏洞和一个权限提升漏洞，但这些漏洞仍未得到修复。</p><p>“我在五、六个月前披露了另一款 N-able 产品的两个无关 RCE，以及一个权限提升漏洞。这些漏洞至今仍未得到修复。我昨晚发布的那些 0-day 漏洞一个都没有披露，”Bales 告诉 BleepingComputer。</p><p>他还声称，在过去四到六周内，他本人、他的经理和总监发送了大约五封跟进邮件，但都没有得到回复。</p><p>Bales 表示，他此前与 N-able 漏洞披露流程打交道的经历，以及“他们并不认真对待漏洞披露”，促使他公开了 N-central 的零日漏洞利用代码。</p><p>不过，他表示这些漏洞利用代码针对的是另一款 N-able 产品，与他此前披露的漏洞不同。</p><p>研究人员还声称，他此前通过 N-able 的漏洞赏金平台提交报告时没有获得任何报酬。</p><p>Bales 证实，在漏洞披露后，N-able 的高管（包括该公司的 CEO 和 CTO）联系了他，要求他删除 GitHub 仓库并与公司合作。</p><p>“不过他们并没有威胁我或做其他什么，只是要求我下架该仓库、与他们合作等等。”</p><p>BleepingComputer 就 Bales 关于此前已披露漏洞、这些漏洞的修复状态，以及据称其跟进邮件未获回复等指控询问了 N-able。</p><p>然而，该公司没有回答这些问题，仅就 N-central 安全事件和预防性停机发表了声明。</p><p>此前报告的漏洞未包含在公开发布的 Able2Shell 仓库中，据称仍未得到修复。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/c132e890d608eb09.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-3\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现您现有的防御措施可能遗漏的电子邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 代理会分析电子邮件意图、上下文和行为，以发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>对 Microsoft 365 或 Google Workspace 进行为期 14 天的只读扫描，看看有哪些威胁正在穿透，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始您的免费电子邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","bascdi2f6ns6cy5dhtip9c0qp","N-able N-central 披露 33 个严重漏洞，含未认证 RCE 利用链","漏洞","复现","漏洞利用","利用链","https://www.bleepingcomputer.com/news/security/n-able-takes-cloud-platform-offline-after-30-plus-zero-days-published/","BleepingComputer",{"_108":109,"_110":-5},"changelogVersion","2026-10-01T08:00","release"]
