[{"_1":2,"_3":4},"root",{"_5":157},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":60,"_61":62},"expiresAt",1794530488000,"id","lybkf1c5asn88rjr54wj2w33h","title","Microsoft 披露木马化安装程序下载活动及三类变现载荷","originalTitle","Fake-download campaign uses trojanized installers to deliver monetization payloads","summary","Microsoft Threat Intelligence 发现一项针对破解软件、免费游戏、激活器和非官方工具用户的假下载活动，通过 Inno Setup 风格安装程序、临时运行器和 offer 回调投放载荷。","reason","文章还原了从假下载诱导、Inno 临时运行到三类载荷落地的完整链路，并提供持久化行为和狩猎线索，便于识别隐藏在安装会话中的变现组件。","source",{"_77":156},"links",{"_62":155},"publishedAt","2026-11-03T17:32:47.000Z","discoveredAt","2026-11-03T18:15:23.494Z","timelineAt","category","activity","tags",[80,78,152,153,84,154],"score",76,"selected",true,"channel","news","story",{"_90":91,"_13":92},"x","readingMode","full","author","Microsoft Security Research and Jiacen Xu","body",{"_148":-5,"_62":149,"_150":-5,"_151":60},"outline",[93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109],"relatedStories",[89],"topics",[69,70,71,72,73,74],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation",false,"bodyLanguage","original","factId","f_alplynUspI","reportCount",1,"additionalSourceCount",0,{"_75":87,"_77":88},{"_75":85,"_77":86},{"_75":83,"_77":84},{"_75":81,"_77":82},{"_75":79,"_77":80},{"_75":76,"_77":78},"slug","malware","name","恶意软件","attack","攻击活动","black-market","数据窃取与黑产","botnet","僵尸网络","supply-chain","供应链安全","microsoft","Microsoft / 微软",{"_90":91,"_13":92},"publicId","5f680815-33c5-4fae-953f-69325e3eb67c","微软披露木马安装程序变现活动",{"_11":146,"_111":147,"_113":114},{"_11":144,"_111":145,"_113":117},{"_11":142,"_111":143,"_113":117},{"_11":140,"_111":141,"_113":117},{"_11":138,"_111":139,"_113":117},{"_11":136,"_111":137,"_113":117},{"_11":134,"_111":135,"_113":117},{"_11":132,"_111":133,"_113":114},{"_11":130,"_111":131,"_113":117},{"_11":128,"_111":129,"_113":117},{"_11":126,"_111":127,"_113":117},{"_11":124,"_111":125,"_113":117},{"_11":122,"_111":123,"_113":117},{"_11":120,"_111":121,"_113":117},{"_11":118,"_111":119,"_113":117},{"_11":115,"_111":116,"_113":117},{"_11":110,"_111":112,"_113":114},"sec-17","text","Learn More","level",2,"sec-16","Indicators of compromise (IOC)",3,"sec-15","MITRE ATT&amp;CK Techniques observed","sec-14","Advanced hunting","sec-13","Threat intelligence reports","sec-12","Microsoft Security Copilot","sec-11","Microsoft Defender XDR detections","sec-10","Investigation actions","sec-9","Preventive controls","sec-8","Mitigation and protection guidance","sec-7","Proxy and network-resource monetization — WorldProxyPool","sec-6","Final payload installation and monetization","sec-5","Offer execution callback and payload delivery","sec-4","Inno wrapper execution and temporary runner staging","sec-3","Initial access via fake download lures","sec-2","Attack Chain","sec-1","Attack chain overview","zh","<ol><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/03/fake-download-campaign-uses-trojanized-installers-deliver-monetization-payloads/#attack-chain-overview\">Attack chain overview</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/03/fake-download-campaign-uses-trojanized-installers-deliver-monetization-payloads/#mitigation-and-protection-guidance\">Mitigation and protection guidance</a></li><li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/03/fake-download-campaign-uses-trojanized-installers-deliver-monetization-payloads/#learn-more\">Learn More</a></li></ol><p>Microsoft Threat Intelligence has identified an evolving fake-download campaign targeting users searching for cracked commercial software, free games, activators, plugins, and unofficial utilities. The campaign uses trojanized Inno Setup-style installers to distribute multiple monetized software payloads, referred to by the delivery system as “offers”, during a single installation session. </p><p>Our investigation found that the installers use a per-offer callback and status-tracking model to manage delivery and record installation outcomes. We confirmed three downstream monetization branches that transformed affected devices into monetized assets, including by routing third-party internet traffic through the device, enrolling it in a distributed-computing platform, or installing additional utility-style software, often without users’ informed knowledge or consent. These products and components may have legitimate uses, but their silent installation through deceptive software bundles without informed user consent introduces security and privacy risks. </p><p>Organizations can reduce their exposure to this activity by preventing the use of untrusted software sources, enabling potentially unwanted application protection, and monitoring for unexpected software installations and persistence mechanisms. </p><p>This blog details the campaign’s execution model and confirmed outcomes and provides mitigation guidance, Microsoft Defender protection information, advanced hunting queries, MITRE ATT&amp;CK mappings, and indicators of compromise to help defenders identify, investigate, and respond to related activity. </p><h2 id=\"sec-1\">Attack chain overview</h2><p>The fake-download campaign follows a four-stage attack chain that progresses from deceptive lures through Inno-based staging, offer-controlled payload delivery, and installation of one or more monetization branches: </p><ol>\n<li><strong>Initial access via fake download lures</strong> – Users run fake installers promoted as cracked commercial software, free games, activators, plugins, executors, or unofficial utilities. </li>\n</ol><ol>\n<li><strong>Inno wrapper execution and temporary runner staging</strong> – The installer launches an Inno Setup-style temporary runner under <strong>%TEMP%\\is-*.tmp\\</strong>, which starts recurring <strong>eld*.exe</strong>, <strong>set_*.exe</strong>, or other numbered stages. </li>\n</ol><ol>\n<li><strong>Offer execution callback and payload delivery</strong> – The runner contacts rotating infrastructure using a repeatable <strong>d=inno</strong> and <strong>r=offer_execution</strong> callback pattern. Offer, affiliate, download-network, placement, and session values coordinate downstream payload selection and correlate activity within the installer session. </li>\n</ol><ol>\n<li><strong>Final payload installation and monetization</strong> – Staged payloads use unattended installation switches to install one or more confirmed campaign branches: WorldProxyPool for proxy and network-resource monetization; CharityEngine and Berkeley Open Infrastructure for Network Computing (BOINC) for compute-resource monetization; or Advanced Windows (AW) Manager and Windows Manager for adware-style utility monetization. WorldProxyPool also creates recurring SYSTEM scheduled tasks for agent startup, watchdog execution, and updater activity. </li>\n</ol><h3 id=\"sec-2\">Attack Chain </h3><figure><img src=\"/dailyinfo/media/4319e69ff229a2dc.webp\" loading=\"lazy\" decoding=\"async\" alt=\"\"><figcaption><em>Figure 1. Overview of the attack chain.</em></figcaption></figure><h3 id=\"sec-3\">Initial access via fake download lures</h3><p>The campaign begins when users download and run fake installers promoted as cracked software, game installers, executors, activators, plugins, utilities, or driver and mobile-unlock tools. Observed lures include cracked audio plugins, PC games, Roblox executors, auto-clickers, driver tools, and fake utility installers. </p><p><strong>Example lures:</strong> <em>Echo Client; FabFilter Total Bundle; Navicat Premium crack; Cue Club; auto-clicker; Deadpool Apunka Games; Command &amp; Conquer: Red Alert 2; TFT Unlock Tool; and clownfishvoicechanger.</em> </p><figure><img src=\"/dailyinfo/media/db5b315478e42abb.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Dark-themed Auto Clicker promotional webpage with product screenshots, feature descriptions, and repeated gold download buttons, illustrating the polished software-download pages used as campaign lures.\"><figcaption>Figure 2. Example utility download lure.</figcaption></figure><h3 id=\"sec-4\">Inno wrapper execution and temporary runner staging </h3><p>Across the investigated activity, user-launched lures spawned Inno Setup-style temporary runners under <strong>%TEMP%\\is-*.tmp\\</strong> and then launched one or more numbered <strong>eld*.exe</strong> stages. Arguments such as <strong>/SL5</strong>, <strong>/SPAWNWND</strong>, and <strong>/FIRSTWND</strong>, together with the temporary path and numbered stage names, provide more durable indicators than the original lure filename. </p><p>The depth of the execution chain and its downstream outcome varied by installer session. One Echo Client example progressed through multiple numbered stages and reached several monetization branches, while other observed lures exposed fewer numbered stages or downstream components. </p><p>The table below uses the Echo Client activity as a representative example of the wrapper-to-stage sequence; individual installer sessions may launch different combinations of numbered stages. </p><figure><table><tbody><tr><td><strong>Step</strong> </td><td><strong>Process</strong> </td><td><strong>Command-line / path signal</strong> </td><td><strong>Role</strong> </td></tr><tr><td>1 </td><td>Echo Client.exe </td><td>Launched from <strong>%USERPROFILE%\\Downloads\\Echo Client\\</strong> </td><td>User-launched lure </td></tr><tr><td>2 </td><td>Echo Client.tmp </td><td><strong>%TEMP%\\is-*.tmp\\…</strong> with <strong>/SL5=…</strong> </td><td>Inno temporary runner </td></tr><tr><td>3 </td><td>Echo Client.exe </td><td><strong>/SPAWNWND=… /FIRSTWND=…</strong> </td><td>Inno child process / window handoff </td></tr><tr><td>4 </td><td>Echo Client.tmp </td><td><strong>/SL5=… /SPAWNWND=… /FIRSTWND=…</strong> </td><td>Temporary runner continues execution </td></tr><tr><td>5 </td><td>eld*.exe </td><td><strong>eld0.exe</strong>, <strong>eld1.exe</strong>, <strong>eld3.exe</strong>, <strong>eld4.exe</strong>, and <strong>eld5.exe</strong> under <strong>%TEMP%\\is-*.tmp\\</strong> </td><td>Numbered staged payloads </td></tr></tbody></table></figure><p><em>Table 1. Inno wrapper execution and temporary runner staging. </em> </p><h3 id=\"sec-5\">Offer execution callback and payload delivery  </h3><p>After staging, the Inno temporary runner contacted rotating callback infrastructure using randomized URL paths but a repeatable query-string structure: </p><pre>http:///?sis=&amp;fz=&amp;d=inno&amp;r=offer_execution&amp;ko=no&amp;o=&amp;a=&amp;dn=&amp;spot=&amp;t=&amp;cr= \n</pre><p>Failed or blocked offers used <strong>r=offer_execution_fail</strong> and sometimes included local error text, including messages that the operation did not complete because the file contained a virus or potentially unwanted software. These callbacks are useful campaign-attribution and sequencing markers, but they are not always the earliest prevention point. In some endpoint detection and response (EDR) traces, child payloads launched before or around the <strong>r=offer_execution</strong> callback. </p><p>The campaign used offer IDs, affiliate IDs, download-network IDs, and placement values to select or report downstream payload attempts. Observed offer and download-network combinations included <strong>o=1712 / dn=507</strong>, <strong>o=1720 / dn=536</strong>, <strong>o=1727 / dn=564</strong>, <strong>o=1729 / dn=566</strong>, <strong>o=331 / dn=244</strong>, <strong>o=1674 / dn=440</strong>, <strong>o=1675 / dn=441</strong>, <strong>o=1681 / dn=447</strong>, and <strong>o=1730 / dn=567</strong>. Different offers could succeed or fail independently within the same installer session, so a failed first offer did not necessarily mean that the full bundle stopped. </p><figure><table><tbody><tr><td><strong>Parameter</strong> </td><td><strong>Observed use</strong> </td><td><strong>Assessment</strong> </td></tr><tr><td>d </td><td>Often set to inno </td><td>Installer or delivery-family marker </td></tr><tr><td>sis </td><td>Stable within an installer session </td><td>Session-correlation value </td></tr><tr><td>a </td><td>Stable across related requests </td><td>Affiliate, campaign, or distribution-partner identifier </td></tr><tr><td>o </td><td>Changes by offer </td><td>Offer identifier </td></tr><tr><td>dn / on </td><td>Changes with the offer or retrieval path </td><td>Download-network or offer-network field; exact meaning unconfirmed </td></tr><tr><td>spot </td><td>Increments through the session </td><td>Offer placement, slot, or execution order </td></tr><tr><td>paw </td><td>Present across offer requests </td><td>Request, package, or session-correlation value; exact meaning unconfirmed </td></tr><tr><td>fz </td><td>Present in outcome callbacks </td><td>Delivered package size or file-size field </td></tr><tr><td>t </td><td>Present in outcome callbacks </td><td>Timing, token, or request value; exact meaning unconfirmed </td></tr><tr><td>r </td><td>offer_execution or offer_execution_fail </td><td>Per-offer execution result </td></tr><tr><td>msg </td><td>Present on failed offers </td><td>Error text from the local download or installation attempt </td></tr><tr><td>ko / cr </td><td>Boolean-like or short values </td><td>Server-side control or result flags; exact meaning unconfirmed </td></tr></tbody></table></figure><p><em>Table 2. Assessments are based on observed telemetry correlations, not confirmed server-side definitions.</em> </p><figure><table><tbody><tr><td>Offer / download-network pair </td><td>Semantic meaning </td></tr><tr><td>o=1712 / dn=507 </td><td>Primary first-stage offer commonly attempted at the start of the installer flow. </td></tr><tr><td>o=1720 / dn=536 </td><td>Offer branch associated with CharityEngine/BOINC distributed-compute monetization. </td></tr><tr><td>o=1727 / dn=564 </td><td>Offer branch associated with WorldProxyPool proxyware monetization. </td></tr><tr><td>o=1729 / dn=566 </td><td>Recurring follow-on offer branch in the installer flow. </td></tr><tr><td>o=331 / dn=244 </td><td>Secondary offer branch observed in the multi-offer sequence. </td></tr><tr><td>o=1674 / dn=440 </td><td>Later campaign offer branch. </td></tr><tr><td>o=1675 / dn=441 </td><td>Low-volume offer branch. </td></tr><tr><td>o=1681 / dn=447 </td><td>Additional offer branch in the campaign’s installer rotation. </td></tr><tr><td>o=1730 / dn=567 </td><td>Later high-volume offer branch. </td></tr></tbody></table></figure><p><em>Table 3. Offer and download-network pairs and their semantic roles in the installer flow.</em> </p><p>The campaign rotated callback domains frequently while preserving the same d=inno and offer-execution callback structure across recurring lure categories. Individual domains are therefore short-lived infrastructure indicators; the durable hunting signal is the combination of the callback pattern, Inno temporary execution, staged filenames, and related installer-session activity. The full observed domain set is provided in the IOC section. </p><h3 id=\"sec-6\">Final payload installation and monetization </h3><p>After offer callback and payload delivery, the campaign launched downstream installers or components using unattended installation switches such as <strong>/qn</strong>, <strong>/S</strong>, <strong>/quiet</strong>, and <strong>/norestart</strong>. This stage converted the fake-download execution chain into installed software and recurring execution across three monetization branches: proxy and network-resource monetization, compute-resource monetization, and adware-style utility monetization. </p><figure><table><tbody><tr><td><strong>Branch</strong> </td><td><strong>Primary behavior</strong> </td><td><strong>Representative artifacts</strong> </td></tr><tr><td>A. WorldProxyPool </td><td>Proxy agent installation and scheduled-task setup </td><td>sdk-agent.exe; sdk-agent.updater.exe; watchdog.ps1; WorldProxyPoolAgent task </td></tr><tr><td>B. CharityEngine / BOINC </td><td>Distributed-compute software installation </td><td>boinc.exe; charityengine.exe; ce11.exe; VirtualBox-7.2.8-r173730.msi </td></tr><tr><td>C. AW Manager / Windows Manager </td><td>Utility and updater-style software installation </td><td>Windows Manager – Postback Johan.msi; AdvancedWindowsManager.exe; Windows Updater.exe </td></tr></tbody></table></figure><p><em>Table 4. Summary of the three monetization branches and representative artifacts. </em></p><h3 id=\"sec-7\">Proxy and network-resource monetization — WorldProxyPool </h3><p>In the WorldProxyPool branch, a staged <strong>eld4.exe</strong> payload created three SYSTEM-level scheduled tasks for components under <strong>C:\\Program Files\\WorldProxyPool\\</strong>. <strong>WorldProxyPoolAgent</strong> configured <strong>sdk-agent.exe</strong> to run at system startup with highest privileges; <strong>WorldProxyPoolWatchdog</strong> configured a hidden, noninteractive PowerShell watchdog script to run every five minutes; and <strong>WorldProxyPoolUpdater</strong> configured <strong>sdk-agent.updater.exe update</strong> to run hourly. The installer also started the agent task immediately with <strong>schtasks.exe /Run</strong>. Subsequent task launches were brokered by the Windows Task Scheduler service (<strong>svchost.exe -k netsvcs -p -s Schedule</strong>), causing <strong>sdk-agent.exe</strong> and the watchdog script to execute in the service context. This persistence mechanism supports recurring proxy-agent, watchdog, and updater activity, consistent with network-resource monetization. </p><figure><table><tbody><tr><td><strong>Scheduled task</strong> </td><td><strong>Purpose</strong> </td></tr><tr><td>WorldProxyPoolAgent </td><td>Runs <strong>sdk-agent.exe</strong> at system startup as SYSTEM with highest privileges; the installer also started it immediately with <strong>schtasks.exe /Run</strong>. </td></tr><tr><td>WorldProxyPoolWatchdog </td><td>Runs a hidden, noninteractive PowerShell watchdog script every five minutes as SYSTEM with highest privileges. </td></tr><tr><td>WorldProxyPoolUpdater </td><td>Runs <strong>sdk-agent.updater.exe update</strong> hourly as SYSTEM with highest privileges. </td></tr></tbody></table></figure><p><em>Table 5. WorldProxyPool scheduled tasks created during the proxyware installation chain</em></p><figure><img src=\"/dailyinfo/media/e990bc0a1199975f.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Process tree showing eld4.exe creating three SYSTEM-level WorldProxyPool scheduled tasks: an agent that runs at startup, a hidden PowerShell watchdog that runs every five minutes, and an updater that runs hourly. The agent is started immediately through Windows Task Scheduler. \"><figcaption><em>Figure 3. WorldProxyPool installation and persistence. eld4.exe created SYSTEM-level startup, five-minute watchdog, and hourly updater tasks.</em></figcaption></figure><p>Compute-resource monetization — CharityEngine and BOINC </p><p>In the CharityEngine and BOINC branch, the offer payload installed distributed-compute software and supporting components under <strong>C:\\Program Files\\BOINC\\</strong> and <strong>C:\\ProgramData\\BOINC\\</strong>. Observed components included <strong>ce-installer_7.14.2_vbox-7.2.8.exe</strong>, <strong>ce_7.14.2_windows_x86_64.exe</strong>, <strong>charityengine.exe</strong>, <strong>boinc.exe</strong>, <strong>boinctray.exe</strong>, <strong>boinc.scr</strong>, <strong>boincscr.exe</strong>, <strong>wrapper_2022110901_windows_x86_64.exe</strong>, <strong>ce11.exe</strong>, and <strong>VirtualBox-7.2.8-r173730.msi</strong>. They covered BOINC launch, compute-wrapper execution, GPU or compute-capability checks, CharityEngine project communication, and VirtualBox installation. </p><figure><img src=\"/dailyinfo/media/fe1193e556fb18d7.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Process tree tracing eld1.exe through CharityEngine, VirtualBox, and BOINC installation. The chain installs supporting components, launches charityengine.exe and boinc.exe, checks GPU capabilities, and runs a compute wrapper that starts cell.exe.\"><figcaption><em>Figure 4. CharityEngine/BOINC compute-monetization branch.</em></figcaption></figure><p>Adware-style utility monetization: AdvancedWindowsManager / Windows Manager </p><p>The same Inno offer-execution infrastructure delivered an AW Manager or Windows Manager branch. In one observed process tree, the Inno runner spawned <strong>eld3.exe</strong>, launched <strong>Windows Manager – Postback Johan.msi</strong>, and installed <strong>AdvancedWindowsManager.exe</strong> and <strong>Windows Updater.exe</strong> under paths resembling <strong>%APPDATA%\\AW Manager\\Windows Manager 1.0.0\\</strong> or <strong>C:\\Program Files (x86)\\AW Manager\\Windows Manager\\</strong>.  </p><figure><img src=\"/dailyinfo/media/39922e8398d04c57.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Process tree showing a command-driven AW Manager/Windows Manager installation under the user’s AppData directory. cmd.exe launches msiexec.exe, starts Windows Manager with an autostart option, and runs taskkill.exe against AdvancedWindowsManager processes.\"><figcaption><em>Figure 5. AW Manager / Windows Manager utility-install branch.</em></figcaption></figure><h2 id=\"sec-8\">Mitigation and protection guidance</h2><p>Microsoft recommends the following actions to reduce exposure to this campaign and detect related activity:</p><h3 id=\"sec-9\">Preventive controls </h3><ul>\n<li><strong>Avoid untrusted software sources.</strong> Do not download cracked software, key generators, unofficial game installers, or software activation tools, which are common delivery mechanisms for malware, potentially unwanted applications, and monetization campaigns.  </li>\n</ul><ul>\n<li><strong>Enable cloud-delivered protection.</strong> Verify that Microsoft Defender Antivirus cloud-delivered protection is enabled to improve detection of emerging malware and potentially unwanted applications. See: <a href=\"https://learn.microsoft.com/microsoft-365/security/defender-endpoint/configure-real-time-protection-microsoft-defender-antivirus#turn-on-cloud-delivered-protection\">Configure cloud-delivered protection</a>  </li>\n</ul><ul>\n<li><strong>Keep tamper protection enabled.</strong> Use tamper protection to help prevent unauthorized changes to Microsoft Defender security settings. See: <a href=\"https://learn.microsoft.com/microsoft-365/security/defender-endpoint/prevent-changes-to-security-settings-with-tamper-protection\">Learn about tamper protection</a>.  </li>\n</ul><ul>\n<li><strong>Enable reputation-based protection.</strong> Configure reputation-based protection to help block known malicious and untrusted applications and downloads. See: <a href=\"https://learn.microsoft.com/en-us/windows/security/operating-system-security/virus-and-threat-protection/microsoft-defender-smartscreen/\">Configure reputation-based protection</a>.</li>\n</ul><ul>\n<li><strong>Consider Attack Surface Reduction (ASR) protections.</strong> Evaluate ASR rules, including rules that block executable files unless they meet prevalence, age, or trusted-list criteria. See: <a href=\"https://learn.microsoft.com/microsoft-365/security/defender-endpoint/attack-surface-reduction-rules-reference\">Review Attack Surface Reduction rules</a>.  </li>\n</ul><h3 id=\"sec-10\">Investigation actions </h3><ul>\n<li><strong>Investigate execution from Inno temporary directories.</strong> Review activity from paths such as <strong>%TEMP%\\is-*.tmp\\</strong>, particularly when staged executables such as <strong>eld*.exe</strong>, <strong>set_*.exe</strong>, <strong>FirstFast[1].exe</strong>, or <strong>SecondRunner[1].exe</strong> are observed. </li>\n</ul><ul>\n<li><strong>Correlate Inno callback activity.</strong> Monitor outbound requests containing d=inno together with r=offer_execution or r=offer_execution_fail, and review related process, file, and network activity across the complete installer session. </li>\n</ul><ul>\n<li><strong>Review unexpected scheduled tasks.</strong> Investigate newly created scheduled tasks, particularly tasks running with SYSTEM privileges or recurring watchdog and updater functions. See: <a href=\"https://learn.microsoft.com/windows/security/threat-protection/auditing/event-4698\">Audit scheduled task creation events</a>.  </li>\n</ul><ul>\n<li><strong>Audit software inventory for unexpected installations.</strong> Review endpoints for the presence of software such as WorldProxyPool, CharityEngine, BOINC, VirtualBox, or other applications that users did not intentionally install. See: <a href=\"https://learn.microsoft.com/microsoft-365/security/defender-vulnerability-management/tvm-software-inventory\">Review software inventory in Defender Vulnerability Management</a>. </li>\n</ul><h3 id=\"sec-11\">Microsoft Defender XDR detections  </h3><p>Microsoft Defender detects and blocks campaign-linked payloads through cloud protection, machine-learning classifications, network inspection, and behavior monitoring. Relevant observed detections include remote-thread injection, scheduled-task launch, and suspicious outbound HTTP activity. </p><p>Customers with provisioned access can also use <a href=\"https://learn.microsoft.com/en-us/defender-xdr/security-copilot-in-microsoft-365-defender\">Microsoft Security Copilot in Microsoft Defender</a> to investigate and respond to incidents, hunt for threats, and protect their organization with relevant threat intelligence. </p><figure><table><tbody><tr><td><strong>Tactic</strong> </td><td><strong>Observed activity</strong> </td><td><strong>Microsoft Defender coverage</strong> </td></tr><tr><td>Initial access and execution </td><td>Users execute fake cracked-software installers, including files presented as Navicat Premium or FabFilter bundles, from Downloads, archive-extraction folders, or Inno extraction paths. The installers launch temporary payloads from <strong>%TEMP%\\is-*.tmp\\.</strong> </td><td><strong>Microsoft Defender Antivirus</strong> <br>– Trojan:Win64/OfferLoader.DA!MTB <br>– Trojan:Win64/OfferLoader.DB!MTB  <br><br><strong>Microsoft Defender for Endpoint</strong> <br>– A suspicious file was observed <br>– An active ‘Wacatac’ malware was detected <br>– ‘Kepavll’ malware was prevented  </td></tr><tr><td>Command and control / campaign tracking </td><td>Outbound callbacks use a stable Inno offer-execution URL contract: <strong>d=inno</strong> with <strong>r=offer_execution</strong> or <strong>r=offer_execution_fail</strong>. Each callback reports an individual offer result. Correlating these callbacks with process, file, network, persistence, and installation events provides visibility across the multi-offer session.  </td><td><strong>Microsoft Defender Antivirus</strong> <br>– Behavior:Win32/SuspInnoOffer.A!mapsi  <br><br><strong>Microsoft Defender for Endpoint</strong> <br>– Suspicious ‘SuspInnoOffer’ behavior was blocked </td></tr><tr><td>Staging and payload delivery </td><td>The installer chain drops multiple staged files from Inno temporary directories, commonly named <strong>eld*.exe</strong>, <strong>set_*.exe</strong>, <strong>FirstFast[1].exe</strong>, and <strong>SecondRunner[1].exe</strong>. </td><td><strong>Microsoft Defender Antivirus</strong> <br>– Trojan:Win64/OfferLoader.DA!MTB <br>– Trojan:Win64/OfferLoader.DB!MTB   <br><br><strong>Microsoft Defender for Endpoint</strong> <br>– A suspicious file was observed <br>– An active ‘Wacatac’ malware was detected <br>– An active ‘Egairtigado’ malware was blocked <br>– ‘Kepavll’ malware was prevented </td></tr><tr><td>Persistence </td><td>In the investigated Navicat chain, WorldProxyPool created SYSTEM scheduled tasks with highest privileges: <strong>WorldProxyPoolAgent</strong> at startup, <strong>WorldProxyPoolWatchdog</strong> every five minutes through hidden noninteractive PowerShell, and <strong>WorldProxyPoolUpdater</strong> hourly. It also wrote uninstall metadata under the WorldProxyPool registry key. </td><td><strong>Microsoft Defender for Endpoint</strong> <br>– Suspicious scheduled task activity <br>– Suspicious Scheduled Task Process Launched <br>– Suspicious Task Scheduler activity </td></tr><tr><td>Resource hijacking / monetization </td><td>Two monetization paths were confirmed. The Navicat chain installed WorldProxyPool proxyware. The FabFilter chain silently installed CharityEngine/BOINC, VirtualBox, and Visual C++ components, launched BOINC workloads, and contacted CharityEngine infrastructure. </td><td><strong>Microsoft Defender Antivirus</strong> <br>– Adware:Win32/Clover <br>– Trojan:Win64/OfferLoader.DA!MTB <br>– Trojan:Win64/OfferLoader.DB!MTB  <br><br><strong>Microsoft Defender for Endpoint</strong> <br>– An active ‘Clover’ malware was detected <br>– An active ‘Wacatac’ malware was detected </td></tr><tr><td>Defense evasion and suspicious behavior </td><td>Several staged payloads are associated with defense-evasion, execution, persistence, remote-thread, and other suspicious behaviors. </td><td><strong>Microsoft Defender Antivirus</strong> <br>– Trojan:Win32/OffLoader.A  <br><br><strong>Microsoft Defender for Endpoint</strong> <br>– Suspicious ‘SuspEtherRpcConn’ behavior was blocked <br>– Suspicious ‘SuspSmsScanConn’ behavior was blocked </td></tr></tbody></table></figure><h3 id=\"sec-12\">Microsoft Security Copilot   </h3><p>Security Copilot customers can use the standalone experience to <a href=\"https://learn.microsoft.com/copilot/security/prompting-security-copilot#create-your-own-prompts\">create their own prompts</a> or run <a href=\"https://learn.microsoft.com/copilot/security/using-promptbooks\">prebuilt promptbooks</a> to automate investigation and response tasks related to this campaign. Useful promptbooks include: </p><ul>\n<li>Incident investigation </li>\n</ul><ul>\n<li>Microsoft User analysis </li>\n</ul><ul>\n<li>Threat actor profile </li>\n</ul><ul>\n<li>Threat Intelligence 360 report based on MDTI intelligence </li>\n</ul><ul>\n<li>Vulnerability impact assessment.  </li>\n</ul><p>Some promptbooks require access to Microsoft Defender XDR, Microsoft Sentinel, or related Microsoft security plugins. </p><p>For this campaign, analysts can prompt Security Copilot to summarize and correlate available incident evidence, subject to connected data and permissions. </p><h3 id=\"sec-13\">Threat intelligence reports </h3><p>Microsoft customers can use <a href=\"https://security.microsoft.com/threatanalytics3/836a0db2-ad2b-4016-922e-f96d50518767\">Microsoft Defender XDR Threat analytics and related Microsoft threat intelligence reporting</a> to track this rotating, multi-offer fake-download campaign and review updates on its Inno callbacks, offer outcomes, staged payloads, infrastructure, and proxyware or distributed-compute results.  </p><p>The reporting helps analysts correlate offer callbacks and endpoint activity from the same installer session, identify devices with associated monetization stages, and assess the overall bundle outcome. It also provides investigation context, protection guidance, relevant indicators, and recommended response actions. </p><h3 id=\"sec-14\">Advanced hunting</h3><p> Microsoft Defender XDR customers can run the following advanced hunting queries to find related activity in their networks. </p><p><strong>Inno offer-execution callbacks</strong></p><pre>DeviceNetworkEvents \n| where RemoteUrl has \"d=inno\" \n| where RemoteUrl has_any (\"r=offer_execution\", \"r=offer_execution_fail\") \n| project Timestamp, DeviceName, RemoteUrl, InitiatingProcessFileName \n</pre><p><strong>Payload execution from Inno temporary directories</strong></p><pre>DeviceProcessEvents \n| where FolderPath has @\"\\AppData\\Local\\Temp\\is-\" \n| where FileName matches regex @\"(?i)^(eld[0-9]+|set_[0-9]+|FirstFast(?:\\[1\\])?|SecondRunner(?:\\[1\\])?)\\.exe$\" \n| project Timestamp, DeviceName, FileName, FolderPath, InitiatingProcessFileName, SHA256 \n</pre><p><strong>Outbound connections to observed campaign infrastructure</strong></p><pre>DeviceNetworkEvents \n| where RemoteUrl has_any (\"orbittrack.cfd\", \"prairielink.cfd\", \"willowbox.xyz\", \"stonestation.cfd\", \"foldlodge.xyz\", \"friendsanchor.xyz\", \"fallport.cfd\", \"wishcourt.cfd\", \"cratebase.cfd\", \"belieftrack.cfd\", \"beliefdesk.xyz\", \"companyharbor.xyz\", \"signalpane.cfd\", \"inkact.xyz\", \"wishgrove.cfd\") \n| project Timestamp, DeviceName, RemoteUrl, RemotePort, InitiatingProcessFileName \n</pre><p><strong>Hunting note:</strong> Treat each callback as an individual offer result. Group events by device, time window, and available session or affiliate fields, then correlate the callbacks with Inno temporary execution, staged filenames, scheduled-task creation, and monetization-software activity. Domain-only matches are leads, not confirmation. Validate the queries against the current Microsoft Defender XDR schema before publication. </p><h3 id=\"sec-15\">MITRE ATT&amp;CK Techniques observed</h3><p>The following MITRE ATT&amp;CK mappings reflect behaviors observed in the investigated activity. Mappings are limited to evidence described in this report. </p><p><strong>Execution </strong></p><ul>\n<li><a href=\"https://attack.mitre.org/techniques/T1204/002/\"><strong>T1204.002 User Execution: Malicious File</strong></a> | A user launches an installer presented as cracked software, a game, an activator, a plugin, or an unofficial utility. </li>\n</ul><p><strong>Persistence </strong></p><ul>\n<li><a href=\"https://attack.mitre.org/techniques/T1053/005/\"><strong>T1053.005 Scheduled Task/Job: Scheduled Task</strong></a> | WorldProxyPool creates SYSTEM-level startup, watchdog, and updater tasks; the watchdog runs every five minutes and the updater runs hourly. </li>\n</ul><p><strong>Defense evasion </strong></p><ul>\n<li><a href=\"https://attack.mitre.org/techniques/T1036/\"><strong>T1036 Masquerading</strong></a> | Installers are presented with names and branding associated with cracked commercial software or unofficial software bundles to encourage execution. </li>\n</ul><ul>\n<li><a href=\"https://attack.mitre.org/techniques/T1564/003/\"><strong>T1564.003 Hide Artifacts: Hidden Window</strong></a> | The WorldProxyPool watchdog invokes PowerShell with hidden, noninteractive execution options. </li>\n</ul><p><strong>Command and control </strong></p><ul>\n<li><a href=\"https://attack.mitre.org/techniques/T1071/001/\"><strong>T1071.001 Application Layer Protocol: Web Protocols</strong></a> | The installer sends HTTP callbacks to rotating infrastructure using the durable <strong>d=inno</strong> and <strong>r=offer_execution</strong> or <strong>r=offer_execution_fail</strong> query pattern. </li>\n</ul><ul>\n<li><a href=\"https://attack.mitre.org/techniques/T1105/\"><strong>T1105 Ingress Tool Transfer</strong></a> | The campaign retrieves staged executables and supporting components from threat actor-controlled, cloud-storage, and content delivery network (CDN)-hosted locations. </li>\n</ul><p><strong>Impact </strong></p><ul>\n<li><a href=\"https://attack.mitre.org/techniques/T1496/\"><strong>T1496 Resource Hijacking</strong></a> | The campaign installs CharityEngine/BOINC for distributed computing and WorldProxyPool for proxyware monetization, abusing victim compute and network resources through deceptive bundled installation. </li>\n</ul><p>For standard industry documentation about these techniques, refer to the <a href=\"https://attack.mitre.org/\">MITRE ATT&amp;CK framework</a>. </p><h3 id=\"sec-16\">Indicators of compromise (IOC)</h3><p>The following indicators of compromise (IOCs) were observed during investigation of this campaign and can assist defenders in identifying related activity and conducting threat-hunting efforts. </p><figure><table><tbody><tr><td><strong>Indicator</strong> </td><td><strong>Type</strong> </td><td><strong>Component</strong> </td></tr><tr><td>beliefdesk[.]xyz </td><td>Domain </td><td>Offer-execution callback infrastructure. </td></tr><tr><td>companyharbor[.]xyz </td><td>Domain </td><td>Offer-execution callback infrastructure. </td></tr><tr><td>signalpane[.]cfd </td><td>Domain </td><td>Offer-execution callback infrastructure. </td></tr><tr><td>inkact[.]xyz </td><td>Domain </td><td>Offer-execution callback infrastructure. </td></tr><tr><td>wishgrove[.]cfd </td><td>Domain </td><td>Offer-execution callback infrastructure. </td></tr><tr><td>%TEMP%\\is-*.tmp\\eld*.exe </td><td>File path </td><td>Recurring staged payload naming and path pattern. </td></tr><tr><td>C:\\Program Files\\WorldProxyPool\\sdk-agent.exe </td><td>File path </td><td>WorldProxyPool proxyware component. </td></tr><tr><td>WorldProxyPoolAgent / WorldProxyPoolWatchdog / WorldProxyPoolUpdater </td><td>Scheduled task </td><td>SYSTEM-level persistence created in the investigated chain. </td></tr><tr><td>006510ce1da2b7410376f0788c19e55616eb4bcc30072d25b7d0871dc32aa11c </td><td>SHA-256 </td><td>Inno second-stage runner </td></tr><tr><td>21306fc5716f95e252388f920314b42f1c8bcc7df67cb4d39da30217b96f4044 </td><td>SHA-256 </td><td>Earlier Inno loader </td></tr><tr><td>72750d32b440e9f2b6d05ff3d218a561a75d3d75fb976b461fa59897674a7f70 </td><td>SHA-256 </td><td>Earlier Inno second-stage runner </td></tr><tr><td>ab2c2dd37fdcfe1e7620a57f98c80bd063258bea145adc0cc6a0f8b1e24c6a8f </td><td>SHA-256 </td><td>Inno eld0 / first-stage payload </td></tr><tr><td>452a210bba4c8d08f7cb7733a816d7220a7fa570a469aea0a997cfc8b594b6a0 </td><td>SHA-256 </td><td>Inno eld0 / eld1 first-stage payload </td></tr><tr><td>523fb81fae0c7beba7b5171243cc0dee7a4d04ae0483be9172eef2394a5a2152 </td><td>SHA-256 </td><td>Inno eld0 first-stage payload </td></tr><tr><td>55cd3d36fdcc58016a64398357b2c9724a060da9f0d09266e537a61ec9552e4f </td><td>SHA-256 </td><td>Later Inno eld2-eld5 payload </td></tr></tbody></table></figure><h2 id=\"sec-17\">Learn More</h2><p>For the latest security research from the Microsoft Threat Intelligence community, check out the <a href=\"https://aka.ms/threatintelblog\">Microsoft Threat Intelligence Blog</a>.</p><p>To get notified about new publications and to join discussions on social media, follow us on <a href=\"https://www.linkedin.com/showcase/microsoft-threat-intelligence\">LinkedIn</a>, <a href=\"https://x.com/MsftSecIntel\">X (formerly Twitter)</a>, and <a href=\"https://bsky.app/profile/threatintel.microsoft.com\">Bluesky</a>.</p><p>To hear stories and insights from the Microsoft Threat Intelligence community about the ever-evolving threat landscape, listen to the <a href=\"https://thecyberwire.com/podcasts/microsoft-threat-intelligence\">Microsoft Threat Intelligence podcast</a>.</p><p>Review our documentation to learn more about our real-time protection capabilities and see how to enable them within your organization.  </p><ul>\n<li>Learn more about <a href=\"https://learn.microsoft.com/en-us/defender-cloud-apps/ai-agent-protection\">securing Copilot Studio agents with Microsoft Defender</a> </li>\n\n\n\n<li>Evaluate your AI readiness with our latest <a href=\"https://microsoft.github.io/zerotrustassessment/\">Zero Trust for AI workshop</a>.</li>\n\n\n\n<li><a href=\"https://learn.microsoft.com/en-us/copilot/microsoft-365/microsoft-365-copilot-ai-security\">Microsoft 365 Copilot AI security documentation</a></li>\n\n\n\n<li><a href=\"https://www.microsoft.com/en-us/security/blog/2024/04/11/how-microsoft-discovers-and-mitigates-evolving-attacks-against-ai-guardrails/\">How Microsoft discovers and mitigates evolving attacks against AI guardrails</a></li>\n\n\n\n<li><a href=\"https://learn.microsoft.com/en-us/defender-office-365/step-by-step-guides/prompt-injection-protection-defender-for-office-365\">Prompt injection protection in Microsoft Defender for Office 365 </a>– official documentation of the prompt injection protection in Microsoft Defender for Office 365.</li>\n\n\n\n<li><a href=\"https://www.microsoft.com/en-us/security/blog/2024/04/11/how-microsoft-discovers-and-mitigates-evolving-attacks-against-ai-guardrails/\">How Microsoft discovers and mitigates evolving attacks against AI guardrails | Microsoft Security Blog</a></li>\n\n\n\n<li><a href=\"https://www.microsoft.com/en-us/security/blog/2026/02/10/ai-recommendation-poisoning/\">Manipulating AI memory for profit: The rise of AI Recommendation Poisoning | Microsoft Security Blog</a> – a related example of an AI-era technique observed in email traffic</li>\n\n\n\n<li><a href=\"https://techcommunity.microsoft.com/blog/microsoftdefenderforoffice365blog/defending-the-inbox-against-prompt-injection-attacks/4534636\">Defending the inbox against prompt injection attacks | Microsoft Defender for Office 365 Blog </a>– feature announcement introducing prompt injection protection in Microsoft Defender for Office 365.</li>\n\n\n\n<li>Learn how Microsoft is reimagining the SOC for the agentic era with <a href=\"https://www.microsoft.com/security/blog/2026/09/23/reimagining-the-soc-for-the-agentic-era-in-microsoft-defender/\">ISOC in Microsoft Defender</a></li>\n</ul><p>The post <a href=\"https://www.microsoft.com/en-us/security/blog/2026/11/03/fake-download-campaign-uses-trojanized-installers-deliver-monetization-payloads/\">Fake-download campaign uses trojanized installers to deliver monetization payloads</a> appeared first on <a href=\"https://www.microsoft.com/en-us/security/blog\">Microsoft Security Blog</a>.</p>","zhKind","complete","黑产","供应链","Microsoft","https://www.microsoft.com/en-us/security/blog/2026/11/03/fake-download-campaign-uses-trojanized-installers-deliver-monetization-payloads/","Microsoft Security Blog",{"_158":159,"_160":-5},"changelogVersion","2026-10-01T08:00","release"]
