[{"_1":2,"_3":4},"root",{"_5":102},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794530489000,"id","obhfumhh687s8ss7ottgn00g5","title","CISA 警告 Linux 内核 Fragnesia 漏洞 CVE-2026-46300 已与 PHP2Shell 在野利用","originalTitle","CISA warns of Fragnesia Linux flaw chained in PHP2Shell attacks","summary","CISA 警告 Fragnesia Linux 内核提权漏洞 CVE-2026-46300 已与 PHP2Shell 漏洞（CVE-2026-109618、CVE-2026-109619）在野利用，可植入 PHP webshell 并以 root 权限运行命令。","reason","CISA 已将 Fragnesia 列入 KEV，并披露其与 PHP2Shell 的组合利用情况，适合相关运维人员核对版本、修复状态与攻击痕迹。","source",{"_73":101},"links",{"_92":100},"publishedAt","2026-10-29T13:59:48.000Z","discoveredAt","2026-10-29T23:39:25.297Z","timelineAt","category","vuln","tags",[96,74,97,98,77,99],"score",83,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","Sergiu Gatlan","body",{"_61":91,"_92":-5,"_93":94,"_95":37},"outline",[82,83],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fRWxuj_pIbsY","reportCount",1,"additionalSourceCount",0,{"_71":76,"_73":77},{"_71":31,"_73":75},{"_71":72,"_73":74},"slug","exploited","name","在野利用","漏洞披露","cisa","CISA",{"_79":80,"_13":81},"publicId","08d448ee-6dba-4279-bdf0-de011a2ea779","CISA将Fragnesia列入KEV并限期修补",{"_11":89,"_85":90,"_87":88},{"_11":84,"_85":86,"_87":88},"sec-2","text","一旦攻击者拥有有效凭据，其操作仅有 37% 会被阻止","level",2,"sec-1","Fragnesia 和 PHP2Shell 漏洞利用链","<p><img alt=\"Linux\" height=\"900\" src=\"/dailyinfo/media/0e5bce0c9d2f2e23.jpg\" srcset=\"/dailyinfo/media/a43e6227d8877558.jpg 720w, /dailyinfo/media/151d50ed1a77a6a0.jpg 1200w, /dailyinfo/media/0e5bce0c9d2f2e23.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>美国网络安全和基础设施安全局（CISA）警告联邦机构修补一个高危 Linux 内核权限提升漏洞，攻击者目前正将其与现实中的 PHP2Shell 漏洞串联利用。</p><p>该漏洞被追踪为 <a href=\"https://security-tracker.debian.org/tracker/CVE-2026-46300\">CVE-2026-46300</a>&nbsp;，也称为&nbsp;<a href=\"https://github.com/v12-security/pocs/tree/main/fragnesia\">Fragnesia</a>，源于 Linux XFRM ESP-in-TCP 子系统中的一个逻辑漏洞，可让攻击者以 root 权限运行恶意代码。</p><p>Fragnesia 属于 <a href=\"https://www.bleepingcomputer.com/news/security/new-linux-dirty-frag-zero-day-with-poc-exploit-gives-root-privileges/\">Dirty Frag</a> 漏洞类别，并且已有概念验证（PoC）漏洞利用程序，本地攻击者可利用它在采用 2026 年 5 月 13 日之前发布的内核的主要 Linux 发行版上获取 root 权限。</p><p>CISA 于周三将 <a href=\"https://www.cisa.gov/news-events/alerts/2026/10/28/cisa-adds-two-known-exploited-vulnerabilities-catalog\">CVE-2026-46300</a> 加入 <a href=\"https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2026-111497\">已知被利用漏洞（KEV）目录</a>，并依据其约束性运营指令（BOD）26-04，要求联邦机构在 10 日星期六之前修补系统。</p><p>该网络安全机构未披露正在进行的 Fragnesia 攻击的详细信息，但指出威胁行为者可将其与两个严重 PHP 漏洞（CVE-2026-109618 和 CVE-2026-109619，统称为 PHP2Shell）串联利用，在未修补的系统上部署 Web shell。</p><p>“该漏洞可与 CVE-2026-109618 和 CVE-2026-109619 串联利用，以植入 PHP Web shell 并以 root 身份运行命令，”&nbsp;<a href=\"https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2026-46300\">CISA 表示</a>。</p><h2 id=\"sec-1\">Fragnesia 和 PHP2Shell 漏洞利用链</h2><p>尽管 CISA 未提供更多关于攻击者串联利用 Fragnesia 和 PHP2Shell 漏洞的信息，但 Dream Security 分析人员在一份周一的报告中表示，这些漏洞已被用于入侵二十多台服务器，其中包括一台美国政府关联组织的服务器。</p><p>“Dream 研究人员发现了一次完整的攻击行动，其中包括对 PHP2Shell 漏洞利用链（CVE-2026-109618/CVE-2026-109619）的定制武器化，并将其与 Fragnesia 内核权限提升漏洞（CVE-2026-46300）结合，还包括目标列表、漏洞利用日志以及大约 40 个定制的漏洞利用后脚本，”&nbsp;<a href=\"https://dreamgroup.com/blog/chained-php2shell-exploit-roots-25-servers\">他们表示</a>。</p><p>“其中包括一次已控制美国、日本、台湾和韩国境内 25 台服务器的攻击活动痕迹。在取得 root 权限后，攻击者将目标锁定在美国政府关联环境中的三台特定服务器上。”</p><p>CISA 还于周一将 <a href=\"https://www.bleepingcomputer.com/news/security/cisa-confirms-php2shell-vulnerabilities-now-exploited-in-attacks/\">PHP2Shell 漏洞</a> 加入其actively exploited vulnerabilities 列表，并要求联邦文官行政分支（FCEB）机构在周四之前保护其网络。</p><p>尽管美国网络安全机构尚未提供有关正在进行的 PHP2Shell 攻击的更多详细信息，但 Perplexity 安全工程师 Adel Karimi 证实，其蜜罐在周末记录到了针对运行 PHP 8.4.26 的 Apache mod_php 安装环境的 <a href=\"http://github.com/0x4D31/honeypot-data/tree/main/reports/php2shell/2026-10-24-rce-evidence\">远程代码执行</a><a href=\"https://www.linkedin.com/posts/malwaretech_confirmed-in-the-wild-exploitation-of-php2shell-share-7519864366863847424-TaMU/\">证据</a>。</p><p><span>当 BleepingComputer 于今天早些时候联系时，CISA&nbsp;发言人无法立即提供更多信息，说明威胁行为者可能在攻击中串联利用 Fragnesia 和</span><span>&nbsp;PHP2Shell。</span></p><p><a href=\"https://hubs.li/Q04sB3fb0\">\n            <img src=\"/dailyinfo/media/8992a76d3e63078b.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-2\">\n            <a href=\"https://hubs.li/Q04sB3fb0\">一旦攻击者拥有有效凭据，其操作仅有 37% 会被阻止</a>\n        </h2><p>总体预防评分可能掩盖初始访问后发生的情况。一旦攻击者使用有效凭据，预防效果就会大幅下降。</p><p>《Blue Report 2026》通过在客户生产环境中运行的 338 million 次模拟，逐项衡量防御技术。</p><p><a href=\"https://hubs.li/Q04sB3fb0\">获取报告</a>\n    </p>","original","zhKind","translation","complete","漏洞","利用链","补丁","NVD","https://www.bleepingcomputer.com/news/security/cisa-warns-of-fragnesia-linux-flaw-chained-in-php2shell-attacks/","BleepingComputer",{"_103":104,"_105":-5},"changelogVersion","2026-10-01T08:00","release"]
