[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1794530493000,"id","tthpdpwhuywrbj6runx9i9ryn","title","PostgreSQL 18.7 等版本修复 52 个漏洞并终止 PostgreSQL 14 支持","originalTitle","PostgreSQL security update fixes 52 vulnerabilities, ends support for PostgreSQL 14","summary","PostgreSQL Global Development Group 于 November 12 发布 PostgreSQL 18.7、17.12、16.16、15.20 和 14.25，修复 52 个安全漏洞及 140 多个其他缺陷，其中 32 个 CVE 的 CVSS 分为 8.8。","reason","原文列出了多版本修复范围、漏洞评分和升级后索引处理事项，便于管理员评估维护与迁移工作。","source",{"_63":85},"links",{"_77":84},"publishedAt","2026-11-12T23:05:33.000Z","discoveredAt","2026-11-12T23:14:23.116Z","timelineAt","category","vuln","tags",[81,82,83,66],"score",76,"selected",true,"channel","news","story","x","readingMode","full","author","Anamarija Pogorelec","body",{"_59":76,"_77":-5,"_78":79,"_80":37},"outline",[67,68],"relatedStories",[],"topics",[60,61],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_62":65,"_63":66},{"_62":31,"_63":64},"slug","name","漏洞披露","vuln-mgmt","漏洞管理",{"_11":74,"_70":75,"_72":73},{"_11":69,"_70":71,"_72":73},"sec-2","text","PostgreSQL 14 已结束生命周期","level",3,"sec-1","部分修复需要重建索引","<p>PostgreSQL 全球开发小组 <a href=\"https://www.postgresql.org/about/news/postgresql-187-1712-1616-1520-1425-and-19-rc-2-released-3442/\">发布了</a> PostgreSQL 18.7、17.12、16.16、15.20 和 14.25，于 11 月 12 日修复了 52 个安全漏洞和 140 多个其他缺陷。</p><p><img src=\"/dailyinfo/media/8919beb7e1dffd78.webp\" loading=\"lazy\" decoding=\"async\" alt=\"PostgreSQL security update\" title=\"PostgreSQL\"></p><p>其中大多数代码执行漏洞属于内存错误或类型混淆，即 PostgreSQL 将某个值作为错误的数据类型处理。问题出现在 PL/Perl 和 PL/Tcl、ts_rank_cd() 等文本搜索函数、并行查询、逻辑复制、dblink 和统计信息导入中。这 52 个 CVE 中有 32 个的 CVSS 分数为 8.8，是本批次中最高的。最低分的一项是利用转换函数绕过 EXECUTE 权限，分数为 3.1。</p><p>这些修复也涵盖 PostgreSQL 的客户端工具。pg_dump 工具存在通过非空约束名称实施的 SQL 注入，其 tar 格式恢复脚本未能阻止 psql 命令注入。reindexdb 工具错误处理了索引名称的引号。如果你使用这些工具连接其他用户可以创建并命名对象的数据库，请将客户端二进制文件与服务器一并更新。</p><h3 id=\"sec-1\">部分修复需要重建索引</h3><p>若干缺陷修复要求在新二进制文件部署后进行额外处理。被怀疑已损坏的 GIN 索引应重建索引。使用 gist_trgm_ops 的 pg_trgm GiST 索引也应重建索引，声明时未指定长度的 bpchar 列上的 B-tree 索引同样需要处理。出现“missing chunk number”错误的表需要执行 REINDEX TABLE。使用增量备份的管理员应先创建一份新的完整备份，并以此作为后续增量备份的基础，因为此次修复的若干缺陷可能导致备份损坏。</p><h3 id=\"sec-2\">PostgreSQL 14 已结束生命周期</h3><p>14.25 是 PostgreSQL 14 的最终版本，此后不会再获得安全或缺陷修复。仍在运行该版本的服务器需要制定迁移到受支持版本的计划。</p><p>该项目还发布了 PostgreSQL 19 RC 2，计划于 11 月 19 日正式可用。测试过 19 版的用户应了解，RC 2 撤销了在表达式索引、生成列和分区键中对数组、复合类型和范围类型使用 JSON_ARRAY() 与 JSON_OBJECT() 的支持。以此方式创建的对象必须在升级前删除或重新定义。</p>","original","zhKind","translation","complete","漏洞","补丁","数据库","https://www.helpnetsecurity.com/2026/11/13/postgresql-security-update-november-2026/","Help Net Security",{"_87":88,"_89":-5},"changelogVersion","2026-10-01T08:00","release"]
