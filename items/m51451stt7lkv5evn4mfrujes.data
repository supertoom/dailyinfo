[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795394436000,"id","m51451stt7lkv5evn4mfrujes","title","NGINX HTTP/2 远程代码执行漏洞 CVE-2026-123007 已复现","originalTitle","已复现！nginx2root nginx http2 远程代码执行漏洞","summary","微步在线已在实验环境中复现 NGINX HTTP/2 远程代码执行漏洞 CVE-2026-123007。该漏洞影响启用 HTTP/2 的未修复实例，攻击者无需认证或受害者配合即可远程执行代码并获得 NGINX 工作进程权限；在满足相关环境条件时，还可串联 Linux SCTP 内核漏洞实现宿主机 root 提权及容器逃逸。","reason","文章给出多个受影响版本、PoC 复现结果、官方修复版本及按漏洞划分的临时缓解措施，便于部署方评估暴露面并选择处置路径。","source",{"_73":103},"links",{"_93":102},"publishedAt","2026-11-19T00:56:00.000Z","discoveredAt","2026-11-19T15:59:20.380Z","timelineAt","category","disclosure","tags",[96,97,98,99,100,101],"score",81,"selected",true,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","body",{"_61":92,"_93":-5,"_94":93,"_95":37},"outline",[83,84],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fM_VcWDToZd0","reportCount",1,"additionalSourceCount",0,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","research","name","技术研究","vuln","漏洞披露","cloud-native","云与原生",{"_80":81,"_13":82},"publicId","3eb72e03-2965-4ea3-8b98-657fd92ab44d","F5已修复NGINX五项未认证RCE",{"_11":90,"_86":91,"_88":89},{"_11":85,"_86":87,"_88":89},"sec-2","text","临时缓解措施","level",3,"sec-1","官方修复方案","<p><span>微步情报局</span> <span>2026-11-19 08:56</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/f5438d7071cc04e8.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>点击查看漏洞情报详情</p><p><span><span>漏洞概况</span></span></p><p><span>NGINX</span><span>是一款开源的高性能 Web 服务器、反向代理服务器和邮件代理服务器，也常被用作 TCP/UDP 代理、负载均衡器和 API 网关，是全球部署量最大的开源 Web 服务器与反向代理软件之一。</span></p><p><span>近日，F5官方发布通告，修复了</span><span>NGINX 的 5 个内存安全漏洞，分别影响 HTTP/2、HTTP/3、DNS 解析及邮件代理等功能的特定配置。其中，CVE-2026-123007 影响启用 HTTP/2 的未修复实例，已验证攻击者无需身份认证即可远程执行代码，获得 NGINX 工作进程权限。此外，在满足相关环境条件时，攻击者还可串联另一个 Linux SCTP 内核漏洞，实现宿主机 root 提权及容器逃逸。</span></p><p><span>（完整漏洞情报请查阅<a href=\"https://x.threatbook.com/v5/vul/XVE-2026-\">https://x.threatbook.com/v5/vul/XVE-2026-</a></span><span>99666</span><span>）</span></p><p><span>攻击者成功利用此漏洞可</span><span><span>在受影</span><span>响</span><span>服务器上执行任意代码，亦可导致子进程崩溃、业务中断。</span></span><span>建议受影响用户</span><span><span>尽快修复。</span></span></p><p><span><span>漏洞处置优先级(VPT)</span></span></p><p><strong><span>综合处置优先级：</span><span><span>高</span></span></strong><span><span>风险</span></span></p><table><tbody><tr><td rowspan=\"3\"><p><span>基本信息</span></p></td><td><p><span>微步编号</span></p></td><td><p><span>XVE-2026-</span><span>99666</span></p><p><span>XVE-2026-99635</span></p><p><span>XVE-2026-99659</span></p><p><span>XVE-2026-99673</span></p><p><span>XVE-2026-99682</span></p></td></tr><tr><td><p><span>CVE编号</span></p></td><td><p><span>CVE-2026-</span><span>123007</span></p><p><span>CVE-2026-123633</span></p><p><span>CVE-2026-121810</span></p><p><span>CVE-2026-123634</span></p><p><span>CVE-2026-113425</span></p></td></tr><tr><td><p><span>漏洞类型</span></p></td><td><p><span>远程代码执行</span></p></td></tr><tr><td rowspan=\"5\"><p><span>利用条件评估</span></p></td><td><p><span>利用漏洞的网络条件</span></p></td><td><p><span>远程</span></p></td></tr><tr><td><p><span>是否需要绕过安全机制</span></p></td><td><p><span>要</span></p></td></tr><tr><td><p><span>对被攻击系统的要求</span></p></td><td><p><span>启动</span><span><span>HTTP/2</span></span></p></td></tr><tr><td><p><span>利用漏洞的权限要求</span></p></td><td><p><span>无须用户权限</span></p></td></tr><tr><td><p><span>是否需要受害者配合</span></p></td><td><p><span>否</span></p></td></tr><tr><td rowspan=\"2\"><p><span>利用情报</span></p></td><td><p><span>是否有POC</span></p></td><td><span><span>是</span></span></td></tr><tr><td><p><span>已知利用行为</span></p></td><td><p><span>暂无</span></p></td></tr></tbody></table><p><span><span>漏洞影响范围</span></span></p><table><tbody><tr><td><p><span>产品名称</span></p></td><td><p><span>Nginx</span></p></td></tr><tr><td><p><span>受影响版本</span></p></td><td><p><span>1、Nginx Plus</span></p><p><span>CVE-2026-123007&nbsp;</span></p><p><span>37.0.0 &lt;= NGINX &lt; 37.0.8.1</span></p><p><span>37.1.0 &lt;= NGINX &lt; 37.2.0.1</span></p><p><span>R34 &lt;= NGINX &lt;= R36</span></p><p><span>CVE-2026-123634</span></p><p><span>37.0.0 &lt;= NGINX &lt; 37.0.8.1</span></p><p><span>37.1.0 &lt;= NGINX &lt; 37.2.0.1</span></p><p><span>R34 &lt;= NGINX &lt;= R36</span></p><p><span>CVE-2026-123633</span></p><p><span>37.0.0 &lt;= NGINX &lt; 37.0.7.1</span></p><p><span>37.1.0 &lt;= NGINX &lt; 37.2.0.1</span></p><p><span>R34 &lt;= NGINX &lt;= R36</span></p><p><span>CVE-2026-121810</span></p><p><span>37.0.0 &lt;= NGINX &lt; 37.0.8.1</span></p><p><span>37.1.0 &lt;= NGINX &lt; 37.2.0.1</span></p><p><span>R34 &lt;= NGINX &lt;= R36</span></p><p><span>CVE-2026-113425&nbsp;</span></p><p><span>37.0.0 &lt;= NGINX &lt; 37.0.8.1</span></p><p><span>37.1.0 &lt;= NGINX &lt; 37.2.0.1</span></p><p><span>R34 &lt;= NGINX &lt;= R36</span></p><p><span>2、Nginx Open Source</span></p><p><span>CVE-2026-123007&nbsp;</span></p><p><span>1.9.5 &lt;= NGINX &lt;= 1.31.8</span></p><p><span>CVE-2026-123634&nbsp;</span></p><p><span>0.6.18 &lt;= NGINX &lt;= 1.31.8</span></p><p><span>CVE-2026-123633&nbsp;</span></p><p><span>1.19.7 &lt;= NGINX&lt;= 1.31.8</span></p><p><span>CVE-2026-121810&nbsp;</span></p><p><span>1.25.0 &lt;= NGINX &lt;= 1.31.8</span></p><p><span>CVE-2026-113425&nbsp;</span></p><p><span>0.5.33 &lt;= NGINX &lt;= 1.31.8</span></p></td></tr><tr><td><p><span>有无修复补丁</span></p></td><td><p><span>有</span></p></td></tr></tbody></table><p><span><span>漏洞复现</span></span></p><p><span>微步在线已在实验环境中成功复现</span><span>CVE-2026-123007</span><span>&nbsp;nginx远程代码执行漏洞</span></p><p><img src=\"/dailyinfo/media/e75b976b865e46d5.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>修复方案</span></span></p><h3 id=\"sec-1\"><span>官方修复方案</span></h3><p><span>官方已发布修复方案，请访问链接下载：</span><span><br></span></p><p><span><span><a href=\"https://github.com/nginx/nginx/releases/tag/release-1.31.9\">https://github.com/nginx/nginx/releases/tag/release-1.31.9</a></span></span></p><p><span><span><a href=\"https://nginx.org/en/security_advisories.html\">https://nginx.org/en/security_advisories.html</a></span></span></p><h3 id=\"sec-2\"><span>临时缓解措施</span></h3><p><span>1、临时禁用 HTTP/2。 关闭受影响服务的 HTTP/2 功能，移除监听配置中的 http2 参数，并在支持的版本中设置 http2 off;，阻断 CVE-2026-123007 和 CVE-2026-123633 的已知攻击路径。实施前应评估对 gRPC 等依赖 HTTP/2 业务的影响。</span></p><p><span>2、临时禁用 HTTP/3／QUIC。 移除 QUIC 监听配置，设置 http3 off;，停止发布 HTTP/3 服务通告，必要时通过防火墙封禁对应 UDP 端口，降低 CVE-2026-121810 的利用风险。</span></p><p><span>3、调整动态域名解析及子请求配置。 针对 CVE-2026-123634，避免使用 SSI、mirror 等相关子请求配置，同时避免代理目标域名包含变量；可改用指向固定后端 IP 的上游配置，消除相关请求期间的动态域名解析。</span></p><p><span>4、限制邮件代理服务的访问范围。 针对 CVE-2026-113425，通过防火墙、安全组或访问白名单，仅允许可信来源访问 IMAP、POP3、SMTP 等邮件代理端口；不需要对外提供服务时，应关闭相关监听或绑定回环地址。</span></p><p><span><span>微步产品支撑</span></span></p><p><span>微步漏洞情报于</span><span><span>2026-11-18</span></span><span>收录该漏洞。</span></p><p><span>微步下一代威胁情报平台NGTIP及X情报中心已于漏洞收录时向漏洞订阅用户推送该漏洞情报，并将持续推送后续更新；对于已经录入资产的用户，支持实时自动化排查受影响资产。</span></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=470a73fd&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzg5MTc3ODY4Mw%3D%3D%26mid%3D2247509063%26idx%3D1%26sn%3D45c71724375b83415bf880558c549bf0\">跳转微信打开</a></p>","original","zhKind","complete","复现","漏洞分析","漏洞利用","网络设备","容器","利用链","https://mp.weixin.qq.com/s?__biz=Mzg5MTc3ODY4Mw==&mid=2247509063&idx=1&sn=45c71724375b83415bf880558c549bf0","微步在线研究响应中心",{"_105":106,"_107":-5},"changelogVersion","2026-10-01T08:00","release"]
