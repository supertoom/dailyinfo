[{"_1":2,"_3":4},"root",{"_5":105},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1795221635000,"id","m0fgnwuz8jy2ixu23xvd4pojv","title","Ruby 远程代码执行漏洞 CVE-2026-132825 影响 2.4.0 至 4.0.9","originalTitle","【漏洞通告】Ruby远程代码执行漏洞（CVE-2026-132825）","summary","Ruby 远程代码执行漏洞 CVE-2026-132825 影响 2.4.0 至 3.3.13、3.4.0 至 3.4.12 和 4.0.0 至 4.0.9，CVSS 评分为 7.4。","reason","source",{"_71":104},"links",{"_97":103},"publishedAt","2026-11-20T03:35:00.000Z","discoveredAt","2026-11-20T17:23:34.033Z","timelineAt","category","vuln","tags",[100,101,102],"score",68,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body",{"_60":96,"_97":-5,"_98":97,"_99":55},"outline",[78,79,80,81,82],"relatedStories",[74],"topics",[67,68],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","f6WA2ackQ-jM","reportCount",2,"additionalSourceCount",1,{"_69":30,"_71":73},{"_69":70,"_71":72},"slug","research","name","技术研究","漏洞披露",{"_75":76,"_13":77},"publicId","64c14d14-b61b-4d9c-9257-6bf7916a34c8","Ruby修复堆越界写入RCE漏洞",{"_11":94,"_84":95,"_86":87},{"_11":92,"_84":93,"_86":87},{"_11":90,"_84":91,"_86":87},{"_11":88,"_84":89,"_86":87},{"_11":83,"_84":85,"_86":87},"sec-5","text","4.2 其他防护措施","level",3,"sec-4","4.1 官方升级","sec-3","3.1 人工检测","sec-2","不受影响版本","sec-1","受影响版本","<p><span>NS-CERT</span> <span>2026-11-20 11:35</span> <span>中国香港</span></p><p><img src=\"/dailyinfo/media/fa8f18039f539855.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>近日，绿盟科技CERT监测到Ruby发布安全公告，修复了Ruby远程代码执行漏洞（CVE-2026-132825），被称为“Ruby2Shell”，CVSS评分7.4，请相关用户尽快采取措施进行防护。</p><p><strong><span>通告编号 NS-2026-0036</span></strong></p><p><span><span>2026-11-20</span></span></p><table><tbody><tr><td><strong><span><span>TAG：</span></span></strong></td><td><p><strong><span><span>Ruby、堆缓冲区溢出、CVE-2026-132825</span></span></strong></p></td></tr><tr><td><strong><span><span>漏洞危害：</span></span></strong></td><td><p><strong><span>攻击者利用此漏洞，可实现远程代码执行。</span></strong></p></td></tr><tr><td><strong><span><span>版本：</span></span></strong></td><td><p><strong><span>1.0</span></strong></p></td></tr></tbody></table><p><strong><span>1</span></strong></p><p><strong><span><span>漏洞概述</span></span></strong></p><p><span>近日，绿盟科技CERT监测到Ruby发布安全公告，修复了Ruby远程代码执行漏洞（CVE-2026-132825），被称为“Ruby2Shell”；Ruby在对ISO-8859-1、Windows-1252等部分单字节编码字符串进行大小写转换时输出缓冲区的边界检查未覆盖实际写入长度，攻击者可诱使应用程序对特制字符串执行大小写转换，从而造成堆缓冲区溢出，在特定场景下可实现远程代码执行。CVSS评分7.4，请相关用户尽快采取措施进行防护。</span></p><p><span>Ruby是一种开源、动态的面向对象编程语言，具有简洁灵活的语法和丰富的标准库，广泛用于Web开发、自动化脚本及服务端应用，Ruby on Rails是其代表性Web框架。</span></p><p><span>参考链接：</span></p><p><span><a href=\"https://github.com/ruby/ruby/security/advisories/GHSA-34m4-m9fh-gqp5\">https://github.com/ruby/ruby/security/advisories/GHSA-34m4-m9fh-gqp5</a></span></p><p><span><a href=\"https://www.ruby-lang.org/en/news/2026/11/18/multiple-vulnerabilities-in-regexp-and-string\">https://www.ruby-lang.org/en/news/2026/11/18/multiple-vulnerabilities-in-regexp-and-string</a></span></p><p><strong><span>SEE MORE →</span></strong></p><p><span><strong><span>2</span></strong></span><strong><span>影响范围</span></strong></p><h3 id=\"sec-1\"><strong><span>受影响版本</span></strong></h3><ul><li><p><span>2.4.0 &lt;= Ruby &lt;= 3.3.13</span></p></li><li><p><span>3.4.0 &lt;= Ruby &lt;= 3.4.12</span></p></li><li><p><span>4.0.0 &lt;= Ruby &lt;= 4.0.9</span></p></li></ul><p><span>注：该漏洞需对ISO-8859-1、Windows-1252等部分单字节编码字符串执行大小写转换才可触发，UTF-8字符串不受影响；已知Rails和经典模式Sinatra应用在默认配置下受影响。Ruby 3.2及更早版本官方已停止维护。</span></p><h3 id=\"sec-2\"><strong><span>不受影响版本</span></strong></h3><ul><li><p><span>Ruby 3.3.x &gt;= 3.3.14</span></p></li><li><p><span>Ruby 3.4.x &gt;= 3.4.13</span></p></li><li><p><span>Ruby 4.0.x &gt;= 4.0.10</span></p></li></ul><p><span><strong><span>3</span></strong></span><strong><span>漏洞检测</span></strong></p><h3 id=\"sec-3\"><strong><span>3.1 人工检测</span></strong></h3><p><span>相关用户可以通过检查当前Ruby版本及编码转换行为，判断当前应用是否在受影响范围：</span></p><p><span>1、检查当前Ruby版本</span></p><pre><code><span>ruby -v</span></code></pre><p><span>2、确认应用是否使用Rails或经典模式Sinatra</span></p><p><span>在项目根目录及实际应用使用的Bundle环境中执行以下命令：</span></p><pre><code><span>bundle list | grep -E 'rails|sinatra'</span></code></pre><p><span>3、检索代码中单字节编码字符串的大小写转换调用</span></p><pre><code><span># 在业务代码及关键依赖中检索单字节编码（如ISO-8859-1、Windows-1252）相关的设置或转换逻辑：</span><span><br></span><span>grep -rniE '(iso[-]8859[-][0-9]+|windows[-_]125[0-8]|cp125[0-8]|force_encoding\\b|.encode\\b|encoding:)' --include='*.rb' .</span><span><br></span><span># 检索大小写转换及比较相关调用：</span><span><br></span><span>grep -rnE '.(upcase!?|downcase!?|capitalize!?|swapcase!?|casecmp??)([^a-zA-Z0-9_]|$)' --include='*.rb' .</span></code></pre><p><span>若当前Ruby版本在受影响范围，且应用属于Rails 或经典模式Sinatra默认场景或业务中存在对ISO-8859-1、Windows-1252等单字节编码字符串执行大小写转换的场景，则可能存在安全风险。</span></p><p><span><strong><span>4</span></strong></span><strong><span>漏洞防护</span></strong></p><h3 id=\"sec-4\"><strong><span>4.1 官方升级</span></strong></h3><p><span>目前官方已发布新版本修复此漏洞，建议受影响的用户及时升级版本进行防护，下载链接：<a href=\"https://www.ruby-lang.org/en/downloads/\">https://www.ruby-lang.org/en/downloads/</a></span></p><p><span>注：使用内嵌Ruby的自建软件或系统发行版用户，应安装对应厂商发布的修复版本。</span></p><h3 id=\"sec-5\"><strong><span>4.2 其他防护措施</span></strong></h3><p><span>在不影响业务的情况下，相关用户可通过下列措施进行临时缓解：</span></p><p><span>避免对不可信输入直接执行大小写转换，或对输入字符串的长度与编码进行严格校验与过滤；若业务依赖ISO-8859-1、Windows-1252等受影响的单字节编码，可在敏感处理路径前改用UTF-8等不受影响的编码进行转换。</span></p><p><strong><span>END</span></strong></p><p><img src=\"/dailyinfo/media/d80afd58e695f438.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img src=\"/dailyinfo/media/d0b7cde05d67ff1f.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>声明</span></strong></p><p><span>本安全公告仅用来描述可能存在的安全问题，绿盟科技不为此安全公告提供任何保证或承诺。由于传播、利用此安全公告所提供的信息而造成的任何直接或者间接的后果及损失，均由使用者本人负责，绿盟科技以及安全公告作者不为此承担任何责任。</span></p><p><span>绿盟科技拥有对此安全公告的修改和解释权。如欲转载或传播此安全公告，必须保证此安全公告的完整性，包括版权声明等全部内容。未经绿盟科技允许，不得任意修改或者增减此安全公告内容，不得以任何方式将其用于商业目的。</span></p><p><img src=\"/dailyinfo/media/d0b7cde05d67ff1f.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><span><strong><span>绿盟科技CERT</span></strong></span><span><span>∣</span></span><span><span>微信公众号</span></span></p><p><img src=\"/dailyinfo/media/473526bfa52947a2.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><img src=\"/dailyinfo/media/e1a29d3eda6f9ac3.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><span>长按识别二维码，关注网络安全威胁信息</span></span></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=51af5518&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzk0MjE3ODkxNg%3D%3D%26mid%3D2247494212%26idx%3D2%26sn%3De53b088391f020973f3fdb5ae146ab2d\">跳转微信打开</a></p>","original","zhKind","complete","漏洞","补丁","漏洞分析","https://mp.weixin.qq.com/s?__biz=Mzk0MjE3ODkxNg==&mid=2247494212&idx=2&sn=e53b088391f020973f3fdb5ae146ab2d","绿盟科技CERT",{"_106":107,"_108":-5},"changelogVersion","2026-10-01T08:00","release"]
