[{"_1":2,"_3":4},"root",{"_5":139},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794616836000,"id","y898vv9xn8ef61ymi2wwi96ss","title","Check Point Security Gateway 遭 PHP2Shell 在野利用，CVE-2026-123039 被用于提权","originalTitle","PHP2Shell Exploitation on Check Point Gateway","summary","攻击者自 2026 年 10 月 30 日起利用未修补的 Check Point Security Gateway Mobile Access 门户开展扫描与利用，以 PHP2Shell 及 CVE-2026-109618、CVE-2026-109619 获取初始访问，再利用 DynamicCLI 接口的本地提权漏洞 CVE-2026-123039 提权至 root。","reason","文章还原了从 PHP2Shell 初始访问、权限提升到后门驻留与破坏的完整链路，并公开相关 IOC，便于防守方识别和处置。","source",{"_76":138},"links",{"_127":137},"publishedAt","2026-11-12T13:56:37.000Z","discoveredAt","2026-11-12T14:30:23.436Z","timelineAt","category","activity","tags",[79,81,77,131,132,133,87,134,135,136],"score",86,"selected",true,"channel","news","story",{"_89":90,"_13":91},"x","readingMode","full","author","matthewsu@checkpoint.com","body",{"_61":126,"_127":-5,"_128":129,"_130":37},"outline",[92,93,94,95,96,97,98,99,100,101],"relatedStories",[88],"topics",[68,69,70,71,72,73],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fB8tLU_zSWrc","reportCount",1,"additionalSourceCount",0,{"_74":86,"_76":87},{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","malware","name","恶意软件","attack","攻击活动","exploited","在野利用","black-market","数据窃取与黑产","ransomware","勒索软件","checkpoint","Check Point",{"_89":90,"_13":91},"publicId","7c28657e-31de-4920-a954-1af1b284351f","CISA确认Brotli漏洞遭在野利用",{"_11":124,"_103":125,"_105":109},{"_11":122,"_103":123,"_105":109},{"_11":120,"_103":121,"_105":109},{"_11":118,"_103":119,"_105":109},{"_11":116,"_103":117,"_105":106},{"_11":114,"_103":115,"_105":106},{"_11":112,"_103":113,"_105":106},{"_11":110,"_103":111,"_105":106},{"_11":107,"_103":108,"_105":109},{"_11":102,"_103":104,"_105":106},"sec-10","text","IOC","level",3,"sec-9","归因",2,"sec-8","TSProxy","sec-7","TSGA – slot_CPconfigdaemon","sec-6","擦除器","sec-5","Web shell","sec-4","技术分析","sec-3","感染流程","sec-2","引言","sec-1","主要发现","<h2 id=\"sec-1\">主要发现</h2><ul>\n<li>自 2026 年 10 月 30 日起，攻击者针对存在未修补漏洞的 Check Point Security Gateway 组织发起扫描和漏洞利用活动，以带有 PHP2Shell 的 Mobile Access 门户作为初始访问途径，随后利用 CVE-2026-123039。</li>\n\n\n\n<li>第一波攻击于 10 月 30 日展开，以色列组织成为目标，其中包括针对其中部分组织的破坏性活动。11 月 2 日的第二波攻击范围更广，目标涵盖多个国家和多个行业，未发现破坏性活动。</li>\n\n\n\n<li>在所调查的入侵中，PHP2Shell 提供了初始访问途径，随后攻击者利用 DynamicCLI 接口进行权限提升，该漏洞追踪为 CVE-2026-123039。攻击者随后部署了 PHP webshell、持久化 TSGA 后门及其内置的 TSProxy 网络组件。</li>\n\n\n\n<li>攻击者通过 SSH 从网关转向 VMware ESXi 主机，部署 destroy_v6 擦除器，并在破坏阶段留下带有政治主题的 DREAM_ANNEXATION.txt 字条。</li>\n\n\n\n<li>TSGA 和 TSProxy 是 PhiliKit 的修改变体；该恶意软件框架此前曾出现在<a href=\"https://web-assets.esetstatic.com/wls/en/papers/threat-reports/eset-apt-activity-report-q4-2025-q1-2026.pdf\">相关文档记录</a>中，用于利用 Ivanti 漏洞的攻击。这两种工具与该框架共享独特的代码、配置和加密材料。</li>\n\n\n\n<li>尽管 ESET 将 PhiliKit 与中国关联组织 UNC5221 联系起来，但现有证据无法让我们高度确信地判断本次行动的真实性质。仍有多种可能情形：所识别攻击者策划了整个行动、仅充当初始访问代理，或参与了一场虚假旗行动。破坏性活动也不排除是烟幕的可能。</li>\n\n\n\n<li>破坏性活动期间留下的字条使用了 Dream Security 品牌。Dream 此前刚刚<a href=\"https://dreamgroup.com/blog/chained-php2shell-exploit-roots-25-servers\"><u>发布</u></a>了关于中国关联组织利用 PHP2Shell 入侵 Palo Alto Networks 设备的研究。尽管这一时间关系引发了报复的可能性，但现有证据未能确立明确的动机。</li>\n</ul><h2 id=\"sec-2\">引言</h2><p>我们现已确认，在 2026 年 10 月下旬，即安全修复发布约一周后，来自 130.94.19[.]204 的活动通过 Check Point Security Gateway 上存在漏洞的 Mobile Access 门户 targeting 以色列组织。证据表明，部分案例遭到成功入侵，其漏洞利用活动与 PHP2Shell 一致，涉及 CVE-2026-109618 和 CVE-2026-109619。</p><p>在获得初始访问后，攻击者利用 <a href=\"https://support.checkpoint.com/results/sk/sk1000362\"><strong>CVE-2026-123039</strong></a>，将权限从门户服务账户提升至 root；这是 DynamicCLI IPC 接口中的一个本地权限提升漏洞。攻击者随后利用特权命令执行部署 PHP webshell 并建立持久化。</p><p>11 月 2 日<sup>nd</sup>的第二波扫描以第一波攻击期间曾被 targeting 的部分以色列组织为目标，同时还 targeting 了全球其他组织，似乎并未明确聚焦于以色列。两波攻击均未表现出明显的行业偏好，说明这属于机会主义的初始访问尝试，而非针对特定行业的定向攻击。</p><h2 id=\"sec-3\">感染流程</h2><p>2026 年 10 月 30 日，受攻击的 Check Point Mobile Access 网关首次出现了被利用的迹象。在 /opt/CPcvpn-R81.20/tmp/ 下创建了 PHP 会话工件，其中包括带有 upload_progress_pwn 标记的会话文件，该标记与此次利用活动有关。在同一时间段内，该门户的 Apache/PHP 工作进程出现了数百次段错误，为反复尝试利用该服务提供了更多证据。</p><figure><img width=\"2560\" height=\"1425\" src=\"/dailyinfo/media/f9705ecfbd24315a.webp\" srcset=\"/dailyinfo/media/73430b89cd5f13b8.webp 720w, /dailyinfo/media/a61d41fdfeea071f.webp 1200w, /dailyinfo/media/f9705ecfbd24315a.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Infection chain\"><figcaption>图 1 – 感染链</figcaption></figure><p>在获取 Mobile Access 门户访问权限后，攻击者利用 DynamicCLI 接口中的本地权限提升漏洞 <strong>CVE-2026-123039</strong>，将权限提升至 <strong>root</strong>。凭借特权命令执行能力，攻击者将 PHP Web shell 放入 &lt;templates&gt;，这是 Mobile Access 门户用于构建登录页面的目录。这些 Web shell 提供了一种通过 Web 门户发送命令的方式，从而在已入侵的环境中建立了更牢固的据点。</p><pre>printf &lt;base64 Webshell&gt; | base64 -d &gt; &lt;templates&gt;/zz&lt;random&gt;.tpl</pre><p>攻击者使用了多个名称匹配 zz*.tpl 模式的 .tpl 文件。每个文件最初都包含一个命令执行 shell，随后被替换为功能更强大的版本。扩展后的 shell 需要硬编码密钥 zz2026，并支持操作系统命令、PHP 代码执行和文件上传。上传的文件保存到固定路径 /tmp/.up.tpl。随后，攻击者发出命令，将该文件复制到门户目录并命名为 challenge_render.tpl。</p><p>随后，攻击者从基于 Web 的访问转向独立的被动后门，在后台启动 <strong>TSGA 恶意软件</strong>（/tmp/CPconfigdaemon），并将其输出重定向至隐藏的临时日志：</p><pre>nohup /tmp/CPconfigdaemon &gt;/tmp/.bd.log 2&gt;&amp;1 &amp; printf started</pre><p>以 root 身份执行时，该恶意软件会自行迁移至启动持久化目录，并以 slot_CPconfigdaemon 为名重新启动。该可执行文件还携带第二个组件 <strong>TSProxy</strong>：这是一个嵌入式共享库，会被写入 /lib/libcpfwcommon.so。其注入代码会将该库加载到选定的设备进程中，在其中拦截网络函数，以处理带有特殊标记的攻击者连接，同时允许常规流量继续传输。这将独立的持久化后门与通过现有设备服务进行的隐蔽访问结合起来。</p><p>随后，攻击者在网关上部署了 <a href=\"https://github.com/chainreactors/gogo\"><u>gogo</u></a> 扫描器，以发现网络中的内部资产和服务，并通过 SSH 使用 <a href=\"https://cloud.google.com/blog/topics/threat-intelligence/vmware-esxi-zero-day-bypass\">vpxuser</a> 服务账户继续横向移动至 VMware ESXi 主机。在该 ESXi 主机上，他们将 destroy_v6 擦除器暂存至 /tmp/des wiper 并执行。最终，攻击者留下一条名为 DREAM_ANNEXATION.txt 的说明，伴随此次破坏活动。</p><figure><img width=\"921\" height=\"839\" src=\"/dailyinfo/media/6e0bb6804c85d619.webp\" srcset=\"/dailyinfo/media/002c84d730978c12.webp 720w, /dailyinfo/media/b2d59bb5d40fcd45.webp 1200w, /dailyinfo/media/6e0bb6804c85d619.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Destructive activity note\"><figcaption>图 2 – 破坏活动说明</figcaption></figure><h2 id=\"sec-4\">技术分析</h2><h3 id=\"sec-5\">Web shell</h3><p>扩展后的 PHP Web shell 需要硬编码密钥才能访问其命令执行、PHP 求值和文件上传功能。它支持纯文本命令以及经过 Base64 编码和 XOR 混淆的命令，并将上传的文件保存到 /tmp/.up.tpl。</p><figure><img width=\"1024\" height=\"524\" src=\"/dailyinfo/media/20e39c0928fb5d9e.webp\" srcset=\"/dailyinfo/media/3e4d794207448b64.webp 720w, /dailyinfo/media/bd82a797aaa39c9a.webp 1200w, /dailyinfo/media/20e39c0928fb5d9e.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Webshell code\"><figcaption>图 3 – Web shell 代码</figcaption></figure><h3 id=\"sec-6\">擦除器</h3><p>Linux ELF 擦除器 <strong>destroy_v6</strong> 接受目标目录作为命令行参数。可选的 <strong>-f</strong> 标志启用快速删除，而 <strong>-w</strong> 指定以管道符分隔的排除目录列表。该擦除器会递归遍历目标目录，删除所有扩展名的文件，并跳过被排除的子树。默认情况下，它会尝试用零覆写文件后再将其删除，而快速模式会跳过覆写步骤。它还会向每个已处理的目录写入 <strong>DREAM_ANNEXATION.txt</strong>。这份带有政治主题的说明包含时间戳，并明确拒绝赎金谈判。</p><h3 id=\"sec-7\">TSGA – slot_CPconfigdaemon</h3><p>作为 slot_CPconfigdaemon 部署的 TSGA 植入程序是一款 Linux 网关植入程序，具备大量特定于 Check Point 的功能。它提供加密远程访问、配置窃取、备份和快照持久化、进程注入，以及二进制防火墙日志篡改。</p><h3 id=\"sec-8\">TSProxy</h3><p>TSProxy 是一款嵌入 TSGA 并投放为 /lib/libcpfwcommon.so 的 Linux 共享库后门，支持加密的 SOCKS 风格代理。</p><p><strong>工具关系</strong></p><p>TSGA 和 TSProxy 都是特定于 Check Point 的组件，与此前报告的与 PhiliKit 相关的工具集有关联。PhiliKit 是一款针对 Ivanti VPN 设备的被动后门和安装程序，此前在名为 philistine 的样本于 2026 年 2 月 25 日上传至 VirusTotal 后<a href=\"https://web-assets.esetstatic.com/wls/en/papers/threat-reports/eset-apt-activity-report-q4-2025-q1-2026.pdf\">被报告</a>。</p><p>TSGA 和 PhiliKit 植入程序都源自 Tiny SHell，并共享一组核心远程控制能力。两者均通过 TCP 端口 <strong>11072</strong> 和 Unix 套接字 /tmp/.p_sock 实施经过身份验证的加密通信。所分析的 PhiliKit 构建将其 TCP 监听器限制在环回地址，而 TSGA 则监听所有 IPv4 接口。两者均提供带伪终端分配的交互式 shell、可配置的终端尺寸以及双向输入/输出。操作员可以执行任意 shell 命令以及 Python 或 Perl 脚本、检索其输出、使用操作员选择的路径传输文件，并通过加密通道收集选定或完整的设备配置。</p><p>TSProxy 与嵌入 PhiliKit 软件包中的网络组件 libdssafe.so 共享独特的配置：相同的操作员凭据、传输密钥、三个匹配的激活选择器摘要，以及相同的 TLS 证书和私钥。这些重合之处有力地支持了二者具有共同工具谱系的判断。</p><h2 id=\"sec-9\">归因</h2><p>投放到网关的植入程序 TSGA 和 TSProxy 属于 PhiliKit 恶意软件家族，该家族此前曾与中国关联组织 UNC5221 以及针对 Ivanti 设备的先前利用活动相关联。此外，gogo 扫描器也曾被<a href=\"https://www.cisa.gov/news-events/cybersecurity-advisories/aa25-022a\">报告</a>与利用 Ivanti 漏洞的中国关联威胁行为者有关。</p><p>攻击者使用的基础设施 IP 地址托管于 LightNode VPS 基础设施上，此前该服务曾与中国关联威胁行为者的活动相关联。</p><p>扫描活动集中在 UTC 时间 00:00 至 09:00 之间，对应中国时间的 08:00–17:00，大体符合中国典型的工作时间。</p><figure><img width=\"1362\" height=\"402\" src=\"/dailyinfo/media/dc4ea4edca4c55f7.webp\" srcset=\"/dailyinfo/media/287a339b0578f265.webp 720w, /dailyinfo/media/93535ae7bf9a758d.webp 1200w, /dailyinfo/media/dc4ea4edca4c55f7.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"PHP2Shell-Exploitation\"></figure><p>综上所述，以下在所述攻击活动中出现的属性<strong>似乎并未完全符合</strong>已知中国关联组织（尤其是 UNC5221）的动机和利益：</p><ul>\n<li>破坏性操作</li>\n\n\n\n<li>关注以色列，以及用希伯来语撰写、提及以巴冲突的删除工具说明</li>\n\n\n\n<li>Philikit 名称源自该恶意软件的内部名称 philistine</li>\n</ul><p><strong>综合来看，现有证据不足以让我们高度确信地判断此次行动的真实性质。仍有多种情形可能成立：已识别的行为者独自实施了整个活动，仅充当了初始访问中介，或参与了一场虚假旗行动。破坏活动也可能是用来转移注意力的烟幕。</strong></p><h3 id=\"sec-10\">IOC</h3><figure><table><tbody><tr><td>sha256</td><td><strong>名称</strong></td></tr><tr><td>edb3e92eb7bda7413a09edcc4b1ba3cbed4bcdf42808a8abce63b6e4c3fda2b3</td><td>tpl webshell</td></tr><tr><td>4171b521fa6441382aa2fa014a08e18ff9a6e0ab6096c9144072bf46b37a2ec8</td><td>slot_CPconfigdaemon</td></tr><tr><td>d7549671c7189979f0624ec52dad9ea6a707d23146e3585ab8f8c4720eca0c63</td><td>CPconfigdaemon</td></tr><tr><td>3b51080a909023f7d484e2443740b572307ce0054eb9e32d98f0a06bfcd2db90</td><td>gogo</td></tr><tr><td>c7d9477309fac6c638a1128442056a242de086996add8cb49cd6496c36003237</td><td>destory_v6</td></tr><tr><td>0522937c0c0337be54fe25493539e5f5f8ceb9742c980aaff1cfc9515f3a96f7</td><td>DREAM_ANNEXATION.txt</td></tr><tr><td>ee16e1695711b9d60c62925fcfb2fe1a29c18ae26565bc05410a14e16d2a39d7</td><td>philistine</td></tr><tr><td>fb1a6235eb6bce8c9ec8cd8bb85f17c9c2bde8ecb45b7a243a30ceadf26654da</td><td>libdssafe.so</td></tr><tr><td>130.94.19[.]204</td><td></td></tr><tr><td>130.94.19[.]168</td><td></td></tr></tbody></table></figure><p>文章 <a href=\"https://research.checkpoint.com/2026/php2shell-exploitation-on-check-point-gateway/\">PHP2Shell Exploitation on Check Point Gateway</a> 最早发布于 <a href=\"https://research.checkpoint.com/\">Check Point Research</a>。</p>","original","zhKind","translation","complete","后门","漏洞利用","数据窃取","VMware","Ivanti","Palo Alto","https://research.checkpoint.com/2026/php2shell-exploitation-on-check-point-gateway/","Check Point Research",{"_140":141,"_142":-5},"changelogVersion","2026-10-01T08:00","release"]
