[{"_1":2,"_3":4},"root",{"_5":94},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795394440000,"id","s68hl88mb77wpvsqsv9cuf6as","title","Artifex Ghostscript -dSAFER 沙箱绕过漏洞 CVE-2026-125396 已复现","originalTitle","【已复现】Artifex Ghostscript -dSAFER 沙箱绕过漏洞(CVE-2026-125396)安全风险通告","summary","Artifex Ghostscript < 10.08.0 的 -dSAFER 沙箱绕过漏洞 CVE-2026-125396 已被奇安信 CERT 复现，CVSS 4.0 分数为 8.5。","reason","文章给出完整利用链、受影响版本和已公开 PoC，并覆盖发行版包、容器与应用升级等处置场景。","source",{"_72":93},"links",{"_81":92},"publishedAt","2026-11-22T04:43:00.000Z","discoveredAt","2026-11-22T10:02:17.641Z","timelineAt","category","disclosure","tags",[84,85,86,87,73,88,89,90,91],"score",85,"selected",true,"channel","news","story",{"_77":78,"_13":79},"x","readingMode","full","author","body",{"_61":80,"_81":-5,"_82":81,"_83":37},"outline",[],"relatedStories",[76],"topics",[68,69],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fcigjEufIvHg","reportCount",2,"additionalSourceCount",1,{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","research","name","技术研究","vuln","漏洞披露",{"_77":78,"_13":79},"publicId","4ad45bf6-7f5a-435f-9180-fb609f25b68d","Ghostscript沙箱逃逸漏洞已复现并修复","<p><span>奇安信 CERT</span> <span>2026-11-22 12:43</span> <span>江苏</span></p><p><img src=\"/dailyinfo/media/f3611afa4da7eb6a.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>致力于第一时间为企业级用户提供权威漏洞情报和有效解决方案。</p><p><span><span>●&nbsp;</span></span><span><span>点击↑蓝字关注我们，获取更多安全风险通告。</span></span></p><hr><table><tbody><tr><td colspan=\"4\" align=\"center\"><p><span><strong><span><span>漏洞概述</span></span></strong></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>漏洞名称</span></span></strong></span></p></td><td colspan=\"3\" align=\"left\"><p><span><span>Artifex Ghostscript -dSAFER 沙箱绕过漏洞</span></span></p></td></tr><tr><td align=\"left\"><p><span><span><strong><span>漏洞编号</span></strong></span></span></p></td><td colspan=\"3\" align=\"left\"><p><span><span>QVD-2026-106490</span><span>，</span><span>CVE-2026-125396</span></span></p></td></tr><tr><td align=\"left\"><p><strong><span><strong><span><span>公开时间</span></span></strong></span></strong></p></td><td align=\"left\"><p><span><span>2026-11-09</span></span></p></td><td align=\"left\"><p><strong><span><strong><span><span>影响量级</span></span></strong></span></strong></p></td><td align=\"left\"><p><span><span>十万级</span></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>奇安信评级</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>高危</span></span></strong></span></p></td><td align=\"left\"><p><strong><span><span>CVSS 4.0分数</span></span></strong></p></td><td align=\"left\"><p><span><span><strong><span>8.5</span></strong></span></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span>威胁类型</span></strong></span></p></td><td align=\"left\"><p><span><span><span>代码执行</span></span></span></p></td><td align=\"left\"><p><strong><span><span>利用可能性</span></span></strong></p></td><td align=\"left\"><p><strong><span><strong><span>高</span></strong></span></strong></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>POC状态</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span><span>已公开</span></span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>在野利用状态</span></span></strong></span></p></td><td align=\"left\"><p><span><span><span>未发现</span></span></span></p></td></tr><tr><td align=\"left\"><p><span><strong><span><span>EXP状态</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span><span>未公开</span></span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span>技术细节状态</span></span></strong></span></p></td><td align=\"left\"><p><span><strong><span><span><span>已公开</span></span></span></strong></span></p></td></tr><tr><td colspan=\"4\" align=\"left\"><p><strong><span><span>危害描述：</span></span></strong><span><span>攻击者利用 save/restore 机制造成释放后使用（Use-After-Free），获得写任意地址的原语，进而破坏 -dSAFER 状态并执行任意代码。成功利用该漏洞后可在 Ghostscript 进程权限下执行系统命令。</span></span></p></td></tr></tbody></table><p><strong><span>0</span></strong><strong><span>1</span></strong></p><p><strong><span>漏洞详情</span></strong></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>影响组件</span></span></strong></p><p><span>Ghostscript 是由 Artifex Software 开发的开源解释器，主要用于处理 PostScript、PDF、PCL 等页面描述语言，广泛应用于打印系统、文档转换、图像处理及预览生成场景。它可作为独立工具运行，也可被 ImageMagick、Pillow、CUPS、PHP Imagick 等组件调用，是许多 Linux 发行版和服务器应用的基础依赖组件。其 -dSAFER 模式旨在限制文件访问与命令执行，以隔离不可信文档。</span></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>漏洞描述</span></span></strong></p><p><span>近日，奇安信CERT监测到官方修复<span>Artifex Ghostscript -dSAFER 沙箱绕过漏洞(CVE-2026-125396)</span>，该漏洞源于 gs_fonts.ps 中的 .putgstringcopy 过程在调用特权操作符 .forceput 前未对操作数类型进行检查。攻击者可构造恶意 PostScript 或 PDF 文档，故意触发类型错误，并通过自定义错误处理程序恢复可用的 .forceput 引用。随后利用 save/restore 机制造成释放后使用（Use-After-Free），获得写任意地址的原语，进而破坏 -dSAFER 状态并执行任意代码。成功利用后，攻击者可在 Ghostscript 进程权限下执行系统命令。<span>目前该漏洞PoC和技术细节已公开。</span></span><span><span>在实际部署中，该漏洞可通过公开上传、邮件附件、打印服务等路径实现远程触发，影响面极广。建议客户尽快做好自查及防护。</span></span></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>利用条件</span></span></strong></p><p><span><span>1.文档处理流程启用或默认调用 Ghostscript（常见于打印、缩略图、预览、转换服务）。</span></span></p><p><span><span>2.攻击者能够将恶意 PostScript/PDF 文档提交到该处理流程（上传表单、邮件、打印队列等）。</span></span></p><p><span><span>3.处理时通常以 -dSAFER 模式运行。</span></span></p><p><strong><span>02</span></strong></p><p><strong><span>影响范围</span></strong></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>影响版本</span></span></strong></p><p><span>Artifex Ghostscript &lt; 10.08.0</span></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>其他受影响组件</span></span></strong></p><p><span><span>所有在 -dSAFER 沙箱模式下处理不受信任 PostScript/PDF 文档的 Ghostscript 部署环境均受影响，包括打印服务（CUPS）、邮件附件缩略图（Roundcube）、文件上传/预览（WordPress 插件、MediaWiki、DokuWiki 等）、文档转换管道（ImageMagick、Pillow 等）及云端文档渲染器。</span></span></p><p><strong><span>03</span></strong></p><p><strong><span>复现情况</span></strong></p><p><span><span>目前，</span><span>奇安信CERT已成功复现</span><span><span>Artifex Ghostscript -dSAFER 沙箱绕过漏洞(CVE-2026-125396)</span></span><span>，截图如下：</span></span></p><p><img src=\"/dailyinfo/media/5a76ef0842fbe53d.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>04</span></strong></p><p><strong><span>处置建议</span></strong></p><p><span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span><span><strong><span>&gt;</span></strong></span></span></p><p><strong><span><span>安全更新</span></span></strong></p><p><span>官方已发布安全补丁，请及时更新至最新版本：</span></p><p><span>Artifex Ghostscript &gt;= 10.08.0</span></p><p><span>下载地址：</span></p><p><span><a href=\"https://www.ghostscript.com/releases/index.html\">https://www.ghostscript.com/releases/index.html</a></span></p><p><span>对于使用发行版包的系统，安装对应安全更新：</span></p><p><span>Debian 13：10.05.1~dfsg-1+deb13u2 / +deb13u3 及以上</span></p><p><span>Ubuntu：参考 USN-8949-1 对应版本</span></p><p><span>openSUSE Tumbleweed、Arch、Alpine、Gentoo 等已提供 10.08.0 包</span></p><p><span>重启依赖 Ghostscript 的服务（CUPS、PHP-FPM、预览/转换工作进程、容器等）。</span></p><p><span>容器镜像与内嵌 Ghostscript 的应用需重新构建。</span></p><p><span>WordPress 用户升级至 7.0.4 或对应分支修复版本；Roundcube 应用相关加固更新。</span></p><p><span><span>临时缓解措施：</span></span></p><p><span>1.限制仅处理来自可信来源的文档，禁用或严格控制公共上传、预览、打印队列与邮件附件自动渲染功能；</span></p><p><span>2.以最低权限运行 Ghostscript 相关进程，并结合容器/沙箱隔离；</span></p><p><span>3.对图像处理库配置严格策略，避免不必要的 PostScript/PDF 委托；</span></p><p><span>4.监控渲染进程异常子进程创建、异常错误日志与命令执行行为；</span></p><p><span>5.在无法立即升级的环境中，暂时禁用相关预览/转换功能或增加文件类型与内容校验。</span></p><p><strong><span>05</span></strong></p><p><strong><span>参考资料</span></strong></p><p><span><span>[1]<a href=\"https://bugs.ghostscript.com/show_bug.cgi?id=709684\">https://bugs.ghostscript.com/show_bug.cgi?id=709684</a></span></span></p><p><span><span>[2]<a href=\"https://github.com/ArtifexSoftware/ghostpdl/commit/1484854e0c8ddfda1baa4ad4cd965b8a9790aa81\">https://github.com/ArtifexSoftware/ghostpdl/commit/1484854e0c8ddfda1baa4ad4cd965b8a9790aa81</a></span></span></p><p><span><span>[3]</span><span><a href=\"https://pwn.ai/upload2shell\">https://pwn.ai/upload2shell</a></span></span></p><p><strong><span>06</span></strong></p><p><strong><span>时间线</span></strong></p><p><span><span>2026年11月22日，奇安信 CERT发布安全风险通告。</span></span></p><p><strong><span>07</span></strong></p><p><strong><span>漏洞情报服务</span></strong></p><p><span><span>「</span><span>奇安信漏洞情报平台</span><span>」</span><span>重磅上线，诚邀您来体验：</span></span></p><p><img alt=\"图片\" src=\"/dailyinfo/media/6e2bd7f00ebea1fe.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img alt=\"图片\" src=\"/dailyinfo/media/de66e96fec01d70d.webp\" loading=\"lazy\" decoding=\"async\"></p><p><img alt=\"图片\" title=\"CERT LOGO.png\" width=\"100%\" src=\"/dailyinfo/media/06d0b9bff20ff7bd.webp\" loading=\"lazy\" decoding=\"async\"></p><p><span><strong><span>奇安信 CERT</span></strong></span></p><p><span><strong><span><span>致力于</span></span></strong><span><span>第一时间为企业级用户提供</span><strong><span><span>权威</span></span></strong><span>漏洞情报和</span></span><strong><span><span>有效</span></span></strong><span><span>解决方案。</span></span></span></p><p><span><span>本文已发布于NCC国家网络安全云社区<a href=\"https://nccsec.cn/security-community\">https://nccsec.cn/security-community</a></span></span></p><p><span><span><span>点击↓</span><strong><span><span>阅读原文</span></span></strong><span>，到</span></span><strong><span><span>ALPHA威胁分析平台</span></span></strong><span><span>订阅更多漏洞信息。</span></span></span></p><p><a href=\"https://ti.qianxin.com/portal/subscription\">阅读原文</a></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=186edf72&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzU5NDgxODU1MQ%3D%3D%26mid%3D2247508224%26idx%3D1%26sn%3D2ab11be61822d4389080836c4f6663af\">跳转微信打开</a></p>","original","zhKind","complete","复现","漏洞分析","漏洞利用","补丁","奇安信","Ubuntu","Debian","PHP","https://mp.weixin.qq.com/s?__biz=MzU5NDgxODU1MQ==&mid=2247508224&idx=1&sn=2ab11be61822d4389080836c4f6663af","奇安信 CERT",{"_95":96,"_97":-5},"changelogVersion","2026-10-01T08:00","release"]
