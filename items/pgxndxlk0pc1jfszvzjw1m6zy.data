[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":37,"_59":60},"expiresAt",1795826447000,"id","pgxndxlk0pc1jfszvzjw1m6zy","title","Cisco Expressway 漏洞 CVE-2026-76466 已被用于攻击，CVSS 9.8","originalTitle","Critical Cisco Expressway Flaw Exploited in Attacks","summary","Cisco Expressway 的硬编码凭据漏洞 CVE-2026-76466 已被用于真实攻击，CISA 于 11 月 20 日将其加入 KEV，联邦机构须在 11 月 23 日前完成修补。","reason","文章还原了 Cisco Expressway 漏洞从外围设备入侵到集群横向移动的攻击链，并给出补丁、网络隔离和监控建议，便于评估受影响组织的处置优先级。","source",{"_72":96},"links",{"_87":95},"publishedAt","2026-11-23T10:00:00.000Z","discoveredAt","2026-11-23T10:31:35.680Z","timelineAt","category","vuln","tags",[91,73,92,93,94],"score",85,"selected",true,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body",{"_60":86,"_87":-5,"_88":89,"_90":37},"outline",[81],"relatedStories",[77],"topics",[67,68,69],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","flyO_z8HqTEo","reportCount",2,"additionalSourceCount",1,{"_70":75,"_72":76},{"_70":31,"_72":74},{"_70":71,"_72":73},"slug","exploited","name","在野利用","漏洞披露","cisco","Cisco / 思科",{"_78":79,"_13":80},"publicId","6b87b502-2424-40f1-a2c4-de3e007d78b8","CISA确认Cisco Expressway漏洞遭在野利用",{"_11":82,"_83":84,"_85":64},"sec-1","text","首次发现 Cisco Expressway 利用活动","level","<p><img src=\"/dailyinfo/media/3499b1f4497555cb.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Photo of Phil Muncaster\"></p><p>\n\t美国联邦机构须在11月23日星期一之前修补 Cisco Expressway 中的一个严重漏洞，美国网络安全和基础设施安全局（CISA）表示。</p><p>\n\t在有报告显示该漏洞正被用于主动攻击后，CISA 于11月20日将 CVE-2026-76466 加入其已知被利用漏洞（KEV）目录。</p><p>\n\t“Cisco Expressway Series 包含一个硬编码凭据使用漏洞，允许拥有持久 Cookie 和网络访问权限的未经验证的远程攻击者，通过数据库服务在集群设备上以 root 身份执行命令，”CISA 解释道。</p><p>\n\tCisco Expressway 产品被称为“高级协作网关”，通常成对运行：Expressway-C 位于企业网络内部并连接内部协作系统，而 Expressway-E 位于 DMZ 中以处理外部流量。</p><p>\n\t<a href=\"https://www.infosecurity-magazine.com/news/cisco-releases-ten-security-patches/\"><em>进一步了解 Cisco Expressway：Cisco 为 Expressway Series 和 TelePresence VCS 产品发布 10 个安全补丁</em></a></p><p>\n\t该漏洞的 CVSS 评分为 9.8，表明对机密性、完整性和可用性有严重影响，且攻击复杂度低、无需用户交互。</p><p>\n\tCisco 在10月21日的公告中解释道：“此漏洞源于使用了持久 Cookie。此外，当群集的 TLS Verify Mode 设置为 Enabled 时，客户端证书的验证不足，这意味着客户端证书未经验证。”</p><p>\n\t“攻击者如果持有这些 Cookie，就可以通过连接数据库服务并调用特定的远程过程调用（RPC）命令来利用此漏洞。成功利用后，攻击者便可在受影响设备的底层操作系统上以 root 身份执行任意命令。”</p><h2 id=\"sec-1\">\n\t首次发现 Cisco Expressway 利用活动</h2><p>\n\t总部位于莫斯科的网络安全公司 F6 声称已调查首个已观察到的 CVE-2026-76466 利用案例。</p><p>\n\tF6 网络防御中心的专家解释道：“攻击者最初攻陷了两台面向互联网的 Cisco Expressway 设备。他们通过其中一台获得了对位于该组织内部网络中的另外两个集群节点的访问权限。”</p><p>\n\t“获得 root 访问权限后，攻击者开始准备工具，以便在整个基础设施中进一步横向移动。他们使用定制的 Python 脚本扫描网络、发现可访问的 SMB 资源、与 SQL Server 和 WinRM 交互，并探查 GitLab 仓库，以窃取凭据和其他敏感信息。”</p><p>\n\t该安全厂商敦促 Cisco Expressway 客户不仅修补该漏洞，还部署网络分段和监控措施，以降低遭到入侵的风险。</p><p>\n\t它<a href=\"https://f6.security/media-center/press-releases/cisco-vulnerability-exploitation/\">建议</a>各组织采取以下措施：</p><ul>\n\t<li>\n\t将 Cisco Expressway 更新至包含 CVE-2026-76466 修复程序的当前版本；如果无法更新，则在防火墙层限制对 TCP/4371–4372 端口的连接，并且仅允许来自可信集群节点 IP 地址的访问</li>\n\t<li>\n\t实施外部攻击面监控，以便在易受攻击的数字资产遭到利用前将其识别出来</li>\n\t<li>\n\t确保持续监控和事件响应，以快速发现入侵，迅速“定位并调查”入侵情况、隔离已失陷系统、确定影响范围并阻止横向移动</li>\n</ul>","original","zhKind","translation","complete","漏洞","补丁","Cisco","CISA","https://www.infosecurity-magazine.com/news/critical-cisco-expressway-flaw/","Infosecurity Magazine",{"_98":99,"_100":-5},"changelogVersion","2026-10-01T08:00","release"]
