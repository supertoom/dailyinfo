[{"_1":2,"_3":4},"root",{"_5":106},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":37,"_59":60},"expiresAt",1794530487000,"id","lp7mel34dhyawe4cpwe2sa291","title","攻击者利用 BTCPay Server 漏洞盗走约 $1.63m 加密货币","originalTitle","Hackers Exploit BTCPay Server Flaw to Steal Cryptocurrency","summary","攻击者利用 BTCPay Server 漏洞入侵运行 2.4.1 或更早版本的热钱包服务，Bitquery 将 18.38 Bitcoin 和 3405 Litecoin 追踪至 2 个地址，涉及 10 月 30 日至 11 月 2 日上午的 682 次归集，其中 87% 的资金于 11 月 1 日集中转出。","reason","材料梳理了漏洞利用方式、资金流向和处置要求，可帮助运维人员识别受影响实例并避免仅靠升级留下访问权限。","source",{"_74":105},"links",{"_98":104},"publishedAt","2026-11-03T14:30:00.000Z","discoveredAt","2026-11-03T15:10:21.084Z","timelineAt","category","activity","tags",[75,77,102,103],"score",74,"selected",true,"channel","news","story",{"_85":86,"_13":87},"x","readingMode","full","author","body",{"_60":97,"_98":-5,"_99":100,"_101":37},"outline",[88,89],"relatedStories",[84],"topics",[67,68,69,70,71],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","zh","factId","fm2xxlQy2fcc","reportCount",1,"additionalSourceCount",0,{"_72":82,"_74":83},{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","attack","name","攻击活动","exploited","在野利用","black-market","数据窃取与黑产","ransomware","勒索软件","crypto","密码学",{"_85":86,"_13":87},"publicId","eec08cb6-c5ff-46a1-baae-61575dcf1bdc","BTCPay旧版实例热钱包被盗",{"_11":95,"_91":96,"_93":94},{"_11":90,"_91":92,"_93":94},"sec-2","text","BTCPay Server 敦促热钱包用户重新构建","level",2,"sec-1","BTCPay 发出警告后归集转移仍在继续","<p>\n\t黑客已从运行过时 BTCPay Server 实例的热钱包中窃取加密货币，区块链分析追踪到约 $1.63m 的 Bitcoin 和 Litecoin 被转入与这些盗窃案有关的地址。</p><p>\n\tBTCPay Server 在 11 月 2 日发布的<a href=\"https://blog.btcpayserver.org/btcpay-server-security-incident-2-4-1-and-earlier/\">事件更新</a>中表示，这些盗窃案影响了运行该开源支付平台 2.4.1 或更早版本的服务器，攻击者采用了另一种方法利用一个漏洞；该漏洞已在 8 月 7 日发布的 2.4.2 版本中得到修复。</p><p>\n\t发布警告时，它尚未发现已经运行 2.4.2 或更高版本的服务器受到影响。</p><p>\n\t区块链情报公司 Bitquery 的<a href=\"https://bitquery.io/investigations/btcpay-server-hack\">分析</a>追踪到 18.38 Bitcoin 和 3405 Litecoin 被转入 BTCPay Server 指出的两个地址，这些资金在 10 月 30 日至 11 月 2 日上午期间分 682 次归集转移。该公司表示，这名窃贼以管理员身份登录服务器，并清空了其热钱包。</p><p>\n\t早在 8 月，该漏洞就已被利用，通过 LND（一种 Lightning Network 实现）窃取资金，但 BTCPay Server 当时表示，链上钱包（包括热钱包）未受影响。</p><p>\n\t<em><a href=\"https://www.infosecurity-magazine.com/news/bitget-restarts-withdrawals-387-5m/\">进一步了解热钱包入侵事件：Bitget 在 $387.5m 钱包被攻破后恢复 Bitcoin 提款</a></em></p><h2 id=\"sec-1\">\n\tBTCPay 发出警告后归集转移仍在继续</h2><p>\n\tBitquery 表示，在追踪到的资金中，87% 于 11 月 1 日下午和晚上以一波行动完成转移。它统计到，在 BTCPay Server 当晚 22:25 UTC 告知运营者关闭实例之后，又发生了 267 次归集转移，涉及约 $150,000。</p><p>\n\t该公司无法确定有多少服务器受到影响，因为区块链记录的是钱包而非系统。它也遗漏了其他地址和币种，包括 Lightning 资金，因此其数字只是下限。</p><p>\n\tBTCPay Server 补充称，这两个地址上的部分活动似乎早于所报告的盗窃案，因此不应将其余额视为已确认损失。该项目尚未公布损失总额。</p><h2 id=\"sec-2\">\n\tBTCPay Server 敦促热钱包用户重新构建</h2><p>\n\tBTCPay Server 敦促 2.4.1 或更早版本的运营者迁移至配备新钱包和新种子短语的新服务器，即使他们此后已经更新过，并警告称：“仅更新无法消除攻击者可能已经获得的访问权限。”</p><p>\n\t它表示，支出密钥保存在服务器之外的钱包（包括硬件钱包）未受影响，并建议服务器上只保留运营所需资金。</p><p>\n\t该项目表示，运营者还应保留日志和交易记录、更换已暴露的凭据，并避免将旧服务器恢复到新服务器中。</p><p>\n\t该修复自 8 月 7 日起就已提供。被清空的钱包位于从未安装该修复的服务器上。</p>","original","zhKind","translation","complete","数据窃取","加密","https://www.infosecurity-magazine.com/news/btcpay-server-flaw-cryptocurrency/","Infosecurity Magazine",{"_107":108,"_109":-5},"changelogVersion","2026-10-01T08:00","release"]
