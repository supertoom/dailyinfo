[{"_1":2,"_3":4},"root",{"_5":103},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795221640000,"id","sk7veseq005bbedhfnw2rqegr","title","TSMC 员工数据泄露，6.9GB 数据疑与云服务商遭入侵有关","originalTitle","TSMC employee data breach linked to cloud provider","summary","TSMC 确认现任及部分前任员工数据被未经授权发布到外部网站，调查发现泄露信息与其使用的云服务商系统存储数据相符，目前没有证据显示 TSMC 自身系统被攻破。","reason","TSMC 已核实泄露数据来自云服务商，文章还给出数据规模、拍卖报价和泄露时间线，便于评估员工数据处置需求。","source",{"_73":102},"links",{"_94":101},"publishedAt","2026-11-15T15:23:48.000Z","discoveredAt","2026-11-15T15:50:42.665Z","timelineAt","category","activity","tags",[74,98,99,100],"score",71,"selected",true,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","Bill Toulas","body",{"_61":93,"_94":-5,"_95":96,"_97":37},"outline",[83,84],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fKx6hanK4ipc","reportCount",1,"additionalSourceCount",0,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","attack","name","攻击活动","black-market","数据窃取与黑产","supply-chain","供应链安全",{"_80":81,"_13":82},"publicId","f98f57b0-3c56-4cc6-a960-83826471641a","台积电确认现任及前任员工数据泄露",{"_11":90,"_86":91,"_88":92},{"_11":85,"_86":87,"_88":89},"sec-2","text","发现现有防御可能遗漏的邮件威胁。","level",2,"sec-1","威胁行为者拍卖数据",3,"<p><img alt=\"TSMC employee data breach linked to cloud provider\" height=\"900\" src=\"/dailyinfo/media/f6a5c73983243d60.jpg\" srcset=\"/dailyinfo/media/c744594224e4a591.jpg 720w, /dailyinfo/media/949fa81c31fc555f.jpg 1200w, /dailyinfo/media/f6a5c73983243d60.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>Taiwan Semiconductor Manufacturing Company (TSMC) 证实，在一名威胁行为者将据称从该公司窃取的 6.9GB 信息公开拍卖后，员工的个人数据已被泄露到网上。</p><p>这家科技巨头表示，该事件影响了现任和前任员工，但不会影响其运营或客户。</p><p>该公司核实了泄露信息，并确认其与“存储在云服务提供商系统服务中的数据”相匹配，表明这是一次外部入侵事件。</p><p><a href=\"https://www.wiz.io/lp/securing-ai-agents-101?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY26Q3_INB_FORM_Securing-AI-Agents-101&amp;sfcid=701Py00000RTEWMIA5&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AI-Agents-101\"><img src=\"/dailyinfo/media/1a77c37648ba7a60.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>TSMC 是全球最大的代工芯片制造商，为 Apple 和 Nvidia 等公司制造先进处理器及其他半导体产品。</p><p>去年，该公司的 12 英寸等效晶圆出货量约为 1500 万片，年度营收达到 1224 亿美元。</p><p>TSMC 的调查发现，泄露信息与其使用的云服务提供商所存储的数据相匹配，指向其自身基础设施之外的安全事件。</p><p>该公司目前正在通知受影响的员工并提供必要支持，同时聘请第三方网络安全公司协助处理事态。</p><p>TSMC 在向美国证券交易委员会 (SEC) 提交的备案文件中表示：“TSMC 已发现，我们部分现任和前任员工的数据未经授权被提供至外部网站。”</p><p>“目前，我们没有发现任何证据表明台积电（TSMC）的系统已被攻破，”该<a href=\"http://www.sec.gov/Archives/edgar/data/1046179/000104617926000800/a20261112statementregardin.htm\">公司补充道</a>。</p><h3 id=\"sec-1\">威胁行为者拍卖数据</h3><p>11 月 8 日，一名使用‘SmithBianl’这一别名的人在黑客论坛上泄露了一个文本文件，其中包含据称从 TSMC 窃取的 499 行信息。该行为者声称，该文件是一个包含 46,000 条员工记录的 6.9GB 数据集的样本。</p><p>据该帖子称，泄露信息包括 TSMC 员工的国民身份号码、地址、联系方式和银行信息。</p><p>SmithBianl 将这些数据公开拍卖，起拍价为 3 BTC（约 65,000 美元）。</p><p>在没有买家的情况下，他们警告称这些数据将在一周后免费泄露，并将首个截止日期定为 11 月 15 日。</p><p>BleepingComputer 已联系 TSMC，询问其是否曾与该威胁行为者接触，以及是否计划向黑客付款，以阻止其员工数据被完整公开泄露。</p><p>一名发言人拒绝在此阶段置评。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/0e510643164e7d91.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-2\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现现有防御可能遗漏的邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体会分析邮件意图、上下文和行为，发现网络钓鱼、商业电子邮件入侵和发票欺诈。</p><p>通过为期 14 天的 Microsoft 365 或 Google Workspace 只读扫描，查看有哪些威胁正在穿透防线，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始免费的邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","数据泄露","黑产","供应链","https://www.bleepingcomputer.com/news/security/tsmc-employee-data-breach-linked-to-cloud-provider/","BleepingComputer",{"_104":105,"_106":-5},"changelogVersion","2026-10-01T08:00","release"]
