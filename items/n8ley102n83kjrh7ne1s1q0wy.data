[{"_1":2,"_3":4},"root",{"_5":111},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1793672467000,"id","n8ley102n83kjrh7ne1s1q0wy","title","Volt Typhoon 利用 Silent Train 框架隐藏零日漏洞攻击","originalTitle","Volt Typhoon hides zero-day attacks using 'Silent Train' framework","summary","Volt Typhoon 使用 Silent Train 中继框架，通过境外 VPS、被入侵的路由器及其他设备隐藏攻击来源，并利用至少 4 个零日漏洞攻击电信、政府、国防承包商、公用事业、卫星服务、航空等高价值目标。","reason","source",{"_76":110},"links",{"_99":109},"publishedAt","2026-10-28T16:00:00.000Z","discoveredAt","2026-10-29T00:15:59.094Z","timelineAt","category","activity","tags",[79,81,77,105,106,107,108],"score",86,"selected",true,"channel","news","story",{"_87":88,"_13":89},"x","sameEvent",{"_11":103,"_13":104},"readingMode","full","author","Bill Toulas","body",{"_62":98,"_99":-5,"_100":101,"_102":36},"outline",[90,91],"relatedStories",[86],"topics",[69,70,71,72,73],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","f_e39JScJTC8","reportCount",3,"additionalSourceCount",2,{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","malware","name","恶意软件","attack","攻击活动","exploited","在野利用","identity","身份与访问","cisco","Cisco / 思科",{"_87":88,"_13":89},"publicId","f2ef9b28-fcac-42e0-be64-88cc1ac8ee1f","Cisco SD-WAN零日漏洞已被利用",{"_11":96,"_93":97,"_95":66},{"_11":92,"_93":94,"_95":68},"sec-2","text","一旦攻击者拥有有效凭据，他们的行动中只有 37% 会被阻止","level","sec-1","Silent Train 中继网络","<p><img alt=\"Volt Typhoon hides zero-day attacks using 'Silent Train' framework\" height=\"900\" src=\"/dailyinfo/media/65f7ab5ce2918b5d.jpg\" srcset=\"/dailyinfo/media/6ed6051a9a920dc5.jpg 720w, /dailyinfo/media/92974ab7208f97ea.jpg 1200w, /dailyinfo/media/65f7ab5ce2918b5d.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>中国国家支持的黑客组织 Volt Typhoon 一直在使用一种框架，该框架依赖按需攻陷的互联设备所构成的轮换链，其中包括用于针对高价值系统的零日攻击。</p><p>该框架被称为 Silent Train，因为威胁行为者将其用于特定目标，在每次行动后进行清理，并持续更新。</p><p>通信公司 Lumen 的威胁研究部门 Black Lotus Labs 的研究人员已经跟踪 Silent Train 三年，并确认 Volt Typhoon 在针对边缘和管理基础设施的攻击中利用了至少四个零日漏洞。</p><p>目标包括电信公司、政府机构、国防承包商、教育机构、公用事业/关键基础设施、卫星服务提供商、IT 公司、MSP、交通运输、航空和应急服务。</p><p>Black Lotus Labs 的观察显示，受攻击最严重的地区是 California、Texas 和 Hawaii，这表明其重点关注 Indo-Pacific 事务。</p><figure><img alt=\"Victims map\" height=\"436\" src=\"/dailyinfo/media/c99ddf973a943b7e.jpg\" srcset=\"/dailyinfo/media/aa8d645f36e75076.jpg 720w, /dailyinfo/media/9808280413ff8281.jpg 1200w, /dailyinfo/media/c99ddf973a943b7e.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"900\">\n<figcaption><strong>受害者地图</strong><br>\n<em>来源：Black Lotus Labs</em></figcaption>\n</figure><p>Volt Typhoon 此前曾针对美国关键基础设施，包括通信、能源、交通运输和供水系统，并引发 <a href=\"https://www.bleepingcomputer.com/news/security/cisa-shares-advice-on-isolating-vital-systems-during-cyberattacks/\">CISA 警告</a>，称其试图建立访问权限，以便在未来发生危机或冲突时进行潜在破坏。</p><p>研究人员表示，Silent Train 的部署部分受到 <a href=\"https://www.bleepingcomputer.com/news/security/fbi-disrupts-chinese-botnet-by-wiping-malware-from-infected-routers/\">FBI 对 KV-Botnet 的捣毁</a>的推动。KV-Botnet 是一个僵尸网络，Volt Typhoon 曾利用它在攻击美国关键基础设施时规避检测。</p><figure><img alt=\"Activity comparison\" height=\"501\" src=\"/dailyinfo/media/485f7ca3c428d2e6.jpg\" srcset=\"/dailyinfo/media/82c6d720dde519f0.jpg 720w, /dailyinfo/media/24057c289f745a68.jpg 1200w, /dailyinfo/media/485f7ca3c428d2e6.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"850\">\n<figcaption><strong>随时间变化的 activity 对比</strong><br>\n<em>来源：Black Lotus Labs</em></figcaption>\n</figure><h3 id=\"sec-1\">Silent Train 中继网络</h3><p>Silent Train 实际上是一种由受陷设备构成的中继基础设施，Volt Typhoon 利用它来隐藏攻击的来源。</p><p>攻击运营者将活动路由至美国境外的 VPS 基础设施，然后通过路由器等被黑设备传递流量，由这些设备充当中继，随后发起攻击。</p><p><a href=\"https://www.lumen.com/blog/en-us/silent-train-volt-typhoon-operational-framework\">Black Lotus Labs 表示</a>，Intelbras 调制解调器被用作海外中继，而 Netgear Orbi 设备则充当美国境内的跳板。</p><figure><img src=\"/dailyinfo/media/5d0e673050780200.jpg\" srcset=\"/dailyinfo/media/e6109056e876567e.jpg 720w, /dailyinfo/media/0fdff33f62ac6afa.jpg 1200w, /dailyinfo/media/5d0e673050780200.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Silent Train attack overview\" height=\"292\" width=\"900\">\n<figcaption><strong>Silent Train 攻击概览</strong><br>\n<em>来源：Black Lotus Labs</em></figcaption>\n</figure><p>该威胁行为者对 Silent Train 的使用包括利用漏洞、窃取凭据、窃取数据，以及维持对受陷系统的持久远程访问。</p><p>通过监测 Silent Train 的活动，研究人员得以观察到针对以下产品的零日利用：</p><ul>\n\t<li><a href=\"https://www.bleepingcomputer.com/news/security/arista-patches-velocloud-orchestrator-zero-day-exploited-in-attacks/\">CVE-2026-16812 </a>– VeloCloudOrchestrator</li>\n\t<li><a href=\"https://www.bleepingcomputer.com/news/security/critical-cisco-sd-wan-bug-exploited-in-zero-day-attacks-since-2023/\">CVE-2026-20127</a> – Cisco Catalyst SD-WAN</li>\n\t<li><a href=\"https://www.bleepingcomputer.com/news/security/n-able-patches-max-severity-n-central-flaw-amid-ongoing-attacks/\">CVE-2025-8875 and CVE-2025-8876</a> – N-able N-central</li>\n\t<li><a href=\"https://www.bleepingcomputer.com/news/security/chinese-volt-typhoon-hackers-exploited-versa-zero-day-to-breach-isps-msps/\">CVE-2024-39717</a> – Versa Director</li>\n\t<li>Quest KACE（疑似零日漏洞）</li>\n</ul><p>攻陷这些平台可使威胁行为者获得广泛的管理控制权，从而实现凭据窃取、远程访问，并触达下游客户，同时无需进行可能触发检测的“嘈杂”横向移动。</p><figure><img src=\"/dailyinfo/media/a994f2d21f601042.jpg\" srcset=\"/dailyinfo/media/3b1a581af70cf621.jpg 720w, /dailyinfo/media/88c01a23feccfe10.jpg 1200w, /dailyinfo/media/a994f2d21f601042.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"Exploitation timeline\" height=\"436\" width=\"800\">\n<figcaption><strong>利用时间线</strong><br>\n<em>来源：Black Lotus Labs</em></figcaption>\n</figure><p>Black Lotus Labs 在今天发布的报告中解释道：“为了构建这些会话，其运营者会利用 SOHO、IoT 和其他中继设备上暴露的 Web 接口，然后仅部署通过受陷节点实现链式 SSH 访问所需的工具。”</p><p>“其中包括临时 SSH 服务、密钥、配置文件以及‘就地取材’实用工具。”</p><p>会话结束后，通常不到 8 小时，威胁行为者就会从一次性中继中移除其所有工具、密钥和配置文件。</p><p>到 2025 年初，研究人员注意到该框架已变成混合模式，在使用一次性中继的同时，也利用被入侵且保留一到三个月的企业系统。</p><p>Black Lotus Labs 认为，Silent Train 是为高价值目标以及按中国标准时间（CST）时区谨慎开展的动手操作而预留的。针对这些目标使用零日漏洞，进一步加强了这一推测。</p><p>研究人员建议加强集中式管理系统周围的安全防护，限制互联网对管理界面的访问，快速修补漏洞，并将日志集中保存且延长保留期。</p><p>他们还建议监控异常的管理活动，审查可能暴露客户或合作伙伴网络的可信连接，并遵循 CISA 和 NCSC 关于 Volt Typhoon 的指南。</p><p><a href=\"https://hubs.li/Q04sB3fb0\">\n            <img src=\"/dailyinfo/media/ba68ad0723b4d270.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-2\">\n            <a href=\"https://hubs.li/Q04sB3fb0\">一旦攻击者拥有有效凭据，他们的行动中只有 37% 会被阻止</a>\n        </h2><p>整体防御评分可能掩盖初始访问之后发生的情况。一旦攻击者使用有效凭据，防御效果就会大幅下降。</p><p>Blue Report 2026 逐项衡量防御措施，涵盖在客户生产环境中运行的 338 million 次模拟。</p><p><a href=\"https://hubs.li/Q04sB3fb0\">获取报告</a>\n    </p>","original","zhKind","translation","complete","g4nkryozafu8sei1rzntlk0o5","Volt Typhoon 利用 Silent Train 中继链攻击关键系统，已确认利用4个漏洞","漏洞利用","后门","凭据","Cisco","https://www.bleepingcomputer.com/news/security/volt-typhoon-hides-zero-day-attacks-using-silent-train-framework/","BleepingComputer",{"_112":113,"_114":-5},"changelogVersion","2026-10-01T08:00","release"]
