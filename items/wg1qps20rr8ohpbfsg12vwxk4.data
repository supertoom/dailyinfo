[{"_1":2,"_3":4},"root",{"_5":89},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795048839000,"id","wg1qps20rr8ohpbfsg12vwxk4","title","Apache Roller CVE-2026-129448 RCE 漏洞已被在野利用，无需认证","originalTitle","Critical Apache Roller RCE Flaw Under Active Exploitation, No Authentication Required","summary","Apache Roller 的未认证不安全反序列化漏洞 CVE-2026-129448 已被用于在野攻击，影响 4.0.0 至 6.1.4，CVSS 为 9.8。","reason","source",{"_72":88},"links",{"_61":87},"publishedAt","2026-11-18T17:10:45.000Z","discoveredAt","2026-11-18T19:49:33.693Z","timelineAt","category","vuln","tags",[83,73,84,85,86],"score",65,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_79":-5,"_61":80,"_81":-5,"_82":36},"outline",[],"relatedStories",[75],"topics",[68,69],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","fwj3V3ZMlgn0","reportCount",2,"additionalSourceCount",1,{"_70":30,"_72":74},{"_70":71,"_72":73},"slug","exploited","name","在野利用","漏洞披露",{"_76":77,"_13":78},"publicId","02b2ffb9-c7c0-4b25-b15d-bdc166d49214","Apache Roller RCE漏洞已遭在野利用","zh","<p><span><i></i><span>Ravie Lakshmanan</span><i></i><span>Nov 18, 2026</span></span><span>Vulnerability / Cyber Attack</span></p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgbiCYJD7nei_TBSnUlQG59idq9moCbsg97fnzsiXNi4KvQaphZYA4hHIzXv08t2OsvVZokzPIdhZPzxTkXoEgzTsFby-rBvQX6CY6yPo1Iv8DPnSmPeOeh3OQXF79Q60Hq3UI7kVdhmEKGL2bUwm42JO-8C_ClLHpTpGkWpnflAQMrDDgjIvMKq09DEskr/s1600/apache.jpg\"><img alt=\"\" src=\"/dailyinfo/media/91344f9be44161ee.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>A critical security flaw in <b>Apache Roller</b>, an open-source, Java-based blogging platform, has come under active exploitation in the wild, according to the Apache Software Foundation (ASF)</p><p>The vulnerability, tracked as <strong><a href=\"https://www.cve.org/CVERecord?id=CVE-2026-129448\">CVE-2026-129448</a></strong> (CVSS score: 9.8), is a case of unauthenticated deserialization in the XML-RPC endpoint that could lead to remote code execution.</p><p>\"Deserialization of Untrusted Data in Apache Roller versions 4.0.0 through 6.1.4 allows an unauthenticated remote attacker to execute arbitrary code,\" project maintainers <a href=\"https://lists.apache.org/thread/lnz4s26tv6hdo03wngtdbpfj4hg4gtds\">said</a>. \"The XML-RPC endpoint accepts vendor extension types and deserializes them before authenticating the requester.\"</p><p>ASF also noted that the vulnerability is the same as <a href=\"https://www.cve.org/CVERecord?id=CVE-2026-82384\">CVE-2026-82384</a> (CVSS score: 9.8), which was patched in September 2026 and listed only Apache Roller 6.1.5 as affected.</p><p>\"This issue is being actively exploited,\" it added. ASF did not share any details on how the vulnerability is being exploited, or who is being targeted as part of these efforts.</p><p>A security researcher named n0mi1k has been credited with finding the flaw, and Matt Raible has been acknowledged for reporting it.</p><p>Users are advised to upgrade to Apache Roller 6.1.6 or later, which disables the extension types and rejects XML-RPC requests when the XML-RPC feature is disabled.</p><p>If immediate patching is not an option, it's recommended to set \"enabledForExtensions\" to \"false\" in WEB-INF/web.xml, or remove the \"/roller-services/xmlrpc\" servlet mapping, and then restart Roller.</p><p>\"Disabling XML-RPC in the administration UI is not enough, because older versions deserialize the request before checking that setting,\" ASF noted.</p><p>Found this article interesting?  Follow us on <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>, <a href=\"https://twitter.com/thehackersnews\">Twitter</a> and <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a> to read more exclusive content we post.</p>","zhKind","complete","漏洞","补丁","复现","漏洞利用","https://thehackernews.com/2026/11/critical-apache-roller-rce-flaw-under.html","The Hacker News",{"_90":91,"_92":-5},"changelogVersion","2026-10-01T08:00","release"]
