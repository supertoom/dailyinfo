[{"_1":2,"_3":4},"root",{"_5":95},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":-5,"_56":37,"_57":58},"expiresAt",1794195830000,"id","lq7l07nzedahpb28xijsh5crr","title","Censys 发现 ARTEX offensive AI 工具活动远超已报告战役","originalTitle","ARTEX Offensive AI Tool Activity Far Exceeds Reported Campaigns, Censys Finds","summary","Censys 估算开源 AI 攻击框架 ARTEX 的实际使用范围远超此前报告，全球有 1465 台主机向公网暴露 ARTEX 控制台，其中约 650 台属于同配置托管，剩余约 815 个独立部署，另有 155 台主机同时运行其他威胁工件。","reason","文章通过全球暴露主机、共享基础设施与已知战役关联，展示了 ARTEX 被滥用的实际范围及 AI 攻击框架的发展趋势。","source",{"_66":94},"links",{"_86":93},"publishedAt","2026-11-06T13:00:00.000Z","discoveredAt","2026-11-06T19:24:29.996Z","timelineAt","category","activity","tags",[71,69,75,67,73,90,91,92],"score",70,"selected",true,"channel","news","story","x","readingMode","full","author","body",{"_58":85,"_86":-5,"_87":88,"_89":37},"outline",[76,77],"relatedStories",[],"topics",[59,60,61,62,63],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_64":74,"_66":75},{"_64":72,"_66":73},{"_64":70,"_66":71},{"_64":68,"_66":69},{"_64":65,"_66":67},"slug","ai-security","name","AI 安全","malware","恶意软件","attack","攻击活动","exploited","在野利用","ai-offense","AI 攻防",{"_11":83,"_79":84,"_81":82},{"_11":78,"_79":80,"_81":82},"sec-2","text","Censys 揭示 ARTEX 的全球足迹","level",2,"sec-1","网络威胁行为者对 ARTEX 的使用日益增加","<p>\n\t网络威胁行为者使用一款新型 AI 驱动的进攻性安全工具，其扩散范围似乎已远远超出最早发现的相关攻击活动。</p><p>\n\t这款名为 ARTEX 的工具是一个开源、由 AI 模型驱动的自主渗透测试框架，于 2026 年 7 月由一名网名为‘<a href=\"https://github.com/AUTUMN-27\">Autumn-27</a>’的用户发布在 GitHub 上。</p><p>\n\t尽管自 10 月以来 ARTEX 已被整合进多起已知的恶意攻击活动，但互联网流量扫描服务商 Censys 发布的最新报告估计，其使用范围可能比此前认为的广泛得多。</p><h2 id=\"sec-1\">\n\t<strong>网络威胁行为者对 ARTEX 的使用日益增加</strong></h2><p>\n\tARTEX 使用 Go 编写，并内嵌 Next.js Web 控制台，可提供进攻性命令与控制（C2）平台，与多个 AI 智能体通信，并可接入大型语言模型（LLM）。</p><p>\n\t10 月，两家威胁情报公司称其在威胁行为者的行动中发现了该工具的使用。</p><p>\n\t首先，在 10 月初，CrowdStrike 将 ARTEX 与<a href=\"https://www.infosecurity-magazine.com/news/chinese-hacker-ai-korean-banks/\">针对韩国金融机构的攻击活动</a>联系起来。分析人员发现，在此次攻击活动中，ARTEX 与 Anthropic 的 <a href=\"https://www.infosecurity-magazine.com/news/anthropic-claude-security-for-ai/\">Claude AI 模型</a>一同使用；该活动从 2026 年 9 月下旬持续至 10 月初。CrowdStrike 以中等置信度评估称，攻击者是中文使用者，动机为牟利。</p><p>\n\t10 月稍晚，Microsoft <a href=\"https://www.infosecurity-magazine.com/news/microsoft-chinese-ai-connectwise/\">将 ARTEX 与大规模入侵 ConnectWise 客户租户事件</a>联系起来，该事件导致这家 IT 管理软件提供商将多项云服务下线。Microsoft 将此次攻击活动归因于 Storm-0940，即一个与中国国家有关联的网络威胁行为者，也称为 CovertNetwork-1658 或 ORB07。</p><p>\n\t最近，在 11 月 4 日，印度计算机应急响应小组（CERT-In）警告金融和加密货币组织，称<a href=\"https://www.infosecurity-magazine.com/news/india-warns-ai-cyberattacks/\">一个被追踪为‘Crafty Falcon’的威胁组织正利用包括 ARTEX 在内的多种 AI 驱动工具，接连对其发动攻击</a>。</p><p>\n\tARTEX 最初的 GitHub 仓库因其创建者遭到威胁行为者广泛滥用，已于 2026 年 10 月被<a href=\"https://cloud.google.com/blog/topics/threat-intelligence/artex-and-friends-enter-agentic-offensive-frameworks?hl=en\">其创建者下架</a>。作者声称自己未参与与 ARTEX 有关的攻击，并表示该工具仅用于获得授权的渗透测试。</p><p>\n\t尽管如此，该框架仍通过社区分支在全球范围内不断扩散，其中包括 ScopeWeaver 等本地化变体，以及名为 ARTEX PRO 的商业版本。</p><p>\n\t在<a href=\"https://blog.checkpoint.com/research/inside-artex-how-autonomous-ai-agents-are-being-used-in-real-world-cyberattacks/\">另一份报告</a>中，Check Point 研究人员表示，ARTEX 控制面板中的 AI 智能体只需数百美元，就能在极少人工干预的情况下发动大规模攻击，不过它们仍会失败并产生成功幻觉。</p><h2 id=\"sec-2\">\n\t<strong>Censys 揭示 ARTEX 的全球足迹</strong></h2><p>\n\tCensys Advanced Research Collective（ARC）首席安全研究员 Silas Cutler 于 11 月 5 日发布的<a href=\"https://censys.com/blog/artex-agentic-asbestos/\">报告</a>，进一步揭示了 ARTEX 的使用情况及其周边基础设施。</p><p>\n\t研究人员发现，全球有 1465 台主机将 ARTEX 控制台暴露在公共互联网上。其中约 650 台主机位于两个配置完全相同的托管区块内，因此约有 815 个外观各异的部署实例。</p><p>\n\t这表明 ARTEX 并非仅出现在少数彼此孤立的系统上，而是分布于全球数百个看似不同的部署实例中，其覆盖范围远比最初报告的更广。</p><p>\n\t此外，Censys 遥测数据显示，有 155 台暴露在互联网上的 ARTEX 主机（10.6%）还运行着至少一个被 Censys 归类为威胁的其他 artefact。</p><p>\n\t其中包括其他 AI 攻击框架、侦察平台、隧道工具，以及 Vshell、Cobalt Strike 和 Adaptix C2 等传统恶意命令与控制（C2）服务器。</p><p>\n\t一个名为 ScopeSentry 的资产发现和漏洞扫描平台也被 Censys 列为威胁 artefact，该平台由 ARTEX 的创建者维护。</p><p>\n\t研究人员还发现，ARTEX 与其他流行的 AI 渗透测试工具共享基础设施，包括 CyberStrikeAI、PentAGI、HexStrike AI 和 RedAmon。尤其是 CyberStrikeAI，在 70 台主机上与 ARTEX 同时出现。</p><p>\n\t“操作人员似乎在并行使用多个智能体框架，”Cutler 表示。</p><figure><img src=\"/dailyinfo/media/8c4d8d8e4f32552c.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Tools identified as threats by Censys and observed running on the same hosts as ARTEX. Source: Censys\"><figcaption>被 Censys 识别为威胁，并被观察到与 ARTEX 运行在同一批主机上的工具。来源：Censys</figcaption></figure><p>\n\tCERT-In 于 11 月报告的“Crafty Falcon”活动中出现了 ARTEX 与 PentAGI 和 CyberStrikeAI 一同使用的情况。</p><p>\n\tCensys 还识别出 32 台 ARTEX 主机，其可公开访问的目录中包含用于网络攻击不同阶段的工具，包括后利用工具包、stager 和 implant。</p><p>\n\t这些发现还表明 AI 基础设施在这些行动中的作用日益凸显，并发现 43 台 ARTEX 主机正在运行自托管的 LLM 网关或经销商软件。这表明，对 AI 模型的访问正在成为进攻性基础设施栈中的另一个组成部分。</p>","original","zhKind","translation","complete","CrowdStrike","Microsoft","CISA","https://www.infosecurity-magazine.com/news/artex-activity-exceeds-reported/","Infosecurity Magazine",{"_96":97,"_98":-5},"changelogVersion","2026-10-01T08:00","release"]
