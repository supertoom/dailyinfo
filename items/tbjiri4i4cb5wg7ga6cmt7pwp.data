[{"_1":2,"_3":4},"root",{"_5":139},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1794357643000,"id","tbjiri4i4cb5wg7ga6cmt7pwp","title","Red Hat 发布 Red Hat OpenShift 5，强化混合云智能运维与安全能力","originalTitle","The next era of hybrid cloud: Introducing Red Hat OpenShift 5","summary","Red Hat 发布 Red Hat OpenShift 5，围绕智能运维、主权安全和长期可预测性三大方向升级混合云应用平台。新版本提供机器驱动接口、MCP 端点及可选的 AI 升级规划功能，Red Hat Advanced Cluster Security 可通过新 MCP server 加速 CVE 修复；平台还引入 PQC 控制以保护控制平面通信。","reason","source",{"_73":138},"links",{"_60":137},"publishedAt","2026-11-10T00:00:00.000Z","discoveredAt","2026-11-10T22:55:37.646Z","timelineAt","category","blue-team","tags",[132,133,134,135,76,136],"score",43,"selected",false,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","body",{"_128":-5,"_60":129,"_130":-5,"_131":36},"outline",[85,86,87,88,89,90,91,92,93,94,95,96,97],"relatedStories",[81],"topics",[67,68,69,70],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fP1RuCsoJ2gA","reportCount",1,"additionalSourceCount",0,{"_71":79,"_73":80},{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","tools","name","工具与平台","ai-offense","AI 攻防","cloud-native","云与原生","redhat","Red Hat / 红帽",{"_82":83,"_13":84},"publicId","c4659b7a-1515-4ae1-8deb-26f8a633be2f","Red Hat 发布 OpenShift 5",{"_11":126,"_99":127,"_101":102},{"_11":124,"_99":125,"_101":102},{"_11":122,"_99":123,"_101":102},{"_11":120,"_99":121,"_101":102},{"_11":118,"_99":119,"_101":115},{"_11":116,"_99":117,"_101":115},{"_11":113,"_99":114,"_101":115},{"_11":111,"_99":112,"_101":102},{"_11":109,"_99":110,"_101":102},{"_11":107,"_99":108,"_101":102},{"_11":105,"_99":106,"_101":102},{"_11":103,"_99":104,"_101":102},{"_11":98,"_99":100,"_101":102},"sec-13","text","Virtualization","level",3,"sec-12","Applications","sec-11","Infrastructure","sec-10","Edge computing","sec-9","Security","sec-8","Automation","sec-7","Browse by channel",2,"sec-6","More like this","sec-5","Red&nbsp;Hat OpenShift Container Platform | Product Trial","sec-4","Building the next phase together","sec-3","Predictability grounded in real-world platform lifecycle","sec-2","Security and sovereignty designed for the quantum era","sec-1","A platform that works alongside your operations","zh","<p><span>November 10, 2026<span></span></span><span><em>7</em>-minute read</span><span></span><span><a href=\"https://www.redhat.com/en/blog?f[0]=taxonomy_topic_tid:27031#rhdc-search-listing\">Application development and delivery</a>, <a href=\"https://www.redhat.com/en/blog?f[0]=taxonomy_topic_tid:82041#rhdc-search-listing\">Application modernization</a>, <a href=\"https://www.redhat.com/en/blog?f[0]=taxonomy_topic_tid:115201#rhdc-search-listing\">Application platform</a>, <a href=\"https://www.redhat.com/en/blog?f[0]=taxonomy_topic_tid:75501#rhdc-search-listing\">Artificial intelligence</a>, <a href=\"https://www.redhat.com/en/blog?f[0]=taxonomy_topic_tid:9001#rhdc-search-listing\">Containers</a>, <a href=\"https://www.redhat.com/en/blog?f[0]=taxonomy_topic_tid:115501#rhdc-search-listing\">Developer productivity</a>, <a href=\"https://www.redhat.com/en/blog?f[0]=taxonomy_topic_tid:115421#rhdc-search-listing\">Developer tools</a>, <a href=\"https://www.redhat.com/en/blog?f[0]=taxonomy_topic_tid:9011#rhdc-search-listing\">Hybrid cloud</a>, <a href=\"https://www.redhat.com/en/blog?f[0]=taxonomy_topic_tid:4491#rhdc-search-listing\">Security</a>, <a href=\"https://www.redhat.com/en/blog?f[0]=taxonomy_topic_tid:27111#rhdc-search-listing\">Virtualization</a>, <a href=\"https://www.redhat.com/en/blog?f[0]=taxonomy_topic_tid:114051#rhdc-search-listing\">Zero trust</a></span></p><p><img src=\"/dailyinfo/media/3f1e802f5372156c.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"Mike Barrett\"></p><p>\n                    Vice President and General Manager of Red Hat Hybrid Platforms\n                  </p><p>Yesterday at OpenShift Commons in Salt Lake City, I announced a major milestone for our community: the next evolution of our application platform with Red&nbsp;Hat OpenShift 5.</p><p>If you go back to Red&nbsp;Hat Summit earlier this year,&nbsp;<a href=\"https://www.redhat.com/en/blog/openshift-consistent-integration-hybrid-enterprise\">I talked about</a> how IT teams face accelerating operational complexity. Over the past year, I’ve spent time with our customers, open source contributors, and technology partners discussing how they see platform technologies changing to meet those operational complexities. I’ve heard directly from platform engineers working with thousands of legacy virtual machines (VMs), containers, and AI workloads. I’ve talked to site reliability engineers troubleshooting late-night cluster incidents, and architecture leads tasked with bringing agentic AI into production. Across every industry, the mandate is clear: you need an application platform that removes operational overhead so your teams can focus on creating value.</p><p>Hearing those real-world needs reinforced why we've focused on building a comprehensive application foundation for hybrid workloads. We believe that focus was recently recognized when Gartner® named Red&nbsp;Hat a Leader across three separate 2026 Magic Quadrant™ reports:&nbsp;<a href=\"https://www.redhat.com/en/about/press-releases/red-hat-positioned-leader-2026-gartnerr-magic-quadranttm-cloud-native-application-platforms\">Cloud-Native Application Platforms</a>,&nbsp;<a href=\"https://www.redhat.com/en/about/press-releases/red-hat-positioned-leader-2026-gartnerr-magic-quadranttm-container-management\">Container Management</a>, and&nbsp;<a href=\"https://www.redhat.com/en/about/press-releases/red-hat-recognized-leader-2026-gartnerr-magic-quadranttm-server-virtualization-platforms\">Server Virtualization Platforms</a>.</p><p>Earning leadership across all three areas speaks directly to the path we’ve taken alongside our community. When we founded KubeVirt at Red&nbsp;Hat in 2016 to run VMs natively on Kubernetes, it was because our customers needed a practical bridge between traditional infrastructure and cloud-native application delivery. That journey reached a defining milestone as the Cloud Native Computing Foundation (CNCF) officially announced KubeVirt’s graduation—recognizing it at the CNCF’s highest project maturity level. What started at Red&nbsp;Hat is now driven by an ecosystem of more than 2,000 contributors across 500 organizations, serving as the open source foundation for Red&nbsp;Hat OpenShift Virtualization. Today, that proven base allows organizations to run VMs, containers, and AI workloads side by side on a unified application platform—whether on ships, at edge sites, or in data centers powering critical government APIs.&nbsp;</p><p>Red&nbsp;Hat OpenShift 5 is our answer to those customer conversations. Built directly on your feedback, it transforms complex operational tasks into guided, proactive experiences across three core pillars: intelligent operations, sovereign security, and long-term predictability.</p><h3 id=\"sec-1\">A platform that works alongside your operations</h3><p>We are all experiencing the AI agentic era together. Whether it is in our personal or professional lives, most of us have started interacting and tailoring an agentic harness to how we work. We are investing the time and cycles to refine and improve our experience with the harness we have chosen. We believe you should be able to apply your investments in agentic harnesses to OpenShift. OpenShift 5 offers machine-driven interfaces to allow you to have your own headless experience with the platform. OpenShift 5 ships the APIs, tool calls, metadata, and model context protocol (MCP) endpoints needed for you to operate in these new intelligent ways.&nbsp;&nbsp;</p><p>But that was only half of the story. We also wanted to participate in this new intelligent way of working and so we introduced new, but totally optional, AI-driven experiences for end users in OpenShift 5. We have dashboarding that end users can dynamically produce via chat. We have AI-driven reasoning loops that will take simple cluster events from noise to remedy suggestions. We know the difficult part of upgrading Kubernetes is not getting Kubernetes to upgrade, but rather navigating the thousands of pods to hundreds of operators, Helm charts, and containers across application requirements and pod disruption budgets. We have created an AI-driven way to crawl across all that data specific to a given cluster and we will create upgrade plans tailored to the cluster. These plans can be executed or modified by administrators with the click of a button and tracked as they roll out across the cluster. Red&nbsp;Hat Advanced Cluster Security can now accelerate remediation for CVE notifications through the use of its new MCP server. OpenShift 5 is our official entry into a world that has more ways to drive our platform and more ways to benefit from out-of-the-box automations. We do not plan on stopping here. With every release of OpenShift 5, expect to see more agentically driven experiences inside the product. We will always make them optional and never force AI upon any of our users. Red&nbsp;Hat would not have been able to move this quickly in applying AI to OpenShift 5 without our ability to feed from and leverage the Red&nbsp;Hat AI technology stack in our solution. Red&nbsp;Hat AI offers OpenShift 5’s agentic features a safer way to be driven and connect to LLM model endpoints that are both on-premises or provided by SaaS offerings. We look forward to receiving feedback on these features.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</p><h3 id=\"sec-2\">Security and sovereignty designed for the quantum era</h3><p>As geopolitical scrutiny increased over the last several years, our customers asked us for assistance in solving two main things. We see these challenges emerge when teams deploy to new locations and build out sovereign solutions. The first is an urgent need to adhere to approaching regulatory deadlines without driving up operational costs each time software is deployed across different infrastructure. OpenShift 5 introduces post-quantum cryptography (PQC) controls for control plane communications, helping safeguard sensitive data against future decryption threats. It also offers zero trust workload identity management via SPIFFE and SPIRE.&nbsp; OpenShift offers the tools companies need to meet the operational bars their industries require.&nbsp;&nbsp;</p><p>The second problem we noticed as companies pursued sovereign solutions came from providers. We saw an influx of historical and brand-new managed service providers (MSPs) and colocation solutions enter into the market. Many came from regional telecommunication companies. These are OpenShift customers as well. As they stood up OpenShift clusters for their own tenants, they wanted to impact their operational economics. They wanted the ability to allow for multiple isolation options. By marrying user-defined networks (UDN) based on Layer 2 networking with BGP routing and EVPN, we were able to produce a low-level isolation that could be connected to a Kubernetes namespace. That plus other security enhancements in OpenShift opened the door for these MSPs to offer economic “as a service” solutions to their tenants. With process, access, and network isolation, you can host strict multi-tenant environments, sovereign AI workloads, and traditional VMs together under a unified security model.</p><h3 id=\"sec-3\">Predictability grounded in real-world platform lifecycle</h3><p>To give organizations long-term stability, we are expanding standard support from 18 months to 2 years, accompanied by yearly Extended Lifecycle (ELC) releases that offer up to 5 years of total support for minor releases of OpenShift. Our customers are putting OpenShift in physical locations and ISV ecosystems that simply cannot be touched at the minor release level and we have found 5 years to be the best balance. The balance for any vendor comes from increasing the length of support for each minor release while keeping new minor releases flowing. Whenever a new major release happens, customers tend to think they will need to take on the operational burden of a significant upgrade and compliance certifications. Vendors have trained our customers to think in this way by leveraging major releases to introduce incompatibilities. We made it a primary engineering focus to ensure that moving to OpenShift 5 is straightforward and non-disruptive—especially at a time when many organizations are managing major platform migrations elsewhere across their stack. Upgrading from OpenShift 4 to OpenShift 5 uses standard, in-place updates (modeled after routine minor releases), eliminating the need for complex cluster migrations or fresh installs. To provide a smooth transition, OpenShift 5 supports RHEL CoreOS 9 and RHEL CoreOS 10 nodes within the same cluster. We have not deprecated any major OpenShift APIs. We have made conscious decisions to make moving from OpenShift 4.22 to OpenShift 5.0 easier than upgrading between OpenShift 4 minor releases.&nbsp; So if you have been upgrading OpenShift 4 releases for the last seven years, you know exactly what to expect during an upgrade to OpenShift 5. You have already experienced what it is going to be like and you know how long it is going to take. We did not add any mandatory software components that you must install. We did not force our customers to buy new feature bundles.&nbsp; Upgrading to OpenShift 5 might just be the easiest upgrade you do in 2026 or 2027.</p><p>Once running on OpenShift 5, the platform introduces built-in capabilities designed to simplify future 5.x updates. Pre-flight checks evaluate cluster configurations to identify potential risks before any changes occur. Integrated AI tools also provide suggestions for moving between&nbsp; OpenShift 5 updates. These intelligent tools proactively look for issues, report resolutions, and, with a human in the loop, remediate them before performing an update.</p><h3 id=\"sec-4\">Building the next phase together</h3><p>OpenShift 5 brings your workloads together so your team can spend less time maintaining infrastructure and more time delivering software. Every feature in this release reflects the ideas, feedback, and candid discussions shared by our community and partner ecosystem. We are grateful for your collaboration, and we look forward to seeing what you build next on Red&nbsp;Hat OpenShift 5.</p><p>Read the&nbsp;<a href=\"http://www.redhat.com/en/about/press-releases/red-hat-openshift-5-transforms-hybrid-cloud-operations-real-time-intelligence-and-zero-trust-security\">Red&nbsp;Hat OpenShift 5 press release</a></p><p>Explore&nbsp;<a href=\"https://www.redhat.com/en/blog/announcing-red-hat-openshift-5\">technical details on the Red&nbsp;Hat Blog</a></p><p>Get started on the&nbsp;<a href=\"https://access.redhat.com/products/red-hat-openshift-container-platform/?utm_source=gemini\">Red&nbsp;Hat Customer Portal</a></p><p><em>Gartner, Magic Quadrant for Server Virtualization, by Tony Harvey, Daniel Bowers, Paul Delory, Tony Iams, Owen Marino, 14 September 2026. Gartner, Magic Quadrant for Cloud-Native Application Platforms, Saha Mukul,&nbsp;Coqueiro Alex, Prasanna Lakshmi Narasimha, Watson Richard, 3 Aug. 2026. Gartner, Magic Quadrant for Container Management, By Dennis Smith, Tony Iams, Wataru Katsurashima, Lucas Albuquerque, Carolin Zhou, Bhuvie Chhabra, 2 September 2026. Gartner and Magic Quadrant are trademarks of Gartner, Inc. and/or its affiliates. This graphic was published by Gartner, Inc. as part of a larger research document and should be evaluated in the context of the entire document. Gartner does not endorse any company, vendor, product or service depicted in its publications, and does not advise technology users to select only those vendors with the highest ratings or other designation. Gartner publications consist of the opinions of Gartner’s business and technology insights organization and should not be construed as statements of fact. Gartner disclaims all warranties, expressed or implied, with respect to this publication, including any warranties of merchantability or fitness for a particular purpose. The Gartner document is available upon request from Red&nbsp;Hat.</em></p><p>Product trial</p><h2 id=\"sec-5\">Red&nbsp;Hat OpenShift Container Platform | Product Trial</h2><p>A consistent hybrid cloud foundation for building and scaling containerized applications.</p><p>\n                            <a href=\"https://www.redhat.com/en/technologies/cloud-computing/openshift/ocp-self-managed-trial?intcmp=7013a000003Sq0iAAC\" title=\"Red Hat OpenShift Container Platform | Product Trial\">Try it</a>            </p><hr><p><a href=\"https://www.redhat.com/en/authors/mike-barrett\"><img src=\"/dailyinfo/media/3f1e802f5372156c.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"Mike Barrett\">\n                        \n                    </a></p><h2 id=\"sec-6\">More like this</h2><p>            Blog post\n</p><p>            Blog post\n</p><p>            Original podcast\n</p><p>            Original podcast\n</p><h2 id=\"sec-7\">Browse by channel</h2><p>\n                            <a href=\"https://www.redhat.com/en/blog/channels\" title=\"Explore all channels\">Explore all channels</a>            </p><p>\n              \n  \n\n\n                  <img src=\"/dailyinfo/media/e54b8b12b5046028.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"automation icon\">\n                  </p><h3 id=\"sec-8\"><a href=\"https://www.redhat.com/en/blog/channel/management-and-automation\">Automation</a></h3><p>The latest on IT automation for tech, teams, and environments</p><p>\n              \n  \n\n\n                  <img src=\"/dailyinfo/media/8a821a2318338b17.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"security icon\">\n                  </p><h3 id=\"sec-9\"><a href=\"https://www.redhat.com/en/blog/channel/security\">Security</a></h3><p>The latest on how we reduce risks across environments and technologies</p><p>\n              \n  \n\n\n                  <img src=\"/dailyinfo/media/7ba24fccf63c7747.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"edge icon\">\n                  </p><h3 id=\"sec-10\"><a href=\"https://www.redhat.com/en/blog/channel/edge-computing\">Edge computing</a></h3><p>Updates on the platforms that simplify operations at the edge</p><p>\n              \n  \n\n\n                  <img src=\"/dailyinfo/media/3c20e7298d1bb543.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"Infrastructure icon\">\n                  </p><h3 id=\"sec-11\"><a href=\"https://www.redhat.com/en/blog/channel/infrastructure\">Infrastructure</a></h3><p>The latest on the world’s leading enterprise Linux platform</p><p>\n              \n  \n\n\n                  <img src=\"/dailyinfo/media/e3e51f29ae003c0b.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"application development icon\">\n                  </p><h3 id=\"sec-12\"><a href=\"https://www.redhat.com/en/blog/channel/applications\">Applications</a></h3><p>Inside our solutions to the toughest application challenges</p><p>\n              \n  \n\n\n                  <img src=\"/dailyinfo/media/820d8e45b3c05d24.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"Virtualization icon\">\n                  </p><h3 id=\"sec-13\"><a href=\"https://www.redhat.com/en/blog/channel/red-hat-virtualization\"> Virtualization</a></h3><p>The future of enterprise virtualization for your workloads on-premise or across clouds</p>","zhKind","complete","工具发布","版本更新","云原生","容器","Red Hat","https:/