[{"_1":2,"_3":4},"root",{"_5":118},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795567278000,"id","cpkja8bnlhxmi5kohgn7eye4s","title","VMware vCenter 认证绕过漏洞 CVE-2026-123890 已被在野利用","originalTitle","【已复现】无需凭据获取管理员会话——VMware vCenter 认证绕过漏洞（CVE-2026-123890）","summary","VMware vCenter 认证绕过漏洞 CVE-2026-123890 已被公开研究确认用于在野利用，长亭安全应急响应中心已完成复现验证。攻击者无需凭据，只需访问默认 TCP 2012 端口上的目录服务 RPC 接口，即可取得内置管理员会话，读取目录数据库、伪造 SSO 身份并创建管理员账号。","reason","复现验证与在野利用线索并存，并给出受影响版本、管理端口前提和临时收敛措施，便于管理员判断风险与排查。","source",{"_74":117},"links",{"_107":116},"publishedAt","2026-11-22T12:04:00.000Z","discoveredAt","2026-11-22T17:09:18.096Z","timelineAt","category","vuln","tags",[110,111,77,112,113,114,115],"score",89,"selected",true,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","body",{"_61":106,"_107":-5,"_108":107,"_109":37},"outline",[85,86,87,88,89,90],"relatedStories",[81],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fIdlWxeiKJhQ","reportCount",1,"additionalSourceCount",0,{"_72":79,"_74":80},{"_72":31,"_74":78},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","research","name","技术研究","exploited","在野利用","漏洞披露","vmware","VMware / Broadcom",{"_82":83,"_13":84},"publicId","25bfc85d-d33c-4d9e-8852-0430fda6b8b0","Armory Castle利用vCenter认证绕过漏洞",{"_11":104,"_92":105,"_94":95},{"_11":102,"_92":103,"_94":95},{"_11":100,"_92":101,"_94":95},{"_11":98,"_92":99,"_94":95},{"_11":96,"_92":97,"_94":95},{"_11":91,"_92":93,"_94":95},"sec-6","text","参考资料","level",3,"sec-5","临时缓解方案","sec-4","升级修复方案","sec-3","处置优先级：高","sec-2","漏洞影响","sec-1","漏洞成因","<p><span>长亭安全应急响应中心</span> <span>2026-11-22 20:04</span> <span>浙江</span></p><p><img src=\"/dailyinfo/media/0c3cefa484d947e2.jpg\" loading=\"lazy\" decoding=\"async\"></p><p>检测业务是否受到此漏洞影响，请联系长亭应急服务团队！</p><p><img alt=\"漏洞风险提示\" src=\"/dailyinfo/media/4f59ffeca57b104b.jpg\" loading=\"lazy\" decoding=\"async\"></p><p><span>VMware vCenter Server 是 VMware vSphere 环境的核心管理平台，用于集中管理 ESXi 主机、虚拟机、集群、存储与网络资源，同时承担单点登录、权限管理与告警等职能，广泛应用于企业私有云与虚拟化数据中心。</span></p><p><span>2026 年 11 月，长亭安全应急响应中心监测到 VMware vCenter 目录服务认证绕过风险。攻击者无需任何凭据，只要能够访问 vCenter 的管理网络，即可通过目录服务 RPC 接口绕过身份认证，取得内置管理员会话，进而读取目录数据库、伪造 SSO 身份并创建管理员账号。截至通告发布，Broadcom 已发布修复版本，公开研究显示该漏洞已被在野利用。建议受影响用户尽快升级至安全版本，并收敛管理接口的暴露面。</span></p><p><strong><span>漏洞描述</span></strong><span><span>&nbsp;Description&nbsp;</span></span></p><p><strong><span>01</span></strong></p><h3 id=\"sec-1\"><span>漏洞成因</span></h3><p><span>VMware Directory Service（vmdird）在 DCE/RPC 接口上实现 SRP-6a 认证，用于处理目录服务的身份校验。该实现允许未认证调用方取得与认证会话关联的 SRP 会话密钥，而相关会话句柄的生成具有可预测性。攻击者据此可以在不具备任何凭据的情况下完成 SRP 证明，使服务端接受其管理员身份，并建立受隐私保护机制约束的 RPC 上下文。</span></p><p><span>问题根源在于认证路径设计缺陷，官方将其归类为 VMware Directory Service 认证绕过。目录服务 RPC 接口默认在 TCP 2012 端口提供服务，该端口可达即构成攻击前提。</span></p><h3 id=\"sec-2\"><span>漏洞影响</span></h3><p><span>攻击者可以内置 SSO 管理员（administrator@vsphere.local）身份访问 vCenter，读取目录数据库及其中的凭据与证书材料，伪造 SAML 断言并创建持久化管理员账号。在此基础上可进一步操作 ESXi 主机与虚拟机，可能导致虚拟化平台整体失陷、业务中断与敏感数据泄露。</span></p><h3 id=\"sec-3\"><span>处置优先级：高</span></h3><p><strong><span>漏洞类型：</span></strong><span>&nbsp;认证绕过</span></p><p><strong><span>漏洞危害等级：</span></strong><span>&nbsp;高</span></p><p><strong><span>触发方式：</span></strong><span>&nbsp;网络远程</span></p><p><strong><span>权限认证要求：</span></strong><span>&nbsp;无需权限</span></p><p><strong><span>系统配置要求：</span></strong><span>&nbsp;默认配置</span></p><p><strong><span>用户交互要求：</span></strong><span>&nbsp;无需用户交互</span></p><p><strong><span>利用成熟度：</span></strong><span>&nbsp;POC 未公开</span></p><p><strong><span>修复复杂度：</span></strong><span>&nbsp;低，官方已提供修复方案</span></p><p><strong><span>影响版本</span></strong><span><span>&nbsp;Affects&nbsp;</span></span></p><p><strong><span>02</span></strong></p><p><span>VMware vCenter 9.1.x（低于 9.1.1.0200）</span></p><p><span>VMware vCenter 9.0.x（低于 9.0.2.0200）</span></p><p><span>VMware vCenter 8.0（低于 8.0 U3m）</span></p><p><span>VMware vCenter 7.0</span></p><p><span>VMware Cloud Foundation 5.x（低于 5.2.5）</span></p><p><span>VMware Telco Cloud Platform 3.0、4.x、5.0.x、5.1.x、5.2</span></p><p><span>VMware Telco Cloud Infrastructure 3.0</span></p><p><strong><span>解决方案</span></strong><span><span>&nbsp;Solution&nbsp;</span></span></p><p><strong><span>03</span></strong></p><h3 id=\"sec-4\"><span>升级修复方案</span></h3><p><span>建议升级至以下安全版本或更高版本：</span></p><ul><li><p><span>VMware vCenter 9.1.x 升级至 9.1.1.0200</span></p></li><li><p><span>VMware vCenter 9.0.x 升级至 9.0.2.0200</span></p></li><li><p><span>VMware vCenter 8.0 升级至 8.0 U3m</span></p></li><li><p><span>VMware Cloud Foundation 5.x 升级至 5.2.5</span></p></li><li><p><span>VMware vCenter 7.0 请联系 Broadcom 支持获取修复</span></p></li><li><p><span>VMware Telco Cloud Platform 与 Telco Cloud Infrastructure 的修复方式参见 KB463116</span></p></li></ul><p><span>官方公告与修复说明：</span></p><p><span><a href=\"https://support.broadcom.com/web/ecx/support-content-notification/-/external/content/SecurityAdvisories/0/39495\">https://support.broadcom.com/web/ecx/support-content-notification/-/external/content/SecurityAdvisories/0/39495</a></span></p><h3 id=\"sec-5\"><span>临时缓解方案</span></h3><p><span>Broadcom 未提供官方临时缓解方案，以下措施为应急临时手段，可能影响正常管理运维，升级完成后应及时恢复。</span></p><ul><li><p><span>通过防火墙或安全组限制 TCP 2012、443、389、636 等管理端口仅对运维网段开放，禁止来自办公网、业务网及互联网的直连访问。</span></p></li><li><p><span>收敛 vCenter 管理面（含 /ui、/sdk）的对外暴露，确需远程管理的场景应通过跳板机或 VPN 接入。</span></p></li><li><p><span>加强 vCenter 与 SSO 账号审计，排查是否存在非预期创建的管理员账号与异常 SAML 登录记录。</span></p></li></ul><p><strong><span>漏洞复现</span></strong><span><span>&nbsp;Reproduction&nbsp;</span></span></p><p><strong><span>04</span></strong></p><p><span>长亭安全应急响应中心已完成复现验证。</span></p><p><img src=\"/dailyinfo/media/5b423408294bb062.webp\" loading=\"lazy\" decoding=\"async\"></p><p><strong><span>时间线</span></strong><span><span>&nbsp;Timeline&nbsp;</span></span></p><p><strong><span>05</span></strong></p><p><span>2026 年 11 月 22 日 长亭安全应急响应中心发布通告</span></p><h3 id=\"sec-6\"><span>参考资料</span></h3><p><span>[1]. <a href=\"https://support.broadcom.com/web/ecx/support-content-notification/-/external/content/SecurityAdvisories/0/39495\">https://support.broadcom.com/web/ecx/support-content-notification/-/external/content/SecurityAdvisories/0/39495</a></span></p><p><span>[2]. <a href=\"https://cloud.google.com/blog/topics/threat-intelligence/armory-castle-exploits-vsphere\">https://cloud.google.com/blog/topics/threat-intelligence/armory-castle-exploits-vsphere</a></span></p><p><span>[3]. <a href=\"https://knowledge.broadcom.com/external/article/463116\">https://knowledge.broadcom.com/external/article/463116</a></span></p><p><strong><span>长亭应急响应服务</span></strong></p><p><span>全力进行产品升级</span></p><p><span>及时将风险提示预案发送给客户</span></p><p><span>检测业务是否受到此次漏洞影响</span></p><p><span>请联系长亭应急服务团队</span></p><p><span>7*24小时，守护您的安全</span></p><p><span>第一时间找到我们：</span></p><p><span>邮箱：support@chaitin.com</span></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=df06417b&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzIwMDk1MjMyMg%3D%3D%26mid%3D2247493574%26idx%3D2%26sn%3Dfa6556997dc76f69e9fe5503d753a9fe\">跳转微信打开</a></p>","original","zhKind","complete","漏洞","复现","补丁","漏洞分析","VMware","长亭","https://mp.weixin.qq.com/s?__biz=MzIwMDk1MjMyMg==&mid=2247493574&idx=2&sn=fa6556997dc76f69e9fe5503d753a9fe","长亭安全应急响应中心",{"_119":120,"_121":-5},"changelogVersion","2026-10-01T08:00","release"]
