[{"_1":2,"_3":4},"root",{"_5":108},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795048835000,"id","pmiduqexfgnhmjqwnvwtqqvg5","title","Microsoft Azure Linux 4 正式可用，为 Azure 虚拟机提供免额外许可费的统一服务器 OS","originalTitle","Azure Linux 4 puts the OS behind Microsoft’s cloud services on your VMs at no extra license fee","summary","Microsoft Azure Linux 4 正式可用，面向客户虚拟机和规模集提供通用服务器 OS，仅支付 Azure 计算费用，不另收 OS 许可费。","reason","source",{"_74":107},"links",{"_61":106},"publishedAt","2026-11-18T23:01:14.000Z","discoveredAt","2026-11-18T23:07:32.835Z","timelineAt","category","blue-team","tags",[99,100,101,102,103,104,105],"score",41,"selected",false,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Anamarija Pogorelec","body",{"_95":-5,"_61":96,"_97":-5,"_98":36},"outline",[86,87],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","f5GS4rluHUz0","reportCount",1,"additionalSourceCount",0,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","tools","name","工具与平台","kernel","内核与系统","cloud-native","云与原生","microsoft","Microsoft / 微软",{"_83":84,"_13":85},"publicId","5cf01ade-f6e3-41ac-8453-419409d1f375","微软发布Azure Linux 4服务器系统",{"_11":93,"_89":94,"_91":92},{"_11":88,"_89":90,"_91":92},"sec-2","text","Containers with no shell","level",3,"sec-1","What ships","zh","<p>Microsoft made Azure Linux 4 generally available. The company is offering its in-house Linux distribution as a general-purpose server OS for customer virtual machines and scale sets. Customers pay for the Azure compute underneath and no additional OS licensing fee.</p><p><img src=\"/dailyinfo/media/b89b9571a51e8485.webp\" loading=\"lazy\" decoding=\"async\" alt=\"Azure Linux 4\" title=\"Azure Linux 4\"></p><p>The same distribution already runs on millions of cores across Azure services, including Azure Kubernetes Service, App Service and Azure Cosmos DB. A team that runs one distro on VMs, another on Kubernetes nodes and a third in container images, each patched on a different calendar, can put all three on one.</p><h3 id=\"sec-1\">What ships</h3><p>Azure Linux is derived from Fedora and uses RPM packages. Azure Linux is not designed for desktop use or GUI applications.</p><p>Version 4 ships Linux kernel 6.18 LTS, the dnf5 package manager, systemd 258, glibc 2.42, RPM 6.0, Python 3.14 and OpenSSL 3.5. OpenSSL 3.5 adds support for post-quantum cryptography, which is encryption meant to hold up against future quantum computers. SELinux, a kernel feature that limits what each process can touch, is on by default, and drivers are signed.</p><h3 id=\"sec-2\">Containers with no shell</h3><p><a href=\"https://www.helpnetsecurity.com/2026/11/04/rapidfort-runtime-container-profiling/\">Container</a> images come in three types. All are built from the same supply chain as the VMs and hosted on Microsoft Artifact Registry. Core images let teams install any package. Runtime images come set up for Python, Node.js, Java or .NET. Distroless images strip out the shell and the package manager. That shrinks what an attacker can use after getting in, and also what an engineer can use to debug a live container.</p><p>Several security vendors support the release. “Palo Alto Networks and AquaSec provide workload and container protection capabilities; Qualys helps teams identify vulnerabilities and monitor compliance; and Upwind and Wiz bring runtime visibility and cloud context to help prioritize security risks. NVIDIA broadens options for GPU-accelerated AI and compute-intensive workloads,” said <a href=\"https://www.linkedin.com/in/jim-perrin-msft/\">Jim Perrin</a>, Azure Linux Program Lead for Microsoft, <a href=\"https://techcommunity.microsoft.com/blog/linuxandopensourceblog/azure-linux-4-is-generally-available/4573381\">wrote</a>.</p><p>Azure Linux 4 is available on <a href=\"https://github.com/microsoft/azurelinux\">GitHub</a>.</p>","zhKind","complete","工具发布","版本更新","操作系统","容器","云原生","Microsoft","AWS","https://www.helpnetsecurity.com/2026/11/19/microsoft-azure-linux-4/","Help Net Security",{"_109":110,"_111":-5},"changelogVersion","2026-10-01T08:00","release"]
