[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":60,"_61":62},"expiresAt",1795826437000,"id","avypzdbdq1qojwu816bm9mjpx","title","Palo Alto Networks 修复已被利用的 PAN-OS Fragnesia 提权漏洞 CVE-2026-46300","originalTitle","Palo Alto Networks Patches Fragnesia Flaw Used to Root Firewalls","summary","Palo Alto Networks 发布 PAN-OS 更新，修复 Linux 内核 Fragnesia 提权漏洞 CVE-2026-46300。该漏洞影响 XFRM ESP-in-TCP 子系统，无权限攻击者可覆写敏感系统文件并获得 root 权限。","reason","原文把 Fragnesia 的提权链、已观察到的利用活动与 PAN-OS 修复版本放在一起，便于判断管理界面暴露风险并安排升级。","source",{"_75":96},"links",{"_62":95},"publishedAt","2026-11-25T08:12:24.000Z","discoveredAt","2026-11-25T08:59:32.960Z","timelineAt","category","vuln","tags",[90,91,76,92,93,94],"score",84,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Ionut Arghire","body",{"_86":-5,"_62":87,"_88":-5,"_89":60},"outline",[],"relatedStories",[82],"topics",[69,70,71,72],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation",false,"bodyLanguage","original","factId","fls6PdC5HPDo","reportCount",2,"additionalSourceCount",1,{"_73":80,"_75":81},{"_73":78,"_75":79},{"_73":31,"_75":77},{"_73":74,"_75":76},"slug","exploited","name","在野利用","漏洞披露","kernel","内核与系统","paloalto","Palo Alto Networks",{"_83":84,"_13":85},"publicId","55541e1d-451d-4a0a-8a54-c5d0a3e7172d","Palo Alto已修复Fragnesia漏洞","zh","<p><strong>Palo Alto Networks on Tuesday announced PAN-OS updates that patch the Fragnesia Linux kernel vulnerability exploited to root its firewalls.</strong>\n\n\n\n</p><p>Tracked as CVE-2026-46300, <a href=\"https://www.securityweek.com/new-linux-kernel-vulnerability-fragnesia-allows-root-privilege-escalation/\">Fragnesia</a> was disclosed in May 2026 as a privilege escalation bug in the kernel’s XFRM ESP-in-TCP subsystem. It allows unprivileged attackers to overwrite sensitive system files to gain root permissions.\n\n\n\n</p><p>On October 26, cybersecurity firm Dream warned that a Chinese-speaking threat actor <a href=\"https://www.securityweek.com/china-linked-hackers-exploit-php2shell-to-root-firewalls/\">successfully exploited</a> the critical <a href=\"https://www.securityweek.com/topics/php2shell/\">PHP2Shell</a> bugs and the Linux kernel weakness to hack two servers of a US government-affiliated organization.\n\n\n\n</p><p>As part of the AI-assisted campaign, the attackers compromised 25 servers (24 firewalls and one internal firewall management server), exploiting PHP2Shell to gain remote code execution (RCE), and executing a Fragnesia exploit to deploy webshells with root privileges.\n\n\n\n</p><p>On October 29, Palo Alto Networks confirmed that the threat actor hit PAN-OS firewalls with management interfaces exposed to the internet in attacks <a href=\"https://www.securityweek.com/php2shell-attacks-root-palo-alto-firewalls-but-fail-against-wordpress/\">chaining PHP2Shell with Fragnesia</a>.\n\n\n\n</p><p>By October 30, the company had released <a href=\"https://security.paloaltonetworks.com/CVE-2026-109618\">patches</a> for PHP2Shell across all supported PAN-OS versions, closing the known initial-access path.</p><p><span>Advertisement. Scroll to continue reading.</span></p><p>“If you are running a fixed PAN-OS listed in the CVE-2026-109618 [PHP2Shell] advisory, you are protected,” Palo Alto Networks notes in a Tuesday <a href=\"https://security.paloaltonetworks.com/PAN-SA-2026-0015\">advisory</a>.\n\n\n\n</p><p>Regardless, the company released new PAN-OS versions that address CVE-2026-46300: 12.2.4-h3, 12.1.10-h6, 12.1.7-h15, 12.1.4-h15, 11.2.16-h3, 11.2.13-h6, 11.2.10-h19, 11.2.7-h25, 11.2.4-h25, 11.1.16-h6, 11.1.13-h18, 11.1.10-h38, 11.1.7-h14, 11.1.6-h42, 11.1.4-h40, 10.2.18-h15, 10.2.16-h14, 10.2.13-h29, 10.2.10-h45, and 10.2.7-h41.\n\n\n\n</p><p>Palo Alto Networks recommends applying the fixes for Fragnesia, although the only known way to exploit it against PAN-OS is to first exploit PHP2Shell via an internet-exposed management interface.\n\n\n\n</p><p>The company also <a href=\"https://docs.paloaltonetworks.com/best-practices/10-1/administrative-access-best-practices/administrative-access-best-practices/deploy-administrative-access-best-practices#id2f3da1a1-21d4-4b15-917b-f3602ff20ba1\">recommends</a> not allowing direct access to the management interface from the web. Instead, users should only allow access from the management network or route the access via a VPN.\n\n\n\n</p><p>“Exploitation of CVE-2026-46300 has been observed targeting the Palo Alto Networks management interface exposed to the internet,” Palo Alto Networks notes.\n\n\n\n</p><p><strong>Related:</strong> <a href=\"https://www.securityweek.com/vmware-updates-patch-critical-esx-vcenter-vulnerabilities/\">VMware Updates Patch Critical ESX, vCenter Vulnerabilities</a>\n\n\n\n</p><p><strong>Related:</strong> <a href=\"https://www.securityweek.com/check-point-security-management-servers-hacked-in-ai-assisted-campaign/\">Check Point Security Management Servers Hacked in AI-Assisted Campaign</a>\n\n\n\n</p><p><strong>Related:</strong> <a href=\"https://www.securityweek.com/elecbrakes-bluetooth-vulnerabilities-expose-trailers-to-forced-braking/\">Elecbrakes Bluetooth Vulnerabilities Expose Trailers to Forced Braking</a>\n\n\n\n</p><p><strong>Related:</strong> <a href=\"https://www.securityweek.com/n-able-patches-critical-flaw-disclosed-after-mail-assure-cyberattack/\">N-able Patches Critical Flaw Discovered After Mail Assure Cyberattack</a>\n\n\n\n</p>","zhKind","complete","漏洞","补丁","内核","Palo Alto","PHP","https://www.securityweek.com/palo-alto-networks-patches-fragnesia-flaw-used-to-root-firewalls/","SecurityWeek",{"_98":99,"_100":-5},"changelogVersion","2026-10-01T08:00","release"]
