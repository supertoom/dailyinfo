[{"_1":2,"_3":4},"root",{"_5":124},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795480840000,"id","nzpbt56ivpfcejp2mk6oqnujs","title","Microsoft Outlook 欺骗漏洞 CVE-2026-124194 已复现并遭在野利用","originalTitle","已复现！微软Outlook欺骗漏洞可致NTLMv2响应泄露","summary","Microsoft Outlook 欺骗漏洞 CVE-2026-124194 已遭在野利用，攻击者可投递特制 .ics 日历文件诱使用户打开或导入，借此向攻击者控制的网络位置发起认证并泄露当前用户的 NTLMv2 响应；利用可远程触发，无需权限，但需要用户配合。","reason","文章给出可复现的 .ics 触发链、已捕获的在野利用行为及出站 SMB 缓解措施，便于评估凭据泄露风险并安排处置。","source",{"_74":123},"links",{"_114":122},"publishedAt","2026-11-19T17:06:00.000Z","discoveredAt","2026-11-20T15:21:30.821Z","timelineAt","category","vuln","tags",[117,75,118,119,120,121],"score",84,"selected",true,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","body",{"_61":113,"_114":-5,"_115":114,"_116":37},"outline",[85,86,87,88,89,90,91,92],"relatedStories",[81],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","zh","factId","f6fFIxDCnQZE","reportCount",1,"additionalSourceCount",0,{"_72":79,"_74":80},{"_72":77,"_74":78},{"_72":31,"_74":76},{"_72":73,"_74":75},"slug","exploited","name","在野利用","漏洞披露","email","邮件与钓鱼","microsoft","Microsoft / 微软",{"_82":83,"_13":84},"publicId","f85056de-f67c-430a-933d-7ce4acb1d258","Outlook欺骗漏洞已复现并确认在野利用",{"_11":111,"_94":112,"_96":97},{"_11":109,"_94":110,"_96":97},{"_11":107,"_94":108,"_96":97},{"_11":105,"_94":106,"_96":97},{"_11":103,"_94":104,"_96":97},{"_11":101,"_94":102,"_96":100},{"_11":98,"_94":99,"_96":100},{"_11":93,"_94":95,"_96":97},"sec-8","text","微步产品支撑","level",2,"sec-7","官方临时缓解建议",3,"sec-6","官方修复方案","sec-5","修复方案","sec-4","漏洞复现","sec-3","漏洞影响范围","sec-2","漏洞处置优先级(VPT)","sec-1","漏洞概况","<p><span>微步在线研究响应中心</span> <span>2026-11-20 01:06</span> <span>北京</span></p><p><img src=\"/dailyinfo/media/7fd40ab3c913894d.jpg\" loading=\"lazy\" decoding=\"async\"></p><h2 id=\"sec-1\"><span><span>漏洞概况</span></span></h2><hr><p><span>Outlook 是微软的电子邮件与日历客户端，广泛用于收发邮件、管理日历和处理会议邀请。</span></p><p><span>近日，Microsoft Office LTSC 2024 For 32-bit Editions官方发布通告，修复了微软Outlook欺骗漏洞（CVE-2026-124194）。</span><strong><span>微步情报局已成功复现。</span></strong><span>经分析，Outlook 是微软的电子邮件与日历客户端，广泛用于收发邮件、管理日历和处理会议邀请。由于 Outlook 在打开或导入带网络标记（Mark-of-the-Web）的日历文件（.ics）时，未将来源信任状态纳入外部内容检查，攻击者可向用户投递特制的 .ics 文件；用户打开该文件后，Outlook 会向攻击者控制的网络位置发起认证，导致当前用户的 NTLMv2 响应泄露。（完整漏洞情报请查阅<a href=\"https://x.threatbook.com/v5/vul/XVE-2026-94403%EF%BC%89\">https://x.threatbook.com/v5/vul/XVE-2026-94403）</a></span></p><p><span>此漏洞</span><strong><span>已遭在野利用</span></strong><span>，攻击者成功利用此漏洞可</span><strong><span>导致当前用户的 NTLMv2 响应泄露，</span></strong><span>建议受影响用户</span><strong><span>尽快修复。</span></strong></p><h2 id=\"sec-2\"><span><span>漏洞处置优先级(VPT)</span></span></h2><hr><p><strong><span>风险等级：中风险</span></strong><span><br></span><strong><span>风险分数：8.1</span></strong></p><table><tbody><tr><td rowspan=\"3\"><p><strong><span>基本信息</span></strong></p></td><td><p><span>微步编号</span></p></td><td><p><span>XVE-2026-94403</span></p></td></tr><tr><td><p><span>CVE编号</span></p></td><td><p><span>CVE-2026-124194</span></p></td></tr><tr><td><p><span>漏洞类型</span></p></td><td><p><span>信任管理</span></p></td></tr><tr><td rowspan=\"5\"><p><strong><span>利用条件评估</span></strong></p></td><td><p><span>利用漏洞的网络条件</span></p></td><td><p><span>可远程利用</span></p></td></tr><tr><td><p><span>是否需要绕过安全机制</span></p></td><td><p><span>不需要</span></p></td></tr><tr><td><p><span>对被攻击系统的要求</span></p></td><td><p><span>默认配置；未知</span></p></td></tr><tr><td><p><span>利用漏洞的权限要求</span></p></td><td><p><span>无需任何权限</span></p></td></tr><tr><td><p><span>是否需要受害者配合</span></p></td><td><p><span>需要受害者主动配合；触发要求用户打开或导入 .ics</span></p></td></tr><tr><td rowspan=\"2\"><p><strong><span>利用情报</span></strong></p></td><td><p><span>POC是否公开</span></p></td><td><p><span>是</span></p></td></tr><tr><td><p><span>已知利用行为</span></p></td><td><p><span>已捕获在野利用行为</span></p></td></tr></tbody></table><h2 id=\"sec-3\"><span><span>漏洞影响范围</span></span></h2><hr><table><tbody><tr><td><p><strong><span>产品名称</span></strong></p></td><td><p><span>Microsoft | Microsoft Office LTSC 2024 For 32-bit Editions</span><span><br></span><span>Microsoft | Microsoft Office LTSC 2024 For 64-bit Editions</span><span><br></span><span>Microsoft | Microsoft Office LTSC 2021</span><span><br></span><span>Microsoft | Microsoft 365 Apps For Enterprise For 32-bit Systems</span><span><br></span><span>Microsoft | Microsoft Office LTSC 2024</span></p></td></tr><tr><td><p><strong><span>受影响版本</span></strong></p></td><td><p><span>Microsoft Office LTSC 2024 For 32-bit Editions: version&lt;16.0.17932.21140</span><span><br></span><span>Microsoft Office LTSC 2024 For 64-bit Editions: version&lt;16.0.17932.21140</span><span><br></span><span>Microsoft Office LTSC 2021: version&lt;16.0.14334.21048</span><span><br></span><span>Microsoft Office LTSC 2021: 16.0.1&lt;=version&lt;16.0.14334.21048</span><span><br></span><span>Microsoft 365 Apps For Enterprise For 32-bit Systems: 16.0.1&lt;=version&lt;<a href=\"https://aka.ms/OfficeSecurityReleases\">https://aka.ms/OfficeSecurityReleases</a></span><span><br></span><span>Microsoft Office LTSC 2024: 16.0.0&lt;=version&lt;16.0.17932.21140</span></p></td></tr><tr><td><p><strong><span>有无修复补丁</span></strong></p></td><td><p><span>有</span></p></td></tr></tbody></table><h2 id=\"sec-4\"><span><span>漏洞复现</span></span></h2><hr><p><span>1. 在靶机下载并打开特制的 .ics 文件，出现 iCalendar 窗口且无外部内容警告 （复现图片未能安全导入）</span></p><p><img alt=\"image.png\" width=\"1280\" src=\"/dailyinfo/media/1c435963d708be6b.webp\" srcset=\"/dailyinfo/media/bc806f599a6c8277.webp 720w, /dailyinfo/media/70a2d043890e6a4b.webp 1200w, /dailyinfo/media/1c435963d708be6b.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\"></p><p><span>2. 查看攻击机的 SMB 监听日志（journal），可以看到靶机当前用户的NTLMv2响应</span></p><p><img src=\"/dailyinfo/media/d2d26b087a010065.webp\" loading=\"lazy\" decoding=\"async\"></p><h2 id=\"sec-5\"><span><span>修复方案</span></span></h2><hr><h3 id=\"sec-6\"><span>官方修复方案</span></h3><p><span>厂商已提供漏洞修补方案，建议用户参考官方通告修复：</span><span><br></span><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-124194\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-124194</a></span></p><p><span><a href=\"https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-124194\">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-124194</a></span></p><h3 id=\"sec-7\"><span>官方临时缓解建议</span></h3><ul><li><p><span>在网络边界与主机防火墙上禁止出站 SMB（TCP 445、139）到非受信网段与 Internet。</span></p></li><li><p><span>若业务允许，将出站 NTLM 限制（</span><code><span>Network security: Restrict NTLM: Outgoing NTLM traffic to remote servers</span></code><span>）设为&nbsp;</span><code><span>Deny all</span></code><span>；对仍需使用 NTLM 认证的服务器，将其列入远程服务器例外（</span><code><span>Add remote server exceptions for NTLM authentication</span></code><span>）。</span></p></li></ul><h2 id=\"sec-8\"><span><span>微步产品支撑</span></span></h2><hr><p><span>微步漏洞情报于</span><strong><span>2026年11月11日</span></strong><span>收录该漏洞。</span></p><p><span>微步下一代威胁情报平台NGTIP，高级威胁情报平台ATI及X情报中心已于漏洞收录时向漏洞订阅用户推送该漏洞情报，并将持续推送后续更新；对于已经录入资产的用户，支持实时自动化排查受影响资产。</span></p><p><span>微步威胁感知平台TDP已于</span><strong><span>20261119</span></strong><span>支持检测，检测ID：</span><strong><span>S3100186878，</span></strong><span>模型/规则高于：</span><strong><span>20261119000000&nbsp;</span></strong><span>可检出。</span></p><p><img alt=\"image.png\" width=\"1520\" src=\"/dailyinfo/media/1f258cecd0daa044.webp\" srcset=\"/dailyinfo/media/3f81d8862af8fe41.webp 720w, /dailyinfo/media/8273c6bcf4d356e2.webp 1200w, /dailyinfo/media/1f258cecd0daa044.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\"></p><p><span>微步威胁防御系统OneSIG已支持防护规则ID为：</span><strong><span>3100186878</span></strong></p><p><a href=\"https://wechat2rss.xlab.app/link-proxy/?k=f46cae2e&amp;r=1&amp;u=https%3A%2F%2Fmp.weixin.qq.com%2Fs%3F__biz%3DMzg5MTc3ODY4Mw%3D%3D%26mid%3D2247509077%26idx%3D3%26sn%3Dfc17281daf783d776f4c2748ce5df332\">跳转微信打开</a></p>","original","zhKind","complete","漏洞","复现","补丁","邮件安全","Microsoft","https://mp.weixin.qq.com/s?__biz=Mzg5MTc3ODY4Mw==&mid=2247509077&idx=3&sn=fc17281daf783d776f4c2748ce5df332","微步在线研究响应中心",{"_125":126,"_127":-5},"changelogVersion","2026-10-01T08:00","release"]
