[{"_1":2,"_3":4},"root",{"_5":94},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794530483000,"id","dtp3to82km6fv43pn6rwviy2e","title","N-central 4EverAble2Shell 与 Agent2Shell 暴露在野利用尝试","originalTitle","New N-central Exploits Work Against Patched Servers, Enable Root RCE and Windows SYSTEM Access","summary","N-able 披露 N-central 2026.4.1 HF2 的新漏洞 4EverAble2Shell 与 Agent2Shell，PoC 已能攻击 2026.4 Hotfix 2（build 2026.4.1.26）。","reason","材料记录了针对已修补 N-central 的定向探测，并给出利用链、来源 IP 与关键前提，便于识别并处置相关风险。","source",{"_73":93},"links",{"_84":92},"publishedAt","2026-11-12T11:51:43.000Z","discoveredAt","2026-11-12T13:25:23.158Z","timelineAt","category","disclosure","tags",[88,89,74,90,76,91],"score",76,"selected",true,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","info@thehackernews.com (The Hacker News)","body",{"_61":83,"_84":-5,"_85":86,"_87":37},"outline",[],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","f1rJH6X62tv8","reportCount",1,"additionalSourceCount",0,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","research","name","技术研究","exploited","在野利用","vuln","漏洞披露",{"_80":81,"_13":82},"publicId","ed4db3d6-dbb8-43e7-b004-fff9ac19f4ca","N-central热修复后4EverAble2Shell已被利用","<p><span><i></i><span>Ravie Lakshmanan</span><i></i><span>2026年11月12日</span></span><span>漏洞 / 网络攻击</span></p><p><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhR4KdRS0v77uQIdhC0i5aopa8XIAZIRnTzVCVqto7dEdfUH2QyWgrAy1EKu-hARXS4pxNGQQEFroRHOtwSq_9Q8b92tmgw_97JMJoBfC72sl8pOcUYM9nU6YCJht4yD7ALWfERwhUwLsN8wo9t8YnKyIWzHhEAux5ox5WV4wvxe6l1cUmf58P1md2Ekziy/s1600/nable.jpg\"><img alt=\"\" src=\"/dailyinfo/media/429623ad1d9f5649.jpg\" loading=\"lazy\" decoding=\"async\"></a></p><p>N-able 周四表示，正在调查一项新的公开披露，其中声称运行 2026.4.1 HF2 版本的本地部署版 N-central 存在更多漏洞。</p><p>“根据我们的初步审查，所描述的服务器问题取决于一种非默认配置，即 Legacy API 已启用并暴露在公共互联网上，”N-able 在一份新公告中<a href=\"https://uptime.n-able.com/event/202609/\">表示</a>。“该产品默认关闭 Legacy API，并且不建议启用。”</p><p>该公司敦促客户立即禁用 Legacy API（如果尚未禁用）。它还指出，托管环境不受此问题影响。</p><p>此事件影响以下服务 -</p><ul>\n  <li>N-central On-premise (Americas)</li>\n  <li>N-central On-premise (APAC)</li>\n  <li>N-central On-premise (Europe)</li>\n</ul><p>此事发生在 N-able 于本周早些时候<a href=\"https://uptime.n-able.com/event/202584/\">发布</a> 2026.4.1.26 以<a href=\"https://status.n-able.com/2026/11/10/n-central-2026-4-hf2-release-notes/\">解决</a>独立安全研究员 Sean Bales 披露的多项安全漏洞的数天之后。这些漏洞统称为 <a href=\"https://thehackernews.com/2026/11/n-able-takes-hosted-n-central-offline.html\">Able2Shell</a>。</p><p>这项新缺陷同样由 Bales <a href=\"https://github.com/MSPNightmare/CVEs/tree/main/0-Days/N-Central%20N-Able\">披露</a>，代号为 <strong>4EverAble2Shell</strong> 和 <strong>Agent2Shell</strong>；概念验证（PoC）漏洞利用程序可成功攻击 N-central 2026.4 Hotfix 2（build 2026.4.1.26）。这是 N-able 于 2026年11月10日 为解决 Able2Shell 而发布的更新。</p><p>据该<a href=\"https://x.com/seankbales/status/2120729661017555235\">研究员</a>称，4EverAble2Shell 可在 N-central 服务器上以 root 权限实现未经身份验证的远程代码执行。另一方面，Agent2Shell 利用超过 10 个零日漏洞，以 NT AUTHORITY\\SYSTEM 身份在受管理的 Windows 代理上运行命令，前提是攻击者知道目标设备的 ID。</p><p>Previdian 创始人兼 CEO Ryan Dewhurst 告诉 The Hacker News，在 PoC 发布后数小时内，已<a href=\"https://previdian.com/VULN-2026-0009#telemetry\">观察到</a>针对 4EverAble2Shell 的定向 N-central 探测活动。这些活动源自 IP 地址 157.20.241[.]16。截至撰稿时，没有成功利用的证据。</p><p>在这家威胁情报公司观察到的攻击链中，威胁行为者被观察到试图首先利用最近披露的 Apache Axis 漏洞（CVE-2026-90436，CVSS 分数：9.8）实现初始代码执行，随后尝试使用 4EverAble2Shell 将权限提升至 root，然后使用 curl 从 157.20.241[.]16 下载并执行 shell 脚本。</p><p>Dewhurst 表示，这一动向标志着首次有记录的攻击尝试以 CVE-2026-90436 为目标；该漏洞的补丁已于 2026年11月6日 发布。</p><p>watchTowr 在 X 上发布的一篇<a href=\"https://x.com/watchtowrcyber/status/2120803577094439123\">帖子</a>中也表示，其观察到针对启用了 Legacy API 的 N-Central 构建版本的 4EverAble2Shell 探测活动。</p><p><em>（这是一个不断发展的报道。请回来查看更多信息。）</em></p><p>觉得这篇文章有意思吗？在 <a href=\"https://news.google.com/publications/CAAqLQgKIidDQklTRndnTWFoTUtFWFJvWldoaFkydGxjbTVsZDNNdVkyOXRLQUFQAQ\">Google News</a>、<a href=\"https://twitter.com/thehackersnews\">Twitter</a> 和 <a href=\"https://www.linkedin.com/company/thehackernews/\">LinkedIn</a> 上关注我们，阅读我们发布的更多独家内容。</p>","original","zhKind","translation","complete","复现","漏洞利用","漏洞分析","利用链","https://thehackernews.com/2026/11/new-n-central-exploits-work-against.html","The Hacker News",{"_95":96,"_97":-5},"changelogVersion","2026-10-01T08:00","release"]
