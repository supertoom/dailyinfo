[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1795912843000,"id","msk8129yc8fadoi6jreqf6gt2","title","Google Ads 投放虚假 Codex 与 Claude Code 下载页面攻击 Mac 用户","originalTitle","Malicious Google Ads Target Mac Users with Fake Codex and Claude Code Downloads","summary","Cato Networks 发现攻击者通过 Google Ads 投放 Codex、Claude Code 和 Homebrew 的虚假下载广告，利用流量 cloaking 向部分访客展示恶意安装器。","reason","文章还原了 Google 赞助搜索中的虚假下载链路，并披露流量 cloaking、脚本下载及复用基础设施等关键环节。","source",{"_76":103},"links",{"_93":102},"publishedAt","2026-11-23T18:21:45.000Z","discoveredAt","2026-11-23T18:37:36.769Z","timelineAt","category","activity","tags",[79,77,97,98,99,100,101],"score",71,"selected",true,"channel","news","story",{"_89":90,"_13":91},"x","readingMode","full","author","Deeba Ahmed","body",{"_61":92,"_93":-5,"_94":95,"_96":37},"outline",[],"relatedStories",[88],"topics",[68,69,70,71,72,73],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","fSL_Rh0_71Vs","reportCount",1,"additionalSourceCount",0,{"_74":86,"_76":87},{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","malware","name","恶意软件","attack","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","email","邮件与钓鱼","google","Google / 谷歌",{"_89":90,"_13":91},"publicId","4343ed82-d2cf-41af-a210-e770dc69b9ea","Google广告引流macOS恶意下载","<p>Cato Networks 的研究人员调查<a href=\"https://hackread.com/hackers-1campaign-hide-malicious-ads-google-reviewers/\"><strong>恶意 Google 广告</strong></a>时发现，在合法企业的已验证身份下出现了 Codex、Claude Code 和 Homebrew 的虚假下载，这些企业似乎与这些软件毫无关联，且出现在恶意赞助的搜索结果中。</p><p>在与 Hackread.com 分享的研究中，Cato 的研究人员指出，他们在一户健康与营养业务公司的账户主页下截获了一条虚假的 Codex 广告，而该账户同时还在推广该公司自己的产品。这条 Codex 广告中还包含了其健康类推广的措辞。“广告中的不一致之处十分显眼，”Cato Networks 在这篇<a href=\"https://www.catonetworks.com/blog/threat-actors-abuse-suspected-compromised-google-ads-accounts-to-target-developers-with-fake-tools/\"><strong>博客文章</strong></a>中指出。</p><figure><a href=\"https://hackread.com/wp-content/uploads/2026/11/Fake-Google-Ads-Target-Mac-Users-with-Codex-Claude-Code-and-Homebrew-Malware-1.jpg\"><img width=\"1024\" height=\"707\" src=\"/dailyinfo/media/58e13743d6ca391b.jpg\" srcset=\"/dailyinfo/media/793c15c2dbfce677.jpg 720w, /dailyinfo/media/83fcf9b408030e1b.jpg 1200w, /dailyinfo/media/58e13743d6ca391b.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"\"></a><figcaption>截获的 Codex 广告（来源：Cato Networks）</figcaption></figure><p>Cato 认为，攻击者要么对广告主的 Google Ads 账户进行了钓鱼，要么滥用了他们的身份来运行这次活动，这意味着该公司“也可能成为受害者”。</p><p>研究人员追踪了搜索“claude code mac download”时显示的一条 Google 广告，发现它最终导向了一次<a href=\"https://hackread.com/ms-teams-phishing-clickfix-shai-hulud-threat-report/\"><strong>ClickFix 攻击</strong></a>（即用户被诱骗运行恶意命令，从而导致设备被感染）。</p><p>在该案例中，搜索生成了若干广告，将访问者重定向到 parentpreneurxcom，在那里用户被要求将一条命令复制到 macOS Terminal 中以安装软件。</p><p>有意思的是，这一重定向并未向所有人显示相同的页面。通过流量伪装，部分访问者会收到虚假安装程序，部分访问者则看到无害内容，这很可能是为了规避检测。类似的 Google 重定向也指向了虚假的 Homebrew 站点 <code>homebrexwin.com</code> 和 <code>storageprofiler.com</code>。</p><p>Cato 发现部分虚假的 Claude 和 Codex 网站使用了相同的域名。例如，<code>Basequill9.com</code> 同时出现在 Claude 和 Codex 的下载链中。<code>Stride25.com</code> 被用于另一对站点，而两个 Codex 页面则共用 <code>Plume-compass.com</code>。</p><figure><a href=\"https://hackread.com/wp-content/uploads/2026/11/Fake-Google-Ads-Target-Mac-Users-with-Codex-Claude-Code-and-Homebrew-Malware-2.jpg\"><img width=\"1024\" height=\"594\" src=\"/dailyinfo/media/b9747857b8d94649.jpg\" srcset=\"/dailyinfo/media/5689fd8db3f5a43c.jpg 720w, /dailyinfo/media/ccfb79d6707f3487.jpg 1200w, /dailyinfo/media/b9747857b8d94649.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"\"></a><figcaption>被复用的基础设施（来源：Cato Networks）</figcaption></figure><p><a href=\"https://hackread.com/fake-claude-ai-installer-plugx-malware-windows-users/\"><strong>虚假的 Claude 安装程序</strong></a>使用了一个隐藏的 web 地址，从 <code>vine-96.com</code> 获取一个脚本。该脚本一旦通过 macOS 的 zsh shell 运行，就会向 Mac 下载一个名为 helper 的文件，并将活动数据发送至 <code>grove-satin.com</code>。Cato 发现这一过程与一种<strong><a href=\"https://hackread.com/amos-stealer-macos-keychain-files-browser-passwords/\">Atomic macOS Stealer (AMOS)</a></strong>感染方式存在相似之处，但无法确认此次活动中的所有恶意软件都是 AMOS。</p><p>此外还有其他手法。一款虚假的 Codex 下载使用了 TALLY 应用作为诱饵。一个恶意磁盘镜像中包含一个名为 DayNote 的应用，它通过 <code>jsDelivr</code> 从 GitHub 获取进一步的指令。在另一次针对 Claude 的攻击中，攻击者使用 JavaScript for Automation (JXA) 下载了伪装成 <code>Finder.app</code> 的恶意软件。Cato 无法确定这些攻击背后的人是否存在关联。</p><p>Cato 于 2026 年 11 月 6 日开始通知相关服务提供方。Cloudflare 确认已对已报告的 URL 限制访问。截至 11 月 11 日，研究人员检查的 GitHub 仓库和 jsDelivr 资源已无法访问。</p><figure><a href=\"https://hackread.com/wp-content/uploads/2026/11/Fake-Google-Ads-Target-Mac-Users-with-Codex-Claude-Code-and-Homebrew-Malware.jpg\"><img width=\"1024\" height=\"521\" src=\"/dailyinfo/media/e38646928a3aac4c.jpg\" srcset=\"/dailyinfo/media/f0ba2cbb2b40ccee.jpg 720w, /dailyinfo/media/2cb06474aeb8b2fd.jpg 1200w, /dailyinfo/media/e38646928a3aac4c.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"\"></a><figcaption>了解此次攻击（来源：Cato Networks）</figcaption></figure><p>这次活动表明，一次日常的软件搜索可以多么轻易地让用户下载到恶意软件。在这些案例中，攻击者并不需要绕过<strong><a href=\"https://hackread.com/apples-macos-sequoia-update-breaks-security-tools/\">macOS 安全机制</a></strong>。他们依靠的是用户自行按照安装说明操作并运行命令。</p>","original","zhKind","translation","complete","钓鱼","数据窃取","Google","Apple","Cloudflare","https://hackread.com/google-ads-mac-malware-fake-codex-claude-code/","Hackread",{"_105":106,"_107":-5},"changelogVersion","2026-10-01T08:00","release"]
