[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":36,"_57":36,"_58":59,"_60":36,"_61":62},"expiresAt",1795308044000,"id","xa3luvbw2zj4cvxy6ym74713s","title","La Poste 子公司 Maileva 遭网络攻击，2200 万人姓名和邮政地址泄露","originalTitle","Data Breach at La Poste Subsidiary Maileva Affects 22 Million People in France","summary","La Poste 子公司 Maileva 在 9 月中旬遭网络攻击，泄露 2200 万名客户的接收者姓名和邮政地址，受影响者包括患者和租户，多数并非 Maileva 客户。Maileva 称银行信息未被窃取，但攻击者据报读取了部分付款提醒，其中含发票编号、治疗日期和欠款金额；公司已通知 CNIL、提交刑事报案，司法调查正在进行，受影响客户是否通知个人仍待观察。","reason","source",{"_75":103},"links",{"_93":102},"publishedAt","2026-11-15T10:43:16.000Z","discoveredAt","2026-11-15T11:32:31.802Z","timelineAt","category","activity","tags",[76,99,100,101],"score",73,"selected",true,"channel","news","story",{"_84":85,"_13":86},"x","sameEvent",{"_11":97,"_13":98},"readingMode","full","author","Pierluigi Paganini","body",{"_62":92,"_93":-5,"_94":95,"_96":36},"outline",[87],"relatedStories",[83],"topics",[69,70,71,72],"indexable","markdownAvailable","group",{"_63":64,"_65":66,"_67":68},"hasTranslation","bodyLanguage","zh","factId","fHiQfpn0CC4s","reportCount",2,"additionalSourceCount",1,{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","attack","name","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","supply-chain","供应链安全",{"_84":85,"_13":86},"publicId","c5e0f30f-70a6-467f-8b4b-76458043e208","Maileva攻击致2200万人信息泄露",{"_11":88,"_89":90,"_91":66},"sec-1","text","法国邮政集团子公司 Maileva 遭到网络攻击，导致 2200 万人的姓名和邮政地址泄露，其中包括患者和租户。","level","<h2 id=\"sec-1\">法国邮政集团子公司 Maileva 遭到网络攻击，导致 2200 万人的姓名和邮政地址泄露，其中包括患者和租户。</h2><p>法国邮政集团旗下子公司 Maileva 于 9 月中旬遭到攻击，这是法国迄今规模最大的网络攻击之一。法国邮政已向法新社证实此事。</p><p>被盗数据包括 2200 万人的名字、姓氏和邮政地址，这些人是<em>“Maileva 客户公司的收件人</em>”。该公司确认银行详细信息未遭泄露a。专业网站 <a href=\"https://frenchbreaches.com/\">FrenchBreaches</a> 和 <a href=\"https://www.cyberattaque.org/maileva-docaposte-la-poste-cyberattaque/\">Cyberattaque.org</a> 最先发现了此次泄露事件。</p><p><a href=\"https://www.lemonde.fr/pixels/article/2026/11/14/cyberattaque-maileva-filiale-du-groupe-la-poste-annonce-un-vol-de-donnees-touchant-22-millions-de-personnes_6810545_4408996.html\">据《世界报》报道</a>，Maileva 代表企业寄送文件，包括工资单、挂号信、发票和股东会议通知。它是法国邮政旗下 Docaposte 的一部分，并称其服务超过 70,000 名用户。2024 年，它寄出了 1.8 亿份文件。然而，此次泄露影响的 2200 万人并非 Maileva 的客户，而是通过其平台收到文件的人。</p><p>这一点很重要，因为其中大多数人此前从未听说过 Maileva，也与该公司没有直接关系。据 Cyberattaque.org 称，受影响的机构包括 Flandre Opale Habitat 和 Altéal 等社会住房提供商，以及隶属于 Inovie 集团的医学实验室，包括 AXBIO、BioMedilab 和 Biofusion。Suresnes 的 Foch Hospital 患者也因其中一家分包商而受到影响。</p><p>这家分包商是 Kiwee.care，负责善意债务追收和医疗账单，并通过 Maileva 打印和邮寄。据报道，一名黑客读取了部分付款提醒函的内容。这些信件包含发票编号、治疗日期和欠款金额。Kiwee 在医疗领域的其他客户也可能受到影响。</p><p>Maileva 已通知法国数据保护机构 CNIL，并提交了刑事报案。</p><p><em>正在进行司法调查</em>，”该消息称。<em>“根据相关规定，Maileva 已将该事件通知了所有受影响的公司。</em>”</p><p>它还通知了每一家受影响的公司。这些公司是否会将其告知自己的患者和租户，则是另一个问题。</p><p><a href=\"https://securityaffairs.com/186157/hacktivism/pro-russian-group-noname057-claims-cyberattack-on-la-poste-services.html\">La Poste</a> 并不是第一次遭遇网络攻击。2025 年 12 月，<a href=\"https://securityaffairs.com/186157/hacktivism/pro-russian-group-noname057-claims-cyberattack-on-la-poste-services.html\">La Poste 证实</a>一起重大网络安全事件导致其信息系统离线，使数百万客户的数字银行和在线服务中断。</p><p>La Poste 在社交媒体上表示，此次中断导致多个平台暂时无法访问，包括其官方网站、移动应用、数字身份服务以及 Digiposte 文件存储平台。</p><p>此次攻击导致其在线服务暂时中断，包括 La Banque Postale 在线服务及移动应用、laposte.fr、Digiposte、La Poste Digital Identity 和 La Poste 应用程序。</p><p>亲俄黑客组织 <a href=\"https://securityaffairs.com/tag/noname05716\">Noname057</a> <a href=\"https://apnews.com/article/france-cyberattack-postal-service-russia-09bd0156aae99e14e619051756574853\"><strong>声称对此次网络攻击负责</strong></a>。</p><p>近年来，法国面临了多起重大网络攻击。2024 年，Almerys 和 Viamedis 的数据泄露事件暴露了超过 3300 万人的数据，而对 <a href=\"https://securityaffairs.com/160556/data-breach/france-travail-data-breach-34m-people.html\">France Travail</a> 的攻击又影响了另外 3680 万人。据法国经济部表示，2 月，一名黑客利用属于一名政府官员的被盗凭证，<a href=\"https://securityaffairs.com/188200/hacking/french-ministry-confirms-data-access-to-1-2-million-bank-accounts.html\">获取了</a> 120 万个法国银行账户的数据。</p><p>今年6月，法国政府为其公务员开发并于去年强制使用的加密消息平台 Tchap <a href=\"https://securityaffairs.com/193393/security/frances-government-messaging-app-tchap-got-breached.html\">遭到入侵</a>。</p><p>今年夏季，针对税务机关的攻击导致与近 700,000 人相关的数据被攻破。上周，Crédit Mutuel Arkéa 也披露称，一场网络攻击使该公司损失了约 €100 million。</p><p>由于法国在经济上的重要性以及其在乌克兰战争问题上的政治立场，法国仍然是一个颇具吸引力的攻击目标。问题的规模正在扩大：法国数据保护机构（CNIL）记录了 2024 年超过 5,600 起数据泄露事件，比上一年增加了 20%。Maileva 事件再次提醒人们，个人数据可能会通过第三方提供商泄露，而这些提供商甚至可能是人们不知道自己在使用的。</p><p><strong>在 Twitter 上关注我：&nbsp;</strong><a href=\"https://twitter.com/securityaffairs\"><strong>@securityaffairs</strong></a><strong>&nbsp;以及&nbsp;</strong><a href=\"https://www.facebook.com/sec.affairs\"><strong>Facebook</strong></a><strong>&nbsp;以及&nbsp;</strong><a href=\"https://infosec.exchange/@securityaffairs\"><strong>Mastodon</strong></a><strong></strong></p><p><a href=\"http://www.linkedin.com/pub/pierluigi-paganini/b/742/559\"><strong>Pierluigi&nbsp;Paganini</strong></a><strong></strong></p><p><strong>(</strong><a href=\"http://securityaffairs.co/wordpress/\"><strong>SecurityAffairs</strong></a><strong>&nbsp;–&nbsp;黑客、&nbsp;La Poste)</strong></p>","original","zhKind","translation","complete","tdgqf8w4lt1o6t0k55acepssj","La Poste 旗下 Maileva 遭网络攻击，2200 万人姓名和邮政地址泄露","数据泄露","供应链","数据窃取","https://securityaffairs.com/203126/data-breach/data-breach-at-la-poste-subsidiary-maileva-affects-22-million-people-in-france.html","Security Affairs",{"_105":106,"_107":-5},"changelogVersion","2026-10-01T08:00","release"]
