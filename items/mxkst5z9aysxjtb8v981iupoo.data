[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1795308037000,"id","mxkst5z9aysxjtb8v981iupoo","title","SBC Medical Group 两起安全事件暴露 160 万客户及员工数据","originalTitle","Hackers steal data of 1.6 million SBC Medical Group customers","summary","SBC Medical Group 向美国证券交易委员会（SEC）披露，两起入侵暴露其日本业务中的客户、员工及预约诊疗信息。数据库事件涉及 1,624,000 人，泄露内容涵盖姓名、联系方式、出生日期、会员 ID、密码等，另有 255,416 条预约请求、217,769 条网站咨询和约 20,000 条员工账号记录；其中 459 名员工的银行账户及税务信息受影响。","reason","两起入侵涉及客户、员工及预约诊疗数据，披露字段和人数较细，便于相关机构评估通知与合规义务。","source",{"_64":82},"links",{"_75":81},"publishedAt","2026-11-19T22:25:42.000Z","discoveredAt","2026-11-19T22:37:19.481Z","timelineAt","category","activity","tags",[65,79,80],"score",79,"selected",true,"channel","news","story","x","readingMode","full","author","Bill Toulas","body",{"_59":74,"_75":-5,"_76":77,"_78":37},"outline",[68],"relatedStories",[],"topics",[60,61],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_62":66,"_64":67},{"_62":63,"_64":65},"slug","attack","name","攻击活动","identity","身份与访问",{"_11":69,"_70":71,"_72":73},"sec-1","text","发现您现有的防御措施可能遗漏的邮件威胁。","level",2,"<p><img alt=\"Medica Data\" height=\"950\" src=\"/dailyinfo/media/5c5b95bfb523192c.jpg\" srcset=\"/dailyinfo/media/cc5228a6f73acb9d.jpg 720w, /dailyinfo/media/8d98cd26d2d68305.jpg 1200w, /dailyinfo/media/5c5b95bfb523192c.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>SBC Medical Group 在向美国证券交易委员会（SEC）提交的一份文件中警告称，两起网络安全事件暴露了敏感的客户和员工信息，其中包括属于 160 万人的个人数据。</p><p>SBC Medical Group 是一家诊所管理公司，其<a href=\"https://sbc-holdings.com/en/company\">主营业务位于日本</a>，但在美国也有有限的业务布局；其股票以代码 SBC 在 Nasdaq 上市，并持有医疗美容连锁机构 OrangeTwist 的少数股权。其诊所每年接待<a href=\"https://www.sec.gov/Archives/edgar/data/1930313/000119312526459242/sbc-ex99_1.htm\">700 万人次就诊</a>。</p><p>第一起安全事件涉及 SBC 数据库，第二起则涉及未经授权访问第三方预约平台 Tribeau 上的诊所管理员账户。</p><p><a href=\"https://www.wiz.io/lp/ai-threat-readiness-playbook?utm_source=bleepingcomputer&amp;utm_medium=display&amp;utm_campaign=FY27Q2_INB_FORM_AI-Threat-Readiness-Playbook&amp;sfcid=701Vh00000cnU0lIAE&amp;utm_term=FY27Q4-bleepingcomputer-970x250-Nov&amp;utm_content=AITR-Playbook\"><img src=\"/dailyinfo/media/4d5360bd2cfa88d6.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"image\"></a>\n</p><p>公司于 11 月 16 日发现数据库遭到入侵，并在同一天获知 Tribeau 遭到入侵。这两起事件均影响其位于日本的业务。</p><p>“2026 年 11 月 16 日发生未经授权访问，目标是 SBC Medical Group, Ltd. 管理和运营的网站系统内某些数据库；该公司是其日本子公司，与其在日本提供的管理服务相关，”<a href=\"https://www.sec.gov/Archives/edgar/data/1930313/000149315226053135/ex99-1.htm\">一份提交给 SEC 的 FORM 8-K 文件如此写道</a>&nbsp;。</p><p>“公司确认，未经授权的第三方访问并提取了客户信息。入侵方式和完整影响范围仍在调查中。”</p><p>影响 SBC 数据库的事件暴露了属于 1,624,000 人的基本个人信息，包括：</p><ul>\n\t<li>姓名</li>\n\t<li>联系方式</li>\n\t<li>出生日期</li>\n\t<li>患者卡号</li>\n\t<li>会员 ID</li>\n\t<li>密码</li>\n\t<li>调查问卷回复</li>\n</ul><p>上述数据类型并非全部都暴露给全部 160 万人。</p><p>此外，该事件还暴露了 255,416 条预约请求、向 SBC 网站提交的 217,769 条咨询，以及数千条治疗描述记录、图像文件名和客户评价。</p><p>公司表示，攻击者还窃取了大约 20,000 条员工账户记录，包括姓名、ID 和密码。对于其中 459 名员工这一小部分群体，受影响的数据还包括银行账户和税务信息。</p><p>第二起事件涉及 Tribeau 预约平台上的管理员账户；该服务供 56 家诊所使用。</p><p>运营商报告称，12,641 人的预约信息被访问，另有 6,804 名接受治疗人员的治疗名称、日期和费用被访问。</p><p>SBC 指出，在数据库入侵事件中，其尚未确认电子医疗记录或其 mySBC 预约网站中的信息遭到未经授权访问。</p><p>截至 11 月 18 日提交 Form 8-K 时，公司尚未发现任何证据表明暴露的数据被滥用。</p><p>SBC 表示调查仍在进行中，目前无法估算这些网络安全事件造成的财务影响。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">\n            <img src=\"/dailyinfo/media/17b5e88b2b65d47e.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">发现您现有的防御措施可能遗漏的邮件威胁。</a>\n        </h2><p>Adaptive Security 的 AI 智能体通过分析邮件意图、上下文和行为，发现网络钓鱼、商业邮件入侵和发票欺诈。</p><p>对 Microsoft 365 或 Google Workspace 进行为期 14 天的只读扫描，看看有哪些威胁正在穿透，无需更改 MX。</p><p><a href=\"https://www.adaptivesecurity.com/lp/nb/email-scan?utm_source=display_network&amp;utm_medium=paid_display&amp;utm_campaign=2026_NA_Q4_Bleepingcomputer_Inadunit_October2026_scan&amp;utm_id=701Rd00000sqmWCIAY\">开始您的免费邮件安全扫描。</a>\n    </p>","original","zhKind","translation","complete","数据泄露","凭据","https://www.bleepingcomputer.com/news/security/hackers-steal-data-of-16-million-sbc-medical-group-customers/","BleepingComputer",{"_84":85,"_86":-5},"changelogVersion","2026-10-01T08:00","release"]
