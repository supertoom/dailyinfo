[{"_1":2,"_3":4},"root",{"_5":95},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1794616837000,"id","z6sqacicgu5g5kxg4eavs0p1z","title","攻击者利用 Openwave CVE-2026-111793 与 Cisco BroadWorks CVE-2026-20320","originalTitle","Threat Actors Exploit Openwave, Cisco BroadWorks Vulnerabilities","summary","攻击者已利用 Openwave Webtop Media Transcoder 的 CVE-2026-111793 和 Cisco BroadWorks 的 CVE-2026-20320 窃取敏感信息。","reason","两起已获利用的漏洞涉及文档转换绕过与 XML 外部实体注入，攻击范围、补丁版本和处置期限均已明确。","source",{"_69":94},"links",{"_84":93},"publishedAt","2026-11-11T09:01:07.000Z","discoveredAt","2026-11-11T09:06:41.079Z","timelineAt","category","activity","tags",[70,72,88,89,90,74,91,92],"score",83,"selected",true,"channel","news","story","x","readingMode","full","author","Ionut Arghire","body",{"_59":83,"_84":-5,"_85":86,"_87":37},"outline",[],"relatedStories",[],"topics",[60,61,62,63,64,65,66],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_67":81,"_69":82},{"_67":79,"_69":80},{"_67":77,"_69":78},{"_67":75,"_69":76},{"_67":73,"_69":74},{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","attack","name","攻击活动","exploited","在野利用","ai-offense","AI 攻防","black-market","数据窃取与黑产","ransomware","勒索软件","identity","身份与访问","cisco","Cisco / 思科","<p><strong>威胁行为者正在利用 Openwave Webtop Media Transcoder 和 Cisco BroadWorks 中的两个漏洞，以访问敏感信息。</strong>\n\n\n\n</p><p>Openwave Messaging 为通信服务提供商提供电子邮件和消息平台，包括网络邮箱。Webtop Media Transcoder 负责文档转换，而 Openwave 的公告将其与该公司的网络邮箱关联起来。\n\n\n\n</p><p>这个 Webtop Media Transcoder 漏洞的跟踪编号为 CVE-2026-111793，其成因是系统未强制执行管理员定义的文件类型限制，使用户能够转换非预期类型的文件。\n\n\n\n</p><p>Openwave Messaging 在一份公告中解释道：“如果绕过网络邮箱体验，这可能允许已认证用户处理并转换非预期的文档类型。”\n\n\n\n</p><p>Webtop Media Transcoder 1.1.22.0 版本于 2021 年 12 月推出，其中包含补丁。该安全缺陷于 10 月 7 日<a href=\"https://github.com/GISOpenwave/security-advisories-public/blob/main/CAN-2026-2032674.md\">披露</a>，CVE 记录于 10 月 16 日<a href=\"https://nvd.nist.gov/vuln/detail/cve-2026-111793\">发布</a>。\n\n\n\n</p><p><a href=\"https://jvn.jp/en/vu/JVNVU93403064/\">Japan JVN</a> 于 11 月 9 日将该弱点标记为已遭利用，并警告称，已认证攻击者可能利用它上传 specially crafted file，以获取敏感信息。</p><p><span>广告。滚动以继续阅读。</span></p><p>Cisco BroadWorks 漏洞的跟踪编号为 CVE-2026-20320，该漏洞于 8 月 19 日<a href=\"https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-bworks-xxe-uwUd7CEt\">披露</a>，属于带外盲 XML 外部实体注入问题，可被远程利用且无需认证，从而读取敏感的配置信息。\n\n\n\n</p><p>Cisco 在其公告中指出：“此漏洞之所以存在，是因为默认允许解析外部实体，导致 XML 条目被不当解析。攻击者可能通过向 Open Client Interface – Provisioning (OCI-P) 服务发送特制的 XML 消息来利用此漏洞。”\n\n\n\n</p><p>该问题的补丁已包含在 BroadWorks Application Delivery Platform、Application Server、Profile Server 和 Xtended Services Platform 的 RI.2026.07 版本中。\n\n\n\n</p><p>11 月 8 日，Malbear Labs <a href=\"https://malbearlabs.com/posts/operation-snowball-inside-an-autonomous-ai-intrusion-campaign\">警告称</a>，一个讲中文的威胁行为者正在大规模利用该漏洞，此次活动依赖自主 AI 入侵框架，针对一家欧洲电信服务提供商及其客户。\n\n\n</p><p>使用该电信服务提供商服务的至少 13 家组织可能已成为目标。此次活动重点进行资产枚举、凭据窃取，以及订阅者账单和设备记录的收集。\n\n\n</p><p>美国网络安全局 CISA 于 11 月 10 日将 Openwave 和 Cisco 的安全缺陷加入其已知被利用漏洞（<a href=\"https://www.cisa.gov/known-exploited-vulnerabilities-catalog\">KEV</a>）目录，敦促联邦机构在 11 月 24 日前修补这两个漏洞。\n\n\n</p><p>此外，CISA 还将<a href=\"https://www.securityweek.com/recently-patched-barracuda-vulnerabilities-exploited-in-attacks/\">两个 Barracuda 漏洞</a>、一个于本周二修复的 <a href=\"https://www.securityweek.com/exploited-outlook-zero-day-among-1094-flaws-patched-by-microsoft/\">Outlook 零日漏洞</a>，以及一个作为零日漏洞于 11 月 9 日<a href=\"https://www.securityweek.com/chrome-update-patches-exploited-xml-zero-day-eighth-this-year/\">修复</a>的 Chrome 漏洞加入了 KEV 清单。\n\n\n</p><p><strong>相关：</strong> <a href=\"https://www.securityweek.com/n-able-takes-n-central-offline-as-researcher-drops-over-30-zero-days/\">研究人员在披露 30 多个零日漏洞后，N-able 将 N-central 下线</a>\n\n\n</p><p><strong>相关：</strong> <a href=\"https://www.securityweek.com/ibm-aspera-faspex-signalwire-freeswitch-vulnerabilities-exploited-in-attacks/\">IBM Aspera Faspex、SignalWire FreeSwitch 漏洞已在攻击中被利用</a>\n\n\n</p><p><strong>相关：</strong> <a href=\"https://www.securityweek.com/plex2shell-exploited-against-qnap-nas-users/\">QNAP NAS 用户遭到 Plex2Shell 利用</a>\n\n\n</p><p><strong>相关：</strong> <a href=\"https://www.securityweek.com/hackers-exploiting-sshole-authentication-bypass-in-openssh/\">黑客正在利用 OpenSSH 中的 ‘SSHole’ 身份验证绕过漏洞</a>\n\n\n</p>","original","zhKind","translation","complete","漏洞利用","数据窃取","凭据","Cisco","CISA","https://www.securityweek.com/threat-actors-exploit-openwave-cisco-broadworks-vulnerabilities/","SecurityWeek",{"_96":97,"_98":-5},"changelogVersion","2026-10-01T08:00","release"]
