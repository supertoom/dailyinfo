[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795135234000,"id","an7isdpcmcy8domsaf6bos04j","title","NATS Server MQTT CONNECT 解析漏洞可致未认证内存耗尽","originalTitle","NATS Server allows unauthenticated memory exhaustion through incomplete MQTT CONNECT packets","summary","NATS Server v2.14.2、v2.12.11 及以下版本存在未认证内存耗尽漏洞。未认证的 MQTT 客户端可发送不完整的 CONNECT 数据包，使服务器在认证完成前持续保留部分预认证数据并消耗内存，直至认证超时关闭连接。该问题已在 v2.14.3 和 v2.12.12 中修复，不使用 MQTT 的部署不受影响，需要 MQTT 的部署应升级至修复版本。","reason","source",{"_69":81},"links",{"_59":80},"publishedAt","2026-11-20T00:04:46.000Z","discoveredAt","2026-11-20T00:23:20.222Z","timelineAt","category","vuln","tags",[77,78,79],"score",58,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","f2hwuYgIfjjg","reportCount",1,"additionalSourceCount",0,{"_68":71,"_69":72},{"_68":30,"_69":70},"slug","name","漏洞披露","iot","IoT 与车联网",{"_74":75,"_13":76},"publicId","05fa29fa-a024-4ad4-951b-efbc0abad415","NATS Server披露未认证内存耗尽漏洞","漏洞","补丁","IoT","https://github.com/advisories/GHSA-r72h-j7qq-v6qg","GitHub 安全公告",{"_83":84,"_85":-5},"changelogVersion","2026-10-01T08:00","release"]
