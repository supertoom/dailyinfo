[{"_1":2,"_3":4},"root",{"_5":99},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":-5,"_57":37,"_58":59},"expiresAt",1794962440000,"id","j7nnva1vm6p3lhh17mhlx0wfn","title","FBI 披露 ARTEX AI 框架将攻击提权时间压缩至 3 小时以内","originalTitle","FBI Says ARTEX AI Tool Helped Hackers Gain Privileged Access in Under 3 Hours","summary","FBI 称，攻击者自 2026 年 8 月起使用开源 AI 框架 ARTEX 攻击全球金融服务、政府、科技、国防、医疗、半导体、能源、制造、电信和法律服务等行业，可借助多个 AI agents 自动完成目标发现、弱点检查、漏洞利用和数据外传，部分攻击在不到 3 小时内获得特权访问。","reason","材料将 ARTEX 串联目标发现、漏洞利用和数据窃取的攻击链，与 ConnectWise 供应链入侵及登录尝试等实际事件相对应。","source",{"_67":98},"links",{"_87":97},"publishedAt","2026-11-17T16:51:49.000Z","discoveredAt","2026-11-17T17:18:39.422Z","timelineAt","category","activity","tags",[68,72,91,92,70,93,94,95,96],"score",82,"selected",true,"channel","news","story","x","readingMode","full","author","Deeba Ahmed","body",{"_59":86,"_87":-5,"_88":89,"_90":37},"outline",[77,78],"relatedStories",[],"topics",[60,61,62,63,64],"indexable","markdownAvailable","group","hasTranslation","bodyLanguage","zh",{"_65":75,"_67":76},{"_65":73,"_67":74},{"_65":71,"_67":72},{"_65":69,"_67":70},{"_65":66,"_67":68},"slug","attack","name","攻击活动","exploited","在野利用","ai-offense","AI 攻防","ai-agent","AI Agent 安全","supply-chain","供应链安全",{"_11":84,"_80":85,"_82":83},{"_11":79,"_80":81,"_82":83},"sec-2","text","移除原始工具并未终结其使用","level",3,"sec-1","问题不止于更快的攻击","<p>美国联邦调查局（FBI）正就一个新框架 ARTEX 发出警告，该框架可自动完成网络攻击的多个阶段，从寻找目标到窃取数据。</p><p>在 11 月 13 日发布的 Flash Advisory 中，美国联邦调查局（<a href=\"https://hackread.com/tag/FBI/\">FBI</a>）表示，自至少 2026 年 8 月以来，网络犯罪分子一直在使用这一开源框架，针对全球各地的组织。被针对的行业包括金融服务、政府、科技、国防、医疗保健、半导体、能源、制造、电信和法律服务。</p><p>一起已确认的事件涉及对 ConnectWise Cloud Backup 的供应链入侵，使攻击者得以访问超过 2,250 个下游租户。</p><p>ARTEX 使用 Go 编写，可连接至 <a href=\"https://research.checkpoint.com/2026/hacking-on-autopilot-inside-artex-cybercrime-campaigns/\">DeepSeek、Claude 和 GPT</a> 等外部大语言模型（LLM）。它的不同之处在于使用专门的 AI 智能体，在操作人员设定目标后分别处理不同任务。这些智能体能够识别目标、检查系统弱点、利用漏洞并窃取数据，几乎无需人工参与。</p><p>FBI 表示（<a href=\"https://www.ic3.gov/CSA/2026/261113.pdf\">PDF</a>），部分攻击从最初选定目标到获得特权访问用时不到三小时；由于 DeepSeek Flash 模型成本相对较低，且没有可观察到的渗透测试安全护栏，因此在攻击者中尤受欢迎。</p><figure><a href=\"https://hackread.com/wp-content/uploads/2026/11/fbi-artex-framework-automates-cyberattacks-privileges.png\"><img width=\"1024\" height=\"768\" src=\"/dailyinfo/media/7352db60c5e1782d.webp\" srcset=\"/dailyinfo/media/0b17c43551a35718.webp 720w, /dailyinfo/media/151174f07a9ef2e5.webp 1200w, /dailyinfo/media/7352db60c5e1782d.webp 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" alt=\"\"></a></figure><h3 id=\"sec-1\"><strong>问题不止于更快的攻击</strong></h3><p>一些借助 ARTEX 的入侵在不到三小时内便获得了特权访问。这让安全团队几乎没有时间调查入侵事件，攻击者就已进一步深入网络。ConnectWise 事件表明，这可能会影响其他组织。</p><p>微软对 Artex 的<a href=\"https://www.microsoft.com/en-us/security/blog/2026/10/21/storm-0940-uses-artex-agentic-ai-connectwise-supply-chain-compromise/\">调查</a>将该活动与 Storm-0940 这一与中国有关联的威胁组织联系起来。在入侵 ConnectWise 应用后，攻击者利用获得的访问权限将目标转向客户环境。微软还记录到，在一场相关行动期间出现了超过 151,000 次登录失败尝试，活动高峰期达到每分钟 2,900 次尝试。</p><p>FBI 还<a href=\"https://thenextweb.com/news/crowdstrike-south-korea-bank-hack-suspect-china\">重点提及</a>了针对韩国金融机构的攻击，约 67,000 人的个人信息被盗。受影响的银行<a href=\"https://view.asiae.co.kr/en/article/2026100608165324088\">包括</a>新韩、KB 国民、Hana、釜山银行、BNK、Hyundai Capital、Yegaram Savings Bank 和 Welcome Savings Bank 等。</p><p>这些发现凸显了攻击者使用 AI 方式的逐渐变化。Hackread.com 此前曾报道过一场<a href=\"https://hackread.com/hackers-use-ai-agents-exploit-papercut-zero-days/\">PaperCut 攻击行动</a>，其中数百个 AI 智能体帮助攻击者开发、排查并扩大对两个零日漏洞的利用规模。ARTEX 将多个攻击阶段整合到单一框架中，进一步减少了在各阶段之间转换所需的工作量。</p><p>谷歌的威胁情报团队也<a href=\"https://hackread.com/google-ai-agent-turning-security-patches-exploits/\">报告过</a>对其他智能体框架的恶意使用，包括 CAIRN 和 PentAGI。其调查结果表明，这些行动可能较为嘈杂且相对不复杂，但凭借速度和规模仍然能够取得成功。</p><h3 id=\"sec-2\"><strong>移除原始工具并未终结其使用</strong></h3><p>ARTEX 的开发者 Autumn-27 在收到滥用报告后，于 2026 年 10 月 8 日移除了原始的 GitHub 仓库。但其副本、社区分支以及名为 ARTEX PRO 的商业版本仍然可用；截至 11 月初，已识别出超过 1,600 个公开暴露的 ARTEX 控制台。</p><p>FBI 正在寻求身份验证记录、API 活动、云日志以及其他与 ARTEX 相关攻击的证据。</p><p>FBI 的调查发现也引发了人们对组织如何管理暴露的系统、凭据以及供应商之间访问权限的担忧。BeyondTrust 首席安全顾问 Morey J. Haber 向 Hackread.com 表示，ARTEX 改变了将发现的弱点转化为可用攻击所需的时间和专业技能。</p><p>“然而，事实并非 AI 开发出了新的漏洞利用程序或零日漏洞。真正改变的是从发现弱点到将其武器化之间的时间壁垒和专业技能壁垒被打破。威胁行为者早就知道，最薄弱的环节并不总在旗舰应用上。一次成功的入侵可能发生在合作伙伴门户、旧有服务、后端移动应用，或者被遗忘的第三方集成中。直到现在，发现并串联这些依赖关系都需要付出努力、时间和专业技能。ARTEX 将这些概念工业化了。”</p><p>Haber 还警告称，组织应更加密切地关注应用程序和自动化服务所使用的身份与凭据，而不仅仅是员工账户。</p><p>“ARTEX 与其说是破门而入，不如说是在使用它随手找到的密钥登录，包括无人监控或已被遗忘的机器身份和服务账户。而且，由于它会映射组织之间的信任关系，你的安全风险强度只取决于最薄弱的供应商。简而言之，其影响范围远远超出你自己的边界。”</p>","original","zhKind","translation","complete","大模型","Agent 安全","供应链","Microsoft","Google","CISA","https://hackread.com/fbi-artex-ai-tool-hackers-gain-privileged-access/","Hackread",{"_100":101,"_102":-5},"changelogVersion","2026-10-01T08:00","release"]
