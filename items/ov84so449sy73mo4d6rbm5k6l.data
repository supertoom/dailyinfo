[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794530489000,"id","ov84so449sy73mo4d6rbm5k6l","title","Astro @astrojs/svelte 反射型 XSS 漏洞影响 5.7.3 至 9.1.1","originalTitle","Astro: Reflected XSS via unescaped slot names in @astrojs/svelte","summary","`@astrojs/svelte` 在服务端渲染及客户端 hydration 中未对插槽名进行 HTML 转义，含 `\"` 的请求参数可注入任意 HTML。漏洞仅在请求输入被用作插槽名、组件使用 `client:*` 指令 hydration，且 Svelte 5 组件按动态名称渲染对应插槽时触发，可导致站点源上的 JavaScript 执行。","reason","source",{"_69":81},"links",{"_59":80},"publishedAt","2026-11-12T22:34:04.000Z","discoveredAt","2026-11-12T22:36:23.892Z","timelineAt","category","vuln","tags",[77,78,79,72],"score",49,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","flekkf-V7nWA","reportCount",1,"additionalSourceCount",0,{"_68":71,"_69":72},{"_68":30,"_69":70},"slug","name","漏洞披露","browser","浏览器",{"_74":75,"_13":76},"publicId","635b9310-f26f-4ace-8195-14fd12365dca","Astro Svelte插槽名XSS已修复","漏洞","补丁","复现","https://github.com/advisories/GHSA-f4j9-crrj-867q","GitHub 安全公告",{"_83":84,"_85":-5},"changelogVersion","2026-10-01T08:00","release"]
