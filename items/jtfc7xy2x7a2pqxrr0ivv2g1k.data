[{"_1":2,"_3":4},"root",{"_5":99},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":37,"_56":37,"_57":58,"_59":37,"_60":61},"expiresAt",1794616829000,"id","jtfc7xy2x7a2pqxrr0ivv2g1k","title","CISA确认攻击者正在利用Brotli漏洞CVE-2026-111497","originalTitle","CISA warns of hackers now exploiting critical Node2Shell flaw","summary","攻击者正在利用Brotli远程代码执行漏洞CVE-2026-111497。该严重漏洞源于Brotli解码器的越界写入，未认证攻击者可利用恶意压缩流造成崩溃、内存泄露或RCE。CISA已将其纳入KEV，要求美国联邦机构在11月10日前完成修复，并建议其他网络防守者优先打补丁，无法立即更新的系统可阻断入站Brotli压缩请求或禁用该解码功能。","reason","CISA已确认该漏洞遭到利用并纳入KEV，文中还给出联邦机构修复期限与临时阻断Brotli请求的方法。","source",{"_73":98},"links",{"_89":97},"publishedAt","2026-10-28T10:46:23.000Z","discoveredAt","2026-10-28T11:04:43.268Z","timelineAt","category","vuln","tags",[93,74,94,77,95,96],"score",83,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","Sergiu Gatlan","body",{"_61":88,"_89":-5,"_90":91,"_92":37},"outline",[82],"relatedStories",[78],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","zh","factId","f7UE3Y2iyt8I","reportCount",1,"additionalSourceCount",0,{"_71":76,"_73":77},{"_71":31,"_73":75},{"_71":72,"_73":74},"slug","exploited","name","在野利用","漏洞披露","cisa","CISA",{"_79":80,"_13":81},"publicId","7c28657e-31de-4920-a954-1af1b284351f","CISA确认Brotli漏洞遭在野利用",{"_11":83,"_84":85,"_86":87},"sec-1","text","攻击者一旦拥有有效凭据，其操作仅有 37% 会被阻止","level",2,"<p><img alt=\"CISA\" height=\"900\" src=\"/dailyinfo/media/b6a641577c7e1e97.jpg\" srcset=\"/dailyinfo/media/7bc59bc604865d1d.jpg 720w, /dailyinfo/media/72ea5695c4a36cd6.jpg 1200w, /dailyinfo/media/b6a641577c7e1e97.jpg 1600w\" sizes=\"(min-width: 1536px) 760px, (min-width: 1024px) calc(100vw - 524px), (min-width: 640px) 608px, calc(100vw - 32px)\" loading=\"lazy\" decoding=\"async\" width=\"1600\"></p><p>周二，美国网络安全和基础设施安全局（CISA）确认，黑客已开始利用 Brotli 的一个严重漏洞，该漏洞被称为&nbsp;<a href=\"https://www.imperva.com/blog/node2shell-from-brotli-data-to-remote-code-execution/\">Node2Shell</a>、<a href=\"https://broccoli2shell.com/\">Broccoli2Shell</a> 和 <a href=\"https://www.aikido.dev/blog/python-packages-vulnerable-node2shell-brotli-cve-2026-111497\">HTTP2Shell</a>。</p><p>该漏洞被追踪为 <a href=\"https://nvd.nist.gov/vuln/detail/cve-2026-111497\">CVE-2026-111497</a>，严重程度为严重，源于 Brotli 解码器中的越界写入弱点；该解码器用于解压使用 Google 广泛使用的 Brotli 无损压缩算法压缩的数据。</p><p>无权限攻击者可以使用恶意构造的 Brotli 压缩流，触发崩溃或内存泄漏，并且在某些情况下，可以在运行存在漏洞的 Brotli 库或二进制文件的设备上<a href=\"https://www.bleepingcomputer.com/news/security/critical-http2shell-brotli-vulnerability-triggers-emergency-patches/\">获得远程代码执行</a>。</p><p>该安全问题<a href=\"https://www.bleepingcomputer.com/news/security/critical-http2shell-brotli-vulnerability-triggers-emergency-patches/\">最初是在</a> Node.js JavaScript 运行时环境中发现的，但也会影响依赖存在漏洞的 Brotli 实现的 HTTP 服务器和客户端。</p><p>周日，Microsoft 还推送了一项<a href=\"https://www.bleepingcomputer.com/news/microsoft/microsoft-releases-emergency-net-patches-for-critical-brotli-flaw/\">紧急 .NET 安全更新</a>，警告称攻击者可能利用此漏洞在运行存在漏洞的 .NET 版本的系统上提升权限。</p><p>CISA 周二<a href=\"https://www.cisa.gov/news-events/alerts/2026/10/27/cisa-adds-two-known-exploited-vulnerabilities-catalog\">将该漏洞添加</a>至其<a href=\"https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2026-111497\">已知被利用漏洞（KEV）目录</a>，并依据其具有约束力的操作指令（BOD）26-04，命令美国政府机构在两周内、即 11 月 10 日前完成系统修补。</p><p>它表示：“Google Brotli 存在一个未检查返回值的漏洞，远程未经身份验证的攻击者可以利用精心构造的 Brotli 压缩流，破坏相邻解码器状态的内存、泄露敏感内存内容、造成拒绝服务，或可能执行任意代码。”</p><p>“这类漏洞是恶意网络行为者常用的攻击途径，并对联邦企业构成重大风险。”</p><p>虽然 CISA 的 BOD 26-04 仅适用于联邦机构，但这家网络安全机构敦促所有网络防御人员优先修补此安全漏洞，以阻止传入的攻击。</p><p>无法立即应用更新的安全团队应在代理或防火墙层面阻止传入的 Brotli 压缩请求，或者禁用 Brotli 解码功能，直至能够完成更新。</p><p>完成修补后，管理员还必须重启受影响的进程，并重新构建和重新部署受影响的容器镜像。</p><p><a href=\"https://hubs.li/Q04sB3fb0\">\n            <img src=\"/dailyinfo/media/c5fe26ce6c71d6d9.jpg\" loading=\"lazy\" decoding=\"async\" alt=\"article image\">\n        </a>\n    </p><h2 id=\"sec-1\">\n            <a href=\"https://hubs.li/Q04sB3fb0\">攻击者一旦拥有有效凭据，其操作仅有 37% 会被阻止</a>\n        </h2><p>总体预防评分可能掩盖初始访问之后发生的情况。一旦攻击者开始使用有效凭据，预防效果就会大幅下降。</p><p>Blue Report 2026 在客户生产环境中运行的 3.38 亿次模拟中，逐项衡量了各项防御技术。</p><p><a href=\"https://hubs.li/Q04sB3fb0\">获取报告</a>\n    </p>","original","zhKind","translation","complete","漏洞","补丁","Google","Microsoft","https://www.bleepingcomputer.com/news/security/cisa-warns-of-hackers-now-exploiting-critical-node2shell-flaw/","BleepingComputer",{"_100":101,"_102":-5},"changelogVersion","2026-10-01T08:00","release"]
