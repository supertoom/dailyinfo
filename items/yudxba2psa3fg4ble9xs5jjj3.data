[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":36,"_55":56,"_57":58,"_59":36,"_60":61},"expiresAt",1795394445000,"id","yudxba2psa3fg4ble9xs5jjj3","title","President Trump 任命 Kirsten Davies 为 National Cyber Director","originalTitle","President Trump Taps Kirsten Davies as National Cyber Director","summary","President Trump 任命 Department of War CIO Kirsten Davies 出任 National Cyber Director，接替 Sean Cairncross。","reason","source",{"_71":84},"links",{"_61":83},"publishedAt","2026-11-21T13:00:00.000Z","discoveredAt","2026-11-22T01:42:45.605Z","timelineAt","category","policy","tags",[81,82,72],"score",24,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","SecurityWeek News","body",{"_77":-5,"_61":78,"_79":-5,"_80":36},"outline",[],"relatedStories",[73],"topics",[68],"indexable","markdownAvailable",true,"group",{"_62":63,"_64":65,"_66":67},"hasTranslation","bodyLanguage","original","factId","f0qB8AP5pu_w","reportCount",1,"additionalSourceCount",0,{"_69":70,"_71":72},"slug","ai-security","name","AI 安全",{"_74":75,"_13":76},"publicId","1b4bc568-ac18-4f6e-9ce5-fb9ce9d6662c","Davies获任美国国家网络总监","zh","<p><strong>Kirsten Davies, currently Chief Information Officer at the Department of War, has been <a href=\"https://www.whitehouse.gov/releases/2026/11/president-trump-taps-pentagon-cyber-chief-kirsten-davies-as-national-cyber-director/\">appointed</a> as the new National Cyber Director.</strong>\n\n\n\n</p><p>Sworn in as DOW’s CIO in December 2025, Davies will replace Sean Cairncross, who was <a href=\"https://www.securityweek.com/sean-cairncross-confirmed-by-senate-as-national-cyber-director/\">confirmed</a> as the top cybersecurity official in August 2025, more than five months after being <a href=\"https://www.securityweek.com/sean-cairncross-is-trump-nominee-for-national-cyber-director/\">nominated</a> for the position.\n\n\n\n</p><p>Before her DOW tenure, Davies led cybersecurity at multiple organizations. She served as CISO at Unilever, The Estée Lauder Companies Inc., Hewlett-Packard, and Siemens, and as CSO at Barclays, and founded and was the CEO of the Institute for Cyber.\n\n\n\n</p><p>“Our nation stands in the crossroad of analog, digital, and quantum technologies, our American way of living increasingly interconnected. Our opportunity is to dominate the cyber landscape for generations to come …but only if we modernize and drive resilience into the foundations our great nation runs on, as well as build cyber talent for our future,” Davies <a href=\"https://x.com/_KirstenDavies_/status/2123595758465089690\">said</a> on X.\n\n\n\n</p><p>“The Department congratulates Kirsten Davies on her new role as the National Cyber Director. Throughout her tenure at DOW, she has proven herself to be a dedicated patriot and professional, and we are confident she will advance President Trump’s America First agenda across the cybersecurity landscape,” Secretary of War Pete Hegseth said in an X <a href=\"https://x.com/SecWar/status/2123594274721644701\">post</a>.\n\n\n\n</p><p>Her appointment comes amid a series of outages across the US, some with worldwide impact, and a surge in AI-assisted attacks.</p><p><span>Advertisement. Scroll to continue reading.</span></p><p>Microsoft’s 365 services, including Outlook and Teams, <a href=\"https://www.securityweek.com/microsoft-365-outage-disrupts-outlook-exchange-online-and-teams/\">went down</a> on November 12, affecting government and private organizations across the globe. The company said it was a technical issue and <a href=\"https://www.securityweek.com/microsoft-rules-out-cyberattack-in-outage-warns-of-phishing-campaign/\">ruled out a cyberattack</a>.\n\n\n\n</p><p>On November 13, the Federal Aviation Administration (FAA) <a href=\"https://www.securityweek.com/faa-ground-stop-issued-due-to-extraordinary-circumstances/\">issued a ground stop</a>, disrupting thousands of flights. Officials <a href=\"https://www.securityweek.com/no-signs-of-hacking-in-faa-ground-stop-as-fbi-reportedly-probes-software-update/\">blamed communication system failures</a> on patches and new technology that overwhelmed the older system.\n\n\n\n</p><p>This week, JPMorgan Chase experienced a technical issue that impacted the financial system, United Airlines delayed departing flights due to an internal systems outage, and NSANet, a classified internal network the National Security Agency uses to communicate classified information, <a href=\"https://www.securityweek.com/classified-communications-network-at-the-national-security-agency-goes-down-defense-official-says/\">experienced an outage</a> blamed on “scheduled routine maintenance”.\n\n\n\n</p><p>The outages occurred amid an <a href=\"https://www.securityweek.com/ai-framework-autonomously-weaponized-flaws-in-real-attacks-google-says/\">increase in AI-assisted cyberattacks</a>, mainly powered by the Chinese agentic AI penetration testing framework Artex, and many have been wondering if there is a connection between them.\n\n\n\n</p><p>The Trump Administration <a href=\"https://www.whitehouse.gov/releases/2026/11/no-indication-of-a-cyberattack-dni-clayton-and-secretary-rubio-on-recent-tech-outages/\">has said</a> there is “no indication of a coordinated cyberattack, state-sponsored activity, or malign actor behind the recent tech outages.”&nbsp;\n\n\n\n</p><p>Director of National Intelligence Jay Clayton and Secretary of State and National Security Adviser Marco Rubio <a href=\"https://www.whitehouse.gov/releases/2026/11/no-indication-of-a-cyberattack-dni-clayton-and-secretary-rubio-on-recent-tech-outages/\">explained that the incidents were not related</a> and stemmed from companies patching vulnerabilities and upgrading outdated systems.\n\n\n\n</p><p><strong>Related:</strong> <a href=\"https://www.securityweek.com/european-commission-confirms-ai-assisted-cyberattack-disrupted-services/\">European Commission Confirms AI-Assisted Cyberattack Disrupted Services</a>\n\n\n\n</p><p><strong>Related:</strong> <a href=\"https://www.securityweek.com/trump-administration-moves-to-block-china-from-indirect-access-to-american-ai-technology/\">Trump Administration Moves to Block China From Indirect Access to American AI Technology</a>\n\n\n\n</p><p><strong>Related:</strong> <a href=\"https://www.securityweek.com/pentagon-renames-cdao-super-intelligence-office/\">Pentagon Renames CDAO ‘Super Intelligence Office’</a>\n\n\n\n</p><p><strong>Related:</strong> <a href=\"https://www.securityweek.com/barracuda-hacked-amid-surge-in-artex-powered-cyberattacks/\">Barracuda Hacked Amid Surge in Artex-Powered Cyberattacks</a>\n      </p>","zhKind","complete","治理","行业动态","https://www.securityweek.com/president-trump-taps-kirsten-davies-as-national-cyber-director/","SecurityWeek",{"_86":87,"_88":-5},"changelogVersion","2026-10-01T08:00","release"]
