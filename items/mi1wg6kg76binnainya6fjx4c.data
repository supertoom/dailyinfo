[{"_1":2,"_3":4},"root",{"_5":117},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1795740041000,"id","mi1wg6kg76binnainya6fjx4c","title","Veeam 多项产品存在远程代码执行漏洞，涉及 5 个 CVE","originalTitle","Multiples vulnérabilités dans les produits Veeam (26 novembre 2026)","summary","CERT-FR 通报 Veeam 多项产品存在可导致远程代码执行（RCE）的漏洞，涉及 CVE-2026-113425、CVE-2026-121810、CVE-2026-123007、CVE-2026-123633 和 CVE-2026-123634。","reason","source",{"_70":116},"links",{"_60":115},"publishedAt","2026-11-26T00:00:00.000Z","discoveredAt","2026-11-26T15:34:20.786Z","timelineAt","category","vuln","tags",[109,110,111,112,113,114],"score",51,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body",{"_105":-5,"_60":106,"_107":-5,"_108":36},"outline",[78,79,80,81,82,83,84,85],"relatedStories",[74],"topics",[67,68],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fq5VJmsDjW70","reportCount",1,"additionalSourceCount",0,{"_69":72,"_70":73},{"_69":30,"_70":71},"slug","name","漏洞披露","supply-chain","供应链安全",{"_75":76,"_13":77},"publicId","011abec2-1757-49ba-b752-8ce2d9b27037","CERT-FR披露Veeam五个远程代码执行漏洞",{"_11":103,"_87":104,"_89":90},{"_11":101,"_87":102,"_89":90},{"_11":99,"_87":100,"_89":90},{"_11":97,"_87":98,"_89":90},{"_11":95,"_87":96,"_89":90},{"_11":93,"_87":94,"_89":90},{"_11":91,"_87":92,"_89":90},{"_11":86,"_87":88,"_89":90},"sec-8","text","Gestion détaillée du document","level",2,"sec-7","Documentation","sec-6","Solutions","sec-5","Résumé","sec-4","Systèmes affectés","sec-3","Risque","sec-2","Gestion du document","sec-1","Avis du CERT-FR","zh","<h2 id=\"sec-1\">Avis du CERT-FR</h2><p>Objet : Multiples vulnérabilités dans les produits Veeam</p><h2 id=\"sec-2\">Gestion du document</h2><table>\n      <tbody>\n        <tr>\n          <th>Référence</th>\n          <td>CERTFR-2026-AVI-1629</td>\n        </tr>\n        <tr>\n          <th>Titre</th>\n          <td>Multiples vulnérabilités dans les produits Veeam</td>\n        </tr><tr>\n            <th>Date de la première version</th><td>26 novembre 2026</td>\n          </tr>\n          <tr>\n            <th>Date de la dernière version</th><td>26 novembre 2026</td>\n          </tr><tr>\n          <th>Source(s)</th>\n          <td>Bulletin de sécurité Veeam kb4976 du 20 novembre 2026<br></td>\n        </tr>\n      </tbody>\n    </table><p>Une gestion de version détaillée se trouve à la fin de ce document.</p><h2 id=\"sec-3\">Risque</h2><ul>\n          \n            <li>Exécution de code arbitraire à distance</li>\n          \n        </ul><h2 id=\"sec-4\">Systèmes affectés</h2><ul>\n          \n            <li>Veeam Backup for Salesforce versions 3.2.1 sans le dernier correctif de sécurité</li>\n          \n            <li>Veeam Infrastructure Appliance versions 13.1 sans le dernier correctif de sécurité</li>\n          \n            <li>Veeam Plug-In for AWS sans les derniers correctifs de sécurité</li>\n          \n            <li>Veeam Plug-In for Google Cloud sans les derniers correctifs de sécurité</li>\n          \n            <li>Veeam Plug-In for Microsoft Azure appliances sans les derniers correctifs de sécurité</li>\n          \n            <li>Veeam Software Appliance versions 13.1 sans le derniers correctif de sécurité</li>\n          \n        </ul><h2 id=\"sec-5\">Résumé</h2><p>De multiples vulnérabilités ont été découvertes dans les produits Veeam. Elles permettent à un attaquant de provoquer une exécution de code arbitraire à distance.</p><p>L'éditeur fournit également une mesure de contournement provisoire.</p><h2 id=\"sec-6\">Solutions</h2><p>Se référer au bulletin de sécurité de l'éditeur pour l'obtention des correctifs (cf. section Documentation).</p><h2 id=\"sec-7\">Documentation</h2><ul>\n          \n          \n            <li>\n              <p>Bulletin de sécurité Veeam kb4976 du 20 novembre 2026</p>\n              <a href=\"https://www.veeam.com/kb4976\">https://www.veeam.com/kb4976</a>\n            </li>\n          \n\n          \n          \n\n          \n            <li>\n              <p>Référence CVE CVE-2026-113425</p>\n              <a href=\"https://www.cve.org/CVERecord?id=CVE-2026-113425\">https://www.cve.org/CVERecord?id=CVE-2026-113425</a>\n            </li>\n          \n            <li>\n              <p>Référence CVE CVE-2026-121810</p>\n              <a href=\"https://www.cve.org/CVERecord?id=CVE-2026-121810\">https://www.cve.org/CVERecord?id=CVE-2026-121810</a>\n            </li>\n          \n            <li>\n              <p>Référence CVE CVE-2026-123007</p>\n              <a href=\"https://www.cve.org/CVERecord?id=CVE-2026-123007\">https://www.cve.org/CVERecord?id=CVE-2026-123007</a>\n            </li>\n          \n            <li>\n              <p>Référence CVE CVE-2026-123633</p>\n              <a href=\"https://www.cve.org/CVERecord?id=CVE-2026-123633\">https://www.cve.org/CVERecord?id=CVE-2026-123633</a>\n            </li>\n          \n            <li>\n              <p>Référence CVE CVE-2026-123634</p>\n              <a href=\"https://www.cve.org/CVERecord?id=CVE-2026-123634\">https://www.cve.org/CVERecord?id=CVE-2026-123634</a>\n            </li>\n          \n        </ul><h2 id=\"sec-8\">Gestion détaillée du document</h2><table>\n          <thead>\n            <tr>\n              <th>Date</th>\n              <th>Description</th>\n            </tr>\n          </thead>\n          <tbody><tr>\n              <td>26 novembre 2026</td>\n              <td>Version initiale</td>\n            </tr></tbody>\n        </table>","zhKind","complete","漏洞","补丁","供应链","AWS","Google","Microsoft","https://www.cert.cyber.gouv.fr/avis/CERTFR-2026-AVI-1629/","CERT-FR",{"_118":119,"_120":-5},"changelogVersion","2026-10-01T08:00","release"]
