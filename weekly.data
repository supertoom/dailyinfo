[{"_1":2,"_3":4},"root",{"_5":243},"weekly-latest",{"_5":6},"data",{"_7":8,"_9":10,"_11":12,"_13":14,"_15":16},"kind","weekly","report",{"_7":8,"_20":29,"_22":30,"_24":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":26,"_54":-5},"index",[17,18,19],"today","2026-11-18","expiresAt",1794962457000,{"_20":29,"_22":30,"_24":31},{"_20":26,"_22":27,"_24":28},{"_20":21,"_22":23,"_24":25},"key","2026-W44","issueNumber",1,"title","Binance 遭遇约 63 亿美元加密货币盗窃，TRM 归因 TraderTraitor","2026-W45",2,"APT29 关联黑客劫持 Plerdy SEO Tracker 投递 iOS 与 Android 利用链","2026-W46",3,"攻击者利用 PHP2Shell 入侵 Check Point 网关并部署 VMware ESXi 数据擦除器","DailyInfo 周报 · 2026-W46","generatedAt","2026-11-16T02:00:14.268Z","lead",{"_24":31,"_242":40},"leadItemId","h9lynekay3g8pb2185is1c37g","overview","本周 20 条安全要闻，最受关注的是：攻击者利用 PHP2Shell 入侵 Check Point 网关并部署 VMware ESXi 数据擦除器；攻击者利用 4,837 个劫持 GitHub 账户在 1,806+ 个仓库运行 CI 密钥窃取器；Chrome XML 双重释放漏洞 CVE-2026-125350 已被在野利用。","highlights",[239,240,241],"sections",[67,68,69,70],"flashes",[],"cover",{"_60":61,"_62":63,"_64":-5,"_65":-5,"_66":-5},"metrics",{"_55":56,"_57":58,"_59":52},"readingMinutes",7,"prev","next","totalStories",20,"selectedCount",147,"reportsCovered","url","/dailyinfo/media/d54ee90f536362e2.jpg","srcSet","/dailyinfo/media/51cb3171b458e1f8.jpg 720w, /dailyinfo/media/f8b20ffcf44da759.jpg 1200w, /dailyinfo/media/d54ee90f536362e2.jpg 1600w","width","height","caption",{"_71":203,"_73":-5,"_74":204},{"_71":106,"_73":-5,"_74":107},{"_71":95,"_73":-5,"_74":96},{"_71":72,"_73":-5,"_74":75},"label","AI 安全","summary","items",[76],{"_77":78,"_24":79,"_73":80,"_81":82,"_83":84,"_85":86,"_87":88,"_89":90,"_91":92,"_93":94},"itemId","qeruuzfjoy6z4m589atx262j4","Cisco Talos 发现 ARTEX 已被用于多行业攻击并关联超过 2,500 个 C2 IP 地址","Cisco Talos 发现开源 AI 渗透测试框架 ARTEX 已被威胁行动者用于侦察、凭据窃取、云端滥用、横向移动和数据外泄，目标覆盖金融、政府、电信、国防等行业。","sourceName","Cisco Talos","sourceUrl","https://blog.talosintelligence.com/artex-and-beyond/","publishedAt","2026-11-13T20:57:13.000Z","sourceIconUrl","/dailyinfo/media/cbab12e5b352b636.webp","sourceIconSrcSet","/dailyinfo/media/79258b19df22701a.webp 48w, /dailyinfo/media/cbab12e5b352b636.webp 96w","firstParty",false,"available",true,"研究与披露",[97],{"_77":98,"_24":99,"_73":100,"_81":101,"_83":102,"_85":103,"_87":104,"_89":105,"_91":92,"_93":94},"zqhb8fqggr4jdd60g720bgfej","forcequitOS 公开 iOS 沙箱逃逸 PoC worse_query，影响 iOS 26.7.1、27.0.1 和 27.2","forcequitOS 公开了名为 worse_query 的 iOS 沙箱逃逸 PoC，可在应用创建 App Group container 后读取其他应用的数据目录，并在 iOS 27 上访问部分系统目录，影响 iOS 26.7.1、27.0.1 和 27.2。","Security Affairs","https://securityaffairs.com/202788/hacking/ios-sandbox-escape-is-public-and-apple-hasnt-confirmed-a-fix.html","2026-11-10T15:46:20.000Z","/dailyinfo/media/ef2b2b57fb06e54f.webp","/dailyinfo/media/2adef5b1e4357a03.webp 48w, /dailyinfo/media/ef2b2b57fb06e54f.webp 96w","攻击与威胁",[108,109,110,111,112,113,114,115,116,117,118,119,120],{"_77":38,"_24":31,"_73":200,"_81":132,"_83":201,"_85":202,"_87":135,"_89":136,"_91":92,"_93":94},{"_77":195,"_24":196,"_73":197,"_81":159,"_83":198,"_85":199,"_87":162,"_89":163,"_91":92,"_93":94},{"_77":190,"_24":191,"_73":192,"_81":148,"_83":193,"_85":194,"_87":-5,"_91":92,"_93":94},{"_77":182,"_24":183,"_73":184,"_81":185,"_83":186,"_85":187,"_87":188,"_89":189,"_91":92,"_93":94},{"_77":177,"_24":178,"_73":179,"_81":124,"_83":180,"_85":181,"_87":127,"_89":128,"_91":92,"_93":94},{"_77":172,"_24":173,"_73":174,"_81":140,"_83":175,"_85":176,"_87":-5,"_91":92,"_93":94},{"_77":164,"_24":165,"_73":166,"_81":167,"_83":168,"_85":169,"_87":170,"_89":171,"_91":92,"_93":94},{"_77":156,"_24":157,"_73":158,"_81":159,"_83":160,"_85":161,"_87":162,"_89":163,"_91":92,"_93":94},{"_77":151,"_24":152,"_73":153,"_81":132,"_83":154,"_85":155,"_87":135,"_89":136,"_91":92,"_93":94},{"_77":145,"_24":146,"_73":147,"_81":148,"_83":149,"_85":150,"_87":-5,"_91":92,"_93":94},{"_77":137,"_24":138,"_73":139,"_81":140,"_83":141,"_85":142,"_87":143,"_89":144,"_91":92,"_93":94},{"_77":129,"_24":130,"_73":131,"_81":132,"_83":133,"_85":134,"_87":135,"_89":136,"_91":92,"_93":94},{"_77":121,"_24":122,"_73":123,"_81":124,"_83":125,"_85":126,"_87":127,"_89":128,"_91":92,"_93":94},"z6sqacicgu5g5kxg4eavs0p1z","攻击者利用 Openwave CVE-2026-111793 与 Cisco BroadWorks CVE-2026-20320","攻击者已利用 Openwave Webtop Media Transcoder 的 CVE-2026-111793 和 Cisco BroadWorks 的 CVE-2026-20320 窃取敏感信息。","SecurityWeek","https://www.securityweek.com/threat-actors-exploit-openwave-cisco-broadworks-vulnerabilities/","2026-11-11T09:01:07.000Z","/dailyinfo/media/6f21a015ea489b81.webp","/dailyinfo/media/c2a91b85de7bb9d6.webp 48w, /dailyinfo/media/6f21a015ea489b81.webp 96w","q62rs7r8pongzx30vtu5q3hx7","美国政府中断 North Korean FaceStealer 活动，查获超 4 亿美元加密资产盗取","美国政府查获基础设施并中断 North Korean 社会工程活动 FaceStealer，该活动持续 18 个月，针对加密货币、Web3 行业及开源开发者，盗取超过 $400 million 加密资产。","BleepingComputer","https://www.bleepingcomputer.com/news/security/us-disrupts-north-korean-campaign-behind-400-million-crypto-theft/","2026-11-14T15:15:49.000Z","/dailyinfo/media/198a4d86de90e233.webp","/dailyinfo/media/3a544a742516b0af.webp 48w, /dailyinfo/media/198a4d86de90e233.webp 96w","k9g0gy54e8kqkx59naz5nvc5r","朝鲜黑客组织被指窃取 64.3 亿美元并用 meme 币洗钱","朝鲜黑客组织 TraderTraitor 被指于 2026 年 10 月 29 日从币*在 11 条区块链上的钱包抽走约 64.3 亿美元，其后通过拆分、跨链、资产互换、借贷金库、coinjoin 和 Privacy Cash 洗钱。","安全内参","https://www.secrss.com/articles/95551","2026-11-10T16:44:39.507Z","/dailyinfo/media/77459fcbf8f21e71.webp","/dailyinfo/media/3399ea7b18d18a6a.webp 48w, /dailyinfo/media/77459fcbf8f21e71.webp 96w","jpccsfbubyqtcmxrbt833yyzz","欧洲制冷系统攻击复盘：多国零售门店及法国血液冷库受影响","2026年10月以来，欧洲制冷系统遭未授权访问并被修改温度、化霜阈值等参数，法国约700家超市及至少10个其他欧洲国家100—115个零售点位受影响，法国血液服务机构EFS三个站点的冷库监控与控制系统也被波及。","奇安信威胁情报中心","https://mp.weixin.qq.com/s?__biz=MzI2MDc2MDA4OA==&mid=2247521297&idx=1&sn=6a6eef9c97fc3d49ce58036988f6f573","2026-11-09T08:25:00.000Z","ihb325l23pcss0skikvuxyfi2","ConnectWise 调查针对 MSP 的 ScreenConnect 恶意软件活动，47 家组织受影响","ConnectWise 正在调查一场针对托管服务提供商（MSP）的活跃恶意软件活动，攻击者利用遭入侵的 ScreenConnect 环境，通过 Run Command 功能向客户设备部署非法远程客户端。","https://www.bleepingcomputer.com/news/security/active-screenconnect-attacks-breach-msps-impact-dozens-of-organizations/","2026-11-11T22:56:21.000Z","pc8as95x3w41yh4oar095yxmg","Operation Endgame 关闭 Gootloader、CastleRAT 和 StealC 基础设施，查获 6.4M 组失窃登录凭据","Operation Endgame 已关闭 Gootloader、CastleRAT 和 StealC 相关基础设施，共查获 235 台服务器、257 个域名及约 6.4 million 组失窃登录凭据，涉及超过 40,000 名受害者。","The Hacker News","https://thehackernews.com/2026/11/operation-endgame-takes-down-gootloader.html","2026-11-13T10:55:03.000Z","/dailyinfo/media/3d21685a726d0a64.jpg","/dailyinfo/media/a1e7de8b6809b50e.jpg 48w, /dailyinfo/media/3d21685a726d0a64.jpg 96w","pwalod9qlwcnq38r5ae1i2ani","攻击者利用 Cairn 自主攻击半导体、国防及公民社会机构","Unit 42 披露，中文使用者于 2026 年 8 月至 9 月利用开源 AI 渗透测试框架 Cairn，结合 Zhipu GLM 5.2 与 DeepSeek V4 Flash/Pro，针对至少 19 家机构自主执行 25 次行动。","Unit 42","https://unit42.paloaltonetworks.com/cairn-framework-ai-autonomous-attacks/","2026-11-12T15:00:31.000Z","/dailyinfo/media/4d373ddb2d54a219.webp","/dailyinfo/media/c5c35eb93d4d2e80.webp 48w, /dailyinfo/media/4d373ddb2d54a219.webp 96w","vf2fadfkovuwc9eyk4jilfa6l","CNCERT披露“银狐”木马“金钩（G03）”团伙攻击同花顺仿冒下载站","国家互联网应急中心（CNCERT）与北京观成科技有限公司分析“银狐”木马“金钩（G03）”团伙针对同花顺仿冒下载站的活动。该团伙通过SEO投毒传播捆绑木马的THS.zip，以多阶段内存加载植入远控模块，支持屏幕截图、键盘记录、远程命令执行、插件下发和信息窃取。","https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&mid=2247516863&idx=2&sn=cee958d56977506d31b586bf4297c108","2026-11-10T09:12:00.000Z","dutfochl5zqbpgtoxwe32cj7v","France 指控 Iran 武装组织攻击约 700 家超市制冷系统","France 指控 Iran 革命卫队关联的 Shahid Kaveh 小组攻击了全国约 700 家超市的制冷系统。10 月 12 日凌晨，攻击者远程控制制冷设备，使温度升至 50 Celsius（122 Fahrenheit）并持续约 6 小时，Intermarché 报告单日损失达数千万欧元。","https://www.securityweek.com/france-blames-iran-for-a-cyberattack-that-heated-supermarket-refrigerators/","2026-11-10T07:35:05.000Z","sif366thhfeqdn24sve2qcy60","Turla 利用 Microsoft Exchange 服务器部署 Cereal 后门窃取邮件","ESET 发现俄罗斯关联组织 Turla 在哈萨克斯坦和罗马尼亚的 2 个政府机构 Microsoft Exchange 服务器上部署模块化 .NET 工具集 Cereal，通过伪装成 Outlook Web Access、Autodiscover 和 ActiveSync 流量的请求接收命令，并筛选发件人、收件人、主题或附件名称后复制邮件。","Help Net Security","https://www.helpnetsecurity.com/2026/11/10/eset-turla-exchange-malware/","2026-11-10T10:00:39.000Z","/dailyinfo/media/06c9ab9de6dbb6a5.webp","/dailyinfo/media/9c1b5fa87b3bafc5.webp 48w, /dailyinfo/media/06c9ab9de6dbb6a5.webp 96w","t9vxip29f8i1pdp144dvxpjbx","XCPE 后门分析：130 万台 Android 设备被预装为可出租代理与广告节点","XCPE 通过 Android OEM/ODM 厂商 Videostrong Technology Co. 的固件预装进入设备，以 x.cpe、com.abc.nexus 及后期专用 Dropper 构成控制与执行链。","https://mp.weixin.qq.com/s?__biz=MzI2MDc2MDA4OA==&mid=2247521313&idx=1&sn=1bd52ac3229fa18e781a8aac3c4553ab","2026-11-10T07:36:00.000Z","m2uopbxw2xg55pf3fx6t03uwr","攻击者利用 4,837 个劫持 GitHub 账户在 1,806+ 个仓库运行 CI 密钥窃取器","攻击者使用从周二起窃取的 4,837 个 GitHub 账户凭据，通过标题为 docs: dependency audit notes 的测试 Pull Request 检查写权限。","https://thehackernews.com/2026/11/4837-hijacked-github-accounts-ran-ci.html","2026-11-12T06:42:47.000Z","攻击者利用 PHP2Shell 漏洞 CVE-2026-109618 和 CVE-2026-109619 入侵 Check Point Security Gateway 的 Mobile Access 门户。","https://www.bleepingcomputer.com/news/security/check-point-gateways-hacked-via-php2shell-to-deploy-vmware-esxi-wiper/","2026-11-13T16:21:43.000Z","漏洞与在野利用",[205,206,207,208,209],{"_77":233,"_24":234,"_73":235,"_81":236,"_83":237,"_85":238,"_87":-5,"_91":94,"_93":94},{"_77":228,"_24":229,"_73":230,"_81":159,"_83":231,"_85":232,"_87":162,"_89":163,"_91":92,"_93":94},{"_77":223,"_24":224,"_73":225,"_81":159,"_83":226,"_85":227,"_87":162,"_89":163,"_91":92,"_93":94},{"_77":215,"_24":216,"_73":217,"_81":218,"_83":219,"_85":220,"_87":221,"_89":222,"_91":94,"_93":94},{"_77":210,"_24":211,"_73":212,"_81":101,"_83":213,"_85":214,"_87":104,"_89":105,"_91":92,"_93":94},"mwouaoheoihzxg7tv9qiyhivi","CISA 将 Check Point 与 UnrealIRCd 漏洞 CVE-2026-123039、CVE-2026-114713 加入 KEV 目录","CISA 将 UnrealIRCd 命令注入漏洞 CVE-2026-114713 和 Check Point 本地提权漏洞 CVE-2026-123039 加入 KEV 目录，确认均已被真实利用，并要求联邦机构在 2026 年 11 月 16 日前完成处置。","https://securityaffairs.com/203040/hacking/u-s-cisa-adds-check-point-and-unrealircd-flaws-to-its-known-exploited-vulnerabilities-catalog.html","2026-11-14T09:08:00.000Z","j3zs99gaytjzbcm7piuk8be0b","GPUStack v2.2.0 之前认证绕过漏洞已被在野利用","GPUStack v2.2.0 之前存在认证绕过，默认配置下可将请求来源判定为 127.0.0.1 并授予未认证管理员权限；同机反向代理会暴露 TCP peer，伪造 X-GPUStack-Real-IP: 127.0.0.1 也可触发该分支。","GitHub 安全公告","https://github.com/advisories/GHSA-gj9m-f8ph-pmhr","2026-11-09T22:15:27.000Z","/dailyinfo/media/6d6a98e6b62e0bb2.webp","/dailyinfo/media/f426f4f60d806c23.webp 48w, /dailyinfo/media/6d6a98e6b62e0bb2.webp 96w","x7edhu1rfhikbjr5w193xldog","Vates VMS 披露 Xen Orchestra 认证绕过漏洞 VSA-2026-062 已被利用","Vates VMS 表示，Xen Orchestra 的认证绕过漏洞 VSA-2026-062 已在真实攻击中被利用，攻击者通过特制 Cookie 获取 Admin 权限，最终可在托管池上执行任意代码并以 root 接管 XCP-ng 节点。","https://thehackernews.com/2026/11/hackers-exploit-critical-xen-orchestra.html","2026-11-10T18:12:21.000Z","itghrl24hjsfp7ov68trhdxf5","Apache HTTP/2 模块远程代码执行漏洞 CVE-2026-119618 影响 2.4.55 至 2.4.70，2.4.71 已修复","Apache HTTP Server 的 HTTP/2 模块 mod_http2 存在严重漏洞 CVE-2026-119618，攻击者无需认证即可在服务器上执行代码并完全控制服务器进程，CVSS 评分 9.8。","https://thehackernews.com/2026/11/critical-apache-http2-flaw-could-let.html","2026-11-12T05:12:26.000Z","z7r3ob6z5zlzhu12s71ktd4th","Chrome XML 双重释放漏洞 CVE-2026-125350 已被在野利用","Google Chrome 内置 libxslt 的 XSLT 处理链路存在双重释放（UAF）漏洞 CVE-2026-125350，CVSS 3.1 为 8.8，已被在野利用。","深信服千里目安全实验室","https://mp.weixin.qq.com/s?__biz=Mzg2NjgzNjA5NQ==&mid=2247526403&idx=1&sn=74b3e772b8c4fb242da449db13683206","2026-11-10T09:51:00.000Z",{"_77":195,"_24":196,"_73":197,"_81":159,"_83":198,"_85":199,"_87":162,"_89":163,"_91":92,"_93":94},{"_77":233,"_24":234,"_73":235,"_81":236,"_83":237,"_85":238,"_87":-5,"_91":94,"_93":94},{"_77":228,"_24":229,"_73":230,"_81":159,"_83":231,"_85":232,"_87":162,"_89":163,"_91":92,"_93":94},"leadParagraph",{"_244":245,"_246":-5},"changelogVersion","2026-10-01T08:00","release"]
