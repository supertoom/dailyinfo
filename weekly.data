[{"_1":2,"_3":4},"root",{"_5":248},"weekly-latest",{"_5":6},"data",{"_7":8,"_9":10,"_11":12,"_13":14,"_15":16},"kind","weekly","report",{"_7":8,"_21":33,"_23":34,"_25":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":56,"_57":30,"_58":-5},"index",[17,18,19,20],"today","2026-11-24","expiresAt",1795480853000,{"_21":33,"_23":34,"_25":35},{"_21":30,"_23":31,"_25":32},{"_21":27,"_23":28,"_25":29},{"_21":22,"_23":24,"_25":26},"key","2026-W44","issueNumber",1,"title","Binance 遭遇约 63 亿美元加密货币盗窃，TRM 归因 TraderTraitor","2026-W45",2,"APT29 关联黑客劫持 Plerdy SEO Tracker 投递 iOS 与 Android 利用链","2026-W46",3,"攻击者利用 PHP2Shell 入侵 Check Point 网关并部署 VMware ESXi 数据擦除器","2026-W47",4,"NGINX HTTP/2 远程代码执行漏洞 CVE-2026-123007 已复现","DailyInfo 周报 · 2026-W47","generatedAt","2026-11-23T02:00:19.984Z","lead",{"_25":35,"_247":44},"leadItemId","m51451stt7lkv5evn4mfrujes","overview","漏洞层面，已有多项漏洞遭在野利用，VMware vCenter 认证绕过、Microsoft Outlook 欺骗和 Rapid7 发现的利用最突出，CISA 同步将四项漏洞列入 KEV。攻击层面，供应链脚本与软件包、云环境及合法管理接口成为主要入侵路径，人工智能工具也被用于渗透。防御方通过发布 PHP 安全更新、列入 KEV 及复现分析漏洞，推动修复与风险处置。","highlights",[244,245,246],"sections",[72,73,74],"flashes",[],"cover",{"_65":66,"_67":68,"_69":-5,"_70":-5,"_71":-5},"metrics",{"_59":60,"_61":62,"_63":64},"readingMinutes",8,"prev","next","totalStories",20,"selectedCount",150,"reportsCovered",7,"url","/api/img-proxy?u=https%3A%2F%2Fwechat2rss.xlab.app%2Fimg-proxy%2F%3Fk%3D0e49e9f2%26amp%3Bu%3Dhttps%253A%252F%252Fmmbiz.qpic.cn%252Fsz_mmbiz_jpg%252FT4OSm0sXdEM4URm94iaA4WurQs1I3b8H7c5llUVsu1eOokrNGh2iccEGKlYfCDCVjQVfcM9fHibeTvbMPbPiaJfTJV8Py4tB0YRJQ3IuWnL2N6Y%252F0%253Fwx_fmt%253Djpeg&mode=full&exp=1795737600&sig=eb71b3622fa334ef","srcSet","/api/img-proxy?u=https%3A%2F%2Fwechat2rss.xlab.app%2Fimg-proxy%2F%3Fk%3D0e49e9f2%26amp%3Bu%3Dhttps%253A%252F%252Fmmbiz.qpic.cn%252Fsz_mmbiz_jpg%252FT4OSm0sXdEM4URm94iaA4WurQs1I3b8H7c5llUVsu1eOokrNGh2iccEGKlYfCDCVjQVfcM9fHibeTvbMPbPiaJfTJV8Py4tB0YRJQ3IuWnL2N6Y%252F0%253Fwx_fmt%253Djpeg&mode=thumb&exp=1795737600&sig=5d6cf60d3a93b746 720w, /api/img-proxy?u=https%3A%2F%2Fwechat2rss.xlab.app%2Fimg-proxy%2F%3Fk%3D0e49e9f2%26amp%3Bu%3Dhttps%253A%252F%252Fmmbiz.qpic.cn%252Fsz_mmbiz_jpg%252FT4OSm0sXdEM4URm94iaA4WurQs1I3b8H7c5llUVsu1eOokrNGh2iccEGKlYfCDCVjQVfcM9fHibeTvbMPbPiaJfTJV8Py4tB0YRJQ3IuWnL2N6Y%252F0%253Fwx_fmt%253Djpeg&mode=image-1200&exp=1795737600&sig=2dbf78abe6cc7ffe 1200w, /api/img-proxy?u=https%3A%2F%2Fwechat2rss.xlab.app%2Fimg-proxy%2F%3Fk%3D0e49e9f2%26amp%3Bu%3Dhttps%253A%252F%252Fmmbiz.qpic.cn%252Fsz_mmbiz_jpg%252FT4OSm0sXdEM4URm94iaA4WurQs1I3b8H7c5llUVsu1eOokrNGh2iccEGKlYfCDCVjQVfcM9fHibeTvbMPbPiaJfTJV8Py4tB0YRJQ3IuWnL2N6Y%252F0%253Fwx_fmt%253Djpeg&mode=full&exp=1795737600&sig=eb71b3622fa334ef 1600w","width","height","caption",{"_75":190,"_77":191,"_79":192},{"_75":123,"_77":124,"_79":125},{"_75":76,"_77":78,"_79":80},"label","研究与披露","summary","研究人员复现并串联多项漏洞，进一步揭示从远程代码执行到容器权限提升的利用路径。","items",[81,82,83,84],{"_85":42,"_25":35,"_77":119,"_89":120,"_91":121,"_93":122,"_95":-5,"_99":100,"_101":100},{"_85":111,"_25":112,"_77":113,"_89":114,"_91":115,"_93":116,"_95":117,"_97":118,"_99":110,"_101":100},{"_85":102,"_25":103,"_77":104,"_89":105,"_91":106,"_93":107,"_95":108,"_97":109,"_99":110,"_101":100},{"_85":86,"_25":87,"_77":88,"_89":90,"_91":92,"_93":94,"_95":96,"_97":98,"_99":100,"_101":100},"itemId","es8fim15uyb01mav2xou16cyd","ONLYOFFICE Docs 五个漏洞可由只读权限链至容器 root","Rapid7 在 ONLYOFFICE Docs Document Server 9.4.0-129 上披露并复现 5 个漏洞，包括 CVE-2026-113627、CVE-2026-110385、CVE-2026-97727、CVE-2026-113630 和 CVE-2026-113631。","sourceName","Rapid7 CVE 公告","sourceUrl","https://www.rapid7.com/blog/post/ve-from-view-only-access-to-container-root-five-vulnerabilities-in-onlyoffice-docs-fixed","publishedAt","2026-11-16T16:24:38.000Z","sourceIconUrl","/dailyinfo/media/092fbeae5b5c3123.webp","sourceIconSrcSet","/dailyinfo/media/c16323cf53c574df.webp 48w, /dailyinfo/media/092fbeae5b5c3123.webp 96w","firstParty",true,"available","xd9ub2ylkejv4lczx8263vksb","Microsoft Defender for macOS 本地权限提升漏洞利用链分析","Microsoft Defender for macOS 存在 PID 复用竞态导致的本地权限提升链，可利用 CVE-2026-50657 任意读取文件，并利用 CVE-2026-50658 绕过授权、以 root 身份创建文件，最终通过 /etc/crontab 获得 root shell。","spaceraccoon","https://spaceraccoon.dev/race-against-the-machine-defender-macos-lpe/","2026-11-15T12:00:00.000Z","/dailyinfo/media/0739b6f5fff23198.webp","/dailyinfo/media/5a6f211566b3fe4d.webp 48w, /dailyinfo/media/0739b6f5fff23198.webp 96w",false,"b1fnjx9fxpzix49ewdy3c0kzl","OpenJDK Base64 解码器漏洞 Java4Shell 利用链与 PoC 分析","OpenJDK HotSpot 的 x86-64 Base64 intrinsic 存在堆越界写漏洞 Java4Shell，研究者复现了该问题并构建出堆信息泄露、堆布局控制及远程代码执行（RCE）利用链。","Sec-News 安全文摘","https://govuln.com/news/url/xZvr","2026-11-18T02:47:32.542Z","/dailyinfo/media/d2ca541f851c1107.webp","/dailyinfo/media/03390883e3e7efa3.webp 48w, /dailyinfo/media/d2ca541f851c1107.webp 96w","微步在线已在实验环境中复现 NGINX HTTP/2 远程代码执行漏洞 CVE-2026-123007。该漏洞影响启用 HTTP/2 的未修复实例，攻击者无需认证或受害者配合即可远程执行代码并获得 NGINX 工作进程权限；在满足相关环境条件时，还可串联 Linux SCTP 内核漏洞实现宿主机 root 提权及容器逃逸。","微步在线研究响应中心","https://mp.weixin.qq.com/s?__biz=Mzg5MTc3ODY4Mw==&mid=2247509063&idx=1&sn=45c71724375b83415bf880558c549bf0","2026-11-19T00:56:00.000Z","攻击与威胁","攻击活动集中于供应链、云环境与合法管理接口，自主人工智能工具也被用于渗透。",[126,127,128,129,130,131,132,133],{"_85":182,"_25":183,"_77":184,"_89":185,"_91":186,"_93":187,"_95":188,"_97":189,"_99":110,"_101":100},{"_85":177,"_25":178,"_77":179,"_89":159,"_91":180,"_93":181,"_95":162,"_97":163,"_99":110,"_101":100},{"_85":169,"_25":170,"_77":171,"_89":172,"_91":173,"_93":174,"_95":175,"_97":176,"_99":110,"_101":100},{"_85":164,"_25":165,"_77":166,"_89":159,"_91":167,"_93":168,"_95":162,"_97":163,"_99":110,"_101":100},{"_85":156,"_25":157,"_77":158,"_89":159,"_91":160,"_93":161,"_95":162,"_97":163,"_99":110,"_101":100},{"_85":150,"_25":151,"_77":152,"_89":153,"_91":154,"_93":155,"_95":-5,"_99":110,"_101":100},{"_85":142,"_25":143,"_77":144,"_89":145,"_91":146,"_93":147,"_95":148,"_97":149,"_99":110,"_101":100},{"_85":134,"_25":135,"_77":136,"_89":137,"_91":138,"_93":139,"_95":140,"_97":141,"_99":110,"_101":100},"cc7qsurqjcbzxqury8oid8a18","Rakuten Securities 数据泄露或影响近 1600 万个账户","Rakuten Securities 表示，11 月 11 日测试环境中的部分信息被泄露至外部，4.47 million 个账户的资料被窃取，另有 11.25 million 个账户仅被窃取分支或客户代码及登录 ID，合计接近 16 million 人。","Infosecurity Magazine","https://www.infosecurity-magazine.com/news/rakuten-securities-breach-15/","2026-11-19T09:20:00.000Z","/dailyinfo/media/b3cc9cd29f272a5a.webp","/dailyinfo/media/6406d1b57afc7303.webp 48w, /dailyinfo/media/b3cc9cd29f272a5a.webp 96w","tog6u532ub8dq1yucwbn56k99","Fireworks AI 密钥泄露导致 Cursor Marketplace 供应被植入 Claude Code 恶意扩展","Cursor 确认，攻击者利用 Fireworks AI 泄露的访问密钥复制共享数据，进而取得 Cursor 使用的 SaaS 工具凭据及部分内部数据。","The Hacker News","https://thehackernews.com/2026/11/stolen-fireworks-ai-key-led-to-cursor.html","2026-11-15T08:22:04.000Z","/dailyinfo/media/3d21685a726d0a64.jpg","/dailyinfo/media/a1e7de8b6809b50e.jpg 48w, /dailyinfo/media/3d21685a726d0a64.jpg 96w","do1qix3duahy7w828dz52wk6y","BlackNevas 利用合法 vCenter 管理接口破坏 VMware 虚拟化环境","BlackNevas 通过组织内部获取的凭据进入 VCSA，建立 MeshAgent 与 Ligolo-ng 持久化通道，滥用 vCenter Host Profiles 开启 TSM-SSH，再经 SFTP 向 ESXi 投递加密器；事件导致四台 ESXi 主机及其全部虚拟机、两台 VCSA 和备份基础设施被破坏。","奇安信威胁情报中心","https://mp.weixin.qq.com/s?__biz=MzI2MDc2MDA4OA==&mid=2247521462&idx=1&sn=4255628f912af9993074bd11dcb83a80","2026-11-20T04:07:00.000Z","k4uuj5trh7l8y7g1ko080x2rr","FBI 警告 ARTEX AI 渗透测试框架被用于全球多行业攻击","FBI 警告，开源 AI 渗透测试框架 ARTEX 已被多个威胁行为者武器化，自 2026 年 8 月起用于金融、政府、科技、国防和医疗等行业的全球攻击。","BleepingComputer","https://www.bleepingcomputer.com/news/security/fbi-warns-artex-ai-hacking-tool-is-powering-global-cyberattacks/","2026-11-15T18:29:53.000Z","/dailyinfo/media/198a4d86de90e233.webp","/dailyinfo/media/3a544a742516b0af.webp 48w, /dailyinfo/media/198a4d86de90e233.webp 96w","mfif5csbm0luk6anr64r4hzho","攻击者利用自主 AI 工具 Cairn 攻陷 MONAI Label 漏洞并取得服务器权限","Amazon Threat Intelligence 发现疑似中国关联攻击者使用自主 AI Agent 平台 Cairn，于 2026 年 9 月 8 日至 10 日攻击中国境外东亚教育机构。","https://www.bleepingcomputer.com/news/security/hackers-use-autonomous-ai-tool-cairn-to-find-zero-day-take-over-server/","2026-11-20T17:30:00.000Z","wy00ijr8g20kod2rcokcs0tos","Barracuda 遭 Artex 驱动的云环境入侵，攻击持续约 44 小时","Barracuda 遭 Artex 驱动的入侵，攻击发生于 11 月 1 日至 11 月 2 日，约 44 小时触及 10 个云账户。","SecurityWeek","https://www.securityweek.com/barracuda-hacked-amid-surge-in-artex-powered-cyberattacks/","2026-11-16T15:07:32.000Z","/dailyinfo/media/6f21a015ea489b81.webp","/dailyinfo/media/c2a91b85de7bb9d6.webp 48w, /dailyinfo/media/6f21a015ea489b81.webp 96w","z69zj40alkpfq51pcwzj6kkm6","Microsoft Agent Framework 的 PyPI 包 1.26.1 和 1.26.2 被植入凭据窃取代码","攻击者篡改 Microsoft Agent Framework 的官方 PyPI 包，发布恶意版本 1.26.1 和 1.26.2，在 Python 启动时自动收集环境变量、配置文件及进程中的 Azure、AWS、GitHub、Docker、Hugging Face、OpenAI 等凭据。","https://www.bleepingcomputer.com/news/security/microsofts-agent-framework-pypi-package-compromised-to-steal-credentials/","2026-11-18T16:58:42.000Z","cpozl5byqasqocx0exg64utib","攻击者劫持 Optimizely Web Experimentation 脚本，178 家组织网站遭注入","攻击者利用 Optimizely Web Experimentation 漏洞，将恶意 JavaScript 注入 178 家组织的项目，影响 Zoom、BBC、CNN、Salesforce、GitLab、IKEA、HSBC、Equifax 等网站。","Security Affairs","https://securityaffairs.com/203289/malware/optimjack-bbc-cnn-and-zoom-among-targets-of-optimizely-script-hijacking.html","2026-11-17T09:38:44.000Z","/dailyinfo/media/ef2b2b57fb06e54f.webp","/dailyinfo/media/2adef5b1e4357a03.webp 48w, /dailyinfo/media/ef2b2b57fb06e54f.webp 96w","漏洞与在野利用","在野利用持续扩大，认证绕过、欺骗和远程利用成为主要风险，厂商同时集中修复高危漏洞。",[193,194,195,196,197,198,199,200],{"_85":238,"_25":239,"_77":240,"_89":241,"_91":242,"_93":243,"_95":-5,"_99":100,"_101":100},{"_85":233,"_25":234,"_77":235,"_89":90,"_91":236,"_93":237,"_95":96,"_97":98,"_99":100,"_101":100},{"_85":228,"_25":229,"_77":230,"_89":90,"_91":231,"_93":232,"_95":96,"_97":98,"_99":100,"_101":100},{"_85":223,"_25":224,"_77":225,"_89":120,"_91":226,"_93":227,"_95":-5,"_99":100,"_101":100},{"_85":218,"_25":219,"_77":220,"_89":145,"_91":221,"_93":222,"_95":148,"_97":149,"_99":110,"_101":100},{"_85":213,"_25":214,"_77":215,"_89":172,"_91":216,"_93":217,"_95":175,"_97":176,"_99":110,"_101":100},{"_85":207,"_25":208,"_77":209,"_89":210,"_91":211,"_93":212,"_95":-5,"_99":100,"_101":100},{"_85":201,"_25":202,"_77":203,"_89":204,"_91":205,"_93":206,"_95":-5,"_99":100,"_101":100},"rv2ecm55xe5ces92lza6gmsz6","Ruby 字符串大小写转换堆越界写入漏洞 CVE-2026-132825 存在 RCE 风险","Ruby 字符串大小写转换函数存在堆缓冲区越界写入漏洞（CVE-2026-132825），影响 Ruby < 3.3.14、Ruby 3.4.0 - 3.4.12 和 Ruby 4.0.0 - 4.0.9，威胁等级为高危。","深信服千里目安全实验室","https://mp.weixin.qq.com/s?__biz=Mzg2NjgzNjA5NQ==&mid=2247526537&idx=3&sn=d3994fc9cd73ceb292a7ed2a9d6f65f6","2026-11-20T09:49:00.000Z","mg2hvvx1gkkrqp4l17mvgnrr8","奇安信 CERT 复现 LibreOffice 远程代码执行漏洞 CVE-2026-104692、CVE-2026-104007","奇安信 CERT 已复现 LibreOffice 远程代码执行漏洞 CVE-2026-104692、CVE-2026-104007，攻击者可通过特制 ODS 文档在用户打开时实现任意代码执行，无需宏警告或额外交互。","奇安信 CERT","https://mp.weixin.qq.com/s?__biz=MzU5NDgxODU1MQ==&mid=2247508132&idx=1&sn=765cffd533b8087793a59834cabdc0dd","2026-11-17T09:06:00.000Z","cxsrv3tj2ve440bw0s2r18iyx","PHP 修复 7 个严重级 RCE 漏洞，发布 PHP 8.6.0 与 8.5.13","PHP 发布安全更新，修复 7 个严重级远程代码执行（RCE）漏洞，包括会话上传进度反序列化、多个 use-after-free、PHP-FPM 请求走私和时区缓存释放后使用问题。","https://www.securityweek.com/php-patches-seven-critical-rce-vulnerabilities/","2026-11-19T15:54:20.000Z","jbitkvf4i6iewvak8ejgx9cvb","CISA 将 Apache Roller、Cisco Expressway、SAP NetWeaver 和 VMware vCenter 四项漏洞列入 KEV","CISA 将 Apache Roller、Cisco Expressway、SAP NetWeaver 和 VMware vCenter 的 4 个漏洞列入 KEV，依据是已发现活跃利用证据。","https://thehackernews.com/2026/11/hackers-exploit-critical-vmware-cisco.html","2026-11-21T08:49:13.000Z","nzpbt56ivpfcejp2mk6oqnujs","Microsoft Outlook 欺骗漏洞 CVE-2026-124194 已复现并遭在野利用","Microsoft Outlook 欺骗漏洞 CVE-2026-124194 已遭在野利用，攻击者可投递特制 .ics 日历文件诱使用户打开或导入，借此向攻击者控制的网络位置发起认证并泄露当前用户的 NTLMv2 响应；利用可远程触发，无需权限，但需要用户配合。","https://mp.weixin.qq.com/s?__biz=Mzg5MTc3ODY4Mw==&mid=2247509077&idx=3&sn=fc17281daf783d776f4c2748ce5df332","2026-11-19T17:06:00.000Z","npdhl1v55b5kdqnab2s0etv9h","Rapid7发现CVE-2026-90436已被用于攻击Atlassian Confluence Data Center和N-able N-central","Rapid7 MDR于11月13日在客户环境中检测到CVE-2026-90436对Atlassian Confluence Data Center的利用，N-able也报告了针对N-central的强关联漏洞在野利用。","https://www.rapid7.com/blog/post/etr-rapid7-detected-exploitation-of-cve-2026-90436-against-atlassian-confluence-data-center-n-able-n-central-also-exploited","2026-11-16T18:14:14.000Z","hd19yw6n9on2wachygxhu93xs","VMware vCenter 认证绕过漏洞 CVE-2026-123890 已被 ARMORY CASTLE 利用","VMware vCenter 的认证绕过漏洞 CVE-2026-123890 已被中国关联威胁组织 ARMORY CASTLE 在野利用，最早可追溯至 2026 年 9 月。","https://www.rapid7.com/blog/post/etr-cve-2026-123890-critical-authentication-bypass-vmware-vcenter","2026-11-19T21:06:24.000Z","npae2p2bauihkhq9p8huoutnf","OpenJDK 披露 Base64 解码远程代码执行漏洞 CVE-2026-114938","OpenJDK Java4Shell Base64解码远程代码执行漏洞 CVE-2026-114938 可经网络输入在无需认证的条件下劫持执行流。受影响范围包括 OpenJDK 17、21、25、27及对应 GraalVM，部分 Keycloak、Jira、Confluence 等产品存在未授权 RCE。","阿里云应急响应","https://mp.weixin.qq.com/s?__biz=MzI5MzY2MzM0Mw==&mid=2247486425&idx=1&sn=a79b346d585971698fe43b28fba843aa","2026-11-18T01:41:00.000Z",{"_85":238,"_25":239,"_77":240,"_89":241,"_91":242,"_93":243,"_95":-5,"_99":100,"_101":100},{"_85":182,"_25":183,"_77":184,"_89":185,"_91":186,"_93":187,"_95":188,"_97":189,"_99":110,"_101":100},{"_85":233,"_25":234,"_77":235,"_89":90,"_91":236,"_93":237,"_95":96,"_97":98,"_99":100,"_101":100},"leadParagraph",{"_249":250,"_251":-5},"changelogVersion","2026-10-01T08:00","release"]
