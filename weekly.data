[{"_1":2,"_3":4},"root",{"_5":241},"weekly-latest",{"_5":6},"data",{"_7":8,"_9":10,"_11":12,"_13":14,"_15":16},"kind","weekly","report",{"_7":8,"_19":25,"_21":26,"_23":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48,"_49":20,"_50":-5},"index",[17,18],"today","2026-11-12","expiresAt",1794444106000,{"_19":25,"_21":26,"_23":27},{"_19":20,"_21":22,"_23":24},"key","2026-W44","issueNumber",1,"title","Binance 遭遇约 63 亿美元加密货币盗窃，TRM 归因 TraderTraitor","2026-W45",2,"APT29 关联黑客劫持 Plerdy SEO Tracker 投递 iOS 与 Android 利用链","DailyInfo 周报 · 2026-W45","generatedAt","2026-11-09T02:00:17.376Z","lead",{"_23":27,"_240":36},"leadItemId","kodarv143bm6tdtz8vpt6lz9c","overview","本周多条高危漏洞已遭在野利用，Synology DSM 身份认证绕过、Cisco Secure Email Gateway 注入和 OpenSSH 漏洞均被攻击者用于入侵，Ivanti Connect Secure 三个零日漏洞被链式利用。WordPress Core 竞争条件远程代码执行漏洞和 Windows Update Stack 本地权限提升漏洞也出现真实利用。","highlights",[237,238,239],"sections",[63,64,65,66],"flashes",[],"cover",{"_56":57,"_58":59,"_60":-5,"_61":-5,"_62":-5},"metrics",{"_51":52,"_53":54,"_55":48},"readingMinutes",7,"prev","next","totalStories",20,"selectedCount",114,"reportsCovered","url","/dailyinfo/media/21fe3abf43551dd5.jpg","srcSet","/dailyinfo/media/187a087a1557b898.jpg 720w, /dailyinfo/media/a343a9cf60f186d9.jpg 1200w, /dailyinfo/media/21fe3abf43551dd5.jpg 1600w","width","height","caption",{"_67":163,"_69":164,"_70":165},{"_67":102,"_69":103,"_70":104},{"_67":91,"_69":-5,"_70":92},{"_67":68,"_69":-5,"_70":71},"label","AI 安全","summary","items",[72],{"_73":74,"_23":75,"_69":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":86,"_87":88,"_89":90},"itemId","wlm5bqo3onughth3q45scdo59","OpenAI 使用 AI Agent 扫描 Linux 内核并发现 948 个本地提权漏洞","OpenAI 使用尚未发布的网络安全模型和 AI Agent 流水线扫描 Linux 内核，在 10 天内发现、复现并利用 948 个独立本地提权漏洞，总花费 120万美元。","sourceName","安全内参","sourceUrl","https://www.secrss.com/articles/95365","publishedAt","2026-11-05T01:42:25.753Z","sourceIconUrl","/dailyinfo/media/77459fcbf8f21e71.webp","sourceIconSrcSet","/dailyinfo/media/3399ea7b18d18a6a.webp 48w, /dailyinfo/media/77459fcbf8f21e71.webp 96w","firstParty",false,"available",true,"研究与披露",[93],{"_73":94,"_23":95,"_69":96,"_77":97,"_79":98,"_81":99,"_83":100,"_85":101,"_87":88,"_89":90},"akw79leby5nbvemb6mqo9vtdk","某国产 ERP 未授权任意文件上传 0day 被用于 Weax 勒索，3.8 万资产暴露","某国产 ERP 的未授权任意文件上传 0day 已被用于 Weax 勒索活动，攻击者无需账号密码即可上传 webshell 并加密数据，CVSS 3.1 评分为 9.8（Critical）。","先知社区","https://xz.aliyun.com/news/93089","2026-11-02T09:53:14.000Z","/dailyinfo/media/976ac253540515ec.webp","/api/img-proxy?u=https%3A%2F%2Fxz.aliyun.com%2Ffavicon.ico&mode=avatar-48&exp=1796256000&sig=862a26438132b835 48w, /dailyinfo/media/976ac253540515ec.webp 96w","攻击与威胁","攻击活动转向移动端利用链、AI 凭据批量搜集和模型仓库投毒，同时通过入侵更新通道与 DevOps 环节影响服务器、云平台及加密资产交易。",[105,106,107,108,109,110,111,112],{"_73":34,"_23":27,"_69":160,"_77":128,"_79":161,"_81":162,"_83":131,"_85":132,"_87":88,"_89":90},{"_73":152,"_23":153,"_69":154,"_77":155,"_79":156,"_81":157,"_83":158,"_85":159,"_87":88,"_89":90},{"_73":147,"_23":148,"_69":149,"_77":136,"_79":150,"_81":151,"_83":139,"_85":140,"_87":88,"_89":90},{"_73":141,"_23":142,"_69":143,"_77":144,"_79":145,"_81":146,"_83":-5,"_87":88,"_89":90},{"_73":133,"_23":134,"_69":135,"_77":136,"_79":137,"_81":138,"_83":139,"_85":140,"_87":88,"_89":90},{"_73":125,"_23":126,"_69":127,"_77":128,"_79":129,"_81":130,"_83":131,"_85":132,"_87":88,"_89":90},{"_73":119,"_23":120,"_69":121,"_77":122,"_79":123,"_81":124,"_83":-5,"_87":88,"_89":90},{"_73":113,"_23":114,"_69":115,"_77":116,"_79":117,"_81":118,"_83":-5,"_87":90,"_89":90},"nukg9pzziesh0qo3zavylwrii","深信服披露针对国内第三方支付机构的定向攻击工具包","深信服深瞻情报实验室发现一套针对某国内第三方支付机构生产环境的定向攻击工具包，共91个文件，涵盖冰蝎与蚁剑内存马、JVM无文件注入、反向隧道、Meterpreter载荷和数据窃取脚本。","深信服千里目安全实验室","https://mp.weixin.qq.com/s?__biz=Mzg2NjgzNjA5NQ==&mid=2247526358&idx=2&sn=ec2dc65ec3b9c03bfb8689c7ce09e59c","2026-11-05T09:53:00.000Z","iio02tqqqxbdf0qt1kdr6gjku","Load/Mine 利用 AI 模型仓库植入 GPU 挖矿后门，两波波及 31 个仓库","Load/Mine 活动利用 Transformers 的 trust_remote_code=True 加载恶意模型仓库中的 Python 代码，两波核心活动涉及 31 个仓库、29,818 次下载，计入 13 个仅具技术关联的模型后共 44 个仓库、32,376 次下载。","奇安信威胁情报中心","https://mp.weixin.qq.com/s?__biz=MzI2MDc2MDA4OA==&mid=2247521244&idx=1&sn=e8992e0f55281e055dbc99ffe2538195","2026-11-05T09:07:00.000Z","bwq6gssfuodld3bto7vao4207","cPGuard 5.88.12 至 5.88.19 更新通道被劫持，Linux 服务器遭后门植入","攻击者于 November 2 使用泄露凭据侵入 cPGuard 更新系统，通过 5.88.12 至 5.88.19 向客户 Linux 服务器投放恶意脚本，安装后门并收集密码哈希及敏感文件。","The Hacker News","https://thehackernews.com/2026/11/cpguard-update-channel-hijacked-to.html","2026-11-03T15:16:32.000Z","/dailyinfo/media/3d21685a726d0a64.jpg","/dailyinfo/media/a1e7de8b6809b50e.jpg 48w, /dailyinfo/media/3d21685a726d0a64.jpg 96w","c8c3sczng53jdb0j9x5vqc0ry","欧洲多国逾115家超市制冷系统遭攻击，门店被迫处置变质商品","攻击者远程修改欧洲多国超市冷柜和制冷系统的温度设置、关闭制冷设备或启动除霜，导致超过115家门店受到影响，并造成商品损失和提前营业干预。","BleepingComputer","https://www.bleepingcomputer.com/news/security/hackers-disrupt-refrigeration-systems-at-european-supermarkets/","2026-11-02T14:28:39.000Z","/dailyinfo/media/198a4d86de90e233.webp","/dailyinfo/media/3a544a742516b0af.webp 48w, /dailyinfo/media/198a4d86de90e233.webp 96w","oo2yl4ebtd0m7hsffm7bci8np","Microsoft 披露攻击者利用 ARTEX 批量搜寻 GitHub 密钥并入侵 Azure","Microsoft 观察到攻击者使用 ARTEX 等 Agentic AI 框架批量查询 GitHub 公开仓库，寻找应用凭据、AI 推理 API 密钥等敏感信息，并自动分析结果发动后续攻击。","Microsoft Security Blog","https://www.microsoft.com/en-us/security/blog/2026/11/05/threat-actors-use-agentic-ai-tooling-to-find-and-abuse-exposed-secrets/","2026-11-05T23:46:50.000Z","uu0z6mo1muhhj4bo1sst643w9","FBI 将 Binance 63 亿美元加密资产窃取案归因于朝鲜 TraderTraitor","FBI 确认朝鲜国家支持的 TraderTraitor 实施了 Binance 加密资产窃取案，涉及 2026 年 10 月 29 日前后超过 $6 billion 的虚拟资产，攻击者通过入侵 DevOps 工程师笔记本进入服务容器并提交未授权提现交易。","https://www.bleepingcomputer.com/news/security/fbi-links-63-billion-binance-crypto-heist-to-north-korean-hackers/","2026-11-01T19:57:53.000Z","wbjzunigapakv96vd54t9g53c","Google 联合处置 XCPE 僵尸网络，Videostrong 预装后门感染逾 130 万台机顶盒","Google 与行业伙伴已拆除 XCPE 后门相关控制基础设施，该后门将超过 1.3 million 台机顶盒及其他 Android IoT 设备纳入僵尸网络。","Google Cloud 威胁情报","https://cloud.google.com/blog/topics/threat-intelligence/shutting-the-door-on-the-xcpe-botnet/","2026-11-02T14:00:00.000Z","/dailyinfo/media/424bd6373c2d87d6.webp","/dailyinfo/media/9a88f7a6491d815b.webp 48w, /dailyinfo/media/424bd6373c2d87d6.webp 96w","Sekoia 称，俄罗斯关联威胁组织 APT29 借被入侵网站、仿冒域名和乌克兰 Plerdy SEO Tracker 供应链攻击开展名为 Poisoned Source 的水坑活动，向 iOS 与 Android 用户投递 N-day 利用链并窃取浏览器 Cookie、Wi-Fi 密码及移动设备数据。","https://thehackernews.com/2026/11/apt29-linked-hackers-hijack-web.html","2026-11-04T14:27:52.000Z","漏洞与在野利用","多起已披露高危漏洞迅速被利用，涵盖身份认证绕过、SQL 注入和权限提升，Ivanti Connect Secure 的零日漏洞还可链式获取未认证 root 权限并窃取敏感凭据。",[166,167,168,169,170,171,172,173,174,175],{"_73":232,"_23":233,"_69":234,"_77":206,"_79":235,"_81":236,"_83":-5,"_87":90,"_89":90},{"_73":227,"_23":228,"_69":229,"_77":206,"_79":230,"_81":231,"_83":-5,"_87":90,"_89":90},{"_73":219,"_23":220,"_69":221,"_77":222,"_79":223,"_81":224,"_83":225,"_85":226,"_87":90,"_89":90},{"_73":214,"_23":215,"_69":216,"_77":206,"_79":217,"_81":218,"_83":-5,"_87":90,"_89":90},{"_73":209,"_23":210,"_69":211,"_77":206,"_79":212,"_81":213,"_83":-5,"_87":90,"_89":90},{"_73":203,"_23":204,"_69":205,"_77":206,"_79":207,"_81":208,"_83":-5,"_87":90,"_89":90},{"_73":197,"_23":198,"_69":199,"_77":200,"_79":201,"_81":202,"_83":-5,"_87":90,"_89":90},{"_73":189,"_23":190,"_69":191,"_77":192,"_79":193,"_81":194,"_83":195,"_85":196,"_87":88,"_89":90},{"_73":181,"_23":182,"_69":183,"_77":184,"_79":185,"_81":186,"_83":187,"_85":188,"_87":88,"_89":90},{"_73":176,"_23":177,"_69":178,"_77":136,"_79":179,"_81":180,"_83":139,"_85":140,"_87":88,"_89":90},"xr0vtk5687xc31yatwi6m3z0m","SonicWall SSL-VPN SAML 认证绕过漏洞 CVE-2026-19868 已被利用","SonicWall SSL-VPN 的 SAML 认证绕过漏洞 CVE-2026-19868 已被用于攻击，攻击者持有另一种认证方式的有效凭据后，可绕过 SAML 认证控制，包括 SAML 强制启用的 MFA。","https://www.bleepingcomputer.com/news/security/sonicwall-warns-of-new-ssl-vpn-mfa-bypass-flaw-exploited-in-attacks/","2026-11-07T00:00:55.000Z","p9mnajvale4nc1xu4o2dinr5e","CISA 将 WordPress 远程代码执行漏洞 CVE-2026-119977 加入 KEV 目录","CISA 将 WordPress 远程代码执行漏洞 CVE-2026-119977 加入 KEV 目录，该漏洞 CVSS 8.1，影响 WordPress 4.7 至 7.1.3。","Security Affairs","https://securityaffairs.com/202394/security/u-s-cisa-adds-wordpress-flaw-to-its-known-exploited-vulnerabilities-catalog-2.html","2026-11-04T09:16:37.000Z","/dailyinfo/media/ef2b2b57fb06e54f.webp","/dailyinfo/media/2adef5b1e4357a03.webp 48w, /dailyinfo/media/ef2b2b57fb06e54f.webp 96w","yfynxgt4s7w5imgek8q7a3gou","OpenSSH CVE-2026-123158 在披露数小时后遭到在野利用","OpenSSH 漏洞 CVE-2026-123158 已被在野利用，Previdian 在漏洞公开不到 9 小时后观察到攻击，并确认其蜜罐上的真实 Alpine Linux 系统被取得 root 权限；目前共记录 8 次尝试，均来自日本地址 89.116.89[.]18。","Help Net Security","https://www.helpnetsecurity.com/2026/11/06/openssh-sshole-cve-2026-123158-exploitation/","2026-11-06T12:49:41.000Z","/dailyinfo/media/06c9ab9de6dbb6a5.webp","/dailyinfo/media/9c1b5fa87b3bafc5.webp 48w, /dailyinfo/media/06c9ab9de6dbb6a5.webp 96w","pswh7gi302afiq1veacas1zfo","Cisco Secure Email Gateway SQL 注入漏洞 CVE-2026-76461 已遭在野利用","Cisco Secure Email Gateway 的 SQL 注入漏洞 CVE-2026-76461 已被在野利用，未经身份验证的远程攻击者可通过发送含恶意 SQL 语句的邮件，在底层操作系统以 root 权限执行命令。","Cisco PSIRT","https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-esa-inj-2bLVGmhX?vs_f=Cisco%20Security%20Advisory%26vs_cat=Security%20Intelligence%26vs_type=RSS%26vs_p=Cisco%20Secure%20Email%20Gateway%20SQL%20Injection%20Vulnerability%26vs_k=1","2026-11-03T09:05:12.000Z","p3l7vk5l199h68wksyf6etvvm","Linux Kernel IPv4 TCP 释放后重用漏洞 CVE-2026-98432 已复现","奇安信 CERT 已复现 Linux Kernel IPv4 TCP 释放后重用漏洞 CVE-2026-98432，该漏洞源于 IPv4 TCP 握手处理竞态，可通过网络触发内核内存损坏、绕过 KASLR 的信息泄露、拒绝服务，并在特定 MPTCP 监听条件下实现远程任意代码执行和获取 root 权限。","奇安信 CERT","https://mp.weixin.qq.com/s?__biz=MzU5NDgxODU1MQ==&mid=2247507998&idx=1&sn=be5814f110096f1e65ec30a7a35c573f","2026-11-03T09:44:00.000Z","zn3wl1ipk6y4uimbmwjbo86fy","Microsoft Windows Update Stack 本地权限提升漏洞 CVE-2026-81963 已复现并发现在野利用","Microsoft Windows Update Stack 本地权限提升漏洞 CVE-2026-81963 已发现真实利用，奇安信 CERT 已成功复现；攻击者需取得目标主机低权限账户，可借更新栈未正确校验重解析点将权限提升至 SYSTEM。","https://mp.weixin.qq.com/s?__biz=MzU5NDgxODU1MQ==&mid=2247507987&idx=1&sn=0725706555a43c3a36e4f766b32e7427","2026-11-02T08:51:00.000Z","p0n6ok2brl2a0nzaveu5s7rhg","WordPress Core CVE-2026-119977 竞争条件 RCE 漏洞已复现并发现利用","WordPress Core 竞争条件远程代码执行漏洞 CVE-2026-119977 已被奇安信 CERT 成功复现，并监测到在野利用；CVSS 3.1 分数为 8.1，评级高危，PoC 与技术细节均已公开。","https://mp.weixin.qq.com/s?__biz=MzU5NDgxODU1MQ==&mid=2247508010&idx=1&sn=7907e2aaa98df6d9be2a950b5064bac4","2026-11-04T09:26:00.000Z","tqj4dxtikwan2dwzgf1hpjvys","Ivanti Connect Secure 三个零日漏洞已被链式利用，CVE-2026-111357 与 CVE-2026-118527 纳入 KEV","Ivanti Connect Secure 的 CVE-2026-111357、CVE-2026-118527 与 CVE-2026-104935 已被链式利用，可获取未认证 root 权限并窃取 Windows LAPS 密码和 BitLocker 恢复密钥，UTA0576 自 2026 年 10 月 3 日起攻击运行 22.8R2.4 的设备，影响客户数量有限。","Rapid7 CVE 公告","https://www.rapid7.com/blog/post/etr-additional-ivanti-connect-secure-zero-days-exploited-in-the-wild-cve-2026-111357-cve-2026-118527","2026-11-02T11:04:08.000Z","/dailyinfo/media/092fbeae5b5c3123.webp","/dailyinfo/media/c16323cf53c574df.webp 48w, /dailyinfo/media/092fbeae5b5c3123.webp 96w","ytzdcdfugpd0nnciko21ou59j","Synology DSM 身份认证绕过漏洞 CVE-2026-13639 已复现并被勒索软件利用","Synology DSM 身份认证绕过漏洞 CVE-2026-13639 已被 C3RB3R / L0CK3D 勒索软件用于初始入侵，奇安信 CERT 已完成复现。","https://mp.weixin.qq.com/s?__biz=MzU5NDgxODU1MQ==&mid=2247508031&idx=1&sn=be47d2b6316db564dc261a0d5a42bcd1","2026-11-05T11:48:00.000Z","f4tnsgkfdc79pquzklp0yrld2","OpenSSH/musl 密码认证绕过漏洞 QVD-2026-104595 已复现，CVSS 3.1 9.8","OpenSSH/musl 密码认证绕过漏洞 QVD-2026-104595 已由奇安信 CERT 复现，CVSS 3.1 分数 9.8，评级为高危，影响量为千万级。","https://mp.weixin.qq.com/s?__biz=MzU5NDgxODU1MQ==&mid=2247508041&idx=1&sn=298ed9e842bc1bb98241c38a3c69b57d","2026-11-06T01:31:00.000Z",{"_73":152,"_23":153,"_69":154,"_77":155,"_79":156,"_81":157,"_83":158,"_85":159,"_87":88,"_89":90},{"_73":147,"_23":148,"_69":149,"_77":136,"_79":150,"_81":151,"_83":139,"_85":140,"_87":88,"_89":90},{"_73":74,"_23":75,"_69":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":86,"_87":88,"_89":90},"leadParagraph",{"_242":243,"_244":-5},"changelogVersion","2026-10-01T08:00","release"]
