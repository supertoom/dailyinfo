[{"_1":2,"_3":4},"root",{"_5":130},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1794616600000,{"_104":105,"_55":106,"_107":108,"_109":110,"_111":112,"_113":114,"_115":116,"_117":118,"_119":120,"_121":122,"_123":124},"modules",{},"items",[20,21,22,23],"page",1,"pageCount","pageSize",20,{"_24":88,"_26":89,"_28":90,"_30":91,"_32":92,"_34":93,"_36":94,"_37":79,"_39":95,"_41":96,"_43":44,"_45":46,"_47":-5},{"_24":72,"_26":73,"_28":74,"_30":75,"_32":76,"_34":77,"_36":78,"_37":79,"_39":80,"_41":81,"_43":44,"_45":46,"_47":-5},{"_24":57,"_26":58,"_28":59,"_30":60,"_32":61,"_34":62,"_36":63,"_37":38,"_39":64,"_41":65,"_43":44,"_45":46,"_47":-5},{"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":35,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":-5},"id","k7ipsyk0klmephm2ku2k7oca6","title","VMware vCenter 未认证路径穿越漏洞 CVE-2026-59310 已复现并遭在野利用","summary","VMware vCenter Server syslog 未认证路径穿越漏洞 CVE-2026-59310 已被成功复现，并确认遭在野利用且用于勒索活动。","reason","原文包含成功复现、完整利用前提、受影响版本与官方修复信息，可用于核对资产暴露和处置优先级。","source",{"_55":56},"publishedAt","2026-09-24T11:04:00.000Z","timelineAt","category","vuln","tags",[48,49,50,51,52,53,54],"score",88,"selected",true,"channel","news","x","漏洞","复现","在野利用","漏洞分析","勒索","云原生","VMware","name","微步在线研究响应中心","j6t2sz63bs1xyn52xnv400c6t","CISA 将 Broadcom VMWare ESX 与 Linux Kernel 两项在野利用漏洞纳入 KEV Catalog","CISA 因已有在野利用证据，将 CVE-2026-41709 Broadcom VMWare ESX 日志不足漏洞和 CVE-2026-46300 Linux Kernel 变量未初始化漏洞纳入 KEV Catalog。BOD 26-04 要求 FCEB 机构优先修复公开资产中可在利用后取得完全控制权的高风险 KEV 漏洞，并按要求检查补丁应用前系统是否已被攻陷。","两项漏洞因已有在野利用证据被纳入 KEV Catalog，并明确了联邦机构优先修复与受侵核查要求。",{"_55":71},"2026-10-28T12:00:00.000Z","2026-10-29T00:16:01.148Z",[50,66,48,67,54,68,69,70],71,"漏洞管理","内核","CISA","Red Hat","NVD","CISA 安全公告","nru76rq7mt94ig342f9nxq5ql","Warp Panda 利用 VMware ESX 漏洞 CVE-2026-41709 隐藏审计轨迹","Warp Panda 已在针对美国法律行业的攻击中利用 VMware ESX 漏洞 CVE-2026-41709，通过管理员权限执行未记录操作来降低审计轨迹可见性，CISA 已将其加入 KEV。","原文披露了 CVE-2026-41709 的真实利用方式、受影响版本与修复期限，并说明攻击者如何借审计日志缺失扩大隐蔽访问。",{"_55":87},"2026-10-29T06:22:33.000Z","2026-10-29T07:32:48.956Z","activity",[82,50,83,84,54,85,68,86],72,"攻击活动","漏洞利用","后门","CrowdStrike","Google","The Hacker News","h9lynekay3g8pb2185is1c37g","攻击者利用 PHP2Shell 入侵 Check Point 网关并部署 VMware ESXi 数据擦除器","攻击者利用 PHP2Shell 漏洞 CVE-2026-109618 和 CVE-2026-109619 入侵 Check Point Security Gateway 的 Mobile Access 门户。","材料还原了从网关入侵、提权、横向移动到数据擦除的完整攻击链，并提供了补丁与入侵排查线索。",{"_55":103},"2026-11-13T16:21:43.000Z","2026-11-13T16:37:24.630Z",[82,50,83,84,97,98,99,54,68,100,101,102],92,"数据泄露","供应链","Check Point","AWS","ESET","Ivanti","BleepingComputer","slug","vmware","VMware / Broadcom","group","company","definition","ESXi、vCenter 等产品的安全公告与在野利用。","brand",{"_126":-5,"_127":128,"_129":118},"total",4,"recent",3,"indexable",false,"latest",{"_26":89,"_125":94},"groupName","厂商与机构","poolTotal",16,"at","src","monogram","V","raster",{"_131":132,"_133":-5},"changelogVersion","2026-10-01T08:00","release"]
