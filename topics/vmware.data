[{"_1":2,"_3":4},"root",{"_5":113},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1794357412000,{"_87":88,"_54":89,"_90":91,"_92":93,"_94":95,"_96":97,"_98":99,"_100":101,"_102":103,"_104":105,"_106":107},"modules",{},"items",[20,21,22],"page",1,"pageCount","pageSize",20,{"_23":71,"_25":72,"_27":73,"_29":74,"_31":75,"_33":76,"_35":77,"_36":78,"_38":79,"_40":80,"_42":43,"_44":45,"_46":-5},{"_23":56,"_25":57,"_27":58,"_29":59,"_31":60,"_33":61,"_35":62,"_36":37,"_38":63,"_40":64,"_42":43,"_44":45,"_46":-5},{"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":34,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":-5},"id","k7ipsyk0klmephm2ku2k7oca6","title","VMware vCenter 未认证路径穿越漏洞 CVE-2026-59310 已复现并遭在野利用","summary","VMware vCenter Server syslog 未认证路径穿越漏洞 CVE-2026-59310 已被成功复现，并确认遭在野利用且用于勒索活动。","reason","原文包含成功复现、完整利用前提、受影响版本与官方修复信息，可用于核对资产暴露和处置优先级。","source",{"_54":55},"publishedAt","2026-09-24T11:04:00.000Z","timelineAt","category","vuln","tags",[47,48,49,50,51,52,53],"score",88,"selected",true,"channel","news","x","漏洞","复现","在野利用","漏洞分析","勒索","云原生","VMware","name","微步在线研究响应中心","j6t2sz63bs1xyn52xnv400c6t","CISA 将 Broadcom VMWare ESX 与 Linux Kernel 两项在野利用漏洞纳入 KEV Catalog","CISA 因已有在野利用证据，将 CVE-2026-41709 Broadcom VMWare ESX 日志不足漏洞和 CVE-2026-46300 Linux Kernel 变量未初始化漏洞纳入 KEV Catalog。BOD 26-04 要求 FCEB 机构优先修复公开资产中可在利用后取得完全控制权的高风险 KEV 漏洞，并按要求检查补丁应用前系统是否已被攻陷。","两项漏洞因已有在野利用证据被纳入 KEV Catalog，并明确了联邦机构优先修复与受侵核查要求。",{"_54":70},"2026-10-28T12:00:00.000Z","2026-10-29T00:16:01.148Z",[49,65,47,66,53,67,68,69],71,"漏洞管理","内核","CISA","Red Hat","NVD","CISA 安全公告","nru76rq7mt94ig342f9nxq5ql","Warp Panda 利用 VMware ESX 漏洞 CVE-2026-41709 隐藏审计轨迹","Warp Panda 已在针对美国法律行业的攻击中利用 VMware ESX 漏洞 CVE-2026-41709，通过管理员权限执行未记录操作来降低审计轨迹可见性，CISA 已将其加入 KEV。","原文披露了 CVE-2026-41709 的真实利用方式、受影响版本与修复期限，并说明攻击者如何借审计日志缺失扩大隐蔽访问。",{"_54":86},"2026-10-29T06:22:33.000Z","2026-10-29T07:32:48.956Z","activity",[81,49,82,83,53,84,67,85],72,"攻击活动","漏洞利用","后门","CrowdStrike","Google","The Hacker News","slug","vmware","VMware / Broadcom","group","company","definition","ESXi、vCenter 等产品的安全公告与在野利用。","brand",{"_109":-5,"_110":111,"_112":101},"total",3,"recent",2,"indexable",false,"latest",{"_25":72,"_108":77},"groupName","厂商与机构","poolTotal",11,"at","src","monogram","V","raster",{"_114":115,"_116":-5},"changelogVersion","2026-10-01T08:00","release"]
