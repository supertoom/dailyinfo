[{"_1":2,"_3":4},"root",{"_5":153},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795135012000,{"_127":128,"_57":129,"_130":131,"_132":133,"_134":135,"_136":137,"_138":139,"_140":141,"_142":143,"_144":145,"_146":147},"modules",{},"items",[20,21,22,23,24,25],"page",1,"pageCount","pageSize",20,{"_26":117,"_28":118,"_30":119,"_32":120,"_34":121,"_36":122,"_38":123,"_39":40,"_41":124,"_43":125,"_45":46,"_47":48,"_49":-5},{"_26":106,"_28":107,"_30":108,"_32":109,"_34":110,"_36":111,"_38":112,"_39":40,"_41":113,"_43":114,"_45":46,"_47":48,"_49":-5},{"_26":90,"_28":91,"_30":92,"_32":93,"_34":94,"_36":95,"_38":96,"_39":81,"_41":97,"_43":98,"_45":46,"_47":48,"_49":-5},{"_26":74,"_28":75,"_30":76,"_32":77,"_34":78,"_36":79,"_38":80,"_39":81,"_41":82,"_43":83,"_45":46,"_47":48,"_49":-5},{"_26":59,"_28":60,"_30":61,"_32":62,"_34":63,"_36":64,"_38":65,"_39":40,"_41":66,"_43":67,"_45":46,"_47":48,"_49":-5},{"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":37,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48,"_49":-5},"id","k7ipsyk0klmephm2ku2k7oca6","title","VMware vCenter 未认证路径穿越漏洞 CVE-2026-59310 已复现并遭在野利用","summary","VMware vCenter Server syslog 未认证路径穿越漏洞 CVE-2026-59310 已被成功复现，并确认遭在野利用且用于勒索活动。","reason","原文包含成功复现、完整利用前提、受影响版本与官方修复信息，可用于核对资产暴露和处置优先级。","source",{"_57":58},"publishedAt","2026-09-24T11:04:00.000Z","timelineAt","category","vuln","tags",[50,51,52,53,54,55,56],"score",88,"selected",true,"channel","news","x","漏洞","复现","在野利用","漏洞分析","勒索","云原生","VMware","name","微步在线研究响应中心","j6t2sz63bs1xyn52xnv400c6t","CISA 将 Broadcom VMWare ESX 与 Linux Kernel 两项在野利用漏洞纳入 KEV Catalog","CISA 因已有在野利用证据，将 CVE-2026-41709 Broadcom VMWare ESX 日志不足漏洞和 CVE-2026-46300 Linux Kernel 变量未初始化漏洞纳入 KEV Catalog。BOD 26-04 要求 FCEB 机构优先修复公开资产中可在利用后取得完全控制权的高风险 KEV 漏洞，并按要求检查补丁应用前系统是否已被攻陷。","两项漏洞因已有在野利用证据被纳入 KEV Catalog，并明确了联邦机构优先修复与受侵核查要求。",{"_57":73},"2026-10-28T12:00:00.000Z","2026-10-29T00:16:01.148Z",[52,68,50,69,56,70,71,72],71,"漏洞管理","内核","CISA","Red Hat","NVD","CISA 安全公告","nru76rq7mt94ig342f9nxq5ql","Warp Panda 利用 VMware ESX 漏洞 CVE-2026-41709 隐藏审计轨迹","Warp Panda 已在针对美国法律行业的攻击中利用 VMware ESX 漏洞 CVE-2026-41709，通过管理员权限执行未记录操作来降低审计轨迹可见性，CISA 已将其加入 KEV。","原文披露了 CVE-2026-41709 的真实利用方式、受影响版本与修复期限，并说明攻击者如何借审计日志缺失扩大隐蔽访问。",{"_57":89},"2026-10-29T06:22:33.000Z","2026-10-29T07:32:48.956Z","activity",[84,52,85,86,56,87,70,88],72,"攻击活动","漏洞利用","后门","CrowdStrike","Google","The Hacker News","h9lynekay3g8pb2185is1c37g","攻击者利用 PHP2Shell 入侵 Check Point 网关并部署 VMware ESXi 数据擦除器","攻击者利用 PHP2Shell 漏洞 CVE-2026-109618 和 CVE-2026-109619 入侵 Check Point Security Gateway 的 Mobile Access 门户。","材料还原了从网关入侵、提权、横向移动到数据擦除的完整攻击链，并提供了补丁与入侵排查线索。",{"_57":105},"2026-11-13T16:21:43.000Z","2026-11-13T16:37:24.630Z",[84,52,85,86,99,100,101,56,70,102,103,104],92,"数据泄露","供应链","Check Point","AWS","ESET","Ivanti","BleepingComputer","oy8aa1yf0lb6hllwj6lpg2yh4","VMware vCenter 认证绕过漏洞 CVE-2026-123890，CVSS 9.8","VMware vCenter 存在认证绕过漏洞 CVE-2026-123890，CVSS 评分 9.8，具备网络访问权限的攻击者可绕过认证并获得未授权访问。","原文列明受影响版本、认证绕过前提和补丁状态，还提示升级冲突与旧版本处置，可供读者判断升级路径。",{"_57":89},"2026-11-19T15:11:06.000Z","2026-11-19T15:50:21.072Z",[50,115,52,53,116,56,88],76,"补丁","身份与访问","hd19yw6n9on2wachygxhu93xs","VMware vCenter 认证绕过漏洞 CVE-2026-123890 已被 ARMORY CASTLE 利用","VMware vCenter 的认证绕过漏洞 CVE-2026-123890 已被中国关联威胁组织 ARMORY CASTLE 在野利用，最早可追溯至 2026 年 9 月。","材料同时给出真实利用证据、无需凭据的利用条件、应急补丁版本及升级限制，有助于评估暴露风险并安排处置。",{"_57":126},"2026-11-19T21:06:24.000Z","2026-11-19T22:11:22.338Z",[50,52,115,116,56,88],93,"Rapid7 CVE 公告","slug","vmware","VMware / Broadcom","group","company","definition","ESXi、vCenter 等产品的安全公告与在野利用。","brand",{"_149":-5,"_150":151,"_152":141},"total",6,"recent",5,"indexable",false,"latest",{"_28":118,"_148":123},"groupName","厂商与机构","poolTotal",23,"at","src","monogram","V","raster",{"_154":155,"_156":-5},"changelogVersion","2026-10-01T08:00","release"]
