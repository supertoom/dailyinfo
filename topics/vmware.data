[{"_1":2,"_3":4},"root",{"_5":192},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795307810000,{"_166":167,"_60":168,"_169":170,"_171":172,"_173":174,"_175":176,"_177":178,"_179":180,"_181":182,"_183":184,"_185":186},"modules",{},"items",[20,21,22,23,24,25,26,27,28],"page",1,"pageCount","pageSize",20,{"_29":155,"_31":156,"_33":157,"_35":158,"_37":159,"_39":160,"_41":161,"_42":43,"_44":162,"_46":163,"_48":49,"_50":51,"_52":-5},{"_29":145,"_31":146,"_33":147,"_35":148,"_37":149,"_39":150,"_41":151,"_42":43,"_44":152,"_46":86,"_48":49,"_50":51,"_52":-5},{"_29":130,"_31":131,"_33":132,"_35":133,"_37":134,"_39":135,"_41":136,"_42":84,"_44":137,"_46":117,"_48":49,"_50":51,"_52":-5},{"_29":120,"_31":121,"_33":122,"_35":123,"_37":124,"_39":125,"_41":126,"_42":43,"_44":127,"_46":128,"_48":49,"_50":51,"_52":-5},{"_29":109,"_31":110,"_33":111,"_35":112,"_37":113,"_39":114,"_41":115,"_42":43,"_44":116,"_46":117,"_48":49,"_50":51,"_52":-5},{"_29":93,"_31":94,"_33":95,"_35":96,"_37":97,"_39":98,"_41":99,"_42":84,"_44":100,"_46":101,"_48":49,"_50":51,"_52":-5},{"_29":77,"_31":78,"_33":79,"_35":80,"_37":81,"_39":82,"_41":83,"_42":84,"_44":85,"_46":86,"_48":49,"_50":51,"_52":-5},{"_29":62,"_31":63,"_33":64,"_35":65,"_37":66,"_39":67,"_41":68,"_42":43,"_44":69,"_46":70,"_48":49,"_50":51,"_52":-5},{"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":40,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":-5},"id","k7ipsyk0klmephm2ku2k7oca6","title","VMware vCenter 未认证路径穿越漏洞 CVE-2026-59310 已复现并遭在野利用","summary","VMware vCenter Server syslog 未认证路径穿越漏洞 CVE-2026-59310 已被成功复现，并确认遭在野利用且用于勒索活动。","reason","原文包含成功复现、完整利用前提、受影响版本与官方修复信息，可用于核对资产暴露和处置优先级。","source",{"_60":61},"publishedAt","2026-09-24T11:04:00.000Z","timelineAt","category","vuln","tags",[53,54,55,56,57,58,59],"score",88,"selected",true,"channel","news","x","漏洞","复现","在野利用","漏洞分析","勒索","云原生","VMware","name","微步在线研究响应中心","j6t2sz63bs1xyn52xnv400c6t","CISA 将 Broadcom VMWare ESX 与 Linux Kernel 两项在野利用漏洞纳入 KEV Catalog","CISA 因已有在野利用证据，将 CVE-2026-41709 Broadcom VMWare ESX 日志不足漏洞和 CVE-2026-46300 Linux Kernel 变量未初始化漏洞纳入 KEV Catalog。BOD 26-04 要求 FCEB 机构优先修复公开资产中可在利用后取得完全控制权的高风险 KEV 漏洞，并按要求检查补丁应用前系统是否已被攻陷。","两项漏洞因已有在野利用证据被纳入 KEV Catalog，并明确了联邦机构优先修复与受侵核查要求。",{"_60":76},"2026-10-28T12:00:00.000Z","2026-10-29T00:16:01.148Z",[55,71,53,72,59,73,74,75],71,"漏洞管理","内核","CISA","Red Hat","NVD","CISA 安全公告","nru76rq7mt94ig342f9nxq5ql","Warp Panda 利用 VMware ESX 漏洞 CVE-2026-41709 隐藏审计轨迹","Warp Panda 已在针对美国法律行业的攻击中利用 VMware ESX 漏洞 CVE-2026-41709，通过管理员权限执行未记录操作来降低审计轨迹可见性，CISA 已将其加入 KEV。","原文披露了 CVE-2026-41709 的真实利用方式、受影响版本与修复期限，并说明攻击者如何借审计日志缺失扩大隐蔽访问。",{"_60":92},"2026-10-29T06:22:33.000Z","2026-10-29T07:32:48.956Z","activity",[87,55,88,89,59,90,73,91],72,"攻击活动","漏洞利用","后门","CrowdStrike","Google","The Hacker News","h9lynekay3g8pb2185is1c37g","攻击者利用 PHP2Shell 入侵 Check Point 网关并部署 VMware ESXi 数据擦除器","攻击者利用 PHP2Shell 漏洞 CVE-2026-109618 和 CVE-2026-109619 入侵 Check Point Security Gateway 的 Mobile Access 门户。","材料还原了从网关入侵、提权、横向移动到数据擦除的完整攻击链，并提供了补丁与入侵排查线索。",{"_60":108},"2026-11-13T16:21:43.000Z","2026-11-13T16:37:24.630Z",[87,55,88,89,102,103,104,59,73,105,106,107],92,"数据泄露","供应链","Check Point","AWS","ESET","Ivanti","BleepingComputer","oy8aa1yf0lb6hllwj6lpg2yh4","VMware vCenter 认证绕过漏洞 CVE-2026-123890，CVSS 9.8","Broadcom 披露 VMware vCenter 认证绕过漏洞 CVE-2026-123890，攻击者仅需网络访问即可绕过认证并获得未授权访问，CVSS 评分 9.8。","公告给出了受影响版本、CVSS 9.8 评分和升级兼容问题，可帮助管理员评估更新路径与业务影响。",{"_60":92},"2026-11-19T15:11:06.000Z","2026-11-19T15:50:21.072Z",[53,118,119,59],85,"补丁","身份与访问","hd19yw6n9on2wachygxhu93xs","VMware vCenter 认证绕过漏洞 CVE-2026-123890 已被 ARMORY CASTLE 利用","VMware vCenter 的认证绕过漏洞 CVE-2026-123890 已被中国关联威胁组织 ARMORY CASTLE 在野利用，最早可追溯至 2026 年 9 月。","材料同时给出真实利用证据、无需凭据的利用条件、应急补丁版本及升级限制，有助于评估暴露风险并安排处置。",{"_60":129},"2026-11-19T21:06:24.000Z","2026-11-19T22:11:22.338Z",[53,55,118,119,59,91],93,"Rapid7 CVE 公告","do1qix3duahy7w828dz52wk6y","BlackNevas 利用合法 vCenter 管理接口破坏 VMware 虚拟化环境","BlackNevas 通过组织内部获取的凭据进入 VCSA，建立 MeshAgent 与 Ligolo-ng 持久化通道，滥用 vCenter Host Profiles 开启 TSM-SSH，再经 SFTP 向 ESXi 投递加密器；事件导致四台 ESXi 主机及其全部虚拟机、两台 VCSA 和备份基础设施被破坏。","文章还原了凭据滥用、Host Profiles 篡改、备份削弱到 ESXi 引爆的完整链路，并给出可关联监测的管理面预警信号。",{"_60":144},"2026-11-20T04:07:00.000Z","2026-11-20T10:16:30.964Z",[87,57,138,139,103,140,59,141,142,143],"恶意软件","利用链","应急响应","Kaspersky","SentinelOne","Microsoft","奇安信威胁情报中心","sgciwtig86m8ho71b0h3a56f6","VMware vCenter 认证绕过漏洞 CVE-2026-123890 通告，官方已发布修复","深瞳漏洞实验室于2026年11月20日发布漏洞通告，VMware vCenter 存在认证绕过漏洞 CVE-2026-123890，威胁等级为高危。","通告给出了逐版本的受影响区间、无需凭据即可建立管理员会话的利用条件，以及各版本可用的补丁与升级路径，便于读者快速判断自身资产是否受影响。",{"_60":154},"2026-11-20T09:49:00.000Z","2026-11-20T17:23:31.424Z",[53,118,56,119,59,153],"深信服","深信服千里目安全实验室","jbitkvf4i6iewvak8ejgx9cvb","CISA 将 Apache Roller、Cisco Expressway、SAP NetWeaver 和 VMware vCenter 四项漏洞列入 KEV","CISA 将 Apache Roller、Cisco Expressway、SAP NetWeaver 和 VMware vCenter 的 4 个漏洞列入 KEV，依据是已发现活跃利用证据。","四条漏洞已进入 KEV，其中 Apache Roller、VMware vCenter 等已有利用线索，文中还给出了各漏洞的触发条件、修复时间与处置期限。",{"_60":92},"2026-11-21T08:49:13.000Z","2026-11-21T09:24:45.971Z",[53,55,118,88,164,71,165,59,73],83,"数据窃取","Cisco","slug","vmware","VMware / Broadcom","group","company","definition","ESXi、vCenter 等产品的安全公告与在野利用。","brand",{"_188":-5,"_189":190,"_191":180},"total",9,"recent",8,"indexable",false,"latest",{"_31":156,"_187":161},"groupName","厂商与机构","poolTotal",32,"at","src","monogram","V","raster",{"_193":194,"_195":-5},"changelogVersion","2026-10-01T08:00","release"]
