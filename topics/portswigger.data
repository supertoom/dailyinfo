[{"_1":2,"_3":4},"root",{"_5":78},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1793621388000,{"_54":55,"_52":51,"_56":57,"_58":59,"_60":61,"_62":16,"_63":64,"_65":66,"_67":68,"_69":70,"_71":72},"modules",{},"items",[20],"page",1,"pageCount","pageSize",20,{"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":32,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5},"id","drrluvywk0gq5svlc35b6bb9s","title","PortSwigger Research 发布 HTTP Terminator 自主攻击技术研究","summary","PortSwigger Research 发布 HTTP Terminator 自主系统及源代码，用于生成并测试新的 HTTP desync 攻击技术。系统读取 138 份技术规范，提出 30,000 个攻击向量，在经授权的 bug bounty 目标上确认约 700 个脆弱目标，并公开研究流程与可复用蓝图。","reason","该研究展示了自主系统将研究方法转化为攻击技术的流程，并揭示人类判断在发现链中的关键作用。","source",{"_52":53},"publishedAt","2026-08-12T09:04:45.000Z","timelineAt","category","ai-security","tags",[45,46,47,48,49,50,51],"score",72,"selected",true,"channel","news","x","AI 安全","Agent 安全","AI 攻防","技术研究","论文","工具发布","PortSwigger","name","PortSwigger Research","slug","portswigger","group","company","definition","Web 安全研究、Burp Suite 的新功能与 Web 漏洞的成因分析。","brand",{"_74":-5,"_75":76,"_77":66},"total","recent",0,"indexable",false,"latest",{"_23":24,"_73":32},"groupName","厂商与机构","poolTotal",9,"at","src","monogram","P","raster",{"_79":80,"_81":-5},"changelogVersion","2026-10-01T08:00","release"]
