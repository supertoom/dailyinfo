[{"_1":2,"_3":4},"root",{"_5":118},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1794616599000,{"_94":95,"_54":52,"_96":97,"_98":99,"_100":101,"_102":103,"_104":103,"_105":106,"_107":108,"_109":110,"_111":112},"modules",{},"items",[20,21,22,23],"page",1,"pageCount","pageSize",20,{"_24":80,"_26":81,"_28":82,"_30":83,"_32":84,"_34":85,"_36":86,"_37":87,"_39":88,"_41":89,"_43":44,"_45":46,"_47":-5},{"_24":69,"_26":70,"_28":71,"_30":72,"_32":73,"_34":74,"_36":75,"_37":38,"_39":76,"_41":77,"_43":44,"_45":46,"_47":-5},{"_24":56,"_26":57,"_28":58,"_30":59,"_32":60,"_34":61,"_36":61,"_37":62,"_39":63,"_41":64,"_43":44,"_45":46,"_47":-5},{"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":35,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":-5},"id","b5nn1bd55kl7m066s3q42xuet","title","PHP php2shell 漏洞 CVE-2026-109618、CVE-2026-109619 影响 PHP 5.4 及以上版本并已出现攻击流量","summary","PHP 5.4 及以上运行时的 php2shell 漏洞 CVE-2026-109618、CVE-2026-109619 可能通过特制 HTTP 请求造成拒绝服务、远程代码执行和数据暴露，Cloudflare 已观察到针对客户的攻击流量。","reason","原文披露漏洞成因与修复版本，并说明 WAF 防护范围、攻击观察和完整交易检测方法，便于评估风险与处置优先级。","source",{"_54":55},"publishedAt","2026-10-21T13:56:45.000Z","timelineAt","category","vuln","tags",[48,49,50,51,52,53],"score",90,"selected",true,"channel","news","x","漏洞","在野利用","补丁","漏洞分析","Cloudflare","PHP","name","Cloudflare Blog","nzzcilkbztxbi4lagit64ikms","Cloudflare 披露 GLM-5.3 Workers AI 跨请求 KV cache 数据泄露及修复","Cloudflare 与 SGLang 联合披露 GLM-5.3 Workers AI 模型（@cf/zai-org/glm-5.3）的跨请求 KV cache 泄露问题，8 月 27 日至 9 月 9 日共有 155 个长于 681,280 tokens 的请求响应包含其他客户请求数据。","原文拆解了配置错配与 SGLang 缺陷共同造成的跨请求 KV cache 泄露，并给出修复版本、部署检查和检测建议。",{"_54":55},"2026-10-26T22:01:23.000Z","ai-security",[65,66,48,67,50,68,52],88,"AI 安全","大模型","数据泄露","Agent 安全","ashq9zaym8iojmnulqhy7xxeb","Cloudflare 披露 eMudhra 弱私钥在野伪造活动与客户端修补进展","Cloudflare 确认 eMudhra 的8个可从公开证书恢复的弱私钥已被用于签发伪造证书，其中一张伪造证书在密钥问题公开后不到1小时生成。Cloudflare 在一周内记录约22,000次使用弱密钥的尝试握手，所有启用证书验证的连接均被拒绝，尚未发现这些密钥用于拦截 Cloudflare 连接或系统失陷。","文章结合约22,000次弱密钥握手和5000万次探测数据，揭示证书伪造活动及各类客户端仍未修补的现状。",{"_54":55},"2026-10-30T17:38:50.000Z","2026-10-30T17:45:15.060Z",[48,49,50,51,78,52,79],86,"加密","Mozilla","kwq30stubj3ryg11q7j0ngxx8","Cloudflare 披露 AI 渗透测试编排框架激增与凭据链式利用","Cloudflare 指出，AI 渗透测试与利用编排框架正快速扩散，3天内已有 50 多个框架家族扫描其全球客户，相关 IP 达数千个；截至 11 月 12 日，ARTEX 及其分支占已知框架的 60% 以上。","文章结合全球扫描与事件响应观测，说明 AI 渗透编排框架的扩散速度、凭据链式利用及可落地的六层防护框架。",{"_54":55},"2026-11-13T19:26:07.000Z","2026-11-13T20:02:29.322Z","activity",[90,65,68,91,92,93,52],76,"攻击活动","AI 攻防","凭据","云原生","slug","cloudflare","group","company","definition","CDN 与网络协议层面的安全研究、防护规则与互联网测量。","brand",{"_114":-5,"_115":116,"_117":106},"total",4,"recent","indexable",false,"latest",{"_26":81,"_113":86},"groupName","厂商与机构","poolTotal",21,"at","src","monogram","C","raster",{"_119":120,"_121":-5},"changelogVersion","2026-10-01T08:00","release"]
