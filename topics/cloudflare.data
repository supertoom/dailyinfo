[{"_1":2,"_3":4},"root",{"_5":133},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1794962215000,{"_109":110,"_55":53,"_111":112,"_113":114,"_115":116,"_117":118,"_119":118,"_120":121,"_122":123,"_124":125,"_126":127},"modules",{},"items",[20,21,22,23,24],"page",1,"pageCount","pageSize",20,{"_25":95,"_27":96,"_29":97,"_31":98,"_33":99,"_35":100,"_37":101,"_38":88,"_40":102,"_42":103,"_44":45,"_46":47,"_48":-5},{"_25":81,"_27":82,"_29":83,"_31":84,"_33":85,"_35":86,"_37":87,"_38":88,"_40":89,"_42":90,"_44":45,"_46":47,"_48":-5},{"_25":70,"_27":71,"_29":72,"_31":73,"_33":74,"_35":75,"_37":76,"_38":39,"_40":77,"_42":78,"_44":45,"_46":47,"_48":-5},{"_25":57,"_27":58,"_29":59,"_31":60,"_33":61,"_35":62,"_37":62,"_38":63,"_40":64,"_42":65,"_44":45,"_46":47,"_48":-5},{"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":36,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47,"_48":-5},"id","b5nn1bd55kl7m066s3q42xuet","title","PHP php2shell 漏洞 CVE-2026-109618、CVE-2026-109619 影响 PHP 5.4 及以上版本并已出现攻击流量","summary","PHP 5.4 及以上运行时的 php2shell 漏洞 CVE-2026-109618、CVE-2026-109619 可能通过特制 HTTP 请求造成拒绝服务、远程代码执行和数据暴露，Cloudflare 已观察到针对客户的攻击流量。","reason","原文披露漏洞成因与修复版本，并说明 WAF 防护范围、攻击观察和完整交易检测方法，便于评估风险与处置优先级。","source",{"_55":56},"publishedAt","2026-10-21T13:56:45.000Z","timelineAt","category","vuln","tags",[49,50,51,52,53,54],"score",90,"selected",true,"channel","news","x","漏洞","在野利用","补丁","漏洞分析","Cloudflare","PHP","name","Cloudflare Blog","nzzcilkbztxbi4lagit64ikms","Cloudflare 披露 GLM-5.3 Workers AI 跨请求 KV cache 数据泄露及修复","Cloudflare 与 SGLang 联合披露 GLM-5.3 Workers AI 模型（@cf/zai-org/glm-5.3）的跨请求 KV cache 泄露问题，8 月 27 日至 9 月 9 日共有 155 个长于 681,280 tokens 的请求响应包含其他客户请求数据。","原文拆解了配置错配与 SGLang 缺陷共同造成的跨请求 KV cache 泄露，并给出修复版本、部署检查和检测建议。",{"_55":56},"2026-10-26T22:01:23.000Z","ai-security",[66,67,49,68,51,69,53],88,"AI 安全","大模型","数据泄露","Agent 安全","ashq9zaym8iojmnulqhy7xxeb","Cloudflare 披露 eMudhra 弱私钥在野伪造活动与客户端修补进展","Cloudflare 确认 eMudhra 的8个可从公开证书恢复的弱私钥已被用于签发伪造证书，其中一张伪造证书在密钥问题公开后不到1小时生成。Cloudflare 在一周内记录约22,000次使用弱密钥的尝试握手，所有启用证书验证的连接均被拒绝，尚未发现这些密钥用于拦截 Cloudflare 连接或系统失陷。","文章结合约22,000次弱密钥握手和5000万次探测数据，揭示证书伪造活动及各类客户端仍未修补的现状。",{"_55":56},"2026-10-30T17:38:50.000Z","2026-10-30T17:45:15.060Z",[49,50,51,52,79,53,80],86,"加密","Mozilla","kwq30stubj3ryg11q7j0ngxx8","Cloudflare 披露 AI 渗透测试编排框架激增与凭据链式利用","Cloudflare 指出，AI 渗透测试与利用编排框架正快速扩散，3天内已有 50 多个框架家族扫描其全球客户，相关 IP 达数千个；截至 11 月 12 日，ARTEX 及其分支占已知框架的 60% 以上。","文章结合全球扫描与事件响应观测，说明 AI 渗透编排框架的扩散速度、凭据链式利用及可落地的六层防护框架。",{"_55":56},"2026-11-13T19:26:07.000Z","2026-11-13T20:02:29.322Z","activity",[91,66,69,92,93,94,53],76,"攻击活动","AI 攻防","凭据","云原生","cpozl5byqasqocx0exg64utib","攻击者劫持 Optimizely Web Experimentation 脚本，178 家组织网站遭注入","攻击者利用 Optimizely Web Experimentation 漏洞，将恶意 JavaScript 注入 178 家组织的项目，影响 Zoom、BBC、CNN、Salesforce、GitLab、IKEA、HSBC、Equifax 等网站。","案例展示了第三方 JavaScript 供应链如何在受信域名下持续注入恶意代码，并给出项目排查、凭据更换和客户通知建议。",{"_55":108},"2026-11-17T09:38:44.000Z","2026-11-17T11:14:37.674Z",[91,104,105,106,107,53],89,"恶意软件","数据窃取","供应链","移动端","Security Affairs","slug","cloudflare","group","company","definition","CDN 与网络协议层面的安全研究、防护规则与互联网测量。","brand",{"_129":-5,"_130":131,"_132":121},"total",5,"recent","indexable",false,"latest",{"_27":96,"_128":101},"groupName","厂商与机构","poolTotal",22,"at","src","monogram","C","raster",{"_134":135,"_136":-5},"changelogVersion","2026-10-01T08:00","release"]
