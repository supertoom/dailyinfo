[{"_1":2,"_3":4},"root",{"_5":150},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795135011000,{"_126":127,"_56":54,"_128":129,"_130":131,"_132":133,"_134":135,"_136":135,"_137":138,"_139":140,"_141":142,"_143":144},"modules",{},"items",[20,21,22,23,24,25],"page",1,"pageCount","pageSize",20,{"_26":110,"_28":111,"_30":112,"_32":113,"_34":114,"_36":115,"_38":116,"_39":40,"_41":117,"_43":118,"_45":46,"_47":48,"_49":-5},{"_26":96,"_28":97,"_30":98,"_32":99,"_34":100,"_36":101,"_38":102,"_39":89,"_41":103,"_43":104,"_45":46,"_47":48,"_49":-5},{"_26":82,"_28":83,"_30":84,"_32":85,"_34":86,"_36":87,"_38":88,"_39":89,"_41":90,"_43":91,"_45":46,"_47":48,"_49":-5},{"_26":71,"_28":72,"_30":73,"_32":74,"_34":75,"_36":76,"_38":77,"_39":40,"_41":78,"_43":79,"_45":46,"_47":48,"_49":-5},{"_26":58,"_28":59,"_30":60,"_32":61,"_34":62,"_36":63,"_38":63,"_39":64,"_41":65,"_43":66,"_45":46,"_47":48,"_49":-5},{"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":37,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48,"_49":-5},"id","b5nn1bd55kl7m066s3q42xuet","title","PHP php2shell 漏洞 CVE-2026-109618、CVE-2026-109619 影响 PHP 5.4 及以上版本并已出现攻击流量","summary","PHP 5.4 及以上运行时的 php2shell 漏洞 CVE-2026-109618、CVE-2026-109619 可能通过特制 HTTP 请求造成拒绝服务、远程代码执行和数据暴露，Cloudflare 已观察到针对客户的攻击流量。","reason","原文披露漏洞成因与修复版本，并说明 WAF 防护范围、攻击观察和完整交易检测方法，便于评估风险与处置优先级。","source",{"_56":57},"publishedAt","2026-10-21T13:56:45.000Z","timelineAt","category","vuln","tags",[50,51,52,53,54,55],"score",90,"selected",true,"channel","news","x","漏洞","在野利用","补丁","漏洞分析","Cloudflare","PHP","name","Cloudflare Blog","nzzcilkbztxbi4lagit64ikms","Cloudflare 披露 GLM-5.3 Workers AI 跨请求 KV cache 数据泄露及修复","Cloudflare 与 SGLang 联合披露 GLM-5.3 Workers AI 模型（@cf/zai-org/glm-5.3）的跨请求 KV cache 泄露问题，8 月 27 日至 9 月 9 日共有 155 个长于 681,280 tokens 的请求响应包含其他客户请求数据。","原文拆解了配置错配与 SGLang 缺陷共同造成的跨请求 KV cache 泄露，并给出修复版本、部署检查和检测建议。",{"_56":57},"2026-10-26T22:01:23.000Z","ai-security",[67,68,50,69,52,70,54],88,"AI 安全","大模型","数据泄露","Agent 安全","ashq9zaym8iojmnulqhy7xxeb","Cloudflare 披露 eMudhra 弱私钥在野伪造活动与客户端修补进展","Cloudflare 确认 eMudhra 的8个可从公开证书恢复的弱私钥已被用于签发伪造证书，其中一张伪造证书在密钥问题公开后不到1小时生成。Cloudflare 在一周内记录约22,000次使用弱密钥的尝试握手，所有启用证书验证的连接均被拒绝，尚未发现这些密钥用于拦截 Cloudflare 连接或系统失陷。","文章结合约22,000次弱密钥握手和5000万次探测数据，揭示证书伪造活动及各类客户端仍未修补的现状。",{"_56":57},"2026-10-30T17:38:50.000Z","2026-10-30T17:45:15.060Z",[50,51,52,53,80,54,81],86,"加密","Mozilla","kwq30stubj3ryg11q7j0ngxx8","Cloudflare 披露 AI 渗透测试编排框架激增与凭据链式利用","Cloudflare 指出，AI 渗透测试与利用编排框架正快速扩散，3天内已有 50 多个框架家族扫描其全球客户，相关 IP 达数千个；截至 11 月 12 日，ARTEX 及其分支占已知框架的 60% 以上。","文章结合全球扫描与事件响应观测，说明 AI 渗透编排框架的扩散速度、凭据链式利用及可落地的六层防护框架。",{"_56":57},"2026-11-13T19:26:07.000Z","2026-11-13T20:02:29.322Z","activity",[92,67,70,93,94,95,54],76,"攻击活动","AI 攻防","凭据","云原生","cpozl5byqasqocx0exg64utib","攻击者劫持 Optimizely Web Experimentation 脚本，178 家组织网站遭注入","攻击者利用 Optimizely Web Experimentation 漏洞，将恶意 JavaScript 注入 178 家组织的项目，影响 Zoom、BBC、CNN、Salesforce、GitLab、IKEA、HSBC、Equifax 等网站。","案例展示了第三方 JavaScript 供应链如何在受信域名下持续注入恶意代码，并给出项目排查、凭据更换和客户通知建议。",{"_56":109},"2026-11-17T09:38:44.000Z","2026-11-17T11:14:37.674Z",[92,105,106,107,108,54],89,"恶意软件","数据窃取","供应链","移动端","Security Affairs","r5idp638xeh25ay1o0ahw2ys0","OpenJDK Base64 内存破坏漏洞 Java4Shell CVE-2026-114938 的影响与防护","Calif 披露 OpenJDK Base64 解码器内存破坏漏洞 Java4Shell（CVE-2026-114938），CVSS 4.0 评分为 9.2，影响 OpenJDK 17.0.6 及更新版本在支持 AVX-512 VBMI 的 x86-64 处理器上处理攻击者可控 Base64 数据的场景，攻击者无需凭据即可触发越界写入并进一步实现堆内存泄露或 RCE。","文章结合漏洞触发条件、内存破坏原理与多阶段利用链，给出临时关闭高风险代码路径及 WAF 防护配置，便于评估自身 Java 运行时并安排修复。",{"_56":57},"2026-11-18T14:52:10.000Z","2026-11-18T15:41:34.874Z",[50,52,119,120,121,95,54,122,123,124,125],83,"复现","漏洞利用","技术研究","Oracle","Microsoft","Red Hat","Atlassian","slug","cloudflare","group","company","definition","CDN 与网络协议层面的安全研究、防护规则与互联网测量。","brand",{"_146":-5,"_147":148,"_149":138},"total",6,"recent","indexable",false,"latest",{"_28":111,"_145":116},"groupName","厂商与机构","poolTotal",24,"at","src","monogram","C","raster",{"_151":152,"_153":-5},"changelogVersion","2026-10-01T08:00","release"]
