[{"_1":2,"_3":4},"root",{"_5":190},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795653418000,{"_165":166,"_59":57,"_167":168,"_169":170,"_171":172,"_173":174,"_175":176,"_177":178,"_179":180,"_181":182,"_183":184},"modules",{},"items",[20,21,22,23,24,25,26,27,28],"page",1,"pageCount","pageSize",20,{"_29":151,"_31":152,"_33":153,"_35":154,"_37":155,"_39":156,"_41":157,"_42":158,"_44":159,"_46":160,"_48":49,"_50":51,"_52":-5},{"_29":142,"_31":143,"_33":144,"_35":145,"_37":146,"_39":147,"_41":148,"_42":43,"_44":149,"_46":150,"_48":49,"_50":51,"_52":-5},{"_29":129,"_31":130,"_33":131,"_35":132,"_37":133,"_39":134,"_41":135,"_42":43,"_44":136,"_46":137,"_48":49,"_50":51,"_52":-5},{"_29":113,"_31":114,"_33":115,"_35":116,"_37":117,"_39":118,"_41":119,"_42":43,"_44":120,"_46":121,"_48":49,"_50":51,"_52":-5},{"_29":99,"_31":100,"_33":101,"_35":102,"_37":103,"_39":104,"_41":105,"_42":92,"_44":106,"_46":107,"_48":49,"_50":51,"_52":-5},{"_29":85,"_31":86,"_33":87,"_35":88,"_37":89,"_39":90,"_41":91,"_42":92,"_44":93,"_46":94,"_48":49,"_50":51,"_52":-5},{"_29":74,"_31":75,"_33":76,"_35":77,"_37":78,"_39":79,"_41":80,"_42":43,"_44":81,"_46":82,"_48":49,"_50":51,"_52":-5},{"_29":61,"_31":62,"_33":63,"_35":64,"_37":65,"_39":66,"_41":66,"_42":67,"_44":68,"_46":69,"_48":49,"_50":51,"_52":-5},{"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":40,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":-5},"id","b5nn1bd55kl7m066s3q42xuet","title","PHP php2shell 漏洞 CVE-2026-109618、CVE-2026-109619 影响 PHP 5.4 及以上版本并已出现攻击流量","summary","PHP 5.4 及以上运行时的 php2shell 漏洞 CVE-2026-109618、CVE-2026-109619 可能通过特制 HTTP 请求造成拒绝服务、远程代码执行和数据暴露，Cloudflare 已观察到针对客户的攻击流量。","reason","原文披露漏洞成因与修复版本，并说明 WAF 防护范围、攻击观察和完整交易检测方法，便于评估风险与处置优先级。","source",{"_59":60},"publishedAt","2026-10-21T13:56:45.000Z","timelineAt","category","vuln","tags",[53,54,55,56,57,58],"score",90,"selected",true,"channel","news","x","漏洞","在野利用","补丁","漏洞分析","Cloudflare","PHP","name","Cloudflare Blog","nzzcilkbztxbi4lagit64ikms","Cloudflare 披露 GLM-5.3 Workers AI 跨请求 KV cache 数据泄露及修复","Cloudflare 与 SGLang 联合披露 GLM-5.3 Workers AI 模型（@cf/zai-org/glm-5.3）的跨请求 KV cache 泄露问题，8 月 27 日至 9 月 9 日共有 155 个长于 681,280 tokens 的请求响应包含其他客户请求数据。","原文拆解了配置错配与 SGLang 缺陷共同造成的跨请求 KV cache 泄露，并给出修复版本、部署检查和检测建议。",{"_59":60},"2026-10-26T22:01:23.000Z","ai-security",[70,71,53,72,55,73,57],88,"AI 安全","大模型","数据泄露","Agent 安全","ashq9zaym8iojmnulqhy7xxeb","Cloudflare 披露 eMudhra 弱私钥在野伪造活动与客户端修补进展","Cloudflare 确认 eMudhra 的8个可从公开证书恢复的弱私钥已被用于签发伪造证书，其中一张伪造证书在密钥问题公开后不到1小时生成。Cloudflare 在一周内记录约22,000次使用弱密钥的尝试握手，所有启用证书验证的连接均被拒绝，尚未发现这些密钥用于拦截 Cloudflare 连接或系统失陷。","文章结合约22,000次弱密钥握手和5000万次探测数据，揭示证书伪造活动及各类客户端仍未修补的现状。",{"_59":60},"2026-10-30T17:38:50.000Z","2026-10-30T17:45:15.060Z",[53,54,55,56,83,57,84],86,"加密","Mozilla","kwq30stubj3ryg11q7j0ngxx8","Cloudflare 披露 AI 渗透测试编排框架激增与凭据链式利用","Cloudflare 指出，AI 渗透测试与利用编排框架正快速扩散，3天内已有 50 多个框架家族扫描其全球客户，相关 IP 达数千个；截至 11 月 12 日，ARTEX 及其分支占已知框架的 60% 以上。","文章结合全球扫描与事件响应观测，说明 AI 渗透编排框架的扩散速度、凭据链式利用及可落地的六层防护框架。",{"_59":60},"2026-11-13T19:26:07.000Z","2026-11-13T20:02:29.322Z","activity",[95,70,73,96,97,98,57],76,"攻击活动","AI 攻防","凭据","云原生","cpozl5byqasqocx0exg64utib","攻击者劫持 Optimizely Web Experimentation 脚本，178 家组织网站遭注入","攻击者利用 Optimizely Web Experimentation 漏洞，将恶意 JavaScript 注入 178 家组织的项目，影响 Zoom、BBC、CNN、Salesforce、GitLab、IKEA、HSBC、Equifax 等网站。","案例展示了第三方 JavaScript 供应链如何在受信域名下持续注入恶意代码，并给出项目排查、凭据更换和客户通知建议。",{"_59":112},"2026-11-17T09:38:44.000Z","2026-11-17T11:14:37.674Z",[95,108,109,110,111,57],89,"恶意软件","数据窃取","供应链","移动端","Security Affairs","r5idp638xeh25ay1o0ahw2ys0","OpenJDK Base64 内存破坏漏洞 Java4Shell CVE-2026-114938 的影响与防护","Calif 披露 OpenJDK Base64 解码器内存破坏漏洞 Java4Shell（CVE-2026-114938），CVSS 4.0 评分为 9.2，影响 OpenJDK 17.0.6 及更新版本在支持 AVX-512 VBMI 的 x86-64 处理器上处理攻击者可控 Base64 数据的场景，攻击者无需凭据即可触发越界写入并进一步实现堆内存泄露或 RCE。","文章结合漏洞触发条件、内存破坏原理与多阶段利用链，给出临时关闭高风险代码路径及 WAF 防护配置，便于评估自身 Java 运行时并安排修复。",{"_59":60},"2026-11-18T14:52:10.000Z","2026-11-18T15:41:34.874Z",[53,55,122,123,124,98,57,125,126,127,128],83,"复现","漏洞利用","技术研究","Oracle","Microsoft","Red Hat","Atlassian","zp8d6zx3kkva6gw0b0abpm2pv","nginx 披露五项内存破坏漏洞 CVE-2026-123007 等，Cloudflare 分析代理防护边界","F5 与 nginx.org 披露五项 nginx 内存破坏漏洞，未认证攻击者在特定配置下可导致 worker 崩溃，并在禁用或绕过 ASLR 时执行服务器命令；Xint 还发现可由 Docker 容器内提权至宿主机 root 的 Linux SCTP use-after-free。","文章结合源码、AddressSanitizer 测试和流量量级还原五项 nginx 内存破坏漏洞，并厘清 Cloudflare 代理的防护边界与例外。",{"_59":60},"2026-11-20T01:58:29.000Z","2026-11-20T02:14:32.379Z",[53,55,122,56,138,139,57,140,141],82,"内核","容器","Rapid7","Palo Alto","jszry2ckucax402ve9a7rmc3m","Cloudflare WAF 防护 ruby2shell 漏洞 CVE-2026-132825 及 GHSA-87fm-7w84-j2px","Cloudflare WAF 已为 ruby2shell（CVE-2026-132825）及相关整数溢出 GHSA-87fm-7w84-j2px 启用默认阻断规则，Free 计划自动生效，付费计划需确认 Cloudflare Managed Ruleset 已部署。","文章同时说明漏洞触发条件、Cloudflare WAF 规则覆盖范围及绕过边界，为无法立即升级 Ruby 的团队提供临时防护与处置依据。",{"_59":60},"2026-11-20T20:24:38.000Z","2026-11-20T20:32:32.974Z",[53,55,122,56,98,57],78,"xc4re3fqbv7j3asqraazbq4h2","PHP phpAfterShell 远程代码执行漏洞 CVE-2026-126714 已修复，Cloudflare WAF 已更新检测","Cloudflare 介绍 PHP 默认文件会话处理器漏洞 phpAfterShell（CVE-2026-126714），该漏洞 CVSS v4.0 为 9.2 分，可因会话文件写入中断并在后续反序列化时导致远程代码执行。","文章梳理了 phpAfterShell 的触发原理、受影响版本与利用前提，并说明 Cloudflare WAF 规则、补丁和临时缓解措施。",{"_59":60},"2026-11-20T20:00:45.000Z","2026-11-20T20:32:32.984Z","blue-team",[161,162,56,163,164,57,58],80,"工具发布","版本更新","漏洞管理","加固","slug","cloudflare","group","company","definition","CDN 与网络协议层面的安全研究、防护规则与互联网测量。","brand",{"_186":-5,"_187":188,"_189":178},"total",9,"recent",7,"indexable",false,"latest",{"_31":152,"_185":157},"groupName","厂商与机构","poolTotal",28,"at","src","monogram","C","raster",{"_191":192,"_193":-5},"changelogVersion","2026-10-01T08:00","release"]
