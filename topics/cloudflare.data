[{"_1":2,"_3":4},"root",{"_5":103},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1794530258000,{"_79":80,"_53":51,"_81":82,"_83":84,"_85":86,"_87":88,"_89":88,"_90":91,"_92":93,"_94":95,"_96":97},"modules",{},"items",[20,21,22],"page",1,"pageCount","pageSize",20,{"_23":68,"_25":69,"_27":70,"_29":71,"_31":72,"_33":73,"_35":74,"_36":37,"_38":75,"_40":76,"_42":43,"_44":45,"_46":-5},{"_23":55,"_25":56,"_27":57,"_29":58,"_31":59,"_33":60,"_35":60,"_36":61,"_38":62,"_40":63,"_42":43,"_44":45,"_46":-5},{"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":34,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":-5},"id","b5nn1bd55kl7m066s3q42xuet","title","PHP php2shell 漏洞 CVE-2026-109618、CVE-2026-109619 影响 PHP 5.4 及以上版本并已出现攻击流量","summary","PHP 5.4 及以上运行时的 php2shell 漏洞 CVE-2026-109618、CVE-2026-109619 可能通过特制 HTTP 请求造成拒绝服务、远程代码执行和数据暴露，Cloudflare 已观察到针对客户的攻击流量。","reason","原文披露漏洞成因与修复版本，并说明 WAF 防护范围、攻击观察和完整交易检测方法，便于评估风险与处置优先级。","source",{"_53":54},"publishedAt","2026-10-21T13:56:45.000Z","timelineAt","category","vuln","tags",[47,48,49,50,51,52],"score",90,"selected",true,"channel","news","x","漏洞","在野利用","补丁","漏洞分析","Cloudflare","PHP","name","Cloudflare Blog","nzzcilkbztxbi4lagit64ikms","Cloudflare 披露 GLM-5.3 Workers AI 跨请求 KV cache 数据泄露及修复","Cloudflare 与 SGLang 联合披露 GLM-5.3 Workers AI 模型（@cf/zai-org/glm-5.3）的跨请求 KV cache 泄露问题，8 月 27 日至 9 月 9 日共有 155 个长于 681,280 tokens 的请求响应包含其他客户请求数据。","原文拆解了配置错配与 SGLang 缺陷共同造成的跨请求 KV cache 泄露，并给出修复版本、部署检查和检测建议。",{"_53":54},"2026-10-26T22:01:23.000Z","ai-security",[64,65,47,66,49,67,51],88,"AI 安全","大模型","数据泄露","Agent 安全","ashq9zaym8iojmnulqhy7xxeb","Cloudflare 披露 eMudhra 弱私钥在野伪造活动与客户端修补进展","Cloudflare 确认 eMudhra 的8个可从公开证书恢复的弱私钥已被用于签发伪造证书，其中一张伪造证书在密钥问题公开后不到1小时生成。Cloudflare 在一周内记录约22,000次使用弱密钥的尝试握手，所有启用证书验证的连接均被拒绝，尚未发现这些密钥用于拦截 Cloudflare 连接或系统失陷。","文章结合约22,000次弱密钥握手和5000万次探测数据，揭示证书伪造活动及各类客户端仍未修补的现状。",{"_53":54},"2026-10-30T17:38:50.000Z","2026-10-30T17:45:15.060Z",[47,48,49,50,77,51,78],86,"加密","Mozilla","slug","cloudflare","group","company","definition","CDN 与网络协议层面的安全研究、防护规则与互联网测量。","brand",{"_99":-5,"_100":101,"_102":91},"total",3,"recent","indexable",false,"latest",{"_25":69,"_98":74},"groupName","厂商与机构","poolTotal",19,"at","src","monogram","C","raster",{"_104":105,"_106":-5},"changelogVersion","2026-10-01T08:00","release"]
