[{"_1":2,"_3":4},"root",{"_5":109},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1794443864000,{"_85":86,"_54":53,"_87":88,"_89":90,"_91":92,"_93":94,"_95":94,"_96":97,"_98":99,"_100":101,"_102":103},"modules",{},"items",[20,21,22,23],"page",1,"pageCount","pageSize",20,{"_24":77,"_26":78,"_28":79,"_30":80,"_32":81,"_34":82,"_36":82,"_37":38,"_39":83,"_41":63,"_43":44,"_45":46,"_47":-5},{"_24":68,"_26":69,"_28":70,"_30":71,"_32":72,"_34":73,"_36":73,"_37":38,"_39":74,"_41":75,"_43":44,"_45":46,"_47":-5},{"_24":56,"_26":57,"_28":58,"_30":59,"_32":60,"_34":61,"_36":61,"_37":38,"_39":62,"_41":63,"_43":44,"_45":46,"_47":-5},{"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":35,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":-5},"id","r28jj6d6kym88oho9mr0cl714","title","Komodo Periphery 代理存在 OS 命令注入漏洞 CVE-2026-110005","summary","Komodo Periphery agent 存在 OS 命令注入漏洞 CVE-2026-110005，影响 2.2.0 及更早版本。经认证的非管理员用户可通过恶意 Docker 容器名，在容器销毁或日志搜索操作中触发任意命令，以宿主机 root 权限执行。Komodo 已在 2.3.0 及更高版本中实施修复，CERT/CC 建议用户立即更新。","reason","公告说明了两条命令注入路径、权限提升条件及修复版本，便于管理员核对部署并完成升级处置。","source",{"_54":55},"publishedAt","2026-10-13T19:24:10.004Z","timelineAt","category","vuln","tags",[48,49,50,51,52,53],"score",66,"selected",true,"channel","news","x","漏洞","补丁","漏洞分析","容器","漏洞管理","CERT/CC","name","CERT/CC 漏洞公告","zi42c102qbio5d3ukm6wiosp8","DataElement Bisheng 披露三项认证绕过与数据访问漏洞","DataElement Bisheng 存在三项漏洞：CVE-2026-96679 可绕过 legacy SSO 认证并接管账户，CVE-2026-96681 允许已认证用户读取其他账户的工作流数据，CVE-2026-100156 允许越权调用他人助手并泄露工具和工作流配置。","公告同时给出三项漏洞的利用条件、受影响功能与版本修复状态，并对尚未修复的认证绕过提供可落地的临时缓解措施。",{"_54":55},"2026-10-14T12:39:18.342Z",[48,64,49,65,66,67,53],72,"复现","AI 安全","大模型","身份与访问","te7pp1n7waoquazqmlra5s388","Xerj Console API 认证绕过漏洞 CVE-2026-97406 可生成持久后继凭据","Xerj Console API 存在认证绕过漏洞 CVE-2026-97406，持有有效令牌的攻击者可绕过 passkey 要求，直接创建具有同等权限的独立持久后继凭据。","漏洞源于会话认证状态与令牌签发机制混用，撤销父令牌也无法阻断派生凭据，披露了可迁移的令牌治理风险。",{"_54":55},"2026-10-20T18:09:44.460Z",[48,50,64,76,65,66,53],55,"在野利用","pmsobm4infseqoluo44rx8ope","COVESA vsomeip CVE-2026-91141 内存分配漏洞影响 3.7.3 及以下版本","COVESA vsomeip 3.7.3 及以下版本的 reliable（TCP）端点存在 CVE-2026-91141，远程未认证对端可在首条消息中声明最高约 4 GB 的大小，迫使主机分配内存并导致拒绝服务。","公告梳理了内存分配漏洞的触发路径、影响范围与版本修复方案，并提供无需升级时的限制配置。",{"_54":55},"2026-10-26T19:07:02.688Z",[48,49,84,53],"车联网","slug","certcc","group","company","definition","协调披露的漏洞通告（VU）与软件缺陷分析。","brand",{"_105":-5,"_106":107,"_108":97},"total",4,"recent","indexable",false,"latest",{"_26":78,"_104":82},"groupName","厂商与机构","poolTotal",13,"at","src","monogram","C","raster",{"_110":111,"_112":-5},"changelogVersion","2026-10-01T08:00","release"]
