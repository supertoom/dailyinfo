[{"_1":2,"_3":4},"root",{"_5":122},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1794875799000,{"_98":99,"_55":54,"_100":101,"_102":103,"_104":105,"_106":107,"_108":109,"_110":111,"_112":113,"_114":115,"_116":19},"modules",{},"items",[20,21,22,23,24],"page",1,"pageCount","pageSize",20,{"_25":86,"_27":87,"_29":88,"_31":89,"_33":90,"_35":91,"_37":92,"_38":39,"_40":93,"_42":94,"_44":45,"_46":47,"_48":-5},{"_25":78,"_27":79,"_29":80,"_31":81,"_33":82,"_35":83,"_37":83,"_38":39,"_40":84,"_42":64,"_44":45,"_46":47,"_48":-5},{"_25":69,"_27":70,"_29":71,"_31":72,"_33":73,"_35":74,"_37":74,"_38":39,"_40":75,"_42":76,"_44":45,"_46":47,"_48":-5},{"_25":57,"_27":58,"_29":59,"_31":60,"_33":61,"_35":62,"_37":62,"_38":39,"_40":63,"_42":64,"_44":45,"_46":47,"_48":-5},{"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":36,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47,"_48":-5},"id","r28jj6d6kym88oho9mr0cl714","title","Komodo Periphery 代理存在 OS 命令注入漏洞 CVE-2026-110005","summary","Komodo Periphery agent 存在 OS 命令注入漏洞 CVE-2026-110005，影响 2.2.0 及更早版本。经认证的非管理员用户可通过恶意 Docker 容器名，在容器销毁或日志搜索操作中触发任意命令，以宿主机 root 权限执行。Komodo 已在 2.3.0 及更高版本中实施修复，CERT/CC 建议用户立即更新。","reason","公告说明了两条命令注入路径、权限提升条件及修复版本，便于管理员核对部署并完成升级处置。","source",{"_55":56},"publishedAt","2026-10-13T19:24:10.004Z","timelineAt","category","vuln","tags",[49,50,51,52,53,54],"score",66,"selected",true,"channel","news","x","漏洞","补丁","漏洞分析","容器","漏洞管理","CERT/CC","name","CERT/CC 漏洞公告","zi42c102qbio5d3ukm6wiosp8","DataElement Bisheng 披露三项认证绕过与数据访问漏洞","DataElement Bisheng 存在三项漏洞：CVE-2026-96679 可绕过 legacy SSO 认证并接管账户，CVE-2026-96681 允许已认证用户读取其他账户的工作流数据，CVE-2026-100156 允许越权调用他人助手并泄露工具和工作流配置。","公告同时给出三项漏洞的利用条件、受影响功能与版本修复状态，并对尚未修复的认证绕过提供可落地的临时缓解措施。",{"_55":56},"2026-10-14T12:39:18.342Z",[49,65,50,66,67,68,54],72,"复现","AI 安全","大模型","身份与访问","te7pp1n7waoquazqmlra5s388","Xerj Console API 认证绕过漏洞 CVE-2026-97406 可生成持久后继凭据","Xerj Console API 存在认证绕过漏洞 CVE-2026-97406，持有有效令牌的攻击者可绕过 passkey 要求，直接创建具有同等权限的独立持久后继凭据。","漏洞源于会话认证状态与令牌签发机制混用，撤销父令牌也无法阻断派生凭据，披露了可迁移的令牌治理风险。",{"_55":56},"2026-10-20T18:09:44.460Z",[49,51,65,77,66,67,54],55,"在野利用","pmsobm4infseqoluo44rx8ope","COVESA vsomeip CVE-2026-91141 内存分配漏洞影响 3.7.3 及以下版本","COVESA vsomeip 3.7.3 及以下版本的 reliable（TCP）端点存在 CVE-2026-91141，远程未认证对端可在首条消息中声明最高约 4 GB 的大小，迫使主机分配内存并导致拒绝服务。","公告梳理了内存分配漏洞的触发路径、影响范围与版本修复方案，并提供无需升级时的限制配置。",{"_55":56},"2026-10-26T19:07:02.688Z",[49,50,85,54],"车联网","t9wrlous51du7grvxh1vej6dd","CERT/CC 披露 macOS APFS Unicode 路径碰撞漏洞，影响 HashiCorp go-slug、Deno、Libarchive 和 setuptools","CERT/CC 披露多个软件因未正确处理 APFS Unicode 路径碰撞而存在文件覆盖与排除规则绕过问题，攻击者可在本地利用替代拼写或大小写折叠变体覆盖进程有权限写入的文件，影响数据、配置甚至代码执行。","公告梳理了 APFS 路径解析与多款软件校验逻辑不一致的成因，并列出受影响项目、修复版本及跨平台防护思路。",{"_55":56},"2026-11-16T16:17:31.751Z","2026-11-16T16:56:17.094Z",[49,50,95,96,97,54],75,"供应链","Apple","操作系统","slug","certcc","group","company","definition","协调披露的漏洞通告（VU）与软件缺陷分析。","brand",{"_118":-5,"_119":120,"_121":111},"total",5,"recent",3,"indexable",false,"latest",{"_27":87,"_117":92},"groupName","厂商与机构","poolTotal","at","src","monogram","C","raster",{"_123":124,"_125":-5},"changelogVersion","2026-10-01T08:00","release"]
