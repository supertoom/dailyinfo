[{"_1":2,"_3":4},"root",{"_5":153},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1794875801000,{"_128":129,"_59":130,"_131":132,"_133":134,"_135":136,"_137":138,"_139":138,"_140":141,"_142":143,"_144":145,"_146":147},"modules",{},"items",[20,21,22,23,24,25,26],"page",1,"pageCount","pageSize",20,{"_27":118,"_29":119,"_31":120,"_33":121,"_35":122,"_37":123,"_39":124,"_40":67,"_42":125,"_44":126,"_46":47,"_48":49,"_50":-5},{"_27":107,"_29":108,"_31":109,"_33":110,"_35":111,"_37":112,"_39":113,"_40":67,"_42":114,"_44":115,"_46":47,"_48":49,"_50":-5},{"_27":95,"_29":96,"_31":97,"_33":98,"_35":99,"_37":100,"_39":101,"_40":102,"_42":103,"_44":104,"_46":47,"_48":49,"_50":-5},{"_27":85,"_29":86,"_31":87,"_33":88,"_35":89,"_37":90,"_39":91,"_40":41,"_42":92,"_44":93,"_46":47,"_48":49,"_50":-5},{"_27":73,"_29":74,"_31":75,"_33":76,"_35":77,"_37":78,"_39":78,"_40":79,"_42":80,"_44":81,"_46":47,"_48":49,"_50":-5},{"_27":61,"_29":62,"_31":63,"_33":64,"_35":65,"_37":66,"_39":66,"_40":67,"_42":68,"_44":69,"_46":47,"_48":49,"_50":-5},{"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":38,"_40":41,"_42":43,"_44":45,"_46":47,"_48":49,"_50":-5},"id","rs3am9i4g28la8ml4bux13oh2","title","Rapid7披露Citrix NetScaler ADC入侵链，CVE-2026-88771与CVE-2026-88779已被链式利用","summary","Rapid7确认，Citrix NetScaler ADC 14.1受影响版本遭 CVE-2026-88771 与 CVE-2026-88779 链式利用，攻击者可从预认证注入推进至 root 权限执行。","reason","该事件复盘了NetScaler入侵的完整利用链、持久化与数据外传机制，并提供IOC和排查方向，便于防守方识别同类入侵。","source",{"_59":60},"publishedAt","2026-10-19T15:11:57.000Z","timelineAt","category","activity","tags",[51,52,53,54,55,56,57,58],"score",90,"selected",true,"channel","news","x","攻击活动","在野利用","漏洞利用","利用链","后门","数据泄露","Rapid7","VMware","name","Rapid7 CVE 公告","smdwbijhpetxv6h1kxay4rh81","Eptura Archibus 修复认证绕过、数据库读取与 RCE 漏洞 CVE-2026-107186、CVE-2026-107187、CVE-2026-107188","Rapid7 披露 Eptura Archibus 的三个漏洞：CVE-2026-107186 可绕过认证，CVE-2026-107187 可读取任意数据库表，CVE-2026-107188 可上传 JSPX 文件并实现 RCE。","原文提供了三个漏洞的原理、完整利用链和 PoC，并说明认证绕过如何串联数据库读取与文件上传，适合研究人员理解攻击路径和防守重点。",{"_59":60},"2026-10-19T15:57:43.000Z","vuln",[70,71,53,54,72,57],82,"漏洞","复现","补丁","k5ehm4xk4kyhaa2h6kgzd9uca","Metasploit 6.5.6 至 6.5.8 新增 6 个 Langflow 漏洞利用模块","Metasploit Framework 6.5.6 至 6.5.8 新增 11 个模块，其中 6 个针对开源大模型工作流构建工具 Langflow，覆盖认证绕过、未认证远程代码执行和已认证代码执行等漏洞。","该版本新增 6 个面向 Langflow 的模块，并扩展 MongoDB、OpenCTI 等目标覆盖，适合关注大模型应用组件风险的攻防人员参考。",{"_59":60},"2026-10-23T15:38:56.000Z","blue-team",[82,83,53,84,57],57,"工具发布","版本更新","大模型","kap6lzk1o51rm638fm4tiscnh","攻击者尝试利用 Alpine Linux GitLab 的 CVE-2026-97229 漏洞，CVSS 10.0","攻击者试图利用 Alpine Linux 自有 GitLab 服务器的 CVE-2026-97229 漏洞，该漏洞 CVSS 10.0，可通过构造的 CI 正则表达式在特定条件下执行代码。","材料还原了攻击时间线、验证结果与排查边界，并指出升级 GitLab 仍不足以修复自托管 Ruby 的处置盲点。",{"_59":94},"2026-10-29T09:05:39.000Z","2026-10-29T23:39:28.423Z",[51,52,53,54,57],83,"The Hacker News","els1gzklnlhxhh0k15ljle1lp","Rapid7 分析 BeyondTrust Remote Support 未认证文件上传至 RCE 漏洞 CVE-2026-102764","Rapid7 分析 BeyondTrust Remote Support 的来源校验缺陷 CVE-2026-102764，未认证攻击者可伪造本地消息来源，访问原生文件传输服务，写入任意文件并以站点操作系统用户身份执行代码，无需账户凭据或用户交互。","文章从消息来源伪造到文件写入、PHP 执行逐段拆解利用链，并给出 Metasploit 模块与多类日志的排查要点，便于安全团队理解和检测该风险。",{"_59":60},"2026-10-30T16:01:53.000Z","2026-10-30T17:48:15.917Z","disclosure",[105,106,71,53,54,57],77,"技术研究","漏洞分析","bascdi2f6ns6cy5dhtip9c0qp","N-able N-central 披露 33 个严重漏洞，含未认证 RCE 利用链","N-able N-central 远程监控与管理平台被披露存在 33 个严重问题，包括未认证远程代码执行（RCE）、提权至 root、凭据泄露和未授权账户创建，独立研究员已发布 PoC；其中一条利用链结合 XXE 与会话处理缺陷，以 nable 服务账户执行代码。","原文汇总了33个问题的公开PoC、具体利用链与厂商扫描情况，读者可据此识别受影响部署并决定下线处置。",{"_59":60},"2026-11-10T14:20:34.000Z","2026-11-10T14:50:21.013Z",[70,71,53,52,116,117,57],75,"应急响应","漏洞管理","npdhl1v55b5kdqnab2s0etv9h","Rapid7发现CVE-2026-90436已被用于攻击Atlassian Confluence Data Center和N-able N-central","Rapid7 MDR于11月13日在客户环境中检测到CVE-2026-90436对Atlassian Confluence Data Center的利用，N-able也报告了针对N-central的强关联漏洞在野利用。","Rapid7提供真实客户环境中的利用观测、产品级处置方法和关联IOC，可用于核对暴露系统并排查入侵痕迹。",{"_59":60},"2026-11-16T18:14:14.000Z","2026-11-16T18:59:19.322Z",[70,52,53,127,57],88,"Atlassian","slug","rapid7","Rapid7 / Metasploit","group","company","definition","Metasploit 模块更新、CVE 公告与漏洞利用的可用性。","brand",{"_149":-5,"_150":151,"_152":141},"total",7,"recent","indexable",false,"latest",{"_29":119,"_148":124},"groupName","厂商与机构","poolTotal",17,"at","src","monogram","R","raster",{"_154":155,"_156":-5},"changelogVersion","2026-10-01T08:00","release"]
