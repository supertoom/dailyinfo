[{"_1":2,"_3":4},"root",{"_5":130},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1794184872000,{"_105":106,"_57":107,"_108":109,"_110":111,"_112":113,"_114":115,"_116":115,"_117":118,"_119":120,"_121":122,"_123":124},"modules",{},"items",[20,21,22,23,24],"page",1,"pageCount","pageSize",20,{"_25":93,"_27":94,"_29":95,"_31":96,"_33":97,"_35":98,"_37":99,"_38":100,"_40":101,"_42":102,"_44":45,"_46":47,"_48":-5},{"_25":83,"_27":84,"_29":85,"_31":86,"_33":87,"_35":88,"_37":89,"_38":39,"_40":90,"_42":91,"_44":45,"_46":47,"_48":-5},{"_25":71,"_27":72,"_29":73,"_31":74,"_33":75,"_35":76,"_37":76,"_38":77,"_40":78,"_42":79,"_44":45,"_46":47,"_48":-5},{"_25":59,"_27":60,"_29":61,"_31":62,"_33":63,"_35":64,"_37":64,"_38":65,"_40":66,"_42":67,"_44":45,"_46":47,"_48":-5},{"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":36,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47,"_48":-5},"id","rs3am9i4g28la8ml4bux13oh2","title","Rapid7披露Citrix NetScaler ADC入侵链，CVE-2026-88771与CVE-2026-88779已被链式利用","summary","Rapid7确认，Citrix NetScaler ADC 14.1受影响版本遭 CVE-2026-88771 与 CVE-2026-88779 链式利用，攻击者可从预认证注入推进至 root 权限执行。","reason","该事件复盘了NetScaler入侵的完整利用链、持久化与数据外传机制，并提供IOC和排查方向，便于防守方识别同类入侵。","source",{"_57":58},"publishedAt","2026-10-19T15:11:57.000Z","timelineAt","category","activity","tags",[49,50,51,52,53,54,55,56],"score",90,"selected",true,"channel","news","x","攻击活动","在野利用","漏洞利用","利用链","后门","数据泄露","Rapid7","VMware","name","Rapid7 CVE 公告","smdwbijhpetxv6h1kxay4rh81","Eptura Archibus 修复认证绕过、数据库读取与 RCE 漏洞 CVE-2026-107186、CVE-2026-107187、CVE-2026-107188","Rapid7 披露 Eptura Archibus 的三个漏洞：CVE-2026-107186 可绕过认证，CVE-2026-107187 可读取任意数据库表，CVE-2026-107188 可上传 JSPX 文件并实现 RCE。","原文提供了三个漏洞的原理、完整利用链和 PoC，并说明认证绕过如何串联数据库读取与文件上传，适合研究人员理解攻击路径和防守重点。",{"_57":58},"2026-10-19T15:57:43.000Z","vuln",[68,69,51,52,70,55],82,"漏洞","复现","补丁","k5ehm4xk4kyhaa2h6kgzd9uca","Metasploit 6.5.6 至 6.5.8 新增 6 个 Langflow 漏洞利用模块","Metasploit Framework 6.5.6 至 6.5.8 新增 11 个模块，其中 6 个针对开源大模型工作流构建工具 Langflow，覆盖认证绕过、未认证远程代码执行和已认证代码执行等漏洞。","该版本新增 6 个面向 Langflow 的模块，并扩展 MongoDB、OpenCTI 等目标覆盖，适合关注大模型应用组件风险的攻防人员参考。",{"_57":58},"2026-10-23T15:38:56.000Z","blue-team",[80,81,51,82,55],57,"工具发布","版本更新","大模型","kap6lzk1o51rm638fm4tiscnh","攻击者尝试利用 Alpine Linux GitLab 的 CVE-2026-97229 漏洞，CVSS 10.0","攻击者试图利用 Alpine Linux 自有 GitLab 服务器的 CVE-2026-97229 漏洞，该漏洞 CVSS 10.0，可通过构造的 CI 正则表达式在特定条件下执行代码。","材料还原了攻击时间线、验证结果与排查边界，并指出升级 GitLab 仍不足以修复自托管 Ruby 的处置盲点。",{"_57":92},"2026-10-29T09:05:39.000Z","2026-10-29T23:39:28.423Z",[49,50,51,52,55],83,"The Hacker News","els1gzklnlhxhh0k15ljle1lp","Rapid7 分析 BeyondTrust Remote Support 未认证文件上传至 RCE 漏洞 CVE-2026-102764","Rapid7 分析 BeyondTrust Remote Support 的来源校验缺陷 CVE-2026-102764，未认证攻击者可伪造本地消息来源，访问原生文件传输服务，写入任意文件并以站点操作系统用户身份执行代码，无需账户凭据或用户交互。","文章从消息来源伪造到文件写入、PHP 执行逐段拆解利用链，并给出 Metasploit 模块与多类日志的排查要点，便于安全团队理解和检测该风险。",{"_57":58},"2026-10-30T16:01:53.000Z","2026-10-30T17:48:15.917Z","disclosure",[103,104,69,51,52,55],77,"技术研究","漏洞分析","slug","rapid7","Rapid7 / Metasploit","group","company","definition","Metasploit 模块更新、CVE 公告与漏洞利用的可用性。","brand",{"_126":-5,"_127":128,"_129":118},"total",5,"recent","indexable",false,"latest",{"_27":94,"_125":99},"groupName","厂商与机构","poolTotal",13,"at","src","monogram","R","raster",{"_131":132,"_133":-5},"changelogVersion","2026-10-01T08:00","release"]
