[{"_1":2,"_3":4},"root",{"_5":171},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1794195598000,{"_145":146,"_61":147,"_148":149,"_150":151,"_152":153,"_154":155,"_156":157,"_158":159,"_160":161,"_162":163,"_164":165},"modules",{},"items",[20,21,22,23,24,25,26,27],"page",1,"pageCount","pageSize",20,{"_28":134,"_30":135,"_32":136,"_34":137,"_36":138,"_38":139,"_40":140,"_41":69,"_43":141,"_45":142,"_47":48,"_49":50,"_51":-5},{"_28":125,"_30":126,"_32":127,"_34":128,"_36":129,"_38":130,"_40":131,"_41":69,"_43":132,"_45":46,"_47":48,"_49":50,"_51":-5},{"_28":111,"_30":112,"_32":113,"_34":114,"_36":115,"_38":116,"_40":117,"_41":118,"_43":119,"_45":71,"_47":48,"_49":50,"_51":-5},{"_28":102,"_30":103,"_32":104,"_34":105,"_36":106,"_38":107,"_40":107,"_41":95,"_43":108,"_45":109,"_47":48,"_49":50,"_51":-5},{"_28":89,"_30":90,"_32":91,"_34":92,"_36":93,"_38":94,"_40":94,"_41":95,"_43":96,"_45":97,"_47":48,"_49":50,"_51":-5},{"_28":78,"_30":79,"_32":80,"_34":81,"_36":82,"_38":83,"_40":83,"_41":69,"_43":84,"_45":85,"_47":48,"_49":50,"_51":-5},{"_28":63,"_30":64,"_32":65,"_34":66,"_36":67,"_38":68,"_40":68,"_41":69,"_43":70,"_45":71,"_47":48,"_49":50,"_51":-5},{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":39,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":-5},"id","hegwfchoh8ewaw8ebcfpt0rl5","title","Bright Data SDK 技术研究：智能电视与 iOS 设备如何成为 AI 抓取代理节点","summary","Include Security 逆向分析 Bright Data iOS SDK 并观测 30 天流量，揭示其经 WebSocket 接收抓取任务、以用户住宅 IP 执行请求，以及绕过 VPN 检查的机制。","reason","文章通过逆向与运行时流量观测还原 SDK 代理机制，并给出网络侧和终端侧的可落地检测方向。","source",{"_61":62},"publishedAt","2026-06-05T16:01:11.000Z","timelineAt","category","disclosure","tags",[52,53,54,55,56,57,58,59,60],"score",74,"selected",true,"channel","news","x","技术研究","逆向","AI 安全","IoT","移动端","云原生","Apple","Google","Cloudflare","name","Inception Security","dfsrf7m8ypk15pgptp2nbgapl","macOS.Gaslight Rust 后门利用提示注入干扰 LLM 分析","macOS.Gaslight 是面向 macOS 的 Rust 后门与信息窃取程序，通过 Telegram Bot API 进行 C2 通信，并使用 AES-GCM 和证书固定隐藏流量。","原文拆解了针对分析 Agent 的提示注入载荷及其实现方式，为构建安全分析流程和样本隔离策略提供具体参考。",{"_61":77},"2026-06-23T21:59:42.000Z","activity",[72,73,74,54,75,58,76],70,"攻击活动","恶意软件","后门","数据窃取","SentinelOne","SentinelLabs","nv5z7uyciraj8jnruy9fuk4pg","慢雾披露 DarkSword iOS 攻击套件已产品化并用于窃密","慢雾发现 DarkSword 攻击套件已被封装成可部署的 iOS 窃密平台，通过伪装落地页和版本分流触发利用链。面板显示 57 台设备、10,125 条窃取记录和 9 次数据外传，并上线钱包解密与归集功能；代码确认可完整利用的窗口为 iOS 18.6 至 18.7.2及 26.0 至 26.1，另有针对 CVE-2026-43818 的利用仍待真机验证。","原文通过代码比对、面板数据与基础设施关联，呈现了公开利用链如何被封装为可运营的 iOS 窃密与钱包变现平台。",{"_61":88},"2026-10-19T09:00:00.000Z",[72,73,86,87,75,56,58,59],86,"在野利用","利用链","慢雾科技","zq3157zx2z8lo63ztow4kklgb","Apple 发布 2026 年 10 月安全更新，汇总大量漏洞修复","Apple 2026 年 10 月安全更新汇总了多项漏洞修复，涵盖 WebKit、Kernel、Remote Management、Screen Sharing Server 等组件，涉及远程代码执行、权限提升、内存泄露、拒绝服务和 Gatekeeper 绕过等问题。","这份月度汇总集中列出 Apple 修复的众多漏洞及影响组件，便于按 CVE 快速梳理本次更新范围。",{"_61":101},"2026-10-27T02:09:55.000Z","vuln",[98,99,86,100,58],73,"漏洞","补丁","汇总","SANS ISC","yocbcrg7ag66qmssktcr4jvbu","Apple 将已被利用的 CoreGraphics 漏洞 CVE-2026-86950 修复回移至旧版 iPhone 和 iPad","Apple 将已在真实攻击中被利用的 CoreGraphics 越界写入漏洞 CVE-2026-86950 修复回移至 iOS 18.7.11 和 iPadOS 18.7.11，CVSS 为 8.8。","文章说明了受在野利用漏洞的补丁回移范围与受影响旧设备版本，便于相关用户判断是否需要升级处置。",{"_61":110},"2026-10-27T13:59:09.000Z",[98,99,86,56,58],78,"The Hacker News","q3shvdlx2xyvmluni49s27g4s","Anthropic 未发布模型将 Chrome、Safari、Windows 与 Linux 缺陷串联为 PoC","Anthropic 称其未发布的内部研究模型在实验室中为 Chrome、Safari、Android、Windows 和 Linux 构造了可运行的 PoC，这些利用未出现在真实攻击中，相关缺陷均已先行报告厂商并完成修复。","文章梳理模型自动串联多组缺陷生成可运行 PoC 的能力，并对照厂商记录指出部分归因仍缺乏公开证据。",{"_61":110},"2026-10-28T08:15:07.000Z","2026-10-28T09:02:45.201Z","ai-security",[54,120,52,121,86,122,59,58,123,124],"AI 攻防","漏洞利用","大模型","Microsoft","CISA","xotvn8h2ady8nq85xed82tncq","Apple 间谍软件告警送达德国联邦议院，BSI 要求受影响者按设备失陷处置","Apple 自 2026 年 10 月 29 日起通知多名德国联邦议院议员、政界人士及其他公众人物，其 iPhone 遭到政府支持的雇佣间谍软件攻击；BSI 尚不确定通知代表成功感染还是攻击尝试，已向受影响者发出提醒并要求联系机构。","材料汇总了德国政界收到间谍软件告警后的影响范围与不确定性，并给出 BSI 针对设备取证、账号安全和通信工具的具体处置建议。",{"_61":133},"2026-11-03T06:24:38.000Z","2026-11-03T07:06:21.843Z",[72,73,56,58],"Security Affairs","kodarv143bm6tdtz8vpt6lz9c","APT29 关联黑客劫持 Plerdy SEO Tracker 投递 iOS 与 Android 利用链","Sekoia 称，俄罗斯关联威胁组织 APT29 借被入侵网站、仿冒域名和乌克兰 Plerdy SEO Tracker 供应链攻击开展名为 Poisoned Source 的水坑活动，向 iOS 与 Android 用户投递 N-day 利用链并窃取浏览器 Cookie、Wi-Fi 密码及移动设备数据。","文章梳理了针对 iOS 和 Android 用户的投递方式、利用链与数据窃取目标，还给出了具体 CVE 和感染基础设施，便于防守方识别关联活动。",{"_61":110},"2026-11-04T14:27:52.000Z","2026-11-04T14:52:23.782Z",[72,86,121,73,75,143,58,59,144],90,"供应链投毒","Mozilla","slug","apple","Apple / 苹果","group","company","definition","iOS、macOS 与 Safari 的安全公告与零日利用跟踪。","brand",{"_167":-5,"_168":169,"_170":159},"total",8,"recent",6,"indexable",false,"latest",{"_30":135,"_166":140},"groupName","厂商与机构","poolTotal",33,"at","src","monogram","A","raster",{"_172":173,"_174":-5},"changelogVersion","2026-10-01T08:00","release"]
