[{"_1":2,"_3":4},"root",{"_5":182},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1794271001000,{"_156":157,"_62":158,"_159":160,"_161":162,"_163":164,"_165":166,"_167":168,"_169":170,"_171":172,"_173":174,"_175":176},"modules",{},"items",[20,21,22,23,24,25,26,27,28],"page",1,"pageCount","pageSize",20,{"_29":146,"_31":147,"_33":148,"_35":149,"_37":150,"_39":151,"_41":152,"_42":70,"_44":153,"_46":110,"_48":49,"_50":51,"_52":-5},{"_29":135,"_31":136,"_33":137,"_35":138,"_37":139,"_39":140,"_41":141,"_42":70,"_44":142,"_46":143,"_48":49,"_50":51,"_52":-5},{"_29":126,"_31":127,"_33":128,"_35":129,"_37":130,"_39":131,"_41":132,"_42":70,"_44":133,"_46":47,"_48":49,"_50":51,"_52":-5},{"_29":112,"_31":113,"_33":114,"_35":115,"_37":116,"_39":117,"_41":118,"_42":119,"_44":120,"_46":72,"_48":49,"_50":51,"_52":-5},{"_29":103,"_31":104,"_33":105,"_35":106,"_37":107,"_39":108,"_41":108,"_42":96,"_44":109,"_46":110,"_48":49,"_50":51,"_52":-5},{"_29":90,"_31":91,"_33":92,"_35":93,"_37":94,"_39":95,"_41":95,"_42":96,"_44":97,"_46":98,"_48":49,"_50":51,"_52":-5},{"_29":79,"_31":80,"_33":81,"_35":82,"_37":83,"_39":84,"_41":84,"_42":70,"_44":85,"_46":86,"_48":49,"_50":51,"_52":-5},{"_29":64,"_31":65,"_33":66,"_35":67,"_37":68,"_39":69,"_41":69,"_42":70,"_44":71,"_46":72,"_48":49,"_50":51,"_52":-5},{"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":40,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":-5},"id","hegwfchoh8ewaw8ebcfpt0rl5","title","Bright Data SDK 技术研究：智能电视与 iOS 设备如何成为 AI 抓取代理节点","summary","Include Security 逆向分析 Bright Data iOS SDK 并观测 30 天流量，揭示其经 WebSocket 接收抓取任务、以用户住宅 IP 执行请求，以及绕过 VPN 检查的机制。","reason","文章通过逆向与运行时流量观测还原 SDK 代理机制，并给出网络侧和终端侧的可落地检测方向。","source",{"_62":63},"publishedAt","2026-06-05T16:01:11.000Z","timelineAt","category","disclosure","tags",[53,54,55,56,57,58,59,60,61],"score",74,"selected",true,"channel","news","x","技术研究","逆向","AI 安全","IoT","移动端","云原生","Apple","Google","Cloudflare","name","Inception Security","dfsrf7m8ypk15pgptp2nbgapl","macOS.Gaslight Rust 后门利用提示注入干扰 LLM 分析","macOS.Gaslight 是面向 macOS 的 Rust 后门与信息窃取程序，通过 Telegram Bot API 进行 C2 通信，并使用 AES-GCM 和证书固定隐藏流量。","原文拆解了针对分析 Agent 的提示注入载荷及其实现方式，为构建安全分析流程和样本隔离策略提供具体参考。",{"_62":78},"2026-06-23T21:59:42.000Z","activity",[73,74,75,55,76,59,77],70,"攻击活动","恶意软件","后门","数据窃取","SentinelOne","SentinelLabs","nv5z7uyciraj8jnruy9fuk4pg","慢雾披露 DarkSword iOS 攻击套件已产品化并用于窃密","慢雾发现 DarkSword 攻击套件已被封装成可部署的 iOS 窃密平台，通过伪装落地页和版本分流触发利用链。面板显示 57 台设备、10,125 条窃取记录和 9 次数据外传，并上线钱包解密与归集功能；代码确认可完整利用的窗口为 iOS 18.6 至 18.7.2及 26.0 至 26.1，另有针对 CVE-2026-43818 的利用仍待真机验证。","原文通过代码比对、面板数据与基础设施关联，呈现了公开利用链如何被封装为可运营的 iOS 窃密与钱包变现平台。",{"_62":89},"2026-10-19T09:00:00.000Z",[73,74,87,88,76,57,59,60],86,"在野利用","利用链","慢雾科技","zq3157zx2z8lo63ztow4kklgb","Apple 发布 2026 年 10 月安全更新，汇总大量漏洞修复","Apple 2026 年 10 月安全更新汇总了多项漏洞修复，涵盖 WebKit、Kernel、Remote Management、Screen Sharing Server 等组件，涉及远程代码执行、权限提升、内存泄露、拒绝服务和 Gatekeeper 绕过等问题。","这份月度汇总集中列出 Apple 修复的众多漏洞及影响组件，便于按 CVE 快速梳理本次更新范围。",{"_62":102},"2026-10-27T02:09:55.000Z","vuln",[99,100,87,101,59],73,"漏洞","补丁","汇总","SANS ISC","yocbcrg7ag66qmssktcr4jvbu","Apple 将已被利用的 CoreGraphics 漏洞 CVE-2026-86950 修复回移至旧版 iPhone 和 iPad","Apple 将已在真实攻击中被利用的 CoreGraphics 越界写入漏洞 CVE-2026-86950 修复回移至 iOS 18.7.11 和 iPadOS 18.7.11，CVSS 为 8.8。","文章说明了受在野利用漏洞的补丁回移范围与受影响旧设备版本，便于相关用户判断是否需要升级处置。",{"_62":111},"2026-10-27T13:59:09.000Z",[99,100,87,57,59],78,"The Hacker News","q3shvdlx2xyvmluni49s27g4s","Anthropic 未发布模型将 Chrome、Safari、Windows 与 Linux 缺陷串联为 PoC","Anthropic 称其未发布的内部研究模型在实验室中为 Chrome、Safari、Android、Windows 和 Linux 构造了可运行的 PoC，这些利用未出现在真实攻击中，相关缺陷均已先行报告厂商并完成修复。","文章梳理模型自动串联多组缺陷生成可运行 PoC 的能力，并对照厂商记录指出部分归因仍缺乏公开证据。",{"_62":111},"2026-10-28T08:15:07.000Z","2026-10-28T09:02:45.201Z","ai-security",[55,121,53,122,87,123,60,59,124,125],"AI 攻防","漏洞利用","大模型","Microsoft","CISA","xotvn8h2ady8nq85xed82tncq","Apple 间谍软件告警送达德国联邦议院，BSI 要求受影响者按设备失陷处置","Apple 自 2026 年 10 月 29 日起通知多名德国联邦议院议员、政界人士及其他公众人物，其 iPhone 遭到政府支持的雇佣间谍软件攻击；BSI 尚不确定通知代表成功感染还是攻击尝试，已向受影响者发出提醒并要求联系机构。","材料汇总了德国政界收到间谍软件告警后的影响范围与不确定性，并给出 BSI 针对设备取证、账号安全和通信工具的具体处置建议。",{"_62":134},"2026-11-03T06:24:38.000Z","2026-11-03T07:06:21.843Z",[73,74,57,59],"Security Affairs","kodarv143bm6tdtz8vpt6lz9c","APT29 关联黑客劫持 Plerdy SEO Tracker 投递 iOS 与 Android 利用链","Sekoia 称，俄罗斯关联威胁组织 APT29 借被入侵网站、仿冒域名和乌克兰 Plerdy SEO Tracker 供应链攻击开展名为 Poisoned Source 的水坑活动，向 iOS 与 Android 用户投递 N-day 利用链并窃取浏览器 Cookie、Wi-Fi 密码及移动设备数据。","文章梳理了针对 iOS 和 Android 用户的投递方式、利用链与数据窃取目标，还给出了具体 CVE 和感染基础设施，便于防守方识别关联活动。",{"_62":111},"2026-11-04T14:27:52.000Z","2026-11-04T14:52:23.782Z",[73,87,122,74,76,144,59,60,145],90,"供应链投毒","Mozilla","h4p9vcjmsjnhvfrc0yxfbnevx","Web3Auth 漏洞已被利用盗取 Keplr 加密资产，Google 与 Apple 登录账户受影响","攻击者利用 Web3Auth 基础设施安全缺陷进入部分通过 Google 或 Apple 登录创建的 Keplr 钱包并盗取加密资产。Keplr 联合 Web3Auth 将其余风险钱包的资金转移至 11 个 Cosmos 家族链和 8 个以太坊风格链上的恢复钱包，因此余额清空可能是资金获救而非被盗；恢复短语钱包和硬件钱包不受影响。","材料区分了真实盗取与安全转移的资金，并给出受影响账户规模、链上金额和用户处置建议，可用于判断钱包风险与资金状态。",{"_62":111},"2026-11-09T10:56:25.000Z","2026-11-09T12:04:17.996Z",[73,87,76,154,155,60,59],"凭据","加密","slug","apple","Apple / 苹果","group","company","definition","iOS、macOS 与 Safari 的安全公告与零日利用跟踪。","brand",{"_178":-5,"_179":180,"_181":170},"total",9,"recent",7,"indexable",false,"latest",{"_31":147,"_177":152},"groupName","厂商与机构","poolTotal",34,"at","src","monogram","A","raster",{"_183":184,"_185":-5},"changelogVersion","2026-10-01T08:00","release"]
