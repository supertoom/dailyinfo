[{"_1":2,"_3":4},"root",{"_5":149},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1793621698000,{"_123":124,"_59":125,"_126":127,"_128":129,"_130":131,"_132":133,"_134":135,"_136":137,"_138":139,"_140":141,"_142":143},"modules",{},"items",[20,21,22,23,24,25],"page",1,"pageCount","pageSize",20,{"_26":109,"_28":110,"_30":111,"_32":112,"_34":113,"_36":114,"_38":115,"_39":116,"_41":117,"_43":69,"_45":46,"_47":48,"_49":-5},{"_26":100,"_28":101,"_30":102,"_32":103,"_34":104,"_36":105,"_38":105,"_39":93,"_41":106,"_43":107,"_45":46,"_47":48,"_49":-5},{"_26":87,"_28":88,"_30":89,"_32":90,"_34":91,"_36":92,"_38":92,"_39":93,"_41":94,"_43":95,"_45":46,"_47":48,"_49":-5},{"_26":76,"_28":77,"_30":78,"_32":79,"_34":80,"_36":81,"_38":81,"_39":67,"_41":82,"_43":83,"_45":46,"_47":48,"_49":-5},{"_26":61,"_28":62,"_30":63,"_32":64,"_34":65,"_36":66,"_38":66,"_39":67,"_41":68,"_43":69,"_45":46,"_47":48,"_49":-5},{"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":37,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48,"_49":-5},"id","hegwfchoh8ewaw8ebcfpt0rl5","title","Bright Data SDK 技术研究：智能电视与 iOS 设备如何成为 AI 抓取代理节点","summary","Include Security 逆向分析 Bright Data iOS SDK 并观测 30 天流量，揭示其经 WebSocket 接收抓取任务、以用户住宅 IP 执行请求，以及绕过 VPN 检查的机制。","reason","文章通过逆向与运行时流量观测还原 SDK 代理机制，并给出网络侧和终端侧的可落地检测方向。","source",{"_59":60},"publishedAt","2026-06-05T16:01:11.000Z","timelineAt","category","disclosure","tags",[50,51,52,53,54,55,56,57,58],"score",74,"selected",true,"channel","news","x","技术研究","逆向","AI 安全","IoT","移动端","云原生","Apple","Google","Cloudflare","name","Inception Security","dfsrf7m8ypk15pgptp2nbgapl","macOS.Gaslight Rust 后门利用提示注入干扰 LLM 分析","macOS.Gaslight 是面向 macOS 的 Rust 后门与信息窃取程序，通过 Telegram Bot API 进行 C2 通信，并使用 AES-GCM 和证书固定隐藏流量。","原文拆解了针对分析 Agent 的提示注入载荷及其实现方式，为构建安全分析流程和样本隔离策略提供具体参考。",{"_59":75},"2026-06-23T21:59:42.000Z","activity",[70,71,72,52,73,56,74],70,"攻击活动","恶意软件","后门","数据窃取","SentinelOne","SentinelLabs","nv5z7uyciraj8jnruy9fuk4pg","慢雾披露 DarkSword iOS 攻击套件已产品化并用于窃密","慢雾发现 DarkSword 攻击套件已被封装成可部署的 iOS 窃密平台，通过伪装落地页和版本分流触发利用链。面板显示 57 台设备、10,125 条窃取记录和 9 次数据外传，并上线钱包解密与归集功能；代码确认可完整利用的窗口为 iOS 18.6 至 18.7.2及 26.0 至 26.1，另有针对 CVE-2026-43818 的利用仍待真机验证。","原文通过代码比对、面板数据与基础设施关联，呈现了公开利用链如何被封装为可运营的 iOS 窃密与钱包变现平台。",{"_59":86},"2026-10-19T09:00:00.000Z",[70,71,84,85,73,54,56,57],86,"在野利用","利用链","慢雾科技","zq3157zx2z8lo63ztow4kklgb","Apple 发布 2026 年 10 月安全更新，汇总大量漏洞修复","Apple 2026 年 10 月安全更新汇总了多项漏洞修复，涵盖 WebKit、Kernel、Remote Management、Screen Sharing Server 等组件，涉及远程代码执行、权限提升、内存泄露、拒绝服务和 Gatekeeper 绕过等问题。","这份月度汇总集中列出 Apple 修复的众多漏洞及影响组件，便于按 CVE 快速梳理本次更新范围。",{"_59":99},"2026-10-27T02:09:55.000Z","vuln",[96,97,84,98,56],73,"漏洞","补丁","汇总","SANS ISC","yocbcrg7ag66qmssktcr4jvbu","Apple 将已被利用的 CoreGraphics 漏洞 CVE-2026-86950 修复回移至旧版 iPhone 和 iPad","Apple 将已在真实攻击中被利用的 CoreGraphics 越界写入漏洞 CVE-2026-86950 修复回移至 iOS 18.7.11 和 iPadOS 18.7.11，CVSS 为 8.8。","文章说明了受在野利用漏洞的补丁回移范围与受影响旧设备版本，便于相关用户判断是否需要升级处置。",{"_59":108},"2026-10-27T13:59:09.000Z",[96,97,84,54,56],78,"The Hacker News","q3shvdlx2xyvmluni49s27g4s","Anthropic 未发布模型将 Chrome、Safari、Windows 与 Linux 缺陷串联为 PoC","Anthropic 称其未发布的内部研究模型在实验室中为 Chrome、Safari、Android、Windows 和 Linux 构造了可运行的 PoC，这些利用未出现在真实攻击中，相关缺陷均已先行报告厂商并完成修复。","文章梳理模型自动串联多组缺陷生成可运行 PoC 的能力，并对照厂商记录指出部分归因仍缺乏公开证据。",{"_59":108},"2026-10-28T08:15:07.000Z","2026-10-28T09:02:45.201Z","ai-security",[52,118,50,119,84,120,57,56,121,122],"AI 攻防","漏洞利用","大模型","Microsoft","CISA","slug","apple","Apple / 苹果","group","company","definition","iOS、macOS 与 Safari 的安全公告与零日利用跟踪。","brand",{"_145":-5,"_146":147,"_148":137},"total",6,"recent",4,"indexable",false,"latest",{"_28":110,"_144":115},"groupName","厂商与机构","poolTotal",18,"at","src","monogram","A","raster",{"_150":151,"_152":-5},"changelogVersion","2026-10-01T08:00","release"]
