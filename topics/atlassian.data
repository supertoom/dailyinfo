[{"_1":2,"_3":4},"root",{"_5":103},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795653417000,{"_79":80,"_53":51,"_81":82,"_83":84,"_85":86,"_87":88,"_89":16,"_90":91,"_92":93,"_94":95,"_96":97},"modules",{},"items",[20,21,22],"page",1,"pageCount","pageSize",20,{"_23":67,"_25":68,"_27":69,"_29":70,"_31":71,"_33":72,"_35":73,"_36":61,"_38":74,"_40":75,"_42":43,"_44":45,"_46":-5},{"_23":55,"_25":56,"_27":57,"_29":58,"_31":59,"_33":60,"_35":60,"_36":61,"_38":62,"_40":63,"_42":43,"_44":45,"_46":-5},{"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":34,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":-5},"id","tnandpger4ftaac4v7wv01mx4","title","Atlassian Jira、Confluence 等产品 CVE-2026-21589 未认证任意文件读取利用链分析","summary","watchTowr Labs 复现了 Atlassian 多款产品 CVE-2026-21589 的未认证任意文件读取漏洞，并披露从读取 WEB-INF 文件到获取 Crowd 管理员权限的利用链。","reason","文章通过对比修复版本与反编译组件，梳理了路径遍历到 Crowd 管理员权限的完整利用链，并提供可复现的 PoC 与检测工具。","source",{"_53":54},"publishedAt","2026-10-06T17:01:36.000Z","timelineAt","category","disclosure","tags",[47,48,49,50,51,52],"score",83,"selected",true,"channel","news","x","漏洞分析","复现","漏洞利用","利用链","Atlassian","身份与访问","name","watchTowr Labs","qw9w0viuk627re5dfawoguon4","Atlassian Jira 等八款产品存在未认证任意文件读取漏洞 CVE-2026-21589","Atlassian Jira 等八款产品存在未认证任意文件读取漏洞 CVE-2026-21589，微步情报局已成功复现。攻击者可通过构造包含 ..:: 的恶意请求读取 Tomcat 应用上下文内的任意文件，并可进一步读取 Crowd 明文凭据、创建管理员账户。","原文给出可复现的未认证利用链、八款产品的受影响版本和官方缓解措施，便于读者核对资产并制定修复优先级。",{"_53":66},"2026-10-08T02:21:00.000Z","vuln",[64,48,49,51,65],81,"漏洞","漏洞管理","微步在线研究响应中心","npdhl1v55b5kdqnab2s0etv9h","Rapid7发现CVE-2026-90436已被用于攻击Atlassian Confluence Data Center和N-able N-central","Rapid7 MDR于11月13日在客户环境中检测到CVE-2026-90436对Atlassian Confluence Data Center的利用，N-able也报告了针对N-central的强关联漏洞在野利用。","Rapid7提供真实客户环境中的利用观测、产品级处置方法和关联IOC，可用于核对暴露系统并排查入侵痕迹。",{"_53":78},"2026-11-16T18:14:14.000Z","2026-11-16T18:59:19.322Z",[64,76,49,51,77],88,"在野利用","Rapid7","Rapid7 CVE 公告","slug","atlassian","group","company","definition","Jira、Confluence、Bitbucket 的安全公告与研究者的漏洞分析。","brand",{"_99":-5,"_100":101,"_102":91},"total",3,"recent","indexable",false,"latest",{"_25":68,"_98":73},"groupName","厂商与机构","poolTotal",5,"at","src","monogram","A","raster",{"_104":105,"_106":-5},"changelogVersion","2026-10-01T08:00","release"]
