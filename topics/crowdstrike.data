[{"_1":2,"_3":4},"root",{"_5":135},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1793667145000,{"_112":113,"_56":55,"_114":115,"_116":117,"_118":119,"_120":121,"_122":121,"_123":124,"_125":126,"_127":128,"_129":19},"modules",{},"items",[20,21,22,23,24,25],"page",1,"pageCount","pageSize",20,{"_26":102,"_28":103,"_30":104,"_32":105,"_34":106,"_36":107,"_38":108,"_39":40,"_41":109,"_43":110,"_45":46,"_47":48,"_49":-5},{"_26":94,"_28":95,"_30":96,"_32":97,"_34":98,"_36":99,"_38":99,"_39":40,"_41":100,"_43":44,"_45":46,"_47":48,"_49":-5},{"_26":83,"_28":84,"_30":85,"_32":86,"_34":87,"_36":88,"_38":88,"_39":40,"_41":89,"_43":90,"_45":46,"_47":48,"_49":-5},{"_26":72,"_28":73,"_30":74,"_32":75,"_34":76,"_36":62,"_38":62,"_39":40,"_41":77,"_43":78,"_45":46,"_47":48,"_49":-5},{"_26":57,"_28":58,"_30":59,"_32":60,"_34":61,"_36":62,"_38":62,"_39":63,"_41":64,"_43":65,"_45":46,"_47":48,"_49":-5},{"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":37,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48,"_49":-5},"id","i4w1d5s1yi5ny84n1k01o6pvh","title","美国政府联手CrowdStrike捣毁FAMOUS CHOLLIMA美国笔记本农场","summary","美国政府与CrowdStrike在2026年9月底联合捣毁了FAMOUS CHOLLIMA在美国运营的多个笔记本农场。该组织通过虚假或盗用身份混入美国企业，将雇主设备转运至农场，部署RMM工具以维持远程访问并转走非法工资，受害组织横跨航空航天、能源、金融服务、医疗保健、网络安全、国防工程、政府技术和消费技术等领域。","reason","文章披露了FAMOUS CHOLLIMA利用笔记本农场实施就业欺诈和持续访问的方式，并给出核查虚假招聘身份的具体指标。","source",{"_56":55},"publishedAt","2026-10-13T05:00:00.000Z","timelineAt","category","activity","tags",[50,51,52,53,54,55],"score",72,"selected",true,"channel","news","x","攻击活动","黑产","身份与访问","红队","检测工程","CrowdStrike","name","ixd6ojakzb1bs6fbhiueb7j6f","CrowdStrike 披露 PHP 核心 RCE 漏洞 CVE-2026-109618 与 CVE-2026-109619","CrowdStrike 披露 PHP 核心中的两个 RCE 漏洞 CVE-2026-109618 和 CVE-2026-109619，二者 CVSS 4.0 均为 9.2，未认证攻击者可经 HTTP 在受影响 Web 服务器执行任意系统命令。","原文从 Zend 的 longjmp() 清理缺陷切入，拆解两个 RCE 的触发链、请求生命周期差异与配置前提，并给出可复现的验证路径。",{"_56":55},"2026-10-21T05:00:00.000Z","vuln",[66,67,68,69,54,70,55,71],81,"漏洞","复现","漏洞利用","技术研究","供应链","PHP","pfamht6ttxo94i9o08pvxfj8j","CrowdStrike 披露四起利用 Claude Code 的 Agentic AI 攻击活动","CrowdStrike 记录四名攻击者利用 Claude Code 开展 Agentic AI 攻击活动，其中至少 15 家阿根廷医疗机构的凭据和病历被窃取。攻击者采用双代理、预设工作流、专业代理并行及技能组合等不同框架推进侦察、漏洞利用和数据外传，部分活动还需人工干预以绕过模型安全限制。","四个攻击者将 Claude Code 接入自主渗透框架，覆盖侦察、利用与数据外传，为理解 AI 代理化攻击的编排方式和规模效应提供案例。",{"_56":55},[50,79,80,81,82,55],79,"AI 攻防","Agent 安全","AI 编码","大模型","x6q4pskmkuz0xm5and4kr03k3","CyberCartel 使用 Claude、Grok 和 DeepSeek 智能体攻击 400 多家拉美金融机构","安全公司 Straiker 调查称，黑客组织 CyberCartel 使用 Claude、Grok 等大模型驱动 AI 智能体，全自动攻击 400 多家拉美银行和支付应用。CrowdStrike 补充称攻击者还使用 DeepSeek，智能体可在较少人工干预下完成侦察、凭据窃取、账户接管及客户数据窃取。原文建议防守方建立动态行为基线、落实零信任与多因素认证，并针对 AI 智能体开展红队演练。","梳理了多模型智能体覆盖侦察、凭据窃取、账户接管和数据变现的攻击链条，并提出行为基线、零信任与多因素认证等防守思路。",{"_56":93},"2026-10-22T07:57:59.000Z",[50,79,80,82,91,92,55],73,"凭据","数据窃取","安全客","eui3zsdjfmdtcdbrhhek3z9fm","CyberCartel 使用 Claude、Grok 和 DeepSeek 全自动攻击 400 多家拉美金融机构","CyberCartel 使用由 Claude、Grok 和 DeepSeek 等模型驱动的 AI 智能体网络，攻击 400 多家拉美银行与支付机构。智能体可自主完成侦察、凭据窃取、账户接管、客户数据窃取与横向移动，过程中几乎不需要人工操作；原文建议防守方建设动态行为基线、落实零信任、多因素认证和异常交易拦截，并引入 AI 演练。","该事件展示了 AI 智能体在凭据窃取、账户接管和横向移动中的自动化能力，为金融机构评估规模化攻击风险提供了具体背景。",{"_56":93},"2026-10-23T00:30:00.000Z",[50,79,101,82,80,53,55],"恶意软件","m8vt0mfprflyha4qd0f1jbnwd","VAPOR PANDA 使用 ARTEX 与 DeepSeek 并行入侵全球 200 多家组织","CrowdStrike 披露 VAPOR PANDA 自 2026 年 10 月 17 日起使用 ARTEX 和 DeepSeek 等 LLM，在 11 天内针对至少 14 个国家的 200 多家组织并行入侵。","活动轨迹、Agent 工作流和后门 IOC 均被公开，读者可据此理解 AI 驱动的入侵如何与传统入侵手法结合。",{"_56":55},"2026-10-29T05:00:00.000Z","2026-10-29T23:40:27.393Z",[50,101,111,79,80,82,55],86,"后门","slug","crowdstrike","group","company","definition","Falcon 平台的安全动态与对手画像研究。","brand",{"_131":-5,"_132":133,"_134":124},"total",6,"recent","indexable",false,"latest",{"_28":103,"_130":108},"groupName","厂商与机构","poolTotal","at","src","monogram","C","raster",{"_136":137,"_138":-5},"changelogVersion","2026-10-01T08:00","release"]
