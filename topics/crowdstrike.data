[{"_1":2,"_3":4},"root",{"_5":174},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1794357409000,{"_150":151,"_59":58,"_152":153,"_154":155,"_156":157,"_158":159,"_160":159,"_161":162,"_163":164,"_165":166,"_167":168},"modules",{},"items",[20,21,22,23,24,25,26,27,28],"page",1,"pageCount","pageSize",20,{"_29":140,"_31":141,"_33":142,"_35":143,"_37":144,"_39":145,"_41":146,"_42":43,"_44":147,"_46":148,"_48":49,"_50":51,"_52":-5},{"_29":126,"_31":127,"_33":128,"_35":129,"_37":130,"_39":131,"_41":132,"_42":43,"_44":133,"_46":134,"_48":49,"_50":51,"_52":-5},{"_29":115,"_31":116,"_33":117,"_35":118,"_37":119,"_39":120,"_41":121,"_42":43,"_44":122,"_46":81,"_48":49,"_50":51,"_52":-5},{"_29":105,"_31":106,"_33":107,"_35":108,"_37":109,"_39":110,"_41":111,"_42":43,"_44":112,"_46":113,"_48":49,"_50":51,"_52":-5},{"_29":97,"_31":98,"_33":99,"_35":100,"_37":101,"_39":102,"_41":102,"_42":43,"_44":103,"_46":47,"_48":49,"_50":51,"_52":-5},{"_29":86,"_31":87,"_33":88,"_35":89,"_37":90,"_39":91,"_41":91,"_42":43,"_44":92,"_46":93,"_48":49,"_50":51,"_52":-5},{"_29":75,"_31":76,"_33":77,"_35":78,"_37":79,"_39":65,"_41":65,"_42":43,"_44":80,"_46":81,"_48":49,"_50":51,"_52":-5},{"_29":60,"_31":61,"_33":62,"_35":63,"_37":64,"_39":65,"_41":65,"_42":66,"_44":67,"_46":68,"_48":49,"_50":51,"_52":-5},{"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":40,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":-5},"id","i4w1d5s1yi5ny84n1k01o6pvh","title","美国政府联手CrowdStrike捣毁FAMOUS CHOLLIMA美国笔记本农场","summary","美国政府与CrowdStrike在2026年9月底联合捣毁了FAMOUS CHOLLIMA在美国运营的多个笔记本农场。该组织通过虚假或盗用身份混入美国企业，将雇主设备转运至农场，部署RMM工具以维持远程访问并转走非法工资，受害组织横跨航空航天、能源、金融服务、医疗保健、网络安全、国防工程、政府技术和消费技术等领域。","reason","文章披露了FAMOUS CHOLLIMA利用笔记本农场实施就业欺诈和持续访问的方式，并给出核查虚假招聘身份的具体指标。","source",{"_59":58},"publishedAt","2026-10-13T05:00:00.000Z","timelineAt","category","activity","tags",[53,54,55,56,57,58],"score",72,"selected",true,"channel","news","x","攻击活动","黑产","身份与访问","红队","检测工程","CrowdStrike","name","ixd6ojakzb1bs6fbhiueb7j6f","CrowdStrike 披露 PHP 核心 RCE 漏洞 CVE-2026-109618 与 CVE-2026-109619","CrowdStrike 披露 PHP 核心中的两个 RCE 漏洞 CVE-2026-109618 和 CVE-2026-109619，二者 CVSS 4.0 均为 9.2，未认证攻击者可经 HTTP 在受影响 Web 服务器执行任意系统命令。","原文从 Zend 的 longjmp() 清理缺陷切入，拆解两个 RCE 的触发链、请求生命周期差异与配置前提，并给出可复现的验证路径。",{"_59":58},"2026-10-21T05:00:00.000Z","vuln",[69,70,71,72,57,73,58,74],81,"漏洞","复现","漏洞利用","技术研究","供应链","PHP","pfamht6ttxo94i9o08pvxfj8j","CrowdStrike 披露四起利用 Claude Code 的 Agentic AI 攻击活动","CrowdStrike 记录四名攻击者利用 Claude Code 开展 Agentic AI 攻击活动，其中至少 15 家阿根廷医疗机构的凭据和病历被窃取。攻击者采用双代理、预设工作流、专业代理并行及技能组合等不同框架推进侦察、漏洞利用和数据外传，部分活动还需人工干预以绕过模型安全限制。","四个攻击者将 Claude Code 接入自主渗透框架，覆盖侦察、利用与数据外传，为理解 AI 代理化攻击的编排方式和规模效应提供案例。",{"_59":58},[53,82,83,84,85,58],79,"AI 攻防","Agent 安全","AI 编码","大模型","x6q4pskmkuz0xm5and4kr03k3","CyberCartel 使用 Claude、Grok 和 DeepSeek 智能体攻击 400 多家拉美金融机构","安全公司 Straiker 调查称，黑客组织 CyberCartel 使用 Claude、Grok 等大模型驱动 AI 智能体，全自动攻击 400 多家拉美银行和支付应用。CrowdStrike 补充称攻击者还使用 DeepSeek，智能体可在较少人工干预下完成侦察、凭据窃取、账户接管及客户数据窃取。原文建议防守方建立动态行为基线、落实零信任与多因素认证，并针对 AI 智能体开展红队演练。","梳理了多模型智能体覆盖侦察、凭据窃取、账户接管和数据变现的攻击链条，并提出行为基线、零信任与多因素认证等防守思路。",{"_59":96},"2026-10-22T07:57:59.000Z",[53,82,83,85,94,95,58],73,"凭据","数据窃取","安全客","eui3zsdjfmdtcdbrhhek3z9fm","CyberCartel 使用 Claude、Grok 和 DeepSeek 全自动攻击 400 多家拉美金融机构","CyberCartel 使用由 Claude、Grok 和 DeepSeek 等模型驱动的 AI 智能体网络，攻击 400 多家拉美银行与支付机构。智能体可自主完成侦察、凭据窃取、账户接管、客户数据窃取与横向移动，过程中几乎不需要人工操作；原文建议防守方建设动态行为基线、落实零信任、多因素认证和异常交易拦截，并引入 AI 演练。","该事件展示了 AI 智能体在凭据窃取、账户接管和横向移动中的自动化能力，为金融机构评估规模化攻击风险提供了具体背景。",{"_59":96},"2026-10-23T00:30:00.000Z",[53,82,104,85,83,56,58],"恶意软件","m8vt0mfprflyha4qd0f1jbnwd","VAPOR PANDA 使用 ARTEX 与 DeepSeek 并行入侵全球 200 多家组织","CrowdStrike 披露 VAPOR PANDA 自 2026 年 10 月 17 日起使用 ARTEX 和 DeepSeek 等 LLM，在 11 天内针对至少 14 个国家的 200 多家组织并行入侵。","活动轨迹、Agent 工作流和后门 IOC 均被公开，读者可据此理解 AI 驱动的入侵如何与传统入侵手法结合。",{"_59":58},"2026-10-29T05:00:00.000Z","2026-10-29T23:40:27.393Z",[53,104,114,82,83,85,58],86,"后门","ry1s8823u73qzqqdpklkue81e","WorkOS 称攻击者利用 ARTEX AI 入侵内部销售应用","WorkOS 称攻击者使用 ARTEX AI 渗透测试框架自动执行侦察与利用尝试，入侵了销售团队使用的内部应用。2026年10月30日发现未授权访问后，公司关闭外部访问、审查内部工具权限，并聘请独立取证与事件响应机构调查影响。","WorkOS披露了攻击者如何借助 ARTEX AI 自动化侦察与利用，并列出泄露字段和处置措施，便于相关组织评估社工风险。",{"_59":125},"2026-11-03T21:28:44.000Z","2026-11-03T22:16:21.110Z",[53,123,82,56,94,124,58],"数据泄露","钓鱼","BleepingComputer","dxhu6zoooyev95kp3k297dewf","CrowdStrike 披露攻击者利用公开 PoC 快速武器化漏洞","攻击者正快速把公开漏洞研究改造成可部署的利用工具。CrowdStrike 在 2026 年 1 月至 7 月观察到，公开 PoC 至在野利用的中位时间不足 1 天，最快为 35 分钟，91% 的已观察利用在 PoC 发布后 48 小时内发生。","文章用多起真实利用案例说明公开 PoC 正被快速武器化，为补丁优先级、修复时效与检测能力建设提供可迁移依据。",{"_59":58},"2026-11-05T06:00:00.000Z","2026-11-05T20:01:15.996Z",[53,135,71,72,136,137,58,138,139],76,"在野利用","AI 安全","漏洞管理","Fortinet","Ubuntu","ucovakubvkebsauqv049n97vi","Hunt.io 披露 ARTEX 攻击韩国 7 家金融机构数据泄露","Hunt.io 追踪了 ARTEX 开源自主渗透测试框架及其 AI 攻击基础设施，关联 2026 年 9 月底至 10 月初韩国 7 家金融机构通过互联网暴露系统发起的泄露事件，影响约 66,000 至 67,000 人和约 2,200 家公司，个人、就业、收入与贷款数据外泄。","文章梳理了 ARTEX 攻击基础设施与 AI 模型调用链，并给出暴露面、凭据轮换和流量监测方面的处置建议。",{"_59":149},"2026-11-07T19:56:18.000Z","2026-11-07T23:51:34.162Z",[53,104,82,85,123,56,58],78,"Security Affairs","slug","crowdstrike","group","company","definition","Falcon 平台的安全动态与对手画像研究。","brand",{"_170":-5,"_171":172,"_173":162},"total",9,"recent","indexable",false,"latest",{"_31":141,"_169":146},"groupName","厂商与机构","poolTotal",34,"at","src","monogram","C","raster",{"_175":176,"_177":-5},"changelogVersion","2026-10-01T08:00","release"]
