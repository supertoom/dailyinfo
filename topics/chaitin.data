[{"_1":2,"_3":4},"root",{"_5":119},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1794184871000,{"_94":95,"_53":96,"_97":98,"_99":100,"_101":102,"_103":104,"_105":104,"_106":107,"_108":109,"_110":111,"_112":113},"modules",{},"items",[20,21,22,23,24],"page",1,"pageCount","pageSize",20,{"_25":87,"_27":88,"_29":89,"_31":90,"_33":91,"_35":92,"_37":92,"_38":61,"_40":93,"_42":43,"_44":45,"_46":47,"_48":-5},{"_25":78,"_27":79,"_29":80,"_31":81,"_33":82,"_35":83,"_37":83,"_38":61,"_40":84,"_42":85,"_44":45,"_46":47,"_48":-5},{"_25":68,"_27":69,"_29":70,"_31":71,"_33":72,"_35":73,"_37":73,"_38":61,"_40":74,"_42":75,"_44":45,"_46":47,"_48":-5},{"_25":55,"_27":56,"_29":57,"_31":58,"_33":59,"_35":60,"_37":60,"_38":61,"_40":62,"_42":63,"_44":45,"_46":47,"_48":-5},{"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":36,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47,"_48":-5},"id","wcrdy8w75bnhqsxi3w6crc0sv","title","AnyDesk Linux 堆缓冲区溢出漏洞 CVE-2026-109390 已复现，影响 8.0.3 之前版本","summary","AnyDesk Linux < 8.0.3 存在预认证堆缓冲区溢出漏洞 CVE-2026-109390，可导致远程代码执行。长亭安全应急响应中心已复现，未经认证且无需用户交互的远程请求可在服务进程权限下执行任意命令，Linux 环境下验证结果为 root 权限，但成功率受堆布局影响。厂商已发布 AnyDesk Linux 8.0.3，建议尽快升级至 8.0.3 或更高版本并确认服务重启。","reason","通告完整呈现了漏洞成因、利用前提、复现结果与修复版本，并指出利用受堆布局影响，为防守人员评估风险和安排升级提供依据。","source",{"_53":54},"publishedAt","2026-10-13T03:49:00.000Z","timelineAt","category","disclosure","tags",[49,50,51,52],"score",87,"selected",true,"channel","news","x","复现","漏洞分析","漏洞利用","长亭","name","长亭安全应急响应中心","v22ixd6m0t6ddako3k16rb1cl","GitLab CI/CD 远程代码执行漏洞 CVE-2026-97229 已复现","GitLab CE/EE 的 CI/CD 正则表达式编译器存在可导致远程代码执行的整数溢出漏洞 CVE-2026-97229，长亭安全应急响应中心已复现匿名触发。","通告还原了正则表达式编译器的整数溢出成因与绕过路径，并给出复现、影响版本和修复版本，便于自建实例评估风险。",{"_53":54},"2026-10-14T08:00:00.000Z","vuln",[64,49,51,65,66,67,52],80,"漏洞","补丁","利用链","供应链","ukq09uvql17jp0u76ha93kqb3","长亭复现 Ivanti Connect Secure 未认证 RCE 与提权漏洞链 CVE-2026-104935","长亭安全应急响应中心已复现 Ivanti Connect Secure 无需认证的 RCE 与提权漏洞链 CVE-2026-104935，攻击者可绕过身份认证并最终以 root 权限执行任意代码。","材料复现了无需认证的 RCE 与提权链路，并给出受影响版本、修复分支和过渡方案，便于核对资产与处置优先级。",{"_53":54},"2026-10-16T04:04:00.000Z",[64,49,76,65,51,77,52],86,"在野利用","Ivanti","mxkydmtlqh5wragjb8kq4vf86","长亭复现 PHP Core 远程代码执行漏洞 CVE-2026-109618/109619","长亭安全应急响应中心已复现 PHP Core 的释放后重用漏洞 CVE-2026-109618、CVE-2026-109619，在 PHP 8.5.11 与 Apache 2.4.68 环境中 3/3 触发 SIGSEGV，完整利用链仍在验证。","文章在 PHP 8.5.11 与 Apache 2.4.68 环境中稳定复现崩溃，并给出补丁发布计划和可操作的临时缓解方案。",{"_53":54},"2026-10-21T03:53:00.000Z",[64,49,50,86,52],71,"PHP","ovkxg7gwsxi3glcmq2ynflooj","长亭复现 PHP Core RCE 漏洞 CVE-2026-109618/109619，php2shell 利用链已公开","长亭安全应急响应中心已复现 PHP Core 远程代码执行漏洞 CVE-2026-109618/109619，并将其利用链称为 php2shell。","文章给出完整跨请求利用链、受影响版本和修复版本，并提供各安全产品的检测支持状态，便于评估 PHP 部署风险与处置优先级。",{"_53":54},"2026-10-22T10:59:00.000Z",[64,49,51,65,86,52],"slug","chaitin","长亭科技","group","company","definition","长亭应急响应中心的漏洞复现与在野利用跟踪，以及 Chaitin 与 Yakit 工具链。","brand",{"_115":-5,"_116":117,"_118":107},"total",5,"recent","indexable",false,"latest",{"_27":88,"_114":92},"groupName","厂商与机构","poolTotal",6,"at","src","monogram","长","raster",{"_120":121,"_122":-5},"changelogVersion","2026-10-01T08:00","release"]
