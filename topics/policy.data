[{"_1":2,"_3":4},"root",{"_5":96},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1794530260000,{"_77":37,"_51":78,"_79":80,"_81":82,"_83":-5,"_84":85,"_86":85,"_87":88,"_89":90,"_91":92,"_93":94},"modules",{},"items",[20,21,22],"page",1,"pageCount","pageSize",20,{"_23":65,"_25":66,"_27":67,"_29":68,"_31":69,"_33":70,"_35":71,"_36":37,"_38":72,"_40":73,"_42":43,"_44":45,"_46":-5},{"_23":53,"_25":54,"_27":55,"_29":56,"_31":57,"_33":58,"_35":59,"_36":37,"_38":60,"_40":61,"_42":43,"_44":45,"_46":-5},{"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":34,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":-5},"id","frcixaysupt04wvmk42g5cf8b","title","英国以洗钱和规避金融限制为由制裁 Cryptomus、VexPay、TokenSpot 与 Tsunami Payments","summary","英国以处理惠及俄罗斯政府及金融机构的钱款为由制裁 Cryptomus 等支付平台，冻结其在英国银行的资产并禁止英国企业提供任何业务。Chainalysis 称 Cryptomus 与 Heleket 已成为非法资金支付枢纽，2025年末单月涉及的非法交易对手方超过 900 个；TRM Labs 则称该平台自 2022 年以来处理超过 $7 billion 交易。","reason","文章梳理英国制裁及加密支付基础设施关联的非法资金活动，并对比罚款与制裁的处置效果。","source",{"_51":52},"publishedAt","2026-10-14T14:22:49.000Z","timelineAt","category","policy","tags",[47,48,49,50],"score",71,"selected",true,"channel","news","x","政策","黑产","加密","供应链","name","Krebs on Security","t6k8f35p29zqb72lval7s2ql3","NIST 发布后量子密码过渡路线图，设定 2030 至 2035 年迁移期限","NIST 发布《向后量子密码标准过渡》最终报告（NIST IR 8547），明确 RSA、ECDSA 及传统 Diffie-Hellman、椭圆曲线密钥建立方案的替代路径。","报告给出了不同系统与功能的具体迁移期限，并说明旧算法弃用安排，便于机构结合数据保密周期安排改造。",{"_51":64},"2026-10-29T11:42:54.964Z","2026-10-30T05:42:54.985Z",[62,63,49,50],72,"标准","治理","安全内参","mow0cdpvd3og7vp5dh6u2j1p1","US 禁止 MEXC 加密货币交易所接入美国金融体系","US 财政部因制裁规避和网络犯罪关联，将 MEXC 加密货币交易所排除在美国金融体系之外。FinCEN称，2021年5月至2026年5月，MEXC至少处理了160亿美元与网络犯罪及伊朗、朝鲜、俄罗斯制裁规避有关的非法交易，并截至2026年6月仍在处理与受制裁俄罗斯实体 Garantex、Grinex 的交易，另涉及至少2.26亿美元及A7制裁规避网络相关交易。","FinCEN列出了MEXC涉及的网络犯罪、制裁规避金额与交易对手，并说明接入其平台的潜在次级制裁风险。",{"_51":76},"2026-11-09T13:28:56.000Z","2026-11-09T14:33:17.161Z",[74,49,48,75,63],78,"法规","数据泄露","BleepingComputer","slug","政策法规","group","genre","definition","监管、标准、合规要求与厂商的经营动作。","brand","total",3,"recent","indexable",false,"latest",{"_25":66,"_95":71},"groupName","内容类型","poolTotal",90,"at",{"_97":98,"_99":-5},"changelogVersion","2026-10-01T08:00","release"]
