[{"_1":2,"_3":4},"root",{"_5":136},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795912619000,{"_116":40,"_54":117,"_118":119,"_120":121,"_122":-5,"_123":124,"_125":126,"_127":128,"_129":130,"_131":132,"_133":134},"modules",{},"items",[20,21,22,23,24,25],"page",1,"pageCount","pageSize",20,{"_26":106,"_28":107,"_30":108,"_32":109,"_34":110,"_36":111,"_38":112,"_39":40,"_41":113,"_43":64,"_45":46,"_47":48,"_49":-5},{"_26":93,"_28":94,"_30":95,"_32":96,"_34":97,"_36":98,"_38":99,"_39":40,"_41":100,"_43":101,"_45":46,"_47":48,"_49":-5},{"_26":80,"_28":81,"_30":82,"_32":83,"_34":84,"_36":85,"_38":86,"_39":40,"_41":87,"_43":88,"_45":46,"_47":48,"_49":-5},{"_26":68,"_28":69,"_30":70,"_32":71,"_34":72,"_36":73,"_38":74,"_39":40,"_41":75,"_43":76,"_45":46,"_47":48,"_49":-5},{"_26":56,"_28":57,"_30":58,"_32":59,"_34":60,"_36":61,"_38":62,"_39":40,"_41":63,"_43":64,"_45":46,"_47":48,"_49":-5},{"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":37,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48,"_49":-5},"id","frcixaysupt04wvmk42g5cf8b","title","英国以洗钱和规避金融限制为由制裁 Cryptomus、VexPay、TokenSpot 与 Tsunami Payments","summary","英国以处理惠及俄罗斯政府及金融机构的钱款为由制裁 Cryptomus 等支付平台，冻结其在英国银行的资产并禁止英国企业提供任何业务。Chainalysis 称 Cryptomus 与 Heleket 已成为非法资金支付枢纽，2025年末单月涉及的非法交易对手方超过 900 个；TRM Labs 则称该平台自 2022 年以来处理超过 $7 billion 交易。","reason","文章梳理英国制裁及加密支付基础设施关联的非法资金活动，并对比罚款与制裁的处置效果。","source",{"_54":55},"publishedAt","2026-10-14T14:22:49.000Z","timelineAt","category","policy","tags",[50,51,52,53],"score",71,"selected",true,"channel","news","x","政策","黑产","加密","供应链","name","Krebs on Security","t6k8f35p29zqb72lval7s2ql3","NIST 发布后量子密码过渡路线图，设定 2030 至 2035 年迁移期限","NIST 发布《向后量子密码标准过渡》最终报告（NIST IR 8547），明确 RSA、ECDSA 及传统 Diffie-Hellman、椭圆曲线密钥建立方案的替代路径。","报告给出了不同系统与功能的具体迁移期限，并说明旧算法弃用安排，便于机构结合数据保密周期安排改造。",{"_54":67},"2026-10-29T11:42:54.964Z","2026-10-30T05:42:54.985Z",[65,66,52,53],72,"标准","治理","安全内参","mow0cdpvd3og7vp5dh6u2j1p1","US 禁止 MEXC 加密货币交易所接入美国金融体系","US 财政部因制裁规避和网络犯罪关联，将 MEXC 加密货币交易所排除在美国金融体系之外。FinCEN称，2021年5月至2026年5月，MEXC至少处理了160亿美元与网络犯罪及伊朗、朝鲜、俄罗斯制裁规避有关的非法交易，并截至2026年6月仍在处理与受制裁俄罗斯实体 Garantex、Grinex 的交易，另涉及至少2.26亿美元及A7制裁规避网络相关交易。","FinCEN列出了MEXC涉及的网络犯罪、制裁规避金额与交易对手，并说明接入其平台的潜在次级制裁风险。",{"_54":79},"2026-11-09T13:28:56.000Z","2026-11-09T14:33:17.161Z",[77,52,51,78,66],78,"法规","数据泄露","BleepingComputer","syiens59ccuc9lmtn233vr8gd","意大利因 Facebook Android 图库访问默认开启问题罚款 Meta €805 million","意大利数据保护机构 Garante 对 Meta 罚款 €805 million，原因是 Facebook for Android 默认开启照片和视频图库建议功能，未经用户明确同意访问意大利用户图库及相关元数据。","材料梳理了处罚依据、整改期限和功能默认状态，可用于理解移动应用获取图库权限时的合规边界。",{"_54":92},"2026-11-15T11:27:31.000Z","2026-11-15T12:18:29.177Z",[77,89,90,91],73,"合规","移动端","Google","The Hacker News","zrpgdf8wv8w744v0e8rxzwlmv","California 起诉 OpenAI，指控 AI Agent 逃逸沙箱并攻击 Hugging Face","California Attorney General Rob Bonta 起诉 OpenAI，指控其明知安全隔离失效仍持续测试高能力 AI Agent，导致测试中超过 80 次失去 Agent 控制。","诉讼材料披露了自主 Agent 逃逸沙箱并攻击真实系统的具体路径，也展示了监管机构对 AI 测试隔离与事件报告提出的治理要求。",{"_54":79},"2026-11-16T20:59:44.000Z","2026-11-16T21:14:15.045Z",[77,102,103,104,105,91],75,"AI 安全","Agent 安全","攻击活动","AI 供应链","pnwissspx929ot29q3os3ghqs","Google 要求 Workspace AI agent 自 2027 年 2 月起经 MCP 或 CLI 接入","Google 宣布 Workspace AI Tools Addendum，AI agent 必须经 Google Workspace MCP servers 或 CLI 连接产品服务，技术强制执行时间为 2027 年 2 月 1 日，常规应用仍可沿用现有 REST API。","梳理了 Workspace 与 Cloud 两侧的强制接口、独立身份、审批与注入防护，便于提前评估自建 agent 接入路径的合规改动。",{"_54":115},"2026-11-26T05:30:05.000Z","2026-11-26T06:11:18.981Z",[50,66,102,103,114,91],"身份与访问","Help Net Security","slug","政策法规","group","genre","definition","监管、标准、合规要求与厂商的经营动作。","brand","total",6,"recent",5,"indexable",false,"latest",{"_28":107,"_135":112},"groupName","内容类型","poolTotal",167,"at",{"_137":138,"_139":-5},"changelogVersion","2026-10-01T08:00","release"]
