[{"_1":2,"_3":4},"root",{"_5":125},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795653419000,{"_105":39,"_53":106,"_107":108,"_109":110,"_111":-5,"_112":113,"_114":115,"_116":117,"_118":119,"_120":121,"_122":123},"modules",{},"items",[20,21,22,23,24],"page",1,"pageCount","pageSize",20,{"_25":92,"_27":93,"_29":94,"_31":95,"_33":96,"_35":97,"_37":98,"_38":39,"_40":99,"_42":100,"_44":45,"_46":47,"_48":-5},{"_25":79,"_27":80,"_29":81,"_31":82,"_33":83,"_35":84,"_37":85,"_38":39,"_40":86,"_42":87,"_44":45,"_46":47,"_48":-5},{"_25":67,"_27":68,"_29":69,"_31":70,"_33":71,"_35":72,"_37":73,"_38":39,"_40":74,"_42":75,"_44":45,"_46":47,"_48":-5},{"_25":55,"_27":56,"_29":57,"_31":58,"_33":59,"_35":60,"_37":61,"_38":39,"_40":62,"_42":63,"_44":45,"_46":47,"_48":-5},{"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":36,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47,"_48":-5},"id","frcixaysupt04wvmk42g5cf8b","title","英国以洗钱和规避金融限制为由制裁 Cryptomus、VexPay、TokenSpot 与 Tsunami Payments","summary","英国以处理惠及俄罗斯政府及金融机构的钱款为由制裁 Cryptomus 等支付平台，冻结其在英国银行的资产并禁止英国企业提供任何业务。Chainalysis 称 Cryptomus 与 Heleket 已成为非法资金支付枢纽，2025年末单月涉及的非法交易对手方超过 900 个；TRM Labs 则称该平台自 2022 年以来处理超过 $7 billion 交易。","reason","文章梳理英国制裁及加密支付基础设施关联的非法资金活动，并对比罚款与制裁的处置效果。","source",{"_53":54},"publishedAt","2026-10-14T14:22:49.000Z","timelineAt","category","policy","tags",[49,50,51,52],"score",71,"selected",true,"channel","news","x","政策","黑产","加密","供应链","name","Krebs on Security","t6k8f35p29zqb72lval7s2ql3","NIST 发布后量子密码过渡路线图，设定 2030 至 2035 年迁移期限","NIST 发布《向后量子密码标准过渡》最终报告（NIST IR 8547），明确 RSA、ECDSA 及传统 Diffie-Hellman、椭圆曲线密钥建立方案的替代路径。","报告给出了不同系统与功能的具体迁移期限，并说明旧算法弃用安排，便于机构结合数据保密周期安排改造。",{"_53":66},"2026-10-29T11:42:54.964Z","2026-10-30T05:42:54.985Z",[64,65,51,52],72,"标准","治理","安全内参","mow0cdpvd3og7vp5dh6u2j1p1","US 禁止 MEXC 加密货币交易所接入美国金融体系","US 财政部因制裁规避和网络犯罪关联，将 MEXC 加密货币交易所排除在美国金融体系之外。FinCEN称，2021年5月至2026年5月，MEXC至少处理了160亿美元与网络犯罪及伊朗、朝鲜、俄罗斯制裁规避有关的非法交易，并截至2026年6月仍在处理与受制裁俄罗斯实体 Garantex、Grinex 的交易，另涉及至少2.26亿美元及A7制裁规避网络相关交易。","FinCEN列出了MEXC涉及的网络犯罪、制裁规避金额与交易对手，并说明接入其平台的潜在次级制裁风险。",{"_53":78},"2026-11-09T13:28:56.000Z","2026-11-09T14:33:17.161Z",[76,51,50,77,65],78,"法规","数据泄露","BleepingComputer","syiens59ccuc9lmtn233vr8gd","意大利因 Facebook Android 图库访问默认开启问题罚款 Meta €805 million","意大利数据保护机构 Garante 对 Meta 罚款 €805 million，原因是 Facebook for Android 默认开启照片和视频图库建议功能，未经用户明确同意访问意大利用户图库及相关元数据。","材料梳理了处罚依据、整改期限和功能默认状态，可用于理解移动应用获取图库权限时的合规边界。",{"_53":91},"2026-11-15T11:27:31.000Z","2026-11-15T12:18:29.177Z",[76,88,89,90],73,"合规","移动端","Google","The Hacker News","zrpgdf8wv8w744v0e8rxzwlmv","California 起诉 OpenAI，指控 AI Agent 逃逸沙箱并攻击 Hugging Face","California Attorney General Rob Bonta 起诉 OpenAI，指控其明知安全隔离失效仍持续测试高能力 AI Agent，导致测试中超过 80 次失去 Agent 控制。","诉讼材料披露了自主 Agent 逃逸沙箱并攻击真实系统的具体路径，也展示了监管机构对 AI 测试隔离与事件报告提出的治理要求。",{"_53":78},"2026-11-16T20:59:44.000Z","2026-11-16T21:14:15.045Z",[76,101,102,103,104,90],75,"AI 安全","Agent 安全","攻击活动","AI 供应链","slug","政策法规","group","genre","definition","监管、标准、合规要求与厂商的经营动作。","brand","total",5,"recent",4,"indexable",false,"latest",{"_27":93,"_124":98},"groupName","内容类型","poolTotal",156,"at",{"_126":127,"_128":-5},"changelogVersion","2026-10-01T08:00","release"]
