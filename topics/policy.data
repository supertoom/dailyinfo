[{"_1":2,"_3":4},"root",{"_5":83},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1793621388000,{"_64":36,"_50":65,"_66":67,"_68":69,"_70":-5,"_71":72,"_73":72,"_74":75,"_76":77,"_78":79,"_80":81},"modules",{},"items",[20,21],"page",1,"pageCount","pageSize",20,{"_22":52,"_24":53,"_26":54,"_28":55,"_30":56,"_32":57,"_34":58,"_35":36,"_37":59,"_39":60,"_41":42,"_43":44,"_45":-5},{"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":33,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5},"id","frcixaysupt04wvmk42g5cf8b","title","英国以洗钱和规避金融限制为由制裁 Cryptomus、VexPay、TokenSpot 与 Tsunami Payments","summary","英国以处理惠及俄罗斯政府及金融机构的钱款为由制裁 Cryptomus 等支付平台，冻结其在英国银行的资产并禁止英国企业提供任何业务。Chainalysis 称 Cryptomus 与 Heleket 已成为非法资金支付枢纽，2025年末单月涉及的非法交易对手方超过 900 个；TRM Labs 则称该平台自 2022 年以来处理超过 $7 billion 交易。","reason","文章梳理英国制裁及加密支付基础设施关联的非法资金活动，并对比罚款与制裁的处置效果。","source",{"_50":51},"publishedAt","2026-10-14T14:22:49.000Z","timelineAt","category","policy","tags",[46,47,48,49],"score",71,"selected",true,"channel","news","x","政策","黑产","加密","供应链","name","Krebs on Security","t6k8f35p29zqb72lval7s2ql3","NIST 发布后量子密码过渡路线图，设定 2030 至 2035 年迁移期限","NIST 发布《向后量子密码标准过渡》最终报告（NIST IR 8547），明确 RSA、ECDSA 及传统 Diffie-Hellman、椭圆曲线密钥建立方案的替代路径。","报告给出了不同系统与功能的具体迁移期限，并说明旧算法弃用安排，便于机构结合数据保密周期安排改造。",{"_50":63},"2026-10-29T11:42:54.964Z","2026-10-30T05:42:54.985Z",[61,62,48,49],72,"标准","治理","安全内参","slug","政策法规","group","genre","definition","监管、标准、合规要求与厂商的经营动作。","brand","total",2,"recent","indexable",false,"latest",{"_24":53,"_82":58},"groupName","内容类型","poolTotal",39,"at",{"_84":85,"_86":-5},"changelogVersion","2026-10-01T08:00","release"]
