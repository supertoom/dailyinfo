[{"_1":2,"_3":4},"root",{"_5":103},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1794271002000,{"_77":78,"_54":79,"_80":81,"_82":83,"_84":85,"_86":87,"_88":89,"_90":91,"_92":93,"_94":95,"_96":97},"modules",{},"items",[20,21,22],"page",1,"pageCount","pageSize",20,{"_23":66,"_25":67,"_27":68,"_29":69,"_31":70,"_33":71,"_35":72,"_36":37,"_38":73,"_40":74,"_42":43,"_44":45,"_46":-5},{"_23":56,"_25":57,"_27":58,"_29":59,"_31":60,"_33":61,"_35":61,"_36":37,"_38":62,"_40":63,"_42":43,"_44":45,"_46":-5},{"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":34,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":-5},"id","j0yumx03eu2vtvncwgupudc2k","title","ESET 分析 MATCHBOIL 下载器的版本演进与 UAC-0099 攻击活动","summary","ESET 分析了 UAC-0099 使用的 C# 下载器 MATCHBOIL，其通过鱼叉式钓鱼链接投递，并从 C&C 服务器下载、安装和持久化 MATCHWOK 后门。ESET 观测到乌克兰交通、制造和能源行业受害，样本从 2024 年的一次性下载器演进为每 2 分钟通信，并加入 Eziriz .NET Reactor 混淆、GUI 伪装及沙箱检测。","reason","文章按时间梳理 MATCHBOIL 的代码演进，涵盖混淆、持久化、沙箱检测与载荷投递，可用于理解该下载器的持续迭代方式。","source",{"_54":55},"publishedAt","2026-10-08T08:45:00.000Z","timelineAt","category","activity","tags",[47,48,49,50,51,52,53],"score",63,"selected",true,"channel","news","x","攻击活动","恶意软件","后门","钓鱼","技术研究","Microsoft","ESET","name","ESET WeLiveSecurity","t4ejfik9e135caaoasgc8qft8","ESET 分析 UAC-0099 与 Sandworm 协作部署的 Yggdrasil 后门 MythicRatatoskr","ESET 披露 UAC-0099 与 Sandworm 在乌克兰粮食物流公司入侵中的协作，以及新后门 MythicRatatoskr 的完整技术细节。","原文还原了钓鱼入侵、访问交接和数据擦除链条，并公开后门配置、通信协议、持久化方式与 IoC。",{"_54":55},"2026-10-22T08:45:00.000Z",[47,49,48,50,64,65,53],80,"数据窃取","网络设备","ggy3le7y33yjx5i60bxd14abb","Gorbag APT 组织以自删除恶意软件攻击乌克兰法院和市议会","ESET 追踪的俄罗斯关联组织 Gorbag 自至少 2025 年 2 月起入侵乌克兰机构，利用鱼叉式钓鱼附件和 BeautyStealer 窃取浏览器凭据、VPN 配置及敏感文件。","文章完整呈现 Gorbag 的投递链、载荷投递、数据窃取与自删除机制，并给出目标行业分布和样本版本。",{"_54":76},"2026-11-03T10:00:14.000Z","2026-11-03T10:04:19.774Z",[47,48,50,64,75,53],75,"凭据","Help Net Security","slug","eset","ESET / WeLiveSecurity","group","company","definition","ESET 对勒索软件、僵尸网络与钓鱼基础设施的追踪分析。","brand",{"_99":-5,"_100":101,"_102":91},"total",3,"recent",2,"indexable",false,"latest",{"_25":67,"_98":72},"groupName","厂商与机构","poolTotal",11,"at","src","monogram","E","raster",{"_104":105,"_106":-5},"changelogVersion","2026-10-01T08:00","release"]
