[{"_1":2,"_3":4},"root",{"_5":90},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1793667393000,{"_65":66,"_53":67,"_68":69,"_70":71,"_72":73,"_74":75,"_76":75,"_77":78,"_79":80,"_81":82,"_83":84},"modules",{},"items",[20,21],"page",1,"pageCount","pageSize",20,{"_22":55,"_24":56,"_26":57,"_28":58,"_30":59,"_32":60,"_34":60,"_35":36,"_37":61,"_39":62,"_41":42,"_43":44,"_45":-5},{"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":33,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5},"id","j0yumx03eu2vtvncwgupudc2k","title","ESET 分析 MATCHBOIL 下载器的版本演进与 UAC-0099 攻击活动","summary","ESET 分析了 UAC-0099 使用的 C# 下载器 MATCHBOIL，其通过鱼叉式钓鱼链接投递，并从 C&C 服务器下载、安装和持久化 MATCHWOK 后门。ESET 观测到乌克兰交通、制造和能源行业受害，样本从 2024 年的一次性下载器演进为每 2 分钟通信，并加入 Eziriz .NET Reactor 混淆、GUI 伪装及沙箱检测。","reason","文章按时间梳理 MATCHBOIL 的代码演进，涵盖混淆、持久化、沙箱检测与载荷投递，可用于理解该下载器的持续迭代方式。","source",{"_53":54},"publishedAt","2026-10-08T08:45:00.000Z","timelineAt","category","activity","tags",[46,47,48,49,50,51,52],"score",63,"selected",true,"channel","news","x","攻击活动","恶意软件","后门","钓鱼","技术研究","Microsoft","ESET","name","ESET WeLiveSecurity","t4ejfik9e135caaoasgc8qft8","ESET 分析 UAC-0099 与 Sandworm 协作部署的 Yggdrasil 后门 MythicRatatoskr","ESET 披露 UAC-0099 与 Sandworm 在乌克兰粮食物流公司入侵中的协作，以及新后门 MythicRatatoskr 的完整技术细节。","原文还原了钓鱼入侵、访问交接和数据擦除链条，并公开后门配置、通信协议、持久化方式与 IoC。",{"_53":54},"2026-10-22T08:45:00.000Z",[46,48,47,49,63,64,52],80,"数据窃取","网络设备","slug","eset","ESET / WeLiveSecurity","group","company","definition","ESET 对勒索软件、僵尸网络与钓鱼基础设施的追踪分析。","brand",{"_86":-5,"_87":88,"_89":78},"total",2,"recent","indexable",false,"latest",{"_24":56,"_85":60},"groupName","厂商与机构","poolTotal",9,"at","src","monogram","E","raster",{"_91":92,"_93":-5},"changelogVersion","2026-10-01T08:00","release"]
