[{"_1":2,"_3":4},"root",{"_5":181},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1794962216000,{"_155":156,"_59":157,"_158":159,"_160":161,"_162":163,"_164":165,"_166":167,"_168":169,"_170":171,"_172":173,"_174":175},"modules",{},"items",[20,21,22,23,24,25,26,27,28],"page",1,"pageCount","pageSize",20,{"_29":143,"_31":144,"_33":145,"_35":146,"_37":147,"_39":148,"_41":149,"_42":150,"_44":151,"_46":97,"_48":49,"_50":51,"_52":-5},{"_29":132,"_31":133,"_33":134,"_35":135,"_37":136,"_39":137,"_41":138,"_42":104,"_44":139,"_46":118,"_48":49,"_50":51,"_52":-5},{"_29":120,"_31":121,"_33":122,"_35":123,"_37":124,"_39":125,"_41":126,"_42":67,"_44":127,"_46":128,"_48":49,"_50":51,"_52":-5},{"_29":111,"_31":112,"_33":113,"_35":114,"_37":115,"_39":116,"_41":116,"_42":104,"_44":117,"_46":118,"_48":49,"_50":51,"_52":-5},{"_29":98,"_31":99,"_33":100,"_35":101,"_37":102,"_39":103,"_41":103,"_42":104,"_44":105,"_46":106,"_48":49,"_50":51,"_52":-5},{"_29":90,"_31":91,"_33":92,"_35":93,"_37":94,"_39":95,"_41":95,"_42":67,"_44":96,"_46":97,"_48":49,"_50":51,"_52":-5},{"_29":78,"_31":79,"_33":80,"_35":81,"_37":82,"_39":83,"_41":83,"_42":67,"_44":84,"_46":85,"_48":49,"_50":51,"_52":-5},{"_29":61,"_31":62,"_33":63,"_35":64,"_37":65,"_39":66,"_41":66,"_42":67,"_44":68,"_46":69,"_48":49,"_50":51,"_52":-5},{"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":40,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":-5},"id","lggy41qkw8w8xultvnft70foy","title","Log4j 2 反序列化白名单绕过漏洞分析与 PoC 复现","summary","Elastic Security Labs 复现了 Log4j 2 的 FilteredObjectInputStream 反序列化白名单绕过，并在官方 log4j-api 与 log4j-core 2.26.1 上验证命令执行。","reason","文章通过 PoC 复现揭示了 Log4j 2 反序列化白名单绕过机制，并明确命令执行所需的应用条件与检测方向。","source",{"_59":60},"publishedAt","2026-08-27T00:00:00.000Z","timelineAt","category","disclosure","tags",[53,54,55,56,57,58],"score",67,"selected",true,"channel","news","x","技术研究","漏洞分析","复现","利用链","检测工程","Oracle","name","Elastic Security Labs","r5zda2roh20t8efpf5qqua1mm","ShinyHunters 扩大利用 CVE-2026-35273 攻击 Oracle PeopleSoft","ShinyHunters（UNC6240）正扩大利用 CVE-2026-35273，通过对 /PSEMHUB/ 路径中的 P 进行 URL 编码绕过基于字符串匹配的 WAF，并在全球数十套 Oracle PeopleSoft 系统部署 Web shell。","文章揭示了攻击者通过 URL 编码绕过 WAF 的利用方式，并提供 Web shell、SIDEEYE 后门和文件指标，便于识别同类活动。",{"_59":77},"2026-09-25T14:00:00.000Z","activity",[70,71,72,73,74,58,75,76],90,"攻击活动","在野利用","后门","数据泄露","漏洞利用","Google","Microsoft","Google Cloud 威胁情报","x7yulu575pvfcrgc1njy44kc4","荷兰警方逮捕 ShinyHunters 嫌犯，Oracle PeopleSoft 漏洞被用于数据窃取","荷兰警方因涉嫌协助 ShinyHunters 实施数据窃取和勒索，逮捕一名 24 岁网络犯罪者。ShinyHunters 利用 Oracle PeopleSoft 的 CVE-2026-35273 零日漏洞批量攻击数十套系统，受害行业包括高等教育、科技、医疗、政府等；Oracle 已发布修复，攻击者还曾窃取超过 5,000 名 FBI 人员的个人信息并向 Cl0p 勒索。","文章串联了人员抓捕、Oracle PeopleSoft 零日漏洞批量利用及后续勒索行动，呈现了攻击组织内部权力变化与攻击升级之间的关系。",{"_59":89},"2026-09-28T15:08:57.000Z",[70,73,86,87,71,58,88],77,"勒索","黑产","CISA","Krebs on Security","gysgoudyfsgqzpa5ycwgkmhl2","ShinyHunters 被指利用 Oracle PeopleSoft 漏洞勒索 Boeing 前子公司 Jeppesen ForeFlight","ShinyHunters 涉嫌利用 Oracle PeopleSoft 漏洞 CVE-2026-35273 批量窃取数据，并在被指参与勒索 Boeing 已出售的 Jeppesen ForeFlight 时遭约旦当局拘留。","文章还原了 ShinyHunters 重组后的运作方式及其利用 PeopleSoft 漏洞批量入侵多家机构的轨迹，并呈现涉事人员被捕后的品牌接管与勒索生态变化。",{"_59":89},"2026-10-07T13:48:45.000Z",[70,86,73,71,74,58,88],76,"svcc828irm8fa8xah02zov8yq","Oracle Java SE JSSE 中间 CA 证书信任漏洞 CVE-2026-91403 已发布修复","Oracle Java SE、Oracle GraalVM for JDK 和 Oracle GraalVM Enterprise Edition 的 JSSE 组件存在高危访问控制错误漏洞 CVE-2026-91403。","通告列明了受影响的 Java SE 与 GraalVM 版本、利用前提和修复路径，并解释了中间 CA 证书信任问题对 TLS 通信的影响。",{"_59":110},"2026-10-27T09:47:00.000Z","vuln",[107,108,54,58,109],75,"漏洞","补丁","加密","深信服千里目安全实验室","ynv1j0kowqnyhn673e0brv2mk","Oracle PeopleSoft CVE-2026-35273 零日漏洞由三项缺陷串联，ShinyHunters 已利用","Oracle PeopleSoft CVE-2026-35273 实为三个串联缺陷，ShinyHunters 已利用该漏洞并在 5 月 27 日至 6 月 9 日及 9 月的新一轮攻击中影响全球数十套系统。","文章拆解了 SSRF 绕过内部管理接口信任校验并实现代码执行的完整链条，同时说明真实攻击、补丁状态与失陷后的处置边界。",{"_59":119},"2026-10-28T06:04:58.000Z",[107,71,108,54,56,58],92,"The Hacker News","e33nhau4z48egyjpv6q4xca62","攻击者开始扫描 Oracle E-Business Suite 漏洞 CVE-2026-101767","攻击者已开始扫描未修复 Oracle E-Business Suite 漏洞 CVE-2026-101767 的系统，该漏洞可由未经认证的攻击者经 HTTP 发起低复杂度攻击并接管系统。","Defused 的蜜罐已记录针对 CVE-2026-101767 的探测性利用，文章同时给出补丁状态和暴露实例规模，便于判断 Oracle EBS 暴露面的紧迫性。",{"_59":131},"2026-10-28T12:19:57.000Z","2026-10-28T13:06:43.362Z",[70,71,74,58,129,130],78,"数据库","网络设备","BleepingComputer","taftp8yj8gj6gq2pfw66kywm3","OpenJDK Java4Shell 漏洞 CVE-2026-114938 可导致 RCE，Oracle 已发布补丁","OpenJDK 的 Java4Shell 漏洞 CVE-2026-114938 可被未认证攻击者用于 RCE，并可能泄露内存敏感信息。该内存破坏缺陷影响 OpenJDK 17.0.6 及之后版本，Calif 评为 CVSS 4.0 9.2，Oracle 评为 CVSS 3.1 8.1（High）。","原文覆盖受影响版本、利用前提、PoC、补丁和临时缓解措施，便于安全团队评估 OpenJDK 暴露面并安排处置。",{"_59":131},"2026-11-17T23:04:21.000Z","2026-11-17T23:22:32.039Z",[107,55,74,71,108,53,58,140,141,76,142],"Red Hat","AWS","Atlassian","rqea4z2nhncrkf2s1jvtvp067","Oracle Java Base64 解码器漏洞 CVE-2026-114938 存在未认证 RCE，CISA 要求立即修补","Oracle Java 的 Base64 解码器存在内存损坏漏洞 CVE-2026-114938，可由特制 Base64 输入触发 JVM 崩溃，并在无需认证的条件下实现远程代码执行。","原文明确利用前提、影响组件和临时缓解措施，读者可据此排查 Java 部署并确定修补优先级。",{"_59":154},"2026-11-17T12:00:00.000Z","2026-11-17T23:27:32.332Z","policy",[107,108,152,153,58,88],"漏洞管理","加固","CISA 安全公告","slug","oracle","Oracle / 甲骨文","group","company","definition","Oracle 季度补丁（CPU）、Java 与 E-Business Suite 的漏洞公告。","brand",{"_177":-5,"_178":179,"_180":169},"total",9,"recent",5,"indexable",false,"latest",{"_31":144,"_176":149},"groupName","厂商与机构","poolTotal",18,"at","src","monogram","O","raster",{"_182":183,"_184":-5},"changelogVersion","2026-10-01T08:00","release"]
