[{"_1":2,"_3":4},"root",{"_5":156},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1793621388000,{"_130":131,"_57":132,"_133":134,"_135":136,"_137":138,"_139":140,"_141":142,"_143":144,"_145":146,"_147":148,"_149":150},"modules",{},"items",[20,21,22,23,24,25,26],"page",1,"pageCount","pageSize",20,{"_27":118,"_29":119,"_31":120,"_33":121,"_35":122,"_37":123,"_39":124,"_40":65,"_42":125,"_44":126,"_46":47,"_48":49,"_50":-5},{"_27":109,"_29":110,"_31":111,"_33":112,"_35":113,"_37":114,"_39":114,"_40":102,"_42":115,"_44":116,"_46":47,"_48":49,"_50":-5},{"_27":96,"_29":97,"_31":98,"_33":99,"_35":100,"_37":101,"_39":101,"_40":102,"_42":103,"_44":104,"_46":47,"_48":49,"_50":-5},{"_27":88,"_29":89,"_31":90,"_33":91,"_35":92,"_37":93,"_39":93,"_40":65,"_42":94,"_44":95,"_46":47,"_48":49,"_50":-5},{"_27":76,"_29":77,"_31":78,"_33":79,"_35":80,"_37":81,"_39":81,"_40":65,"_42":82,"_44":83,"_46":47,"_48":49,"_50":-5},{"_27":59,"_29":60,"_31":61,"_33":62,"_35":63,"_37":64,"_39":64,"_40":65,"_42":66,"_44":67,"_46":47,"_48":49,"_50":-5},{"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":38,"_40":41,"_42":43,"_44":45,"_46":47,"_48":49,"_50":-5},"id","lggy41qkw8w8xultvnft70foy","title","Log4j 2 反序列化白名单绕过漏洞分析与 PoC 复现","summary","Elastic Security Labs 复现了 Log4j 2 的 FilteredObjectInputStream 反序列化白名单绕过，并在官方 log4j-api 与 log4j-core 2.26.1 上验证命令执行。","reason","文章通过 PoC 复现揭示了 Log4j 2 反序列化白名单绕过机制，并明确命令执行所需的应用条件与检测方向。","source",{"_57":58},"publishedAt","2026-08-27T00:00:00.000Z","timelineAt","category","disclosure","tags",[51,52,53,54,55,56],"score",67,"selected",true,"channel","news","x","技术研究","漏洞分析","复现","利用链","检测工程","Oracle","name","Elastic Security Labs","r5zda2roh20t8efpf5qqua1mm","ShinyHunters 扩大利用 CVE-2026-35273 攻击 Oracle PeopleSoft","ShinyHunters（UNC6240）正扩大利用 CVE-2026-35273，通过对 /PSEMHUB/ 路径中的 P 进行 URL 编码绕过基于字符串匹配的 WAF，并在全球数十套 Oracle PeopleSoft 系统部署 Web shell。","文章揭示了攻击者通过 URL 编码绕过 WAF 的利用方式，并提供 Web shell、SIDEEYE 后门和文件指标，便于识别同类活动。",{"_57":75},"2026-09-25T14:00:00.000Z","activity",[68,69,70,71,72,56,73,74],90,"攻击活动","在野利用","后门","数据泄露","漏洞利用","Google","Microsoft","Google Cloud 威胁情报","x7yulu575pvfcrgc1njy44kc4","荷兰警方逮捕 ShinyHunters 嫌犯，Oracle PeopleSoft 漏洞被用于数据窃取","荷兰警方因涉嫌协助 ShinyHunters 实施数据窃取和勒索，逮捕一名 24 岁网络犯罪者。ShinyHunters 利用 Oracle PeopleSoft 的 CVE-2026-35273 零日漏洞批量攻击数十套系统，受害行业包括高等教育、科技、医疗、政府等；Oracle 已发布修复，攻击者还曾窃取超过 5,000 名 FBI 人员的个人信息并向 Cl0p 勒索。","文章串联了人员抓捕、Oracle PeopleSoft 零日漏洞批量利用及后续勒索行动，呈现了攻击组织内部权力变化与攻击升级之间的关系。",{"_57":87},"2026-09-28T15:08:57.000Z",[68,71,84,85,69,56,86],77,"勒索","黑产","CISA","Krebs on Security","gysgoudyfsgqzpa5ycwgkmhl2","ShinyHunters 被指利用 Oracle PeopleSoft 漏洞勒索 Boeing 前子公司 Jeppesen ForeFlight","ShinyHunters 涉嫌利用 Oracle PeopleSoft 漏洞 CVE-2026-35273 批量窃取数据，并在被指参与勒索 Boeing 已出售的 Jeppesen ForeFlight 时遭约旦当局拘留。","文章还原了 ShinyHunters 重组后的运作方式及其利用 PeopleSoft 漏洞批量入侵多家机构的轨迹，并呈现涉事人员被捕后的品牌接管与勒索生态变化。",{"_57":87},"2026-10-07T13:48:45.000Z",[68,84,71,69,72,56,86],76,"svcc828irm8fa8xah02zov8yq","Oracle Java SE JSSE 中间 CA 证书信任漏洞 CVE-2026-91403 已发布修复","Oracle Java SE、Oracle GraalVM for JDK 和 Oracle GraalVM Enterprise Edition 的 JSSE 组件存在高危访问控制错误漏洞 CVE-2026-91403。","通告列明了受影响的 Java SE 与 GraalVM 版本、利用前提和修复路径，并解释了中间 CA 证书信任问题对 TLS 通信的影响。",{"_57":108},"2026-10-27T09:47:00.000Z","vuln",[105,106,52,56,107],75,"漏洞","补丁","加密","深信服千里目安全实验室","ynv1j0kowqnyhn673e0brv2mk","Oracle PeopleSoft CVE-2026-35273 零日漏洞由三项缺陷串联，ShinyHunters 已利用","Oracle PeopleSoft CVE-2026-35273 实为三个串联缺陷，ShinyHunters 已利用该漏洞并在 5 月 27 日至 6 月 9 日及 9 月的新一轮攻击中影响全球数十套系统。","文章拆解了 SSRF 绕过内部管理接口信任校验并实现代码执行的完整链条，同时说明真实攻击、补丁状态与失陷后的处置边界。",{"_57":117},"2026-10-28T06:04:58.000Z",[105,69,106,52,54,56],92,"The Hacker News","e33nhau4z48egyjpv6q4xca62","攻击者开始扫描 Oracle E-Business Suite 漏洞 CVE-2026-101767","攻击者已开始扫描未修复 Oracle E-Business Suite 漏洞 CVE-2026-101767 的系统，该漏洞可由未经认证的攻击者经 HTTP 发起低复杂度攻击并接管系统。","Defused 的蜜罐已记录针对 CVE-2026-101767 的探测性利用，文章同时给出补丁状态和暴露实例规模，便于判断 Oracle EBS 暴露面的紧迫性。",{"_57":129},"2026-10-28T12:19:57.000Z","2026-10-28T13:06:43.362Z",[68,69,72,56,127,128],78,"数据库","网络设备","BleepingComputer","slug","oracle","Oracle / 甲骨文","group","company","definition","Oracle 季度补丁（CPU）、Java 与 E-Business Suite 的漏洞公告。","brand",{"_152":-5,"_153":154,"_155":144},"total",7,"recent",4,"indexable",false,"latest",{"_29":119,"_151":124},"groupName","厂商与机构","poolTotal",12,"at","src","monogram","O","raster",{"_157":158,"_159":-5},"changelogVersion","2026-10-01T08:00","release"]
