[{"_1":2,"_3":4},"root",{"_5":105},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1794357411000,{"_81":82,"_51":50,"_83":84,"_85":86,"_87":88,"_89":90,"_91":90,"_92":93,"_94":95,"_96":97,"_98":99},"modules",{},"items",[20,21,22],"page",1,"pageCount","pageSize",20,{"_23":65,"_25":66,"_27":67,"_29":68,"_31":69,"_33":70,"_35":71,"_36":72,"_38":73,"_40":74,"_42":43,"_44":45,"_46":-5},{"_23":53,"_25":54,"_27":55,"_29":56,"_31":57,"_33":58,"_35":58,"_36":59,"_38":60,"_40":61,"_42":43,"_44":45,"_46":-5},{"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":34,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":-5},"id","fkb0hvljyily1h2v8mft9s33t","title","Drupal Field UI 远程代码执行漏洞 CVE-2026-108097 已发布修复","summary","Drupal Field UI 模块存在远程代码执行漏洞 CVE-2026-108097，威胁等级为高危。影响范围包括 8.9.0 <= Drupal < 10.6.19、11.0.0 <= Drupal < 11.3.19、11.4.0 <= Drupal < 11.4.10，以及 12.0.0-alpha1 <= Drupal < 12.0.0-beta2。","reason","通告给出了受影响版本、触发前提和利用链关键环节，并明确官方修复版本，便于部署方评估风险与安排升级。","source",{"_51":52},"publishedAt","2026-10-21T09:47:00.000Z","timelineAt","category","disclosure","tags",[47,48,49,50],"score",70,"selected",true,"channel","news","x","漏洞分析","复现","漏洞","深信服","name","深信服千里目安全实验室","k6wzliw5udf4nz1vvb2s6dvo3","Linux Kernel CVE-2026-98260 存在 POSIX CPU 定时器 UAF 本地提权漏洞","Linux Kernel 的 exec POSIX CPU 定时器 UAF 本地提权漏洞 CVE-2026-98260 影响 5.7 至 < 6.6.158、6.7 至 < 6.12.112、6.13 至 < 6.18.54、6.19 至 < 7.2.8，本地低权限用户即可利用，易于提权至 root。","原文给出受影响版本、利用前提、提权原理与修复版本，还说明已成功复现，便于读者核对资产风险并安排升级。",{"_51":52},"2026-10-27T09:47:00.000Z","vuln",[49,48,62,63,64,47,50],79,"漏洞利用","补丁","内核","nukg9pzziesh0qo3zavylwrii","深信服披露针对国内第三方支付机构的定向攻击工具包","深信服深瞻情报实验室发现一套针对某国内第三方支付机构生产环境的定向攻击工具包，共91个文件，涵盖冰蝎与蚁剑内存马、JVM无文件注入、反向隧道、Meterpreter载荷和数据窃取脚本。","工具包暴露了针对支付机构的定制植入链、订单数据窃取脚本与完整 IOC，可用于回溯入侵活动并排查同类痕迹。",{"_51":52},"2026-11-05T09:53:00.000Z","2026-11-06T00:05:19.128Z","activity",[75,76,77,78,79,80,50],82,"攻击活动","恶意软件","后门","数据窃取","凭据","AI 攻防","slug","sangfor","group","company","definition","千里目安全实验室的漏洞通告与技术研究。","brand",{"_101":-5,"_102":103,"_104":93},"total",3,"recent","indexable",false,"latest",{"_25":66,"_100":71},"groupName","厂商与机构","poolTotal",5,"at","src","monogram","深","raster",{"_106":107,"_108":-5},"changelogVersion","2026-10-01T08:00","release"]
