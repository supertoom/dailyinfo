[{"_1":2,"_3":4},"root",{"_5":126},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795826222000,{"_101":102,"_53":52,"_103":104,"_105":106,"_107":108,"_109":110,"_111":112,"_113":114,"_115":116,"_117":118,"_119":120},"modules",{},"items",[20,21,22,23,24],"page",1,"pageCount","pageSize",20,{"_25":93,"_27":94,"_29":95,"_31":96,"_33":97,"_35":88,"_37":98,"_38":61,"_40":99,"_42":100,"_44":45,"_46":47,"_48":-5},{"_25":83,"_27":84,"_29":85,"_31":86,"_33":87,"_35":88,"_37":89,"_38":61,"_40":90,"_42":91,"_44":45,"_46":47,"_48":-5},{"_25":67,"_27":68,"_29":69,"_31":70,"_33":71,"_35":72,"_37":73,"_38":74,"_40":75,"_42":76,"_44":45,"_46":47,"_48":-5},{"_25":55,"_27":56,"_29":57,"_31":58,"_33":59,"_35":60,"_37":60,"_38":61,"_40":62,"_42":63,"_44":45,"_46":47,"_48":-5},{"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":36,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47,"_48":-5},"id","fkb0hvljyily1h2v8mft9s33t","title","Drupal Field UI 远程代码执行漏洞 CVE-2026-108097 已发布修复","summary","Drupal Field UI 模块存在远程代码执行漏洞 CVE-2026-108097，威胁等级为高危。影响范围包括 8.9.0 <= Drupal < 10.6.19、11.0.0 <= Drupal < 11.3.19、11.4.0 <= Drupal < 11.4.10，以及 12.0.0-alpha1 <= Drupal < 12.0.0-beta2。","reason","通告给出了受影响版本、触发前提和利用链关键环节，并明确官方修复版本，便于部署方评估风险与安排升级。","source",{"_53":54},"publishedAt","2026-10-21T09:47:00.000Z","timelineAt","category","disclosure","tags",[49,50,51,52],"score",70,"selected",true,"channel","news","x","漏洞分析","复现","漏洞","深信服","name","深信服千里目安全实验室","k6wzliw5udf4nz1vvb2s6dvo3","Linux Kernel CVE-2026-98260 存在 POSIX CPU 定时器 UAF 本地提权漏洞","Linux Kernel 的 exec POSIX CPU 定时器 UAF 本地提权漏洞 CVE-2026-98260 影响 5.7 至 < 6.6.158、6.7 至 < 6.12.112、6.13 至 < 6.18.54、6.19 至 < 7.2.8，本地低权限用户即可利用，易于提权至 root。","原文给出受影响版本、利用前提、提权原理与修复版本，还说明已成功复现，便于读者核对资产风险并安排升级。",{"_53":54},"2026-10-27T09:47:00.000Z","vuln",[51,50,64,65,66,49,52],79,"漏洞利用","补丁","内核","nukg9pzziesh0qo3zavylwrii","深信服披露针对国内第三方支付机构的定向攻击工具包","深信服深瞻情报实验室发现一套针对某国内第三方支付机构生产环境的定向攻击工具包，共91个文件，涵盖冰蝎与蚁剑内存马、JVM无文件注入、反向隧道、Meterpreter载荷和数据窃取脚本。","工具包暴露了针对支付机构的定制植入链、订单数据窃取脚本与完整 IOC，可用于回溯入侵活动并排查同类痕迹。",{"_53":54},"2026-11-05T09:53:00.000Z","2026-11-06T00:05:19.128Z","activity",[77,78,79,80,81,82,52],82,"攻击活动","恶意软件","后门","数据窃取","凭据","AI 攻防","uhvazvdp48xo8g4vjsd383z43","nginx 多模块内存安全漏洞链式 RCE：五个 CVE 影响至 1.31.8","nginx2root 是 CVE-2026-123007、CVE-2026-123634、CVE-2026-123633、CVE-2026-121810、CVE-2026-113425 组成的链式远程代码执行漏洞集，启用 HTTP/2、HTTP/3、resolver 配合 mirror 或 SSI、邮件代理等模块的目标在无需认证的情况下可被远程触发。","文章梳理了五个 CVE 的模块触发条件、版本区间与利用链前提，并以 PoC 验证了 worker 权限远程代码执行，便于读者核对自身配置和版本。",{"_53":54},"2026-11-19T09:51:00.000Z","2026-11-19T18:01:20.971Z",[51,50,64,92,49,65,52],81,"利用链","ij1t9r2o1yq64nrx86tf5fp89","Vite 开发服务器虚拟模块注入远程代码执行漏洞 SF_2026_47139 修复公告","Vite 开发服务器虚拟模块标识符处理存在注入缺陷，攻击者可在无需认证和用户交互的条件下远程执行代码并读取任意文件。","文章复现了单请求远程代码执行链路，并给出受影响分支、修复版本及网络暴露条件，便于开发者评估开发服务器风险。",{"_53":54},"2026-11-19T18:01:21.169Z",[51,50,64,65,49,52],75,"slug","sangfor","group","company","definition","千里目安全实验室的漏洞通告与技术研究。","brand",{"_122":-5,"_123":124,"_125":114},"total",5,"recent",3,"indexable",false,"latest",{"_27":94,"_121":98},"groupName","厂商与机构","poolTotal",10,"at","src","monogram","深","raster",{"_127":128,"_129":-5},"changelogVersion","2026-10-01T08:00","release"]
