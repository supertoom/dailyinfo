[{"_1":2,"_3":4},"root",{"_5":93},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795826221000,{"_68":69,"_52":70,"_71":72,"_73":74,"_75":76,"_77":78,"_79":16,"_80":81,"_82":83,"_84":85,"_86":87},"modules",{},"items",[20,21],"page",1,"pageCount","pageSize",20,{"_22":54,"_24":55,"_26":56,"_28":57,"_29":58,"_31":59,"_33":60,"_34":35,"_36":61,"_38":62,"_40":41,"_42":43,"_44":-5},{"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":32,"_33":32,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5},"id","b0sjib0ua6rcal44e5ymeolse","title","Unit 42 披露 PEERSTITCH：利用 FortiManager 入侵并植入 FortiGate 的隐蔽恶意软件","summary","Unit 42 披露针对电信服务商的多阶段入侵：攻击者利用 CVE-2024-47575 攻破集中式 FortiManager，窃取超过 500 台受管 FortiGate 的配置、凭据与加密材料；随后利用 CVE-2025-61624 的 FortiOS auto-script 路径穿越漏洞提权，并部署内存驻留型 ARM64 植入程序 PEERSTITCH。","reason","source",{"_52":53},"publishedAt","2026-10-14T22:00:44.000Z","timelineAt","category","activity","tags",[45,46,47,48,49,50,51],"score",90,"selected",true,"channel","news","x","攻击活动","恶意软件","后门","在野利用","利用链","Fortinet","Palo Alto","name","Unit 42","vt4gd1d2m0q2e5cxg60jzp1ja","GreenJuliett 将 AI 纳入 OT 攻击链并扩大 FortiGate 扫描范围","Recorded Future 观测到 GreenJuliett 将 AI 纳入 OT 攻击链，用于识别脆弱设备类型并编写针对 PLC 与工业协议的脚本。该组织在巴林、以色列、约旦、科威特、沙特阿拉伯和卡塔尔扫描或尝试利用 Fortinet FortiGate，并可能将 IoT 与 CCTV 设备纳入目标。","文章追踪了 GreenJuliett 将 AI 引入 OT 攻击链的迹象及其针对 PLC、FortiGate 和 IoT 设备的扩张路径。",{"_52":67},"2026-11-20T00:00:00.000Z","2026-11-20T21:31:31.492Z",[45,46,63,64,65,50,66],72,"AI 攻防","工控","IoT","Google","Recorded Future","slug","fortinet","Fortinet / FortiGate","group","company","definition","FortiOS、FortiGate 的漏洞公告与 FortiGuard Labs 的威胁研究。","brand",{"_89":-5,"_90":91,"_92":81},"total",2,"recent","indexable",false,"latest",{"_24":55,"_88":60},"groupName","厂商与机构","poolTotal",14,"at","src","monogram","F","raster",{"_94":95,"_96":-5},"changelogVersion","2026-10-01T08:00","release"]
