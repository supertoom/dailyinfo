[{"_1":2,"_3":4},"root",{"_5":152},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1793621387000,{"_133":134,"_59":56,"_135":136,"_137":138,"_139":-5,"_140":141,"_142":141,"_143":144,"_145":146,"_147":148,"_149":150},"modules",{},"items",[20,21,22,23,24,25,26],"page",1,"pageCount","pageSize",20,{"_27":124,"_29":125,"_31":126,"_33":127,"_35":128,"_37":129,"_39":130,"_40":104,"_42":131,"_44":132,"_46":47,"_48":49,"_50":-5},{"_27":111,"_29":112,"_31":113,"_33":114,"_35":115,"_37":116,"_39":117,"_40":67,"_42":118,"_44":119,"_46":47,"_48":49,"_50":-5},{"_27":98,"_29":99,"_31":100,"_33":101,"_35":102,"_37":103,"_39":103,"_40":104,"_42":105,"_44":106,"_46":47,"_48":49,"_50":-5},{"_27":88,"_29":89,"_31":90,"_33":91,"_35":92,"_37":93,"_39":93,"_40":41,"_42":94,"_44":45,"_46":47,"_48":49,"_50":-5},{"_27":77,"_29":78,"_31":79,"_33":80,"_35":81,"_37":82,"_39":82,"_40":41,"_42":83,"_44":84,"_46":47,"_48":49,"_50":-5},{"_27":61,"_29":62,"_31":63,"_33":64,"_35":65,"_37":66,"_39":66,"_40":67,"_42":68,"_44":69,"_46":47,"_48":49,"_50":-5},{"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":38,"_40":41,"_42":43,"_44":45,"_46":47,"_48":49,"_50":-5},"id","ua5m0herqw7naef83fwg7gyqr","title","Fomo 用户遭恶意书签钓鱼，4.5 万 USDC 被转走","summary","攻击者通过 MOONLET 代币详情页的官网链接，将 Fomo 用户引至 voltage.family，诱导其添加并连续点击名为“Triple click to verify”的 JavaScript 恶意书签。","reason","文章还原了恶意书签从伪造验证、采集令牌到外传数据的完整链路，并追踪受害者资金的拆分、兑换与跨链流向。","source",{"_59":60},"publishedAt","2026-10-08T11:00:00.000Z","timelineAt","category","activity","tags",[51,52,53,54,55,56,57,58],"score",75,"selected",true,"channel","news","x","攻击活动","钓鱼","恶意软件","数据窃取","加密","浏览器","Cloudflare","Google","name","慢雾科技","oy03xazu2np8mgzruqrp0tk8x","Check Point Research 分析 AI 驱动反检测浏览器在网络欺诈与影响行动中的风险","Check Point Research 分析 Kameleo、AdsPower 和 MultiLogin 等 AI 驱动反检测浏览器如何隐藏数字身份、批量管理社交平台账号，并被用于账号接管、金融欺诈、钓鱼、恶意软件分发和协调影响行动。","文章拆解了 AI 驱动的反检测浏览器如何隐藏身份并串联账号接管、欺诈与影响行动，并给出面向平台和安全团队的网络层检测思路。",{"_59":76},"2026-10-20T14:17:23.000Z","disclosure",[70,71,72,52,73,56,74,58,75],60,"技术研究","AI 安全","黑产","身份与访问","Check Point","Microsoft","Check Point Research","pwl5edkiwc7a605s7uh116k0p","Magento 商店窃密活动感染 5 个域名下的 953 家网店","一个犯罪团伙自 2025 年 7 月以来已感染 953 家以 Magento 为主的网店，并通过 CMS 区块植入可识别自动化浏览器的恶意加载器。","文章梳理了攻击者轮换域名、识别自动化扫描器和持久化载荷的机制，并给出CMS内容、恶意文件与账户排查方向。",{"_59":87},"2026-10-26T20:41:22.000Z",[51,53,54,85,56,86],89,"云原生","工具发布","Security Affairs","rfv97r0j7euq1u5t583l331q1","Udesk 客服脚本遭投毒，窃取会话数据并篡改充值地址","Udesk 客服系统相关 JavaScript 脚本遭投毒，恶意代码可采集 Cookie、网页存储、表单及认证请求内容，并向外部发送数据。载荷还会针对 mgbx[.]com、bikingex[.] 和 bitxex[.]io 修改页面充值地址及复制内容，使用户可能将资金转入替换后的收款地址。原文建议停止分发污染资源、处置暴露凭据，并通过可信后台与交易记录核查充值目标。","还原了客服脚本从混淆加载、敏感数据采集到充值地址劫持的完整链路，并给出可核验的 IOC 与处置步骤。",{"_59":60},"2026-10-27T09:51:00.000Z",[51,95,54,96,56,97],"供应链投毒","后门","凭据","b018cl5j0kd1kqcgcxlxm1w3u","Chrome 156 稳定版更新修复 52 项安全漏洞","Chrome Stable 已更新至 Windows 和 Mac 的 156.0.8078.73/.74、Linux 的 156.0.8078.73，更新将在未来数日或数周内推出。","公告列出 Chrome 156 稳定版包含的 52 项安全修复及对应 CVE，适合浏览器运维人员核对版本和修复状态。",{"_59":110},"2026-10-27T20:29:34.967Z","vuln",[107,108,56,58,109],73,"补丁","漏洞","Mozilla","Chrome Releases","xn04uir3ppltopryw25ryri8a","Orange Tsai 披露 Microsoft Edge 纯逻辑漏洞全链，实现沙箱逃逸与 ACE","Orange Tsai 披露其在 Pwn2Own Berlin 2026 构建的 Microsoft Edge 全链，通过 5 个逻辑漏洞和 2 项 Windows 功能实现沙箱逃逸并获得 $175,000 与 17.5 Master of Pwn points。","作者完整拆解了仅用逻辑漏洞串联成 Microsoft Edge 沙箱逃逸与 ACE 的过程，包含根因、代码路径、0-Click 原语和协议处理器落地方法。",{"_59":123},"2026-10-28T00:00:00.000Z","2026-10-29T00:16:07.231Z",[70,120,121,122,56,75,58],90,"漏洞分析","利用链","复现","DevCo","q5v1vxau0e4lym0x3ogx6pet0","Chrome 156 稳定版修复 21 项安全漏洞，CVE-2026-76024 为严重级别","Chrome Stable 和 Extended Stable 渠道已更新至 Windows 和 Mac 的 156.0.8078.79/.80、Linux 的 156.0.8078.79，将在未来几天至几周内推送。","公告列明 Chrome 156 稳定版包含 21 项安全修复及对应 CVE，可用于核对受影响组件并安排更新。",{"_59":110},"2026-10-29T21:26:20.252Z","2026-10-29T23:40:22.563Z",[108,107,56,58],70,"slug","browser","group","field","definition","浏览器引擎、扩展与渲染进程中的漏洞利用。","brand","total",7,"recent","indexable",false,"latest",{"_29":125,"_151":130},"groupName","技术方向","poolTotal",29,"at",{"_153":154,"_155":-5},"changelogVersion","2026-10-01T08:00","release"]
