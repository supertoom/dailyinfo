[{"_1":2,"_3":4},"root",{"_5":164},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1794184871000,{"_144":145,"_60":57,"_146":147,"_148":149,"_150":-5,"_151":152,"_153":154,"_155":156,"_157":158,"_159":160,"_161":162},"modules",{},"items",[20,21,22,23,24,25,26,27],"page",1,"pageCount","pageSize",20,{"_28":133,"_30":134,"_32":135,"_34":136,"_36":137,"_38":138,"_40":139,"_41":68,"_43":140,"_45":141,"_47":48,"_49":50,"_51":-5},{"_28":124,"_30":125,"_32":126,"_34":127,"_36":128,"_38":129,"_40":130,"_41":105,"_43":131,"_45":107,"_47":48,"_49":50,"_51":-5},{"_28":111,"_30":112,"_32":113,"_34":114,"_36":115,"_38":116,"_40":117,"_41":68,"_43":118,"_45":119,"_47":48,"_49":50,"_51":-5},{"_28":99,"_30":100,"_32":101,"_34":102,"_36":103,"_38":104,"_40":104,"_41":105,"_43":106,"_45":107,"_47":48,"_49":50,"_51":-5},{"_28":89,"_30":90,"_32":91,"_34":92,"_36":93,"_38":94,"_40":94,"_41":42,"_43":95,"_45":46,"_47":48,"_49":50,"_51":-5},{"_28":78,"_30":79,"_32":80,"_34":81,"_36":82,"_38":83,"_40":83,"_41":42,"_43":84,"_45":85,"_47":48,"_49":50,"_51":-5},{"_28":62,"_30":63,"_32":64,"_34":65,"_36":66,"_38":67,"_40":67,"_41":68,"_43":69,"_45":70,"_47":48,"_49":50,"_51":-5},{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":39,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":-5},"id","ua5m0herqw7naef83fwg7gyqr","title","Fomo 用户遭恶意书签钓鱼，4.5 万 USDC 被转走","summary","攻击者通过 MOONLET 代币详情页的官网链接，将 Fomo 用户引至 voltage.family，诱导其添加并连续点击名为“Triple click to verify”的 JavaScript 恶意书签。","reason","文章还原了恶意书签从伪造验证、采集令牌到外传数据的完整链路，并追踪受害者资金的拆分、兑换与跨链流向。","source",{"_60":61},"publishedAt","2026-10-08T11:00:00.000Z","timelineAt","category","activity","tags",[52,53,54,55,56,57,58,59],"score",75,"selected",true,"channel","news","x","攻击活动","钓鱼","恶意软件","数据窃取","加密","浏览器","Cloudflare","Google","name","慢雾科技","oy03xazu2np8mgzruqrp0tk8x","Check Point Research 分析 AI 驱动反检测浏览器在网络欺诈与影响行动中的风险","Check Point Research 分析 Kameleo、AdsPower 和 MultiLogin 等 AI 驱动反检测浏览器如何隐藏数字身份、批量管理社交平台账号，并被用于账号接管、金融欺诈、钓鱼、恶意软件分发和协调影响行动。","文章拆解了 AI 驱动的反检测浏览器如何隐藏身份并串联账号接管、欺诈与影响行动，并给出面向平台和安全团队的网络层检测思路。",{"_60":77},"2026-10-20T14:17:23.000Z","disclosure",[71,72,73,53,74,57,75,59,76],60,"技术研究","AI 安全","黑产","身份与访问","Check Point","Microsoft","Check Point Research","pwl5edkiwc7a605s7uh116k0p","Magento 商店窃密活动感染 5 个域名下的 953 家网店","一个犯罪团伙自 2025 年 7 月以来已感染 953 家以 Magento 为主的网店，并通过 CMS 区块植入可识别自动化浏览器的恶意加载器。","文章梳理了攻击者轮换域名、识别自动化扫描器和持久化载荷的机制，并给出CMS内容、恶意文件与账户排查方向。",{"_60":88},"2026-10-26T20:41:22.000Z",[52,54,55,86,57,87],89,"云原生","工具发布","Security Affairs","rfv97r0j7euq1u5t583l331q1","Udesk 客服脚本遭投毒，窃取会话数据并篡改充值地址","Udesk 客服系统相关 JavaScript 脚本遭投毒，恶意代码可采集 Cookie、网页存储、表单及认证请求内容，并向外部发送数据。载荷还会针对 mgbx[.]com、bikingex[.] 和 bitxex[.]io 修改页面充值地址及复制内容，使用户可能将资金转入替换后的收款地址。原文建议停止分发污染资源、处置暴露凭据，并通过可信后台与交易记录核查充值目标。","还原了客服脚本从混淆加载、敏感数据采集到充值地址劫持的完整链路，并给出可核验的 IOC 与处置步骤。",{"_60":61},"2026-10-27T09:51:00.000Z",[52,96,55,97,57,98],"供应链投毒","后门","凭据","b018cl5j0kd1kqcgcxlxm1w3u","Chrome 156 稳定版更新修复 52 项安全漏洞","Chrome Stable 桌面渠道更新至 Windows 和 Mac 的 156.0.8078.73/.74、Linux 的 156.0.8078.73，未来数日或数周逐步推送，共包含 52 项安全修复。","公告集中列出 Chrome 156 稳定版包含的 52 项安全修复，覆盖多种内存安全、类型混淆和权限控制问题，并给出各漏洞等级与受影响组件。",{"_60":110},"2026-10-27T20:29:34.967Z","vuln",[108,57,59,109],71,"补丁","汇总","Chrome Releases","xn04uir3ppltopryw25ryri8a","Orange Tsai 披露 Microsoft Edge 纯逻辑漏洞全链，实现沙箱逃逸与 ACE","Orange Tsai 披露其在 Pwn2Own Berlin 2026 构建的 Microsoft Edge 全链，通过 5 个逻辑漏洞和 2 项 Windows 功能实现沙箱逃逸并获得 $175,000 与 17.5 Master of Pwn points。","作者完整拆解了仅用逻辑漏洞串联成 Microsoft Edge 沙箱逃逸与 ACE 的过程，包含根因、代码路径、0-Click 原语和协议处理器落地方法。",{"_60":123},"2026-10-28T00:00:00.000Z","2026-10-29T00:16:07.231Z",[71,120,121,122,57,76,59],90,"漏洞分析","利用链","复现","DevCo","ungyq5x28j803aw7gd2hmsng3","Chrome 157 稳定版发布，Windows、Mac 和 Linux 收录 213 项安全修复","Chrome 157 稳定版面向 Windows、Mac 和 Linux 推送，Linux 版本为 157.0.8103.38，Windows/Mac 版本为 157.0.8103.38/.39，将在未来数日或数周内完成分发。","公告集中列出 Chrome 157 稳定版包含的 213 项安全修复及漏洞等级和上报者信息，适合浏览器用户核对更新范围与受影响组件。",{"_60":110},"2026-11-03T20:38:18.791Z","2026-11-03T21:21:22.419Z",[108,132,109,57,59],"漏洞","py14y51e02vvrgbaztxtoq5pv","恶意浏览器扩展可借 Claude Dispatch 在用户电脑上执行命令","Forever Security 测试发现，能在 claude.ai 运行脚本的恶意或被入侵扩展，可利用 Dispatch 向已登录的 Claude Desktop 发送指令，并自动批准操作。","原文以完整攻击链说明恶意扩展如何借 Dispatch 绕过 Claude Desktop 的操作确认，并指出相关设计可能影响其他功能。",{"_60":143},"2026-11-06T12:06:35.000Z","2026-11-06T18:23:30.552Z",[71,72,142,57,121],76,"Agent 安全","The Hacker News","slug","browser","group","field","definition","浏览器引擎、扩展与渲染进程中的漏洞利用。","brand","total",8,"recent",7,"indexable",false,"latest",{"_30":134,"_163":139},"groupName","技术方向","poolTotal",43,"at",{"_165":166,"_167":-5},"changelogVersion","2026-10-01T08:00","release"]
