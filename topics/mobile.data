[{"_1":2,"_3":4},"root",{"_5":174},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1793667146000,{"_154":155,"_62":57,"_156":157,"_158":159,"_160":-5,"_161":162,"_163":164,"_165":166,"_167":168,"_169":170,"_171":172},"modules",{},"items",[20,21,22,23,24,25,26,27,28],"page",1,"pageCount","pageSize",20,{"_29":144,"_31":145,"_33":146,"_35":147,"_37":148,"_39":149,"_41":150,"_42":70,"_44":151,"_46":152,"_48":49,"_50":51,"_52":-5},{"_29":134,"_31":135,"_33":136,"_35":137,"_37":138,"_39":139,"_41":140,"_42":43,"_44":141,"_46":142,"_48":49,"_50":51,"_52":-5},{"_29":126,"_31":127,"_33":128,"_35":129,"_37":130,"_39":131,"_41":131,"_42":85,"_44":132,"_46":133,"_48":49,"_50":51,"_52":-5},{"_29":116,"_31":117,"_33":118,"_35":119,"_37":120,"_39":121,"_41":121,"_42":85,"_44":122,"_46":123,"_48":49,"_50":51,"_52":-5},{"_29":106,"_31":107,"_33":108,"_35":109,"_37":110,"_39":111,"_41":111,"_42":70,"_44":112,"_46":113,"_48":49,"_50":51,"_52":-5},{"_29":94,"_31":95,"_33":96,"_35":97,"_37":98,"_39":99,"_41":99,"_42":70,"_44":100,"_46":101,"_48":49,"_50":51,"_52":-5},{"_29":79,"_31":80,"_33":81,"_35":82,"_37":83,"_39":84,"_41":84,"_42":85,"_44":86,"_46":87,"_48":49,"_50":51,"_52":-5},{"_29":64,"_31":65,"_33":66,"_35":67,"_37":68,"_39":69,"_41":69,"_42":70,"_44":71,"_46":72,"_48":49,"_50":51,"_52":-5},{"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":40,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":-5},"id","hegwfchoh8ewaw8ebcfpt0rl5","title","Bright Data SDK 技术研究：智能电视与 iOS 设备如何成为 AI 抓取代理节点","summary","Include Security 逆向分析 Bright Data iOS SDK 并观测 30 天流量，揭示其经 WebSocket 接收抓取任务、以用户住宅 IP 执行请求，以及绕过 VPN 检查的机制。","reason","文章通过逆向与运行时流量观测还原 SDK 代理机制，并给出网络侧和终端侧的可落地检测方向。","source",{"_62":63},"publishedAt","2026-06-05T16:01:11.000Z","timelineAt","category","disclosure","tags",[53,54,55,56,57,58,59,60,61],"score",74,"selected",true,"channel","news","x","技术研究","逆向","AI 安全","IoT","移动端","云原生","Apple","Google","Cloudflare","name","Inception Security","nv5z7uyciraj8jnruy9fuk4pg","慢雾披露 DarkSword iOS 攻击套件已产品化并用于窃密","慢雾发现 DarkSword 攻击套件已被封装成可部署的 iOS 窃密平台，通过伪装落地页和版本分流触发利用链。面板显示 57 台设备、10,125 条窃取记录和 9 次数据外传，并上线钱包解密与归集功能；代码确认可完整利用的窗口为 iOS 18.6 至 18.7.2及 26.0 至 26.1，另有针对 CVE-2026-43818 的利用仍待真机验证。","原文通过代码比对、面板数据与基础设施关联，呈现了公开利用链如何被封装为可运营的 iOS 窃密与钱包变现平台。",{"_62":78},"2026-10-19T09:00:00.000Z","activity",[73,74,75,76,77,57,59,60],86,"攻击活动","恶意软件","在野利用","利用链","数据窃取","慢雾科技","uukgij1t4m3i1qpqpe902jihr","PHP 引擎漏洞 CVE-2026-109618 与 CVE-2026-109619 影响移动应用后端，CVSS v4.0 均为 9.2","PHP 项目于 2026 年 10 月 21 日修复服务器端 PHP 引擎漏洞 CVE-2026-109618 和 CVE-2026-109619，二者 CVSS v4.0 均为 9.2；漏洞不在 iOS 或 Android 应用二进制中，但应用通过 API 或第三方 SDK 连接受影响后端时，用户数据和可用性可能受影响。","文章结合移动应用网络流量与三个月评估样本，说明后端 PHP 漏洞如何转化为移动端风险，并给出归属确认、修复和复测流程。",{"_62":93},"2026-10-22T18:58:39.000Z","vuln",[88,89,90,91,57,92],80,"漏洞","补丁","漏洞分析","AI 攻防","PHP","NowSecure","s1k2fp12bgmxm2eh2plyz5txj","研究人员披露租用型 Android 间谍软件 uCreater","研究人员披露租用型 Android 间谍软件 uCreater，它通过重打包 Telegram、WeChat 和 GCash 等应用，注入模块以窃取账户凭据、聊天记录、一次性密码及钱包数据。","文章还原了 uCreater 的模块化注入、远程控制与数据窃取链路，并指出其面向移动钱包和一次性密码的租用模式。",{"_62":105},"2026-10-26T12:11:38.000Z",[74,77,57,102,103,53,104],73,"挖矿","后门","阿里","Security Affairs","ot6sqkksyfqrhvgedxtnpwbrc","荷兰警方侦破 AI 语音与 NFC 虚假银行应用联合诈骗，170 人损失 €380,000","荷兰警方已逮捕两名涉嫌利用 AI 语音、虚假银行应用和 NFC 技术盗取银行卡数据的嫌疑人。团伙在3周内欺骗170名受害者安装虚假应用并扫描银行卡，同伙随后在 ATM 或支付终端取款，造成约 €380,000 损失；警方提醒，如有人要求用应用扫描银行卡，应挂断并拨打卡面印有的银行电话。","该案展示了 AI 语音、虚假银行应用与 NFC 读卡组合实施盗刷的具体链路，便于理解新型银行客服诈骗的流程。",{"_62":105},"2026-10-26T15:06:26.000Z",[73,91,114,77,57,115],68,"钓鱼","黑产","qahg0yikc6d5korbxkqoe523g","Microsoft Authenticator Android 版漏洞 CVE-2026-80097 可窃取工作账号令牌","Microsoft 已修复 Microsoft Authenticator Android 版 CVE-2026-80097，未经许可的恶意应用可伪装成 Teams 等受信任应用并获取工作账号令牌。","文章梳理了 Android 应用签名校验失效的利用链，并对比研究者 PoC 与厂商公告对用户交互条件的不同描述。",{"_62":125},"2026-10-27T12:09:50.000Z",[88,89,90,57,124],72,"Microsoft","The Hacker News","yocbcrg7ag66qmssktcr4jvbu","Apple 将已被利用的 CoreGraphics 漏洞 CVE-2026-86950 修复回移至旧版 iPhone 和 iPad","Apple 将已在真实攻击中被利用的 CoreGraphics 越界写入漏洞 CVE-2026-86950 修复回移至 iOS 18.7.11 和 iPadOS 18.7.11，CVSS 为 8.8。","文章说明了受在野利用漏洞的补丁回移范围与受影响旧设备版本，便于相关用户判断是否需要升级处置。",{"_62":125},"2026-10-27T13:59:09.000Z",[88,89,75,57,59],78,"vwazprhy9sym8n3jfpzyapz5g","Android SMS of Death 漏洞分析：CVE-2026-58882 可用零点击 WAP Push 消息阻断电话服务","独立研究员 Mark Blaszczyk 披露 Android 的 SMS of Death 漏洞 CVE-2026-58882，攻击者仅需发送一条特制 WAP Push 消息即可零点击触发崩溃，阻断电话及紧急呼叫。","文章拆解了零点击 WAP Push 消息触发电话服务崩溃的原理、复现效果与修复范围，便于评估旧款 Android 设备的暴露风险。",{"_62":105},"2026-11-01T12:16:50.000Z","2026-11-01T13:26:34.091Z",[90,143,53,57,60],79,"复现","zpp06qhnjm5r6ekq6fx53gr5s","攻击者向乌克兰和俄罗斯民众发送虚假核威胁与袭击警报","乌克兰和俄罗斯的应急警报应用疑遭网络攻击，向民众发送核威胁、辐射、化学攻击和巷战等虚假警报，相关说法尚未获独立证实。乌克兰 Air Alarm 应用于当地时间 22:47 起发出多条警报，部分警报还触发 Lviv 地区广播；该应用随后因疑似被攻破而临时停用。","事件同时呈现应急警报应用被篡改和停机之间的安全取舍，并给出官方备份渠道与反钓鱼提醒。",{"_62":105},"2026-11-02T10:20:46.000Z","2026-11-02T10:47:35.469Z",[73,114,57,153],71,"应急响应","slug","mobile","group","field","definition","Android、iOS 与移动应用中的漏洞、越狱与恶意组件。","brand","total",9,"recent",8,"indexable",false,"latest",{"_31":145,"_173":150},"groupName","技术方向","poolTotal",42,"at",{"_175":176,"_177":-5},"changelogVersion","2026-10-01T08:00","release"]
