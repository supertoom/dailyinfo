[{"_1":2,"_3":4},"root",{"_5":163},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1793590950000,{"_143":144,"_61":56,"_145":146,"_147":148,"_149":-5,"_150":151,"_152":153,"_154":155,"_156":157,"_158":159,"_160":161},"modules",{},"items",[20,21,22,23,24,25,26,27],"page",1,"pageCount","pageSize",20,{"_28":133,"_30":134,"_32":135,"_34":136,"_36":137,"_38":138,"_40":139,"_41":42,"_43":140,"_45":141,"_47":48,"_49":50,"_51":-5},{"_28":125,"_30":126,"_32":127,"_34":128,"_36":129,"_38":130,"_40":130,"_41":84,"_43":131,"_45":132,"_47":48,"_49":50,"_51":-5},{"_28":115,"_30":116,"_32":117,"_34":118,"_36":119,"_38":120,"_40":120,"_41":84,"_43":121,"_45":122,"_47":48,"_49":50,"_51":-5},{"_28":105,"_30":106,"_32":107,"_34":108,"_36":109,"_38":110,"_40":110,"_41":69,"_43":111,"_45":112,"_47":48,"_49":50,"_51":-5},{"_28":93,"_30":94,"_32":95,"_34":96,"_36":97,"_38":98,"_40":98,"_41":69,"_43":99,"_45":100,"_47":48,"_49":50,"_51":-5},{"_28":78,"_30":79,"_32":80,"_34":81,"_36":82,"_38":83,"_40":83,"_41":84,"_43":85,"_45":86,"_47":48,"_49":50,"_51":-5},{"_28":63,"_30":64,"_32":65,"_34":66,"_36":67,"_38":68,"_40":68,"_41":69,"_43":70,"_45":71,"_47":48,"_49":50,"_51":-5},{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":39,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":-5},"id","hegwfchoh8ewaw8ebcfpt0rl5","title","Bright Data SDK 技术研究：智能电视与 iOS 设备如何成为 AI 抓取代理节点","summary","Include Security 逆向分析 Bright Data iOS SDK 并观测 30 天流量，揭示其经 WebSocket 接收抓取任务、以用户住宅 IP 执行请求，以及绕过 VPN 检查的机制。","reason","文章通过逆向与运行时流量观测还原 SDK 代理机制，并给出网络侧和终端侧的可落地检测方向。","source",{"_61":62},"publishedAt","2026-06-05T16:01:11.000Z","timelineAt","category","disclosure","tags",[52,53,54,55,56,57,58,59,60],"score",74,"selected",true,"channel","news","x","技术研究","逆向","AI 安全","IoT","移动端","云原生","Apple","Google","Cloudflare","name","Inception Security","nv5z7uyciraj8jnruy9fuk4pg","慢雾披露 DarkSword iOS 攻击套件已产品化并用于窃密","慢雾发现 DarkSword 攻击套件已被封装成可部署的 iOS 窃密平台，通过伪装落地页和版本分流触发利用链。面板显示 57 台设备、10,125 条窃取记录和 9 次数据外传，并上线钱包解密与归集功能；代码确认可完整利用的窗口为 iOS 18.6 至 18.7.2及 26.0 至 26.1，另有针对 CVE-2026-43818 的利用仍待真机验证。","原文通过代码比对、面板数据与基础设施关联，呈现了公开利用链如何被封装为可运营的 iOS 窃密与钱包变现平台。",{"_61":77},"2026-10-19T09:00:00.000Z","activity",[72,73,74,75,76,56,58,59],86,"攻击活动","恶意软件","在野利用","利用链","数据窃取","慢雾科技","uukgij1t4m3i1qpqpe902jihr","PHP 引擎漏洞 CVE-2026-109618 与 CVE-2026-109619 影响移动应用后端，CVSS v4.0 均为 9.2","PHP 项目于 2026 年 10 月 21 日修复服务器端 PHP 引擎漏洞 CVE-2026-109618 和 CVE-2026-109619，二者 CVSS v4.0 均为 9.2；漏洞不在 iOS 或 Android 应用二进制中，但应用通过 API 或第三方 SDK 连接受影响后端时，用户数据和可用性可能受影响。","文章结合移动应用网络流量与三个月评估样本，说明后端 PHP 漏洞如何转化为移动端风险，并给出归属确认、修复和复测流程。",{"_61":92},"2026-10-22T18:58:39.000Z","vuln",[87,88,89,90,56,91],80,"漏洞","补丁","漏洞分析","AI 攻防","PHP","NowSecure","s1k2fp12bgmxm2eh2plyz5txj","研究人员披露租用型 Android 间谍软件 uCreater","研究人员披露租用型 Android 间谍软件 uCreater，它通过重打包 Telegram、WeChat 和 GCash 等应用，注入模块以窃取账户凭据、聊天记录、一次性密码及钱包数据。","文章还原了 uCreater 的模块化注入、远程控制与数据窃取链路，并指出其面向移动钱包和一次性密码的租用模式。",{"_61":104},"2026-10-26T12:11:38.000Z",[73,76,56,101,102,52,103],73,"挖矿","后门","阿里","Security Affairs","ot6sqkksyfqrhvgedxtnpwbrc","荷兰警方侦破 AI 语音与 NFC 虚假银行应用联合诈骗，170 人损失 €380,000","荷兰警方已逮捕两名涉嫌利用 AI 语音、虚假银行应用和 NFC 技术盗取银行卡数据的嫌疑人。团伙在3周内欺骗170名受害者安装虚假应用并扫描银行卡，同伙随后在 ATM 或支付终端取款，造成约 €380,000 损失；警方提醒，如有人要求用应用扫描银行卡，应挂断并拨打卡面印有的银行电话。","该案展示了 AI 语音、虚假银行应用与 NFC 读卡组合实施盗刷的具体链路，便于理解新型银行客服诈骗的流程。",{"_61":104},"2026-10-26T15:06:26.000Z",[72,90,113,76,56,114],68,"钓鱼","黑产","qahg0yikc6d5korbxkqoe523g","Microsoft Authenticator Android 版漏洞 CVE-2026-80097 可窃取工作账号令牌","Microsoft 已修复 Microsoft Authenticator Android 版 CVE-2026-80097，未经许可的恶意应用可伪装成 Teams 等受信任应用并获取工作账号令牌。","文章梳理了 Android 应用签名校验失效的利用链，并对比研究者 PoC 与厂商公告对用户交互条件的不同描述。",{"_61":124},"2026-10-27T12:09:50.000Z",[87,88,89,56,123],72,"Microsoft","The Hacker News","yocbcrg7ag66qmssktcr4jvbu","Apple 将已被利用的 CoreGraphics 漏洞 CVE-2026-86950 修复回移至旧版 iPhone 和 iPad","Apple 将已在真实攻击中被利用的 CoreGraphics 越界写入漏洞 CVE-2026-86950 修复回移至 iOS 18.7.11 和 iPadOS 18.7.11，CVSS 为 8.8。","文章说明了受在野利用漏洞的补丁回移范围与受影响旧设备版本，便于相关用户判断是否需要升级处置。",{"_61":124},"2026-10-27T13:59:09.000Z",[87,88,74,56,58],78,"vwazprhy9sym8n3jfpzyapz5g","Android SMS of Death 漏洞分析：CVE-2026-58882 可用零点击 WAP Push 消息阻断电话服务","独立研究员 Mark Blaszczyk 披露 Android 的 SMS of Death 漏洞 CVE-2026-58882，攻击者仅需发送一条特制 WAP Push 消息即可零点击触发崩溃，阻断电话及紧急呼叫。","文章拆解了零点击 WAP Push 消息触发电话服务崩溃的原理、复现效果与修复范围，便于评估旧款 Android 设备的暴露风险。",{"_61":104},"2026-11-01T12:16:50.000Z","2026-11-01T13:26:34.091Z",[89,142,52,56,59],79,"复现","slug","mobile","group","field","definition","Android、iOS 与移动应用中的漏洞、越狱与恶意组件。","brand","total",8,"recent",7,"indexable",false,"latest",{"_30":134,"_162":139},"groupName","技术方向","poolTotal",38,"at",{"_164":165,"_166":-5},"changelogVersion","2026-10-01T08:00","release"]
