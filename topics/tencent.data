[{"_1":2,"_3":4},"root",{"_5":124},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1794357412000,{"_98":99,"_57":100,"_101":102,"_103":104,"_105":106,"_107":108,"_109":110,"_111":112,"_113":114,"_115":116,"_117":118},"modules",{},"items",[20,21,22,23,24],"page",1,"pageCount","pageSize",20,{"_25":89,"_27":90,"_29":91,"_31":92,"_33":93,"_35":94,"_37":94,"_38":39,"_40":95,"_42":96,"_44":45,"_46":47,"_48":-5},{"_25":80,"_27":81,"_29":82,"_31":83,"_33":84,"_35":85,"_37":85,"_38":39,"_40":86,"_42":87,"_44":45,"_46":47,"_48":-5},{"_25":69,"_27":70,"_29":71,"_31":72,"_33":73,"_35":74,"_37":74,"_38":39,"_40":75,"_42":76,"_44":45,"_46":47,"_48":-5},{"_25":59,"_27":60,"_29":61,"_31":62,"_33":63,"_35":64,"_37":64,"_38":39,"_40":65,"_42":66,"_44":45,"_46":47,"_48":-5},{"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":36,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47,"_48":-5},"id","huf4buuylc5ywa2pjtlmm9lq3","title","腾讯玄武实验室发布 AI 网络爬虫安全白皮书与 SEChrome 防护方案","summary","腾讯玄武实验室发布《AI网络爬虫安全白皮书》，分析 AI 服务端浏览器在多用户共享、补丁滞后、沙箱关闭和内网连通条件下的远程代码执行及 Prompt Injection 风险。团队基于多款真实产品测试提出“静态攻击面收敛 + 动态行为隔离”框架，并开源 SEChrome，通过 seccomp 与 ptrace 管控文件访问、进程创建和网络请求。","reason","白皮书结合真实产品案例梳理 AI 服务端浏览器的攻击链，并给出可落地的纵深防御框架与开源方案。","source",{"_57":58},"publishedAt","2026-02-02T15:20:00.000Z","timelineAt","category","ai-security","tags",[49,50,51,52,53,54,55,56],"score",78,"selected",true,"channel","news","x","AI 安全","Agent 安全","技术研究","工具发布","大模型","容器","腾讯","Google","name","腾讯玄武实验室","rjcpwdiupgwgomfowmuznp88d","腾讯玄武实验室揭示 Agentic Coding「幽灵依赖」风险并发布 Atuin 插件","腾讯玄武实验室发现 Agentic Coding 中的「幽灵依赖」可导致过时组件引入 N-day 漏洞及幻觉组件名遭定向投毒，并发布 Atuin 插件，在依赖写入和安装执行前进行审计、修复或阻断。","文章以真实工作流实验揭示 Agentic Coding 的两类供应链风险，并给出可落地的 Pre-Execution Hooks 防护架构。",{"_57":58},"2026-02-28T00:00:00.000Z",[49,50,67,68,51,52,55],75,"AI 供应链","供应链投毒","lzzrdgwygnesdslym7n13igy0","腾讯安全分析智能体过度主动行为及会话级防护","腾讯安全威胁情报中心分析 AI 智能体遭拦截后重试、换工具、改写命令、自行提权和搜刮凭据等过度主动行为，并分析智能体间运行时进程注入风险。文章提出从命令级检测升级为会话级行为建模、主动熔断和上下文感知引导，同时对定时任务等无人值守场景加严检测。","文章以五个真实监测场景说明智能体如何反复重试、改写命令和自行提权，并提出会话级熔断与上下文感知等防护思路。",{"_57":79},"2026-06-25T10:00:00.000Z",[49,50,51,77,78,55],76,"检测工程","凭据","腾讯安全威胁情报中心","n1ykq1mr9xqfobubobdb857lg","腾讯科恩实验室发布 BinaryAI-Bench，评测 AI Agent 二进制安全分析能力","腾讯科恩实验室发布面向真实逆向工程的 BinaryAI-Bench，通过两轮各 8 个模型 × 50 个任务的系统评测，考察 AI Agent 的二进制安全分析能力。","文章详述评测集的任务来源、评分验证与两轮实测，并区分模型能力短板和安全拒答干扰，为评估 AI Agent 的真实逆向能力提供了可复核框架。",{"_57":79},"2026-09-03T05:01:00.000Z",[49,50,52,88,53,51,55],64,"工具评测","zrnxk4reo9orq0jhxo4yva7kg","腾讯科恩实验室分析 Skill 攻防：路径穿越、供应链投毒与代码后门向 Agent 链路迁移","腾讯科恩实验室指出，Agent Skill 正成为新攻击载体，路径穿越、ZIP-SLIP、供应链投毒、恶意附件和业务代码后门已出现在安装与执行链路中。其近期样本显示，恶意逻辑可藏于 SKILL.md 元数据、.git/hooks 或正常函数分支，文章建议结合反病毒引擎、沙盒引擎、静态分析与 AI 审查，覆盖下载、解压、安装和运行全流程。","文章以样本和阶段数据说明 Skill 如何承接经典攻击技术，并给出覆盖下载、解压、安装与运行链路的检测思路。",{"_57":79},"2026-09-18T03:30:00.000Z",[49,50,67,77,68,97,55],69,"恶意软件","slug","tencent","腾讯安全","group","company","definition","腾讯玄武实验室与科恩实验室的漏洞研究、威胁情报与安全公告。","brand",{"_120":-5,"_121":122,"_123":112},"total",5,"recent",0,"indexable",false,"latest",{"_27":90,"_119":94},"groupName","厂商与机构","poolTotal",14,"at","src","monogram","腾","raster",{"_125":126,"_127":-5},"changelogVersion","2026-10-01T08:00","release"]
