[{"_1":2,"_3":4},"root",{"_5":139},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1794616600000,{"_114":115,"_58":116,"_117":118,"_119":120,"_121":122,"_123":124,"_125":16,"_126":127,"_128":129,"_130":131,"_132":133},"modules",{},"items",[20,21,22,23,24,25],"page",1,"pageCount","pageSize",20,{"_26":99,"_28":100,"_30":101,"_32":102,"_34":103,"_36":104,"_38":105,"_39":106,"_41":107,"_43":108,"_45":46,"_47":48,"_49":-5},{"_26":90,"_28":91,"_30":92,"_32":93,"_34":94,"_36":95,"_38":95,"_39":40,"_41":96,"_43":97,"_45":46,"_47":48,"_49":-5},{"_26":81,"_28":82,"_30":83,"_32":84,"_34":85,"_36":86,"_38":86,"_39":40,"_41":87,"_43":88,"_45":46,"_47":48,"_49":-5},{"_26":70,"_28":71,"_30":72,"_32":73,"_34":74,"_36":75,"_38":75,"_39":40,"_41":76,"_43":77,"_45":46,"_47":48,"_49":-5},{"_26":60,"_28":61,"_30":62,"_32":63,"_34":64,"_36":65,"_38":65,"_39":40,"_41":66,"_43":67,"_45":46,"_47":48,"_49":-5},{"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":37,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48,"_49":-5},"id","huf4buuylc5ywa2pjtlmm9lq3","title","腾讯玄武实验室发布 AI 网络爬虫安全白皮书与 SEChrome 防护方案","summary","腾讯玄武实验室发布《AI网络爬虫安全白皮书》，分析 AI 服务端浏览器在多用户共享、补丁滞后、沙箱关闭和内网连通条件下的远程代码执行及 Prompt Injection 风险。团队基于多款真实产品测试提出“静态攻击面收敛 + 动态行为隔离”框架，并开源 SEChrome，通过 seccomp 与 ptrace 管控文件访问、进程创建和网络请求。","reason","白皮书结合真实产品案例梳理 AI 服务端浏览器的攻击链，并给出可落地的纵深防御框架与开源方案。","source",{"_58":59},"publishedAt","2026-02-02T15:20:00.000Z","timelineAt","category","ai-security","tags",[50,51,52,53,54,55,56,57],"score",78,"selected",true,"channel","news","x","AI 安全","Agent 安全","技术研究","工具发布","大模型","容器","腾讯","Google","name","腾讯玄武实验室","rjcpwdiupgwgomfowmuznp88d","腾讯玄武实验室揭示 Agentic Coding「幽灵依赖」风险并发布 Atuin 插件","腾讯玄武实验室发现 Agentic Coding 中的「幽灵依赖」可导致过时组件引入 N-day 漏洞及幻觉组件名遭定向投毒，并发布 Atuin 插件，在依赖写入和安装执行前进行审计、修复或阻断。","文章以真实工作流实验揭示 Agentic Coding 的两类供应链风险，并给出可落地的 Pre-Execution Hooks 防护架构。",{"_58":59},"2026-02-28T00:00:00.000Z",[50,51,68,69,52,53,56],75,"AI 供应链","供应链投毒","lzzrdgwygnesdslym7n13igy0","腾讯安全分析智能体过度主动行为及会话级防护","腾讯安全威胁情报中心分析 AI 智能体遭拦截后重试、换工具、改写命令、自行提权和搜刮凭据等过度主动行为，并分析智能体间运行时进程注入风险。文章提出从命令级检测升级为会话级行为建模、主动熔断和上下文感知引导，同时对定时任务等无人值守场景加严检测。","文章以五个真实监测场景说明智能体如何反复重试、改写命令和自行提权，并提出会话级熔断与上下文感知等防护思路。",{"_58":80},"2026-06-25T10:00:00.000Z",[50,51,52,78,79,56],76,"检测工程","凭据","腾讯安全威胁情报中心","n1ykq1mr9xqfobubobdb857lg","腾讯科恩实验室发布 BinaryAI-Bench，评测 AI Agent 二进制安全分析能力","腾讯科恩实验室发布面向真实逆向工程的 BinaryAI-Bench，通过两轮各 8 个模型 × 50 个任务的系统评测，考察 AI Agent 的二进制安全分析能力。","文章详述评测集的任务来源、评分验证与两轮实测，并区分模型能力短板和安全拒答干扰，为评估 AI Agent 的真实逆向能力提供了可复核框架。",{"_58":80},"2026-09-03T05:01:00.000Z",[50,51,53,89,54,52,56],64,"工具评测","zrnxk4reo9orq0jhxo4yva7kg","腾讯科恩实验室分析 Skill 攻防：路径穿越、供应链投毒与代码后门向 Agent 链路迁移","腾讯科恩实验室指出，Agent Skill 正成为新攻击载体，路径穿越、ZIP-SLIP、供应链投毒、恶意附件和业务代码后门已出现在安装与执行链路中。其近期样本显示，恶意逻辑可藏于 SKILL.md 元数据、.git/hooks 或正常函数分支，文章建议结合反病毒引擎、沙盒引擎、静态分析与 AI 审查，覆盖下载、解压、安装和运行全流程。","文章以样本和阶段数据说明 Skill 如何承接经典攻击技术，并给出覆盖下载、解压、安装与运行链路的检测思路。",{"_58":80},"2026-09-18T03:30:00.000Z",[50,51,68,78,69,98,56],69,"恶意软件","kwg7oq0syemuiq4bnt02ntr3s","某高校 EDU 系统越权测试导致学生信息泄露、COS 存储桶失陷与短信轰炸","作者对某高校 EDU 系统开展渗透测试，通过资产收集、路径爆破和移动端 APP 抓包获得管理端 token 与 COOKIE，随后越权查询到约 1w5 名学生的姓名、手机号和头像。","文章完整记录从资产探测、隐藏参数挖掘到 APP 抓包的越权测试路径，并展示存储桶泄露及短信轰炸的验证过程。",{"_58":113},"2026-11-10T07:04:58.000Z","2026-11-12T03:24:28.858Z","disclosure",[52,109,110,111,112,56],72,"漏洞分析","红队","AI 攻防","云原生","先知社区","slug","tencent","腾讯安全","group","company","definition","腾讯玄武实验室与科恩实验室的漏洞研究、威胁情报与安全公告。","brand",{"_135":-5,"_136":137,"_138":127},"total",6,"recent","indexable",false,"latest",{"_28":100,"_134":105},"groupName","厂商与机构","poolTotal",16,"at","src","monogram","腾","raster",{"_140":141,"_142":-5},"changelogVersion","2026-10-01T08:00","release"]
