[{"_1":2,"_3":4},"root",{"_5":129},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1793621699000,{"_110":111,"_57":52,"_112":113,"_114":115,"_116":-5,"_117":118,"_119":16,"_120":121,"_122":123,"_124":125,"_126":127},"modules",{},"items",[20,21,22,23,24,25],"page",1,"pageCount","pageSize",20,{"_26":99,"_28":100,"_30":101,"_32":102,"_34":103,"_36":104,"_38":105,"_39":40,"_41":106,"_43":107,"_45":46,"_47":48,"_49":-5},{"_26":90,"_28":91,"_30":92,"_32":93,"_34":94,"_36":95,"_38":95,"_39":40,"_41":96,"_43":97,"_45":46,"_47":48,"_49":-5},{"_26":79,"_28":80,"_30":81,"_32":82,"_34":83,"_36":84,"_38":84,"_39":40,"_41":85,"_43":86,"_45":46,"_47":48,"_49":-5},{"_26":68,"_28":69,"_30":70,"_32":71,"_34":72,"_36":73,"_38":73,"_39":40,"_41":74,"_43":75,"_45":46,"_47":48,"_49":-5},{"_26":59,"_28":60,"_30":61,"_32":62,"_34":63,"_36":64,"_38":64,"_39":40,"_41":65,"_43":66,"_45":46,"_47":48,"_49":-5},{"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":37,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48,"_49":-5},"id","h3q56oufyq0g5bbhq5um5atva","title","AryStinger 入侵至少 4300 台老旧路由器并组建攻击跳板","summary","奇安信XLab披露 AryStinger 利用 CVE-2013-3307、CVE-2016-5681 和 CVE-2025-11837 感染 Linksys、D-Link 等老旧路由器及 NAS 设备，全球至少 4300 台路由器已感染。","reason","文章拆解了 AryStinger 的传播漏洞、任务机制与持久化方式，并提供感染规模、版本差异及网络、文件和进程自查线索。","source",{"_57":58},"publishedAt","2026-06-17T08:55:00.000Z","timelineAt","category","activity","tags",[50,51,52,53,54,55,56],"score",76,"selected",true,"channel","news","x","攻击活动","恶意软件","僵尸网络","后门","IoT","技术研究","奇安信","name","奇安信XLab","zsy39vdrv4wdnyey5udwn1tgx","RustDuck 双阶段僵尸网络深度剖析","奇安信XLab监测到 RustDuck 僵尸网络采用 Loader + Core 双阶段架构，主要执行大规模分布式拒绝服务（DDoS）攻击。其传播链覆盖 IoT 设备、Web 应用及企业基础设施，通过弱口令爆破和 RCE 漏洞利用进行自动化入侵；分析还揭示了 Loader 的四代加解密演进、Core 的 HKDF-SHA256 密钥派生、反调试机制及基于 Noise IK 的加密通信设计。","文章通过 Loader 四个演进阶段与 Core 模块的密钥、反调试和通信设计，展示了 RustDuck 双阶段架构及多分支加密机制的演化。",{"_57":58},"2026-06-30T06:57:00.000Z",[50,51,52,54,67,55,56],64,"逆向","s6tx9zp66jz6pepywfrdyp8ne","NadMesh 僵尸网络分析：定向收割 AI 服务并利用 20+ RCE 向量扩散","奇安信X实验室分析 NadMesh 僵尸网络，该恶意软件以 Go 语言编写，将自治扫描、20+ RCE 利用、凭证与 AI 服务情报收割整合为闭环平台。其通过 Shodan 定向收集 ComfyUI、Ollama 等 AI 服务资产，利用 Redis、Docker、MCP、K8s 等向量投递 Agent，并通过 SSH 公钥、Agent 进程和 Cron 看门狗维持持久化。","文章拆解了 NadMesh 从情报采集、扫描利用到持久化的闭环，还给出控制端鉴权弱点与投递方式，便于理解其产品化运营特征。",{"_57":58},"2026-07-17T08:02:00.000Z",[50,51,52,76,77,78,56],73,"AI 安全","云原生","容器","i3uyx7d544h4duouxtfb7z7wp","奇安信XLab分析僵尸网络分布式传播活动","中国联通与奇安信CU-Xlab联合实验室分析某省公网NetFlow流量，确认僵尸网络以“低频慢扫侦查—隐蔽C2回连—自动化横向传播”模式活动。攻击涉及Telnet、SSH、SMB、数据库、代理及IoT管理接口等高危服务，部分主机已形成失陷、受控并对外扩散的闭环。报告建议治理暴露资产与弱口令，检测周期性心跳、小包长连接等行为，并结合DNS和主机数据定位失陷主机。","报告以NetFlow日志还原低频慢扫、C2回连到肉鸡扩散的完整链路，并揭示针对高危服务与IoT资产的组合式攻击。",{"_57":58},"2026-07-20T03:49:00.000Z",[50,52,54,87,88,89,56],67,"网络设备","数据窃取","检测工程","w1qikmbtlmwa88lr1ay0q7wds","Dysphoria 僵尸网络演进与深度技术分析","奇安信X实验室分析 Dysphoria 僵尸网络的演进、DDoS 与纯中继样本、传播方式及 IOC。该网络通过 Telnet/SSH 弱口令爆破和 IoT 设备 RCE 漏洞传播，并利用 ENS、SNS 区块链域名及受控肉鸡中继隐藏 C2；2026年7月14日至20日，国内已确认活跃肉鸡达4401台，境内日上线肉鸡最高1801台，肉鸡 C2 日访问量最高74万次。","文章还原了 Dysphoria 的演进、混淆、通信与中继机制，并给出规模监测和 IOC，便于理解其传播与隐蔽通信设计。",{"_57":58},"2026-07-27T09:42:00.000Z",[50,52,51,54,98,56],80,"CNCERT","sadp3rc08vj8hs3yc7r72lm24","CNCERT披露VeilDHT僵尸网络大范围感染Linux服务器与IoT设备","国家互联网应急中心（CNCERT）监测发现VeilDHT僵尸网络正通过漏洞利用大范围传播，主要感染Linux服务器与IoT设备。2026年10月16日至10月26日期间，我国境内累计40467台设备受感染，境内日上线肉鸡数最高达15805台。","原文梳理了VeilDHT的双通道控制机制、加密通信、攻击能力与40467台感染规模，便于识别该僵尸网络的传播和防护重点。",{"_57":109},"2026-11-02T09:49:00.000Z","2026-11-02T11:46:32.053Z",[50,51,52,108,54,98],83,"漏洞利用","安全内参","slug","botnet","group","field","definition","僵尸网络的规模、扩散方式、感染面与幕后团伙。","brand","total",6,"recent","indexable",false,"latest",{"_28":100,"_128":105},"groupName","技术方向","poolTotal",10,"at",{"_130":131,"_132":-5},"changelogVersion","2026-10-01T08:00","release"]
