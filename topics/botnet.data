[{"_1":2,"_3":4},"root",{"_5":168},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1794184871000,{"_148":149,"_60":55,"_150":151,"_152":153,"_154":-5,"_155":156,"_157":158,"_159":160,"_161":162,"_163":164,"_165":166},"modules",{},"items",[20,21,22,23,24,25,26,27,28],"page",1,"pageCount","pageSize",20,{"_29":137,"_31":138,"_33":139,"_35":140,"_37":141,"_39":142,"_41":143,"_42":43,"_44":144,"_46":78,"_48":49,"_50":51,"_52":-5},{"_29":125,"_31":126,"_33":127,"_35":128,"_37":129,"_39":130,"_41":131,"_42":43,"_44":132,"_46":47,"_48":49,"_50":51,"_52":-5},{"_29":113,"_31":114,"_33":115,"_35":116,"_37":117,"_39":118,"_41":119,"_42":43,"_44":120,"_46":121,"_48":49,"_50":51,"_52":-5},{"_29":102,"_31":103,"_33":104,"_35":105,"_37":106,"_39":107,"_41":108,"_42":43,"_44":109,"_46":110,"_48":49,"_50":51,"_52":-5},{"_29":93,"_31":94,"_33":95,"_35":96,"_37":97,"_39":98,"_41":98,"_42":43,"_44":99,"_46":100,"_48":49,"_50":51,"_52":-5},{"_29":82,"_31":83,"_33":84,"_35":85,"_37":86,"_39":87,"_41":87,"_42":43,"_44":88,"_46":89,"_48":49,"_50":51,"_52":-5},{"_29":71,"_31":72,"_33":73,"_35":74,"_37":75,"_39":76,"_41":76,"_42":43,"_44":77,"_46":78,"_48":49,"_50":51,"_52":-5},{"_29":62,"_31":63,"_33":64,"_35":65,"_37":66,"_39":67,"_41":67,"_42":43,"_44":68,"_46":69,"_48":49,"_50":51,"_52":-5},{"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":40,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":-5},"id","h3q56oufyq0g5bbhq5um5atva","title","AryStinger 入侵至少 4300 台老旧路由器并组建攻击跳板","summary","奇安信XLab披露 AryStinger 利用 CVE-2013-3307、CVE-2016-5681 和 CVE-2025-11837 感染 Linksys、D-Link 等老旧路由器及 NAS 设备，全球至少 4300 台路由器已感染。","reason","文章拆解了 AryStinger 的传播漏洞、任务机制与持久化方式，并提供感染规模、版本差异及网络、文件和进程自查线索。","source",{"_60":61},"publishedAt","2026-06-17T08:55:00.000Z","timelineAt","category","activity","tags",[53,54,55,56,57,58,59],"score",76,"selected",true,"channel","news","x","攻击活动","恶意软件","僵尸网络","后门","IoT","技术研究","奇安信","name","奇安信XLab","zsy39vdrv4wdnyey5udwn1tgx","RustDuck 双阶段僵尸网络深度剖析","奇安信XLab监测到 RustDuck 僵尸网络采用 Loader + Core 双阶段架构，主要执行大规模分布式拒绝服务（DDoS）攻击。其传播链覆盖 IoT 设备、Web 应用及企业基础设施，通过弱口令爆破和 RCE 漏洞利用进行自动化入侵；分析还揭示了 Loader 的四代加解密演进、Core 的 HKDF-SHA256 密钥派生、反调试机制及基于 Noise IK 的加密通信设计。","文章通过 Loader 四个演进阶段与 Core 模块的密钥、反调试和通信设计，展示了 RustDuck 双阶段架构及多分支加密机制的演化。",{"_60":61},"2026-06-30T06:57:00.000Z",[53,54,55,57,70,58,59],64,"逆向","s6tx9zp66jz6pepywfrdyp8ne","NadMesh 僵尸网络分析：定向收割 AI 服务并利用 20+ RCE 向量扩散","奇安信X实验室分析 NadMesh 僵尸网络，该恶意软件以 Go 语言编写，将自治扫描、20+ RCE 利用、凭证与 AI 服务情报收割整合为闭环平台。其通过 Shodan 定向收集 ComfyUI、Ollama 等 AI 服务资产，利用 Redis、Docker、MCP、K8s 等向量投递 Agent，并通过 SSH 公钥、Agent 进程和 Cron 看门狗维持持久化。","文章拆解了 NadMesh 从情报采集、扫描利用到持久化的闭环，还给出控制端鉴权弱点与投递方式，便于理解其产品化运营特征。",{"_60":61},"2026-07-17T08:02:00.000Z",[53,54,55,79,80,81,59],73,"AI 安全","云原生","容器","i3uyx7d544h4duouxtfb7z7wp","奇安信XLab分析僵尸网络分布式传播活动","中国联通与奇安信CU-Xlab联合实验室分析某省公网NetFlow流量，确认僵尸网络以“低频慢扫侦查—隐蔽C2回连—自动化横向传播”模式活动。攻击涉及Telnet、SSH、SMB、数据库、代理及IoT管理接口等高危服务，部分主机已形成失陷、受控并对外扩散的闭环。报告建议治理暴露资产与弱口令，检测周期性心跳、小包长连接等行为，并结合DNS和主机数据定位失陷主机。","报告以NetFlow日志还原低频慢扫、C2回连到肉鸡扩散的完整链路，并揭示针对高危服务与IoT资产的组合式攻击。",{"_60":61},"2026-07-20T03:49:00.000Z",[53,55,57,90,91,92,59],67,"网络设备","数据窃取","检测工程","w1qikmbtlmwa88lr1ay0q7wds","Dysphoria 僵尸网络演进与深度技术分析","奇安信X实验室分析 Dysphoria 僵尸网络的演进、DDoS 与纯中继样本、传播方式及 IOC。该网络通过 Telnet/SSH 弱口令爆破和 IoT 设备 RCE 漏洞传播，并利用 ENS、SNS 区块链域名及受控肉鸡中继隐藏 C2；2026年7月14日至20日，国内已确认活跃肉鸡达4401台，境内日上线肉鸡最高1801台，肉鸡 C2 日访问量最高74万次。","文章还原了 Dysphoria 的演进、混淆、通信与中继机制，并给出规模监测和 IOC，便于理解其传播与隐蔽通信设计。",{"_60":61},"2026-07-27T09:42:00.000Z",[53,55,54,57,101,59],80,"CNCERT","sadp3rc08vj8hs3yc7r72lm24","CNCERT披露VeilDHT僵尸网络大范围感染Linux服务器与IoT设备","国家互联网应急中心（CNCERT）监测发现VeilDHT僵尸网络正通过漏洞利用大范围传播，主要感染Linux服务器与IoT设备。2026年10月16日至10月26日期间，我国境内累计40467台设备受感染，境内日上线肉鸡数最高达15805台。","原文梳理了VeilDHT的双通道控制机制、加密通信、攻击能力与40467台感染规模，便于识别该僵尸网络的传播和防护重点。",{"_60":112},"2026-11-02T09:49:00.000Z","2026-11-02T11:46:32.053Z",[53,54,55,111,57,101],83,"漏洞利用","安全内参","wbjzunigapakv96vd54t9g53c","Google 联合处置 XCPE 僵尸网络，Videostrong 预装后门感染逾 130 万台机顶盒","Google 与行业伙伴已拆除 XCPE 后门相关控制基础设施，该后门将超过 1.3 million 台机顶盒及其他 Android IoT 设备纳入僵尸网络。","文章拆解了从固件预装、持久化到模块化变现的完整链条，并提供可核对的样本哈希与网络指标。",{"_60":124},"2026-11-02T14:00:00.000Z","2026-11-02T13:46:42.052Z",[53,54,56,55,57,122,123],90,"供应链投毒","Google","Google Cloud 威胁情报","lybkf1c5asn88rjr54wj2w33h","Microsoft 披露木马化安装程序下载活动及三类变现载荷","Microsoft Threat Intelligence 发现一项针对破解软件、免费游戏、激活器和非官方工具用户的假下载活动，通过 Inno Setup 风格安装程序、临时运行器和 offer 回调投放载荷。","文章还原了从假下载诱导、Inno 临时运行到三类载荷落地的完整链路，并提供持久化行为和狩猎线索，便于识别隐藏在安装会话中的变现组件。",{"_60":136},"2026-11-03T17:32:47.000Z","2026-11-03T18:15:23.494Z",[53,54,133,134,55,135],"黑产","供应链","Microsoft","Microsoft Security Blog","yff939zg4626fodd5o7g9p2h9","White House 网络被检出 236 次住宅代理出口流量","Layer3 Intel 称，White House 网络在 10 月 5 日至 11 月 3 日的 30 天内通过 AS2650 形成 236 次住宅代理出口，涉及 6 个地址和 28 个住宅代理服务，任何人注册服务并付费即可使用该路径。","文章展示了住宅代理流量如何借道高防护网络，并结合流量时段、设备特征和代理 SDK 提示潜在失陷路径。",{"_60":147},"2026-11-06T10:29:58.000Z","2026-11-06T16:15:28.885Z",[53,145,54,55,91,135,146],"在野利用","Cloudflare","Help Net Security","slug","botnet","group","field","definition","僵尸网络的规模、扩散方式、感染面与幕后团伙。","brand","total",9,"recent",4,"indexable",false,"latest",{"_31":138,"_167":143},"groupName","技术方向","poolTotal",25,"at",{"_169":170,"_171":-5},"changelogVersion","2026-10-01T08:00","release"]
