[{"_1":2,"_3":4},"root",{"_5":143},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1793667393000,{"_123":124,"_58":53,"_125":126,"_127":128,"_129":-5,"_130":131,"_132":133,"_134":135,"_136":137,"_138":139,"_140":141},"modules",{},"items",[20,21,22,23,24,25,26],"page",1,"pageCount","pageSize",20,{"_27":111,"_29":112,"_31":113,"_33":114,"_35":115,"_37":116,"_39":117,"_40":41,"_42":118,"_44":119,"_46":47,"_48":49,"_50":-5},{"_27":100,"_29":101,"_31":102,"_33":103,"_35":104,"_37":105,"_39":106,"_40":41,"_42":107,"_44":108,"_46":47,"_48":49,"_50":-5},{"_27":91,"_29":92,"_31":93,"_33":94,"_35":95,"_37":96,"_39":96,"_40":41,"_42":97,"_44":98,"_46":47,"_48":49,"_50":-5},{"_27":80,"_29":81,"_31":82,"_33":83,"_35":84,"_37":85,"_39":85,"_40":41,"_42":86,"_44":87,"_46":47,"_48":49,"_50":-5},{"_27":69,"_29":70,"_31":71,"_33":72,"_35":73,"_37":74,"_39":74,"_40":41,"_42":75,"_44":76,"_46":47,"_48":49,"_50":-5},{"_27":60,"_29":61,"_31":62,"_33":63,"_35":64,"_37":65,"_39":65,"_40":41,"_42":66,"_44":67,"_46":47,"_48":49,"_50":-5},{"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":38,"_40":41,"_42":43,"_44":45,"_46":47,"_48":49,"_50":-5},"id","h3q56oufyq0g5bbhq5um5atva","title","AryStinger 入侵至少 4300 台老旧路由器并组建攻击跳板","summary","奇安信XLab披露 AryStinger 利用 CVE-2013-3307、CVE-2016-5681 和 CVE-2025-11837 感染 Linksys、D-Link 等老旧路由器及 NAS 设备，全球至少 4300 台路由器已感染。","reason","文章拆解了 AryStinger 的传播漏洞、任务机制与持久化方式，并提供感染规模、版本差异及网络、文件和进程自查线索。","source",{"_58":59},"publishedAt","2026-06-17T08:55:00.000Z","timelineAt","category","activity","tags",[51,52,53,54,55,56,57],"score",76,"selected",true,"channel","news","x","攻击活动","恶意软件","僵尸网络","后门","IoT","技术研究","奇安信","name","奇安信XLab","zsy39vdrv4wdnyey5udwn1tgx","RustDuck 双阶段僵尸网络深度剖析","奇安信XLab监测到 RustDuck 僵尸网络采用 Loader + Core 双阶段架构，主要执行大规模分布式拒绝服务（DDoS）攻击。其传播链覆盖 IoT 设备、Web 应用及企业基础设施，通过弱口令爆破和 RCE 漏洞利用进行自动化入侵；分析还揭示了 Loader 的四代加解密演进、Core 的 HKDF-SHA256 密钥派生、反调试机制及基于 Noise IK 的加密通信设计。","文章通过 Loader 四个演进阶段与 Core 模块的密钥、反调试和通信设计，展示了 RustDuck 双阶段架构及多分支加密机制的演化。",{"_58":59},"2026-06-30T06:57:00.000Z",[51,52,53,55,68,56,57],64,"逆向","s6tx9zp66jz6pepywfrdyp8ne","NadMesh 僵尸网络分析：定向收割 AI 服务并利用 20+ RCE 向量扩散","奇安信X实验室分析 NadMesh 僵尸网络，该恶意软件以 Go 语言编写，将自治扫描、20+ RCE 利用、凭证与 AI 服务情报收割整合为闭环平台。其通过 Shodan 定向收集 ComfyUI、Ollama 等 AI 服务资产，利用 Redis、Docker、MCP、K8s 等向量投递 Agent，并通过 SSH 公钥、Agent 进程和 Cron 看门狗维持持久化。","文章拆解了 NadMesh 从情报采集、扫描利用到持久化的闭环，还给出控制端鉴权弱点与投递方式，便于理解其产品化运营特征。",{"_58":59},"2026-07-17T08:02:00.000Z",[51,52,53,77,78,79,57],73,"AI 安全","云原生","容器","i3uyx7d544h4duouxtfb7z7wp","奇安信XLab分析僵尸网络分布式传播活动","中国联通与奇安信CU-Xlab联合实验室分析某省公网NetFlow流量，确认僵尸网络以“低频慢扫侦查—隐蔽C2回连—自动化横向传播”模式活动。攻击涉及Telnet、SSH、SMB、数据库、代理及IoT管理接口等高危服务，部分主机已形成失陷、受控并对外扩散的闭环。报告建议治理暴露资产与弱口令，检测周期性心跳、小包长连接等行为，并结合DNS和主机数据定位失陷主机。","报告以NetFlow日志还原低频慢扫、C2回连到肉鸡扩散的完整链路，并揭示针对高危服务与IoT资产的组合式攻击。",{"_58":59},"2026-07-20T03:49:00.000Z",[51,53,55,88,89,90,57],67,"网络设备","数据窃取","检测工程","w1qikmbtlmwa88lr1ay0q7wds","Dysphoria 僵尸网络演进与深度技术分析","奇安信X实验室分析 Dysphoria 僵尸网络的演进、DDoS 与纯中继样本、传播方式及 IOC。该网络通过 Telnet/SSH 弱口令爆破和 IoT 设备 RCE 漏洞传播，并利用 ENS、SNS 区块链域名及受控肉鸡中继隐藏 C2；2026年7月14日至20日，国内已确认活跃肉鸡达4401台，境内日上线肉鸡最高1801台，肉鸡 C2 日访问量最高74万次。","文章还原了 Dysphoria 的演进、混淆、通信与中继机制，并给出规模监测和 IOC，便于理解其传播与隐蔽通信设计。",{"_58":59},"2026-07-27T09:42:00.000Z",[51,53,52,55,99,57],80,"CNCERT","sadp3rc08vj8hs3yc7r72lm24","CNCERT披露VeilDHT僵尸网络大范围感染Linux服务器与IoT设备","国家互联网应急中心（CNCERT）监测发现VeilDHT僵尸网络正通过漏洞利用大范围传播，主要感染Linux服务器与IoT设备。2026年10月16日至10月26日期间，我国境内累计40467台设备受感染，境内日上线肉鸡数最高达15805台。","原文梳理了VeilDHT的双通道控制机制、加密通信、攻击能力与40467台感染规模，便于识别该僵尸网络的传播和防护重点。",{"_58":110},"2026-11-02T09:49:00.000Z","2026-11-02T11:46:32.053Z",[51,52,53,109,55,99],83,"漏洞利用","安全内参","wbjzunigapakv96vd54t9g53c","Google 联合处置 XCPE 僵尸网络，Videostrong 预装后门感染逾 130 万台机顶盒","Google 与行业伙伴已拆除 XCPE 后门相关控制基础设施，该后门将超过 1.3 million 台机顶盒及其他 Android IoT 设备纳入僵尸网络。","文章拆解了从固件预装、持久化到模块化变现的完整链条，并提供可核对的样本哈希与网络指标。",{"_58":122},"2026-11-02T14:00:00.000Z","2026-11-02T13:46:42.052Z",[51,52,54,53,55,120,121],90,"供应链投毒","Google","Google Cloud 威胁情报","slug","botnet","group","field","definition","僵尸网络的规模、扩散方式、感染面与幕后团伙。","brand","total",7,"recent",2,"indexable",false,"latest",{"_29":112,"_142":117},"groupName","技术方向","poolTotal",14,"at",{"_144":145,"_146":-5},"changelogVersion","2026-10-01T08:00","release"]
