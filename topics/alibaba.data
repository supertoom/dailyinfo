[{"_1":2,"_3":4},"root",{"_5":135},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1793590949000,{"_109":110,"_56":111,"_112":113,"_114":115,"_116":117,"_118":119,"_120":121,"_122":123,"_124":125,"_126":127,"_128":129},"modules",{},"items",[20,21,22,23,24],"page",1,"pageCount","pageSize",20,{"_25":98,"_27":99,"_29":100,"_31":101,"_33":102,"_35":103,"_37":104,"_38":64,"_40":105,"_42":80,"_44":45,"_46":47,"_48":-5},{"_25":83,"_27":84,"_29":85,"_31":86,"_33":87,"_35":88,"_37":88,"_38":64,"_40":89,"_42":90,"_44":45,"_46":47,"_48":-5},{"_25":73,"_27":74,"_29":75,"_31":76,"_33":77,"_35":78,"_37":78,"_38":39,"_40":79,"_42":80,"_44":45,"_46":47,"_48":-5},{"_25":58,"_27":59,"_29":60,"_31":61,"_33":62,"_35":63,"_37":63,"_38":64,"_40":65,"_42":66,"_44":45,"_46":47,"_48":-5},{"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":36,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47,"_48":-5},"id","ubmhg666g7io8awkyjs3h4xhv","title","React 与 Next.js 披露 RCE 漏洞 CVE-2025-55182、CVE-2025-66478","summary","Meta 的 React 核心团队与 Vercel 的 Next.js 团队披露 CVE-2025-55182 和 CVE-2025-66478，均为 CVSS 10 分，攻击者在一定条件下可执行任意代码。","reason","文章列明 React 与 Next.js 的受影响版本，并提供扫描、拦截和升级方案，便于评估业务暴露面与处置优先级。","source",{"_56":57},"publishedAt","2025-12-04T10:29:00.000Z","timelineAt","category","vuln","tags",[49,50,51,52,53,54,55],"score",76,"selected",true,"channel","news","x","漏洞","补丁","复现","漏洞利用","供应链","Google","阿里","name","阿里云应急响应","t0mfxe6ringdek22yuuj5zceg","阿里云发布 2025年12月云上安全态势报告","阿里云发布 2025年12月云上安全态势报告，汇总平台默认防御、DDoS 拦截和高频攻击漏洞。黑产团伙利用 Next.js RCE 漏洞 CVE-2025-66478 发起主机勒索、恶意挖矿和 DDoS 攻击，阿里云提供风险预警及漏洞检测能力，并建议升级 React 和 Next.js 或使用 WAF、云防火墙临时缓解。","报告汇总云平台防御数据，并披露黑产利用 Next.js RCE 开展勒索、挖矿和 DDoS 的证据及处置建议。",{"_56":57},"2026-01-14T09:52:00.000Z","activity",[67,68,52,69,70,71,55,72],63,"攻击活动","在野利用","黑产","云原生","应急响应","CISA","ubn6i9zp62tllbxm8sz5ag5py","Fastjson 2.x <= 2.0.62 远程代码执行漏洞披露，CVSS 9.8","Fastjson 2.x <= 2.0.62 存在远程代码执行漏洞，未启用 SupportAutoType 时仍可能通过内置白名单处理 JSON 中的 @type，未经身份验证的攻击者可构造恶意 JSON 数据实现 RCE，CVSS 评分为 9.8。漏洞细节已公开，官方已发布安全补丁；暂时无法升级时可启用 SafeMode，并可使用 WAF 拦截含 @type 字段的 JSON 数据。","通告明确给出受影响版本、autoType绕过机制、检测方法与临时缓解配置，便于使用者判断风险并安排升级。",{"_56":82},"2026-07-27T11:24:00.000Z",[49,50,51,81,55],78,"漏洞分析","绿盟科技CERT","s1k2fp12bgmxm2eh2plyz5txj","研究人员披露租用型 Android 间谍软件 uCreater","研究人员披露租用型 Android 间谍软件 uCreater，它通过重打包 Telegram、WeChat 和 GCash 等应用，注入模块以窃取账户凭据、聊天记录、一次性密码及钱包数据。","文章还原了 uCreater 的模块化注入、远程控制与数据窃取链路，并指出其面向移动钱包和一次性密码的租用模式。",{"_56":97},"2026-10-26T12:11:38.000Z",[91,92,93,94,95,96,55],73,"恶意软件","数据窃取","移动端","挖矿","后门","技术研究","Security Affairs","jp4m1qw9jcqdjssxmkm0ramgj","Hugging Face 恶意模型挖矿活动死灰复燃，GitHub 假 Solana 工具包瞄准 AI 编码代理","Pluto Security 在 Hugging Face 发现针对自托管 GPU 推理主机的挖矿与后门活动，7 个账号下的 31 个仓库伪装成 Qwen2 测试模型。","两起活动分别利用模型远程代码执行选项和 AI 编码代理信任机制加载恶意代码，文中还给出了处置与凭据轮换建议。",{"_56":108},"2026-10-29T22:09:24.000Z","2026-10-29T23:39:25.249Z",[67,91,94,95,106,107,55],"供应链投毒","AI 供应链","BleepingComputer","slug","alibaba","阿里云安全","group","company","definition","阿里云安全的漏洞通告、云上防护与应急响应。","brand",{"_131":-5,"_132":133,"_134":123},"total",5,"recent",2,"indexable",false,"latest",{"_27":99,"_130":104},"groupName","厂商与机构","poolTotal",9,"at","src","monogram","阿","raster",{"_136":137,"_138":-5},"changelogVersion","2026-10-01T08:00","release"]
