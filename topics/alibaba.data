[{"_1":2,"_3":4},"root",{"_5":159},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1794195598000,{"_133":134,"_58":135,"_136":137,"_138":139,"_140":141,"_142":143,"_144":145,"_146":147,"_148":149,"_150":151,"_152":153},"modules",{},"items",[20,21,22,23,24,25,26],"page",1,"pageCount","pageSize",20,{"_27":122,"_29":123,"_31":124,"_33":125,"_35":126,"_37":127,"_39":128,"_40":41,"_42":129,"_44":130,"_46":47,"_48":49,"_50":-5},{"_27":111,"_29":112,"_31":113,"_33":114,"_35":115,"_37":116,"_39":117,"_40":66,"_42":118,"_44":82,"_46":47,"_48":49,"_50":-5},{"_27":100,"_29":101,"_31":102,"_33":103,"_35":104,"_37":105,"_39":105,"_40":106,"_42":107,"_44":108,"_46":47,"_48":49,"_50":-5},{"_27":85,"_29":86,"_31":87,"_33":88,"_35":89,"_37":90,"_39":90,"_40":66,"_42":91,"_44":92,"_46":47,"_48":49,"_50":-5},{"_27":75,"_29":76,"_31":77,"_33":78,"_35":79,"_37":80,"_39":80,"_40":41,"_42":81,"_44":82,"_46":47,"_48":49,"_50":-5},{"_27":60,"_29":61,"_31":62,"_33":63,"_35":64,"_37":65,"_39":65,"_40":66,"_42":67,"_44":68,"_46":47,"_48":49,"_50":-5},{"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":38,"_40":41,"_42":43,"_44":45,"_46":47,"_48":49,"_50":-5},"id","ubmhg666g7io8awkyjs3h4xhv","title","React 与 Next.js 披露 RCE 漏洞 CVE-2025-55182、CVE-2025-66478","summary","Meta 的 React 核心团队与 Vercel 的 Next.js 团队披露 CVE-2025-55182 和 CVE-2025-66478，均为 CVSS 10 分，攻击者在一定条件下可执行任意代码。","reason","文章列明 React 与 Next.js 的受影响版本，并提供扫描、拦截和升级方案，便于评估业务暴露面与处置优先级。","source",{"_58":59},"publishedAt","2025-12-04T10:29:00.000Z","timelineAt","category","vuln","tags",[51,52,53,54,55,56,57],"score",76,"selected",true,"channel","news","x","漏洞","补丁","复现","漏洞利用","供应链","Google","阿里","name","阿里云应急响应","t0mfxe6ringdek22yuuj5zceg","阿里云发布 2025年12月云上安全态势报告","阿里云发布 2025年12月云上安全态势报告，汇总平台默认防御、DDoS 拦截和高频攻击漏洞。黑产团伙利用 Next.js RCE 漏洞 CVE-2025-66478 发起主机勒索、恶意挖矿和 DDoS 攻击，阿里云提供风险预警及漏洞检测能力，并建议升级 React 和 Next.js 或使用 WAF、云防火墙临时缓解。","报告汇总云平台防御数据，并披露黑产利用 Next.js RCE 开展勒索、挖矿和 DDoS 的证据及处置建议。",{"_58":59},"2026-01-14T09:52:00.000Z","activity",[69,70,54,71,72,73,57,74],63,"攻击活动","在野利用","黑产","云原生","应急响应","CISA","ubn6i9zp62tllbxm8sz5ag5py","Fastjson 2.x <= 2.0.62 远程代码执行漏洞披露，CVSS 9.8","Fastjson 2.x <= 2.0.62 存在远程代码执行漏洞，未启用 SupportAutoType 时仍可能通过内置白名单处理 JSON 中的 @type，未经身份验证的攻击者可构造恶意 JSON 数据实现 RCE，CVSS 评分为 9.8。漏洞细节已公开，官方已发布安全补丁；暂时无法升级时可启用 SafeMode，并可使用 WAF 拦截含 @type 字段的 JSON 数据。","通告明确给出受影响版本、autoType绕过机制、检测方法与临时缓解配置，便于使用者判断风险并安排升级。",{"_58":84},"2026-07-27T11:24:00.000Z",[51,52,53,83,57],78,"漏洞分析","绿盟科技CERT","s1k2fp12bgmxm2eh2plyz5txj","研究人员披露租用型 Android 间谍软件 uCreater","研究人员披露租用型 Android 间谍软件 uCreater，它通过重打包 Telegram、WeChat 和 GCash 等应用，注入模块以窃取账户凭据、聊天记录、一次性密码及钱包数据。","文章还原了 uCreater 的模块化注入、远程控制与数据窃取链路，并指出其面向移动钱包和一次性密码的租用模式。",{"_58":99},"2026-10-26T12:11:38.000Z",[93,94,95,96,97,98,57],73,"恶意软件","数据窃取","移动端","挖矿","后门","技术研究","Security Affairs","ig0dgl6sxncd114p1trc3k52b","fastjson 1.2.83 远程代码执行漏洞 CVE-2026-16723 复现与利用链分析","fastjson 1.2.83 存在不可信数据反序列化导致的远程代码执行漏洞 CVE-2026-16723，影响 1.2.68 ≤ fastjson ≤ 1.2.83，目标需以 Spring Boot 可执行 fat-jar 模式运行。","文章完整拆解了远程 JAR 探测、类型校验绕过与静态初始化执行命令的利用链，并给出 PoC、临时缓解和官方修复差异。",{"_58":110},"2026-10-27T15:38:49.000Z","disclosure",[53,83,54,109,98,57],80,"利用链","先知社区","jp4m1qw9jcqdjssxmkm0ramgj","Hugging Face 恶意模型挖矿活动死灰复燃，GitHub 假 Solana 工具包瞄准 AI 编码代理","Pluto Security 在 Hugging Face 发现针对自托管 GPU 推理主机的挖矿与后门活动，7 个账号下的 31 个仓库伪装成 Qwen2 测试模型。","两起活动分别利用模型远程代码执行选项和 AI 编码代理信任机制加载恶意代码，文中还给出了处置与凭据轮换建议。",{"_58":121},"2026-10-29T22:09:24.000Z","2026-10-29T23:39:25.249Z",[69,93,96,97,119,120,57],"供应链投毒","AI 供应链","BleepingComputer","evjboavsq5zcivgr94mnwlu4l","OpenSSH <10.6p2 musl libc 认证绕过漏洞 CVE-2026-123158 已修复","OpenSSH 披露并修复了 CVE-2026-123158，影响使用 musl libc 且口令认证不经过 PAM 的配置。远程未认证攻击者在启用口令认证、账户口令字段为单个 * 且存在特定备用盐值时，可提交 257～1024 字节超长口令触发 musl crypt() 长度限制，使 sshd 将认证错误判定为成功。","通告梳理了特定配置下的认证绕过原理，并提供升级、禁用口令认证及入侵排查方法。",{"_58":59},"2026-11-06T03:59:00.000Z","2026-11-07T03:28:32.622Z",[51,52,83,131,132,57],72,"身份与访问","操作系统","slug","alibaba","阿里云安全","group","company","definition","阿里云安全的漏洞通告、云上防护与应急响应。","brand",{"_155":-5,"_156":157,"_158":147},"total",7,"recent",4,"indexable",false,"latest",{"_29":123,"_154":128},"groupName","厂商与机构","poolTotal",13,"at","src","monogram","阿","raster",{"_160":161,"_162":-5},"changelogVersion","2026-10-01T08:00","release"]
