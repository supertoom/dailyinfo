[{"_1":2,"_3":4},"root",{"_5":88},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795394208000,{"_68":69,"_51":70,"_71":72,"_73":74,"_75":-5,"_76":77,"_78":77,"_79":80,"_81":82,"_83":84,"_85":86},"modules",{},"items",[20,21],"page",1,"pageCount","pageSize",20,{"_22":53,"_24":54,"_26":55,"_28":56,"_30":57,"_32":58,"_34":59,"_36":60,"_38":61,"_40":62,"_42":43,"_44":45,"_46":-5},{"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":-5},"id","syiens59ccuc9lmtn233vr8gd","title","意大利因 Facebook Android 图库访问默认开启问题罚款 Meta €805 million","summary","意大利数据保护机构 Garante 对 Meta 罚款 €805 million，原因是 Facebook for Android 默认开启照片和视频图库建议功能，未经用户明确同意访问意大利用户图库及相关元数据。","reason","材料梳理了处罚依据、整改期限和功能默认状态，可用于理解移动应用获取图库权限时的合规边界。","source",{"_51":52},"publishedAt","2026-11-15T11:27:31.000Z","timelineAt","2026-11-15T12:18:29.177Z","category","policy","tags",[47,48,49,50],"score",73,"selected",true,"channel","news","x","法规","合规","移动端","Google","name","The Hacker News","atovtf3rgx78nodedw7k6h9cz","Cleverbridge 遭黑客入侵，支付卡号与 CVV/CVC 数据被窃","Cleverbridge 表示，黑客入侵其平台并窃取客户用于平台购物的支付卡号、到期日和 CVV/CVC 安全码，但未泄露姓名、联系方式或账单信息。公司于 2026 年 11 月 4 日发现未授权活动并临时下线系统，同日恢复后确认第三方复制了平台存储的支付卡数据；自 11 月 20 日起通知受影响客户，但尚未披露受影响客户数量、攻击者进入平台的方式、停留时间或数据是否加密。","材料披露了支付卡数据被窃的具体字段，并说明事件不属于勒索软件，为受影响客户评估风险和处置卡账户提供了直接依据。",{"_51":67},"2026-11-22T15:43:04.000Z","2026-11-22T15:59:15.526Z","activity",[63,64,65,66,48],70,"攻击活动","数据泄露","数据窃取","凭据","BleepingComputer","slug","compliance","合规与标准","group","field","definition","等保、关基保护、数据安全法等合规要求与安全标准。","brand","total",2,"recent","indexable",false,"latest",{"_24":54,"_87":59},"groupName","技术方向","poolTotal",121,"at",{"_89":90,"_91":-5},"changelogVersion","2026-10-01T08:00","release"]
