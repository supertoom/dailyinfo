[{"_1":2,"_3":4},"root",{"_5":87},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795739817000,{"_67":68,"_51":69,"_70":71,"_72":73,"_74":-5,"_75":76,"_77":76,"_78":79,"_80":81,"_82":83,"_84":85},"modules",{},"items",[20,21],"page",1,"pageCount","pageSize",20,{"_22":53,"_24":54,"_26":55,"_28":56,"_30":57,"_32":58,"_34":59,"_36":37,"_38":60,"_40":61,"_42":43,"_44":45,"_46":-5},{"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":-5},"id","syiens59ccuc9lmtn233vr8gd","title","意大利因 Facebook Android 图库访问默认开启问题罚款 Meta €805 million","summary","意大利数据保护机构 Garante 对 Meta 罚款 €805 million，原因是 Facebook for Android 默认开启照片和视频图库建议功能，未经用户明确同意访问意大利用户图库及相关元数据。","reason","材料梳理了处罚依据、整改期限和功能默认状态，可用于理解移动应用获取图库权限时的合规边界。","source",{"_51":52},"publishedAt","2026-11-15T11:27:31.000Z","timelineAt","2026-11-15T12:18:29.177Z","category","policy","tags",[47,48,49,50],"score",73,"selected",true,"channel","news","x","法规","合规","移动端","Google","name","The Hacker News","ldspkafngxgpmt8icv3r5x8ao","英国FCA要求金融机构管控AI Agent风险，否则将采取监管行动","英国金融监管机构 FCA 警告金融机构，必须处理部署 AI Agent 带来的网络安全风险，否则可能面临监管行动。11 月 24 日发布的指引要求负责相关 AI 模型的资深管理者采取合理措施，理解系统自主程度及其风险，提供有效监督、适当治理控制和升级机制；机构还应评估接受 AI Agent 指令及付款的责任，通过清晰、相称且一致的免责声明说明模型提供的信息和建议边界。","FCA明确了金融机构部署AI Agent时的责任边界，并列出访问控制、监督、治理和消费者提示等可落实的合规要求。",{"_51":66},"2026-11-24T13:45:00.000Z","2026-11-24T13:58:38.593Z",[62,63,64,48,65],70,"AI 安全","Agent 安全","治理","大模型","Infosecurity Magazine","slug","compliance","合规与标准","group","field","definition","等保、关基保护、数据安全法等合规要求与安全标准。","brand","total",2,"recent","indexable",false,"latest",{"_24":54,"_86":59},"groupName","技术方向","poolTotal",147,"at",{"_88":89,"_90":-5},"changelogVersion","2026-10-01T08:00","release"]
