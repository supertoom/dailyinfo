[{"_1":2,"_3":4},"root",{"_5":93},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1794184872000,{"_68":69,"_50":70,"_71":72,"_73":74,"_75":76,"_77":78,"_79":78,"_80":81,"_82":83,"_84":85,"_86":87},"modules",{},"items",[20,21],"page",1,"pageCount","pageSize",20,{"_22":52,"_24":53,"_26":54,"_28":55,"_30":56,"_32":57,"_34":58,"_35":59,"_37":60,"_39":40,"_41":42,"_43":44,"_45":-5},{"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":33,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5},"id","alokn0c20ui9gf0db4c8vdrz8","title","Mozilla 阻断遭泄露的 eMudhra 中间证书并发布 Firefox 更新","summary","Mozilla 针对与 8 个 eMudhra 中间证书关联的私钥遭泄露事件，在 Firefox 中通过 OneCRL 阻断这些证书，并发布 Firefox 158.0.1、Firefox ESR 115.43.1、Firefox ESR 153.5.1 及 NSS 3.131.1 更新。","reason","Mozilla 通过 OneCRL 阻断受影响的中间证书，并补充 Firefox 与 NSS 更新，覆盖自定义配置及使用 Mozilla 信任库的其他应用。","source",{"_50":51},"publishedAt","2026-10-20T12:54:54.000Z","timelineAt","category","activity","tags",[46,47,48,49],"score",76,"selected",true,"channel","news","x","攻击活动","数据窃取","加密","Mozilla","name","Mozilla Security","t1172o1qgorlmta0t3orhyq9l","OpenAI 发布 GPT-6 Cyber，发现 81 个未知 Firefox 高危漏洞","OpenAI 发布面向授权安全测试的 GPT-6 Cyber，用于发现漏洞、验证攻击路径并协助开发修复。该模型与 OpenAI 其他模型在受控测试中组合漏洞，从隔离虚拟环境逃逸并在宿主机执行代码；研究人员借此发现 81 个此前未知、被 Mozilla 评为高危的 Firefox 漏洞，并为 948 个 Linux 内核漏洞开发可用 Exploit。","原文披露了模型在漏洞发现、利用验证与安全控制上的实测结果，为评估 AI 辅助攻防能力和部署风险提供了具体参照。",{"_50":67},"2026-11-06T10:19:49.000Z","2026-11-06T16:15:28.894Z","ai-security",[61,62,63,64,65,66,49],"AI 安全","模型安全","AI 攻防","工具发布","大模型","漏洞利用","Help Net Security","slug","mozilla","Mozilla / Firefox","group","company","definition","Firefox 与 Thunderbird 的安全公告、证书信任事件与浏览器利用跟踪。","brand",{"_89":-5,"_90":91,"_92":81},"total",2,"recent","indexable",false,"latest",{"_24":53,"_88":58},"groupName","厂商与机构","poolTotal",11,"at","src","monogram","M","raster",{"_94":95,"_96":-5},"changelogVersion","2026-10-01T08:00","release"]
