[{"_1":2,"_3":4},"root",{"_5":75},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1793590950000,{"_51":52,"_49":53,"_54":55,"_56":57,"_58":59,"_60":16,"_61":16,"_62":63,"_64":65,"_66":67,"_68":69},"modules",{},"items",[20],"page",1,"pageCount","pageSize",20,{"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":32,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5},"id","alokn0c20ui9gf0db4c8vdrz8","title","Mozilla 阻断遭泄露的 eMudhra 中间证书并发布 Firefox 更新","summary","Mozilla 针对与 8 个 eMudhra 中间证书关联的私钥遭泄露事件，在 Firefox 中通过 OneCRL 阻断这些证书，并发布 Firefox 158.0.1、Firefox ESR 115.43.1、Firefox ESR 153.5.1 及 NSS 3.131.1 更新。","reason","Mozilla 通过 OneCRL 阻断受影响的中间证书，并补充 Firefox 与 NSS 更新，覆盖自定义配置及使用 Mozilla 信任库的其他应用。","source",{"_49":50},"publishedAt","2026-10-20T12:54:54.000Z","timelineAt","category","activity","tags",[45,46,47,48],"score",76,"selected",true,"channel","news","x","攻击活动","数据窃取","加密","Mozilla","name","Mozilla Security","slug","mozilla","Mozilla / Firefox","group","company","definition","Firefox 与 Thunderbird 的安全公告、证书信任事件与浏览器利用跟踪。","brand",{"_71":-5,"_72":73,"_74":63},"total","recent","indexable",false,"latest",{"_23":24,"_70":32},"groupName","厂商与机构","poolTotal",5,"at","src","monogram","M","raster",{"_76":77,"_78":-5},"changelogVersion","2026-10-01T08:00","release"]
