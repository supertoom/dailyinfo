[{"_1":2,"_3":4},"root",{"_5":105},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1794530259000,{"_80":81,"_51":82,"_83":84,"_85":86,"_87":88,"_89":90,"_91":90,"_92":93,"_94":95,"_96":97,"_98":99},"modules",{},"items",[20,21,22],"page",1,"pageCount","pageSize",20,{"_23":69,"_25":70,"_27":71,"_29":72,"_31":73,"_33":74,"_35":75,"_36":59,"_38":76,"_40":41,"_42":43,"_44":45,"_46":-5},{"_23":53,"_25":54,"_27":55,"_29":56,"_31":57,"_33":58,"_35":58,"_36":59,"_38":60,"_40":61,"_42":43,"_44":45,"_46":-5},{"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":34,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":-5},"id","alokn0c20ui9gf0db4c8vdrz8","title","Mozilla 阻断遭泄露的 eMudhra 中间证书并发布 Firefox 更新","summary","Mozilla 针对与 8 个 eMudhra 中间证书关联的私钥遭泄露事件，在 Firefox 中通过 OneCRL 阻断这些证书，并发布 Firefox 158.0.1、Firefox ESR 115.43.1、Firefox ESR 153.5.1 及 NSS 3.131.1 更新。","reason","Mozilla 通过 OneCRL 阻断受影响的中间证书，并补充 Firefox 与 NSS 更新，覆盖自定义配置及使用 Mozilla 信任库的其他应用。","source",{"_51":52},"publishedAt","2026-10-20T12:54:54.000Z","timelineAt","category","activity","tags",[47,48,49,50],"score",76,"selected",true,"channel","news","x","攻击活动","数据窃取","加密","Mozilla","name","Mozilla Security","swm2cvsar8e37hkbgnndp5cq4","OpenAI 发布 GPT-6 Cyber，提升授权漏洞挖掘能力并强化越权防护","OpenAI 发布 GPT-6 Cyber，用于授权漏洞挖掘与利用验证，ExploitGym 得分从 GPT-5.6 Cyber 的 32.1% 升至 48.5%。","材料同时给出模型能力、越权服从表现和真实漏洞产出数据，便于比较 AI 在授权安全测试中的效率与边界控制。",{"_51":68},"2026-11-06T13:19:52.000Z","ai-security",[62,63,64,65,66,67,50],75,"AI 安全","模型安全","Agent 安全","工具发布","漏洞利用","漏洞管理","SecurityWeek","t1172o1qgorlmta0t3orhyq9l","OpenAI 发布 GPT-6 Cyber，发现 81 个未知 Firefox 高危漏洞","OpenAI 发布面向授权安全测试的 GPT-6 Cyber，用于发现漏洞、验证攻击路径并协助开发修复。该模型与 OpenAI 其他模型在受控测试中组合漏洞，从隔离虚拟环境逃逸并在宿主机执行代码；研究人员借此发现 81 个此前未知、被 Mozilla 评为高危的 Firefox 漏洞，并为 948 个 Linux 内核漏洞开发可用 Exploit。","原文披露了模型在漏洞发现、利用验证与安全控制上的实测结果，为评估 AI 辅助攻防能力和部署风险提供了具体参照。",{"_51":79},"2026-11-06T10:19:49.000Z","2026-11-06T16:15:28.894Z",[62,63,77,65,78,66,50],"AI 攻防","大模型","Help Net Security","slug","mozilla","Mozilla / Firefox","group","company","definition","Firefox 与 Thunderbird 的安全公告、证书信任事件与浏览器利用跟踪。","brand",{"_101":-5,"_102":103,"_104":93},"total",3,"recent","indexable",false,"latest",{"_25":70,"_100":75},"groupName","厂商与机构","poolTotal",19,"at","src","monogram","M","raster",{"_106":107,"_108":-5},"changelogVersion","2026-10-01T08:00","release"]
