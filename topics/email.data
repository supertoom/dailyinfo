46,"_55":147,"_57":148,"_59":149,"_61":62,"_63":64,"_65":-5},{"_41":130,"_43":131,"_45":132,"_47":133,"_49":134,"_51":135,"_53":136,"_55":56,"_57":137,"_59":138,"_61":62,"_63":64,"_65":-5},{"_41":120,"_43":121,"_45":122,"_47":123,"_49":124,"_51":125,"_53":126,"_55":56,"_57":127,"_59":92,"_61":62,"_63":64,"_65":-5},{"_41":108,"_43":109,"_45":110,"_47":111,"_49":112,"_51":113,"_53":114,"_55":56,"_57":115,"_59":116,"_61":62,"_63":64,"_65":-5},{"_41":98,"_43":99,"_45":100,"_47":101,"_49":102,"_51":103,"_53":104,"_55":56,"_57":105,"_59":106,"_61":62,"_63":64,"_65":-5},{"_41":84,"_43":85,"_45":86,"_47":87,"_49":88,"_51":89,"_53":90,"_55":56,"_57":91,"_59":92,"_61":62,"_63":64,"_65":-5},{"_41":72,"_43":73,"_45":74,"_47":75,"_49":76,"_51":77,"_53":78,"_55":56,"_57":79,"_59":80,"_61":62,"_63":64,"_65":-5},{"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58,"_59":60,"_61":62,"_63":64,"_65":-5},"id","rowk7nbnamq9xb79zqfp85toi","title","Sony Network Communications 数据泄露暴露 2,585,481 条客户记录","summary","Sony Group Corporation 旗下 Sony Network Communications 确认，未经授权方访问 So-net 会员数据库，导致 2,585,481 条现任及前任客户记录外泄，另有 54,401 个邮箱地址和账户密码暴露；银行、支付卡及其他账户详情未受影响。","reason","事件披露了2,585,481条客户记录及54,401个邮箱和密码外泄，并给出受影响服务范围与钓鱼仿冒提醒。","source",{"_70":71},"publishedAt","2026-10-28T16:45:47.000Z","timelineAt","2026-10-29T00:15:59.083Z","category","activity","tags",[66,67,68,69],"score",74,"selected",true,"channel","news","x","数据泄露","攻击活动","数据窃取","钓鱼","name","BleepingComputer","yh480fqelqmjotur5820knfxw","被盗 K-12 学区员工账户正被用于跨学区钓鱼与欺诈","MS-ISAC 在上一学年发现，6,116 个 K-12 成员中有 808 个机构的员工账户或凭据流入地下及暗网市场，攻击者利用合法账户跨学区投递钓鱼邮件、冒充学区负责人实施欺诈。","材料量化了 K-12 学区账户接管、跨学区钓鱼和恶意软件感染，并给出资源约束下的 MFA、凭据监控与演练建议。",{"_70":83},"2026-10-29T05:00:01.000Z","2026-10-29T06:32:39.741Z",[67,69,68,81,82],70,"凭据","应急响应","Help Net Security","ztdjmvqixztivvqfwvk51of9e","Microsoft 追踪朝鲜威胁组织以 AI 加速社工、恶意软件开发与行动规模化","Microsoft Threat Intelligence 评估朝鲜威胁组织已将生成式和 Agentic AI 纳入侦察、身份伪装、恶意软件开发及运营规模化等流程，Jade Sleet、Coral Sleet 和 Jasper Sleet 已将 AI 嵌入全部行动工作流，相关操作仍由人主导而非完全自主。","文章按采纳阶段拆解多个朝鲜威胁组织使用 AI 的方式，并列出对应检测与防护措施，便于理解其对现有攻击链的规模化影响。",{"_70":97},"2026-10-29T16:00:00.000Z","2026-10-29T23:39:28.187Z",[67,93,69,94,95,68,96],71,"AI 攻防","恶意软件","供应链投毒","Microsoft","Microsoft Security Blog","utwi4trkcm6q7c7e0bnt63sw8","Binance 遭遇约 63 亿美元加密货币盗窃，TRM 归因 TraderTraitor","Binance 约 63 亿美元加密货币被盗，TRM Labs 与 Chainalysis 均高置信度将攻击归因于朝鲜组织 TraderTraitor。初步调查显示，攻击者可能从一台被攻陷的 DevOps 工程师笔记本进入服务容器，提交未授权提现交易，并攻陷热钱包签名基础设施；Ethereum 上涉及 50 个预先签署的授权。","文章梳理了资金冻结规模、链上追踪进展及攻击基础设施失陷的初步判断，便于评估追赃与交易所风控的处置重点。",{"_70":83},"2026-10-30T08:26:13.000Z","2026-10-30T08:42:44.067Z",[67,66,69,107],92,"加密","oj4wnarau3s4vwebg7k7759gl","Cisco Talos 披露 2026 年第三季度 IT 帮助台语音钓鱼攻击","Cisco Talos 在 2026 年第三季度多个响应事件中发现，攻击者冒充 IT 帮助台，通过电话、邮件和 Microsoft Teams 引导员工开启远程访问，其中一起事件以 VYPR 勒索软件收尾。","材料展示了攻击者仅凭基本身份信息逐步获得远程访问、部署勒索软件并搜寻 Claude Code 凭据的完整链条。",{"_70":83},"2026-10-30T06:30:26.000Z","2026-10-30T08:42:44.089Z",[67,69,117,94,82,81,118,96,119],73,"勒索","Cisco","Apple","zpp06qhnjm5r6ekq6fx53gr5s","攻击者向乌克兰和俄罗斯民众发送虚假核威胁与袭击警报","乌克兰和俄罗斯的应急警报应用疑遭网络攻击，向民众发送核威胁、辐射、化学攻击和巷战等虚假警报，相关说法尚未获独立证实。乌克兰 Air Alarm 应用于当地时间 22:47 起发出多条警报，部分警报还触发 Lviv 地区广播；该应用随后因疑似被攻破而临时停用。","事件同时呈现应急警报应用被篡改和停机之间的安全取舍，并给出官方备份渠道与反钓鱼提醒。",{"_70":129},"2026-11-02T10:20:46.000Z","2026-11-02T10:47:35.469Z",[67,69,128,82],"移动端","Security Affairs","ggy3le7y33yjx5i60bxd14abb","Gorbag APT 组织以自删除恶意软件攻击乌克兰法院和市议会","ESET 追踪的俄罗斯关联组织 Gorbag 自至少 2025 年 2 月起入侵乌克兰机构，利用鱼叉式钓鱼附件和 BeautyStealer 窃取浏览器凭据、VPN 配置及敏感文件。","文章完整呈现 Gorbag 的投递链、载荷投递、数据窃取与自删除机制，并给出目标行业分布和样本版本。",{"_70":83},"2026-11-03T10:00:14.000Z","2026-11-03T10:04:19.774Z",[67,94,69,68,81,139],75,"ESET","pswh7gi302afiq1veacas1zfo","Cisco Secure Email Gateway SQL 注入漏洞 CVE-2026-76461 已遭在野利用","Cisco Secure Email Gateway 的 SQL 注入漏洞 CVE-2026-76461 已被在野利用，未经身份验证的远程攻击者可通过发送含恶意 SQL 语句的邮件，在底层操作系统以 root 权限执行命令。","通告同时给出利用前提、修复版本和在野利用确认信息，并提供日志排查与集群恢复建议，便于判断暴露范围和处置优先级。",{"_70":155},"2026-11-03T09:05:12.000Z","2026-11-03T17:17:21.283Z","vuln",[150,151,152,118,153,154],81,"漏洞","在野利用","补丁","邮件安全","网络设备","Cisco PSIRT","ry1s8823u73qzqqdpklkue81e","WorkOS 称攻击者利用 ARTEX AI 入侵内部销售应用","WorkOS 称攻击者使用 ARTEX AI 渗透测试框架自动执行侦察与利用尝试，入侵了销售团队使用的内部应用。2026年10月30日发现未授权访问后，公司关闭外部访问、审查内部工具权限，并聘请独立取证与事件响应机构调查影响。","WorkOS披露了攻击者如何借助 ARTEX AI 自动化侦察与利用，并列出泄露字段和处置措施，便于相关组织评估社工风险。",{"_70":71},"2026-11-03T21:28:44.000Z","2026-11-03T22:16:21.110Z",[67,66,93,165,81,69,166],79,"红队","CrowdStrike","m3f4nnw16zmvoc10ccus1uoni","Operation CloudFire 利用 Google Calendar 邀请劫持会话并绕过 MFA","Material Security 披露 Operation CloudFire 自 2026 年 8 月中旬起以 Google Calendar 邀请钓鱼，通过 Google 跳转链接、Cloudflare Turnstile 和动态密码捕获页搭建实时反向代理，截获 SMS、身份验证器、Tap-Yes 验证及账户恢复信息，绕过 MFA。","文章拆解了借 Google Calendar 邀请实施会话劫持的链路，并展示基础设施处置如何压缩攻击者的重建成本。",{"_70":71},"2026-11-04T15:00:10.000Z","2026-11-04T15:22:22.749Z",[67,69,81,151,176,177],77,"Google","Cloudflare","sqpejfy24tujmwbg86c963iio","DreamHost确认数据泄露，FTP/SFTP凭据与部分webmail会话信息遭窃取","DreamHost确认，攻击者利用File Manager漏洞访问files.dreamhost.com并窃取客户FTP/SFTP用户名和密码，入侵从2026年8月持续至2026年10月23日；有限数量用户的webmail会话信息及凭据也可能被访问。","DreamHost披露了攻击持续时间、被窃凭据类型和处置措施，可供用户核对账户、转发规则并处置复用密码。",{"_70":71},"2026-11-04T19:05:19.000Z","2026-11-04T19:52:21.569Z",[67,66,81,153],"x6uru89ez9vvo0c0cs59kmoou","攻击者利用假 OpenAI、SpaceX 和 Anthropic 活动窃取 Microsoft、Google 账户","Push Security 披露，攻击者以 OpenAI、SpaceX 和 Anthropic 活动为诱饵，通过 Google、Zapier URL 缩短服务、GoTo Webinar 邮件及合法 Zoom 活动页分发链接，以免费 AI 服务和奖励诱导员工使用企业账户登录。","文章拆解了假活动页面如何组合两套 PhaaS 平台实施设备码钓鱼与 AiTM 劫持，攻击链和处置建议较完整。",{"_70":71},"2026-11-05T21:30:30.000Z","2026-11-06T04:39:27.657Z",[67,69,81,194,96,176,177,195],"AI 安全","腾讯","q4ecagtl22d0shlsqi4lxs630","攻击者利用第三方服务商从 Crédit Mutuel Arkéa 窃取至多 1.33 亿美元","法国银行 Crédit Mutuel Arkéa 遭遇攻击，攻击者据报通过第三方服务商平台访问其账户，向其他银行机构发起欺诈交易，损失规模约为 1.18 亿欧元至 1.33 亿美元。","材料梳理了攻击者借第三方服务商进入银行账户、实施转账并洗钱的链条，以及资金追查和客户钓鱼风险。",{"_70":129},"2026-11-08T10:25:47.000Z","2026-11-08T13:03:50.476Z",[67,66,69,107],78,"t0vi9e5cx6gstgrd9gxtu1qrk","美国司法部指控三人利用深伪 CEO 与虚假律师诈骗企业逾 $129 million","美国司法部指控 Jacob Soall、Sharon Hazan 和 Guy Sheetrit 于 2024 至 2026 年利用深伪 CEO 及国际律所律师，诱骗员工向团伙控制的账户转账逾 $129 million。","起诉书披露了利用深伪 CEO 和虚假律师诱导转账的完整链条及具体损失，可用于评估企业高管语音与视频仿冒风险。",{"_70":83},"2026-11-09T11:47:43.000Z","2026-11-09T12:11:17.101Z",[67,69,68,194,214],72,"大模型","sif366thhfeqdn24sve2qcy60","Turla 利用 Microsoft Exchange 服务器部署 Cereal 后门窃取邮件","ESET 发现俄罗斯关联组织 Turla 在哈萨克斯坦和罗马尼亚的 2 个政府机构 Microsoft Exchange 服务器上部署模块化 .NET 工具集 Cereal，通过伪装成 Outlook Web Access、Autodiscover 和 ActiveSync 流量的请求接收命令，并筛选发件人、收件人、主题或附件名称后复制邮件。","文章拆解了 Cereal 的指令执行、邮件截取与离线回退机制，并披露了针对政府和北约相关通信的筛选规则。",{"_70":83},"2026-11-10T10:00:39.000Z","2026-11-10T10:03:19.051Z",[67,94,224,68,153,96,139],83,"后门","vf2fadfkovuwc9eyk4jilfa6l","CNCERT披露“银狐”木马“金钩（G03）”团伙攻击同花顺仿冒下载站","国家互联网应急中心（CNCERT）与北京观成科技有限公司分析“银狐”木马“金钩（G03）”团伙针对同花顺仿冒下载站的活动。该团伙通过SEO投毒传播捆绑木马的THS.zip，以多阶段内存加载植入远控模块，支持屏幕截图、键盘记录、远程命令执行、插件下发和信息窃取。","报告还原了仿冒同花顺传播链、内存加载流程和通信协议，并提供控制规模与 IOC，便于理解银狐团伙的运营方式。",{"_70":237},"2026-11-10T09:12:00.000Z","2026-11-10T11:46:19.465Z",[67,94,69,224,68,234,235,177,236],85,"供应链","CNCERT","AWS","安全内参","yvzjhws6tdc6je8wptnrjsqgv","Check Point Research 追踪 CopperDragon 关联 Sparrow 框架的三个攻击集群","Check Point Research 经一年调查识别出 SilentDelivery、OceanGate 和 DarkWire 三个关联 Sparrow 框架的攻击集群。","报告以共享代码与基础设施串联三个活动集群，并披露跨平台后端、凭据窃取与隐蔽通信细节，便于拆分此前混归 FamousSparrow 的入侵活动。",{"_70":248},"2026-11-10T14:01:14.000Z","2026-11-10T14:47:20.754Z",[67,94,224,69,68,81,247,139],76,"Check Point","Check Point Research","s8ur1jt60ywc3mv4s4fv20j7z","日本家具零售商 Nitori 称黑客可能窃取 37.62 million 条客户记录","日本家具及家居用品零售商 Nitori 表示，第三方未经授权访问其系统，最多 37.62 million 条个人信息可能被外部窃取。","Nitori披露了攻击持续时间、涉及的个人与订单数据类型及37.62 million条记录规模，并说明了账户凭据未暴露和已采取的处置措施，便于相关客户判断风险。",{"_70":71},"2026-11-10T20:54:55.000Z","2026-11-10T21:00:34.625Z",[67,66,69,81],"w4i7n11q7jgyy4p2xh92mfdcb","Microsoft 11月补丁修复1,090个漏洞，CVE-2026-124194已遭利用","Microsoft 11月补丁共修复约1,090个漏洞，其中CVE-2026-124194已遭利用；该Outlook欺骗漏洞需用户打开特制消息文件，可泄露NTLMv2哈希并用于冒充用户。","原文汇总Microsoft补丁中的已利用漏洞、零点击RCE与30个潜在蠕虫漏洞，并指出部分公告细节不足。",{"_70":129},"2026-11-11T09:03:48.000Z","2026-11-11T10:08:41.289Z",[152,151,266,96,153],82,"漏洞分析","q62rs7r8pongzx30vtu5q3hx7","美国政府中断 North Korean FaceStealer 活动，查获超 4 亿美元加密资产盗取","美国政府查获基础设施并中断 North Korean 社会工程活动 FaceStealer，该活动持续 18 个月，针对加密货币、Web3 行业及开源开发者，盗取超过 $400 million 加密资产。","文章还原了 FaceStealer 如何借深伪视频、ClickFix 和恶意更新窃取加密资产及账户凭据，并给出可迁移的会议安全建议。",{"_70":71},"2026-11-14T15:15:49.000Z","2026-11-14T15:52:27.809Z",[67,94,69,68,95,81,236],"slug","email","邮件与钓鱼","group","field","definition","钓鱼基础设施、恶意邮件与邮件系统的漏洞。","brand","total",42,"recent",32,"indexable","latest",{"_43":268,"_294":273},"groupName","技术方向","poolTotal",149,"at",{"_296":297,"_298":-5},"changelogVersion","2026-10-01T08:00","release"]
