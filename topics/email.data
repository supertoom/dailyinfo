":153,"_55":56,"_57":154,"_59":109,"_61":62,"_63":64,"_65":-5},{"_41":138,"_43":139,"_45":140,"_47":141,"_49":142,"_51":143,"_53":144,"_55":56,"_57":145,"_59":81,"_61":62,"_63":64,"_65":-5},{"_41":124,"_43":125,"_45":126,"_47":127,"_49":128,"_51":129,"_53":130,"_55":131,"_57":132,"_59":133,"_61":62,"_63":64,"_65":-5},{"_41":113,"_43":114,"_45":115,"_47":116,"_49":117,"_51":118,"_53":119,"_55":56,"_57":120,"_59":121,"_61":62,"_63":64,"_65":-5},{"_41":101,"_43":102,"_45":103,"_47":104,"_49":105,"_51":106,"_53":107,"_55":56,"_57":108,"_59":109,"_61":62,"_63":64,"_65":-5},{"_41":87,"_43":88,"_45":89,"_47":90,"_49":91,"_51":92,"_53":93,"_55":56,"_57":94,"_59":95,"_61":62,"_63":64,"_65":-5},{"_41":73,"_43":74,"_45":75,"_47":76,"_49":77,"_51":78,"_53":79,"_55":56,"_57":80,"_59":81,"_61":62,"_63":64,"_65":-5},{"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58,"_59":60,"_61":62,"_63":64,"_65":-5},"id","t0vi9e5cx6gstgrd9gxtu1qrk","title","美国司法部指控三人利用深伪 CEO 与虚假律师诈骗企业逾 $129 million","summary","美国司法部指控 Jacob Soall、Sharon Hazan 和 Guy Sheetrit 于 2024 至 2026 年利用深伪 CEO 及国际律所律师，诱骗员工向团伙控制的账户转账逾 $129 million。","reason","起诉书披露了利用深伪 CEO 和虚假律师诱导转账的完整链条及具体损失，可用于评估企业高管语音与视频仿冒风险。","source",{"_71":72},"publishedAt","2026-11-09T11:47:43.000Z","timelineAt","2026-11-09T12:11:17.101Z","category","activity","tags",[66,67,68,69,70],"score",72,"selected",true,"channel","news","x","攻击活动","钓鱼","数据窃取","AI 安全","大模型","name","Help Net Security","sif366thhfeqdn24sve2qcy60","Turla 利用 Microsoft Exchange 服务器部署 Cereal 后门窃取邮件","ESET 发现俄罗斯关联组织 Turla 在哈萨克斯坦和罗马尼亚的 2 个政府机构 Microsoft Exchange 服务器上部署模块化 .NET 工具集 Cereal，通过伪装成 Outlook Web Access、Autodiscover 和 ActiveSync 流量的请求接收命令，并筛选发件人、收件人、主题或附件名称后复制邮件。","文章拆解了 Cereal 的指令执行、邮件截取与离线回退机制，并披露了针对政府和北约相关通信的筛选规则。",{"_71":72},"2026-11-10T10:00:39.000Z","2026-11-10T10:03:19.051Z",[66,82,83,68,84,85,86],83,"恶意软件","后门","邮件安全","Microsoft","ESET","vf2fadfkovuwc9eyk4jilfa6l","CNCERT披露“银狐”木马“金钩（G03）”团伙攻击同花顺仿冒下载站","国家互联网应急中心（CNCERT）与北京观成科技有限公司分析“银狐”木马“金钩（G03）”团伙针对同花顺仿冒下载站的活动。该团伙通过SEO投毒传播捆绑木马的THS.zip，以多阶段内存加载植入远控模块，支持屏幕截图、键盘记录、远程命令执行、插件下发和信息窃取。","报告还原了仿冒同花顺传播链、内存加载流程和通信协议，并提供控制规模与 IOC，便于理解银狐团伙的运营方式。",{"_71":100},"2026-11-10T09:12:00.000Z","2026-11-10T11:46:19.465Z",[66,82,67,83,68,96,97,98,99],85,"供应链","CNCERT","Cloudflare","AWS","安全内参","yvzjhws6tdc6je8wptnrjsqgv","Check Point Research 追踪 CopperDragon 关联 Sparrow 框架的三个攻击集群","Check Point Research 经一年调查识别出 SilentDelivery、OceanGate 和 DarkWire 三个关联 Sparrow 框架的攻击集群。","报告以共享代码与基础设施串联三个活动集群，并披露跨平台后端、凭据窃取与隐蔽通信细节，便于拆分此前混归 FamousSparrow 的入侵活动。",{"_71":112},"2026-11-10T14:01:14.000Z","2026-11-10T14:47:20.754Z",[66,82,83,67,68,110,111,86],76,"凭据","Check Point","Check Point Research","s8ur1jt60ywc3mv4s4fv20j7z","日本家具零售商 Nitori 称黑客可能窃取 37.62 million 条客户记录","日本家具及家居用品零售商 Nitori 表示，第三方未经授权访问其系统，最多 37.62 million 条个人信息可能被外部窃取。","Nitori披露了攻击持续时间、涉及的个人与订单数据类型及37.62 million条记录规模，并说明了账户凭据未暴露和已采取的处置措施，便于相关客户判断风险。",{"_71":123},"2026-11-10T20:54:55.000Z","2026-11-10T21:00:34.625Z",[66,122,67,110],77,"数据泄露","BleepingComputer","w4i7n11q7jgyy4p2xh92mfdcb","Microsoft 11月补丁修复1,090个漏洞，CVE-2026-124194已遭利用","Microsoft 11月补丁共修复约1,090个漏洞，其中CVE-2026-124194已遭利用；该Outlook欺骗漏洞需用户打开特制消息文件，可泄露NTLMv2哈希并用于冒充用户。","原文汇总Microsoft补丁中的已利用漏洞、零点击RCE与30个潜在蠕虫漏洞，并指出部分公告细节不足。",{"_71":137},"2026-11-11T09:03:48.000Z","2026-11-11T10:08:41.289Z","vuln",[134,135,136,85,84],82,"补丁","在野利用","漏洞分析","Security Affairs","q62rs7r8pongzx30vtu5q3hx7","美国政府中断 North Korean FaceStealer 活动，查获超 4 亿美元加密资产盗取","美国政府查获基础设施并中断 North Korean 社会工程活动 FaceStealer，该活动持续 18 个月，针对加密货币、Web3 行业及开源开发者，盗取超过 $400 million 加密资产。","文章还原了 FaceStealer 如何借深伪视频、ClickFix 和恶意更新窃取加密资产及账户凭据，并给出可迁移的会议安全建议。",{"_71":123},"2026-11-14T15:15:49.000Z","2026-11-14T15:52:27.809Z",[66,82,67,68,146,110,99],"供应链投毒","fcygdwsq0sdizweg2my9t8a2n","TGR-STA-0049以HTTP/3 RAT攻击东南亚政府机构并窃取敏感数据","Unit 42 发现 TGR-STA-0049 至少自 2025 年 7 月起针对东南亚政府机构的网络间谍活动，攻击者利用未修补的 Microsoft Exchange 服务器和 Web 服务器部署 Web Shell，并通过伪装成政府文件的 PDF 投递 PerfectPioneer RAT。","原文还原了攻击链、两类RAT的模块化架构与QUIC通信特征，并提供凭据窃取、邮件越权和横向移动细节，可用于比对检测与狩猎思路。",{"_71":158},"2026-11-16T23:00:55.000Z","2026-11-17T00:04:15.077Z",[66,82,83,67,122,155,156,85,157],"红队","Palo Alto","Google","Unit 42","vk1sqw9r2vpu5keky20h61mo3","Microsoft 365 全球中断期间出现高量级协同钓鱼活动","Microsoft 确认全球出现一场利用 Microsoft 365 服务中断实施的高量级协同钓鱼活动，邮件冒充服务健康通知，诱导用户点击恶意链接并提交凭据。服务中断于 November 12 11.20 EST 开始，持续超过 22 小时，November 13 23.15 EST 全面恢复。","邮件以24小时删除期限制造紧迫感，并给出发送域名、链接域名和处置步骤，便于防守团队回溯与处置。",{"_71":168},"2026-11-17T13:00:00.000Z","2026-11-17T13:15:33.590Z",[66,67,110,85,84],70,"Infosecurity Magazine","f8ncv2a1cko0q6hhiockby3pz","Microsoft 揭示设备码钓鱼对 GitHub Copilot CLI 代理的四类影响","Microsoft 以 GitHub Copilot CLI 为例说明，攻击者诱使用户批准设备码授权后，可在实验环境中远程操控已启用远程控制的会话、植入误导性记忆、读取云同步会话及访问私有仓库。","受控实验揭示了设备码钓鱼接入 AI 编程代理后的四类风险，并给出可落地的检测、处置和权限收敛方法。",{"_71":182},"2026-11-17T15:00:00.000Z","2026-11-17T17:20:32.997Z","ai-security",[69,178,179,180,67,181,85,157],"Agent 安全","技术研究","复现","检测工程","Microsoft Security Blog","x0nfqulcxfxxefb4ym9510pen","Trigram 冒充约 50 个 AI 与区块链品牌，用信息窃取器攻击开发者","Trigram 冒充欧洲和美国约 50 个 AI、区块链品牌，以招聘、会议邀请和包裹追踪场景诱导开发者执行信息窃取器，并借助被篡改的代码仓库实施软件供应链入侵。","文章串联招聘、会议邀请、代码仓库劫持等入口，展示了攻击链、目标筛选及失陷数据流转方式。",{"_71":192},"2026-11-17T15:17:28.000Z","2026-11-17T19:31:32.155Z",[66,82,67,68,146,155,157,85,191],"Apple","The Hacker News","wirnox4qkgxmb80632xwozft4","乌克兰与 FBI 逮捕勒索组织成员，涉及逾 $40.5M 赎金","乌克兰执法部门与 FBI 逮捕 4 名国际勒索组织疑似成员，该组织至少涉及全球 28 家企业、逾 $40.5M 赎金支付。调查历时两年，团伙至少有 27 人，并与覆盖 8 个司法辖区、60 余人的网络有关联。","案件揭示了勒索组织利用 AI 语音冒充 IT 支持、钓鱼页面窃取凭据和远程访问工具入侵企业的完整流程。",{"_71":123},"2026-11-18T23:08:33.000Z","2026-11-18T23:15:32.954Z",[66,202,82,122,67,203],74,"勒索","AI 攻防","cc7qsurqjcbzxqury8oid8a18","Rakuten Securities 数据泄露或影响近 1600 万个账户","Rakuten Securities 表示，11 月 11 日测试环境中的部分信息被泄露至外部，4.47 million 个账户的资料被窃取，另有 11.25 million 个账户仅被窃取分支或客户代码及登录 ID，合计接近 16 million 人。","事件揭示测试环境泄露与后续钓鱼风险之间的关联，并为金融机构隔离敏感数据及强化抗钓鱼登录提供参考。",{"_71":168},"2026-11-19T09:20:00.000Z","2026-11-19T09:59:06.573Z",[66,122,67,212],"身份与访问","otlmhixhsya3dvwx5u2d3qxx2","俄罗斯间谍组织 COLD RELIC 利用云端入侵冒充员工钓鱼后续目标","Google Threat Intelligence Group 披露，俄罗斯网络间谍组织 COLD RELIC 利用已窃取的云端账户和员工资料，冒充受害者组织人员，通过钓鱼链接攻击欧洲和北美政府官员、国防承包商及 NGO。","文章还原了云端身份滥用与熟人冒充相结合的攻击链，并指出仅重置密码无法撤销已劫持会话。",{"_71":72},"2026-11-19T14:42:20.000Z","2026-11-19T15:17:19.674Z",[66,67,83,110,222,157,223],80,"云原生","CISA","d6dgg3e2wnqye3hjidrccizxr","Transport for London 数据泄露事件或影响约 265,000 名 Oyster photocard 用户","Transport for London 称，约 265,000 名 Oyster photocard 客户的姓名、电话、邮箱、住址、出生日期及安全问题和答案可能因系统入侵而泄露，密码、银行和支付卡资料等信息暂未发现被攻破。","事件涉及约265,000名Oyster photocard客户，泄露字段可被用于账户恢复，相关客户需要同步更新其他服务中的复用密码与安全问题。",{"_71":123},"2026-11-19T18:20:01.000Z","2026-11-19T18:49:19.482Z",[66,122,67,212,233],71,"应急响应","hvmdf2b2hvm47t3sscn2okaod","eml_parser v3.0.3 存在 Received 头解析 ReDoS 漏洞，复杂度达 O(n^4)","eml_parser v3.0.3 的 `Received` 头解析存在算法复杂度漏洞，攻击者可通过构造日期尾部包含不平衡 `(` 的标头触发四层贪婪正则回溯。","文章完整拆解了 O(n^4) 回溯的根因与触发条件，并用不同长度的邮件给出实测和 PoC，修复前后复杂度变化也便于评估处置价值。",{"_71":243},"2026-11-19T22:47:08.000Z","2026-11-19T22:59:19.978Z",[242,180,134,136,84],"漏洞","GitHub 安全公告","a5t4y4pmj5g2r43vgy8qp8hnx","“银狐”网络攻击活动利用VPN客户端安装包传播Windows木马","国家计算机病毒应急处理中心连续发现多个面向Windows用户的恶意VPN客户端软件安装包，感染后会分阶段释放载荷并加载远程控制功能。攻击者通过搜索引擎结果投毒推广钓鱼网站，诱导下载含木马的“免费VPN”“VPN加速”等安装包；感染后可能冒充用户联系亲友实施诈骗，并可能投送勒索病毒。网络管理员可依据附件1特征开展针对性排查，来源不明文件可在国家计算机病毒协同分析平台检测。","报告揭示了“银狐”借搜索引擎投毒和虚假VPN安装包传播木马的手法，并提供针对性排查与检测建议。",{"_71":100},"2026-11-20T01:16:36.512Z","2026-11-20T03:16:36.517Z",[66,82,68,67,97],78,"nzpbt56ivpfcejp2mk6oqnujs","Microsoft Outlook 欺骗漏洞 CVE-2026-124194 已复现并遭在野利用","Microsoft Outlook 欺骗漏洞 CVE-2026-124194 已遭在野利用，攻击者可投递特制 .ics 日历文件诱使用户打开或导入，借此向攻击者控制的网络位置发起认证并泄露当前用户的 NTLMv2 响应；利用可远程触发，无需权限，但需要用户配合。","文章给出可复现的 .ics 触发链、已捕获的在野利用行为及出站 SMB 缓解措施，便于评估凭据泄露风险并安排处置。",{"_71":262},"2026-11-19T17:06:00.000Z","2026-11-20T15:21:30.821Z",[242,135,180,134,84,85],84,"微步在线研究响应中心","y1q31smahyra1wu2i286xr7ey","Unit 42披露Com关联组织以语音钓鱼窃取数据并实施勒索","Unit 42追踪到Bling Libra及多个Com关联活动簇通过语音钓鱼和AiTM页面窃取凭据与MFA批准，随后借助原生云工具、脚本和恶意浏览器扩展定位高价值数据、批量外传并发送勒索信息。","材料结合遥测与事件响应还原了多组关联活动簇的入侵链、受害行业变化及恶意扩展能力，便于比较其数据窃取手法。",{"_71":158},"2026-11-20T22:00:25.000Z","2026-11-20T22:34:32.487Z",[66,82,67,122,202,212,156,157,85],81,"lwn1awdsmrazlhsmt4r21vq0w","Microsoft Entra Connect Health 漏洞遭利用，租户数据被未授权访问","攻击者利用 Microsoft Entra Connect Health API 漏洞，未授权读取租户级元数据，并可能修改 Connect Health 监控配置。","事件提供了暴露数据类型、修复时间与客户无需更新的处置边界，也指出钓鱼风险和日志排查方向，便于受影响组织核对风险。",{"_71":123},"2026-11-21T18:01:58.000Z","2026-11-21T18:05:45.021Z",[66,135,122,85,212,67],"slug","email","邮件与钓鱼","group","field","definition","钓鱼基础设施、恶意邮件与邮件系统的漏洞。","brand","total",55,"recent",39,"indexable","latest",{"_43":273,"_299":278},"groupName","技术方向","poolTotal",208,"at",{"_301":302,"_303":-5},"changelogVersion","2026-10-01T08:00","release"]
