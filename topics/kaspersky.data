[{"_1":2,"_3":4},"root",{"_5":106},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795739817000,{"_81":82,"_54":83,"_84":85,"_86":87,"_88":89,"_90":91,"_92":91,"_93":94,"_95":96,"_97":98,"_99":100},"modules",{},"items",[20,21,22],"page",1,"pageCount","pageSize",20,{"_23":70,"_25":71,"_27":72,"_29":73,"_31":74,"_33":75,"_35":76,"_37":38,"_39":77,"_41":78,"_43":44,"_45":46,"_47":-5},{"_23":56,"_25":57,"_27":58,"_29":59,"_31":60,"_33":61,"_35":62,"_37":38,"_39":63,"_41":64,"_43":44,"_45":46,"_47":-5},{"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":-5},"id","cevbx7jl1s7kf33jdyfyivlt2","title","Telegram Widgets 疑遭 RCE 利用并投放 WebRAT，Windows 客户端补丁后仍被指出存在漏洞","summary","Kaspersky 怀疑 Telegram 新推出的 Widgets 漏洞已被用于投放 WebRAT（Salat Stealer），受害者访问特定 Telegram 频道后会在不知情下运行 PowerShell 脚本并启动该 Rust 木马，可远程控制系统并窃取加密货币钱包及 Telegram 账户数据。","reason","文章串联了 RCE 演示、补丁争议与疑似在野利用，并指出快速发布组件扩大攻击面的风险。","source",{"_54":55},"publishedAt","2026-11-16T12:48:03.000Z","timelineAt","2026-11-16T13:39:14.376Z","category","activity","tags",[48,49,50,51,52,53],"score",72,"selected",true,"channel","news","x","在野利用","漏洞利用","恶意软件","数据窃取","移动端","Kaspersky","name","SecurityWeek","gs8rcycdyebhht60u2ulltq7n","Kaspersky 披露 Operation ShadowCloud 利用 GitHub 和 SharePoint 部署 GitDoor、GraphDoor 后门","Kaspersky 披露 Operation ShadowCloud 在亚洲和非洲政府部门开展的网络入侵活动，利用合法 MeshAgent 植入此前未记录的 GitDoor 和 GraphDoor 后门，并通过 GitHub、Microsoft SharePoint 和 Ably 隐藏 C2 流量、动态下载插件和内存 shellcode。","材料拆解了攻击链、两种后门的通信与载荷机制，并列出可用于识别活动线索的路径、仓库和配置。",{"_54":69},"2026-11-17T11:20:18.000Z","2026-11-17T12:11:31.702Z",[65,66,50,67,68,51,53],77,"攻击活动","后门","Microsoft","Google","The Hacker News","en1gv0ci3e610k5ce0nrbau25","Kaspersky 发现 Keenadu 后门预装于超过 220,000 台 Android 设备","Kaspersky 在前 10 个月内于超过 220,000 台 Android 设备中发现 Keenadu；它与 Triada 合计出现在今年检出预装恶意软件设备的 88% 中。","文章拆解了预装恶意软件的供应链入侵路径、潜伏与模块化机制，并提供企业采购前的样本测试建议。",{"_54":80},"2026-11-26T12:57:58.000Z","2026-11-26T12:59:19.480Z",[50,66,79,52,53,51],75,"供应链投毒","Help Net Security","slug","kaspersky","Kaspersky / Securelist","group","company","definition","Securelist 的 APT 研究、恶意软件分析与漏洞技术分析。","brand",{"_102":-5,"_103":104,"_105":94},"total",3,"recent","indexable",false,"latest",{"_25":71,"_101":76},"groupName","厂商与机构","poolTotal",8,"at","src","monogram","K","raster",{"_107":108,"_109":-5},"changelogVersion","2026-10-01T08:00","release"]
