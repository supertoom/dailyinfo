[{"_1":2,"_3":4},"root",{"_5":94},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795307809000,{"_69":70,"_53":71,"_72":73,"_74":75,"_76":77,"_78":79,"_80":79,"_81":82,"_83":84,"_85":86,"_87":88},"modules",{},"items",[20,21],"page",1,"pageCount","pageSize",20,{"_22":55,"_24":56,"_26":57,"_28":58,"_30":59,"_32":60,"_34":61,"_36":37,"_38":62,"_40":63,"_42":43,"_44":45,"_46":-5},{"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":-5},"id","cevbx7jl1s7kf33jdyfyivlt2","title","Telegram Widgets 疑遭 RCE 利用并投放 WebRAT，Windows 客户端补丁后仍被指出存在漏洞","summary","Kaspersky 怀疑 Telegram 新推出的 Widgets 漏洞已被用于投放 WebRAT（Salat Stealer），受害者访问特定 Telegram 频道后会在不知情下运行 PowerShell 脚本并启动该 Rust 木马，可远程控制系统并窃取加密货币钱包及 Telegram 账户数据。","reason","文章串联了 RCE 演示、补丁争议与疑似在野利用，并指出快速发布组件扩大攻击面的风险。","source",{"_53":54},"publishedAt","2026-11-16T12:48:03.000Z","timelineAt","2026-11-16T13:39:14.376Z","category","activity","tags",[47,48,49,50,51,52],"score",72,"selected",true,"channel","news","x","在野利用","漏洞利用","恶意软件","数据窃取","移动端","Kaspersky","name","SecurityWeek","gs8rcycdyebhht60u2ulltq7n","Kaspersky 披露 Operation ShadowCloud 利用 GitHub 和 SharePoint 部署 GitDoor、GraphDoor 后门","Kaspersky 披露 Operation ShadowCloud 在亚洲和非洲政府部门开展的网络入侵活动，利用合法 MeshAgent 植入此前未记录的 GitDoor 和 GraphDoor 后门，并通过 GitHub、Microsoft SharePoint 和 Ably 隐藏 C2 流量、动态下载插件和内存 shellcode。","材料拆解了攻击链、两种后门的通信与载荷机制，并列出可用于识别活动线索的路径、仓库和配置。",{"_53":68},"2026-11-17T11:20:18.000Z","2026-11-17T12:11:31.702Z",[64,65,49,66,67,50,52],77,"攻击活动","后门","Microsoft","Google","The Hacker News","slug","kaspersky","Kaspersky / Securelist","group","company","definition","Securelist 的 APT 研究、恶意软件分析与漏洞技术分析。","brand",{"_90":-5,"_91":92,"_93":82},"total",2,"recent","indexable",false,"latest",{"_24":56,"_89":61},"groupName","厂商与机构","poolTotal",7,"at","src","monogram","K","raster",{"_95":96,"_97":-5},"changelogVersion","2026-10-01T08:00","release"]
