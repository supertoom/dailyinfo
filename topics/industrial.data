[{"_1":2,"_3":4},"root",{"_5":123},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1793590950000,{"_102":103,"_55":104,"_105":106,"_107":108,"_109":-5,"_110":111,"_112":113,"_114":115,"_116":117,"_118":119,"_120":121},"modules",{},"items",[20,21,22,23,24],"page",1,"pageCount","pageSize",20,{"_25":94,"_27":95,"_29":96,"_31":97,"_33":98,"_35":99,"_37":99,"_38":88,"_40":100,"_42":101,"_44":45,"_46":47,"_48":-5},{"_25":82,"_27":83,"_29":84,"_31":85,"_33":86,"_35":87,"_37":87,"_38":88,"_40":89,"_42":90,"_44":45,"_46":47,"_48":-5},{"_25":73,"_27":74,"_29":75,"_31":76,"_33":77,"_35":78,"_37":78,"_38":63,"_40":79,"_42":80,"_44":45,"_46":47,"_48":-5},{"_25":57,"_27":58,"_29":59,"_31":60,"_33":61,"_35":62,"_37":62,"_38":63,"_40":64,"_42":65,"_44":45,"_46":47,"_48":-5},{"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":36,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47,"_48":-5},"id","ffo5olgkbj49chyuww62eaeg9","title","CERT-FR 发布法国能源与水务工业控制系统安全加固建议","summary","CERT-FR 面向法国能源与水务领域的生产商、集成商和安装商发布工业控制系统安全加固建议，指出管理接口暴露、未设认证或使用默认口令等风险。措施包括按源 IP 过滤连接、通过 VPN IPsec 或 VPN TLS 接入、替换默认凭据并启用多因素认证、及时安装补丁，以及使用持续维护且采用 TLS 或 SSH 的远程访问软件。","reason","这份通告针对能源与水务工业控制系统的暴露接口，给出可执行的加固措施及疑似失陷时的处置路径。","source",{"_55":56},"publishedAt","2026-01-22T00:00:00.000Z","timelineAt","category","blue-team","tags",[49,50,51,52,53,54],"score",76,"selected",true,"channel","news","x","蓝队","加固","应急响应","工控","身份与访问","漏洞管理","name","CERT-FR","qz2gqncn5w1yb25zepkyw9hap","Danfoss 制冷控制器遭批量篡改，法国数百家超市冷藏设备升至 50C","攻击者利用 Danfoss AK-SM 和 AK-SC 系统管理器的日期型登录绕过进入设备，将除霜加热持续开启并关闭告警，10月11日夜间令法国数百家超市的冷藏设备升至 50C，造成食品变质、设备起火及数千万欧元损失。","文章还原了从日期型登录绕过到批量篡改除霜参数的攻击链，并说明暴露管理接口与旧固件如何放大影响。",{"_55":72},"2026-10-14T12:19:56.000Z","activity",[66,67,68,52,69,70,71],96,"攻击活动","在野利用","IoT","漏洞利用","技术研究","CISA","Pen Test Partners","ai0102aat8tm3u8fem12xdmof","法国数百家超市制冷系统遭远程攻击，冷柜被加热至50℃","法国数百家超市的 Danfoss 制冷控制系统遭远程攻击，攻击者篡改除霜逻辑并将温度设为50℃，导致部分门店生鲜和冷冻食品报废。家乐福称旗下80家超市受影响，Les Mousquetaires 约150家门店的冰箱持续六小时被加热，比利时和荷兰部分门店也受牵连。","文章结合超市冷柜被加热事件，梳理联网 OT 控制器的暴露风险及可迁移的资产测绘、权限收紧与隔离措施。",{"_55":81},"2026-10-19T03:56:12.000Z",[66,52,68],83,"安全客","h43p62dheb2cwq6m4x31xk3xa","Siemens APOGEE、TALON 和 Desigo PXC/PXM 产品曝出 5 个漏洞","Siemens APOGEE、TALON 和 Desigo PXC/PXM 产品存在 CVE-2026-89208、CVE-2026-102073、CVE-2026-102074、CVE-2026-102075、CVE-2026-102076，未认证远程攻击者可读取越界内存或导致拒绝服务。","公告同时列出多组漏洞、CVSS 评分、受影响版本及部分产品的修复状态，便于工控系统运营方核对资产并安排处置。",{"_55":93},"2026-10-22T12:00:00.000Z","vuln",[91,92,52,71,50],63,"漏洞","补丁","CISA 安全公告","jpwndhpgkojx1rgfz3f11pv7d","EPICS Base <=7.0.10 曝远程代码执行等 4 个漏洞，CVE-2026-114595 至 CVE-2026-114598","EPICS Base <=7.0.10 受 CVE-2026-114595、CVE-2026-114596、CVE-2026-114597、CVE-2026-114598 影响，成功利用可能造成拒绝服务、内存损坏、敏感信息泄露或远程代码执行，且无需认证和用户交互。受影响用户应升级至 7.0.11，CISA 同时建议将控制设备与互联网隔离并部署分层防御；目前未收到针对这些漏洞的公开利用报告。","公告集中列出 EPICS Base 四个漏洞的受影响版本、影响类型和修复版本，可用于核对控制系统暴露面与升级需求。",{"_55":93},"2026-10-27T12:00:00.000Z",[91,92,52,71],72,"slug","industrial","工业控制","group","field","definition","工控系统、SCADA 与工业设备的漏洞与暴露风险。","brand","total",5,"recent",4,"indexable",false,"latest",{"_27":95,"_122":99},"groupName","技术方向","poolTotal",17,"at",{"_124":125,"_126":-5},"changelogVersion","2026-10-01T08:00","release"]
