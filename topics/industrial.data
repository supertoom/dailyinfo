[{"_1":2,"_3":4},"root",{"_5":135},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1793667394000,{"_114":115,"_56":116,"_117":118,"_119":120,"_121":-5,"_122":123,"_124":125,"_126":127,"_128":129,"_130":131,"_132":133},"modules",{},"items",[20,21,22,23,24,25],"page",1,"pageCount","pageSize",20,{"_26":103,"_28":104,"_30":105,"_32":106,"_34":107,"_36":108,"_38":109,"_39":64,"_41":110,"_43":111,"_45":46,"_47":48,"_49":-5},{"_26":95,"_28":96,"_30":97,"_32":98,"_34":99,"_36":100,"_38":100,"_39":89,"_41":101,"_43":102,"_45":46,"_47":48,"_49":-5},{"_26":83,"_28":84,"_30":85,"_32":86,"_34":87,"_36":88,"_38":88,"_39":89,"_41":90,"_43":91,"_45":46,"_47":48,"_49":-5},{"_26":74,"_28":75,"_30":76,"_32":77,"_34":78,"_36":79,"_38":79,"_39":64,"_41":80,"_43":81,"_45":46,"_47":48,"_49":-5},{"_26":58,"_28":59,"_30":60,"_32":61,"_34":62,"_36":63,"_38":63,"_39":64,"_41":65,"_43":66,"_45":46,"_47":48,"_49":-5},{"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":37,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48,"_49":-5},"id","ffo5olgkbj49chyuww62eaeg9","title","CERT-FR 发布法国能源与水务工业控制系统安全加固建议","summary","CERT-FR 面向法国能源与水务领域的生产商、集成商和安装商发布工业控制系统安全加固建议，指出管理接口暴露、未设认证或使用默认口令等风险。措施包括按源 IP 过滤连接、通过 VPN IPsec 或 VPN TLS 接入、替换默认凭据并启用多因素认证、及时安装补丁，以及使用持续维护且采用 TLS 或 SSH 的远程访问软件。","reason","这份通告针对能源与水务工业控制系统的暴露接口，给出可执行的加固措施及疑似失陷时的处置路径。","source",{"_56":57},"publishedAt","2026-01-22T00:00:00.000Z","timelineAt","category","blue-team","tags",[50,51,52,53,54,55],"score",76,"selected",true,"channel","news","x","蓝队","加固","应急响应","工控","身份与访问","漏洞管理","name","CERT-FR","qz2gqncn5w1yb25zepkyw9hap","Danfoss 制冷控制器遭批量篡改，法国数百家超市冷藏设备升至 50C","攻击者利用 Danfoss AK-SM 和 AK-SC 系统管理器的日期型登录绕过进入设备，将除霜加热持续开启并关闭告警，10月11日夜间令法国数百家超市的冷藏设备升至 50C，造成食品变质、设备起火及数千万欧元损失。","文章还原了从日期型登录绕过到批量篡改除霜参数的攻击链，并说明暴露管理接口与旧固件如何放大影响。",{"_56":73},"2026-10-14T12:19:56.000Z","activity",[67,68,69,53,70,71,72],96,"攻击活动","在野利用","IoT","漏洞利用","技术研究","CISA","Pen Test Partners","ai0102aat8tm3u8fem12xdmof","法国数百家超市制冷系统遭远程攻击，冷柜被加热至50℃","法国数百家超市的 Danfoss 制冷控制系统遭远程攻击，攻击者篡改除霜逻辑并将温度设为50℃，导致部分门店生鲜和冷冻食品报废。家乐福称旗下80家超市受影响，Les Mousquetaires 约150家门店的冰箱持续六小时被加热，比利时和荷兰部分门店也受牵连。","文章结合超市冷柜被加热事件，梳理联网 OT 控制器的暴露风险及可迁移的资产测绘、权限收紧与隔离措施。",{"_56":82},"2026-10-19T03:56:12.000Z",[67,53,69],83,"安全客","h43p62dheb2cwq6m4x31xk3xa","Siemens APOGEE、TALON 和 Desigo PXC/PXM 产品曝出 5 个漏洞","Siemens APOGEE、TALON 和 Desigo PXC/PXM 产品存在 CVE-2026-89208、CVE-2026-102073、CVE-2026-102074、CVE-2026-102075、CVE-2026-102076，未认证远程攻击者可读取越界内存或导致拒绝服务。","公告同时列出多组漏洞、CVSS 评分、受影响版本及部分产品的修复状态，便于工控系统运营方核对资产并安排处置。",{"_56":94},"2026-10-22T12:00:00.000Z","vuln",[92,93,53,72,51],63,"漏洞","补丁","CISA 安全公告","jpwndhpgkojx1rgfz3f11pv7d","EPICS Base <=7.0.10 曝远程代码执行等 4 个漏洞，CVE-2026-114595 至 CVE-2026-114598","EPICS Base <=7.0.10 受 CVE-2026-114595、CVE-2026-114596、CVE-2026-114597、CVE-2026-114598 影响，成功利用可能造成拒绝服务、内存损坏、敏感信息泄露或远程代码执行，且无需认证和用户交互。受影响用户应升级至 7.0.11，CISA 同时建议将控制设备与互联网隔离并部署分层防御；目前未收到针对这些漏洞的公开利用报告。","公告集中列出 EPICS Base 四个漏洞的受影响版本、影响类型和修复版本，可用于核对控制系统暴露面与升级需求。",{"_56":94},"2026-10-27T12:00:00.000Z",[92,93,53,72],72,"c8c3sczng53jdb0j9x5vqc0ry","欧洲多国逾115家超市制冷系统遭攻击，门店被迫处置变质商品","攻击者远程修改欧洲多国超市冷柜和制冷系统的温度设置、关闭制冷设备或启动除霜，导致超过115家门店受到影响，并造成商品损失和提前营业干预。","材料梳理了多国超市制冷系统遭远程操控的规模、受影响门店及处置方式，并指出攻击可能复用法国同类事件中的漏洞。",{"_56":113},"2026-11-02T14:28:39.000Z","2026-11-02T15:00:33.056Z",[67,69,70,112,53],82,"供应链","BleepingComputer","slug","industrial","工业控制","group","field","definition","工控系统、SCADA 与工业设备的漏洞与暴露风险。","brand","total",6,"recent",5,"indexable",false,"latest",{"_28":104,"_134":109},"groupName","技术方向","poolTotal",19,"at",{"_136":137,"_138":-5},"changelogVersion","2026-10-01T08:00","release"]
