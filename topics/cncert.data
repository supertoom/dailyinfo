[{"_1":2,"_3":4},"root",{"_5":139},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1794443864000,{"_114":115,"_56":55,"_116":117,"_118":119,"_120":121,"_122":123,"_124":125,"_126":127,"_128":129,"_130":131,"_132":133},"modules",{},"items",[20,21,22,23,24,25],"page",1,"pageCount","pageSize",20,{"_26":103,"_28":104,"_30":105,"_32":106,"_34":107,"_36":108,"_38":109,"_39":40,"_41":110,"_43":111,"_45":46,"_47":48,"_49":-5},{"_26":90,"_28":91,"_30":92,"_32":93,"_34":94,"_36":95,"_38":96,"_39":40,"_41":97,"_43":98,"_45":46,"_47":48,"_49":-5},{"_26":78,"_28":79,"_30":80,"_32":81,"_34":82,"_36":83,"_38":83,"_39":40,"_41":84,"_43":85,"_45":46,"_47":48,"_49":-5},{"_26":68,"_28":69,"_30":70,"_32":71,"_34":72,"_36":73,"_38":73,"_39":40,"_41":74,"_43":75,"_45":46,"_47":48,"_49":-5},{"_26":58,"_28":59,"_30":60,"_32":61,"_34":62,"_36":63,"_38":63,"_39":40,"_41":64,"_43":65,"_45":46,"_47":48,"_49":-5},{"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":37,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48,"_49":-5},"id","j4y79osk2rq3egsdy6dlbeawm","title","“荐片播放器”内置后门传播，境内已感染700,260台设备","summary","国家互联网应急中心（CNCERT）监测发现，“荐片播放器”Windows端应用程序内置后门，可采集终端信息、静默安装第三方软件并通过双通道执行服务端脚本。2026年9月15日至22日累计监测到700,260台设备感染，日上线受控终端最高达251,880台；报告建议排查注册表、服务、可疑模块、临时文件和通信 IOC，处置后将终端视为受控主机并重装系统。","reason","报告拆解了双通道脚本执行、进程注入与持久化机制，并提供感染规模和 IOC，适合用于终端排查与规则建设。","source",{"_56":57},"publishedAt","2026-10-09T08:45:00.000Z","timelineAt","category","activity","tags",[50,51,52,53,54,55],"score",82,"selected",true,"channel","news","x","恶意软件","后门","攻击活动","逆向","数据窃取","CNCERT","name","国家互联网应急中心CNCERT","fcen794rgtyxtpia3mid16bom","CNCERT 披露“银狐”木马 TOP 10 恶意域名及恶意 IP","CNCERT 披露“银狐”黑产团伙用于控制端的 TOP 10 恶意 IP 和关联域名，并给出日控制规模。该团伙通过仿冒软件下载站、搜索引擎恶意推广、钓鱼邮件及即时通信传播 Gh0st、Win0s、DcRat 等远程控制木马，可执行文件下发、命令执行、屏幕监控、键盘记录和敏感信息窃取。","内容列出“银狐”木马控制端的 TOP 10 恶意网络资产及排查处置方法，可用于识别相关域名、IP 与感染终端。",{"_56":57},"2026-10-14T02:31:00.000Z",[52,50,54,66,67,55],60,"钓鱼","蓝队","h7fhanhqb9pzuegm5u9my4w2d","CNCERT 调查 AS 402425 篡改 DNS 解析数据攻击","攻击者利用中国境外自治域 AS 402425，发布虚假路由劫持中国境内部分流量，并将 DNS 解析值修改为博彩网站地址或指向返回博彩网站地址的恶意 DNS 服务器。技术测量确认域名篡改发生于 AS 402425 内，CNCERT 建议相关机构核查并注销恶意 AS 资源，运营商配置路由过滤，平台监测 DNS 与路由异常。","报告披露了攻击者利用恶意自治域劫持流量并篡改DNS解析数据的完整链路，可用于理解此类跨网络域名劫持活动。",{"_56":57},"2026-10-20T04:34:00.000Z",[52,76,77,55],77,"网络设备","红队","w9dgr8uz1ba3eekgpx4jg06r3","CNCERT深入分析银狐“镜昙（G02）”木马攻击活动","CNCERT监测到银狐新分支“镜昙”利用SEO投毒、仿冒软件下载站和第三方对象存储传播恶意镜像，主要针对金融财务、银行、税务领域的中文用户。该团伙采用白加黑、配置三重混淆、镜像载荷和定制失活时间机制，支持远控、键盘记录及插件加载；2026年7月17日至10月20日累计控制设备5834台，单日上线被控客户端最高252台，C2日访问峰值727802次。","报告梳理了银狐“镜昙”团伙从SEO投毒、仿冒软件下载站到载荷执行和C2通信的完整链路，并给出控制规模与可落地的排查方向。",{"_56":57},"2026-10-23T10:34:00.000Z",[52,50,51,66,54,86,55,87,88,89],79,"技术研究","阿里","腾讯","AWS","sadp3rc08vj8hs3yc7r72lm24","CNCERT披露VeilDHT僵尸网络大范围感染Linux服务器与IoT设备","国家互联网应急中心（CNCERT）监测发现VeilDHT僵尸网络正通过漏洞利用大范围传播，主要感染Linux服务器与IoT设备。2026年10月16日至10月26日期间，我国境内累计40467台设备受感染，境内日上线肉鸡数最高达15805台。","原文梳理了VeilDHT的双通道控制机制、加密通信、攻击能力与40467台感染规模，便于识别该僵尸网络的传播和防护重点。",{"_56":102},"2026-11-02T09:49:00.000Z","2026-11-02T11:46:32.053Z",[52,50,99,100,101,55],83,"僵尸网络","漏洞利用","IoT","安全内参","vf2fadfkovuwc9eyk4jilfa6l","CNCERT披露“银狐”木马“金钩（G03）”团伙攻击同花顺仿冒下载站","国家互联网应急中心（CNCERT）与北京观成科技有限公司分析“银狐”木马“金钩（G03）”团伙针对同花顺仿冒下载站的活动。该团伙通过SEO投毒传播捆绑木马的THS.zip，以多阶段内存加载植入远控模块，支持屏幕截图、键盘记录、远程命令执行、插件下发和信息窃取。","报告还原了仿冒同花顺传播链、内存加载流程和通信协议，并提供控制规模与 IOC，便于理解银狐团伙的运营方式。",{"_56":102},"2026-11-10T09:12:00.000Z","2026-11-10T11:46:19.465Z",[52,50,66,51,54,112,55,113,89],85,"供应链","Cloudflare","slug","cncert","group","company","definition","国家互联网应急中心的木马专项、攻击态势分析与修复风险提示。","brand",{"_135":-5,"_136":137,"_138":127},"total",6,"recent",5,"indexable",false,"latest",{"_28":104,"_134":109},"groupName","厂商与机构","poolTotal",15,"at","src","monogram","C","raster",{"_140":141,"_142":-5},"changelogVersion","2026-10-01T08:00","release"]
