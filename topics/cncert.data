[{"_1":2,"_3":4},"root",{"_5":124},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1793590950000,{"_100":101,"_55":54,"_102":103,"_104":105,"_106":107,"_108":109,"_110":109,"_111":112,"_113":114,"_115":116,"_117":118},"modules",{},"items",[20,21,22,23,24],"page",1,"pageCount","pageSize",20,{"_25":89,"_27":90,"_29":91,"_31":92,"_33":93,"_35":94,"_37":95,"_38":39,"_40":96,"_42":43,"_44":45,"_46":47,"_48":-5},{"_25":77,"_27":78,"_29":79,"_31":80,"_33":81,"_35":82,"_37":82,"_38":39,"_40":83,"_42":84,"_44":45,"_46":47,"_48":-5},{"_25":67,"_27":68,"_29":69,"_31":70,"_33":71,"_35":72,"_37":72,"_38":39,"_40":73,"_42":74,"_44":45,"_46":47,"_48":-5},{"_25":57,"_27":58,"_29":59,"_31":60,"_33":61,"_35":62,"_37":62,"_38":39,"_40":63,"_42":64,"_44":45,"_46":47,"_48":-5},{"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":36,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47,"_48":-5},"id","j4y79osk2rq3egsdy6dlbeawm","title","“荐片播放器”内置后门传播，境内已感染700,260台设备","summary","国家互联网应急中心（CNCERT）监测发现，“荐片播放器”Windows端应用程序内置后门，可采集终端信息、静默安装第三方软件并通过双通道执行服务端脚本。2026年9月15日至22日累计监测到700,260台设备感染，日上线受控终端最高达251,880台；报告建议排查注册表、服务、可疑模块、临时文件和通信 IOC，处置后将终端视为受控主机并重装系统。","reason","报告拆解了双通道脚本执行、进程注入与持久化机制，并提供感染规模和 IOC，适合用于终端排查与规则建设。","source",{"_55":56},"publishedAt","2026-10-09T08:45:00.000Z","timelineAt","category","activity","tags",[49,50,51,52,53,54],"score",82,"selected",true,"channel","news","x","恶意软件","后门","攻击活动","逆向","数据窃取","CNCERT","name","国家互联网应急中心CNCERT","fcen794rgtyxtpia3mid16bom","CNCERT 披露“银狐”木马 TOP 10 恶意域名及恶意 IP","CNCERT 披露“银狐”黑产团伙用于控制端的 TOP 10 恶意 IP 和关联域名，并给出日控制规模。该团伙通过仿冒软件下载站、搜索引擎恶意推广、钓鱼邮件及即时通信传播 Gh0st、Win0s、DcRat 等远程控制木马，可执行文件下发、命令执行、屏幕监控、键盘记录和敏感信息窃取。","内容列出“银狐”木马控制端的 TOP 10 恶意网络资产及排查处置方法，可用于识别相关域名、IP 与感染终端。",{"_55":56},"2026-10-14T02:31:00.000Z",[51,49,53,65,66,54],60,"钓鱼","蓝队","h7fhanhqb9pzuegm5u9my4w2d","CNCERT 调查 AS 402425 篡改 DNS 解析数据攻击","攻击者利用中国境外自治域 AS 402425，发布虚假路由劫持中国境内部分流量，并将 DNS 解析值修改为博彩网站地址或指向返回博彩网站地址的恶意 DNS 服务器。技术测量确认域名篡改发生于 AS 402425 内，CNCERT 建议相关机构核查并注销恶意 AS 资源，运营商配置路由过滤，平台监测 DNS 与路由异常。","报告披露了攻击者利用恶意自治域劫持流量并篡改DNS解析数据的完整链路，可用于理解此类跨网络域名劫持活动。",{"_55":56},"2026-10-20T04:34:00.000Z",[51,75,76,54],77,"网络设备","红队","w9dgr8uz1ba3eekgpx4jg06r3","CNCERT深入分析银狐“镜昙（G02）”木马攻击活动","CNCERT监测到银狐新分支“镜昙”利用SEO投毒、仿冒软件下载站和第三方对象存储传播恶意镜像，主要针对金融财务、银行、税务领域的中文用户。该团伙采用白加黑、配置三重混淆、镜像载荷和定制失活时间机制，支持远控、键盘记录及插件加载；2026年7月17日至10月20日累计控制设备5834台，单日上线被控客户端最高252台，C2日访问峰值727802次。","报告梳理了银狐“镜昙”团伙从SEO投毒、仿冒软件下载站到载荷执行和C2通信的完整链路，并给出控制规模与可落地的排查方向。",{"_55":56},"2026-10-23T10:34:00.000Z",[51,49,50,65,53,85,54,86,87,88],79,"技术研究","阿里","腾讯","AWS","g1yjx90drqjyvf0az6cq04rgs","CNCERT 监测发现 VeilDHT 僵尸网络大范围感染 Linux 服务器与 IoT 设备","CNCERT 监测发现新型僵尸网络 VeilDHT 正通过漏洞利用大范围传播，主要感染 Linux 服务器与 IoT 设备，2026年10月16日至26日境内累计感染40467台，日上线肉鸡最高15805台。","材料给出了感染规模、利用漏洞、控制通道和完整 IoC，可用于识别感染链路并制定封禁与清理措施。",{"_55":56},"2026-10-30T11:59:00.000Z","2026-10-31T08:59:15.589Z",[51,97,49,98,99,54],"僵尸网络","在野利用","IoT","slug","cncert","group","company","definition","国家互联网应急中心的木马专项、攻击态势分析与修复风险提示。","brand",{"_120":-5,"_121":122,"_123":112},"total",5,"recent","indexable",false,"latest",{"_27":90,"_119":95},"groupName","厂商与机构","poolTotal",9,"at","src","monogram","C","raster",{"_125":126,"_127":-5},"changelogVersion","2026-10-01T08:00","release"]
