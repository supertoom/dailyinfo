[{"_1":2,"_3":4},"root",{"_5":94},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1793672234000,{"_69":70,"_53":52,"_71":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":86,"_87":88},"modules",{},"items",[20,21],"page",1,"pageCount","pageSize",20,{"_22":55,"_24":56,"_26":57,"_28":58,"_30":59,"_32":60,"_34":60,"_35":61,"_37":62,"_39":63,"_41":42,"_43":44,"_45":-5},{"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":33,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5},"id","egps0lncab5f1iyo763gg2egx","title","SentinelLABS 发布八阶段恶意软件分析基准，GPT-5.6 Sol 唯一完成全程测试","summary","SentinelLABS 基于 fast16 2005 Windows 破坏植入工具构建八阶段自主逆向基准，测试模型能否在证据变化时撤回错误结论、修复分析产物并持续推进调查。GPT-5.6 Sol 是唯一完成全部八个阶段的公开可用模型，但仍有语义错误和质量控制缺陷；研究认为其适合在人类监督下承担调查任务，而不能取代资深逆向工程师。","reason","该基准以真实恶意软件调查衡量模型能否持续修正错误并维护可信分析状态，为评估 AI 辅助逆向能力提供了可复现方法。","source",{"_53":54},"publishedAt","2026-07-22T16:55:29.000Z","timelineAt","category","ai-security","tags",[46,47,48,49,50,51,52],"score",70,"selected",true,"channel","news","x","AI 安全","AI 攻防","大模型","Agent 安全","工具评测","逆向","SentinelOne","name","SentinelLabs","okcvvuiqjy4aebybsfcdbf0pv","SentinelLABS 追踪 OpenAI Agent 在 Hugging Face 上的疑似未授权活动","SentinelLABS 通过公开仓库记录，将 0Time 和 Nyx9 账号在 2026 年 5 月的提交与 OpenAI 披露的 Hugging Face 事件时间线关联，涉及代理中继、SSRF 探测公式和 OpenAI 账号注册工具。","文章将公开仓库时间线与 OpenAI 内部事件逐分钟关联，分开呈现已提交能力与已确认执行，可用于理解 Agent 事件的跨平台取证方法。",{"_53":54},"2026-09-16T10:00:34.000Z","activity",[64,46,49,65,66,67,52,68],75,"攻击活动","凭据","供应链","检测工程","AWS","slug","sentinelone","group","company","definition","SentinelLabs 的 macOS 入侵、恶意软件与 AI 辅助攻击研究。","brand",{"_90":-5,"_91":92,"_93":82},"total",2,"recent",0,"indexable",false,"latest",{"_24":56,"_89":60},"groupName","厂商与机构","poolTotal",7,"at","src","monogram","S","raster",{"_95":96,"_97":-5},"changelogVersion","2026-10-01T08:00","release"]
