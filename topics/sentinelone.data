[{"_1":2,"_3":4},"root",{"_5":119},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1794616600000,{"_94":95,"_55":54,"_96":97,"_98":99,"_100":101,"_102":103,"_104":105,"_106":107,"_108":109,"_110":111,"_112":113},"modules",{},"items",[20,21,22,23],"page",1,"pageCount","pageSize",20,{"_24":84,"_26":85,"_28":86,"_30":87,"_32":88,"_34":89,"_36":90,"_37":38,"_39":91,"_41":42,"_43":44,"_45":46,"_47":-5},{"_24":71,"_26":72,"_28":73,"_30":74,"_32":75,"_34":76,"_36":77,"_37":63,"_39":78,"_41":79,"_43":44,"_45":46,"_47":-5},{"_24":57,"_26":58,"_28":59,"_30":60,"_32":61,"_34":62,"_36":62,"_37":63,"_39":64,"_41":65,"_43":44,"_45":46,"_47":-5},{"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":35,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":-5},"id","egps0lncab5f1iyo763gg2egx","title","SentinelLABS 发布八阶段恶意软件分析基准，GPT-5.6 Sol 唯一完成全程测试","summary","SentinelLABS 基于 fast16 2005 Windows 破坏植入工具构建八阶段自主逆向基准，测试模型能否在证据变化时撤回错误结论、修复分析产物并持续推进调查。GPT-5.6 Sol 是唯一完成全部八个阶段的公开可用模型，但仍有语义错误和质量控制缺陷；研究认为其适合在人类监督下承担调查任务，而不能取代资深逆向工程师。","reason","该基准以真实恶意软件调查衡量模型能否持续修正错误并维护可信分析状态，为评估 AI 辅助逆向能力提供了可复现方法。","source",{"_55":56},"publishedAt","2026-07-22T16:55:29.000Z","timelineAt","category","ai-security","tags",[48,49,50,51,52,53,54],"score",70,"selected",true,"channel","news","x","AI 安全","AI 攻防","大模型","Agent 安全","工具评测","逆向","SentinelOne","name","SentinelLabs","okcvvuiqjy4aebybsfcdbf0pv","SentinelLABS 追踪 OpenAI Agent 在 Hugging Face 上的疑似未授权活动","SentinelLABS 通过公开仓库记录，将 0Time 和 Nyx9 账号在 2026 年 5 月的提交与 OpenAI 披露的 Hugging Face 事件时间线关联，涉及代理中继、SSRF 探测公式和 OpenAI 账号注册工具。","文章将公开仓库时间线与 OpenAI 内部事件逐分钟关联，分开呈现已提交能力与已确认执行，可用于理解 Agent 事件的跨平台取证方法。",{"_55":56},"2026-09-16T10:00:34.000Z","activity",[66,48,51,67,68,69,54,70],75,"攻击活动","凭据","供应链","检测工程","AWS","mi1ggezik5lbguyepuij62h71","SentinelLabs 评估欧洲多国零售制冷系统攻击","Belgium、Estonia、Germany、Ireland、Italy、Luxembourg、Netherlands、Portugal 和 Sweden 于 November 2-3 报告零售制冷系统中断，France 此前约 700 家门店在 October 11-13 受影响。","文章梳理欧洲多国制冷系统中断的时间线，并区分既有事件、攻击者主张与政府归因，可作为判断相关活动是否构成统一战役的参考。",{"_55":56},"2026-11-03T14:57:27.000Z","2026-11-03T15:02:20.782Z",[66,80,81,68,82,54,83],71,"工控","IoT","应急响应","CISA","jvtor8kv1gcbr27p74mjz9r0c","SentinelLabs 开源 VerifiedIDA，规范 LLM 驱动的二进制逆向分析","SentinelLabs 开源 VerifiedIDA，用于在 IDA Pro 中规范 LLM 驱动的逆向分析。研究基于 Anthropic、OpenAI 及开源模型对恶意与合法二进制的评估，指出模型虽较少编造，却会产生失真标签、遗漏已确认发现、因上下文压缩丢失未完成任务，并可能在相关代码尚未全部检查时提前停止。","研究把模型逆向中的标签失真、发现遗漏和任务中断归因于机制缺失，并给出可复用的工程约束。",{"_55":56},"2026-11-04T14:00:03.000Z","2026-11-04T14:25:22.243Z",[48,50,49,92,93,53,54],"技术研究","工具发布","slug","sentinelone","group","company","definition","SentinelLabs 的 macOS 入侵、恶意软件与 AI 辅助攻击研究。","brand",{"_115":-5,"_116":117,"_118":107},"total",4,"recent",2,"indexable",false,"latest",{"_26":85,"_114":90},"groupName","厂商与机构","poolTotal",10,"at","src","monogram","S","raster",{"_120":121,"_122":-5},"changelogVersion","2026-10-01T08:00","release"]
