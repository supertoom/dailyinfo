[{"_1":2,"_3":4},"root",{"_5":105},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1793672234000,{"_80":81,"_54":52,"_82":83,"_84":85,"_86":87,"_88":89,"_90":91,"_92":93,"_94":95,"_96":97,"_98":99},"modules",{},"items",[20,21,22],"page",1,"pageCount","pageSize",20,{"_23":70,"_25":71,"_27":72,"_29":73,"_31":74,"_33":75,"_35":75,"_36":62,"_38":76,"_40":77,"_42":43,"_44":45,"_46":-5},{"_23":56,"_25":57,"_27":58,"_29":59,"_31":60,"_33":61,"_35":61,"_36":62,"_38":63,"_40":64,"_42":43,"_44":45,"_46":-5},{"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":34,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":-5},"id","yhqrl3s4u96pd0g99xk1stlii","title","知道创宇 404 实验室用 Gemini 辅助 fuzz IoT 设备 goahead 服务","summary","知道创宇 404 实验室以 Gemini cli 和 VSCode 为主要工具，对 IoT 设备的 goahead 服务开展 AI 辅助 fuzz。流程覆盖逆向分析、nvram hook、harness 与 Makefile 开发、为 QEMU 增加 ROOT_PATH 路径重定向、崩溃去重、fuzz 字典生成及逐个分析 crash。","reason","文章完整记录了 AI 参与 IoT 服务 fuzz 的工程流程，并提供 harness、QEMU 路径补丁与崩溃分析代码，方法可迁移到同类嵌入式目标测试。","source",{"_54":55},"publishedAt","2025-12-31T03:26:00.000Z","timelineAt","category","disclosure","tags",[47,48,49,50,51,52,53],"score",66,"selected",true,"channel","news","x","技术研究","复现","AI 攻防","IoT","逆向","知道创宇","Google","name","知道创宇404实验室","off0y2e4visiwwqu17s1x93rl","OpenClaw 高权限 Agent 安全风险全景分析与安全审计工具发布","知道创宇积极防御实验室系统分析 OpenClaw 的高权限 AI Agent 风险，覆盖接口认证绕过、RCE、沙箱逃逸、插件注入、间接提示词注入与凭据泄露。文中称截至 2026 年 3 月 4 日全球可识别实例为 65332 个，GitHub Advisory Database 收录 245 个漏洞，并披露 341 个恶意 skill 等公开安全事件。","文章把高权限 Agent 的接口、插件、凭据和执行边界风险串联分析，并配套开源可加载的 Security Skill 与自动审计工具，便于开发者理解具体暴露面并开展部署检查。",{"_54":55},"2026-03-06T08:04:00.000Z","ai-security",[65,66,67,68,47,69,52],80,"AI 安全","Agent 安全","模型安全","AI 供应链","工具发布","gx9vig0olytx8cjpjw9hre6hs","知道创宇发布大模型中转站研究与测评报告（2026）","知道创宇积极防御实验室对 100 个大模型中转站开展黑盒测评，以 849 个模型—中转站组合检验模型真实性、请求完整性和服务稳定性。测评发现 135 个组合实际不可用、296 个组合存在至少一项模型真实性异常证据、110 个组合出现隐藏指令注入，239 个组合存在明显延迟异常。","报告用 849 个模型—中转站组合交叉验证模型真实性、请求完整性与服务稳定性，提供了可复用的黑盒检测思路。",{"_54":55},"2026-09-20T08:04:00.000Z",[65,78,47,68,66,79,52],72,"工具评测","大模型","slug","knownsec","group","company","definition","404 实验室的漏洞审计、AI 辅助 fuzz 实战与漏洞研究。","brand",{"_101":-5,"_102":103,"_104":93},"total",3,"recent",0,"indexable",false,"latest",{"_25":71,"_100":75},"groupName","厂商与机构","poolTotal",7,"at","src","monogram","知","raster",{"_106":107,"_108":-5},"changelogVersion","2026-10-01T08:00","release"]
