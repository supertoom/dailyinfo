[{"_1":2,"_3":4},"root",{"_5":133},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1793590949000,{"_109":110,"_56":55,"_111":112,"_113":114,"_115":116,"_117":118,"_119":118,"_120":121,"_122":123,"_124":125,"_126":127},"modules",{},"items",[20,21,22,23,24],"page",1,"pageCount","pageSize",20,{"_25":95,"_27":96,"_29":97,"_31":98,"_33":99,"_35":100,"_37":100,"_38":101,"_40":102,"_42":103,"_44":45,"_46":47,"_48":-5},{"_25":81,"_27":82,"_29":83,"_31":84,"_33":85,"_35":86,"_37":86,"_38":39,"_40":87,"_42":88,"_44":45,"_46":47,"_48":-5},{"_25":71,"_27":72,"_29":73,"_31":74,"_33":75,"_35":76,"_37":76,"_38":77,"_40":78,"_42":79,"_44":45,"_46":47,"_48":-5},{"_25":58,"_27":59,"_29":60,"_31":61,"_33":62,"_35":63,"_37":63,"_38":64,"_40":65,"_42":66,"_44":45,"_46":47,"_48":-5},{"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":36,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47,"_48":-5},"id","aqj20k7en7f2tpaves648qxqb","title","LiteLLM v1.77.7 漏洞分析：CVE-2026-35029 与 CVE-2026-59823 复现","summary","Check Point Research 复现 LiteLLM v1.77.7 的授权绕过与 SSRF 漏洞，CVE-2026-35029 允许任意已认证用户修改代理配置，CVE-2026-59823 可通过 user_config 将 API 请求重定向至攻击者服务器。","reason","文章以 LiteLLM v1.77.7 为对象，串联授权绕过、环境变量注入、远程模块加载和 SSRF 的完整利用链，并提供可复现 PoC。","source",{"_56":57},"publishedAt","2026-10-13T14:30:26.000Z","timelineAt","category","disclosure","tags",[49,50,51,52,53,54,55],"score",83,"selected",true,"channel","news","x","漏洞分析","复现","漏洞利用","AI 安全","大模型","利用链","Check Point","name","Check Point Research","i6okqg6equ6bdxmgtc3ejgk6w","LiteLLM 披露权限控制漏洞 CVE-2026-35029 与 SSRF 漏洞 CVE-2026-59823","Check Point Research 披露 LiteLLM 的权限控制漏洞 CVE-2026-35029 和 SSRF 漏洞 CVE-2026-59823，1.83.9 以下版本均受影响。","文章梳理了 LiteLLM 两个漏洞的组合利用路径，并给出升级、权限审查、密钥轮换和隐藏实例排查方法。",{"_56":70},"2026-10-20T06:53:00.000Z","vuln",[67,52,53,68,69,55],75,"漏洞","补丁","凭据","安全客","idgop5gjlgm7d1wfp12pnkzbn","LiteLLM曝双漏洞，低权限用户可接管AI网关并窃取API密钥","Check Point Research披露LiteLLM的CVE-2026-35029和CVE-2026-59823，低权限用户可修改网关配置、读取服务器文件并窃取AI厂商API密钥，1.83.9以下版本均受影响。","文章梳理了LiteLLM双漏洞的权限缺陷、SSRF利用链与修复措施，可用于评估AI网关和密钥暴露风险。",{"_56":70},"2026-10-20T11:06:20.000Z","ai-security",[52,49,80,69,53,55],78,"身份与访问","oy03xazu2np8mgzruqrp0tk8x","Check Point Research 分析 AI 驱动反检测浏览器在网络欺诈与影响行动中的风险","Check Point Research 分析 Kameleo、AdsPower 和 MultiLogin 等 AI 驱动反检测浏览器如何隐藏数字身份、批量管理社交平台账号，并被用于账号接管、金融欺诈、钓鱼、恶意软件分发和协调影响行动。","文章拆解了 AI 驱动的反检测浏览器如何隐藏身份并串联账号接管、欺诈与影响行动，并给出面向平台和安全团队的网络层检测思路。",{"_56":57},"2026-10-20T14:17:23.000Z",[89,52,90,91,80,92,55,93,94],60,"技术研究","黑产","钓鱼","浏览器","Google","Microsoft","yl3lxk0vx9mrc5gr01umqijgn","Check Point Research 分析在野信息窃取木马 Aokigahara 对 AI 工具和云凭据的窃取","Check Point Research 发现名为 Aokigahara 的信息窃取木马已在野外出现，主要收集 AI 应用、开发工具、浏览器、VPN、密码管理器及加密钱包数据。","该分析详细拆解了 Aokigahara 的 AI 会话窃取、云凭据收集、配置解密与加密上传机制，并提供 IOC 和 YARA 规则，便于研究与检测。",{"_56":57},"2026-10-23T13:00:09.000Z","activity",[104,105,106,53,107,69,55,93,94,108],71,"攻击活动","恶意软件","数据窃取","云原生","AWS","slug","checkpoint","group","company","definition","Check Point 产品的漏洞，以及其研究团队的每周威胁情报报告。","brand",{"_129":-5,"_130":131,"_132":121},"total",5,"recent","indexable",false,"latest",{"_27":96,"_128":100},"groupName","厂商与机构","poolTotal",12,"at","src","monogram","C","raster",{"_134":135,"_136":-5},"changelogVersion","2026-10-01T08:00","release"]
