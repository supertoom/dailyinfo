[{"_1":2,"_3":4},"root",{"_5":166},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1794271002000,{"_142":143,"_59":58,"_144":145,"_146":147,"_148":149,"_150":151,"_152":151,"_153":154,"_155":156,"_157":158,"_159":160},"modules",{},"items",[20,21,22,23,24,25,26,27],"page",1,"pageCount","pageSize",20,{"_28":132,"_30":133,"_32":134,"_34":135,"_36":136,"_38":137,"_40":138,"_41":104,"_43":139,"_45":106,"_47":48,"_49":50,"_51":-5},{"_28":123,"_30":124,"_32":125,"_34":126,"_36":127,"_38":128,"_40":129,"_41":42,"_43":130,"_45":131,"_47":48,"_49":50,"_51":-5},{"_28":112,"_30":113,"_32":114,"_34":115,"_36":116,"_38":117,"_40":118,"_41":80,"_43":119,"_45":106,"_47":48,"_49":50,"_51":-5},{"_28":98,"_30":99,"_32":100,"_34":101,"_36":102,"_38":103,"_40":103,"_41":104,"_43":105,"_45":106,"_47":48,"_49":50,"_51":-5},{"_28":84,"_30":85,"_32":86,"_34":87,"_36":88,"_38":89,"_40":89,"_41":42,"_43":90,"_45":91,"_47":48,"_49":50,"_51":-5},{"_28":74,"_30":75,"_32":76,"_34":77,"_36":78,"_38":79,"_40":79,"_41":80,"_43":81,"_45":82,"_47":48,"_49":50,"_51":-5},{"_28":61,"_30":62,"_32":63,"_34":64,"_36":65,"_38":66,"_40":66,"_41":67,"_43":68,"_45":69,"_47":48,"_49":50,"_51":-5},{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":39,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":-5},"id","aqj20k7en7f2tpaves648qxqb","title","LiteLLM v1.77.7 漏洞分析：CVE-2026-35029 与 CVE-2026-59823 复现","summary","Check Point Research 复现 LiteLLM v1.77.7 的授权绕过与 SSRF 漏洞，CVE-2026-35029 允许任意已认证用户修改代理配置，CVE-2026-59823 可通过 user_config 将 API 请求重定向至攻击者服务器。","reason","文章以 LiteLLM v1.77.7 为对象，串联授权绕过、环境变量注入、远程模块加载和 SSRF 的完整利用链，并提供可复现 PoC。","source",{"_59":60},"publishedAt","2026-10-13T14:30:26.000Z","timelineAt","category","disclosure","tags",[52,53,54,55,56,57,58],"score",83,"selected",true,"channel","news","x","漏洞分析","复现","漏洞利用","AI 安全","大模型","利用链","Check Point","name","Check Point Research","i6okqg6equ6bdxmgtc3ejgk6w","LiteLLM 披露权限控制漏洞 CVE-2026-35029 与 SSRF 漏洞 CVE-2026-59823","Check Point Research 披露 LiteLLM 的权限控制漏洞 CVE-2026-35029 和 SSRF 漏洞 CVE-2026-59823，1.83.9 以下版本均受影响。","文章梳理了 LiteLLM 两个漏洞的组合利用路径，并给出升级、权限审查、密钥轮换和隐藏实例排查方法。",{"_59":73},"2026-10-20T06:53:00.000Z","vuln",[70,55,56,71,72,58],75,"漏洞","补丁","凭据","安全客","idgop5gjlgm7d1wfp12pnkzbn","LiteLLM曝双漏洞，低权限用户可接管AI网关并窃取API密钥","Check Point Research披露LiteLLM的CVE-2026-35029和CVE-2026-59823，低权限用户可修改网关配置、读取服务器文件并窃取AI厂商API密钥，1.83.9以下版本均受影响。","文章梳理了LiteLLM双漏洞的权限缺陷、SSRF利用链与修复措施，可用于评估AI网关和密钥暴露风险。",{"_59":73},"2026-10-20T11:06:20.000Z","ai-security",[55,52,83,72,56,58],78,"身份与访问","oy03xazu2np8mgzruqrp0tk8x","Check Point Research 分析 AI 驱动反检测浏览器在网络欺诈与影响行动中的风险","Check Point Research 分析 Kameleo、AdsPower 和 MultiLogin 等 AI 驱动反检测浏览器如何隐藏数字身份、批量管理社交平台账号，并被用于账号接管、金融欺诈、钓鱼、恶意软件分发和协调影响行动。","文章拆解了 AI 驱动的反检测浏览器如何隐藏身份并串联账号接管、欺诈与影响行动，并给出面向平台和安全团队的网络层检测思路。",{"_59":60},"2026-10-20T14:17:23.000Z",[92,55,93,94,83,95,58,96,97],60,"技术研究","黑产","钓鱼","浏览器","Google","Microsoft","yl3lxk0vx9mrc5gr01umqijgn","Check Point Research 分析在野信息窃取木马 Aokigahara 对 AI 工具和云凭据的窃取","Check Point Research 发现名为 Aokigahara 的信息窃取木马已在野外出现，主要收集 AI 应用、开发工具、浏览器、VPN、密码管理器及加密钱包数据。","该分析详细拆解了 Aokigahara 的 AI 会话窃取、云凭据收集、配置解密与加密上传机制，并提供 IOC 和 YARA 规则，便于研究与检测。",{"_59":60},"2026-10-23T13:00:09.000Z","activity",[107,108,109,56,110,72,58,96,97,111],71,"攻击活动","恶意软件","数据窃取","云原生","AWS","nbb7tcoqtiahxd3n8hixn7hov","海鸥 4.5.0 越狱包利用 Codex 全局配置持久化注入中转站广告","海鸥 Codex 捆绑包 4.5.0 通过加密 payload.pkg 向 ~/.codex/AGENTS.md 等可信配置写入模块化提示词和六个 seagull-* Skills，使“hi”等触发词可激活固定中转站广告。","文章完整拆解了越狱包写入全局配置、触发广告和关联第三方网关的链路，并给出可操作的配置取证与恢复方法。",{"_59":122},"2026-11-04T08:17:00.000Z","2026-11-04T12:32:22.031Z",[55,120,92,121,56,58],"Agent 安全","模型安全","奇安信威胁情报中心","aeb809z3vyorh7x5j0588tlw3","Check Point Research 揭示 ChatGPT Lockdown Mode 绕过漏洞","Check Point Research 发现 ChatGPT HTML 页面预览的沙箱绕过漏洞，可绕过 Lockdown Mode 窃取完整聊天历史与上传文件，并通过伪造窗口投递恶意软件或窃取凭据。","文章拆解了嵌套 iframe 沙箱权限绕过链条，并展示零点击数据外传、凭据窃取与恶意软件投递场景。",{"_59":60},"2026-11-05T14:00:11.000Z","2026-11-05T22:03:22.710Z",[52,53,55,56,54,109,58],72,"sz977idavdwew4pst2hcg25y7","Check Point Research 披露 ARTEX 自主漏洞攻击活动","Check Point Research 发现，攻击者正使用开源 AI 渗透测试平台 ARTEX 驱动多个 AI Agent 自主发现和利用漏洞，已观测到 2,557 个曾托管或正在托管 ARTEX 面板的系统，其中 1,608 个在研究时公开可用；10 个错误配置的实例暴露了操作端数据。","文章通过操作端控制台与多起战役还原 ARTEX 的自主攻击流程，并展示模型使用、成本和实际战果之间的差距。",{"_59":60},"2026-11-05T17:22:06.000Z","2026-11-06T01:06:24.662Z",[107,55,120,140,108,109,58,141],"AI 攻防","Apple","slug","checkpoint","group","company","definition","Check Point 产品的漏洞，以及其研究团队的每周威胁情报报告。","brand",{"_162":-5,"_163":164,"_165":154},"total",8,"recent","indexable",false,"latest",{"_30":133,"_161":138},"groupName","厂商与机构","poolTotal",19,"at","src","monogram","C","raster",{"_167":168,"_169":-5},"changelogVersion","2026-10-01T08:00","release"]
