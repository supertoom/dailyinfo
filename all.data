:336,"_66":337,"_68":338,"_70":-5,"_71":339,"_73":324,"_75":340,"_77":78,"_79":341,"_81":300,"_83":84,"_85":86,"_87":-5},{"_64":329,"_66":330,"_68":331,"_70":-5,"_71":332,"_73":324,"_75":333,"_77":78,"_79":334,"_81":335,"_83":84,"_85":86,"_87":-5},{"_64":320,"_66":321,"_68":322,"_70":-5,"_71":323,"_73":324,"_75":325,"_77":78,"_79":326,"_81":327,"_83":84,"_85":86,"_87":-5},{"_64":312,"_66":313,"_68":314,"_70":-5,"_71":315,"_73":316,"_75":317,"_77":78,"_79":318,"_81":319,"_83":84,"_85":86,"_87":-5},{"_64":305,"_66":306,"_68":307,"_70":-5,"_71":308,"_73":309,"_75":310,"_77":78,"_79":311,"_81":17,"_83":84,"_85":86,"_87":-5},{"_64":293,"_66":294,"_68":295,"_70":-5,"_71":296,"_73":297,"_75":298,"_77":119,"_79":299,"_81":300,"_83":84,"_85":86,"_87":-5},{"_64":282,"_66":283,"_68":284,"_70":285,"_71":286,"_73":287,"_75":288,"_77":201,"_79":289,"_81":290,"_83":219,"_85":86,"_87":-5},{"_64":269,"_66":270,"_68":271,"_70":272,"_71":273,"_73":274,"_75":275,"_77":276,"_79":277,"_81":278,"_83":219,"_85":86,"_87":-5},{"_64":262,"_66":263,"_68":264,"_70":-5,"_71":265,"_73":266,"_75":267,"_77":78,"_79":268,"_81":101,"_83":84,"_85":86,"_87":-5},{"_64":255,"_66":256,"_68":257,"_70":-5,"_71":258,"_73":259,"_75":260,"_77":78,"_79":261,"_81":253,"_83":84,"_85":86,"_87":-5},{"_64":246,"_66":247,"_68":248,"_70":-5,"_71":249,"_73":250,"_75":251,"_77":78,"_79":252,"_81":253,"_83":84,"_85":86,"_87":-5},{"_64":239,"_66":240,"_68":241,"_70":-5,"_71":242,"_73":243,"_75":244,"_77":78,"_79":245,"_81":162,"_83":84,"_85":86,"_87":-5},{"_64":232,"_66":233,"_68":234,"_70":-5,"_71":235,"_73":236,"_75":237,"_77":78,"_79":238,"_81":162,"_83":84,"_85":86,"_87":-5},{"_64":225,"_66":226,"_68":227,"_70":-5,"_71":228,"_73":229,"_75":230,"_77":78,"_79":231,"_81":162,"_83":84,"_85":86,"_87":-5},{"_64":210,"_66":211,"_68":212,"_70":213,"_71":214,"_73":215,"_75":216,"_77":201,"_79":217,"_81":218,"_83":219,"_85":86,"_87":-5},{"_64":195,"_66":196,"_68":197,"_70":-5,"_71":198,"_73":199,"_75":200,"_77":201,"_79":202,"_81":203,"_83":84,"_85":86,"_87":-5},{"_64":188,"_66":189,"_68":190,"_70":-5,"_71":191,"_73":192,"_75":193,"_77":78,"_79":194,"_81":153,"_83":84,"_85":86,"_87":-5},{"_64":181,"_66":182,"_68":183,"_70":-5,"_71":184,"_73":185,"_75":186,"_77":78,"_79":187,"_81":82,"_83":84,"_85":86,"_87":-5},{"_64":171,"_66":172,"_68":173,"_70":-5,"_71":174,"_73":175,"_75":176,"_77":78,"_79":177,"_81":178,"_83":84,"_85":86,"_87":-5},{"_64":163,"_66":164,"_68":165,"_70":-5,"_71":166,"_73":167,"_75":168,"_77":78,"_79":169,"_81":170,"_83":84,"_85":86,"_87":-5},{"_64":155,"_66":156,"_68":157,"_70":-5,"_71":158,"_73":159,"_75":160,"_77":78,"_79":161,"_81":162,"_83":84,"_85":86,"_87":-5},{"_64":145,"_66":146,"_68":147,"_70":-5,"_71":148,"_73":149,"_75":150,"_77":151,"_79":152,"_81":153,"_83":84,"_85":86,"_87":-5},{"_64":135,"_66":136,"_68":137,"_70":-5,"_71":138,"_73":139,"_75":140,"_77":78,"_79":141,"_81":142,"_83":84,"_85":86,"_87":-5},{"_64":126,"_66":127,"_68":128,"_70":-5,"_71":129,"_73":130,"_75":131,"_77":78,"_79":132,"_81":133,"_83":84,"_85":86,"_87":-5},{"_64":113,"_66":114,"_68":115,"_70":-5,"_71":116,"_73":117,"_75":118,"_77":119,"_79":120,"_81":121,"_83":84,"_85":86,"_87":-5},{"_64":103,"_66":104,"_68":105,"_70":-5,"_71":106,"_73":107,"_75":108,"_77":78,"_79":109,"_81":110,"_83":84,"_85":86,"_87":-5},{"_64":94,"_66":95,"_68":96,"_70":-5,"_71":97,"_73":98,"_75":99,"_77":78,"_79":100,"_81":101,"_83":84,"_85":86,"_87":-5},{"_64":65,"_66":67,"_68":69,"_70":-5,"_71":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":86,"_87":-5},"id","hfj0o20pz0zvm7crji5xuxzvc","title","AutoMapper 漏洞 CVE-2026-32933 修复 MaxDepth 绕过导致的拒绝服务","summary","AutoMapper 漏洞 CVE-2026-32933 的后续修复解决了 MaxDepth 限制未覆盖派生类型映射、object 或接口成员、Dictionary、ExpandoObject 及递归类型转换器所导致的拒绝服务。","reason","source",{"_92":93},"publishedAt","2026-11-13T18:47:17.000Z","timelineAt","2026-11-13T18:51:25.873Z","category","vuln","tags",[88,89,90,91],"score",57,"selected",false,"channel","news","x","漏洞","补丁","利用链","Microsoft","name","GitHub 安全公告","fy8tgbivt4t70kpf9muynb3dl","Astro 动态标签名属性注入导致 XSS，7.4.5 已修复","Astro 在动态标签名解析为字符串时存在 XSS 漏洞，攻击者可通过 `/` 注入属性，影响使用不可信输入作为元素名的应用。受影响版本为 `astro` <= 7.4.4，`astro` 7.4.5 已修复并限制动态字符串仅渲染有效元素名；升级前应将输入映射到固定标签集合。",{"_92":93},"2026-11-13T18:39:54.000Z","2026-11-13T18:51:25.887Z",[88,89,102],45,"复现","wqp12gn9ax9as7mw15146t9lb","Astro `/_image` 端点路径校验缺陷可读取输出目录外图像文件","Astro 的 `/_image` 端点在大小写敏感文件系统中以不区分大小写方式校验输出目录，允许未认证攻击者读取仅大小写不同的相邻目录中的图像文件。利用需使用 `@astrojs/node` 按需渲染、相关目录预先存在，且攻击者无法自行创建该目录；受影响版本为 astro >= 5.14.3, <= 7.4.6，升级至 7.4.7 可修复，仅升级 `@astrojs/node` 不足以解决。",{"_92":93},"2026-11-13T18:35:59.000Z","2026-11-13T18:51:25.893Z",[88,89,111,112],36,"漏洞分析","网络设备","v9cjpueqkxa5zbpo6fuwigd1n","Chrome Dev 渠道桌面版更新至 160.0.8157.0，覆盖 Windows、Mac 和 Linux","Chrome Dev 渠道桌面版已更新至 160.0.8157.0，适用于 Windows、Mac 和 Linux。变更内容仅提供 Git log 的部分列表，用户可通过切换发布渠道、提交 bug 或参与社区帮助论坛获取支持并反馈新问题。",{"_92":125},"2026-11-13T17:43:38.271Z","2026-11-13T19:01:29.700Z","blue-team",[122,123,124],3,"版本更新","浏览器","Google","Chrome Releases","xetr13qb94ii333ae7bonb9pl","russh 0.65.0 披露 agent 锁定后异步签名仍可完成的竞态漏洞","russh 0.65.0 的 `try_sign()` 在等待 `Agent::confirm()` 后未重新检查共享锁定状态，使已提交的签名请求可在 agent 锁定后完成。",{"_92":93},"2026-11-13T19:10:46.000Z","2026-11-13T19:12:25.413Z",[88,102,111,134],64,"在野利用","eh7wv8mp3s9lp9f8vqpohwnn9","OpenTelemetry-Go 存在 W3C baggage 属性内存分配放大漏洞","OpenTelemetry-Go 在解析 W3C baggage 时会预先物化属性，>= 1.0.0-RC1, < 1.47.0 受影响，v1.47.0 已修复。",{"_92":93},"2026-11-13T19:08:10.000Z","2026-11-13T19:12:25.420Z",[88,111,102,89,143,144],58,"大模型","云原生","ijtbwr97dcspuzbpetcmi9aar","OpenTelemetry Go 的 AttributeValueLengthLimit 可被 U+FFFD 字符完全绕过","OpenTelemetry Go 的 AttributeValueLengthLimit 截断缺陷可由有效 U+FFFD 字符完全绕过，影响自 v1.33.0 起原公告所列已修复版本，v1.46.0 仍存在。",{"_92":93},"2026-11-13T19:00:55.000Z","2026-11-13T19:12:25.428Z","disclosure",[102,111,90,154],44,"技术研究","af4c7qthzndkkau6u6vo2p3qw","sqlite3-ruby 4 GiB 以上字符串可能导致 SQL 查询截断，CVSS 4.8","sqlite3-ruby 在将 Ruby 字符串长度转换为 int 后传给 SQLite，4 GiB 以上字符串可能在 64-bit 平台发生长度回绕，使 SQL 查询被截断。该问题评为中危，CVSS 4.8，利用前提是攻击者能让单个 SQL 字符串或绑定值达到至少 4 GiB。升级至 sqlite3 v2.10.2 或更高版本可修复，旧版可提前拒绝此类输入或限制请求体大小。",{"_92":93},"2026-11-13T18:57:58.000Z","2026-11-13T19:12:25.434Z",[88,89,111],42,"w6akanst941p8ir68ci3p8g21","Nuxt 4.6.3 路径检查绕过漏洞 GHSA-r99w-jh2x-3mg9 已修复","Nuxt 4.6.3 的页面路由存在请求路径检查绕过，GHSA-r99w-jh2x-3mg9 影响以 `//` 开头的请求路径。",{"_92":93},"2026-11-13T19:32:21.000Z","2026-11-13T19:33:25.536Z",[88,89,102,111],68,"bbbhm7v5uvpxbmzkzn45yb3km","OpenTelemetry JavaScript 的 @opentelemetry/instrumentation-http 存在敏感信息泄露漏洞","`@opentelemetry/instrumentation-http` 未从入站请求的服务端 span 中清除敏感查询参数，导致 AWS 预签名 URL、Azure SAS token 和 GCS 签名 URL 等凭据以明文写入追踪后端。",{"_92":93},"2026-11-13T19:29:20.000Z","2026-11-13T19:33:25.542Z",[88,89,179,180],62,"凭据","数据窃取","bkhbb6f38uvauahj1495wb3yl","AutoMapper 构造函数映射可绕过 MaxDepth 并触发 StackOverflowException","AutoMapper 的构造函数参数映射路径未执行 MaxDepth 深度检查，攻击者可影响 deeply nested 数据映射到含递归成员的位置记录等目标类型，导致无法捕获的 StackOverflowException 并终止进程。",{"_92":93},"2026-11-13T19:21:02.000Z","2026-11-13T19:33:25.548Z",[88,102,89,111],"wr1g77jskvbqpcpteloualzr1","russh 在校验 SSH 服务器主机密钥前执行 kex_done()，可触发未受信密钥交换回调","russh 的 `client::Handler::kex_done()` 会在 `check_server_key()` 校验服务器主机密钥前收到密钥交换共享密钥，恶意 SSH 服务器即使随后被拒绝也可触发二次加密通道初始化。",{"_92":93},"2026-11-13T19:20:16.000Z","2026-11-13T19:33:25.553Z",[88,102,111,112],"hso3fdhybvbz542lhds5br37k","Trezor确认3个Safe 5硬件钱包含窃取加密资产的恶意植入","Trezor确认3台由东南亚经销商CryptoBilis销售的Safe 5硬件钱包含恶意硬件植入，可截取屏幕显示或输入的助记词与密码，加密后经移动网络传至攻击者服务器。",{"_92":209},"2026-11-13T19:38:36.000Z","2026-11-13T20:01:25.042Z","activity",[204,205,206,180,207,208],67,"攻击活动","恶意软件","后门","供应链投毒","IoT","BleepingComputer","kwq30stubj3ryg11q7j0ngxx8","Cloudflare 披露 AI 渗透测试编排框架激增与凭据链式利用","Cloudflare 指出，AI 渗透测试与利用编排框架正快速扩散，3天内已有 50 多个框架家族扫描其全球客户，相关 IP 达数千个；截至 11 月 12 日，ARTEX 及其分支占已知框架的 60% 以上。","文章结合全球扫描与事件响应观测，说明 AI 渗透编排框架的扩散速度、凭据链式利用及可落地的六层防护框架。",{"_92":224},"2026-11-13T19:26:07.000Z","2026-11-13T20:02:29.322Z",[204,220,221,222,179,144,223],76,true,"AI 安全","Agent 安全","AI 攻防","Cloudflare","Cloudflare Blog","eipa5pek7x70qtts9a5u3keo8","Tornado 6.6.1 修复三重斜杠路径导致的开放重定向漏洞","Tornado 6.6.1 修复了浏览器与 Python `urllib` 解析差异导致的开放重定向问题，涉及此前 6.6.0 对 CVE-2026-116578 的不完整修复。三重或更多斜杠开头的路径会被浏览器视为协议级重定向，现已改进开放重定向检测并修复 6.6.0 实现中的回归问题。",{"_92":93},"2026-11-13T20:31:22.000Z","2026-11-13T20:36:25.241Z",[88,89,123],"ccz8qqph4zjxlamlqf5285bf9","dnspython WKS 记录解析缺陷可导致内存与 CPU 消耗过高","dnspython 的 from_text() 解析器未校验 WKS 记录的服务号是否处于 0 至 65535 范围，恶意构造的 zone 文件可引发超大内存分配并低效扩展位图，造成内存耗尽或拒绝服务。PoC 使用服务号 65536，演示校验缺失但未触发过度资源消耗；攻击需能控制 zone 文件记录类型与 rdata 文本，文中未说明补丁状态或已确认的利用活动。",{"_92":93},"2026-11-13T20:19:13.000Z","2026-11-13T20:36:25.247Z",[88,102,111],"uow3g9ho46jlyy9gtbocxkujq","SvelteKit adapter-node 的 reroute 处理畸形路径时可能因未捕获的 URIError 导致崩溃","SvelteKit 的 adapter-node 在 reroute 将无效百分号编码路径改写为有效路径时，可能触发比较操作并因未捕获的 URIError 崩溃。原文未说明受影响版本、CVSS 评分、利用前提、补丁状态及是否已确认被利用。",{"_92":93},"2026-11-13T20:51:44.000Z","2026-11-13T20:52:25.848Z",[88,89],"itntkm9ihg15i8fw1hkvpio89","SvelteKit 预渲染路径在 @sveltejs/adapter-vercel 与 @sveltejs/adapter-static 生成的 Vercel 路由配置中被当作正则表达式解析","SvelteKit 在 @sveltejs/adapter-vercel 和 @sveltejs/adapter-static 生成 Vercel 路由配置时，会将预渲染路径解释为正则表达式。若攻击者能影响预渲染阶段被抓取的链接，该链接之后可能被当作 Vercel 路由配置中的 regex 解析。",{"_92":93},"2026-11-13T20:43:23.000Z","2026-11-13T20:52:25.854Z",[88,254],40,"供应链","fqs0tnt1ufsgubdqnq5h3dpbx","SvelteKit 预渲染重定向路径可向 @sveltejs/adapter-cloudflare 生成的 `_redirects` 文件注入任意规则","SvelteKit 预渲染阶段可被攻击者影响的链接，会向构建期间由 @sveltejs/adapter-cloudflare 生成的 Cloudflare `_redirects` 文件注入任意重定向规则。攻击者需能影响预渲染期间爬取的链接，原文未提供漏洞编号、CVSS 分数、受影响版本、补丁状态或利用确认信息。",{"_92":93},"2026-11-13T20:39:15.000Z","2026-11-13T20:52:25.861Z",[88,111,223],"rbn2sgdmeuv436mhwvwzhuaxf","SvelteKit `@sveltejs/adapter-node` 代理特定请求时因修改不可变请求头导致服务器崩溃","`@sveltejs/adapter-node` 在代理特定请求时可能向不可变请求添加 Header，导致服务器崩溃，并使路由至该服务器的请求无法提供服务。",{"_92":93},"2026-11-13T20:36:53.000Z","2026-11-13T20:52:25.877Z",[88],"qeruuzfjoy6z4m589atx262j4","Cisco Talos 发现 ARTEX 已被用于多行业攻击并关联超过 2,500 个 C2 IP 地址","Cisco Talos 发现开源 AI 渗透测试框架 ARTEX 已被威胁行动者用于侦察、凭据窃取、云端滥用、横向移动和数据外泄，目标覆盖金融、政府、电信、国防等行业。","文章结合公开归因与Talos实测，梳理ARTEX从侦察、初始访问、云端滥用到数据外泄的攻击链，并给出可落地的检测与隔离建议。",{"_92":281},"2026-11-13T20:57:13.000Z","2026-11-13T21:03:26.694Z","ai-security",[220,221,204,279,280,254],83,"红队","漏洞利用","Cisco Talos","qr7yw6vafmf6e5mjlmebcs0x4","Amazon Threat Intelligence 发现攻击者利用 ARTEX AI Agent 窃取凭据并绕过 KYC","Amazon Threat Intelligence 从 MadPot 诱捕传感器于 2026 年 10 月 3 日至 11 月 5 日捕获的攻击请求中，发现攻击者使用开源 ARTEX Agent 框架开展凭据窃取和加密货币交易所 KYC 绕过。","公开了 AI Agent 运行凭据窃取与 KYC 绕过活动时的任务记录、工作流和 IOC，可用于识别自动化攻击模式并核对自身环境。",{"_92":292},"2026-11-13T20:26:42.000Z","2026-11-13T21:04:27.833Z",[204,220,221,222,179,180,291],72,"AWS","AWS Security Blog","mk2ky7w95ayf9s67cro9vtdyo","GNSS 欺骗与干扰对 RTK 定位的影响及现场排查方法","GNSS 干扰会压制信号并使 RTK 从固定解降级为浮点或单点定位，GNSS 欺骗则能生成看似稳定但错误的坐标，且 NTRIP 修正数据无法认证天线收到的全部信号。现场团队应结合接收机状态、修正流龄期与独立控制点交叉验证，并排查多路径、遮挡和修正中断等普通原因。发现位置跳变、多台接收机信号突变或时间速度异常时，应暂停关键作业、标记受影响点并保存原始观测记录，满足容差与项目流程后再恢复。",{"_92":304},"2026-11-13T20:58:12.000Z","2026-11-13T21:04:29.971Z",[301,302,303,208],29,"蓝队","应急响应","检测工程","Hackread","m05pp77s7rd6eldram5zixobv","NLTK SteppingRecursiveDescentParser.parse() 存在无界 CPU 消耗漏洞","NLTK 的 SteppingRecursiveDescentParser.parse() 对含糊或自嵌入上下文无关文法执行无界自顶向下搜索，可使单次解析长期占用一个 CPU 核心。",{"_92":93},"2026-11-13T21:02:19.000Z","2026-11-13T21:08:25.130Z",[88,102,111,90,143],"txk5q57kptutnveduj4h9xvbh","NLTK YCOECorpusReader 目录符号链接逃逸漏洞影响 3.10.0 至 3.10.3","NLTK 的 YCOECorpusReader 在构造 psd 和 pos 嵌套读取器时存在目录符号链接逃逸漏洞，受影响版本为 >= 3.10.0、<= 3.10.3。",{"_92":93},"2026-11-13T20:55:16.000Z","2026-11-13T21:08:25.137Z",[88,102,111,89],59,"v2iovo65ssi1jim9am0wteszx","NLTK TreebankWordTokenizer.span_tokenize 二次方 CPU 消耗漏洞公告撤回（重复于 GHSA-ffr9-mgrr-wcvr）","NLTK 3.2.5 至 3.10.4 之前的 TreebankWordTokenizer.span_tokenize 存在算法复杂度漏洞，远程攻击者可通过连续双引号触发 list.pop(0)，造成二次方 CPU 消耗并降低服务可用性。该公告因与 GHSA-ffr9-mgrr-wcvr 重复而被撤回，链接仅为保留外部引用。",{"_92":93},"2026-11-13T12:31:17.000Z","2026-11-13T21:08:25.188Z",[88,328],39,"其他","dzoyji3lzbi39kjiendbxt5kz","NLTK YCOECorpusReader 符号链接逃逸漏洞分析","NLTK 3.10.0 至 3.10.4 之前的 YCOECorpusReader 存在符号链接逃逸漏洞，攻击者控制 YCOE 语料库并植入 psd 或 pos 目录符号链接后，可读取语料库根目录之外、但仍位于 NLTK 数据沙箱内的文件。",{"_92":93},"2026-11-13T21:08:25.195Z",[88,89],26,"pockh5la6chhacrd982gm96iy","NLTK SteppingRecursiveDescentParser.parse() 无界 CPU 消耗漏洞公告已撤回","NLTK 3.10.4 之前版本的 SteppingRecursiveDescentParser.parse() 存在无界资源消耗漏洞，缺少 max_time 时限或步骤限制。能影响语法内容的攻击者可构造歧义且自嵌入的语法，以简短输入触发无界自顶向下搜索，占满 CPU 核心并耗尽 worker 池；该公告因与 GHSA-8fx7-8jr8-84rv 重复而撤回。",{"_92":93},"2026-11-13T21:08:25.205Z",[88,89],"z796vm3dm15p97eh9cjiohrz1","NLTK LegalitySyllableTokenizer.tokenize 存在 CPU 耗尽漏洞","NLTK 的 LegalitySyllableTokenizer.tokenize 在处理长元音字符串时执行未设长度上限的 O(n^2) 循环，可使单次请求占满一个 CPU 核心并降低服务可用性。",{"_92":93},"2026-11-13T21:16:34.000Z","2026-11-13T21:24:25.459Z",[88,102,280,89,143],"cgzz39as1us2lsevosb0brfcf","NLTK TreebankWordTokenizer.span_tokenize 引号还原循环导致 O(n^2) CPU 耗尽","NLTK `TreebankWordTokenizer.span_tokenize` 在处理大量双引号或重复引号时，于引号还原循环中反复调用 O(n) 的 `list.pop(0)`，可触发 O(n^2) CPU 消耗，攻击者无需认证、特殊配置或用户交互即可降低服务可用性。",{"_92":93},"2026-11-13T21:08:55.000Z","2026-11-13T21:24:25.466Z",[88,102,280,134],51,"fvhpwjg9zy17baf0ez4fppn31","CISA 将 CVE-2026-114713 与 CVE-2026-123039 纳入 KEV Catalog","CISA 将 UnrealIRCd 的 CVE-2026-114713 和 Check Point 多产品的 CVE-2026-123039 纳入 KEV Catalog，确认这两项漏洞已被利用。BOD 26-04 要求 FCEB 机构优先修复公开暴露资产中可导致完全控制的目录漏洞，并检查补丁前系统是否已遭入侵；CISA 同时建议其他组织采取基于风险的修复措施。",{"_92":367},"2026-11-13T12:00:00.000Z","2026-11-13T21:49:26.325Z",[134,365,89,366],69,"漏洞管理","CISA","CISA 安全公告","q2crn96h6km6op5qe5v9oetb7","FAA 因“特殊情况”对全美机场发布全国性停飞指令","美国联邦航空管理局（FAA）因影响全美所有 Air Route Traffic Control Centers 的通信问题，对全美机场发布全国性地面停飞指令，出发航班被要求停留在地面。FAA 技术人员正在调查，联邦官员尚未公开问题成因，也无法确认是否与网络攻击有关；抵达的国际航班将逐案处理。",{"_92":376},"2026-11-13T21:33:27.000Z","2026-11-13T22:03:28.414Z",[328],25,"SecurityWeek","spesfoh8hnd6kn27vm72lu8v2","SCKit滥用ScreenConnect入侵MSP客户环境并攻击技术支持工作站","Microsoft Threat Intelligence确认，威胁者自2026年11月11日起利用托管服务商（MSP）的ScreenConnect实例，部署SCKit恶意蠕虫和未授权远程客户端，进而攻击IT支持人员工作站并扩大管理控制台权限。",{"_92":389},"2026-11-13T21:31:44.000Z","2026-11-13T22:04:27.577Z",[204,205,134,206,91],75,"sameEvent",{"_64":387,"_66":388},"h2occksxu7q3tzi57634syb7r","SCKit 蠕虫式恶意软件借 ScreenConnect 攻击 MSP，尝试反向感染技术人员","Microsoft Security Blog","vw9f7bq05n0ruzl7tx1o1fwyc","美国司法部查获逾 12 亿美元并中断 North Korea FaceStealer 加密货币窃取基础设施","美国司法部针对 North Korea 的加密货币窃取行动查获 FaceStealer 社会工程基础设施，并获得法院授权扣押近期从 Binance 窃取的逾 12 亿美元加密资产，相关资产总额已达 60 亿美元。",{"_92":397},"2026-11-13T21:19:30.000Z","2026-11-13T22:05:29.393Z",[204,180,205,222,179,279],"Security Affairs","lkqxkc8xxi6ei2vqg5ot19n0i","ArcticRAT Android 木马扩展至完全控制设备，并用 AI 分析受害者财务信息","ArcticRAT Android 木马已从加密货币窃取扩展为完全控制设备，并新增对窃取信息的先进分析功能。攻击者据此对受害者财务状况进行画像，恶意软件功能范围与数据分析能力同步扩大。",{"_92":406},"2026-11-13T20:20:27.000Z","2026-11-13T23:06:25.132Z",[204,205,222,405],"移动端","Dark Reading","y0pg7kd7dn53yx1qdx27zkdk1","File Browser v2.63.15 目录尾斜杠删除可遗留公开共享","File Browser v2.63.15 存在公开共享清理缺陷，以尾部斜杠删除共享目录时会遗留旧共享记录，目录重建后新内容可经原公开 URL 被未认证访问。具备 share、download 和 delete 权限的已认证用户可触发该问题；原文提供 PoC 测试并指出需在查询共享索引前规范化路径、覆盖精确路径及其后代。漏洞已修复于 v2.63.17。",{"_92":93},"2026-11-13T23:12:06.000Z","2026-11-13T23:16:25.347Z",[88,102,280,111],49,"evk1h2i0cwyv6u2r44t04ftat","NLTK BllipParser 路径校验缺失可导致任意文件读取","NLTK 3.10.0 至 3.10.3 的 BllipParser 未对调用方提供的模型路径执行 pathsec 校验，攻击者可控制原生 bllipparser 扩展读取任意文件系统路径。",{"_92":93},"2026-11-13T23:20:56.000Z","2026-11-13T23:32:25.597Z",[111,102,90,180],48,"qcuckwn1ukhadodfb16rw0osb","NLTK CCG 词典解析器二次时间 CPU 拒绝服务漏洞分析（影响版本 <= 3.10.3）","NLTK CCG 词典解析器 nltk.ccg.lexicon.fromstring 在处理宽括号体和长运算符链时存在二次时间复杂度，可被攻击者控制的数 MB 词典文本消耗数十秒单线程 CPU。",{"_92":93},"2026-11-14T00:08:50.000Z","2026-11-14T00:20:25.313Z",[111,102,154],"cetop6struj3ivlk7mar18qfe","NLTK Tree.chomsky_normal_form 存在二次时间 CPU 拒绝服务漏洞","NLTK 的 Tree.chomsky_normal_form() 在默认右因子二值化路径中反复调用 list.pop(0)，可被宽树触发 O(N^2) 单核 CPU 消耗，受影响版本为 nltk <= 3.10.3。",{"_92":93},"2026-11-14T00:07:59.000Z","2026-11-14T00:20:25.322Z",[88,102,111,89],"hig5u4b1zg3qq2vyy9v3m0ltw","NLTK ConllCorpusReader.srl_instances() 嵌套 span 重扫描导致二次方 CPU 拒绝服务","NLTK 的 ConllCorpusReader.srl_instances() 在构建 SRL 实例时对每个谓词重扫描所有 span 列，复杂度 O(P^2 * R)。",{"_92":93},"2026-11-14T00:05:57.000Z","2026-11-14T00:20:25.329Z",[88,102,111,90],41,"all","tag","q","tab","time",{"_451":452,"_453":-5},"changelogVersion","2026-10-01T08:00","release"]
