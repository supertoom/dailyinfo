231,"_77":128,"_79":232,"_81":233,"_83":84,"_85":86,"_87":-5},{"_64":214,"_66":215,"_68":216,"_70":-5,"_71":217,"_73":218,"_75":219,"_77":128,"_79":220,"_81":221,"_83":161,"_85":86,"_87":-5,"_196":222},{"_64":203,"_66":204,"_68":205,"_70":206,"_71":207,"_73":208,"_75":209,"_77":78,"_79":210,"_81":211,"_83":161,"_85":86,"_87":-5},{"_64":188,"_66":189,"_68":190,"_70":-5,"_71":191,"_73":192,"_75":193,"_77":128,"_79":194,"_81":195,"_83":161,"_85":86,"_87":-5,"_196":197},{"_64":179,"_66":180,"_68":181,"_70":-5,"_71":182,"_73":183,"_75":184,"_77":100,"_79":185,"_81":175,"_83":84,"_85":86,"_87":-5},{"_64":168,"_66":169,"_68":170,"_70":-5,"_71":171,"_73":172,"_75":173,"_77":128,"_79":174,"_81":175,"_83":84,"_85":86,"_87":-5},{"_64":152,"_66":153,"_68":154,"_70":155,"_71":156,"_73":157,"_75":158,"_77":100,"_79":159,"_81":160,"_83":161,"_85":86,"_87":-5},{"_64":136,"_66":137,"_68":138,"_70":-5,"_71":139,"_73":140,"_75":141,"_77":142,"_79":143,"_81":144,"_83":84,"_85":86,"_87":-5},{"_64":122,"_66":123,"_68":124,"_70":-5,"_71":125,"_73":126,"_75":127,"_77":128,"_79":129,"_81":121,"_83":84,"_85":86,"_87":-5},{"_64":114,"_66":115,"_68":116,"_70":-5,"_71":117,"_73":118,"_75":119,"_77":100,"_79":120,"_81":121,"_83":84,"_85":86,"_87":-5},{"_64":104,"_66":105,"_68":106,"_70":-5,"_71":107,"_73":108,"_75":109,"_77":100,"_79":110,"_81":111,"_83":84,"_85":86,"_87":-5},{"_64":94,"_66":95,"_68":96,"_70":-5,"_71":97,"_73":98,"_75":99,"_77":100,"_79":101,"_81":102,"_83":84,"_85":86,"_87":-5},{"_64":65,"_66":67,"_68":69,"_70":-5,"_71":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":86,"_87":-5},"id","vm1xmd7ljv0a68cnqboc2bzt4","title","Budibase Builder 跨权限存储型 XSS 漏洞分析与 PoC","summary","Budibase v3.44.0 的 Builder 存在跨权限存储型 XSS：BASIC 用户或未认证访问者可将 HTML/JavaScript 载荷写入共享外部数据源，builder 或 admin 预览绑定时会在 Builder 源内执行。","reason","source",{"_92":93},"publishedAt","2026-11-20T23:49:47.000Z","timelineAt","2026-11-21T00:04:29.871Z","category","disclosure","tags",[88,89,90,91],"score",63,"selected",false,"channel","news","x","漏洞分析","复现","漏洞利用","利用链","name","GitHub 安全公告","up0vdsfzc0lkil51u7432afgp","wcmatch 默认标志下多星号模式可触发多项式时间 ReDoS","wcmatch 在默认标志下使用包含多个 `*` 的模式匹配不可信文件名时存在 ReDoS，模式通常为开发者常量，攻击者仅需控制被匹配字符串。",{"_92":93},"2026-11-20T23:49:18.000Z","2026-11-21T00:04:29.878Z","vuln",[103,89,88,90],46,"漏洞","oyjs8la07x3eu6gnbxq4d19rb","Inscriptis get_text() 因兄弟元素导致内存二次增长并可触发 DoS","Inscriptis 的 get_text() 会因每个表格留下额外缩进记录，使输出大小和内存占用随表格数量呈二次增长；该问题自 2.0 起存在。",{"_92":93},"2026-11-20T23:48:51.000Z","2026-11-21T00:04:29.884Z",[103,89,90,112,113],67,"AI 供应链","大模型","rxd9qlw8ug0ngyxo7cwloos69","svglib 嵌套 SVG 引用导致 CPU 与内存耗尽","svglib 的 svg2rlg() 对嵌套 SVG 引用缺乏总量限制，攻击者控制的文档可触发指数级展开并造成拒绝服务。受影响版本为 <= 2.3.0，原文在 2.3.0 和 1.5.1 上均验证；1409 B 的 5 层样本耗时 34 s、峰值内存 469 MiB，xhtml2pdf 场景可达 78.7 s 和 499 MiB。原文建议将单文档扩展次数限制为 10,000，并补充了回归测试。",{"_92":93},"2026-11-20T23:47:58.000Z","2026-11-21T00:04:29.890Z",[103,89,88,91],51,"jx8xbqv4flmkp7i7nzhtpw5ck","RansomwareHelp 联合创始人 Juan Ricardo Palacio Escobar 被控电信欺诈，曾秘密向 Lockbit 购买解密密钥","FBI 卧底行动发现，佛州数据恢复公司 ransomwarehelp.com 的 CTO 兼联合创始人 Juan Ricardo Palacio Escobar（52 岁）实为向勒索团伙付钱购买解密密钥、再向客户加价收费，网站宣称「100% 数据恢复」和「99% 成功率」纯属虚构，其网站现已关停。",{"_92":135},"2026-11-21T00:36:39.000Z","2026-11-21T01:35:34.782Z","activity",[130,131,132,133,134],"攻击活动","勒索","黑产","数据窃取","安全运营","Krebs on Security","weld60yqsg670rjsdtn2mp4ts","Signal 在 Android 和 iOS 默认限制截图，防止 AI Agent 读取私密聊天","Signal 宣布在 Android 和 iOS 默认限制截图，阻止内置于 iOS 27 及可检测 AI 助手的 Android 系统中的 AI Agent 读取聊天内容，但承认该措施仍不完整。",{"_92":151},"2026-11-21T08:49:20.000Z","2026-11-21T09:24:45.965Z","ai-security",[145,146,147,148,149,150],59,"AI 安全","Agent 安全","移动端","加固","Apple","Google","The Hacker News","jbitkvf4i6iewvak8ejgx9cvb","CISA 将 Apache Roller、Cisco Expressway、SAP NetWeaver 和 VMware vCenter 四项漏洞列入 KEV","CISA 将 Apache Roller、Cisco Expressway、SAP NetWeaver 和 VMware vCenter 的 4 个漏洞列入 KEV，依据是已发现活跃利用证据。","四条漏洞已进入 KEV，其中 Apache Roller、VMware vCenter 等已有利用线索，文中还给出了各漏洞的触发条件、修复时间与处置期限。",{"_92":151},"2026-11-21T08:49:13.000Z","2026-11-21T09:24:45.971Z",[103,162,163,90,133,164,165,166,167],83,true,"在野利用","补丁","漏洞管理","Cisco","VMware","CISA","v6t7o2gekhpdb4zls1sthkw2c","Bitdefender 揭示假 GTA VI 流客户端利用 ClickFix 投递 Windows 信息窃取木马","Bitdefender 发现网站 gta6cloud.nexus 以云端串流 GTA VI 为诱饵，通过 ZIP 下载或要求用户在 Win+R 中运行 PowerShell 命令投递恶意程序。",{"_92":178},"2026-11-21T08:57:36.000Z","2026-11-21T09:42:50.095Z",[130,176,177,133],66,"恶意软件","钓鱼","Hackread","fq1jp1mdea273klgl1kyc2ik0","GnuPG 披露 GPGME 双重释放漏洞 CVE-2026-129975","GnuPG 披露 GPGME 内存漏洞 CVE-2026-129975，含异常长 User ID 的恶意 OpenPGP 密钥可触发双重释放，影响 2.3.0 之前使用 GPGME 的软件，包括多数邮件客户端、部分 XMPP 客户端、Samba、Gpg4win、GnuPG Desktop 与 GnuPG VS-Desktop。",{"_92":151},"2026-11-21T11:05:53.000Z","2026-11-21T11:26:46.562Z",[103,163,186,187],"邮件安全","供应链","l0ha7ysjw76syv06olmktwx96","自主 AI Agent 利用 MONAI Label 漏洞 CVE-2026-133968 取得 root 权限","Amazon Threat Intelligence 称，中国关联攻击者使用自主 AI Agent 在 MONAI Label 中发现路径遍历漏洞 CVE-2026-133968，并在一台大学服务器上取得 root 权限。",{"_92":151},"2026-11-21T11:03:17.000Z","2026-11-21T11:26:46.569Z",[130,162,200,90,146,201,202],81,"sameEvent",{"_64":198,"_66":199},"mfif5csbm0luk6anr64r4hzho","攻击者利用自主 AI 工具 Cairn 攻陷 MONAI Label 漏洞并取得服务器权限","AI 攻防","技术研究","AWS","dfh23lubzfof7rir61cxf0nq4","NebuSec 演示恶意网页劫持 Meta Muse 并读取私人聊天与记忆","NebuSec 演示恶意网页可绕过审批提示，从 Meta Muse 云端机器提取并篡改用户聊天记录与存储记忆，并结合内置浏览器和 Linux 内核缺陷取得机器控制权，访问凭据存储、保存文件及 Sentinel。攻击仅影响单台云端机器，未进入共享服务器或其他用户设备；研究为实验室演示，NebuSec 称所披露弱点均已修复，但 Meta 尚未公开确认，补丁发布前是否有用户数据被访问也未说明。","文章拆解了恶意网页经内置浏览器与 Linux 内核缺陷控制云端机器的攻击链，并说明影响边界与修复状态。",{"_92":151},"2026-11-21T11:53:07.000Z","2026-11-21T12:27:45.824Z",[201,91,145,146,212,213],71,"浏览器","内核","yfjjmgqjkhh0q3y9eoj082rrw","Amazon称中国关联黑客利用AI agents攻破MONAI Label漏洞","Amazon称，中国关联威胁组织运营的自主 AI agents 利用开源医疗影像标注工具 MONAI Label 的零日漏洞，针对东亚地区中国大陆以外大学 IP 发起约 48 小时攻击活动。",{"_92":225},"2026-11-21T12:08:50.000Z","2026-11-21T12:37:44.815Z",[130,162,90,200,187,223,202,224],78,{"_64":198,"_66":199},"凭据","CNCERT","SecurityWeek","b0fgs0mq3ppal4cs43serx3uq","攻击者通过 Microsoft Teams 冒充 IT 支持，配合邮件炸弹攻击企业账户","攻击者先用订阅邮件轰炸员工工作邮箱，再通过 Microsoft Teams 冒充 IT 支持人员，以协助停止邮件为由诱导员工执行操作，进而试图控制账户或计算机。",{"_92":178},"2026-11-21T12:54:31.000Z","2026-11-21T13:46:50.861Z",[130,177,176,234],64,"Microsoft","gfltnklmzy1i3r60nor37jo5p","FBI全国犯罪信息中心NCIC据报再次遭入侵","FBI正在调查其国家犯罪信息中心（NCIC）疑似遭入侵事件，该系统供美国地方、州和联邦执法机构共享通缉及失踪人员、逮捕令、被盗车辆和枪支、保护令等记录。入侵近日被发现，但发生时间、攻击者获取访问权限的方式以及是否窃取信息尚不清楚，FBI尚未公开确认事件，也未说明系统可用性是否受影响。",{"_92":244},"2026-11-21T14:26:04.000Z","2026-11-21T15:11:44.708Z",[130,242,243,167],"数据泄露","Oracle","BleepingComputer","dbml5ujd9k2y3agezdbxfdnmx","BADBOX 3.0 botnet 回归，每日发起 40 亿次欺诈广告竞价请求","HUMAN 的 Satori 研究人员发现 BADBOX 3.0 通过受感染的 Android 设备每日发起约 40 billion 次欺诈广告竞价请求，峰值占其观察到的 CTV 流量的 4% 以上。","材料揭示 BADBOX 3.0 通过感染 Android 设备实施广告欺诈与流量代理，并给出请求规模、代理网络和历史处置数据。",{"_92":244},"2026-11-21T15:17:27.000Z","2026-11-21T16:09:45.367Z",[130,176,254,147,255,150],73,"僵尸网络","IoT","ec6iwx2jzf1ovuafwqcriuu0q","ACM CCS 2026 参会小记（4）：微信小程序的密码学安全问题","ACM CCS 2026 的微信小程序密码学研究提出结合 LLM 与人工验证的分析方法，通过识别密码算法、检测误用并关联业务上下文判断实际安全影响。该方法发现“千里码”漏洞，强调硬编码密钥等误用是否可被利用仍需结合具体场景；会议还报道了 MINIAUTH 对近4.7万个小程序检出1834例身份认证误用，以及 Cordova 漏洞 CVE-2026-47430。",{"_92":269},"2026-11-21T09:58:00.000Z","2026-11-21T16:49:45.057Z",[201,264,88,147,265,266,267,268],37,"论文","身份与访问","加密","腾讯","百度","安全研究GoSSIP","cxwtekd23zeh2kmfam51afpji","Amazon 发现自主 AI Agent 利用未知漏洞入侵东亚高校","Amazon 威胁情报团队披露，一名疑似中国关联的操作者使用开源自主 AI 渗透框架 Cairn，在约 48 小时内攻击中国境外东亚地区高校 IP。",{"_92":278},"2026-11-21T16:50:49.000Z","2026-11-21T17:52:54.495Z",[145,146,200,162,130,202],82,"Security Affairs","nios0423zfv9l5e7fe1nvkxig","CISA 将 Cisco Expressway、SAP NetWeaver、VMware vCenter 和 Apache Roller 漏洞加入 KEV 目录","CISA 将 CVE-2025-42884、CVE-2026-76466、CVE-2026-123890 和 CVE-2026-129448 加入 KEV 目录，确认这些漏洞已在真实攻击中使用。",{"_92":278},"2026-11-21T16:09:38.000Z","2026-11-21T17:52:54.509Z",[162,163,103,164,165,150,167,243,166],88,"lwn1awdsmrazlhsmt4r21vq0w","Microsoft Entra Connect Health 漏洞遭利用，租户数据被未授权访问","攻击者利用 Microsoft Entra Connect Health API 漏洞，未授权读取租户级元数据，并可能修改 Connect Health 监控配置。","事件提供了暴露数据类型、修复时间与客户无需更新的处置边界，也指出钓鱼风险和日志排查方向，便于受影响组织核对风险。",{"_92":244},"2026-11-21T18:01:58.000Z","2026-11-21T18:05:45.021Z",[130,162,242,234,265,177],77,"z2qvd5bzm4a0hvs2w49f6plyo","奥地利外交部网站遭入侵，外交人员工作联系方式泄露","奥地利外交部确认，其由外部服务商运营的网站于 November 12 至 November 13 遭未授权访问，攻击者查看了外交部总部及驻外外交机构人员的姓名和工作联系方式。",{"_92":278},"2026-11-21T18:22:52.000Z","2026-11-21T19:54:54.793Z",[130,242,187,234],48,"iepvrh0cnji8gnmctayok0ho0","Rackspace Spot 云平台遭入侵，攻击者读取客户 Kubernetes Secrets","攻击者使用泄露凭据入侵 Rackspace Spot 云平台，在部分客户组织中以合法用户身份创建 Kubernetes Pod、读取 Secrets，并列出节点和卷，受害凭据可能包括密码、认证令牌、API 密钥及 Spot API 令牌。","原文给出入侵时间窗、攻击者权限、泄露凭据类型和完整 IOC，客户可据此回溯集群、数据库及第三方服务中的异常访问。",{"_92":244},"2026-11-21T22:59:58.000Z","2026-11-21T23:50:45.254Z",[130,242,223,313,314,187],72,"云原生","容器","smbzmnzpvjtu63os8rqrsoxu8","FBI 调查 NCIC 全国刑事司法数据库疑似遭入侵事件","FBI 正调查其维护的 National Crime Information Center（NCIC）数据库疑似遭黑客入侵，该数据库向地方、州和联邦执法机构开放，保存逃犯、失踪人口、犯罪记录和被盗财物等信息。",{"_92":225},"2026-11-22T00:53:02.000Z","2026-11-22T01:42:45.599Z",[130,242,323],65,"网络设备","yudxba2psa3fg4ble9xs5jjj3","President Trump 任命 Kirsten Davies 为 National Cyber Director","President Trump 任命 Department of War CIO Kirsten Davies 出任 National Cyber Director，接替 Sean Cairncross。",{"_92":225},"2026-11-21T13:00:00.000Z","2026-11-22T01:42:45.605Z","policy",[333,334,145],24,"治理","行业动态","m2rhspo6lynif9g168qaa6ue2","Researchers uncover months of prompt theft across three AI inference providers","Dragos 通过 canary token 研究发现，攻击者从 3 家 AI inference provider 内部窃取数据数月，最早始于 7 月中旬；OpenRouter 因此移除 3 家提供商及 125 个 Zero Data Retention 端点并通知潜在受影响客户，但 OpenRouter 本身未遭入侵。","canary token 研究揭示了 AI 推理链路的隐蔽数据窃取方式，并给出路由器配置与凭据轮换等可迁移的排查思路。",{"_92":151},"2026-11-22T05:06:55.000Z","2026-11-22T06:45:16.657Z",[145,242,187,113,344,223,202],84,"AI 编码","tynuth71urn9723wgga79pff3","Ghostscript 沙箱逃逸 RCE CVE-2026-125396 可经文件上传触发","pwn.ai 演示了 Ghostscript 沙箱逃逸 RCE CVE-2026-125396，恶意文档可利用字体加载部分的 use-after-free 关闭 -dSAFER 检查并以低权限账户在服务器执行命令。",{"_92":151},"2026-11-22T05:03:41.000Z","2026-11-22T06:45:16.665Z",[201,88,89,91,163,355,356,243,150],{"_64":353,"_66":354},"s68hl88mb77wpvsqsv9cuf6as","Artifex Ghostscript -dSAFER 沙箱绕过漏洞 CVE-2026-125396 已复现","Debian","Red Hat","pkwned5oyao7mp6ha8bf6yy6w","USDA遭网络安全事件中断，部分农户贷款与支付服务","美国农业部（USDA）因网络安全事件关闭多项应用，导致农场服务局（FSA）贷款软件、自然资源保护局（NRCS）ProTracts支付与绘图系统及VPN出现中断。",{"_92":178},"2026-11-22T07:50:49.000Z","2026-11-22T08:04:21.988Z",[130,242,365,148,164,167],58,"应急响应","hyohmgbqvxgwj3o3h766rrbe5","Help Net Security 上周安全汇总：OpenJDK CVE-2026-114938 利用受限，Optimizely 恶意脚本波及 178 家机构","这是上周安全资讯汇总，涵盖 OpenJDK CVE-2026-114938、Puppet Enterprise CVE-2026-115731 等漏洞及多项攻击事件。",{"_92":375},"2026-11-22T09:00:25.000Z","2026-11-22T09:19:15.528Z",[374,130,162,176,242,145],11,"汇总","Help Net Security","Artifex Ghostscript < 10.08.0 的 -dSAFER 沙箱绕过漏洞 CVE-2026-125396 已被奇安信 CERT 复现，CVSS 4.0 分数为 8.5。","文章给出完整利用链、受影响版本和已公开 PoC，并覆盖发行版包、容器与应用升级等处置场景。",{"_92":386},"2026-11-22T04:43:00.000Z","2026-11-22T10:02:17.641Z",[89,88,90,163,201,383,384,355,385],85,"奇安信","Ubuntu","PHP","奇安信 CERT","ju5j6d455c4qfyc922e8nbvpc","Security Affairs 第 123 期恶意软件资讯汇总","Security Affairs 第 123 期恶意软件资讯汇总涵盖 13 篇文章与研究，包括新型 Rust RAT Linux/EasyShell、BO Team 软件供应链攻击及 SANSAR Linux 挖矿木马。",{"_92":278},"2026-11-22T13:56:43.000Z","2026-11-22T14:12:24.219Z",[374,176,130,395,133,131,234,202],6,"后门","z3q2em37fznpv04ctp578pqrz","Security Affairs 第 605 期国际版周报汇总多起漏洞、攻击与 AI 安全事件","Security Affairs 第 605 期国际版周报汇总多起漏洞披露、KEV 收录、网络攻击、AI 安全研究与供应链事件，涉及 Cisco Expressway、Apache Roller、Microsoft、Oracle 等产品。",{"_92":278},"2026-11-22T13:22:46.000Z","2026-11-22T14:12:24.229Z","blue-team",[374,134,164,404,187,145],"检测工程","rjnsitgoux45mdzzadt2bgf2y","Security Affairs 发布第 9 期 AI 网络安全新闻简报","Security Affairs 第 9 期 AI 网络安全新闻简报汇总多篇国际研究，覆盖 AI 驱动的威胁攻击、漏洞挖掘与防御工具。",{"_92":278},"2026-11-22T14:31:35.000Z","2026-11-22T15:13:24.887Z",[374,145,146,200,113,202,150,149,413],8,"阿里","atovtf3rgx78nodedw7k6h9cz","Cleverbridge 遭黑客入侵，支付卡号与 CVV/CVC 数据被窃","Cleverbridge 表示，黑客入侵其平台并窃取客户用于平台购物的支付卡号、到期日和 CVV/CVC 安全码，但未泄露姓名、联系方式或账单信息。公司于 2026 年 11 月 4 日发现未授权活动并临时下线系统，同日恢复后确认第三方复制了平台存储的支付卡数据；自 11 月 20 日起通知受影响客户，但尚未披露受影响客户数量、攻击者进入平台的方式、停留时间或数据是否加密。","材料披露了支付卡数据被窃的具体字段，并说明事件不属于勒索软件，为受影响客户评估风险和处置卡账户提供了直接依据。",{"_92":244},"2026-11-22T15:43:04.000Z","2026-11-22T15:59:15.526Z",[130,242,133,223,423],70,"合规","zvki2j4utchsalc6yciwwxfzn","Signal 推出防护措施，阻止 Siri 与 Gemini 读取 iOS 27、Android 上的聊天内容","Signal 宣布新防护机制：在 iOS 27 上阻止截图，在受支持的 Android 设备上阻止 AI 助手读取 Signal 会话内容，防止内置的 Siri 与 Gemini 在代办任务时抓取私密对话。",{"_92":244},"2026-11-22T15:15:25.000Z","2026-11-22T15:59:15.538Z",[148,145,113,147,149,150],62,"cpkja8bnlhxmi5kohgn7eye4s","VMware vCenter 认证绕过漏洞 CVE-2026-123890 已被在野利用","VMware vCenter 认证绕过漏洞 CVE-2026-123890 已被公开研究确认用于在野利用，长亭安全应急响应中心已完成复现验证。攻击者无需凭据，只需访问默认 TCP 2012 端口上的目录服务 RPC 接口，即可取得内置管理员会话，读取目录数据库、伪造 SSO 身份并创建管理员账号。","复现验证与在野利用线索并存，并给出受影响版本、管理端口前提和临时收敛措施，便于管理员判断风险与排查。",{"_92":442},"2026-11-22T12:04:00.000Z","2026-11-22T17:09:18.096Z",[103,89,162,163,88,166,441],89,"长亭","长亭安全应急响应中心","iev6ekudpzmsptqet6aneqgsg","帆软 FineReport FineVis（FVS）插件复用包导入未授权 RCE 漏洞已复现","帆软 FineReport 的 FineVis（FVS）插件存在未授权远程代码执行漏洞，攻击者无需账号或凭据即可上传并应用构造的 .mfvs 复用包，以应用进程权限执行任意系统命令。",{"_92":442},"2026-11-22T17:09:18.108Z",[103,89,88,90,163,441],61,"vhwsrs0gjyf9ww19y405j8l1j","Signal 限制 iOS 27 与 Android 上的 OS 级 AI Agent 读取屏幕","Signal 在 iOS 27 和 Android 上阻止 OS 级 AI Agent 读取其应用屏幕，防范 Gemini Intelligence 与 Siri AI 等功能捕获消息，macOS 暂未提供同等保护。",{"_92":278},"2026-11-22T18:01:22.000Z","2026-11-22T18:16:23.925Z",[145,457,146,148,150,149,234],"模型安全","i27aenxyu7ec3i7ftauologeu","攻击者利用 GL.iNet GoodCloud 漏洞感染路由器与 KVM 设备","攻击者已利用 GL.iNet GoodCloud 云远程管理服务漏洞，在客户路由器和 KVM 设备中安装恶意软件；部分设备出现 root 级反向 Shell，攻击基础设施包括 66.245.219[.]252 和 65.20.71[.]131。","原文结合厂商通告、恶意样本和设备实测还原攻击链，并给出固件版本、IOC 与处置建议，便于读者排查已感染设备。",{"_92":244},"2026-11-22T18:45:37.000Z","2026-11-22T18:50:16.542Z",[130,162,176,395,323,255],"c48fwxoopqq80m7prcwohu1ie","高管冒充如何蔓延至多个平台：账户、网站与复制身份材料处置分析","高管冒充可同时出现在社交媒体账户、仿冒网站及复制的高管照片、简介或公司标识中，删除单一账户或页面无法消除其他来源。安全与传播团队应协调核查各渠道的身份主张、复制材料及托管位置，并区分源头移除与搜索结果下架，避免把首个可见账户误认为全部风险。",{"_92":178},"2026-11-22T18:34:09.000Z","2026-11-22T19:15:22.335Z",[474,404,365,177],21,"蓝队","crev901dzpvdb813m8hwysdp6","syslog 时间戳格式简史：从 BSD 格式到 ISO-8601","Debian 12 和 Ubuntu 23.04 自 2023 年起不再默认安装 rsyslogd，改用 systemd journal，并移除 RSYSLOG_TraditionalFileFormat 配置指令，因此日志时间戳从历史 BSD 格式转为 ISO-8601 或 RFC 3339 格式。",{"_92":483},"2026-11-22T18:40:18.000Z","2026-11-22T19:16:16.927Z",[474,201,355,384,356],17,"SANS ISC","pnqtcxn4en4dooz4qywf8iz0i","Debian 13.8 发布，集中修复 Chromium、Firefox ESR、OpenJDK 25、nginx 等组件安全问题","Debian 项目发布 stable “trixie” 系列的第 8 次更新 Debian 13.8，包含 122 个软件包修复及 DSA-6408 至 DSA-6629 安全公告，覆盖 Chromium、Firefox ESR、OpenJDK 25、nginx、BIND 9、Dovecot、rsync、PostgreSQL 17 和 Linux kernel。",{"_92":375},"2026-11-22T23:05:09.000Z","2026-11-22T23:18:15.820Z",[492,163,474,493,355],33,"版本更新","操作系统","all","tag","q","tab","time",{"_500":501,"_502":-5},"changelogVersion","2026-10-01T08:00","release"]
