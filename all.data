80":235,"_82":236,"_84":115,"_86":87,"_88":-5},{"_64":220,"_66":221,"_68":222,"_70":-5,"_72":223,"_74":224,"_76":225,"_78":157,"_80":226,"_82":227,"_84":115,"_86":87,"_88":-5},{"_64":209,"_66":210,"_68":211,"_70":-5,"_72":212,"_74":213,"_76":214,"_78":131,"_80":215,"_82":216,"_84":115,"_86":87,"_88":-5},{"_64":196,"_66":197,"_68":198,"_70":-5,"_72":199,"_74":200,"_76":201,"_78":131,"_80":202,"_82":203,"_84":115,"_86":87,"_88":-5},{"_64":184,"_66":185,"_68":186,"_70":-5,"_72":187,"_74":188,"_76":189,"_78":157,"_80":190,"_82":191,"_84":85,"_86":87,"_88":-5,"_192":193},{"_64":170,"_66":171,"_68":172,"_70":-5,"_72":173,"_74":174,"_76":175,"_78":157,"_80":176,"_82":177,"_84":115,"_86":87,"_88":-5},{"_64":150,"_66":151,"_68":152,"_70":153,"_72":154,"_74":155,"_76":156,"_78":157,"_80":158,"_82":159,"_84":85,"_86":87,"_88":-5},{"_64":138,"_66":139,"_68":140,"_70":-5,"_72":141,"_74":142,"_76":143,"_78":131,"_80":144,"_82":145,"_84":115,"_86":87,"_88":-5},{"_64":125,"_66":126,"_68":127,"_70":-5,"_72":128,"_74":129,"_76":130,"_78":131,"_80":132,"_82":133,"_84":115,"_86":87,"_88":-5},{"_64":117,"_66":118,"_68":119,"_70":120,"_72":121,"_74":111,"_76":122,"_78":79,"_80":123,"_82":124,"_84":85,"_86":87,"_88":-5},{"_64":107,"_66":108,"_68":109,"_70":-5,"_72":110,"_74":111,"_76":112,"_78":79,"_80":113,"_82":114,"_84":115,"_86":87,"_88":-5},{"_64":97,"_66":98,"_68":99,"_70":100,"_72":101,"_74":75,"_76":102,"_78":79,"_80":103,"_82":104,"_84":85,"_86":87,"_88":-5},{"_64":65,"_66":67,"_68":69,"_70":71,"_72":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":83,"_84":85,"_86":87,"_88":-5},"id","sgciwtig86m8ho71b0h3a56f6","title","VMware vCenter 认证绕过漏洞 CVE-2026-123890 通告，官方已发布修复","summary","深瞳漏洞实验室于2026年11月20日发布漏洞通告，VMware vCenter 存在认证绕过漏洞 CVE-2026-123890，威胁等级为高危。","reason","通告给出了逐版本的受影响区间、无需凭据即可建立管理员会话的利用条件，以及各版本可用的补丁与升级路径，便于读者快速判断自身资产是否受影响。","source",{"_95":96},"publishedAt","2026-11-20T09:49:00.000Z","timelineAt","2026-11-20T17:23:31.424Z","category","vuln","tags",[89,90,91,92,93,94],"score",72,"selected",true,"channel","news","x","漏洞","补丁","漏洞分析","身份与访问","VMware","深信服","name","深信服千里目安全实验室","d8r57wa5dx4heczan7q6hz8i5","PHP 8.2至8.5系列曝出7个代码执行漏洞，官方已发布修复版本","深瞳漏洞实验室披露PHP组件7个严重代码执行漏洞，分别为CVE-2026-126714、CVE-2026-115560、CVE-2026-129289、CVE-2026-129474、CVE-2026-129496、CVE-2026-129182和CVE-2026-129481。","通告列出7个PHP代码执行漏洞的触发路径、影响版本和逐项缓解配置，便于安全团队核对资产并安排升级。",{"_95":96},"2026-11-20T17:23:31.436Z",[89,90,91,105,106,94],78,"供应链","PHP","m0fgnwuz8jy2ixu23xvd4pojv","Ruby 远程代码执行漏洞 CVE-2026-132825 影响 2.4.0 至 4.0.9","Ruby 远程代码执行漏洞 CVE-2026-132825 影响 2.4.0 至 3.3.13、3.4.0 至 3.4.12 和 4.0.0 至 4.0.9，CVSS 评分为 7.4。",{"_95":116},"2026-11-20T03:35:00.000Z","2026-11-20T17:23:34.033Z",[89,90,91],68,false,"绿盟科技CERT","ove2pi7map5xlnn8tjm9w03ev","PHP 远程代码执行漏洞 CVE-2026-126714 已公开并发布修复","PHP 远程代码执行漏洞 CVE-2026-126714（phpAfterShell）已被公开，CVSS 评分为 9.2。","通告列明受影响版本、会话处理器前提、临时缓解和修复版本，并提供人工与工具检测方法，便于评估和处置风险。",{"_95":116},"2026-11-20T17:23:34.134Z",[89,90,91,106],71,"gcqkdxgrkdjx8d44617xu023t","某国际律师事务所漏洞积压治理案例分析","Horizon3.ai 分析一家国际律师事务所如何依据漏洞对业务风险的实际影响确定修复优先级，而非仅依赖漏洞积压清单。该公司安全体系已较成熟，但管理层仍需识别可能造成重大暴露的弱点，衡量修复成效，并验证防御能力是否持续改善；正文未披露具体漏洞编号、CVSS 分数、版本范围、补丁状态或利用情况。",{"_95":137},"2026-11-20T16:23:15.000Z","2026-11-20T17:27:32.497Z","blue-team",[134,135,136],15,"蓝队","漏洞管理","加固","Horizon3.ai","dwi4vn3kcyazflhlygv3ywsiz","IoT 设备停止支持后如何保障智能家居安全","智能设备停止更新后会继续暴露于新发现且无法修复的漏洞，攻击者可能借此劫持路由器、控制门锁或摄像头，并将其用作进入 IT 网络的跳板。法国黑客近期利用 EoL 控制器漏洞提高超市冷藏柜温度，造成数千万欧元损失；ESET 建议优先更换 EoL 路由器，并隔离 IoT 网络、更新固件及启用 MFA。",{"_95":149},"2026-11-19T08:00:00.000Z","2026-11-20T17:27:35.730Z",[134,136,146,135,147,148],38,"IoT","合规","ESET","ESET WeLiveSecurity","mfif5csbm0luk6anr64r4hzho","攻击者利用自主 AI 工具 Cairn 攻陷 MONAI Label 漏洞并取得服务器权限","Amazon Threat Intelligence 发现疑似中国关联攻击者使用自主 AI Agent 平台 Cairn，于 2026 年 9 月 8 日至 10 日攻击中国境外东亚教育机构。","材料展示了 AI Agent 自主发现并利用漏洞的完整链路，以及失败尝试和修复时间，便于评估防御响应压力。",{"_95":169},"2026-11-20T17:30:00.000Z","2026-11-20T17:56:29.606Z","activity",[160,161,162,163,164,165,166,167,168],84,"攻击活动","AI 攻防","在野利用","漏洞利用","大模型","Agent 安全","AWS","Google","CISA","BleepingComputer","a1k31m3bej8p4gcnn5qifspw2","Bazuka Android 恶意软件利用虚假屏幕覆盖窃取凭据并控制设备","ThreatFabric 披露此前未知的 Android 恶意软件框架 Bazuka，由 dropper/downloader、核心组件和 23 个模块组成，支持屏幕覆盖、键盘记录、2FA 与 SMS 拦截、远程控制及加密货币地址替换。",{"_95":183},"2026-11-20T16:58:16.000Z","2026-11-20T18:10:30.471Z",[160,178,179,180,181,182],66,"恶意软件","钓鱼","数据窃取","AI 安全","移动端","The Hacker News","dcch6vrh267pbs79iv9qncpeu","AWS 披露 Cairn AI Agent 自主发现零日漏洞并攻击高校","Amazon Threat Intelligence 披露，中国关联威胁行为者使用开源自主 AI 渗透框架 Cairn，以“获取 shell 访问权限”为目标攻击中国境外东亚高校。",{"_95":195},"2026-11-20T17:30:13.000Z","2026-11-20T18:30:32.890Z",[160,162,181,165,163,194,166],77,"sameEvent",{"_64":150,"_66":151},"后门","AWS Security Blog","qvqcodqacgxzkdvc5k4rcmnij","Microsoft 入选 2026 Gartner® Magic Quadrant™ SIEM 领导者","Microsoft 再次获评 2026 Gartner® Magic Quadrant™ SIEM 领导者，其云原生 Microsoft Sentinel 汇集多云安全数据、威胁情报、分析与自动化，支持威胁狩猎、调查和响应。产品拥有 500 多个连接器；Microsoft Defender 中的 ISOC 于 2026 年 9 月 23 日推出，客户勒索软件攻击平均在 30 秒内被中断。",{"_95":208},"2026-11-20T17:00:00.000Z","2026-11-20T18:30:34.458Z",[204,205,206,181,207],12,"工具评测","安全运营","检测工程","Microsoft","Microsoft Security Blog","b5wzzrfgiaei8s2xexnsnqx5s","Chrome Dev 桌面版更新至 160.0.8171.0，覆盖 Windows、Mac 和 Linux","Chrome Dev channel 已更新至 160.0.8171.0，面向 Windows、Mac 和 Linux 平台提供部分变更记录。开发者可通过 Git log 查看变更详情，并可提交 bug 或前往社区帮助论坛反馈新问题、寻求协助。",{"_95":219},"2026-11-20T17:58:33.217Z","2026-11-20T18:30:38.146Z",[217,167,218],5,"版本更新","浏览器","Chrome Releases","wo6gb97t314hexogr26ggh5vz","Bell Canada 确认“智能体型”攻击者入侵系统并窃取企业客户数据","Bell Canada 确认，“智能体型”威胁行为者于 2026 年 11 月 17 日访问其多个系统，并从用于订购和配置电信电路的 Maximo 预生产环境中外泄企业客户数据，可能涉及名称、职位、企业邮箱、电话号码、业务地址、工单标题及部分 IP 地址。",{"_95":169},"2026-11-20T18:51:43.000Z","2026-11-20T18:54:28.967Z",[160,228,161,181,105,168],62,"数据泄露","szuqg9yw24zps1x5oum3svtpd","WhatsApp 修复 3 个安全漏洞，CVE-2026-23871 被疑用于增强诈骗可信度","WhatsApp 修复了 3 个安全漏洞，其中 CVE-2026-23871 影响 2.26.17.4 之前的 WhatsApp for Android 和 WhatsApp Business for Android。",{"_95":183},"2026-11-20T17:57:20.000Z","2026-11-20T19:11:30.274Z",[89,90,162,182,167],56,"n4ofqxy9t8a16ffvq88yrwk97","Dark Reading：网络安全中，清晰严谨的沟通是重要的前沿防御能力","清晰、严谨的沟通已成为企业网络安全的前沿防御能力，其重要性不亚于安全工具。面向云安全和 AI 等议题，cyber leaders 需要借助 disciplined communication 统一认知并有效应对风险。",{"_95":244},"2026-11-20T18:35:40.000Z","2026-11-20T19:31:35.556Z",[134,205,164],"Dark Reading","fc9rm3jisc27k5d323mfyarm8","Dark Reading 盘点未报道安全资讯：Nvidia CEO 辞职风波与 Microsoft 云服务中断","Dark Reading 编辑盘点未能在节目中报道的两项安全资讯：Nvidia CEO Jensen Huang 辞职，以及 Microsoft 近期发生云服务中断。正文未提供相关事件的具体日期、影响范围、漏洞编号、CVSS 分数、攻击活动或处置建议。",{"_95":244},"2026-11-20T17:04:04.000Z","2026-11-20T19:31:35.565Z",[253,254,207],21,"汇总","行业动态","sjin4pr8q1dp00z0igue1371g","CISA将4个漏洞纳入KEV Catalog，均有真实利用证据","CISA将CVE-2025-42884、CVE-2026-76466、CVE-2026-123890和CVE-2026-129448纳入KEV Catalog，依据是这些漏洞已有在野利用证据，分别涉及SAP NetWeaver、Cisco Expressway Series、VMWare vCenter和Apache Roller。","CISA依据真实利用证据将4个漏洞纳入KEV Catalog，并明确联邦机构应优先修复暴露资产上的相关缺陷。",{"_95":263},"2026-11-20T12:00:00.000Z","2026-11-20T19:32:29.280Z",[162,135,90,168,93],"CISA 安全公告","jszry2ckucax402ve9a7rmc3m","Cloudflare WAF 防护 ruby2shell 漏洞 CVE-2026-132825 及 GHSA-87fm-7w84-j2px","Cloudflare WAF 已为 ruby2shell（CVE-2026-132825）及相关整数溢出 GHSA-87fm-7w84-j2px 启用默认阻断规则，Free 计划自动生效，付费计划需确认 Cloudflare Managed Ruleset 已部署。","文章同时说明漏洞触发条件、Cloudflare WAF 规则覆盖范围及绕过边界，为无法立即升级 Ruby 的团队提供临时防护与处置依据。",{"_95":275},"2026-11-20T20:24:38.000Z","2026-11-20T20:32:32.974Z",[89,90,272,91,273,274],"复现","云原生","Cloudflare","Cloudflare Blog","xc4re3fqbv7j3asqraazbq4h2","PHP phpAfterShell 远程代码执行漏洞 CVE-2026-126714 已修复，Cloudflare WAF 已更新检测","Cloudflare 介绍 PHP 默认文件会话处理器漏洞 phpAfterShell（CVE-2026-126714），该漏洞 CVSS v4.0 为 9.2 分，可因会话文件写入中断并在后续反序列化时导致远程代码执行。","文章梳理了 phpAfterShell 的触发原理、受影响版本与利用前提，并说明 Cloudflare WAF 规则、补丁和临时缓解措施。",{"_95":275},"2026-11-20T20:00:45.000Z","2026-11-20T20:32:32.984Z",[285,217,91,135,136,274,106],80,"工具发布","rm7jvkt25c6fioq28glydfbu9","Chrome Dev for Android 发布 160.0.8171.0 更新","Google Chrome Release Team 面向 Android 发布 Chrome Dev 160（160.0.8171.0），现可通过 Google Play 获取。变更仅部分记录于 Git log，新功能详情见 Chromium blog，Web 平台更新亦有专门说明；发现新问题可提交 bug。",{"_95":219},"2026-11-20T19:13:32.556Z","2026-11-20T20:32:38.546Z",[217,218,182,167],2,"b7fagpjz2rm06udejoz3syyf2","Cisco 排查 nginx 远程代码执行漏洞对产品的影响","Cisco PSIRT 通报 nginx 1.9.5 至 1.31.8 存在多个可能导致远程代码执行的严重漏洞，已在 1.31.9 和 1.30.7 修复，涉及 CVE-2026-113425、CVE-2026-121810、CVE-2026-123007、CVE-2026-123633、CVE-2026-123634。","通告列明 nginx 多个漏洞的受影响版本、Cisco 产品排查状态和首批修复版本，便于相关用户核对暴露范围与升级路径。",{"_95":305},"2026-11-20T08:00:00.000Z","2026-11-20T20:33:30.286Z",[89,90,272,303,304],70,"Cisco","网络设备","Cisco PSIRT","vt4gd1d2m0q2e5cxg60jzp1ja","GreenJuliett 将 AI 纳入 OT 攻击链并扩大 FortiGate 扫描范围","Recorded Future 观测到 GreenJuliett 将 AI 纳入 OT 攻击链，用于识别脆弱设备类型并编写针对 PLC 与工业协议的脚本。该组织在巴林、以色列、约旦、科威特、沙特阿拉伯和卡塔尔扫描或尝试利用 Fortinet FortiGate，并可能将 IoT 与 CCTV 设备纳入目标。","文章追踪了 GreenJuliett 将 AI 引入 OT 攻击链的迹象及其针对 PLC、FortiGate 和 IoT 设备的扩张路径。",{"_95":316},"2026-11-20T00:00:00.000Z","2026-11-20T21:31:31.492Z",[160,178,161,314,146,315,167],"工控","Fortinet","Recorded Future","kma7fzomzyeif4ewssllao500","中国关联威胁组织“Armory Castle”利用 VMware vCenter 零日漏洞发动攻击","中国关联威胁组织“Armory Castle”可能在 VMware vCenter 最近一轮重大安全更新前已准备好下一项零日漏洞，并已对 VMware vCenter 发起攻击。原内容仅指出其可能提前掌握并利用该零日漏洞，未披露 CVE 编号、CVSS 分数、受影响版本、认证要求、补丁状态或具体受害范围。",{"_95":244},"2026-11-20T21:03:27.000Z","2026-11-20T21:33:35.719Z",[160,163,93],"y1q31smahyra1wu2i286xr7ey","Unit 42披露Com关联组织以语音钓鱼窃取数据并实施勒索","Unit 42追踪到Bling Libra及多个Com关联活动簇通过语音钓鱼和AiTM页面窃取凭据与MFA批准，随后借助原生云工具、脚本和恶意浏览器扩展定位高价值数据、批量外传并发送勒索信息。","材料结合遥测与事件响应还原了多组关联活动簇的入侵链、受害行业变化及恶意扩展能力，便于比较其数据窃取手法。",{"_95":335},"2026-11-20T22:00:25.000Z","2026-11-20T22:34:32.487Z",[160,178,179,228,333,92,334,167,207],81,"勒索","Palo Alto","Unit 42","ta63px1zploowah16uoi9l42d","AWS STS 发布 GetScopedCredentials，可收窄现有临时凭据权限","AWS 发布 AWS STS GetScopedCredentials API，可基于现有临时安全凭据生成权限和会话时长更小的凭据，适用于 AI Agent、子 Agent、CI/CD 与多租户应用。",{"_95":195},"2026-11-20T22:57:22.000Z","2026-11-20T23:35:35.509Z","ai-security",[181,165,285,164,345,92,166],65,"AI 编码","b1v2093hda318yigvkylrgnyr","WhatsApp 修复三个漏洞：CVE-2026-23871 已被用于诈骗活动","WhatsApp 11 月安全公告修复三个缺陷，其中 CVE-2026-23871 影响 2.26.17.4 之前的 WhatsApp 与 WhatsApp Business for Android。",{"_95":354},"2026-11-20T22:21:12.000Z","2026-11-20T23:35:38.435Z",[89,162,90,91,182,167],58,"Security Affairs","iq2iz30lkf9ipaquirzpf0i4i","Contao core-bundle 前端搜索结果存在存储型 XSS","Contao core-bundle 的旧版 search_default.html5 搜索模板未转义 link 变量，可能导致存储型 XSS，使页面编辑者植入的脚本在前台匿名访客及管理员查看搜索结果时执行。",{"_95":365},"2026-11-20T23:46:56.000Z","2026-11-20T23:47:29.925Z","disclosure",[91,272,89,364],41,"技术研究","GitHub 安全公告","ql8z19mw87u0y7njlw1p4sq74","Contao core-bundle 漏洞分析：theme_import 权限可绕过 tpl_editor 限制实现 RCE","Contao core-bundle 存在权限提升漏洞，受委托的用户或用户组管理员可为自己或所管理的账户添加 theme_import 权限，进而在服务器上执行任意 PHP。","文章通过权限校验差异与 Contao 5.7.9 复现步骤，说明 theme_import 如何绕过 tpl_editor 的限制并形成服务器端代码执行链。",{"_95":365},"2026-11-20T23:45:41.000Z","2026-11-20T23:47:29.940Z",[89,272,163,91],"fkqayvzt4f4t39oxkwzmt4ic2","contao/core-bundle CSV 导入向导存在不当访问控制漏洞","contao/core-bundle 的 CSV 导入向导存在不当访问控制问题，Backend::getBackendModule() 仅检查模块访问权限，未执行逐记录 voter。",{"_95":365},"2026-11-20T23:44:33.000Z","2026-11-20T23:47:29.953Z",[89,91],39,"m585oce8djta6o1f27v7oet43","Contao newsletter-bundle 自定义操作可绕过渠道级授权","Contao newsletter-bundle 的 newsletter 自定义 key-actions 仅经过模块级 USER_CAN_ACCESS_MODULE 检查，未执行 DC_Table 的逐记录 ReadAction 授权。受限编辑者因此可向无权编辑的渠道注入收件人、群发邮件，并在部分版本中删除或拒绝收件人，破坏按渠道划分的权限模型。该漏洞由 @HDWSec 发现。",{"_95":365},"2026-11-20T23:43:26.000Z","2026-11-20T23:47:29.966Z",[89,91,92],"nx3ab7e212lefg2qjv3go0r50","memtomem-stm 并发 LTM 恢复或重复重连并复用已取消的传输会话","memtomem-stm 的并发 LTM 恢复可能为同一脏会话触发多次重连，重连重试期间取消操作还可能使替换会话在协议交换中断后仍可复用。重复重连问题自 0.1.24 引入，取消恢复问题影响原文列明的更广版本范围；私有修复通过单调会话代次、每代次仅允许一次受保护的共享重连及代次感知取消处理进行修复。",{"_95":365},"2026-11-20T23:38:15.000Z","2026-11-20T23:47:29.986Z",[89,90],35,"seorox8a2y4prqsc6v83k4ido","memtomem-stm 漏洞：未信任记忆数据可突破 Markdown 兼容边界","memtomem-stm 项目披露其 surfaced-memory 封装存在结构边界问题：未经信任的长期记忆与工作记忆字段可注入 Markdown 或 HTML 兼容结构，构造的记忆会制造误导性的结构边界或在视觉上隐藏内容。修复方式为将每个不可信字段序列化为惰性单行数据、校验可复制的记忆标识，并固定显式的不可信数据前置说明。原文同时指出，自然语言层面的说服仍属于残余的模型级风险。",{"_95":365},"2026-11-20T23:37:39.000Z","2026-11-20T23:47:29.993Z",[89,90,181,164],47,"ein9qpswsjg5316ucn0jmg2pa","AIT-GUI 2.5.0 路径绕过导致未认证 Python 远程代码执行","AIT-GUI 2.5.0 的路由链可导致未认证远程代码执行。",{"_95":365},"2026-11-20T23:36:41.000Z","2026-11-20T23:47:30.001Z",[89,272,163,364,304],"e0j66awv4bl7605jwufua086n","sevenz-rust2 解压 .7z 存在 Zip-Slip 路径穿越漏洞，v0.21.1 已修复","sevenz-rust2 在解压 .7z 时直接用 dest.join(entry.name()) 拼接输出路径，未做路径归一化也未校验 starts_with(dest)。",{"_95":365},"2026-11-20T23:33:14.000Z","2026-11-20T23:47:30.009Z",[89,272,163,90],64,"vvyafyv7zjwuz1h4f8znsj5xe","Aedes MQTT Broker 远程 DoS 漏洞可因深度递归主题导致进程崩溃","Aedes MQTT Broker 存在远程拒绝服务漏洞，远程客户端可通过 PUBLISH、SUBSCRIBE 或设置包含数千个“/”分隔符的 Will 主题触发未捕获异常，使 Node.js 代理进程崩溃。",{"_95":365},"2026-11-20T23:32:35.000Z","2026-11-20T23:47:30.016Z",[89,272,163,364,428],61,"Node.js","b1tpaodswkwwqwo4toaf4wj04","nats-server leaf node 连接绕过 Nats-Trace-Dest 权限检查","nats-server 的消息追踪目标权限检查未一致地应用于 leaf node 连接，低信任节点可向原本不允许的主题发送追踪事件，并借助仅追踪行为阻止受影响消息的正常投递或存储。受影响版本包括 v2.14.2、v2.12.7 及以下版本，问题已在 v2.14.3 和 v2.12.8 中修复；除升级外，建议在可能情况下避免向低信任 leaf node 授予会受仅追踪行为影响主题的发布路径。",{"_95":365},"2026-11-20T23:31:59.000Z","2026-11-20T23:47:30.022Z",[89,90,91],"osh9ytemzq0ghokp3paqx9njr","Budibase v3.44.0-cloud.2 初始化接口存在租户混淆与未认证全局管理员创建漏洞","Budibase v3.44.0-cloud.2 的 `POST /api/global/users/init` 在单租户自托管部署中可被未认证攻击者利用，攻击者提交任意未使用的 `tenantId` 即可绕过一次性初始化检查并创建 `_global-db` 与全局管理员用户。",{"_95":365},"2026-11-20T23:50:01.000Z","2026-11-21T00:04:29.864Z",[89,272,163,91],69,"vm1xmd7ljv0a68cnqboc2bzt4","Budibase Builder 跨权限存储型 XSS 漏洞分析与 PoC","Budibase v3.44.0 的 Builder 存在跨权限存储型 XSS：BASIC 用户或未认证访问者可将 HTML/JavaScript 载荷写入共享外部数据源，builder 或 admin 预览绑定时会在 Builder 源内执行。",{"_95":365},"2026-11-20T23:49:47.000Z","2026-11-21T00:04:29.871Z",[91,272,163,452],63,"利用链","up0vdsfzc0lkil51u7432afgp","wcmatch 默认标志下多星号模式可触发多项式时间 ReDoS","wcmatch 在默认标志下使用包含多个 `*` 的模式匹配不可信文件名时存在 ReDoS，模式通常为开发者常量，攻击者仅需控制被匹配字符串。",{"_95":365},"2026-11-20T23:49:18.000Z","2026-11-21T00:04:29.878Z",[89,272,91,163],46,"oyjs8la07x3eu6gnbxq4d19rb","Inscriptis get_text() 因兄弟元素导致内存二次增长并可触发 DoS","Inscriptis 的 get_text() 会因每个表格留下额外缩进记录，使输出大小和内存占用随表格数量呈二次增长；该问题自 2.0 起存在。",{"_95":365},"2026-11-20T23:48:51.000Z","2026-11-21T00:04:29.884Z",[89,272,163,469,164],67,"AI 供应链","rxd9qlw8ug0ngyxo7cwloos69","svglib 嵌套 SVG 引用导致 CPU 与内存耗尽","svglib 的 svg2rlg() 对嵌套 SVG 引用缺乏总量限制，攻击者控制的文档可触发指数级展开并造成拒绝服务。受影响版本为 <= 2.3.0，原文在 2.3.0 和 1.5.1 上均验证；1409 B 的 5 层样本耗时 34 s、峰值内存 469 MiB，xhtml2pdf 场景可达 78.7 s 和 499 MiB。原文建议将单文档扩展次数限制为 10,000，并补充了回归测试。",{"_95":365},"2026-11-20T23:47:58.000Z","2026-11-21T00:04:29.890Z",[89,272,91,452],51,"all","tag","q","tab","time",{"_484":485,"_486":-5},"changelogVersion","2026-10-01T08:00","release"]
