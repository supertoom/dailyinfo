":233,"_74":234,"_76":235,"_78":118,"_80":236,"_82":237,"_84":106,"_86":87,"_88":-5},{"_64":223,"_66":224,"_68":225,"_70":-5,"_72":226,"_74":227,"_76":228,"_78":118,"_80":229,"_82":193,"_84":106,"_86":87,"_88":-5},{"_64":215,"_66":216,"_68":217,"_70":-5,"_72":218,"_74":219,"_76":220,"_78":118,"_80":221,"_82":222,"_84":106,"_86":87,"_88":-5},{"_64":207,"_66":208,"_68":209,"_70":210,"_72":211,"_74":212,"_76":213,"_78":118,"_80":214,"_82":120,"_84":85,"_86":87,"_88":-5},{"_64":196,"_66":197,"_68":198,"_70":-5,"_72":199,"_74":200,"_76":201,"_78":202,"_80":203,"_82":204,"_84":106,"_86":87,"_88":-5},{"_64":186,"_66":187,"_68":188,"_70":-5,"_72":189,"_74":190,"_76":191,"_78":118,"_80":192,"_82":193,"_84":106,"_86":87,"_88":-5},{"_64":171,"_66":172,"_68":173,"_70":-5,"_72":174,"_74":175,"_76":176,"_78":177,"_80":178,"_82":179,"_84":106,"_86":87,"_88":-5},{"_64":155,"_66":156,"_68":157,"_70":158,"_72":159,"_74":160,"_76":161,"_78":134,"_80":162,"_82":163,"_84":85,"_86":87,"_88":-5},{"_64":144,"_66":145,"_68":146,"_70":-5,"_72":147,"_74":148,"_76":149,"_78":134,"_80":150,"_82":151,"_84":106,"_86":87,"_88":-5},{"_64":127,"_66":128,"_68":129,"_70":130,"_72":131,"_74":132,"_76":133,"_78":134,"_80":135,"_82":136,"_84":85,"_86":87,"_88":-5},{"_64":111,"_66":112,"_68":113,"_70":114,"_72":115,"_74":116,"_76":117,"_78":118,"_80":119,"_82":120,"_84":85,"_86":87,"_88":-5},{"_64":98,"_66":99,"_68":100,"_70":-5,"_72":101,"_74":102,"_76":103,"_78":79,"_80":104,"_82":105,"_84":106,"_86":87,"_88":-5},{"_64":65,"_66":67,"_68":69,"_70":71,"_72":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":83,"_84":85,"_86":87,"_88":-5},"id","xc4re3fqbv7j3asqraazbq4h2","title","PHP phpAfterShell 远程代码执行漏洞 CVE-2026-126714 已修复，Cloudflare WAF 已更新检测","summary","Cloudflare 介绍 PHP 默认文件会话处理器漏洞 phpAfterShell（CVE-2026-126714），该漏洞 CVSS v4.0 为 9.2 分，可因会话文件写入中断并在后续反序列化时导致远程代码执行。","reason","文章梳理了 phpAfterShell 的触发原理、受影响版本与利用前提，并说明 Cloudflare WAF 规则、补丁和临时缓解措施。","source",{"_96":97},"publishedAt","2026-11-20T20:00:45.000Z","timelineAt","2026-11-20T20:32:32.984Z","category","blue-team","tags",[89,90,91,92,93,94,95],"score",80,"selected",true,"channel","news","x","工具发布","版本更新","漏洞分析","漏洞管理","加固","Cloudflare","PHP","name","Cloudflare Blog","rm7jvkt25c6fioq28glydfbu9","Chrome Dev for Android 发布 160.0.8171.0 更新","Google Chrome Release Team 面向 Android 发布 Chrome Dev 160（160.0.8171.0），现可通过 Google Play 获取。变更仅部分记录于 Git log，新功能详情见 Chromium blog，Web 平台更新亦有专门说明；发现新问题可提交 bug。",{"_96":110},"2026-11-20T19:13:32.556Z","2026-11-20T20:32:38.546Z",[90,107,108,109],2,false,"浏览器","移动端","Google","Chrome Releases","b7fagpjz2rm06udejoz3syyf2","Cisco 排查 nginx 远程代码执行漏洞对产品的影响","Cisco PSIRT 通报 nginx 1.9.5 至 1.31.8 存在多个可能导致远程代码执行的严重漏洞，已在 1.31.9 和 1.30.7 修复，涉及 CVE-2026-113425、CVE-2026-121810、CVE-2026-123007、CVE-2026-123633、CVE-2026-123634。","通告列明 nginx 多个漏洞的受影响版本、Cisco 产品排查状态和首批修复版本，便于相关用户核对暴露范围与升级路径。",{"_96":126},"2026-11-20T08:00:00.000Z","2026-11-20T20:33:30.286Z","vuln",[121,122,123,124,125],70,"漏洞","补丁","复现","Cisco","网络设备","Cisco PSIRT","vt4gd1d2m0q2e5cxg60jzp1ja","GreenJuliett 将 AI 纳入 OT 攻击链并扩大 FortiGate 扫描范围","Recorded Future 观测到 GreenJuliett 将 AI 纳入 OT 攻击链，用于识别脆弱设备类型并编写针对 PLC 与工业协议的脚本。该组织在巴林、以色列、约旦、科威特、沙特阿拉伯和卡塔尔扫描或尝试利用 Fortinet FortiGate，并可能将 IoT 与 CCTV 设备纳入目标。","文章追踪了 GreenJuliett 将 AI 引入 OT 攻击链的迹象及其针对 PLC、FortiGate 和 IoT 设备的扩张路径。",{"_96":143},"2026-11-20T00:00:00.000Z","2026-11-20T21:31:31.492Z","activity",[137,138,139,140,141,142,109],72,"攻击活动","恶意软件","AI 攻防","工控","IoT","Fortinet","Recorded Future","kma7fzomzyeif4ewssllao500","中国关联威胁组织“Armory Castle”利用 VMware vCenter 零日漏洞发动攻击","中国关联威胁组织“Armory Castle”可能在 VMware vCenter 最近一轮重大安全更新前已准备好下一项零日漏洞，并已对 VMware vCenter 发起攻击。原内容仅指出其可能提前掌握并利用该零日漏洞，未披露 CVE 编号、CVSS 分数、受影响版本、认证要求、补丁状态或具体受害范围。",{"_96":154},"2026-11-20T21:03:27.000Z","2026-11-20T21:33:35.719Z",[137,152,153],38,"漏洞利用","VMware","Dark Reading","y1q31smahyra1wu2i286xr7ey","Unit 42披露Com关联组织以语音钓鱼窃取数据并实施勒索","Unit 42追踪到Bling Libra及多个Com关联活动簇通过语音钓鱼和AiTM页面窃取凭据与MFA批准，随后借助原生云工具、脚本和恶意浏览器扩展定位高价值数据、批量外传并发送勒索信息。","材料结合遥测与事件响应还原了多组关联活动簇的入侵链、受害行业变化及恶意扩展能力，便于比较其数据窃取手法。",{"_96":170},"2026-11-20T22:00:25.000Z","2026-11-20T22:34:32.487Z",[137,138,164,165,166,167,168,109,169],81,"钓鱼","数据泄露","勒索","身份与访问","Palo Alto","Microsoft","Unit 42","ta63px1zploowah16uoi9l42d","AWS STS 发布 GetScopedCredentials，可收窄现有临时凭据权限","AWS 发布 AWS STS GetScopedCredentials API，可基于现有临时安全凭据生成权限和会话时长更小的凭据，适用于 AI Agent、子 Agent、CI/CD 与多租户应用。",{"_96":185},"2026-11-20T22:57:22.000Z","2026-11-20T23:35:35.509Z","ai-security",[180,181,89,182,183,167,184],65,"AI 安全","Agent 安全","大模型","AI 编码","AWS","AWS Security Blog","b1v2093hda318yigvkylrgnyr","WhatsApp 修复三个漏洞：CVE-2026-23871 已被用于诈骗活动","WhatsApp 11 月安全公告修复三个缺陷，其中 CVE-2026-23871 影响 2.26.17.4 之前的 WhatsApp 与 WhatsApp Business for Android。",{"_96":195},"2026-11-20T22:21:12.000Z","2026-11-20T23:35:38.435Z",[121,194,122,91,108,109],58,"在野利用","Security Affairs","iq2iz30lkf9ipaquirzpf0i4i","Contao core-bundle 前端搜索结果存在存储型 XSS","Contao core-bundle 的旧版 search_default.html5 搜索模板未转义 link 变量，可能导致存储型 XSS，使页面编辑者植入的脚本在前台匿名访客及管理员查看搜索结果时执行。",{"_96":206},"2026-11-20T23:46:56.000Z","2026-11-20T23:47:29.925Z","disclosure",[91,123,121,205],41,"技术研究","GitHub 安全公告","ql8z19mw87u0y7njlw1p4sq74","Contao core-bundle 漏洞分析：theme_import 权限可绕过 tpl_editor 限制实现 RCE","Contao core-bundle 存在权限提升漏洞，受委托的用户或用户组管理员可为自己或所管理的账户添加 theme_import 权限，进而在服务器上执行任意 PHP。","文章通过权限校验差异与 Contao 5.7.9 复现步骤，说明 theme_import 如何绕过 tpl_editor 的限制并形成服务器端代码执行链。",{"_96":206},"2026-11-20T23:45:41.000Z","2026-11-20T23:47:29.940Z",[121,123,152,91],"fkqayvzt4f4t39oxkwzmt4ic2","contao/core-bundle CSV 导入向导存在不当访问控制漏洞","contao/core-bundle 的 CSV 导入向导存在不当访问控制问题，Backend::getBackendModule() 仅检查模块访问权限，未执行逐记录 voter。",{"_96":206},"2026-11-20T23:44:33.000Z","2026-11-20T23:47:29.953Z",[121,91],39,"m585oce8djta6o1f27v7oet43","Contao newsletter-bundle 自定义操作可绕过渠道级授权","Contao newsletter-bundle 的 newsletter 自定义 key-actions 仅经过模块级 USER_CAN_ACCESS_MODULE 检查，未执行 DC_Table 的逐记录 ReadAction 授权。受限编辑者因此可向无权编辑的渠道注入收件人、群发邮件，并在部分版本中删除或拒绝收件人，破坏按渠道划分的权限模型。该漏洞由 @HDWSec 发现。",{"_96":206},"2026-11-20T23:43:26.000Z","2026-11-20T23:47:29.966Z",[121,91,167],"nx3ab7e212lefg2qjv3go0r50","memtomem-stm 并发 LTM 恢复或重复重连并复用已取消的传输会话","memtomem-stm 的并发 LTM 恢复可能为同一脏会话触发多次重连，重连重试期间取消操作还可能使替换会话在协议交换中断后仍可复用。重复重连问题自 0.1.24 引入，取消恢复问题影响原文列明的更广版本范围；私有修复通过单调会话代次、每代次仅允许一次受保护的共享重连及代次感知取消处理进行修复。",{"_96":206},"2026-11-20T23:38:15.000Z","2026-11-20T23:47:29.986Z",[121,122],35,"seorox8a2y4prqsc6v83k4ido","memtomem-stm 漏洞：未信任记忆数据可突破 Markdown 兼容边界","memtomem-stm 项目披露其 surfaced-memory 封装存在结构边界问题：未经信任的长期记忆与工作记忆字段可注入 Markdown 或 HTML 兼容结构，构造的记忆会制造误导性的结构边界或在视觉上隐藏内容。修复方式为将每个不可信字段序列化为惰性单行数据、校验可复制的记忆标识，并固定显式的不可信数据前置说明。原文同时指出，自然语言层面的说服仍属于残余的模型级风险。",{"_96":206},"2026-11-20T23:37:39.000Z","2026-11-20T23:47:29.993Z",[121,122,180,182],47,"ein9qpswsjg5316ucn0jmg2pa","AIT-GUI 2.5.0 路径绕过导致未认证 Python 远程代码执行","AIT-GUI 2.5.0 的路由链可导致未认证远程代码执行。",{"_96":206},"2026-11-20T23:36:41.000Z","2026-11-20T23:47:30.001Z",[121,123,152,205,125],"e0j66awv4bl7605jwufua086n","sevenz-rust2 解压 .7z 存在 Zip-Slip 路径穿越漏洞，v0.21.1 已修复","sevenz-rust2 在解压 .7z 时直接用 dest.join(entry.name()) 拼接输出路径，未做路径归一化也未校验 starts_with(dest)。",{"_96":206},"2026-11-20T23:33:14.000Z","2026-11-20T23:47:30.009Z",[121,123,152,122],64,"vvyafyv7zjwuz1h4f8znsj5xe","Aedes MQTT Broker 远程 DoS 漏洞可因深度递归主题导致进程崩溃","Aedes MQTT Broker 存在远程拒绝服务漏洞，远程客户端可通过 PUBLISH、SUBSCRIBE 或设置包含数千个“/”分隔符的 Will 主题触发未捕获异常，使 Node.js 代理进程崩溃。",{"_96":206},"2026-11-20T23:32:35.000Z","2026-11-20T23:47:30.016Z",[121,123,152,205,269],61,"Node.js","b1tpaodswkwwqwo4toaf4wj04","nats-server leaf node 连接绕过 Nats-Trace-Dest 权限检查","nats-server 的消息追踪目标权限检查未一致地应用于 leaf node 连接，低信任节点可向原本不允许的主题发送追踪事件，并借助仅追踪行为阻止受影响消息的正常投递或存储。受影响版本包括 v2.14.2、v2.12.7 及以下版本，问题已在 v2.14.3 和 v2.12.8 中修复；除升级外，建议在可能情况下避免向低信任 leaf node 授予会受仅追踪行为影响主题的发布路径。",{"_96":206},"2026-11-20T23:31:59.000Z","2026-11-20T23:47:30.022Z",[121,122,91],53,"osh9ytemzq0ghokp3paqx9njr","Budibase v3.44.0-cloud.2 初始化接口存在租户混淆与未认证全局管理员创建漏洞","Budibase v3.44.0-cloud.2 的 `POST /api/global/users/init` 在单租户自托管部署中可被未认证攻击者利用，攻击者提交任意未使用的 `tenantId` 即可绕过一次性初始化检查并创建 `_global-db` 与全局管理员用户。",{"_96":206},"2026-11-20T23:50:01.000Z","2026-11-21T00:04:29.864Z",[121,123,152,91],69,"vm1xmd7ljv0a68cnqboc2bzt4","Budibase Builder 跨权限存储型 XSS 漏洞分析与 PoC","Budibase v3.44.0 的 Builder 存在跨权限存储型 XSS：BASIC 用户或未认证访问者可将 HTML/JavaScript 载荷写入共享外部数据源，builder 或 admin 预览绑定时会在 Builder 源内执行。",{"_96":206},"2026-11-20T23:49:47.000Z","2026-11-21T00:04:29.871Z",[91,123,152,294],63,"利用链","up0vdsfzc0lkil51u7432afgp","wcmatch 默认标志下多星号模式可触发多项式时间 ReDoS","wcmatch 在默认标志下使用包含多个 `*` 的模式匹配不可信文件名时存在 ReDoS，模式通常为开发者常量，攻击者仅需控制被匹配字符串。",{"_96":206},"2026-11-20T23:49:18.000Z","2026-11-21T00:04:29.878Z",[121,123,91,152],46,"oyjs8la07x3eu6gnbxq4d19rb","Inscriptis get_text() 因兄弟元素导致内存二次增长并可触发 DoS","Inscriptis 的 get_text() 会因每个表格留下额外缩进记录，使输出大小和内存占用随表格数量呈二次增长；该问题自 2.0 起存在。",{"_96":206},"2026-11-20T23:48:51.000Z","2026-11-21T00:04:29.884Z",[121,123,152,311,182],67,"AI 供应链","rxd9qlw8ug0ngyxo7cwloos69","svglib 嵌套 SVG 引用导致 CPU 与内存耗尽","svglib 的 svg2rlg() 对嵌套 SVG 引用缺乏总量限制，攻击者控制的文档可触发指数级展开并造成拒绝服务。受影响版本为 <= 2.3.0，原文在 2.3.0 和 1.5.1 上均验证；1409 B 的 5 层样本耗时 34 s、峰值内存 469 MiB，xhtml2pdf 场景可达 78.7 s 和 499 MiB。原文建议将单文档扩展次数限制为 10,000，并补充了回归测试。",{"_96":206},"2026-11-20T23:47:58.000Z","2026-11-21T00:04:29.890Z",[121,123,91,294],51,"jx8xbqv4flmkp7i7nzhtpw5ck","RansomwareHelp 联合创始人 Juan Ricardo Palacio Escobar 被控电信欺诈，曾秘密向 Lockbit 购买解密密钥","FBI 卧底行动发现，佛州数据恢复公司 ransomwarehelp.com 的 CTO 兼联合创始人 Juan Ricardo Palacio Escobar（52 岁）实为向勒索团伙付钱购买解密密钥、再向客户加价收费，网站宣称「100% 数据恢复」和「99% 成功率」纯属虚构，其网站现已关停。",{"_96":330},"2026-11-21T00:36:39.000Z","2026-11-21T01:35:34.782Z",[137,166,327,328,329],"黑产","数据窃取","安全运营","Krebs on Security","weld60yqsg670rjsdtn2mp4ts","Signal 在 Android 和 iOS 默认限制截图，防止 AI Agent 读取私密聊天","Signal 宣布在 Android 和 iOS 默认限制截图，阻止内置于 iOS 27 及可检测 AI 助手的 Android 系统中的 AI Agent 读取聊天内容，但承认该措施仍不完整。",{"_96":340},"2026-11-21T08:49:20.000Z","2026-11-21T09:24:45.965Z",[180,181,108,93,339,109],59,"Apple","The Hacker News","jbitkvf4i6iewvak8ejgx9cvb","CISA 将 Apache Roller、Cisco Expressway、SAP NetWeaver 和 VMware vCenter 四项漏洞列入 KEV","CISA 将 Apache Roller、Cisco Expressway、SAP NetWeaver 和 VMware vCenter 的 4 个漏洞列入 KEV，依据是已发现活跃利用证据。","四条漏洞已进入 KEV，其中 Apache Roller、VMware vCenter 等已有利用线索，文中还给出了各漏洞的触发条件、修复时间与处置期限。",{"_96":340},"2026-11-21T08:49:13.000Z","2026-11-21T09:24:45.971Z",[121,194,122,152,328,92,124,153,350],83,"CISA","v6t7o2gekhpdb4zls1sthkw2c","Bitdefender 揭示假 GTA VI 流客户端利用 ClickFix 投递 Windows 信息窃取木马","Bitdefender 发现网站 gta6cloud.nexus 以云端串流 GTA VI 为诱饵，通过 ZIP 下载或要求用户在 Win+R 中运行 PowerShell 命令投递恶意程序。",{"_96":359},"2026-11-21T08:57:36.000Z","2026-11-21T09:42:50.095Z",[137,138,164,328],66,"Hackread","fq1jp1mdea273klgl1kyc2ik0","GnuPG 披露 GPGME 双重释放漏洞 CVE-2026-129975","GnuPG 披露 GPGME 内存漏洞 CVE-2026-129975，含异常长 User ID 的恶意 OpenPGP 密钥可触发双重释放，影响 2.3.0 之前使用 GPGME 的软件，包括多数邮件客户端、部分 XMPP 客户端、Samba、Gpg4win、GnuPG Desktop 与 GnuPG VS-Desktop。",{"_96":340},"2026-11-21T11:05:53.000Z","2026-11-21T11:26:46.562Z",[121,122,367,368],"邮件安全","供应链","l0ha7ysjw76syv06olmktwx96","自主 AI Agent 利用 MONAI Label 漏洞 CVE-2026-133968 取得 root 权限","Amazon Threat Intelligence 称，中国关联攻击者使用自主 AI Agent 在 MONAI Label 中发现路径遍历漏洞 CVE-2026-133968，并在一台大学服务器上取得 root 权限。",{"_96":340},"2026-11-21T11:03:17.000Z","2026-11-21T11:26:46.569Z",[137,194,139,152,181,205,184],"sameEvent",{"_64":378,"_66":379},"mfif5csbm0luk6anr64r4hzho","攻击者利用自主 AI 工具 Cairn 攻陷 MONAI Label 漏洞并取得服务器权限","dfh23lubzfof7rir61cxf0nq4","NebuSec 演示恶意网页劫持 Meta Muse 并读取私人聊天与记忆","NebuSec 演示恶意网页可绕过审批提示，从 Meta Muse 云端机器提取并篡改用户聊天记录与存储记忆，并结合内置浏览器和 Linux 内核缺陷取得机器控制权，访问凭据存储、保存文件及 Sentinel。攻击仅影响单台云端机器，未进入共享服务器或其他用户设备；研究为实验室演示，NebuSec 称所披露弱点均已修复，但 Meta 尚未公开确认，补丁发布前是否有用户数据被访问也未说明。","文章拆解了恶意网页经内置浏览器与 Linux 内核缺陷控制云端机器的攻击链，并说明影响边界与修复状态。",{"_96":340},"2026-11-21T11:53:07.000Z","2026-11-21T12:27:45.824Z",[205,294,180,181,107,389],71,"内核","yfjjmgqjkhh0q3y9eoj082rrw","Amazon称中国关联黑客利用AI agents攻破MONAI Label漏洞","Amazon称，中国关联威胁组织运营的自主 AI agents 利用开源医疗影像标注工具 MONAI Label 的零日漏洞，针对东亚地区中国大陆以外大学 IP 发起约 48 小时攻击活动。",{"_96":401},"2026-11-21T12:08:50.000Z","2026-11-21T12:37:44.815Z",[137,194,152,139,368,399,184,400],78,{"_64":378,"_66":379},"凭据","CNCERT","SecurityWeek","b0fgs0mq3ppal4cs43serx3uq","攻击者通过 Microsoft Teams 冒充 IT 支持，配合邮件炸弹攻击企业账户","攻击者先用订阅邮件轰炸员工工作邮箱，再通过 Microsoft Teams 冒充 IT 支持人员，以协助停止邮件为由诱导员工执行操作，进而试图控制账户或计算机。",{"_96":359},"2026-11-21T12:54:31.000Z","2026-11-21T13:46:50.861Z",[137,164,138,169],"gfltnklmzy1i3r60nor37jo5p","FBI全国犯罪信息中心NCIC据报再次遭入侵","FBI正在调查其国家犯罪信息中心（NCIC）疑似遭入侵事件，该系统供美国地方、州和联邦执法机构共享通缉及失踪人员、逮捕令、被盗车辆和枪支、保护令等记录。入侵近日被发现，但发生时间、攻击者获取访问权限的方式以及是否窃取信息尚不清楚，FBI尚未公开确认事件，也未说明系统可用性是否受影响。",{"_96":417},"2026-11-21T14:26:04.000Z","2026-11-21T15:11:44.708Z",[137,165,416,350],"Oracle","BleepingComputer","dbml5ujd9k2y3agezdbxfdnmx","BADBOX 3.0 botnet 回归，每日发起 40 亿次欺诈广告竞价请求","HUMAN 的 Satori 研究人员发现 BADBOX 3.0 通过受感染的 Android 设备每日发起约 40 billion 次欺诈广告竞价请求，峰值占其观察到的 CTV 流量的 4% 以上。","材料揭示 BADBOX 3.0 通过感染 Android 设备实施广告欺诈与流量代理，并给出请求规模、代理网络和历史处置数据。",{"_96":417},"2026-11-21T15:17:27.000Z","2026-11-21T16:09:45.367Z",[137,138,427,108,141,109],73,"僵尸网络","ec6iwx2jzf1ovuafwqcriuu0q","ACM CCS 2026 参会小记（4）：微信小程序的密码学安全问题","ACM CCS 2026 的微信小程序密码学研究提出结合 LLM 与人工验证的分析方法，通过识别密码算法、检测误用并关联业务上下文判断实际安全影响。该方法发现“千里码”漏洞，强调硬编码密钥等误用是否可被利用仍需结合具体场景；会议还报道了 MINIAUTH 对近4.7万个小程序检出1834例身份认证误用，以及 Cordova 漏洞 CVE-2026-47430。",{"_96":440},"2026-11-21T09:58:00.000Z","2026-11-21T16:49:45.057Z",[205,436,91,108,167,437,438,439],37,"论文","加密","腾讯","百度","安全研究GoSSIP","cxwtekd23zeh2kmfam51afpji","Amazon 发现自主 AI Agent 利用未知漏洞入侵东亚高校","Amazon 威胁情报团队披露，一名疑似中国关联的操作者使用开源自主 AI 渗透框架 Cairn，在约 48 小时内攻击中国境外东亚地区高校 IP。",{"_96":195},"2026-11-21T16:50:49.000Z","2026-11-21T17:52:54.495Z",[180,181,139,194,137,184],82,"nios0423zfv9l5e7fe1nvkxig","CISA 将 Cisco Expressway、SAP NetWeaver、VMware vCenter 和 Apache Roller 漏洞加入 KEV 目录","CISA 将 CVE-2025-42884、CVE-2026-76466、CVE-2026-123890 和 CVE-2026-129448 加入 KEV 目录，确认这些漏洞已在真实攻击中使用。",{"_96":195},"2026-11-21T16:09:38.000Z","2026-11-21T17:52:54.509Z",[194,122,121,92,124,109,350,416,153],88,"lwn1awdsmrazlhsmt4r21vq0w","Microsoft Entra Connect Health 漏洞遭利用，租户数据被未授权访问","攻击者利用 Microsoft Entra Connect Health API 漏洞，未授权读取租户级元数据，并可能修改 Connect Health 监控配置。","事件提供了暴露数据类型、修复时间与客户无需更新的处置边界，也指出钓鱼风险和日志排查方向，便于受影响组织核对风险。",{"_96":417},"2026-11-21T18:01:58.000Z","2026-11-21T18:05:45.021Z",[137,194,165,169,167,164],77,"z2qvd5bzm4a0hvs2w49f6plyo","奥地利外交部网站遭入侵，外交人员工作联系方式泄露","奥地利外交部确认，其由外部服务商运营的网站于 November 12 至 November 13 遭未授权访问，攻击者查看了外交部总部及驻外外交机构人员的姓名和工作联系方式。",{"_96":195},"2026-11-21T18:22:52.000Z","2026-11-21T19:54:54.793Z",[137,165,368,169],48,"iepvrh0cnji8gnmctayok0ho0","Rackspace Spot 云平台遭入侵，攻击者读取客户 Kubernetes Secrets","攻击者使用泄露凭据入侵 Rackspace Spot 云平台，在部分客户组织中以合法用户身份创建 Kubernetes Pod、读取 Secrets，并列出节点和卷，受害凭据可能包括密码、认证令牌、API 密钥及 Spot API 令牌。","原文给出入侵时间窗、攻击者权限、泄露凭据类型和完整 IOC，客户可据此回溯集群、数据库及第三方服务中的异常访问。",{"_96":417},"2026-11-21T22:59:58.000Z","2026-11-21T23:50:45.254Z",[137,165,399,482,483,368],"云原生","容器","all","tag","q","tab","time",{"_490":491,"_492":-5},"changelogVersion","2026-10-01T08:00","release"]
