"_81":228,"_83":84,"_85":86,"_87":-5},{"_64":207,"_66":208,"_68":209,"_70":-5,"_71":210,"_73":211,"_75":212,"_77":213,"_79":214,"_81":215,"_83":84,"_85":86,"_87":-5},{"_64":196,"_66":197,"_68":198,"_70":-5,"_71":199,"_73":200,"_75":201,"_77":78,"_79":202,"_81":203,"_83":84,"_85":86,"_87":-5},{"_64":179,"_66":180,"_68":181,"_70":-5,"_71":182,"_73":183,"_75":184,"_77":185,"_79":186,"_81":187,"_83":84,"_85":86,"_87":-5},{"_64":167,"_66":168,"_68":169,"_70":-5,"_71":170,"_73":171,"_75":172,"_77":114,"_79":173,"_81":174,"_83":84,"_85":86,"_87":-5},{"_64":158,"_66":159,"_68":160,"_70":-5,"_71":161,"_73":162,"_75":163,"_77":78,"_79":164,"_81":165,"_83":84,"_85":86,"_87":-5},{"_64":143,"_66":144,"_68":145,"_70":-5,"_71":146,"_73":147,"_75":148,"_77":114,"_79":149,"_81":150,"_83":84,"_85":86,"_87":-5},{"_64":134,"_66":135,"_68":136,"_70":-5,"_71":137,"_73":138,"_75":139,"_77":114,"_79":140,"_81":141,"_83":84,"_85":86,"_87":-5},{"_64":121,"_66":122,"_68":123,"_70":-5,"_71":124,"_73":125,"_75":126,"_77":114,"_79":127,"_81":128,"_83":84,"_85":86,"_87":-5},{"_64":108,"_66":109,"_68":110,"_70":-5,"_71":111,"_73":112,"_75":113,"_77":114,"_79":115,"_81":116,"_83":84,"_85":86,"_87":-5},{"_64":101,"_66":102,"_68":103,"_70":-5,"_71":104,"_73":74,"_75":105,"_77":78,"_79":106,"_81":107,"_83":84,"_85":86,"_87":-5},{"_64":94,"_66":95,"_68":96,"_70":-5,"_71":97,"_73":74,"_75":98,"_77":78,"_79":99,"_81":17,"_83":84,"_85":86,"_87":-5},{"_64":65,"_66":67,"_68":69,"_70":-5,"_71":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":86,"_87":-5},"id","jsue3lxy8byb3eja5kfn2ndc0","title","Schneider Electric EcoStruxure Power Build Rapsody software 修复 CWE-416 释放后重用漏洞，CVSS 5.3","summary","Schneider Electric EcoStruxure Power Build Rapsody software 存在 CWE-416 释放后重用漏洞，本地攻击者可诱导用户打开特制恶意 SSD 文件，触发任意代码执行。","reason","source",{"_92":93},"publishedAt","2026-11-24T12:00:00.000Z","timelineAt","2026-11-24T16:00:34.998Z","category","vuln","tags",[88,89,90,91],"score",31,"selected",false,"channel","news","x","漏洞","补丁","IoT","工控","name","CISA 安全公告","xkbdr9ainyr5uag1wj0wn4yk8","Danfoss AK-SM8xxA Series 栈缓冲区溢出漏洞 CVE-2026-129713 影响 <=5.4.0","Danfoss AK-SM8xxA Series 控制器存在未认证 CGI 处理器的栈缓冲区溢出漏洞 CVE-2026-129713，AK-SM8xxA <=5.4.0 受影响，攻击者发送特制 HTTP/S POST 请求可导致内存损坏、webserver 重启，并可能以 webserver 权限执行任意代码。",{"_92":93},"2026-11-24T16:00:35.248Z",[88,91,100],"CISA","bc2htts3nbawc40ycoqa20erk","AutomationDirect C-More EA9 编程软件堆缓冲区溢出漏洞 CVE-2026-127280","AutomationDirect C-More EA9 编程软件 <=V6.80 存在堆缓冲区溢出漏洞 CVE-2026-127280，用户打开恶意项目文件后可能造成堆内存损坏、应用不稳定或崩溃，并可能进一步导致任意代码执行。",{"_92":93},"2026-11-24T16:00:35.264Z",[88,89,91,100],48,"dmwo87f2tlnikod4vbrq3ggz7","Decathlon 确认数据泄露后，客户需警惕可疑配送消息","Decathlon 已确认发生数据泄露。原文未说明泄露数据范围、受影响客户数量、攻击手段或补丁情况，但提示客户警惕以配送为由的可疑消息。",{"_92":120},"2026-11-24T15:40:24.000Z","2026-11-24T16:11:32.921Z","activity",[117,118,119],18,"攻击活动","数据泄露","钓鱼","Cybernews","s7ez64g3s3fjpd1xordc5krnb","ShinyHunters 勒索组织声称在成员被捕后回归，并以历史 PGP 密钥验证身份","ShinyHunters 勒索组织在成员连续被捕后，于 November 23 启动新的 Tor 数据泄露网站并声称回归。新站点使用两把创建于 2020 年的历史 PGP 密钥签署验证消息，BleepingComputer 确认签名有效，但这些密钥曾在多人之间传播，无法证明原运营者回归或排除冒充者。",{"_92":133},"2026-11-24T16:30:19.000Z","2026-11-24T16:37:33.158Z",[117,129,118,130,131,132],54,"勒索","黑产","加密","Oracle","BleepingComputer","n73cdcdwo8apw4442hmo8myha","European Commission 确认 EU Academy 遭攻击并发生用户数据泄露","European Commission 确认，攻击者于 October 22 使用 ARTEX AI 渗透测试框架入侵其系统，EU Academy 在线学习平台的用户姓名和邮箱等个人信息遭窃取，受影响人数尚未披露。",{"_92":133},"2026-11-24T16:22:44.000Z","2026-11-24T16:37:33.165Z",[117,118,142,119],58,"AI 攻防","hnn7iyjtz3olx95xabiqrnpqz","GreyNoise 发现攻击者入侵 22 家组织的 Check Point 管理服务器","GreyNoise 发现攻击者利用多个漏洞入侵 22 家组织的 24 台 Check Point Security 管理服务器，活动在 10 月 17 日至 11 月 2 日可见，可能仍在持续。",{"_92":133},"2026-11-24T16:15:23.000Z","2026-11-24T16:37:33.170Z",[117,151,152,153,154,155,156,157],83,"在野利用","漏洞利用","Check Point","Citrix","Ivanti","Microsoft","VMware","xkimhgiayvv9qxj0f4b293y9v","Broadcom 发布 VMware 23 个漏洞补丁，涵盖 ESX 与 vCenter 严重漏洞","Broadcom 为 VMware 多款产品发布 23 个漏洞补丁，其中包括 vCenter 的 CVE-2026-123903 认证绕过漏洞和 ESX 的 CVE-2026-123910、CVE-2026-123911 代码执行漏洞。",{"_92":166},"2026-11-24T16:32:56.000Z","2026-11-24T16:43:33.165Z",[88,89,157],73,"SecurityWeek","d1qn6zy18qnkm08vnkfvk4vjh","Okta 与 ReversingLabs 关联 Inception 数据勒索品牌与 SSO vishing 活动","Okta 与 ReversingLabs 将新数据勒索品牌 Inception 与针对 SSO 凭据的 vishing 活动关联起来。活动者冒充支持人员，诱导员工通过仿冒登录页重置密码，窃取用户名、密码及一次性代码或 MFA 推送批准；ReversingLabs 在 21 个域名确认该钓鱼工具包，并以高置信度归因另外 41 个域名、以中等置信度归因 4 个。",{"_92":178},"2026-11-24T16:30:00.000Z","2026-11-24T17:01:37.780Z",[117,119,175,130,176,177],64,"恶意软件","凭据","身份与访问","Infosecurity Magazine","floi46t5sltnh30ocwuxh7729","Rapid7 MDR Evaluation Scorecard：如何用18项检查比较MDR服务商","Rapid7 MDR Evaluation Scorecard 提供18项检查，涵盖暴露感知检测、情报、响应责任与成本、透明度、团队 expertise 和集成，帮助企业比较MDR服务商及续约方案。评估时应要求以匿名案例展示完整调查，用同一标准核对服务层级、集成范围、响应分工和总成本，并追踪改进措施；整体得分高不能替代组织必需但方案未覆盖的响应能力。",{"_92":195},"2026-11-24T15:51:25.000Z","2026-11-24T17:01:38.792Z","blue-team",[188,189,190,191,192,193,194],29,"蓝队","工具评测","检测工程","应急响应","安全运营","漏洞管理","Rapid7","Rapid7 CVE 公告","byua0nkzhemuny0li5le6i2rp","CakePHP Twig View `unserialize` 过滤器存在任意对象反序列化漏洞","CakePHP Twig View 的 `unserialize` 过滤器未限制可反序列化类，可作为反序列化远程代码执行链中的利用工具。1.3.3 和 2.1.2 已修复该问题；暂无法升级时，应停止在模板中使用 `unserialize` 过滤器。",{"_92":206},"2026-11-24T17:42:51.000Z","2026-11-24T17:52:33.229Z",[88,89,204,205],44,"漏洞分析","供应链","GitHub 安全公告","puwa8poiznezf6mv38zskg8oz","AWS Europe (Spain) Region 获西班牙 Difusión Limitada 与 NATO Restricted 认证","AWS Europe (Spain) Region 获西班牙 Difusión Limitada 与 NATO Restricted 认证，可承载对应级别的涉密工作负载。",{"_92":220},"2026-11-24T17:38:00.000Z","2026-11-24T18:02:35.467Z","policy",[216,217,205,218,219],46,"标准","合规","云原生","AWS","AWS Security Blog","v1djyax99n27n13jrmnulg27p","Iran 关联组织 Volant Manticore 使用 KuboShell 后门开展塞浦路斯等目标间谍活动","Iran 关联组织 Volant Manticore 被指自 2025 年 8 月末起针对塞浦路斯电信公司、航空公司和关键基础设施开展间谍活动，并通过虚假简历投递 KuboShell 后端、收集邮箱与企业凭据。",{"_92":230},"2026-11-24T16:54:07.000Z","2026-11-24T18:21:33.687Z",[117,175,229,119,176,142,153,156],67,"后门","The Hacker News","ud1saq3yxn64wf3suhl2tsb07","Radware 披露 Cloud WAF 管理 API 入侵事件，客户云访问密钥可能泄露","Radware 表示，攻击者于 19 November 2026 通过无需认证且暴露于公网的内部 Cloud WAF 管理 API，获取了部分客户联系方式及日志导出凭据，涉及 AWS S3、Azure Blob Storage 和 SFTP。",{"_92":133},"2026-11-24T17:49:05.000Z","2026-11-24T18:29:32.514Z",[117,118,176,218,219],"w3kx214fo5k5ijxfsr4l8s88y","AWS 完成第二次 ISO/IEC 42001:2023 监督审核，无发现并新增 AWS DevOps Agent 认证范围","AWS 于 2026 年 11 月完成第二次 ISO/IEC 42001:2023 人工智能管理体系监督审核，结果无发现，并将 AWS DevOps Agent 纳入认证服务范围。",{"_92":220},"2026-11-24T18:32:21.000Z","2026-11-24T19:03:35.531Z",[216,246,247,248,219],23,"治理","大模型","Agent 安全","a25ihdtan6djsda9r6x1l1bsu","Chrome Stable 提前发布 Windows、Mac 更新 159.0.8154.33/.34","Chrome Stable 渠道面向少量用户提前发布 Windows、Mac 版 159.0.8154.33/.34。完整变更记录可在更新日志中查看，Google 同时提供提前发布机制说明及问题反馈渠道。",{"_92":261},"2026-11-24T18:36:59.123Z","2026-11-24T19:03:41.355Z",[257,258,259,260],3,"版本更新","例行内容","Google","浏览器","Chrome Releases","kfvxzibrnhegjs7f2joj3sffo","Chrome 桌面版 Beta 渠道更新至 159.0.8154.33","Chrome 桌面版 Beta 渠道已更新至 159.0.8154.33，覆盖 Windows、Mac 和 Linux。变更详情仅部分收录于 Git log，发现问题可提交 bug，社区帮助论坛可用于求助及了解常见问题。",{"_92":261},"2026-11-24T18:28:33.237Z","2026-11-24T19:03:41.366Z",[257,258,259],"t01g4rr0zdui8pml85k6pxuh5","Turnitin 披露针对客户面向系统的未授权活动","教育科技公司 Turnitin 披露部分客户面向系统出现未授权活动，已启动事件响应计划并邀请外部网络安全专家参与调查，同时通知执法机构和网络监管机构。Turnitin 表示系统目前正常运行，受影响系统不收集政府身份凭据或机构财务信息；调查仍在进行，尚未披露活动性质与范围，也未确认用户数据是否被访问或窃取、事件发生时间及潜在受影响人数。",{"_92":133},"2026-11-24T18:59:52.000Z","2026-11-24T19:25:33.173Z",[117,191],"c3ic4rouwncugmfyilod1kvhi","CrowdStrike Signal 上线 Automated Leads 智能排序层","CrowdStrike Signal 于 2026 年 9 月 9 日为 Automated Leads 上线优先级排序层，通过关联主机异常指标与真实入侵特征，将线索的置信度与攻击相似度纳入排序。",{"_92":284},"2026-11-24T08:00:00.000Z","2026-11-24T20:01:32.808Z",[257,190,283,247,248,284],"AI 安全","CrowdStrike","i235n5w87ziesdgesnh3jpv9l","Amazon Cognito 令牌交换为 AI Agent 实现用户访问委托","Amazon Cognito 新增 OAuth 2.0 令牌交换功能，允许服务或 AI Agent 代表已登录用户调用下游 API，并通过 act 声明记录执行者身份。",{"_92":220},"2026-11-24T20:01:08.000Z","2026-11-24T20:04:36.658Z","ai-security",[283,248,293,177,247,219],"加固","fkosves1h11ym4ct505ac5i8p","Inception 仿冒品牌开展 SSO 电话钓鱼活动","新组建的数据勒索组织 Inception 被认为自 10 月下旬起开展 SSO 钓鱼活动，主要通过电话社工而非电子邮件钓鱼，冒充 Dropbox、Nintendo、Starbucks 等数十家企业。","材料梳理了 Inception 的 SSO 钓鱼基础设施、冒充品牌与关联线索，并给出可执行的认证和日志排查建议。",{"_92":133},"2026-11-24T20:21:20.000Z","2026-11-24T20:21:32.532Z",[117,119,129,118,177,304],74,true,"红队","yihzevujkk43hebekywo7ik5z","研究人员接管5个美国财政部子域名，暴露AWS悬空DNS记录风险","Intruder研究人员利用美国财政部5个仍指向已释放AWS Elastic IP地址的悬空DNS记录，在真实.gov子域名发布内容，测试成本约每个3美元。",{"_92":316},"2026-11-24T20:53:59.000Z","2026-11-24T21:03:37.959Z","disclosure",[314,204,218,315,119,219,100],65,"技术研究","网络设备","Hackread","zbpnnx7j2pedukt00a09i9xbz","免费与付费安全工具对比：免费产品在事件响应与持续监控方面存在局限","免费安全工具可满足小型企业的基础防护需求，但通常缺乏持续监控、深入调查、完整报告及专业事件响应与恢复支持。FBI 2025 Internet Crime Report 称，Internet Crime Complaint Center 收到超过一百万起投诉，损失接近 $21 billion，高于上年的 $16.6 billion；企业应按实际需求逐项评估，必要时引入商业服务。",{"_92":316},"2026-11-24T20:05:05.000Z","2026-11-24T21:03:37.966Z",[188,189,192,191,190],13,"wlf4qedhmzrb2mc5l47se4bwn","ruflo MCP bridge 默认 Docker Compose 部署存在未认证 RCE","ruflo 的 MCP bridge 在默认 Docker Compose 部署中暴露无认证的 POST /mcp，并默认监听所有网络接口，未经认证的攻击者可调用 terminal_execute。","公告同时说明默认部署暴露原因、利用链和加固措施，并指出仅重新部署无法清除已注入的污染模式。",{"_92":206},"2026-11-24T21:01:10.000Z","2026-11-24T21:04:33.728Z",[88,283,248,152,205],78,"omoggt4k4jriz46p40jm1sug6","AVideo API FFmpeg 端点 notifyCode 与 callback 存在 OS 命令注入","AVideo API 的 FFmpeg 执行端点存在 OS 命令注入，notifyCode 与 callback 未经过 sanitizeFFmpegCommand() 过滤或 escapeshellarg() 转义，攻击者可在有效 APISecret 和 30 秒内有效载荷等前提下注入 shell 命令，以 Web 服务器用户权限执行。",{"_92":206},"2026-11-24T20:53:28.000Z","2026-11-24T21:04:33.747Z",[204,341,152,342],"复现","PHP","iinefe4m57f3hkj9kqtiatq4z","github.com/insomniacslk/dhcp 的 DHCPv4 客户端因畸形 IPv4 载荷长度导致拒绝服务","github.com/insomniacslk/dhcp 的 DHCPv4 客户端存在拒绝服务缺陷，攻击者可发送 IPv4 总长度不足以容纳 UDP 头的畸形帧触发 panic。",{"_92":206},"2026-11-24T21:13:37.000Z","2026-11-24T21:24:33.309Z",[88,204],35,"f4h4od8meesa5y9llvnbg1370","etcd gRPC 监听器存在 CRL 强制绕过漏洞，3.6.13 与 3.5.32 已修复","etcd 在配置 `--listen-client-http-urls`、将 HTTP 与 gRPC 客户端端点拆分到不同监听器时，`--client-crl-file` 不会在 gRPC 监听器上强制执行，持有已吊销证书的客户端会被 HTTP 端点拒绝，但仍可通过 gRPC 成功认证。",{"_92":206},"2026-11-24T21:09:38.000Z","2026-11-24T21:24:33.316Z",[88,89,176,131],60,"ok8uv3kvniyc9w0rpop820had","Apache HTTPD mod_http2 竞态漏洞 CVE-2026-119618 根因与复现分析","Praetorian 分析 Apache HTTPD mod_http2 的同步不当漏洞 CVE-2026-119618，称其源于工作线程修改共享 req->headers 时与 c1 侧并发操作无锁 apr_allocator_t，引发内存损坏和释放后重用。",{"_92":367},"2026-11-24T21:16:56.000Z","2026-11-24T22:04:35.792Z",[314,204,341,142,247],66,"Praetorian Blog","ia6uexeninfroh0gil1zsri0q","CISA 将 3 个已知在野利用漏洞纳入 KEV Catalog","CISA 将 3 个已知被利用漏洞加入 KEV Catalog，并依据 BOD 26-04 要求联邦民事行政部门优先修复资产在利用后可被完全控制的目录内漏洞。公告还规定，潜在新增条目须具备 CVE ID、真实利用证据和明确的缓解指导；虽然该指令仅适用于 FCEB 机构，CISA 建议所有组织采用基于风险的漏洞管理并优先处置 KEV Catalog 漏洞。",{"_92":93},"2026-11-24T22:06:36.425Z",[151,193,89,246,100,375],52,"NVD","stz0f0id1eunrwe6vfy9cxgds","AWS Network Firewall 推出自动化互联网防火墙模式 Preview","AWS Network Firewall 新增自动化互联网防火墙模式 Preview，可在每个 VPC 的 internet gateway 检查入站和出站 IPv4、IPv6 流量，并为仅出站连接提供内置 NAT，减少逐 VPC 部署防火墙端点和 NAT gateway 的工作。",{"_92":220},"2026-11-24T21:30:20.000Z","2026-11-24T22:06:38.046Z",[384,257,188,218,315,219],63,"工具发布","gngutwf3qezfeudy4qc8oll26","Webworm APT 借定制版 SoftEther VPN 潜入网络","Webworm APT 通过从源代码重新构建开源 VPN 软件 SoftEther，并移除通常会暴露给防守方的特征痕迹，潜入目标网络。现有摘要未披露受害范围、具体攻击链及可用的检测或处置建议。",{"_92":393},"2026-11-24T21:48:06.000Z","2026-11-24T22:06:38.768Z",[117,229,175],59,"Dark Reading","cjv0e6y31h0qnrlvxz7uvwag7","多国在线签证与移民系统漏洞或扰乱出入境办理","多个在线签证与移民系统存在多项漏洞，攻击者可能借此扰乱尼日利亚、埃塞俄比亚、赞比亚、斯里兰卡、斐济和加纳的旅客入境流程。原文未说明漏洞编号、受影响版本、利用前提、补丁状态，也未确认已发生真实攻击。",{"_92":393},"2026-11-24T21:36:11.000Z","2026-11-24T22:06:38.942Z",[88,152],55,"i0ds4n892mht5b9256akxe5vt","European Commission 遭 AI 赋能网络攻击，EU Academy 用户姓名与邮箱泄露","European Commission 确认遭受 AI 赋能网络攻击，EU Academy 用户的姓名和邮箱地址被泄露，平台现已暂停访问。CERT-EU 于 22 October 发现恶意活动，怀疑攻击者使用 AI 渗透测试工具 ARTEX；调查仍在进行，部分内部应用暂时或持续下线，尚无证据确认 Commission 员工数据被盗，也没有官方来源确认攻击者归因。",{"_92":409},"2026-11-24T20:29:25.000Z","2026-11-24T22:06:42.694Z",[117,118,142,205,156,284],"Security Affairs","rj90jojg8jxi2doqvzxf2u18u","Rackspace 因安全事件关闭 Spot 云平台，客户须在 12 月 8 日前迁移","Rackspace 因 11 月 17 日的安全事件关闭 Spot 云平台，攻击者使用被盗凭据在客户 Kubernetes 集群中创建未授权 pods、读取 Kubernetes Secrets，并列出节点和存储卷。","事件披露了攻击者借被盗凭据进入 Kubernetes 集群并读取 Secrets 的过程，也给出了受影响时间范围和可疑 IOC。",{"_92":133},"2026-11-24T21:37:30.000Z","2026-11-24T22:21:33.065Z",[117,118,418,218,176],"容器","ey3hk1l98gaa13ublkz2baujt","soapbar `verify_envelope_bsp()` 存在嵌入式证书导致的签名伪造与认证绕过","soapbar 的 `verify_envelope_bsp()` 会从调用方不可信的 `wsse:BinarySecurityToken` 读取嵌入式 X.509 证书，仅校验该证书的有效期并据此验证签名，未执行 CA 链验证、issuer/subject 允许列表或证书固定。",{"_92":206},"2026-11-24T22:41:44.000Z","2026-11-24T22:44:34.538Z",[88,177,131],"zbl354txvuspwb2icfkwibr8d","TwigView FileLoader 用户可控模板路径可能导致任意文件读取，1.3.3 与 2.1.2 已修复","TwigView 的 FileLoader 在 `FileLoader::findTemplate()` 接收未经校验的用户可控数据时，可能导致任意文件读取。1.3.3 和 2.1.2 已包含修复，无法立即升级时应避免向 `include` 和 `extends` 标签传入用户可控数据。",{"_92":206},"2026-11-24T22:39:23.000Z","2026-11-24T22:44:34.553Z",[88,89],37,"axtyoqjjrk56ltawrbhou4990","GitHub CLI gh codespace jupyter 代码执行漏洞影响不受信任的 Codespace","GitHub CLI 的 `gh codespace jupyter` 命令存在远程代码执行漏洞，恶意 Codespace 可返回未经校验的 `vscode://` URL，经 VS Code 打开链接后在用户工作站执行代码。",{"_92":206},"2026-11-24T22:26:25.000Z","2026-11-24T22:44:34.568Z",[88,89,341,152,156],"t6ogsyyxdd34lwhl3ezjrm86b","CIA 非涉密开源情报系统遭网络攻击，具体影响与责任方未明","Associated Press 援引知情人士称，CIA 一套处理开源情报的非涉密系统遭网络攻击，事件不涉及涉密信息且问题已解决，具体失窃内容和责任方尚不清楚。该系统收集并分析互联网、商业卫星和私人数据经纪商等来源的公开或半公开数据。美国政府称近期多起系统中断并非协同网络攻击，而是集中打补丁和升级系统所致。",{"_92":166},"2026-11-24T22:41:58.000Z","2026-11-24T22:49:32.509Z",[117,118,100],62,"v22kkapa6wiug2zqwrfadsbo1","NGINX HTTP/2 释放后重用漏洞 CVE-2026-123633 分析与复现","Unit 42 分析并复现了 NGINX HTTP/2 释放后重用漏洞 CVE-2026-123633。该问题影响 1.19.7 至 1.30.6 和 1.31.0 至 1.31.8，未认证攻击者在连接额度紧张并使用分片请求和请求时 DNS 解析时可能触发拒绝服务，F5 评分 CVSS 4.0 9.2、CVSS 3.1 8.1；禁用或绕过 ASLR 时可能实现代码执行。","文章完整还原了连接状态缺陷触发释放后重用内存的路径，并用 ASan 测试验证，适合研究人员理解利用前提与防护边界。",{"_92":461},"2026-11-24T23:00:14.000Z","2026-11-24T23:07:33.411Z",[314,204,341,458,89,459,460,375],84,"利用链","Palo Alto","Debian","Unit 42","aa168ruogkh56zqxrjmae01on","卫星服务的地面基础设施存在网络安全脆弱性","卫星服务所依赖的地面基础设施存在网络安全弱点。随着新的太空竞赛加速，这些地面环节的安全问题将带来更严重的后果。",{"_92":393},"2026-11-24T22:05:34.000Z","2026-11-24T23:07:38.217Z",[314,90],25,"all","tag","q","tab","time",{"_476":477,"_478":-5},"changelogVersion","2026-10-01T08:00","release"]
