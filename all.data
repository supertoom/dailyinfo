6,"_87":-5},{"_64":361,"_66":362,"_68":363,"_70":-5,"_71":364,"_73":365,"_75":366,"_77":184,"_79":367,"_81":368,"_83":84,"_85":86,"_87":-5},{"_64":353,"_66":354,"_68":355,"_70":-5,"_71":356,"_73":357,"_75":358,"_77":101,"_79":359,"_81":339,"_83":84,"_85":86,"_87":-5},{"_64":343,"_66":344,"_68":345,"_70":-5,"_71":346,"_73":347,"_75":348,"_77":101,"_79":349,"_81":339,"_83":84,"_85":86,"_87":-5},{"_64":332,"_66":333,"_68":334,"_70":-5,"_71":335,"_73":336,"_75":337,"_77":240,"_79":338,"_81":339,"_83":84,"_85":86,"_87":-5},{"_64":322,"_66":323,"_68":324,"_70":-5,"_71":325,"_73":326,"_75":327,"_77":184,"_79":328,"_81":103,"_83":84,"_85":86,"_87":-5},{"_64":312,"_66":313,"_68":314,"_70":-5,"_71":315,"_73":316,"_75":317,"_77":184,"_79":318,"_81":319,"_83":243,"_85":86,"_87":-5,"_287":320},{"_64":302,"_66":303,"_68":304,"_70":-5,"_71":305,"_73":306,"_75":307,"_77":101,"_79":308,"_81":309,"_83":84,"_85":86,"_87":-5},{"_64":293,"_66":294,"_68":295,"_70":-5,"_71":296,"_73":297,"_75":298,"_77":78,"_79":299,"_81":17,"_83":84,"_85":86,"_87":-5},{"_64":279,"_66":280,"_68":281,"_70":-5,"_71":282,"_73":283,"_75":284,"_77":184,"_79":285,"_81":286,"_83":243,"_85":86,"_87":-5,"_287":288},{"_64":269,"_66":270,"_68":271,"_70":-5,"_71":272,"_73":273,"_75":274,"_77":78,"_79":275,"_81":155,"_83":84,"_85":86,"_87":-5},{"_64":258,"_66":259,"_68":260,"_70":261,"_71":262,"_73":263,"_75":264,"_77":184,"_79":265,"_81":266,"_83":243,"_85":86,"_87":-5},{"_64":248,"_66":249,"_68":250,"_70":-5,"_71":251,"_73":252,"_75":253,"_77":240,"_79":254,"_81":255,"_83":84,"_85":86,"_87":-5},{"_64":233,"_66":234,"_68":235,"_70":236,"_71":237,"_73":238,"_75":239,"_77":240,"_79":241,"_81":242,"_83":243,"_85":86,"_87":-5},{"_64":222,"_66":223,"_68":224,"_70":-5,"_71":225,"_73":226,"_75":227,"_77":101,"_79":228,"_81":229,"_83":84,"_85":86,"_87":-5},{"_64":209,"_66":210,"_68":211,"_70":-5,"_71":212,"_73":213,"_75":214,"_77":215,"_79":216,"_81":217,"_83":84,"_85":86,"_87":-5},{"_64":196,"_66":197,"_68":198,"_70":-5,"_71":199,"_73":200,"_75":201,"_77":184,"_79":202,"_81":203,"_83":84,"_85":86,"_87":-5},{"_64":178,"_66":179,"_68":180,"_70":-5,"_71":181,"_73":182,"_75":183,"_77":184,"_79":185,"_81":186,"_83":84,"_85":86,"_87":-5},{"_64":170,"_66":171,"_68":172,"_70":-5,"_71":173,"_73":99,"_75":174,"_77":101,"_79":175,"_81":176,"_83":84,"_85":86,"_87":-5},{"_64":163,"_66":164,"_68":165,"_70":-5,"_71":166,"_73":99,"_75":167,"_77":101,"_79":168,"_81":169,"_83":84,"_85":86,"_87":-5},{"_64":156,"_66":157,"_68":158,"_70":-5,"_71":159,"_73":99,"_75":160,"_77":101,"_79":161,"_81":162,"_83":84,"_85":86,"_87":-5},{"_64":149,"_66":150,"_68":151,"_70":-5,"_71":152,"_73":99,"_75":153,"_77":101,"_79":154,"_81":155,"_83":84,"_85":86,"_87":-5},{"_64":141,"_66":142,"_68":143,"_70":-5,"_71":144,"_73":99,"_75":145,"_77":101,"_79":146,"_81":147,"_83":84,"_85":86,"_87":-5},{"_64":133,"_66":134,"_68":135,"_70":-5,"_71":136,"_73":99,"_75":137,"_77":101,"_79":138,"_81":139,"_83":84,"_85":86,"_87":-5},{"_64":125,"_66":126,"_68":127,"_70":-5,"_71":128,"_73":99,"_75":129,"_77":101,"_79":130,"_81":131,"_83":84,"_85":86,"_87":-5},{"_64":117,"_66":118,"_68":119,"_70":-5,"_71":120,"_73":99,"_75":121,"_77":101,"_79":122,"_81":123,"_83":84,"_85":86,"_87":-5},{"_64":109,"_66":110,"_68":111,"_70":-5,"_71":112,"_73":99,"_75":113,"_77":101,"_79":114,"_81":115,"_83":84,"_85":86,"_87":-5},{"_64":95,"_66":96,"_68":97,"_70":-5,"_71":98,"_73":99,"_75":100,"_77":101,"_79":102,"_81":103,"_83":84,"_85":86,"_87":-5},{"_64":65,"_66":67,"_68":69,"_70":-5,"_71":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":86,"_87":-5},"id","b6oh0kdx1b8l26f0swh1dihfl","title","Microsoft 修复 Windows 11 更新导致的 Smart App Control 无法启用问题","summary","Microsoft 已修复 October 2026 KB5127648 安全更新导致部分 Windows 11 24H2 及更高版本设备无法开启 Smart App Control 的问题，已开启该功能的设备不受影响。10 月 28 日及之后发布的更新已包含修复；暂不部署预览更新的管理员也可按 Microsoft 建议编辑注册表或部署指定 Group Policy，并重启设备应用设置。","reason","source",{"_93":94},"publishedAt","2026-11-02T13:57:29.000Z","timelineAt","2026-11-02T15:00:33.063Z","category","blue-team","tags",[88,89,90,91,92],"score",47,"selected",false,"channel","news","x","补丁","版本更新","加固","Microsoft","操作系统","name","BleepingComputer","rl7oyn7lo3sbrqtvns0f3r3q5","CERT-FR 汇总第 44 周重大漏洞与 eMudhra TLS 中间证书私钥泄露事件","CERT-FR 汇总第 44 周 12 项重大漏洞及 eMudhra TLS 中间证书事件。",{"_93":108},"2026-11-02T00:00:00.000Z","2026-11-02T15:43:33.927Z","vuln",[104,105,106,88,107],27,"汇总","漏洞","在野利用","漏洞管理","CERT-FR","ktd3s060908mpza2145lg0d4c","Tenable Identity Exposure 多个漏洞影响 3.x，3.93.6 起提供修复","Tenable Identity Exposure 3.x 低于 3.93.6，以及低于 3.77.18 的版本存在多个漏洞，部分可导致远程任意代码执行、远程拒绝服务和数据机密性受损。对应漏洞为 CVE-2026-119314、CVE-2026-119315 和 CVE-2026-119316，CERT-FR 建议参阅厂商安全公告 tns-2026-34 获取修复程序。",{"_93":108},"2026-11-02T15:43:33.936Z",[105,88,116],51,"Tenable","x2rguffbuu1wt81uut9t688rx","Synology 多款产品存在远程代码执行漏洞，CERT-FR 发布修复通告","CERT-FR 披露 Synology Mail Station、PHP 与 Synology Calendar 存在可导致远程代码执行的多项漏洞，涉及 CVE-2026-109618 和 CVE-2026-109619。",{"_93":108},"2026-11-02T15:43:33.942Z",[105,88,124],65,"PHP","f0b8hycx6vtmkvcyepyz8syyj","Redmine 多个版本存在 XSS、安全策略绕过和拒绝服务漏洞","CERT-FR 披露 Redmine 存在 XSS、安全策略绕过和拒绝服务漏洞，影响 6.1.x 中早于 6.1.6 的版本、7.0.x 中早于 7.0.3 的版本，以及早于 6.0.12 的版本。原文未说明具体利用前提或是否已在野利用，修复方案为参考 Redmine 2026 年 11 月 2 日发布的安全公告获取对应补丁。",{"_93":108},"2026-11-02T15:43:33.947Z",[105,88,132],48,"Red Hat","ww3cadl57xa7aiymtko5t4zgb","CERT-FR 汇总 Microsoft Edge 49 个漏洞，涵盖 CVE-2026-118304 至 CVE-2026-91732","CERT-FR 汇总了 Microsoft Edge 的 49 个漏洞，编号范围从 CVE-2026-118304 至 CVE-2026-91732，相关安全公告发布日期均为 31 octobre 2026。原文未说明各漏洞类型、受影响版本、CVSS 分数或利用前提，仅指明应查阅厂商安全公告以获取修复程序。",{"_93":108},"2026-11-02T15:43:33.953Z",[105,88,104,140,91],29,"浏览器","tgpabgan6bbg80j8cvz1lgx9y","Ivanti Connect Secure 3 个漏洞已被主动利用","Ivanti Connect Secure 的 CVE-2026-104935、CVE-2026-111357 和 CVE-2026-118527 已被主动利用，可导致远程任意代码执行、权限提升和安全策略绕过。",{"_93":108},"2026-11-02T15:43:33.958Z",[105,106,88,148],79,"Ivanti","qqmgextuiad220tv61wvm1l4e","CERT-FR 通报 Qnap QNE 多项漏洞（02 novembre 2026）","CERT-FR 通报 Qnap QNE 存在多项漏洞，依据 Qnap 2026 年 10 月 30 日发布的安全公告 qsa-26-19。该文档于 02 novembre 2026 首次发布并更新至同日版本，但正文未提供具体 CVE 编号、CVSS 分数、受影响版本、补丁状态或利用情况。",{"_93":108},"2026-11-02T15:43:33.964Z",[105,88],18,"qbps5dqa4ym7r5pseh3gfg4l8","macmon 与 NRSW 存在多项严重 PHP 漏洞","CERT-FR 发布 macmon 与 NRSW 多项漏洞安全通告，引用 Belden PSIRT 10 月 22 日公告。通告编号为 CERTFR-2026-AVI-1438，初始版本发布于 11 月 2 日；正文未提供 CVE 编号、CVSS 分数、受影响版本、补丁状态或利用情况。",{"_93":108},"2026-11-02T15:43:33.971Z",[105,107],19,"t1i30a750ohsmyfbcrgwfvaqt","CERT-FR 披露 Microsoft Visual Studio 安全策略绕过漏洞 CVE-2026-118147","Microsoft Visual Studio 存在安全策略绕过漏洞 CVE-2026-118147，可导致攻击者绕过安全策略。受影响版本包括 Visual Studio 2017 15.9 之前、2019 16.11 之前、2022 17.14 之前及 2026 18.11 之前的版本；CERT-FR 建议参考 Microsoft 2026 年 10 月 30 日安全公告获取修复补丁。",{"_93":108},"2026-11-02T15:43:33.976Z",[105,88,91],45,"mmnhy0f0oaxrxu98lp4l1pmj5","Traefik 远程拒绝服务漏洞影响 2.x 与 3.x 旧版本","Traefik 存在可导致远程拒绝服务（DoS）的漏洞，影响 2.x 版本中低于 2.11.61 的版本，以及 3.x 版本中低于 3.7.17 的版本。CERT-FR 于 02 novembre 2026 首次发布公告，未提及认证要求或已确认的利用活动；修复信息见 Traefik 安全公告 GHSA-xv5x-242w-7hf7。",{"_93":108},"2026-11-02T15:43:33.982Z",[105,88,177],44,"网络设备","auejks1v98qq33bnks0bkg47t","DarkBlinders 以鱼叉式钓鱼和恶意编码挑战入侵以色列目标及伊拉克库尔德政府云环境","Dream Research Labs 披露，伊朗关联组织 DarkBlinders 于 2026 年 8 月至 10 月针对以色列和伊拉克库尔德地区开展网络间谍活动， compromising 一名以色列重要人物及库尔德地区政府云环境。",{"_93":195},"2026-11-02T14:46:05.000Z","2026-11-02T15:43:34.777Z","activity",[187,188,189,190,191,192,193,194],59,"攻击活动","恶意软件","后门","钓鱼","数据窃取","红队","Palo Alto","Zscaler","The Hacker News","teb8ck1hkyzday4txbjv13ws9","Cisco Talos 分析 AI 驱动窃密木马 VOLTA-AUTODOXER","Cisco Talos 发现 Windows 窃密木马 VOLTA-AUTODOXER，可窃取浏览器密码、Cookie、支付卡、钱包种子、OAuth tokens、SSH 与云密钥、会话及 Wi-Fi 密码，并借助 OpenRouter API 对受害者资产进行变现价值分级。",{"_93":208},"2026-11-02T14:47:57.000Z","2026-11-02T15:47:33.574Z",[187,188,191,204,205,206,207,91],69,"AI 攻防","大模型","Cisco","Google","Help Net Security","dvvmouotkeja8kk7yjdn3x1rg","RFC 8684 多路径 TCP 使用与检测方法分析","RFC 8684 多路径 TCP（MPTCP）允许连接在多个 IP 地址间拆分和迁移，但应用广泛采用的实现主要是 iOS/iPadOS，连接 Apple 的 17.0.0.0/8 IPv4 流量时常使用该协议。",{"_93":221},"2026-11-02T14:52:05.000Z","2026-11-02T15:48:34.115Z","disclosure",[218,177,219,220],49,"技术研究","检测工程","Apple","SANS ISC","q4c252ab1kstea6o5pmqp9tto","INFINITT PACS System Manager 3.0.11.3 与 3.0.11.5 存在代码执行漏洞","CERT/CC 披露 INFINITT PACS System Manager 3.0.11.3 和 3.0.11.5 存在多个代码执行漏洞。",{"_93":232},"2026-11-02T15:38:19.438Z","2026-11-02T15:48:34.512Z",[105,88,230,231],53,"漏洞分析","CERT/CC","CERT/CC 漏洞公告","k8iee38q6sr0000yquvlj925i","Google Cloud 披露 LLMJacking 攻击链，攻击者转售被盗企业 LLM 资源","Google Cloud 威胁情报披露，攻击者在 2026 年多起 LLMJacking 入侵中盗用企业云身份和 LLM API 凭据，入侵北美、南美及亚太的金融、零售、技术和运输组织，单日欺诈费用超过 $100,000 USD，部分组织累计达 $1 million USD。","文章以多起真实入侵还原 LLMJacking 的获客、变现与检测链路，并给出可落地的云侧审计和加固措施。",{"_93":247},"2026-11-02T14:00:00.000Z","2026-11-02T15:48:37.650Z","ai-security",[244,187,188,191,245,205,207,246,91],80,true,"AI 安全","供应链","AWS","Google Cloud 威胁情报","pzss858rz9w0zbt5wubv38oqh","Microsoft “Digital Defense Report”未指出政府机构正遭 Microsoft 漏洞广泛攻击","Microsoft 最新“Digital Defense Report”将政府机构列为 AI 攻击的主要目标，却未提及这些机构正通过 Microsoft 漏洞遭到广泛攻击。报告聚焦 AI 威胁，遗漏了 Microsoft 漏洞对政府机构构成的现实攻击面。",{"_93":257},"2026-11-02T15:00:00.000Z","2026-11-02T15:51:34.324Z",[244,256,91],26,"行业动态","Dark Reading","y3oqogzfuz08thepvfa99u3bx","BTCPay Server 旧版本实例遭遇热钱包盗取，2.4.1及更早版本需升级至2.4.7","BTCPay Server 维护者称，黑客已针对运行 2.4.1（2026年7月23日）或更早版本的实例盗取热钱包资金，攻击未针对公开服务器。项目建议受影响实例尽快下线并升级至 2.4.7；原文称尚无使用 2.4.7 的热钱包盗取可信报告，但近期攻击具体利用的漏洞尚未查明，受影响用户需向 security@btcpayserver.org 提交活动日志。","材料区分了受影响版本、当前利用链尚未查明的部分，以及面向 Docker 和普通安装的更新路径。",{"_93":94},"2026-11-02T15:03:07.000Z","2026-11-02T16:01:33.457Z",[187,106,191,267,268],75,"加密","应急响应","bggz5h9cuonkxfo4gap0b79sn","AT&T 2024 年数据泄露暴露 1.09 亿客户通信日志，运营商长期留存通话记录引发隐私风险","AT&T 2024 年数据泄露暴露 1.09 亿名客户的通信日志，数据涵盖 2022 年 5 月至 2023 年 1 月，包含电话号码、通话和短信次数、时长及位置数据。",{"_93":94},"2026-11-02T15:01:11.000Z","2026-11-02T16:01:33.466Z",[276,277,278],"蓝队","工具评测","移动端","p8lgm331w38cxp1dyo8ycly9z","Google 接管逾 130 万台 Android 设备僵尸网络，Videostrong 电视盒后门遭曝光","Google 通过法律行动于 10 月下旬接管控制逾 130 万台 Android 设备的僵尸网络，并指称深圳设备厂商 Videostrong 故意在多款电视盒固件中植入 x.cpe 后door，向犯罪分子出售访问权限。",{"_93":195},"2026-11-02T15:50:26.000Z","2026-11-02T16:43:34.526Z",[187,188,189,291,207,292],81,"sameEvent",{"_64":289,"_66":290},"wbjzunigapakv96vd54t9g53c","Google 联合处置 XCPE 僵尸网络，Videostrong 预装后门感染逾 130 万台机顶盒","僵尸网络","Trend Micro","ssnlpqk4xdsv07k9xs9r3pv6v","Cisco 发布 AI Transit，将 NeoCloud 等 AI 环境接入现有 SD-WAN","Cisco AI Transit 可将 NeoCloud、私有及主权 AI 云和企业 AI 工厂连接到现有 Cisco SD-WAN，支持物理或虚拟设备部署，并让客户通过 SD-WAN 应用策略统一管理 AI 与 agentic traffic 的路由、分段、安全、性能和可见性。",{"_93":301},"2026-11-02T16:00:32.000Z","2026-11-02T16:47:33.827Z",[300,244,177,205,206],"工具发布","Cisco Security Blog","d5xg5avkbmobn5scdvdi4qx8w","CISA要求联邦机构修复已被利用的Ivanti Connect Secure漏洞CVE-2026-111357和CVE-2026-118527","CVE-2026-111357和CVE-2026-118527已被攻击者与CVE-2026-104935链式利用，入侵Ivanti Connect Secure SSL VPN设备并尝试窃取Active Directory的Windows LAPS密码和BitLocker恢复密钥。",{"_93":208},"2026-11-02T15:58:08.000Z","2026-11-02T16:48:33.268Z",[105,106,88,268,107,148,310,311],85,"CISA","Rapid7","ghi7z0u79zotlr12i1ld0lr79","Google 关停 XCPE 僵尸网络并封禁运营商 Videostrong Technology","Google 关停 XCPE 僵尸网络基础设施，并封禁其背后厂商 Videostrong Technology。该后门藏匿于 Android TV 机顶盒固件中，超过 1.3 million 台设备被纳入网络；Google 估计切断关联命令域名还可切断至少 10 million 台通过其他途径和恶意软件家族受控设备的访问。",{"_93":208},"2026-11-02T15:50:46.000Z","2026-11-02T16:48:33.285Z",[187,188,189,291,207,321,292],82,{"_64":289,"_66":290},"IoT","zy7b3ov4u1ta4kliqlj3qvm7e","Check Point Research 11月2日威胁情报报告：多起网络攻击、AI 威胁与漏洞动态汇总","Check Point Research 汇总多起网络攻击、AI 威胁及漏洞动态：Binance 约 $6.3 billion 数字资产被盗，Polymarket 约 $2.7 million 加密货币疑遭盗取，日本航空约 92,000 名旅客数据经第三方系统泄露。",{"_93":331},"2026-11-02T15:57:23.000Z","2026-11-02T16:52:35.025Z",[104,187,188,329,330,244],"数据泄露","勒索","Check Point Research","drp1xh2h5a8sdpnoutvi7057g","A2ABreak 系统分析 A2A v1.0.0 协议并确认 11 项安全问题","普渡大学和德克萨斯大学达拉斯分校研究者的论文 A2ABreak 对 Google Agent2Agent（A2A）v1.0.0 开展系统性安全分析，经人工复核确认 11 项协议层问题，并剖析跨客户端上下文注入、多跳身份丢失和未经证明的能力声明等 3 项缺陷。",{"_93":342},"2026-11-02T13:07:00.000Z","2026-11-02T17:46:38.905Z",[244,340,218,341,205,207],66,"论文","Agent 安全","安全研究GoSSIP","cqwgjh39mhsg3stnnon9zje05","DBHub 0.22.3 的 MySQL 与 MariaDB 只读模式可被注释解析绕过","DBHub 0.22.3 的 MySQL 与 MariaDB 连接器存在只读模式绕过，攻击者可通过类似 `SELECT 1--1;DROP TABLE victim` 的 SQL 执行写入及破坏性 DDL。",{"_93":352},"2026-11-02T17:57:51.000Z","2026-11-02T18:02:34.336Z",[105,350,351,230,205,341],"复现","漏洞利用","GitHub 安全公告","azzc9spwqbxjgwf6zhndvsctf","@sd-jwt/decode 0.19.0 存在披露篡改后静默丢弃漏洞","@sd-jwt/decode 0.19.0 在 SD-JWT presentation 的 Disclosure 被篡改、摘要与 Issuer 签名的 `_sd` 数组不匹配时，不会按 RFC 9901 拒绝整个 presentation，而是静默丢弃该 Disclosure 并返回缩减后的 claim set；Issuer 签名仍有效且校验报告成功。",{"_93":352},"2026-11-02T17:54:39.000Z","2026-11-02T18:02:34.346Z",[105,350,230,360],"身份与访问","xu1isxn8wgshnvux2x56pbjoc","The Hacker News 本周安全汇总：关键 CVE、Linux DDoS 僵尸网络、设备代码钓鱼与 Android 间谍软件","The Hacker News 本周汇总多起关键 CVE、Linux DDoS 僵尸网络、设备代码钓鱼、Android 间谍软件等安全事件，并覆盖至少 7 项新闻与威胁。",{"_93":195},"2026-11-02T16:57:56.000Z","2026-11-02T18:43:34.401Z",[104,187,188,329,330,244,207,91,369,370,310],9,"Mozilla","Cloudflare","g91jpin898ib1bej3gd5gopsn","Linux 内核 CVE-2026-98432 波及自托管 JFrog 运行环境","Linux 内核 CVE-2026-98432 是一处影响新建 IPv4 TCP 连接的 use-after-free 缺陷，自 4.4 起存在，Linux 内核团队评分 9.8。","文章区分了 JFrog 产品与承载环境的风险，并给出按发行版核查内核修复状态和分批更新的操作路径。",{"_93":383},"2026-11-02T18:35:06.000Z","2026-11-02T18:47:35.698Z",[105,106,350,88,380,381,132,382,246],77,"内核","Ubuntu","Oracle","JFrog Security Research","y1k760c443qczpv74mc5rpbwk","AWS 解析 DKIM 重放攻击原理并给出 Amazon SES 邮件处置方案","Amazon SES 可通过消息事件、DMARC 聚合报告和 DNS 查询日志发现异常，但仅凭聚合数据不能确认重放；需将已发送邮件与未联系收件人收到的邮件进行消息级匹配，并排除合法中继。",{"_93":393},"2026-11-02T18:06:28.000Z","2026-11-02T18:51:36.524Z",[276,219,268,90,392,246],50,"邮件安全","AWS Security Blog","webolw7fw2041op34t7x6m1dm","Abrigo 因疑似网络攻击停用 Sageworks，借款人功能仍未恢复","金融科技公司 Abrigo 因环境异常将风险管理应用 Sageworks 下线，服务中断持续至周末，受影响服务包括 Online Portal Now、Sageworks Analyst 和 Sageworks API，目前多数功能已恢复，但面向借款人的功能仍未恢复。",{"_93":94},"2026-11-02T19:00:45.000Z","2026-11-02T19:04:33.232Z",[187,329,245],63,"l79qvcx1c4awu9yey6ibz7nvh","Google 联合伙伴中断 XCPE Android 僵尸网络，封锁 Videostrong","Google 与日本国家警察机构及多家安全公司联合中断了 XCPE 僵尸网络，该网络涉及超过 130 万台 Android TV 流媒体机，Google 高置信度认定设备厂商 Videostrong Technology Co. 在制造阶段故意植入持久后门并向犯罪团伙出售访问权限。",{"_93":94},"2026-11-02T18:16:34.000Z","2026-11-02T19:04:33.239Z",[187,188,189,291,321,207,292],{"_64":289,"_66":290},"rafkhy3qv0k8l0szgvjkxzwzu","Red Hat Security：AI 时代的自主权、选择权与控制力","Red Hat Security 发布关于 AI 时代自主权的文章，核心议题是用户在技术选择、运行控制与自主性方面应如何把握。正文仅提供其网站栏目导航，涵盖 IT 自动化、Security、边缘计算、Infrastructure、Applications 与 Virtualization，未披露具体产品、漏洞、攻击事件或技术结论。",{"_93":418},"2026-11-02T19:50:33.729Z",[417],3,"其他","Red Hat Security","zdtxw6txstfcscmzftzjh128t","如何保护 iPhone 上的语音录音隐私","iPhone 录音可能通过 iCloud 同步至同一 Apple 账号的设备，并因位置命名、聊天转发及云端转写泄露地址等信息。选用本地优先、默认存本机、支持 Face ID 或密码锁及彻底删除的录音应用，并优先处理存储与共享设置；VPN 仅能保护上传链路，无法约束服务器端存储与处理。",{"_93":426},"2026-11-02T19:29:50.000Z","2026-11-02T19:54:36.876Z",[276,90,278,360,220],"Hackread","cy90zbdehwxv5memq7aqw725b","Cisco Talos 分析 AI 驱动型 Windows 信息窃取器 VOLTA","Cisco Talos 分析了 Windows 信息窃取器 VOLTA-AUTODOXER。该程序窃取浏览器密码、Cookie、支付卡、加密钱包种子短语、OAuth tokens、SSH 与云凭据等数据，并借助 LLM 生成受害者资产估值、安全习惯评估及可变现信息分级；默认调用 Claude Opus 4.6，失败后切换 Kimi K2 和 Gemini 2.5 Flash。",{"_93":435},"2026-11-02T18:34:13.000Z","2026-11-02T19:56:36.793Z",[187,188,244,191,205,91,207,369],67,"Security Affairs","syw0v3c85bp1qjw3dhd1wv7kg","Microsoft 解析 2,056 个在野利用 CVE 的共同特征","Microsoft Security Research 分析截至 2026 年 9 月约 383,000 个已披露 CVE，其中 2,056 个与真实攻击相关。",{"_93":444},"2026-11-02T20:20:59.000Z","2026-11-02T21:56:35.289Z",[218,106,230,107,91,310],55,"Microsoft Security Blog","h95qmripejf5n3wijd12czd7y","Vapor Panda 使用 ARTEX AI 攻击 14 国 200 多家组织","CrowdStrike 披露，中国关联威胁组织 Vapor Panda 使用开源多代理渗透测试框架 ARTEX AI，自 10 月 17 日起攻击 14 个国家 200 多家组织，至少入侵 9 家机构，并对另外 12 个高价值目标实施密码喷洒和凭据扫描。",{"_93":94},"2026-11-02T21:40:14.000Z","2026-11-02T22:07:33.526Z",[187,204,341,189,456,457],76,{"_64":454,"_66":455},"m8vt0mfprflyha4qd0f1jbnwd","VAPOR PANDA 使用 ARTEX 与 DeepSeek 并行入侵全球 200 多家组织","凭据","CrowdStrike","sxcr7vcgs8x0tay73jqqj30ls","Binance 攻击路径警示：一台失陷笔记本如何造成数十亿美元损失","一台笔记本失陷后，系统隔离薄弱、控制措施不足和未测试的攻击路径可能将单点入侵扩大为系统性损失。该案例揭示了攻击扩散风险，凸显强化系统分离、落实访问控制及预先验证攻击可能性的重要性。",{"_93":257},"2026-11-02T22:27:24.000Z","2026-11-02T22:58:35.872Z",[187,191,465],"阿里","jfrlmktjc1u9cgfdzzzkfjq2b","Cisco 利用 SnortML 与 Splunk 协同防御 AI 加速的 PHP2Shell 威胁","Cisco 通过 SnortML、Snort IPS/IDS 规则和 Splunk 检测协同应对 AI 加速的 PHP2Shell 威胁。",{"_93":301},"2026-11-02T18:24:13.000Z","2026-11-02T23:54:34.573Z",[276,219,204,206,177,124],"gohidrc4lp69p2cb47z4jo1oz","Unit 42 威胁情报汇总：网络间谍、网络犯罪与 AI 赋能攻击动态","Unit 42 汇总近期三类威胁活动：国家支持的 APT 活动窃取战略情报，犯罪团伙实施数据窃取、勒索与财务欺诈，以及攻击者将生成式 AI 和 LLM 融入社工、脚本编写、Payload 调试、代码混淆和深度伪造。攻击活动广泛采用 LotL 二进制、内置管理工具、零日漏洞与定向钓鱼，并利用 infostealer 日志、泄露凭据及未修补的外围资产获取访问权限。",{"_93":480},"2026-11-02T23:00:45.000Z","2026-11-02T23:58:35.240Z",[104,187,204,456,191,190,193],"Unit 42","all","tag","q","tab","time",{"_487":488,"_489":-5},"changelogVersion","2026-10-01T08:00","release"]
