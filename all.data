01,"_79":202,"_81":203,"_83":84,"_85":86,"_87":-5},{"_64":186,"_66":187,"_68":188,"_70":-5,"_71":189,"_73":190,"_75":191,"_77":111,"_79":192,"_81":193,"_83":84,"_85":86,"_87":-5},{"_64":178,"_66":179,"_68":180,"_70":-5,"_71":181,"_73":182,"_75":183,"_77":111,"_79":184,"_81":185,"_83":84,"_85":86,"_87":-5},{"_64":171,"_66":172,"_68":173,"_70":-5,"_71":174,"_73":175,"_75":176,"_77":111,"_79":177,"_81":125,"_83":84,"_85":86,"_87":-5},{"_64":164,"_66":165,"_68":166,"_70":-5,"_71":167,"_73":168,"_75":169,"_77":111,"_79":170,"_81":125,"_83":84,"_85":86,"_87":-5},{"_64":156,"_66":157,"_68":158,"_70":-5,"_71":159,"_73":160,"_75":161,"_77":111,"_79":162,"_81":125,"_83":84,"_85":86,"_87":-5},{"_64":148,"_66":149,"_68":150,"_70":-5,"_71":151,"_73":152,"_75":153,"_77":111,"_79":154,"_81":155,"_83":84,"_85":86,"_87":-5},{"_64":139,"_66":140,"_68":141,"_70":-5,"_71":142,"_73":143,"_75":144,"_77":111,"_79":145,"_81":146,"_83":84,"_85":86,"_87":-5},{"_64":130,"_66":131,"_68":132,"_70":-5,"_71":133,"_73":134,"_75":135,"_77":111,"_79":136,"_81":137,"_83":84,"_85":86,"_87":-5},{"_64":118,"_66":119,"_68":120,"_70":-5,"_71":121,"_73":122,"_75":123,"_77":111,"_79":124,"_81":125,"_83":84,"_85":86,"_87":-5},{"_64":105,"_66":106,"_68":107,"_70":-5,"_71":108,"_73":109,"_75":110,"_77":111,"_79":112,"_81":113,"_83":84,"_85":86,"_87":-5},{"_64":94,"_66":95,"_68":96,"_70":-5,"_71":97,"_73":98,"_75":99,"_77":78,"_79":100,"_81":101,"_83":84,"_85":86,"_87":-5},{"_64":65,"_66":67,"_68":69,"_70":-5,"_71":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":86,"_87":-5},"id","qgsn0afd320w1dxmt73jiik7u","title","Microsoft 365 多区域服务中断影响 Outlook、Exchange Online 和 Teams","summary","Microsoft 365 周四发生多区域大范围服务中断，影响业务邮件、Exchange Online、Teams、SharePoint Online、Microsoft 365 Copilot 和 Defender XDR，Google Workspace 用户也报告通过 Outlook 客户端访问邮箱受阻。","reason","source",{"_92":93},"publishedAt","2026-11-12T20:55:30.000Z","timelineAt","2026-11-12T21:40:28.885Z","category","activity","tags",[88,89,90,91],"score",55,"selected",false,"channel","news","x","其他","Microsoft","云原生","Google","name","SecurityWeek","h8ijgwnlhr1r0s4ikcq8iiule","Microsoft 云服务故障影响 Outlook、Teams、Copilot 及 AI 连接器","Microsoft 云服务故障在 11 月 12 日影响美国数千名用户，Downdetector 记录超过 97,000 次 Outlook 事件、超过 38,000 次 Microsoft 365 问题和约 4,500 次 Teams 报告。",{"_92":104},"2026-11-12T20:41:47.000Z","2026-11-12T21:41:30.635Z",[102,90,103,89],68,"攻击活动","大模型","Security Affairs","fk405ww32t5ysknay8xlxpvl1","Rails Active Storage 视频预览与分析功能可泄露本地文件","Rails Active Storage 的 VideoPreviewer、VideoAnalyzer 和 AudioAnalyzer 未限制 FFmpeg 输入格式，攻击者可上传声明为 video/* 或 audio/* 的 HLS 播放列表，借 file:// 读取应用进程可访问且路径已知的本地媒体文件。",{"_92":117},"2026-11-12T21:54:18.000Z","2026-11-12T21:54:23.474Z","vuln",[114,115,116],69,"漏洞","补丁","数据窃取","GitHub 安全公告","zs7x65jnm1lvycw6yycczbiif","basic-ftp MLSD 目录列表解析漏洞可导致 Node.js 应用 DoS","basic-ftp 的 MLSD 目录列表解析器未校验来自 FTP 服务器的 fact 名称，`__proto__` 会使处理函数查找指向 Object.prototype，进而抛出未捕获的 TypeError。",{"_92":117},"2026-11-12T21:42:12.000Z","2026-11-12T21:54:23.492Z",[114,126,127,128,129],49,"复现","漏洞利用","技术研究","网络设备","j43klp9ej8mzrfxt670h6ql4g","Ruby on Rails Action View tag helpers 存在 XSS 漏洞","Ruby on Rails Action View tag helpers 存在 XSS 漏洞，空白 Symbol 或 String 属性名可绕过此前的修复逻辑并生成畸形 HTML，浏览器可能将精心构造的属性值误判为独立属性名。允许用户指定自定义 HTML 属性名的应用受影响，8.1 和 8.0 分支修复均已提供，无法立即升级的开发者可应用对应补丁。",{"_92":117},"2026-11-12T22:08:21.000Z","2026-11-12T22:15:23.523Z",[114,115,138],46,"漏洞分析","a4i5kqy8ken9jqemde5pgfsd8","Addressable 2.9.1 修复 URI 路径规范化拒绝服务漏洞","Addressable 的 URI 路径规范化存在算法复杂度漏洞，2.9.1 已修复，2.9.1 之前的所有版本均受影响。`Addressable::URI.normalize_path` 每轮仅移除一个点路径段，导致处理嵌套点路径的耗时随路径长度平方增长；在 MRI Ruby 4.0 上，规范化 34 KB 路径约需 3.5 秒。",{"_92":117},"2026-11-12T22:35:33.000Z","2026-11-12T22:36:23.879Z",[114,115,138,147],51,"加密","qhzay6b5zg4i4n2z608imqz49","`@astrojs/solid-js` 修复未转义插槽名导致的反射型 XSS 漏洞","`@astrojs/solid-js` 的服务端渲染器未对 Solid 组件插槽名进行 HTML 转义，攻击者可构造链接注入任意 HTML，在站点源上执行 JavaScript。漏洞影响 0.2.0 至 7.1.1，仅当页面使用请求参数作为插槽名、组件通过 `client:*` 水合且动态渲染该插槽时可利用；7.1.2 已修复，升级前应避免使用请求控制的插槽名或映射至固定名称。",{"_92":117},"2026-11-12T22:34:44.000Z","2026-11-12T22:36:23.886Z",[114,115,126],39,"ov84so449sy73mo4d6rbm5k6l","Astro @astrojs/svelte 反射型 XSS 漏洞影响 5.7.3 至 9.1.1","`@astrojs/svelte` 在服务端渲染及客户端 hydration 中未对插槽名进行 HTML 转义，含 `\"` 的请求参数可注入任意 HTML。漏洞仅在请求输入被用作插槽名、组件使用 `client:*` 指令 hydration，且 Svelte 5 组件按动态名称渲染对应插槽时触发，可导致站点源上的 JavaScript 执行。",{"_92":117},"2026-11-12T22:34:04.000Z","2026-11-12T22:36:23.892Z",[114,115,126,163],"浏览器","i8fky6zwoekratv2qqrw6hf9g","Addressable URI 模板正则表达式拒绝服务漏洞在 2.9.1 修复","Addressable 的 URI 模板实现存在正则表达式拒绝服务漏洞，使用 `*` 修饰符及 `/`、`.`、`;`、`?` 或 `&` 运算符的模板在匹配恶意 URI 时可能发生灾难性回溯，不足 60 bytes 的输入即可占用线程数分钟。",{"_92":117},"2026-11-12T22:30:37.000Z","2026-11-12T22:36:23.899Z",[114,115,126,127],"eaq8p9vkceheniziq17v2yegd","Addressable URI 模板正则拒绝服务漏洞影响 2.3.0 至 2.9.0，2.9.1 已修复","Addressable URI 模板实现存在正则表达式过度回溯导致的拒绝服务漏洞，恶意 URI 在调用 `Template#match` 或 `Template#extract` 时可造成不受控的资源消耗。",{"_92":117},"2026-11-12T22:29:35.000Z","2026-11-12T22:36:23.906Z",[114,115,138,129],"zk3oj09o0z5nqt9oeu8gibs8f","Addressable 2.9.0 路径规范化缺陷可绕过允许列表，CWE-436","Addressable 2.9.0 的 `URI.normalize_path` 会将部分包含 `..` 段的路径错误解析为不同路径，可能导致允许列表校验绕过。",{"_92":117},"2026-11-12T22:27:58.000Z","2026-11-12T22:36:23.912Z",[114,126,115,127,138],54,"ad5v878f336i8mqu38s9ho2fv","basic-ftp 密码或续传路径含 CR/LF 可导致 Node.js 进程崩溃","basic-ftp 的 Client.login() 与 downloadTo() 在 FTP 响应事件处理器内调用 send()，密码或续传远程路径包含 CR、LF、NUL 时会抛出未捕获异常并终止 Node.js 进程，属于 CWE-248 拒绝服务。",{"_92":117},"2026-11-12T22:23:50.000Z","2026-11-12T22:36:23.920Z",[114,126,127,129,194],52,"Node.js","ffzcn0g14qdscuyb692nza4iy","网络安全专家支招：如何应对 Artex 与 AntiFox","网络犯罪分子正利用 agentic pen-testing 工具扩大攻击面，企业亟须立即制定防御方案。文章未披露 Artex 与 AntiFox 的具体行为、受影响产品或处置细节，但指出采用 agentic pen-testing 工具的趋势已成现实，需尽快部署相应防御计划。",{"_92":208},"2026-11-12T21:18:52.000Z","2026-11-12T22:42:25.345Z","ai-security",[204,205,206,207],28,"AI 安全","Agent 安全","AI 攻防","红队","Dark Reading","mym8ei8kts31rr764ucu6uo4d","日本推进应对 AI 驱动的网络攻击并追加紧急网络安全资金","日本正推动追加紧急网络安全资金，应对 AI 驱动的网络攻击增长。相关对策包包括官民联合网络应对团队、由经济省主导的 AI 专业团队，以及扩大政府行使新设主动网络防卫权限时的裁量空间。",{"_92":208},"2026-11-11T22:14:44.000Z","2026-11-12T22:42:25.365Z","policy",[218,204,219],41,"政策","治理","azjotibfplqodvsedcpslnw3c","攻击者利用 4,837 个失陷 GitHub 账户窃取云凭据","攻击者通过 4,837 个失陷 GitHub 账户探测 61,764 个仓库的写入权限，并利用恶意 GitHub Actions 工作流窃取至少 1,835 个目标的秘密与云凭据。",{"_92":237},"2026-11-12T22:25:30.000Z","2026-11-12T22:49:22.793Z",[102,116,232,233,90,91,234,235,236],true,"sameEvent",{"_64":230,"_66":231},"m2uopbxw2xg55pf3fx6t03uwr","攻击者利用 4,837 个劫持 GitHub 账户在 1,806+ 个仓库运行 CI 密钥窃取器","凭据","供应链投毒","AWS","腾讯","阿里","BleepingComputer","len1892bglcv2fzztlrguxx3t","@grpc/grpc-js-xds 未应用 Route 和 VirtualHost 的 RBAC 覆盖配置","@grpc/grpc-js-xds 的 XdsServer 不会应用匹配 Route 或 VirtualHost 资源中的 RBACPerRoute 覆盖配置。",{"_92":117},"2026-11-12T22:55:47.000Z","2026-11-12T22:57:23.555Z",[114,138,126,127,246],53,"身份与访问","vi39ialopitcrpfz4daquzcaj","Addressable display_uri 可将无效 Punycode A-label 显示为误导性主机名","Addressable::IDNA.to_unicode 在纯 Ruby IDNA 实现中会错误解码无效 Punycode A-label，导致 Addressable::URI#display_uri 显示的主机名与 #host、#normalized_host 及实际连接目标不一致，攻击者控制域名时可借此伪装主机。",{"_92":117},"2026-11-12T22:44:57.000Z","2026-11-12T22:57:23.573Z",[114,115,138,163],48,"cbeqrd0qtncc6b8ysw8onxgjv","Addressable display_uri 主机名显示漏洞可隐藏双向控制与不可见字符","Addressable 的 display_uri 可显示含双向控制、零宽及其他不可见字符的主机名，使其看似可信域名；解析、host、normalized_host 和实际连接不受影响。",{"_92":117},"2026-11-12T22:44:15.000Z","2026-11-12T22:57:23.580Z",[114,115,163,263],42,"邮件安全","tthpdpwhuywrbj6runx9i9ryn","PostgreSQL 18.7 等版本修复 52 个漏洞并终止 PostgreSQL 14 支持","PostgreSQL Global Development Group 于 November 12 发布 PostgreSQL 18.7、17.12、16.16、15.20 和 14.25，修复 52 个安全漏洞及 140 多个其他缺陷，其中 32 个 CVE 的 CVSS 分为 8.8。","原文列出了多版本修复范围、漏洞评分和升级后索引处理事项，便于管理员评估维护与迁移工作。",{"_92":275},"2026-11-12T23:05:33.000Z","2026-11-12T23:14:23.116Z",[114,115,273,274],76,"数据库","漏洞管理","Help Net Security","ug7bx6r9k47tytps319wl93cc","Rails Action View 文本辅助方法存在 XSS 漏洞，影响 Nokogiri 1.19.5 之前版本","Rails Action View 的 highlight 和 simple_format 在使用 HTML5 sanitizer 处理不可信文本时，可能因 Nokogiri 1.19.5 之前未正确转义属性值中的特殊字符而产生 XSS。",{"_92":117},"2026-11-12T23:38:57.000Z","2026-11-12T23:39:24.355Z",[114,115,138],60,"ulcvg4o0tragt5lholju5bt27","Active Storage 的 GCS 直传 URL 漏洞可导致存储域名执行跨站脚本","Active Storage 在 GCS 服务配置 `cache_control` 并接受直传时存在漏洞：V4 签名仅覆盖 `Cache-Control` 和 `Host`。",{"_92":117},"2026-11-12T23:37:55.000Z","2026-11-12T23:39:24.363Z",[114,115,138,90],"l35y7vuh88p977ehz4wzaq6ib","Action Pack 修复 Parameters#each_key 强参数绕过漏洞","Action Pack 的 Parameters#each_key 在传入代码块时返回内部 HashWithIndifferentAccess，可能绕过强参数许可检查，使远程未认证攻击者设置未授权属性。",{"_92":117},"2026-11-12T23:37:09.000Z","2026-11-12T23:39:24.372Z",[114,115,138],"ychw6bek6sbholn90ux3rcvl3","Pillow TIFF 与 EXIF 解析存在重叠标签数据内存耗尽漏洞","Pillow 的 `ImageFileDirectory_v2.load()` 存在内存耗尽漏洞：恶意 TIFF、PNG、JPEG、WebP 或 MPO 文件可通过重叠标签数据，使内存占用按“条目数 × 文件大小”增长。","文章给出可复现的内存放大机制、跨格式影响范围与补丁方案，便于评估 Pillow 服务遭遇拒绝服务的风险。",{"_92":117},"2026-11-12T23:35:39.000Z","2026-11-12T23:39:24.379Z","disclosure",[128,126,138],"lpork1fvur2f6uit9eo593pgd","Pillow libtiff 编码器堆缓冲区溢出分析与修复方案","Pillow 通过 libtiff 保存 TIFF 时，攻击者控制的 EXIF、tiffinfo 或源文件 IFD 几何标签可覆盖实际图像尺寸，导致 libtiff 按标签尺寸读取或写入行缓冲区。","文章从标签合并与扫描行缓冲区尺寸不一致这一根因出发，梳理了内存泄露、崩溃和堆破坏路径，并给出两套可直接验证的修复方案。",{"_92":117},"2026-11-12T23:34:43.000Z","2026-11-12T23:39:24.387Z",[114,126,115,138,315],"数据泄露","lzoj0cqho1tfle19nizvy0a8z","Hono csrf() 中间件未校验 Chrome 链接审计发起的 text/ping 请求","Hono 的 csrf() 中间件存在 CSRF 绕过缺陷，其在 Content-Type 不属于 HTML 表单可发送的三种类型时会跳过来源检查。",{"_92":117},"2026-11-12T23:31:25.000Z","2026-11-12T23:39:24.396Z",[114,138,163],"l6cr3upui2fhh80i5bo06m5ef","Hono `validator('form')` 漏洞可绕过 multipart/form-data 字段校验","Hono 的 `validator('form')` 仅识别只含 `boundary` 参数的 `multipart/form-data` Content-Type，额外合法参数如 `charset` 或分号后的空白会导致表单校验被跳过。",{"_92":117},"2026-11-12T23:30:45.000Z","2026-11-12T23:39:24.402Z",[114,115,126,128],"qrllnfs5bawb685pvun41i9nh","Hono mount() 路径转发缺陷可绕过挂载前缀内的中间件","Hono 的 mount() 与 app.mount() 存在路径转发缺陷，构造请求可绕过外层应用对挂载前缀内子路径配置的认证或授权中间件。动态前缀会按路由模式长度而非实际匹配长度截断路径，自 4.12.21 起还可能因路径重新规范化而将反斜杠转为斜杠并折叠 ..。",{"_92":117},"2026-11-12T23:24:11.000Z","2026-11-12T23:39:24.408Z",[114,138,126,115],66,"ibv2lmjualf61697w8ozpwpp9","Hono RegExpRouter 漏洞可绕过通配符中间件","Hono 的默认 RegExpRouter 在 3 类路由场景中跳过通配符中间件，使未认证客户端可绕过路径上的认证或授权检查直接到达路由处理器或 not-found handler。",{"_92":117},"2026-11-12T23:23:30.000Z","2026-11-12T23:39:24.415Z",[114,138,115],"ypx62331gctoid8ehzgucploz","Hono `css` helper 存在 HTML 注入漏洞，模板与插值值拆分闭合标签可绕过转义","Hono `hono/css` 的 `css` helper 未正确处理模板与插值值拆分形成的闭合标签，客户端可注入 HTML 及 script。仅当 `<` 是模板或前置值的最后一个字符，且紧随不可信插值时受影响，可能导致用户浏览器执行攻击者脚本或泄露页面信息。可通过禁止向 `css` 模板插值不可信值，或确保插值前文本不以 `<` 结尾来规避。",{"_92":117},"2026-11-12T23:22:36.000Z","2026-11-12T23:39:24.421Z",[114,138],38,"r4utjkhwf2dshh8d04am9yfo9","@grpc/grpc-js-xds safe_regex 交替分支导致部分匹配与 RBAC 越权","@grpc/grpc-js-xds 的 safe_regex 匹配器错误地把正则拼接为 ^${regex}$，使 a|b|c 等交替模式产生部分字符串匹配，影响路由选择、xDS 凭据与 RBAC。",{"_92":117},"2026-11-12T23:21:57.000Z","2026-11-12T23:39:24.426Z",[114,126,138],61,"h2occksxu7q3tzi57634syb7r","SCKit 蠕虫式恶意软件借 ScreenConnect 攻击 MSP，尝试反向感染技术人员","SCKit 是由 16 个脚本和组件组成的蠕虫式工具包，目标是在近期针对托管服务提供商（MSP）的 ScreenConnect 攻击中建立持久访问并横向扩散。","分析还原了 SCKit 从客户终端反向感染 MSP 技术人员工作站的链条及关键组件，同时说明利用尝试在已修复客户端上失败。",{"_92":237},"2026-11-12T22:53:10.000Z","2026-11-12T23:40:23.751Z",[102,370,371,127,372],82,"恶意软件","在野利用","供应链","o5ys99zex1rrkw1duagl1hvbm","Chrome Stable 渠道提前发布 158.0.8127.36/.37 更新，Mac 版本即将推出","Chrome Stable 渠道已提前更新至 158.0.8127.36/.37 版本，Windows 用户先行获得该版本，Mac 版本将随后推出。此次为面向少量用户的 Early Stable 发布，完整变更记录可在更新日志中查看，官方同时提供发布渠道切换说明、问题反馈入口与社区帮助论坛。",{"_92":383},"2026-11-12T21:30:51.410Z","2026-11-12T23:43:30.848Z","blue-team",[382,91,163],3,"版本更新","Chrome Releases","e04n66xoe64ucdzz6ocsmokny","欧洲多地学校收到炸弹威胁邮件，两个涉事大学邮箱出现在窃密数据中","11月11日，欧洲多所学校收到以“Mikhail Andropov”署名的炸弹威胁邮件，其中约6,000所意大利学校收到邮件，北爱尔兰警方称超过300所学校收到同类信息，但意大利警方未发现炸弹。",{"_92":104},"2026-11-12T22:42:10.000Z","2026-11-12T23:43:32.155Z",[102,391,232,116,392,89,393],"钓鱼","安全运营","Kaspersky","zpnk0kavca8li3jjygr6z6yiw","Google 公布 Gemini 智能眼镜的拍摄与隐私保护机制","Google 为 Gemini 驱动的智能眼镜设计了录制 LED、防拆检测、旁观者面部遮蔽、语音定向和数据处理限制。Google Shopping 与 Ads 禁止推广隐藏或禁用录制灯的产品，Google Play 禁止应用改变灯的行为或用摄像头直播、进行实时面部识别。",{"_92":275},"2026-11-12T23:45:43.000Z","2026-11-13T00:00:22.870Z",[204,103,91,401],"IoT","j14k1z1xean8n66mb2uz1xjiu","虚假 Zillow 租房页面借 ClickFix 在 Windows 电脑安装 NetSupport RAT","EfficientIP Research Labs 发现虚假 Zillow 公寓评价页面利用 ClickFix，诱使用户通过 Win+R、Ctrl+V、Enter 执行 PowerShell 命令，在 Windows 电脑安装 NetSupport RAT。",{"_92":275},"2026-11-12T23:15:23.000Z","2026-11-13T00:00:22.878Z",[102,370,391,410,411],63,"后门","Cloudflare","genwmxdkg4owofu0nouad3nds","Rails Active Storage 8.1 修复 ImageMagick 任意文件读写漏洞","Rails Active Storage 处理 ImageMagick 附件时存在任意文件写入和读取风险，未认证攻击者上传特制文件即可触发，无需调用变体、预览或 `analyze`。",{"_92":117},"2026-11-12T23:46:51.000Z","2026-11-13T00:00:23.562Z",[114,115,138,372,232],72,"jjfgqilondp6ox7n2mhplx3ol","Ruby on Rails ActionController::Live 存在线程耗尽型 DoS 漏洞","Ruby on Rails 的 ActionController::Live 在客户端停止读取且响应队列已满时，Buffer#close 会阻塞，Buffer#abort 随后无限等待同一监视器，永久占用 Web 服务器线程和 ActionController::Live 线程，可能通过线程耗尽造成 DoS。",{"_92":117},"2026-11-12T23:45:24.000Z","2026-11-13T00:00:23.570Z",[114,115],62,"z5afwdsmivmox11l8k4ccvyfu","Action Pack 修复 Active Storage 代理模式会话信息泄露漏洞","Action Pack 在 Active Storage 代理控制器处理旧格式签名或加密 Cookie 时可能将其重写并写入响应，绕过 `request.session_options[:skip]`。",{"_92":117},"2026-11-12T23:44:39.000Z","2026-11-13T00:00:23.578Z",[114,115,126,138,147,372],"kyoc65xa60m3wbnrkpm1zckfz","Action View highlight helper 存在可能触发 XSS 的漏洞","Action View 的 ActionView::Helpers::TextHelper#highlight 在替换匹配内容时未进行 HTML 转义并将其标记为 HTML 安全，当应用使用把占位符放入引号属性值的 :highlighter，且高亮用户可控文本时，可能造成 XSS。",{"_92":117},"2026-11-12T23:41:50.000Z","2026-11-13T00:00:23.584Z",[114,115,138],"jodr9c2efw4fvclodm8fepnt2","Ruby on Rails Action View strip_tags 存在 XSS 漏洞","Ruby on Rails Action View 的 `strip_tags` 会将仅编码 `&` 和 ` ` 的清理结果标记为 `html_safe`，不可信输入若进入带引号的 HTML 属性，可能闭合属性并新增属性，导致 XSS；作为元素内容渲染不受影响。",{"_92":117},"2026-11-12T23:39:41.000Z","2026-11-13T00:00:23.591Z",[114,115],"all","tag","q","tab","time",{"_455":456,"_457":-5},"changelogVersion","2026-10-01T08:00","release"]
