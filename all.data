5,"_81":226,"_83":84,"_85":86,"_87":-5},{"_64":210,"_66":211,"_68":212,"_70":-5,"_71":213,"_73":214,"_75":215,"_77":148,"_79":216,"_81":217,"_83":84,"_85":86,"_87":-5},{"_64":202,"_66":203,"_68":204,"_70":-5,"_71":205,"_73":206,"_75":207,"_77":148,"_79":208,"_81":209,"_83":84,"_85":86,"_87":-5},{"_64":192,"_66":193,"_68":194,"_70":195,"_71":196,"_73":197,"_75":198,"_77":148,"_79":199,"_81":200,"_83":130,"_85":86,"_87":-5},{"_64":183,"_66":184,"_68":185,"_70":-5,"_71":186,"_73":187,"_75":188,"_77":148,"_79":189,"_81":190,"_83":84,"_85":86,"_87":-5},{"_64":172,"_66":173,"_68":174,"_70":175,"_71":176,"_73":177,"_75":178,"_77":148,"_79":179,"_81":180,"_83":130,"_85":86,"_87":-5},{"_64":164,"_66":165,"_68":166,"_70":-5,"_71":167,"_73":168,"_75":169,"_77":148,"_79":170,"_81":171,"_83":84,"_85":86,"_87":-5},{"_64":156,"_66":157,"_68":158,"_70":-5,"_71":159,"_73":160,"_75":161,"_77":148,"_79":162,"_81":163,"_83":84,"_85":86,"_87":-5},{"_64":142,"_66":143,"_68":144,"_70":-5,"_71":145,"_73":146,"_75":147,"_77":148,"_79":149,"_81":150,"_83":84,"_85":86,"_87":-5},{"_64":122,"_66":123,"_68":124,"_70":-5,"_71":125,"_73":126,"_75":127,"_77":100,"_79":128,"_81":129,"_83":130,"_85":86,"_87":-5,"_131":132},{"_64":109,"_66":110,"_68":111,"_70":-5,"_71":112,"_73":113,"_75":114,"_77":115,"_79":116,"_81":117,"_83":84,"_85":86,"_87":-5},{"_64":94,"_66":95,"_68":96,"_70":-5,"_71":97,"_73":98,"_75":99,"_77":100,"_79":101,"_81":102,"_83":84,"_85":86,"_87":-5},{"_64":65,"_66":67,"_68":69,"_70":-5,"_71":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":86,"_87":-5},"id","maj0nbk20xdjhzz44690rvn06","title","AWS 更新 ProcessUnity Global Risk Exchange 评估，强化云供应商第三方尽职调查","summary","AWS 更新 ProcessUnity Global Risk Exchange 评估报告，帮助客户审查 AWS 安全状况并完善第三方风险管理。评估以动态分析、威胁情报和风险模型替代静态表格，由 ProcessUnity 每年验证结果；客户还可将 AWS 控制项映射至 MITRE ATT&CK、NIST 800-53、ISO 27001、PCI DSS 和 HIPAA，并通过提交访问申请获取报告。","reason","source",{"_92":93},"publishedAt","2026-11-10T21:31:14.000Z","timelineAt","2026-11-10T21:55:45.238Z","category","policy","tags",[88,89,90,91],"score",20,"selected",false,"channel","news","x","版本更新","合规","供应链","AWS","name","AWS Security Blog","no90li9gnsmw59redwnhll6zo","Artex 渗透测试工具被黑客武器化，可高速发起凭据攻击与云入侵","开源 Artex 框架及其分叉版本可被用于高速执行凭据攻击和云环境入侵，并与另外 45 款类似渗透测试工具一样具备机器级攻击能力。相关工具正被黑客转化为武器，可能影响多个行业。",{"_92":108},"2026-11-10T21:01:14.000Z","2026-11-10T21:56:35.975Z","activity",[103,104,105,106,107],44,"攻击活动","AI 攻防","红队","凭据","云原生","Dark Reading","l3kr425ji6m4hgjm95pa0r778","F-Secure 发布 AI 危害分类体系，梳理 26 种消费者风险及防御节点","F-Secure 发布新的 AI 危害分类体系，梳理 AI 系统对消费者造成危害的 26 种方式。内容追踪危害如何从误导性 chatbot 回答延伸至遭入侵的自主 agent，并指出各环节可部署防御措施的位置。",{"_92":108},"2026-11-10T20:41:45.000Z","2026-11-10T21:56:36.020Z","ai-security",[118,119,120,121],37,"AI 安全","模型安全","Agent 安全","技术研究","vdi8z9m8n0eq36t3nuw34nxc0","Russia 关联 APT Turla 以 Cereal 工具集入侵哈萨克斯坦和罗马尼亚 Exchange 服务器","ESET 发现 Russia 关联 APT 组织 Turla 使用新工具集 Cereal 入侵哈萨克斯坦和罗马尼亚政府机构的 Microsoft Exchange 服务器，并将其用于长期网络间谍活动。",{"_92":141},"2026-11-10T20:40:48.000Z","2026-11-10T21:56:40.306Z",[103,135,136,137,138,139,140],81,true,"sameEvent",{"_64":133,"_66":134},"sif366thhfeqdn24sve2qcy60","Turla 利用 Microsoft Exchange 服务器部署 Cereal 后门窃取邮件","后门","恶意软件","数据窃取","Microsoft","ESET","CISA","Security Affairs","fpyw5j9do6zv267mmbn2w9cr2","compose-lint 0.31.0 存在 PR 路径注入 GitHub Actions 工作流命令漏洞","compose-lint 0.31.0 会在参数解析器的错误消息中原样输出仓库路径，Pull Request 可借此向 GitHub Actions 注入工作流命令，操纵日志注释、折叠或隐藏内容，但不会改变检查的通过或失败结果。",{"_92":155},"2026-11-10T21:58:53.000Z","2026-11-10T22:03:35.043Z","vuln",[151,152,153,154,90],52,"漏洞","补丁","复现","漏洞利用","GitHub 安全公告","oc2ocpdc11kfu1353uqoj02ro","compose-lint v0.30.0 和 v0.31.0 存在 GitHub Actions 命令注入漏洞","compose-lint v0.30.0 和 v0.31.0 的 GitHub Action 在 `sarif-file:` 指向无法创建的子目录时，会输出目录解析路径，攻击者可通过提交包含换行和命令的符号链接，在代码审查前向 CI runner 注入命令并操纵作业日志。",{"_92":155},"2026-11-10T21:50:54.000Z","2026-11-10T22:03:35.049Z",[151,152,153,154],48,"lb3z9jzle7urpcuy0kn1zthcd","compose-lint 0.31.0 JSON 与 SARIF 输出可注入 GitHub Actions 工作流命令","compose-lint 0.31.0 在通过 stdout 输出 JSON 或 SARIF 时，会原样传递服务名称或其他值中的 `##[`，使恶意 Pull request 可在 CI 日志中执行 GitHub Actions 工作流命令、创建注解或折叠日志。",{"_92":155},"2026-11-10T21:40:50.000Z","2026-11-10T22:03:35.056Z",[151,152,153,90],47,"nypzu48uooruzzhyeowlg5cl5","Active Storage 8.1 存在视频预览与图像处理任意文件读取及 RCE 风险","Active Storage 8.1, < 8.1.4.1 存在漏洞，攻击者可通过控制上传文件名和内容类型影响 ffprobe、ffmpeg 与 ImageMagick 选择的解码器，利用启用 AviSynth 的 FFmpeg 读取应用可访问文件或加载上传的本地库，可能导致 RCE。","文章梳理了上传文件名如何影响外部工具解码器选择，并给出受影响条件、升级版本、补丁与临时规避方法，便于维护者评估处置优先级。",{"_92":155},"2026-11-10T21:38:55.000Z","2026-11-10T22:03:35.063Z",[151,152,154,181,182],75,"漏洞分析","大模型","ctsca6wsf1xgt0aka9cai8ftt","Active Storage Google Cloud Storage 直传可绕过文件大小限制","Active Storage 在生成 Google Cloud Storage 直传 URL 时未绑定声明的 `byte_size`，直传请求也缺少长度约束，客户端可上传任意大小文件并绕过应用文件大小校验与配额。",{"_92":155},"2026-11-10T21:37:19.000Z","2026-11-10T22:03:35.071Z",[151,152,191,107],53,"Google","n12d2xr0theol7egqezcvggxt","Active Support safe_constantize 存在潜在 DoS 漏洞，影响 activesupport 8.1 且低于 8.1.4.1","ActiveSupport::Inflector#safe_constantize 会将未转义的常量名编译为正则表达式，可能触发 Ruby 正则表达式编译器缺陷并导致服务器进程崩溃，重复请求可造成应用不可用。","原文说明漏洞成因、默认配置下的未认证攻击路径、受影响版本与临时缓解措施，便于 Rails 应用评估暴露面和处置优先级。",{"_92":155},"2026-11-10T21:34:11.000Z","2026-11-10T22:03:35.078Z",[151,152,153,90,201],71,"网络设备","rhcoa5o9bumz35voz1yfjbsdu","Microsoft .NET Aspire 信息泄露漏洞 CVE-2026-120792 公告撤回并合并至 GHSA-q6jf-24jf-m3cg","GitHub Security Advisory（GHSA）撤回 CVE-2026-120792 公告，因其与 GHSA-q6jf-24jf-m3cg 重复。该漏洞影响 Microsoft .NET Aspire，具备认证的本地攻击者可将敏感信息写入日志文件并造成信息泄露。",{"_92":155},"2026-11-10T21:33:44.000Z","2026-11-10T22:37:35.690Z",[151,152,138],21,"d5q2f7wl7mk5uihki7n5kaoha","GHSA-m63f-xhvm-6mv5 重复公告：Microsoft .NET Aspire 存在本地权限提升漏洞 CVE-2026-120778","GitHub Security Advisory 撤销 CVE-2026-120778 公告，原因是其与 GHSA-m63f-xhvm-6mv5 重复，原链接仅为保留外部引用而维护。该漏洞源于 .NET Aspire 在权限不安全的目录中创建临时文件，已获得认证的本地攻击者可借此提升权限；原文未提供受影响版本、补丁状态或 CVSS 分数。",{"_92":155},"2026-11-10T21:33:43.000Z","2026-11-10T22:37:35.695Z",[151,218,138],14,"容器","yjpe1xi04q3e0hyfxov6653wr","Microsoft ASP.NET Core 权限提升漏洞 CVE-2026-114157 公告因重复被撤回","Microsoft ASP.NET Core 存在竞争条件漏洞 CVE-2026-114157，已授权攻击者可在本地并发执行并利用共享资源提升权限。该公告因与 GHSA-7phj-vgxq-r67h 重复而被撤回，链接仅用于保留外部引用；原文未提供受影响版本、CVSS 分数、补丁状态或在野利用信息。",{"_92":155},"2026-11-10T21:32:52.000Z","2026-11-10T22:37:35.702Z",[151,138],16,"wsxuhf47knv1p3tn5oimjo46u","Microsoft ASP.NET Core 安全功能绕过漏洞 CVE-2026-114156 公告重复并撤回","Microsoft ASP.NET Core 存在输入验证不当问题，未经授权的攻击者可经网络绕过安全功能，对应 CVE-2026-114156。该 GHSA 公告因与 GHSA-8w29-6cjc-h6w4 重复而被撤回，链接仅为保留外部引用而继续维护。",{"_92":155},"2026-11-10T21:32:51.000Z","2026-11-10T22:37:35.708Z",[235,138],26,"其他","bmfegl1tx511ozycknpoer73r","GHSA-3893-7fxc-qvff：Microsoft ASP.NET Core 拒绝服务漏洞公告撤回（重复条目）","该 GitHub 安全公告因与 GHSA-3893-7fxc-qvff 重复而被撤回，仅保留链接以维持外部引用。原始描述指出，ASP.NET Core 中存在不受控的资源消耗问题，未经授权的攻击者可通过网络发起拒绝服务攻击。原公告未给出 CVE-2026-114154 的 CVSS 分数、受影响版本区间、补丁状态，也未说明是否已确认被利用。",{"_92":155},"2026-11-10T22:37:35.713Z",[151,243,138],40,"汇总","xylarbrcp5n66afl8i013cxaj","GHSA-wr8v-9x5q-ggcm 重复公告：Microsoft ASP.NET Core 拒绝服务漏洞 CVE-2026-114147","Microsoft ASP.NET Core 存在拒绝服务漏洞 CVE-2026-114147，内存未在有效生命周期结束后释放，未经认证的攻击者可通过网络发起攻击。该公告因与 GHSA-wr8v-9x5q-ggcm 重复而被撤回，链接仅用于保留外部引用，原文未提供受影响版本、CVSS 分数、补丁状态或已遭利用的确认信息。",{"_92":155},"2026-11-10T22:37:35.718Z",[151,138],30,"tbjiri4i4cb5wg7ga6cmt7pwp","Red Hat 发布 Red Hat OpenShift 5，强化混合云智能运维与安全能力","Red Hat 发布 Red Hat OpenShift 5，围绕智能运维、主权安全和长期可预测性三大方向升级混合云应用平台。新版本提供机器驱动接口、MCP 端点及可选的 AI 升级规划功能，Red Hat Advanced Cluster Security 可通过新 MCP server 加速 CVE 修复；平台还引入 PQC 控制以保护控制平面通信。",{"_92":262},"2026-11-10T00:00:00.000Z","2026-11-10T22:55:37.646Z","blue-team",[260,88,107,218,104,261],43,"工具发布","Red Hat","Red Hat Security","z3sqrmee2fikv7ige2l4oj2i8","Red Hat OpenShift 5 正式发布：引入 Kubernetes 1.36、代理式运维与内置零信任安全","Red Hat OpenShift 5 已正式发布，基于 Kubernetes 1.36 和 CRI-O 1.36，支持自建及托管部署，并提供代理式故障排查、集群更新评估和对话式 Perses 仪表盘生成。",{"_92":262},"2026-11-09T00:00:00.000Z","2026-11-10T22:55:37.679Z",[260,88,107,218,271,118,261],28,"加固","cavq76aaesab5sspxhanvhuho","Red Hat OpenShift 5 强化应用与 AI 安全，Advanced Cluster Security 5 改进漏洞治理","Red Hat OpenShift 5 通过网络策略、ML-KEM、机密容器、沙箱化容器及 MCP 服务强化应用和 AI 工作负载安全，Advanced Cluster Security 5 引入 CISA KEV、CVE Origin 指示器及只读 MCP 漏洞查询。",{"_92":262},"2026-11-10T22:55:37.717Z",[260,88,271,107,218,182,261,140],24,"ls7fmpyylskxaymnr22grsi0u","Railway遭入侵，攻击者盗取凭据并产生约74万美元AI欺诈用量","Railway称，攻击者自10月20日起利用其构建基础设施中的未知漏洞逃逸文件系统隔离，再借助错误配置的信任关系获取解密客户环境变量所需的凭据，最多涉及约100,000个工作区。","Railway披露的攻击链、影响上限与处置状态较完整，可用于评估AI平台凭据暴露及多入口入侵风险。",{"_92":291},"2026-11-10T22:20:19.000Z","2026-11-10T22:56:35.304Z",[103,288,289,290,182,106],80,"数据泄露","在野利用","AI 供应链","BleepingComputer","wpc68l4hjniam2rzrhql43ioq","Microsoft 修复 1,093 个漏洞，CVE-2026-124194 已遭在野利用","Microsoft 发布更新修复 Windows 操作系统及受支持软件中的 1,093 个漏洞，其中 63 个严重漏洞可被用于几乎无需用户配合地控制 Windows 系统，近半为远程代码执行，另有 535 个可导致权限提升。",{"_92":304},"2026-11-10T21:55:03.000Z","2026-11-10T22:56:41.729Z",[152,289,300,138,301,191,302,303],70,"漏洞管理","Apple","Adobe","Mozilla","Krebs on Security","k6itb48nnnjyrjydlz0ud9673","Microsoft 11 月补丁汇总：Outlook 零日漏洞已遭利用","Microsoft 11 月补丁涉及大量 Exchange、SharePoint、Windows Search 和 LDAP 高危漏洞，以及一个已遭实际利用的 Outlook 漏洞。文章指出漏洞数量庞大，防守团队需要快速确定修复优先级。",{"_92":108},"2026-11-10T22:26:51.000Z","2026-11-10T22:57:36.217Z",[151,289,152,243,138,313],59,"身份与访问","hlht3uxl8sofi1snu7slyo8mc","Cisco ISE 与 ISE-PIC 存在多个认证绕过漏洞，CVE-2026-20286、CVE-2026-20285、CVE-2026-20183","Cisco ISE 与 Cisco ISE-PIC 的 Web 管理接口因未在服务端验证 Administrator 权限，存在 CVE-2026-20286、CVE-2026-20285 和 CVE-2026-20183，可被已认证远程攻击者利用以修改特定页面的文件描述。",{"_92":323},"2026-11-10T14:37:41.000Z","2026-11-10T22:57:38.817Z",[151,152,322,313],38,"Cisco","Cisco PSIRT","suoa7mnc8re9cdzy2gfvw3p53","CISA 将 GPUStack、FreeSWITCH、OpenSSH 和 IBM Aspera Faspex 漏洞加入 KEV 目录","CISA 将 GPUStack、SignalWire FreeSWITCH、OpenBSD OpenSSH 和 IBM Aspera Faspex 5 的 4 个漏洞加入 KEV 目录。",{"_92":141},"2026-11-10T21:31:24.000Z","2026-11-10T22:57:41.213Z",[151,289,300,152,182,313,140,301,191],"zvwy7ixrx1z4mflrfi6i5rvr9","Microsoft 披露 ASP.NET Core 拒绝服务漏洞 CVE-2026-118749","Microsoft 披露 ASP.NET Core 拒绝服务漏洞 CVE-2026-118749，CVSS v3.1 评分为 7.5，等级为 High。攻击者可在客户端断开连接后，利用攻击者控制的集合触发不断增长的验证错误字典反复复制，造成二次方 CPU 消耗。",{"_92":155},"2026-11-10T23:08:34.000Z","2026-11-10T23:11:35.895Z",[151,152,138],67,"h7coi3rl6gj3sztdxok2qhynj","Microsoft 披露 ASP.NET Core 拒绝服务漏洞 CVE-2026-114149","Microsoft 发布 ASP.NET Core 拒绝服务漏洞 CVE-2026-114149 安全公告，CVSS v3.1 评分为 7.5，等级为 High，CWE-770。",{"_92":155},"2026-11-10T23:06:32.000Z","2026-11-10T23:11:35.904Z",[151,152,138,107],68,"l4umcwqpue919zyy6yaj0rcwo","Microsoft 修复 ASP.NET Core 信息泄露漏洞 CVE-2026-109476，CVSS 6.1","Microsoft 修复 ASP.NET Core 信息泄露漏洞 CVE-2026-109476，CVSS v3.1 评分为 6.1，弱点为 CWE-116。",{"_92":155},"2026-11-10T23:02:40.000Z","2026-11-10T23:11:35.911Z",[151,152,138],"k7cd2ikqko6cpegigoga4p3gn","React Server Components 存在未认证远程代码执行漏洞","React Server Components 在极少数响应同时传输多个类型化数组且包含攻击者可控值时，可导致未认证远程代码执行。",{"_92":155},"2026-11-10T22:44:12.000Z","2026-11-10T23:11:35.918Z",[151,152,153],61,"f5lbf3keywvjpmtq7ey6jmg8y","Microsoft 披露 ASP.NET Core 权限提升漏洞 CVE-2026-109481","Microsoft 披露 ASP.NET Core 权限提升漏洞 CVE-2026-109481，Blazor/SignalR 的 `/_blazor/refresh` 路径可接受跨站请求，将受害者已认证的 principal 绑定至攻击者控制的 circuit。",{"_92":155},"2026-11-10T23:33:36.000Z","2026-11-10T23:45:36.129Z",[151,152,138,313],63,"v59gg93c1qv4ig96op9bs9xl4","Microsoft 披露 ASP.NET Core 拒绝服务漏洞 CVE-2026-118750","Microsoft 披露 ASP.NET Core 拒绝服务漏洞 CVE-2026-118750，FileBufferingReadStream 的缓冲区分配可被未认证的 multipart-form 请求耗尽内存，CVSS v3.1 评分为 7.5。",{"_92":155},"2026-11-10T23:32:00.000Z","2026-11-10T23:45:36.149Z",[151,152,138],"s5w8b6zsw7i0mifgv1d7mwjnc","Microsoft Aspire 存在权限提升漏洞 CVE-2026-120006，CVSS 7.5","Microsoft Aspire 存在权限提升漏洞 CVE-2026-120006，攻击者控制容器在开发者登录 Dashboard 后可重放认证 Cookie，以宿主开发者身份执行代码。",{"_92":155},"2026-11-10T23:24:48.000Z","2026-11-10T23:45:36.173Z",[151,152,218,138],35,"rucjq9fwdjr3m9c6w5ep1t9cq","Microsoft 披露 .NET 安全功能绕过漏洞 CVE-2026-118746","Microsoft 披露 .NET 安全功能绕过漏洞 CVE-2026-118746，影响 Linux 和 macOS 上的 .NET 11 预发布运行时。该漏洞源于 Unix Negotiate 认证在缺少所需 channel-binding 信息时仍可能接受请求，CVSS v3.1 评分为 6.8，等级为 Medium，弱点为 CWE-636。",{"_92":155},"2026-11-10T23:23:57.000Z","2026-11-10T23:45:36.194Z",[151,152,138,392],"操作系统","lnj43ard1dlm2tj549mgfqdle","Microsoft 披露 .NET 拒绝服务漏洞 CVE-2026-109475","Microsoft 披露 .NET 拒绝服务漏洞 CVE-2026-109475，托管的 HttpListener 可递归处理未终止的请求行并耗尽进程栈。该漏洞 CVSS v3.1 评分为 7.5，弱点为 CWE-121，影响 Linux、macOS 上的 .NET 8.0 及多个运行时和独立包。",{"_92":155},"2026-11-10T23:22:54.000Z","2026-11-10T23:45:36.205Z",[151,152,138],62,"z93x33gr6eo2kztgvb031dc3n","Microsoft 披露 .NET 拒绝服务漏洞 CVE-2026-120796","Microsoft 发布安全公告披露 .NET 拒绝服务漏洞 CVE-2026-120796，CVSS v3.1 评分为 5.3，中危，弱项为 CWE-407。",{"_92":155},"2026-11-10T23:21:36.000Z","2026-11-10T23:45:36.212Z",[151,152,138],57,"lyi4fgxxdeozt54wutz0wq35f","Microsoft 披露 .NET CVE-2026-118747 拒绝服务漏洞，CVSS 7.5","Microsoft 披露 .NET 的 CVE-2026-118747 拒绝服务漏洞，碰撞的 CBOR map 键可对唯一性检查实施哈希泛洪，CVSS v3.1 评分为 7.5。",{"_92":155},"2026-11-10T23:20:27.000Z","2026-11-10T23:45:36.218Z",[151,152,138,90],"pqfls9eu06jr5p5tmzm3zybua","AWS 指南：通过 Amazon GuardDuty 自定义规则、抑制策略与 AI 调查降低告警疲劳","Amazon GuardDuty 可通过 Custom Detection Rules、威胁实体列表、抑制规则和 AI 调查减少无效告警并加快处置。文章介绍以 dry run 模式先评估规则噪声，该模式 14 天后自动到期；正式模式可持续生成 finding。",{"_92":93},"2026-11-10T23:04:52.000Z","2026-11-10T23:58:36.915Z",[424,425,260,107,90,91],58,"蓝队","检测工程","osblehwsdmbrgt2v4l98lhsyr","Microsoft 2026 年 11 月补丁汇总：Windows 多个组件漏洞获修复","Rapid7 汇总 Microsoft 2026 年 11 月补丁修复的多项 Windows 漏洞。",{"_92":436},"2026-11-10T21:55:37.000Z","2026-11-10T23:58:37.340Z",[243,152,151,138,392,434,435],5,"内核","Rapid7","Rapid7 CVE 公告","alvq3bji9rzdthfjdmgth78u4","Microsoft ASP.NET Core 拒绝服务漏洞 CVE-2026-118748，CVSS v3.1 7.5","Microsoft 披露 ASP.NET Core 拒绝服务漏洞 CVE-2026-118748，CVSS v3.1 评分为 7.5，等级为高危，弱点为 CWE-770。",{"_92":155},"2026-11-11T00:11:03.000Z","2026-11-11T00:19:35.160Z",[151,152,138,182],"io7yua47bqtw28xpda8fr0m30","Microsoft 披露 .NET SDK dotnet-watch 提权漏洞 CVE-2026-114155","Microsoft 披露 .NET SDK 的 dotnet-watch 组件存在提权漏洞 CVE-2026-114155，CVSS v3.1 评分为 7.5。",{"_92":155},"2026-11-11T00:09:46.000Z","2026-11-11T00:19:35.173Z",[151,152,138,392],"n70uu9jbhdaz6eoaintubuemr","Microsoft .NET 权限提升漏洞 CVE-2026-105544 公告因重复被撤回","Microsoft .NET 存在可导致本地权限提升的不当访问控制漏洞 CVE-2026-105544，已授权攻击者可在本地利用。该公告因与 GHSA-6856-87hx-p5x7 重复而被撤回，原链接仅为保留外部引用而继续维护；原文未提供受影响版本、CVSS 分数、补丁状态或在野利用信息。",{"_92":155},"2026-11-10T21:32:22.000Z","2026-11-11T00:19:35.360Z",[151,138,300],25,"all","tag","q","tab","time",{"_465":466,"_467":-5},"changelogVersion","2026-10-01T08:00","release"]
