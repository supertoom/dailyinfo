81":219,"_83":147,"_85":86,"_87":-5},{"_64":201,"_66":202,"_68":203,"_70":-5,"_71":204,"_73":205,"_75":206,"_77":78,"_79":207,"_81":208,"_83":84,"_85":86,"_87":-5},{"_64":190,"_66":191,"_68":192,"_70":-5,"_71":193,"_73":183,"_75":194,"_77":78,"_79":195,"_81":196,"_83":147,"_85":86,"_87":-5,"_197":198},{"_64":179,"_66":180,"_68":181,"_70":-5,"_71":182,"_73":183,"_75":184,"_77":78,"_79":185,"_81":186,"_83":84,"_85":86,"_87":-5},{"_64":166,"_66":167,"_68":168,"_70":-5,"_71":169,"_73":170,"_75":171,"_77":159,"_79":172,"_81":106,"_83":84,"_85":86,"_87":-5},{"_64":153,"_66":154,"_68":155,"_70":-5,"_71":156,"_73":157,"_75":158,"_77":159,"_79":160,"_81":161,"_83":84,"_85":86,"_87":-5},{"_64":138,"_66":139,"_68":140,"_70":141,"_71":142,"_73":143,"_75":144,"_77":78,"_79":145,"_81":146,"_83":147,"_85":86,"_87":-5},{"_64":125,"_66":126,"_68":127,"_70":-5,"_71":128,"_73":129,"_75":130,"_77":78,"_79":131,"_81":132,"_83":84,"_85":86,"_87":-5},{"_64":118,"_66":119,"_68":120,"_70":-5,"_71":121,"_73":74,"_75":122,"_77":78,"_79":123,"_81":124,"_83":84,"_85":86,"_87":-5},{"_64":109,"_66":110,"_68":111,"_70":-5,"_71":112,"_73":74,"_75":113,"_77":78,"_79":114,"_81":115,"_83":84,"_85":86,"_87":-5},{"_64":100,"_66":101,"_68":102,"_70":-5,"_71":103,"_73":74,"_75":104,"_77":78,"_79":105,"_81":106,"_83":84,"_85":86,"_87":-5},{"_64":93,"_66":94,"_68":95,"_70":-5,"_71":96,"_73":74,"_75":97,"_77":78,"_79":98,"_81":99,"_83":84,"_85":86,"_87":-5},{"_64":65,"_66":67,"_68":69,"_70":-5,"_71":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":86,"_87":-5},"id","fhs86i6bmc0xu4z7el1iuhlvt","title","Schneider Electric 多款产品存在远程代码执行漏洞 CVE-2026-114938","summary","Schneider Electric 多款产品存在 CVE-2026-114938，可导致远程任意代码执行和远程拒绝服务。","reason","source",{"_91":92},"publishedAt","2026-11-25T00:00:00.000Z","timelineAt","2026-11-25T16:01:03.979Z","category","vuln","tags",[88,89,90],"score",52,"selected",false,"channel","news","x","漏洞","补丁","供应链","name","CERT-FR","t2bapj52gok1s1ca08eo3yrj4","Symfony 多项漏洞可导致远程拒绝服务、数据机密性受损及安全策略绕过","CERT-FR 汇总了 Symfony 中多项已发现漏洞，部分可被攻击者用于远程拒绝服务、破坏数据机密性及绕过安全策略。文章未提供具体 CVE 编号、受影响版本或 CVSS 分数，并建议参考 Symfony 官方安全公告以获取修复补丁。",{"_91":92},"2026-11-25T16:01:03.986Z",[88,89],43,"nxqzxovscacl4r53lsr0g4fhl","Palo Alto Networks PAN-OS 提权漏洞 CVE-2026-43600 已被积极利用","Palo Alto Networks PAN-OS 存在可导致权限提升的漏洞 CVE-2026-43600，厂商已确认其正在遭到积极利用。",{"_91":92},"2026-11-25T16:01:03.993Z",[88,107,89,108],66,"在野利用","Palo Alto","akwep336mmjmmpl5n97d44zfs","CERT-FR 汇总 Tenable Enclave Security 的 159 项漏洞并提供修复指引","CERT-FR 汇总 Tenable Enclave Security 的 159 项漏洞，关联 CVE-2023-48795、CVE-2025-11187 等多个编号。原文未说明各漏洞类型、受影响版本、CVSS 分数及利用前提，仅指明应查阅厂商安全公告 tns-2026-41（23 novembre 2026）获取补丁。",{"_91":92},"2026-11-25T16:01:04.000Z",[88,89,116,117],22,"汇总","Tenable","ndbt1pigc1exdgpgku1muqwt2","Laravel 披露远程拒绝服务漏洞 GHSA-c25c-x5r7-2v5m","CERT-FR 发布 Laravel 远程拒绝服务漏洞通告，受影响版本为 laravel 12.x antérieures à 12.74.0 和 laravel 13.x antérieures à 13.44.1。攻击者可远程触发拒绝服务，修复信息参见 25 novembre 2026 发布的 Laravel 安全公告 GHSA-c25c-x5r7-2v5m。",{"_91":92},"2026-11-25T16:01:04.006Z",[88,89],58,"woakba0txl91nu6kv31iqcnmi","GeoServer 漏洞 CVE-2026-120705 与 CVE-2026-129243 已遭利用探测","攻击者正利用 GeoServer 漏洞 CVE-2026-120705 和 CVE-2026-129243 探测存在漏洞的服务器，WatchTowr 已观察到通过创建并调用存储查询发送基于错误的利用探针，但尚未发现成功实现远程代码执行（RCE）的案例。",{"_91":137},"2026-11-25T15:27:36.000Z","2026-11-25T16:06:03.320Z",[88,107,133,134,135,136],69,"利用链","漏洞分析","复现","Rapid7","SecurityWeek","ahf6lsd45crjs7phxjmn4d0q3","CISA 警告 Danfoss AK-SM 8xxA 控制器未修复的 RCE 漏洞 CVE-2026-129713","Danfoss AK-SM 8xxA 系列控制器存在 CVE-2026-129713 栈型缓冲区溢出漏洞，CVSS 评分为 9.8，未经认证的攻击者可触发服务器重启，并可能以 Web 服务器权限实现远程代码执行。","该漏洞已在欧洲多地针对制冷控制器的攻击中使用，读者可结合未认证利用条件与厂商修复计划评估暴露风险。",{"_91":152},"2026-11-25T16:13:40.000Z","2026-11-25T16:21:03.689Z",[88,107,148,149,150,151],83,true,"IoT","工控","漏洞管理","CISA","BleepingComputer","f5kgq8vqjmt1dxbgtpoap8b2n","攻击者以虚假招聘评估攻击 .NET 开发者，投放 13 个恶意 NuGet 包","研究人员发现，攻击者通过虚假招聘活动向 .NET 开发者分发 13 个恶意 NuGet 包。恶意包会安装恶意软件，并使攻击者获得开发者机器的访问权限；原文摘要未披露具体包名、受影响版本、载荷细节及处置建议。",{"_91":165},"2026-11-25T15:48:04.000Z","2026-11-25T16:24:08.841Z","activity",[162,163,164,90],63,"攻击活动","恶意软件","供应链投毒","Dark Reading","xumryba1q36nikimqnawnqx0v","DOJ 发起美国史上最大反诈骗行动，逾 800 名被告涉 400 余起案件","美国司法部（DOJ）11 月 24 日通报，自 3 月以来已在 85 个联邦地区办理 400 余起诈骗案件，涉及 800 多名被告，为其规模最大的反诈骗行动，行动依据 3 月 6 签署的 Executive Order 14390。",{"_91":178},"2026-11-25T16:00:00.000Z","2026-11-25T16:24:08.980Z",[162,173,174,175,176,177],"数据窃取","邮件安全","勒索","黑产","Microsoft","Infosecurity Magazine","ax2kbfj8qxz88rx1ampkaftay","Microsoft Windows 远程访问 API 本地权限提升漏洞 CVE-2026-119853 已复现","Microsoft Windows 远程访问 API 自定义拨号器存在本地权限提升漏洞 CVE-2026-119853，受影响版本涵盖 Windows 10、Windows 11、Windows Server 2016、2019、2022 和 2025。",{"_91":189},"2026-11-25T09:18:00.000Z","2026-11-25T17:19:04.658Z",[88,89,135,134,187,177,188],67,"操作系统","深信服","深信服千里目安全实验室","p5sjx2d7ile73kobdy6s3a12y","GeoServer 认证前 RCE 利用链涉及 CVE-2026-129242 等 5 个漏洞","GeoServer 存在由 CVE-2026-129242、CVE-2026-129243、CVE-2026-129244、CVE-2026-129245、CVE-2026-120705 组成的认证前远程代码执行利用链。",{"_91":189},"2026-11-25T17:19:04.680Z",[88,133,135,89,134,188],80,"sameEvent",{"_64":199,"_66":200},"nhx83jvk238i041bf7tt09eqs","GeoServer 未认证远程代码执行漏洞链 CVE-2026-129242 等已复现","sclwk2y36rm699v4fujou4n22","VMware vCenter Server 身份验证绕过漏洞 CVE-2026-123903 通告，CVSS 9.8","Broadcom 修复 VMware vCenter Server 身份验证绕过漏洞 CVE-2026-123903，CVSS 评分 9.8，漏洞细节与 PoC 已公开，绿盟科技CERT 暂未发现在野利用。",{"_91":211},"2026-11-25T05:15:00.000Z","2026-11-25T17:19:08.876Z",[88,89,135,209,210],75,"VMware","漏洞利用","绿盟科技CERT","q0lsfhn32cxsdecbzc9oo3rfd","GeoServer 修复 5 个高危漏洞，CVE-2026-120705 等漏洞细节与 PoC 已公开","GeoServer 修复 CVE-2026-120705、CVE-2026-129242、CVE-2026-129243、CVE-2026-129244、CVE-2026-129245，涉及 WFS 存储查询、服务安全规则、remember-me 会话及 JDBC 安全服务，可串联形成未经身份验证的远程代码执行利用链。","通告列明多个漏洞的利用链、评分、版本范围与修复版本，并提供升级和临时收敛访问面的处置方法。",{"_91":211},"2026-11-25T17:19:08.897Z",[88,89,135,210,133,150],70,"mfr4flv89w9erp7y1vhyrsd0j","Microsoft 入选 2026 Gartner® Magic Quadrant™ 邮件安全领导者","Microsoft 再次入选 2026 Gartner® Magic Quadrant™ 邮件安全领导者。Microsoft Defender 日均筛查 5.2 亿封邮件，并在四周内拦截近 10,000 次 prompt injection 尝试；其 ISOC 整合 SIEM 与 XDR，支持跨邮件、端点、身份和云开展调查响应。",{"_91":233},"2026-11-25T17:15:00.000Z","2026-11-25T18:23:22.532Z","blue-team",[229,230,231,174,232,177],26,"蓝队","AI 安全","Agent 安全","检测工程","Microsoft Security Blog","evawv01n2kmi78nm1sc05xfgi","FBI 协助全球反诈行动解救逾 2,200 名人口贩运受害者","FBI 通过 Operation Blackout 协助解救并遣返逾 2,200 名被贩运至诈骗园区、强迫实施诈骗的人员，已拆除亚洲、非洲和中东逾 29 个诈骗园区。",{"_91":243},"2026-11-25T17:22:40.000Z","2026-11-25T18:23:24.103Z",[162,176,173,242],36,"钓鱼","Hackread","abs2i381m778rb75ywh1u3gcs","Amazon Cognito Plus 计划将用户池月度可用性承诺提升至 99.99%","Amazon Cognito 将 Plus 功能计划的用户池月度可用性承诺从 99.9% 提升至 99.99%，自 2026 年 11 月 1 日起生效，Essentials 和 Lite 仍为 99.9%。",{"_91":258},"2026-11-25T17:50:39.000Z","2026-11-25T18:25:23.076Z","policy",[253,254,255,256,257],16,"标准","版本更新","云原生","身份与访问","AWS","AWS Security Blog","wbx0pv97byuykd2zb3n3k4m7n","Cisco Talos 分析 OpenAI 关联 AI 智能体沙箱逃逸与 ARTEX 攻击框架","Cisco Talos 分析 OpenAI 关联的多智能体系统如何借助公共服务突破容器沙箱，并讨论其协调、任务拆分和自适应机制。研究指出，ARTEX 等框架已在真实环境中将单一被盗凭据转化为深入网络访问，最快不到 15 分钟；防守方可监测突发暂停模式、异常公共服务流量及特定 URL 参数或文件名。",{"_91":271},"2026-11-25T19:00:00.000Z","2026-11-25T19:26:20.329Z",[116,230,231,267,162,163,268,269,270,151],8,"AI 攻防","Google","Cisco","Check Point","Cisco Talos","a0yjxc97vqkvhyceak5sspmns","Rapid7 入选 2026 Gartner® 魔力象限集成安全运营中心系统领导者","Rapid7 被列为 2026 Gartner® 魔力象限集成安全运营中心系统（Integrated Security Operations Center Systems）的领导者，其 Rapid7 Command Platform 下的 Rapid7 Incident Command 将 SIEM、SOAR、DFIR、攻击面管理与威胁情报整合进同一 SOC 视图。",{"_91":282},"2026-11-25T18:34:43.000Z","2026-11-25T19:26:24.780Z",[280,281,232,136],6,"工具评测","安全运营","Rapid7 CVE 公告","wihu6e4vsmw0dqjqkeoi0z2ry","Cisco UCS 及相关设备披露 UEFI Shell Secure Boot 绕过漏洞","Cisco 披露 UCS 及基于 UCS 的设备存在 UEFI Shell Secure Boot 绕过漏洞，并按服务器产品线、管理模式及设备类型列出首个修复版本。",{"_91":291},"2026-11-25T10:29:45.000Z","2026-11-25T19:27:20.900Z",[88,89,269,187],49,"Cisco PSIRT","vmd3wveo5irrp4hf539q61crn","Laradocs KaTeX SSR 命令注入漏洞分析：Node.js 路径未转义，CWE-78","Laradocs 在服务端 KaTeX 渲染中因 Node.js 二进制路径未经过 `escapeshellarg()` 而存在本地命令注入（CWE-78），影响 0.4.0 及 1.0.0，修复提交为 `100cb1e`。",{"_91":300},"2026-11-25T19:41:53.000Z","2026-11-25T19:43:19.245Z",[88,89,134],17,"GitHub 安全公告","qh34asxyduqkwpaz8bcv6lfp4","fulgur 0.4.4 至 0.28.0 之前版本存在 string-set 内存与 CPU 耗尽漏洞","fulgur 的 CSS `string-set` 命名字符串按元素无上限累积，可被攻击者用小型 HTML/CSS 载荷放大为大量保留内存及复制开销，耗尽服务器资源并影响同机租户。",{"_91":300},"2026-11-25T19:46:45.000Z","2026-11-25T20:03:19.453Z",[88,89,134,90],37,"ejeee9muwwcqx983y3kcilia1","livewire-powergrid 6.10 的 naturalSort 排序存在 SQL 注入","livewire-powergrid 6.10 的 naturalSort 功能存在 SQL 注入，攻击者可在 POST /livewire/update 中控制 sortField=\"\" 与 sortDirection，经 ColumnRawQueries 管线绕过 Laravel 的 asc/desc 校验，将任意 SQL 注入 ORDER BY。",{"_91":300},"2026-11-25T19:44:57.000Z","2026-11-25T20:03:19.467Z",[88,135,210,134,317],61,"数据库","ok6098ql8nqs69svq8tvt7hwa","Italy 与 Switzerland 报告 AI Agent 驱动的大规模网络攻击","Italy 与 Switzerland 警告 AI Agent 已被用于针对关键基础设施组织的自动化网络攻击。CSIRT Italia 观察到多个 Agent 并行工作，在数小时内入侵大量暴露端点；其中一个 DeepSeek Harness 案例由协调器向 5 个 Agent 分配任务，串联漏洞、配置错误和被盗凭据进入内网，并实时编写恶意代码规避端点防护。","两国的实际事件展示了 AI Agent 并行识别弱点、串联利用链并自动生成恶意代码的作战方式，防守重点与攻击路径具有直接参考价值。",{"_91":152},"2026-11-25T19:39:31.000Z","2026-11-25T20:20:19.306Z","ai-security",[230,231,162,107,328,210],84,"红队","oj49ujm4l48drazi41gz2mkzv","Microsoft 披露 ARTEX 自主 AI 渗透测试框架被多类威胁组织滥用于攻击","Microsoft Threat Intelligence 发现，2026 年 7 月发布的开源 AI 自主渗透测试框架 ARTEX 已被 Storm-0940、Storm-3358、Onyx Sleet、Pearl Sleet、Crystal Typhoon 和 Salt Typhoon 等威胁组织用于网络侦察、凭据攻击、Web 应用利用及供应链入侵。",{"_91":233},"2026-11-25T18:09:06.000Z","2026-11-25T20:25:23.004Z",[162,163,267,231,337,177],82,"AI 编码","qbjpl6k39dav3jyaiaqdrl1cz","AWS CloudHSM 迁移至 AWS KMS 的迁移指南：零停机、成本与密钥管理","AWS CloudHSM 迁移至 AWS KMS 可减少 HSM 设备配置、补丁和高可用性维护开销，多数工作负载可通过改造应用、导入或轮换密钥并重加密数据逐步迁移。迁移可零停机进行，但传统 PKCS#11 等接口需重构，部分支付场景可使用 AWS Payment Cryptography；导入的非对称密钥还应通过 multi-Region key 和异地备份保障可用性。",{"_91":258},"2026-11-25T19:54:52.000Z","2026-11-25T20:27:23.504Z",[229,346,347,255,257],21,"加固","加密","fl87knzyahqtv4qern9fg60cf","1Password 称攻击者复制部分客户账户数据，客户保险库未受影响","1Password 称，攻击者利用一名员工的 GitHub 账号向内部服务推送恶意代码，复制了部分客户的姓名、登录邮箱、账户与用户 ID、创建及最后登录时间、公钥和账户元数据，并从私有仓库获取源代码。",{"_91":243},"2026-11-25T21:19:49.000Z","2026-11-25T21:26:24.325Z",[162,355,164,356,256],"数据泄露","凭据","yrtmu19jznues31mnqdw10ij5","CISA 将 10 个已知被利用漏洞加入 KEV Catalog","CISA 将 10 个已知被利用漏洞加入 KEV Catalog，并依据 Binding Operational Directive (BOD) 26-04 要求 FCEB 机构优先修复资产在补丁前被攻陷后可能取得完全控制权的 KEV 漏洞，同时建立补丁前系统是否已被攻击者的检查要求。",{"_91":368},"2026-11-25T12:00:00.000Z","2026-11-25T21:28:21.881Z",[365,107,150,366,151,367],54,"政策","合规","NVD","CISA 安全公告","a5rp675oe1rvd949ja991rx2l","AWS Sign-In 通过 EMA 和 ID-JAG 强化 AI Agent 对 AWS MCP Server 的访问授权","AWS Sign-In 新增 Enterprise-Managed Authorization（EMA），利用 Identity Assertion JWT Authorization Grant（ID-JAG），让组织通过现有企业 IdP（如 Okta）集中授权 AI 应用访问 AWS MCP Server。",{"_91":258},"2026-11-25T21:00:37.000Z","2026-11-25T21:28:22.593Z",[230,231,377,256,255,378,257],60,"工具发布","大模型","g8d9n283yuss2oehfy8yjtcgw","瑞士确认首起由 AI Agent 辅助的网络攻击，关键基础设施受影响","瑞士 NCSC 确认其首次收到由 AI Agent 辅助实施的网络攻击报告，至少两个行业的多个组织和关键基础设施运营商受到影响，已知攻击均成功攻陷目标系统。攻击者使用 Agentic Offensive Frameworks，让 Agent 搜索已知漏洞、选择工具、评估结果并决定下一步，主要针对弱口令、软件已知缺陷和互联网暴露系统。","材料展示了 AI Agent 加速传统攻击并成功入侵关键基础设施的实例，同时给出暴露面收敛、MFA、最小权限和 24 小时补丁要求。",{"_91":387},"2026-11-25T21:06:55.000Z","2026-11-25T21:28:26.674Z",[162,230,231,107],"Security Affairs","n7n8ft37wrxan2ob86fe65rut","TastyIgniter 媒体管理器存在 SVG 文件上传导致的存储型 XSS 漏洞","TastyIgniter 媒体管理器允许上传包含 XSS 的 SVG 文件，管理员登录并上传恶意文件后，访问对应 URL 即可触发存储型 XSS。PoC 通过 POST /admin/media_manager 完成上传，利用前提是攻击者具备管理员权限；原文未提供 CVE 编号、受影响版本、CVSS 分数、补丁状态或在野利用信息。",{"_91":300},"2026-11-25T21:52:15.000Z","2026-11-25T22:03:19.261Z",[88,135,210,396],24,"浏览器","iihzlri9yx0ljdqwxqduljzdy","Palo Alto Networks 确认 Fragnesia 漏洞 CVE-2026-46300 已用于攻击 PAN-OS 设备","Palo Alto Networks 通报 CVE-2026-46300（Fragnesia，Linux 内核 XFRM ESP-in-TCP 子系统漏洞）已被用于攻击将管理接口暴露在公网的 PAN-OS 设备，攻击者需先获得低权限本地访问权限方可提权至 root。","厂商确认 CVE-2026-46300 已被用于攻击暴露在公网管理接口的 PAN-OS 设备，并给出受影响版本与修复分支。",{"_91":152},"2026-11-25T22:05:09.000Z","2026-11-25T22:20:18.705Z",[107,88,89,406,90,108,151],81,"内核","vhwe2fax4m9ymu05rbldf674y","1Password 员工 GitHub 账号遭入侵，攻击者窃取客户数据","1Password 披露，一名员工的 corporate GitHub 账号被攻破后，攻击者访问私有源码仓库并向后端服务注入恶意代码，下载客户账户记录及内部源码。","事件披露了企业 GitHub 账号被攻破后向 CI/CD 注入恶意代码的完整链路，并列明被窃字段及后续处置。",{"_91":152},"2026-11-25T21:33:33.000Z","2026-11-25T22:20:18.715Z",[162,355,90,356,328],72,"eok30e2pbcjv42ozsxpku1vc2","VMware vCenter Directory Service 认证绕过漏洞 CVE-2026-123890 可无凭据利用","VMware vCenter 的 Directory Service 组件存在严重认证绕过漏洞 CVE-2026-123890。具备 vCenter 网络访问权限且无需任何凭据的攻击者，可取得内置 administrator@vsphere.local 账户的已认证会话，进而控制 vSphere 环境及其管理的 ESXi 主机和虚拟机。原文未说明受影响版本、补丁状态或是否已在野利用。",{"_91":424},"2026-11-25T22:09:46.000Z","2026-11-25T22:27:20.302Z",[88,107,134,256,209],78,"Horizon3.ai","qptpos2ooh3pyaz9fw8wotobw","TastyIgniter 媒体管理器允许通过 .htaccess 上传触发 RCE","TastyIgniter 的媒体管理器允许上传 .htaccess 文件，并可通过 SetHandler application/x-httpd-php 令任意扩展名执行 PHP，进而在服务器运行命令。利用需要管理员权限，原文提供了上传 .htaccess 和伪装为 .jpg 的 PHP 文件两步 PoC，但未说明受影响版本、补丁状态或是否已被利用。",{"_91":300},"2026-11-25T22:24:36.000Z","2026-11-25T22:43:19.892Z","disclosure",[134,135,210,133],"mtizr41rrtqj3aj6cs1ac17ex","TastyIgniter 邮件模板编辑器存在 SSTI 导致远程代码执行","TastyIgniter 邮件模板编辑器存在服务端模板注入漏洞，具备 Admin.MailTemplates 权限的管理员可通过 POST /admin/mail_templates/edit/{id} 注入 PHP 代码，并在使用 X-IGNITER-REQUEST-HANDLER: onTestTemplate 执行模板时实现任意 PHP 执行和完整 RCE。",{"_91":300},"2026-11-25T22:24:13.000Z","2026-11-25T22:43:19.904Z",[88,135,210,134],"dvap1w4yyxbrab1n3anhwllho","TastyIgniter 媒体上传功能存在路径遍历漏洞，可越权写入任意文件","TastyIgniter 媒体管理器的文件上传功能存在路径遍历漏洞，具备管理员权限的攻击者可将文件写入 `media/uploads/` 之外的其他目录，并可能覆盖已有文件。",{"_91":300},"2026-11-25T22:54:30.000Z","2026-11-25T23:03:19.276Z",[88,135,210],41,"e6x96eo7w6tnh394j3addlkrp","Red Hat：数字主权合规与运营韧性之间的差距分析","Red Hat 委托 Futurum Research 对 1,940 名 IT 决策者开展研究，欧洲和中东受访者在数字主权执行上明显滞后，仅 37.7% 进入试点或部署阶段，62% 仍停留在部署前。全球仅不到 3% 的企业团队具备在主要供应商中断时维持关键服务的完整能力；通过开放平台、工作负载可移植性和合同控制，可在利用 hyperscaler 创新的同时增强运营自主性。",{"_91":456},"2026-11-24T00:00:00.000Z","2026-11-25T23:27:18.719Z",[253,366,90,378,455],"Red Hat","Red Hat Security","upt5j5hlh2oenbz5d4azhqrkz","OpenAI 与 Cisco 的 Shirudo 探索自防御系统架构：运行时 eBPF 控制","OpenAI 与 Cisco 的 Shirudo 项目探索自防御系统，通过运行时 eBPF 控制，让智能体能够生成、验证、签名并应用控制措施，且无需关闭主机。其目标是以机器速度作出响应并保持服务持续运行，核心理念是避免策略执行与业务运行发生冲突。",{"_91":424},"2026-11-25T22:30:21.000Z","2026-11-25T23:28:20.475Z",[230,231,267,269],35,"hbj8sdkf0qojdhafedswgwlo4","AWS Continuum 代码漏洞自动修复获 CyberGym-E2E 基准 89.0% 成功率；AWS Security 2026年10月汇总：19 篇博文、33/37 个 CVE 复现、PHP2Shell 提前发现利用","这是一条 2026 年 10 月 AWS Security 汇总，涵盖 19 篇 AWS Security Blog 文章。",{"_91":258},"2026-11-25T23:04:26.000Z","2026-11-25T23:30:25.451Z",[116,229,230,231,255,377,257,177,151],19,"lmx8i3aht3t6pcokh6gs5nlrz","AWS-LC 将后量子密码更新纳入例行流程","AWS-LC 通过兼容性、可靠性和性能设计，降低组织升级后量子密码算法的成本与阻力。该通用密码库源自 BoringSSL，兼容 OpenSSL API，并借助形式化验证、算法优化和稳定 ABI 简化更新；AWS 服务端及其 Rust、Java 组件已采用，1Password 也无需修改应用代码即完成混合后量子密钥交换迁移。",{"_91":258},"2026-11-26T00:15:29.000Z","2026-11-26T00:31:10.977Z",[229,346,347,255,257],25,"all","tag","q","tab","time",{"_487":488,"_489":-5},"changelogVersion","2026-10-01T08:00","release"]
