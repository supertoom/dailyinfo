77":205,"_79":237,"_81":196,"_83":84,"_85":86,"_87":-5},{"_64":221,"_66":222,"_68":223,"_70":224,"_71":225,"_73":226,"_75":227,"_77":122,"_79":228,"_81":124,"_83":105,"_85":86,"_87":-5},{"_64":211,"_66":212,"_68":213,"_70":-5,"_71":214,"_73":215,"_75":216,"_77":205,"_79":217,"_81":218,"_83":84,"_85":86,"_87":-5},{"_64":199,"_66":200,"_68":201,"_70":-5,"_71":202,"_73":203,"_75":204,"_77":205,"_79":206,"_81":21,"_83":84,"_85":86,"_87":-5},{"_64":189,"_66":190,"_68":191,"_70":-5,"_71":192,"_73":193,"_75":194,"_77":122,"_79":195,"_81":196,"_83":84,"_85":86,"_87":-5},{"_64":180,"_66":181,"_68":182,"_70":-5,"_71":183,"_73":184,"_75":185,"_77":102,"_79":186,"_81":187,"_83":84,"_85":86,"_87":-5},{"_64":167,"_66":168,"_68":169,"_70":-5,"_71":170,"_73":171,"_75":172,"_77":78,"_79":173,"_81":174,"_83":84,"_85":86,"_87":-5},{"_64":155,"_66":156,"_68":157,"_70":158,"_71":159,"_73":160,"_75":161,"_77":78,"_79":162,"_81":163,"_83":105,"_85":86,"_87":-5},{"_64":142,"_66":143,"_68":144,"_70":145,"_71":146,"_73":147,"_75":148,"_77":102,"_79":149,"_81":150,"_83":105,"_85":86,"_87":-5},{"_64":131,"_66":132,"_68":133,"_70":-5,"_71":134,"_73":135,"_75":136,"_77":102,"_79":137,"_81":104,"_83":84,"_85":86,"_87":-5},{"_64":115,"_66":116,"_68":117,"_70":118,"_71":119,"_73":120,"_75":121,"_77":122,"_79":123,"_81":124,"_83":105,"_85":86,"_87":-5},{"_64":95,"_66":96,"_68":97,"_70":98,"_71":99,"_73":100,"_75":101,"_77":102,"_79":103,"_81":104,"_83":105,"_85":86,"_87":-5},{"_64":65,"_66":67,"_68":69,"_70":-5,"_71":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":86,"_87":-5},"id","eollw7ee7l3mctv6vpb1zu21o","title","AWS发布BNM RMiT工作簿与ISO合规指南，支持马来西亚金融机构提交通知","summary","AWS发布BNM RMiT工作簿及5份ISO合规指南，覆盖394项要求，其中208项归AWS责任、186项归客户责任，帮助马来西亚金融机构准备可审计的BNM通知材料。","reason","source",{"_93":94},"publishedAt","2026-11-17T17:12:08.000Z","timelineAt","2026-11-17T17:19:34.287Z","category","blue-team","tags",[88,89,90,91,92],"score",47,"selected",false,"channel","news","x","蓝队","合规","云原生","加固","AWS","name","AWS Security Blog","f8ncv2a1cko0q6hhiockby3pz","Microsoft 揭示设备码钓鱼对 GitHub Copilot CLI 代理的四类影响","Microsoft 以 GitHub Copilot CLI 为例说明，攻击者诱使用户批准设备码授权后，可在实验环境中远程操控已启用远程控制的会话、植入误导性记忆、读取云同步会话及访问私有仓库。","受控实验揭示了设备码钓鱼接入 AI 编程代理后的四类风险，并给出可落地的检测、处置和权限收敛方法。",{"_93":114},"2026-11-17T15:00:00.000Z","2026-11-17T17:20:32.997Z","ai-security",[106,107,108,109,110,111,112,113],76,true,"AI 安全","Agent 安全","技术研究","复现","钓鱼","检测工程","Microsoft","Google","Microsoft Security Blog","nzt95o0rx92hlv2bv6ms960qe","Google Cloud 披露 COLD RELIC 利用云身份连续入侵两起美国机构事件","Google Cloud 披露俄罗斯国家级组织 COLD RELIC 通过钓鱼、住宅代理和 MFA 疲劳攻击入侵两家美国机构，并利用前一家窃取的人员与关系数据冒充员工，攻击第二家的 Microsoft Entra ID。","案例串联了云身份滥用、跨组织冒充与数据外传链路，并给出可直接落地的会话撤销、代理检测和跨云监测思路。",{"_93":130},"2026-11-17T14:00:00.000Z","2026-11-17T17:21:40.036Z","activity",[125,110,126,127,128,129,113,112,92],77,"攻击活动","恶意软件","数据泄露","后门","红队","Google Cloud 威胁情报","iow7crqgwwabvywd3cynhvef7","GTIG披露多智能体框架exploit_agent自动发现并利用真实攻击中的漏洞","Google Threat Intelligence Group（GTIG）首次发现威胁行为者使用多智能体框架exploit_agent，在无人干预下自动发现并利用Web应用漏洞。",{"_93":141},"2026-11-17T18:16:17.000Z","2026-11-17T18:46:31.501Z",[106,107,138,125,139,140,113],"AI 攻防","大模型","漏洞利用","SecurityWeek","jk2xf7q2h1rx5r54g5jr1b34s","研究人员接管 Hugging Face 上 Kokoro 模型账户并演示模型投毒","研究人员因 Hugging Face 缺少发布者所有权验证，通过注册原所有者公开域名并重置密码接管 Kokoro 账户。团队在本地通过修改模型权重，使相同输入文本生成与原文不一致的音频，87 秒即可完成，且未改动推理代码、上传恶意代码或改变发布者外观。","研究者通过接管模型发布账户并修改权重，展示了开放模型供应链中不依赖恶意代码的攻击路径。",{"_93":154},"2026-11-17T18:21:24.000Z","2026-11-17T18:49:31.533Z",[106,151,152,108,153,113,92],79,"模型安全","AI 供应链","供应链投毒","BleepingComputer","cn6javf3ri8dog43dj7dnbdvw","Tor 发布 0.4.9.17 紧急更新以应对持续 DDoS 攻击","Tor Project 发布 Tor 0.4.9.17 安全更新，用于应对持续进行的 DDoS 攻击。攻击产生大量客户端电路流量，已使多数中继运营商受影响并压垮中继节点；该版本包含多项安全修复，其中一项重点加强与 IPv6 处理相关的拒绝服务防御。Tor 建议中继运营商尽快升级，安装后无需采取其他操作，项目仍在开发额外防御并预计近期发布更多版本；原文未说明攻击者身份或攻击开始时间。","文章给出了紧急更新的具体版本、IPv6 处理相关修复及升级要求，运营方可据此判断是否需要立即更新中继节点。",{"_93":154},"2026-11-17T18:04:15.000Z","2026-11-17T18:49:31.539Z",[164,165,91,166],70,"补丁","版本更新","网络设备","ycks6z7rh7qj88qwlqom6qc7j","OffSec 将 PHP2Shell 等 14 个真实 CVE 漏洞制成攻防实战实验室","OffSec 在 10 月最后两周发布 80 多个实战实验室，其中 14 个基于今年披露的真实 CVE，免费的 PHP2Shell 实验室涵盖 CVE-2026-109618 和 CVE-2026-109619。",{"_93":179},"2026-11-17T19:05:02.000Z","2026-11-17T19:20:37.816Z",[175,88,108,106,129,92,176,177,178],16,"工具发布","CISA","CrowdStrike","PHP","Hackread","znegcgp7apxfnu7iziaea85ix","Microsoft 推出 Microsoft Perception，推进 AI Agent 安全运营","Microsoft 在 Ignite 2026 发布 AI Agent 安全能力，Microsoft Perception 正式可用，可通过 playbook 编排红队、蓝队和绿队 Agent，覆盖告警分诊、攻击调查、检测编写、威胁情报、漏洞侦察与 Web 应用渗透测试。",{"_93":114},"2026-11-17T18:14:00.000Z","2026-11-17T19:22:32.755Z",[106,107,175,165,112,139,92,113,176,178,188],46,"Adobe","id1f3bgks9q43w115ce67mesf","Cursor 溯源恶意 Claude Code 扩展致第三方数据泄露","Cursor 追查到一起第三方数据泄露事件，攻击者利用 AI 基础设施提供商 Fireworks 签发的被篡改密钥，访问了 Cursor 的数据与凭据。事件把恶意 Claude Code 扩展与密钥泄露链条连在一起，说明 AI 编码工具链的第三方依赖可能成为入侵入口。",{"_93":198},"2026-11-17T18:38:37.000Z","2026-11-17T19:22:33.173Z",[125,153,152,197],54,"凭据","Dark Reading","mkzk4m7i7p0ykhitydl6nj7vt","CVE-2026-114938 被报告为 Java 17 及以上版本的关键预认证远程代码执行漏洞，CVSS v4 9.2","CVE-2026-114938 被公开报告为 Java 17 及以上版本中的内存损坏漏洞，攻击者无需认证即可远程执行代码，严重等级为 Critical，CVSS v4 评分为 9.2。",{"_93":210},"2026-11-17T18:26:55.000Z","2026-11-17T19:22:35.270Z","vuln",[207,109,208,209],"漏洞","Oracle","Rapid7","Rapid7 CVE 公告","hj7uwdt1znnojxhgt383nvyg7","Oracle 将修复 11 个 Java SE 漏洞，CVE-2026-114938 OpenJDK RCE 报告尚未核实","Oracle 将于 2026 年 11 月 17 日发布 Java SE 的 11 个安全补丁，这些漏洞最高 CVSS 3.1 评分为 8.1，均可能无需认证通过网络利用，但具体组件与后果尚未披露。",{"_93":220},"2026-11-17T15:17:36.000Z","2026-11-17T19:31:32.146Z",[207,164,208,219],68,"利用链","The Hacker News","x0nfqulcxfxxefb4ym9510pen","Trigram 冒充约 50 个 AI 与区块链品牌，用信息窃取器攻击开发者","Trigram 冒充欧洲和美国约 50 个 AI、区块链品牌，以招聘、会议邀请和包裹追踪场景诱导开发者执行信息窃取器，并借助被篡改的代码仓库实施软件供应链入侵。","文章串联招聘、会议邀请、代码仓库劫持等入口，展示了攻击链、目标筛选及失陷数据流转方式。",{"_93":220},"2026-11-17T15:17:28.000Z","2026-11-17T19:31:32.155Z",[125,126,110,229,153,129,113,112,230],"数据窃取","Apple","unq30mjglp7uctnsrkouokg0i","Phoenix applyChatTemplate 端点存在格式字符串注入漏洞","Phoenix 的 applyChatTemplate GraphQL 端点存在格式字符串注入漏洞，未启用认证时无需凭据即可访问，启用认证后任意权限账户均可利用。",{"_93":239},"2026-11-17T20:02:29.000Z","2026-11-17T20:02:32.581Z",[207,109,140,139,197,238],"加密","GitHub 安全公告","fhxm28uj7npkjtubp7k2kan81","GreyNoise 扩展 Elastic Security 实时边缘情报集成，新增 Kibana 仪表板与检测规则","GreyNoise 扩展与 Elastic Security 的实时边缘情报集成，提供 Kibana 仪表板、关联边界与网络活动的检测规则，并为 Elastic Security 事件中的 IP 实时添加 GreyNoise 分类。",{"_93":249},"2026-11-16T16:00:00.000Z","2026-11-17T20:22:32.140Z",[175,111,248,166],43,"安全运营","GreyNoise Blog","qbdg7b3a2508pllcfj3cllxpi","Fireworks AI 凭据泄露导致 Uber 近 149,346 名用户数据被窃","攻击者使用已泄露的 Fireworks AI 内部凭据访问 Uber 外部环境，窃取近 149,346 名用户的姓名、家庭住址、出生日期、驾照号码、驾照及政府签发身份证件图片。","事件展示供应商内部凭据可绕过客户告警并扩大数据暴露面，为审查外部技术提供商权限和监控边界提供具体案例。",{"_93":260},"2026-11-17T19:11:20.000Z","2026-11-17T20:23:37.693Z",[125,127,152,139,197,153,259],75,"Palo Alto","Security Affairs","wud57uz2zmyoxg2sejyi2q2nv","CISA 将 Perforce Puppet Enterprise 反序列化漏洞 CVE-2026-115731 纳入 KEV 目录","CISA 因已有在野利用证据，将 Perforce Puppet Enterprise 的不安全反序列化漏洞 CVE-2026-115731 纳入 KEV 目录。BOD 26-04 要求 FCEB 机构优先修复公开暴露且利用后可完全控制资产的高风险 KEV 漏洞，并检查补丁应用前系统是否已被攻陷；CISA 同时建议所有组织采用基于风险的漏洞管理。",{"_93":270},"2026-11-17T12:00:00.000Z","2026-11-17T20:24:31.426Z",[268,269,164,176],"在野利用","漏洞管理","CISA 安全公告","a8t07j9l4ep1db160rs5nlrhd","Telegram Android widget 安全过滤器可被两种方式绕过并实现 RCE","NebuSec 披露了 Telegram for Android 13.2.2 (7303) 新增 widget 安全过滤器的两种绕过方式：利用过滤器未覆盖的 widget 漏洞，以及串联过滤器覆盖的 widget 漏洞与内核漏洞，研究人员在测试服务器上演示代码越过过滤器并启动手机计算器。","文章拆解了 Telegram widget 安全过滤器的两种绕过路径，并结合源码配置说明实际风险边界与待确认信息。",{"_93":220},"2026-11-17T19:34:20.000Z","2026-11-17T20:26:32.116Z","disclosure",[108,109,281,219,282,126,113,283],72,"漏洞分析","移动端","Kaspersky","llu6o6hvyb1fhew3ufq6i4xpl","Filament Curator 媒体选择器搜索存在跨租户媒体元数据泄露，3.7.8、4.1.1、5.1.1 已修复","Filament 的 Curator 媒体选择器搜索框存在跨租户媒体元数据泄露，已认证用户可检索到其他租户的媒体名称、title、alt、caption、description、path 等信息。",{"_93":239},"2026-11-17T20:49:28.000Z","2026-11-17T20:52:32.058Z",[207,164,281],"oo4q2f2ngdcrutdaeci6zlhru","qbee-agent 符号链接处理不当导致本地提权与任意文件篡改","qbee-agent 的文件管理逻辑因符号链接处理与权限管理不当，可被受管低权限用户利用。",{"_93":239},"2026-11-17T20:48:02.000Z","2026-11-17T20:52:32.064Z",[207,164,109],62,"cck7s2i58mzb7u16tv7au067k","EGroupware SAML 身份提供方选择漏洞可导致认证绕过","EGroupware 的 login() 函数仅检查 idp 参数是否以 https:// 开头，未针对已配置的可信 IdP entity ID 列表进行验证，未认证攻击者可指定其控制的恶意 IdP。",{"_93":239},"2026-11-17T20:47:22.000Z","2026-11-17T20:52:32.070Z",[207,281,109,307],48,"身份与访问","g361ae6glg4oqbhww5x8n8o4r","AWS Advanced JDBC Wrapper 的 RemoteQueryCachePlugin 存在 Java 反序列化 RCE 漏洞 CVE-2026-14265","AWS Advanced JDBC Wrapper 的 RemoteQueryCachePlugin 存在 Java 反序列化 RCE 漏洞 CVE-2026-14265：该插件从共享 Redis/Valkey 缓存读取查询结果时反序列化时未做类过滤，具备共享缓存写权限的攻击者可注入构造的序列化 Java 对象，在应用读取后导致应用服务器上执行任意代码。",{"_93":239},"2026-11-17T20:39:21.000Z","2026-11-17T20:52:32.075Z",[207,92],45,"rbfgfb61e65jeuceo58cciqt9","libp2p gossipsub 默认配置可被单连接耗尽内存","libp2p 的 gossipsub 默认配置未限制订阅主题数量、主题字符串长度或单 peer 订阅量，单个已连接 peer 可通过大量订阅 RPC 持续扩大节点的 topics 映射。",{"_93":239},"2026-11-17T21:06:20.000Z","2026-11-17T21:10:31.958Z",[207,109,140],"m5di75hmofpl7qrax6h1e43i8","js-libp2p 漏洞：攻击者可控 ASN.1 DER 长度可阻塞 Node 事件循环","js-libp2p 的 ASN.1 DER 解码器存在 CWE-130/CWE-400，远程对端可在预认证阶段通过 Identify 消息中的畸形 publicKey 阻塞 Node 事件循环。",{"_93":239},"2026-11-17T21:05:08.000Z","2026-11-17T21:10:31.965Z",[207,109,140,330],"Node.js","m9ip5kfqbt9ao49jtlb1hpua0","SimpleSAMLphp SAML2 HTTP-Artifact 绑定可绕过嵌入 Response 签名校验","SimpleSAMLphp SAML2 的 HTTP-Artifact 绑定在 v6.2.2、v6.2.3 和 master 中存在不完整修复：外层 ArtifactResponse 即使有效签名。",{"_93":239},"2026-11-17T21:00:58.000Z","2026-11-17T21:10:31.971Z",[207,109,140,281,307,178],69,"cjibwynykk323tsg7fhhejmyj","Filament Curator 存在 SVG 存储型 XSS 漏洞，未净化 SVG 可在应用源中执行脚本","Filament Curator 的媒体上传功能存在存储型 XSS：具备媒体上传权限的用户可上传含嵌入式 JavaScript 的 SVG，其他面板用户通过 View 将其作为独立文档打开时，脚本会在 Filament 应用源中执行并可能代表管理员执行操作、读取同源数据或窃取 Cookie 与令牌。",{"_93":239},"2026-11-17T20:54:26.000Z","2026-11-17T21:10:31.977Z",[207,109,164,281],57,"jii005y6keq46mosgbanulhva","FastPeopleSearch 个人信息下线与持续移除指南（2026）","FastPeopleSearch 无需账户或付费即可公开姓名、年龄、住址、电话及亲属信息，完整移除需通过 opt-out 流程提交两份表单，耗时约 5 至 10 分钟，通常允许约 3 天完成。退出后网站仍会从公共及商业数据源收集资料，迁居、换号或购房后数月内可能重新生成页面，需每几个月复查；Google 旧缓存可申请刷新，其他同类网站也需分别提交退出请求。",{"_93":179},"2026-11-17T20:37:14.000Z","2026-11-17T21:22:37.213Z",[88,229,91,197],18,"ktin3oi2uozng5elf9bhiwx89","Amazon Bedrock AgentCore Runtime 安全暴露的两种入口架构","AWS Security Blog 给出 Amazon Bedrock AgentCore Runtime 对外暴露的两种纵深防御架构。",{"_93":94},"2026-11-17T20:31:30.000Z","2026-11-17T21:23:33.384Z",[106,107,139,91,92],61,"z3cizhjdaantl0n6hvsolsm4o","Quad9 因法国法院封锁命令退出法国，公共 DNS 解析器面临合规压力","非营利公共 DNS 解析器 Quad9 因法国法院要求其屏蔽涉嫌版权侵权的域名并处以每日罚款，决定退出法国。文章称其用户包括政府机构、学校、医院和公用事业单位，停服时相关用户可能遭遇无提示的网络中断。",{"_93":375},"2026-11-17T20:24:27.000Z","2026-11-17T21:23:33.825Z","policy",[371,372,166,373,374,113],"法规","行业动态","Cloudflare","Cisco","Cloudflare Blog","h9tqmhar36wrdbyk51hi1mcab","OPTIMJACK 利用 Optimizely 漏洞向至少 178 家组织网站注入恶意 JavaScript","攻击者于 2026 年 11 月 16 日利用 Optimizely Web Experimentation 平台漏洞，在客户账户的 custom Project JavaScript 字段注入恶意代码，至少 178 家组织的网站经合法 CDN 和厂商证书向访客分发。",{"_93":389},"2026-11-17T20:43:14.000Z","2026-11-17T21:24:31.590Z",[125,268,153,229,388,259],84,"sameEvent",{"_64":386,"_66":387},"cpozl5byqasqocx0exg64utib","攻击者劫持 Optimizely Web Experimentation 脚本，178 家组织网站遭注入","供应链","Unit 42","h94md6t1kw24op95mtdgsl9x3","TheMailer 商业钓鱼工具利用 AI 批量生成个性化诱饵","TheMailer 商业钓鱼工具允许攻击者接入自选 AI 模型，为诱饵内容进行个性化处理、规避垃圾邮件过滤器，并将活动扩展至数万名目标。原文仅概述该工具的作战能力，未披露具体受害者、模型配置、代码或指标。",{"_93":198},"2026-11-17T20:58:13.000Z","2026-11-17T21:24:32.548Z",[125,110,138,175,398],55,"邮件安全","eku8ockvk29aydet2snwbemcb","Chrome 158 for Android 更新至 158.0.8127.42，包含稳定性与性能改进","Chrome 158（158.0.8127.42）for Android 已发布，未来几天将通过 Google Play 推送。本次更新包含稳定性与性能改进，除特别说明外，Android 版本包含与对应桌面版本相同的安全修复；桌面版本为 158.0.8127.36/.37。",{"_93":408},"2026-11-17T19:57:34.246Z","2026-11-17T21:24:35.881Z",[407,165,282,113],8,"例行内容","Chrome Releases","cxpqkath9so8ongzhll7oibqa","Chrome 158 稳定版发布，修复 204 项安全问题","Google 将 Chrome 158 推送至 Windows、Mac 和 Linux 稳定渠道，版本为 Linux 158.0.8127.36、Windows/Mac 158.0.8127.36/.37，更新将在未来数日或数周内逐步推出。","公告集中列出 Chrome 158 的 204 项安全修复及对应 CVE、等级和报告者，便于按组件与风险级别梳理升级影响。",{"_93":408},"2026-11-17T19:12:07.339Z","2026-11-17T21:24:35.892Z",[164,417,113],"浏览器","rbofkj88h4ot9kikelcljbtfo","Chrome Extended Stable 桌面版更新至 156.0.8078.108/.109，包含 79 项安全修复","Chrome Extended Stable 渠道的 Windows 和 Mac 桌面版已更新至 156.0.8078.108/.109，将在未来数天至数周内逐步推送。",{"_93":408},"2026-11-17T17:01:33.196Z","2026-11-17T21:24:35.902Z",[207,164,417,113],"t3l0ju6zlyroz3zo0x438qj82","研究人员发现 Docker Hub 公开镜像中的云密钥最快 7.86 秒被窃取","Stony Brook University 研究人员在 8 个公共容器仓库发布 300 个蜜罐镜像，测得公开镜像中的 AWS、OpenAI 和 Anthropic 凭据会遭自动化扫描器提取利用。","该研究通过蜜罐镜像量化公开容器仓库中的凭据暴露窗口，可为镜像发布前的秘密扫描和访问限速提供实践依据。",{"_93":154},"2026-11-17T21:27:17.000Z","2026-11-17T21:32:31.462Z",[108,434,388,435,197,90,92,113],74,"论文","容器","tsj4aacsqql9lxdimthq0m44r","RIKEN 因网络攻击下线 Fugaku 超算，4,222 名用户数据受损","日本 RIKEN 计算科学研究中心称，11 月 10 日至 13 日，未授权攻击者利用 Fugaku 公共状态仪表盘访问多台内部服务器并植入恶意软件，导致 4,222 名 Fugaku 用户的姓名、邮箱地址和用户 ID，以及 375 名 Rikyu 用户的姓名和邮箱地址泄露，电脑中存储的 SSH 私钥、访问密钥和研究数据文件也遭破坏。",{"_93":154},"2026-11-17T20:51:21.000Z","2026-11-17T21:32:31.470Z",[125,127,126,197,443,138],"应急响应","j5ze1ckk5wgmksuh1g4a9adez","Apple 服务与 NSA 网络中断，Equinor 确认遭网络攻击","Apple 因内部更新导致 iCloud 账户登录、App Store、Apple Music 和 AppleCare on Device 等服务中断，Apple 表示多数系统已恢复；NSA 涉密通信网络 NSANet 也发生中断，但无证据显示由网络攻击引起。",{"_93":260},"2026-11-17T20:52:24.000Z","2026-11-17T22:25:38.259Z",[125,443,230],"taftp8yj8gj6gq2pfw66kywm3","OpenJDK Java4Shell 漏洞 CVE-2026-114938 可导致 RCE，Oracle 已发布补丁","OpenJDK 的 Java4Shell 漏洞 CVE-2026-114938 可被未认证攻击者用于 RCE，并可能泄露内存敏感信息。该内存破坏缺陷影响 OpenJDK 17.0.6 及之后版本，Calif 评为 CVSS 4.0 9.2，Oracle 评为 CVSS 3.1 8.1（High）。","原文覆盖受影响版本、利用前提、PoC、补丁和临时缓解措施，便于安全团队评估 OpenJDK 暴露面并安排处置。",{"_93":154},"2026-11-17T23:04:21.000Z","2026-11-17T23:22:32.039Z",[207,109,140,268,164,108,208,460,92,112,461],92,"Red Hat","Atlassian","vxly9xsyouvc4rv5i3cm72biy","AWS WAF Bot Control 简化 Targeted 级别接入，新增 Bot 置信度与 LATEST 规则组版本","AWS WAF Bot Control 现可一键启用 Targeted 检查级别，自动配置机器学习、Bot 置信度动作及 LATEST 规则组版本。经 Amazon CloudFront 交付的应用还可启用自动 AWS WAF JavaScript SDK 集成，多数情况下无需修改代码。",{"_93":94},"2026-11-17T23:15:03.000Z","2026-11-17T23:25:35.477Z",[175,165,88,106,92],25,"biy95vbv3o0374opc2smugahu","Optimizely 第三方平台致 178 家组织网站访客感染 Hydra 类恶意软件","至少 178 家组织因接入第三方平台而使网站访客在不知情下暴露于 Hydra 类恶意软件，其中包括多个知名品牌。事件凸显第三方供应商风险，受影响组织可优先排查所用第三方平台及其在网站中的集成情况。",{"_93":198},"2026-11-17T22:34:22.000Z","2026-11-17T23:26:32.762Z",[125,126,388],44,"rqea4z2nhncrkf2s1jvtvp067","Oracle Java Base64 解码器漏洞 CVE-2026-114938 存在未认证 RCE，CISA 要求立即修补","Oracle Java 的 Base64 解码器存在内存损坏漏洞 CVE-2026-114938，可由特制 Base64 输入触发 JVM 崩溃，并在无需认证的条件下实现远程代码执行。","原文明确利用前提、影响组件和临时缓解措施，读者可据此排查 Java 部署并确定修补优先级。",{"_93":270},"2026-11-17T23:27:32.332Z",[207,164,269,91,208,176],"all","tag","q","tab","time",{"_491":492,"_493":-5},"changelogVersion","2026-10-01T08:00","release"]
