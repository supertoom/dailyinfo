05,"_83":84,"_85":86,"_87":-5},{"_64":198,"_66":199,"_68":200,"_70":-5,"_71":201,"_73":202,"_75":203,"_77":98,"_79":204,"_81":205,"_83":84,"_85":86,"_87":-5},{"_64":187,"_66":188,"_68":189,"_70":-5,"_71":190,"_73":191,"_75":192,"_77":98,"_79":193,"_81":194,"_83":84,"_85":86,"_87":-5},{"_64":175,"_66":176,"_68":177,"_70":-5,"_71":178,"_73":179,"_75":180,"_77":98,"_79":181,"_81":182,"_83":84,"_85":86,"_87":-5},{"_64":162,"_66":163,"_68":164,"_70":-5,"_71":165,"_73":166,"_75":167,"_77":98,"_79":168,"_81":169,"_83":84,"_85":86,"_87":-5},{"_64":153,"_66":154,"_68":155,"_70":-5,"_71":156,"_73":157,"_75":158,"_77":98,"_79":159,"_81":160,"_83":84,"_85":86,"_87":-5},{"_64":144,"_66":145,"_68":146,"_70":-5,"_71":147,"_73":148,"_75":149,"_77":98,"_79":150,"_81":151,"_83":84,"_85":86,"_87":-5},{"_64":135,"_66":136,"_68":137,"_70":-5,"_71":138,"_73":139,"_75":140,"_77":98,"_79":141,"_81":142,"_83":84,"_85":86,"_87":-5},{"_64":127,"_66":128,"_68":129,"_70":-5,"_71":130,"_73":131,"_75":132,"_77":98,"_79":133,"_81":134,"_83":84,"_85":86,"_87":-5},{"_64":117,"_66":118,"_68":119,"_70":-5,"_71":120,"_73":121,"_75":122,"_77":-5,"_79":123,"_81":124,"_83":84,"_85":86,"_87":-5},{"_64":106,"_66":107,"_68":108,"_70":-5,"_71":109,"_73":110,"_75":111,"_77":98,"_79":112,"_81":113,"_83":84,"_85":86,"_87":-5},{"_64":92,"_66":93,"_68":94,"_70":-5,"_71":95,"_73":96,"_75":97,"_77":98,"_79":99,"_81":100,"_83":84,"_85":86,"_87":-5},{"_64":65,"_66":67,"_68":69,"_70":-5,"_71":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":86,"_87":-5},"id","em8yxv7fm7f0t60od87r0z2im","title","如何在攻击者借助 AI 加速时持续掌握安全态势","summary","安全团队应以持续可见性取代按季度汇总的过时快照，及时掌握云账户、身份提供商、终端和代码仓库的真实状态。Anecdotes 可直接连接这些系统并自动汇集数据，适合希望减少人工收集时间、持续跟踪覆盖率及暴露时长的团队；该工具用于看清自身环境，而非实时追踪攻击者。","reason","source",{"_90":91},"publishedAt","2026-11-27T10:32:18.000Z","timelineAt","2026-11-27T11:58:26.220Z","category","blue-team","tags",[88,89],"score",15,"selected",false,"channel","news","x","蓝队","安全运营","name","The Hacker News","j2o7wak2ms7an1c9718vv926w","Q-Dir 与 DesktopOK 官方下载遭投毒，Python RAT 借软件更新链传播","Q-Dir 与 DesktopOK 官方下载及更新文件遭篡改，5 个版本被确认投毒并安装可远程控制的 Python RAT。恶意安装器从外部服务器下载载荷，经 7-Zip 解压运行 RAT，通过伪装 Microsoft Edge 的计划任务持久化，连接 C2 执行命令、传输文件、截图并收集系统及安全软件信息。",{"_90":91},"2026-11-27T09:29:30.000Z","2026-11-27T11:58:26.228Z","activity",[101,102,103,104,105],44,"攻击活动","恶意软件","供应链投毒","供应链","Microsoft","o1ue0pgetjkmwp15g0g2rbxt0","UK Department of Work and Pensions 因网络安全事件下线在线服务","UK Department of Work and Pensions（DWP）因网络安全事件于 November 26 约 21.00 GMT 下线全部在线服务，包括 universal credit 和 state pensions 账户登录及新福利申请；常规福利和养老金支付未受影响，将照常发放。",{"_90":116},"2026-11-27T11:15:00.000Z","2026-11-27T12:05:25.420Z",[101,114,115],57,"数据泄露","应急响应","Infosecurity Magazine","azlloy7v8onj0l0thn1ibz68d","科学家警告：AI 实验室掌握可能破解加密系统的关键技术","科学家警告，AI 实验室正掌握可能破坏加密系统的“重大突破”，但正文未提供相关实验室、具体技术、利用条件、影响范围或验证细节。正文仅称 Bitcoin 可能因此变得毫无价值，未说明其他影响。",{"_90":126},"2026-11-27T12:18:03.000Z","2026-11-27T12:44:21.114Z",[125],9,"其他","Cybernews","e1ar0jk16lika3hgne1qd9kcs","Barclays 美国银行业务确认发生数据泄露，客户 Social Security 号码被盗","Barclays 美国银行业务确认发生数据泄露，银行客户的 Social Security 号码被盗。由于材料仅提供摘要，未披露受影响客户数量、攻击时间、攻击手段、是否已确认数据外泄范围及处置措施。",{"_90":126},"2026-11-27T11:42:07.000Z","2026-11-27T12:44:21.122Z",[101,114],59,"sn8t7dpqbr4jkxubnvzqx0lrv","黑客攻破美国空军 Cloud One 云计算平台","黑客攻破美国空军旗舰级云平台 Cloud One。事件被发现后，部分迁移被暂停，更新被阻塞，一些用户还失去了管理员权限。原文未披露具体攻击手法、受影响范围及处置进展。",{"_90":126},"2026-11-27T11:38:29.000Z","2026-11-27T12:44:21.128Z",[101,114,143,104],47,"云原生","g2gaofqfd6ix4yvtpzy59owvh","黑客称攻击 McDonald's 在 Amazon 上的服务器，窃取近百万客户数据","黑客声称攻击了 McDonald’s 部署在 Amazon 上的服务器，窃取客户数据，近 100 万个电子邮件地址被指泄露。原文仅给出这一规模数字，未披露具体漏洞、攻击手法或数据是否已被验证。",{"_90":126},"2026-11-27T11:34:35.000Z","2026-11-27T12:44:21.134Z",[101,114,152],39,"AWS","aq8uam7ab9dt2a7arvv5gkq6m","黑客泄露从 GoDaddy 窃取的数据，约 25 GB 会议与全员视频","黑客泄露据称从域名注册商及主机商 GoDaddy 窃取的数据，规模约 25 GB，内容包括会议与全员（all-hands）视频。原文尚未说明数据泄露的范围、受影响客户数量，也未确认该批数据是否包含用户凭据或属于此前已被公开的数据集。",{"_90":126},"2026-11-27T11:16:00.000Z","2026-11-27T12:44:21.141Z",[101,114,161],43,"勒索","eyf4sbymvui6crrxn4qzg9u7o","奇安信病毒响应中心每周勒索威胁摘要：PixelLeaks、Dark Project、Direwolf公布新受害公司","奇安信病毒响应中心汇总2026.11.23–2026.11.27的3起勒索事件：PixelLeaks声称窃取LockeBridge Capital Partners的财务、客户、法律和运营资料；Dark Project声称盗走Minichi Inc超过170 GB数据；Direwolf公布Wolters Kluwer为受害公司。",{"_90":174},"2026-11-27T08:50:00.000Z","2026-11-27T12:59:22.073Z",[170,161,171,172,173],16,"汇总","数据窃取","黑产","奇安信","奇安信病毒响应中心","zwxx06n1t66y05lxbnpigar54","AI与云安全事件案例分析周报：CyberStrikeAI云入侵、Check Point管理服务器失陷与PolinRider代码投毒","本周汇总3起AI与云安全事件：CyberStrikeAI利用被盗Terraform自动化任务会话影响2个AWS账号和7个EKS集群；GT13活动导致至少22家组织、24台Check Point管理服务器受影响；PolinRider在375个GitHub仓库植入恶意Python代码。报告建议缩小构建身份权限、排查异常管理会话，并审查测试目录与公用模块；具体执行次数、数据外传及AI参与程度尚未确认。",{"_90":186},"2026-11-27T10:13:00.000Z","2026-11-27T12:59:22.849Z",[170,101,103,143,183,184,185],22,"容器","Check Point","绿盟","绿盟科技研究通讯","vrm3slgzcawoko2rlbxmvis4k","SAP 确认安全事件，攻击者被指窃取 GitHub 令牌并修改源代码","SAP 已确认其 IT 系统出现可疑活动，DER SPIEGEL 报道称攻击者窃取员工访问令牌，并在 GitHub 上修改和复制源代码；SAP 尚未确认相关报道的全部细节。",{"_90":197},"2026-11-27T11:39:20.000Z","2026-11-27T13:06:28.972Z",[101,104,195,196],67,"凭据","AI 攻防","Security Affairs","c86ezhi926qs5veg8ejvsa31j","Apple 标记中国美食应用存在窃取用户图库数据的恶意软件","Apple 标记一款中国美食应用存在恶意软件，该恶意软件会窃取用户图库中的数据。原文仅称应用提供外卖服务，未披露漏洞编号、受影响版本、利用前提、补丁状态或是否确认被利用。",{"_90":126},"2026-11-27T12:47:37.000Z","2026-11-27T13:34:20.942Z",[102,171,206,207],21,"移动端","Apple","bknoooddrd19plhy4sara8iao","英国政府福利系统因网络安全事件下线","英国政府福利系统在网络安全事件后被下线，处置原则是“先隔离遏制，再开展调查”。原文未说明受影响系统、事件性质、攻击者、影响范围、恢复时间或是否已有补丁。",{"_90":126},"2026-11-27T12:46:02.000Z","2026-11-27T13:34:20.951Z",[101,115,114],"n9s2heyicizvrrb5mm97nx5yt","攻击者借 Microsoft Store 应用投放 Vinci RAT，可远程控制系统","eSentire 披露，攻击者通过伪造 Snipping-Tool.exe 下载站点投递 Microsoft 签名的安装程序，并借 Microsoft Store 上架的 Setup Assistant 建立后门，最终部署 Vinci RAT。",{"_90":91},"2026-11-27T11:49:34.000Z","2026-11-27T14:00:26.079Z",[101,102,223,105,104],62,"后门","flqnwk4yjqaic0u463607umsv","FIFA 确认遭黑客入侵，Handsome Boy Hacking Club 声称窃取内部治理与个人资料","国际足联确认网络犯罪者入侵其系统并获取「有限范围的个人和业务信息」，正与执法等机构合作调查，遭袭时间与具体数据类型未披露。",{"_90":232},"2026-11-27T13:21:50.000Z","2026-11-27T14:20:20.454Z",[101,114,105,171],61,"Help Net Security","lyyzjzu1krnc5z7dmithzblu9","AFP 全球新闻平台遭黑客攻击，订阅用户凭据泄露","AFP 全球新闻平台遭黑客攻击并一度下线，订阅用户凭据已被泄露。当前材料仅说明凭据泄露，未披露攻击手法、受影响用户数量或恢复进展。",{"_90":126},"2026-11-27T13:54:00.000Z","2026-11-27T14:24:20.489Z",[101,114,195],58,"nsn6ir0x6m2sef2rdd83m2gkw","Xen 披露 3 个漏洞，影响未安装最新安全补丁的 4.17.x 至 unstable 版本","Xen 存在 CVE-2026-119781、CVE-2026-119782 和 CVE-2026-119783，涉及权限提升、远程拒绝服务及数据机密性受损。未安装最新安全补丁的 Xen 4.17.x、4.18.x、4.19.x 和 unstable 版本受到影响；CERT-FR 建议参考厂商 xsa/advisory-535 获取修复补丁。",{"_90":253},"2026-11-27T00:00:00.000Z","2026-11-27T14:52:21.367Z","vuln",[250,251,252],46,"漏洞","补丁","漏洞管理","CERT-FR","gjq7vmcqkrkguyg5bk5ooqo1k","IBM 多项产品漏洞汇总：涵盖远程代码执行、远程 DoS 与数据机密性风险","CERT-FR 汇总 IBM 多项产品中发现的 126 个漏洞，部分可导致远程代码执行、远程拒绝服务（DoS）及数据机密性受损。相关 CVE 包括 CVE-2023-43804、CVE-2026-102554 和 CVE-2026-129270 等；原文未提供受影响版本、认证前提、CVSS 分数或在野利用信息，修复方案需查阅 IBM 安全公告。",{"_90":253},"2026-11-27T14:52:21.373Z",[250,251,170],20,"g78xeca2hnxmbiphi07v6wahe","Debian 修复 Linux 内核多项漏洞，CERT-FR 收录 140 个 CVE 条目","CERT-FR 汇总了 Debian Linux 内核的多项漏洞，共列出 CVE-2026-99272 至 CVE-2026-99797 区间内的 140 个 CVE 编号。",{"_90":253},"2026-11-27T14:52:21.382Z",[250,251,170,268,269,270],27,"内核","Debian","NVD","yza1u66v1420kn21mvz063ur5","FreeRADIUS 多个漏洞影响 3.0.29 与 3.2.11 之前版本","FreeRADIUS 3.2.x 中低于 3.2.11 的版本，以及低于 3.0.29 的版本受到多个漏洞影响。部分漏洞可导致远程任意代码执行、远程拒绝服务和数据机密性受损，另有绕过安全策略的风险；CERT-FR 未指明具体漏洞类型，修复情况需参考厂商 2026 年 11 月 25 日发布的安全公告。",{"_90":253},"2026-11-27T14:52:21.387Z",[250,251,252],63,"hhqavepufflhp9alea5gg932i","Debian LTS 汇总多项 Linux 内核漏洞修复，涉及 CVE-2026-100080 至 CVE-2026-99512","Debian LTS 发布汇总多项 Linux 内核漏洞修复，涵盖 CVE-2026-100080、CVE-2026-100081、CVE-2026-100082 等多个漏洞条目。修复信息参考 Debian LTS 安全公告 msg00053（11月21日）和 msg00069（11月27日），具体补丁需查阅厂商安全公告的 Documentation 部分。",{"_90":253},"2026-11-27T14:52:21.394Z",[251,170,268,285,269],17,"操作系统","beqjirjlmnihownig4dh62a2a","Red Hat Linux 内核多项漏洞汇总，涵盖 150 个 CVE 并提供 RHSA 补丁","Red Hat Linux 内核多项漏洞汇总列出 150 个 CVE，关联 20 份 RHSA 安全公告，其中 RHSA-2026:102168 等 8 份发布于 23 日、5 份于 24 日、2 份于 25 日、2 份于 26 日，RHSA-2026:104030 与 RHSA-2026:104044 于 27 日发布。公告建议参考厂商安全公告获取修复补丁。",{"_90":253},"2026-11-27T14:52:21.400Z",[250,251,268,293],30,"Red Hat","i0rge45u33ts69uqrhdu0clsz","Synology DSM 与 DSM Enterprise 存在多项漏洞（公告 CERTFR-2026-AVI-1630，Synology_SA_26_22）","CERT-FR 发布 CERTFR-2026-AVI-1630 通告，汇总 Synology DSM 与 DSM Enterprise 的多项漏洞，信息来源于 Synology 24 日发布的安全公告 Synology_SA_26_22。",{"_90":253},"2026-11-27T14:52:21.406Z",[250,251],23,"cp2yg0htqzvgvzapkd4uf8yne","MongoDB 多项漏洞汇总：涉及 RCE、权限提升与数据机密性损害","MongoDB 多项漏洞可导致任意代码执行、权限提升及数据机密性受损，涉及 CVE-2026-135133 等 19 个编号。MongoDB 已于 25 novembre 2026 发布 CDRIVER-6500、MONGOCRYPT-990 等安全公告，用户应查阅对应公告获取修复补丁；原文未提供受影响版本、认证前提或利用情况。",{"_90":253},"2026-11-27T14:52:21.412Z",[250,251,170],32,"sddcalerjiqd19o055yhtqv2g","SUSE 修复 Linux 内核多项漏洞，涉及 CVE-2024-28085 至 CVE-2026-99999 共 99 项","CERT-FR 于 2026 年 11 月 27 日汇总发布 SUSE Linux 内核多项漏洞修复公告，涉及 CVE-2024-28085、CVE-2025-10148、CVE-2025-11563、CVE-2025-9086 及 CVE-2026 系列的 99 个 CVE 编号。",{"_90":253},"2026-11-27T14:52:21.418Z",[250,251,268,170,315,293],24,"Ubuntu","i8swasoa7p81ff3kbk5v712g8","SPIP 4.4.32 修复远程代码执行、SSRF 等多项漏洞","CERT-FR 披露 SPIP 4.4.32 之前版本存在多项漏洞，可导致远程任意代码执行、数据机密性受损、SSRF 与 CSRF。修复方式是参考 SPIP 官方于 27 novembre 2026 发布的安全公告并更新至 4.4.32；公告未提供各漏洞编号或利用条件。",{"_90":253},"2026-11-27T14:52:21.427Z",[250,251,323],54,"漏洞分析","yubbhticb8czrw65r6fla2h4o","SolarWinds Serv-U 曝多项漏洞，涉及远程代码执行、提权与拒绝服务","CERT-FR 汇总披露 SolarWinds Serv-U 多项漏洞，部分可导致远程代码执行、权限提升和远程拒绝服务。",{"_90":253},"2026-11-27T14:52:21.436Z",[250,251,330,104],"网络设备","iumzubpojln46gurdf3hve36s","美国空军 Cloud One 云平台据报遭入侵，攻击范围与数据失窃情况未知","美国空军 Cloud One 云计算平台据报遭黑客入侵，攻击者利用尚未确定的软件漏洞获得访问权限，并可能接触军事行动及后勤敏感信息；平台升级期间发现入侵，应用迁移和软件更新因此中断。",{"_90":341},"2026-11-27T15:09:40.000Z","2026-11-27T15:37:20.199Z",[101,339,114,196,104,105,340],68,"在野利用","CrowdStrike","BleepingComputer","pmq9n1nyhpebkqigde9uh4uz3","防火墙无法消除未管理 VM 的风险：VMware 迁移后的基础设施可管理性分析","未纳管的 VM、权限、隔离和生命周期缺失会形成隐藏攻击入口，即使防火墙、EDR 和网络分段有效，也可能危及整个环境。Broadcom 许可政策推动企业从 VMware 迁移至 Proxmox VE、OpenStack 等方案时，还需整合 RBAC、资源核算、审计、自动化及物理资产管理；ISPsystem 以 VMmanager、DCImanager 和 BILLmanager 构建统一管理平台。",{"_90":341},"2026-11-27T15:00:10.000Z","2026-11-27T15:37:20.208Z",[349,88,350,252,143,351],"工具发布","加固","VMware","z2zj9401f06ahawl7tw5lolqc","G.O.S.S.I.P 阅读推荐：RSA 还安全吗，Google 与 KeyBreak 团队整数分解复杂度进展对比","本条为阅读推荐汇编，围绕 RSA 依赖的大整数分解问题梳理两项工作：Google Research 团队在 GitHub 上传论文，借助 Gemini 4 框架给出整数分解复杂度 L[1/3, 105] 的严格证明，打破 1992 年 Lenstra 与 Pomerance 的 L[1/2] 上界纪录，但常数因子过大，实用性被抵消。",{"_90":367},"2026-11-26T16:17:00.000Z","2026-11-27T16:07:22.477Z","disclosure",[360,361,362,363,364,365,366],"技术研究","论文","加密","AI 安全","大模型","Google","腾讯","安全研究GoSSIP","wuwxqwmjofamcgppwkw7wuf5s","美国空军 Cloud One 云平台遭入侵，攻击范围与数据失窃情况不明","美国空军主要云计算平台 Cloud One 遭黑客入侵，攻击者身份、受影响范围及数据是否被窃取尚未确认。该事件约在 1 个月前升级平台时被发现，导致服务中断、应用更新被阻止，后台应用迁移至 Cloud One 的工作暂停，部分用户管理员权限被撤销。","报道梳理了Cloud One入侵后的服务中断、迁移暂停与权限处置，并指出控制平面可能被利用，为评估军事云平台事件影响提供事实依据。",{"_90":197},"2026-11-27T15:03:05.000Z","2026-11-27T16:09:30.050Z",[101,114,143,104,152,105,378,365],79,true,"Oracle","t6uwzah42cn6jaqs5uqqpomuj","Cacti 远程代码执行漏洞 4http2shell 曝光，CVSS 9.8，PoC 已公开","Cacti 远程代码执行漏洞（4http2shell，又称 4HTTP2ROOT）细节与 PoC 已公开，CVSS 评分 9.8。",{"_90":389},"2026-11-27T10:35:00.000Z","2026-11-27T17:02:38.517Z",[250,387,388,323,339],65,"复现","漏洞利用","绿盟科技CERT","zwjve25gs08dp015hf5g6wdp8","Linux内核NFS越界写入漏洞CVE-2026-99362公开，CVSS 9.8","Linux内核NFS越界写入漏洞CVE-2026-99362的细节已公开，CVSS评分为9.8，未经身份验证的攻击者可向默认TCP 2049端口发送特制COMPOUND请求，造成堆越界写入、内存损坏、信息泄露或系统崩溃，特定条件下可实现远程代码执行。",{"_90":389},"2026-11-27T17:02:38.571Z",[250,251,323,268,104,293,269,315],69,"emxtvs4jso1up4wm8nw6pcp6o","疑似越南关联黑客组织 WeaveLotus 借漏洞和弱口令攻击东南亚","SOCRadar 披露，疑似越南关联组织 WeaveLotus 于 2026 年 8 月至 9 月实施 RedOps 间谍活动，针对菲律宾、泰国和印度尼西亚的军方、政府及立法机构收集南海防务与军事协议情报。","文章拆解了针对东南亚目标的入侵链，并给出具体漏洞、持久化方式和外传数据量，便于对照排查暴露服务与异常访问。",{"_90":91},"2026-11-27T16:36:11.000Z","2026-11-27T17:02:40.965Z",[101,114,195,388,104,406,407,408,409],75,"Palo Alto","Ivanti","Cisco","Fortinet","hhd0vsy1up2wukos9c1vxsi16","Matters.AI 完成印度最大网络安全 Pre-Series A 轮融资，以 AI 应对数据风险","安全初创公司 Matters.AI 完成印度规模最大的网络安全 Pre-Series A 轮融资，将四款传统安全工具整合为自主平台。该平台利用具备上下文感知能力的 AI，追踪敏感数据血缘、分析用户意图，并自动处置企业环境中的威胁。",{"_90":419},"2026-11-27T15:27:20.000Z","2026-11-27T17:10:26.648Z","policy",[125,418],"行业动态","Dark Reading","j158oejps5agmlpskimxzu5ra","Cacti 零日漏洞公开 PoC，未认证攻击者可远程执行命令","Cacti 网络监控平台曝出零日漏洞，公开 PoC 可通过 4 个 HTTP 请求在未认证条件下触发命令执行。研究人员测试了 Cacti Core 1.2.31，更早版本是否受影响尚不清楚；攻击要求启用 guest 账户，但不需要有效凭据。",{"_90":341},"2026-11-27T17:06:13.000Z","2026-11-27T17:39:20.819Z",[250,387,388,339,330,323],"x2s4jv9u69u3d1vpmgq1f9ozp","pCloud Pass 密码管理器遭网络攻击，部分用户邮箱暴露并出现登录尝试","pCloud 确认其密码管理器 pCloud Pass 遭网络攻击，少量用户邮箱地址被暴露并出现登录尝试，攻击已被迅速控制，云存储服务未受影响。",{"_90":341},"2026-11-27T19:26:04.000Z","2026-11-27T19:41:20.525Z",[101,114,195,434],"身份与访问","dd0mowlai9kq6bzrbot0jgdij","Boston Scientific 遭 vishing 攻击，117,789 人个人信息与医疗数据泄露","医疗科技厂商 Boston Scientific 因语音钓鱼（vishing）攻击导致云端应用和云托管数据泄露，影响美国多个州 117,789 人，暴露内容包括姓名、住址、SSN、政府签发证件编号、医疗与健康保险信息及出生日期。",{"_90":341},"2026-11-27T18:57:42.000Z","2026-11-27T19:41:20.532Z",[101,114,443,143],60,"钓鱼","d4a3n74pevzixgfs5t9iqhhv7","ChromeOS LTS-150 150.0.7871.290 推送多项安全修复","Google ChromeOS 面向多数设备推送 LTS-150 版本 150.0.7871.290，Platform Version 为 16700.71.0。",{"_90":454},"2026-11-27T18:52:47.009Z","2026-11-27T20:13:29.185Z",[251,452,453,365],49,"浏览器","版本更新","Chrome Releases","w9wmwpnyzzebm7nsojs6aeo19","CISA 将 OSGeo GeoServer 与 Drupal Core 的 3 个在野利用漏洞纳入 KEV Catalog","CISA 基于真实利用证据，将 OSGeo GeoServer 的 XML 注入漏洞 CVE-2026-120705、授权不当漏洞 CVE-2026-129243，以及 Drupal Core 异常或特殊状况检查不当漏洞 CVE-2026-136716 纳入 KEV Catalog。",{"_90":464},"2026-11-27T12:00:00.000Z","2026-11-27T21:14:24.643Z",[339,250,252,350,463],66,"CISA","CISA 安全公告","all","tag","q","tab","time",{"_471":472,"_473":-5},"changelogVersion","2026-10-01T08:00","release"]
