_81":214,"_83":84,"_85":86,"_87":-5},{"_64":201,"_66":202,"_68":203,"_70":-5,"_71":204,"_73":175,"_75":205,"_77":177,"_79":206,"_81":207,"_83":84,"_85":86,"_87":-5},{"_64":191,"_66":192,"_68":193,"_70":-5,"_71":194,"_73":175,"_75":195,"_77":177,"_79":196,"_81":197,"_83":84,"_85":86,"_87":-5},{"_64":184,"_66":185,"_68":186,"_70":-5,"_71":187,"_73":175,"_75":188,"_77":177,"_79":189,"_81":190,"_83":84,"_85":86,"_87":-5},{"_64":171,"_66":172,"_68":173,"_70":-5,"_71":174,"_73":175,"_75":176,"_77":177,"_79":178,"_81":179,"_83":84,"_85":86,"_87":-5},{"_64":163,"_66":164,"_68":165,"_70":-5,"_71":166,"_73":167,"_75":168,"_77":78,"_79":169,"_81":170,"_83":84,"_85":86,"_87":-5},{"_64":154,"_66":155,"_68":156,"_70":-5,"_71":157,"_73":158,"_75":159,"_77":78,"_79":160,"_81":161,"_83":84,"_85":86,"_87":-5},{"_64":143,"_66":144,"_68":145,"_70":-5,"_71":146,"_73":147,"_75":148,"_77":78,"_79":149,"_81":150,"_83":84,"_85":86,"_87":-5},{"_64":134,"_66":135,"_68":136,"_70":-5,"_71":137,"_73":138,"_75":139,"_77":78,"_79":140,"_81":129,"_83":84,"_85":86,"_87":-5},{"_64":122,"_66":123,"_68":124,"_70":-5,"_71":125,"_73":126,"_75":127,"_77":78,"_79":128,"_81":129,"_83":84,"_85":86,"_87":-5},{"_64":110,"_66":111,"_68":112,"_70":-5,"_71":113,"_73":114,"_75":115,"_77":78,"_79":116,"_81":117,"_83":84,"_85":86,"_87":-5},{"_64":95,"_66":96,"_68":97,"_70":-5,"_71":98,"_73":99,"_75":100,"_77":78,"_79":101,"_81":102,"_83":84,"_85":86,"_87":-5},{"_64":65,"_66":67,"_68":69,"_70":-5,"_71":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":86,"_87":-5},"id","eyf4sbymvui6crrxn4qzg9u7o","title","奇安信病毒响应中心每周勒索威胁摘要：PixelLeaks、Dark Project、Direwolf公布新受害公司","summary","奇安信病毒响应中心汇总2026.11.23–2026.11.27的3起勒索事件：PixelLeaks声称窃取LockeBridge Capital Partners的财务、客户、法律和运营资料；Dark Project声称盗走Minichi Inc超过170 GB数据；Direwolf公布Wolters Kluwer为受害公司。","reason","source",{"_93":94},"publishedAt","2026-11-27T08:50:00.000Z","timelineAt","2026-11-27T12:59:22.073Z","category","activity","tags",[88,89,90,91,92],"score",16,"selected",false,"channel","news","x","汇总","勒索","数据窃取","黑产","奇安信","name","奇安信病毒响应中心","zwxx06n1t66y05lxbnpigar54","AI与云安全事件案例分析周报：CyberStrikeAI云入侵、Check Point管理服务器失陷与PolinRider代码投毒","本周汇总3起AI与云安全事件：CyberStrikeAI利用被盗Terraform自动化任务会话影响2个AWS账号和7个EKS集群；GT13活动导致至少22家组织、24台Check Point管理服务器受影响；PolinRider在375个GitHub仓库植入恶意Python代码。报告建议缩小构建身份权限、排查异常管理会话，并审查测试目录与公用模块；具体执行次数、数据外传及AI参与程度尚未确认。",{"_93":109},"2026-11-27T10:13:00.000Z","2026-11-27T12:59:22.849Z",[88,103,104,105,106,107,108],22,"攻击活动","供应链投毒","云原生","容器","Check Point","绿盟","绿盟科技研究通讯","vrm3slgzcawoko2rlbxmvis4k","SAP 确认安全事件，攻击者被指窃取 GitHub 令牌并修改源代码","SAP 已确认其 IT 系统出现可疑活动，DER SPIEGEL 报道称攻击者窃取员工访问令牌，并在 GitHub 上修改和复制源代码；SAP 尚未确认相关报道的全部细节。",{"_93":121},"2026-11-27T11:39:20.000Z","2026-11-27T13:06:28.972Z",[103,118,119,120],67,"供应链","凭据","AI 攻防","Security Affairs","c86ezhi926qs5veg8ejvsa31j","Apple 标记中国美食应用存在窃取用户图库数据的恶意软件","Apple 标记一款中国美食应用存在恶意软件，该恶意软件会窃取用户图库中的数据。原文仅称应用提供外卖服务，未披露漏洞编号、受影响版本、利用前提、补丁状态或是否确认被利用。",{"_93":133},"2026-11-27T12:47:37.000Z","2026-11-27T13:34:20.942Z",[130,90,131,132],21,"恶意软件","移动端","Apple","Cybernews","bknoooddrd19plhy4sara8iao","英国政府福利系统因网络安全事件下线","英国政府福利系统在网络安全事件后被下线，处置原则是“先隔离遏制，再开展调查”。原文未说明受影响系统、事件性质、攻击者、影响范围、恢复时间或是否已有补丁。",{"_93":133},"2026-11-27T12:46:02.000Z","2026-11-27T13:34:20.951Z",[103,141,142],"应急响应","数据泄露","n9s2heyicizvrrb5mm97nx5yt","攻击者借 Microsoft Store 应用投放 Vinci RAT，可远程控制系统","eSentire 披露，攻击者通过伪造 Snipping-Tool.exe 下载站点投递 Microsoft 签名的安装程序，并借 Microsoft Store 上架的 Setup Assistant 建立后门，最终部署 Vinci RAT。",{"_93":153},"2026-11-27T11:49:34.000Z","2026-11-27T14:00:26.079Z",[103,130,151,152,118],62,"后门","Microsoft","The Hacker News","flqnwk4yjqaic0u463607umsv","FIFA 确认遭黑客入侵，Handsome Boy Hacking Club 声称窃取内部治理与个人资料","国际足联确认网络犯罪者入侵其系统并获取「有限范围的个人和业务信息」，正与执法等机构合作调查，遭袭时间与具体数据类型未披露。",{"_93":162},"2026-11-27T13:21:50.000Z","2026-11-27T14:20:20.454Z",[103,142,152,90],61,"Help Net Security","lyyzjzu1krnc5z7dmithzblu9","AFP 全球新闻平台遭黑客攻击，订阅用户凭据泄露","AFP 全球新闻平台遭黑客攻击并一度下线，订阅用户凭据已被泄露。当前材料仅说明凭据泄露，未披露攻击手法、受影响用户数量或恢复进展。",{"_93":133},"2026-11-27T13:54:00.000Z","2026-11-27T14:24:20.489Z",[103,142,119],58,"nsn6ir0x6m2sef2rdd83m2gkw","Xen 披露 3 个漏洞，影响未安装最新安全补丁的 4.17.x 至 unstable 版本","Xen 存在 CVE-2026-119781、CVE-2026-119782 和 CVE-2026-119783，涉及权限提升、远程拒绝服务及数据机密性受损。未安装最新安全补丁的 Xen 4.17.x、4.18.x、4.19.x 和 unstable 版本受到影响；CERT-FR 建议参考厂商 xsa/advisory-535 获取修复补丁。",{"_93":183},"2026-11-27T00:00:00.000Z","2026-11-27T14:52:21.367Z","vuln",[180,181,182],46,"漏洞","补丁","漏洞管理","CERT-FR","gjq7vmcqkrkguyg5bk5ooqo1k","IBM 多项产品漏洞汇总：涵盖远程代码执行、远程 DoS 与数据机密性风险","CERT-FR 汇总 IBM 多项产品中发现的 126 个漏洞，部分可导致远程代码执行、远程拒绝服务（DoS）及数据机密性受损。相关 CVE 包括 CVE-2023-43804、CVE-2026-102554 和 CVE-2026-129270 等；原文未提供受影响版本、认证前提、CVSS 分数或在野利用信息，修复方案需查阅 IBM 安全公告。",{"_93":183},"2026-11-27T14:52:21.373Z",[180,181,88],20,"g78xeca2hnxmbiphi07v6wahe","Debian 修复 Linux 内核多项漏洞，CERT-FR 收录 140 个 CVE 条目","CERT-FR 汇总了 Debian Linux 内核的多项漏洞，共列出 CVE-2026-99272 至 CVE-2026-99797 区间内的 140 个 CVE 编号。",{"_93":183},"2026-11-27T14:52:21.382Z",[180,181,88,198,199,200],27,"内核","Debian","NVD","yza1u66v1420kn21mvz063ur5","FreeRADIUS 多个漏洞影响 3.0.29 与 3.2.11 之前版本","FreeRADIUS 3.2.x 中低于 3.2.11 的版本，以及低于 3.0.29 的版本受到多个漏洞影响。部分漏洞可导致远程任意代码执行、远程拒绝服务和数据机密性受损，另有绕过安全策略的风险；CERT-FR 未指明具体漏洞类型，修复情况需参考厂商 2026 年 11 月 25 日发布的安全公告。",{"_93":183},"2026-11-27T14:52:21.387Z",[180,181,182],63,"hhqavepufflhp9alea5gg932i","Debian LTS 汇总多项 Linux 内核漏洞修复，涉及 CVE-2026-100080 至 CVE-2026-99512","Debian LTS 发布汇总多项 Linux 内核漏洞修复，涵盖 CVE-2026-100080、CVE-2026-100081、CVE-2026-100082 等多个漏洞条目。修复信息参考 Debian LTS 安全公告 msg00053（11月21日）和 msg00069（11月27日），具体补丁需查阅厂商安全公告的 Documentation 部分。",{"_93":183},"2026-11-27T14:52:21.394Z",[181,88,198,215,199],17,"操作系统","beqjirjlmnihownig4dh62a2a","Red Hat Linux 内核多项漏洞汇总，涵盖 150 个 CVE 并提供 RHSA 补丁","Red Hat Linux 内核多项漏洞汇总列出 150 个 CVE，关联 20 份 RHSA 安全公告，其中 RHSA-2026:102168 等 8 份发布于 23 日、5 份于 24 日、2 份于 25 日、2 份于 26 日，RHSA-2026:104030 与 RHSA-2026:104044 于 27 日发布。公告建议参考厂商安全公告获取修复补丁。",{"_93":183},"2026-11-27T14:52:21.400Z",[180,181,198,223],30,"Red Hat","i0rge45u33ts69uqrhdu0clsz","Synology DSM 与 DSM Enterprise 存在多项漏洞（公告 CERTFR-2026-AVI-1630，Synology_SA_26_22）","CERT-FR 发布 CERTFR-2026-AVI-1630 通告，汇总 Synology DSM 与 DSM Enterprise 的多项漏洞，信息来源于 Synology 24 日发布的安全公告 Synology_SA_26_22。",{"_93":183},"2026-11-27T14:52:21.406Z",[180,181],23,"cp2yg0htqzvgvzapkd4uf8yne","MongoDB 多项漏洞汇总：涉及 RCE、权限提升与数据机密性损害","MongoDB 多项漏洞可导致任意代码执行、权限提升及数据机密性受损，涉及 CVE-2026-135133 等 19 个编号。MongoDB 已于 25 novembre 2026 发布 CDRIVER-6500、MONGOCRYPT-990 等安全公告，用户应查阅对应公告获取修复补丁；原文未提供受影响版本、认证前提或利用情况。",{"_93":183},"2026-11-27T14:52:21.412Z",[180,181,88],32,"sddcalerjiqd19o055yhtqv2g","SUSE 修复 Linux 内核多项漏洞，涉及 CVE-2024-28085 至 CVE-2026-99999 共 99 项","CERT-FR 于 2026 年 11 月 27 日汇总发布 SUSE Linux 内核多项漏洞修复公告，涉及 CVE-2024-28085、CVE-2025-10148、CVE-2025-11563、CVE-2025-9086 及 CVE-2026 系列的 99 个 CVE 编号。",{"_93":183},"2026-11-27T14:52:21.418Z",[180,181,198,88,245,223],24,"Ubuntu","i8swasoa7p81ff3kbk5v712g8","SPIP 4.4.32 修复远程代码执行、SSRF 等多项漏洞","CERT-FR 披露 SPIP 4.4.32 之前版本存在多项漏洞，可导致远程任意代码执行、数据机密性受损、SSRF 与 CSRF。修复方式是参考 SPIP 官方于 27 novembre 2026 发布的安全公告并更新至 4.4.32；公告未提供各漏洞编号或利用条件。",{"_93":183},"2026-11-27T14:52:21.427Z",[180,181,253],54,"漏洞分析","yubbhticb8czrw65r6fla2h4o","SolarWinds Serv-U 曝多项漏洞，涉及远程代码执行、提权与拒绝服务","CERT-FR 汇总披露 SolarWinds Serv-U 多项漏洞，部分可导致远程代码执行、权限提升和远程拒绝服务。",{"_93":183},"2026-11-27T14:52:21.436Z",[180,181,260,118],"网络设备","iumzubpojln46gurdf3hve36s","美国空军 Cloud One 云平台据报遭入侵，攻击范围与数据失窃情况未知","美国空军 Cloud One 云计算平台据报遭黑客入侵，攻击者利用尚未确定的软件漏洞获得访问权限，并可能接触军事行动及后勤敏感信息；平台升级期间发现入侵，应用迁移和软件更新因此中断。",{"_93":271},"2026-11-27T15:09:40.000Z","2026-11-27T15:37:20.199Z",[103,269,142,120,118,152,270],68,"在野利用","CrowdStrike","BleepingComputer","pmq9n1nyhpebkqigde9uh4uz3","防火墙无法消除未管理 VM 的风险：VMware 迁移后的基础设施可管理性分析","未纳管的 VM、权限、隔离和生命周期缺失会形成隐藏攻击入口，即使防火墙、EDR 和网络分段有效，也可能危及整个环境。Broadcom 许可政策推动企业从 VMware 迁移至 Proxmox VE、OpenStack 等方案时，还需整合 RBAC、资源核算、审计、自动化及物理资产管理；ISPsystem 以 VMmanager、DCImanager 和 BILLmanager 构建统一管理平台。",{"_93":271},"2026-11-27T15:00:10.000Z","2026-11-27T15:37:20.208Z","blue-team",[281,282,283,182,105,284],15,"工具发布","蓝队","加固","VMware","z2zj9401f06ahawl7tw5lolqc","G.O.S.S.I.P 阅读推荐：RSA 还安全吗，Google 与 KeyBreak 团队整数分解复杂度进展对比","本条为阅读推荐汇编，围绕 RSA 依赖的大整数分解问题梳理两项工作：Google Research 团队在 GitHub 上传论文，借助 Gemini 4 框架给出整数分解复杂度 L[1/3, 105] 的严格证明，打破 1992 年 Lenstra 与 Pomerance 的 L[1/2] 上界纪录，但常数因子过大，实用性被抵消。",{"_93":301},"2026-11-26T16:17:00.000Z","2026-11-27T16:07:22.477Z","disclosure",[294,295,296,297,298,299,300],57,"技术研究","论文","加密","AI 安全","大模型","Google","腾讯","安全研究GoSSIP","wuwxqwmjofamcgppwkw7wuf5s","美国空军 Cloud One 云平台遭入侵，攻击范围与数据失窃情况不明","美国空军主要云计算平台 Cloud One 遭黑客入侵，攻击者身份、受影响范围及数据是否被窃取尚未确认。该事件约在 1 个月前升级平台时被发现，导致服务中断、应用更新被阻止，后台应用迁移至 Cloud One 的工作暂停，部分用户管理员权限被撤销。","报道梳理了Cloud One入侵后的服务中断、迁移暂停与权限处置，并指出控制平面可能被利用，为评估军事云平台事件影响提供事实依据。",{"_93":121},"2026-11-27T15:03:05.000Z","2026-11-27T16:09:30.050Z",[103,142,105,118,312,152,313,299],79,true,"AWS","Oracle","t6uwzah42cn6jaqs5uqqpomuj","Cacti 远程代码执行漏洞 4http2shell 曝光，CVSS 9.8，PoC 已公开","Cacti 远程代码执行漏洞（4http2shell，又称 4HTTP2ROOT）细节与 PoC 已公开，CVSS 评分 9.8。",{"_93":324},"2026-11-27T10:35:00.000Z","2026-11-27T17:02:38.517Z",[180,322,323,253,269],65,"复现","漏洞利用","绿盟科技CERT","zwjve25gs08dp015hf5g6wdp8","Linux内核NFS越界写入漏洞CVE-2026-99362公开，CVSS 9.8","Linux内核NFS越界写入漏洞CVE-2026-99362的细节已公开，CVSS评分为9.8，未经身份验证的攻击者可向默认TCP 2049端口发送特制COMPOUND请求，造成堆越界写入、内存损坏、信息泄露或系统崩溃，特定条件下可实现远程代码执行。",{"_93":324},"2026-11-27T17:02:38.571Z",[180,181,253,198,118,223,199,245],69,"emxtvs4jso1up4wm8nw6pcp6o","疑似越南关联黑客组织 WeaveLotus 借漏洞和弱口令攻击东南亚","SOCRadar 披露，疑似越南关联组织 WeaveLotus 于 2026 年 8 月至 9 月实施 RedOps 间谍活动，针对菲律宾、泰国和印度尼西亚的军方、政府及立法机构收集南海防务与军事协议情报。","文章拆解了针对东南亚目标的入侵链，并给出具体漏洞、持久化方式和外传数据量，便于对照排查暴露服务与异常访问。",{"_93":153},"2026-11-27T16:36:11.000Z","2026-11-27T17:02:40.965Z",[103,142,119,323,118,341,342,343,344],75,"Palo Alto","Ivanti","Cisco","Fortinet","hhd0vsy1up2wukos9c1vxsi16","Matters.AI 完成印度最大网络安全 Pre-Series A 轮融资，以 AI 应对数据风险","安全初创公司 Matters.AI 完成印度规模最大的网络安全 Pre-Series A 轮融资，将四款传统安全工具整合为自主平台。该平台利用具备上下文感知能力的 AI，追踪敏感数据血缘、分析用户意图，并自动处置企业环境中的威胁。",{"_93":355},"2026-11-27T15:27:20.000Z","2026-11-27T17:10:26.648Z","policy",[353,354],"其他","行业动态","Dark Reading","j158oejps5agmlpskimxzu5ra","Cacti 零日漏洞公开 PoC，未认证攻击者可远程执行命令","Cacti 网络监控平台曝出零日漏洞，公开 PoC 可通过 4 个 HTTP 请求在未认证条件下触发命令执行。研究人员测试了 Cacti Core 1.2.31，更早版本是否受影响尚不清楚；攻击要求启用 guest 账户，但不需要有效凭据。",{"_93":271},"2026-11-27T17:06:13.000Z","2026-11-27T17:39:20.819Z",[180,322,323,269,260,253],"x2s4jv9u69u3d1vpmgq1f9ozp","pCloud Pass 密码管理器遭网络攻击，部分用户邮箱暴露并出现登录尝试","pCloud 确认其密码管理器 pCloud Pass 遭网络攻击，少量用户邮箱地址被暴露并出现登录尝试，攻击已被迅速控制，云存储服务未受影响。",{"_93":271},"2026-11-27T19:26:04.000Z","2026-11-27T19:41:20.525Z",[103,142,119,370],"身份与访问","dd0mowlai9kq6bzrbot0jgdij","Boston Scientific 遭 vishing 攻击，117,789 人个人信息与医疗数据泄露","医疗科技厂商 Boston Scientific 因语音钓鱼（vishing）攻击导致云端应用和云托管数据泄露，影响美国多个州 117,789 人，暴露内容包括姓名、住址、SSN、政府签发证件编号、医疗与健康保险信息及出生日期。",{"_93":271},"2026-11-27T18:57:42.000Z","2026-11-27T19:41:20.532Z",[103,142,379,105],60,"钓鱼","d4a3n74pevzixgfs5t9iqhhv7","ChromeOS LTS-150 150.0.7871.290 推送多项安全修复","Google ChromeOS 面向多数设备推送 LTS-150 版本 150.0.7871.290，Platform Version 为 16700.71.0。",{"_93":390},"2026-11-27T18:52:47.009Z","2026-11-27T20:13:29.185Z",[181,388,389,299],49,"浏览器","版本更新","Chrome Releases","w9wmwpnyzzebm7nsojs6aeo19","CISA 将 OSGeo GeoServer 与 Drupal Core 的 3 个在野利用漏洞纳入 KEV Catalog","CISA 基于真实利用证据，将 OSGeo GeoServer 的 XML 注入漏洞 CVE-2026-120705、授权不当漏洞 CVE-2026-129243，以及 Drupal Core 异常或特殊状况检查不当漏洞 CVE-2026-136716 纳入 KEV Catalog。",{"_93":400},"2026-11-27T12:00:00.000Z","2026-11-27T21:14:24.643Z",[269,180,182,283,399],66,"CISA","CISA 安全公告","fvrqffd9ourqoe70wou50cp6c","意大利伪造政府应用利用 Morpheus 间谍软件监控寻求庇护者","IrpiMedia 调查称，意大利内政部标识的 Android 应用 FirmaDigitale 伪装成庇护者保护状态通知，实际投递 Morpheus 间谍软件。","调查将伪装政府应用与 Morpheus 间谍软件关联起来，并披露意大利监控工具供应商、授权范围和审查薄弱等背景。",{"_93":121},"2026-11-28T00:08:30.000Z","2026-11-28T01:17:29.714Z",[103,130,151,90,131,379],70,"xtrl4d8cdbed9m7hkb13dh8p9","奇安信 CERT 安全热点周报：Drupal Fail2Install 严重 RCE 漏洞面临活跃利用","奇安信 CERT 周报汇总 Drupal Fail2Install 漏洞在野利用及多项漏洞风险。",{"_93":418},"2026-11-27T09:24:00.000Z","2026-11-28T17:26:38.865Z",[88,269,323,103,142,120],26,"奇安信 CERT","sq959gxd7blu324wq7irv97yz","Cacti 未授权远程代码执行漏洞 QVD-2026-117631 已复现，CVSS 3.1 9.8","Cacti 未授权远程代码执行漏洞 QVD-2026-117631 可由未认证攻击者通过少量 HTTP 请求执行任意命令，影响量为万级，CVSS 3.1 分数为 9.8，奇安信评级高危。","文章给出了完整利用链、利用前提和资产测绘数据，可用于判断暴露范围并落实补丁前缓解措施。",{"_93":418},"2026-11-28T17:26:38.876Z",[180,322,323,426,92],"利用链","dyptsbmy64mx1hthlvjew6rl1","pCloud Pass 遭网络攻击，部分用户邮箱暴露并出现登录尝试","pCloud Pass 遭网络攻击，部分用户邮箱地址被暴露并出现登录尝试，但 pCloud 表示事件已及时遏制，密码、笔记等数据仍受加密保护，pCloud Cloud Storage 未受影响。",{"_93":153},"2026-11-28T08:08:11.000Z","2026-11-28T17:26:40.550Z",[103,142,119,379,118],"cipx3v86bmecxr6fovabykqit","Booba 勒索软件从美国水处理厂蔓延至地方政府网络","Booba 勒索软件在 11 月从美国东海岸一座水处理厂蔓延至监管该厂的地方政府网络。ThreatDown 仅监控地方政府系统，随后隔离 40 台工作站和 8 台服务器，保护 45 台设备，但已有 3 台被加密；攻击由未安装其软件的另一台计算机发起。",{"_93":121},"2026-11-28T10:51:27.000Z","2026-11-28T19:30:38.193Z",[103,89,130,141,441,442,399],"检测工程","工控","a3qinevddrodxn0pt9a1gi27v","Ubuntu 更新 Apache HTTP Server 漏洞并修复重定向 Cookie 回归问题","Ubuntu 发布 Apache HTTP Server 安全更新，修复 CVE-2026-46729、CVE-2026-47360、CVE-2026-48005、CVE-2026-56153、CVE-2026-56449、CVE-2026-56154、CVE-2026-57941、CVE-2026-59797、CVE-2026-58415、CVE-2026-63045、CVE-2026-63292、CVE-2026-63686、CVE-2026-63718、CVE-2026-73636、CVE-2026-73637、CVE-2026-79768 和 CVE-2026-93546，涉及拒绝服务、任意代码执行、敏感信息泄露、认证绕过及 HTTP 响应走私等风险。受影响版本覆盖 Ubuntu 14.04 LTS、16.04 LTS、18.04 LTS、20.04 LTS、22.04 LTS、24.04 LTS、26.04 LTS 和 26.10，部分漏洞仅影响 Ubuntu 26.10。USN-9016-1 的上游修复还引入在特定情况下阻止重定向设置 Cookie 的回归问题，本次更新一并修复。","公告汇总 Apache HTTP Server 多项漏洞及各自影响范围，并说明上游修复引入的重定向 Cookie 回归问题。",{"_93":452},"2026-11-26T22:34:55.000Z","2026-11-28T20:26:35.816Z",[181,180,245],76,"Ubuntu 安全公告","skgo8xzuovrbxo6vigs2f589d","Q-Dir 和 DesktopOK 官方安装包遭篡改，投放 Python RAT","Q-Dir 和 DesktopOK 的官方 SoftwareOK 分发渠道遭篡改，恶意安装包内含 Python RAT，影响新下载和既有安装更新；受影响的版本包括 Q-Dir 12.83.0.0、12.84.0.0、12.85.0.0，以及 DesktopOK 12.82.0.0、12.85.0.0，但并非所有版本均被感染。",{"_93":271},"2026-11-28T15:32:49.000Z","2026-11-28T23:32:36.497Z",[103,130,118,151,152],"vbaafprbxljgldft3nhf7mkil","PRISM 2027 攻击溯源与智能安全推理研讨会征稿通知，2027年1月8日截稿","PRISM 2027（攻击溯源与智能安全推理研讨会）将于2027年3月22日在韩国首尔 Grand InterContinental Seoul Parnas 酒店举办，与 NDSS 2027 同期，接收正式论文、Work-in-Progress 论文及 Tutorial/Demo 投稿。",{"_93":301},"2026-11-28T01:30:00.000Z","2026-11-28T23:33:36.822Z",[468,469,297,470,298],6,"标准","治理","Agent 安全","all","tag","q","tab","time",{"_477":478,"_479":-5},"changelogVersion","2026-10-01T08:00","release"]
