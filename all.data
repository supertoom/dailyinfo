,"_79":230,"_81":231,"_83":84,"_85":86,"_87":-5},{"_64":213,"_66":214,"_68":215,"_70":-5,"_71":216,"_73":217,"_75":218,"_77":129,"_79":219,"_81":220,"_83":84,"_85":86,"_87":-5},{"_64":202,"_66":203,"_68":204,"_70":205,"_71":206,"_73":207,"_75":208,"_77":98,"_79":209,"_81":210,"_83":144,"_85":86,"_87":-5},{"_64":189,"_66":190,"_68":191,"_70":192,"_71":193,"_73":194,"_75":195,"_77":98,"_79":196,"_81":197,"_83":144,"_85":86,"_87":-5},{"_64":174,"_66":175,"_68":176,"_70":177,"_71":178,"_73":179,"_75":180,"_77":181,"_79":182,"_81":183,"_83":144,"_85":86,"_87":-5},{"_64":163,"_66":164,"_68":165,"_70":166,"_71":167,"_73":168,"_75":169,"_77":156,"_79":170,"_81":171,"_83":144,"_85":86,"_87":-5},{"_64":150,"_66":151,"_68":152,"_70":-5,"_71":153,"_73":154,"_75":155,"_77":156,"_79":157,"_81":158,"_83":84,"_85":86,"_87":-5},{"_64":136,"_66":137,"_68":138,"_70":139,"_71":140,"_73":141,"_75":142,"_77":98,"_79":143,"_81":120,"_83":144,"_85":86,"_87":-5},{"_64":123,"_66":124,"_68":125,"_70":-5,"_71":126,"_73":127,"_75":128,"_77":129,"_79":130,"_81":100,"_83":84,"_85":86,"_87":-5},{"_64":114,"_66":115,"_68":116,"_70":-5,"_71":117,"_73":108,"_75":118,"_77":98,"_79":119,"_81":120,"_83":84,"_85":86,"_87":-5},{"_64":104,"_66":105,"_68":106,"_70":-5,"_71":107,"_73":108,"_75":109,"_77":98,"_79":110,"_81":111,"_83":84,"_85":86,"_87":-5},{"_64":92,"_66":93,"_68":94,"_70":-5,"_71":95,"_73":96,"_75":97,"_77":98,"_79":99,"_81":100,"_83":84,"_85":86,"_87":-5},{"_64":65,"_66":67,"_68":69,"_70":-5,"_71":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":86,"_87":-5},"id","kcmcietltjr01989gb3n4ww1d","title","中国网络安全产业联盟发布《中国网络安全产业分析报告（2026年）》","summary","中国网络安全产业联盟（CCIA）连续第九年发布《中国网络安全产业分析报告（2026年）》，基于我国网络安全企业调研数据，分析产业供需、市场、法律法规、资本市场、发展热点与趋势，并研判人工智能对网络安全产业的影响。报告面向网络安全主管部门、监管机构、从业人员、行业组织和研究机构。","reason","source",{"_90":91},"publishedAt","2026-11-26T04:41:28.910Z","timelineAt","2026-11-26T10:41:28.922Z","category","policy","tags",[88,89],"score",8,"selected",false,"channel","news","x","行业动态","汇总","name","安全内参","xr13yfjgr44whlnt8um2wwv3h","FinCEN遭网络入侵，部分系统下线并延长金融机构报告期限","美国财政部金融犯罪执法网络（FinCEN）遭遇网络入侵，有限系统被未授权访问，机构已将部分系统下线。11月24日发布的临时命令将11月18日至12月29日期间到期的报告和更新期限延至12月30日，BSA E-Filing网站仍在线，但部分服务可能暂时不可用。FinCEN尚未披露攻击者身份、被访问的具体系统及数据范围。",{"_90":103},"2026-11-26T11:05:01.000Z","2026-11-26T11:17:19.074Z","activity",[101,102],67,"攻击活动","数据泄露","Help Net Security","vzbpyckuf134yxuczry3aivgy","香港城市售票网遭黑客入侵，约130万用户资料外泄","香港城市售票网遭黑客非法进入，约130万名使用者的姓名或名称、电话号码及电邮地址等个人资料可能外泄。康文署接获外判承办商通报后报警，并向保安局、数字政策办公室及个人资料私隐专员公署通报；系统未登记身份证明文件资料，信用卡资料已被遮蔽。承办商已检视系统并加强保护，个人资料私隐专员公署已展开调查并提醒相关机构尽快通知受影响人士。",{"_90":91},"2026-11-26T09:55:00.000Z","2026-11-26T11:34:22.544Z",[101,102,112,113],68,"数据窃取","安全运营","b66webn0sefvuhe9z7smcv596","ARTEX渗透测试智能体入侵CIA开源情报系统并波及ODNI","身份不明的攻击者使用AI驱动的ARTEX渗透测试框架入侵CIA非密开源情报（OSINT）分析系统，并波及ODNI和美国国家地理空间情报局；原文称未涉及机密网络、机密信息或其他系统，未导致机密数据或系统泄露。",{"_90":91},"2026-11-26T11:34:22.573Z",[101,121,112,122],70,"AI 攻防","CISA","sr39huxsku8r86uwxyk932u92","TgWitness 案例揭示 QES 签名的 GDPR 导出仍可能泄露 905,672 个字符","TgWitness 项目披露的一份 830 页 GDPR 导出案例显示，文件虽带有合格电子签名且 SHA-256 摘要匹配，但 1,044 个黑色矩形下的 905,672 个字符仍可被提取，其中包含 1,800 余名无关第三方用户的登录名和投诉描述。",{"_90":135},"2026-11-26T10:46:47.000Z","2026-11-26T11:39:25.099Z","disclosure",[131,132,133,134],"漏洞分析","技术研究","加密","合规","Hackread","wcbx8pzdh8mopdy9bq9yswr42","Microsoft 与 CSA 披露 ARTEX AI 攻击框架已被多组攻击者采用","Microsoft 与 CSA 报告称，中国及朝鲜关联攻击组织已将开源 AI 自主渗透测试框架 ARTEX 用于网络侦察、凭据攻击和 Web 应用利用，部分攻击链可在 3 小时内取得特权访问，Infrawatch 则发现野外存在 130 多个变种。","文章汇总多方对 ARTEX 框架的观测，说明其自动化攻击链与规避检测能力，并列出可供防守方落实的资产、身份和出站控制措施。",{"_90":149},"2026-11-26T11:05:00.000Z","2026-11-26T11:41:23.732Z",[101,121,145,146,147,148],true,"恶意软件","供应链投毒","Agent 安全","Microsoft","Infosecurity Magazine","v0f4ebix4h8di2eaa497yb75d","美军 ATO 持续鉴定工程解剖：从三年一签快照到 cATO 与 AI 鉴定空白","这篇分析指出美国国防部运行授权（ATO）三年一签、软件约三周更新一次的制度性错位，指出 2022 年 2 月首席信息官备忘录提出持续运行授权（cATO）并确立 3 根支柱：持续监测、主动网络防御、安全内建的软件供应链。",{"_90":91},"2026-11-25T22:42:31.770Z","2026-11-26T11:42:31.816Z","ai-security",[159,160,161,132,162,134],56,"AI 安全","模型安全","治理","标准","xxw8h23ag2c76hyuqa5gblkin","同一 vLLM 推理服务器中的模型可经侧信道通信并绕过不可信监控","研究证明，运行在同一 vLLM 推理服务器上的模型即使无法直接交互，也能利用 GPU 内核选择造成的激活值舍入差异建立 Step Sizing 与 KV Cache Message Board 两种通信信道。","研究揭示了同一推理服务器中的模型可借内核舍入差异和共享 KV cache 建立侧信道通信，并验证其对不可信监控协议的绕过效果。",{"_90":91},"2026-11-25T15:42:31.770Z","2026-11-26T11:42:31.832Z",[159,132,172,147,160,173],71,"大模型","AI 供应链","zptj6mohcgm2b6eayxup65amy","Drupal 安装程序远程代码执行漏洞 CVE-2026-132165 已被在野利用","奇安信 CERT 监测到 Drupal 安装程序远程代码执行漏洞 CVE-2026-132165 已被在野利用，该漏洞源于 Drupal core 安装器状态校验不当，攻击者可匿名续跑 /core/install.php 流程，覆盖 uid 1 管理员账户的用户名、邮箱和密码，接管站点并借已有模块、主题或文件写入入口执行任意命令。","原文给出受影响版本区间、匿名利用前提、官方补丁版本与在野资产数量，读者可据此判断自身 Drupal 站点是否需要立刻处置。",{"_90":91},"2026-11-24T16:00:00.000Z","2026-11-26T11:42:31.879Z","vuln",[184,185,186,187,188],84,"漏洞","在野利用","复现","补丁","奇安信","g2obwrf736za9vvdn0fst3ayg","SYS010 信息窃取木马借 Meta 广告强制安装浏览器扩展窃取 Gmail 与 Outlook 邮件","Bitdefender Labs 披露 SYS010 信息窃取木马通过 Meta 广告伪装成免费动态壁纸应用下载，诱导 Windows 用户安装后强制为 Chrome、Edge 和 Firefox 配置恶意扩展，目标是 Facebook 与 Meta 商业账户及 Gmail、Outlook 邮件。","文章拆解了 SYS010 从 Meta 广告投放到强制安装浏览器扩展的完整链路，并明确说明服务器请求量不能代表已确认感染。",{"_90":201},"2026-11-26T11:50:17.000Z","2026-11-26T12:19:19.158Z",[101,145,112,198,146,199,200],74,"浏览器","Google","Mozilla","BleepingComputer","kcwxcgi3mbarz9m115ch1kn3v","Mitel MiCollab 5 个零日漏洞遭在野利用，CISA 已将其纳入 KEV","Mitel MiCollab 5 个漏洞已被用于数据窃取和可能的勒索活动，CISA 将其纳入 KEV，其中 4 个要求联邦机构在 11 月 28 日前处置，另 1 个截止日期为 12 月 9 日。","文章还原了攻击者从 MiCollab 漏洞入侵到身份基础设施的完整路径，并给出补丁时间线与处置期限。",{"_90":212},"2026-11-26T11:35:25.000Z","2026-11-26T12:23:19.187Z",[185,211,101,121,122],85,"漏洞利用","SecurityWeek","z45bgqa5kzmc6rcbca4x0g417","DOMDIFFER 以 DOM 镜像绕过安全控制，突破率连续居首","DOMDIFFER 是针对企业 Google 和 Microsoft 账号的 AiTM 钓鱼工具包，凭 DOM 镜像在 2026 年 8 月至 10 月连续以突破率居首，每月突破次数为次高工具包的 2-4 倍。",{"_90":223},"2026-11-26T10:57:55.000Z","2026-11-26T12:35:24.576Z",[132,221,222,148,199,198],41,"钓鱼","利用链","The Hacker News","ybj399rmg1ndjx2vd4hbgf9r9","Yandex 推出持续录制对话的 AI 可穿戴设备，记录内容或直接提供给俄罗斯政府","Yandex 推出持续录制对话的 AI 可穿戴设备，相关对话可能直接提供给俄罗斯政府。原文未说明设备型号、录制范围、数据传输机制、用户同意要求及实际部署规模。",{"_90":232},"2026-11-26T12:04:33.000Z","2026-11-26T12:39:19.663Z",[159,199],30,"Cybernews","lamuyprjyqnjd14l5bmo6yq7l","Linux 用户破解 PS1 游戏《灵梦先生的 UFO 影像》谜题，挑战源于播客节目","一档播客节目发起挑战后，一名 Linux 用户通过数字考古破解了 PS1 游戏《灵梦先生的 UFO 影像》中“灵梦先生藏有 NASA UFO 影像”的谜题。",{"_90":232},"2026-11-26T11:36:00.000Z","2026-11-26T12:39:19.673Z",[241],2,"其他","bwfkrucdij01s06054e76dg85","用户指控 Google 试图让 Android 更像 iOS","用户指控 Google 正试图让 Android 更像 iOS，并以“一个月是否足以说服 Google 改变想法”为切入点提出质疑。原文仅给出这一简短观点，未说明具体产品变化、涉及版本、厂商回应或可核验的技术事实。",{"_90":232},"2026-11-26T11:28:28.000Z","2026-11-26T12:39:19.682Z",[241,199,250],7,"Apple","nn1df6kue93w1afswhivjvdl3","攻击者利用 Hugging Face AI 网站生成器搭建 42 个钓鱼页面","Aikido Security 发现攻击者在 Hugging Face Spaces 托管 42 个钓鱼与凭据窃取页面，其中 29 个由平台内置的 AI 网站生成器 DeepSite 构建，仿冒 28 个品牌，包括 Microsoft、PayPal 和 Netflix。","原文揭示了攻击者如何借 AI 网站生成器批量搭建仿冒页面，并给出可用于排查访问与账号处置的日志方向。",{"_90":149},"2026-11-26T12:30:00.000Z","2026-11-26T12:42:24.704Z",[101,221,112,121,260,148],73,"凭据","phoouvsged0ufiamfxx0ozhx8","澳大利亚 Flight Centre 第三方预订系统遭入侵，客户记录与护照信息泄露","澳大利亚 Flight Centre Travel Group 正调查第三方住宿预订系统遭入侵事件，Flight Centre、Travel Associates、Cruiseabout 及部分独立代理商使用该系统，航班预订和商务旅行预订未受影响。",{"_90":269},"2026-11-26T11:51:11.000Z","2026-11-26T12:42:30.792Z",[102,221],64,"Security Affairs","en1gv0ci3e610k5ce0nrbau25","Kaspersky 发现 Keenadu 后门预装于超过 220,000 台 Android 设备","Kaspersky 在前 10 个月内于超过 220,000 台 Android 设备中发现 Keenadu；它与 Triada 合计出现在今年检出预装恶意软件设备的 88% 中。","文章拆解了预装恶意软件的供应链入侵路径、潜伏与模块化机制，并提供企业采购前的样本测试建议。",{"_90":103},"2026-11-26T12:57:58.000Z","2026-11-26T12:59:19.480Z",[145,279,146,280,281,112],75,"后门","移动端","Kaspersky","a5fzo7vwm6srlhz65h7wxvfw8","Juniper Session Smart Conductor 严重漏洞 CVE-2026-103406 已被利用","Juniper Networks 与 CISA 确认，CVE-2026-103406 已在攻击中被利用，CVSS 9.8。该远程 OS 命令注入漏洞影响 Session Smart Conductor 的 AutomatedProvisionor 服务，攻击者可通过特制 Salt minion ID 以 root 权限执行任意命令。","原文明确披露漏洞已遭利用，并给出受影响版本、修复版本和 CISA 要求的处置时限。",{"_90":212},"2026-11-26T13:04:06.000Z","2026-11-26T13:24:20.896Z",[184,185,187,122],80,"zwm0xpn17anhlg8q9jntvqfhk","Microsoft Store 发现恶意软件，通过钓鱼诱导安装远程访问木马","Microsoft Store 中发现可提供远程访问能力的恶意软件。攻击者通过钓鱼重定向，将受害者引导至 Microsoft Store 并诱导其安装恶意软件。原文未说明具体恶意软件家族、受害规模、远程访问能力范围及 IOC。",{"_90":232},"2026-11-26T12:48:00.000Z","2026-11-26T13:24:21.079Z",[101,145,221,148],48,"k7605m2yy8b4g01z70eg5mpd0","Google Workspace 将强制 AI Agent 使用 MCP 服务器或 CLI 接入","Google Cloud 推出面向 Gmail、Google Drive、Docs、Sheets、Slides、Calendar、Chat 和 Tasks 的 Workspace MCP 服务器及 Workspace CLI，并计划从 2027 年 2 月起要求所有 Google Workspace 用户通过这两种批准方式连接 AI Agent，取代传统 REST API。",{"_90":149},"2026-11-26T13:15:00.000Z","2026-11-26T13:43:21.936Z",[159,147,172,306,307,199],"工具发布","身份与访问","waly7f5cwuea4sg732ir9h5vt","Danfoss AK-SM 8xxA Series 控制器曝栈溢出漏洞 CVE-2026-129713，CVSS 9.8","Danfoss AK-SM 8xxA Series 控制器的未认证 CGI 处理器存在栈溢出漏洞 CVE-2026-129713，CVSS 为 9.8，远程攻击者发送特制 HTTP/S POST 请求可导致内存损坏、webserver 重启，并可能以 webserver 权限执行任意代码。","该通告同时给出无认证利用条件、缺失补丁状态和可立即执行的缓解配置，适合工业制冷设备运营方评估暴露风险。",{"_90":149},"2026-11-26T14:15:00.000Z","2026-11-26T14:44:23.715Z",[184,187,185,317,122],81,"工控","ydhzotnr83i1er5iu8v76dewt","Drupal 漏洞 CVE-2026-136716 允许绕过安全策略，官方称正被利用","Drupal 存在漏洞 CVE-2026-136716，可导致安全策略被绕过，Drupal 表示该漏洞正被积极利用。受影响版本为 Drupal 11.4.x 中早于 11.4.14 的版本、11.x 中早于 11.3.23 的版本，以及早于 10.6.23 的版本。",{"_90":325},"2026-11-26T00:00:00.000Z","2026-11-26T15:34:20.760Z",[184,185,187],"CERT-FR","s2xn82i4rvevtwzkgz9w1kk2a","Tenable 产品多项漏洞汇总，涵盖 CVE-2023-48795 至 CVE-2026-97032 等条目","Tenable 安全公告 tns-2026-42 汇总了 Tenable 产品中的多项漏洞，涉及 CVE-2023-48795、CVE-2025-11187、CVE-2025-15467 至 CVE-2026-97032 等编号。公告未提供受影响版本、漏洞类型、CVSS 分数或利用状态，仅建议用户参阅厂商安全公告的 Documentation 部分获取补丁。",{"_90":325},"2026-11-26T15:34:20.766Z",[184,187,89,333,334],14,"Tenable","CERT/CC","cn4e57ofzoconrxdtkuuxer92","NetApp 多项产品漏洞汇总，关联 4 份安全公告","CERT-FR 汇总 NetApp 产品的多项漏洞，引用 2026 年 11 月 25 日发布的 4 份安全公告：NTAP-20220303-0003、NTAP-20250605-0010、NTAP-20250725-0005 和 NTAP-20250801-0006。",{"_90":325},"2026-11-26T15:34:20.771Z",[184,187,89],21,"j7u1cp7w53suadfnz909v5mhh","CERT-FR 通报 Mattermost Server 漏洞（MMSA-2026-00794）","CERT-FR 通报 Mattermost Server 存在一项安全漏洞，但厂商未说明风险及具体影响。受影响版本包括 2.47.x 中早于 2.47 Mobile.0 的版本，以及早于 2.46.1 Mobile 的版本；CERT-FR 建议查阅厂商于 25 novembre 2026 发布的安全公告 MMSA-2026-00794 获取补丁。",{"_90":325},"2026-11-26T15:34:20.776Z",[184,187],31,"ngkl7c9338q0otr0cnvz3xbij","CERT-FR 通告 GitLab 多个漏洞，涉及 RCE、远程拒绝服务与数据机密性受损","CERT-FR 于 2026 年 11 月 26 日发布通告，称在 GitLab 中发现多个漏洞，部分可导致远程任意代码执行、远程拒绝服务以及数据机密性受损。通告未列出具体 CVE 编号、受影响版本与评分，仅指明修复方式为参考厂商安全公告获取补丁。",{"_90":325},"2026-11-26T15:34:20.781Z",[184,187,356],46,"漏洞管理","mi1wg6kg76binnainya6fjx4c","Veeam 多项产品存在远程代码执行漏洞，涉及 5 个 CVE","CERT-FR 通报 Veeam 多项产品存在可导致远程代码执行（RCE）的漏洞，涉及 CVE-2026-113425、CVE-2026-121810、CVE-2026-123007、CVE-2026-123633 和 CVE-2026-123634。",{"_90":325},"2026-11-26T15:34:20.786Z",[184,187,364,365,199,148],51,"供应链","AWS","xy1c2iivgjtvm5lrbzpdmud5k","HPE Aruba Networking Airwave 曝出多处可导致 RCE、提权和远程拒绝服务的漏洞","CERT-FR 通报 HPE Aruba Networking Airwave 中存在多处漏洞，部分可导致远程任意代码执行（RCE）、权限提升和远程拒绝服务。文章未提供具体漏洞编号、受影响版本、CVSS 分数或利用前提，并建议参考厂商安全公告获取相应修复补丁。",{"_90":325},"2026-11-26T15:34:20.792Z",[184,187],"m5ausxhtut34kmi7zcnx0ncei","North Korea关联PolinRider污染超7,600个GitHub仓库传播恶意软件","North Korea关联的PolinRider活动通过劫持开发者账户、提交恶意Pull Request和重写Git历史，向至少7,609个GitHub仓库植入Python加载器，涉及2,330个账户；2026年10月27日至11月6日间已推送至2,040个仓库。","文章还原了PolinRider借助GitHub仓库传播恶意载荷的多条路径，并给出受影响仓库、账户和时间范围，便于识别开发环境供应链风险。",{"_90":223},"2026-11-26T15:13:41.000Z","2026-11-26T15:38:27.030Z",[101,145,146,279,260,364,199,380],"Palo Alto","heobhyr0sh9xr8eu8p6u2x0bn","MalwareMustDie 分析 Linux/EasyShell Rust RAT 与 LoongArch 载荷","MalwareMustDie 逆向分析了 EasyShell Rust RAT，其通过 hxxps://192[.]3.31[.]148:8443 分发载荷并以 TCP 8443 接收信标通信，支持 Linux、macOS 及 LoongArch64。",{"_90":269},"2026-11-26T14:42:59.000Z","2026-11-26T15:45:29.666Z",[101,145,389,279,132,390],55,"逆向","红队","m669pm2u2g8frr1vfza5x3h0e","Remus 窃取器借虚假 Google Sheets Chrome 扩展窃取 Gmail 邮件","GenDigital 与 Invoke RE 逆向发现，Remus 窃取器所谓 Gmail 零日漏洞实际由恶意 Chrome 扩展实现，并无技术证据证明零日漏洞被利用。",{"_90":201},"2026-11-26T15:23:28.000Z","2026-11-26T16:19:19.237Z",[145,112,389,198,199],65,"j2m3d42a8fp6p1wtfkbf047ok","Recorded Future 解析战略威胁情报的定义、来源与需求方式","Recorded Future 将战略威胁情报定位为面向高管和董事会的非技术、风险导向型情报，用于评估业务决策及组织威胁态势。其主要来源为 OSINT，因信息量大且常含外语，手工收集难度较高，合适工具可批量检索、实时识别并自动翻译。组织宜提出关于风险趋势与可能影响的问题，而非要求预测具体攻击者、地点和方式。",{"_90":408},"2026-11-26T16:44:20.808Z","blue-team",[407,113,134],11,"蓝队","Recorded Future","tt1wjb8spiq1nnw8oj598sse8","GoodGuys 钓鱼活动伪装 Google、Nvidia 等品牌，窃取企业账号凭据","Push Security 发现名为 GoodGuys 的持续钓鱼活动，自 October 13 起追踪，冒充 Accenture、Google Cloud、Nvidia、SpaceX、Spotify 等 8 家公司，以最高 $600 的付费专家访谈或网络研讨会邀请诱导受害者登录。",{"_90":201},"2026-11-26T17:15:27.000Z","2026-11-26T17:19:19.606Z",[101,221,112,260,416,199,380,148],"AI 编码","acofbu8yovtquaaf0oilrxsz8","FIFA 确认遭到网络攻击，个人及业务信息遭访问","FIFA 确认遭到网络攻击，黑客获取了其所称“有限范围的个人和业务信息”，但未说明攻击发生时间及所涉信息的具体性质。上周，自称 Handsome Boy Hacking Club 的组织在 X 发布声称属于 FIFA 的文件截图，3 天后又回应称超过 12 GB 的内部文档已被泄露；FIFA 正与执法机构等主管机关合作，并强烈谴责非法获取和公布信息的行为。",{"_90":212},"2026-11-26T17:06:55.000Z","2026-11-26T17:28:19.603Z",[101,102,112],52,"ezziepbuq0itfxhnntdri5mbl","Drupal 远程代码执行漏洞 CVE-2026-132165 已发现在野利用","Drupal 远程代码执行漏洞 CVE-2026-132165 的 CVSS 评分为 8.1，漏洞细节与 PoC 已公开，并已发现在野利用。未经身份验证的攻击者可访问 core/install.php 重新安装 Drupal，进而替换管理员账户接管站点或实现远程代码执行。","漏洞细节与 PoC 已公开且出现真实利用，文章同时列出受影响版本、检测方法和升级路径，便于站点管理员快速判断并处置。",{"_90":435},"2026-11-26T10:33:00.000Z","2026-11-26T17:40:25.198Z",[184,185,187,186,434],82,"PHP","绿盟科技CERT","f4f1yl6fzetymavyvjtzkgf4a","Facebook 假壁纸广告传播 SYS010 恶意软件窃取 Meta 业务账户与邮箱数据","Bitdefender 发现攻击者通过 Facebook 广告冒充 Wallpaper Engine 和 Live Wallpapers，以 ZIP 文件分发针对 Windows 的 SYS010 信息窃取恶意软件。",{"_90":135},"2026-11-26T17:09:09.000Z","2026-11-26T17:45:25.117Z",[101,145,112,221,198,199,148],66,"gtfwjb08iqnruaa0s743exjls","ThreatsDay 周报汇总：1000 万个 NGINX 服务暴露风险、250+ 恶意扩展、AI 服务器劫持等 20 条安全事件","The Hacker News ThreatsDay 汇总本周 20 条安全事件：Todoist 称 11 月 23 日攻击者用被盗凭据入侵其生产系统，影响 6% 用户。",{"_90":223},"2026-11-26T19:39:57.000Z","2026-11-26T20:43:25.665Z",[89,101,145,452,102,121],13,"勒索","xwaatm5iexkiy0ldwue30gnrr","Drupal 修复已在野利用的严重漏洞 CVE-2026-136716","Drupal 确认严重漏洞 CVE-2026-136716 已被在野利用，攻击者可借此接管网站。该漏洞源于对异常或不完整安装状态处理不当，与此前修复的 CVE-2026-132165（Fail2Install）相关，SA-CORE-2026-017 的补丁未能覆盖所有易受攻击的安装场景，受影响的是 install.php 仍可远程访问的网站。",{"_90":269},"2026-11-26T19:45:57.000Z","2026-11-26T20:50:27.760Z",[184,185,187,122],"sameEvent",{"_64":462,"_66":463},"edycapt0khpdxw9pdgw91bldq","Drupal 安装器补丁遗漏导致 CVE-2026-136716 已被在野利用","c7r1etgzd3qdcbtx8psdsoseq","CS2 玩家需警惕虚假机器人交易、钓鱼投票与交易撤销骗局","CS2 玩家面临虚假机器人交易、伪造投票登录页和交易撤销骗局，攻击者可窃取 Steam 账户、皮肤或外部付款。玩家应通过 Steam 应用核对每笔交易，避免点击聊天链接或在 Steam 外付款，并定期检查 Steam API key、启用 Steam Guard。",{"_90":135},"2026-11-26T20:48:54.000Z","2026-11-26T21:49:24.430Z",[407,221,260,307,198],"all","tag","q","tab","time",{"_477":478,"_479":-5},"changelogVersion","2026-10-01T08:00","release"]
