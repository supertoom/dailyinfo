_80":229,"_82":83,"_84":85,"_86":-5},{"_64":210,"_66":211,"_68":212,"_70":213,"_71":214,"_73":215,"_75":216,"_77":139,"_78":217,"_80":218,"_82":99,"_84":85,"_86":-5},{"_64":195,"_66":196,"_68":197,"_70":-5,"_71":198,"_73":199,"_75":200,"_77":201,"_78":202,"_80":203,"_82":83,"_84":85,"_86":-5},{"_64":182,"_66":183,"_68":184,"_70":-5,"_71":185,"_73":186,"_75":187,"_77":96,"_78":188,"_80":189,"_82":83,"_84":85,"_86":-5},{"_64":174,"_66":175,"_68":176,"_70":-5,"_71":177,"_73":178,"_75":179,"_77":139,"_78":180,"_80":181,"_82":83,"_84":85,"_86":-5},{"_64":166,"_66":167,"_68":168,"_70":-5,"_71":169,"_73":170,"_75":171,"_77":139,"_78":172,"_80":17,"_82":83,"_84":85,"_86":-5},{"_64":157,"_66":158,"_68":159,"_70":-5,"_71":160,"_73":161,"_75":162,"_77":153,"_78":163,"_80":164,"_82":83,"_84":85,"_86":-5},{"_64":147,"_66":148,"_68":149,"_70":-5,"_71":150,"_73":151,"_75":152,"_77":153,"_78":154,"_80":155,"_82":83,"_84":85,"_86":-5},{"_64":133,"_66":134,"_68":135,"_70":-5,"_71":136,"_73":137,"_75":138,"_77":139,"_78":140,"_80":141,"_82":83,"_84":85,"_86":-5},{"_64":123,"_66":124,"_68":125,"_70":-5,"_71":126,"_73":127,"_75":128,"_77":96,"_78":129,"_80":130,"_82":83,"_84":85,"_86":-5},{"_64":110,"_66":111,"_68":112,"_70":-5,"_71":113,"_73":114,"_75":115,"_77":96,"_78":116,"_80":117,"_82":83,"_84":85,"_86":-5},{"_64":90,"_66":91,"_68":92,"_70":-5,"_71":93,"_73":94,"_75":95,"_77":96,"_78":97,"_80":98,"_82":99,"_84":85,"_86":-5,"_100":101},{"_64":65,"_66":67,"_68":69,"_70":-5,"_71":72,"_73":74,"_75":76,"_77":-5,"_78":79,"_80":81,"_82":83,"_84":85,"_86":-5},"id","q2crn96h6km6op5qe5v9oetb7","title","FAA 因“特殊情况”对全美机场发布全国性停飞指令","summary","美国联邦航空管理局（FAA）因影响全美所有 Air Route Traffic Control Centers 的通信问题，对全美机场发布全国性地面停飞指令，出发航班被要求停留在地面。FAA 技术人员正在调查，联邦官员尚未公开问题成因，也无法确认是否与网络攻击有关；抵达的国际航班将逐案处理。","reason","source",{"_88":89},"publishedAt","2026-11-13T21:33:27.000Z","timelineAt","2026-11-13T22:03:28.414Z","category","tags",[87],"score",25,"selected",false,"channel","news","x","其他","name","SecurityWeek","spesfoh8hnd6kn27vm72lu8v2","SCKit滥用ScreenConnect入侵MSP客户环境并攻击技术支持工作站","Microsoft Threat Intelligence确认，威胁者自2026年11月11日起利用托管服务商（MSP）的ScreenConnect实例，部署SCKit恶意蠕虫和未授权远程客户端，进而攻击IT支持人员工作站并扩大管理控制台权限。",{"_88":109},"2026-11-13T21:31:44.000Z","2026-11-13T22:04:27.577Z","activity",[104,105,106,107,108],75,true,"sameEvent",{"_64":102,"_66":103},"h2occksxu7q3tzi57634syb7r","SCKit 蠕虫式恶意软件借 ScreenConnect 攻击 MSP，尝试反向感染技术人员","攻击活动","恶意软件","在野利用","后门","Microsoft","Microsoft Security Blog","vw9f7bq05n0ruzl7tx1o1fwyc","美国司法部查获逾 12 亿美元并中断 North Korea FaceStealer 加密货币窃取基础设施","美国司法部针对 North Korea 的加密货币窃取行动查获 FaceStealer 社会工程基础设施，并获得法院授权扣押近期从 Binance 窃取的逾 12 亿美元加密资产，相关资产总额已达 60 亿美元。",{"_88":122},"2026-11-13T21:19:30.000Z","2026-11-13T22:05:29.393Z",[104,118,105,119,120,121],72,"数据窃取","AI 攻防","凭据","红队","Security Affairs","lkqxkc8xxi6ei2vqg5ot19n0i","ArcticRAT Android 木马扩展至完全控制设备，并用 AI 分析受害者财务信息","ArcticRAT Android 木马已从加密货币窃取扩展为完全控制设备，并新增对窃取信息的先进分析功能。攻击者据此对受害者财务状况进行画像，恶意软件功能范围与数据分析能力同步扩大。",{"_88":132},"2026-11-13T20:20:27.000Z","2026-11-13T23:06:25.132Z",[104,105,119,131],40,"移动端","Dark Reading","y0pg7kd7dn53yx1qdx27zkdk1","File Browser v2.63.15 目录尾斜杠删除可遗留公开共享","File Browser v2.63.15 存在公开共享清理缺陷，以尾部斜杠删除共享目录时会遗留旧共享记录，目录重建后新内容可经原公开 URL 被未认证访问。具备 share、download 和 delete 权限的已认证用户可触发该问题；原文提供 PoC 测试并指出需在查询共享索引前规范化路径、覆盖精确路径及其后代。漏洞已修复于 v2.63.17。",{"_88":146},"2026-11-13T23:12:06.000Z","2026-11-13T23:16:25.347Z","vuln",[142,143,144,145],49,"漏洞","复现","漏洞利用","漏洞分析","GitHub 安全公告","evk1h2i0cwyv6u2r44t04ftat","NLTK BllipParser 路径校验缺失可导致任意文件读取","NLTK 3.10.0 至 3.10.3 的 BllipParser 未对调用方提供的模型路径执行 pathsec 校验，攻击者可控制原生 bllipparser 扩展读取任意文件系统路径。",{"_88":146},"2026-11-13T23:20:56.000Z","2026-11-13T23:32:25.597Z","disclosure",[145,143,156,118],48,"利用链","qcuckwn1ukhadodfb16rw0osb","NLTK CCG 词典解析器二次时间 CPU 拒绝服务漏洞分析（影响版本 <= 3.10.3）","NLTK CCG 词典解析器 nltk.ccg.lexicon.fromstring 在处理宽括号体和长运算符链时存在二次时间复杂度，可被攻击者控制的数 MB 词典文本消耗数十秒单线程 CPU。",{"_88":146},"2026-11-14T00:08:50.000Z","2026-11-14T00:20:25.313Z",[145,143,165],42,"技术研究","cetop6struj3ivlk7mar18qfe","NLTK Tree.chomsky_normal_form 存在二次时间 CPU 拒绝服务漏洞","NLTK 的 Tree.chomsky_normal_form() 在默认右因子二值化路径中反复调用 list.pop(0)，可被宽树触发 O(N^2) 单核 CPU 消耗，受影响版本为 nltk <= 3.10.3。",{"_88":146},"2026-11-14T00:07:59.000Z","2026-11-14T00:20:25.322Z",[142,143,145,173],"补丁","hig5u4b1zg3qq2vyy9v3m0ltw","NLTK ConllCorpusReader.srl_instances() 嵌套 span 重扫描导致二次方 CPU 拒绝服务","NLTK 的 ConllCorpusReader.srl_instances() 在构建 SRL 实例时对每个谓词重扫描所有 span 列，复杂度 O(P^2 * R)。",{"_88":146},"2026-11-14T00:05:57.000Z","2026-11-14T00:20:25.329Z",[142,143,145,156],41,"q5r31mwly1rb0skcaj1k2m8gh","ESET 揭示 GTA VI 预发售诈骗：虚假下载、商店与加密货币骗局借势蔓延","ESET 警告，GTA VI 尚未正式发售，围绕假泄露、恶意下载、虚假商店、加密货币骗局及虚构 PC 版、beta 或提前体验的诈骗已全面展开，部分安装程序携带信息窃取器、远程访问木马和破坏性恶意软件。",{"_88":194},"2026-11-13T10:00:00.000Z","2026-11-14T04:07:44.803Z",[104,105,190,118,191,192,193],45,"钓鱼","勒索","黑产","ESET","ESET WeLiveSecurity","t89thc6kutkrfhgtf1lwwumin","企业 AI Agent 催生五类安全岗位与能力要求","企业 AI Agent 获得 SharePoint、邮箱、工单及代码等系统权限后，prompt injection 与 excessive agency 催生 AI 红队、AI 安全工程、评估、治理合规及检测响应五类岗位。",{"_88":209},"2026-11-14T13:04:01.000Z","2026-11-14T14:12:34.533Z","ai-security",[204,205,206,207,208],18,"AI 安全","Agent 安全","治理","蓝队","大模型","Hackread","mwouaoheoihzxg7tv9qiyhivi","CISA 将 Check Point 与 UnrealIRCd 漏洞 CVE-2026-123039、CVE-2026-114713 加入 KEV 目录","CISA 将 UnrealIRCd 命令注入漏洞 CVE-2026-114713 和 Check Point 本地提权漏洞 CVE-2026-123039 加入 KEV 目录，确认均已被真实利用，并要求联邦机构在 2026 年 11 月 16 日前完成处置。","材料列明两个漏洞的利用前提、攻击链和处置期限，便于相关机构核对资产暴露与修复状态。",{"_88":122},"2026-11-14T09:08:00.000Z","2026-11-14T14:12:35.822Z",[106,142,173,219,220,221],84,"Check Point","CISA","VMware","ku1yk1n7d455hzcngonzx15fx","美国天空关闭事件原因查明：原可避免，Microsoft 中断被排除","美国天空关闭事件的原因已查明，原文称该事件本可避免，并已排除 cyberattack 和 Microsoft 中断因素；正文未披露具体原因、受影响范围或处置细节。",{"_88":230},"2026-11-14T11:44:00.000Z","2026-11-14T14:12:37.742Z",[104,108],21,"Cybernews","voiqcxe9tykq0yg7whylub8qc","UnrealIRCd CVE-2026-114713 已被利用，可注入服务器级命令","UnrealIRCd 的 CVE-2026-114713 已被用于在野利用，CISA 将其列入 KEV 目录。该漏洞 CVSS 8.6，影响 6.0.0 至 6.2.7.1 之前的版本，攻击者可利用未转义的 IRCv3 label 消息标签，在包含两个或更多互联服务器的网络中注入以服务器权限执行命令。",{"_88":241},"2026-11-14T12:38:35.000Z","2026-11-14T14:12:40.535Z",[106,142,173,239,220,240],53,"网络设备","NVD","The Hacker News","y1c8ltpl2iqy9t7vw429lcgww","Apple 详解 Secure Enclaves 如何隔离摄像头与麦克风数据","Apple 公开 Secure Enclaves 安全架构的运行机制，通过隔离运行环境处理摄像头和麦克风数据，主操作系统、应用及 Apple 均无法访问在 Secure Enclave 内处理和分析的数据。",{"_88":89},"2026-11-14T11:00:00.000Z","2026-11-14T14:12:42.908Z",[165,145,250,251,131,252],59,"Apple","IoT","操作系统","r2adzdyhf5tf02yb7h4qosas0","FAA 全国地面停飞未发现黑客攻击证据，FBI 调查软件更新","美国官员未发现黑客导致 FAA 全国地面停飞的证据，FBI 正调查软件更新是否为诱因。FAA 于 11 月 13 日因空管中心通信故障停止全国航班起飞，20:15 ET 解除，影响数千个航班，后续延误预计持续数日。官员称问题更可能源于旧有交换机和路由器被大量数据淹没及系统更新负载；NSA、CISA 等机构参与调查，但尚未公布最终根因，也未完全排除网络攻击。",{"_88":89},"2026-11-14T08:40:22.000Z","2026-11-14T14:12:42.915Z",[104,239,261,220,108],61,"应急响应","szx1lyqr0he0pwug9ig82x1j3","CrowdStrike 推出 Falcon AI Gateway，集中控制企业 AI 模型访问与安全策略","CrowdStrike 推出已正式可用并包含于 CrowdStrike Falcon® Guardian™ 的 Falcon AI Gateway，通过统一网关检查提示词与响应、监控用量并执行策略。",{"_88":271},"2026-11-13T06:00:00.000Z","2026-11-14T14:12:43.071Z",[270,204,208,205,271],43,"工具发布","CrowdStrike","naqrv4be6747lc13byl85xvls","AI 是否正在削弱网络安全行业能力？","AI 正从创造力、幽默感、情感真诚度、差异化沟通到批判性思维等方面削弱网络安全行业，过度依赖其生成内容和辅助分析可能降低沟通准确性与独立解决问题的能力。作者主张为 AI 使用划定明确边界，并坚持由本人完成署名内容的选题、研究、思考与写作。",{"_88":89},"2026-11-14T14:00:00.000Z","2026-11-14T15:13:31.983Z",[204,208,206],26,"q62rs7r8pongzx30vtu5q3hx7","美国政府中断 North Korean FaceStealer 活动，查获超 4 亿美元加密资产盗取","美国政府查获基础设施并中断 North Korean 社会工程活动 FaceStealer，该活动持续 18 个月，针对加密货币、Web3 行业及开源开发者，盗取超过 $400 million 加密资产。","文章还原了 FaceStealer 如何借深伪视频、ClickFix 和恶意更新窃取加密资产及账户凭据，并给出可迁移的会议安全建议。",{"_88":291},"2026-11-14T15:15:49.000Z","2026-11-14T15:52:27.809Z",[104,105,190,118,289,120,290],83,"供应链投毒","AWS","BleepingComputer","c8m0jl3p47ndlr667dhze2gae","ChromeOS Stable channel 更新至 16836.33.0，Chrome 浏览器版本升至 156.0.8078.102","ChromeOS Stable channel 已向设备推送 M-156 更新，ChromeOS 版本为 16836.33.0，Chrome 浏览器版本为 156.0.8078.102。Google 邀请用户发现新问题时通过提交错误或反馈渠道报告。",{"_88":303},"2026-11-14T05:00:54.817Z","2026-11-14T16:12:35.603Z","blue-team",[301,302],4,"版本更新","Google","Chrome Releases","eta42qyz5raypj4vrbbk90rnn","FBI 捣毁朝鲜 FaceStealers 行动，400百万美元被盗","FBI 捣毁朝鲜 FaceStealers 活动，该组织通过诱骗受害者参加虚假会议实施盗窃，涉案金额达 $400M。原文未披露受影响人数、具体攻击手法、漏洞编号或补丁状态。",{"_88":230},"2026-11-14T15:50:03.000Z","2026-11-14T16:59:26.745Z",[104,312,192,313],39,"数据泄露","身份与访问","mo0o847hgkw4mbxcp3hicc7jh","Expedia 遭供应链攻击，n0n 声称窃取近 10 亿条旅客记录","Expedia 确认攻击者入侵受感染的第三方数据平台供应商，并借其可信权限进入多家公司系统，调查仍在进行且未证实 n0n 声称的数据规模。","材料区分了Expedia确认的供应链攻击与勒索团伙声称的失窃规模，便于读者判断事件事实与尚未证实的数据暴露说法。",{"_88":122},"2026-11-14T16:46:26.000Z","2026-11-14T17:15:31.977Z",[104,312,191,192,323,120,302,290],81,"供应链","z2y59mturdxdsohd70ruzokq3","Cursor 遭供应链入侵，恶意 Claude Code 扩展向最多 5,000 名开发者分发 SSH 后门","Cursor 确认攻击者窃取 Fireworks AI 的访问密钥，访问内部系统并获取未脱敏 API 凭据，随后于 October 29 通过 Cursor marketplace 分发恶意 Claude Code 扩展 2.1.312 和 2.1.313。","事件完整呈现了从第三方 AI 基础设施凭据泄露到恶意扩展分发及 SSH 后门植入的攻击链，便于评估 AI 开发平台的供应链风险。",{"_88":291},"2026-11-14T17:27:25.000Z","2026-11-14T17:32:26.461Z",[104,312,107,105,333,334,108,302,290],74,"AI 供应链","AI 编码","px334fxjxyugxmntkzykt8w87","Help Net Security 上周安全资讯汇总：GitHub 仓库凭据窃取、Claude Code 远程控制植入与多起攻击","Help Net Security 汇总上周多项安全资讯：攻击者自11月10日起向数万个 GitHub 仓库植入凭据窃取载荷，其中逾 1,800 个仓库执行恶意代码并外传 GitHub Actions secrets 与云凭据。",{"_88":344},"2026-11-15T09:00:37.000Z","2026-11-15T09:21:28.000Z",[343,104,105,312,204,144],13,"汇总","Help Net Security","tog6u532ub8dq1yucwbn56k99","Fireworks AI 密钥泄露导致 Cursor Marketplace 供应被植入 Claude Code 恶意扩展","Cursor 确认，攻击者利用 Fireworks AI 泄露的访问密钥复制共享数据，进而取得 Cursor 使用的 SaaS 工具凭据及部分内部数据。","事件串联了密钥泄露、扩展市场投毒与持续 SSH 后门，并明确披露可能受影响用户、凭据暴露范围及排查处置范围。",{"_88":241},"2026-11-15T08:22:04.000Z","2026-11-15T09:36:28.850Z",[104,106,107,312,333,289],"a0gqbavi16izrdxda7hdjobus","意大利数据保护局对 Meta 处 8.05 亿欧元罚款，指 Facebook 未经同意读取 Android 图库","意大利数据保护局宣布对 Meta 处 805 million 欧元（887 million 美元）罚款，原因是 Facebook 的 Get suggestions from gallery when browsing Facebook 功能在未获具体同意、未作充分告知的情况下使用 Android 用户图库中的照片和视频。",{"_88":89},"2026-11-14T19:00:00.000Z","2026-11-15T11:18:27.495Z","policy",[362,363,302,131],57,"法规","合规","xa3luvbw2zj4cvxy6ym74713s","La Poste 子公司 Maileva 遭网络攻击，2200 万人姓名和邮政地址泄露","La Poste 子公司 Maileva 在 9 月中旬遭网络攻击，泄露 2200 万名客户的接收者姓名和邮政地址，受影响者包括患者和租户，多数并非 Maileva 客户。Maileva 称银行信息未被窃取，但攻击者据报读取了部分付款提醒，其中含发票编号、治疗日期和欠款金额；公司已通知 CNIL、提交刑事报案，司法调查正在进行，受影响客户是否通知个人仍待观察。","事件展示了第三方文档服务平台扩大数据泄露影响面的路径，受影响者甚至可能不知道自己在使用该服务。",{"_88":122},"2026-11-15T10:43:16.000Z","2026-11-15T11:32:31.802Z",[104,312,323,118],73,"syiens59ccuc9lmtn233vr8gd","意大利因 Facebook Android 图库访问默认开启问题罚款 Meta €805 million","意大利数据保护机构 Garante 对 Meta 罚款 €805 million，原因是 Facebook for Android 默认开启照片和视频图库建议功能，未经用户明确同意访问意大利用户图库及相关元数据。","材料梳理了处罚依据、整改期限和功能默认状态，可用于理解移动应用获取图库权限时的合规边界。",{"_88":241},"2026-11-15T11:27:31.000Z","2026-11-15T12:18:29.177Z",[362,363,131,302],"rmv3fhp333abtx9ipkvsdodlv","Pentagon 将 CDAO 更名为 Super Intelligence Office","Pentagon 将 Chief Digital and Artificial Intelligence Office（CDAO）更名为 Super Intelligence Office。",{"_88":89},"2026-11-15T12:51:33.000Z","2026-11-15T13:18:27.562Z",[204,206,208,108,290],27,"xd9ub2ylkejv4lczx8263vksb","Microsoft Defender for macOS 本地权限提升漏洞利用链分析","Microsoft Defender for macOS 存在 PID 复用竞态导致的本地权限提升链，可利用 CVE-2026-50657 任意读取文件，并利用 CVE-2026-50658 绕过授权、以 root 身份创建文件，最终通过 /etc/crontab 获得 root shell。","文章以可复现的竞态利用链说明跨平台修复为何可能遗漏 macOS，并比较了两套系统的身份校验、授权和文件链接差异。",{"_88":397},"2026-11-15T12:00:00.000Z","2026-11-15T13:31:32.304Z",[165,145,143,144,156,250,108],"spaceraccoon","y473lhq0whtsi5ie4k62fyr0h","Security Affairs 第 604 期国际版周报：汇总近期漏洞、攻击与安全事件","Security Affairs 第 604 期国际版周报汇总多起安全事件，涵盖 Expedia 近 10 亿条旅客记录失窃、North Korea 加密货币盗窃行动、GoToLocker 感染 25,000 台计算机，以及 Check Point Gateways 遭 PHP2Shell 利用等。",{"_88":122},"2026-11-15T15:00:08.000Z","2026-11-15T15:35:47.095Z",[343,406,104,207,204],10,"漏洞管理","a2h58j25yjmsm9hop0rtjfi1t","SecPO 结合对抗训练提升 Agent 提示注入防御能力","UC Berkeley、Anthropic 等机构研究人员提出 SecPO 与对抗训练结合的模型安全方法，通过安全偏好优化和动态攻击搜索提升 Agent 对提示注入的抵御能力。",{"_88":415},"2026-11-13T16:00:00.000Z","2026-11-15T15:35:49.098Z",[204,205,414,165,208],"论文","安全内参","sk7veseq005bbedhfnw2rqegr","TSMC 员工数据泄露，6.9GB 数据疑与云服务商遭入侵有关","TSMC 确认现任及部分前任员工数据被未经授权发布到外部网站，调查发现泄露信息与其使用的云服务商系统存储数据相符，目前没有证据显示 TSMC 自身系统被攻破。","TSMC 已核实泄露数据来自云服务商，文章还给出数据规模、拍卖报价和泄露时间线，便于评估员工数据处置需求。",{"_88":291},"2026-11-15T15:23:48.000Z","2026-11-15T15:50:42.665Z",[104,312,192,323],71,"sk9atn27z1rrggobbcycf6bz6","Security Affairs 发布第 8 期 AI-CYBERSECURITY 汇总","Security Affairs 第 8 期 AI-CYBERSECURITY newsletter 汇总 AI 与网络安全领域的文章和研究，涵盖自主 AI 入侵、针对台湾紧急服务攻击的 AI attack mesh、Claude Code 密钥暴露、SGLang RCE 漏洞利用，以及 Fireworks AI 和 Notion AI 数据泄露等事件。",{"_88":122},"2026-11-15T16:06:11.000Z","2026-11-15T16:36:56.283Z",[343,204,208,205],9,"tw9y5jq7758m7itk8qw352v1o","Security Affairs 第 123 期恶意软件资讯汇总：Turla、AhsayCBS、CopperDragon、SCKit 与 wfx 攻击活动及检测研究","Security Affairs 第 123 期恶意软件 newsletter 汇总多起威胁与研究。",{"_88":122},"2026-11-15T15:49:04.000Z","2026-11-15T16:36:56.302Z",[343,105,145,207,441,270],8,"检测工程","k4uuj5trh7l8y7g1ko080x2rr","FBI 警告 ARTEX AI 渗透测试框架被用于全球多行业攻击","FBI 警告，开源 AI 渗透测试框架 ARTEX 已被多个威胁行为者武器化，自 2026 年 8 月起用于金融、政府、科技、国防和医疗等行业的全球攻击。","材料梳理了 ARTEX 被多类威胁行为者采用的方式、实际影响与防守措施，并提供公开暴露规模和检测信息。",{"_88":291},"2026-11-15T18:29:53.000Z","2026-11-15T21:29:43.587Z",[104,119,205,208,323,312,220,108,271],"lwqu8o28wvvjee598g7ec1in2","香港大学发布 FuzzAnything 智能模糊测试平台，评估覆盖 20 个开源库","香港大学 Chen Ho 教授课题组发布 FuzzAnything 智能模糊测试平台，以 Agent 自动构造 Harness、驱动 Fuzzer、分析反馈并迭代改进入口。","文章给出平台规模、实验对比结果及分级披露机制，便于研究者评估工具效果并参与崩溃复核。",{"_88":459},"2026-11-15T08:20:00.000Z","2026-11-15T21:36:44.067Z",[204,205,165,270,414,208,458,302],"腾讯","安全研究GoSSIP","ieuqwqfgmwdq4wzkjsu78el27","YARA-X 1.23.0 发布：新增 4 项改进并修复 16 个缺陷","YARA-X 1.23.0 版本发布，带来 4 项改进和 16 项缺陷修复。该版本由 Didier Stevens 于 2026-11-15 在 SANS ISC 博客公布，文章未披露具体改进内容、修复缺陷清单或相关安全问题。",{"_88":468},"2026-11-15T18:17:27.000Z","2026-11-15T22:38:43.867Z",[270,301],14,"SANS ISC","jx8qldq434280gul46prza1bc","意大利 Garante 因 Facebook 相册默认访问功能对 Meta 罚款 €805 million","意大利数据保护机构 Garante 因 Facebook for Android 在未取得明确同意且未充分告知的情况下访问用户照片、视频及元数据，对 Meta Platforms Ireland Limited 罚款 €805 million，涉及约 2000 万名 Android 用户。",{"_88":122},"2026-11-15T18:11:56.000Z","2026-11-15T22:40:48.079Z",[362,363,131,313],64,"n8onpn7ajtxdzkpvanfetccbg","Microsoft 365 中断导致德国 Hotel Ling Bao 15 名住客氯气中毒","德国 Hotel Ling Bao 的泳池氯气控制系统依赖邮件发送超标告警，Microsoft 云服务中断后告警未能发出，最终造成 15 名住客不适，其中 13 人出现呼吸道刺激，4 人被送医、1 人留院观察。",{"_88":122},"2026-11-15T22:38:00.000Z","2026-11-15T23:41:47.352Z",[207,484,251,108],"加固","all","tag","q","tab","time",{"_491":492,"_493":-5},"changelogVersion","2026-10-01T08:00","release"]
