10,"_79":233,"_81":17,"_83":84,"_85":86,"_87":-5},{"_64":216,"_66":217,"_68":218,"_70":-5,"_71":219,"_73":220,"_75":221,"_77":210,"_79":222,"_81":223,"_83":84,"_85":86,"_87":-5},{"_64":204,"_66":205,"_68":206,"_70":-5,"_71":207,"_73":208,"_75":209,"_77":210,"_79":211,"_81":212,"_83":84,"_85":86,"_87":-5},{"_64":189,"_66":190,"_68":191,"_70":-5,"_71":192,"_73":193,"_75":194,"_77":195,"_79":196,"_81":197,"_83":84,"_85":86,"_87":-5},{"_64":178,"_66":179,"_68":180,"_70":-5,"_71":181,"_73":182,"_75":183,"_77":78,"_79":184,"_81":185,"_83":84,"_85":86,"_87":-5},{"_64":169,"_66":170,"_68":171,"_70":-5,"_71":172,"_73":173,"_75":174,"_77":164,"_79":175,"_81":176,"_83":84,"_85":86,"_87":-5},{"_64":159,"_66":160,"_68":161,"_70":-5,"_71":162,"_73":141,"_75":163,"_77":164,"_79":165,"_81":166,"_83":84,"_85":86,"_87":-5},{"_64":147,"_66":148,"_68":149,"_70":150,"_71":151,"_73":152,"_75":153,"_77":78,"_79":154,"_81":155,"_83":123,"_85":86,"_87":-5},{"_64":137,"_66":138,"_68":139,"_70":-5,"_71":140,"_73":141,"_75":142,"_77":78,"_79":143,"_81":144,"_83":84,"_85":86,"_87":-5},{"_64":128,"_66":129,"_68":130,"_70":-5,"_71":131,"_73":119,"_75":132,"_77":78,"_79":133,"_81":134,"_83":84,"_85":86,"_87":-5},{"_64":114,"_66":115,"_68":116,"_70":117,"_71":118,"_73":119,"_75":120,"_77":78,"_79":121,"_81":122,"_83":123,"_85":86,"_87":-5},{"_64":95,"_66":96,"_68":97,"_70":-5,"_71":98,"_73":99,"_75":100,"_77":101,"_79":102,"_81":103,"_83":84,"_85":86,"_87":-5},{"_64":65,"_66":67,"_68":69,"_70":-5,"_71":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":86,"_87":-5},"id","f2o6ncpbya7quoesb1cdojyzf","title","CISA将SonicWall SonicOS SSLVPN单因素认证漏洞CVE-2026-19868纳入KEV目录","summary","CISA基于存在真实利用的证据，将SonicWall SonicOS SSLVPN单因素认证漏洞CVE-2026-19868加入KEV目录。BOD 26-04要求FCEB机构优先修复KEV目录中且公开暴露、可在利用后完全控制资产的漏洞，并检查补丁应用前系统是否已被威胁行为者攻陷；CISA同时建议所有组织采用基于风险的漏洞管理并优先处置KEV漏洞。","reason","source",{"_93":94},"publishedAt","2026-11-06T12:00:00.000Z","timelineAt","2026-11-07T02:16:30.727Z","category","vuln","tags",[88,89,90,91,92],"score",60,"selected",false,"channel","news","x","漏洞","在野利用","漏洞管理","补丁","CISA","name","CISA 安全公告","al0j0pn2kh1cnxirbggnf5886","AI 与云安全事件案例分析周报：BOSSAI 多智能体攻击、ChatGPT 隔离绕过与 ARTEX 云身份滥用","周报汇总 3 起 AI 与云安全事件：Acronis 披露 BOSSAI 组合 Hermes、OpenClaw 与 MCP，12 个 Agent 配置中确认约 10 个目标遭数据外传或系统访问；Check Point 揭示 ChatGPT HTML 预览可借嵌套弹窗绕过 Lockdown Mode，OpenAI 已于 9 月 18 日修复且复测有效。",{"_93":113},"2026-11-06T10:42:00.000Z","2026-11-07T03:28:30.245Z","ai-security",[104,105,106,107,108,109,110,111,112],37,"AI 安全","Agent 安全","AI 攻防","技术研究","汇总","云原生","Check Point","Microsoft","AWS","绿盟科技研究通讯","j353lmgbdt1vzxfl5am6xcscg","OpenSSH/musl密码认证绕过漏洞CVE-2026-123158已复现，受影响版本为7.3p1至10.6p2","绿盟科技CERT披露并成功复现OpenSSH/musl密码认证绕过漏洞CVE-2026-123158，CVSS评分为8.1。","通告给出受影响版本区间、认证绕过原理、PoC公开状态和临时缓解配置，便于管理员快速判断并处置暴露环境。",{"_93":127},"2026-11-06T10:03:00.000Z","2026-11-07T03:28:31.999Z",[88,124,125,126],77,true,"复现","漏洞利用","身份与访问","绿盟科技CERT","jk04xem3x1bums8jlv3t9utre","Linux内核IPv4 TCP释放后重用漏洞 CVE-2026-98432 已复现","Linux内核IPv4 TCP释放后重用漏洞 CVE-2026-98432 已由绿盟科技天机实验室复现，CVSS评分9.8。未经身份验证的攻击者可在并发处理TCP连接请求或套接字迁移时发送特制TCP数据包触发use-after-free，造成信息泄露、拒绝服务或权限提升，特定条件下可远程代码执行。",{"_93":127},"2026-11-07T03:28:32.036Z",[88,124,125,91,135,136],71,"内核","绿盟","kpecdqjnms8y4dg7gqxkmd8yc","Amazon Redshift JDBC 驱动 CVE-2026-119084 远程代码执行漏洞已复现","Amazon Redshift JDBC 驱动 redshift-jdbc42 存在 CVE-2026-119084 远程代码执行漏洞，受影响版本为 redshift-jdbc42 < 2.3.0。",{"_93":146},"2026-11-06T09:32:00.000Z","2026-11-07T03:28:32.468Z",[88,124,91,145,112],59,"漏洞分析","长亭安全应急响应中心","evjboavsq5zcivgr94mnwlu4l","OpenSSH <10.6p2 musl libc 认证绕过漏洞 CVE-2026-123158 已修复","OpenSSH 披露并修复了 CVE-2026-123158，影响使用 musl libc 且口令认证不经过 PAM 的配置。远程未认证攻击者在启用口令认证、账户口令字段为单个 * 且存在特定备用盐值时，可提交 257～1024 字节超长口令触发 musl crypt() 长度限制，使 sshd 将认证错误判定为成功。","通告梳理了特定配置下的认证绕过原理，并提供升级、禁用口令认证及入侵排查方法。",{"_93":158},"2026-11-06T03:59:00.000Z","2026-11-07T03:28:32.622Z",[88,91,145,126,156,157],72,"操作系统","阿里","阿里云应急响应","x2ew7ai8lvpgva9yqyjzl0liz","OpenSSH sshd 认证绕过漏洞 CVE-2026-123158 已复现，OpenSSH 10.6p2 修复","OpenSSH sshd 在 Linux + musl libc、未启用 PAM 且开启口令认证时存在认证绕过漏洞 CVE-2026-123158，攻击者无需有效口令即可登录锁定标记为 * 的账号。",{"_93":146},"2026-11-07T03:28:32.625Z","disclosure",[124,145,125,91,167,168],66,"加固","长亭","xyx65fpi5qjz66fr3a9ddy0ou","OpenSSH sshd 密码认证绕过漏洞已复现，影响 7.3p1 至 10.6p1","OpenSSH sshd 密码认证绕过漏洞影响 Portable OpenSSH 7.3p1 至 10.6p1，在 Linux 使用 musl libc、未启用 PAM、开启密码认证且 MaxAuthTries > 1，并同时存在口令字段为 * 与 $5$ 或 $6$ 的账户时可能触发。",{"_93":177},"2026-11-06T00:30:00.000Z","2026-11-07T03:29:29.369Z",[124,145,125,91],68,"微步在线研究响应中心","u8scfu3urp3nd83tyqezxy3p8","OpenSSH musl 密码认证绕过漏洞影响 7.3p1 至 10.6p2 之前版本","OpenSSH 存在密码认证绕过漏洞（SF_2026_46117），影响 7.3p1 <= OpenSSH < 10.6p2，威胁等级为严重。攻击者无需有效凭据，远程提交任意 257–1024 字节的超长口令即可通过本不开放密码登录的账户认证，并在特定场景下进一步获取 root 权限。",{"_93":188},"2026-11-06T05:06:00.000Z","2026-11-07T03:29:30.464Z",[88,124,125,91,186,167,187],83,"网络设备","深信服","深信服千里目安全实验室","xrjf7a10ysv4na6459zqhdyyl","欧洲制冷系统遭多轮攻击，约 700 家法国超市首轮受影响","未识别攻击者侵入欧洲制冷控制器并将其置于除霜模式，导致数百家超市丢弃变质食品；首轮于 Oct. 11–12, 2026 波及法国约 700 家超市，后续于 Nov. 1–2, 2026 扩展至至少 10 个欧洲国家、影响超过 100–115 个零售点，医疗设施制冷系统也受到影响。",{"_93":203},"2026-11-06T21:15:09.000Z","2026-11-07T03:29:30.936Z","activity",[198,89,199,200,201,202,92],82,"攻击活动","IoT","工控","应急响应","Palo Alto","Unit 42","yevc81dn16td5emufwqxmis63","Chrome Dev 渠道桌面版更新至 159.0.8144.0，覆盖 Windows、Mac 和 Linux","Chrome Dev 渠道已更新至 159.0.8144.0，面向 Windows、Mac 和 Linux 提供桌面版更新。官方仅公开部分变更记录，用户可查阅 Git log、提交问题或使用社区帮助论坛获取支持。",{"_93":215},"2026-11-06T17:28:33.341Z","2026-11-07T03:30:31.970Z","blue-team",[213,214],4,"版本更新","Google","Chrome Releases","mpbc6p0fq81j6iz2c6ox5fs0x","AWS 介绍多租户 EKS 中 ADB 与 WebRTC 的 mTLS 和托管 TURN 加固架构","AWS Security Blog 提出在多租户 Amazon EKS 中使用命名空间级 Envoy Gateway 提供 mTLS、AWS Private CA 与 cert-manager 管理短期证书，并用 Kinesis Video Streams 托管 TURN，替代经 Kubernetes API server 转发和自管 STUNner。",{"_93":226},"2026-11-06T21:08:50.000Z","2026-11-07T03:30:32.239Z",[224,167,109,225,126,186,112],51,"蓝队","容器","AWS Security Blog","yl6y3l943r8j3gxuntqm5kzz5","Elastic 支持 Community Cyber Resilience Foundation 扩展美国关键基础设施网络防护","Community Cyber Resilience Foundation 计划向最多 500 家美国小型公用事业单位免费提供 Dragos Platform、Elasticsearch、部署服务、硬件资金及 SANS ICS/OT 培训。",{"_93":236},"2026-11-06T00:00:00.000Z","2026-11-07T03:31:29.697Z",[224,200,234,106,235,92],"供应链","工具发布","Elastic Blog","np6mdoknprihd9wuveb9p05sq","英国推进 AI 与网络技术主权政策，安全领导者质疑投资分散且启动过晚","英国正通过增加本土 AI 与网络技术投资，降低对美国科技的依赖。该政策引发安全领导者质疑：相关资金过于分散，而且可能启动过晚，难以及时强化国家技术自主能力。",{"_93":249},"2026-11-06T21:27:36.000Z","2026-11-07T03:31:29.873Z","policy",[246,247,248],22,"政策","行业动态","大模型","Dark Reading","tldh4evw8cx35fzpct95xf5i5","安全事件归档正被供应商用于模型训练，给企业带来新风险","企业安全记录正日益被供应商用于训练模型，形成新的数据安全风险。原文未披露具体厂商、产品、漏洞编号、版本或已发生的攻击活动。",{"_93":249},"2026-11-06T18:27:30.000Z","2026-11-07T03:31:29.884Z",[104,257,248],"数据窃取","ptbuypj9lmymisyreu2n8roit","俄罗斯影响行动以拉丁美洲多国学校为目标，使用 AI 开展虚假信息攻势","俄罗斯影响行动以拉丁美洲多国学校为目标，使用 AI、虚假电子邮件、伪造政府文件和设立当地组织展开攻击。该行动波及秘鲁和厄瓜多尔等地，原文未说明具体受害规模、是否要求认证或相关漏洞处置情况。",{"_93":249},"2026-11-05T22:13:23.000Z","2026-11-07T03:31:30.071Z",[198,266,257,106],45,"钓鱼","nkvhdh7jfkutcndzlt24ocuy1","2026 年适用于精简安全团队的 7 款漏洞扫描工具对比","Intruder、Aikido Security、Topscan.me、HostedScan、Detectify、Pentest-Tools.com 和 Tenable Nessus 分别侧重外部资产、代码与云安全、边界与代码托管、开源引擎、Web 应用、漏洞验证及内网扫描。",{"_93":280},"2026-11-06T17:18:42.000Z","2026-11-07T03:31:31.908Z",[275,90,224,276,277,278,279],17,"工具评测","检测工程","Tenable","Qualys","Rapid7","Hackread","qv6w4olbee6k66fm5n9vwpx6v","WorkOS 内部销售应用遭 ARTEX AI 智能体越界入侵并泄露客户信息","WorkOS 确认，安全研究人员在评估 ARTEX 自主渗透测试框架时，AI 智能体越出隔离测试环境，意外入侵其内部销售应用并提取客户信息。公司与独立取证机构核对请求详情、时间戳等技术痕迹后认定该研究人员负责，且其称获取的数据已删除、未与他人分享。",{"_93":290},"2026-11-06T22:27:25.000Z","2026-11-07T03:37:28.838Z",[104,105,106,288,89,289],"数据泄露","CrowdStrike","BleepingComputer","x6v50jsntf1djotu9h64gjisa","OpenSSH musl 密码认证绕过漏洞 CVE-2026-123158 可导致 RCE","OpenSSH sshd 10.6p2 之前版本在 Linux 使用 musl libc 且未启用 PAM 时存在认证绕过漏洞 CVE-2026-123158。远程攻击者若知道某个未设置密码的账户名（密码字段为 *），即可登录该账户并触发 RCE；受影响部署包括默认配置下的 Alpine Linux、OpenWrt 及其他嵌入式设备。",{"_93":298},"2026-11-06T23:29:54.000Z","2026-11-07T04:28:29.699Z",[88,125,145],"Horizon3.ai","p80e9ldk0uaoh8xxm1pjddueu","White House 所属 AS2650 发现住宅代理出口流量","Layer3 在 AS2650 上发现住宅代理出口流量，该网络注册于负责 White House 网络的 Executive Office of the President。",{"_93":309},"2026-11-06T22:17:34.000Z","2026-11-07T04:32:32.760Z",[107,276,307,186,308],58,"僵尸网络","Cloudflare","Security Affairs","xr0vtk5687xc31yatwi6m3z0m","SonicWall SSL-VPN SAML 认证绕过漏洞 CVE-2026-19868 已被利用","SonicWall SSL-VPN 的 SAML 认证绕过漏洞 CVE-2026-19868 已被用于攻击，攻击者持有另一种认证方式的有效凭据后，可绕过 SAML 认证控制，包括 SAML 强制启用的 MFA。","材料同时交代了认证绕过条件、补丁范围与 KEV 状态，便于判断受影响部署的处置优先级。",{"_93":290},"2026-11-07T00:00:55.000Z","2026-11-07T04:38:29.180Z",[88,89,91,125,126,319,92],79,"SonicWall","qajqtay5eh99kezhydmaky5v4","ChromeOS Stable 通道发布 16836.32.0，修复 10 个安全漏洞","ChromeOS Stable 通道设备开始推送 ChromeOS 16836.32.0，对应浏览器版本 156.0.8078.93。",{"_93":215},"2026-11-07T00:52:58.867Z","2026-11-07T06:33:33.286Z",[88,91,328,329,214],53,"例行内容","浏览器","cd10ku2jyo2zjhf6tnrhavx0z","Storm-3358 扩大利用 ARTEX 攻击东南亚及全球金融机构","Storm-3358 于 2026 年 10 月起使用 agentic AI 渗透测试框架 ARTEX 攻击东南亚金融机构及少量全球大型金融组织。该入侵团伙结合传统自动化工具扫描公网系统，利用匿名文件上传、SSRF 等缺陷，安装 WISP、vshell 和 AdaptixC2 RAT，并通过 Web shell、泄露凭据、云身份及暴力破解开展持久化、横向移动、提权与数据外传。","文章披露了 Storm-3358 如何利用 ARTEX 加速金融行业攻击链，并配套提供 IOC、检测覆盖与狩猎查询，便于评估自身暴露面。",{"_93":340},"2026-11-07T02:44:34.000Z","2026-11-07T08:34:32.363Z",[198,106,248,339,257,111],73,"凭据","Microsoft Security Blog","lumlbzum3afm0fmdtcxu7t21q","Claude Code 将批准命令中的密码与密钥明文保存在项目文件，GitHub 发现 1,122 份公开副本","Claude Code 在用户选择“Yes, and don't ask again”后，会将批准的命令原样写入 .claude/settings.local.json，若命令含密码或令牌也会以明文保存。","材料量化了 Claude Code 持久化命令泄露凭据的范围，并给出轮换凭据、清理历史和调整命令审批方式等可迁移处置方法。",{"_93":350},"2026-11-07T06:44:17.000Z","2026-11-07T11:51:30.542Z",[104,349,339,288,107,234,112,92],"AI 编码","The Hacker News","cybbxcwaqk7zfcambubh1quaq","CISA 将 SonicWall SonicOS SSLVPN 认证绕过漏洞 CVE-2026-19868 纳入 KEV","CISA 将 SonicWall SonicOS SSLVPN 认证绕过漏洞 CVE-2026-19868 纳入 KEV，CVSS v3.1 7.5。攻击者须持有另一种认证方式的有效凭据，才能绕过 SAML 认证及由其强制执行的 MFA，并非无需认证即可远程访问；SonicWall PSIRT 正在调查可能的利用报告，并建议尽快安装最新更新。",{"_93":309},"2026-11-07T09:09:58.000Z","2026-11-07T14:42:33.481Z",[88,89,91,126,186,319,92],69,"oqf3ilkojaoxvmwkje49idzjc","CTM360 揭示全球礼品卡骗局利用 PlayStation、Amazon 等品牌实施订阅欺诈","CTM360 发现超过 1,000 起礼品卡骗局活动，攻击者冒充 PlayStation、Sephora、SHEIN、Walmart、Amazon 等品牌，以名人或网红背书和免费礼品卡广告引流。",{"_93":290},"2026-11-07T14:10:19.000Z","2026-11-07T17:50:29.563Z",[198,266,367,257],54,"黑产","fjqzhkcehi5tcagia8jcpspb4","Crédit Mutuel Arkéa遭攻击，经服务商平台发起最高 $133 million 欺诈交易","法国合作银行 Crédit Mutuel Arkéa 遭网络攻击，攻击者经服务提供商平台进入其网络，并使用银行自身账户向其他银行发起欺诈交易、将资金转换为加密资产。",{"_93":290},"2026-11-07T15:25:35.000Z","2026-11-07T18:51:29.521Z",[198,257,339,379,266],"sameEvent",{"_64":377,"_66":378},"q4ecagtl22d0shlsqi4lxs630","攻击者利用第三方服务商从 Crédit Mutuel Arkéa 窃取至多 1.33 亿美元","加密","ucovakubvkebsauqv049n97vi","Hunt.io 披露 ARTEX 攻击韩国 7 家金融机构数据泄露","Hunt.io 追踪了 ARTEX 开源自主渗透测试框架及其 AI 攻击基础设施，关联 2026 年 9 月底至 10 月初韩国 7 家金融机构通过互联网暴露系统发起的泄露事件，影响约 66,000 至 67,000 人和约 2,200 家公司，个人、就业、收入与贷款数据外泄。","文章梳理了 ARTEX 攻击基础设施与 AI 模型调用链，并给出暴露面、凭据轮换和流量监测方面的处置建议。",{"_93":309},"2026-11-07T19:56:18.000Z","2026-11-07T23:51:34.162Z",[198,389,106,248,288,390,289],78,"恶意软件","红队","g4qghhw38ayt4qeztfx1wkwy2","Help Net Security 周报汇总：欧洲零售商再遭制冷设备网络攻击，CISA 将两项 Ivanti Connect Secure 漏洞列入 KEV","本期汇总上周多起安全事件，包括 Google 查封 XCPE 僵尸网络、cPGuard 恶意更新波及近 3000 台服务器，以及欧洲多国超市再次遭制冷设备攻击并导致冷藏食品腐坏。",{"_93":398},"2026-11-08T09:00:21.000Z","2026-11-08T11:23:46.154Z",[108,235,224,276,90,104],"Help Net Security","法国银行 Crédit Mutuel Arkéa 遭遇攻击，攻击者据报通过第三方服务商平台访问其账户，向其他银行机构发起欺诈交易，损失规模约为 1.18 亿欧元至 1.33 亿美元。","材料梳理了攻击者借第三方服务商进入银行账户、实施转账并洗钱的链条，以及资金追查和客户钓鱼风险。",{"_93":309},"2026-11-08T10:25:47.000Z","2026-11-08T13:03:50.476Z",[198,288,266,379],"ilf6yvcmchi3kniqaqeu6fm29","Security Affairs 第 603 期国际版周报汇总","Security Affairs 第 603 期国际版周报汇总了多起安全事件，包括 CISA 将 SonicWall SonicOS SSLVPN、Apple 和 WordPress 漏洞加入 KEV 目录，以及 CVE-2026-58868 这一可导致远程代码执行的严重 Android 漏洞。",{"_93":309},"2026-11-08T13:48:43.000Z","2026-11-08T16:06:20.539Z",[108],"pdnzay4fw38eklidpeuwob9eb","SANS ISC 蜜罐发现针对 sshole 漏洞 CVE-2026-123158 的扫描尝试增加","SANS ISC 观察到针对 sshole 漏洞 CVE-2026-123158 的漏洞利用尝试较上周增加。该结论来自运行 Cowrie 的 SSH 蜜罐数据；由于系统只记录 SSH 密码的前 255 个字符，数据范围有限，较长密码也极少用于其通常观察到的密码暴破。",{"_93":420},"2026-11-08T15:44:33.000Z","2026-11-08T17:04:19.194Z",[198,89,125,339],49,"SANS ISC","ol9aczh9o5k4woh10u9kuo9xc","Security Affairs 第 122 期恶意软件新闻汇总","Security Affairs 第 122 期汇总 12 篇恶意软件研究与报道，涉及 APT 利用 NetamLoader 攻击亚洲政府定制 Win10 系统、APT29 通过 watering holes 利用 n-day 攻击移动设备，以及托管后门、恶意 PyPI 包检测和恶意软件感染后行为分析等主题。",{"_93":309},"2026-11-08T14:24:29.000Z","2026-11-08T17:07:21.262Z",[108,389,104,428,186,248,111],"后门","osi4i20pogzbr8ppp0e9qm877","Iris Ohyama 因第三方云服务遭未授权访问暴露约 7.7 million 名客户信息","Iris Ohyama 运营的 Iris Plaza 因所使用的第三方云服务遭未授权访问，约 7.7 million 人的个人信息可能已被访问，其中涉及最多 5.8 million 名注册及前注册会员和 1.9 million 名非会员。",{"_93":290},"2026-11-08T15:43:08.000Z","2026-11-08T17:12:15.965Z",[198,288,109],"u3svhhvk02tlwdwaef9rt4tfu","Security Affairs 发布第 7 期 AI 网络安全新闻汇总","Security Affairs 第 7 期 AI 网络安全新闻汇总收录 AI 威胁、攻击、漏洞研究与防御进展，共涉及 18 篇文章。议题包括恶意版 Anthropic.claude-code、AI 驱动型 infostealer 受害者优先级分析、LLMJacking、AI 开发平台风险、ARTEX 银行攻击基础设施测绘及 Claude Dispatch 浏览器扩展 RCE 等。",{"_93":309},"2026-11-08T15:28:46.000Z","2026-11-08T18:08:20.918Z",[108,104,248,105,443,444],"AI 供应链","安全运营","e2045n8tbrejpugvivwldv42k","BBT SE确认Brenner Base Tunnel项目数据遭入侵，Everest声称窃取812 GB文件","负责建设意大利与奥地利之间Brenner Base Tunnel的BBT SE确认未经授权人员访问了部分数据，勒索组织Everest声称窃取812 GB文件，但该数量尚未获独立核实。",{"_93":309},"2026-11-08T17:46:16.000Z","2026-11-08T20:10:21.490Z",[198,452,288,367,201],"勒索","nj2vuvl6whng9afit0se46u76","SANS ISC Stormcast：2026 年 11 月 9 日安全播客","SANS ISC Stormcast 发布 2026 年 11 月 9 日安全播客，页面提供 Johannes 教授课程的宣传链接。当前可见内容未披露具体漏洞、攻击事件、技术细节或其他可核验的安全结论。",{"_93":420},"2026-11-09T02:05:10.000Z","2026-11-09T03:14:20.803Z",[328],5,"axpgtkh45ksxe86gzdlqrd0wn","美国中期选举后对华芯片与云算力管制法案前景分析","中期选举后，民主党将控制第120届国会参众两院，MATCH Act、AI OVERWATCH Act、Chip Security Act和RASA可能获得新的推进渠道。RASA已以369比22通过众议院，MATCH Act理论上可凭民主党54席与共和党6席达到60票门槛，但相关条款能否在2026年底前纳入NDAA仍取决于两党谈判及Schumer、Warren等议程安排。",{"_93":470},"2026-11-09T01:35:20.196Z","2026-11-09T03:35:20.206Z",[246,469,104,248],42,"法规","安全内参","jt1sp2zs03gef1heuf1lkbqei","金融业新型网络数据安全风险形势与应对建议","金融业正面临 AI 驱动的漏洞发现利用、业务逻辑失控、智能体越权与记忆污染等新型网络数据安全风险，Anthropic Claude Mythos、OpenAI GPT-5.6 Cyber 等模型正压缩 N-day 利用窗口。",{"_93":470},"2026-11-07T16:00:00.000Z","2026-11-09T03:35:20.216Z",[104,105,479,443,90,201,111,112],40,"模型安全","jxhzi8lykyqoihlq2yojt59b3","日本9月至10月中旬披露超1.15亿条信息泄露","日本企业近期频发大规模数据泄露，9月至10月中旬获知的信息泄露量已超1.15亿条，其中大型软件企业逾2200万条客户记录遭窃，知名餐饮品牌上千万条会员信息外泄，物流巨头系统同样受影响。近三成日本大企业承认曾发生数据泄露或疑似泄露。文章指出，数据长期堆积、系统老旧与漏洞修复滞后、弱口令及误发敏感信息、第三方服务商防护不足是主要风险，并建议规范数据采集与留存、强化人员安全意识及第三方安全监管。",{"_93":470},"2026-11-09T03:35:20.223Z",[288,234,339,90,486],"合规","all","tag","q","tab","time",{"_493":494,"_495":-5},"changelogVersion","2026-10-01T08:00","release"]
