[{"_1":2,"_3":4},"root",{"_5":239},"weekly-detail",{"_5":6},"data",{"_7":8,"_9":10,"_11":12,"_13":14},"report",{"_26":27,"_17":18,"_19":20,"_21":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48,"_49":-5,"_50":23},"index",[15,16],"today","2026-11-10","expiresAt",1794271243000,{"_17":23,"_19":24,"_21":25},{"_17":18,"_19":20,"_21":22},"key","2026-W44","issueNumber",1,"title","Binance 遭遇约 63 亿美元加密货币盗窃，TRM 归因 TraderTraitor","2026-W45",2,"APT29 关联黑客劫持 Plerdy SEO Tracker 投递 iOS 与 Android 利用链","kind","weekly","DailyInfo 周报 · 2026-W44","generatedAt","2026-11-02T02:00:33.344Z","lead",{"_21":22,"_238":36},"leadItemId","utwi4trkcm6q7c7e0bnt63sw8","overview","Cisco ASA 与 FTD 漏洞已被利用，Linux 内核、Brotli 和 Fragnesia 也出现远程利用或提权，防守方持续推动修复与缓解。攻击者借云桌面、开发工具和协作平台扩大入侵，并转向 AI 编程助手与恶意链接实施代码执行。披露方面，PHP 漏洞链、Edge 沙箱逃逸和 ChatGPT 分享链接利用链展示了新的攻击路径。","highlights",[235,236,237],"sections",[64,65,66,67],"flashes",[],"cover",{"_57":58,"_59":60,"_61":-5,"_62":-5,"_63":-5},"metrics",{"_51":52,"_53":54,"_55":56},"readingMinutes",8,"prev","next","totalStories",20,"selectedCount",98,"reportsCovered",4,"url","/dailyinfo/media/386b69997a54ad9b.jpg","srcSet","/dailyinfo/media/5221956836caafdf.jpg 720w, /dailyinfo/media/ddefde54547f0fcf.jpg 1200w, /dailyinfo/media/386b69997a54ad9b.jpg 1600w","width","height","caption",{"_68":201,"_70":202,"_71":203},{"_68":122,"_70":123,"_71":124},{"_68":92,"_70":93,"_71":94},{"_68":69,"_70":-5,"_71":72},"label","AI 安全","summary","items",[73],{"_74":75,"_21":76,"_70":77,"_78":79,"_80":81,"_82":83,"_84":85,"_86":87,"_88":89,"_90":91},"itemId","s5egftxgd4pzsuybtmy9c5i8d","Forever Security 披露 Cursor、Copilot、Codex、VS Code 与 Claude Desktop 内置浏览器漏洞","Forever Security 披露五款 AI 编程助手内置浏览器均违反隔离规则：Cursor 可在开发者一次按键后执行攻击者命令，Copilot 可伪造地址栏，Codex、VS Code 和 Claude Desktop 的单个本地页面可越界读取磁盘。","sourceName","Help Net Security","sourceUrl","https://www.helpnetsecurity.com/2026/10/29/research-ai-assistant-browser-vulnerabilities/","publishedAt","2026-10-29T14:10:49.000Z","sourceIconUrl","/dailyinfo/media/06c9ab9de6dbb6a5.webp","sourceIconSrcSet","/dailyinfo/media/9c1b5fa87b3bafc5.webp 48w, /dailyinfo/media/06c9ab9de6dbb6a5.webp 96w","firstParty",false,"available",true,"研究与披露","研究聚焦 PHP 远程代码执行、浏览器沙箱逃逸及 AI 服务中的恶意链接利用链。",[95,96,97],{"_74":114,"_21":115,"_70":116,"_78":117,"_80":118,"_82":119,"_84":120,"_86":121,"_88":89,"_90":91},{"_74":106,"_21":107,"_70":108,"_78":109,"_80":110,"_82":111,"_84":112,"_86":113,"_88":89,"_90":91},{"_74":98,"_21":99,"_70":100,"_78":101,"_80":102,"_82":103,"_84":104,"_86":105,"_88":89,"_90":91},"dovg5xscowbmox2u6l6m2s1lp","Parameter 揭示恶意 ChatGPT 分享链接代码执行漏洞利用链","Parameter 揭示恶意 ChatGPT 分享链接可在已登录会话中执行攻击者代码并读取私人对话，利用链经 MathLive 跨框架消息注入原始 HTML，再借助允许的 YouTube 脚本绕过 CSP。","The Hacker News","https://thehackernews.com/2026/10/a-shared-chatgpt-link-could-run.html","2026-10-31T05:33:41.000Z","/dailyinfo/media/3d21685a726d0a64.jpg","/dailyinfo/media/a1e7de8b6809b50e.jpg 48w, /dailyinfo/media/3d21685a726d0a64.jpg 96w","xn04uir3ppltopryw25ryri8a","Orange Tsai 披露 Microsoft Edge 纯逻辑漏洞全链，实现沙箱逃逸与 ACE","Orange Tsai 披露其在 Pwn2Own Berlin 2026 构建的 Microsoft Edge 全链，通过 5 个逻辑漏洞和 2 项 Windows 功能实现沙箱逃逸并获得 $175,000 与 17.5 Master of Pwn points。","DevCo","https://devco.re/blog/2026/10/28/the-last-proof-of-human-craft-forging-a-microsoft-edge-full-chain-with-logic-bugs-only-en/","2026-10-28T00:00:00.000Z","/dailyinfo/media/2dc02bf3e82fea5c.webp","/dailyinfo/media/c6f49a1ce8c8f0d9.webp 48w, /dailyinfo/media/2dc02bf3e82fea5c.webp 96w","nvjhxml6qmgj1n5fihl71npjw","php2shell 技术分析：PHP 两个 RCE 生命周期漏洞 CVE-2026-109618 与 CVE-2026-109619","php2shell 技术分析拆解了 PHP 的两个未经认证 RCE 漏洞，CVE-2026-109618 和 CVE-2026-109619 均为 CVSS v4.0 9.2，前者源于 OOM 中断后的内存破坏，后者源于跨请求的陈旧全局状态。","OffSec","https://www.offsec.com/blog/php2shell-anatomy-of-two-php-lifecycle-bugs/","2026-10-28T20:07:17.000Z","/dailyinfo/media/00e7f80d0fd7a26d.webp","/dailyinfo/media/f8be55c07177824b.webp 48w, /dailyinfo/media/00e7f80d0fd7a26d.webp 96w","攻击与威胁","攻击活动横跨云服务、开发扩展、企业协作与加密资产，并借助 AI 工具和定制僵尸网络扩大影响。",[125,126,127,128,129,130,131,132,133,134,135],{"_74":34,"_21":22,"_70":198,"_78":79,"_80":199,"_82":200,"_84":85,"_86":87,"_88":89,"_90":91},{"_74":190,"_21":191,"_70":192,"_78":193,"_80":194,"_82":195,"_84":196,"_86":197,"_88":89,"_90":91},{"_74":184,"_21":185,"_70":186,"_78":187,"_80":188,"_82":189,"_84":-5,"_88":89,"_90":91},{"_74":179,"_21":180,"_70":181,"_78":101,"_80":182,"_82":183,"_84":104,"_86":105,"_88":89,"_90":91},{"_74":174,"_21":175,"_70":176,"_78":101,"_80":177,"_82":178,"_84":104,"_86":105,"_88":89,"_90":91},{"_74":169,"_21":170,"_70":171,"_78":101,"_80":172,"_82":173,"_84":104,"_86":105,"_88":89,"_90":91},{"_74":163,"_21":164,"_70":165,"_78":166,"_80":167,"_82":168,"_84":-5,"_88":89,"_90":91},{"_74":155,"_21":156,"_70":157,"_78":158,"_80":159,"_82":160,"_84":161,"_86":162,"_88":89,"_90":91},{"_74":150,"_21":151,"_70":152,"_78":79,"_80":153,"_82":154,"_84":85,"_86":87,"_88":89,"_90":91},{"_74":142,"_21":143,"_70":144,"_78":145,"_80":146,"_82":147,"_84":148,"_86":149,"_88":89,"_90":91},{"_74":136,"_21":137,"_70":138,"_78":139,"_80":140,"_82":141,"_84":-5,"_88":89,"_90":91},"kh5zbp42tkmy1pgddvyma6sb0","zkLink 遭攻击损失约 78.3 万美元，Arbitrator 合约验证逻辑被绕过","跨链协议 zkLink 于 2026 年 10 月 29 日遭攻击，损失约 78.3 万美元。","慢雾科技","https://mp.weixin.qq.com/s?__biz=MzU4ODQ3NTM2OA==&mid=2247506498&idx=1&sn=a7646de265d6c5c01cf91b8b5cb91480","2026-10-30T11:20:00.000Z","f1ouf60ewvurduuj73co4r1ov","LodaRAT 以伪造美国法院通知钓鱼，已针对逾 100,000 家企业","LodaRAT 通过冒充美国佛罗里达南区联邦地区法院的替代性争议解决案件通知，针对超过 100,000 家企业投放恶意软件。诱导页面仅向使用 Microsoft Edge 的访客展示内容，下载的密码保护压缩文件包含 MSC、批处理和 Windows 快捷方式三种文件，任一文件执行后均从 us.wind0ws.net 下载同一恶意软件。","Hackread","https://hackread.com/fake-us-court-notices-target-businesses-lodarat/","2026-10-28T10:04:16.000Z","/dailyinfo/media/dd06beac4cadc6f3.webp","/dailyinfo/media/47417cbef4636b7b.webp 48w, /dailyinfo/media/dd06beac4cadc6f3.webp 96w","gu6ue1ilx7hnlwxcatqdphg4v","自称 Department of Peace 的黑客泄露逾 41,000 名 DHS 员工记录","自称 Department of Peace 的黑客组织泄露了超过 41,000 名美国国土安全部（DHS）员工的姓名、办公室、联系方式和任务信息，并交由 Distributed Denial of Secrets 发布为 Icepick；该组织称数据取自 DHS 使用的 Okta SSO 服务，Okta 否认其系统被攻破。","https://www.helpnetsecurity.com/2026/10/29/icepick-dhs-leak-ice-undercover-agents/","2026-10-29T10:16:18.000Z","m8vt0mfprflyha4qd0f1jbnwd","VAPOR PANDA 使用 ARTEX 与 DeepSeek 并行入侵全球 200 多家组织","CrowdStrike 披露 VAPOR PANDA 自 2026 年 10 月 17 日起使用 ARTEX 和 DeepSeek 等 LLM，在 11 天内针对至少 14 个国家的 200 多家组织并行入侵。","CrowdStrike","https://www.crowdstrike.com/en-us/blog/vapor-panda-uses-artex-to-scale-global-campaign/","2026-10-29T05:00:00.000Z","/dailyinfo/media/4bb18fbefa568e31.webp","/dailyinfo/media/f338ab1b3d8b6c40.webp 48w, /dailyinfo/media/4bb18fbefa568e31.webp 96w","g1yjx90drqjyvf0az6cq04rgs","CNCERT 监测发现 VeilDHT 僵尸网络大范围感染 Linux 服务器与 IoT 设备","CNCERT 监测发现新型僵尸网络 VeilDHT 正通过漏洞利用大范围传播，主要感染 Linux 服务器与 IoT 设备，2026年10月16日至26日境内累计感染40467台，日上线肉鸡最高15805台。","国家互联网应急中心CNCERT","https://mp.weixin.qq.com/s?__biz=MzIwNDk0MDgxMw==&mid=2247502483&idx=1&sn=8c430cd390f5dca61798eb26b1aa9b7e","2026-10-30T11:59:00.000Z","vuvau9rjn8ik414g6xpi91tx9","攻击者利用 Microsoft Teams 冒充 IT 支持，部署 GoGRPC 后门与 Chaos 勒索软件","攻击者利用 Microsoft Teams 外部聊天冒充 IT 支持，结合邮件轰炸诱导受害者授予远程访问权限，并部署 GoGRPC 后门、Chaos 勒索软件。攻击主要针对启用外部访问的组织，已导致横向移动至域控制器、数据外传及勒索软件投放；Arctic Wolf 建议结合端点与身份遥测进行监测。","https://thehackernews.com/2026/10/attackers-use-microsoft-teams-it.html","2026-10-26T15:52:40.000Z","kap6lzk1o51rm638fm4tiscnh","攻击者尝试利用 Alpine Linux GitLab 的 CVE-2026-97229 漏洞，CVSS 10.0","攻击者试图利用 Alpine Linux 自有 GitLab 服务器的 CVE-2026-97229 漏洞，该漏洞 CVSS 10.0，可通过构造的 CI 正则表达式在特定条件下执行代码。","https://thehackernews.com/2026/10/attacker-tried-to-exploit-alpine-linuxs.html","2026-10-29T09:05:39.000Z","vjdhd6f9hgfqlc9p5znn3m95n","Cursor Marketplace 上架的 Claude Code 扩展被植入持久化 SSH 后门","Cursor Marketplace 中被篡改的官方 Claude Code VS Code 扩展会安装持久化 SSH 后门，影响至多 5,000 名用户。","https://thehackernews.com/2026/10/official-claude-code-vs-code-extension.html","2026-10-30T08:55:47.000Z","zwh7qiot8b8294xdoeg7i356t","GMO旗下Onamae云桌面服务遭入侵，最多26,739台服务器被植入恶意软件","GMO旗下Onamae云桌面服务遭网络攻击，最多26,739名客户的服务器被植入恶意软件，客户支付信息未泄露，但MT4/MT5登录凭证及交易账号信息可能暴露。攻击者窃取数据后索要高达80亿日元赎金，并威胁启动已植入的勒索软件载荷。GMO关闭相关服务器并敦促客户断网关机、重置密码和终止会话；目前尚未发现客户电脑上的勒索软件被激活。","安全内参","https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&mid=2247516790&idx=1&sn=436349113ffe5d99176da6bb6dda7b23","2026-10-28T09:20:00.000Z","n8ley102n83kjrh7ne1s1q0wy","Volt Typhoon 利用 Silent Train 框架隐藏零日漏洞攻击","Volt Typhoon 使用 Silent Train 中继框架，通过境外 VPS、被入侵的路由器及其他设备隐藏攻击来源，并利用至少 4 个零日漏洞攻击电信、政府、国防承包商、公用事业、卫星服务、航空等高价值目标。","BleepingComputer","https://www.bleepingcomputer.com/news/security/volt-typhoon-hides-zero-day-attacks-using-silent-train-framework/","2026-10-28T16:00:00.000Z","/dailyinfo/media/198a4d86de90e233.webp","/dailyinfo/media/3a544a742516b0af.webp 48w, /dailyinfo/media/198a4d86de90e233.webp 96w","Binance 约 63 亿美元加密货币被盗，TRM Labs 与 Chainalysis 均高置信度将攻击归因于朝鲜组织 TraderTraitor。初步调查显示，攻击者可能从一台被攻陷的 DevOps 工程师笔记本进入服务容器，提交未授权提现交易，并攻陷热钱包签名基础设施；Ethereum 上涉及 50 个预先签署的授权。","https://www.helpnetsecurity.com/2026/10/30/binance-crypto-hack/","2026-10-30T08:26:13.000Z","漏洞与在野利用","已确认的利用集中在网络设备、Linux 内核和压缩解码器，未认证攻击与本地提权仍是主要风险。",[204,205,206,207,208],{"_74":229,"_21":230,"_70":231,"_78":232,"_80":233,"_82":234,"_84":-5,"_88":91,"_90":91},{"_74":224,"_21":225,"_70":226,"_78":193,"_80":227,"_82":228,"_84":196,"_86":197,"_88":89,"_90":91},{"_74":219,"_21":220,"_70":221,"_78":193,"_80":222,"_82":223,"_84":196,"_86":197,"_88":89,"_90":91},{"_74":214,"_21":215,"_70":216,"_78":193,"_80":217,"_82":218,"_84":196,"_86":197,"_88":89,"_90":91},{"_74":209,"_21":210,"_70":211,"_78":193,"_80":212,"_82":213,"_84":196,"_86":197,"_88":89,"_90":91},"midioamfhtgq777zsyrovhu36","Android CVE-2026-58882“短信死亡”漏洞分析与 PoC 复现","安全研究员 Mark Blah 披露 Android CVE-2026-58882 的 PoC，可通过特制 WAP Push 短信远程触发拒绝服务，导致通话中断。","https://www.bleepingcomputer.com/news/security/new-android-sms-of-death-exploit-can-remotely-crash-unpatched-phones/","2026-10-31T15:35:11.000Z","obhfumhh687s8ss7ottgn00g5","CISA 警告 Linux 内核 Fragnesia 漏洞 CVE-2026-46300 已与 PHP2Shell 在野利用","CISA 警告 Fragnesia Linux 内核提权漏洞 CVE-2026-46300 已与 PHP2Shell 漏洞（CVE-2026-109618、CVE-2026-109619）在野利用，可植入 PHP webshell 并以 root 权限运行命令。","https://www.bleepingcomputer.com/news/security/cisa-warns-of-fragnesia-linux-flaw-chained-in-php2shell-attacks/","2026-10-29T13:59:48.000Z","jtfc7xy2x7a2pqxrr0ivv2g1k","CISA确认攻击者正在利用Brotli漏洞CVE-2026-111497","攻击者正在利用Brotli远程代码执行漏洞CVE-2026-111497。该严重漏洞源于Brotli解码器的越界写入，未认证攻击者可利用恶意压缩流造成崩溃、内存泄露或RCE。CISA已将其纳入KEV，要求美国联邦机构在11月10日前完成修复，并建议其他网络防守者优先打补丁，无法立即更新的系统可阻断入站Brotli压缩请求或禁用该解码功能。","https://www.bleepingcomputer.com/news/security/cisa-warns-of-hackers-now-exploiting-critical-node2shell-flaw/","2026-10-28T10:46:23.000Z","o4jhgucdw0y08zpd9xy9goxcn","Linux 内核 CVE-2026-98432 可导致 MPTCP 服务器远程 root 提权","Anthropic 研究人员利用 CVE-2026-98432 实现了针对启用 MPTCP 监听器的 Linux 服务器的远程 root 代码执行。该漏洞是 Linux 内核 IPv4 TCP 网络代码中的 use-after-free 与竞态条件问题，CVSS 9.8，也影响普通 TCP 连接；其利用需要触发竞态，Red Hat 将其评为 5.9 并认为可能导致内核崩溃。","https://www.bleepingcomputer.com/news/security/critical-linux-kernel-flaw-allows-remote-root-attacks-on-mptcp-servers/","2026-10-30T21:09:46.000Z","gz5wepydgx19541hqwvty4syk","Cisco ASA 与 FTD 远程访问 SSL VPN 隧道 DoS 漏洞 CVE-2026-76418 已被利用","Cisco ASA Software 与 FTD Software 的远程访问 SSL VPN 隧道存在 CVE-2026-76418，未认证远程攻击者可在隧道组启用二次认证时发送特制请求，触发设备意外重载并造成拒绝服务（DoS）；成功发起 VPN 登录并非必要条件。","Cisco PSIRT","https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-asaftd-tunnel-dos-s6mgkb75?vs_f=Cisco%20Security%20Advisory%26vs_cat=Security%20Intelligence%26vs_type=RSS%26vs_p=Cisco%20Secure%20Firewall%20Adaptive%20Security%20Appliance%20and%20Secure%20Firewall%20Threat%20Defense%20Software%20Remote%20Access%20SSL%20VPN%20Tunnel%20Denial%20of%20Service%20Vulnerability%26vs_k=1","2026-10-28T11:15:00.000Z",{"_74":190,"_21":191,"_70":192,"_78":193,"_80":194,"_82":195,"_84":196,"_86":197,"_88":89,"_90":91},{"_74":114,"_21":115,"_70":116,"_78":117,"_80":118,"_82":119,"_84":120,"_86":121,"_88":89,"_90":91},{"_74":106,"_21":107,"_70":108,"_78":109,"_80":110,"_82":111,"_84":112,"_86":113,"_88":89,"_90":91},"leadParagraph",{"_240":241,"_242":-5},"changelogVersion","2026-10-01T08:00","release"]
