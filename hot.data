[{"_1":2,"_3":4},"root",{"_5":264},"routes/hot",{"_5":6},"data",{"_7":8,"_9":10},"hot",{"_11":12,"_13":14,"_15":16},"expiresAt",1793621444000,"computedAt","2026-11-02T12:05:30.761Z","windowHours",48,"entries",[17,18,19,20,21],{"_22":218,"_24":219,"_26":220,"_28":143,"_30":221,"_32":222,"_34":155,"_36":155,"_37":223,"_39":224,"_41":225,"_43":226,"_45":227,"_47":228},{"_22":35,"_24":185,"_26":186,"_28":143,"_30":187,"_32":188,"_34":96,"_36":96,"_37":189,"_39":190,"_41":191,"_43":192,"_45":193,"_47":194},{"_22":140,"_24":141,"_26":142,"_28":143,"_30":144,"_32":145,"_34":140,"_36":140,"_37":146,"_39":147,"_41":148,"_43":149,"_45":150,"_47":151},{"_22":96,"_24":97,"_26":98,"_28":29,"_30":99,"_32":100,"_34":35,"_36":35,"_37":101,"_39":102,"_41":103,"_43":104,"_45":105,"_47":-5},{"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":35,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48},"rank",5,"story",{"_92":93,"_94":95},"heat",7,"trend","down","trendPct",-15.7,"badges",[],"participantCount",2,"sourceCount","sourceNames",[89,82],"participants",[79,80],"spark",[55,56,57,58,59,60,61,62,63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,27],"summary","Polymarket确认第三方网站性能监控服务DebugBear分发的脚本被篡改，攻击者利用登录用户会话卖出持仓并转移资产；链上分析机构Betting Intelligence和Polysights估计710个钱包损失约270万美元，实际损失及赔付范围尚未由平台完整确认。\n\n受影响条件是用户在攻击短窗口内打开过Polymarket。DebugBear称初步调查显示仅Polymarket的客户脚本被替换，尚未发现其自身系统遭入侵；独立美国平台未受影响。Polymarket已移除恶意代码、暂停交易并重置登录会话，并称截至周五下午95%的受影响钱包已获退款。事件未涉及智能合约入侵。","latest","攻击者劫持 Polymarket 第三方脚本，窃取交易者约 $2.7 million","cover",{"_49":50,"_51":52,"_53":-5,"_54":-5},"url","/dailyinfo/media/ddeb638b3e7a58d0.jpg","srcSet","/dailyinfo/media/8dd5fa606986c875.jpg 720w, /dailyinfo/media/b8990aafe25d7715.jpg 1200w, /dailyinfo/media/ddeb638b3e7a58d0.jpg 1600w","width","height",14.1,13.7,13.3,12.9,12.5,12.2,11.8,11.5,11.2,10.9,10.5,10.2,10,9.7,9.4,9.1,8.9,8.6,8.4,8.1,7.9,7.7,7.5,7.2,{"_81":89,"_83":84,"_85":90,"_87":91},{"_81":82,"_83":84,"_85":86,"_87":88},"name","Hackread","kind","editorial","iconUrl","/dailyinfo/media/dd06beac4cadc6f3.webp","iconSrcSet","/dailyinfo/media/47417cbef4636b7b.webp 48w, /dailyinfo/media/dd06beac4cadc6f3.webp 96w","The Hacker News","/dailyinfo/media/3d21685a726d0a64.jpg","/dailyinfo/media/a1e7de8b6809b50e.jpg 48w, /dailyinfo/media/3d21685a726d0a64.jpg 96w","publicId","b40ce903-e6e2-4df6-be78-7db6e9efa397","title","DebugBear脚本被篡改，Polymarket损失约270万美元",4,{"_92":138,"_94":139},7.8,-16.1,[],[135,132],[130,131],[106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,98],"安全研究员 Mark Blah（另篇报道称 Mark Blaszczyk）公开了 Android CVE-2026-58882 的概念验证利用代码：攻击者可从另一台 Android 设备发送特制 WAP Push 短信，零点击触发 WapPushOverSms.decodeWapPdu 远程拒绝服务，阻断电话服务，包括紧急呼叫。PoC 已证实可复现，但尚无已确认受害数量；研究称单条消息可引发最长一周的间歇性崩溃，约二十条可使设备长期不可用。\n\nGoogle 据报已在 2026 年 10 月的 Android 安全更新中修复 Android 14 至 17，并删除恶意短信以避免反复崩溃；报道指 Android 12 和 13 未收到修复、仍可能受影响。不过，另一篇报道称漏洞代码在 Android 12 至 17 均存在，显示受影响代码范围与实际修复范围存在差异。","Android SMS of Death 漏洞分析：CVE-2026-58882 可用零点击 WAP Push 消息阻断电话服务",5.5,5.4,14.7,14.3,13.9,13.5,13.1,12.8,12.4,12.1,11.7,11.4,11,10.7,10.4,10.1,9.8,9.6,9.3,9,8.8,8.5,8.3,8,{"_81":135,"_83":84,"_85":136,"_87":137},{"_81":132,"_83":84,"_85":133,"_87":134},"BleepingComputer","/dailyinfo/media/198a4d86de90e233.webp","/dailyinfo/media/3a544a742516b0af.webp 48w, /dailyinfo/media/198a4d86de90e233.webp 96w","Security Affairs","/dailyinfo/media/ef2b2b57fb06e54f.webp","/dailyinfo/media/2adef5b1e4357a03.webp 48w, /dailyinfo/media/ef2b2b57fb06e54f.webp 96w","c5486508-cdc6-495f-b2ad-9788dc5a009f","Android短信拒绝服务漏洞PoC公开",3,{"_92":183,"_94":184},22.1,"up",245.3,[182],[179,132,135],[176,177,178],[154,155,156,157,106,107,158,159,160,161,162,163,164,165,166,96,167,168,169,170,171,172,173,174,175],"CISA已确认Ivanti Connect Secure的CVE-2026-111357（关键功能缺失认证）和CVE-2026-118527（可预测数字或标识符生成漏洞）被在野利用并纳入KEV目录；Ivanti已发布修复版本25.1.1.3和22.8R2.6，分别修复25.1.1.2及更早版本、22.8R2.5及更早版本中的上述漏洞，攻击链涉及漏洞均已有补丁。\n\nVolexity称，UTA0576自2026年10月3日起将这两项漏洞与鉴权绕过漏洞CVE-2026-104935（CVSS 8.6）串联，在运行22.8R2.4的设备上利用认证绕过、远程代码执行和提权漏洞获取未认证root权限，并提取凭据、有限的Active Directory元数据、Windows LAPS密码和BitLocker恢复密钥；已知受影响客户数量有限。10月13日发布的25.1.1.2和22.8R2.5不能修复这两项漏洞。\n\nCISA要求FCEB机构分别在2026年11月2日和11月13日前修复，并按BOD 26-04在打补丁前检查系统是否遭入侵；Volexity称相关活…","Ivanti Connect Secure 三个零日漏洞已被链式利用，CVE-2026-111357 与 CVE-2026-118527 纳入 KEV",{"_49":152,"_51":153,"_53":-5,"_54":-5},"/dailyinfo/media/30a53bd4e708039e.jpg","/dailyinfo/media/2ffcc4275676d592.jpg 720w, /dailyinfo/media/9b5ccbd87b94f8a8.jpg 1200w, /dailyinfo/media/30a53bd4e708039e.jpg 1600w",6.2,6,5.9,5.7,5.2,5.1,4.9,4.8,4.7,4.5,4.4,4.3,4.2,3.9,3.8,3.7,3.6,3.5,3.4,3.3,3.2,22.2,{"_81":179,"_83":84,"_85":180,"_87":181},{"_81":132,"_83":84,"_85":133,"_87":134},{"_81":135,"_83":84,"_85":136,"_87":137},"Rapid7 CVE 公告","/dailyinfo/media/092fbeae5b5c3123.webp","/dailyinfo/media/c16323cf53c574df.webp 48w, /dailyinfo/media/092fbeae5b5c3123.webp 96w","rising","7b68ec92-29a4-4b08-8b7d-6c1631d5b488","Ivanti三项零日漏洞被串联利用",{"_92":216,"_94":217},30.7,411.7,[215],[212,209,135,132],[205,206,207,208],[121,122,123,124,125,126,127,128,129,98,197,198,78,27,199,200,201,154,155,156,157,106,202,203,204],"Chainalysis确认，外部攻击者于10月使用其称为“进攻性智能体技术”的方式越权进入公司系统及内部工具，访问了部分平台用户的用户ID、完整姓名、电子邮箱和组织角色标签；公司正在修补漏洞并强化系统，但未披露具体漏洞、修复版本、受损系统、访问时长或完整影响范围。\n\nChainalysis称，现有调查未发现调查图表、笔记、案件、交易或查询结果，以及明文密码、MFA密钥和用户会话令牌遭未授权访问，因此客户账号应仍然安全。其尚未说明攻击是否使用ARTEX等现成框架或自主定制AI智能体，并称此次事件与近期Binance入侵无关。","Chainalysis 遭外部攻击者入侵，部分客户身份信息被访问",{"_49":195,"_51":196,"_53":-5,"_54":-5},"/dailyinfo/media/695ea7c2253662e8.webp","/dailyinfo/media/61d9faf612bae75c.webp 720w, /dailyinfo/media/4b7390ea91991e47.webp 1200w, /dailyinfo/media/695ea7c2253662e8.webp 1600w",7.6,7.4,6.8,6.6,6.4,24.8,24.1,33.3,{"_81":212,"_83":84,"_85":213,"_87":214},{"_81":209,"_83":84,"_85":210,"_87":211},{"_81":135,"_83":84,"_85":136,"_87":137},{"_81":132,"_83":84,"_85":133,"_87":134},"Infosecurity Magazine","/dailyinfo/media/b3cc9cd29f272a5a.webp","/dailyinfo/media/6406d1b57afc7303.webp 48w, /dailyinfo/media/b3cc9cd29f272a5a.webp 96w","Help Net Security","/dailyinfo/media/06c9ab9de6dbb6a5.webp","/dailyinfo/media/9c1b5fa87b3bafc5.webp 48w, /dailyinfo/media/06c9ab9de6dbb6a5.webp 96w","surge","038a18c5-a6fe-4fe6-89fe-22bf5ade225b","Chainalysis确认智能体化入侵事件",1,{"_92":262,"_94":263},40.6,58,[182],[209,212,132,135,82,89],[256,257,258,259,260,261],[231,232,233,234,235,236,237,238,239,240,241,242,243,244,245,246,247,248,249,250,251,252,253,254,255],"FBI确认朝鲜支持的组织TraderTraitor于2026年10月29日前后从Binance窃取价值64.3亿美元的加密资产，并称攻击者通过遭入侵的DevOps工程师笔记本进入服务容器，提交未授权提现交易。FBI、美国特勤局和IRS-CI已公布628个相关地址，要求加密企业、交易所、区块链运营商及虚拟资产服务商拦截相关及衍生资金交易。\n\nFBI称赃款涉及11条区块链，82%位于以太坊和比特币网络，攻击者主要将资产转换为ETH，并通过DeFi和即时兑换服务洗钱。Tether、Circle、Ripple、Arbitrum和Optimism已链上冻结28.5亿美元；Binance称经执法部门、代币发行方及行业伙伴协作，已核实冻结约30亿美元，并以自有资金补偿约95%的受影响金额。关于涉及链数量和金额，早先报道另称10条、约63.6亿美元，FBI后续表述为11条、64.3亿美元。Elliptic称约29亿美元已被冻结或查获，仍有近33亿美元不在发行方控制范围内，并称攻击涉及多人且使用了销毁工具和痕迹的“自毁机制”。Binance表示尚未发现钱包私钥被窃…","FBI 归因 North Korea 的 TraderTraitor 窃取 Binance 超过 $6bn 加密资产",{"_49":229,"_51":230,"_53":-5,"_54":-5},"/dailyinfo/media/5250e093d3b2ab04.webp","/dailyinfo/media/a9faf2975ac56b42.webp 720w, /dailyinfo/media/ef89c05c9c9e4bcd.webp 1200w, /dailyinfo/media/5250e093d3b2ab04.webp 1600w",18.4,17.8,17.3,16.8,16.4,15.9,15.4,15,14.6,33.4,32.5,31.5,30.6,29.8,28.9,28.1,27.3,26.5,25.8,25,24.3,23.6,23,41.9,40.7,{"_81":209,"_83":84,"_85":210,"_87":211},{"_81":212,"_83":84,"_85":213,"_87":214},{"_81":132,"_83":84,"_85":133,"_87":134},{"_81":135,"_83":84,"_85":136,"_87":137},{"_81":82,"_83":84,"_85":86,"_87":88},{"_81":89,"_83":84,"_85":90,"_87":91},"6ef2ec24-f871-4ca2-9cc2-5fcbd249af24","FBI归因TraderTraitor窃取Binance资产",{"_265":266,"_267":-5},"changelogVersion","2026-10-01T08:00","release"]
