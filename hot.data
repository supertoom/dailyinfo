[{"_1":2,"_3":4},"root",{"_5":278},"routes/hot",{"_5":6},"data",{"_7":8,"_9":10},"hot",{"_11":12,"_13":14,"_15":16},"expiresAt",1795912653000,"computedAt","2026-11-29T00:30:33.111Z","windowHours",48,"entries",[17,18,19,20,21,22,23],{"_24":239,"_26":240,"_28":241,"_30":31,"_32":242,"_34":243,"_36":110,"_38":110,"_39":244,"_41":245,"_43":246,"_45":247,"_47":248,"_49":249},{"_24":37,"_26":215,"_28":216,"_30":31,"_32":217,"_34":218,"_36":143,"_38":143,"_39":219,"_41":220,"_43":221,"_45":222,"_47":223,"_49":-5},{"_24":148,"_26":180,"_28":181,"_30":31,"_32":86,"_34":182,"_36":37,"_38":37,"_39":183,"_41":184,"_43":185,"_45":186,"_47":187,"_49":188},{"_24":143,"_26":144,"_28":145,"_30":31,"_32":146,"_34":147,"_36":148,"_38":148,"_39":149,"_41":150,"_43":151,"_45":152,"_47":153,"_49":154},{"_24":110,"_26":111,"_28":67,"_30":31,"_32":112,"_34":113,"_36":37,"_38":37,"_39":114,"_41":115,"_43":116,"_45":117,"_47":118,"_49":-5},{"_24":29,"_26":84,"_28":85,"_30":31,"_32":86,"_34":87,"_36":37,"_38":37,"_39":88,"_41":89,"_43":90,"_45":91,"_47":92,"_49":93},{"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":37,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50},"rank",7,"story",{"_80":81,"_82":83},"heat",6,"trend","down","trendPct",-16.7,"badges",[],"participantCount",2,"sourceCount","sourceNames",[76],"participants",[74],"spark",[57,58,59,60,61,62,63,-5,-5,-5,-5,-5,-5,-5,-5,64,65,66,67,68,69,70,71,72,73],"summary","黑产团伙批量仿冒DeepSeek官网并借搜索广告投放恶意安装包，诱导用户下载桌面客户端；已有用户中招并出现电脑被远控、微信被盗后群发垃圾消息并封禁的症状，但“银狐”木马身份仍主要来自网友怀疑和媒体报道，受影响数量尚无统计。\n\n新增个案显示，部分用户在手机热点下安装后数小时内异常消耗约200GB流量，还有人发现文件消失或硬盘被格式化。报道指出，DeepSeek官网为deepseek.com、网页对话入口为chat.deepseek.com，其他“DeepSeek下载站”均需警惕。报道未说明恶意安装包版本、漏洞编号、修复版本或补丁状态。","latest","高仿 DeepSeek 官网批量投毒，安装包可导致远控、盗号和流量劫持","cover",{"_51":52,"_53":54,"_55":-5,"_56":-5},"url","/api/img-proxy?u=https%3A%2F%2Fwechat2rss.xlab.app%2Fimg-proxy%2F%3Fk%3D65c6fa24%26amp%3Bu%3Dhttps%253A%252F%252Fmmbiz.qpic.cn%252Fmmbiz_jpg%252Fg5KiabmYVDH36jPgLf2yu4rCZqNfDqSkIpOycn