ailyinfo/media/2c1dfe771be3346e.jpg 1200w, /dailyinfo/media/a43d1e058d97ee17.jpg 1600w","width","height","caption",{"_185":255,"_57":256,"_188":257,"_190":258,"_192":259,"_194":260,"_196":261,"_198":262,"_200":201,"_202":203,"_204":50,"_263":264,"_205":83},{"_185":247,"_57":248,"_188":249,"_190":250,"_192":251,"_194":252,"_196":253,"_198":254,"_200":201,"_202":203,"_205":77},{"_185":242,"_57":243,"_188":244,"_190":229,"_192":245,"_194":246,"_196":232,"_198":233,"_200":201,"_202":203},{"_185":234,"_57":235,"_188":236,"_190":237,"_192":238,"_194":239,"_196":240,"_198":241,"_200":201,"_202":203},{"_185":226,"_57":227,"_188":228,"_190":229,"_192":230,"_194":231,"_196":232,"_198":233,"_200":201,"_202":203,"_204":52},{"_185":220,"_57":221,"_188":222,"_190":223,"_192":224,"_194":225,"_196":-5,"_200":201,"_202":203},{"_185":212,"_57":213,"_188":214,"_190":215,"_192":216,"_194":217,"_196":218,"_198":219,"_200":201,"_202":203},{"_185":206,"_57":207,"_188":208,"_190":209,"_192":210,"_194":211,"_196":-5,"_200":201,"_202":203},{"_185":186,"_57":187,"_188":189,"_190":191,"_192":193,"_194":195,"_196":197,"_198":199,"_200":201,"_202":203,"_204":50,"_205":74},"itemId","hbjgrefhm6gdjv6nmh92104zs","Barracuda 两漏洞 CVE-2026-116606 与 CVE-2026-111560 已被用于攻击","summary","攻击者已在少量组织中利用 Barracuda 刚修复的 CVE-2026-116606 和 CVE-2026-111560，组合利用可绕过授权控制并取得设备 root 权限。","sourceName","SecurityWeek","sourceUrl","https://www.securityweek.com/recently-patched-barracuda-vulnerabilities-exploited-in-attacks/","publishedAt","2026-11-11T07:53:51.000Z","sourceIconUrl","/dailyinfo/media/6f21a015ea489b81.webp","sourceIconSrcSet","/dailyinfo/media/c2a91b85de7bb9d6.webp 48w, /dailyinfo/media/6f21a015ea489b81.webp 96w","firstParty",false,"available",true,"otherSources","followUp","v31fconsep72j9z4e4u5rvvw4","CSC Telecom 欧洲电信数据泄露暴露 Swedbank、SEB、airBaltic 等机构客户端信息","CSC Telecom 发生大规模数据泄露，暴露了125 million text messages，受影响对象包括 Swedbank、SEB、应急服务机构、airBaltic 以及数十家零售商。现有材料仅说明泄露内容和规模，未提供泄露原因、暴露数据字段或处置进展。","Cybernews","https://cybernews.com/security/csc-telecom-leaks-swedbank-seb-sms-messages/","2026-11-11T09:00:02.000Z","xo3px77vo84m1faxu5nie5ooc","DarkSword、Coruna 利用广告和失陷网站攻击 iPhone 员工","iVerify 的 2026 年移动威胁报告称，攻击者利用泄露的 DarkSword 和 Coruna exploit kit，通过 Instagram 广告、金融与加密货币仿冒网站感染使用 iPhone 工作的员工。","Help Net Security","https://www.helpnetsecurity.com/2026/11/11/iverify-iphone-exploit-kit-attacks-report/","2026-11-11T05:00:34.000Z","/dailyinfo/media/06c9ab9de6dbb6a5.webp","/dailyinfo/media/9c1b5fa87b3bafc5.webp 48w, /dailyinfo/media/06c9ab9de6dbb6a5.webp 96w","r2546h3tkbdqveqaoamsqyjys","Microsoft FORGE Lab 复盘 AI 扫描发现 59 个 Linux 内核漏洞","Microsoft FORGE Lab 使用代号 MDASH 的 AI 扫描系统研究 Linux 内核，3 个月产出 59 个公开上游报告和 33 个已分配 CVE，其中 8 个 CVE 已验证本地提权利用，38 个报告的修复已合并主线。","Microsoft Security Blog","https://www.microsoft.com/en-us/security/blog/2026/11/11/lessons-from-59-linux-kernel-bug-reports/","2026-11-11T16:55:00.000Z","c25h2bq5i1snfg7uby15x9ud5","Microsoft 研究证明 AI Agent 可通过编辑少于 10 个神经元植入后门","Microsoft 研究人员提出 Lazarus，可在无需重新训练模型的情况下，通过编辑少于 10 个很少激活的神经元植入隐藏后门；攻击者需能修改模型权重，触发词出现时，模型会输出并供 Agent 执行攻击者命令。","The Hacker News","https://thehackernews.com/2026/11/microsoft-researchers-show-ai-agents.html","2026-11-11T07:21:05.000Z","/dailyinfo/media/3d21685a726d0a64.jpg","/dailyinfo/media/a1e7de8b6809b50e.jpg 48w, /dailyinfo/media/3d21685a726d0a64.jpg 96w","iwwjul6qnyiu2hvmqtlcddzue","Unit 42 披露 ARTEX 针对全球零售与咨询云环境的多起入侵活动","Unit 42 已观察攻击者利用 ARTEX 和 CyberStrikeAI 自主执行入侵，ARTEX 被用于攻击多个目标及零售、咨询等行业的客户云环境。截至 2026 年 10 月，研究团队发现 609 台互联网暴露主机运行 ARTEX、1,323 台运行 CyberStrikeAI，另有 21 台同时运行两者。","Unit 42","https://unit42.paloaltonetworks.com/artex-and-ai-powered-red-teaming-tools/","2026-11-11T23:00:53.000Z","/dailyinfo/media/4d373ddb2d54a219.webp","/dailyinfo/media/c5c35eb93d4d2e80.webp 48w, /dailyinfo/media/4d373ddb2d54a219.webp 96w","fn77p5pyn1ovua4jxfzp2n5v1","攻击者针对 Qlik Sense 服务器投递 PowerShell 反向 Shell，并准备利用 ActiveMQ 与 Veeam 漏洞","Cynet 于 2026 年 10 月在多个欧洲客户环境中发现针对 Qlik Sense 服务器的 PowerShell 反向 Shell 尝试，命令通过 scheduler.exe 执行并连接 45.115.26[.]23:4455，相关操作还为后续攻击作准备。","https://thehackernews.com/2026/11/hackers-target-qlik-sense-servers-with.html","2026-11-11T14:01:00.000Z","rxh92nsgv8wymaapqss20aa6c","OpenSSH/musl 口令认证绕过漏洞分析与修复版本对比","文章分析 OpenSSH portable 在 musl libc 且未启用 PAM 时的口令认证绕过，解释同一 TCP 连接内先失败一次后，257–1024 字节口令可绕过影子值为 * 的非 root 账户认证。","先知社区","https://xz.aliyun.com/news/93241","2026-11-10T02:16:08.000Z","/dailyinfo/media/976ac253540515ec.webp","/api/img-proxy?u=https%3A%2F%2Fxz.aliyun.com%2Ffavicon.ico&mode=avatar-48&exp=1796256000&sig=862a26438132b835 48w, /dailyinfo/media/976ac253540515ec.webp 96w","mms1km0rggfxsxggiojfrk76b","N-able 为 N-central 多个漏洞发布 N-central 2026.4 HF2 热修复","N-able 为 N-central 远程监控与管理平台多个漏洞发布 N-central 2026.4 HF2，涉及 CVE-2026-125883、CVE-2026-125878、CVE-2026-125879、CVE-2026-125880、CVE-2026-125881、CVE-2026-125882 和 CVE-2026-91000。","BleepingComputer","https://www.bleepingcomputer.com/news/security/n-able-releases-security-hotfixes-for-zero-day-vulnerabilities/","2026-11-11T12:32:27.000Z","/dailyinfo/media/198a4d86de90e233.webp","/dailyinfo/media/3a544a742516b0af.webp 48w, /dailyinfo/media/198a4d86de90e233.webp 96w","related",[265],{"_185":266,"_57":267,"_188":-5,"_190":268,"_192":269,"_194":270,"_196":271,"_198":272,"_200":201,"_202":203},"q5pk9i6wqjatjvkhjx8a5f75o","N-able 修复 N-central 7 个 CVE，33 个 Able2Shell 漏洞 PoC 已公开","Infosecurity Magazine","https://www.infosecurity-magazine.com/news/n-able-n-central-able2shell-0day/","2026-11-11T17:15:00.000Z","/dailyinfo/media/b3cc9cd29f272a5a.webp","/dailyinfo/media/6406d1b57afc7303.webp 48w, /dailyinfo/media/b3cc9cd29f272a5a.webp 96w",{"_277":347,"_188":-5,"_279":348},{"_277":295,"_188":-5,"_279":296},{"_277":287,"_188":-5,"_279":288},{"_277":278,"_188":-5,"_279":280},"label","AI 安全","items",[281],{"_185":282,"_57":283,"_188":284,"_190":250,"_192":285,"_194":286,"_196":253,"_198":254,"_200":201,"_202":203},"e1akisn9puw2q428mdfemr4p2","Claude Code、OpenClaw 与 OpenShell 路径检查后越界写入及同步投毒分析","Claude Code、OpenClaw 与 OpenShell 的文件操作均存在检查对象与实际读写对象不一致的问题。Claude Code 的 CVE-2026-103435 影响 < 2.1.129，并在 2.1.129 修复；OpenClaw v2026.2.26 可在拒绝前通过 O_TRUNC 截断或 O_CREAT 创建越界文件，v2026.3.1 将破坏性操作延后。","https://xz.aliyun.com/news/93227","2026-11-09T12:30:29.000Z","研究与披露",[289],{"_185":290,"_57":291,"_188":292,"_190":229,"_192":293,"_194":294,"_196":232,"_198":233,"_200":201,"_202":203},"dtwa818ng8oa0lmiwfqo5kf3w","Grok Build 生成应用暴露风险分析：35,578 个应用无需登录即可访问","安全公司 Claroc 发现 37,571 个由 Grok Build 生成并发布的应用中，35,578 个无需登录即可访问，约 1/10 包含内部业务或个人数据。","https://thehackernews.com/2026/11/over-35000-grok-built-apps-exposed.html","2026-11-11T12:19:40.000Z","攻击与威胁",[297,298,299,300,301,302,303,304],{"_185":150,"_57":91,"_188":344,"_190":258,"_192":345,"_194":346,"_196":261,"_198":262,"_200":201,"_202":203},{"_185":336,"_57":337,"_188":338,"_190":339,"_192":340,"_194":341,"_196":342,"_198":343,"_200":201,"_202":203},{"_185":331,"_57":332,"_188":333,"_190":191,"_192":334,"_194":335,"_196":197,"_198":199,"_200":201,"_202":203},{"_185":326,"_57":327,"_188":328,"_190":223,"_192":329,"_194":330,"_196":-5,"_200":201,"_202":203},{"_185":321,"_57":322,"_188":323,"_190":258,"_192":324,"_194":325,"_196":261,"_198":262,"_200":201,"_202":203,"_204":50},{"_185":316,"_57":317,"_188":318,"_190":229,"_192":319,"_194":320,"_196":232,"_198":233,"_200":201,"_202":203},{"_185":310,"_57":311,"_188":312,"_190":313,"_192":314,"_194":315,"_196":-5,"_200":201,"_202":203},{"_185":305,"_57":306,"_188":307,"_190":237,"_192":308,"_194":309,"_196":240,"_198":241,"_200":201,"_202":203},"yc1sadq0avsw7w3h0asnbm6v0","Unit 42 披露 Falcon 浏览器 C2 框架攻击 5 国政府机构","Unit 42 发现攻击者利用 Falcon 浏览器 C2 框架入侵至少 5 个国家政府机构的 webmail、政府应用与内部系统，窃取密码、邮件、会话 cookie、通讯和内部文档。","https://unit42.paloaltonetworks.com/falcon-c2-browser-compromise/","2026-11-11T15:00:23.000Z","qc1r9iuw591mbmk8pfatc2xbl","十余家 AI 开发者平台遭同一类攻击，Chainstack 与 WorkOS 披露凭据泄露","9 月底至 11 月初，至少十几家 AI 开发者平台遭攻击，攻击者绕过核心业务系统与第三方组件，窃取 AI 访问令牌、数据库凭据及客户信息。","安全客","https://mp.weixin.qq.com/s?__biz=MzA5ODA0NDE2MA==&mid=2649790708&idx=1&sn=7da1b66daf2243c89e4ca903b90e4a25","2026-11-10T08:52:00.000Z","hpoyhcyj8jyqis5mhai6eg4rx","eMudhra 因密钥处理缺陷撤销 8 个额外 CA，涉及 195 张证书","eMudhra 因内部 Python 脚本缺陷及密钥处理不合规，撤销此前称未受影响的 8 个中间 CA，其中 6 个签发 TLS 证书、2 个签发代码签名证书，涉及 195 张证书及 29 个自有域名证书。","https://thehackernews.com/2026/11/emudhra-revokes-8-more-cas-it.html","2026-11-11T12:00:53.000Z","w59rywovcc1gwb1eoreru2xl3","攻击者利用 AntiFox AI Agent 窃取 AWS 凭据并入侵 Web 服务","攻击者在 Alibaba Cloud 上托管自建 AntiFox 实例，利用有效 IAM 用户和 EC2 角色针对 AWS 环境及互联网暴露的 Web 服务实施漏洞利用、Webshell 部署、凭据验证、配置发现与 AWS secret 收集。","https://www.bleepingcomputer.com/news/security/hackers-use-antifox-ai-agents-in-aws-credential-theft-attacks/","2026-11-11T15:12:59.000Z","k1s00o45axh6n2j0laqjuuly7","Microsoft 披露攻击者利用 GSocket 在 Linux 服务器维持隐蔽 C2","Microsoft 观察到多个攻击活动将开源远程访问工具 GSocket 部署到遭入侵的 Linux 服务器，在初始 RCE 漏洞修复后仍通过 Global Socket Relay Network 维持访问。","https://www.microsoft.com/en-us/security/blog/2026/11/11/global-socket-how-threat-actors-weaponizing-gsocket-stealthy-c2/","2026-11-11T19:49:57.000Z","z6sqacicgu5g5kxg4eavs0p1z","攻击者利用 Openwave CVE-2026-111793 与 Cisco BroadWorks CVE-2026-20320","攻击者已利用 Openwave Webtop Media Transcoder 的 CVE-2026-111793 和 Cisco BroadWorks 的 CVE-2026-20320 窃取敏感信息。","https://www.securityweek.com/threat-actors-exploit-openwave-cisco-broadworks-vulnerabilities/","2026-11-11T09:01:07.000Z","k9g0gy54e8kqkx59naz5nvc5r","朝鲜黑客组织被指窃取 64.3 亿美元并用 meme 币洗钱","朝鲜黑客组织 TraderTraitor 被指于 2026 年 10 月 29 日从币*在 11 条区块链上的钱包抽走约 64.3 亿美元，其后通过拆分、跨链、资产互换、借贷金库、coinjoin 和 Privacy Cash 洗钱。","安全内参","https://www.secrss.com/articles/95551","2026-11-10T16:44:39.507Z","/dailyinfo/media/77459fcbf8f21e71.webp","/dailyinfo/media/3399ea7b18d18a6a.webp 48w, /dailyinfo/media/77459fcbf8f21e71.webp 96w","ConnectWise 正在调查一场针对托管服务提供商（MSP）的活跃恶意软件活动，攻击者利用遭入侵的 ScreenConnect 环境，通过 Run Command 功能向客户设备部署非法远程客户端。","https://www.bleepingcomputer.com/news/security/active-screenconnect-attacks-breach-msps-impact-dozens-of-organizations/","2026-11-11T22:56:21.000Z","漏洞与在野利用",[349,350],{"_185":359,"_57":360,"_188":361,"_190":362,"_192":363,"_194":364,"_196":365,"_198":366,"_200":201,"_202":203},{"_185":351,"_57":352,"_188":353,"_190":354,"_192":355,"_194":356,"_196":357,"_198":358,"_200":203,"_202":203},"xhmvtzol3bn8o41j00otula7s","Microsoft 披露 ASP.NET Core 权限提升漏洞 CVE-2026-114146，CVSS 9.0","Microsoft 披露 ASP.NET Core 权限提升漏洞 CVE-2026-114146，受影响平台覆盖 Windows、Linux、macOS。SignalR 连接未被一致绑定至建立连接时协商的身份，攻击者可注入消息并以受害者身份执行 Hub 调用；该漏洞严重等级为 Critical，CVSS v3.1 评分为 9.0，弱点为 CWE-863。","GitHub 安全公告","https://github.com/advisories/GHSA-67wp-ghc2-fw2g","2026-11-11T00:21:56.000Z","/dailyinfo/media/6d6a98e6b62e0bb2.webp","/dailyinfo/media/f426f4f60d806c23.webp 48w, /dailyinfo/media/6d6a98e6b62e0bb2.webp 96w","w4i7n11q7jgyy4p2xh92mfdcb","Microsoft 11月补丁修复1,090个漏洞，CVE-2026-124194已遭利用","Microsoft 11月补丁共修复约1,090个漏洞，其中CVE-2026-124194已遭利用；该Outlook欺骗漏洞需用户打开特制消息文件，可泄露NTLMv2哈希并用于冒充用户。","Security Affairs","https://securityaffairs.com/202839/hacking/microsoft-november-patch-tuesday-one-exploited-outlook-bug-and-30-wormable-flaws.html","2026-11-11T09:03:48.000Z","/dailyinfo/media/ef2b2b57fb06e54f.webp","/dailyinfo/media/2adef5b1e4357a03.webp 48w, /dailyinfo/media/ef2b2b57fb06e54f.webp 96w",{"_185":336,"_57":337,"_188":338,"_190":339,"_192":340,"_194":341,"_196":342,"_198":343,"_200":201,"_202":203},{"_185":331,"_57":332,"_188":333,"_190":191,"_192":334,"_194":335,"_196":197,"_198":199,"_200":201,"_202":203},{"_185":359,"_57":360,"_188":361,"_190":362,"_192":363,"_194":364,"_196":365,"_198":366,"_200":201,"_202":203},"leadParagraph",{"_372":373,"_374":-5},"changelogVersion","2026-10-01T08:00","release"]
