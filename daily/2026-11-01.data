://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&mid=2247516811&idx=1&sn=8ec8e6aac1f429accbd887ba2446ebc3","publishedAt","2026-10-31T00:09:00.000Z","sourceIconUrl","firstParty",false,"available",true,"followUp",{"_139":178,"_122":-5,"_141":179},{"_139":153,"_122":-5,"_141":154},{"_139":140,"_122":-5,"_141":142},"label","研究与披露","items",[143],{"_119":144,"_40":145,"_122":146,"_124":147,"_126":148,"_128":149,"_130":150,"_151":152,"_131":132,"_133":134},"dovg5xscowbmox2u6l6m2s1lp","Parameter 揭示恶意 ChatGPT 分享链接代码执行漏洞利用链","Parameter 揭示恶意 ChatGPT 分享链接可在已登录会话中执行攻击者代码并读取私人对话，利用链经 MathLive 跨框架消息注入原始 HTML，再借助允许的 YouTube 脚本绕过 CSP。","The Hacker News","https://thehackernews.com/2026/10/a-shared-chatgpt-link-could-run.html","2026-10-31T05:33:41.000Z","/dailyinfo/media/3d21685a726d0a64.jpg","sourceIconSrcSet","/dailyinfo/media/a1e7de8b6809b50e.jpg 48w, /dailyinfo/media/3d21685a726d0a64.jpg 96w","攻击与威胁",[155,156,157],{"_119":91,"_40":44,"_122":174,"_124":175,"_126":176,"_128":177,"_130":-5,"_131":132,"_133":134},{"_119":166,"_40":167,"_122":168,"_124":169,"_126":170,"_128":171,"_130":172,"_151":173,"_131":132,"_133":134},{"_119":158,"_40":159,"_122":160,"_124":161,"_126":162,"_128":163,"_130":164,"_151":165,"_131":132,"_133":134},"cyr7bz2bmyz5ecu55k6xo4e2y","Northflank 安全 breach 导致客户 AI API 密钥被滥用","Northflank 在安全 breach 后要求所有客户轮换平台内保存的环境变量、API 密钥及其他 secrets，并确认多名客户发现 AI API 密钥遭到未授权使用。","BleepingComputer","https://www.bleepingcomputer.com/news/security/northflank-security-breach-leads-to-abuse-of-customers-ai-api-keys/","2026-10-31T18:01:12.000Z","/dailyinfo/media/198a4d86de90e233.webp","/dailyinfo/media/3a544a742516b0af.webp 48w, /dailyinfo/media/198a4d86de90e233.webp 96w","l8c38b2h5meavjepjvszce1ro","VOLTA-AUTODOXER 利用 LLM 对窃取数据进行受害者价值评估","Cisco Talos 分析了自删除型 Windows 信息窃取程序 VOLTA-AUTODOXER：它采集浏览器凭据、会话、支付卡、加密钱包种子、OAuth 令牌、云端密钥、Wi-Fi 密码及截图后，将结构化证据发送至 OpenRouter，由 LLM 生成包含“WHAT THEY'RE WORTH”和“THEIR OPSEC”的受害者评估。","Cisco Talos","https://blog.talosintelligence.com/appraisal-by-ai-model-driven-victim-prioritization-in-the-volta-infostealer/","2026-10-31T12:00:00.000Z","/dailyinfo/media/cbab12e5b352b636.webp","/dailyinfo/media/79258b19df22701a.webp 48w, /dailyinfo/media/cbab12e5b352b636.webp 96w","CNCERT 监测发现新型僵尸网络 VeilDHT 正通过漏洞利用大范围传播，主要感染 Linux 服务器与 IoT 设备，2026年10月16日至26日境内累计感染40467台，日上线肉鸡最高15805台。","国家互联网应急中心CNCERT","https://mp.weixin.qq.com/s?__biz=MzIwNDk0MDgxMw==&mid=2247502483&idx=1&sn=8c430cd390f5dca61798eb26b1aa9b7e","2026-10-30T11:59:00.000Z","漏洞与在野利用",[180],{"_119":181,"_40":182,"_122":183,"_124":161,"_126":184,"_128":185,"_130":164,"_151":165,"_131":132,"_133":134},"midioamfhtgq777zsyrovhu36","Android CVE-2026-58882“短信死亡”漏洞分析与 PoC 复现","安全研究员 Mark Blah 披露 Android CVE-2026-58882 的 PoC，可通过特制 WAP Push 短信远程触发拒绝服务，导致通话中断。","https://www.bleepingcomputer.com/news/security/new-android-sms-of-death-exploit-can-remotely-crash-unpatched-phones/","2026-10-31T15:35:11.000Z",{"_119":144,"_40":145,"_122":146,"_124":147,"_126":148,"_128":149,"_130":150,"_151":152,"_131":132,"_133":134},{"_119":181,"_40":182,"_122":183,"_124":161,"_126":184,"_128":185,"_130":164,"_151":165,"_131":132,"_133":134},{"_119":166,"_40":167,"_122":168,"_124":169,"_126":170,"_128":171,"_130":172,"_151":173,"_131":132,"_133":134},"leadParagraph",{"_191":192,"_193":-5},"changelogVersion","2026-10-01T08:00","release"]
