shedAt","2026-10-31T00:09:00.000Z","sourceIconUrl","firstParty",false,"available",true,"followUp",{"_135":174,"_118":-5,"_137":175},{"_135":149,"_118":-5,"_137":150},{"_135":136,"_118":-5,"_137":138},"label","研究与披露","items",[139],{"_115":140,"_39":141,"_118":142,"_120":143,"_122":144,"_124":145,"_126":146,"_147":148,"_127":128,"_129":130},"dovg5xscowbmox2u6l6m2s1lp","Parameter 揭示恶意 ChatGPT 分享链接代码执行漏洞利用链","Parameter 揭示恶意 ChatGPT 分享链接可在已登录会话中执行攻击者代码并读取私人对话，利用链经 MathLive 跨框架消息注入原始 HTML，再借助允许的 YouTube 脚本绕过 CSP。","The Hacker News","https://thehackernews.com/2026/10/a-shared-chatgpt-link-could-run.html","2026-10-31T05:33:41.000Z","/dailyinfo/media/3d21685a726d0a64.jpg","sourceIconSrcSet","/dailyinfo/media/a1e7de8b6809b50e.jpg 48w, /dailyinfo/media/3d21685a726d0a64.jpg 96w","攻击与威胁",[151,152,153],{"_115":87,"_39":43,"_118":170,"_120":171,"_122":172,"_124":173,"_126":-5,"_127":128,"_129":130},{"_115":162,"_39":163,"_118":164,"_120":165,"_122":166,"_124":167,"_126":168,"_147":169,"_127":128,"_129":130},{"_115":154,"_39":155,"_118":156,"_120":157,"_122":158,"_124":159,"_126":160,"_147":161,"_127":128,"_129":130},"cyr7bz2bmyz5ecu55k6xo4e2y","Northflank 安全 breach 导致客户 AI API 密钥被滥用","Northflank 在安全 breach 后要求所有客户轮换平台内保存的环境变量、API 密钥及其他 secrets，并确认多名客户发现 AI API 密钥遭到未授权使用。","BleepingComputer","https://www.bleepingcomputer.com/news/security/northflank-security-breach-leads-to-abuse-of-customers-ai-api-keys/","2026-10-31T18:01:12.000Z","/dailyinfo/media/198a4d86de90e233.webp","/dailyinfo/media/3a544a742516b0af.webp 48w, /dailyinfo/media/198a4d86de90e233.webp 96w","l8c38b2h5meavjepjvszce1ro","VOLTA-AUTODOXER 利用 LLM 对窃取数据进行受害者价值评估","Cisco Talos 分析了自删除型 Windows 信息窃取程序 VOLTA-AUTODOXER：它采集浏览器凭据、会话、支付卡、加密钱包种子、OAuth 令牌、云端密钥、Wi-Fi 密码及截图后，将结构化证据发送至 OpenRouter，由 LLM 生成包含“WHAT THEY'RE WORTH”和“THEIR OPSEC”的受害者评估。","Cisco Talos","https://blog.talosintelligence.com/appraisal-by-ai-model-driven-victim-prioritization-in-the-volta-infostealer/","2026-10-31T12:00:00.000Z","/dailyinfo/media/cbab12e5b352b636.webp","/dailyinfo/media/79258b19df22701a.webp 48w, /dailyinfo/media/cbab12e5b352b636.webp 96w","CNCERT 监测发现新型僵尸网络 VeilDHT 正通过漏洞利用大范围传播，主要感染 Linux 服务器与 IoT 设备，2026年10月16日至26日境内累计感染40467台，日上线肉鸡最高15805台。","国家互联网应急中心CNCERT","https://mp.weixin.qq.com/s?__biz=MzIwNDk0MDgxMw==&mid=2247502483&idx=1&sn=8c430cd390f5dca61798eb26b1aa9b7e","2026-10-30T11:59:00.000Z","漏洞与在野利用",[176],{"_115":177,"_39":178,"_118":179,"_120":157,"_122":180,"_124":181,"_126":160,"_147":161,"_127":128,"_129":130},"midioamfhtgq777zsyrovhu36","Android CVE-2026-58882“短信死亡”漏洞分析与 PoC 复现","安全研究员 Mark Blah 披露 Android CVE-2026-58882 的 PoC，可通过特制 WAP Push 短信远程触发拒绝服务，导致通话中断。","https://www.bleepingcomputer.com/news/security/new-android-sms-of-death-exploit-can-remotely-crash-unpatched-phones/","2026-10-31T15:35:11.000Z",{"_115":140,"_39":141,"_118":142,"_120":143,"_122":144,"_124":145,"_126":146,"_147":148,"_127":128,"_129":130},{"_115":177,"_39":178,"_118":179,"_120":157,"_122":180,"_124":181,"_126":160,"_147":161,"_127":128,"_129":130},{"_115":162,"_39":163,"_118":164,"_120":165,"_122":166,"_124":167,"_126":168,"_147":169,"_127":128,"_129":130},"leadParagraph",{"_187":188,"_189":-5},"changelogVersion","2026-10-01T08:00","release"]
