pytKVw1U4eq9yibK2AAq8TK37dVv3je7aNC93ibPx1INMGr1F8%252F0%253Fwx_fmt%253Djpeg&mode=image-1200&exp=1793836800&sig=eed63fa55d320de9 1200w, /api/img-proxy?u=https%3A%2F%2Fwechat2rss.xlab.app%2Fimg-proxy%2F%3Fk%3D3f016b7d%26amp%3Bu%3Dhttps%253A%252F%252Fmmbiz.qpic.cn%252Fmmbiz_jpg%252FaoXpXT1UJRjQkP2IIwjsicqa4rTMfDJteyUpfgT0tDxepDdItZrDcwsjs9jHpytKVw1U4eq9yibK2AAq8TK37dVv3je7aNC93ibPx1INMGr1F8%252F0%253Fwx_fmt%253Djpeg&mode=full&exp=1793836800&sig=51312a7ab9dddcad 1600w","width","height","caption",{"_71":72,"_28":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":-5,"_83":84,"_85":86,"_87":26},"itemId","rvzo6jnjpnoo4hypna7k8fk0f","群晖NAS设备遭C3RB3R勒索攻击，官方建议更新至安全版本","summary","国内外多起群晖（Synology）NAS勒索攻击已被报告，部分设备文件被加密并添加.L0CK3D后缀，出现read-me3.txt勒索信，攻击被认为与C3RB3R（Cerber）勒索软件有关。","sourceName","安全内参","sourceUrl","https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&mid=2247516811&idx=1&sn=8ec8e6aac1f429accbd887ba2446ebc3","publishedAt","2026-10-31T00:09:00.000Z","sourceIconUrl","firstParty",false,"available",true,"followUp",{"_91":130,"_74":-5,"_93":131},{"_91":105,"_74":-5,"_93":106},{"_91":92,"_74":-5,"_93":94},"label","研究与披露","items",[95],{"_71":96,"_28":97,"_74":98,"_76":99,"_78":100,"_80":101,"_82":102,"_103":104,"_83":84,"_85":86},"dovg5xscowbmox2u6l6m2s1lp","Parameter 揭示恶意 ChatGPT 分享链接代码执行漏洞利用链","Parameter 揭示恶意 ChatGPT 分享链接可在已登录会话中执行攻击者代码并读取私人对话，利用链经 MathLive 跨框架消息注入原始 HTML，再借助允许的 YouTube 脚本绕过 CSP。","The Hacker News","https://thehackernews.com/2026/10/a-shared-chatgpt-link-could-run.html","2026-10-31T05:33:41.000Z","/dailyinfo/media/3d21685a726d0a64.jpg","sourceIconSrcSet","/dailyinfo/media/a1e7de8b6809b50e.jpg 48w, /dailyinfo/media/3d21685a726d0a64.jpg 96w","攻击与威胁",[107,108,109],{"_71":43,"_28":32,"_74":126,"_76":127,"_78":128,"_80":129,"_82":-5,"_83":84,"_85":86},{"_71":118,"_28":119,"_74":120,"_76":121,"_78":122,"_80":123,"_82":124,"_103":125,"_83":84,"_85":86},{"_71":110,"_28":111,"_74":112,"_76":113,"_78":114,"_80":115,"_82":116,"_103":117,"_83":84,"_85":86},"cyr7bz2bmyz5ecu55k6xo4e2y","Northflank 安全 breach 导致客户 AI API 密钥被滥用","Northflank 在安全 breach 后要求所有客户轮换平台内保存的环境变量、API 密钥及其他 secrets，并确认多名客户发现 AI API 密钥遭到未授权使用。","BleepingComputer","https://www.bleepingcomputer.com/news/security/northflank-security-breach-leads-to-abuse-of-customers-ai-api-keys/","2026-10-31T18:01:12.000Z","/dailyinfo/media/198a4d86de90e233.webp","/dailyinfo/media/3a544a742516b0af.webp 48w, /dailyinfo/media/198a4d86de90e233.webp 96w","l8c38b2h5meavjepjvszce1ro","VOLTA-AUTODOXER 利用 LLM 对窃取数据进行受害者价值评估","Cisco Talos 分析了自删除型 Windows 信息窃取程序 VOLTA-AUTODOXER：它采集浏览器凭据、会话、支付卡、加密钱包种子、OAuth 令牌、云端密钥、Wi-Fi 密码及截图后，将结构化证据发送至 OpenRouter，由 LLM 生成包含“WHAT THEY'RE WORTH”和“THEIR OPSEC”的受害者评估。","Cisco Talos","https://blog.talosintelligence.com/appraisal-by-ai-model-driven-victim-prioritization-in-the-volta-infostealer/","2026-10-31T12:00:00.000Z","/dailyinfo/media/cbab12e5b352b636.webp","/dailyinfo/media/79258b19df22701a.webp 48w, /dailyinfo/media/cbab12e5b352b636.webp 96w","CNCERT 监测发现新型僵尸网络 VeilDHT 正通过漏洞利用大范围传播，主要感染 Linux 服务器与 IoT 设备，2026年10月16日至26日境内累计感染40467台，日上线肉鸡最高15805台。","国家互联网应急中心CNCERT","https://mp.weixin.qq.com/s?__biz=MzIwNDk0MDgxMw==&mid=2247502483&idx=1&sn=8c430cd390f5dca61798eb26b1aa9b7e","2026-10-30T11:59:00.000Z","漏洞与在野利用",[132],{"_71":133,"_28":134,"_74":135,"_76":113,"_78":136,"_80":137,"_82":116,"_103":117,"_83":84,"_85":86},"midioamfhtgq777zsyrovhu36","Android CVE-2026-58882“短信死亡”漏洞分析与 PoC 复现","安全研究员 Mark Blah 披露 Android CVE-2026-58882 的 PoC，可通过特制 WAP Push 短信远程触发拒绝服务，导致通话中断。","https://www.bleepingcomputer.com/news/security/new-android-sms-of-death-exploit-can-remotely-crash-unpatched-phones/","2026-10-31T15:35:11.000Z",{"_71":96,"_28":97,"_74":98,"_76":99,"_78":100,"_80":101,"_82":102,"_103":104,"_83":84,"_85":86},{"_71":133,"_28":134,"_74":135,"_76":113,"_78":136,"_80":137,"_82":116,"_103":117,"_83":84,"_85":86},{"_71":118,"_28":119,"_74":120,"_76":121,"_78":122,"_80":123,"_82":124,"_103":125,"_83":84,"_85":86},"leadParagraph",{"_143":144,"_145":-5},"changelogVersion","2026-10-01T08:00","release"]
