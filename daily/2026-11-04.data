":228,"_182":229,"_184":230,"_186":231,"_188":232,"_190":191,"_192":193},{"_175":217,"_57":218,"_178":219,"_180":220,"_182":221,"_184":222,"_186":223,"_188":224,"_190":191,"_192":193},{"_175":209,"_57":210,"_178":211,"_180":212,"_182":213,"_184":214,"_186":215,"_188":216,"_190":191,"_192":193},{"_175":200,"_57":201,"_178":202,"_180":203,"_182":204,"_184":205,"_186":206,"_188":207,"_190":191,"_192":193,"_208":50},{"_175":195,"_57":196,"_178":197,"_180":181,"_182":198,"_184":199,"_186":187,"_188":189,"_190":191,"_192":193},{"_175":176,"_57":177,"_178":179,"_180":181,"_182":183,"_184":185,"_186":187,"_188":189,"_190":191,"_192":193,"_194":62},"itemId","lp7mel34dhyawe4cpwe2sa291","攻击者利用 BTCPay Server 漏洞盗走约 $1.63m 加密货币","summary","攻击者利用 BTCPay Server 漏洞入侵运行 2.4.1 或更早版本的热钱包服务，Bitquery 将 18.38 Bitcoin 和 3405 Litecoin 追踪至 2 个地址，涉及 10 月 30 日至 11 月 2 日上午的 682 次归集，其中 87% 的资金于 11 月 1 日集中转出。","sourceName","Infosecurity Magazine","sourceUrl","https://www.infosecurity-magazine.com/news/btcpay-server-flaw-cryptocurrency/","publishedAt","2026-11-03T14:30:00.000Z","sourceIconUrl","/dailyinfo/media/b3cc9cd29f272a5a.webp","sourceIconSrcSet","/dailyinfo/media/6406d1b57afc7303.webp 48w, /dailyinfo/media/b3cc9cd29f272a5a.webp 96w","firstParty",false,"available",true,"followUp","nm0phlll31jsdjzttnirj27id","Google 警告 LLMJacking 致部分企业累计云费用达 $1m","Google Mandiant 称攻击者正通过 LLM API keys、暴露或窃取的云身份令牌及活动会话令牌进入后端模型资源，利用 LLM 路由软件漏洞提权并开展内部侦察，再通过 token 代理、自动模型流式调用和 GPU 资源配置牟利。","https://www.infosecurity-magazine.com/news/llmjacking-cost-business-1m-warns/","2026-11-03T10:45:00.000Z","dnizr3695w14lqcfb6u5a5r5e","3AM 勒索软件入侵英国 47 套学校系统，加密约 37 台设备","Bitdefender 调查称，3AM 勒索软件附属成员入侵英国一套包含 47 套系统、跨多个 Active Directory 域的学校环境，并加密约 37 台设备。","Hackread","https://hackread.com/3am-ransomware-uk-school-systems-ai-attack/","2026-11-03T16:10:42.000Z","/dailyinfo/media/dd06beac4cadc6f3.webp","/dailyinfo/media/47417cbef4636b7b.webp 48w, /dailyinfo/media/dd06beac4cadc6f3.webp 96w","otherSources","xotvn8h2ady8nq85xed82tncq","Apple 间谍软件告警送达德国联邦议院，BSI 要求受影响者按设备失陷处置","Apple 自 2026 年 10 月 29 日起通知多名德国联邦议院议员、政界人士及其他公众人物，其 iPhone 遭到政府支持的雇佣间谍软件攻击；BSI 尚不确定通知代表成功感染还是攻击尝试，已向受影响者发出提醒并要求联系机构。","Security Affairs","https://securityaffairs.com/202297/intelligence/apples-spyware-notifications-reach-the-bundestag-what-the-bsi-says-to-do-now.html","2026-11-03T06:24:38.000Z","/dailyinfo/media/ef2b2b57fb06e54f.webp","/dailyinfo/media/2adef5b1e4357a03.webp 48w, /dailyinfo/media/ef2b2b57fb06e54f.webp 96w","e0dx6fw9riknru6df1l30kiyv","欧洲多国超市制冷系统遭远程攻击，部分门店下架或丢弃食品","攻击者远程篡改比利时、瑞典、爱尔兰等欧洲国家超市的制冷控制器，将冷柜温度调高或切换至除霜模式，造成食品下架或丢弃；Delhaize 数家门店、Carrefour 15 家、Intermarché 10 至 15 家、IKEA 1 家、ICA 6 或 7 家、SuperValu 13 家等受到影响。","The Hacker News","https://thehackernews.com/2026/11/second-wave-of-cyberattacks-hits.html","2026-11-03T07:27:07.000Z","/dailyinfo/media/3d21685a726d0a64.jpg","/dailyinfo/media/a1e7de8b6809b50e.jpg 48w, /dailyinfo/media/3d21685a726d0a64.jpg 96w","x23yir35advjsqlnwp48chbhs","AI coding agent 被诱导安装弃用 MCP server，部分服务器存在 4 个高危漏洞","Glow Labs 通过真实 AI coding session transcripts 发现，Claude Code、Cursor、Codex CLI 等 agent 会选择已归档且不再维护的 MCP server。","Help Net Security","https://www.helpnetsecurity.com/2026/11/03/mcphantom-deprecated-mcp-servers/","2026-11-03T05:45:53.000Z","/dailyinfo/media/06c9ab9de6dbb6a5.webp","/dailyinfo/media/9c1b5fa87b3bafc5.webp 48w, /dailyinfo/media/06c9ab9de6dbb6a5.webp 96w","oyad974prfvo7igo8npmwywn4","Binance 披露虚假招聘与 AI 工具滥用导致 64.3 亿美元资产被盗","Binance 称，2026 年 6 月至 10 月发生的攻击通过篡改的 Homebrew 安装程序、虚假招聘面试、恶意代码仓库及内部 AI 工具滥用，依次入侵两名工程师的终端，并盗取钱包基础设施相关凭据。","https://thehackernews.com/2026/11/binance-reveals-how-fake-job-interviews.html","2026-11-03T16:55:58.000Z",{"_241":317,"_178":-5,"_243":318},{"_241":252,"_178":-5,"_243":253},{"_241":242,"_178":-5,"_243":244},"label","AI 安全","items",[245],{"_175":246,"_57":247,"_178":248,"_180":249,"_182":250,"_184":251,"_186":-5,"_190":191,"_192":193},"px9wc0oazjpbi9yc3x0ixa2mf","Split-View PDF 研究揭示文档大模型的隐藏提取差异","Tulane University 团队研究 PDF 到大模型供应链中的分裂视图问题，在 532 组测试中发现 154 组引擎分歧，确认 25 类提取差异，其中 14 类未见已有工作对应。","安全研究GoSSIP","https://mp.weixin.qq.com/s?__biz=Mzg5ODUxMzg0Ng==&mid=2247502382&idx=1&sn=fda53a70ca58d394e22b43b8fb371e76","2026-11-03T13:19:00.000Z","攻击与威胁",[254,255,256,257,258,259,260,261],{"_175":312,"_57":313,"_178":314,"_180":220,"_182":315,"_184":316,"_186":223,"_188":224,"_190":191,"_192":193,"_208":50},{"_175":300,"_57":301,"_178":302,"_180":220,"_182":303,"_184":304,"_186":223,"_188":224,"_190":191,"_192":193,"_208":50,"_305":306},{"_175":295,"_57":296,"_178":297,"_180":228,"_182":298,"_184":299,"_186":231,"_188":232,"_190":191,"_192":193},{"_175":290,"_57":291,"_178":292,"_180":228,"_182":293,"_184":294,"_186":231,"_188":232,"_190":191,"_192":193,"_208":52},{"_175":282,"_57":283,"_178":284,"_180":285,"_182":286,"_184":287,"_186":288,"_188":289,"_190":191,"_192":193},{"_175":276,"_57":277,"_178":278,"_180":279,"_182":280,"_184":281,"_186":-5,"_190":191,"_192":193},{"_175":268,"_57":269,"_178":270,"_180":271,"_182":272,"_184":273,"_186":274,"_188":275,"_190":191,"_192":193},{"_175":262,"_57":263,"_178":264,"_180":265,"_182":266,"_184":267,"_186":-5,"_190":191,"_192":193},"ijlvo02lj2zxe7uihyf0owngi","Google 联合行业伙伴拆解 XCPE 僵尸网络，逾 130 万台 Android TV 机顶盒被用于代理","Google 与行业伙伴拆解了由 130 多万台 Android TV 机顶盒组成的 XCPE 僵尸网络，这些设备预装恶意软件，在用户不知情下出租互联网连接，用于广告欺诈等犯罪活动。","Krebs on Security","https://krebsonsecurity.com/2026/11/tech-firms-dismantle-botnet-that-turned-1-3m-tv-boxes-into-proxies/","2026-11-03T02:24:31.000Z","mi1ggezik5lbguyepuij62h71","SentinelLabs 评估欧洲零售制冷系统攻击，数百家法国门店受影响","SentinelLabs 评估欧洲零售制冷系统遭攻击事件：2026年10月11日至13日，数百家法国超市制冷中断，约700家门店受影响；11月2日至3日，比利时、爱沙岛、德国、爱尔兰、意大利、卢森堡、荷兰、葡萄牙和瑞典也报告中断。","SentinelLabs","https://www.sentinelone.com/labs/defrost-and-disrupt-an-assessment-of-europe-s-refrigeration-attacks/","2026-11-03T14:57:27.000Z","/dailyinfo/media/02d46ef457cae4f6.webp","/dailyinfo/media/6e0f0ba7134795c9.webp 48w, /dailyinfo/media/02d46ef457cae4f6.webp 96w","lybkf1c5asn88rjr54wj2w33h","Microsoft 披露木马化安装程序下载活动及三类变现载荷","Microsoft Threat Intelligence 发现一项针对破解软件、免费游戏、激活器和非官方工具用户的假下载活动，通过 Inno Setup 风格安装程序、临时运行器和 offer 回调投放载荷。","Microsoft Security Blog","https://www.microsoft.com/en-us/security/blog/2026/11/03/fake-download-campaign-uses-trojanized-installers-deliver-monetization-payloads/","2026-11-03T17:32:47.000Z","ry1s8823u73qzqqdpklkue81e","WorkOS 称攻击者利用 ARTEX AI 入侵内部销售应用","WorkOS 称攻击者使用 ARTEX AI 渗透测试框架自动执行侦察与利用尝试，入侵了销售团队使用的内部应用。2026年10月30日发现未授权访问后，公司关闭外部访问、审查内部工具权限，并聘请独立取证与事件响应机构调查影响。","BleepingComputer","https://www.bleepingcomputer.com/news/security/workos-says-attacker-used-artex-ai-to-breach-internal-sales-app/","2026-11-03T21:28:44.000Z","/dailyinfo/media/198a4d86de90e233.webp","/dailyinfo/media/3a544a742516b0af.webp 48w, /dailyinfo/media/198a4d86de90e233.webp 96w","ggy3le7y33yjx5i60bxd14abb","Gorbag APT 组织以自删除恶意软件攻击乌克兰法院和市议会","ESET 追踪的俄罗斯关联组织 Gorbag 自至少 2025 年 2 月起入侵乌克兰机构，利用鱼叉式钓鱼附件和 BeautyStealer 窃取浏览器凭据、VPN 配置及敏感文件。","https://www.helpnetsecurity.com/2026/11/03/gorbag-apt-group-malware/","2026-11-03T10:00:14.000Z","bx00h884nk3p2ej5xmi6wb6v1","Vapor Panda 等组织利用 ARTEX 与 CyberStrikeAI 扩大 AI 驱动攻击","CrowdStrike 与 Kaspersky 分别披露了两起 AI 代理参与入侵的活动。","https://www.helpnetsecurity.com/2026/11/03/ai-powered-cyberattacks-artex-cyberstrikeai/","2026-11-03T12:31:59.000Z","g31iatxcau1k6dwknxiqgohrr","攻击者利用 Siemens SIMATIC IoT2050 漏洞 CVE-2026-58115 植入远程命令后门","攻击者已被观察到利用 Siemens SIMATIC IoT2050 Advanced 的 CVE-2026-58115 植入远程命令后门，该漏洞 CVSS 10.0，未认证远程攻击者可借 Node-RED HTTP 接口执行任意代码。","https://thehackernews.com/2026/11/attackers-exploit-critical-siemens.html","2026-11-03T05:34:41.000Z","related",[307],{"_175":308,"_57":309,"_178":-5,"_180":228,"_182":310,"_184":311,"_186":231,"_188":232,"_190":191,"_192":193},"j6olur9cn7e3307ifmi8dkmig","攻击者利用 Node-RED 认证绕过漏洞 CVE-2026-58115 部署 Linux 僵尸程序和后门","https://www.helpnetsecurity.com/2026/11/03/node-red-cve-2026-58115-exploitation/","2026-11-03T12:59:51.000Z","bwq6gssfuodld3bto7vao4207","cPGuard 5.88.12 至 5.88.19 更新通道被劫持，Linux 服务器遭后门植入","攻击者于 November 2 使用泄露凭据侵入 cPGuard 更新系统，通过 5.88.12 至 5.88.19 向客户 Linux 服务器投放恶意脚本，安装后门并收集密码哈希及敏感文件。","https://thehackernews.com/2026/11/cpguard-update-channel-hijacked-to.html","2026-11-03T15:16:32.000Z","漏洞与在野利用",[319,320,321],{"_175":150,"_57":67,"_178":342,"_180":343,"_182":344,"_184":345,"_186":-5,"_190":193,"_192":193},{"_175":330,"_57":331,"_178":332,"_180":333,"_182":334,"_184":335,"_186":-5,"_190":193,"_192":193,"_208":50,"_305":336,"_194":62},{"_175":322,"_57":323,"_178":324,"_180":325,"_182":326,"_184":327,"_186":328,"_188":329,"_190":193,"_192":193},"ungyq5x28j803aw7gd2hmsng3","Chrome 157 稳定版发布，Windows、Mac 和 Linux 收录 213 项安全修复","Chrome 157 稳定版面向 Windows、Mac 和 Linux 推送，Linux 版本为 157.0.8103.38，Windows/Mac 版本为 157.0.8103.38/.39，将在未来数日或数周内完成分发。","Chrome Releases","http://chromereleases.googleblog.com/2026/11/stable-channel-update-for-desktop.html","2026-11-03T20:38:18.791Z","/dailyinfo/media/2804b677dd1e2bc0.webp","/dailyinfo/media/a673d47722466a30.webp 48w, /dailyinfo/media/2804b677dd1e2bc0.webp 96w","p3l7vk5l199h68wksyf6etvvm","Linux Kernel IPv4 TCP 释放后重用漏洞 CVE-2026-98432 已复现","奇安信 CERT 已复现 Linux Kernel IPv4 TCP 释放后重用漏洞 CVE-2026-98432，该漏洞源于 IPv4 TCP 握手处理竞态，可通过网络触发内核内存损坏、绕过 KASLR 的信息泄露、拒绝服务，并在特定 MPTCP 监听条件下实现远程任意代码执行和获取 root 权限。","奇安信 CERT","https://mp.weixin.qq.com/s?__biz=MzU5NDgxODU1MQ==&mid=2247507998&idx=1&sn=be5814f110096f1e65ec30a7a35c573f","2026-11-03T09:44:00.000Z",[337],{"_175":338,"_57":339,"_178":-5,"_180":220,"_182":340,"_184":341,"_186":223,"_188":224,"_190":191,"_192":193},"qeouvfs9fzn25yxn9y3dgjxad","Red Hat 修复 CVSS 9.8 的 Linux TCP RCE 漏洞 CVE-2026-98432","https://thehackernews.com/2026/11/red-hat-patches-98-rated-linux-tcp-rce.html","2026-11-03T11:23:53.000Z","Cisco Secure Email Gateway 的 SQL 注入漏洞 CVE-2026-76461 已被在野利用，未经身份验证的远程攻击者可通过发送含恶意 SQL 语句的邮件，在底层操作系统以 root 权限执行命令。","Cisco PSIRT","https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-esa-inj-2bLVGmhX?vs_f=Cisco%20Security%20Advisory%26vs_cat=Security%20Intelligence%26vs_type=RSS%26vs_p=Cisco%20Secure%20Email%20Gateway%20SQL%20Injection%20Vulnerability%26vs_k=1","2026-11-03T09:05:12.000Z",{"_175":330,"_57":331,"_178":332,"_180":333,"_182":334,"_184":335,"_186":-5,"_190":193,"_192":193,"_208":50,"_305":351,"_194":62},{"_175":312,"_57":313,"_178":314,"_180":220,"_182":315,"_184":316,"_186":223,"_188":224,"_190":191,"_192":193,"_208":50},{"_175":300,"_57":301,"_178":302,"_180":220,"_182":303,"_184":304,"_186":223,"_188":224,"_190":191,"_192":193,"_208":50,"_305":349},[350],{"_175":308,"_57":309,"_178":-5,"_180":228,"_182":310,"_184":311,"_186":231,"_188":232,"_190":191,"_192":193},[352],{"_175":338,"_57":339,"_178":-5,"_180":220,"_182":340,"_184":341,"_186":223,"_188":224,"_190":191,"_192":193},"leadParagraph",{"_355":356,"_357":-5},"changelogVersion","2026-10-01T08:00","release"]
