wechat2rss.xlab.app%2Fimg-proxy%2F%3Fk%3D543b22ea%26amp%3Bu%3Dhttps%253A%252F%252Fmmbiz.qpic.cn%252Fsz_mmbiz_jpg%252FAPc6NwjLsxSeWUTtDB1SR1MRwiaFNrUnujUCYOIwu26JPMFqVz6DQkBHutN5gn8HX3LN1YjdaYjqBvH7aAibflJicOn3Wyl1YAfFCqEWCWLDfg%252F0%253Fwx_fmt%253Djpeg&mode=full&exp=1795392000&sig=b6e32ee802bba282 1600w","width","height","caption",{"_150":218,"_48":219,"_153":220,"_155":172,"_157":221,"_159":222,"_161":175,"_163":176,"_165":168,"_167":168},{"_150":213,"_48":214,"_153":215,"_155":198,"_157":216,"_159":217,"_161":201,"_163":202,"_165":166,"_167":168},{"_150":208,"_48":209,"_153":210,"_155":198,"_157":211,"_159":212,"_161":201,"_163":202,"_165":166,"_167":168},{"_150":203,"_48":204,"_153":205,"_155":172,"_157":206,"_159":207,"_161":175,"_163":176,"_165":168,"_167":168},{"_150":195,"_48":196,"_153":197,"_155":198,"_157":199,"_159":200,"_161":201,"_163":202,"_165":166,"_167":168},{"_150":190,"_48":191,"_153":192,"_155":172,"_157":193,"_159":194,"_161":175,"_163":176,"_165":168,"_167":168},{"_150":182,"_48":183,"_153":184,"_155":185,"_157":186,"_159":187,"_161":188,"_163":189,"_165":166,"_167":168},{"_150":177,"_48":178,"_153":179,"_155":172,"_157":180,"_159":181,"_161":175,"_163":176,"_165":168,"_167":168},{"_150":169,"_48":170,"_153":171,"_155":172,"_157":173,"_159":174,"_161":175,"_163":176,"_165":168,"_167":168},{"_150":151,"_48":152,"_153":154,"_155":156,"_157":158,"_159":160,"_161":162,"_163":164,"_165":166,"_167":168},"itemId","yvzjhws6tdc6je8wptnrjsqgv","Check Point Research 追踪 CopperDragon 关联 Sparrow 框架的三个攻击集群","summary","Check Point Research 经一年调查识别出 SilentDelivery、OceanGate 和 DarkWire 三个关联 Sparrow 框架的攻击集群。","sourceName","Check Point Research","sourceUrl","https://research.checkpoint.com/2026/not-all-that-glitters-is-gold-tracking-copperdragons-sparrow-framework-around-the-globe/","publishedAt","2026-11-10T14:01:14.000Z","sourceIconUrl","/dailyinfo/media/eb5a4204ed5bdd38.webp","sourceIconSrcSet","/dailyinfo/media/847ca4554cd8d31b.webp 48w, /dailyinfo/media/eb5a4204ed5bdd38.webp 96w","firstParty",false,"available",true,"n12d2xr0theol7egqezcvggxt","Active Support safe_constantize 存在潜在 DoS 漏洞，影响 activesupport 8.1 且低于 8.1.4.1","ActiveSupport::Inflector#safe_constantize 会将未转义的常量名编译为正则表达式，可能触发 Ruby 正则表达式编译器缺陷并导致服务器进程崩溃，重复请求可造成应用不可用。","GitHub 安全公告","https://github.com/advisories/GHSA-8474-xrp6-wh69","2026-11-10T21:34:11.000Z","/dailyinfo/media/6d6a98e6b62e0bb2.webp","/dailyinfo/media/f426f4f60d806c23.webp 48w, /dailyinfo/media/6d6a98e6b62e0bb2.webp 96w","dyhi8nn95b38npkt7si3jmlsy","AG2 SandboxShellTool 换行注入可绕过命令白名单与只读限制","AG2 的 SandboxShellTool 可因命令字符串中的换行符绕过 allowed=[...] 与 readonly=True 两种限制。过滤器会拒绝 ;、&&、| 等 shell 操作符，却未拦截 \\n 或 \\r，随后原始字符串被交给 sh -c 执行，使第二条命令也能运行；默认 LocalEnvironment() 后端下，这属于宿主进程命令执行，而非容器内隔离。","https://github.com/advisories/GHSA-2h4w-29cv-2cmv","2026-11-10T15:57:17.000Z","s8ur1jt60ywc3mv4s4fv20j7z","日本家具零售商 Nitori 称黑客可能窃取 37.62 million 条客户记录","日本家具及家居用品零售商 Nitori 表示，第三方未经授权访问其系统，最多 37.62 million 条个人信息可能被外部窃取。","BleepingComputer","https://www.bleepingcomputer.com/news/security/japanese-furniture-giant-nitori-says-hackers-stole-376m-customer-records/","2026-11-10T20:54:55.000Z","/dailyinfo/media/198a4d86de90e233.webp","/dailyinfo/media/3a544a742516b0af.webp 48w, /dailyinfo/media/198a4d86de90e233.webp 96w","aswmt9yct5lubk8xlutacsm1t","node-forge 修复 asn1.fromDer() 嵌套 BIT STRING 资源耗尽漏洞，CVSS 3.1 为 7.5","node-forge 的 asn1.fromDer() 存在资源耗尽漏洞，攻击者可提交小型 DER 或 PEM 结构，利用嵌套 BIT STRING 绕过 maxDepth 递归限制，消耗过多 CPU 和内存并导致 Node.js 进程拒绝服务。","https://github.com/advisories/GHSA-rhr8-3pm8-cq29","2026-11-10T15:57:41.000Z","la28eurfu058o3k4rpz84fo7c","Git 修复 CVE-2026-111760，恶意仓库可在递归克隆时执行代码","Git 2.56.1 及 2.50.2、2.51.3、2.52.1、2.53.1、2.54.1、2.55.1 修复了 CVE-2026-111760，攻击者可借恶意仓库中的超长路径和子模块符号链接，在递归克隆时执行代码。","The Hacker News","https://thehackernews.com/2026/11/git-patches-flaw-that-lets-malicious.html","2026-11-10T19:23:10.000Z","/dailyinfo/media/3d21685a726d0a64.jpg","/dailyinfo/media/a1e7de8b6809b50e.jpg 48w, /dailyinfo/media/3d21685a726d0a64.jpg 96w","r17ig0zhfspobluf32uqoseck","@nuxt/content 内容查询接口未授权 DoS 漏洞（3.15.2 之前版本受影响）","@nuxt/content 的 POST /__nuxt_content/:collection/query 接口默认无需认证，直接执行请求体中的 sql 字段，assertSafeQuery() 只拦截 SELECT 等六个关键字而不拦截 randomblob()、zeroblob()、hex()、length() 等 SQLite 内置函数。","https://github.com/advisories/GHSA-xxrh-5hgg-gj4h","2026-11-10T15:57:12.000Z","jm54e8qi34bvqra3h6ykepgve","SAP 修复四项 CVSS 10.0 漏洞，其中两项可导致远程代码执行","SAP 修复 Internet Communication Manager、SAP Web Dispatcher、SAP Gateway 和 SAML2 service provider 的四项 CVSS 10.0 漏洞，分别对应 CVE-2026-76964、CVE-2026-89126、CVE-2026-89103、CVE-2026-120017，均无需用户交互即可攻击。","https://thehackernews.com/2026/11/sap-patches-four-cvss-100-flaws.html","2026-11-10T10:02:40.000Z","bzxsk4iknxo17c6yqkk8qii1v","CISA 将 OpenSSH、GPUStack、FreeSWITCH 和 IBM Aspera 漏洞列入 KEV","CISA 因已有在野利用证据，将 GPUStack、SignalWire FreeSwitch、OpenBSD OpenSSH 和 IBM Aspera Faspex 的 4 个漏洞加入 KEV 目录，CVSS 分数分别为 9.8、9.8、8.1 和 9.8。","https://thehackernews.com/2026/11/cisa-warns-of-active-exploitation-of.html","2026-11-10T06:31:42.000Z","nypzu48uooruzzhyeowlg5cl5","Active Storage 8.1 存在视频预览与图像处理任意文件读取及 RCE 风险","Active Storage 8.1, < 8.1.4.1 存在漏洞，攻击者可通过控制上传文件名和内容类型影响 ffprobe、ffmpeg 与 ImageMagick 选择的解码器，利用启用 AviSynth 的 FFmpeg 读取应用可访问文件或加载上传的本地库，可能导致 RCE。","https://github.com/advisories/GHSA-v924-7rp8-4mxh","2026-11-10T21:38:55.000Z",{"_226":312,"_153":-5,"_228":313},{"_226":253,"_153":-5,"_228":254},{"_226":227,"_153":-5,"_228":229},"label","研究与披露","items",[230,231],{"_150":237,"_48":238,"_153":239,"_155":240,"_157":241,"_159":242,"_161":243,"_163":244,"_165":166,"_167":168,"_245":43,"_246":247},{"_150":232,"_48":233,"_153":234,"_155":172,"_157":235,"_159":236,"_161":175,"_163":176,"_165":168,"_167":168},"t38yyi1raz8ik9fsh1ryv55gz","node-opcua 命名空间 RBAC 失败开放导致匿名写入与调用绕过","node-opcua 存在命名空间级 RBAC 失败开放漏洞，已声明的 DefaultRolePermissions 策略可能被运行时忽略，使 Anonymous 客户端获得 Read、Write、Call 权限；漏洞评分为 CVSS 9.8。","https://github.com/advisories/GHSA-xggf-m53x-jc3f","2026-11-10T15:56:52.000Z","zqhb8fqggr4jdd60g720bgfej","forcequitOS 公开 iOS 沙箱逃逸 PoC worse_query，影响 iOS 26.7.1、27.0.1 和 27.2","forcequitOS 公开了名为 worse_query 的 iOS 沙箱逃逸 PoC，可在应用创建 App Group container 后读取其他应用的数据目录，并在 iOS 27 上访问部分系统目录，影响 iOS 26.7.1、27.0.1 和 27.2。","Security Affairs","https://securityaffairs.com/202788/hacking/ios-sandbox-escape-is-public-and-apple-hasnt-confirmed-a-fix.html","2026-11-10T15:46:20.000Z","/dailyinfo/media/ef2b2b57fb06e54f.webp","/dailyinfo/media/2adef5b1e4357a03.webp 48w, /dailyinfo/media/ef2b2b57fb06e54f.webp 96w","otherSources","related",[248],{"_150":249,"_48":250,"_153":-5,"_155":185,"_157":251,"_159":252,"_161":188,"_163":189,"_165":166,"_167":168},"nvlwjzj3m3yzedvfp5u08pt0o","Apple iOS worse_query 沙箱逃逸漏洞或暴露加密钱包密钥，影响 26.7.1、27.0.1 和 27.2","https://www.bleepingcomputer.com/news/security/binance-warns-of-ios-flaw-that-could-leak-crypto-wallet-secrets/","2026-11-10T15:59:19.000Z","攻击与威胁",[255,256,257,258,259,260,261],{"_150":304,"_48":305,"_153":306,"_155":307,"_157":308,"_159":309,"_161":310,"_163":311,"_165":166,"_167":168,"_245":47},{"_150":298,"_48":299,"_153":300,"_155":301,"_157":302,"_159":303,"_161":-5,"_165":166,"_167":168,"_245":43},{"_150":292,"_48":293,"_153":294,"_155":295,"_157":296,"_159":297,"_161":-5,"_165":166,"_167":168,"_245":57},{"_150":277,"_48":278,"_153":279,"_155":280,"_157":281,"_159":282,"_161":283,"_163":284,"_165":166,"_167":168,"_245":45,"_246":285,"_286":74},{"_150":272,"_48":273,"_153":274,"_155":185,"_157":275,"_159":276,"_161":188,"_163":189,"_165":166,"_167":168},{"_150":267,"_48":268,"_153":269,"_155":198,"_157":270,"_159":271,"_161":201,"_163":202,"_165":166,"_167":168},{"_150":262,"_48":263,"_153":264,"_155":185,"_157":265,"_159":266,"_161":188,"_163":189,"_165":166,"_167":168,"_245":41},"d5ja2gdozlvbokoh76xzu4ofy","Fireworks AI 披露第三方云提供商被攻破后发生的新数据泄露","Fireworks AI 披露，攻击者在第三方云提供商于 October 23 遭入侵后，于 October 24 触达 Fireworks 开发机器并运行未授权工作负载，导致部分客户的资源元数据、账单信息及不完整模型权重和数据集被访问。","https://www.bleepingcomputer.com/news/security/fireworks-ai-discloses-new-breach-after-cloud-provider-hack/","2026-11-10T07:49:58.000Z","oclbliy8sva9iub474xdrfw3d","NEAR AI 遭 SGLang RCE 利用，18 个 Agent 与约 100 名用户数据被窃","攻击者利用开源推理引擎 SGLang 的远程代码执行漏洞，在 NEAR AI 推理服务器执行代码，并进入已弃用的 Private Chat 内部系统。公司确认约 100 名用户的邮箱、姓名及部分套餐和余额信息被下载，18 个旧版 NEAR AI Agents 的聊天记录、设置和日志遭窃，2 名客户的 NEAR AI Cloud API 密钥暴露。","https://thehackernews.com/2026/11/sglang-rce-exploit-breaches-near-ai.html","2026-11-10T19:19:39.000Z","ls7fmpyylskxaymnr22grsi0u","Railway遭入侵，攻击者盗取凭据并产生约74万美元AI欺诈用量","Railway称，攻击者自10月20日起利用其构建基础设施中的未知漏洞逃逸文件系统隔离，再借助错误配置的信任关系获取解密客户环境变量所需的凭据，最多涉及约100,000个工作区。","https://www.bleepingcomputer.com/news/apple/railway-breach-leads-to-740-000-in-fraudulent-ai-charges/","2026-11-10T22:20:19.000Z","dutfochl5zqbpgtoxwe32cj7v","France 指控 Iran 武装组织攻击约 700 家超市制冷系统","France 指控 Iran 革命卫队关联的 Shahid Kaveh 小组攻击了全国约 700 家超市的制冷系统。10 月 12 日凌晨，攻击者远程控制制冷设备，使温度升至 50 Celsius（122 Fahrenheit）并持续约 6 小时，Intermarché 报告单日损失达数千万欧元。","SecurityWeek","https://www.securityweek.com/france-blames-iran-for-a-cyberattack-that-heated-supermarket-refrigerators/","2026-11-10T07:35:05.000Z","/dailyinfo/media/6f21a015ea489b81.webp","/dailyinfo/media/c2a91b85de7bb9d6.webp 48w, /dailyinfo/media/6f21a015ea489b81.webp 96w",[287],"followUp",{"_150":288,"_48":289,"_153":-5,"_155":198,"_157":290,"_159":291,"_161":201,"_163":202,"_165":166,"_167":168},"b0knsk24nkte3scrokxxwgqig","法国指责伊朗 IRGC 单位攻击约 700 家零售店的制冷控制器","https://thehackernews.com/2026/11/france-blames-iran-for-sabotage-attack.html","2026-11-10T09:08:20.000Z","t9vxip29f8i1pdp144dvxpjbx","XCPE 后门分析：130 万台 Android 设备被预装为可出租代理与广告节点","XCPE 通过 Android OEM/ODM 厂商 Videostrong Technology Co. 的固件预装进入设备，以 x.cpe、com.abc.nexus 及后期专用 Dropper 构成控制与执行链。","奇安信威胁情报中心","https://mp.weixin.qq.com/s?__biz=MzI2MDc2MDA4OA==&mid=2247521313&idx=1&sn=1bd52ac3229fa18e781a8aac3c4553ab","2026-11-10T07:36:00.000Z","vf2fadfkovuwc9eyk4jilfa6l","CNCERT披露“银狐”木马“金钩（G03）”团伙攻击同花顺仿冒下载站","国家互联网应急中心（CNCERT）与北京观成科技有限公司分析“银狐”木马“金钩（G03）”团伙针对同花顺仿冒下载站的活动。该团伙通过SEO投毒传播捆绑木马的THS.zip，以多阶段内存加载植入远控模块，支持屏幕截图、键盘记录、远程命令执行、插件下发和信息窃取。","安全内参","https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&mid=2247516863&idx=2&sn=cee958d56977506d31b586bf4297c108","2026-11-10T09:12:00.000Z","sif366thhfeqdn24sve2qcy60","Turla 利用 Microsoft Exchange 服务器部署 Cereal 后门窃取邮件","ESET 发现俄罗斯关联组织 Turla 在哈萨克斯坦和罗马尼亚的 2 个政府机构 Microsoft Exchange 服务器上部署模块化 .NET 工具集 Cereal，通过伪装成 Outlook Web Access、Autodiscover 和 ActiveSync 流量的请求接收命令，并筛选发件人、收件人、主题或附件名称后复制邮件。","Help Net Security","https://www.helpnetsecurity.com/2026/11/10/eset-turla-exchange-malware/","2026-11-10T10:00:39.000Z","/dailyinfo/media/06c9ab9de6dbb6a5.webp","/dailyinfo/media/9c1b5fa87b3bafc5.webp 48w, /dailyinfo/media/06c9ab9de6dbb6a5.webp 96w","漏洞与在野利用",[314,315,316],{"_150":114,"_48":79,"_153":327,"_155":328,"_157":329,"_159":330,"_161":-5,"_165":168,"_167":168,"_245":43,"_286":74},{"_150":322,"_48":323,"_153":324,"_155":198,"_157":325,"_159":326,"_161":201,"_163":202,"_165":166,"_167":168,"_245":41},{"_150":317,"_48":318,"_153":319,"_155":172,"_157":320,"_159":321,"_161":175,"_163":176,"_165":168,"_167":168},"jugiebheg5ptuxhjuq1jxk8da","Mongoose 原型继承属性写入漏洞分析与 PoC","Mongoose 的文档加载、点路径赋值和更新合并三条代码路径未校验自有属性，攻击者控制的属性名可覆盖原型链上的内置函数或 Mongoose 内部共享对象。其 PoC 表明，一次请求即可使后续查询抛出 TypeError 并持续拒绝服务至进程重启；使用 strict: false 的子文档时，还可移除所有文档共享的 required 校验器。","https://github.com/advisories/GHSA-8332-j7wj-wjw4","2026-11-10T20:56:16.000Z","x7edhu1rfhikbjr5w193xldog","Vates VMS 披露 Xen Orchestra 认证绕过漏洞 VSA-2026-062 已被利用","Vates VMS 表示，Xen Orchestra 的认证绕过漏洞 VSA-2026-062 已在真实攻击中被利用，攻击者通过特制 Cookie 获取 Admin 权限，最终可在托管池上执行任意代码并以 root 接管 XCP-ng 节点。","https://thehackernews.com/2026/11/hackers-exploit-critical-xen-orchestra.html","2026-11-10T18:12:21.000Z","Google Chrome 内置 libxslt 的 XSLT 处理链路存在双重释放（UAF）漏洞 CVE-2026-125350，CVSS 3.1 为 8.8，已被在野利用。","深信服千里目安全实验室","https://mp.weixin.qq.com/s?__biz=Mzg2NjgzNjA5NQ==&mid=2247526403&idx=1&sn=74b3e772b8c4fb242da449db13683206","2026-11-10T09:51:00.000Z",{"_150":304,"_48":305,"_153":306,"_155":307,"_157":308,"_159":309,"_161":310,"_163":311,"_165":166,"_167":168,"_245":47},{"_150":298,"_48":299,"_153":300,"_155":301,"_157":302,"_159":303,"_161":-5,"_165":166,"_167":168,"_245":43},{"_150":322,"_48":323,"_153":324,"_155":198,"_157":325,"_159":326,"_161":201,"_163":202,"_165":166,"_167":168,"_245":41},"leadParagraph",{"_336":337,"_338":-5},"changelogVersion","2026-10-01T08:00","release"]
