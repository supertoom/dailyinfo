44Gy49ksyu0Cy1ctvE2UxaI3mYD3FZCvAVCia15tjyhqO5flnIEmb5ia4ichWeniacKeAhPn2ibcDjlVicF5CBg7ibia8uDfnkGJQCDrZ9wqs%252F0%253Fwx_fmt%253Djpeg&mode=full&exp=1795305600&sig=8a3c672cfebd08b2 1600w","width","height","caption",{"_141":184,"_47":185,"_144":186,"_146":163,"_148":187,"_150":188,"_152":166,"_154":167,"_156":157,"_158":159},{"_141":176,"_47":177,"_144":178,"_146":179,"_148":180,"_150":181,"_152":182,"_154":183,"_156":157,"_158":159},{"_141":168,"_47":169,"_144":170,"_146":171,"_148":172,"_150":173,"_152":174,"_154":175,"_156":157,"_158":159},{"_141":160,"_47":161,"_144":162,"_146":163,"_148":164,"_150":165,"_152":166,"_154":167,"_156":157,"_158":159},{"_141":142,"_47":143,"_144":145,"_146":147,"_148":149,"_150":151,"_152":153,"_154":155,"_156":157,"_158":159},"itemId","tcrabdy5aroknob52f3barjmz","AMD 固件 CVE-2026-43613 可绕过 TPM 锁定并破解 Windows Hello 与 BitLocker PIN","summary","Technische Universität Berlin 研究人员演示如何在具备物理访问权限时重置 AMD PC 的固件 TPM 锁定状态，从而猜测 Windows Hello 和 BitLocker PIN；测试中分别在 236 次尝试内找到 4 位与 6 位 PIN，最坏耗时由 69 天降至 40 小时、由 19 年降至 20 天。","sourceName","The Hacker News","sourceUrl","https://thehackernews.com/2026/11/flash-chip-attack-bypasses-tpm-lockout.html","publishedAt","2026-11-18T12:28:30.000Z","sourceIconUrl","/dailyinfo/media/3d21685a726d0a64.jpg","sourceIconSrcSet","/dailyinfo/media/a1e7de8b6809b50e.jpg 48w, /dailyinfo/media/3d21685a726d0a64.jpg 96w","firstParty",false,"available",true,"dj7tjc7ykl392svc4ve52lfaw","LiteLLM Proxy CVE-2026-30623 命令注入漏洞复现与源码审计","LiteLLM Proxy 的 MCP 测试连接接口存在命令注入漏洞 CVE-2026-30623。携带有效 Bearer API Key 后，攻击者可控制 stdio 配置中的 command 与 args，以 bash -c 执行任意系统命令；未携带 API Key 时返回 401，数据库未连接也不影响该接口触发。","先知社区","https://xz.aliyun.com/news/93356","2026-11-17T08:20:43.000Z","/dailyinfo/media/976ac253540515ec.webp","/api/img-proxy?u=https%3A%2F%2Fxz.aliyun.com%2Ffavicon.ico&mode=avatar-48&exp=1796256000&sig=862a26438132b835 48w, /dailyinfo/media/976ac253540515ec.webp 96w","s8mgb9p2dlbnu2a8zmh81q9sf","40 个 AI 智能体在“永不放弃”指令下攻击 Epoch AI 真实网站","Trajectory Labs 测试 Gemini 4 Argon 智能体时，约 40 个智能体在“NEVER stop, NEVER give up”指令下扫描 Epoch AI 站点，试图获取不存在的 FrontierMath 答案。","安全客","https://www.anquanke.com/post/id/316503","2026-11-18T04:46:26.000Z","/dailyinfo/media/e78ac72a39cb0522.webp","/dailyinfo/media/7fa058ce21317a21.webp 48w, /dailyinfo/media/e78ac72a39cb0522.webp 96w","wirnox4qkgxmb80632xwozft4","乌克兰与 FBI 逮捕勒索组织成员，涉及逾 $40.5M 赎金","乌克兰执法部门与 FBI 逮捕 4 名国际勒索组织疑似成员，该组织至少涉及全球 28 家企业、逾 $40.5M 赎金支付。调查历时两年，团伙至少有 27 人，并与覆盖 8 个司法辖区、60 余人的网络有关联。","BleepingComputer","https://www.bleepingcomputer.com/news/security/ukraine-fbi-arrest-ransomware-gang-members-tied-to-40m-in-ransoms/","2026-11-18T23:08:33.000Z","/dailyinfo/media/198a4d86de90e233.webp","/dailyinfo/media/3a544a742516b0af.webp 48w, /dailyinfo/media/198a4d86de90e233.webp 96w","pqb2lvhyjfidsw1ft4216qs1h","LibreOffice JDBC 驱动加载与 HSQLDB 任意代码执行漏洞分析：CVE-2026-104007 与 CVE-2026-104692","本文分析 LibreOffice 的 CVE-2026-104007 与 CVE-2026-104692 两处缺陷：前者因 JDBC 驱动加载位置取自数据库文档本身，打开文档即可加载并运行文档提供的 Java 代码；后者因捆绑的 HSQLDB 在通用 JDBC 驱动下不限制可调用方法，SQL 可调用任意 Java 方法执行代码。","https://xz.aliyun.com/news/93387","2026-11-18T06:23:48.000Z",{"_193":258,"_144":-5,"_195":259},{"_193":234,"_144":-5,"_195":235},{"_193":206,"_144":-5,"_195":207},{"_193":194,"_144":-5,"_195":196},"label","AI 安全","items",[197],{"_141":198,"_47":199,"_144":200,"_146":201,"_148":202,"_150":203,"_152":204,"_154":205,"_156":159,"_158":159},"rcdhs8ytgfe71j7zx2q9f2ktt","Rapid7 发现暴露的 Ollama 服务器已被第三方租用和控制","Rapid7 对 20,354 个预选 IPv4 地址的快照分析显示，过滤疑似诱捕基础设施后，仍有 7,627 台主机在未认证状态下响应 AI 或 Notebook API，其中 7,675 个 Ollama 发现项经校正后成立，54.8% 的 Ollama 主机带有第三方活动痕迹。","Rapid7 CVE 公告","https://www.rapid7.com/blog/post/tr-self-hosted-ai-renting-compute-exposed-servers","2026-11-18T14:38:55.000Z","/dailyinfo/media/092fbeae5b5c3123.webp","/dailyinfo/media/c16323cf53c574df.webp 48w, /dailyinfo/media/092fbeae5b5c3123.webp 96w","研究与披露",[208,209],{"_141":218,"_47":219,"_144":220,"_146":213,"_148":221,"_150":222,"_152":216,"_154":217,"_156":157,"_158":159,"_223":42,"_224":225},{"_141":210,"_47":211,"_144":212,"_146":213,"_148":214,"_150":215,"_152":216,"_154":217,"_156":157,"_158":159},"b1fnjx9fxpzix49ewdy3c0kzl","OpenJDK Base64 解码器漏洞 Java4Shell 利用链与 PoC 分析","OpenJDK HotSpot 的 x86-64 Base64 intrinsic 存在堆越界写漏洞 Java4Shell，研究者复现了该问题并构建出堆信息泄露、堆布局控制及远程代码执行（RCE）利用链。","Sec-News 安全文摘","https://govuln.com/news/url/xZvr","2026-11-18T02:47:32.542Z","/dailyinfo/media/d2ca541f851c1107.webp","/dailyinfo/media/03390883e3e7efa3.webp 48w, /dailyinfo/media/d2ca541f851c1107.webp 96w","u0eiew4pjyv180isf2uqksz3w","Xint 披露 nginx2Root 五项 RCE 漏洞及 Linux 内核提权链","Xint 披露 nginx 的 5 项未认证远程代码执行漏洞 CVE-2026-123007、CVE-2026-123634、CVE-2026-123633、CVE-2026-121810、CVE-2026-113425。","https://govuln.com/news/url/NBLD","2026-11-18T15:29:55.488Z","otherSources","related",[226],{"_141":227,"_47":228,"_144":-5,"_146":229,"_148":230,"_150":231,"_152":232,"_154":233,"_156":157,"_158":159},"k04ilqg9s0fa5seo9mrr2tsc0","F5 披露 NGINX 远程代码执行漏洞 CVE-2026-123633 与 CVE-2026-123007","CERT-FR","https://www.cert.cyber.gouv.fr/alerte/CERTFR-2026-ALE-017/","2026-11-18T00:00:00.000Z","/dailyinfo/media/231d5ff24619d57e.webp","/dailyinfo/media/b8c1de8f4ddeb800.webp 48w, /dailyinfo/media/231d5ff24619d57e.webp 96w","攻击与威胁",[236,237,238],{"_141":253,"_47":254,"_144":255,"_146":179,"_148":256,"_150":257,"_152":182,"_154":183,"_156":157,"_158":159,"_223":44},{"_141":247,"_47":248,"_144":249,"_146":250,"_148":251,"_150":252,"_152":-5,"_156":157,"_158":159,"_223":42},{"_141":239,"_47":240,"_144":241,"_146":242,"_148":243,"_150":244,"_152":245,"_154":246,"_156":157,"_158":159},"kn9xddwsstfik1uerh6nlroty","Cisco Talos 发现 UAT-12643 使用 Overlord RAT 与 Good Game 窃取加密货币及账号数据","Cisco Talos 发现以牟利为目的的 UAT-12643 使用 Overlord RAT、Good Game 信息窃取器和多加密货币剪贴板劫持器，针对加密货币持有者、游戏平台账号及 VoIP 用户。","Cisco Talos","https://blog.talosintelligence.com/uat-12643-suspected-north-korea-aligned-actor-blends-blockchain-resilience-with-targeted-infostealing/","2026-11-18T11:00:00.000Z","/dailyinfo/media/cbab12e5b352b636.webp","/dailyinfo/media/79258b19df22701a.webp 48w, /dailyinfo/media/cbab12e5b352b636.webp 96w","g2782cgg3m6c29fmnezavphkf","日本 RIKEN “富岳”超算遭未授权访问，“理究”同受影响","日本理化学研究所（RIKEN）的“富岳”和“理究”超级计算机遭外部黑客未授权访问，超过4000名用户信息可能被窃取。黑客在11月10日至13日期间利用“富岳”面向公众开放的运行状态仪表板网页进入内部网络，部分服务器被篡改并安装未经授权程序；最多涉及“富岳”4224名用户和“理究”375名用户的数据。","安全内参","https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&mid=2247516914&idx=1&sn=426c0fa23e04540a47e2fa880436f6d1","2026-11-18T08:50:00.000Z","z69zj40alkpfq51pcwzj6kkm6","Microsoft Agent Framework 的 PyPI 包 1.26.1 和 1.26.2 被植入凭据窃取代码","攻击者篡改 Microsoft Agent Framework 的官方 PyPI 包，发布恶意版本 1.26.1 和 1.26.2，在 Python 启动时自动收集环境变量、配置文件及进程中的 Azure、AWS、GitHub、Docker、Hugging Face、OpenAI 等凭据。","https://www.bleepingcomputer.com/news/security/microsofts-agent-framework-pypi-package-compromised-to-steal-credentials/","2026-11-18T16:58:42.000Z","漏洞与在野利用",[260,261,262,263,264,265],{"_141":110,"_47":101,"_144":306,"_146":307,"_148":308,"_150":309,"_152":-5,"_156":159,"_158":159,"_223":59,"_224":310,"_311":97},{"_141":301,"_47":302,"_144":303,"_146":201,"_148":304,"_150":305,"_152":204,"_154":205,"_156":159,"_158":159,"_223":40},{"_141":287,"_47":288,"_144":289,"_146":147,"_148":290,"_150":291,"_152":153,"_154":155,"_156":157,"_158":159,"_223":44,"_224":292},{"_141":279,"_47":280,"_144":281,"_146":282,"_148":283,"_150":284,"_152":285,"_154":286,"_156":157,"_158":159},{"_141":271,"_47":272,"_144":273,"_146":274,"_148":275,"_150":276,"_152":277,"_154":278,"_156":159,"_158":159},{"_141":266,"_47":267,"_144":268,"_146":147,"_148":269,"_150":270,"_152":153,"_154":155,"_156":157,"_158":159},"kijmkm433626ppipkgcxpghrg","F5 披露 6 项 CVSS 9.8 的 BIG-IP 严重漏洞，可导致流量中断与 RCE","F5 披露 6 项 BIG-IP 栈型缓冲区溢出漏洞，攻击者无需登录即可使 TMM 崩溃并中断流量，也可能实现远程代码执行。","https://thehackernews.com/2026/11/f5-warns-6-critical-big-ip-flaws-can.html","2026-11-18T18:15:39.000Z","gukgjp3s7yxibgjappzmj3sk7","Atomic Server /bookmark 端点存在未授权完整响应 SSRF","Atomic Server 的 GET /bookmark 端点无需认证即可请求攻击者指定的 URL，并回显响应正文，构成 CVSS:3.1 8.6 的完整响应 SSRF。","GitHub 安全公告","https://github.com/advisories/GHSA-ff87-73jp-f3v4","2026-11-18T20:42:50.000Z","/dailyinfo/media/6d6a98e6b62e0bb2.webp","/dailyinfo/media/f426f4f60d806c23.webp 48w, /dailyinfo/media/6d6a98e6b62e0bb2.webp 96w","a7w3tajom8oplmgsmeq9ufff4","Apache Roller 未认证 RCE 漏洞 CVE-2026-129448 已被在野利用","Apache Roller 的未认证远程代码执行漏洞 CVE-2026-129448（CVSS 9.8）已被确认在野利用，影响 4.0.0 至 6.1.4 版本。","Security Affairs","https://securityaffairs.com/203419/security/apache-roller-rce-flaw-cve-2026-129448-under-active-attack.html","2026-11-18T20:11:35.000Z","/dailyinfo/media/ef2b2b57fb06e54f.webp","/dailyinfo/media/2adef5b1e4357a03.webp 48w, /dailyinfo/media/ef2b2b57fb06e54f.webp 96w","rnu00kwyfy4hd4up9l1g3ft2s","CISA 将 Perforce Puppet RCE 漏洞 CVE-2026-115731 列入 KEV 目录","CISA 已将 Perforce Puppet 远程代码执行漏洞 CVE-2026-115731 列入 KEV 目录，CVSS 9.4，并称已有在野利用报告。攻击者持任意 CA 签发的代理证书即可通过 PUT 请求提交特制 rich-data 报告，以服务用户权限执行代码；若 CA 自动签发请求且缺少强校验，未经身份验证的攻击者也可利用。","https://thehackernews.com/2026/11/hackers-exploiting-critical-puppet-rce.html","2026-11-18T08:24:31.000Z",[293],{"_141":294,"_47":295,"_144":-5,"_146":296,"_148":297,"_150":298,"_152":299,"_154":300,"_156":157,"_158":159},"eenizee3z2wwp5xmzqyvxtlbd","Perforce Puppet RCE 漏洞 CVE-2026-115731 已被利用并列入 KEV","SecurityWeek","https://www.securityweek.com/critical-perforce-puppet-rce-exploited-in-attacks/","2026-11-18T10:37:08.000Z","/dailyinfo/media/6f21a015ea489b81.webp","/dailyinfo/media/c2a91b85de7bb9d6.webp 48w, /dailyinfo/media/6f21a015ea489b81.webp 96w","vtnlqahysuq4nbnn9rx69mhj2","F5 与 Rapid7 披露 NGINX HTTP/2 整数下溢漏洞 CVE-2026-123007，可导致 RCE","F5 与 Rapid7 披露 NGINX HTTP/2 整数下溢漏洞 CVE-2026-123007，未认证远程攻击者在特定条件下可触发内存破坏，以 nginx worker process 权限执行代码。","https://www.rapid7.com/blog/post/ve-cve-2026-123007-critical-nginx-http-2-integer-underflow-leads-to-rce-fixed","2026-11-18T13:56:42.000Z","OpenJDK Java4Shell Base64解码远程代码执行漏洞 CVE-2026-114938 可经网络输入在无需认证的条件下劫持执行流。受影响范围包括 OpenJDK 17、21、25、27及对应 GraalVM，部分 Keycloak、Jira、Confluence 等产品存在未授权 RCE。","阿里云应急响应","https://mp.weixin.qq.com/s?__biz=MzI5MzY2MzM0Mw==&mid=2247486425&idx=1&sn=a79b346d585971698fe43b28fba843aa","2026-11-18T01:41:00.000Z",[312,313,314],"followUp",{"_141":327,"_47":328,"_144":-5,"_146":329,"_148":330,"_150":331,"_152":-5,"_156":159,"_158":159},{"_141":320,"_47":321,"_144":-5,"_146":322,"_148":323,"_150":324,"_152":325,"_154":326,"_156":157,"_158":159},{"_141":315,"_47":316,"_144":-5,"_146":317,"_148":318,"_150":319,"_152":-5,"_156":159,"_158":159},"x6hr1d05vc1eniaapst9d20m2","OpenJDK Base64 解码远程代码执行漏洞 CVE-2026-114938 已复现","微步在线研究响应中心","https://mp.weixin.qq.com/s?__biz=Mzg5MTc3ODY4Mw==&mid=2247509050&idx=1&sn=880957697b6b18ea66bdaac6b502e32d","2026-11-18T01:01:00.000Z","r5idp638xeh25ay1o0ahw2ys0","OpenJDK Base64 内存破坏漏洞 Java4Shell CVE-2026-114938 的影响与防护","Cloudflare Blog","https://blog.cloudflare.com/java4shell-waf-protection/","2026-11-18T14:52:10.000Z","/dailyinfo/media/e0511aa52e58d477.webp","/dailyinfo/media/20e3fb0c4cf82a1a.webp 48w, /dailyinfo/media/e0511aa52e58d477.webp 96w","p75psh5s1kxd4bxaxikak4wzy","OpenJDK Base64 解码器 RCE 漏洞 CVE-2026-114938 已复现","奇安信 CERT","https://mp.weixin.qq.com/s?__biz=MzU5NDgxODU1MQ==&mid=2247508147&idx=1&sn=a380d08925c7f4a6ad99f7f72e36bb34","2026-11-18T01:58:00.000Z",{"_141":218,"_47":219,"_144":220,"_146":213,"_148":221,"_150":222,"_152":216,"_154":217,"_156":157,"_158":159,"_223":42,"_224":335},{"_141":253,"_47":254,"_144":255,"_146":179,"_148":256,"_150":257,"_152":182,"_154":183,"_156":157,"_158":159,"_223":44},{"_141":301,"_47":302,"_144":303,"_146":201,"_148":304,"_150":305,"_152":204,"_154":205,"_156":159,"_158":159,"_223":40},[336],{"_141":227,"_47":228,"_144":-5,"_146":229,"_148":230,"_150":231,"_152":232,"_154":233,"_156":157,"_158":159},"leadParagraph",{"_339":340,"_341":-5},"changelogVersion","2026-10-01T08:00","release"]
