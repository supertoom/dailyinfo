,160],"flashes",[117,118,119],"cover",{"_110":111,"_112":113,"_114":-5,"_115":-5,"_116":-5},"metrics",{"_105":66,"_106":60,"_107":108,"_109":35},"readingMinutes","prev","next","totalEvents","sourcesCount","modelsReleased",0,"firstPartyEvents","url","/dailyinfo/media/f57f254bf26879cf.webp","srcSet","/dailyinfo/media/2e9f7eb8d6c7871f.webp 720w, /dailyinfo/media/7b45619176daf7ed.webp 1200w, /dailyinfo/media/f57f254bf26879cf.webp 1600w","width","height","caption",{"_120":149,"_42":150,"_123":151,"_125":152,"_127":153,"_129":154,"_131":155,"_133":156,"_135":136,"_137":138},{"_120":141,"_42":142,"_123":143,"_125":144,"_127":145,"_129":146,"_131":147,"_133":148,"_135":136,"_137":138,"_139":37,"_140":53},{"_120":121,"_42":122,"_123":124,"_125":126,"_127":128,"_129":130,"_131":132,"_133":134,"_135":136,"_137":138,"_139":37,"_140":47},"itemId","laakttrd05itv4q9m1wlul5oo","TianoCore 披露 EDK II PXE 驱动漏洞 CVE-2026-97631，CVSS 9.5","summary","TianoCore 披露 EDK II PXE 网络启动驱动漏洞 CVE-2026-97631，CVSS 4.0 评分 9.5，IPv4 与 IPv6 handler 均因 504 字节字段的拷贝边界错误而可遭越界写入。","sourceName","安全客","sourceUrl","https://www.anquanke.com/post/id/316426","publishedAt","2026-11-05T03:28:56.000Z","sourceIconUrl","/dailyinfo/media/e78ac72a39cb0522.webp","sourceIconSrcSet","/dailyinfo/media/7fa058ce21317a21.webp 48w, /dailyinfo/media/e78ac72a39cb0522.webp 96w","firstParty",false,"available",true,"otherSources","followUp","rbs5a4cooic8qrwid6xbbqk1h","Zyxel GS1900 交换机补丁遗漏漏洞 CVE-2026-107441，10 个固件版本仍受影响","Binarly 分析发现，Zyxel GS1900 交换机的 CVE-2026-107441 是 Web 管理程序中的越界写漏洞，Zyxel 评分为 8.8，Binarly 评分为 9.8；双方对利用前提存在分歧。","Infosecurity Magazine","https://www.infosecurity-magazine.com/news/zyxel-gs1900-patch-missed-flaw/","2026-11-05T15:15:00.000Z","/dailyinfo/media/b3cc9cd29f272a5a.webp","/dailyinfo/media/6406d1b57afc7303.webp 48w, /dailyinfo/media/b3cc9cd29f272a5a.webp 96w","aza6eimfkt52zsrd63mp6skub","Amadeus 遭网络攻击致亚洲六大航空公司客户数据泄露","IT 供应商 Amadeus 遭网络攻击后，日本航空、国泰航空、大韩航空、韩亚航空、新加坡航空和马来西亚航空确认客户数据泄露。","安全内参","https://www.secrss.com/articles/95393","2026-11-05T16:55:15.297Z","/dailyinfo/media/77459fcbf8f21e71.webp","/dailyinfo/media/3399ea7b18d18a6a.webp 48w, /dailyinfo/media/77459fcbf8f21e71.webp 96w",{"_161":242,"_123":-5,"_163":243},{"_161":180,"_123":-5,"_163":181},{"_161":169,"_123":-5,"_163":170},{"_161":162,"_123":-5,"_163":164},"label","AI 安全","items",[165],{"_120":90,"_42":58,"_123":166,"_125":152,"_127":167,"_129":168,"_131":155,"_133":156,"_135":136,"_137":138,"_139":37},"OpenAI 使用尚未发布的网络安全模型和 AI Agent 流水线扫描 Linux 内核，在 10 天内发现、复现并利用 948 个独立本地提权漏洞，总花费 120万美元。","https://www.secrss.com/articles/95365","2026-11-05T01:42:25.753Z","研究与披露",[171],{"_120":172,"_42":173,"_123":174,"_125":175,"_127":176,"_129":177,"_131":178,"_133":179,"_135":136,"_137":138},"aeb809z3vyorh7x5j0588tlw3","Check Point Research 揭示 ChatGPT Lockdown Mode 绕过漏洞","Check Point Research 发现 ChatGPT HTML 页面预览的沙箱绕过漏洞，可绕过 Lockdown Mode 窃取完整聊天历史与上传文件，并通过伪造窗口投递恶意软件或窃取凭据。","Check Point Research","https://research.checkpoint.com/2026/chatgpt-lockdown-mode-bypass-phishing-malware-delivery-and-silent-data-exfiltration/","2026-11-05T14:00:11.000Z","/dailyinfo/media/eb5a4204ed5bdd38.webp","/dailyinfo/media/847ca4554cd8d31b.webp 48w, /dailyinfo/media/eb5a4204ed5bdd38.webp 96w","攻击与威胁",[182,183,184,185,186,187,188,189],{"_120":238,"_42":239,"_123":240,"_125":152,"_127":241,"_129":154,"_131":155,"_133":156,"_135":136,"_137":138,"_139":35},{"_120":232,"_42":233,"_123":234,"_125":235,"_127":236,"_129":237,"_131":-5,"_135":136,"_137":138},{"_120":227,"_42":228,"_123":229,"_125":126,"_127":230,"_129":231,"_131":132,"_133":134,"_135":136,"_137":138},{"_120":219,"_42":220,"_123":221,"_125":222,"_127":223,"_129":224,"_131":225,"_133":226,"_135":136,"_137":138},{"_120":211,"_42":212,"_123":213,"_125":214,"_127":215,"_129":216,"_131":217,"_133":218,"_135":136,"_137":138},{"_120":206,"_42":207,"_123":208,"_125":126,"_127":209,"_129":210,"_131":132,"_133":134,"_135":136,"_137":138,"_139":37},{"_120":198,"_42":199,"_123":200,"_125":201,"_127":202,"_129":203,"_131":204,"_133":205,"_135":136,"_137":138,"_139":45},{"_120":190,"_42":191,"_123":192,"_125":193,"_127":194,"_129":195,"_131":196,"_133":197,"_135":136,"_137":138,"_139":37},"k9m1aemrbm2gwfwjok8ooel6i","UNM Health 遭遇网络安全事件，关闭急诊资源并转移患者","UNM Health 在 10 月 26 日遭遇网络安全事件，迫使救护车转向其他医院、取消 30 多家诊所的预约，并暂停部分门诊手术；其 Albuquerque 医院是 New Mexico 唯一的 Level 1 创伤中心。","Security Affairs","https://securityaffairs.com/202495/security/unm-health-shuts-clinics-and-diverts-patients-during-security-incident.html","2026-11-05T13:48:57.000Z","/dailyinfo/media/ef2b2b57fb06e54f.webp","/dailyinfo/media/2adef5b1e4357a03.webp 48w, /dailyinfo/media/ef2b2b57fb06e54f.webp 96w","a55xwfne2cfqa93ovn0mflfxz","攻击者借 GitHub 分发仿冒 ChatGPT 与 Claude 应用，Yoba 恶意软件借 DLL sideloading 安装挖矿程序","攻击者通过 GitHub Pages 和 GitHub releases 分发仿冒“GPT-5.6 Sol”“GPT-6 Astra”及“Claude Opus”桌面应用。","Hackread","https://hackread.com/fake-chatgpt-claude-apps-software-yoba-malware/","2026-11-05T11:15:00.000Z","/dailyinfo/media/dd06beac4cadc6f3.webp","/dailyinfo/media/47417cbef4636b7b.webp 48w, /dailyinfo/media/dd06beac4cadc6f3.webp 96w","xkdscbx30se27tz9zmlkauf28","Cathedral使用AI Agent在12小时内渗透Anthropic内部Slack及敏感系统","Cathedral使用自研AI Agent参加Anthropic外部漏洞悬赏测试，从第三方商业软件的漏洞切入，自动扫描并串联权限，12小时内访问销售、人力资源和IT系统，以及会议记录、员工薪资与录用待遇、部分客户联系方式和基础用户账户记录，还进入Slack查看AI模型研发讨论。","https://www.anquanke.com/post/id/316429","2026-11-05T03:32:53.000Z","wfjd5fodjznr45vhjx8weohr1","CERT-In 披露 Crafty Falcon 利用 ARTEX 等 AI 攻击工具攻击印度 BFSI，仿冒 ARTEX 镜像后门暴露 62 个控制台","CERT-In 披露，名为 Crafty Falcon 的 AI 辅助威胁行为者正持续攻击印度 BFSI、加密货币交易所和数字资产服务商，利用 ARTEX、PentAGI、Cairn 和 CyberStrikeAI 自主生成攻击脚本、轮换基础设施并窃取密钥与资金。","The Hacker News","https://thehackernews.com/2026/11/backdoored-docker-image-for-artex-ai.html","2026-11-05T08:42:03.000Z","/dailyinfo/media/3d21685a726d0a64.jpg","/dailyinfo/media/a1e7de8b6809b50e.jpg 48w, /dailyinfo/media/3d21685a726d0a64.jpg 96w","dxhu6zoooyev95kp3k297dewf","CrowdStrike 披露攻击者利用公开 PoC 快速武器化漏洞","攻击者正快速把公开漏洞研究改造成可部署的利用工具。CrowdStrike 在 2026 年 1 月至 7 月观察到，公开 PoC 至在野利用的中位时间不足 1 天，最快为 35 分钟，91% 的已观察利用在 PoC 发布后 48 小时内发生。","CrowdStrike","https://www.crowdstrike.com/en-us/blog/adversaries-turn-vulnerability-ecosystem-against-defenders/","2026-11-05T06:00:00.000Z","/dailyinfo/media/4bb18fbefa568e31.webp","/dailyinfo/media/f338ab1b3d8b6c40.webp 48w, /dailyinfo/media/4bb18fbefa568e31.webp 96w","t64dzyrhwjxq4w3f17eo3t1l7","欧洲多国超市冷柜遭远程操控加热，Danfoss 旧固件漏洞被用于攻击","瑞典、爱尔兰、比利时、卢森堡和爱沙尼亚的连锁超市冷柜近期被远程设为50℃，其中SuperValu 223家门店中13家受影响，未出现勒索信且暂无官方归因。此前法国10月11日事件涉及Intermarché约150家门店、Carrefour 80家门店及Monoprix约490家门店中的5%，ANSSI调查指向运行过时固件的Danfoss制冷控制软件。","https://www.anquanke.com/post/id/316435","2026-11-05T03:44:53.000Z","iio02tqqqxbdf0qt1kdr6gjku","Load/Mine 利用 AI 模型仓库植入 GPU 挖矿后门，两波波及 31 个仓库","Load/Mine 活动利用 Transformers 的 trust_remote_code=True 加载恶意模型仓库中的 Python 代码，两波核心活动涉及 31 个仓库、29,818 次下载，计入 13 个仅具技术关联的模型后共 44 个仓库、32,376 次下载。","奇安信威胁情报中心","https://mp.weixin.qq.com/s?__biz=MzI2MDc2MDA4OA==&mid=2247521244&idx=1&sn=e8992e0f55281e055dbc99ffe2538195","2026-11-05T09:07:00.000Z","zty74ssg50q1mndnvfzwhfqfu","Crédit Mutuel Arkéa 遭复杂网络攻击，约 1.33 亿美元疑遭窃取","法国大型银行 Crédit Mutuel Arkéa 证实遭遇高度复杂的网络攻击，攻击者入侵一家未具名服务供应商的平台，并利用银行自有账户向其他银行机构转账，疑经专业平台兑换为加密货币。","https://www.secrss.com/articles/95392","漏洞与在野利用",[244,245],{"_120":251,"_42":252,"_123":253,"_125":254,"_127":255,"_129":256,"_131":-5,"_135":138,"_137":138,"_140":47},{"_120":246,"_42":247,"_123":248,"_125":144,"_127":249,"_129":250,"_131":147,"_133":148,"_135":136,"_137":138,"_139":37},"sisdj0yaov9roze0fz616pp5i","Bitdefender 披露 Android GhostMap 漏洞，重启循环仅能通过恢复出厂设置解除","Bitdefender 发现 Android OS 的 GhostMap 漏洞，畸形 ZIP 条目中的压缩方式和声明的未压缩长度会被错误处理，读取时可触发 SIGBUS。","https://www.infosecurity-magazine.com/news/ghostmap-bug-android-phones-stuck/","2026-11-05T10:15:00.000Z","ytzdcdfugpd0nnciko21ou59j","Synology DSM 身份认证绕过漏洞 CVE-2026-13639 已复现并被勒索软件利用","Synology DSM 身份认证绕过漏洞 CVE-2026-13639 已被 C3RB3R / L0CK3D 勒索软件用于初始入侵，奇安信 CERT 已完成复现。","奇安信 CERT","https://mp.weixin.qq.com/s?__biz=MzU5NDgxODU1MQ==&mid=2247508031&idx=1&sn=be47d2b6316db564dc261a0d5a42bcd1","2026-11-05T11:48:00.000Z",{"_120":251,"_42":252,"_123":253,"_125":254,"_127":255,"_129":256,"_131":-5,"_135":138,"_137":138,"_140":47},{"_120":238,"_42":239,"_123":240,"_125":152,"_127":241,"_129":154,"_131":155,"_133":156,"_135":136,"_137":138,"_139":35},{"_120":232,"_42":233,"_123":234,"_125":235,"_127":236,"_129":237,"_131":-5,"_135":136,"_137":138},"leadParagraph",{"_262":263,"_264":-5},"changelogVersion","2026-10-01T08:00","release"]
