:149,"_120":192,"_122":193,"_124":152,"_126":153,"_128":145,"_130":129},{"_113":184,"_34":185,"_116":186,"_118":157,"_120":187,"_122":188,"_124":160,"_126":161,"_128":145,"_130":129},{"_113":176,"_34":177,"_116":178,"_118":179,"_120":180,"_122":181,"_124":182,"_126":183,"_128":129,"_130":129},{"_113":170,"_34":171,"_116":172,"_118":173,"_120":174,"_122":175,"_124":-5,"_128":145,"_130":129},{"_113":162,"_34":163,"_116":164,"_118":165,"_120":166,"_122":167,"_124":168,"_126":169,"_128":145,"_130":129},{"_113":154,"_34":155,"_116":156,"_118":157,"_120":158,"_122":159,"_124":160,"_126":161,"_128":145,"_130":129},{"_113":146,"_34":147,"_116":148,"_118":149,"_120":150,"_122":151,"_124":152,"_126":153,"_128":145,"_130":129},{"_113":139,"_34":140,"_116":141,"_118":142,"_120":143,"_122":144,"_124":-5,"_128":145,"_130":129},{"_113":131,"_34":132,"_116":133,"_118":134,"_120":135,"_122":136,"_124":137,"_126":138,"_128":129,"_130":129},{"_113":114,"_34":115,"_116":117,"_118":119,"_120":121,"_122":123,"_124":125,"_126":127,"_128":129,"_130":129},"itemId","q5v1vxau0e4lym0x3ogx6pet0","Chrome 156 稳定版修复 21 项安全漏洞，CVE-2026-76024 为严重级别","summary","Chrome Stable 和 Extended Stable 渠道已更新至 Windows 和 Mac 的 156.0.8078.79/.80、Linux 的 156.0.8078.79，将在未来几天至几周内推送。","sourceName","Chrome Releases","sourceUrl","http://chromereleases.googleblog.com/2026/10/stable-channel-update-for-desktop_02107719452.html","publishedAt","2026-10-29T21:26:20.252Z","sourceIconUrl","/dailyinfo/media/2804b677dd1e2bc0.webp","sourceIconSrcSet","/dailyinfo/media/a673d47722466a30.webp 48w, /dailyinfo/media/2804b677dd1e2bc0.webp 96w","firstParty",true,"available","m2hxnar81fkukx8bj4wepsqav","CISA 将两项 Ivanti Connect Secure 漏洞纳入 KEV Catalog","CISA 基于真实利用证据，将 Ivanti Connect Secure 的 CVE-2026-111357（关键功能缺失认证）和 CVE-2026-118527（可预测数字或标识符生成漏洞）纳入 KEV Catalog。","CISA 安全公告","https://www.cisa.gov/news-events/alerts/2026/10/30/cisa-adds-two-known-exploited-vulnerabilities-catalog","2026-10-30T12:00:00.000Z","/dailyinfo/media/c65213b8bb0b8c32.webp","/dailyinfo/media/f4741f74a4c97912.webp 48w, /dailyinfo/media/c65213b8bb0b8c32.webp 96w","fp6xofbj8sbfomr2rwpqm1csk","Cerber 变种利用 CVE-2026-13639 和 CVE-2026-13684 加密群晖 NAS 文件","Cerber 勒索变种 C3RB3R 已利用 CVE-2026-13639 和 CVE-2026-13684 攻击群晖 NAS，并使用 ChaCha8 与 RSA2048 加密文件、改名为 .L0CK3D 并留下勒索信。","安全客","https://mp.weixin.qq.com/s?__biz=MzA5ODA0NDE2MA==&mid=2649790660&idx=2&sn=6aae1577ea183279c10c0be20ff7fa52","2026-10-30T02:24:00.000Z",false,"m1ed08v93m476v6cel7apeyzz","Trezor 警告 CryptoBilis 售出的 Safe 5 钱包疑似被植入外传恢复短语的电路板","Trezor 收到印度尼西亚客户报告，称其经 Tokopedia 从 CryptoBilis 购买的 Safe 5 硬件钱包疑似被加入带蜂窝模块和天线的额外电路板，可读取恢复短语并在设备接入时通过移动网络发送。","The Hacker News","https://thehackernews.com/2026/10/trezor-warns-of-suspected-hardware.html","2026-10-30T12:21:56.000Z","/dailyinfo/media/3d21685a726d0a64.jpg","/dailyinfo/media/a1e7de8b6809b50e.jpg 48w, /dailyinfo/media/3d21685a726d0a64.jpg 96w","glatn3tjkd7asayca5ypq0866","Amadeus 旅客服务系统遭未授权访问，Japan Airlines 约 92,000 名客户数据泄露","Amadeus 旅客服务系统遭未授权访问，导致 Japan Airlines 约 92,000 名客户数据泄露，攻击者于 2023 年 8 月 10 日至 2026 年 9 月 23 日间获取订座代码、姓名、航班日期、路线及舱位等信息，另有 2,000 名客户的邮箱、电话、护照号等数据暴露。","BleepingComputer","https://www.bleepingcomputer.com/news/security/japan-airlines-suffers-third-party-data-breach-exposing-passenger-info/","2026-10-29T22:08:04.000Z","/dailyinfo/media/198a4d86de90e233.webp","/dailyinfo/media/3a544a742516b0af.webp 48w, /dailyinfo/media/198a4d86de90e233.webp 96w","vv489im3zncsb62sidnpbvifn","Binance 遭遇 $6.3bn 加密货币盗窃，已冻结 $3bn","Binance 确认遭遇史上规模最大的网络攻击，$6.3bn 加密货币被盗，已冻结 $3bn 赃款，并将通过 Secure Asset Fund for Users (SAFU) 和公司资金赔偿全部损失。","Infosecurity Magazine","https://www.infosecurity-magazine.com/news/binance-record-hack-crypto-heist/","2026-10-30T11:25:00.000Z","/dailyinfo/media/b3cc9cd29f272a5a.webp","/dailyinfo/media/6406d1b57afc7303.webp 48w, /dailyinfo/media/b3cc9cd29f272a5a.webp 96w","lponhstdrxji23aq6ua7qhae7","币安疑遭黑客攻击，被盗资产或超420亿元","币安披露潜在安全事件，称截至10月30日已冻结资金总额约30亿美元，并承担全部黑客攻击损失。Arkham首席执行官MiguelMorel表示，数十亿美元资产疑被身份不明的攻击者盗取，但具体原因尚未确认；此前相关钱包出现异常资金转出。","安全内参","https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&mid=2247516805&idx=2&sn=3e61732c196efcd144aad1180f43fde8","2026-10-30T10:23:00.000Z","bgct23sln3v94uqcpsqtd9kwd","@hapi/content 6.0.2 及更早版本 Content-Disposition 解析可导致拒绝服务","@hapi/content 的 Content.disposition() 在解析缺少“=”的长 Content-Disposition 参数时呈二次时间复杂度，未认证攻击者可用单个 multipart/form-data 上传请求阻塞 Node.js 事件循环数秒至数分钟。","GitHub 安全公告","https://github.com/advisories/GHSA-8494-f6mr-cjpv","2026-10-30T23:10:13.000Z","/dailyinfo/media/6d6a98e6b62e0bb2.webp","/dailyinfo/media/f426f4f60d806c23.webp 48w, /dailyinfo/media/6d6a98e6b62e0bb2.webp 96w","jp4m1qw9jcqdjssxmkm0ramgj","Hugging Face 恶意模型挖矿活动死灰复燃，GitHub 假 Solana 工具包瞄准 AI 编码代理","Pluto Security 在 Hugging Face 发现针对自托管 GPU 推理主机的挖矿与后门活动，7 个账号下的 31 个仓库伪装成 Qwen2 测试模型。","https://www.bleepingcomputer.com/news/security/hugging-face-malware-campaign-returns-to-hijack-gpus-for-crypto-mining/","2026-10-29T22:09:24.000Z","zp0y7xwgmp4okzaui4wl99q77","WordPress Core RCE 漏洞在 24 小时内招致 62,969 次攻击尝试","WordPress Core 4.7 至 7.1.3 的 RCE 漏洞已被用于攻击尝试，Wordfence 在 24 小时内拦截 62,969 次攻击。该漏洞尚无 CVE 编号，CVSS 为 8.1，依靠完整升级包解压时位于 wp-content/upgrade 的可预测暂存目录形成竞争窗口，未认证攻击者在恰当时机请求安装程序即可推进至 PHP 代码执行。","https://thehackernews.com/2026/10/wordpress-rce-flaw-draws-nearly-63000.html","2026-10-30T14:08:14.000Z",{"_197":280,"_116":-5,"_199":281},{"_197":210,"_116":-5,"_199":211},{"_197":198,"_116":-5,"_199":200},"label","研究与披露","items",[201],{"_113":202,"_34":203,"_116":204,"_118":205,"_120":206,"_122":207,"_124":208,"_126":209,"_128":129,"_130":129},"els1gzklnlhxhh0k15ljle1lp","Rapid7 分析 BeyondTrust Remote Support 未认证文件上传至 RCE 漏洞 CVE-2026-102764","Rapid7 分析 BeyondTrust Remote Support 的来源校验缺陷 CVE-2026-102764，未认证攻击者可伪造本地消息来源，访问原生文件传输服务，写入任意文件并以站点操作系统用户身份执行代码，无需账户凭据或用户交互。","Rapid7 CVE 公告","https://www.rapid7.com/blog/post/ra-rapid7-analysis-unauthenticated-file-upload-to-rce-in-beyondtrust-remote-support-cve-2026-102764","2026-10-30T16:01:53.000Z","/dailyinfo/media/092fbeae5b5c3123.webp","/dailyinfo/media/c16323cf53c574df.webp 48w, /dailyinfo/media/092fbeae5b5c3123.webp 96w","攻击与威胁",[212,213,214,215,216,217],{"_113":77,"_34":41,"_116":266,"_118":235,"_120":267,"_122":268,"_124":238,"_126":239,"_128":145,"_130":129,"_240":43,"_246":269},{"_113":261,"_34":262,"_116":263,"_118":149,"_120":264,"_122":265,"_124":152,"_126":153,"_128":145,"_130":129,"_240":40},{"_113":241,"_34":242,"_116":243,"_118":149,"_120":244,"_122":245,"_124":152,"_126":153,"_128":145,"_130":129,"_240":37,"_246":247},{"_113":232,"_34":233,"_116":234,"_118":235,"_120":236,"_122":237,"_124":238,"_126":239,"_128":145,"_130":129,"_240":33},{"_113":226,"_34":227,"_116":228,"_118":229,"_120":230,"_122":231,"_124":-5,"_128":145,"_130":129},{"_113":218,"_34":219,"_116":220,"_118":221,"_120":222,"_122":223,"_124":224,"_126":225,"_128":145,"_130":129},"ashq9zaym8iojmnulqhy7xxeb","Cloudflare披露eMudhra弱密钥证书利用迹象与访客补丁进度","eMudhra的8个弱中间CA私钥可由公开证书近乎即时恢复，攻击者已在密钥公开后数小时内伪造证书。Cloudflare发现约22,000次使用弱密钥的TLS握手尝试，其中约160次证书SAN指向无关组织域名，但没有证据表明弱密钥被用于拦截Cloudflare连接。","Cloudflare Blog","https://blog.cloudflare.com/emudhra-patching/","2026-10-30T17:38:50.000Z","/dailyinfo/media/e0511aa52e58d477.webp","/dailyinfo/media/20e3fb0c4cf82a1a.webp 48w, /dailyinfo/media/e0511aa52e58d477.webp 96w","kh5zbp42tkmy1pgddvyma6sb0","zkLink 遭攻击损失约 78.3 万美元，Arbitrator 合约验证逻辑被绕过","跨链协议 zkLink 于 2026 年 10 月 29 日遭攻击，损失约 78.3 万美元。","慢雾科技","https://mp.weixin.qq.com/s?__biz=MzU4ODQ3NTM2OA==&mid=2247506498&idx=1&sn=a7646de265d6c5c01cf91b8b5cb91480","2026-10-30T11:20:00.000Z","gu6ue1ilx7hnlwxcatqdphg4v","自称 Department of Peace 的黑客泄露逾 41,000 名 DHS 员工记录","自称 Department of Peace 的黑客组织泄露了超过 41,000 名美国国土安全部（DHS）员工的姓名、办公室、联系方式和任务信息，并交由 Distributed Denial of Secrets 发布为 Icepick；该组织称数据取自 DHS 使用的 Okta SSO 服务，Okta 否认其系统被攻破。","Help Net Security","https://www.helpnetsecurity.com/2026/10/29/icepick-dhs-leak-ice-undercover-agents/","2026-10-29T10:16:18.000Z","/dailyinfo/media/06c9ab9de6dbb6a5.webp","/dailyinfo/media/9c1b5fa87b3bafc5.webp 48w, /dailyinfo/media/06c9ab9de6dbb6a5.webp 96w","otherSources","kap6lzk1o51rm638fm4tiscnh","攻击者尝试利用 Alpine Linux GitLab 的 CVE-2026-97229 漏洞，CVSS 10.0","攻击者试图利用 Alpine Linux 自有 GitLab 服务器的 CVE-2026-97229 漏洞，该漏洞 CVSS 10.0，可通过构造的 CI 正则表达式在特定条件下执行代码。","https://thehackernews.com/2026/10/attacker-tried-to-exploit-alpine-linuxs.html","2026-10-29T09:05:39.000Z","related",[248,249],{"_113":257,"_34":258,"_116":-5,"_118":157,"_120":259,"_122":260,"_124":160,"_126":161,"_128":145,"_130":129},{"_113":250,"_34":251,"_116":-5,"_118":252,"_120":253,"_122":254,"_124":255,"_126":256,"_128":145,"_130":129},"vlrtoue70s86b9kd5x4xc1iep","CISA 将 GitLab CVE-2026-97229 与 Cisco CVE-2026-76418 加入 KEV 目录","Security Affairs","https://securityaffairs.com/202133/security/u-s-cisa-adds-gitlab-and-cisco-flaws-to-its-known-exploited-vulnerabilities-catalog.html","2026-10-30T20:25:14.000Z","/dailyinfo/media/ef2b2b57fb06e54f.webp","/dailyinfo/media/2adef5b1e4357a03.webp 48w, /dailyinfo/media/ef2b2b57fb06e54f.webp 96w","a77687psbwtwdel3liqk60g1m","CISA确认GitLab严重漏洞CVE-2026-97229已遭在野利用","https://www.bleepingcomputer.com/news/security/hackers-now-exploiting-max-severity-gitlab-flaw-in-attacks/","2026-10-30T13:00:32.000Z","vjdhd6f9hgfqlc9p5znn3m95n","Cursor Marketplace 上架的 Claude Code 扩展被植入持久化 SSH 后门","Cursor Marketplace 中被篡改的官方 Claude Code VS Code 扩展会安装持久化 SSH 后门，影响至多 5,000 名用户。","https://thehackernews.com/2026/10/official-claude-code-vs-code-extension.html","2026-10-30T08:55:47.000Z","Binance 约 63 亿美元加密货币被盗，TRM Labs 与 Chainalysis 均高置信度将攻击归因于朝鲜组织 TraderTraitor。初步调查显示，攻击者可能从一台被攻陷的 DevOps 工程师笔记本进入服务容器，提交未授权提现交易，并攻陷热钱包签名基础设施；Ethereum 上涉及 50 个预先签署的授权。","https://www.helpnetsecurity.com/2026/10/30/binance-crypto-hack/","2026-10-30T08:26:13.000Z",[270,271],{"_113":276,"_34":277,"_116":-5,"_118":157,"_120":278,"_122":279,"_124":160,"_126":161,"_128":145,"_130":129},{"_113":272,"_34":273,"_116":-5,"_118":149,"_120":274,"_122":275,"_124":152,"_126":153,"_128":145,"_130":129},"iwtusdzn5wb1h99k62ra7mgiw","Binance 遭安全事件，约 $6.3 billion 资产受影响，近 $3 billion 已冻结","https://thehackernews.com/2026/10/binance-suffers-security-breach.html","2026-10-30T04:14:59.000Z","dxt9daic7ndizxxkgdtie70sv","Binance 调查潜在 $5.8 billion 加密资产被盗事件","https://www.bleepingcomputer.com/news/security/binance-probes-potential-58-billion-crypto-theft-hack/","2026-10-29T22:45:23.000Z","漏洞与在野利用",[282,283,284,285,286],{"_113":312,"_34":313,"_116":314,"_118":157,"_120":315,"_122":316,"_124":160,"_126":161,"_128":145,"_130":129,"_240":43,"_246":317},{"_113":307,"_34":308,"_116":309,"_118":157,"_120":310,"_122":311,"_124":160,"_126":161,"_128":145,"_130":129},{"_113":300,"_34":301,"_116":302,"_118":303,"_120":304,"_122":305,"_124":-5,"_128":129,"_130":129,"_306":31},{"_113":295,"_34":296,"_116":297,"_118":179,"_120":298,"_122":299,"_124":182,"_126":183,"_128":129,"_130":129},{"_113":287,"_34":288,"_116":289,"_118":290,"_120":291,"_122":292,"_124":293,"_126":294,"_128":145,"_130":129,"_240":33},"ae96k4vyaf9n7mzfdlf9k8j1e","TeamViewer 远程支持漏洞 CVE-2026-111585 可在技术支持人员电脑上执行代码","TeamViewer 的屏幕解压组件存在 CVE-2026-111585，攻击者控制或攻陷被远程连接的设备后，可诱导技术支持人员接受连接，并在未打补丁的电脑上利用整数溢出与堆溢出执行攻击者代码。TeamViewer 于 2026 年 10 月 27 日发布 15.83 版本修复，该漏洞 CVSS 为 8.8、等级为 High；官方未发现已被在野利用的证据，并建议用户更新至最新版本。","Hackread","https://hackread.com/teamviewer-vulnerability-code-it-support-staff-pcs/","2026-10-30T18:35:09.000Z","/dailyinfo/media/dd06beac4cadc6f3.webp","/dailyinfo/media/47417cbef4636b7b.webp 48w, /dailyinfo/media/dd06beac4cadc6f3.webp 96w","ndo10izcxlkye6sdeutgereno","Rust zip 9.0.0-pre3 暴露 Zip Slip 任意文件写入漏洞","Rust zip 9.0.0-pre3 存在任意文件写入漏洞，影响 7.2.0 及更高版本，攻击者需知道或猜中解压目标的绝对路径。","https://github.com/advisories/GHSA-hjqx-j4rw-g7xv","2026-10-29T16:40:12.000Z","q1vo28ns0qmqkpolmr1fhziql","Google Brotli C 解码器 RCE 漏洞 CVE-2026-111497 影响 Node.js 等多类产品","Google Brotli C 解码器存在越界写入漏洞 CVE-2026-111497，CVSS 4.0 9.2，处理畸形 Brotli 数据时可能导致拒绝服务、进程内存读取和远程代码执行。","微步在线研究响应中心","https://mp.weixin.qq.com/s?__biz=Mzg5MTc3ODY4Mw==&mid=2247509017&idx=1&sn=e3b3303980b0cb8640b92b141c510261","2026-10-29T06:32:00.000Z","followUp","obhfumhh687s8ss7ottgn00g5","CISA 警告 Linux 内核 Fragnesia 漏洞 CVE-2026-46300 已与 PHP2Shell 在野利用","CISA 警告 Fragnesia Linux 内核提权漏洞 CVE-2026-46300 已与 PHP2Shell 漏洞（CVE-2026-109618、CVE-2026-109619）在野利用，可植入 PHP webshell 并以 root 权限运行命令。","https://www.bleepingcomputer.com/news/security/cisa-warns-of-fragnesia-linux-flaw-chained-in-php2shell-attacks/","2026-10-29T13:59:48.000Z","o4jhgucdw0y08zpd9xy9goxcn","Linux 内核 CVE-2026-98432 可导致 MPTCP 服务器远程 root 提权","Anthropic 研究人员利用 CVE-2026-98432 实现了针对启用 MPTCP 监听器的 Linux 服务器的远程 root 代码执行。该漏洞是 Linux 内核 IPv4 TCP 网络代码中的 use-after-free 与竞态条件问题，CVSS 9.8，也影响普通 TCP 连接；其利用需要触发竞态，Red Hat 将其评为 5.9 并认为可能导致内核崩溃。","https://www.bleepingcomputer.com/news/security/critical-linux-kernel-flaw-allows-remote-root-attacks-on-mptcp-servers/","2026-10-30T21:09:46.000Z",[318,319],{"_113":324,"_34":325,"_116":-5,"_118":326,"_120":327,"_122":328,"_124":-5,"_128":129,"_130":129},{"_113":320,"_34":321,"_116":-5,"_118":303,"_120":322,"_122":323,"_124":-5,"_128":129,"_130":129},"kqta6ndk8fh7dpovusz5qldoh","Linux kernel TCP UAF 漏洞 CVE-2026-98432 复现与利用链分析","https://mp.weixin.qq.com/s?__biz=Mzg5MTc3ODY4Mw==&mid=2247509020&idx=1&sn=63da40e92aefadbbe0a557cc723a8ccf","2026-10-30T08:39:00.000Z","clcjch9sbtki18dnepavxg2x9","Linux Kernel IPv4 TCP 释放后重用漏洞 CVE-2026-98432 可远程获取 root 权限","奇安信 CERT","https://mp.weixin.qq.com/s?__biz=MzU5NDgxODU1MQ==&mid=2247507965&idx=1&sn=fbf6db8e968619c1d4e942ec19344bbd","2026-10-30T05:01:00.000Z",{"_113":312,"_34":313,"_116":314,"_118":157,"_120":315,"_122":316,"_124":160,"_126":161,"_128":145,"_130":129,"_240":43,"_246":335},{"_113":261,"_34":262,"_116":263,"_118":149,"_120":264,"_122":265,"_124":152,"_126":153,"_128":145,"_130":129,"_240":40},{"_113":241,"_34":242,"_116":243,"_118":149,"_120":244,"_122":245,"_124":152,"_126":153,"_128":145,"_130":129,"_240":37,"_246":332},[333,334],{"_113":257,"_34":258,"_116":-5,"_118":157,"_120":259,"_122":260,"_124":160,"_126":161,"_128":145,"_130":129},{"_113":250,"_34":251,"_116":-5,"_118":252,"_120":253