165,"_120":166,"_122":160,"_124":161,"_126":129,"_128":129},{"_111":154,"_35":155,"_114":156,"_116":157,"_118":158,"_120":159,"_122":160,"_124":161,"_126":129,"_128":129},{"_111":146,"_35":147,"_114":148,"_116":149,"_118":150,"_120":151,"_122":152,"_124":153,"_126":127,"_128":129},{"_111":138,"_35":139,"_114":140,"_116":141,"_118":142,"_120":143,"_122":144,"_124":145,"_126":127,"_128":129},{"_111":130,"_35":131,"_114":132,"_116":133,"_118":134,"_120":135,"_122":136,"_124":137,"_126":127,"_128":129},{"_111":112,"_35":113,"_114":115,"_116":117,"_118":119,"_120":121,"_122":123,"_124":125,"_126":127,"_128":129},"itemId","yh480fqelqmjotur5820knfxw","被盗 K-12 学区员工账户正被用于跨学区钓鱼与欺诈","summary","MS-ISAC 在上一学年发现，6,116 个 K-12 成员中有 808 个机构的员工账户或凭据流入地下及暗网市场，攻击者利用合法账户跨学区投递钓鱼邮件、冒充学区负责人实施欺诈。","sourceName","Help Net Security","sourceUrl","https://www.helpnetsecurity.com/2026/10/29/cis-k-12-cybersecurity/","publishedAt","2026-10-29T05:00:01.000Z","sourceIconUrl","/dailyinfo/media/06c9ab9de6dbb6a5.webp","sourceIconSrcSet","/dailyinfo/media/9c1b5fa87b3bafc5.webp 48w, /dailyinfo/media/06c9ab9de6dbb6a5.webp 96w","firstParty",false,"available",true,"ihzujfnks5tdmhfaofc9plquz","Cisco Talos 发现 AI 驱动的 NIK C2 框架，含凭据窃取与屏幕锁定勒索","Cisco Talos 在野发现 AI 集成的 NIK C2 框架，其 Go 语言 Windows 植入程序通过 TLS WebSocket 与 HTTP 轮询双通道通信，支持凭据转储、键盘记录、浏览器与加密钱包窃取、横向移动及屏幕锁定勒索。","Cisco Talos","https://blog.talosintelligence.com/nik-c2-new-ai-enabled-framework/","2026-10-29T10:00:00.000Z","/dailyinfo/media/cbab12e5b352b636.webp","/dailyinfo/media/79258b19df22701a.webp 48w, /dailyinfo/media/cbab12e5b352b636.webp 96w","nru76rq7mt94ig342f9nxq5ql","Warp Panda 利用 VMware ESX 漏洞 CVE-2026-41709 隐藏审计轨迹","Warp Panda 已在针对美国法律行业的攻击中利用 VMware ESX 漏洞 CVE-2026-41709，通过管理员权限执行未记录操作来降低审计轨迹可见性，CISA 已将其加入 KEV。","The Hacker News","https://thehackernews.com/2026/10/china-linked-hackers-exploited-vmware.html","2026-10-29T06:22:33.000Z","/dailyinfo/media/3d21685a726d0a64.jpg","/dailyinfo/media/a1e7de8b6809b50e.jpg 48w, /dailyinfo/media/3d21685a726d0a64.jpg 96w","rowk7nbnamq9xb79zqfp85toi","Sony Network Communications 数据泄露暴露 2,585,481 条客户记录","Sony Group Corporation 旗下 Sony Network Communications 确认，未经授权方访问 So-net 会员数据库，导致 2,585,481 条现任及前任客户记录外泄，另有 54,401 个邮箱地址和账户密码暴露；银行、支付卡及其他账户详情未受影响。","BleepingComputer","https://www.bleepingcomputer.com/news/security/sony-isp-subsidiary-data-breach-exposes-25-million-customer-records/","2026-10-28T16:45:47.000Z","/dailyinfo/media/198a4d86de90e233.webp","/dailyinfo/media/3a544a742516b0af.webp 48w, /dailyinfo/media/198a4d86de90e233.webp 96w","rw9zqijxlp59r12oh34jdqxqr","vLLM 修复 Phi-4 多模态音频编码器注意力矩阵驻留导致的 OOM 崩溃","vLLM 的 Phi-4 多模态音频编码器因默认使用 eager attention 并保留各层完整注意力矩阵，单次合法音频请求即可导致 OOM。原文在 vllm/vllm-openai:v0.31.0 上以 19.2 MB、600 s 静音 WAV 复现 EngineDeadError，致整个服务停止响应；该问题已在 MR60614 修复。","GitHub 安全公告","https://github.com/advisories/GHSA-8397-8qf6-f2gm","2026-10-28T21:15:41.000Z","/dailyinfo/media/6d6a98e6b62e0bb2.webp","/dailyinfo/media/f426f4f60d806c23.webp 48w, /dailyinfo/media/6d6a98e6b62e0bb2.webp 96w","rgqxrxjyok0rdmkw6q5rg32hr","Python Social Auth OpenID Connect nonce 未绑定浏览器会话，可注入授权码登录受害者账户","Python Social Auth 的 OpenID Connect 后端未将 nonce 绑定到发起登录的浏览器会话，攻击者获得受害者未使用的授权码后，可在攻击者会话中提交该 code，绕过 nonce 校验并以受害者身份登录。","https://github.com/advisories/GHSA-h2r5-x5m7-3935","2026-10-28T21:16:51.000Z",{"_171":285,"_114":-5,"_173":286},{"_171":231,"_114":-5,"_173":232},{"_171":181,"_114":-5,"_173":182},{"_171":172,"_114":-5,"_173":174},"label","AI 安全","items",[175],{"_111":176,"_35":177,"_114":178,"_116":117,"_118":179,"_120":180,"_122":123,"_124":125,"_126":127,"_128":129},"s5egftxgd4pzsuybtmy9c5i8d","Forever Security 披露 Cursor、Copilot、Codex、VS Code 与 Claude Desktop 内置浏览器漏洞","Forever Security 披露五款 AI 编程助手内置浏览器均违反隔离规则：Cursor 可在开发者一次按键后执行攻击者命令，Copilot 可伪造地址栏，Codex、VS Code 和 Claude Desktop 的单个本地页面可越界读取磁盘。","https://www.helpnetsecurity.com/2026/10/29/research-ai-assistant-browser-vulnerabilities/","2026-10-29T14:10:49.000Z","研究与披露",[183,184,185],{"_111":224,"_35":225,"_114":226,"_116":227,"_118":228,"_120":205,"_122":229,"_124":230,"_126":127,"_128":129,"_194":34},{"_111":219,"_35":220,"_114":221,"_116":157,"_118":222,"_120":223,"_122":160,"_124":161,"_126":129,"_128":129},{"_111":186,"_35":187,"_114":188,"_116":189,"_118":190,"_120":191,"_122":192,"_124":193,"_126":127,"_128":129,"_194":41,"_195":196,"_197":32},"nvjhxml6qmgj1n5fihl71npjw","php2shell 技术分析：PHP 两个 RCE 生命周期漏洞 CVE-2026-109618 与 CVE-2026-109619","php2shell 技术分析拆解了 PHP 的两个未经认证 RCE 漏洞，CVE-2026-109618 和 CVE-2026-109619 均为 CVSS v4.0 9.2，前者源于 OOM 中断后的内存破坏，后者源于跨请求的陈旧全局状态。","OffSec","https://www.offsec.com/blog/php2shell-anatomy-of-two-php-lifecycle-bugs/","2026-10-28T20:07:17.000Z","/dailyinfo/media/00e7f80d0fd7a26d.webp","/dailyinfo/media/f8be55c07177824b.webp 48w, /dailyinfo/media/00e7f80d0fd7a26d.webp 96w","otherSources","related",[198,199,200],"followUp",{"_111":215,"_35":216,"_114":-5,"_116":141,"_118":217,"_120":218,"_122":144,"_124":145,"_126":127,"_128":129},{"_111":208,"_35":209,"_114":-5,"_116":210,"_118":211,"_120":212,"_122":213,"_124":214,"_126":129,"_128":129},{"_111":201,"_35":202,"_114":-5,"_116":203,"_118":204,"_120":205,"_122":206,"_124":207,"_126":127,"_128":129},"k8tlgcpcvb3lrju90q1r8tvyq","Palo Alto Networks PAN-OS 多个漏洞可导致远程代码执行，CVE-2026-109618 与 CVE-2026-109619 已被积极利用","CERT-FR","https://www.cert.cyber.gouv.fr/avis/CERTFR-2026-AVI-1402/","2026-10-28T00:00:00.000Z","/dailyinfo/media/231d5ff24619d57e.webp","/dailyinfo/media/b8c1de8f4ddeb800.webp 48w, /dailyinfo/media/231d5ff24619d57e.webp 96w","j6t2sz63bs1xyn52xnv400c6t","CISA 将 Broadcom VMWare ESX 与 Linux Kernel 两项在野利用漏洞纳入 KEV Catalog","CISA 安全公告","https://www.cisa.gov/news-events/alerts/2026/10/28/cisa-adds-two-known-exploited-vulnerabilities-catalog","2026-10-28T12:00:00.000Z","/dailyinfo/media/c65213b8bb0b8c32.webp","/dailyinfo/media/f4741f74a4c97912.webp 48w, /dailyinfo/media/c65213b8bb0b8c32.webp 96w","nawvvl4bfe1es5fzafrujnz00","攻击者利用 PHP2Shell 漏洞入侵暴露于互联网的 Palo Alto Networks 管理接口","https://thehackernews.com/2026/10/attackers-exploit-php2shell-flaws-in.html","2026-10-29T05:50:17.000Z","n7t33b4zzyzxy6gb2u55dbm5s","cert-manager 直接创建 Challenge 可绕过 DNS01 策略并泄露 acme-dns 凭据","cert-manager 的直接 Challenge 创建路径未验证 Order 归属或 Issuer 选定 solver，namespace 用户可借此绕过 ClusterIssuer 的 dnsZones、dnsNames 与 matchLabels 限制。","https://github.com/advisories/GHSA-8rvj-mm4h-c258","2026-10-29T16:39:41.000Z","xn04uir3ppltopryw25ryri8a","Orange Tsai 披露 Microsoft Edge 纯逻辑漏洞全链，实现沙箱逃逸与 ACE","Orange Tsai 披露其在 Pwn2Own Berlin 2026 构建的 Microsoft Edge 全链，通过 5 个逻辑漏洞和 2 项 Windows 功能实现沙箱逃逸并获得 $175,000 与 17.5 Master of Pwn points。","DevCo","https://devco.re/blog/2026/10/28/the-last-proof-of-human-craft-forging-a-microsoft-edge-full-chain-with-logic-bugs-only-en/","/dailyinfo/media/2dc02bf3e82fea5c.webp","/dailyinfo/media/c6f49a1ce8c8f0d9.webp 48w, /dailyinfo/media/2dc02bf3e82fea5c.webp 96w","攻击与威胁",[233,234,235,236,237,238],{"_111":79,"_35":39,"_114":270,"_116":149,"_118":271,"_120":272,"_122":152,"_124":153,"_126":127,"_128":129,"_194":41,"_195":273},{"_111":262,"_35":263,"_114":264,"_116":265,"_118":266,"_120":267,"_122":268,"_124":269,"_126":127,"_128":129},{"_111":257,"_35":258,"_114":259,"_116":149,"_118":260,"_120":261,"_122":152,"_124":153,"_126":127,"_128":129},{"_111":252,"_35":253,"_114":254,"_116":141,"_118":255,"_120":256,"_122":144,"_124":145,"_126":127,"_128":129},{"_111":247,"_35":248,"_114":249,"_116":141,"_118":250,"_120":251,"_122":144,"_124":145,"_126":127,"_128":129},{"_111":239,"_35":240,"_114":241,"_116":242,"_118":243,"_120":244,"_122":245,"_124":246,"_126":127,"_128":129},"bd7wabp95rfnfjrzp7ji0kci5","TrendAI 指 Discover-Tech 通过数字广告跟踪 Starlink 用户","TrendAI 研究人员认为，以 SHADOW-EARTH-79 标识的广告技术实体 Discover-Tech 购买 Starlink 用户广告，可能借此定位和监视用户。","Security Affairs","https://securityaffairs.com/201947/intelligence/ads-or-surveillance-researchers-flag-suspicious-targeting-of-starlink-users.html","2026-10-28T14:37:21.000Z","/dailyinfo/media/ef2b2b57fb06e54f.webp","/dailyinfo/media/2adef5b1e4357a03.webp 48w, /dailyinfo/media/ef2b2b57fb06e54f.webp 96w","wsntmow6j7f4emvphlkjlx4fh","独立研究员在 Gitee 公开仓库发现 26,400 个仍有效的云与 AI 凭据","独立研究员 Ben Zimmermann 扫描 Gitee 的 7.25 million 个公开仓库，发现 26,400 个仍可使用的云与 AI 凭据，其中包括 9。","https://thehackernews.com/2026/10/26400-valid-cloud-and-ai-credentials.html","2026-10-29T11:33:15.000Z","r33vqb4ahc08c2y4ozgccut2g","疑似中国关联攻击者利用 PHP2Shell 在 25 台服务器取得 root 权限并渗透 Active Directory","疑似中国关联攻击者利用 PHP2Shell 与 Fragnesia 漏洞链，在美国、日本、台湾和韩国取得 25 台服务器 root 权限，其中包括美国政府关联环境的 3 台系统。","https://thehackernews.com/2026/10/php2shell-attack-roots-25-servers.html","2026-10-28T16:02:45.000Z","ihl9k919cuk2zeu8m5uh5sr73","Polymarket 因第三方服务遭入侵暂停交易，约 $2.5M 加密资产被追踪","Polymarket 因第三方供应商被入侵而遭恶意 JavaScript 注入，约 $2.5M 加密资产已转移至疑似攻击者钱包。该脚本通过 cdn.debugbear[.]com/C7xcKKrjUnXK.js 分发，劫持已登录用户的交易会话、出售预测市场持仓并转移加密资产，还利用 data.debugbear.com 接收指令及回传账户、余额和交易结果。","https://www.bleepingcomputer.com/news/security/polymarket-halts-trading-after-crypto-draining-script-breach-25m-traced/","2026-10-29T21:47:25.000Z","m8vt0mfprflyha4qd0f1jbnwd","VAPOR PANDA 使用 ARTEX 与 DeepSeek 并行入侵全球 200 多家组织","CrowdStrike 披露 VAPOR PANDA 自 2026 年 10 月 17 日起使用 ARTEX 和 DeepSeek 等 LLM，在 11 天内针对至少 14 个国家的 200 多家组织并行入侵。","CrowdStrike","https://www.crowdstrike.com/en-us/blog/vapor-panda-uses-artex-to-scale-global-campaign/","2026-10-29T05:00:00.000Z","/dailyinfo/media/4bb18fbefa568e31.webp","/dailyinfo/media/f338ab1b3d8b6c40.webp 48w, /dailyinfo/media/4bb18fbefa568e31.webp 96w","Volt Typhoon 使用 Silent Train 中继框架，通过境外 VPS、被入侵的路由器及其他设备隐藏攻击来源，并利用至少 4 个零日漏洞攻击电信、政府、国防承包商、公用事业、卫星服务、航空等高价值目标。","https://www.bleepingcomputer.com/news/security/volt-typhoon-hides-zero-day-attacks-using-silent-train-framework/","2026-10-28T16:00:00.000Z",[274,275],{"_111":281,"_35":282,"_114":-5,"_116":133,"_118":283,"_120":284,"_122":136,"_124":137,"_126":127,"_128":129},{"_111":276,"_35":277,"_114":-5,"_116":278,"_118":279,"_120":280,"_122":-5,"_126":129,"_128":129},"d9iowy1mx3002orwszh8iuddf","Cisco Catalyst SD-WAN Controller 认证绕过漏洞 CVE-2026-20127 已发布修复","Cisco PSIRT","https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-sdwan-rpa-EHchtZk?vs_f=Cisco%20Security%20Advisory%26vs_cat=Security%20Intelligence%26vs_type=RSS%26vs_p=Cisco%20Catalyst%20SD-WAN%20Controller%20Authentication%20Bypass%20Vulnerability%26vs_k=1","2026-10-28T13:54:35.000Z","v5101zz60ks8sfvh3ejni16a0","Cisco Talos 披露 UAT-11473 利用 CVE-2026-20127 植入 KeyDrift","https://blog.talosintelligence.com/uat-11473-keydrift/","2026-10-28T21:32:02.000Z","漏洞与在野利用",[287,288],{"_111":294,"_35":295,"_114":296,"_116":278,"_118":297,"_120":298,"_122":-5,"_126":129,"_128":129,"_194":38,"_195":299},{"_111":289,"_35":290,"_114":291,"_116":157,"_118":292,"_120":293,"_122":160,"_124":161,"_126":129,"_128":129},"xpytoqbtuulo3rw9z3h510qhs","Mem0 会话范围键分隔符碰撞漏洞可导致跨租户对话泄露","Mem0 的 Python 与 TypeScript SDK 因未转义会话范围键中的 & 和 =，可造成跨租户对话读取与历史数据驱逐。","https://github.com/advisories/GHSA-5324-3w58-qpp2","2026-10-28T21:17:08.000Z","gz5wepydgx19541hqwvty4syk","Cisco ASA 与 FTD 远程访问 SSL VPN 隧道 DoS 漏洞 CVE-2026-76418 已被利用","Cisco ASA Software 与 FTD Software 的远程访问 SSL VPN 隧道存在 CVE-2026-76418，未认证远程攻击者可在隧道组启用二次认证时发送特制请求，触发设备意外重载并造成拒绝服务（DoS）；成功发起 VPN 登录并非必要条件。","https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-asaftd-tunnel-dos-s6mgkb75?vs_f=Cisco%20Security%20Advisory%26vs_cat=Security%20Intelligence%26vs_type=RSS%26vs_p=Cisco%20Secure%20Firewall%20Adaptive%20Security%20Appliance%20and%20Secure%20Firewall%20Threat%20Defense%20Software%20Remote%20Access%20SSL%20VPN%20Tunnel%20Denial%20of%20Service%20Vulnerability%26vs_k=1","2026-10-28T11:15:00.000Z",[300],{"_111":301,"_35":302,"_114":-5,"_116":210,"_118":303,"_120":304,"_122":213,"_124":214,"_126":129,"_128":129},"lxkjlk0lilnr9mbz3otid414f","CISA 将 GitLab CVE-2026-97229 与 Cisco CVE-2026-76418 列入 KEV Catalog","https://www.cisa.gov/news-events/alerts/2026/10/29/cisa-adds-two-known-exploited-vulnerabilities-catalog","2026-10-29T12:00:00.000Z",{"_111":294,"_35":295,"_114":296,"_116":278,"_118":297,"_120":298,"_122":-5,"_126":129,"_128":129,"_194":38,"_195":308},{"_111":224,"_35":225,"_114":226,"_116":227,"_118":228,"_120":205,"_122":229,"_124":230,"_126":127,"_128":129,"_194":34},{"_111":176,"_35":177,"_114":178,"_116":117,"_118":179,"_120":180,"_122":123,"_124":125,"_126":127,"_128":129},[309],{"_111":301,"_35":302,"_114":-5,"_116":210,"_118":303,"_120":304,"_122":213,"_124":214,"_126":129,"_128":129},"leadParagraph",{"_312":313,"_314":-5},"changelogVersion","2026-10-01T08:00","release"]
