,234],"flashes",[116,117,118,119,120,121,122,123,124,125],"cover",{"_109":110,"_111":112,"_113":-5,"_114":-5,"_115":-5},"metrics",{"_105":66,"_106":63,"_107":39,"_108":41},"readingMinutes","prev","next","totalEvents","sourcesCount","modelsReleased","firstPartyEvents","url","/dailyinfo/media/2fe40525291149d5.jpg","srcSet","/dailyinfo/media/44a618d70c8d6cbc.jpg 720w, /dailyinfo/media/938f2e6d7fe3a336.jpg 1200w, /dailyinfo/media/2fe40525291149d5.jpg 1600w","width","height","caption",{"_126":214,"_42":215,"_129":216,"_131":217,"_133":218,"_135":219,"_137":220,"_139":221,"_141":142,"_143":144,"_158":35,"_174":222,"_176":59},{"_126":203,"_42":204,"_129":205,"_131":181,"_133":206,"_135":207,"_137":184,"_139":185,"_141":142,"_143":144,"_158":37,"_174":208,"_176":74},{"_126":198,"_42":199,"_129":200,"_131":148,"_133":201,"_135":202,"_137":151,"_139":152,"_141":142,"_143":144},{"_126":193,"_42":194,"_129":195,"_131":148,"_133":196,"_135":197,"_137":151,"_139":152,"_141":142,"_143":144},{"_126":169,"_42":170,"_129":171,"_131":148,"_133":172,"_135":173,"_137":151,"_139":152,"_141":142,"_143":144,"_158":37,"_174":175,"_176":74},{"_126":164,"_42":165,"_129":166,"_131":148,"_133":167,"_135":168,"_137":151,"_139":152,"_141":142,"_143":144},{"_126":159,"_42":160,"_129":161,"_131":148,"_133":162,"_135":163,"_137":151,"_139":152,"_141":142,"_143":144},{"_126":153,"_42":154,"_129":155,"_131":148,"_133":156,"_135":157,"_137":151,"_139":152,"_141":142,"_143":144,"_158":35},{"_126":145,"_42":146,"_129":147,"_131":148,"_133":149,"_135":150,"_137":151,"_139":152,"_141":142,"_143":144},{"_126":127,"_42":128,"_129":130,"_131":132,"_133":134,"_135":136,"_137":138,"_139":140,"_141":142,"_143":144},"itemId","kwg7oq0syemuiq4bnt02ntr3s","某高校 EDU 系统越权测试导致学生信息泄露、COS 存储桶失陷与短信轰炸","summary","作者对某高校 EDU 系统开展渗透测试，通过资产收集、路径爆破和移动端 APP 抓包获得管理端 token 与 COOKIE，随后越权查询到约 1w5 名学生的姓名、手机号和头像。","sourceName","先知社区","sourceUrl","https://xz.aliyun.com/news/93055","publishedAt","2026-11-10T07:04:58.000Z","sourceIconUrl","/dailyinfo/media/976ac253540515ec.webp","sourceIconSrcSet","/api/img-proxy?u=https%3A%2F%2Fxz.aliyun.com%2Ffavicon.ico&mode=avatar-48&exp=1796256000&sig=862a26438132b835 48w, /dailyinfo/media/976ac253540515ec.webp 96w","firstParty",false,"available",true,"eauhnt9j6z8y871dfnos01sf4","186 个仿冒 AI 域名投递 ClickFix、Net Guard 与搜索劫持扩展","Island 发现一项代号为 TypoPrompting 的攻击活动，利用 186 个仿冒 AI 域名覆盖 27 个品牌，以 ClickFix 诱饵、Net Guard 浏览器劫持恶意软件和搜索劫持扩展三条路径实施攻击。","The Hacker News","https://thehackernews.com/2026/11/186-fake-ai-domains-redirect-users-to.html","2026-11-12T15:15:40.000Z","/dailyinfo/media/3d21685a726d0a64.jpg","/dailyinfo/media/a1e7de8b6809b50e.jpg 48w, /dailyinfo/media/3d21685a726d0a64.jpg 96w","z5eyy2r8873n7ajph93697vuh","Google 会话劫持钓鱼活动 Operation CloudFire 利用日历邀请窃取实时会话","Material Security 发现一项自 2026 年 8 月中旬起针对企业用户的钓鱼活动，以 Google Calendar、Drive 分享邀请及 Intuit 通知为诱饵，通过 Google 重定向链接和实时反向代理截获密码与二次验证过程。","https://thehackernews.com/2026/11/calendar-invites-and-live-proxies.html","2026-11-12T11:51:31.000Z","otherSources","okh0mnidc06s783lx019kc1m2","Node.js 修复 16 个漏洞，包括可导致服务器崩溃和内存泄露的 HTTP/2 缺陷","Node.js 发布安全更新，修复 16 个漏洞，其中 7 个被评为高危。","https://thehackernews.com/2026/11/nodejs-fixes-16-flaws-including-http2.html","2026-11-12T08:20:37.000Z","du1ke342yzyvzy72oam3q5c5w","Citrix 修复 NetScaler 与 Secure Access Client 的 12 个漏洞，含认证绕过","Citrix 修复 NetScaler ADC、NetScaler Gateway、NetScaler Console 及 Secure Access Client 的 12 个漏洞，其中 CVE-2026-120869 可让未认证攻击者绕过 NetScaler Console 认证控制，另有 Windows 与 Linux 客户端权限提升漏洞。","https://thehackernews.com/2026/11/citrix-patches-12-netscaler-and-secure.html","2026-11-12T15:38:49.000Z","dtp3to82km6fv43pn6rwviy2e","N-central 4EverAble2Shell 与 Agent2Shell 暴露在野利用尝试","N-able 披露 N-central 2026.4.1 HF2 的新漏洞 4EverAble2Shell 与 Agent2Shell，PoC 已能攻击 2026.4 Hotfix 2（build 2026.4.1.26）。","https://thehackernews.com/2026/11/new-n-central-exploits-work-against.html","2026-11-12T11:51:43.000Z","related",[177,178],"followUp",{"_126":186,"_42":187,"_129":-5,"_131":188,"_133":189,"_135":190,"_137":191,"_139":192,"_141":142,"_143":144},{"_126":179,"_42":180,"_129":-5,"_131":181,"_133":182,"_135":183,"_137":184,"_139":185,"_141":142,"_143":144},"q4w5xdxldiml1d6aadrdvueom","攻击者探测 N-central 漏洞，N-able 修复 7 项漏洞","SecurityWeek","https://www.securityweek.com/hackers-target-n-central-zero-days-as-n-able-rushes-patches/","2026-11-12T09:39:55.000Z","/dailyinfo/media/6f21a015ea489b81.webp","/dailyinfo/media/c2a91b85de7bb9d6.webp 48w, /dailyinfo/media/6f21a015ea489b81.webp 96w","nfe40jld0azdyvkuu4pkr1p7u","N-able N-central 4EverAble2Shell 零日漏洞已被利用，21 台服务器失陷","BleepingComputer","https://www.bleepingcomputer.com/news/security/new-n-able-4everable2shell-zero-day-exploited-hours-after-poc-released/","2026-11-12T19:51:16.000Z","/dailyinfo/media/198a4d86de90e233.webp","/dailyinfo/media/3a544a742516b0af.webp 48w, /dailyinfo/media/198a4d86de90e233.webp 96w","m65kuksej3ixs6woqeeqh6iqf","Red Hat Quay 严重漏洞 CVE-2026-123710 和 CVE-2026-110697 可读取及覆盖私有镜像","Red Hat Quay 的 CVE-2026-123710（CVSS 9.8）和 CVE-2026-110697（CVSS 9.9）可分别借助信任密钥和 robot account 令牌枚举读取、推送或覆盖私有镜像，影响 Quay 3、Quay 5 全部版本及 8 个 Quay 3 分支的修复版本。","https://thehackernews.com/2026/11/critical-red-hat-quay-flaw-lets.html","2026-11-12T16:27:01.000Z","le11re72cnlk62zbp383lzfk5","MongoDB Server 预认证 use-after-free 漏洞 CVE-2026-118383 可在故障转移时崩溃","MongoDB Server 的 CVE-2026-118383 允许未认证攻击者发送两个带 readConcern.afterOpTime 的 ping 请求，在受影响节点落后且随后赢得选举时触发 use-after-free 并使数据库崩溃；CVSS 4.0 评分为 9.5。","https://thehackernews.com/2026/11/critical-pre-auth-mongodb-flaw-cve-2026.html","2026-11-12T09:25:00.000Z","rj9u9s3oymbuwkube0wosddcn","攻击者利用 RMM+ 认证绕过攻击 ScreenConnect，288 台主机遭植入 SCKit","Huntress 观察到攻击者利用 RMM+ 认证绕过漏洞入侵 ConnectWise ScreenConnect，至少影响 6 家 MSP、48 家组织的 288 台主机，并在 90 分钟内完成命令投递。","https://www.securityweek.com/hackers-deploy-malware-in-fresh-screenconnect-campaign/","2026-11-12T10:39:34.000Z",[209],{"_126":210,"_42":211,"_129":-5,"_131":188,"_133":212,"_135":213,"_137":191,"_139":192,"_141":142,"_143":144},"h2occksxu7q3tzi57634syb7r","SCKit 蠕虫式恶意软件借 ScreenConnect 攻击 MSP，尝试反向感染技术人员","https://www.bleepingcomputer.com/news/security/new-worm-like-sckit-malware-targets-msps-in-screenconnect-attacks/","2026-11-12T22:53:10.000Z","y898vv9xn8ef61ymi2wwi96ss","Check Point Security Gateway 遭 PHP2Shell 在野利用，CVE-2026-123039 被用于提权","攻击者自 2026 年 10 月 30 日起利用未修补的 Check Point Security Gateway Mobile Access 门户开展扫描与利用，以 PHP2Shell 及 CVE-2026-109618、CVE-2026-109619 获取初始访问，再利用 DynamicCLI 接口的本地提权漏洞 CVE-2026-123039 提权至 root。","Check Point Research","https://research.checkpoint.com/2026/php2shell-exploitation-on-check-point-gateway/","2026-11-12T13:56:37.000Z","/dailyinfo/media/eb5a4204ed5bdd38.webp","/dailyinfo/media/847ca4554cd8d31b.webp 48w, /dailyinfo/media/eb5a4204ed5bdd38.webp 96w",[223],{"_126":224,"_42":225,"_129":-5,"_131":226,"_133":227,"_135":228,"_137":229,"_139":230,"_141":144,"_143":144},"ojwlpm2lgrlu73lx8jhuqda1a","Siemens Industrial Edge Management 受 CVE-2026-111497 影响，CVSS 9.8","CISA 安全公告","https://www.cisa.gov/news-events/ics-advisories/icsa-26-316-03","2026-11-12T12:00:00.000Z","/dailyinfo/media/c65213b8bb0b8c32.webp","/dailyinfo/media/f4741f74a4c97912.webp 48w, /dailyinfo/media/c65213b8bb0b8c32.webp 96w",{"_235":293,"_129":-5,"_237":294},{"_235":263,"_129":-5,"_237":264},{"_235":246,"_129":-5,"_237":247},{"_235":236,"_129":-5,"_237":238},"label","AI 安全","items",[239],{"_126":240,"_42":241,"_129":242,"_131":243,"_133":244,"_135":245,"_137":-5,"_141":142,"_143":144},"edurf4tg7pqutthgj06kgkobl","Microsoft 研究后训练供应链攻击如何通过数据集与模型投毒劫持编码 Agent","Microsoft Defender Research 与 Microsoft AI Red Team 发现，编码 Agent 可被数据集投毒或恶意模型检查点植入后门，通过普通用户请求、文件名、代码注释或工具结果触发危险工具调用。","Microsoft Security Blog","https://www.microsoft.com/en-us/security/blog/2026/11/12/trained-to-betray-how-post-training-supply-chain-attacks-hijack-coding-agents/","2026-11-12T17:00:00.000Z","研究与披露",[248,249],{"_126":255,"_42":256,"_129":257,"_131":258,"_133":259,"_135":260,"_137":261,"_139":262,"_141":144,"_143":144},{"_126":250,"_42":251,"_129":252,"_131":132,"_133":253,"_135":254,"_137":138,"_139":140,"_141":142,"_143":144},"nqlap2xqkwi4vat4av41s3pd1","happy-dom 服务端 SSRF 漏洞 CVE-2026-118660 全链路分析与复现","CVE-2026-118660 影响 happy-dom < 21.0.0，高危、CVSS 8.6，类型为 CWE-918 服务端请求伪造；攻击者在不可信 HTML 被服务端解析且 link 或 iframe 元素完成连接时，可使 Node 进程向内网发起请求，iframe 响应还可能写入可读 DOM。","https://xz.aliyun.com/news/93265","2026-11-12T04:31:16.000Z","ychw6bek6sbholn90ux3rcvl3","Pillow TIFF 与 EXIF 解析存在重叠标签数据内存耗尽漏洞","Pillow 的 `ImageFileDirectory_v2.load()` 存在内存耗尽漏洞：恶意 TIFF、PNG、JPEG、WebP 或 MPO 文件可通过重叠标签数据，使内存占用按“条目数 × 文件大小”增长。","GitHub 安全公告","https://github.com/advisories/GHSA-wqgw-9xfh-qf2g","2026-11-12T23:35:39.000Z","/dailyinfo/media/6d6a98e6b62e0bb2.webp","/dailyinfo/media/f426f4f60d806c23.webp 48w, /dailyinfo/media/6d6a98e6b62e0bb2.webp 96w","攻击与威胁",[265,266,267],{"_126":90,"_42":79,"_129":284,"_131":148,"_133":285,"_135":286,"_137":151,"_139":152,"_141":142,"_143":144,"_158":39,"_174":287},{"_126":276,"_42":277,"_129":278,"_131":279,"_133":280,"_135":281,"_137":282,"_139":283,"_141":142,"_143":144,"_158":35},{"_126":268,"_42":269,"_129":270,"_131":271,"_133":272,"_135":273,"_137":274,"_139":275,"_141":142,"_143":144},"qd7xgce2grpxnrdp2rggpggbf","Europol 联合九国查封 Gootloader、CastleRAT 和 StealC 基础设施，收回逾 600 万组被盗凭据","Europol 联合九国警方本周查封 Gootloader、CastleRAT 和 StealC 恶意软件运营背后的 235 台服务器和 257 个域名，并收回感染计算机上盗取的 600 多万组凭据，缴获的凭据此前被出售并用于进一步攻击和勒索。","Help Net Security","https://www.helpnetsecurity.com/2026/11/12/europol-operation-endgame-malware-takedown/","2026-11-12T13:34:14.000Z","/dailyinfo/media/06c9ab9de6dbb6a5.webp","/dailyinfo/media/9c1b5fa87b3bafc5.webp 48w, /dailyinfo/media/06c9ab9de6dbb6a5.webp 96w","pwalod9qlwcnq38r5ae1i2ani","攻击者利用 Cairn 自主攻击半导体、国防及公民社会机构","Unit 42 披露，中文使用者于 2026 年 8 月至 9 月利用开源 AI 渗透测试框架 Cairn，结合 Zhipu GLM 5.2 与 DeepSeek V4 Flash/Pro，针对至少 19 家机构自主执行 25 次行动。","Unit 42","https://unit42.paloaltonetworks.com/cairn-framework-ai-autonomous-attacks/","2026-11-12T15:00:31.000Z","/dailyinfo/media/4d373ddb2d54a219.webp","/dailyinfo/media/c5c35eb93d4d2e80.webp 48w, /dailyinfo/media/4d373ddb2d54a219.webp 96w","攻击者使用从周二起窃取的 4,837 个 GitHub 账户凭据，通过标题为 docs: dependency audit notes 的测试 Pull Request 检查写权限。","https://thehackernews.com/2026/11/4837-hijacked-github-accounts-ran-ci.html","2026-11-12T06:42:47.000Z",[288],{"_126":289,"_42":290,"_129":-5,"_131":181,"_133":291,"_135":292,"_137":184,"_139":185,"_141":142,"_143":144},"ds03g4k6eknewon9ob4w2q2ms","攻击者借合法令牌污染 61,764 个 GitHub 仓库窃取凭据","https://www.securityweek.com/attacker-targets-60000-github-repositories-in-credential-theft-campaign/","2026-11-12T13:39:03.000Z","漏洞与在野利用",[295,296,297,298,299,300],{"_126":332,"_42":333,"_129":334,"_131":148,"_133":335,"_135":336,"_137":151,"_139":152,"_141":142,"_143":144,"_158":41,"_174":337},{"_126":326,"_42":327,"_129":328,"_131":329,"_133":330,"_135":331,"_137":-5,"_141":144,"_143":144,"_158":37},{"_126":321,"_42":322,"_129":323,"_131":258,"_133":324,"_135":325,"_137":261,"_139":262,"_141":144,"_143":144},{"_126":310,"_42":311,"_129":312,"_131":188,"_133":313,"_135":314,"_137":191,"_139":192,"_141":142,"_143":144,"_158":35,"_174":315},{"_126":306,"_42":307,"_129":308,"_131":226,"_133":309,"_135":228,"_137":229,"_139":230,"_141":144,"_143":144},{"_126":301,"_42":302,"_129":303,"_131":271,"_133":304,"_135":305,"_137":274,"_139":275,"_141":142,"_143":144},"tthpdpwhuywrbj6runx9i9ryn","PostgreSQL 18.7 等版本修复 52 个漏洞并终止 PostgreSQL 14 支持","PostgreSQL Global Development Group 于 November 12 发布 PostgreSQL 18.7、17.12、16.16、15.20 和 14.25，修复 52 个安全漏洞及 140 多个其他缺陷，其中 32 个 CVE 的 CVSS 分为 8.8。","https://www.helpnetsecurity.com/2026/11/13/postgresql-security-update-november-2026/","2026-11-12T23:05:33.000Z","ppwfb9ug92t2jde5yzacrazq5","Siemens 多款楼宇自动化与能源产品受 php2shell 漏洞影响","Siemens 多款楼宇自动化与能源产品受 PHP 核心运行时远程代码执行漏洞 CVE-2026-109618 和 CVE-2026-109619 影响，攻击无需认证；前者 CVSS v3.1 为 9.8，后者为 8.1。","https://www.cisa.gov/news-events/ics-advisories/icsa-26-316-01","azhhxogo2ze95f84syty9k82z","Windows CLFS 漏洞 SignDrop 可借助特权进程获取 SYSTEM 权限","安全研究员 Abdelhamid Naceri 公开了 Windows CLFS 漏洞 SignDrop 的 PoC，可诱导 Windows Defender 等特权进程创建认证文件并借此获取 SYSTEM 权限。","https://www.bleepingcomputer.com/news/security/new-windows-signdrop-zero-day-gives-hackers-system-privileges/","2026-11-12T16:04:00.000Z",[316],{"_126":317,"_42":318,"_129":-5,"_131":148,"_133":319,"_135":320,"_137":151,"_139":152,"_141":142,"_143":144},"vg18mgfk9qqhb8fj6zco29xou","SignDrop PoC 利用 Windows CLFS 认证机制实现 SYSTEM 权限提升","https://thehackernews.com/2026/11/new-signdrop-zero-day-exploit-turns.html","2026-11-12T17:50:27.000Z","lpork1fvur2f6uit9eo593pgd","Pillow libtiff 编码器堆缓冲区溢出分析与修复方案","Pillow 通过 libtiff 保存 TIFF 时，攻击者控制的 EXIF、tiffinfo 或源文件 IFD 几何标签可覆盖实际图像尺寸，导致 libtiff 按标签尺寸读取或写入行缓冲区。","https://github.com/advisories/GHSA-xcvg-w56q-r89m","2026-11-12T23:34:43.000Z","j0h728hxubmy1jz17rm7oa7je","微步复现 7-Zip LZX 解码器远程代码执行漏洞 CVE-2026-125742","微步情报局已复现 7-Zip LZX 解码器远程代码执行漏洞 CVE-2026-125742。该漏洞影响 7-Zip 0<=version<26.06，位于多卷 CAB 归档的续卷解码流程；攻击者可构造特制归档诱导用户解压，通过堆越界写劫持控制流实现任意代码执行。","微步在线研究响应中心","https://mp.weixin.qq.com/s?__biz=Mzg5MTc3ODY4Mw==&mid=2247509041&idx=1&sn=d6e387eacb4bd1900b1f3c36100a3b3f","2026-11-12T09:47:00.000Z","itghrl24hjsfp7ov68trhdxf5","Apache HTTP/2 模块远程代码执行漏洞 CVE-2026-119618 影响 2.4.55 至 2.4.70，2.4.71 已修复","Apache HTTP Server 的 HTTP/2 模块 mod_http2 存在严重漏洞 CVE-2026-119618，攻击者无需认证即可在服务器上执行代码并完全控制服务器进程，CVSS 评分 9.8。","https://thehackernews.com/2026/11/critical-apache-http2-flaw-could-let.html","2026-11-12T05:12:26.000Z",[338],{"_126":339,"_42":340,"_129":-5,"_131":341,"_133":342,"_135":343,"_137":344,"_139":345,"_141":142,"_143":144},"gj57fff8izxf8izlqj80x17m3","Apache mod_http2 竞态条件 CVE-2026-119618 利用条件分析","Praetorian Blog","https://www.praetorian.com/blog/cve-2026-119618/","2026-11-12T14:16:26.000Z","/dailyinfo/media/586406153d4bc723.webp","/dailyinfo/media/2318a408f42b161b.webp 48w, /dailyinfo/media/586406153d4bc723.webp 96w",{"_126":276,"_42":277,"_129":278,"_131":279,"_133":280,"_135":281,"_137":282,"_139":283,"_141":142,"_143":144,"_158":35},{"_126":332,"_42":333,"_129":334,"_131":148,"_133":335,"_135":336,"_137":151,"_139":152,"_141":142,"_143":144,"_158":41,"_174":349},{"_126":326,"_42":327,"_129":328,"_131":329,"_133":330,"_135":331,"_137":-5,"_141":144,"_143":144,"_158":37},[350],{"_126":339,"_42":340,"_129":-5,"_131":341,"_133":342,"_135":343,"_137":344,"_139":345,"_141":142,"_143":144},"leadParagraph",{"_353":354,"_355":-5},"changelogVersion","2026-10-01T08:00","release"]
