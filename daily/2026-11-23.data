peg&mode=thumb&exp=1795737600&sig=eadf5f773483be40 720w, /api/img-proxy?u=https%3A%2F%2Fwechat2rss.xlab.app%2Fimg-proxy%2F%3Fk%3Dbb6cce8c%26amp%3Bu%3Dhttps%253A%252F%252Fmmbiz.qpic.cn%252Fsz_mmbiz_jpg%252FRwAbCjh555sJ0INXHpiafhZEIJUvevqnf01lYxhh0aAunzVBM0EJ3tc1YoX4nvZmrIAhtcvl5SR6NaBa2OO1M5c1E1DS3qmXmObIMxrnlNmg%252F0%253Fwx_fmt%253Djpeg&mode=image-1200&exp=1795737600&sig=0ac19e6cb210abea 1200w, /api/img-proxy?u=https%3A%2F%2Fwechat2rss.xlab.app%2Fimg-proxy%2F%3Fk%3Dbb6cce8c%26amp%3Bu%3Dhttps%253A%252F%252Fmmbiz.qpic.cn%252Fsz_mmbiz_jpg%252FRwAbCjh555sJ0INXHpiafhZEIJUvevqnf01lYxhh0aAunzVBM0EJ3tc1YoX4nvZmrIAhtcvl5SR6NaBa2OO1M5c1E1DS3qmXmObIMxrnlNmg%252F0%253Fwx_fmt%253Djpeg&mode=full&exp=1795737600&sig=81122ecabf9b4e58 1600w","width","height","caption",{"_161":210,"_163":-5,"_164":211},{"_161":193,"_163":-5,"_164":194},{"_161":185,"_163":-5,"_164":186},{"_161":162,"_163":-5,"_164":165},"label","AI 安全","summary","items",[166],{"_167":168,"_52":169,"_163":170,"_171":172,"_173":174,"_175":176,"_177":178,"_179":180,"_181":182,"_183":184},"itemId","m2rhspo6lynif9g168qaa6ue2","Researchers uncover months of prompt theft across three AI inference providers","Dragos 通过 canary token 研究发现，攻击者从 3 家 AI inference provider 内部窃取数据数月，最早始于 7 月中旬；OpenRouter 因此移除 3 家提供商及 125 个 Zero Data Retention 端点并通知潜在受影响客户，但 OpenRouter 本身未遭入侵。","sourceName","The Hacker News","sourceUrl","https://thehackernews.com/2026/11/openrouter-drops-3-providers-after.html","publishedAt","2026-11-22T05:06:55.000Z","sourceIconUrl","/dailyinfo/media/3d21685a726d0a64.jpg","sourceIconSrcSet","/dailyinfo/media/a1e7de8b6809b50e.jpg 48w, /dailyinfo/media/3d21685a726d0a64.jpg 96w","firstParty",false,"available",true,"研究与披露",[187],{"_167":130,"_52":119,"_163":188,"_171":189,"_173":190,"_175":191,"_177":-5,"_181":184,"_183":184,"_192":45},"Artifex Ghostscript < 10.08.0 的 -dSAFER 沙箱绕过漏洞 CVE-2026-125396 已被奇安信 CERT 复现，CVSS 4.0 分数为 8.5。","奇安信 CERT","https://mp.weixin.qq.com/s?__biz=MzU5NDgxODU1MQ==&mid=2247508224&idx=1&sn=2ab11be61822d4389080836c4f6663af","2026-11-22T04:43:00.000Z","otherSources","攻击与威胁",[195,196],{"_167":205,"_52":206,"_163":207,"_171":200,"_173":208,"_175":209,"_177":203,"_179":204,"_181":182,"_183":184},{"_167":197,"_52":198,"_163":199,"_171":200,"_173":201,"_175":202,"_177":203,"_179":204,"_181":182,"_183":184},"atovtf3rgx78nodedw7k6h9cz","Cleverbridge 遭黑客入侵，支付卡号与 CVV/CVC 数据被窃","Cleverbridge 表示，黑客入侵其平台并窃取客户用于平台购物的支付卡号、到期日和 CVV/CVC 安全码，但未泄露姓名、联系方式或账单信息。公司于 2026 年 11 月 4 日发现未授权活动并临时下线系统，同日恢复后确认第三方复制了平台存储的支付卡数据；自 11 月 20 日起通知受影响客户，但尚未披露受影响客户数量、攻击者进入平台的方式、停留时间或数据是否加密。","BleepingComputer","https://www.bleepingcomputer.com/news/security/cleverbridge-warns-hackers-stole-credit-card-numbers-cvvs-in-data-breach/","2026-11-22T15:43:04.000Z","/dailyinfo/media/198a4d86de90e233.webp","/dailyinfo/media/3a544a742516b0af.webp 48w, /dailyinfo/media/198a4d86de90e233.webp 96w","i27aenxyu7ec3i7ftauologeu","攻击者利用 GL.iNet GoodCloud 漏洞感染路由器与 KVM 设备","攻击者已利用 GL.iNet GoodCloud 云远程管理服务漏洞，在客户路由器和 KVM 设备中安装恶意软件；部分设备出现 root 级反向 Shell，攻击基础设施包括 66.245.219[.]252 和 65.20.71[.]131。","https://www.bleepingcomputer.com/news/security/hackers-exploit-glinet-cloud-flaw-to-infect-routers-kvm-devices/","2026-11-22T18:45:37.000Z","漏洞与在野利用",[212],{"_167":213,"_52":214,"_163":215,"_171":216,"_173":217,"_175":218,"_177":-5,"_181":184,"_183":184,"_219":111},"cpkja8bnlhxmi5kohgn7eye4s","VMware vCenter 认证绕过漏洞 CVE-2026-123890 已被在野利用","VMware vCenter 认证绕过漏洞 CVE-2026-123890 已被公开研究确认用于在野利用，长亭安全应急响应中心已完成复现验证。攻击者无需凭据，只需访问默认 TCP 2012 端口上的目录服务 RPC 接口，即可取得内置管理员会话，读取目录数据库、伪造 SSO 身份并创建管理员账号。","长亭安全应急响应中心","https://mp.weixin.qq.com/s?__biz=MzIwMDk1MjMyMg==&mid=2247493574&idx=2&sn=fa6556997dc76f69e9fe5503d753a9fe","2026-11-22T12:04:00.000Z","followUp",{"_167":213,"_52":214,"_163":215,"_171":216,"_173":217,"_175":218,"_177":-5,"_181":184,"_183":184,"_219":111},{"_167":168,"_52":169,"_163":170,"_171":172,"_173":174,"_175":176,"_177":178,"_179":180,"_181":182,"_183":184},{"_167":205,"_52":206,"_163":207,"_171":200,"_173":208,"_175":209,"_177":203,"_179":204,"_181":182,"_183":184},"leadParagraph",{"_225":226,"_227":-5},"changelogVersion","2026-10-01T08:00","release"]
