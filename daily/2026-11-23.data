79":142,"_55":122,"_175":200,"_183":201,"_185":202,"_187":203,"_189":-5,"_193":196,"_195":196,"_204":48},"Artifex Ghostscript < 10.08.0 的 -dSAFER 沙箱绕过漏洞 CVE-2026-125396 已被奇安信 CERT 复现，CVSS 4.0 分数为 8.5。","奇安信 CERT","https://mp.weixin.qq.com/s?__biz=MzU5NDgxODU1MQ==&mid=2247508224&idx=1&sn=2ab11be61822d4389080836c4f6663af","2026-11-22T04:43:00.000Z","otherSources","攻击与威胁",[207,208],{"_179":217,"_55":218,"_175":219,"_183":212,"_185":220,"_187":221,"_189":215,"_191":216,"_193":194,"_195":196},{"_179":209,"_55":210,"_175":211,"_183":212,"_185":213,"_187":214,"_189":215,"_191":216,"_193":194,"_195":196},"atovtf3rgx78nodedw7k6h9cz","Cleverbridge 遭黑客入侵，支付卡号与 CVV/CVC 数据被窃","Cleverbridge 表示，黑客入侵其平台并窃取客户用于平台购物的支付卡号、到期日和 CVV/CVC 安全码，但未泄露姓名、联系方式或账单信息。公司于 2026 年 11 月 4 日发现未授权活动并临时下线系统，同日恢复后确认第三方复制了平台存储的支付卡数据；自 11 月 20 日起通知受影响客户，但尚未披露受影响客户数量、攻击者进入平台的方式、停留时间或数据是否加密。","BleepingComputer","https://www.bleepingcomputer.com/news/security/cleverbridge-warns-hackers-stole-credit-card-numbers-cvvs-in-data-breach/","2026-11-22T15:43:04.000Z","/dailyinfo/media/198a4d86de90e233.webp","/dailyinfo/media/3a544a742516b0af.webp 48w, /dailyinfo/media/198a4d86de90e233.webp 96w","i27aenxyu7ec3i7ftauologeu","攻击者利用 GL.iNet GoodCloud 漏洞感染路由器与 KVM 设备","攻击者已利用 GL.iNet GoodCloud 云远程管理服务漏洞，在客户路由器和 KVM 设备中安装恶意软件；部分设备出现 root 级反向 Shell，攻击基础设施包括 66.245.219[.]252 和 65.20.71[.]131。","https://www.bleepingcomputer.com/news/security/hackers-exploit-glinet-cloud-flaw-to-infect-routers-kvm-devices/","2026-11-22T18:45:37.000Z","漏洞与在野利用",[224],{"_179":225,"_55":226,"_175":227,"_183":228,"_185":229,"_187":230,"_189":-5,"_193":196,"_195":196,"_231":114},"cpkja8bnlhxmi5kohgn7eye4s","VMware vCenter 认证绕过漏洞 CVE-2026-123890 已被在野利用","VMware vCenter 认证绕过漏洞 CVE-2026-123890 已被公开研究确认用于在野利用，长亭安全应急响应中心已完成复现验证。攻击者无需凭据，只需访问默认 TCP 2012 端口上的目录服务 RPC 接口，即可取得内置管理员会话，读取目录数据库、伪造 SSO 身份并创建管理员账号。","长亭安全应急响应中心","https://mp.weixin.qq.com/s?__biz=MzIwMDk1MjMyMg==&mid=2247493574&idx=2&sn=fa6556997dc76f69e9fe5503d753a9fe","2026-11-22T12:04:00.000Z","followUp",{"_179":225,"_55":226,"_175":227,"_183":228,"_185":229,"_187":230,"_189":-5,"_193":196,"_195":196,"_231":114},{"_179":180,"_55":181,"_175":182,"_183":184,"_185":186,"_187":188,"_189":190,"_191":192,"_193":194,"_195":196},{"_179":217,"_55":218,"_175":219,"_183":212,"_185":220,"_187":221,"_189":215,"_191":216,"_193":194,"_195":196},"leadParagraph",{"_237":238,"_239":-5},"changelogVersion","2026-10-01T08:00","release"]
