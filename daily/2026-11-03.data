app%2Fimg-proxy%2F%3Fk%3D18d126cd%26amp%3Bu%3Dhttps%253A%252F%252Fmmbiz.qpic.cn%252Fsz_mmbiz_jpg%252FodcL3w4qOqicJYqFoMWbZySN2nJUEzDlxiaZt2KcicmYvEicOAEWicC4ibB7kfR2dXR0BwpXKiaG5PHWFx5o1uuScxMWDgJcK523ZOuZwMC8iahgrWk%252F0%253Fwx_fmt%253Djpeg&mode=image-1200&exp=1795651200&sig=cd2889f96c78f1a9 1200w, /api/img-proxy?u=https%3A%2F%2Fwechat2rss.xlab.app%2Fimg-proxy%2F%3Fk%3D18d126cd%26amp%3Bu%3Dhttps%253A%252F%252Fmmbiz.qpic.cn%252Fsz_mmbiz_jpg%252FodcL3w4qOqicJYqFoMWbZySN2nJUEzDlxiaZt2KcicmYvEicOAEWicC4ibB7kfR2dXR0BwpXKiaG5PHWFx5o1uuScxMWDgJcK523ZOuZwMC8iahgrWk%252F0%253Fwx_fmt%253Djpeg&mode=full&exp=1795651200&sig=22ea1d6706ea2074 1600w","width","height","caption",{"_155":181,"_51":182,"_158":183,"_160":184,"_162":185,"_164":186,"_166":187,"_168":188,"_170":171,"_172":173,"_174":49},{"_155":175,"_51":176,"_158":177,"_160":178,"_162":179,"_164":180,"_166":-5,"_170":171,"_172":173,"_174":42},{"_155":156,"_51":157,"_158":159,"_160":161,"_162":163,"_164":165,"_166":167,"_168":169,"_170":171,"_172":173,"_174":47},"itemId","g91jpin898ib1bej3gd5gopsn","Linux 内核 CVE-2026-98432 波及自托管 JFrog 运行环境","summary","Linux 内核 CVE-2026-98432 是一处影响新建 IPv4 TCP 连接的 use-after-free 缺陷，自 4.4 起存在，Linux 内核团队评分 9.8。","sourceName","JFrog Security Research","sourceUrl","https://jfrog.com/blog/jfrog-artifactory-is-fine-your-linux-kernel-might-not-be/","publishedAt","2026-11-02T18:35:06.000Z","sourceIconUrl","/dailyinfo/media/2a60025a8fe0e259.webp","sourceIconSrcSet","/dailyinfo/media/b6e385a4a43a2c31.webp 48w, /dailyinfo/media/2a60025a8fe0e259.webp 96w","firstParty",false,"available",true,"followUp","shfnqqty603i8l19g63b43gpl","EDK II PXE 驱动漏洞 CVE-2026-97631 允许启动前执行代码","EDK II 的 PXE 网络启动驱动存在 CVE-2026-97631，CVSS 4.0 评分 9.5；攻击者可在 Secure Boot 和度量启动校验前触发越界写入，在操作系统加载前执行代码或造成拒绝服务。","安全客","https://mp.weixin.qq.com/s?__biz=MzA5ODA0NDE2MA==&mid=2649790661&idx=1&sn=1385c2dfcbcaf38e00737143ad75a02d","2026-11-02T00:30:00.000Z","n1pma2heqqc1u393qm8xxm48n","Synology警告C3RB3R勒索软件利用旧版DSM漏洞攻击NAS设备","Synology确认攻击者正利用2024年12月已修复的漏洞，针对运行过时DSM版本的NAS设备实施C3RB3R勒索攻击。","BleepingComputer","https://www.bleepingcomputer.com/news/security/synology-warns-customers-of-ongoing-c3rb3r-ransomware-attacks/","2026-11-02T11:28:42.000Z","/dailyinfo/media/198a4d86de90e233.webp","/dailyinfo/media/3a544a742516b0af.webp 48w, /dailyinfo/media/198a4d86de90e233.webp 96w",{"_192":259,"_158":-5,"_194":260},{"_192":223,"_158":-5,"_194":224},{"_192":193,"_158":-5,"_194":195},"label","AI 安全","items",[196,197,198],{"_155":215,"_51":216,"_158":217,"_160":218,"_162":219,"_164":220,"_166":221,"_168":222,"_170":171,"_172":173},{"_155":207,"_51":208,"_158":209,"_160":210,"_162":211,"_164":212,"_166":213,"_168":214,"_170":171,"_172":173},{"_155":199,"_51":200,"_158":201,"_160":202,"_162":203,"_164":204,"_166":205,"_168":206,"_170":171,"_172":173},"teaxhs6mgmqr7we21mxnq1hmt","Trail of Bits 使用 Codex 批量回移 Linux 安全修复，已覆盖 149 个 CVE","Trail of Bits 使用 Codex 与 GPT-5.6 协助将安全修复回移到 Linux 稳定分支及 Ubuntu、Fedora 等软件包。","Trail of Bits","https://blog.trailofbits.com/2026/11/02/backporting-security-fixes-at-scale-with-codex/","2026-11-02T12:00:00.000Z","/dailyinfo/media/9215b9af5123c7ea.webp","/dailyinfo/media/5acd642ecf79fa1f.webp 48w, /dailyinfo/media/9215b9af5123c7ea.webp 96w","o24ucbtgopfr2yuihm7llam2f","LocalAlign 通过近目标对抗训练提升大语言模型提示注入防御泛化能力","LocalAlign 通过近目标对抗样本生成与 Margin-Aware Alignment 提升大语言模型的提示注入防御泛化能力，防御能力写入模型参数，推理时无需额外调用攻击检测模型。","安全内参","https://www.secrss.com/articles/95243","2026-11-01T07:38:37.395Z","/dailyinfo/media/77459fcbf8f21e71.webp","/dailyinfo/media/3399ea7b18d18a6a.webp 48w, /dailyinfo/media/77459fcbf8f21e71.webp 96w","k8iee38q6sr0000yquvlj925i","Google Cloud 披露 LLMJacking 攻击链，攻击者转售被盗企业 LLM 资源","Google Cloud 威胁情报披露，攻击者在 2026 年多起 LLMJacking 入侵中盗用企业云身份和 LLM API 凭据，入侵北美、南美及亚太的金融、零售、技术和运输组织，单日欺诈费用超过 $100,000 USD，部分组织累计达 $1 million USD。","Google Cloud 威胁情报","https://cloud.google.com/blog/topics/threat-intelligence/llmjacking-monetizing-compromised-cloud-models/","2026-11-02T14:00:00.000Z","/dailyinfo/media/424bd6373c2d87d6.webp","/dailyinfo/media/9a88f7a6491d815b.webp 48w, /dailyinfo/media/424bd6373c2d87d6.webp 96w","攻击与威胁",[225,226,227,228,229],{"_155":126,"_51":58,"_158":257,"_160":218,"_162":258,"_164":220,"_166":221,"_168":222,"_170":171,"_172":173,"_256":48},{"_155":251,"_51":252,"_158":253,"_160":184,"_162":254,"_164":255,"_166":187,"_168":188,"_170":171,"_172":173,"_256":44},{"_155":243,"_51":244,"_158":245,"_160":246,"_162":247,"_164":248,"_166":249,"_168":250,"_170":171,"_172":173},{"_155":238,"_51":239,"_158":240,"_160":184,"_162":241,"_164":242,"_166":187,"_168":188,"_170":171,"_172":173},{"_155":230,"_51":231,"_158":232,"_160":233,"_162":234,"_164":235,"_166":236,"_168":237,"_170":171,"_172":173},"zpp06qhnjm5r6ekq6fx53gr5s","攻击者向乌克兰和俄罗斯民众发送虚假核威胁与袭击警报","乌克兰和俄罗斯的应急警报应用疑遭网络攻击，向民众发送核威胁、辐射、化学攻击和巷战等虚假警报，相关说法尚未获独立证实。乌克兰 Air Alarm 应用于当地时间 22:47 起发出多条警报，部分警报还触发 Lviv 地区广播；该应用随后因疑似被攻破而临时停用。","Security Affairs","https://securityaffairs.com/202248/security/hackers-send-fake-nuclear-threat-alerts-to-ukrainian-and-russian-citizens.html","2026-11-02T10:20:46.000Z","/dailyinfo/media/ef2b2b57fb06e54f.webp","/dailyinfo/media/2adef5b1e4357a03.webp 48w, /dailyinfo/media/ef2b2b57fb06e54f.webp 96w","y3oqogzfuz08thepvfa99u3bx","BTCPay Server 旧版本实例遭遇热钱包盗取，2.4.1及更早版本需升级至2.4.7","BTCPay Server 维护者称，黑客已针对运行 2.4.1（2026年7月23日）或更早版本的实例盗取热钱包资金，攻击未针对公开服务器。项目建议受影响实例尽快下线并升级至 2.4.7；原文称尚无使用 2.4.7 的热钱包盗取可信报告，但近期攻击具体利用的漏洞尚未查明，受影响用户需向 security@btcpayserver.org 提交活动日志。","https://www.bleepingcomputer.com/news/security/btcpay-server-warns-of-hot-wallet-thefts-targeting-outdated-instances/","2026-11-02T15:03:07.000Z","t0wff82r3vhco60wkrm3qmm96","攻击者伪装 Microsoft Teams IT 支持，利用不安全 AD CS 窃取企业数据","Microsoft 调查了两起攻击者伪装 IT 支持并诱导员工通过 Microsoft Teams 使用 Quick Assist 授予远程控制的入侵，攻击者随后利用不安全配置的 AD CS 获取高权限账户及域控制器证书，其中一起将企业数据复制到外部服务器。","The Hacker News","https://thehackernews.com/2026/11/attackers-pose-as-it-support-on.html","2026-11-02T11:08:45.000Z","/dailyinfo/media/3d21685a726d0a64.jpg","/dailyinfo/media/a1e7de8b6809b50e.jpg 48w, /dailyinfo/media/3d21685a726d0a64.jpg 96w","c8c3sczng53jdb0j9x5vqc0ry","欧洲多国逾115家超市制冷系统遭攻击，门店被迫处置变质商品","攻击者远程修改欧洲多国超市冷柜和制冷系统的温度设置、关闭制冷设备或启动除霜，导致超过115家门店受到影响，并造成商品损失和提前营业干预。","https://www.bleepingcomputer.com/news/security/hackers-disrupt-refrigeration-systems-at-european-supermarkets/","2026-11-02T14:28:39.000Z","otherSources","Google 与行业伙伴已拆除 XCPE 后门相关控制基础设施，该后门将超过 1.3 million 台机顶盒及其他 Android IoT 设备纳入僵尸网络。","https://cloud.google.com/blog/topics/threat-intelligence/shutting-the-door-on-the-xcpe-botnet/","漏洞与在野利用",[261,262],{"_155":278,"_51":279,"_158":280,"_160":281,"_162":282,"_164":283,"_166":-5,"_170":173,"_172":173,"_256":44},{"_155":263,"_51":264,"_158":265,"_160":266,"_162":267,"_164":268,"_166":269,"_168":270,"_170":173,"_172":173,"_256":46,"_271":272,"_174":47},"tqj4dxtikwan2dwzgf1hpjvys","Ivanti Connect Secure 三个零日漏洞已被链式利用，CVE-2026-111357 与 CVE-2026-118527 纳入 KEV","Ivanti Connect Secure 的 CVE-2026-111357、CVE-2026-118527 与 CVE-2026-104935 已被链式利用，可获取未认证 root 权限并窃取 Windows LAPS 密码和 BitLocker 恢复密钥，UTA0576 自 2026 年 10 月 3 日起攻击运行 22.8R2.4 的设备，影响客户数量有限。","Rapid7 CVE 公告","https://www.rapid7.com/blog/post/etr-additional-ivanti-connect-secure-zero-days-exploited-in-the-wild-cve-2026-111357-cve-2026-118527","2026-11-02T11:04:08.000Z","/dailyinfo/media/092fbeae5b5c3123.webp","/dailyinfo/media/c16323cf53c574df.webp 48w, /dailyinfo/media/092fbeae5b5c3123.webp 96w","related",[273],{"_155":274,"_51":275,"_158":-5,"_160":184,"_162":276,"_164":277,"_166":187,"_168":188,"_170":171,"_172":173},"c9fe12dhjhogapha6lstoepdb","Ivanti 修复 Connect Secure 两个零日漏洞，CVE-2026-111357 与 CVE-2026-118527 已被链式利用","https://www.bleepingcomputer.com/news/security/ivanti-patches-two-more-connect-secure-zero-days-chained-in-attacks/","2026-11-02T09:33:26.000Z","zn3wl1ipk6y4uimbmwjbo86fy","Microsoft Windows Update Stack 本地权限提升漏洞 CVE-2026-81963 已复现并发现在野利用","Microsoft Windows Update Stack 本地权限提升漏洞 CVE-2026-81963 已发现真实利用，奇安信 CERT 已成功复现；攻击者需取得目标主机低权限账户，可借更新栈未正确校验重解析点将权限提升至 SYSTEM。","奇安信 CERT","https://mp.weixin.qq.com/s?__biz=MzU5NDgxODU1MQ==&mid=2247507987&idx=1&sn=0725706555a43c3a36e4f766b32e7427","2026-11-02T08:51:00.000Z",{"_155":278,"_51":279,"_158":280,"_160":281,"_162":282,"_164":283,"_166":-5,"_170":173,"_172":173,"_256":44},{"_155":263,"_51":264,"_158":265,"_160":266,"_162":267,"_164":268,"_166":269,"_168":270,"_170":173,"_172":173,"_256":46,"_271":287,"_174":47},{"_155":251,"_51":252,"_158":253,"_160":184,"_162":254,"_164":255,"_166":187,"_168":188,"_170":171,"_172":173,"_256":44},[288],{"_155":274,"_51":275,"_158":-5,"_160":184,"_162":276,"_164":277,"_166":187,"_168":188,"_170":171,"_172":173},"leadParagraph",{"_291":292,"_293":-5},"changelogVersion","2026-10-01T08:00","release"]
