ab.app%2Fimg-proxy%2F%3Fk%3D18d126cd%26amp%3Bu%3Dhttps%253A%252F%252Fmmbiz.qpic.cn%252Fsz_mmbiz_jpg%252FodcL3w4qOqicJYqFoMWbZySN2nJUEzDlxiaZt2KcicmYvEicOAEWicC4ibB7kfR2dXR0BwpXKiaG5PHWFx5o1uuScxMWDgJcK523ZOuZwMC8iahgrWk%252F0%253Fwx_fmt%253Djpeg&mode=full&exp=1795392000&sig=e09294af3194ea16 1600w","width","height","caption",{"_143":169,"_48":170,"_146":171,"_148":172,"_150":173,"_152":174,"_154":175,"_156":176,"_158":159,"_160":161,"_162":46},{"_143":163,"_48":164,"_146":165,"_148":166,"_150":167,"_152":168,"_154":-5,"_158":159,"_160":161,"_162":39},{"_143":144,"_48":145,"_146":147,"_148":149,"_150":151,"_152":153,"_154":155,"_156":157,"_158":159,"_160":161,"_162":44},"itemId","g91jpin898ib1bej3gd5gopsn","Linux 内核 CVE-2026-98432 波及自托管 JFrog 运行环境","summary","Linux 内核 CVE-2026-98432 是一处影响新建 IPv4 TCP 连接的 use-after-free 缺陷，自 4.4 起存在，Linux 内核团队评分 9.8。","sourceName","JFrog Security Research","sourceUrl","https://jfrog.com/blog/jfrog-artifactory-is-fine-your-linux-kernel-might-not-be/","publishedAt","2026-11-02T18:35:06.000Z","sourceIconUrl","/dailyinfo/media/2a60025a8fe0e259.webp","sourceIconSrcSet","/dailyinfo/media/b6e385a4a43a2c31.webp 48w, /dailyinfo/media/2a60025a8fe0e259.webp 96w","firstParty",false,"available",true,"followUp","shfnqqty603i8l19g63b43gpl","EDK II PXE 驱动漏洞 CVE-2026-97631 允许启动前执行代码","EDK II 的 PXE 网络启动驱动存在 CVE-2026-97631，CVSS 4.0 评分 9.5；攻击者可在 Secure Boot 和度量启动校验前触发越界写入，在操作系统加载前执行代码或造成拒绝服务。","安全客","https://mp.weixin.qq.com/s?__biz=MzA5ODA0NDE2MA==&mid=2649790661&idx=1&sn=1385c2dfcbcaf38e00737143ad75a02d","2026-11-02T00:30:00.000Z","n1pma2heqqc1u393qm8xxm48n","Synology警告C3RB3R勒索软件利用旧版DSM漏洞攻击NAS设备","Synology确认攻击者正利用2024年12月已修复的漏洞，针对运行过时DSM版本的NAS设备实施C3RB3R勒索攻击。","BleepingComputer","https://www.bleepingcomputer.com/news/security/synology-warns-customers-of-ongoing-c3rb3r-ransomware-attacks/","2026-11-02T11:28:42.000Z","/dailyinfo/media/198a4d86de90e233.webp","/dailyinfo/media/3a544a742516b0af.webp 48w, /dailyinfo/media/198a4d86de90e233.webp 96w",{"_180":247,"_146":-5,"_182":248},{"_180":211,"_146":-5,"_182":212},{"_180":181,"_146":-5,"_182":183},"label","AI 安全","items",[184,185,186],{"_143":203,"_48":204,"_146":205,"_148":206,"_150":207,"_152":208,"_154":209,"_156":210,"_158":159,"_160":161},{"_143":195,"_48":196,"_146":197,"_148":198,"_150":199,"_152":200,"_154":201,"_156":202,"_158":159,"_160":161},{"_143":187,"_48":188,"_146":189,"_148":190,"_150":191,"_152":192,"_154":193,"_156":194,"_158":159,"_160":161},"teaxhs6mgmqr7we21mxnq1hmt","Trail of Bits 使用 Codex 批量回移 Linux 安全修复，已覆盖 149 个 CVE","Trail of Bits 使用 Codex 与 GPT-5.6 协助将安全修复回移到 Linux 稳定分支及 Ubuntu、Fedora 等软件包。","Trail of Bits","https://blog.trailofbits.com/2026/11/02/backporting-security-fixes-at-scale-with-codex/","2026-11-02T12:00:00.000Z","/dailyinfo/media/9215b9af5123c7ea.webp","/dailyinfo/media/5acd642ecf79fa1f.webp 48w, /dailyinfo/media/9215b9af5123c7ea.webp 96w","o24ucbtgopfr2yuihm7llam2f","LocalAlign 通过近目标对抗训练提升大语言模型提示注入防御泛化能力","LocalAlign 通过近目标对抗样本生成与 Margin-Aware Alignment 提升大语言模型的提示注入防御泛化能力，防御能力写入模型参数，推理时无需额外调用攻击检测模型。","安全内参","https://www.secrss.com/articles/95243","2026-11-01T07:38:37.395Z","/dailyinfo/media/77459fcbf8f21e71.webp","/dailyinfo/media/3399ea7b18d18a6a.webp 48w, /dailyinfo/media/77459fcbf8f21e71.webp 96w","k8iee38q6sr0000yquvlj925i","Google Cloud 披露 LLMJacking 攻击链，攻击者转售被盗企业 LLM 资源","Google Cloud 威胁情报披露，攻击者在 2026 年多起 LLMJacking 入侵中盗用企业云身份和 LLM API 凭据，入侵北美、南美及亚太的金融、零售、技术和运输组织，单日欺诈费用超过 $100,000 USD，部分组织累计达 $1 million USD。","Google Cloud 威胁情报","https://cloud.google.com/blog/topics/threat-intelligence/llmjacking-monetizing-compromised-cloud-models/","2026-11-02T14:00:00.000Z","/dailyinfo/media/424bd6373c2d87d6.webp","/dailyinfo/media/9a88f7a6491d815b.webp 48w, /dailyinfo/media/424bd6373c2d87d6.webp 96w","攻击与威胁",[213,214,215,216,217],{"_143":114,"_48":55,"_146":245,"_148":206,"_150":246,"_152":208,"_154":209,"_156":210,"_158":159,"_160":161,"_244":45},{"_143":239,"_48":240,"_146":241,"_148":172,"_150":242,"_152":243,"_154":175,"_156":176,"_158":159,"_160":161,"_244":41},{"_143":231,"_48":232,"_146":233,"_148":234,"_150":235,"_152":236,"_154":237,"_156":238,"_158":159,"_160":161},{"_143":226,"_48":227,"_146":228,"_148":172,"_150":229,"_152":230,"_154":175,"_156":176,"_158":159,"_160":161},{"_143":218,"_48":219,"_146":220,"_148":221,"_150":222,"_152":223,"_154":224,"_156":225,"_158":159,"_160":161},"zpp06qhnjm5r6ekq6fx53gr5s","攻击者向乌克兰和俄罗斯民众发送虚假核威胁与袭击警报","乌克兰和俄罗斯的应急警报应用疑遭网络攻击，向民众发送核威胁、辐射、化学攻击和巷战等虚假警报，相关说法尚未获独立证实。乌克兰 Air Alarm 应用于当地时间 22:47 起发出多条警报，部分警报还触发 Lviv 地区广播；该应用随后因疑似被攻破而临时停用。","Security Affairs","https://securityaffairs.com/202248/security/hackers-send-fake-nuclear-threat-alerts-to-ukrainian-and-russian-citizens.html","2026-11-02T10:20:46.000Z","/dailyinfo/media/ef2b2b57fb06e54f.webp","/dailyinfo/media/2adef5b1e4357a03.webp 48w, /dailyinfo/media/ef2b2b57fb06e54f.webp 96w","y3oqogzfuz08thepvfa99u3bx","BTCPay Server 旧版本实例遭遇热钱包盗取，2.4.1及更早版本需升级至2.4.7","BTCPay Server 维护者称，黑客已针对运行 2.4.1（2026年7月23日）或更早版本的实例盗取热钱包资金，攻击未针对公开服务器。项目建议受影响实例尽快下线并升级至 2.4.7；原文称尚无使用 2.4.7 的热钱包盗取可信报告，但近期攻击具体利用的漏洞尚未查明，受影响用户需向 security@btcpayserver.org 提交活动日志。","https://www.bleepingcomputer.com/news/security/btcpay-server-warns-of-hot-wallet-thefts-targeting-outdated-instances/","2026-11-02T15:03:07.000Z","t0wff82r3vhco60wkrm3qmm96","攻击者伪装 Microsoft Teams IT 支持，利用不安全 AD CS 窃取企业数据","Microsoft 调查了两起攻击者伪装 IT 支持并诱导员工通过 Microsoft Teams 使用 Quick Assist 授予远程控制的入侵，攻击者随后利用不安全配置的 AD CS 获取高权限账户及域控制器证书，其中一起将企业数据复制到外部服务器。","The Hacker News","https://thehackernews.com/2026/11/attackers-pose-as-it-support-on.html","2026-11-02T11:08:45.000Z","/dailyinfo/media/3d21685a726d0a64.jpg","/dailyinfo/media/a1e7de8b6809b50e.jpg 48w, /dailyinfo/media/3d21685a726d0a64.jpg 96w","c8c3sczng53jdb0j9x5vqc0ry","欧洲多国逾115家超市制冷系统遭攻击，门店被迫处置变质商品","攻击者远程修改欧洲多国超市冷柜和制冷系统的温度设置、关闭制冷设备或启动除霜，导致超过115家门店受到影响，并造成商品损失和提前营业干预。","https://www.bleepingcomputer.com/news/security/hackers-disrupt-refrigeration-systems-at-european-supermarkets/","2026-11-02T14:28:39.000Z","otherSources","Google 与行业伙伴已拆除 XCPE 后门相关控制基础设施，该后门将超过 1.3 million 台机顶盒及其他 Android IoT 设备纳入僵尸网络。","https://cloud.google.com/blog/topics/threat-intelligence/shutting-the-door-on-the-xcpe-botnet/","漏洞与在野利用",[249,250],{"_143":266,"_48":267,"_146":268,"_148":269,"_150":270,"_152":271,"_154":-5,"_158":161,"_160":161,"_244":41},{"_143":251,"_48":252,"_146":253,"_148":254,"_150":255,"_152":256,"_154":257,"_156":258,"_158":161,"_160":161,"_244":43,"_259":260,"_162":44},"tqj4dxtikwan2dwzgf1hpjvys","Ivanti Connect Secure 三个零日漏洞已被链式利用，CVE-2026-111357 与 CVE-2026-118527 纳入 KEV","Ivanti Connect Secure 的 CVE-2026-111357、CVE-2026-118527 与 CVE-2026-104935 已被链式利用，可获取未认证 root 权限并窃取 Windows LAPS 密码和 BitLocker 恢复密钥，UTA0576 自 2026 年 10 月 3 日起攻击运行 22.8R2.4 的设备，影响客户数量有限。","Rapid7 CVE 公告","https://www.rapid7.com/blog/post/etr-additional-ivanti-connect-secure-zero-days-exploited-in-the-wild-cve-2026-111357-cve-2026-118527","2026-11-02T11:04:08.000Z","/dailyinfo/media/092fbeae5b5c3123.webp","/dailyinfo/media/c16323cf53c574df.webp 48w, /dailyinfo/media/092fbeae5b5c3123.webp 96w","related",[261],{"_143":262,"_48":263,"_146":-5,"_148":172,"_150":264,"_152":265,"_154":175,"_156":176,"_158":159,"_160":161},"c9fe12dhjhogapha6lstoepdb","Ivanti 修复 Connect Secure 两个零日漏洞，CVE-2026-111357 与 CVE-2026-118527 已被链式利用","https://www.bleepingcomputer.com/news/security/ivanti-patches-two-more-connect-secure-zero-days-chained-in-attacks/","2026-11-02T09:33:26.000Z","zn3wl1ipk6y4uimbmwjbo86fy","Microsoft Windows Update Stack 本地权限提升漏洞 CVE-2026-81963 已复现并发现在野利用","Microsoft Windows Update Stack 本地权限提升漏洞 CVE-2026-81963 已发现真实利用，奇安信 CERT 已成功复现；攻击者需取得目标主机低权限账户，可借更新栈未正确校验重解析点将权限提升至 SYSTEM。","奇安信 CERT","https://mp.weixin.qq.com/s?__biz=MzU5NDgxODU1MQ==&mid=2247507987&idx=1&sn=0725706555a43c3a36e4f766b32e7427","2026-11-02T08:51:00.000Z",{"_143":266,"_48":267,"_146":268,"_148":269,"_150":270,"_152":271,"_154":-5,"_158":161,"_160":161,"_244":41},{"_143":251,"_48":252,"_146":253,"_148":254,"_150":255,"_152":256,"_154":257,"_156":258,"_158":161,"_160":161,"_244":43,"_259":275,"_162":44},{"_143":239,"_48":240,"_146":241,"_148":172,"_150":242,"_152":243,"_154":175,"_156":176,"_158":159,"_160":161,"_244":41},[276],{"_143":262,"_48":263,"_146":-5,"_148":172,"_150":264,"_152":265,"_154":175,"_156":176,"_158":159,"_160":161},"leadParagraph",{"_279":280,"_281":-5},"changelogVersion","2026-10-01T08:00","release"]
