Connect 恶意软件活动，47 家组织受影响","2026-11-13",16,"攻击者利用 4,837 个劫持 GitHub 账户在 1,806+ 个仓库运行 CI 密钥窃取器","2026-11-14",17,"攻击者利用 PHP2Shell 入侵 Check Point 网关并部署 VMware ESXi 数据擦除器","2026-11-15",18,"CISA 将 Check Point 与 UnrealIRCd 漏洞 CVE-2026-123039、CVE-2026-114713 加入 KEV 目录","2026-11-16",19,"FBI 警告 ARTEX AI 渗透测试框架被用于全球多行业攻击","2026-11-17",20,"Rapid7发现CVE-2026-90436已被用于攻击Atlassian Confluence Data Center和N-able N-central","2026-11-18",21,"OpenJDK Java4Shell 漏洞 CVE-2026-114938 可导致 RCE，Oracle 已发布补丁","2026-11-19",22,"OpenJDK 披露 Base64 解码远程代码执行漏洞 CVE-2026-114938","2026-11-20",23,"VMware vCenter 认证绕过漏洞 CVE-2026-123890 已被 ARMORY CASTLE 利用","2026-11-21",24,"Microsoft Outlook 欺骗漏洞 CVE-2026-124194 已复现并遭在野利用","2026-11-22",25,"CISA 将 Apache Roller、Cisco Expressway、SAP NetWeaver 和 VMware vCenter 四项漏洞列入 KEV","2026-11-23",26,"Artifex Ghostscript -dSAFER 沙箱绕过漏洞 CVE-2026-125396 已复现",27,"GT13 攻击活动入侵 Check Point Security Management Servers，至少影响 22 家组织","kind","daily","安全日报 · 2026-11-03","generatedAt","2026-11-03T00:00:32.768Z","lead",{"_52":59,"_293":261},"leadItemId","wbjzunigapakv96vd54t9g53c","overview","highlights",[288,289,290],"sections",[193,194,195],"flashes",[156,157,158],"cover",{"_149":150,"_151":152,"_153":-5,"_154":-5,"_155":-5},"metrics",{"_145":70,"_146":64,"_147":45,"_148":47},"readingMinutes","prev","next","totalEvents","sourcesCount","modelsReleased","firstPartyEvents","url","/api/img-proxy?u=https%3A%2F%2Fwechat2rss.xlab.app%2Fimg-proxy%2F%3Fk%3D18d126cd%26amp%3Bu%3Dhttps%253A%252F%252Fmmbiz.qpic.cn%252Fsz_mmbiz_jpg%252FodcL3w4qOqicJYqFoMWbZySN2nJUEzDlxiaZt2KcicmYvEicOAEWicC4ibB7kfR2dXR0BwpXKiaG5PHWFx5o1uuScxMWDgJcK523ZOuZwMC8iahgrWk%252F0%253Fwx_fmt%253Djpeg&mode=full&exp=1795737600&sig=e34546e77441e5a7","srcSet","/api/img-proxy?u=https%3A%2F%2Fwechat2rss.xlab.app%2Fimg-proxy%2F%3Fk%3D18d126cd%26amp%3Bu%3Dhttps%253A%252F%252Fmmbiz.qpic.cn%252Fsz_mmbiz_jpg%252FodcL3w4qOqicJYqFoMWbZySN2nJUEzDlxiaZt2KcicmYvEicOAEWicC4ibB7kfR2dXR0BwpXKiaG5PHWFx5o1uuScxMWDgJcK523ZOuZwMC8iahgrWk%252F0%25