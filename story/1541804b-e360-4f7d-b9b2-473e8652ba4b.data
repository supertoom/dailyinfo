[{"_1":2,"_3":4},"root",{"_5":137},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794444103000,"publicId","1541804b-e360-4f7d-b9b2-473e8652ba4b","title","Node.js修复Brotli解码器越界写入漏洞","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-11T04:46:39.949Z","latestAt","2026-11-11T09:58:00.000Z","digest","Node.js项目团队已修复内置Brotli解码器的越界写入漏洞并发布安全公告。工业和信息化部网络安全威胁和漏洞信息共享平台（NVDB）称，未经身份验证的攻击者可破坏进程内存，造成程序崩溃、进程内存信息泄露或远程代码执行；目前尚无实际利用获确认，影响部署规模也未说明。\n\n受影响范围限于仍在维护的22.x系列＜22.23.4、24.x系列＜24.22.1和26.x系列＜26.12.1。官方建议全面排查并立即升级至最新安全版本；报道未说明是否需要额外配置或重启。","digestUpdatedAt","2026-11-11T12:11:08.943Z","summary","excerpt","latest","Node.js Brotli 解码器越界写入超危漏洞影响 22.x、24.x 和 26.x 系列","latestReport",{"_103":113},"whyHot",{"_129":18,"_130":131,"_132":18,"_133":134,"_135":136},"developments",[116,117],"officialReports",[],"timeline",[101,102],"heat",[57,58,59,60,61,62,63,64,65,66,67,68,69,70],"related",[53],"topics",[48],{"_49":50,"_51":52},"slug","vuln","name","漏洞披露",{"_11":54,"_13":55,"_56":44},"7c28657e-31de-4920-a954-1af1b284351f","CISA确认Brotli越界写漏洞遭利用","relation",{"_71":99,"_42":100,"_74":18},{"_71":97,"_42":98,"_74":18},{"_71":95,"_42":96,"_74":18},{"_71":93,"_42":94,"_74":18},{"_71":91,"_42":92,"_74":18},{"_71":89,"_42":90,"_74":18},{"_71":87,"_42":88,"_74":18},{"_71":85,"_42":86,"_74":18},{"_71":83,"_42":84,"_74":18},{"_71":81,"_42":82,"_74":18},{"_71":79,"_42":80,"_74":18},{"_71":77,"_42":78,"_74":18},{"_71":75,"_42":76,"_74":18},{"_71":72,"_42":73,"_74":18},"hour","2026-11-12T00:00:00.000Z",12.4,"participants","2026-11-11T23:00:00.000Z",12.8,"2026-11-11T22:00:00.000Z",13.1,"2026-11-11T21:00:00.000Z",13.5,"2026-11-11T20:00:00.000Z",13.9,"2026-11-11T19:00:00.000Z",14.3,"2026-11-11T18:00:00.000Z",14.8,"2026-11-11T17:00:00.000Z",15.2,"2026-11-11T16:00:00.000Z",15.6,"2026-11-11T15:00:00.000Z",16.1,"2026-11-11T14:00:00.000Z",16.6,"2026-11-11T13:00:00.000Z",17,"2026-11-11T12:00:00.000Z",17.5,"2026-11-11T11:00:00.000Z",18.1,{"_103":113,"_13":31,"_28":114,"_106":115,"_108":23,"_109":110},{"_103":104,"_13":31,"_28":105,"_106":107,"_108":21,"_109":110},"id","e641gf5eqkkrfxl9d9m808735","工业和信息化部网络安全威胁和漏洞信息共享平台（NVDB）监测发现，Node.js 内置 Brotli 解码器存在越界写入超危漏洞，未经身份验证的攻击者可破坏进程内存，导致程序崩溃、进程内存信息泄露或远程代码执行。","source",{"_51":111,"_112":110},"publishedAt","selected",false,"安全内参","firstParty","vrh1gz7cekwoafn8dxlq8wu5z","Node.js 内置 Brotli 解码器存在越界写入超危漏洞，未经身份验证的攻击者可破坏进程内存，造成程序崩溃、进程内存信息泄露或远程代码执行。受影响版本包括 22.x 系列＜ 22.23.4、24.x 系列＜ 24.22.1、26.x 系列＜ 26.12.1。Node.js 项目团队已修复并发布安全公告，建议相关单位和用户全面排查并升级至最新安全版本。",{"_51":111,"_112":110},{"_118":125,"_13":126,"_20":23,"_17":121,"_122":127},{"_118":119,"_13":120,"_20":21,"_17":121,"_122":123},"factId","fsWoi2t8iyeI","Node.js Brotli解码器越界写入漏洞修复",1,"representative",{"_103":104,"_13":31,"_28":105,"_106":124,"_108":21,"_109":110},{"_51":111,"_112":110},"fZZvApdUkkHc","Node.js Brotli解码器越界写入漏洞",{"_103":113,"_13":31,"_28":114,"_106":128,"_108":23,"_109":110},{"_51":111,"_112":110},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete",true,"rank",10,{"_138":139,"_140":-5},"changelogVersion","2026-10-01T08:00","release"]
