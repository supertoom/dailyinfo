[{"_1":2,"_3":4},"root",{"_5":292},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795480850000,"publicId","14a0fad8-66ec-4bda-ac82-e2bc652b68c2","title","HUMAN披露并处置BADBOX 3.0广告欺诈网络","status","active","reportCount",5,"sourceCount","firstReportAt","2026-11-21T15:17:27.000Z","latestAt","2026-11-23T11:44:18.000Z","digest","HUMAN的Satori团队披露并已干扰BADBOX 3.0，确认该僵尸网络主要感染低成本、非品牌且未经认证的AOSP电视盒子、手机和平板，通过后门投放欺诈模块；其规模尚无估算，受感染设备数仍存在口径差异，但HUMAN此前观测到逾7.4万台设备。\n\nBADBOX 3.0在隐藏窗口播放视频广告并冒充合法流媒体应用发起竞价请求，峰值每日约400亿次，占HUMAN观察到的CTV流量4%以上；代理模块还未经设备所有者同意，将设备接入11个住宅代理网络。HUMAN称已参与Google此前针对相关XCPE恶意软件行动的处置，包括下线多个C2域名。分析时，新模块几乎没有杀毒软件覆盖。","digestUpdatedAt","2026-11-23T12:17:05.213Z","summary","excerpt","latest","Human Security 披露 BadBox 3.0 Android 广告欺诈网络及每日 400 亿次请求","latestReport",{"_245":275},"whyHot",{"_286":128,"_287":288,"_289":128,"_290":253,"_291":159},"developments",[279],"officialReports",[],"timeline",[240,241,242,243,244],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","iot","name","IoT 与车联网","mobile","移动端","black-market","数据窃取与黑产","google","Google / 谷歌","malware","恶意软件","attack","攻击活动",{"_124":238,"_42":239,"_127":165},{"_124":236,"_42":237,"_127":165},{"_124":234,"_42":235,"_127":165},{"_124":232,"_42":233,"_127":165},{"_124":230,"_42":231,"_127":165},{"_124":228,"_42":229,"_127":165},{"_124":226,"_42":227,"_127":165},{"_124":224,"_42":225,"_127":165},{"_124":222,"_42":223,"_127":165},{"_124":220,"_42":221,"_127":165},{"_124":218,"_42":219,"_127":165},{"_124":216,"_42":