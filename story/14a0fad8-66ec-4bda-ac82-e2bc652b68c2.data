0.000Z",3.8,"2026-11-23T00:00:00.000Z",3.9,"2026-11-22T23:00:00.000Z","2026-11-22T22:00:00.000Z",4.1,"2026-11-22T21:00:00.000Z",4.2,"2026-11-22T20:00:00.000Z",4.4,"2026-11-22T19:00:00.000Z",4.5,"2026-11-22T18:00:00.000Z",4.6,"2026-11-22T17:00:00.000Z",4.8,"2026-11-22T16:00:00.000Z",4.9,"2026-11-22T15:00:00.000Z","2026-11-22T14:00:00.000Z",5.2,"2026-11-22T13:00:00.000Z",5.3,"2026-11-22T12:00:00.000Z",5.5,"2026-11-22T11:00:00.000Z",5.7,"2026-11-22T10:00:00.000Z",5.8,"2026-11-22T09:00:00.000Z","2026-11-22T08:00:00.000Z",6.2,"2026-11-22T07:00:00.000Z",6.4,"2026-11-22T06:00:00.000Z",6.5,"2026-11-22T05:00:00.000Z",6.7,"2026-11-22T04:00:00.000Z",6.9,"2026-11-22T03:00:00.000Z",7.1,"2026-11-22T02:00:00.000Z",7.3,"2026-11-22T01:00:00.000Z",7.6,"2026-11-22T00:00:00.000Z",7.8,"2026-11-21T23:00:00.000Z",8,"2026-11-21T22:00:00.000Z",8.2,"2026-11-21T21:00:00.000Z",8.5,"2026-11-21T20:00:00.000Z",8.7,"2026-11-21T19:00:00.000Z",9,"2026-11-21T18:00:00.000Z",9.2,"2026-11-21T17:00:00.000Z",9.5,{"_319":360,"_13":31,"_28":361,"_323":362,"_325":23,"_326":327},{"_319":354,"_13":355,"_28":356,"_323":357,"_325":358,"_326":330},{"_319":348,"_13":349,"_28":350,"_323":351,"_325":352,"_326":330},{"_319":343,"_13":344,"_28":345,"_323":346,"_325":230,"_326":327},{"_319":337,"_13":338,"_28":339,"_323":340,"_325":341,"_326":327},{"_319":331,"_13":332,"_28":333,"_323":334,"_325":335,"_326":327},{"_319":320,"_13":321,"_28":322,"_323":324,"_325":21,"_326":327},"id","dbml5ujd9k2y3agezdbxfdnmx","BADBOX 3.0 botnet 回归，每日发起 40 亿次欺诈广告竞价请求","HUMAN 的 Satori 研究人员发现 BADBOX 3.0 通过受感染的 Android 设备每日发起约 40 billion 次欺诈广告竞价请求，峰值占其观察到的 CTV 流量的 4% 以上。","source",{"_56":328,"_329":330},"publishedAt","selected",true,"BleepingComputer","firstParty",false,"cs06se3s3e0k3ft935zz94pmb","BADBOX 3.0 被曝利用 Android 设备组建广告欺诈僵尸网络","HUMAN Satori 团队披露 BADBOX 3.0，通过感染 Android TV 盒子、手机和平板，在隐藏窗口播放广告并冒充合法 CTV 应用发起竞价请求，峰值约每日 40 billion 次，占 Human Defense Platform 观测流量的 4% 以上。",{"_56":336,"_329":330},"2026-11-23T07:44:44.000Z","Security Affairs","zbl2br8ssgupye47pxclrv5es","HUMAN 披露 BADBOX 3.0 利用感染电视盒子开展广告欺诈并出租家庭网络","HUMAN 的 Satori 团队已干扰由感染低端电视盒子驱动的 BADBOX 3.0，该行动峰值每天生成约 400 亿次广告竞价请求，占 HUMAN 观测到的 CTV 流量 4% 以上。",{"_56":342,"_329":330},"2026-11-23T08:06:18.000Z","Help Net Security","ldzifjzm3scc7m6yzh65gmxgt","BADBOX 3.0 感染电视盒子实施广告欺诈与住宅代理劫持","HUMAN Security Satori 披露，BADBOX 3.0 主要感染低成本、未经认证的 AOSP CTV 机顶盒，通过伪装系统应用后门和 C2 模块清单投放广告欺诈及住宅代理模块。",{"_56":347,"_329":330},"奇安信威胁情报中心","b6hge63cr66h3tbeq8iaek7qj","Badbox 3.0 通过后门控制低成本 Android 设备，日均发起 400 亿次广告竞价请求","Human’s Satori Threat Intelligence and Research Team 披露，Badbox 3.0 峰值时每天产生 400 亿次竞价请求，规模超过此前纪录保持者 VastFlux。",{"_56":353,"_329":330},"2026-11-23T09:30:00.000Z","Infosecurity Magazine","inkt84b33b04vmcchy3vbnbjn","Human Security 披露 BadBox 3.0 Android 广告欺诈网络及每日 400 亿次请求","Human Security  disrupted BadBox 3.0，一款针对低成本 Android 设备的广告欺诈僵尸网络，高峰期每天产生约 400 亿次竞价请求，占其观测到的 CTV 流量的 4% 以上，并利用 C&C 域名投放后门与欺诈模块。",{"_56":359,"_329":330},"2026-11-23T11:44:18.000Z","SecurityWeek","ymj47vp2164r65z6aew4oay2n","HUMAN 的 Satori Threat Intelligence 团队捣毁了针对廉价 Android TV box、平板等设备的 BADBOX 3.0 广告欺诈与代理僵尸网络，高峰期每日产生约 40 billion 次广告竞价请求，占研究团队观测到的 CTV 流量超过 4%，并借助 C2、公共代码仓库、CDN 和 SSAI spoofing 维持运营。",{"_56":363,"_329":330},"Hackread",{"_365":366,"_13":367,"_20":21,"_17":18,"_368":369},"factId","f0__GhdwcS3s","披露BADBOX 3.0重启及每日400亿请求","representative",{"_319":360,"_13":31,"_28":361,"_323":370,"_325":23,"_326":327},{"_56":363,"_329":330},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",{"_378":379,"_380":-5},"changelogVersion","2026-10-01T08:00","release"]
