[{"_1":2,"_3":4},"root",{"_5":377},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795567297000,"publicId","14a0fad8-66ec-4bda-ac82-e2bc652b68c2","title","HUMAN干扰BADBOX 3.0广告欺诈网络","status","active","reportCount",7,"sourceCount","firstReportAt","2026-11-21T15:17:27.000Z","latestAt","2026-11-24T14:34:34.000Z","digest","HUMAN的Satori团队已披露并干扰BADBOX 3.0广告欺诈僵尸网络，确认其主要感染低成本、非品牌且未经认证的AOSP电视盒子、手机和平板；HUMAN未估算感染设备总数，相关C2基础设施此前已由Google牵头的行动下线多个。\n\n该网络通过预装后门投放欺诈与住宅代理模块，在隐藏窗口播放视频广告并冒充合法流媒体应用，峰值每日约发起400亿次竞价请求，占HUMAN观测CTV流量的4%以上，并使设备在所有者不知情下接入11个住宅代理网络。HUMAN曾观测到逾7.4万台相关设备；其代理服务宣传约20万个节点，监控到最多34万个独立连接，但这些数字不能直接视为唯一感染设备数。HUMAN另称，一个代码仓库镜像一个月收到逾36.7万次请求，其中包含研究人员与扫描器请求。","digestUpdatedAt","2026-11-24T14:59:20.544Z","summary","excerpt","latest","HUMAN 捣毁 BADBOX 3.0 恶意广告与住宅代理僵尸网络","latestReport",{"_319":360},"whyHot",{"_371":152,"_372":373,"_374":238,"_375":327,"_376":232},"developments",[364],"officialReports",[],"timeline",[312,313,314,315,316,317,318],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130,131,132,133,134,135,136,137,138,139,140,141,142,143,144,145,146,147],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","mobile","name","移动端","iot","IoT 与车联网","google","Google / 谷歌","black-market","数据窃取与黑产","malware","恶意软件","attack","攻击活动",{"_148":310,"_42":311,"_151":238},{"_148":308,"_42":309,"_151":238},{"_148":306,"_42":307,"_151":238},{"_148":304,"_42":305,"_151":238},{"_148":302,"_42":303,"_151":238},{"_148":300,"_42":301,"_151":238},{"_148":298,"_42":299,"_151":238},{"_148":296,"_42":297,"_151