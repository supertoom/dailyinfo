[{"_1":2,"_3":4},"root",{"_5":245},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795135250000,"publicId","e603b0df-7979-4476-a581-fff48c892c4e","title","Agent Framework 包投毒窃取凭据","status","active","reportCount",5,"sourceCount","firstReportAt","2026-11-18T00:00:00.000Z","latestAt","2026-11-19T12:53:44.000Z","digest","攻击者劫持 Microsoft Agent Framework 的 PyPI 包 agent-framework 发布流程，投放恶意版本 1.26.1 和 1.26.2；两版本均已被 PyPI 隔离，1.26.0 仍是最新干净版本，但实际受害规模尚未确认。恶意包会在 site-packages 根目录写入 .pth 文件，即使未导入 Agent Framework，也会随 Python 解释器启动自动执行，收集环境变量、配置文件及 Azure、AWS、GitHub、Docker、Hugging Face、OpenAI 等凭据并发送至 webhook[.]site；1.26.2 还将窃取范围扩展至 GitHub Actions。\n\n安装过任一恶意版本的环境应立即隔离，停止运行 Python 或 pip，从干净环境重建并改用 1.26.0，同时轮换受影响环境可访问的凭据。SafeDep 称账号 vibiret 对该包及五个相关项目拥有发布权限，但其参与恶意上传尚未证实，攻击者如何取得发布权限也不明。","digestUpdatedAt","2026-11-19T13:31:00.558Z","summary","excerpt","latest","Microsoft Agent Framework 的 PyPI 版本 1.26.1、1.26.2 被植入凭据窃取载荷","latestReport",{"_196":226},"whyHot",{"_237":113,"_238":239,"_240":241,"_242":204,"_243":244},"developments",[230],"officialReports",[],"timeline",[191,192,193,194,195],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","ransomware","name","勒索软件","supply-chain","供应链安全","microsoft","Microsoft / 微软","malware","恶意软件","attack","攻击活动","identity","身份与访问",{"_109":189,"_42":190,"_112":184},{"_109":187,"_42":188,"_112":184},{"_109":185,"_42":186,"_112":184},{"_109":182,"_42":183,"_112":184},{"_109":181,"_42":159,"_112":177},{"_109":180,"_42":157,"_112":177},{"_109":179,"_42":155,"_112":177},{"_109":178,"_42":153,"_112":177},{"