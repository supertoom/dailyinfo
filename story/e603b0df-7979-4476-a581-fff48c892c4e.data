[{"_1":2,"_3":4},"root",{"_5":168},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795048843000,"publicId","e603b0df-7979-4476-a581-fff48c892c4e","title","Agent Framework 包投毒窃取凭据","status","active","reportCount",4,"sourceCount","firstReportAt","2026-11-18T00:00:00.000Z","latestAt","2026-11-18T16:58:42.000Z","digest","攻击者劫持 Microsoft Agent Framework 的 PyPI 包 agent-framework 发布流程，投放恶意版本 1.26.1 和 1.26.2；两版本均已被 PyPI 隔离，1.26.0 仍是最新干净版本，但实际受害规模尚未确认。恶意包会在 site-packages 根目录写入 .pth 文件，即使未导入 Agent Framework，也会随 Python 解释器启动自动执行，收集环境变量、配置文件及 Azure、AWS、GitHub、Docker、Hugging Face、OpenAI 等凭据并发送至 webhook[.]site；1.26.2 还将窃取范围扩展至 GitHub Actions。\n\n安装过任一恶意版本的环境应立即隔离，停止运行 Python 或 pip，从干净环境重建并改用 1.26.0，同时轮换受影响环境可访问的凭据。SafeDep 称账号 vibiret 对该包及五个相关项目拥有发布权限，但其参与恶意上传尚未证实，攻击者如何取得发布权限也不明。","digestUpdatedAt","2026-11-18T20:49:26.231Z","summary","excerpt","latest","Microsoft Agent Framework 的 PyPI 包 1.26.1 和 1.26.2 被植入凭据窃取代码","latestReport",{"_127":151},"whyHot",{"_162":18,"_163":164,"_165":105,"_166":135,"_167":105},"developments",[155],"officialReports",[],"timeline",[123,124,125,126],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","ransomware","name","勒索软件","supply-chain","供应链安全","microsoft","Microsoft / 微软","malware","恶意软件","attack","攻击活动","identity","身份与访问",{"_85":121,"_42":122,"_88":116},{"_85":119,"_42":120,"_88":116},{"_85":117,"_42":118,"_88":116},{"_85":114,"_42":115,"_88":116},{"_85":112,"_42":113,"_88":105},{"_85":110,"_42":111,"_88":105},{"_85":108,"_42":109,"_88":105},{"_85":106,"_42":107,"_88":105},{"_85":103,"_42":104,"_88":105},{"_85":101,"_42":102,"_88":18},{"_85":99,"_42":100,"_88":18},{"_85":97,