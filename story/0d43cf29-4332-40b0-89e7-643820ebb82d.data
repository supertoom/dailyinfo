[{"_1":2,"_3":4},"root",{"_5":191},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795048843000,"publicId","0d43cf29-4332-40b0-89e7-643820ebb82d","title","RIKEN披露富岳超算被入侵、4224名用户信息涉泄露","status","active","reportCount",3,"sourceCount","firstReportAt","2026-11-17T20:51:21.000Z","latestAt","2026-11-18T09:38:40.312Z","digest","日本理化学研究所计算科学中心（RIKEN）披露，外部攻击者于11月10日至13日利用“富岳”超算面向公众开放的“运行状态”仪表板网页侵入其运行系统内部网络，部分服务器被篡改并安装了未授权程序，攻击者还尝试使用已获取的凭据连接其他系统；RIKEN 于11月14日凌晨暂停超算运行并切断相关访问，恢复运行需先确认系统安全。\n\n数据受损范围上，RIKEN 的表述与安全内参报道存在差异：RIKEN称4,222名“富岳”用户的姓名、邮箱地址、用户ID，以及375名“理究”用户的姓名和邮箱地址泄露，用户电脑中的SSH私钥、访问密钥及研究数据文件遭破坏；安全内参则称最多4,224名“富岳”用户和375名“理究”用户的信息“可能”遭窃取，目前没有证据显示科研数据已被窃取，第三方个人信息是否外泄仍在调查中。\n\nRIKEN 尚未查明具体入侵手段，也未归因攻击方。","digestUpdatedAt","2026-11-18T11:34:18.048Z","summary","excerpt","latest","日本 RIKEN“富岳”超算遭网络攻击并暂停运行","latestReport",{"_156":174},"whyHot",{"_184":18,"_185":186,"_187":129,"_188":172,"_189":190},"developments",[177],"officialReports",[],"timeline",[153,154,155],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","exploited","name","在野利用","ai-offense","AI 攻防","supply-chain","供应链安全","incident","应急响应","attack","攻击活动","identity","身份与访问",{"_95":151,"_42":152,"_98":132},{"_95":149,"_42":150,"_98":132},{"_95":147,"_42":148,"_98":132},{"_95":145,"_42":146,"_98":132},{"_95":143,"_42":144,"_98":132},{"_95":141,"_42":142,"_98":132},{"_95":139,"_42":140,"_98":132},{"_95":137,"_42":138,"_98":132},{"_95":135,"_42":136,"_98":132},{"_95":133,"_42":134,"_98":132},{"_95":130,"_42":131,"_98":132},{"_95":127,"_42":128,"_98":129},{"_95":125,"_42":126,"_98":18},{"_95":123,"_42":124,"_98":18},{"_9