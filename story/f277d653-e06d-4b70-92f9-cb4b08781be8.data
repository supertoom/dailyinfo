[{"_1":2,"_3":4},"root",{"_5":216},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795912858000,"publicId","f277d653-e06d-4b70-92f9-cb4b08781be8","title","SAP确认开发基础设施遭攻击，GitHub代码疑被篡改","status","watching","reportCount",4,"sourceCount","firstReportAt","2026-11-27T07:36:14.000Z","latestAt","2026-11-27T11:39:20.000Z","digest","SAP确认其开发基础设施遭网络攻击，IT环境发现可疑活动后已采取紧急措施保护客户和服务；目前没有证据显示客户业务数据被未授权访问，也没有报告表明交付给客户的软件含被篡改代码，但事件仍在调查，是否有专有代码被访问尚不明确。\n\n据DER SPIEGEL及媒体援引内部消息，攻击者窃取SAP员工认证令牌，进入GitHub环境复制并修改源代码；SAP尚未确认这些细节。报道所称AI参与攻击也无证据支持；SAP未明确受影响环境、是否需重新下载仓库代码或执行更新。","digestUpdatedAt","2026-11-27T13:07:52.715Z","summary","excerpt","latest","SAP 确认安全事件，攻击者被指窃取 GitHub 令牌并修改源代码","latestReport",{"_175":199},"whyHot",{"_210":18,"_211":212,"_213":212,"_214":183,"_215":168},"developments",[203],"officialReports",[],"timeline",[171,172,173,174],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","black-market","name","数据窃取与黑产","ransomware","勒索软件","identity","身份与访问","ai-offense","AI 攻防","supply-chain","供应链安全","attack","攻击活动",{"_101":169,"_42":170,"_104":168},{"_101":166,"_42":167,"_104":168},{"_101":164,"_42":165,"_104":163},{"_101":161,"_42":162,"_104":163},{"_101":159,"_42":160,"_104":18},{"_101":157,"_42":158,"_104":18},{"_101":155,"_42":156,"_104":18},{"_101":153,"_42":154,"_104":18},{"_101":151,"_42":152,"_104":18},{"_101":149,"_42":150,"_104":18},{"_101":147,"_42":148,"_104":18},{"_101":145,"_42":146,"_104":18},{"_101":143,"_42":144,"_104":18},{"_101":141,"_42":142,"_104":18},{"_101":139,"_42":140,"_104":18},{"_101":137,"_42":138,"_104":18},{"_101":135,"_42":136,"_10