[{"_1":2,"_3":4},"root",{"_5":187},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794703237000,"publicId","fb9309e9-8eb9-4b9f-b1c7-3f14b5206de9","title","Trezor确认3台Safe 5钱包被植入窃密电路","status","watching","reportCount",3,"sourceCount","firstReportAt","2026-11-02T12:48:04.000Z","latestAt","2026-11-13T19:38:36.000Z","digest","Trezor确认，3台经东南亚经销商CryptoBilis购买的Safe 5硬件钱包含隐藏电路板，可在设置或恢复时读取屏幕上的恢复助记词及口令，并加密后经移动网络发送至攻击者服务器；目前无资金损失报告。\n\n固件2.13.1已阻止目前发现的植入物在更新后的钱包上采集信息，但无法挽回此前可能已被捕获的备份。受影响设备购于2026年8月20日至9月23日；Trezor目前仅确认这3台Safe 5，已检查的该区域其他经销商设备未发现篡改，其他经销商及其他型号暂未发现植入物。早先预警曾称Safe 3、Safe 5和Safe 7可能受影响，后续确认范围仅限Safe 5。","digestUpdatedAt","2026-11-13T20:02:49.970Z","summary","excerpt","latest","Trezor确认3个Safe 5硬件钱包含窃取加密资产的恶意植入","latestReport",{"_146":163},"whyHot",{"_179":97,"_180":181,"_182":181,"_183":184,"_185":186},"developments",[167,168],"officialReports",[],"timeline",[143,144,145],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","iot","name","IoT 与车联网","supply-chain","供应链安全","malware","恶意软件","attack","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件",{"_93":142,"_42":107,"_96":139},{"_93":141,"_42":105,"_96":139},{"_93":140,"_42":103,"_96":139},{"_93":138,"_42":101,"_96":139},{"_93":136,"_42":137,"_96":97},{"_93":134,"_42":135,"_96":97},{"_93":132,"_42":133,"_96":97},{"_93":130,"_42":131,"_96":97},{"_93":128,"_42":129,"_96":97},{"_93":126,"_42":127,"_96":97},{"_93":124,"_42":125,"_96":97},{"_93":122,"_42":123,"_96":97},{"_93":120,"_42":121,"_96":97},{"_93":118,"_42":119,"_96":97},{"_93":116,"_42":117,"_96":97},{"_93":114,"_42":115,"_96":97},{"_93":112,"_42":113,"_96":97},{"_93"