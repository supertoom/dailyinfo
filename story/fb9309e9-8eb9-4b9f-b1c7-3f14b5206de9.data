[{"_1":2,"_3":4},"root",{"_5":142},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794616838000,"publicId","fb9309e9-8eb9-4b9f-b1c7-3f14b5206de9","title","Trezor确认3台Safe 5钱包被植入窃密电路","status","active","reportCount",3,"sourceCount","firstReportAt","2026-11-02T12:48:04.000Z","latestAt","2026-11-13T19:38:36.000Z","digest","Trezor确认，3台经东南亚经销商CryptoBilis购买的Safe 5硬件钱包含隐藏电路板，可在设置或恢复时读取屏幕上的恢复助记词及口令，并加密后经移动网络发送至攻击者服务器；目前无资金损失报告。\n\n固件2.13.1已阻止目前发现的植入物在更新后的钱包上采集信息，但无法挽回此前可能已被捕获的备份。受影响设备购于2026年8月20日至9月23日；Trezor目前仅确认这3台Safe 5，已检查的该区域其他经销商设备未发现篡改，其他经销商及其他型号暂未发现植入物。早先预警曾称Safe 3、Safe 5和Safe 7可能受影响，后续确认范围仅限Safe 5。","digestUpdatedAt","2026-11-13T20:02:49.970Z","summary","excerpt","latest","Trezor确认3个Safe 5硬件钱包含窃取加密资产的恶意植入","latestReport",{"_102":119},"whyHot",{"_135":81,"_136":92,"_137":81,"_138":139,"_140":141},"developments",[123,124],"officialReports",[],"timeline",[99,100,101],"heat",[68,69,70,71,72,73,74,75,76],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","iot","name","IoT 与车联网","supply-chain","供应链安全","malware","恶意软件","attack","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件",{"_77":97,"_42":98,"_80":92},{"_77":95,"_42":96,"_80":92},{"_77":93,"_42":94,"_80":92},{"_77":90,"_42":91,"_80":92},{"_77":88,"_42":89,"_80":81},{"_77":86,"_42":87,"_80":81},{"_77":84,"_42":85,"_80":81},{"_77":82,"_42":83,"_80":81},{"_77":78,"_42":79,"_80":81},"hour","2026-11-14T00:00:00.000Z",16.3,"participants",2,"2026-11-13T23:00:00.000Z",16.8,"2026-11-13T22:00:00.000Z",17.3,"2026-11-13T21:00:00.000Z",17.8,"2026-11-13T20:00:00.000Z",18.3,"2026-11-13T19:00:00.000Z",8.6,1,"2026-11-13T18:00:00.000Z",8.9,"2026-11-13T17:00:00.000Z",9.1,"2026-11-13T16:00:00.000Z",9.4,{"_102":119,"_13":31,"_28":120,"_106":121,"_108":23,"_109":110},{"_102":113,"_13":114,"_28":115,"_106":116,"_108":117,"_109":110},{"_102":103,"_13":104,"_28":105,"_106":107,"_108":21,"_109":110},"id","by49eu4tzshufgbfsfw3ychg4","Trezor 警告部分 CryptoBilis 销售的 Safe 5 钱包可能藏有窃取恢复短语的植入物","Trezor 警告，自 2026 年 3 月起通过 CryptoBilis 购买的部分 Trezor 钱包可能含有窃取恢复短语的隐藏植入物，包括 Safe 3、Safe 5 和 Safe 7。","source",{"_56":111,"_112":110},"publishedAt","selected",false,"Help Net Security","firstParty","ck5koexiuhej4ppbz6xlket4g","Trezor 确认 CryptoBilis 销售的 Safe 5 硬件钱包被植入窃取恢复助记词的电路板","Trezor 确认 3 台经 CryptoBilis 购买的 Safe 5 硬件钱包含隐藏电路板，可在设置或恢复时读取并通过移动网络加密外传恢复助记词及口令，目前尚无资金损失报告。",{"_56":118,"_112":110},"2026-11-13T13:54:20.000Z","The Hacker News","hso3fdhybvbz542lhds5br37k","Trezor确认3台由东南亚经销商CryptoBilis销售的Safe 5硬件钱包含恶意硬件植入，可截取屏幕显示或输入的助记词与密码，加密后经移动网络传至攻击者服务器。",{"_56":122,"_112":110},"BleepingComputer",{"_125":131,"_13":132,"_20":117,"_17":81,"_128":133},{"_125":126,"_13":127,"_20":21,"_17":92,"_128":129},"factId","fm335-dSblQM","Trezor警告部分钱包含种子窃取装置","representative",{"_102":103,"_13":104,"_28":105,"_106":130,"_108":21,"_109":110},{"_56":111,"_112":110},"frdXacH3vXsg","确认经销商所售钱包藏有窃取助记词芯片",{"_102":113,"_13":114,"_28":115,"_106":134,"_108":117,"_109":110},{"_56":118,"_112":110},"participants48h","newParticipants6h","recentReports24h","observationComplete",true,"rank",8,{"_143":144,"_145":-5},"changelogVersion","2026-10-01T08:00","release"]
