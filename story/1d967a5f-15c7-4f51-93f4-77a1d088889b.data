[{"_1":2,"_3":4},"root",{"_5":199},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794703237000,"publicId","1d967a5f-15c7-4f51-93f4-77a1d088889b","title","14国联合行动拘捕354名暗网交易者","status","watching","reportCount",2,"sourceCount","firstReportAt","2026-11-13T08:34:20.000Z","latestAt","2026-11-13T11:06:29.000Z","digest","欧洲刑警组织与14国警方完成“Operation TorNado”联合行动，共逮捕354名暗网卖家和买家，并搜查数百处住所。目标涵盖已下线的 Archetyp、Bohemia、Nemesis、Kingdom、Tor2Door 五个市场，以及论坛、单一供应商商店和加密通信渠道。\n\n美国查获超过4.8吨毒品、152支枪支及超过1.5亿欧元现金和加密货币；欧洲查获950公斤毒品、57支枪支、超过100万片处方药及超过6000万欧元现金和加密货币。各市场此前已下线，行动未确认其是否重新运营。","digestUpdatedAt","2026-11-13T15:19:32.941Z","summary","excerpt","latest","Europol 在 TorNado 行动中查获暗网交易商与买家","latestReport",{"_169":180},"whyHot",{"_191":18,"_192":193,"_194":193,"_195":196,"_197":198},"developments",[184],"officialReports",[],"timeline",[167,168],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","crypto","name","密码学","supply-chain","供应链安全","cisa","CISA","attack","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件",{"_100":165,"_42":166,"_103":162},{"_100":163,"_42":164,"_103":162},{"_100":160,"_42":161,"_103":162},{"_100":158,"_42":159,"_103":18},{"_100":156,"_42":157,"_103":18},{"_100":154,"_42":155,"_103":18},{"_100":152,"_42":153,"_103":18},{"_100":150,"_42":151,"_103":18},{"_100":148,"_42":149,"_103":18},{"_100":146,"_42":147,"_103":18},{"_100":144,"_42":145,"_103":18},{"_100":142,"_42":143,"_103":18},{"_100":140,"_42":141,"_103":18},{"_100":138,"_42":139,"_103":18},{"_100":136,"_42":137,"_103":18},{"_100":134,"_42":135,"_103":18},{"_100":132,"_42":133,"_103":18},{"_100":130