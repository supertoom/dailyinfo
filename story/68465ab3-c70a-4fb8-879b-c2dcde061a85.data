[{"_1":2,"_3":4},"root",{"_5":349},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":-5,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48},"expiresAt",1795653657000,"publicId","68465ab3-c70a-4fb8-879b-c2dcde061a85","title","Drupal安装器RCE漏洞已遭在野利用","status","active","reportCount",7,"sourceCount",6,"firstReportAt","2026-11-19T14:33:06.000Z","latestAt","2026-11-25T13:37:28.000Z","digest","Drupal安全团队披露并已修复Drupal core内置安装器远程代码执行漏洞CVE-2026-132165；后续证实攻击者已利用该漏洞接管未打补丁的真实站点，可导致远程代码执行。该漏洞CVSS评分为25分中的18分，影响Drupal 11.4.13、11.3.22和10.6.22之前的受支持版本，已停止支持的分支不会收到修复。\n\n特定条件下，未认证攻击者可访问install.php并尝试重装运行中的站点；默认.htaccess规则不会阻止安装器请求。Horizon3称，若Web服务器无法写入settings.php或更改其权限，部分但非全部利用路径会被阻断。管理员仍应在更新后继续封锁安装器，暂不能升级时可通过Web服务器配置或根目录.htaccess阻止/core/install.php。\n\nCISA已将CVE-2026-132165加入KEV目录，要求联邦机构在11月27日前处置；修复版本发布于11月18日。","digestUpdatedAt","2026-11-25T13:50:07.196Z","summary","excerpt","latest","Drupal 安装器 RCE 漏洞 CVE-2026-132165 已被在野利用","latestReport",{"_276":317},"whyHot",{"_343":139,"_344":345,"_346":139,"_347":298,"_348":161},"developments",[321,322,323,324],"officialReports",[],"timeline",[269,270,271,272,273,274,275],"heat",[69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130,131,132,133,134],"related",[],"topics",[49,50,51,52,53,54],{"_55":67,"_57":68},{"_55":65,"_57":66},{"_55":63,"_57":64},{"_55":61,"_57":62},{"_55":59,"_57":60},{"_55":56,"_57":58},"slug","ai-offense","name","AI 攻防","vuln-mgmt","漏洞管理","research","技术研究","cisa","CISA","exploited","在野利用","vuln","漏洞披露",{"_135":267,"_43":268,"_138":168},{"_135":265,"_43":266,"_138":168},{"_135":263,"_43":264,"_138":165},{"_135":261,"_43":262,"_138":165},{"_135":259,"_43":260,"_138":165},{"_135":257,"_43":258,"_138":165},{"_135":255,"_43":256,"_138