,"2026-11-19T18:00:00.000Z",19,"2026-11-19T17:00:00.000Z",9.3,"2026-11-19T16:00:00.000Z",9.6,{"_276":317,"_13":32,"_29":318,"_280":319,"_282":24,"_283":284},{"_276":311,"_13":312,"_29":313,"_280":314,"_282":315,"_283":298},{"_276":306,"_13":307,"_29":308,"_280":309,"_282":310,"_283":298},{"_276":300,"_13":301,"_29":302,"_280":303,"_282":304,"_283":284},{"_276":293,"_13":294,"_29":295,"_280":296,"_282":297,"_283":298},{"_276":287,"_13":288,"_29":289,"_280":290,"_282":291,"_283":284},{"_276":277,"_13":278,"_29":279,"_280":281,"_282":22,"_283":284},"id","o6wemt6o90bge8ogzpb1qnfc3","Drupal 修复关键安装器漏洞 CVE-2026-132165，可能导致 RCE","Drupal core 的内置安装器漏洞 CVE-2026-132165 可在特定条件下被未认证攻击者利用，尝试重装站点并造成站点接管或 RCE，项目风险评分为 25 分中的 18 分。","source",{"_57":285,"_286":284},"publishedAt","selected",false,"The Hacker News","firstParty","iotnmq0t4j7557cj844m84n94","Drupal Core Installer 远程代码执行漏洞 CVE-2026-132165","CVE-2026-132165 是 Drupal Core 安装程序中的严重远程代码执行漏洞。在特定条件下，无凭据攻击者可访问 install.php 并尝试重装运行中的站点，进而导致站点接管或远程代码执行；若 Web 服务器无法写入或更改 settings.php 的权限，部分利用路径会被阻断。",{"_57":292,"_286":284},"2026-11-19T17:49:52.000Z","Horizon3.ai","eca8176ln16b9nsoow3iupcqj","Drupal core 安装器漏洞 CVE-2026-132165 已被在野利用，CISA 加入 KEV 目录","Drupal core 安装器漏洞 CVE-2026-132165 已在真实站点上被利用，可导致远程代码执行。该漏洞于 11 月 18 日修复，Drupal 安全团队记录最早利用时间为 2026-11-19 19:00 UTC，CISA 于 11 月 24 日将其加入 KEV 目录并要求联邦机构在 11 月 27 日前处置。",{"_57":299,"_286":284},"2026-11-25T08:01:06.000Z",true,"SecurityWeek","h04703th3om87f3me3xl3nsnh","攻击者利用 Drupal RCE 漏洞 CVE-2026-132165 接管站点","攻击者已被确认利用 Drupal RCE 漏洞 CVE-2026-132165 接管未打补丁站点，最早利用时间为 2026-11-19 19:00 UTC。匿名攻击者可滥用 Drupal 安装器重新安装站点并实现远程代码执行；部分利用路径在服务器无法写入或修改 settings.php 权限时会受阻。",{"_57":305,"_286":284},"2026-11-25T10:10:20.000Z","BleepingComputer","rnegnddxf2wbjfu7xce6rt7o4","Drupal Fail2Install 漏洞 CVE-2026-132165 已在真实站点遭到利用","Drupal Fail2Install 远程代码执行漏洞 CVE-2026-132165（CVSS 9.8）已被用于攻击真实站点，CISA 将其纳入 KEV，并要求联邦机构在 2026 年 11 月 27 日前完成修复。",{"_57":285,"_286":284},"2026-11-25T11:23:26.000Z","qi1nz4ggvbuv6km3ay0a86i3c","CISA 将 Idunno AntiCsrf、Drupal Core 和 Optimizely Web Experimentation 漏洞加入 KEV","Idunno AntiCsrf 的 CVE-2026-131914、Drupal Core 的 CVE-2026-132165、Optimizely Web Experimentation 的 CVE-2026-132224 已被用于真实攻击，CISA 于 November 24, 2026 将其加入 KEV。",{"_57":316,"_286":284},"2026-11-25T11:46:54.000Z","Security Affairs","zbtit8lctzs7uisky94zr2nx4","攻击者至少自 2026-11-19 19:00 UTC 起利用 Drupal 安装器漏洞 CVE-2026-132165，在无需登录的情况下接管未打补丁的站点。",{"_57":320,"_286":284},"Help Net Security",{"_325":339,"_13":340,"_21":304,"_17":165,"_328":341},{"_325":335,"_13":336,"_21":297,"_17":165,"_328":337},{"_325":331,"_13":332,"_21":291,"_17":168,"_328":333},{"_325":326,"_13":327,"_21":22,"_17":168,"_328":329},"factId","fv0ImWWdW5sk","Drupal 披露并修复安装器接管漏洞","representative",{"_276":277,"_13":278,"_29":279,"_280":330,"_282":22,"_283":284},{"_57":285,"_286":284},"fc7ZWjJkn7rU","分析Drupal安装器远程代码执行漏洞",{"_276":287,"_13":288,"_29":289,"_280":334,"_282":291,"_283":284},{"_57":292,"_286":284},"fnn4Ufi2IC48","CISA将Drupal漏洞纳入在野利用目录",{"_276":306,"_13":307,"_29":308,"_280":338,"_282":310,"_283":298},{"_57":285,"_286":284},"fR_AtN074jqw","Drupal 关键 RCE 漏洞已被在野利用",{"_276":300,"_13":301,"_29":302,"_280":342,"_282":304,"_283":284},{"_57":305,"_286":284},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",{"_350":351,"_352":-5},"changelogVersion","2026-10-01T08:00","release"]
