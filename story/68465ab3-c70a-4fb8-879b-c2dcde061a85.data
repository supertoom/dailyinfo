[{"_1":2,"_3":4},"root",{"_5":424},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":-5,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48},"expiresAt",1795740055000,"publicId","68465ab3-c70a-4fb8-879b-c2dcde061a85","title","Drupal安装器RCE漏洞CVE-2026-132165已被在野利用","status","active","reportCount",10,"sourceCount",8,"firstReportAt","2026-11-19T14:33:06.000Z","latestAt","2026-11-26T10:33:00.000Z","digest","Drupal core 内置安装器远程代码执行漏洞 CVE-2026-132165 已被确认在真实站点上遭到利用：奇安信 CERT 与绿盟科技 CERT 均监测到攻击者利用该漏洞在无需登录的情况下接管未打补丁站点并执行任意命令，漏洞细节与 PoC 已公开。Drupal 安全团队记录的最早利用时间为 2026-11-19 19:00 UTC；CISA 已于 11 月 24 日将该漏洞加入 KEV 目录，要求联邦机构在 11 月 27 日前处置。漏洞评分在不同来源间不一致，The Hacker News 与绿盟科技 CERT 分别记为 25 分中的 18 分（CVSS 9.8）与 8.1。\n\n成因是 Drupal core 安装器状态校验不当：站点已完成安装但安装任务状态未闭环时，未认证攻击者可匿名续跑 /core/install.php 安装流程，覆盖 uid 1 管理员账户的用户名、邮箱和密码。Searchlight Cyber 称，滥用服务器资源限制可诱使 Drupal 误判站点未安装，据此确认影响 Drupal 8.9、9、10、11 的四种常见部署组合（Apache/PHP-FPM 分别搭配 MySQL 与 PostgreSQL）。受影响版本为 Drupal Core 低于 10.6.22、11.0.0 至 11.3.22、11.4.0 至 11.4.13。\n\n修复版本为 Drupal 11.4.13、11.3.22 和 10.6.22，停止支持的分支不提供修复。若 Web 服务器无法写入或更改 settings.php 权限，可阻断部分（并非全部）利用路径；Drupal 建议升级后仍封锁安装器，因 core 默认 .htaccess 规则不拦截该脚本，管理员需在 Web 服务器配置或根目录 .htaccess 中阻断 /core/install.php，暂不能升级时也应先实施该措施。","digestUpdatedAt","2026-11-26T17:40:57.531Z","summary","excerpt","latest","Drupal 远程代码执行漏洞 CVE-2026-132165 已发现在野利用","latestReport",{"_327":385},"whyHot",{"_418":154,"_419":420,"_421":239,"_422":349,"_423":231},"developments",[391,392,393,394,395],"officialReports",[389],"timeline",[317,318,319,320,321,322,323,324,325,326],"heat",[69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130,131,132,133,134,135,136,137,138,139,140,141,142,143,144,145,146,147,148,149],"related",[],"topics",