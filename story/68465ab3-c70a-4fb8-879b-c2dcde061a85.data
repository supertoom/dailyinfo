[{"_1":2,"_3":4},"root",{"_5":123},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795135249000,"publicId","68465ab3-c70a-4fb8-879b-c2dcde061a85","title","Drupal 修复安装器远程代码执行漏洞","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-19T14:33:06.000Z","latestAt","2026-11-19T17:49:52.000Z","digest","Drupal 安全团队披露并修复 Drupal core 内置安装器远程代码执行漏洞 CVE-2026-132165。特定条件下，未认证攻击者可访问 install.php 并尝试重装站点，进而导致站点接管或远程代码执行；CVSS 评分为 25 分中的 18 分，利用复杂度为复杂，已有公开概念验证 exploit，但尚无实际攻击报告，影响规模未确认。所有受支持分支均已发布修复版本。\n\n默认 .htaccess 规则不会阻止安装器请求，站点需自行配置阻断；Drupal 安全团队建议即使更新后也继续封锁安装器。Horizon3 分析称，若 Web 服务器无法写入 settings.php 或更改其权限，部分利用路径会被阻断。","digestUpdatedAt","2026-11-19T18:07:36.523Z","summary","excerpt","latest","Drupal Core Installer 远程代码执行漏洞 CVE-2026-132165","latestReport",{"_88":99},"whyHot",{"_115":18,"_116":117,"_118":18,"_119":120,"_121":122},"developments",[103,104],"officialReports",[],"timeline",[86,87],"heat",[56,57,58,59,60,61,62,63,64],"related",[],"topics",[48,49],{"_50":54,"_52":55},{"_50":51,"_52":53},"slug","exploited","name","在野利用","vuln","漏洞披露",{"_65":84,"_42":85,"_68":83},{"_65":81,"_42":82,"_68":83},{"_65":79,"_42":80,"_68":18},{"_65":77,"_42":78,"_68":18},{"_65":75,"_42":76,"_68":18},{"_65":73,"_42":74,"_68":18},{"_65":71,"_42":72,"_68":18},{"_65":69,"_42":70,"_68":18},{"_65":66,"_42":67,"_68":18},"hour","2026-11-20T00:00:00.000Z",16,"participants","2026-11-19T23:00:00.000Z",16.4,"2026-11-19T22:00:00.000Z",16.9,"2026-11-19T21:00:00.000Z",17.4,"2026-11-19T20:00:00.000Z",17.9,"2026-11-19T19:00:00.000Z",18.5,"2026-11-19T18:00:00.000Z",19,"2026-11-19T17:00:00.000Z",9.3,1,"2026-11-19T16:00:00.000Z",9.6,{"_88":99,"_13":31,"_28":100,"_92":101,"_94":23,"_95":96},{"_88":89,"_13":90,"_28":91,"_92":93,"_94":21,"_95":96},"id","o6wemt6o90bge8ogzpb1qnfc3","Drupal 修复关键安装器漏洞 CVE-2026-132165，可能导致 RCE","Drupal core 的内置安装器漏洞 CVE-2026-132165 可在特定条件下被未认证攻击者利用，尝试重装站点并造成站点接管或 RCE，项目风险评分为 25 分中的 18 分。","source",{"_52":97,"_98":96},"publishedAt","selected",false,"The Hacker News","firstParty","iotnmq0t4j7557cj844m84n94","CVE-2026-132165 是 Drupal Core 安装程序中的严重远程代码执行漏洞。在特定条件下，无凭据攻击者可访问 install.php 并尝试重装运行中的站点，进而导致站点接管或远程代码执行；若 Web 服务器无法写入或更改 settings.php 的权限，部分利用路径会被阻断。",{"_52":102,"_98":96},"Horizon3.ai",{"_105":111,"_13":112,"_20":23,"_17":83,"_108":113},{"_105":106,"_13":107,"_20":21,"_17":83,"_108":109},"factId","fv0ImWWdW5sk","Drupal 披露并修复安装器接管漏洞","representative",{"_88":89,"_13":90,"_28":91,"_92":110,"_94":21,"_95":96},{"_52":97,"_98":96},"fc7ZWjJkn7rU","分析Drupal安装器远程代码执行漏洞",{"_88":99,"_13":31,"_28":100,"_92":114,"_94":23,"_95":96},{"_52":102,"_98":96},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete",true,"rank",9,{"_124":125,"_126":-5},"changelogVersion","2026-10-01T08:00","release"]
