[{"_1":2,"_3":4},"root",{"_5":182},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795912857000,"publicId","7b0a7fe2-a447-47f3-8010-7006dc9f4be8","title","美国空军 Cloud One 平台疑遭控制面入侵","status","watching","reportCount",3,"sourceCount","firstReportAt","2026-11-27T11:38:29.000Z","latestAt","2026-11-27T15:03:05.000Z","digest","黑客已攻破美国空军旗舰云平台 Cloud One；后续报道指其利用软件漏洞访问管理平台核心功能的控制面，但攻击者身份、受影响范围及是否发生数据失窃尚未确认，也无证据表明平台已被成功利用或存在公开补丁。\n\n事件在平台升级时暴露，随后应用更新被阻止，影响空军人员安装安全修复；后台应用迁移一度暂停，部分用户管理员权限被撤销，显示服务运行和权限管理已受影响。","digestUpdatedAt","2026-11-27T16:10:51.835Z","summary","excerpt","latest","美国空军 Cloud One 云平台遭入侵，攻击范围与数据失窃情况不明","latestReport",{"_146":157},"whyHot",{"_175":90,"_176":177,"_178":177,"_179":160,"_180":181},"developments",[168],"officialReports",[],"timeline",[143,144,145],"heat",[59,60,61,62,63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85],"related",[],"topics",[48,49,50],{"_51":57,"_53":58},{"_51":55,"_53":56},{"_51":52,"_53":54},"slug","attack","name","攻击活动","cloud-native","云与原生","supply-chain","供应链安全",{"_86":142,"_42":106,"_89":141},{"_86":139,"_42":140,"_89":141},{"_86":137,"_42":138,"_89":90},{"_86":135,"_42":136,"_89":90},{"_86":133,"_42":134,"_89":90},{"_86":131,"_42":132,"_89":90},{"_86":129,"_42":130,"_89":90},{"_86":127,"_42":128,"_89":90},{"_86":125,"_42":126,"_89":90},{"_86":123,"_42":124,"_89":90},{"_86":121,"_42":122,"_89":90},{"_86":119,"_42":120,"_89":90},{"_86":117,"_42":118,"_89":90},{"_86":115,"_42":116,"_89":90},{"_86":113,"_42":114,"_89":90},{"_86":111,"_42":112,"_89":90},{"_86":109,"_42":110,"_89":90},{"_86":107,"_42":108,"_89":90},{"_86":105,"_42":106,"_89":90},{"_86":103,"_42":104,"_89":90},{"_86":101,"_42":102,"_89":90},{"_86":99,"_42":100,"_89":90},{"_86":97,"_42":98,"_89":90},{"_86":95,"_42":96,"_89":90},{"_86":93,"_42":94,"_89"