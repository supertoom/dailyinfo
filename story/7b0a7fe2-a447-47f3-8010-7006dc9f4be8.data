[{"_1":2,"_3":4},"root",{"_5":135},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795826460000,"publicId","7b0a7fe2-a447-47f3-8010-7006dc9f4be8","title","美国空军 Cloud One 平台疑遭控制面入侵","status","active","reportCount",3,"sourceCount","firstReportAt","2026-11-27T11:38:29.000Z","latestAt","2026-11-27T15:03:05.000Z","digest","黑客已攻破美国空军旗舰云平台 Cloud One；后续报道指其利用软件漏洞访问管理平台核心功能的控制面，但攻击者身份、受影响范围及是否发生数据失窃尚未确认，也无证据表明平台已被成功利用或存在公开补丁。\n\n事件在平台升级时暴露，随后应用更新被阻止，影响空军人员安装安全修复；后台应用迁移一度暂停，部分用户管理员权限被撤销，显示服务运行和权限管理已受影响。","digestUpdatedAt","2026-11-27T16:10:51.835Z","summary","excerpt","latest","美国空军 Cloud One 云平台遭入侵，攻击范围与数据失窃情况不明","latestReport",{"_99":110},"whyHot",{"_128":74,"_129":130,"_131":74,"_132":113,"_133":134},"developments",[121],"officialReports",[],"timeline",[96,97,98],"heat",[59,60,61,62,63,64,65,66,67,68,69],"related",[],"topics",[48,49,50],{"_51":57,"_53":58},{"_51":55,"_53":56},{"_51":52,"_53":54},"slug","attack","name","攻击活动","cloud-native","云与原生","supply-chain","供应链安全",{"_70":94,"_42":95,"_73":93},{"_70":91,"_42":92,"_73":93},{"_70":89,"_42":90,"_73":74},{"_70":87,"_42":88,"_73":74},{"_70":85,"_42":86,"_73":74},{"_70":83,"_42":84,"_73":74},{"_70":81,"_42":82,"_73":74},{"_70":79,"_42":80,"_73":74},{"_70":77,"_42":78,"_73":74},{"_70":75,"_42":76,"_73":74},{"_70":71,"_42":72,"_73":74},"hour","2026-11-28T00:00:00.000Z",14.7,"participants",2,"2026-11-27T23:00:00.000Z",15.2,"2026-11-27T22:00:00.000Z",15.6,"2026-11-27T21:00:00.000Z",16.1,"2026-11-27T20:00:00.000Z",16.5,"2026-11-27T19:00:00.000Z",17,"2026-11-27T18:00:00.000Z",17.5,"2026-11-27T17:00:00.000Z",18,"2026-11-27T16:00:00.000Z",18.5,"2026-11-27T15:00:00.000Z",9.1,1,"2026-11-27T14:00:00.000Z",9.3,{"_99":115,"_13":116,"_28":117,"_103":118,"_105":119,"_106":107},{"_99":110,"_13":31,"_28":111,"_103":112,"_105":23,"_106":113},{"_99":100,"_13":101,"_28":102,"_103":104,"_105":21,"_106":107},"id","sn8t7dpqbr4jkxubnvzqx0lrv","黑客攻破美国空军 Cloud One 云计算平台","黑客攻破美国空军旗舰级云平台 Cloud One。事件被发现后，部分迁移被暂停，更新被阻塞，一些用户还失去了管理员权限。原文未披露具体攻击手法、受影响范围及处置进展。","source",{"_53":108,"_109":107},"publishedAt","selected",false,"Cybernews","firstParty","wuwxqwmjofamcgppwkw7wuf5s","美国空军主要云计算平台 Cloud One 遭黑客入侵，攻击者身份、受影响范围及数据是否被窃取尚未确认。该事件约在 1 个月前升级平台时被发现，导致服务中断、应用更新被阻止，后台应用迁移至 Cloud One 的工作暂停，部分用户管理员权限被撤销。",{"_53":114,"_109":107},true,"Security Affairs","iumzubpojln46gurdf3hve36s","美国空军 Cloud One 云平台据报遭入侵，攻击范围与数据失窃情况未知","美国空军 Cloud One 云计算平台据报遭黑客入侵，攻击者利用尚未确定的软件漏洞获得访问权限，并可能接触军事行动及后勤敏感信息；平台升级期间发现入侵，应用迁移和软件更新因此中断。",{"_53":120,"_109":107},"2026-11-27T15:09:40.000Z","BleepingComputer",{"_122":123,"_13":124,"_20":21,"_17":74,"_125":126},"factId","f4L8ZnlbpNeo","黑客攻破美国空军 Cloud One 平台","representative",{"_99":110,"_13":31,"_28":111,"_103":127,"_105":23,"_106":113},{"_53":114,"_109":107},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",6,{"_136":137,"_138":-5},"changelogVersion","2026-10-01T08:00","release"]
