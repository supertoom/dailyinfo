[{"_1":2,"_3":4},"root",{"_5":211},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794876039000,"publicId","c5e0f30f-70a6-467f-8b4b-76458043e208","title","Maileva攻击致2200万人信息泄露","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-15T10:43:16.000Z","latestAt","2026-11-16T15:25:00.000Z","digest","La Poste旗下文件寄送服务商Maileva确认，9月中旬遭受的网络攻击导致2200万人的名字、姓氏和邮政地址泄露，受影响者包括患者、租户及数千家客户企业的收件人，多数并非Maileva客户。银行信息未被窃取，但据报道，攻击者读取了部分付款提醒，其中含发票编号、治疗日期和欠款金额。\n\nMaileva因平台遭未经授权访问，于9月23日暂停服务，9月29日恢复，中断6天；公司称事件确定后已通知受影响客户。公司已通报法国数据保护机构CNIL并提交刑事报案，司法调查仍在进行；尚无公开结论确认攻击者身份或被盗数据是否被发布、出售。","digestUpdatedAt","2026-11-16T15:56:49.570Z","summary","excerpt","latest","La Poste 旗下 Maileva 遭网络攻击，2200 万人姓名和邮政地址泄露","latestReport",{"_181":193},"whyHot",{"_204":18,"_205":206,"_207":124,"_208":189,"_209":210},"developments",[197],"officialReports",[],"timeline",[179,180],"heat",[65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101],"related",[],"topics",[48,49,50,51,52],{"_53":63,"_55":64},{"_53":61,"_55":62},{"_53":59,"_55":60},{"_53":57,"_55":58},{"_53":54,"_55":56},"slug","identity","name","身份与访问","supply-chain","供应链安全","attack","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件",{"_102":177,"_42":178,"_105":124},{"_102":175,"_42":176,"_105":124},{"_102":173,"_42":174,"_105":124},{"_102":171,"_42":172,"_105":124},{"_102":169,"_42":170,"_105":124},{"_102":167,"_42":168,"_105":124},{"_102":165,"_42":166,"_105":124},{"_102":163,"_42":164,"_105":124},{"_102":161,"_42":162,"_105":124},{"_102":159,"_42":160,"_105":124},{"_102":157,"_42":158,"_105":124},{"_102":155,"_42":156,"_105":124},{"_102":153,"_42":154,"_105":124},{"_102":151,"_42":152,"_105":124},{"_102":149,"_42":150,"_105":124},{"_102":147,"_42":148,"_105":124},{"_102":145,"_4