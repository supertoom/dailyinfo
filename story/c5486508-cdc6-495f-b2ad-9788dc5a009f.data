[{"_1":2,"_3":4},"root",{"_5":201},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1793591189000,"publicId","c5486508-cdc6-495f-b2ad-9788dc5a009f","title","Android短信拒绝服务漏洞PoC公开","status","active","reportCount",2,"sourceCount","firstReportAt","2026-10-31T15:35:11.000Z","latestAt","2026-11-01T12:16:50.000Z","digest","安全研究员 Mark Blah（另篇报道称 Mark Blaszczyk）公开了 Android CVE-2026-58882 的概念验证利用代码：攻击者可从另一台 Android 设备发送特制 WAP Push 短信，零点击触发 WapPushOverSms.decodeWapPdu 远程拒绝服务，阻断电话服务，包括紧急呼叫。PoC 已证实可复现，但尚无已确认受害数量；研究称单条消息可引发最长一周的间歇性崩溃，约二十条可使设备长期不可用。\n\nGoogle 据报已在 2026 年 10 月的 Android 安全更新中修复 Android 14 至 17，并删除恶意短信以避免反复崩溃；报道指 Android 12 和 13 未收到修复、仍可能受影响。不过，另一篇报道称漏洞代码在 Android 12 至 17 均存在，显示受影响代码范围与实际修复范围存在差异。","digestUpdatedAt","2026-11-01T13:28:02.421Z","summary","excerpt","latest","Android SMS of Death 漏洞分析：CVE-2026-58882 可用零点击 WAP Push 消息阻断电话服务","latestReport",{"_172":184},"whyHot",{"_195":18,"_196":197,"_198":131,"_199":180,"_200":18},"developments",[188],"officialReports",[],"timeline",[170,171],"heat",[62,63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96],"related",[],"topics",[48,49,50,51],{"_52":60,"_54":61},{"_52":58,"_54":59},{"_52":56,"_54":57},{"_52":53,"_54":55},"slug","research","name","技术研究","vuln","漏洞披露","mobile","移动端","google","Google / 谷歌",{"_97":168,"_42":169,"_100":131},{"_97":166,"_42":167,"_100":131},{"_97":164,"_42":165,"_100":131},{"_97":162,"_42":163,"_100":131},{"_97":160,"_42":161,"_100":131},{"_97":158,"_42":159,"_100":131},{"_97":156,"_42":157,"_100":131},{"_97":154,"_42":155,"_100":131},{"_97":152,"_42":153,"_100":131},{"_97":150,"_42":151,"_100":131},{"_97":148,"_42":149,"_100":131},{"_97":146,"_42":147,"_100":131},{"_97":144,"_42":145,"_100":131},{"_97":142,"_42":143,"_100":131},{"_97":140,"_42":141