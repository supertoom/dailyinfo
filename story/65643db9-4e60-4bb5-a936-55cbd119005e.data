[{"_1":2,"_3":4},"root",{"_5":123},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794530497000,"publicId","65643db9-4e60-4bb5-a936-55cbd119005e","title","弱口令攻击入侵SQL Server植入挖矿与RAT","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-12T16:00:00.000Z","latestAt","2026-11-12T16:30:49.000Z","digest","FortiGuard Labs 披露，攻击者扫描互联网暴露的 Microsoft SQL Server，以“sa”“admin”等用户名和超过2700个密码逐一爆破，利用获取的数据库权限启用 xp_cmdshell，在底层 Windows 服务器下载或解压加载器，植入 Monero 挖矿程序和 Gh0st RAT。该活动依赖弱口令，并非新发现的软件漏洞；xp_cmdshell 需要足够数据库权限且默认关闭，获得数据库登录也不等于完全控制 Windows。\n\nFortiGuard Labs 未披露受害服务器数量或幕后组织；其分析时命令控制服务器已关闭，研究人员因此以静态方式检查代码。","digestUpdatedAt","2026-11-12T17:38:39.603Z","summary","excerpt","latest","攻击者利用 Microsoft SQL Server 弱口令部署 Monero 矿工和 Gh0st RAT","latestReport",{"_93":104},"whyHot",{"_115":18,"_116":117,"_118":18,"_119":120,"_121":122},"developments",[108],"officialReports",[],"timeline",[91,92],"heat",[65,66,67,68,69,70,71,72],"related",[],"topics",[48,49,50,51,52],{"_53":63,"_55":64},{"_53":61,"_55":62},{"_53":59,"_55":60},{"_53":57,"_55":58},{"_53":54,"_55":56},"slug","botnet","name","僵尸网络","malware","恶意软件","attack","攻击活动","identity","身份与访问","microsoft","Microsoft / 微软",{"_73":89,"_42":90,"_76":18},{"_73":87,"_42":88,"_76":18},{"_73":85,"_42":86,"_76":18},{"_73":83,"_42":84,"_76":18},{"_73":81,"_42":82,"_76":18},{"_73":79,"_42":80,"_76":18},{"_73":77,"_42":78,"_76":18},{"_73":74,"_42":75,"_76":18},"hour","2026-11-13T00:00:00.000Z",16,"participants","2026-11-12T23:00:00.000Z",16.5,"2026-11-12T22:00:00.000Z",16.9,"2026-11-12T21:00:00.000Z",17.4,"2026-11-12T20:00:00.000Z",18,"2026-11-12T19:00:00.000Z",18.5,"2026-11-12T18:00:00.000Z",19,"2026-11-12T17:00:00.000Z",19.6,{"_93":104,"_13":31,"_28":105,"_97":106,"_99":23,"_100":101},{"_93":94,"_13":95,"_28":96,"_97":98,"_99":21,"_100":101},"id","q7hlbb41dwb2l9ikl7t4fo991","攻击者利用弱口令入侵 Microsoft SQL Server，部署 XMRig 挖矿程序与 Gh0st RAT","Fortinet 研究团队发现，攻击者正扫描暴露在互联网的 Microsoft SQL Server，以弱口令爆破登录并植入 Monero 挖矿程序和 Gh0st RAT；尚未披露受害服务器数量及幕后组织。","source",{"_55":102,"_103":101},"publishedAt","selected",false,"Infosecurity Magazine","firstParty","bbc8t71q6rjxxchzs487x7lam","攻击者针对暴露在互联网且使用弱口令的 Microsoft SQL Server，通过密码猜测获取数据库权限，再启用 xp_cmdshell 在底层 Windows 服务器执行命令并投放恶意程序。",{"_55":107,"_103":101},"Hackread",{"_109":110,"_13":111,"_20":21,"_17":18,"_112":113},"factId","fDbLoDHRl2ds","弱密码SQL服务器遭挖矿与RAT入侵","representative",{"_93":94,"_13":95,"_28":96,"_97":114,"_99":21,"_100":101},{"_55":102,"_103":101},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete",true,"rank",10,{"_124":125,"_126":-5},"changelogVersion","2026-10-01T08:00","release"]
