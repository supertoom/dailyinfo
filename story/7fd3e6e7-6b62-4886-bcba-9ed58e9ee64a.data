[{"_1":2,"_3":4},"root",{"_5":131},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794271241000,"publicId","7fd3e6e7-6b62-4886-bcba-9ed58e9ee64a","title","英军海外部署网络狩猎部队干扰黑客","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-09T04:44:20.872Z","latestAt","2026-11-09T09:37:00.000Z","digest","英国国防网络与电磁部队已定期向欧洲和亚洲派遣网络“狩猎部队”，在东道国同意及国防大臣批准的条件下，于敌方黑客筹备攻击阶段前出，干扰国家背景攻击者和犯罪分子，阻断针对英国军事系统的早期网络攻击；目前未披露具体部署规模、干预效果或确认被利用事件。\n\n该部队由700多名现役军人、预备役人员和文职人员组成，也在科舍姆清除潜伏于英国国防部系统中的入侵者及潜在恶意软件。英国国防部2025年5月称，过去两年遭遇9万次来自“与国家有关联的来源”的网络攻击。","digestUpdatedAt","2026-11-09T12:51:38.301Z","summary","excerpt","latest","英军向欧洲和亚洲派遣网络“狩猎部队”前出阻断敌对黑客","latestReport",{"_102":113},"whyHot",{"_123":18,"_124":125,"_126":18,"_127":128,"_129":130},"developments",[116],"officialReports",[],"timeline",[100,101],"heat",[59,60,61,62,63,64,65,66,67,68,69,70,71],"related",[],"topics",[48,49,50],{"_51":57,"_53":58},{"_51":55,"_53":56},{"_51":52,"_53":54},"slug","ai-security","name","AI 安全","blue-team","蓝队与运营","incident","应急响应",{"_72":98,"_42":99,"_75":18},{"_72":96,"_42":97,"_75":18},{"_72":94,"_42":95,"_75":18},{"_72":92,"_42":93,"_75":18},{"_72":90,"_42":91,"_75":18},{"_72":88,"_42":89,"_75":18},{"_72":86,"_42":87,"_75":18},{"_72":84,"_42":85,"_75":18},{"_72":82,"_42":83,"_75":18},{"_72":80,"_42":81,"_75":18},{"_72":78,"_42":79,"_75":18},{"_72":76,"_42":77,"_75":18},{"_72":73,"_42":74,"_75":18},"hour","2026-11-10T00:00:00.000Z",12.3,"participants","2026-11-09T23:00:00.000Z",12.7,"2026-11-09T22:00:00.000Z",13.1,"2026-11-09T21:00:00.000Z",13.5,"2026-11-09T20:00:00.000Z",13.8,"2026-11-09T19:00:00.000Z",14.3,"2026-11-09T18:00:00.000Z",14.7,"2026-11-09T17:00:00.000Z",15.1,"2026-11-09T16:00:00.000Z",15.5,"2026-11-09T15:00:00.000Z",16,"2026-11-09T14:00:00.000Z",16.5,"2026-11-09T13:00:00.000Z",16.9,"2026-11-09T12:00:00.000Z",17.4,{"_102":113,"_13":31,"_28":114,"_106":115,"_108":23,"_109":110},{"_102":103,"_13":104,"_28":105,"_106":107,"_108":21,"_109":110},"id","npa6ef9m2kuf4jbl7kahl8spw","英国向欧洲和亚洲部署网络“狩猎部队”以阻断敌对黑客","英国军方正定期向欧洲和亚洲派遣网络“狩猎部队”，在东道国同意和国防大臣批准的条件下，于敌方黑客筹备攻击阶段接近受感染服务器或相关设施，通过前出部署干扰国家背景攻击者与犯罪分子，以保护英国军事系统。英国国防网络与电磁部队称，人工智能正把漏洞修补窗口期从数天压缩到数十分钟，并担忧恶意软件预先潜伏于国防网络，在冲突爆发时突然生效；该部队由 700 多名现役军人、预备役人员和文职人员组成。","source",{"_53":111,"_112":110},"publishedAt","selected",false,"安全内参","firstParty","f5d92e20i5t50a1hxukfnzj0k","英军已定期向欧洲和亚洲派遣网络“狩猎部队”，在东道国同意下利用工具干扰国家背景攻击者和犯罪分子，以阻断针对英国军事系统的早期网络攻击。原文称，英国国防网络与电磁部队由 700 多名现役军人、预备役人员和文职人员组成，并在科舍姆持续清除国防部网络中的入侵者与潜在恶意软件。",{"_53":111,"_112":110},{"_117":118,"_13":119,"_20":21,"_17":18,"_120":121},"factId","fIHicWk3wrJ8","英军海外部署网络狩猎部队","representative",{"_102":113,"_13":31,"_28":114,"_106":122,"_108":23,"_109":110},{"_53":111,"_112":110},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete",true,"rank",7,{"_132":133,"_134":-5},"changelogVersion","2026-10-01T08:00","release"]
