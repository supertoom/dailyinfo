[{"_1":2,"_3":4},"root",{"_5":290},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795394447000,"publicId","52702772-c6ed-4351-9e9b-8fc6f1b0fd43","title","Cairn利用MONAI Label零日漏洞取得服务器权限","status","watching","reportCount",5,"sourceCount","firstReportAt","2026-11-20T17:30:00.000Z","latestAt","2026-11-21T12:08:50.000Z","digest","Amazon Threat Intelligence 披露，疑似中国关联威胁行为者使用自主 AI Agent 平台 Cairn，攻击东亚地区中国大陆以外大学等机构使用的 MONAI Label 医疗影像标注工具；Cairn 发现并利用路径遍历零日漏洞 CVE-2026-133968，在一台大学服务器上取得 root 权限。漏洞允许无账户用户将文件写入服务器存储目录之外，影响默认未启用登录的 MONAI Label 0.8.5 及更早版本，能否取得 root 取决于部署方式及服务账户权限。\n\nAmazon 称攻击约持续 48 小时，攻击者约 11 分钟便完成 API 梳理和漏洞利用；维护方已发布安全公告并合并修复，但尚无包含修复的可安装版本。Amazon 以中等置信度将该活动归因于中国关联行为者；受影响组织均为非 AWS 客户。","digestUpdatedAt","2026-11-21T12:39:37.326Z","summary","excerpt","latest","Amazon称中国关联黑客利用AI agents攻破MONAI Label漏洞","latestReport",{"_243":267},"whyHot",{"_284":127,"_285":286,"_287":286,"_288":251,"_289":142},"developments",[277],"officialReports",[],"timeline",[238,239,240,241,242],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","ai-agent","name","AI Agent 安全","identity","身份与访问","supply-chain","供应链安全","ai-offense","AI 攻防","attack","攻击活动","exploited","在野利用",{"_123":236,"_42":237,"_126":127},{"_123":234,"_42":235,"_126":127},{"_123":232,"_42":233,"_126":127},{"_123":230,"_42":231,"_126":127},{"_123":228,"_42":229,"_126":127},{"_123":226,"_42":227,"_126":127},{"_123":224,"_42":225,"_126":127},{"_123":222,"_42":223,"_126":127},{"_123":220,"_42":221,"_126":127},{"_123":218