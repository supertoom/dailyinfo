[{"_1":2,"_3":4},"root",{"_5":123},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795221647000,"publicId","52702772-c6ed-4351-9e9b-8fc6f1b0fd43","title","自主AI平台Cairn被发现利用MONAI Label路径穿越零日漏洞攻破服务器","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-20T17:30:00.000Z","latestAt","2026-11-20T17:30:13.000Z","digest","Amazon Threat Intelligence 披露，疑似中国关联威胁行为者使用自主 AI Agent 平台 Cairn 攻破医疗影像标注应用 MONAI Label 的一个路径穿越零日漏洞，取得服务器完全控制权限；发现该漏洞时尚无对应安全公告编号、且未打补丁，维护方已于 11 月 18 日发布安全更新。攻击者借助该漏洞可向服务器任意路径写入文件，并在 11 分钟内完成从梳理应用 API 到利用的过程。\n\n攻击发生于 2026 年 9 月 8 日至 10 日，目标包括中国境外的东亚高校以及使用 MONAI Label 的航空航天组织；其中规模最大的一次行动针对某高校一个允许无认证访问的 Redis 实例。受影响组织均为非 AWS 客户，AWS 无法直接通知。Amazon Threat Intelligence 基于简体中文提示词、中国标准时间脚本时间戳以及对中国有战略价值的高校目标选择，以中等置信度将该活动归因于中国关联威胁行为者。","digestUpdatedAt","2026-11-20T18:32:13.102Z","summary","excerpt","latest","AWS 披露 Cairn AI Agent 自主发现零日漏洞并攻击高校","latestReport",{"_93":105},"whyHot",{"_116":18,"_117":118,"_119":18,"_120":101,"_121":122},"developments",[109],"officialReports",[],"timeline",[91,92],"heat",[68,69,70,71,72,73,74],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","ai-security","name","AI 安全","malware","恶意软件","ai-offense","AI 攻防","ai-agent","AI Agent 安全","attack","攻击活动","exploited","在野利用",{"_75":89,"_42":90,"_78":18},{"_75":87,"_42":88,"_78":18},{"_75":85,"_42":86,"_78":18},{"_75":83,"_42":84,"_78":18},{"_75":81,"_42":82,"_78":18},{"_75":79,"_42":80,"_78":18},{"_75":76,"_42":77,"_78":18},"hour","2026-11-21T00:00:00.000Z",16.6,"participants","2026-11-20T23:00:00.000Z",17.1,"2026-11-20T22:00:00.000Z",17.6,"2026-11-20T21:00:00.000Z",18.1,"2026-11-20T20:00:00.000Z",18.6,"2026-11-20T19:00:00.000Z",19.2,"2026-11-20T18:00:00.000Z",19.7,{"_93":105,"_13":31,"_28":106,"_97":107,"_99":23,"_100":101},{"_93":94,"_13":95,"_28":96,"_97":98,"_99":21,"_100":101},"id","mfif5csbm0luk6anr64r4hzho","攻击者利用自主 AI 工具 Cairn 攻陷 MONAI Label 漏洞并取得服务器权限","Amazon Threat Intelligence 发现疑似中国关联攻击者使用自主 AI Agent 平台 Cairn，于 2026 年 9 月 8 日至 10 日攻击中国境外东亚教育机构。","source",{"_56":102,"_103":104},"publishedAt","selected",true,"BleepingComputer","firstParty",false,"dcch6vrh267pbs79iv9qncpeu","Amazon Threat Intelligence 披露，中国关联威胁行为者使用开源自主 AI 渗透框架 Cairn，以“获取 shell 访问权限”为目标攻击中国境外东亚高校。",{"_56":108,"_103":104},"AWS Security Blog",{"_110":111,"_13":112,"_20":21,"_17":18,"_113":114},"factId","fVbDsNwWSOac","攻击者利用Cairn发现并利用零日漏洞","representative",{"_93":94,"_13":95,"_28":96,"_97":115,"_99":21,"_100":101},{"_56":102,"_103":104},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",9,{"_124":125,"_126":-5},"changelogVersion","2026-10-01T08:00","release"]
