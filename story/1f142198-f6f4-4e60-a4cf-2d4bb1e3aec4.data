[{"_1":2,"_3":4},"root",{"_5":129},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794876038000,"publicId","1f142198-f6f4-4e60-a4cf-2d4bb1e3aec4","title","Barracuda披露云环境遭入侵","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-16T15:07:32.000Z","latestAt","2026-11-16T19:57:13.000Z","digest","Barracuda披露其云环境遭入侵：攻击者使用从第三方AI供应商处窃取的云访问密钥及开源AI渗透测试框架ARTEX，在11月1日至2日约44小时内访问约10个云账户，并在11月4日被发现。攻击已被确认可利用外露的有效云访问密钥取得服务器Shell权限，搜集并外传秘密存储、配置、Kubernetes服务账户及服务器元数据服务中的凭据和密钥，还在部分服务器搜索以太坊密钥库、种子短语和扩展私钥，并在一个Kubernetes集群中留下后门。\n\n攻击者利用发现的凭据进入数据分析环境、源代码仓库和Kubernetes集群；另一次创建新云管理员身份的尝试被阻止。Barracuda尚未将攻击归因于特定组织，称ARTEX被多个团体使用。","digestUpdatedAt","2026-11-16T20:27:00.935Z","summary","excerpt","latest","Barracuda 将云环境入侵溯源至 ARTEX AI 渗透测试框架","latestReport",{"_100":112},"whyHot",{"_123":18,"_124":91,"_125":18,"_126":108,"_127":128},"developments",[116],"officialReports",[],"timeline",[98,99],"heat",[68,69,70,71,72,73,74,75,76],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","ai-offense","name","AI 攻防","black-market","数据窃取与黑产","ransomware","勒索软件","attack","攻击活动","identity","身份与访问","cloud-native","云与原生",{"_77":96,"_42":97,"_80":91},{"_77":94,"_42":95,"_80":91},{"_77":92,"_42":93,"_80":91},{"_77":89,"_42":90,"_80":91},{"_77":87,"_42":88,"_80":18},{"_77":85,"_42":86,"_80":18},{"_77":83,"_42":84,"_80":18},{"_77":81,"_42":82,"_80":18},{"_77":78,"_42":79,"_80":18},"hour","2026-11-17T00:00:00.000Z",16.6,"participants","2026-11-16T23:00:00.000Z",17.1,"2026-11-16T22:00:00.000Z",17.6,"2026-11-16T21:00:00.000Z",18.1,"2026-11-16T20:00:00.000Z",18.7,"2026-11-16T19:00:00.000Z",8.9,1,"2026-11-16T18:00:00.000Z",9.2,"2026-11-16T17:00:00.000Z",9.5,"2026-11-16T16:00:00.000Z",9.