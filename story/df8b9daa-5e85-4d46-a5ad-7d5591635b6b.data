[{"_1":2,"_3":4},"root",{"_5":156},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795740056000,"publicId","df8b9daa-5e85-4d46-a5ad-7d5591635b6b","title","Drupal核心站点接管漏洞确认在野利用","status","active","reportCount",4,"sourceCount","firstReportAt","2026-11-26T00:00:00.000Z","latestAt","2026-11-26T19:45:57.000Z","digest","Drupal维护者确认Drupal核心访问绕过漏洞CVE-2026-136716正被在野利用，攻击者可接管网站。该漏洞CMSS评分为21/25，源于对异常或不完整安装状态处理不当，并影响此前修复CVE-2026-132165（Fail2Install）后仍可远程访问install.php的网站，包括部分生产站点；已加固安装器、使install.php不可远程访问的网站不受影响。\n\n修复版本为11.4.14、11.3.23和10.6.23；Drupal 11.0.x至11.2.x及10.5.x及以下版本已停止支持，不提供修复。受影响生产站点升级后还必须运行更新钩子；管理员应运行update.php，修复受影响安装状态并确保现有及新建网站的安装器受到保护。","digestUpdatedAt","2026-11-26T20:52:02.605Z","summary","excerpt","latest","Drupal 修复已在野利用的严重漏洞 CVE-2026-136716","latestReport",{"_115":139},"whyHot",{"_150":18,"_151":152,"_153":89,"_154":131,"_155":110},"developments",[143],"officialReports",[],"timeline",[111,112,113,114],"heat",[59,60,61,62,63,64,65,66,67,68,69,70,71,72,73,74],"related",[],"topics",[48,49,50],{"_51":57,"_53":58},{"_51":55,"_53":56},{"_51":52,"_53":54},"slug","cisa","name","CISA","exploited","在野利用","vuln","漏洞披露",{"_75":108,"_42":109,"_78":110},{"_75":106,"_42":107,"_78":89},{"_75":104,"_42":105,"_78":89},{"_75":102,"_42":103,"_78":89},{"_75":100,"_42":101,"_78":89},{"_75":98,"_42":99,"_78":89},{"_75":96,"_42":97,"_78":89},{"_75":94,"_42":95,"_78":89},{"_75":92,"_42":93,"_78":89},{"_75":90,"_42":91,"_78":89},{"_75":87,"_42":88,"_78":89},{"_75":85,"_42":86,"_78":18},{"_75":83,"_42":84,"_78":18},{"_75":81,"_42":82,"_78":18},{"_75":79,"_42":80,"_78":18},{"_75":76,"_42":77,"_78":18},"hour","2026-11-27T00:00:00.000Z",26.5,"participants","2026-11-26T23:00:00.000Z",27.3,"2026-11-26T22:00:00.000Z",28.1,"2026-11-26T21:00:00.000Z",28.9,"2026-11-26T20:00:00.000Z",29.7,"2026-11-26T19:00:00.000Z",20.4,3,"2026-11-26T18:00:00.000Z",21,"2026-11-26T17:00:00.000Z",21.6,"2026-11-26T16:00:00.000Z",22.2,"2026-11-26T15:00:00.000Z",22.9,"2026-11-26T14:00:00.000Z",23.6,"2026-11-26T13:00:00.000Z",24.3,"2026-11-26T12:00:00.000Z",25,"2026-11-26T11:00:00.000Z",25.7,"2026-11-26T10:00:00.000Z",26.4,"2026-11-26T09:00:00.000Z",17.2,2,{"_115":139,"_13":31,"_28":140,"_119":141,"_121":23,"_122":131},{"_115":133,"_13":134,"_28":135,"_119":136,"_121":137,"_122":131},{"_115":126,"_13":127,"_28":128,"_119":129,"_121":130,"_122":131},{"_115":116,"_13":117,"_28":118,"_119":120,"_121":21,"_122":123},"id","ydhzotnr83i1er5iu8v76dewt","Drupal 漏洞 CVE-2026-136716 允许绕过安全策略，官方称正被利用","Drupal 存在漏洞 CVE-2026-136716，可导致安全策略被绕过，Drupal 表示该漏洞正被积极利用。受影响版本为 Drupal 11.4.x 中早于 11.4.14 的版本、11.x 中早于 11.3.23 的版本，以及早于 10.6.23 的版本。","source",{"_53":124,"_125":123},"publishedAt","selected",false,"CERT-FR","firstParty","y4nds797g3wc8tln34w9dd6xm","Drupal 核心高危站点接管漏洞 CVE-2026-136716 已被在野利用","Drupal 核心漏洞 CVE-2026-136716 已被在野利用，可导致站点接管，并关联 CVE-2026-132165（Fail2Install）修复后仍可能存在的异常或不完整安装状态；CVSS 分数尚未提供。",{"_53":132,"_125":123},"2026-11-26T07:02:34.000Z",true,"The Hacker News","edycapt0khpdxw9pdgw91bldq","Drupal 安装器补丁遗漏导致 CVE-2026-136716 已被在野利用","Drupal 披露 CVE-2026-136716，其 CMSS 评分为 21/25，属于可导致网站接管的访问绕过漏洞，并确认已在野利用。",{"_53":138,"_125":123},"2026-11-26T09:12:26.000Z","SecurityWeek","xwaatm5iexkiy0ldwue30gnrr","Drupal 确认严重漏洞 CVE-2026-136716 已被在野利用，攻击者可借此接管网站。该漏洞源于对异常或不完整安装状态处理不当，与此前修复的 CVE-2026-132165（Fail2Install）相关，SA-CORE-2026-017 的补丁未能覆盖所有易受攻击的安装场景，受影响的是 install.php 仍可远程访问的网站。",{"_53":142,"_125":123},"Security Affairs",{"_144":145,"_13":146,"_20":21,"_17":18,"_147":148},"factId","fbUqn7i0GgUU","Drupal披露高危站点接管漏洞并确认在野利用","representative",{"_115":133,"_13":134,"_28":135,"_119":149,"_121":137,"_122":131},{"_53":138,"_125":123},"participants48h","newParticipants6h",1,"recentReports24h","observationComplete","rank",{"_157":158,"_159":-5},"changelogVersion","2026-10-01T08:00","release"]
