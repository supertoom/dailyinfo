[{"_1":2,"_3":4},"root",{"_5":239},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795826460000,"publicId","df8b9daa-5e85-4d46-a5ad-7d5591635b6b","title","Drupal核心站点接管漏洞已被在野利用","status","active","reportCount",6,"sourceCount","firstReportAt","2026-11-26T00:00:00.000Z","latestAt","2026-11-27T10:10:15.000Z","digest","Drupal维护者确认，Drupal核心访问绕过漏洞CVE-2026-136716正被在野利用，攻击者可接管仍暴露安装器的网站；该漏洞源于对异常或不完整安装状态处理不当，CMSS评分为21/25。此前修复CVE-2026-132165（Fail2Install）的SA-CORE-2026-017未覆盖所有场景，安装器install.php仍可远程访问的网站可能已被入侵；已加固安装器的网站不受影响，且无法仅凭用户界面判断是否处于受影响状态。\n\n修复版本为Drupal 11.4.14、11.3.23和10.6.23；Drupal 11.0.x至11.2.x及10.5.x及以下版本已停止支持，不提供修复。受影响生产站点升级后还必须运行更新钩子，并运行update.php修复受影响安装状态、确保现有及新建网站的安装器受到保护；无法立即升级时，应通过Web服务器配置或Web根目录的.htaccess阻止访问/core/install.php。","digestUpdatedAt","2026-11-27T10:34:04.371Z","summary","excerpt","latest","Drupal 站点接管漏洞 CVE-2026-136716 已被在野利用","latestReport",{"_186":216},"whyHot",{"_232":106,"_233":234,"_235":236,"_237":202,"_238":109},"developments",[225],"officialReports",[],"timeline",[180,181,182,183,184,185],"heat",[62,63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101],"related",[],"topics",[48,49,50,51],{"_52":60,"_54":61},{"_52":58,"_54":59},{"_52":56,"_54":57},{"_52":53,"_54":55},"slug","attack","name","攻击活动","cisa","CISA","exploited","在野利用","vuln","漏洞披露",{"_102":177,"_42":178,"_105":179},{"_102":175,"_42":176,"_105":165},{"_102":174,"_42":153,"_105":165},{"_102":173,"_42":151,"_105":165},{"_102":172,"_42":149,"_105":165},{"_102":171,"_42":147,"_105":165},{"_102":170,"_42":145,"_105":165},{"_102":168,"_42":169,"_105":165},{"_102":167,"_42":141,"_105":165},{"_102":166,"_42":139,"_105":165},{"_102":164,"_42":137,"_105":165},{"_102":162,"_42":163,"_105":106},{"_102":160,"_42":161,"_105":106},{"_