[{"_1":2,"_3":4},"root",{"_5":258},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":-5,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48},"expiresAt",1795221647000,"publicId","25bfc85d-d33c-4d9e-8852-0430fda6b8b0","title","Armory Castle利用vCenter零日漏洞入侵","status","active","reportCount",10,"sourceCount",9,"firstReportAt","2026-11-19T19:21:06.000Z","latestAt","2026-11-20T21:03:27.000Z","digest","Mandiant与Google Threat Intelligence Group称，疑似中国关联组织Armory Castle（原UNC5221，又名Warp Panda）自2026年9月初起，利用VMware vCenter认证绕过漏洞CVE-2026-123890（CVSS 9.8）实施入侵并植入后门；其称已调查多起相关事件。Broadcom尚未确认该漏洞被利用，但已通过VMSA-2026-0009修复vCenter 9.1.1.0200、9.0.2.0200和8.0 U3m；vCenter 7.0暂无公开补丁，只有延长支持用户可联系厂商获取支持。\n\n该漏洞位于VMware Directory Service（vmdird），具备网络访问条件的远程未认证攻击者可绕过认证，取得administrator@vsphere.local管理员会话、执行命令并获取data.mdb等文件。Armory Castle使用定制工具Bonesaw窃取LMDB、提取SAML签名材料并创建SSO管理员账号；Bonesaw适用于vCenter 7.x和8.x。Broadcom未提供官方变通方案，补丁不能使用vCenter Quick Patch安装，建议通过网络限制和防火墙控制降低暴露面。","digestUpdatedAt","2026-11-20T22:01:42.146Z","summary","excerpt","latest","中国关联威胁组织“Armory Castle”利用 VMware vCenter 零日漏洞发动攻击","latestReport",{"_175":233},"whyHot",{"_253":102,"_254":162,"_255":134,"_256":184,"_257":162},"developments",[241,242],"officialReports",[237,238],"timeline",[165,166,167,168,169,170,171,172,173,174],"heat",[69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97],"related",[],"topics",[49,50,51,52,53,54],{"_55":67,"_57":68},{"_55":65,"_57":66},{"_55":63,"_57":64},{"_55":61,"_57":62},{"_55":59,"_57":60},{"_55":56,"_57":58},"slug","malware","name","恶意软件","identity","身份与访问","attack","攻击活动","vuln","漏洞披露","exploited","在野利用","vmware","VMware / Broadcom",{"_98":163,"_43":164,"_101":162},{"_98":160,"_43":161,"_101":162},{"_98":158,"_43":159,"_101":155},{"_98":156,"_43":157,"_101":155},{"_98":153,"_43":154,"_101":155},{"_98":151,"_43":152,"_101":148},{"_98":149,"