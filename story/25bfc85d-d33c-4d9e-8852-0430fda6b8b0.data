[{"_1":2,"_3":4},"root",{"_5":338},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":-5,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48},"expiresAt",1795308047000,"publicId","25bfc85d-d33c-4d9e-8852-0430fda6b8b0","title","Armory Castle利用vCenter零日漏洞入侵","status","watching","reportCount",11,"sourceCount",10,"firstReportAt","2026-11-19T19:21:06.000Z","latestAt","2026-11-20T21:03:27.000Z","digest","Mandiant与Google Threat Intelligence Group称，疑似中国关联组织Armory Castle（原UNC5221，又名Warp Panda）自2026年9月初起，利用VMware vCenter认证绕过漏洞CVE-2026-123890（CVSS 9.8）实施入侵并植入后门；其称已调查多起相关事件。Broadcom尚未确认该漏洞被利用，但已通过VMSA-2026-0009修复vCenter 9.1.1.0200、9.0.2.0200和8.0 U3m；vCenter 7.0暂无公开补丁，只有延长支持用户可联系厂商获取支持。\n\n该漏洞位于VMware Directory Service（vmdird），具备网络访问条件的远程未认证攻击者可绕过认证，取得administrator@vsphere.local管理员会话、执行命令并获取data.mdb等文件。Armory Castle使用定制工具Bonesaw窃取LMDB、提取SAML签名材料并创建SSO管理员账号；Bonesaw适用于vCenter 7.x和8.x。Broadcom未提供官方变通方案，补丁不能使用vCenter Quick Patch安装，建议通过网络限制和防火墙控制降低暴露面。","digestUpdatedAt","2026-11-20T22:01:42.146Z","summary","excerpt","latest","中国关联威胁组织“Armory Castle”利用 VMware vCenter 零日漏洞发动攻击","latestReport",{"_248":306},"whyHot",{"_332":206,"_333":334,"_335":334,"_336":257,"_337":227},"developments",[320,321],"officialReports",[316,317],"timeline",[237,238,239,240,241,242,243,244,245,246,247],"heat",[69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121],"related",[],"topics",[49,50,51,52,53,54],{"_55":67,"_57":68},{"_55":65,"_57":66},{"_55":63,"_57":64},{"_55":61,"_57":62},{"_55":59,"_57":60},{"_55":56,"_57":58},"slug","malware","name","恶意软件","identity","身份与访问","attack","攻击活动","vuln","漏洞披露","exploited","在野利用","vmware","VMware / Broadcom",{"_122":235,"_43":236,"_125":234},{"_122":232,"_43":233,"_125":234},{"_122":230,"_43":231,"_125":227},{"_122"