[{"_1":2,"_3":4},"root",{"_5":127},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795135249000,"publicId","25bfc85d-d33c-4d9e-8852-0430fda6b8b0","title","Armory Castle利用vCenter零日漏洞植入后门","status","active","reportCount",3,"sourceCount","firstReportAt","2026-11-19T19:21:06.000Z","latestAt","2026-11-20T00:26:25.000Z","digest","Mandiant/Google Threat Intelligence 称，疑似中国国家支持组织 Armory Castle（原 UNC5221，又名 Warp Panda）自2026年9月起在野利用 VMware vCenter 认证绕过漏洞 CVE-2026-123890（CVSS 9.8），攻击者只需网络访问受影响部署，无需凭据即可绕过认证并以 Administrator 用户权限取得未授权访问。该漏洞位于 VMware Directory Service。\n\n攻击者使用定制工具 Bonesaw 窃取 Lightning Memory-Mapped Database（LMDB）、提取 SAML 签名材料并创建单点登录（SSO）管理员账号，该工具适用于 vCenter 7.x 和 8.x。Bonesaw 属于后手植入手段，已被 Mandiant 记录到攻击活动；Broadcom 尚未确认该漏洞被利用。\n\nBroadcom 已于11月19日通过 VMSA-2026-0009 发布修复版本 vCenter 9.1.1.0200、9.0.2.0200 和 8.0 U3m，同时修复 VMware SDDC Manager 与 VMware Tools for Windows 的另外四个漏洞；补丁无法通过 vCenter Quick Patch 安装，Broadcom 列为无官方变通方案，仅建议以网络限制和防火墙控制降低暴露面。已于2025年10月结束常规支持的 vCenter 7.0 目前尚无公开补丁；正在升级中的客户需查阅厂商 FAQ 与互操作矩阵。","digestUpdatedAt","2026-11-20T00:34:57.039Z","summary","excerpt","latest","VMware vCenter 零日漏洞 CVE-2026-123890 已被利用，Armory Castle 入侵虚拟化环境","latestReport",{"_90":108},"whyHot",{"_121":18,"_122":18,"_123":18,"_124":98,"_125":126},"developments",[114],"officialReports",[112],"timeline",[87,88,89],"heat",[68,69,70,71,72],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","attack","name","攻击活动","identity","身份与访问","supply-chain","供应链安全","vuln","漏洞披露","exploited","在野利用","vmware","VMware / Broadcom",{"_73":85,"_42":86,"_76":84},{"_73":82,"_42":83,"_76":84},{"_73":80,"_42":81,"_76":77},{"_73":78,"_42":79,"_76":77},{"_73":74,"_42":75,"_76":77},"hour","2026-11-20T00:00:00.000Z",17.9,"participants",2,"2026-11-19T23:00:00.000Z",18.5,"2026-11-19T22:00:00.000Z",19,"2026-11-19T21:00:00.000Z",9.5,1,"2026-11-19T20:00:00.000Z",9.8,{"_90":108,"_13":31,"_28":109,"_94":110,"_96":23,"_97":98},{"_90":102,"_13":103,"_28":104,"_94":105,"_96":106,"_97":98},{"_90":91,"_13":92,"_28":93,"_94":95,"_96":21,"_97":98},"id","pgv3tl000yu3x739ofgaqd6pg","VMware vCenter 零日漏洞 CVE-2026-123890 被中国关联组织 Armory Castle 利用","Mandiant 报告称，疑似中国背景间谍组织 Armory Castle（原 UNC5221，又名 Warp Panda）在两个多月里利用 VMware vCenter 零日漏洞 CVE-2026-123890（CVSS 9.8）实施入侵，漏洞位于 VMware Directory Service，可让远程未认证攻击者获得带管理员权限的已认证会话。","source",{"_56":99,"_100":101},"publishedAt","selected",true,"SecurityWeek","firstParty",false,"hd19yw6n9on2wachygxhu93xs","VMware vCenter 认证绕过漏洞 CVE-2026-123890 已被 ARMORY CASTLE 利用","VMware vCenter 的认证绕过漏洞 CVE-2026-123890 已被中国关联威胁组织 ARMORY CASTLE 在野利用，最早可追溯至 2026 年 9 月。",{"_56":107,"_100":98},"2026-11-19T21:06:24.000Z","Rapid7 CVE 公告","he08061xy4cyd54gsriazxv74","Mandiant 与 Google Threat Intelligence Group 记录到疑似中国国家支持组织 Armory Castle 自 2026 年 9 月起利用 VMware vCenter 零日漏洞 CVE-2026-123890 实施攻击。",{"_56":111,"_100":101},"BleepingComputer",{"_90":102,"_13":103,"_28":104,"_94":113,"_96":106,"_97":98},{"_56":107,"_100":98},{"_115":116,"_13":117,"_20":21,"_17":18,"_118":119},"factId","fJ4dDx5j8puY","中国关联组织利用vCenter零日漏洞","representative",{"_90":102,"_13":103,"_28":104,"_94":120,"_96":106,"_97":98},{"_56":107,"_100":98},"participants48h","newParticipants6h","recentReports24h","observationComplete","rank",4,{"_128":129,"_130":-5},"changelogVersion","2026-10-01T08:00","release"]
