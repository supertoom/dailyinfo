214,"_181":215,"_183":184},{"_175":205,"_13":206,"_29":207,"_179":208,"_181":209,"_183":184},{"_175":199,"_13":200,"_29":201,"_179":202,"_181":203,"_183":184},{"_175":193,"_13":194,"_29":195,"_179":196,"_181":197,"_183":184},{"_175":188,"_13":189,"_29":190,"_179":191,"_181":22,"_183":184},{"_175":176,"_13":177,"_29":178,"_179":180,"_181":182,"_183":184},"id","oy8aa1yf0lb6hllwj6lpg2yh4","VMware vCenter 认证绕过漏洞 CVE-2026-123890，CVSS 9.8","Broadcom 披露 VMware vCenter 认证绕过漏洞 CVE-2026-123890，攻击者仅需网络访问即可绕过认证并获得未授权访问，CVSS 评分 9.8。","source",{"_57":185,"_186":187},"publishedAt","2026-11-19T15:11:06.000Z","selected",true,"The Hacker News","firstParty",false,"pgv3tl000yu3x739ofgaqd6pg","VMware vCenter 零日漏洞 CVE-2026-123890 被中国关联组织 Armory Castle 利用","Mandiant 报告称，疑似中国背景间谍组织 Armory Castle（原 UNC5221，又名 Warp Panda）在两个多月里利用 VMware vCenter 零日漏洞 CVE-2026-123890（CVSS 9.8）实施入侵，漏洞位于 VMware Directory Service，可让远程未认证攻击者获得带管理员权限的已认证会话。",{"_57":192,"_186":187},"SecurityWeek","hd19yw6n9on2wachygxhu93xs","VMware vCenter 认证绕过漏洞 CVE-2026-123890 已被 ARMORY CASTLE 利用","VMware vCenter 的认证绕过漏洞 CVE-2026-123890 已被中国关联威胁组织 ARMORY CASTLE 在野利用，最早可追溯至 2026 年 9 月。",{"_57":198,"_186":184},"2026-11-19T21:06:24.000Z","Rapid7 CVE 公告","he08061xy4cyd54gsriazxv74","VMware vCenter 零日漏洞 CVE-2026-123890 已被利用，Armory Castle 入侵虚拟化环境","Mandiant 与 Google Threat Intelligence Group 记录到疑似中国国家支持组织 Armory Castle 自 2026 年 9 月起利用 VMware vCenter 零日漏洞 CVE-2026-123890 实施攻击。",{"_57":204,"_186":187},"2026-11-20T00:26:25.000Z","BleepingComputer","yymha8933eqlh3s15r2vdobq8","VMware vCenter 目录服务身份认证绕过漏洞 CVE-2026-123890 已发现在野利用","奇安信CERT监测到VMware vCenter目录服务身份认证绕过漏洞CVE-2026-123890已在野利用，该高危漏洞CVSS 3.1分数为9.8。",{"_57":210,"_186":187},"2026-11-20T03:24:36.028Z","安全内参","td8eowozhobu7dfj5a7rxb1b0","Armory Castle 利用 VMware vCenter 漏洞 CVE-2026-123890 获取管理员权限并窃取数据","疑似与中国有关的 Armory Castle 已在真实攻击中利用 VMware vCenter Server 漏洞 CVE-2026-123890（CVSS 9.8）绕过认证并取得 administrator@vsphere.local 会话。",{"_57":185,"_186":187},"2026-11-20T06:33:31.000Z","sgciwtig86m8ho71b0h3a56f6","VMware vCenter 认证绕过漏洞 CVE-2026-123890 通告，官方已发布修复","深瞳漏洞实验室于2026年11月20日发布漏洞通告，VMware vCenter 存在认证绕过漏洞 CVE-2026-123890，威胁等级为高危。",{"_57":221,"_186":184},"2026-11-20T09:49:00.000Z","深信服千里目安全实验室","sjin4pr8q1dp00z0igue1371g","CISA将4个漏洞纳入KEV Catalog，均有真实利用证据","CISA将CVE-2025-42884、CVE-2026-76466、CVE-2026-123890和CVE-2026-129448纳入KEV Catalog，依据是这些漏洞已有在野利用证据，分别涉及SAP NetWeaver、Cisco Expressway Series、VMWare vCenter和Apache Roller。",{"_57":226,"_186":184},"CISA 安全公告","gn6u0swh6z2awsabjzvs7pk18","Armory Castle 利用 VMware vCenter 漏洞 CVE-2026-123890 入侵","Google Threat Intelligence Group 披露，疑似中国关联间谍组织 Armory Castle 自至少 9 月初起利用 VMware vCenter 零日漏洞 CVE-2026-123890，该漏洞 CVSS 为 9.8，可让远程未认证攻击者取得 vCenter Server 管理员会话。",{"_57":232,"_186":187},"2026-11-20T12:30:19.000Z","Help Net Security","kma7fzomzyeif4ewssllao500","中国关联威胁组织“Armory Castle”可能在 VMware vCenter 最近一轮重大安全更新前已准备好下一项零日漏洞，并已对 VMware vCenter 发起攻击。原内容仅指出其可能提前掌握并利用该零日漏洞，未披露 CVE 编号、CVSS 分数、受影响版本、认证要求、补丁状态或具体受害范围。",{"_57":236,"_186":187},"Dark Reading",{"_175":216,"_13":217,"_29":218,"_179":240,"_181":220,"_183":184},{"_175":193,"_13":194,"_29":195,"_179":239,"_181":197,"_183":184},{"_57":198,"_186":184},{"_57":221,"_186":184},{"_243":249,"_13":250,"_21":220,"_17":162,"_246":251},{"_243":244,"_13":245,"_21":22,"_17":109,"_246":247},"factId","fJ4dDx5j8puY","中国关联组织利用vCenter零日漏洞","representative",{"_175":193,"_13":194,"_29":195,"_179":248,"_181":197,"_183":184},{"_57":198,"_186":184},"fQbijqWxl_Dk","发布vCenter认证绕过漏洞通告",{"_175":216,"_13":217,"_29":218,"_179":252,"_181":220,"_183":184},{"_57":221,"_186":184},"participants48h","newParticipants6h","recentReports24h","observationComplete","rank",{"_259":260,"_261":-5},"changelogVersion","2026-10-01T08:00","release"]
