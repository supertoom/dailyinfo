[{"_1":2,"_3":4},"root",{"_5":260},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795653657000,"publicId","f26bad15-2100-46af-b49b-9f8342651d0c","title","vCenter认证绕过漏洞已复现并发布补丁","status","active","reportCount",7,"sourceCount","firstReportAt","2026-11-24T10:12:00.000Z","latestAt","2026-11-25T12:19:20.000Z","digest","Broadcom 已通过 VMSA-2026-0011 修复 VMware vCenter Server 认证绕过漏洞 CVE-2026-123903（CVSS v3.1 9.8，Critical）；Rapid7 验证公开 PoC 可成功绕过认证，长亭安全应急响应中心和微步在线研究响应中心也已独立复现。截至相关公告发布时，尚无该漏洞在野利用的公开报告，受害规模未确认。\n\n攻击者只需通过网络访问受影响实例的 VMware Directory Service（vmdir）389 端口，无需任何凭据。长亭称，漏洞仅影响 SASL 认证路径，未认证攻击者在一次 SASL SRP 认证失败后即可残留管理员身份、获得管理员会话并创建管理员账号接管 vCenter；simple bind 失败会清理状态。\n\n受影响版本为 vCenter Server 9.1.x.x<=version<9.1.2、9.0.x.x<=version<9.0.2.0300、8.0<=version<8.0U3m 及 7.x，修复版本为 9.1.2、9.0.2.0300、8.0 U3m，VMware Cloud Foundation 5.x 升级至 5.2.5。Broadcom 未提供临时变通方案，更新不适用于 Quick Patch；已为修复 CVE-2026-123890 安装 vCenter 8.0 U3m 的实例无需再更新。","digestUpdatedAt","2026-11-25T17:21:00.325Z","summary","excerpt","latest","Broadcom 披露 VMware vCenter 认证绕过漏洞 CVE-2026-123903，CVSS v3.1 9.8","latestReport",{"_183":225},"whyHot",{"_254":102,"_255":256,"_257":127,"_258":191,"_259":102},"developments",[237,238,239],"officialReports",[229,230,231,232],"timeline",[176,177,178,179,180,181,182],"heat",[62,63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97],"related",[],"topics",[48,49,50,51],{"_52":60,"_54":61},{"_52":58,"_54":59},{"_52":56,"_54":57},{"_52":53,"_54":55},"slug","vuln-mgmt","name","漏洞管理","identity","身份与访问","vuln","漏洞披露","vmware","VMware / Broadcom",{"_98":174,"_42":175,"_101":143},{"_98":172,"_42":173,"_101":143},{"_98":170,"_42":171,"_101":143},{"_98":168,"_42":169,"_101":143},{"_98":166,"_42":167,"_101":143},{"_98":164,"_42":165,"_101":143},{