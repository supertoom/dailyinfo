[{"_1":2,"_3":4},"root",{"_5":146},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794789636000,"publicId","4b2697c9-e311-4e85-a2db-005e21e0d0d4","title","意大利重罚Meta默认读取图库","status","active","reportCount",3,"sourceCount","firstReportAt","2026-11-14T19:00:00.000Z","latestAt","2026-11-15T18:11:56.000Z","digest","意大利数据保护局 Garante 已对 Meta Platforms Ireland Limited 罚款8.05亿欧元并要求整改。监管机构认定，Facebook for Android 的图库建议功能默认启用，在未取得具体同意、未充分告知的情况下读取意大利用户的照片、视频及相关元数据，影响约2000万名 Android 用户；尚未更新应用的用户仍受影响。\n\nMeta 须在60天内关闭该功能默认开启状态，包括对已授权图库访问的用户，并通过单独、具体的请求取得同意，同时说明功能用途、图库访问行为及关闭方法。若错过期限，该功能不得对未提供有效同意的用户启用。Meta 已对意大利监管机构的管辖权提出异议。","digestUpdatedAt","2026-11-15T22:42:04.189Z","summary","excerpt","latest","意大利 Garante 因 Facebook 相册默认访问功能对 Meta 罚款 €805 million","latestReport",{"_110":128},"whyHot",{"_139":18,"_140":141,"_142":94,"_143":126,"_144":145},"developments",[132],"officialReports",[],"timeline",[107,108,109],"heat",[65,66,67,68,69,70,71,72,73,74,75,76,77],"related",[],"topics",[48,49,50,51,52],{"_53":63,"_55":64},{"_53":61,"_55":62},{"_53":59,"_55":60},{"_53":57,"_55":58},{"_53":54,"_55":56},"slug","identity","name","身份与访问","google","Google / 谷歌","policy","政策法规","compliance","合规与标准","mobile","移动端",{"_78":105,"_42":106,"_81":94},{"_78":103,"_42":104,"_81":94},{"_78":101,"_42":102,"_81":94},{"_78":99,"_42":100,"_81":94},{"_78":97,"_42":98,"_81":94},{"_78":95,"_42":96,"_81":94},{"_78":92,"_42":93,"_81":94},{"_78":90,"_42":91,"_81":18},{"_78":88,"_42":89,"_81":18},{"_78":86,"_42":87,"_81":18},{"_78":84,"_42":85,"_81":18},{"_78":82,"_42":83,"_81":18},{"_78":79,"_42":80,"_81":18},"hour","2026-11-16T00:00:00.000Z",19.7,"participants","2026-11-15T23:00:00.000Z",20.3,"2026-11-15T22:00:00.000Z",20.9,"2026-11-15T21:00:00.000Z",21.5,"2026-11-15T20:00:00.000Z",22.2,"2026-11-15T19:00:00.000Z",22.8,"2026-11-15T18:00:00.000Z",13.4,2,"2026-11-15T17:00:00.000Z",13.8,"2026-11-15T16:00:00.000Z",14.2,"2026-11-15T15:00:00.000Z",14.6,"2026-11-15T14:00:00.000Z",15.1,"2026-11-15T13:00:00.000Z",15.5,"2026-11-15T12:00:00.000Z",16,{"_110":128,"_13":31,"_28":129,"_114":130,"_116":23,"_117":118},{"_110":121,"_13":122,"_28":123,"_114":124,"_116":125,"_117":126},{"_110":111,"_13":112,"_28":113,"_114":115,"_116":21,"_117":118},"id","a0gqbavi16izrdxda7hdjobus","意大利数据保护局对 Meta 处 8.05 亿欧元罚款，指 Facebook 未经同意读取 Android 图库","意大利数据保护局宣布对 Meta 处 805 million 欧元（887 million 美元）罚款，原因是 Facebook 的 Get suggestions from gallery when browsing Facebook 功能在未获具体同意、未作充分告知的情况下使用 Android 用户图库中的照片和视频。","source",{"_55":119,"_120":118},"publishedAt","selected",false,"SecurityWeek","firstParty","syiens59ccuc9lmtn233vr8gd","意大利因 Facebook Android 图库访问默认开启问题罚款 Meta €805 million","意大利数据保护机构 Garante 对 Meta 罚款 €805 million，原因是 Facebook for Android 默认开启照片和视频图库建议功能，未经用户明确同意访问意大利用户图库及相关元数据。",{"_55":127,"_120":118},"2026-11-15T11:27:31.000Z",true,"The Hacker News","jx8qldq434280gul46prza1bc","意大利数据保护机构 Garante 因 Facebook for Android 在未取得明确同意且未充分告知的情况下访问用户照片、视频及元数据，对 Meta Platforms Ireland Limited 罚款 €805 million，涉及约 2000 万名 Android 用户。",{"_55":131,"_120":118},"Security Affairs",{"_133":134,"_13":135,"_20":21,"_17":18,"_136":137},"factId","fULr7km2phv4","意大利处罚 Meta 未经明确同意收集图库内容","representative",{"_110":121,"_13":122,"_28":123,"_114":138,"_116":125,"_117":126},{"_55":127,"_120":118},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",1,{"_147":148,"_149":-5},"changelogVersion","2026-10-01T08:00","release"]
