[{"_1":2,"_3":4},"root",{"_5":218},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794876039000,"publicId","4b2697c9-e311-4e85-a2db-005e21e0d0d4","title","意大利重罚Meta默认读取图库","status","watching","reportCount",3,"sourceCount","firstReportAt","2026-11-14T19:00:00.000Z","latestAt","2026-11-15T18:11:56.000Z","digest","意大利数据保护局 Garante 已对 Meta Platforms Ireland Limited 罚款8.05亿欧元并要求整改。监管机构认定，Facebook for Android 的图库建议功能默认启用，在未取得具体同意、未充分告知的情况下读取意大利用户的照片、视频及相关元数据，影响约2000万名 Android 用户；尚未更新应用的用户仍受影响。\n\nMeta 须在60天内关闭该功能默认开启状态，包括对已授权图库访问的用户，并通过单独、具体的请求取得同意，同时说明功能用途、图库访问行为及关闭方法。若错过期限，该功能不得对未提供有效同意的用户启用。Meta 已对意大利监管机构的管辖权提出异议。","digestUpdatedAt","2026-11-15T22:42:04.189Z","summary","excerpt","latest","意大利 Garante 因 Facebook 相册默认访问功能对 Meta 罚款 €805 million","latestReport",{"_182":200},"whyHot",{"_211":106,"_212":213,"_214":213,"_215":198,"_216":217},"developments",[204],"officialReports",[],"timeline",[179,180,181],"heat",[65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101],"related",[],"topics",[48,49,50,51,52],{"_53":63,"_55":64},{"_53":61,"_55":62},{"_53":59,"_55":60},{"_53":57,"_55":58},{"_53":54,"_55":56},"slug","identity","name","身份与访问","google","Google / 谷歌","policy","政策法规","compliance","合规与标准","mobile","移动端",{"_102":177,"_42":178,"_105":106},{"_102":175,"_42":176,"_105":106},{"_102":173,"_42":174,"_105":106},{"_102":171,"_42":172,"_105":106},{"_102":169,"_42":170,"_105":106},{"_102":167,"_42":168,"_105":106},{"_102":165,"_42":166,"_105":106},{"_102":163,"_42":164,"_105":18},{"_102":161,"_42":162,"_105":18},{"_102":159,"_42":160,"_105":18},{"_102":157,"_42":158,"_105":18},{"_102":155,"_42":156,"_105":18},{"_102":153,"_42":154,"_105":18},{"_102":151,"_42":152,"_105":18},{"_102":149,"_42":150,"_105":18},{"_102":147,"_4