[{"_1":2,"_3":4},"root",{"_5":186},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794962454000,"publicId","caeb8d6f-1cd3-4db4-b8ed-a5f3f3c16c9a","title","攻击者借Microsoft 365故障实施钓鱼","status","active","reportCount",4,"sourceCount","firstReportAt","2026-11-17T00:08:41.000Z","latestAt","2026-11-17T13:00:00.000Z","digest","Microsoft Threat Intelligence披露，攻击者仿冒Microsoft 365服务中断通知，向全球多个行业组织投递大批量链接式钓鱼邮件，诱导用户点击“RESTORE MESSAGES”并访问非Microsoft站点。微软称活动很可能是凭据钓鱼，但现有证据未确认凭据被窃取、恶意软件投递、账户失陷或后续攻击，也未发现失陷指标。\n\n已分析样本均为链接型，未发现二维码、非EML附件或可执行文件、压缩包、文档等恶意载荷；受Microsoft Defender for Office保护的环境目前会拦截或隔离这些邮件。微软尚未将该活动归因于具名威胁组织或恶意软件家族。","digestUpdatedAt","2026-11-17T13:17:13.288Z","summary","excerpt","latest","Microsoft 365 全球中断期间出现高量级协同钓鱼活动","latestReport",{"_144":167},"whyHot",{"_179":18,"_180":181,"_182":118,"_183":170,"_184":185},"developments",[172],"officialReports",[],"timeline",[140,141,142,143],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","ransomware","name","勒索软件","cloud-native","云与原生","attack","攻击活动","email","邮件与钓鱼","identity","身份与访问","microsoft","Microsoft / 微软",{"_91":138,"_42":139,"_94":125},{"_91":136,"_42":137,"_94":125},{"_91":134,"_42":135,"_94":125},{"_91":132,"_42":133,"_94":125},{"_91":130,"_42":131,"_94":125},{"_91":128,"_42":129,"_94":125},{"_91":126,"_42":127,"_94":125},{"_91":123,"_42":124,"_94":125},{"_91":121,"_42":122,"_94":118},{"_91":119,"_42":120,"_94":118},{"_91":116,"_42":117,"_94":118},{"_91":23,"_42":115,"_94":18},{"_91":113,"_42":114,"_94":18},{"_91":111,"_42":112,"_94":18},{"_91":109,"_42":110,"_94":18},{"_91":107,"_42":108,"_94":18},{"_91":105,"_42":106,"_94":18},{"_91":103,"_42":104,"_94":18},{"_91":101,"_42":102,"_94":18},{"_91":99,"_42":100,"_94":18},{"_91":97,"_42":98,"_94":18},{"_91":95,"_42":96,"_94":18},{"_91":92,"_42":93,"_94":18},"hour","2026-11-18T00:00:00.000Z",25.5,"participants","2026-11-17T23:00:00.000Z",26.3,"2026-11-17T22:00:00.000Z",27,"2026-11-17T21:00:00.000Z",27.8,"2026-11-17T20:00:00.000Z",28.6,"2026-11-17T19:00:00.000Z",29.5,"2026-11-17T18:00:00.000Z",30.3,"2026-11-17T17:00:00.000Z",31.2,"2026-11-17T16:00:00.000Z",32.1,"2026-11-17T15:00:00.000Z",33.1,"2026-11-17T14:00:00.000Z",34,35,"2026-11-17T12:00:00.000Z",25.8,3,"2026-11-17T11:00:00.000Z",26.5,"2026-11-17T10:00:00.000Z",27.3,"2026-11-17T09:00:00.000Z",7.7,1,"2026-11-17T08:00:00.000Z",8,"2026-11-17T07:00:00.000Z",8.2,"2026-11-17T06:00:00.000Z",8.4,"2026-11-17T05:00:00.000Z",8.7,"2026-11-17T04:00:00.000Z",8.9,"2026-11-17T03:00:00.000Z",9.2,"2026-11-17T02:00:00.000Z",9.5,{"_144":167,"_13":31,"_28":168,"_148":169,"_150":23,"_151":170},{"_144":161,"_13":162,"_28":163,"_148":164,"_150":165,"_151":152},{"_144":155,"_13":156,"_28":157,"_148":158,"_150":159,"_151":152},{"_144":145,"_13":146,"_28":147,"_148":149,"_150":21,"_151":152},"id","s973vl0vfj6vufe9ha7blyrct","Microsoft 365 服务中断诱饵钓鱼活动瞄准全球多个行业","Microsoft Threat Intelligence 于 2026 年 11 月 13 日发现一场协调的高流量钓鱼活动，攻击者仿冒 Microsoft 365 服务状态通知，以邮件将在 24 小时内被删除为由诱导用户点击恶意链接，目标覆盖全球多个行业。","source",{"_56":153,"_154":152},"publishedAt","selected",false,"Microsoft Security Blog","firstParty","kw9jpmvx0eb2y724xw474f7ea","攻击者借 Microsoft 365 服务中断发起凭据钓鱼活动","攻击者借 Microsoft 365 于 2026 年 11 月 12 日发生的服务中断，向全球多个行业组织投递协同、大批量链接式钓鱼邮件，诱导收件人点击“RESTORE MESSAGES”等按钮并访问非 Microsoft 站点。",{"_56":160,"_154":152},"2026-11-17T09:34:00.000Z","奇安信威胁情报中心","p8wi299wyky6htgioi4tv1rra","Microsoft 365 故障被利用为新型凭据窃取攻击诱饵","Microsoft 365 全球服务中断被攻击者用作诱饵，发起新的凭据窃取活动。原文仅指出这波攻击活动，未披露受影响账户范围、利用前提、具体产品版本或修复状态。",{"_56":166,"_154":152},"2026-11-17T09:42:14.000Z","Cybernews","vk1sqw9r2vpu5keky20h61mo3","Microsoft 确认全球出现一场利用 Microsoft 365 服务中断实施的高量级协同钓鱼活动，邮件冒充服务健康通知，诱导用户点击恶意链接并提交凭据。服务中断于 November 12 11.20 EST 开始，持续超过 22 小时，November 13 23.15 EST 全面恢复。",{"_56":171,"_154":152},true,"Infosecurity Magazine",{"_173":174,"_13":175,"_20":21,"_17":18,"_176":177},"factId","fIfHntm2d4RM","微软披露微软365故障-themed钓鱼活动","representative",{"_144":167,"_13":31,"_28":168,"_148":178,"_150":23,"_151":170},{"_56":171,"_154":152},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",2,{"_187":188,"_189":-5},"changelogVersion","2026-10-01T08:00","release"]
