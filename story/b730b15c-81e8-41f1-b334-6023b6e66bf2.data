[{"_1":2,"_3":4},"root",{"_5":167},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794357648000,"publicId","b730b15c-81e8-41f1-b334-6023b6e66bf2","title","Turla用Cereal窃取Exchange邮件","status","active","reportCount",5,"sourceCount","firstReportAt","2026-11-10T10:00:39.000Z","latestAt","2026-11-10T20:40:48.000Z","digest","ESET高置信度认定，俄罗斯关联组织Turla已确认入侵哈萨克斯坦和罗马尼亚各一家政府机构的Microsoft Exchange服务器，部署模块化.NET工具集Cereal实施长期网络间谍活动并复制邮件。初始入侵方式及操作者使用的入口IP地址尚无法确定。\n\nCerealBox注入EdgeTransport.exe并劫持现有传输代理处理器，可在内存中执行命令、检查邮件，而无需注册新代理或中断正常投递。ESET未发现外部C2基础设施，遭入侵的Exchange服务器本身是唯一控制点；罗马尼亚实例专门收集发往或来自NATO及欧盟地址的邮件。仅检查传输代理列表无异常并不能证明邮件系统未被攻陷。","digestUpdatedAt","2026-11-10T21:58:02.506Z","summary","excerpt","latest","Russia 关联 APT Turla 以 Cereal 工具集入侵哈萨克斯坦和罗马尼亚 Exchange 服务器","latestReport",{"_119":149},"whyHot",{"_160":18,"_161":162,"_163":18,"_164":127,"_165":166},"developments",[153],"officialReports",[],"timeline",[114,115,116,117,118],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","email","name","邮件与钓鱼","microsoft","Microsoft / 微软","black-market","数据窃取与黑产","ransomware","勒索软件","malware","恶意软件","attack","攻击活动",{"_82":112,"_42":113,"_85":107},{"_82":110,"_42":111,"_85":107},{"_82":108,"_42":109,"_85":107},{"_82":105,"_42":106,"_85":107},{"_82":103,"_42":104,"_85":94},{"_82":101,"_42":102,"_85":94},{"_82":99,"_42":100,"_85":94},{"_82":97,"_42":98,"_85":94},{"_82":95,"_42":96,"_85":94},{"_82":92,"_42":93,"_85":94},{"_82":90,"_42":91,"_85":18},{"_82":88,"_42":89,"_85":18},{"_82":86,"_42":87,"_85":18},{"_82":83,"_42":84,"_85":18},"hour","2026-11-11T00:00:00.000Z",36.7,"participants","2026-11-10T23:00:00.000Z",37.8,"2026-11-10T22:00:00.000Z",38.9,"2026-11-10T21:00:00.000Z",40.1,"2026-11-10T20:00:00.000Z",31.1,4,"2026-11-10T19:00:00.000Z",32,"2026-11-10T18:00:00.000Z",32.9,"2026-11-10T17:00:00.000Z",33.9,"2026-11-10T16:00:00.000Z",34.9,"2026-11-10T15:00:00.000Z",35.9,"2026-11-10T14:00:00.000Z",26.8,3,"2026-11-10T13:00:00.000Z",27.6,"2026-11-10T12:00:00.000Z",28.4,"2026-11-10T11:00:00.000Z",29.2,{"_119":149,"_13":31,"_28":150,"_123":151,"_125":23,"_126":127},{"_119":143,"_13":144,"_28":145,"_123":146,"_125":147,"_126":130},{"_119":137,"_13":138,"_28":139,"_123":140,"_125":141,"_126":127},{"_119":131,"_13":132,"_28":133,"_123":134,"_125":135,"_126":127},{"_119":120,"_13":121,"_28":122,"_123":124,"_125":21,"_126":127},"id","sif366thhfeqdn24sve2qcy60","Turla 利用 Microsoft Exchange 服务器部署 Cereal 后门窃取邮件","ESET 发现俄罗斯关联组织 Turla 在哈萨克斯坦和罗马尼亚的 2 个政府机构 Microsoft Exchange 服务器上部署模块化 .NET 工具集 Cereal，通过伪装成 Outlook Web Access、Autodiscover 和 ActiveSync 流量的请求接收命令，并筛选发件人、收件人、主题或附件名称后复制邮件。","source",{"_56":128,"_129":130},"publishedAt","selected",true,"Help Net Security","firstParty",false,"nd5nr46db3d0kie9bnwuldvgj","Turla 利用 Cereal 恶意软件窃取政府机构 Exchange 邮件","俄罗斯国家支持的 Turla 攻击组织使用 Cereal 工具集，在 Kazakhstan 和 Romania 的政府机构 Microsoft Exchange 服务器上实施长期隐蔽监控。",{"_56":136,"_129":130},"2026-11-10T10:04:32.000Z","BleepingComputer","bp8xwrwy5t7lpiexk2dx8iayr","Turla 使用 Cereal 恶意软件窃取 Microsoft Exchange 邮件","Russia 关联的 Turla 使用新披露的 Cereal 工具集入侵 Microsoft Exchange 服务器，长期秘密收集邮件。ESET 于 late 2025 在 Kazakhstan 与 Romania 的两个政府实体发现该活动，初始访问途径未知，但 Turla 已知会采用鱼叉式钓鱼、水坑和 ISP 级 AitM 攻击。",{"_56":142,"_129":130},"2026-11-10T10:07:29.000Z","The Hacker News","qdom8rrkrzbwhjedidjob98yi","Russia-linked Turla 利用 Microsoft Exchange 服务器部署 Cereal 窃取 NATO 和欧盟邮件","ESET 高置信度认定 Russia-linked 组织 Turla 在遭攻陷的政府 Microsoft Exchange 服务器上部署 Cereal，用于长期网络间谍活动。",{"_56":148,"_129":130},"2026-11-10T14:30:00.000Z","Infosecurity Magazine","vdi8z9m8n0eq36t3nuw34nxc0","ESET 发现 Russia 关联 APT 组织 Turla 使用新工具集 Cereal 入侵哈萨克斯坦和罗马尼亚政府机构的 Microsoft Exchange 服务器，并将其用于长期网络间谍活动。",{"_