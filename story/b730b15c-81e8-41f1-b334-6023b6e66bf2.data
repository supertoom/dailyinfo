[{"_1":2,"_3":4},"root",{"_5":252},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794444103000,"publicId","b730b15c-81e8-41f1-b334-6023b6e66bf2","title","Turla用Cereal入侵Exchange窃取邮件","status","active","reportCount",7,"sourceCount","firstReportAt","2026-11-10T09:57:00.000Z","latestAt","2026-11-11T13:09:03.000Z","digest","ESET高置信度认定，俄罗斯关联组织Turla使用此前未披露的模块化.NET工具集Cereal，入侵哈萨克斯坦和罗马尼亚各一家政府机构的Microsoft Exchange服务器，用于长期网络间谍活动并复制邮件；目前已确认两个受害实例，但初始入侵方式及操作者使用的入口IP地址尚无法确定。\n\nCerealBox注入EdgeTransport.exe并劫持现有传输代理处理器，可在内存中执行命令、检查邮件，无需注册新代理或中断正常投递。ESET未发现外部C2基础设施，遭入侵的Exchange服务器成为唯一控制点；罗马尼亚实例的邮件收集模块专门筛选发往或来自NATO及欧盟地址的邮件。仅检查传输代理列表无异常，不能证明邮件系统未被攻陷。","digestUpdatedAt","2026-11-11T13:37:17.733Z","summary","excerpt","latest","俄罗斯黑客攻陷 Microsoft Exchange 窃取 NATO 和欧盟邮件","latestReport",{"_187":229},"whyHot",{"_246":18,"_247":248,"_249":243,"_250":195,"_251":243},"developments",[233,234],"officialReports",[],"timeline",[180,181,182,183,184,185,186],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","email","name","邮件与钓鱼","black-market","数据窃取与黑产","ransomware","勒索软件","microsoft","Microsoft / 微软","malware","恶意软件","attack","攻击活动",{"_106":178,"_42":179,"_109":173},{"_106":176,"_42":177,"_109":173},{"_106":174,"_42":175,"_109":173},{"_106":171,"_42":172,"_109":173},{"_106":169,"_42":170,"_109":160},{"_106":167,"_42":168,"_109":160},{"_106":165,"_42":166,"_109":160},{"_106":163,"_42":164,"_109":160},{"_106":161,"_42":162,"_109":160},{"_106":158,"_42":159,"_109":160},{"_106":156,"_42":157,"_109":132},{"_106":154,"_42":155,"_109":132},{"_106":152,"_42":153