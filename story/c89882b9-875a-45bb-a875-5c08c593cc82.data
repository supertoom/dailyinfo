[{"_1":2,"_3":4},"root",{"_5":200},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794357648000,"publicId","c89882b9-875a-45bb-a875-5c08c593cc82","title","Qubole凭据泄露波及多家客户","status","active","reportCount",3,"sourceCount","firstReportAt","2026-11-09T17:51:21.000Z","latestAt","2026-11-10T19:31:11.000Z","digest","云安全公司 Wiz 称，未披露攻击者利用已泄露的 Qubole AWS IAM 凭据，冒充客户为大数据平台 Qubole 设置的跨账户角色，进入逾12家组织的 AWS 环境窃取数据；凭据如何泄露、是否已被禁用及攻击是否停止均未说明。后续报道援引 Sentra 称受害者达数十家，仅一个客户就有数百万个文件被盗，但确切下游受害数量未披露。\n\n攻击活动于10月14日至26日进行，用于枚举资源、收集 Secrets Manager、SSM Parameter Store 中的凭据与配置并访问数据。Wiz 还发现10月8日至11日的另一轮攻击：攻击者测试客户自有 AWS 访问密钥，部分环境遭入侵。Wiz 表示，在此次观察到的角色扮演中，仅设置源 IP 条件即可阻止每次操作。","digestUpdatedAt","2026-11-10T20:00:55.548Z","summary","excerpt","latest","攻击者利用 Qubole AWS 信任关系窃取多个客户环境数据","latestReport",{"_165":183},"whyHot",{"_194":18,"_195":125,"_196":112,"_197":173,"_198":199},"developments",[187],"officialReports",[],"timeline",[162,163,164],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","black-market","name","数据窃取与黑产","ransomware","勒索软件","supply-chain","供应链安全","attack","攻击活动","identity","身份与访问","cloud-native","云与原生",{"_98":160,"_42":161,"_101":125},{"_98":158,"_42":159,"_101":125},{"_98":156,"_42":157,"_101":125},{"_98":154,"_42":155,"_101":125},{"_98":152,"_42":153,"_101":125},{"_98":150,"_42":151,"_101":125},{"_98":148,"_42":149,"_101":125},{"_98":146,"_42":147,"_101":125},{"_98":144,"_42":145,"_101":125},{"_98":142,"_42":143,"_101":125},{"_98":140,"_42":141,"_101":125},{"_98":138,"_42":139,"_101":125},{"_98":136,"_42":137,"_101":125},{"_98":134,"_42":135,"_101":125},{"_98":132,"_42