[{"_1":2,"_3":4},"root",{"_5":117},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794444103000,"publicId","41dc60b4-3949-4993-9807-db2659b6034b","title","马士基确认收购遗留系统遭勒索窃密","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-11T16:24:18.000Z","latestAt","2026-11-11T20:47:36.000Z","digest","马士基确认，其此前收购公司的本地遗留系统遭未授权访问和数据提取，WhiteArmor勒索团伙声称从OCF/LF Logistics物流与供应链平台窃取约100 GB数据并索要500万美元赎金；调查仍在继续，初步发现事件局限于该系统，未发现敏感数据披露，也无迹象表明其他马士基系统或通过API、EDI集成的客户与合作伙伴系统受影响。\n\n马士基称入侵已被隔离，但尚未公布受影响数据类型和入侵时间；团伙所称约100 GB数据及赎金要求来自攻击方，尚未获独立证实。","digestUpdatedAt","2026-11-11T22:20:52.193Z","summary","excerpt","latest","WhiteArmor 声称从 Maersk 窃取 100GB 数据并索要 500 万美元赎金","latestReport",{"_88":99},"whyHot",{"_110":18,"_111":81,"_112":18,"_113":114,"_115":116},"developments",[103],"officialReports",[],"timeline",[86,87],"heat",[62,63,64,65,66,67,68],"related",[],"topics",[48,49,50,51],{"_52":60,"_54":61},{"_52":58,"_54":59},{"_52":56,"_54":57},{"_52":53,"_54":55},"slug","malware","name","恶意软件","attack","攻击活动","ransomware","勒索软件","supply-chain","供应链安全",{"_69":84,"_42":85,"_72":81},{"_69":82,"_42":83,"_72":81},{"_69":79,"_42":80,"_72":81},{"_69":77,"_42":78,"_72":18},{"_69":75,"_42":76,"_72":18},{"_69":73,"_42":74,"_72":18},{"_69":70,"_42":71,"_72":18},"hour","2026-11-12T00:00:00.000Z",17.1,"participants","2026-11-11T23:00:00.000Z",17.6,"2026-11-11T22:00:00.000Z",18.2,"2026-11-11T21:00:00.000Z",18.7,"2026-11-11T20:00:00.000Z",9,1,"2026-11-11T19:00:00.000Z",9.3,"2026-11-11T18:00:00.000Z",9.5,{"_88":99,"_13":31,"_28":100,"_92":101,"_94":23,"_95":96},{"_88":89,"_13":90,"_28":91,"_92":93,"_94":21,"_95":96},"id","axr27uaonqbe9hf5mi41iz6tc","Maersk 确认 WhiteArmor 勒索攻击，团伙声称窃取约 100GB 数据并索要 500 万美元","Maersk 确认其此前收购公司的系统遭入侵并发生数据失窃，WhiteArmor 勒索团伙声称从 OCF/LF Logistics 平台外传约 100 GB 数据，并在周末索要 500 万