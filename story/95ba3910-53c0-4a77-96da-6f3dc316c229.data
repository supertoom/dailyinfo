[{"_1":2,"_3":4},"root",{"_5":292},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795135250000,"publicId","95ba3910-53c0-4a77-96da-6f3dc316c229","title","Star Blizzard连续入侵两家美国机构","status","active","reportCount",5,"sourceCount","firstReportAt","2026-11-17T14:00:00.000Z","latestAt","2026-11-19T14:42:20.000Z","digest","Google Threat Intelligence Group与Mandiant确认，俄罗斯关联组织COLD RELIC（Star Blizzard）已攻破两家美国机构，第二家使用Microsoft Entra ID作为联合单点登录提供商；两起入侵均已发生，目前尚无补丁或受影响范围数字。\n\n首起入侵始于2025年末。攻击者使用被盗的超级管理员凭据，经美国住宅代理登录并以MFA推送疲劳诱使账户持有人批准请求，随后注册恶意MFA设备、passkey及备份代码，下载云盘、导出员工名单和邮件数据，并以外部客户数据导出维持数月访问；Google警告，仅修改密码不足以撤销已劫持会话。\n\n攻击者随后利用首起入侵所得身份、通讯录及关系数据冒充员工，攻击第二家机构，并继续钓鱼欧洲和北美政府官员、国防承包商及NGO；Google称截至2026年11月仍观察到相关活动。","digestUpdatedAt","2026-11-19T15:18:50.840Z","summary","excerpt","latest","俄罗斯间谍组织 COLD RELIC 利用云端入侵冒充员工钓鱼后续目标","latestReport",{"_244":274},"whyHot",{"_285":127,"_286":287,"_288":216,"_289":252,"_290":291},"developments",[278],"officialReports",[],"timeline",[239,240,241,242,243],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","supply-chain","name","供应链安全","identity","身份与访问","malware","恶意软件","google","Google / 谷歌","attack","攻击活动","email","邮件与钓鱼",{"_123":237,"_42":238,"_126":216},{"_123":235,"_42":236,"_126":216},{"_123":233,"_42":234,"_126":216},{"_123":231,"_42":232,"_126":216},{"_123":229,"_42":230,"_126":216},{"_123":227,"_42":228,"_126":216},{"_123":225,"_42":226,"_126":216},{"_123":223,"_42":224,"_126":216},{"_123":221,"_42":222,"_126":216},{"_123":219,"_42":