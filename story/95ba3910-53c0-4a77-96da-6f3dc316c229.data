[{"_1":2,"_3":4},"root",{"_5":211},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795048843000,"publicId","95ba3910-53c0-4a77-96da-6f3dc316c229","title","Star Blizzard连续入侵两家美国机构","status","active","reportCount",4,"sourceCount","firstReportAt","2026-11-17T14:00:00.000Z","latestAt","2026-11-18T13:33:47.000Z","digest","Google Threat Intelligence Group 与 Mandiant 披露，俄罗斯关联组织 COLD RELIC（又称 Star Blizzard）已确认攻破两家美国机构；后者使用 Microsoft Entra ID 作为联合单点登录（SSO）提供方，攻击者此前已入侵另一家机构并取得该身份体系所需的凭据与令牌，影响范围尚未确认。\n\n首起入侵发生于2025年末。攻击者使用被盗的超级管理员凭据、住宅代理及 MFA 推送疲劳攻击，在受害者接受 MFA 请求后注册恶意设备、passkey 和备份代码，维持数月访问并外传邮件、聊天及云存储数据。被逐出首家机构后，COLD RELIC 仍冒充其员工攻击内部人员及行业关联方；Google称其截至2026年11月仍在开展钓鱼活动。","digestUpdatedAt","2026-11-18T14:04:09.741Z","summary","excerpt","latest","俄罗斯 APT Star Blizzard 冒充已被入侵企业员工，攻击另一家美国机构","latestReport",{"_170":194},"whyHot",{"_205":18,"_206":207,"_208":125,"_209":178,"_210":18},"developments",[198],"officialReports",[],"timeline",[166,167,168,169],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","identity","name","身份与访问","supply-chain","供应链安全","malware","恶意软件","attack","攻击活动","email","邮件与钓鱼","google","Google / 谷歌",{"_99":164,"_42":165,"_102":143},{"_99":162,"_42":163,"_102":143},{"_99":160,"_42":161,"_102":143},{"_99":158,"_42":159,"_102":143},{"_99":156,"_42":157,"_102":143},{"_99":154,"_42":155,"_102":143},{"_99":152,"_42":153,"_102":143},{"_99":150,"_42":151,"_102":143},{"_99":148,"_42":149,"_102":143},{"_99":146,"_42":147,"_102":143},{"_99":144,"_42":145,"_102":143},{"_99":141,"_42":142,"_102":143},{"_99":139,"_42":140,"_102":130},{"_99":137,"_42":138,"_10