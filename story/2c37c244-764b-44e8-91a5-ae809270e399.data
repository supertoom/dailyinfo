[{"_1":2,"_3":4},"root",{"_5":228},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":-5,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48},"expiresAt",1794444103000,"publicId","2c37c244-764b-44e8-91a5-ae809270e399","title","Fireworks AI入侵扩大至Notion对话","status","active","reportCount",3,"sourceCount",2,"firstReportAt","2026-11-10T07:49:58.000Z","latestAt","2026-11-11T20:54:20.000Z","digest","Fireworks AI确认，攻击者经遭入侵的第三方云提供商进入其开发环境，访问部分客户的资源元数据、账单信息、模型权重和数据集；后续调查发现，少量Notion工作区的Notion AI对话记录也经Insights数据集暴露，该数据集现已停用。\n\nFireworks AI称受影响用户不足1%。Notion建议相关用户轮换曾在受影响对话中输入的密码、API密钥或其他凭据。此前10月初的另一次入侵涉及少量账户的环境变量、API密钥和令牌；公司此前称未发现攻击者进一步成功访问客户使用的平台。","digestUpdatedAt","2026-11-11T23:11:02.612Z","summary","excerpt","latest","Fireworks AI 入侵导致少量 Notion AI 对话记录泄露","latestReport",{"_188":206},"whyHot",{"_221":20,"_222":223,"_224":178,"_225":196,"_226":227},"developments",[209,210],"officialReports",[],"timeline",[185,186,187],"heat",[69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108],"related",[],"topics",[49,50,51,52,53,54],{"_55":67,"_57":68},{"_55":65,"_57":66},{"_55":63,"_57":64},{"_55":61,"_57":62},{"_55":59,"_57":60},{"_55":56,"_57":58},"slug","supply-chain","name","供应链安全","google","Google / 谷歌","cloud-native","云与原生","ai-security","AI 安全","attack","攻击活动","ai-agent","AI Agent 安全",{"_109":184,"_43":134,"_112":178},{"_109":183,"_43":132,"_112":178},{"_109":182,"_43":130,"_112":178},{"_109":181,"_43":128,"_112":178},{"_109":180,"_43":126,"_112":178},{"_109":179,"_43":124,"_112":178},{"_109":177,"_43":122,"_112":178},{"_109":175,"_43":176,"_112":20},{"_109":173,"_43":174,"_112":20},{"_109":171,"_43":172,"_112":20},{"_109":169,"_43":170,"_112":20},{"_109":167,"_43":168,"_112":20},{"_109":165,"_43":166,"_112":20},{"_109":163,"_43":164,"_112":20},{"_109":161,"_43":162,"_112":20},{