[{"_1":2,"_3":4},"root",{"_5":219},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":-5,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48},"expiresAt",1795653657000,"publicId","f6003043-ce60-438d-9a23-a8338172530e","title","GeoServer未认证RCE链已复现并出现利用探测","status","active","reportCount",9,"sourceCount",8,"firstReportAt","2026-11-24T13:25:00.000Z","latestAt","2026-11-25T15:27:36.000Z","digest","GeoServer 五个漏洞（CVE-2026-129242、CVE-2026-129243、CVE-2026-129244、CVE-2026-120705、CVE-2026-129245，CVSS 3.1 9.8）可串联成未认证远程代码执行链，奇安信CERT、长亭安全应急响应中心、深瞳漏洞实验室等已复现，PoC与技术细节均已公开；WatchTowr 观察到攻击者利用 CVE-2026-120705 和 CVE-2026-129243 发送基于错误的利用探针探测存在漏洞的服务器，尚未发现成功实现远程代码执行的案例。\n\n利用无需认证，但前提是默认配置且 WFS 与 REST 接口网络可达；绿盟科技CERT进一步指出，需 WFS 与 REST API 对匿名用户开放、remember-me 认证启用且默认用户中的管理员账户可用。受影响版本为 GeoServer <= 2.27.6、2.28.0 <= GeoServer <= 2.28.5、3.0.0 <= GeoServer <= 3.0.1；攻击者可读取服务器端安全配置、伪造管理员会话并以 GeoServer 服务进程权限执行代码，以官方容器镜像默认配置部署时该进程以 root 运行。\n\n官方已发布补丁，修复版本为 3.0.2、2.28.6、2.27.7 及对应分支更高版本，CNVD 收录为 CNVD-2026-47957 至 CNVD-2026-47961 并建议受影响用户立即自查升级。","digestUpdatedAt","2026-11-25T17:20:44.494Z","summary","excerpt","latest","GeoServer 漏洞 CVE-2026-120705 与 CVE-2026-129243 已遭利用探测","latestReport",{"_124":176},"whyHot",{"_212":87,"_213":214,"_215":216,"_217":132,"_218":195},"developments",[188,189,190,191],"officialReports",[180,181,182,183],"timeline",[115,116,117,118,119,120,121,122,123],"heat",[69,70,71,72,73,74,75,76,77,78,79,80,81,82],"related",[],"topics",[49,50,51,52,53,54],{"_55":67,"_57":68},{"_55":65,"_57":66},{"_55":63,"_57":64},{"_55":61,"_57":62},{"_55":59,"_57":60},{"_55":56,"_57":58},"slug","rapid7","name","Rapid7 / Metasploit","cncert","CNCERT","qianxin","奇安信","research","技术研究","exploited","在野利用","vuln","漏洞披露",{"_83":113,"_43":114,"_86":106},{"_83":111,"_43":112,"_86":106},{"_83":109,"_43":110,"_86":106},{"_83":107,"_43":108,"_86":106},{"_83":104,"_43":105,"_86":106},{"_83":102,"_43":103,"_86":87},{"_83":100,"_43":101,"_86":87},{"_83":98,"_43":99,"_86":87},{"_83":96,"_43":97,"_86":87},{"_83":94,"_43":95,"_86":87},{"_83":92,"_43":93,"_86":87},{"_83":90,"_43":91,"_86":87},{"_83":88,"_43":89,"_86":87},{"_83":84,"_43":85,"_86":87},"hour","2026-11-26T00:00:00.000Z",40.7,"participants",7,"2026-11-25T23:00:00.000Z",41.9,"2026-11-25T22:00:00.000Z",43.2,"2026-11-25T21:00:00.000Z",44.4,"2026-11-25T20:00:00.000Z",45.7,"2026-11-25T19:00:00.000Z",47.1,"2026-11-25T18:00:00.000Z",48.5,"2026-11-25T17:00:00.000Z",49.9,"2026-11-25T16:00:00.000Z",51.3,"2026-11-25T15:00:00.000Z",42.7,6,"2026-11-25T14:00:00.000Z",44,"2026-11-25T13:00:00.000Z",45.3,"2026-11-25T12:00:00.000Z",46.6,"2026-11-25T11:00:00.000Z",47.9,{"_124":176,"_13":32,"_29":177,"_128":178,"_130":24,"_131":147},{"_124":170,"_13":171,"_29":172,"_128":173,"_130":174,"_131":132},{"_124":165,"_13":166,"_29":167,"_128":168,"_130":169,"_131":132},{"_124":159,"_13":160,"_29":161,"_128":162,"_130":163,"_131":132},{"_124":154,"_13":155,"_29":156,"_128":157,"_130":158,"_131":147},{"_124":148,"_13":149,"_29":150,"_128":151,"_130":152,"_131":132},{"_124":141,"_13":142,"_29":143,"_128":144,"_130":145,"_131":132},{"_124":135,"_13":136,"_29":137,"_128":138,"_130":139,"_131":132},{"_124":125,"_13":126,"_29":127,"_128":129,"_130":22,"_131":132},"id","oj83edqa4usiy96xx2b05qcus","GeoServer 未认证远程代码执行漏洞 CVE-2026-129242 等 5 个 CVE 已复现","长亭安全应急响应中心已复现 GeoServer 未认证远程代码执行风险，未认证攻击者可利用默认配置中的 5 处缺陷读取安全配置、伪造管理员会话并执行任意命令。","source",{"_57":133,"_134":132},"publishedAt","selected",true,"长亭安全应急响应中心","firstParty","nhx83jvk238i041bf7tt09eqs","GeoServer 未认证远程代码执行漏洞链 CVE-2026-129242 等已复现","GeoServer 未认证远程代码执行漏洞链涉及 CVE-2026-129244、CVE-2026-129243、CVE-2026-120705、CVE-2026-129245 和 CVE-2026-129242，奇安信 CERT 已复现，PoC 和技术细节均已公开。",{"_57":140,"_134":132},"2026-11-24T18:56:00.000Z","奇安信 CERT","fymjwsjohp5gf7xq7kkcwwk13","GeoServer 未认证 RCE 漏洞链 CVE-2026-129242 等五个 CVE 已公开 PoC","GeoServer 未认证 RCE 漏洞链涉及 CVE-2026-129242、CVE-2026-129244、CVE-2026-129243、CVE-2026-120705、CVE-2026-129245，CVSS 3.1 评分为 9.8，PoC 与技术细节均已公开。",{"_57":146,"_134":147},"2026-11-24T19:20:47.236Z","安全内参",false,"q0lsfhn32cxsdecbzc9oo3rfd","GeoServer 修复 5 个高危漏洞，CVE-2026-120705 等漏洞细节与 PoC 已公开","GeoServer 修复 CVE-2026-120705、CVE-2026-129242、CVE-2026-129243、CVE-2026-129244、CVE-2026-129245，涉及 WFS 存储查询、服务安全规则、remember-me 会话及 JDBC 安全服务，可串联形成未经身份验证的远程代码执行利用链。",{"_57":153,"_134":132},"2026-11-25T05:15:00.000Z","绿盟科技CERT","kst8bat1ex9co8csh527wsrb4","GeoServer 远程代码执行漏洞链 CVE-2026-129242 等五个漏洞公开，官方发布修复版本","CNVD 收录 GeoServer 远程代码执行漏洞链（CNVD-2026-47957 至 CNVD-2026-47961，对应 CVE-2026-129242 至 CVE-2026-129245），未经身份验证的远程攻击者在默认配置下可组合利用，读取服务器端安全配置、伪造管理员会话，并以 GeoServer 服务进程权限执行代码；漏洞技术细节与 PoC 已传播。",{"_57":146,"_134":147},"2026-11-25T05:20:47.236Z","p5sjx2d7ile73kobdy6s3a12y","GeoServer 认证前 RCE 利用链涉及 CVE-2026-129242 等 5 个漏洞","GeoServer 存在由 CVE-2026-129242、CVE-2026-129243、CVE-2026-129244、CVE-2026-129245、CVE-2026-120705 组成的认证前远程代码执行利用链。",{"_57":164,"_134":132},"2026-11-25T09:18:00.000Z","深信服千里目安全实验室","yu82hny47v29bntfa2kcc7nlu","CNCERT披露GeoServer远程代码执行漏洞链，影响2.27.6及3.0.1等版本","CNVD收录GeoServer远程代码执行漏洞链（CNVD-2026-47957至CNVD-2026-47961、CVE-2026-120705、CVE-2026-129242至CVE-2026-129245）。",{"_57":146,"_134":147},"2026-11-25T10:20:00.000Z","v7rw6jgl1dq4frh6qblha9zp8","攻击者已在利用 GeoServer 两个漏洞 CVE-2026-120705 与 CVE-2026-129243 构建未认证 RCE 链","watchTowr 称攻击者正利用 GeoServer 的 CVE-2026-120705 与 CVE-2026-129243 探测可利用目标，两者 CVSS 分数分别为 8.6 和 8.8，前者可读取本地文本文件或抓取指定 HTTP 或 HTTPS URL，后者可绕过服务安全规则调用受保护的 OWS 操作。",{"_57":175,"_134":147},"2026-11-25T12:48:54.000Z","The Hacker News","woakba0txl91nu6kv31iqcnmi","攻击者正利用 GeoServer 漏洞 CVE-2026-120705 和 CVE-2026-129243 探测存在漏洞的服务器，WatchTowr 已观察到通过创建并调用存储查询发送基于错误的利用探针，但尚未发现成功实现远程代码执行（RCE）的案例。",{"_57":179,"_134":147},"SecurityWeek",{"_124":159,"_13":160,"_29":161,"_128":187,"_130":163,"_131":132},{"_124":148,"_13":149,"_29":150,"_128":186,"_130":152,"_131":132},{"_124":135,"_13":136,"_29":137,"_128":185,"_130":139,"_131":132},{"_124":125,"_13":12