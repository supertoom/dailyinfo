[{"_1":2,"_3":4},"root",{"_5":291},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":-5,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48},"expiresAt",1795740056000,"publicId","f6003043-ce60-438d-9a23-a8338172530e","title","GeoServer未认证RCE链已复现并出现利用探测","status","watching","reportCount",9,"sourceCount",8,"firstReportAt","2026-11-24T13:25:00.000Z","latestAt","2026-11-25T15:27:36.000Z","digest","GeoServer 五个漏洞（CVE-2026-129242、CVE-2026-129243、CVE-2026-129244、CVE-2026-120705、CVE-2026-129245，CVSS 3.1 9.8）可串联成未认证远程代码执行链，奇安信CERT、长亭安全应急响应中心、深瞳漏洞实验室等已复现，PoC与技术细节均已公开；WatchTowr 观察到攻击者利用 CVE-2026-120705 和 CVE-2026-129243 发送基于错误的利用探针探测存在漏洞的服务器，尚未发现成功实现远程代码执行的案例。\n\n利用无需认证，但前提是默认配置且 WFS 与 REST 接口网络可达；绿盟科技CERT进一步指出，需 WFS 与 REST API 对匿名用户开放、remember-me 认证启用且默认用户中的管理员账户可用。受影响版本为 GeoServer <= 2.27.6、2.28.0 <= GeoServer <= 2.28.5、3.0.0 <= GeoServer <= 3.0.1；攻击者可读取服务器端安全配置、伪造管理员会话并以 GeoServer 服务进程权限执行代码，以官方容器镜像默认配置部署时该进程以 root 运行。\n\n官方已发布补丁，修复版本为 3.0.2、2.28.6、2.27.7 及对应分支更高版本，CNVD 收录为 CNVD-2026-47957 至 CNVD-2026-47961 并建议受影响用户立即自查升级。","digestUpdatedAt","2026-11-25T17:20:44.494Z","summary","excerpt","latest","GeoServer 漏洞 CVE-2026-120705 与 CVE-2026-129243 已遭利用探测","latestReport",{"_197":249},"whyHot",{"_285":111,"_286":287,"_288":287,"_289":205,"_290":111},"developments",[261,262,263,264],"officialReports",[253,254,255,256],"timeline",[188,189,190,191,192,193,194,195,196],"heat",[69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106],"related",[],"topics",[49,50,51,52,53,54],{"_55":67,"_57":68},{"_55":65,"_57":66},{"_55":63,"_57":64},{"_55":61,"_57":62},{"_55":59,"_57":60},{"_55":56,"_57":58},"slug","rapid7","name","Rapid7 / Metasploit","cncert","CNCERT","qianxin","奇安信","research","技术研究","exploited","在野利用","vuln","漏洞披露",{"_107":186,"_43":187,"_110":124},{"_107":184,"_43":185,"_110":124},{"_1