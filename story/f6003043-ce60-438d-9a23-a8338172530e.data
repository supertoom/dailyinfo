00Z",39.6,"2026-11-26T00:00:00.000Z",40.7,"2026-11-25T23:00:00.000Z",41.9,"2026-11-25T22:00:00.000Z",43.2,"2026-11-25T21:00:00.000Z",44.4,"2026-11-25T20:00:00.000Z",45.7,"2026-11-25T19:00:00.000Z",47.1,"2026-11-25T18:00:00.000Z",48.5,"2026-11-25T17:00:00.000Z",49.9,"2026-11-25T16:00:00.000Z",51.3,"2026-11-25T15:00:00.000Z",42.7,"2026-11-25T14:00:00.000Z",44,"2026-11-25T13:00:00.000Z",45.3,"2026-11-25T12:00:00.000Z",46.6,"2026-11-25T11:00:00.000Z",47.9,{"_197":249,"_13":32,"_29":250,"_201":251,"_203":24,"_204":220},{"_197":243,"_13":244,"_29":245,"_201":246,"_203":247,"_204":205},{"_197":238,"_13":239,"_29":240,"_201":241,"_203":242,"_204":205},{"_197":232,"_13":233,"_29":234,"_201":235,"_203":236,"_204":205},{"_197":227,"_13":228,"_29":229,"_201":230,"_203":231,"_204":220},{"_197":221,"_13":222,"_29":223,"_201":224,"_203":225,"_204":205},{"_197":214,"_13":215,"_29":216,"_201":217,"_203":218,"_204":205},{"_197":208,"_13":209,"_29":210,"_201":211,"_203":212,"_204":205},{"_197":198,"_13":199,"_29":200,"_201":202,"_203":22,"_204":205},"id","oj83edqa4usiy96xx2b05qcus","GeoServer 未认证远程代码执行漏洞 CVE-2026-129242 等 5 个 CVE 已复现","长亭安全应急响应中心已复现 GeoServer 未认证远程代码执行风险，未认证攻击者可利用默认配置中的 5 处缺陷读取安全配置、伪造管理员会话并执行任意命令。","source",{"_57":206,"_207":205},"publishedAt","selected",true,"长亭安全应急响应中心","firstParty","nhx83jvk238i041bf7tt09eqs","GeoServer 未认证远程代码执行漏洞链 CVE-2026-129242 等已复现","GeoServer 未认证远程代码执行漏洞链涉及 CVE-2026-129244、CVE-2026-129243、CVE-2026-120705、CVE-2026-129245 和 CVE-2026-129242，奇安信 CERT 已复现，PoC 和技术细节均已公开。",{"_57":213,"_207":205},"2026-11-24T18:56:00.000Z","奇安信 CERT","fymjwsjohp5gf7xq7kkcwwk13","GeoServer 未认证 RCE 漏洞链 CVE-2026-129242 等五个 CVE 已公开 PoC","GeoServer 未认证 RCE 漏洞链涉及 CVE-2026-129242、CVE-2026-129244、CVE-2026-129243、CVE-2026-120705、CVE-2026-129245，CVSS 3.1 评分为 9.8，PoC 与技术细节均已公开。",{"_57":219,"_207":220},"2026-11-24T19:20:47.236Z","安全内参",false,"q0lsfhn32cxsdecbzc9oo3rfd","GeoServer 修复 5 个高危漏洞，CVE-2026-120705 等漏洞细节与 PoC 已公开","GeoServer 修复 CVE-2026-120705、CVE-2026-129242、CVE-2026-129243、CVE-2026-129244、CVE-2026-129245，涉及 WFS 存储查询、服务安全规则、remember-me 会话及 JDBC 安全服务，可串联形成未经身份验证的远程代码执行利用链。",{"_57":226,"_207":205},"2026-11-25T05:15:00.000Z","绿盟科技CERT","kst8bat1ex9co8csh527wsrb4","GeoServer 远程代码执行漏洞链 CVE-2026-129242 等五个漏洞公开，官方发布修复版本","CNVD 收录 GeoServer 远程代码执行漏洞链（CNVD-2026-47957 至 CNVD-2026-47961，对应 CVE-2026-129242 至 CVE-2026-129245），未经身份验证的远程攻击者在默认配置下可组合利用，读取服务器端安全配置、伪造管理员会话，并以 GeoServer 服务进程权限执行代码；漏洞技术细节与 PoC 已传播。",{"_57":219,"_207":220},"2026-11-25T05:20:47.236Z","p5sjx2d7ile73kobdy6s3a12y","GeoServer 认证前 RCE 利用链涉及 CVE-2026-129242 等 5 个漏洞","GeoServer 存在由 CVE-2026-129242、CVE-2026-129243、CVE-2026-129244、CVE-2026-129245、CVE-2026-120705 组成的认证前远程代码执行利用链。",{"_57":237,"_207":205},"2026-11-25T09:18:00.000Z","深信服千里目安全实验室","yu82hny47v29bntfa2kcc7nlu","CNCERT披露GeoServer远程代码执行漏洞链，影响2.27.6及3.0.1等版本","CNVD收录GeoServer远程代码执行漏洞链（CNVD-2026-47957至CNVD-2026-47961、CVE-2026-120705、CVE-2026-129242至CVE-2026-129245）。",{"_57":219,"_207":220},"2026-11-25T10:20:00.000Z","v7rw6jgl1dq4frh6qblha9zp8","攻击者已在利用 GeoServer 两个漏洞 CVE-2026-120705 与 CVE-2026-129243 构建未认证 RCE 链","watchTowr 称攻击者正利用 GeoServer 的 CVE-2026-120705 与 CVE-2026-129243 探测可利用目标，两者 CVSS 分数分别为 8.6 和 8.8，前者可读取本地文本文件或抓取指定 HTTP 或 HTTPS URL，后者可绕过服务安全规则调用受保护的 OWS 操作。",{"_57":248,"_207":220},"2026-11-25T12:48:54.000Z","The Hacker News","woakba0txl91nu6kv31iqcnmi","攻击者正利用 GeoServer 漏洞 CVE-2026-120705 和 CVE-2026-129243 探测存在漏洞的服务器，WatchTowr 已观察到通过创建并调用存储查询发送基于错误的利用探针，但尚未发现成功实现远程代码执行（RCE）的案例。",{"_57":252,"_207":220},"SecurityWeek",{"_197":232,"_13":233,"_29":234,"_201":260,"_203":236,"_204":205},{"_197":221,"_13":222,"_29":223,"_201":259,"_203":225,"_204":205},{"_197":208,"_13":209,"_29":210,"_201":258,"_203":212,"_204":205},{"_197":198,"_13":199,"_29":200,"_201":257,"_203":22,"_204":205},{"_57":206,"_207":205},{"_57":213,"_207":205},{"_57":226,"_207":205},{"_57":237,"_207":205},{"_265":281,"_13":282,"_21":24,"_17":268,"_269":283},{"_265":277,"_13":278,"_21":225,"_17":274,"_269":279},{"_265":272,"_13":273,"_21":212,"_17":274,"_269":275},{"_265":266,"_13":267,"_21":22,"_17":268,"_269":270},"factId","fCFEbXwx39nc","复现GeoServer五漏洞利用链",1,"representative",{"_197":198,"_13":199,"_29":200,"_201":271,"_203":22,"_204":205},{"_57":206,"_207":205},"fsk1W6sVk-3I","奇安信CERT复现GeoServer未认证RCE漏洞链",3,{"_197":208,"_13":209,"_29":210,"_201":276,"_203":212,"_204":205},{"_57":213,"_207":205},"fU-A0Q2yxUGE","CNVD收录GeoServer远程代码执行漏洞链",{"_197":221,"_13":222,"_29":223,"_201":280,"_203":225,"_204":205},{"_57":226,"_207":205},"fw6yt0ABkXks","披露GeoServer漏洞利用链并证实探测",{"_197":249,"_13":32,"_29":250,"_201":284,"_203":24,"_204":220},{"_57":252,"_207":220},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",{"_292":293,"_294":-5},"changelogVersion","2026-10-01T08:00","release"]
