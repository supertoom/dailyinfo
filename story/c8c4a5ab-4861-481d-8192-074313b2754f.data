[{"_1":2,"_3":4},"root",{"_5":143},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795653657000,"publicId","c8c4a5ab-4861-481d-8192-074313b2754f","title","FinCEN部分系统遭未授权访问","status","active","reportCount",3,"sourceCount","firstReportAt","2026-11-25T11:45:00.000Z","latestAt","2026-11-25T13:39:21.000Z","digest","美国财政部金融犯罪执法网络（FinCEN）确认，一次网络安全事件导致其“有限一部分系统”被未授权访问。机构正调查事件，并出于预防将部分系统下线、着手恢复正常，但未披露受攻击或下线的具体系统，也未说明入侵是否造成服务中断。\n\n攻击者身份、事件性质及数据是否被查看或窃取仍不明确，FinCEN未提及潜在数据泄露。银行保密法电子申报系统（BSA E-Filing System）网站仍在运行，但部分服务可能暂时不可用；FinCEN已延长受影响的合格申报方提交规定文件的期限，并提供临时、有限的豁免。面向金融机构的热线1-866-556-3974未受服务中断影响。","digestUpdatedAt","2026-11-25T14:23:12.595Z","summary","excerpt","latest","美国财政部 FinCEN 因网络安全事件断开部分系统","latestReport",{"_107":124},"whyHot",{"_135":18,"_136":137,"_138":18,"_139":140,"_141":142},"developments",[128],"officialReports",[],"timeline",[104,105,106],"heat",[65,66,67,68,69,70,71,72,73,74,75,76],"related",[],"topics",[48,49,50,51,52],{"_53":63,"_55":64},{"_53":61,"_55":62},{"_53":59,"_55":60},{"_53":57,"_55":58},{"_53":54,"_55":56},"slug","black-market","name","数据窃取与黑产","ransomware","勒索软件","identity","身份与访问","attack","攻击活动","incident","应急响应",{"_77":101,"_42":102,"_80":103},{"_77":99,"_42":100,"_80":18},{"_77":97,"_42":98,"_80":18},{"_77":95,"_42":96,"_80":18},{"_77":93,"_42":94,"_80":18},{"_77":91,"_42":92,"_80":18},{"_77":89,"_42":90,"_80":18},{"_77":87,"_42":88,"_80":18},{"_77":85,"_42":86,"_80":18},{"_77":83,"_42":84,"_80":18},{"_77":81,"_42":82,"_80":18},{"_77":78,"_42":79,"_80":18},"hour","2026-11-26T00:00:00.000Z",21.6,"participants","2026-11-25T23:00:00.000Z",22.2,"2026-11-25T22:00:00.000Z",22.9,"2026-11-25T21:00:00.000Z",23.6,"2026-11-25T20:00:00.000Z",24.3,"2026-11-25T19:00:00.000Z",25,"2026-11-25T18:00:00.000Z",25.7,"2026-11-25T17:00:00.000Z",26.5,"2026-11-25T16:00:00.000Z",27.2,"2026-11-25T15:00:00.000Z",28,"2026-11-25T14:00:00.000Z",28.8,"2026-11-25T13:00:00.000Z",19.5,2,{"_107":124,"_13":31,"_28":125,"_111":126,"_113":23,"_114":115},{"_107":118,"_13":119,"_28":120,"_111":121,"_113":122,"_114":115},{"_107":108,"_13":109,"_28":110,"_111":112,"_113":21,"_114":115},"id","r4f76fqep84cotb2hcveytq29","美国财政部 FinCEN 调查网络事件，部分系统遭未授权访问","美国财政部下属 FinCEN 于 November 25 表示，正在调查导致其部分系统遭未授权访问的网络安全事件，并已将部分服务下线。","source",{"_55":116,"_117":115},"publishedAt","selected",false,"Infosecurity Magazine","firstParty","l9lsbjwhn2iix3somaj1jlzm2","FinCEN 遭网络入侵，部分系统被下线","美国财政部下属 FinCEN 遭遇网络安全事件，部分系统被未经授权访问，机构已预防性下线部分系统，但未披露受影响或下线的具体系统。",{"_55":123,"_117":115},"2026-11-25T12:30:08.000Z","The Hacker News","cpi9c2zski0rinoh2purjz7bv","美国财政部金融情报机构 FinCEN 表示，一次网络安全事件导致其部分系统被未授权访问，机构已将部分系统下线并着手恢复正常。BSA E-Filing System 网站仍可运行，但部分服务可能暂时不可用，FinCEN 已在 11 月 24 日的订单中为受影响的合格申报方提供临时、有限的豁免并延长申报期限。事件性质、攻击者身份及数据是否被访问或窃取尚未明确，FinCEN 未提及潜在数据泄露。",{"_55":127,"_117":115},"SecurityWeek",{"_129":130,"_13":131,"_20":21,"_17":18,"_132":133},"factId","f9UJ5yCxT4yA","FinCEN调查有限系统遭未授权访问事件","representative",{"_107":118,"_13":119,"_28":120,"_111":134,"_113":122,"_114":115},{"_55":123,"_117":115},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete",true,"rank",5,{"_144":145,"_146":-5},"changelogVersion","2026-10-01T08:00","release"]
