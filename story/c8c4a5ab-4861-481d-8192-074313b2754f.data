[{"_1":2,"_3":4},"root",{"_5":213},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795740055000,"publicId","c8c4a5ab-4861-481d-8192-074313b2754f","title","FinCEN部分系统遭未授权访问，已预防性下线部分系统","status","active","reportCount",4,"sourceCount","firstReportAt","2026-11-25T11:45:00.000Z","latestAt","2026-11-26T11:05:01.000Z","digest","美国财政部金融犯罪执法网络（FinCEN）确认，一次网络安全事件导致其“有限一部分系统”被未授权访问，该机构正在调查，并已预防性将部分系统下线、着手恢复正常。FinCEN未披露被访问或被下线的具体系统，也未说明入侵起始时间、攻击者身份以及数据是否被查看或窃取，未提及潜在数据泄露，也未说明中断是否由入侵本身造成。\n\n银行保密法电子申报系统（BSA E-Filing System）网站仍在线，但FinCEN提示部分服务可能暂时不可用；面向金融机构的热线1-866-556-3974未受此次服务中断影响。FinCEN已延长受影响合格申报方的申报期限：原在11月18日至12月29日之间到期的报告和更新可延至12月30日提交，11月24日发布的临时命令同时为这些申报方提供临时、有限的豁免。","digestUpdatedAt","2026-11-26T11:18:40.037Z","summary","excerpt","latest","FinCEN遭网络入侵，部分系统下线并延长金融机构报告期限","latestReport",{"_171":194},"whyHot",{"_205":18,"_206":207,"_208":209,"_210":211,"_212":18},"developments",[198],"officialReports",[],"timeline",[167,168,169,170],"heat",[65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100],"related",[],"topics",[48,49,50,51,52],{"_53":63,"_55":64},{"_53":61,"_55":62},{"_53":59,"_55":60},{"_53":57,"_55":58},{"_53":54,"_55":56},"slug","black-market","name","数据窃取与黑产","ransomware","勒索软件","identity","身份与访问","incident","应急响应","attack","攻击活动",{"_101":164,"_42":165,"_104":166},{"_101":162,"_42":163,"_104":131},{"_101":160,"_42":161,"_104":131},{"_101":158,"_42":159,"_104":131},{"_101":156,"_42":157,"_104":131},{"_101":154,"_42":155,"_104":131},{"_101":153,"_42":128,"_104":131},{"_101":152,"_42":126,"_104":131},{"_101":151,"_42":124,"_104":131},{"_101":150,"_42":122,"_104":131},{"_101":148,"_42":149,"_104":131},{"_101":146,"_42":147,"_104":131},{"_101":145,"_42":116,"_104":131},{"_101":144,"_42":114,"_104":131},{"_101":142,"