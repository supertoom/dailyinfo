[{"_1":2,"_3":4},"root",{"_5":147},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795480851000,"publicId","83d53a2c-4612-4179-a247-62493c1cfa2f","title","CrowdStrike同意439亿美元收购Zscaler","status","active","reportCount",4,"sourceCount","firstReportAt","2026-11-23T11:31:44.000Z","latestAt","2026-11-23T21:21:42.000Z","digest","CrowdStrike已同意以约439亿美元全股票交易收购云安全厂商Zscaler，若完成将成为网络安全行业最大规模并购；交易已获双方董事会一致批准，但仍须Zscaler股东批准、监管许可及满足其他惯常交割条件，尚未交割，双方目前独立运营，预计于CrowdStrike财年2028下半年完成。\n\n按方案，Zscaler股东每股可获1.135股CrowdStrike普通股，交割后两方股东将分别持有合并公司约84.1%和15.9%。双方称已有2,000多家共同客户和16项产品集成；Zscaler创始人兼CEO Jay Chaudhry交割后将继续领导Zscaler业务并加入CrowdStrike董事会。Dark Reading称交易拟整合端点保护与零信任网络安全，以加强对AI代理的控制。","digestUpdatedAt","2026-11-23T23:11:53.565Z","summary","excerpt","latest","CrowdStrike 以 440 亿美元收购 Zscaler，强化 AI 安全布局","latestReport",{"_106":129},"whyHot",{"_140":18,"_141":142,"_143":18,"_144":145,"_146":97},"developments",[133],"officialReports",[],"timeline",[102,103,104,105],"heat",[62,63,64,65,66,67,68,69,70,71,72,73],"related",[],"topics",[48,49,50,51],{"_52":60,"_54":61},{"_52":58,"_54":59},{"_52":56,"_54":57},{"_52":53,"_54":55},"slug","ai-agent","name","AI Agent 安全","cloud-native","云与原生","ai-security","AI 安全","crowdstrike","CrowdStrike",{"_74":100,"_42":101,"_77":97},{"_74":98,"_42":99,"_77":97},{"_74":95,"_42":96,"_77":97},{"_74":93,"_42":94,"_77":84},{"_74":91,"_42":92,"_77":84},{"_74":89,"_42":90,"_77":84},{"_74":87,"_42":88,"_77":84},{"_74":85,"_42":86,"_77":84},{"_74":82,"_42":83,"_77":84},{"_74":80,"_42":81,"_77":18},{"_74":78,"_42":79,"_77":18},{"_74":75,"_42":76,"_77":18},"hour","2026-11-24T00:00:00.000Z",31.2,"participants","2026-11-23T23:00:00.000Z",32.1,"2026-11-23T22:00:00.000Z",33.1,"2026-11-23T21:00:00.000Z",23.9,3,"2026-11-23T20:00:00.000Z",24.6,"2026-11-23T19:00:00.000Z",25.4,"2026-11-23T18:00:00.000Z",26.1,"2026-11-23T17:00:00.000Z",26.9,"2026-11-23T16:00:00.000Z",27.7,"2026-11-23T15:00:00.000Z",18.4,2,"2026-11-23T14:00:00.000Z",18.9,"2026-11-23T13:00:00.000Z",19.5,{"_106":129,"_13":31,"_28":130,"_110":131,"_112":23,"_113":114},{"_106":123,"_13":124,"_28":125,"_110":126,"_112":127,"_113":114},{"_106":117,"_13":118,"_28":119,"_110":120,"_112":121,"_113":114},{"_106":107,"_13":108,"_28":109,"_110":111,"_112":21,"_113":114},"id","lytjaxfwu73g41voa57vvfh84","CrowdStrike 同意以约 $43.9 billion 全股票交易收购 Zscaler","CrowdStrike 与 Zscaler 已同意进行约 $43.9 billion 的全股票收购，交易完成后 CrowdStrike 股东将持有合并公司约 84.1%，Zscaler 股东持有 15.9%。双方已有 2,000 多家共同客户和 16 项产品集成，合并后计划整合至统一平台；交易已获两家公司董事会一致批准，预计于 CrowdStrike 财年 2028 下半年完成。","source",{"_54":115,"_116":114},"publishedAt","selected",false,"SecurityWeek","firstParty","fb605neiwwim0nq406ol7basa","CrowdStrike 以约 $43.9 billion 收购 Zscaler，待股东及监管批准","CrowdStrike 同意以全股票方式收购 Zscaler，交易企业价值约 $43.9 billion；双方董事会已一致批准，但仍需 Zscaler 股东批准、监管许可及其他交割条件，预计于 CrowdStrike 财年 2028 下半年完成。",{"_54":122,"_116":114},"2026-11-23T12:41:18.000Z","Help Net Security","f15iqpm0fgvyiucoh0e8uvoqw","CrowdStrike 拟以约 $43.9bn 收购 Zscaler，创网络安全并购纪录","CrowdStrike 拟以约 $43.9bn 收购 Zscaler，若完成将成为网络安全市场最大并购，并使 CrowdStrike 可向约 8,000 家 Zscaler 客户交叉销售 Falcon 平台。",{"_54":128,"_116":114},"2026-11-23T15:15:00.000Z","Infosecurity Magazine","k03zc7o11icoep8hcz9yz19fp","CrowdStrike 将以 440 亿美元收购 Zscaler，将端点保护与零信任网络安全能力整合，以加强对 AI 代理的控制。原文未提供交易状态、具体产品范围或漏洞信息。",{"_54":132,"_116":114},"Dark Reading",{"_134":135,"_13":136,"_20":21,"_17":18,"_137":138},"factId","f9VU76kvcrvg","CrowdStrike同意收购Zscaler","representative",{"_106":117,"_13":118,"_28":119,"_110":139,"_112":121,"_113":114},{"_54":122,"_116":114},"participants48h","newParticipants6h",1,"recentReports24h","observationComplete",true,"rank",{"_148":149,"_150":-5},"changelogVersion","2026-10-01T08:00","release"]
