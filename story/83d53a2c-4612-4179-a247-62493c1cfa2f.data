[{"_1":2,"_3":4},"root",{"_5":220},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795567297000,"publicId","83d53a2c-4612-4179-a247-62493c1cfa2f","title","CrowdStrike同意439亿美元收购Zscaler","status","watching","reportCount",4,"sourceCount","firstReportAt","2026-11-23T11:31:44.000Z","latestAt","2026-11-23T21:21:42.000Z","digest","CrowdStrike已同意以约439亿美元全股票交易收购云安全厂商Zscaler，若完成将成为网络安全行业最大规模并购；交易已获双方董事会一致批准，但仍须Zscaler股东批准、监管许可及满足其他惯常交割条件，尚未交割，双方目前独立运营，预计于CrowdStrike财年2028下半年完成。\n\n按方案，Zscaler股东每股可获1.135股CrowdStrike普通股，交割后两方股东将分别持有合并公司约84.1%和15.9%。双方称已有2,000多家共同客户和16项产品集成；Zscaler创始人兼CEO Jay Chaudhry交割后将继续领导Zscaler业务并加入CrowdStrike董事会。Dark Reading称交易拟整合端点保护与零信任网络安全，以加强对AI代理的控制。","digestUpdatedAt","2026-11-23T23:11:53.565Z","summary","excerpt","latest","CrowdStrike 以 440 亿美元收购 Zscaler，强化 AI 安全布局","latestReport",{"_178":201},"whyHot",{"_212":18,"_213":214,"_215":214,"_216":217,"_218":219},"developments",[205],"officialReports",[],"timeline",[174,175,176,177],"heat",[62,63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97],"related",[],"topics",[48,49,50,51],{"_52":60,"_54":61},{"_52":58,"_54":59},{"_52":56,"_54":57},{"_52":53,"_54":55},"slug","ai-agent","name","AI Agent 安全","cloud-native","云与原生","ai-security","AI 安全","crowdstrike","CrowdStrike",{"_98":172,"_42":173,"_101":169},{"_98":170,"_42":171,"_101":169},{"_98":167,"_42":168,"_101":169},{"_98":165,"_42":166,"_101":156},{"_98":163,"_42":164,"_101":156},{"_98":161,"_42":162,"_101":156},{"_98":159,"_42":160,"_101":156},{"_98":157,"_42":158,"_101":156},{"_98":154,"_42":155,"_101":156},{"_98":152,"_42":153,"_101":18},{"_98":150,"_42":151,"_101":18},{"_98":148,"_42":149,"_101":18},{"_98":146,"_42":147,"_101":18},{"_98":144,"_42":145,"_101":18},{"_98":142,"_42":143,"_101":18},{"_98"