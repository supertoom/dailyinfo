[{"_1":2,"_3":4},"root",{"_5":351},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":-5,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48},"expiresAt",1794271241000,"publicId","61a4a753-d4b0-4ce4-9160-1e8081d70415","title","CISA确认SonicWall SAML认证绕过漏洞遭利用","status","active","reportCount",7,"sourceCount",6,"firstReportAt","2026-11-06T12:00:00.000Z","latestAt","2026-11-09T10:30:25.000Z","digest","CISA基于真实利用证据，将SonicWall SonicOS SSL-VPN的SAML认证绕过漏洞CVE-2026-19868纳入已知遭利用漏洞（KEV）目录，确认其已用于攻击；SonicWall已发布修复版本。该漏洞CVSS评分报道存在7.1与7.5两种值，影响启用SAML认证的服务。攻击者须持有另一种认证方式的有效凭据，才能绕过SAML认证控制及其实施的MFA，并非无需认证即可远程访问。\n\n受影响版本为SonicOS Gen7 7.3.3-7015及更早版本、Gen8 8.2.2-8015及更早版本。SonicWall已在7.3.4-7013和8.2.3-8015版本中修复包括该漏洞在内的七个漏洞，无临时变通方案；CISA要求联邦民事行政部门在2026年11月20日前完成修复，并检查打补丁前系统是否已遭攻陷。SonicWall称已调查潜在利用报告，但未披露攻击细节或幕后人员。","digestUpdatedAt","2026-11-09T10:36:47.193Z","summary","excerpt","latest","SonicWall SSL-VPN 漏洞 CVE-2026-19868 已被利用，可绕过 SAML 强制 MFA","latestReport",{"_286":327},"whyHot",{"_345":143,"_346":347,"_348":143,"_349":297,"_350":20},"developments",[333,334],"officialReports",[331],"timeline",[279,280,281,282,283,284,285],"heat",[69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130,131,132,133,134,135,136,137,138],"related",[],"topics",[49,50,51,52,53,54],{"_55":67,"_57":68},{"_55":65,"_57":66},{"_55":63,"_57":64},{"_55":61,"_57":62},{"_55":59,"_57":60},{"_55":56,"_57":58},"slug","research","name","技术研究","vuln-mgmt","漏洞管理","identity","身份与访问","exploited","在野利用","vuln","漏洞披露","cisa","CISA",{"_139":277,"_43":278,"_142":143},{"_139":275,"_43":276,"_142":143},{"_139":273,"_43":274,"_142":143},{"_139":271,"_43":272,"_142":143},{"_139":270,"_43":149,"_142":143},{"_139":268,"_43":269,"_142":143},{"_139":266,"