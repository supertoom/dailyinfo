[{"_1":2,"_3":4},"root",{"_5":123},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1793667384000,"publicId","9c663fa4-f577-4ef4-b503-4a8198a5d13b","title","Bitter以PapRAT攻击南亚机构","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-02T14:00:00.000Z","latestAt","2026-11-02T14:01:36.000Z","digest","Fortinet FortiGuard Labs披露，疑似南亚网络间谍组织Bitter（TA397）以三条入侵链向南亚政府、能源和工程机构的Windows系统投递PapRAT；遥测还显示东南亚和韩国存在相关活动。攻击未利用软件漏洞，主要通过诱骗投递恶意文件；FortiGuard Labs依据诱饵文件名、C2模式、文件元数据和恶意软件分析，高置信度归因于Bitter。\n\n其中两条链分别借助藏有诱饵电子表格的VHDX镜像和内嵌互联网快捷方式的RAR文件投递PapRAT，第三条仅滥用Windows LNK、ftp.exe、curl、脚本与计划任务，未部署PapRAT。研究还发现C++和Rust版PapRAT，并发现其下载伪装成vnces.exe的第二阶段植入物WmRAT。报道未说明受影响组织数量，也未提及漏洞、补丁或受害规模。","digestUpdatedAt","2026-11-02T14:51:05.070Z","summary","excerpt","latest","BITTER APT 使用伪造外交文件投递 PapRAT 间谍软件","latestReport",{"_93":104},"whyHot",{"_115":18,"_116":117,"_118":18,"_119":120,"_121":122},"developments",[108],"officialReports",[],"timeline",[91,92],"heat",[59,60,61,62,63,64,65,66,67,68],"related",[],"topics",[48,49,50],{"_51":57,"_53":58},{"_51":55,"_53":56},{"_51":52,"_53":54},"slug","malware","name","恶意软件","attack","攻击活动","fortinet","Fortinet / FortiGate",{"_69":89,"_42":90,"_72":18},{"_69":87,"_42":88,"_72":18},{"_69":85,"_42":86,"_72":18},{"_69":83,"_42":84,"_72":18},{"_69":81,"_42":82,"_72":18},{"_69":79,"_42":80,"_72":18},{"_69":77,"_42":78,"_72":18},{"_69":75,"_42":76,"_72":18},{"_69":73,"_42":74,"_72":18},{"_69":70,"_42":71,"_72":18},"hour","2026-11-03T00:00:00.000Z",15,"participants","2026-11-02T23:00:00.000Z",15.4,"2026-11-02T22:00:00.000Z",15.9,"2026-11-02T21:00:00.000Z",16.3,"2026-11-02T20:00:00.000Z",16.8,"2026-11-02T19:00:00.000Z",17.3,"2026-11-02T18:00:00.000Z",17.8,"2026-11-02T17:00:00.000Z",18.3,"2026-11-02T16:00:00.000Z",18.9,"2026-11-02T15:00:00.000Z",19.4,{"_93":104,"_13":31,"_28":105,"_97":106,"_99":23,"_100":101},{"_93":94,"_13":95,"_28":96,"_97":98,"_99":21,"_100":101},"id","wh259oxve120ddszbophjnpbb","Bitter 使用 PapRAT 针对亚洲组织开展网络间谍活动","FortiGuard Labs 追踪到疑似南亚网络间谍组织 Bitter（TA397）针对南亚组织的攻击活动，遥测也显示东南亚和韩国存在相关活动。攻击链包含 3 种感染方式，其中一条滥用 Windows LNK、ftp.exe、curl 和计划任务，未部署传统恶意程序，其余通过 MSI 或 RAR 投递 PapRAT，并进一步下载 WmRAT。","source",{"_53":102,"_103":101},"publishedAt","selected",false,"Infosecurity Magazine","firstParty","k8p2j003titzlfktqj0w5qfxh","Fortinet FortiGuard Labs 披露，BITTER APT 通过 3 条感染链向南亚政府、能源和工程机构的 Windows 系统投递 PapRAT，利用 LNK、VHDX、RAR、WebDAV 及 MSI 欺骗用户，未利用软件漏洞。",{"_53":107,"_103":101},"Hackread",{"_109":110,"_13":111,"_20":21,"_17":18,"_112":113},"factId","f10OqhwIHSqs","披露Bitter组织PapRAT间谍活动","representative",{"_93":94,"_13":95,"_28":96,"_97":114,"_99":21,"_100":101},{"_53":102,"_103":101},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete",true,"rank",7,{"_124":125,"_126":-5},"changelogVersion","2026-10-01T08:00","release"]
