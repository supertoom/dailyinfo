[{"_1":2,"_3":4},"root",{"_5":135},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794271241000,"publicId","60857cc0-39ba-44e7-93b7-3a108f8b6b7a","title","法国将700余处零售冷藏攻击归因于伊朗网络部队","status","active","reportCount",3,"sourceCount","firstReportAt","2026-11-09T00:00:00.000Z","latestAt","2026-11-09T19:12:43.000Z","digest","法国网络危机协调中心（C4）称，10月11日至12日针对法国工业制冷控制器的攻击已被确认，约700个零售地点受影响并引发至少15起火灾；法国将10月超市冷藏系统攻击归因于伊朗伊斯兰革命卫队电子与网络中心关联的Shahid Kaveh网络部队，但未将后续攻击纳入该归因。\n\n攻击者入侵制冷控制器并远程调高除霜温度，扰乱食品保存系统。法国当局称事件造成数千万欧元食品损失及重大物质损失，并称此次攻击的规模和攻击强度前所未有。\n\nC4还把自2020年以来针对法国利益的相关破坏行动归因于Shahid Shoostari与Shahid Kaveh，包括2023年针对Charlie Hebdo、2024年针对巴黎奥运会和残奥会筹备相关法国视频显示企业的攻击。Security Affairs称归因依据涉及基础设施、签名工具、波斯语痕迹及关联宣传组织，但公开报道未说明技术证据。","digestUpdatedAt","2026-11-09T20:34:43.036Z","summary","excerpt","latest","法国将超市冷藏设备攻击归因于 Iran IRGC","latestReport",{"_96":113},"whyHot",{"_130":18,"_131":92,"_132":89,"_133":116,"_134":89},"developments",[118,119],"officialReports",[],"timeline",[93,94,95],"heat",[68,69,70,71,72,73,74],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","ransomware","name","勒索软件","iot","IoT 与车联网","industrial","工业控制","supply-chain","供应链安全","cisa","CISA","attack","攻击活动",{"_75":90,"_42":91,"_78":92},{"_75":87,"_42":88,"_78":89},{"_75":85,"_42":86,"_78":18},{"_75":83,"_42":84,"_78":18},{"_75":81,"_42":82,"_78":18},{"_75":79,"_42":80,"_78":18},{"_75":76,"_42":77,"_78":18},"hour","2026-11-10T00:00:00.000Z",22.3,"participants","2026-11-09T23:00:00.000Z",22.9,"2026-11-09T22:00:00.000Z",23.6,"2026-11-09T21:00:00.000Z",24.3,"2026-11-09T20:00:00.000Z",25,"2026-11-09T19:00:00.000Z",15.6,2,"2026-11-09T18:00:00.000Z",5.9,1,{"_96":113,"_13":31,"_28":114,"_100":115,"_102":23,"_103":116},{"_96":107,"_13":108,"_28":109,"_100":110,"_102":111,"_103":104},{"_96":97,"_13":98,"_28":99,"_100":101,"_102":21,"_103":104},"id","eqwt8kadyjb3rhnmd1kvjjel8","CERT-FR 归因伊朗 CGRI 关联网络行动针对法国工控等目标","CERT-FR 的 C4 将多起针对法国利益的破坏性网络攻击归因于伊朗 CGRI-CEC 所属 Shahid Shoostari 与 Shahid Kaveh 网络部队。2026 年 10 月 11 日和 12 日，法国工业制冷控制器遭攻击，C4 称其攻击规模与攻击强度前所未有；相关归因声明与完整报告可从原文链接获取。","source",{"_56":105,"_106":104},"publishedAt","selected",false,"CERT-FR","firstParty","i4flfn6qeo7lqdjpb7vhf8oa2","法国将波及 700 多家零售点的制冷控制器攻击归因于伊朗黑客","法国将 10 月 11 日至 12 日针对工业制冷控制器的网络攻击归因于伊朗 IRGC 关联的 Shahid Kaveh，称约 700 个零售地点受影响并引发至少 15 起火灾。",{"_56":112,"_106":104},"2026-11-09T18:32:42.000Z","BleepingComputer","rgf6ztew8hr9hfi7xzfc08b7i","法国将 11 月 12 日发生的 700 个超市冷藏站点攻击归因于 Iran IRGC 关联的 Shahid Kaveh 网络部队，称攻击通过抬升冰箱温度破坏库存并引发数起火灾；归因依据包括基础设施、签名工具、波斯语痕迹及关联宣传组织，但作者指出公开报道未说明技术证据。",{"_56":117,"_106":104},true,"Security Affairs",{"_120":126,"_13":127,"_20":23,"_17":92,"_123":128},{"_120":121,"_13":122,"_20":21,"_17":89,"_123":124},"factId","fcxTFo1NJF54","法国披露伊朗关联网络攻击","representative",{"_96":107,"_13":108,"_28":109,"_100":125,"_102":111,"_103":104},{"_56":112,"_106":104},"fAIxGhxCLzqM","法国归因伊朗武装袭击超市冷藏系统",{"_96":113,"_13":31,"_28":114,"_100":129,"_102":23,"_103":116},{"_56":117,"_106":104},"participants48h","newParticipants6h","recentReports24h","observationComplete","rank",{"_136":137,"_138":-5},"changelogVersion","2026-10-01T08:00","release"]
