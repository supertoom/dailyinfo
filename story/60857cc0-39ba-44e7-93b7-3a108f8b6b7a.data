[{"_1":2,"_3":4},"root",{"_5":237},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794357648000,"publicId","60857cc0-39ba-44e7-93b7-3a108f8b6b7a","title","法国归因伊朗网络部队攻击700余零售点","status","active","reportCount",6,"sourceCount","firstReportAt","2026-11-09T00:00:00.000Z","latestAt","2026-11-10T10:35:00.000Z","digest","法国政府及CERT-FR将2026年10月11日至12日针对法国约700个超市及独立零售点的制冷控制器攻击归因于伊朗伊斯兰革命卫队电子与网络中心关联的Shahid Kaveh网络部队，确认攻击已被实际利用。攻击者入侵Danfoss和Dixell控制器，启动无时限异常除霜并关闭温度探针安全警报，使部分冷藏温度升至50摄氏度约6小时，造成食品损失及火灾；火灾数量此前披露为至少15起，新报道称约20起，Intermarché称单日损失达数千万欧元。\n\n巴黎检察机关已就疑似有组织网络犯罪启动正式调查，并称可能存在“为外国势力利益实施”的加重情节；CERT-FR称Shahid Kaveh与CyberAveng3rs、Soldiers of Solomon、Mr. Soul和Cyber Isnaad Front等黑客行动团体有关。此次归因仅涵盖10月法国超市冷藏系统攻击，不包括11月初法国血液服务局遭网络攻击等后续事件。","digestUpdatedAt","2026-11-10T10:47:59.178Z","summary","excerpt","latest","法国认定伊朗关联组织攻击700个超市制冷系统并寻求国际逮捕令","latestReport",{"_174":210},"whyHot",{"_231":103,"_232":233,"_234":139,"_235":196,"_236":139},"developments",[214,215,216],"officialReports",[],"timeline",[168,169,170,171,172,173],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","ransomware","name","勒索软件","cisa","CISA","supply-chain","供应链安全","iot","IoT 与车联网","industrial","工业控制","attack","攻击活动",{"_99":165,"_42":166,"_102":167},{"_99":162,"_42":163,"_102":164},{"_99":160,"_42":161,"_102":139},{"_99":158,"_42":159,"_102":139},{"_99":156,"_42":157,"_102":139},{"_99":154,"_42":155,"_102":139},{"_99":152,"_42":153,"_102":139},{"_99":150,"_42":151,"_102":139},{"_99":148,"_42":149,"_102":139},{"_99":146,"_42":147,"_102":139},{"_99":144,"_42":145,"_102":139},{"_99":142,"_42":143,"_102":1