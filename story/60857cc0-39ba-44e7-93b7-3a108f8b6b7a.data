78":179,"_180":21,"_181":182},"id","eqwt8kadyjb3rhnmd1kvjjel8","CERT-FR 归因伊朗 CGRI 关联网络行动针对法国工控等目标","CERT-FR 的 C4 将多起针对法国利益的破坏性网络攻击归因于伊朗 CGRI-CEC 所属 Shahid Shoostari 与 Shahid Kaveh 网络部队。2026 年 10 月 11 日和 12 日，法国工业制冷控制器遭攻击，C4 称其攻击规模与攻击强度前所未有；相关归因声明与完整报告可从原文链接获取。","source",{"_56":183,"_184":182},"publishedAt","selected",false,"CERT-FR","firstParty","i4flfn6qeo7lqdjpb7vhf8oa2","法国将波及 700 多家零售点的制冷控制器攻击归因于伊朗黑客","法国将 10 月 11 日至 12 日针对工业制冷控制器的网络攻击归因于伊朗 IRGC 关联的 Shahid Kaveh，称约 700 个零售地点受影响并引发至少 15 起火灾。",{"_56":190,"_184":182},"2026-11-09T18:32:42.000Z","BleepingComputer","rgf6ztew8hr9hfi7xzfc08b7i","法国将超市冷藏设备攻击归因于 Iran IRGC","法国将 11 月 12 日发生的 700 个超市冷藏站点攻击归因于 Iran IRGC 关联的 Shahid Kaveh 网络部队，称攻击通过抬升冰箱温度破坏库存并引发数起火灾；归因依据包括基础设施、签名工具、波斯语痕迹及关联宣传组织，但作者指出公开报道未说明技术证据。",{"_56":197,"_184":182},"2026-11-09T19:12:43.000Z",true,"Security Affairs","dutfochl5zqbpgtoxwe32cj7v","France 指控 Iran 武装组织攻击约 700 家超市制冷系统","France 指控 Iran 革命卫队关联的 Shahid Kaveh 小组攻击了全国约 700 家超市的制冷系统。10 月 12 日凌晨，攻击者远程控制制冷设备，使温度升至 50 Celsius（122 Fahrenheit）并持续约 6 小时，Intermarché 报告单日损失达数千万欧元。",{"_56":203,"_184":182},"2026-11-10T07:35:05.000Z","SecurityWeek","b0knsk24nkte3scrokxxwgqig","法国指责伊朗 IRGC 单位攻击约 700 家零售店的制冷控制器","法国政府称，伊朗伊斯兰革命卫队的网络单位 Shahid Kaveh 于 10 月 11 日入侵法国约 700 家零售店的 Danfoss 和 Dixell 制冷控制器，远程启动无限时除霜周期并关闭温度探针安全警报，造成食品损失和约 20 起火灾。",{"_56":209,"_184":182},"2026-11-10T09:08:20.000Z","The Hacker News","qpj5m3bzmzpjzhmw3osnq51bg","法国 authorities 指控伊朗关联的 Shahid Kaveh 和 Shahid Shoostari 组织协调攻击法国700个超市站点的制冷控制系统，属于以破坏为目的的网络攻击。",{"_56":213,"_184":182},"Infosecurity Magazine",{"_217":227,"_13":228,"_20":208,"_17":167,"_220":229},{"_217":223,"_13":224,"_20":195,"_17":164,"_220":225},{"_217":218,"_13":219,"_20":21,"_17":139,"_220":221},"factId","fcxTFo1NJF54","法国披露伊朗关联网络攻击","representative",{"_174":198,"_13":199,"_28":200,"_178":222,"_180":202,"_181":196},{"_56":203,"_184":182},"fAIxGhxCLzqM","法国归因伊朗武装袭击超市冷藏系统",{"_174":191,"_13":192,"_28":193,"_178":226,"_180":195,"_181":196},{"_56":197,"_184":182},"fJtsMX1_P9p8","法国归因伊朗单位破坏制冷控制器",{"_174":204,"_13":205,"_28":206,"_178":230,"_180":208,"_181":196},{"_56":209,"_184":182},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",{"_238":239,"_240":-5},"changelogVersion","2026-10-01T08:00","release"]
