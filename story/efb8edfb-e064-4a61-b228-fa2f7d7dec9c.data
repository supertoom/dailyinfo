[{"_1":2,"_3":4},"root",{"_5":176},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794616838000,"publicId","efb8edfb-e064-4a61-b228-fa2f7d7dec9c","title","美方捣毁FaceStealer恶意基础设施","status","active","reportCount",4,"sourceCount","firstReportAt","2026-11-13T06:30:30.000Z","latestAt","2026-11-13T14:17:17.000Z","digest","美国司法部与FBI已中断朝鲜黑客FaceStealer行动使用的云基础设施；该团伙过去18个月骗取超过4亿美元加密货币。FBI称，攻击者通过虚假Zoom和Teams会议诱使加密、Web3从业者及开源维护者运行恶意命令，成功接触后即植入恶意软件并录制受害者。\n\n恶意软件可窃取浏览器Cookie、记录键盘、截取屏幕并维持远程访问；FBI已扣押900多段受害者录像。部分攻击者会监控钱包数月甚至一年以上，待余额增加后再转走资金。后续报道称，恶意代码的大范围分发企图在实施前已被发现，相关基础设施已被捣毁。","digestUpdatedAt","2026-11-13T15:17:07.532Z","summary","excerpt","latest","FBI 捣毁朝鲜黑客 FaceStealer 行动，18 个月窃取逾 4 亿美元加密货币","latestReport",{"_130":141},"whyHot",{"_169":90,"_170":171,"_172":90,"_173":174,"_175":119},"developments",[157,158],"officialReports",[],"timeline",[126,127,128,129],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","malware","name","恶意软件","attack","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","supply-chain","供应链安全","cisa","CISA",{"_86":124,"_42":125,"_89":111},{"_86":122,"_42":123,"_89":111},{"_86":120,"_42":121,"_89":111},{"_86":118,"_42":119,"_89":111},{"_86":116,"_42":117,"_89":111},{"_86":114,"_42":115,"_89":111},{"_86":112,"_42":113,"_89":111},{"_86":109,"_42":110,"_89":111},{"_86":107,"_42":108,"_89":90},{"_86":105,"_42":106,"_89":90},{"_86":103,"_42":104,"_89":90},{"_86":101,"_42":102,"_89":90},{"_86":99,"_42":100,"_89":90},{"_86":97,"_42":98,"_89":90},{"_86":95,"_42":96,"_89":90},{"_86":93,"_42":94,"_89":90},{"_86":91,"_42":92,"_89":90},{"_86":87,"_42":88,"_89":90},"hour","2026-11-14T00:00:00.000Z",13.6,"participants",2,"2026-11-13T23:00:00.000Z",14,"2026-11-13T22:00:00.000Z",14.4,"2026-11-13T21:00:00.000Z",14.8,"2026-11-13T20:00:00.000Z",15.3,"2026-11-13T19:00:00.000Z",15.7,"2026-11-13T18:00:00.000Z",16.2,"2026-11-13T17:00:00.000Z",16.6,"2026-11-13T16:00:00.000Z",17.1,"2026-11-13T15:00:00.000Z",17.6,"2026-11-13T14:00:00.000Z",8.1,1,"2026-11-13T13:00:00.000Z",8.3,"2026-11-13T12:00:00.000Z",8.5,"2026-11-13T11:00:00.000Z",8.8,"2026-11-13T10:00:00.000Z",9,"2026-11-13T09:00:00.000Z",9.3,"2026-11-13T08:00:00.000Z",9.6,"2026-11-13T07:00:00.000Z",9.9,{"_130":151,"_13":152,"_28":153,"_134":154,"_136":155,"_137":138},{"_130":145,"_13":146,"_28":147,"_134":148,"_136":149,"_137":138},{"_130":141,"_13":31,"_28":142,"_134":143,"_136":23,"_137":138},{"_130":131,"_13":132,"_28":133,"_134":135,"_136":21,"_137":138},"id","hzo3gdzr7c51sutifak0vbv6y","FBI：North Korea 利用虚假 Zoom 和 Teams 通话窃取逾 900 名受害者录像，18 个月骗取超 $400 million","FBI 将 North Korea 黑客利用虚假 Zoom 和 Teams 通话实施的攻击称为 FaceStealer，该团伙过去 18 个月已窃取超过 $400 million 的加密货币，并从超过 900 名受害者处取得摄像头录像。","source",{"_56":139,"_140":138},"publishedAt","selected",false,"Help Net Security","firstParty","y2y1622fhn5bw6bawevcw4sji","美国 DOJ 与 FBI 捣毁朝鲜黑客 FaceStealer 行动所用的云基础设施，该行动过去 18 个月窃取超过 $400 million 加密货币。",{"_56":144,"_140":138},"Hackread","wzadae8x8f76ot0atvltq7k1h","FBI 指朝鲜关联黑客利用深度伪造视频会议实施 FaceStealer 攻击，18 个月窃取超 $400 Million 加密资产","美国联邦调查局（FBI）认定，朝鲜关联 BlueNoroff 借 FaceStealer 社会工程方案，在 18 个月内从加密货币与 Web3 行业目标窃取超过 $400 million 加密资产，并用录制的受害者视频和深度伪造建立信任后投放恶意软件。",{"_56":150,"_140":138},"2026-11-13T14:28:58.000Z","The Hacker News","vw9f7bq05n0ruzl7tx1o1fwyc","美国司法部查获逾 12 亿美元并中断 North Korea FaceStealer 加密货币窃取基础设施","美国司法部针对 North Korea 的加密货币窃取行动查获 FaceStealer 社会工程基础设施，并获得法院授权扣押近期从 Binance 窃取的逾 12 亿美元加密资产，相关资产总额已达 60 亿美元。",{"_56":156,"_140":138},"2026-11-13T21:19:30.000Z","Security Affairs",{"_159":165,"_13":166,"_20":23,"_17":111,"_162":167},{"_159":160,"_13":161,"_20":21,"_17":111,"_162":163},"factId","fGQ4OHlwrrro","FBI披露朝鲜黑客假Zoom骗局","representative",{"_130":131,"_13":132,"_28":133,"_134":164,"_136":21,"_137":138},{"_56":139,"_140":138},"fqeSscpBrZpw","FBI中断FaceStealer加密货币窃取行动",{"_130":141,"_13":31,"_28":142,"_134":168,"_136":23,"_137":138},{"_56":144,"_140":138},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete",true,"rank",{"_177":178,"_179":-5},"changelogVersion","2026-10-01T08:00","release"]
