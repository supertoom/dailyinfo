[{"_1":2,"_3":4},"root",{"_5":238},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794703237000,"publicId","efb8edfb-e064-4a61-b228-fa2f7d7dec9c","title","美方捣毁FaceStealer恶意基础设施","status","active","reportCount",6,"sourceCount","firstReportAt","2026-11-13T06:30:30.000Z","latestAt","2026-11-14T15:50:03.000Z","digest","美国司法部与FBI已中断朝鲜黑客FaceStealer行动使用的云基础设施；该团伙过去18个月骗取超过4亿美元加密货币。FBI称，攻击者通过虚假Zoom和Teams会议诱使加密、Web3从业者及开源维护者运行恶意命令，植入可窃取浏览器Cookie、记录键盘、截屏并维持远程访问的软件。\n\nFBI已扣押900多段受害者录像，并发现部分攻击者会监控钱包数月甚至一年以上，待余额增加后转走资金。相关恶意代码的大范围分发企图在实施前被发现并阻止；报道未披露补丁状态或受影响人数。","digestUpdatedAt","2026-11-14T17:27:22.314Z","summary","excerpt","latest","FBI 捣毁朝鲜 FaceStealers 行动，400百万美元被盗","latestReport",{"_180":216},"whyHot",{"_232":106,"_233":234,"_235":160,"_236":214,"_237":125},"developments",[220,221],"officialReports",[],"timeline",[174,175,176,177,178,179],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","malware","name","恶意软件","ransomware","勒索软件","supply-chain","供应链安全","cisa","CISA","attack","攻击活动","black-market","数据窃取与黑产",{"_102":172,"_42":173,"_105":160},{"_102":170,"_42":171,"_105":160},{"_102":168,"_42":169,"_105":160},{"_102":166,"_42":167,"_105":160},{"_102":165,"_42":124,"_105":160},{"_102":163,"_42":164,"_105":160},{"_102":161,"_42":162,"_105":160},{"_102":158,"_42":159,"_105":160},{"_102":156,"_42":157,"_105":125},{"_102":154,"_42":155,"_105":125},{"_102":152,"_42":153,"_105":125},{"_102":150,"_42":151,"_105":125},{"_102":148,"_42":149,"_105":125},{"_102":146,"_42":147,"_105":125},{"_102":144,"_42":145,"_105":125},{"_102":142,"_42":143,"_105":125},{"_10