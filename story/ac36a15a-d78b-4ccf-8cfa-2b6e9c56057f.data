[{"_1":2,"_3":4},"root",{"_5":178},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794703237000,"publicId","ac36a15a-d78b-4ccf-8cfa-2b6e9c56057f","title","Apple披露Secure Enclaves传感器数据隔离架构","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-13T11:27:56.000Z","latestAt","2026-11-14T11:00:00.000Z","digest","Apple公开了Secure Enclaves芯片级安全架构的运行机制，用于在后台处理中隔离摄像头和麦克风数据；这是架构披露，未涉及已确认的漏洞或攻击。Apple称，在Secure Enclaves内处理和分析的数据，主操作系统、应用及Apple均无法访问。\n\n该架构分为环境感知和主动两种模式：环境感知下，原始音视频留在Secure Enclaves内，处理完成后即丢弃，不进入主操作系统；主动模式下可向主操作系统释放完整传感器数据，并由安全指示器告知用户。Exclave Indicator Controller只有在确认指示器已开启且显示足够时间后，才允许完整数据流入主操作系统。\n\n该机制应用于HomeView人员识别、Siri Recap、Live Rewind及设备传感器指示等场景。Apple称，HomeView向主操作系统发送的识别结果仅包含人员标识、位置和置信度，不含音视频数据；由于内核持续变化，其形式化验证采取逐步覆盖不同部分的方式，不声称已覆盖内核全部方面。","digestUpdatedAt","2026-11-14T14:16:14.365Z","summary","excerpt","latest","Apple 详解 Secure Enclaves 如何隔离摄像头与麦克风数据","latestReport",{"_148":159},"whyHot",{"_170":18,"_171":172,"_173":117,"_174":175,"_176":177},"developments",[163],"officialReports",[],"timeline",[146,147],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","ai-agent","name","AI Agent 安全","iot","IoT 与车联网","mobile","移动端","kernel","内核与系统","research","技术研究","apple","Apple / 苹果",{"_93":144,"_42":145,"_96":117},{"_93":142,"_42":143,"_96":117},{"_93":140,"_42":141,"_96":117},{"_93":138,"_42":139,"_96":117},{"_93":136,"_42":137,"_96":117},{"_93":134,"_42":135,"_96":117},{"_93":132,"_42":133,"_96":117},{"_93":130,"_42":131,"_96":117},{"_93":128,"_42":129,"_96":117},{"_93":126,"_42":127,"_96":117},{"_93":124,"_42":125,"_96":117},{"_93":122,"_42":123,"_96":117},{"_93":120,"_42":121,"_96":117},{"_93":118,"_42":119,"_96":117},{"_93":115,"_42":116,"_96":117},{"_93":113,"_42":114,"_96":18},{"_93":111,"_42":112,"_96":18},{"_93":109,"_42":110,"_96":18},{"_93":107,"_42":108,"_96":18},{"_93":105,"_42":106,"_96":18},{"_93":103,"_42":104,"_96":18},{"_93":101,"_42":102,"_96":18},{"_93":99,"_42":100,"_96":18},{"_93":97,"_42":98,"_96":18},{"_93":94,"_42":95,"_96":18},"hour","2026-11-15T00:00:00.000Z",10.4,"participants","2026-11-14T23:00:00.000Z",10.7,"2026-11-14T22:00:00.000Z",11,"2026-11-14T21:00:00.000Z",11.3,"2026-11-14T20:00:00.000Z",11.6,"2026-11-14T19:00:00.000Z",12,"2026-11-14T18:00:00.000Z",12.3,"2026-11-14T17:00:00.000Z",12.7,"2026-11-14T16:00:00.000Z",13,"2026-11-14T15:00:00.000Z",13.4,"2026-11-14T06:00:00.000Z",5.9,1,"2026-11-14T05:00:00.000Z",6,"2026-11-14T04:00:00.000Z",6.2,"2026-11-14T03:00:00.000Z",6.4,"2026-11-14T02:00:00.000Z",6.6,"2026-11-14T01:00:00.000Z",6.8,"2026-11-14T00:00:00.000Z",7,"2026-11-13T23:00:00.000Z",7.2,"2026-11-13T22:00:00.000Z",7.4,"2026-11-13T21:00:00.000Z",7.6,"2026-11-13T20:00:00.000Z",7.8,"2026-11-13T19:00:00.000Z",8,"2026-11-13T18:00:00.000Z",8.3,"2026-11-13T17:00:00.000Z",8.5,"2026-11-13T16:00:00.000Z",8.8,{"_148":159,"_13":31,"_28":160,"_152":161,"_154":23,"_155":156},{"_148":149,"_13":150,"_28":151,"_152":153,"_154":21,"_155":156},"id","yzsgrcacezozug1b8ihsvmcvk","Apple 公开 Secure Exclaves 隔离运行时架构，保护摄像头与麦克风数据","Apple 公开 Secure Exclaves 安全架构，用于在后台处理中隔离摄像头和麦克风数据，并应用于 HomeView 人员识别、Siri Recap、Live Rewind 及设备传感器指示。","source",{"_56":157,"_158":156},"publishedAt","selected",false,"Help Net Security","firstParty","y1c8ltpl2iqy9t7vw429lcgww","Apple 公开 Secure Enclaves 安全架构的运行机制，通过隔离运行环境处理摄像头和麦克风数据，主操作系统、应用及 Apple 均无法访问在 Secure Enclave 内处理和分析的数据。",{"_56":162,"_158":156},"SecurityWeek",{"_164":165,"_13":166,"_20":21,"_17":18,"_167":168},"factId","ficOgOgg0vTc","Apple披露Secure Enclaves安全架构","representative",{"_148":159,"_13":31,"_28":160,"_152":169,"_154":23,"_155":156},{"_56":162,"_158":156},"partic