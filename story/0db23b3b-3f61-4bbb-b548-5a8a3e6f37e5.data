[{"_1":2,"_3":4},"root",{"_5":184},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794271240000,"publicId","0db23b3b-3f61-4bbb-b548-5a8a3e6f37e5","title","Iris Plaza确认约770万人数据遭访问","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-08T15:43:08.000Z","latestAt","2026-11-09T12:41:27.000Z","digest","Iris Ohyama确认，其运营的Iris Plaza因第三方云服务遭未授权访问，平台约770万名顾客的个人信息可能被未授权访问者获取；公司称已阻断攻击者访问服务，并通报执法机构及相关主管部门、聘请外部专家调查。\n\n潜在受影响者包括最多580万名现有及前注册会员和190万名非会员。会员的姓名、地址、电话、邮箱、出生日期、性别及加密密码可能被访问；非会员的姓名、地址、电话和邮箱可能被访问。Iris Plaza称，现任注册会员密码以加密形式存储，但未说明加密方案；截至11月5日，尚未收到相关信息被滥用或事件造成财务损失的报告。","digestUpdatedAt","2026-11-09T13:28:32.460Z","summary","excerpt","latest","Iris Plaza 数据泄露或影响 770 万名顾客","latestReport",{"_154":165},"whyHot",{"_177":18,"_178":179,"_180":115,"_181":168,"_182":183},"developments",[170],"officialReports",[],"timeline",[152,153],"heat",[56,57,58,59,60,61,62,63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86],"related",[],"topics",[48,49],{"_50":54,"_52":55},{"_50":51,"_52":53},"slug","attack","name","攻击活动","cloud-native","云与原生",{"_87":150,"_42":151,"_90":115},{"_87":148,"_42":149,"_90":115},{"_87":146,"_42":147,"_90":115},{"_87":144,"_42":145,"_90":115},{"_87":142,"_42":143,"_90":115},{"_87":140,"_42":141,"_90":115},{"_87":138,"_42":139,"_90":115},{"_87":136,"_42":137,"_90":115},{"_87":134,"_42":135,"_90":115},{"_87":132,"_42":133,"_90":115},{"_87":130,"_42":131,"_90":115},{"_87":128,"_42":129,"_90":115},{"_87":126,"_42":127,"_90":115},{"_87":124,"_42":125,"_90":115},{"_87":122,"_42":123,"_90":115},{"_87":120,"_42":121,"_90":115},{"_87":118,"_42":119,"_90":115},{"_87":116,"_42":117,"_90":115},{"_87":113,"_42":114,"_90":115},{"_87":111,"_42":112,"_90":18},{"_87":109,"_42":110,"_90":18},{"_87":107,"_42":108,"_90":18},{"_87":105,"_42":106,"_9