[{"_1":2,"_3":4},"root",{"_5":207},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795912858000,"publicId","e986eeed-64ad-4683-a3e3-84473bae3341","title","仿冒DeepSeek安装包被指植入金银狐木马","status","watching","reportCount",2,"sourceCount","firstReportAt","2026-11-27T03:26:00.000Z","latestAt","2026-11-27T10:22:01.000Z","digest","黑产团伙批量仿冒DeepSeek官网并借搜索广告投放恶意安装包，诱导用户下载桌面客户端；已有用户中招并出现电脑被远控、微信被盗后群发垃圾消息并封禁的症状，但“银狐”木马身份仍主要来自网友怀疑和媒体报道，受影响数量尚无统计。\n\n新增个案显示，部分用户在手机热点下安装后数小时内异常消耗约200GB流量，还有人发现文件消失或硬盘被格式化。报道指出，DeepSeek官网为deepseek.com、网页对话入口为chat.deepseek.com，其他“DeepSeek下载站”均需警惕。报道未说明恶意安装包版本、漏洞编号、修复版本或补丁状态。","digestUpdatedAt","2026-11-27T11:06:51.828Z","summary","excerpt","latest","高仿 DeepSeek 官网批量投毒，安装包可导致远控、盗号和流量劫持","latestReport",{"_178":190},"whyHot",{"_200":18,"_201":202,"_203":202,"_204":186,"_205":206},"developments",[193],"officialReports",[],"timeline",[176,177],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","ai-agent","name","AI Agent 安全","black-market","数据窃取与黑产","malware","恶意软件","attack","攻击活动","email","邮件与钓鱼","supply-chain","供应链安全",{"_103":174,"_42":175,"_106":167},{"_103":172,"_42":173,"_106":167},{"_103":170,"_42":171,"_106":167},{"_103":168,"_42":169,"_106":167},{"_103":165,"_42":166,"_106":167},{"_103":163,"_42":164,"_106":18},{"_103":161,"_42":162,"_106":18},{"_103":159,"_42":160,"_106":18},{"_103":157,"_42":158,"_106":18},{"_103":155,"_42":156,"_106":18},{"_103":153,"_42":154,"_106":18},{"_103":151,"_42":152,"_106":18},{"_103":149,"_42":150,"_106":18},{"_103":147,"_42":148,"_106":18},{"_103":145,"_42":146,"_106":18},{"_103":143,"_42":144