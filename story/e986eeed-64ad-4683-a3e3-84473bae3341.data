[{"_1":2,"_3":4},"root",{"_5":159},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795826460000,"publicId","e986eeed-64ad-4683-a3e3-84473bae3341","title","仿冒DeepSeek安装包被指植入金银狐木马","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-27T03:26:00.000Z","latestAt","2026-11-27T10:22:01.000Z","digest","黑产团伙批量仿冒DeepSeek官网并借搜索广告投放恶意安装包，诱导用户下载桌面客户端；已有用户中招并出现电脑被远控、微信被盗后群发垃圾消息并封禁的症状，但“银狐”木马身份仍主要来自网友怀疑和媒体报道，受影响数量尚无统计。\n\n新增个案显示，部分用户在手机热点下安装后数小时内异常消耗约200GB流量，还有人发现文件消失或硬盘被格式化。报道指出，DeepSeek官网为deepseek.com、网页对话入口为chat.deepseek.com，其他“DeepSeek下载站”均需警惕。报道未说明恶意安装包版本、漏洞编号、修复版本或补丁状态。","digestUpdatedAt","2026-11-27T11:06:51.828Z","summary","excerpt","latest","高仿 DeepSeek 官网批量投毒，安装包可导致远控、盗号和流量劫持","latestReport",{"_130":142},"whyHot",{"_152":18,"_153":154,"_155":18,"_156":138,"_157":158},"developments",[145],"officialReports",[],"timeline",[128,129],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","ai-agent","name","AI Agent 安全","black-market","数据窃取与黑产","malware","恶意软件","attack","攻击活动","email","邮件与钓鱼","supply-chain","供应链安全",{"_87":126,"_42":127,"_90":119},{"_87":124,"_42":125,"_90":119},{"_87":122,"_42":123,"_90":119},{"_87":120,"_42":121,"_90":119},{"_87":117,"_42":118,"_90":119},{"_87":115,"_42":116,"_90":18},{"_87":113,"_42":114,"_90":18},{"_87":111,"_42":112,"_90":18},{"_87":109,"_42":110,"_90":18},{"_87":107,"_42":108,"_90":18},{"_87":105,"_42":106,"_90":18},{"_87":103,"_42":104,"_90":18},{"_87":101,"_42":102,"_90":18},{"_87":99,"_42":100,"_90":18},{"_87":97,"_42":98,"_90":18},{"_87":95,"_42":96,"_90":18},{"_87":93,"_42":94,"_90":18},{"_87":91,"_42":92,"_90":18},{"_87":88,"_42":89,"_