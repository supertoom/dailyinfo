[{"_1":2,"_3":4},"root",{"_5":134},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794271241000,"publicId","da83266b-edc1-4102-9a04-c1a27c2d8408","title","奇安信复现Windows WER提权漏洞","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-09T03:39:00.000Z","latestAt","2026-11-09T03:44:20.872Z","digest","奇安信CERT已复现Windows Error Reporting（WER）参数注入权限提升漏洞CVE-2026-97798，并公开PoC和技术细节；目前未发现其在野利用。攻击者需先在目标系统获得低权限代码执行能力，才能将可控Process参数注入高权限数据收集器命令行，使可执行文件以NT AUTHORITY\\SYSTEM令牌启动。\n\n报道已确认Windows Server 2025版本10.0.26100.0至10.0.26100.33650受影响。Windows默认启用Microsoft Update，有可用更新时会自动下载，并在下一次启动时安装。","digestUpdatedAt","2026-11-09T12:45:47.406Z","summary","excerpt","latest","Microsoft Windows Error Reporting 权限提升漏洞 CVE-2026-97798 影响多个 Windows 版本","latestReport",{"_102":113},"whyHot",{"_127":18,"_128":129,"_130":18,"_131":110,"_132":133},"developments",[120],"officialReports",[118],"timeline",[100,101],"heat",[59,60,61,62,63,64,65,66,67,68,69,70,71],"related",[],"topics",[48,49,50],{"_51":57,"_53":58},{"_51":55,"_53":56},{"_51":52,"_53":54},"slug","kernel","name","内核与系统","vuln","漏洞披露","microsoft","Microsoft / 微软",{"_72":98,"_42":99,"_75":18},{"_72":96,"_42":97,"_75":18},{"_72":94,"_42":95,"_75":18},{"_72":92,"_42":93,"_75":18},{"_72":90,"_42":91,"_75":18},{"_72":88,"_42":89,"_75":18},{"_72":86,"_42":87,"_75":18},{"_72":84,"_42":85,"_75":18},{"_72":82,"_42":83,"_75":18},{"_72":80,"_42":81,"_75":18},{"_72":78,"_42":79,"_75":18},{"_72":76,"_42":77,"_75":18},{"_72":73,"_42":74,"_75":18},"hour","2026-11-10T00:00:00.000Z",11.1,"participants","2026-11-09T23:00:00.000Z",11.5,"2026-11-09T22:00:00.000Z",11.8,"2026-11-09T21:00:00.000Z",12.1,"2026-11-09T20:00:00.000Z",12.5,"2026-11-09T19:00:00.000Z",12.9,"2026-11-09T18:00:00.000Z",13.2,"2026-11-09T17:00:00.000Z",13.6,"2026-11-09T16:00:00.000Z",14,"2026-11-09T15:00:00.000Z",14.4,"2026-11-09T14:00:00.000Z",14.9,"2026-11-09T13:00:00.000Z",15.3,"2026-11-09T12:00:00.000Z",15.7,{"_102":113,"_13":31,"_28":114,"_106":115,"_108":23,"_109":110},{"_102":103,"_13":104,"_28":105,"_106":107,"_108":21,"_109":110},"id","fllexxsbebzht0ofar3sm61ku","Windows Error Reporting 参数注入权限提升漏洞 CVE-2026-97798 已复现","Windows Error Reporting 参数注入权限提升漏洞 CVE-2026-97798 已被奇安信 CERT 复现，攻击者在具备目标系统低权限代码执行能力时可借助 WER 的参数注入将任意程序以 SYSTEM 权限启动。","source",{"_53":111,"_112":110},"publishedAt","selected",true,"奇安信 CERT","firstParty","zldmfrtlvyq1se0fefjesvvjn","Microsoft Windows Error Reporting 参数注入权限提升漏洞 CVE-2026-97798 可由低权限本地用户利用，将攻击者可控的 Process 参数注入高权限数据收集器命令行，使可执行文件以 NT AUTHORITY\\SYSTEM 令牌启动。",{"_53":116,"_112":117},"安全内参",false,{"_102":103,"_13":104,"_28":105,"_106":119,"_108":21,"_109":110},{"_53":111,"_112":110},{"_121":122,"_13":123,"_20":21,"_17":18,"_124":125},"factId","fY4UYQx1hCXA","奇安信CERT复现WER权限提升漏洞","representative",{"_102":103,"_13":104,"_28":105,"_106":126,"_108":21,"_109":110},{"_53":111,"_112":110},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",9,{"_135":136,"_137":-5},"changelogVersion","2026-10-01T08:00","release"]
