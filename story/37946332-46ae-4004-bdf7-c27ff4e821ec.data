[{"_1":2,"_3":4},"root",{"_5":135},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794876039000,"publicId","37946332-46ae-4004-bdf7-c27ff4e821ec","title","Linux NoisyTCP漏洞可远程触发崩溃","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-16T09:30:04.000Z","latestAt","2026-11-16T09:50:11.000Z","digest","安全研究者 Hyunwoo Kim 披露 Linux 内核 TCP 网络子系统漏洞 CVE-2026-99288（NoisyTCP）；其称，未认证攻击者可通过特制 TCP 数据包利用 SYN cookie 处理与套接字哈希之间的时序竞争，远程触发内核及操作系统崩溃。漏洞已合并至 Linux 主线内核并有补丁发布，但目前没有证据表明已被实际利用；影响规模也未确认。\n\n利用要求目标启用至少两个 RX 队列，或由 RPS 将数据包分散至多个 CPU；竞争窗口较窄，在安静的裸机服务器上可能需要较长时间。该漏洞影响几乎所有 Linux 发行版，以及默认配置下运行 Nginx、Apache 或 SSH 的系统。\n\n无法立即升级或打补丁者，Hyunwoo Kim 建议禁用 SYN cookie，并将接收队列串行化以阻断竞争，但这会削弱对 SYN 洪泛攻击的防护。","digestUpdatedAt","2026-11-16T10:26:48.159Z","summary","excerpt","latest","NoisyTCP Linux kernel 漏洞可导致数百万 Nginx、Apache、SSH 服务器崩溃","latestReport",{"_105":117},"whyHot",{"_128":18,"_129":130,"_131":18,"_132":113,"_133":134},"developments",[121],"officialReports",[],"timeline",[103,104],"heat",[56,57,58,59,60,61,62,63,64,65,66,67,68,69,70],"related",[],"topics",[48,49],{"_50":54,"_52":55},{"_50":51,"_52":53},"slug","vuln","name","漏洞披露","kernel","内核与系统",{"_71":101,"_42":102,"_74":18},{"_71":99,"_42":100,"_74":18},{"_71":97,"_42":98,"_74":18},{"_71":95,"_42":96,"_74":18},{"_71":93,"_42":94,"_74":18},{"_71":91,"_42":92,"_74":18},{"_71":89,"_42":90,"_74":18},{"_71":87,"_42":88,"_74":18},{"_71":85,"_42":86,"_74":18},{"_71":83,"_42":84,"_74":18},{"_71":81,"_42":82,"_74":18},{"_71":79,"_42":80,"_74":18},{"_71":77,"_42":78,"_74":18},{"_71":75,"_42":76,"_74":18},{"_71":72,"_42":73,"_74":18},"hour","2026-11-17T00:00:00.000Z",13.2,"participants","2026-11-16T23:00:00.000Z",13.6,"2026-11-16T22:00:00.000Z",14,"2026-11-16T21:00:00.000Z",14.4,"2026-11-16T20:00:00.000Z",14.8,"2026-11-16T19:00:00.000Z",15.3,"2026-11-16T18:00:00.000Z",15.7,"2026-11-16T17:00:00.000Z",16.2,"2026-11-16T16:00:00.000Z",16.7,"2026-11-16T15:00:00.000Z",17.1,"2026-11-16T14:00:00.000Z",17.6,"2026-11-16T13:00:00.000Z",18.2,"2026-11-16T12:00:00.000Z",18.7,"2026-11-16T11:00:00.000Z",19.2,"2026-11-16T10:00:00.000Z",19.8,{"_105":117,"_13":31,"_28":118,"_109":119,"_111":23,"_112":116},{"_105":106,"_13":107,"_28":108,"_109":110,"_111":21,"_112":113},"id","nyd4hh8a7m5q933cuuvf2ko4j","Linux 内核 NoisyTCP 漏洞 CVE-2026-99288 可远程崩溃服务器","Linux 内核 NoisyTCP 漏洞 CVE-2026-99288 可由未认证攻击者利用恶意 TCP  packets 远程触发，影响几乎所有 Linux 发行版及默认配置下运行 Nginx、Apache 或 SSH 的系统。","source",{"_52":114,"_115":116},"publishedAt","selected",true,"BleepingComputer","firstParty",false,"jn7ifqucofpj4i3bqms5cjw8m","NoisyTCP Linux kernel 漏洞可导致数百万 Nginx、Apache、SSH 服务器崩溃。该漏洞约 11 年未被发现，正文未披露 CVE 编号、CVSS 分数、受影响版本、利用前提、补丁状态或是否已被利用。",{"_52":120,"_115":116},"Cybernews",{"_122":123,"_13":124,"_20":21,"_17":18,"_125":126},"factId","fNP9bAbFf42c","披露NoisyTCP内核远程崩溃漏洞","representative",{"_105":106,"_13":107,"_28":108,"_109":127,"_111":21,"_112":113},{"_52":114,"_115":116},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",5,{"_136":137,"_138":-5},"changelogVersion","2026-10-01T08:00","release"]
