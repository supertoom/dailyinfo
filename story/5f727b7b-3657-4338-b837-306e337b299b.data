[{"_1":2,"_3":4},"root",{"_5":170},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795826460000,"publicId","5f727b7b-3657-4338-b837-306e337b299b","title","Cacti 1.2.31未授权RCE PoC已公开","status","active","reportCount",4,"sourceCount","firstReportAt","2026-11-27T05:48:20.000Z","latestAt","2026-11-27T17:06:13.000Z","digest","Cacti Core 1.2.31存在CVSS 9.8的未授权远程代码执行漏洞，PoC已由研究者ek0ms savi0r公开，跟踪代号4http2shell、4HTTP2ROOT，奇安信CERT已复现并编号QVD-2026-117631；漏洞尚无CVE编号，官方未发布补丁，也尚无在真实攻击中被利用的报告，影响范围仍未确认。\n\n成功利用需启用Guest账户（默认关闭）、相关Web接口可访问且PDO支持多语句执行。攻击者无需有效凭据，可通过堆叠查询修改poller_item.arg1并触发轮询器，以Cacti进程权限执行命令；实际权限取决于Web服务及轮询器运行账户。已验证受影响版本为Cacti Core 1.2.31，更早版本是否受影响尚不清楚。\n\n修复发布前，建议禁用Guest账户、限制Web接口访问，并检查poller配置中的异常命令值。","digestUpdatedAt","2026-11-27T17:40:44.703Z","summary","excerpt","latest","Cacti 零日漏洞公开 PoC，未认证攻击者可远程执行命令","latestReport",{"_127":151},"whyHot",{"_164":18,"_165":166,"_167":18,"_168":143,"_169":116},"developments",[157],"officialReports",[155],"timeline",[123,124,125,126],"heat",[65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82],"related",[],"topics",[48,49,50,51,52],{"_53":63,"_55":64},{"_53":61,"_55":62},{"_53":59,"_55":60},{"_53":57,"_55":58},{"_53":54,"_55":56},"slug","vuln-mgmt","name","漏洞管理","qianxin","奇安信","exploited","在野利用","research","技术研究","vuln","漏洞披露",{"_83":121,"_42":122,"_86":116},{"_83":119,"_42":120,"_86":116},{"_83":117,"_42":118,"_86":116},{"_83":114,"_42":115,"_86":116},{"_83":112,"_42":113,"_86":101},{"_83":110,"_42":111,"_86":101},{"_83":108,"_42":109,"_86":101},{"_83":106,"_42":107,"_86":101},{"_83":104,"_42":105,"_86":101},{"_83":102,"_42":103,"_86":101},{"_83":99,"_42":100,"_86":101},{"_83":97,"_42":98,"_86":18},{"_83":95,"_42":96,"_86":18},{"_83":93,"_42":94,"_86":18},{"_83":91,"_42":92,"_86":18},{"_83":89,"_42":90,"_86":18},{"_83":87,"_42":88,"_86":18},{"_83":84,"_42":85,"_86":18},"hour","2026-11-28T00:00:00.000Z",27.6,"participants","2026-11-27T23:00:00.000Z",28.4,"2026-11-27T22:00:00.000Z",29.2,"2026-11-27T21:00:00.000Z",30.1,"2026-11-27T20:00:00.000Z",31,"2026-11-27T19:00:00.000Z",31.9,"2026-11-27T18:00:00.000Z",32.8,"2026-11-27T17:00:00.000Z",23.7,3,"2026-11-27T16:00:00.000Z",24.4,"2026-11-27T15:00:00.000Z",25.1,"2026-11-27T14:00:00.000Z",25.9,"2026-11-27T13:00:00.000Z",26.6,"2026-11-27T12:00:00.000Z",27.4,"2026-11-27T11:00:00.000Z",28.2,"2026-11-27T10:00:00.000Z",8.9,1,"2026-11-27T09:00:00.000Z",9.1,"2026-11-27T08:00:00.000Z",9.4,"2026-11-27T07:00:00.000Z",9.7,{"_127":151,"_13":31,"_28":152,"_131":153,"_133":23,"_134":135},{"_127":145,"_13":146,"_28":147,"_131":148,"_133":149,"_134":135},{"_127":138,"_13":139,"_28":140,"_131":141,"_133":142,"_134":143},{"_127":128,"_13":129,"_28":130,"_131":132,"_133":21,"_134":135},"id","lc4o91f3jga385e0h7ifg0ofc","Cacti 1.2.31 漏洞未修复，四个 HTTP 请求经 guest 账户达成 RCE","开源网络监控工具 Cacti 的最新版本 Cacti Core 1.2.31 存在尚未分配 CVE 编号的漏洞，跟踪代号为 4HTTP2SHELL 与 4HTTP2ROOT，研究者 ek0ms savi0r 称无需登录与有效 API key，仅靠四次 HTTP 请求即可以 Cacti 服务账户身份执行命令。","source",{"_55":136,"_137":135},"publishedAt","selected",false,"The Hacker News","firstParty","rfirwc4gz7xd4ktjxcnwoqtre","Cacti Core 1.2.31 未授权远程代码执行漏洞 QVD-2026-117631 已公开 PoC","Cacti Core 1.2.31 存在未授权远程代码执行漏洞 QVD-2026-117631，攻击者在启用 Guest 账户且可访问 Web 接口时，无需认证即可通过少量 HTTP 请求执行任意命令。",{"_55":144,"_137":135},"2026-11-27T10:05:30.736Z",true,"安全内参","t6uwzah42cn6jaqs5uqqpomuj","Cacti 远程代码执行漏洞 4http2shell 曝光，CVSS 9.8，PoC 已公开","Cacti 远程代码执行漏洞（4http2shell，又称 4HTTP2ROOT）细节与 PoC 已公开，CVSS 评分 9.8。",{"_55":150,"_137":143},"2026-11-27T10:35:00.000Z","绿盟科技CERT","j158oejps5agmlpskimxzu5ra","Cacti 网络监控平台曝出零日漏洞，公开 PoC 可通过 4 个 HTTP 请求在未认证条件下触发命令执行。研究人员测试了 Cacti Core 1.2.31，更早版本是否受影响尚不清楚；攻击要求启用 guest 账户，但不需要有效凭据。",{"_55":154,"_137":135},"BleepingComputer",{"_127":145,"_13":146,"_28":147,"_131":156,"_133":149,"_134":135},{"_55":150,"_137":143},{"_158":159,"_13":160,"_20":21,"_17":18,"_161":162},"factId","f6ZAsYycycU8","公开Cacti零日漏洞利用链","representative",{"_127":138,"_13":139,"_28":140,"_131":163,"_133":142,"_134":143},{"_55":144,"_137":135},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",{"_171":172,"_173":-5},"changelogVersion","2026-10-01T08:00","release"]
