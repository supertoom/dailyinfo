[{"_1":2,"_3":4},"root",{"_5":228},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795912857000,"publicId","5f727b7b-3657-4338-b837-306e337b299b","title","Cacti 1.2.31未授权RCE PoC已公开","status","watching","reportCount",5,"sourceCount","firstReportAt","2026-11-27T05:48:20.000Z","latestAt","2026-11-27T17:06:13.000Z","digest","Cacti Core 1.2.31被证实存在CVSS 9.8的未授权远程代码执行漏洞，奇安信CERT已复现并编号QVD-2026-117631，漏洞尚无CVE编号，官方暂无补丁，也暂无真实攻击利用报告，影响范围尚未确认。\n\n研究者ek0ms savi0r公开了跟踪代号4http2shell、4HTTP2ROOT的PoC。成功利用需启用Guest账户（默认关闭）、相关Web接口可访问且PDO支持多语句执行；攻击者无需有效凭据，可通过堆叠查询修改poller_item.arg1并触发轮询器，以Cacti进程权限执行命令，实际权限取决于Web服务及轮询器运行账户。已验证受影响版本为1.2.31，更早版本是否受影响尚不清楚。\n\n修复发布前，建议禁用Guest账户、限制Web接口访问，并检查poller配置中的异常命令值。","digestUpdatedAt","2026-11-28T17:28:26.687Z","summary","excerpt","latest","Cacti 零日漏洞公开 PoC，未认证攻击者可远程执行命令","latestReport",{"_177":207},"whyHot",{"_222":18,"_223":224,"_225":224,"_226":193,"_227":167},"developments",[215],"officialReports",[211,212],"timeline",[172,173,174,175,176],"heat",[65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98],"related",[],"topics",[48,49,50,51,52],{"_53":63,"_55":64},{"_53":61,"_55":62},{"_53":59,"_55":60},{"_53":57,"_55":58},{"_53":54,"_55":56},"slug","vuln-mgmt","name","漏洞管理","exploited","在野利用","qianxin","奇安信","research","技术研究","vuln","漏洞披露",{"_99":170,"_42":171,"_102":167},{"_99":168,"_42":169,"_102":167},{"_99":165,"_42":166,"_102":167},{"_99":162,"_42":163,"_102":164},{"_99":160,"_42":161,"_102":149},{"_99":158,"_42":159,"_102":149},{"_99":156,"_42":157,"_102":149},{"_99":154,"_42":155,"_102":149},{"_99":152,"_42":153,"_102":149},{"_99":150,"_42":151,"_102":149},{"_99":147,"_42":148,"_102":149},{"_99":145,"_42":146,"_102":18},{"_99":143,"_42":144,"_102":18},{"_99":141,"_42":142,"_102":18},{"_99":139,"_42"