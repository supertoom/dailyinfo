[{"_1":2,"_3":4},"root",{"_5":220},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794962454000,"publicId","f68801dc-89b9-4d34-bc78-9b79076922c4","title","Uber司机数据因第三方凭据失陷被窃","status","active","reportCount",3,"sourceCount","firstReportAt","2026-11-16T11:02:48.000Z","latestAt","2026-11-17T19:11:20.000Z","digest","Uber确认，攻击者于10月7日利用被攻陷的第三方AI基础设施服务商Fireworks的凭据，访问Uber账户并窃取149,346名司机共享至该服务商的数据；涉事凭据无法进入Uber其他系统，因此目前确认的影响限于Uber与Fireworks共享的数据。\n\n泄露内容包括司机姓名、家庭住址、出生日期、驾驶证号、驾驶证照片及政府签发身份证号。Uber于10月9日发现事件后断开与该服务商的数据连接并展开调查；虽已启用告警，但因攻击者使用有效凭据而未触发。Uber于11月10日通知受影响司机。Fireworks称，10月25日后未发现攻击者进一步成功未授权访问其面向客户的平台。","digestUpdatedAt","2026-11-17T20:25:01.365Z","summary","excerpt","latest","Fireworks AI 凭据泄露导致 Uber 近 149,346 名用户数据被窃","latestReport",{"_186":203},"whyHot",{"_215":18,"_216":142,"_217":119,"_218":206,"_219":148},"developments",[208],"officialReports",[],"timeline",[183,184,185],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","malware","name","恶意软件","paloalto","Palo Alto Networks","ai-agent","AI Agent 安全","identity","身份与访问","supply-chain","供应链安全","attack","攻击活动",{"_105":181,"_42":182,"_108":142},{"_105":179,"_42":180,"_108":142},{"_105":177,"_42":178,"_108":142},{"_105":175,"_42":176,"_108":142},{"_105":173,"_42":174,"_108":142},{"_105":171,"_42":172,"_108":142},{"_105":169,"_42":170,"_108":142},{"_105":167,"_42":168,"_108":142},{"_105":165,"_42":166,"_108":142},{"_105":163,"_42":164,"_108":142},{"_105":161,"_42":162,"_108":142},{"_105":159,"_42":160,"_108":142},{"_105":157,"_42":158,"_108":142},{"_105":155,"_42":156,"_108":142},{"_