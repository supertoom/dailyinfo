[{"_1":2,"_3":4},"root",{"_5":141},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1793667633000,"publicId","f8dc115a-c01e-495d-aa28-9f5907059932","title","欧洲逾115家超市制冷系统疑遭攻击","status","active","reportCount",3,"sourceCount","firstReportAt","2026-11-02T14:28:25.000Z","latestAt","2026-11-02T14:28:39.000Z","digest","未知攻击者通过互联网暴露的制冷控制接口，远程修改欧洲多国超市冷柜和制冷系统的温度设置、关闭制冷设备或持续启动除霜，已确认影响比利时、荷兰、瑞典、卢森堡、爱尔兰和爱沙尼亚逾115家门店，造成冷藏食品变质、报废及提前营业干预；目前无人认领，也无法确认各门店是否属于协调攻击。\n\nSabcobel负责人Stephan Moelans称，攻击者利用了与此前法国事件相同的漏洞；法国方面还称，攻击者获得了暴露在互联网上的控制系统登录凭据。Anssi指出，Danfoss、Copeland和Dixell制冷控制系统的互联网暴露管理接口存在可远程利用漏洞，许多受影响设备已停止支持且无补丁可用，完整修复除软件更新外还需物理改装。","digestUpdatedAt","2026-11-02T19:56:56.876Z","summary","excerpt","latest","欧洲多国逾115家超市制冷系统遭攻击，门店被迫处置变质商品","latestReport",{"_106":124},"whyHot",{"_135":81,"_136":101,"_137":81,"_138":122,"_139":140},"developments",[128],"officialReports",[],"timeline",[103,104,105],"heat",[65,66,67,68,69,70,71,72,73,74,75,76],"related",[],"topics",[48,49,50,51,52],{"_53":63,"_55":64},{"_53":61,"_55":62},{"_53":59,"_55":60},{"_53":57,"_55":58},{"_53":54,"_55":56},"slug","exploited","name","在野利用","industrial","工业控制","attack","攻击活动","iot","IoT 与车联网","supply-chain","供应链安全",{"_77":102,"_42":101,"_80":101},{"_77":100,"_42":101,"_80":101},{"_77":98,"_42":99,"_80":81},{"_77":96,"_42":97,"_80":81},{"_77":94,"_42":95,"_80":81},{"_77":92,"_42":93,"_80":81},{"_77":90,"_42":91,"_80":81},{"_77":88,"_42":89,"_80":81},{"_77":86,"_42":87,"_80":81},{"_77":84,"_42":85,"_80":81},{"_77":82,"_42":83,"_80":81},{"_77":78,"_42":79,"_80":81},"hour","2026-11-03T00:00:00.000Z",15.2,"participants",2,"2026-11-02T23:00:00.000Z",15.6,"2026-11-02T22:00:00.000Z",16.1,"2026-11-02T21:00:00.000Z",16.6,"2026-11-02T20:00:00.000Z",17.1,"2026-11-02T19:00:00.000Z",17.6,"2026-11-02T18:00:00.000Z",18.1,"2026-11-02T17:00:00.000Z",18.6,"2026-11-02T16:00:00.000Z",19.1,"2026-11-02T15:00:00.000Z",19.7,"2026-11-02T14:00:00.000Z",0,"2026-11-02T13:00:00.000Z",{"_106":124,"_13":31,"_28":125,"_110":126,"_112":23,"_114":122},{"_106":118,"_13":119,"_28":120,"_110":121,"_112":21,"_114":122},{"_106":107,"_13":108,"_28":109,"_110":111,"_112":113,"_114":115},"id","g62xqcwbxcbpfy5t0tl2vzvus","欧洲5国超市制冷系统遭网络攻击，冰箱温度被远程调至50°C","新一轮冰箱网络攻击影响比利时、卢森堡、瑞典和爱沙尼亚的超市制冷系统，另有荷兰Ahold上月向警方报告网络安全事件，但报道未确认两者相关。比利时和瑞典数十家门店出现异常升温，ICA、Coop及Colruyt旗下Spar共确认至少6家门店受影响，爱沙尼亚一家未具名超市的制冷设备也被设为50°C；法国此前遭袭时，温度最高达50°C，部分设备起火并造成食品损失。","source",{"_55":116,"_117":115},"publishedAt","2026-11-02T12:09:08.000Z","selected",false,"Security Affairs","firstParty","rnqinqt6srbee22b4h3qhhfn6","欧洲多国超市再遭制冷系统网络攻击，Belga、Carrefour 等门店冷藏食品受损","攻击者远程将比利时、卢森堡和瑞典部分超市制冷设备切换至除霜或升温模式，导致冷藏食品变质，其中 Ica 部分门店 freezer 温度被调至 50°C。Anssi 指出，Danfoss、Copeland 和 Dixell 制冷控制系统的互联网暴露管理接口存在可远程利用漏洞；不少设备已停止支持且无补丁可用。",{"_55":123,"_117":115},true,"Help Net Security","c8c3sczng53jdb0j9x5vqc0ry","攻击者远程修改欧洲多国超市冷柜和制冷系统的温度设置、关闭制冷设备或启动除霜，导致超过115家门店受到影响，并造成商品损失和提前营业干预。",{"_55":127,"_117":115},"BleepingComputer",{"_129":130,"_13":131,"_20":21,"_17":81,"_132":133},"factId","fZgkHH0BZWRg","多国超市制冷系统遭网络攻击","representative",{"_106":124,"_13":31,"_28":125,"_110":134,"_112":23,"_114":122},{"_55":127,"_117":115},"participants48h","newParticipants6h","recentReports24h","observationComplete","rank",6,{"_142":143,"_144":-5},"changelogVersion","2026-10-01T08:00","release"]
