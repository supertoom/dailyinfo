[{"_1":2,"_3":4},"root",{"_5":421},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794271240000,"publicId","12d9e017-9be0-4300-8768-9fc05ccfd8db","title","Crédit Mutuel Arkéa遭欺诈攻击","status","active","reportCount",7,"sourceCount","firstReportAt","2026-11-05T08:47:00.000Z","latestAt","2026-11-09T10:49:57.000Z","digest","法国银行 Crédit Mutuel Arkéa 确认遭外部网络攻击，攻击者经一家未具名服务供应商的平台进入其网络，并利用银行自有账户向其他金融机构发起欺诈转账。调查人员估算损失最高为1.18亿欧元（1.33亿美元），可能经专业平台兑换为USDC、USDT等稳定币；该行未确认具体金额，仅称损失数量级基本属实，最终损失仍在评估。\n\nArkéa称事件已受控，已启动安全措施并冻结部分资金，正追回其余资金并与执法部门合作。攻击未使用其联盟或子公司的客户账户，客户资产未受影响；该行也排除了内部人为失误，并否认网上子公司Fortuneo是入侵入口。","digestUpdatedAt","2026-11-09T11:25:56.824Z","summary","excerpt","latest","攻击者经供应商平台从 Crédit Mutuel Arkéa 窃取约€100 million","latestReport",{"_363":404},"whyHot",{"_415":173,"_416":417,"_418":290,"_419":371,"_420":252},"developments",[408],"officialReports",[],"timeline",[356,357,358,359,360,361,362],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130,131,132,133,134,135,136,137,138,139,140,141,142,143,144,145,146,147,148,149,150,151,152,153,154,155,156,157,158,159,160,161,162,163,164,165,166,167,168],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","email","name","邮件与钓鱼","supply-chain","供应链安全","black-market","数据窃取与黑产","ransomware","勒索软件","crypto","密码学","attack","攻击活动",{"_169":354,"_42":355,"_172":203},{"_169":352,"_42":353,"_172":203},{"_169":350,"_42":351,"_172":203},{"_169":348,"_42":349,"_172":203},{"_169":347,"_42":249,"_172":203},{"_169":345,"_42":346,"_172":203},{"_169":344,"_42":245,"_17