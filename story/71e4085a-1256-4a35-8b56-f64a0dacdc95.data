[{"_1":2,"_3":4},"root",{"_5":146},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794530497000,"publicId","71e4085a-1256-4a35-8b56-f64a0dacdc95","title","7-Zip LZX堆越界写入漏洞已复现","status","active","reportCount",3,"sourceCount","firstReportAt","2026-11-12T08:54:00.000Z","latestAt","2026-11-12T09:47:00.000Z","digest","奇安信CERT与微步在线研究响应中心均已复现7-Zip LZX解码器堆越界写入漏洞CVE-2026-125742，影响7-Zip 0<=version<26.06，CVSS 3.1评分为7.8；官方已发布补丁，需升级至7-Zip >= 26.06，目前暂无已知在野利用或确认受害规模。\n\n利用需诱导用户解压特制多卷CAB归档，且后续卷声明的LZX窗口大小小于前序卷；解码器须保持历史状态（keepHistory=true）且_pos未在窗口边界正确重置。奇安信CERT称该条件可触发内存破坏及任意代码执行；微步称其在官方7-Zip 26.05的Linux arm64目标上执行PoC，通过堆越界写劫持控制流实现任意代码执行。\n\n升级前应避免使用受影响版本的7-Zip解压不可信的多卷CAB归档，必要时仅在受控隔离环境中解压。","digestUpdatedAt","2026-11-12T14:34:56.643Z","summary","excerpt","latest","微步复现 7-Zip LZX 解码器远程代码执行漏洞 CVE-2026-125742","latestReport",{"_106":124},"whyHot",{"_139":18,"_140":141,"_142":18,"_143":114,"_144":145},"developments",[132],"officialReports",[128,129],"timeline",[103,104,105],"heat",[59,60,61,62,63,64,65,66,67,68,69,70,71,72],"related",[],"topics",[48,49,50],{"_51":57,"_53":58},{"_51":55,"_53":56},{"_51":52,"_53":54},"slug","research","name","技术研究","qianxin","奇安信","vuln","漏洞披露",{"_73":101,"_42":102,"_76":18},{"_73":99,"_42":100,"_76":18},{"_73":97,"_42":98,"_76":18},{"_73":95,"_42":96,"_76":18},{"_73":93,"_42":94,"_76":18},{"_73":91,"_42":92,"_76":18},{"_73":89,"_42":90,"_76":18},{"_73":87,"_42":88,"_76":18},{"_73":85,"_42":86,"_76":18},{"_73":83,"_42":84,"_76":18},{"_73":81,"_42":82,"_76":18},{"_73":79,"_42":80,"_76":18},{"_73":77,"_42":78,"_76":18},{"_73":74,"_42":75,"_76":18},"hour","2026-11-13T00:00:00.000Z",19.7,"participants","2026-11-12T23:00:00.000Z",20.3,"2026-11-12T22:00:00.000Z",20.9,"2026-11-12T21:00:00.000Z",21.5,"2026-11-12T20:00:00.000Z",22.1,"2026-11-12T19:00:00.000Z",22.8,