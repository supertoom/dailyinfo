[{"_1":2,"_3":4},"root",{"_5":373},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795480851000,"publicId","aae0b52f-d7e1-4731-a260-ac5ba36ea7ba","title","Signal限制系统AI读取聊天内容","status","active","reportCount",6,"sourceCount","firstReportAt","2026-11-20T13:59:32.000Z","latestAt","2026-11-23T15:00:00.000Z","digest","Signal已发布并默认启用防护措施，在iOS 27上限制截图，在受支持的Android设备上检测到AI助手读取Signal屏幕时自动开启Screen Security，以阻止Siri、Gemini等系统内置代理抓取聊天内容；具体应用版本号尚未公布。\n\nSignal称该措施并不完整，无法阻止代理通过文件系统获取设备上已保存的应用内容，此前Android代理还曾滥用推送通知权限读取消息。用户可在设置中关闭截图限制，但这会暴露自己及联系人的消息给相关代理。\n\nmacOS 27目前没有同等保护，Signal建议将Signal加入“系统设置 > Siri”的Excluded Apps列表，阻止Siri AI主动读取消息。","digestUpdatedAt","2026-11-23T15:38:26.925Z","summary","excerpt","latest","Signal 出手阻止 iOS 与 Android 系统内置 AI 助手读取聊天内容","latestReport",{"_315":350},"whyHot",{"_366":153,"_367":368,"_369":208,"_370":371,"_372":153},"developments",[354,355],"officialReports",[],"timeline",[309,310,311,312,313,314],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130,131,132,133,134,135,136,137,138,139,140,141,142,143,144,145,146,147,148],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","ai-agent","name","AI Agent 安全","blue-team","蓝队与运营","mobile","移动端","apple","Apple / 苹果","google","Google / 谷歌","ai-security","AI 安全",{"_149":307,"_42":308,"_152":215},{"_149":305,"_42":306,"_152":215},{"_149":303,"_42":304,"_152":215},{"_149":301,"_42":302,"_152":215},{"_149":299,"_42":300,"_152":215},{"_149":297,"_42":298,"_152":215},{"_149":296,"_42":227,"_152":215},{"_149":294,"_42":295,"_152":2