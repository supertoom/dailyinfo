[{"_1":2,"_3":4},"root",{"_5":293},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795394447000,"publicId","aae0b52f-d7e1-4731-a260-ac5ba36ea7ba","title","Signal默认限制AI读取聊天屏幕","status","active","reportCount",4,"sourceCount","firstReportAt","2026-11-20T13:59:32.000Z","latestAt","2026-11-22T18:01:22.000Z","digest","Signal已发布并默认启用防护：在iOS 27上限制截图，在受支持的Android设备上检测到AI助手读取Signal屏幕时自动启用Screen Security，阻止Siri、Gemini等系统级AI代理抓取聊天；Signal未公布具体应用版本号。\n\nSignal称该措施并不完整，无法阻止代理通过文件系统获取设备上已保存的应用内容，此前Android代理还曾滥用推送通知权限读取消息。用户可在设置中关闭截图限制，但会暴露自己及联系人的消息给相关代理。macOS 27目前没有同等保护，Signal建议将Signal加入“系统设置 > Siri”的Excluded Apps列表，阻止Siri AI主动读取消息。","digestUpdatedAt","2026-11-22T18:17:37.967Z","summary","excerpt","latest","Signal 限制 iOS 27 与 Android 上的 OS 级 AI Agent 读取屏幕","latestReport",{"_247":270},"whyHot",{"_286":129,"_287":288,"_289":142,"_290":291,"_292":149},"developments",[274,275],"officialReports",[],"timeline",[243,244,245,246],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","ai-agent","name","AI Agent 安全","mobile","移动端","blue-team","蓝队与运营","apple","Apple / 苹果","google","Google / 谷歌","ai-security","AI 安全",{"_125":241,"_42":242,"_128":149},{"_125":239,"_42":240,"_128":149},{"_125":237,"_42":238,"_128":149},{"_125":235,"_42":236,"_128":149},{"_125":233,"_42":234,"_128":149},{"_125":231,"_42":232,"_128":149},{"_125":230,"_42":161,"_128":149},{"_125":228,"_42":229,"_128":149},{"_125":226,"_42":227,"_128":149},{"_125":224,"_42":225,"_128":149},{"_125":222,"_42":223,"_128":1