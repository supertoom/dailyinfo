[{"_1":2,"_3":4},"root",{"_5":145},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795394447000,"publicId","4ad45bf6-7f5a-435f-9180-fb609f25b68d","title","Ghostscript沙箱逃逸漏洞已复现并修复","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-22T04:43:00.000Z","latestAt","2026-11-22T05:03:41.000Z","digest","奇安信CERT已复现pwn.ai公开的Ghostscript沙箱绕过远程代码执行漏洞CVE-2026-125396，CVSS 4.0评分为8.5；受影响版本为Ghostscript 10.08.0之前版本。恶意PostScript/PDF在字体加载阶段利用use-after-free关闭-dSAFER检查，可使Ghostscript以低权限账户执行命令。\n\n该漏洞虽被归类为本地漏洞，但打印任务、邮件和网页上传均可将恶意文件送入Ghostscript；所有在-dSAFER模式下处理不受信任PostScript/PDF的部署均受影响，pwn.ai称约十款常见应用的上传、预览或打印功能可能被诱导触发。\n\nArtifex已于9月8日在Ghostscript 10.08.0中修复，并将易受攻击的内部步骤迁移至更安全代码。应用侧修复与Ghostscript修复覆盖同一利用链的不同环节，单独更新其一不能消除风险；目前没有发现该漏洞被用于攻击的报告。","digestUpdatedAt","2026-11-22T10:03:37.712Z","summary","excerpt","latest","Ghostscript 沙箱逃逸 RCE CVE-2026-125396 可经文件上传触发","latestReport",{"_114":125},"whyHot",{"_139":18,"_140":141,"_142":18,"_143":122,"_144":18},"developments",[132],"officialReports",[130],"timeline",[112,113],"heat",[56,57,58,59,60,61,62,63,64,65,66,67,68,69,70,71,72,73],"related",[],"topics",[48,49],{"_50":54,"_52":55},{"_50":51,"_52":53},"slug","research","name","技术研究","vuln","漏洞披露",{"_74":110,"_42":111,"_77":18},{"_74":108,"_42":109,"_77":18},{"_74":106,"_42":107,"_77":18},{"_74":104,"_42":105,"_77":18},{"_74":102,"_42":103,"_77":18},{"_74":100,"_42":101,"_77":18},{"_74":98,"_42":99,"_77":18},{"_74":96,"_42":97,"_77":18},{"_74":94,"_42":95,"_77":18},{"_74":92,"_42":93,"_77":18},{"_74":90,"_42":91,"_77":18},{"_74":88,"_42":89,"_77":18},{"_74":86,"_42":87,"_77":18},{"_74":84,"_42":85,"_77":18},{"_74":82,"_42":83,"_77":18},{"_74":80,"_42":81,"_77":18},{"_74":78,"_42":79,"_77":18},{"_74":75,"_42":76,"_77":18},"hour","2026-11-23T00:00:00.000Z",11.5,"participants","2026-11-22T23:00:00.000Z",11.9,"2026-11-22T22:00:00.000Z",12.2,"2026-11-22T21:00:00.000Z",12.6,"2026-11-22T20:00:00.000Z",12.9,"2026-11-22T19:00:00.000Z",13.3,"2026-11-22T18:00:00.000Z",13.7,"2026-11-22T17:00:00.000Z",14.1,"2026-11-22T16:00:00.000Z",14.5,"2026-11-22T15:00:00.000Z",14.9,"2026-11-22T14:00:00.000Z",15.4,"2026-11-22T13:00:00.000Z",15.8,"2026-11-22T12:00:00.000Z",16.3,"2026-11-22T11:00:00.000Z",16.8,"2026-11-22T10:00:00.000Z",17.3,"2026-11-22T09:00:00.000Z",17.8,"2026-11-22T08:00:00.000Z",18.3,"2026-11-22T07:00:00.000Z",18.8,{"_114":125,"_13":31,"_28":126,"_118":127,"_120":23,"_121":122},{"_114":115,"_13":116,"_28":117,"_118":119,"_120":21,"_121":122},"id","s68hl88mb77wpvsqsv9cuf6as","Artifex Ghostscript -dSAFER 沙箱绕过漏洞 CVE-2026-125396 已复现","Artifex Ghostscript < 10.08.0 的 -dSAFER 沙箱绕过漏洞 CVE-2026-125396 已被奇安信 CERT 复现，CVSS 4.0 分数为 8.5。","source",{"_52":123,"_124":122},"publishedAt","selected",true,"奇安信 CERT","firstParty","tynuth71urn9723wgga79pff3","pwn.ai 演示了 Ghostscript 沙箱逃逸 RCE CVE-2026-125396，恶意文档可利用字体加载部分的 use-after-free 关闭 -dSAFER 检查并以低权限账户在服务器执行命令。",{"_52":128,"_124":129},"The Hacker News",false,{"_114":115,"_13":116,"_28":117,"_118":131,"_120":21,"_121":122},{"_52":123,"_124":122},{"_133":134,"_13":135,"_20":21,"_17":18,"_136":137},"factId","fcigjEufIvHg","公开复现Ghostscript沙箱逃逸漏洞","representative",{"_114":115,"_13":116,"_28":117,"_118":138,"_120":21,"_121":122},{"_52":123,"_124":122},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",{"_146":147,"_148":-5},"changelogVersion","2026-10-01T08:00","release"]
