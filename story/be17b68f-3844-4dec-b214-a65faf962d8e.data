[{"_1":2,"_3":4},"root",{"_5":133},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795567297000,"publicId","be17b68f-3844-4dec-b214-a65faf962d8e","title","伊朗关联组织以医疗钓鱼攻击沙特","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-24T14:13:55.000Z","latestAt","2026-11-24T16:54:07.000Z","digest","Check Point Research 披露，伊朗关联组织 Volant Manticore 自2025年8月末起针对塞浦路斯电信公司、航空公司及关键基础设施开展间谍活动，并于2026年9月转向沙特医疗目标；目前未见受害数量、数据泄露或系统破坏获确认。\n\n该组织通过虚假简历及医疗研讨会主题的 ZIP 档案投放 KuboShell 后门和 N-able RMM。KuboShell 使用 IPFS 进行命令与控制，并以首个网络适配器的 MAC 地址标识受害者；入侵后部署基于 MuddyC2Go 客户端重实现的 Homa Framework，用于侦察和后续控制。","digestUpdatedAt","2026-11-24T18:22:57.477Z","summary","excerpt","latest","Iran 关联组织 Volant Manticore 使用 KuboShell 后门开展塞浦路斯等目标间谍活动","latestReport",{"_103":115},"whyHot",{"_126":18,"_127":128,"_129":18,"_130":111,"_131":132},"developments",[119],"officialReports",[],"timeline",[101,102],"heat",[68,69,70,71,72,73,74,75,76,77],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","ransomware","name","勒索软件","checkpoint","Check Point","malware","恶意软件","attack","攻击活动","email","邮件与钓鱼","identity","身份与访问",{"_78":99,"_42":100,"_81":98},{"_78":96,"_42":97,"_81":98},{"_78":94,"_42":95,"_81":18},{"_78":92,"_42":93,"_81":18},{"_78":90,"_42":91,"_81":18},{"_78":88,"_42":89,"_81":18},{"_78":86,"_42":87,"_81":18},{"_78":84,"_42":85,"_81":18},{"_78":82,"_42":83,"_81":18},{"_78":79,"_42":80,"_81":18},"hour","2026-11-25T00:00:00.000Z",15.7,"participants","2026-11-24T23:00:00.000Z",16.1,"2026-11-24T22:00:00.000Z",16.6,"2026-11-24T21:00:00.000Z",17.1,"2026-11-24T20:00:00.000Z",17.6,"2026-11-24T19:00:00.000Z",18.1,"2026-11-24T18:00:00.000Z",18.7,"2026-11-24T17:00:00.000Z",19.2,"2026-11-24T16