[{"_1":2,"_3":4},"root",{"_5":139},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794962454000,"publicId","f1b7273c-b32b-4cc9-ad3f-0ca67686bbfe","title","Apple 拆分并收紧 macOS 27.3 应用权限以限制 AI Agent 数据访问","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-17T09:41:58.000Z","latestAt","2026-11-17T11:07:31.000Z","digest","Apple 在 macOS 27.3 beta 2 中预览更细粒度的应用权限控制：把 Device Control and Data Access 拆为 System & App Protection Override 与 Accessibility，并为 Full Disk Access 增加透明度，用户可限制应用访问的具体应用或文件夹、查看数据访问范围、要求每次授权，以及查看应用间的控制关系。Apple 称，能力更强、更自主的 AI Agent 会加剧相关数据暴露风险。\n\n这些变化只适用于新的权限请求，用户此前已授予的应用权限仍然有效。使用 Full Disk Access 的磁盘备份应用和使用 Accessibility 的辅助技术应用，可为新安装申请 entitlement 以保留 macOS 27.3 之前的行为。Apple 同时提醒开发者调整引导流程，以处理通过这些 API 仅获得部分文件夹或应用访问权限的情况。","digestUpdatedAt","2026-11-17T12:13:04.345Z","summary","excerpt","latest","Apple 在 macOS 27.3 beta 2 中收紧应用权限，以降低 AI Agent 数据访问风险","latestReport",{"_109":120},"whyHot",{"_131":18,"_132":133,"_134":18,"_135":136,"_137":138},"developments",[124],"officialReports",[],"timeline",[107,108],"heat",[62,63,64,65,66,67,68,69,70,71,72,73,74,75],"related",[],"topics",[48,49,50,51],{"_52":60,"_54":61},{"_52":58,"_54":59},{"_52":56,"_54":57},{"_52":53,"_54":55},"slug","blue-team","name","蓝队与运营","ai-agent","AI Agent 安全","ai-security","AI 安全","apple","Apple / 苹果",{"_76":104,"_42":105,"_79":106},{"_76":102,"_42":103,"_79":18},{"_76":100,"_42":101,"_79":18},{"_76":98,"_42":99,"_79":18},{"_76":96,"_42":97,"_79":18},{"_76":94,"_42":95,"_79":18},{"_76":92,"_42":93,"_79":18},{"_76":90,"_42":91,"_79":18},{"_76":88,"_42":89,"_79":18},{"_76":86,"_42":87,"_79":18},{"_76":84,"_42":85,"_79":18},{"_76":82,"_42":83,"_79":18},{"_76":80,"_42":81,"_79":18},{"_76":77,"_42":78,"_79":18},"hour","2026-11-18T00:00:00.000Z",13.5,"participants","2026-11-17T23:00:00.000Z",13.9,"2026-11-17T22:00:00.000Z",14.3,"2026-11-17T21:00:00.000Z",14.7,"2026-11-17T20:00:00.000Z",15.2,"2026-11-17T19:00:00.000Z",15.6,"2026-11-17T18:00:00.000Z",16.1,"2026-11-17T17:00:00.000Z",16.5,"2026-11-17T16:00:00.000Z",17,"2026-11-17T15:00:00.000Z",17.5,"2026-11-17T14:00:00.000Z",18,"2026-11-17T13:00:00.000Z",18.6,"2026-11-17T12:00:00.000Z",19.1,"2026-11-17T11:00:00.000Z",9.6,1,{"_109":120,"_13":31,"_28":121,"_113":122,"_115":23,"_116":117},{"_109":110,"_13":111,"_28":112,"_113":114,"_115":21,"_116":117},"id","brh19ielj7c75biprgikwl5nu","Apple 在 macOS 27.3 beta 2 拆分并收紧 Mac 应用权限","Apple 在 macOS 27.3 beta 2 中将 Device Control and Data Access 拆分为 System & App Protection Override 与 Accessibility，并加强权限透明度和访问提示，以应对自主 AI Agent 扩大文件、邮件、消息及浏览历史暴露风险。","source",{"_54":118,"_119":117},"publishedAt","selected",false,"Help Net Security","firstParty","fue32bswimkh9ryj36hic6d4g","Apple 在 macOS 27.3 beta 2 中预览更细粒度的应用权限控制，允许用户限制 Device Control and Data Access、Full Disk Access 涉及的具体应用或文件夹，并查看数据访问范围、要求每次授权及查看应用间控制关系。",{"_54":123,"_119":117},"The Hacker News",{"_125":126,"_13":127,"_20":21,"_17":18,"_128":129},"factId","fFqoa74dx7Ps","macOS 拆分应用权限控制","representative",{"_109":110,"_13":111,"_28":112,"_113":130,"_115":21,"_116":117},{"_54":118,"_119":117},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete",true,"rank",9,{"_140":141,"_142":-5},"changelogVersion","2026-10-01T08:00","release"]
