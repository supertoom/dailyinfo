[{"_1":2,"_3":4},"root",{"_5":129},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794357648000,"publicId","6191e404-8a4a-4cfa-8824-41c53f1a9398","title","CISA升级事件报告表关联攻击活动","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-10T13:17:50.000Z","latestAt","2026-11-10T17:00:00.000Z","digest","美国网络安全和基础设施安全局（CISA）推出新版网络事件报告表，以更具体、去重的问题和 MITRE ATT&CK 术语记录恶意软件、社会工程、入侵手法及内部威胁，帮助分析人员关联不同机构的事件并识别同一攻击活动；目前未确认该措施对应具体攻击或受害范围。\n\n现阶段仅联邦文职机构须按适用要求及期限报告，其他组织可自愿提交，资料可获得 PCII Program 披露保护。提交恶意代码文件须先提交事件报告，再凭 CISA 事件编号通过独立恶意软件分析表关联。CIRCIA 最终规则仍在白宫审查中；据 CISA 称，生效后符合条件的关键基础设施组织须在合理确信事件发生后72小时内报告，并在支付赎金后24小时内报告。","digestUpdatedAt","2026-11-10T17:54:00.390Z","summary","excerpt","latest","CISA 升级网络事件报告表单，CIRCIA 最终规则仍待 White House 批准","latestReport",{"_99":110},"whyHot",{"_121":18,"_122":123,"_124":18,"_125":126,"_127":128},"developments",[114],"officialReports",[],"timeline",[97,98],"heat",[62,63,64,65,66,67,68,69,70,71,72],"related",[],"topics",[48,49,50,51],{"_52":60,"_54":61},{"_52":58,"_54":59},{"_52":56,"_54":57},{"_52":53,"_54":55},"slug","policy","name","政策法规","blue-team","蓝队与运营","incident","应急响应","cisa","CISA",{"_73":95,"_42":96,"_76":92},{"_73":93,"_42":94,"_76":92},{"_73":90,"_42":91,"_76":92},{"_73":23,"_42":89,"_76":18},{"_73":87,"_42":88,"_76":18},{"_73":85,"_42":86,"_76":18},{"_73":83,"_42":84,"_76":18},{"_73":81,"_42":82,"_76":18},{"_73":79,"_42":80,"_76":18},{"_73":77,"_42":78,"_76":18},{"_73":74,"_42":75,"_76":18},"hour","2026-11-11T00:00:00.000Z",15.5,"participants","2026-11-10T23:00:00.000Z",16,"2026-11-10T22:00:00.000Z",16.4,"2026-11-10T21:00:00.000Z",16.9,"2026-11-10T20:00:00.000Z",17.4,"2026-11-10T19:00:00.000Z",17.9,"2026-11-10T18:00:00.000Z",18.4,19,"2026-11-10T16:00:00.000Z",9.2,1,"2026-11-10T15:00:00.000Z",9.5,"2026-11-10T14:00:00.000Z",9.8,{"_99":110,"_13":31,"_28":111,"_103":112,"_105":23,"_106":107},{"_99":100,"_13":101,"_28":102,"_103":104,"_105":21,"_106":107},"id","flbf4jl6hkyrr15wagrn34qw2","CISA 更新网络安全事件报告表以识别关联攻击活动","CISA 更新在线网络安全事件报告表，通过更具体且去重的问卷及 MITRE ATT&CK 术语，收集恶意软件、欺骗尝试、入侵手法和内部威胁信息，以便关联不同机构的事件、识别正在形成的攻击活动并预警潜在目标。","source",{"_54":108,"_109":107},"publishedAt","selected",false,"Help Net Security","firstParty","hfw08jn6lt015z6ccxz8kl5zb","CISA 推出新版网络事件报告表单，细化恶意软件、社会工程、黑客手法和内部威胁等问题，并以 MITRE ATT&CK 描述观察到的活动。目前仅联邦文职机构必须报告，其他组织可自愿提交，资料可获 PCII Program 披露保护。CIRCIA 最终规则仍在 White House 审查中，生效后符合条件的关键基础设施组织须在合理确信事件发生后 72 小时内报告，并在支付赎金后 24 小时内报告。",{"_54":113,"_109":107},"Infosecurity Magazine",{"_115":116,"_13":117,"_20":21,"_17":18,"_118":119},"factId","f36OVvLjfhqo","CISA更新网络事件报告表单","representative",{"_99":100,"_13":101,"_28":102,"_103":120,"_105":21,"_106":107},{"_54":108,"_109":107},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete",true,"rank",10,{"_130":131,"_132":-5},"changelogVersion","2026-10-01T08:00","release"]
