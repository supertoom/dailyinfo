[{"_1":2,"_3":4},"root",{"_5":300},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795826460000,"publicId","bb557fad-4614-4000-8e00-bc153b15ba76","title","1Password 披露员工 GitHub 账号被攻破，部分客户账户数据外泄","status","watching","reportCount",8,"sourceCount","firstReportAt","2026-11-25T21:19:49.000Z","latestAt","2026-11-26T09:42:47.000Z","digest","1Password 披露，攻击者自 2026 年 11 月 19 日起接管一名员工的企业 GitHub 账号，访问私有仓库并进入 CI/CD 系统，向后端服务推送恶意代码，下载了部分用户的行政记录并复制内部源码；被取走的数据包括姓名、登录邮箱、账户与用户标识符、公钥、SSO/认证参数、创建及最后登录时间、账户活动时间、非机密元数据，以及用户邀请、开通和账号找回邮件中的令牌。\n\n公司称受影响的是“一小部分”用户并已逐一通知，具体人数及是否涉及个人、商业或家庭账户均未公开；客户保险库内容（含密码等机密）、账户恢复密钥及其加密密钥始终未被攻击者访问或可用，内部源码不含客户机密，且未发现泄露令牌被用于接管账户，因此客户无需更改账户设置，但需警惕冒充公司的钓鱼与诈骗（如意外的邀请或找回请求）。\n\n补救措施包括停用涉事 GitHub 账号、撤销被盗令牌、强化 GitHub 与 CI/CD 及终端控制、恢复受影响服务的干净版本、轮换内部凭据，并将验证码由六位数字加强为十位字母数字组合。","digestUpdatedAt","2026-11-26T10:41:54.040Z","summary","excerpt","latest","1Password 披露攻击者经员工 GitHub 账号窃取部分客户账户数据","latestReport",{"_229":277},"whyHot",{"_294":117,"_295":296,"_297":296,"_298":245,"_299":198},"developments",[281,282],"officialReports",[],"timeline",[221,222,223,224,225,226,227,228],"heat",[62,63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112],"related",[],"topics",[48,49,50,51],{"_52":60,"_54":61},{"_52":58,"_54":59},{"_52":56,"_54":57},{"_52":53,"_54":55},"slug","red-team","name","红队与渗透","identity","身份与访问","attack","攻击活动","supply-chain","供应链安全",{"_113":219,"_42":220,"_116":208},{"_113":217,"_42":218,"_116":208},{"_113":215,"_42":216,"_116":208},{"_113":213,"_42":214,"_116":208},{"_113":211,"_42":212,"_116":208},{"_113":209,"_42":210,"_116":208},{"_113":206,"_42":207,"_116":208},{"_113":204,"_42":205,"_116":201},{"_113":202,"_42":203,"_116":201},{"_113":199,"_42":200,"_1