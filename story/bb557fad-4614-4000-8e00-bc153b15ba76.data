[{"_1":2,"_3":4},"root",{"_5":110},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795653657000,"publicId","bb557fad-4614-4000-8e00-bc153b15ba76","title","1Password披露员工账号被攻破致客户数据外泄","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-25T21:19:49.000Z","latestAt","2026-11-25T21:33:33.000Z","digest","1Password披露，一名员工的企业GitHub账号被攻破，攻击者借此访问私有源码仓库、向公司后端服务注入恶意代码，下载部分客户账户记录及内部源码；公司称仅少量用户受影响，已逐一通知，但未披露具体数量。\n\n被复制的数据包括客户姓名、登录邮箱、账户与用户ID、创建及最后登录时间、公钥和账户元数据。1Password表示，客户密码保险库、其中保存的密码及保护保险库的加密密钥均未遭访问，私有源码不含客户秘密，也未发现泄露令牌被用于接管账户；作为防范暴力破解的预防措施，验证代码已由六位数字改为十位字母数字组合。","digestUpdatedAt","2026-11-25T22:21:52.816Z","summary","excerpt","latest","1Password 员工 GitHub 账号遭入侵，攻击者窃取客户数据","latestReport",{"_75":86},"whyHot",{"_104":18,"_105":18,"_106":18,"_107":89,"_108":109},"developments",[91,92],"officialReports",[],"timeline",[73,74],"heat",[62,63,64],"related",[],"topics",[48,49,50,51],{"_52":60,"_54":61},{"_52":58,"_54":59},{"_52":56,"_54":57},{"_52":53,"_54":55},"slug","red-team","name","红队与渗透","attack","攻击活动","identity","身份与访问","supply-chain","供应链安全",{"_65":71,"_42":72,"_68":18},{"_65":69,"_42":70,"_68":18},{"_65":66,"_42":67,"_68":18},"hour","2026-11-26T00:00:00.000Z",18.6,"participants","2026-11-25T23:00:00.000Z",19.1,"2026-11-25T22:00:00.000Z",19.7,{"_75":86,"_13":31,"_28":87,"_79":88,"_81":23,"_82":89},{"_75":76,"_13":77,"_28":78,"_79":80,"_81":21,"_82":83},"id","fl87knzyahqtv4qern9fg60cf","1Password 称攻击者复制部分客户账户数据，客户保险库未受影响","1Password 称，攻击者利用一名员工的 GitHub 账号向内部服务推送恶意代码，复制了部分客户的姓名、登录邮箱、账户与用户 ID、创建及最后登录时间、公钥和账户元数据，并从私有仓库获取源代码。","source",{"_54":84,"_85":83},"publishedAt","selected",false,"Hackread","firstParty","vhwe2fax4m9ymu05rbldf674y","1Password 披露，一名员工的 corporate GitHub 账号被攻破后，攻击者访问私有源码仓库并向后端服务注入恶意代码，下载客户账户记录及内部源码。",{"_54":90,"_85":83},true,"BleepingComputer"