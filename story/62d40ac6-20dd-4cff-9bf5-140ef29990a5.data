[{"_1":2,"_3":4},"root",{"_5":142},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794962454000,"publicId","62d40ac6-20dd-4cff-9bf5-140ef29990a5","title","8-Digits勒索团伙成员被引渡美国受审","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-17T07:25:44.000Z","latestAt","2026-11-17T13:42:04.000Z","digest","美国司法部称，已将43岁哈萨克斯坦国民Roman Khlynovskiy从意大利引渡至美国并提起指控，检方认为他参与了与INC和Lynx勒索行动有关联的“8-Digits Team”。案件尚未判决，被控罪名包括共谋实施计算机欺诈和身份盗窃、共谋实施电汇欺诈、计算机敲诈勒索、共谋洗钱及威胁散布未经同意的私密影像，最高可判27年监禁。\n\n检方称，Khlynovskiy与同伙入侵美国至少六个州的学校、医院和医疗机构网络，窃取敏感数据并实施勒索，累计赎金要求超过5亿美元；上述团伙归属、攻击范围和金额均属指控主张。后续报道进一步称，该团伙曾威胁公开患者医疗信息。","digestUpdatedAt","2026-11-17T13:47:08.734Z","summary","excerpt","latest","“8-Digits Team”勒索团伙嫌犯被引渡至美国，敲诈金额超 $500 million","latestReport",{"_112":123},"whyHot",{"_134":18,"_135":136,"_137":18,"_138":139,"_140":141},"developments",[127],"officialReports",[],"timeline",[110,111],"heat",[62,63,64,65,66,67,68,69,70,71,72,73,74,75,76],"related",[],"topics",[48,49,50,51],{"_52":60,"_54":61},{"_52":58,"_54":59},{"_52":56,"_54":57},{"_52":53,"_54":55},"slug","malware","name","恶意软件","exploited","在野利用","attack","攻击活动","ransomware","勒索软件",{"_77":108,"_42":109,"_80":103},{"_77":106,"_42":107,"_80":103},{"_77":104,"_42":105,"_80":103},{"_77":101,"_42":102,"_80":103},{"_77":99,"_42":100,"_80":18},{"_77":97,"_42":98,"_80":18},{"_77":95,"_42":96,"_80":18},{"_77":93,"_42":94,"_80":18},{"_77":91,"_42":92,"_80":18},{"_77":89,"_42":90,"_80":18},{"_77":87,"_42":88,"_80":18},{"_77":85,"_42":86,"_80":18},{"_77":83,"_42":84,"_80":18},{"_77":81,"_42":82,"_80":18},{"_77":78,"_42":79,"_80":18},"hour","2026-11-18T00:00:00.000Z",13.6,"participants","2026-11-17T23:00:00.000Z",14,"2026-11-17T22:00:00.000Z",14.4,"2026-11-17T21:00:00.000Z",14.9,"2026-11-17T20:00:00.000Z",15.3,"2026-11-17T19:00:00.000Z",15.7,"20