[{"_1":2,"_3":4},"root",{"_5":628},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":-5,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48},"expiresAt",1795221647000,"publicId","8540cb70-bd3c-4700-8134-83f02bb49280","title","Java4Shell出现利用尝试，Metabase确认受影响","status","watching","reportCount",35,"sourceCount",25,"firstReportAt","2026-11-17T12:00:00.000Z","latestAt","2026-11-20T00:00:00.000Z","digest","Calif披露的OpenJDK Base64解码器堆越界写漏洞Java4Shell（CVE-2026-114938）已出现扫描和利用尝试；GreyNoise记录超过150次符合攻击特征的请求，但未观察到成功入侵，也无法确认目标是否已被攻陷，目前仅能确认利用尝试。漏洞类型为内存破坏，可能导致拒绝服务或远程代码执行，CVSS 4.0 9.2、Oracle CVSS 3.1 8.1。\n\nOracle和OpenJDK已修复；Red Hat仍未为RHEL 8、9、10及OpenJDK 17、21、25构建发布修复。Elasticsearch 7.17.3及以上版本、Logstash 8.6.2及以上版本被确认存在风险；CERT-FR还披露Metabase Docker 58.x低于58.42、64.x低于64.8、65.x低于65.6受影响。\n\n利用须同时具备OpenJDK 17.0.6及以上受影响版本、支持AVX-512 VBMI等指令集的x86-64处理器，以及处理攻击者可控Base64数据的应用；ARM64和i386不受影响。各产品仍需定制利用链。无法立即更新时，可用-XX:-UseBASE64Intrinsics或-XX:UseAVX=2关闭相关加速路径。","digestUpdatedAt","2026-11-20T15:10:17.566Z","summary","excerpt","latest","Metabase 远程代码执行漏洞 CVE-2026-114938 影响 58.x、64.x 和 65.x 版本","latestReport",{"_359":547},"whyHot",{"_622":154,"_623":624,"_625":624,"_626":367,"_627":183},"developments",[574,575,576,577,578,579,580,581,582],"officialReports",[556,557,558,559,560,561,562,563,564],"timeline",[324,325,326,327,328,329,330,331,332,333,334,335,336,337,338,339,340,341,342,343,344,345,346,347,348,349,350,351,352,353,354,355,356,357,358],"heat",[73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130,131,132,133,134,135,136,137,138,139,140,141,142,143,144,145,146,147,148,149],"related",[69],"topics",[49,50,51,52,53,54],{"_55":67,"_57":68},{"_55":65,"_57":66},{"_55":63,"_57":64},{"_55":61,"_57":62},{"_55":59,"_57":60},{