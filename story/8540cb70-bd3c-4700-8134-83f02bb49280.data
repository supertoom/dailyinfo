":439,"_284":167,"_285":294},{"_278":431,"_13":432,"_29":433,"_282":434,"_284":435,"_285":286},{"_278":427,"_13":428,"_29":429,"_282":430,"_284":179,"_285":294},{"_278":423,"_13":424,"_29":425,"_282":426,"_284":179,"_285":294},{"_278":417,"_13":418,"_29":419,"_282":420,"_284":421,"_285":286},{"_278":411,"_13":412,"_29":413,"_282":414,"_284":415,"_285":286},{"_278":405,"_13":406,"_29":407,"_282":408,"_284":409,"_285":294},{"_278":399,"_13":400,"_29":401,"_282":402,"_284":403,"_285":286},{"_278":393,"_13":394,"_29":395,"_282":396,"_284":397,"_285":286},{"_278":387,"_13":388,"_29":389,"_282":390,"_284":391,"_285":286},{"_278":382,"_13":383,"_29":384,"_282":385,"_284":386,"_285":286},{"_278":377,"_13":378,"_29":379,"_282":380,"_284":214,"_285":286},{"_278":371,"_13":372,"_29":373,"_282":374,"_284":375,"_285":286},{"_278":366,"_13":367,"_29":368,"_282":369,"_284":370,"_285":286},{"_278":360,"_13":361,"_29":362,"_282":363,"_284":364,"_285":286},{"_278":354,"_13":355,"_29":356,"_282":357,"_284":358,"_285":286},{"_278":348,"_13":349,"_29":350,"_282":351,"_284":352,"_285":286},{"_278":342,"_13":343,"_29":344,"_282":345,"_284":346,"_285":286},{"_278":336,"_13":337,"_29":338,"_282":339,"_284":340,"_285":286},{"_278":330,"_13":331,"_29":332,"_282":333,"_284":334,"_285":286},{"_278":324,"_13":325,"_29":326,"_282":327,"_284":328,"_285":286},{"_278":318,"_13":319,"_29":320,"_282":321,"_284":322,"_285":294},{"_278":313,"_13":314,"_29":315,"_282":316,"_284":236,"_285":286},{"_278":308,"_13":309,"_29":310,"_282":311,"_284":236,"_285":294},{"_278":302,"_13":303,"_29":304,"_282":305,"_284":306,"_285":286},{"_278":296,"_13":297,"_29":298,"_282":299,"_284":300,"_285":294},{"_278":289,"_13":290,"_29":291,"_282":292,"_284":293,"_285":294},{"_278":279,"_13":280,"_29":281,"_282":283,"_284":22,"_285":286},"id","rqea4z2nhncrkf2s1jvtvp067","Oracle Java Base64 解码器漏洞 CVE-2026-114938 存在未认证 RCE，CISA 要求立即修补","Oracle Java 的 Base64 解码器存在内存损坏漏洞 CVE-2026-114938，可由特制 Base64 输入触发 JVM 崩溃，并在无需认证的条件下实现远程代码执行。","source",{"_57":287,"_288":286},"publishedAt","selected",true,"CISA 安全公告","firstParty","hj7uwdt1znnojxhgt383nvyg7","Oracle 将修复 11 个 Java SE 漏洞，CVE-2026-114938 OpenJDK RCE 报告尚未核实","Oracle 将于 2026 年 11 月 17 日发布 Java SE 的 11 个安全补丁，这些漏洞最高 CVSS 3.1 评分为 8.1，均可能无需认证通过网络利用，但具体组件与后果尚未披露。",{"_57":295,"_288":294},"2026-11-17T15:17:36.000Z",false,"The Hacker News","mkzk4m7i7p0ykhitydl6nj7vt","CVE-2026-114938 被报告为 Java 17 及以上版本的关键预认证远程代码执行漏洞，CVSS v4 9.2","CVE-2026-114938 被公开报告为 Java 17 及以上版本中的内存损坏漏洞，攻击者无需认证即可远程执行代码，严重等级为 Critical，CVSS v4 评分为 9.2。",{"_57":301,"_288":286},"2026-11-17T18:26:55.000Z","Rapid7 CVE 公告","taftp8yj8gj6gq2pfw66kywm3","OpenJDK Java4Shell 漏洞 CVE-2026-114938 可导致 RCE，Oracle 已发布补丁","OpenJDK 的 Java4Shell 漏洞 CVE-2026-114938 可被未认证攻击者用于 RCE，并可能泄露内存敏感信息。该内存破坏缺陷影响 OpenJDK 17.0.6 及之后版本，Calif 评为 CVSS 4.0 9.2，Oracle 评为 CVSS 3.1 8.1（High）。",{"_57":307,"_288":294},"2026-11-17T23:04:21.000Z","BleepingComputer","ukkhb41ztht06clsk0m6vir8y","Oracle Java SE 披露 java4shell 漏洞 CVE-2026-114938","Oracle Java SE 存在 java4shell 漏洞 CVE-2026-114938，可导致远程任意代码执行和远程拒绝服务。",{"_57":312,"_288":294},"CERT-FR","k6706a5hgaf72jqkq6a66bv3v","Elastic 披露 Java4Shell 远程代码执行漏洞 CVE-2026-114938 的影响与缓解措施","Elastic 确认 CVE-2026-114938 影响 OpenJDK 和 Oracle Java SE，并波及 Elasticsearch 7.17.3 及以上版本与 Logstash 8.6.2 及以上版本。",{"_57":317,"_288":294},"Elastic Blog","dfwqi3rn34m4ulnf8mx78nfct","CVE-2026-114938（Java4Shell）：Java 运行时 Base64 解码器堆溢出漏洞技术分析","CVE-2026-114938 又名 Java4Shell，是 Java 运行时优化版 Base64 解码器中的高危堆缓冲区溢出漏洞。在特定条件下，未认证攻击者可通过向受影响应用提供恶意的 Base64 编码数据触发该漏洞，可能导致内存破坏或远程代码执行（RCE）。",{"_57":323,"_288":294},"2026-11-18T00:31:13.000Z","Horizon3.ai","x6hr1d05vc1eniaapst9d20m2","OpenJDK Base64 解码远程代码执行漏洞 CVE-2026-114938 已复现","OpenJDK Base64 解码远程代码执行漏洞 CVE-2026-114938 已被成功复现。漏洞影响 JDK 17 及以上版本，位于 x86-64 处理器的 AVX-512 VBMI 优化代码中；特定尾部填充字符会触发约 62 字节的堆越界写入，在满足利用条件时可执行任意代码，无须用户权限或受害者配合。",{"_57":329,"_288":286},"2026-11-18T01:01:00.000Z","微步在线研究响应中心","npae2p2bauihkhq9p8huoutnf","OpenJDK 披露 Base64 解码远程代码执行漏洞 CVE-2026-114938","OpenJDK Java4Shell Base64解码远程代码执行漏洞 CVE-2026-114938 可经网络输入在无需认证的条件下劫持执行流。受影响范围包括 OpenJDK 17、21、25、27及对应 GraalVM，部分 Keycloak、Jira、Confluence 等产品存在未授权 RCE。",{"_57":335,"_288":286},"2026-11-18T01:41:00.000Z","阿里云应急响应","n4tahh88g489irumtezkuzxio","OpenJDK Java 披露 RCE 漏洞 CVE-2026-114938，CVSS 4.0 9.2","Cisco Talos 披露 OpenJDK Java RCE 漏洞 CVE-2026-114938（Java4Shell），CVSS 4.0 评分为 9.2，向受影响 JVM 发送畸形 Base64 输入即可触发。",{"_57":341,"_288":294},"2026-11-18T01:53:03.000Z","Cisco Talos","p75psh5s1kxd4bxaxikak4wzy","OpenJDK Base64 解码器 RCE 漏洞 CVE-2026-114938 已复现","OpenJDK Base64 解码器远程代码执行漏洞 CVE-2026-114938 已由奇安信 CERT 成功复现，评级高危，CVSS 3.1 分数 8.1，PoC 与技术细节均已公开。",{"_57":347,"_288":286},"2026-11-18T01:58:00.000Z","奇安信 CERT","ed0711f6312g9652uo14ky47r","OpenJDK Base64 解码器 RCE 漏洞 CVE-2026-114938 公布，CVSS 8.1","OpenJDK Base64 解码器存在 RCE 漏洞 CVE-2026-114938，奇安信评级为高危，CVSS 3.1 分数 8.1，PoC 与技术细节已公开，暂未发现在野利用。",{"_57":353,"_288":294},"2026-11-18T02:31:38.687Z","安全内参","mi6qknq2r4ea2ultil9q6ouxt","OpenJDK Base64 解码器远程代码执行漏洞 CVE-2026-114938 已复现","OpenJDK 的 java.util.Base64 解码器存在远程代码执行漏洞 CVE-2026-114938，攻击者无需认证即可通过网络提交特制编码数据触发堆越界写。",{"_57":359,"_288":286},"2026-11-18T03:02:00.000Z","长亭安全应急响应中心","bmns3jr1jbe4v9f3n8o610u4x","OpenJDK 远程代码执行漏洞 CVE-2026-114938 已复现","绿盟科技天机实验室已复现 OpenJDK 远程代码执行漏洞 CVE-2026-114938（Java4Shell），CVSS 评分 8.1。",{"_57":365,"_288":286},"2026-11-18T04:08:00.000Z","绿盟科技CERT","w9ym68dylhzzmoviqlpdxj6rx","Java 漏洞 CVE-2026-114938 可在 Jira、Jenkins 等应用中实现未认证 RCE","Calif 披露 Java 漏洞 CVE-2026-114938，影响 Java 17.0.6 及更高版本、Java 21、25、27 及指定 GraalVM 构建，仅在支持 AVX-512 VBMI 的 x86-64 芯片上触发，可造成未认证 RCE。",{"_57":295,"_288":294},"2026-11-18T04:27:41.000Z","ud1vjr1zfducwc79z1g197n47","OpenJDK Base64 解码内存安全漏洞 CVE-2026-114938 影响多款 Java 发行版，CVSS 4.0 评分 9.2","Oracle 与 OpenJDK 项目已修复 Java4Shell 漏洞 CVE-2026-114938，这是 OpenJDK 在 x86-64 AVX-512 VBMI 处理器上解码 Base64 时的内存安全缺陷，Calif 研究员 Quang Luong 于 11 月 17 日公开披露。",{"_57":376,"_288":294},"2026-11-18T07:43:34.000Z","SecurityWeek","y5nax2xm1n26pj966hckuw1tn","Cisco 披露 OpenJDK 远程代码执行漏洞 CVE-2026-114938 的产品影响","Oracle OpenJDK CVE-2026-114938 可导致远程代码执行，影响采用 x86-64 且支持 AVX-512 VBMI 的 OpenJDK Java 17.0.6 及更高版本。",{"_57":381,"_288":286},"Cisco PSIRT","b0kdkiq0r1i6icccd7vbjbn1t","Oracle Java Base64 解码器漏洞 CVE-2026-114938 可导致远程代码执行，CISA 呼吁立即修补","Oracle Java 的 Java4Shell 漏洞 CVE-2026-114938 影响 x86-64 HotSpot JVM 的 Base64 解码器，CVSS 8.1，特定输入可导致 DoS 或无需认证的远程代码执行。",{"_57":295,"_288":294},"2026-11-18T08:24:23.000Z","p1qqmwstcg26ywy13c4vyfp5f","Oracle 修复 Java4Shell 内存破坏漏洞 CVE-2026-114938","Oracle 已为 Java4Shell 内存破坏漏洞 CVE-2026-114938 发布修复，该漏洞影响特定 Java 运行时中硬件加速的 Base64 解码，可在无需认证和用户交互的情况下被利用，Calif 评为 CVSS 4.0 9.2，Oracle 评为 CVSS 3.1 8.1。",{"_57":392,"_288":294},"2026-11-18T08:41:47.000Z","Hackread","vswsohxmcbyf63rfffrs81z1z","Oracle Java SE JIT 编译器堆越界写入漏洞 CVE-2026-114938 可导致远程代码执行","Oracle Java SE 与 GraalVM 的 JIT 编译器存在堆缓冲区越界写入漏洞 CVE-2026-114938，CVSS 3.1 为 8.1。攻击者无需认证，但需网络可达受影响 Java 服务、提交特制数据，并使用支持 AVX-512 VBMI、AVX-512BW、BMI2 的 x86-64 平台，成功利用可接管 Java 环境。",{"_57":398,"_288":286},"2026-11-18T09:20:00.000Z","深信服千里目安全实验室","z85z9u6rre7zjq1qsr6tfqmyx","Calif 披露 OpenJDK Java4Shell 漏洞 CVE-2026-114938，可导致 RCE","Calif 披露 OpenJDK Base64 解码器内存破坏漏洞 CVE-2026-114938，CVSS 为 9.2，可导致 RCE。该漏洞影响 OpenJDK 17.0.6 及更高版本，并波及采用相关 Java 运行时的多款产品；利用需 x86-64 CPU、AVX-512 VBMI，ARM64 不受影响。",{"_57":404,"_288":294},"2026-11-18T10:45:57.000Z","Security Affairs","qpgh1pxshbd889atpyfcyweoa","OpenJDK Base64 解码器漏洞 CVE-2026-114938 已修复，RCE 利用受特定 CPU 限制","OpenJDK Base64 解码器内存损坏漏洞 CVE-2026-114938 已由 Oracle 和 OpenJDK 项目修复，目前没有成功攻击证据，但 CISA 强烈建议立即修补。",{"_57":410,"_288":294},"2026-11-18T11:12:12.000Z","Help Net Security","txj5kdwx08v64wngc54j4fqlo","OpenJDK 远程代码执行漏洞 Java4Shell CVE-2026-114938 提前泄露","OpenJDK 内存损坏漏洞 CVE-2026-114938 已在协调披露前泄露，可由未认证攻击者通过单个畸形消息破坏 Java 服务器内存并实现 RCE，受影响版本包括 OpenJDK 17、21、25 和 27。",{"_57":416,"_288":294},"2026-11-18T12:35:00.000Z","Infosecurity Magazine","r5idp638xeh25ay1o0ahw2ys0","OpenJDK Base64 内存破坏漏洞 Java4Shell CVE-2026-114938 的影响与防护","Calif 披露 OpenJDK Base64 解码器内存破坏漏洞 Java4Shell（CVE-2026-114938），CVSS 4.0 评分为 9.2，影响 OpenJDK 17.0.6 及更新版本在支持 AVX-512 VBMI 的 x86-64 处理器上处理攻击者可控 Base64 数据的场景，攻击者无需凭据即可触发越界写入并进一步实现堆内存泄露或 RCE。",{"_57":422,"_288":294},"2026-11-18T14:52:10.000Z","Cloudflare Blog","sk8wyb4ueg1zyazbfsvrt6dnw","Cisco 多款产品披露 11 个漏洞，涉及远程代码执行与拒绝服务","CERT-FR 汇总 Cisco 多款产品中的 11 个漏洞，涉及 CVE-2026-114938、CVE-2026-76411 至 CVE-2026-76422 中的编号，以及 CVE-2026-76515、CVE-2026-76516；风险包括远程任意代码执行和远程拒绝服务。",{"_57":312,"_288":294},"qvpfwypnm98lbm3weswt7q1vp","Elastic 多款产品存在远程代码执行漏洞 CVE-2026-114938","Elastic 产品存在 CVE-2026-114938，可导致远程任意代码执行和远程拒绝服务。",{"_57":312,"_288":294},"ejln2juvmnmqivl256cvt44xc","OpenJDK Base64 解码漏洞 Java4Shell（CVE-2026-114938）可致远程代码执行，Oracle 已发布修复版本","境外安全研究机构 Calif 披露 OpenJDK Base64 解码路径高危漏洞 Java4Shell（CVE-2026-114938），攻击者向 Java 应用提交特制 Base64 数据即可触发约 62 字节堆内存越界写入，造成敏感信息泄露、拒绝服务甚至远程代码执行，Oracle 已发布修复版本。",{"_57":353,"_288":294},"2026-11-19T03:02:10.031Z","k6325hbj1b4nzixqozjl26rfu","Java HotSpot 内存破坏漏洞 CVE-2026-114938 已发布修复","Oracle Java SE、OpenJDK 及多种下游 Java 发行版使用的 HotSpot JVM 存在内存破坏漏洞 CVE-2026-114938，Oracle 评为 CVSS 3.1 8.1，Red Hat 评为 CVSS 3.0 9.8。",{"_57":440,"_288":294},"CrowdStrike","he0bob19pbje3opocivfw0w0a","攻击者已开始针对 Java4Shell 漏洞 CVE-2026-114938 开展扫描和利用尝试。该漏洞影响支持 AVX-512 VBMI 的 x86-64 OpenJDK 17.0.6 及更高版本，可导致内存破坏；Calif 称默认配置下可在 Jira、Confluence、Jenkins、Keycloak 等产品实现未认证 RCE，但各产品需要定制利用链。",{"_57":376,"_288":294},"jsvxig3v1kvrs5o9dhhff0hh5","PHP 官方发布安全更新，集中修复 17 个严重高危漏洞","PHP 于 2026 年 11 月 19 日发布安全更新，集中修复 17 个严重高危漏洞，其中包括远程代码执行漏洞，涉及 CVE-2026-129289 等编号。当前材料未提供具体受影响版本、利用前提和补丁下载信息。",{"_57":335,"_288":286},"2026-11-19T15:16:19.000Z","wfvwclz2yypcudxbab0s81bqj","PHP 修复 8 个关键漏洞，CVE-2026-115560 等可导致远程代码执行","PHP Foundation 发布安全更新，修复包括 CVE-2026-115560 在内的 8 个漏洞，其中 7 个 CVSS 9.2，可能导致远程代码执行、内存破坏、会话损坏、拒绝服务或本地权限提升。",{"_57":295,"_288":294},"2026-11-19T15:18:07.000Z","tf9eabj6ytgthaa7i9pl09et0","Cisco Talos 汇总 OpenJDK RCE 漏洞与本周安全威胁动态","Cisco Talos 本期汇总 Java4Shell（CVE-2026-114938）披露、5 个 nginx 严重 CVE、Optimizely 供应链攻击、Microsoft 服务中断及多起诈骗与恶意软件动态。",{"_57":341,"_288":294},{"_278":393,"_13":394,"_29":395,"_282":475,"_284":397,"_285":286},{"_278":377,"_13":378,"_29":379,"_282":474,"_284":214,"_285":286},{"_278":360,"_13":361,"_29":362,"_282":473,"_284":364,"_285":286},{"_278":354,"_13":355,"_29":356,"_282":472,"_284":358,"_285":286},{"_278":342,"_13":343,"_29":344,"_282":471,"_284":346,"_285":286},{"_278":330,"_13":331,"_29":332,"_282":470,"_284":334,"_285":286},{"_278":324,"_13":325,"_29":326,"_282":469,"_284":328,"_285":286},{"_278":296,"_13":297,"_29":298,"_282":468,"_284":300,"_285":294},{"_278":279,"_13":280,"_29":281,"_282":467,"_284":22,"_285":286},{"_57":287,"_288":286},{"_57":301,"_288":286},{"_57":329,"_288":286},{"_57":335,"_288":286},{"_57":347,"_288":286},{"_57":359,"_288":286},{"_57":365,"_288":286},{"_57":381,"_288":286},{"_57":398,"_288":286},{"_484":516,"_13":517,"_21":24,"_17":501,"_487":518},{"_484":512,"_13":513,"_21":421,"_17":501,"_487":514},{"_484":508,"_13":509,"_21":409,"_17":501,"_487":510},{"_484":504,"_13":505,"_21":346,"_17":240,"_487":506},{"_484":499,"_13":500,"_21":328,"_17":501,"_487":502},{"_484":495,"_13":496,"_21":236,"_17":235,"_487":497},{"_484":490,"_13":491,"_21":300,"_17":492,"_487":493},{"_484":485,"_13":486,"_21":22,"_17":240,"_487":488},"factId","fUP1PwxhxZCs","CISA敦促修补Java关键漏洞","representative",{"_278":279,"_13":280,"_29":281,"_282":489,"_284":22,"_285":286},{"_57":287,"_288":286},"f8X9-lkLyK9M","Rapid7公布Java RCE漏洞报告",13,{"_278":393,"_13":394,"_29":395,"_282":494,"_284":397,"_285":286},{"_57":398,"_288":286},"fd55XLZ5t838","披露Java4Shell漏洞并发布修复",{"_278":330,"_13":331,"_29":332,"_282":498,"_284":334,"_285":286},{"_57":335,"_288":286},"fy40biG5QM-c","复现OpenJDK Base64解码RCE漏洞",1,{"_278":324,"_13":325,"_29":326,"_282":503,"_284":328,"_285":286},{"_57":329,"_288":286},"fFhKQzwxOQPU","奇安信CERT复现OpenJDK解码器漏洞",{"_278":342,"_13":343,"_29":344,"_282":507,"_284":346,"_285":286},{"_57":347,"_288":286},"fvYpqP97PWxE","Oracle与OpenJDK修复Java4Shell漏洞",{"_278":405,"_13":406,"_29":407,"_282":511,"_284":409,"_285":294},{"_57":410,"_288":294},"fmIHtd44o4WM","Cloudflare发布Java4Shell防护规则",{"_278":417,"_13":418,"_29":419,"_282":515,"_284":421,"_285":286},{"_57":422,"_288":294},"fnutD3PpNl_4","Java4Shell漏洞遭扫描与利用尝试",{"_278":441,"_13":32,"_29":442,"_282":519,"_284":24,"_285":286},{"_57":376,"_288":294},"participants48h","newParticipants6h",0,"recentReports24h",3,"observationComplete","rank",{"_528":529,"_530":-5},"changelogVersion","2026-10-01T08:00","release"]
