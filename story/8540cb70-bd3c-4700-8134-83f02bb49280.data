:516,"_366":367},{"_359":508,"_13":509,"_29":510,"_363":511,"_365":262,"_366":375},{"_359":504,"_13":505,"_29":506,"_363":507,"_365":262,"_366":375},{"_359":498,"_13":499,"_29":500,"_363":501,"_365":502,"_366":367},{"_359":492,"_13":493,"_29":494,"_363":495,"_365":496,"_366":367},{"_359":486,"_13":487,"_29":488,"_363":489,"_365":490,"_366":375},{"_359":480,"_13":481,"_29":482,"_363":483,"_365":484,"_366":367},{"_359":474,"_13":475,"_29":476,"_363":477,"_365":478,"_366":367},{"_359":468,"_13":469,"_29":470,"_363":471,"_365":472,"_366":367},{"_359":463,"_13":464,"_29":465,"_363":466,"_365":467,"_366":367},{"_359":458,"_13":459,"_29":460,"_363":461,"_365":297,"_366":367},{"_359":452,"_13":453,"_29":454,"_363":455,"_365":456,"_366":367},{"_359":447,"_13":448,"_29":449,"_363":450,"_365":451,"_366":367},{"_359":441,"_13":442,"_29":443,"_363":444,"_365":445,"_366":367},{"_359":435,"_13":436,"_29":437,"_363":438,"_365":439,"_366":367},{"_359":429,"_13":430,"_29":431,"_363":432,"_365":433,"_366":367},{"_359":423,"_13":424,"_29":425,"_363":426,"_365":427,"_366":367},{"_359":417,"_13":418,"_29":419,"_363":420,"_365":421,"_366":367},{"_359":411,"_13":412,"_29":413,"_363":414,"_365":415,"_366":367},{"_359":405,"_13":406,"_29":407,"_363":408,"_365":409,"_366":367},{"_359":399,"_13":400,"_29":401,"_363":402,"_365":403,"_366":375},{"_359":394,"_13":395,"_29":396,"_363":397,"_365":315,"_366":367},{"_359":389,"_13":390,"_29":391,"_363":392,"_365":315,"_366":375},{"_359":383,"_13":384,"_29":385,"_363":386,"_365":387,"_366":367},{"_359":377,"_13":378,"_29":379,"_363":380,"_365":381,"_366":375},{"_359":370,"_13":371,"_29":372,"_363":373,"_365":374,"_366":375},{"_359":360,"_13":361,"_29":362,"_363":364,"_365":22,"_366":367},"id","rqea4z2nhncrkf2s1jvtvp067","Oracle Java Base64 解码器漏洞 CVE-2026-114938 存在未认证 RCE，CISA 要求立即修补","Oracle Java 的 Base64 解码器存在内存损坏漏洞 CVE-2026-114938，可由特制 Base64 输入触发 JVM 崩溃，并在无需认证的条件下实现远程代码执行。","source",{"_57":368,"_369":367},"publishedAt","selected",true,"CISA 安全公告","firstParty","hj7uwdt1znnojxhgt383nvyg7","Oracle 将修复 11 个 Java SE 漏洞，CVE-2026-114938 OpenJDK RCE 报告尚未核实","Oracle 将于 2026 年 11 月 17 日发布 Java SE 的 11 个安全补丁，这些漏洞最高 CVSS 3.1 评分为 8.1，均可能无需认证通过网络利用，但具体组件与后果尚未披露。",{"_57":376,"_369":375},"2026-11-17T15:17:36.000Z",false,"The Hacker News","mkzk4m7i7p0ykhitydl6nj7vt","CVE-2026-114938 被报告为 Java 17 及以上版本的关键预认证远程代码执行漏洞，CVSS v4 9.2","CVE-2026-114938 被公开报告为 Java 17 及以上版本中的内存损坏漏洞，攻击者无需认证即可远程执行代码，严重等级为 Critical，CVSS v4 评分为 9.2。",{"_57":382,"_369":367},"2026-11-17T18:26:55.000Z","Rapid7 CVE 公告","taftp8yj8gj6gq2pfw66kywm3","OpenJDK Java4Shell 漏洞 CVE-2026-114938 可导致 RCE，Oracle 已发布补丁","OpenJDK 的 Java4Shell 漏洞 CVE-2026-114938 可被未认证攻击者用于 RCE，并可能泄露内存敏感信息。该内存破坏缺陷影响 OpenJDK 17.0.6 及之后版本，Calif 评为 CVSS 4.0 9.2，Oracle 评为 CVSS 3.1 8.1（High）。",{"_57":388,"_369":375},"2026-11-17T23:04:21.000Z","BleepingComputer","ukkhb41ztht06clsk0m6vir8y","Oracle Java SE 披露 java4shell 漏洞 CVE-2026-114938","Oracle Java SE 存在 java4shell 漏洞 CVE-2026-114938，可导致远程任意代码执行和远程拒绝服务。",{"_57":393,"_369":375},"CERT-FR","k6706a5hgaf72jqkq6a66bv3v","Elastic 披露 Java4Shell 远程代码执行漏洞 CVE-2026-114938 的影响与缓解措施","Elastic 确认 CVE-2026-114938 影响 OpenJDK 和 Oracle Java SE，并波及 Elasticsearch 7.17.3 及以上版本与 Logstash 8.6.2 及以上版本。",{"_57":398,"_369":375},"Elastic Blog","dfwqi3rn34m4ulnf8mx78nfct","CVE-2026-114938（Java4Shell）：Java 运行时 Base64 解码器堆溢出漏洞技术分析","CVE-2026-114938 又名 Java4Shell，是 Java 运行时优化版 Base64 解码器中的高危堆缓冲区溢出漏洞。在特定条件下，未认证攻击者可通过向受影响应用提供恶意的 Base64 编码数据触发该漏洞，可能导致内存破坏或远程代码执行（RCE）。",{"_57":404,"_369":375},"2026-11-18T00:31:13.000Z","Horizon3.ai","x6hr1d05vc1eniaapst9d20m2","OpenJDK Base64 解码远程代码执行漏洞 CVE-2026-114938 已复现","OpenJDK Base64 解码远程代码执行漏洞 CVE-2026-114938 已被成功复现。漏洞影响 JDK 17 及以上版本，位于 x86-64 处理器的 AVX-512 VBMI 优化代码中；特定尾部填充字符会触发约 62 字节的堆越界写入，在满足利用条件时可执行任意代码，无须用户权限或受害者配合。",{"_57":410,"_369":367},"2026-11-18T01:01:00.000Z","微步在线研究响应中心","npae2p2bauihkhq9p8huoutnf","OpenJDK 披露 Base64 解码远程代码执行漏洞 CVE-2026-114938","OpenJDK Java4Shell Base64解码远程代码执行漏洞 CVE-2026-114938 可经网络输入在无需认证的条件下劫持执行流。受影响范围包括 OpenJDK 17、21、25、27及对应 GraalVM，部分 Keycloak、Jira、Confluence 等产品存在未授权 RCE。",{"_57":416,"_369":367},"2026-11-18T01:41:00.000Z","阿里云应急响应","n4tahh88g489irumtezkuzxio","OpenJDK Java 披露 RCE 漏洞 CVE-2026-114938，CVSS 4.0 9.2","Cisco Talos 披露 OpenJDK Java RCE 漏洞 CVE-2026-114938（Java4Shell），CVSS 4.0 评分为 9.2，向受影响 JVM 发送畸形 Base64 输入即可触发。",{"_57":422,"_369":375},"2026-11-18T01:53:03.000Z","Cisco Talos","p75psh5s1kxd4bxaxikak4wzy","OpenJDK Base64 解码器 RCE 漏洞 CVE-2026-114938 已复现","OpenJDK Base64 解码器远程代码执行漏洞 CVE-2026-114938 已由奇安信 CERT 成功复现，评级高危，CVSS 3.1 分数 8.1，PoC 与技术细节均已公开。",{"_57":428,"_369":367},"2026-11-18T01:58:00.000Z","奇安信 CERT","ed0711f6312g9652uo14ky47r","OpenJDK Base64 解码器 RCE 漏洞 CVE-2026-114938 公布，CVSS 8.1","OpenJDK Base64 解码器存在 RCE 漏洞 CVE-2026-114938，奇安信评级为高危，CVSS 3.1 分数 8.1，PoC 与技术细节已公开，暂未发现在野利用。",{"_57":434,"_369":375},"2026-11-18T02:31:38.687Z","安全内参","mi6qknq2r4ea2ultil9q6ouxt","OpenJDK Base64 解码器远程代码执行漏洞 CVE-2026-114938 已复现","OpenJDK 的 java.util.Base64 解码器存在远程代码执行漏洞 CVE-2026-114938，攻击者无需认证即可通过网络提交特制编码数据触发堆越界写。",{"_57":440,"_369":367},"2026-11-18T03:02:00.000Z","长亭安全应急响应中心","bmns3jr1jbe4v9f3n8o610u4x","OpenJDK 远程代码执行漏洞 CVE-2026-114938 已复现","绿盟科技天机实验室已复现 OpenJDK 远程代码执行漏洞 CVE-2026-114938（Java4Shell），CVSS 评分 8.1。",{"_57":446,"_369":367},"2026-11-18T04:08:00.000Z","绿盟科技CERT","w9ym68dylhzzmoviqlpdxj6rx","Java 漏洞 CVE-2026-114938 可在 Jira、Jenkins 等应用中实现未认证 RCE","Calif 披露 Java 漏洞 CVE-2026-114938，影响 Java 17.0.6 及更高版本、Java 21、25、27 及指定 GraalVM 构建，仅在支持 AVX-512 VBMI 的 x86-64 芯片上触发，可造成未认证 RCE。",{"_57":376,"_369":375},"2026-11-18T04:27:41.000Z","ud1vjr1zfducwc79z1g197n47","OpenJDK Base64 解码内存安全漏洞 CVE-2026-114938 影响多款 Java 发行版，CVSS 4.0 评分 9.2","Oracle 与 OpenJDK 项目已修复 Java4Shell 漏洞 CVE-2026-114938，这是 OpenJDK 在 x86-64 AVX-512 VBMI 处理器上解码 Base64 时的内存安全缺陷，Calif 研究员 Quang Luong 于 11 月 17 日公开披露。",{"_57":457,"_369":375},"2026-11-18T07:43:34.000Z","SecurityWeek","y5nax2xm1n26pj966hckuw1tn","Cisco 披露 OpenJDK 远程代码执行漏洞 CVE-2026-114938 的产品影响","Oracle OpenJDK CVE-2026-114938 可导致远程代码执行，影响采用 x86-64 且支持 AVX-512 VBMI 的 OpenJDK Java 17.0.6 及更高版本。",{"_57":462,"_369":367},"Cisco PSIRT","b0kdkiq0r1i6icccd7vbjbn1t","Oracle Java Base64 解码器漏洞 CVE-2026-114938 可导致远程代码执行，CISA 呼吁立即修补","Oracle Java 的 Java4Shell 漏洞 CVE-2026-114938 影响 x86-64 HotSpot JVM 的 Base64 解码器，CVSS 8.1，特定输入可导致 DoS 或无需认证的远程代码执行。",{"_57":376,"_369":375},"2026-11-18T08:24:23.000Z","p1qqmwstcg26ywy13c4vyfp5f","Oracle 修复 Java4Shell 内存破坏漏洞 CVE-2026-114938","Oracle 已为 Java4Shell 内存破坏漏洞 CVE-2026-114938 发布修复，该漏洞影响特定 Java 运行时中硬件加速的 Base64 解码，可在无需认证和用户交互的情况下被利用，Calif 评为 CVSS 4.0 9.2，Oracle 评为 CVSS 3.1 8.1。",{"_57":473,"_369":375},"2026-11-18T08:41:47.000Z","Hackread","vswsohxmcbyf63rfffrs81z1z","Oracle Java SE JIT 编译器堆越界写入漏洞 CVE-2026-114938 可导致远程代码执行","Oracle Java SE 与 GraalVM 的 JIT 编译器存在堆缓冲区越界写入漏洞 CVE-2026-114938，CVSS 3.1 为 8.1。攻击者无需认证，但需网络可达受影响 Java 服务、提交特制数据，并使用支持 AVX-512 VBMI、AVX-512BW、BMI2 的 x86-64 平台，成功利用可接管 Java 环境。",{"_57":479,"_369":367},"2026-11-18T09:20:00.000Z","深信服千里目安全实验室","z85z9u6rre7zjq1qsr6tfqmyx","Calif 披露 OpenJDK Java4Shell 漏洞 CVE-2026-114938，可导致 RCE","Calif 披露 OpenJDK Base64 解码器内存破坏漏洞 CVE-2026-114938，CVSS 为 9.2，可导致 RCE。该漏洞影响 OpenJDK 17.0.6 及更高版本，并波及采用相关 Java 运行时的多款产品；利用需 x86-64 CPU、AVX-512 VBMI，ARM64 不受影响。",{"_57":485,"_369":375},"2026-11-18T10:45:57.000Z","Security Affairs","qpgh1pxshbd889atpyfcyweoa","OpenJDK Base64 解码器漏洞 CVE-2026-114938 已修复，RCE 利用受特定 CPU 限制","OpenJDK Base64 解码器内存损坏漏洞 CVE-2026-114938 已由 Oracle 和 OpenJDK 项目修复，目前没有成功攻击证据，但 CISA 强烈建议立即修补。",{"_57":491,"_369":375},"2026-11-18T11:12:12.000Z","Help Net Security","txj5kdwx08v64wngc54j4fqlo","OpenJDK 远程代码执行漏洞 Java4Shell CVE-2026-114938 提前泄露","OpenJDK 内存损坏漏洞 CVE-2026-114938 已在协调披露前泄露，可由未认证攻击者通过单个畸形消息破坏 Java 服务器内存并实现 RCE，受影响版本包括 OpenJDK 17、21、25 和 27。",{"_57":497,"_369":375},"2026-11-18T12:35:00.000Z","Infosecurity Magazine","r5idp638xeh25ay1o0ahw2ys0","OpenJDK Base64 内存破坏漏洞 Java4Shell CVE-2026-114938 的影响与防护","Calif 披露 OpenJDK Base64 解码器内存破坏漏洞 Java4Shell（CVE-2026-114938），CVSS 4.0 评分为 9.2，影响 OpenJDK 17.0.6 及更新版本在支持 AVX-512 VBMI 的 x86-64 处理器上处理攻击者可控 Base64 数据的场景，攻击者无需凭据即可触发越界写入并进一步实现堆内存泄露或 RCE。",{"_57":503,"_369":375},"2026-11-18T14:52:10.000Z","Cloudflare Blog","sk8wyb4ueg1zyazbfsvrt6dnw","Cisco 多款产品披露 11 个漏洞，涉及远程代码执行与拒绝服务","CERT-FR 汇总 Cisco 多款产品中的 11 个漏洞，涉及 CVE-2026-114938、CVE-2026-76411 至 CVE-2026-76422 中的编号，以及 CVE-2026-76515、CVE-2026-76516；风险包括远程任意代码执行和远程拒绝服务。",{"_57":393,"_369":375},"qvpfwypnm98lbm3weswt7q1vp","Elastic 多款产品存在远程代码执行漏洞 CVE-2026-114938","Elastic 产品存在 CVE-2026-114938，可导致远程任意代码执行和远程拒绝服务。",{"_57":393,"_369":375},"ejln2juvmnmqivl256cvt44xc","OpenJDK Base64 解码漏洞 Java4Shell（CVE-2026-114938）可致远程代码执行，Oracle 已发布修复版本","境外安全研究机构 Calif 披露 OpenJDK Base64 解码路径高危漏洞 Java4Shell（CVE-2026-114938），攻击者向 Java 应用提交特制 Base64 数据即可触发约 62 字节堆内存越界写入，造成敏感信息泄露、拒绝服务甚至远程代码执行，Oracle 已发布修复版本。",{"_57":434,"_369":375},"2026-11-19T03:02:10.031Z","t8wmzmfpiiphjiwm2e8ngw49n","OpenJDK CVE-2026-114938 AVX-512 越界写利用链与复现","OpenJDK CVE-2026-114938 可由 Base64 解码的 AVX-512 尾部路径整数下溢引发堆越界写，作者在 Temurin 21.0.13+9 上验证固定越界 62 字节，并完成堆内读写、任意原生读写、ASLR 绕过、桩槽覆写到命令执行。",{"_57":522,"_369":375},"2026-11-19T05:08:10.000Z","先知社区","k6325hbj1b4nzixqozjl26rfu","Java HotSpot 内存破坏漏洞 CVE-2026-114938 已发布修复","Oracle Java SE、OpenJDK 及多种下游 Java 发行版使用的 HotSpot JVM 存在内存破坏漏洞 CVE-2026-114938，Oracle 评为 CVSS 3.1 8.1，Red Hat 评为 CVSS 3.0 9.8。",{"_57":527,"_369":375},"CrowdStrike","he0bob19pbje3opocivfw0w0a","Java4Shell 漏洞 CVE-2026-114938 已出现利用尝试，多家厂商确认产品受影响","攻击者已开始针对 Java4Shell 漏洞 CVE-2026-114938 开展扫描和利用尝试。该漏洞影响支持 AVX-512 VBMI 的 x86-64 OpenJDK 17.0.6 及更高版本，可导致内存破坏；Calif 称默认配置下可在 Jira、Confluence、Jenkins、Keycloak 等产品实现未认证 RCE，但各产品需要定制利用链。",{"_57":457,"_369":375},"2026-11-19T09:10:58.000Z","jsvxig3v1kvrs5o9dhhff0hh5","PHP 官方发布安全更新，集中修复 17 个严重高危漏洞","PHP 于 2026 年 11 月 19 日发布安全更新，集中修复 17 个严重高危漏洞，其中包括远程代码执行漏洞，涉及 CVE-2026-129289 等编号。当前材料未提供具体受影响版本、利用前提和补丁下载信息。",{"_57":416,"_369":367},"2026-11-19T15:16:19.000Z","wfvwclz2yypcudxbab0s81bqj","PHP 修复 8 个关键漏洞，CVE-2026-115560 等可导致远程代码执行","PHP Foundation 发布安全更新，修复包括 CVE-2026-115560 在内的 8 个漏洞，其中 7 个 CVSS 9.2，可能导致远程代码执行、内存破坏、会话损坏、拒绝服务或本地权限提升。",{"_57":376,"_369":375},"2026-11-19T15:18:07.000Z","tf9eabj6ytgthaa7i9pl09et0","Cisco Talos 汇总 OpenJDK RCE 漏洞与本周安全威胁动态","Cisco Talos 本期汇总 Java4Shell（CVE-2026-114938）披露、5 个 nginx 严重 CVE、Optimizely 供应链攻击、Microsoft 服务中断及多起诈骗与恶意软件动态。",{"_57":422,"_369":375},"rv7lbk57rbz8c8taq4fyksmq2","CERT-FR 披露 Metabase 存在可导致远程代码执行的漏洞 CVE-2026-114938。",{"_57":393,"_369":375},"x043g4ph11k25t0532k4je5kd","绿盟科技星云实验室发布 AI 与云安全事件周报：Microsoft Agent Framework 投毒、Java4Shell、NGINX HTTP/2 漏洞与 ARMORY CASTLE 入侵","绿盟科技星云实验室发布 2026年11月16日至11月20日 AI 与云安全事件案例分析周报，汇总四起事件：Microsoft Agent Framework 的 agent-framework 1.26.1、1.26.2 两个 PyPI 版本被投毒（两个版本已被 PyPI 隔离。",{"_57":555,"_369":375},"2026-11-20T12:17:00.000Z","绿盟科技研究通讯",{"_359":474,"_13":475,"_29":476,"_363":573,"_365":478,"_366":367},{"_359":458,"_13":459,"_29":460,"_363":572,"_365":297,"_366":367},{"_359":441,"_13":442,"_29":443,"_363":571,"_365":445,"_366":367},{"_359":435,"_13":436,"_29":437,"_363":570,"_365":439,"_366":367},{"_359":423,"_13":424,"_29":425,"_363":569,"_365":427,"_366":367},{"_359":411,"_13":412,"_29":413,"_363":568,"_365":415,"_366":367},{"_359":405,"_13":406,"_29":407,"_363":567,"_365":409,"_366":367},{"_359":377,"_13":378,"_29":379,"_363":566,"_365":381,"_366":375},{"_359":360,"_13":361,"_29":362,"_363":565,"_365":22,"_366":367},{"_57":368,"_369":367},{"_57":382,"_369":367},{"_57":410,"_369":367},{"_57":416,"_369":367},{"_57":428,"_369":367},{"_57":440,"_369":367},{"_57":446,"_369":367},{"_57":462,"_369":367},{"_57":479,"_369":367},{"_583":618,"_13":619,"_21":532,"_17":599,"_586":620},{"_583":614,"_13":615,"_21":521,"_17":599,"_586":616},{"_583":610,"_13":611,"_21":502,"_17":599,"_586":612},{"_583":606,"_13":607,"_21":490,"_17":599,"_586":608},{"_583":602,"_13":603,"_21":427,"_17":318,"_586":604},{"_583":597,"_13":598,"_21":409,"_17":599,"_586":600},{"_583":593,"_13":594,"_21":315,"_17":175,"_586":595},{"_583":589,"_13":590,"_21":381,"_17":202,"_586":591},{"_583":584,"_13":585,"_21":22,"_17":318,"_586":587},"factId",