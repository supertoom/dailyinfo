[{"_1":2,"_3":4},"root",{"_5":141},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794962454000,"publicId","8540cb70-bd3c-4700-8134-83f02bb49280","title","Java4Shell漏洞获官方补丁，利用条件受限","status","active","reportCount",4,"sourceCount","firstReportAt","2026-11-17T12:00:00.000Z","latestAt","2026-11-17T23:04:21.000Z","digest","Calif披露的Java4Shell内存损坏漏洞CVE-2026-114938可由特制Base64输入触发JVM崩溃，并在无需认证的条件下实现远程代码执行；Oracle已发布补丁，CVSS 3.1评分为8.1（High），CISA要求立即修补，暂未确认已遭实际利用。Calif将该漏洞评为CVSS v4 9.2；Rapid7早先称其影响Java 17及以上版本，但相关结论当时仍待Oracle或OpenJDK公告确认。\n\n后续公告确认漏洞影响OpenJDK 17.0.6及之后版本，以及Oracle Java SE、Amazon Corretto、Eclipse Temurin、Microsoft Build of OpenJDK、Azul Zulu和Red Hat OpenJDK。漏洞仅涉及支持AVX-512指令的特定x86-64处理器上的硬件加速解码函数；Calif称不存在通用利用方式，攻击者必须针对具体应用向解码器投递恶意Base64数据才能实现代码执行。Calif已公开内存损坏概念验证，但未公开其攻击受影响企业应用时使用的武器化利用代码。","digestUpdatedAt","2026-11-17T23:29:02.734Z","summary","excerpt","latest","OpenJDK Java4Shell 漏洞 CVE-2026-114938 可导致 RCE，Oracle 已发布补丁","latestReport",{"_91":115},"whyHot",{"_136":77,"_137":128,"_138":77,"_139":99,"_140":18},"developments",[123,124],"officialReports",[119,120],"timeline",[87,88,89,90],"heat",[68,69,70,71,72],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","research","name","技术研究","exploited","在野利用","vuln-mgmt","漏洞管理","cisa","CISA","vuln","漏洞披露","oracle","Oracle / 甲骨文",{"_73":85,"_42":86,"_76":80},{"_73":83,"_42":84,"_76":80},{"_73":81,"_42":82,"_76":80},{"_73":78,"_42":79,"_76":80},{"_73":74,"_42":75,"_76":77},"hour","2026-11-18T00:00:00.000Z",25.3,"participants",3,"2026-11-17T23:00:00.000Z",16,2,"2026-11-17T22:00:00.000Z",16.5,"2026-11-17T21:00:00.000Z",17,"2026-11-17T20:00:00.000Z",17.5,{"_91":115,"_13":31,"_28":116,"_95":117,"_97":23,"_98":99},{"_91":109,"_13":110,"_28":111,"_95":112,"_97":113,"_98":107},{"_91":102,"_13":103,"_28":104,"_95":105,"_97":106,"_98":107},{"_91":92,"_13":93,"_28":94,"_95":96,"_97":21,"_98":99},"id","rqea4z2nhncrkf2s1jvtvp067","Oracle Java Base64 解码器漏洞 CVE-2026-114938 存在未认证 RCE，CISA 要求立即修补","Oracle Java 的 Base64 解码器存在内存损坏漏洞 CVE-2026-114938，可由特制 Base64 输入触发 JVM 崩溃，并在无需认证的条件下实现远程代码执行。","source",{"_56":100,"_101":99},"publishedAt","selected",true,"CISA 安全公告","firstParty","hj7uwdt1znnojxhgt383nvyg7","Oracle 将修复 11 个 Java SE 漏洞，CVE-2026-114938 OpenJDK RCE 报告尚未核实","Oracle 将于 2026 年 11 月 17 日发布 Java SE 的 11 个安全补丁，这些漏洞最高 CVSS 3.1 评分为 8.1，均可能无需认证通过网络利用，但具体组件与后果尚未披露。",{"_56":108,"_101":107},"2026-11-17T15:17:36.000Z",false,"The Hacker News","mkzk4m7i7p0ykhitydl6nj7vt","CVE-2026-114938 被报告为 Java 17 及以上版本的关键预认证远程代码执行漏洞，CVSS v4 9.2","CVE-2026-114938 被公开报告为 Java 17 及以上版本中的内存损坏漏洞，攻击者无需认证即可远程执行代码，严重等级为 Critical，CVSS v4 评分为 9.2。",{"_56":114,"_101":99},"2026-11-17T18:26:55.000Z","Rapid7 CVE 公告","taftp8yj8gj6gq2pfw66kywm3","OpenJDK 的 Java4Shell 漏洞 CVE-2026-114938 可被未认证攻击者用于 RCE，并可能泄露内存敏感信息。该内存破坏缺陷影响 OpenJDK 17.0.6 及之后版本，Calif 评为 CVSS 4.0 9.2，Oracle 评为 CVSS 3.1 8.1（High）。",{"_56":118,"_101":107},"BleepingComputer",{"_91":109,"_13":110,"_28":111,"_95":122,"_97":113,"_98":107},{"_91":92,"_13":93,"_28":94,"_95":121,"_97":21,"_98":99},{"_56":100,"_101":99},{"_56":114,"_101":99},{"_125":132,"_13":133,"_20":113,"_17":80,"_129":134},{"_125":126,"_13":127,"_20":21,"_17":128,"_129":130},"factId","fUP1PwxhxZCs","CISA敦促修补Java关键漏洞",1,"representative",{"_91":92,"_13":93,"_28":94,"_95":131,"_97":21,"_98":99},{"_56":100,"_101":99},"f8X9-lkLyK9M","Rapid7公布Java RCE漏洞报告",{"_91":115,"_13":31,"_28":116,"_95":135,"_97":23,"_98":99},{"_56":118,"_101":107},"participants48h","newParticipants6h","recentReports24h","observationComplete","rank",{"_142":143,"_144":-5},"changelogVersion","2026-10-01T08:00","release"]
