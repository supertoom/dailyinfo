[{"_1":2,"_3":4},"root",{"_5":402},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":-5,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48},"expiresAt",1795048843000,"publicId","8540cb70-bd3c-4700-8134-83f02bb49280","title","Java4Shell已修复，Red Hat补丁仍缺","status","active","reportCount",24,"sourceCount",22,"firstReportAt","2026-11-17T12:00:00.000Z","latestAt","2026-11-18T14:52:10.000Z","digest","Calif披露的OpenJDK Base64解码器堆越界写漏洞CVE-2026-114938（Java4Shell）已由Oracle和OpenJDK项目修复，但Red Hat尚未为RHEL 8、9、10及其OpenJDK 17、21、25构建发布补丁；目前没有成功利用或在野攻击证据。Calif评为CVSS 4.0 9.2，Oracle评为CVSS 3.1 8.1。\n\n漏洞影响OpenJDK 17.0.6及更高版本，仅在支持AVX-512 VBMI/BW等指令集的x86-64处理器上触发，ARM64不受影响；应用还需把攻击者可控数据传入java.util.Base64基本或URL解码器，MIME解码器不受影响。Calif称Keycloak、Jira、Confluence、Artifactory、Jenkins和PingFederate默认配置下可实现未认证RCE，Kafka Broker、Solr、Elasticsearch、Gerrit、Spinnaker需登录，各应用均需定制利用链；Elastic确认Elasticsearch 7.17.3及以上和Logstash 8.6.2及以上受影响，但RCE需至少“read”权限且受Elastic Integration过滤器及不可信Base64字段等条件限制，未认证者通常只能造成DoS。\n\nOracle修复版本为Java SE 8u511b33-perf、17.0.21.0.3、21.0.13.0.3、25.0.5.0.3、27.0.1.0.3，以及Oracle GraalVM for JDK 17.0.21.0.3、21.0.13.0.3和GraalVM Enterprise Edition v21.3.20.0.3；无法立即更新时可用-XX:-UseBASE64Intrinsics或-XX:UseAVX=2规避受影响路径。微步、绿盟等已成功复现，但深信服千里目安全实验室称其利用链仅在自建靶标上验证，未涉及真实产品利用。","digestUpdatedAt","2026-11-18T23:52:29.290Z","summary","excerpt","latest","OpenJDK Base64 内存破坏漏洞 Java4Shell CVE-2026-114938 的影响与防护","latestReport",{"_197":336},"whyHot",{"_396":20,"_397":398,"_399":140,"_400":205,"_401":381},"developments",[358,359,360,361,362,363,364],"officialReports",[340,341,342,343,344,345,346,347,348],"timeline",[173,174,175,176,177,178,179,180,181,182,183,184,185,186,187,188,189,190,191,192,193,194,195,196],"heat",[73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101],"related",[69],"topics",[49,50,51,52,53,54],{"_55":67,"_57":68},{"_55":65,"_57":66},{"_55":63,"_57":64},{"_55":61,"_57":62},{"_55":59,"_57":60},{"_55":56,"_57":58},"slug","blue-team","name","蓝队与运营","exploited","在野利用","vuln-mgmt","漏洞管理","research","技术研究","oracle","Oracle / 甲骨文","vuln","漏洞披露",{"_11":70,"_13":71,"_72":45},"77bb3813-9c7c-4081-ab57-22a02c65eab5","研究者公开 Java4Shell 利用链：OpenJDK Base64 越界写漏洞","relation",{"_102":171,"_43":172,"_105":167},{"_102":170,"_43":140,"_105":167},{"_102":168,"_43":169,"_105":167},{"_102":166,"_43":143,"_105":167},{"_102":163,"_43":164,"_105":165},{"_102":160,"_43":161,"_105":162},{"_102":157,"_43":158,"_105":159},{"_102":154,"_43":155,"_105":156},{"_102":151,"_43":152,"_105":153},{"_102":149,"_43":150,"_105":146},{"_102":147,"_43":148,"_105":146},{"_102":144,"_43":145,"_105":146},{"_102":141,"_43":142,"_105":143},{"_102":138,"_43":139,"_105":140},{"_102":135,"_43":136,"_105":137},{"_102":132,"_43":133,"_105":134},{"_102":129,"_43":130,"_105":131},{"_102":127,"_43":128,"_105":126},{"_102":124,"_43":125,"_105":126},{"_102":122,"_43":123,"_105":20},{"_102":120,"_43":121,"_105":20},{"_102":118,"_43":119,"_105":20},{"_102":116,"_43":117,"_105":20},{"_102":114,"_43":115,"_105":20},{"_102":112,"_43":113,"_105":20},{"_102":110,"_43":111,"_105":20},{"_102":108,"_43":109,"_105":20},{"_102":106,"_43":107,"_105":20},{"_102":103,"_43":104,"_105":20},"hour","2026-11-19T00:00:00.000Z",125.7,"participants","2026-11-18T23:00:00.000Z",129.4,"2026-11-18T22:00:00.000Z",133.2,"2026-11-18T21:00:00.000Z",137.1,"2026-11-18T20:00:00.000Z",141.1,"2026-11-18T19:00:00.000Z",145.2,"2026-11-18T18:00:00.000Z",149.5,"2026-11-18T17:00:00.000Z",153.8,"2026-11-18T16:00:00.000Z",158.4,"2026-11-18T15:00:00.000Z",163,"2026-11-18T14:00:00.000Z",157.5,21,"2026-11-18T13:00:00.000Z",162.1,"2026-11-18T12:00:00.000Z",156.7,20,"2026-11-18T11:00:00.000Z",151.2,19,"2026-11-18T10:00:00.000Z",145.5,18,"2026-11-18T09:00:00.000Z",139.6,17,"2026-11-18T08:00:00.000Z",132.4,16,"2026-11-18T07:00:00.000Z",115.8,14,"2026-11-18T06:00:00.000Z",119.2,"2026-11-18T05:00:00.000Z",122.7,"2026-11-18T04:00:00.000Z",106.1,12,"2026-11-18T03:00:00.000Z",99.2,11,"2026-11-18T02:00:00.000Z",91.9,10,"2026-11-18T01:00:00.000Z",53.9,6,"2026-11-18T00:00:00.000Z",45.3,5,"2026-11-17T23:00:00.000Z",2,"2026-11-17T22:00:00.000Z",16.5,"2026-11-17T21:00:00.000Z","2026-11-17T20:00:00.000Z",17.5,{"_197":336,"_13":32,"_29":337,"_201":338,"_203":24,"_204":205},{"_197":330,"_13":331,"_29":332,"_201":333,"_203":334,"_204":205},{"_197":324,"_13":325,"_29":326,"_201":327,"_203":328,"_204":213},{"_197":318,"_13":319,"_29":320,"_201":321,"_203":322,"_204":205},{"_197":312,"_13":313,"_29":314,"_201":315,"_203":316,"_204":205},{"_197":306,"_13":307,"_29":308,"_201":309,"_203":310,"_204":205},{"_197":301,"_13":302,"_29":303,"_201":304,"_203":305,"_204":205},{"_197":296,"_13":297,"_29":298,"_201":299,"_203":141,"_204":205},{"_197":290,"_13":291,"_29":292,"_201":293,"_203":294,"_204":205},{"_197":285,"_13":286,"_29":287,"_201":288,"_203":289,"_204":205},{"_197":279,"_13":280,"_29":281,"_201":282,"_203":283,"_204":205},{"_197":273,"_13":274,"_29":275,"_201":276,"_203":277,"_204":205},{"_197":267,"_13":268,"_29":269,"_201":270,"_203":271,"_204":205},{"_197":261,"_13":262,"_29":263,"_201":264,"_203":265,"_204":205},{"_197":255,"_13":256,"_29":257,"_201":258,"_203":259,"_204":205},{"_197":249,"_13":250,"_29":251,"_201":252,"_203":253,"_204":205},{"_197":243,"_13":244,"_29":245,"_201":246,"_203":247,"_204":205},{"_197":237,"_13":238,"_29":239,"_201":240,"_203":241,"_204":205},{"_197":232,"_13":233,"_29":234,"_201":235,"_203":163,"_204":205},{"_197":227,"_13":228,"_29":229,"_201":230,"_203":163,"_204":213},{"_197":221,"_13":222,"_29":223,"_201":224,"_203":225,"_204":205},{"_197":215,"_13":216,"_29":217,"_201":218,"_203":219,"_204":213},{"_197":208,"_13":209,"_29":210,"_201":211,"_203":212,"_204":213},{"_197":198,"_13":199,"_29":200,"_201":202,"_203":22,"_204":205},"id","rqea4z2nhncrkf2s1jvtvp067","Oracle Java Base64 解码器漏洞 CVE-2026-114938 存在未认证 RCE，CISA 要求立即修补","Oracle Java 的 Base64 解码器存在内存损坏漏洞 CVE-2026-114938，可由特制 Base64 输入触发 JVM 崩溃，并在无需认证的条件下实现远程代码执行。","source",{"_57":206,"_207":205},"publishedAt","selected",true,"CISA 安全公告","firstParty","hj7uwdt1znnojxhgt383nvyg7","Oracle 将修复 11 个 Java SE 漏洞，CVE-2026-114938 OpenJDK RCE 报告尚未核实","Oracle 将于 2026 年 11 月 17 日发布 Java SE 的 11 个安全补丁，这些漏洞最高 CVSS 3.1 评分为 8.1，均可能无需认证通过网络利用，但具体组件与后果尚未披露。",{"_57":214,"_207":213},"2026-11-17T15:17:36.000Z",false,"The Hacker News","mkzk4m7i7p0ykhitydl6nj7vt","CVE-2026-114938 被报告为 Java 17 及以上版本的关键预认证远程代码执行漏洞，CVSS v4 9.2","CVE-2026-114938 被公开报告为 Java 17 及以上版本中的内存损坏漏洞，攻击者无需认证即可远程执行代码，严重等级为 Critical，CVSS v4 评分为 9.2。",{"_57":220,"_207":205},"2026-11-17T18:26:55.000Z","Rapid7 CVE 公告","taftp8yj8gj6gq2pfw66kywm3","OpenJDK Java4Shell 漏洞 CVE-2026-114938 可导致 RCE，Oracle 已发布补丁","OpenJDK 的 Java4Shell 漏洞 CVE-2026-114938 可被未认证攻击者用于 RCE，并可能泄露内存敏感信息。该内存破坏缺陷影响 OpenJDK 17.0.6 及之后版本，Calif 评为 CVSS 4.0 9.2，Oracle 评为 CVSS 3.1 8.1（High）。",{"_57":226,"_207":213},"2026-11-17T23:04:21.000Z","BleepingComputer","ukkhb41ztht06clsk0m6vir8y","Oracle Java SE 披露 java4shell 漏洞 CVE-2026-114938","Oracle Java SE 存在 java4shell 漏洞 CVE-2026-114938，可导致远程任意代码执行和远程拒绝服务。",{"_57":231,"_207":213},"CERT-FR","k6706a5hgaf72jqkq6a66bv3v","Elastic 披露 Java4Shell 远程代码执行漏洞 CVE-2026-114938 的影响与缓解措施","Elastic 确认 CVE-2026-114938 影响 OpenJDK 和 Oracle Java SE，并波及 Elasticsearch 7.17.3 及以上版本与 Logstash 8.6.2 及以上版本。",{"_57":236,"_207":213},"Elastic Blog","dfwqi3rn34m4ulnf8mx78nfct","Oracle Java SE 与 OpenJDK Base64 解码器堆缓冲区溢出漏洞 CVE-2026-114938（Java4Shell）","Oracle Java SE 与 OpenJDK 的优化版 Base64 解码器存在高危堆缓冲区溢出漏洞 CVE-2026-114938，未认证攻击者向受影响应用提供 Base64 编码数据即可触发越界写入。Oracle 2026 年 11 月关键安全补丁更新指出，该漏洞可能导致受影响系统被接管。",{"_57":242,"_207":213},"2026-11-18T00:31:13.000Z","Horizon3.ai","x6hr1d05vc1eniaapst9d20m2","OpenJDK Base64 解码远程代码执行漏洞 CVE-2026-114938 已复现","OpenJDK Base64 解码远程代码执行漏洞 CVE-2026-114938 已被成功复现。漏洞影响 JDK 17 及以上版本，位于 x86-64 处理器的 AVX-512 VBMI 优化代码中；特定尾部填充字符会触发约 62 字节的堆越界写入，在满足利用条件时可执行任意代码，无须用户权限或受害者配合。",{"_57":248,"_207":205},"2026-11-18T01:01:00.000Z","微步在线研究响应中心","npae2p2bauihkhq9p8huoutnf","OpenJDK 披露 Base64 解码远程代码执行漏洞 CVE-2026-114938","OpenJDK Java4Shell Base64解码远程代码执行漏洞 CVE-2026-114938 可经网络输入在无需认证的条件下劫持执行流。受影响范围包括 OpenJDK 17、21、25、27及对应 GraalVM，部分 Keycloak、Jira、Confluence 等产品存在未授权 RCE。",{"_57":254,"_207":205},"2026-11-18T01:41:00.000Z","阿里云应急响应","n4tahh88g489irumtezkuzxio","OpenJDK Java 披露 RCE 漏洞 CVE-2026-114938，CVSS 4.0 9.2","Cisco Talos 披露 OpenJDK Java RCE 漏洞 CVE-2026-114938（Java4Shell），CVSS 4.0 评分为 9.2，向受影响 JVM 发送畸形 Base64 输入即可触发。",{"_57":260,"_207":213},"2026-11-18T01:53:03.000Z","Cisco Talos","p75psh5s1kxd4bxaxikak4wzy","OpenJDK Base64 解码器 RCE 漏洞 CVE-2026-114938 已复现","OpenJDK Base64 解码器远程代码执行漏洞 CVE-2026-114938 已由奇安信 CERT 成功复现，评级高危，CVSS 3.1 分数 8.1，PoC 与技术细节均已公开。",{"_57":266,"_207":205},"2026-11-18T01:58:00.000Z","奇安信 CERT","ed0711f6312g9652uo14ky47r","OpenJDK Base64 解码器 RCE 漏洞 CVE-2026-114938 公布，CVSS 8.1","OpenJDK Base64 解码器存在 RCE 漏洞 CVE-2026-114938，奇安信评级为高危，CVSS 3.1 分数 8.1，PoC 与技术细节已公开，暂未发现在野利用。",{"_57":272,"_207":213},"2026-11-18T02:31:38.687Z","安全内参","mi6qknq2r4ea2ultil9q6ouxt","OpenJDK Base64 解码器远程代码执行漏洞 CVE-2026-114938 已复现","OpenJDK 的 java.util.Base64 解码器存在远程代码执行漏洞 CVE-2026-114938，攻击者无需认证即可通过网络提交特制编码数据触发堆越界写。",{"_57":278,"_207":205},"2026-11-18T03:02:00.000Z","长亭安全应急响应中心","bmns3jr1jbe4v9f3n8o610u4x","OpenJDK 远程代码执行漏洞 CVE-2026-114938 已复现","绿盟科技天机实验室已复现 OpenJDK 远程代码执行漏洞 CVE-2026-114938（Java4Shell），CVSS 评分 8.1。",{"_57":284,"_207":205},"2026-11-18T04:08:00.000Z","绿盟科技CERT","w9ym68dylhzzmoviqlpdxj6rx","Java 漏洞 CVE-2026-114938 可在 Jira、Jenkins 等应用中实现未认证 RCE","Calif 披露 Java 漏洞 CVE-2026-114938，影响 Java 17.0.6 及更高版本、Java 21、25、27 及指定 GraalVM 构建，仅在支持 AVX-512 VBMI 的 x86-64 芯片上触发，可造成未认证 RCE。",{"_57":214,"_207":213},"2026-11-18T04:27:41.000Z","ud1vjr1zfducwc79z1g197n47","OpenJDK Base64 解码内存安全漏洞 CVE-2026-114938 影响多款 Java 发行版，CVSS 4.0 评分 9.2","Oracle 与 OpenJDK 项目已修复 Java4Shell 漏洞 CVE-2026-114938，这是 OpenJDK 在 x86-64 AVX-512 VBMI 处理器上解码 Base64 时的内存安全缺陷，Calif 研究员 Quang Luong 于 11 月 17 日公开披露。",{"_57":295,"_207":213},"2026-11-18T07:43:34.000Z","SecurityWeek","y5nax2xm1n26pj966hckuw1tn","Cisco 披露 OpenJDK 远程代码执行漏洞 CVE-2026-114938 的产品影响","Oracle OpenJDK CVE-2026-114938 可导致远程代码执行，影响采用 x86-64 且支持 AVX-512 VBMI 的 OpenJDK Java 17.0.6 及更高版本。",{"_57":300,"_207":205},"Cisco PSIRT","b0kdkiq0r1i6icccd7vbjbn1t","Oracle Java Base64 解码器漏洞 CVE-2026-114938 可导致远程代码执行，CISA 呼吁立即修补","Oracle Java 的 Java4Shell 漏洞 CVE-2026-114938 影响 x86-64 HotSpot JVM 的 Base64 解码器，CVSS 8.1，特定输入可导致 DoS 或无需认证的远程代码执行。",{"_57":214,"_207":213},"2026-11-18T08:24:23.000Z","p1qqmwstcg26ywy13c4vyfp5f","Oracle 修复 Java4Shell 内存破坏漏洞 CVE-2026-114938","Oracle 已为 Java4Shell 内存破坏漏洞 CVE-2026-114938 发布修复，该漏洞影响特定 Java 运行时中硬件加速的 Base64 解码，可在无需认证和用户交互的情况下被利用，Calif 评为 CVSS 4.0 9.2，Oracle 评为 CVSS 3.1 8.1。",{"_57":311,"_207":213},"2026-11-18T08:41:47.000Z","Hackread","vswsohxmcbyf63rfffrs81z1z","Oracle Java SE JIT 编译器堆越界写入漏洞 CVE-2026-114938 可导致远程代码执行","Oracle Java SE 与 GraalVM 的 JIT 编译器存在堆缓冲区越界写入漏洞 CVE-2026-114938，CVSS 3.1 为 8.1。攻击者无需认证，但需网络可达受影响 Java 服务、提交特制数据，并使用支持 AVX-512 VBMI、AVX-512BW、BMI2 的 x86-64 平台，成功利用可接管 Java 环境。",{"_57":317,"_207":205},"2026-11-18T09:20:00.000Z","深信服千里目安全实验室","z85z9u6rre7zjq1qsr6tfqmyx","Calif 披露 OpenJDK Java4Shell 漏洞 CVE-2026-114938，可导致 RCE","Calif 披露 OpenJDK Base64 解码器内存破坏漏洞 CVE-2026-114938，CVSS 为 9.2，可导致 RCE。该漏洞影响 OpenJDK 17.0.6 及更高版本，并波及采用相关 Java 运行时的多款产品；利用需 x86-64 CPU、AVX-512 VBMI，ARM64 不受影响。",{"_57":323,"_207":213},"2026-11-18T10:45:57.000Z","Security Affairs","qpgh1pxshbd889atpyfcyweoa","OpenJDK Base64 解码器漏洞 CVE-2026-114938 已修复，RCE 利用受特定 CPU 限制","OpenJDK Base64 解码器内存损坏漏洞 CVE-2026-114938 已由 Oracle 和 OpenJDK 项目修复，目前没有成功攻击证据，但 CISA 强烈建议立即修补。",{"_57":329,"_207":213},"2026-11-18T11:12:12.000Z","Help Net Security","txj5kdwx08v64wngc54j4fqlo","OpenJDK 远程代码执行漏洞 Java4Shell CVE-2026-114938 提前泄露","OpenJDK 内存损坏漏洞 CVE-2026-114938 已在协调披露前泄露，可由未认证攻击者通过单个畸形消息破坏 Java 服务器内存并实现 RCE，受影响版本包括 OpenJDK 17、21、25 和 27。",{"_57":335,"_207":213},"2026-11-18T12:35:00.000Z","Infosecurity Magazine","r5idp638xeh25ay1o0ahw2ys0","Calif 披露 OpenJDK Base64 解码器内存破坏漏洞 Java4Shell（CVE-2026-114938），CVSS 4.0 评分为 9.2，影响 OpenJDK 17.0.6 及更新版本在支持 AVX-512 VBMI 的 x86-64 处理器上处理攻击者可控 Base64 数据的场景，攻击者无需凭据即可触发越界写入并进一步实现堆内存泄露或 RCE。",{"_57":339,"_207":213},"Cloudflare Blog",{"_197":312,"_13":313,"_29":314,"_201":357,"_203":316,"_204":205},{"_197":296,"_13":297,"_29":298,"_201":356,"_203":141,"_204":205},{"_197":279,"_13":280,"_29":281,"_201":355,"_203":283,"_204":205},{"_197":273,"_13":274,"_29":275,"_201":354,"_203":277,"_204":205},{"_197":261,"_13":262,"_29":263,"_201":353,"_203":265,"_204":205},{"_197":249,"_13":250,"_29":251,"_201":352,"_203":253,"_204":205},{"_197":243,"_13":244,"_29":245,"_201":351,"_203":247,"_204":205},{"_197":215,"_13":216,"_29":217,"_201":350,"_203":219,"_204":213},{"_197":198,"_13":199,"_29":200,"_201":349,"_203":22,"_204":205},{"_57":206,"_207":205},{"_57":220,"_207":205},{"_57":248,"_207":205},{"_57":254,"_207":205},{"_57":266,"_207":205},{"_57":278,"_207":205},{"_57":284,"_207":205},{"_57":300,"_207":205},{"_57":317,"_207":205},{"_365":392,"_13":393,"_21":24,"_17":381,"_368":394},{"_365":388,"_13":389,"_21":328,"_17":381,"_368":390},{"_365":384,"_13":385,"_21":265,"_17":167,"_368":386},{"_365":379,"_13":380,"_21":247,"_17":381,"_368":382},{"_365":375,"_13":376,"_21":163,"_17":165,"_368":377},{"_365":371,"_13":372,"_21":219,"_17":156,"_368":373},{"_365":366,"_13":367,"_21":22,"_17":167,"_368":369},"factId","fUP1PwxhxZCs","CISA敦促修补Java关键漏洞","representative",{"_197":198,"_13":199,"_29":200,"_201":370,"_203":22,"_204":205},{"_57":206,"_207":205},"f8X9-lkLyK9M","Rapid7公布Java RCE漏洞报告",{"_197":312,"_13":313,"_29":314,"_201":374,"_203":316,"_204":205},{"_57":317,"_207":205},"fd55XLZ5t838","披露Java4Shell漏洞并发布修复",{"_197":249,"_13":250,"_29":251,"_201":378,"_203":253,"_204":205},{"_57":254,"_207":205},"fy40biG5QM-c","复现OpenJDK Base64解码RCE漏洞",1,{"_197":243,"_13":244,"_29":245,"_201":383,"_203":247,"_204":205},{"_57":248,"_207":205},"fFhKQzwxOQPU","奇安信CERT复现OpenJDK解码器漏洞",{"_197":261,"_13":262,"_29":263,"_201":387,"_203":265,"_204":205},{"_57":266,"_207":205},"fvYpqP97PWxE","Oracle与OpenJDK修复Java4Shell漏洞",{"_197":324,"_13":325,"_29":326,"_201":391,"_203":328,"_204":213},{"_57":329,"_207":213},"fmIHtd44o4WM","Cloudflare发布Java4Shell防护规则",{"_197":336,"_13":32,"_29":337,"_201":395,"_203":24,"_204":205},{"_57":339,"_207":213},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",{"_403":404,"_405":-5},"changelogVersion","2026-10-01T08:00","release"]
