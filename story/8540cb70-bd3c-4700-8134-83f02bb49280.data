[{"_1":2,"_3":4},"root",{"_5":527},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":-5,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48},"expiresAt",1795135249000,"publicId","8540cb70-bd3c-4700-8134-83f02bb49280","title","Java4Shell已出现利用尝试，Red Hat补丁待发","status","active","reportCount",32,"sourceCount",23,"firstReportAt","2026-11-17T12:00:00.000Z","latestAt","2026-11-19T09:10:58.000Z","digest","Calif披露OpenJDK Base64解码器堆越界写漏洞Java4Shell（CVE-2026-114938），Oracle和OpenJDK已修复；该漏洞可造成内存破坏、拒绝服务及远程代码执行（CVSS 4.0 9.2，Oracle CVSS 3.1 8.1）。GreyNoise已记录超过150次符合攻击特征的请求，但未观察到成功入侵，也无法确认目标是否已被攻陷，因此目前只能确认利用尝试，不能确认实际利用。\n\n利用须同时具备OpenJDK 17.0.6及以上受影响版本、支持AVX-512 VBMI等指令集的x86-64处理器，以及处理攻击者可控Base64数据的应用；ARM64和i386不受影响。Calif称默认配置下Keycloak、Jira、Confluence、JFrog Artifactory、Jenkins和PingFederate可实现未认证RCE，但各产品仍需定制利用链。\n\nOracle已提供2026年11月关键补丁更新；Red Hat尚未为RHEL 8、9、10及OpenJDK 17、21、25构建发布修复。无法立即更新时，可使用-XX:-UseBASE64Intrinsics或-XX:UseAVX=2禁用相关加速路径。","digestUpdatedAt","2026-11-20T00:12:40.226Z","summary","excerpt","latest","Java4Shell 漏洞 CVE-2026-114938 已出现利用尝试，多家厂商确认产品受影响","latestReport",{"_278":441},"whyHot",{"_520":210,"_521":522,"_523":524,"_525":286,"_526":501},"developments",[476,477,478,479,480,481,482,483],"officialReports",[458,459,460,461,462,463,464,465,466],"timeline",[246,247,248,249,250,251,252,253,254,255,256,257,258,259,260,261,262,263,264,265,266,267,268,269,270,271,272,273,274,275,276,277],"heat",[73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125],"related",[69],"topics",[49,50,51,52,53,54],{"_55":67,"_57":68},{"_55":65,"_57":66},{"_55":63,"_57":64},{"_55":61,"_57":62},{"_55":59,"_57":60},{"_55":56,"_57":58},"slug","vuln-mgmt","name","漏洞管理","blue-team","蓝队与运营","exploited","在野利用","research","技术研究","oracle","Oracle / 甲骨文","vuln","漏洞披露",{"_11":70,"_13":71,"_72":45},"77bb3813-9c7c-4081-ab57-22a02c65eab5","研究者公开 Java4Shell 利用链：OpenJDK Base64 越界写漏洞","relation",{"_126":244,"_43":245,"_129":240},{"_126":243,"_43":213,"_129":240},{"_126":241,"_43":242,"_129":240},{"_126":239,"_43":216,"_129":240},{"_126":236,"_43":237,"_129":238},{"_126":233,"_43":234,"_129":235},{"_126":230,"_43":231,"_129":232},{"_126":227,"_43":228,"_129":229},{"_126":224,"_43":225,"_129":226},{"_126":222,"_43":223,"_129":219},{"_126":220,"_43":221,"_129":219},{"_126":217,"_43":218,"_129":219},{"_126":214,"_43":215,"_129":216},{"_126":211,"_43":212,"_129":213},{"_126":208,"_43":209,"_129":210},{"_126":206,"_43":207,"_129":130},{"_126":203,"_43":204,"_129":205},{"_126":201,"_43":202,"_129":133},{"_126":199,"_43":200,"_129":133},{"_126":197,"_43":198,"_129":144},{"_126":195,"_43":196,"_129":144},{"_126":193,"_43":194,"_129":144},{"_126":191,"_43":192,"_129":144},{"_126":189,"_43":190,"_129":144},{"_126":187,"_43":188,"_129":144},{"_126":185,"_43":186,"_129":144},{"_126":183,"_43":184,"_129":144},{"_126":181,"_43":182,"_129":144},{"_126":179,"_43":180,"_129":144},{"_126":177,"_43":178,"_129":144},{"_126":175,"_43":176,"_129":144},{"_126":173,"_43":174,"_129":144},{"_126":171,"_43":172,"_129":144},{"_126":169,"_43":170,"_129":144},{"_126":167,"_43":168,"_129":20},{"_126":165,"_43":166,"_129":20},{"_126":163,"_43":164,"_129":20},{"_126":161,"_43":162,"_129":20},{"_126":159,"_43":160,"_129":20},{"_126":157,"_43":158,"_129":20},{"_126":155,"_43":156,"_129":144},{"_126":153,"_43":154,"_129":144},{"_126":151,"_43":152,"_129":144},{"_126":149,"_43":150,"_129":144},{"_126":147,"_43":148,"_129":144},{"_126":145,"_43":146,"_129":144},{"_126":142,"_43":143,"_129":144},{"_126":140,"_43":141,"_129":133},{"_126":138,"_43":139,"_129":133},{"_126":136,"_43":137,"_129":133},{"_126":134,"_43":135,"_129":133},{"_126":131,"_43":132,"_129":133},{"_126":127,"_43":128,"_129":130},"hour","2026-11-20T00:00:00.000Z",68.6,"participants",19,"2026-