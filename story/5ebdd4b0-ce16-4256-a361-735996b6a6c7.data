[{"_1":2,"_3":4},"root",{"_5":270},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795653656000,"publicId","5ebdd4b0-ce16-4256-a361-735996b6a6c7","title","OpenAI与Cisco开源Shirudo临时防护工具","status","active","reportCount",7,"sourceCount","firstReportAt","2026-11-24T06:00:50.000Z","latestAt","2026-11-25T22:30:21.000Z","digest","OpenAI与Cisco已开源Linux运行时工具Shirudo，可在永久补丁上线前通过eBPF部署临时“shield”，阻断特定漏洞利用且无需重启服务；项目仍处预发布阶段，尚不适合生产使用，也并非漏洞补丁。\n\n每项shield须经操作人员批准，加载前经过加密签名和验证。项目构建方称，在其设计的受控实验中，Codex生成的防护在不停机的情况下阻止了针对运行中Elasticsearch服务的Java4Shell利用尝试，但该结果不是独立评估。生产部署需要Shirudo内核补丁、特定Linux内核能力及TPM 2.0；Isovalent工程师John Fastabend称，其团队常遇到没有合适内核挂载位置的漏洞，限制此类临时防护的适用范围。","digestUpdatedAt","2026-11-25T23:29:38.623Z","summary","excerpt","latest","OpenAI 与 Cisco 的 Shirudo 探索自防御系统架构：运行时 eBPF 控制","latestReport",{"_207":247},"whyHot",{"_264":18,"_265":261,"_266":261,"_267":268,"_269":191},"developments",[251,252],"officialReports",[],"timeline",[200,201,202,203,204,205,206],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","ai-agent","name","AI Agent 安全","vuln-mgmt","漏洞管理","kernel","内核与系统","ai-security","AI 安全","tools","工具与平台","cisco","Cisco / 思科",{"_110":198,"_42":199,"_113":191},{"_110":196,"_42":197,"_113":191},{"_110":194,"_42":195,"_113":191},{"_110":192,"_42":193,"_113":191},{"_110":189,"_42":190,"_113":191},{"_110":186,"_42":187,"_113":188},{"_110":183,"_42":184,"_113":185},{"_110":181,"_42":182,"_113":118},{"_110":179,"_42":180,"_113":118},{"_110":177,"_42":178,"_113":118},{"_110":175,"_42":176,"_113":118},{"_110":173,"_42":174,"_113":1