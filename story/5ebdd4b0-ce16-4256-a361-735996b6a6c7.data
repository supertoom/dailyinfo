7,"2026-11-24T18:00:00.000Z",48.4,"2026-11-24T17:00:00.000Z",49.8,"2026-11-24T16:00:00.000Z",51.3,"2026-11-24T15:00:00.000Z",52.8,"2026-11-24T14:00:00.000Z",54.3,"2026-11-24T13:00:00.000Z",45.8,5,"2026-11-24T12:00:00.000Z",26.8,3,"2026-11-24T11:00:00.000Z",17.3,2,"2026-11-24T10:00:00.000Z",17.8,"2026-11-24T09:00:00.000Z",18.4,"2026-11-24T08:00:00.000Z",18.9,"2026-11-24T07:00:00.000Z",19.4,{"_207":247,"_13":31,"_28":248,"_211":249,"_213":23,"_214":215},{"_207":241,"_13":242,"_28":243,"_211":244,"_213":245,"_214":215},{"_207":235,"_13":236,"_28":237,"_211":238,"_213":239,"_214":215},{"_207":229,"_13":230,"_28":231,"_211":232,"_213":233,"_214":215},{"_207":224,"_13":225,"_28":226,"_211":227,"_213":186,"_214":215},{"_207":218,"_13":219,"_28":220,"_211":221,"_213":222,"_214":215},{"_207":208,"_13":209,"_28":210,"_211":212,"_213":21,"_214":215},"id","qcifuaiqaa3v2zr8gj5s4e3wt","OpenAI 与 Cisco 开源发布 Linux 临时防护工具 Shirudo","OpenAI 与 Cisco 发布开源工具 Shirudo，可为尚未修复漏洞的 Linux 系统临时部署防护，并在不重启服务的情况下阻断漏洞依赖的特定行为。每项防护均需操作人员批准，采用 eBPF 构建、经过加密签名和加载前检查，并由 TPM 2.0 记录加载与移除情况。","source",{"_56":216,"_217":215},"publishedAt","selected",false,"Help Net Security","firstParty","cnyzun8zemr0ev2q2xf78cifw","OpenAI 与 Cisco 开源 Linux 运行时 Shirudo，用 AI 生成 eBPF 防护在补丁前阻断利用","OpenAI 与 Cisco 联合推出开源 Linux 运行时 Shirudo（日语意为 shield），允许 AI agent 在不停机的情况下通过 eBPF 动态生成防护，阻断漏洞利用并为补丁测试与上线争取时间。",{"_56":223,"_217":215},"2026-11-24T06:02:57.000Z","The Hacker News","hhguzy29ye9rocr3pof1fyten","OpenAI 与 Cisco 发布开源 Linux 防护工具 Shirudo","OpenAI 与 Cisco 发布开源 Linux 安全工具 Shirudo，用于在安装永久补丁前临时阻止已知漏洞被利用，并可在不重启系统的情况下保护在线服务。",{"_56":228,"_217":215},"Infosecurity Magazine","gf222z6wrk74rf3itdmhpqxrj","OpenAI 与 Cisco 发布开源工具 Shirudo，以 AI Agent 防护未修补 Linux 漏洞","OpenAI 与 Cisco 发布开源安全平台 Shirudo，利用 AI Agent 分析漏洞信息、生成并测试“shields”，借助 eBPF 修改 Linux 内核行为，无需重启操作系统即可阻止漏洞利用。",{"_56":234,"_217":215},"2026-11-24T12:20:41.000Z","SecurityWeek","d2i1zkdux56n9dx8ow274ibp3","OpenAI、Cisco 免费发布 Linux 防护工具，或冲击网络安全初创企业","OpenAI、Cisco 免费发布面向 Linux 的安全防护工具，可识别并缓解威胁。其免费策略可能为网络安全初创企业带来竞争压力，但正文未提供产品名称、版本、漏洞编号、CVSS 分数、部署前提或利用情况。",{"_56":240,"_217":215},"2026-11-24T12:34:00.000Z","Cybernews","toasavtd5k2pms4o21leewoq5","OpenAI 与 Cisco 发布开源工具 Shirudo，以 AI 和 eBPF 临时保护 Linux 系统","OpenAI 与 Cisco 发布开源 Linux 安全工具 Shirudo，利用 eBPF 部署可签名的临时运行时防护，在管理员准备补丁期间无需重启服务即可阻断漏洞利用。",{"_56":246,"_217":215},"2026-11-24T13:34:23.000Z","BleepingComputer","upt5j5hlh2oenbz5d4azhqrkz","OpenAI 与 Cisco 的 Shirudo 项目探索自防御系统，通过运行时 eBPF 控制，让智能体能够生成、验证、签名并应用控制措施，且无需关闭主机。其目标是以机器速度作出响应并保持服务持续运行，核心理念是避免策略执行与业务运行发生冲突。",{"_56":250,"_217":215},"Horizon3.ai",{"_253":259,"_13":260,"_20":23,"_17":261,"_256":262},{"_253":254,"_13":255,"_20":21,"_17":118,"_256":257},"factId","f77V7HNr0juM","OpenAI与Cisco发布Shirudo临时防护工具","representative",{"_207":241,"_13":242,"_28":243,"_211":258,"_213":245,"_214":215},{"_56":246,"_217":215},"fgUHY6mygcoU","介绍AI智能体自防御架构",1,{"_207":247,"_13":31,"_28":248,"_211":263,"_213":23,"_214":215},{"_56":250,"_217":215},"participants48h","newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_271":272,"_273":-5},"changelogVersion","2026-10-01T08:00","release"]
