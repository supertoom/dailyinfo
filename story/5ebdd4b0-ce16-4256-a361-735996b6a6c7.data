[{"_1":2,"_3":4},"root",{"_5":186},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795567297000,"publicId","5ebdd4b0-ce16-4256-a361-735996b6a6c7","title","OpenAI与Cisco开源Shirudo临时防护工具","status","active","reportCount",6,"sourceCount","firstReportAt","2026-11-24T06:00:50.000Z","latestAt","2026-11-24T13:34:23.000Z","digest","OpenAI与Cisco已开源Linux运行时工具Shirudo，可在永久补丁上线前通过eBPF部署临时“shield”，阻断特定漏洞利用且无需重启服务；项目仍处预发布阶段，尚不适合生产使用，也并非漏洞补丁。\n\n每项shield须经操作人员批准，加载前经过加密签名和验证。项目构建方称，在其设计的受控实验中，Codex生成的防护在不停机的情况下阻止了针对运行中Elasticsearch服务的Java4Shell利用尝试，但该结果不是独立评估。生产部署需要Shirudo内核补丁、特定Linux内核能力及TPM 2.0；Isovalent工程师John Fastabend称，其团队常遇到没有合适内核挂载位置的漏洞，限制此类临时防护的适用范围。","digestUpdatedAt","2026-11-24T13:50:52.981Z","summary","excerpt","latest","OpenAI 与 Cisco 发布开源工具 Shirudo，以 AI 和 eBPF 临时保护 Linux 系统","latestReport",{"_133":167},"whyHot",{"_178":18,"_179":180,"_181":18,"_182":183,"_184":185},"developments",[171],"officialReports",[],"timeline",[127,128,129,130,131,132],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","ai-agent","name","AI Agent 安全","vuln-mgmt","漏洞管理","kernel","内核与系统","ai-security","AI 安全","tools","工具与平台","cisco","Cisco / 思科",{"_86":125,"_42":126,"_89":118},{"_86":123,"_42":124,"_89":118},{"_86":121,"_42":122,"_89":118},{"_86":119,"_42":120,"_89":118},{"_86":116,"_42":117,"_89":118},{"_86":113,"_42":114,"_89":115},{"_86":110,"_42":111,"_89":112},{"_86":108,"_42":109,"_89":18},{"_86":106,"_42":107,"_89":18},{"_86":104,"_42":105,"_89":18},{"_86":102,"_42":103,"_89":18},{"_86":100,"_42":101,"_89":18},{"_86":98,"_42":99,"_89":18},{"_86":96,"_42":97,"_89":18},{"_86":94,"_42":95,"_89":18},{"_86":92,"_42":93,"_89":18},{"_86":90,"_42":91,"_89":18},{"_86":87,"_42":88,"_89":18},"hour","2026-11-25T00:00:00.000Z",40.7,"participants","2026-11-24T23:00:00.000Z",41.9,"2026-11-24T22:00:00.000Z",43.1,"2026-11-24T21:00:00.000Z",44.4,"2026-11-24T20:00:00.000Z",45.7,"2026-11-24T19:00:00.000Z",47,"2026-11-24T18:00:00.000Z",48.4,"2026-11-24T17:00:00.000Z",49.8,"2026-11-24T16:00:00.000Z",51.3,"2026-11-24T15:00:00.000Z",52.8,"2026-11-24T14:00:00.000Z",54.3,"2026-11-24T13:00:00.000Z",45.8,5,"2026-11-24T12:00:00.000Z",26.8,3,"2026-11-24T11:00:00.000Z",17.3,2,"2026-11-24T10:00:00.000Z",17.8,"2026-11-24T09:00:00.000Z",18.4,"2026-11-24T08:00:00.000Z",18.9,"2026-11-24T07:00:00.000Z",19.4,{"_133":167,"_13":31,"_28":168,"_137":169,"_139":23,"_140":141},{"_133":161,"_13":162,"_28":163,"_137":164,"_139":165,"_140":141},{"_133":155,"_13":156,"_28":157,"_137":158,"_139":159,"_140":141},{"_133":150,"_13":151,"_28":152,"_137":153,"_139":113,"_140":141},{"_133":144,"_13":145,"_28":146,"_137":147,"_139":148,"_140":141},{"_133":134,"_13":135,"_28":136,"_137":138,"_139":21,"_140":141},"id","qcifuaiqaa3v2zr8gj5s4e3wt","OpenAI 与 Cisco 开源发布 Linux 临时防护工具 Shirudo","OpenAI 与 Cisco 发布开源工具 Shirudo，可为尚未修复漏洞的 Linux 系统临时部署防护，并在不重启服务的情况下阻断漏洞依赖的特定行为。每项防护均需操作人员批准，采用 eBPF 构建、经过加密签名和加载前检查，并由 TPM 2.0 记录加载与移除情况。","source",{"_56":142,"_143":141},"publishedAt","selected",false,"Help Net Security","firstParty","cnyzun8zemr0ev2q2xf78cifw","OpenAI 与 Cisco 开源 Linux 运行时 Shirudo，用 AI 生成 eBPF 防护在补丁前阻断利用","OpenAI 与 Cisco 联合推出开源 Linux 运行时 Shirudo（日语意为 shield），允许 AI agent 在不停机的情况下通过 eBPF 动态生成防护，阻断漏洞利用并为补丁测试与上线争取时间。",{"_56":149,"_143":141},"2026-11-24T06:02:57.000Z","The Hacker News","hhguzy29ye9rocr3pof1fyten","OpenAI 与 Cisco 发布开源 Linux 防护工具 Shirudo","OpenAI 与 Cisco 发布开源 Linux 安全工具 Shirudo，用于在安装永久补丁前临时阻止已知漏洞被利用，并可在不重启系统的情况下保护在线服务。",{"_56":154,"_143":141},"Infosecurity Magazine","gf222z6wrk74rf3itdmhpqxrj","OpenAI 与 Cisco 发布开源工具 Shirudo，以 AI Agent 防护未修补 Linux 漏洞","OpenAI 与 Cisco 发布开源安全平台 Shirudo，利用 AI Agent 分析漏洞信息、生成并测试“shields”，借助 eBPF 修改 Linux 内核行为，无需重启操作系统即可阻止漏洞利用。",{"_56":160,"_143":141},"2026-11-24T12:20:41.000Z","SecurityWeek","d2i1zkdux56n9dx8ow274ibp3","OpenAI、Cisco 免费发布 Linux 防护工具，或冲击网络安全初创企业","OpenAI、Cisco 免费发布面向 Linux 的安全防护工具，可识别并缓解威胁。其免费策略可能为网络安全初创企业带来竞争压力，但正文未提供产品名称、版本、漏洞编号、CVSS 分数、部署前提或利用情况。",{"_56":166,"_143":141},"2026-11-24T12:34:00.000Z","Cybernews","toasavtd5k2pms4o21leewoq5","OpenAI 与 Cisco 发布开源 Linux 安全工具 Shirudo，利用 eBPF 部署可签名的临时运行时防护，在管理员准备补丁期间无需重启服务即可阻断漏洞利用。",{"_56":170,"_143":141},"BleepingComputer",{"_172":173,"_13":174,"_20":21,"_17":18,"_175":176},"factId","f77V7HNr0juM","OpenAI与Cisco发布Shirudo临时防护工具","representative",{"_133":167,"_13":31,"_28":168,"_137":177,"_139":23,"_140":141},{"_56":170,"_143":141},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete",true,"rank",1,{"_187":188,"_189":-5},"changelogVersion","2026-10-01T08:00","release"]
