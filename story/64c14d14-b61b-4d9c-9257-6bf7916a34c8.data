[{"_1":2,"_3":4},"root",{"_5":154},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795221647000,"publicId","64c14d14-b61b-4d9c-9257-6bf7916a34c8","title","Ruby修复堆越界写入RCE漏洞","status","active","reportCount",4,"sourceCount","firstReportAt","2026-11-19T17:06:00.000Z","latestAt","2026-11-20T20:24:38.000Z","digest","Ruby官方已修复堆缓冲区溢出远程代码执行漏洞 CVE-2026-132825（CVSS 7.4），官方称暂无已知利用且POC未公开；受影响版本为Ruby 2.4.0 至 3.3.13、3.4.0 至 3.4.12、4.0.0 至 4.0.9，修复版本为3.3.14、3.4.13和4.0.10。\n\n该漏洞为字符串大小写转换中的一字节堆越界写入。应用需处理含“ß”的ISO-8859-1、Windows-1252等单字节编码不可信输入并执行大小写转换才会触发，UTF-8路径不受影响；深瞳漏洞实验室称Rails和经典模式Sinatra默认配置即满足条件，无需认证。升级前应避免此类转换或先转为UTF-8；Cloudflare已默认启用WAF阻断规则，但称其仅是补偿措施，完整修复仍须升级Ruby。","digestUpdatedAt","2026-11-20T20:33:11.554Z","summary","excerpt","latest","Cloudflare WAF 防护 ruby2shell 漏洞 CVE-2026-132825 及 GHSA-87fm-7w84-j2px","latestReport",{"_96":120},"whyHot",{"_149":18,"_150":136,"_151":83,"_152":107,"_153":142},"developments",[130,131,132],"officialReports",[124,125,126],"timeline",[92,93,94,95],"heat",[62,63,64,65,66,67,68,69,70],"related",[],"topics",[48,49,50,51],{"_52":60,"_54":61},{"_52":58,"_54":59},{"_52":56,"_54":57},{"_52":53,"_54":55},"slug","cloud-native","name","云与原生","cloudflare","Cloudflare","research","技术研究","vuln","漏洞披露",{"_71":90,"_42":91,"_74":83},{"_71":88,"_42":89,"_74":83},{"_71":86,"_42":87,"_74":83},{"_71":84,"_42":85,"_74":83},{"_71":81,"_42":82,"_74":83},{"_71":79,"_42":80,"_74":18},{"_71":77,"_42":78,"_74":18},{"_71":75,"_42":76,"_74":18},{"_71":72,"_42":73,"_74":18},"hour","2026-11-21T00:00:00.000Z",25.3,"participants","2026-11-20T23:00:00.000Z",26,"2026-11-20T22:00:00.000Z",26.8,"2026-11-20T21:00:00.000Z",27.6,"2026-11-20T20:00:00.000Z",18.3,3,"2026-11-20T19:00:00.000Z",18.8,"2026-11-20T18:00:00.000Z",19.4,"2026-11-20T17:00:00.000Z",19.9,"2026-11-20T16:00:00.000Z",20.5,{"_96":120,"_13":31,"_28":121,"_100":122,"_102":23,"_103":107},{"_96":114,"_13":115,"_28":116,"_100":117,"_102":118,"_103":107},{"_96":108,"_13":109,"_28":110,"_100":111,"_102":112,"_103":104},{"_96":97,"_13":98,"_28":99,"_100":101,"_102":21,"_103":104},"id","bl7fd1dy4h6jvih89hic6n327","Ruby 堆缓冲区溢出远程代码执行漏洞 CVE-2026-132825 已发布修复","Ruby 修复堆缓冲区溢出远程代码执行漏洞 CVE-2026-132825。该缺陷源于处理某些单字节编码字符串大小写转换时，输出缓冲区边界检查未覆盖实际写入长度，可造成一字节堆越界写。","source",{"_54":105,"_106":107},"publishedAt","selected",false,"微步在线研究响应中心","firstParty",true,"m0fgnwuz8jy2ixu23xvd4pojv","Ruby 远程代码执行漏洞 CVE-2026-132825 影响 2.4.0 至 4.0.9","Ruby 远程代码执行漏洞 CVE-2026-132825 影响 2.4.0 至 3.3.13、3.4.0 至 3.4.12 和 4.0.0 至 4.0.9，CVSS 评分为 7.4。",{"_54":113,"_106":107},"2026-11-20T03:35:00.000Z","绿盟科技CERT","rv2ecm55xe5ces92lza6gmsz6","Ruby 字符串大小写转换堆越界写入漏洞 CVE-2026-132825 存在 RCE 风险","Ruby 字符串大小写转换函数存在堆缓冲区越界写入漏洞（CVE-2026-132825），影响 Ruby < 3.3.14、Ruby 3.4.0 - 3.4.12 和 Ruby 4.0.0 - 4.0.9，威胁等级为高危。",{"_54":119,"_106":107},"2026-11-20T09:49:00.000Z","深信服千里目安全实验室","jszry2ckucax402ve9a7rmc3m","Cloudflare WAF 已为 ruby2shell（CVE-2026-132825）及相关整数溢出 GHSA-87fm-7w84-j2px 启用默认阻断规则，Free 计划自动生效，付费计划需确认 Cloudflare Managed Ruleset 已部署。",{"_54":123,"_106":104},"Cloudflare Blog",{"_96":114,"_13":115,"_28":116,"_100":129,"_102":118,"_103":107},{"_96":108,"_13":109,"_28":110,"_100":128,"_102":112,"_103":104},{"_96":97,"_13":98,"_28":99,"_100":127,"_102":21,"_103":104},{"_54":105,"_106":107},{"_54":113,"_106":107},{"_54":119,"_106":107},{"_133":145,"_13":146,"_20":23,"_17":136,"_137":147},{"_133":140,"_13":141,"_20":112,"_17":142,"_137":143},{"_133":134,"_13":135,"_20":21,"_17":136,"_137":138},"factId","ffKJxPu8oDdQ","Ruby修复堆缓冲区溢出漏洞",1,"representative",{"_96":97,"_13":98,"_28":99,"_100":139,"_102":21,"_103":104},{"_54":105,"_106":107},"f6WA2ackQ-jM","发布Ruby堆越界写入漏洞通告",2,{"_96":114,"_13":115,"_28":116,"_100":144,"_102":118,"_103":107},{"_54":119,"_106":107},"fc5y6ah56Em0","Cloudflare披露ruby2shell及WAF防护措施",{"_96":120,"_13":31,"_28":121,"_100":148,"_102":23,"_103":107},{"_54":123,"_106":104},"participants48h","newParticipants6h","recentReports24h","observationComplete","rank",{"_155":156,"_157":-5},"changelogVersion","2026-10-01T08:00","release"]
