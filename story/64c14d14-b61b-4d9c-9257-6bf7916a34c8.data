[{"_1":2,"_3":4},"root",{"_5":227},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795308047000,"publicId","64c14d14-b61b-4d9c-9257-6bf7916a34c8","title","Ruby修复堆越界写入RCE漏洞","status","watching","reportCount",4,"sourceCount","firstReportAt","2026-11-19T17:06:00.000Z","latestAt","2026-11-20T20:24:38.000Z","digest","Ruby官方已修复堆缓冲区溢出远程代码执行漏洞 CVE-2026-132825（CVSS 7.4），官方称暂无已知利用且POC未公开；受影响版本为Ruby 2.4.0 至 3.3.13、3.4.0 至 3.4.12、4.0.0 至 4.0.9，修复版本为3.3.14、3.4.13和4.0.10。\n\n该漏洞为字符串大小写转换中的一字节堆越界写入。应用需处理含“ß”的ISO-8859-1、Windows-1252等单字节编码不可信输入并执行大小写转换才会触发，UTF-8路径不受影响；深瞳漏洞实验室称Rails和经典模式Sinatra默认配置即满足条件，无需认证。升级前应避免此类转换或先转为UTF-8；Cloudflare已默认启用WAF阻断规则，但称其仅是补偿措施，完整修复仍须升级Ruby。","digestUpdatedAt","2026-11-20T20:33:11.554Z","summary","excerpt","latest","Cloudflare WAF 防护 ruby2shell 漏洞 CVE-2026-132825 及 GHSA-87fm-7w84-j2px","latestReport",{"_168":192},"whyHot",{"_221":99,"_222":223,"_224":223,"_225":179,"_226":18},"developments",[202,203,204],"officialReports",[196,197,198],"timeline",[164,165,166,167],"heat",[62,63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94],"related",[],"topics",[48,49,50,51],{"_52":60,"_54":61},{"_52":58,"_54":59},{"_52":56,"_54":57},{"_52":53,"_54":55},"slug","cloud-native","name","云与原生","cloudflare","Cloudflare","research","技术研究","vuln","漏洞披露",{"_95":162,"_42":163,"_98":99},{"_95":160,"_42":161,"_98":99},{"_95":158,"_42":159,"_98":99},{"_95":156,"_42":157,"_98":99},{"_95":154,"_42":155,"_98":99},{"_95":152,"_42":153,"_98":18},{"_95":150,"_42":151,"_98":18},{"_95":148,"_42":149,"_98":18},{"_95":146,"_42":147,"_98":18},{"_95":144,"_42":145,"_98":18},{"_95":142,"_42":143,"_98":18},{"_95":140,"_42":141,"_98":18},{"_95":138,"_42":139,"_98":18},{"_95":136,"_42":137,"_98":18},{"_95":134,"_42":135,"_98":18},{"_95":132,"_42":133