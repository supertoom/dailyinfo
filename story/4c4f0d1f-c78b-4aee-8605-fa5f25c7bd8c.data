[{"_1":2,"_3":4},"root",{"_5":221},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":-5,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48},"expiresAt",1794530497000,"publicId","4c4f0d1f-c78b-4aee-8605-fa5f25c7bd8c","title","SCKit攻击波及48家机构端点","status","active","reportCount",7,"sourceCount",4,"firstReportAt","2026-11-11T22:56:21.000Z","latestAt","2026-11-12T22:53:10.000Z","digest","ConnectWise 正在调查攻击者劫持托管服务提供商（MSP）的 ScreenConnect 环境，通过 Run Command 向客户托管端点投放 SCKit 恶意客户端；Huntress 已确认至少 48 家组织的 288 个端点受影响，恶意客户端可建立持久后门。ConnectWise 已在约 400 个 ScreenConnect 环境中禁用 Labtech Plus、RMM Plus、RMM+、RMM Plus Password Link 和 RMM+ Password Link 五个扩展。\n\nBlackpoint Cyber 称，SCKit 利用 ScreenConnect 的鉴权绕过漏洞 CVE-2026-84869（CVSS 9.9）在活跃远程会话中实现未授权文件传输和执行；其测试确认现有补丁可阻止该利用，且未观察到攻击成功利用该漏洞或绕过补丁。初始访问是否来自恶意第三方扩展仍缺乏充分证据，补丁也不能消除已认证操作员会话遭劫持的风险；目前没有证据显示恶意软件已从受感染端点成功传播至技术员工作站。","digestUpdatedAt","2026-11-12T23:42:02.257Z","summary","excerpt","latest","SCKit 蠕虫式恶意软件借 ScreenConnect 攻击 MSP，尝试反向感染技术人员","latestReport",{"_154":194},"whyHot",{"_214":20,"_215":216,"_217":218,"_219":162,"_220":124},"developments",[197,198,199],"officialReports",[],"timeline",[147,148,149,150,151,152,153],"heat",[69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93],"related",[],"topics",[49,50,51,52,53,54],{"_55":67,"_57":68},{"_55":65,"_57":66},{"_55":63,"_57":64},{"_55":61,"_57":62},{"_55":59,"_57":60},{"_55":56,"_57":58},"slug","identity","name","身份与访问","microsoft","Microsoft / 微软","exploited","在野利用","supply-chain","供应链安全","malware","恶意软件","attack","攻击活动",{"_94":145,"_43":146,"_97":138},{"_94":143,"_43":144,"_97":138},{"_94":141,"_43":142,"_97":138},{"_94":139,"_43":140,"_97":138},{"_94":136,"_43":137,"_97":138},{"_94":134,"_43":135,"_97":127},{"_94":132,"_43":133,"_97":127},{"_94":130,"_43":131,"_97":127},{"_94":128,"_43":129,"_97":127},{"_94":125,"_43":126,"_97":127},{"_94":122,"_43":123,"_97":124},{"_94":120,"_43":121,"_97":20},{"_94":118,"_43":119,"_97":20},{"_94":116,"_43":117,"_97":20},{"_94":114,"_43":115,"_97":20},{"_94":112,"_43":113,"_97":20},{"_94":110,"_43":111,"_97":20},{"_94":109,"_43":99,"_97":20},{"_94":108,"_43":96,"_97":20},{"_94":106,"_43":107,"_97":20},{"_94":104,"_43":105,"_97":20},{"_94":102,"_43":103,"_97":20},{"_94":100,"_43":101,"_97":20},{"_94":98,"_43":99,"_97":20},{"_94":95,"_43":96,"_97":20},"hour","2026-11-13T00:00:00.000Z",30.4,"participants","2026-11-12T23:00:00.000Z",31.3,"2026-11-12T22:00:00.000Z",27.1,"2026-11-12T21:00:00.000Z",27.9,"2026-11-12T20:00:00.000Z",28.7,"2026-11-12T19:00:00.000Z",29.6,"2026-11-12T18:00:00.000Z","2026-11-12T17:00:00.000Z","2026-11-12T16:00:00.000Z",32.2,"2026-11-12T15:00:00.000Z",33.2,"2026-11-12T14:00:00.000Z",34.2,"2026-11-12T13:00:00.000Z",33,"2026-11-12T12:00:00.000Z",33.9,"2026-11-12T11:00:00.000Z",34.9,"2026-11-12T10:00:00.000Z",25.8,3,"2026-11-12T09:00:00.000Z",16.3,2,"2026-11-12T08:00:00.000Z",16.8,"2026-11-12T07:00:00.000Z",17.3,"2026-11-12T06:00:00.000Z",17.8,"2026-11-12T05:00:00.000Z",18.3,"2026-11-12T04:00:00.000Z",8.6,1,"2026-11-12T03:00:00.000Z",8.9,"2026-11-12T02:00:00.000Z",9.2,"2026-11-12T01:00:00.000Z",9.4,"2026-11-12T00:00:00.000Z",9.7,{"_154":194,"_13":32,"_29":195,"_158":196,"_160":24,"_161":162},{"_154":189,"_13":190,"_29":191,"_158":192,"_160":193,"_161":165},{"_154":184,"_13":185,"_29":186,"_158":187,"_160":188,"_161":162},{"_154":178,"_13":179,"_29":180,"_158":181,"_160":182,"_161":162},{"_154":172,"_13":173,"_29":174,"_158":175,"_160":176,"_161":165},{"_154":166,"_13":167,"_29":168,"_158":169,"_160":170,"_161":162},{"_154":155,"_13":156,"_29":157,"_158":159,"_160":22,"_161":162},"id","ihb325l23pcss0skikvuxyfi2","ConnectWise 调查针对 MSP 的 ScreenConnect 恶意软件活动，47 家组织受影响","ConnectWise 正在调查一场针对托管服务提供商（MSP）的活跃恶意软件活动，攻击者利用遭入侵的 ScreenConnect 环境，通过 Run Command 功能向客户设备部署非法远程客户端。","source",{"_57":163,"_164":165},"publishedAt","selected",true,"BleepingComputer","firstParty",false,"uml0y1md3aixvjr0xjtezpm2e","ScreenConnect 攻击波及至少 48 家组织的 288 个端点，恶意客户端建立持久后门","攻击者利用被入侵或劫持的 ScreenConnect 面板会话，通过 Run Command 部署恶意 ScreenConnect 客户端，至少影响 48 家组织的 288 个托管端点。",{"_57":171,"_164":165},"2026-11-12T04:39:48.000Z","The Hacker News","gsi2mguh5cqxnstutf6byouzw","ScreenConnect 遭黑客劫持，IT firms 及其客户面临远程控制风险","ConnectWise 警告 ScreenConnect 劫持活动正在扩散，IT firms 及其客户可能遭到攻击并被夺取远程控制。正文未提供受影响版本、CVE 编号、CVSS 分数、认证要求、补丁状态或已确认利用细节。",{"_57":177,"_164":165},"2026-11-12T09:46:00.000Z","Cybernews","rj9u9s3oymbuwkube0wosddcn","攻击者利用 RMM+ 认证绕过攻击 ScreenConnect，288 台主机遭植入 SCKit","Huntress 观察到攻击者利用 RMM+ 认证绕过漏洞入侵 ConnectWise ScreenConnect，至少影响 6 家 MSP、48 家组织的 288 台主机，并在 90 分钟内完成命令投递。",{"_57":183,"_164":165},"2026-11-12T10:39:34.000Z","SecurityWeek","os7855wmu7u8h554m5er9zy6t","SCKit 利用 ConnectWise ScreenConnect 扩展与已认证会话攻击 MSP","Blackpoint Cyber 分析 SCKit 恶意软件活动，指出其可能借助恶意 ScreenConnect 第三方扩展取得初始访问，再利用工具包中的 CVE-2026-84869 利用代码或已认证操作员会话，通过 Run Command 分发 sc.msi、sckit-run.bat 和 PowerShell 组件。",{"_57":171,"_164":165},"2026-11-12T13:08:28.000Z","t6aiahmvz3dom3wx1doqs9jp4","Action1 分析端点管理平台被攻陷后的安全风险，ETP 用独立加密授权保护高风险操作","Action1 指出，端点管理平台一旦被攻陷，攻击者可借其权限分发恶意软件、执行命令、关闭安全控制并波及整个组织，文中列举了 BeyondTrust Bomgar、SimpleHelp、ConnectWise ScreenConnect、Microsoft Intune 等多起事件。",{"_57":163,"_164":165},"2026-11-12T15:00:10.000Z","h2occksxu7q3tzi57634syb7r","SCKit 是由 16 个脚本和组件组成的蠕虫式工具包，目标是在近期针对托管服务提供商（MSP）的 ScreenConnect 攻击中建立持久访问并横向扩散。",{"_57":163,"_164":165},{"_200":210,"_13":211,"_21":188,"_17":127,"_203":212},{"_200":206,"_13":207,"_21":170,"_17":127,"_203":208},{"_200":201,"_13":202,"_21":22,"_17":127,"_203":204},"factId","fuF9lrapn3js","ScreenConnect攻击活动入侵MSP","representative",{"_154":155,"_13":156,"_29":157,"_158":205,"_160":22,"_161":162},{"_57":163,"_164":165},"fe11_palkB6U","攻击者利用ScreenConnect部署恶意客户端",{"_154":178,"_13":179,"_29":180,"_158":209,"_160":182,"_161":162},{"_57":183,"_164":165},"fVVoyiSN8gs4","披露SCKit劫持ScreenConnect活动",{"_154":194,"_13":32,"_29":195,"_158":213,"_160":24,"_161":162},{"_57":163,"_164":165},"participants48h","newParticipants6h",0,"recentReports24h",5,"observationComplete","rank",{"_222":223,"_224":-5},"changelogVersion","2026-10-01T08:00","release"]
