[{"_1":2,"_3":4},"root",{"_5":295},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":-5,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48},"expiresAt",1794616838000,"publicId","4c4f0d1f-c78b-4aee-8605-fa5f25c7bd8c","title","SCKit攻击波及48家机构288个端点","status","active","reportCount",8,"sourceCount",5,"firstReportAt","2026-11-11T22:56:21.000Z","latestAt","2026-11-13T21:31:44.000Z","digest","ConnectWise 确认攻击者利用托管服务商（MSP）的 ScreenConnect 实例，通过 Run Command 向客户设备投放 SCKit 恶意蠕虫及未授权远程客户端，至少影响 48 家机构的 288 个受管端点，受害设备在 90 分钟内遭投递。Huntress 此前称有 47 家组织受影响，更新后确认为 48 家。Microsoft Threat Intelligence 也确认了相关活动。\n\n初始入口尚未查清。ConnectWise 正调查恶意第三方扩展是否被滥用，早先 Huntress 的遥测指向凭据泄露或被劫持的操作员会话；ConnectWise 已禁用约 400 个 ScreenConnect 环境中的 Labtech Plus、RMM Plus、RMM+、RMM Plus Password Link 和 RMM+ Password Link 五个扩展。\n\nSCKit 含 16 个脚本和组件，设计为在技术人员连接感染设备时反向扩散；其利用 CVE-2026-84869（CVSS 9.9），即权限管理不当和缺失授权漏洞。ConnectWise 已于 2026 年 9 月 8 日发布修复，ScreenConnect 客户端 26.6.5 及以上版本可阻断该传播技术。Huntress 与 Blackpoint Cyber 均未发现本轮攻击成功利用该漏洞，也没有证据显示恶意软件已成功传播至技术人员工作站或绕过补丁；但补丁不能消除操作员会话被攻陷的风险。","digestUpdatedAt","2026-11-14T00:07:49.535Z","summary","excerpt","latest","SCKit滥用ScreenConnect入侵MSP客户环境并攻击技术支持工作站","latestReport",{"_224":269},"whyHot",{"_290":20,"_291":207,"_292":207,"_293":232,"_294":193},"developments",[273,274,275],"officialReports",[],"timeline",[216,217,218,219,220,221,222,223],"heat",[69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117],"related",[],"topics",[49,50,51,52,53,54],{"_55":67,"_57":68},{"_55":65,"_57":66},{"_55":63,"_57":64},{"_55":61,"_57":62},{"_55":59,"_57":60},{"_55":56,"_57":58},"slug","identity","name","身份与访问","microsoft","Microsoft / 微软","exploited","在野利用","supply-chain","供应链安全","malware","恶意软件","attack","攻击活动",{"_118":214,"_43":215,"_121":207},{"_118":212,"_43":