00:00.000Z",20.9,"2026-11-13T12:00:00.000Z",21.5,"2026-11-13T11:00:00.000Z",22.1,"2026-11-13T10:00:00.000Z",22.8,"2026-11-13T09:00:00.000Z",23.5,"2026-11-13T08:00:00.000Z",24.1,"2026-11-13T07:00:00.000Z",24.9,"2026-11-13T06:00:00.000Z",25.6,"2026-11-13T05:00:00.000Z",26.3,"2026-11-13T04:00:00.000Z",27.1,"2026-11-13T03:00:00.000Z",27.9,"2026-11-13T02:00:00.000Z",28.7,"2026-11-13T01:00:00.000Z",29.6,"2026-11-13T00:00:00.000Z",30.4,"2026-11-12T23:00:00.000Z",31.3,"2026-11-12T22:00:00.000Z","2026-11-12T21:00:00.000Z","2026-11-12T20:00:00.000Z","2026-11-12T19:00:00.000Z","2026-11-12T18:00:00.000Z","2026-11-12T17:00:00.000Z","2026-11-12T16:00:00.000Z",32.2,"2026-11-12T15:00:00.000Z",33.2,"2026-11-12T14:00:00.000Z",34.2,"2026-11-12T13:00:00.000Z",33,"2026-11-12T12:00:00.000Z",33.9,"2026-11-12T11:00:00.000Z",34.9,"2026-11-12T10:00:00.000Z",25.8,3,"2026-11-12T09:00:00.000Z",16.3,2,"2026-11-12T08:00:00.000Z",16.8,"2026-11-12T07:00:00.000Z",17.3,"2026-11-12T06:00:00.000Z",17.8,"2026-11-12T05:00:00.000Z",18.3,"2026-11-12T04:00:00.000Z",8.6,1,"2026-11-12T03:00:00.000Z",8.9,"2026-11-12T02:00:00.000Z",9.2,"2026-11-12T01:00:00.000Z",9.4,"2026-11-12T00:00:00.000Z",9.7,{"_224":269,"_13":32,"_29":270,"_228":271,"_230":24,"_231":232},{"_224":264,"_13":265,"_29":266,"_228":267,"_230":268,"_231":232},{"_224":259,"_13":260,"_29":261,"_228":262,"_230":263,"_231":235},{"_224":254,"_13":255,"_29":256,"_228":257,"_230":258,"_231":232},{"_224":248,"_13":249,"_29":250,"_228":251,"_230":252,"_231":232},{"_224":242,"_13":243,"_29":244,"_228":245,"_230":246,"_231":235},{"_224":236,"_13":237,"_29":238,"_228":239,"_230":240,"_231":232},{"_224":225,"_13":226,"_29":227,"_228":229,"_230":22,"_231":232},"id","ihb325l23pcss0skikvuxyfi2","ConnectWise 调查针对 MSP 的 ScreenConnect 恶意软件活动，47 家组织受影响","ConnectWise 正在调查一场针对托管服务提供商（MSP）的活跃恶意软件活动，攻击者利用遭入侵的 ScreenConnect 环境，通过 Run Command 功能向客户设备部署非法远程客户端。","source",{"_57":233,"_234":235},"publishedAt","selected",true,"BleepingComputer","firstParty",false,"uml0y1md3aixvjr0xjtezpm2e","ScreenConnect 攻击波及至少 48 家组织的 288 个端点，恶意客户端建立持久后门","攻击者利用被入侵或劫持的 ScreenConnect 面板会话，通过 Run Command 部署恶意 ScreenConnect 客户端，至少影响 48 家组织的 288 个托管端点。",{"_57":241,"_234":235},"2026-11-12T04:39:48.000Z","The Hacker News","gsi2mguh5cqxnstutf6byouzw","ScreenConnect 遭黑客劫持，IT firms 及其客户面临远程控制风险","ConnectWise 警告 ScreenConnect 劫持活动正在扩散，IT firms 及其客户可能遭到攻击并被夺取远程控制。正文未提供受影响版本、CVE 编号、CVSS 分数、认证要求、补丁状态或已确认利用细节。",{"_57":247,"_234":235},"2026-11-12T09:46:00.000Z","Cybernews","rj9u9s3oymbuwkube0wosddcn","攻击者利用 RMM+ 认证绕过攻击 ScreenConnect，288 台主机遭植入 SCKit","Huntress 观察到攻击者利用 RMM+ 认证绕过漏洞入侵 ConnectWise ScreenConnect，至少影响 6 家 MSP、48 家组织的 288 台主机，并在 90 分钟内完成命令投递。",{"_57":253,"_234":235},"2026-11-12T10:39:34.000Z","SecurityWeek","os7855wmu7u8h554m5er9zy6t","SCKit 利用 ConnectWise ScreenConnect 扩展与已认证会话攻击 MSP","Blackpoint Cyber 分析 SCKit 恶意软件活动，指出其可能借助恶意 ScreenConnect 第三方扩展取得初始访问，再利用工具包中的 CVE-2026-84869 利用代码或已认证操作员会话，通过 Run Command 分发 sc.msi、sckit-run.bat 和 PowerShell 组件。",{"_57":241,"_234":235},"2026-11-12T13:08:28.000Z","t6aiahmvz3dom3wx1doqs9jp4","Action1 分析端点管理平台被攻陷后的安全风险，ETP 用独立加密授权保护高风险操作","Action1 指出，端点管理平台一旦被攻陷，攻击者可借其权限分发恶意软件、执行命令、关闭安全控制并波及整个组织，文中列举了 BeyondTrust Bomgar、SimpleHelp、ConnectWise ScreenConnect、Microsoft Intune 等多起事件。",{"_57":233,"_234":235},"2026-11-12T15:00:10.000Z","h2occksxu7q3tzi57634syb7r","SCKit 蠕虫式恶意软件借 ScreenConnect 攻击 MSP，尝试反向感染技术人员","SCKit 是由 16 个脚本和组件组成的蠕虫式工具包，目标是在近期针对托管服务提供商（MSP）的 ScreenConnect 攻击中建立持久访问并横向扩散。",{"_57":233,"_234":235},"2026-11-12T22:53:10.000Z","spesfoh8hnd6kn27vm72lu8v2","Microsoft Threat Intelligence确认，威胁者自2026年11月11日起利用托管服务商（MSP）的ScreenConnect实例，部署SCKit恶意蠕虫和未授权远程客户端，进而攻击IT支持人员工作站并扩大管理控制台权限。",{"_57":272,"_234":235},"Microsoft Security Blog",{"_276":286,"_13":287,"_21":258,"_17":193,"_279":288},{"_276":282,"_13":283,"_21":240,"_17":196,"_279":284},{"_276":277,"_13":278,"_21":22,"_17":196,"_279":280},"factId","fuF9lrapn3js","ScreenConnect攻击活动入侵MSP","representative",{"_224":225,"_13":226,"_29":227,"_228":281,"_230":22,"_231":232},{"_57":233,"_234":235},"fe11_palkB6U","攻击者利用ScreenConnect部署恶意客户端",{"_224":248,"_13":249,"_29":250,"_228":285,"_230":252,"_231":232},{"_57":253,"_234":235},"fVVoyiSN8gs4","披露SCKit劫持ScreenConnect活动",{"_224":264,"_13":265,"_29":266,"_228":289,"_230":268,"_231":232},{"_57":233,"_234":235},"participants48h","newParticipants6h","recentReports24h","observationComplete","rank",{"_296":297,"_298":-5},"changelogVersion","2026-10-01T08:00","release"]
