[{"_1":2,"_3":4},"root",{"_5":138},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795740056000,"publicId","e59cd29d-1d80-44bf-a15a-12be06038278","title","香港城市售票网疑遭入侵，130万用户资料外泄","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-25T13:40:30.180Z","latestAt","2026-11-26T09:55:00.000Z","digest","香港康乐及文化事务署披露，城市售票网被黑客非法进入，约130万名使用者的姓名或名称、电话号码及电邮地址等个人资料可能外泄。系统未登记身份证明文件资料，信用卡资料已被遮蔽。\n\n康文署接获外包承办商通报后已报警，并通知特区政府保安局、数字政策办公室及个人资料私隐专员公署。承办商称已采取措施、全面检视系统并加强保护，确认系统可继续正常运作；私隐专员公署已展开调查，并提醒相关机构尽快通知受影响人士。","digestUpdatedAt","2026-11-26T11:44:31.851Z","summary","excerpt","latest","香港城市售票网遭黑客入侵，约130万用户资料外泄","latestReport",{"_108":119},"whyHot",{"_129":18,"_130":131,"_132":133,"_134":135,"_136":137},"developments",[122],"officialReports",[],"timeline",[106,107],"heat",[59,60,61,62,63,64,65,66,67,68,69,70,71,72,73],"related",[],"topics",[48,49,50],{"_51":57,"_53":58},{"_51":55,"_53":56},{"_51":52,"_53":54},"slug","black-market","name","数据窃取与黑产","ransomware","勒索软件","attack","攻击活动",{"_74":104,"_42":105,"_77":18},{"_74":102,"_42":103,"_77":18},{"_74":100,"_42":101,"_77":18},{"_74":98,"_42":99,"_77":18},{"_74":96,"_42":97,"_77":18},{"_74":94,"_42":95,"_77":18},{"_74":92,"_42":93,"_77":18},{"_74":90,"_42":91,"_77":18},{"_74":88,"_42":89,"_77":18},{"_74":86,"_42":87,"_77":18},{"_74":84,"_42":85,"_77":18},{"_74":82,"_42":83,"_77":18},{"_74":80,"_42":81,"_77":18},{"_74":78,"_42":79,"_77":18},{"_74":75,"_42":76,"_77":18},"hour","2026-11-27T00:00:00.000Z",10.4,"participants","2026-11-26T23:00:00.000Z",10.7,"2026-11-26T22:00:00.000Z",11,"2026-11-26T21:00:00.000Z",11.3,"2026-11-26T20:00:00.000Z",11.6,"2026-11-26T19:00:00.000Z",12,"2026-11-26T18:00:00.000Z",12.3,"2026-11-26T17:00:00.000Z",12.7,"2026-11-26T16:00:00.000Z",13.1,"2026-11-26T15:00:00.000Z",13.4,"2026-11-26T14:00:00.000Z",13.8,"2026-11-26T13:00:00.000Z",14.2,"2026-11-26T12:00:00.000Z",14.7,"2026-11-26T11:00:00.000Z",15.1,"2026-11-26T10:00:00.000Z",15.5,{"_108":119,"_13":31,"_28":120,"_112":121,"_114":23,"_115":116},{"_108":109,"_13":110,"_28":111,"_112":113,"_114":21,"_115":116},"id","xwnl5zu2k4hg60h8qgv7yne17","香港城市售票网被黑客非法进入，约130万用户个人资料外泄风险","香港康乐及文化事务署25日公布，城市售票网的外包承办商24日通报该系统被黑客非法进入，涉及约130万使用者的个人资料，包括用户名称／姓名、电话号码和电邮地址。系统未登记使用者身份证明文件资料，信用卡资料已遮蔽。康文署称系统经检视后可继续正常运作，已向警方报案，并通报特区政府保安局、数字政策办公室及个人资料私隐专员公署，正陆续通知受影响人士并加强系统保护措施。","source",{"_53":117,"_118":116},"publishedAt","selected",false,"安全内参","firstParty","vzbpyckuf134yxuczry3aivgy","香港城市售票网遭黑客非法进入，约130万名使用者的姓名或名称、电话号码及电邮地址等个人资料可能外泄。康文署接获外判承办商通报后报警，并向保安局、数字政策办公室及个人资料私隐专员公署通报；系统未登记身份证明文件资料，信用卡资料已被遮蔽。承办商已检视系统并加强保护，个人资料私隐专员公署已展开调查并提醒相关机构尽快通知受影响人士。",{"_53":117,"_118":116},{"_123":124,"_13":125,"_20":21,"_17":18,"_126":127},"factId","fgDwmLUX2Hes","香港城市售票网遭黑客入侵","representative",{"_108":119,"_13":31,"_28":120,"_112":128,"_114":23,"_115":116},{"_53":117,"_118":116},"participants48h","newParticipants6h",0,"recentReports24h",1,"observationComplete",true,"rank",8,{"_139":140,"_141":-5},"changelogVersion","2026-10-01T08:00","release"]
