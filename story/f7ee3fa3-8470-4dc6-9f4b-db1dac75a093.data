[{"_1":2,"_3":4},"root",{"_5":193},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":-5,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48},"expiresAt",1794530497000,"publicId","f7ee3fa3-8470-4dc6-9f4b-db1dac75a093","title","Apache mod_http2竞态RCE已修复","status","active","reportCount",6,"sourceCount",5,"firstReportAt","2026-11-12T05:12:26.000Z","latestAt","2026-11-12T20:17:28.000Z","digest","Apache HTTP Server 的 mod_http2 竞态条件漏洞 CVE-2026-119618（CVSS 9.8）已由 Apache 修复；未认证攻击者可远程触发堆内存损坏并以 Web 服务器进程权限执行代码，但目前没有确认的在野利用。影响 Apache HTTP Server 2.4.55 至 2.4.70，以及独立版 mod_h2 2.0.8 至 2.0.42，且仅限启用 HTTP/2 的服务器；HTTP/2 默认关闭，仅提供 HTTP/1.1 的服务器不受影响。\n\n漏洞源于 assign_headers() 函数对共享资源同步不当；Praetorian 称已在默认配置下验证可靠利用，但跨环境稳定性仍需验证，其利用代码仍在内部开发。Wiz 则称发布博客时没有公开利用代码或在野利用报告。官方修复版本为 Apache HTTP Server 2.4.71；无法立即更新时可关闭 HTTP/2 临时缓解。","digestUpdatedAt","2026-11-12T20:40:06.716Z","summary","excerpt","latest","Apache HTTP Server mod_http2 竞态条件漏洞 CVE-2026-119618 可导致远程代码执行","latestReport",{"_138":172},"whyHot",{"_188":20,"_189":112,"_190":18,"_191":146,"_192":115},"developments",[176,177],"officialReports",[],"timeline",[132,133,134,135,136,137],"heat",[69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87],"related",[],"topics",[49,50,51,52,53,54],{"_55":67,"_57":68},{"_55":65,"_57":66},{"_55":63,"_57":64},{"_55":61,"_57":62},{"_55":59,"_57":60},{"_55":56,"_57":58},"slug","cloud-native","name","云与原生","research","技术研究","exploited","在野利用","redhat","Red Hat / 红帽","google","Google / 谷歌","vuln","漏洞披露",{"_88":130,"_43":131,"_91":115},{"_88":128,"_43":129,"_91":115},{"_88":126,"_43":127,"_91":115},{"_88":124,"_43":125,"_91":115},{"_88":122,"_43":123,"_91":115},{"_88":120,"_43":121,"_91":115},{"_88":118,"_43":119,"_91":115},{"_88":116,"_43":117,"_91":115},{"_88":113,"_43":114,"_91":115},{"_88":110,"_43":111,"_91":112},{"_88":108,"_43":109,"_91":103},{"_88":106,"_43":107,"_91":103},{"_88":104,"_43":105,"_91":103},{"_88":101,"_43":102,"_91":103},{"_88":98,"_43":99,"_91":100},{"_88":96,"_43":97,"_91":20},{"_88":94,"_43":95,"_91":20},{"_88":92,"_43":93,"_91":20},{"_88":89,"_43":90,"_91":20},"hour","2026-11-13T00:00:00.000Z",38.9,"participants","2026-11-12T23:00:00.000Z",40.1,"2026-11-12T22:00:00.000Z",41.2,"2026-11-12T21:00:00.000Z",42.4,"2026-11-12T20:00:00.000Z",33.6,4,"2026-11-12T19:00:00.000Z",24.5,3,"2026-11-12T18:00:00.000Z",25.2,"2026-11-12T17:00:00.000Z",26,"2026-11-12T16:00:00.000Z",26.7,"2026-11-12T15:00:00.000Z",17.3,2,"2026-11-12T14:00:00.000Z",7.8,1,"2026-11-12T13:00:00.000Z",8,"2026-11-12T12:00:00.000Z",8.2,"2026-11-12T11:00:00.000Z",8.5,"2026-11-12T10:00:00.000Z",8.7,"2026-11-12T09:00:00.000Z",9,"2026-11-12T08:00:00.000Z",9.2,"2026-11-12T07:00:00.000Z",9.5,"2026-11-12T06:00:00.000Z",9.8,{"_138":172,"_13":32,"_29":173,"_142":174,"_144":24,"_145":149},{"_138":166,"_13":167,"_29":168,"_142":169,"_144":170,"_145":146},{"_138":160,"_13":161,"_29":162,"_142":163,"_144":164,"_145":146},{"_138":156,"_13":157,"_29":158,"_142":159,"_144":154,"_145":146},{"_138":150,"_13":151,"_29":152,"_142":153,"_144":154,"_145":146},{"_138":139,"_13":140,"_29":141,"_142":143,"_144":22,"_145":146},"id","itghrl24hjsfp7ov68trhdxf5","Apache HTTP/2 模块远程代码执行漏洞 CVE-2026-119618 影响 2.4.55 至 2.4.70，2.4.71 已修复","Apache HTTP Server 的 HTTP/2 模块 mod_http2 存在严重漏洞 CVE-2026-119618，攻击者无需认证即可在服务器上执行代码并完全控制服务器进程，CVSS 评分 9.8。","source",{"_57":147,"_148":149},"publishedAt","selected",true,"The Hacker News","firstParty",false,"sa54pcrrt3rx4k31a8tfgwh7n","Apache mod_http2 竞态漏洞 CVE-2026-119618 利用条件分析","Apache mod_http2 竞态漏洞 CVE-2026-119618 可在无需认证的远程请求下造成堆内存损坏并实现 RCE，影响 Apache HTTP Server 2.4.55 至 2.4.70 和独立版 mod_h2 2.0.8 至 2.0.42，官方已在 2.4.71 修复。",{"_57":155,"_148":149},"2026-11-12T14:16:26.000Z","Praetorian Blog","gj57fff8izxf8izlqj80x17m3","Apache mod_http2 竞态条件 CVE-2026-119618 利用条件分析","Apache HTTP Server 的 mod_http2 模块存在竞态条件 CVE-2026-119618，可导致堆内存损坏和无需认证的远程代码执行，影响 Apache HTTP Server 2.4.55 至 2.4.70 及独立 mod_h2 2.0.8 至 2.0.42。",{"_57":155,"_148":149},"mt7j4rwuk65xvjcr012nu4hlf","Apache HTTP Server 修复 mod_http2 远程代码执行漏洞 CVE-2026-119618","Apache HTTP Server 2.4.55 至 2.4.70 的 mod_http2 模块存在 CVE-2026-119618，可因线程竞态导致内存破坏，未认证攻击者可能远程执行任意命令并控制服务器进程，Red Hat 评分为 CVSS 9.8。",{"_57":165,"_148":149},"2026-11-12T15:38:31.000Z","SecurityWeek","vicbke646p181fmohodbrwpja","Apache HTTP Server 修复 HTTP/2 远程代码执行漏洞 CVE-2026-119618","Apache HTTP Server 的 mod_http2 模块存在远程代码执行漏洞 CVE-2026-119618，未认证攻击者可利用并发线程共享资源时同步不当造成的堆内存损坏，以 Web 服务器进程权限执行代码。",{"_57":171,"_148":149},"2026-11-12T19:12:55.000Z","BleepingComputer","cmhtezwfxfv1onse2gppp1vh2","CVE-2026-119618 是 Apache HTTP Server 的 mod_http2 模块中的严重竞态条件漏洞，其 assign_headers() 函数对共享资源同步不当，可能破坏堆内存并导致远程代码执行。攻击者无需凭据，只需能通过 HTTP/2 访问服务器；Red Hat 公告指出，仅启用 HTTP/2 的服务器受到影响。",{"_57":175,"_148":149},"Horizon3.ai",{"_178":184,"_13":185,"_21":154,"_17":115,"_181":186},{"_178":179,"_13":180,"_21":22,"_17":20,"_181":182},"factId","fJ-NgiRpNVYE","Apache HTTP/2远程代码执行漏洞披露","representative",{"_138":139,"_13":140,"_29":141,"_142":183,"_144":22,"_145":146},{"_57":147,"_148":149},"feZoPGF3c0Bs","分析Apache mod_http2竞态漏洞",{"_138":156,"_13":157,"_29":158,"_142":187,"_144":154,"_145":146},{"_57":155,"_148":149},"participants48h","newParticipants6h","recentReports24h","observationComplete","rank",{"_194":195,"_196":-5},"changelogVersion","2026-10-01T08:00","release"]
