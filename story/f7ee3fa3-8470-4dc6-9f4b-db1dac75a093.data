2026-11-13T01:00:00.000Z",37.8,"2026-11-13T00:00:00.000Z",38.9,"2026-11-12T23:00:00.000Z",40.1,"2026-11-12T22:00:00.000Z",41.2,"2026-11-12T21:00:00.000Z",42.4,"2026-11-12T20:00:00.000Z",33.6,4,"2026-11-12T19:00:00.000Z",24.5,3,"2026-11-12T18:00:00.000Z",25.2,"2026-11-12T17:00:00.000Z",26,"2026-11-12T16:00:00.000Z",26.7,"2026-11-12T15:00:00.000Z",17.3,2,"2026-11-12T14:00:00.000Z",7.8,1,"2026-11-12T13:00:00.000Z","2026-11-12T12:00:00.000Z",8.2,"2026-11-12T11:00:00.000Z",8.5,"2026-11-12T10:00:00.000Z",8.7,"2026-11-12T09:00:00.000Z","2026-11-12T08:00:00.000Z",9.2,"2026-11-12T07:00:00.000Z",9.5,"2026-11-12T06:00:00.000Z",9.8,{"_218":281,"_13":32,"_29":282,"_222":283,"_224":24,"_225":226},{"_218":276,"_13":277,"_29":278,"_222":279,"_224":141,"_225":226},{"_218":270,"_13":271,"_29":272,"_222":273,"_224":274,"_225":226},{"_218":264,"_13":265,"_29":266,"_222":267,"_224":268,"_225":226},{"_218":258,"_13":259,"_29":260,"_222":261,"_224":262,"_225":226},{"_218":252,"_13":253,"_29":254,"_222":255,"_224":256,"_225":229},{"_218":246,"_13":247,"_29":248,"_222":249,"_224":250,"_225":226},{"_218":240,"_13":241,"_29":242,"_222":243,"_224":244,"_225":226},{"_218":236,"_13":237,"_29":238,"_222":239,"_224":234,"_225":226},{"_218":230,"_13":231,"_29":232,"_222":233,"_224":234,"_225":226},{"_218":219,"_13":220,"_29":221,"_222":223,"_224":22,"_225":226},"id","itghrl24hjsfp7ov68trhdxf5","Apache HTTP/2 模块远程代码执行漏洞 CVE-2026-119618 影响 2.4.55 至 2.4.70，2.4.71 已修复","Apache HTTP Server 的 HTTP/2 模块 mod_http2 存在严重漏洞 CVE-2026-119618，攻击者无需认证即可在服务器上执行代码并完全控制服务器进程，CVSS 评分 9.8。","source",{"_57":227,"_228":229},"publishedAt","selected",true,"The Hacker News","firstParty",false,"sa54pcrrt3rx4k31a8tfgwh7n","Apache mod_http2 竞态漏洞 CVE-2026-119618 利用条件分析","Apache mod_http2 竞态漏洞 CVE-2026-119618 可在无需认证的远程请求下造成堆内存损坏并实现 RCE，影响 Apache HTTP Server 2.4.55 至 2.4.70 和独立版 mod_h2 2.0.8 至 2.0.42，官方已在 2.4.71 修复。",{"_57":235,"_228":229},"2026-11-12T14:16:26.000Z","Praetorian Blog","gj57fff8izxf8izlqj80x17m3","Apache mod_http2 竞态条件 CVE-2026-119618 利用条件分析","Apache HTTP Server 的 mod_http2 模块存在竞态条件 CVE-2026-119618，可导致堆内存损坏和无需认证的远程代码执行，影响 Apache HTTP Server 2.4.55 至 2.4.70 及独立 mod_h2 2.0.8 至 2.0.42。",{"_57":235,"_228":229},"mt7j4rwuk65xvjcr012nu4hlf","Apache HTTP Server 修复 mod_http2 远程代码执行漏洞 CVE-2026-119618","Apache HTTP Server 2.4.55 至 2.4.70 的 mod_http2 模块存在 CVE-2026-119618，可因线程竞态导致内存破坏，未认证攻击者可能远程执行任意命令并控制服务器进程，Red Hat 评分为 CVSS 9.8。",{"_57":245,"_228":229},"2026-11-12T15:38:31.000Z","SecurityWeek","vicbke646p181fmohodbrwpja","Apache HTTP Server 修复 HTTP/2 远程代码执行漏洞 CVE-2026-119618","Apache HTTP Server 的 mod_http2 模块存在远程代码执行漏洞 CVE-2026-119618，未认证攻击者可利用并发线程共享资源时同步不当造成的堆内存损坏，以 Web 服务器进程权限执行代码。",{"_57":251,"_228":229},"2026-11-12T19:12:55.000Z","BleepingComputer","cmhtezwfxfv1onse2gppp1vh2","Apache HTTP Server mod_http2 竞态条件漏洞 CVE-2026-119618 可导致远程代码执行","CVE-2026-119618 是 Apache HTTP Server 的 mod_http2 模块中的严重竞态条件漏洞，其 assign_headers() 函数对共享资源同步不当，可能破坏堆内存并导致远程代码执行。攻击者无需凭据，只需能通过 HTTP/2 访问服务器；Red Hat 公告指出，仅启用 HTTP/2 的服务器受到影响。",{"_57":257,"_228":229},"2026-11-12T20:17:28.000Z","Horizon3.ai","er76kiktigpbgezkupewfz59z","Apache HTTP/2 远程代码执行漏洞 CVE-2026-119618 已复现","Apache HTTP Server 的 mod_http2 存在远程代码执行漏洞 CVE-2026-119618，奇安信 CERT 已成功复现。攻击者无需认证，在目标启用并开放 HTTP/2 时，可利用并发流和特定请求头布局触发无锁 APR allocator 竞争，造成进程崩溃、拒绝服务，并可能以 httpd 进程权限执行任意代码。",{"_57":263,"_228":226},"2026-11-13T07:40:00.000Z","奇安信 CERT","wi7ly08wpqyim5ljoqty0063g","Apache HTTP/2 远程代码执行漏洞 CVE-2026-119618 影响 2.4.55 至 2.4.70","Apache HTTP/2 远程代码执行漏洞 CVE-2026-119618 影响 Apache HTTP Server 2.4.55 <= httpd < 2.4.71 及独立版 mod_h2 2.0.8 <= mod_h2 < 2.0.42。",{"_57":269,"_228":229},"2026-11-13T08:04:28.370Z","安全内参","k60zo1iyllp9listygh4t3xuv","Apache HTTP Server mod_http2 竞态条件远程代码执行漏洞 CVE-2026-119618 已披露","Apache HTTP Server 的 mod_http2 模块存在竞态条件远程代码执行漏洞 CVE-2026-119618，威胁等级为严重，无需认证即可远程触发，但前提是服务器启用 mod_http2 并对外提供 HTTP/2 服务。",{"_57":275,"_228":226},"2026-11-13T09:06:00.000Z","深信服千里目安全实验室","wsj9gmwajcglomdxl9m654rps","Apache HTTP Server 远程代码执行漏洞 CVE-2026-119618 已公开 PoC","Apache HTTP Server 远程代码执行漏洞 CVE-2026-119618 影响 2.4.55 <= Apache HTTP Server <= 2.4.70，以及 2.0.8 <= mod_h2 <= 2.0.42，服务器需启用 HTTP/2（h2 或 h2c）。",{"_57":280,"_228":226},"绿盟科技CERT","rrsrh82dut4erv3eelbyoynnp","Apache HTTP Server mod_http2 的 assign_headers() 竞争条件漏洞 CVE-2026-119618 已被微步情报局复现，可导致远程代码执行或子进程崩溃。",{"_57":284,"_228":226},"微步在线研究响应中心",{"_218":281,"_13":32,"_29":282,"_222":292,"_224":24,"_225":226},{"_218":276,"_13":277,"_29":278,"_222":291,"_224":141,"_225":226},{"_218":270,"_13":271,"_29":272,"_222":290,"_224":274,"_225":226},{"_218":258,"_13":259,"_29":260,"_222":289,"_224":262,"_225":226},{"_57":263,"_228":226},{"_57":275,"_228":226},{"_57":280,"_228":226},{"_57":284,"_228":226},{"_298":316,"_13":317,"_21":24,"_17":192,"_301":318},{"_298":312,"_13":313,"_21":274,"_17":192,"_301":314},{"_298":308,"_13":309,"_21":262,"_17":189,"_301":310},{"_298":304,"_13":305,"_21":234,"_17":192,"_301":306},{"_298":299,"_13":300,"_21":22,"_17":151,"_301":302},"factId","fJ-NgiRpNVYE","Apache HTTP/2远程代码执行漏洞披露","representative",{"_218":276,"_13":277,"_29":278,"_222":303,"_224":141,"_225":226},{"_57":280,"_228":226},"feZoPGF3c0Bs","分析Apache mod_http2竞态漏洞",{"_218":236,"_13":237,"_29":238,"_222":307,"_224":234,"_225":226},{"_57":235,"_228":229},"f2frbTTF4SAw","复现Apache HTTP/2远程代码执行漏洞",{"_218":258,"_13":259,"_29":260,"_222":311,"_224":262,"_225":226},{"_57":263,"_228":226},"fVpTBcWTjIOw","披露并复现Apache mod_http2竞态RCE",{"_218":270,"_13":271,"_29":272,"_222":315,"_224":274,"_225":226},{"_57":275,"_228":226},"fmsw6U6oSThI","复现Apache HTTPD mod_http2竞态漏洞",{"_218":281,"_13":32,"_29":282,"_222":319,"_224":24,"_225":226},{"_57":284,"_228":226},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",{"_327":328,"_329":-5},"changelogVersion","2026-10-01T08:00","release"]
