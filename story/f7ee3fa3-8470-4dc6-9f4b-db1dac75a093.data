[{"_1":2,"_3":4},"root",{"_5":326},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":-5,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48},"expiresAt",1794616838000,"publicId","f7ee3fa3-8470-4dc6-9f4b-db1dac75a093","title","Apache mod_http2竞态漏洞公开PoC","status","active","reportCount",11,"sourceCount",10,"firstReportAt","2026-11-12T05:12:26.000Z","latestAt","2026-11-13T13:55:00.000Z","digest","Apache HTTP Server 的 mod_http2 竞态条件漏洞 CVE-2026-119618（CVSS 9.8）已由奇安信 CERT、微步情报局和绿盟科技 CERT 复现；绿盟称拒绝服务 PoC 及漏洞细节已公开，Apache 表示尚无公开利用或在野攻击证据，官方补丁已经发布。漏洞源于 assign_headers() 对共享资源同步不当，可造成堆内存损坏、进程崩溃，并在特定条件下以 Web 服务器权限执行任意代码。\n\n利用要求服务器加载 mod_http2、Protocols 配置包含 h2/h2c 且可网络访问，无需认证；h2c 明文连接同样受影响，仅提供 HTTP/1.1 的服务器不受影响。Apache HTTP Server 2.4.55 至 2.4.70、独立版 mod_h2 2.0.8 至 2.0.42 受影响；Apache HTTP Server 2.4.71、独立版 mod_h2 2.0.43 或更高版本已修复。无法立即更新时可关闭 HTTP/2 临时缓解。","digestUpdatedAt","2026-11-13T18:01:04.188Z","summary","excerpt","latest","Apache HTTP Server mod_http2 条件竞争 RCE 漏洞 CVE-2026-119618 已复现","latestReport",{"_218":281},"whyHot",{"_320":20,"_321":322,"_323":154,"_324":226,"_325":192},"developments",[293,294,295,296,297],"officialReports",[285,286,287,288],"timeline",[207,208,209,210,211,212,213,214,215,216,217],"heat",[69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111],"related",[],"topics",[49,50,51,52,53,54],{"_55":67,"_57":68},{"_55":65,"_57":66},{"_55":63,"_57":64},{"_55":61,"_57":62},{"_55":59,"_57":60},{"_55":56,"_57":58},"slug","qianxin","name","奇安信","redhat","Red Hat / 红帽","google","Google / 谷歌","exploited","在野利用","research","技术研究","vuln","漏洞披露",{"_112":205,"_43":206,"_115":192},{"_112":203,"_43":204,"_115":192},{"_112":201,"_43":202,"_115":192},{"_112":200,"_43":138,"_115":192},{"_112":198,"_43":199,"_115":192},{"_112":196,"_43":197,"_115":192},{"_112":194,"_