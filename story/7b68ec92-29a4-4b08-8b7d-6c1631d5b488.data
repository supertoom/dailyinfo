1hpjvys","Ivanti Connect Secure 的 CVE-2026-111357、CVE-2026-118527 与 CVE-2026-104935 已被链式利用，可获取未认证 root 权限并窃取 Windows LAPS 密码和 BitLocker 恢复密钥，UTA0576 自 2026 年 10 月 3 日起攻击运行 22.8R2.4 的设备，影响客户数量有限。",{"_57":309,"_281":279},"Rapid7 CVE 公告",{"_271":306,"_13":32,"_29":307,"_275":313,"_277":24,"_278":279},{"_271":272,"_13":273,"_29":274,"_275":312,"_277":22,"_278":279},{"_57":280,"_281":279},{"_57":309,"_281":279},{"_317":327,"_13":328,"_21":304,"_17":147,"_320":329},{"_317":323,"_13":324,"_21":293,"_17":142,"_320":325},{"_317":318,"_13":319,"_21":22,"_17":142,"_320":321},"factId","fHtxLTvYwTdg","CISA将两个Ivanti漏洞加入KEV目录","representative",{"_271":272,"_13":273,"_29":274,"_275":322,"_277":22,"_278":279},{"_57":280,"_281":279},"fBXRC7O56Fow","攻击者串联三个Ivanti漏洞获未认证Root权限",{"_271":306,"_13":32,"_29":307,"_275":326,"_277":24,"_278":279},{"_57":309,"_281":279},"fQpogd7kEGwA","Ivanti修复两个遭零日利用的ICS漏洞",{"_271":300,"_13":301,"_29":302,"_275":330,"_277":304,"_278":279},{"_57":305,"_281":288},"participants48h","newParticipants6h","recentReports24h","observationComplete","rank",{"_337":338,"_339":-5},"changelogVersion","2026-10-01T08:00","release"]
