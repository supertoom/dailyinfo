[{"_1":2,"_3":4},"root",{"_5":397},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":-5,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48},"expiresAt",1793672470000,"publicId","7b68ec92-29a4-4b08-8b7d-6c1631d5b488","title","Ivanti三项零日漏洞已被链式利用","status","active","reportCount",8,"sourceCount",7,"firstReportAt","2026-10-30T12:00:00.000Z","latestAt","2026-11-02T15:58:08.000Z","digest","CISA确认UTA0576将Ivanti Connect Secure的CVE-2026-111357、CVE-2026-118527与CVE-2026-104935（CVSS 8.6）串联利用，在运行22.8R2.4的设备上通过鉴权绕过、远程代码执行和提权取得未认证root权限；CISA已将前两项加入KEV目录，确认存在在野利用。攻击者还尝试提取凭据、有限的Active Directory元数据、Windows LAPS密码及BitLocker恢复密钥，已知受影响客户数量有限，因行动被发现并干扰，最终目标无法确定。\n\nIvanti已修复三项漏洞：25.1.1.2及更早版本升级至25.1.1.3，22.8R2.5及更早版本升级至22.8R2.6；10月13日发布的25.1.1.2和22.8R2.5不修复前两项。CISA要求FCEB机构分别在2026年11月2日和11月13日前修复，并按BOD 26-04在补丁前开展入侵检查；Volexity称相关活动可绕过Integrity Checker Tool，检查结果正常不能排除入侵。报道未说明额外配置或重启要求。","digestUpdatedAt","2026-11-02T16:50:08.552Z","summary","excerpt","latest","CISA要求联邦机构修复已被利用的Ivanti Connect Secure漏洞CVE-2026-111357和CVE-2026-118527","latestReport",{"_315":361},"whyHot",{"_391":153,"_392":393,"_394":153,"_395":323,"_396":168},"developments",[369,370,371,372],"officialReports",[365,366],"timeline",[307,308,309,310,311,312,313,314],"heat",[69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130,131,132,133,134,135,136,137,138,139,140,141,142,143,144,145,146,147,148],"related",[],"topics",[49,50,51,52,53,54],{"_55":67,"_57":68},{"_55":65,"_57":66},{"_55":63,"_57":64},{"_55":61,"_57":62},{"_55":59,"_57":60},{"_55":56,"_57":58},"slug","incident","name","应急响应","identity","身份与访问","vuln-mgmt","漏洞管理","cisa","CISA","exploited","在野利用","vuln","漏洞披露",{"_149":305,"_43":306,"_152":190},{"_149":303,"_43":304,"_152":190}