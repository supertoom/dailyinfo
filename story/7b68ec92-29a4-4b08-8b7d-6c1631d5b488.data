[{"_1":2,"_3":4},"root",{"_5":336},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":-5,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48},"expiresAt",1793621627000,"publicId","7b68ec92-29a4-4b08-8b7d-6c1631d5b488","title","Ivanti三项零日漏洞被串联利用","status","active","reportCount",6,"sourceCount",5,"firstReportAt","2026-10-30T12:00:00.000Z","latestAt","2026-11-02T11:04:08.000Z","digest","CISA已确认Ivanti Connect Secure的CVE-2026-111357（关键功能缺失认证）和CVE-2026-118527（可预测数字或标识符生成漏洞）被在野利用并纳入KEV目录；Ivanti已发布修复版本25.1.1.3和22.8R2.6，分别修复25.1.1.2及更早版本、22.8R2.5及更早版本中的上述漏洞，攻击链涉及漏洞均已有补丁。\n\nVolexity称，UTA0576自2026年10月3日起将这两项漏洞与鉴权绕过漏洞CVE-2026-104935（CVSS 8.6）串联，在运行22.8R2.4的设备上利用认证绕过、远程代码执行和提权漏洞获取未认证root权限，并提取凭据、有限的Active Directory元数据、Windows LAPS密码和BitLocker恢复密钥；已知受影响客户数量有限。10月13日发布的25.1.1.2和22.8R2.5不能修复这两项漏洞。\n\nCISA要求FCEB机构分别在2026年11月2日和11月13日前修复，并按BOD 26-04在打补丁前检查系统是否遭入侵；Volexity称相关活动可绕过Integrity Checker Tool，因此检测结果正常不能排除已被入侵。报道未说明额外配置或重启要求。","digestUpdatedAt","2026-11-02T11:49:13.105Z","summary","excerpt","latest","Ivanti Connect Secure 三个零日漏洞已被链式利用，CVE-2026-111357 与 CVE-2026-118527 纳入 KEV","latestReport",{"_271":306},"whyHot",{"_331":139,"_332":142,"_333":142,"_334":279,"_335":139},"developments",[314,315,316],"officialReports",[310,311],"timeline",[265,266,267,268,269,270],"heat",[69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130,131,132,133,134],"related",[],"topics",[49,50,51,52,53,54],{"_55":67,"_57":68},{"_55":65,"_57":66},{"_55":63,"_57":64},{"_55":61,"_57":62},{"_55":59,"_57":60},{"_55":56,"_57":58},"slug","incident","name","应急响应","vuln-mgmt","漏洞管理","identity","身份与访问","cisa","CISA","exploited","在野利用","vuln","漏洞披露",{"_135":263,"_43":264,"_138":147},{"_135":261,"_43":262,"_138":147},{"_135":