[{"_1":2,"_3":4},"root",{"_5":145},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795048843000,"publicId","02b2ffb9-c7c0-4b25-b15d-bdc166d49214","title","Apache Roller RCE漏洞已遭在野利用","status","active","reportCount",3,"sourceCount","firstReportAt","2026-11-18T10:35:05.000Z","latestAt","2026-11-18T20:11:35.000Z","digest","Apache Software Foundation（ASF）确认，Apache Roller 4.0.0至6.1.4的反序列化漏洞CVE-2026-129448（CVSS 9.8）已遭在野利用；该漏洞与CVE-2026-82384为同一问题。未认证远程攻击者可经XML-RPC端点反序列化不可信数据并执行任意代码，具体受害规模尚未披露。\n\nASF已发布安全更新，建议升级至Apache Roller 6.1.6或更高版本，该版本禁用扩展类型，并在关闭XML-RPC功能时拒绝相关请求。无法立即升级时，可将WEB-INF/web.xml中的“enabledForExtensions”设为“false”、移除“/roller-services/xmlrpc” servlet映射并重启Roller；仅在管理界面禁用XML-RPC无效，因为旧版本会在检查该设置前完成反序列化。","digestUpdatedAt","2026-11-18T20:49:13.674Z","summary","excerpt","latest","Apache Roller 未认证 RCE 漏洞 CVE-2026-129448 已被在野利用","latestReport",{"_105":122},"whyHot",{"_139":18,"_140":91,"_141":18,"_142":125,"_143":144},"developments",[127,128],"officialReports",[],"timeline",[102,103,104],"heat",[59,60,61,62,63,64,65,66,67,68,69,70,71],"related",[],"topics",[48,49,50],{"_51":57,"_53":58},{"_51":55,"_53":56},{"_51":52,"_53":54},"slug","oracle","name","Oracle / 甲骨文","exploited","在野利用","vuln","漏洞披露",{"_72":100,"_42":101,"_75":91},{"_72":98,"_42":99,"_75":91},{"_72":96,"_42":97,"_75":91},{"_72":94,"_42":95,"_75":91},{"_72":92,"_42":93,"_75":91},{"_72":89,"_42":90,"_75":91},{"_72":87,"_42":88,"_75":84},{"_72":85,"_42":86,"_75":84},{"_72":82,"_42":83,"_75":84},{"_72":80,"_42":81,"_75":18},{"_72":78,"_42":79,"_75":18},{"_72":76,"_42":77,"_75":18},{"_72":73,"_42":74,"_75":18},"hour","2026-11-19T00:00:00.000Z",24,"participants","2026-11-18T23:00:00.000Z",24.7,"2026-11-18T22:00:00.000Z",25.4,"2026-11-18T21:00:00.000Z",26.1,"2026-11-18T20:00:00.000Z",16.8,2,"2026-11-18T19:00:00.000Z",17.3,"2026-11-18T18:00:00.000Z",17.8,"2026-11-18T17:00:00.000Z",8.3,1,"2026-11-18T16:00:00.000Z",8.6,"2026-11-18T15:00:00.000Z",8.8,"2026-11-18T14:00:00.000Z",9.1,"2026-11-18T13:00:00.000Z",9.3,"2026-11-18T12:00:00.000Z",9.6,{"_105":122,"_13":31,"_28":123,"_109":124,"_111":23,"_112":125},{"_105":116,"_13":117,"_28":118,"_109":119,"_111":120,"_112":113},{"_105":106,"_13":107,"_28":108,"_109":110,"_111":21,"_112":113},"id","e4b2k5ths8mpu7si0k1onhnr0","Apache Roller RCE 漏洞 CVE-2026-129448 已被在野利用","Apache Roller 4.0.0 至 6.1.4 的 RCE 漏洞 CVE-2026-129448 已被用于攻击，未认证远程攻击者可经 XML-RPC 端点反序列化不可信数据并执行任意代码；该问题与 CVE-2026-82384 相同。","source",{"_53":114,"_115":113},"publishedAt","selected",false,"BleepingComputer","firstParty","wg1qps20rr8ohpbfsg12vwxk4","Apache Roller CVE-2026-129448 RCE 漏洞已被在野利用，无需认证","Apache Roller 的未认证不安全反序列化漏洞 CVE-2026-129448 已被用于在野攻击，影响 4.0.0 至 6.1.4，CVSS 为 9.8。",{"_53":121,"_115":113},"2026-11-18T17:10:45.000Z","The Hacker News","a7w3tajom8oplmgsmeq9ufff4","Apache Roller 的未认证远程代码执行漏洞 CVE-2026-129448（CVSS 9.8）已被确认在野利用，影响 4.0.0 至 6.1.4 版本。",{"_53":126,"_115":113},true,"Security Affairs",{"_129":135,"_13":136,"_20":23,"_17":91,"_132":137},{"_129":130,"_13":131,"_20":21,"_17":84,"_132":133},"factId","fwj3V3ZMlgn0","Apache披露Roller远程代码执行漏洞并确认在野利用","representative",{"_105":116,"_13":117,"_28":118,"_109":134,"_111":120,"_112":113},{"_53":121,"_115":113},"feMmTIXkhTMg","Apache Roller RCE漏洞已在野利用",{"_105":122,"_13":31,"_28":123,"_109":138,"_111":23,"_112":125},{"_53":126,"_115":113},"participants48h","newParticipants6h","recentReports24h","observationComplete","rank",5,{"_146":147,"_148":-5},"changelogVersion","2026-10-01T08:00","release"]
