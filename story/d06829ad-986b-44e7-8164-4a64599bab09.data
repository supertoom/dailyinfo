[{"_1":2,"_3":4},"root",{"_5":155},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1793672471000,"publicId","d06829ad-986b-44e7-8164-4a64599bab09","title","Google拆除XCPE僵尸网络并封禁Videostrong","status","active","reportCount",4,"sourceCount","firstReportAt","2026-11-02T14:00:00.000Z","latestAt","2026-11-02T18:16:34.000Z","digest","Google联合行业伙伴拆除XCPE僵尸网络及命令与控制（C2）基础设施，切断超过130万台Android设备的控制；Google高置信度认定，设备厂商Videostrong Technology Co.为牟利而故意开发、部署并运营该后门和僵尸网络。Google已与其断绝合作，并禁止其及未来子公司、关联公司制造或销售预装Google应用的认证Android设备，以及向其他认证设备厂商提供软件。\n\nXCPE预装在设备固件中，多数受影响设备为Android TV机顶盒，也包括远程医疗设备、卡拉OK机和数字标牌。其主要组件以系统权限运行，重启后会从受保护分区重新安装，删除应用无法清除；用户需安装干净固件，或断开设备联网以阻止进一步恶意活动。Google称，关停相关C2服务器还可切断至少1000万台经其他感染途径及其他恶意软件家族受控设备的访问，这些设备并非均预装XCPE。","digestUpdatedAt","2026-11-02T19:06:03.089Z","summary","excerpt","latest","Google 联合伙伴中断 XCPE Android 僵尸网络，封锁 Videostrong","latestReport",{"_114":138},"whyHot",{"_149":18,"_150":151,"_152":18,"_153":122,"_154":108},"developments",[142],"officialReports",[],"timeline",[110,111,112,113],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","supply-chain","name","供应链安全","iot","IoT 与车联网","malware","恶意软件","attack","攻击活动","botnet","僵尸网络","google","Google / 谷歌",{"_81":21,"_42":109,"_84":108},{"_81":106,"_42":107,"_84":108},{"_81":104,"_42":105,"_84":101},{"_81":102,"_42":103,"_84":101},{"_81":99,"_42":100,"_84":101},{"_81":97,"_42":98,"_84":18},{"_81":95,"_42":96,"_84":18},{"_81":93,"_42":94,"_84":18},{"_81":91,"_42":92,"_84":18},{"_81":89,"_42":90,"_84":18},{"_81":87,"_42":88,"_84":18},{"_81":85,"_42":86,"_84":18},{"_81":82,"_42":83,"_84":18},"hour","2026-11-03T02:00:00.000Z",30,"participants","2026-11-03T01:00:00.000Z",30.9,"2026-11-03T00:00:00.000Z",31.8,"2026-11-02T23:00:00.000Z",32.7,"2026-11-02T22:00:00.000Z",33.7,"2026-11-02T21:00:00.000Z",34.6,"2026-11-02T20:00:00.000Z",35.7,"2026-11-02T19:00:00.000Z",36.7,"2026-11-02T18:00:00.000Z",27.7,3,"2026-11-02T17:00:00.000Z",28.5,"2026-11-02T16:00:00.000Z",29.3,"2026-11-02T15:00:00.000Z",9.7,1,10,{"_114":138,"_13":31,"_28":139,"_118":140,"_120":23,"_121":122},{"_114":132,"_13":133,"_28":134,"_118":135,"_120":136,"_121":122},{"_114":126,"_13":127,"_28":128,"_118":129,"_120":130,"_121":122},{"_114":115,"_13":116,"_28":117,"_118":119,"_120":21,"_121":122},"id","wbjzunigapakv96vd54t9g53c","Google 联合处置 XCPE 僵尸网络，Videostrong 预装后门感染逾 130 万台机顶盒","Google 与行业伙伴已拆除 XCPE 后门相关控制基础设施，该后门将超过 1.3 million 台机顶盒及其他 Android IoT 设备纳入僵尸网络。","source",{"_56":123,"_124":125},"publishedAt","selected",true,"Google Cloud 威胁情报","firstParty",false,"p8lgm331w38cxp1dyo8ycly9z","Google 接管逾 130 万台 Android 设备僵尸网络，Videostrong 电视盒后门遭曝光","Google 通过法律行动于 10 月下旬接管控制逾 130 万台 Android 设备的僵尸网络，并指称深圳设备厂商 Videostrong 故意在多款电视盒固件中植入 x.cpe 后door，向犯罪分子出售访问权限。",{"_56":131,"_124":125},"2026-11-02T15:50:26.000Z","The Hacker News","ghi7z0u79zotlr12i1ld0lr79","Google 关停 XCPE 僵尸网络并封禁运营商 Videostrong Technology","Google 关停 XCPE 僵尸网络基础设施，并封禁其背后厂商 Videostrong Technology。该后门藏匿于 Android TV 机顶盒固件中，超过 1.3 million 台设备被纳入网络；Google 估计切断关联命令域名还可切断至少 10 million 台通过其他途径和恶意软件家族受控设备的访问。",{"_56":137,"_124":125},"2026-11-02T15:50:46.000Z","Help Net Security","l79qvcx1c4awu9yey6ibz7nvh","Google 与日本国家警察机构及多家安全公司联合中断了 XCPE 僵尸网络，该网络涉及超过 130 万台 Android TV 流媒体机，Google 高置信度认定设备厂商 Videostrong Technology Co. 在制造阶段故意植入持久后门并向犯罪团伙出售访问权限。",{"_56":141,"_124":125},"BleepingComputer",{"_143":144,"_13":145,"_20":21,"_17":18,"_146":147},"factId","flU3MNG-JM7M","Google拆除XCPE僵尸网络","representative",{"_114":115,"_13":116,"_28":117,"_118":148,"_120":21,"_121":122},{"_56":123,"_124":125},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",{"_156":157,"_158":-5},"changelogVersion","2026-10-01T08:00","release"]
