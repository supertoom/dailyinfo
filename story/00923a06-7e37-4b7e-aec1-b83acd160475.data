[{"_1":2,"_3":4},"root",{"_5":276},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794876038000,"publicId","00923a06-7e37-4b7e-aec1-b83acd160475","title","Quantum Systems 无人机更新通道被入侵，德国军方停飞","status","active","reportCount",4,"sourceCount","firstReportAt","2026-11-13T17:31:56.000Z","latestAt","2026-11-16T09:06:11.000Z","digest","德国无人机制造商 Quantum Systems 确认，2026 年 10 月底其 QBase 地面控制与任务规划软件的更新分发服务器遭“敌对行动者”入侵，攻击者通过恶意更新文件向客户推送恶意载荷；公司称威胁已被控制，终端用户和操作人员继续运行无人系统不存在风险，但实际安装该更新的客户数量、影响范围与后果仍不清楚，攻击者身份也未确认，公司方面仅提到攻击可能与其支持乌克兰有关。\n\n德国武装部队出于安全考虑已暂停使用 Quantum Systems 的无人机，并在近期一次军事演习中将该公司的无人系统排除在外。\n\n调查仍在进行中，Der Spiegel 与 Financial Times 援引内部消息称内部与外部专家及政府机构参与其中；军事反情报局（MAD）、国内情报局（BfV）和联邦网络安全局（BSI）参与调查的说法尚未获官方确认。","digestUpdatedAt","2026-11-16T11:50:36.696Z","summary","excerpt","latest","Quantum Systems 无人机控制软件疑遭供应链攻击，德国军方停飞相关无人机","latestReport",{"_235":258},"whyHot",{"_269":126,"_270":271,"_272":126,"_273":243,"_274":275},"developments",[262],"officialReports",[],"timeline",[231,232,233,234],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","black-market","name","数据窃取与黑产","ransomware","勒索软件","iot","IoT 与车联网","supply-chain","供应链安全","malware","恶意软件","attack","攻击活动",{"_122":229,"_42":230,"_125":157},{"_122":227,"_42":228,"_125":157},{"_122":225,"_42":226,"_125":157},{"_122":223,"_42":224,"_125":157},{"_122":221,"_42":222,"_125":157},{"_122":219,"_42":220,"_125":157},{"_122":217,"_42":218,"_125":157},{"_122":215,"_42":216,"_125":157},{"_122":213,"_42":214,"_125":157},{"_122":211,"_42