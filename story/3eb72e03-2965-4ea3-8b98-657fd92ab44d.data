[{"_1":2,"_3":4},"root",{"_5":391},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795221647000,"publicId","3eb72e03-2965-4ea3-8b98-657fd92ab44d","title","F5已修复NGINX五项未认证RCE","status","watching","reportCount",15,"sourceCount","firstReportAt","2026-11-18T15:29:55.488Z","latestAt","2026-11-19T18:25:50.000Z","digest","F5已修复NGINX五项无需认证和用户交互的远程代码执行漏洞：CVE-2026-123007、CVE-2026-123634、CVE-2026-123633、CVE-2026-121810、CVE-2026-113425，CVSS 4.0评分均为9.2。奇安信CERT、微步在线及深信服千里目已复现部分或全部漏洞，CVE-2026-123007已有公开PoC；截至11月19日未发现实际在野利用，受害规模尚未确认。\n\n各漏洞利用前提不同，需分别启用HTTP/2、HTTP/3、resolver配合mirror或SSI、邮件代理等模块，并须能直连监听端口。组合利用可绕过ASLR，以nginx worker权限执行代码；提权至宿主机root还需串联暂无CVE、当时尚未修复的Linux内核SCTP UAF。\n\n修复版本为NGINX Open Source mainline >= 1.31.9、stable >= 1.30.7，以及NGINX Plus >= 37.3.0.1或>= 37.0.8.1；无法立即升级时可禁用HTTP/2，阻断CVE-2026-123007和CVE-2026-123633的已知攻击路径。","digestUpdatedAt","2026-11-19T18:54:57.745Z","summary","excerpt","latest","F5 修复五个严重 NGINX 漏洞，CVE-2026-123007 已有公开 PoC","latestReport",{"_259":336},"whyHot",{"_384":133,"_385":386,"_387":386,"_388":268,"_389":390},"developments",[357,358,359,360,361],"officialReports",[351,352,353],"timeline",[244,245,246,247,248,249,250,251,252,253,254,255,256,257,258],"heat",[72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128],"related",[68],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","sangfor","name","深信服","kernel","内核与系统","qianxin","奇安信","cloud-native","云与原生","research","技术研究","vuln","漏洞披露",{"_11":69,"_13":70,"_71":44},"92393685-eb8c-4aaf-b313-1b8098f352d3","F5修复NGINX两项HTTP/2高危漏洞","relation",{"_129":241,"_42"