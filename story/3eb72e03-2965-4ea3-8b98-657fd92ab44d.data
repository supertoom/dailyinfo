_259":325,"_13":326,"_28":327,"_263":328,"_265":329,"_267":268},{"_259":319,"_13":320,"_28":321,"_263":322,"_265":323,"_267":268},{"_259":313,"_13":314,"_28":315,"_263":316,"_265":317,"_267":268},{"_259":307,"_13":308,"_28":309,"_263":310,"_265":311,"_267":271},{"_259":301,"_13":302,"_28":303,"_263":304,"_265":305,"_267":268},{"_259":295,"_13":296,"_28":297,"_263":298,"_265":299,"_267":268},{"_259":289,"_13":290,"_28":291,"_263":292,"_265":293,"_267":271},{"_259":283,"_13":284,"_28":285,"_263":286,"_265":287,"_267":268},{"_259":277,"_13":278,"_28":279,"_263":280,"_265":281,"_267":268},{"_259":272,"_13":273,"_28":274,"_263":275,"_265":21,"_267":268},{"_259":260,"_13":261,"_28":262,"_263":264,"_265":266,"_267":268},"id","k04ilqg9s0fa5seo9mrr2tsc0","F5 披露 NGINX 远程代码执行漏洞 CVE-2026-123633 与 CVE-2026-123007","F5 于 18 novembre 2026 披露 CVE-2026-123633 与 CVE-2026-123007，未认证攻击者可利用 HTTP/2 在 NGINX Open Source 和 NGINX Plus 上远程执行代码。","source",{"_56":269,"_270":271},"publishedAt","2026-11-18T00:00:00.000Z","selected",true,"CERT-FR","firstParty",false,"u0eiew4pjyv180isf2uqksz3w","Xint 披露 nginx2Root 五项 RCE 漏洞及 Linux 内核提权链","Xint 披露 nginx 的 5 项未认证远程代码执行漏洞 CVE-2026-123007、CVE-2026-123634、CVE-2026-123633、CVE-2026-121810、CVE-2026-113425。",{"_56":276,"_270":271},"Sec-News 安全文摘","wu8b3arca0kc295h5ms9ikw2m","NGINX 1.31.8 被披露五个 CVSS 4.0 9.2 严重漏洞，F5 已在 1.30.7 与 1.31.9 修复","Wiz、Ikotas Labs、Metnir、Rapid7 与 Xint 于 11 月 18 日独立披露 NGINX 1.31.8 中的五个严重漏洞：CVE-2026-113425、CVE-2026-121810、CVE-2026-123007、CVE-2026-123633、CVE-2026-123634。",{"_56":282,"_270":271},"2026-11-18T16:55:00.000Z","Infosecurity Magazine","qfh0sjsz9ouip54rdzkoulw18","nginx 五个远程代码执行漏洞 CVE-2026-123007 等已复现，官方发布 1.31.9 与 1.30.7 修复","长亭安全应急响应中心披露并复现 nginx2root，包含 CVE-2026-123007、CVE-2026-123634、CVE-2026-123633、CVE-2026-121810 和 CVE-2026-113425 五个可独立触发的远程代码执行漏洞。",{"_56":288,"_270":268},"2026-11-18T18:28:00.000Z","长亭安全应急响应中心","lx7ezwin7406o00w2zrl3ostz","nginx2root 披露 nginx 5 个 RCE 漏洞，奇安信 CERT 已成功复现","奇安信 CERT 已复现 nginx2root 包含的 5 个远程代码执行漏洞，主漏洞为 CVE-2026-123007，CVSS 3.1 评分为 8.1；攻击者无需认证，但各漏洞分别需要 HTTP/2、resolver、HTTP/3 或 mail 代理等配置，技术细节与 PoC 已公开，目前未发现在野利用。",{"_56":294,"_270":268},"2026-11-18T23:40:00.000Z","奇安信 CERT","mbxeacdusn1z4f6sixt69mp51","nginx 5 个远程代码执行漏洞披露，CVE-2026-123007 PoC 已公开","nginx 5 个内存破坏类远程代码执行漏洞已披露，其中 CVE-2026-123007 为 HTTP/2 流控整数下溢导致的堆越界读写，PoC 与技术细节已公开，但未发现其在野利用。",{"_56":300,"_270":271},"2026-11-18T23:54:38.010Z","安全内参","m51451stt7lkv5evn4mfrujes","NGINX HTTP/2 远程代码执行漏洞 CVE-2026-123007 已复现","微步在线已在实验环境中复现 NGINX HTTP/2 远程代码执行漏洞 CVE-2026-123007。该漏洞影响启用 HTTP/2 的未修复实例，攻击者无需认证或受害者配合即可远程执行代码并获得 NGINX 工作进程权限；在满足相关环境条件时，还可串联 Linux SCTP 内核漏洞实现宿主机 root 提权及容器逃逸。",{"_56":306,"_270":268},"2026-11-19T00:56:00.000Z","微步在线研究响应中心","sxwlzz7u7rt5txga45723fqlj","Nginx 5个远程代码执行漏洞 CVE-2026-123007等已修复","Nginx和F5修复了被统称为“nginx2root”的5个远程代码执行漏洞，CVE-2026-123007、CVE-2026-123634、CVE-2026-123633、CVE-2026-121810、CVE-2026-113425的CVSS评分均为9.2。",{"_56":312,"_270":268},"2026-11-19T04:40:00.000Z","绿盟科技CERT","u5of3sbmjv5zvaxsxp6jgty56","nginx2root 披露 5 个 nginx 严重漏洞及 Linux 内核提权链","Xint Research 披露 nginx2root，包含 5 个 CVSS 4.0 9.2 的 nginx 严重漏洞及 1 个 Linux 内核 SCTP 缺陷，其中 CVE-2026-123007 可被未认证远程攻击者利用，结合内核缺陷可在主机上取得 root。",{"_56":318,"_270":271},"2026-11-19T09:21:19.000Z","Security Affairs","uhvazvdp48xo8g4vjsd383z43","nginx 多模块内存安全漏洞链式 RCE：五个 CVE 影响至 1.31.8","nginx2root 是 CVE-2026-123007、CVE-2026-123634、CVE-2026-123633、CVE-2026-121810、CVE-2026-113425 组成的链式远程代码执行漏洞集，启用 HTTP/2、HTTP/3、resolver 配合 mirror 或 SSI、邮件代理等模块的目标在无需认证的情况下可被远程触发。",{"_56":324,"_270":268},"2026-11-19T09:51:00.000Z","深信服千里目安全实验室","dkw46tv6a8k8b34f68d5olf62","nginx 5 个远程代码执行漏洞披露，CVE-2026-123007 等影响多个版本","奇安信 CERT 转述 nginx2root 披露的 5 个远程代码执行漏洞，分别为 CVE-2026-123007、CVE-2026-123634、CVE-2026-123633、CVE-2026-121810 和 CVE-2026-113425。",{"_56":300,"_270":271},"2026-11-19T10:08:00.000Z","y2rg6xqvlodeoy597yrc3i73v","F5 修复五个 NGINX2Root 严重漏洞，公开 PoC 已出现","F5 修复了 22 个漏洞，其中 CVE-2026-113425、CVE-2026-121810、CVE-2026-123007、CVE-2026-123633 和 CVE-2026-123634 可导致未认证远程代码执行（RCE），CVSS 均为 9.2。",{"_56":335,"_270":271},"2026-11-19T10:26:51.000Z","SecurityWeek","vdcgjh03yopnovtcpd570z8c7","F5 修复了五个可导致远程代码执行的 NGINX 严重漏洞，包括 CVE-2026-123007、CVE-2026-123633、CVE-2026-123634、CVE-2026-121810 和 CVE-2026-113425；截至 November 19 均无在野利用证据，也未进入 CISA KEV，但 CVE-2026-123007 已有公开 PoC。",{"_56":339,"_270":271},"Help Net Security","zp8d6zx3kkva6gw0b0abpm2pv","nginx 披露五项内存破坏漏洞 CVE-2026-123007 等，Cloudflare 分析代理防护边界","F5 与 nginx.org 披露五项 nginx 内存破坏漏洞，未认证攻击者在特定配置下可导致 worker 崩溃，并在禁用或绕过 ASLR 时执行服务器命令；Xint 还发现可由 Docker 容器内提权至宿主机 root 的 Linux SCTP use-after-free。",{"_56":345,"_270":271},"2026-11-20T01:58:29.000Z","Cloudflare Blog","b7fagpjz2rm06udejoz3syyf2","Cisco 排查 nginx 远程代码执行漏洞对产品的影响","Cisco PSIRT 通报 nginx 1.9.5 至 1.31.8 存在多个可能导致远程代码执行的严重漏洞，已在 1.31.9 和 1.30.7 修复，涉及 CVE-2026-113425、CVE-2026-121810、CVE-2026-123007、CVE-2026-123633、CVE-2026-123634。",{"_56":350,"_270":268},"Cisco PSIRT",{"_259":319,"_13":320,"_28":321,"_263":356,"_265":323,"_267":268},{"_259":301,"_13":302,"_28":303,"_263":355,"_265":305,"_267":268},{"_259":289,"_13":290,"_28":291,"_263":354,"_265":293,"_267":271},{"_56":294,"_270":268},{"_56":306,"_270":268},{"_56":324,"_270":268},{"_362":380,"_13":381,"_20":23,"_17":243,"_365":382},{"_362":376,"_13":377,"_20":323,"_17":243,"_365":378},{"_362":372,"_13":373,"_20":305,"_17":243,"_365":374},{"_362":368,"_13":369,"_20":293,"_17":243,"_365":370},{"_362":363,"_13":364,"_20":21,"_17":232,"_365":366},"factId","fhCq_qoGx8H4","披露五个nginx远程代码执行漏洞","representative",{"_259":272,"_13":273,"_28":274,"_263":367,"_265":21,"_267":268},{"_56":276,"_270":271},"fN80Slipii7o","复现nginx五个远程代码执行漏洞",{"_259":289,"_13":290,"_28":291,"_263":371,"_265":293,"_267":271},{"_56":294,"_270":268},"fM_VcWDToZd0","复现NGINX HTTP/2远程代码执行漏洞",{"_259":301,"_13":302,"_28":303,"_263":375,"_265":305,"_267":268},{"_56":306,"_270":268},"f5oiCJkyk6mg","监测并通告nginx漏洞链",{"_259":319,"_13":320,"_28":321,"_263":379,"_265":323,"_267":268},{"_56":324,"_270":268},"fNEm6j8Aay-w","F5修复五个NGINX严重漏洞",{"_259":336,"_13":31,"_28":337,"_263":383,"_265":23,"_267":271},{"_56":339,"_270":271},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",10,{"_392":393,"_394":-5},"changelogVersion","2026-10-01T08:00","release"]
