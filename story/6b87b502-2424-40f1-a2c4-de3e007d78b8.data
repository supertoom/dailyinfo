[{"_1":2,"_3":4},"root",{"_5":417},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":-5,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48},"expiresAt",1795480850000,"publicId","6b87b502-2424-40f1-a2c4-de3e007d78b8","title","CISA确认Cisco Expressway漏洞遭在野利用","status","active","reportCount",9,"sourceCount",7,"firstReportAt","2026-11-19T13:12:20.000Z","latestAt","2026-11-23T10:00:00.000Z","digest","CISA已确认Cisco Expressway远程代码执行漏洞CVE-2026-76466（CVSS 9.8）遭在野利用，并将其加入KEV目录，要求美国联邦民事机构在3天内完成处置；Cisco称没有直接证据确认该漏洞存在主动利用或公开PoC，与CISA及F6披露的实际情况存在差异。\n\n该漏洞影响采用集群部署的Expressway-C和Expressway-E虚拟版及设备版；具备网络访问权限的未认证攻击者可利用持久Cookie连接数据库服务并调用特定RPC命令，以root身份执行任意操作系统命令。Cisco已发布X15.5.3及更早X15.5.20版本的修复软件，无临时解决方案。\n\nF6称，攻击者入侵一家俄罗斯机构的两台互联网暴露设备，并经其中一台触达两个内网集群节点，随后尝试访问SMB资源、SQL Server、WinRM和GitLab以窃取凭据及敏感数据；攻击尚未归因。","digestUpdatedAt","2026-11-23T16:40:03.529Z","summary","excerpt","latest","Cisco Expressway 漏洞 CVE-2026-76466 已被用于攻击，CVSS 9.8","latestReport",{"_337":383},"whyHot",{"_411":160,"_412":413,"_414":160,"_415":345,"_416":295},"developments",[394,395,396],"officialReports",[392],"timeline",[328,329,330,331,332,333,334,335,336],"heat",[69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130,131,132,133,134,135,136,137,138,139,140,141,142,143,144,145,146,147,148,149,150,151,152,153,154,155],"related",[],"topics",[49,50,51,52,53,54],{"_55":67,"_57":68},{"_55":65,"_57":66},{"_55":63,"_57":64},{"_55":61,"_57":62},{"_55":59,"_57":60},{"_55":56,"_57":58},"slug","ransomware","name","勒索软件","cisa","CISA","attack","攻击活动","vuln","漏洞披露","exploited","在野利用","cisco","Cisco / 思科",{"_156":326,"_43":327,"_159":193},{"_156":324,"_43":325,"_159":193},{"_156":322,"_43":323,"_159":193},{"_156":321,"_43":18,"_159":193},{"_156":3