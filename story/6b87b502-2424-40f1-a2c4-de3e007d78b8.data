28":202,"_186":203,"_188":130,"_189":190},{"_182":194,"_13":195,"_28":196,"_186":197,"_188":198,"_189":190},{"_182":183,"_13":184,"_28":185,"_186":187,"_188":21,"_189":190},"id","u9nf8h7shihjjmr2eilozrfc0","Cisco Expressway 漏洞 CVE-2026-76466 已在野利用，F6 披露入侵过程","Cisco Expressway 漏洞 CVE-2026-76466（CVSS 9.8）已在 PoC 公开后被用于入侵一家俄罗斯机构，攻击者无需认证即可在集群设备上以 root 权限执行命令，受影响的是 Expressway Core 与 Edge 的虚拟和设备版本，仅集群部署存在风险。","source",{"_56":191,"_192":193},"publishedAt","selected",true,"SecurityWeek","firstParty",false,"uqh0881s53j5550dvvx6q1slk","攻击者利用 Cisco Expressway 漏洞 CVE-2026-76466 入侵 4 台设备并进入内网","Cisco Expressway 漏洞 CVE-2026-76466（CVSS 9.8）已在真实攻击中被利用，未经身份验证且具备网络访问权限的攻击者可取得 root 权限并执行任意操作系统命令。",{"_56":199,"_192":193},"2026-11-20T10:32:50.000Z","The Hacker News","sjin4pr8q1dp00z0igue1371g","CISA将4个漏洞纳入KEV Catalog，均有真实利用证据","CISA将CVE-2025-42884、CVE-2026-76466、CVE-2026-123890和CVE-2026-129448纳入KEV Catalog，依据是这些漏洞已有在野利用证据，分别涉及SAP NetWeaver、Cisco Expressway Series、VMWare vCenter和Apache Roller。",{"_56":204,"_192":190},"CISA 安全公告","bufu1h0d9vez47s5bnwwxtm1b","攻击者利用 Cisco Expressway 漏洞 CVE-2026-76466 入侵一家俄罗斯组织，在 X15.5.3 设备上以未认证远程方式执行 root 命令。",{"_56":208,"_192":193},"Security Affairs",{"_210":211,"_13":212,"_20":21,"_17":107,"_213":214},"factId","fRNCBIg2Zuh4","攻击者利用Expressway漏洞入侵俄机构","representative",{"_182":194,"_13":195,"_28":196,"_186":215,"_188":198,"_189":190},{"_56":199,"_192":193},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",{"_223":224,"_225":-5},"changelogVersion","2026-10-01T08:00","release"]
