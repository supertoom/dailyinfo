[{"_1":2,"_3":4},"root",{"_5":222},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795221647000,"publicId","6b87b502-2424-40f1-a2c4-de3e007d78b8","title","Cisco Expressway漏洞已用于入侵俄机构","status","active","reportCount",4,"sourceCount","firstReportAt","2026-11-19T13:12:20.000Z","latestAt","2026-11-20T12:52:40.000Z","digest","F6称，攻击者在概念验证代码公开后利用Cisco Expressway远程代码执行漏洞CVE-2026-76466（CVSS 9.8），入侵一家俄罗斯机构的4台X15.5.3设备，包括2台互联网暴露设备及经其中一台触达的2个内网集群节点。该漏洞无需认证，但攻击者须具备设备网络访问权限，可取得root权限并执行任意操作系统命令；影响Expressway Core与Edge的虚拟版和设备版，但仅集群部署存在风险。\n\nF6称，攻击者随后用自定义Python脚本扫描网络、发现SMB资源、交互SQL Server和WinRM并访问GitLab仓库，以窃取凭据及敏感数据。Cisco已于10月21日发布修复，因此该漏洞被利用时并非零日；其公告尚未更新，仍称不知道漏洞已被公开利用或用于恶意活动，是否需要额外配置或重启未说明，攻击也未归因于已知组织。","digestUpdatedAt","2026-11-20T13:27:09.078Z","summary","excerpt","latest","攻击者利用 Cisco Expressway 漏洞 CVE-2026-76466 入侵俄罗斯组织","latestReport",{"_182":205},"whyHot",{"_216":107,"_217":218,"_219":132,"_220":190,"_221":143},"developments",[209],"officialReports",[],"timeline",[178,179,180,181],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","red-team","name","红队与渗透","black-market","数据窃取与黑产","ransomware","勒索软件","attack","攻击活动","exploited","在野利用","cisco","Cisco / 思科",{"_103":176,"_42":177,"_106":137},{"_103":174,"_42":175,"_106":137},{"_103":172,"_42":173,"_106":137},{"_103":170,"_42":171,"_106":137},{"_103":168,"_42":169,"_106":137},{"_103":166,"_42":167,"_106":137},{"_103":164,"_42":165,"_106":137},{"_103":162,"_42":163,"_106":137},{"_103":160,"_42":161,"_106":137},{"_103":158,"_42":159,"_106":137},{"_103":156,"_42":157,"_106":137},{"_103":154,"_42":155,"