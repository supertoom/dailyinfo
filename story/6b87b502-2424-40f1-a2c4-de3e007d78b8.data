[{"_1":2,"_3":4},"root",{"_5":301},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":-5,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48},"expiresAt",1795308047000,"publicId","6b87b502-2424-40f1-a2c4-de3e007d78b8","title","Cisco Expressway漏洞已用于入侵俄机构","status","watching","reportCount",5,"sourceCount",4,"firstReportAt","2026-11-19T13:12:20.000Z","latestAt","2026-11-20T12:52:40.000Z","digest","F6称，攻击者在概念验证代码公开后利用Cisco Expressway远程代码执行漏洞CVE-2026-76466（CVSS 9.8），入侵一家俄罗斯机构的4台X15.5.3设备，包括2台互联网暴露设备及经其中一台触达的2个内网集群节点。该漏洞无需认证，但攻击者须具备设备网络访问权限，可取得root权限并执行任意操作系统命令；影响Expressway Core与Edge的虚拟版和设备版，但仅集群部署存在风险。\n\nF6称，攻击者随后用自定义Python脚本扫描网络、发现SMB资源、交互SQL Server和WinRM并访问GitLab仓库，以窃取凭据及敏感数据。Cisco已于10月21日发布修复，因此该漏洞被利用时并非零日；其公告尚未更新，仍称不知道漏洞已被公开利用或用于恶意活动，是否需要额外配置或重启未说明，攻击也未归因于已知组织。","digestUpdatedAt","2026-11-20T13:27:09.078Z","summary","excerpt","latest","攻击者利用 Cisco Expressway 漏洞 CVE-2026-76466 入侵俄罗斯组织","latestReport",{"_256":279},"whyHot",{"_295":132,"_296":297,"_298":297,"_299":264,"_300":216},"developments",[288],"officialReports",[],"timeline",[251,252,253,254,255],"heat",[69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127],"related",[],"topics",[49,50,51,52,53,54],{"_55":67,"_57":68},{"_55":65,"_57":66},{"_55":63,"_57":64},{"_55":61,"_57":62},{"_55":59,"_57":60},{"_55":56,"_57":58},"slug","red-team","name","红队与渗透","black-market","数据窃取与黑产","ransomware","勒索软件","attack","攻击活动","exploited","在野利用","cisco","Cisco / 思科",{"_128":249,"_43":250,"_131":210},{"_128":247,"_43":248,"_131":210},{"_128":245,"_43":246,"_131":210},{"_128":243,"_43":244,"_131":210},{"_128":241,"_43":242,"_131":210},{"_128":239,"_43":240,"_131":210},{"_128":237,"_43":238,"_131":210},{"_128":235,"_43":236,"_131":210},{"_128":233,"_43":23