[{"_1":2,"_3":4},"root",{"_5":207},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1793591189000,"publicId","038a18c5-a6fe-4fe6-89fe-22bf5ade225b","title","Chainalysis确认内部系统遭智能体化攻击","status","watching","reportCount",2,"sourceCount","firstReportAt","2026-10-31T12:01:56.000Z","latestAt","2026-10-31T12:50:09.000Z","digest","Chainalysis确认，外部攻击者使用其称为“进攻性智能体技术”的方式越权进入内部系统及工具，部分平台客户数据被访问，包括用户ID、完整姓名、电子邮箱和组织角色标签。公司称，调查目前未发现调查内容、身份验证凭据或会话令牌被未授权访问，尚未说明具体漏洞、工具或访问时长。\n\nChainalysis表示正在修补漏洞并强化系统，未提供修复版本、额外配置或重启要求；攻击者是否使用ARTEX等现成智能体化渗透框架，还是自主构建智能体，仍不明确。","digestUpdatedAt","2026-10-31T13:15:49.104Z","summary","excerpt","latest","Chainalysis 披露攻击者利用智能体化技术入侵内部系统并访问客户数据","latestReport",{"_177":188},"whyHot",{"_199":18,"_200":201,"_202":201,"_203":204,"_205":206},"developments",[192],"officialReports",[],"timeline",[175,176],"heat",[59,60,61,62,63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96],"related",[],"topics",[48,49,50],{"_51":57,"_53":58},{"_51":55,"_53":56},{"_51":52,"_53":54},"slug","attack","name","攻击活动","ai-offense","AI 攻防","identity","身份与访问",{"_97":173,"_42":174,"_100":18},{"_97":171,"_42":172,"_100":18},{"_97":169,"_42":170,"_100":18},{"_97":167,"_42":168,"_100":18},{"_97":165,"_42":166,"_100":18},{"_97":163,"_42":164,"_100":18},{"_97":161,"_42":162,"_100":18},{"_97":159,"_42":160,"_100":18},{"_97":157,"_42":158,"_100":18},{"_97":155,"_42":156,"_100":18},{"_97":153,"_42":154,"_100":18},{"_97":151,"_42":152,"_100":18},{"_97":149,"_42":150,"_100":18},{"_97":147,"_42":148,"_100":18},{"_97":145,"_42":146,"_100":18},{"_97":143,"_42":144,"_100":18},{"_97":141,"_42":142,"_100":18},{"_97":139,"_42":140,"_100":18},{"_97":137,"_42":138,"_100":18},{"_97":135,"_42":136,"_100":18},{"_97":133,"_42":134,"_100":18},{"_97":131,"_42":132,"