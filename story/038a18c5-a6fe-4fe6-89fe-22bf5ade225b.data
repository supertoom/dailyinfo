[{"_1":2,"_3":4},"root",{"_5":308},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1793672470000,"publicId","038a18c5-a6fe-4fe6-89fe-22bf5ade225b","title","Chainalysis确认智能体化入侵事件","status","active","reportCount",5,"sourceCount","firstReportAt","2026-10-31T12:01:56.000Z","latestAt","2026-11-02T11:40:19.000Z","digest","Chainalysis确认，外部攻击者于10月使用其称为“进攻性智能体技术”的方式越权进入公司系统及内部工具，访问了部分平台用户的用户ID、完整姓名、电子邮箱和组织角色标签；公司正在修补漏洞并强化系统，但未披露具体漏洞、修复版本、受损系统、访问时长或完整影响范围。\n\nChainalysis称，现有调查未发现调查图表、笔记、案件、交易或查询结果，以及明文密码、MFA密钥和用户会话令牌遭未授权访问，因此客户账号应仍然安全。其尚未说明攻击是否使用ARTEX等现成框架或自主定制AI智能体，并称此次事件与近期Binance入侵无关。","digestUpdatedAt","2026-11-02T11:46:02.777Z","summary","excerpt","latest","Chainalysis 遭外部攻击者入侵，部分客户身份信息被访问","latestReport",{"_261":290},"whyHot",{"_301":133,"_302":303,"_304":133,"_305":306,"_307":18},"developments",[294],"officialReports",[],"timeline",[256,257,258,259,260],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","ai-agent","name","AI Agent 安全","incident","应急响应","ai-security","AI 安全","ai-offense","AI 攻防","identity","身份与访问","attack","攻击活动",{"_129":254,"_42":255,"_132":171},{"_129":252,"_42":253,"_132":171},{"_129":250,"_42":251,"_132":171},{"_129":248,"_42":249,"_132":171},{"_129":246,"_42":247,"_132":171},{"_129":244,"_42":245,"_132":171},{"_129":242,"_42":243,"_132":171},{"_129":240,"_42":241,"_132":171},{"_129":238,"_42":239,"_132":171},{"_129":236,"_42":237,"_132":171},{"_129":234,"_42":235,"_132":171},{"_129":232,"_42":233,"_132":171},{"_129":2