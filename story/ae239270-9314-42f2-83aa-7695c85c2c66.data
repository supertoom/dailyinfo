[{"_1":2,"_3":4},"root",{"_5":147},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795653657000,"publicId","ae239270-9314-42f2-83aa-7695c85c2c66","title","Mysterium 称乌克兰 Electrolux 热水器连接俄方服务器","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-25T10:52:43.000Z","latestAt","2026-11-25T12:50:15.000Z","digest","Mysterium VPN 研究团队称，乌克兰境内一台 Electrolux EWH 80 智能热水器会解析并连接 mqtt.cloud.rusklimat.ru（130.193.49[.]173，托管于 Yandex.Cloud），并通过 Hommyn、ClimatOn 应用把登录凭据（手机号或邮箱）与设备名称、房间信息发往 Rusklimat 服务器，设备历史保存在 Yandex Cloud，手机位置则发往 Hommyn 的天气服务；应用内隐私政策写明运营方为莫斯科的 R-Klimat LLC，称用户个人信息“完全在俄罗斯境内”存储并适用俄法律。Mysterium 还发现 ClimatOn 有一台位于德国亚马逊基础设施上的服务器。\n\n该发现来自代码审阅而非对设备或服务器的实际连接测试，研究人员表示无法确认设备实际发送了哪些数据；据早先报道，一名乌克兰用户为阻止热水器向“莫斯科”发送数据而不得不加以拦截。Electrolux 或 Rusklimat 是否已作出处置，报道未提及，也未见受影响型号与用户规模的确认数字。","digestUpdatedAt","2026-11-25T15:25:32.853Z","summary","excerpt","latest","乌克兰 Electrolux EWH 80 热水器连接俄罗斯服务器引发隐私担忧","latestReport",{"_112":123},"whyHot",{"_139":18,"_140":141,"_142":18,"_143":144,"_145":146},"developments",[127,128],"officialReports",[],"timeline",[110,111],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","attack","name","攻击活动","red-team","红队与渗透","supply-chain","供应链安全","black-market","数据窃取与黑产","ransomware","勒索软件","iot","IoT 与车联网",{"_81":107,"_42":108,"_84":109},{"_81":105,"_42":106,"_84":18},{"_81":103,"_42":104,"_84":18},{"_81":101,"_42":102,"_84":18},{"_81":99,"_42":100,"_84":18},{"_81":97,"_42":98,"_84":18},{"_81":95,"_42":96,"_84":18},{"_81":93,"_42":94,"_84":18},{"_81":91,"_42":92,"_84":18},{"_81":89,"_42":90,"_84":18},{"_81":87,"_42":88,"_84":18},{"_81":85,"_42":86,"_84":18},{"_81":82,"_42":83,"_84":18},"hour","2026-11-26T00:00:00.000Z",14.1,"participants","2026-11-25T23:00:00.000Z",14.5,"2026-11-25T22:00:00.000Z",14.9,"2026-11-25T21:00:00.000Z",15.4,"2026-11-25T20:00:00.000Z",15.8,"2026-11-25T19:00:00.000Z",16.3,"2026-11-25T18:00:00.000Z",16.8,"2026-11-25T17:00:00.000Z",17.2,"2026-11-25T16:00:00.000Z",17.8,"2026-11-25T15:00:00.000Z",18.3,"2026-11-25T14:00:00.000Z",18.8,"2026-11-25T13:00:00.000Z",19.4,"2026-11-25T12:00:00.000Z",9.7,1,{"_112":123,"_13":31,"_28":124,"_116":125,"_118":23,"_119":120},{"_112":113,"_13":114,"_28":115,"_116":117,"_118":21,"_119":120},"id","m6o11w97jxgb2kqpv4se6qpdw","Electrolux 智能热水器被曝连接俄罗斯云端并向莫斯科发送数据","一名乌克兰用户发现其 Electrolux 智能热水器会连接俄罗斯云端，并将数据发送至莫斯科，用户最终不得不阻止该设备向“莫斯科”传输数据。原文未说明具体数据内容、受影响型号或厂商的处置情况。","source",{"_56":121,"_122":120},"publishedAt","selected",false,"Cybernews","firstParty","ycmsxkiiv61yijxm8ac4nopw8","Mysterium VPN 发现乌克兰境内一台 Electrolux EWH 80 热水器会解析并连接 mqtt.cloud.rusklimat.ru，相关地址为 130.193.49[.]173，托管于 Yandex.Cloud。",{"_56":126,"_122":120},"Security Affairs",{"_129":135,"_13":136,"_20":23,"_17":109,"_132":137},{"_129":130,"_13":131,"_20":21,"_17":109,"_132":133},"factId","fSR-cdUiEmig","乌克兰用户阻止热水器连接俄云","representative",{"_112":113,"_13":114,"_28":115,"_116":134,"_118":21,"_119":120},{"_56":121,"_122":120},"fgxsJqmYmXIU","Mysterium披露智能热水器连接俄方服务器",{"_112":123,"_13":31,"_28":124,"_116":138,"_118":23,"_119":120},{"_56":126,"_122":120},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete",true,"rank",8,{"_148":149,"_150":-5},"changelogVersion","2026-10-01T08:00","release"]
