[{"_1":2,"_3":4},"root",{"_5":217},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795740055000,"publicId","ae239270-9314-42f2-83aa-7695c85c2c66","title","Mysterium 称乌克兰 Electrolux 热水器连接俄方服务器","status","watching","reportCount",2,"sourceCount","firstReportAt","2026-11-25T10:52:43.000Z","latestAt","2026-11-25T12:50:15.000Z","digest","Mysterium VPN 研究团队称，乌克兰境内一台 Electrolux EWH 80 智能热水器会解析并连接 mqtt.cloud.rusklimat.ru（130.193.49[.]173，托管于 Yandex.Cloud），并通过 Hommyn、ClimatOn 应用把登录凭据（手机号或邮箱）与设备名称、房间信息发往 Rusklimat 服务器，设备历史保存在 Yandex Cloud，手机位置则发往 Hommyn 的天气服务；应用内隐私政策写明运营方为莫斯科的 R-Klimat LLC，称用户个人信息“完全在俄罗斯境内”存储并适用俄法律。Mysterium 还发现 ClimatOn 有一台位于德国亚马逊基础设施上的服务器。\n\n该发现来自代码审阅而非对设备或服务器的实际连接测试，研究人员表示无法确认设备实际发送了哪些数据；据早先报道，一名乌克兰用户为阻止热水器向“莫斯科”发送数据而不得不加以拦截。Electrolux 或 Rusklimat 是否已作出处置，报道未提及，也未见受影响型号与用户规模的确认数字。","digestUpdatedAt","2026-11-25T15:25:32.853Z","summary","excerpt","latest","乌克兰 Electrolux EWH 80 热水器连接俄罗斯服务器引发隐私担忧","latestReport",{"_183":194},"whyHot",{"_210":18,"_211":212,"_213":212,"_214":215,"_216":132},"developments",[198,199],"officialReports",[],"timeline",[181,182],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","attack","name","攻击活动","red-team","红队与渗透","supply-chain","供应链安全","black-market","数据窃取与黑产","ransomware","勒索软件","iot","IoT 与车联网",{"_105":179,"_42":130,"_108":180},{"_105":177,"_42":178,"_108":18},{"_105":175,"_42":176,"_108":18},{"_105":173,"_42":174,"_108":18},{"_105":171,"_42":172,"_108":18},{"_105":169,"_42":170,"_108":18},{"_105":167,"_42":168,"_108":18},{"_105":165,"_42":166,"_108":18},{"_105":163,"_42":164,"_108":18}