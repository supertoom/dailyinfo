[{"_1":2,"_3":4},"root",{"_5":267},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794616838000,"publicId","bfdc6f86-491d-43b2-8633-af8a571001fd","title","wfx-loot借GitHub令牌窃取CI凭据","status","active","reportCount",6,"sourceCount","firstReportAt","2026-11-12T06:42:47.000Z","latestAt","2026-11-13T09:41:06.000Z","digest","Aikido Security发现并命名“wfx-loot”攻击：攻击者利用4,837个失陷GitHub账户的有效令牌，自11月10日起向61,764个公共仓库提交探测Pull Request以测试写权限，并通过篡改或新增GitHub Actions工作流植入约1,500行凭据窃取脚本。研究人员确认至少1,835个目标发生凭据窃取；SafeDep另统计8,093个公共仓库收到恶意提交，但这不代表窃密程序均成功执行。\n\n该攻击依赖被盗令牌，并非利用已披露的GitHub软件漏洞。在确认发生执行的仓库中，工作流可访问的机密和云角色都应视为泄露并立即轮换；Aikido还称，安装或打开受影响Packagist包的机器，以及在受影响提交上运行过npm install的机器，也应视为被攻陷并轮换密钥。Aikido的检索仅覆盖公共仓库默认分支，实际影响可能更高；报道未说明统一补丁、额外配置或重启要求。","digestUpdatedAt","2026-11-13T10:31:30.185Z","summary","excerpt","latest","攻击者利用 4,837 个失陷 GitHub 账号窃取 61,764 个仓库凭据","latestReport",{"_204":240},"whyHot",{"_261":18,"_262":263,"_264":195,"_265":212,"_266":186},"developments",[244,245,246],"officialReports",[],"timeline",[198,199,200,201,202,203],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","black-market","name","数据窃取与黑产","ransomware","勒索软件","malware","恶意软件","attack","攻击活动","identity","身份与访问","supply-chain","供应链安全",{"_109":196,"_42":197,"_112":195},{"_109":193,"_42":194,"_112":195},{"_109":191,"_42":192,"_112":186},{"_109":189,"_42":190,"_112":186},{"_109":187,"_42":188,"_112":186},{"_109":184,"_42":185,"_112":186},{"_109":181,"_42":182,"_112":183},{"_109":179,"_42":180,"_112":166},{"_109":177,"_42":178,"_112":166},{"_109":175,"_42":176,"_112":166},{"