[{"_1":2,"_3":4},"root",{"_5":186},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794530497000,"publicId","bfdc6f86-491d-43b2-8633-af8a571001fd","title","wfx-loot借GitHub令牌窃取CI凭据","status","active","reportCount",5,"sourceCount","firstReportAt","2026-11-12T06:42:47.000Z","latestAt","2026-11-12T22:25:30.000Z","digest","Aikido Security发现并命名“wfx-loot”攻击：攻击者利用4,837个失陷GitHub账户的有效凭据，自11月10日起探测61,764个公共仓库的写权限，并通过篡改或新增GitHub Actions工作流植入窃密程序。研究人员确认至少1,835个目标的机密与云凭据已被窃取；Cybernews称恶意软件被推送至逾6.5万个仓库，但未列出具体密钥类型或仓库明细。\n\nAikido统计的1,835仅覆盖其检索的公共仓库默认分支，实际范围可能更高；SafeDep另统计8,093个公共仓库收到恶意提交，但不表示窃密程序均成功执行。已确认执行恶意代码的仓库中，工作流可访问的所有机密和云角色都应视为泄露并立即轮换；Aikido还称，安装或打开受影响Packagist包的机器，以及在受影响提交上运行过npm install的机器，也应视为被攻陷并轮换密钥。","digestUpdatedAt","2026-11-12T22:49:42.494Z","summary","excerpt","latest","攻击者利用 4,837 个失陷 GitHub 账户窃取云凭据","latestReport",{"_130":160},"whyHot",{"_181":18,"_182":122,"_183":18,"_184":138,"_185":113},"developments",[164,165,166],"officialReports",[],"timeline",[125,126,127,128,129],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","malware","name","恶意软件","black-market","数据窃取与黑产","ransomware","勒索软件","attack","攻击活动","identity","身份与访问","supply-chain","供应链安全",{"_85":123,"_42":124,"_88":122},{"_85":120,"_42":121,"_88":122},{"_85":118,"_42":119,"_88":113},{"_85":116,"_42":117,"_88":113},{"_85":114,"_42":115,"_88":113},{"_85":111,"_42":112,"_88":113},{"_85":108,"_42":109,"_88":110},{"_85":106,"_42":107,"_88":93},{"_85":104,"_42":105,"_88":93},{"_85":102,"_42":103,"_88":93},{"_85":100,"_42":101,"_88":93},{"_85":98,"_42":99,"_88":93},{"_85":96,"_42":97,"_88":93},{"_85":94,"_42":95,"_88":93},{"_85":91,"_42":92,"_88":93},{"_85":89,"_42":90,"_88":18},{"_85":86,"_42":87,"_88":18},"hour","2026-11-13T00:00:00.000Z",37.2,"participants","2026-11-12T23:00:00.000Z",38.3,"2026-11-12T22:00:00.000Z",29.3,4,"2026-11-12T21:00:00.000Z",30.2,"2026-11-12T20:00:00.000Z",31.1,"2026-11-12T19:00:00.000Z",32,"2026-11-12T18:00:00.000Z",32.9,"2026-11-12T17:00:00.000Z",33.9,"2026-11-12T16:00:00.000Z",34.9,"2026-11-12T15:00:00.000Z",35.9,"2026-11-12T14:00:00.000Z",26.8,3,"2026-11-12T13:00:00.000Z",17.4,2,"2026-11-12T12:00:00.000Z",17.9,"2026-11-12T11:00:00.000Z",18.4,"2026-11-12T10:00:00.000Z",18.9,"2026-11-12T09:00:00.000Z",9.4,1,"2026-11-12T08:00:00.000Z",9.6,{"_130":160,"_13":31,"_28":161,"_134":162,"_136":23,"_137":138},{"_130":154,"_13":155,"_28":156,"_134":157,"_136":158,"_137":141},{"_130":148,"_13":149,"_28":150,"_134":151,"_136":152,"_137":138},{"_130":142,"_13":143,"_28":144,"_134":145,"_136":146,"_137":138},{"_130":131,"_13":132,"_28":133,"_134":135,"_136":21,"_137":138},"id","m2uopbxw2xg55pf3fx6t03uwr","攻击者利用 4,837 个劫持 GitHub 账户在 1,806+ 个仓库运行 CI 密钥窃取器","攻击者使用从周二起窃取的 4,837 个 GitHub 账户凭据，通过标题为 docs: dependency audit notes 的测试 Pull Request 检查写权限。","source",{"_56":139,"_140":141},"publishedAt","selected",true,"The Hacker News","firstParty",false,"fcs46bdi67nio6b843uvibe15","wfx-loot 攻击 GitHub 仓库并窃取 CI 与云凭据","Aikido 发现攻击者使用被盗 GitHub 凭据，自 11 月 10 日以来向 61,764 个仓库提交探测 pull request，涉及 4,837 个账户，其中 10,431 个请求通过协作者或组织权限进入非自有仓库。",{"_56":147,"_140":141},"2026-11-12T09:24:32.000Z","Help Net Security","ds03g4k6eknewon9ob4w2q2ms","攻击者借合法令牌污染 61,764 个 GitHub 仓库窃取凭据","攻击者利用开发者与机器人账号的有效令牌，通过探测 Pull Request 测试对 61,764 个 GitHub 仓库的访问和修改权限，并在可执行恶意代码的仓库中植入凭据窃取程序。",{"_56":153,"_140":141},"2026-11-12T13:39:03.000Z","SecurityWeek","vykhezisz8fioexr5da8o2q9n","攻击者利用被盗 GitHub token 将窃密恶意软件推送至 65K+ 仓库","大规模攻击利用被盗的有效 GitHub token 修改现有 GitHub Actions 工作流或新增工作流，将窃取密钥的恶意软件推送至 65K+ GitHub 仓库。攻击链条以泄露的 GitHub 凭据为起点，通过篡改 CI/CD 工作流扩大影响范围，材料未说明恶意软件家族、具体密钥类型及受影响仓库明细。",{"_56":159,"_140":141},"2026-11-12T14:36:08.000Z","Cybernews","azjotibfplqodvsedcpslnw3c","攻击者通过 4,837 个失陷 GitHub 账户探测 61,764 个仓库的写入权限，并利用恶意 GitHub Actions 工作流窃取至少 1,835 个目标的秘密与云凭据。",{"_56":163,"_140":141},"BleepingComputer",{"_167":177,"_13":178,"_20":158,"_17":122,"_170":179},{"_167":173,"_13":174,"_20":152,"_17":122,"_170":175},{"_167":168,"_13":169,"_20":21,"_17":110,"_170":171},"factId","fPjWZMOAsDWI","攻击者利用4837个GitHub账户植入CI密钥窃取器","representative",{"_130":131,"_13":132,"_28":133,"_134":172,"_136":21,"_137":138},{"_56":139,"_140":141},"fYCH4R0e4yn4","攻击者向逾6万GitHub仓库植入窃取凭据恶意代码",{"_130":148,"_13":149,"_28":150,"_134":176,"_136":152,"_137":138},{"_56":153,"_140":141},"f8-hQ3OEsYsQ","攻击者向逾6.5万个GitHub仓库植入窃密恶意软件",{"_130":154,"_13":155,"_28":156,"_134":180,"_136":158,"_137":141},{"_56":159,"_140":141},"participants48h","newParticipants6h","recentReports24h","observationComplete","rank",{"_187":188,"_189":-5},"changelogVersion","2026-10-01T08:00","release"]
