1:00:00.000Z",24.2,"2026-11-20T00:00:00.000Z",24.9,"2026-11-19T23:00:00.000Z",25.6,"2026-11-19T22:00:00.000Z",26.4,"2026-11-19T21:00:00.000Z",27.2,"2026-11-19T20:00:00.000Z",28,"2026-11-19T19:00:00.000Z",28.8,"2026-11-19T18:00:00.000Z",19.5,{"_285":337,"_13":338,"_29":339,"_289":340,"_291":341,"_292":296},{"_285":333,"_13":32,"_29":334,"_289":335,"_291":24,"_292":296},{"_285":327,"_13":328,"_29":329,"_289":330,"_291":331,"_292":296},{"_285":321,"_13":322,"_29":323,"_289":324,"_291":325,"_292":296},{"_285":315,"_13":316,"_29":317,"_289":318,"_291":319,"_292":293},{"_285":309,"_13":310,"_29":311,"_289":312,"_291":313,"_292":293},{"_285":303,"_13":304,"_29":305,"_289":306,"_291":307,"_292":293},{"_285":297,"_13":298,"_29":299,"_289":300,"_291":301,"_292":293},{"_285":286,"_13":287,"_29":288,"_289":290,"_291":22,"_292":293},"id","h3xl056qiyuu6k5htjyc23p49","PHP phpAfterShell 漏洞 CVE-2026-126714 分析，CVSS 4.0 评分 9.2","PHP 修复了会话文件存储漏洞 CVE-2026-126714，CVSS 4.0 评分为 9.2 分：攻击者可通过截断会话写入并借助应用中的 gadget chain 触发服务器代码执行。","source",{"_57":294,"_295":296},"publishedAt","selected",true,"The Hacker News","firstParty",false,"zskyo0v1efsw8awv3dpq9z9qp","PHP 反序列化远程代码执行漏洞 CVE-2026-126714 已发布补丁","PHP files 会话保存处理器存在反序列化远程代码执行漏洞 CVE-2026-126714，CVSS 4.0 分数为 9.2。攻击者需影响目标会话内容、在写入时制造中断，并找到应用中的反序列化 gadget chain；Redis、数据库等非文件后端不受影响。",{"_57":302,"_295":293},"2026-11-19T17:25:00.000Z","奇安信 CERT","ncblinqq3ax3kc86kumn3c9vz","PHP 反序列化远程代码执行漏洞 CVE-2026-126714 影响 8.2 至 8.5 分支","PHP 反序列化远程代码执行漏洞 CVE-2026-126714 影响使用默认 files 会话保存处理器的应用，攻击者需能影响会话内容、在写入时造成中断，且目标应用存在可用 gadget chain。",{"_57":308,"_295":296},"2026-11-19T18:16:36.513Z","安全内参","ove2pi7map5xlnn8tjm9w03ev","PHP 远程代码执行漏洞 CVE-2026-126714 已公开并发布修复","PHP 远程代码执行漏洞 CVE-2026-126714（phpAfterShell）已被公开，CVSS 评分为 9.2。",{"_57":314,"_295":293},"2026-11-20T03:35:00.000Z","绿盟科技CERT","xc4re3fqbv7j3asqraazbq4h2","PHP phpAfterShell 远程代码执行漏洞 CVE-2026-126714 已修复，Cloudflare WAF 已更新检测","Cloudflare 介绍 PHP 默认文件会话处理器漏洞 phpAfterShell（CVE-2026-126714），该漏洞 CVSS v4.0 为 9.2 分，可因会话文件写入中断并在后续反序列化时导致远程代码执行。",{"_57":320,"_295":296},"2026-11-20T20:00:45.000Z","Cloudflare Blog","lx5ko0d8xap8ir26pz3ghur5r","CERT-FR 汇总第47周显著漏洞，VMware vCenter Server CVE-2026-123890 已被利用","CERT-FR 汇总第47周共27项显著漏洞，涵盖 VMware、Oracle、Splunk、Chrome、PHP、Typo3 等产品。VMware vCenter Server 安全策略绕过漏洞 CVE-2026-123890 的 CVSS 为9.8，已确认被利用；Oracle Weblogic CVE-2026-91569 的 CVSS 为10，可导致远程代码执行。",{"_57":326,"_295":296},"2026-11-23T00:00:00.000Z","CERT-FR","a73yxvg7vo995cl6zlbzf41l5","Cisco 披露 PHP RCE 漏洞 CVE-2026-126714 的产品影响与修复计划","Cisco 披露 PHP 严重漏洞 CVE-2026-126714，该漏洞可能导致远程代码执行，PHP Foundation 已于 2026 年 11 月 19 日发布安全修复。",{"_57":332,"_295":293},"2026-11-23T12:20:00.000Z","Cisco PSIRT","qnk53mzelvi4spwwrspcmie49","PHP 修复了 phpAfterShell 漏洞 CVE-2026-126714，CVSS v3.1 9.2，可导致远程代码执行（RCE）。攻击者需能控制写入会话文件的数据并中断写入，再由后续请求读取损坏的会话文件触发对象反序列化；利用还依赖默认会话存储、可利用路径、反序列化至代码执行链等条件。",{"_57":336,"_295":296},"SecurityWeek","nc7i39igsva9it4kkony4fjeq","The Hacker News 周报汇总：VMware vCenter 漏洞 CVE-2026-123890（CVSS 9.8）、Java4Shell、NGINX2Root、Ruby2Shell 等多条安全事件","The Hacker News 本周汇总了多条安全事件：疑似中国背景间谍组织 Armory Castle（原 UNC5221）被指在 2026 年 9 月初利用 VMware vCenter Server 认证绕过漏洞 CVE-2026-123890（CVSS 9.8）实施攻击。",{"_57":294,"_295":296},"2026-11-23T15:10:48.000Z",{"_285":327,"_13":328,"_29":329,"_289":347,"_291":331,"_292":296},{"_285":309,"_13":310,"_29":311,"_289":346,"_291":313,"_292":293},{"_285":297,"_13":298,"_29":299,"_289":345,"_291":301,"_292":293},{"_57":302,"_295":293},{"_57":314,"_295":293},{"_57":332,"_295":293},{"_352":366,"_13":367,"_21":331,"_17":162,"_355":368},{"_352":362,"_13":363,"_21":313,"_17":141,"_355":364},{"_352":358,"_13":359,"_21":301,"_17":141,"_355":360},{"_352":353,"_13":354,"_21":22,"_17":162,"_355":356},"factId","f93gVS9zdXdA","解析PHP会话文件漏洞利用链","representative",{"_285":286,"_13":287,"_29":288,"_289":357,"_291":22,"_292":293},{"_57":294,"_295":296},"fnkzntYGrC9c","奇安信CERT披露PHP反序列化RCE漏洞",{"_285":297,"_13":298,"_29":299,"_289":361,"_291":301,"_292":293},{"_57":302,"_295":293},"f20Jvufp9R0A","PHP修复远程代码执行漏洞",{"_285":309,"_13":310,"_29":311,"_289":365,"_291":313,"_292":293},{"_57":314,"_295":293},"fu9srF_fwZbk","PHP严重漏洞影响部分Cisco产品",{"_285":327,"_13":328,"_29":329,"_289":369,"_291":331,"_292":296},{"_57":332,"_295":293},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",10,{"_378":379,"_380":-5},"changelogVersion","2026-10-01T08:00","release"]
