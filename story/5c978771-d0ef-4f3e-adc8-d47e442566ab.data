[{"_1":2,"_3":4},"root",{"_5":377},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":-5,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48},"expiresAt",1795480850000,"publicId","5c978771-d0ef-4f3e-adc8-d47e442566ab","title","PHP修复phpAfterShell反序列化漏洞","status","active","reportCount",9,"sourceCount",8,"firstReportAt","2026-11-19T16:59:56.000Z","latestAt","2026-11-23T13:58:07.000Z","digest","PHP Foundation已发布修复CVE-2026-126714（phpAfterShell）的安全版本。该files会话保存处理器反序列化远程代码执行漏洞CVSS v3.1评分为9.2，修复版本为8.6.0、8.5.13、8.4.28、8.3.37和8.2.36；目前未见实际利用报告，已停止维护的PHP 5、7、8.0和8.1也受影响。\n\n未经身份验证的攻击者需能影响会话内容、使文件替换写入中断，并由后续请求读取损坏的会话文件；代码执行还依赖应用存在可用的反序列化gadget chain，否则可能仅破坏会话状态。漏洞仅影响files会话保存处理器，Redis、数据库等非文件后端不受影响。\n\nLinux发行版及内嵌PHP的第三方产品用户应安装对应厂商修复版本，并在升级后重启PHP-FPM、Apache等PHP服务进程。","digestUpdatedAt","2026-11-23T22:44:57.846Z","summary","excerpt","latest","PHP 修复 phpAfterShell 漏洞 CVE-2026-126714，可导致 RCE","latestReport",{"_285":333},"whyHot",{"_370":141,"_371":372,"_373":141,"_374":293,"_375":376},"developments",[348,349,350,351],"officialReports",[342,343,344],"timeline",[276,277,278,279,280,281,282,283,284],"heat",[69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130,131,132,133,134,135,136],"related",[],"topics",[49,50,51,52,53,54],{"_55":67,"_57":68},{"_55":65,"_57":66},{"_55":63,"_57":64},{"_55":61,"_57":62},{"_55":59,"_57":60},{"_55":56,"_57":58},"slug","exploited","name","在野利用","vuln-mgmt","漏洞管理","red-team","红队与渗透","cisco","Cisco / 思科","research","技术研究","vuln","漏洞披露",{"_137":274,"_43":275,"_140":141},{"_137":272,"_43":273,"_140":173},{"_137":270,"_43":271,"_140":173},{"_137":268,"_43":269,"_140":173},{"_137":266,"_43":267,"_140":173},{"_137":264,"_43":265,"_140":173},{"_137":262,"_43":263,"_140":17