[{"_1":2,"_3":4},"root",{"_5":137},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794444103000,"publicId","11e41670-5fab-4a1b-8387-0504c38b78c3","title","AntiFox被用于入侵AWS及IIS环境","status","active","reportCount",3,"sourceCount","firstReportAt","2026-11-11T15:12:59.000Z","latestAt","2026-11-11T21:31:32.000Z","digest","Arctic Wolf 观察到攻击者在阿里云托管自建的 AntiFox 智能体渗透测试平台，利用有效的 AWS IAM 用户及部分已承担的 EC2 角色，对互联网暴露的 IIS 应用和 AWS 环境发起已认证请求；部分入口来自未知漏洞形成的公开应用，另有有效 AWS 凭据的来源不明。多数请求被拒绝，但少数成功，并已确认取得生产环境秘密；另一起事件中，有效 AWS 身份还被用于读取、复制和删除 S3 对象。\n\nAntiFox 发布者禁止将其用于生产系统、实战渗透或破坏性活动，但未称有技术措施强制执行这些限制。","digestUpdatedAt","2026-11-11T22:20:47.935Z","summary","excerpt","latest","攻击者利用 AntiFox 渗透测试平台窃取 AWS 凭据并入侵 IIS","latestReport",{"_102":120},"whyHot",{"_131":81,"_132":88,"_133":81,"_134":110,"_135":136},"developments",[124],"officialReports",[],"timeline",[99,100,101],"heat",[68,69,70,71,72,73,74,75,76],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","black-market","name","数据窃取与黑产","ransomware","勒索软件","cloud-native","云与原生","attack","攻击活动","ai-offense","AI 攻防","identity","身份与访问",{"_77":97,"_42":98,"_80":88},{"_77":95,"_42":96,"_80":88},{"_77":93,"_42":94,"_80":88},{"_77":91,"_42":92,"_80":88},{"_77":89,"_42":90,"_80":88},{"_77":86,"_42":87,"_80":88},{"_77":84,"_42":85,"_80":81},{"_77":82,"_42":83,"_80":81},{"_77":78,"_42":79,"_80":81},"hour","2026-11-12T00:00:00.000Z",17.1,"participants",2,"2026-11-11T23:00:00.000Z",17.6,"2026-11-11T22:00:00.000Z",18.1,"2026-11-11T21:00:00.000Z",8.5,1,"2026-11-11T20:00:00.000Z",8.7,"2026-11-11T19:00:00.000Z",9,"2026-11-11T18:00:00.000Z",9.2,"2026-11-11T17:00:00.000Z",9.5,"2026-11-11T16:00:00.000Z",9.8,{"_102":120,"_13":31,"_28":121,"_106":122,"_108":23,"_109":113},{"_102":114,"_13":115,"_28":116,"_106":117,"_108":118,"_109":113},{"_102":103,"_13":104,"_28":105,"_106":107,"_108":21,"_109":110},"id","w59rywovcc1gwb1eoreru2xl3","攻击者利用 AntiFox AI Agent 窃取 AWS 凭据并入侵 Web 服务","攻击者在 Alibaba Cloud 上托管自建 AntiFox 实例，利用有效 IAM 用户和 EC2 角色针对 AWS 环境及互联网暴露的 Web 服务实施漏洞利用、Webshell 部署、凭据验证、配置发现与 AWS secret 收集。","source",{"_56":111,"_112":113},"publishedAt","selected",true,"BleepingComputer","firstParty",false,"hroimysyinga8xqp7hdu3x6ng","AntiFox 被用于入侵 IIS 并窃取 AWS 生产环境密钥","Arctic Wolf Labs 披露，AntiFox AI 渗透测试平台已被用于攻击面向互联网的 IIS 应用，并通过 ASPX Web shell 和 `w3wp.exe` 执行命令、发现配置与凭据、横向访问 AWS 生产环境。",{"_56":119,"_112":113},"2026-11-11T15:34:27.000Z","The Hacker News","rmli28nd0m52mcujggf8r4uaf","Arctic Wolf 观察到攻击者利用开源、中文界面的智能体渗透测试平台 AntiFox 入侵面向互联网的 IIS 应用及关联 AWS 环境；部分入口是未知漏洞形成的公开应用，另一个入口是来源不明的有效 AWS 凭据。",{"_56":123,"_112":113},"Security Affairs",{"_125":126,"_13":127,"_20":21,"_17":81,"_128":129},"factId","fTcU_gkFotDA","攻击者利用 AntiFox 窃取 AWS 凭据","representative",{"_102":103,"_13":104,"_28":105,"_106":130,"_108":21,"_109":110},{"_56":111,"_112":113},"participants48h","newParticipants6h","recentReports24h","observationComplete","rank",7,{"_138":139,"_140":-5},"changelogVersion","2026-10-01T08:00","release"]
