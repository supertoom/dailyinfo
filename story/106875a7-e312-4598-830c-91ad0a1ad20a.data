[{"_1":2,"_3":4},"root",{"_5":183},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794444103000,"publicId","106875a7-e312-4598-830c-91ad0a1ad20a","title","Microsoft披露AI Agent神经元后门Lazarus","status","active","reportCount",3,"sourceCount","firstReportAt","2026-11-10T23:00:00.000Z","latestAt","2026-11-11T10:55:54.000Z","digest","Microsoft Research披露AI Agent隐藏后门Lazarus：研究人员无需重新训练，只需修改模型中少于10个很少激活的神经元并注入短Payload，模型即可通过常规安全评测，并在上下文出现指定触发字符串时执行攻击者命令。研究在三个开放权重模型上进行了测试；攻击前提是攻击者能修改模型权重或部署前的检查点，所需计算资源仅为推理。\n\n目前该技术仅属研究演示，Microsoft称尚未发现任何威胁组织将其武器化，也未确认现实受害或影响范围。可靠检测通常需要与原始未修改权重对比；Microsoft Research称，前沿Agent能够识别异常权重编辑。","digestUpdatedAt","2026-11-11T21:19:44.446Z","summary","excerpt","latest","Microsoft 研究人员演示 AI Agent 隐藏后门技术 Lazarus","latestReport",{"_147":165},"whyHot",{"_176":18,"_177":178,"_179":124,"_180":163,"_181":182},"developments",[169],"officialReports",[],"timeline",[144,145,146],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","blue-team","name","蓝队与运营","supply-chain","供应链安全","ai-security","AI 安全","research","技术研究","malware","恶意软件","microsoft","Microsoft / 微软",{"_92":142,"_42":143,"_95":131},{"_92":140,"_42":141,"_95":131},{"_92":138,"_42":139,"_95":131},{"_92":136,"_42":137,"_95":131},{"_92":134,"_42":135,"_95":131},{"_92":132,"_42":133,"_95":131},{"_92":129,"_42":130,"_95":131},{"_92":127,"_42":128,"_95":124},{"_92":125,"_42":126,"_95":124},{"_92":122,"_42":123,"_95":124},{"_92":120,"_42":121,"_95":18},{"_92":118,"_42":119,"_95":18},{"_92":116,"_42":117,"_95":18},{"_92":114,"_42":115,"_95":18},{"_92":112,"_42":113,"_95":18},{"_92":110,"_42":111,"_95":18},{"_92":108,"_4