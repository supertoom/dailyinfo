[{"_1":2,"_3":4},"root",{"_5":357},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794271241000,"publicId","8742e04a-54d0-438b-87c9-362c20fb138e","title","cPGuard更新通道被劫持，服务器数据遭窃","status","active","reportCount",5,"sourceCount","firstReportAt","2026-11-03T15:16:32.000Z","latestAt","2026-11-09T06:58:22.000Z","digest","OPSSHIELD确认，未识别攻击者使用泄露凭据进入cPGuard更新分发网络，向5.88.12至5.88.19版本的客户Linux服务器推送恶意脚本。脚本以root权限运行，收集并外传密码哈希、数据库配置、root shell历史、SSH授权文件等32个文件，并植入隐藏的root shell；此次攻击未利用软件漏洞，攻击者身份仍未确认。\n\nOPSSHIELD称已检测到2946台服务器受影响并发生数据复制，其计费系统数据库也被复制；另有报道估计恶意更新在约70多分钟内被约2950台服务器安装。由于客户端按固定间隔检查更新，并非所有服务器都会收到脚本，具体未受影响范围无法确认。厂商称在发现异常后切断了投递，调查仍在进行。\n\nOPSSHIELD建议将所有cPGuard服务器升级至5.88.25或更高版本，并重置密码、轮换数据库凭据、云端密钥和SSH密钥；已复制的凭据不会因升级自动失效。","digestUpdatedAt","2026-11-09T07:22:53.353Z","summary","excerpt","latest","OPSSHIELD cPGuard 更新通道遭投毒，5.88.12 至 5.88.19 受影响","latestReport",{"_310":340},"whyHot",{"_350":150,"_351":352,"_353":187,"_354":318,"_355":356},"developments",[343],"officialReports",[],"timeline",[305,306,307,308,309],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130,131,132,133,134,135,136,137,138,139,140,141,142,143,144,145],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","ransomware","name","勒索软件","incident","应急响应","identity","身份与访问","supply-chain","供应链安全","malware","恶意软件","attack","攻击活动",{"_146":303,"_42":304,"_149":187},{"_146":301,"_42":302,"_149":187},{"_146":299,"_42":300,"_149":187},{"_146":297,"_42":298,"_149":187},{"_146":295,"_42":296,"_149":187},{"_146":293,"_42":294,"_149":187},{"