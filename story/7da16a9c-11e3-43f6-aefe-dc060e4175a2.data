[{"_1":2,"_3":4},"root",{"_5":292},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795308047000,"publicId","7da16a9c-11e3-43f6-aefe-dc060e4175a2","title","N-able托管云遭入侵，三区域服务中断","status","watching","reportCount",3,"sourceCount","firstReportAt","2026-11-19T09:31:26.000Z","latestAt","2026-11-20T13:18:36.000Z","digest","N-able确认，未知攻击者未经授权访问Mail Assure和SpamExperts Hosted Cloud的一台服务器，自11月16日起造成Americas、APAC和Europe三个区域的管理界面、API、隔离区、日志及邮箱同步服务中断，核心邮件流和入站、出站过滤仍可用；安全恢复仍在进行，尚无补丁发布信息。\n\nN-able称事件限于单台服务器，未经授权方可能接触了平台存储的部分凭据，但目前没有证据显示客户数据遭破坏或租户邮箱被访问。公司已下线受影响服务器，轮换内部凭据、撤销客户API令牌、失效OAuth令牌并重置本地用户密码。N-able表示，该事件与N-central为修补30多个零日漏洞而暂停托管环境无关。","digestUpdatedAt","2026-11-20T14:06:30.985Z","summary","excerpt","latest","N-able 确认服务器遭未授权访问，Mail Assure 与 SpamExperts Hosted Cloud 全球服务中断","latestReport",{"_257":274},"whyHot",{"_285":134,"_286":287,"_288":287,"_289":290,"_291":235},"developments",[278],"officialReports",[],"timeline",[254,255,256],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","black-market","name","数据窃取与黑产","ransomware","勒索软件","email","邮件与钓鱼","identity","身份与访问","cloud-native","云与原生","attack","攻击活动",{"_130":252,"_42":253,"_133":213},{"_130":250,"_42":251,"_133":213},{"_130":249,"_42":152,"_133":213},{"_130":247,"_42":248,"_133":213},{"_130":246,"_42":148,"_133":213},{"_130":244,"_42":245,"_133":213},{"_130":242,"_42":243,"_133":213},{"_130":241,"_42":142,"_133":213},{"_130":240,"_42":140,"_133":213},{"_130":238,"_42":239,"_133":213},{