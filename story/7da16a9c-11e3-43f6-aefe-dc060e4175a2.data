[{"_1":2,"_3":4},"root",{"_5":372},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":-5,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48},"expiresAt",1795480850000,"publicId","7da16a9c-11e3-43f6-aefe-dc060e4175a2","title","N-able修复托管云SSRF漏洞","status","active","reportCount",5,"sourceCount",3,"firstReportAt","2026-11-19T09:31:26.000Z","latestAt","2026-11-23T15:06:49.000Z","digest","N-able已修复Mail Assure与SpamExperts Hosted Cloud的服务端请求伪造漏洞CVE-2026-134624（CVSS 4.0评分9.3）。20261121.1943之前构建受影响，修复版本为20261121.1943；具备高权限API访问权限的用户可迫使服务器连接任意内部主机和端口、探测可达性并向内部服务发送构造数据，报道未说明需额外配置或重启。\n\n该漏洞是在调查未知攻击者入侵一台托管云服务器时发现的，N-able尚未确认其是否为攻击入口。N-able称，修复后未发现该服务器之外遭利用的迹象，也没有证据显示客户数据或租户邮箱被访问；此前中断的核心邮件流及入站、出站过滤仍可用，管理界面、API、隔离区、日志和邮箱同步服务仍处停用状态。","digestUpdatedAt","2026-11-23T15:20:05.288Z","summary","excerpt","latest","N-able 修复 Mail Assure 与 SpamExperts SSRF 漏洞 CVE-2026-134624","latestReport",{"_322":351},"whyHot",{"_366":159,"_367":368,"_369":159,"_370":350,"_371":226},"developments",[354,355],"officialReports",[],"timeline",[317,318,319,320,321],"heat",[69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130,131,132,133,134,135,136,137,138,139,140,141,142,143,144,145,146,147,148,149,150,151,152,153,154],"related",[],"topics",[49,50,51,52,53,54],{"_55":67,"_57":68},{"_55":65,"_57":66},{"_55":63,"_57":64},{"_55":61,"_57":62},{"_55":59,"_57":60},{"_55":56,"_57":58},"slug","vuln","name","漏洞披露","email","邮件与钓鱼","identity","身份与访问","attack","攻击活动","exploited","在野利用","cloud-native","云与原生",{"_155":316,"_43":180,"_158":178},{"_155":315,"_43":177,"_158":178},{"_155":314,"_43":226,"_158":178},{"_155":312,"_43":313,"_158":178},{"_155":311,"_43":222,"_158":178},{"_155":309,"_43":310,"_158":178},{"_155":307,"_43":308,"_