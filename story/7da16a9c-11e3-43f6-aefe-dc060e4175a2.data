[{"_1":2,"_3":4},"root",{"_5":224},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795221647000,"publicId","7da16a9c-11e3-43f6-aefe-dc060e4175a2","title","N-able托管云遭入侵，三区域服务中断","status","active","reportCount",3,"sourceCount","firstReportAt","2026-11-19T09:31:26.000Z","latestAt","2026-11-20T13:18:36.000Z","digest","N-able确认，未知攻击者未经授权访问Mail Assure和SpamExperts Hosted Cloud的一台服务器，自11月16日起造成Americas、APAC和Europe三个区域的管理界面、API、隔离区、日志及邮箱同步服务中断，核心邮件流和入站、出站过滤仍可用；安全恢复仍在进行，尚无补丁发布信息。\n\nN-able称事件限于单台服务器，未经授权方可能接触了平台存储的部分凭据，但目前没有证据显示客户数据遭破坏或租户邮箱被访问。公司已下线受影响服务器，轮换内部凭据、撤销客户API令牌、失效OAuth令牌并重置本地用户密码。N-able表示，该事件与N-central为修补30多个零日漏洞而暂停托管环境无关。","digestUpdatedAt","2026-11-20T14:06:30.985Z","summary","excerpt","latest","N-able 确认服务器遭未授权访问，Mail Assure 与 SpamExperts Hosted Cloud 全球服务中断","latestReport",{"_189":206},"whyHot",{"_217":18,"_218":219,"_220":132,"_221":222,"_223":163},"developments",[210],"officialReports",[],"timeline",[186,187,188],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","black-market","name","数据窃取与黑产","ransomware","勒索软件","email","邮件与钓鱼","identity","身份与访问","cloud-native","云与原生","attack","攻击活动",{"_106":184,"_42":185,"_109":141},{"_106":182,"_42":183,"_109":141},{"_106":180,"_42":181,"_109":141},{"_106":178,"_42":179,"_109":141},{"_106":176,"_42":177,"_109":141},{"_106":174,"_42":175,"_109":141},{"_106":172,"_42":173,"_109":141},{"_106":170,"_42":171,"_109":141},{"_106":168,"_42":169,"_109":141},{"_106":166,"_42":167,"_109":141},{"_106":164,"_42":165,"_109":141},{"_106":162,"_42":163,"_109":141},{"_106":160,"_42":161,"_109":141