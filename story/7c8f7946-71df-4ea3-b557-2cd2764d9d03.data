[{"_1":2,"_3":4},"root",{"_5":179},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794876039000,"publicId","7c8f7946-71df-4ea3-b557-2cd2764d9d03","title","Project Zero分阶段收紧漏洞披露期","status","active","reportCount",5,"sourceCount","firstReportAt","2026-11-16T06:30:02.000Z","latestAt","2026-11-16T22:08:20.000Z","digest","Google Project Zero将用“Full X”政策取代“90+30”机制：漏洞报告给厂商后，默认在90天公开技术细节，期限届满仍未修复也会公开；该期限于2027年2月2日降至60天，2028年1月3日降至30天。Project Zero仍跟踪修复状态，但修复与否不再决定公开时间，原30天“soak time”、宽限期和变体政策被取消。\n\n提前披露情形包括漏洞已在野外主动利用、相关利用或漏洞细节已由他人公开，以及厂商主动要求公开；SecurityWeek称，在野主动利用的漏洞适用7天披露窗口。硬件漏洞和严重漏洞仍可能获得例外，厂商请求后也可能提前公开。","digestUpdatedAt","2026-11-16T23:32:16.162Z","summary","excerpt","latest","Google Project Zero 将厂商公开漏洞披露期限从 120 天缩短至 30 天，分歧引发专家争论","latestReport",{"_133":162},"whyHot",{"_173":18,"_174":110,"_175":18,"_176":177,"_178":117},"developments",[166],"officialReports",[],"timeline",[128,129,130,131,132],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","ai-agent","name","AI Agent 安全","ai-security","AI 安全","vuln","漏洞披露","policy","政策法规","vuln-mgmt","漏洞管理","google","Google / 谷歌",{"_86":126,"_42":127,"_89":117},{"_86":124,"_42":125,"_89":117},{"_86":122,"_42":123,"_89":117},{"_86":120,"_42":121,"_89":117},{"_86":118,"_42":119,"_89":117},{"_86":115,"_42":116,"_89":117},{"_86":113,"_42":114,"_89":110},{"_86":111,"_42":112,"_89":110},{"_86":108,"_42":109,"_89":110},{"_86":106,"_42":107,"_89":97},{"_86":104,"_42":105,"_89":97},{"_86":102,"_42":103,"_89":97},{"_86":100,"_42":101,"_89":97},{"_86":98,"_42":99,"_89":97},{"_86":95,"_42":96,"_89":97},{"_86":92,"_42":93,"_89":94},{"_86":90,"_42":91,"_89":18},{"_86":87,"_42":88,"_89":18},"hour","2026-11-17T00:00:00.000Z",39.8,"participants","2026-11-16T23:00:00.000Z",40.9,"2026-11-16T22:00:00.000Z",32.1,4,"2026-11-16T21:00:00.000Z",22.9,3,"2026-11-16T20:00:00.000Z",23.6,"2026-11-16T19:00:00.000Z",24.2,"2026-11-16T18:00:00.000Z",25,"2026-11-16T17:00:00.000Z",25.7,"2026-11-16T16:00:00.000Z",26.4,"2026-11-16T15:00:00.000Z",17.1,2,"2026-11-16T14:00:00.000Z",17.6,"2026-11-16T13:00:00.000Z",18.1,"2026-11-16T12:00:00.000Z",8.5,1,"2026-11-16T11:00:00.000Z",8.8,"2026-11-16T10:00:00.000Z",9,"2026-11-16T09:00:00.000Z",9.3,"2026-11-16T08:00:00.000Z",9.6,"2026-11-16T07:00:00.000Z",9.9,{"_133":162,"_13":31,"_28":163,"_137":164,"_139":23,"_140":141},{"_133":156,"_13":157,"_28":158,"_137":159,"_139":160,"_140":141},{"_133":150,"_13":151,"_28":152,"_137":153,"_139":154,"_140":141},{"_133":144,"_13":145,"_28":146,"_137":147,"_139":148,"_140":141},{"_133":134,"_13":135,"_28":136,"_137":138,"_139":21,"_140":141},"id","vhlxb3lwmsoi2duh7fx1b7k09","Google Project Zero 将按 Full X 政策披露漏洞，最短期限为 30 天","Google Project Zero 将于报告漏洞后 90 天披露技术细节，无论厂商是否已发布修复，并从 2027 年 2 月 2 日起缩短至 60 天、2028 年 1 月 3 日起缩短至 30 天。","source",{"_56":142,"_143":141},"publishedAt","selected",false,"Help Net Security","firstParty","ro75awrk7bui71pwc9gnu07w6","Google Project Zero 将漏洞披露期限在 2028 年缩短至 30 天","Google Project Zero 将以 Full X 政策取代“90 + 30”机制，于 2027 年 2 月 2 日进入 Full 60、2028 年 1 月 3 日进入 Full 30，并在不等待补丁的情况下披露漏洞细节。",{"_56":149,"_143":141},"2026-11-16T12:15:00.000Z","Infosecurity Magazine","fydtq9ty90k14sxo3lshkr1gh","Google Project Zero 公布 30 天至 90 天分阶段漏洞披露新规","Google Project Zero 将缩短漏洞公开披露窗口，自 November 13 起不再设置 30 天补丁发布宽限期，向厂商报告后满 90 天即公开细节；自 February 2, 2027 降至 60 天，January 3, 2028 进一步降至 30 天。新规取消多数例外，已在野利用的漏洞适用 7 天披露窗口，严重漏洞仍可能获例外，厂商提出请求后也可提前公开。",{"_56":155,"_143":141},"2026-11-16T15:31:25.000Z","SecurityWeek","otpledvndd8jicfy7yj23mlh1","Google Project Zero 分阶段将漏洞披露期限缩短至30天","Google Project Zero 将以固定期限取代“90+30”政策：November 13 移除30天延期，February 2, 2027 缩至60天，January 3, 2028 缩至30天；期限届满后，即使尚无修复也会公开漏洞细节。调整源于 AI 加速漏洞发现、利用及补丁逆向，厂商可从在野利用、已有公开利用信息或厂商请求等情形提前披露，部分漏洞仍可不披露。",{"_56":161,"_143":141},"2026-11-16T21:31:44.000Z","BleepingComputer","i58dz2swj5kvna993qrc6g62i","Google Project Zero 宣布在未来 14 个月内，将向厂商公开披露漏洞的期限由 120 天缩短至 30 天。该调整将改变漏洞披露节奏，并在安全专家之间引发分歧。",{"_56":165,"_143":141},"Dark Reading",{"_167":168,"_13":169,"_20":21,"_17":18,"_170":171},"factId","fs7WljsVyNCM","Project Zero调整漏洞披露期限","representative",{"_133":134,"_13":135,"_28":136,"_137":172,"_139":21,"_140":141},{"_56":142,"_143":141},"participants48h","newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_180":181,"_182":-5},"changelogVersion","2026-10-01T08:00","release"]
