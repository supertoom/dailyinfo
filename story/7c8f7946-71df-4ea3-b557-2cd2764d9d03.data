[{"_1":2,"_3":4},"root",{"_5":251},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794962454000,"publicId","7c8f7946-71df-4ea3-b557-2cd2764d9d03","title","Project Zero分阶段收紧漏洞披露期","status","watching","reportCount",5,"sourceCount","firstReportAt","2026-11-16T06:30:02.000Z","latestAt","2026-11-16T22:08:20.000Z","digest","Google Project Zero将用“Full X”政策取代“90+30”机制：漏洞报告给厂商后，默认在90天公开技术细节，期限届满仍未修复也会公开；该期限于2027年2月2日降至60天，2028年1月3日降至30天。Project Zero仍跟踪修复状态，但修复与否不再决定公开时间，原30天“soak time”、宽限期和变体政策被取消。\n\n提前披露情形包括漏洞已在野外主动利用、相关利用或漏洞细节已由他人公开，以及厂商主动要求公开；SecurityWeek称，在野主动利用的漏洞适用7天披露窗口。硬件漏洞和严重漏洞仍可能获得例外，厂商请求后也可能提前公开。","digestUpdatedAt","2026-11-16T23:32:16.162Z","summary","excerpt","latest","Google Project Zero 将厂商公开漏洞披露期限从 120 天缩短至 30 天，分歧引发专家争论","latestReport",{"_204":233},"whyHot",{"_244":18,"_245":246,"_247":246,"_248":249,"_250":18},"developments",[237],"officialReports",[],"timeline",[199,200,201,202,203],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","ai-agent","name","AI Agent 安全","ai-security","AI 安全","vuln","漏洞披露","policy","政策法规","vuln-mgmt","漏洞管理","google","Google / 谷歌",{"_110":197,"_42":198,"_113":188},{"_110":195,"_42":196,"_113":188},{"_110":193,"_42":194,"_113":188},{"_110":191,"_42":192,"_113":188},{"_110":189,"_42":190,"_113":188},{"_110":186,"_42":187,"_113":188},{"_110":184,"_42":185,"_113":181},{"_110":182,"_42":183,"_113":181},{"_110":179,"_42":180,"_113":181},{"_110":177,"_42":178,"_113":169},{"_110":175,"_42":176,"_113":169},{"_110":173,"_42":174,"_113":169},{"_110":171,"_42":172,"_113":169},{"_110":