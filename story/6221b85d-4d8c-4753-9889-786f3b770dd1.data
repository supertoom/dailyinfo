[{"_1":2,"_3":4},"root",{"_5":144},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795740055000,"publicId","6221b85d-4d8c-4753-9889-786f3b770dd1","title","SYS010借Meta广告窃取账户与邮箱数据","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-26T11:50:17.000Z","latestAt","2026-11-26T17:09:09.000Z","digest","Bitdefender披露，攻击者通过Meta广告冒充Wallpaper Engine、Live Wallpapers等免费动态壁纸，以ZIP文件分发Windows木马SYS010，为Chrome、Edge和Firefox配置恶意扩展，窃取Facebook与Meta商业账户及Gmail、Outlook数据；活动仍在持续，尚未确认感染规模或已有补丁。\n\n木马要求管理员权限，会每三秒重复触发UAC提示，最多99次；获批后可盗取会话Cookie，使攻击者无需密码或双因素认证即可访问已登录账户。载荷会先连接攻击者控制的C2服务器再开始窃取。Bitdefender遥测记录到来自多个洲的感染设备请求，但这不等于确认感染数量，广告触达量也不能代表下载或感染规模。","digestUpdatedAt","2026-11-26T17:46:48.334Z","summary","excerpt","latest","Facebook 假壁纸广告传播 SYS010 恶意软件窃取 Meta 业务账户与邮箱数据","latestReport",{"_109":121},"whyHot",{"_137":18,"_138":139,"_140":18,"_141":117,"_142":143},"developments",[125,126],"officialReports",[],"timeline",[107,108],"heat",[68,69,70,71,72,73,74,75,76,77,78,79],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","microsoft","name","Microsoft / 微软","malware","恶意软件","attack","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","browser","浏览器",{"_80":105,"_42":106,"_83":98},{"_80":103,"_42":104,"_83":98},{"_80":101,"_42":102,"_83":98},{"_80":99,"_42":100,"_83":98},{"_80":96,"_42":97,"_83":98},{"_80":94,"_42":95,"_83":18},{"_80":92,"_42":93,"_83":18},{"_80":90,"_42":91,"_83":18},{"_80":88,"_42":89,"_83":18},{"_80":86,"_42":87,"_83":18},{"_80":84,"_42":85,"_83":18},{"_80":81,"_42":82,"_83":18},"hour","2026-11-27T00:00:00.000Z",15.2,"participants","2026-11-26T23:00:00.000Z",15.7,"2026-11-26T22:00:00.000Z",16.2,"2026-11-26T21:00:00.000Z",16.6,"2026-11-26T20:00