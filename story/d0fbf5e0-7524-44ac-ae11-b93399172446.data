[{"_1":2,"_3":4},"root",{"_5":353},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":-5,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48},"expiresAt",1794876039000,"publicId","d0fbf5e0-7524-44ac-ae11-b93399172446","title","微软365中断由软件缺陷引发，钓鱼已确认","status","active","reportCount",6,"sourceCount",4,"firstReportAt","2026-11-12T20:41:47.000Z","latestAt","2026-11-16T16:43:24.000Z","digest","微软最终查明，11月12日Microsoft 365全球中断源于7月引入的软件缺陷，而非网络攻击或AI/Agent；缺陷在特定流量下使服务器失去响应，Teams自动切换网络基础设施后触发级联故障，超过80%的网络网关服务器无响应，另有近14%容量因无关问题离线。微软已开发并向受影响服务器部署修复，Exchange Online事件EX1550543于11月13日解决。\n\n微软威胁情报部门确认，攻击者已借中断实施钓鱼，谎称停机期间邮件将在24小时内删除，诱导收件人点击链接恢复邮件；其安全产品正在拦截该活动。微软建议检查可疑邮件和链接、调查用户点击情况，并审查Safe Links策略。","digestUpdatedAt","2026-11-16T17:27:35.929Z","summary","excerpt","latest","Microsoft 软件缺陷引发全球 Microsoft 365 近 24 小时服务中断","latestReport",{"_287":320},"whyHot",{"_347":145,"_348":349,"_350":145,"_351":323,"_352":20},"developments",[325,326,327,328],"officialReports",[],"timeline",[281,282,283,284,285,286],"heat",[69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130,131,132,133,134,135,136,137,138,139,140],"related",[],"topics",[49,50,51,52,53,54],{"_55":67,"_57":68},{"_55":65,"_57":66},{"_55":63,"_57":64},{"_55":61,"_57":62},{"_55":59,"_57":60},{"_55":56,"_57":58},"slug","blue-team","name","蓝队与运营","attack","攻击活动","incident","应急响应","email","邮件与钓鱼","cloud-native","云与原生","microsoft","Microsoft / 微软",{"_141":279,"_43":280,"_144":145},{"_141":277,"_43":278,"_144":145},{"_141":275,"_43":276,"_144":145},{"_141":274,"_43":159,"_144":145},{"_141":273,"_43":157,"_144":145},{"_141":272,"_43":155,"_144":145},{"_141":270,"_43":271,"_144":145},{"_141":269,"_43":151,"_144":145},{"_141":268,"_43":149,"_144":145},{"_141"