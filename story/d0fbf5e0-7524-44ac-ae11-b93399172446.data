[{"_1":2,"_3":4},"root",{"_5":104},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794530497000,"publicId","d0fbf5e0-7524-44ac-ae11-b93399172446","title","微软365多区域服务中断","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-12T20:41:47.000Z","latestAt","2026-11-12T20:55:30.000Z","digest","微软确认，Microsoft 365于周四发生多区域大范围服务中断，业务邮件及Exchange Online、Teams、SharePoint Online、Microsoft 365 Copilot和Defender XDR等云服务受影响，海外用户亦受影响；Downdetector记录逾97,000次Outlook事件、逾38,000次Microsoft 365问题和约4,500次Teams报告。\n\n微软称，大量服务器意外不可用，使剩余系统承担额外负载，但整体流量未增加。故障触发原因仍在调查，微软尚未披露网络攻击证据。Google Workspace用户也报告无法通过Outlook客户端访问邮箱，Copilot及竞争性AI服务因底层微软服务不可用而无法访问用户邮箱。","digestUpdatedAt","2026-11-12T21:42:47.663Z","summary","excerpt","latest","Microsoft 365 多区域服务中断影响 Outlook、Exchange Online 和 Teams","latestReport",{"_75":86},"whyHot",{"_97":18,"_98":18,"_99":18,"_100":101,"_102":103},"developments",[90],"officialReports",[],"timeline",[73,74],"heat",[62,63,64],"related",[],"topics",[48,49,50,51],{"_52":60,"_54":61},{"_52":58,"_54":59},{"_52":56,"_54":57},{"_52":53,"_54":55},"slug","attack","name","攻击活动","ai-agent","AI Agent 安全","cloud-native","云与原生","microsoft","Microsoft / 微软",{"_65":71,"_42":72,"_68":18},{"_65":69,"_42":70,"_68":18},{"_65":66,"_42":67,"_68":18},"hour","2026-11-13T00:00:00.000Z",18.2,"participants","2026-11-12T23:00:00.000Z",18.8,"2026-11-12T22:00:00.000Z",19.3,{"_75":86,"_13":31,"_28":87,"_79":88,"_81":23,"_82":83},{"_75":76,"_13":77,"_28":78,"_79":80,"_81":21,"_82":83},"id","h8ijgwnlhr1r0s4ikcq8iiule","Microsoft 云服务故障影响 Outlook、Teams、Copilot 及 AI 连接器","Microsoft 云服务故障在 11 月 12 日影响美国数千名用户，Downdetector 记录超过 97,000 次 Outlook 事件、超过 38,000 次 Microsoft 365 问题和约 4,500 次 Teams 报告。","source",{"_54":84,"_85":83},"publishedAt","selected",false,"Security Affairs","firstParty","qgsn0afd320w1dxmt73jiik7u","Microsoft 365 周四发生多区域大范围服务中断，影响业务邮件、Exchange Online、Teams、SharePoint Online、Microsoft 365 Copilot 和 Defender XDR，Google Workspace 用户也报告通过 Outlook 客户端访问邮箱受阻。",{"_54":89,"_85":83},"SecurityWeek",{"_91":92,"_13":93,"_20":21,"_17":18,"_94":95},"factId","fTqlpso7s9gg","微软365服务中断影响多地用户","representative",{"_75":76,"_13":77,"_28":78,"_79":96,"_81":21,"_82":83},{"_54":84,"_85":83},"participants48h","newParticipants6h","recentReports24h","observationComplete",true,"rank",8,{"_105":106,"_107":-5},"changelogVersion","2026-10-01T08:00","release"]
