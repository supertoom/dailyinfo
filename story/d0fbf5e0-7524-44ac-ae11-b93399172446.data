[{"_1":2,"_3":4},"root",{"_5":257},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":-5,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48},"expiresAt",1794703237000,"publicId","d0fbf5e0-7524-44ac-ae11-b93399172446","title","微软365多区域中断后恢复，钓鱼风险上升","status","watching","reportCount",4,"sourceCount",3,"firstReportAt","2026-11-12T20:41:47.000Z","latestAt","2026-11-13T13:47:42.000Z","digest","微软确认 Microsoft 365 于 11 月 12 日发生多区域服务中断，Exchange Online、Outlook、Teams、SharePoint Online、Copilot 和 Defender XDR 等服务受影响，海外用户亦受波及；微软称故障并非由流量增长或恶意活动引发，大量服务器意外不可用使剩余系统承压，具体触发原因仍在调查。Downdetector 记录逾97,000次 Outlook 事件、逾38,000次 Microsoft 365 问题和约4,500次 Teams 报告。\n\n截至 11 月 13 日晚，服务已出现初步稳定迹象，但容量尚未恢复至正常水平；Infosecurity Magazine 警告，网络犯罪分子可能借恢复之际冒充微软发起钓鱼或虚假 IT 支持诈骗。澳大利亚国家网络安全协调员 Michelle McGuiness 提醒公众警惕未经请求的联系，安全团队应回查中断期间的登录、邮箱规则、账户变更和终端活动。","digestUpdatedAt","2026-11-13T15:18:20.442Z","summary","excerpt","latest","Microsoft 365 全球服务中断持续数小时，Outlook、Teams 等服务受影响","latestReport",{"_205":228},"whyHot",{"_249":116,"_250":251,"_252":251,"_253":254,"_255":256},"developments",[231,232,233],"officialReports",[],"timeline",[201,202,203,204],"heat",[69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111],"related",[],"topics",[49,50,51,52,53,54],{"_55":67,"_57":68},{"_55":65,"_57":66},{"_55":63,"_57":64},{"_55":61,"_57":62},{"_55":59,"_57":60},{"_55":56,"_57":58},"slug","ai-agent","name","AI Agent 安全","email","邮件与钓鱼","blue-team","蓝队与运营","incident","应急响应","cloud-native","云与原生","microsoft","Microsoft / 微软",{"_112":199,"_43":200,"_115":116},{"_112":197,"_43":198,"_115":116},{"_112":195,"_43":196,"_115":116},{"_112":193,"_43":194,"_115":116},{"_112":191,"_43":192,"_115":116},{"_112":189,"_43":190,"_115":116},{"_112":187,"_43":188,"_115":116},{"_112":185,"_43":186,"_115":116},{"_112":183,"_43":1