0.000Z",13.3,"2026-11-13T10:00:00.000Z",13.7,"2026-11-13T09:00:00.000Z",14.1,"2026-11-13T08:00:00.000Z","2026-11-13T07:00:00.000Z","2026-11-13T06:00:00.000Z","2026-11-13T05:00:00.000Z","2026-11-13T04:00:00.000Z",16.3,"2026-11-13T03:00:00.000Z","2026-11-13T02:00:00.000Z","2026-11-13T01:00:00.000Z","2026-11-13T00:00:00.000Z",18.2,"2026-11-12T23:00:00.000Z",18.8,"2026-11-12T22:00:00.000Z",19.3,{"_287":320,"_13":32,"_29":321,"_291":322,"_293":24,"_294":323},{"_287":315,"_13":316,"_29":317,"_291":318,"_293":319,"_294":295},{"_287":310,"_13":311,"_29":312,"_291":313,"_293":314,"_294":295},{"_287":304,"_13":305,"_29":306,"_291":307,"_293":308,"_294":295},{"_287":298,"_13":299,"_29":300,"_291":301,"_293":302,"_294":295},{"_287":288,"_13":289,"_29":290,"_291":292,"_293":22,"_294":295},"id","h8ijgwnlhr1r0s4ikcq8iiule","Microsoft 云服务故障影响 Outlook、Teams、Copilot 及 AI 连接器","Microsoft 云服务故障在 11 月 12 日影响美国数千名用户，Downdetector 记录超过 97,000 次 Outlook 事件、超过 38,000 次 Microsoft 365 问题和约 4,500 次 Teams 报告。","source",{"_57":296,"_297":295},"publishedAt","selected",false,"Security Affairs","firstParty","qgsn0afd320w1dxmt73jiik7u","Microsoft 365 多区域服务中断影响 Outlook、Exchange Online 和 Teams","Microsoft 365 周四发生多区域大范围服务中断，影响业务邮件、Exchange Online、Teams、SharePoint Online、Microsoft 365 Copilot 和 Defender XDR，Google Workspace 用户也报告通过 Outlook 客户端访问邮箱受阻。",{"_57":303,"_297":295},"2026-11-12T20:55:30.000Z","SecurityWeek","p9xvywg2srpkzg5suhmzq98tl","Microsoft 365 大面积中断或被网络犯罪分子利用，钓鱼与虚假支持诈骗风险上升","Microsoft 365 与 Exchange Online 全球中断虽被认为并非网络攻击所致，但网络犯罪分子可能借用户急于恢复服务之际发起仿冒 Microsoft 的钓鱼活动及虚假 IT 支持诈骗，诱导员工点击链接、共享个人信息或授予远程访问权限。",{"_57":309,"_297":295},"2026-11-13T12:29:00.000Z","Infosecurity Magazine","kptxy8gsaljd89gpewsneprrb","Microsoft 365 全球服务中断持续数小时，Outlook、Teams 等服务受影响","Microsoft 365 全球服务中断持续数小时，影响 Outlook、Teams、Copilot 及 Exchange Online、邮件服务，并波及英国、美国、日本、新加坡和菲律宾等地的政府与企业。",{"_57":303,"_297":295},"2026-11-13T13:47:42.000Z","awhnz5coaqe27o2s0gai3sicu","Microsoft 排除 Microsoft 365 中断网络攻击，披露借故障发起的钓鱼活动","Microsoft 表示，November 12 的 Microsoft 365 中断源于网络容量升级后的变更，不是网络攻击或 AI/Agent 所致，Exchange Online 事件 EX1550543 已于 November 13 标记解决。",{"_57":303,"_297":295},"2026-11-16T08:15:12.000Z","f1pcvmbn6syja58uaunr4cute","Microsoft 365 因 7 月引入的软件缺陷引发全球服务中断超过 80% 网络网关服务器无响应，影响 Outlook、Exchange Online、Teams 和 Copilot。",{"_57":324,"_297":295},true,"BleepingComputer",{"_329":343,"_13":344,"_21":319,"_17":162,"_332":345},{"_329":339,"_13":340,"_21":314,"_17":162,"_332":341},{"_329":335,"_13":336,"_21":308,"_17":162,"_332":337},{"_329":330,"_13":331,"_21":22,"_17":211,"_332":333},"factId","fTqlpso7s9gg","微软365服务中断影响多地用户","representative",{"_287":320,"_13":32,"_29":321,"_291":334,"_293":24,"_294":323},{"_57":324,"_297":295},"fE7uOo0BX0dk","发布Microsoft 365中断安全告警",{"_287":304,"_13":305,"_29":306,"_291":338,"_293":308,"_294":295},{"_57":309,"_297":295},"fmfQoTOxVGJ4","微软全球服务中断并持续恢复",{"_287":310,"_13":311,"_29":312,"_291":342,"_293":314,"_294":295},{"_57":303,"_297":295},"ffGgM160fCT8","披露借服务中断投递的钓鱼活动",{"_287":315,"_13":316,"_29":317,"_291":346,"_293":319,"_294":295},{"_57":303,"_297":295},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",{"_354":355,"_356":-5},"changelogVersion","2026-10-01T08:00","release"]
