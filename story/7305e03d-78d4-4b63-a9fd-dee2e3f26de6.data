[{"_1":2,"_3":4},"root",{"_5":157},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794357648000,"publicId","7305e03d-78d4-4b63-a9fd-dee2e3f26de6","title","“金钩”仿冒同花顺大规模植入远控木马","status","active","reportCount",3,"sourceCount","firstReportAt","2026-11-10T07:20:00.000Z","latestAt","2026-11-10T09:12:00.000Z","digest","国家互联网应急中心CNCERT与北京观成科技有限公司披露，“银狐”木马“金钩（G03）”团伙已通过仿冒同花顺下载站和SEO投毒实施大规模攻击：用户下载运行捆绑恶意载荷的THS.zip后，木马经RC4、XOR、shellcode和内存加载分四阶段植入，远控能力已得到确认。\n\n该木马通过TCP连接C&C服务器，可执行屏幕截图、键盘记录、远程命令、插件下发并收集主机信息。CNCERT监测显示，2026年10月4日至11月2日，该团伙控制境内肉鸡25164个，单日上线峰值1062个；相关钓鱼域名lojqka[.]com已失活。报道未提及软件补丁。","digestUpdatedAt","2026-11-10T11:47:53.563Z","summary","excerpt","latest","CNCERT披露“银狐”木马“金钩（G03）”团伙攻击同花顺仿冒下载站","latestReport",{"_122":140},"whyHot",{"_150":18,"_151":152,"_153":18,"_154":138,"_155":156},"developments",[143],"officialReports",[],"timeline",[119,120,121],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","malware","name","恶意软件","attack","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","email","邮件与钓鱼","cncert","CNCERT",{"_84":116,"_42":117,"_87":118},{"_84":114,"_42":115,"_87":18},{"_84":112,"_42":113,"_87":18},{"_84":110,"_42":111,"_87":18},{"_84":108,"_42":109,"_87":18},{"_84":106,"_42":107,"_87":18},{"_84":104,"_42":105,"_87":18},{"_84":102,"_42":103,"_87":18},{"_84":100,"_42":101,"_87":18},{"_84":98,"_42":99,"_87":18},{"_84":96,"_42":97,"_87":18},{"_84":94,"_42":95,"_87":18},{"_84":92,"_42":93,"_87":18},{"_84":90,"_42":91,"_87":18},{"_84":88,"_42":89,"_87":18},{"_84":85,"_42":86,"_87":18},"hour","2026-11-11T00:00:00.000Z",19,"participants","2026-11-10T23:00:00.000Z",19.6,"2026-11-10T22:00:00.000Z",20.1,"2026-11-10T21:00:00.000Z",20.7,"2026-11-10T20:00:00.000Z",21.3,"2026-11-10T19:00:00.000Z",22,"2026-11-10T18:00:00.000Z",22.6,"2026-11-10T17:00:00.000Z",23.3,"2026-11-10T16:00:00.000Z",24,"2026-11-10T15:00:00.000Z",24.7,"2026-11-10T14:00:00.000Z",25.4,"2026-11-10T13:00:00.000Z",26.1,"2026-11-10T12:00:00.000Z",26.9,"2026-11-10T11:00:00.000Z",27.7,"2026-11-10T10:00:00.000Z",28.5,"2026-11-10T09:00:00.000Z",19.3,2,{"_122":140,"_13":31,"_28":141,"_126":142,"_128":23,"_129":138},{"_122":133,"_13":134,"_28":135,"_126":136,"_128":137,"_129":138},{"_122":123,"_13":124,"_28":125,"_126":127,"_128":21,"_129":130},"id","di16oijlpd1stykz45r9qey5b","CNCERT披露“银狐”木马“金钩（G03）”团伙仿冒同花顺攻击活动","CNCERT与北京观成科技有限公司披露，“银狐”木马“金钩（G03）”团伙仿冒同花顺下载站点，经SEO投毒诱导下载THS.zip，并以RC4、XOR、shellcode和内存加载分四阶段植入远控木马。","source",{"_56":131,"_132":130},"publishedAt","selected",false,"国家互联网应急中心CNCERT","firstParty","e56m0k9vilqv1oyidnxavbgd9","CNCERT披露“银狐”木马“金钩（G03）”仿冒同花顺攻击活动","CNCERT与北京观成科技有限公司发现，“银狐”木马“金钩（G03）”团伙通过仿冒同花顺下载网站和SEO投毒诱导下载THS.zip，经多阶段内存加载植入远控木马。",{"_56":139,"_132":130},"2026-11-10T08:04:22.544Z",true,"安全内参","vf2fadfkovuwc9eyk4jilfa6l","国家互联网应急中心（CNCERT）与北京观成科技有限公司分析“银狐”木马“金钩（G03）”团伙针对同花顺仿冒下载站的活动。该团伙通过SEO投毒传播捆绑木马的THS.zip，以多阶段内存加载植入远控模块，支持屏幕截图、键盘记录、远程命令执行、插件下发和信息窃取。",{"_56":139,"_132":130},{"_144":145,"_13":146,"_20":21,"_17":18,"_147":148},"factId","fb23pcOOIDuQ","CNCERT披露银狐金钩团伙攻击","representative",{"_122":140,"_13":31,"_28":141,"_126":149,"_128":23,"_129":138},{"_56":139,"_132":130},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",7,{"_158":159,"_160":-5},"changelogVersion","2026-10-01T08:00","release"]
