[{"_1":2,"_3":4},"root",{"_5":178},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1793591189000,"publicId","6ef2ec24-f871-4ca2-9cc2-5fcbd249af24","title","FBI归因TraderTraitor窃取Binance资产","status","active","reportCount",4,"sourceCount","firstReportAt","2026-11-01T06:44:27.000Z","latestAt","2026-11-01T19:57:53.000Z","digest","FBI确认朝鲜国家支持的组织TraderTraitor利用遭入侵的DevOps工程师笔记本进入服务容器，提交未授权提现交易，从Binance窃取价值64.3亿美元的加密资产；FBI、美国特勤局和IRS-CI已公布628个相关地址，要求加密企业、交易所、区块链运营商及虚拟资产服务商拦截相关及衍生资金交易。\n\nFBI称赃款涉及11条区块链，82%位于以太坊和比特币网络，攻击者主要将资产转换为ETH，并通过DeFi和即时兑换服务洗钱。Tether、Circle、Ripple、Arbitrum和Optimism已链上冻结28.5亿美元，Binance称经执法部门、代币发行方及行业伙伴协作，已核实冻结约30亿美元、覆盖约95%受影响金额。报道对涉及链数量另称10条、金额约63.6亿美元；Binance表示尚未发现钱包私钥被窃的证据。","digestUpdatedAt","2026-11-01T20:44:50.608Z","summary","excerpt","latest","FBI 将 Binance 63 亿美元加密资产窃取案归因于朝鲜 TraderTraitor","latestReport",{"_137":161},"whyHot",{"_172":18,"_173":174,"_175":18,"_176":145,"_177":128},"developments",[165],"officialReports",[],"timeline",[133,134,135,136],"heat",[72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90],"related",[68],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","malware","name","恶意软件","exploited","在野利用","ransomware","勒索软件","crypto","密码学","black-market","数据窃取与黑产","attack","攻击活动",{"_11":69,"_13":70,"_71":44},"95f3b82d-3dca-476e-a96d-466662cbcf8e","币安确认约63亿美元加密资产被盗","relation",{"_91":131,"_42":132,"_94":128},{"_91":129,"_42":130,"_94":128},{"_91":126,"_42":127,"_94":128},{"_91":124,"_42":125,"_94":111},{"_91":122,"_42":123,"_94":111},{"_91":120,"_42":121,"_94":111},{"_91":118,"_42":119,"_94":111},{"_91":116,"_42":117,"_94":111},{"_91":114,"_42":115,"_94":111},{"_91":112,"_42":113,"_94":111},{"_91":109,"_42":110,"_94":111},{"_91":107