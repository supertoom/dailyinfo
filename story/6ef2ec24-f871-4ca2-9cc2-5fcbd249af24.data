产，攻击者通过入侵 DevOps 工程师笔记本进入服务容器并提交未授权提现交易。",{"_56":164,"_147":148},"BleepingComputer",{"_166":167,"_13":168,"_20":21,"_17":18,"_169":170},"factId","f39FEvqrWazs","FBI归因TraderTraitor巨额加密资产窃取","representative",{"_137":161,"_13":31,"_28":162,"_141":171,"_143":23,"_144":145},{"_56":164,"_147":148},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",{"_179":180,"_181":-5},"changelogVersion","2026-10-01T08:00","release"]
