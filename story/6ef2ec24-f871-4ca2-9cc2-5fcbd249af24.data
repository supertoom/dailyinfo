[{"_1":2,"_3":4},"root",{"_5":262},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1793672470000,"publicId","6ef2ec24-f871-4ca2-9cc2-5fcbd249af24","title","FBI归因TraderTraitor窃取Binance资产","status","active","reportCount",6,"sourceCount","firstReportAt","2026-11-01T06:44:27.000Z","latestAt","2026-11-02T10:15:00.000Z","digest","FBI确认朝鲜支持的组织TraderTraitor于2026年10月29日前后从Binance窃取价值64.3亿美元的加密资产，并称攻击者通过遭入侵的DevOps工程师笔记本进入服务容器，提交未授权提现交易。FBI、美国特勤局和IRS-CI已公布628个相关地址，要求加密企业、交易所、区块链运营商及虚拟资产服务商拦截相关及衍生资金交易。\n\nFBI称赃款涉及11条区块链，82%位于以太坊和比特币网络，攻击者主要将资产转换为ETH，并通过DeFi和即时兑换服务洗钱。Tether、Circle、Ripple、Arbitrum和Optimism已链上冻结28.5亿美元；Binance称经执法部门、代币发行方及行业伙伴协作，已核实冻结约30亿美元，并以自有资金补偿约95%的受影响金额。关于涉及链数量和金额，早先报道另称10条、约63.6亿美元，FBI后续表述为11条、64.3亿美元。Elliptic称约29亿美元已被冻结或查获，仍有近33亿美元不在发行方控制范围内，并称攻击涉及多人且使用了销毁工具和痕迹的“自毁机制”。Binance表示尚未发现钱包私钥被窃的证据，并称客户资金没有危险。","digestUpdatedAt","2026-11-02T10:45:06.036Z","summary","excerpt","latest","FBI 归因 North Korea 的 TraderTraitor 窃取 Binance 超过 $6bn 加密资产","latestReport",{"_209":245},"whyHot",{"_256":18,"_257":258,"_259":181,"_260":217,"_261":181},"developments",[249],"officialReports",[],"timeline",[203,204,205,206,207,208],"heat",[72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113],"related",[68],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","malware","name","恶意软件","exploited","在野利用","ransomware","勒索软件","crypto","密码学","black-market","数据窃取与黑产","attack","攻击活动",{"_11":69,"_13":70,"_71":44},"95f3b82d-3dca-476e-a96d-466662cbcf8e","币安确认约63亿美元加密资产被盗","relation",{"_114":201,"_42":202,"_117":198},{"_114":199,"_42":200,"_117":198},{"_114":196,"_42":197,"_117":198},{"_114":194,"_42":195,"_117