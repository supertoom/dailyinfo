[{"_1":2,"_3":4},"root",{"_5":211},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795308048000,"publicId","d95d22b9-0d5d-4433-af64-a6e7e8c6958e","title","邮件轰炸后借Teams冒充IT钓鱼","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-20T11:55:00.000Z","latestAt","2026-11-21T12:54:31.000Z","digest","Fortra Intelligence and Research Experts（FIRE）披露，攻击者将目标邮箱提交至无关网站的Newsletter、注册等表单，无需访问邮箱即可制造订阅邮件轰炸，再通过Microsoft Teams冒充Internal IT，以协助停止邮件为由诱导受害者执行操作，试图控制其账户或计算机；后续报道称实际影响取决于攻击者最终取得何种访问权限，尚无确认失陷或受影响规模。\n\nFIRE观察到单次活动邮件投递量峰值约1万封，平均每天约1000封。其称攻击可能由AI Agent执行，但该判断尚未获得具体规模、受害数量或账户失陷证据支持。","digestUpdatedAt","2026-11-21T13:48:17.067Z","summary","excerpt","latest","攻击者通过 Microsoft Teams 冒充 IT 支持，配合邮件炸弹攻击企业账户","latestReport",{"_181":192},"whyHot",{"_203":18,"_204":205,"_206":132,"_207":208,"_209":210},"developments",[196],"officialReports",[],"timeline",[179,180],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","malware","name","恶意软件","ai-offense","AI 攻防","incident","应急响应","microsoft","Microsoft / 微软","attack","攻击活动","email","邮件与钓鱼",{"_104":177,"_42":178,"_107":132},{"_104":175,"_42":176,"_107":132},{"_104":173,"_42":174,"_107":132},{"_104":171,"_42":172,"_107":132},{"_104":169,"_42":170,"_107":132},{"_104":167,"_42":168,"_107":132},{"_104":165,"_42":166,"_107":132},{"_104":163,"_42":164,"_107":132},{"_104":161,"_42":162,"_107":132},{"_104":159,"_42":160,"_107":132},{"_104":157,"_42":158,"_107":132},{"_104":155,"_42":156,"_107":132},{"_104":153,"_42":154,"_107":132},{"_104":151,"_42":152,"_107":132},{"_104":149,"_42":150,"_107":132