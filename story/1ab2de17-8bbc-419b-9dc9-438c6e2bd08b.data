[{"_1":2,"_3":4},"root",{"_5":208},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795826460000,"publicId","1ab2de17-8bbc-419b-9dc9-438c6e2bd08b","title","FIFA确认遭入侵，自称HBHC的组织宣称泄露超12GB数据","status","active","reportCount",4,"sourceCount","firstReportAt","2026-11-26T17:06:55.000Z","latestAt","2026-11-27T13:21:50.000Z","digest","国际足联（FIFA）确认遭到网络攻击，黑客获取了其称为“有限范围的个人和业务信息”，并表示正与包括执法机构在内的相关机构合作调查；FIFA未披露攻击发生时间、技术细节及所访问信息的具体性质，也未说明攻击是否已被遏制或数据是否已被公开。\n\n自称 Handsome Boy Hacking Club（HBHC）的组织于11月20日将FIFA列入其“受害者”名单，称从FIFA的Microsoft环境及内部治理系统导出超过12 GB文件，含身份文件、移民记录、高管信息、财务及法律文件，并称此次行动用于勒索；11月21日该组织被报道已在网络犯罪论坛发布所窃数据。FIFA尚未确认这些声称，文件内容、规模及HBHC是否实施了本次攻击均无独立确认，报道提醒此类清单属于未经独立核实的声称。","digestUpdatedAt","2026-11-27T14:21:56.872Z","summary","excerpt","latest","FIFA 确认遭黑客入侵，Handsome Boy Hacking Club 声称窃取内部治理与个人资料","latestReport",{"_167":190},"whyHot",{"_201":18,"_202":203,"_204":122,"_205":206,"_207":122},"developments",[194],"officialReports",[],"timeline",[163,164,165,166],"heat",[65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95],"related",[],"topics",[48,49,50,51,52],{"_53":63,"_55":64},{"_53":61,"_55":62},{"_53":59,"_55":60},{"_53":57,"_55":58},{"_53":54,"_55":56},"slug","malware","name","恶意软件","black-market","数据窃取与黑产","microsoft","Microsoft / 微软","attack","攻击活动","ransomware","勒索软件",{"_96":161,"_42":162,"_99":134},{"_96":159,"_42":160,"_99":134},{"_96":157,"_42":158,"_99":134},{"_96":155,"_42":156,"_99":134},{"_96":153,"_42":154,"_99":134},{"_96":151,"_42":152,"_99":134},{"_96":149,"_42":150,"_99":134},{"_96":147,"_42":148,"_99":134},{"_96":145,"_42":146,"_99":134},{"_96":143,"_42":144,"_99":134},{"_96":141,"_42":142,"_99":134},{"_96":139,"_42":140,"_99":134},{"_96":137,"_42":138,"_99":134},{"_96":135,"_42":136,"_99":134},{"_96":132,"_42":133,"_99