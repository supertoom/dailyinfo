,"Dark Reading",{"_324":325,"_13":326,"_20":21,"_17":221,"_327":328},"factId","fy_fiy4_d7JU","Cursor披露市场投毒导致恶意扩展","representative",{"_295":313,"_13":314,"_28":315,"_299":329,"_301":317,"_302":303},{"_55":318,"_305":306},"participants48h","newParticipants6h","recentReports24h","observationComplete","rank",10,{"_337":338,"_339":-5},"changelogVersion","2026-10-01T08:00","release"]
