[{"_1":2,"_3":4},"root",{"_5":212},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795480851000,"publicId","ba176f09-c52f-4604-abe1-b6be5555c35e","title","GL.iNet GoodCloud漏洞已修补，设备恶意软件仍存","status","active","reportCount",5,"sourceCount","firstReportAt","2026-11-22T18:45:37.000Z","latestAt","2026-11-23T15:05:50.000Z","digest","GL.iNet确认，未经授权的攻击者利用云端远程管理服务GoodCloud的漏洞，在部分客户路由器和KVM设备中植入恶意软件。厂商于2026年11月20日修复漏洞并封堵该入侵路径，但受影响设备数量尚未确认；云端修复不会清除设备内已有恶意软件，厂商建议所有设备安装最新稳定安全固件，无需恢复出厂设置。\n\nRemoteToHome称，其接触的199台路由器中有166台存在11月20日攻击、2025年9月起的旧后门或两者并存，不能全部归因于本次攻击；GL-AXT1800固件4.8.3设备已被报告出现root级反向Shell。厂商另提示快速检查只能识别进程“crond -i /tmp/.log”，但还存在其无法发现的入侵指标。","digestUpdatedAt","2026-11-23T15:10:57.665Z","summary","excerpt","latest","GL.iNet GoodCloud 被攻破，路由器与 KVM 设备被植入恶意软件并发现 2025 年旧后门","latestReport",{"_165":195},"whyHot",{"_206":18,"_207":208,"_209":117,"_210":173,"_211":131},"developments",[199],"officialReports",[],"timeline",[160,161,162,163,164],"heat",[65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94],"related",[],"topics",[48,49,50,51,52],{"_53":63,"_55":64},{"_53":61,"_55":62},{"_53":59,"_55":60},{"_53":57,"_55":58},{"_53":54,"_55":56},"slug","vuln","name","漏洞披露","attack","攻击活动","exploited","在野利用","malware","恶意软件","iot","IoT 与车联网",{"_95":158,"_42":159,"_98":131},{"_95":156,"_42":157,"_98":131},{"_95":154,"_42":155,"_98":131},{"_95":152,"_42":153,"_98":131},{"_95":150,"_42":151,"_98":131},{"_95":148,"_42":149,"_98":131},{"_95":146,"_42":147,"_98":131},{"_95":144,"_42":145,"_98":131},{"_95":142,"_42":143,"_98":131},{"_95":140,"_42":141,"_98":131},{"_95":138,"_42":139,"_98":131},{"_95":136,"_42":137,"_98":131},{"_95":134,"_42":135,"_98":131},{"_95":132,"_42":133,"_98":131},{"_95":129,"_42":130,"_98":131},{"_95":127,"_42":128,"_98":122},{"_95":125,"_42":126,"_98":122},{"_95":123,"_42":124,"_98":122},{"_95":120,"_42":121,"_98":122},{"_95":118,"_42":119,"_98":117},{"_95":115,"_42":116,"_98":117},{"_95":113,"_42":114,"_98":18},{"_95":111,"_42":112,"_98":18},{"_95":109,"_42":110,"_98":18},{"_95":107,"_42":108,"_98":18},{"_95":105,"_42":106,"_98":18},{"_95":103,"_42":104,"_98":18},{"_95":101,"_42":102,"_98":18},{"_95":99,"_42":100,"_98":18},{"_95":96,"_42":97,"_98":18},"hour","2026-11-24T00:00:00.000Z",32.4,"participants","2026-11-23T23:00:00.000Z",33.4,"2026-11-23T22:00:00.000Z",34.4,"2026-11-23T21:00:00.000Z",35.4,"2026-11-23T20:00:00.000Z",36.4,"2026-11-23T19:00:00.000Z",37.5,"2026-11-23T18:00:00.000Z",38.6,"2026-11-23T17:00:00.000Z",39.7,"2026-11-23T16:00:00.000Z",40.9,"2026-11-23T15:00:00.000Z",32,4,"2026-11-23T14:00:00.000Z",33,"2026-11-23T13:00:00.000Z",23.8,3,"2026-11-23T12:00:00.000Z",24.5,"2026-11-23T11:00:00.000Z",25.2,"2026-11-23T10:00:00.000Z",26,"2026-11-23T09:00:00.000Z",6.6,1,"2026-11-23T08:00:00.000Z",6.8,"2026-11-23T07:00:00.000Z",7,"2026-11-23T06:00:00.000Z",7.2,"2026-11-23T05:00:00.000Z",7.4,"2026-11-23T04:00:00.000Z",7.7,"2026-11-23T03:00:00.000Z",7.9,"2026-11-23T02:00:00.000Z",8.1,"2026-11-23T01:00:00.000Z",8.4,"2026-11-23T00:00:00.000Z",8.6,"2026-11-22T23:00:00.000Z",8.8,"2026-11-22T22:00:00.000Z",9.1,"2026-11-22T21:00:00.000Z",9.4,"2026-11-22T20:00:00.000Z",9.6,"2026-11-22T19:00:00.000Z",9.9,{"_165":195,"_13":31,"_28":196,"_169":197,"_171":23,"_172":173},{"_165":189,"_13":190,"_28":191,"_169":192,"_171":193,"_172":176},{"_165":183,"_13":184,"_28":185,"_169":186,"_171":187,"_172":176},{"_165":177,"_13":178,"_28":179,"_169":180,"_171":181,"_172":173},{"_165":166,"_13":167,"_28":168,"_169":170,"_171":21,"_172":173},"id","i27aenxyu7ec3i7ftauologeu","攻击者利用 GL.iNet GoodCloud 漏洞感染路由器与 KVM 设备","攻击者已利用 GL.iNet GoodCloud 云远程管理服务漏洞，在客户路由器和 KVM 设备中安装恶意软件；部分设备出现 root 级反向 Shell，攻击基础设施包括 66.245.219[.]252 和 65.20.71[.]131。","source",{"_55":174,"_175":176},"publishedAt","selected",true,"BleepingComputer","firstParty",false,"xvdfgey1h2fjrjiq2mzm5outw","攻击者利用 GL.iNet GoodCloud 漏洞向路由器和 KVM 设备植入恶意软件","攻击者已利用 GL.iNet GoodCloud 远程管理服务漏洞，在部分客户路由器和 KVM 设备中植入恶意软件；RemoteToHome 在 GL-AXT1800 路由器上确认 root 级反向 shell，另有两名用户报告 GL-AXT1800 固件 4.8.3 出现相同 shell。",{"_55":182,"_175":176},"2026-11-23T09:04:08.000Z","The Hacker News","avsebyl26k9rcik55gns3hgku","攻击者利用 GL.iNet 自有云服务感染路由器和 KVM","攻击者已利用 GL.iNet 自有云服务感染 GL.iNet 路由器和 KVM，并植入恶意软件。GL.iNet 建议更新固件，但原文指出更新可能无法完全阻止攻击者；材料未披露受影响型号、恶意软件家族、攻击规模或可用的完整处置方案。",{"_55":188,"_175":176},"2026-11-23T09:20:13.000Z","Cybernews","p78cd2625wkmi210od3a254hv","GL.iNet 路由器与 KVM 因 GoodCloud 远程管理服务漏洞被植入恶意软件","GL.iNet 确认，攻击者利用其云端远程管理服务 GoodCloud 的漏洞，向部分路由器和 KVM 设备投放恶意软件。厂商于 11 月 20 日发现并修补该漏洞，但补丁不会清除已感染设备中的恶意软件，客户还需安装单独的安全固件，厂商建议所有设备均安装。",{"_55":194,"_175":176},"2026-11-23T13:26:22.000Z","SecurityWeek","yx5d3ycu42hwl0b9ljfwu9d50","攻击者攻破 GL.iNet 的云端远程管理服务 GoodCloud，向接入的旅行路由器与 KVM 设备安装恶意软件，GL.iNet 于 2026 年 11 月 20 日发现该云端漏洞并已修复，受影响设备数量仍在调查。",{"_55":198,"_175":176},"Help Net Security",{"_200":201,"_13":202,"_20":21,"_17":18,"_203":204},"factId","fbBb15UnXN2k","攻击者利用云管理漏洞感染设备","representative",{"_165":166,"_13":167,"_28":168,"_169":205,"_171":21,"_172":173},{"_55":174,"_175":176},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",{"_213":214,"_215":-5},"changelogVersion","2026-10-01T08:00","release"]
