[{"_1":2,"_3":4},"root",{"_5":299},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795567297000,"publicId","ba176f09-c52f-4604-abe1-b6be5555c35e","title","GL.iNet封堵GoodCloud入侵路径，设备仍需清理","status","active","reportCount",7,"sourceCount","firstReportAt","2026-11-22T18:45:37.000Z","latestAt","2026-11-24T09:02:41.838Z","digest","GL.iNet确认，攻击者利用GoodCloud云端远程管理服务漏洞，通过更新通道向部分客户路由器和KVM设备植入恶意软件；厂商已修复漏洞并封堵该路径，攻击者无法再由此感染新设备，但受影响总数尚未确认。\n\n云端修复不会清除既有恶意软件。GL.iNet要求所有设备安装单独发布的安全固件；该固件通常无需恢复出厂设置，但官方快速检查只能发现“crond -i /tmp/.log”进程，无法覆盖全部入侵指标，严重失陷设备可能需重装固件并清除原有配置。RemoteToHome称其接触的199台路由器中有166台存在本次攻击、始于2025年9月的旧后门或两者并存，不能全部归因于本次事件。","digestUpdatedAt","2026-11-24T11:52:12.210Z","summary","excerpt","latest","GL.iNet 云端漏洞遭利用，路由器和 KVM 设备被植入恶意软件","latestReport",{"_240":282},"whyHot",{"_292":123,"_293":294,"_295":296,"_297":248,"_298":296},"developments",[285],"officialReports",[],"timeline",[233,234,235,236,237,238,239],"heat",[65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118],"related",[],"topics",[48,49,50,51,52],{"_53":63,"_55":64},{"_53":61,"_55":62},{"_53":59,"_55":60},{"_53":57,"_55":58},{"_53":54,"_55":56},"slug","vuln","name","漏洞披露","exploited","在野利用","attack","攻击活动","malware","恶意软件","iot","IoT 与车联网",{"_119":231,"_42":232,"_122":205},{"_119":229,"_42":230,"_122":205},{"_119":227,"_42":228,"_122":205},{"_119":225,"_42":226,"_122":205},{"_119":223,"_42":224,"_122":205},{"_119":221,"_42":222,"_122":205},{"_119":219,"_42":220,"_122":205},{"_119":217,"_42":218,"_122":205},{"_119":215,"_42":216,"_122":205},{"_119":213,"_42":214,"_122":205},{"_119":211,"_42":212,"_122":205},{"_119":209,"_42":210,"_122":205},{"_119":208,"_42":18,"_122":205},{"_119":206,"_42":207,