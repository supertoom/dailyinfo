[{"_1":2,"_3":4},"root",{"_5":365},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795567297000,"publicId","610251db-932a-4927-8cc3-ae706bee1e61","title","FBI调查NCIC数据库疑似遭入侵","status","active","reportCount",5,"sourceCount","firstReportAt","2026-11-21T14:26:04.000Z","latestAt","2026-11-24T07:05:05.000Z","digest","FBI正在调查其维护的国家犯罪信息中心（NCIC）数据库疑似遭黑客入侵；事件近日被发现，但入侵时间、攻击者身份、访问方式及数据是否被窃均不明，FBI尚未公开确认并拒绝置评，是否已遭利用、影响范围及系统可用性是否受损仍无法确认。\n\nNCIC供执法机构查询逮捕令、背景调查和刑事记录，并保存通缉、失踪人口、犯罪记录及被盗财物等信息。Security Affairs称，截至2023年，该系统包含22个数据库、逾1800万条活跃记录，服务逾100000个执法和刑事司法组织。报道未确认敏感记录被访问或系统服务中断。\n\n有关入侵者利用Oracle PeopleSoft零日漏洞取得远程代码执行的说法来自一个团体的主张，目前没有证据将其与此次事件或此前针对FBI系统的入侵联系起来。","digestUpdatedAt","2026-11-24T08:01:58.204Z","summary","excerpt","latest","FBI 调查执法机构使用的 NCIC 数据库疑似遭入侵","latestReport",{"_319":347},"whyHot",{"_358":150,"_359":360,"_361":297,"_362":363,"_364":256},"developments",[351],"officialReports",[],"timeline",[314,315,316,317,318],"heat",[65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130,131,132,133,134,135,136,137,138,139,140,141,142,143,144,145],"related",[],"topics",[48,49,50,51,52],{"_53":63,"_55":64},{"_53":61,"_55":62},{"_53":59,"_55":60},{"_53":57,"_55":58},{"_53":54,"_55":56},"slug","exploited","name","在野利用","black-market","数据窃取与黑产","ransomware","勒索软件","oracle","Oracle / 甲骨文","attack","攻击活动",{"_146":312,"_42":313,"_149":297},{"_146":310,"_42":311,"_149":297},{"_146":308,"_42":309,"_149":297},{"_146":306,"_42":307,"_149":297},{"_146":304,"_42":305,"_149":297},{"_146":302,"_42":303,"_149":297},{"_146":300,"_42":301,"_149":297},{"_146":298,"_42":299,"_149":297},{"_146":295,"_42":296,"_149":297},{"_146":