[{"_1":2,"_3":4},"root",{"_5":279},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795480850000,"publicId","610251db-932a-4927-8cc3-ae706bee1e61","title","FBI调查NCIC数据库疑似遭入侵","status","active","reportCount",4,"sourceCount","firstReportAt","2026-11-21T14:26:04.000Z","latestAt","2026-11-23T10:33:38.923Z","digest","FBI正在调查其维护的国家犯罪信息中心（NCIC）数据库疑似遭黑客入侵；该事件由知情人士披露，FBI尚未公开确认并拒绝置评，因此是否被利用、数据是否被窃及影响范围仍未明，入侵时间与访问方式也不清楚。\n\nNCIC向地方、州和联邦执法机构提供通缉、失踪人口、逮捕令、犯罪记录及被盗财物等信息。敏感执法记录是否被访问、系统对执法机构的可用性是否受影响均未获证实；目前没有迹象表明该事件与ShinyHunters、此前针对FBI系统的入侵或相关服务中断有关。","digestUpdatedAt","2026-11-23T11:35:42.788Z","summary","excerpt","latest","FBI调查国家犯罪信息中心 NCIC 疑似遭网络攻击事件","latestReport",{"_239":262},"whyHot",{"_272":120,"_273":274,"_275":149,"_276":277,"_278":222},"developments",[265],"officialReports",[],"timeline",[235,236,237,238],"heat",[59,60,61,62,63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115],"related",[],"topics",[48,49,50],{"_51":57,"_53":58},{"_51":55,"_53":56},{"_51":52,"_53":54},"slug","black-market","name","数据窃取与黑产","ransomware","勒索软件","attack","攻击活动",{"_116":233,"_42":234,"_119":218},{"_116":231,"_42":232,"_119":218},{"_116":229,"_42":230,"_119":218},{"_116":227,"_42":228,"_119":218},{"_116":225,"_42":226,"_119":218},{"_116":223,"_42":224,"_119":218},{"_116":221,"_42":222,"_119":218},{"_116":219,"_42":220,"_119":218},{"_116":216,"_42":217,"_119":218},{"_116":214,"_42":215,"_119":149},{"_116":212,"_42":213,"_119":149},{"_116":210,"_42":211,"_119":149},{"_116":208,"_42":209,"_119":149},{"_116":206,"_42":207,"_119":149},{"_116":204,"_42":205,"_119":149},{"_116":202,"_42":203,"_119":149},{"_116":200,"_42":201,"_119":149},{"_116":198,"_42":199,"_119":149},{"_116":1