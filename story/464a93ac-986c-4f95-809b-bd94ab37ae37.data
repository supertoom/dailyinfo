[{"_1":2,"_3":4},"root",{"_5":202},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794530496000,"publicId","464a93ac-986c-4f95-809b-bd94ab37ae37","title","ImageTragick2致Rails可读写任意文件","status","active","reportCount",3,"sourceCount","firstReportAt","2026-11-04T21:48:18.000Z","latestAt","2026-11-12T23:46:51.000Z","digest","CERT/CC披露，集成ImageMagick且安全策略限制不足的应用存在多个任意文件读写漏洞，统称ImageTragick2；Rails Active Storage 8.1已修复，但尚无实际利用确认，影响版本范围亦未明确。\n\n攻击者上传或诱导应用处理恶意SVG、PostScript即可触发；CERT/CC称，Rails Active Storage无需调用变体、预览或`analyze`。GitHub安全公告指出，使用`:mini_magick`且允许不可信用户上传文件的应用可被未认证攻击者利用，在服务器写入任意文件；使用Disk服务时，还可读取应用进程有权访问的任意文件。利用还要求ImageMagick进程启用内部SVG coder及所需危险coder；即使Ghostscript使用`-dSAFER`，相关配置仍可访问`/tmp`内文件。\n\nRails修复要求mini_magick `>= 5.1`并调整安全策略；仅升级ImageMagick可能无效。Debian和Ubuntu随附策略未禁用相关coders，因此采用这些策略的部署仍暴露于风险。","digestUpdatedAt","2026-11-13T00:01:47.772Z","summary","excerpt","latest","Rails Active Storage 8.1 修复 ImageMagick 任意文件读写漏洞","latestReport",{"_153":171},"whyHot",{"_196":99,"_197":102,"_198":99,"_199":170,"_200":201},"developments",[179,180,181],"officialReports",[175,176],"timeline",[150,151,152],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","identity","name","身份与访问","supply-chain","供应链安全","certcc","CERT/CC","exploited","在野利用","research","技术研究","vuln","漏洞披露",{"_95":148,"_42":149,"_98":102},{"_95":146,"_42":147,"_98":102},{"_95":144,"_42":145,"_98":102},{"_95":142,"_42":143,"_98":102},{"_95":140,"_42":141,"_98":102},{"_95":138,"_42":139,"_98":102},{"_95":136,"_42":137,"_98":102},{"_95":134,"_42":135,"_98":102},{"_95":132,"_42":133,"_98":102},{"_95":130,"_42":131,"_