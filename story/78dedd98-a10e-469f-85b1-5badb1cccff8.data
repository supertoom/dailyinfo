[{"_1":2,"_3":4},"root",{"_5":181},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795912857000,"publicId","78dedd98-a10e-469f-85b1-5badb1cccff8","title","Q-Dir与DesktopOK安装包投毒植入RAT","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-27T09:29:30.000Z","latestAt","2026-11-28T15:32:49.000Z","digest","AhnLab披露，Q-Dir与DesktopOK官方SoftwareOK分发渠道的5个安装版本被确认遭投毒，已确认可下载并自动执行Python RAT，但未公布修复版本或具体投毒机制。受影响版本为Q-Dir 12.83.0.0、12.84.0.0、12.85.0.0及DesktopOK 12.82.0.0、12.85.0.0；AhnLab称并非所有版本均被感染，近期安装或更新过这两款工具的用户无论版本都应将系统视为可能已失陷。\n\n恶意安装包还覆盖既有正版程序的更新流程，会从外部服务器下载载荷，经7-Zip解压运行RAT，并借助伪装成Microsoft Edge的计划任务持久化；RAT随后连接C2执行命令、传输文件、截图和收集系统及安全软件信息。AhnLab尚无法确定安装包如何被替换或恶意版本分发持续多久，该活动也未被归属于任何已知威胁组织。","digestUpdatedAt","2026-11-28T23:33:59.802Z","summary","excerpt","latest","Q-Dir 和 DesktopOK 官方安装包遭篡改，投放 Python RAT","latestReport",{"_151":162},"whyHot",{"_173":18,"_174":175,"_176":110,"_177":178,"_179":180},"developments",[166],"officialReports",[],"timeline",[149,150],"heat",[59,60,61,62,63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87],"related",[],"topics",[48,49,50],{"_51":57,"_53":58},{"_51":55,"_53":56},{"_51":52,"_53":54},"slug","malware","name","恶意软件","attack","攻击活动","supply-chain","供应链安全",{"_88":147,"_42":148,"_91":110},{"_88":145,"_42":146,"_91":110},{"_88":143,"_42":144,"_91":110},{"_88":141,"_42":142,"_91":110},{"_88":139,"_42":140,"_91":110},{"_88":137,"_42":138,"_91":110},{"_88":135,"_42":136,"_91":110},{"_88":133,"_42":134,"_91":110},{"_88":131,"_42":132,"_91":110},{"_88":129,"_42":130,"_91":110},{"_88":127,"_42":128,"_91":110},{"_88":125,"_42":126,"_91":110},{"_88":123,"_42":124,"_91":110},{"_88":121,"_42":122,"_91":110},{"_88":119,"_42":120,"_91":110},{"_88":117,"_42":118,"_91":110},{"_88":115,"_42":116,"_91":110},{"_88":113,"_42":114,