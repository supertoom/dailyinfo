[{"_1":2,"_3":4},"root",{"_5":231},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":-5,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48},"expiresAt",1794962454000,"publicId","9c6cfeee-afca-48bc-9a37-6ffde4a1dd7e","title","Optimizely漏洞遭利用，178家机构站点被注入恶意脚本","status","active","reportCount",10,"sourceCount",9,"firstReportAt","2026-11-17T02:12:17.000Z","latestAt","2026-11-17T20:43:14.000Z","digest","Optimizely确认，未经授权方利用Experimentation漏洞，在客户账户的custom Project JavaScript字段注入恶意JavaScript，经厂商合法CDN和证书向访客分发，涉及至少178家组织；厂商已修补漏洞、移除注入代码并加固受影响账户。Report URI检查1,611个脚本，发现188个受感染，涉CNN、BBC、Salesforce、Zoom、GitLab、HSBC、Equifax和IKEA，并称所有感染文件已于11月16日23:11 UTC清除，实际范围可能更大。\n\nUnit 42将攻击命名为OPTIMJACK，称载荷可替换加密钱包地址、收集结账表单中的支付卡信息，并向iPhone和iPad投递Coruna（针对iOS 13.0至17.2.1）和DarkSword（针对iOS 18.4至18.7）；跨源支付iframe中的卡号无法读取，Unit 42建议将暴露的支付数据视为可能已泄露。尚无证据表明机构内网被攻破、所有访客设备均遭入侵或真实iPhone已被攻陷，成功入侵设备及被盗支付记录数量仍未知，攻击者最初取得权限的方式也未确认。","digestUpdatedAt","2026-11-17T21:25:58.217Z","summary","excerpt","latest","OPTIMJACK 利用 Optimizely 漏洞向至少 178 家组织网站注入恶意 JavaScript","latestReport",{"_152":210},"whyHot",{"_226":20,"_227":134,"_228":18,"_229":160,"_230":134},"developments",[214,215],"officialReports",[],"timeline",[142,143,144,145,146,147,148,149,150,151],"heat",[69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90],"related",[],"topics",[49,50,51,52,53,54],{"_55":67,"_57":68},{"_55":65,"_57":66},{"_55":63,"_57":64},{"_55":61,"_57":62},{"_55":59,"_57":60},{"_55":56,"_57":58},"slug","exploited","name","在野利用","malware","恶意软件","black-market","数据窃取与黑产","ransomware","勒索软件","supply-chain","供应链安全","attack","攻击活动",{"_91":140,"_43":141,"_94":134},{"_91":138,"_43":139,"_94":134},{"_91":136,"_43":137,"_94":134},{"_91":135,"_43":20,"_94":134},{"_91":132,"_43":133,"_94":134},{"_91":130,"_43":131,"_94":129},{"_91":127,"_43":128,"_94":129},{"_91":124,"_43":125,"_94":126},{"_91":121,"_43":122,"_94":123},{"_91":119,"_43":120,"_94":118},{"_91":116,"_43":117,"_94":118},{"_91":114,"_43":115,"_94":103},{"_91":112,"_43":113,"_94":103},{"_91":110,"_43":111,"_94":103},{"_91":108,"_43":109,"_94":103},{"_91":106,"_43":107,"_94":103},{"_91":104,"_43":105,"_94":103},{"_91":101,"_43":102,"_94":103},{"_91":99,"_43":100,"_94":20},{"_91":97,"_43":98,"_94":20},{"_91":95,"_43":96,"_94":20},{"_91":92,"_43":93,"_94":20},"hour","2026-11-18T00:00:00.000Z",61.5,"participants","2026-11-17T23:00:00.000Z",63.3,"2026-11-17T22:00:00.000Z",65.2,"2026-11-17T21:00:00.000Z",67.1,"2026-11-17T20:00:00.000Z",58.8,8,"2026-11-17T19:00:00.000Z",60.5,"2026-11-17T18:00:00.000Z",62.3,"2026-11-17T17:00:00.000Z",64.1,"2026-11-17T16:00:00.000Z",66,"2026-11-17T15:00:00.000Z",68,"2026-11-17T14:00:00.000Z",70,"2026-11-17T13:00:00.000Z",61.8,7,"2026-11-17T12:00:00.000Z",63.6,"2026-11-17T11:00:00.000Z",55.2,6,"2026-11-17T10:00:00.000Z",36.5,4,"2026-11-17T09:00:00.000Z",27.4,3,"2026-11-17T08:00:00.000Z",28.2,"2026-11-17T07:00:00.000Z",8.7,1,"2026-11-17T06:00:00.000Z","2026-11-17T05:00:00.000Z",9.2,"2026-11-17T04:00:00.000Z",9.5,"2026-11-17T03:00:00.000Z",9.8,{"_152":210,"_13":32,"_29":211,"_156":212,"_158":24,"_159":160},{"_152":204,"_13":205,"_29":206,"_156":207,"_158":208,"_159":160},{"_152":198,"_13":199,"_29":200,"_156":201,"_158":202,"_159":160},{"_152":192,"_13":193,"_29":194,"_156":195,"_158":196,"_159":160},{"_152":186,"_13":187,"_29":188,"_156":189,"_158":190,"_159":160},{"_152":180,"_13":181,"_29":182,"_156":183,"_158":184,"_159":160},{"_152":174,"_13":175,"_29":176,"_156":177,"_158":178,"_159":163},{"_152":168,"_13":169,"_29":170,"_156":171,"_158":172,"_159":160},{"_152":164,"_13":165,"_29":166,"_156":167,"_158":22,"_159":160},{"_152":153,"_13":154,"_29":155,"_156":157,"_158":22,"_159":160},"id","tvs6exzawu0oqyj6rlkve6tph","Optimizely 供应链攻击向 CNN、BBC、Salesforce 等网站注入恶意 JavaScript","攻击者利用 Optimizely Experimentation 账户注册流程中的漏洞，向客户项目注入恶意 JavaScript，导致 CNN、Fox News、BBC、Salesforce、Zoom、GitLab 等网站加载恶意脚本。","source",{"_57":161,"_162":163},"publishedAt","selected",true,"BleepingComputer","firstParty",false,"phv700fvsli1psqxao3lpbtc4","Optimizely 供应链攻击向 178 家机构网站注入恶意 JavaScript","疑似针对 Optimizely 的供应链攻击将恶意 JavaScript 注入其 CDN，使 Zoom、CNN、BBC、Salesforce、GitLab 等网站加载或尝试加载恶意脚本。",{"_57":161,"_162":163},"rg1csf97k0i3k1hqtq4d0b912","Optimizely 脚本遭劫持，CNN、BBC 与 Zoom 等 178 个组织站点被植入盗卡和 iOS Exploit Kit","攻击者利用 Optimizely Web Experimentation 漏洞，在客户项目的 Project JavaScript 中植入恶意加载器，至少 178 个组织的网站因此向访客分发加密钱包地址替换、卡号窃取和 iOS Exploit Kit。",{"_57":173,"_162":163},"2026-11-17T07:12:13.000Z","The Hacker News","k6cbozyl8rsjynhkcg4e9sjrq","178 个网站被植入隐藏恶意代码，Zoom、IKEA、HSBC 在列","攻击者利用某个网站优化平台发起攻击，导致 178 个网站被植入隐藏恶意代码，受影响的知名站点包括 Zoom、IKEA 和 HSBC。原文披露的攻击入口是网站优化平台本身，而非直接针对上述品牌站点；除受影响站点数量与举例品牌外，尚未给出具体漏洞编号、CVSS 评分、是否需要认证或是否有补丁等信息。被用于开展攻击的平台名称、恶意代码具体行为及处置建议在原文正文中未予说明。",{"_57":179,"_162":163},"2026-11-17T07:48:00.000Z","Cybernews","cpozl5byqasqocx0exg64utib","攻击者劫持 Optimizely Web Experimentation 脚本，178 家组织网站遭注入","攻击者利用 Optimizely Web Experimentation 漏洞，将恶意 JavaScript 注入 178 家组织的项目，影响 Zoom、BBC、CNN、Salesforce、GitLab、IKEA、HSBC、Equifax 等网站。",{"_57":185,"_162":163},"2026-11-17T09:38:44.000Z","Security Affairs","jrs4xw121uf8rdtavbl1ep3dh","Optimizely 漏洞遭在野利用，188 个脚本向 178 家组织投放恶意代码","Optimizely Experimentation 漏洞已被未经授权方用于向客户项目注入恶意 JavaScript，受影响网站向访客投放恶意软件。Report URI 检查 1,611 个 Optimizely 脚本，发现 188 个被感染，涉及 178 家组织，包括 BBC、CNN、Zoom、GitLab、Salesforce、Equifax、HSBC 和 IKEA。",{"_57":191,"_162":163},"2026-11-17T10:22:20.000Z","SecurityWeek","dldb8s3jmgy4xuk36zh3fhbhw","攻击者滥用 Optimizely 脚本向 178 家组织网站访客投放恶意代码","攻击者修改 Optimizely 客户项目的 Project JavaScript，使原本可信的脚本文件从 1688360.cc 加载恶意代码，向网站访客投放窃取支付卡信息、替换加密货币地址和投递 iOS exploit 的组件。",{"_57":197,"_162":163},"2026-11-17T10:44:45.000Z","Hackread","e6m9a0sestmukw6hfg0d10rpo","Optimizely 漏洞注入恶意 JavaScript，影响 178 家组织","攻击者利用 Optimizely Web 实验平台的漏洞，向 178 家组织的网站注入恶意 JavaScript；检查的 1,611 个代码片段中有 188 个携带恶意载荷，受害者以银行和金融机构为主。",{"_57":203,"_162":163},"2026-11-17T11:53:40.000Z","Help Net Security","ck7iv2whek2uhge1edo8r4tg2","Optimizely Experimentation 漏洞遭利用，178 家组织网站被植入恶意代码","攻击者利用 Optimizely Experimentation 漏洞向客户项目植入 JavaScript，影响 178 家组织的网站访问者，包括 Zoom、BBC、CNN、Salesforce、GitLab、IKEA 和 Optimizely 本身。",{"_57":209,"_162":163},"2026-11-17T13:45:00.000Z","Infosecurity Magazine","h9tqmhar36wrdbyk51hi1mcab","攻击者于 2026 年 11 月 16 日利用 Optimizely Web Experimentation 平台漏洞，在客户账户的 custom Project JavaScript 字段注入恶意代码，至少 178 家组织的网站经合法 CDN 和厂商证书向访客分发。",{"_57":213,"_162":163},"Unit 42",{"_216":222,"_13":223,"_21":178,"_17":134,"_219":224},{"_216":217,"_13":218,"_21":22,"_17":20,"_219":220},"factId","f_DAGfE6W8cI","Optimizely供应链攻击注入恶意脚本","representative",{"_152":180,"_13":181,"_29":182,"_156":221,"_158":184,"_159":160},{"_57":185,"_162":163},"fY9vAscgKzuU","178家网站被隐藏恶意软件感染",{"_152":174,"_13":175,"_29":176,"_156":225,"_158":178,"_159":163},{"_57":179,"_162":163},"participants48h","newParticipants6h","recentReports24h","observationComplete","rank",{"_232":233,"_234":-5},"changelogVersion","2026-10-01T08:00","release"]
