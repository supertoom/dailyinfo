[{"_1":2,"_3":4},"root",{"_5":328},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":-5,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48},"expiresAt",1795048843000,"publicId","9c6cfeee-afca-48bc-9a37-6ffde4a1dd7e","title","Optimizely漏洞遭利用，178家组织站点被注入恶意脚本","status","active","reportCount",13,"sourceCount",12,"firstReportAt","2026-11-17T02:12:17.000Z","latestAt","2026-11-18T05:00:00.000Z","digest","Optimizely 已修复 Web Experimentation 平台漏洞并清除注入代码、锁定受影响账户；Report URI 检查的 1,611 个脚本片段中有 188 个受感染，涉及至少 178 家组织，真实受影响机构数量可能更高，BBC、CNN、Zoom、Salesforce、GitLab、IKEA、HSBC 等站点曾通过 Optimizely 合法 CDN 向访客分发恶意脚本。\n\nUnit 42 将攻击称为“OPTIMJACK”，称攻击者于 2026 年 11 月 16 日利用客户账户的 custom Project JavaScript 字段注入代码。载荷可替换加密货币钱包地址、窃取支付卡信息、Cookie 和截图，并向 iPhone、iPad 投递 Coruna（针对 iOS 13.0 至 17.2.1）和 DarkSword（针对 iOS 18.4 至 18.7）漏洞利用工具；该模块不能读取跨源支付 iframe 内的卡片字段。\n\nOptimizely 称事件已完全处置，仍与第三方专家调查；攻击者如何同时修改众多互不相关客户项目尚无定论，可能涉及平台被攻陷、跨客户凭证或其他途径。成功入侵的设备及被盗支付记录数量仍未知，公开扫描只能证明代码或利用页面被投递。报道未披露 CVE 编号、CVSS 评分或具体修复版本。","digestUpdatedAt","2026-11-18T13:36:22.492Z","summary","excerpt","latest","Optimizely 第三方脚本遭注入，178 家组织的浏览器会话面临窃密风险","latestReport",{"_229":305},"whyHot",{"_321":20,"_322":323,"_324":325,"_326":237,"_327":325},"developments",[309,310],"officialReports",[],"timeline",[216,217,218,219,220,221,222,223,224,225,226,227,228],"heat",[69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114],"related",[],"topics",[49,50,51,52,53,54],{"_55":67,"_57":68},{"_55":65,"_57":66},{"_55":63,"_57":64},{"_55":61,"_57":62},{"_55":59,"_57":60},{"_55":56,"_57":58},"slug","browser","name","浏览器","malware","恶意软件","black-market","数据窃取与黑产","ransomware","勒索软件","supply-chain","供应链安全","attack","攻击活动",{"_115":214,"_43":215,"_118":208},{"_115":212,"_43":213,"_118":208},{"_115":210,"_43":211,"_118":208},{"_115":20