[{"_1":2,"_3":4},"root",{"_5":294},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795308047000,"publicId","025cdb74-de65-41e4-94e6-9d32e7d30d8d","title","TfL Photocard入侵波及约26.5万人","status","watching","reportCount",4,"sourceCount","firstReportAt","2026-11-19T11:35:00.000Z","latestAt","2026-11-20T11:31:36.000Z","digest","Transport for London（TfL）称，未经授权者入侵Oyster Photocard系统，从其邮件系统向客户发送创建账户的钓鱼邮件；约265,000名客户的姓名、电话、邮箱、住址、出生日期及安全问题和答案可能被访问。TfL已将Photocard系统下线，事件未扩展至其他网站和服务；最新报道援引当局说法称事件已被控制，但调查尚未结束，受影响人数可能增加。\n\nTfL目前评估密码、银行及支付卡资料、出行记录、Zip Oyster儿童卡持有者姓名和出生日期，以及照片和证明文件副本未被泄露，暂未发现数据被滥用；TfL要求收件人忽略相关邮件，并更改密码、安全问题及答案，同时已通知英国ICO。","digestUpdatedAt","2026-11-20T12:21:49.187Z","summary","excerpt","latest","伦敦公共交通再遭网络攻击，265K 名 Oyster photocard 用户数据暴露","latestReport",{"_252":276},"whyHot",{"_287":127,"_288":289,"_290":289,"_291":268,"_292":293},"developments",[280],"officialReports",[],"timeline",[248,249,250,251],"heat",[62,63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122],"related",[],"topics",[48,49,50,51],{"_52":60,"_54":61},{"_52":58,"_54":59},{"_52":56,"_54":57},{"_52":53,"_54":55},"slug","incident","name","应急响应","email","邮件与钓鱼","identity","身份与访问","attack","攻击活动",{"_123":246,"_42":247,"_126":235},{"_123":244,"_42":245,"_126":235},{"_123":242,"_42":243,"_126":235},{"_123":240,"_42":241,"_126":235},{"_123":238,"_42":239,"_126":235},{"_123":236,"_42":237,"_126":235},{"_123":233,"_42":234,"_126":235},{"_123":231,"_42":232,"_126":127},{"_123":229,"_42":230,"_126":127},{"_123":227,"_42":228,"_126":127},{"_123":225,"_42":226,"_126":127},{"_123":223,"_42":224,"_126":127},{"_123":221,"_42":222,"_126":127},{"_123":219,"_42":220,"_126":