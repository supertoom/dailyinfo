[{"_1":2,"_3":4},"root",{"_5":136},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795135249000,"publicId","025cdb74-de65-41e4-94e6-9d32e7d30d8d","title","TfL约26.5万Photocard账户数据泄露","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-19T11:35:00.000Z","latestAt","2026-11-19T18:20:01.000Z","digest","Transport for London（TfL）披露，其邮件系统在2026年11月16日遭入侵，未经授权者向Oyster Photocard客户发送要求创建账户的邮件，约265,000名客户的姓名、电话、邮箱、住址、出生日期及安全问题和答案可能泄露；调查尚未结束，实际影响人数可能继续增加。\n\nTfL目前评估，密码、银行及支付卡资料、出行记录，以及Zip Oyster儿童卡持有者的姓名和出生日期未被泄露，暂未发现受影响数据被滥用。TfL要求客户忽略该邮件并更改密码、安全问题及答案，同时已通知英国数据保护监管机构ICO。","digestUpdatedAt","2026-11-19T18:50:51.787Z","summary","excerpt","latest","Transport for London 数据泄露事件或影响约 265,000 名 Oyster photocard 用户","latestReport",{"_106":117},"whyHot",{"_129":18,"_130":131,"_132":18,"_133":120,"_134":135},"developments",[122],"officialReports",[],"timeline",[104,105],"heat",[62,63,64,65,66,67,68,69,70,71,72,73,74],"related",[],"topics",[48,49,50,51],{"_52":60,"_54":61},{"_52":58,"_54":59},{"_52":56,"_54":57},{"_52":53,"_54":55},"slug","incident","name","应急响应","attack","攻击活动","email","邮件与钓鱼","identity","身份与访问",{"_75":102,"_42":103,"_78":91},{"_75":100,"_42":101,"_78":91},{"_75":98,"_42":99,"_78":91},{"_75":96,"_42":97,"_78":91},{"_75":94,"_42":95,"_78":91},{"_75":92,"_42":93,"_78":91},{"_75":89,"_42":90,"_78":91},{"_75":87,"_42":88,"_78":18},{"_75":85,"_42":86,"_78":18},{"_75":83,"_42":84,"_78":18},{"_75":81,"_42":82,"_78":18},{"_75":79,"_42":80,"_78":18},{"_75":76,"_42":77,"_78":18},"hour","2026-11-20T00:00:00.000Z",15.5,"participants","2026-11-19T23:00:00.000Z",15.9,"2026-11-19T22:00:00.000Z",16.4,"2026-11-19T21:00:00.000Z",16.9,"2026-11-19T20:00:00.000Z",17.4,"2026-11-19T19:00:00.000Z",17.9,"2026-11-19T18:00:00.000Z",8.3,1,"2026-11-19T17:00:00.000Z",8.6,"2026-11-19T16:00:00.000Z",8.8,"2026-11-19T15:00:00.000Z",9.1,"2026-11-19T14:00:00.000Z",9.3,"2026-11-19T13:00:00.000Z",9.6,"2026-11-19T12:00:00.000Z",9.9,{"_106":117,"_13":31,"_28":118,"_110":119,"_112":23,"_113":120},{"_106":107,"_13":108,"_28":109,"_110":111,"_112":21,"_113":114},"id","cnqgtquav16v4wc5n64iedzrp","TfL 警告约 265,000 名 Oyster Photocard 客户账户数据可能遭泄露","Transport for London（TfL）称，11 月 16 日未经授权者利用其系统向 Oyster Photocard 客户发送要求创建账户的邮件，约 265,000 名客户的账户详情可能已被攻破，可能涉及 5-18 岁儿童及 18+ Student Oyster 等卡类。","source",{"_54":115,"_116":114},"publishedAt","selected",false,"Infosecurity Magazine","firstParty","d6dgg3e2wnqye3hjidrccizxr","Transport for London 称，约 265,000 名 Oyster photocard 客户的姓名、电话、邮箱、住址、出生日期及安全问题和答案可能因系统入侵而泄露，密码、银行和支付卡资料等信息暂未发现被攻破。",{"_54":121,"_116":114},true,"BleepingComputer",{"_123":124,"_13":125,"_20":21,"_17":18,"_126":127},"factId","fvQXkO3cEDDk","TfL披露 photocard客户数据泄露","representative",{"_106":117,"_13":31,"_28":118,"_110":128,"_112":23,"_113":120},{"_54":121,"_116":114},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",10,{"_137":138,"_139":-5},"changelogVersion","2026-10-01T08:00","release"]
