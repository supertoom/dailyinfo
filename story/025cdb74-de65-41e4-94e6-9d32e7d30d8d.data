[{"_1":2,"_3":4},"root",{"_5":223},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795221647000,"publicId","025cdb74-de65-41e4-94e6-9d32e7d30d8d","title","TfL Photocard入侵波及约26.5万人","status","active","reportCount",4,"sourceCount","firstReportAt","2026-11-19T11:35:00.000Z","latestAt","2026-11-20T11:31:36.000Z","digest","Transport for London（TfL）称，未经授权者入侵Oyster Photocard系统，从其邮件系统向客户发送创建账户的钓鱼邮件；约265,000名客户的姓名、电话、邮箱、住址、出生日期及安全问题和答案可能被访问。TfL已将Photocard系统下线，事件未扩展至其他网站和服务；最新报道援引当局说法称事件已被控制，但调查尚未结束，受影响人数可能增加。\n\nTfL目前评估密码、银行及支付卡资料、出行记录、Zip Oyster儿童卡持有者姓名和出生日期，以及照片和证明文件副本未被泄露，暂未发现数据被滥用；TfL要求收件人忽略相关邮件，并更改密码、安全问题及答案，同时已通知英国ICO。","digestUpdatedAt","2026-11-20T12:21:49.187Z","summary","excerpt","latest","伦敦公共交通再遭网络攻击，265K 名 Oyster photocard 用户数据暴露","latestReport",{"_182":206},"whyHot",{"_217":18,"_218":219,"_220":132,"_221":198,"_222":18},"developments",[210],"officialReports",[],"timeline",[178,179,180,181],"heat",[62,63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98],"related",[],"topics",[48,49,50,51],{"_52":60,"_54":61},{"_52":58,"_54":59},{"_52":56,"_54":57},{"_52":53,"_54":55},"slug","incident","name","应急响应","email","邮件与钓鱼","identity","身份与访问","attack","攻击活动",{"_99":176,"_42":177,"_102":165},{"_99":174,"_42":175,"_102":165},{"_99":172,"_42":173,"_102":165},{"_99":170,"_42":171,"_102":165},{"_99":168,"_42":169,"_102":165},{"_99":166,"_42":167,"_102":165},{"_99":163,"_42":164,"_102":165},{"_99":161,"_42":162,"_102":132},{"_99":159,"_42":160,"_102":132},{"_99":157,"_42":158,"_102":132},{"_99":155,"_42":156,"_102":132},{"_99":153,"_42":154,"_102":132},{"_99":151,"_42":152,"_102":132},{"_99":149,"_42":150,"_102":132},{"_99":147,"_42":148,"_102":132},{"_99":145,"_42":146,"_102":132},{"_99":143,"_42":144,"_102":132},{"_99":14