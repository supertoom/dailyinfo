[{"_1":2,"_3":4},"root",{"_5":481},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":-5,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48},"expiresAt",1794616838000,"publicId","ed4db3d6-dbb8-43e7-b004-fff9ac19f4ca","title","4EverAble2Shell已攻陷21台N-central服务器","status","active","reportCount",14,"sourceCount",7,"firstReportAt","2026-11-09T21:26:25.000Z","latestAt","2026-11-13T07:20:50.000Z","digest","Huntback确认，攻击者在Sean Bales公开4EverAble2Shell PoC约5小时后，利用未认证远程代码执行链攻陷至少21台N-central生产服务器，其中19台已安装Hotfix 2（2026.4.1.26）。攻击链下载shell脚本并部署XMRig Monero挖矿程序；目前仅观察到该载荷，但攻击者已取得可管理客户终端主机的root权限。\n\nSean Bales称，利用要求启用Legacy API；该功能默认关闭且官方不建议使用，托管环境不受影响。此前N-able称尚无客户环境被成功利用、仅有扫描活动；Huntback的后续观测则确认已发生实际利用。N-able已发布N-central 2026.4 HF2，修复CVE-2026-125883、CVE-2026-125878、CVE-2026-125879、CVE-2026-125880、CVE-2026-125881、CVE-2026-125882和CVE-2026-91000，但仅安装热修复不足以消除该漏洞风险；厂商建议部署继续下线，按升级指引修复后再恢复访问。","digestUpdatedAt","2026-11-13T08:01:52.333Z","summary","excerpt","latest","攻击者在 4EverAble2Shell PoC 发布数小时后利用 N-able N-central 漏洞","latestReport",{"_365":443},"whyHot",{"_475":172,"_476":477,"_478":330,"_479":373,"_480":20},"developments",[448,449,450,451,452],"officialReports",[446],"timeline",[351,352,353,354,355,356,357,358,359,360,361,362,363,364],"heat",[69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130,131,132,133,134,135,136,137,138,139,140,141,142,143,144,145,146,147,148,149,150,151,152,153,154,155,156,157,158,159,160,161,162,163,164,165,166,167],"related",[],"topics",[49,50,51,52,53,54],{"_55":67,"_57":68},{"_55":65,"_57":66},{"_55":63,"_57":64},{"_55":61,"_57":62},{"_55":59,"_57":60},{"_55":56,"_57":58},"slug","research","name","技术研究","attack","攻击活动","vuln-mgmt","漏洞管理","incident","应急响应","exploited"