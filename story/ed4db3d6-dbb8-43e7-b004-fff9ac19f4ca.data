[{"_1":2,"_3":4},"root",{"_5":315},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":-5,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48},"expiresAt",1794444103000,"publicId","ed4db3d6-dbb8-43e7-b004-fff9ac19f4ca","title","N-able发布N-central关键漏洞热修复","status","active","reportCount",9,"sourceCount",7,"firstReportAt","2026-11-09T21:26:25.000Z","latestAt","2026-11-11T20:05:18.000Z","digest","N-able已为N-central发布2026.4 HF2安全热修复，涵盖CVE-2026-125883、CVE-2026-125878、CVE-2026-125879、CVE-2026-125880、CVE-2026-125881、CVE-2026-125882和CVE-2026-91000，其中包括最关键的漏洞。厂商尚未确认客户环境遭到成功利用，但已发现与公开PoC相关的互联网扫描；客户须按升级指南操作后再恢复N-central访问。\n\n独立研究员Sean Bales称，33个问题已在预发布版N-central Appliance 2026.4.0.31上验证，可能影响多数或全部更早版本。最关键的利用链结合未认证XXE与会话处理缺陷，可窃取可信本地会话、重置账户密码，并以nable用户身份执行命令；厂商此前将托管N-central经典环境下线并建议本地部署保持离线。Dark Reading所称“已有公开利用”指利用代码公开，不能证明漏洞已在真实攻击中被成功利用。","digestUpdatedAt","2026-11-11T21:46:40.910Z","summary","excerpt","latest","N-able因发现33个漏洞暂停N-central平台服务并发布hotfix","latestReport",{"_235":287},"whyHot",{"_310":124,"_311":210,"_312":206,"_313":243,"_314":206},"developments",[293,294,295],"officialReports",[291],"timeline",[226,227,228,229,230,231,232,233,234],"heat",[69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119],"related",[],"topics",[49,50,51,52,53,54],{"_55":67,"_57":68},{"_55":65,"_57":66},{"_55":63,"_57":64},{"_55":61,"_57":62},{"_55":59,"_57":60},{"_55":56,"_57":58},"slug","research","name","技术研究","rapid7","Rapid7 / Metasploit","vuln-mgmt","漏洞管理","incident","应急响应","exploited","在野利用","vuln","漏洞披露",{"_120":224,"_43":225,"_123":210},{"_120":222,"_43":223,"_123":210},{"_120":220,"_43":221,"_123":210},{"_120":219,"_43":18,"_123":210},{"_120":217,"_43":218,"_123":210},{"_120":215,"_43":216,"_123":210},{"_120":213,"_43":214,"_123":210},{"_120"