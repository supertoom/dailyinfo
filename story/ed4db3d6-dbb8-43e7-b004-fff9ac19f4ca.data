[{"_1":2,"_3":4},"root",{"_5":201},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794357648000,"publicId","ed4db3d6-dbb8-43e7-b004-fff9ac19f4ca","title","N-able 因 33 个零日漏洞下线托管 N-central","status","active","reportCount",4,"sourceCount","firstReportAt","2026-11-09T21:26:25.000Z","latestAt","2026-11-10T14:20:34.000Z","digest","独立安全研究员 Sean Bales 公开披露 N-able N-central 33 个疑似零日漏洞，并在 GitHub 以 Able2Shell 名义发布概念验证利用代码，漏洞类型包括未认证 XXE、认证绕过、凭据泄露、任意文件写入、目录遍历、XSS、远程代码执行和提权；问题是在预发布版 N-central Appliance 2026.4.0.31 上验证，Bales 称多数或全部漏洞可能同样影响更早版本。其中一条利用链利用 service-import 功能的未认证 XXE 窃取受信本地会话、重置账户密码，并以 nable 用户身份在服务器上执行命令，Hacker News 称成功利用可获得管理接口的非法管理员权限并以 root 执行命令。\n\nN-able 称尚未观察到这些漏洞被积极利用；11 月 10 日通报称已监测到与公开 PoC 相关的扫描活动，但没有证据显示任何客户环境被成功利用。厂商已于 11 月 9 日全球下线 Hosted N-central 经典环境，并建议本地部署 N-central 服务器的客户暂时下线服务器，托管环境目前仍处离线状态，hotfix 仍在开发与验证中，尚未公布修复版本和发布日期。","digestUpdatedAt","2026-11-10T14:52:33.464Z","summary","excerpt","latest","N-able N-central 披露 33 个严重漏洞，含未认证 RCE 利用链","latestReport",{"_158":182},"whyHot",{"_195":99,"_196":197,"_198":120,"_199":166,"_200":139},"developments",[188],"officialReports",[186],"timeline",[154,155,156,157],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","research","name","技术研究","rapid7","Rapid7 / Metasploit","exploited","在野利用","vuln-mgmt","漏洞管理","incident","应急响应","vuln","漏洞披露",{"_95":152,"_42":153,"_98":137},{"_95":150,"_42":151,"_98":137},{"_95":148,"_42":149,"_98":137},{"_95":146,"_42":147,"_98":137},{"_95":144,"_42":145,"_98":137},{"_95":142,"_42":143,"_98":137},{"_95":140,"_42":141,"_98":137},{"_95":138,"_42":139,"_98":137},{"_95":135,"_42":136,"_98":137},{"_95":133,"_42":134,"_98":120},{"_95":131,"_42":132,"_98":120},{"_95":129,"_42":130,"_98":120},{"_95":127,"_42":128,"_98":120},{"_95":125,"_42":126,"_98":120},{"_95":123,"_42":124,"_98":120},{"_95":121,"_42":122,"_98":120},{"_95":118,"_42":119,"_98":120},{"_95":116,"_42":117,"_98":99},{"_95":114,"_42":115,"_98":99},{"_95":112,"_42":113,"_98":99},{"_95":110,"_42":111,"_98":99},{"_95":108,"_42":109,"_98":99},{"_95":106,"_42":107,"_98":99},{"_95":104,"_42":105,"_98":99},{"_95":102,"_42":103,"_98":99},{"_95":100,"_42":101,"_98":99},{"_95":96,"_42":97,"_98":99},"hour","2026-11-11T00:00:00.000Z",18.3,"participants",3,"2026-11-10T23:00:00.000Z",18.8,"2026-11-10T22:00:00.000Z",19.4,"2026-11-10T21:00:00.000Z",19.9,"2026-11-10T20:00:00.000Z",20.5,"2026-11-10T19:00:00.000Z",21.1,"2026-11-10T18:00:00.000Z",21.7,"2026-11-10T17:00:00.000Z",22.4,"2026-11-10T16:00:00.000Z",23,"2026-11-10T15:00:00.000Z",23.7,"2026-11-10T14:00:00.000Z",14.3,2,"2026-11-10T13:00:00.000Z",14.7,"2026-11-10T12:00:00.000Z",15.2,"2026-11-10T11:00:00.000Z",15.6,"2026-11-10T10:00:00.000Z",16.1,"2026-11-10T09:00:00.000Z",16.5,"2026-11-10T08:00:00.000Z",17,"2026-11-10T07:00:00.000Z",17.5,"2026-11-10T06:00:00.000Z",7.8,1,"2026-11-10T05:00:00.000Z",8,"2026-11-10T04:00:00.000Z",8.3,"2026-11-10T03:00:00.000Z",8.5,"2026-11-10T02:00:00.000Z",8.8,"2026-11-10T01:00:00.000Z",9,"2026-11-10T00:00:00.000Z",9.3,"2026-11-09T23:00:00.000Z",9.6,"2026-11-09T22:00:00.000Z",9.8,{"_158":182,"_13":31,"_28":183,"_162":184,"_164":23,"_165":166},{"_158":176,"_13":177,"_28":178,"_162":179,"_164":180,"_165":169},{"_158":170,"_13":171,"_28":172,"_162":173,"_164":174,"_165":166},{"_158":159,"_13":160,"_28":161,"_162":163,"_164":21,"_165":166},"id","g8lommzdv7g4jq6hsbkd50oer","N-able 公开 N-central 30 余项零日漏洞，厂商全球下线托管环境","安全研究员 Sean Bales 公开 N-central 30 余项疑似零日漏洞及 Able2Shell PoC，涵盖认证绕过、凭据泄露、任意文件写入、XSS、XXE、远程代码执行和提权。","source",{"_56":167,"_168":169},"publishedAt","selected",true,"BleepingComputer","firstParty",false,"d8zcuvctecnec3ehugdplchy6","N-able 披露 N-central 33 个漏洞并下线托管环境","独立安全研究员 Sean Bales 披露 N-central 30 多个漏洞，并公开 PoC exploits；问题在 N-able N-central Appliance 2026.4.0.31 上测试，涉及凭据泄露、任意文件写入、目录遍历、XSS、XXE 和 RCE，可导致匿名窃取凭据、创建管理员及以 root 执行命令。",{"_56":175,"_168":169},"2026-11-10T06:44:36.000Z","The Hacker News","kdz2kbhia49t1hysnq6pjezss","Sean Bales 披露 N-central 超 30 个未分配 CVE 漏洞，N-able 暂时下线托管环境","Sean Bales 在 GitHub 披露 N-able N-central 超过 30 个尚未分配 CVE 编号的漏洞，并命名为 Able2Shell；其称漏洞可实现具备 ‘nable’ 或 root 权限的 RCE、执行任意命令、创建未授权管理员账户及泄露配置和凭据，另有 4 条可导致提权 RCE 的利用链。",{"_56":181,"_168":169},"2026-11-10T09:56:28.000Z","SecurityWeek","bascdi2f6ns6cy5dhtip9c0qp","N-able N-central 远程监控与管理平台被披露存在 33 个严重问题，包括未认证远程代码执行（RCE）、提权至 root、凭据泄露和未授权账户创建，独立研究员已发布 PoC；其中一条利用链结合 XXE 与会话处理缺陷，以 nable 服务账户执行代码。",{"_56":185,"_168":166},"Rapid7 CVE 公告",{"_158":182,"_13":31,"_28":183,"_162":187,"_164":23,"_165":166},{"_56":185,"_168":166},{"_189":190,"_13":191,"_20":21,"_17":99,"_192":193},"factId","fEvZARAZeeVY","N-central逾30个零日漏洞被公开","representative",{"_158":182,"_13":31,"_28":183,"_162":194,"_164":23,"_165":166},{"_56":185,"_168":166},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",{"_202":203,"_204":-5},"changelogVersion","2026-10-01T08:00","release"]
