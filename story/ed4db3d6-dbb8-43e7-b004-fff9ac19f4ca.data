[{"_1":2,"_3":4},"root",{"_5":409},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":-5,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48},"expiresAt",1794530497000,"publicId","ed4db3d6-dbb8-43e7-b004-fff9ac19f4ca","title","N-central热修复后4EverAble2Shell已被利用","status","active","reportCount",12,"sourceCount",7,"firstReportAt","2026-11-09T21:26:25.000Z","latestAt","2026-11-12T19:51:16.000Z","digest","N-able为N-central 2026.4 HF2热修复所涉CVE-2026-125883、CVE-2026-125878、CVE-2026-125879、CVE-2026-125880、CVE-2026-125881、CVE-2026-125882和CVE-2026-91000发布补丁后，4EverAble2Shell与Agent2Shell的PoC仍被证实可攻击N-central 2026.4 Hotfix 2（build 2026.4.1.26）。Huntback称攻击者已利用4EverAble2Shell攻陷至少21台生产N-central服务器，其中19台运行2026.4.1.26；此前N-able尚称未发现成功利用，目前确认已有在野利用。\n\n4EverAble2Shell可在未认证情况下以root执行命令，但Sean Bales称需启用Legacy API；该功能默认关闭且官方不建议使用，托管环境不受影响。已观察到的攻击通过利用链下载脚本并安装XMRig挖矿程序。N-able建议部署继续下线，按升级指引修复后再恢复访问。","digestUpdatedAt","2026-11-12T20:08:55.023Z","summary","excerpt","latest","N-able N-central 4EverAble2Shell 零日漏洞已被利用，21 台服务器失陷","latestReport",{"_303":371},"whyHot",{"_403":148,"_404":405,"_406":270,"_407":311,"_408":186},"developments",[376,377,378,379,380],"officialReports",[374],"timeline",[291,292,293,294,295,296,297,298,299,300,301,302],"heat",[69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130,131,132,133,134,135,136,137,138,139,140,141,142,143],"related",[],"topics",[49,50,51,52,53,54],{"_55":67,"_57":68},{"_55":65,"_57":66},{"_55":63,"_57":64},{"_55":61,"_57":62},{"_55":59,"_57":60},{"_55":56,"_57":58},"slug","rapid7","name","Rapid7 / Metasploit","research","技术研究","vuln-mgmt","漏洞管理","incident","应急响应","exploited","在野利用","vuln","漏洞披露",{"_144":289,"_43":290,"_147":274},{"_144":287,"_43":288,"_147":274},{"