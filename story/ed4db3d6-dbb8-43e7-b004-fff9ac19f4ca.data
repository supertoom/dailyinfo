,"2026-11-10T12:00:00.000Z","2026-11-10T11:00:00.000Z","2026-11-10T10:00:00.000Z",25.7,"2026-11-10T09:00:00.000Z","2026-11-10T08:00:00.000Z",2,"2026-11-10T07:00:00.000Z","2026-11-10T06:00:00.000Z",7.8,1,"2026-11-10T05:00:00.000Z",8,"2026-11-10T04:00:00.000Z",8.3,"2026-11-10T03:00:00.000Z",8.5,"2026-11-10T02:00:00.000Z",8.8,"2026-11-10T01:00:00.000Z",9,"2026-11-10T00:00:00.000Z",9.3,"2026-11-09T23:00:00.000Z",9.6,"2026-11-09T22:00:00.000Z",9.8,{"_365":443,"_13":32,"_29":444,"_369":445,"_371":24,"_372":373},{"_365":438,"_13":439,"_29":440,"_369":441,"_371":442,"_372":373},{"_365":433,"_13":434,"_29":435,"_369":436,"_371":437,"_372":373},{"_365":428,"_13":429,"_29":430,"_369":431,"_371":432,"_372":373},{"_365":423,"_13":424,"_29":425,"_369":426,"_371":427,"_372":373},{"_365":417,"_13":418,"_29":419,"_369":420,"_371":421,"_372":376},{"_365":411,"_13":412,"_29":413,"_369":414,"_371":415,"_372":373},{"_365":406,"_13":407,"_29":408,"_369":409,"_371":410,"_372":376},{"_365":401,"_13":402,"_29":403,"_369":404,"_371":405,"_372":373},{"_365":395,"_13":396,"_29":397,"_369":398,"_371":399,"_372":373},{"_365":389,"_13":390,"_29":391,"_369":392,"_371":393,"_372":376},{"_365":383,"_13":384,"_29":385,"_369":386,"_371":387,"_372":376},{"_365":377,"_13":378,"_29":379,"_369":380,"_371":381,"_372":373},{"_365":366,"_13":367,"_29":368,"_369":370,"_371":22,"_372":373},"id","g8lommzdv7g4jq6hsbkd50oer","N-able 公开 N-central 30 余项零日漏洞，厂商全球下线托管环境","安全研究员 Sean Bales 公开 N-central 30 余项疑似零日漏洞及 Able2Shell PoC，涵盖认证绕过、凭据泄露、任意文件写入、XSS、XXE、远程代码执行和提权。","source",{"_57":374,"_375":376},"publishedAt","selected",true,"BleepingComputer","firstParty",false,"d8zcuvctecnec3ehugdplchy6","N-able 披露 N-central 33 个漏洞并下线托管环境","独立安全研究员 Sean Bales 披露 N-central 30 多个漏洞，并公开 PoC exploits；问题在 N-able N-central Appliance 2026.4.0.31 上测试，涉及凭据泄露、任意文件写入、目录遍历、XSS、XXE 和 RCE，可导致匿名窃取凭据、创建管理员及以 root 执行命令。",{"_57":382,"_375":376},"2026-11-10T06:44:36.000Z","The Hacker News","owvaqrqlosnhwwqfyz2tmsfi7","N-able 披露 N-central 平台 33 个漏洞并停止服务","N-able 在披露 N-central 关键平台中的 33 个零日漏洞后终止该平台服务。摘要指出，攻击者入侵远程监控与管理（RMM）服务器后，可能借此访问众多客户系统，但未提供受影响版本、CVSS 分数、利用前提及补丁状态。",{"_57":388,"_375":376},"2026-11-10T08:54:25.000Z","Cybernews","kdz2kbhia49t1hysnq6pjezss","Sean Bales 披露 N-central 超 30 个未分配 CVE 漏洞，N-able 暂时下线托管环境","Sean Bales 在 GitHub 披露 N-able N-central 超过 30 个尚未分配 CVE 编号的漏洞，并命名为 Able2Shell；其称漏洞可实现具备 ‘nable’ 或 root 权限的 RCE、执行任意命令、创建未授权管理员账户及泄露配置和凭据，另有 4 条可导致提权 RCE 的利用链。",{"_57":394,"_375":376},"2026-11-10T09:56:28.000Z","SecurityWeek","bascdi2f6ns6cy5dhtip9c0qp","N-able N-central 披露 33 个严重漏洞，含未认证 RCE 利用链","N-able N-central 远程监控与管理平台被披露存在 33 个严重问题，包括未认证远程代码执行（RCE）、提权至 root、凭据泄露和未授权账户创建，独立研究员已发布 PoC；其中一条利用链结合 XXE 与会话处理缺陷，以 nable 服务账户执行代码。",{"_57":400,"_375":373},"2026-11-10T14:20:34.000Z","Rapid7 CVE 公告","mms1km0rggfxsxggiojfrk76b","N-able 为 N-central 多个漏洞发布 N-central 2026.4 HF2 热修复","N-able 为 N-central 远程监控与管理平台多个漏洞发布 N-central 2026.4 HF2，涉及 CVE-2026-125883、CVE-2026-125878、CVE-2026-125879、CVE-2026-125880、CVE-2026-125881、CVE-2026-125882 和 CVE-2026-91000。",{"_57":374,"_375":376},"2026-11-11T12:32:27.000Z","hmh9z2luuo1qqzf004qmtankt","Citrix 与 Ivanti 修复 19 个漏洞，CVE-2026-121653 CVSS 9.8","Citrix 与 Ivanti 发布 19 个漏洞的补丁，其中 Ivanti 修复 13 个，涉及 Cloud Services Application、Endpoint Manager、Sentry、EPMM 和 UWM。",{"_57":394,"_375":376},"2026-11-11T13:37:19.000Z","q5pk9i6wqjatjvkhjx8a5f75o","N-able 修复 N-central 7 个 CVE，33 个 Able2Shell 漏洞 PoC 已公开","N-able 为 N-central 发布 2026.4 Hotfix 2（build 2026.4.1.26），修复 CVE-2026-125883、CVE-2026-125878、CVE-2026-125879、CVE-2026-125880、CVE-2026-125881、CVE-2026-125882 和 CVE-2026-91000。",{"_57":416,"_375":376},"2026-11-11T17:15:00.000Z","Infosecurity Magazine","zpfhps9jklpclcpyiougoirpf","N-able 因 33 项漏洞将 N-central 平台下线并发布热修复","N-able 在发现 N-central 平台存在 33 项缺陷后将该平台下线，并发布热修复作为建议缓解措施。原文称这些 alleged zero-days 可导致攻击者接管系统，且已出现针对这些漏洞的公开利用。",{"_57":422,"_375":376},"2026-11-11T20:05:18.000Z","Dark Reading","q4w5xdxldiml1d6aadrdvueom","攻击者探测 N-central 漏洞，N-able 修复 7 项漏洞","攻击者正探测 N-central 暴露实例中的零日漏洞，N-able 已为 7 项可被利用的漏洞发布补丁，其中包括未认证缺失、XXE、SSRF、XSS、权限提升及路径遍历至 RCE。",{"_57":394,"_375":376},"2026-11-12T09:39:55.000Z","dtp3to82km6fv43pn6rwviy2e","N-central 4EverAble2Shell 与 Agent2Shell 暴露在野利用尝试","N-able 披露 N-central 2026.4.1 HF2 的新漏洞 4EverAble2Shell 与 Agent2Shell，PoC 已能攻击 2026.4 Hotfix 2（build 2026.4.1.26）。",{"_57":382,"_375":376},"2026-11-12T11:51:43.000Z","nfe40jld0azdyvkuu4pkr1p7u","N-able N-central 4EverAble2Shell 零日漏洞已被利用，21 台服务器失陷","攻击者已利用 N-able N-central 的 4EverAble2Shell 漏洞攻陷至少 21 台生产服务器，其中 19 台运行 2026.4.1.26。",{"_57":374,"_375":376},"2026-11-12T19:51:16.000Z","nxxq4crazs05wb4oacstt8ov2","攻击者利用N-able N-central 4EverAble2Shell漏洞入侵21台服务器并部署XMRig","攻击者已利用N-able N-central的4EverAble2Shell漏洞，在21台服务器上部署XMRig Monero挖矿程序，其中19台受害者已运行Hotfix 2。",{"_57":382,"_375":376},"2026-11-13T05:43:28.000Z","iqp27qc6nscqjdlpevv69i5l9","攻击者在 Sean Bales 于 November 12 发布 4EverAble2Shell PoC 后数小时内开始利用该漏洞，针对启用 Legacy API 的 N-able N-central 2026.4 HF2（build number 2026.4.1.26）实现 RCE 并尝试提权至 root、运行 shell 脚本。",{"_57":394,"_375":376},{"_365":395,"_13":396,"_29":397,"_369":447,"_371":399,"_372":373},{"_57":400,"_375":373},{"_453":471,"_13":472,"_21":437,"_17":172,"_456":473},{"_453":467,"_13":468,"_21":432,"_17":334,"_456":469},{"_453":463,"_13":464,"_21":405,"_17":334,"_456":465},{"_453":459,"_13":460,"_21":387,"_17":330,"_456":461},{"_453":454,"_13":455,"_21":22,"_17":172,"_456":457},"factId","fEvZARAZeeVY","N-central逾30个零日漏洞被公开","representative",{"_365":395,"_13":396,"_29":397,"_369":458,"_371":399,"_372":373},{"_57":400,"_375":373},"fOg_8eoOkG5E","N-able披露N-central的33个零日漏洞",{"_365":417,"_13":418,"_29":419,"_369":462,"_371":421,"_372":376},{"_57":422,"_375":376},"fFRopwzh6g8Q","N-able发布N-central零日漏洞热修复",{"_365":401,"_13":402,"_29":403,"_369":466,"_371":405,"_372":373},{"_57":374,"_375":376},"f1rJH6X62tv8","公开N-central新漏洞利用方式",{"_365":428,"_13":429,"_29":430,"_369":470,"_371":432,"_372":373},{"_57":382,"_375":376},"feTzrtc_-Ycc","攻击者利用N-able零日漏洞挖矿",{"_365":433,"_13":434,"_29":435,"_369":474,"_371":437,"_372":373},{"_57":374,"_375":376},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",{"_482":483,"_484":-5},"changelogVersion","2026-10-01T08:00","release"]
