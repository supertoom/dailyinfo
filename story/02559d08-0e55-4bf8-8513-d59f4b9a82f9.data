[{"_1":2,"_3":4},"root",{"_5":121},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794357648000,"publicId","02559d08-0e55-4bf8-8513-d59f4b9a82f9","title","Xen Orchestra认证绕过漏洞已遭在野利用","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-10T16:17:16.000Z","latestAt","2026-11-10T18:12:21.000Z","digest","Vates VMS确认，Xen Orchestra及Xen Orchestra Appliance（XOA）的认证绕过漏洞VSA-2026-062已遭在野利用；该漏洞尚无CVE编号。攻击者须能访问管理接口，可通过特制cookie绕过认证，获取Admin权限并取得可复用登录令牌，最终在XCP-ng节点上以root身份执行任意代码。\n\nVates已发布修复版本：稳定版6.9.1和最新版6.10.0，包含修复后的xo-server包5.211.2和5.213.1。Vates称，利用特制cookie不会在日志中留下相关标识，需通过HTTP监控发现；已公布的失陷指标仅适用于已知攻击活动，其他威胁行为者的指标可能不同。","digestUpdatedAt","2026-11-10T19:35:42.411Z","summary","excerpt","latest","Vates VMS 披露 Xen Orchestra 认证绕过漏洞 VSA-2026-062 已被利用","latestReport",{"_91":103},"whyHot",{"_114":18,"_115":116,"_117":18,"_118":99,"_119":120},"developments",[107],"officialReports",[],"timeline",[89,90],"heat",[62,63,64,65,66,67,68,69],"related",[],"topics",[48,49,50,51],{"_52":60,"_54":61},{"_52":58,"_54":59},{"_52":56,"_54":57},{"_52":53,"_54":55},"slug","research","name","技术研究","cloud-native","云与原生","exploited","在野利用","vuln","漏洞披露",{"_70":87,"_42":88,"_73":86},{"_70":84,"_42":85,"_73":86},{"_70":82,"_42":83,"_73":18},{"_70":80,"_42":81,"_73":18},{"_70":78,"_42":79,"_73":18},{"_70":76,"_42":77,"_73":18},{"_70":74,"_42":75,"_73":18},{"_70":71,"_42":72,"_73":18},"hour","2026-11-11T00:00:00.000Z",16.5,"participants","2026-11-10T23:00:00.000Z",16.9,"2026-11-10T22:00:00.000Z",17.4,"2026-11-10T21:00:00.000Z",18,"2026-11-10T20:00:00.000Z",18.5,"2026-11-10T19:00:00.000Z",19,"2026-11-10T18:00:00.000Z",9.5,1,"2026-11-10T17:00:00.000Z",9.8,{"_91":103,"_13":31,"_28":104,"_95":105,"_97":23,"_98":99},{"_91":92,"_13":93,"_28":94,"_95":96,"_97":21,"_98":99},"id","fqc2v3qokzbepchzvrfi4k1