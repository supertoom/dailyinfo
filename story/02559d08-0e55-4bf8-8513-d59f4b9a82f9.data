[{"_1":2,"_3":4},"root",{"_5":204},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794444103000,"publicId","02559d08-0e55-4bf8-8513-d59f4b9a82f9","title","Xen Orchestra认证绕过漏洞已遭利用","status","active","reportCount",3,"sourceCount","firstReportAt","2026-11-10T16:17:16.000Z","latestAt","2026-11-11T15:42:47.000Z","digest","Vates披露，Xen Orchestra及Xen Orchestra Appliance的认证绕过漏洞VSA-2026-062（尚无CVE编号）已遭在野利用。攻击者须能访问管理接口，可发送特制Cookie绕过REST认证并取得管理员权限及可复用登录令牌，随后在托管资源池执行任意代码，以root身份接管XCP-ng节点。\n\n受影响范围及修复版本存在更新：早先Vates称修复已包含在稳定版6.9.1和最新版6.10.0，以及xo-server 5.211.2和5.213.1；后续SecurityWeek称漏洞影响6.9.2稳定版和6.10.1最新版之前的版本及Xen Orchestra Appliance，表明此前公布的修复范围可能不完整。Vates称未授权访问通常不留日志，需通过HTTP监控发现；已公布失陷指标仅适用于已知攻击活动。","digestUpdatedAt","2026-11-11T16:14:33.490Z","summary","excerpt","latest","Xen Orchestra 严重漏洞已遭利用，可绕过认证并接管 XCP-ng 节点","latestReport",{"_168":186},"whyHot",{"_197":18,"_198":199,"_200":162,"_201":176,"_202":203},"developments",[190],"officialReports",[],"timeline",[165,166,167],"heat",[65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96],"related",[],"topics",[48,49,50,51,52],{"_53":63,"_55":64},{"_53":61,"_55":62},{"_53":59,"_55":60},{"_53":57,"_55":58},{"_53":54,"_55":56},"slug","research","name","技术研究","identity","身份与访问","cloud-native","云与原生","exploited","在野利用","vuln","漏洞披露",{"_97":163,"_42":164,"_100":162},{"_97":160,"_42":161,"_100":162},{"_97":158,"_42":159,"_100":119},{"_97":156,"_42":157,"_100":119},{"_97":154,"_42":155,"_100":119},{"_97":152,"_42":153,"_100":119},{"_97":150,"_42":151,"_100":119},{"_97":148,"_42":149,"_100":119},{"_97":146,"_42":147,"_100":119},{"_97":144,"_42":145,"_100":119},{"_97":142,"_42":143,"_100":119},{"_97":140,"_42":141,"_100":119},{"_97":138,"_42":139,"_100":119},{"_97":136,"_42":137,"_100":119},{"_97":134,"_