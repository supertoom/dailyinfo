[{"_1":2,"_3":4},"root",{"_5":193},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794444103000,"publicId","b79ca682-ef56-4264-ac9b-3dad774ddd23","title","Railway披露构建攻击链与密钥盗用","status","active","reportCount",3,"sourceCount","firstReportAt","2026-11-10T22:20:19.000Z","latestAt","2026-11-11T09:03:00.000Z","digest","Railway披露，攻击者自10月20日利用构建基础设施中的未知漏洞部分逃逸文件系统隔离，再滥用Temporal信任、错误配置的OIDC绑定及内部编排节点长期凭据，读取并解密客户环境变量中的AI服务密钥；最多约100,000个工作区（1.85%）可能受影响，这是潜在上限，受影响变量未能逐一确认。Railway未披露具体CVE或底层漏洞细节。\n\nRailway称，被盗AI密钥造成约74万美元未授权消费。攻击者于10月21日被完全移出系统，相关漏洞均已修复，密钥已重置并通知用户；取证未发现客户数据库被访问或客户代码仓库被下载，也未发现攻击者使用窃取凭据登录客户账户。","digestUpdatedAt","2026-11-11T12:17:01.702Z","summary","excerpt","latest","Railway“10·21”攻击全链路复盘：构建逃逸导致 AI 密钥失陷","latestReport",{"_152":170},"whyHot",{"_186":18,"_187":188,"_189":128,"_190":160,"_191":192},"developments",[174,175],"officialReports",[],"timeline",[149,150,151],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","cloud-native","name","云与原生","supply-chain","供应链安全","google","Google / 谷歌","ai-agent","AI Agent 安全","attack","攻击活动","identity","身份与访问",{"_94":147,"_42":148,"_97":132},{"_94":145,"_42":146,"_97":132},{"_94":143,"_42":144,"_97":132},{"_94":141,"_42":142,"_97":132},{"_94":139,"_42":140,"_97":132},{"_94":137,"_42":138,"_97":132},{"_94":135,"_42":136,"_97":132},{"_94":133,"_42":134,"_97":132},{"_94":130,"_42":131,"_97":132},{"_94":129,"_42":96,"_97":128},{"_94":126,"_42":127,"_97":128},{"_94":124,"_42":125,"_97":18},{"_94":122,"_42":123,"_97":18},{"_94":120,"_42":121,"_97":18},{"_94":118,"_42":119,"_97":18},{"_94":116,"_42":117,"_97":18},{"_94":114,"_42":115