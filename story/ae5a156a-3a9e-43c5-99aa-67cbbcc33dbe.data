[{"_1":2,"_3":4},"root",{"_5":186},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794703237000,"publicId","ae5a156a-3a9e-43c5-99aa-67cbbcc33dbe","title","OpenAI 发布 Daybreak 安全 Agent 工具","status","watching","reportCount",2,"sourceCount","firstReportAt","2026-11-13T09:21:01.000Z","latestAt","2026-11-13T09:31:07.000Z","digest","OpenAI 发布 Daybreak Red Team 和 Daybreak Defense Factory，将 AI Agent 用于 Web 应用渗透测试、漏洞验证、安全问题调查及补丁准备，目前属于工具发布，未涉及具体漏洞利用或确认受影响的部署。\n\nOpenAI 称，两款 Agent 在隔离环境中运行，由 Guardian 审查并控制可访问的应用、端点和测试边界。获准团队可在 ChatGPT 安装 Daybreak Defense Factory (Preview) 插件并连接 GitHub 仓库；云端扫描运行于 Codex cloud，每次发起扫描的人都需绑定个人 GitHub 连接。\n\n工程师可检查证据，并用 Codex 修改建议补丁、创建 GitHub 草稿拉取请求；补丁不会自动部署。","digestUpdatedAt","2026-11-13T15:19:48.541Z","summary","excerpt","latest","OpenAI 推出 Daybreak，用 AI Agent 进行安全测试、漏洞修复与复测","latestReport",{"_156":167},"whyHot",{"_178":18,"_179":180,"_181":180,"_182":183,"_184":185},"developments",[171],"officialReports",[],"timeline",[154,155],"heat",[65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93],"related",[],"topics",[48,49,50,51,52],{"_53":63,"_55":64},{"_53":61,"_55":62},{"_53":59,"_55":60},{"_53":57,"_55":58},{"_53":54,"_55":56},"slug","ai-security","name","AI 安全","ai-agent","AI Agent 安全","google","Google / 谷歌","tools","工具与平台","ai-offense","AI 攻防",{"_94":152,"_42":153,"_97":18},{"_94":150,"_42":151,"_97":18},{"_94":148,"_42":149,"_97":18},{"_94":146,"_42":147,"_97":18},{"_94":144,"_42":145,"_97":18},{"_94":142,"_42":143,"_97":18},{"_94":140,"_42":141,"_97":18},{"_94":138,"_42":139,"_97":18},{"_94":136,"_42":137,"_97":18},{"_94":134,"_42":135,"_97":18},{"_94":132,"_42":133,"_97":18},{"_94":130,"_42":131,"_97":18},{"_94":128,"_42":129,"_97":18},{"_94":126,"_42":127,"_97":18},{"_94":124,"_42":125,"_97":18},{"_94":122,"_