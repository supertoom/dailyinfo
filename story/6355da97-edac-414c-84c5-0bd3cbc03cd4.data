[{"_1":2,"_3":4},"root",{"_5":285},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795048843000,"publicId","6355da97-edac-414c-84c5-0bd3cbc03cd4","title","LibreOffice双漏洞RCE链已复现并获修复","status","active","reportCount",6,"sourceCount","firstReportAt","2026-11-17T03:12:33.663Z","latestAt","2026-11-18T09:20:00.000Z","digest","The Document Foundation 已修复 LibreOffice 远程代码执行漏洞 CVE-2026-104692 与 CVE-2026-104007，奇安信CERT、深瞳漏洞实验室等已复现并公开利用细节；目前未发现该漏洞链的在野利用。攻击者诱导使用受影响版本且启用 Java 功能的用户打开或预览特制 ODS/ODF 文档，即可无需认证、宏警告或额外交互执行任意代码。\n\n受影响版本为 26.2 <= 版本 < 26.2.7、26.8 <= 版本 < 26.8.2，官方修复版本分别为 26.2.7 和 26.8.2。研究博客作者称，CVE-2026-104007 可单独经 Driver.connect() 路径实现 RCE，但该说法尚未获独立验证。","digestUpdatedAt","2026-11-18T17:40:36.178Z","summary","excerpt","latest","LibreOffice JDBC 链式远程代码执行漏洞 CVE-2026-104007/CVE-2026-104692 已披露","latestReport",{"_209":245},"whyHot",{"_278":113,"_279":280,"_281":194,"_282":217,"_283":284},"developments",[255,256,257,258],"officialReports",[249,250,251],"timeline",[203,204,205,206,207,208],"heat",[65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108],"related",[],"topics",[48,49,50,51,52],{"_53":63,"_55":64},{"_53":61,"_55":62},{"_53":59,"_55":60},{"_53":57,"_55":58},{"_53":54,"_55":56},"slug","supply-chain","name","供应链安全","sangfor","深信服","research","技术研究","qianxin","奇安信","vuln","漏洞披露",{"_109":201,"_42":202,"_112":194},{"_109":199,"_42":200,"_112":194},{"_109":197,"_42":198,"_112":194},{"_109":195,"_42":196,"_112":194},{"_109":192,"_42":193,"_112":194},{"_109":189,"_42":190,"_112":191},{"_109":187,"_42":188,"_112":144},{"_109":185,"_42":186,"_112":144},{"_109":183,"_42":184,"_112":144},{"_109":181,"_42":182,"_112":144},{"_109":179,"_42":180,"_112":144},{"_109":177,"_42":178,"_112":144},{"_1