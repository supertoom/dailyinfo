[{"_1":2,"_3":4},"root",{"_5":183},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794962454000,"publicId","6355da97-edac-414c-84c5-0bd3cbc03cd4","title","LibreOffice双漏洞RCE链已复现并获修复","status","active","reportCount",4,"sourceCount","firstReportAt","2026-11-17T03:12:33.663Z","latestAt","2026-11-17T10:43:00.000Z","digest","奇安信CERT已复现 LibreOffice 远程代码执行漏洞 CVE-2026-104692 与 CVE-2026-104007 的组合利用链，The Document Foundation 已发布安全公告和补丁；目前未发现该漏洞链的在野利用。目标须安装受影响版本并启用 Java 运行时，用户打开或预览特制 ODS/ODF 文档即可触发任意代码执行，无需宏警告或额外交互。\n\n受影响版本为 26.2 <= 版本 < 26.2.7、26.8 <= 版本 < 26.8.2，修复版本分别为 26.2.7 和 26.8.2。研究者称 CVE-2026-104007 可单独经 Driver.connect() 路径实现 RCE，但该说法尚未获独立验证。","digestUpdatedAt","2026-11-17T17:16:08.828Z","summary","excerpt","latest","LibreOffice 远程代码执行漏洞 CVE-2026-104007/CVE-2026-104692 已发布补丁","latestReport",{"_127":151},"whyHot",{"_177":18,"_178":179,"_180":18,"_181":135,"_182":111},"developments",[159,160,161],"officialReports",[155,156],"timeline",[123,124,125,126],"heat",[59,60,61,62,63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78],"related",[],"topics",[48,49,50],{"_51":57,"_53":58},{"_51":55,"_53":56},{"_51":52,"_53":54},"slug","research","name","技术研究","qianxin","奇安信","vuln","漏洞披露",{"_79":121,"_42":122,"_82":114},{"_79":119,"_42":120,"_82":114},{"_79":117,"_42":118,"_82":114},{"_79":115,"_42":116,"_82":114},{"_79":112,"_42":113,"_82":114},{"_79":109,"_42":110,"_82":111},{"_79":107,"_42":108,"_82":18},{"_79":105,"_42":106,"_82":18},{"_79":103,"_42":104,"_82":18},{"_79":101,"_42":102,"_82":18},{"_79":99,"_42":100,"_82":18},{"_79":97,"_42":98,"_82":18},{"_79":95,"_42":96,"_82":18},{"_79":93,"_42":94,"_82":18},{"_79":91,"_42":92,"_82":18},{"_79":89,"_42":90,"_82":18},{"_79":87,"_42":88,"_82":18},{"_79":85,"_42":86,"_82":18},{"_79":83,"_42":84,"_82":18},{"_79":80,"_42":81,"_82":18},"ho