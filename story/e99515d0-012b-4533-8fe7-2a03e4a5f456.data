[{"_1":2,"_3":4},"root",{"_5":285},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795135250000,"publicId","e99515d0-012b-4533-8fe7-2a03e4a5f456","title","Puppet高危反序列化漏洞已遭在野利用","status","active","reportCount",5,"sourceCount","firstReportAt","2026-11-17T12:00:00.000Z","latestAt","2026-11-19T13:07:41.000Z","digest","CISA已因在野利用证据将Perforce Puppet Enterprise反序列化远程代码执行漏洞CVE-2026-115731纳入KEV目录；该漏洞CVSS 9.4，影响Puppet Server，利用后可完全控制资产。Perforce此前称尚无报告确认遭到利用，后续报道则确认攻击者已在脆弱服务器执行代码，双方结论曾存在分歧。\n\n攻击通常要求客户端持有Puppet CA签发的证书，并通过HTTP PUT提交含恶意载荷的rich-data报告，以Puppet Server服务账户权限执行代码；若CA自动签名且未做强校验，未经身份验证且网络可达的攻击者可先取得有效证书。漏洞已于2026年11月3日修复，版本包括Puppet Enterprise 2026.0.1（Puppet Core 9.1.3）、2025.12.1、2023.8.13（Puppet Core 8.22.2），以及Puppet Core 9.1.3、8.22.2；CISA要求联邦机构优先修补并检查系统是否已被攻陷。","digestUpdatedAt","2026-11-19T13:30:50.821Z","summary","excerpt","latest","Perforce Puppet Enterprise 远程代码执行漏洞 CVE-2026-115731 已被利用","latestReport",{"_229":259},"whyHot",{"_278":121,"_279":280,"_281":201,"_282":240,"_283":284},"developments",[265,266],"officialReports",[263],"timeline",[224,225,226,227,228],"heat",[65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116],"related",[],"topics",[48,49,50,51,52],{"_53":63,"_55":64},{"_53":61,"_55":62},{"_53":59,"_55":60},{"_53":57,"_55":58},{"_53":54,"_55":56},"slug","research","name","技术研究","vuln-mgmt","漏洞管理","exploited","在野利用","vuln","漏洞披露","cisa","CISA",{"_117":222,"_42":223,"_120":201},{"_117":220,"_42":221,"_120":201},{"_117":218,"_42":219,"_120":201},{"_117":216,"_42":217,"_120":201},{"_117":214,"_42":215,"_120":201},{"_117":212,"_42":213,"_120":201},{"_117":210,"_42":211,"_120":201},{"_117":208,"_42":209,"_120":201},{"_117":206,"_42":207,"_120"