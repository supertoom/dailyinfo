[{"_1":2,"_3":4},"root",{"_5":201},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795048843000,"publicId","e99515d0-012b-4533-8fe7-2a03e4a5f456","title","CISA确认Puppet高危漏洞已遭在野利用","status","active","reportCount",4,"sourceCount","firstReportAt","2026-11-17T12:00:00.000Z","latestAt","2026-11-18T10:37:08.000Z","digest","CISA称，Perforce Puppet反序列化远程代码执行漏洞CVE-2026-115731已有在野利用证据，并将其纳入KEV目录；该漏洞CVSS 9.4，影响Puppet Server，利用后可完全控制资产。Perforce此前表示尚无报告确认遭到利用，两方结论存在分歧，后续报道指攻击者已利用该漏洞在脆弱服务器上执行代码。\n\n攻击通常要求客户端持有Puppet CA签发的证书，并通过HTTP PUT提交含恶意载荷的rich-data报告，以服务账户权限执行代码；若CA自动签名且未做强校验，未经身份验证且网络可达的攻击者可先取得有效证书。漏洞已于2026年11月3日修复，版本包括Puppet Enterprise 2026.0.1（Puppet Core 9.1.3）、2025.12.1、2023.8.13（Puppet Core 8.22.2），以及Puppet Core 9.1.3、8.22.2；CISA要求联邦机构优先修补并检查系统是否已被攻陷。","digestUpdatedAt","2026-11-18T11:09:53.193Z","summary","excerpt","latest","Perforce Puppet RCE 漏洞 CVE-2026-115731 已被利用并列入 KEV","latestReport",{"_152":176},"whyHot",{"_194":18,"_195":196,"_197":121,"_198":163,"_199":200},"developments",[182,183],"officialReports",[180],"timeline",[148,149,150,151],"heat",[62,63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89],"related",[],"topics",[48,49,50,51],{"_52":60,"_54":61},{"_52":58,"_54":59},{"_52":56,"_54":57},{"_52":53,"_54":55},"slug","vuln-mgmt","name","漏洞管理","exploited","在野利用","vuln","漏洞披露","cisa","CISA",{"_90":146,"_42":147,"_93":125},{"_90":144,"_42":145,"_93":125},{"_90":142,"_42":143,"_93":125},{"_90":140,"_42":141,"_93":125},{"_90":138,"_42":139,"_93":125},{"_90":136,"_42":137,"_93":125},{"_90":134,"_42":135,"_93":125},{"_90":132,"_42":133,"_93":125},{"_90":130,"_42":131,"_93":125},{"_90":128,"_42":129,"_93":125},{"_90":126,"_42":127,"_93":125},{"_90":123,"_42":124,"_93":125},{"_90":122,"_42":99,"_93":121},{"_90":120,"_42":97,"_93":121},{"_90":118,"_42":119,"_93":18},{"_90":116,"_42":117,"_93":18},{"_90":114,"_42":115,"_93":18},{"_90":112,"_42":113,"_93":18},{"_90":110,"_42":111,"_93":18},{"_90":108,"_42":109,"_93":18},{"_90":106,"_42":107,"_93":18},{"_90":104,"_42":105,"_93":18},{"_90":102,"_42":103,"_93":18},{"_90":100,"_42":101,"_93":18},{"_90":98,"_42":99,"_93":18},{"_90":96,"_42":97,"_93":18},{"_90":94,"_42":95,"_93":18},{"_90":91,"_42":92,"_93":18},"hour","2026-11-19T00:00:00.000Z",23.1,"participants","2026-11-18T23:00:00.000Z",23.8,"2026-11-18T22:00:00.000Z",24.5,"2026-11-18T21:00:00.000Z",25.2,"2026-11-18T20:00:00.000Z",26,"2026-11-18T19:00:00.000Z",26.7,"2026-11-18T18:00:00.000Z",27.5,"2026-11-18T17:00:00.000Z",28.3,"2026-11-18T16:00:00.000Z",29.1,"2026-11-18T15:00:00.000Z",30,"2026-11-18T14:00:00.000Z",30.9,"2026-11-18T13:00:00.000Z",31.8,"2026-11-18T12:00:00.000Z",32.7,"2026-11-18T11:00:00.000Z",33.7,"2026-11-18T10:00:00.000Z",3,"2026-11-18T09:00:00.000Z","2026-11-18T08:00:00.000Z",5.6,1,"2026-11-18T07:00:00.000Z",5.8,"2026-11-18T06:00:00.000Z",5.9,"2026-11-18T05:00:00.000Z",6.1,"2026-11-18T04:00:00.000Z",6.3,"2026-11-18T03:00:00.000Z",6.5,"2026-11-18T02:00:00.000Z",6.7,"2026-11-18T01:00:00.000Z",6.9,"2026-11-18T00:00:00.000Z",7.1,"2026-11-17T23:00:00.000Z",7.3,"2026-11-17T22:00:00.000Z",7.5,"2026-11-17T21:00:00.000Z",7.7,{"_152":176,"_13":31,"_28":177,"_156":178,"_158":23,"_159":163},{"_152":170,"_13":171,"_28":172,"_156":173,"_158":174,"_159":160},{"_152":164,"_13":165,"_28":166,"_156":167,"_158":168,"_159":163},{"_152":153,"_13":154,"_28":155,"_156":157,"_158":21,"_159":160},"id","wud57uz2zmyoxg2sejyi2q2nv","CISA 将 Perforce Puppet Enterprise 反序列化漏洞 CVE-2026-115731 纳入 KEV 目录","CISA 因已有在野利用证据，将 Perforce Puppet Enterprise 的不安全反序列化漏洞 CVE-2026-115731 纳入 KEV 目录。BOD 26-04 要求 FCEB 机构优先修复公开暴露且利用后可完全控制资产的高风险 KEV 漏洞，并检查补丁应用前系统是否已被攻陷；CISA 同时建议所有组织采用基于风险的漏洞管理。","source",{"_54":161,"_162":163},"publishedAt","selected",false,"CISA 安全公告","firstParty",true,"rnu00kwyfy4hd4up9l1g3ft2s","CISA 将 Perforce Puppet RCE 漏洞 CVE-2026-115731 列入 KEV 目录","CISA 已将 Perforce Puppet 远程代码执行漏洞 CVE-2026-115731 列入 KEV 目录，CVSS 9.4，并称已有在野利用报告。攻击者持任意 CA 签发的代理证书即可通过 PUT 请求提交特制 rich-data 报告，以服务用户权限执行代码；若 CA 自动签发请求且缺少强校验，未经身份验证的攻击者也可利用。",{"_54":169,"_162":160},"2026-11-18T08:24:31.000Z","The Hacker News","fvauk1mygqdis4avofhunlloy","CISA 将 Perforce Puppet Enterprise RCE 漏洞 CVE-2026-115731 纳入 KEV","CISA 将 Perforce Puppet Enterprise 远程代码执行漏洞 CVE-2026-115731 纳入 KEV，CVSS 9.4。该漏洞影响 Puppet Server，攻击者需持有由 Puppet CA 签发的证书，并通过 HTTP PUT 提交特制报告以服务账户权限执行代码；若 CA 自动签名且验证不足，未认证的可达攻击者可取得有效证书后利用。",{"_54":175,"_162":160},"2026-11-18T08:41:13.000Z","Security Affairs","eenizee3z2wwp5xmzqyvxtlbd","Perforce Puppet 漏洞 CVE-2026-115731 已在真实攻击中被利用，该严重漏洞源于报告处理中的不安全反序列化，可导致 RCE，CVSS 为 9.4。",{"_54":179,"_162":160},"SecurityWeek",{"_152":153,"_13":154,"_28":155,"_156":181,"_158":21,"_159":160},{"_54":161,"_162":163},{"_184":190,"_13":191,"_20":23,"_17":125,"_187":192},{"_184":185,"_13":186,"_20":21,"_17":121,"_187":188},"factId","fZP3_QN_WrgM","CISA将一漏洞加入KEV目录","representative",{"_152":164,"_13":165,"_28":166,"_156":189,"_158":168,"_159":163},{"_54":169,"_162":160},"fo27jtuCZhJs","Perforce Puppet RCE漏洞遭在野利用",{"_152":176,"_13":31,"_28":177,"_156":193,"_158":23,"_159":163},{"_54":179,"_162":160},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",6,{"_202":203,"_204":-5},"changelogVersion","2026-10-01T08:00","release"]
