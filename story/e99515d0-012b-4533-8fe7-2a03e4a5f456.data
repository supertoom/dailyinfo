,17.8,"2026-11-19T08:00:00.000Z",18.4,"2026-11-19T07:00:00.000Z",18.9,"2026-11-19T06:00:00.000Z",19.5,"2026-11-19T05:00:00.000Z",20,"2026-11-19T04:00:00.000Z",20.6,"2026-11-19T03:00:00.000Z",21.2,"2026-11-19T02:00:00.000Z",21.8,"2026-11-19T01:00:00.000Z",22.5,"2026-11-19T00:00:00.000Z",23.1,"2026-11-18T23:00:00.000Z",23.8,"2026-11-18T22:00:00.000Z",24.5,"2026-11-18T21:00:00.000Z",25.2,"2026-11-18T20:00:00.000Z",26,"2026-11-18T19:00:00.000Z",26.7,"2026-11-18T18:00:00.000Z",27.5,"2026-11-18T17:00:00.000Z",28.3,"2026-11-18T16:00:00.000Z",29.1,"2026-11-18T15:00:00.000Z",30,"2026-11-18T14:00:00.000Z",30.9,"2026-11-18T13:00:00.000Z",31.8,"2026-11-18T12:00:00.000Z",32.7,"2026-11-18T11:00:00.000Z",33.7,"2026-11-18T10:00:00.000Z","2026-11-18T09:00:00.000Z","2026-11-18T08:00:00.000Z",5.6,1,"2026-11-18T07:00:00.000Z",5.8,"2026-11-18T06:00:00.000Z",5.9,"2026-11-18T05:00:00.000Z",6.1,"2026-11-18T04:00:00.000Z",6.3,"2026-11-18T03:00:00.000Z",6.5,"2026-11-18T02:00:00.000Z",6.7,"2026-11-18T01:00:00.000Z",6.9,"2026-11-18T00:00:00.000Z",7.1,"2026-11-17T23:00:00.000Z",7.3,"2026-11-17T22:00:00.000Z",7.5,"2026-11-17T21:00:00.000Z",7.7,{"_229":259,"_13":31,"_28":260,"_233":261,"_235":23,"_236":240},{"_229":253,"_13":254,"_28":255,"_233":256,"_235":257,"_236":240},{"_229":247,"_13":248,"_28":249,"_233":250,"_235":251,"_236":237},{"_229":241,"_13":242,"_28":243,"_233":244,"_235":245,"_236":240},{"_229":230,"_13":231,"_28":232,"_233":234,"_235":21,"_236":237},"id","wud57uz2zmyoxg2sejyi2q2nv","CISA 将 Perforce Puppet Enterprise 反序列化漏洞 CVE-2026-115731 纳入 KEV 目录","CISA 因已有在野利用证据，将 Perforce Puppet Enterprise 的不安全反序列化漏洞 CVE-2026-115731 纳入 KEV 目录。BOD 26-04 要求 FCEB 机构优先修复公开暴露且利用后可完全控制资产的高风险 KEV 漏洞，并检查补丁应用前系统是否已被攻陷；CISA 同时建议所有组织采用基于风险的漏洞管理。","source",{"_55":238,"_239":240},"publishedAt","selected",false,"CISA 安全公告","firstParty",true,"rnu00kwyfy4hd4up9l1g3ft2s","CISA 将 Perforce Puppet RCE 漏洞 CVE-2026-115731 列入 KEV 目录","CISA 已将 Perforce Puppet 远程代码执行漏洞 CVE-2026-115731 列入 KEV 目录，CVSS 9.4，并称已有在野利用报告。攻击者持任意 CA 签发的代理证书即可通过 PUT 请求提交特制 rich-data 报告，以服务用户权限执行代码；若 CA 自动签发请求且缺少强校验，未经身份验证的攻击者也可利用。",{"_55":246,"_239":237},"2026-11-18T08:24:31.000Z","The Hacker News","fvauk1mygqdis4avofhunlloy","CISA 将 Perforce Puppet Enterprise RCE 漏洞 CVE-2026-115731 纳入 KEV","CISA 将 Perforce Puppet Enterprise 远程代码执行漏洞 CVE-2026-115731 纳入 KEV，CVSS 9.4。该漏洞影响 Puppet Server，攻击者需持有由 Puppet CA 签发的证书，并通过 HTTP PUT 提交特制报告以服务账户权限执行代码；若 CA 自动签名且验证不足，未认证的可达攻击者可取得有效证书后利用。",{"_55":252,"_239":237},"2026-11-18T08:41:13.000Z","Security Affairs","eenizee3z2wwp5xmzqyvxtlbd","Perforce Puppet RCE 漏洞 CVE-2026-115731 已被利用并列入 KEV","Perforce Puppet 漏洞 CVE-2026-115731 已在真实攻击中被利用，该严重漏洞源于报告处理中的不安全反序列化，可导致 RCE，CVSS 为 9.4。",{"_55":258,"_239":237},"2026-11-18T10:37:08.000Z","SecurityWeek","xv5d0yig7ofbs8qyzkpclpr24","攻击者正在利用 Perforce Puppet Enterprise 的远程代码执行漏洞 CVE-2026-115731，该漏洞位于处理 Agent 上报信息的反序列化逻辑中。",{"_55":262,"_239":237},"Help Net Security",{"_229":230,"_13":231,"_28":232,"_233":264,"_235":21,"_236":237},{"_55":238,"_239":240},{"_267":273,"_13":274,"_20":257,"_17":275,"_270":276},{"_267":268,"_13":269,"_20":21,"_17":144,"_270":271},"factId","fZP3_QN_WrgM","CISA将一漏洞加入KEV目录","representative",{"_229":241,"_13":242,"_28":243,"_233":272,"_235":245,"_236":240},{"_55":246,"_239":237},"fo27jtuCZhJs","Perforce Puppet RCE漏洞遭在野利用",2,{"_229":253,"_13":254,"_28":255,"_233":277,"_235":257,"_236":240},{"_55":258,"_239":237},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",8,{"_286":287,"_288":-5},"changelogVersion","2026-10-01T08:00","release"]
