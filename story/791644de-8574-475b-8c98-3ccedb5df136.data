[{"_1":2,"_3":4},"root",{"_5":205},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795826460000,"publicId","791644de-8574-475b-8c98-3ccedb5df136","title","Flight Centre第三方预订系统遭入侵","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-26T11:51:11.000Z","latestAt","2026-11-27T09:31:44.000Z","digest","澳大利亚Flight Centre Travel Group披露，其多个休闲旅行品牌使用的第三方住宿预订系统检测到异常活动，客户记录疑遭读取，事件仍在调查。Flight Centre称，少量记录可能包含有限护照资料、邮箱、电话、出生日期，罕见情况下还涉及健康或行动不便信息；目前未发现客户信用卡、支付或银行账户详情被访问。\n\n受影响范围覆盖Flight Centre、Travel Associates、Cruiseabout及部分独立代理商；使用独立系统的航班预订和商务旅行预订未受影响。公司尚未披露受影响客户的确切数量。","digestUpdatedAt","2026-11-27T10:25:48.596Z","summary","excerpt","latest","Flight Centre Travel Group 披露第三方预订系统客户数据泄露","latestReport",{"_175":186},"whyHot",{"_197":18,"_198":199,"_200":132,"_201":202,"_203":204},"developments",[190],"officialReports",[],"timeline",[173,174],"heat",[62,63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97],"related",[],"topics",[48,49,50,51],{"_52":60,"_54":61},{"_52":58,"_54":59},{"_52":56,"_54":57},{"_52":53,"_54":55},"slug","attack","name","攻击活动","incident","应急响应","email","邮件与钓鱼","identity","身份与访问",{"_98":171,"_42":172,"_101":132},{"_98":169,"_42":170,"_101":132},{"_98":167,"_42":168,"_101":132},{"_98":165,"_42":166,"_101":132},{"_98":163,"_42":164,"_101":132},{"_98":161,"_42":162,"_101":132},{"_98":159,"_42":160,"_101":132},{"_98":157,"_42":158,"_101":132},{"_98":155,"_42":156,"_101":132},{"_98":153,"_42":154,"_101":132},{"_98":151,"_42":152,"_101":132},{"_98":149,"_42":150,"_101":132},{"_98":147,"_42":148,"_101":132},{"_98":145,"_42":146,"_101":132},{"_98":143,"_42":144,"_101":132},{"_98":141,"_42":142,"_101":132},{"_98":139,"_42":140,"_101":132},{"_98":137,"_42":138,"_101":132},{"_98":135,"_42":136,"_101"