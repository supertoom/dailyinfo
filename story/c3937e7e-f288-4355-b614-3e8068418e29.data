[{"_1":2,"_3":4},"root",{"_5":366},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":-5,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48},"expiresAt",1794444103000,"publicId","c3937e7e-f288-4355-b614-3e8068418e29","title","Chrome XML释放后重用零日漏洞已修复","status","watching","reportCount",15,"sourceCount",11,"firstReportAt","2026-11-09T23:00:00.000Z","latestAt","2026-11-10T10:05:00.000Z","digest","Google 已修复 Chrome XML 组件释放后重用漏洞 CVE-2026-125350，并确认该漏洞存在在野利用；奇安信威胁情报中心已复现，深信服千里目安全实验室将其 CVSS 3.1 评分列为 8.8、高危。该漏洞利用无需认证、默认配置即可远程触发，攻击者诱导用户访问包含恶意 XSLT 的网页即可造成浏览器渲染进程内存损坏并可能实现任意代码执行；受影响版本为 Chrome Windows/Mac < 157.0.8103.50/.51、Linux < 157.0.8103.50。\n\n修复版本为 Chrome Windows/Mac 157.0.8103.50/.51、Linux 157.0.8103.50，桌面稳定通道将在未来数日或数周内逐步推送；Android 版 157.0.8103.50 也已发布并包含对应桌面版安全修复。Google 尚未披露攻击者身份、攻击目标或利用规模；CISA 也尚未将 CVE-2026-125350 列入 KEV。","digestUpdatedAt","2026-11-11T21:19:58.027Z","summary","excerpt","latest","Google 修复 Chrome 在野利用漏洞 CVE-2026-125350","latestReport",{"_245":313},"whyHot",{"_361":124,"_362":229,"_363":229,"_364":257,"_365":214},"developments",[339,340,341,342],"officialReports",[333,334,335],"timeline",[230,231,232,233,234,235,236,237,238,239,240,241,242,243,244],"heat",[69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119],"related",[],"topics",[49,50,51,52,53,54],{"_55":67,"_57":68},{"_55":65,"_57":66},{"_55":63,"_57":64},{"_55":61,"_57":62},{"_55":59,"_57":60},{"_55":56,"_57":58},"slug","research","name","技术研究","mobile","移动端","exploited","在野利用","vuln","漏洞披露","browser","浏览器","google","Google / 谷歌",{"_120":228,"_43":229,"_123":229},{"_120":22,"_43":226,"_123":227},{"_120":224,"_43":225,"_123":217},{"_120":222,"_43":223,"_123":217},{"_120":220,"_43":221,"_123":217},{"_120":218,"_43":219,"_123":217},{"_120":215,"_43":216