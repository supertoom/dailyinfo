[{"_1":2,"_3":4},"root",{"_5":286},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":-5,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48},"expiresAt",1794357648000,"publicId","c3937e7e-f288-4355-b614-3e8068418e29","title","Chrome XML释放后重用零日漏洞已修复","status","active","reportCount",13,"sourceCount",11,"firstReportAt","2026-11-09T20:52:57.820Z","latestAt","2026-11-10T10:05:00.000Z","digest","Google确认Chrome XML组件释放后重用漏洞CVE-2026-125350已遭在野利用，并已发布修复更新；奇安信CERT将其评为高危，CVSS 3.1评分为8.8。攻击者、目标机构、受影响数量及真实攻击方式仍未披露。\n\n奇安信研究人员已复现：用户无需认证，在默认配置下访问含恶意XSLT的网页即可触发XML/XSLT处理链中的内存损坏，可能造成数据损坏、程序崩溃或任意代码执行。Windows、Mac版低于157.0.8103.50/.51及Linux版低于157.0.8103.50受影响；修复版分别为157.0.8103.50/.51和157.0.8103.50，更新正逐步推送。Android版157.0.8103.50已通过Google Play发布并默认包含对应安全修复，报道未说明是否需额外配置或重启。","digestUpdatedAt","2026-11-10T17:53:00.272Z","summary","excerpt","latest","Google 修复 Chrome 在野利用漏洞 CVE-2026-125350","latestReport",{"_172":234},"whyHot",{"_280":100,"_281":282,"_283":131,"_284":184,"_285":156},"developments",[257,258,259,260],"officialReports",[249,250,251,252],"timeline",[159,160,161,162,163,164,165,166,167,168,169,170,171],"heat",[69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95],"related",[],"topics",[49,50,51,52,53,54],{"_55":67,"_57":68},{"_55":65,"_57":66},{"_55":63,"_57":64},{"_55":61,"_57":62},{"_55":59,"_57":60},{"_55":56,"_57":58},"slug","research","name","技术研究","mobile","移动端","exploited","在野利用","vuln","漏洞披露","browser","浏览器","google","Google / 谷歌",{"_96":157,"_43":158,"_99":156},{"_96":154,"_43":155,"_99":156},{"_96":152,"_43":153,"_99":145},{"_96":150,"_43":151,"_99":145},{"_96":148,"_43":149,"_99":145},{"_96":146,"_43":147,"_99":145},{"_96":143,"_43":144,"_99":145},{"_96":140,"_43":141,"_99":142},{"_96":137,"_43":138,"_99":139},{"_96":135,"_43":136,"_99":134},{"_96":132,"_43":133,"_99":134},{"_96":130,"_43":110,"_99":131},{"_96":127,"_43":128,"_99":129},{"_96":125,"_43":126,"_99":100},{"_96":123,"_43":124,"_99":100},{"_96":121,"_43":122,"_99":100},{"_96":119,"_43":120,"_99":100},{"_96":117,"_43":118,"_99":100},{"_96":115,"_43":116,"_99":100},{"_96":113,"_43":114,"_99":100},{"_96":111,"_43":112,"_99":100},{"_96":109,"_43":110,"_99":100},{"_96":107,"_43":108,"_99":100},{"_96":105,"_43":106,"_99":100},{"_96":103,"_43":104,"_99":100},{"_96":101,"_43":102,"_99":100},{"_96":97,"_43":98,"_99":100},"hour","2026-11-11T00:00:00.000Z",53.1,"participants",9,"2026-11-10T23:00:00.000Z",54.7,"2026-11-10T22:00:00.000Z",56.3,"2026-11-10T21:00:00.000Z",58,"2026-11-10T20:00:00.000Z",59.7,"2026-11-10T19:00:00.000Z",61.4,"2026-11-10T18:00:00.000Z",63.2,"2026-11-10T17:00:00.000Z",65.1,"2026-11-10T16:00:00.000Z",67,"2026-11-10T15:00:00.000Z",68.9,"2026-11-10T14:00:00.000Z",70.9,"2026-11-10T13:00:00.000Z",73,"2026-11-10T12:00:00.000Z",75.2,"2026-11-10T11:00:00.000Z",77.4,"2026-11-10T10:00:00.000Z",69.6,8,"2026-11-10T09:00:00.000Z",7,"2026-11-10T08:00:00.000Z",52.9,6,"2026-11-10T07:00:00.000Z",54.5,"2026-11-10T06:00:00.000Z",35.8,4,"2026-11-10T05:00:00.000Z",26.8,3,"2026-11-10T04:00:00.000Z",17.6,2,"2026-11-10T03:00:00.000Z",18.1,"2026-11-10T02:00:00.000Z",18.6,"2026-11-10T01:00:00.000Z",19.2,"2026-11-10T00:00:00.000Z",19.7,"2026-11-09T23:00:00.000Z",10,1,"2026-11-09T22:00:00.000Z",9.7,{"_172":243,"_13":244,"_29":245,"_176":246,"_178":247,"_180":181},{"_172":238,"_13":239,"_29":240,"_176":241,"_178":123,"_180":181},{"_172":234,"_13":32,"_29":235,"_176":236,"_178":24,"_180":184},{"_172":228,"_13":229,"_29":230,"_176":231,"_178":232,"_180":184},{"_172":222,"_13":223,"_29":224,"_176":225,"_178":226,"_180":184},{"_172":216,"_13":217,"_29":218,"_176":219,"_178":220,"_180":184},{"_172":210,"_13":211,"_29":212,"_176":213,"_178":214,"_180":181},{"_172":204,"_13":205,"_29":206,"_176":207,"_178":208,"_180":184},{"_172":198,"_13":199,"_29":200,"_176":201,"_178":202,"_180":184},{"_172":193,"_13":194,"_29":195,"_176":196,"_178":152,"_180":181},{"_172":189,"_13":190,"_29":191,"_176":192,"_178":154,"_180":181},{"_172":185,"_13":186,"_29":187,"_176":188,"_178":22,"_180":184},{"_172":173,"_13":174,"_29":175,"_176":177,"_178":179,"_180":181},"id","cedw8do03efuvvsvnmotntv33","Chrome Extended Stable 156.0.8078.96 修复 11 个安全漏洞","Chrome Extended Stable 渠道面向 Windows 和 Mac 更新至 156.0.8078.96，将在数日至数周内推送，包含 11 个安全修复。","source",{"_57":182,"_183":184},"publishedAt","2026-11-09T20:45:01.211Z","selected",false,"Chrome Releases","firstParty",true,"ke43qtftrmo1i5qcbhrr32q9r","Chrome 157 稳定版更新修复 9 项安全漏洞，CVE-2026-125350 已被在野利用","Chrome Stable 渠道已更新至 Windows 和 Mac 的 157.0.8103.50/.51、Linux 的 157.0.8103.50，将在未来数日或数周内推送。",{"_57":182,"_183":184},"wwbrprh2ghuazcvvl7hychj94","Chrome 157 Android 版更新至 157.0.8103.50，改进稳定性与性能","Chrome 157（157.0.8103.50）for Android 已发布，未来数日将通过 Google Play 上线，主要包含稳定性和性能改进。该版本默认包含对应桌面版（Windows 与 Mac：157.0.8103.50/.51，Linux：157.0.8103.50）的安全修复，除非另有说明。",{"_57":182,"_183":184},"m6glbhdxsu4mpkw77lbh1j7j8","Google Chrome 存在多项漏洞，CVE-2026-125350 正被积极利用","Google Chrome 存在多项漏洞，攻击者可能借此触发编辑器尚未具体说明的安全问题。Google 表示 CVE-2026-125350 已被积极利用；修复方式需参阅厂商安全公告中的补丁说明。",{"_57":197,"_183":181},"CERT-FR","pp4hail1fdlf3evlzbqiylphv","Google Chrome XML 释放后重用漏洞 CVE-2026-125350 已确认在野利用","Google Chrome XML 释放后重用漏洞 CVE-2026-125350 已被确认存在在野利用，CVSS 3.1 分数为 8.8，奇安信 CERT 评级为高危。",{"_57":203,"_183":184},"2026-11-10T04:04:00.000Z","奇安信 CERT","gnsc4sm9wrdjrvu4t6mq425y1","Google Chrome XML 释放后重用漏洞 CVE-2026-125350 已发现在野利用","Google Chrome XML 释放后重用漏洞 CVE-2026-125350 已被用于真实攻击，攻击者可通过特制 HTML 页面触发 XML 解析路径中的内存损坏，在浏览器沙箱内实现任意代码执行，可能导致敏感信息泄露、权限提升或进一步系统控制。",{"_57":209,"_183":181},"2026-11-10T05:04:22.545Z","安全内参","y95b2q810av4bhuydkoa30c4z","Chrome 修复已在野利用的 XML 漏洞 CVE-2026-125350","Chrome 已修复在野利用的 XML 组件释放后重用漏洞 CVE-2026-125350，该漏洞等级为高危，匿名研究人员于 November 6 向 Google 报告，Google 尚未披露攻击细节，CISA 也未将其列入 KEV。",{"_57":215,"_183":181},"2026-11-10T06:12:24.000Z","SecurityWeek","ib6c7f43jbuvs0r8jvx7tzglv","Google 修复 Chrome 在野利用漏洞 CVE-2026-125350，年内第八个遭在野利用漏洞","Chrome 已在野利用的 XML 组件释放后重用漏洞 CVE-2026-125350 被成功利用后可能造成数据损坏、程序崩溃或任意代码执行，CVSS 评分为 N/A。",{"_57":221,"_183":181},"2026-11-10T06:52:54.000Z","The Hacker News","vwzme567xutbi03luyq6511ja","Google 修复 Chrome 零日漏洞 CVE-2026-125350，已被在野利用","Google 已为 Chrome XML 组件中的 Use-After-Free 漏洞 CVE-2026-125350 发布紧急安全更新，并确认该漏洞已被在野利用，这也是今年 Google 修复的第 8 个遭利用的 Chrome 漏洞。",{"_57":227,"_183":181},"2026-11-10T08:51:25.000Z","BleepingComputer","z7r3ob6z5zlzhu12s71ktd4th","Chrome XML 双重释放漏洞 CVE-2026-125350 已被在野利用","Google Chrome 内置 libxslt 的 XSLT 处理链路存在双重释放（UAF）漏洞 CVE-2026-125350，CVSS 3.1 为 8.8，已被在野利用。",{"_57":233,"_183":184},"2026-11-10T09:51:00.000Z","深信服千里目安全实验室","e1hkckhbk3ty6sx2hm2qyvg9o","Google 已确认漏洞 CVE-2026-125350 存在在野利用，该漏洞是位于 XML 组件的释放后重用（UAF）内存破坏问题，可能导致拒绝服务、内存破坏或任意代码执行，并可能用于权限提升。",{"_57":237,"_183":181},"Security Affairs","n6bja44os51199l15pr9g4lvq","CISA 将 6 个已知在野利用漏洞加入 KEV 目录","CISA 基于在野利用证据，将 6 个漏洞加入 KEV 目录，包括 Cisco BroadWorks 的 CVE-2026-20320、Barracuda Networks 的 CVE-2026-111560 和 CVE-2026-116606、Openwave Messaging 的 CVE-2026-111793、Microsoft Office Outlook 的 CVE-2026-124194，以及 Google Chromium 的 CVE-2026-125350。BOD 26-04 要求 FCEB 机构优先修复公网暴露、且被攻陷后可完全控制资产的高风险 KEV 漏洞，并检查补丁应用前系统是否已被攻陷；CISA 同时建议所有组织采用基于风险的漏洞管理并优先处置 KEV 目录漏洞。",{"_57":242,"_183":184},"CISA 安全公告","wpc68l4hjniam2rzrhql43ioq","Microsoft 修复 1,093 个漏洞，CVE-2026-124194 已遭在野利用","Microsoft 发布更新修复 Windows 操作系统及受支持软件中的 1,093 个漏洞，其中 63 个严重漏洞可被用于几乎无需用户配合地控制 Windows 系统，近半为远程代码执行，另有 535 个可导致权限提升。",{"_57":248,"_183":181},"2026-11-10T21:55:03.000Z","Krebs on Security",{"_172":228,"_13":229,"_29":230,"_176":256,"_178":232,"_180":184},{"_172":198,"_13":199,"_29":200,"_176":255,"_178":202,"_180":184},{"_172":189,"_13":190,"_29":191,"_176":254,"_178":154,"_180":181},{"_172":185,"_13":186,"_29":187,"_176":253,"_178":22,"_180":184},{"_57":182,"_183":184},{"_57":182,"_183":184},{"_57":203,"_183":184},{"_57":233,"_183":184},{"_261":276,"_13":277,"_21":202,"_17":142,"_265":278},{"_261":272,"_13":273,"_21":152,"_17":156,"_265":274},{"_261":268,"_13":269,"_21":154,"_17":156,"_265":270},{"_261":262,"_13":263,"_21":22,"_17":264,"_265":266},"factId","fDjAXcXjoma4","Chrome桌面稳定版更新",5,"representative",{"_172":185,"_13":186,"_29":187,"_176":267,"_178":22,"_180":184},{"_57":182,"_183":184},"feQCcH_z0J1A","发布 Chrome 157 Android 版",{"_172":189,"_13":190,"_29":191,"_176":271,"_178":154,"_180":181},{"_57":182,"_183":184},"fMSIeXHgkrfA","披露Chrome多项漏洞且一项在野利用",{"_172":193,"_13":194,"_29":195,"_176":275,"_178":152,"_180":181},{"_57":197,"_183":181},"fzcFu-wC7B_s","奇安信复现Chrome XML释放后重用漏洞",{"_172":228,"_13":229,"_29":230,"_176":279,"_178":232,"_180":184},{"_57":233,"_183":184},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",{"_287":288,"_289":-5},"changelogVersion","2026-10-01T08:00","release"]
