[{"_1":2,"_3":4},"root",{"_5":279},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795135250000,"publicId","92393685-eb8c-4aaf-b313-1b8098f352d3","title","F5修复NGINX两项HTTP/2高危漏洞","status","active","reportCount",11,"sourceCount","firstReportAt","2026-11-18T13:56:42.000Z","latestAt","2026-11-19T14:57:24.000Z","digest","F5已修复NGINX HTTP/2实现中的整数下溢漏洞CVE-2026-123007和CVE-2026-123633，两者CVSS均为9.2，可导致未认证远程代码执行；截至披露，供应商及Wiz、Rapid7均未报告真实攻击，CISA KEV也未收录。公开PoC已在官方NGINX 1.31.7、1.31.8构建上验证。\n\nCVE-2026-123007影响开源NGINX 1.9.5至1.31.8，CVE-2026-123633影响1.19.7至1.31.8；利用均要求启用HTTP/2，后者还要求NGINX将请求代理至后端。修复版本为NGINX Open Source 1.30.7 stable和1.31.9 mainline；无法立即升级时可暂时禁用HTTP/2。报道未说明额外配置或重启要求。","digestUpdatedAt","2026-11-19T23:15:05.628Z","summary","excerpt","latest","NGINX 两项 HTTP/2 严重漏洞 CVE-2026-123007、CVE-2026-123633 可实现远程代码执行","latestReport",{"_186":250},"whyHot",{"_273":108,"_274":275,"_276":134,"_277":195,"_278":134},"developments",[256,257,258],"officialReports",[254],"timeline",[175,176,177,178,179,180,181,182,183,184,185],"heat",[72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103],"related",[68],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","exploited","name","在野利用","crowdstrike","CrowdStrike","cloud-native","云与原生","rapid7","Rapid7 / Metasploit","research","技术研究","vuln","漏洞披露",{"_11":69,"_13":70,"_71":44},"3eb72e03-2965-4ea3-8b98-657fd92ab44d","F5已修复NGINX五项未认证RCE","relation",{"_104":173,"_42":174,"_107":172},{"_104":170,"_42":171,"_107":172},{"_104":168,"_42":169,"_107":149},{"_104":166,"_42":167,"_107":149},{"_104":164,"_42":165,"_107":149},{"_104":162,"_42":163,"_107":149},{"_104":160,"_42":161,"_107":149},{"_104":158,"_42":159,"_1