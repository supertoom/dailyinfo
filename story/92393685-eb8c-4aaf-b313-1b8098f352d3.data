8},{"_186":238,"_13":239,"_28":240,"_190":241,"_192":242,"_194":195},{"_186":232,"_13":233,"_28":234,"_190":235,"_192":236,"_194":195},{"_186":228,"_13":229,"_28":230,"_190":231,"_192":145,"_194":195},{"_186":222,"_13":223,"_28":224,"_190":225,"_192":226,"_194":198},{"_186":216,"_13":217,"_28":218,"_190":219,"_192":220,"_194":195},{"_186":210,"_13":211,"_28":212,"_190":213,"_192":214,"_194":195},{"_186":204,"_13":205,"_28":206,"_190":207,"_192":208,"_194":195},{"_186":199,"_13":200,"_28":201,"_190":202,"_192":21,"_194":195},{"_186":187,"_13":188,"_28":189,"_190":191,"_192":193,"_194":195},"id","k04ilqg9s0fa5seo9mrr2tsc0","F5 披露 NGINX 远程代码执行漏洞 CVE-2026-123633 与 CVE-2026-123007","F5 于 18 novembre 2026 披露 CVE-2026-123633 与 CVE-2026-123007，未认证攻击者可利用 HTTP/2 在 NGINX Open Source 和 NGINX Plus 上远程执行代码。","source",{"_56":196,"_197":198},"publishedAt","2026-11-18T00:00:00.000Z","selected",true,"CERT-FR","firstParty",false,"vtnlqahysuq4nbnn9rx69mhj2","F5 与 Rapid7 披露 NGINX HTTP/2 整数下溢漏洞 CVE-2026-123007，可导致 RCE","F5 与 Rapid7 披露 NGINX HTTP/2 整数下溢漏洞 CVE-2026-123007，未认证远程攻击者在特定条件下可触发内存破坏，以 nginx worker process 权限执行代码。",{"_56":203,"_197":195},"Rapid7 CVE 公告","qfh0sjsz9ouip54rdzkoulw18","nginx 五个远程代码执行漏洞 CVE-2026-123007 等已复现，官方发布 1.31.9 与 1.30.7 修复","长亭安全应急响应中心披露并复现 nginx2root，包含 CVE-2026-123007、CVE-2026-123634、CVE-2026-123633、CVE-2026-121810 和 CVE-2026-113425 五个可独立触发的远程代码执行漏洞。",{"_56":209,"_197":195},"2026-11-18T18:28:00.000Z","长亭安全应急响应中心","cwu93v3xv2cyladm64pf9ngtg","NGINX HTTP/2 漏洞 CVE-2026-123007 可实现未认证代码执行","F5 披露 NGINX HTTP/2 漏洞 CVE-2026-123007，自 1.9.5 起存在，未认证攻击者在启用 HTTP/2 且可绕过或关闭 ASLR 的情况下可执行代码，获得 NGINX worker 进程权限；公开 PoC 已验证利用，研究人员称目前尚无真实攻击报告，CISA KEV 也尚未收录。",{"_56":215,"_197":198},"2026-11-18T18:31:17.000Z","The Hacker News","mbxeacdusn1z4f6sixt69mp51","nginx 5 个远程代码执行漏洞披露，CVE-2026-123007 PoC 已公开","nginx 5 个内存破坏类远程代码执行漏洞已披露，其中 CVE-2026-123007 为 HTTP/2 流控整数下溢导致的堆越界读写，PoC 与技术细节已公开，但未发现其在野利用。",{"_56":221,"_197":198},"2026-11-18T23:54:38.010Z","安全内参","sxwlzz7u7rt5txga45723fqlj","Nginx 5个远程代码执行漏洞 CVE-2026-123007等已修复","Nginx和F5修复了被统称为“nginx2root”的5个远程代码执行漏洞，CVE-2026-123007、CVE-2026-123634、CVE-2026-123633、CVE-2026-121810、CVE-2026-113425的CVSS评分均为9.2。",{"_56":227,"_197":195},"2026-11-19T04:40:00.000Z","绿盟科技CERT","vz2s0iiyais2z5fhoqzbrdk5e","nginx 披露 NGINX2Root 五个 RCE 漏洞，CVE-2026-123007 与 CVE-2026-123633 CVSS 4.0 均为 9.2","nginx 与 F5 披露 NGINX2Root 五个 RCE 漏洞，未认证攻击者可经 HTTP/2 触发内存破坏，并与 Linux 内核 SCTP 漏洞串联取得 root、逃逸 Docker 容器访问宿主机。",{"_56":59,"_197":198},"u5of3sbmjv5zvaxsxp6jgty56","nginx2root 披露 5 个 nginx 严重漏洞及 Linux 内核提权链","Xint Research 披露 nginx2root，包含 5 个 CVSS 4.0 9.2 的 nginx 严重漏洞及 1 个 Linux 内核 SCTP 缺陷，其中 CVE-2026-123007 可被未认证远程攻击者利用，结合内核缺陷可在主机上取得 root。",{"_56":237,"_197":198},"2026-11-19T09:21:19.000Z","Security Affairs","y2rg6xqvlodeoy597yrc3i73v","F5 修复五个 NGINX2Root 严重漏洞，公开 PoC 已出现","F5 修复了 22 个漏洞，其中 CVE-2026-113425、CVE-2026-121810、CVE-2026-123007、CVE-2026-123633 和 CVE-2026-123634 可导致未认证远程代码执行（RCE），CVSS 均为 9.2。",{"_56":243,"_197":198},"2026-11-19T10:26:51.000Z","SecurityWeek","c8b2ju0hys8b2juzoewmsbw7n","F5 修复 NGINX HTTP/2 漏洞 CVE-2026-123007 与 CVE-2026-123633","F5 修复了 NGINX HTTP/2 实现中的两个漏洞，CVE-2026-123007 与 CVE-2026-123633 的 CVSS 均为 9.2，攻击者可在无需认证的条件下执行代码。",{"_56":249,"_197":198},"2026-11-19T12:02:10.000Z","Hackread","uicqqffy2ih3bz033lumwopzg","NGINX 两项 HTTP/2 严重漏洞可被未认证攻击者用于远程代码执行，其中 CVE-2026-123007 影响 1.9.5 至 1.31.8，CVE-2026-123633 影响 1.19.7 至 1.31.8，后者还需 NGINX 将请求代理至后端。",{"_56":253,"_197":198},"BleepingComputer",{"_186":199,"_13":200,"_28":201,"_190":255,"_192":21,"_194":195},{"_56":203,"_197":195},{"_259":269,"_13":270,"_20":248,"_17":172,"_262":271},{"_259":265,"_13":266,"_20":145,"_17":172,"_262":267},{"_259":260,"_13":261,"_20":21,"_17":134,"_262":263},"factId","fDXki9WjLuc0","Rapid7披露NGINX HTTP/2整数下溢漏洞","representative",{"_186":199,"_13":200,"_28":201,"_190":264,"_192":21,"_194":195},{"_56":203,"_197":195},"fwUG-tHxEr3M","披露并分析NGINX2Root漏洞链",{"_186":228,"_13":229,"_28":230,"_190":268,"_192":145,"_194":195},{"_56":59,"_197":198},"fo9Y-lJvdV-M","F5修复NGINX两项HTTP/2漏洞",{"_186":244,"_13":245,"_28":246,"_190":272,"_192":248,"_194":198},{"_56":249,"_197":198},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",{"_280":281,"_282":-5},"changelogVersion","2026-10-01T08:00","release"]
