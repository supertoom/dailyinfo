[{"_1":2,"_3":4},"root",{"_5":131},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795048843000,"publicId","92393685-eb8c-4aaf-b313-1b8098f352d3","title","NGINX HTTP/2漏洞已修复，暂无真实利用报告","status","active","reportCount",3,"sourceCount","firstReportAt","2026-11-18T13:56:42.000Z","latestAt","2026-11-18T18:31:17.000Z","digest","F5与Rapid7披露NGINX HTTP/2整数下溢漏洞CVE-2026-123007，在启用HTTP/2和TLS且满足特定条件时，未认证远程攻击者可触发内存破坏，并以nginx worker process权限执行代码；公开PoC已验证利用，但截至披露时，供应商及Wiz、Rapid7研究人员均未报告真实攻击，CISA KEV也尚未收录。\n\n该漏洞影响开源NGINX 1.9.5至1.31.8，修复版本为1.31.9和1.30.7。其代码执行并非无条件成立：需传输约128 GB的HTTP/2数据，低于约300 Mbit/s会受默认一小时连接生命周期限制；公开利用策略还依赖运行时选中的特定x86-64 glibc EVEX/YMM memcpy实现，要求CPU具备avx512f和avx512vl特性。","digestUpdatedAt","2026-11-18T19:51:04.829Z","summary","excerpt","latest","NGINX HTTP/2 漏洞 CVE-2026-123007 可实现未认证代码执行","latestReport",{"_93":111},"whyHot",{"_124":74,"_125":126,"_127":74,"_128":102,"_129":130},"developments",[117],"officialReports",[115],"timeline",[90,91,92],"heat",[62,63,64,65,66,67,68,69],"related",[],"topics",[48,49,50,51],{"_52":60,"_54":61},{"_52":58,"_54":59},{"_52":56,"_54":57},{"_52":53,"_54":55},"slug","research","name","技术研究","exploited","在野利用","rapid7","Rapid7 / Metasploit","vuln","漏洞披露",{"_70":88,"_42":89,"_73":87},{"_70":85,"_42":86,"_73":87},{"_70":83,"_42":84,"_73":74},{"_70":81,"_42":82,"_73":74},{"_70":79,"_42":80,"_73":74},{"_70":77,"_42":78,"_73":74},{"_70":75,"_42":76,"_73":74},{"_70":71,"_42":72,"_73":74},"hour","2026-11-19T00:00:00.000Z",16,"participants",2,"2026-11-18T23:00:00.000Z",16.5,"2026-11-18T22:00:00.000Z",17,"2026-11-18T21:00:00.000Z",17.5,"2026-11-18T20:00:00.000Z",18,"2026-11-18T19:00:00.000Z",18.5,"2026-11-18T18:00:00.000Z",8.9,1,"2026-11-18T17:00:00.000Z",9.2,{"_93":111,"_13":31,"_28":112,"_97":113,"_99":23,"_101":102},{"_93":106,"_13":107,"_28":108,"_97":109,"_99":21,"_101":102},{"_93":94,"_13":95,"_28":96,"_97":98,"_99":100,"_101":102},"id","k04ilqg9s0fa5seo9mrr2tsc0","F5 披露 NGINX 远程代码执行漏洞 CVE-2026-123633 与 CVE-2026-123007","F5 于 18 novembre 2026 披露 CVE-2026-123633 与 CVE-2026-123007，未认证攻击者可利用 HTTP/2 在 NGINX Open Source 和 NGINX Plus 上远程执行代码。","source",{"_54":103,"_104":105},"publishedAt","2026-11-18T00:00:00.000Z","selected",true,"CERT-FR","firstParty",false,"vtnlqahysuq4nbnn9rx69mhj2","F5 与 Rapid7 披露 NGINX HTTP/2 整数下溢漏洞 CVE-2026-123007，可导致 RCE","F5 与 Rapid7 披露 NGINX HTTP/2 整数下溢漏洞 CVE-2026-123007，未认证远程攻击者在特定条件下可触发内存破坏，以 nginx worker process 权限执行代码。",{"_54":110,"_104":102},"Rapid7 CVE 公告","cwu93v3xv2cyladm64pf9ngtg","F5 披露 NGINX HTTP/2 漏洞 CVE-2026-123007，自 1.9.5 起存在，未认证攻击者在启用 HTTP/2 且可绕过或关闭 ASLR 的情况下可执行代码，获得 NGINX worker 进程权限；公开 PoC 已验证利用，研究人员称目前尚无真实攻击报告，CISA KEV 也尚未收录。",{"_54":114,"_104":105},"The Hacker News",{"_93":106,"_13":107,"_28":108,"_97":116,"_99":21,"_101":102},{"_54":110,"_104":102},{"_118":119,"_13":120,"_20":21,"_17":74,"_121":122},"factId","fDXki9WjLuc0","Rapid7披露NGINX HTTP/2整数下溢漏洞","representative",{"_93":106,"_13":107,"_28":108,"_97":123,"_99":21,"_101":102},{"_54":110,"_104":102},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",10,{"_132":133,"_134":-5},"changelogVersion","2026-10-01T08:00","release"]
