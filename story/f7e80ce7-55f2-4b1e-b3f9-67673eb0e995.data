[{"_1":2,"_3":4},"root",{"_5":138},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":14,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46},"expiresAt",1794876039000,"publicId","f7e80ce7-55f2-4b1e-b3f9-67673eb0e995","title","企业智能体安全治理聚焦身份、权限与责任","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-16T04:52:20.587Z","latestAt","2026-11-16T08:16:00.000Z","digest","虎符智库提出企业智能体安全治理框架，主张为智能体配置独立身份认证、多层授权和最小权限，并按任务风险、数据敏感性与操作可逆性动态调整自主执行程度；目前未见已确认的实际利用事件或受影响规模。\n\n框架要求对重要数据访问、外部信息发送、关键系统修改及不可逆操作设置独立校验、审批和阻断机制，覆盖部署、运行、监测和处置阶段，并保留行为审计与责任追溯能力；敏感数据、重要业务决策及不可逆任务还需加强人工监督。\n\n报道指出，现行法律框架下智能体不具有独立民事主体资格，其自主性不意味着可独立承担法律责任。发生损害时，赔偿责任仍需结合授权范围、企业管理、员工指令、技术服务提供方义务及各方过错认定。","digestUpdatedAt","2026-11-16T11:51:41.006Z","summary","excerpt","latest","latestReport",{"_110":121},"whyHot",{"_130":18,"_131":132,"_133":18,"_134":135,"_136":137},"developments",[124],"officialReports",[],"timeline",[108,109],"heat",[64,65,66,67,68,69,70,71,72,73,74,75,76,77],"related",[],"topics",[47,48,49,50,51],{"_52":62,"_54":63},{"_52":60,"_54":61},{"_52":58,"_54":59},{"_52":56,"_54":57},{"_52":53,"_54":55},"slug","ai-agent","name","AI Agent 安全","incident","应急响应","ai-security","AI 安全","identity","身份与访问","qianxin","奇安信",{"_78":106,"_41":107,"_81":18},{"_78":104,"_41":105,"_81":18},{"_78":102,"_41":103,"_81":18},{"_78":100,"_41":101,"_81":18},{"_78":98,"_41":99,"_81":18},{"_78":96,"_41":97,"_81":18},{"_78":94,"_41":95,"_81":18},{"_78":92,"_41":93,"_81":18},{"_78":90,"_41":91,"_81":18},{"_78":88,"_41":89,"_81":18},{"_78":86,"_41":87,"_81":18},{"_78":84,"_41":85,"_81":18},{"_78":82,"_41":83,"_81":18},{"_78":79,"_41":80,"_81":18},"hour","2026-11-17T00:00:00.000Z",12.1,"participants","2026-11-16T23:00:00.000Z",12.5,"2026-11-16T22:00:00.000Z",12.8,"2026-11-16T21:00:00.000Z",13.2,"2026-11-16T20:00:00.000Z",13.6,"2026-11-16T19:00:00.000Z",14,"2026-11-16T18:00:00.000Z",14.4,"2026-11-16T17:00:00.000Z",14.8,"2026-11-16T16:00:00.000Z",15.2,"2026-11-16T15:00:00.000Z",15.7,"2026-11-16T14:00:00.000Z",16.2,"2026-11-16T13:00:00.000Z",16.6,"2026-11-16T12:00:00.000Z",17.1,"2026-11-16T11:00:00.000Z",17.6,{"_110":121,"_13":14,"_28":122,"_114":123,"_116":23,"_117":118},{"_110":111,"_13":112,"_28":113,"_114":115,"_116":21,"_117":118},"id","ehszz1wv94xd1n4mvtp1iudru","企业智能体安全治理框架：身份、权限与责任","企业智能体从内容生成转向自主规划和工具调用后，风险由模型内容问题扩展为越权操作、提示词注入和跨系统链路扩散。文章提出独立身份认证、多层授权与最小权限、动态审批、完整审计及应急响应机制，并强调按任务风险、数据敏感性和操作可逆性配置自主执行程度。当前智能体不具有独立民事主体资格，损害责任仍需结合授权范围、企业管理、员工指令、技术服务提供方义务及各方过错认定。","source",{"_54":119,"_120":118},"publishedAt","selected",false,"安全内参","firstParty","qowjd2tpjil9k9xcy9u3bnti9","虎符智库提出企业智能体安全治理框架，覆盖智能体独立身份、多层授权、最小权限、行为审计与责任追溯。治理应贯穿部署、运行、监测和处置阶段，对敏感数据访问、外部信息发送、关键系统修改及不可逆操作实施校验、审批和阻断，并根据任务风险动态调整自主执行程度。",{"_54":119,"_120":118},{"_125":126,"_13":112,"_20":21,"_17":18,"_127":128},"factId","fN92o-uGcy6Y","representative",{"_110":121,"_13":14,"_28":122,"_114":129,"_116":23,"_117":118},{"_54":119,"_120":118},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete",true,"rank",7,{"_139":140,"_141":-5},"changelogVersion","2026-10-01T08:00","release"]
