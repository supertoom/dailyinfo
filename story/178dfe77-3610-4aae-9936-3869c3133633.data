[{"_1":2,"_3":4},"root",{"_5":159},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795048843000,"publicId","178dfe77-3610-4aae-9936-3869c3133633","title","Scattered Spider头目Buchanan窃取加密资产获刑72个月","status","active","reportCount",3,"sourceCount","firstReportAt","2026-11-18T08:24:18.000Z","latestAt","2026-11-18T14:46:34.000Z","digest","美国联邦法院将Scattered Spider头目、苏格兰人Tyler Robert Buchanan（24岁）判处72个月联邦监禁，罪名是合谋电汇欺诈与加重身份盗用，认定他在2021年9月至2023年4月参与的钓鱼攻击中窃取逾1160万美元虚拟货币。\n\n检方称，该团伙向电信、科技、互动娱乐、云通信及加密货币公司的员工发送数百条短信钓鱼诱饵，骗取凭据后侵入员工账户与公司系统，窃取机密信息；随后通过SIM卡调换（SIM swapping）控制受害者号码，拦截短信或语音双因素验证码以绕过双因素认证，盗走逾1160万美元加密资产，被入侵企业确认逾十家。\n\n细节存在出入：SecurityWeek称其2024年在西班牙被捕（5月）、2026年4月认罪时涉案金额为800万美元，后续报道升至1160万美元；另两篇称他2024年6月在西班牙帕尔马被逮捕、2025年4月起被美方羁押、2026年4月认罪。受影响机构名称尚未披露。","digestUpdatedAt","2026-11-18T15:44:40.439Z","summary","excerpt","latest","Scattered Spider 成员 Tyler Robert Buchanan 因钓鱼和 SIM 劫取攻击被判 72 个月","latestReport",{"_123":140},"whyHot",{"_151":18,"_152":153,"_154":18,"_155":156,"_157":158},"developments",[144],"officialReports",[],"timeline",[120,121,122],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","cisa","name","CISA","malware","恶意软件","black-market","数据窃取与黑产","identity","身份与访问","attack","攻击活动","email","邮件与钓鱼",{"_84":118,"_42":119,"_87":111},{"_84":116,"_42":117,"_87":111},{"_84":114,"_42":115,"_87":111},{"_84":112,"_42":113,"_87":111},{"_84":109,"_42":110,"_87":111},{"_84":106,"_42":107,"_87":108},{"_84":104,"_42":105,"_87":18},{"_84":102,"_42":103,"_87":18},{"_84":100,"_42":101,"_87":18},{"_84":98,"_42":99,"_87":18},{"_84":96,"_42":97,"_87":18},{"_84":94,"_42":95,"_87":18},{"_84":92,"_42":93,"_87":18},{"_84":90,"_42":91,"_87":18},{"_84":88,"_42":89,"_87":18},{"_84":85,"_42":86,"_87":18},"hour","2026-11-19T00:00:00.000Z",21.4,"participants","2026-11-18T23:00:00.000Z",22,"2026-11-18T22:00:00.000Z",22.7,"2026-11-18T21:00:00.000Z",23.3,"2026-11-18T20:00:00.000Z",24,"2026-11-18T19:00:00.000Z",24.7,"2026-11-18T18:00:00.000Z",25.4,"2026-11-18T17:00:00.000Z",26.2,"2026-11-18T16:00:00.000Z",26.9,"2026-11-18T15:00:00.000Z",27.7,"2026-11-18T14:00:00.000Z",18.3,2,"2026-11-18T13:00:00.000Z",8.8,1,"2026-11-18T12:00:00.000Z",9,"2026-11-18T11:00:00.000Z",9.3,"2026-11-18T10:00:00.000Z",9.5,"2026-11-18T09:00:00.000Z",9.8,{"_123":140,"_13":31,"_28":141,"_127":142,"_129":23,"_130":131},{"_123":134,"_13":135,"_28":136,"_127":137,"_129":138,"_130":131},{"_123":124,"_13":125,"_28":126,"_127":128,"_129":21,"_130":131},"id","nak1693s23kf9rvc6o6mb8f18","Scattered Spider英国头目因窃取逾$11.6 million加密资产获刑6年","Scattered Spider英国头目Tyler Robert Buchanan因参与2021年9月至2023年4月针对十余家公司的钓鱼攻击及窃取加密资产，在美国被判刑6年。","source",{"_56":132,"_133":131},"publishedAt","selected",false,"BleepingComputer","firstParty","ashsckx0sofr89xu47hp72p9f","Scattered Spider 成员因钓鱼窃取至少 $11.6 million 加密货币被美国判刑 6 年","Scattered Spider 成员 Tyler Robert Buchanan 因参与合谋入侵企业并窃取个人加密货币，被美国联邦法院判处 6 年监禁。",{"_56":139,"_133":131},"2026-11-18T13:19:32.000Z","SecurityWeek","iwcl7dn06xwyrk0conpj9w6q2","美国司法部称，苏格兰黑客 Tyler Robert Buchanan 因 SMS 钓鱼、SIM 劫取及盗窃虚拟货币被判处 72 个月联邦监禁。2021年至2023年，他与团伙至少入侵十多家公司，诱骗员工在仿冒网站提交凭据和个人信息，再利用窃取的数据侵入企业系统、加密货币账户及钱包，共盗取超过 $11.6 million。",{"_56":143,"_133":131},"Security Affairs",{"_145":146,"_13":147,"_20":21,"_17":18,"_148":149},"factId","fAxWtYzMBIiU","Scattered Spider头目获刑六年","representative",{"_123":124,"_13":125,"_28":126,"_127":150,"_129":21,"_130":131},{"_56":132,"_133":131},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete",true,"rank",7,{"_160":161,"_162":-5},"changelogVersion","2026-10-01T08:00","release"]
