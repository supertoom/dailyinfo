段性部署缺陷，诱使 Windows Defender 以 SYSTEM 权限创建认证文件，使本地攻击者实现权限提升，并可能绕过其他安全产品的自我防御或防篡改机制。",{"_54":238,"_221":222},"Security Affairs",{"_241":247,"_13":248,"_20":227,"_17":206,"_244":249},{"_241":242,"_13":243,"_20":21,"_17":129,"_244":245},"factId","fkkOn4gdRkiA","公开 SignDrop Windows 零日利用","representative",{"_211":229,"_13":230,"_28":231,"_215":246,"_217":233,"_218":219},{"_54":234,"_221":222},"fzX64zbdUKtw","公开SignDrop本地提权利用代码",{"_211":223,"_13":224,"_28":225,"_215":250,"_217":227,"_218":219},{"_54":228,"_221":222},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",10,{"_259":260,"_261":-5},"changelogVersion","2026-10-01T08:00","release"]
