[{"_1":2,"_3":4},"root",{"_5":258},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794703237000,"publicId","b1d88153-27ef-4511-ab17-98b25a2dfedc","title","SignDrop Windows 提权 PoC 已公开","status","watching","reportCount",4,"sourceCount","firstReportAt","2026-11-12T16:04:00.000Z","latestAt","2026-11-13T09:02:00.000Z","digest","安全研究员 Abdelhamid Naceri（MSNightmare、Chaotic Eclipse）公开了 Windows CLFS 驱动本地权限提升漏洞 SignDrop 的 PoC，可借路径重定向和 .cnpf 伴生文件链式启动 SYSTEM shell，使标准用户获得 SYSTEM 权限；目前尚无已确认的在野利用，Microsoft 尚未确认漏洞、分配 CVE 或发布修复，CISA 已知遭利用漏洞目录也未收录。\n\n公开利用链要求 CLFS 认证注册表模式为 0（强制）或 1（学习），且 Windows Defender 必须启用。Naceri 在 Windows 11 26H2、Windows 11 26H2 Experimental 和 Windows Server 2025 Experimental 上完成测试，并估计约 80% 的 Windows 安装可能受影响，但该利用不适用于所有机器。关闭 CLFS 缓解措施会暴露于利用内存破坏漏洞的攻击，目前可行应对是等待 Microsoft 补丁。","digestUpdatedAt","2026-11-13T11:55:05.094Z","summary","excerpt","latest","SignDrop 利用 Windows CLFS 缓解机制缺陷实现 SYSTEM 权限提升","latestReport",{"_211":235},"whyHot",{"_251":114,"_252":253,"_254":253,"_255":219,"_256":257},"developments",[239,240],"officialReports",[],"timeline",[207,208,209,210],"heat",[62,63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109],"related",[],"topics",[48,49,50,51],{"_52":60,"_54":61},{"_52":58,"_54":59},{"_52":56,"_54":57},{"_52":53,"_54":55},"slug","research","name","技术研究","exploited","在野利用","vuln","漏洞披露","microsoft","Microsoft / 微软",{"_110":204,"_42":205,"_113":206},{"_110":203,"_42":141,"_113":114},{"_110":201,"_42":202,"_113":114},{"_110":200,"_42":137,"_113":114},{"_110":198,"_42":199,"_113":114},{"_110":196,"_42":197,"_113":114},{"_110":194,"_42":195,"_113":114},{"_110":192,"_42":193,"_113":114},{"_110":190,"_42":191,"_113":114},{"_110":188,"_42":189,"_113":114},{"_11