[{"_1":2,"_3":4},"root",{"_5":126},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794530497000,"publicId","b1d88153-27ef-4511-ab17-98b25a2dfedc","title","SignDrop Windows 零日利用公开","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-12T16:04:00.000Z","latestAt","2026-11-12T17:50:27.000Z","digest","安全研究员 Abdelhamid Naceri（MSNightmare）公开了 Windows CLFS 驱动本地权限提升漏洞 SignDrop 的 PoC，称其可通过路径重定向和 .cnpf 伴生文件链式启动 SYSTEM shell，使标准用户获得 SYSTEM 权限；目前尚无已确认的在野利用，Microsoft 也未确认漏洞、分配 CVE 或发布修复。\n\n公开利用链要求 CLFS 认证注册表模式为 0（强制）或 1（学习），且 Windows Defender 必须启用。Naceri 在 Windows 11 26H2、Windows 11 26H2 Experimental 和 Windows Server 2025 Experimental 上完成测试，并估计约 80% 的 Windows 安装可能受影响，但该利用不适用于所有机器。\n\n目前唯一可行应对是等待 Microsoft 补丁；Naceri 警告，关闭 CLFS 缓解措施会暴露于利用内存破坏漏洞的攻击。","digestUpdatedAt","2026-11-12T18:21:54.515Z","summary","excerpt","latest","SignDrop PoC 利用 Windows CLFS 认证机制实现 SYSTEM 权限提升","latestReport",{"_91":103},"whyHot",{"_119":18,"_120":121,"_122":18,"_123":99,"_124":125},"developments",[107,108],"officialReports",[],"timeline",[89,90],"heat",[62,63,64,65,66,67,68,69],"related",[],"topics",[48,49,50,51],{"_52":60,"_54":61},{"_52":58,"_54":59},{"_52":56,"_54":57},{"_52":53,"_54":55},"slug","research","name","技术研究","exploited","在野利用","vuln","漏洞披露","microsoft","Microsoft / 微软",{"_70":86,"_42":87,"_73":88},{"_70":84,"_42":85,"_73":18},{"_70":82,"_42":83,"_73":18},{"_70":80,"_42":81,"_73":18},{"_70":78,"_42":79,"_73":18},{"_70":76,"_42":77,"_73":18},{"_70":74,"_42":75,"_73":18},{"_70":71,"_42":72,"_73":18},"hour","2026-11-13T00:00:00.000Z",16.3,"participants","2026-11-12T23:00:00.000Z",16.8,"2026-11-12T22:00:00.000Z",17.3,"2026-11-12T21:00:00.000Z",17.8,"2026-11-12T20:00:00.000Z",18.3,"2026-11-12T19:00:00.000Z",18.9,"2026-11-12T18:00:00.000Z",19.4,"2026-11-12T17:00:00.000Z",9.7,1,{"_91":103,"_13":31,"_28":104,"_95":105,"_97":23,"_98":99},{"_91":92,"_13":93,"_28":94,"_95":96,"_97":21,"_98":99},"id","azhhxogo2ze95f84syty9k82z","Windows CLFS 漏洞 SignDrop 可借助特权进程获取 SYSTEM 权限","安全研究员 Abdelhamid Naceri 公开了 Windows CLFS 漏洞 SignDrop 的 PoC，可诱导 Windows Defender 等特权进程创建认证文件并借此获取 SYSTEM 权限。","source",{"_54":100,"_101":102},"publishedAt","selected",true,"BleepingComputer","firstParty",false,"vg18mgfk9qqhb8fj6zco29xou","研究者 MSNightmare 公开 SignDrop PoC，利用 Windows Common Log File System 驱动创建 .cnpf 伴生文件时的路径重定向，使标准用户获得可写的 SYSTEM 文件并可链式启动 SYSTEM shell。",{"_54":106,"_101":102},"The Hacker News",{"_109":115,"_13":116,"_20":23,"_17":88,"_112":117},{"_109":110,"_13":111,"_20":21,"_17":88,"_112":113},"factId","fkkOn4gdRkiA","公开 SignDrop Windows 零日利用","representative",{"_91":92,"_13":93,"_28":94,"_95":114,"_97":21,"_98":99},{"_54":100,"_101":102},"fzX64zbdUKtw","公开SignDrop本地提权利用代码",{"_91":103,"_13":31,"_28":104,"_95":118,"_97":23,"_98":99},{"_54":106,"_101":102},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",9,{"_127":128,"_129":-5},"changelogVersion","2026-10-01T08:00","release"]
