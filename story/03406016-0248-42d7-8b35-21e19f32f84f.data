[{"_1":2,"_3":4},"root",{"_5":299},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795653656000,"publicId","03406016-0248-42d7-8b35-21e19f32f84f","title","GT13攻陷至少22家机构Check Point服务器","status","active","reportCount",5,"sourceCount","firstReportAt","2026-11-22T16:00:00.000Z","latestAt","2026-11-25T10:47:10.000Z","digest","GreyNoise披露，GT13已入侵全球至少22家机构的24台Check Point Security Management Servers，取得SSH访问权限，并用于环境扫描、数据外传和维持持久访问；确认的攻击活动发生于2026年10月17日至11月2日，受害机构分布于17个国家。GreyNoise于11月2日失去可见性，但认为攻击可能仍在持续，并已通知政府合作伙伴及CERT机构。\n\n初始入侵方式及时间尚无法确定。GreyNoise观察到攻击者在入侵后的阶段利用CVE-2026-16232；该漏洞此前已披露且已有补丁，并非新漏洞。GT13尚未被归因于已知或公开追踪的威胁组织。GreyNoise还称攻击使用99个IP地址开展扫描、利用和控制，并推测使用AI代理框架，但AI使用情况尚未证实。","digestUpdatedAt","2026-11-25T11:21:39.492Z","summary","excerpt","latest","GT13 利用 AI 工具攻击 22 家组织并入侵 Check Point 管理服务器","latestReport",{"_246":276},"whyHot",{"_292":129,"_293":294,"_295":167,"_296":254,"_297":298},"developments",[280,281],"officialReports",[],"timeline",[241,242,243,244,245],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","ai-offense","name","AI 攻防","black-market","数据窃取与黑产","ransomware","勒索软件","exploited","在野利用","attack","攻击活动","checkpoint","Check Point",{"_125":240,"_42":18,"_128":196},{"_125":238,"_42":239,"_128":196},{"_125":236,"_42":237,"_128":196},{"_125":234,"_42":235,"_128":196},{"_125":232,"_42":233,"_128":196},{"_125":230,"_42":231,"_128":196},{"_125":228,"_42":229,"_128":196},{"_125":226,"_42":227,"_128":196},{"_125":225,"_42":129,"_128":196},{"_125":223,"