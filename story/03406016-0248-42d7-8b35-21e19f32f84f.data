[{"_1":2,"_3":4},"root",{"_5":213},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795567297000,"publicId","03406016-0248-42d7-8b35-21e19f32f84f","title","GT13入侵至少22家机构管理服务器","status","active","reportCount",3,"sourceCount","firstReportAt","2026-11-22T16:00:00.000Z","latestAt","2026-11-24T16:15:23.000Z","digest","GreyNoise披露，GT13已入侵至少22家组织的24台Check Point Security Management Servers；攻击者取得SSH访问权限，用于环境扫描、数据外传并维持持久访问。22家机构分布于17个国家，覆盖能源、工程、金融、政府、制造、采矿和运输等行业；尽管GreyNoise于11月2日失去可见性，仍认为攻击可能持续。\n\nGreyNoise确认活动发生于2026年10月17日至11月2日，并观察到攻击者在入侵后的阶段利用CVE-2026-16232，但尚无法确定服务器最初何时及如何被攻破。相关报道未给出受影响版本、认证前提、CVSS评分或补丁状态；GT13也未被归属至已知或公开追踪的威胁组织。","digestUpdatedAt","2026-11-24T16:39:55.829Z","summary","excerpt","latest","GreyNoise 发现攻击者入侵 22 家组织的 Check Point 管理服务器","latestReport",{"_172":190},"whyHot",{"_206":105,"_207":208,"_209":105,"_210":180,"_211":212},"developments",[194,195],"officialReports",[],"timeline",[169,170,171],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","ai-offense","name","AI 攻防","exploited","在野利用","black-market","数据窃取与黑产","ransomware","勒索软件","attack","攻击活动","checkpoint","Check Point",{"_101":167,"_42":168,"_104":122},{"_101":165,"_42":166,"_104":122},{"_101":163,"_42":164,"_104":122},{"_101":161,"_42":162,"_104":122},{"_101":159,"_42":160,"_104":122},{"_101":157,"_42":158,"_104":122},{"_101":155,"_42":156,"_104":122},{"_101":153,"_42":154,"_104":122},{"_101":151,"_42":152,"_104":122},{"_101":149,"_42":150,"_104":122},{"_101":147,"_42":148,"_104":122},{"_101":145,"_42":146,"_104":122},{"_101":143,"_42":144,"_104":122},{"_101":141,"_42":142,"_