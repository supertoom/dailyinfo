[{"_1":2,"_3":4},"root",{"_5":383},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":-5,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48},"expiresAt",1795567297000,"publicId","94471d20-e283-4a73-a257-3bf90d7be5de","title","欧盟委员会确认EU Academy用户数据泄露","status","active","reportCount",9,"sourceCount",7,"firstReportAt","2026-11-19T12:12:26.000Z","latestAt","2026-11-24T20:29:25.000Z","digest","欧盟委员会发言人Thomas Regnier确认，近期AI辅助网络攻击导致在线学习平台EU Academy泄露用户姓名和电子邮件地址，调查仍在进行、影响规模尚未确定，平台公共访问已暂停，EDPS已获通知，潜在受影响用户尚未直接获知。\n\n委员会称攻击已大体受控，但没有证据显示全体委员会员工的数据被盗，也未收到勒索要求；部分内部应用仍处于暂时或持续下线状态，攻击是否结束及攻击者身份均未确认。关于攻击者使用ARTEX AI渗透测试框架，早先报道将其描述为实际入侵方式，后续报道则仅称该工具被疑使用，尚未成为官方归因结论。","digestUpdatedAt","2026-11-24T22:08:39.037Z","summary","excerpt","latest","European Commission 遭 AI 赋能网络攻击，EU Academy 用户姓名与邮箱泄露","latestReport",{"_304":357},"whyHot",{"_377":151,"_378":379,"_380":151,"_381":320,"_382":151},"developments",[360,361,362],"officialReports",[],"timeline",[295,296,297,298,299,300,301,302,303],"heat",[69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130,131,132,133,134,135,136,137,138,139,140,141,142,143,144,145,146],"related",[],"topics",[49,50,51,52,53,54],{"_55":67,"_57":68},{"_55":65,"_57":66},{"_55":63,"_57":64},{"_55":61,"_57":62},{"_55":59,"_57":60},{"_55":56,"_57":58},"slug","email","name","邮件与钓鱼","ai-security","AI 安全","red-team","红队与渗透","supply-chain","供应链安全","ai-offense","AI 攻防","attack","攻击活动",{"_147":293,"_43":294,"_150":169},{"_147":292,"_43":166,"_150":160},{"_147":291,"_43":249,"_150":151},{"_147":289,"_43":290,"_150":151},{"_147":288,"_43":245,"_150":151},{"_147":287,"_43":243,"_150":151},{"_147":286,"_43":241,"_150":151},{"_147":284,"_43":285,"_150":151},{"_147":282,"_43":283,"_150":151},{"