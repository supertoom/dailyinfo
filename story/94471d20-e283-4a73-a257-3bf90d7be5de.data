30.9,"2026-11-20T15:00:00.000Z",31.8,"2026-11-20T14:00:00.000Z",32.8,"2026-11-20T13:00:00.000Z",33.7,"2026-11-20T12:00:00.000Z",34.7,"2026-11-20T11:00:00.000Z",35.7,"2026-11-20T10:00:00.000Z",26.5,"2026-11-20T09:00:00.000Z",27.3,"2026-11-20T08:00:00.000Z","2026-11-20T07:00:00.000Z","2026-11-20T06:00:00.000Z","2026-11-20T05:00:00.000Z","2026-11-20T04:00:00.000Z",20,"2026-11-20T03:00:00.000Z","2026-11-20T02:00:00.000Z",21.2,"2026-11-20T01:00:00.000Z","2026-11-20T00:00:00.000Z","2026-11-19T23:00:00.000Z","2026-11-19T22:00:00.000Z",23.8,"2026-11-19T21:00:00.000Z",24.5,"2026-11-19T20:00:00.000Z","2026-11-19T19:00:00.000Z","2026-11-19T18:00:00.000Z","2026-11-19T17:00:00.000Z",27.5,"2026-11-19T16:00:00.000Z","2026-11-19T15:00:00.000Z","2026-11-19T14:00:00.000Z",9.5,{"_304":357,"_13":32,"_29":358,"_308":359,"_310":24,"_311":312},{"_304":351,"_13":352,"_29":353,"_308":354,"_310":355,"_311":312},{"_304":346,"_13":347,"_29":348,"_308":349,"_310":350,"_311":312},{"_304":340,"_13":341,"_29":342,"_308":343,"_310":344,"_311":312},{"_304":334,"_13":335,"_29":336,"_308":337,"_310":338,"_311":312},{"_304":328,"_13":329,"_29":330,"_308":331,"_310":332,"_311":312},{"_304":322,"_13":323,"_29":324,"_308":325,"_310":326,"_311":312},{"_304":315,"_13":316,"_29":317,"_308":318,"_310":319,"_311":320},{"_304":305,"_13":306,"_29":307,"_308":309,"_310":22,"_311":312},"id","qowp931bsz29txtjd6ryg3p9g","European Commission 遭网络攻击，目标涉及大量个人数据","European Commission 遭网络攻击，攻击目标涉及“大量个人数据”，但损害的完整范围尚不清楚。原文未说明受影响系统、具体数据规模、攻击组织或已确认的利用细节。","source",{"_57":313,"_314":312},"publishedAt","selected",false,"Cybernews","firstParty","l9hohsjkbs1vdmrgj7b8hg1pm","European Commission 确认遭 AI 驱动网络攻击，多项应用被临时下线","European Commission 确认遭到使用公开 AI 工具实施的网络攻击，入侵于 2026 年 10 月 22 日被发现、10 月 26 日被定性为网络攻击，导致包括员工工资与考勤系统 Sysper、医疗报销系统在内的多项应用被临时下线，目前大部分已恢复。",{"_57":321,"_314":312},"2026-11-19T14:45:00.000Z",true,"Infosecurity Magazine","wfqdxuw3ek7h2epzp39tgpgz4","European Commission 遭网络攻击，ARTEX AI 工具被疑用于持续逾十天的中断","European Commission 内部系统遭网络攻击并中断超过十天，薪资、考勤、休假与医疗报销系统受波及，JSIS 员工医疗保险门户至 19 日仍未恢复。",{"_57":327,"_314":312},"2026-11-19T15:06:40.000Z","Security Affairs","e14iprsjg3swwmupms669jw72","European Commission 确认遭 AI 生成攻击，多个应用一度下线","European Commission 确认遭到利用公开 AI 工具的攻击，导致多个应用一度下线；该事件于10月22日被发现，10月26日经初步调查确认。委员会称多数应用已恢复，调查尚未发现影响全体工作人员的数据泄露证据，也未收到勒索要求，但未确认攻击是否结束或攻击者身份。",{"_57":333,"_314":312},"2026-11-20T08:52:29.000Z","Help Net Security","lkko6dvcciwjk3y2c0uii32o8","欧盟委员会遭 ARTEX AI 攻击，人事管理系统中断至少 10 天","欧盟委员会确认遭到 AI 辅助网络攻击，至少影响人事管理系统及翻译、费用报销工具 10 天，多个应用程序曾被暂时关闭，目前大部分已恢复。欧盟于 10 月 22 日发现事件，称截至目前尚未发现全体工作人员数据遭泄露的证据。CERT-EU 警告，原本用于识别系统漏洞的 ARTEX 渗透测试智能体近期与全球多起攻击有关，其公开可用性可能加快并扩大自动化攻击。",{"_57":339,"_314":312},"2026-11-20T10:24:36.028Z","安全内参","uiyjrx78vel8jrui5m0wo768i","European Commission 确认遭 AI 辅助网络攻击，多项公共服务中断","European Commission 确认其在 10 月下旬遭 AI 辅助网络攻击，HR 平台 Sysper、医疗报销系统 MyPMO 和翻译系统等服务受影响，中断持续超过 10 天。",{"_57":345,"_314":312},"2026-11-20T10:51:42.000Z","SecurityWeek","kvxheyvzs4f89xzsam69efmeh","European Commission 调查确认 EU Academy 遭 AI 辅助攻击导致数据泄露","European Commission 周一确认，近期披露的一起 AI 辅助网络攻击造成 EU Academy 用户姓名和电子邮件地址泄露。攻击于 10 月 22 日被发现并促使多个应用临时关闭，平台访问目前已暂停，EDPS 已获通知；潜在受影响用户尚未被直接通知，泄露规模仍在调查。",{"_57":345,"_314":312},"2026-11-24T14:49:59.000Z","n73cdcdwo8apw4442hmo8myha","European Commission 确认 EU Academy 遭攻击并发生用户数据泄露","European Commission 确认，攻击者于 October 22 使用 ARTEX AI 渗透测试框架入侵其系统，EU Academy 在线学习平台的用户姓名和邮箱等个人信息遭窃取，受影响人数尚未披露。",{"_57":356,"_314":312},"2026-11-24T16:22:44.000Z","BleepingComputer","i0ds4n892mht5b9256akxe5vt","European Commission 确认遭受 AI 赋能网络攻击，EU Academy 用户的姓名和邮箱地址被泄露，平台现已暂停访问。CERT-EU 于 22 October 发现恶意活动，怀疑攻击者使用 AI 渗透测试工具 ARTEX；调查仍在进行，部分内部应用暂时或持续下线，尚无证据确认 Commission 员工数据被盗，也没有官方来源确认攻击者归因。",{"_57":327,"_314":312},{"_363":373,"_13":374,"_21":350,"_17":151,"_366":375},{"_363":369,"_13":370,"_21":332,"_17":160,"_366":371},{"_363":364,"_13":365,"_21":22,"_17":151,"_366":367},"factId","fXfKfI-hw4rI","欧盟委员会遭网络攻击","representative",{"_304":315,"_13":316,"_29":317,"_308":368,"_310":319,"_311":320},{"_57":321,"_314":312},"fHcO5RRBZ0P0","欧盟委员会确认遭 AI 生成网络攻击",{"_304":328,"_13":329,"_29":330,"_308":372,"_310":332,"_311":312},{"_57":333,"_314":312},"fSN2oUynKaRE","欧盟委员会确认攻击导致数据泄露",{"_304":346,"_13":347,"_29":348,"_308":376,"_310":350,"_311":312},{"_57":345,"_314":312},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",{"_384":385,"_386":-5},"changelogVersion","2026-10-01T08:00","release"]
