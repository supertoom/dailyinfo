[{"_1":2,"_3":4},"root",{"_5":144},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795135250000,"publicId","94471d20-e283-4a73-a257-3bf90d7be5de","title","欧盟委员会确认遭AI辅助网络攻击","status","active","reportCount",3,"sourceCount","firstReportAt","2026-11-19T12:12:26.000Z","latestAt","2026-11-19T15:06:40.000Z","digest","欧盟委员会确认，其内部系统遭使用公开AI工具实施的网络攻击，造成中断超过十天；薪资、考勤、休假及医疗报销等系统被临时下线，JSIS员工医疗保险门户截至19日仍未恢复。欧盟官员称，委员会认为攻击主体已被大部分控制，但损害范围仍不清楚。\n\n攻击涉及大量个人数据，但调查人员尚未确认数据是否被访问或窃取。ARTEX AI工具仅被怀疑用于攻击，尚未被证实是实际利用方式，攻击者身份也未确定；目前没有证据确认该事件已被用于其他攻击。","digestUpdatedAt","2026-11-19T16:07:40.953Z","summary","excerpt","latest","European Commission 遭网络攻击，ARTEX AI 工具被疑用于持续逾十天的中断","latestReport",{"_108":126},"whyHot",{"_137":18,"_138":139,"_140":18,"_141":124,"_142":143},"developments",[130],"officialReports",[],"timeline",[105,106,107],"heat",[68,69,70,71,72,73,74,75,76,77,78],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","tools","name","工具与平台","ai-security","AI 安全","supply-chain","供应链安全","ai-offense","AI 攻防","red-team","红队与渗透","attack","攻击活动",{"_79":102,"_42":103,"_82":104},{"_79":99,"_42":100,"_82":101},{"_79":97,"_42":98,"_82":18},{"_79":95,"_42":96,"_82":18},{"_79":93,"_42":94,"_82":18},{"_79":91,"_42":92,"_82":18},{"_79":89,"_42":90,"_82":18},{"_79":87,"_42":88,"_82":18},{"_79":85,"_42":86,"_82":18},{"_79":83,"_42":84,"_82":18},{"_79":80,"_42":81,"_82":18},"hour","2026-11-20T00:00:00.000Z",22.5,"participants","2026-11-19T23:00:00.000Z",23.2,"2026-11-19T22:00:00.000Z",23.8,"2026-11-19T21:00:00.000Z",24.5,"2026-11-19T20:00:00.000Z",25.3,"2026-11-19T19:00:00.000Z",26,"2026-11-19T18:00:00.000Z",26.8,"2026-11-19T17:00:00.000Z",27.5,"2026-11-19T16:00:00.000Z",28.4,"2026-11-19T15:00:00.000Z",19.2,2,"2026-11-19T14:00:00.000Z",9.5,1,{"_108":126,"_13":31,"_28":127,"_112":128,"_114":23,"_115":116},{"_108":119,"_13":120,"_28":121,"_112":122,"_114":123,"_115":124},{"_108":109,"_13":110,"_28":111,"_112":113,"_114":21,"_115":116},"id","qowp931bsz29txtjd6ryg3p9g","European Commission 遭网络攻击，目标涉及大量个人数据","European Commission 遭网络攻击，攻击目标涉及“大量个人数据”，但损害的完整范围尚不清楚。原文未说明受影响系统、具体数据规模、攻击组织或已确认的利用细节。","source",{"_56":117,"_118":116},"publishedAt","selected",false,"Cybernews","firstParty","l9hohsjkbs1vdmrgj7b8hg1pm","European Commission 确认遭 AI 驱动网络攻击，多项应用被临时下线","European Commission 确认遭到使用公开 AI 工具实施的网络攻击，入侵于 2026 年 10 月 22 日被发现、10 月 26 日被定性为网络攻击，导致包括员工工资与考勤系统 Sysper、医疗报销系统在内的多项应用被临时下线，目前大部分已恢复。",{"_56":125,"_118":116},"2026-11-19T14:45:00.000Z",true,"Infosecurity Magazine","wfqdxuw3ek7h2epzp39tgpgz4","European Commission 内部系统遭网络攻击并中断超过十天，薪资、考勤、休假与医疗报销系统受波及，JSIS 员工医疗保险门户至 19 日仍未恢复。",{"_56":129,"_118":116},"Security Affairs",{"_131":132,"_13":133,"_20":21,"_17":18,"_134":135},"factId","fXfKfI-hw4rI","欧盟委员会遭网络攻击","representative",{"_108":119,"_13":120,"_28":121,"_112":136,"_114":123,"_115":124},{"_56":125,"_118":116},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",5,{"_145":146,"_147":-5},"changelogVersion","2026-10-01T08:00","release"]
