[{"_1":2,"_3":4},"root",{"_5":305},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795308047000,"publicId","94471d20-e283-4a73-a257-3bf90d7be5de","title","欧盟委员会确认遭AI辅助网络攻击","status","watching","reportCount",6,"sourceCount","firstReportAt","2026-11-19T12:12:26.000Z","latestAt","2026-11-20T10:51:42.000Z","digest","欧盟委员会确认10月下旬遭利用AI工具的网络攻击，多项内部应用一度下线，包括HR平台Sysper、医疗报销系统MyPMO和翻译系统；目前多数服务已恢复，但攻击是否结束、损害范围及人员数据是否被访问仍未完全确认。\n\n委员会称，调查尚未发现影响全体工作人员的数据泄露证据，也未收到勒索要求，攻击者身份尚未确定。公开AI工具ARTEX此前仅被怀疑用于攻击，尚未证实为实际利用方式；JSIS员工医疗保险门户一度仍未恢复。","digestUpdatedAt","2026-11-20T11:19:54.112Z","summary","excerpt","latest","European Commission 确认遭 AI 辅助网络攻击，多项公共服务中断","latestReport",{"_246":282},"whyHot",{"_298":131,"_299":300,"_301":300,"_302":262,"_303":304},"developments",[286,287],"officialReports",[],"timeline",[240,241,242,243,244,245],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","incident","name","应急响应","supply-chain","供应链安全","ai-security","AI 安全","red-team","红队与渗透","ai-offense","AI 攻防","attack","攻击活动",{"_127":237,"_42":238,"_130":239},{"_127":235,"_42":236,"_130":131},{"_127":234,"_42":192,"_130":150},{"_127":232,"_42":233,"_130":150},{"_127":231,"_42":188,"_130":150},{"_127":230,"_42":186,"_130":150},{"_127":229,"_42":184,"_130":150},{"_127":227,"_42":228,"_130":150},{"_127":225,"_42":226,"_130":150},{"_127":224,"_42":178,"_130":150},{"_127":223,"_42":176,"_130":150},{"_127":222,"_42":174,"_130":150},{"_127":220,"_42":221,"_130":150},{"_127":219,"_42":170,"_130