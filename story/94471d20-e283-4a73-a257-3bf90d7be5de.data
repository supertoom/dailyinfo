[{"_1":2,"_3":4},"root",{"_5":240},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795221647000,"publicId","94471d20-e283-4a73-a257-3bf90d7be5de","title","欧盟委员会确认遭AI辅助网络攻击","status","active","reportCount",6,"sourceCount","firstReportAt","2026-11-19T12:12:26.000Z","latestAt","2026-11-20T10:51:42.000Z","digest","欧盟委员会确认10月下旬遭利用AI工具的网络攻击，多项内部应用一度下线，包括HR平台Sysper、医疗报销系统MyPMO和翻译系统；目前多数服务已恢复，但攻击是否结束、损害范围及人员数据是否被访问仍未完全确认。\n\n委员会称，调查尚未发现影响全体工作人员的数据泄露证据，也未收到勒索要求，攻击者身份尚未确定。公开AI工具ARTEX此前仅被怀疑用于攻击，尚未证实为实际利用方式；JSIS员工医疗保险门户一度仍未恢复。","digestUpdatedAt","2026-11-20T11:19:54.112Z","summary","excerpt","latest","European Commission 确认遭 AI 辅助网络攻击，多项公共服务中断","latestReport",{"_182":218},"whyHot",{"_234":107,"_235":236,"_237":172,"_238":198,"_239":141},"developments",[222,223],"officialReports",[],"timeline",[176,177,178,179,180,181],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","incident","name","应急响应","supply-chain","供应链安全","ai-security","AI 安全","red-team","红队与渗透","ai-offense","AI 攻防","attack","攻击活动",{"_103":173,"_42":174,"_106":175},{"_103":170,"_42":171,"_106":172},{"_103":169,"_42":117,"_106":141},{"_103":167,"_42":168,"_106":141},{"_103":166,"_42":113,"_106":141},{"_103":165,"_42":111,"_106":141},{"_103":164,"_42":109,"_106":141},{"_103":162,"_42":163,"_106":141},{"_103":160,"_42":161,"_106":141},{"_103":158,"_42":159,"_106":141},{"_103":156,"_42":157,"_106":141},{"_103":154,"_42":155,"_106":141},{"_103":152,"_42":153,"_106":141},{"_103":150,"_42":151,"_106":141},{"_103":148,"_42":149,"_106":141},{"_103":146,"_42":147,"_106":141},{"_103":144,"_42":145,"