[{"_1":2,"_3":4},"root",{"_5":156},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794876038000,"publicId","2a021401-5eac-4f8c-801e-4d3f2293250b","title","Forescout确认99个协议栈漏洞","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-16T05:00:22.000Z","latestAt","2026-11-16T09:00:00.000Z","digest","Forescout团队称，利用Claude模型、代码扫描器和AI辅助漏洞研究框架，在10个常用TCP/IP软件栈中确认99个漏洞，其中66个此前未知，52%被评为高危或严重；目前没有报告称这些漏洞已被利用。\n\n团队认为54个新漏洞仍影响最新版，已向相关开发者和维护者报告，部分项目已发布修复，但披露内容未列出具体CVE编号、受影响产品与版本、修复版本或临时缓解措施。调查还涉及一款已停产无线接入点的固件，其制造商也已停止运营。\n\nForescout称，AI分析用时10小时，研究人员随后用约80小时人工验证，将整体分析周期由约9个月压缩至90小时；AI并未取代专家验证，二进制分析的成本约为源码分析的六倍、耗时约为两倍。","digestUpdatedAt","2026-11-16T09:50:48.272Z","summary","excerpt","latest","Forescout 用 AI 将 10 个 TCP/IP 栈的漏洞分析周期从 9 个月缩短至 90 小时","latestReport",{"_126":138},"whyHot",{"_149":18,"_150":151,"_152":18,"_153":134,"_154":155},"developments",[142],"officialReports",[],"timeline",[124,125],"heat",[65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83],"related",[],"topics",[48,49,50,51,52],{"_53":63,"_55":64},{"_53":61,"_55":62},{"_53":59,"_55":60},{"_53":57,"_55":58},{"_53":54,"_55":56},"slug","tools","name","工具与平台","ai-offense","AI 攻防","ai-security","AI 安全","research","技术研究","ai-agent","AI Agent 安全",{"_84":122,"_42":123,"_87":119},{"_84":120,"_42":121,"_87":119},{"_84":117,"_42":118,"_87":119},{"_84":23,"_42":116,"_87":18},{"_84":114,"_42":115,"_87":18},{"_84":112,"_42":113,"_87":18},{"_84":110,"_42":111,"_87":18},{"_84":108,"_42":109,"_87":18},{"_84":106,"_42":107,"_87":18},{"_84":104,"_42":105,"_87":18},{"_84":102,"_42":103,"_87":18},{"_84":100,"_42":101,"_87":18},{"_84":98,"_42":99,"_87":18},{"_84":96,"_42":97,"_87":18},{"_84":94,"_42":95,"_87":18},{"_84":92,"_42":93,"_87":18},{"_84":90,"_42":91,"_87":18},{"_84":88,"_42":89,"_87":18},{"_84":85,"_42":86,"_87":18},"hour","2026-11-17T00:00:00.000Z",12.3,"participants","2026-11-16T23:00:00.000Z",12.6,"2026-11-16T22:00:00.000Z",13,"2026-11-16T21:00:00.000Z",13.4,"2026-11-16T20:00:00.000Z",13.8,"2026-11-16T19:00:00.000Z",14.2,"2026-11-16T18:00:00.000Z",14.6,"2026-11-16T17:00:00.000Z",15,"2026-11-16T16:00:00.000Z",15.4,"2026-11-16T15:00:00.000Z",15.9,"2026-11-16T14:00:00.000Z",16.4,"2026-11-16T13:00:00.000Z",16.8,"2026-11-16T12:00:00.000Z",17.3,"2026-11-16T11:00:00.000Z",17.8,"2026-11-16T10:00:00.000Z",18.4,18.9,"2026-11-16T08:00:00.000Z",9.2,1,"2026-11-16T07:00:00.000Z",9.4,"2026-11-16T06:00:00.000Z",9.7,{"_126":138,"_13":31,"_28":139,"_130":140,"_132":23,"_133":137},{"_126":127,"_13":128,"_28":129,"_130":131,"_132":21,"_133":134},"id","m230x64wpoum2xp8v57v8ft40","Forescout 用 AI 在 10 个 TCP/IP 协议栈中确认 99 个漏洞","Forescout 团队利用 Claude 模型、代码扫描器与 AI Agent 测试 10 个 TCP/IP 协议栈，确认 99 个漏洞，其中 66 个此前未知，52% 的新漏洞被评为高危或严重。","source",{"_55":135,"_136":137},"publishedAt","selected",true,"Help Net Security","firstParty",false,"ko1y8x9xis96ebfrvwz9paa74","Forescout Technologies 的报告称，团队利用公开模型和专门构建的 AI 辅助漏洞研究框架，在 10 个常用 TCP/IP 栈中发现 99 个漏洞，其中包含 66 个此前尚未公开的漏洞，将分析时间从约 9 个月缩短至 90 小时。",{"_55":141,"_136":137},"Infosecurity Magazine",{"_143":144,"_13":145,"_20":21,"_17":18,"_146":147},"factId","fBvOIU5v_PcQ","Forescout披露AI发现的99个漏洞","representative",{"_126":127,"_13":128,"_28":129,"_130":148,"_132":21,"_133":134},{"_55":135,"_136":137},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",6,{"_157":158,"_159":-5},"changelogVersion","2026-10-01T08:00","release"]
