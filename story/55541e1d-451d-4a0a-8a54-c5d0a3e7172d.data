[{"_1":2,"_3":4},"root",{"_5":307},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795653656000,"publicId","55541e1d-451d-4a0a-8a54-c5d0a3e7172d","title","Palo Alto已修复Fragnesia漏洞","status","active","reportCount",4,"sourceCount","firstReportAt","2026-11-19T11:52:23.000Z","latestAt","2026-11-25T15:00:00.000Z","digest","Palo Alto Networks确认，攻击者已串联PHP2Shell（CVE-2026-109618、CVE-2026-109619）与Linux内核Fragnesia提权漏洞CVE-2026-46300，入侵互联网暴露的PAN-OS管理接口并取得root权限。SANS Technology Institute的Dr. Johannes Ullrich称，已确认美国、日本、台湾和韩国25台设备被攻破，包括24台防火墙和1台管理服务器。\n\nCVE-2026-46300影响PAN-OS的XFRM ESP-in-TCP子系统，无权限攻击者可覆写敏感系统文件并获得root权限；目前已知攻击链须先利用暴露在互联网的管理界面或承载管理配置的dataplane接口实施PHP2Shell。Palo Alto已发布PAN-OS 10.2、11.1、11.2、12.1和12.2修复版本，后续版本也已修复，并建议应用更新、禁止互联网直接访问管理界面。","digestUpdatedAt","2026-11-25T15:25:31.234Z","summary","excerpt","latest","Palo Alto 修复 Fragnesia 漏洞，与 PHP2Shell 组合攻击防火墙","latestReport",{"_261":279},"whyHot",{"_301":135,"_302":303,"_304":135,"_305":277,"_306":159},"developments",[289,290],"officialReports",[],"timeline",[257,258,259,260],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","research","name","技术研究","kernel","内核与系统","supply-chain","供应链安全","exploited","在野利用","vuln","漏洞披露","paloalto","Palo Alto Networks",{"_131":255,"_42":256,"_134":155},{"_131":253,"_42":254,"_134":155},{"_131":251,"_42":252,"_134":155},{"_131":249,"_42":250,"_134":155},{"_131":247,"_42":248,"_134":155},{"_131":245,"_42":246,"_134":155},{"_131":243,"_42":244,"_134":