[{"_1":2,"_3":4},"root",{"_5":294},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1793667633000,"publicId","41881cfd-565d-48f3-8331-58892c484e4a","title","Cisco披露VOLTA用AI评估窃密受害者","status","active","reportCount",4,"sourceCount","firstReportAt","2026-10-31T12:00:00.000Z","latestAt","2026-11-02T18:34:13.000Z","digest","Cisco Talos 披露，Windows 信息窃密木马 VOLTA-AUTODOXER 会收集浏览器密码与 Cookie、支付卡、加密钱包种子、OAuth 令牌、SSH 与云密钥、会话及 Wi-Fi 密码，并经 OpenRouter 调用大语言模型，对受害者资产估值及变现优先级进行评估。目前未披露确认受害数量、实际攻击规模、补丁或相关漏洞编号。\n\nVOLTA 默认请求 Anthropic 的 Claude Opus 4.6，遭拒后依次回退至 Moonshot AI 的 Kimi K2 和 Google 的 Gemini 2.5 Flash，最多串联三个模型；推理经受害者自身设备和网络完成，数据分三个阶段通过 Telegram 外传。Talos称该程序运行后会删除自身，且没有攻击者自建基础设施。The Hacker News称，作者可能在推广 builder kit，或按订单编译定制二进制文件，但这尚未得到证实。","digestUpdatedAt","2026-11-02T19:57:54.091Z","summary","excerpt","latest","Cisco Talos 分析 AI 驱动型 Windows 信息窃取器 VOLTA","latestReport",{"_253":277},"whyHot",{"_288":132,"_289":290,"_291":132,"_292":261,"_293":132},"developments",[281],"officialReports",[],"timeline",[249,250,251,252],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","ai-offense","name","AI 攻防","malware","恶意软件","attack","攻击活动","ai-agent","AI Agent 安全","black-market","数据窃取与黑产","ransomware","勒索软件",{"_128":247,"_42":248,"_131":154},{"_128":245,"_42":246,"_131":154},{"_128":243,"_42":244,"_131":154},{"_128":241,"_42":242,"_131":154},{"_128":239,"_42":240,"_131":154},{"_128":238,"_42":158,"_131":154},{"_128":236,"_42":237,"_131":154},{"_128":235,"_42":153,"_