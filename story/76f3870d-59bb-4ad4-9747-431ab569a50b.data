[{"_1":2,"_3":4},"root",{"_5":133},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794616838000,"publicId","76f3870d-59bb-4ad4-9747-431ab569a50b","title","桑托斯港务局确认系统遭恶意软件攻击","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-13T09:57:00.000Z","latestAt","2026-11-13T10:04:28.370Z","digest","巴西桑托斯港务局（APS）确认，其系统遭网络攻击，恶意软件在11月6日停电前已潜伏于桑托斯港网络，并于11月7日凌晨3时被发现。港务局认为，攻击目的可能是扰乱正常运营；目前尚无法确定影响范围，也无法确认是否有数据被未经授权访问。\n\n货物装卸出现延误，航线调度、船舶到港登记和费用结算改为人工处理。各码头系统独立，港口未停运。","digestUpdatedAt","2026-11-13T16:05:47.662Z","summary","excerpt","latest","巴西桑托斯港务局系统遭恶意软件攻击，部分业务改为人工操作","latestReport",{"_105":115},"whyHot",{"_125":18,"_126":127,"_128":18,"_129":130,"_131":132},"developments",[118],"officialReports",[],"timeline",[103,104],"heat",[65,66,67,68,69,70,71,72,73,74,75,76],"related",[],"topics",[48,49,50,51,52],{"_53":63,"_55":64},{"_53":61,"_55":62},{"_53":59,"_55":60},{"_53":57,"_55":58},{"_53":54,"_55":56},"slug","ransomware","name","勒索软件","iot","IoT 与车联网","malware","恶意软件","attack","攻击活动","supply-chain","供应链安全",{"_77":101,"_42":102,"_80":18},{"_77":99,"_42":100,"_80":18},{"_77":97,"_42":98,"_80":18},{"_77":95,"_42":96,"_80":18},{"_77":93,"_42":94,"_80":18},{"_77":91,"_42":92,"_80":18},{"_77":89,"_42":90,"_80":18},{"_77":87,"_42":88,"_80":18},{"_77":85,"_42":86,"_80":18},{"_77":83,"_42":84,"_80":18},{"_77":81,"_42":82,"_80":18},{"_77":78,"_42":79,"_80":18},"hour","2026-11-14T00:00:00.000Z",13.4,"participants","2026-11-13T23:00:00.000Z",13.7,"2026-11-13T22:00:00.000Z",14.1,"2026-11-13T21:00:00.000Z",14.6,"2026-11-13T20:00:00.000Z",15,"2026-11-13T19:00:00.000Z",15.4,"2026-11-13T18:00:00.000Z",15.9,"2026-11-13T17:00:00.000Z",16.3,"2026-11-13T16:00:00.000Z",16.8,"2026-11-13T15:00:00.000Z",17.3,"2026-11-13T14:00:00.000Z",17.8,"2026-11-13T13:00:00.000Z",18.3,{"_105":115,