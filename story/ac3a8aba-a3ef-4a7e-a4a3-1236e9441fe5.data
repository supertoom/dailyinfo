[{"_1":2,"_3":4},"root",{"_5":128},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795480851000,"publicId","ac3a8aba-a3ef-4a7e-a4a3-1236e9441fe5","title","微软修复Azure API Management Classic漏洞","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-23T15:47:40.000Z","latestAt","2026-11-23T19:42:20.000Z","digest","微软披露并修复了Azure API Management Classic层级的安全漏洞，称未按推荐安全最佳实践配置的Classic实例可被未授权访问管理功能及存储的机密；APIM v2层级不受影响。微软称已于2026年11月19日部署缓解措施，但低于特定运行时版本的实例仍可能易受攻击，已部署修复不会自动使此前可能被访问的凭据失效。\n\n挪威网络安全中心（NSM）称，该漏洞已被用于攻击挪威能源公司Equinor和Skagerak Energi等目标，可能窃取命名值、身份提供程序客户端密钥、订阅密钥及APIM直接管理API的令牌。NSM建议APIM用户将相关密钥和命名值视为已泄露并全部更换，尚未收到更新的客户应联系服务提供商。","digestUpdatedAt","2026-11-23T20:09:34.795Z","summary","excerpt","latest","Microsoft Azure API Management Classic 漏洞已被利用窃取 API 凭据","latestReport",{"_94":106},"whyHot",{"_122":18,"_123":87,"_124":18,"_125":102,"_126":127},"developments",[110,111],"officialReports",[],"timeline",[92,93],"heat",[65,66,67,68,69,70,71,72],"related",[],"topics",[48,49,50,51,52],{"_53":63,"_55":64},{"_53":61,"_55":62},{"_53":59,"_55":60},{"_53":57,"_55":58},{"_53":54,"_55":56},"slug","identity","name","身份与访问","microsoft","Microsoft / 微软","exploited","在野利用","vuln","漏洞披露","cloud-native","云与原生",{"_73":90,"_42":91,"_76":87},{"_73":88,"_42":89,"_76":87},{"_73":85,"_42":86,"_76":87},{"_73":83,"_42":84,"_76":18},{"_73":81,"_42":82,"_76":18},{"_73":79,"_42":80,"_76":18},{"_73":77,"_42":78,"_76":18},{"_73":74,"_42":75,"_76":18},"hour","2026-11-24T00:00:00.000Z",16.7,"participants","2026-11-23T23:00:00.000Z",17.2,"2026-11-23T22:00:00.000Z",17.7,"2026-11-23T21:00:00.000Z",18.2,"2026-11-23T20:00:00.000Z",18.8,"2026-11-23T19:00:00.000Z",9.1,1,"2026-11-23T18:00:00.000Z",9.4,"2026-11-23T17:00:00.000Z",9.7,{"_94":106,"_13":31,"_28":107,"_98":108,"_100":23,"_101":105},{"_94":95,"_13":96,"_28":97,"_98":99,"_100":21,"_101":102},"id","xq8xakipwwrrbp544jsizje8i","Azure API Management Classic 漏洞被用于窃取挪威能源公司密钥","Azure API Management Classic 漏洞已被用于针对挪威能源公司 Equinor 和 Skagerak Energi 等目标，攻击者可能获取了实例中存储的密钥。","source",{"_55":103,"_104":105},"publishedAt","selected",true,"SecurityWeek","firstParty",false,"dw4eyb7t4jy3oa0umleioh8vo","Microsoft Azure API Management Classic 层级漏洞已被用于窃取客户 API 凭据，未按推荐安全最佳实践配置的实例可被未授权访问管理功能。",{"_55":109,"_104":105},"BleepingComputer",{"_112":118,"_13":119,"_20":23,"_17":87,"_115":120},{"_112":113,"_13":114,"_20":21,"_17":87,"_115":116},"factId","fdpjCK9lDhbs","微软修复Azure API Management漏洞","representative",{"_94":95,"_13":96,"_28":97,"_98":117,"_100":21,"_101":102},{"_55":103,"_104":105},"fUXoa9Bh5o4A","披露Azure APIM漏洞被利用",{"_94":106,"_13":31,"_28":107,"_98":121,"_100":23,"_101":105},{"_55":109,"_104":105},"participants48h","newParticipants6h","recentReports24h","observationComplete","rank",7,{"_129":130,"_131":-5},"changelogVersion","2026-10-01T08:00","release"]
