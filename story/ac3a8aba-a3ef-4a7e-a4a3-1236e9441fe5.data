[{"_1":2,"_3":4},"root",{"_5":224},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795567297000,"publicId","ac3a8aba-a3ef-4a7e-a4a3-1236e9441fe5","title","微软修复Azure API Management Classic漏洞","status","active","reportCount",4,"sourceCount","firstReportAt","2026-11-23T15:47:40.000Z","latestAt","2026-11-24T12:04:37.000Z","digest","微软确认Azure API Management Classic层级漏洞已被利用，攻击者可未授权访问部分管理功能并窃取实例中存储的凭据，受害者包括Equinor、Skagerak Energi等挪威能源组织；微软已关闭访问路径并部署缓解措施，但未披露受影响客户数量，整体利用范围仍不明确。\n\n仅未按微软安全最佳实践配置的Classic实例受影响，APIM v2层级不受影响。可能暴露的凭据包括命名值、身份提供程序及OpenID Connect客户端密钥、订阅密钥和APIM直接管理API令牌。微软修复后不会自动使此前可能被访问的凭据失效，客户应按排查和轮换指导处理，并确认实例已更新至固定运行时版本0.52.31936或更高版本、0.53.31938或更高版本；具体受影响版本、漏洞编号和CVSS评分报道未提供。","digestUpdatedAt","2026-11-24T12:23:03.263Z","summary","excerpt","latest","Microsoft Azure API Management 漏洞已被利用，客户凭据遭窃取","latestReport",{"_173":197},"whyHot",{"_217":18,"_218":219,"_220":133,"_221":181,"_222":223},"developments",[201,202,203],"officialReports",[],"timeline",[169,170,171,172],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","ransomware","name","勒索软件","vuln","漏洞披露","identity","身份与访问","microsoft","Microsoft / 微软","exploited","在野利用","cloud-native","云与原生",{"_100":167,"_42":168,"_103":164},{"_100":165,"_42":166,"_103":164},{"_100":162,"_42":163,"_103":164},{"_100":160,"_42":161,"_103":133},{"_100":158,"_42":159,"_103":133},{"_100":156,"_42":157,"_103":133},{"_100":154,"_42":155,"_103":133},{"_100":152,"_42":153,"_103":133},{"_100":150,"_42":151,"_103":133},{"_100":148,"_42":149,"_103":133},{"_100":146,"_42":147,"_103":133},{"_100":144,"_42":145,"_103":133},{