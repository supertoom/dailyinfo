[{"_1":2,"_3":4},"root",{"_5":268},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794271241000,"publicId","3bf9dc47-b085-4827-80e7-55c10644d767","title","QNAP确认Plex2Shell已入侵公网NAS","status","active","reportCount",3,"sourceCount","firstReportAt","2026-11-06T17:04:23.000Z","latestAt","2026-11-09T14:40:18.000Z","digest","QNAP确认，攻击者已利用Plex2Shell漏洞链入侵部分公网可访问的QNAP NAS上所部署的Plex Media Server；漏洞链包含CVE-2026-96652、CVE-2026-96654、CVE-2026-96655和CVE-2026-96656，无需有效凭据即可在满足条件时以Plex服务权限执行任意代码。受影响范围限于Plex Media Server，QTS、QuTS hero等操作系统本身不受影响；漏洞利用始于技术细节和PoC公开后。\n\nQNAP称修复已于9月发布，建议通过QNAP App Center升级至1.43.3.10861；若Plex在1.43.2或更早版本运行期间可从公网访问，设备应视为可能失陷，需重装Plex并立即更改Plex和NAS密码，个人内容也应视为已失陷。更新不能清除既有载荷。QNAP技术支持团队正协助受影响用户，并确认尚未发生数据丢失。","digestUpdatedAt","2026-11-09T17:31:39.732Z","summary","excerpt","latest","QNAP 确认 Plex2Shell 漏洞链已被用于入侵 NAS 设备","latestReport",{"_228":246},"whyHot",{"_262":124,"_263":264,"_265":124,"_266":236,"_267":18},"developments",[250,251],"officialReports",[],"timeline",[225,226,227],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","crypto","name","密码学","iot","IoT 与车联网","attack","攻击活动","vuln","漏洞披露","cisa","CISA","exploited","在野利用",{"_120":223,"_42":224,"_123":145},{"_120":221,"_42":222,"_123":145},{"_120":219,"_42":220,"_123":145},{"_120":217,"_42":218,"_123":145},{"_120":215,"_42":216,"_123":145},{"_120":213,"_42":214,"_123":145},{"_120":211,"_42":212,"_123":145},{"_120":209,"_42":210,"_123":145},{"_120":207,"_42":208,"_123":145},{"_120":205,"_42":206,"_123":145},{"_12