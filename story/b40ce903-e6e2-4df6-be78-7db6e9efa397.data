[{"_1":2,"_3":4},"root",{"_5":108},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1793621627000,"publicId","b40ce903-e6e2-4df6-be78-7db6e9efa397","title","DebugBear脚本被篡改，Polymarket损失约270万美元","status","watching","reportCount",3,"sourceCount","firstReportAt","2026-10-29T21:47:25.000Z","latestAt","2026-11-01T07:25:40.000Z","digest","Polymarket确认第三方网站性能监控服务DebugBear分发的脚本被篡改，攻击者利用登录用户会话卖出持仓并转移资产；链上分析机构Betting Intelligence和Polysights估计710个钱包损失约270万美元，实际损失及赔付范围尚未由平台完整确认。\n\n受影响条件是用户在攻击短窗口内打开过Polymarket。DebugBear称初步调查显示仅Polymarket的客户脚本被替换，尚未发现其自身系统遭入侵；独立美国平台未受影响。Polymarket已移除恶意代码、暂停交易并重置登录会话，并称截至周五下午95%的受影响钱包已获退款。事件未涉及智能合约入侵。","digestUpdatedAt","2026-11-01T08:32:55.844Z","summary","excerpt","latest","攻击者劫持 Polymarket 第三方脚本，窃取交易者约 $2.7 million","latestReport",{"_71":89},"whyHot",{"_100":101,"_102":103,"_104":103,"_105":79,"_106":107},"developments",[93],"officialReports",[],"timeline",[68,69,70],"heat",[],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","identity","name","身份与访问","supply-chain","供应链安全","attack","攻击活动","black-market","数据窃取与黑产","ransomware","勒索软件","crypto","密码学",{"_71":89,"_13":31,"_28":90,"_75":91,"_77":23,"_78":79},{"_71":83,"_13":84,"_28":85,"_75":86,"_77":87,"_78":79},{"_71":72,"_13":73,"_28":74,"_75":76,"_77":21,"_78":79},"id","ihl9k919cuk2zeu8m5uh5sr73","Polymarket 因第三方服务遭入侵暂停交易，约 $2.5M 加密资产被追踪","Polymarket 因第三方供应商被入侵而遭恶意 JavaScript 注入，约 $2.5M 加密资产已转移至疑似攻击者钱包。该脚本通过 cdn.debugbear[.]com/C7xcKKrjUnXK.js 分发，劫持已登录用户的交易会话、出售预测市场持仓并转移加密资产，还利用 data.debugbear.com 接收指令及回传账户、余额和交易结果。","source",{"_56":80,"_81":82},"publishedAt","selected",true,"BleepingComputer","firstParty",false,"lamu867o9rfhk6a1fy9fjaeu6","Polymarket 因第三方脚本遭攻击，710 个钱包损失约 $2.7 million","预测市场平台 Polymarket 因遭入侵的 DebugBear 第三方性能监控脚本窃取资金，710 个钱包损失约 $2.7 million。攻击者利用用户活跃会话卖出交易仓位并转走资产，事件未涉及智能合约入侵；平台移除恶意代码、暂停交易并重置登录会话。",{"_56":88,"_81":82},"2026-10-31T14:05:27.000Z","Hackread","jvfeav2pkr4v6gb71xh1y1wna","攻击者通过被劫持的 DebugBear 第三方脚本，在 Polymarket 登录页面读取交易 API keys，并诱导账户自身签名器批准转移持仓或低价卖出持仓。",{"_56":92,"_81":82},"The Hacker News",{"_94":95,"_13":96,"_20":21,"_17":18,"_97":98},"factId","fjTpuOAuMvV4","Polymarket遭脚本攻击损失约257万美元","representative",{"_71":72,"_13":73,"_28":74,"_75":99,"_77":21,"_78":79},{"_56":80,"_81":82},"participants48h",2,"newParticipants6h",0,"recentReports24h","observationComplete","rank",5,{"_109":110,"_111":-5},"changelogVersion","2026-10-01T08:00","release"]
