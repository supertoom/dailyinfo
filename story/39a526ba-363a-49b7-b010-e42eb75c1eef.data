[{"_1":2,"_3":4},"root",{"_5":318},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794271241000,"publicId","39a526ba-363a-49b7-b010-e42eb75c1eef","title","美五机构警告冷链制冷控制器遭全球攻击","status","active","reportCount",5,"sourceCount","firstReportAt","2026-11-05T12:00:00.000Z","latestAt","2026-11-09T11:57:12.000Z","digest","CISA、FBI、HHS、USDA和DoT确认，攻击者正全球攻击零售、冷存储及医疗、化学、食品和运输企业使用的电子温度控制器与商用制冷控制器；尚不明确攻击者身份、完整受害规模、具体漏洞编号或修复版本。\n\n攻击者利用未打补丁或可从互联网访问的控制器，通过认证绕过、任意代码注入和薄弱配置进入系统，远程改写温度或除霜设置，迫使设备持续加热，可能导致库存损失、设备损坏、火灾风险及温度监测受扰。欧洲数百家超市近期遭攻击，部分设备温度升至50摄氏度并造成食品腐坏；Help Net Security称多国攻击时间同步，疑似国家级行为者，但联合公告未作此认定。\n\n运营方应取消控制器面板等设备的公网暴露、更新固件，并识别、退役和替换已停止支持的旧设备。","digestUpdatedAt","2026-11-09T12:27:42.648Z","summary","excerpt","latest","CISA 与 FBI 警告攻击者针对工业制冷控制器发起攻击","latestReport",{"_269":299},"whyHot",{"_312":139,"_313":314,"_315":139,"_316":280,"_317":18},"developments",[305],"officialReports",[303],"timeline",[264,265,266,267,268],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96,97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130,131,132,133,134],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","blue-team","name","蓝队与运营","iot","IoT 与车联网","attack","攻击活动","exploited","在野利用","industrial","工业控制","cisa","CISA",{"_135":262,"_42":263,"_138":166},{"_135":260,"_42":261,"_138":139},{"_135":259,"_42":147,"_138":139},{"_135":258,"_42":145,"_138":139},{"_135":257,"_42":143,"_138":139},{"_135":256,"_42":141,"_138":139},{"_135":254,"_42":255,"_138":139},{"_135":252,"_42":253,"_138":139},{"_135":250,"_42":251,"_138":139},{"_135":248,"_42":249,"_138":139},{"_135":246,