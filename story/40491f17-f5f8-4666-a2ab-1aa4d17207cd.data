[{"_1":2,"_3":4},"root",{"_5":177},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794357648000,"publicId","40491f17-f5f8-4666-a2ab-1aa4d17207cd","title","范德堡大学称正应对网络攻击","status","active","reportCount",3,"sourceCount","firstReportAt","2026-11-09T23:52:12.000Z","latestAt","2026-11-10T12:30:41.000Z","digest","范德堡大学称正应对活跃网络攻击，已关闭或限制多数系统与应用；校园WiFi已恢复，课程及学生服务恢复正常，但校方尚未披露攻击性质、攻击者身份，也未确认数据失窃或设备被加密。\n\nBYOD勒索团伙声称已加密学校数据库，并窃取学生、员工及研究数据，包括超过100万个SSN、姓名、邮箱和电话号码；勒索信和视频指向该团伙，Venarix称其还将范德堡大学列上数据泄露网站。这些影响目前均为团伙说法，尚无校方证实；报道未说明漏洞利用途径或补丁情况。","digestUpdatedAt","2026-11-10T13:17:11.949Z","summary","excerpt","latest","Vanderbilt University 遭勒索软件攻击，BYOD 声称已加密学校数据库","latestReport",{"_141":159},"whyHot",{"_170":18,"_171":172,"_173":114,"_174":149,"_175":176},"developments",[163],"officialReports",[],"timeline",[138,139,140],"heat",[62,63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85],"related",[],"topics",[48,49,50,51],{"_52":60,"_54":61},{"_52":58,"_54":59},{"_52":56,"_54":57},{"_52":53,"_54":55},"slug","exploited","name","在野利用","incident","应急响应","attack","攻击活动","ransomware","勒索软件",{"_86":136,"_42":137,"_89":117},{"_86":134,"_42":135,"_89":117},{"_86":132,"_42":133,"_89":117},{"_86":130,"_42":131,"_89":117},{"_86":128,"_42":129,"_89":117},{"_86":126,"_42":127,"_89":117},{"_86":124,"_42":125,"_89":117},{"_86":122,"_42":123,"_89":117},{"_86":120,"_42":121,"_89":117},{"_86":118,"_42":119,"_89":117},{"_86":115,"_42":116,"_89":117},{"_86":112,"_42":113,"_89":114},{"_86":110,"_42":111,"_89":18},{"_86":108,"_42":109,"_89":18},{"_86":106,"_42":107,"_89":18},{"_86":104,"_42":105,"_89":18},{"_86":102,"_42":103,"_89":18},{"_86":100,"_42":101,"_89":18},{"_86":98,"_42":99,"_89":18},{"_86":96,"_42":97,"_89":18},{"_86":94,"_42":95,"_89":18},{"_86":92,"_42":93,"_89":18},{"_86":90,"_42