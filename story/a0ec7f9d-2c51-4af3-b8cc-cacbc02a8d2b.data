[{"_1":2,"_3":4},"root",{"_5":148},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795740055000,"publicId","a0ec7f9d-2c51-4af3-b8cc-cacbc02a8d2b","title","DeepSite 被用于批量制作钓鱼页","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-26T09:28:59.000Z","latestAt","2026-11-26T12:30:00.000Z","digest","Aikido Security 研究员 Hunter Schwartz 披露，攻击者利用 Hugging Face 的 AI 建站工具 DeepSite 制作钓鱼页面，并通过 Hugging Face Spaces 发布，仿冒 Microsoft、PayPal、Netflix 等 28 个品牌；共发现 42 个页面，其中 29 个由 DeepSite 构建。Aikido 暂无访问数据，无法确认访问或提交凭据的人数，尚无证据证明有多少用户受骗。\n\n这些页面用于收集凭据：25 个将数据传至 Telegram 机器人，11 个传至 Discord webhook，6 个传至在线表单服务。研究者向 Hugging Face 报告后，截至 10 月 29 日，42 个页面均已暂停或无法公开访问，发布研究时已不再为受害者提供服务。","digestUpdatedAt","2026-11-26T12:43:57.686Z","summary","excerpt","latest","攻击者利用 Hugging Face AI 网站生成器搭建 42 个钓鱼页面","latestReport",{"_118":130},"whyHot",{"_141":18,"_142":143,"_144":18,"_145":126,"_146":147},"developments",[134],"officialReports",[],"timeline",[116,117],"heat",[68,69,70,71,72,73,74,75,76,77,78,79,80,81,82],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","ai-offense","name","AI 攻防","black-market","数据窃取与黑产","ransomware","勒索软件","email","邮件与钓鱼","identity","身份与访问","microsoft","Microsoft / 微软",{"_83":114,"_42":115,"_86":111},{"_83":112,"_42":113,"_86":111},{"_83":109,"_42":110,"_86":111},{"_83":107,"_42":108,"_86":18},{"_83":105,"_42":106,"_86":18},{"_83":103,"_42":104,"_86":18},{"_83":101,"_42":102,"_86":18},{"_83":99,"_42":100,"_86":18},{"_83":97,"_42":98,"_86":18},{"_83":95,"_42":96,"_86":18},{"_83":93,"_42":94,"_86":18},{"_83":91,"_42":92,"_86":18},{"_83":89,"_42":90,"_86":18},{"_83":87,"_42":88,"_86":18},{"_83":84,"_42":85,"_86":18},"hour","2026-11-27T00:00:00.000