[{"_1":2,"_3":4},"root",{"_5":134},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1794271240000,"publicId","05ee57b3-5751-4b16-8fe5-8e07f6fa3263","title","Ahold Delhaize预估网络攻击损失","status","active","reportCount",2,"sourceCount","firstReportAt","2026-11-09T09:37:00.000Z","latestAt","2026-11-09T09:43:20.782Z","digest","Ahold Delhaize披露，发生在第三季度结束后的网络攻击干扰美国及欧洲多国零售业务，预计第四季度净销售额减少2亿至2.5亿欧元，基础营业利润和按IFRS计算的营业利润损失7500万至1亿欧元；公司尚未披露具体攻击类型。\n\n公司称，为保护内部IT环境，其按既定流程关闭了部分系统。美国及欧洲8个零售品牌的网站、线上订单和配送服务一度中断；截至10月19日，尚无证据显示客户、员工或合作伙伴数据被窃取。大部分中断已在两周内基本受控，但全面恢复运营仍在进行。","digestUpdatedAt","2026-11-09T11:44:52.004Z","summary","excerpt","latest","Ahold Delhaize 上个月网络攻击预计造成第四季度销售额减少2亿至2.5亿欧元","latestReport",{"_105":116},"whyHot",{"_127":18,"_128":129,"_130":18,"_131":119,"_132":133},"developments",[120],"officialReports",[],"timeline",[103,104],"heat",[62,63,64,65,66,67,68,69,70,71,72,73,74],"related",[],"topics",[48,49,50,51],{"_52":60,"_54":61},{"_52":58,"_54":59},{"_52":56,"_54":57},{"_52":53,"_54":55},"slug","supply-chain","name","供应链安全","attack","攻击活动","incident","应急响应","ransomware","勒索软件",{"_75":101,"_42":102,"_78":18},{"_75":99,"_42":100,"_78":18},{"_75":97,"_42":98,"_78":18},{"_75":95,"_42":96,"_78":18},{"_75":93,"_42":94,"_78":18},{"_75":91,"_42":92,"_78":18},{"_75":89,"_42":90,"_78":18},{"_75":87,"_42":88,"_78":18},{"_75":85,"_42":86,"_78":18},{"_75":83,"_42":84,"_78":18},{"_75":81,"_42":82,"_78":18},{"_75":79,"_42":80,"_78":18},{"_75":76,"_42":77,"_78":18},"hour","2026-11-10T00:00:00.000Z",13.2,"participants","2026-11-09T23:00:00.000Z",13.6,"2026-11-09T22:00:00.000Z",14,"2026-11-09T21:00:00.000Z",14.4,"2026-11-09T20:00:00.000Z",14.8,"2026-11-09T19:00:00.000Z",15.3,"2026-11-09T18:00:00.000Z",15.7,"2026-11-09T17:00:00.000Z",16.2,"2026-11-09T16:00:00.000Z",16.7,"2026-11-09T15:00:00.000Z",17.1,"2026-11-09T14:00:00.000Z",17.6,"2026-11-09T13:00:00.000Z",18.2,"2026-11-09T12:00:00.000Z",18.7,{"_105":116,"_13":31,"_28":117,"_109":118,"_111":23,"_112":119},{"_105":106,"_13":107,"_28":108,"_109":110,"_111":21,"_112":113},"id","jd6a9hxx47u3eenhvfouffr6t","Ahold Delhaize网络攻击致第四季度销售额预计减少2亿至2.5亿欧元","Ahold Delhaize遭网络攻击，部分系统关闭并中断欧美8个零售品牌的网站、线上订单和配送服务，预计第四季度净销售额减少2亿至2.5亿欧元，基础营业利润损失7500万至1亿欧元。公司10月19日称尚无证据显示客户、员工或合作伙伴数据被窃取，具体攻击类型尚未披露。","source",{"_54":114,"_115":113},"publishedAt","selected",false,"安全内参","firstParty","jz9grqtqb23abgdgaadfggi4v","Ahold Delhaize 披露，上个月发生的网络攻击干扰了美国及欧洲多国业务，预计第四季度净销售额减少2亿至2.5亿欧元，基础营业利润和按 IFRS 计算的营业利润损失7500万至1亿欧元。",{"_54":114,"_115":113},true,{"_121":122,"_13":123,"_20":21,"_17":18,"_124":125},"factId","feOhWbokMpm0","Ahold Delhaize披露网络攻击损失预估","representative",{"_105":116,"_13":31,"_28":117,"_109":126,"_111":23,"_112":119},{"_54":114,"_115":113},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",4,{"_135":136,"_137":-5},"changelogVersion","2026-10-01T08:00","release"]
