[{"_1":2,"_3":4},"root",{"_5":149},"routes/story",{"_5":6},"data",{"_7":8,"_9":10},"story",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":18,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47},"expiresAt",1795567297000,"publicId","c02d24f7-3590-4fa0-8cbd-489d81b76730","title","O-UNC-053被关联Inception数据勒索活动","status","active","reportCount",3,"sourceCount","firstReportAt","2026-11-24T12:47:07.000Z","latestAt","2026-11-24T16:30:00.000Z","digest","Okta威胁情报团队称，关联ShinyHunters的O-UNC-053可能以Inception名义恢复数据泄露活动；目前未确认其是否运营该站、是否与另一勒索团伙合作，站内数据真实性亦未核实，O-UNC-053与ShinyHunters的具体关系仍不明。\n\n该团伙通过语音钓鱼冒充支持人员，诱导员工在仿冒登录页重置密码，获取SSO用户名、密码、一次性代码或批准MFA推送，随后入侵SaaS应用、窃取数据并勒索。其工具无法绕过通行密钥和Okta FastPass等抗钓鱼认证。ReversingLabs确认21个域名使用该工具包，另以高、中置信度归因41个和4个域名；截至11月21日，站内声称的7名受害者仍属未经核实的说法。","digestUpdatedAt","2026-11-24T17:03:00.095Z","summary","excerpt","latest","Okta 与 ReversingLabs 关联 Inception 数据勒索品牌与 SSO vishing 活动","latestReport",{"_107":125},"whyHot",{"_142":18,"_143":144,"_145":18,"_146":115,"_147":148},"developments",[129,130],"officialReports",[],"timeline",[104,105,106],"heat",[68,69,70,71,72,73,74,75,76,77,78],"related",[],"topics",[48,49,50,51,52,53],{"_54":66,"_56":67},{"_54":64,"_56":65},{"_54":62,"_56":63},{"_54":60,"_56":61},{"_54":58,"_56":59},{"_54":55,"_56":57},"slug","ransomware","name","勒索软件","malware","恶意软件","black-market","数据窃取与黑产","attack","攻击活动","email","邮件与钓鱼","identity","身份与访问",{"_79":102,"_42":103,"_82":99},{"_79":100,"_42":101,"_82":99},{"_79":97,"_42":98,"_82":99},{"_79":95,"_42":96,"_82":18},{"_79":93,"_42":94,"_82":18},{"_79":91,"_42":92,"_82":18},{"_79":89,"_42":90,"_82":18},{"_79":87,"_42":88,"_82":18},{"_79":85,"_42":86,"_82":18},{"_79":83,"_42":84,"_82":18},{"_79":80,"_42":81,"_82":18},"hour","2026-11-25T00:00:00.000Z",22.7,"participants","2026-11-24T23:00:00.000Z",23.3,"2026-11-24T22:00:00.000Z",24,"2026-11-24T21:00:00.000Z",24.7,"2026-11-24T20:00:00.000Z",25.4,"2026-11-24T19:00:00.000Z",26.2,"2026-11-24T18:00:00.000Z",27,"2026-11-24T17:00:00.000Z",27.7,"2026-11-24T16:00:00.000Z",18.4,2,"2026-11-24T15:00:00.000Z",18.9,"2026-11-24T14:00:00.000Z",19.5,{"_107":125,"_13":31,"_28":126,"_111":127,"_113":23,"_114":118},{"_107":119,"_13":120,"_28":121,"_111":122,"_113":123,"_114":115},{"_107":108,"_13":109,"_28":110,"_111":112,"_113":21,"_114":115},"id","s2ik3cksp4t8o5o7otrnvjsnu","Okta 追踪 ShinyHunters 关联团伙以 Inception 名义重启数据泄露站","Okta 追踪的 O-UNC-053 团伙自 2026 年 3 月起针对多个行业实施社会工程和凭据收集活动，并疑似在 ShinyHunters 泄露站下线后转投 Inception。","source",{"_56":116,"_117":118},"publishedAt","selected",true,"Help Net Security","firstParty",false,"umayny0zi2flg2u4b2znewhf6","Okta将ShinyHunters关联组织O-UNC-053指向新数据泄露站点INCEPTION","Okta Threat Intelligence称，O-UNC-053可能以INCEPTION名义延续针对ShinyHunters关联组织的攻击活动。该组织自2026年3月被跟踪，利用vishing诱导目标输入凭据、一次性密码并批准MFA推送，通过钓鱼工具截获认证流程，继而入侵SaaS应用、窃取数据并实施勒索。",{"_56":124,"_117":118},"2026-11-24T13:28:21.000Z","The Hacker News","d1qn6zy18qnkm08vnkfvk4vjh","Okta 与 ReversingLabs 将新数据勒索品牌 Inception 与针对 SSO 凭据的 vishing 活动关联起来。活动者冒充支持人员，诱导员工通过仿冒登录页重置密码，窃取用户名、密码及一次性代码或 MFA 推送批准；ReversingLabs 在 21 个域名确认该钓鱼工具包，并以高置信度归因另外 41 个域名、以中等置信度归因 4 个。",{"_56":128,"_117":118},"Infosecurity Magazine",{"_131":137,"_13":138,"_20":23,"_17":139,"_134":140},{"_131":132,"_13":133,"_20":21,"_17":99,"_134":135},"factId","fxsqVO3s-Zkc","O-UNC-053启用Inception泄露网站","representative",{"_107":108,"_13":109,"_28":110,"_111":136,"_113":21,"_114":115},{"_56":116,"_117":118},"fCDoV9Pn1FSs","披露Inception语音钓鱼勒索活动",1,{"_107":125,"_13":31,"_28":126,"_111":141,"_113":23,"_114":118},{"_56":128,"_117":118},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",5,{"_150":151,"_152":-5},"changelogVersion","2026-10-01T08:00","release"]
