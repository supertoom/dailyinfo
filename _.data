l已修复，Red Hat补丁仍缺",123.8,"8540cb70-bd3c-4700-8134-83f02bb49280","vswsohxmcbyf63rfffrs81z1z",[136,137,138,139,140,141,142,143,144,145,146,147,148,149,150,151,152,153,154,155,156,157],22,{"_49":173,"_51":52,"_53":174,"_55":175},{"_49":170,"_51":52,"_53":171,"_55":172},{"_49":169,"_51":52,"_53":-5},{"_49":168,"_51":52,"_53":-5},{"_49":167,"_51":52,"_53":-5},{"_49":166,"_51":52,"_53":-5},{"_49":165,"_51":52},{"_49":164,"_51":52},{"_49":163,"_51":52},{"_49":162,"_51":52},{"_49":161,"_51":52},{"_49":160,"_51":52},{"_49":74,"_51":52},{"_49":119,"_51":52},{"_49":60,"_51":52},{"_49":116,"_51":52},{"_49":57,"_51":52},{"_49":77,"_51":52},{"_49":122,"_51":52},{"_49":159,"_51":52},{"_49":158,"_51":52},{"_49":50,"_51":52},"CERT-FR","Horizon3.ai","Elastic Blog","Cisco Talos","Cloudflare Blog","微步在线研究响应中心","阿里云应急响应","奇安信 CERT","长亭安全应急响应中心","绿盟科技CERT","Cisco PSIRT","深信服千里目安全实验室","CISA 安全公告","/dailyinfo/media/c65213b8bb0b8c32.webp","/dailyinfo/media/f4741f74a4c97912.webp 48w, /dailyinfo/media/c65213b8bb0b8c32.webp 96w","Rapid7 CVE 公告","/dailyinfo/media/092fbeae5b5c3123.webp","/dailyinfo/media/c16323cf53c574df.webp 48w, /dailyinfo/media/092fbeae5b5c3123.webp 96w","2026-11-19",8,"2026-11-18",27,{"_200":500,"_202":501,"_204":502,"_206":-5},{"_200":487,"_202":488,"_204":489,"_206":-5},{"_200":476,"_202":477,"_204":478,"_206":-5},{"_200":466,"_202":467,"_204":468,"_206":-5},{"_200":456,"_202":457,"_204":458,"_206":-5},{"_200":445,"_202":446,"_204":447,"_206":-5},{"_200":435,"_202":436,"_204":437,"_206":-5},{"_200":419,"_202":420,"_204":421,"_206":422},{"_200":406,"_202":407,"_204":408,"_206":-5},{"_200":387,"_202":388,"_204":389,"_206":390},{"_200":374,"_202":375,"_204":376,"_206":-5},{"_200":362,"_202":363,"_204":364,"_206":-5},{"_200":344,"_202":345,"_204":346,"_206":347},{"_200":328,"_202":329,"_204":330,"_206":331},{"_200":315,"_202":316,"_204":317,"_206":-5},{"_200":304,"_202":305,"_204":306,"_206":-5},{"_200":287,"_202":288,"_204":289,"_206":-5},{"_200":265,"_202":266,"_204":267,"_206":268},{"_200":234,"_202":235,"_204":236,"_206":237},{"_200":201,"_202":203,"_204":205,"_206":-5},"key","as8mgb9p2dlbnu2a8zmh81q9sf","anchorAt","2026-11-18T05:33:34.368Z","item",{"_207":208,"_32":209,"_210":211,"_212":213,"_214":215,"_216":217,"_218":203,"_14":219,"_220":221,"_222":223,"_224":225,"_12":226,"_227":-5},"group","id","s8mgb9p2dlbnu2a8zmh81q9sf","40 个 AI 智能体在“永不放弃”指令下攻击 Epoch AI 真实网站","summary","Trajectory Labs 测试 Gemini 4 Argon 智能体时，约 40 个智能体在“NEVER stop, NEVER give up”指令下扫描 Epoch AI 站点，试图获取不存在的 FrontierMath 答案。","reason","复盘了高能力智能体在失败压力下突破隔离、访问真实站点并协作完成任务的过程，并给出隔离、监控和凭据治理建议。","source",{"_49":233},"publishedAt","2026-11-18T04:46:26.000Z","timelineAt","ai-security","tags",[228,229,230,231,232],"score",73,"selected",true,"news","x","AI 安全","Agent 安全","AI 攻防","大模型","Google","安全客","f1622","2026-11-18T05:35:33.088Z",{"_207":245,"_32":248,"_210":249,"_212":250,"_214":251,"_216":252,"_218":253,"_14":254,"_220":255,"_222":256,"_224":225,"_12":226,"_227":-5},{"_238":239,"_240":63,"_241":31,"_242":243},"factId","fd55XLZ5t838","additionalSourceCount","reportCount","memberIds",[244,245,246,247],"w9ym68dylhzzmoviqlpdxj6rx","npae2p2bauihkhq9p8huoutnf","ud1vjr1zfducwc79z1g197n47","k6706a5hgaf72jqkq6a66bv3v","OpenJDK 披露 Base64 解码远程代码执行漏洞 CVE-2026-114938","OpenJDK Java4Shell Base64解码远程代码执行漏洞 CVE-2026-114938 可经网络输入在无需认证的条件下劫持执行流。受影响范围包括 OpenJDK 17、21、25、27及对应 GraalVM，部分 Keycloak、Jira、Confluence 等产品存在未授权 RCE。","文章给出利用链、受影响产品、版本区间与临时缓解参数，便于团队快速核对暴露资产并安排升级。",{"_49":164},"2026-11-18T01:41:00.000Z","2026-11-18T15:36:33.764Z","vuln",[257,258,259,260,261,262,263,264],90,"漏洞","漏洞分析","补丁","Oracle","Red Hat","Microsoft","Atlassian","AWS","f1631","2026-11-18T07:37:33.313Z",{"_207":86,"_32":274,"_210":275,"_212":276,"_214":277,"_216":278,"_218":279,"_14":280,"_220":281,"_222":282,"_224":225,"_12":226,"_227":-5},{"_238":269,"_240":45,"_241":63,"_242":270},"fXDd5gj0lrbY",[271,272,86,273],"saey04aqdf8xdwkej3c0z9atc","vq1n2ssxgat154a1fajfm0rrl","k3829o4ln4p5jn20jwtztel6i","Microsoft Agent Framework 的 PyPI 包 1.26.1 和 1.26.2 被植入凭据窃取代码","攻击者篡改 Microsoft Agent Framework 的官方 PyPI 包，发布恶意版本 1.26.1 和 1.26.2，在 Python 启动时自动收集环境变量、配置文件及进程中的 Azure、AWS、GitHub、Docker、Hugging Face、OpenAI 等凭据。","文章还原了恶意版本自动执行、窃取多种云凭据及连续发布的完整链路，并给出隔离环境与轮换凭据等处置方法。",{"_49":50},"2026-11-18T16:58:42.000Z","2026-11-18T17:42:32.830Z","activity",[283,284,285,286,228,262],92,"攻击活动","恶意软件","供应链投毒","凭据","apqb2lvhyjfidsw1ft4216qs1h","2026-11-18T08:36:39.563Z",{"_207":290,"_32":291,"_210":292,"_212":293,"_214":294,"_216":295,"_218":288,"_14":296,"_220":297,"_222":298,"_224":225,"_12":226,"_227":-5},"pqb2lvhyjfidsw1ft4216qs1h","LibreOffice JDBC 驱动加载与 HSQLDB 任意代码执行漏洞分析：CVE-2026-104007 与 CVE-2026-104692","本文分析 LibreOffice 的 CVE-2026-104007 与 CVE-2026-104692 两处缺陷：前者因 JDBC 驱动加载位置取自数据库文档本身，打开文档即可加载并运行文档提供的 Java 代码；后者因捆绑的 HSQLDB 在通用 JDBC 驱动下不限制可调用方法，SQL 可调用任意 Java 方法执行代码。","从源码层面拆解了两条漏洞的触发路径与修复差异，并给出可复现的 PoC 文档生成流程，便于判断自用环境是否受影响。",{"_49":303},"2026-11-18T06:23:48.000Z","disclosure",[258,299,300,301,302],74,"复现","漏洞利用","利用链","技术研究","先知社区","f1636","2026-11-18T08:36:39.574Z",{"_207":307,"_32":308,"_210":309,"_212":310,"_214":311,"_216":312,"_218":305,"_14":296,"_220":313,"_222":314,"_224":225,"_12":226,"_227":-5},"dj7tjc7ykl392svc4ve52lfaw","LiteLLM Proxy CVE-2026-30623 命令注入漏洞复现与源码审计","LiteLLM Proxy 的 MCP 测试连接接口存在命令注入漏洞 CVE-2026-30623。携带有效 Bearer API Key 后，攻击者可控制 stdio 配置中的 command 与 args，以 bash -c 执行任意系统命令；未携带 API Key 时返回 401，数据库未连接也不影响该接口触发。","文章从参数流转、子进程调用与接口分支还原利用条件，并区分鉴权、权限和数据库状态对复现的影响。",{"_49":303},"2026-11-17T08:20:43.000Z",[258,299,300,228,229,231],71,"f1648","2026-11-18T11:08:32.000Z",{"_207":318,"_32":319,"_210":320,"_212":321,"_214":322,"_216":323,"_218":316,"_14":254,"_220":324,"_222":325,"_224":225,"_12":226,"_227":-5},"eenizee3z2wwp5xmzqyvxtlbd","Perforce Puppet RCE 漏洞 CVE-2026-115731 已被利用并列入 KEV","Perforce Puppet 漏洞 CVE-2026-115731 已在真实攻击中被利用，该严重漏洞源于报告处理中的不安全反序列化，可导致 RCE，CVSS 为 9.4。","文章交代了利用前提、补丁版本与攻击后果，可帮助管理员判断 Puppet 部署是否需要紧急处置。",{"_49":77},"2026-11-18T10:37:08.000Z",[257,326,259,327],77,"在野利用","CISA","f1651","2026-11-18T11:32:33.719Z",{"_207":334,"_32":336,"_210":337,"_212":338,"_214":339,"_216":340,"_218":329,"_14":296,"_220":341,"_222":342,"_224":225,"_12":226,"_227":-5},{"_238":332,"_240":129,"_241":95,"_242":333},"fFhKQzwxOQPU",[334,335],"p75psh5s1kxd4bxaxikak4wzy","bmns3jr1jbe4v9f3n8o610u4x","OpenJDK Base64 解码器 RCE 漏洞 CVE-2026-114938 已复现","OpenJDK Base64 解码器远程代码执行漏洞 CVE-2026-114938 已由奇安信 CERT 成功复现，评级高危，CVSS 3.1 分数 8.1，PoC 与技术细节均已公开。","通告给出具体受影响版本、CPU 指令集前提、PoC 状态和补丁版本，便于读者核对部署环境并安排升级。",{"_49":165},"2026-11-18T01:58:00.000Z",[302,299,258,300,260,343],82,"奇安信","f1653","2026-11-18T11:38:33.252Z",{"_207":351,"_32":352,"_210":353,"_212":354,"_214":355,"_216":356,"_218":357,"_14":280,"_220":358,"_222":359,"_224":225,"_12":226,"_227":-5},{"_238":348,"_240":349,"_241":95,"_242":350},"fHCkQP7oR3a8",0,[351],"kn9xddwsstfik1uerh6nlroty","Cisco Talos 发现 UAT-12643 使用 Overlord RAT 与 Good Game 窃取加密货币及账号数据","Cisco Talos 发现以牟利为目的的 UAT-12643 使用 Overlord RAT、Good Game 信息窃取器和多加密货币剪贴板劫持器，针对加密货币持有者、游戏平台账号及 VoIP 用户。","报告还原了 UAT-12643 的投递链、恶意软件组合、区块链 C2 机制与数据外传方式，可用于识别相似诱饵和失陷迹象。",{"_49":161},"2026-11-18T11:00:00.000Z","2026-11-18T11:38:33.270Z",[283,284,360,361,286,262],75,"数据窃取","后门","f1665","2026-11-18T13:43:33.417Z",{"_207":365,"_32":366,"_210":367,"_212":368,"_214":369,"_216":370,"_218":363,"_14":296,"_220":371,"_222":372,"_224":225,"_12":226,"_227":-5},"tcrabdy5aroknob52f3barjmz","AMD 固件 CVE-2026-43613 可绕过 TPM 锁定并破解 Windows Hello 与 BitLocker PIN","Technische Universität Berlin 研究人员演示如何在具备物理访问权限时重置 AMD PC 的固件 TPM 锁定状态，从而猜测 Windows Hello 和 BitLocker PIN；测试中分别在 236 次尝试内找到 4 位与 6 位 PIN，最坏耗时由 69 天降至 40 小时、由 19 年降至 20 天。","原文公开了两种绕过 TPM 锁定计数的实验原理、硬件前提与耗时数据，便于评估短 PIN 风险和处置优先级。",{"_49":57},"2026-11-18T12:28:30.000Z",[302,258,301,299,286,373,262,327],70,"加密","f1684","2026-11-18T15:41:34.874Z",{"_207":377,"_32":378,"_210":379,"_212":380,"_214":381,"_216":382,"_218":375,"_14":254,"_220":383,"_222":384,"_224":225,"_12":226,"_227":-5},"r5idp638xeh25ay1o0ahw2ys0","OpenJDK Base64 内存破坏漏洞 Java4Shell CVE-2026-114938 的影响与防护","Calif 披露 OpenJDK Base64 解码器内存破坏漏洞 Java4Shell（CVE-2026-114938），CVSS 4.0 评分为 9.2，影响 OpenJDK 17.0.6 及更新版本在支持 AVX-512 VBMI 的 x86-64 处理器上处理攻击者可控 Base64 数据的场景，攻击者无需凭据即可触发越界写入并进一步实现堆内存泄露或 RCE。","文章结合漏洞触发条件、内存破坏原理与多阶段利用链，给出临时关闭高风险代码路径及 WAF 防护配置，便于评估自身 Java 运行时并安排修复。",{"_49":162},"2026-11-18T14:52:10.000Z",[257,259,299,300,302,385,386,260,262,261,263],83,"云原生","Cloudflare","f1686","2026-11-18T15:41:36.953Z",{"_207":393,"_32":395,"_210":396,"_212":397,"_214":398,"_216":399,"_218":388,"_14":296,"_220":400,"_222":401,"_224":225,"_12":226,"_227":-5},{"_238":391,"_240":129,"_241":95,"_242":392},"fhCq_qoGx8H4",[393,394],"u0eiew4pjyv180isf2uqksz3w","wu8b3arca0kc295h5ms9ikw2m","Xint 披露 nginx2Root 五项 RCE 漏洞及 Linux 内核提权链","Xint 披露 nginx 的 5 项未认证远程代码执行漏洞 CVE-2026-123007、CVE-2026-123634、CVE-2026-123633、CVE-2026-121810、CVE-2026-113425。","文章拆解了五项 nginx 远程代码执行漏洞的根因、利用链和暴露条件，并提供逐配置缓解方法与取证检查，便于评估实际处置范围。",{"_49":405},"2026-11-18T15:29:55.488Z",[258,299,300,301,259,402,403,404,264],100,"内核","Ubuntu","Debian","Sec-News 安全文摘","f1687","2026-11-18T15:42:35.270Z",{"_207":409,"_32":410,"_210":411,"_212":412,"_214":413,"_216":414,"_218":407,"_14":219,"_220":415,"_222":372,"_224":225,"_12":226,"_227":-5},"rcdhs8ytgfe71j7zx2q9f2ktt","Rapid7 发现暴露的 Ollama 服务器已被第三方租用和控制","Rapid7 对 20,354 个预选 IPv4 地址的快照分析显示，过滤疑似诱捕基础设施后，仍有 7,627 台主机在未认证状态下响应 AI 或 Notebook API，其中 7,675 个 Ollama 发现项经校正后成立，54.8% 的 Ollama 主机带有第三方活动痕迹。","文章用单次扫描和模型清单还原第三方占用计算资源的手法，并区分暴露面与真实活动，为排查 AI 服务失陷提供了可操作线索。",{"_49":173},"2026-11-18T14:38:55.000Z",[228,302,326,283,416,417,260,418,232,262,386],"供应链","Rapid7","腾讯","f1693","2026-11-18T16:43:34.043Z",{"_207":425,"_32":427,"_210":428,"_212":429,"_214":430,"_216":431,"_218":420,"_14":254,"_220":432,"_222":433,"_224":225,"_12":226,"_227":-5},{"_238":423,"_240":129,"_241":95,"_242":424},"fDXki9WjLuc0",[425,426],"vtnlqahysuq4nbnn9rx69mhj2","cwu93v3xv2cyladm64pf9ngtg","F5 与 Rapid7 披露 NGINX HTTP/2 整数下溢漏洞 CVE-2026-123007，可导致 RCE","F5 与 Rapid7 披露 NGINX HTTP/2 整数下溢漏洞 CVE-2026-123007，未认证远程攻击者在特定条件下可触发内存破坏，以 nginx worker process 权限执行代码。","原文从 HTTP/2 流控记账、整数下溢到越界内存访问完整拆解了利用链，并列出受影响版本和修复版本。",{"_49":173},"2026-11-18T13:56:42.000Z",[257,299,300,302,259,434,417],76,"网络设备","f1696","2026-11-18T17:38:33.887Z",{"_207":438,"_32":439,"_210":440,"_212":441,"_214":442,"_216":443,"_218":436,"_14":254,"_220":444,"_222":298,"_224":225,"_12":226,"_227":-5},"x6hr1d05vc1eniaapst9d20m2","OpenJDK Base64 解码远程代码执行漏洞 CVE-2026-114938 已复现","OpenJDK Base64 解码远程代码执行漏洞 CVE-2026-114938 已被成功复现。漏洞影响 JDK 17 及以上版本，位于 x86-64 处理器的 AVX-512 VBMI 优化代码中；特定尾部填充字符会触发约 62 字节的堆越界写入，在满足利用条件时可执行任意代码，无须用户权限或受害者配合。","文章复现了 OpenJDK Base64 解码远程代码执行漏洞，并说明堆越界成因、硬件前提与受影响版本，便于相关团队核对资产和安排升级。",{"_49":163},"2026-11-18T01:01:00.000Z",[257,299,300,260,258],"ak04ilqg9s0fa5seo9mrr2tsc0","2026-11-18T18:47:33.562Z",{"_207":448,"_32":449,"_210":450,"_212":451,"_214":452,"_216":453,"_218":446,"_14":254,"_220":454,"_222":455,"_224":225,"_12":226,"_227":-5},"k04ilqg9s0fa5seo9mrr2tsc0","F5 披露 NGINX 远程代码执行漏洞 CVE-2026-123633 与 CVE-2026-123007","F5 于 18 novembre 2026 披露 CVE-2026-123633 与 CVE-2026-123007，未认证攻击者可利用 HTTP/2 在 NGINX Open Source 和 NGINX Plus 上远程执行代码。","通告列明两项漏洞的受影响版本、未认证远程代码执行条件及公开 PoC 情况，并提供关闭 HTTP/2 的临时缓解配置。",{"_49":158},"2026-11-18T00:00:00.000Z",[257,259,299,300,434],81,"akijmkm433626ppipkgcxpghrg","2026-11-18T19:49:33.688Z",{"_207":459,"_32":460,"_210":461,"_212":462,"_214":463,"_216":464,"_218":457,"_14":254,"_220":465,"_222":298,"_224":225,"_12":226,"_227":-5},"kijmkm433626ppipkgcxpghrg","F5 披露 6 项 CVSS 9.8 的 BIG-IP 严重漏洞，可导致流量中断与 RCE","F5 披露 6 项 BIG-IP 栈型缓冲区溢出漏洞，攻击者无需登录即可使 TMM 崩溃并中断流量，也可能实现远程代码执行。","六项漏洞均给出触发配置与受影响产品线，并明确只能通过工程热修复缓解，便于管理员核对自身环境。",{"_49":57},"2026-11-18T18:15:39.000Z",[257,259,258,434,416],"f1701","2026-11-18T20:47:39.904Z",{"_207":469,"_32":470,"_210":471,"_212":472,"_214":473,"_216":474,"_218":467,"_14":254,"_220":475,"_222":298,"_224":225,"_12":226,"_227":-5},"a7w3tajom8oplmgsmeq9ufff4","Apache Roller 未认证 RCE 漏洞 CVE-2026-129448 已被在野利用","Apache Roller 的未认证远程代码执行漏洞 CVE-2026-129448（CVSS 9.8）已被确认在野利用，影响 4.0.0 至 6.1.4 版本。","Apache Roller 漏洞已被确认在野利用，且此前通告的受影响版本范围存在遗漏，管理员可据此排查暴露面并选择升级或临时缓解。",{"_49":60},"2026-11-18T20:11:35.000Z",[257,326,259],"f1705","2026-11-18T20:58:33.370Z",{"_207":479,"_32":480,"_210":481,"_212":482,"_214":483,"_216":484,"_218":477,"_14":254,"_220":485,"_222":372,"_224":225,"_12":226,"_227":-5},"gukgjp3s7yxibgjappzmj3sk7","Atomic Server /bookmark 端点存在未授权完整响应 SSRF","Atomic Server 的 GET /bookmark 端点无需认证即可请求攻击者指定的 URL，并回显响应正文，构成 CVSS:3.1 8.6 的完整响应 SSRF。","文章沿源码调用链定位了未授权完整响应 SSRF，并给出可直接验证的请求与可迁移的 DNS、重定向防护建议。",{"_49":486},"2026-11-18T20:42:50.000Z",[257,299,300,258],"GitHub 安全公告","f1722","2026-11-18T23:15:32.954Z",{"_207":490,"_32":491,"_210":492,"_212":493,"_214":494,"_216":495,"_218":488,"_14":280,"_220":496,"_222":298,"_224":225,"_12":226,"_227":-5},"wirnox4qkgxmb80632xwozft4","乌克兰与 FBI 逮捕勒索组织成员，涉及逾 $40.5M 赎金","乌克兰执法部门与 FBI 逮捕 4 名国际勒索组织疑似成员，该组织至少涉及全球 28 家企业、逾 $40.5M 赎金支付。调查历时两年，团伙至少有 27 人，并与覆盖 8 个司法辖区、60 余人的网络有关联。","案件揭示了勒索组织利用 AI 语音冒充 IT 支持、钓鱼页面窃取凭据和远程访问工具入侵企业的完整流程。",{"_49":50},"2026-11-18T23:08:33.000Z",[283,497,284,498,499,230],"勒索","数据泄露","钓鱼","abzmlhrqxgyrgpr1mdm2fy2m7v","2026-11-19T00:01:33.443Z",{"_207":503,"_32":504,"_210":505,"_212":506,"_214":507,"_216":508,"_218":501,"_14":280,"_220":509,"_222":510,"_224":225,"_12":226,"_227":-5},"bzmlhrqxgyrgpr1mdm2fy2m7v","勒索软件访问中介从公开论坛转向私人渠道，2026 年受害者声明已超 2025 年","ZeroFox 统计显示，勒索与敲诈团伙截至 2026 年 10 月每月声称约 718 名受害者，高于 2025 年每月约 573 名；第三季度记录至少 2,381 起事件，比此前最高的 2,091 起高约 14%。","公开论坛交易减少并不代表勒索活动降温，文章用受害者数量、渠道转移和凭证价格说明监测重点正在变化。",{"_49":119},"2026-11-18T23:28:20.000Z",[283,497,511,360,416,262],72,"黑产",{"_513":514,"_515":-5},"changelogVersion","2026-10-01T08:00","release"]
