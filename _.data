ailyinfo/media/3a544a742516b0af.webp 48w, /dailyinfo/media/198a4d86de90e233.webp 96w","Rapid7 CVE 公告","/dailyinfo/media/092fbeae5b5c3123.webp","/dailyinfo/media/c16323cf53c574df.webp 48w, /dailyinfo/media/092fbeae5b5c3123.webp 96w","Cisco披露VOLTA用AI评估窃密受害者",21.9,"up","41881cfd-565d-48f3-8331-58892c484e4a","l8c38b2h5meavjepjvszce1ro",[84,85,86],{"_49":50,"_51":52,"_53":54,"_55":56},{"_49":60,"_51":52,"_53":61,"_55":62},{"_49":87,"_51":52,"_53":88,"_55":89},"The Hacker News","/dailyinfo/media/3d21685a726d0a64.jpg","/dailyinfo/media/a1e7de8b6809b50e.jpg 48w, /dailyinfo/media/3d21685a726d0a64.jpg 96w",2,"FBI归因TraderTraitor窃取Binance资产",28.5,"6ef2ec24-f871-4ca2-9cc2-5fcbd249af24","uu0z6mo1muhhj4bo1sst643w9",[97,98,99,100,101,102],6,{"_49":57,"_51":52,"_53":58,"_55":59},{"_49":60,"_51":52,"_53":61,"_55":62},{"_49":72,"_51":52,"_53":73,"_55":74},{"_49":50,"_51":52,"_53":54,"_55":56},{"_49":103,"_51":52,"_53":104,"_55":105},{"_49":87,"_51":52,"_53":88,"_55":89},"Hackread","/dailyinfo/media/dd06beac4cadc6f3.webp","/dailyinfo/media/47417cbef4636b7b.webp 48w, /dailyinfo/media/dd06beac4cadc6f3.webp 96w",1,"Google拆除XCPE僵尸网络并封禁Videostrong",31.5,"d06829ad-986b-44e7-8164-4a64599bab09","wbjzunigapakv96vd54t9g53c",[112,113,114,115],{"_49":116,"_51":52,"_53":117,"_55":118},{"_49":72,"_51":52,"_53":73,"_55":74},{"_49":60,"_51":52,"_53":61,"_55":62},{"_49":87,"_51":52,"_53":88,"_55":89},"Google Cloud 威胁情报","/dailyinfo/media/424bd6373c2d87d6.webp","/dailyinfo/media/9a88f7a6491d815b.webp 48w, /dailyinfo/media/424bd6373c2d87d6.webp 96w","2026-11-03","2026-11-02",11,"2026-11-01","2026-10-31",13,{"_145":470,"_147":471,"_149":472,"_151":-5},{"_145":459,"_147":460,"_149":461,"_151":-5},{"_145":448,"_147":449,"_149":450,"_151":-5},{"_145":430,"_147":431,"_149":432,"_151":433},{"_145":412,"_147":413,"_149":414,"_151":415},{"_145":397,"_147":398,"_149":399,"_151":-5},{"_145":387,"_147":388,"_149":389,"_151":-5},{"_145":370,"_147":371,"_149":372,"_151":373},{"_145":359,"_147":360,"_149":361,"_151":-5},{"_145":348,"_147":349,"_149":350,"_151":-5},{"_145":336,"_147":337,"_149":338,"_151":-5},{"_145":323,"_147":324,"_149":325,"_151":-5},{"_145":307,"_147":308,"_149":309,"_151":-5},{"_145":288,"_147":289,"_149":290,"_151":291},{"_145":274,"_147":275,"_149":276,"_151":-5},{"_145":253,"_147":254,"_149":255,"_151":256},{"_145":235,"_147":236,"_149":237,"_151":238},{"_145":213,"_147":214,"_149":215,"_151":216},{"_145":189,"_147":190,"_149":191,"_151":192},{"_145":146,"_147":148,"_149":150,"_151":152},"key","f408","anchorAt","2026-10-31T08:59:15.589Z","item",{"_161":159,"_32":162,"_163":164,"_165":166,"_167":168,"_169":170,"_171":172,"_14":173,"_174":175,"_176":177,"_178":179,"_12":180,"_181":-5},"group",{"_153":154,"_155":106,"_156":90,"_157":158},"factId","fluIysH7e1EM","additionalSourceCount","reportCount","memberIds",[159,160],"sadp3rc08vj8hs3yc7r72lm24","g1yjx90drqjyvf0az6cq04rgs","id","CNCERT披露VeilDHT僵尸网络大范围感染Linux服务器与IoT设备","summary","国家互联网应急中心（CNCERT）监测发现VeilDHT僵尸网络正通过漏洞利用大范围传播，主要感染Linux服务器与IoT设备。2026年10月16日至10月26日期间，我国境内累计40467台设备受感染，境内日上线肉鸡数最高达15805台。","reason","原文梳理了VeilDHT的双通道控制机制、加密通信、攻击能力与40467台感染规模，便于识别该僵尸网络的传播和防护重点。","source",{"_49":188},"publishedAt","2026-11-02T09:49:00.000Z","timelineAt","2026-11-02T11:46:32.053Z","activity","tags",[182,183,184,185,186,187],"score",83,"selected",true,"news","x","攻击活动","恶意软件","僵尸网络","漏洞利用","IoT","CNCERT","安全内参","f409","2026-10-31T10:12:17.365Z",{"_161":195,"_32":196,"_163":197,"_165":198,"_167":199,"_169":200,"_171":201,"_14":202,"_174":203,"_176":204,"_178":179,"_12":180,"_181":-5},{"_153":193,"_155":106,"_156":90,"_157":194},"fBXRC7O56Fow",[195],"tqj4dxtikwan2dwzgf1hpjvys","Ivanti Connect Secure 三个零日漏洞已被链式利用，CVE-2026-111357 与 CVE-2026-118527 纳入 KEV","Ivanti Connect Secure 的 CVE-2026-111357、CVE-2026-118527 与 CVE-2026-104935 已被链式利用，可获取未认证 root 权限并窃取 Windows LAPS 密码和 BitLocker 恢复密钥，UTA0576 自 2026 年 10 月 3 日起攻击运行 22.8R2.4 的设备，影响客户数量有限。","材料串联三个 Ivanti Connect Secure 零日漏洞的在野利用链，并给出受影响版本、修复版本及排查证据，便于评估暴露与应急处置需求。",{"_49":75},"2026-11-02T11:04:08.000Z","2026-11-02T11:48:33.412Z","vuln",[205,206,207,208,209,210,211,212],86,"漏洞","在野利用","补丁","利用链","应急响应","Ivanti","Rapid7","CISA","f412","2026-10-31T12:02:30.138Z",{"_161":82,"_32":219,"_163":220,"_165":221,"_167":222,"_169":223,"_171":214,"_14":173,"_174":224,"_176":225,"_178":179,"_12":180,"_181":-5},{"_153":217,"_155":45,"_156":63,"_157":218},"fAFp_Yp6uqsI",[82],"VOLTA-AUTODOXER 利用 LLM 对窃取数据进行受害者价值评估","Cisco Talos 分析了自删除型 Windows 信息窃取程序 VOLTA-AUTODOXER：它采集浏览器凭据、会话、支付卡、加密钱包种子、OAuth 令牌、云端密钥、Wi-Fi 密码及截图后，将结构化证据发送至 OpenRouter，由 LLM 生成包含“WHAT THEY'RE WORTH”和“THEIR OPSEC”的受害者评估。","文章拆解了 VOLTA 将 LLM 接入受害者筛选流程的方式，并给出模型拒绝时的回退链与事件响应处置要点。",{"_49":234},"2026-10-31T12:00:00.000Z",[182,183,226,227,228,229,230,231,232,233],75,"AI 攻防","数据窃取","大模型","凭据","Google","Microsoft","Mozilla","Oracle","Cisco Talos","f413","2026-10-31T13:02:30.480Z",{"_161":241,"_32":243,"_163":244,"_165":245,"_167":246,"_169":247,"_171":236,"_14":173,"_174":248,"_176":249,"_178":179,"_12":180,"_181":-5},{"_153":239,"_155":106,"_156":90,"_157":240},"fWnIQuGAfSM0",[241,242],"rvzo6jnjpnoo4hypna7k8fk0f","wzjcsrijtimb18s48r4hgz18b","群晖NAS设备遭C3RB3R勒索攻击，官方建议更新至安全版本","国内外多起群晖（Synology）NAS勒索攻击已被报告，部分设备文件被加密并添加.L0CK3D后缀，出现read-me3.txt勒索信，攻击被认为与C3RB3R（Cerber）勒索软件有关。","多地用户报告群晖NAS遭勒索加密，官方已关联到旧版系统漏洞并给出更新、隔离和备份建议。",{"_49":188},"2026-10-31T00:09:00.000Z",[182,250,183,206,251,252],78,"勒索","网络设备","漏洞管理","f416","2026-10-31T16:16:29.716Z",{"_161":259,"_32":261,"_163":262,"_165":263,"_167":264,"_169":265,"_171":266,"_14":267,"_174":268,"_176":269,"_178":179,"_12":180,"_181":-5},{"_153":257,"_155":106,"_156":90,"_157":258},"fafTcIRBwfko",[259,260],"vwazprhy9sym8n3jfpzyapz5g","midioamfhtgq777zsyrovhu36","Android SMS of Death 漏洞分析：CVE-2026-58882 可用零点击 WAP Push 消息阻断电话服务","独立研究员 Mark Blaszczyk 披露 Android 的 SMS of Death 漏洞 CVE-2026-58882，攻击者仅需发送一条特制 WAP Push 消息即可零点击触发崩溃，阻断电话及紧急呼叫。","文章拆解了零点击 WAP Push 消息触发电话服务崩溃的原理、复现效果与修复范围，便于评估旧款 Android 设备的暴露风险。",{"_49":50},"2026-11-01T12:16:50.000Z","2026-11-01T13:26:34.091Z","disclosure",[270,271,272,273,230],79,"漏洞分析","复现","技术研究","移动端","f417","2026-10-31T18:18:14.404Z",{"_161":277,"_32":278,"_163":279,"_165":280,"_167":281,"_169":282,"_171":275,"_14":173,"_174":283,"_176":284,"_178":179,"_12":180,"_181":-5},"cyr7bz2bmyz5ecu55k6xo4e2y","Northflank 安全 breach 导致客户 AI API 密钥被滥用","Northflank 在安全 breach 后要求所有客户轮换平台内保存的环境变量、API 密钥及其他 secrets，并确认多名客户发现 AI API 密钥遭到未授权使用。","Northflank 事件展示了平台环境变量解密后，攻击者如何滥用客户 AI API 密钥，并给出明确的密钥轮换与用量核查建议。",{"_49":72},"2026-10-31T18:01:12.000Z",[182,285,229,286,287,228],71,"数据泄露","云原生","容器","f419","2026-11-01T08:31:32.784Z",{"_161":94,"_32":299,"_163":300,"_165":301,"_167":302,"_169":303,"_171":304,"_14":173,"_174":305,"_176":306,"_178":179,"_12":180,"_181":-5},{"_153":292,"_155":31,"_156":96,"_157":293},"f39FEvqrWazs",[294,94,295,296,297,298],"ajeln3eoz2hpbkktjxf74gmhw","soky2baypc752nl7uv0q0gsa7","i65y8agid7mtlqotud98ny7rx","ukmzi9ui1tnps2hcthy290dt4","tomiopf7c2bqt8grmb42v0jqt","FBI 将 Binance 63 亿美元加密资产窃取案归因于朝鲜 TraderTraitor","FBI 确认朝鲜国家支持的 TraderTraitor 实施了 Binance 加密资产窃取案，涉及 2026 年 10 月 29 日前后超过 $6 billion 的虚拟资产，攻击者通过入侵 DevOps 工程师笔记本进入服务容器并提交未授权提现交易。","原文披露了攻击入口、跨链资金流向、资产洗钱路径及公开地址，为加密交易所识别和拦截关联资金提供了具体依据。",{"_49":72},"2026-11-01T19:57:53.000Z","2026-11-01T20:43:31.348Z",[182,227,206,183],87,"f422","2026-11-02T03:38:37.417Z",{"_161":310,"_32":311,"_163":312,"_165":313,"_167":314,"_169":315,"_171":308,"_14":316,"_174":317,"_176":318,"_178":179,"_12":180,"_181":-5},"o24ucbtgopfr2yuihm7llam2f","LocalAlign 通过近目标对抗训练提升大语言模型提示注入防御泛化能力","LocalAlign 通过近目标对抗样本生成与 Margin-Aware Alignment 提升大语言模型的提示注入防御泛化能力，防御能力写入模型参数，推理时无需额外调用攻击检测模型。","论文将提示注入防御的泛化问题拆分为输入侧与目标侧，并用消融实验说明近目标生成和边际感知对齐各自的贡献。",{"_49":188},"2026-11-01T07:38:37.395Z","ai-security",[319,320,321,322,228],74,"AI 安全","模型安全","论文","Agent 安全","f426","2026-11-02T05:42:32.410Z",{"_161":326,"_32":327,"_163":328,"_165":329,"_167":330,"_169":331,"_171":324,"_14":267,"_174":332,"_176":249,"_178":179,"_12":180,"_181":-5},"shfnqqty603i8l19g63b43gpl","EDK II PXE 驱动漏洞 CVE-2026-97631 允许启动前执行代码","EDK II 的 PXE 网络启动驱动存在 CVE-2026-97631，CVSS 4.0 评分 9.5；攻击者可在 Secure Boot 和度量启动校验前触发越界写入，在操作系统加载前执行代码或造成拒绝服务。","文章梳理了漏洞利用前提、固件影响范围与修复时间线，并给出关闭或隔离 PXE 的可迁移处置思路。",{"_49":335},"2026-11-02T00:30:00.000Z",[270,272,185,333,251,231,334],"操作系统","Red Hat","安全客","f430","2026-11-02T09:56:31.038Z",{"_161":339,"_32":340,"_163":341,"_165":342,"_167":343,"_169":344,"_171":337,"_14":202,"_174":345,"_176":346,"_178":179,"_12":180,"_181":-5},"c9fe12dhjhogapha6lstoepdb","Ivanti 修复 Connect Secure 两个零日漏洞，CVE-2026-111357 与 CVE-2026-118527 已被链式利用","Ivanti 修复了 Connect Secure 的两个已被链式利用的零日漏洞，高危权限提升漏洞 CVE-2026-111357 与允许已认证攻击者上传文件的 CVE-2026-118527，自10月1日起与认证绕过漏洞 CVE-2026-104935 组合攻击。","文章串联3个已被链式利用的漏洞，并披露攻击者未部署恶意软件而是通过重复漏洞利用执行命令。",{"_49":72},"2026-11-02T09:33:26.000Z",[205,207,206,208,347,210,212],84,"身份与访问","f432","2026-11-02T10:47:35.469Z",{"_161":351,"_32":352,"_163":353,"_165":354,"_167":355,"_169":356,"_171":349,"_14":173,"_174":357,"_176":284,"_178":179,"_12":180,"_181":-5},"zpp06qhnjm5r6ekq6fx53gr5s","攻击者向乌克兰和俄罗斯民众发送虚假核威胁与袭击警报","乌克兰和俄罗斯的应急警报应用疑遭网络攻击，向民众发送核威胁、辐射、化学攻击和巷战等虚假警报，相关说法尚未获独立证实。乌克兰 Air Alarm 应用于当地时间 22:47 起发出多条警报，部分警报还触发 Lviv 地区广播；该应用随后因疑似被攻破而临时停用。","事件同时呈现应急警报应用被篡改和停机之间的安全取舍，并给出官方备份渠道与反钓鱼提醒。",{"_49":50},"2026-11-02T10:20:46.000Z",[182,358,273,209],"钓鱼","f433","2026-11-02T11:43:33.026Z",{"_161":362,"_32":363,"_163":364,"_165":365,"_167":366,"_169":367,"_171":360,"_14":173,"_174":368,"_176":225,"_178":179,"_12":180,"_181":-5},"t0wff82r3vhco60wkrm3qmm96","攻击者伪装 Microsoft Teams IT 支持，利用不安全 AD CS 窃取企业数据","Microsoft 调查了两起攻击者伪装 IT 支持并诱导员工通过 Microsoft Teams 使用 Quick Assist 授予远程控制的入侵，攻击者随后利用不安全配置的 AD CS 获取高权限账户及域控制器证书，其中一起将企业数据复制到外部服务器。","两起入侵展示了社会工程、Quick Assist 与不安全 AD CS 配置如何串联成数据窃取，并暴露自动响应遗漏高权限账户的处置风险。",{"_49":87},"2026-11-02T11:08:45.000Z",[182,285,229,347,231,369],"检测工程","f436","2026-11-02T11:46:38.841Z",{"_161":376,"_32":378,"_163":379,"_165":380,"_167":381,"_169":382,"_171":383,"_14":202,"_174":384,"_176":204,"_178":179,"_12":180,"_181":-5},{"_153":374,"_155":106,"_156":90,"_157":375},"fz-RW5_XrdCA",[376,377],"zn3wl1ipk6y4uimbmwjbo86fy","gfyff5sznq8xbz15ruw0wykcz","Microsoft Windows Update Stack 本地权限提升漏洞 CVE-2026-81963 已复现并发现在野利用","Microsoft Windows Update Stack 本地权限提升漏洞 CVE-2026-81963 已发现真实利用，奇安信 CERT 已成功复现；攻击者需取得目标主机低权限账户，可借更新栈未正确校验重解析点将权限提升至 SYSTEM。","原文给出漏洞成因、低权限利用前提、受影响版本和在野利用证据，并附复现及处置建议，便于判断暴露范围与修复优先级。",{"_49":386},"2026-11-02T08:51:00.000Z","2026-11-02T12:49:32.189Z",[205,206,271,185,207,231,385],"奇安信","奇安信 CERT","f438","2026-11-02T11:58:31.141Z",{"_161":390,"_32":391,"_163":392,"_165":393,"_167":394,"_169":395,"_171":388,"_14":173,"_174":396,"_176":177,"_178":179,"_12":180,"_181":-5},"n1pma2heqqc1u393qm8xxm48n","Synology警告C3RB3R勒索软件利用旧版DSM漏洞攻击NAS设备","Synology确认攻击者正利用2024年12月已修复的漏洞，针对运行过时DSM版本的NAS设备实施C3RB3R勒索攻击。","Synology确认旧版DSM漏洞已遭C3RB3R勒索软件利用，并给出各版本修复版本与接口隔离建议。",{"_49":72},"2026-11-02T11:28:42.000Z",[182,250,183,206,186,185],"f439","2026-11-02T12:41:36.164Z",{"_161":400,"_32":401,"_163":402,"_165":403,"_167":404,"_169":405,"_171":398,"_14":316,"_174":406,"_176":407,"_178":179,"_12":180,"_181":-5},"teaxhs6mgmqr7we21mxnq1hmt","Trail of Bits 使用 Codex 批量回移 Linux 安全修复，已覆盖 149 个 CVE","Trail of Bits 使用 Codex 与 GPT-5.6 协助将安全修复回移到 Linux 稳定分支及 Ubuntu、Fedora 等软件包。","文章用稳定分支的漏洞缺口和 149 个已完成回移修复，展示了 AI Agent 辅助安全补丁回移的实际规模与工作流。",{"_49":411},"2026-11-02T12:00:00.000Z",[319,226,228,252,408,207,409,410],70,"内核","Ubuntu","Debian","Trail of Bits","f440","2026-11-02T12:49:37.964Z",{"_161":419,"_32":420,"_163":421,"_165":422,"_167":423,"_169":424,"_171":425,"_14":173,"_174":426,"_176":427,"_178":179,"_12":180,"_181":-5},{"_153":416,"_155":106,"_156":90,"_157":417},"fZgkHH0BZWRg",[418,419],"rnqinqt6srbee22b4h3qhhfn6","c8c3sczng53jdb0j9x5vqc0ry","欧洲多国逾115家超市制冷系统遭攻击，门店被迫处置变质商品","攻击者远程修改欧洲多国超市冷柜和制冷系统的温度设置、关闭制冷设备或启动除霜，导致超过115家门店受到影响，并造成商品损失和提前营业干预。","材料梳理了多国超市制冷系统遭远程操控的规模、受影响门店及处置方式，并指出攻击可能复用法国同类事件中的漏洞。",{"_49":72},"2026-11-02T14:28:39.000Z","2026-11-02T15:00:33.056Z",[182,186,185,428,429],82,"供应链","工控","f447","2026-11-02T13:46:42.052Z",{"_161":110,"_32":439,"_163":440,"_165":441,"_167":442,"_169":443,"_171":431,"_14":173,"_174":444,"_176":445,"_178":179,"_12":180,"_181":-5},{"_153":434,"_155":45,"_156":63,"_157":435},"flU3MNG-JM7M",[436,437,438,110],"p8lgm331w38cxp1dyo8ycly9z","ghi7z0u79zotlr12i1ld0lr79","l79qvcx1c4awu9yey6ibz7nvh","Google 联合处置 XCPE 僵尸网络，Videostrong 预装后门感染逾 130 万台机顶盒","Google 与行业伙伴已拆除 XCPE 后门相关控制基础设施，该后门将超过 1.3 million 台机顶盒及其他 Android IoT 设备纳入僵尸网络。","文章拆解了从固件预装、持久化到模块化变现的完整链条，并提供可核对的样本哈希与网络指标。",{"_49":116},"2026-11-02T14:00:00.000Z",[182,183,446,184,186,447,230],90,"后门","供应链投毒","ak8iee38q6sr0000yquvlj925i","2026-11-02T15:48:37.650Z",{"_161":451,"_32":452,"_163":453,"_165":454,"_167":455,"_169":443,"_171":449,"_14":316,"_174":456,"_176":457,"_178":179,"_12":180,"_181":-5},"k8iee38q6sr0000yquvlj925i","Google Cloud 披露 LLMJacking 攻击链，攻击者转售被盗企业 LLM 资源","Google Cloud 威胁情报披露，攻击者在 2026 年多起 LLMJacking 入侵中盗用企业云身份和 LLM API 凭据，入侵北美、南美及亚太的金融、零售、技术和运输组织，单日欺诈费用超过 $100,000 USD，部分组织累计达 $1 million USD。","文章以多起真实入侵还原 LLMJacking 的获客、变现与检测链路，并给出可落地的云侧审计和加固措施。",{"_49":116},[319,182,183,227,428,228,230,458,231],80,"AWS","f460","2026-11-02T16:01:33.457Z",{"_161":462,"_32":463,"_163":464,"_165":465,"_167":466,"_169":467,"_171":460,"_14":173,"_174":468,"_176":225,"_178":179,"_12":180,"_181":-5},"y3oqogzfuz08thepvfa99u3bx","BTCPay Server 旧版本实例遭遇热钱包盗取，2.4.1及更早版本需升级至2.4.7","BTCPay Server 维护者称，黑客已针对运行 2.4.1（2026年7月23日）或更早版本的实例盗取热钱包资金，攻击未针对公开服务器。项目建议受影响实例尽快下线并升级至 2.4.7；原文称尚无使用 2.4.7 的热钱包盗取可信报告，但近期攻击具体利用的漏洞尚未查明，受影响用户需向 security@btcpayserver.org 提交活动日志。","材料区分了受影响版本、当前利用链尚未查明的部分，以及面向 Docker 和普通安装的更新路径。",{"_49":72},"2026-11-02T15:03:07.000Z",[182,206,227,469,209],"加密","f467","2026-11-02T18:47:35.698Z",{"_161":473,"_32":474,"_163":475,"_165":476,"_167":477,"_169":478,"_171":471,"_14":202,"_174":479,"_176":480,"_178":179,"_12":180,"_181":-5},"g91jpin898ib1bej3gd5gopsn","Linux 内核 CVE-2026-98432 波及自托管 JFrog 运行环境","Linux 内核 CVE-2026-98432 是一处影响新建 IPv4 TCP 连接的 use-after-free 缺陷，自 4.4 起存在，Linux 内核团队评分 9.8。","文章区分了 JFrog 产品与承载环境的风险，并给出按发行版核查内核修复状态和分批更新的操作路径。",{"_49":481},"2026-11-02T18:35:06.000Z",[205,206,271,207,408,409,334,233,458],77,"JFrog Security Research",{"_483":484,"_485":-5},"changelogVersion","2026-10-01T08:00","release"]
