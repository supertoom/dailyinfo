150":335,"_152":336,"_154":337,"_156":-5},{"_150":324,"_152":325,"_154":326,"_156":-5},{"_150":307,"_152":308,"_154":309,"_156":310},{"_150":296,"_152":297,"_154":298,"_156":-5},{"_150":284,"_152":285,"_154":286,"_156":-5},{"_150":272,"_152":273,"_154":274,"_156":-5},{"_150":258,"_152":259,"_154":260,"_156":-5},{"_150":242,"_152":243,"_154":244,"_156":-5},{"_150":221,"_152":222,"_154":223,"_156":-5},{"_150":199,"_152":200,"_154":201,"_156":202},{"_150":182,"_152":183,"_154":184,"_156":-5},{"_150":151,"_152":153,"_154":155,"_156":-5},"key","ajm54e8qi34bvqra3h6ykepgve","anchorAt","2026-11-10T10:25:20.377Z","item",{"_157":158,"_32":159,"_160":161,"_162":163,"_164":165,"_166":167,"_168":153,"_14":169,"_170":171,"_172":173,"_174":175,"_12":176,"_177":-5},"group","id","jm54e8qi34bvqra3h6ykepgve","SAP 修复四项 CVSS 10.0 漏洞，其中两项可导致远程代码执行","summary","SAP 修复 Internet Communication Manager、SAP Web Dispatcher、SAP Gateway 和 SAML2 service provider 的四项 CVSS 10.0 漏洞，分别对应 CVE-2026-76964、CVE-2026-89126、CVE-2026-89103、CVE-2026-120017，均无需用户交互即可攻击。","reason","材料列出四项漏洞的组件、编号、受影响版本和修复方式，可用于核对部署范围并评估补丁优先级。","source",{"_49":50},"publishedAt","2026-11-10T10:02:40.000Z","timelineAt","vuln","tags",[178,179,180,181],"score",79,"selected",true,"news","x","漏洞","补丁","漏洞利用","网络设备","ahipouup5w93oo6ld8b4hx8mhm","2026-11-10T12:48:27.065Z",{"_157":185,"_32":186,"_160":187,"_162":188,"_164":189,"_166":190,"_168":183,"_14":191,"_170":192,"_172":193,"_174":175,"_12":176,"_177":-5},"hipouup5w93oo6ld8b4hx8mhm","研究人员利用 OpenIDM 默认管理员密码接管车联网账户并解锁车辆","研究人员 Shubham Shah 与 Sam Curry 发现，两家汽车品牌的 OpenIDM 登录服务器仍接受文档所载默认管理员凭据；绕过 WAF 后，他们可在身份服务器执行代码，修改测试账户邮箱和密码，并通过正常应用解锁、启动车辆及读取位置与遥测数据。","文章还原了从默认凭据、WAF 绕过到车辆解锁和启动的完整链条，并区分了已修复与处置状态不明的风险。",{"_49":86},"2026-11-10T12:15:00.000Z","disclosure",[194,195,196,197,198],71,"技术研究","漏洞分析","复现","身份与访问","车联网","f925","2026-11-10T13:28:19.687Z",{"_157":68,"_32":210,"_160":211,"_162":212,"_164":213,"_166":214,"_168":215,"_14":191,"_170":216,"_172":217,"_174":175,"_12":176,"_177":-5},{"_203":204,"_205":103,"_206":89,"_207":208},"factId","f_z74Fncncjo","additionalSourceCount","reportCount","memberIds",[68,209],"ykfo6qitddglxhyo1vixfx5o7","forcequitOS 公开 iOS 沙箱逃逸 PoC worse_query，影响 iOS 26.7.1、27.0.1 和 27.2","forcequitOS 公开了名为 worse_query 的 iOS 沙箱逃逸 PoC，可在应用创建 App Group container 后读取其他应用的数据目录，并在 iOS 27 上访问部分系统目录，影响 iOS 26.7.1、27.0.1 和 27.2。","文章披露了 iOS 沙箱逃逸 PoC 的实现前提、文件访问范围和可安装应用，适合开发者理解风险边界与复现条件。",{"_49":73},"2026-11-10T15:46:20.000Z","2026-11-10T16:52:24.944Z",[195,196,194,218,219,220],82,"移动端","Apple","阿里","ayvzjhws6tdc6je8wptnrjsqgv","2026-11-10T14:47:20.754Z",{"_157":224,"_32":225,"_160":226,"_162":227,"_164":228,"_166":229,"_168":222,"_14":230,"_170":231,"_172":232,"_174":175,"_12":176,"_177":-5},"yvzjhws6tdc6je8wptnrjsqgv","Check Point Research 追踪 CopperDragon 关联 Sparrow 框架的三个攻击集群","Check Point Research 经一年调查识别出 SilentDelivery、OceanGate 和 DarkWire 三个关联 Sparrow 框架的攻击集群。","报告以共享代码与基础设施串联三个活动集群，并披露跨平台后端、凭据窃取与隐蔽通信细节，便于拆分此前混归 FamousSparrow 的入侵活动。",{"_49":241},"2026-11-10T14:01:14.000Z","activity",[233,234,235,236,237,238,239,240],76,"攻击活动","恶意软件","后门","钓鱼","数据窃取","凭据","Check Point","ESET","Check Point Research","aegqz101jkiafgwcvu120xf6su","2026-11-10T16:51:26.032Z",{"_157":245,"_32":246,"_160":247,"_162":248,"_164":249,"_166":250,"_168":243,"_14":251,"_170":252,"_172":253,"_174":175,"_12":176,"_177":-5},"egqz101jkiafgwcvu120xf6su","Google 扩大 Gemini 4 Carbon 开放范围并用于 Signal 协议安全验证","Google 扩大 Gemini 4 Carbon 的适用范围，付费开发者、企业和 Google AI Ultra 订阅者可经 Gemini API 与 Gemini for business 使用，Cyber 版本仍限 Fairwind Program 成员。","材料展示了 AI Agent 参与漏洞发现与形式化验证的实际流程，也明确限定了证明覆盖的代码和侧信道范围，为评估其工程价值提供了具体参照。",{"_49":57},"2026-11-10T16:42:02.000Z","ai-security",[254,255,256,194,257],73,"AI 安全","大模型","AI 攻防","Google","f958","2026-11-10T16:52:20.668Z",{"_157":261,"_32":262,"_160":263,"_162":264,"_164":265,"_166":266,"_168":259,"_14":169,"_170":267,"_172":268,"_174":175,"_12":176,"_177":-5},"aswmt9yct5lubk8xlutacsm1t","node-forge 修复 asn1.fromDer() 嵌套 BIT STRING 资源耗尽漏洞，CVSS 3.1 为 7.5","node-forge 的 asn1.fromDer() 存在资源耗尽漏洞，攻击者可提交小型 DER 或 PEM 结构，利用嵌套 BIT STRING 绕过 maxDepth 递归限制，消耗过多 CPU 和内存并导致 Node.js 进程拒绝服务。","公告给出可触发资源耗尽的嵌套 BIT STRING 结构、内存与处理时间数据，并说明限制绕过机制和版本修复方案，便于评估 DoS 风险与升级必要性。",{"_49":271},"2026-11-10T15:57:41.000Z",[178,179,196,269,270],72,"加密","Node.js","GitHub 安全公告","f966","2026-11-10T16:52:20.719Z",{"_157":275,"_32":276,"_160":277,"_162":278,"_164":279,"_166":280,"_168":273,"_14":191,"_170":281,"_172":193,"_174":175,"_12":176,"_177":-5},"dyhi8nn95b38npkt7si3jmlsy","AG2 SandboxShellTool 换行注入可绕过命令白名单与只读限制","AG2 的 SandboxShellTool 可因命令字符串中的换行符绕过 allowed=[...] 与 readonly=True 两种限制。过滤器会拒绝 ;、&&、| 等 shell 操作符，却未拦截 \\n 或 \\r，随后原始字符串被交给 sh -c 执行，使第二条命令也能运行；默认 LocalEnvironment() 后端下，这属于宿主进程命令执行，而非容器内隔离。","原文定位了 AG2 命令过滤与 shell 执行之间的机制差异，并用 PoC 展示了换行符如何绕过两类受限模式。",{"_49":271},"2026-11-10T15:57:17.000Z",[194,196,195,282,255,283],"Agent 安全","利用链","f968","2026-11-10T16:52:20.733Z",{"_157":287,"_32":288,"_160":289,"_162":290,"_164":291,"_166":292,"_168":285,"_14":169,"_170":293,"_172":294,"_174":175,"_12":176,"_177":-5},"r17ig0zhfspobluf32uqoseck","@nuxt/content 内容查询接口未授权 DoS 漏洞（3.15.2 之前版本受影响）","@nuxt/content 的 POST /__nuxt_content/:collection/query 接口默认无需认证，直接执行请求体中的 sql 字段，assertSafeQuery() 只拦截 SELECT 等六个关键字而不拦截 randomblob()、zeroblob()、hex()、length() 等 SQLite 内置函数。","原文给出可复现的 PoC 与量化结果，攻击请求 11.82 秒、基线 0.0088 秒、慢化 1339 倍，读者可直接判断自身部署是否需要升级。",{"_49":271},"2026-11-10T15:57:12.000Z",[178,196,180,194,295],74,"数据库","f976","2026-11-10T16:52:20.797Z",{"_157":299,"_32":300,"_160":301,"_162":302,"_164":303,"_166":304,"_168":297,"_14":191,"_170":305,"_172":306,"_174":175,"_12":176,"_177":-5},"t38yyi1raz8ik9fsh1ryv55gz","node-opcua 命名空间 RBAC 失败开放导致匿名写入与调用绕过","node-opcua 存在命名空间级 RBAC 失败开放漏洞，已声明的 DefaultRolePermissions 策略可能被运行时忽略，使 Anonymous 客户端获得 Read、Write、Call 权限；漏洞评分为 CVSS 9.8。","文章拆解了授权失败开放与配置路径断开的根因，并提供单元测试和 TCP 端到端 PoC，可用于验证匿名写入与高权限方法调用风险。",{"_49":271},"2026-11-10T15:56:52.000Z",[195,196,180,194,197,270],77,"f979","2026-11-10T16:57:19.835Z",{"_157":313,"_32":315,"_160":316,"_162":317,"_164":318,"_166":319,"_168":320,"_14":169,"_170":321,"_172":322,"_174":175,"_12":176,"_177":-5},{"_203":311,"_205":103,"_206":89,"_207":312},"ftzf92C6BFf0",[313,314],"x7edhu1rfhikbjr5w193xldog","fqc2v3qokzbepchzvrfi4k1j0","Vates VMS 披露 Xen Orchestra 认证绕过漏洞 VSA-2026-062 已被利用","Vates VMS 表示，Xen Orchestra 的认证绕过漏洞 VSA-2026-062 已在真实攻击中被利用，攻击者通过特制 Cookie 获取 Admin 权限，最终可在托管池上执行任意代码并以 root 接管 XCP-ng 节点。","文章披露了利用链、攻击基础设施和多项入侵指标，防守方可用这些信息排查并处置。",{"_49":50},"2026-11-10T18:12:21.000Z","2026-11-10T19:33:35.692Z",[323,180,179,195],85,"在野利用","f980","2026-11-10T16:57:19.842Z",{"_157":327,"_32":328,"_160":329,"_162":330,"_164":331,"_166":332,"_168":325,"_14":169,"_170":333,"_172":334,"_174":175,"_12":176,"_177":-5},"nvlwjzj3m3yzedvfp5u08pt0o","Apple iOS worse_query 沙箱逃逸漏洞或暴露加密钱包密钥，影响 26.7.1、27.0.1 和 27.2","Apple iOS 26.7.1、27.0.1 和 27.2 的 worse_query 漏洞可能允许恶意第三方应用越权读取其他应用的本地文件，危及加密货币助记词、私钥和登录凭据。","文章梳理了 iOS 沙箱逃逸技术的公开 PoC、受影响版本与现有更新，并提醒用户排查加密资产和登录凭据风险。",{"_49":60},"2026-11-10T15:59:19.000Z",[178,196,218,238,219],78,"ala28eurfu058o3k4rpz84fo7c","2026-11-10T19:33:35.667Z",{"_157":338,"_32":339,"_160":340,"_162":341,"_164":342,"_166":343,"_168":336,"_14":169,"_170":344,"_172":334,"_174":175,"_12":176,"_177":-5},"la28eurfu058o3k4rpz84fo7c","Git 修复 CVE-2026-111760，恶意仓库可在递归克隆时执行代码","Git 2.56.1 及 2.50.2、2.51.3、2.52.1、2.53.1、2.54.1、2.55.1 修复了 CVE-2026-111760，攻击者可借恶意仓库中的超长路径和子模块符号链接，在递归克隆时执行代码。","文章拆解了恶意仓库触发代码执行的路径，并列出各分支版本、配套修复及临时防护措施，便于评估递归克隆风险。",{"_49":50},"2026-11-10T19:23:10.000Z",[178,179,195,345,346,257,347],"供应链","Microsoft","CISA","f989","2026-11-10T19:33:35.684Z",{"_157":351,"_32":352,"_160":353,"_162":354,"_164":355,"_166":356,"_168":349,"_14":230,"_170":357,"_172":358,"_174":175,"_12":176,"_177":-5},"oclbliy8sva9iub474xdrfw3d","NEAR AI 遭 SGLang RCE 利用，18 个 Agent 与约 100 名用户数据被窃","攻击者利用开源推理引擎 SGLang 的远程代码执行漏洞，在 NEAR AI 推理服务器执行代码，并进入已弃用的 Private Chat 内部系统。公司确认约 100 名用户的邮箱、姓名及部分套餐和余额信息被下载，18 个旧版 NEAR AI Agents 的聊天记录、设置和日志遭窃，2 名客户的 NEAR AI Cloud API 密钥暴露。","事件同时暴露出 TEE 内软件漏洞与外层部署隔离不足，账号、Agent 数据及 API 密钥的处置记录可供云服务复盘。",{"_49":50},"2026-11-10T19:19:39.000Z",[233,323,180,254,255,359],80,"数据泄露","f990","2026-11-10T19:52:35.715Z",{"_157":363,"_32":364,"_160":365,"_162":366,"_164":367,"_166":368,"_168":361,"_14":230,"_170":369,"_172":193,"_174":175,"_12":176,"_177":-5},"s4a1b0u4lnpa4m73z1fp8t2oh","Recorded Future 发现 DoppelCart 欺诈网络扩展至约 261,700 个域名","Recorded Future 在 2026 年 3 月至 10 月间识别出约 261,700 个疑似属于 DoppelCart 欺诈网络的主域名，相关虚假商店通过仿冒美国品牌、商品图片和高达 65% 的折扣诱骗消费者提交个人及支付信息，部分还会截获银行签发的一次性验证码以授权交易。","材料展示了大规模假购物站网络的规模、基础设施特征与存活率，可为品牌方识别仿冒站点和消费者辨别欺诈网站提供参考。",{"_49":371},"2026-11-10T00:00:00.000Z",[233,370,237,238,181],"黑产","Recorded Future","aaj0vbs7gavvl6l5sken24qh21","2026-11-10T19:59:34.389Z",{"_157":375,"_32":376,"_160":377,"_162":378,"_164":379,"_166":380,"_168":373,"_14":169,"_170":381,"_172":253,"_174":175,"_12":176,"_177":-5},"aj0vbs7gavvl6l5sken24qh21","Microsoft 11 月补丁修复 1,235 个漏洞，含遭在野利用的 Outlook 漏洞","Microsoft 11 月 2026 年补丁修复 1,235 个漏洞，其中包含已遭在野利用的 Microsoft Outlook 欺骗漏洞 CVE-2026-124194。","文章不仅汇总补丁规模，还拆解了已遭利用的 Outlook 欺骗漏洞及其 NTLM 凭据窃取路径，便于识别实际暴露条件。",{"_49":60},"2026-11-10T19:07:36.000Z",[178,179,323,382,346,383],"汇总","浏览器","f1003","2026-11-10T21:00:34.625Z",{"_157":387,"_32":388,"_160":389,"_162":390,"_164":391,"_166":392,"_168":385,"_14":230,"_170":393,"_172":306,"_174":175,"_12":176,"_177":-5},"s8ur1jt60ywc3mv4s4fv20j7z","日本家具零售商 Nitori 称黑客可能窃取 37.62 million 条客户记录","日本家具及家居用品零售商 Nitori 表示，第三方未经授权访问其系统，最多 37.62 million 条个人信息可能被外部窃取。","Nitori披露了攻击持续时间、涉及的个人与订单数据类型及37.62 million条记录规模，并说明了账户凭据未暴露和已采取的处置措施，便于相关客户判断风险。",{"_49":60},"2026-11-10T20:54:55.000Z",[233,359,236,238],"f1019","2026-11-10T21:29:36.039Z",{"_157":397,"_32":398,"_160":399,"_162":400,"_164":401,"_166":402,"_168":395,"_14":169,"_170":403,"_172":173,"_174":175,"_12":176,"_177":-5},"jugiebheg5ptuxhjuq1jxk8da","Mongoose 原型继承属性写入漏洞分析与 PoC","Mongoose 的文档加载、点路径赋值和更新合并三条代码路径未校验自有属性，攻击者控制的属性名可覆盖原型链上的内置函数或 Mongoose 内部共享对象。其 PoC 表明，一次请求即可使后续查询抛出 TypeError 并持续拒绝服务至进程重启；使用 strict: false 的子文档时，还可移除所有文档共享的 required 校验器。","文章梳理了三条属性名注入路径，并用 PoC 展示进程级拒绝服务和共享 Schema 校验规则被修改的影响。",{"_49":271},"2026-11-10T20:56:16.000Z",[178,196,180,195],"f1023","2026-11-10T22:03:35.063Z",{"_157":407,"_32":408,"_160":409,"_162":410,"_164":411,"_166":412,"_168":405,"_14":169,"_170":413,"_172":414,"_174":175,"_12":176,"_177":-5},"nypzu48uooruzzhyeowlg5cl5","Active Storage 8.1 存在视频预览与图像处理任意文件读取及 RCE 风险","Active Storage 8.1, < 8.1.4.1 存在漏洞，攻击者可通过控制上传文件名和内容类型影响 ffprobe、ffmpeg 与 ImageMagick 选择的解码器，利用启用 AviSynth 的 FFmpeg 读取应用可访问文件或加载上传的本地库，可能导致 RCE。","文章梳理了上传文件名如何影响外部工具解码器选择，并给出受影响条件、升级版本、补丁与临时规避方法，便于维护者评估处置优先级。",{"_49":271},"2026-11-10T21:38:55.000Z",[178,179,180,195,255],75,"f1025","2026-11-10T22:03:35.078Z",{"_157":418,"_32":419,"_160":420,"_162":421,"_164":422,"_166":423,"_168":416,"_14":169,"_170":424,"_172":193,"_174":175,"_12":176,"_177":-5},"n12d2xr0theol7egqezcvggxt","Active Support safe_constantize 存在潜在 DoS 漏洞，影响 activesupport 8.1 且低于 8.1.4.1","ActiveSupport::Inflector#safe_constantize 会将未转义的常量名编译为正则表达式，可能触发 Ruby 正则表达式编译器缺陷并导致服务器进程崩溃，重复请求可造成应用不可用。","原文说明漏洞成因、默认配置下的未认证攻击路径、受影响版本与临时缓解措施，便于 Rails 应用评估暴露面和处置优先级。",{"_49":271},"2026-11-10T21:34:11.000Z",[178,179,196,345,181],"f1036","2026-11-10T22:56:35.304Z",{"_157":428,"_32":429,"_160":430,"_162":431,"_164":432,"_166":433,"_168":426,"_14":230,"_170":434,"_172":358,"_174":175,"_12":176,"_177":-5},"ls7fmpyylskxaymnr22grsi0u","Railway遭入侵，攻击者盗取凭据并产生约74万美元AI欺诈用量","Railway称，攻击者自10月20日起利用其构建基础设施中的未知漏洞逃逸文件系统隔离，再借助错误配置的信任关系获取解密客户环境变量所需的凭据，最多涉及约100,000个工作区。","Railway披露的攻击链、影响上限与处置状态较完整，可用于评估AI平台凭据暴露及多入口入侵风险。",{"_49":60},"2026-11-10T22:20:19.000Z",[233,359,323,435,255,238],"AI 供应链",{"_437":438,"_439":-5},"changelogVersion","2026-10-01T08:00","release"]
