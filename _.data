"_154":348,"_156":349,"_158":350,"_160":-5},{"_154":336,"_156":337,"_158":338,"_160":-5},{"_154":323,"_156":324,"_158":325,"_160":-5},{"_154":311,"_156":312,"_158":313,"_160":-5},{"_154":299,"_156":300,"_158":301,"_160":-5},{"_154":287,"_156":288,"_158":289,"_160":-5},{"_154":271,"_156":272,"_158":273,"_160":-5},{"_154":256,"_156":257,"_158":258,"_160":-5},{"_154":245,"_156":246,"_158":247,"_160":-5},{"_154":230,"_156":231,"_158":232,"_160":-5},{"_154":214,"_156":215,"_158":216,"_160":-5},{"_154":196,"_156":197,"_158":198,"_160":-5},{"_154":155,"_156":157,"_158":159,"_160":161},"key","f1067","anchorAt","2026-11-11T00:58:40.582Z","item",{"_168":65,"_32":169,"_170":171,"_172":173,"_174":175,"_176":177,"_178":179,"_14":180,"_181":182,"_183":184,"_185":186,"_12":187,"_188":-5},"group",{"_162":163,"_164":96,"_165":45,"_166":167},"factId","ftOvQMZZlsgU","additionalSourceCount","reportCount","memberIds",[65],"id","Microsoft 研究证明 AI Agent 可通过编辑少于 10 个神经元植入后门","summary","Microsoft 研究人员提出 Lazarus，可在无需重新训练模型的情况下，通过编辑少于 10 个很少激活的神经元植入隐藏后门；攻击者需能修改模型权重，触发词出现时，模型会输出并供 Agent 执行攻击者命令。","reason","研究展示了少量神经元编辑即可植入模型后门，并给出成功率、误报数据与部署侧防护建议。","source",{"_49":57},"publishedAt","2026-11-11T07:21:05.000Z","timelineAt","2026-11-11T09:08:36.016Z","ai-security","tags",[189,190,191,192,193,194,195],"score",72,"selected",true,"news","x","AI 安全","模型安全","Agent 安全","后门","AI 供应链","技术研究","Microsoft","f1069","2026-11-11T05:49:35.165Z",{"_168":199,"_32":200,"_170":201,"_172":202,"_174":203,"_176":204,"_178":197,"_14":205,"_181":206,"_183":207,"_185":186,"_12":187,"_188":-5},"xo3px77vo84m1faxu5nie5ooc","DarkSword、Coruna 利用广告和失陷网站攻击 iPhone 员工","iVerify 的 2026 年移动威胁报告称，攻击者利用泄露的 DarkSword 和 Coruna exploit kit，通过 Instagram 广告、金融与加密货币仿冒网站感染使用 iPhone 工作的员工。","材料还原了 DarkSword、Coruna 与 DeadTag 的投放链和凭据窃取路径，并给出访问量与感染监测数据，便于理解移动端入侵如何延伸至企业账号。",{"_49":70},"2026-11-11T05:00:34.000Z","activity",[208,209,210,211,212,213],73,"攻击活动","恶意软件","移动端","凭据","数据窃取","Apple","aqc1r9iuw591mbmk8pfatc2xbl","2026-11-11T06:03:35.679Z",{"_168":217,"_32":218,"_170":219,"_172":220,"_174":221,"_176":222,"_178":215,"_14":205,"_181":223,"_183":224,"_185":186,"_12":187,"_188":-5},"qc1r9iuw591mbmk8pfatc2xbl","十余家 AI 开发者平台遭同一类攻击，Chainstack 与 WorkOS 披露凭据泄露","9 月底至 11 月初，至少十几家 AI 开发者平台遭攻击，攻击者绕过核心业务系统与第三方组件，窃取 AI 访问令牌、数据库凭据及客户信息。","文章串联多家平台的独立公告，呈现针对 AI 中间层的凭据窃取链路，并指出合法 AI 工具正在自动化压缩攻击试错成本。",{"_49":229},"2026-11-10T08:52:00.000Z",[208,225,211,226,227,228],78,"数据泄露","AI 攻防","供应链","红队","安全客","az6sqacicgu5g5kxg4eavs0p1z","2026-11-11T09:06:41.079Z",{"_168":233,"_32":234,"_170":235,"_172":236,"_174":237,"_176":238,"_178":231,"_14":205,"_181":239,"_183":240,"_185":186,"_12":187,"_188":-5},"z6sqacicgu5g5kxg4eavs0p1z","攻击者利用 Openwave CVE-2026-111793 与 Cisco BroadWorks CVE-2026-20320","攻击者已利用 Openwave Webtop Media Transcoder 的 CVE-2026-111793 和 Cisco BroadWorks 的 CVE-2026-20320 窃取敏感信息。","两起已获利用的漏洞涉及文档转换绕过与 XML 外部实体注入，攻击范围、补丁版本和处置期限均已明确。",{"_49":88},"2026-11-11T09:01:07.000Z",[208,241,242,212,211,226,243,244],83,"在野利用","漏洞利用","Cisco","CISA","f1077","2026-11-11T09:06:44.220Z",{"_168":248,"_32":249,"_170":250,"_172":251,"_174":252,"_176":253,"_178":246,"_14":205,"_181":254,"_183":255,"_185":186,"_12":187,"_188":-5},"v31fconsep72j9z4e4u5rvvw4","CSC Telecom 欧洲电信数据泄露暴露 Swedbank、SEB、airBaltic 等机构客户端信息","CSC Telecom 发生大规模数据泄露，暴露了125 million text messages，受影响对象包括 Swedbank、SEB、应急服务机构、airBaltic 以及数十家零售商。现有材料仅说明泄露内容和规模，未提供泄露原因、暴露数据字段或处置进展。","材料指出泄露规模达到125 million text messages，并列出多家金融、航空及应急服务机构的客户端，可用于评估自身通信数据是否暴露在类似事件中。",{"_49":108},"2026-11-11T09:00:02.000Z",[208,225],70,"aw4i7n11q7jgyy4p2xh92mfdcb","2026-11-11T10:08:41.289Z",{"_168":259,"_32":260,"_170":261,"_172":262,"_174":263,"_176":264,"_178":257,"_14":265,"_181":266,"_183":267,"_185":186,"_12":187,"_188":-5},"w4i7n11q7jgyy4p2xh92mfdcb","Microsoft 11月补丁修复1,090个漏洞，CVE-2026-124194已遭利用","Microsoft 11月补丁共修复约1,090个漏洞，其中CVE-2026-124194已遭利用；该Outlook欺骗漏洞需用户打开特制消息文件，可泄露NTLMv2哈希并用于冒充用户。","原文汇总Microsoft补丁中的已利用漏洞、零点击RCE与30个潜在蠕虫漏洞，并指出部分公告细节不足。",{"_49":91},"2026-11-11T09:03:48.000Z","vuln",[268,241,269,195,270],82,"补丁","漏洞分析","邮件安全","f1081","2026-11-11T10:08:41.396Z",{"_168":274,"_32":275,"_170":276,"_172":277,"_174":278,"_176":279,"_178":272,"_14":280,"_181":281,"_183":267,"_185":186,"_12":187,"_188":-5},"rxh92nsgv8wymaapqss20aa6c","OpenSSH/musl 口令认证绕过漏洞分析与修复版本对比","文章分析 OpenSSH portable 在 musl libc 且未启用 PAM 时的口令认证绕过，解释同一 TCP 连接内先失败一次后，257–1024 字节口令可绕过影子值为 * 的非 root 账户认证。","通过源码逐行比对与隔离容器实测，文章补全了二次尝试的真正成因，并给出受影响窗口、修复差异和版本判定方法。",{"_49":286},"2026-11-10T02:16:08.000Z","disclosure",[269,282,194,283,284,285],"复现","身份与访问","加密","加固","先知社区","ae1akisn9puw2q428mdfemr4p2","2026-11-11T10:08:41.411Z",{"_168":290,"_32":291,"_170":292,"_172":293,"_174":294,"_176":295,"_178":288,"_14":180,"_181":296,"_183":297,"_185":186,"_12":187,"_188":-5},"e1akisn9puw2q428mdfemr4p2","Claude Code、OpenClaw 与 OpenShell 路径检查后越界写入及同步投毒分析","Claude Code、OpenClaw 与 OpenShell 的文件操作均存在检查对象与实际读写对象不一致的问题。Claude Code 的 CVE-2026-103435 影响 < 2.1.129，并在 2.1.129 修复；OpenClaw v2026.2.26 可在拒绝前通过 O_TRUNC 截断或 O_CREAT 创建越界文件，v2026.3.1 将破坏性操作延后。","文章通过源码追踪和对照实验揭示了检查后目录项替换导致越界截断、创建及同步投毒的共同边界问题。",{"_49":286},"2026-11-09T12:30:29.000Z",[189,191,194,282,269,285,298,213],75,"Google","f1089","2026-11-11T11:44:39.559Z",{"_168":302,"_32":303,"_170":304,"_172":305,"_174":306,"_176":307,"_178":300,"_14":205,"_181":308,"_183":240,"_185":186,"_12":187,"_188":-5},"k9g0gy54e8kqkx59naz5nvc5r","朝鲜黑客组织被指窃取 64.3 亿美元并用 meme 币洗钱","朝鲜黑客组织 TraderTraitor 被指于 2026 年 10 月 29 日从币*在 11 条区块链上的钱包抽走约 64.3 亿美元，其后通过拆分、跨链、资产互换、借贷金库、coinjoin 和 Privacy Cash 洗钱。","文章通过链上交易还原朝鲜黑客组织的入侵与洗钱路径，并拆解自制 meme 币如何拖延追踪。",{"_49":87},"2026-11-10T16:44:39.507Z",[208,309,225,310,284,244],"黑产","AI 编码","ahpoyhcyj8jyqis5mhai6eg4rx","2026-11-11T13:00:36.651Z",{"_168":314,"_32":315,"_170":316,"_172":317,"_174":318,"_176":319,"_178":312,"_14":205,"_181":320,"_183":224,"_185":186,"_12":187,"_188":-5},"hpoyhcyj8jyqis5mhai6eg4rx","eMudhra 因密钥处理缺陷撤销 8 个额外 CA，涉及 195 张证书","eMudhra 因内部 Python 脚本缺陷及密钥处理不合规，撤销此前称未受影响的 8 个中间 CA，其中 6 个签发 TLS 证书、2 个签发代码签名证书，涉及 195 张证书及 29 个自有域名证书。","事件披露了密钥生成、迁移与重建环节如何同时削弱密钥强度并削弱 HSM 保护，为证书机构复盘密钥生命周期和流程控制提供具体案例。",{"_49":57},"2026-11-11T12:00:53.000Z",[208,211,284,321,195,322,298,213],"浏览器","Mozilla","f1106","2026-11-11T13:26:35.605Z",{"_168":326,"_32":327,"_170":328,"_172":329,"_174":330,"_176":331,"_178":324,"_14":265,"_181":332,"_183":333,"_185":186,"_12":187,"_188":-5},"mms1km0rggfxsxggiojfrk76b","N-able 为 N-central 多个漏洞发布 N-central 2026.4 HF2 热修复","N-able 为 N-central 远程监控与管理平台多个漏洞发布 N-central 2026.4 HF2，涉及 CVE-2026-125883、CVE-2026-125878、CVE-2026-125879、CVE-2026-125880、CVE-2026-125881、CVE-2026-125882 和 CVE-2026-91000。","原文同时列出受影响版本、多个零日漏洞编号、PoC 利用链及扫描活动，便于判断暴露范围并安排升级。",{"_49":50},"2026-11-11T12:32:27.000Z",[334,268,282,242,241,335],81,"漏洞","利用链","f1108","2026-11-11T13:58:37.184Z",{"_168":339,"_32":340,"_170":341,"_172":342,"_174":343,"_176":344,"_178":337,"_14":280,"_181":345,"_183":333,"_185":186,"_12":187,"_188":-5},"dtwa818ng8oa0lmiwfqo5kf3w","Grok Build 生成应用暴露风险分析：35,578 个应用无需登录即可访问","安全公司 Claroc 发现 37,571 个由 Grok Build 生成并发布的应用中，35,578 个无需登录即可访问，约 1/10 包含内部业务或个人数据。","文章给出公开暴露规模、涉及组织类型与两种测试应用的具体访问控制缺陷，便于安全团队核查自建应用的暴露风险。",{"_49":57},"2026-11-11T12:19:40.000Z",[194,189,346,191,225,283,298,347],"大模型","阿里","f1112","2026-11-11T14:56:37.532Z",{"_168":351,"_32":352,"_170":353,"_172":354,"_174":355,"_176":356,"_178":349,"_14":205,"_181":357,"_183":297,"_185":186,"_12":187,"_188":-5},"fn77p5pyn1ovua4jxfzp2n5v1","攻击者针对 Qlik Sense 服务器投递 PowerShell 反向 Shell，并准备利用 ActiveMQ 与 Veeam 漏洞","Cynet 于 2026 年 10 月在多个欧洲客户环境中发现针对 Qlik Sense 服务器的 PowerShell 反向 Shell 尝试，命令通过 scheduler.exe 执行并连接 45.115.26[.]23:4455，相关操作还为后续攻击作准备。","材料还原了针对 Qlik Sense 的反向 Shell 尝试、持久化手段和后续漏洞利用准备，便于防守人员识别相关基础设施与行为链。",{"_49":57},"2026-11-11T14:01:00.000Z",[208,241,192,212],"f1115","2026-11-11T15:22:36.014Z",{"_168":364,"_32":365,"_170":366,"_172":367,"_174":368,"_176":369,"_178":359,"_14":205,"_181":370,"_183":371,"_185":186,"_12":187,"_188":-5},{"_162":362,"_164":113,"_165":96,"_166":363},"fTcU_gkFotDA",[364],"w59rywovcc1gwb1eoreru2xl3","攻击者利用 AntiFox AI Agent 窃取 AWS 凭据并入侵 Web 服务","攻击者在 Alibaba Cloud 上托管自建 AntiFox 实例，利用有效 IAM 用户和 EC2 角色针对 AWS 环境及互联网暴露的 Web 服务实施漏洞利用、Webshell 部署、凭据验证、配置发现与 AWS secret 收集。","该事件展示了攻击者如何把自主渗透测试 Agent 改造为凭据窃取工具，可为评估云环境中的 AI 辅助攻击提供具体案例。",{"_49":50},"2026-11-11T15:12:59.000Z",[208,226,209,211,372,347],77,"AWS","aq5pk9i6wqjatjvkhjx8a5f75o","2026-11-11T18:16:07.568Z",{"_168":376,"_32":377,"_170":378,"_172":379,"_174":380,"_176":381,"_178":374,"_14":265,"_181":382,"_183":383,"_185":186,"_12":187,"_188":-5},"q5pk9i6wqjatjvkhjx8a5f75o","N-able 修复 N-central 7 个 CVE，33 个 Able2Shell 漏洞 PoC 已公开","N-able 为 N-central 发布 2026.4 Hotfix 2（build 2026.4.1.26），修复 CVE-2026-125883、CVE-2026-125878、CVE-2026-125879、CVE-2026-125880、CVE-2026-125881、CVE-2026-125882 和 CVE-2026-91000。","原文披露了33个疑似零日漏洞、4条利用链及公开PoC，还记录了扫描与利用尝试，可用于评估暴露窗口和处置优先级。",{"_49":126},"2026-11-11T17:15:00.000Z",[268,282,242,241,269],86,"ar2546h3tkbdqveqaoamsqyjys","2026-11-11T19:16:12.977Z",{"_168":387,"_32":388,"_170":389,"_172":390,"_174":391,"_176":392,"_178":385,"_14":180,"_181":393,"_183":394,"_185":186,"_12":187,"_188":-5},"r2546h3tkbdqveqaoamsqyjys","Microsoft FORGE Lab 复盘 AI 扫描发现 59 个 Linux 内核漏洞","Microsoft FORGE Lab 使用代号 MDASH 的 AI 扫描系统研究 Linux 内核，3 个月产出 59 个公开上游报告和 33 个已分配 CVE，其中 8 个 CVE 已验证本地提权利用，38 个报告的修复已合并主线。","文章完整呈现了 AI 扫描结果如何经过筛选、PoC 验证、人工复核和上游协作转化为漏洞报告与补丁，为评估 AI 辅助漏洞发现的实际效率提供了可复用的流程样本。",{"_49":73},"2026-11-11T16:55:00.000Z",[189,226,346,269,395,194,195],74,"内核","f1124","2026-11-11T20:17:11.646Z",{"_168":399,"_32":400,"_170":401,"_172":402,"_174":403,"_176":404,"_178":397,"_14":205,"_181":405,"_183":224,"_185":186,"_12":187,"_188":-5},"yc1sadq0avsw7w3h0asnbm6v0","Unit 42 披露 Falcon 浏览器 C2 框架攻击 5 国政府机构","Unit 42 发现攻击者利用 Falcon 浏览器 C2 框架入侵至少 5 个国家政府机构的 webmail、政府应用与内部系统，窃取密码、邮件、会话 cookie、通讯和内部文档。","文章拆解了浏览器内 C2、扩展侧载与 Antino 投递链路，并给出 IOC 和异常活动线索，便于识别高度隐蔽的定向入侵。",{"_49":407},"2026-11-11T15:00:23.000Z",[208,209,192,212,321,406],"逆向","Unit 42","f1127","2026-11-11T21:18:13.917Z",{"_168":411,"_32":412,"_170":413,"_172":414,"_174":415,"_176":416,"_178":409,"_14":205,"_181":417,"_183":418,"_185":186,"_12":187,"_188":-5},"k1s00o45axh6n2j0laqjuuly7","Microsoft 披露攻击者利用 GSocket 在 Linux 服务器维持隐蔽 C2","Microsoft 观察到多个攻击活动将开源远程访问工具 GSocket 部署到遭入侵的 Linux 服务器，在初始 RCE 漏洞修复后仍通过 Global Socket Relay Network 维持访问。","文章结合遥测数据还原 GSocket 的部署、持久化与提权链路，并给出适合 Linux 主机排查和加固的处置方向。",{"_49":73},"2026-11-11T19:49:57.000Z",[208,209,192,419,420,195],80,"网络设备","检测工程","f1131","2026-11-11T23:09:21.072Z",{"_168":424,"_32":425,"_170":426,"_172":427,"_174":428,"_176":429,"_178":422,"_14":205,"_181":430,"_183":240,"_185":186,"_12":187,"_188":-5},"ihb325l23pcss0skikvuxyfi2","ConnectWise 调查针对 MSP 的 ScreenConnect 恶意软件活动，47 家组织受影响","ConnectWise 正在调查一场针对托管服务提供商（MSP）的活跃恶意软件活动，攻击者利用遭入侵的 ScreenConnect 环境，通过 Run Command 功能向客户设备部署非法远程客户端。","材料追踪了攻击规模、受感染 MSP 与端点数量，并列出 IOC 与处置步骤，可用于核对 ScreenConnect 环境是否遭到入侵。",{"_49":50},"2026-11-11T22:56:21.000Z",[208,209,192,212,227,195],"aiwwjul6qnyiu2hvmqtlcddzue","2026-11-11T23:19:25.971Z",{"_168":434,"_32":435,"_170":436,"_172":437,"_174":438,"_176":439,"_178":432,"_14":205,"_181":440,"_183":297,"_185":186,"_12":187,"_188":-5},"iwwjul6qnyiu2hvmqtlcddzue","Unit 42 披露 ARTEX 针对全球零售与咨询云环境的多起入侵活动","Unit 42 已观察攻击者利用 ARTEX 和 CyberStrikeAI 自主执行入侵，ARTEX 被用于攻击多个目标及零售、咨询等行业的客户云环境。截至 2026 年 10 月，研究团队发现 609 台互联网暴露主机运行 ARTEX、1,323 台运行 CyberStrikeAI，另有 21 台同时运行两者。","文章结合多起入侵调查与外部主机统计，揭示 ARTEX 被用于并行、持续攻击公开暴露资产的具体操作特征。",{"_49":407},"2026-11-11T23:00:53.000Z",[208,226,191,346,441,442],"云原生","Palo Alto",{"_444":445,"_446":-5},"changelogVersion","2026-10-01T08:00","release"]
