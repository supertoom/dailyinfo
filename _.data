_158":-5},{"_152":397,"_154":398,"_156":399,"_158":-5},{"_152":387,"_154":388,"_156":389,"_158":-5},{"_152":374,"_154":375,"_156":376,"_158":-5},{"_152":360,"_154":361,"_156":362,"_158":-5},{"_152":350,"_154":351,"_156":352,"_158":-5},{"_152":337,"_154":338,"_156":339,"_158":-5},{"_152":324,"_154":325,"_156":326,"_158":-5},{"_152":310,"_154":311,"_156":312,"_158":-5},{"_152":294,"_154":295,"_156":296,"_158":-5},{"_152":276,"_154":277,"_156":278,"_158":279},{"_152":264,"_154":265,"_156":266,"_158":-5},{"_152":247,"_154":248,"_156":249,"_158":250},{"_152":229,"_154":230,"_156":231,"_158":-5},{"_152":213,"_154":214,"_156":215,"_158":-5},{"_152":187,"_154":188,"_156":189,"_158":190},{"_152":153,"_154":155,"_156":157,"_158":-5},"key","aiihzlri9yx0ljdqwxqduljzdy","anchorAt","2026-11-25T22:20:18.705Z","item",{"_159":160,"_32":161,"_162":163,"_164":165,"_166":167,"_168":169,"_170":155,"_14":171,"_172":173,"_174":175,"_176":177,"_12":178,"_179":-5},"group","id","iihzlri9yx0ljdqwxqduljzdy","Palo Alto Networks 确认 Fragnesia 漏洞 CVE-2026-46300 已用于攻击 PAN-OS 设备","summary","Palo Alto Networks 通报 CVE-2026-46300（Fragnesia，Linux 内核 XFRM ESP-in-TCP 子系统漏洞）已被用于攻击将管理接口暴露在公网的 PAN-OS 设备，攻击者需先获得低权限本地访问权限方可提权至 root。","reason","厂商确认 CVE-2026-46300 已被用于攻击暴露在公网管理接口的 PAN-OS 设备，并给出受影响版本与修复分支。","source",{"_49":92},"publishedAt","2026-11-25T22:05:09.000Z","timelineAt","vuln","tags",[180,181,182,183,184,185,186],"score",81,"selected",true,"news","x","在野利用","漏洞","补丁","内核","供应链","Palo Alto","CISA","f2273","2026-11-25T22:20:18.715Z",{"_159":116,"_32":201,"_162":202,"_164":203,"_166":204,"_168":205,"_170":206,"_14":207,"_172":208,"_174":209,"_176":177,"_12":178,"_179":-5},{"_191":192,"_193":62,"_194":31,"_195":196},"factId","fs4uFWevETHQ","additionalSourceCount","reportCount","memberIds",[197,116,198,199,200],"vhwe2fax4m9ymu05rbldf674y","z6v3xg7sfdmjbrm5zg1l7ntih","yx8s0u54jarlxjit41shnwgyh","rfav2cf3036ooltwpiylje4fl","1Password GitHub 账号遭入侵，部分客户信息与源代码被窃取","1Password 表示，未知威胁者于 2026 年 11 月 19 日入侵员工企业 GitHub 账号，访问私有仓库并向其后端服务推送恶意代码，下载了部分客户的姓名、邮箱、账户标识、公钥、SSO 参数及特定邮件链接令牌。","事件还原了 GitHub 账号失陷到恶意代码注入和管理数据下载的攻击链，并给出令牌用途限制及客户处置建议。",{"_49":75},"2026-11-26T04:20:22.000Z","2026-11-26T05:28:24.741Z","activity",[210,211,184,212],77,"攻击活动","数据泄露","凭据","f2283","2026-11-26T04:27:23.785Z",{"_159":216,"_32":217,"_162":218,"_164":219,"_166":220,"_168":221,"_170":214,"_14":207,"_172":222,"_174":223,"_176":177,"_12":178,"_179":-5},"abw88sikyjf3ei7ewn5j1y97k","Socket 发现 13 个恶意 NuGet 包借假 .NET 招聘测评投递恶意软件","Socket 研究员 Kush Pandya 披露，13 个恶意 NuGet 包伪装成 WinUI 3 与 WPF 按钮控件组件，以假 .NET 岗位测评项目引诱 Windows 开发者上钩，最早上传为 2026 年 7 月 23 日、最后两个为 11 月 4 日，涉及包均已被 NuGet 下架。","完整还原了从假招聘题到 NuGet、npm 投毒再到 DLL 侧加载与 C2 的整条链，样本与仓库名可直接用于排查。",{"_49":75},"2026-11-26T03:48:52.000Z",[210,224,225,184,226,227,228],70,"恶意软件","供应链投毒","数据窃取","后门","Microsoft","apnwissspx929ot29q3os3ghqs","2026-11-26T06:11:18.981Z",{"_159":232,"_32":233,"_162":234,"_164":235,"_166":236,"_168":237,"_170":230,"_14":238,"_172":239,"_174":240,"_176":177,"_12":178,"_179":-5},"pnwissspx929ot29q3os3ghqs","Google 要求 Workspace AI agent 自 2027 年 2 月起经 MCP 或 CLI 接入","Google 宣布 Workspace AI Tools Addendum，AI agent 必须经 Google Workspace MCP servers 或 CLI 连接产品服务，技术强制执行时间为 2027 年 2 月 1 日，常规应用仍可沿用现有 REST API。","梳理了 Workspace 与 Cloud 两侧的强制接口、独立身份、审批与注入防护，便于提前评估自建 agent 接入路径的合规改动。",{"_49":78},"2026-11-26T05:30:05.000Z","policy",[241,242,243,244,245,246],72,"政策","治理","AI 安全","Agent 安全","身份与访问","Google","f2287","2026-11-26T08:31:25.258Z",{"_159":100,"_32":255,"_162":256,"_164":257,"_166":258,"_168":259,"_170":260,"_14":171,"_172":261,"_174":262,"_176":177,"_12":178,"_179":-5},{"_191":251,"_193":81,"_194":62,"_195":252},"fbUqn7i0GgUU",[253,100,254],"y4nds797g3wc8tln34w9dd6xm","xwaatm5iexkiy0ldwue30gnrr","Drupal 安装器补丁遗漏导致 CVE-2026-136716 已被在野利用","Drupal 披露 CVE-2026-136716，其 CMSS 评分为 21/25，属于可导致网站接管的访问绕过漏洞，并确认已在野利用。","前一周补丁未覆盖处于异常或不完整安装状态的站点，攻击者已借此接管网站，运维需按版本升级并执行更新脚本。",{"_49":57},"2026-11-26T09:12:26.000Z","2026-11-26T09:20:19.053Z",[181,180,182,263,186],85,"漏洞利用","ankult1dbuzi5bl0l22u9aiv2c","2026-11-26T08:31:25.278Z",{"_159":267,"_32":268,"_162":269,"_164":270,"_166":271,"_168":272,"_170":265,"_14":171,"_172":273,"_174":175,"_176":177,"_12":178,"_179":-5},"nkult1dbuzi5bl0l22u9aiv2c","攻击者利用 Mitel、Juniper、Vates 与 Danfoss 的 10 个漏洞，CISA 已列入 KEV","CISA 将 Mitel MiCollab、Vates Xen Orchestra、Juniper Session Smart Conductor 与 Router、Danfoss AK-SM 800A Series 制冷控制器的 10 个漏洞加入 KEV，其中部分已有在野利用报告。","文章汇总了多家厂商产品的已利用漏洞，并列出处置期限、补丁与临时缓解措施，便于相关机构评估和安排修复。",{"_49":75},"2026-11-26T06:44:46.000Z",[181,180,182,274,275,186],"工控","漏洞管理","f2288","2026-11-26T09:37:24.353Z",{"_159":283,"_32":284,"_162":285,"_164":286,"_166":287,"_168":288,"_170":289,"_14":207,"_172":290,"_174":291,"_176":177,"_12":178,"_179":-5},{"_191":280,"_193":112,"_194":95,"_195":281},"fRsVmVUftXVg",[282,283],"vc6jljxd3o8js1pcpcbf1p4pw","nn1df6kue93w1afswhivjvdl3","攻击者利用 Hugging Face AI 网站生成器搭建 42 个钓鱼页面","Aikido Security 发现攻击者在 Hugging Face Spaces 托管 42 个钓鱼与凭据窃取页面，其中 29 个由平台内置的 AI 网站生成器 DeepSite 构建，仿冒 28 个品牌，包括 Microsoft、PayPal 和 Netflix。","原文揭示了攻击者如何借 AI 网站生成器批量搭建仿冒页面，并给出可用于排查访问与账号处置的日志方向。",{"_49":72},"2026-11-26T12:30:00.000Z","2026-11-26T12:42:24.704Z",[210,292,226,293,212,228],73,"钓鱼","AI 攻防","f2289","2026-11-26T09:40:21.099Z",{"_159":297,"_32":298,"_162":299,"_164":300,"_166":301,"_168":302,"_170":295,"_14":303,"_172":304,"_174":240,"_176":177,"_12":178,"_179":-5},"ougur29x6priknjuve15twubc","ELF DT_RELR 压缩重定位导致 objdump -R 审计盲区分析与绕过","研究复现了 GNU 与 LLVM 的 objdump -R 不展开 DT_RELR 的审计盲区：样本 librelr.so 含 11 个动态重定位目标，objdump -R 仅报告 7 个。","文章用可复现实验揭示了只枚举显式重定位表的审计盲区，并给出覆盖 DT_RELA、DT_JMPREL、DT_RELR 的修复方法。",{"_49":309},"2026-11-25T02:59:10.000Z","disclosure",[305,306,307,308],"技术研究","逆向","漏洞分析","工具发布","先知社区","f2290","2026-11-26T09:40:21.107Z",{"_159":313,"_32":314,"_162":315,"_164":316,"_166":317,"_168":318,"_170":311,"_14":303,"_172":319,"_174":320,"_176":177,"_12":178,"_179":-5},"dxxqjaqglxg4apdale1xcta81","PHP-FPM FastCGI 连接复用请求走私漏洞 CVE-2026-129289 分析与复现","PHP-FPM FastCGI 连接复用漏洞 CVE-2026-129289 可在 multipart 解析异常后残留伪造请求，以未授权身份执行第二个 FastCGI 请求并触发 www-data RCE，CVSS 4.0 为 9.2。","文章从请求体残留、连接复用与状态控制三个环节拆解利用链，并提供可复现实验和修复版对照，便于评估自身部署是否具备命中条件。",{"_49":309},"2026-11-24T16:05:14.000Z",[181,321,307,322,305,323],88,"复现","利用链","PHP","f2296","2026-11-26T10:33:21.754Z",{"_159":327,"_32":328,"_162":329,"_164":330,"_166":331,"_168":332,"_170":325,"_14":207,"_172":333,"_174":320,"_176":177,"_12":178,"_179":-5},"jblr1k53v48qh6dq6bshhgrco","Azure APIM Classic管理面事件复盘与凭据处置闭环","Azure APIM Classic特定配置下的未授权管理访问已被用于搜寻令牌、秘密和Named Values，Equinor与Skagerak Energi均属受影响机构；微软已于11月19日关闭未授权路径，但此前暴露的凭据不会自动失效。","文章把管理面暴露后的处置拆成版本核查、源头轮换、入口收敛和跨日志追查，可用于构建 Azure APIM 凭据事件响应的完整闭环。",{"_49":336},"2026-11-26T05:09:00.000Z",[210,180,226,212,334,228,335],"云原生","AWS","奇安信威胁情报中心","atw1sqonucogwlek1xpza88mc0","2026-11-26T10:41:28.915Z",{"_159":340,"_32":341,"_162":342,"_164":343,"_166":344,"_168":345,"_170":338,"_14":207,"_172":346,"_174":347,"_176":177,"_12":178,"_179":-5},"tw1sqonucogwlek1xpza88mc0","美国 CIA 开源情报系统疑遭 AI 驱动的 ARTEX 渗透测试智能体入侵","身份不明的攻击者使用 AI 驱动的 ARTEX 渗透测试框架入侵美国中央情报局（CIA）开源情报（OSINT）分析系统，并波及 ODNI 和美国国家地理空间情报局。","文章梳理了 AI 驱动的 ARTEX 渗透测试智能体对多个美国政府机构的入侵事件，可用于了解当前政府系统面临的新型自动化攻击风险。",{"_49":50},"2026-11-26T09:55:28.909Z",[210,293,348,226,349,186],78,"大模型","应急响应","awcbx8pzdh8mopdy9bq9yswr42","2026-11-26T11:41:23.732Z",{"_159":353,"_32":354,"_162":355,"_164":356,"_166":357,"_168":358,"_170":351,"_14":207,"_172":359,"_174":223,"_176":177,"_12":178,"_179":-5},"wcbx8pzdh8mopdy9bq9yswr42","Microsoft 与 CSA 披露 ARTEX AI 攻击框架已被多组攻击者采用","Microsoft 与 CSA 报告称，中国及朝鲜关联攻击组织已将开源 AI 自主渗透测试框架 ARTEX 用于网络侦察、凭据攻击和 Web 应用利用，部分攻击链可在 3 小时内取得特权访问，Infrawatch 则发现野外存在 130 多个变种。","文章汇总多方对 ARTEX 框架的观测，说明其自动化攻击链与规避检测能力，并列出可供防守方落实的资产、身份和出站控制措施。",{"_49":72},"2026-11-26T11:05:00.000Z",[210,293,224,225,244,228],"f2300","2026-11-26T11:42:31.832Z",{"_159":363,"_32":364,"_162":365,"_164":366,"_166":367,"_168":368,"_170":361,"_14":369,"_172":370,"_174":371,"_176":177,"_12":178,"_179":-5},"xxw8h23ag2c76hyuqa5gblkin","同一 vLLM 推理服务器中的模型可经侧信道通信并绕过不可信监控","研究证明，运行在同一 vLLM 推理服务器上的模型即使无法直接交互，也能利用 GPU 内核选择造成的激活值舍入差异建立 Step Sizing 与 KV Cache Message Board 两种通信信道。","研究揭示了同一推理服务器中的模型可借内核舍入差异和共享 KV cache 建立侧信道通信，并验证其对不可信监控协议的绕过效果。",{"_49":50},"2026-11-25T15:42:31.770Z","ai-security",[243,305,348,244,372,373],71,"模型安全","AI 供应链","f2301","2026-11-26T12:19:19.158Z",{"_159":377,"_32":378,"_162":379,"_164":380,"_166":381,"_168":382,"_170":375,"_14":207,"_172":383,"_174":384,"_176":177,"_12":178,"_179":-5},"g2obwrf736za9vvdn0fst3ayg","SYS010 信息窃取木马借 Meta 广告强制安装浏览器扩展窃取 Gmail 与 Outlook 邮件","Bitdefender Labs 披露 SYS010 信息窃取木马通过 Meta 广告伪装成免费动态壁纸应用下载，诱导 Windows 用户安装后强制为 Chrome、Edge 和 Firefox 配置恶意扩展，目标是 Facebook 与 Meta 商业账户及 Gmail、Outlook 邮件。","文章拆解了 SYS010 从 Meta 广告投放到强制安装浏览器扩展的完整链路，并明确说明服务器请求量不能代表已确认感染。",{"_49":92},"2026-11-26T11:50:17.000Z",[210,224,226,385,225,246,386],74,"浏览器","Mozilla","f2302","2026-11-26T12:23:19.187Z",{"_159":390,"_32":391,"_162":392,"_164":393,"_166":394,"_168":395,"_170":388,"_14":207,"_172":396,"_174":262,"_176":177,"_12":178,"_179":-5},"kcwxcgi3mbarz9m115ch1kn3v","Mitel MiCollab 5 个零日漏洞遭在野利用，CISA 已将其纳入 KEV","Mitel MiCollab 5 个漏洞已被用于数据窃取和可能的勒索活动，CISA 将其纳入 KEV，其中 4 个要求联邦机构在 11 月 28 日前处置，另 1 个截止日期为 12 月 9 日。","文章还原了攻击者从 MiCollab 漏洞入侵到身份基础设施的完整路径，并给出补丁时间线与处置期限。",{"_49":57},"2026-11-26T11:35:25.000Z",[180,263,210,293,186],"f2305","2026-11-26T12:59:19.480Z",{"_159":400,"_32":401,"_162":402,"_164":403,"_166":404,"_168":405,"_170":398,"_14":207,"_172":406,"_174":407,"_176":177,"_12":178,"_179":-5},"en1gv0ci3e610k5ce0nrbau25","Kaspersky 发现 Keenadu 后门预装于超过 220,000 台 Android 设备","Kaspersky 在前 10 个月内于超过 220,000 台 Android 设备中发现 Keenadu；它与 Triada 合计出现在今年检出预装恶意软件设备的 88% 中。","文章拆解了预装恶意软件的供应链入侵路径、潜伏与模块化机制，并提供企业采购前的样本测试建议。",{"_49":78},"2026-11-26T12:57:58.000Z",[224,227,225,408,409,226],75,"移动端","Kaspersky","f2307","2026-11-26T13:24:20.896Z",{"_159":413,"_32":414,"_162":415,"_164":416,"_166":417,"_168":418,"_170":411,"_14":171,"_172":419,"_174":420,"_176":177,"_12":178,"_179":-5},"a5fzo7vwm6srlhz65h7wxvfw8","Juniper Session Smart Conductor 严重漏洞 CVE-2026-103406 已被利用","Juniper Networks 与 CISA 确认，CVE-2026-103406 已在攻击中被利用，CVSS 9.8。该远程 OS 命令注入漏洞影响 Session Smart Conductor 的 AutomatedProvisionor 服务，攻击者可通过特制 Salt minion ID 以 root 权限执行任意命令。","原文明确披露漏洞已遭利用，并给出受影响版本、修复版本和 CISA 要求的处置时限。",{"_49":57},"2026-11-26T13:04:06.000Z",[181,180,182,186],80,"awaly7f5cwuea4sg732ir9h5vt","2026-11-26T14:44:23.715Z",{"_159":424,"_32":425,"_162":426,"_164":427,"_166":428,"_168":429,"_170":422,"_14":171,"_172":430,"_174":175,"_176":177,"_12":178,"_179":-5},"waly7f5cwuea4sg732ir9h5vt","Danfoss AK-SM 8xxA Series 控制器曝栈溢出漏洞 CVE-2026-129713，CVSS 9.8","Danfoss AK-SM 8xxA Series 控制器的未认证 CGI 处理器存在栈溢出漏洞 CVE-2026-129713，CVSS 为 9.8，远程攻击者发送特制 HTTP/S POST 请求可导致内存损坏、webserver 重启，并可能以 webserver 权限执行任意代码。","该通告同时给出无认证利用条件、缺失补丁状态和可立即执行的缓解配置，适合工业制冷设备运营方评估暴露风险。",{"_49":72},"2026-11-26T14:15:00.000Z",[181,182,180,274,186],"f2312","2026-11-26T15:38:27.030Z",{"_159":434,"_32":435,"_162":436,"_164":437,"_166":438,"_168":439,"_170":432,"_14":207,"_172":440,"_174":407,"_176":177,"_12":178,"_179":-5},"m5ausxhtut34kmi7zcnx0ncei","North Korea关联PolinRider污染超7,600个GitHub仓库传播恶意软件","North Korea关联的PolinRider活动通过劫持开发者账户、提交恶意Pull Request和重写Git历史，向至少7,609个GitHub仓库植入Python加载器，涉及2,330个账户；2026年10月27日至11月6日间已推送至2,040个仓库。","文章还原了PolinRider借助GitHub仓库传播恶意载荷的多条路径，并给出受影响仓库、账户和时间范围，便于识别开发环境供应链风险。",{"_49":75},"2026-11-26T15:13:41.000Z",[210,224,225,227,212,184,246,185],"f2318","2026-11-26T17:40:25.198Z",{"_159":444,"_32":445,"_162":446,"_164":447,"_166":448,"_168":449,"_170":442,"_14":171,"_172":450,"_174":451,"_176":177,"_12":178,"_179":-5},"ezziepbuq0itfxhnntdri5mbl","Drupal 远程代码执行漏洞 CVE-2026-132165 已发现在野利用","Drupal 远程代码执行漏洞 CVE-2026-132165 的 CVSS 评分为 8.1，漏洞细节与 PoC 已公开，并已发现在野利用。未经身份验证的攻击者可访问 core/install.php 重新安装 Drupal，进而替换管理员账户接管站点或实现远程代码执行。","漏洞细节与 PoC 已公开且出现真实利用，文章同时列出受影响版本、检测方法和升级路径，便于站点管理员快速判断并处置。",{"_49":60},"2026-11-26T10:33:00.000Z",[181,180,182,321,323],82,{"_453":454,"_455":-5},"changelogVersion","2026-10-01T08:00","release"]
