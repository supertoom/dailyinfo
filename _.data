rity","/dailyinfo/media/06c9ab9de6dbb6a5.webp","/dailyinfo/media/9c1b5fa87b3bafc5.webp 48w, /dailyinfo/media/06c9ab9de6dbb6a5.webp 96w","HUMAN披露并处置BADBOX 3.0广告欺诈网络",25.8,"14a0fad8-66ec-4bda-ac82-e2bc652b68c2","dbml5ujd9k2y3agezdbxfdnmx",[82,83,84,85],{"_49":86,"_51":52,"_53":87,"_55":88},{"_49":57,"_51":52,"_53":58,"_55":59},{"_49":74,"_51":52,"_53":75,"_55":76},{"_49":60,"_51":52,"_53":61,"_55":62},"SecurityWeek","/dailyinfo/media/6f21a015ea489b81.webp","/dailyinfo/media/c2a91b85de7bb9d6.webp 48w, /dailyinfo/media/6f21a015ea489b81.webp 96w",2,"CrowdStrike同意439亿美元收购Zscaler",30.8,"83d53a2c-4612-4179-a247-62493c1cfa2f","fb605neiwwim0nq406ol7basa",[95,96,97,98],{"_49":57,"_51":52,"_53":58,"_55":59},{"_49":74,"_51":52,"_53":75,"_55":76},{"_49":86,"_51":52,"_53":87,"_55":88},{"_49":99,"_51":52,"_53":-5},"Dark Reading",1,"GL.iNet GoodCloud漏洞已修补，设备恶意软件仍存",32,"ba176f09-c52f-4604-abe1-b6be5555c35e","i27aenxyu7ec3i7ftauologeu",[106,107,108,109,110],{"_49":74,"_51":52,"_53":75,"_55":76},{"_49":86,"_51":52,"_53":87,"_55":88},{"_49":112,"_51":52,"_53":113,"_55":114},{"_49":50,"_51":52,"_53":54,"_55":56},{"_49":111,"_51":52,"_53":-5},"Cybernews","The Hacker News","/dailyinfo/media/3d21685a726d0a64.jpg","/dailyinfo/media/a1e7de8b6809b50e.jpg 48w, /dailyinfo/media/3d21685a726d0a64.jpg 96w","2026-11-24","2026-11-23",8,"2026-11-22",6,"2026-11-21",16,{"_142":459,"_144":460,"_146":461,"_148":-5},{"_142":447,"_144":448,"_146":449,"_148":-5},{"_142":435,"_144":436,"_146":437,"_148":-5},{"_142":425,"_144":426,"_146":427,"_148":-5},{"_142":414,"_144":415,"_146":416,"_148":-5},{"_142":401,"_144":402,"_146":403,"_148":-5},{"_142":389,"_144":390,"_146":391,"_148":-5},{"_142":373,"_144":374,"_146":375,"_148":376},{"_142":361,"_144":362,"_146":363,"_148":-5},{"_142":347,"_144":348,"_146":349,"_148":-5},{"_142":330,"_144":331,"_146":332,"_148":333},{"_142":313,"_144":314,"_146":315,"_148":316},{"_142":297,"_144":298,"_146":299,"_148":-5},{"_142":278,"_144":279,"_146":280,"_148":281},{"_142":252,"_144":253,"_146":254,"_148":255},{"_142":237,"_144":238,"_146":239,"_148":-5},{"_142":222,"_144":223,"_146":224,"_148":-5},{"_142":202,"_144":203,"_146":204,"_148":205},{"_142":176,"_144":177,"_146":178,"_148":179},{"_142":143,"_144":145,"_146":147,"_148":-5},"key","f2018","anchorAt","2026-11-21T12:27:45.824Z","item",{"_149":150,"_32":151,"_152":153,"_154":155,"_156":157,"_158":159,"_160":145,"_14":161,"_162":163,"_164":165,"_166":167,"_12":168,"_169":-5},"group","id","dfh23lubzfof7rir61cxf0nq4","NebuSec 演示恶意网页劫持 Meta Muse 并读取私人聊天与记忆","summary","NebuSec 演示恶意网页可绕过审批提示，从 Meta Muse 云端机器提取并篡改用户聊天记录与存储记忆，并结合内置浏览器和 Linux 内核缺陷取得机器控制权，访问凭据存储、保存文件及 Sentinel。攻击仅影响单台云端机器，未进入共享服务器或其他用户设备；研究为实验室演示，NebuSec 称所披露弱点均已修复，但 Meta 尚未公开确认，补丁发布前是否有用户数据被访问也未说明。","reason","文章拆解了恶意网页经内置浏览器与 Linux 内核缺陷控制云端机器的攻击链，并说明影响边界与修复状态。","source",{"_49":112},"publishedAt","2026-11-21T11:53:07.000Z","timelineAt","disclosure","tags",[170,171,172,173,174,175],"score",71,"selected",true,"news","x","技术研究","利用链","AI 安全","Agent 安全","浏览器","内核","f2020","2026-11-21T16:09:45.367Z",{"_149":80,"_32":188,"_152":189,"_154":190,"_156":191,"_158":192,"_160":177,"_14":193,"_162":194,"_164":195,"_166":167,"_12":168,"_169":-5},{"_180":181,"_182":63,"_183":31,"_184":185},"factId","f0__GhdwcS3s","additionalSourceCount","reportCount","memberIds",[80,186,187],"cs06se3s3e0k3ft935zz94pmb","zbl2br8ssgupye47pxclrv5es","BADBOX 3.0 botnet 回归，每日发起 40 亿次欺诈广告竞价请求","HUMAN 的 Satori 研究人员发现 BADBOX 3.0 通过受感染的 Android 设备每日发起约 40 billion 次欺诈广告竞价请求，峰值占其观察到的 CTV 流量的 4% 以上。","材料揭示 BADBOX 3.0 通过感染 Android 设备实施广告欺诈与流量代理，并给出请求规模、代理网络和历史处置数据。",{"_49":50},"2026-11-21T15:17:27.000Z","activity",[196,197,198,199,200,201],73,"攻击活动","恶意软件","僵尸网络","移动端","IoT","Google","f2021","2026-11-21T18:05:45.021Z",{"_149":208,"_32":210,"_152":211,"_154":212,"_156":213,"_158":214,"_160":203,"_14":193,"_162":215,"_164":216,"_166":167,"_12":168,"_169":-5},{"_180":206,"_182":100,"_183":89,"_184":207},"f_LT_cj56DqU",[208,209],"lwn1awdsmrazlhsmt4r21vq0w","du89v7xfyc917tfg2bfc7pt1e","Microsoft Entra Connect Health 漏洞遭利用，租户数据被未授权访问","攻击者利用 Microsoft Entra Connect Health API 漏洞，未授权读取租户级元数据，并可能修改 Connect Health 监控配置。","事件提供了暴露数据类型、修复时间与客户无需更新的处置边界，也指出钓鱼风险和日志排查方向，便于受影响组织核对风险。",{"_49":50},"2026-11-21T18:01:58.000Z",[196,217,218,219,220,221],77,"在野利用","数据泄露","Microsoft","身份与访问","钓鱼","f2023","2026-11-21T23:50:45.254Z",{"_149":225,"_32":226,"_152":227,"_154":228,"_156":229,"_158":230,"_160":223,"_14":193,"_162":231,"_164":232,"_166":167,"_12":168,"_169":-5},"iepvrh0cnji8gnmctayok0ho0","Rackspace Spot 云平台遭入侵，攻击者读取客户 Kubernetes Secrets","攻击者使用泄露凭据入侵 Rackspace Spot 云平台，在部分客户组织中以合法用户身份创建 Kubernetes Pod、读取 Secrets，并列出节点和卷，受害凭据可能包括密码、认证令牌、API 密钥及 Spot API 令牌。","原文给出入侵时间窗、攻击者权限、泄露凭据类型和完整 IOC，客户可据此回溯集群、数据库及第三方服务中的异常访问。",{"_49":50},"2026-11-21T22:59:58.000Z",[196,218,233,234,235,236],72,"凭据","云原生","容器","供应链","am2rhspo6lynif9g168qaa6ue2","2026-11-22T06:45:16.657Z",{"_149":240,"_32":241,"_152":242,"_154":243,"_156":244,"_158":245,"_160":238,"_14":246,"_162":247,"_164":248,"_166":167,"_12":168,"_169":-5},"m2rhspo6lynif9g168qaa6ue2","Researchers uncover months of prompt theft across three AI inference providers","Dragos 通过 canary token 研究发现，攻击者从 3 家 AI inference provider 内部窃取数据数月，最早始于 7 月中旬；OpenRouter 因此移除 3 家提供商及 125 个 Zero Data Retention 端点并通知潜在受影响客户，但 OpenRouter 本身未遭入侵。","canary token 研究揭示了 AI 推理链路的隐蔽数据窃取方式，并给出路由器配置与凭据轮换等可迁移的排查思路。",{"_49":112},"2026-11-22T05:06:55.000Z","ai-security",[172,218,236,249,250,233,251],84,"大模型","AI 编码","AWS","f2025","2026-11-22T06:45:16.665Z",{"_149":259,"_32":261,"_152":262,"_154":263,"_156":264,"_158":265,"_160":266,"_14":161,"_162":267,"_164":268,"_166":167,"_12":168,"_169":-5},{"_180":256,"_182":89,"_183":45,"_184":257},"fcigjEufIvHg",[258,259,260],"tynuth71urn9723wgga79pff3","s68hl88mb77wpvsqsv9cuf6as","rtm2bg2fl4mul52kf1fa8ydgs","Artifex Ghostscript -dSAFER 沙箱绕过漏洞 CVE-2026-125396 已复现","Artifex Ghostscript < 10.08.0 的 -dSAFER 沙箱绕过漏洞 CVE-2026-125396 已被奇安信 CERT 复现，CVSS 4.0 分数为 8.5。","文章给出完整利用链、受影响版本和已公开 PoC，并覆盖发行版包、容器与应用升级等处置场景。",{"_49":277},"2026-11-22T04:43:00.000Z","2026-11-22T10:02:17.641Z",[269,270,271,272,170,273,274,275,276],85,"复现","漏洞分析","漏洞利用","补丁","奇安信","Ubuntu","Debian","PHP","奇安信 CERT","f2027","2026-11-22T15:59:15.526Z",{"_149":41,"_32":286,"_152":287,"_154":288,"_156":289,"_158":290,"_160":291,"_14":193,"_162":292,"_164":293,"_166":167,"_12":168,"_169":-5},{"_180":282,"_182":89,"_183":45,"_184":283},"fea8ayf9y9fE",[284,41,285],"atovtf3rgx78nodedw7k6h9cz","udk43l9ilvy9zr1ecoidwtl1m","Cleverbridge 确认平台客户支付卡数据遭窃取","全球电商平台 Cleverbridge 于 2026 年 11 月 4 日发现平台存在未授权活动，同日恢复系统运行；调查确认第三方复制了平台存储的支付卡数据。公司自 11 月 20 日起通知相关人员，但尚未确认受影响人数。","事件涉及支付卡号、有效期和CVV/CVC被复制，受害者需核查交易并防范借泄露事件实施的钓鱼。",{"_49":57},"2026-11-23T10:45:00.000Z","2026-11-23T11:32:35.331Z",[196,218,294,233,221,295,296],75,"数据窃取","Tenable","Red Hat","f2029","2026-11-22T17:09:18.096Z",{"_149":300,"_32":301,"_152":302,"_154":303,"_156":304,"_158":305,"_160":298,"_14":306,"_162":307,"_164":308,"_166":167,"_12":168,"_169":-5},"cpkja8bnlhxmi5kohgn7eye4s","VMware vCenter 认证绕过漏洞 CVE-2026-123890 已被在野利用","VMware vCenter 认证绕过漏洞 CVE-2026-123890 已被公开研究确认用于在野利用，长亭安全应急响应中心已完成复现验证。攻击者无需凭据，只需访问默认 TCP 2012 端口上的目录服务 RPC 接口，即可取得内置管理员会话，读取目录数据库、伪造 SSO 身份并创建管理员账号。","复现验证与在野利用线索并存，并给出受影响版本、管理端口前提和临时收敛措施，便于管理员判断风险与排查。",{"_49":312},"2026-11-22T12:04:00.000Z","vuln",[309,269,217,272,270,310,311],89,"漏洞","VMware","长亭","长亭安全应急响应中心","f2031","2026-11-22T18:50:16.542Z",{"_149":104,"_32":321,"_152":322,"_154":323,"_156":324,"_158":325,"_160":314,"_14":193,"_162":326,"_164":327,"_166":167,"_12":168,"_169":-5},{"_180":317,"_182":63,"_183":31,"_184":318},"fbBb15UnXN2k",[104,319,320],"xvdfgey1h2fjrjiq2mzm5outw","yx5d3ycu42hwl0b9ljfwu9d50","攻击者利用 GL.iNet GoodCloud 漏洞感染路由器与 KVM 设备","攻击者已利用 GL.iNet GoodCloud 云远程管理服务漏洞，在客户路由器和 KVM 设备中安装恶意软件；部分设备出现 root 级反向 Shell，攻击基础设施包括 66.245.219[.]252 和 65.20.71[.]131。","原文结合厂商通告、恶意样本和设备实测还原攻击链，并给出固件版本、IOC 与处置建议，便于读者排查已感染设备。",{"_49":50},"2026-11-22T18:45:37.000Z",[196,217,197,328,329,200],78,"后门","网络设备","f2040","2026-11-23T08:25:31.065Z",{"_149":337,"_32":338,"_152":339,"_154":340,"_156":341,"_158":342,"_160":343,"_14":306,"_162":344,"_164":268,"_166":167,"_12":168,"_169":-5},{"_180":334,"_182":100,"_183":89,"_184":335},"flyO_z8HqTEo",[336,337],"ytrsyn5npiv6iv3b7u28xsvdh","pgxndxlk0pc1jfszvzjw1m6zy","Cisco Expressway 漏洞 CVE-2026-76466 已被用于攻击，CVSS 9.8","Cisco Expressway 的硬编码凭据漏洞 CVE-2026-76466 已被用于真实攻击，CISA 于 11 月 20 日将其加入 KEV，联邦机构须在 11 月 23 日前完成修补。","文章还原了 Cisco Expressway 漏洞从外围设备入侵到集群横向移动的攻击链，并给出补丁、网络隔离和监控建议，便于评估受影响组织的处置优先级。",{"_49":57},"2026-11-23T10:00:00.000Z","2026-11-23T10:31:35.680Z",[309,217,272,345,346],"Cisco","CISA","ac8wjp58mjtg86cgal7wl3xraq","2026-11-23T09:10:32.612Z",{"_149":350,"_32":351,"_152":352,"_154":353,"_156":354,"_158":355,"_160":348,"_14":246,"_162":356,"_164":293,"_166":167,"_12":168,"_169":-5},"c8wjp58mjtg86cgal7wl3xraq","CERT-In 警告 AI 辅助攻击导致印度银行与金融科技机构发生未授权付款","印度 CERT-In 警告，攻击者利用 AI 辅助网络攻击篡改企业记录、审批关系并借合法支付流程发起未授权交易，受害对象包括银行、金融服务业实体及政府关联支付平台的技术服务商，损失金额和责任主体尚未披露。","文章汇总多起 AI 代理参与入侵的案例，并说明其自动化侦察、生成 Exploit 与绕过流程的机制，展示了攻击速度和组织能力的变化。",{"_49":112},"2026-11-23T08:24:15.000Z",[172,173,357,196,197,236,201,251,358,359,360,346],"AI 攻防","Cloudflare","Palo Alto","Check Point","f2046","2026-11-23T10:31:40.647Z",{"_149":364,"_32":365,"_152":366,"_154":367,"_156":368,"_158":369,"_160":362,"_14":193,"_162":370,"_164":371,"_166":167,"_12":168,"_169":-5},"lyf96vda5zff8pbjkukxgohx6","Bulgaria 发现持续五年的政府网络间谍活动，130 GB 文件被窃取","Bulgaria 发现自 2021 年起持续五年的网络间谍活动，多个国际黑客组织从政府数据库下载超过 130 GB、约 6200 万页文档，涉及内阁文件、报告及部委和机构间通信。调查人员尚未确定攻击者或国家级关联，也未确认数据是否被利用；目前没有证据表明公民个人数据受影响。事件于 2026 年 8 月由新国家网络安全监测系统发现异常活动后曝光，相关部门已隔离受影响系统、阻断访问并清除恶意软件。","事件暴露了政府网络长期缺少安全监测的问题，130 GB 文档外泄规模可作为改进持续监测与事件响应的参考。",{"_49":60},"2026-11-23T09:46:56.000Z",[196,218,217,294,372],70,"应急响应","f2052","2026-11-23T13:14:32.351Z",{"_149":380,"_32":381,"_152":382,"_154":383,"_156":384,"_158":385,"_160":386,"_14":306,"_162":387,"_164":388,"_166":167,"_12":168,"_169":-5},{"_180":377,"_182":100,"_183":89,"_184":378},"f60ehnx7lCIk",[379,380],"aajexg5l1lr7nm55hqh656xqo","k2zsycnny1ugsek91lkczs5fq","N-able 修复 Mail Assure 与 SpamExperts SSRF 漏洞 CVE-2026-134624","N-able 已修复 Mail Assure 和 SpamExperts Hosted Cloud 服务中的 SSRF 漏洞 CVE-2026-134624，该漏洞 CVSS 评分为 9.3，具备足够权限的 API 用户可迫使服务器连接任意内部主机和端口。","漏洞与此前攻击事件时间线清晰，并给出利用权限、影响范围、处置动作及补丁版本，便于评估 Mail Assure 部署风险。",{"_49":86},"2026-11-23T15:06:49.000Z","2026-11-23T15:18:32.507Z",[309,272,217,329,233],74,"akt28hyz5su4474tak5rdyu83s","2026-11-23T13:16:31.358Z",{"_149":392,"_32":393,"_152":394,"_154":395,"_156":396,"_158":397,"_160":390,"_14":193,"_162":398,"_164":388,"_166":167,"_12":168,"_169":-5},"kt28hyz5su4474tak5rdyu83s","Dragos 称至少三家 AI 推理服务商遭入侵，客户提示与 AWS 测试密钥被窃","Dragos 通过在 7 月至 11 月向常用 AI 服务发送约两百万条含 URL、主机名和 AWS 密钥等诱饵的提示，发现至少三家 AI 推理服务商遭入侵且均未自行察觉。","Dragos 通过约两百万条诱饵提示定位到推理服务商入口处的请求窃取，展示了识别提示词泄露与凭据滥用的可迁移方法。",{"_49":86},"2026-11-23T12:16:20.000Z",[196,218,399,249,233,234,251,400],"AI 供应链","阿里","f2066","2026-11-23T15:36:35.127Z",{"_149":404,"_32":405,"_152":406,"_154":407,"_156":408,"_158":409,"_160":402,"_14":193,"_162":410,"_164":308,"_166":167,"_12":168,"_169":-5},"iem1v1rdf735rh87a15ydka7e","GT13 攻击活动入侵 Check Point Security Management Servers，至少影响 22 家组织","GreyNoise 发现 GT13 针对 Check Point Security Management Servers 的入侵活动，确认攻击发生于 2026 年 10 月 17 日至 11 月 2 日，至少影响全球 22 家组织，涉及 24 台受控服务器。","文章还原了从漏洞利用、搭建中继到批量控制 Check Point 设备的完整链路，并列出 IOC 与多阶段时间线，便于防守方核对暴露面。",{"_49":413},"2026-11-22T16:00:00.000Z",[196,217,294,328,197,271,360,411,219,310,412],"Ivanti","Oracle","GreyNoise Blog","f2070","2026-11-23T16:19:31.924Z",{"_149":417,"_32":418,"_152":419,"_154":420,"_156":421,"_158":422,"_160":415,"_14":306,"_162":423,"_164":424,"_166":167,"_12":168,"_169":-5},"xq8xakipwwrrbp544jsizje8i","Azure API Management Classic 漏洞被用于窃取挪威能源公司密钥","Azure API Management Classic 漏洞已被用于针对挪威能源公司 Equinor 和 Skagerak Energi 等目标，攻击者可能获取了实例中存储的密钥。","材料把 Azure APIM Classic 的凭据暴露风险与两家挪威能源公司的安全事件联系起来，并给出受影响实例范围与轮换凭据的处置建议。",{"_49":86},"2026-11-23T15:47:40.000Z",[309,217,272,234,219,251],82,"f2075","2026-11-23T17:25:31.521Z",{"_149":428,"_32":429,"_152":430,"_154":431,"_156":432,"_158":433,"_160":426,"_14":193,"_162":434,"_164":371,"_166":167,"_12":168,"_169":-5},"q18h9n20h190vesq5m40qb6vd","GlobeTopper 遭黑客入侵，攻击者盗用 $70,000 礼品卡并造成约 $2.5 million 收入损失","B2B 数字礼品卡分销商 GlobeTopper 遭网络攻击，母公司 iQSTEL 称攻击者盗取了部分客户 API 凭据与集成密钥并兑换价值 $70,000 的数字礼品卡，预计造成约 $2.5 million 收入损失。","事件同时提供了攻击者得手的方式与受害方的处置节奏，API 凭据被窃取后如何轮换、下线与重建可直接供同类平台参考。",{"_49":50},"2026-11-23T16:50:01.000Z",[196,218,233,234,251],"aysh9eoiejcit2sca72qq4z9j7","2026-11-23T18:33:38.832Z",{"_149":438,"_32":439,"_152":440,"_154":441,"_156":442,"_158":443,"_160":436,"_14":161,"_162":444,"_164":445,"_166":167,"_12":168,"_169":-5},"ysh9eoiejcit2sca72qq4z9j7","VirtualBox 进程加固绕过 CVE-2026-87268 与 .NET 代码完整性分析","CVE-2026-87268 利用 .NET Framework v4 的程序集加载机制与 VirtualBox DLL 加载钩子，绕过受保护进程检查并加载任意代码；研究还发现，清除 PE 文件的 IMAGE_FILE_EXECUTABLE_IMAGE 标志可在 UMCI 启用时绕过 WDAC，并可经 COM 劫持攻击 PPL 进程。","文章从 VirtualBox 进程加固绕过切入，揭示 .NET 程序集加载机制如何影响 WDAC、UMCI 与 PPL 安全边界，并给出可复现的关键条件。",{"_49":446},"2026-11-23T08:00:00.000Z",[270,269,171,170,271,219,412],80,"Google Project Zero","f2080","2026-11-23T18:37:36.769Z",{"_149":450,"_32":451,"_152":452,"_154":453,"_156":454,"_158":455,"_160":448,"_14":193,"_162":456,"_164":165,"_166":167,"_12":168,"_169":-5},"msk8129yc8fadoi6jreqf6gt2","Google Ads 投放虚假 Codex 与 Claude Code 下载页面攻击 Mac 用户","Cato Networks 发现攻击者通过 Google Ads 投放 Codex、Claude Code 和 Homebrew 的虚假下载广告，利用流量 cloaking 向部分访客展示恶意安装器。","文章还原了 Google 赞助搜索中的虚假下载链路，并披露流量 cloaking、脚本下载及复用基础设施等关键环节。",{"_49":458},"2026-11-23T18:21:45.000Z",[196,197,221,294,201,457,358],"Apple","Hackread","f2091","2026-11-23T21:01:32.014Z",{"_149":462,"_32":463,"_152":464,"_154":465,"_156":466,"_158":467,"_160":460,"_14":193,"_162":468,"_164":388,"_166":167,"_12":168,"_169":-5},"zzi7f7xofm7gytvcqddw0dvqq","KEPCO 确认数据泄露，超过 150 万人信息被访问","Korea Electric Power Corporation（KEPCO）确认攻击者侵入内部网络，访问 KEPCO ON 电费平台和 SRM 采购系统，泄露超过 150 万人的数据。","KEPCO确认攻击影响三个数据群体，并披露了具体数据字段与应对措施，但入侵链和攻击者归因仍不清晰。",{"_49":50},"2026-11-23T20:54:51.000Z",[196,218,217,469,221],"工控",{"_471":472,"_473":-5},"changelogVersion","2026-10-01T08:00","release"]
