58,"_141":259,"_143":-5},{"_137":245,"_139":246,"_141":247,"_143":-5},{"_137":229,"_139":230,"_141":231,"_143":-5},{"_137":211,"_139":212,"_141":213,"_143":-5},{"_137":192,"_139":193,"_141":194,"_143":-5},{"_137":177,"_139":178,"_141":179,"_143":-5},{"_137":138,"_139":140,"_141":142,"_143":-5},"key","aiu292yqpietfeotxyzzz5vwtz","anchorAt","2026-11-09T15:23:17.793Z","item",{"_144":145,"_32":146,"_147":148,"_149":150,"_151":152,"_153":154,"_155":140,"_14":156,"_157":158,"_159":160,"_161":162,"_12":163,"_164":-5},"group","id","iu292yqpietfeotxyzzz5vwtz","ARTEX AI 攻击代理在三个月内被用于凭据窃取、数据窃取和间谍活动","summary","ARTEX 是一款由 LLM 驱动、可自主规划并执行攻击步骤的开源渗透测试框架，发布于 2026 年 7 月 26 日，三个月内即被多个攻击组织采用。","reason","多个威胁情报团队的观测展示了 AI 攻击代理的速度与扩散路径，文中还给出凭据轮换、最小权限和行为检测等可迁移防线。","source",{"_48":105},"publishedAt","2026-11-09T14:57:32.000Z","timelineAt","activity","tags",[165,166,167,168,169,170,171,172,173,174,175,176],"score",82,"selected",true,"news","x","攻击活动","AI 攻防","Agent 安全","恶意软件","凭据","数据窃取","Google","Microsoft","CrowdStrike","Cloudflare","AWS","Kaspersky","az9m0q0x4imr57l4hu75xrjlyw","2026-11-09T15:23:17.804Z",{"_144":180,"_32":181,"_147":182,"_149":183,"_151":184,"_153":185,"_155":178,"_14":156,"_157":186,"_159":187,"_161":162,"_12":163,"_164":-5},"z9m0q0x4imr57l4hu75xrjlyw","攻击者劫持 Copeland XWEB 制冷控制器搭建垃圾邮件僵尸网络与代理服务","SecurityScorecard 发现暴露在互联网的 Copeland XWEB PRO 制冷控制器被劫持，用于垃圾邮件、隧道和代理流量。","文章通过邮件目标重合、隧道流量和代理连接等观测还原物联网设备被劫持后的基础设施化利用，并说明取证与归因边界。",{"_48":105},"2026-11-09T14:54:01.000Z",[165,168,188,189,190,191],72,"僵尸网络","IoT","工控","供应链","f814","2026-11-09T17:28:20.117Z",{"_144":195,"_32":196,"_147":197,"_149":198,"_151":199,"_153":200,"_155":193,"_14":201,"_157":202,"_159":203,"_161":162,"_12":163,"_164":-5},"zghpc4nj0iecoj0z1g1co19fw","Apache OFBiz 未认证远程代码执行漏洞 CVE-2026-83542 已复现","Apache OFBiz < 24.09.08 存在未认证远程代码执行漏洞 CVE-2026-83542，长亭安全应急响应中心已完成复现，命令以 OFBiz 服务进程账号执行。","通告完整拆解了未认证利用链，并提供受影响版本、官方补丁和复现验证，便于判断暴露面与处置优先级。",{"_48":210},"2026-11-09T08:45:00.000Z","vuln",[204,205,206,207,208,209],74,"漏洞","复现","漏洞分析","补丁","漏洞利用","长亭","长亭安全应急响应中心","f816","2026-11-09T17:29:22.840Z",{"_144":214,"_32":215,"_147":216,"_149":217,"_151":218,"_153":219,"_155":212,"_14":220,"_157":221,"_159":222,"_161":162,"_12":163,"_164":-5},"qyo8qffol6jd25k9c4ndd0x8m","AWS IAM 出站身份联合支持跨分区访问并新增来源区域控制","AWS 扩展 IAM 出站身份联合，允许工作负载使用短期 JWT 跨 AWS 分区换取临时凭据，无需存储或轮换长期凭据。该能力覆盖 AWS Commercial、China、GovCloud (US) 和 European Sovereign Cloud 的全部 Region，不额外收费，但不支持同分区联合。","文章提供跨分区身份联合的完整配置与授权示例，并说明如何按来源身份、区域和分区限制及撤销访问。",{"_48":228},"2026-11-09T16:08:30.000Z","blue-team",[223,224,225,226,227,175],75,"版本更新","身份与访问","云原生","加固","安全运营","AWS Security Blog","f818","2026-11-09T17:29:23.598Z",{"_144":232,"_32":233,"_147":234,"_149":235,"_151":236,"_153":237,"_155":230,"_14":238,"_157":239,"_159":240,"_161":162,"_12":163,"_164":-5},"imnibw6va3o3lu944dktlsc3x","越狱 AI Agent 对欧洲电信运营商及 13 家托管机构发起两周攻击","Malbear Labs 披露 Operation Snowball 攻击活动：越狱 AI Agent 在超过两周内入侵一家欧洲电信运营商及其数据中心和云基础设施上的 13 家组织。","Malbear Labs 从暴露目录中的 70 多份会话记录还原了攻击者的目标、操作方式和受阻后的适应行为，为研究 AI Agent 驱动的长期入侵提供了可核对材料。",{"_48":108},"2026-11-09T16:00:00.000Z","ai-security",[241,167,165,242,208,243,244],77,"AI 安全","在野利用","Cisco","Oracle","f819","2026-11-09T17:29:23.606Z",{"_144":248,"_32":249,"_147":250,"_149":251,"_151":252,"_153":253,"_155":246,"_14":156,"_157":254,"_159":255,"_161":162,"_12":163,"_164":-5},"rqkyyu2r18o90oudsck3f8pkv","恶意 GitHub Actions workflow 入侵数万仓库并窃取凭据","Socket 发现 GhostAction 变体通过 henrywoo、kitao 两个 GitHub 账号向有写权限的数百个仓库注入 .github/workflows/security-audit.yml，影响扩散至数万个人及组织仓库，包括 uber/athenadriver。","文章还原了恶意 GitHub Actions workflow 的注入、凭据窃取和扩大影响路径，可用于理解供应链活动如何借助自动化流程长期潜伏。",{"_48":108},"2026-11-09T14:30:00.000Z",[165,256,170,169],81,"供应链投毒","f820","2026-11-09T17:35:17.490Z",{"_144":260,"_32":261,"_147":262,"_149":263,"_151":264,"_153":265,"_155":258,"_14":201,"_157":266,"_159":267,"_161":162,"_12":163,"_164":-5},"j93urv2xb8cpls1ifxjrc7w5y","OpenSSH SSHole 漏洞 CVE-2026-123158 已被在野利用以入侵 Linux 系统","攻击者正在利用 OpenSSH 的 SSHole 漏洞 CVE-2026-123158，绕过部分 musl-based Linux 系统上的身份验证并执行命令、窃取凭据和植入持久化访问。","多家机构记录了 SSHole 的真实利用链及攻击后行为，文中同时给出了修复版本与排查指标，便于管理员判断风险并核查受影响系统。",{"_48":92},"2026-11-09T16:04:57.000Z",[204,242,207,208,169],78,"f830","2026-11-09T18:09:18.997Z",{"_144":271,"_32":272,"_147":273,"_149":274,"_151":275,"_153":276,"_155":269,"_14":156,"_157":277,"_159":278,"_161":162,"_12":163,"_164":-5},"tt70s7pz8emjzy4j5exngbu4d","攻击者滥用 Qubole 的 AWS 信任关系，窃取多个客户账户数据","攻击者在 October 14 至 October 26 期间利用 Qubole 平台 AWS 账户的凭据，接管多个客户 AWS 账户，读取 Lambda 环境变量、Secrets Manager、SSM Parameter Store 中的凭据并复制 S3 数据。","文章还原了攻击者借 Qubole 信任关系访问客户 AWS 账户、窃取凭据和数据的过程，并给出可落地的 CloudTrail 排查线索与权限收敛建议。",{"_48":49},"2026-11-09T17:51:21.000Z",[165,279,169,225,175],80,"数据泄露","f828","2026-11-09T18:09:19.006Z",{"_144":283,"_32":284,"_147":285,"_149":286,"_151":287,"_153":288,"_155":281,"_14":156,"_157":289,"_159":187,"_161":162,"_12":163,"_164":-5},"kn0s66lhj741ftnk7loyn0aq2","攻击者利用 Ethersphere 发布自动化植入 bee-js 13.3.0 和 Swarm Desktop 0.56.2 恶意版本","攻击者利用 Ethersphere 项目被盗的 CI 凭据，向 npm 发布恶意 bee-js 13.3.0，并分发恶意 Swarm Desktop 0.56.2，目标是窃取节点私钥和明文密码及 xDAI、xBZZ 等资产，同时在 Windows、macOS、Linux 安装后门。","事件展示了被盗 CI 凭据如何借发布自动化植入恶意包，并给出了受影响版本、投递窗口与完整 IOC，便于排查供应链投毒痕迹。",{"_48":49},"2026-11-09T17:36:28.000Z",[165,168,256,290,170,191],"后门","f835","2026-11-09T18:36:17.752Z",{"_144":294,"_32":295,"_147":296,"_149":297,"_151":298,"_153":299,"_155":292,"_14":156,"_157":300,"_159":187,"_161":162,"_12":163,"_164":-5},"ce0ym3zyg5v6m3xleakr9kfjg","俄罗斯云服务商 Beget 遭数据擦除攻击，云基础设施从零重建","俄罗斯云服务商 Beget 在 11 月 1 日遭数据擦除攻击，攻击者取得整个架构的管理系统访问权并执行数据清零脚本，导致 VPS、S3、Kubernetes 数据及 CDN 设置、IP 配置丢失。","Beget 披露的攻击覆盖整个云架构管理层，并造成多类云服务数据与配置丢失，恢复过程中的手动排查做法可供云平台事件处置参考。",{"_48":92},"2026-11-09T17:50:32.000Z",[165,168,170,301,225,302],"应急响应","容器","f841","2026-11-09T19:31:23.940Z",{"_144":306,"_32":307,"_147":308,"_149":309,"_151":310,"_153":311,"_155":304,"_14":220,"_157":312,"_159":313,"_161":162,"_12":163,"_164":-5},"da9gkm4s2198ryxlglytg395i","AWS 推出 Amazon Bedrock AgentCore Memory 多层写入验证方案","Amazon Bedrock AgentCore Memory 可通过写入前 Lambda 拦截器组合 IAM 条件键、Cedar 策略、整合提示和 ApplyGuardrail API，按语义漂移 40%、注入模式 25%、命名空间边界 25%、写入频率异常 10%评分，低于 35 放行、35–60 隔离、高于 60 拒绝并通过 SNS 告警。","该方案把 AgentCore 既有控制与语义漂移检测组合成可落地的写入验证层，并公开代码、策略和测试数据，便于评估实现成本与拦截效果。",{"_48":228},"2026-11-09T19:05:52.000Z",[314,315,316,226,241,167,175],71,"蓝队","工具发布","检测工程","f842","2026-11-09T19:32:27.495Z",{"_144":320,"_32":321,"_147":322,"_149":323,"_151":324,"_153":325,"_155":318,"_14":156,"_157":326,"_159":222,"_161":162,"_12":163,"_164":-5},"rgf6ztew8hr9hfi7xzfc08b7i","法国将超市冷藏设备攻击归因于 Iran IRGC","法国将 11 月 12 日发生的 700 个超市冷藏站点攻击归因于 Iran IRGC 关联的 Shahid Kaveh 网络部队，称攻击通过抬升冰箱温度破坏库存并引发数起火灾；归因依据包括基础设施、签名工具、波斯语痕迹及关联宣传组织，但作者指出公开报道未说明技术证据。","材料区分法国政府的归因主张与尚未确认的关联事件，并整理了控制器入侵路径及可落地的防护措施。",{"_48":56},"2026-11-09T19:12:43.000Z",[165,279,191,327],"CISA","f851","2026-11-09T21:33:24.550Z",{"_144":331,"_32":332,"_147":333,"_149":334,"_151":335,"_153":336,"_155":329,"_14":201,"_157":337,"_159":313,"_161":162,"_12":163,"_164":-5},"cbvzferz6gst41xh1a92xpudd","Remark42 信任转发请求头导致按 IP 限流绕过，v1.16.2 增加可信代理配置","Remark42 因全局信任 True-Client-IP、X-Real-IP 和 X-Forwarded-For，攻击者可轮换伪造 IP 绕过 /auth、头像、图片代理及 open、protected、admin 等路由组的按 IP 限流，并影响评论 IP、匿名身份和 --votes-ip 投票去重。","漏洞不仅涉及各类接口的按 IP 限流绕过，还给出了依赖 RemoteAddr 的匿名身份与投票去重影响，修复配置中的兼容风险也值得核查。",{"_48":340},"2026-11-09T21:18:29.000Z",[204,205,206,338,207,339],"利用链","网络设备","GitHub 安全公告","f861","2026-11-09T21:33:26.693Z",{"_144":344,"_32":345,"_147":346,"_149":347,"_151":348,"_153":349,"_155":342,"_14":201,"_157":350,"_159":351,"_161":162,"_12":163,"_164":-5},"ke43qtftrmo1i5qcbhrr32q9r","Chrome 157 稳定版更新修复 9 项安全漏洞，CVE-2026-125350 已被在野利用","Chrome Stable 渠道已更新至 Windows 和 Mac 的 157.0.8103.50/.51、Linux 的 157.0.8103.50，将在未来数日或数周内推送。","公告确认 CVE-2026-125350 已存在在野利用，并列出本次 Stable 渠道更新包含的 9 项安全修复及影响组件。",{"_48":353},"2026-11-09T20:52:57.820Z",[207,242,171,352],79,"浏览器","Chrome Releases","f864","2026-11-09T21:39:18.284Z",{"_144":357,"_32":358,"_147":359,"_149":360,"_151":361,"_153":362,"_155":355,"_14":201,"_157":363,"_159":267,"_161":162,"_12":163,"_164":-5},"g8lommzdv7g4jq6hsbkd50oer","N-able 公开 N-central 30 余项零日漏洞，厂商全球下线托管环境","安全研究员 Sean Bales 公开 N-central 30 余项疑似零日漏洞及 Able2Shell PoC，涵盖认证绕过、凭据泄露、任意文件写入、XSS、XXE、远程代码执行和提权。","材料列出多条可利用链与 PoC，并记录厂商下线隔离和热修复进展，便于评估 N-central 暴露面与处置优先级。",{"_48":92},"2026-11-09T21:26:25.000Z",[204,205,208,338,364,301],"漏洞管理","f863","2026-11-09T21:39:18.291Z",{"_144":368,"_32":369,"_147":370,"_149":371,"_151":372,"_153":373,"_155":366,"_14":156,"_157":374,"_159":375,"_161":162,"_12":163,"_164":-5},"e7lcly2g4egsvihl038ydgvm2","York University 确认数据泄露，2007 至 2026 年表单中的个人信息被窃取","York University 确认威胁行为者入侵系统，窃取 14 个大学网站在线表单中的个人信息，受影响表单提交时间跨度为 2007 至 2026 年，事件于 10 月 25 日被发现。","原文按数据类别列出了泄露范围，并说明学校已修复表单、通知高风险个人及提供两年信用监控，可用于评估个人数据处置需求。",{"_48":92},"2026-11-09T21:22:31.000Z",[165,279,224,169],70,"f867","2026-11-09T22:34:23.861Z",{"_144":379,"_32":380,"_147":381,"_149":382,"_151":383,"_153":384,"_155":377,"_14":201,"_157":385,"_159":187,"_161":162,"_12":163,"_164":-5},"e66ggzbd30z4bw2bk32u09znp","Velociraptor sql() 插件权限校验缺失导致低权限分析师读取服务器文件","Velocidex/velociraptor server 的 sql() VQL 插件未执行权限检查，低权限 analyst 可借数据库连接串建立任意外连 TCP 连接，并通过恶意 MySQL 服务器的 `LOAD DATA LOCAL INFILE` 读取 root 可读文件。","该披露定位了权限元数据未参与运行时校验的根因，并给出实际外传服务器文件的利用链，便于审计同类插件访问控制。",{"_48":340},"2026-11-09T22:25:14.000Z",[204,205,208,206,224,170],"f868","2026-11-09T22:34:23.880Z",{"_144":389,"_32":390,"_147":391,"_149":392,"_151":393,"_153":394,"_155":387,"_14":201,"_157":395,"_159":313,"_161":162,"_12":163,"_164":-5},"gc7trhj1kt8vlp3wcltk8n5h6","Kubeflow Pipelines 共享管道上传授权绕过漏洞 CVE-2026-77596，CVSS v3.1 9.6","Kubeflow Pipelines API server 的 HTTP multipart 上传端点在多用户模式且目标命名空间为空时跳过授权，低权限租户或可直接访问 API server 的未认证调用者可创建共享管道或注入新版本。","漏洞成因、空命名空间触发条件和 PoC 均已明确，修复版本与自动化影响路径可供部署方直接评估。",{"_48":340},"2026-11-09T22:22:41.000Z",[204,205,208,207,302,225],"f872","2026-11-09T22:34:23.929Z",{"_144":399,"_32":400,"_147":401,"_149":402,"_151":403,"_153":404,"_155":397,"_14":201,"_157":405,"_159":406,"_161":162,"_12":163,"_164":-5},"j3zs99gaytjzbcm7piuk8be0b","GPUStack v2.2.0 之前认证绕过漏洞已被在野利用","GPUStack v2.2.0 之前存在认证绕过，默认配置下可将请求来源判定为 127.0.0.1 并授予未认证管理员权限；同机反向代理会暴露 TCP peer，伪造 X-GPUStack-Real-IP: 127.0.0.1 也可触发该分支。","文章完整说明两种绕过路径及真实攻击后果，并给出固定版本和临时缓解配置，便于部署方快速判断暴露范围与处置优先级。",{"_48":340},"2026-11-09T22:15:27.000Z",[204,242,207,208,224,339],84,"f876","2026-11-09T22:34:23.965Z",{"_144":410,"_32":411,"_147":412,"_149":413,"_151":414,"_153":415,"_155":408,"_14":201,"_157":416,"_159":240,"_161":162,"_12":163,"_164":-5},"e5jls9lti326n3d2mnpnvazo7","Telepresence Traffic Manager gRPC 无认证漏洞可跨命名空间窃取环境变量","Telepresence 的 Traffic Manager gRPC API 在 8081 端口未配置认证，任何具备集群网络访问能力的 Pod 都可注册为客户端，并拦截其无 Kubernetes RBAC 权限的受管命名空间服务。","文章定位到缺少认证拦截器和命名空间授权校验的实现缺陷，并给出可直接复现的 PoC。",{"_48":340},"2026-11-09T21:59:49.000Z",[204,205,208,225,302,169],{"_418":419,"_420":-5},"changelogVersion","2026-10-01T08:00","release"]
