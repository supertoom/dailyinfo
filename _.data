},{"_153":374,"_155":375,"_157":376,"_159":-5},{"_153":362,"_155":363,"_157":364,"_159":-5},{"_153":347,"_155":348,"_157":349,"_159":350},{"_153":331,"_155":332,"_157":333,"_159":-5},{"_153":318,"_155":319,"_157":320,"_159":-5},{"_153":305,"_155":306,"_157":307,"_159":-5},{"_153":290,"_155":291,"_157":292,"_159":293},{"_153":277,"_155":278,"_157":279,"_159":-5},{"_153":265,"_155":266,"_157":267,"_159":-5},{"_153":248,"_155":249,"_157":250,"_159":-5},{"_153":228,"_155":229,"_157":230,"_159":231},{"_153":203,"_155":204,"_157":205,"_159":206},{"_153":190,"_155":191,"_157":192,"_159":-5},{"_153":154,"_155":156,"_157":158,"_159":-5},"key","f2199","anchorAt","2026-11-25T07:21:34.918Z","item",{"_160":161,"_32":162,"_163":164,"_165":166,"_167":168,"_169":170,"_171":156,"_14":172,"_173":174,"_175":176,"_177":178,"_12":179,"_180":-5},"group","id","hqr7a8jnzrlz59l5eel4ijr3d","Com 关联黑客通过 vishing 劫持云账户并窃取数据实施勒索","summary","Palo Alto Networks Unit 42 披露，自 2026 年 8 月以来，多组 Com 关联威胁集群以 vishing 攻击美国、英国和澳大利亚的金融、医疗及法律等行业目标，并通过伪装 IT 人员诱导用户访问个性化钓鱼页面，窃取凭据与会话令牌。","reason","材料梳理了多组关联 Com 的攻击集群如何以 vishing 切入云环境，并呈现了凭据窃取、持久化、数据外传和勒索协商的完整链条。","source",{"_49":57},"publishedAt","2026-11-25T06:37:06.000Z","timelineAt","activity","tags",[181,182,183,184,185,186,187,188,189],"score",77,"selected",true,"news","x","攻击活动","钓鱼","恶意软件","数据窃取","勒索","云原生","Palo Alto","Microsoft","Google","f2200","2026-11-25T07:21:34.930Z",{"_160":193,"_32":194,"_163":195,"_165":196,"_167":197,"_169":198,"_171":191,"_14":172,"_173":199,"_175":200,"_177":178,"_12":179,"_180":-5},"iu92z8gp4qik86f7cj49f2b0i","WordPress 在恶意发布前拦截 6 个被植入后门的 WP Connect 插件","WordPress 在恶意版本发布前发现并关闭了 WP Connect 开发的 6 个被植入后门的插件，事件被跟踪为 CVE-2026-135202，CVSS 9.8，目前无补丁。","文章列出六个受影响插件及恶意版本，并揭示后门的通信、执行与持久化机制，便于站点排查和清除残留。",{"_49":57},"2026-11-25T06:21:12.000Z",[181,201,202,184],70,"后门","供应链投毒","f2204","2026-11-25T08:59:32.960Z",{"_160":213,"_32":215,"_163":216,"_165":217,"_167":218,"_169":219,"_171":204,"_14":220,"_173":221,"_175":222,"_177":178,"_12":179,"_180":-5},{"_207":208,"_209":113,"_210":94,"_211":212},"factId","fls6PdC5HPDo","additionalSourceCount","reportCount","memberIds",[213,214],"avypzdbdq1qojwu816bm9mjpx","e6vclqnssenat6axpyd0r55su","Palo Alto Networks 修复已被利用的 PAN-OS Fragnesia 提权漏洞 CVE-2026-46300","Palo Alto Networks 发布 PAN-OS 更新，修复 Linux 内核 Fragnesia 提权漏洞 CVE-2026-46300。该漏洞影响 XFRM ESP-in-TCP 子系统，无权限攻击者可覆写敏感系统文件并获得 root 权限。","原文把 Fragnesia 的提权链、已观察到的利用活动与 PAN-OS 修复版本放在一起，便于判断管理界面暴露风险并安排升级。",{"_49":60},"2026-11-25T08:12:24.000Z","vuln",[223,224,225,226,187,227],84,"漏洞","补丁","在野利用","内核","PHP","f2203","2026-11-25T08:59:32.969Z",{"_160":82,"_32":235,"_163":236,"_165":237,"_167":238,"_169":239,"_171":240,"_14":241,"_173":242,"_175":243,"_177":178,"_12":179,"_180":-5},{"_207":232,"_209":113,"_210":94,"_211":233},"fnn4Ufi2IC48",[234,82],"eca8176ln16b9nsoow3iupcqj","Drupal Fail2Install 漏洞 CVE-2026-132165 已在真实站点遭到利用","Drupal Fail2Install 远程代码执行漏洞 CVE-2026-132165（CVSS 9.8）已被用于攻击真实站点，CISA 将其纳入 KEV，并要求联邦机构在 2026 年 11 月 27 日前完成修复。","文章给出漏洞利用链、受影响版本和修复版本，并说明该漏洞已进入 KEV 且在真实站点遭到利用。",{"_49":57},"2026-11-25T11:23:26.000Z","2026-11-25T12:21:35.939Z","disclosure",[244,245,246,225,224,247],90,"漏洞分析","复现","漏洞利用","CISA","f2207","2026-11-25T09:18:35.695Z",{"_160":251,"_32":252,"_163":253,"_165":254,"_167":255,"_169":256,"_171":249,"_14":257,"_173":258,"_175":259,"_177":178,"_12":179,"_180":-5},"lxnv0a3ecphevlisp1srqqla3","Microsoft Entra Agent ID 凭据注入与钓鱼攻击链分析","文章分析 Microsoft Entra Agent ID 的代理蓝图、蓝图主体、代理身份与代理用户对象，复现凭据注入和管理员钓鱼两条利用链。测试覆盖 79 个资源、1041 项权限，97 项被阻止、944 项仍可通过，并发现可继承权限、跨租户蓝图及 AgentIdentity.CreateAsManager 可用于创建子代理身份和提权。","文章拆解了 Entra Agent ID 的对象与令牌交换机制，并用凭据注入和管理员钓鱼复现代理身份提权链及日志检测方法。",{"_49":264},"2026-11-23T12:36:34.000Z","ai-security",[260,261,262,245,263,188],76,"AI 安全","Agent 安全","技术研究","利用链","先知社区","f2208","2026-11-25T09:21:33.171Z",{"_160":268,"_32":269,"_163":270,"_165":271,"_167":272,"_169":273,"_171":266,"_14":220,"_173":274,"_175":275,"_177":178,"_12":179,"_180":-5},"axw26ahpt16j5z7des6z6m063","Microsoft 确认 Windows 更新后出现认证问题，CVE-2026-118737 补丁暂无完整修复","Microsoft 确认 Windows Remote Procedure Call Runtime 存在高危远程代码执行漏洞 CVE-2026-118737，未认证攻击者可在无需用户交互的情况下利用尚未安装补丁的系统执行代码。","Microsoft 说明了高危漏洞的利用前提与补丁进展，同时披露补丁可能引发的认证兼容问题及临时处置限制。",{"_49":88},"2026-11-25T09:02:57.000Z",[223,224,276,188],73,"身份与访问","f2209","2026-11-25T10:12:35.951Z",{"_160":280,"_32":281,"_163":282,"_165":283,"_167":284,"_169":285,"_171":278,"_14":172,"_173":286,"_175":287,"_177":178,"_12":179,"_180":-5},"qisjy9p95panczoi5l58gkd5l","DLSS 5 Swapper 官网安装包被替换并投递信息窃取程序","DLSS 5 Swapper 官网分发的 v2.2.9 安装包被同名恶意文件替换，官网公布 SHA-256 为 e89fb5e59b4304e1fb2bccba7d24353ef83ea22b7b699c68a33828ae4420f735。","文章还原了官网安装包被替换后的完整执行链、窃密能力与关键 IOC，可用于排查下载记录、落地文件和进程异常。",{"_49":289},"2026-11-25T04:06:00.000Z",[181,202,183,184,288],71,"奇安信","奇安信威胁情报中心","f2210","2026-11-25T10:12:37.590Z",{"_160":117,"_32":298,"_163":299,"_165":300,"_167":301,"_169":302,"_171":291,"_14":220,"_173":303,"_175":304,"_177":178,"_12":179,"_180":-5},{"_207":294,"_209":94,"_210":45,"_211":295},"fsk1W6sVk-3I",[117,296,297],"fymjwsjohp5gf7xq7kkcwwk13","p5sjx2d7ile73kobdy6s3a12y","GeoServer 未认证远程代码执行漏洞链 CVE-2026-129242 等已复现","GeoServer 未认证远程代码执行漏洞链涉及 CVE-2026-129244、CVE-2026-129243、CVE-2026-120705、CVE-2026-129245 和 CVE-2026-129242，奇安信 CERT 已复现，PoC 和技术细节均已公开。","原文披露了完整利用链、受影响版本和补丁状态，并给出可执行的临时缓解措施，适合用于评估 GeoServer 暴露风险与处置优先级。",{"_49":128},"2026-11-24T18:56:00.000Z",[223,245,246,224,225,288],85,"ac9hgkghkzefw33iy1l42j3rr8","2026-11-25T10:21:33.906Z",{"_160":308,"_32":309,"_163":310,"_165":311,"_167":312,"_169":313,"_171":306,"_14":172,"_173":314,"_175":315,"_177":178,"_12":179,"_180":-5},"c9hgkghkzefw33iy1l42j3rr8","Hex.pm 遭 CVSS 10.0 漏洞 CVE-2026-129514 在野利用，6 台注册服务器被攻陷","攻击者利用 Hex.pm 的 CVSS 10.0 漏洞 CVE-2026-129514，通过未认证 POST 请求触发系统命令，攻陷 6 台生产服务器；负载均衡日志记录周一 18:16 至 18:29 UTC 期间来自两个地址的 69 次利用请求。","原文披露了未认证请求触发系统命令的完整利用链，并给出 69 次利用请求、6 台受影响服务器及凭据处置建议，便于读者评估自身依赖与暴露风险。",{"_49":57},"2026-11-25T09:06:59.000Z",[225,246,223,316,317],87,"供应链","数据泄露","f2218","2026-11-25T11:17:38.337Z",{"_160":321,"_32":322,"_163":323,"_165":324,"_167":325,"_169":326,"_171":319,"_14":172,"_173":327,"_175":328,"_177":178,"_12":179,"_180":-5},"y2iujer012r6dlq4qwu6j4trf","无密码开放数据库暴露约 20 亿条凭据及会话令牌","Jeremiah Fowler 发现一个可在线访问且无密码、无加密的数据库，其中约有 20 亿条凭据记录、约 8471 个目录和 40 万份疑似由信息窃取木马收集的文档。","该数据库不仅暴露账号凭据，还包含会话令牌、Cookie 与设备信息，能够展示信息窃取木马聚合数据后的潜在危害。",{"_49":330},"2026-11-25T10:44:20.000Z",[317,329,183,184],79,"凭据","Hackread","ab33a91bvikjv1n0w4nattkvaw","2026-11-25T11:20:47.250Z",{"_160":334,"_32":335,"_163":336,"_165":337,"_167":338,"_169":339,"_171":332,"_14":340,"_173":341,"_175":176,"_177":178,"_12":179,"_180":-5},"b33a91bvikjv1n0w4nattkvaw","英国开展国家级排查，数千台制冷控制器被断网","英国近期排查大型超市、仓库、餐厅、加油站和体育场馆的制冷设备风险，期间数千台控制制冷设备的控制器被撤出公网，部分企业改用人工监测温度。Omega Solutions发现风险后，Pen Test Partners完成验证和分析，英国NCSC、Defra、FSA联合推动告警与修复，厂商RDM已发布首批补丁并建议客户采取防护措施。","文章呈现了制冷控制器风险从漏洞验证、跨机构协调到批量断网和补丁修复的完整处置链条，为同类关键基础设施排查提供参考。",{"_49":125},"2026-11-25T10:20:47.235Z","blue-team",[342,343,344,345,346],"蓝队","应急响应","加固","IoT","漏洞管理","f2222","2026-11-25T11:20:47.306Z",{"_160":354,"_32":355,"_163":356,"_165":357,"_167":358,"_169":359,"_171":360,"_14":220,"_173":361,"_175":200,"_177":178,"_12":179,"_180":-5},{"_207":351,"_209":94,"_210":45,"_211":352},"fU-A0Q2yxUGE",[353,354],"yu82hny47v29bntfa2kcc7nlu","q0lsfhn32cxsdecbzc9oo3rfd","GeoServer 修复 5 个高危漏洞，CVE-2026-120705 等漏洞细节与 PoC 已公开","GeoServer 修复 CVE-2026-120705、CVE-2026-129242、CVE-2026-129243、CVE-2026-129244、CVE-2026-129245，涉及 WFS 存储查询、服务安全规则、remember-me 会话及 JDBC 安全服务，可串联形成未经身份验证的远程代码执行利用链。","通告列明多个漏洞的利用链、评分、版本范围与修复版本，并提供升级和临时收敛访问面的处置方法。",{"_49":74},"2026-11-25T05:15:00.000Z","2026-11-25T17:19:08.897Z",[223,224,245,246,263,346],"aqi1nz4ggvbuv6km3ay0a86i3c","2026-11-25T12:20:42.843Z",{"_160":365,"_32":366,"_163":367,"_165":368,"_167":369,"_169":370,"_171":363,"_14":220,"_173":371,"_175":259,"_177":178,"_12":179,"_180":-5},"qi1nz4ggvbuv6km3ay0a86i3c","CISA 将 Idunno AntiCsrf、Drupal Core 和 Optimizely Web Experimentation 漏洞加入 KEV","Idunno AntiCsrf 的 CVE-2026-131914、Drupal Core 的 CVE-2026-132165、Optimizely Web Experimentation 的 CVE-2026-132224 已被用于真实攻击，CISA 于 November 24, 2026 将其加入 KEV。","三项漏洞均已被用于真实攻击，文章同时给出利用条件、受影响版本、修复状态和替换建议，便于机构评估处置优先级。",{"_49":373},"2026-11-25T11:46:54.000Z",[225,223,224,316,372,247],"网络设备","Security Affairs","f2240","2026-11-25T14:16:36.088Z",{"_160":377,"_32":378,"_163":379,"_165":380,"_167":381,"_169":382,"_171":375,"_14":220,"_173":383,"_175":222,"_177":178,"_12":179,"_180":-5},"oj83edqa4usiy96xx2b05qcus","GeoServer 未认证远程代码执行漏洞 CVE-2026-129242 等 5 个 CVE 已复现","长亭安全应急响应中心已复现 GeoServer 未认证远程代码执行风险，未认证攻击者可利用默认配置中的 5 处缺陷读取安全配置、伪造管理员会话并执行任意命令。","文章完整拆解五处缺陷组成的无认证利用链，并给出复现状态、影响版本与升级建议，便于评估 GeoServer 暴露风险。",{"_49":75},"2026-11-24T13:25:00.000Z",[223,245,246,263,244,316,384],"长亭","av7rw6jgl1dq4frh6qblha9zp8","2026-11-25T14:21:36.799Z",{"_160":388,"_32":389,"_163":390,"_165":391,"_167":392,"_169":393,"_171":386,"_14":220,"_173":394,"_175":275,"_177":178,"_12":179,"_180":-5},"v7rw6jgl1dq4frh6qblha9zp8","攻击者已在利用 GeoServer 两个漏洞 CVE-2026-120705 与 CVE-2026-129243 构建未认证 RCE 链","watchTowr 称攻击者正利用 GeoServer 的 CVE-2026-120705 与 CVE-2026-129243 探测可利用目标，两者 CVSS 分数分别为 8.6 和 8.8，前者可读取本地文本文件或抓取指定 HTTP 或 HTTPS URL，后者可绕过服务安全规则调用受保护的 OWS 操作。","文章结合利用链拆解说明攻击者如何绕过校验、伪造管理员身份并执行代码，读者可据此核对受影响版本和处置优先级。",{"_49":57},"2026-11-25T12:48:54.000Z",[223,225,224,263,246],"akfvyqs51ezpiyu7h7efgz0fzy","2026-11-25T15:21:33.893Z",{"_160":398,"_32":399,"_163":400,"_165":401,"_167":402,"_169":403,"_171":396,"_14":172,"_173":404,"_175":176,"_177":178,"_12":179,"_180":-5},"kfvyqs51ezpiyu7h7efgz0fzy","InfraTrust 报告基础设施产品供应链漏洞在野利用情况","Eclypsium 11 月 InfraTrust 报告称，10 月 15 日至 11 月 19 日发布的 373 条公告覆盖 3,880 个漏洞，其中 38 条涉及 CISA KEV 漏洞，33 条实际来自 PHP、Node.js、OpenSSH 等第三方捆绑组件。","报告汇总基础设施产品中的在野利用，并指出上游组件修复到厂商产品重建之间存在处置窗口，便于评估补丁优先级与暴露风险。",{"_49":88},"2026-11-25T15:00:00.000Z",[181,225,316,346,344],"aok6098ql8nqs69svq8tvt7hwa","2026-11-25T20:20:19.306Z",{"_160":408,"_32":409,"_163":410,"_165":411,"_167":412,"_169":413,"_171":406,"_14":257,"_173":414,"_175":222,"_177":178,"_12":179,"_180":-5},"ok6098ql8nqs69svq8tvt7hwa","Italy 与 Switzerland 报告 AI Agent 驱动的大规模网络攻击","Italy 与 Switzerland 警告 AI Agent 已被用于针对关键基础设施组织的自动化网络攻击。CSIRT Italia 观察到多个 Agent 并行工作，在数小时内入侵大量暴露端点；其中一个 DeepSeek Harness 案例由协调器向 5 个 Agent 分配任务，串联漏洞、配置错误和被盗凭据进入内网，并实时编写恶意代码规避端点防护。","两国的实际事件展示了 AI Agent 并行识别弱点、串联利用链并自动生成恶意代码的作战方式，防守重点与攻击路径具有直接参考价值。",{"_49":88},"2026-11-25T19:39:31.000Z",[260,261,181,225,415,246],"红队","f2271","2026-11-25T21:28:26.674Z",{"_160":419,"_32":420,"_163":421,"_165":422,"_167":423,"_169":424,"_171":417,"_14":172,"_173":425,"_175":426,"_177":178,"_12":179,"_180":-5},"g8d9n283yuss2oehfy8yjtcgw","瑞士确认首起由 AI Agent 辅助的网络攻击，关键基础设施受影响","瑞士 NCSC 确认其首次收到由 AI Agent 辅助实施的网络攻击报告，至少两个行业的多个组织和关键基础设施运营商受到影响，已知攻击均成功攻陷目标系统。攻击者使用 Agentic Offensive Frameworks，让 Agent 搜索已知漏洞、选择工具、评估结果并决定下一步，主要针对弱口令、软件已知缺陷和互联网暴露系统。","材料展示了 AI Agent 加速传统攻击并成功入侵关键基础设施的实例，同时给出暴露面收敛、MFA、最小权限和 24 小时补丁要求。",{"_49":373},"2026-11-25T21:06:55.000Z",[181,260,261,225],83,"aiihzlri9yx0ljdqwxqduljzdy","2026-11-25T22:20:18.705Z",{"_160":430,"_32":431,"_163":432,"_165":433,"_167":434,"_169":435,"_171":428,"_14":220,"_173":436,"_175":437,"_177":178,"_12":179,"_180":-5},"iihzlri9yx0ljdqwxqduljzdy","Palo Alto Networks 确认 Fragnesia 漏洞 CVE-2026-46300 已用于攻击 PAN-OS 设备","Palo Alto Networks 通报 CVE-2026-46300（Fragnesia，Linux 内核 XFRM ESP-in-TCP 子系统漏洞）已被用于攻击将管理接口暴露在公网的 PAN-OS 设备，攻击者需先获得低权限本地访问权限方可提权至 root。","厂商确认 CVE-2026-46300 已被用于攻击暴露在公网管理接口的 PAN-OS 设备，并给出受影响版本与修复分支。",{"_49":88},"2026-11-25T22:05:09.000Z",[225,223,224,226,316,187,247],81,"f2273","2026-11-25T22:20:18.715Z",{"_160":441,"_32":442,"_163":443,"_165":444,"_167":445,"_169":446,"_171":439,"_14":172,"_173":447,"_175":448,"_177":178,"_12":179,"_180":-5},"vhwe2fax4m9ymu05rbldf674y","1Password 员工 GitHub 账号遭入侵，攻击者窃取客户数据","1Password 披露，一名员工的 corporate GitHub 账号被攻破后，攻击者访问私有源码仓库并向后端服务注入恶意代码，下载客户账户记录及内部源码。","事件披露了企业 GitHub 账号被攻破后向 CI/CD 注入恶意代码的完整链路，并列明被窃字段及后续处置。",{"_49":88},"2026-11-25T21:33:33.000Z",[181,317,316,329,415],72,{"_450":451,"_452":-5},"changelogVersion","2026-10-01T08:00","release"]
