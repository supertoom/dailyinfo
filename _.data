dia/ef2b2b57fb06e54f.webp","/dailyinfo/media/2adef5b1e4357a03.webp 48w, /dailyinfo/media/ef2b2b57fb06e54f.webp 96w",1,"FBI归因TraderTraitor窃取Binance资产",27.6,"6ef2ec24-f871-4ca2-9cc2-5fcbd249af24","uu0z6mo1muhhj4bo1sst643w9",[85,86,87,88],{"_47":55,"_49":50,"_51":56,"_53":57},{"_47":76,"_49":50,"_51":77,"_53":78},{"_47":66,"_49":50,"_51":67,"_53":68},{"_47":48,"_49":50,"_51":52,"_53":54},"2026-11-02","2026-11-01","2026-10-31",12,"2026-10-30",33,{"_115":413,"_117":414,"_119":415,"_121":-5},{"_115":396,"_117":397,"_119":398,"_121":399},{"_115":382,"_117":383,"_119":384,"_121":-5},{"_115":366,"_117":367,"_119":368,"_121":369},{"_115":350,"_117":351,"_119":352,"_121":353},{"_115":338,"_117":339,"_119":340,"_121":-5},{"_115":324,"_117":325,"_119":326,"_121":-5},{"_115":313,"_117":314,"_119":315,"_121":-5},{"_115":301,"_117":302,"_119":303,"_121":-5},{"_115":290,"_117":291,"_119":292,"_121":-5},{"_115":273,"_117":274,"_119":275,"_121":276},{"_115":261,"_117":262,"_119":263,"_121":-5},{"_115":248,"_117":249,"_119":250,"_121":-5},{"_115":233,"_117":234,"_119":235,"_121":-5},{"_115":222,"_117":223,"_119":224,"_121":-5},{"_115":200,"_117":201,"_119":202,"_121":203},{"_115":183,"_117":184,"_119":185,"_121":-5},{"_115":170,"_117":171,"_119":172,"_121":-5},{"_115":152,"_117":153,"_119":154,"_121":-5},{"_115":116,"_117":118,"_119":120,"_121":-5},"key","ai69hsuz0z7mgyzky44x947ilf","anchorAt","2026-10-30T14:00:00.000Z","item",{"_122":123,"_31":124,"_125":126,"_127":128,"_129":130,"_131":118,"_132":118,"_14":133,"_134":135,"_136":137,"_138":139,"_12":140,"_141":-5},"group","id","i69hsuz0z7mgyzky44x947ilf","Google Cloud 披露 ARTEX 等自主攻击框架已在真实入侵中被使用","summary","Google Threat Intelligence Group 与 Mandiant 发现，威胁行动者自 late August 2026 起在真实入侵中使用 ARTEX、PentAGI、CAIRN 等多 Agent 渗透框架，自动执行侦察、横向移动、提权、数据窃取和持久化。","reason","文章以真实事件响应证据拆解 ARTEX、PentAGI 等自主攻击框架，并给出可落地的身份、控制面、行为检测防御层次。","source",{"_47":151},"publishedAt","timelineAt","ai-security","tags",[142,143,144,145,146,147,148,149,150],"score",82,"selected",true,"news","x","AI 安全","Agent 安全","AI 攻防","攻击活动","恶意软件","检测工程","Google","Microsoft","AWS","Google Cloud 威胁情报","f343","2026-10-30T14:45:15.982Z",{"_122":155,"_31":156,"_125":157,"_127":158,"_129":159,"_131":160,"_132":153,"_14":161,"_134":162,"_136":163,"_138":139,"_12":140,"_141":-5},"kh5zbp42tkmy1pgddvyma6sb0","zkLink 遭攻击损失约 78.3 万美元，Arbitrator 合约验证逻辑被绕过","跨链协议 zkLink 于 2026 年 10 月 29 日遭攻击，损失约 78.3 万美元。","文章拆解了伪造批次根、复用瞬态存储与绕过提现证明的完整攻击链，并给出可迁移到同类跨链中继项目的代码审查要点。",{"_47":169},"2026-10-30T11:20:00.000Z","activity",[145,164,165,166,167,168],81,"在野利用","漏洞利用","利用链","加密","数据窃取","慢雾科技","f338","2026-10-30T14:45:16.526Z",{"_122":173,"_31":174,"_125":175,"_127":176,"_129":177,"_131":178,"_132":171,"_14":161,"_134":179,"_136":180,"_138":139,"_12":140,"_141":-5},"lponhstdrxji23aq6ua7qhae7","币安疑遭黑客攻击，被盗资产或超420亿元","币安披露潜在安全事件，称截至10月30日已冻结资金总额约30亿美元，并承担全部黑客攻击损失。Arkham首席执行官MiguelMorel表示，数十亿美元资产疑被身份不明的攻击者盗取，但具体原因尚未确认；此前相关钱包出现异常资金转出。","事件涉及加密资产交易所的资金转出与多机构冻结，冻结金额和处置状态有助于评估资金流向及影响范围。",{"_47":182},"2026-10-30T10:23:00.000Z",[145,168,167,181],77,"凭据","安全内参","f344","2026-10-30T15:47:58.920Z",{"_122":186,"_31":187,"_125":188,"_127":189,"_129":190,"_131":191,"_132":184,"_14":192,"_134":193,"_136":194,"_138":139,"_12":140,"_141":-5},"kqta6ndk8fh7dpovusz5qldoh","Linux kernel TCP UAF 漏洞 CVE-2026-98432 复现与利用链分析","微步情报局已复现 Linux kernel IPv4 TCP UAF 漏洞 CVE-2026-98432。该缺陷位于 IPv4 TCP 三次握手中请求套接字 IP 选项的移交与释放路径，攻击者无须认证或特殊配置，但须在微秒级窗口内赢得竞态并多次尝试；公开 RCE 利用链要求目标开启 Multipath TCP 监听，宿主机直接暴露 TCP 端口时可能导致内核崩溃。","原文披露了竞态触发路径、PoC 复现条件和各稳定分支修复版本，可用于评估暴露端口的崩溃风险与升级优先级。",{"_47":199},"2026-10-30T08:39:00.000Z","disclosure",[195,196,166,197,198,149],78,"复现","漏洞分析","内核","补丁","微步在线研究响应中心","f348","2026-10-30T16:55:17.885Z",{"_122":210,"_31":212,"_125":213,"_127":214,"_129":215,"_131":216,"_132":217,"_14":218,"_134":219,"_136":220,"_138":139,"_12":140,"_141":-5},{"_204":205,"_206":79,"_207":44,"_208":209},"factId","fdTinyCqJKbY","additionalSourceCount","reportCount","memberIds",[210,211],"ae96k4vyaf9n7mzfdlf9k8j1e","jhxeqjylpbk6sz9oaxw5mvo62","TeamViewer 远程支持漏洞 CVE-2026-111585 可在技术支持人员电脑上执行代码","TeamViewer 的屏幕解压组件存在 CVE-2026-111585，攻击者控制或攻陷被远程连接的设备后，可诱导技术支持人员接受连接，并在未打补丁的电脑上利用整数溢出与堆溢出执行攻击者代码。TeamViewer 于 2026 年 10 月 27 日发布 15.83 版本修复，该漏洞 CVSS 为 8.8、等级为 High；官方未发现已被在野利用的证据，并建议用户更新至最新版本。","文章梳理了整数溢出导致堆溢出的完整利用链，并给出受影响版本、CVSS 评分与利用前提，便于技术团队评估远程支持终端风险。",{"_47":66},"2026-10-30T18:35:09.000Z","2026-10-30T20:47:17.391Z","vuln",[221,164,198,195,165,196],75,"漏洞","f349","2026-10-30T16:55:17.899Z",{"_122":225,"_31":226,"_125":227,"_127":228,"_129":229,"_131":230,"_132":223,"_14":218,"_134":231,"_136":232,"_138":139,"_12":140,"_141":-5},"zp0y7xwgmp4okzaui4wl99q77","WordPress Core RCE 漏洞在 24 小时内招致 62,969 次攻击尝试","WordPress Core 4.7 至 7.1.3 的 RCE 漏洞已被用于攻击尝试，Wordfence 在 24 小时内拦截 62,969 次攻击。该漏洞尚无 CVE 编号，CVSS 为 8.1，依靠完整升级包解压时位于 wp-content/upgrade 的可预测暂存目录形成竞争窗口，未认证攻击者在恰当时机请求安装程序即可推进至 PHP 代码执行。","材料给出攻击请求量、受影响版本和竞争条件窗口，便于站点管理员判断升级与排查的紧迫程度。",{"_47":48},"2026-10-30T14:08:14.000Z",[221,164,198],80,"f350","2026-10-30T17:45:15.060Z",{"_122":236,"_31":237,"_125":238,"_127":239,"_129":240,"_131":241,"_132":234,"_14":161,"_134":242,"_136":180,"_138":139,"_12":140,"_141":-5},"ashq9zaym8iojmnulqhy7xxeb","Cloudflare披露eMudhra弱密钥证书利用迹象与访客补丁进度","eMudhra的8个弱中间CA私钥可由公开证书近乎即时恢复，攻击者已在密钥公开后数小时内伪造证书。Cloudflare发现约22,000次使用弱密钥的TLS握手尝试，其中约160次证书SAN指向无关组织域名，但没有证据表明弱密钥被用于拦截Cloudflare连接。","Cloudflare披露了弱密钥证书的利用迹象、Cloudflare自身修复进度及访客兼容性数据，便于评估残留风险与处置需求。",{"_47":247},"2026-10-30T17:38:50.000Z",[164,145,167,243,244,245,246],"漏洞管理","加固","Cloudflare","Mozilla","Cloudflare Blog","f352","2026-10-30T17:45:18.329Z",{"_122":251,"_31":252,"_125":253,"_127":254,"_129":255,"_131":256,"_132":249,"_14":218,"_134":257,"_136":258,"_138":139,"_12":140,"_141":-5},"s5wtznsv3satv8meiqmvkzkq3","joserfc 1.7.4 JWE recipients 无界数组引发 CPU 耗尽","joserfc 1.7.4 的 `joserfc.jwe.decrypt_json()` 未限制 JWE General JSON 的 `recipients` 数量，每个条目都会触发一次 RSA 私钥解密，未认证攻击者可借较小请求放大服务端 CPU 开销。","文章通过源码调用链和容器化 PoC 展示了无界 recipients 数组放大 RSA 解密开销的机制，便于评估服务暴露条件与缓解效果。",{"_47":260},"2026-10-30T14:54:20.000Z",[221,195,165,259],70,"技术研究","GitHub 安全公告","f355","2026-10-30T17:48:15.917Z",{"_122":264,"_31":265,"_125":266,"_127":267,"_129":268,"_131":269,"_132":262,"_14":192,"_134":270,"_136":180,"_138":139,"_12":140,"_141":-5},"els1gzklnlhxhh0k15ljle1lp","Rapid7 分析 BeyondTrust Remote Support 未认证文件上传至 RCE 漏洞 CVE-2026-102764","Rapid7 分析 BeyondTrust Remote Support 的来源校验缺陷 CVE-2026-102764，未认证攻击者可伪造本地消息来源，访问原生文件传输服务，写入任意文件并以站点操作系统用户身份执行代码，无需账户凭据或用户交互。","文章从消息来源伪造到文件写入、PHP 执行逐段拆解利用链，并给出 Metasploit 模块与多类日志的排查要点，便于安全团队理解和检测该风险。",{"_47":272},"2026-10-30T16:01:53.000Z",[259,196,195,165,166,271],"Rapid7","Rapid7 CVE 公告","f356","2026-10-30T18:57:15.938Z",{"_122":280,"_31":281,"_125":282,"_127":283,"_129":284,"_131":285,"_132":274,"_14":218,"_134":286,"_136":258,"_138":139,"_12":140,"_141":-5},{"_204":277,"_206":79,"_207":44,"_208":278},"fHtxLTvYwTdg",[279,280],"y99tzoeuwzoi070f2rfcc5ru1","m2hxnar81fkukx8bj4wepsqav","CISA 将两项 Ivanti Connect Secure 漏洞纳入 KEV Catalog","CISA 基于真实利用证据，将 Ivanti Connect Secure 的 CVE-2026-111357（关键功能缺失认证）和 CVE-2026-118527（可预测数字或标识符生成漏洞）纳入 KEV Catalog。","两项 Ivanti Connect Secure 漏洞已有真实利用证据，并被纳入 KEV Catalog，读者可据此核对资产暴露与修复优先级。",{"_47":289},"2026-10-30T12:00:00.000Z",[164,243,198,287,288],"Ivanti","CISA","CISA 安全公告","avlrtoue70s86b9kd5x4xc1iep","2026-10-30T21:50:19.239Z",{"_122":293,"_31":294,"_125":295,"_127":296,"_129":297,"_131":298,"_132":291,"_14":218,"_134":299,"_136":232,"_138":139,"_12":140,"_141":-5},"vlrtoue70s86b9kd5x4xc1iep","CISA 将 GitLab CVE-2026-97229 与 Cisco CVE-2026-76418 加入 KEV 目录","CISA 将 GitLab 与 Cisco 的 2 个漏洞加入 KEV 目录，并要求 FCEB 机构在 2026 年 11 月 1 日前完成处置。","材料同时给出漏洞利用前提、受影响版本和真实攻击迹象，可用于判断 GitLab 与 Cisco 设备是否需要优先处置。",{"_47":76},"2026-10-30T20:25:14.000Z",[221,164,198,243,300,288],"Cisco","f386","2026-10-30T23:34:14.742Z",{"_122":304,"_31":305,"_125":306,"_127":307,"_129":308,"_131":309,"_132":302,"_14":218,"_134":310,"_136":311,"_138":139,"_12":140,"_141":-5},"bgct23sln3v94uqcpsqtd9kwd","@hapi/content 6.0.2 及更早版本 Content-Disposition 解析可导致拒绝服务","@hapi/content 的 Content.disposition() 在解析缺少“=”的长 Content-Disposition 参数时呈二次时间复杂度，未认证攻击者可用单个 multipart/form-data 上传请求阻塞 Node.js 事件循环数秒至数分钟。","原文给出了可运行的 PoC、不同令牌长度下的阻塞时长及升级前后对比，便于评估 multipart 请求对 Node.js 服务可用性的影响。",{"_47":260},"2026-10-30T23:10:13.000Z",[221,195,165,312],72,"Node.js","f407","2026-10-31T06:08:16.553Z",{"_122":316,"_31":317,"_125":318,"_127":319,"_129":320,"_131":321,"_132":314,"_14":192,"_134":322,"_136":194,"_138":139,"_12":140,"_141":-5},"dovg5xscowbmox2u6l6m2s1lp","Parameter 揭示恶意 ChatGPT 分享链接代码执行漏洞利用链","Parameter 揭示恶意 ChatGPT 分享链接可在已登录会话中执行攻击者代码并读取私人对话，利用链经 MathLive 跨框架消息注入原始 HTML，再借助允许的 YouTube 脚本绕过 CSP。","文章拆解了恶意 ChatGPT 分享链接从跨框架消息到代码执行的完整链路，并说明修复版本与验证边界。",{"_47":48},"2026-10-31T05:33:41.000Z",[259,195,196,142,323,166,148],"大模型","f408","2026-10-31T08:59:15.589Z",{"_122":327,"_31":328,"_125":329,"_127":330,"_129":331,"_131":332,"_132":325,"_14":161,"_134":333,"_136":137,"_138":139,"_12":140,"_141":-5},"g1yjx90drqjyvf0az6cq04rgs","CNCERT 监测发现 VeilDHT 僵尸网络大范围感染 Linux 服务器与 IoT 设备","CNCERT 监测发现新型僵尸网络 VeilDHT 正通过漏洞利用大范围传播，主要感染 Linux 服务器与 IoT 设备，2026年10月16日至26日境内累计感染40467台，日上线肉鸡最高15805台。","材料给出了感染规模、利用漏洞、控制通道和完整 IoC，可用于识别感染链路并制定封禁与清理措施。",{"_47":337},"2026-10-30T11:59:00.000Z",[145,334,146,164,335,336],"僵尸网络","IoT","CNCERT","国家互联网应急中心CNCERT","f412","2026-10-31T12:02:30.138Z",{"_122":341,"_31":342,"_125":343,"_127":344,"_129":345,"_131":346,"_132":339,"_14":161,"_134":347,"_136":220,"_138":139,"_12":140,"_141":-5},"l8c38b2h5meavjepjvszce1ro","VOLTA-AUTODOXER 利用 LLM 对窃取数据进行受害者价值评估","Cisco Talos 分析了自删除型 Windows 信息窃取程序 VOLTA-AUTODOXER：它采集浏览器凭据、会话、支付卡、加密钱包种子、OAuth 令牌、云端密钥、Wi-Fi 密码及截图后，将结构化证据发送至 OpenRouter，由 LLM 生成包含“WHAT THEY'RE WORTH”和“THEIR OPSEC”的受害者评估。","文章拆解了 VOLTA 将 LLM 接入受害者筛选流程的方式，并给出模型拒绝时的回退链与事件响应处置要点。",{"_47":349},"2026-10-31T12:00:00.000Z",[145,146,144,168,323,181,148,149,246,348],"Oracle","Cisco Talos","f413","2026-10-31T13:02:30.480Z",{"_122":356,"_31":358,"_125":359,"_127":360,"_129":361,"_131":362,"_132":351,"_14":161,"_134":363,"_136":194,"_138":139,"_12":140,"_141":-5},{"_204":354,"_206":79,"_207":44,"_208":355},"fWnIQuGAfSM0",[356,357],"rvzo6jnjpnoo4hypna7k8fk0f","wzjcsrijtimb18s48r4hgz18b","群晖NAS设备遭C3RB3R勒索攻击，官方建议更新至安全版本","国内外多起群晖（Synology）NAS勒索攻击已被报告，部分设备文件被加密并添加.L0CK3D后缀，出现read-me3.txt勒索信，攻击被认为与C3RB3R（Cerber）勒索软件有关。","多地用户报告群晖NAS遭勒索加密，官方已关联到旧版系统漏洞并给出更新、隔离和备份建议。",{"_47":182},"2026-10-31T00:09:00.000Z",[145,364,146,164,365,243],"勒索","网络设备","f416","2026-10-31T16:16:29.716Z",{"_122":72,"_31":373,"_125":374,"_127":375,"_129":376,"_131":377,"_132":378,"_14":192,"_134":379,"_136":380,"_138":139,"_12":140,"_141":-5},{"_204":370,"_206":79,"_207":44,"_208":371},"fafTcIRBwfko",[72,372],"midioamfhtgq777zsyrovhu36","Android SMS of Death 漏洞分析：CVE-2026-58882 可用零点击 WAP Push 消息阻断电话服务","独立研究员 Mark Blaszczyk 披露 Android 的 SMS of Death 漏洞 CVE-2026-58882，攻击者仅需发送一条特制 WAP Push 消息即可零点击触发崩溃，阻断电话及紧急呼叫。","文章拆解了零点击 WAP Push 消息触发电话服务崩溃的原理、复现效果与修复范围，便于评估旧款 Android 设备的暴露风险。",{"_47":76},"2026-11-01T12:16:50.000Z","2026-11-01T13:26:34.091Z",[196,195,259,381,148],79,"移动端","f417","2026-10-31T18:18:14.404Z",{"_122":385,"_31":386,"_125":387,"_127":388,"_129":389,"_131":390,"_132":383,"_14":161,"_134":391,"_136":392,"_138":139,"_12":140,"_141":-5},"cyr7bz2bmyz5ecu55k6xo4e2y","Northflank 安全 breach 导致客户 AI API 密钥被滥用","Northflank 在安全 breach 后要求所有客户轮换平台内保存的环境变量、API 密钥及其他 secrets，并确认多名客户发现 AI API 密钥遭到未授权使用。","Northflank 事件展示了平台环境变量解密后，攻击者如何滥用客户 AI API 密钥，并给出明确的密钥轮换与用量核查建议。",{"_47":55},"2026-10-31T18:01:12.000Z",[145,393,181,394,395,323],71,"数据泄露","云原生","容器","f419","2026-11-01T08:31:32.784Z",{"_122":83,"_31":405,"_125":406,"_127":407,"_129":408,"_131":409,"_132":410,"_14":161,"_134":411,"_136":412,"_138":139,"_12":140,"_141":-5},{"_204":400,"_206":58,"_207":30,"_208":401},"f39FEvqrWazs",[402,403,83,404],"i65y8agid7mtlqotud98ny7rx","ajeln3eoz2hpbkktjxf74gmhw","soky2baypc752nl7uv0q0gsa7","FBI 将 Binance 63 亿美元加密资产窃取案归因于朝鲜 TraderTraitor","FBI 确认朝鲜国家支持的 TraderTraitor 实施了 Binance 加密资产窃取案，涉及 2026 年 10 月 29 日前后超过 $6 billion 的虚拟资产，攻击者通过入侵 DevOps 工程师笔记本进入服务容器并提交未授权提现交易。","原文披露了攻击入口、跨链资金流向、资产洗钱路径及公开地址，为加密交易所识别和拦截关联资金提供了具体依据。",{"_47":55},"2026-11-01T19:57:53.000Z","2026-11-01T20:43:31.348Z",[145,168,164,146],87,"f422","2026-11-02T03:38:37.417Z",{"_122":416,"_31":417,"_125":418,"_127":419,"_129":420,"_131":421,"_132":414,"_14":133,"_134":422,"_136":423,"_138":139,"_12":140,"_141":-5},"o24ucbtgopfr2yuihm7llam2f","LocalAlign 通过近目标对抗训练提升大语言模型提示注入防御泛化能力","LocalAlign 通过近目标对抗样本生成与 Margin-Aware Alignment 提升大语言模型的提示注入防御泛化能力，防御能力写入模型参数，推理时无需额外调用攻击检测模型。","论文将提示注入防御的泛化问题拆分为输入侧与目标侧，并用消融实验说明近目标生成和边际感知对齐各自的贡献。",{"_47":182},"2026-11-01T07:38:37.395Z",[142,424,425,143,323],74,"模型安全","论文",{"_427":428,"_429":-5},"changelogVersion","2026-10-01T08:00","release"]
