150":311,"_152":-5},{"_146":298,"_148":299,"_150":300,"_152":-5},{"_146":286,"_148":287,"_150":288,"_152":-5},{"_146":266,"_148":267,"_150":268,"_152":269},{"_146":255,"_148":256,"_150":257,"_152":-5},{"_146":245,"_148":246,"_150":247,"_152":-5},{"_146":232,"_148":233,"_150":234,"_152":-5},{"_146":215,"_148":216,"_150":217,"_152":218},{"_146":198,"_148":199,"_150":200,"_152":-5},{"_146":180,"_148":181,"_150":182,"_152":-5},{"_146":147,"_148":149,"_150":151,"_152":-5},"key","f1951","anchorAt","2026-11-20T14:43:29.457Z","item",{"_153":154,"_32":155,"_156":157,"_158":159,"_160":161,"_162":163,"_164":149,"_14":165,"_166":167,"_168":169,"_170":171,"_12":172,"_173":-5},"group","id","cxkvmlklv6c39ftnl61m71q1k","pREST _groupby 函数表达式 SQL 注入分析，CVE-2025-58450 修复不完整","summary","pREST 的 _groupby 函数表达式路径仍可触发 SQL 注入，构成 CVE-2025-58450 后续修复的不完整覆盖。作者以负向对照测试确认，isSafeSQLExpression 会错误接受 4 类包含 UNION、子查询或 pg_sleep 的 Payload，并由 GroupByClause 原样拼接执行；默认配置下仅需表读取权限，可能无需认证。","reason","作者通过代码路径审计与负向对照定位了修复覆盖缺口，并区分了已验证的 SQL 注入与 DoS 原语及尚未验证的数据外泄。","source",{"_48":179},"publishedAt","2026-11-20T14:41:42.000Z","timelineAt","disclosure","tags",[174,175,176,177,178],"score",70,"selected",true,"news","x","漏洞分析","复现","漏洞利用","数据库","供应链","GitHub 安全公告","f1974","2026-11-20T15:21:30.821Z",{"_153":183,"_32":184,"_156":185,"_158":186,"_160":187,"_162":188,"_164":181,"_14":189,"_166":190,"_168":191,"_170":171,"_12":172,"_173":-5},"nzpbt56ivpfcejp2mk6oqnujs","Microsoft Outlook 欺骗漏洞 CVE-2026-124194 已复现并遭在野利用","Microsoft Outlook 欺骗漏洞 CVE-2026-124194 已遭在野利用，攻击者可投递特制 .ics 日历文件诱使用户打开或导入，借此向攻击者控制的网络位置发起认证并泄露当前用户的 NTLMv2 响应；利用可远程触发，无需权限，但需要用户配合。","文章给出可复现的 .ics 触发链、已捕获的在野利用行为及出站 SMB 缓解措施，便于评估凭据泄露风险并安排处置。",{"_48":197},"2026-11-19T17:06:00.000Z","vuln",[192,193,175,194,195,196],84,"漏洞","在野利用","补丁","邮件安全","Microsoft","微步在线研究响应中心","f1977","2026-11-20T16:00:29.101Z",{"_153":201,"_32":202,"_156":203,"_158":204,"_160":205,"_162":206,"_164":199,"_14":207,"_166":208,"_168":209,"_170":171,"_12":172,"_173":-5},"hikp8skmkm0icifdlk2ddmxo6","n0n 勒索 Qubole 后声称泄露 Chase、Visa 和 Mastercard 客户数据","n0n 勒索组织声称攻击云数据分析公司 Qubole，并在 2026 年 10 月 14 日至 26 日间利用已泄露的 Qubole 凭据，经客户配置的 IAM roles 入侵 AWS 环境，窃取 53.9 GB、30,743 个文件，并声称掌握近 1 PB 客户网络数据。","文章串联第三方服务商遭勒索攻击与支付机构数据暴露，并区分营销信息泄露与支付网络未受影响，便于判断实际风险边界。",{"_48":112},"2026-11-20T15:58:06.000Z","activity",[210,211,212,178,213,214],80,"攻击活动","数据泄露","勒索","云原生","AWS","f1985","2026-11-20T17:23:31.412Z",{"_153":61,"_32":225,"_156":226,"_158":227,"_160":228,"_162":229,"_164":216,"_14":189,"_166":230,"_168":231,"_170":171,"_12":172,"_173":-5},{"_219":220,"_221":102,"_222":45,"_223":224},"factId","f6WA2ackQ-jM","additionalSourceCount","reportCount","memberIds",[61],"Ruby 字符串大小写转换堆越界写入漏洞 CVE-2026-132825 存在 RCE 风险","Ruby 字符串大小写转换函数存在堆缓冲区越界写入漏洞（CVE-2026-132825），影响 Ruby < 3.3.14、Ruby 3.4.0 - 3.4.12 和 Ruby 4.0.0 - 4.0.9，威胁等级为高危。","文章解释了单字节编码下字符串大小写转换触发堆越界写入的成因，并列出受影响版本、利用前提与修复方案。",{"_48":71},"2026-11-20T09:49:00.000Z",[192,194,174],78,"f1986","2026-11-20T17:23:31.424Z",{"_153":235,"_32":236,"_156":237,"_158":238,"_160":239,"_162":229,"_164":233,"_14":189,"_166":240,"_168":241,"_170":171,"_12":172,"_173":-5},"sgciwtig86m8ho71b0h3a56f6","VMware vCenter 认证绕过漏洞 CVE-2026-123890 通告，官方已发布修复","深瞳漏洞实验室于2026年11月20日发布漏洞通告，VMware vCenter 存在认证绕过漏洞 CVE-2026-123890，威胁等级为高危。","通告给出了逐版本的受影响区间、无需凭据即可建立管理员会话的利用条件，以及各版本可用的补丁与升级路径，便于读者快速判断自身资产是否受影响。",{"_48":71},[192,194,174,242,243,244],72,"身份与访问","VMware","深信服","ad8r57wa5dx4heczan7q6hz8i5","2026-11-20T17:23:31.436Z",{"_153":248,"_32":249,"_156":250,"_158":251,"_160":252,"_162":229,"_164":246,"_14":189,"_166":253,"_168":231,"_170":171,"_12":172,"_173":-5},"d8r57wa5dx4heczan7q6hz8i5","PHP 8.2至8.5系列曝出7个代码执行漏洞，官方已发布修复版本","深瞳漏洞实验室披露PHP组件7个严重代码执行漏洞，分别为CVE-2026-126714、CVE-2026-115560、CVE-2026-129289、CVE-2026-129474、CVE-2026-129496、CVE-2026-129182和CVE-2026-129481。","通告列出7个PHP代码执行漏洞的触发路径、影响版本和逐项缓解配置，便于安全团队核对资产并安排升级。",{"_48":71},[192,194,174,178,254,244],"PHP","f1987","2026-11-20T17:23:34.134Z",{"_153":258,"_32":259,"_156":260,"_158":261,"_160":262,"_162":263,"_164":256,"_14":189,"_166":264,"_168":265,"_170":171,"_12":172,"_173":-5},"ove2pi7map5xlnn8tjm9w03ev","PHP 远程代码执行漏洞 CVE-2026-126714 已公开并发布修复","PHP 远程代码执行漏洞 CVE-2026-126714（phpAfterShell）已被公开，CVSS 评分为 9.2。","通告列明受影响版本、会话处理器前提、临时缓解和修复版本，并提供人工与工具检测方法，便于评估和处置风险。",{"_48":70},"2026-11-20T03:35:00.000Z",[192,194,174,254],71,"f1990","2026-11-20T17:56:29.606Z",{"_153":106,"_32":275,"_156":276,"_158":277,"_160":278,"_162":279,"_164":267,"_14":207,"_166":280,"_168":191,"_170":171,"_12":172,"_173":-5},{"_219":270,"_221":63,"_222":57,"_223":271},"fVbDsNwWSOac",[106,272,273,274],"dcch6vrh267pbs79iv9qncpeu","l0ha7ysjw76syv06olmktwx96","yfjjmgqjkhh0q3y9eoj082rrw","攻击者利用自主 AI 工具 Cairn 攻陷 MONAI Label 漏洞并取得服务器权限","Amazon Threat Intelligence 发现疑似中国关联攻击者使用自主 AI Agent 平台 Cairn，于 2026 年 9 月 8 日至 10 日攻击中国境外东亚教育机构。","材料展示了 AI Agent 自主发现并利用漏洞的完整链路，以及失败尝试和修复时间，便于评估防御响应压力。",{"_48":112},"2026-11-20T17:30:00.000Z",[210,281,193,176,282,283,214,284,285],"AI 攻防","大模型","Agent 安全","Google","CISA","asjin4pr8q1dp00z0igue1371g","2026-11-20T19:32:29.280Z",{"_153":289,"_32":290,"_156":291,"_158":292,"_160":293,"_162":294,"_164":287,"_14":189,"_166":295,"_168":265,"_170":171,"_12":172,"_173":-5},"sjin4pr8q1dp00z0igue1371g","CISA将4个漏洞纳入KEV Catalog，均有真实利用证据","CISA将CVE-2025-42884、CVE-2026-76466、CVE-2026-123890和CVE-2026-129448纳入KEV Catalog，依据是这些漏洞已有在野利用证据，分别涉及SAP NetWeaver、Cisco Expressway Series、VMWare vCenter和Apache Roller。","CISA依据真实利用证据将4个漏洞纳入KEV Catalog，并明确联邦机构应优先修复暴露资产上的相关缺陷。",{"_48":297},"2026-11-20T12:00:00.000Z",[193,296,194,285,243],"漏洞管理","CISA 安全公告","f1996","2026-11-20T20:32:32.974Z",{"_153":301,"_32":302,"_156":303,"_158":304,"_160":305,"_162":306,"_164":299,"_14":189,"_166":307,"_168":231,"_170":171,"_12":172,"_173":-5},"jszry2ckucax402ve9a7rmc3m","Cloudflare WAF 防护 ruby2shell 漏洞 CVE-2026-132825 及 GHSA-87fm-7w84-j2px","Cloudflare WAF 已为 ruby2shell（CVE-2026-132825）及相关整数溢出 GHSA-87fm-7w84-j2px 启用默认阻断规则，Free 计划自动生效，付费计划需确认 Cloudflare Managed Ruleset 已部署。","文章同时说明漏洞触发条件、Cloudflare WAF 规则覆盖范围及绕过边界，为无法立即升级 Ruby 的团队提供临时防护与处置依据。",{"_48":67},"2026-11-20T20:24:38.000Z",[192,194,175,174,213,308],"Cloudflare","axc4re3fqbv7j3asqraazbq4h2","2026-11-20T20:32:32.984Z",{"_153":312,"_32":313,"_156":314,"_158":315,"_160":316,"_162":317,"_164":310,"_14":318,"_166":319,"_168":209,"_170":171,"_12":172,"_173":-5},"xc4re3fqbv7j3asqraazbq4h2","PHP phpAfterShell 远程代码执行漏洞 CVE-2026-126714 已修复，Cloudflare WAF 已更新检测","Cloudflare 介绍 PHP 默认文件会话处理器漏洞 phpAfterShell（CVE-2026-126714），该漏洞 CVSS v4.0 为 9.2 分，可因会话文件写入中断并在后续反序列化时导致远程代码执行。","文章梳理了 phpAfterShell 的触发原理、受影响版本与利用前提，并说明 Cloudflare WAF 规则、补丁和临时缓解措施。",{"_48":67},"2026-11-20T20:00:45.000Z","blue-team",[320,321,174,296,322,308,254],"工具发布","版本更新","加固","ab7fagpjz2rm06udejoz3syyf2","2026-11-20T20:33:30.286Z",{"_153":326,"_32":327,"_156":328,"_158":329,"_160":330,"_162":331,"_164":324,"_14":189,"_166":332,"_168":169,"_170":171,"_12":172,"_173":-5},"b7fagpjz2rm06udejoz3syyf2","Cisco 排查 nginx 远程代码执行漏洞对产品的影响","Cisco PSIRT 通报 nginx 1.9.5 至 1.31.8 存在多个可能导致远程代码执行的严重漏洞，已在 1.31.9 和 1.30.7 修复，涉及 CVE-2026-113425、CVE-2026-121810、CVE-2026-123007、CVE-2026-123633、CVE-2026-123634。","通告列明 nginx 多个漏洞的受影响版本、Cisco 产品排查状态和首批修复版本，便于相关用户核对暴露范围与升级路径。",{"_48":335},"2026-11-20T08:00:00.000Z",[192,194,175,333,334],"Cisco","网络设备","Cisco PSIRT","f1998","2026-11-20T21:31:31.492Z",{"_153":339,"_32":340,"_156":341,"_158":342,"_160":343,"_162":344,"_164":337,"_14":207,"_166":345,"_168":241,"_170":171,"_12":172,"_173":-5},"vt4gd1d2m0q2e5cxg60jzp1ja","GreenJuliett 将 AI 纳入 OT 攻击链并扩大 FortiGate 扫描范围","Recorded Future 观测到 GreenJuliett 将 AI 纳入 OT 攻击链，用于识别脆弱设备类型并编写针对 PLC 与工业协议的脚本。该组织在巴林、以色列、约旦、科威特、沙特阿拉伯和卡塔尔扫描或尝试利用 Fortinet FortiGate，并可能将 IoT 与 CCTV 设备纳入目标。","文章追踪了 GreenJuliett 将 AI 引入 OT 攻击链的迹象及其针对 PLC、FortiGate 和 IoT 设备的扩张路径。",{"_48":350},"2026-11-20T00:00:00.000Z",[210,346,281,347,348,349,284],"恶意软件","工控","IoT","Fortinet","Recorded Future","ay1q31smahyra1wu2i286xr7ey","2026-11-20T22:34:32.487Z",{"_153":354,"_32":355,"_156":356,"_158":357,"_160":358,"_162":359,"_164":352,"_14":207,"_166":360,"_168":361,"_170":171,"_12":172,"_173":-5},"y1q31smahyra1wu2i286xr7ey","Unit 42披露Com关联组织以语音钓鱼窃取数据并实施勒索","Unit 42追踪到Bling Libra及多个Com关联活动簇通过语音钓鱼和AiTM页面窃取凭据与MFA批准，随后借助原生云工具、脚本和恶意浏览器扩展定位高价值数据、批量外传并发送勒索信息。","材料结合遥测与事件响应还原了多组关联活动簇的入侵链、受害行业变化及恶意扩展能力，便于比较其数据窃取手法。",{"_48":364},"2026-11-20T22:00:25.000Z",[210,346,362,211,212,242,363,284,196],81,"钓鱼","Palo Alto","Unit 42","f2000","2026-11-20T23:47:29.940Z",{"_153":368,"_32":369,"_156":370,"_158":371,"_160":372,"_162":373,"_164":366,"_14":189,"_166":374,"_168":169,"_170":171,"_12":172,"_173":-5},"ql8z19mw87u0y7njlw1p4sq74","Contao core-bundle 漏洞分析：theme_import 权限可绕过 tpl_editor 限制实现 RCE","Contao core-bundle 存在权限提升漏洞，受委托的用户或用户组管理员可为自己或所管理的账户添加 theme_import 权限，进而在服务器上执行任意 PHP。","文章通过权限校验差异与 Contao 5.7.9 复现步骤，说明 theme_import 如何绕过 tpl_editor 的限制并形成服务器端代码执行链。",{"_48":179},"2026-11-20T23:45:41.000Z",[192,175,176,174],"ajbitkvf4i6iewvak8ejgx9cvb","2026-11-21T09:24:45.971Z",{"_153":378,"_32":379,"_156":380,"_158":381,"_160":382,"_162":383,"_164":376,"_14":189,"_166":384,"_168":385,"_170":171,"_12":172,"_173":-5},"jbitkvf4i6iewvak8ejgx9cvb","CISA 将 Apache Roller、Cisco Expressway、SAP NetWeaver 和 VMware vCenter 四项漏洞列入 KEV","CISA 将 Apache Roller、Cisco Expressway、SAP NetWeaver 和 VMware vCenter 的 4 个漏洞列入 KEV，依据是已发现活跃利用证据。","四条漏洞已进入 KEV，其中 Apache Roller、VMware vCenter 等已有利用线索，文中还给出了各漏洞的触发条件、修复时间与处置期限。",{"_48":53},"2026-11-21T08:49:13.000Z",[192,193,194,176,386,296,333,243,285],83,"数据窃取","f2018","2026-11-21T12:27:45.824Z",{"_153":390,"_32":391,"_156":392,"_158":393,"_160":394,"_162":395,"_164":388,"_14":165,"_166":396,"_168":265,"_170":171,"_12":172,"_173":-5},"dfh23lubzfof7rir61cxf0nq4","NebuSec 演示恶意网页劫持 Meta Muse 并读取私人聊天与记忆","NebuSec 演示恶意网页可绕过审批提示，从 Meta Muse 云端机器提取并篡改用户聊天记录与存储记忆，并结合内置浏览器和 Linux 内核缺陷取得机器控制权，访问凭据存储、保存文件及 Sentinel。攻击仅影响单台云端机器，未进入共享服务器或其他用户设备；研究为实验室演示，NebuSec 称所披露弱点均已修复，但 Meta 尚未公开确认，补丁发布前是否有用户数据被访问也未说明。","文章拆解了恶意网页经内置浏览器与 Linux 内核缺陷控制云端机器的攻击链，并说明影响边界与修复状态。",{"_48":53},"2026-11-21T11:53:07.000Z",[397,398,399,283,400,401],"技术研究","利用链","AI 安全","浏览器","内核","f2020","2026-11-21T16:09:45.367Z",{"_153":405,"_32":406,"_156":407,"_158":408,"_160":409,"_162":410,"_164":403,"_14":207,"_166":411,"_168":412,"_170":171,"_12":172,"_173":-5},"dbml5ujd9k2y3agezdbxfdnmx","BADBOX 3.0 botnet 回归，每日发起 40 亿次欺诈广告竞价请求","HUMAN 的 Satori 研究人员发现 BADBOX 3.0 通过受感染的 Android 设备每日发起约 40 billion 次欺诈广告竞价请求，峰值占其观察到的 CTV 流量的 4% 以上。","材料揭示 BADBOX 3.0 通过感染 Android 设备实施广告欺诈与流量代理，并给出请求规模、代理网络和历史处置数据。",{"_48":112},"2026-11-21T15:17:27.000Z",[210,346,413,414,348,284],73,"僵尸网络","移动端","f2021","2026-11-21T18:05:45.021Z",{"_153":418,"_32":419,"_156":420,"_158":421,"_160":422,"_162":423,"_164":416,"_14":207,"_166":424,"_168":425,"_170":171,"_12":172,"_173":-5},"lwn1awdsmrazlhsmt4r21vq0w","Microsoft Entra Connect Health 漏洞遭利用，租户数据被未授权访问","攻击者利用 Microsoft Entra Connect Health API 漏洞，未授权读取租户级元数据，并可能修改 Connect Health 监控配置。","事件提供了暴露数据类型、修复时间与客户无需更新的处置边界，也指出钓鱼风险和日志排查方向，便于受影响组织核对风险。",{"_48":112},"2026-11-21T18:01:58.000Z",[210,193,211,196,242,362],77,"f2023","2026-11-21T23:50:45.254Z",{"_153":429,"_32":430,"_156":431,"_158":432,"_160":433,"_162":434,"_164":427,"_14":207,"_166":435,"_168":241,"_170":171,"_12":172,"_173":-5},"iepvrh0cnji8gnmctayok0ho0","Rackspace Spot 云平台遭入侵，攻击者读取客户 Kubernetes Secrets","攻击者使用泄露凭据入侵 Rackspace Spot 云平台，在部分客户组织中以合法用户身份创建 Kubernetes Pod、读取 Secrets，并列出节点和卷，受害凭据可能包括密码、认证令牌、API 密钥及 Spot API 令牌。","原文给出入侵时间窗、攻击者权限、泄露凭据类型和完整 IOC，客户可据此回溯集群、数据库及第三方服务中的异常访问。",{"_48":112},"2026-11-21T22:59:58.000Z",[210,211,436,213,437,178],"凭据","容器",{"_439":440,"_441":-5},"changelogVersion","2026-10-01T08:00","release"]
