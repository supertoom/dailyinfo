ebp","/dailyinfo/media/47417cbef4636b7b.webp 48w, /dailyinfo/media/dd06beac4cadc6f3.webp 96w","Unit 42","/dailyinfo/media/4d373ddb2d54a219.webp","/dailyinfo/media/c5c35eb93d4d2e80.webp 48w, /dailyinfo/media/4d373ddb2d54a219.webp 96w","2026-11-18",12,"2026-11-17",15,{"_165":446,"_167":447,"_169":448,"_171":-5},{"_165":432,"_167":433,"_169":434,"_171":-5},{"_165":419,"_167":420,"_169":421,"_171":-5},{"_165":408,"_167":409,"_169":410,"_171":-5},{"_165":398,"_167":399,"_169":400,"_171":-5},{"_165":381,"_167":382,"_169":383,"_171":384},{"_165":368,"_167":369,"_169":370,"_171":-5},{"_165":354,"_167":355,"_169":356,"_171":-5},{"_165":341,"_167":342,"_169":343,"_171":-5},{"_165":330,"_167":331,"_169":332,"_171":-5},{"_165":320,"_167":321,"_169":322,"_171":-5},{"_165":308,"_167":309,"_169":310,"_171":-5},{"_165":297,"_167":298,"_169":299,"_171":-5},{"_165":284,"_167":285,"_169":286,"_171":-5},{"_165":269,"_167":270,"_169":271,"_171":-5},{"_165":249,"_167":250,"_169":251,"_171":252},{"_165":230,"_167":231,"_169":232,"_171":-5},{"_165":212,"_167":213,"_169":214,"_171":-5},{"_165":198,"_167":199,"_169":200,"_171":-5},{"_165":166,"_167":168,"_169":170,"_171":-5},"key","as1eozdkmwspk9y4hui1ujvnfi","anchorAt","2026-11-17T05:47:31.324Z","item",{"_172":173,"_32":174,"_175":176,"_177":178,"_179":180,"_181":182,"_183":168,"_14":184,"_185":186,"_187":188,"_189":190,"_12":191,"_192":-5},"group","id","s1eozdkmwspk9y4hui1ujvnfi","N-able 修复 N-central 17 个漏洞，既有漏洞已被用于部署加密货币矿工","summary","N-able 为 N-central 2026.4 Hotfix 3 修复 17 个安全漏洞，涉及本地权限提升、认证绕过、XML 外部实体注入、SSRF、路径遍历和 RCE 等问题。","reason","更新覆盖 17 个漏洞及既有漏洞的在野利用情况，并明确本地部署与 Agent、Probe 的处置要求，便于判断升级优先级。","source",{"_50":131},"publishedAt","2026-11-17T05:00:34.000Z","timelineAt","vuln","tags",[193,194,195,196,197],"score",78,"selected",true,"news","x","漏洞","补丁","在野利用","挖矿","漏洞管理","f1518","2026-11-17T06:42:31.317Z",{"_172":201,"_32":202,"_175":203,"_177":204,"_179":205,"_181":206,"_183":199,"_14":184,"_185":207,"_187":208,"_189":190,"_12":191,"_192":-5},"jzchu55e6wyzqizb1khip70u4","ConnectWise 警告 SCKit 持续攻击未修补的 ScreenConnect 环境","ConnectWise 表示，ScreenConnect 26.6.5 之前的客户端存在 CVSS 9.9 的漏洞 CVE-2026-84869，未禁用相关第三方扩展的本地部署仍在遭受攻击。","报道给出了持续攻击规模、恶意组件与持久化痕迹，并明确区分已检测活动和尚无证据的蠕虫传播结果。",{"_50":131},"2026-11-17T06:29:27.000Z",[193,195,194,209,210,211],84,"恶意软件","漏洞利用","供应链","f1527","2026-11-17T09:13:34.210Z",{"_172":215,"_32":216,"_175":217,"_177":218,"_179":219,"_181":220,"_183":213,"_14":221,"_185":222,"_187":223,"_189":190,"_12":191,"_192":-5},"r4z5g7d91a99mhhnox3pfjud6","LiteLLM MCP OAuth2 passthrough 认证绕过复现与分析","LiteLLM 1.84.0 之前存在 MCP OAuth2 passthrough 认证绕过，未认证攻击者携带任意 Authorization: Bearer 头且不带 x-litellm-api-key，即可获得有效会话并列举、调用网关聚合的 MCP 工具。","文章用可复现代码对比 1.83.6 与 1.84.0，并追踪认证失败被降级为有效会话的调用链，适合排查同类鉴权兜底设计。",{"_50":229},"2026-11-16T08:57:02.000Z","disclosure",[224,225,226,227,228],72,"技术研究","复现","漏洞分析","AI 安全","Agent 安全","先知社区","auhzyjjwx5bm5fi1uht55ekcqo","2026-11-17T09:35:30.521Z",{"_172":233,"_32":234,"_175":235,"_177":236,"_179":237,"_181":238,"_183":231,"_14":239,"_185":240,"_187":241,"_189":190,"_12":191,"_192":-5},"uhzyjjwx5bm5fi1uht55ekcqo","Google Threat Intelligence Group 发现 AI agent 无人操作即编写并发起漏洞利用","Google Threat Intelligence Group 与 Mandiant 披露，威胁行为者已让 AI agent 在入侵中独立完成部分环节：GTIG 在过去一个季度首次看到有攻击者用 LLM 框架在无人参与的情况下自动完成漏洞发现与利用。","GTIG 披露了攻击者用 AI agent 自动完成漏洞发现与利用的完整链条，还原了 staging 服务器上的多智能体框架配置细节，便于防守方理解机器速度攻击留下的痕迹。",{"_50":55},"2026-11-17T08:45:24.000Z","ai-security",[227,228,242,243,209,244,245,246,247,248],82,"AI 攻防","攻击活动","黑产","Google","Microsoft","CISA","PHP","f1530","2026-11-17T10:07:31.949Z",{"_172":87,"_32":260,"_175":261,"_177":262,"_179":263,"_181":264,"_183":250,"_14":184,"_185":265,"_187":266,"_189":190,"_12":191,"_192":-5},{"_253":254,"_255":114,"_256":101,"_257":258},"factId","fYCTACQi7QF0","additionalSourceCount","reportCount","memberIds",[87,259],"cjy398xarxe3ulspgsfb5e4we","奇安信 CERT 复现 LibreOffice 远程代码执行漏洞 CVE-2026-104692、CVE-2026-104007","奇安信 CERT 已复现 LibreOffice 远程代码执行漏洞 CVE-2026-104692、CVE-2026-104007，攻击者可通过特制 ODS 文档在用户打开时实现任意代码执行，无需宏警告或额外交互。","文章给出利用链、复现结果和明确版本区间，可据此识别高风险部署并确定升级或临时缓解范围。",{"_50":99},"2026-11-17T09:06:00.000Z",[193,225,210,194,267,268],79,"奇安信","数据库","f1541","2026-11-17T12:11:31.702Z",{"_172":272,"_32":273,"_175":274,"_177":275,"_179":276,"_181":277,"_183":270,"_14":278,"_185":279,"_187":280,"_189":190,"_12":191,"_192":-5},"gs8rcycdyebhht60u2ulltq7n","Kaspersky 披露 Operation ShadowCloud 利用 GitHub 和 SharePoint 部署 GitDoor、GraphDoor 后门","Kaspersky 披露 Operation ShadowCloud 在亚洲和非洲政府部门开展的网络入侵活动，利用合法 MeshAgent 植入此前未记录的 GitDoor 和 GraphDoor 后门，并通过 GitHub、Microsoft SharePoint 和 Ably 隐藏 C2 流量、动态下载插件和内存 shellcode。","材料拆解了攻击链、两种后门的通信与载荷机制，并列出可用于识别活动线索的路径、仓库和配置。",{"_50":131},"2026-11-17T11:20:18.000Z","activity",[243,281,209,246,245,282,283],77,"后门","数据窃取","Kaspersky","f1546","2026-11-17T13:06:32.310Z",{"_172":287,"_32":288,"_175":289,"_177":290,"_179":291,"_181":292,"_183":285,"_14":221,"_185":293,"_187":294,"_189":190,"_12":191,"_192":-5},"en85jqoawywbih6ciysura11w","Apple iOS 麦克风权限绕过漏洞 CVE-2026-65339 技术分析","研究人员披露 Apple 音频服务漏洞 CVE-2026-65339 的技术细节，应用可在用户拒绝麦克风权限后继续录音，部分测试版本的橙色麦克风指示灯不会亮起。","文章拆解了音频服务绕过 TCC 权限检查的原理、复现环境与补丁机制，适合移动端安全研究人员参考。",{"_50":131},"2026-11-17T12:14:36.000Z",[226,225,295,296],73,"移动端","Apple","f1561","2026-11-17T14:07:30.797Z",{"_172":300,"_32":301,"_175":302,"_177":303,"_179":304,"_181":305,"_183":298,"_14":278,"_185":306,"_187":307,"_189":190,"_12":191,"_192":-5},"tz4xdt33pmmjfiz82kro43q09","ConnectWise ScreenConnect 遭 CVE-2026-84869 在野利用，42 台 MSP 服务器受影响","攻击者正利用 ConnectWise ScreenConnect 的 CVE-2026-84869（CVSS 9.9）开展持续一个月以上的攻击，重点针对 MSP 服务器。","文章给出了持续时间、请求规模、受影响服务器数量及攻击链细节，可用于判断 ScreenConnect 部署是否处于活动扫描和入侵风险中。",{"_50":62},"2026-11-17T13:24:43.000Z",[243,195,210,209],83,"ag0z2h9egt3off5o39j4avh9cu","2026-11-17T16:20:31.846Z",{"_172":311,"_32":312,"_175":313,"_177":314,"_179":315,"_181":316,"_183":309,"_14":184,"_185":317,"_187":318,"_189":190,"_12":191,"_192":-5},"g0z2h9egt3off5o39j4avh9cu","Siemens 28 个工业软件产品受 Google Brotli 缓冲区溢出漏洞影响","Google Brotli 1.0.3 至 1.2.0 的解码器 c/dec/decode.c 存在缓冲区溢出漏洞，远程未认证攻击者可利用特制 Brotli 压缩流破坏内存、泄露敏感内容、导致拒绝服务，或可能执行任意代码。","公告列明 28 个受影响 Siemens 产品、CVSS v3.1 9.8 评分及可用的临时缓解措施，便于资产所有者判断处置需求。",{"_50":79},"2026-11-17T12:00:00.000Z",[193,194,319,245,247],81,"工控","f1586","2026-11-17T16:20:31.851Z",{"_172":323,"_32":324,"_175":325,"_177":326,"_179":327,"_181":316,"_183":321,"_14":184,"_185":328,"_187":329,"_189":190,"_12":191,"_192":-5},"fqo8gu0aw8gwmfm6rhttlqokf","Siemens 15 款工业自动化软件受 CVE-2026-111497 影响，CVSS 9.8","Siemens 15 款工业自动化软件受 Node.js Brotli 解码器越界写漏洞 CVE-2026-111497 影响，CVSS v3.1 为 9.8，远程未认证攻击者可造成内存破坏、敏感信息泄露、拒绝服务或潜在执行任意代码。","公告区分了已修复、暂无修复与不计划修复的产品，并给出 Brotli 更新版本和临时缓解措施，便于工控用户逐项评估处置路径。",{"_50":79},[193,194,319,211,247],74,"aj7nnva1vm6p3lhh17mhlx0wfn","2026-11-17T17:18:39.422Z",{"_172":333,"_32":334,"_175":335,"_177":336,"_179":337,"_181":338,"_183":331,"_14":278,"_185":339,"_187":241,"_189":190,"_12":191,"_192":-5},"j7nnva1vm6p3lhh17mhlx0wfn","FBI 披露 ARTEX AI 框架将攻击提权时间压缩至 3 小时以内","FBI 称，攻击者自 2026 年 8 月起使用开源 AI 框架 ARTEX 攻击全球金融服务、政府、科技、国防、医疗、半导体、能源、制造、电信和法律服务等行业，可借助多个 AI agents 自动完成目标发现、弱点检查、漏洞利用和数据外传，部分攻击在不到 3 小时内获得特权访问。","材料将 ARTEX 串联目标发现、漏洞利用和数据窃取的攻击链，与 ConnectWise 供应链入侵及登录尝试等实际事件相对应。",{"_50":135},"2026-11-17T16:51:49.000Z",[243,242,340,228,195,211,246,245,247],"大模型","f1593","2026-11-17T17:20:32.997Z",{"_172":344,"_32":345,"_175":346,"_177":347,"_179":348,"_181":349,"_183":342,"_14":239,"_185":350,"_187":351,"_189":190,"_12":191,"_192":-5},"f8ncv2a1cko0q6hhiockby3pz","Microsoft 揭示设备码钓鱼对 GitHub Copilot CLI 代理的四类影响","Microsoft 以 GitHub Copilot CLI 为例说明，攻击者诱使用户批准设备码授权后，可在实验环境中远程操控已启用远程控制的会话、植入误导性记忆、读取云同步会话及访问私有仓库。","受控实验揭示了设备码钓鱼接入 AI 编程代理后的四类风险，并给出可落地的检测、处置和权限收敛方法。",{"_50":112},"2026-11-17T15:00:00.000Z",[227,228,224,225,352,353,246,245],76,"钓鱼","检测工程","f1594","2026-11-17T17:21:40.036Z",{"_172":357,"_32":358,"_175":359,"_177":360,"_179":361,"_181":362,"_183":355,"_14":278,"_185":363,"_187":280,"_189":190,"_12":191,"_192":-5},"nzt95o0rx92hlv2bv6ms960qe","Google Cloud 披露 COLD RELIC 利用云身份连续入侵两起美国机构事件","Google Cloud 披露俄罗斯国家级组织 COLD RELIC 通过钓鱼、住宅代理和 MFA 疲劳攻击入侵两家美国机构，并利用前一家窃取的人员与关系数据冒充员工，攻击第二家的 Microsoft Entra ID。","案例串联了云身份滥用、跨组织冒充与数据外传链路，并给出可直接落地的会话撤销、代理检测和跨云监测思路。",{"_50":367},"2026-11-17T14:00:00.000Z",[243,352,209,364,281,365,245,246,366],"数据泄露","红队","AWS","Google Cloud 威胁情报","f1595","2026-11-17T18:49:31.533Z",{"_172":371,"_32":372,"_175":373,"_177":374,"_179":375,"_181":376,"_183":369,"_14":239,"_185":377,"_187":266,"_189":190,"_12":191,"_192":-5},"jk2xf7q2h1rx5r54g5jr1b34s","研究人员接管 Hugging Face 上 Kokoro 模型账户并演示模型投毒","研究人员因 Hugging Face 缺少发布者所有权验证，通过注册原所有者公开域名并重置密码接管 Kokoro 账户。团队在本地通过修改模型权重，使相同输入文本生成与原文不一致的音频，87 秒即可完成，且未改动推理代码、上传恶意代码或改变发布者外观。","研究者通过接管模型发布账户并修改权重，展示了开放模型供应链中不依赖恶意代码的攻击路径。",{"_50":65},"2026-11-17T18:21:24.000Z",[227,378,379,224,380,245,366],"模型安全","AI 供应链","供应链投毒","f1596","2026-11-17T19:22:35.270Z",{"_172":73,"_32":387,"_175":388,"_177":389,"_179":390,"_181":391,"_183":392,"_14":184,"_185":393,"_187":394,"_189":190,"_12":191,"_192":-5},{"_253":385,"_255":114,"_256":101,"_257":386},"f8X9-lkLyK9M",[73],"OpenJDK Java4Shell 漏洞 CVE-2026-114938 可导致 RCE，Oracle 已发布补丁","OpenJDK 的 Java4Shell 漏洞 CVE-2026-114938 可被未认证攻击者用于 RCE，并可能泄露内存敏感信息。该内存破坏缺陷影响 OpenJDK 17.0.6 及之后版本，Calif 评为 CVSS 4.0 9.2，Oracle 评为 CVSS 3.1 8.1（High）。","原文覆盖受影响版本、利用前提、PoC、补丁和临时缓解措施，便于安全团队评估 OpenJDK 暴露面并安排处置。",{"_50":65},"2026-11-17T23:04:21.000Z","2026-11-17T23:22:32.039Z",[193,225,210,195,194,224,395,396,366,246,397],92,"Oracle","Red Hat","Atlassian","f1597","2026-11-17T19:31:32.155Z",{"_172":401,"_32":402,"_175":403,"_177":404,"_179":405,"_181":406,"_183":399,"_14":278,"_185":407,"_187":280,"_189":190,"_12":191,"_192":-5},"x0nfqulcxfxxefb4ym9510pen","Trigram 冒充约 50 个 AI 与区块链品牌，用信息窃取器攻击开发者","Trigram 冒充欧洲和美国约 50 个 AI、区块链品牌，以招聘、会议邀请和包裹追踪场景诱导开发者执行信息窃取器，并借助被篡改的代码仓库实施软件供应链入侵。","文章串联招聘、会议邀请、代码仓库劫持等入口，展示了攻击链、目标筛选及失陷数据流转方式。",{"_50":131},"2026-11-17T15:17:28.000Z",[243,209,352,282,380,365,245,246,296],"aa8t07j9l4ep1db160rs5nlrhd","2026-11-17T20:26:32.116Z",{"_172":411,"_32":412,"_175":413,"_177":414,"_179":415,"_181":416,"_183":409,"_14":221,"_185":417,"_187":223,"_189":190,"_12":191,"_192":-5},"a8t07j9l4ep1db160rs5nlrhd","Telegram Android widget 安全过滤器可被两种方式绕过并实现 RCE","NebuSec 披露了 Telegram for Android 13.2.2 (7303) 新增 widget 安全过滤器的两种绕过方式：利用过滤器未覆盖的 widget 漏洞，以及串联过滤器覆盖的 widget 漏洞与内核漏洞，研究人员在测试服务器上演示代码越过过滤器并启动手机计算器。","文章拆解了 Telegram widget 安全过滤器的两种绕过路径，并结合源码配置说明实际风险边界与待确认信息。",{"_50":131},"2026-11-17T19:34:20.000Z",[224,225,226,418,295,209,245,283],"利用链","acxpqkath9so8ongzhll7oibqa","2026-11-17T21:24:35.892Z",{"_172":422,"_32":423,"_175":424,"_177":425,"_179":426,"_181":427,"_183":420,"_14":184,"_185":428,"_187":429,"_189":190,"_12":191,"_192":-5},"cxpqkath9so8ongzhll7oibqa","Chrome 158 稳定版发布，修复 204 项安全问题","Google 将 Chrome 158 推送至 Windows、Mac 和 Linux 稳定渠道，版本为 Linux 158.0.8127.36、Windows/Mac 158.0.8127.36/.37，更新将在未来数日或数周内逐步推出。","公告集中列出 Chrome 158 的 204 项安全修复及对应 CVE、等级和报告者，便于按组件与风险级别梳理升级影响。",{"_50":431},"2026-11-17T19:12:07.339Z",[194,430,245],75,"浏览器","Chrome Releases","f1612","2026-11-17T21:32:31.462Z",{"_172":435,"_32":436,"_175":437,"_177":438,"_179":439,"_181":440,"_183":433,"_14":221,"_185":441,"_187":329,"_189":190,"_12":191,"_192":-5},"t3l0ju6zlyroz3zo0x438qj82","研究人员发现 Docker Hub 公开镜像中的云密钥最快 7.86 秒被窃取","Stony Brook University 研究人员在 8 个公共容器仓库发布 300 个蜜罐镜像，测得公开镜像中的 AWS、OpenAI 和 Anthropic 凭据会遭自动化扫描器提取利用。","该研究通过蜜罐镜像量化公开容器仓库中的凭据暴露窗口，可为镜像发布前的秘密扫描和访问限速提供实践依据。",{"_50":65},"2026-11-17T21:27:17.000Z",[224,442,211,443,444,445,366,245],"论文","容器","凭据","云原生","f1616","2026-11-17T23:27:32.332Z",{"_172":449,"_32":450,"_175":451,"_177":452,"_179":453,"_181":316,"_183":447,"_14":454,"_185":455,"_187":351,"_189":190,"_12":191,"_192":-5},"rqea4z2nhncrkf2s1jvtvp067","Oracle Java Base64 解码器漏洞 CVE-2026-114938 存在未认证 RCE，CISA 要求立即修补","Oracle Java 的 Base64 解码器存在内存损坏漏洞 CVE-2026-114938，可由特制 Base64 输入触发 JVM 崩溃，并在无需认证的条件下实现远程代码执行。","原文明确利用前提、影响组件和临时缓解措施，读者可据此排查 Java 部署并确定修补优先级。",{"_50":79},"policy",[193,194,197,456,395,247],"加固",{"_458":459,"_460":-5},"changelogVersion","2026-10-01T08:00","release"]
