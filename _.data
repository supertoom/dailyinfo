52,"_53":-5},{"_49":121,"_51":52},{"_49":96,"_51":52},{"_49":150,"_51":52},{"_49":149,"_51":52},{"_49":71,"_51":52},{"_49":114,"_51":52},{"_49":148,"_51":52},{"_49":54,"_51":52},{"_49":117,"_51":52},{"_49":58,"_51":52},{"_49":93,"_51":52},{"_49":90,"_51":52},"CERT-FR","Cisco Talos","Cloudflare Blog","阿里云应急响应","长亭安全应急响应中心","绿盟科技CERT","Cisco PSIRT","2026-11-20",22,{"_177":445,"_179":446,"_181":447,"_183":-5},{"_177":434,"_179":435,"_181":436,"_183":-5},{"_177":421,"_179":422,"_181":423,"_183":-5},{"_177":410,"_179":411,"_181":412,"_183":-5},{"_177":399,"_179":400,"_181":401,"_183":-5},{"_177":388,"_179":389,"_181":390,"_183":-5},{"_177":376,"_179":377,"_181":378,"_183":-5},{"_177":363,"_179":364,"_181":365,"_183":-5},{"_177":348,"_179":349,"_181":350,"_183":-5},{"_177":335,"_179":336,"_181":337,"_183":-5},{"_177":324,"_179":325,"_181":326,"_183":-5},{"_177":312,"_179":313,"_181":314,"_183":-5},{"_177":288,"_179":289,"_181":290,"_183":291},{"_177":277,"_179":278,"_181":279,"_183":-5},{"_177":268,"_179":269,"_181":270,"_183":-5},{"_177":256,"_179":257,"_181":258,"_183":-5},{"_177":241,"_179":242,"_181":243,"_183":-5},{"_177":228,"_179":229,"_181":230,"_183":-5},{"_177":212,"_179":213,"_181":214,"_183":-5},{"_177":178,"_179":180,"_181":182,"_183":-5},"key","f1786","anchorAt","2026-11-19T16:05:22.670Z","item",{"_184":185,"_32":186,"_187":188,"_189":190,"_191":192,"_193":194,"_195":180,"_14":196,"_197":198,"_199":200,"_201":202,"_12":203,"_204":-5},"group","id","zivjvo29t1jew4ih1bkfouif8","Rapid7 分析 Webworm 定制的 SoftEther VPN 桥接工具 NtMonitor","summary","Rapid7 分析了一个此前未公开的定制 SoftEther 桥接工具 NtMedium Monitor（NtMonitor），以中等置信度归因于中国相关的 APT 组织 Webworm。","reason","文章拆解了 Webworm 定制 SoftEther 桥接工具的隐匿手法，并给出 IoC、YARA 规则与 TLS 流量检测特征，便于防守方对同类改动提前布防。","source",{"_49":77},"publishedAt","2026-11-19T15:05:34.000Z","timelineAt","disclosure","tags",[205,206,207,208,209,210,211],"score",75,"selected",true,"news","x","技术研究","逆向","恶意软件","后门","检测工程","Rapid7","ESET","acxsrv3tj2ve440bw0s2r18iyx","2026-11-19T16:27:19.236Z",{"_184":215,"_32":216,"_187":217,"_189":218,"_191":219,"_193":220,"_195":213,"_14":221,"_197":222,"_199":223,"_201":202,"_12":203,"_204":-5},"cxsrv3tj2ve440bw0s2r18iyx","PHP 修复 7 个严重级 RCE 漏洞，发布 PHP 8.6.0 与 8.5.13","PHP 发布安全更新，修复 7 个严重级远程代码执行（RCE）漏洞，包括会话上传进度反序列化、多个 use-after-free、PHP-FPM 请求走私和时区缓存释放后使用问题。","文章梳理了 7 个严重级 RCE 漏洞的触发条件、受影响版本与补丁覆盖情况，并区分已证实和尚未演示的执行路径。",{"_49":71},"2026-11-19T15:54:20.000Z","vuln",[224,225,226,227],85,"补丁","漏洞","供应链","PHP","f1804","2026-11-19T16:57:19.020Z",{"_184":231,"_32":232,"_187":233,"_189":234,"_191":235,"_193":236,"_195":229,"_14":221,"_197":237,"_199":200,"_201":202,"_12":203,"_204":-5},"yzdntmi57hv3f0dhps9tsd7c4","PHP 安全更新修复 18 个漏洞，CVE-2026-129289 涉及未认证 RCE","PHP 开发者团队发布 18 个漏洞的安全更新，覆盖 PHP 核心引擎、会话处理、PHP-FPM、CGI 等组件；PHP 8.5.13、8.4.28、8.3.37、8.2.36 已发布，适用于对应支持分支。","PHP 一次修复 18 个漏洞，涵盖未认证 RCE、利用链前提、临时缓解措施及支持版本范围，便于管理员判断升级与处置优先级。",{"_49":74},"2026-11-19T16:28:23.000Z",[225,224,238,239,240,227],"漏洞利用","网络设备","云原生","f1807","2026-11-19T17:50:20.214Z",{"_184":244,"_32":245,"_187":246,"_189":247,"_191":248,"_193":249,"_195":242,"_14":196,"_197":250,"_199":251,"_201":202,"_12":203,"_204":-5},"h3xl056qiyuu6k5htjyc23p49","PHP phpAfterShell 漏洞 CVE-2026-126714 分析，CVSS 4.0 评分 9.2","PHP 修复了会话文件存储漏洞 CVE-2026-126714，CVSS 4.0 评分为 9.2 分：攻击者可通过截断会话写入并借助应用中的 gadget chain 触发服务器代码执行。","文章梳理了 phpAfterShell 从会话写入截断到对象实例化的完整链路，并给出分支版本与临时缓解的适用边界。",{"_49":90},"2026-11-19T16:59:56.000Z",[205,252,253,254,255,227],73,"漏洞分析","复现","利用链","红队","f1808","2026-11-19T18:01:20.971Z",{"_184":259,"_32":260,"_187":261,"_189":262,"_191":263,"_193":264,"_195":257,"_14":221,"_197":265,"_199":266,"_201":202,"_12":203,"_204":-5},"uhvazvdp48xo8g4vjsd383z43","nginx 多模块内存安全漏洞链式 RCE：五个 CVE 影响至 1.31.8","nginx2root 是 CVE-2026-123007、CVE-2026-123634、CVE-2026-123633、CVE-2026-121810、CVE-2026-113425 组成的链式远程代码执行漏洞集，启用 HTTP/2、HTTP/3、resolver 配合 mirror 或 SSI、邮件代理等模块的目标在无需认证的情况下可被远程触发。","文章梳理了五个 CVE 的模块触发条件、版本区间与利用链前提，并以 PoC 验证了 worker 权限远程代码执行，便于读者核对自身配置和版本。",{"_49":122},"2026-11-19T09:51:00.000Z",[225,253,238,254,252,224,267],81,"深信服","f1809","2026-11-19T18:01:21.169Z",{"_184":271,"_32":272,"_187":273,"_189":274,"_191":275,"_193":264,"_195":269,"_14":221,"_197":276,"_199":200,"_201":202,"_12":203,"_204":-5},"ij1t9r2o1yq64nrx86tf5fp89","Vite 开发服务器虚拟模块注入远程代码执行漏洞 SF_2026_47139 修复公告","Vite 开发服务器虚拟模块标识符处理存在注入缺陷，攻击者可在无需认证和用户交互的条件下远程执行代码并读取任意文件。","文章复现了单请求远程代码执行链路，并给出受影响分支、修复版本及网络暴露条件，便于开发者评估开发服务器风险。",{"_49":122},[225,253,238,224,252,267],"aqfh0sjsz9ouip54rdzkoulw18","2026-11-19T18:01:22.604Z",{"_184":280,"_32":281,"_187":282,"_189":283,"_191":284,"_193":285,"_195":278,"_14":196,"_197":286,"_199":287,"_201":202,"_12":203,"_204":-5},"qfh0sjsz9ouip54rdzkoulw18","nginx 五个远程代码执行漏洞 CVE-2026-123007 等已复现，官方发布 1.31.9 与 1.30.7 修复","长亭安全应急响应中心披露并复现 nginx2root，包含 CVE-2026-123007、CVE-2026-123634、CVE-2026-123633、CVE-2026-121810 和 CVE-2026-113425 五个可独立触发的远程代码执行漏洞。","文章梳理五个 nginx 远程代码执行漏洞的成因、触发配置、修复版本与临时缓解措施，并复现了利用流量较大的关键 PoC。",{"_49":152},"2026-11-18T18:28:00.000Z",[252,253,238,205,224,239,210],87,"f1814","2026-11-19T19:24:19.380Z",{"_184":66,"_32":300,"_187":301,"_189":302,"_191":303,"_193":304,"_195":305,"_14":221,"_197":306,"_199":307,"_201":202,"_12":203,"_204":-5},{"_292":293,"_294":99,"_295":45,"_296":297},"factId","fJ4dDx5j8puY","additionalSourceCount","reportCount","memberIds",[298,66,299],"pgv3tl000yu3x739ofgaqd6pg","he08061xy4cyd54gsriazxv74","VMware vCenter 认证绕过漏洞 CVE-2026-123890 已被 ARMORY CASTLE 利用","VMware vCenter 的认证绕过漏洞 CVE-2026-123890 已被中国关联威胁组织 ARMORY CASTLE 在野利用，最早可追溯至 2026 年 9 月。","材料同时给出真实利用证据、无需凭据的利用条件、应急补丁版本及升级限制，有助于评估暴露风险并安排处置。",{"_49":77},"2026-11-19T21:06:24.000Z","2026-11-19T22:11:22.338Z",[225,308,224,309,310,311],93,"在野利用","身份与访问","VMware","Google","f1825","2026-11-19T20:53:20.320Z",{"_184":315,"_32":316,"_187":317,"_189":318,"_191":319,"_193":320,"_195":313,"_14":221,"_197":321,"_199":322,"_201":202,"_12":203,"_204":-5},"vf1cup61nse9kclvd8mx15kfa","XWiki Platform HQL 注入漏洞可导致未认证提取数据库内容","XWiki Platform 的查询 REST API 存在 HQL 注入漏洞，未经认证的攻击者可通过 FROM 子句注入绕过 SELECT 列白名单，提取不可访问页面的数据、密码哈希及配置中的密码。","公告说明了未认证注入的利用链、数据影响范围与请求规模，并给出修复版本和临时拦截端点，便于评估处置优先级。",{"_49":323},"2026-11-19T20:44:32.000Z",[225,224,238],72,"GitHub 安全公告","f1831","2026-11-19T20:53:20.359Z",{"_184":327,"_32":328,"_187":329,"_189":330,"_191":331,"_193":332,"_195":325,"_14":221,"_197":333,"_199":322,"_201":202,"_12":203,"_204":-5},"v8bxu9wb0z1gw4jyowgo1l6ae","@openeudi/openid4vp 证书链校验漏洞可接受伪造证书，已在 0.8.1 修复","@openeudi/openid4vp 的 ChainBuilder 仅按 Subject DN 字符串相等终止证书链构建，未验证终止证书与信任锚的签名，攻击者可复制信任锚 Subject DN 并用私钥签发伪造凭证，使 OpenID4VP 验证路径将其误判为可信凭证。","文章完整说明证书链校验缺陷、PoC、影响路径与修复方式，适合评估依赖该库验证身份凭证的团队。",{"_49":323},"2026-11-19T20:35:57.000Z",[225,253,224,252,309,334],"加密","f1837","2026-11-19T22:11:25.036Z",{"_184":338,"_32":339,"_187":340,"_189":341,"_191":342,"_193":343,"_195":336,"_14":221,"_197":344,"_199":345,"_201":202,"_12":203,"_204":-5},"z29qz6zm1opvf07uwchbeiif0","Chaotic Eclipse 发布 FastUnlock Windows 漏洞，可绕过 BitLocker 锁屏","Windows 零日漏洞 FastUnlock 可利用 Narrator 绕过 Windows 11 26H2 的锁屏，并在 WsiAccount 账户上下文执行代码。","材料披露了锁屏绕过的触发路径与 PoC 前提，可用于评估具备物理访问条件的 Windows 设备风险。",{"_49":58},"2026-11-19T21:43:09.000Z",[225,253,238,308,346,347],71,"Microsoft","操作系统","amxkst5z9aysxjtb8v981iupoo","2026-11-19T22:37:19.481Z",{"_184":351,"_32":352,"_187":353,"_189":354,"_191":355,"_193":356,"_195":349,"_14":357,"_197":358,"_199":359,"_201":202,"_12":203,"_204":-5},"mxkst5z9aysxjtb8v981iupoo","SBC Medical Group 两起安全事件暴露 160 万客户及员工数据","SBC Medical Group 向美国证券交易委员会（SEC）披露，两起入侵暴露其日本业务中的客户、员工及预约诊疗信息。数据库事件涉及 1,624,000 人，泄露内容涵盖姓名、联系方式、出生日期、会员 ID、密码等，另有 255,416 条预约请求、217,769 条网站咨询和约 20,000 条员工账号记录；其中 459 名员工的银行账户及税务信息受影响。","两起入侵涉及客户、员工及预约诊疗数据，披露字段和人数较细，便于相关机构评估通知与合规义务。",{"_49":74},"2026-11-19T22:25:42.000Z","activity",[360,361,362],79,"攻击活动","数据泄露","凭据","f1850","2026-11-19T22:59:19.957Z",{"_184":366,"_32":367,"_187":368,"_189":369,"_191":370,"_193":371,"_195":364,"_14":221,"_197":372,"_199":373,"_201":202,"_12":203,"_204":-5},"mpx0uupjxhqqh2y5ws97b5m3u","k8s-mcp-server 默认 SSE/HTTP 传输缺失认证，未授权用户可执行 Kubernetes 工具","k8s-mcp-server 的默认 SSE 传输模式在 8080 端口绑定 0.0.0.0，MCP tools/call 端点未校验认证、会话令牌或 Origin，攻击者可枚举并调用 Kubernetes 工具。","原文给出了明确的受影响提交、默认监听配置和无认证复现过程，可据此评估暴露端口后的 Kubernetes 工具滥用风险。",{"_49":323},"2026-11-19T22:48:33.000Z",[225,253,252,374,375,240],70,"AI 安全","Agent 安全","f1851","2026-11-19T22:59:19.965Z",{"_184":379,"_32":380,"_187":381,"_189":382,"_191":383,"_193":384,"_195":377,"_14":385,"_197":386,"_199":373,"_201":202,"_12":203,"_204":-5},"pi6rz141w402yirr3sp93bzlj","CodeWhale 0.8.67 及更早版本 exec_shell 自动批准机制可导致无提示 RCE","CodeWhale 0.8.67 及更早版本的 exec_shell 并行只读分类器会错误自动批准带执行能力的 fd、rg 和 git grep 参数，使默认交互式 Agent 模式可在无审批提示的情况下执行任意外部程序。","文章完整梳理了自动批准分类器被特定工具参数绕过的审批链，并给出可复现的命令与修复方向。",{"_49":323},"2026-11-19T22:48:14.000Z","ai-security",[374,375,253,254,387],"大模型","f1853","2026-11-19T22:59:19.978Z",{"_184":391,"_32":392,"_187":393,"_189":394,"_191":395,"_193":396,"_195":389,"_14":221,"_197":397,"_199":373,"_201":202,"_12":203,"_204":-5},"hvmdf2b2hvm47t3sscn2okaod","eml_parser v3.0.3 存在 Received 头解析 ReDoS 漏洞，复杂度达 O(n^4)","eml_parser v3.0.3 的 `Received` 头解析存在算法复杂度漏洞，攻击者可通过构造日期尾部包含不平衡 `(` 的标头触发四层贪婪正则回溯。","文章完整拆解了 O(n^4) 回溯的根因与触发条件，并用不同长度的邮件给出实测和 PoC，修复前后复杂度变化也便于评估处置价值。",{"_49":323},"2026-11-19T22:47:08.000Z",[225,253,224,252,398],"邮件安全","f1854","2026-11-19T22:59:19.984Z",{"_184":402,"_32":403,"_187":404,"_189":405,"_191":406,"_193":407,"_195":400,"_14":221,"_197":408,"_199":345,"_201":202,"_12":203,"_204":-5},"d4alkbrizhut2tkg9zf5yo7q6","containerd 镜像清单畸形摘要触发守护进程崩溃","containerd 镜像清单处理缺陷可导致守护进程发生不可恢复的 panic，使通过 transfer service 导入恶意图像或执行默认 CRI `PullImage` 请求的 containerd 崩溃。","原文说明触发路径、受影响节点后果与可用临时限制，便于评估恶意镜像对容器运行的影响及升级必要性。",{"_49":323},"2026-11-19T22:46:24.000Z",[225,224,409,240],"容器","f1861","2026-11-19T23:13:19.511Z",{"_184":413,"_32":414,"_187":415,"_189":416,"_191":417,"_193":418,"_195":411,"_14":221,"_197":419,"_199":420,"_201":202,"_12":203,"_204":-5},"vz2s0iiyais2z5fhoqzbrdk5e","nginx 披露 NGINX2Root 五个 RCE 漏洞，CVE-2026-123007 与 CVE-2026-123633 CVSS 4.0 均为 9.2","nginx 与 F5 披露 NGINX2Root 五个 RCE 漏洞，未认证攻击者可经 HTTP/2 触发内存破坏，并与 Linux 内核 SCTP 漏洞串联取得 root、逃逸 Docker 容器访问宿主机。","文章完整列出五个漏洞的受影响版本、触发配置、补丁与临时缓解措施，并说明 Falcon 如何识别暴露资产和利用后行为。",{"_49":96},"2026-11-19T06:00:00.000Z",[225,224,253,254,252,409,96],76,"f1884","2026-11-20T00:12:20.425Z",{"_184":424,"_32":425,"_187":426,"_189":427,"_191":428,"_193":429,"_195":422,"_14":221,"_197":430,"_199":431,"_201":202,"_12":203,"_204":-5},"k8d2s2ywds1oilbpti5ie2vt9","Pen Test Partners 分析 RDM 制冷控制器漏洞及英国超市暴露风险","Pen Test Partners 与 Omega Solutions 分析并验证 RDM 制冷控制器中的多个漏洞，揭示英国多家超市、零售商和冷链运营商存在公网暴露风险。","文章还原了从控制器漏洞发现、协同披露到批量排查的处置过程，并指出离网与固件更新仍是降低风险的关键。",{"_49":433},"2026-11-20T00:01:00.000Z",[225,252,224,432],74,"应急响应","Pen Test Partners","f1896","2026-11-20T00:23:20.137Z",{"_184":437,"_32":438,"_187":439,"_189":440,"_191":441,"_193":442,"_195":435,"_14":221,"_197":443,"_199":444,"_201":202,"_12":203,"_204":-5},"lma026dsgiyjnyodlwboyhmxp","Daptin 通用 YJS 协作端点存在 IDOR 漏洞，未授权用户可读写文件内容","Daptin 的通用 YJS 协作端点 `GET /yjs/:documentName` 仅校验会话存在，未执行行级或列级授权检查，任何已注册用户包括零权限账户均可读取并修改任意表的 `file.*` 类型列内容，包括默认仅限管理员访问的 `calendar` 表。","文章对比了两个 YJS 路由的授权差异，给出完整 PoC、影响范围与修复提交，具备定位同类访问控制缺陷的参考价值。",{"_49":323},"2026-11-20T00:14:14.000Z",[225,253,252,308,224],78,"f1907","2026-11-20T00:23:20.210Z",{"_184":448,"_32":449,"_187":450,"_189":451,"_191":452,"_193":453,"_195":446,"_14":221,"_197":454,"_199":431,"_201":202,"_12":203,"_204":-5},"z7hvv6ys0av1dleklhpjcsukl","Refitter 2.0.0 存在 OpenAPI 路径注入导致的 RCE","Refitter 2.0.0 在 .NET 8 下存在由恶意 OpenAPI 路径触发的 RCE。未转义的路径可注入 `[ModuleInitializer]`，生成的客户端被编译并加载时，攻击代码会在应用启动阶段执行，无需 `--skip-validation`。","文章给出可执行的 PoC，并解释了恶意 OpenAPI 路径如何绕过默认校验、注入 ModuleInitializer 并在程序集加载时执行代码。",{"_49":323},"2026-11-20T00:06:04.000Z",[225,253,238,252,226],{"_456":457,"_458":-5},"changelogVersion","2026-10-01T08:00","release"]
