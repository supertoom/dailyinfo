159":411,"_161":412,"_163":413,"_165":-5},{"_159":399,"_161":400,"_163":401,"_165":-5},{"_159":385,"_161":386,"_163":387,"_165":-5},{"_159":374,"_161":375,"_163":376,"_165":-5},{"_159":362,"_161":363,"_163":364,"_165":-5},{"_159":345,"_161":346,"_163":347,"_165":348},{"_159":334,"_161":335,"_163":336,"_165":-5},{"_159":324,"_161":325,"_163":326,"_165":-5},{"_159":313,"_161":314,"_163":315,"_165":-5},{"_159":297,"_161":298,"_163":299,"_165":300},{"_159":283,"_161":284,"_163":285,"_165":-5},{"_159":270,"_161":271,"_163":272,"_165":-5},{"_159":254,"_161":255,"_163":256,"_165":-5},{"_159":243,"_161":244,"_163":245,"_165":-5},{"_159":229,"_161":230,"_163":231,"_165":-5},{"_159":214,"_161":215,"_163":216,"_165":-5},{"_159":194,"_161":195,"_163":196,"_165":-5},{"_159":160,"_161":162,"_163":164,"_165":-5},"key","f1931","anchorAt","2026-11-20T10:16:30.944Z","item",{"_166":167,"_32":168,"_169":170,"_171":172,"_173":174,"_175":176,"_177":162,"_14":178,"_179":180,"_181":182,"_183":184,"_12":185,"_186":-5},"group","id","sn5s06akig7th3wj4puzg5tfh","GhostMap eBPF Rootkit 深度分析：隐匿 npm IronWorm 与 AUR Atomic Arch 攻击活动","summary","Aqua Nautilus 在 IronWorm 与 Atomic Arch 两起供应链攻击载荷中发现同一个 eBPF Rootkit 组件 GhostMap，并确认其由 13 个 eBPF 程序、10 个 map、13 个 link 构成。","reason","文章拆解了 GhostMap 篡改进程与套接字枚举结果的机制，并给出可复现的对照观测与排查方向。","source",{"_50":193},"publishedAt","2026-11-20T04:07:00.000Z","timelineAt","disclosure","tags",[187,188,189,190,191,192],"score",78,"selected",true,"news","x","技术研究","逆向","恶意软件","供应链投毒","内核","后门","奇安信威胁情报中心","f1932","2026-11-20T10:16:30.964Z",{"_166":197,"_32":198,"_169":199,"_171":200,"_173":201,"_175":176,"_177":195,"_14":202,"_179":203,"_181":204,"_183":184,"_12":185,"_186":-5},"do1qix3duahy7w828dz52wk6y","BlackNevas 利用合法 vCenter 管理接口破坏 VMware 虚拟化环境","BlackNevas 通过组织内部获取的凭据进入 VCSA，建立 MeshAgent 与 Ligolo-ng 持久化通道，滥用 vCenter Host Profiles 开启 TSM-SSH，再经 SFTP 向 ESXi 投递加密器；事件导致四台 ESXi 主机及其全部虚拟机、两台 VCSA 和备份基础设施被破坏。","文章还原了凭据滥用、Host Profiles 篡改、备份削弱到 ESXi 引爆的完整链路，并给出可关联监测的管理面预警信号。",{"_50":193},"activity",[205,206,189,207,208,209,210,211,212,213],85,"攻击活动","勒索","利用链","供应链","应急响应","VMware","Kaspersky","SentinelOne","Microsoft","f1933","2026-11-20T10:22:38.667Z",{"_166":217,"_32":218,"_169":219,"_171":220,"_173":221,"_175":222,"_177":215,"_14":202,"_179":223,"_181":224,"_183":184,"_12":185,"_186":-5},"bdvhp3tdug4n70w0l2ne1bqaq","Hunt.io 发现针对美国银行和政府账户的俄语凭据窃取行动","Hunt.io 发现一项俄语凭据窃取行动，自 October 12 起感染 603 台 Windows PC，三周内通过 3 个 C2 系统建立超过 1.2 million 次连接；至少 57 名受害者存有美国银行或政府登录信息，46 名涉及联邦福利或身份服务账户。","文章披露了凭据窃取平台的完整运作链和多个真实数据点，可用于识别AI开发工具凭据、浏览器会话与密码管理器等高风险暴露面。",{"_50":93},"2026-11-20T09:03:11.000Z",[205,189,225,226,227,213,228],72,"凭据","数据窃取","AI 攻防","Google","f1937","2026-11-20T11:10:29.091Z",{"_166":232,"_32":233,"_169":234,"_171":235,"_173":236,"_175":237,"_177":230,"_14":238,"_179":239,"_181":224,"_183":184,"_12":185,"_186":-5},"uaus61qng3nzpeh4wrbr3it3m","F5 为 BIG-IP 5 个关键 RCE 漏洞发布紧急补丁","F5 宣布为 BIG-IP APM 与 iRules 功能中的 5 个栈缓冲区溢出漏洞发布带外热修复，分别为 CVE-2026-121805、CVE-2026-120292、CVE-2026-120285、CVE-2026-116953 和 CVE-2026-123637，均为关键级别，未认证攻击者可在特定易受影响配置下终止 TMM 或远程执行任意代码。","原文同时列出多个漏洞编号、受影响组件、利用前提与官方热修复方案，适合管理员据此判断暴露风险并安排处置。",{"_50":76},"2026-11-20T10:57:43.000Z","vuln",[240,241,207,242],"漏洞","补丁","网络设备","f1942","2026-11-20T12:18:31.619Z",{"_166":246,"_32":247,"_169":248,"_171":249,"_173":250,"_175":251,"_177":244,"_14":202,"_179":252,"_181":253,"_183":184,"_12":185,"_186":-5},"f21gd7uj9jttjkqd3djp2u7i7","欧盟委员会遭 ARTEX AI 辅助攻击，人事管理系统中断至少 10 天","欧盟官员证实，欧盟委员会遭 AI 辅助网络攻击，10 月 22 日发现事件后关闭多个应用，翻译、费用报销、薪资和工时记录等系统受到影响，至少 10 天无法正常提供服务，部分数字工具持续离线。","材料还原了欧盟委员会遭 AI 辅助攻击后的影响范围，并补充 ARTEX 渗透测试智能体的扩散风险与监管警告。",{"_50":58},"2026-11-20T10:12:00.000Z",[205,227,226,208],77,"f1951","2026-11-20T14:43:29.457Z",{"_166":257,"_32":258,"_169":259,"_171":260,"_173":261,"_175":262,"_177":255,"_14":178,"_179":263,"_181":264,"_183":184,"_12":185,"_186":-5},"cxkvmlklv6c39ftnl61m71q1k","pREST _groupby 函数表达式 SQL 注入分析，CVE-2025-58450 修复不完整","pREST 的 _groupby 函数表达式路径仍可触发 SQL 注入，构成 CVE-2025-58450 后续修复的不完整覆盖。作者以负向对照测试确认，isSafeSQLExpression 会错误接受 4 类包含 UNION、子查询或 pg_sleep 的 Payload，并由 GroupByClause 原样拼接执行；默认配置下仅需表读取权限，可能无需认证。","作者通过代码路径审计与负向对照定位了修复覆盖缺口，并区分了已验证的 SQL 注入与 DoS 原语及尚未验证的数据外泄。",{"_50":269},"2026-11-20T14:41:42.000Z",[265,266,267,268,208],70,"漏洞分析","复现","漏洞利用","数据库","GitHub 安全公告","f1974","2026-11-20T15:21:30.821Z",{"_166":273,"_32":274,"_169":275,"_171":276,"_173":277,"_175":278,"_177":271,"_14":238,"_179":279,"_181":280,"_183":184,"_12":185,"_186":-5},"nzpbt56ivpfcejp2mk6oqnujs","Microsoft Outlook 欺骗漏洞 CVE-2026-124194 已复现并遭在野利用","Microsoft Outlook 欺骗漏洞 CVE-2026-124194 已遭在野利用，攻击者可投递特制 .ics 日历文件诱使用户打开或导入，借此向攻击者控制的网络位置发起认证并泄露当前用户的 NTLMv2 响应；利用可远程触发，无需权限，但需要用户配合。","文章给出可复现的 .ics 触发链、已捕获的在野利用行为及出站 SMB 缓解措施，便于评估凭据泄露风险并安排处置。",{"_50":113},"2026-11-19T17:06:00.000Z",[240,281,266,241,282,213],84,"在野利用","邮件安全","f1977","2026-11-20T16:00:29.101Z",{"_166":286,"_32":287,"_169":288,"_171":289,"_173":290,"_175":291,"_177":284,"_14":202,"_179":292,"_181":293,"_183":184,"_12":185,"_186":-5},"hikp8skmkm0icifdlk2ddmxo6","n0n 勒索 Qubole 后声称泄露 Chase、Visa 和 Mastercard 客户数据","n0n 勒索组织声称攻击云数据分析公司 Qubole，并在 2026 年 10 月 14 日至 26 日间利用已泄露的 Qubole 凭据，经客户配置的 IAM roles 入侵 AWS 环境，窃取 53.9 GB、30,743 个文件，并声称掌握近 1 PB 客户网络数据。","文章串联第三方服务商遭勒索攻击与支付机构数据暴露，并区分营销信息泄露与支付网络未受影响，便于判断实际风险边界。",{"_50":76},"2026-11-20T15:58:06.000Z",[205,294,206,208,295,296],80,"数据泄露","云原生","AWS","f1985","2026-11-20T17:23:31.412Z",{"_166":104,"_32":307,"_169":308,"_171":309,"_173":310,"_175":311,"_177":298,"_14":238,"_179":312,"_181":182,"_183":184,"_12":185,"_186":-5},{"_301":302,"_303":115,"_304":99,"_305":306},"factId","f6WA2ackQ-jM","additionalSourceCount","reportCount","memberIds",[104],"Ruby 字符串大小写转换堆越界写入漏洞 CVE-2026-132825 存在 RCE 风险","Ruby 字符串大小写转换函数存在堆缓冲区越界写入漏洞（CVE-2026-132825），影响 Ruby < 3.3.14、Ruby 3.4.0 - 3.4.12 和 Ruby 4.0.0 - 4.0.9，威胁等级为高危。","文章解释了单字节编码下字符串大小写转换触发堆越界写入的成因，并列出受影响版本、利用前提与修复方案。",{"_50":114},"2026-11-20T09:49:00.000Z",[240,241,265],"f1986","2026-11-20T17:23:31.424Z",{"_166":316,"_32":317,"_169":318,"_171":319,"_173":320,"_175":311,"_177":314,"_14":238,"_179":321,"_181":224,"_183":184,"_12":185,"_186":-5},"sgciwtig86m8ho71b0h3a56f6","VMware vCenter 认证绕过漏洞 CVE-2026-123890 通告，官方已发布修复","深瞳漏洞实验室于2026年11月20日发布漏洞通告，VMware vCenter 存在认证绕过漏洞 CVE-2026-123890，威胁等级为高危。","通告给出了逐版本的受影响区间、无需凭据即可建立管理员会话的利用条件，以及各版本可用的补丁与升级路径，便于读者快速判断自身资产是否受影响。",{"_50":114},[240,241,265,322,210,323],"身份与访问","深信服","ad8r57wa5dx4heczan7q6hz8i5","2026-11-20T17:23:31.436Z",{"_166":327,"_32":328,"_169":329,"_171":330,"_173":331,"_175":311,"_177":325,"_14":238,"_179":332,"_181":182,"_183":184,"_12":185,"_186":-5},"d8r57wa5dx4heczan7q6hz8i5","PHP 8.2至8.5系列曝出7个代码执行漏洞，官方已发布修复版本","深瞳漏洞实验室披露PHP组件7个严重代码执行漏洞，分别为CVE-2026-126714、CVE-2026-115560、CVE-2026-129289、CVE-2026-129474、CVE-2026-129496、CVE-2026-129182和CVE-2026-129481。","通告列出7个PHP代码执行漏洞的触发路径、影响版本和逐项缓解配置，便于安全团队核对资产并安排升级。",{"_50":114},[240,241,265,208,333,323],"PHP","f1987","2026-11-20T17:23:34.134Z",{"_166":337,"_32":338,"_169":339,"_171":340,"_173":341,"_175":342,"_177":335,"_14":238,"_179":343,"_181":344,"_183":184,"_12":185,"_186":-5},"ove2pi7map5xlnn8tjm9w03ev","PHP 远程代码执行漏洞 CVE-2026-126714 已公开并发布修复","PHP 远程代码执行漏洞 CVE-2026-126714（phpAfterShell）已被公开，CVSS 评分为 9.2。","通告列明受影响版本、会话处理器前提、临时缓解和修复版本，并提供人工与工具检测方法，便于评估和处置风险。",{"_50":62},"2026-11-20T03:35:00.000Z",[240,241,265,333],71,"f1990","2026-11-20T17:56:29.606Z",{"_166":351,"_32":353,"_169":354,"_171":355,"_173":356,"_175":357,"_177":346,"_14":202,"_179":358,"_181":280,"_183":184,"_12":185,"_186":-5},{"_301":349,"_303":115,"_304":99,"_305":350},"fVbDsNwWSOac",[351,352],"mfif5csbm0luk6anr64r4hzho","dcch6vrh267pbs79iv9qncpeu","攻击者利用自主 AI 工具 Cairn 攻陷 MONAI Label 漏洞并取得服务器权限","Amazon Threat Intelligence 发现疑似中国关联攻击者使用自主 AI Agent 平台 Cairn，于 2026 年 9 月 8 日至 10 日攻击中国境外东亚教育机构。","材料展示了 AI Agent 自主发现并利用漏洞的完整链路，以及失败尝试和修复时间，便于评估防御响应压力。",{"_50":76},"2026-11-20T17:30:00.000Z",[205,227,281,267,359,360,296,228,361],"大模型","Agent 安全","CISA","asjin4pr8q1dp00z0igue1371g","2026-11-20T19:32:29.280Z",{"_166":365,"_32":366,"_169":367,"_171":368,"_173":369,"_175":370,"_177":363,"_14":238,"_179":371,"_181":344,"_183":184,"_12":185,"_186":-5},"sjin4pr8q1dp00z0igue1371g","CISA将4个漏洞纳入KEV Catalog，均有真实利用证据","CISA将CVE-2025-42884、CVE-2026-76466、CVE-2026-123890和CVE-2026-129448纳入KEV Catalog，依据是这些漏洞已有在野利用证据，分别涉及SAP NetWeaver、Cisco Expressway Series、VMWare vCenter和Apache Roller。","CISA依据真实利用证据将4个漏洞纳入KEV Catalog，并明确联邦机构应优先修复暴露资产上的相关缺陷。",{"_50":373},"2026-11-20T12:00:00.000Z",[281,372,241,361,210],"漏洞管理","CISA 安全公告","f1996","2026-11-20T20:32:32.974Z",{"_166":377,"_32":378,"_169":379,"_171":380,"_173":381,"_175":382,"_177":375,"_14":238,"_179":383,"_181":182,"_183":184,"_12":185,"_186":-5},"jszry2ckucax402ve9a7rmc3m","Cloudflare WAF 防护 ruby2shell 漏洞 CVE-2026-132825 及 GHSA-87fm-7w84-j2px","Cloudflare WAF 已为 ruby2shell（CVE-2026-132825）及相关整数溢出 GHSA-87fm-7w84-j2px 启用默认阻断规则，Free 计划自动生效，付费计划需确认 Cloudflare Managed Ruleset 已部署。","文章同时说明漏洞触发条件、Cloudflare WAF 规则覆盖范围及绕过边界，为无法立即升级 Ruby 的团队提供临时防护与处置依据。",{"_50":110},"2026-11-20T20:24:38.000Z",[240,241,266,265,295,384],"Cloudflare","axc4re3fqbv7j3asqraazbq4h2","2026-11-20T20:32:32.984Z",{"_166":388,"_32":389,"_169":390,"_171":391,"_173":392,"_175":393,"_177":386,"_14":394,"_179":395,"_181":293,"_183":184,"_12":185,"_186":-5},"xc4re3fqbv7j3asqraazbq4h2","PHP phpAfterShell 远程代码执行漏洞 CVE-2026-126714 已修复，Cloudflare WAF 已更新检测","Cloudflare 介绍 PHP 默认文件会话处理器漏洞 phpAfterShell（CVE-2026-126714），该漏洞 CVSS v4.0 为 9.2 分，可因会话文件写入中断并在后续反序列化时导致远程代码执行。","文章梳理了 phpAfterShell 的触发原理、受影响版本与利用前提，并说明 Cloudflare WAF 规则、补丁和临时缓解措施。",{"_50":110},"2026-11-20T20:00:45.000Z","blue-team",[396,397,265,372,398,384,333],"工具发布","版本更新","加固","ab7fagpjz2rm06udejoz3syyf2","2026-11-20T20:33:30.286Z",{"_166":402,"_32":403,"_169":404,"_171":405,"_173":406,"_175":407,"_177":400,"_14":238,"_179":408,"_181":264,"_183":184,"_12":185,"_186":-5},"b7fagpjz2rm06udejoz3syyf2","Cisco 排查 nginx 远程代码执行漏洞对产品的影响","Cisco PSIRT 通报 nginx 1.9.5 至 1.31.8 存在多个可能导致远程代码执行的严重漏洞，已在 1.31.9 和 1.30.7 修复，涉及 CVE-2026-113425、CVE-2026-121810、CVE-2026-123007、CVE-2026-123633、CVE-2026-123634。","通告列明 nginx 多个漏洞的受影响版本、Cisco 产品排查状态和首批修复版本，便于相关用户核对暴露范围与升级路径。",{"_50":410},"2026-11-20T08:00:00.000Z",[240,241,266,409,242],"Cisco","Cisco PSIRT","f1998","2026-11-20T21:31:31.492Z",{"_166":414,"_32":415,"_169":416,"_171":417,"_173":418,"_175":419,"_177":412,"_14":202,"_179":420,"_181":224,"_183":184,"_12":185,"_186":-5},"vt4gd1d2m0q2e5cxg60jzp1ja","GreenJuliett 将 AI 纳入 OT 攻击链并扩大 FortiGate 扫描范围","Recorded Future 观测到 GreenJuliett 将 AI 纳入 OT 攻击链，用于识别脆弱设备类型并编写针对 PLC 与工业协议的脚本。该组织在巴林、以色列、约旦、科威特、沙特阿拉伯和卡塔尔扫描或尝试利用 Fortinet FortiGate，并可能将 IoT 与 CCTV 设备纳入目标。","文章追踪了 GreenJuliett 将 AI 引入 OT 攻击链的迹象及其针对 PLC、FortiGate 和 IoT 设备的扩张路径。",{"_50":424},"2026-11-20T00:00:00.000Z",[205,189,227,421,422,423,228],"工控","IoT","Fortinet","Recorded Future","ay1q31smahyra1wu2i286xr7ey","2026-11-20T22:34:32.487Z",{"_166":428,"_32":429,"_169":430,"_171":431,"_173":432,"_175":433,"_177":426,"_14":202,"_179":434,"_181":435,"_183":184,"_12":185,"_186":-5},"y1q31smahyra1wu2i286xr7ey","Unit 42披露Com关联组织以语音钓鱼窃取数据并实施勒索","Unit 42追踪到Bling Libra及多个Com关联活动簇通过语音钓鱼和AiTM页面窃取凭据与MFA批准，随后借助原生云工具、脚本和恶意浏览器扩展定位高价值数据、批量外传并发送勒索信息。","材料结合遥测与事件响应还原了多组关联活动簇的入侵链、受害行业变化及恶意扩展能力，便于比较其数据窃取手法。",{"_50":438},"2026-11-20T22:00:25.000Z",[205,189,436,294,206,322,437,228,213],81,"钓鱼","Palo Alto","Unit 42","f2000","2026-11-20T23:47:29.940Z",{"_166":442,"_32":443,"_169":444,"_171":445,"_173":446,"_175":447,"_177":440,"_14":238,"_179":448,"_181":264,"_183":184,"_12":185,"_186":-5},"ql8z19mw87u0y7njlw1p4sq74","Contao core-bundle 漏洞分析：theme_import 权限可绕过 tpl_editor 限制实现 RCE","Contao core-bundle 存在权限提升漏洞，受委托的用户或用户组管理员可为自己或所管理的账户添加 theme_import 权限，进而在服务器上执行任意 PHP。","文章通过权限校验差异与 Contao 5.7.9 复现步骤，说明 theme_import 如何绕过 tpl_editor 的限制并形成服务器端代码执行链。",{"_50":269},"2026-11-20T23:45:41.000Z",[240,266,267,265],{"_450":451,"_452":-5},"changelogVersion","2026-10-01T08:00","release"]
