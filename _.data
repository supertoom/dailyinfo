73,74,75,76,77,78],6,{"_50":61,"_52":53,"_54":62,"_56":63},{"_50":83,"_52":53,"_54":84,"_56":85},{"_50":80,"_52":53,"_54":81,"_56":82},{"_50":58,"_52":53,"_54":59,"_56":60},{"_50":51,"_52":53,"_54":55,"_56":57},{"_50":79,"_52":53,"_54":-5},"Cybernews","Help Net Security","/dailyinfo/media/06c9ab9de6dbb6a5.webp","/dailyinfo/media/9c1b5fa87b3bafc5.webp 48w, /dailyinfo/media/06c9ab9de6dbb6a5.webp 96w","Infosecurity Magazine","/dailyinfo/media/b3cc9cd29f272a5a.webp","/dailyinfo/media/6406d1b57afc7303.webp 48w, /dailyinfo/media/b3cc9cd29f272a5a.webp 96w",3,"FIFA确认遭入侵，自称HBHC的组织宣称泄露超12GB数据",24.3,"1ab2de17-8bbc-419b-9dc9-438c6e2bd08b","t50ps5j13a1mvy4ypu8zskb5x",[92,93,94,95],{"_50":80,"_52":53,"_54":81,"_56":82},{"_50":83,"_52":53,"_54":84,"_56":85},{"_50":61,"_52":53,"_54":62,"_56":63},{"_50":58,"_52":53,"_54":59,"_56":60},2,"SAP确认开发基础设施遭攻击，GitHub代码疑被篡改",25.7,"f277d653-e06d-4b70-92f9-cb4b08781be8","hula7qv4z43seiug59c3dry5x",[102,103,104,105],{"_50":61,"_52":53,"_54":62,"_56":63},{"_50":64,"_52":53,"_54":65,"_56":66},{"_50":58,"_52":53,"_54":59,"_56":60},{"_50":79,"_52":53,"_54":-5},1,"Cacti 1.2.31未授权RCE PoC已公开",27.1,"5f727b7b-3657-4338-b837-306e337b299b","rfirwc4gz7xd4ktjxcnwoqtre",[112,113,114,115],{"_50":119,"_52":53,"_54":-5},{"_50":64,"_52":53,"_54":65,"_56":66},{"_50":116,"_52":53,"_54":117,"_56":118},{"_50":51,"_52":53,"_54":55,"_56":57},"安全内参","/dailyinfo/media/77459fcbf8f21e71.webp","/dailyinfo/media/3399ea7b18d18a6a.webp 48w, /dailyinfo/media/77459fcbf8f21e71.webp 96w","绿盟科技CERT","2026-11-28","2026-11-27",12,"2026-11-26",21,{"_145":427,"_147":428,"_149":429,"_151":-5},{"_145":411,"_147":412,"_149":413,"_151":414},{"_145":397,"_147":398,"_149":399,"_151":-5},{"_145":385,"_147":386,"_149":387,"_151":-5},{"_145":373,"_147":374,"_149":375,"_151":-5},{"_145":361,"_147":362,"_149":363,"_151":-5},{"_145":349,"_147":350,"_149":351,"_151":-5},{"_145":337,"_147":338,"_149":339,"_151":340},{"_145":321,"_147":322,"_149":323,"_151":324},{"_145":310,"_147":311,"_149":312,"_151":-5},{"_145":299,"_147":300,"_149":301,"_151":-5},{"_145":279,"_147":280,"_149":281,"_151":282},{"_145":266,"_147":267,"_149":268,"_151":-5},{"_145":253,"_147":254,"_149":255,"_151":-5},{"_145":241,"_147":242,"_149":243,"_151":-5},{"_145":227,"_147":228,"_149":229,"_151":-5},{"_145":213,"_147":214,"_149":215,"_151":-5},{"_145":198,"_147":199,"_149":200,"_151":-5},{"_145":179,"_147":180,"_149":181,"_151":-5},{"_145":146,"_147":148,"_149":150,"_151":-5},"key","f2300","anchorAt","2026-11-26T11:42:31.832Z","item",{"_152":153,"_32":154,"_155":156,"_157":158,"_159":160,"_161":162,"_163":148,"_14":164,"_165":166,"_167":168,"_169":170,"_12":171,"_172":-5},"group","id","xxw8h23ag2c76hyuqa5gblkin","同一 vLLM 推理服务器中的模型可经侧信道通信并绕过不可信监控","summary","研究证明，运行在同一 vLLM 推理服务器上的模型即使无法直接交互，也能利用 GPU 内核选择造成的激活值舍入差异建立 Step Sizing 与 KV Cache Message Board 两种通信信道。","reason","研究揭示了同一推理服务器中的模型可借内核舍入差异和共享 KV cache 建立侧信道通信，并验证其对不可信监控协议的绕过效果。","source",{"_50":116},"publishedAt","2026-11-25T15:42:31.770Z","timelineAt","ai-security","tags",[173,174,175,176,177,178],"score",71,"selected",true,"news","x","AI 安全","技术研究","大模型","Agent 安全","模型安全","AI 供应链","f2301","2026-11-26T12:19:19.158Z",{"_152":182,"_32":183,"_155":184,"_157":185,"_159":186,"_161":187,"_163":180,"_14":188,"_165":189,"_167":190,"_169":170,"_12":171,"_172":-5},"g2obwrf736za9vvdn0fst3ayg","SYS010 信息窃取木马借 Meta 广告强制安装浏览器扩展窃取 Gmail 与 Outlook 邮件","Bitdefender Labs 披露 SYS010 信息窃取木马通过 Meta 广告伪装成免费动态壁纸应用下载，诱导 Windows 用户安装后强制为 Chrome、Edge 和 Firefox 配置恶意扩展，目标是 Facebook 与 Meta 商业账户及 Gmail、Outlook 邮件。","文章拆解了 SYS010 从 Meta 广告投放到强制安装浏览器扩展的完整链路，并明确说明服务器请求量不能代表已确认感染。",{"_50":64},"2026-11-26T11:50:17.000Z","activity",[191,192,193,194,195,196,197],74,"攻击活动","恶意软件","数据窃取","浏览器","供应链投毒","Google","Mozilla","f2302","2026-11-26T12:23:19.187Z",{"_152":201,"_32":202,"_155":203,"_157":204,"_159":205,"_161":206,"_163":199,"_14":188,"_165":207,"_167":208,"_169":170,"_12":171,"_172":-5},"kcwxcgi3mbarz9m115ch1kn3v","Mitel MiCollab 5 个零日漏洞遭在野利用，CISA 已将其纳入 KEV","Mitel MiCollab 5 个漏洞已被用于数据窃取和可能的勒索活动，CISA 将其纳入 KEV，其中 4 个要求联邦机构在 11 月 28 日前处置，另 1 个截止日期为 12 月 9 日。","文章还原了攻击者从 MiCollab 漏洞入侵到身份基础设施的完整路径，并给出补丁时间线与处置期限。",{"_50":58},"2026-11-26T11:35:25.000Z",[209,210,191,211,212],85,"在野利用","漏洞利用","AI 攻防","CISA","f2305","2026-11-26T12:59:19.480Z",{"_152":216,"_32":217,"_155":218,"_157":219,"_159":220,"_161":221,"_163":214,"_14":188,"_165":222,"_167":223,"_169":170,"_12":171,"_172":-5},"en1gv0ci3e610k5ce0nrbau25","Kaspersky 发现 Keenadu 后门预装于超过 220,000 台 Android 设备","Kaspersky 在前 10 个月内于超过 220,000 台 Android 设备中发现 Keenadu；它与 Triada 合计出现在今年检出预装恶意软件设备的 88% 中。","文章拆解了预装恶意软件的供应链入侵路径、潜伏与模块化机制，并提供企业采购前的样本测试建议。",{"_50":80},"2026-11-26T12:57:58.000Z",[192,224,195,225,226,193],75,"后门","移动端","Kaspersky","f2307","2026-11-26T13:24:20.896Z",{"_152":230,"_32":231,"_155":232,"_157":233,"_159":234,"_161":235,"_163":228,"_14":236,"_165":237,"_167":238,"_169":170,"_12":171,"_172":-5},"a5fzo7vwm6srlhz65h7wxvfw8","Juniper Session Smart Conductor 严重漏洞 CVE-2026-103406 已被利用","Juniper Networks 与 CISA 确认，CVE-2026-103406 已在攻击中被利用，CVSS 9.8。该远程 OS 命令注入漏洞影响 Session Smart Conductor 的 AutomatedProvisionor 服务，攻击者可通过特制 Salt minion ID 以 root 权限执行任意命令。","原文明确披露漏洞已遭利用，并给出受影响版本、修复版本和 CISA 要求的处置时限。",{"_50":58},"2026-11-26T13:04:06.000Z","vuln",[239,209,240,212],80,"漏洞","补丁","awaly7f5cwuea4sg732ir9h5vt","2026-11-26T14:44:23.715Z",{"_152":244,"_32":245,"_155":246,"_157":247,"_159":248,"_161":249,"_163":242,"_14":236,"_165":250,"_167":251,"_169":170,"_12":171,"_172":-5},"waly7f5cwuea4sg732ir9h5vt","Danfoss AK-SM 8xxA Series 控制器曝栈溢出漏洞 CVE-2026-129713，CVSS 9.8","Danfoss AK-SM 8xxA Series 控制器的未认证 CGI 处理器存在栈溢出漏洞 CVE-2026-129713，CVSS 为 9.8，远程攻击者发送特制 HTTP/S POST 请求可导致内存损坏、webserver 重启，并可能以 webserver 权限执行任意代码。","该通告同时给出无认证利用条件、缺失补丁状态和可立即执行的缓解配置，适合工业制冷设备运营方评估暴露风险。",{"_50":83},"2026-11-26T14:15:00.000Z",[239,240,209,252,212],81,"工控","f2312","2026-11-26T15:38:27.030Z",{"_152":256,"_32":257,"_155":258,"_157":259,"_159":260,"_161":261,"_163":254,"_14":188,"_165":262,"_167":223,"_169":170,"_12":171,"_172":-5},"m5ausxhtut34kmi7zcnx0ncei","North Korea关联PolinRider污染超7,600个GitHub仓库传播恶意软件","North Korea关联的PolinRider活动通过劫持开发者账户、提交恶意Pull Request和重写Git历史，向至少7,609个GitHub仓库植入Python加载器，涉及2,330个账户；2026年10月27日至11月6日间已推送至2,040个仓库。","文章还原了PolinRider借助GitHub仓库传播恶意载荷的多条路径，并给出受影响仓库、账户和时间范围，便于识别开发环境供应链风险。",{"_50":51},"2026-11-26T15:13:41.000Z",[191,192,195,224,263,264,196,265],"凭据","供应链","Palo Alto","f2318","2026-11-26T17:40:25.198Z",{"_152":269,"_32":270,"_155":271,"_157":272,"_159":273,"_161":274,"_163":267,"_14":236,"_165":275,"_167":276,"_169":170,"_12":171,"_172":-5},"ezziepbuq0itfxhnntdri5mbl","Drupal 远程代码执行漏洞 CVE-2026-132165 已发现在野利用","Drupal 远程代码执行漏洞 CVE-2026-132165 的 CVSS 评分为 8.1，漏洞细节与 PoC 已公开，并已发现在野利用。未经身份验证的攻击者可访问 core/install.php 重新安装 Drupal，进而替换管理员账户接管站点或实现远程代码执行。","漏洞细节与 PoC 已公开且出现真实利用，文章同时列出受影响版本、检测方法和升级路径，便于站点管理员快速判断并处置。",{"_50":119},"2026-11-26T10:33:00.000Z",[239,209,240,277,278],82,"复现","PHP","f2324","2026-11-27T05:52:22.734Z",{"_152":289,"_32":290,"_155":291,"_157":292,"_159":293,"_161":294,"_163":280,"_14":188,"_165":295,"_167":223,"_169":170,"_12":171,"_172":-5},{"_283":284,"_285":106,"_286":96,"_287":288},"factId","fp-fnSYFFr6o","additionalSourceCount","reportCount","memberIds",[289],"mncekqvys9bm2948z7smxva6n","高仿 DeepSeek 官网借搜索广告批量投毒，下载安装可触发银狐木马","高仿 DeepSeek 官网通过搜索广告诱导用户下载桌面版安装包，部分安装包被指为“银狐”木马，可导致远程控制、微信盗用、流量劫持和文件丢失。","文章结合仿冒站特征、感染症状与银狐木马行为链，整理了个人和企业可采用的分层防护措施。",{"_50":298},"2026-11-27T03:26:00.000Z",[191,192,296,297,195,173],"黑产","钓鱼","安全客","aijwyql360zls29f4sq95jgmab","2026-11-27T06:28:19.860Z",{"_152":302,"_32":303,"_155":304,"_157":305,"_159":306,"_161":307,"_163":300,"_14":188,"_165":308,"_167":190,"_169":170,"_12":171,"_172":-5},"ijwyql360zls29f4sq95jgmab","美国打击全球诈骗团伙，Operation Blackout 查扣近 170 亿美元","美国政府以 800 余名涉嫌诈骗人员、85 个联邦地区和 400 余起案件为对象，开展其称为规模最大的反诈骗行动。","材料汇总了美国跨部门打击全球诈骗团伙的范围、涉案手法与执法成果，并给出受害规模，便于了解诈骗产业链及治理进展。",{"_50":80},"2026-11-27T05:30:28.000Z",[191,296,193,309],"数据泄露","aqsdh0wd9ulfwtz0jempu7h8zj","2026-11-27T06:53:25.529Z",{"_152":313,"_32":314,"_155":315,"_157":316,"_159":317,"_161":318,"_163":311,"_14":188,"_165":319,"_167":251,"_169":170,"_12":171,"_172":-5},"qsdh0wd9ulfwtz0jempu7h8zj","瑞士确认 AI 代理攻击入侵关键基础设施运营机构","瑞士确认 5 起 AI 代理攻击中 4 起已成功入侵，其中 3 起针对关键基础设施运营机构，2 起入侵成功但未报告重大中断。攻击者可自动发现未修补弱点、并行发起攻击并在受阻后切换方法；意大利与英国机构也观察到自主代理在数小时内攻破大量系统。","多国机构披露了 AI 代理自主入侵的相似模式，并给出可操作的补丁、网络暴露面与行为检测建议。",{"_50":51},"2026-11-27T06:04:20.000Z",[191,173,211,176,320],"应急响应","f2326","2026-11-27T06:53:25.538Z",{"_152":110,"_32":327,"_155":328,"_157":329,"_159":330,"_161":331,"_163":332,"_14":236,"_165":333,"_167":334,"_169":170,"_12":171,"_172":-5},{"_283":325,"_285":86,"_286":45,"_287":326},"f6ZAsYycycU8",[110],"Cacti Core 1.2.31 未授权远程代码执行漏洞 QVD-2026-117631 已公开 PoC","Cacti Core 1.2.31 存在未授权远程代码执行漏洞 QVD-2026-117631，攻击者在启用 Guest 账户且可访问 Web 接口时，无需认证即可通过少量 HTTP 请求执行任意命令。","原文给出完整利用链、利用前提和风险资产规模，可帮助读者判断暴露条件并优先处置。",{"_50":116},"2026-11-27T10:05:30.736Z","2026-11-27T11:05:30.770Z",[239,277,210,174,335,336],77,"漏洞管理","奇安信","f2329","2026-11-27T07:42:20.060Z",{"_152":100,"_32":343,"_155":344,"_157":345,"_159":346,"_161":347,"_163":338,"_14":188,"_165":348,"_167":334,"_169":170,"_12":171,"_172":-5},{"_283":341,"_285":86,"_286":45,"_287":342},"fq9_tz6zOSYM",[100],"SAP 确认遭遇网络攻击，GitHub 上的源代码据称被窃取","SAP 确认正在调查一起网络安全事件，称已发现可疑活动并采取了保护客户与服务安全的措施。德国 Der Spiegel 与 DPA 报道称，黑客获取了 SAP 员工的认证 token，可在 GitHub 上复制并篡改源代码；SAP 未披露攻击细节，称截至目前未发现客户业务数据被未授权访问的证据，且尚不明确攻击者是否访问了专有代码。","原文给出了攻击路径的多个环节与 SAP 的处置动作，并明确尚无客户业务数据被访问的证据，便于读者判断风险范围。",{"_50":58},"2026-11-27T07:36:14.000Z",[191,193,264,211],"f2333","2026-11-27T08:30:20.770Z",{"_152":352,"_32":353,"_155":354,"_157":355,"_159":356,"_161":357,"_163":350,"_14":236,"_165":358,"_167":359,"_169":170,"_12":171,"_172":-5},"ac1tlqg3g5b5d0yn83tpuilhf","Linux 内核 NFS 服务器漏洞 CVE-2026-99362 可远程提权，OpenSec 称其为 NFS2ROOT","Linux 内核 NFS 服务器存在堆缓冲区溢出漏洞 CVE-2026-99362，由 ANSSI 的 Jérémy Jean 发现，OpenSec 将其称为 NFS2ROOT 并给出完整的远程 root 利用代码。","文中给出受影响内核版本区间与利用前提，并说明目前尚无在野利用证据，处置与检测线索都较具体。",{"_50":64},"2026-11-27T08:06:58.000Z",[239,277,210,240,360],76,"内核","f2335","2026-11-27T09:44:19.884Z",{"_152":364,"_32":365,"_155":366,"_157":367,"_159":368,"_161":369,"_163":362,"_14":188,"_165":370,"_167":223,"_169":170,"_12":171,"_172":-5},"bp3mhwtmbzqp2s4qlj7c99iek","科罗拉多州 myColorado 应用数据泄露，约 100,000 人可能受影响","科罗拉多州州长信息技术办公室（OIT）披露，攻击者未经授权访问 myColorado 应用数据，约 100,000 人可能受影响。该应用约有 2.1 million 用户，泄露内容位于“myCards and Documents”区段，包括 PDF 文件、政府身份证件、车辆登记和保险卡照片，但未访问支付信息。","事件影响范围、涉及文档类型和处置状态均有明确交代，应用仍处离线状态且通知发放尚在进行。",{"_50":58},"2026-11-27T09:30:54.000Z",[309,191,225,371,372],"云原生","AWS","f2342","2026-11-27T11:05:30.849Z",{"_152":376,"_32":377,"_155":378,"_157":379,"_159":380,"_161":381,"_163":374,"_14":164,"_165":382,"_167":383,"_169":170,"_12":171,"_172":-5},"x6dpauo25s92yme1jotwscvon","Salesforce AI Research 发布 ErosionBench 多智能体评测基准，提出语义对齐衰减与 Meta-Auditor 检测架构","Salesforce AI Research 团队于 2026 年 11 月发布 ErosionBench，提出语义对齐衰减（Semantic Alignment Decay）概念，即多智能体系统在跨会话状态继承与相互引用中逐步偏离用户授权，最终执行未经授权的动作。","把多 Agent 风险从单次提示注入扩展到跨会话状态演化，并用可复现的指标对比了确定性检查与语义监控的取舍。",{"_50":116},"2026-11-26T13:05:30.737Z",[384,173,176,175,174],72,"论文","awxa4qyt8tjvrulxqjudzktvpj","2026-11-27T11:58:22.891Z",{"_152":388,"_32":389,"_155":390,"_157":391,"_159":392,"_161":393,"_163":386,"_14":164,"_165":394,"_167":223,"_169":170,"_12":171,"_172":-5},"wxa4qyt8tjvrulxqjudzktvpj","研究称 GPT-6.1 Sol 与 DeepSeek V4.1 Flash 已能直接推理机器码并修改 ELF64","研究团队让 GPT-6.1 Sol 在无反汇编器、调试器和运行权限的条件下读取 hex dump，4 段程序判断全部正确，并能修改 3 个程序及生成可运行的 ELF64。","文章用机器码读取、程序修改和权重编程实验，说明通用模型正在进入传统逆向分析工具覆盖的原始数据层，同时强调成本、上下文和准确率限制。",{"_50":116},"2026-11-27T10:06:00.000Z",[173,175,174,395,192,196,396],"逆向","Microsoft","f2349","2026-11-27T11:58:23.891Z",{"_152":400,"_32":401,"_155":402,"_157":403,"_159":404,"_161":405,"_163":398,"_14":188,"_165":406,"_167":407,"_169":170,"_12":171,"_172":-5},"jws669bernblo6zw64kxoajjw","DIVD 内网入侵复盘：Zammad 漏洞与 ARP 欺骗注入 PostgreSQL 数据包","荷兰漏洞披露机构 DIVD 的 Zammad 工单系统在 2026 年 9 月 21 日至 22 日被入侵，攻击者用 CVE-2026-102489 与 CVE-2026-102490 完成会话劫持、恶意 ERB 模板 RCE 和本地提权至 root，两项漏洞已列入 CISA KEV，需升级至 Zammad 7.2.2。","复盘把会话劫持、模板执行、提权、ARP 欺骗与数据包注入串成完整链路，并给出 IOC 与响应时间差，适合做同类工单系统失陷的排查参照。",{"_50":410},"2026-11-27T03:43:00.000Z",[191,209,176,211,309,264,408,409,212],84,"Atlassian","CrowdStrike","奇安信威胁情报中心","f2354","2026-11-27T12:44:21.128Z",{"_152":417,"_32":418,"_155":419,"_157":420,"_159":421,"_161":422,"_163":423,"_14":188,"_165":424,"_167":425,"_169":170,"_12":171,"_172":-5},{"_283":415,"_285":106,"_286":96,"_287":416},"f4L8ZnlbpNeo",[417],"wuwxqwmjofamcgppwkw7wuf5s","美国空军 Cloud One 云平台遭入侵，攻击范围与数据失窃情况不明","美国空军主要云计算平台 Cloud One 遭黑客入侵，攻击者身份、受影响范围及数据是否被窃取尚未确认。该事件约在 1 个月前升级平台时被发现，导致服务中断、应用更新被阻止，后台应用迁移至 Cloud One 的工作暂停，部分用户管理员权限被撤销。","报道梳理了Cloud One入侵后的服务中断、迁移暂停与权限处置，并指出控制平面可能被利用，为评估军事云平台事件影响提供事实依据。",{"_50":61},"2026-11-27T15:03:05.000Z","2026-11-27T16:09:30.050Z",[191,309,371,264,372,396,426,196],79,"Oracle","f2362","2026-11-27T17:02:40.965Z",{"_152":430,"_32":431,"_155":432,"_157":433,"_159":434,"_161":435,"_163":428,"_14":188,"_165":436,"_167":223,"_169":170,"_12":171,"_172":-5},"emxtvs4jso1up4wm8nw6pcp6o","疑似越南关联黑客组织 WeaveLotus 借漏洞和弱口令攻击东南亚","SOCRadar 披露，疑似越南关联组织 WeaveLotus 于 2026 年 8 月至 9 月实施 RedOps 间谍活动，针对菲律宾、泰国和印度尼西亚的军方、政府及立法机构收集南海防务与军事协议情报。","文章拆解了针对东南亚目标的入侵链，并给出具体漏洞、持久化方式和外传数据量，便于对照排查暴露服务与异常访问。",{"_50":51},"2026-11-27T16:36:11.000Z",[191,309,263,210,264,265,437,438,439],"Ivanti","Cisco","Fortinet",{"_441":442,"_443":-5},"changelogVersion","2026-10-01T08:00","release"]
