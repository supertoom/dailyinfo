[{"_1":2,"_3":4},"root",{"_5":433},"routes/home",{"_5":6},"data",{"_5":7,"_8":9,"_10":11},{"_8":16,"_17":18,"_19":20,"_21":22,"_23":24},"filters",{"_12":13,"_14":-5,"_15":-5},"expiresAt",1795912591000,"channel","all","category","tag",{"_12":13,"_14":-5,"_15":-5},"cards",[120,121,122,123,124,125,126,127,128,129,130,131,132,133,134,135,136,137,138,139],"nextCursor","tl2.eyJhIjoxNzk1Njk1Nzk5MTg3LCJnIjoiZjIzMDIiLCJiIjoiNDVmNGMxMzc0MWViIn0","dayCounts",{"_114":98,"_115":45,"_116":117,"_118":119},"hot",[25,26,27,28,29],{"_30":98,"_32":99,"_34":100,"_36":37,"_38":101,"_40":102,"_42":103,"_44":31},{"_30":45,"_32":86,"_34":87,"_36":37,"_38":88,"_40":89,"_42":90,"_44":57},{"_30":63,"_32":73,"_34":74,"_36":37,"_38":75,"_40":76,"_42":77,"_44":45},{"_30":57,"_32":58,"_34":59,"_36":37,"_38":60,"_40":61,"_42":62,"_44":63},{"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45},"rank",5,"title","美国空军 Cloud One 平台疑遭控制面入侵","heat",7.3,"trend","down","storyPublicId","7b0a7fe2-a447-47f3-8010-7006dc9f4be8","itemId","wuwxqwmjofamcgppwkw7wuf5s","participants",[46,47],"participantCount",2,{"_48":53,"_50":51,"_52":54,"_55":56},{"_48":49,"_50":51,"_52":-5},"name","Cybernews","kind","editorial","iconUrl","Security Affairs","/dailyinfo/media/ef2b2b57fb06e54f.webp","iconSrcSet","/dailyinfo/media/2adef5b1e4357a03.webp 48w, /dailyinfo/media/ef2b2b57fb06e54f.webp 96w",4,"FIFA确认遭入侵，自称HBHC的组织宣称泄露超12GB数据",10.1,"1ab2de17-8bbc-419b-9dc9-438c6e2bd08b","t50ps5j13a1mvy4ypu8zskb5x",[64,65,66],3,{"_48":70,"_50":51,"_52":71,"_55":72},{"_48":67,"_50":51,"_52":68,"_55":69},{"_48":53,"_50":51,"_52":54,"_55":56},"Infosecurity Magazine","/dailyinfo/media/b3cc9cd29f272a5a.webp","/dailyinfo/media/6406d1b57afc7303.webp 48w, /dailyinfo/media/b3cc9cd29f272a5a.webp 96w","Help Net Security","/dailyinfo/media/06c9ab9de6dbb6a5.webp","/dailyinfo/media/9c1b5fa87b3bafc5.webp 48w, /dailyinfo/media/06c9ab9de6dbb6a5.webp 96w","Q-Dir与DesktopOK安装包投毒植入RAT",11,"78dedd98-a10e-469f-85b1-5badb1cccff8","skgo8xzuovrbxo6vigs2f589d",[78,79],{"_48":83,"_50":51,"_52":84,"_55":85},{"_48":80,"_50":51,"_52":81,"_55":82},"The Hacker News","/dailyinfo/media/3d21685a726d0a64.jpg","/dailyinfo/media/a1e7de8b6809b50e.jpg 48w, /dailyinfo/media/3d21685a726d0a64.jpg 96w","BleepingComputer","/dailyinfo/media/198a4d86de90e233.webp","/dailyinfo/media/3a544a742516b0af.webp 48w, /dailyinfo/media/198a4d86de90e233.webp 96w","SAP确认开发基础设施遭攻击，GitHub代码疑被篡改",12.9,"f277d653-e06d-4b70-92f9-cb4b08781be8","hula7qv4z43seiug59c3dry5x",[91,92,93,94],{"_48":53,"_50":51,"_52":54,"_55":56},{"_48":83,"_50":51,"_52":84,"_55":85},{"_48":95,"_50":51,"_52":96,"_55":97},{"_48":49,"_50":51,"_52":-5},"SecurityWeek","/dailyinfo/media/6f21a015ea489b81.webp","/dailyinfo/media/c2a91b85de7bb9d6.webp 48w, /dailyinfo/media/6f21a015ea489b81.webp 96w",1,"Cacti 1.2.31未授权RCE PoC已公开",16.8,"5f727b7b-3657-4338-b837-306e337b299b","sq959gxd7blu324wq7irv97yz",[104,105,106,107,108],{"_48":113,"_50":51,"_52":-5},{"_48":112,"_50":51,"_52":-5},{"_48":83,"_50":51,"_52":84,"_55":85},{"_48":109,"_50":51,"_52":110,"_55":111},{"_48":80,"_50":51,"_52":81,"_55":82},"安全内参","/dailyinfo/media/77459fcbf8f21e71.webp","/dailyinfo/media/3399ea7b18d18a6a.webp 48w, /dailyinfo/media/77459fcbf8f21e71.webp 96w","奇安信 CERT","绿盟科技CERT","2026-11-29","2026-11-28","2026-11-27",12,"2026-11-26",21,{"_140":421,"_142":422,"_144":423,"_146":-5},{"_140":410,"_142":411,"_144":412,"_146":-5},{"_140":397,"_142":398,"_144":399,"_146":-5},{"_140":382,"_142":383,"_144":384,"_146":385},{"_140":368,"_142":369,"_144":370,"_146":-5},{"_140":356,"_142":357,"_144":358,"_146":-5},{"_140":341,"_142":342,"_144":343,"_146":-5},{"_140":329,"_142":330,"_144":331,"_146":-5},{"_140":317,"_142":318,"_144":319,"_146":-5},{"_140":304,"_142":305,"_144":306,"_146":307},{"_140":288,"_142":289,"_144":290,"_146":291},{"_140":276,"_142":277,"_144":278,"_146":-5},{"_140":264,"_142":265,"_144":266,"_146":-5},{"_140":243,"_142":244,"_144":245,"_146":246},{"_140":230,"_142":231,"_144":232,"_146":-5},{"_140":216,"_142":217,"_144":218,"_146":-5},{"_140":204,"_142":205,"_144":206,"_146":-5},{"_140":190,"_142":191,"_144":192,"_146":-5},{"_140":173,"_142":174,"_144":175,"_146":-5},{"_140":141,"_142":143,"_144":145,"_146":-5},"key","f2302","anchorAt","2026-11-26T12:23:19.187Z","item",{"_147":148,"_32":149,"_150":151,"_152":153,"_154":155,"_156":157,"_158":143,"_14":159,"_160":161,"_162":163,"_164":165,"_12":166,"_167":-5},"group","id","kcwxcgi3mbarz9m115ch1kn3v","Mitel MiCollab 5 个零日漏洞遭在野利用，CISA 已将其纳入 KEV","summary","Mitel MiCollab 5 个漏洞已被用于数据窃取和可能的勒索活动，CISA 将其纳入 KEV，其中 4 个要求联邦机构在 11 月 28 日前处置，另 1 个截止日期为 12 月 9 日。","reason","文章还原了攻击者从 MiCollab 漏洞入侵到身份基础设施的完整路径，并给出补丁时间线与处置期限。","source",{"_48":95},"publishedAt","2026-11-26T11:35:25.000Z","timelineAt","activity","tags",[168,169,170,171,172],"score",85,"selected",true,"news","x","在野利用","漏洞利用","攻击活动","AI 攻防","CISA","f2305","2026-11-26T12:59:19.480Z",{"_147":176,"_32":177,"_150":178,"_152":179,"_154":180,"_156":181,"_158":174,"_14":159,"_160":182,"_162":183,"_164":165,"_12":166,"_167":-5},"en1gv0ci3e610k5ce0nrbau25","Kaspersky 发现 Keenadu 后门预装于超过 220,000 台 Android 设备","Kaspersky 在前 10 个月内于超过 220,000 台 Android 设备中发现 Keenadu；它与 Triada 合计出现在今年检出预装恶意软件设备的 88% 中。","文章拆解了预装恶意软件的供应链入侵路径、潜伏与模块化机制，并提供企业采购前的样本测试建议。",{"_48":70},"2026-11-26T12:57:58.000Z",[184,185,186,187,188,189],75,"恶意软件","后门","供应链投毒","移动端","Kaspersky","数据窃取","f2307","2026-11-26T13:24:20.896Z",{"_147":193,"_32":194,"_150":195,"_152":196,"_154":197,"_156":198,"_158":191,"_14":199,"_160":200,"_162":201,"_164":165,"_12":166,"_167":-5},"a5fzo7vwm6srlhz65h7wxvfw8","Juniper Session Smart Conductor 严重漏洞 CVE-2026-103406 已被利用","Juniper Networks 与 CISA 确认，CVE-2026-103406 已在攻击中被利用，CVSS 9.8。该远程 OS 命令注入漏洞影响 Session Smart Conductor 的 AutomatedProvisionor 服务，攻击者可通过特制 Salt minion ID 以 root 权限执行任意命令。","原文明确披露漏洞已遭利用，并给出受影响版本、修复版本和 CISA 要求的处置时限。",{"_48":95},"2026-11-26T13:04:06.000Z","vuln",[202,168,203,172],80,"漏洞","补丁","awaly7f5cwuea4sg732ir9h5vt","2026-11-26T14:44:23.715Z",{"_147":207,"_32":208,"_150":209,"_152":210,"_154":211,"_156":212,"_158":205,"_14":199,"_160":213,"_162":214,"_164":165,"_12":166,"_167":-5},"waly7f5cwuea4sg732ir9h5vt","Danfoss AK-SM 8xxA Series 控制器曝栈溢出漏洞 CVE-2026-129713，CVSS 9.8","Danfoss AK-SM 8xxA Series 控制器的未认证 CGI 处理器存在栈溢出漏洞 CVE-2026-129713，CVSS 为 9.8，远程攻击者发送特制 HTTP/S POST 请求可导致内存损坏、webserver 重启，并可能以 webserver 权限执行任意代码。","该通告同时给出无认证利用条件、缺失补丁状态和可立即执行的缓解配置，适合工业制冷设备运营方评估暴露风险。",{"_48":67},"2026-11-26T14:15:00.000Z",[202,203,168,215,172],81,"工控","f2312","2026-11-26T15:38:27.030Z",{"_147":219,"_32":220,"_150":221,"_152":222,"_154":223,"_156":224,"_158":217,"_14":159,"_160":225,"_162":183,"_164":165,"_12":166,"_167":-5},"m5ausxhtut34kmi7zcnx0ncei","North Korea关联PolinRider污染超7,600个GitHub仓库传播恶意软件","North Korea关联的PolinRider活动通过劫持开发者账户、提交恶意Pull Request和重写Git历史，向至少7,609个GitHub仓库植入Python加载器，涉及2,330个账户；2026年10月27日至11月6日间已推送至2,040个仓库。","文章还原了PolinRider借助GitHub仓库传播恶意载荷的多条路径，并给出受影响仓库、账户和时间范围，便于识别开发环境供应链风险。",{"_48":80},"2026-11-26T15:13:41.000Z",[170,184,186,185,226,227,228,229],"凭据","供应链","Google","Palo Alto","f2318","2026-11-26T17:40:25.198Z",{"_147":233,"_32":234,"_150":235,"_152":236,"_154":237,"_156":238,"_158":231,"_14":199,"_160":239,"_162":240,"_164":165,"_12":166,"_167":-5},"ezziepbuq0itfxhnntdri5mbl","Drupal 远程代码执行漏洞 CVE-2026-132165 已发现在野利用","Drupal 远程代码执行漏洞 CVE-2026-132165 的 CVSS 评分为 8.1，漏洞细节与 PoC 已公开，并已发现在野利用。未经身份验证的攻击者可访问 core/install.php 重新安装 Drupal，进而替换管理员账户接管站点或实现远程代码执行。","漏洞细节与 PoC 已公开且出现真实利用，文章同时列出受影响版本、检测方法和升级路径，便于站点管理员快速判断并处置。",{"_48":113},"2026-11-26T10:33:00.000Z",[202,168,203,241,242],82,"复现","PHP","f2324","2026-11-27T05:52:22.734Z",{"_147":253,"_32":254,"_150":255,"_152":256,"_154":257,"_156":258,"_158":244,"_14":159,"_160":259,"_162":183,"_164":165,"_12":166,"_167":-5},{"_247":248,"_249":98,"_250":45,"_251":252},"factId","fp-fnSYFFr6o","additionalSourceCount","reportCount","memberIds",[253],"mncekqvys9bm2948z7smxva6n","高仿 DeepSeek 官网借搜索广告批量投毒，下载安装可触发银狐木马","高仿 DeepSeek 官网通过搜索广告诱导用户下载桌面版安装包，部分安装包被指为“银狐”木马，可导致远程控制、微信盗用、流量劫持和文件丢失。","文章结合仿冒站特征、感染症状与银狐木马行为链，整理了个人和企业可采用的分层防护措施。",{"_48":263},"2026-11-27T03:26:00.000Z",[170,184,260,261,186,262],"黑产","钓鱼","AI 安全","安全客","aijwyql360zls29f4sq95jgmab","2026-11-27T06:28:19.860Z",{"_147":267,"_32":268,"_150":269,"_152":270,"_154":271,"_156":272,"_158":265,"_14":159,"_160":273,"_162":274,"_164":165,"_12":166,"_167":-5},"ijwyql360zls29f4sq95jgmab","美国打击全球诈骗团伙，Operation Blackout 查扣近 170 亿美元","美国政府以 800 余名涉嫌诈骗人员、85 个联邦地区和 400 余起案件为对象，开展其称为规模最大的反诈骗行动。","材料汇总了美国跨部门打击全球诈骗团伙的范围、涉案手法与执法成果，并给出受害规模，便于了解诈骗产业链及治理进展。",{"_48":70},"2026-11-27T05:30:28.000Z",[170,260,189,275],74,"数据泄露","aqsdh0wd9ulfwtz0jempu7h8zj","2026-11-27T06:53:25.529Z",{"_147":279,"_32":280,"_150":281,"_152":282,"_154":283,"_156":284,"_158":277,"_14":159,"_160":285,"_162":214,"_164":165,"_12":166,"_167":-5},"qsdh0wd9ulfwtz0jempu7h8zj","瑞士确认 AI 代理攻击入侵关键基础设施运营机构","瑞士确认 5 起 AI 代理攻击中 4 起已成功入侵，其中 3 起针对关键基础设施运营机构，2 起入侵成功但未报告重大中断。攻击者可自动发现未修补弱点、并行发起攻击并在受阻后切换方法；意大利与英国机构也观察到自主代理在数小时内攻破大量系统。","多国机构披露了 AI 代理自主入侵的相似模式，并给出可操作的补丁、网络暴露面与行为检测建议。",{"_48":80},"2026-11-27T06:04:20.000Z",[170,262,171,286,287],"Agent 安全","应急响应","f2326","2026-11-27T06:53:25.538Z",{"_147":102,"_32":295,"_150":296,"_152":297,"_154":298,"_156":299,"_158":300,"_14":199,"_160":301,"_162":183,"_164":165,"_12":166,"_167":-5},{"_247":292,"_249":57,"_250":31,"_251":293},"f6ZAsYycycU8",[294,102],"rfirwc4gz7xd4ktjxcnwoqtre","Cacti 未授权远程代码执行漏洞 QVD-2026-117631 已复现，CVSS 3.1 9.8","Cacti 未授权远程代码执行漏洞 QVD-2026-117631 可由未认证攻击者通过少量 HTTP 请求执行任意命令，影响量为万级，CVSS 3.1 分数为 9.8，奇安信评级高危。","文章给出了完整利用链、利用前提和资产测绘数据，可用于判断暴露范围并落实补丁前缓解措施。",{"_48":112},"2026-11-27T09:24:00.000Z","2026-11-28T17:26:38.876Z",[202,241,169,302,303],"利用链","奇安信","f2329","2026-11-27T07:42:20.060Z",{"_147":89,"_32":310,"_150":311,"_152":312,"_154":313,"_156":314,"_158":305,"_14":159,"_160":315,"_162":316,"_164":165,"_12":166,"_167":-5},{"_247":308,"_249":63,"_250":57,"_251":309},"fq9_tz6zOSYM",[89],"SAP 确认遭遇网络攻击，GitHub 上的源代码据称被窃取","SAP 确认正在调查一起网络安全事件，称已发现可疑活动并采取了保护客户与服务安全的措施。德国 Der Spiegel 与 DPA 报道称，黑客获取了 SAP 员工的认证 token，可在 GitHub 上复制并篡改源代码；SAP 未披露攻击细节，称截至目前未发现客户业务数据被未授权访问的证据，且尚不明确攻击者是否访问了专有代码。","原文给出了攻击路径的多个环节与 SAP 的处置动作，并明确尚无客户业务数据被访问的证据，便于读者判断风险范围。",{"_48":95},"2026-11-27T07:36:14.000Z",[170,189,227,171],77,"f2333","2026-11-27T08:30:20.770Z",{"_147":320,"_32":321,"_150":322,"_152":323,"_154":324,"_156":325,"_158":318,"_14":199,"_160":326,"_162":327,"_164":165,"_12":166,"_167":-5},"ac1tlqg3g5b5d0yn83tpuilhf","Linux 内核 NFS 服务器漏洞 CVE-2026-99362 可远程提权，OpenSec 称其为 NFS2ROOT","Linux 内核 NFS 服务器存在堆缓冲区溢出漏洞 CVE-2026-99362，由 ANSSI 的 Jérémy Jean 发现，OpenSec 将其称为 NFS2ROOT 并给出完整的远程 root 利用代码。","文中给出受影响内核版本区间与利用前提，并说明目前尚无在野利用证据，处置与检测线索都较具体。",{"_48":83},"2026-11-27T08:06:58.000Z",[202,241,169,203,328],76,"内核","f2335","2026-11-27T09:44:19.884Z",{"_147":332,"_32":333,"_150":334,"_152":335,"_154":336,"_156":337,"_158":330,"_14":159,"_160":338,"_162":183,"_164":165,"_12":166,"_167":-5},"bp3mhwtmbzqp2s4qlj7c99iek","科罗拉多州 myColorado 应用数据泄露，约 100,000 人可能受影响","科罗拉多州州长信息技术办公室（OIT）披露，攻击者未经授权访问 myColorado 应用数据，约 100,000 人可能受影响。该应用约有 2.1 million 用户，泄露内容位于“myCards and Documents”区段，包括 PDF 文件、政府身份证件、车辆登记和保险卡照片，但未访问支付信息。","事件影响范围、涉及文档类型和处置状态均有明确交代，应用仍处离线状态且通知发放尚在进行。",{"_48":95},"2026-11-27T09:30:54.000Z",[275,170,187,339,340],"云原生","AWS","f2342","2026-11-27T11:05:30.849Z",{"_147":344,"_32":345,"_150":346,"_152":347,"_154":348,"_156":349,"_158":342,"_14":350,"_160":351,"_162":352,"_164":165,"_12":166,"_167":-5},"x6dpauo25s92yme1jotwscvon","Salesforce AI Research 发布 ErosionBench 多智能体评测基准，提出语义对齐衰减与 Meta-Auditor 检测架构","Salesforce AI Research 团队于 2026 年 11 月发布 ErosionBench，提出语义对齐衰减（Semantic Alignment Decay）概念，即多智能体系统在跨会话状态继承与相互引用中逐步偏离用户授权，最终执行未经授权的动作。","把多 Agent 风险从单次提示注入扩展到跨会话状态演化，并用可复现的指标对比了确定性检查与语义监控的取舍。",{"_48":109},"2026-11-26T13:05:30.737Z","ai-security",[353,262,286,354,355],72,"论文","大模型","技术研究","awxa4qyt8tjvrulxqjudzktvpj","2026-11-27T11:58:22.891Z",{"_147":359,"_32":360,"_150":361,"_152":362,"_154":363,"_156":364,"_158":357,"_14":350,"_160":365,"_162":183,"_164":165,"_12":166,"_167":-5},"wxa4qyt8tjvrulxqjudzktvpj","研究称 GPT-6.1 Sol 与 DeepSeek V4.1 Flash 已能直接推理机器码并修改 ELF64","研究团队让 GPT-6.1 Sol 在无反汇编器、调试器和运行权限的条件下读取 hex dump，4 段程序判断全部正确，并能修改 3 个程序及生成可运行的 ELF64。","文章用机器码读取、程序修改和权重编程实验，说明通用模型正在进入传统逆向分析工具覆盖的原始数据层，同时强调成本、上下文和准确率限制。",{"_48":109},"2026-11-27T10:06:00.000Z",[262,354,355,366,184,228,367],"逆向","Microsoft","f2349","2026-11-27T11:58:23.891Z",{"_147":371,"_32":372,"_150":373,"_152":374,"_154":375,"_156":376,"_158":369,"_14":159,"_160":377,"_162":378,"_164":165,"_12":166,"_167":-5},"jws669bernblo6zw64kxoajjw","DIVD 内网入侵复盘：Zammad 漏洞与 ARP 欺骗注入 PostgreSQL 数据包","荷兰漏洞披露机构 DIVD 的 Zammad 工单系统在 2026 年 9 月 21 日至 22 日被入侵，攻击者用 CVE-2026-102489 与 CVE-2026-102490 完成会话劫持、恶意 ERB 模板 RCE 和本地提权至 root，两项漏洞已列入 CISA KEV，需升级至 Zammad 7.2.2。","复盘把会话劫持、模板执行、提权、ARP 欺骗与数据包注入串成完整链路，并给出 IOC 与响应时间差，适合做同类工单系统失陷的排查参照。",{"_48":381},"2026-11-27T03:43:00.000Z",[170,168,286,171,275,227,379,380,172],84,"Atlassian","CrowdStrike","奇安信威胁情报中心","f2354","2026-11-27T12:44:21.128Z",{"_147":41,"_32":388,"_150":389,"_152":390,"_154":391,"_156":392,"_158":393,"_14":159,"_160":394,"_162":395,"_164":165,"_12":166,"_167":-5},{"_247":386,"_249":98,"_250":45,"_251":387},"f4L8ZnlbpNeo",[41],"美国空军 Cloud One 云平台遭入侵，攻击范围与数据失窃情况不明","美国空军主要云计算平台 Cloud One 遭黑客入侵，攻击者身份、受影响范围及数据是否被窃取尚未确认。该事件约在 1 个月前升级平台时被发现，导致服务中断、应用更新被阻止，后台应用迁移至 Cloud One 的工作暂停，部分用户管理员权限被撤销。","报道梳理了Cloud One入侵后的服务中断、迁移暂停与权限处置，并指出控制平面可能被利用，为评估军事云平台事件影响提供事实依据。",{"_48":53},"2026-11-27T15:03:05.000Z","2026-11-27T16:09:30.050Z",[170,275,339,227,340,367,396,228],79,"Oracle","f2362","2026-11-27T17:02:40.965Z",{"_147":400,"_32":401,"_150":402,"_152":403,"_154":404,"_156":405,"_158":398,"_14":159,"_160":406,"_162":183,"_164":165,"_12":166,"_167":-5},"emxtvs4jso1up4wm8nw6pcp6o","疑似越南关联黑客组织 WeaveLotus 借漏洞和弱口令攻击东南亚","SOCRadar 披露，疑似越南关联组织 WeaveLotus 于 2026 年 8 月至 9 月实施 RedOps 间谍活动，针对菲律宾、泰国和印度尼西亚的军方、政府及立法机构收集南海防务与军事协议情报。","文章拆解了针对东南亚目标的入侵链，并给出具体漏洞、持久化方式和外传数据量，便于对照排查暴露服务与异常访问。",{"_48":80},"2026-11-27T16:36:11.000Z",[170,275,226,169,227,229,407,408,409],"Ivanti","Cisco","Fortinet","f2366","2026-11-28T01:17:29.714Z",{"_147":413,"_32":414,"_150":415,"_152":416,"_154":417,"_156":418,"_158":411,"_14":159,"_160":419,"_162":420,"_164":165,"_12":166,"_167":-5},"fvrqffd9ourqoe70wou50cp6c","意大利伪造政府应用利用 Morpheus 间谍软件监控寻求庇护者","IrpiMedia 调查称，意大利内政部标识的 Android 应用 FirmaDigitale 伪装成庇护者保护状态通知，实际投递 Morpheus 间谍软件。","调查将伪装政府应用与 Morpheus 间谍软件关联起来，并披露意大利监控工具供应商、授权范围和审查薄弱等背景。",{"_48":53},"2026-11-28T00:08:30.000Z",[170,184,185,189,187,261],70,"f2368","2026-11-28T20:26:35.816Z",{"_147":424,"_32":425,"_150":426,"_152":427,"_154":428,"_156":429,"_158":422,"_14":199,"_160":430,"_162":327,"_164":165,"_12":166,"_167":-5},"a3qinevddrodxn0pt9a1gi27v","Ubuntu 更新 Apache HTTP Server 漏洞并修复重定向 Cookie 回归问题","Ubuntu 发布 Apache HTTP Server 安全更新，修复 CVE-2026-46729、CVE-2026-47360、CVE-2026-48005、CVE-2026-56153、CVE-2026-56449、CVE-2026-56154、CVE-2026-57941、CVE-2026-59797、CVE-2026-58415、CVE-2026-63045、CVE-2026-63292、CVE-2026-63686、CVE-2026-63718、CVE-2026-73636、CVE-2026-73637、CVE-2026-79768 和 CVE-2026-93546，涉及拒绝服务、任意代码执行、敏感信息泄露、认证绕过及 HTTP 响应走私等风险。受影响版本覆盖 Ubuntu 14.04 LTS、16.04 LTS、18.04 LTS、20.04 LTS、22.04 LTS、24.04 LTS、26.04 LTS 和 26.10，部分漏洞仅影响 Ubuntu 26.10。USN-9016-1 的上游修复还引入在特定情况下阻止重定向设置 Cookie 的回归问题，本次更新一并修复。","公告汇总 Apache HTTP Server 多项漏洞及各自影响范围，并说明上游修复引入的重定向 Cookie 回归问题。",{"_48":432},"2026-11-26T22:34:55.000Z",[203,202,431],"Ubuntu","Ubuntu 安全公告",{"_434":435,"_436":-5},"changelogVersion","2026-10-01T08:00","release"]
