tyWeek","/dailyinfo/media/6f21a015ea489b81.webp","/dailyinfo/media/c2a91b85de7bb9d6.webp 48w, /dailyinfo/media/6f21a015ea489b81.webp 96w","Infosecurity Magazine","/dailyinfo/media/b3cc9cd29f272a5a.webp","/dailyinfo/media/6406d1b57afc7303.webp 48w, /dailyinfo/media/b3cc9cd29f272a5a.webp 96w","SCKit攻击波及48家机构端点",29.9,"flat","4c4f0d1f-c78b-4aee-8605-fa5f25c7bd8c","ihb325l23pcss0skikvuxyfi2",[87,88,89,90],{"_49":58,"_51":52,"_53":59,"_56":60},{"_49":54,"_51":52,"_53":55,"_56":57},{"_49":75,"_51":52,"_53":76,"_56":77},{"_49":91,"_51":52,"_53":-5},"Cybernews",2,"wfx-loot借GitHub令牌窃取CI凭据",36.6,"bfdc6f86-491d-43b2-8633-af8a571001fd","m2uopbxw2xg55pf3fx6t03uwr",[98,99,100,101,102],{"_49":58,"_51":52,"_53":59,"_56":60},{"_49":75,"_51":52,"_53":76,"_56":77},{"_49":103,"_51":52,"_53":104,"_56":105},{"_49":54,"_51":52,"_53":55,"_56":57},{"_49":91,"_51":52,"_53":-5},"Help Net Security","/dailyinfo/media/06c9ab9de6dbb6a5.webp","/dailyinfo/media/9c1b5fa87b3bafc5.webp 48w, /dailyinfo/media/06c9ab9de6dbb6a5.webp 96w",1,"Apache mod_http2竞态RCE已修复",38.3,"f7ee3fa3-8470-4dc6-9f4b-db1dac75a093","itghrl24hjsfp7ov68trhdxf5",[112,113,114,115,116],{"_49":120,"_51":52,"_53":121,"_56":122},{"_49":58,"_51":52,"_53":59,"_56":60},{"_49":75,"_51":52,"_53":76,"_56":77},{"_49":117,"_51":52,"_53":118,"_56":119},{"_49":54,"_51":52,"_53":55,"_56":57},"Praetorian Blog","/dailyinfo/media/586406153d4bc723.webp","/dailyinfo/media/2318a408f42b161b.webp 48w, /dailyinfo/media/586406153d4bc723.webp 96w","Horizon3.ai","/dailyinfo/media/af82bed48a1365af.webp","/dailyinfo/media/697d1fd5f2d392a5.webp 48w, /dailyinfo/media/af82bed48a1365af.webp 96w","2026-11-13",13,"2026-11-12",24,{"_147":432,"_149":433,"_151":434,"_153":-5},{"_147":420,"_149":421,"_151":422,"_153":-5},{"_147":408,"_149":409,"_151":410,"_153":-5},{"_147":396,"_149":397,"_151":398,"_153":-5},{"_147":380,"_149":381,"_151":382,"_153":-5},{"_147":369,"_149":370,"_151":371,"_153":-5},{"_147":358,"_149":359,"_151":360,"_153":-5},{"_147":344,"_149":345,"_151":346,"_153":-5},{"_147":333,"_149":334,"_151":335,"_153":-5},{"_147":317,"_149":318,"_151":319,"_153":320},{"_147":303,"_149":304,"_151":305,"_153":-5},{"_147":291,"_149":292,"_151":293,"_153":-5},{"_147":279,"_149":280,"_151":281,"_153":-5},{"_147":261,"_149":262,"_151":263,"_153":-5},{"_147":249,"_149":250,"_151":251,"_153":-5},{"_147":224,"_149":225,"_151":226,"_153":227},{"_147":212,"_149":213,"_151":214,"_153":-5},{"_147":199,"_149":200,"_151":201,"_153":-5},{"_147":180,"_149":181,"_151":182,"_153":-5},{"_147":148,"_149":150,"_151":152,"_153":-5},"key","aqd7xgce2grpxnrdp2rggpggbf","anchorAt","2026-11-12T14:16:22.337Z","item",{"_154":155,"_32":156,"_157":158,"_159":160,"_161":162,"_163":164,"_165":150,"_14":166,"_167":168,"_169":170,"_171":172,"_12":173,"_174":-5},"group","id","qd7xgce2grpxnrdp2rggpggbf","Europol 联合九国查封 Gootloader、CastleRAT 和 StealC 基础设施，收回逾 600 万组被盗凭据","summary","Europol 联合九国警方本周查封 Gootloader、CastleRAT 和 StealC 恶意软件运营背后的 235 台服务器和 257 个域名，并收回感染计算机上盗取的 600 多万组凭据，缴获的凭据此前被出售并用于进一步攻击和勒索。","reason","此次行动同时给出被查恶意软件的分工、缴获规模与凭据流向，并明确受影响者可借助通知服务和账户加固措施处置风险。","source",{"_49":103},"publishedAt","2026-11-12T13:34:14.000Z","timelineAt","activity","tags",[175,176,177,178,179],"score",78,"selected",true,"news","x","攻击活动","恶意软件","凭据","数据窃取","勒索","f1188","2026-11-12T14:30:23.436Z",{"_154":183,"_32":184,"_157":185,"_159":186,"_161":187,"_163":188,"_165":181,"_14":166,"_167":189,"_169":190,"_171":172,"_12":173,"_174":-5},"y898vv9xn8ef61ymi2wwi96ss","Check Point Security Gateway 遭 PHP2Shell 在野利用，CVE-2026-123039 被用于提权","攻击者自 2026 年 10 月 30 日起利用未修补的 Check Point Security Gateway Mobile Access 门户开展扫描与利用，以 PHP2Shell 及 CVE-2026-109618、CVE-2026-109619 获取初始访问，再利用 DynamicCLI 接口的本地提权漏洞 CVE-2026-123039 提权至 root。","文章还原了从 PHP2Shell 初始访问、权限提升到后门驻留与破坏的完整链路，并公开相关 IOC，便于防守方识别和处置。",{"_49":198},"2026-11-12T13:56:37.000Z",[175,191,176,192,193,178,194,195,196,197],86,"在野利用","后门","漏洞利用","Check Point","VMware","Ivanti","Palo Alto","Check Point Research","f1190","2026-11-12T14:33:27.342Z",{"_154":202,"_32":203,"_157":204,"_159":205,"_161":206,"_163":207,"_165":200,"_14":166,"_167":208,"_169":209,"_171":172,"_12":173,"_174":-5},"ds03g4k6eknewon9ob4w2q2ms","攻击者借合法令牌污染 61,764 个 GitHub 仓库窃取凭据","攻击者利用开发者与机器人账号的有效令牌，通过探测 Pull Request 测试对 61,764 个 GitHub 仓库的访问和修改权限，并在可执行恶意代码的仓库中植入凭据窃取程序。","材料揭示了攻击者如何借合法令牌污染 GitHub 工作流和软件包，并给出令牌吊销、凭据轮换及云端排查方向。",{"_49":75},"2026-11-12T13:39:03.000Z",[175,176,178,210,177,211],76,"供应链投毒","云原生","aohahdz50two1ss8ys84ql8eef","2026-11-12T14:34:23.833Z",{"_154":215,"_32":216,"_157":217,"_159":218,"_161":219,"_163":220,"_165":213,"_14":166,"_167":221,"_169":222,"_171":172,"_12":173,"_174":-5},"ohahdz50two1ss8ys84ql8eef","Enea披露SilentAir劫持亚洲电信运营商，拦截台湾用户通话与短信","Enea披露国家级组织SilentAir自2025年初起利用至少6个亚洲国家运营商被劫持设备发起SS7与Diameter攻击，目标延伸至另外12个国家和地区，主要拦截台湾订户通话与短信，拦截活动占其行为的18.30%，并在部分目标拦截开始数秒后获得2FA代码。","Enea披露了跨至少6个亚洲国家运营商的SS7与Diameter攻击，并给出18.30%拦截占比、2FA代码时序和GTPDoor回退机制等可核验细节。",{"_49":78},"2026-11-12T14:30:00.000Z",[175,192,176,178,223],71,"网络设备","f1194","2026-11-12T15:06:22.538Z",{"_154":234,"_32":236,"_157":237,"_159":238,"_161":239,"_163":240,"_165":241,"_14":166,"_167":242,"_169":243,"_171":172,"_12":173,"_174":-5},{"_228":229,"_230":106,"_231":92,"_232":233},"factId","fhpkP77QKZXQ","additionalSourceCount","reportCount","memberIds",[234,235],"pwalod9qlwcnq38r5ae1i2ani","n6pi1tdjvgsvckwcfst1grkbm","攻击者利用 Cairn 自主攻击半导体、国防及公民社会机构","Unit 42 披露，中文使用者于 2026 年 8 月至 9 月利用开源 AI 渗透测试框架 Cairn，结合 Zhipu GLM 5.2 与 DeepSeek V4 Flash/Pro，针对至少 19 家机构自主执行 25 次行动。","原文还原了自主 AI 框架的编排机制与攻击结果，并说明其利用的仍是已知身份与配置缺陷，便于评估类似攻击的规模效应。",{"_49":248},"2026-11-12T15:00:31.000Z","2026-11-12T15:34:27.066Z",[175,244,245,177,246,247,197],87,"AI 攻防","大模型","供应链","数据泄露","Unit 42","f1196","2026-11-12T15:07:22.581Z",{"_154":252,"_32":253,"_157":254,"_159":255,"_161":256,"_163":257,"_165":250,"_14":166,"_167":258,"_169":222,"_171":172,"_12":173,"_174":-5},"c67s4bpd4xqt0sv4pl6t8xk82","Apify 内部系统遭未授权访问，轮换 API 令牌并重置 2FA","Apify 在 11 月 9 日至 10 日检测到未授权第三方访问其部分内部系统，随后撤销内部凭据、轮换 API 令牌、重置全部活动会话，并断开 GitHub 等外部 OAuth 集成。受影响客户将收到邮件，被通知重新连接；公司称未发现平台存储的账户数据受影响，但建议客户重置 2FA，并称 API 令牌和 Apify Proxy 密码已被轮换、密码仍安全，2FA 码可能已暴露。","事件时间、凭据轮换与 2FA 处置均有明确说明，读者可据此识别自身是否需要重置凭据。",{"_49":58},"2026-11-12T14:36:47.000Z",[175,247,177,259,260],"身份与访问","应急响应","f1211","2026-11-12T15:33:26.689Z",{"_154":264,"_32":265,"_157":266,"_159":267,"_161":268,"_163":269,"_165":262,"_14":270,"_167":271,"_169":209,"_171":172,"_12":173,"_174":-5},"gj57fff8izxf8izlqj80x17m3","Apache mod_http2 竞态条件 CVE-2026-119618 利用条件分析","Apache HTTP Server 的 mod_http2 模块存在竞态条件 CVE-2026-119618，可导致堆内存损坏和无需认证的远程代码执行，影响 Apache HTTP Server 2.4.55 至 2.4.70 及独立 mod_h2 2.0.8 至 2.0.42。","文章结合官方通告与 Red Hat 评估梳理利用条件，并给出识别 HTTP/2 暴露、升级版本和临时降级的处置方法。",{"_49":117},"2026-11-12T14:16:26.000Z","vuln",[272,273,274,275,223,276,277,278],"漏洞","漏洞分析","补丁","复现","容器","Red Hat","Oracle","f1215","2026-11-12T16:07:22.398Z",{"_154":282,"_32":283,"_157":284,"_159":285,"_161":286,"_163":287,"_165":280,"_14":270,"_167":288,"_169":289,"_171":172,"_12":173,"_174":-5},"azhhxogo2ze95f84syty9k82z","Windows CLFS 漏洞 SignDrop 可借助特权进程获取 SYSTEM 权限","安全研究员 Abdelhamid Naceri 公开了 Windows CLFS 漏洞 SignDrop 的 PoC，可诱导 Windows Defender 等特权进程创建认证文件并借此获取 SYSTEM 权限。","文章给出了 SignDrop 的文件创建与权限提升链、PoC 验证方法及适用条件，便于研究人员理解该漏洞的利用逻辑。",{"_49":58},"2026-11-12T16:04:00.000Z",[272,275,193,191,290],77,"Microsoft","adu1ke342yzyvzy72oam3q5c5w","2026-11-12T16:22:23.708Z",{"_154":294,"_32":295,"_157":296,"_159":297,"_161":298,"_163":299,"_165":292,"_14":270,"_167":300,"_169":301,"_171":172,"_12":173,"_174":-5},"du1ke342yzyvzy72oam3q5c5w","Citrix 修复 NetScaler 与 Secure Access Client 的 12 个漏洞，含认证绕过","Citrix 修复 NetScaler ADC、NetScaler Gateway、NetScaler Console 及 Secure Access Client 的 12 个漏洞，其中 CVE-2026-120869 可让未认证攻击者绕过 NetScaler Console 认证控制，另有 Windows 与 Linux 客户端权限提升漏洞。","原文集中列出 12 个漏洞的触发配置、CVSS 分数和修复版本，便于相关部署按实际配置核对并更新。",{"_49":54},"2026-11-12T15:38:49.000Z",[272,274,259,223,302],75,"Citrix","f1216","2026-11-12T16:22:23.715Z",{"_154":306,"_32":307,"_157":308,"_159":309,"_161":310,"_163":311,"_165":304,"_14":166,"_167":312,"_169":313,"_171":172,"_12":173,"_174":-5},"eauhnt9j6z8y871dfnos01sf4","186 个仿冒 AI 域名投递 ClickFix、Net Guard 与搜索劫持扩展","Island 发现一项代号为 TypoPrompting 的攻击活动，利用 186 个仿冒 AI 域名覆盖 27 个品牌，以 ClickFix 诱饵、Net Guard 浏览器劫持恶意软件和搜索劫持扩展三条路径实施攻击。","文章拆解了仿冒 AI 域名如何分别投递 ClickFix、Net Guard 和搜索劫持扩展，并给出域名、品牌、扩展用户数与流量转手链条等可核对细节。",{"_49":54},"2026-11-12T15:15:40.000Z",[175,176,314,315,245,178,316,290],72,"黑产","浏览器","Google","f1217","2026-11-12T16:22:23.721Z",{"_154":324,"_32":325,"_157":326,"_159":327,"_161":328,"_163":329,"_165":330,"_14":166,"_167":331,"_169":332,"_171":172,"_12":173,"_174":-5},{"_228":321,"_230":106,"_231":92,"_232":322},"fVVoyiSN8gs4",[323,324],"os7855wmu7u8h554m5er9zy6t","h2occksxu7q3tzi57634syb7r","SCKit 蠕虫式恶意软件借 ScreenConnect 攻击 MSP，尝试反向感染技术人员","SCKit 是由 16 个脚本和组件组成的蠕虫式工具包，目标是在近期针对托管服务提供商（MSP）的 ScreenConnect 攻击中建立持久访问并横向扩散。","分析还原了 SCKit 从客户终端反向感染 MSP 技术人员工作站的链条及关键组件，同时说明利用尝试在已修复客户端上失败。",{"_49":58},"2026-11-12T22:53:10.000Z","2026-11-12T23:40:23.751Z",[175,176,191,193,246],82,"am65kuksej3ixs6woqeeqh6iqf","2026-11-12T17:21:24.579Z",{"_154":336,"_32":337,"_157":338,"_159":339,"_161":340,"_163":341,"_165":334,"_14":270,"_167":342,"_169":343,"_171":172,"_12":173,"_174":-5},"m65kuksej3ixs6woqeeqh6iqf","Red Hat Quay 严重漏洞 CVE-2026-123710 和 CVE-2026-110697 可读取及覆盖私有镜像","Red Hat Quay 的 CVE-2026-123710（CVSS 9.8）和 CVE-2026-110697（CVSS 9.9）可分别借助信任密钥和 robot account 令牌枚举读取、推送或覆盖私有镜像，影响 Quay 3、Quay 5 全部版本及 8 个 Quay 3 分支的修复版本。","文章梳理了两项 Quay 严重漏洞的利用链、影响范围和临时缓解措施，便于部署者核对版本并优先处置暴露的镜像仓库。",{"_49":54},"2026-11-12T16:27:01.000Z",[272,274,273,276,246,277],79,"f1222","2026-11-12T17:24:24.135Z",{"_154":347,"_32":348,"_157":349,"_159":350,"_161":351,"_163":352,"_165":345,"_14":270,"_167":353,"_169":354,"_171":172,"_12":173,"_174":-5},"ppwfb9ug92t2jde5yzacrazq5","Siemens 多款楼宇自动化与能源产品受 php2shell 漏洞影响","Siemens 多款楼宇自动化与能源产品受 PHP 核心运行时远程代码执行漏洞 CVE-2026-109618 和 CVE-2026-109619 影响，攻击无需认证；前者 CVSS v3.1 为 9.8，后者为 8.1。","公告按产品列明受影响范围、漏洞触发机制与处置状态，可用于核对 Siemens 能源和楼宇自动化设备的升级优先级。",{"_49":357},"2026-11-12T12:00:00.000Z",[272,274,355,356,290,277],73,"工控","PHP","CISA 安全公告","f1223","2026-11-12T17:24:24.141Z",{"_154":361,"_32":362,"_157":363,"_159":364,"_161":365,"_163":352,"_165":359,"_14":270,"_167":366,"_169":222,"_171":172,"_12":173,"_174":-5},"ojwlpm2lgrlu73lx8jhuqda1a","Siemens Industrial Edge Management 受 CVE-2026-111497 影响，CVSS 9.8","Siemens Industrial Edge Management 多项组件受 Brotli 解码器越界写漏洞 CVE-2026-111497 影响，CVSS v3.1 为 9.8，严重级别为 CRITICAL。","公告区分了无需处置与需采取缓解措施的部署场景，并列出各组件可用补丁和受影响版本，便于工控资产快速核对。",{"_49":357},[272,274,355,246,367,368],"加固","CISA","f1226","2026-11-12T18:20:23.707Z",{"_154":372,"_32":373,"_157":374,"_159":375,"_161":376,"_163":377,"_165":370,"_14":270,"_167":378,"_169":313,"_171":172,"_12":173,"_174":-5},"vg18mgfk9qqhb8fj6zco29xou","SignDrop PoC 利用 Windows CLFS 认证机制实现 SYSTEM 权限提升","研究者 MSNightmare 公开 SignDrop PoC，利用 Windows Common Log File System 驱动创建 .cnpf 伴生文件时的路径重定向，使标准用户获得可写的 SYSTEM 文件并可链式启动 SYSTEM shell。","文章拆解了 SignDrop 利用 CLFS 伴生文件路径重定向取得 SYSTEM 权限的链条，并给出验证结果、配置范围与临时判断方法。",{"_49":54},"2026-11-12T17:50:27.000Z",[272,275,193,379,290,368],"技术研究","aedurf4tg7pqutthgj06kgkobl","2026-11-12T19:38:28.676Z",{"_154":383,"_32":384,"_157":385,"_159":386,"_161":387,"_163":388,"_165":381,"_14":389,"_167":390,"_169":313,"_171":172,"_12":173,"_174":-5},"edurf4tg7pqutthgj06kgkobl","Microsoft 研究后训练供应链攻击如何通过数据集与模型投毒劫持编码 Agent","Microsoft Defender Research 与 Microsoft AI Red Team 发现，编码 Agent 可被数据集投毒或恶意模型检查点植入后门，通过普通用户请求、文件名、代码注释或工具结果触发危险工具调用。","两项研究分别拆解数据集投毒与模型投毒的 Agent 后门机制，并给出模型准入、工具权限和运行时监控的防护路径。",{"_49":395},"2026-11-12T17:00:00.000Z","ai-security",[391,392,393,394,379,192,290],"AI 安全","AI 供应链","模型安全","Agent 安全","Microsoft Security Blog","f1238","2026-11-12T20:07:22.740Z",{"_154":399,"_32":400,"_157":401,"_159":402,"_161":403,"_163":404,"_165":397,"_14":166,"_167":405,"_169":406,"_171":172,"_12":173,"_174":-5},"nfe40jld0azdyvkuu4pkr1p7u","N-able N-central 4EverAble2Shell 零日漏洞已被利用，21 台服务器失陷","攻击者已利用 N-able N-central 的 4EverAble2Shell 漏洞攻陷至少 21 台生产服务器，其中 19 台运行 2026.4.1.26。","多家安全公司观测到完整利用链并确认生产服务器失陷，文中还给出了受影响版本、请求路径与排查线索。",{"_49":58},"2026-11-12T19:51:16.000Z",[175,191,193,176,407,178],80,"挖矿","atthpdpwhuywrbj6runx9i9ryn","2026-11-12T23:14:23.116Z",{"_154":411,"_32":412,"_157":413,"_159":414,"_161":415,"_163":416,"_165":409,"_14":270,"_167":417,"_169":209,"_171":172,"_12":173,"_174":-5},"tthpdpwhuywrbj6runx9i9ryn","PostgreSQL 18.7 等版本修复 52 个漏洞并终止 PostgreSQL 14 支持","PostgreSQL Global Development Group 于 November 12 发布 PostgreSQL 18.7、17.12、16.16、15.20 和 14.25，修复 52 个安全漏洞及 140 多个其他缺陷，其中 32 个 CVE 的 CVSS 分为 8.8。","原文列出了多版本修复范围、漏洞评分和升级后索引处理事项，便于管理员评估维护与迁移工作。",{"_49":103},"2026-11-12T23:05:33.000Z",[272,274,418,419],"数据库","漏洞管理","f1268","2026-11-12T23:39:24.379Z",{"_154":423,"_32":424,"_157":425,"_159":426,"_161":427,"_163":428,"_165":421,"_14":429,"_167":430,"_169":209,"_171":172,"_12":173,"_174":-5},"ychw6bek6sbholn90ux3rcvl3","Pillow TIFF 与 EXIF 解析存在重叠标签数据内存耗尽漏洞","Pillow 的 `ImageFileDirectory_v2.load()` 存在内存耗尽漏洞：恶意 TIFF、PNG、JPEG、WebP 或 MPO 文件可通过重叠标签数据，使内存占用按“条目数 × 文件大小”增长。","文章给出可复现的内存放大机制、跨格式影响范围与补丁方案，便于评估 Pillow 服务遭遇拒绝服务的风险。",{"_49":431},"2026-11-12T23:35:39.000Z","disclosure",[379,275,273],"GitHub 安全公告","f1269","2026-11-12T23:39:24.387Z",{"_154":435,"_32":436,"_157":437,"_159":438,"_161":439,"_163":440,"_165":433,"_14":270,"_167":441,"_169":209,"_171":172,"_12":173,"_174":-5},"lpork1fvur2f6uit9eo593pgd","Pillow libtiff 编码器堆缓冲区溢出分析与修复方案","Pillow 通过 libtiff 保存 TIFF 时，攻击者控制的 EXIF、tiffinfo 或源文件 IFD 几何标签可覆盖实际图像尺寸，导致 libtiff 按标签尺寸读取或写入行缓冲区。","文章从标签合并与扫描行缓冲区尺寸不一致这一根因出发，梳理了内存泄露、崩溃和堆破坏路径，并给出两套可直接验证的修复方案。",{"_49":431},"2026-11-12T23:34:43.000Z",[272,275,274,273,247],{"_443":444,"_445":-5},"changelogVersion","2026-10-01T08:00","release"]
