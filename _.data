漏洞被串联利用",22.1,"up","7b68ec92-29a4-4b08-8b7d-6c1631d5b488","m2hxnar81fkukx8bj4wepsqav",[80,81,82],{"_48":83,"_50":51,"_52":84,"_54":85},{"_48":67,"_50":51,"_52":68,"_54":69},{"_48":70,"_50":51,"_52":71,"_54":72},"Rapid7 CVE 公告","/dailyinfo/media/092fbeae5b5c3123.webp","/dailyinfo/media/c16323cf53c574df.webp 48w, /dailyinfo/media/092fbeae5b5c3123.webp 96w","Chainalysis确认智能体化入侵事件",30.7,"038a18c5-a6fe-4fe6-89fe-22bf5ade225b","btm8xleyom7oe4i1g5guvwvtl",[91,92,93,94],{"_48":98,"_50":51,"_52":99,"_54":100},{"_48":95,"_50":51,"_52":96,"_54":97},{"_48":70,"_50":51,"_52":71,"_54":72},{"_48":67,"_50":51,"_52":68,"_54":69},"Infosecurity Magazine","/dailyinfo/media/b3cc9cd29f272a5a.webp","/dailyinfo/media/6406d1b57afc7303.webp 48w, /dailyinfo/media/b3cc9cd29f272a5a.webp 96w","Help Net Security","/dailyinfo/media/06c9ab9de6dbb6a5.webp","/dailyinfo/media/9c1b5fa87b3bafc5.webp 48w, /dailyinfo/media/06c9ab9de6dbb6a5.webp 96w",1,"FBI归因TraderTraitor窃取Binance资产",40.6,"6ef2ec24-f871-4ca2-9cc2-5fcbd249af24","uu0z6mo1muhhj4bo1sst643w9",[108,109,110,111,112,113],6,{"_48":95,"_50":51,"_52":96,"_54":97},{"_48":98,"_50":51,"_52":99,"_54":100},{"_48":67,"_50":51,"_52":68,"_54":69},{"_48":70,"_50":51,"_52":71,"_54":72},{"_48":49,"_50":51,"_52":53,"_54":55},{"_48":56,"_50":51,"_52":57,"_54":58},"2026-11-02","2026-11-01","2026-10-31",13,{"_138":446,"_140":447,"_142":448,"_144":-5},{"_138":434,"_140":435,"_142":436,"_144":-5},{"_138":423,"_140":424,"_142":425,"_144":-5},{"_138":412,"_140":413,"_142":414,"_144":-5},{"_138":400,"_140":401,"_142":402,"_144":-5},{"_138":387,"_140":388,"_142":389,"_144":-5},{"_138":372,"_140":373,"_142":374,"_144":-5},{"_138":353,"_140":354,"_142":355,"_144":356},{"_138":339,"_140":340,"_142":341,"_144":-5},{"_138":323,"_140":324,"_142":325,"_144":326},{"_138":307,"_140":308,"_142":309,"_144":310},{"_138":286,"_140":287,"_142":288,"_144":289},{"_138":270,"_140":271,"_142":272,"_144":273},{"_138":247,"_140":248,"_142":249,"_144":250},{"_138":233,"_140":234,"_142":235,"_144":-5},{"_138":221,"_140":222,"_142":223,"_144":-5},{"_138":209,"_140":210,"_142":211,"_144":-5},{"_138":186,"_140":187,"_142":188,"_144":189},{"_138":171,"_140":172,"_142":173,"_144":-5},{"_138":139,"_140":141,"_142":143,"_144":-5},"key","f352","anchorAt","2026-10-30T17:45:18.329Z","item",{"_145":146,"_32":147,"_148":149,"_150":151,"_152":153,"_154":155,"_156":141,"_14":157,"_158":159,"_160":161,"_162":163,"_12":164,"_165":-5},"group","id","s5wtznsv3satv8meiqmvkzkq3","joserfc 1.7.4 JWE recipients 无界数组引发 CPU 耗尽","summary","joserfc 1.7.4 的 `joserfc.jwe.decrypt_json()` 未限制 JWE General JSON 的 `recipients` 数量，每个条目都会触发一次 RSA 私钥解密，未认证攻击者可借较小请求放大服务端 CPU 开销。","reason","文章通过源码调用链和容器化 PoC 展示了无界 recipients 数组放大 RSA 解密开销的机制，便于评估服务暴露条件与缓解效果。","source",{"_48":170},"publishedAt","2026-10-30T14:54:20.000Z","timelineAt","vuln","tags",[166,167,168,169],"score",70,"selected",true,"news","x","漏洞","复现","漏洞利用","技术研究","GitHub 安全公告","f355","2026-10-30T17:48:15.917Z",{"_145":174,"_32":175,"_148":176,"_150":177,"_152":178,"_154":179,"_156":172,"_14":180,"_158":181,"_160":182,"_162":163,"_12":164,"_165":-5},"els1gzklnlhxhh0k15ljle1lp","Rapid7 分析 BeyondTrust Remote Support 未认证文件上传至 RCE 漏洞 CVE-2026-102764","Rapid7 分析 BeyondTrust Remote Support 的来源校验缺陷 CVE-2026-102764，未认证攻击者可伪造本地消息来源，访问原生文件传输服务，写入任意文件并以站点操作系统用户身份执行代码，无需账户凭据或用户交互。","文章从消息来源伪造到文件写入、PHP 执行逐段拆解利用链，并给出 Metasploit 模块与多类日志的排查要点，便于安全团队理解和检测该风险。",{"_48":83},"2026-10-30T16:01:53.000Z","disclosure",[169,183,167,168,184,185],77,"漏洞分析","利用链","Rapid7","f356","2026-10-30T18:57:15.938Z",{"_145":78,"_32":197,"_148":198,"_150":199,"_152":200,"_154":201,"_156":187,"_14":157,"_158":202,"_160":161,"_162":163,"_12":164,"_165":-5},{"_190":191,"_192":101,"_193":45,"_194":195},"factId","fHtxLTvYwTdg","additionalSourceCount","reportCount","memberIds",[196,78],"y99tzoeuwzoi070f2rfcc5ru1","CISA 将两项 Ivanti Connect Secure 漏洞纳入 KEV Catalog","CISA 基于真实利用证据，将 Ivanti Connect Secure 的 CVE-2026-111357（关键功能缺失认证）和 CVE-2026-118527（可预测数字或标识符生成漏洞）纳入 KEV Catalog。","两项 Ivanti Connect Secure 漏洞已有真实利用证据，并被纳入 KEV Catalog，读者可据此核对资产暴露与修复优先级。",{"_48":208},"2026-10-30T12:00:00.000Z",[203,204,205,206,207],"在野利用","漏洞管理","补丁","Ivanti","CISA","CISA 安全公告","avlrtoue70s86b9kd5x4xc1iep","2026-10-30T21:50:19.239Z",{"_145":212,"_32":213,"_148":214,"_150":215,"_152":216,"_154":217,"_156":210,"_14":157,"_158":218,"_160":219,"_162":163,"_12":164,"_165":-5},"vlrtoue70s86b9kd5x4xc1iep","CISA 将 GitLab CVE-2026-97229 与 Cisco CVE-2026-76418 加入 KEV 目录","CISA 将 GitLab 与 Cisco 的 2 个漏洞加入 KEV 目录，并要求 FCEB 机构在 2026 年 11 月 1 日前完成处置。","材料同时给出漏洞利用前提、受影响版本和真实攻击迹象，可用于判断 GitLab 与 Cisco 设备是否需要优先处置。",{"_48":70},"2026-10-30T20:25:14.000Z",[166,203,205,204,220,207],80,"Cisco","f386","2026-10-30T23:34:14.742Z",{"_145":224,"_32":225,"_148":226,"_150":227,"_152":228,"_154":229,"_156":222,"_14":157,"_158":230,"_160":231,"_162":163,"_12":164,"_165":-5},"bgct23sln3v94uqcpsqtd9kwd","@hapi/content 6.0.2 及更早版本 Content-Disposition 解析可导致拒绝服务","@hapi/content 的 Content.disposition() 在解析缺少“=”的长 Content-Disposition 参数时呈二次时间复杂度，未认证攻击者可用单个 multipart/form-data 上传请求阻塞 Node.js 事件循环数秒至数分钟。","原文给出了可运行的 PoC、不同令牌长度下的阻塞时长及升级前后对比，便于评估 multipart 请求对 Node.js 服务可用性的影响。",{"_48":170},"2026-10-30T23:10:13.000Z",[166,167,168,232],72,"Node.js","f407","2026-10-31T06:08:16.553Z",{"_145":236,"_32":237,"_148":238,"_150":239,"_152":240,"_154":241,"_156":234,"_14":180,"_158":242,"_160":243,"_162":163,"_12":164,"_165":-5},"dovg5xscowbmox2u6l6m2s1lp","Parameter 揭示恶意 ChatGPT 分享链接代码执行漏洞利用链","Parameter 揭示恶意 ChatGPT 分享链接可在已登录会话中执行攻击者代码并读取私人对话，利用链经 MathLive 跨框架消息注入原始 HTML，再借助允许的 YouTube 脚本绕过 CSP。","文章拆解了恶意 ChatGPT 分享链接从跨框架消息到代码执行的完整链路，并说明修复版本与验证边界。",{"_48":56},"2026-10-31T05:33:41.000Z",[169,167,183,244,245,184,246],78,"AI 安全","大模型","Google","f408","2026-10-31T08:59:15.589Z",{"_145":253,"_32":255,"_148":256,"_150":257,"_152":258,"_154":259,"_156":260,"_14":261,"_158":262,"_160":263,"_162":163,"_12":164,"_165":-5},{"_190":251,"_192":101,"_193":45,"_194":252},"fluIysH7e1EM",[253,254],"sadp3rc08vj8hs3yc7r72lm24","g1yjx90drqjyvf0az6cq04rgs","CNCERT披露VeilDHT僵尸网络大范围感染Linux服务器与IoT设备","国家互联网应急中心（CNCERT）监测发现VeilDHT僵尸网络正通过漏洞利用大范围传播，主要感染Linux服务器与IoT设备。2026年10月16日至10月26日期间，我国境内累计40467台设备受感染，境内日上线肉鸡数最高达15805台。","原文梳理了VeilDHT的双通道控制机制、加密通信、攻击能力与40467台感染规模，便于识别该僵尸网络的传播和防护重点。",{"_48":269},"2026-11-02T09:49:00.000Z","2026-11-02T11:46:32.053Z","activity",[264,265,266,168,267,268],83,"攻击活动","恶意软件","僵尸网络","IoT","CNCERT","安全内参","f409","2026-10-31T10:12:17.365Z",{"_145":276,"_32":277,"_148":278,"_150":279,"_152":280,"_154":281,"_156":282,"_14":157,"_158":283,"_160":284,"_162":163,"_12":164,"_165":-5},{"_190":274,"_192":101,"_193":45,"_194":275},"fBXRC7O56Fow",[276],"tqj4dxtikwan2dwzgf1hpjvys","Ivanti Connect Secure 三个零日漏洞已被链式利用，CVE-2026-111357 与 CVE-2026-118527 纳入 KEV","Ivanti Connect Secure 的 CVE-2026-111357、CVE-2026-118527 与 CVE-2026-104935 已被链式利用，可获取未认证 root 权限并窃取 Windows LAPS 密码和 BitLocker 恢复密钥，UTA0576 自 2026 年 10 月 3 日起攻击运行 22.8R2.4 的设备，影响客户数量有限。","材料串联三个 Ivanti Connect Secure 零日漏洞的在野利用链，并给出受影响版本、修复版本及排查证据，便于评估暴露与应急处置需求。",{"_48":83},"2026-11-02T11:04:08.000Z","2026-11-02T11:48:33.412Z",[166,203,205,184,285,206,185,207],86,"应急响应","f412","2026-10-31T12:02:30.138Z",{"_145":292,"_32":293,"_148":294,"_150":295,"_152":296,"_154":297,"_156":287,"_14":261,"_158":298,"_160":299,"_162":163,"_12":164,"_165":-5},{"_190":290,"_192":101,"_193":45,"_194":291},"fAFp_Yp6uqsI",[292],"l8c38b2h5meavjepjvszce1ro","VOLTA-AUTODOXER 利用 LLM 对窃取数据进行受害者价值评估","Cisco Talos 分析了自删除型 Windows 信息窃取程序 VOLTA-AUTODOXER：它采集浏览器凭据、会话、支付卡、加密钱包种子、OAuth 令牌、云端密钥、Wi-Fi 密码及截图后，将结构化证据发送至 OpenRouter，由 LLM 生成包含“WHAT THEY'RE WORTH”和“THEIR OPSEC”的受害者评估。","文章拆解了 VOLTA 将 LLM 接入受害者筛选流程的方式，并给出模型拒绝时的回退链与事件响应处置要点。",{"_48":306},"2026-10-31T12:00:00.000Z",[264,265,300,301,245,302,246,303,304,305],75,"AI 攻防","数据窃取","凭据","Microsoft","Mozilla","Oracle","Cisco Talos","f413","2026-10-31T13:02:30.480Z",{"_145":313,"_32":315,"_148":316,"_150":317,"_152":318,"_154":319,"_156":308,"_14":261,"_158":320,"_160":243,"_162":163,"_12":164,"_165":-5},{"_190":311,"_192":101,"_193":45,"_194":312},"fWnIQuGAfSM0",[313,314],"rvzo6jnjpnoo4hypna7k8fk0f","wzjcsrijtimb18s48r4hgz18b","群晖NAS设备遭C3RB3R勒索攻击，官方建议更新至安全版本","国内外多起群晖（Synology）NAS勒索攻击已被报告，部分设备文件被加密并添加.L0CK3D后缀，出现read-me3.txt勒索信，攻击被认为与C3RB3R（Cerber）勒索软件有关。","多地用户报告群晖NAS遭勒索加密，官方已关联到旧版系统漏洞并给出更新、隔离和备份建议。",{"_48":269},"2026-10-31T00:09:00.000Z",[264,321,265,203,322,204],"勒索","网络设备","f416","2026-10-31T16:16:29.716Z",{"_145":63,"_32":330,"_148":331,"_150":332,"_152":333,"_154":334,"_156":335,"_14":180,"_158":336,"_160":337,"_162":163,"_12":164,"_165":-5},{"_190":327,"_192":101,"_193":45,"_194":328},"fafTcIRBwfko",[63,329],"midioamfhtgq777zsyrovhu36","Android SMS of Death 漏洞分析：CVE-2026-58882 可用零点击 WAP Push 消息阻断电话服务","独立研究员 Mark Blaszczyk 披露 Android 的 SMS of Death 漏洞 CVE-2026-58882，攻击者仅需发送一条特制 WAP Push 消息即可零点击触发崩溃，阻断电话及紧急呼叫。","文章拆解了零点击 WAP Push 消息触发电话服务崩溃的原理、复现效果与修复范围，便于评估旧款 Android 设备的暴露风险。",{"_48":70},"2026-11-01T12:16:50.000Z","2026-11-01T13:26:34.091Z",[183,167,169,338,246],79,"移动端","f417","2026-10-31T18:18:14.404Z",{"_145":342,"_32":343,"_148":344,"_150":345,"_152":346,"_154":347,"_156":340,"_14":261,"_158":348,"_160":349,"_162":163,"_12":164,"_165":-5},"cyr7bz2bmyz5ecu55k6xo4e2y","Northflank 安全 breach 导致客户 AI API 密钥被滥用","Northflank 在安全 breach 后要求所有客户轮换平台内保存的环境变量、API 密钥及其他 secrets，并确认多名客户发现 AI API 密钥遭到未授权使用。","Northflank 事件展示了平台环境变量解密后，攻击者如何滥用客户 AI API 密钥，并给出明确的密钥轮换与用量核查建议。",{"_48":67},"2026-10-31T18:01:12.000Z",[264,350,302,351,352,245],71,"数据泄露","云原生","容器","f419","2026-11-01T08:31:32.784Z",{"_145":105,"_32":364,"_148":365,"_150":366,"_152":367,"_154":368,"_156":369,"_14":261,"_158":370,"_160":371,"_162":163,"_12":164,"_165":-5},{"_190":357,"_192":31,"_193":107,"_194":358},"f39FEvqrWazs",[359,105,360,361,362,363],"ajeln3eoz2hpbkktjxf74gmhw","soky2baypc752nl7uv0q0gsa7","i65y8agid7mtlqotud98ny7rx","ukmzi9ui1tnps2hcthy290dt4","tomiopf7c2bqt8grmb42v0jqt","FBI 将 Binance 63 亿美元加密资产窃取案归因于朝鲜 TraderTraitor","FBI 确认朝鲜国家支持的 TraderTraitor 实施了 Binance 加密资产窃取案，涉及 2026 年 10 月 29 日前后超过 $6 billion 的虚拟资产，攻击者通过入侵 DevOps 工程师笔记本进入服务容器并提交未授权提现交易。","原文披露了攻击入口、跨链资金流向、资产洗钱路径及公开地址，为加密交易所识别和拦截关联资金提供了具体依据。",{"_48":67},"2026-11-01T19:57:53.000Z","2026-11-01T20:43:31.348Z",[264,301,203,265],87,"f422","2026-11-02T03:38:37.417Z",{"_145":375,"_32":376,"_148":377,"_150":378,"_152":379,"_154":380,"_156":373,"_14":381,"_158":382,"_160":383,"_162":163,"_12":164,"_165":-5},"o24ucbtgopfr2yuihm7llam2f","LocalAlign 通过近目标对抗训练提升大语言模型提示注入防御泛化能力","LocalAlign 通过近目标对抗样本生成与 Margin-Aware Alignment 提升大语言模型的提示注入防御泛化能力，防御能力写入模型参数，推理时无需额外调用攻击检测模型。","论文将提示注入防御的泛化问题拆分为输入侧与目标侧，并用消融实验说明近目标生成和边际感知对齐各自的贡献。",{"_48":269},"2026-11-01T07:38:37.395Z","ai-security",[244,384,385,386,245],74,"模型安全","论文","Agent 安全","f426","2026-11-02T05:42:32.410Z",{"_145":390,"_32":391,"_148":392,"_150":393,"_152":394,"_154":395,"_156":388,"_14":180,"_158":396,"_160":243,"_162":163,"_12":164,"_165":-5},"shfnqqty603i8l19g63b43gpl","EDK II PXE 驱动漏洞 CVE-2026-97631 允许启动前执行代码","EDK II 的 PXE 网络启动驱动存在 CVE-2026-97631，CVSS 4.0 评分 9.5；攻击者可在 Secure Boot 和度量启动校验前触发越界写入，在操作系统加载前执行代码或造成拒绝服务。","文章梳理了漏洞利用前提、固件影响范围与修复时间线，并给出关闭或隔离 PXE 的可迁移处置思路。",{"_48":399},"2026-11-02T00:30:00.000Z",[183,169,168,397,322,303,398],"操作系统","Red Hat","安全客","f430","2026-11-02T09:56:31.038Z",{"_145":403,"_32":404,"_148":405,"_150":406,"_152":407,"_154":408,"_156":401,"_14":157,"_158":409,"_160":410,"_162":163,"_12":164,"_165":-5},"c9fe12dhjhogapha6lstoepdb","Ivanti 修复 Connect Secure 两个零日漏洞，CVE-2026-111357 与 CVE-2026-118527 已被链式利用","Ivanti 修复了 Connect Secure 的两个已被链式利用的零日漏洞，高危权限提升漏洞 CVE-2026-111357 与允许已认证攻击者上传文件的 CVE-2026-118527，自10月1日起与认证绕过漏洞 CVE-2026-104935 组合攻击。","文章串联3个已被链式利用的漏洞，并披露攻击者未部署恶意软件而是通过重复漏洞利用执行命令。",{"_48":67},"2026-11-02T09:33:26.000Z",[166,205,203,184,411,206,207],84,"身份与访问","f432","2026-11-02T10:47:35.469Z",{"_145":415,"_32":416,"_148":417,"_150":418,"_152":419,"_154":420,"_156":413,"_14":261,"_158":421,"_160":349,"_162":163,"_12":164,"_165":-5},"zpp06qhnjm5r6ekq6fx53gr5s","攻击者向乌克兰和俄罗斯民众发送虚假核威胁与袭击警报","乌克兰和俄罗斯的应急警报应用疑遭网络攻击，向民众发送核威胁、辐射、化学攻击和巷战等虚假警报，相关说法尚未获独立证实。乌克兰 Air Alarm 应用于当地时间 22:47 起发出多条警报，部分警报还触发 Lviv 地区广播；该应用随后因疑似被攻破而临时停用。","事件同时呈现应急警报应用被篡改和停机之间的安全取舍，并给出官方备份渠道与反钓鱼提醒。",{"_48":70},"2026-11-02T10:20:46.000Z",[264,422,338,285],"钓鱼","f433","2026-11-02T11:43:33.026Z",{"_145":426,"_32":427,"_148":428,"_150":429,"_152":430,"_154":431,"_156":424,"_14":261,"_158":432,"_160":299,"_162":163,"_12":164,"_165":-5},"t0wff82r3vhco60wkrm3qmm96","攻击者伪装 Microsoft Teams IT 支持，利用不安全 AD CS 窃取企业数据","Microsoft 调查了两起攻击者伪装 IT 支持并诱导员工通过 Microsoft Teams 使用 Quick Assist 授予远程控制的入侵，攻击者随后利用不安全配置的 AD CS 获取高权限账户及域控制器证书，其中一起将企业数据复制到外部服务器。","两起入侵展示了社会工程、Quick Assist 与不安全 AD CS 配置如何串联成数据窃取，并暴露自动响应遗漏高权限账户的处置风险。",{"_48":56},"2026-11-02T11:08:45.000Z",[264,350,302,411,303,433],"检测工程","f436","2026-11-02T11:46:38.841Z",{"_145":437,"_32":438,"_148":439,"_150":440,"_152":441,"_154":442,"_156":435,"_14":157,"_158":443,"_160":444,"_162":163,"_12":164,"_165":-5},"gfyff5sznq8xbz15ruw0wykcz","Windows Update Stack 本地权限提升漏洞 CVE-2026-81963 已发现利用","Windows Update Stack 本地权限提升漏洞 CVE-2026-81963 已发现在野利用，攻击者需先获得主机低权限账户，即可借助更新栈对重解析点处理不当将权限提升至 SYSTEM 并完全控制目标主机。","通告给出了具体受影响版本、SYSTEM 权限提升链和已公开 PoC，并提供官方及终端管理平台两种修复路径，便于评估与处置。",{"_48":269},"2026-11-02T09:46:38.832Z",[166,203,167,168,205,303,445],76,"奇安信","f438","2026-11-02T11:58:31.141Z",{"_145":449,"_32":450,"_148":451,"_150":452,"_152":453,"_154":454,"_156":447,"_14":261,"_158":455,"_160":263,"_162":163,"_12":164,"_165":-5},"n1pma2heqqc1u393qm8xxm48n","Synology警告C3RB3R勒索软件利用旧版DSM漏洞攻击NAS设备","Synology确认攻击者正利用2024年12月已修复的漏洞，针对运行过时DSM版本的NAS设备实施C3RB3R勒索攻击。","Synology确认旧版DSM漏洞已遭C3RB3R勒索软件利用，并给出各版本修复版本与接口隔离建议。",{"_48":67},"2026-11-02T11:28:42.000Z",[264,321,265,203,267,168],{"_457":458,"_459":-5},"changelogVersion","2026-10-01T08:00","release"]
