":56},{"_49":76,"_51":52,"_53":77,"_55":78},"Security Affairs","/dailyinfo/media/ef2b2b57fb06e54f.webp","/dailyinfo/media/2adef5b1e4357a03.webp 48w, /dailyinfo/media/ef2b2b57fb06e54f.webp 96w","SecurityWeek","/dailyinfo/media/6f21a015ea489b81.webp","/dailyinfo/media/c2a91b85de7bb9d6.webp 48w, /dailyinfo/media/6f21a015ea489b81.webp 96w","Hackread","/dailyinfo/media/dd06beac4cadc6f3.webp","/dailyinfo/media/47417cbef4636b7b.webp 48w, /dailyinfo/media/dd06beac4cadc6f3.webp 96w","奇安信威胁情报中心","欧盟委员会确认EU Academy用户数据泄露",24.3,"up","94471d20-e283-4a73-a257-3bf90d7be5de","l9hohsjkbs1vdmrgj7b8hg1pm",[92,93,94],{"_49":76,"_51":52,"_53":77,"_55":78},{"_49":95,"_51":52,"_53":96,"_55":97},{"_49":79,"_51":52,"_53":80,"_55":81},"BleepingComputer","/dailyinfo/media/198a4d86de90e233.webp","/dailyinfo/media/3a544a742516b0af.webp 48w, /dailyinfo/media/198a4d86de90e233.webp 96w",2,"GL.iNet封堵GoodCloud入侵路径，设备仍需清理",26.6,"ba176f09-c52f-4604-abe1-b6be5555c35e","mia8l5w6qk6qwhw5u9a0xxcwe",[104,105,106,107,108],{"_49":110,"_51":52,"_53":111,"_55":112},{"_49":50,"_51":52,"_53":54,"_55":56},{"_49":79,"_51":52,"_53":80,"_55":81},{"_49":57,"_51":52,"_53":58,"_55":59},{"_49":109,"_51":52,"_53":-5},"Cybernews","安全内参","/dailyinfo/media/77459fcbf8f21e71.webp","/dailyinfo/media/3399ea7b18d18a6a.webp 48w, /dailyinfo/media/77459fcbf8f21e71.webp 96w",1,"OpenAI与Cisco开源Shirudo临时防护工具",40,"5ebdd4b0-ce16-4256-a361-735996b6a6c7","toasavtd5k2pms4o21leewoq5",[119,120,121,122,123,124],{"_49":95,"_51":52,"_53":96,"_55":97},{"_49":79,"_51":52,"_53":80,"_55":81},{"_49":60,"_51":52,"_53":61,"_55":62},{"_49":57,"_51":52,"_53":58,"_55":59},{"_49":50,"_51":52,"_53":54,"_55":56},{"_49":109,"_51":52,"_53":-5},"2026-11-25","2026-11-24",20,{"_148":453,"_150":454,"_152":455,"_154":-5},{"_148":442,"_150":443,"_152":444,"_154":-5},{"_148":429,"_150":430,"_152":431,"_154":-5},{"_148":418,"_150":419,"_152":420,"_154":-5},{"_148":405,"_150":406,"_152":407,"_154":-5},{"_148":391,"_150":392,"_152":393,"_154":-5},{"_148":374,"_150":375,"_152":376,"_154":377},{"_148":364,"_150":365,"_152":366,"_154":-5},{"_148":350,"_150":351,"_152":352,"_154":-5},{"_148":335,"_150":336,"_152":337,"_154":-5},{"_148":320,"_150":321,"_152":322,"_154":323},{"_148":307,"_150":308,"_152":309,"_154":-5},{"_148":286,"_150":287,"_152":288,"_154":289},{"_148":266,"_150":267,"_152":268,"_154":269},{"_148":254,"_150":255,"_152":256,"_154":-5},{"_148":240,"_150":241,"_152":242,"_154":-5},{"_148":220,"_150":221,"_152":222,"_154":223},{"_148":199,"_150":200,"_152":201,"_154":-5},{"_148":179,"_150":180,"_152":181,"_154":-5},{"_148":149,"_150":151,"_152":153,"_154":-5},"key","f2105","anchorAt","2026-11-24T02:48:40.882Z","item",{"_155":156,"_32":157,"_158":159,"_160":161,"_162":163,"_164":165,"_166":151,"_14":167,"_168":169,"_170":171,"_172":173,"_12":174,"_175":-5},"group","id","ay3qq7ilurk4uggi3sk6nfuer","F5 修复 NGINX HTTP/2 堆缓冲区溢出高危漏洞","summary","工业和信息化部网络安全威胁和漏洞信息共享平台（NVDB）提示，NGINX 因处理 HTTP/2 协议流量控制窗口时的设计缺陷，存在堆缓冲区溢出高危漏洞。攻击者向启用 HTTP/2 协议的服务器发送特制流量后，可能造成服务崩溃、内存破坏或 RCE。","reason","原文列明受影响版本、HTTP/2 利用条件与补丁状态，便于相关用户快速核对资产范围并安排升级。","source",{"_49":110},"publishedAt","2026-11-24T02:14:40.871Z","timelineAt","vuln","tags",[176,177,178],"score",73,"selected",true,"news","x","漏洞","补丁","在野利用","aws67uokpyvnw8f4hf9i286o7r","2026-11-24T07:21:33.437Z",{"_155":182,"_32":183,"_158":184,"_160":185,"_162":186,"_164":187,"_166":180,"_14":188,"_168":189,"_170":190,"_172":173,"_12":174,"_175":-5},"ws67uokpyvnw8f4hf9i286o7r","CISA 将 CVE-2026-134624 与 CVE-2026-133968 列入 KEV，AI Agent 攻击利用 MONAI Label","CISA 周一将 N-able MailAssure 的 SSRF 漏洞 CVE-2026-134624（CVSS 9.3）与 MONAI Label 的路径遍历漏洞 CVE-2026-133968（CVSS 9.8）加入 KEV 目录，称有在野利用证据。","两个漏洞已被列入 KEV 并确认在野利用，摘要给出版本条件、修复时限与 AI Agent 攻击链细节，便于判断处置优先级。",{"_49":57},"2026-11-24T06:02:45.000Z","activity",[191,178,192,193,194,195,196,197,198],82,"攻击活动","AI 攻防","Agent 安全","漏洞利用","后门","AWS","CISA","Oracle","f2112","2026-11-24T07:53:34.359Z",{"_155":202,"_32":203,"_158":204,"_160":205,"_162":206,"_164":207,"_166":200,"_14":208,"_168":209,"_170":210,"_172":173,"_12":174,"_175":-5},"uor7tsec306kqmeyk9a86k8ip","自部署 Ollama 流式响应包长侧信道实测与缓解评估","研究者在 qwen2.5-0.5b、TLS 1.3 和 1Mbps 链路上实测自部署 Ollama 的流式响应侧信道：被动监听仅凭 TLS 记录长度即可推断 10 类中文对话主题，基线交叉验证准确率为 33.0%，高于 10% 随机水平。","通过真实抓包与五类缓解对照，量化了自部署 Ollama 流式响应的包长泄露及部署层取舍。",{"_49":219},"2026-11-23T01:48:03.000Z","ai-security",[211,212,213,214,193,215,216,217,218],72,"AI 安全","技术研究","大模型","模型安全","加固","Microsoft","Cloudflare","阿里","先知社区","f2114","2026-11-24T09:48:36.592Z",{"_155":230,"_32":231,"_158":232,"_160":233,"_162":234,"_164":235,"_166":236,"_14":167,"_168":237,"_170":210,"_172":173,"_12":174,"_175":-5},{"_224":225,"_226":113,"_227":98,"_228":229},"factId","fVZxcnYXFhzg","additionalSourceCount","reportCount","memberIds",[230],"vpu63dmei80cxey8lzovpk8x2","Microsoft Windows Remote Access API 本地权限提升漏洞 CVE-2026-119853 通告","Microsoft Windows Remote Access API 存在本地权限提升漏洞 CVE-2026-119853，CVSS 3.1 评分为 7.8，奇安信评级为高危。","通告列出受影响版本、利用前提与复现状态，并提供官方更新和多条补丁获取路径。",{"_49":110},"2026-11-24T03:55:41.838Z","2026-11-24T09:55:41.850Z",[176,238,194,216,239],"复现","奇安信","f2121","2026-11-24T10:53:33.956Z",{"_155":243,"_32":244,"_158":245,"_160":246,"_162":247,"_164":248,"_166":241,"_14":188,"_168":249,"_170":250,"_172":173,"_12":174,"_175":-5},"n1v6vo78gilhihc2j4b0crw25","NCSC 观察到 AI 辅助攻击利用常见弱点加速入侵","NCSC 自 2026 年 9 月以来观察到 AI 辅助网络攻击明显增加，攻击者将 ARTEX 等红队框架用于自动化识别和利用互联网暴露资产中的弱点，在数分钟内完成发现到利用，造成服务中断或系统失陷。","文章结合 NCSC 观测说明 AI 代理如何快速利用常见弱点，并给出可迁移的资产收敛、检测、API 防护和诱捕处置思路。",{"_49":253},"2026-11-23T16:00:00.000Z",[191,192,193,213,251,252,216],74,"红队","检测工程","NCSC UK","f2122","2026-11-24T10:56:46.440Z",{"_155":257,"_32":258,"_158":259,"_160":260,"_162":261,"_164":262,"_166":255,"_14":167,"_168":263,"_170":264,"_172":173,"_12":174,"_175":-5},"cj8c3uqpn5xr5jts9kigfdad1","帆软 FineReport FineVis（FVS）插件未授权远程代码执行漏洞 QVD-2026-115643 已复现","帆软 FineReport FineVis（FVS）插件存在未授权远程代码执行漏洞 QVD-2026-115643，CVSS 3.1 评分为 9.8，奇安信 CERT 已成功复现。","通告给出了利用链、受影响版本、资产规模及临时拦截接口，便于防守方快速判断暴露面并安排升级。",{"_49":110},"2026-11-24T07:56:46.422Z",[176,238,177,194,265,239],80,"漏洞分析","f2123","2026-11-24T10:56:46.470Z",{"_155":273,"_32":274,"_158":275,"_160":276,"_162":277,"_164":278,"_166":279,"_14":188,"_168":280,"_170":281,"_172":173,"_12":174,"_175":-5},{"_224":270,"_226":113,"_227":98,"_228":271},"fZ6J-Ef4kgGg",[272,273],"xrxlbx0dqa44hppyevq6jooml","er8w3435c0kdmbhxj3lap31mw","BabidiGhost 借助越狱 AI 代理攻击欧洲多行业机构并窃取 8.6 GB 档案","BabidiGhost 借助越狱 Hermes AI 代理，在 2026 年 11 月 6 日至 14 日针对比利时、法国和瑞士的银行、保险、支付及公共机构等超过 50 个组织与数据集开展攻击，14 个重点对象中 2 个被入侵、3 个部分被入侵、4 个抵御成功、5 个仅遭侦察。","复盘展示 AI 代理如何放大已知漏洞、暴露凭据和弱口令造成的风险，并给出可复用的处置与检测重点。",{"_49":85},"2026-11-24T03:56:00.000Z","2026-11-24T13:52:33.313Z",[191,282,195,283,192,284,239,285],88,"恶意软件","数据泄露","凭据","NVD","f2124","2026-11-24T10:56:46.493Z",{"_155":293,"_32":294,"_158":295,"_160":296,"_162":297,"_164":298,"_166":299,"_14":188,"_168":300,"_170":301,"_172":173,"_12":174,"_175":-5},{"_224":290,"_226":113,"_227":98,"_228":291},"f8hOxMHN9rhM",[292,293],"k4cuw0o6cxh3xdlvs1vpobjsa","td4h5lehjtbgithowe0l16qft","CNCERT提示Cling僵尸网络新变种大范围传播，感染设备累计5600台","CNCERT监测发现Cling僵尸网络新变种正针对Linux服务器及IoT设备大范围传播。2026年11月09日至11月20日期间，我国境内累计约5600台设备受感染，境内日上线肉鸡数最高达2730台。","CNCERT披露了Cling新变种的传播规模、STUN伪装通信机制与持久化手法，可据此识别感染主机并排查相关资产。",{"_49":110},"2026-11-24T09:02:00.000Z","2026-11-24T11:50:35.494Z",[191,282,302,303,304,305,306],81,"僵尸网络","数据窃取","IoT","CNCERT","绿盟","f2130","2026-11-24T12:51:34.545Z",{"_155":310,"_32":311,"_158":312,"_160":313,"_162":314,"_164":315,"_166":308,"_14":167,"_168":316,"_170":171,"_172":173,"_12":174,"_175":-5},"nc9k4mm8c96fwbmiwe8cwt06d","VMware vCenter Server 未授权管理员用户创建漏洞 CVE-2026-123903 已复现","VMware vCenter Server 存在身份鉴别错误漏洞 CVE-2026-123903，CVSS 9.8，高风险且可远程利用；攻击者在可访问 389 端口时可能无需权限绕过身份验证，创建管理员账号并接管 vCenter。","材料给出漏洞编号、CVSS 9.8、受影响版本与复现条件，并说明 PoC 未公开，便于评估资产暴露与修复优先级。",{"_49":319},"2026-11-24T10:12:00.000Z",[176,238,194,317,318],"身份与访问","VMware","微步在线研究响应中心","f2132","2026-11-24T13:13:32.530Z",{"_155":41,"_32":327,"_158":328,"_160":329,"_162":330,"_164":331,"_166":321,"_14":188,"_168":332,"_170":250,"_172":173,"_12":174,"_175":-5},{"_224":324,"_226":113,"_227":98,"_228":325},"fxsqVO3s-Zkc",[41,326],"umayny0zi2flg2u4b2znewhf6","Okta 追踪 ShinyHunters 关联团伙以 Inception 名义重启数据泄露站","Okta 追踪的 O-UNC-053 团伙自 2026 年 3 月起针对多个行业实施社会工程和凭据收集活动，并疑似在 ShinyHunters 泄露站下线后转投 Inception。","两家机构的技术与基础设施线索相互印证，帮助区分该团伙更名、合作关系及真实攻击能力。",{"_49":50},"2026-11-24T12:47:07.000Z",[191,282,333,283,334,317],"钓鱼","黑产","f2137","2026-11-24T13:58:37.377Z",{"_155":338,"_32":339,"_158":340,"_160":341,"_162":342,"_164":343,"_166":336,"_14":344,"_168":345,"_170":346,"_172":173,"_12":174,"_175":-5},"o11ps1is398sexfm70ldsck07","Rapid7 复现 VMware vCenter SRP 认证绕过至 root 漏洞 CVE-2026-123890","Rapid7 复现 VMware vCenter SRP 认证绕过至 root 漏洞 CVE-2026-123890。","文章完整拆解了会话密钥泄露、上下文越权与 root 权限获取链，并给出复现数据、日志线索和处置边界。",{"_49":349},"2026-11-24T13:01:25.000Z","disclosure",[238,194,212,265,347,318,348],87,"利用链","Rapid7","Rapid7 CVE 公告","f2138","2026-11-24T13:58:38.593Z",{"_155":353,"_32":354,"_158":355,"_160":356,"_162":357,"_164":358,"_166":351,"_14":359,"_168":360,"_170":361,"_172":173,"_12":174,"_175":-5},"ldspkafngxgpmt8icv3r5x8ao","英国FCA要求金融机构管控AI Agent风险，否则将采取监管行动","英国金融监管机构 FCA 警告金融机构，必须处理部署 AI Agent 带来的网络安全风险，否则可能面临监管行动。11 月 24 日发布的指引要求负责相关 AI 模型的资深管理者采取合理措施，理解系统自主程度及其风险，提供有效监督、适当治理控制和升级机制；机构还应评估接受 AI Agent 指令及付款的责任，通过清晰、相称且一致的免责声明说明模型提供的信息和建议边界。","FCA明确了金融机构部署AI Agent时的责任边界，并列出访问控制、监督、治理和消费者提示等可落实的合规要求。",{"_49":60},"2026-11-24T13:45:00.000Z","policy",[211,193,362,363,213],70,"治理","合规","ad9jwpyq0j8b0scltqxa7wgo94","2026-11-24T14:21:33.993Z",{"_155":367,"_32":368,"_158":369,"_160":370,"_162":371,"_164":372,"_166":365,"_14":167,"_168":373,"_170":250,"_172":173,"_12":174,"_175":-5},"d9jwpyq0j8b0scltqxa7wgo94","VMware vCenter 认证绕过漏洞 CVE-2026-123903 获修复，CVSS 9.8","Broadcom 修复 VMware vCenter 认证绕过漏洞 CVE-2026-123903，CVSS 9.8，位于 VMware Directory Service，攻击者需具备 vCenter 网络访问权限即可绕过认证并获取未授权访问。","材料列出了受影响产品、CVSS 评分和修复版本，也明确区分了新漏洞与此前遭利用的漏洞，便于资产盘点与升级决策。",{"_49":57},"2026-11-24T13:28:26.000Z",[176,177,317,318,239],"f2143","2026-11-24T14:54:33.266Z",{"_155":380,"_32":381,"_158":382,"_160":383,"_162":384,"_164":385,"_166":375,"_14":188,"_168":386,"_170":210,"_172":173,"_12":174,"_175":-5},{"_224":378,"_226":113,"_227":98,"_228":379},"ffF8trrXn-Qs",[380],"o3kydory2xryg9jbza7s4q3m7","Check Point Research 披露伊朗关联组织 Volant Manticore 攻击塞浦路斯及沙特医疗目标","Check Point Research 发现此前未记录的伊朗关联组织 Volant Manticore，通过虚假简历、医疗研讨会等钓鱼载荷投放 KuboShell 后门，并使用 Homa Framework 执行侦察和后续控制。","报告还原了从钓鱼投递、KuboShell初始立足到Homa Framework多阶段控制的完整链路，并提供基础设施关联与IOC。",{"_49":390},"2026-11-24T14:13:55.000Z",[191,282,195,333,303,284,387,388,389],"Check Point","Fortinet","Kaspersky","Check Point Research","aawdj9fvljkgfwpubtpz11ffye","2026-11-24T15:58:34.441Z",{"_155":394,"_32":395,"_158":396,"_160":397,"_162":398,"_164":399,"_166":392,"_14":208,"_168":400,"_170":401,"_172":173,"_12":174,"_175":-5},"awdj9fvljkgfwpubtpz11ffye","AI Agent 入侵 DIVD 事件复盘：Zammad 两漏洞链与网络分段止血","DIVD 确认其 Zammad 工单系统被 AI Agent 攻击，攻击者串联两个此前未知漏洞，先劫持会话在服务器执行代码，再于数分钟内取得 root 权限；两个漏洞已在 7.2.2 修复，建议所有 Zammad 用户升级至 version 7 或离线运行。","以 DIVD 被 AI Agent 入侵的完整处置链为案例，说明网络分段、快速监测和实战演练如何限制损失，并给出防守方可直接参考的响应与演练建议。",{"_49":404},"2026-11-24T14:27:58.000Z",[211,193,191,194,402,403],75,"应急响应","蓝队","OffSec","f2154","2026-11-24T16:00:32.817Z",{"_155":408,"_32":409,"_158":410,"_160":411,"_162":412,"_164":413,"_166":406,"_14":188,"_168":414,"_170":190,"_172":173,"_12":174,"_175":-5},"uj999ni2rujtk0wiode7kr6zy","Unit 42 披露 10 余起 AI Agent 驱动的真实攻击活动","Unit 42 在 2026 年 7 月至 9 月追踪到 10 余起 AI Agent 驱动的全球攻击，目标覆盖政府、物流、酒店、制造、农业和教育行业。攻击者均通过易受攻击 Web 应用部署 Web Shell 建立初始访问，再由 Agent 自动执行侦察、凭据收集、提权与横向移动，将原本数周或数天的攻击周期压缩至数小时。","文章以多起真实活动说明 AI Agent 如何压缩攻击周期，并给出命令间隔、命令数量和跨平台扩散等可核对特征。",{"_49":417},"2026-11-24T15:00:19.000Z",[191,192,193,195,194,415,416],"云原生","Palo Alto","Unit 42","f2172","2026-11-24T20:21:32.532Z",{"_155":421,"_32":422,"_158":423,"_160":424,"_162":425,"_164":426,"_166":419,"_14":188,"_168":427,"_170":250,"_172":173,"_12":174,"_175":-5},"fkosves1h11ym4ct505ac5i8p","Inception 仿冒品牌开展 SSO 电话钓鱼活动","新组建的数据勒索组织 Inception 被认为自 10 月下旬起开展 SSO 钓鱼活动，主要通过电话社工而非电子邮件钓鱼，冒充 Dropbox、Nintendo、Starbucks 等数十家企业。","材料梳理了 Inception 的 SSO 钓鱼基础设施、冒充品牌与关联线索，并给出可执行的认证和日志排查建议。",{"_49":95},"2026-11-24T20:21:20.000Z",[191,333,428,283,317,251],"勒索","f2175","2026-11-24T21:04:33.728Z",{"_155":432,"_32":433,"_158":434,"_160":435,"_162":436,"_164":437,"_166":430,"_14":167,"_168":438,"_170":439,"_172":173,"_12":174,"_175":-5},"wlf4qedhmzrb2mc5l47se4bwn","ruflo MCP bridge 默认 Docker Compose 部署存在未认证 RCE","ruflo 的 MCP bridge 在默认 Docker Compose 部署中暴露无认证的 POST /mcp，并默认监听所有网络接口，未经认证的攻击者可调用 terminal_execute。","公告同时说明默认部署暴露原因、利用链和加固措施，并指出仅重新部署无法清除已注入的污染模式。",{"_49":441},"2026-11-24T21:01:10.000Z",[176,211,193,194,440],78,"供应链","GitHub 安全公告","f2182","2026-11-24T22:21:33.065Z",{"_155":445,"_32":446,"_158":447,"_160":448,"_162":449,"_164":450,"_166":443,"_14":188,"_168":451,"_170":439,"_172":173,"_12":174,"_175":-5},"rj90jojg8jxi2doqvzxf2u18u","Rackspace 因安全事件关闭 Spot 云平台，客户须在 12 月 8 日前迁移","Rackspace 因 11 月 17 日的安全事件关闭 Spot 云平台，攻击者使用被盗凭据在客户 Kubernetes 集群中创建未授权 pods、读取 Kubernetes Secrets，并列出节点和存储卷。","事件披露了攻击者借被盗凭据进入 Kubernetes 集群并读取 Secrets 的过程，也给出了受影响时间范围和可疑 IOC。",{"_49":95},"2026-11-24T21:37:30.000Z",[191,283,452,415,284],"容器","f2189","2026-11-24T23:07:33.411Z",{"_155":456,"_32":457,"_158":458,"_160":459,"_162":460,"_164":461,"_166":454,"_14":344,"_168":462,"_170":463,"_172":173,"_12":174,"_175":-5},"v22kkapa6wiug2zqwrfadsbo1","NGINX HTTP/2 释放后重用漏洞 CVE-2026-123633 分析与复现","Unit 42 分析并复现了 NGINX HTTP/2 释放后重用漏洞 CVE-2026-123633。该问题影响 1.19.7 至 1.30.6 和 1.31.0 至 1.31.8，未认证攻击者在连接额度紧张并使用分片请求和请求时 DNS 解析时可能触发拒绝服务，F5 评分 CVSS 4.0 9.2、CVSS 3.1 8.1；禁用或绕过 ASLR 时可能实现代码执行。","文章完整还原了连接状态缺陷触发释放后重用内存的路径，并用 ASan 测试验证，适合研究人员理解利用前提与防护边界。",{"_49":417},"2026-11-24T23:00:14.000Z",[212,265,238,347,177,416,464,285],84,"Debian",{"_466":467,"_468":-5},"changelogVersion","2026-10-01T08:00","release"]
