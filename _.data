ailyinfo/media/3a544a742516b0af.webp 48w, /dailyinfo/media/198a4d86de90e233.webp 96w","Rapid7 CVE 公告","/dailyinfo/media/092fbeae5b5c3123.webp","/dailyinfo/media/c16323cf53c574df.webp 48w, /dailyinfo/media/092fbeae5b5c3123.webp 96w","Cisco披露VOLTA用AI评估窃密受害者",21.6,"41881cfd-565d-48f3-8331-58892c484e4a","l8c38b2h5meavjepjvszce1ro",[83,84,85],{"_49":50,"_51":52,"_53":54,"_55":56},{"_49":60,"_51":52,"_53":61,"_55":62},{"_49":86,"_51":52,"_53":87,"_55":88},"The Hacker News","/dailyinfo/media/3d21685a726d0a64.jpg","/dailyinfo/media/a1e7de8b6809b50e.jpg 48w, /dailyinfo/media/3d21685a726d0a64.jpg 96w",2,"FBI归因TraderTraitor窃取Binance资产",28.1,"6ef2ec24-f871-4ca2-9cc2-5fcbd249af24","uu0z6mo1muhhj4bo1sst643w9",[96,97,98,99,100,101],6,{"_49":57,"_51":52,"_53":58,"_55":59},{"_49":60,"_51":52,"_53":61,"_55":62},{"_49":72,"_51":52,"_53":73,"_55":74},{"_49":50,"_51":52,"_53":54,"_55":56},{"_49":102,"_51":52,"_53":103,"_55":104},{"_49":86,"_51":52,"_53":87,"_55":88},"Hackread","/dailyinfo/media/dd06beac4cadc6f3.webp","/dailyinfo/media/47417cbef4636b7b.webp 48w, /dailyinfo/media/dd06beac4cadc6f3.webp 96w",1,"Google拆除XCPE僵尸网络并封禁Videostrong",31,"d06829ad-986b-44e7-8164-4a64599bab09","wbjzunigapakv96vd54t9g53c",[111,112,113,114],{"_49":115,"_51":52,"_53":116,"_55":117},{"_49":72,"_51":52,"_53":73,"_55":74},{"_49":60,"_51":52,"_53":61,"_55":62},{"_49":86,"_51":52,"_53":87,"_55":88},"Google Cloud 威胁情报","/dailyinfo/media/424bd6373c2d87d6.webp","/dailyinfo/media/9a88f7a6491d815b.webp 48w, /dailyinfo/media/424bd6373c2d87d6.webp 96w","2026-11-03","2026-11-02",11,"2026-11-01","2026-10-31",13,{"_144":469,"_146":470,"_148":471,"_150":-5},{"_144":458,"_146":459,"_148":460,"_150":-5},{"_144":447,"_146":448,"_148":449,"_150":-5},{"_144":429,"_146":430,"_148":431,"_150":432},{"_144":411,"_146":412,"_148":413,"_150":414},{"_144":396,"_146":397,"_148":398,"_150":-5},{"_144":386,"_146":387,"_148":388,"_150":-5},{"_144":369,"_146":370,"_148":371,"_150":372},{"_144":358,"_146":359,"_148":360,"_150":-5},{"_144":347,"_146":348,"_148":349,"_150":-5},{"_144":335,"_146":336,"_148":337,"_150":-5},{"_144":322,"_146":323,"_148":324,"_150":-5},{"_144":306,"_146":307,"_148":308,"_150":-5},{"_144":287,"_146":288,"_148":289,"_150":290},{"_144":273,"_146":274,"_148":275,"_150":-5},{"_144":252,"_146":253,"_148":254,"_150":255},{"_144":234,"_146":235,"_148":236,"_150":237},{"_144":212,"_146":213,"_148":214,"_150":215},{"_144":188,"_146":189,"_148":190,"_150":191},{"_144":145,"_146":147,"_148":149,"_150":151},"key","f408","anchorAt","2026-10-31T08:59:15.589Z","item",{"_160":158,"_32":161,"_162":163,"_164":165,"_166":167,"_168":169,"_170":171,"_14":172,"_173":174,"_175":176,"_177":178,"_12":179,"_180":-5},"group",{"_152":153,"_154":105,"_155":89,"_156":157},"factId","fluIysH7e1EM","additionalSourceCount","reportCount","memberIds",[158,159],"sadp3rc08vj8hs3yc7r72lm24","g1yjx90drqjyvf0az6cq04rgs","id","CNCERT披露VeilDHT僵尸网络大范围感染Linux服务器与IoT设备","summary","国家互联网应急中心（CNCERT）监测发现VeilDHT僵尸网络正通过漏洞利用大范围传播，主要感染Linux服务器与IoT设备。2026年10月16日至10月26日期间，我国境内累计40467台设备受感染，境内日上线肉鸡数最高达15805台。","reason","原文梳理了VeilDHT的双通道控制机制、加密通信、攻击能力与40467台感染规模，便于识别该僵尸网络的传播和防护重点。","source",{"_49":187},"publishedAt","2026-11-02T09:49:00.000Z","timelineAt","2026-11-02T11:46:32.053Z","activity","tags",[181,182,183,184,185,186],"score",83,"selected",true,"news","x","攻击活动","恶意软件","僵尸网络","漏洞利用","IoT","CNCERT","安全内参","f409","2026-10-31T10:12:17.365Z",{"_160":194,"_32":195,"_162":196,"_164":197,"_166":198,"_168":199,"_170":200,"_14":201,"_173":202,"_175":203,"_177":178,"_12":179,"_180":-5},{"_152":192,"_154":105,"_155":89,"_156":193},"fBXRC7O56Fow",[194],"tqj4dxtikwan2dwzgf1hpjvys","Ivanti Connect Secure 三个零日漏洞已被链式利用，CVE-2026-111357 与 CVE-2026-118527 纳入 KEV","Ivanti Connect Secure 的 CVE-2026-111357、CVE-2026-118527 与 CVE-2026-104935 已被链式利用，可获取未认证 root 权限并窃取 Windows LAPS 密码和 BitLocker 恢复密钥，UTA0576 自 2026 年 10 月 3 日起攻击运行 22.8R2.4 的设备，影响客户数量有限。","材料串联三个 Ivanti Connect Secure 零日漏洞的在野利用链，并给出受影响版本、修复版本及排查证据，便于评估暴露与应急处置需求。",{"_49":75},"2026-11-02T11:04:08.000Z","2026-11-02T11:48:33.412Z","vuln",[204,205,206,207,208,209,210,211],86,"漏洞","在野利用","补丁","利用链","应急响应","Ivanti","Rapid7","CISA","f412","2026-10-31T12:02:30.138Z",{"_160":81,"_32":218,"_162":219,"_164":220,"_166":221,"_168":222,"_170":213,"_14":172,"_173":223,"_175":224,"_177":178,"_12":179,"_180":-5},{"_152":216,"_154":45,"_155":63,"_156":217},"fAFp_Yp6uqsI",[81],"VOLTA-AUTODOXER 利用 LLM 对窃取数据进行受害者价值评估","Cisco Talos 分析了自删除型 Windows 信息窃取程序 VOLTA-AUTODOXER：它采集浏览器凭据、会话、支付卡、加密钱包种子、OAuth 令牌、云端密钥、Wi-Fi 密码及截图后，将结构化证据发送至 OpenRouter，由 LLM 生成包含“WHAT THEY'RE WORTH”和“THEIR OPSEC”的受害者评估。","文章拆解了 VOLTA 将 LLM 接入受害者筛选流程的方式，并给出模型拒绝时的回退链与事件响应处置要点。",{"_49":233},"2026-10-31T12:00:00.000Z",[181,182,225,226,227,228,229,230,231,232],75,"AI 攻防","数据窃取","大模型","凭据","Google","Microsoft","Mozilla","Oracle","Cisco Talos","f413","2026-10-31T13:02:30.480Z",{"_160":240,"_32":242,"_162":243,"_164":244,"_166":245,"_168":246,"_170":235,"_14":172,"_173":247,"_175":248,"_177":178,"_12":179,"_180":-5},{"_152":238,"_154":105,"_155":89,"_156":239},"fWnIQuGAfSM0",[240,241],"rvzo6jnjpnoo4hypna7k8fk0f","wzjcsrijtimb18s48r4hgz18b","群晖NAS设备遭C3RB3R勒索攻击，官方建议更新至安全版本","国内外多起群晖（Synology）NAS勒索攻击已被报告，部分设备文件被加密并添加.L0CK3D后缀，出现read-me3.txt勒索信，攻击被认为与C3RB3R（Cerber）勒索软件有关。","多地用户报告群晖NAS遭勒索加密，官方已关联到旧版系统漏洞并给出更新、隔离和备份建议。",{"_49":187},"2026-10-31T00:09:00.000Z",[181,249,182,205,250,251],78,"勒索","网络设备","漏洞管理","f416","2026-10-31T16:16:29.716Z",{"_160":258,"_32":260,"_162":261,"_164":262,"_166":263,"_168":264,"_170":265,"_14":266,"_173":267,"_175":268,"_177":178,"_12":179,"_180":-5},{"_152":256,"_154":105,"_155":89,"_156":257},"fafTcIRBwfko",[258,259],"vwazprhy9sym8n3jfpzyapz5g","midioamfhtgq777zsyrovhu36","Android SMS of Death 漏洞分析：CVE-2026-58882 可用零点击 WAP Push 消息阻断电话服务","独立研究员 Mark Blaszczyk 披露 Android 的 SMS of Death 漏洞 CVE-2026-58882，攻击者仅需发送一条特制 WAP Push 消息即可零点击触发崩溃，阻断电话及紧急呼叫。","文章拆解了零点击 WAP Push 消息触发电话服务崩溃的原理、复现效果与修复范围，便于评估旧款 Android 设备的暴露风险。",{"_49":50},"2026-11-01T12:16:50.000Z","2026-11-01T13:26:34.091Z","disclosure",[269,270,271,272,229],79,"漏洞分析","复现","技术研究","移动端","f417","2026-10-31T18:18:14.404Z",{"_160":276,"_32":277,"_162":278,"_164":279,"_166":280,"_168":281,"_170":274,"_14":172,"_173":282,"_175":283,"_177":178,"_12":179,"_180":-5},"cyr7bz2bmyz5ecu55k6xo4e2y","Northflank 安全 breach 导致客户 AI API 密钥被滥用","Northflank 在安全 breach 后要求所有客户轮换平台内保存的环境变量、API 密钥及其他 secrets，并确认多名客户发现 AI API 密钥遭到未授权使用。","Northflank 事件展示了平台环境变量解密后，攻击者如何滥用客户 AI API 密钥，并给出明确的密钥轮换与用量核查建议。",{"_49":72},"2026-10-31T18:01:12.000Z",[181,284,228,285,286,227],71,"数据泄露","云原生","容器","f419","2026-11-01T08:31:32.784Z",{"_160":93,"_32":298,"_162":299,"_164":300,"_166":301,"_168":302,"_170":303,"_14":172,"_173":304,"_175":305,"_177":178,"_12":179,"_180":-5},{"_152":291,"_154":31,"_155":95,"_156":292},"f39FEvqrWazs",[293,93,294,295,296,297],"ajeln3eoz2hpbkktjxf74gmhw","soky2baypc752nl7uv0q0gsa7","i65y8agid7mtlqotud98ny7rx","ukmzi9ui1tnps2hcthy290dt4","tomiopf7c2bqt8grmb42v0jqt","FBI 将 Binance 63 亿美元加密资产窃取案归因于朝鲜 TraderTraitor","FBI 确认朝鲜国家支持的 TraderTraitor 实施了 Binance 加密资产窃取案，涉及 2026 年 10 月 29 日前后超过 $6 billion 的虚拟资产，攻击者通过入侵 DevOps 工程师笔记本进入服务容器并提交未授权提现交易。","原文披露了攻击入口、跨链资金流向、资产洗钱路径及公开地址，为加密交易所识别和拦截关联资金提供了具体依据。",{"_49":72},"2026-11-01T19:57:53.000Z","2026-11-01T20:43:31.348Z",[181,226,205,182],87,"f422","2026-11-02T03:38:37.417Z",{"_160":309,"_32":310,"_162":311,"_164":312,"_166":313,"_168":314,"_170":307,"_14":315,"_173":316,"_175":317,"_177":178,"_12":179,"_180":-5},"o24ucbtgopfr2yuihm7llam2f","LocalAlign 通过近目标对抗训练提升大语言模型提示注入防御泛化能力","LocalAlign 通过近目标对抗样本生成与 Margin-Aware Alignment 提升大语言模型的提示注入防御泛化能力，防御能力写入模型参数，推理时无需额外调用攻击检测模型。","论文将提示注入防御的泛化问题拆分为输入侧与目标侧，并用消融实验说明近目标生成和边际感知对齐各自的贡献。",{"_49":187},"2026-11-01T07:38:37.395Z","ai-security",[318,319,320,321,227],74,"AI 安全","模型安全","论文","Agent 安全","f426","2026-11-02T05:42:32.410Z",{"_160":325,"_32":326,"_162":327,"_164":328,"_166":329,"_168":330,"_170":323,"_14":266,"_173":331,"_175":248,"_177":178,"_12":179,"_180":-5},"shfnqqty603i8l19g63b43gpl","EDK II PXE 驱动漏洞 CVE-2026-97631 允许启动前执行代码","EDK II 的 PXE 网络启动驱动存在 CVE-2026-97631，CVSS 4.0 评分 9.5；攻击者可在 Secure Boot 和度量启动校验前触发越界写入，在操作系统加载前执行代码或造成拒绝服务。","文章梳理了漏洞利用前提、固件影响范围与修复时间线，并给出关闭或隔离 PXE 的可迁移处置思路。",{"_49":334},"2026-11-02T00:30:00.000Z",[269,271,184,332,250,230,333],"操作系统","Red Hat","安全客","f430","2026-11-02T09:56:31.038Z",{"_160":338,"_32":339,"_162":340,"_164":341,"_166":342,"_168":343,"_170":336,"_14":201,"_173":344,"_175":345,"_177":178,"_12":179,"_180":-5},"c9fe12dhjhogapha6lstoepdb","Ivanti 修复 Connect Secure 两个零日漏洞，CVE-2026-111357 与 CVE-2026-118527 已被链式利用","Ivanti 修复了 Connect Secure 的两个已被链式利用的零日漏洞，高危权限提升漏洞 CVE-2026-111357 与允许已认证攻击者上传文件的 CVE-2026-118527，自10月1日起与认证绕过漏洞 CVE-2026-104935 组合攻击。","文章串联3个已被链式利用的漏洞，并披露攻击者未部署恶意软件而是通过重复漏洞利用执行命令。",{"_49":72},"2026-11-02T09:33:26.000Z",[204,206,205,207,346,209,211],84,"身份与访问","f432","2026-11-02T10:47:35.469Z",{"_160":350,"_32":351,"_162":352,"_164":353,"_166":354,"_168":355,"_170":348,"_14":172,"_173":356,"_175":283,"_177":178,"_12":179,"_180":-5},"zpp06qhnjm5r6ekq6fx53gr5s","攻击者向乌克兰和俄罗斯民众发送虚假核威胁与袭击警报","乌克兰和俄罗斯的应急警报应用疑遭网络攻击，向民众发送核威胁、辐射、化学攻击和巷战等虚假警报，相关说法尚未获独立证实。乌克兰 Air Alarm 应用于当地时间 22:47 起发出多条警报，部分警报还触发 Lviv 地区广播；该应用随后因疑似被攻破而临时停用。","事件同时呈现应急警报应用被篡改和停机之间的安全取舍，并给出官方备份渠道与反钓鱼提醒。",{"_49":50},"2026-11-02T10:20:46.000Z",[181,357,272,208],"钓鱼","f433","2026-11-02T11:43:33.026Z",{"_160":361,"_32":362,"_162":363,"_164":364,"_166":365,"_168":366,"_170":359,"_14":172,"_173":367,"_175":224,"_177":178,"_12":179,"_180":-5},"t0wff82r3vhco60wkrm3qmm96","攻击者伪装 Microsoft Teams IT 支持，利用不安全 AD CS 窃取企业数据","Microsoft 调查了两起攻击者伪装 IT 支持并诱导员工通过 Microsoft Teams 使用 Quick Assist 授予远程控制的入侵，攻击者随后利用不安全配置的 AD CS 获取高权限账户及域控制器证书，其中一起将企业数据复制到外部服务器。","两起入侵展示了社会工程、Quick Assist 与不安全 AD CS 配置如何串联成数据窃取，并暴露自动响应遗漏高权限账户的处置风险。",{"_49":86},"2026-11-02T11:08:45.000Z",[181,284,228,346,230,368],"检测工程","f436","2026-11-02T11:46:38.841Z",{"_160":375,"_32":377,"_162":378,"_164":379,"_166":380,"_168":381,"_170":382,"_14":201,"_173":383,"_175":203,"_177":178,"_12":179,"_180":-5},{"_152":373,"_154":105,"_155":89,"_156":374},"fz-RW5_XrdCA",[375,376],"zn3wl1ipk6y4uimbmwjbo86fy","gfyff5sznq8xbz15ruw0wykcz","Microsoft Windows Update Stack 本地权限提升漏洞 CVE-2026-81963 已复现并发现在野利用","Microsoft Windows Update Stack 本地权限提升漏洞 CVE-2026-81963 已发现真实利用，奇安信 CERT 已成功复现；攻击者需取得目标主机低权限账户，可借更新栈未正确校验重解析点将权限提升至 SYSTEM。","原文给出漏洞成因、低权限利用前提、受影响版本和在野利用证据，并附复现及处置建议，便于判断暴露范围与修复优先级。",{"_49":385},"2026-11-02T08:51:00.000Z","2026-11-02T12:49:32.189Z",[204,205,270,184,206,230,384],"奇安信","奇安信 CERT","f438","2026-11-02T11:58:31.141Z",{"_160":389,"_32":390,"_162":391,"_164":392,"_166":393,"_168":394,"_170":387,"_14":172,"_173":395,"_175":176,"_177":178,"_12":179,"_180":-5},"n1pma2heqqc1u393qm8xxm48n","Synology警告C3RB3R勒索软件利用旧版DSM漏洞攻击NAS设备","Synology确认攻击者正利用2024年12月已修复的漏洞，针对运行过时DSM版本的NAS设备实施C3RB3R勒索攻击。","Synology确认旧版DSM漏洞已遭C3RB3R勒索软件利用，并给出各版本修复版本与接口隔离建议。",{"_49":72},"2026-11-02T11:28:42.000Z",[181,249,182,205,185,184],"f439","2026-11-02T12:41:36.164Z",{"_160":399,"_32":400,"_162":401,"_164":402,"_166":403,"_168":404,"_170":397,"_14":315,"_173":405,"_175":406,"_177":178,"_12":179,"_180":-5},"teaxhs6mgmqr7we21mxnq1hmt","Trail of Bits 使用 Codex 批量回移 Linux 安全修复，已覆盖 149 个 CVE","Trail of Bits 使用 Codex 与 GPT-5.6 协助将安全修复回移到 Linux 稳定分支及 Ubuntu、Fedora 等软件包。","文章用稳定分支的漏洞缺口和 149 个已完成回移修复，展示了 AI Agent 辅助安全补丁回移的实际规模与工作流。",{"_49":410},"2026-11-02T12:00:00.000Z",[318,225,227,251,407,206,408,409],70,"内核","Ubuntu","Debian","Trail of Bits","f440","2026-11-02T12:49:37.964Z",{"_160":418,"_32":419,"_162":420,"_164":421,"_166":422,"_168":423,"_170":424,"_14":172,"_173":425,"_175":426,"_177":178,"_12":179,"_180":-5},{"_152":415,"_154":105,"_155":89,"_156":416},"fZgkHH0BZWRg",[417,418],"rnqinqt6srbee22b4h3qhhfn6","c8c3sczng53jdb0j9x5vqc0ry","欧洲多国逾115家超市制冷系统遭攻击，门店被迫处置变质商品","攻击者远程修改欧洲多国超市冷柜和制冷系统的温度设置、关闭制冷设备或启动除霜，导致超过115家门店受到影响，并造成商品损失和提前营业干预。","材料梳理了多国超市制冷系统遭远程操控的规模、受影响门店及处置方式，并指出攻击可能复用法国同类事件中的漏洞。",{"_49":72},"2026-11-02T14:28:39.000Z","2026-11-02T15:00:33.056Z",[181,185,184,427,428],82,"供应链","工控","f447","2026-11-02T13:46:42.052Z",{"_160":109,"_32":438,"_162":439,"_164":440,"_166":441,"_168":442,"_170":430,"_14":172,"_173":443,"_175":444,"_177":178,"_12":179,"_180":-5},{"_152":433,"_154":45,"_155":63,"_156":434},"flU3MNG-JM7M",[435,436,437,109],"p8lgm331w38cxp1dyo8ycly9z","ghi7z0u79zotlr12i1ld0lr79","l79qvcx1c4awu9yey6ibz7nvh","Google 联合处置 XCPE 僵尸网络，Videostrong 预装后门感染逾 130 万台机顶盒","Google 与行业伙伴已拆除 XCPE 后门相关控制基础设施，该后门将超过 1.3 million 台机顶盒及其他 Android IoT 设备纳入僵尸网络。","文章拆解了从固件预装、持久化到模块化变现的完整链条，并提供可核对的样本哈希与网络指标。",{"_49":115},"2026-11-02T14:00:00.000Z",[181,182,445,183,185,446,229],90,"后门","供应链投毒","ak8iee38q6sr0000yquvlj925i","2026-11-02T15:48:37.650Z",{"_160":450,"_32":451,"_162":452,"_164":453,"_166":454,"_168":442,"_170":448,"_14":315,"_173":455,"_175":456,"_177":178,"_12":179,"_180":-5},"k8iee38q6sr0000yquvlj925i","Google Cloud 披露 LLMJacking 攻击链，攻击者转售被盗企业 LLM 资源","Google Cloud 威胁情报披露，攻击者在 2026 年多起 LLMJacking 入侵中盗用企业云身份和 LLM API 凭据，入侵北美、南美及亚太的金融、零售、技术和运输组织，单日欺诈费用超过 $100,000 USD，部分组织累计达 $1 million USD。","文章以多起真实入侵还原 LLMJacking 的获客、变现与检测链路，并给出可落地的云侧审计和加固措施。",{"_49":115},[318,181,182,226,427,227,229,457,230],80,"AWS","f460","2026-11-02T16:01:33.457Z",{"_160":461,"_32":462,"_162":463,"_164":464,"_166":465,"_168":466,"_170":459,"_14":172,"_173":467,"_175":224,"_177":178,"_12":179,"_180":-5},"y3oqogzfuz08thepvfa99u3bx","BTCPay Server 旧版本实例遭遇热钱包盗取，2.4.1及更早版本需升级至2.4.7","BTCPay Server 维护者称，黑客已针对运行 2.4.1（2026年7月23日）或更早版本的实例盗取热钱包资金，攻击未针对公开服务器。项目建议受影响实例尽快下线并升级至 2.4.7；原文称尚无使用 2.4.7 的热钱包盗取可信报告，但近期攻击具体利用的漏洞尚未查明，受影响用户需向 security@btcpayserver.org 提交活动日志。","材料区分了受影响版本、当前利用链尚未查明的部分，以及面向 Docker 和普通安装的更新路径。",{"_49":72},"2026-11-02T15:03:07.000Z",[181,205,226,468,208],"加密","f467","2026-11-02T18:47:35.698Z",{"_160":472,"_32":473,"_162":474,"_164":475,"_166":476,"_168":477,"_170":470,"_14":201,"_173":478,"_175":479,"_177":178,"_12":179,"_180":-5},"g91jpin898ib1bej3gd5gopsn","Linux 内核 CVE-2026-98432 波及自托管 JFrog 运行环境","Linux 内核 CVE-2026-98432 是一处影响新建 IPv4 TCP 连接的 use-after-free 缺陷，自 4.4 起存在，Linux 内核团队评分 9.8。","文章区分了 JFrog 产品与承载环境的风险，并给出按发行版核查内核修复状态和分批更新的操作路径。",{"_49":480},"2026-11-02T18:35:06.000Z",[204,205,270,206,407,408,333,232,457],77,"JFrog Security Research",{"_482":483,"_484":-5},"changelogVersion","2026-10-01T08:00","release"]
