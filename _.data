ef2b2b57fb06e54f.webp","/dailyinfo/media/2adef5b1e4357a03.webp 48w, /dailyinfo/media/ef2b2b57fb06e54f.webp 96w","SCKit攻击波及48家机构288个端点",24.2,"up","4c4f0d1f-c78b-4aee-8605-fa5f25c7bd8c","h2occksxu7q3tzi57634syb7r",[82,83,84,85,86],{"_49":88,"_51":52,"_53":-5},{"_49":60,"_51":52,"_53":61,"_55":62},{"_49":57,"_51":52,"_53":58,"_55":59},{"_49":50,"_51":52,"_53":54,"_55":56},{"_49":87,"_51":52,"_53":-5},"Cybernews","Microsoft Security Blog",2,"wfx-loot借GitHub令牌窃取CI凭据",24.9,"bfdc6f86-491d-43b2-8633-af8a571001fd","m2uopbxw2xg55pf3fx6t03uwr",[96,97,98,99,100,101],6,{"_49":105,"_51":52,"_53":106,"_55":107},{"_49":60,"_51":52,"_53":61,"_55":62},{"_49":50,"_51":52,"_53":54,"_55":56},{"_49":102,"_51":52,"_53":103,"_55":104},{"_49":57,"_51":52,"_53":58,"_55":59},{"_49":87,"_51":52,"_53":-5},"Help Net Security","/dailyinfo/media/06c9ab9de6dbb6a5.webp","/dailyinfo/media/9c1b5fa87b3bafc5.webp 48w, /dailyinfo/media/06c9ab9de6dbb6a5.webp 96w","Hackread","/dailyinfo/media/dd06beac4cadc6f3.webp","/dailyinfo/media/47417cbef4636b7b.webp 48w, /dailyinfo/media/dd06beac4cadc6f3.webp 96w",1,"Apache mod_http2竞态漏洞公开PoC",52.1,"f7ee3fa3-8470-4dc6-9f4b-db1dac75a093","wsj9gmwajcglomdxl9m654rps",[115,116,117,118,119,120,121,122,123,124],10,{"_49":135,"_51":52,"_53":-5},{"_49":134,"_51":52,"_53":-5},{"_49":133,"_51":52,"_53":-5},{"_49":132,"_51":52,"_53":-5},{"_49":129,"_51":52,"_53":130,"_55":131},{"_49":126,"_51":52,"_53":127,"_55":128},{"_49":60,"_51":52},{"_49":50,"_51":52},{"_49":125,"_51":52},{"_49":57,"_51":52},"Praetorian Blog","Horizon3.ai","/dailyinfo/media/af82bed48a1365af.webp","/dailyinfo/media/697d1fd5f2d392a5.webp 48w, /dailyinfo/media/af82bed48a1365af.webp 96w","安全内参","/dailyinfo/media/77459fcbf8f21e71.webp","/dailyinfo/media/3399ea7b18d18a6a.webp 48w, /dailyinfo/media/77459fcbf8f21e71.webp 96w","奇安信 CERT","深信服千里目安全实验室","绿盟科技CERT","微步在线研究响应中心","2026-11-14",8,"2026-11-13",21,{"_160":453,"_162":454,"_164":455,"_166":-5},{"_160":441,"_162":442,"_164":443,"_166":-5},{"_160":429,"_162":430,"_164":431,"_166":-5},{"_160":417,"_162":418,"_164":419,"_166":-5},{"_160":404,"_162":405,"_164":406,"_166":-5},{"_160":393,"_162":394,"_164":395,"_166":-5},{"_160":377,"_162":378,"_164":379,"_166":-5},{"_160":367,"_162":368,"_164":369,"_166":-5},{"_160":354,"_162":355,"_164":356,"_166":-5},{"_160":339,"_162":340,"_164":341,"_166":-5},{"_160":324,"_162":325,"_164":326,"_166":-5},{"_160":307,"_162":308,"_164":309,"_166":310},{"_160":294,"_162":295,"_164":296,"_166":-5},{"_160":271,"_162":272,"_164":273,"_166":274},{"_160":258,"_162":259,"_164":260,"_166":-5},{"_160":245,"_162":246,"_164":247,"_166":-5},{"_160":234,"_162":235,"_164":236,"_166":-5},{"_160":219,"_162":220,"_164":221,"_166":-5},{"_160":203,"_162":204,"_164":205,"_166":-5},{"_160":161,"_162":163,"_164":165,"_166":167},"key","f1238","anchorAt","2026-11-12T20:07:22.740Z","item",{"_177":174,"_32":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":163,"_14":188,"_189":190,"_191":192,"_193":194,"_12":195,"_196":-5},"group",{"_168":169,"_170":89,"_171":45,"_172":173},"factId","feTzrtc_-Ycc","additionalSourceCount","reportCount","memberIds",[174,175,176],"nfe40jld0azdyvkuu4pkr1p7u","nxxq4crazs05wb4oacstt8ov2","iqp27qc6nscqjdlpevv69i5l9","id","N-able N-central 4EverAble2Shell 零日漏洞已被利用，21 台服务器失陷","summary","攻击者已利用 N-able N-central 的 4EverAble2Shell 漏洞攻陷至少 21 台生产服务器，其中 19 台运行 2026.4.1.26。","reason","多家安全公司观测到完整利用链并确认生产服务器失陷，文中还给出了受影响版本、请求路径与排查线索。","source",{"_49":60},"publishedAt","2026-11-12T19:51:16.000Z","timelineAt","activity","tags",[197,198,199,200,201,202],"score",80,"selected",true,"news","x","攻击活动","在野利用","漏洞利用","恶意软件","挖矿","数据窃取","atthpdpwhuywrbj6runx9i9ryn","2026-11-12T23:14:23.116Z",{"_177":206,"_32":207,"_179":208,"_181":209,"_183":210,"_185":211,"_187":204,"_14":212,"_189":213,"_191":214,"_193":194,"_12":195,"_196":-5},"tthpdpwhuywrbj6runx9i9ryn","PostgreSQL 18.7 等版本修复 52 个漏洞并终止 PostgreSQL 14 支持","PostgreSQL Global Development Group 于 November 12 发布 PostgreSQL 18.7、17.12、16.16、15.20 和 14.25，修复 52 个安全漏洞及 140 多个其他缺陷，其中 32 个 CVE 的 CVSS 分为 8.8。","原文列出了多版本修复范围、漏洞评分和升级后索引处理事项，便于管理员评估维护与迁移工作。",{"_49":102},"2026-11-12T23:05:33.000Z","vuln",[215,216,217,218],76,"漏洞","补丁","数据库","漏洞管理","f1268","2026-11-12T23:39:24.379Z",{"_177":222,"_32":223,"_179":224,"_181":225,"_183":226,"_185":227,"_187":220,"_14":228,"_189":229,"_191":214,"_193":194,"_12":195,"_196":-5},"ychw6bek6sbholn90ux3rcvl3","Pillow TIFF 与 EXIF 解析存在重叠标签数据内存耗尽漏洞","Pillow 的 `ImageFileDirectory_v2.load()` 存在内存耗尽漏洞：恶意 TIFF、PNG、JPEG、WebP 或 MPO 文件可通过重叠标签数据，使内存占用按“条目数 × 文件大小”增长。","文章给出可复现的内存放大机制、跨格式影响范围与补丁方案，便于评估 Pillow 服务遭遇拒绝服务的风险。",{"_49":233},"2026-11-12T23:35:39.000Z","disclosure",[230,231,232],"技术研究","复现","漏洞分析","GitHub 安全公告","f1269","2026-11-12T23:39:24.387Z",{"_177":237,"_32":238,"_179":239,"_181":240,"_183":241,"_185":242,"_187":235,"_14":212,"_189":243,"_191":214,"_193":194,"_12":195,"_196":-5},"lpork1fvur2f6uit9eo593pgd","Pillow libtiff 编码器堆缓冲区溢出分析与修复方案","Pillow 通过 libtiff 保存 TIFF 时，攻击者控制的 EXIF、tiffinfo 或源文件 IFD 几何标签可覆盖实际图像尺寸，导致 libtiff 按标签尺寸读取或写入行缓冲区。","文章从标签合并与扫描行缓冲区尺寸不一致这一根因出发，梳理了内存泄露、崩溃和堆破坏路径，并给出两套可直接验证的修复方案。",{"_49":233},"2026-11-12T23:34:43.000Z",[215,231,216,232,244],"数据泄露","auw4b9u72e2o2o9dss1xbe5xug","2026-11-13T02:45:27.320Z",{"_177":248,"_32":249,"_179":250,"_181":251,"_183":252,"_185":253,"_187":246,"_14":188,"_189":254,"_191":255,"_193":194,"_12":195,"_196":-5},"uw4b9u72e2o2o9dss1xbe5xug","FBI 扣押从 Binance 窃取的逾 12 亿美元加密货币，并归因 North Korea 攻击","FBI 宣布已获法院授权扣押或限制从 Binance 窃取的资金，超过 1.2 billion 美元；该交易所上月遭窃约 6.3 billion 美元，被视为史上规模最大的加密货币盗窃案，FBI 此前将事件归因于 North Korea 黑客组织 TraderTraitor。","材料说明 FBI 已司法授权扣押逾 12 亿美元被盗加密资产，同时交代 FaceStealer 社会工程链及冻结资金规模，便于判断事件进展与追赃情况。",{"_49":50},"2026-11-13T02:28:21.000Z",[197,244,256,257],70,"加密","AWS","f1294","2026-11-13T06:08:23.387Z",{"_177":261,"_32":262,"_179":263,"_181":264,"_183":265,"_185":266,"_187":259,"_14":188,"_189":267,"_191":268,"_193":194,"_12":195,"_196":-5},"h4oo2pz3pufp6tnrbp9v3x9cn","Material Security 追踪到 27 个疑似朝鲜 IT 人员身份进入企业入职流程","Material Security 在一年内发现 27 个疑似朝鲜虚假 IT 人员身份进入企业入职流程，其中 18 个同时在其他公司推进求职。最新联系的 99 家组织中，4 家已有身份进入入职阶段，这些企业分别存放约 1,500 万至 1,500 万个源代码文件，以及大量社会安全号码、银行或路由号码和私钥文件，部分数据可被全体员工或持链接者访问。","文章用一年期招聘漏斗和开放文件统计揭示虚假IT人员进入企业入职流程后的实际访问风险，并给出可落地的身份核验与权限排查方法。",{"_49":102},"2026-11-13T06:00:22.000Z",[197,269,244,270],77,"身份与访问","红队","f1298","2026-11-13T07:50:29.027Z",{"_177":41,"_32":279,"_179":280,"_181":281,"_183":282,"_185":283,"_187":284,"_14":188,"_189":285,"_191":286,"_193":194,"_12":195,"_196":-5},{"_168":275,"_170":89,"_171":45,"_172":276},"fzelEpTZdDpQ",[277,41,278],"qjrrre5p1072uci857wf0xu5x","w32prfcxar9lgnbdhmsb4fb62","攻击者利用 PHP2Shell 入侵 Check Point 网关并部署 VMware ESXi 数据擦除器","攻击者利用 PHP2Shell 漏洞 CVE-2026-109618 和 CVE-2026-109619 入侵 Check Point Security Gateway 的 Mobile Access 门户。","材料还原了从网关入侵、提权、横向移动到数据擦除的完整攻击链，并提供了补丁与入侵排查线索。",{"_49":60},"2026-11-13T16:21:43.000Z","2026-11-13T16:37:24.630Z",[197,198,199,287,244,288,289,290,291,257,292,293],92,"后门","供应链","Check Point","VMware","CISA","ESET","Ivanti","apc8as95x3w41yh4oar095yxmg","2026-11-13T12:16:25.168Z",{"_177":297,"_32":298,"_179":299,"_181":300,"_183":301,"_185":302,"_187":295,"_14":188,"_189":303,"_191":304,"_193":194,"_12":195,"_196":-5},"pc8as95x3w41yh4oar095yxmg","Operation Endgame 关闭 Gootloader、CastleRAT 和 StealC 基础设施，查获 6.4M 组失窃登录凭据","Operation Endgame 已关闭 Gootloader、CastleRAT 和 StealC 相关基础设施，共查获 235 台服务器、257 个域名及约 6.4 million 组失窃登录凭据，涉及超过 40,000 名受害者。","材料呈现了跨区域执法行动如何同时关闭恶意软件基础设施、查扣失窃凭据并开展受害者通知，适合用于评估类似多阶段攻击的处置范围。",{"_49":57},"2026-11-13T10:55:03.000Z",[197,200,305,202,287,306],88,"勒索","凭据","f1314","2026-11-13T12:54:29.181Z",{"_177":313,"_32":315,"_179":316,"_181":317,"_183":318,"_185":319,"_187":308,"_14":212,"_189":320,"_191":321,"_193":194,"_12":195,"_196":-5},{"_168":311,"_170":108,"_171":89,"_172":312},"f2frbTTF4SAw",[313,314],"er76kiktigpbgezkupewfz59z","wi7ly08wpqyim5ljoqty0063g","Apache HTTP/2 远程代码执行漏洞 CVE-2026-119618 已复现","Apache HTTP Server 的 mod_http2 存在远程代码执行漏洞 CVE-2026-119618，奇安信 CERT 已成功复现。攻击者无需认证，在目标启用并开放 HTTP/2 时，可利用并发流和特定请求头布局触发无锁 APR allocator 竞争，造成进程崩溃、拒绝服务，并可能以 httpd 进程权限执行任意代码。","原文给出并发竞态的触发原理、受影响版本和无认证利用条件，并提供了可用的升级与临时缓解方案。",{"_49":132},"2026-11-13T07:40:00.000Z",[215,231,199,216,322,323],82,"网络设备","奇安信","f1332","2026-11-13T12:56:28.930Z",{"_177":327,"_32":328,"_179":329,"_181":330,"_183":331,"_185":332,"_187":325,"_14":228,"_189":333,"_191":334,"_193":194,"_12":195,"_196":-5},"p4onmtqqizwd1h17c3m9x1czt","WordPress Core 竞争条件远程代码执行漏洞 CVE-2026-119977 复现分析","作者复现并分析了 WordPress Core 竞争条件远程代码执行漏洞 CVE-2026-119977。","文章从暂存目录、安装器与文件复制三个环节还原竞争条件，并提供可复现 PoC 和修复版本，便于理解漏洞成因与处置重点。",{"_49":338},"2026-11-13T06:24:36.000Z",[232,231,199,335,230,336,337],84,"利用链","PHP","阿里","先知社区","f1324","2026-11-13T13:56:25.799Z",{"_177":342,"_32":343,"_179":344,"_181":345,"_183":346,"_185":347,"_187":340,"_14":188,"_189":348,"_191":349,"_193":194,"_12":195,"_196":-5},"wz2ouxat7l8a80o3zl97dofcp","CyberStrikeAI 入侵 AWS：16 天内跨 4 个账户调用 78 次 API","一台 CyberStrikeAI 服务器在 2026 年 9 月 30 日至 10 月 16 日间，利用 8 个 AWS 身份凭据侵入 4 个账户并触发 78 条告警；其中一次在 141 毫秒内批量读取 56 个 EC2 user data，另一身份解密 SSM 参数后 29 秒发起 SendCommand。","文章通过 CloudTrail 时间线还原了低严重度告警如何经长期关联构成同一次入侵，并提供了可迁移的行为检测与 IAM 处置思路。",{"_49":353},"2026-11-13T15:27:20.000Z",[197,350,351,306,270,257,352],71,"AI 攻防","云原生","Fortinet","Elastic Security Labs","f1316","2026-11-13T14:58:29.799Z",{"_177":357,"_32":358,"_179":359,"_181":360,"_183":361,"_185":362,"_187":355,"_14":188,"_189":363,"_191":364,"_193":194,"_12":195,"_196":-5},"es24au8p14acocvmeecd4pz0w","执法机构拆除 Gootloader 恶意软件与僵尸网络，涉及 25,000 台受感染计算机","国际执法行动已从 100 多台服务器移除 Gootloader，并查封用于投递和控制该恶意软件的美国域名，涉及全球至少 25,000 台受感染计算机。Gootloader 自 2018 年以来主要通过入侵的 WordPress 网站及其他网站传播，受害者被诱导下载后加入僵尸网络，运营者再向勒索团伙出售访问权限。","材料梳理了 Gootloader 的感染链、载荷类型及执法拆除结果，可用于理解此类恶意软件如何接入勒索团伙并扩大影响。",{"_49":73},"2026-11-13T14:35:44.000Z",[200,305,365,366],72,"黑产","应急响应","f1347","2026-11-13T16:58:25.785Z",{"_177":370,"_32":371,"_179":372,"_181":373,"_183":374,"_185":375,"_187":368,"_14":228,"_189":376,"_191":255,"_193":194,"_12":195,"_196":-5},"rrsrh82dut4erv3eelbyoynnp","Apache HTTP Server mod_http2 条件竞争 RCE 漏洞 CVE-2026-119618 已复现","Apache HTTP Server mod_http2 的 assign_headers() 竞争条件漏洞 CVE-2026-119618 已被微步情报局复现，可导致远程代码执行或子进程崩溃。","文章给出明确受影响版本、HTTP/2 配置前提和 PoC 复现结果，便于读者对照资产并选择修复或临时缓解措施。",{"_49":135},"2026-11-13T13:55:00.000Z",[231,232,199,216],"ak8q8wjtgm1ani9e5qkly6h7dl","2026-11-13T16:59:25.728Z",{"_177":380,"_32":381,"_179":382,"_181":383,"_183":384,"_185":385,"_187":378,"_14":386,"_189":387,"_191":192,"_193":194,"_12":195,"_196":-5},"k8q8wjtgm1ani9e5qkly6h7dl","Elastic 分析 ARTEX 等五套 AI 攻击框架及在野入侵","Elastic Security Labs 发现 ARTEX、CyberStrikeAI、Cairn、PentAGI 和 HexStrike 五套 AI 攻击框架已出现在真实入侵中，而非仅用于红队测试；五者 GitHub stars 合计超过 60,000。","文章结合源码与公开事件拆解五套 AI 攻击框架的自主执行链，并给出可落地的行为检测与凭据处置建议。",{"_49":353},"2026-11-13T16:00:00.000Z","ai-security",[388,389,350,230,390,270,391,392,257],"AI 安全","Agent 安全","检测工程","Google","Microsoft","f1350","2026-11-13T17:59:25.983Z",{"_177":396,"_32":397,"_179":398,"_181":399,"_183":400,"_185":401,"_187":394,"_14":212,"_189":402,"_191":403,"_193":194,"_12":195,"_196":-5},"k60zo1iyllp9listygh4t3xuv","Apache HTTP Server mod_http2 竞态条件远程代码执行漏洞 CVE-2026-119618 已披露","Apache HTTP Server 的 mod_http2 模块存在竞态条件远程代码执行漏洞 CVE-2026-119618，威胁等级为严重，无需认证即可远程触发，但前提是服务器启用 mod_http2 并对外提供 HTTP/2 服务。","原文给出竞态条件的位置、受影响版本和复现结果，并提供官方升级版本与临时禁用 mod_http2 的处置方案，便于评估 HTTP/2 暴露风险。",{"_49":133},"2026-11-13T09:06:00.000Z",[215,231,232,335,216,322],74,"aw9vfncg3nuocwchohygcm6m6s","2026-11-13T18:06:25.304Z",{"_177":407,"_32":408,"_179":409,"_181":410,"_183":411,"_185":412,"_187":405,"_14":212,"_189":413,"_191":414,"_193":194,"_12":195,"_196":-5},"w9vfncg3nuocwchohygcm6m6s","PostgreSQL 修复 52 项安全缺陷，CVE-2026-6460 可导致已认证 RCE","PostgreSQL 发布安全更新，修复 52 项安全缺陷，其中类型混淆漏洞 CVE-2026-6460 的 CVSS 为 8.8，允许可创建对象的数据库用户执行服务器代码；所有低于 18.7、17.12、16.16、15.20 和 14.25 的版本受影响，目前尚无攻击报告。","文章给出漏洞成因、受影响版本、利用前提和 PoC 进展，并列出扩展重建、客户端更新等处置事项。",{"_49":57},"2026-11-13T16:53:08.000Z",[215,216,231,199,217,415,416,291,257,392,391],75,"Oracle","Red Hat","f1355","2026-11-13T18:19:24.598Z",{"_177":420,"_32":421,"_179":422,"_181":423,"_183":424,"_185":425,"_187":418,"_14":188,"_189":426,"_191":403,"_193":194,"_12":195,"_196":-5},"zi4jqtzxradwjx53lvs0cf651","德国 Quantum Systems 无人机业务遭网络攻击，QBase 恶意更新疑为入口","德国国防科技公司 Quantum Systems 确认，其侦察与拦截无人机业务在 late October 遭“敌对行动者”攻击，QBase 地面控制与任务规划软件的更新分发服务器疑遭入侵并投递恶意更新文件。","材料说明攻击通过 QBase 更新分发服务器投递恶意更新，并交代无人机停飞、调查机构及归因不确定性，便于理解此次事件的攻击路径与影响。",{"_49":60},"2026-11-13T17:31:56.000Z",[197,427,200,428,288],"供应链投毒","IoT","f1369","2026-11-13T20:02:29.322Z",{"_177":432,"_32":433,"_179":434,"_181":435,"_183":436,"_185":437,"_187":430,"_14":188,"_189":438,"_191":214,"_193":194,"_12":195,"_196":-5},"kwq30stubj3ryg11q7j0ngxx8","Cloudflare 披露 AI 渗透测试编排框架激增与凭据链式利用","Cloudflare 指出，AI 渗透测试与利用编排框架正快速扩散，3天内已有 50 多个框架家族扫描其全球客户，相关 IP 达数千个；截至 11 月 12 日，ARTEX 及其分支占已知框架的 60% 以上。","文章结合全球扫描与事件响应观测，说明 AI 渗透编排框架的扩散速度、凭据链式利用及可落地的六层防护框架。",{"_49":440},"2026-11-13T19:26:07.000Z",[197,388,389,350,306,351,439],"Cloudflare","Cloudflare Blog","aqeruuzfjoy6z4m589atx262j4","2026-11-13T21:03:26.694Z",{"_177":444,"_32":445,"_179":446,"_181":447,"_183":448,"_185":449,"_187":442,"_14":386,"_189":450,"_191":451,"_193":194,"_12":195,"_196":-5},"qeruuzfjoy6z4m589atx262j4","Cisco Talos 发现 ARTEX 已被用于多行业攻击并关联超过 2,500 个 C2 IP 地址","Cisco Talos 发现开源 AI 渗透测试框架 ARTEX 已被威胁行动者用于侦察、凭据窃取、云端滥用、横向移动和数据外泄，目标覆盖金融、政府、电信、国防等行业。","文章结合公开归因与Talos实测，梳理ARTEX从侦察、初始访问、云端滥用到数据外泄的攻击链，并给出可落地的检测与隔离建议。",{"_49":452},"2026-11-13T20:57:13.000Z",[388,389,197,270,199,288],83,"Cisco Talos","aqr7yw6vafmf6e5mjlmebcs0x4","2026-11-13T21:04:27.833Z",{"_177":456,"_32":457,"_179":458,"_181":459,"_183":460,"_185":461,"_187":454,"_14":188,"_189":462,"_191":364,"_193":194,"_12":195,"_196":-5},"qr7yw6vafmf6e5mjlmebcs0x4","Amazon Threat Intelligence 发现攻击者利用 ARTEX AI Agent 窃取凭据并绕过 KYC","Amazon Threat Intelligence 从 MadPot 诱捕传感器于 2026 年 10 月 3 日至 11 月 5 日捕获的攻击请求中，发现攻击者使用开源 ARTEX Agent 框架开展凭据窃取和加密货币交易所 KYC 绕过。","公开了 AI Agent 运行凭据窃取与 KYC 绕过活动时的任务记录、工作流和 IOC，可用于识别自动化攻击模式并核对自身环境。",{"_49":463},"2026-11-13T20:26:42.000Z",[197,388,389,350,306,202,257],"AWS Security Blog",{"_465":466,"_467":-5},"changelogVersion","2026-10-01T08:00","release"]
