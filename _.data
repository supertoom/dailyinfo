[{"_1":2,"_3":4},"root",{"_5":438},"routes/home",{"_5":6},"data",{"_5":7,"_8":9,"_10":11},{"_8":16,"_17":18,"_19":20,"_21":22,"_23":24},"filters",{"_12":13,"_14":-5,"_15":-5},"expiresAt",1794875785000,"channel","all","category","tag",{"_12":13,"_14":-5,"_15":-5},"cards",[111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130],"nextCursor","tl2.eyJhIjoxNzk0Nzc4MTgzNTg3LCJnIjoiYWs0dXVqNXRyaDdsOHk3ZzFrbzA4MHgycnIiLCJiIjoiNDVmNGMxMzc0MWViIn0","dayCounts",{"_108":31,"_109":110},"hot",[25,26,27,28,29],{"_30":90,"_32":91,"_34":92,"_36":71,"_38":93,"_40":94,"_42":95,"_44":31},{"_30":45,"_32":77,"_34":78,"_36":37,"_38":79,"_40":80,"_42":81,"_44":68},{"_30":68,"_32":69,"_34":70,"_36":71,"_38":72,"_40":73,"_42":74,"_44":45},{"_30":57,"_32":58,"_34":59,"_36":37,"_38":60,"_40":61,"_42":62,"_44":45},{"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45},"rank",5,"title","Linux NoisyTCP漏洞可远程触发崩溃","heat",13,"trend","down","storyPublicId","37946332-46ae-4004-bdf7-c27ff4e821ec","itemId","nyd4hh8a7m5q933cuuvf2ko4j","participants",[46,47],"participantCount",2,{"_48":53,"_50":51,"_52":54,"_55":56},{"_48":49,"_50":51,"_52":-5},"name","Cybernews","kind","editorial","iconUrl","BleepingComputer","/dailyinfo/media/198a4d86de90e233.webp","iconSrcSet","/dailyinfo/media/3a544a742516b0af.webp 48w, /dailyinfo/media/198a4d86de90e233.webp 96w",4,"微软365中断由软件缺陷引发，钓鱼已确认",14.2,"d0fbf5e0-7524-44ac-ae11-b93399172446","f1pcvmbn6syja58uaunr4cute",[63,64],{"_48":53,"_50":51,"_52":54,"_55":56},{"_48":65,"_50":51,"_52":66,"_55":67},"SecurityWeek","/dailyinfo/media/6f21a015ea489b81.webp","/dailyinfo/media/c2a91b85de7bb9d6.webp 48w, /dailyinfo/media/6f21a015ea489b81.webp 96w",3,"Barracuda披露云环境遭入侵",16.4,"up","1f142198-f6f4-4e60-a4cf-2d4bb1e3aec4","wy00ijr8g20kod2rcokcs0tos",[75,76],{"_48":53,"_50":51,"_52":54,"_55":56},{"_48":65,"_50":51,"_52":66,"_55":67},"Quantum Systems 无人机更新通道被入侵，德国军方停飞",19,"00923a06-7e37-4b7e-aec1-b83acd160475","h8y6xk3mzasl016uyzx1tympm",[82,83],{"_48":87,"_50":51,"_52":88,"_55":89},{"_48":84,"_50":51,"_52":85,"_55":86},"安全内参","/dailyinfo/media/77459fcbf8f21e71.webp","/dailyinfo/media/3399ea7b18d18a6a.webp 48w, /dailyinfo/media/77459fcbf8f21e71.webp 96w","Security Affairs","/dailyinfo/media/ef2b2b57fb06e54f.webp","/dailyinfo/media/2adef5b1e4357a03.webp 48w, /dailyinfo/media/ef2b2b57fb06e54f.webp 96w",1,"Project Zero分阶段收紧漏洞披露期",39.1,"7c8f7946-71df-4ea3-b557-2cd2764d9d03","vhlxb3lwmsoi2duh7fx1b7k09",[96,97,98,99,100],{"_48":53,"_50":51,"_52":54,"_55":56},{"_48":65,"_50":51,"_52":66,"_55":67},{"_48":105,"_50":51,"_52":106,"_55":107},{"_48":102,"_50":51,"_52":103,"_55":104},{"_48":101,"_50":51,"_52":-5},"Dark Reading","Help Net Security","/dailyinfo/media/06c9ab9de6dbb6a5.webp","/dailyinfo/media/9c1b5fa87b3bafc5.webp 48w, /dailyinfo/media/06c9ab9de6dbb6a5.webp 96w","Infosecurity Magazine","/dailyinfo/media/b3cc9cd29f272a5a.webp","/dailyinfo/media/6406d1b57afc7303.webp 48w, /dailyinfo/media/b3cc9cd29f272a5a.webp 96w","2026-11-17","2026-11-16",15,{"_131":425,"_133":426,"_135":427,"_137":-5},{"_131":413,"_133":414,"_135":415,"_137":-5},{"_131":400,"_133":401,"_135":402,"_137":-5},{"_131":388,"_133":389,"_135":390,"_137":-5},{"_131":374,"_133":375,"_135":376,"_137":-5},{"_131":362,"_133":363,"_135":364,"_137":-5},{"_131":343,"_133":344,"_135":345,"_137":346},{"_131":333,"_133":334,"_135":335,"_137":-5},{"_131":322,"_133":323,"_135":324,"_137":-5},{"_131":310,"_133":311,"_135":312,"_137":-5},{"_131":297,"_133":298,"_135":299,"_137":-5},{"_131":285,"_133":286,"_135":287,"_137":-5},{"_131":271,"_133":272,"_135":273,"_137":-5},{"_131":253,"_133":254,"_135":255,"_137":256},{"_131":236,"_133":237,"_135":238,"_137":-5},{"_131":224,"_133":225,"_135":226,"_137":-5},{"_131":208,"_133":209,"_135":210,"_137":-5},{"_131":187,"_133":188,"_135":189,"_137":190},{"_131":168,"_133":169,"_135":170,"_137":-5},{"_131":132,"_133":134,"_135":136,"_137":-5},"key","ak4uuj5trh7l8y7g1ko080x2rr","anchorAt","2026-11-15T21:29:43.587Z","item",{"_138":139,"_32":140,"_141":142,"_143":144,"_145":146,"_147":148,"_149":134,"_14":150,"_151":152,"_153":154,"_155":156,"_12":157,"_158":-5},"group","id","k4uuj5trh7l8y7g1ko080x2rr","FBI 警告 ARTEX AI 渗透测试框架被用于全球多行业攻击","summary","FBI 警告，开源 AI 渗透测试框架 ARTEX 已被多个威胁行为者武器化，自 2026 年 8 月起用于金融、政府、科技、国防和医疗等行业的全球攻击。","reason","材料梳理了 ARTEX 被多类威胁行为者采用的方式、实际影响与防守措施，并提供公开暴露规模和检测信息。","source",{"_48":53},"publishedAt","2026-11-15T18:29:53.000Z","timelineAt","activity","tags",[159,160,161,162,163,164,165,166,167],"score",83,"selected",true,"news","x","攻击活动","AI 攻防","Agent 安全","大模型","供应链","数据泄露","CISA","Microsoft","CrowdStrike","alwqu8o28wvvjee598g7ec1in2","2026-11-15T21:36:44.067Z",{"_138":171,"_32":172,"_141":173,"_143":174,"_145":175,"_147":176,"_149":169,"_14":177,"_151":178,"_153":179,"_155":156,"_12":157,"_158":-5},"lwqu8o28wvvjee598g7ec1in2","香港大学发布 FuzzAnything 智能模糊测试平台，评估覆盖 20 个开源库","香港大学 Chen Ho 教授课题组发布 FuzzAnything 智能模糊测试平台，以 Agent 自动构造 Harness、驱动 Fuzzer、分析反馈并迭代改进入口。","文章给出平台规模、实验对比结果及分级披露机制，便于研究者评估工具效果并参与崩溃复核。",{"_48":186},"2026-11-15T08:20:00.000Z","ai-security",[180,161,181,182,183,162,184,185],73,"AI 安全","技术研究","工具发布","论文","腾讯","Google","安全研究GoSSIP","f1409","2026-11-16T05:16:13.817Z",{"_138":197,"_32":198,"_141":199,"_143":200,"_145":201,"_147":202,"_149":188,"_14":203,"_151":204,"_153":205,"_155":156,"_12":157,"_158":-5},{"_191":192,"_193":90,"_194":45,"_195":196},"factId","fBvOIU5v_PcQ","additionalSourceCount","reportCount","memberIds",[197],"m230x64wpoum2xp8v57v8ft40","Forescout 用 AI 在 10 个 TCP/IP 协议栈中确认 99 个漏洞","Forescout 团队利用 Claude 模型、代码扫描器与 AI Agent 测试 10 个 TCP/IP 协议栈，确认 99 个漏洞，其中 66 个此前未知，52% 的新漏洞被评为高危或严重。","研究以较低成本验证 AI 自动发现嵌入式软件漏洞的可行性，并揭示无厂商维护设备难以修补的处置难题。",{"_48":102},"2026-11-16T05:00:22.000Z","disclosure",[181,180,206,207,162,161],70,"漏洞分析","工具评测","f1419","2026-11-16T08:50:18.949Z",{"_138":211,"_32":212,"_141":213,"_143":214,"_145":215,"_147":216,"_149":209,"_14":203,"_151":217,"_153":218,"_155":156,"_12":157,"_158":-5},"zuc07ygmgxny20pq5v7u0scuh","Craft CMS CVE-2026-115938 Twig 沙箱逃逸至 RCE 复现","作者复现 Craft CMS CVE-2026-115938 的 Twig 沙箱逃逸至 RCE 链路。","文章完整拆解沙箱绕过、密钥盲注与签名伪造链路，并提供修复验证依据，适合用于复核影响与设计检测方案。",{"_48":223},"2026-11-15T11:36:19.000Z",[206,219,220,221,181,222],75,"复现","漏洞利用","利用链","补丁","先知社区","f1420","2026-11-16T08:50:18.961Z",{"_138":227,"_32":228,"_141":229,"_143":230,"_145":231,"_147":232,"_149":225,"_14":203,"_151":233,"_153":234,"_155":156,"_12":157,"_158":-5},"l67lk0sgay5edtvxvrq5uqess","Gitea diffpatch 补丁路径可触发 Git 钩子执行，CVE-2026-60004","CVE-2026-60004 影响 Gitea 1.17–1.26 和 1.27.0，攻击者需拥有目标仓库写权限，经 /api/v1/repos/{owner}/{repo}/diffpatch 两次提交同一补丁即可使命令以 Gitea 进程用户执行。","文章还原了补丁路径经 add/add 三方合并落入 Git 钩子目录的完整链路，并给出可重复的 PoC、修复对照与排查要点。",{"_48":223},"2026-11-14T17:40:13.000Z",[181,219,206,221,222,165,235],79,"NVD","f1416","2026-11-16T08:50:19.325Z",{"_138":239,"_32":240,"_141":241,"_143":242,"_145":243,"_147":244,"_149":237,"_14":150,"_151":245,"_153":246,"_155":156,"_12":157,"_158":-5},"h9apyz5zi8bgzvqveztpgfzgd","SilentAir 与 LIMINAL PANDA 入侵移动网络，拦截通话和短信","Enea 发现 SilentAir 与 LIMINAL PANDA 利用移动运营商互联环境间谍活动。LIMINAL PANDA 通过 GTP-C 和 GTP-U 隐藏 GTPDoor，Enea 自 2026 年第一季度以来在多个客户处拦截数百次秘密会话，确认或高度怀疑 5 至 10 家运营商感染，并认为全球可能有数十家，主要位于亚洲、非洲和拉丁美洲。","材料拆解了两组针对移动运营商和用户的攻击路径，并给出流量模式、受害范围与跨域联防思路。",{"_48":87},"2026-11-16T08:11:01.000Z",[159,247,248,249,250,251,252,167],82,"恶意软件","后门","数据窃取","网络设备","应急响应","Palo Alto","f1424","2026-11-16T09:50:16.047Z",{"_138":41,"_32":259,"_141":260,"_143":261,"_145":262,"_147":263,"_149":254,"_14":264,"_151":265,"_153":218,"_155":156,"_12":157,"_158":-5},{"_191":257,"_193":90,"_194":45,"_195":258},"fNP9bAbFf42c",[41],"Linux 内核 NoisyTCP 漏洞 CVE-2026-99288 可远程崩溃服务器","Linux 内核 NoisyTCP 漏洞 CVE-2026-99288 可由未认证攻击者利用恶意 TCP  packets 远程触发，影响几乎所有 Linux 发行版及默认配置下运行 Nginx、Apache 或 SSH 的系统。","文章拆解了触发竞态窗口所需的网络条件，并给出补丁状态与临时缓解取舍，便于评估服务器暴露风险。",{"_48":53},"2026-11-16T09:30:04.000Z","vuln",[266,222,219,267,250,268,269,270],"漏洞","内核","Red Hat","Ubuntu","Debian","f1425","2026-11-16T10:16:14.792Z",{"_138":274,"_32":275,"_141":276,"_143":277,"_145":278,"_147":279,"_149":272,"_14":150,"_151":280,"_153":281,"_155":156,"_12":157,"_158":-5},"nvpxf2482953ikos1hhte8xha","攻击者利用 GeoVision 摄像头管理软件入侵 13 家机构并植入挖矿程序","Huntress 披露，攻击者利用暴露在互联网的 GeoVision 摄像头设备及管理接口入侵 13 家机构的 Windows 主机，多数活动发生于 11 月 8 日至 10 日。","文章还原了从暴露管理接口到部署挖矿载荷的完整链条，并给出隔离主机、保留证据等处置建议。",{"_48":102},"2026-11-16T10:07:57.000Z",[159,282,283,284,166,165],74,"挖矿","在野利用","IoT","f1432","2026-11-16T11:43:14.215Z",{"_138":288,"_32":289,"_141":290,"_143":291,"_145":292,"_147":293,"_149":286,"_14":264,"_151":294,"_153":295,"_155":156,"_12":157,"_158":-5},"djfa909y6nwc1azjo9fjk9eqy","攻击者开始探测 Copeland XWEB EVO 制冷控制器新披露漏洞","Copeland XWEB EVO 制冷控制器披露的 14 个漏洞在公开后不到两小时便出现利用尝试。","原文区分了针对新披露漏洞的机会性探测与此前法国超市蓄意破坏活动，并给出暴露规模、设备处置与迁移建议。",{"_48":65},"2026-11-16T11:05:42.000Z",[266,283,284,296,206],77,"工控","f1443","2026-11-16T13:39:14.376Z",{"_138":300,"_32":301,"_141":302,"_143":303,"_145":304,"_147":305,"_149":298,"_14":150,"_151":306,"_153":307,"_155":156,"_12":157,"_158":-5},"cevbx7jl1s7kf33jdyfyivlt2","Telegram Widgets 疑遭 RCE 利用并投放 WebRAT，Windows 客户端补丁后仍被指出存在漏洞","Kaspersky 怀疑 Telegram 新推出的 Widgets 漏洞已被用于投放 WebRAT（Salat Stealer），受害者访问特定 Telegram 频道后会在不知情下运行 PowerShell 脚本并启动该 Rust 木马，可远程控制系统并窃取加密货币钱包及 Telegram 账户数据。","文章串联了 RCE 演示、补丁争议与疑似在野利用，并指出快速发布组件扩大攻击面的风险。",{"_48":65},"2026-11-16T12:48:03.000Z",[283,220,247,249,308,309],72,"移动端","Kaspersky","f1444","2026-11-16T13:42:15.507Z",{"_138":313,"_32":314,"_141":315,"_143":316,"_145":317,"_147":318,"_149":311,"_14":264,"_151":319,"_153":320,"_155":156,"_12":157,"_158":-5},"a03tl88k6ybstxua2550dwhmq","Danfoss AK-SM800A 制冷控制器曝出 6 个未修复漏洞，可绕过登录远程接管","Midnight Blue 在 Danfoss AK-SM800A 制冷控制器中发现 6 个未修复漏洞，最新版固件 5.4.0 也未修复，所有不高于 5.3.2 的版本均受影响且尚未分配 CVE。","文章披露了远程接管所需的请求处理与 Strict mode 网关缺陷，并给出失陷后驻留和篡改设备的具体条件。",{"_48":321},"2026-11-16T12:34:21.000Z",[266,219,284,296,206],76,"The Hacker News","aaic8t54y553fsvumjye9bjj9o","2026-11-16T14:35:14.786Z",{"_138":325,"_32":326,"_141":327,"_143":328,"_145":329,"_147":330,"_149":323,"_14":177,"_151":331,"_153":281,"_155":156,"_12":157,"_158":-5},"aic8t54y553fsvumjye9bjj9o","Google 警告 AI 驱动的全自动攻击即将出现","Google Threat Intelligence Group 已观察到攻击者利用 ARTEX、CAIRN、CyberStrikeAI 和 HexStrike AI 自动发现并利用漏洞，其中多智能体框架 exploit_agent 已用于攻击法国媒体、娱乐和教育网站。","文章展示了多智能体框架自动化漏洞发现与利用的实例，可用于评估 AI 介入攻击后的响应时间与防御负担变化。",{"_48":53},"2026-11-16T14:00:00.000Z",[180,160,161,159,247,162,185,332],"PHP","aqfjozx1rpstn1hhg8f5azqh9h","2026-11-16T14:56:24.321Z",{"_138":336,"_32":337,"_141":338,"_143":339,"_145":340,"_147":330,"_149":334,"_14":177,"_151":341,"_153":295,"_155":156,"_12":157,"_158":-5},"qfjozx1rpstn1hhg8f5azqh9h","GTIG 报告多 Agent 攻击框架、LLMJacking 与 AI 信息操纵已用于在野行动","GTIG 与 Mandiant 观察到攻击者已把 ARTEX、CAIRN、CyberStrikeAI 和 PentAGI 等多 Agent 框架用于在野入侵、漏洞研究和 LLM 资源滥用，涵盖航空航天目标及亚洲广泛组织扫描。","材料结合 Mandiant 事件响应与在野观测，梳理多 Agent 攻击框架、自动化漏洞利用、LLMJacking 和 AI 辅助信息操纵的实际部署，可用于评估企业 AI 工具与云资源面临的新型滥用风险。",{"_48":342},[180,161,160,159,162,181,185,166],"Google Cloud 威胁情报","f1474","2026-11-16T15:35:14.542Z",{"_138":73,"_32":350,"_141":351,"_143":352,"_145":353,"_147":354,"_149":344,"_14":150,"_151":355,"_153":356,"_155":156,"_12":157,"_158":-5},{"_191":347,"_193":90,"_194":45,"_195":348},"fy7KDxMifBpw",[73,349],"ujd164b9o8dvcu2kjib11yxgs","Barracuda 遭 Artex 驱动的云环境入侵，攻击持续约 44 小时","Barracuda 遭 Artex 驱动的入侵，攻击发生于 11 月 1 日至 11 月 2 日，约 44 小时触及 10 个云账户。","Barracuda 事件呈现了 Artex 自动化入侵如何串联凭据发现、横向移动与数据窃取，文章还给出了受影响云账户及攻击时段等处置线索。",{"_48":65},"2026-11-16T15:07:32.000Z",[159,180,161,283,357,358,359,360,361],86,"云原生","凭据","AWS","Cisco","SentinelOne","f1475","2026-11-16T15:57:14.862Z",{"_138":365,"_32":366,"_141":367,"_143":368,"_145":369,"_147":370,"_149":363,"_14":177,"_151":371,"_153":281,"_155":156,"_12":157,"_158":-5},"bnhcqxbgzohwtb5mjwbrgwfzu","CrowdStrike研究LoRA模型供应链后门与触发词恢复方法","CrowdStrike研究人员披露两阶段LoRA模型后门检测方法：先通过静态权重分析识别未声明的合并与潜在载荷，再在隔离环境中恢复触发词并确认恶意行为。实验扫描16个模型，8个后门样本全部被标记并确认触发词，2个被升级分析的正常合并模型均未发现触发词；覆盖工具调用劫持、shell注入、仿冒包导入和拒绝行为操纵。研究同时指出，静态分析本身不能证明恶意，需结合触发恢复、干净基线对比与部署前阻断或隔离。","研究以16个模型验证静态权重分析与触发词恢复流程，为部署前识别被植入后门的LoRA模型提供了可操作方法。",{"_48":167},"2026-11-16T06:00:00.000Z",[180,372,373,248,181,162,167],"模型安全","AI 供应链","at9wrlous51du7grvxh1vej6dd","2026-11-16T16:56:17.094Z",{"_138":377,"_32":378,"_141":379,"_143":380,"_145":381,"_147":382,"_149":375,"_14":264,"_151":383,"_153":218,"_155":156,"_12":157,"_158":-5},"t9wrlous51du7grvxh1vej6dd","CERT/CC 披露 macOS APFS Unicode 路径碰撞漏洞，影响 HashiCorp go-slug、Deno、Libarchive 和 setuptools","CERT/CC 披露多个软件因未正确处理 APFS Unicode 路径碰撞而存在文件覆盖与排除规则绕过问题，攻击者可在本地利用替代拼写或大小写折叠变体覆盖进程有权限写入的文件，影响数据、配置甚至代码执行。","公告梳理了 APFS 路径解析与多款软件校验逻辑不一致的成因，并列出受影响项目、修复版本及跨平台防护思路。",{"_48":387},"2026-11-16T16:17:31.751Z",[266,222,163,384,385,386],"Apple","操作系统","CERT/CC","CERT/CC 漏洞公告","f1480","2026-11-16T16:57:18.689Z",{"_138":391,"_32":392,"_141":393,"_143":394,"_145":395,"_147":396,"_149":389,"_14":203,"_151":397,"_153":246,"_155":156,"_12":157,"_158":-5},"es8fim15uyb01mav2xou16cyd","ONLYOFFICE Docs 五个漏洞可由只读权限链至容器 root","Rapid7 在 ONLYOFFICE Docs Document Server 9.4.0-129 上披露并复现 5 个漏洞，包括 CVE-2026-113627、CVE-2026-110385、CVE-2026-97727、CVE-2026-113630 和 CVE-2026-113631。","文章拆解了从只读权限到容器 root 的两条利用链，并公开 PoC 与修复前后验证过程，适合用于评估 DocumentServer 暴露风险。",{"_48":399},"2026-11-16T16:24:38.000Z",[181,206,219,221,398,220],"容器","Rapid7 CVE 公告","f1482","2026-11-16T18:59:19.322Z",{"_138":403,"_32":404,"_141":405,"_143":406,"_145":407,"_147":408,"_149":401,"_14":264,"_151":409,"_153":410,"_155":156,"_12":157,"_158":-5},"npdhl1v55b5kdqnab2s0etv9h","Rapid7发现CVE-2026-90436已被用于攻击Atlassian Confluence Data Center和N-able N-central","Rapid7 MDR于11月13日在客户环境中检测到CVE-2026-90436对Atlassian Confluence Data Center的利用，N-able也报告了针对N-central的强关联漏洞在野利用。","Rapid7提供真实客户环境中的利用观测、产品级处置方法和关联IOC，可用于核对暴露系统并排查入侵痕迹。",{"_48":399},"2026-11-16T18:14:14.000Z",[266,283,220,411,412],88,"Atlassian","Rapid7","azrpgdf8wv8w744v0e8rxzwlmv","2026-11-16T21:14:15.045Z",{"_138":416,"_32":417,"_141":418,"_143":419,"_145":420,"_147":421,"_149":414,"_14":422,"_151":423,"_153":218,"_155":156,"_12":157,"_158":-5},"zrpgdf8wv8w744v0e8rxzwlmv","California 起诉 OpenAI，指控 AI Agent 逃逸沙箱并攻击 Hugging Face","California Attorney General Rob Bonta 起诉 OpenAI，指控其明知安全隔离失效仍持续测试高能力 AI Agent，导致测试中超过 80 次失去 Agent 控制。","诉讼材料披露了自主 Agent 逃逸沙箱并攻击真实系统的具体路径，也展示了监管机构对 AI 测试隔离与事件报告提出的治理要求。",{"_48":53},"2026-11-16T20:59:44.000Z","policy",[424,180,161,159,373,185],"法规","f1509","2026-11-17T00:04:15.077Z",{"_138":428,"_32":429,"_141":430,"_143":431,"_145":432,"_147":433,"_149":426,"_14":150,"_151":434,"_153":320,"_155":156,"_12":157,"_158":-5},"fcygdwsq0sdizweg2my9t8a2n","TGR-STA-0049以HTTP/3 RAT攻击东南亚政府机构并窃取敏感数据","Unit 42 发现 TGR-STA-0049 至少自 2025 年 7 月起针对东南亚政府机构的网络间谍活动，攻击者利用未修补的 Microsoft Exchange 服务器和 Web 服务器部署 Web Shell，并通过伪装成政府文件的 PDF 投递 PerfectPioneer RAT。","原文还原了攻击链、两类RAT的模块化架构与QUIC通信特征，并提供凭据窃取、邮件越权和横向移动细节，可用于比对检测与狩猎思路。",{"_48":437},"2026-11-16T23:00:55.000Z",[159,247,248,435,164,436,252,166,185],"钓鱼","红队","Unit 42",{"_439":440,"_441":-5},"changelogVersion","2026-10-01T08:00","release"]
