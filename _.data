9t7vw429lcgww",[77,78],{"_48":69,"_50":51,"_52":70,"_54":71},{"_48":79,"_50":51,"_52":80,"_54":81},"Help Net Security","/dailyinfo/media/06c9ab9de6dbb6a5.webp","/dailyinfo/media/9c1b5fa87b3bafc5.webp 48w, /dailyinfo/media/06c9ab9de6dbb6a5.webp 96w","美方捣毁FaceStealer恶意基础设施",14.4,"efb8edfb-e064-4a61-b228-fa2f7d7dec9c","y2y1622fhn5bw6bawevcw4sji",[87,88,89],{"_48":91,"_50":51,"_52":92,"_54":93},{"_48":79,"_50":51,"_52":80,"_54":81},{"_48":90,"_50":51,"_52":-5},"Cybernews","Hackread","/dailyinfo/media/dd06beac4cadc6f3.webp","/dailyinfo/media/47417cbef4636b7b.webp 48w, /dailyinfo/media/dd06beac4cadc6f3.webp 96w",1,"Apache mod_http2竞态漏洞公开PoC",16.4,"f7ee3fa3-8470-4dc6-9f4b-db1dac75a093","wsj9gmwajcglomdxl9m654rps",[100,101,102,103,104],{"_48":111,"_50":51,"_52":-5},{"_48":110,"_50":51,"_52":-5},{"_48":109,"_50":51,"_52":-5},{"_48":108,"_50":51,"_52":-5},{"_48":105,"_50":51,"_52":106,"_54":107},"安全内参","/dailyinfo/media/77459fcbf8f21e71.webp","/dailyinfo/media/3399ea7b18d18a6a.webp 48w, /dailyinfo/media/77459fcbf8f21e71.webp 96w","奇安信 CERT","深信服千里目安全实验室","绿盟科技CERT","微步在线研究响应中心","2026-11-15","2026-11-14",10,"2026-11-13",21,{"_137":426,"_139":427,"_141":428,"_143":-5},{"_137":415,"_139":416,"_141":417,"_143":-5},{"_137":404,"_139":405,"_141":406,"_143":-5},{"_137":394,"_139":395,"_141":396,"_143":-5},{"_137":383,"_139":384,"_141":385,"_143":-5},{"_137":371,"_139":372,"_141":373,"_143":-5},{"_137":358,"_139":359,"_141":360,"_143":-5},{"_137":346,"_139":347,"_141":348,"_143":-5},{"_137":332,"_139":333,"_141":334,"_143":-5},{"_137":321,"_139":322,"_141":323,"_143":-5},{"_137":304,"_139":305,"_141":306,"_143":-5},{"_137":294,"_139":295,"_141":296,"_143":-5},{"_137":280,"_139":281,"_141":282,"_143":-5},{"_137":265,"_139":266,"_141":267,"_143":-5},{"_137":247,"_139":248,"_141":249,"_143":-5},{"_137":226,"_139":227,"_141":228,"_143":229},{"_137":211,"_139":212,"_141":213,"_143":-5},{"_137":182,"_139":183,"_141":184,"_143":185},{"_137":169,"_139":170,"_141":171,"_143":-5},{"_137":138,"_139":140,"_141":142,"_143":-5},"key","auw4b9u72e2o2o9dss1xbe5xug","anchorAt","2026-11-13T02:45:27.320Z","item",{"_144":145,"_32":146,"_147":148,"_149":150,"_151":152,"_153":154,"_155":140,"_14":156,"_157":158,"_159":160,"_161":162,"_12":163,"_164":-5},"group","id","uw4b9u72e2o2o9dss1xbe5xug","FBI 扣押从 Binance 窃取的逾 12 亿美元加密货币，并归因 North Korea 攻击","summary","FBI 宣布已获法院授权扣押或限制从 Binance 窃取的资金，超过 1.2 billion 美元；该交易所上月遭窃约 6.3 billion 美元，被视为史上规模最大的加密货币盗窃案，FBI 此前将事件归因于 North Korea 黑客组织 TraderTraitor。","reason","材料说明 FBI 已司法授权扣押逾 12 亿美元被盗加密资产，同时交代 FaceStealer 社会工程链及冻结资金规模，便于判断事件进展与追赃情况。","source",{"_48":69},"publishedAt","2026-11-13T02:28:21.000Z","timelineAt","activity","tags",[165,166,167,168],"score",70,"selected",true,"news","x","攻击活动","数据泄露","加密","AWS","f1294","2026-11-13T06:08:23.387Z",{"_144":172,"_32":173,"_147":174,"_149":175,"_151":176,"_153":177,"_155":170,"_14":156,"_157":178,"_159":179,"_161":162,"_12":163,"_164":-5},"h4oo2pz3pufp6tnrbp9v3x9cn","Material Security 追踪到 27 个疑似朝鲜 IT 人员身份进入企业入职流程","Material Security 在一年内发现 27 个疑似朝鲜虚假 IT 人员身份进入企业入职流程，其中 18 个同时在其他公司推进求职。最新联系的 99 家组织中，4 家已有身份进入入职阶段，这些企业分别存放约 1,500 万至 1,500 万个源代码文件，以及大量社会安全号码、银行或路由号码和私钥文件，部分数据可被全体员工或持链接者访问。","文章用一年期招聘漏斗和开放文件统计揭示虚假IT人员进入企业入职流程后的实际访问风险，并给出可落地的身份核验与权限排查方法。",{"_48":79},"2026-11-13T06:00:22.000Z",[165,180,166,181],77,"身份与访问","红队","f1298","2026-11-13T07:50:29.027Z",{"_144":63,"_32":194,"_147":195,"_149":196,"_151":197,"_153":198,"_155":199,"_14":156,"_157":200,"_159":201,"_161":162,"_12":163,"_164":-5},{"_186":187,"_188":45,"_189":65,"_190":191},"factId","fzelEpTZdDpQ","additionalSourceCount","reportCount","memberIds",[192,193,63],"w32prfcxar9lgnbdhmsb4fb62","qjrrre5p1072uci857wf0xu5x","攻击者利用 PHP2Shell 入侵 Check Point 网关并部署 VMware ESXi 数据擦除器","攻击者利用 PHP2Shell 漏洞 CVE-2026-109618 和 CVE-2026-109619 入侵 Check Point Security Gateway 的 Mobile Access 门户。","材料还原了从网关入侵、提权、横向移动到数据擦除的完整攻击链，并提供了补丁与入侵排查线索。",{"_48":56},"2026-11-13T16:21:43.000Z","2026-11-13T16:37:24.630Z",[165,202,203,204,166,205,206,207,208,168,209,210],92,"在野利用","漏洞利用","后门","供应链","Check Point","VMware","CISA","ESET","Ivanti","apc8as95x3w41yh4oar095yxmg","2026-11-13T12:16:25.168Z",{"_144":214,"_32":215,"_147":216,"_149":217,"_151":218,"_153":219,"_155":212,"_14":156,"_157":220,"_159":221,"_161":162,"_12":163,"_164":-5},"pc8as95x3w41yh4oar095yxmg","Operation Endgame 关闭 Gootloader、CastleRAT 和 StealC 基础设施，查获 6.4M 组失窃登录凭据","Operation Endgame 已关闭 Gootloader、CastleRAT 和 StealC 相关基础设施，共查获 235 台服务器、257 个域名及约 6.4 million 组失窃登录凭据，涉及超过 40,000 名受害者。","材料呈现了跨区域执法行动如何同时关闭恶意软件基础设施、查扣失窃凭据并开展受害者通知，适合用于评估类似多阶段攻击的处置范围。",{"_48":49},"2026-11-13T10:55:03.000Z",[165,222,223,224,204,225],88,"恶意软件","勒索","数据窃取","凭据","f1314","2026-11-13T12:54:29.181Z",{"_144":232,"_32":234,"_147":235,"_149":236,"_151":237,"_153":238,"_155":227,"_14":239,"_157":240,"_159":241,"_161":162,"_12":163,"_164":-5},{"_186":230,"_188":94,"_189":45,"_190":231},"f2frbTTF4SAw",[232,233],"er76kiktigpbgezkupewfz59z","wi7ly08wpqyim5ljoqty0063g","Apache HTTP/2 远程代码执行漏洞 CVE-2026-119618 已复现","Apache HTTP Server 的 mod_http2 存在远程代码执行漏洞 CVE-2026-119618，奇安信 CERT 已成功复现。攻击者无需认证，在目标启用并开放 HTTP/2 时，可利用并发流和特定请求头布局触发无锁 APR allocator 竞争，造成进程崩溃、拒绝服务，并可能以 httpd 进程权限执行任意代码。","原文给出并发竞态的触发原理、受影响版本和无认证利用条件，并提供了可用的升级与临时缓解方案。",{"_48":108},"2026-11-13T07:40:00.000Z","vuln",[242,243,203,244,245,246],82,"漏洞","复现","补丁","网络设备","奇安信","f1332","2026-11-13T12:56:28.930Z",{"_144":250,"_32":251,"_147":252,"_149":253,"_151":254,"_153":255,"_155":248,"_14":256,"_157":257,"_159":258,"_161":162,"_12":163,"_164":-5},"p4onmtqqizwd1h17c3m9x1czt","WordPress Core 竞争条件远程代码执行漏洞 CVE-2026-119977 复现分析","作者复现并分析了 WordPress Core 竞争条件远程代码执行漏洞 CVE-2026-119977。","文章从暂存目录、安装器与文件复制三个环节还原竞争条件，并提供可复现 PoC 和修复版本，便于理解漏洞成因与处置重点。",{"_48":264},"2026-11-13T06:24:36.000Z","disclosure",[259,243,203,260,261,262,263],84,"漏洞分析","利用链","技术研究","PHP","阿里","先知社区","f1324","2026-11-13T13:56:25.799Z",{"_144":268,"_32":269,"_147":270,"_149":271,"_151":272,"_153":273,"_155":266,"_14":156,"_157":274,"_159":275,"_161":162,"_12":163,"_164":-5},"wz2ouxat7l8a80o3zl97dofcp","CyberStrikeAI 入侵 AWS：16 天内跨 4 个账户调用 78 次 API","一台 CyberStrikeAI 服务器在 2026 年 9 月 30 日至 10 月 16 日间，利用 8 个 AWS 身份凭据侵入 4 个账户并触发 78 条告警；其中一次在 141 毫秒内批量读取 56 个 EC2 user data，另一身份解密 SSM 参数后 29 秒发起 SendCommand。","文章通过 CloudTrail 时间线还原了低严重度告警如何经长期关联构成同一次入侵，并提供了可迁移的行为检测与 IAM 处置思路。",{"_48":279},"2026-11-13T15:27:20.000Z",[165,276,277,225,181,168,278],71,"AI 攻防","云原生","Fortinet","Elastic Security Labs","f1316","2026-11-13T14:58:29.799Z",{"_144":283,"_32":284,"_147":285,"_149":286,"_151":287,"_153":288,"_155":281,"_14":156,"_157":289,"_159":290,"_161":162,"_12":163,"_164":-5},"es24au8p14acocvmeecd4pz0w","执法机构拆除 Gootloader 恶意软件与僵尸网络，涉及 25,000 台受感染计算机","国际执法行动已从 100 多台服务器移除 Gootloader，并查封用于投递和控制该恶意软件的美国域名，涉及全球至少 25,000 台受感染计算机。Gootloader 自 2018 年以来主要通过入侵的 WordPress 网站及其他网站传播，受害者被诱导下载后加入僵尸网络，运营者再向勒索团伙出售访问权限。","材料梳理了 Gootloader 的感染链、载荷类型及执法拆除结果，可用于理解此类恶意软件如何接入勒索团伙并扩大影响。",{"_48":293},"2026-11-13T14:35:44.000Z",[222,223,291,292],72,"黑产","应急响应","Security Affairs","f1347","2026-11-13T16:58:25.785Z",{"_144":297,"_32":298,"_147":299,"_149":300,"_151":301,"_153":302,"_155":295,"_14":256,"_157":303,"_159":160,"_161":162,"_12":163,"_164":-5},"rrsrh82dut4erv3eelbyoynnp","Apache HTTP Server mod_http2 条件竞争 RCE 漏洞 CVE-2026-119618 已复现","Apache HTTP Server mod_http2 的 assign_headers() 竞争条件漏洞 CVE-2026-119618 已被微步情报局复现，可导致远程代码执行或子进程崩溃。","文章给出明确受影响版本、HTTP/2 配置前提和 PoC 复现结果，便于读者对照资产并选择修复或临时缓解措施。",{"_48":111},"2026-11-13T13:55:00.000Z",[243,259,203,244],"ak8q8wjtgm1ani9e5qkly6h7dl","2026-11-13T16:59:25.728Z",{"_144":307,"_32":308,"_147":309,"_149":310,"_151":311,"_153":312,"_155":305,"_14":313,"_157":314,"_159":315,"_161":162,"_12":163,"_164":-5},"k8q8wjtgm1ani9e5qkly6h7dl","Elastic 分析 ARTEX 等五套 AI 攻击框架及在野入侵","Elastic Security Labs 发现 ARTEX、CyberStrikeAI、Cairn、PentAGI 和 HexStrike 五套 AI 攻击框架已出现在真实入侵中，而非仅用于红队测试；五者 GitHub stars 合计超过 60,000。","文章结合源码与公开事件拆解五套 AI 攻击框架的自主执行链，并给出可落地的行为检测与凭据处置建议。",{"_48":279},"2026-11-13T16:00:00.000Z","ai-security",[316,317,276,261,318,181,319,320,168],80,"AI 安全","Agent 安全","检测工程","Google","Microsoft","f1350","2026-11-13T17:59:25.983Z",{"_144":324,"_32":325,"_147":326,"_149":327,"_151":328,"_153":329,"_155":322,"_14":239,"_157":330,"_159":331,"_161":162,"_12":163,"_164":-5},"k60zo1iyllp9listygh4t3xuv","Apache HTTP Server mod_http2 竞态条件远程代码执行漏洞 CVE-2026-119618 已披露","Apache HTTP Server 的 mod_http2 模块存在竞态条件远程代码执行漏洞 CVE-2026-119618，威胁等级为严重，无需认证即可远程触发，但前提是服务器启用 mod_http2 并对外提供 HTTP/2 服务。","原文给出竞态条件的位置、受影响版本和复现结果，并提供官方升级版本与临时禁用 mod_http2 的处置方案，便于评估 HTTP/2 暴露风险。",{"_48":109},"2026-11-13T09:06:00.000Z",[242,243,259,260,244,245],74,"aw9vfncg3nuocwchohygcm6m6s","2026-11-13T18:06:25.304Z",{"_144":335,"_32":336,"_147":337,"_149":338,"_151":339,"_153":340,"_155":333,"_14":239,"_157":341,"_159":342,"_161":162,"_12":163,"_164":-5},"w9vfncg3nuocwchohygcm6m6s","PostgreSQL 修复 52 项安全缺陷，CVE-2026-6460 可导致已认证 RCE","PostgreSQL 发布安全更新，修复 52 项安全缺陷，其中类型混淆漏洞 CVE-2026-6460 的 CVSS 为 8.8，允许可创建对象的数据库用户执行服务器代码；所有低于 18.7、17.12、16.16、15.20 和 14.25 的版本受影响，目前尚无攻击报告。","文章给出漏洞成因、受影响版本、利用前提和 PoC 进展，并列出扩展重建、客户端更新等处置事项。",{"_48":49},"2026-11-13T16:53:08.000Z",[242,244,243,203,343,344,345,208,168,320,319],75,"数据库","Oracle","Red Hat","f1355","2026-11-13T18:19:24.598Z",{"_144":349,"_32":350,"_147":351,"_149":352,"_151":353,"_153":354,"_155":347,"_14":156,"_157":355,"_159":331,"_161":162,"_12":163,"_164":-5},"zi4jqtzxradwjx53lvs0cf651","德国 Quantum Systems 无人机业务遭网络攻击，QBase 恶意更新疑为入口","德国国防科技公司 Quantum Systems 确认，其侦察与拦截无人机业务在 late October 遭“敌对行动者”攻击，QBase 地面控制与任务规划软件的更新分发服务器疑遭入侵并投递恶意更新文件。","材料说明攻击通过 QBase 更新分发服务器投递恶意更新，并交代无人机停飞、调查机构及归因不确定性，便于理解此次事件的攻击路径与影响。",{"_48":56},"2026-11-13T17:31:56.000Z",[165,356,222,357,205],"供应链投毒","IoT","f1369","2026-11-13T20:02:29.322Z",{"_144":361,"_32":362,"_147":363,"_149":364,"_151":365,"_153":366,"_155":359,"_14":156,"_157":367,"_159":368,"_161":162,"_12":163,"_164":-5},"kwq30stubj3ryg11q7j0ngxx8","Cloudflare 披露 AI 渗透测试编排框架激增与凭据链式利用","Cloudflare 指出，AI 渗透测试与利用编排框架正快速扩散，3天内已有 50 多个框架家族扫描其全球客户，相关 IP 达数千个；截至 11 月 12 日，ARTEX 及其分支占已知框架的 60% 以上。","文章结合全球扫描与事件响应观测，说明 AI 渗透编排框架的扩散速度、凭据链式利用及可落地的六层防护框架。",{"_48":370},"2026-11-13T19:26:07.000Z",[165,316,317,276,225,277,369],76,"Cloudflare","Cloudflare Blog","aqeruuzfjoy6z4m589atx262j4","2026-11-13T21:03:26.694Z",{"_144":374,"_32":375,"_147":376,"_149":377,"_151":378,"_153":379,"_155":372,"_14":313,"_157":380,"_159":381,"_161":162,"_12":163,"_164":-5},"qeruuzfjoy6z4m589atx262j4","Cisco Talos 发现 ARTEX 已被用于多行业攻击并关联超过 2,500 个 C2 IP 地址","Cisco Talos 发现开源 AI 渗透测试框架 ARTEX 已被威胁行动者用于侦察、凭据窃取、云端滥用、横向移动和数据外泄，目标覆盖金融、政府、电信、国防等行业。","文章结合公开归因与Talos实测，梳理ARTEX从侦察、初始访问、云端滥用到数据外泄的攻击链，并给出可落地的检测与隔离建议。",{"_48":382},"2026-11-13T20:57:13.000Z",[316,317,165,181,203,205],83,"Cisco Talos","aqr7yw6vafmf6e5mjlmebcs0x4","2026-11-13T21:04:27.833Z",{"_144":386,"_32":387,"_147":388,"_149":389,"_151":390,"_153":391,"_155":384,"_14":156,"_157":392,"_159":290,"_161":162,"_12":163,"_164":-5},"qr7yw6vafmf6e5mjlmebcs0x4","Amazon Threat Intelligence 发现攻击者利用 ARTEX AI Agent 窃取凭据并绕过 KYC","Amazon Threat Intelligence 从 MadPot 诱捕传感器于 2026 年 10 月 3 日至 11 月 5 日捕获的攻击请求中，发现攻击者使用开源 ARTEX Agent 框架开展凭据窃取和加密货币交易所 KYC 绕过。","公开了 AI Agent 运行凭据窃取与 KYC 绕过活动时的任务记录、工作流和 IOC，可用于识别自动化攻击模式并核对自身环境。",{"_48":393},"2026-11-13T20:26:42.000Z",[165,316,317,276,225,224,168],"AWS Security Blog","amwouaoheoihzxg7tv9qiyhivi","2026-11-14T14:12:35.822Z",{"_144":397,"_32":398,"_147":399,"_149":400,"_151":401,"_153":402,"_155":395,"_14":239,"_157":403,"_159":258,"_161":162,"_12":163,"_164":-5},"mwouaoheoihzxg7tv9qiyhivi","CISA 将 Check Point 与 UnrealIRCd 漏洞 CVE-2026-123039、CVE-2026-114713 加入 KEV 目录","CISA 将 UnrealIRCd 命令注入漏洞 CVE-2026-114713 和 Check Point 本地提权漏洞 CVE-2026-123039 加入 KEV 目录，确认均已被真实利用，并要求联邦机构在 2026 年 11 月 16 日前完成处置。","材料列明两个漏洞的利用前提、攻击链和处置期限，便于相关机构核对资产暴露与修复状态。",{"_48":293},"2026-11-14T09:08:00.000Z",[202,242,244,206,208,207],"aq62rs7r8pongzx30vtu5q3hx7","2026-11-14T15:52:27.809Z",{"_144":407,"_32":408,"_147":409,"_149":410,"_151":411,"_153":412,"_155":405,"_14":156,"_157":413,"_159":381,"_161":162,"_12":163,"_164":-5},"q62rs7r8pongzx30vtu5q3hx7","美国政府中断 North Korean FaceStealer 活动，查获超 4 亿美元加密资产盗取","美国政府查获基础设施并中断 North Korean 社会工程活动 FaceStealer，该活动持续 18 个月，针对加密货币、Web3 行业及开源开发者，盗取超过 $400 million 加密资产。","文章还原了 FaceStealer 如何借深伪视频、ClickFix 和恶意更新窃取加密资产及账户凭据，并给出可迁移的会议安全建议。",{"_48":56},"2026-11-14T15:15:49.000Z",[165,222,414,224,356,225,168],"钓鱼","f1397","2026-11-14T17:15:31.977Z",{"_144":418,"_32":419,"_147":420,"_149":421,"_151":422,"_153":423,"_155":416,"_14":156,"_157":424,"_159":425,"_161":162,"_12":163,"_164":-5},"mo0o847hgkw4mbxcp3hicc7jh","Expedia 遭供应链攻击，n0n 声称窃取近 10 亿条旅客记录","Expedia 确认攻击者入侵受感染的第三方数据平台供应商，并借其可信权限进入多家公司系统，调查仍在进行且未证实 n0n 声称的数据规模。","材料区分了Expedia确认的供应链攻击与勒索团伙声称的失窃规模，便于读者判断事件事实与尚未证实的数据暴露说法。",{"_48":293},"2026-11-14T16:46:26.000Z",[165,166,223,291,205,225,319,168],81,"f1398","2026-11-14T17:32:26.461Z",{"_144":429,"_32":430,"_147":431,"_149":432,"_151":433,"_153":434,"_155":427,"_14":156,"_157":435,"_159":331,"_161":162,"_12":163,"_164":-5},"z2y59mturdxdsohd70ruzokq3","Cursor 遭供应链入侵，恶意 Claude Code 扩展向最多 5,000 名开发者分发 SSH 后门","Cursor 确认攻击者窃取 Fireworks AI 的访问密钥，访问内部系统并获取未脱敏 API 凭据，随后于 October 29 通过 Cursor marketplace 分发恶意 Claude Code 扩展 2.1.312 和 2.1.313。","事件完整呈现了从第三方 AI 基础设施凭据泄露到恶意扩展分发及 SSH 后门植入的攻击链，便于评估 AI 开发平台的供应链风险。",{"_48":56},"2026-11-14T17:27:25.000Z",[165,166,204,222,436,437,320,319,168],"AI 供应链","AI 编码",{"_439":440,"_441":-5},"changelogVersion","2026-10-01T08:00","release"]
