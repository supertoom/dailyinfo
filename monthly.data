[{"_1":2,"_3":4},"root",{"_5":306},"monthly-latest",{"_5":6},"data",{"_7":8,"_9":10,"_11":12,"_13":14,"_15":16},"kind","monthly","report",{"_7":8,"_18":19,"_20":21,"_22":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":-5},"index",[17],"today","2026-11-13","expiresAt",1794530496000,{"_18":19,"_20":21,"_22":23},"key","2026-10","issueNumber",1,"title","Binance 遭遇约 63 亿美元加密货币盗窃，TRM 归因 TraderTraitor","DailyInfo 月报 · 2026-10","generatedAt","2026-11-01T02:30:32.972Z","lead",{"_22":23,"_305":32},"leadItemId","utwi4trkcm6q7c7e0bnt63sw8","overview","网络设备与操作系统漏洞成为在野攻击重点，Cisco ASA 与 FTD、Brotli、Linux 内核 Fragnesia 及 PHP2Shell 均已出现利用。攻击活动广泛指向云平台、交易平台和开发工具，Volt Typhoon 借助 Silent Train 隐藏来源，VAPOR PANDA 并行入侵全球 200 多家组织。防御方持续处置大型事件，GMO 关闭 Onamae 相关服务器，CISA 要求联邦机构修复 Brotli 漏洞，TeamViewer 与 Tailscale 分别发布修复。研究披露则聚焦 PHP 远程代码执行、Microsoft Edge 漏洞链及 BeyondTrust 文件上传至远程代码执行问题。","highlights",[302,303,304],"sections",[60,61,62,63],"flashes",[],"cover",{"_53":54,"_55":56,"_57":-5,"_58":-5,"_59":-5},"metrics",{"_47":48,"_49":50,"_51":52},"readingMinutes",12,"prev","next","totalStories",30,"selectedCount",92,"reportsCovered",3,"url","/dailyinfo/media/fe1eaa3ebb49ef55.jpg","srcSet","/dailyinfo/media/db8cc3829a1c8001.jpg 720w, /dailyinfo/media/266d02bc092a81d6.jpg 1200w, /dailyinfo/media/fe1eaa3ebb49ef55.jpg 1600w","width","height","caption",{"_64":250,"_66":251,"_67":252},{"_64":127,"_66":128,"_67":129},{"_64":88,"_66":89,"_67":90},{"_64":65,"_66":-5,"_67":68},"label","AI 安全","summary","items",[69],{"_70":71,"_22":72,"_66":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":83,"_84":85,"_86":87},"itemId","s5egftxgd4pzsuybtmy9c5i8d","Forever Security 披露 Cursor、Copilot、Codex、VS Code 与 Claude Desktop 内置浏览器漏洞","Forever Security 披露五款 AI 编程助手内置浏览器均违反隔离规则：Cursor 可在开发者一次按键后执行攻击者命令，Copilot 可伪造地址栏，Codex、VS Code 和 Claude Desktop 的单个本地页面可越界读取磁盘。","sourceName","Help Net Security","sourceUrl","https://www.helpnetsecurity.com/2026/10/29/research-ai-assistant-browser-vulnerabilities/","publishedAt","2026-10-29T14:10:49.000Z","sourceIconUrl","/dailyinfo/media/06c9ab9de6dbb6a5.webp","sourceIconSrcSet","/dailyinfo/media/9c1b5fa87b3bafc5.webp 48w, /dailyinfo/media/06c9ab9de6dbb6a5.webp 96w","firstParty",false,"available",true,"研究与披露","研究集中揭示无需认证或低门槛利用的代码执行、权限绕过和沙箱逃逸链条。",[91,92,93,94],{"_70":119,"_22":120,"_66":121,"_74":122,"_76":123,"_78":124,"_80":125,"_82":126,"_84":85,"_86":87},{"_70":111,"_22":112,"_66":113,"_74":114,"_76":115,"_78":116,"_80":117,"_82":118,"_84":85,"_86":87},{"_70":103,"_22":104,"_66":105,"_74":106,"_76":107,"_78":108,"_80":109,"_82":110,"_84":87,"_86":87},{"_70":95,"_22":96,"_66":97,"_74":98,"_76":99,"_78":100,"_80":101,"_82":102,"_84":87,"_86":87},"els1gzklnlhxhh0k15ljle1lp","Rapid7 分析 BeyondTrust Remote Support 未认证文件上传至 RCE 漏洞 CVE-2026-102764","Rapid7 分析 BeyondTrust Remote Support 的来源校验缺陷 CVE-2026-102764，未认证攻击者可伪造本地消息来源，访问原生文件传输服务，写入任意文件并以站点操作系统用户身份执行代码，无需账户凭据或用户交互。","Rapid7 CVE 公告","https://www.rapid7.com/blog/post/ra-rapid7-analysis-unauthenticated-file-upload-to-rce-in-beyondtrust-remote-support-cve-2026-102764","2026-10-30T16:01:53.000Z","/dailyinfo/media/092fbeae5b5c3123.webp","/dailyinfo/media/c16323cf53c574df.webp 48w, /dailyinfo/media/092fbeae5b5c3123.webp 96w","n7t33b4zzyzxy6gb2u55dbm5s","cert-manager 直接创建 Challenge 可绕过 DNS01 策略并泄露 acme-dns 凭据","cert-manager 的直接 Challenge 创建路径未验证 Order 归属或 Issuer 选定 solver，namespace 用户可借此绕过 ClusterIssuer 的 dnsZones、dnsNames 与 matchLabels 限制。","GitHub 安全公告","https://github.com/advisories/GHSA-8rvj-mm4h-c258","2026-10-29T16:39:41.000Z","/dailyinfo/media/6d6a98e6b62e0bb2.webp","/dailyinfo/media/f426f4f60d806c23.webp 48w, /dailyinfo/media/6d6a98e6b62e0bb2.webp 96w","xn04uir3ppltopryw25ryri8a","Orange Tsai 披露 Microsoft Edge 纯逻辑漏洞全链，实现沙箱逃逸与 ACE","Orange Tsai 披露其在 Pwn2Own Berlin 2026 构建的 Microsoft Edge 全链，通过 5 个逻辑漏洞和 2 项 Windows 功能实现沙箱逃逸并获得 $175,000 与 17.5 Master of Pwn points。","DevCo","https://devco.re/blog/2026/10/28/the-last-proof-of-human-craft-forging-a-microsoft-edge-full-chain-with-logic-bugs-only-en/","2026-10-28T00:00:00.000Z","/dailyinfo/media/2dc02bf3e82fea5c.webp","/dailyinfo/media/c6f49a1ce8c8f0d9.webp 48w, /dailyinfo/media/2dc02bf3e82fea5c.webp 96w","nvjhxml6qmgj1n5fihl71npjw","php2shell 技术分析：PHP 两个 RCE 生命周期漏洞 CVE-2026-109618 与 CVE-2026-109619","php2shell 技术分析拆解了 PHP 的两个未经认证 RCE 漏洞，CVE-2026-109618 和 CVE-2026-109619 均为 CVSS v4.0 9.2，前者源于 OOM 中断后的内存破坏，后者源于跨请求的陈旧全局状态。","OffSec","https://www.offsec.com/blog/php2shell-anatomy-of-two-php-lifecycle-bugs/","2026-10-28T20:07:17.000Z","/dailyinfo/media/00e7f80d0fd7a26d.webp","/dailyinfo/media/f8be55c07177824b.webp 48w, /dailyinfo/media/00e7f80d0fd7a26d.webp 96w","攻击与威胁","攻击者正通过云桌面、开发扩展、远程支持与第三方服务扩大入侵范围，并转向冒充支持和大规模凭据泄露。",[130,131,132,133,134,135,136,137,138,139,140,141,142,143,144,145,146],{"_70":30,"_22":23,"_66":247,"_74":75,"_76":248,"_78":249,"_80":81,"_82":83,"_84":85,"_86":87},{"_70":242,"_22":243,"_66":244,"_74":189,"_76":245,"_78":246,"_80":192,"_82":193,"_84":85,"_86":87},{"_70":236,"_22":237,"_66":238,"_74":239,"_76":240,"_78":241,"_80":-5,"_84":85,"_86":87},{"_70":231,"_22":232,"_66":233,"_74":166,"_76":234,"_78":235,"_80":169,"_82":170,"_84":85,"_86":87},{"_70":226,"_22":227,"_66":228,"_74":166,"_76":229,"_78":230,"_80":169,"_82":170,"_84":85,"_86":87},{"_70":221,"_22":222,"_66":223,"_74":166,"_76":224,"_78":225,"_80":169,"_82":170,"_84":85,"_86":87},{"_70":213,"_22":214,"_66":215,"_74":216,"_76":217,"_78":218,"_80":219,"_82":220,"_84":85,"_86":87},{"_70":208,"_22":209,"_66":210,"_74":75,"_76":211,"_78":212,"_80":81,"_82":83,"_84":85,"_86":87},{"_70":200,"_22":201,"_66":202,"_74":203,"_76":204,"_78":205,"_80":206,"_82":207,"_84":85,"_86":87},{"_70":194,"_22":195,"_66":196,"_74":197,"_76":198,"_78":199,"_80":-5,"_84":85,"_86":87},{"_70":186,"_22":187,"_66":188,"_74":189,"_76":190,"_78":191,"_80":192,"_82":193,"_84":85,"_86":87},{"_70":181,"_22":182,"_66":183,"_74":166,"_76":184,"_78":185,"_80":169,"_82":170,"_84":85,"_86":87},{"_70":176,"_22":177,"_66":178,"_74":166,"_76":179,"_78":180,"_80":169,"_82":170,"_84":85,"_86":87},{"_70":171,"_22":172,"_66":173,"_74":75,"_76":174,"_78":175,"_80":81,"_82":83,"_84":85,"_86":87},{"_70":163,"_22":164,"_66":165,"_74":166,"_76":167,"_78":168,"_80":169,"_82":170,"_84":85,"_86":87},{"_70":155,"_22":156,"_66":157,"_74":158,"_76":159,"_78":160,"_80":161,"_82":162,"_84":85,"_86":87},{"_70":147,"_22":148,"_66":149,"_74":150,"_76":151,"_78":152,"_80":153,"_82":154,"_84":85,"_86":87},"bd7wabp95rfnfjrzp7ji0kci5","TrendAI 指 Discover-Tech 通过数字广告跟踪 Starlink 用户","TrendAI 研究人员认为，以 SHADOW-EARTH-79 标识的广告技术实体 Discover-Tech 购买 Starlink 用户广告，可能借此定位和监视用户。","Security Affairs","https://securityaffairs.com/201947/intelligence/ads-or-surveillance-researchers-flag-suspicious-targeting-of-starlink-users.html","2026-10-28T14:37:21.000Z","/dailyinfo/media/ef2b2b57fb06e54f.webp","/dailyinfo/media/2adef5b1e4357a03.webp 48w, /dailyinfo/media/ef2b2b57fb06e54f.webp 96w","ashq9zaym8iojmnulqhy7xxeb","Cloudflare披露eMudhra弱密钥证书利用迹象与访客补丁进度","eMudhra的8个弱中间CA私钥可由公开证书近乎即时恢复，攻击者已在密钥公开后数小时内伪造证书。Cloudflare发现约22,000次使用弱密钥的TLS握手尝试，其中约160次证书SAN指向无关组织域名，但没有证据表明弱密钥被用于拦截Cloudflare连接。","Cloudflare Blog","https://blog.cloudflare.com/emudhra-patching/","2026-10-30T17:38:50.000Z","/dailyinfo/media/e0511aa52e58d477.webp","/dailyinfo/media/20e3fb0c4cf82a1a.webp 48w, /dailyinfo/media/e0511aa52e58d477.webp 96w","mnxtybnzit795ejslskcd1v8b","Oracle E-Business Suite CVE-2026-101767 补丁后遭探测","Oracle E-Business Suite 的 CVE-2026-101767 已在补丁发布数日后出现利用探测。","The Hacker News","https://thehackernews.com/2026/10/hackers-target-critical-oracle-e.html","2026-10-28T12:48:03.000Z","/dailyinfo/media/3d21685a726d0a64.jpg","/dailyinfo/media/a1e7de8b6809b50e.jpg 48w, /dailyinfo/media/3d21685a726d0a64.jpg 96w","lpx0fpf5dtulg95plg0vd0qsv","FBI 查封 Virtualine 防弹托管域名及其犯罪论坛","FBI 牵头查封 Virtualine 旗下 virtualine.net，该防弹托管服务曾为犯罪客户提供托管、服务器和域名注册，并被指洗钱及托管儿童性虐待材料论坛。","https://www.helpnetsecurity.com/2026/10/28/fbi-seizure-virtualine-bulletproof-hosting-domain/","2026-10-28T11:41:01.000Z","wsntmow6j7f4emvphlkjlx4fh","独立研究员在 Gitee 公开仓库发现 26,400 个仍有效的云与 AI 凭据","独立研究员 Ben Zimmermann 扫描 Gitee 的 7.25 million 个公开仓库，发现 26,400 个仍可使用的云与 AI 凭据，其中包括 9。","https://thehackernews.com/2026/10/26400-valid-cloud-and-ai-credentials.html","2026-10-29T11:33:15.000Z","r33vqb4ahc08c2y4ozgccut2g","疑似中国关联攻击者利用 PHP2Shell 在 25 台服务器取得 root 权限并渗透 Active Directory","疑似中国关联攻击者利用 PHP2Shell 与 Fragnesia 漏洞链，在美国、日本、台湾和韩国取得 25 台服务器 root 权限，其中包括美国政府关联环境的 3 台系统。","https://thehackernews.com/2026/10/php2shell-attack-roots-25-servers.html","2026-10-28T16:02:45.000Z","ihl9k919cuk2zeu8m5uh5sr73","Polymarket 因第三方服务遭入侵暂停交易，约 $2.5M 加密资产被追踪","Polymarket 因第三方供应商被入侵而遭恶意 JavaScript 注入，约 $2.5M 加密资产已转移至疑似攻击者钱包。该脚本通过 cdn.debugbear[.]com/C7xcKKrjUnXK.js 分发，劫持已登录用户的交易会话、出售预测市场持仓并转移加密资产，还利用 data.debugbear.com 接收指令及回传账户、余额和交易结果。","BleepingComputer","https://www.bleepingcomputer.com/news/security/polymarket-halts-trading-after-crypto-draining-script-breach-25m-traced/","2026-10-29T21:47:25.000Z","/dailyinfo/media/198a4d86de90e233.webp","/dailyinfo/media/3a544a742516b0af.webp 48w, /dailyinfo/media/198a4d86de90e233.webp 96w","kh5zbp42tkmy1pgddvyma6sb0","zkLink 遭攻击损失约 78.3 万美元，Arbitrator 合约验证逻辑被绕过","跨链协议 zkLink 于 2026 年 10 月 29 日遭攻击，损失约 78.3 万美元。","慢雾科技","https://mp.weixin.qq.com/s?__biz=MzU4ODQ3NTM2OA==&mid=2247506498&idx=1&sn=a7646de265d6c5c01cf91b8b5cb91480","2026-10-30T11:20:00.000Z","f1ouf60ewvurduuj73co4r1ov","LodaRAT 以伪造美国法院通知钓鱼，已针对逾 100,000 家企业","LodaRAT 通过冒充美国佛罗里达南区联邦地区法院的替代性争议解决案件通知，针对超过 100,000 家企业投放恶意软件。诱导页面仅向使用 Microsoft Edge 的访客展示内容，下载的密码保护压缩文件包含 MSC、批处理和 Windows 快捷方式三种文件，任一文件执行后均从 us.wind0ws.net 下载同一恶意软件。","Hackread","https://hackread.com/fake-us-court-notices-target-businesses-lodarat/","2026-10-28T10:04:16.000Z","/dailyinfo/media/dd06beac4cadc6f3.webp","/dailyinfo/media/47417cbef4636b7b.webp 48w, /dailyinfo/media/dd06beac4cadc6f3.webp 96w","gu6ue1ilx7hnlwxcatqdphg4v","自称 Department of Peace 的黑客泄露逾 41,000 名 DHS 员工记录","自称 Department of Peace 的黑客组织泄露了超过 41,000 名美国国土安全部（DHS）员工的姓名、办公室、联系方式和任务信息，并交由 Distributed Denial of Secrets 发布为 Icepick；该组织称数据取自 DHS 使用的 Okta SSO 服务，Okta 否认其系统被攻破。","https://www.helpnetsecurity.com/2026/10/29/icepick-dhs-leak-ice-undercover-agents/","2026-10-29T10:16:18.000Z","m8vt0mfprflyha4qd0f1jbnwd","VAPOR PANDA 使用 ARTEX 与 DeepSeek 并行入侵全球 200 多家组织","CrowdStrike 披露 VAPOR PANDA 自 2026 年 10 月 17 日起使用 ARTEX 和 DeepSeek 等 LLM，在 11 天内针对至少 14 个国家的 200 多家组织并行入侵。","CrowdStrike","https://www.crowdstrike.com/en-us/blog/vapor-panda-uses-artex-to-scale-global-campaign/","2026-10-29T05:00:00.000Z","/dailyinfo/media/4bb18fbefa568e31.webp","/dailyinfo/media/f338ab1b3d8b6c40.webp 48w, /dailyinfo/media/4bb18fbefa568e31.webp 96w","vuvau9rjn8ik414g6xpi91tx9","攻击者利用 Microsoft Teams 冒充 IT 支持，部署 GoGRPC 后门与 Chaos 勒索软件","攻击者利用 Microsoft Teams 外部聊天冒充 IT 支持，结合邮件轰炸诱导受害者授予远程访问权限，并部署 GoGRPC 后门、Chaos 勒索软件。攻击主要针对启用外部访问的组织，已导致横向移动至域控制器、数据外传及勒索软件投放；Arctic Wolf 建议结合端点与身份遥测进行监测。","https://thehackernews.com/2026/10/attackers-use-microsoft-teams-it.html","2026-10-26T15:52:40.000Z","kap6lzk1o51rm638fm4tiscnh","攻击者尝试利用 Alpine Linux GitLab 的 CVE-2026-97229 漏洞，CVSS 10.0","攻击者试图利用 Alpine Linux 自有 GitLab 服务器的 CVE-2026-97229 漏洞，该漏洞 CVSS 10.0，可通过构造的 CI 正则表达式在特定条件下执行代码。","https://thehackernews.com/2026/10/attacker-tried-to-exploit-alpine-linuxs.html","2026-10-29T09:05:39.000Z","vjdhd6f9hgfqlc9p5znn3m95n","Cursor Marketplace 上架的 Claude Code 扩展被植入持久化 SSH 后门","Cursor Marketplace 中被篡改的官方 Claude Code VS Code 扩展会安装持久化 SSH 后门，影响至多 5,000 名用户。","https://thehackernews.com/2026/10/official-claude-code-vs-code-extension.html","2026-10-30T08:55:47.000Z","zwh7qiot8b8294xdoeg7i356t","GMO旗下Onamae云桌面服务遭入侵，最多26,739台服务器被植入恶意软件","GMO旗下Onamae云桌面服务遭网络攻击，最多26,739名客户的服务器被植入恶意软件，客户支付信息未泄露，但MT4/MT5登录凭证及交易账号信息可能暴露。攻击者窃取数据后索要高达80亿日元赎金，并威胁启动已植入的勒索软件载荷。GMO关闭相关服务器并敦促客户断网关机、重置密码和终止会话；目前尚未发现客户电脑上的勒索软件被激活。","安全内参","https://mp.weixin.qq.com/s?__biz=MzI4NDY2MDMwMw==&mid=2247516790&idx=1&sn=436349113ffe5d99176da6bb6dda7b23","2026-10-28T09:20:00.000Z","n8ley102n83kjrh7ne1s1q0wy","Volt Typhoon 利用 Silent Train 框架隐藏零日漏洞攻击","Volt Typhoon 使用 Silent Train 中继框架，通过境外 VPS、被入侵的路由器及其他设备隐藏攻击来源，并利用至少 4 个零日漏洞攻击电信、政府、国防承包商、公用事业、卫星服务、航空等高价值目标。","https://www.bleepingcomputer.com/news/security/volt-typhoon-hides-zero-day-attacks-using-silent-train-framework/","2026-10-28T16:00:00.000Z","Binance 约 63 亿美元加密货币被盗，TRM Labs 与 Chainalysis 均高置信度将攻击归因于朝鲜组织 TraderTraitor。初步调查显示，攻击者可能从一台被攻陷的 DevOps 工程师笔记本进入服务容器，提交未授权提现交易，并攻陷热钱包签名基础设施；Ethereum 上涉及 50 个预先签署的授权。","https://www.helpnetsecurity.com/2026/10/30/binance-crypto-hack/","2026-10-30T08:26:13.000Z","漏洞与在野利用","已出现利用的网络与内核漏洞持续被修补，供应链组件和远程支持产品中的风险也在扩大。",[253,254,255,256,257,258,259,260],{"_70":296,"_22":297,"_66":298,"_74":299,"_76":300,"_78":301,"_80":-5,"_84":87,"_86":87},{"_70":291,"_22":292,"_66":293,"_74":189,"_76":294,"_78":295,"_80":192,"_82":193,"_84":85,"_86":87},{"_70":286,"_22":287,"_66":288,"_74":189,"_76":289,"_78":290,"_80":192,"_82":193,"_84":85,"_86":87},{"_70":281,"_22":282,"_66":283,"_74":189,"_76":284,"_78":285,"_80":192,"_82":193,"_84":85,"_86":87},{"_70":276,"_22":277,"_66":278,"_74":203,"_76":279,"_78":280,"_80":206,"_82":207,"_84":85,"_86":87},{"_70":271,"_22":272,"_66":273,"_74":106,"_76":274,"_78":275,"_80":109,"_82":110,"_84":87,"_86":87},{"_70":266,"_22":267,"_66":268,"_74":106,"_76":269,"_78":270,"_80":109,"_82":110,"_84":87,"_86":87},{"_70":261,"_22":262,"_66":263,"_74":75,"_76":264,"_78":265,"_80":81,"_82":83,"_84":85,"_86":87},"vsfs000d1boyjr3m5ahd2iza2","Tailscale 修复 Tailworm SSH 漏洞，v1.104.4 已发布","Tailscale 修复了 Tailworm 中可导致已获准设备在 tailnet 内横向移动的 SSH 漏洞。攻击者需先入侵策略允许 SSH 连接的设备，随后可尝试获取其他服务器的 root 级控制权并窃取设备注册密钥；受影响范围受 tailnet 策略限制，Tailscale 不认同其可自动传播的“蠕虫”定性。","https://www.helpnetsecurity.com/2026/10/28/tailscale-fixes-tailworm-ssh-flaws/","2026-10-28T12:25:04.000Z","ndo10izcxlkye6sdeutgereno","Rust zip 9.0.0-pre3 暴露 Zip Slip 任意文件写入漏洞","Rust zip 9.0.0-pre3 存在任意文件写入漏洞，影响 7.2.0 及更高版本，攻击者需知道或猜中解压目标的绝对路径。","https://github.com/advisories/GHSA-hjqx-j4rw-g7xv","2026-10-29T16:40:12.000Z","xpytoqbtuulo3rw9z3h510qhs","Mem0 会话范围键分隔符碰撞漏洞可导致跨租户对话泄露","Mem0 的 Python 与 TypeScript SDK 因未转义会话范围键中的 & 和 =，可造成跨租户对话读取与历史数据驱逐。","https://github.com/advisories/GHSA-5324-3w58-qpp2","2026-10-28T21:17:08.000Z","ae96k4vyaf9n7mzfdlf9k8j1e","TeamViewer 远程支持漏洞 CVE-2026-111585 可在技术支持人员电脑上执行代码","TeamViewer 的屏幕解压组件存在 CVE-2026-111585，攻击者控制或攻陷被远程连接的设备后，可诱导技术支持人员接受连接，并在未打补丁的电脑上利用整数溢出与堆溢出执行攻击者代码。TeamViewer 于 2026 年 10 月 27 日发布 15.83 版本修复，该漏洞 CVSS 为 8.8、等级为 High；官方未发现已被在野利用的证据，并建议用户更新至最新版本。","https://hackread.com/teamviewer-vulnerability-code-it-support-staff-pcs/","2026-10-30T18:35:09.000Z","obhfumhh687s8ss7ottgn00g5","CISA 警告 Linux 内核 Fragnesia 漏洞 CVE-2026-46300 已与 PHP2Shell 在野利用","CISA 警告 Fragnesia Linux 内核提权漏洞 CVE-2026-46300 已与 PHP2Shell 漏洞（CVE-2026-109618、CVE-2026-109619）在野利用，可植入 PHP webshell 并以 root 权限运行命令。","https://www.bleepingcomputer.com/news/security/cisa-warns-of-fragnesia-linux-flaw-chained-in-php2shell-attacks/","2026-10-29T13:59:48.000Z","jtfc7xy2x7a2pqxrr0ivv2g1k","CISA确认攻击者正在利用Brotli漏洞CVE-2026-111497","攻击者正在利用Brotli远程代码执行漏洞CVE-2026-111497。该严重漏洞源于Brotli解码器的越界写入，未认证攻击者可利用恶意压缩流造成崩溃、内存泄露或RCE。CISA已将其纳入KEV，要求美国联邦机构在11月10日前完成修复，并建议其他网络防守者优先打补丁，无法立即更新的系统可阻断入站Brotli压缩请求或禁用该解码功能。","https://www.bleepingcomputer.com/news/security/cisa-warns-of-hackers-now-exploiting-critical-node2shell-flaw/","2026-10-28T10:46:23.000Z","o4jhgucdw0y08zpd9xy9goxcn","Linux 内核 CVE-2026-98432 可导致 MPTCP 服务器远程 root 提权","Anthropic 研究人员利用 CVE-2026-98432 实现了针对启用 MPTCP 监听器的 Linux 服务器的远程 root 代码执行。该漏洞是 Linux 内核 IPv4 TCP 网络代码中的 use-after-free 与竞态条件问题，CVSS 9.8，也影响普通 TCP 连接；其利用需要触发竞态，Red Hat 将其评为 5.9 并认为可能导致内核崩溃。","https://www.bleepingcomputer.com/news/security/critical-linux-kernel-flaw-allows-remote-root-attacks-on-mptcp-servers/","2026-10-30T21:09:46.000Z","gz5wepydgx19541hqwvty4syk","Cisco ASA 与 FTD 远程访问 SSL VPN 隧道 DoS 漏洞 CVE-2026-76418 已被利用","Cisco ASA Software 与 FTD Software 的远程访问 SSL VPN 隧道存在 CVE-2026-76418，未认证远程攻击者可在隧道组启用二次认证时发送特制请求，触发设备意外重载并造成拒绝服务（DoS）；成功发起 VPN 登录并非必要条件。","Cisco PSIRT","https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-asaftd-tunnel-dos-s6mgkb75?vs_f=Cisco%20Security%20Advisory%26vs_cat=Security%20Intelligence%26vs_type=RSS%26vs_p=Cisco%20Secure%20Firewall%20Adaptive%20Security%20Appliance%20and%20Secure%20Firewall%20Threat%20Defense%20Software%20Remote%20Access%20SSL%20VPN%20Tunnel%20Denial%20of%20Service%20Vulnerability%26vs_k=1","2026-10-28T11:15:00.000Z",{"_70":242,"_22":243,"_66":244,"_74":189,"_76":245,"_78":246,"_80":192,"_82":193,"_84":85,"_86":87},{"_70":119,"_22":120,"_66":121,"_74":122,"_76":123,"_78":124,"_80":125,"_82":126,"_84":85,"_86":87},{"_70":111,"_22":112,"_66":113,"_74":114,"_76":115,"_78":116,"_80":117,"_82":118,"_84":85,"_86":87},"leadParagraph",{"_307":308,"_309":-5},"changelogVersion","2026-10-01T08:00","release"]
